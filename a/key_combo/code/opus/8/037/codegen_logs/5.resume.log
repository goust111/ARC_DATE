0095: def main(grid: np.ndarray) -> np.ndarray:
0096:     """
0097:     Complete the arithmetic sequence of rectangular side-strokes and turn all remaining background grey.
0098: 
0099:     Input structure
0100:     A zero-background 2D grid contains one non-background color. Its 4-connected
0101:     objects are clipped rectangular side-strokes: each object occupies the same
0102:     set of bbox sides, such as top+right, left+bottom, or a three-sided U.
0103: 
0104:     Rule
0105:     Sort the observed stroke bboxes by increasing bbox area. Consecutive bboxes
0106:     differ by a constant coordinate delta, so extend that bbox sequence in both
0107:     directions until the corresponding clipped side-stroke has no visible pixels.
0108:     Paint every visible side-stroke with the input foreground color and paint
0109:     all other cells grey.
0110: 
0111:     Key insight
0112:     The missing output pixels are not filled from local adjacency; the visible
0113:     objects are consecutive members of one larger arithmetic family of rectangular
0114:     side-strokes, with larger members clipped by the canvas boundaries.
0115:     """
0116:     g = np.asarray(grid, dtype=int)
0117:     assert g.ndim == 2, "expected a 2D grid"
0118: 
0119:     bg = get_bg(g)
0120:     assert bg == Color.BLACK, "expected black background"
0121:     foreground_colors = colors_present(g, exclude={bg})
0122:     assert len(foreground_colors) == 1, "expected one foreground color"
0123:     fg = int(foreground_colors[0])
0124:     assert fg != Color.GREY, "grey is reserved for the output fill"
0125: 
0126:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0127:     assert len(components) >= 2, "expected at least two visible strokes"
0128: 
0129:     sides_by_component = [
0130:         _component_sides(g.shape, comp["coords"], comp["bbox"])
0131:         for comp in components
0132:     ]
0133:     assert len(set(sides_by_component)) == 1, "all strokes must use the same bbox sides"
0134:     sides = sides_by_component[0]
0135:     assert len(sides) >= 2, "expected each stroke to use at least two bbox sides"
0136: 
0137:     for comp in components:
0138:         actual = np.zeros(g.shape, dtype=bool)
0139:         actual[comp["coords"][:, 0], comp["coords"][:, 1]] = True
0140:         expected = _draw_clipped_sides(g.shape, comp["bbox"], sides)
0141:         assert np.array_equal(actual, expected), "component must exactly match its bbox sides"
0142: 
0143:     boxes = [tuple(map(int, comp["bbox"])) for comp in components]
0144:     areas = [_box_area(box) for box in boxes]
0145:     assert len(set(areas)) == len(areas), "stroke bbox areas must be unique"
0146:     boxes.sort(key=_box_area)
0147:     deltas = [
0148:         tuple(int(boxes[i + 1][j] - boxes[i][j]) for j in range(4))
0149:         for i in range(len(boxes) - 1)
0150:     ]
0151:     assert len(set(deltas)) == 1, "stroke bboxes must form an arithmetic sequence"
0152:     step = deltas[0]
0153:     assert any(step), "stroke sequence must have a nonzero step"
0154: 
0155:     out = np.full(g.shape, Color.GREY, dtype=int)
0156:     for box in _extend_boxes(g.shape, boxes, step, sides):
0157:         out[_draw_clipped_sides(g.shape, box, sides)] = fg
0158:     return out
