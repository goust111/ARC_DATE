0092:         assert bar["area"] == (r1 - r0 + 1) * (c1 - c0 + 1)
0093:         if c0 == c1 and r0 < r1:
0094:             _paint_from_vertical_bar(g, out, bar["bbox"], bg)
0095:         elif r0 == r1 and c0 < c1:
