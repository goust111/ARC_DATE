+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return (r0, c0, r1, c1) == (0, 0, mask.shape[0] - 1, mask.shape[1] - 1)
+
+
+def _make_half_mask(axis: str, rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        if axis == "h":
+            h = int(rng.integers(2, 4))
