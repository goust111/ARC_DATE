+
+
+def _make_noise_mask(rng: np.random.Generator, force_even_dim: bool) -> np.ndarray:
+    for _ in range(300):
+        if force_even_dim:
+            h = int(rng.choice([2, 3, 4]))
+            w = int(rng.choice([2, 3, 4]))
+            if h % 2 and w % 2:
