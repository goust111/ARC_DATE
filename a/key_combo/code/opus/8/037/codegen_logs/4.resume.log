+        return False
+    return not np.any(blocked[top : top + ph, left : left + pw] & patch)
+
+
+def _stamp_bool(mask: np.ndarray, patch: np.ndarray, top: int, left: int) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
