+
+
+def _signature(grid: np.ndarray) -> str:
+    return hashlib.md5(grid.tobytes() + str(grid.shape).encode()).hexdigest()
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
