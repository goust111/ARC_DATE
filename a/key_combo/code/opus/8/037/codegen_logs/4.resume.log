+    g = np.zeros((h, w), dtype=int)
+    g[0, 1:-1] = TOP_COLOR
+    g[1:-1, -1] = RIGHT_COLOR
+    g[-1, 1:-1] = BOTTOM_COLOR
+    g[1:-1, 0] = LEFT_COLOR
