+def _repeat_axes(mask: np.ndarray) -> list[str]:
+    axes: list[str] = []
+    h, w = mask.shape
+    if h % 2 == 0 and np.array_equal(mask[: h // 2, :], mask[h // 2 :, :]):
+        axes.append("h")
+    if w % 2 == 0 and np.array_equal(mask[:, : w // 2], mask[:, w // 2 :]):
