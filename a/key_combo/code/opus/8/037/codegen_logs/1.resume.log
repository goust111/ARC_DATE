+    if np.array_equal(out, grid):
+        return None
+    if int(np.count_nonzero(out == ORANGE)) == 0:
+        return None
+
+    orange_components = 0
+    for coords in _extract_components(out):
+        if coords["color"] == ORANGE:
+            orange_components += 1
+    if orange_components == 0:
+        return None
+    return grid
