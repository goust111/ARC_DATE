+
+def _mark_bbox(mask: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+
+
+def _sample_distinct_colors(rng: np.random.Generator) -> tuple[int, int]:
