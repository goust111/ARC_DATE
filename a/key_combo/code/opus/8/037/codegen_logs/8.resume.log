+def _clear_neighborhood_mask(grid: np.ndarray, bg: int = BLACK) -> np.ndarray:
+    h, w = map(int, grid.shape)
+    mask = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
