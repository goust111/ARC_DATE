+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+MAROON = 9
+
+SPRITE_COLORS = (BLUE, RED, YELLOW, PINK, ORANGE)
+GEN_RETRIES = 500
