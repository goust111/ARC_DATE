+
+def _detect_corridors(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    clear = _clear_neighborhood_mask(g, bg=BLACK)
+    rects = _maximal_true_rectangles(clear)
+    min_major = min(h, w) // 2
