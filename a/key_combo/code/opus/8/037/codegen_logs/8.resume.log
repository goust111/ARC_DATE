+def _make_short_distractor(
+    h: int,
+    w: int,
+    occupied: np.ndarray,
+    rng: np.random.Generator,
+) -> dict | None:
+    orientation = str(rng.choice(np.array(["horizontal", "vertical"], dtype=object)))
+    for _ in range(120):
+        if orientation == "horizontal":
+            height = int(rng.integers(1, 3))
+            length = int(rng.integers(3, 7))
