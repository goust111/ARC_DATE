+def _render_output(grid: np.ndarray, reached: frozenset[tuple[int, int]]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for cell_r, cell_c in reached:
+        _cell_view(out, cell_r, cell_c)[:, :] = PINK
+    return out
+
