+def _cell_view(grid: np.ndarray, cell_r: int, cell_c: int) -> np.ndarray:
+    r0, c0 = _cell_origin(cell_r, cell_c)
+    return grid[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
