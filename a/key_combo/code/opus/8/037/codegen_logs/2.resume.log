+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    for _ in range(40):
+        allowed_dirs = _choose_mask(rng)
+        options = _candidate_seed_sets(allowed_dirs, rng)
+        if not options:
+            continue
