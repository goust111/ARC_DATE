  59: def main(grid: np.ndarray) -> np.ndarray:
  60:     """
  61:     Recolor the blue pixels matching the accent-coded 3x3 mask inside every qualifying lattice cell.
  62: 
  63:     Input structure
  64:     - The grid is a lattice of 3x3 cells separated by yellow lines.
  65:     - One non-blue, non-yellow accent color appears only as 2x2 blocks inside a 6x6 instruction region.
  66:     - Ordinary candidate cells contain only empty and blue pixels.
  67: 
  68:     Rule
  69:     - Decode the instruction region into a 3x3 mask: each solid 2x2 accent block marks the corresponding mask pixel.
  70:     - For every 3x3 lattice cell containing blue pixels at all mask positions, recolor those mask-position pixels to the accent color.
  71:     - Preserve the instruction region, yellow lattice, empty pixels, and all non-matching blue pixels.
  72: 
  73:     Key insight
  74:     - The accent shape is a scaled-up code for which positions in a 3x3 blue pattern should be recolored.
  75:     """
  76:     g = np.asarray(grid, dtype=int)
  77:     assert g.ndim == 2
  78: 
  79:     accent, mask = _decode_mask(g)
  80:     out = g.copy()
  81: 
  82:     for r0 in _cell_starts(g.shape[0]):
  83:         for c0 in _cell_starts(g.shape[1]):
  84:             cell = g[r0 : r0 + 3, c0 : c0 + 3]
  85:             if np.all((cell == EMPTY) | (cell == BLUE)) and np.all(cell[mask] == BLUE):
  86:                 out_cell = out[r0 : r0 + 3, c0 : c0 + 3]
  87:                 out_cell[mask] = accent
