 173: def _gen_cell_pattern(mask: np.ndarray, count: int, is_matching: bool) -> np.ndarray:
 174:     cell = np.zeros((_GEN_CELL_SIZE, _GEN_CELL_SIZE), dtype=int)
 175:     flat = cell.reshape(-1)
 176:     mask_positions = np.flatnonzero(mask.reshape(-1))
 177: 
 178:     if is_matching:
 179:         flat[mask_positions] = _GEN_BLUE
 180:         remaining = np.flatnonzero(~mask.reshape(-1))
 181:         take = int(count) - len(mask_positions)
 182:         if take > 0:
 183:             flat[np.random.choice(remaining, size=take, replace=False)] = _GEN_BLUE
 184:         return cell
 185: 
 186:     blocked = int(np.random.choice(mask_positions))
 187:     allowed = np.array([p for p in range(_GEN_CELL_PIXELS) if p != blocked], dtype=int)
 188:     if count > 0:
 189:         flat[np.random.choice(allowed, size=int(count), replace=False)] = _GEN_BLUE
