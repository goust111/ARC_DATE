+def _find_seed_cells(grid: np.ndarray) -> tuple[tuple[int, int], ...]:
+    seeds: list[tuple[int, int]] = []
+    seen_blue = 0
+    for cell_r, cell_c in ALL_CONTENT_CELLS:
+        block = _cell_view(grid, cell_r, cell_c)
+        center_blue = int(block[1, 1]) == BLUE
