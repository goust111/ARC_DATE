 247:                 continue
 248: 
 249:             mask = np.zeros_like(allowed, dtype=bool)
 250:             for r, c in first | second:
 251:                 mask[r, c] = True
 252:             return mask
 253: 
 254:     one = _grow_blob(allowed, target)
 255:     if one is None:
 256:         return None
 257: 
 258:     mask = np.zeros_like(allowed, dtype=bool)
 259:     for r, c in one:
 260:         mask[r, c] = True
 261:     return mask
 262: 
 263: 
 264: def _sample_block_states(n: int) -> tuple[np.ndarray, int]:
 265:     block_count = n * n
 266:     max_blanks = max(MIN_BLANK_BLOCKS, block_count // MAX_BLANK_BLOCK_DENOMINATOR)
 267:     blank_blocks = random.randint(MIN_BLANK_BLOCKS, max_blanks)
 268:     state = np.ones((n, n), dtype=bool)
 269:     for idx in random.sample(range(block_count), blank_blocks):
 270:         state[idx // n, idx % n] = False
 271:     return state, blank_blocks
 272: 
 273: 
 274: def _render_clean_grids(n, block_size, side, state, sprite, foreground, blank) -> tuple[np.ndarray, np.ndarray]:
 275:     out = np.full((side, side), GEN_SEPARATOR_COLOR, dtype=int)
 276:     inp = np.full((side, side), GEN_SEPARATOR_COLOR, dtype=int)
 277:     for br in range(n):
 278:         for bc in range(n):
 279:             r0, c0 = _block_origin(br, bc, block_size)
 280:             if state[br, bc]:
 281:                 out[r0 : r0 + block_size, c0 : c0 + block_size] = foreground
 282:                 inp[r0 : r0 + block_size, c0 : c0 + block_size] = sprite
 283:             else:
 284:                 out[r0 : r0 + block_size, c0 : c0 + block_size] = sprite
 285:                 inp[r0 : r0 + block_size, c0 : c0 + block_size] = blank
 286:     return inp, out
 287: 
 288: 
 289: def _build_protected_mask(n, block_size, side, clean_block, sprite, foreground) -> np.ndarray:
 290:     """Reserve enough evidence for the solver to infer every block and separator."""
 291:     protected = np.zeros((side, side), dtype=bool)
 292:     r0, c0 = _block_origin(*clean_block, block_size)
 293:     protected[r0 : r0 + block_size, c0 : c0 + block_size] = True
 294: 
 295:     fg_positions = list(zip(*np.nonzero(sprite == foreground)))
 296:     for br in range(n):
 297:         for bc in range(n):
 298:             rr, cc = random.choice(fg_positions)
 299:             r0, c0 = _block_origin(br, bc, block_size)
 300:             protected[r0 + rr, c0 + cc] = True
 301: 
 302:     row_seps = _separator_indices(n, block_size)
 303:     col_seps = _separator_indices(n, block_size)
 304:     non_sep_rows = [r for r in range(side) if r not in row_seps]
 305:     non_sep_cols = [c for c in range(side) if c not in col_seps]
 306:     for r in non_sep_rows:
 307:         protected[r, random.choice(non_sep_cols)] = True
 308:     for c in non_sep_cols:
 309:         protected[random.choice(non_sep_rows), c] = True
 310:     return protected
 311: 
 312: 
 313: def _add_grey_overlay(inp: np.ndarray, protected: np.ndarray) -> bool:
 314:     allowed = ~protected
 315:     side = inp.shape[0]
 316:     min_grey = max(1, math.ceil(side * side * GREY_MIN_FRACTION))
 317:     max_grey = max(min_grey, math.floor(side * side * GREY_MAX_FRACTION))
 318:     available_sizes = [len(comp) for comp in components_mask(allowed, connectivity=GREY_CONNECTIVITY)]
 319:     largest_available = max(available_sizes, default=0)
 320:     if largest_available < min_grey:
 321:         return False
 322:     target = random.randint(min_grey, min(max_grey, largest_available))
 323:     grey = _make_grey_mask(allowed, target)
 324:     if grey is None:
 325:         return False
 326: 
 327:     inp[grey] = GEN_ERASED_COLOR
 328:     return True
 329: 
 330: 
 331: def _gen_attempt() -> np.ndarray | None:
 332:     n = random.randint(*GRID_COUNT_RANGE)
 333:     block_size = random.randint(*BLOCK_SIZE_RANGE)
 334:     side = n * block_size + (n - 1)
 335: 
 336:     foreground, blank = random.sample(PAYLOAD_COLORS, PAYLOAD_COLOR_COUNT)
 337:     sprite = _make_sprite(block_size, foreground, blank)
 338:     if sprite is None:
 339:         return None
 340: 
 341:     state, blank_blocks = _sample_block_states(n)
 342:     clean_sprite_blocks = [(r, c) for r in range(n) for c in range(n) if state[r, c]]
 343:     if not clean_sprite_blocks or blank_blocks == 0:
 344:         return None
 345:     clean_block = random.choice(clean_sprite_blocks)
 346: 
 347:     inp, out = _render_clean_grids(n, block_size, side, state, sprite, foreground, blank)
 348:     protected = _build_protected_mask(n, block_size, side, clean_block, sprite, foreground)
 349:     if not _add_grey_overlay(inp, protected):
 350:         return None
 351:     try:
 352:         solved = main(inp)
 353:     except AssertionError:
 354:         return None
 355:     if not np.array_equal(solved, out):
 356:         return None
 357:     return inp
 358: 
 359: 
 360: def generate_input() -> np.ndarray:
 361:     for _ in range(GENERATION_ATTEMPTS):
 362:         grid = _gen_attempt()
 363:         if grid is not None:
 364:             return grid
 365:     raise RuntimeError("failed to generate valid input")

