+        for direction in allowed_dirs:
+            dr, dc = DIR_TO_DELTA[direction]
+            nr = cell_r + dr
+            nc = cell_c + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < len(CELL_STARTS) and 0 <= nc < len(CELL_STARTS)):
