+    weights = np.array([1 if _is_rich_mask(mask) else 0.45 for mask in MASK_OPTIONS], dtype=float)
+    weights /= weights.sum()
+    return MASK_OPTIONS[int(rng.choice(len(MASK_OPTIONS), p=weights))]
