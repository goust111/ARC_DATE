+    reached = set(seeds)
+    q: deque[tuple[int, int]] = deque(seeds)
+    while q:
+        cell_r, cell_c = q.popleft()
+        for direction in allowed_dirs:
+            dr, dc = DIR_TO_DELTA[direction]
+            nr = cell_r + dr
+            nc = cell_c + dc
+            nxt = (nr, nc)
