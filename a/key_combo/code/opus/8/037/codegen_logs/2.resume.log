  10: def _decode_mask(g: np.ndarray) -> tuple[int, np.ndarray]:
  11:     colors = set(map(int, np.unique(g)))
  12:     accent_colors = colors - {EMPTY, BLUE, YELLOW}
  13:     assert len(accent_colors) == 1
  14:     accent = accent_colors.pop()
  15: 
  16:     accent_pixels = g == accent
  17:     coords = np.argwhere(accent_pixels)
  18:     assert coords.size > 0
  19:     rb0, cb0 = coords.min(axis=0)
  20:     rb1, cb1 = coords.max(axis=0)
  21: 
  22:     h, w = g.shape
  23:     candidates: list[tuple[int, int, np.ndarray]] = []
  24:     for r0 in range(max(0, int(rb1) - 5), min(int(rb0), h - 6) + 1):
  25:         for c0 in range(max(0, int(cb1) - 5), min(int(cb0), w - 6) + 1):
  26:             window = g[r0 : r0 + 6, c0 : c0 + 6]
  27:             if not np.all((window == EMPTY) | (window == accent)):
  28:                 continue
  29: 
  30:             localized = np.zeros_like(accent_pixels)
  31:             localized[r0 : r0 + 6, c0 : c0 + 6] = window == accent
  32:             if not np.array_equal(localized, accent_pixels):
  33:                 continue
  34: 
  35:             mask = np.zeros((3, 3), dtype=bool)
  36:             valid = True
  37:             for mr in range(3):
  38:                 for mc in range(3):
  39:                     block = window[2 * mr : 2 * mr + 2, 2 * mc : 2 * mc + 2]
  40:                     if np.all(block == accent):
  41:                         mask[mr, mc] = True
  42:                     elif not np.all(block == EMPTY):
  43:                         valid = False
  44:             if valid:
  45:                 candidates.append((r0, c0, mask))
  46: 
  47:     assert len(candidates) == 1
  48:     _, _, mask = candidates[0]
  49:     assert np.any(mask)
  50:     return accent, mask
