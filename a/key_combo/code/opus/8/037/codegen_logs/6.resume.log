+        variants.append(rot)
+        variants.append(np.fliplr(rot))
+    unique: list[np.ndarray] = []
+    for variant in variants:
+        if not any(np.array_equal(variant, seen) for seen in unique):
+            unique.append(variant)
+    return unique
