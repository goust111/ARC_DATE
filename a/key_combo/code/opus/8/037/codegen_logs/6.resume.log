+    cell_h = yellow_rows[1] - yellow_rows[0] - 1
+    cell_w = yellow_cols[1] - yellow_cols[0] - 1
+    assert cell_h == yellow_rows[2] - yellow_rows[1] - 1 and cell_h > 0
+    assert cell_w == yellow_cols[2] - yellow_cols[1] - 1 and cell_w > 0
