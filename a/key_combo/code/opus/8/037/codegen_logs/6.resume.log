+    row_spans = [
+        (yellow_rows[0] + 1, yellow_rows[1] - 1),
+        (yellow_rows[1] + 1, yellow_rows[2] - 1),
+        (yellow_rows[2] + 1, yellow_rows[2] + cell_h),
+    ]
+    col_spans_local = [
+        (yellow_cols[0] + 1, yellow_cols[1] - 1),
+        (yellow_cols[1] + 1, yellow_cols[2] - 1),
+        (yellow_cols[2] + 1, yellow_cols[2] + cell_w),
