+            c1 = orange_cols[j + 1] - 1
+            assert c0 <= c1, "slot width must be positive"
+            view = grid[r0 : r1 + 1, c0 : c1 + 1]
+            colors = sorted(set(map(int, np.unique(view))) - {BLACK, ORANGE})
