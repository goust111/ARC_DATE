        ((0, w - 1), (h - 1, 0)),
        ((h - 1, 0), (0, w - 1)),
        ((h - 1, w - 1), (0, 0)),
    )
    start, end = corners[int(rng.integers(len(corners)))]
    dr = 1 if end[0] > start[0] else -1
    dc = 1 if end[1] > start[1] else -1
    moves = [(dr, 0)] * (h - 1) + [(0, dc)] * (w - 1)
    rng.shuffle(moves)

