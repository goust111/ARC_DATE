            return [(int(total),)]
        return []
    out = []
    for first in range(1, total - n + 2):
        for rest in _gen_positive_parts(total - first, n - 1):
            out.append((int(first),) + rest)
    return out


def _gen_size_splits(total, lows, highs):
    if len(lows) == 1:
        if lows[0] <= total <= highs[0]:
            return [(int(total),)]
        return []
    out = []
