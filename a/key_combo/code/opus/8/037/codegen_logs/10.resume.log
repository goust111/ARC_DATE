    inp = np.zeros(shape, dtype=int)
    for sprite, a0, x0 in zip(sprites, axis_starts, cross_starts):
        if horizontal:
            paste(inp, sprite, x0, a0, transparent=0)
        else:
            paste(inp, sprite, a0, x0, transparent=0)
    return inp

