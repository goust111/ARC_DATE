+
+def _attempt_generate() -> np.ndarray | None:
+    rng = random.Random()
+    n_rects = _choice(rng, [3, 4, 5])
+    roots, _ = _build_roots(rng, n_rects)
+    grid, rects = _place_roots(rng, roots)
