+        grid = np.zeros((H, W), dtype=int)
+        rects: list[dict[str, object]] = []
+        for root_idx, root in enumerate(roots):
+            canvas = root["canvas"]
+            r0, c0 = placements[root_idx]
+            h, w = canvas.shape
+            grid[r0 : r0 + h, c0 : c0 + w] = canvas
+            for rect in root["rects"]:
