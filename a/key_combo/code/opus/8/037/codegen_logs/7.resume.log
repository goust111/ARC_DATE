+    br0, bc0, br1, bc1 = b
+    return not (ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0)
+
+
+def _candidate_positions(shape: tuple[int, int], used: list[BBox], h: int, w: int) -> list[Coord]:
+    H, W = shape
