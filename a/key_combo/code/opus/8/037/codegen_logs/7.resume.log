+            canvas, rects, idx = _build_length2(rng, colors, idx, require_moat=require_moat)
+            moat_given = True
+        else:
+            canvas, rects, idx = _build_length3(rng, colors, idx)
+        roots.append({"canvas": canvas, "rects": rects})
+    assert idx == n_rects
+    return roots, len(structure)
