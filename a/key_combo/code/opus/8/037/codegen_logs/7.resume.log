+    detected_by_color = {int(rect["color"]): rect for rect in detected}
+    planned_by_color = {int(rect["color"]): rect for rect in planned_rects}
+    if set(detected_by_color) != set(planned_by_color):
+        return False
+    for color in detected_by_color:
