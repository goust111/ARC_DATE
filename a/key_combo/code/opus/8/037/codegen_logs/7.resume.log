+            seeds.add((0, c))
+        if int(grid[h - 1, c]) != BG and int(grid[h - 1, c]) not in rect_colors:
+            seeds.add((h - 1, c))
+    for r in range(h):
+        if int(grid[r, 0]) != BG and int(grid[r, 0]) not in rect_colors:
+            seeds.add((r, 0))
