_GEN_BLOCKER_NEIGHBOR_AVG_MIN, _GEN_BLOCKER_NEIGHBOR_AVG_MAX = 1.4, 2.0
_GEN_COLOR_COUNT_MIN, _GEN_COLOR_COUNT_MAX = 5, 24

