+def _pack_crops(grid: np.ndarray, rects: list[dict[str, object]]) -> np.ndarray:
+    crops = [grid[r0 : r1 + 1, c0 : c1 + 1].copy() for r0, c0, r1, c1 in (rect["bbox"] for rect in rects)]
