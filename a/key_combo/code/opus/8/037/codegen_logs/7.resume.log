+        (0, _randint(rng, 1, W - 2)),
+        (H - 1, _randint(rng, 1, W - 2)),
+        (_randint(rng, 1, H - 2), 0),
+        (_randint(rng, 1, H - 2), W - 1),
+    ]
+
+
+def _parent_map(rects: list[dict[str, object]]) -> dict[int, int | None]:
