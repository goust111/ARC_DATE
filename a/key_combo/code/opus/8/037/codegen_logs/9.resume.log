+def _tile(seed: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    sh, sw = seed.shape
+    rows = np.arange(h) % sh
+    cols = np.arange(w) % sw
+    return seed[rows[:, None], cols[None, :]]
+
