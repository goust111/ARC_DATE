+        inner = g[r0 + 1 : r1, c0 + 1 : c1]
+        assert inner.size > 0, "rectangle must have an interior"
+        nonblack = inner != BACKGROUND
+        if not np.any(nonblack):
+            out[r0 + 1 : r1, c0 + 1 : c1] = frame_color
+            continue
