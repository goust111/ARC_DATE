spec:
  grid: square, side N = 4-7 [observed N=5]
  header:
    definition: top row and left column are identical sequences of length N
    active_prefix: first K non-black colors, K = N-1 to N (trailing blacks = 0-1)
    colors: all non-black, 2-5 distinct colors, may repeat consecutively
  fill_rule: cell (r,c) = header[max(r,c)]
  output:
    size: 2N x 2N
    extended_header: active prefix cycled to length 2N
    fill_rule: same max(r,c) indexing with extended header

generation_strategy:
  approach: direct construction (no inversion needed; input is fully determined by header)
  steps:
    1. pick grid side N in 4-7
    2. pick trailing_blacks in {0, 1}; active_length K = N - trailing_blacks (require K >= 2)
    3. build active header of length K from non-black colors; allow consecutive repeats but ensure >=2 distinct colors
    4. append trailing_blacks zeros to get full header of length N
    5. fill NxN grid via cell(r,c) = header[max(r,c)]
    6. output is not generated (solver produces it)
```
