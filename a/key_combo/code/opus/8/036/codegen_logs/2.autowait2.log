+                continue
+            vr, vc = spec["visible_offset"]
+            patch = spec["visible"]
+            grid[r0 + vr : r0 + vr + patch.shape[0], c0 + vc : c0 + vc + patch.shape[1]] = patch
+            placed_boxes.append(box)
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
