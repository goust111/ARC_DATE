+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _place_specs(specs: list[dict], h: int, w: int) -> np.ndarray | None:
+    grid = np.zeros((h, w), dtype=int)
+    placed_boxes: list[tuple[int, int, int, int]] = []
