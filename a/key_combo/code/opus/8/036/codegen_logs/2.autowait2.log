+def _choose_orientations(count: int) -> list[str]:
+    if count == 2:
+        orientations = ["vertical", "horizontal"]
+    else:
+        orientations = ["vertical", "horizontal", random.choice(["vertical", "horizontal"])]
+    random.shuffle(orientations)
+    return orientations
