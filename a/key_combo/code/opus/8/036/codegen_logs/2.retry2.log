  15: def main(input_grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Swap each bordered square's colors and grow original-border-colored rectangles from its four sides.
  18: 
  19:     Input structure:
  20:     - The grid contains one or two separated square patterns on a black background.
  21:     - Each pattern has a solid inner square and a one-pixel outer border in a different color.
  22:     - There is enough surrounding black space for the pattern to grow outward.
  23: 
  24:     Rule:
  25:     - Split each pattern into its inner and outer square components.
  26:     - Swap the colors of the inner square and outer border.
  27:     - Add four rectangles outside the outer square, using the original border color.
  28: 
  29:     Key insight:
  30:     - The original border color becomes the growth material, while the original inner and
  31:       outer square colors trade places in the central pattern.
  32:     """
  33:     # Get the output grid with the same size as the input grid.
  34:     output_grid = np.copy(input_grid)
  35: 
  36:     # Detect the square pattern in the input grid.
  37:     entire_square = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
  38:     for each_square in entire_square:
  39:         # Detect the inner and outer squares in the pattern.
  40:         object_square = find_components(each_square, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  41: 
  42:         # Split the square pattern into inner and outer squares.
  43:         split_objects = []
  44:         for obj in object_square:
  45:             _b = bbox(obj != Color.BLACK)
  46:             assert _b is not None
  47:             r, c, _r1, _c1 = _b
  48:             width = _r1 - r + 1
  49:             height = _c1 - c + 1
  50:             _b = bbox(obj != Color.BLACK)
