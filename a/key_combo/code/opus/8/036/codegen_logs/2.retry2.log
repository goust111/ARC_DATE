  30: def main(grid: np.ndarray) -> np.ndarray:
  31:     """
  32:     Copy the upper sprite into the adjacent side selected by the lower marker, reflecting it horizontally.
  33: 
  34:     Input structure:
  35:     - The background contains two non-background color masks in vertically separated, aligned bboxes.
  36:     - The upper mask is the source sprite.
  37:     - The lower mask is a marker with one pixel on either the left or right end of its top row.
  38: 
  39:     Rule:
  40:     - If the marker's top-row pixel is on the left end, use the same-size block immediately left of the source bbox.
  41:     - If it is on the right end, use the same-size block immediately right of the source bbox.
  42:     - Horizontally reflect the source mask and paint it into that destination block with the source color.
  43: 
  44:     Key insight:
  45:     The lower marker is a direction code for which side should receive the reflected copy of the upper sprite.
  46:     """
  47:     g = np.asarray(grid, dtype=int)
  48:     bg = int(get_bg(g))
  49: 
  50:     (source_color, source_bbox), (marker_color, marker_bbox) = _two_vertical_color_masks(g, bg)
  51:     sr0, sc0, sr1, sc1 = source_bbox
  52:     mr0, mc0, mr1, mc1 = marker_bbox
  53: 
  54:     sh, sw = sr1 - sr0 + 1, sc1 - sc0 + 1
  55:     mh, mw = mr1 - mr0 + 1, mc1 - mc0 + 1
  56:     assert (sh, sw) == (mh, mw), "source and marker bboxes must have the same shape"
  57:     assert (sc0, sc1) == (mc0, mc1), "source and marker bboxes must be column-aligned"
  58: 
  59:     marker_crop = g[mr0 : mr1 + 1, mc0 : mc1 + 1] == marker_color
  60:     top_cols = np.flatnonzero(marker_crop[0])
  61:     assert len(top_cols) == 1, "marker top row must contain one control pixel"
  62:     control_col = int(top_cols[0])
  63:     assert control_col in (0, mw - 1), "marker control pixel must be on a horizontal end"
  64: 
  65:     if control_col == 0:
  66:         dst_c0 = sc0 - sw
  67:     else:
  68:         dst_c0 = sc1 + 1
  69:     dst_c1 = dst_c0 + sw - 1
  70:     assert 0 <= dst_c0 and dst_c1 < g.shape[1], "destination block must be in bounds"
  71: 
  72:     dest = g[sr0 : sr1 + 1, dst_c0 : dst_c1 + 1]
  73:     assert np.all(dest == bg), "destination block must be empty background"
  74: 
  75:     source_mask = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == source_color
  76:     out = g.copy()
  77:     out_dest = out[sr0 : sr1 + 1, dst_c0 : dst_c1 + 1]
  78:     out_dest[np.fliplr(source_mask)] = source_color
  79:     return out
