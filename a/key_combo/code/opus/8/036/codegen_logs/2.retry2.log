  81: def generate_input():
  82:     # Create the background grid
  83:     n, m = np.random.randint(20, 30), np.random.randint(20, 30)
  84:     grid = np.full((m, n), Color.BLACK)
  85: 
  86:     rectangle_num = 2
  87:     rectangle_color = Color.GREEN
  88:     indicator_color = Color.RED
  89: 
  90:     # Draw rectangles on the grid
  91:     for i in range(rectangle_num):
  92:         width, height = np.random.randint(3, 20), np.random.randint(3, 20)
  93: 
  94:         # The width should be twice smaller than the height
  95:         while (width * 2 + 2) >= height:
  96:             width, height = np.random.randint(3, 20), np.random.randint(3, 20)
  97: 
  98:         green_rectangle = np.full((width, height), rectangle_color)
  99: 
 100:         # Place one indicator pixel on one random border of the rectangle
 101:         # Spare enough space for the extend line with the same size of width - 1
 102:         r_coord = np.random.choice([0, width - 1])
 103:         c_coord = np.random.choice(range(width + 1, height - (width + 1)))
 104:         green_rectangle[r_coord, c_coord] = indicator_color
 105:         # Randomly rotate the object so that we get a variety of orientations
 106:         if np.random.choice([True, False]):
 107:             green_rectangle = np.rot90(green_rectangle, k=-1)
 108:             r_coord, c_coord = c_coord, r_coord
 109: 
 110:         # Place the rectangle on the grid
 111:         try:
 112:             _loc = first_free_location(grid, green_rectangle, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
 113:             if _loc is None:
 114:                 raise ValueError("no placement")
 115:             r, c = _loc
 116:         # Check if there is no space for the rectangle
 117:         except:
 118:             return generate_input()
 119:         paste(grid, green_rectangle, r, c, transparent=Color.BLACK, clip=True)
 120: 
 121:     # Check if the generated grid is valid
 122:     transformed_grid = main(grid)
 123:     objects = find_components(transformed_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
 124: 
 125:     # After transformation, the two objects should not touch each other
 126:     if len(objects) != rectangle_num:
 127:         # Regenerate the grid
 128:         return generate_input()
 129: 
 130:     return grid
