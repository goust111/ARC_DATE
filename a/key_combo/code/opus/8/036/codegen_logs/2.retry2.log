  99:     max_square_len = grid_len // (num_square * 3)
 100: 
 101:     # Choose two colors for inner and outer square, and one color represents the boundary.
 102:     # The boundary is used for leave enough space for the square pattern in output to grow.
 103:     available_color = Color.NOT_BLACK.copy()
 104:     two_colors = random.sample(available_color, k=2)
 105:     available_color.remove(two_colors[0])
 106:     available_color.remove(two_colors[1])
 107:     boundary_color = available_color[0]
 108: 
 109:     for _ in range(num_square):
 110:         # Randomly select the size of the square pattern.
 111:         # The outer square is the inner square with a single pixel border around it.
 112:         outer_square_len = random.randint(3, max_square_len)
 113:         inner_square_len = outer_square_len - 2
 114: 
 115:         # The square will grow inner_square_len in four directions
 116:         border_len = outer_square_len + inner_square_len * 2
 117:         
 118:         # Create the inner square, outer square, and border.
 119:         outer_square = random_sprite(m=outer_square_len, n=outer_square_len, color_palette=[two_colors[1]], density=1.0)
 120:         inner_square = random_sprite(m=inner_square_len, n=inner_square_len, color_palette=[two_colors[0]], density=1.0)
 121:         border = random_sprite(m=border_len, n=border_len, color_palette=[boundary_color], density=1.0)
 122:         
