   1: from __future__ import annotations
   2: import numpy as np
   3: from arc_utils import colors_present, get_bg
   4: import math
   5: import random
   6: from arc_utils import paste
   7: 
   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Clean each color layer by enforcing vertical mirror symmetry.
  11: 
  12:     Input structure:
  13:     - bg = background. Several non-bg colors, each forming a nearly-symmetric pattern about some vertical axis.
  14:     - Some pixels in each color are "noise" that breaks the symmetry.
  15: 
  16:     Rule:
  17:     - For each non-bg color, find the vertical axis that best explains its pixel layout.
  18:     - Remove any pixel that lacks a same-color mirror counterpart across that axis.
  19: 
  20:     Key insight: Each color has its own independent symmetry axis; the task is per-color denoising, not whole-grid symmetry.
  21:     """
  22:     g = np.array(grid, dtype=int)
  23:     bg = int(get_bg(g))
  24:     H, W = g.shape
  25: 
  26:     out = g.copy()
  27:     colors = colors_present(g, exclude={bg})
  28:     assert colors, "grid must contain at least one non-background color"
  29: 
  30:     # Search all possible vertical axes: k in [0, 2*(W-1)] corresponds to axis at c = k/2.
  31:     for col in colors:
  32:         pts = np.argwhere(g == int(col))
  33:         if pts.size == 0:
  34:             continue
  35: 
  36:         best_score = -1
  37:         best_k = 0
  38:         for k in range(0, 2 * (W - 1) + 1):
  39:             score = 0
  40:             for r, c in pts:
  41:                 cc = int(k) - int(c)
  42:                 if 0 <= cc < W and int(g[int(r), cc]) == int(col):
  43:                     score += 1
  44:             if score > best_score:
  45:                 best_score = int(score)
  46:                 best_k = int(k)
  47: 
  48:         # Delete unpaired pixels under the chosen vertical axis.
  49:         k = int(best_k)
  50:         for r, c in pts:
  51:             rr = int(r)
  52:             cc = int(k) - int(c)
  53:             if not (0 <= cc < W and int(g[rr, cc]) == int(col)):
  54:                 out[rr, int(c)] = int(bg)
  55: 
  56:     return out
  57: 
  58: # --------------- generator (codex-att3) ---------------
  59: 
  60: # ── CFG: canvas & layout ──
  61: GRID_SIZE = 22
  62: NUM_OBJECTS = 4                 # bg + 3 sprite colors
  63: LAYOUTS = [
  64:     [(0, 0, 7, 7), (0, 14, 7, 21), (14, 5, 21, 16)],
  65:     [(0, 0, 8, 5), (0, 16, 8, 21), (15, 5, 21, 16)],
  66: ]
  67: 
  68: # ── CFG: clean sprite geometry ──
  69: PIXEL_COUNT_MIN = 6             # min clean pixel count
  70: PIXEL_COUNT_MAX = 46            # max clean pixel count
  71: HEIGHT_MIN = 2                  # min sprite bbox height
  72: HEIGHT_MAX = 9                  # max sprite bbox height
  73: ODD_SIDE_W_RANGE = range(1, 6) # half-width for odd-width sprites (integer axis)
  74: EVEN_SIDE_W_RANGE = range(2, 7) # half-width for even-width sprites (half-integer axis)
  75: DENSITY_LO = 0.35              # min fill ratio within bbox
  76: DENSITY_HI = 0.89              # max fill ratio within bbox
  77: 
  78: # ── CFG: noise ──
  79: NOISE_FRAC_LO = 0.11           # min noise pixels as fraction of clean count
  80: NOISE_FRAC_HI = 0.33           # max noise pixels as fraction of clean count
  81: NOISE_MAX = 12                  # absolute max noise pixels per sprite
