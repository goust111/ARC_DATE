  10: def _two_vertical_color_masks(
  11:     g: np.ndarray, bg: int
  12: ) -> tuple[tuple[int, tuple[int, int, int, int]], tuple[int, tuple[int, int, int, int]]]:
  13:     colors = colors_present(g, exclude={bg})
  14:     assert len(colors) == 2, "expected exactly two non-background colors"
  15: 
  16:     items: list[tuple[int, tuple[int, int, int, int]]] = []
  17:     for color in colors:
  18:         b = bbox(g == color)
  19:         assert b is not None, "non-background color must have pixels"
  20:         items.append((int(color), b))
  21: 
  22:     first, second = items
  23:     if first[1][2] < second[1][0]:
  24:         return first, second
  25:     if second[1][2] < first[1][0]:
  26:         return second, first
  27:     raise AssertionError("expected one upper mask and one lower marker")
  28: 
  29: 
  30: def main(grid: np.ndarray) -> np.ndarray:
  31:     """
  32:     Copy the upper sprite into the adjacent side selected by the lower marker, reflecting it horizontally.
  33: 
  34:     Input structure:
  35:     - The background contains two non-background color masks in vertically separated, aligned bboxes.
  36:     - The upper mask is the source sprite.
  37:     - The lower mask is a marker with one pixel on either the left or right end of its top row.
  38: 
  39:     Rule:
  40:     - If the marker's top-row pixel is on the left end, use the same-size block immediately left of the source bbox.
  41:     - If it is on the right end, use the same-size block immediately right of the source bbox.
  42:     - Horizontally reflect the source mask and paint it into that destination block with the source color.
  43: 
  44:     Key insight:
  45:     The lower marker is a direction code for which side should receive the reflected copy of the upper sprite.
  46:     """
  47:     g = np.asarray(grid, dtype=int)
  48:     bg = int(get_bg(g))
