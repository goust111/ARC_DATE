   1: from __future__ import annotations
   2: 
   3: import numpy as np
   4: 
   5: from arc_utils import Color, colors_present, components_mask
   6: import math
   7: import random
   8: 
   9: 
  10: ERASED = Color.GREY
  11: SEPARATOR = Color.BLACK
  12: 
  13: 
  14: def _is_separator_line(line: np.ndarray) -> bool:
  15:     return set(map(int, line)).issubset({SEPARATOR, ERASED})
  16: 
  17: 
  18: def _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:
  19:     assert separators, "expected at least one separator line"
  20:     bounds = [-1, *separators, int(length)]
  21:     intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
  22:     sizes = [end - start for start, end in intervals]
  23:     assert min(sizes) > 0, "separators must leave non-empty blocks"
  24:     assert len(set(sizes)) == 1, "all encoded blocks must have the same size"
  25:     return intervals
  26: 
  27: 
  28: def _find_sprite(
  29:     g: np.ndarray,
  30:     row_intervals: list[tuple[int, int]],
  31:     col_intervals: list[tuple[int, int]],
  32:     payload_colors: list[int],
  33: ) -> np.ndarray:
  34:     payload = set(payload_colors)
  35:     sprites = []
  36: 
  37:     for r0, r1 in row_intervals:
  38:         for c0, c1 in col_intervals:
  39:             block = g[r0:r1, c0:c1]
  40:             block_colors = set(colors_present(block, exclude={ERASED}))
  41:             assert SEPARATOR not in block_colors, "block interiors cannot contain separator color"
  42:             if ERASED not in set(map(int, block.flat)) and block_colors == payload:
  43:                 sprites.append(block.copy())
  44: 
  45:     assert sprites, "expected at least one fully visible sprite block"
  46:     sprite = sprites[0]
  47:     for candidate in sprites:
  48:         assert np.array_equal(candidate, sprite), "fully visible sprite blocks must match"
  49:     return sprite
  50: 
  51: 
  52: def _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:
  53:     counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}
  54:     assert counts[payload_colors[0]] != counts[payload_colors[1]], "sprite colors must have a majority/minority split"
  55:     foreground = max(payload_colors, key=lambda color: counts[color])
  56:     blank_colors = [color for color in payload_colors if color != foreground]
  57:     assert len(blank_colors) == 1
  58:     return int(foreground), int(blank_colors[0])
  59: 
  60: 
  61: def main(grid: np.ndarray) -> np.ndarray:
  62:     """
  63:     Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.
  64: 
  65:     Input structure
  66:     The grid is partitioned by black separator rows and columns into equal-size
  67:     square blocks. Each block is either a copy of one two-color sprite or a
  68:     uniform blank block of the sprite's minority color; grey pixels are erased
  69:     cells that act as wildcards.
