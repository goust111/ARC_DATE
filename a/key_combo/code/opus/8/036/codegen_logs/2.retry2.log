   6: # concepts:
   7: # growing, color change
   8: 
   9: # description:
  10: # In the input you will see square(s) with a single pixel border around them in a different color.
  11: # To make the output, swap the color between the square and the border, 
  12: # and then put rectangles on the edges of the border whose width is the same as the length of the inner square, 
  13: # and whose color is the same as the border in the input image.
  14: 
  15: def main(input_grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Swap each bordered square's colors and grow original-border-colored rectangles from its four sides.
  18: 
  19:     Input structure:
  20:     - The grid contains one or two separated square patterns on a black background.
  21:     - Each pattern has a solid inner square and a one-pixel outer border in a different color.
  22:     - There is enough surrounding black space for the pattern to grow outward.
  23: 
  24:     Rule:
  25:     - Split each pattern into its inner and outer square components.
  26:     - Swap the colors of the inner square and outer border.
  27:     - Add four rectangles outside the outer square, using the original border color.
  28: 
  29:     Key insight:
  30:     - The original border color becomes the growth material, while the original inner and
  31:       outer square colors trade places in the central pattern.
  32:     """
  33:     # Get the output grid with the same size as the input grid.
  34:     output_grid = np.copy(input_grid)
  35: 
  36:     # Detect the square pattern in the input grid.
  37:     entire_square = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
  38:     for each_square in entire_square:
  39:         # Detect the inner and outer squares in the pattern.
  40:         object_square = find_components(each_square, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  41: 
  42:         # Split the square pattern into inner and outer squares.
  43:         split_objects = []
  44:         for obj in object_square:
  45:             _b = bbox(obj != Color.BLACK)
  46:             assert _b is not None
  47:             r, c, _r1, _c1 = _b
  48:             width = _r1 - r + 1
  49:             height = _c1 - c + 1
  50:             _b = bbox(obj != Color.BLACK)
  51:             assert _b is not None
  52:             shape = crop_bbox(obj, _b)
  53:             color = obj[r, c]
  54:             split_objects.append({'x': r, 'y': c, 'len': width, 'color': color, 'shape': shape})
  55: 
  56:         # Get the outer and inner square by comparing their size.
  57:         if split_objects[0]['len'] > split_objects[1]['len']:
  58:             outer_square = split_objects[0]
  59:             inner_square = split_objects[1]
  60:         else:
  61:             outer_square = split_objects[1]
  62:             inner_square = split_objects[0]
  63:         
  64:         # Swap the color between the inner and outer squares.
  65:         outer_square_pattern, inner_square_pattern = outer_square['shape'], inner_square['shape']
  66:         outer_square_pattern[outer_square_pattern == outer_square['color']] = inner_square['color']
  67:         inner_square_pattern[inner_square_pattern == inner_square['color']] = outer_square['color']
  68: 
  69:         # Draw the inner and outer squares after swaping on the output grid.
  70:         output_grid = paste(output_grid, outer_square_pattern, outer_square['x'], outer_square['y'], transparent=Color.BLACK, clip=True)
  71:         output_grid = paste(output_grid, inner_square_pattern, inner_square['x'], inner_square['y'], transparent=Color.BLACK, clip=True)
  72: 
  73:         # Draw the rectangle as growing from outer square, the width is the same as the length of the inner square.
  74:         # The rectangle is the same color as the original outer square.
  75:         rectangle_width, rectangle_height = outer_square['len'], inner_square['len']  
  76:         
  77:         # Create the rectangle pattern for the edges of the outer square.
  78:         rectangle_up_down = np.full((rectangle_width, rectangle_height), outer_square['color'])
  79:         rectangle_left_right = np.full((rectangle_height, rectangle_width), outer_square['color'])
  80: 
  81:         # Draw the rectangle on the four edges of the outer square.
