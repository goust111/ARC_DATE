  16: def main(input_grid):
  17:     """
  18:     Grow each green rectangle outward from its red border indicator to the canvas edge.
  19: 
  20:     Input structure:
  21:     - Each foreground object is a green rectangle with one red pixel on its border.
  22:     - Objects sit on a black background.
  23:     - The red pixel indicates the side from which growth should extend.
  24: 
  25:     Rule:
  26:     - Find each rectangle-and-indicator component.
  27:     - Extend a green band from the rectangle toward the canvas edge on the indicator side.
  28:     - Draw a red line from the indicator pixel to that same edge.
  29: 
  30:     Key insight:
  31:     - The indicator side controls direction, while the rectangle thickness controls the grown band.
  32:     """
  33:     # Initialize the output grid
  34:     output_grid = np.copy(input_grid)
  35:     
  36:     rectangle_color = Color.GREEN
  37:     indicator_color = Color.RED
  38:     background = Color.BLACK
  39: 
  40:     # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
  41:     objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
  42:     for obj in objects:
  43:         # find the red indicator
  44:         for red_r, red_c in np.argwhere(obj == indicator_color):
  45:             break
  46: 
  47:         # Get the dimensions of the object, and its position
  48:         _b = bbox(obj != background)
  49:         assert _b is not None
  50:         r, c, _r1, _c1 = _b
  51:         width = _r1 - r + 1
  52:         height = _c1 - c + 1
  53: 
  54:         # depending on which side of the rectangle that the indicator is on, we draw in different directions
  55:         # left edge: draw to the left
  56:         if red_r == r:
  57:             # Extend the green rectangle to the left until it reaches the border
  58:             output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
  59:             # Draw the red line from the red pixel to the border
  60:             draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
  61:         elif red_r == r + width - 1:
  62:             # Extend the green rectangle to the right until it reaches the border
  63:             output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
  64:             # Draw the red line from the red pixel to the border
  65:             draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
  66:         elif red_c == c:
  67:             # Extend the green rectangle to the top until it reaches the border
  68:             output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
  69:             # Draw the red line from the red pixel to the border
  70:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
  71:         elif red_c == c + height - 1:
  72:             # Extend the green rectangle to the bottom until it reaches the border
