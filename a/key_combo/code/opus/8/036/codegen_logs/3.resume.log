+        for r in range(r0, r1 + 1):
+            cast(r, c0 - 1, 0, -1)
+            cast(r, c1 + 1, 0, 1)
+        for c in range(c0, c1 + 1):
+            cast(r0 - 1, c, -1, 0)
+            cast(r1 + 1, c, 1, 0)
