+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _scan_nonblue_objects(
+    grid: np.ndarray,
+) -> tuple[list[dict[str, int | tuple[int, int, int, int]]], list[dict[str, int | tuple[int, int]]]]:
+    sources = []
+    seeds = []
