+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < TEMPLATE_SIZE and 0 <= nc < TEMPLATE_SIZE and not mask[nr, nc]:
+                    frontier.add((nr, nc))
+        nr, nc = random.choice(tuple(frontier))
