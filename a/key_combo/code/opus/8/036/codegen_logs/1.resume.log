+    forbidden = set(src_cells)
+    for r, c in src_cells:
+        forbidden.update(_neighbors4(r, c))
+    for r, c in forbidden:
+        if 0 <= r < CELL and 0 <= c < CELL:
+            allowed[r, c] = False
+    return allowed
