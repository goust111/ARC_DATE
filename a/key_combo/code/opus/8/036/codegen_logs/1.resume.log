+        placed_cells.add((br, bc))
+        inside_wall_found = True
+    if not outside_wall_found:
+        if not remaining_outside:
+            return None
+        br, bc = rng.choice(remaining_outside)
+        if _place_general_wall(rng, grid, br, bc) is None:
