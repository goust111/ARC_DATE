+
+    meta = {
+        "H": H,
+        "panel_w": panel_w,
+        "columns": tuple(columns),
+        "colors": tuple(colors),
+        "starts": tuple(starts),
+        "increments": tuple(increments),
+        "heights4": tuple(heights4),
+    }
+    return grid, out, meta
+
+
+def _validate_generated(grid: np.ndarray, expected: np.ndarray, meta: dict) -> None:
