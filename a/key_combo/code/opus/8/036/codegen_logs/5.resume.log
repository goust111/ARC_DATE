+
+    grid = np.zeros((H, panel_w * 4 + 3), dtype=int)
+    for i, panel in enumerate(panels):
+        start = i * (panel_w + 1)
+        grid[:, start : start + panel_w] = panel
+        if i < 3:
+            grid[:, start + panel_w] = GREY
+
+    out = np.zeros((H, panel_w), dtype=int)
