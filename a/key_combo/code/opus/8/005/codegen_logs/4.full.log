+def _coords_fit_bbox(coords: np.ndarray, box: tuple[int, int, int, int], orientation: str, k: int) -> bool:
+    r0, c0, r1, c1 = box
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height < 2 or width < 2:
+        return False
+    if orientation == "horizontal" and height != k:
+        return False
+    if orientation == "vertical" and width != k:
+        return False
+    on_border = (
+        (coords[:, 0] == r0)
+        | (coords[:, 0] == r1)
+        | (coords[:, 1] == c0)
+        | (coords[:, 1] == c1)
