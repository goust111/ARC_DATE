+
+def _scatter_pixels(grid: np.ndarray, frame: tuple[int, int, int, int]) -> list[tuple[int, int, int]]:
+    r0, c0, r1, c1 = frame
+    pts = []
+    for r, c in np.argwhere(grid != BLACK):
+        rr = int(r)
+        cc = int(c)
+        if r0 <= rr <= r1 and c0 <= cc <= c1:
+            continue
+        pts.append((rr, cc, int(grid[rr, cc])))
