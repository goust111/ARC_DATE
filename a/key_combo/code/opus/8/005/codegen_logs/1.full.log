+
+def _assign_stripe_colors(count: int) -> list[int]:
+    colors = [BLUE, TEAL]
+    while len(colors) < count:
+        colors.append(random.choice([BLUE, TEAL]))
+    random.shuffle(colors)
+    return colors
+
+
+def _choose_shapes(count: int) -> list[np.ndarray]:
