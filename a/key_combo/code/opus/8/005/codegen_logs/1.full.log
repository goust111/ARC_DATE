+
+ORANGE = Color.ORANGE
+GREY = Color.GREY
+BLUE = Color.BLUE
+RED = Color.RED
+GREEN = Color.GREEN
+YELLOW = Color.YELLOW
+TEAL = Color.TEAL
+BLACK = Color.BLACK
+
+FRAME_COLORS = {BLUE, RED, GREEN, YELLOW}
+STRIPE_COLORS = {BLUE, TEAL}
+
+SHAPES = [
+    np.array([[1, 1, 1]], dtype=int),
+    np.array([[1, 1], [1, 0]], dtype=int),
+    np.array([[1, 1], [0, 1]], dtype=int),
+    np.array([[1, 1], [1, 1]], dtype=int),
