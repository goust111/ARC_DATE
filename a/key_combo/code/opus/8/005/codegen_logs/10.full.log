+        h = int(item["height"])
+        w = int(item["width"])
+        assert h <= rh and w <= rw, "sorted frames must fit inside the previous interior"
+        top = rr + rh - h
+        left = cc
+        region = _draw_frame(out, top, left, h, w, Color.PINK)
