    for panel_color in colors_present(g):
        for panel_coords in components_mask(g == panel_color, connectivity=4):
            if not _looks_like_panel(panel_coords):
                continue

            panels += 1
            r0, c0, r1, c1 = bbox_coords(panel_coords)
            region = g[r0 : r1 + 1, c0 : c1 + 1]
