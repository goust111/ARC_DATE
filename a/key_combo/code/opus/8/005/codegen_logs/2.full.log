+    r0, c0, r1, c1 = _bbox(gray_coords)
+    assert r1 - r0 == 3 and c1 - c0 == 3, "glyph block must be 4x4"
+    block = left[r0 : r1 + 1, c0 : c1 + 1]
+
+    for value, glyph in GLYPH_BLOCKS.items():
