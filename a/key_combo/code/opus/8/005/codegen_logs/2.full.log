+        panel[top, :] = int(color)
+        panel[bottom, :] = int(color)
+        panel[top : bottom + 1, 0] = int(color)
+        panel[top : bottom + 1, RIGHT_WIDTH - 1] = int(color)
+    return panel
+
+
+def _choose_configuration(
