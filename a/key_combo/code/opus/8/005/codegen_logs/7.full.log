+    left_width = random.randint(4, 5)
+    region_gap = random.randint(1, 2)
+
+    factor = random.randint(2, 4)
+    color = random.choice([BLUE, RED, GREEN])
+    sprite = _SPRITES[factor][random.randrange(len(_SPRITES[factor]))] * color
