+    assert sprite.shape == (3, 3), "expected a 3x3 sprite"
+    assert np.any(sprite != BLACK), "sprite must contain foreground"
+    return sprite
+
+
+def _decode_glyphs(grid: np.ndarray) -> list[int]:
+    grey_cols = np.where(np.any(grid == GREY, axis=0))[0]
