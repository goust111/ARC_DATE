+    n = int(flags.size)
+    while i < n:
+        if not bool(flags[i]):
+            i += 1
+            continue
+        j = i
+        while j + 1 < n and bool(flags[j + 1]):
+            j += 1
+        runs.append((i, j))
+        i = j + 1
+    return runs
