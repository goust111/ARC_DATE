+            if random.random() < 0.75:
+                continue
+        return norm
+    return None
+
+
+def _can_place(grid: np.ndarray, shape: list[tuple[int, int]], top: int, left: int) -> bool:
+    h, w = grid.shape
+    for dr, dc in shape:
+        r = top + dr
+        c = left + dc
+        if not (0 <= r < h and 0 <= c < w):
+            return False
