+    excluded_rows = {
+        r
+        for r, c in map(tuple, np.argwhere(g == MAROON))
+        if r0 <= r <= r1 and (c < c0 or c > c1)
+    }
+    excluded_cols = {
+        c
+        for r, c in map(tuple, np.argwhere(g == MAROON))
+        if c0 <= c <= c1 and (r < r0 or r > r1)
+    }
