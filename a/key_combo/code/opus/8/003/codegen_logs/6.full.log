        candidates.append(((r, cc + w), (0, 1)))
    for c in range(cc, cc + w):
        candidates.append(((rr - 1, c), (-1, 0)))
        candidates.append(((rr + h, c), (1, 0)))
    return candidates


def _gen_direction_options(direction):
    dr, dc = direction
    dirs = [(dr, dc)]
    if dr == 0:
        dirs.extend([(-1, 0), (1, 0)])
    else:
