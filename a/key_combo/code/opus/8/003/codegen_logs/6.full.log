+        if grid[row, side_c] != BG:
+            return None
+        grid[row, side_c] = MAROON
+    for col in excluded_cols:
+        side_r = r0 - 1 if random.random() < 0.5 else r1 + 1
+        if grid[side_r, col] != BG:
+            return None
+        grid[side_r, col] = MAROON
