+
+    chosen = _choose_markers_and_cuts((r0, c0, r1, c1), paired)
+    if chosen is None:
+        return None
+    markers, excluded_rows, excluded_cols = chosen
+
+    for mr, mc in markers:
+        grid[mr, mc] = ORANGE
+
+    for row in excluded_rows:
