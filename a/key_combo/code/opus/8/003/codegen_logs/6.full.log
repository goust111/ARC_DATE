+            cells = {(marker[0] + dr, marker[1] + dc) for dr, dc in offsets}
+            if any(not (r0 <= r <= r1 and c0 <= c <= c1) for r, c in cells):
+                ok = False
+                break
+            if occupied & cells:
+                ok = False
+                break
+            occupied |= cells
+            targets.append(cells)
+        if not ok:
+            continue
+
