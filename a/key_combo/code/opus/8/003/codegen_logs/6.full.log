+        if shape is None:
+            return None
+        cells = _place_shape(grid, color, shape)
+        if cells is None:
+            return None
+        placed_sprites.append(cells)
+
+    sprites = sorted(placed_sprites, key=_sort_key)
+    active = sprites[::2]
+    paired = active[:2]
+    if len(paired) != 2:
