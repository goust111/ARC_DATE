def _gen_between(value, bounds):
    return bounds[0] <= value <= bounds[1]


def _gen_bbox(cells):
    rs = [r for r, _ in cells]
    cs = [c for _, c in cells]
    return min(rs), min(cs), max(rs), max(cs)


def _gen_adds_bad_2x2(cells, protected_rect, cand):
    trial = set(cells)
    trial.add(cand)
    r, c = cand
    for r0 in (r - 1, r):
