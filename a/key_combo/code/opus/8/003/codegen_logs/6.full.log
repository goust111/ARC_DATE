+        later = [p for p in fits[1] if p != m1 and p >= m1]
+        if not later:
+            continue
+        m2 = random.choice(later)
+        markers = [m1, m2]
+        targets = []
+        ok = True
+        occupied: set[tuple[int, int]] = set()
