+                if forbid is not None and any(cell in forbid for cell in cells):
+                    continue
+                if not _box_clear(grid, rr, cc, rr, cc + ll - 1, pad=1):
+                    continue
+                grid[rr, cc : cc + ll] = OBSTACLE
