+
+
+def _place_bar(
+    grid: np.ndarray,
+    marker_cols: set[int],
+    *,
+    row: int | None = None,
+    c0: int | None = None,
+    length: int | None = None,
+    forbid: set[tuple[int, int]] | None = None,
+) -> bool:
+    h, w = grid.shape
