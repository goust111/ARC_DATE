    if bbox(mask) != (0, 0, h - 1, w - 1):
        return None
    if not is_contiguous(mask, background=BACKGROUND_COLOR, connectivity=CONNECTIVITY):
        return None
    return mask


def _gen_attempt() -> np.ndarray | None:
    colors = random.sample(COLOR_POOL, LEGEND_CELLS)
