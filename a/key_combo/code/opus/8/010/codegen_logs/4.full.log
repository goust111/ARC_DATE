+        "bottom": ((r1 + 1, cc), (r1 - 1, cc), (-1, 0)),
+        "left": ((cr, c0 - 1), (cr, c0 + 1), (0, 1)),
+        "right": ((cr, c1 + 1), (cr, c1 - 1), (0, -1)),
+    }
+
+
+def _inside(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
