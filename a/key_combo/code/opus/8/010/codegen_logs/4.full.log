+    interior = np.abs(rows - cr) + np.abs(cols - cc) < radius
+
+    out = g.copy()
+    for marker_pos, start_pos, step in _ray_specs(cr, cc, radius).values():
+        mr, mc = marker_pos
+        if not _inside(g.shape, mr, mc):
+            continue
+        marker_color = int(g[mr, mc])
+        if marker_color not in swap:
