        for nbr in _gen_neighbors4(*cell, h, w)
        if nbr not in occupied and nbr not in blob
    }
    while len(blob) < size:
        if not frontier:
            return None
        cell = random.choice(tuple(frontier))
        frontier.remove(cell)
