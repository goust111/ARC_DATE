+    c_r0, c_c0, c_r1, c_c1 = c_rect["r0"], c_rect["c0"], c_rect["r1"], c_rect["c1"]
+
+    d_c0_min = c_c0 + 1
+    d_c0_max = b_c0 - 1
+    d_c1_min = a_c1 + 1
+    d_c1_max = c_c1 - 1
+    d_r0_min = c_r0 + 1
+    d_r0_max = a_r1 - 1
+    if d_c0_min > d_c0_max or d_c1_min > d_c1_max or d_r0_min > d_r0_max:
+        return None
+
+    candidates: list[dict[str, int]] = []
