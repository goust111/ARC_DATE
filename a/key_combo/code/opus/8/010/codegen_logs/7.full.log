+        shift_c = random.randint(0, w - 1 - max_c)
+
+        rects = [
+            {"r0": a_r0 + shift_r, "c0": a_c0 + shift_c, "r1": a_r1 + shift_r, "c1": a_c1 + shift_c},
+            {"r0": b_r0 + shift_r, "c0": b_c0 + shift_c, "r1": b_r1 + shift_r, "c1": b_c1 + shift_c},
