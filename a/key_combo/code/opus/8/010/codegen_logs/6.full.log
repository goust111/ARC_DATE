def _gen_spanning_mask(h: int, w: int, target_area: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    bend_budget = max(0, target_area - (h + w - 1))

    if random.random() < VERTICAL_SPINE_PROB:
        c = random.randrange(w)
        mask[0, c] = True
        bends_used = 0
        for r in range(1, h):
