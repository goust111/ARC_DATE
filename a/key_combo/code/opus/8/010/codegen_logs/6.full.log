    counts = [MIN_PIXELS_PER_COLOR] * LEGEND_CELLS
    remaining = total - sum(counts)
    while remaining > 0:
        choices = [i for i, count in enumerate(counts) if count < MAX_PIXELS_PER_COLOR]
        idx = random.choice(choices)
        counts[idx] += 1
        remaining -= 1
    return counts


