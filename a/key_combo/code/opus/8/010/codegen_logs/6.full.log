+    r = ref_h + 1
+    for i, prefix_w in enumerate(prefixes):
+        inner[r : r + ref_h, :prefix_w] = ref[:, :prefix_w]
+        r += ref_h
+        if i != len(prefixes) - 1:
+            r += 1
+
+    return grid
