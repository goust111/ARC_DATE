def _gen_valid_dims(area: int) -> list[tuple[int, int]]:
    dims = []
    for h in OBJECT_HEIGHTS:
        for w in OBJECT_WIDTHS:
            density = area / (h * w)
            if DENSITY_MIN <= density <= DENSITY_MAX and h + w - 1 <= area:
                dims.append((h, w))
