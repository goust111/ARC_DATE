+def _render_frames(
+    shape: tuple[int, int],
+    order: list[int],
+    bboxes: dict[int, tuple[int, int, int, int]],
+    *,
+    bg: int,
+) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    for color in order:
+        out[_frame_mask(shape, bboxes[color])] = int(color)
+    return out
