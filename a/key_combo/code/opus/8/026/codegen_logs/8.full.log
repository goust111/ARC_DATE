+        swatch = swatch_band[:, c0 : c1 + 1]
+        swatch_colors = set(map(int, swatch.ravel()))
+        assert len(swatch_colors) == 1
+        color = int(next(iter(swatch_colors)))
+        assert color not in {BG, BLUE, RED, GREY, PINK}
