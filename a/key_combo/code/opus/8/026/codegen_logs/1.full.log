        for dr,dc in coords:
            rr,cc=r+dr,c+dc
            if in_bounds(out.shape,rr,cc) and paintable[rr,cc]:
                out[rr,cc]=col
    return out,recovered

for t in range(200):
    H=W=random.choice([13,15,17])
    hr=H//2; vc=W//2
    shape,reps=build_shape(H,W,hr,vc)
    if shape is None: continue
    holes=choose_holes(shape,reps[:],hr,vc)
    if holes is None: continue
    g=np.zeros((H,W),int)
    full=np.zeros((H,W),int)
    for r,c in shape: full[r,c]=1; g[r,c]=1
    for r,c in holes: g[r,c]=0
    hr2,hs,hw=infer_axis(g,'h'); vc2,vs,vw=infer_axis(g,'v')
    if hr2"'!=hr or vc2!=vc or len(hw)!=1 or len(vw)!=1: continue
    exp=expected_from_truth(g,set(shape),hr,vc)
    if exp is None: continue
    out,recovered,axes,winners=transform(g)
    if axes!=(hr,vc): continue
    if any(k=='"'D' for _,_,k in recovered): continue
    if len(recovered)"'!=len(holes): continue
    if not np.array_equal(out,exp[0]): continue
    colors=set(map(int,out.flat))
    if not {GREEN,YELLOW,ORANGE}<=colors: continue
    cnt=Counter(k for _,_,k in recovered)
    if not all(cnt[x]>=1 for x in '"'HVB'): continue
    print('success', t, H, len(shape), len(holes), cnt)
    break
else:
    print('no success')
