+        vr, vc = r, 2 * vertical_axis - c
+        dr, dc = 2 * horizontal_axis - r, 2 * vertical_axis - c
+        h_blue = int(inp[hr, hc]) == BLUE
+        v_blue = int(inp[vr, vc]) == BLUE
+        d_blue = int(inp[dr, dc]) == BLUE
+        if not (h_blue or v_blue or d_blue):
