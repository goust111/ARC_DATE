+BLACK = 0
+BLUE = 1
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ORTHOGONALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+EIGHT_NEIGHBORS = [
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if (dr, dc) != (0, 0)
+]
