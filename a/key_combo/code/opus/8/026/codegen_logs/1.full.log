    return out,recovered,(hr,vc),(hw,vw)

def orbit(hr,vc,r,c):
    return ((r,c),(2*hr-r,c),(r,2*vc-c),(2*hr-r,2*vc-c))

def is_connected(shape):
    pts=set(shape)
    if not pts: return False
    stack=[next(iter(pts))]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for nr,nc in neighbors4(r,c):
            if (nr,nc) in pts and (nr,nc) not in seen:
