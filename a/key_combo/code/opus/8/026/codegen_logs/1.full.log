        rh, ch = 2*hr-r, c
        rv, cv = r, 2*vc-c
        rd, cd = 2*hr-r, 2*vc-c
        hblue = in_bounds(g.shape,rh,ch) and g[rh,ch]==BLUE
        vblue = in_bounds(g.shape,rv,cv) and g[rv,cv]==BLUE
        dblue = in_bounds(g.shape,rd,cd) and g[rd,cd]==BLUE
        if not (hblue or vblue or dblue):
            continue
        if hblue and vblue:
            kind='B'
        elif hblue:
            kind='H'
        elif vblue:
            kind='V'
        else:
            kind='D'
        restored[r,c]=BLUE
        recovered.append((r,c,kind))
