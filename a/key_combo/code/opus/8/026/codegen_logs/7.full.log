+def _rectangle_outline(area: int) -> list[np.ndarray]:
+    patches: list[np.ndarray] = []
+    for ih in range(1, area + 1):
+        if area % ih != 0:
+            continue
+        iw = area // ih
+        h = ih + 2
+        w = iw + 2
+        patch = np.zeros((h, w), dtype=int)
