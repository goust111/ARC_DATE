+        for r, c in blue_coords:
+            mc = 2 * int(axis) - int(c)
+            if 0 <= mc < w and int(g[int(r), int(mc)]) == BLUE:
+                paired += 1
+        scores.append(int(paired))
+    best = max(scores)
+    axes = [i for i, score in enumerate(scores) if score == best]
+    return int(axes[0]), scores
