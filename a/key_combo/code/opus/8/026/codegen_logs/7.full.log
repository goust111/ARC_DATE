+    rect[-1, :] = GREY
+    rect[:, 0] = GREY
+    rect[:, -1] = GREY
+    return np.array_equal(patch, rect)
+
+
+def _outline_patch_from_rows(rows: list[tuple[int, int]]) -> np.ndarray:
+    h = len(rows)
+    w = max(r for _l, r in rows) + 1
+    patch = np.zeros((h, w), dtype=int)
+    for idx, (l, r) in enumerate(rows):
