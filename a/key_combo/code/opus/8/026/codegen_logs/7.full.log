+def _enclosed_black_cells(patch: np.ndarray) -> list[tuple[int, int]]:
+    reachable = _outside_reachable_black(patch)
+    enclosed = (patch == BLACK) & ~reachable
+    coords = np.argwhere(enclosed)
+    return [(int(r), int(c)) for r, c in coords]
