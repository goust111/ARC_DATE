+
+def _breaker_reds(grid: np.ndarray, axis: int) -> list[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out: list[tuple[int, int]] = []
+    for r, c in np.argwhere(g == RED):
