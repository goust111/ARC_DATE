    for shape in shapes:
        rows = [r for r, _c in shape]
        cols = [c for _r, c in shape]
        h = max(rows) - min(rows) + 1
        w = max(cols) - min(cols) + 1
        if h <= max_h and w <= max_w:
            pool.append(tuple(sorted(shape)))

    _GEN_SKELETON_CACHE[size] = pool
    return pool


