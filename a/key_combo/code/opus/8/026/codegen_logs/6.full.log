+    current = _rep_weight(next(iter(reps)), h, w)
+    if current > target:
+        return None
+
+    while current < target:
+        choices = [
+            rep
+            for rep in _frontier(reps, qh, qw)
+            if current + _rep_weight(rep, h, w) <= target
+        ]
+        if not choices:
+            return None
+        random.shuffle(choices)
+        rep = choices[0]
+        reps.add(rep)
+        current += _rep_weight(rep, h, w)
