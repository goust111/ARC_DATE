+
+def _orbit_groups(full_mask: np.ndarray, a2: int, b2: int) -> dict[tuple[tuple[int, int], ...], list[tuple[int, int]]]:
+    groups: dict[tuple[tuple[int, int], ...], list[tuple[int, int]]] = {}
