+    out: set[tuple[int, int]] = set()
+    for r, c in reps:
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < qh and 0 <= nc < qw and (nr, nc) not in reps:
+                out.add((int(nr), int(nc)))
