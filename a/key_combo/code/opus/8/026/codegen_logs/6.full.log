+def _path_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc, steps = _unit_step(a, b)
+    r0, c0 = a
+    return [(int(r0 + i * sr), int(c0 + i * sc)) for i in range(steps + 1)]
