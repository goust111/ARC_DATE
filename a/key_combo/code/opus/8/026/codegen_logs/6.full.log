+        left_options = []
+        right_options = []
+        for i in range(mask_indices[0]):
+            r, c = line[i]
+            if c * 2 != a2 and r * 2 != b2:
+                left_options.append(i)
+        for i in range(mask_indices[-1] + 1, len(line)):
+            r, c = line[i]
+            if c * 2 != a2 and r * 2 != b2:
+                right_options.append(i)
