+        if bool(restore_mask[r, c]):
+            out[r, c] = Color.ORANGE
+        elif int(grid[r, c]) == Color.BLUE:
+            out[r, c] = Color.GREEN
+        else:
+            out[r, c] = Color.RED
+    return out
