+_GRID_MIN = 11
+_GRID_MAX = 17
+_OBJ_SIZE_RANGE = (6, 10)
+_AREA_RANGE = (20, 35)
+_HOLE_RANGE = (4, 8)
+_MAX_ATTEMPTS = 500
