+def _local_orbit(local_r: int, local_c: int, h: int, w: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        sorted(
+            {
+                (int(local_r), int(local_c)),
+                (int(local_r), int(w - 1 - local_c)),
+                (int(h - 1 - local_r), int(local_c)),
+                (int(h - 1 - local_r), int(w - 1 - local_c)),
+            }
+        )
