+    if np.array_equal(expected, _symmetry_only(inp, full_mask)):
+        return None
+
+    if not set(map(int, np.unique(expected))) >= {Color.BLUE, Color.RED, Color.GREEN, Color.ORANGE}:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
