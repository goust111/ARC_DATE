+    start = tuple(map(int, red_coords[0]))
+    end = tuple(map(int, red_coords[1]))
+
+    full_mask, _info = _infer_full_mask(g)
+    path = set(_path_cells(start, end))
+    return _compose_output(g, full_mask, path)
