+                right_options.append(i)
+        if not left_options or not right_options:
+            continue
+        li = random.choice(left_options)
+        ri = random.choice(right_options)
+        start = line[li]
+        end = line[ri]
+        path = line[li : ri + 1]
+        if sum(bool(full_mask[cell]) for cell in path) >= 2:
+            candidates.append((start, end, path))
+    return candidates
