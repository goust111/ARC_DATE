from arc_utils import neighbors4 as _gen_neighbors4, paste

# --- CFG: canvas and blue-band layout ---
GEN_GRID_SHAPE = (12, 12)
GEN_GRID_H, GEN_GRID_W = GEN_GRID_SHAPE
GEN_BAND_HEIGHT = 3
