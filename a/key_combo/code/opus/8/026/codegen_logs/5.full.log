+    tile[blue_mask] = Color.BLUE
+    tile[red_r, red_c] = Color.RED
+
+    if not _valid_input(tile):
+        return None
+    return tile
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
