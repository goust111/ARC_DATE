+    object_meta: list[dict] = []
+    for idx, area in enumerate(object_areas):
+        patch = _build_object_patch(area, rng)
+        meta = {
+            "kind": "object",
+            "index": idx,
+            "area": area,
+            "matched": area in matched_areas,
+            "patch": patch.copy(),
+        }
