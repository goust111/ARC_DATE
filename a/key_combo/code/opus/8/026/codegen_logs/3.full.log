+        coords = obj["coords"]
+        values = g[coords[:, 0], coords[:, 1]]
+        a, b = sorted(set(map(int, values)))
+        a_mask = values == a
+        b_mask = values == b
+        out[coords[a_mask, 0], coords[a_mask, 1]] = b
+        out[coords[b_mask, 0], coords[b_mask, 1]] = a
