+def _parse_scene(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    assert int(get_bg(g)) == BG, "expected black background"
