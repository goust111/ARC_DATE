+    expanded[:-1, :] |= mask[1:, :]
+    expanded[:, 1:] |= mask[:, :-1]
+    expanded[:, :-1] |= mask[:, 1:]
+    expanded[1:, 1:] |= mask[:-1, :-1]
+    expanded[:-1, :-1] |= mask[1:, 1:]
+    expanded[1:, :-1] |= mask[:-1, 1:]
+    expanded[:-1, 1:] |= mask[1:, :-1]
+    return expanded
