+        lower[ar, ac] = item["marker_color"]
+        lower[br, bc] = item["marker_color"]
+
+    sep = np.full((1, width), SEP, dtype=int)
+    return np.vstack([legend, sep, lower])
+
+
+def _gen_attempt() -> np.ndarray | None:
