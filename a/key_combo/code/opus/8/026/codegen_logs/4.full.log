+if str(UTILS_DIR) not in sys.path:
+    sys.path.append(str(UTILS_DIR))
+
+from arc_utils import crop_bbox, find_components, get_bg, paste
+
+
+BG = 0
+SEP = 5
+SPRITE_SIZE = 3
