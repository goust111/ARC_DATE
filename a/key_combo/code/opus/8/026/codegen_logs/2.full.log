+
+def _parse_scene(grid: np.ndarray) -> tuple[int, np.ndarray, list[tuple[int, int]], dict[int, int], list[tuple[int, int]]]:
+    bg = _get_bg(grid)
+    comps = _components_from_mask(grid != bg)
