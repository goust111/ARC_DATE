+    mask = np.zeros((h, w), dtype=bool)
+    for offset, (left_len, right_len) in enumerate(rows):
+        r = top + offset
+        c0 = mid_left - left_len + 1
+        c1 = mid_right + right_len - 1
+        mask[r, c0 : c1 + 1] = True
