+def _choose_fill_color(grid: np.ndarray, cavity: list[tuple[int, int]], seeds: list[tuple[int, int]]) -> int:
+    counts = Counter(int(grid[r, c]) for r, c in seeds)
+    max_count = max(counts.values())
