+def _mirror_seed_positions(side: int, pos: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = map(int, pos)
+    return [
+        (side - 1 - r, side - 1 - c),
+        (side - 1 - r, side + c),
+        (side + r, side - 1 - c),
+        (side + r, side + c),
+    ]
+
