        for c in range(W):
            if mask[r,c] and not vis[r,c]:
                st=[(r,c)]; vis[r,c]=1; touch=False
                while st:
                    x,y=st.pop()
                    if x==0 or y==0 or x==H-1 or y==W-1: touch=True
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
                if not touch: k+=1
    return k

def ends_and_ok(maskset):
    ends=[]
    for r,c in maskset:
        deg=sum((r+dr,c+dc) in maskset for dr,dc in DIRS)
        if deg==1: ends.append((r,c))
        elif deg==0 or deg>3: return None
    return ends

