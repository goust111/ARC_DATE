        for rr in range(2*q):
          for cc in range(2*q):
            if f[rr,cc]==2:
              for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                if 0<=nr<2*q and 0<=nc<2*q and lab[nr,nc]>=0: ts.add(int(lab[nr,nc]))
        groups[tuple(sorted(ts))].append((r,c))
    return groups

cands=[(r,c) for r in range(1,7) for c in range(1,7)]
