    g=np.zeros((q,q),int)
    rmax=max(r for r,c in coords); cmax=max(c for r,c in coords)
    g[0,1:cmax+1]=3; g[1:rmax+1,0]=3
    for r,c in coords:
        g[r,:c+1]=3; g[:r+1,c]=3
    return g

def mirror(g): return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)],[np.fliplr(g),g]])

def cavity_labels(full):
    H,W=full.shape; lab=np.full((H,W),-1,int); idx=0
    for r in range(H):
      for c in range(W):
        if full[r,c]==0 and lab[r,c]==-1:
          st=[(r,c)]; lab[r,c]=-2; pts=[]; touch=False
          while st:
            x,y=st.pop(); pts.append((x,y)); touch|=x in (0,H-1) or y in (0,W-1)
            for dx,dy in DIRS:
              nx,ny=x+dx,y+dy
              if 0<=nx<H and 0<=ny<W and full[nx,ny]==0 and lab[nx,ny]==-1: lab[nx,ny]=-2; st.append((nx,ny))
          label=-3 if touch else idx
          for x,y in pts: lab[x,y]=label
          if not touch: idx+=1
    return lab, idx

