+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr, dc in DIR8:
+        yield r + dr, c + dc
+
+
+def _mirror_quarter(quarter: np.ndarray) -> np.ndarray:
+    return np.block(
+        [
+            [np.flipud(np.fliplr(quarter)), np.flipud(quarter)],
+            [np.fliplr(quarter), quarter],
+        ]
+    )
