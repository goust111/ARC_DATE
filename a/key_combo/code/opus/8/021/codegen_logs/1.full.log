+        current = [start]
+        last = start
+        while len(current) < count:
+            candidates = [c for c in cols if last + 3 <= c <= last + 4]
+            if not candidates:
+                break
+            nxt = random.choice(candidates)
+            current.append(nxt)
+            last = nxt
+        if len(current) == count:
+            choices.append(current)
