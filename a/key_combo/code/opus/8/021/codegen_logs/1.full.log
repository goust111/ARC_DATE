+                "bbox": b,
+                "r0": r0,
+                "c0": c0,
+                "h": bbox_h(b),
+                "w": bbox_w(b),
+            }
+        )
+    blocks.sort(key=lambda item: (item["r0"], item["c0"]))
+    return blocks
