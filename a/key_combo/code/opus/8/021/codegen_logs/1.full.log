+        coords = comp["coords"]
+        if not bool((coords[:, 0] == 0).any()):
+            continue
+        rmax = int(coords[:, 0].max())
+        cols = sorted({int(c) for r, c in coords if int(r) == rmax})
+        for c in cols:
