+def _candidate_groupings(active_cols: list[int], k: int) -> list[list[tuple[int, ...]]]:
+    n = len(active_cols)
+    group_pool: list[tuple[int, ...]] = []
+    for i in range(n):
+        group_pool.append((i,))
+        if i + 1 < n and active_cols[i + 1] - active_cols[i] <= 4:
+            group_pool.append((i, i + 1))
