+    for group in groups:
+        group_set = set(group)
+        other_cols_sets.append([c for c in active_cols if c not in group_set])
+
+    def recurse(idx: int, placed: list[tuple[int, int]]) -> None:
+        if idx == len(groups):
+            all_positions.append(placed.copy())
+            return
+
+        cols = groups[idx]
+        others = other_cols_sets[idx]
+        min_col = min(cols)
+        max_col = max(cols)
