+TOP_ROW_MIN = 4
+TOP_ROW_MAX = 7
+LAYER_GAP_MIN = 3
+LAYER_GAP_MAX = 5
+MIN_BLOCK_GAP = 2
+MAX_GENERATION_ATTEMPTS = 400
