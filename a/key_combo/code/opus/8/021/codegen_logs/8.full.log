+
+def _seed_cells(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    h, _ = grid.shape
+    seeds: list[tuple[int, int, int]] = []
+    for r in range(h):
+        color = int(grid[r, 0])
+        if color in RAY_COLORS:
+            seeds.append((r, 0, color))
+    return sorted(seeds)
