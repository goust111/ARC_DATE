+                break
+            out[nr, nc] = color
+            ray_cells.add((nr, nc))
+            cr, cc = nr, nc
+
+    meta = {
+        "branch_count": branch_count,
+        "wall_hits": wall_hits,
+        "horizontal_hits": horizontal_hits,
+        "ray_cells": ray_cells,
+    }
+    return (out, meta) if return_meta else (out, {})
