+            lo = min(cols)
+            hi = max(cols)
+            openings = ((row, lo - 1), (row, hi + 1))
+            orientation = "h"
+        else:
+            col = next(iter(cols))
+            lo = min(rows)
+            hi = max(rows)
+            openings = ((lo - 1, col), (hi + 1, col))
+            orientation = "v"
+        info = {
