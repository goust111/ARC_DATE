+def _mirror_walls(grid: np.ndarray) -> np.ndarray:
+    g = np.array(grid, dtype=int, copy=True)
+    h, w = g.shape
+    mid = w // 2
+    mirrored = g.copy()
+    mirrored[:, mid:] = g[:, mid:]
+    for r in range(h):
