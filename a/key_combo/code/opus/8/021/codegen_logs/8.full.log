+                if not _in_bounds(out.shape, nr, nc) or (nr, nc) in region:
+                    continue
+                if (nr, nc) in ray_cells and int(out[nr, nc]) in boundary:
+                    boundary[int(out[nr, nc])].add((nr, nc))
