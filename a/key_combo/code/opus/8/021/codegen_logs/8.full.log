+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+WALL = 3
+RAY_COLORS = {BLUE, RED}
+DIR_RIGHT = (0, 1)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _mirror_walls(grid: np.ndarray) -> np.ndarray:
+    g = np.array(grid, dtype=int, copy=True)
+    h, w = g.shape
+    mid = w // 2
+    mirrored = g.copy()
+    mirrored[:, mid:] = g[:, mid:]
+    for r in range(h):
+        for c in range(mid):
+            if int(g[r, c]) == WALL:
+                mirrored[r, w - 1 - c] = WALL
+    return mirrored
+
+
+def _wall_lookup(structure: np.ndarray) -> dict[tuple[int, int], dict]:
+    lookup: dict[tuple[int, int], dict] = {}
+    for comp in _components(structure == WALL):
+        rows = {r for r, _ in comp}
+        cols = {c for _, c in comp}
+        if len(rows) == 1:
+            row = next(iter(rows))
+            lo = min(cols)
+            hi = max(cols)
+            openings = ((row, lo - 1), (row, hi + 1))
+            orientation = "h"
+        else:
+            col = next(iter(cols))
+            lo = min(rows)
+            hi = max(rows)
+            openings = ((lo - 1, col), (hi + 1, col))
+            orientation = "v"
+        info = {
+            "coords": tuple(comp),
+            "openings": openings,
+            "orientation": orientation,
+        }
+        for cell in comp:
+            lookup[cell] = info
+    return lookup
