+    row_sizes = {r1 - r0 for r0, r1 in row_segments}
+    col_sizes = {c1 - c0 for c0, c1 in col_segments}
+    assert len(row_sizes) == 1 and min(row_sizes) > 0
+    assert len(col_sizes) == 1 and min(col_sizes) > 0
+    return row_segments, col_segments
