+    for area, color, noise_count, mode in zip(AREA_VALUES, colors, noise_pattern, modes):
+        spec = _make_tile_spec(tile_h, tile_w, area, color, noise_count, mode)
+        if spec is None:
+            return None
+        specs.append(spec)
