+    return None
+
+
+def _make_tile_spec(
+    tile_h: int,
+    tile_w: int,
+    area: int,
+    color: int,
+    noise_count: int,
+    mode: str,
+) -> dict[str, object] | None:
+    clean_tile, rect = _make_clean_tile(tile_h, tile_w, area, color)
+    noisy_tile = _try_add_noise(clean_tile, rect, noise_count, mode)
+    if noisy_tile is None:
