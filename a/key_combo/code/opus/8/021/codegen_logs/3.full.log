+
+
+def _choose_noise_colors(base_color: int, count: int, mode: str) -> list[int]:
+    foreign = [color for color in RECT_PALETTE if color != base_color]
+    if mode == "foreign":
+        return [random.choice(foreign) for _ in range(count)]
+    colors = [base_color]
+    while len(colors) < count:
