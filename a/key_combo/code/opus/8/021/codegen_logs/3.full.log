+    return True
+
+
+def _generate_one() -> np.ndarray | None:
+    tile_h, tile_w = random.choice(TILE_SHAPES)
+    colors = list(RECT_PALETTE) + [random.choice(RECT_PALETTE)]
+    random.shuffle(colors)
