+    if noisy_tile is None:
+        return None
+    return {
+        "area": int(area),
+        "color": int(color),
+        "mode": mode,
+        "noise_count": int(noise_count),
+        "clean": clean_tile,
+        "tile": noisy_tile,
+    }
+
+
+def _assemble_from_shape(tiles: list[np.ndarray], tile_h: int, tile_w: int) -> np.ndarray:
+    row_segments = [(0, tile_h), (tile_h + 1, 2 * tile_h + 1), (2 * tile_h + 2, 3 * tile_h + 2)]
