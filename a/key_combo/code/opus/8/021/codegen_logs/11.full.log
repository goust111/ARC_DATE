    return None


def _bbox_clear(grid: np.ndarray, r0: int, c0: int, sh: int, sw: int, pad: int = 1) -> bool:
    h, w = grid.shape
    if r0 < 0 or c0 < 0 or r0 + sh > h or c0 + sw > w:
        return False
    rr0 = max(0, r0 - pad)
    cc0 = max(0, c0 - pad)
    rr1 = min(h, r0 + sh + pad)
    cc1 = min(w, c0 + sw + pad)
    return not np.any(grid[rr0:rr1, cc0:cc1] != BG)


