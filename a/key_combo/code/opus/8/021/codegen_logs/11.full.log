+            if c0 == fc or abs(c0 - fc) < 3:
+                continue
+            if _bbox_clear(grid, fr, c0, sh, sw, pad=1):
+                candidates.append((fr, c0))
+    else:
+        for r0 in range(0, grid.shape[0] - sh + 1):
+            if r0 == fr or abs(r0 - fr) < 3:
