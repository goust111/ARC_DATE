+
+
+def _fill_closed_seeded_regions(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    h, w = out.shape
+    bg = int(get_bg(out))
+    for comp in components_mask(out == bg, connectivity=4):
+        if _touches_border(comp, h, w):
+            continue
+        seed_colors = set()
+        for r, c in comp:
