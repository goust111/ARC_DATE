+
+    return {
+        "ring_box": (r0, c0, r1, c1),
+        "ring_cells": ring_cells,
+        "gap_cells": gap_cells,
+        "protrusion": protrusion,
+        "seed": seed,
+        "seed_color": seed_color,
+        "body_color": body_color,
