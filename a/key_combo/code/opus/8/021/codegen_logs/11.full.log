+    )
+
+
+def _find_anchors(grid: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:
+    h, w = grid.shape
+    anchors: dict[int, tuple[int, int]] = {}
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg:
+                continue
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
