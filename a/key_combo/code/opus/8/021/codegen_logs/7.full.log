def _rectangular_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    box = bbox(mask)
    if box is None:
        return None

    r0, c0, r1, c1 = box
    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
        return None

    expected = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    expected[0, :] = True
    expected[-1, :] = True
