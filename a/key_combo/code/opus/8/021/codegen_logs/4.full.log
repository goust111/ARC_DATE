+            banned = sibling_cols - {branch_col}
+            geom_candidates = _geometry_candidates(
+                branch_col,
+                spec["distance"],
+                spec["lane_left"],
+                spec["lane_right"],
+                banned_cols=banned,
+            )
+            if not geom_candidates:
+                continue
+            random.shuffle(geom_candidates)
