+                    if any(int(g[row, c]) != BG for c in range(shelf_left, shelf_right + 1)):
+                        continue
+                    _place_shelf(g, row, shelf_left, shelf_right)
+                    used_rows.add(int(row))
+                    extras_added += 1
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
