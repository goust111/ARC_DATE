+        if c0 <= int(col) <= c1:
+            return int(c0), int(c1)
+    return None
+
+
+def _collect_markers(g: np.ndarray, baseline_row: int) -> list[tuple[int, int]]:
+    markers: list[tuple[int, int]] = []
+    for c, color in enumerate(map(int, g[baseline_row])):
+        if color in DISTANCE_BY_COLOR:
