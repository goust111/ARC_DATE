+
+def _paint_marker(
+    out: np.ndarray,
+    g: np.ndarray,
+    shelves: dict[int, list[tuple[int, int]]],
+    start_r: int,
+    start_c: int,
+    color: int,
+) -> None:
+    distance = DISTANCE_BY_COLOR[int(color)]
+    stack: list[tuple[int, int]] = [(int(start_r), int(start_c))]
+    seen_starts: set[tuple[int, int]] = set()
+    origin = (int(start_r), int(start_c))
