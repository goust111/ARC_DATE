+            return False
+
+        traces: list[dict] = []
+        for col, color in markers:
+            trace = _trace_marker(g, shelves, baseline_row, col, color)
+            if len(trace["hit_rows"]) < 1:
+                return False
+            if len(trace["branch_starts"]) < 2:
