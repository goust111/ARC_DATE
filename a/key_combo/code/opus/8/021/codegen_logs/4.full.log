+
+
+def _place_shelf(g: np.ndarray, row: int, left: int, right: int) -> None:
+    g[int(row), int(left) : int(right) + 1] = SHELF
+
+
+def _build_case() -> np.ndarray | None:
+    colors = _sample_marker_colors()
+    random.shuffle(colors)
