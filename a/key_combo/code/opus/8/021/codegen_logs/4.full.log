+        lane_right = lane[1] - 1
+        if lane_right - lane_left < 6:
+            return None
+
+        geom = _geometry_candidates(center, DISTANCE_BY_COLOR[color], lane_left, lane_right)
+        if not geom:
+            return None
+        shelf_left, shelf_right, left_overflow, right_overflow = random.choice(geom)
+        _place_shelf(g, first_row, shelf_left, shelf_right)
+        used_rows.add(int(first_row))
