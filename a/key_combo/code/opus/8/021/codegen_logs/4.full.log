+                    stack.append((int(cur_r), int(left_shelf - 1)))
+                if right_shelf + 1 < out.shape[1] and c + distance >= right_shelf + 1:
+                    stack.append((int(cur_r), int(right_shelf + 1)))
+                break
+            cur_r = int(next_r)
+            paint(int(cur_r), int(c))
+
