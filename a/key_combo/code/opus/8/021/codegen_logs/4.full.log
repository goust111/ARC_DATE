+                (
+                    int(shelf_left),
+                    int(shelf_right),
+                    int(left_overflow),
+                    int(right_overflow),
+                )
+            )
+    return candidates
+
+
+def _extra_shelf_row_candidates(
+    start_row: int,
+    distance: int,
+    used_rows: set[int],
+) -> list[int]:
+    rows: list[int] = []
+    for steps in range(1, distance):
+        row = int(start_row - steps - 1)
+        if row <= 0 or row in used_rows:
+            continue
+        rows.append(row)
