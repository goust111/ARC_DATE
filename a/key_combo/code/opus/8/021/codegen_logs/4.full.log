+
+def _validate_generated_case(g: np.ndarray) -> bool:
+    try:
+        baseline_row = _find_baseline_row(g)
+        markers = _collect_markers(g, baseline_row)
+        shelves = _scan_shelves(g)
+        shelf_count = sum(len(v) for v in shelves.values())
