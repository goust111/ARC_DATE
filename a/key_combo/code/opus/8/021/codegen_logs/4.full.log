+    h, w = g.shape
+    for r in range(h):
+        segments: list[tuple[int, int]] = []
+        c = 0
+        while c < w:
+            if int(g[r, c]) != SHELF:
+                c += 1
+                continue
+            c0 = c
+            while c + 1 < w and int(g[r, c + 1]) == SHELF:
+                c += 1
