+        lane_left = lane[0] + 1
+        lane_right = lane[1] - 1
+        if lane_right - lane_left < 6:
+            return None
+
+        geom = _geometry_candidates(center, DISTANCE_BY_COLOR[color], lane_left, lane_right)
+        if not geom:
+            return None
