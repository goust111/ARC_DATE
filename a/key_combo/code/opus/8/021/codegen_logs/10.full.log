+def _regions_between(lines: list[int], limit: int) -> list[tuple[int, int]]:
+    bounds = [-1, *lines, limit]
+    regions = [(a + 1, b - 1) for a, b in zip(bounds, bounds[1:])]
+    assert all(r0 <= r1 for r0, r1 in regions)
+    return regions
