+        target_box = _nearest_interior_box(row_regions, col_regions, real_row_idx, real_col_idx)
+        endpoint = _fallback_endpoint(target_box, dr, dc)
+        path, order = _choose_fallback_path(g, start, endpoint)
+        info.append(
+            {
+                "color": color,
+                "start": start,
+                "path": path,
