+def _gen_attempt(desired_mode: str, rng: np.random.Generator) -> np.ndarray | None:
+    row_count = int(rng.choice(GRID_COUNT_OPTIONS))
+    col_count = int(rng.choice(GRID_COUNT_OPTIONS))
