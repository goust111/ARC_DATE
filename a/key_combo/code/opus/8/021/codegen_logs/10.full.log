+    height = sum(row_widths) + len(row_widths) - 1
+    width = sum(col_widths) + len(col_widths) - 1
+    grid = np.zeros((height, width), dtype=int)
+    grid[_line_positions(row_widths), :] = Color.GREEN
+    grid[:, _line_positions(col_widths)] = Color.GREEN
