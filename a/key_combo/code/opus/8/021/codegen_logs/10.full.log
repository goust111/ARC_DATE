+
+    last_row = len(row_regions) - 1
+    last_col = len(col_regions) - 1
+    for row_i in range(len(row_regions)):
+        for col_i in range(len(col_regions)):
+            box = _cell_box(row_regions, col_regions, row_i, col_i)
+            fill = None
