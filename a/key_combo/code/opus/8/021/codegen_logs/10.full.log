+
+def _point_in_box(point: Coord, box: Box) -> bool:
+    r, c = point
+    r0, c0, r1, c1 = box
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _bresenham_line(start: Coord, end: Coord) -> list[Coord]:
+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    points: list[Coord] = []
+
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
