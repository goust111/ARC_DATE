+        points.append((r0, c0))
+        if r0 == r1 and c0 == c1:
+            break
+        err2 = 2 * err
+        if err2 > -dc:
+            err -= dc
+            r0 += sr
+        if err2 < dr:
+            err += dr
+            c0 += sc
+    return points
