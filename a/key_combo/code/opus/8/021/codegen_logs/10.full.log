+def _cell_box(row_regions: list[tuple[int, int]], col_regions: list[tuple[int, int]], row_i: int, col_i: int) -> Box:
+    r0, r1 = row_regions[row_i]
+    c0, c1 = col_regions[col_i]
+    return r0, c0, r1, c1
