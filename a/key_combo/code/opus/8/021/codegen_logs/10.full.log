+            fill = None
+            if row_i == 0 and col_i == 0:
+                fill = Color.RED
+            elif row_i == 0 and col_i == last_col:
+                fill = Color.YELLOW
+            elif row_i == last_row and col_i == 0:
+                fill = Color.BLUE
+            elif row_i == last_row and col_i == last_col:
+                fill = Color.PINK
+            elif 0 < row_i < last_row and 0 < col_i < last_col:
+                fill = Color.ORANGE
+            if fill is not None:
