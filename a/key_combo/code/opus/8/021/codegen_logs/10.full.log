+    r0, r1 = row_regions[row_i]
+    c0, c1 = col_regions[col_i]
+    return r0, c0, r1, c1
+
+
+def _interior_boxes(row_regions: list[tuple[int, int]], col_regions: list[tuple[int, int]]) -> list[Box]:
