+
+def _bresenham_line(start: Coord, end: Coord) -> list[Coord]:
+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    points: list[Coord] = []
+
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dr - dc
+
+    while True:
+        points.append((r0, c0))
+        if r0 == r1 and c0 == c1:
+            break
+        err2 = 2 * err
+        if err2 > -dc:
+            err -= dc
+            r0 += sr
+        if err2 < dr:
+            err += dr
+            c0 += sc
+    return points
+
+
+def _segment_points(start: Coord, end: Coord) -> list[Coord]:
+    r0, c0 = start
+    r1, c1 = end
+    assert r0 == r1 or c0 == c1
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        return [(r0, c) for c in range(c0, c1 + step, step)]
+    step = 1 if r1 >= r0 else -1
+    return [(r, c0) for r in range(r0, r1 + step, step)]
+
+
+def _join_segments(first: list[Coord], second: list[Coord]) -> list[Coord]:
+    if not first:
+        return second[:]
+    if not second:
+        return first[:]
+    if first[-1] == second[0]:
+        return first + second[1:]
+    return first + second
+
+
+def _first_interior_hit(path: list[Coord], interior_boxes: list[Box]) -> tuple[int, Coord, Box] | None:
