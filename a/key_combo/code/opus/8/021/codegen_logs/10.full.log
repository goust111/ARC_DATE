+    ((-1, 0), Color.BLUE, (-1, 1)),
+    ((-1, -1), Color.PINK, (-1, -1)),
+)
+
+CELL_SIZE_OPTIONS = (2, 3, 4, 5)
+DIRECT_CELL_SIZE_OPTIONS = (2, 3, 4)
