+    last_col = len(col_regions) - 1
+    target_row = 1 if corner_row_idx == 0 else last_row - 1
+    target_col = 1 if corner_col_idx == 0 else last_col - 1
+    return _cell_box(row_regions, col_regions, target_row, target_col)
