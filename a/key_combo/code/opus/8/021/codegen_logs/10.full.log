+def _bresenham_line(start: Coord, end: Coord) -> list[Coord]:
+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    points: list[Coord] = []
+
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dr - dc
+
+    while True:
+        points.append((r0, c0))
+        if r0 == r1 and c0 == c1:
+            break
+        err2 = 2 * err
+        if err2 > -dc:
+            err -= dc
+            r0 += sr
+        if err2 < dr:
+            err += dr
+            c0 += sc
+    return points
