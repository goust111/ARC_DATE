+
+def _branch_counts(grid: np.ndarray) -> tuple[int, int]:
+    modes = [ray["mode"] for ray in _ray_metadata(grid)]
+    direct = sum(mode == "direct" for mode in modes)
+    fallback = sum(mode.startswith("fallback") for mode in modes)
