+    if desired_mode == "mixed" and not (has_direct and has_fallback):
+        return None
+    if desired_mode == "fallback_heavy" and not (fallback_count >= 2 and direct_count >= 1):
+        return None
+
+    out = main(grid)
+    if not _validate_semantics(grid, out):
+        return None
+    return grid
