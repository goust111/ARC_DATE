+from arc_utils import Color, get_bg  # noqa: E402
+
+
+Coord = tuple[int, int]
+Box = tuple[int, int, int, int]
+
+
+CORNER_SPECS = (
+    ((0, 0), Color.RED, (1, 1)),
+    ((0, -1), Color.YELLOW, (1, -1)),
+    ((-1, 0), Color.BLUE, (-1, 1)),
+    ((-1, -1), Color.PINK, (-1, -1)),
+)
+
+CELL_SIZE_OPTIONS = (2, 3, 4, 5)
+DIRECT_CELL_SIZE_OPTIONS = (2, 3, 4)
+GRID_COUNT_OPTIONS = (4, 5)
+MAX_GENERATION_ATTEMPTS = 500
