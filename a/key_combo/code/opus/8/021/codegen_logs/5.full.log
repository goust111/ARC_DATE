+SPRITE_HOLE_COUNTS = (0, 1, 2)
+FRAME_CHAMBERS = (1, 2, 3)
+FRAME_SIDE_CHOICES = (11, 12, 13)
+CANVAS_SIDE_RANGE = (26, 30)
+PLACEMENT_PADDING = 1
