+        return False
+    for dr, dc in np.argwhere(patch != BG):
+        rr = int(r0 + dr)
+        cc = int(c0 + dc)
+        r1 = max(0, rr - padding)
+        r2 = min(H, rr + padding + 1)
+        c1 = max(0, cc - padding)
+        c2 = min(W, cc + padding + 1)
