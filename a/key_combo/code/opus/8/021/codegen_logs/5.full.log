+    for pos in _frame_line_positions(side, chambers, SPRITE_SIDE, orientation):
+        if orientation == "vertical":
+            coords = [(r, int(pos)) for r in range(1, side - 1)]
+        else:
+            coords = [(int(pos), c) for c in range(1, side - 1)]
+        lines.append(coords)
+        for r, c in coords:
+            patch[r, c] = 1
