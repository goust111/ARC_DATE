+    frame_by_count = {frame["count"] - 1: frame for frame in frames}
+    sprite_by_count = {sprite["count"]: sprite for sprite in sprites}
+    assert set(frame_by_count.keys()) == {0, 1, 2}
+    assert set(sprite_by_count.keys()) == {0, 1, 2}
