+    frames_raw, sprites_raw, _bg = _classify_objects(plan["input"])
+    if len(frames_raw) != 3 or len(sprites_raw) != 3:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        plan = _build_plan()
+        if plan is None:
+            continue
+        if _validate_plan(plan):
