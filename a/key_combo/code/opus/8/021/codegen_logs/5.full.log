from __future__ import annotations

from collections import Counter
import random

import numpy as np


BG = 8
FRAME_COLORS = (2, 3, 7)
SPRITE_COLORS = (1, 4, 6)
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

GEN_ATTEMPTS = 400
SPRITE_SIDE = 5
SPRITE_HOLE_COUNTS = (0, 1, 2)
FRAME_CHAMBERS = (1, 2, 3)
