+def _frame_full_patch(side: int, chambers: int, orientation: str) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    patch = np.full((side, side), BG, dtype=int)
+    patch[0, :] = 1
+    patch[side - 1, :] = 1
+    patch[:, 0] = 1
+    patch[:, side - 1] = 1
