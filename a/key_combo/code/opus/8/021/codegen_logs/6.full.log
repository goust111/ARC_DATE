+    out = main(g)
+    assert texture.shape == (2 * g.shape[0], 2 * g.shape[1])
+    assert out.shape == (4 * texture.shape[0] - 3, texture.shape[1])
+    assert texture[0].any() and texture[-1].any()
+    assert np.array_equal(out[: texture.shape[0]], texture)
