+            rr += 1
+            cc += 1
+    return texture
+
+
+def _stack_texture(texture: np.ndarray) -> np.ndarray:
+    unit = np.asarray(texture, dtype=int)
+    unit_height, unit_width = map(int, unit.shape)
+    step = unit_height - 1
+    out = np.zeros((4 * unit_height - 3, unit_width), dtype=int)
