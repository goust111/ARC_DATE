+    for cell in sorted(cells):
+        groups.setdefault(cell[0] - cell[1], []).append(cell)
+    return groups
+
+
+def _enumerate_shapes() -> dict[int, dict[str, list[tuple[tuple[int, int], ...]]]]:
+    shape_bank: dict[int, dict[str, list[tuple[tuple[int, int], ...]]]] = {}
