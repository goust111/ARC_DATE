+    remaining = set(cells)
+    stack = [next(iter(remaining))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in remaining and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(remaining)
