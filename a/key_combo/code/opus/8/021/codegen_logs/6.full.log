+        rr, cc = int(r), int(c)
+        while rr < texture.shape[0] and cc < texture.shape[1]:
+            current = int(texture[rr, cc])
+            if current == BACKGROUND or current == color:
+                texture[rr, cc] = color
+            rr += 1
+            cc += 1
+    return texture
