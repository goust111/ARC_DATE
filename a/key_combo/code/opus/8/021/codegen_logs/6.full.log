+
+
+def _build_input(width: int, kind: str) -> np.ndarray:
+    cells = random.choice(SHAPE_BANK[width][kind])
+    color_map = _assign_colors(cells, want_conflict=(kind == "conflict"))
+    grid = np.zeros((INPUT_HEIGHT, width), dtype=int)
+    for r, c in cells:
