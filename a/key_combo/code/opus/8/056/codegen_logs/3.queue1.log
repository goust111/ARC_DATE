+    _stamp_mask(expected, inside_mask, sprite_r, sprite_c, sprite_color)
+    cavity = expected[cup_r0 + 1 : cup_r0 + 1 + cavity_h, cup_c0 + 1 : cup_c0 + 1 + cavity_w]
+    cavity[cavity == BG] = YELLOW
+
+    if not np.array_equal(main(inp), expected):
