+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    comps = _find_components(g, bg)
+    assert len(comps) == 2, "expected exactly one cup and one sprite"
+
+    cup_candidates = []
+    for comp in comps:
+        info = _analyze_cup(comp)
+        if info is not None:
+            cup_candidates.append((comp, info))
