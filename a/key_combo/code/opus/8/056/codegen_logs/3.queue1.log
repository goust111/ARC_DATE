+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+YELLOW = 4
+BG = 0
+DIRS = ("top", "bottom", "left", "right")
+PALETTE = (1, 2, 3, 5, 6, 7, 8, 9)
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _analyze_cup(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = _component_mask(comp)
+    h, w = mask.shape
+    if h < 5 or w < 5:
+        return None
+
+    def expected(direction: str) -> np.ndarray:
+        out = np.zeros((h, w), dtype=bool)
+        out[:, 0] = True
+        out[:, -1] = True
+        out[0, :] = True
+        out[-1, :] = True
+        if direction == "top":
+            out[0, 1:-1] = False
+        elif direction == "bottom":
+            out[-1, 1:-1] = False
+        elif direction == "left":
+            out[1:-1, 0] = False
+        else:
+            out[1:-1, -1] = False
+        return out
+
+    matches = [direction for direction in DIRS if np.array_equal(mask, expected(direction))]
+    if len(matches) != 1:
+        return None
+    direction = matches[0]
+    return {
+        "direction": direction,
+        "bbox": (r0, c0, r1, c1),
+        "cavity": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+        "color": int(comp["color"]),
+    }
+
+
+def _reflect_coords(coords: list[tuple[int, int]], cup: dict) -> list[tuple[int, int]]:
+    direction = cup["direction"]
+    r0, c0, r1, c1 = cup["bbox"]
+    reflected: list[tuple[int, int]] = []
+    for r, c in coords:
+        if direction == "top":
+            reflected.append((2 * r0 + 1 - r, c))
+        elif direction == "bottom":
+            reflected.append((2 * r1 - 1 - r, c))
+        elif direction == "left":
+            reflected.append((r, 2 * c0 + 1 - c))
+        else:
+            reflected.append((r, 2 * c1 - 1 - c))
+    return reflected
+
+
+def main(grid: np.ndarray) -> np.ndarray:
