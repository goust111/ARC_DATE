+    seen = {tuple(map(int, coords[0]))}
+    q = deque([tuple(map(int, coords[0]))])
+    cells = {tuple(map(int, cell)) for cell in coords}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
