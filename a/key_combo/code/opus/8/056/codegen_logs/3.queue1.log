+    assert len(idxs) == 1
+    cup = cup_info[idxs[0]]
+    assert cup is not None
+    sprite = comps[1 - idxs[0]]
+    cav_r0, cav_c0, cav_r1, cav_c1 = cup["cavity"]
+    cavity = out[cav_r0 : cav_r1 + 1, cav_c0 : cav_c1 + 1]
