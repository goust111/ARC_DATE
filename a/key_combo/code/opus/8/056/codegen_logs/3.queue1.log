+        out[-1, :] = True
+        if direction == "top":
+            out[0, 1:-1] = False
+        elif direction == "bottom":
+            out[-1, 1:-1] = False
+        elif direction == "left":
+            out[1:-1, 0] = False
+        else:
+            out[1:-1, -1] = False
+        return out
