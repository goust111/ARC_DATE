+
+
+def _make_sprite_shape(
+    corner: str,
+    *,
+    require_corner_preserve: bool,
+    require_overlap_cell: bool,
+    marker_outside_crop: bool,
+) -> tuple[set[tuple[int, int]], tuple[int, int]] | None:
+    for _ in range(200):
+        height = random.randint(2, 5)
+        width = random.randint(3, 6)
+        require_cells = {
