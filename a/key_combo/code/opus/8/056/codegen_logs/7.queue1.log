+
+
+def _place_bboxes(
+    grid_shape: tuple[int, int],
+    sprite_shapes: list[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    h, w = grid_shape
+    occupied = np.zeros((h, w), dtype=bool)
+    placements: list[tuple[int, int]] = []
+    for bh, bw in sprite_shapes:
+        options = []
+        for r0 in range(1, h - bh):
