+def _stamp_origin(shape: tuple[int, int], patch_shape: tuple[int, int], corner: str) -> tuple[int, int]:
+    h, w = shape
+    ph, pw = patch_shape
+    return {
+        "tl": (0, 0),
+        "tr": (0, w - pw),
+        "bl": (h - ph, 0),
+        "br": (h - ph, w - pw),
+    }[corner]
