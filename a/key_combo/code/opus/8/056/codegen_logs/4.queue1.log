+def _toggle_pattern(pair_count: int) -> list[int]:
+    toggles = [1] * pair_count
+    indices = list(range(pair_count))
+    random.shuffle(indices)
+    if pair_count == 3 or random.random() < 0.6:
+        toggles[indices[0]] = 2
+    return toggles
+
+
+def _gen_attempt() -> np.ndarray | None:
