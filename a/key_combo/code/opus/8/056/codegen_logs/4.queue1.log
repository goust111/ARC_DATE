+) -> dict | None:
+    for _ in range(120):
+        kind = _sample_pair_kind(toggle_count, band[1] - band[0] + 1)
+        endpoints = _sample_endpoints(kind, band, W)
+        if endpoints is None:
+            continue
+        a, b = endpoints
