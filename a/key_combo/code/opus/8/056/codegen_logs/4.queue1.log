+    for pair in _pair_objects(g):
+        a, b = pair["centers"]
+        color = LINE_BLUE
+        for cell in _segment_cells(a, b):
+            if cell in doors:
+                color = LINE_RED if color == LINE_BLUE else LINE_BLUE
+            r, c = cell
+            if int(g[r, c]) == BG and int(out[r, c]) == BG:
+                out[r, c] = color
+    return out
