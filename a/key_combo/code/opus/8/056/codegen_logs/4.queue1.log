+
+
+def _door_orientation(a: Coord, b: Coord) -> str:
+    dr = int(b[0]) - int(a[0])
+    dc = int(b[1]) - int(a[1])
+    if dr == 0:
+        return "vertical"
+    if dc == 0:
+        return "horizontal"
+    return "vertical" if abs(dc) >= abs(dr) else "horizontal"
+
+
+def _segment_wall_cells(
+    orientation: str,
+    door: Coord,
+    band: tuple[int, int],
+    W: int,
+    extra_gap: int | None,
