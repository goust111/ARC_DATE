+BG = 0
+LINE_BLUE = 1
+LINE_RED = 2
+OBJ = 3
+WALL = 5
+
+MAX_RETRIES = 300
+GRID_W_RANGE = (18, 25)
+PAIR_COUNT_CHOICES = (2, 3)
