+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        return [(r0, c) for c in range(c0, c1 + step, step)]
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        return [(r, c0) for r in range(r0, r1 + step, step)]
+
+    points: list[Coord] = []
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
+    rr, cc = r0, c0
+    while True:
+        points.append((rr, cc))
+        if rr == r1 and cc == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dr:
+            err -= dr
+            cc += sc
+        if e2 < dc:
+            err += dc
+            rr += sr
