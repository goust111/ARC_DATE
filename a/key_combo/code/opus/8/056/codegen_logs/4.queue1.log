 108: def _gen_extensions(anchor: int, limit: int, count: int, sign: int) -> list[list[int]]:
 109:     if count == 0:
 110:         return [[]]
 111:     out: list[list[int]] = []
 112:     for step in range(GATE_SPACING_MIN, GATE_SPACING_MAX + 1):
 113:         pos = anchor + sign * step
 114:         if not (0 <= pos <= limit):
 115:             continue
 116:         for tail in _gen_extensions(pos, limit, count - 1, sign):
 117:             out.append(([pos] + tail) if sign > 0 else (tail + [pos]))
 118:     return out
