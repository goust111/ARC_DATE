+    if kind == "v" and toggle_count == 2 and len(candidates) < 2:
+        return None
+    if len(candidates) < toggle_count:
+        return None
+
+    picks = []
+    if toggle_count == 1:
+        picks.append(random.choice(candidates))
+    else:
+        for door in candidates:
