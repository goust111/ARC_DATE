+
+
+SHAPE_LIBRARY: list[np.ndarray] = [
+    _shape(["###"]),
+    _shape(["#", "#", "#"]),
+    _shape([".#.", "###", ".#."]),
+    _shape(["###", ".#.", "..."]),
+    _shape(["...", ".#.", "###"]),
+    _shape([".#.", "##.", ".#."]),
+    _shape([".#.", ".##", ".#."]),
+    _shape(["###", ".#.", ".#."]),
