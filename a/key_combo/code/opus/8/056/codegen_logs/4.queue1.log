+    return None
+
+
+def _render_input(specs: list[dict], H: int, W: int) -> np.ndarray:
+    grid = np.zeros((H, W), dtype=int)
+    for spec in specs:
+        _paint_shape(grid, spec["shape"], spec["centers"][0], OBJ)
+        _paint_shape(grid, spec["shape"], spec["centers"][1], OBJ)
