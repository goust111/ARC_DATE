+
+def _shape(mask_rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "#" for ch in row] for row in mask_rows], dtype=bool)
+
+
+SHAPE_LIBRARY: list[np.ndarray] = [
+    _shape(["###"]),
+    _shape(["#", "#", "#"]),
+    _shape([".#.", "###", ".#."]),
+    _shape(["###", ".#.", "..."]),
+    _shape(["...", ".#.", "###"]),
+    _shape([".#.", "##.", ".#."]),
+    _shape([".#.", ".##", ".#."]),
+    _shape(["###", ".#.", ".#."]),
