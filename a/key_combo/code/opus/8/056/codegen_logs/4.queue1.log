+            prev = picks[-1]
+            if abs((door[1] if orientation == "vertical" else door[0]) - (prev[1] if orientation == "vertical" else prev[0])) >= 1:
+                picks.append(door)
+            if len(picks) == toggle_count:
+                break
+        if len(picks) != toggle_count:
+            return None
