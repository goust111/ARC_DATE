 152: def _make_mask(h: int, w: int, area: int) -> np.ndarray:
 153:     """Grow an 8-connected mask from a line seed to the target area."""
 154:     mask = _line_mask(h, w)
 155:     while int(mask.sum()) < area:
 156:         frontier = set()
 157:         for r, c in np.argwhere(mask):
 158:             for dr, dc in _NEIGHBORS8:
 159:                 nr, nc = int(r) + dr, int(c) + dc
 160:                 if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
 161:                     frontier.add((nr, nc))
 162:         pick = list(frontier)
 163:         nr, nc = pick[int(_RNG.integers(0, len(pick)))]
 164:         mask[nr, nc] = True
 165:     return mask
