+BG = 0
+LINE_BLUE = 1
+LINE_RED = 2
+OBJ = 3
+WALL = 5
+
+MAX_RETRIES = 300
+GRID_W_RANGE = (18, 25)
+PAIR_COUNT_CHOICES = (2, 3)
+BAND_HEIGHT_CHOICES = (7, 8)
+BAND_GAP = 2
+OUTER_MARGIN = 1
