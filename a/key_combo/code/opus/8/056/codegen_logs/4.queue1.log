+    return random.choice(kinds)
+
+
+def _sample_endpoints(kind: str, band: tuple[int, int], W: int) -> tuple[Coord, Coord] | None:
+    r0, r1 = band
+    top = r0 + 1
+    bottom = r1 - 1
+    if kind == "h":
