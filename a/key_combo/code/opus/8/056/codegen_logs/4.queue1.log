 121: def _gen_between_positions(gap_cells: list[int], count: int) -> list[tuple[int, ...]]:
 122:     """Enumerate in-gap gate positions with valid spacing, preserving nested-loop order."""
 123:     out: list[tuple[int, ...]] = []
 124:     if count == 2:
 125:         for a in gap_cells:
 126:             for b in gap_cells:
 127:                 if GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX:
 128:                     out.append((a, b))
 129:     else:
 130:         for a in gap_cells:
 131:             for b in gap_cells:
 132:                 for c in gap_cells:
 133:                     if (
 134:                         GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX
 135:                         and GATE_SPACING_MIN <= c - b <= GATE_SPACING_MAX
 136:                     ):
 137:                         out.append((a, b, c))
 138:     return out
