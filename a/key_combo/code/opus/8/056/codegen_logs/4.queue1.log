+def _shape_cells(mask: np.ndarray, center: Coord) -> set[Coord]:
+    h, w = mask.shape
+    top = int(center[0]) - h // 2
+    left = int(center[1]) - w // 2
+    return {
+        (top + r, left + c)
+        for r, c in np.argwhere(mask)
+    }
