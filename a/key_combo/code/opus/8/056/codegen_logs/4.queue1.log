 184: def _gen_dilate8(mask):
 185:     out = mask.copy()
 186:     out[1:, :] |= mask[:-1, :]
 187:     out[:-1, :] |= mask[1:, :]
 188:     out[:, 1:] |= mask[:, :-1]
 189:     out[:, :-1] |= mask[:, 1:]
 190:     out[1:, 1:] |= mask[:-1, :-1]
 191:     out[1:, :-1] |= mask[:-1, 1:]
 192:     out[:-1, 1:] |= mask[1:, :-1]
 193:     out[:-1, :-1] |= mask[1:, 1:]
 194:     return out
