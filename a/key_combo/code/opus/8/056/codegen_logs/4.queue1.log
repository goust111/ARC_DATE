+from __future__ import annotations
+
+from collections import defaultdict
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_ARC_UTILS_DIR))
+
+from arc_utils import bbox_anchor, bbox_coords, find_components  # noqa: E402
+
+
+BG = 0
+LINE_BLUE = 1
+LINE_RED = 2
+OBJ = 3
+WALL = 5
+
+MAX_RETRIES = 300
+GRID_W_RANGE = (18, 25)
+PAIR_COUNT_CHOICES = (2, 3)
+BAND_HEIGHT_CHOICES = (7, 8)
+BAND_GAP = 2
+OUTER_MARGIN = 1
+
+
+def _shape(mask_rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "#" for ch in row] for row in mask_rows], dtype=bool)
+
+
+SHAPE_LIBRARY: list[np.ndarray] = [
+    _shape(["###"]),
+    _shape(["#", "#", "#"]),
+    _shape([".#.", "###", ".#."]),
+    _shape(["###", ".#.", "..."]),
+    _shape(["...", ".#.", "###"]),
+    _shape([".#.", "##.", ".#."]),
+    _shape([".#.", ".##", ".#."]),
+    _shape(["###", ".#.", ".#."]),
+]
+
+
+Coord = tuple[int, int]
+
+
+def _normalized_shape(coords: np.ndarray) -> tuple[Coord, ...]:
+    r0, c0, _r1, _c1 = bbox_coords(coords)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+
+
+def _segment_cells(a: Coord, b: Coord) -> list[Coord]:
+    r0, c0 = map(int, a)
+    r1, c1 = map(int, b)
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        return [(r0, c) for c in range(c0, c1 + step, step)]
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        return [(r, c0) for r in range(r0, r1 + step, step)]
+
+    points: list[Coord] = []
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
+    rr, cc = r0, c0
+    while True:
+        points.append((rr, cc))
+        if rr == r1 and cc == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dr:
+            err -= dr
+            cc += sc
+        if e2 < dc:
+            err += dc
+            rr += sr
+    return points
+
+
+def _door_cells(grid: np.ndarray) -> set[Coord]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    out: set[Coord] = set()
+    for r in range(H):
+        for c in range(W):
+            if int(g[r, c]) != BG:
+                continue
+            horiz = 0 < c < W - 1 and int(g[r, c - 1]) == WALL and int(g[r, c + 1]) == WALL
+            vert = 0 < r < H - 1 and int(g[r - 1, c]) == WALL and int(g[r + 1, c]) == WALL
+            if horiz or vert:
