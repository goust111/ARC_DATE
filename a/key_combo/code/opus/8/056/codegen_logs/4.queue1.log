+) -> tuple[str, list[Coord]] | None:
+    orientation = _door_orientation(path[0], path[-1])
+    start = 2 if len(path) >= 6 else 1
+    end = len(path) - 2 if len(path) >= 6 else len(path) - 1
+    interior = path[start:end]
+    if len(interior) < toggle_count:
+        return None
