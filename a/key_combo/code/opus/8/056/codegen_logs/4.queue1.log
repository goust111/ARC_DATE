+        path_cells = set(path)
+        segments = []
+        wall_cells: set[Coord] = set()
+        ok = True
+        for door in door_cells:
+            extra_gap = _pick_extra_gap(orientation, door, path_cells, band, W)
+            seg_cells = _segment_wall_cells(orientation, door, band, W, extra_gap)
