        dest_boxes.append(dest)
        input_boxes.append(full)
        placed_sliders.append({**spec, "dest": dest, "pre": pre, "full": full, "attach": attach})
    return placed_sliders, covered


def _gen_static_specs(static_colors: list[int]) -> list[dict]:
