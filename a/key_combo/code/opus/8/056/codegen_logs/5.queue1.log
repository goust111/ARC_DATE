+                "frame_color": int(frame_colors[idx]),
+                "tail_len": int(tail_lengths[idx]),
+                "tail_dir": tail_dir,
+                "tail_attach": tail_attach,
+                "frame_h": frame_h,
+                "frame_w": frame_w,
+                "full_h": full_h,
+                "full_w": full_w,
+                "crop": crop,
+                "motif_top": motif_top,
+                "motif_left": motif_left,
+            }
