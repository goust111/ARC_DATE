+        if np.array_equal(correct, alt):
+            return False
+
+    if not _remember_output(correct):
+        return False
+    return True
+
+
+def _gen_attempt(rng: np.random.Generator, call_idx: int) -> np.ndarray | None:
+    n_objects = 3 + (call_idx % 2)
+    force_multicolor = call_idx % 3 == 0
