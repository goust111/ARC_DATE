+    _RECENT_OUTPUT_SIGS.append(sig)
+    _RECENT_OUTPUT_SET.add(sig)
+    if len(_RECENT_OUTPUT_SIGS) > _RECENT_OUTPUT_LIMIT:
+        old = _RECENT_OUTPUT_SIGS.pop(0)
+        _RECENT_OUTPUT_SET.remove(old)
+    return True
