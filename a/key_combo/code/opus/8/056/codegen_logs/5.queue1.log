+    out = np.zeros((TARGET_SIZE, TARGET_SIZE), dtype=int)
+    for _tail_len, layer in sorted(layers, key=lambda item: item[0], reverse=True):
+        mask = layer != BG
+        out[mask] = layer[mask]
+    return out
