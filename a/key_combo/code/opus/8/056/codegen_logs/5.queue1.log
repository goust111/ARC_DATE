+def _center_in_3x3(crop: np.ndarray) -> np.ndarray:
+    h, w = crop.shape
+    out = np.zeros((TARGET_SIZE, TARGET_SIZE), dtype=int)
+    r0 = (TARGET_SIZE - h) // 2
+    c0 = (TARGET_SIZE - w) // 2
+    out[r0 : r0 + h, c0 : c0 + w] = crop
+    return out
