+
+        fh = fr1 - fr0 + 1
+        fw = fc1 - fc0 + 1
+        if fh < 5 or fw < 5:
+            return
+
+        corners = [(fr0, fc0), (fr0, fc1), (fr1, fc0), (fr1, fc1)]
+        if any(int(grid[r, c]) != BG for r, c in corners):
+            return
+
+        border = _border_cells(fr0, fc0, fr1, fc1)
+        if any(int(grid[r, c]) != int(color) for r, c in border):
