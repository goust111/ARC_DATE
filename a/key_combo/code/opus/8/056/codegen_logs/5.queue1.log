+    comp_h = cr1 - cr0 + 1
+    comp_w = cc1 - cc0 + 1
+    matches: list[dict] = []
+
+    def try_candidate(direction: str, tail_len: int) -> None:
+        if direction == "up":
+            fr0, fc0, fr1, fc1 = cr0 + tail_len, cc0, cr1, cc1
+        elif direction == "down":
+            fr0, fc0, fr1, fc1 = cr0, cc0, cr1 - tail_len, cc1
+        elif direction == "left":
+            fr0, fc0, fr1, fc1 = cr0, cc0 + tail_len, cr1, cc1
+        else:
