+    max_count = h * w
+    total = int(rng.integers(min_count, max_count + 1))
+    if total > min_count:
+        pick = rng.choice(len(remaining), size=total - min_count, replace=False)
+        coords.extend(remaining[int(i)] for i in np.atleast_1d(pick))
