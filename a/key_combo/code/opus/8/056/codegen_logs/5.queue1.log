# Canvas and palette bounds.
GEN_GRID_H, GEN_GRID_W = 20, 20
GEN_GRID_SHAPE = (GEN_GRID_H, GEN_GRID_W)
GEN_BACKGROUND, GEN_COLOR_BINS = 0, 10
GEN_COLOR_POOL = range(1, 10)

# Object count ranges.
