+    h, w = region_id.shape
+    counts: Counter[int] = Counter()
+    for r0, c0 in branch["coords"]:
+        r = int(r0)
+        c = int(c0)
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w:
