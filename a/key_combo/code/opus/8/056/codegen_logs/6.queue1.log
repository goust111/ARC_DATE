+def _find_hub_mask(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    hubs: list[tuple[int, int]] = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            if np.all(grid[r0 : r0 + 3, c0 : c0 + 3] == PATH):
+                hubs.append((r0, c0))
