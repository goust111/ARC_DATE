+
+
+def _branch_contact_counts(
+    branch: dict, region_id: np.ndarray, region_meta: dict[int, dict]
+) -> Counter[int]:
+    h, w = region_id.shape
+    counts: Counter[int] = Counter()
+    for r0, c0 in branch["coords"]:
