+
+
+def _paint_layout(layout: dict[str, int]) -> np.ndarray:
+    h, w = layout["h"], layout["w"]
+    hr, hc, rt, rb = layout["hr"], layout["hc"], layout["rt"], layout["rb"]
+    grid = np.full((h, w), BG, dtype=int)
