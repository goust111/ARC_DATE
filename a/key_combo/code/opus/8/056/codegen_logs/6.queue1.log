+    sys.path.append(str(ARC_UTILS_DIR))
+
+from arc_utils import bbox_coords, components_mask, neighbors4
+
+
+BG = 0
+GREY = 5
+PATH = 6
+REGION_COLORS = [1, 2, 3, 4, 7, 8, 9]
