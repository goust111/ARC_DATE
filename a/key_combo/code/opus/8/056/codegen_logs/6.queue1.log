+    return region["area"] == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _assign_region_colors(
+    regions: list[dict], branches: list[dict], require_hub_tie: bool
+) -> dict[int, int] | None:
+    region_ids = [region["id"] for region in regions]
+    colors: dict[int, int] = {}
+
+    if require_hub_tie:
