+
+
+@dataclass(frozen=True)
+class RaySpec:
+    direction: tuple[int, int]
+    radii: tuple[int, ...]
+
+
+@dataclass(frozen=True)
+class ObjectSpec:
+    color: int
+    side: str
+    helper_shift: int
+    rays: tuple[RaySpec, ...]
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
