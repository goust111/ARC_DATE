  "src": "8-connected non-square foreground sprite s",
  "dst": "solid 2x2 square anchor d",
  "match_cond": "s faces d by cardinal separation with overlapping span",
  "transform": "translate s to touch d's facing edge, mirror s across that edge in d.color, and clear originals"
}
</annotation>
