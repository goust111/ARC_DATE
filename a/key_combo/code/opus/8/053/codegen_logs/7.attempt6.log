+    mid_zone_min = max(2, W // 3)
+    mid_zone_max = max(mid_zone_min, W // 2 - small_w)
+    right_zone_min = max(W // 2 + 1, mid_zone_min + small_w + 2)
+    if right_zone_min > W - 1:
