+    for top in range(-h + 1, H):
+        for left in range(-w + 1, W):
+            coords = _coords_from_mask(mask, top, left, grid_shape)
+            if len(coords) < min_visible:
+                continue
+            if max_visible is not None and len(coords) > max_visible:
