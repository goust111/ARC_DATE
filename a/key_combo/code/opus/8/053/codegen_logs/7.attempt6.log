+
+
+def _target_output_coords(candidate: dict, shift: int, grid_shape: tuple[int, int]) -> list[tuple[int, int]]:
+    H, _W = grid_shape
+    moved = [(r + shift, c) for r, c in candidate["coords"] if r + shift < H]
+    return moved
