+def _well_separated(existing: set[tuple[int, int]], candidate: list[tuple[int, int]]) -> bool:
+    for r, c in candidate:
+        for dr, dc in DIR8 + [(0, 0)]:
+            if (r + dr, c + dc) in existing:
+                return False
