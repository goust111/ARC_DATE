+        (0, 1, obj_a, obj_b),
+        (1, 0, obj_b, obj_a),
+    ):
+        for factor in (2, 3):
+            if _window_match(big_obj["mask"], small_obj["mask"], factor):
+                records.append(
+                    {
+                        "small_local": small_idx,
+                        "big_local": big_idx,
+                        "factor": factor,
+                        "small_height": int(small_obj["height"]),
