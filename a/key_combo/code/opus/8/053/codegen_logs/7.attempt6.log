+def _coords_from_mask(mask: np.ndarray, top: int, left: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    H, W = shape
+    coords: list[tuple[int, int]] = []
+    for r, c in np.argwhere(mask):
+        rr = top + int(r)
+        cc = left + int(c)
+        if 0 <= rr < H and 0 <= cc < W:
+            coords.append((rr, cc))
