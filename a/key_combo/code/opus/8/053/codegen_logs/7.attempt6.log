+        return False
+    if (meta["output"].tobytes(), meta["output"].shape) in shortcut_outputs:
+        return False
+
+    return True
+
+
+def _separated_pair(a: list[tuple[int, int]], b: list[tuple[int, int]]) -> bool:
+    return _well_separated(set(a), b)
+
+
+def _attempt_generate() -> np.ndarray | None:
