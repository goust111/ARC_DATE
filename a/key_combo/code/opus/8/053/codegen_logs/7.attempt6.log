+    sh, sw = scaled.shape
+    if bh > sh or bw > sw:
+        return False
+    for r0 in range(sh - bh + 1):
+        for c0 in range(sw - bw + 1):
+            if np.array_equal(scaled[r0 : r0 + bh, c0 : c0 + bw], big_mask):
