+    arr = np.array(cells, dtype=int)
+    arr = np.column_stack((arr[:, 1], -arr[:, 0]))
+    return _normalize_cells({tuple(x) for x in arr.tolist()})
+
+
+def _flip_cells(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    arr = np.array(cells, dtype=int)
