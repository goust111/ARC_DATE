+
+def _make_grid(
+    grid_shape: tuple[int, int],
+    small_place: dict,
+    large_place: dict,
+    target_place: dict,
+    colors: tuple[int, int, int],
+) -> np.ndarray:
+    grid = np.zeros(grid_shape, dtype=int)
