+    small_place: dict,
+    large_place: dict,
+    target_place: dict,
+    colors: tuple[int, int, int],
+) -> np.ndarray:
+    grid = np.zeros(grid_shape, dtype=int)
+    _paint(grid, small_place["coords"], colors[0])
+    _paint(grid, large_place["coords"], colors[1])
+    _paint(grid, target_place["coords"], colors[2])
