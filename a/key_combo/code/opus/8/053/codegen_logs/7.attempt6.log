+    want_big_clipped = True if factor == 3 else random.random() < 0.6
+    small_mask = _sample_small_shape(factor, allow_unclipped_big=not want_big_clipped)
+    shift = factor * int(small_mask.shape[0])
+    target_mask = _sample_target_shape(small_mask, factor, shift)
+    want_target_clipped = random.random() < 0.5
+
+    large_mask = _scale_mask(small_mask, factor)
+    small_places = _candidate_inbounds_placements(small_mask, (H, W))
+    large_places = _candidate_visible_placements(
+        large_mask,
+        (H, W),
+        clipped=want_big_clipped,
+        min_visible=4,
+        max_visible=20,
+    )
+    target_places = []
+    target_col_max = max(0, W // 3)
+    for place in _candidate_inbounds_placements(target_mask, (H, W)):
+        if place["left"] > target_col_max:
+            continue
+        moved = _target_output_coords(place, shift, (H, W))
+        clipped = len(moved) != len(place["coords"])
+        if clipped != want_target_clipped:
+            continue
+        if len(moved) < 2:
+            continue
+        target_places.append(place)
+
+    small_places = [
+        place
+        for place in small_places
+        if W // 3 <= place["left"] <= max(W // 2, W // 3)
+        and place["top"] <= max(1, H // 2)
+    ]
+
+    if want_big_clipped:
+        large_places = [
+            place
+            for place in large_places
+            if place["top"] >= max(1, H - large_mask.shape[0] + 1)
+            and place["left"] >= max(W // 2, 0)
+            and place["left"] + large_mask.shape[1] <= W
+        ]
+    else:
+        large_places = [
+            place
+            for place in large_places
+            if place["top"] >= 0
+            and place["left"] >= max(W // 2, 0)
+            and place["left"] + large_mask.shape[1] <= W
+        ]
+
+    if not small_places or not large_places or not target_places:
+        return None
+
+    colors = tuple(random.sample(PALETTE, 3))
+    random.shuffle(small_places)
+    random.shuffle(large_places)
+    random.shuffle(target_places)
+
+    for target_place in target_places[:60]:
+        for small_place in small_places[:60]:
+            if not _separated_pair(target_place["coords"], small_place["coords"]):
+                continue
+            for large_place in large_places[:80]:
+                if not _separated_pair(target_place["coords"], large_place["coords"]):
+                    continue
+                if not _separated_pair(small_place["coords"], large_place["coords"]):
+                    continue
+                grid = _make_grid((H, W), small_place, large_place, target_place, colors)
+                if not _semantic_checks(grid):
+                    continue
+                return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 7")

