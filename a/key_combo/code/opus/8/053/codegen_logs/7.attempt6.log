+def _count_components_from_coords(coords: set[tuple[int, int]]) -> int:
+    unseen = set(coords)
+    count = 0
+    while unseen:
+        count += 1
+        q = deque([unseen.pop()])
+        while q:
+            r, c = q.popleft()
+            for dr, dc in DIR4:
