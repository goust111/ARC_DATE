+    target_places = []
+    top_hi = H - shift - target_h
+    if want_target_clipped:
+        top_lo = max(0, H - shift - target_h + 1)
+        top_hi_clip = min(H - target_h, H - shift - 1)
+        for top in range(top_lo, top_hi_clip + 1):
