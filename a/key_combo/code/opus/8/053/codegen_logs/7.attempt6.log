+
+    return {
+        "objects": objects,
+        "small_idx": small_idx,
+        "big_idx": big_idx,
+        "target_idx": target_idx,
+        "factor": factor,
+        "small_height": small_height,
+        "shift": shift,
+        "output": out,
+    }
+
