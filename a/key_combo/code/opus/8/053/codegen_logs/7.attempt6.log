+    count = 0
+    while unseen:
+        count += 1
+        q = deque([unseen.pop()])
+        while q:
+            r, c = q.popleft()
+            for dr, dc in DIR4:
+                nb = (r + dr, c + dc)
+                if nb in unseen:
+                    unseen.remove(nb)
+                    q.append(nb)
