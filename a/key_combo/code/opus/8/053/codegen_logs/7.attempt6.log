+
+
+def _shortcut_outputs(grid_shape: tuple[int, int], target_obj: dict, shifts: set[int]) -> set[tuple[bytes, tuple[int, int]]]:
+    H, W = grid_shape
+    outputs = set()
+    for shift in shifts:
+        out = np.zeros((H, W), dtype=int)
+        for r, c in target_obj["coords"]:
+            rr = int(r) + int(shift)
+            if rr < H:
+                out[rr, int(c)] = int(target_obj["color"])
