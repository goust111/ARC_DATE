+
+def _cells_to_mask(cells: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = 1 + max(r for r, _c in cells)
+    w = 1 + max(c for _r, c in cells)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
