+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        meta = _solve_metadata(grid)
+    except AssertionError:
+        return False
+
+    objects = meta["objects"]
+    areas = [obj["area"] for obj in objects]
+    if not all(4 <= area <= 20 for area in areas):
