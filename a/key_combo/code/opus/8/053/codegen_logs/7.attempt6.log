+
+
+def _fallback_generate() -> np.ndarray | None:
+    factor = 2 if random.random() < 0.8 else 3
+    H = random.randint(17 if factor == 3 else 15, 19)
+    W = random.randint(17 if factor == 3 else 15, 19)
