+        return False
+    if np.array_equal(grid, meta["output"]):
+        return False
+
+    wrong_shifts = {
+        meta["factor"],
+        meta["small_height"],
+        small["area"],
+        target["area"],
+        small["width"],
+        big["height"],
+        big["area"],
+    }
