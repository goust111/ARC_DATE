+            if np.array_equal(scaled[r0 : r0 + bh, c0 : c0 + bw], big_mask):
+                return True
+    return False
+
+
+def _pair_match_records(obj_a: dict, obj_b: dict) -> list[dict]:
+    records: list[dict] = []
+    for small_idx, big_idx, small_obj, big_obj in (
+        (0, 1, obj_a, obj_b),
+        (1, 0, obj_b, obj_a),
+    ):
