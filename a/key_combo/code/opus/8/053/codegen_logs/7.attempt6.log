+    while len(cells) < area:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        r, c = cell
+        for dr, dc in DIR4:
+            nb = (r + dr, c + dc)
+            if nb not in cells:
+                frontier.add(nb)
