+
+def _count_components_from_coords(coords: set[tuple[int, int]]) -> int:
+    unseen = set(coords)
+    count = 0
+    while unseen:
+        count += 1
+        q = deque([unseen.pop()])
+        while q:
+            r, c = q.popleft()
+            for dr, dc in DIR4:
+                nb = (r + dr, c + dc)
+                if nb in unseen:
+                    unseen.remove(nb)
+                    q.append(nb)
+    return count
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    objects: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
