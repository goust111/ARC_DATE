+def _random_polyomino(area: int) -> tuple[tuple[int, int], ...]:
+    cells = {(0, 0)}
+    frontier = {(0, 1), (1, 0), (0, -1), (-1, 0)}
+    while len(cells) < area:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        r, c = cell
+        for dr, dc in DIR4:
+            nb = (r + dr, c + dc)
+            if nb not in cells:
