+        for dr, dc in DIR8 + [(0, 0)]:
+            if (r + dr, c + dc) in existing:
+                return False
+    return True
+
+
+def _paint(grid: np.ndarray, coords: list[tuple[int, int]], color: int) -> None:
+    for r, c in coords:
