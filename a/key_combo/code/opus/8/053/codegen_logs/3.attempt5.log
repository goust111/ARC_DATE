spec:
  grid:
    input: 10-16 rows x 10-16 cols (need not be square) [observed range 15-16]
    output: always 16x16
  background: any color except RED(2) or YELLOW(4); always 7 (orange) [observed]
  markers:
    count_of_colors: exactly 2 foreground colors scattered on background
    color_identity: any colors except bg; may include RED or YELLOW (train_1 uses 4)
    pixel_counts: two distinct counts h < w where h=height, w=width of output rectangle
    h_range: 3-14 [observed 5-12]
    w_range: 5-16 [observed 7-14]
    constraint: h < w, w <= 16, h + w = total marker pixels on grid, h + w <= grid_area
