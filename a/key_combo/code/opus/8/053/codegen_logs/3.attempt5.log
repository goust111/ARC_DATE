+    if not (COUNT_RANGE[0] <= fill_h <= COUNT_RANGE[1] and COUNT_RANGE[0] <= fill_w <= COUNT_RANGE[1]):
+        return False
+    if fill_w > side - 1:
+        return False
+
+    scatter_cells = np.argwhere(np.isin(inp, SCATTER_COLORS))
