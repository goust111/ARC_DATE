+    return palette, gap_col, tile
+
+
+def _render_output(palette: np.ndarray, gap_col: int, tile: np.ndarray, height: int) -> np.ndarray:
+    width = int(palette.shape[0])
+    tile_h, tile_w = map(int, tile.shape)
+    center_offset = (tile_w - 1) // 2
