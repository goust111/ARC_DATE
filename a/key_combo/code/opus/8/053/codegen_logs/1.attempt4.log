+    if any(count == 0 for count in owner_halo_counts):
+        return False
+
+    out = main(inp)
+    if np.array_equal(inp, out):
+        return False
+    if int(np.count_nonzero(out == CORE)) != sum(areas):
+        return False
+
+    for obj in objects:
+        color = int(obj["color"])
+        coords = tuple(obj["coords"])
+        for r, c in coords:
+            if int(out[r, c]) != CORE:
+                return False
