+                    return False
+                halo_count += 1
+        if halo_count == 0:
+            return False
+
+    if len(set(map(int, out.flatten()))) < 4:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        h = random.randint(*GRID_SIDE_RANGE)
+        w = random.randint(*GRID_SIDE_RANGE)
