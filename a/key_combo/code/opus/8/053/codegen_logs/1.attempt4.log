def _gen_skeleton_options(size: int) -> list[tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...]]]:
    min_fg = math.ceil(FOREGROUND_RATE_RANGE[0] * size * size)
    max_fg = math.floor(FOREGROUND_RATE_RANGE[1] * size * size)
    options = []
