    col_dir = 1 if end_c > start_c else -1

    row, col = start_r, start_c
    coords = [(row, col)]
    for step in range(steps):
        if step in row_steps:
            row += row_dir
        if step in col_steps:
            col += col_dir
        coords.append((row, col))
    return coords


