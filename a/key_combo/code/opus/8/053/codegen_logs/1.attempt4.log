{
  "type": "transform_in_place",
  "src": "interior mask inside a same-color frame with four outside-corner control pixels",
  "symbol_instructions": "each outside corner color gives the fill color for the matching quadrant of the frame interior",
  "transform": "crop to the frame interior, split it into four equal quadrants, recolor mask pixels by their quadrant control color, and leave background pixels unchanged",
  "grid_shape": "frame interior"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: N x N square, N = 6-10 (always even), interior = (N-4) x (N-4) with even side
  frame:
    two full rows (row 1, row N-2) and two full cols (col 1, col N-2) of one color
    always 1-cell padding from grid edge
  legend:
    four diagonal corner pixels at (0,0), (0,N-1), (N-1,0), (N-1,N-1)
    all four legend colors mutually distinct and distinct from frame, bg, mask
  interior:
    exactly two colors -- background (bg) and mask; bg also appears outside frame
    mask color appears only inside the interior, never outside
    split into four equal quadrants (top-left, top-right, bottom-left, bottom-right)
    mask density 25-75% per quadrant; 0 mask in a quadrant allowed but rare [observed]
    total mask density 45-75%
  colors: 7 distinct colors total (frame, bg, mask, 4 legends)
  colors_observed: frame=1, bg=0, mask=8 [observed]
  outside_non_frame: all non-frame, non-legend pixels outside the frame are bg
  output:
    crop to interior; replace each mask pixel with its quadrant's legend color; bg unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick even interior side S in {2, 4, 6}; grid size N = S + 4
    2. Choose 7 distinct colors for frame, bg, mask, and 4 legends (TL, TR, BL, BR)
    3. Build the output (S x S) -- for each quadrant (S/2 x S/2), randomly place mask pixels (density 25-75%) using the quadrant's legend color, rest bg
    4. Build input by reversing the transform -- replace all non-bg pixels in interior with mask color
    5. Assemble N x N grid -- fill with bg, draw frame rows/cols, place interior, set 4 corner legend pixels
