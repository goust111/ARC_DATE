  29:     """
  30:     Crop the framed mask and recolor each mask pixel with the legend color from its quadrant.
  31: 
  32:     Input structure:
  33:     - A one-color frame is encoded by two full horizontal lines and two full vertical
  34:       lines of the same color.
  35:     - The four diagonal pixels outside the frame corners are the quadrant legend colors.
  36:     - The framed interior contains one background color and one mask color.
  37: 
  38:     Rule:
  39:     - Output only the rectangular interior of the frame.
  40:     - Split that interior into four equal quadrants.
  41:     - Replace each mask pixel by the corresponding outside-corner legend color and
  42:       leave background pixels unchanged.
  43: 
  44:     Key insight:
  45:     - The four corner pixels are not part of the output; they are a color legend
  46:       for the mask cells in the matching quadrant of the cropped interior.
  47:     """
  48:     g = np.asarray(grid, dtype=int)
  49:     assert g.ndim == 2, "expected a 2D grid"
  50:     height, width = map(int, g.shape)
  51: 
  52:     frame, top, bottom, left, right = _find_frame(g)
  53:     interior = g[top + 1 : bottom, left + 1 : right]
  54:     out_h, out_w = map(int, interior.shape)
  55:     assert out_h > 0 and out_w > 0, "frame must enclose a nonempty interior"
  56:     assert out_h % 2 == 0 and out_w % 2 == 0, "interior must split into four equal quadrants"
  57: 
  58:     outside = np.ones((height, width), dtype=bool)
  59:     outside[top + 1 : bottom, left + 1 : right] = False
  60:     outside_colors = set(map(int, g[outside].reshape(-1))) - {frame}
  61:     interior_colors = set(map(int, interior.reshape(-1)))
  62:     mask_candidates = interior_colors - outside_colors
  63:     assert len(mask_candidates) == 1, "expected one interior-only mask color"
  64:     mask_color = mask_candidates.pop()
  65: 
  66:     bg_candidates = interior_colors - {mask_color}
  67:     assert len(bg_candidates) == 1, "expected one interior background color"
  68:     bg = bg_candidates.pop()
  69: 
  70:     legend_coords = [
  71:         (top - 1, left - 1),
  72:         (top - 1, right + 1),
  73:         (bottom + 1, left - 1),
  74:         (bottom + 1, right + 1),
  75:     ]
  76:     for r, c in legend_coords:
  77:         assert 0 <= r < height and 0 <= c < width, "legend pixels must be outside frame corners"
  78:     top_left, top_right, bottom_left, bottom_right = [int(g[r, c]) for r, c in legend_coords]
  79:     assert all(
  80:         color not in {frame, bg, mask_color}
  81:         for color in (top_left, top_right, bottom_left, bottom_right)
  82:     ), "legend colors must be distinct from frame, background, and mask roles"
  83: 
  84:     mask = interior == mask_color
  85:     assert np.all(interior[~mask] == bg), "all non-mask interior pixels must be background"
