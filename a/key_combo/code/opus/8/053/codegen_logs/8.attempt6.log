+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+CORNER_PALETTE = [BLUE, RED, GREEN, YELLOW]
+QUADRANT_NAMES = ("top_left", "top_right", "bottom_left", "bottom_right")
+MAX_GENERATION_ATTEMPTS = 500
