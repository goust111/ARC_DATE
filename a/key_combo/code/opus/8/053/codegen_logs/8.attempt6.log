+    assert np.array_equal(grid[r0 + 1 : r1, c0 + 1 : c1] == ORANGE, out[r0 + 1 : r1, c0 + 1 : c1] != BLACK)
+    assert np.array_equal(grid[r0 + 1 : r1, c0 + 1 : c1] == BLACK, out[r0 + 1 : r1, c0 + 1 : c1] == BLACK)
