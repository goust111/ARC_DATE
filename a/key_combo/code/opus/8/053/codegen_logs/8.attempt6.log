+) -> np.ndarray:
+    inner_h, inner_w = map(int, interior.shape)
+    r0, c0 = top, left
+    r1, c1 = top + inner_h + 1, left + inner_w + 1
+
+    grid = np.full((H, W), BLACK, dtype=int)
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
