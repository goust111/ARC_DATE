  61:     interior_colors = set(map(int, interior.reshape(-1)))
  62:     mask_candidates = interior_colors - outside_colors
  63:     assert len(mask_candidates) == 1, "expected one interior-only mask color"
  64:     mask_color = mask_candidates.pop()
  65: 
  66:     bg_candidates = interior_colors - {mask_color}
  67:     assert len(bg_candidates) == 1, "expected one interior background color"
  68:     bg = bg_candidates.pop()
  69: 
  70:     legend_coords = [
  71:         (top - 1, left - 1),
  72:         (top - 1, right + 1),
  73:         (bottom + 1, left - 1),
  74:         (bottom + 1, right + 1),
  75:     ]
