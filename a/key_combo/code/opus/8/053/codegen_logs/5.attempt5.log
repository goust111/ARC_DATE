+def _stamp_cells(anchor: tuple[int, int], mask: np.ndarray) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    top = int(anchor[0] - h // 2)
+    left = int(anchor[1] - w // 2)
+    return {
+        (int(top + r), int(left + c))
+        for r, c in np.argwhere(mask != 0)
