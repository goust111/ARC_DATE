+def _hole_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    bg = mask == 0
+    holes: list[tuple[int, int]] = []
+    for comp in _binary_components(bg):
+        if any(int(r) in (0, mask.shape[0] - 1) or int(c) in (0, mask.shape[1] - 1) for r, c in comp):
