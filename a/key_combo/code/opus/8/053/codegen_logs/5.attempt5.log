+def _boxes_intersect(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    pad = int(pad)
+    return not (
+        int(a[2]) + pad < int(b[0])
+        or int(b[2]) + pad < int(a[0])
+        or int(a[3]) + pad < int(b[1])
+        or int(b[3]) + pad < int(a[1])
+    )
