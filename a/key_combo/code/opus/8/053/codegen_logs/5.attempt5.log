+
+def _place_signal(grid: np.ndarray, mask: np.ndarray, anchors: list[tuple[int, int]], stamp_bboxes: list[tuple[int, int, int, int]]) -> tuple[int, int] | None:
+    h, w = grid.shape
+    ph, pw = mask.shape
+    candidates = [
+        (int(top), int(left))
+        for top in range(int(h - ph + 1))
+        for left in range(int(w - pw + 1))
