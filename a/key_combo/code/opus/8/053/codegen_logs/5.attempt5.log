+def _template_features(mask: np.ndarray) -> dict:
+    holes = _hole_cells(mask)
+    h, w = mask.shape
+    return {
+        "mask": mask,
+        "area": int(mask.sum()),
+        "h": int(h),
+        "w": int(w),
+        "hole_cells": holes,
+        "has_hole": bool(holes),
+        "even_dim": bool(h % 2 == 0 or w % 2 == 0),
+        "center_filled": bool(mask[h // 2, w // 2] != 0),
