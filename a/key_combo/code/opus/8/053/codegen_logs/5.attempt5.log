+    center_r, center_c = int(mask.shape[0] // 2), int(mask.shape[1] // 2)
+    candidates = [
+        (int(r), int(c))
+        for r in range(center_r, int(h - mask.shape[0] + center_r + 1))
+        for c in range(center_c, int(w - mask.shape[1] + center_c + 1))
