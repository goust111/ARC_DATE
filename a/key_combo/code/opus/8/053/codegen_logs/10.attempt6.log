+def _render_glyph(mask_bits: int, color: int) -> np.ndarray:
+    cell = np.full((CELL, CELL), REF_BG, dtype=int)
+    mask = np.array([(mask_bits >> i) & 1 for i in range(CELL * CELL)], dtype=bool).reshape(CELL, CELL)
+    cell[mask] = int(color)
+    return cell
