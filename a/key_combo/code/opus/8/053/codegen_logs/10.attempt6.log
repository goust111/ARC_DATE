+        for c in range(ncols)
+    )
+    table = [
+        [
+            _cell_signature(block[(r + 1) * CELL : (r + 2) * CELL, c * CELL : (c + 1) * CELL])
+            for c in range(ncols)
+        ]
+        for r in range(nrows)
+    ]
+    return query, table
+
