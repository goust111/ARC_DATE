+    r0, c0, r1, c1 = box
+    block = top[r0 : r1 + 1, c0 : c1 + 1]
+    h, w = block.shape
+    assert h % CELL == 0 and w % CELL == 0, "reference structure must align to 3x3 glyph cells"
+    assert h >= 2 * CELL, "reference structure must contain a query row plus table rows"
+    nrows = h // CELL - 1
+    ncols = w // CELL
+
