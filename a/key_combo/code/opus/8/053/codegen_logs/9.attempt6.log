+        if not options:
+            return None
+
+        anchor = random.choice(options)
+        anchors[idx] = anchor
+        input_cells = _cells_from_anchor(shape, anchor)
+        occupied_inputs[idx] = input_cells
+        occupied_outputs[idx] = _visible_shifted_cells(input_cells, int(spec["area"]), width)
