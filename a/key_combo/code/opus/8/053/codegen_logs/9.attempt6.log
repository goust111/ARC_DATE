+def _normalize(coords: list[tuple[int, int]]) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
