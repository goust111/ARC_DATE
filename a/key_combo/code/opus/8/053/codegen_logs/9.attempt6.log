+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _normalize(coords: list[tuple[int, int]]) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
+
+
+def _find_components(grid: np.ndarray, bg: int = 0) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords_arr = np.asarray(coords, dtype=int)
+            bbox = (
+                int(coords_arr[:, 0].min()),
+                int(coords_arr[:, 1].min()),
+                int(coords_arr[:, 0].max()),
+                int(coords_arr[:, 1].max()),
+            )
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "area": int(len(coords)),
+                    "bbox": bbox,
+                }
+            )
+
+    return components
+
+
+def _paint_shifted(
+    shape: tuple[int, int], components: list[dict], *, descending_area: bool = True
+) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=int)
+    order = sorted(components, key=lambda comp: int(comp["area"]), reverse=descending_area)
+    for comp in order:
+        area = int(comp["area"])
+        color = int(comp["color"])
+        coords = np.asarray(comp["coords"], dtype=int)
+        for r, c in coords:
+            cc = int(c) + area
+            if 0 <= cc < w:
+                out[int(r), cc] = color
+    return out
+
+
+def _paint_uniform_shift(shape: tuple[int, int], components: list[dict], shift: int) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=int)
+    for comp in components:
+        color = int(comp["color"])
+        coords = np.asarray(comp["coords"], dtype=int)
+        for r, c in coords:
+            cc = int(c) + int(shift)
+            if 0 <= cc < w:
