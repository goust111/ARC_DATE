    expected = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND, dtype=int)
    inp = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND, dtype=int)
    out_used = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)
