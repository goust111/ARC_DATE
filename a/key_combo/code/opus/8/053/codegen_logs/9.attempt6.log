+        rot = random.randrange(4)
+        for _ in range(rot):
+            arr = np.column_stack((arr[:, 1], -arr[:, 0]))
+        if random.random() < 0.5:
+            arr[:, 1] *= -1
+        arr = _normalize([tuple(cell) for cell in arr])
