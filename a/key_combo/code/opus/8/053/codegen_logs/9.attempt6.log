+                int(coords_arr[:, 1].min()),
+                int(coords_arr[:, 0].max()),
+                int(coords_arr[:, 1].max()),
+            )
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "area": int(len(coords)),
+                    "bbox": bbox,
+                }
+            )
