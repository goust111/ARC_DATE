+        cells = {(0, 0)}
+        frontier = {(0, 1), (1, 0), (0, -1), (-1, 0)}
+        while len(cells) < area:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            cells.add(cell)
+            r, c = cell
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) not in cells:
+                    frontier.add((nr, nc))
