    return out


def _candidate_positions(shape: tuple[Coord, ...], h: int, w: int) -> list[tuple[Coord, ...]]:
    shape_h = max(r for r, _ in shape) + 1
    shape_w = max(c for _, c in shape) + 1
    positions: list[tuple[Coord, ...]] = []
    for r0 in range(h - shape_h + 1):
