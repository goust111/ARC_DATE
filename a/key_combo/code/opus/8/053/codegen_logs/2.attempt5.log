+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        require_bbox_conflict = random.random() < 0.6
+        base = _sample_base_pattern()
+        red_cells = _choose_red_cells(base, require_bbox_conflict)
