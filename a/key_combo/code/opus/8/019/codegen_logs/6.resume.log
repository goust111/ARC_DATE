+        return False
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    rel = coords - np.array([r0, c0])
+    if np.any(rel % 2 != 0):
+        return False
+
+    h = (r1 - r0) // 2 + 1
+    w = (c1 - c0) // 2 + 1
+    expected = 2 * h + 2 * w - 4
+    if coords.shape[0] != expected:
