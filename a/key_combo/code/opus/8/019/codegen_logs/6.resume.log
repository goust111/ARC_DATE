+
+def _turns_from_marker(marker: tuple[int, int], bbox: tuple[int, int, int, int]) -> int:
+    mr, mc = marker
+    r0, c0, r1, c1 = bbox
+    if mr == r0 - 1 and c0 <= mc <= c1:
