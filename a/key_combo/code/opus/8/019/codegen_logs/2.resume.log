+    central_cols = [c for c in cols if w // 4 <= c < w - w // 4]
+    core = [(r, c) for r in central_rows for c in central_cols if grid[r, c] == BG]
+    core_set = set(core)
+    outer = [(r, c) for r in rows for c in cols if grid[r, c] == BG and (r, c) not in core_set]
