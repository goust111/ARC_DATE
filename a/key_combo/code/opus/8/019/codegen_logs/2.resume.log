    col_starts, col_margin = _gen_axis_layout(rng, n_col_bands)
    if row_margin < 0 or col_margin < 0 or row_margin + col_margin < MIN_TOTAL_MARGIN:
        return None

    return _render_lattice(row_starts, col_starts)


