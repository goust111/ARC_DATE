+def _transform_coords(
+    coords: set[tuple[int, int]],
+    rot_k: int,
+    flip_h: bool,
+    flip_v: bool,
+) -> set[tuple[int, int]]:
+    arr = np.asarray(sorted(coords), dtype=int)
+    r0, c0, r1, c1 = _bbox(list(coords))
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    rel = arr - np.array([r0, c0])
+    canvas_h, canvas_w = h, w
+    pts = rel.copy()
+    for _ in range(rot_k % 4):
+        pts = np.column_stack([pts[:, 1], canvas_h - 1 - pts[:, 0]])
+        canvas_h, canvas_w = canvas_w, canvas_h
+    if flip_h:
+        pts[:, 1] = canvas_w - 1 - pts[:, 1]
+    if flip_v:
+        pts[:, 0] = canvas_h - 1 - pts[:, 0]
+    pts -= pts.min(axis=0)
+    return {tuple(map(int, rc)) for rc in pts}
