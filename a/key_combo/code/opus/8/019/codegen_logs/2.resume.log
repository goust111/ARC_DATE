    mask = np.zeros(MASK_SHAPE, dtype=int)
    mask[labels >= 0] = MARKER_COLOR
    return mask


def _gen_passes_oracle(inp: np.ndarray, tile: np.ndarray, mask: np.ndarray) -> bool:
    expected = np.kron(mask == MARKER_COLOR, tile).astype(int)
    try:
