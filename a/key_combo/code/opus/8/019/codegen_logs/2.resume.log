+    out = np.asarray(grid, dtype=int).copy()
+    out[out == GREY] = BG
+    occupied = {tuple(map(int, rc)) for rc in np.argwhere(out != BG)}
+    occupied -= {tuple(map(int, p)) for p in pivots}
