+BG = 0
+RECT_COLOR = 2
+PIVOT_COLOR = 3
+GREY = 5
+SQUARE_COLOR = 8
+
+SQUARE = "square"
+HBAR = "hbar"
+VBAR = "vbar"
+RECTS = {HBAR, VBAR}
+PRIMITIVES = {
+    SQUARE: ((0, 0), (0, 1), (1, 0), (1, 1)),
+    HBAR: ((0, 0), (0, 1), (0, 2)),
+    VBAR: ((0, 0), (1, 0), (2, 0)),
