                rr0, cc0, rr1, cc1 = _bbox(sorted(occupied | cells))
                if rr1 - rr0 > 7 or cc1 - cc0 > 7:
                    continue
                options.append(cells)
        if not options:
            return None
        cells = random.choice(options)
