        remapped.append({"kind": piece["kind"], "cells": piece_rel})

    # Reconstruct piece cells directly by transforming each piece individually with the same global transform.
    rr0, cc0, rr1, cc1 = _bbox(sorted(occupied))
    canvas_h = rr1 - rr0 + 1
    canvas_w = cc1 - cc0 + 1
    rot_k = random.randrange(4)
    flip_h = bool(random.getrandbits(1))
    flip_v = bool(random.getrandbits(1))
    out = []
    for piece in pieces:
        arr = np.asarray(sorted(piece["cells"]), dtype=int) - np.array([rr0, cc0])
        pts = arr.copy()
