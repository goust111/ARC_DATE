+def _assign_pivots(pieces: list[dict], pivots: np.ndarray) -> list[int]:
+    assert len(pivots) >= 2
+    assignments = []
+    for piece in pieces:
+        cr, cc = piece["center"]
+        dists = ((pivots[:, 0] - cr) ** 2 + (pivots[:, 1] - cc) ** 2).astype(float)
+        order = np.argsort(dists)
+        assert len(order) >= 1
+        if len(order) >= 2:
+            assert dists[order[1]] - dists[order[0]] > 1e-9, "nearest pivot must be unique"
