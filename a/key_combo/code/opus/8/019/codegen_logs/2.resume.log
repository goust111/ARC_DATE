+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
