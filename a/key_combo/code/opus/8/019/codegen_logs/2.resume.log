+    rr0, cc0, rr1, cc1 = _bbox(sorted(occupied))
+    rot_k = random.randrange(4)
+    flip_h = bool(random.getrandbits(1))
+    flip_v = bool(random.getrandbits(1))
+    canvas_h = rr1 - rr0 + 1
+    canvas_w = cc1 - cc0 + 1
+    transformed_arrays = []
+    for piece in pieces:
