            pts = np.column_stack([pts[:, 1], ch - 1 - pts[:, 0]])
            ch, cw = cw, ch
        if flip_h:
            pts[:, 1] = cw - 1 - pts[:, 1]
        if flip_v:
            pts[:, 0] = ch - 1 - pts[:, 0]
        pts -= pts.min(axis=0)
        out.append({"kind": piece["kind"], "cells": {tuple(map(int, rc)) for rc in pts}})
    return out


def _build_group(kinds: list[str]) -> list[dict] | None:
    pieces: list[dict] = []
    occupied: set[tuple[int, int]] = set()

    first_kind = kinds[0]
    first_cells = _piece_cells(first_kind, 0, 0)
    pieces.append({"kind": first_kind, "cells": first_cells})
