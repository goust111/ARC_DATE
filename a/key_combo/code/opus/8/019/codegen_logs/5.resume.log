    patterns: list[tuple[str, ...] | None] = [None] * len(widths)
    for width in GEN_PATTERN_WIDTHS:
        idxs = [i for i, w in enumerate(widths) if w == width]
        random.shuffle(idxs)
        pos = 0
        while pos < len(idxs):
            remaining = len(idxs) - pos
            if remaining >= 3 and random.random() < GEN_GROUP3_PROB:
