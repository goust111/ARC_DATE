+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+
+MAX_ATTEMPTS = 400
+
+
+def _control_length(grid: np.ndarray) -> int:
+    row0 = np.asarray(grid[0], dtype=int)
