+    vals: list[int] = []
+    runs = _run_lengths(n)
+    for i, run in enumerate(runs):
+        vals.extend([RED] * run)
+        if i != len(runs) - 1:
+            vals.append(BG)
+    return np.asarray(vals, dtype=int)
+
