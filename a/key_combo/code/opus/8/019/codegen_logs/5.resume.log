            elif remaining >= 2 and random.random() < GEN_GROUP2_PROB:
                group_size = GEN_CELL_WIDTH_MIN
            else:
                group_size = 1
            pat = _gen_weighted_pattern(width)
            for idx in idxs[pos : pos + group_size]:
                patterns[idx] = pat
            pos += group_size
    return [pat for pat in patterns if pat is not None]


