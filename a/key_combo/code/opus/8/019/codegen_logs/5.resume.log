+def _pick_split_obstacle(wrapped: np.ndarray) -> tuple[int, int] | None:
+    h, w = wrapped.shape
+    candidates: list[tuple[int, int]] = []
+    for c in range(w):
+        red_rows = _column_red_rows(wrapped, c)
+        if len(red_rows) < 2:
