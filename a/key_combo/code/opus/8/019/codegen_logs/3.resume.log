+        if group.get("closed", False):
+            color = next(color_iter)
+            mr, mc = group["marker"]
+            if grid[mr, mc] != BG:
+                raise ValueError("marker overlap")
+            grid[mr, mc] = color
+            marker_info = {"coord": (mr, mc), "color": color}
