+
+def _transform_point(
+    pt: tuple[int, int], shape: tuple[int, int], rot: int, mirror: bool
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    r, c = pt
+    h, w = shape
+    if mirror:
+        c = w - 1 - c
+    for _ in range(rot % 4):
+        r, c = c, h - 1 - r
+        h, w = w, h
+    return (r, c), (h, w)
