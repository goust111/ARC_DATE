+    if not any(int(v) in MARKER_COLORS for v in np.unique(out)):
+        return False
+
+    orange_targets = [coord for group in meta["groups"] for coord in group["oranges"]]
+    probe = orange_targets[0]
+    no_block = grid.copy()
+    no_block[probe] = BG
