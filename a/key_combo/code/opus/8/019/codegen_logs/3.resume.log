+def _place_groups(groups: list[dict], shape: tuple[int, int]) -> list[dict] | None:
+    h, w = shape
+    placed: list[dict] = []
+    taken_boxes: list[tuple[int, int, int, int]] = []
+
+    def boxes_far_enough(box: tuple[int, int, int, int]) -> bool:
+        r0, c0, r1, c1 = box
