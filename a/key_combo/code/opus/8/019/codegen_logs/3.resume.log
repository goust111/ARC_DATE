+    order = list(groups)
+    random.shuffle(order)
+    for group in order:
+        gh, gw = group["shape"]
+        for _ in range(120):
+            top = random.randint(1, h - gh - 2)
+            left = random.randint(1, w - gw - 2)
+            box = (top, left, top + gh - 1, left + gw - 1)
+            if not boxes_far_enough(box):
