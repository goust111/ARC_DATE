+    mask[:, 0] = True
+    mask[:, -1] = True
+
+    if rng.random() < 0.8:
+        mask[:, rng.randrange(1, width - 1)] = True
+    if rng.random() < 0.8:
+        mask[rng.randrange(1, height - 1), :] = True
+
+    if rng.random() < 0.45 and width >= 6:
