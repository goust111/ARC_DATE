+        end = rng.randrange(2, width - 1)
+        mask[row, :end] = True
+    if rng.random() < 0.45 and height >= 6:
+        col = rng.randrange(1, width - 1)
+        end = rng.randrange(2, height - 1)
+        mask[:end, col] = True
+
+    return mask
+
