+                        coords.append((rr, cc))
+                        for nr, nc in neighbors4(rr, cc):
+                            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                                seen[nr, nc] = True
