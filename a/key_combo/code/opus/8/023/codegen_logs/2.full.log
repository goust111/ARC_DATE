+                "wall_coords": [(int(r), int(c)) for r, c in comp["coords"]],
+                "opening": opening_global,
+                "side": side,
+                "direction": SIDE_TO_DIR[side],
+                "internal_coords": internal_global,
+                "area": int(len(internal_global)),
+                "bbox_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
