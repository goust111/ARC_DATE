    k_hole_max = min(HOLE_OBJECT_COUNT_RANGE[1], total_objects - 1)
    k_hole = random.randint(k_hole_min, k_hole_max)
    k_nohole = total_objects - k_hole
    return total_objects, k_hole, k_nohole


