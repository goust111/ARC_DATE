+
+    def neighbors4(r: int, c: int):
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
