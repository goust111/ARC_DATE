+    palette = [int(v) for v in g[-1] if int(v) != Color.BLACK]
+    assert 3 <= len(palette) <= 4
+    scene = g[:-1].copy()
+
+    cups = _analyze_cups(scene)
+    assert len(cups) == len(palette)
+    areas = [cup["area"] for cup in cups]
