+    scene = np.full((scene_h, scene_w), Color.BLACK, dtype=int)
+    placed_boxes: list[tuple[int, int, int, int]] = []
+    placed_cups: list[dict] = []
+    order = sorted(range(n), key=lambda i: cups[i]["patch"].shape[0] * cups[i]["patch"].shape[1], reverse=True)
