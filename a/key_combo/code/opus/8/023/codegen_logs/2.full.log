+            raise NotImplementedError("fallback find_components only supports 4-connected monochromatic dict mode")
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        if colors is None:
+            colors = sorted(set(map(int, g.ravel())) - {int(bg)})
