+        return int(vals[np.argmax(counts)])
+
+    def neighbors4(r: int, c: int):
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        if connectivity != 4 or not monochromatic or return_format != "dict":
+            raise NotImplementedError("fallback find_components only supports 4-connected monochromatic dict mode")
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        if colors is None:
+            colors = sorted(set(map(int, g.ravel())) - {int(bg)})
+        out: list[dict] = []
+        for color in colors:
+            mask = g == int(color)
+            seen = np.zeros(g.shape, dtype=bool)
+            for r in range(g.shape[0]):
+                for c in range(g.shape[1]):
+                    if seen[r, c] or not mask[r, c]:
+                        continue
+                    q = deque([(r, c)])
+                    seen[r, c] = True
+                    coords = []
+                    while q:
+                        rr, cc = q.popleft()
+                        coords.append((rr, cc))
+                        for nr, nc in neighbors4(rr, cc):
+                            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                                seen[nr, nc] = True
+                                q.append((nr, nc))
+                    if len(coords) < int(min_area):
+                        continue
+                    arr = np.array(coords, dtype=int)
+                    r0, c0 = arr.min(axis=0)
+                    r1, c1 = arr.max(axis=0)
+                    out.append(
