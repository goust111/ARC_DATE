    H, W = grid.shape
    rh = random.randint(RECT_HEIGHT_MIN, min(RECT_HEIGHT_MAX, H - 1))
    rw = random.randint(RECT_WIDTH_MIN, min(RECT_WIDTH_MAX, W))
    c0_min = max(0, col - rw + 1)
    c0_max = min(W - rw, col)
    if c0_max < c0_min:
        return False
