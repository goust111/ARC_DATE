+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < local.shape[0] and 0 <= nc < local.shape[1] and not seen[nr, nc] and int(local[nr, nc]) == Color.BLACK:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
+
+def _analyze_cups(scene: np.ndarray) -> list[dict]:
+    cups = find_components(
+        scene,
+        bg=Color.BLACK,
+        colors=[Color.GREY],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
