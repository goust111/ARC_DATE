    grid = np.zeros((height, width), dtype=int)
    for row, c0, c1 in h_segments:
        grid[row, c0 : c1 + 1] = color
    for col, r0, r1 in v_segments:
        grid[r0 : r1 + 1, col] = color
    return grid


