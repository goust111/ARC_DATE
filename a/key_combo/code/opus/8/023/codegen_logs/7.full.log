+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+MARKER = 5
+ODD_SIDES = (1, 3, 5, 7, 9)
+SIDE_CYCLE = (9, 7, 5, 3, 1)
+PALETTE = (1, 2, 3, 4, 6)
