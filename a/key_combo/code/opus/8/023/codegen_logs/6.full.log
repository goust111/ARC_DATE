+def _extract_controls(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    top_cols = [int(c) for c in np.flatnonzero(grid[0] == Color.BLUE) if int(c) != 0]
+    left_rows = [int(r) for r in np.flatnonzero(grid[:, 0] == Color.RED) if int(r) != 0]
