+    for c in top_cols:
+        out[1:, c] = Color.BLUE
+    for r in left_rows:
+        out[r, 1:] = Color.RED
+    if top_cols and left_rows:
+        out[np.ix_(left_rows, top_cols)] = Color.GREEN
