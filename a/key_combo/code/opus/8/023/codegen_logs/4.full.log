def _manhattan_center2(a: tuple[int, int], b: tuple[int, int]) -> int:
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def _has_enclosed_hole(grid: np.ndarray, comp: dict) -> bool:
    bbox = comp["bbox"]
