+    (0, 0): (1, 1),  # missing UL -> stamp in LR
+    (0, 1): (1, 0),  # missing UR -> stamp in LL
+    (1, 0): (0, 1),  # missing LL -> stamp in UR
+    (1, 1): (0, 0),  # missing LR -> stamp in UL
