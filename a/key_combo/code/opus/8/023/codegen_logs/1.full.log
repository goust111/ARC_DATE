+    out = np.asarray(wall_grid, dtype=int).copy()
+    h, w = out.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    def push(r: int, c: int) -> None:
+        if out[r, c] == BLACK and not exterior[r, c]:
+            exterior[r, c] = True
+            q.append((r, c))
