        if chosen is None:
            return None
        mask[chosen] = True

    cropped = _gen_crop_mask(mask)
    if int(cropped.sum()) != target_area or _gen_hole_size(cropped) > 0:
        return None
    return _gen_patch_from_mask(mask, bg, fg)


