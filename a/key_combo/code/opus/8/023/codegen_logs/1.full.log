+        return None
+
+    output_signature = main(input_grid).tobytes() + str(main(input_grid).shape).encode()
+    if output_signature in SEEN_OUTPUT_SIGNATURES:
+        return None
+    SEEN_OUTPUT_SIGNATURES.add(output_signature)
+    return input_grid
