+    panel_h = random.randint(9, 13)
+    panel_w = random.randint(9, 14)
+
+    ring_sizes = [
+        (3, 5),
+        (4, 4),
+        (5, 3),
+        (3, 6),
+        (4, 5),
+        (5, 4),
+        (6, 3),
