    lo = max(min_pixels, int(np.ceil(FOREGROUND_DENSITY_RANGE[0] * h * w)))
    hi = min(OBJECT_MAX_AREA * total_objects, int(np.floor(FOREGROUND_DENSITY_RANGE[1] * h * w)))
    if lo > hi:
        return None
    return random.randint(lo, hi)


