+
+
+def _fill_side_regions(
+    out: np.ndarray,
+    *,
+    row_lo: int,
+    row_hi: int,
+    left_bar_col: int,
+    right_bar_col: int,
+    marker: np.ndarray,
+) -> None:
+    assert row_lo <= row_hi, "fill region must be non-empty"
+    left_cols = np.arange(0, left_bar_col, dtype=int)
+    right_cols = np.arange(right_bar_col + 1, out.shape[1], dtype=int)
