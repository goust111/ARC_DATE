+    seed = (random.randint(row_lo, row_hi), random.randint(col_lo, col_hi))
+    coords = {seed}
+    frontier = {
+        (seed[0] + dr, seed[1] + dc)
+        for dr, dc in NEIGHBORS8
+        if row_lo <= seed[0] + dr <= row_hi and col_lo <= seed[1] + dc <= col_hi
