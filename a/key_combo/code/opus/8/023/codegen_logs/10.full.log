    c0, c1 = c - GEN_FRAME_RADIUS, c + GEN_FRAME_RADIUS + 1
    grid[r0:r1, c0:c1] = GEN_FRAME
    grid[r, c] = GEN_MARKER
    grid[gap] = GEN_BG
    return gap, exterior


