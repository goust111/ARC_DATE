+    coords = [tuple(map(int, coord)) for coord in np.argwhere(grid == BLUE)]
+    assert coords
+    r0, c0, r1, c1 = _bbox(coords)
+    return grid[r0 : r1 + 1, c0 : c1 + 1] == BLUE
