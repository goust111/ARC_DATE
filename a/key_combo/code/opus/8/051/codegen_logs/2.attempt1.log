+def _stamp(base: np.ndarray, sprite_mask: np.ndarray, controls: list[tuple[int, int]]) -> np.ndarray:
+    out = base.copy()
+    h, w = base.shape
+    sh, sw = sprite_mask.shape
+    for r, c in controls:
