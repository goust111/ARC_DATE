spec:
  task: collapse duplicate row/column runs back to the original small color matrix
  input:
    grid: 12-15 rows x 14-15 cols, no color 0 (colors 1-9 only)
    structure: |
      A small base_matrix (the output) has each row repeated >=2 times consecutively
      and each column repeated >=2 times consecutively, producing a block-stretched grid.
    base_matrix: 2-5 rows x 2-4 cols [observed]
    base_colors: 4-9 distinct colors filling every cell; no background
    adjacency: adjacent rows in base_matrix are never identical vectors; same for adjacent columns
    row_run_lengths: each >=2, not all equal, sum = input height (12-15)
    col_run_lengths: each >=2, not all equal, sum = input width (14-15)
    run_range: individual run lengths 2-11
  output:
    grid: the deduplicated base_matrix (first row of each row-run, first col of each col-run)

generation_strategy:
  approach: output-first
  steps:
    1. choose output dims R in [2,5], C in [2,4]
    2. choose input dims H in [12,15], W in [14,15]
    3. partition H into R run-lengths each >=2 with not all equal; partition W into C run-lengths each >=2 with not all equal
    4. pick num_colors in [max(4, R*C//2), min(9, R*C)]; fill R x C base_matrix with those colors ensuring no two adjacent rows are identical vectors and no two adjacent columns are identical vectors
    5. stretch base_matrix by repeating row i run_lengths_row[i] times and col j run_lengths_col[j] times to produce the input grid
