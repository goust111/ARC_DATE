+            r1, c1 = later
+            radius = len(hits[later])
+            if abs(r1 - r0) <= radius and abs(c1 - c0) <= radius:
+                return True
+    return False
+
+
+def _validate_generated_scene(grid: np.ndarray) -> bool:
