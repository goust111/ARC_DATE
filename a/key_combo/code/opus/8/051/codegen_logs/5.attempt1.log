+def _simulate_path(
+    shape: tuple[int, int],
+    template: str,
+    initial_head: tuple[int, int],
+    initial_facing: int,
+    markers: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], list[int]]:
