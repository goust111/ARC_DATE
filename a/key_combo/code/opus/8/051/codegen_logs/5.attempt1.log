        continue
    h,w,tr,tc = canvas
    heads = mod._translate_points(rel_heads, tr, tc)
    facings = list(map(int, rel_facings))
    shape=(int(h),int(w))
    if not mod._validate_semantics(shape, template, heads, facings, step_dirs):
        counts['semantic_fail'] += 1
        continue
    inp = mod._render_input(shape, template, heads[0], facings[0], heads[1:])
    expected = mod._render_output(shape, template, heads, facings)
    if not np.array_equal(mod.main(inp), expected):
        counts['solver_fail'] += 1
        continue
    counts['ok'] += 1
print(counts)
