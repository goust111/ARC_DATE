+    if turns < 2:
+        return False
+    if len(set(step_dirs)) < 3:
+        return False
+    if all(step_dirs[i] != step_dirs[i - 1] for i in range(1, len(step_dirs))):
+        return False
+    if not ((0 in step_dirs and 2 in step_dirs) or (1 in step_dirs and 3 in step_dirs)):
+        return False
+    return True
+
+
+def _candidate_clear_of_past_sprites(
