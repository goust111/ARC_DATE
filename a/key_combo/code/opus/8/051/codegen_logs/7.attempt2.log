+        random.shuffle(pairs)
+        for i, j in pairs:
+            for cell in cells:
+                dists = [abs(cell[0] - cr) + abs(cell[1] - cc) for cr, cc in centers]
+                if dists[i] != dists[j]:
+                    continue
+                if sum(d == dists[i] for d in dists) > 2:
