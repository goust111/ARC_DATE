+    fw = fc1 - fc0 + 1
+
+    for _ in range(80):
+        if side in {"top", "bottom"}:
+            max_extra = MAX_SIDE - fw
+            if max_extra < 2:
+                return None
+            ext_left = random.randint(1, max_extra - 1)
+            ext_right = random.randint(1, max_extra - ext_left)
+            c0 = fc0 - ext_left
+            c1 = fc1 + ext_right
+            if not (0 <= c0 < c1 < w):
+                continue
+
+            if side == "top":
+                r0 = random.randint(fr0 + 1, fr1 - 1)
+                r1 = fr1 + random.randint(1, 3)
+            else:
+                r1 = random.randint(fr0 + 1, fr1 - 1)
+                r0 = fr0 - random.randint(1, 3)
+            if not (0 <= r0 < r1 < h):
+                continue
+            if not (MIN_SIDE <= r1 - r0 + 1 <= MAX_SIDE):
+                continue
+            return (r0, c0, r1, c1)
+
+        max_extra = MAX_SIDE - fh
+        if max_extra < 2:
+            return None
+        ext_up = random.randint(1, max_extra - 1)
+        ext_down = random.randint(1, max_extra - ext_up)
+        r0 = fr0 - ext_up
+        r1 = fr1 + ext_down
+        if not (0 <= r0 < r1 < h):
+            continue
+
+        if side == "left":
+            c0 = random.randint(fc0 + 1, fc1 - 1)
+            c1 = fc1 + random.randint(1, 3)
+        else:
+            c1 = random.randint(fc0 + 1, fc1 - 1)
+            c0 = fc0 - random.randint(1, 3)
+        if not (0 <= c0 < c1 < w):
+            continue
+        if not (MIN_SIDE <= c1 - c0 + 1 <= MAX_SIDE):
+            continue
