+
+        if side == "left":
+            c0 = random.randint(fc0 + 1, fc1 - 1)
+            c1 = fc1 + random.randint(1, 2)
+        else:
+            c1 = random.randint(fc0 + 1, fc1 - 1)
+            c0 = fc0 - random.randint(1, 2)
+        if not (0 <= c0 < c1 < w):
+            continue
+        if not (MIN_SIDE <= c1 - c0 + 1 <= MAX_SIDE):
+            continue
