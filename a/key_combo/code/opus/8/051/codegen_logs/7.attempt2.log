+def _side_box(front: Box, side: str, shape: tuple[int, int]) -> Box | None:
+    h, w = shape
+    fr0, fc0, fr1, fc1 = front
+    fh = fr1 - fr0 + 1
+    fw = fc1 - fc0 + 1
+
+    for _ in range(80):
+        if side in {"top", "bottom"}:
+            max_extra = MAX_SIDE - fw
+            if max_extra < 1:
+                return None
+            mode = random.choice(["left", "right"])
+            ext = random.randint(1, min(2, max_extra))
+            if mode == "left":
+                c0 = fc0 - ext
+                c1 = fc1
+            else:
+                c0 = fc0
+                c1 = fc1 + ext
+            if not (0 <= c0 < c1 < w):
