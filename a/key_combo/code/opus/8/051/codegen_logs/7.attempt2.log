+    frame_grid = _render_occluded_frames(shape, front_to_back)
+
+    if not _connected_boxes(boxes):
+        return False
+
+    for box in boxes:
+        full_count, partial_count = _visible_side_profile(frame_grid, box)
+        if full_count < 3 or partial_count > 1:
+            return False
