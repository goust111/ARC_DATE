+def _interiors_overlap(a: Box, b: Box) -> bool:
+    ar0, ac0, ar1, ac1 = a[0] + 1, a[1] + 1, a[2] - 1, a[3] - 1
+    br0, bc0, br1, bc1 = b[0] + 1, b[1] + 1, b[2] - 1, b[3] - 1
