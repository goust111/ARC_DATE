+    marker = _choose_marker((h, w), boxes, centers, prefer_tie=random.random() < 0.35)
+    if marker is None:
+        return None
+
+    back = boxes[1:]
+    random.shuffle(back)
+    front_to_back = [front] + back
+    return (h, w), boxes, front_to_back, marker
