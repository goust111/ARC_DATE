+
+def _choose_marker(
+    shape: tuple[int, int], boxes: list[Box], centers: list[tuple[int, int]], prefer_tie: bool
+) -> tuple[int, int] | None:
+    forbidden = set()
+    for box in boxes:
+        forbidden |= _footprint_cells(box)
