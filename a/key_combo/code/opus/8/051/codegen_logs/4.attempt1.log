+def _generate_case(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    qh = int(rng.integers(MIN_QUAD, MAX_QUAD + 1))
+    qw = int(rng.integers(MIN_QUAD, MAX_QUAD + 1))
