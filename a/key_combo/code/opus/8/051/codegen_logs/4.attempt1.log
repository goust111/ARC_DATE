+    for _ in range(LOCAL_SHORTCUT_FREE_ATTEMPTS):
+        c_area = int(rng.integers(4, MAX_PIXELS + 1))
+        result = _random_connected_mask(rng, qh, qw, c_area)
+        pairs = _operand_pairs_for_result(result)
