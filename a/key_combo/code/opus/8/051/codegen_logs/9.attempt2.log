+    box_w = _randint(BOX_W_RANGE[0], min(BOX_W_RANGE[1], w - 2))
+    r0 = _randint(1, h - box_h - 1)
+    c0 = _randint(1, w - box_w - 1)
+    r1 = r0 + box_h - 1
+    c1 = c0 + box_w - 1
