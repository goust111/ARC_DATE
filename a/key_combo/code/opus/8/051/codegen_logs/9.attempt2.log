+
+def _validate_example(grid: np.ndarray, expect_flip: bool) -> bool:
+    marker_mask = grid == MARKER
+    marker_count = int(np.count_nonzero(marker_mask))
+    if not MARKER_COUNT_RANGE[0] <= marker_count <= MARKER_COUNT_RANGE[1]:
+        return False
