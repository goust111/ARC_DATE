+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+MARKER = 8
+
+INPUT_COLORS = (1, 2, 3, 6, 7, 9)
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+BOX_H_RANGE = (6, 10)
+BOX_W_RANGE = (6, 10)
