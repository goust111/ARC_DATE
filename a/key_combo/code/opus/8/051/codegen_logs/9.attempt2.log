+    max_count = max(counts.values())
+    winners = [color for color, count in counts.items() if count == max_count]
+    assert len(winners) == 1, "expected a unique local majority color"
+    majority = winners[0]
+
+    out = g.copy()
+    box = out[r0 : r1 + 1, c0 : c1 + 1]
