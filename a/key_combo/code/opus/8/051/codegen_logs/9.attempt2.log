+    for r, c in np.argwhere(marker_mask):
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
+                if int(grid[nr, nc]) not in (BLACK, MARKER):
+                    return False
+
