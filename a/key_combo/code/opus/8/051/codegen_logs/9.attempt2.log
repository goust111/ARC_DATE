+    counts = _inside_color_counts(window)
+    if len(counts) != 3:
+        return False
+    if len(set(counts.values())) != 3:
+        return False
+    if int(np.count_nonzero(window == BLACK)) < MIN_INSIDE_BLACK:
+        return False
