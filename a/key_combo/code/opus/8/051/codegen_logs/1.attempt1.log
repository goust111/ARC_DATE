+    saw_odd_lr = False
+    saw_even_tb = False
+    has_odd = False
+    has_even = False
+    seen_keys = set()
+    bboxes = []
+    for comp in comps:
+        bbox = comp["bbox"]
+        bboxes.append(bbox)
