+
+def _bbox_min_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    if a[2] < b[0]:
+        dr = b[0] - a[2] - 1
+    elif b[2] < a[0]:
+        dr = a[0] - b[2] - 1
+    else:
+        dr = 0
+    if a[3] < b[1]:
+        dc = b[1] - a[3] - 1
+    elif b[3] < a[1]:
+        dc = a[1] - b[3] - 1
+    else:
+        dc = 0
+    if dr == 0:
+        return int(dc)
+    if dc == 0:
+        return int(dr)
+    return int(dr + dc)
