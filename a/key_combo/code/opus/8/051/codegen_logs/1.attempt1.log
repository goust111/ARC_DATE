+        side, k = _marker_side_and_count(g, bbox)
+        reflected_boundary = _reflect(boundary_mask, side, k, axis_mode)
+        reflected_interior = _reflect(interior_mask, side, k, axis_mode)
+        top, left = _replica_origin(bbox, patch.shape, side)
