GEN_LR_FRAME_HEIGHTS = (3, 5)
GEN_LR_FRAME_WIDTH_RANGE = (3, 6)
GEN_TB_FRAME_HEIGHT_RANGE = (3, 5)
GEN_TB_FRAME_WIDTHS = (3, 5)

# Placement and validation.
