+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        q = deque([(rr, cc)])
+        seen[rr, cc] = True
+        cells = []
+        while q:
+            cr, cc2 = q.popleft()
+            cells.append((cr, cc2))
+            for dr, dc in DIR4:
+                nr = cr + dr
+                nc = cc2 + dc
