+
+
+def _replica_colored_cells(
+    boundary_mask: np.ndarray,
+    side: str,
+    k: int,
+    bbox: tuple[int, int, int, int],
+) -> tuple[list[tuple[int, int]], tuple[int, int, int, int]]:
