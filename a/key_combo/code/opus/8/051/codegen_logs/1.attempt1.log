import numpy as np
DIR4=[(-1,0),(1,0),(0,-1),(0,1)]

def comps(mask):
    seen=np.zeros(mask.shape,dtype=bool)
    n=0
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]:
            continue
        n+=1
        q=deque([(r,c)]); seen[r,c]=True
        while q:
            rr,cc=q.popleft()
            for dr,dc in DIR4:
