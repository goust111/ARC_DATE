+        else:
+            has_even = True
+            if side in {"top", "bottom"}:
+                saw_even_tb = True
+
+    for i, bbox_a in enumerate(bboxes):
+        for bbox_b in bboxes[i + 1 :]:
+            if _bbox_min_gap(bbox_a, bbox_b) < GEN_BBOX_GAP:
+                return False
