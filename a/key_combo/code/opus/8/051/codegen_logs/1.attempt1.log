    for r,c in np.argwhere(mask):
        deg=0
        for dr,dc in DIR4:
            nr=int(r)+dr; nc=int(c)+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc]: deg+=1
        if deg!=2: return False
    return True

def path_mask(vertices):
