+            mask = spec["shape"]
+            for r, c in np.argwhere(mask):
+                grid[r0 + int(r), c0 + int(c)] = GREEN
+                occupied[r0 + int(r), c0 + int(c)] = True
+            for r, c in chosen["marker_cells"]:
+                grid[r, c] = RED
+                occupied[r, c] = True
