                if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=True; q.append((nr,nc))
    return n

def interior(boundary_mask):
    h,w=boundary_mask.shape
    passable=~boundary_mask
    outside=np.zeros((h,w),dtype=bool)
    q=deque()
    for r in range(h):
        for c in (0,w-1):
            if passable[r,c] and not outside[r,c]: outside[r,c]=True; q.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if passable[r,c] and not outside[r,c]: outside[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr=r+dr; nc=c+dc
            if 0<=nr<h and 0<=nc<w and passable[nr,nc] and not outside[nr,nc]: outside[nr,nc]=True; q.append((nr,nc))
    return passable & ~outside

def degree_two(mask):
