+        comps.append(
+            {
+                "coords": coords,
+                "bbox": _bbox_from_coords(coords),
+                "area": int(len(cells)),
+            }
+        )
+    return comps
+
+
+def _interior_mask(boundary_mask: np.ndarray) -> np.ndarray:
