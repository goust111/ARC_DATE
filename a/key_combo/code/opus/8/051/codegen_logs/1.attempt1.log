+    occupied: np.ndarray,
+    object_bboxes: list[tuple[int, int, int, int]],
+    pair_bboxes: list[tuple[int, int, int, int]],
+) -> list[dict]:
+    H, W = grid_shape
+    mask = spec["shape"]
+    h, w = mask.shape
+    side = spec["side"]
+    k = spec["k"]
+    span = int(w if side in {"top", "bottom"} else h)
+    out = []
+    for r0 in range(H - h + 1):
