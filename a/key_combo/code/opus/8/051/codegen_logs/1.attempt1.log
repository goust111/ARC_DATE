+GEN_SHAPES = _shape_variants()
+GEN_ROWS = (18, 25)
+GEN_COLS = (20, 27)
+GEN_ATTEMPTS = 600
+GEN_BBOX_GAP = 5
+GEN_PAIR_GAP = 2
