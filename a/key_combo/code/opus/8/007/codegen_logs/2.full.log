            start = (9, 0)
            goal = (random.choice(TURN7_N10_GOAL_ROWS), 9)
    return n, lengths, start, goal


def _gen_four_wall_slalom(turn_target: int) -> np.ndarray:
    n, lengths, start, goal = _gen_four_wall_layout(turn_target)
    g = np.zeros((n, n), dtype=int)
