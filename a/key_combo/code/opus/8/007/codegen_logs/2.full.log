+    expected = {(int(r0), int(c0)), (int(r0), int(c1)), (int(r1), int(c0)), (int(r1), int(c1))}
+    assert {tuple(map(int, rc)) for rc in grey} == expected, "grey marker must be a solid 2x2 block"
+    return int(r0), int(c0)
