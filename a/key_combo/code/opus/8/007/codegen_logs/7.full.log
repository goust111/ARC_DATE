+) -> list[tuple[int, int]]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    er0 = max(0, r0 - 1)
+    ec0 = max(0, c0 - 1)
+    er1 = min(h - 1, r1 + 1)
+    ec1 = min(w - 1, c1 + 1)
