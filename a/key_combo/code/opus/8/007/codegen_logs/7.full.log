+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) in MARKER_COLORS:
