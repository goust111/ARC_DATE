+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _bresenham_line(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dr - dc
+
+    pts: list[tuple[int, int]] = []
+    while True:
+        pts.append((r0, c0))
+        if r0 == r1 and c0 == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dc:
+            err -= dc
+            r0 += sr
+        if e2 < dr:
+            err += dr
+            c0 += sc
+    return pts
+
+
+def _axis_line(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = map(int, a)
+    r1, c1 = map(int, b)
+    if r0 == r1:
+        step = 1 if c0 <= c1 else -1
+        return [(r0, c) for c in range(c0, c1 + step, step)]
+    if c0 == c1:
+        step = 1 if r0 <= r1 else -1
+        return [(r, c0) for r in range(r0, r1 + step, step)]
+    raise AssertionError("expected an axis-aligned segment")
+
