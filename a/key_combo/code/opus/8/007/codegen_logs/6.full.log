+def _triangle_edge_pixels(grid: np.ndarray) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    grey_set, missing_corner, adjacent_corners = _extract_grey_structure(grid)
+    edge_pixels: set[tuple[int, int]] = set()
