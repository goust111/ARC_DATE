def bbox_anchor(b: BBox, *, anchor: str = "upper left") -> Coord:
    """
    Return an anchor point (r,c) for a bbox.

    anchor:
        upper left/right, lower left/right,
        center,
        upper center, lower center,
        left center, right center
    """
