+            if min(trimmed.shape) < 2:
+                continue
+            if not _is_connected(trimmed, connectivity=4):
+                continue
+            key = (trimmed.shape, tuple(tuple(int(v) for v in row) for row in trimmed.astype(int)))
+            if key not in seen:
+                seen.add(key)
