    out = g.copy()
    for bar in bars:
        coords = bar["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

    for bar in bars:
        br0, bc0, br1, bc1 = bar["bbox"]
        bar_h = br1 - br0 + 1
        bar_w = bc1 - bc0 + 1

