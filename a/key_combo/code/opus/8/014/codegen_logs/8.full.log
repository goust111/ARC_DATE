+        height = r1 - r0 + 1
+        assert height % 2 == 0, "object bbox height must be even"
+        assert len(obj["colors"]) == 2, "object must be bicolor"
+        span = (c0, c1)
+        assert span not in span_to_object, "column spans must pair uniquely"
+        span_to_object[span] = obj
