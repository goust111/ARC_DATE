    bars = []
    for component in components:
        r0, c0, r1, c1 = component["bbox"]
        height = r1 - r0 + 1
        width = c1 - c0 + 1
        if (height == 1) ^ (width == 1):
            assert component["area"] == height * width
            bars.append(component)
        else:
            assert height > 1 and width > 1
            sprites.append(component)

    assert sprites
