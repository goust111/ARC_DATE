+                continue
+            if mode == "checker":
+                choose_a = (r + c + phase) % 2 == 0
+            else:
+                choose_a = (c + phase) % 2 == 0
+            patch[r, c] = color_a if choose_a else color_b
+    used = set(int(v) for v in patch[patch != 0])
+    assert used == {int(color_a), int(color_b)}
+    return patch
