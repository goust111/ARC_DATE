+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or int(grid[sr, sc]) in (BG, BAR):
+                continue
+            queue = deque([(sr, sc)])
+            seen[sr, sc] = True
+            cells = []
+            colors = set()
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                colors.add(int(grid[r, c]))
