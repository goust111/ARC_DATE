+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or int(grid[sr, sc]) != int(color):
+                continue
+            queue = deque([(sr, sc)])
+            seen[sr, sc] = True
+            cells = []
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
