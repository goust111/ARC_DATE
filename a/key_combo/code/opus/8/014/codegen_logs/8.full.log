+    assert used == {int(color_a), int(color_b)}
+    return patch
+
+
+def _transform_patch(patch: np.ndarray, direction: str, gap: int) -> tuple[np.ndarray, int]:
+    h, w = patch.shape
+    half_h = h // 2
+    assert h % 2 == 0
+    colors = sorted(set(int(v) for v in patch[patch != 0]))
+    assert len(colors) == 2
