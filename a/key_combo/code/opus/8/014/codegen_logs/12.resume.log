+
+    if side == "left":
+        cols = [0]
+    elif side == "right":
+        cols = [gw - w]
+    elif interior:
+        if gw - w < 2:
+            return False
+        cols = range(1, gw - w)
+    else:
+        cols = range(0, gw - w + 1)
+
