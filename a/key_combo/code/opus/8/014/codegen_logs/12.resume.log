    r0, c0, r1, c1 = b

    crop = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
    crop[mask[r0 : r1 + 1, c0 : c1 + 1]] = int(color)
    return crop


def main(grid: np.ndarray) -> np.ndarray:
