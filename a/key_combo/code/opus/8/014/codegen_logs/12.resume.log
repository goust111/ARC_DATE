+
+def _rect_has_gap(rect: tuple[int, int, int, int], rects: list[tuple[int, int, int, int]], gap: int = RECT_GAP) -> bool:
+    r0, c0, r1, c1 = rect
+    for rr0, cc0, rr1, cc1 in rects:
