+
+    matches = _match_chambers_and_objects(inp)
+    if len(matches) not in (3, 4):
+        return False
+
+    for chamber, obj in matches:
+        r0, c0, r1, c1 = chamber["bbox"]
+        width = int(obj["width"])
+        row = int(obj["bbox"][0])
