+    placed = _place_objects((h, w), objects, rng)
+    if placed is None:
+        return None
+    inp, expected = placed
+    if not _validate_generated(inp, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
