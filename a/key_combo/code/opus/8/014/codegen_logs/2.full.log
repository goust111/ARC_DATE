+def _random_path(a: tuple[int, int], b: tuple[int, int], rng: np.random.Generator) -> list[tuple[int, int]]:
+    r, c = a
+    path = [(r, c)]
+    while (r, c) != b:
+        options = []
+        if r < b[0]:
+            options.append((r + 1, c))
+        if r > b[0]:
+            options.append((r - 1, c))
+        if c < b[1]:
+            options.append((r, c + 1))
+        if c > b[1]:
+            options.append((r, c - 1))
+        r, c = options[int(rng.integers(len(options)))]
+        path.append((r, c))
