+
+
+def _input_mask_ok(blocked: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    hh, ww = blocked.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
