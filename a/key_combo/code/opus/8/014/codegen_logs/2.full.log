    h = max(r for r, _ in coords) + 1
    w = max(c for _, c in coords) + 1
    patch = np.full((h, w), BG_COLOR, dtype=int)
    rr, cc = np.array(coords, dtype=int).T
    patch[rr, cc] = int(color)
    return patch


