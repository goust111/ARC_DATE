+        alt = "horizontal" if info["fracture"] == "vertical" else "vertical"
+        wrong_axis, _ = _tile_render(inp.shape, info["body"], alt, r0, c0, bg=BG)
+        with_line, _ = _tile_render(inp.shape, info["crop"], info["fracture"], r0, c0, bg=BG)
