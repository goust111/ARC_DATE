+
+def _paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+    clip: bool = False,
+) -> np.ndarray:
+    h, w = patch.shape
+    hh, ww = dst.shape
+    r0 = int(r0)
+    c0 = int(c0)
+
+    if not clip:
+        if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+            raise ValueError("patch out of bounds")
+        rr0, cc0, rr1, cc1 = r0, c0, r0 + h, c0 + w
+        pr0, pc0 = 0, 0
+    else:
