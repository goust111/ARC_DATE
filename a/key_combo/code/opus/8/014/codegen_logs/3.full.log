+def _axis_period(arr: np.ndarray, axis: int) -> int:
+    length = arr.shape[axis]
+    if axis == 0:
+        for p in range(1, length + 1):
+            if all(np.array_equal(arr[r], arr[r % p]) for r in range(length)):
+                return p
+    else:
+        for p in range(1, length + 1):
