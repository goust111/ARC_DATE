+def _make_periodic_pattern(rng: np.random.Generator, h: int, w: int) -> tuple[np.ndarray, tuple[int, int]]:
+    colors = tuple(int(x) for x in rng.choice(PALETTE, size=2, replace=False))
+    mode = rng.choice(["rows", "cols", "grid"])
+    for _ in range(200):
