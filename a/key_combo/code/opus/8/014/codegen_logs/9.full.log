+    if len(changed) == 0:
+        return False
+    if np.any(changed[:, 1] <= divider_col):
+        return False
+    return True
+
+
+def _generate_one() -> np.ndarray | None:
+    height = random.randint(*GRID_H_RANGE)
+    width = random.randint(*GRID_W_RANGE)
+    left_w = random.randint(*LEFT_W_RANGE)
+    if left_w >= width - 5:
+        return None
+
+    regions = random.randint(2, 5)
