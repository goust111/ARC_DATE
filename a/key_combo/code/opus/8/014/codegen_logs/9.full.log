+        for r, c in spec["orig_cells"]:
+            out[r, c] = BLACK
+    for spec in specs:
+        for r, c in spec["dst_cells"]:
+            out[r, c] = int(spec["color"])
+    return out
+
+
+def _validate_instance(inp: np.ndarray, out: np.ndarray, regions: int, specs: list[dict], divider_col: int) -> bool:
