+                        "color": color,
+                        "orientation": orientation,
+                        "shape": shape.copy(),
+                        "origin": (r0, divider_col + 1 + c0),
+                        "orig_cells": global_orig,
+                        "dst_cells": global_dst,
+                    }
+                )
+                existing_originals.append(global_orig)
+                occupied_all.update(global_orig)
+                occupied_all.update(global_dst)
+                placed = True
+                break
+            if placed:
