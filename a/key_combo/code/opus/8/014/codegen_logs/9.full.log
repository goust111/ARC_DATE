+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while queue:
