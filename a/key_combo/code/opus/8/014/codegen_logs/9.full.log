+    random.shuffle(orientations)
+
+    colors = random.sample(SPRITE_COLORS, sprite_count)
+    canvas = np.zeros((height, width), dtype=int)
+    specs = []
+    existing_originals: list[list[tuple[int, int]]] = []
+    occupied_all: set[tuple[int, int]] = set()
