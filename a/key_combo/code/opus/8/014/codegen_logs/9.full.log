+def _make_left_barrier(height: int, left_w: int, regions: int) -> np.ndarray | None:
+    arms = regions - 2
+    if left_w < 6 or height < 8:
+        return None
+    for _ in range(100):
+        spine_col = random.randint(2, left_w - 3)
