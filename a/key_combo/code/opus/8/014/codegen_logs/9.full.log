        mask = g == color
        for r in range(h):
            c = -1
            while c + 1 < w and mask[r, c + 1]:
                c += 1
            if r >= 2 and c >= 3 and mask[: r + 1, c].all():
                candidates.append((int(color), int(r), int(c)))

    assert len(candidates) == 1, "expected one L-shaped divider touching the top and left edges"
