+                if random.random() < 0.18:
+                    seed[r, c] = BG
+        elif row_kind == "sparse":
+            cols = random.sample(range(width), random.randint(max(3, width // 3), max(4, width - 1)))
+            for c in cols:
+                seed[r, c] = random.choice([BLUE, RED])
+        else:
+            for c in range(width):
+                roll = random.random()
+                if roll < 0.34:
+                    seed[r, c] = BG
+                elif roll < 0.67:
+                    seed[r, c] = BLUE
+                else:
+                    seed[r, c] = RED
