    occupied = canvas != Color.BLACK
    forbidden = occupied.copy()
    forbidden[1:, :] |= occupied[:-1, :]
    forbidden[:-1, :] |= occupied[1:, :]
    forbidden[:, 1:] |= occupied[:, :-1]
    forbidden[:, :-1] |= occupied[:, 1:]
    return forbidden


