            origins.append((r, c0))
            r += _GEN_MOTIF_SIZE
    elif direction == "left":
        c = c0
        while c + _GEN_MOTIF_SIZE - 1 >= 0:
            origins.append((r0, c))
            c -= _GEN_MOTIF_SIZE
    else:
