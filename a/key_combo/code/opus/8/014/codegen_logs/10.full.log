+def _tiled_seed(seed: np.ndarray, out_shape: tuple[int, int]) -> np.ndarray:
+    period = int(seed.shape[0])
+    height, _width = out_shape
+    out = np.empty(out_shape, dtype=int)
+    for r in range(height):
+        out[r] = seed[r % period]
+    return out
