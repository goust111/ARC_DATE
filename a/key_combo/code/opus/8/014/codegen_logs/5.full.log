+
+
+def _semantic_check(inp: np.ndarray) -> bool:
+    try:
+        out = main(inp)
+    except Exception:
+        return False
+
+    if inp.ndim != 2 or out.ndim != 2 or max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+
+    bg = int(get_bg(inp))
+    if bg != BACKGROUND:
