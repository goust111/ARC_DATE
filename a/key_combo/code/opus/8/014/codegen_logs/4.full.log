+
+def _candidate_positions(
+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    blocked: np.ndarray,
+    patch: np.ndarray,
+    mid: int,
+    *,
+    side: str | None = None,
+    near_axis: bool | None = None,
