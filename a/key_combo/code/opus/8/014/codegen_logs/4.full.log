+    h, w = shape
+    ph, pw = patch.shape
+    rows, cols = np.where(patch != BG)
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            abs_cols = cols + c0
+            if side == "left" and np.any(abs_cols >= mid):
