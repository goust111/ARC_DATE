+    for r, c in zip(abs_rows, abs_cols):
+        r0n = max(0, int(r) - 1)
+        r1n = min(h, int(r) + 2)
+        c0n = max(0, int(c) - 1)
+        c1n = min(w, int(c) + 2)
+        if np.any(occupied[r0n:r1n, c0n:c1n]):
+            return False
+    return True
+
+
+def _candidate_positions(
+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    blocked: np.ndarray,
+    patch: np.ndarray,
+    mid: int,
