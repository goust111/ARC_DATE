0008:     """Collapse the right-edge palette into one vertical coded bar using the grey marker height as the per-color run length.
0009: 
0010:     Input structure
0011:     The grid has a dominant background, one top-aligned vertical grey marker
0012:     segment, and a contiguous set of full-height non-background palette columns
0013:     at the right edge. The column immediately to the left of the palette is
0014:     background.
0015: 
0016:     Rule
0017:     Read the palette columns left-to-right. Erase those palette columns, then
0018:     fill the adjacent background column with the palette colors from top to
0019:     bottom, repeating each palette color for as many rows as the grey marker
0020:     segment is tall and cycling through the palette until the grid ends.
0021: 
0022:     Key insight
0023:     The grey segment is not copied; its height is the run-length instruction
0024:     for expanding the ordered right-edge palette into the new vertical bar.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     assert g.ndim == 2
0028:     H, W = g.shape
0029: 
0030:     bg = get_bg(g)
0031: 
0032:     marker_mask = g == Color.GREY
0033:     marker_coords = np.argwhere(marker_mask)
0034:     assert marker_coords.size > 0, "expected a grey marker segment"
0035:     marker_cols = np.unique(marker_coords[:, 1])
0036:     assert len(marker_cols) == 1, "grey marker must occupy one column"
0037:     marker_col = int(marker_cols[0])
0038: 
0039:     marker_rows = np.sort(np.unique(marker_coords[:, 0]))
0040:     run_len = len(marker_rows)
0041:     assert run_len == int(marker_mask.sum()), "grey marker must be one pixel wide"
0042:     assert np.array_equal(marker_rows, np.arange(run_len)), "grey marker must be top-aligned"
0043:     assert np.all(g[run_len:, marker_col] == bg), "marker column below marker must be background"
0044: 
0045:     palette_cols = []
0046:     palette = []
0047:     for c in range(W):
0048:         values = np.unique(g[:, c])
0049:         if len(values) != 1:
0050:             continue
0051:         color = int(values[0])
0052:         if color != bg and color != Color.GREY:
0053:             palette_cols.append(c)
0054:             palette.append(color)
0055: 
0056:     assert palette_cols, "expected full-height palette columns"
0057:     assert palette_cols == list(range(palette_cols[0], W)), "palette must be contiguous at right edge"
0058: 
0059:     target_col = palette_cols[0] - 1
0060:     assert target_col >= 0, "palette must have a background column to its left"
0061:     assert np.all(g[:, target_col] == bg), "target column must start as background"
0062: 
0063:     structural_mask = (g == bg) | marker_mask
0064:     structural_mask[:, palette_cols] = True
0065:     assert np.all(structural_mask), "unexpected foreground outside marker and palette"
0066: 
0067:     out = g.copy()
0068:     out[:, palette_cols] = bg
0069:     out[:, target_col] = [palette[(r // run_len) % len(palette)] for r in range(H)]
0070:     return out
