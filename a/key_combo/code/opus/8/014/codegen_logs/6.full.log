0027:     row_has_fg = np.any(g != bg, axis=1)
0028:     assert np.any(row_has_fg), "expected a bottom foreground motif"
0029:     top = int(np.flatnonzero(row_has_fg)[0])
0030:     assert top > 0, "expected background rows above the motif"
0031:     assert np.all(row_has_fg[top:]), "motif rows must be contiguous through the bottom"
0032: 
0033:     motif = g[top:].copy()
0034:     motif_h = int(motif.shape[0])
0035: 
0036:     out = np.empty_like(g)
0037:     for r in range(g.shape[0]):
0038:         out[r] = motif[(int(r) - top) % motif_h]
0039:     return out
