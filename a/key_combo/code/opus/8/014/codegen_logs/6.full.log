0075: MIN_GAP, MAX_WIDTH, FIXED_LAYOUT_COLS = 1, 9, 2
0076: # Color choices and retry budget.
0077: PALETTE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
0078: BG_COLOR, MARKER_COLOR = 0, 5
0079: GEN_RETRY_LIMIT = 300
