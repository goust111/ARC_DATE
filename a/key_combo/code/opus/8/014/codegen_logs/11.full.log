+            raise AssertionError(f"unknown side {side}")
+    else:
+        half = np.ones((r1 - r0 - 1, c1 - c0 - 1), dtype=bool)
+
+    if use_parity:
+        dist = np.maximum(np.abs(rr - rm), np.abs(cc - cm))
+        return half & (dist % 2 == 0)
