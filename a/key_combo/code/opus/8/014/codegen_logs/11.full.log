+def _transform(
+    grid: np.ndarray,
+    *,
+    use_parity: bool = True,
+    directional_half: bool = True,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    frame_bbox, side_colors = _infer_frame(g)
+    color_to_side = {color: side for side, color in side_colors.items()}
