+    inner = out[frame_bbox[0] + 1:frame_bbox[2], frame_bbox[1] + 1:frame_bbox[3]]
+    colored_fraction = float(np.count_nonzero(inner)) / float(inner.size)
+    return 0.18 <= colored_fraction <= 0.72
+
