+
+def _direction_candidates(
+    frame_bbox: tuple[int, int, int, int], side: str
+) -> list[tuple[int, int]]:
+    rows, cols = _safe_ranges(frame_bbox)
+    assert rows and cols
+    mid_r = (rows[0] + rows[-1]) // 2
+    mid_c = (cols[0] + cols[-1]) // 2
