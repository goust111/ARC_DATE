+    inset_left = random.randint(0, 2)
+    inset_bottom = random.randint(0, 2)
+    inset_right = random.randint(0, 2)
+    frame_bbox = (
+        inset_top,
+        inset_left,
+        height - 1 - inset_bottom,
+        width - 1 - inset_right,
+    )
+    if frame_bbox[2] - frame_bbox[0] < 10 or frame_bbox[3] - frame_bbox[1] < 10:
+        return None
+
