+    overlap = 0
+    for i in range(len(masks)):
+        for j in range(i + 1, len(masks)):
+            pair_overlap = int(np.sum(masks[i] & masks[j]))
+            if pair_overlap > min(areas[i], areas[j]) // 4 + 2:
+                return False
+            overlap += pair_overlap
