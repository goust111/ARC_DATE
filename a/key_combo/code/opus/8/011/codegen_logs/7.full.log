+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+SIDES_3 = [
+    ("top", "bottom", "left"),
+    ("top", "bottom", "right"),
+    ("top", "left", "right"),
+    ("bottom", "left", "right"),
+]
+SIDES_4 = [("top", "bottom", "left", "right")]
+SIZE_CHOICES = [
+    (3, 3),
+    (3, 4),
+    (4, 3),
+    (4, 4),
+    (3, 5),
+    (5, 3),
+    (4, 5),
+    (5, 4),
+]
+MAX_GEN_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _colors_present(grid: np.ndarray, exclude=None) -> list[int]:
+    colors = set(map(int, np.unique(grid)))
+    if exclude is not None:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _paint_rect(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+
+
+def _expand_blocked(blocked: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    h, w = blocked.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
+    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _marker_direction(marker: tuple[int, int], bbox: tuple[int, int, int, int]) -> str | None:
+    mr, mc = marker
+    r0, c0, r1, c1 = bbox
+    if mr < r0 and c0 <= mc <= c1:
+        return "up"
+    if mr > r1 and c0 <= mc <= c1:
+        return "down"
+    if mc < c0 and r0 <= mr <= r1:
+        return "left"
+    if mc > c1 and r0 <= mr <= r1:
+        return "right"
+    return None
+
+
+def _stretch_to_target(bbox: tuple[int, int, int, int], marker: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
+    direction = _marker_direction(marker, bbox)
+    assert direction is not None
+    if direction == "up":
