+def _choose_bonuses(areas: list[int]) -> list[int] | None:
+    base = [area + 1 for area in areas]
+    area_order = tuple(np.argsort(base, kind="mergesort"))
+    for _ in range(200):
+        bonuses = [random.randint(0, 8) for _ in base]
