+        return False
+    if not _reverse_order_changes(grid, meta):
+        return False
+    areas = [obj["area"] for obj in meta]
+    totals = [obj["total"] for obj in meta]
+    if tuple(np.argsort(areas, kind="mergesort")) == tuple(np.argsort(totals, kind="mergesort")):
+        return False
+    return True
