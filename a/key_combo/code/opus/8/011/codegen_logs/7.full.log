+                for r, c in _free_singleton_cells(grid)
+                if not (r0 <= r <= r1 or c0 <= c <= c1)
+            ]
+            if not cells:
+                return False
+            r, c = random.choice(cells)
+            grid[r, c] = spec["color"]
+    return True
