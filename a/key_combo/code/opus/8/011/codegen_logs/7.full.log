+            r0 = max(0, r - 1)
+            c0 = max(0, c - 1)
+            r1 = min(h - 1, r + 1)
+            c1 = min(w - 1, c + 1)
+            if np.any(grid[r0 : r1 + 1, c0 : c1 + 1] != BG):
