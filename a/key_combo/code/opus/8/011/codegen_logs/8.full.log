+def _smallest_period(seq: tuple[int, ...]) -> int:
+    n = len(seq)
+    for period in range(1, n + 1):
+        if n % period != 0:
+            continue
+        if all(seq[idx] == seq[idx % period] for idx in range(n)):
+            return period
+    return n
