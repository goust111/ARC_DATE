PERIOD_CHOICES = (2, 3, 4)
SIZE_CHOICES = (11, 13, 15, 17, 19, 21)
PALETTE = tuple(range(1, 10))
MAX_GENERATION_ATTEMPTS = 400


def _find_cross_center(grid: np.ndarray, bg: int) -> tuple[int, int]:
    h, w = map(int, grid.shape)
