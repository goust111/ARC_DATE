+    g = info["grid"]
+    bg = info["bg"]
+    sprite_patch = info["sprite_patch"]
+    red_local = info["red_local"]
+    side = info["indicator_side"]
+    sprite_comp = info["sprite_comp"]
+    placeholders = info["placeholders"]
