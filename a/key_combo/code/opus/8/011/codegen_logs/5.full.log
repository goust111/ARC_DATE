+            while 0 <= nr < H and 0 <= nc < W:
+                if base[nr, nc] != bg:
+                    break
+                out[nr, nc] = Color.RED
+                nr += dr
+                nc += dc
+    return out
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    stack = [start]
