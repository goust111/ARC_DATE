+        start = random.randint(1, height - 1 - span)
+        width = random.randint(11, 16)
+        track_line = random.randint(3, width - 4)
+        grid = np.full((height, width), BG, dtype=int)
+        slots = [start + step * idx for idx in range(n_slots)]
+        for row in slots:
