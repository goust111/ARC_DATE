+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        pattern = _choose_pattern()
+        grid = _place_track_and_objects(pattern)
+        if grid is None:
+            continue
+        if not _scatter_noise(grid):
+            continue
+        if _validate_generated(grid):
