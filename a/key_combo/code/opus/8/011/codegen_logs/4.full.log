+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+OBJECT_COLORS = (1, 2, 3, 4)
+TRACK_COLOR = 5
+NOISE_COLOR = 7
+
+BASE_SHAPES = (
+    ((1, 0), (2, 0)),
+    ((1, 0), (2, 0), (2, 1)),
+    ((1, 0), (2, 0), (2, -1)),
+    ((1, 0), (2, 0), (3, 0)),
+    ((1, 0), (2, 0), (3, 0), (2, 1)),
+    ((1, 0), (2, 0), (3, 0), (2, -1)),
+)
+END_SAFE_SHAPES = (
+    ((1, 0), (2, 0)),
+    ((1, 0), (2, 0), (3, 0)),
+)
+
+MAX_GENERATION_ATTEMPTS = 500
