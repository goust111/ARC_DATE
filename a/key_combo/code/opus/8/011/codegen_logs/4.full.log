+    for pos, color in zip(unique_positions, unique_colors):
+        out[pos] = int(color)
+    return out
+
+
+def _pattern_move_info(pattern: str) -> tuple[set[int], dict[int, list[int]]]:
+    targets: dict[int, list[int]] = {}
