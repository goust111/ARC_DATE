+    return [(c, side * r) for r, c in base_shape]
+
+
+def _place_track_and_objects(pattern: str) -> np.ndarray | None:
+    orientation = random.choice(("h", "v"))
+    n_slots = len(pattern)
+    step = 4
+    span = step * (n_slots - 1)
+
+    if orientation == "h":
