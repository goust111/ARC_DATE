+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+OBJECT_COLORS = (1, 2, 3, 4)
+TRACK_COLOR = 5
+NOISE_COLOR = 7
+
+BASE_SHAPES = (
+    ((1, 0), (2, 0)),
+    ((1, 0), (2, 0), (2, 1)),
+    ((1, 0), (2, 0), (2, -1)),
+    ((1, 0), (2, 0), (3, 0)),
+    ((1, 0), (2, 0), (3, 0), (2, 1)),
+    ((1, 0), (2, 0), (3, 0), (2, -1)),
+)
+END_SAFE_SHAPES = (
+    ((1, 0), (2, 0)),
+    ((1, 0), (2, 0), (3, 0)),
+)
+
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _find_components(grid: np.ndarray, colors: tuple[int, ...]) -> list[dict]:
+    allowed = set(int(color) for color in colors)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color not in allowed:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if not _in_bounds(grid.shape, nr, nc) or seen[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                }
