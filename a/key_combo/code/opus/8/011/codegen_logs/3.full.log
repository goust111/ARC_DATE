+def _mirror_coords(coords: set[tuple[int, int]], axis: str, inner_h: int, inner_w: int) -> set[tuple[int, int]]:
+    mid_r = inner_h // 2
+    mid_c = inner_w // 2
+    mirrored = set(coords)
+    for r, c in coords:
