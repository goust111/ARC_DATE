+def _crosses_other_midline(coords: set[tuple[int, int]], axis: str, mid_r: int, mid_c: int) -> bool:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    if axis == "horizontal":
+        return not (all(c < mid_c for c in cols) or all(c > mid_c for c in cols))
