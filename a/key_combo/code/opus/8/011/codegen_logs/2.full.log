PROFILE_RETRIES = 120
BOTTOM_HEAVY_WEIGHT = 5
LOW_COLUMN_EXTRA_PROB = 0.35
LOW_COLUMN_HEIGHT2_PROB = 0.25
TALL_RUN_COUNT_MAX = 3
