+def _object_info(comp: dict) -> dict:
+    coords = comp["coords"]
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    return {
+        "kind": "object",
+        "color": int(comp["color"]),
+        "bbox": (r0, c0, r1, c1),
+        "coords": coords.copy(),
+        "shape": _normalize_coords(coords),
+    }
