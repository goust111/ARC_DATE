+def _safe_offsets(patch: np.ndarray) -> tuple[int, int]:
+    h, w = patch.shape
+    max_r = max(0, 3 - h)
+    max_c = max(0, 3 - w)
+    return random.randint(0, max_r), random.randint(0, max_c)
+
