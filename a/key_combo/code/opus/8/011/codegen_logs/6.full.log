  92: def _gen_can_place(grid, size, r0, c0, color):
  93:     height, width = grid.shape
  94:     r1, c1 = r0 + size, c0 + size
  95:     if r0 < 0 or c0 < 0 or r1 > height or c1 > width:
  96:         return False
  97:     if np.any(grid[r0:r1, c0:c1] != BG_COLOR):
  98:         return False
  99: 
 100:     color = int(color)
 101:     for rr in range(r0, r1):
 102:         for cc in range(c0, c1):
 103:             for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
 104:                 inside_object = r0 <= nr < r1 and c0 <= nc < c1
 105:                 if 0 <= nr < height and 0 <= nc < width and not inside_object:
 106:                     if int(grid[nr, nc]) == color:
 107:                         return False
 108:     return True
