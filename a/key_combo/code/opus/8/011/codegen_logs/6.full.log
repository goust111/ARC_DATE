  84:                 green_cells = BLOCK_SIZE * BLOCK_SIZE * n_green_blocks + green_pixels
  85:                 red_cells = BLOCK_SIZE * BLOCK_SIZE * red_blocks + red_pixels
  86:                 black_cells = height * width - green_cells - red_cells
  87:                 if black_cells > max(green_cells, red_cells):
  88:                     options.append((red_blocks, green_pixels, red_pixels))
