+def _break_one_full_square(diag: np.ndarray) -> np.ndarray:
+    broken = diag.copy()
+    full = _full_green_blocks(diag)
+    assert full, "expected at least one full green square to break"
+    rr, cc = map(int, full[0]["coords"][0])
+    broken[rr, cc] = BLACK
+    return broken
+
