  76: def _gen_count_options(n_green_blocks, height, width):
  77:     options = []
  78:     for red_blocks in RED_BLOCK_COUNTS:
  79:         for green_pixels in GREEN_PIXEL_COUNTS:
  80:             for red_pixels in RED_PIXEL_COUNTS:
  81:                 total_objects = n_green_blocks + red_blocks + green_pixels + red_pixels
  82:                 if not TOTAL_OBJECT_COUNT_RANGE[0] <= total_objects <= TOTAL_OBJECT_COUNT_RANGE[1]:
