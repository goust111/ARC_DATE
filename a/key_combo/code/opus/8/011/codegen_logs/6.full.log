  24: def main(grid: np.ndarray) -> np.ndarray:
  25:     """Move each rectangular object into the matching platform gap, rotating it so its two-cell side is vertical.
  26: 
  27:     Input structure
  28:     - The last row is a solid non-background platform color.
  29:     - The row above the platform contains only background and platform-color separator runs; background gaps between consecutive separator runs are slots.
  30:     - Every non-background, non-platform object above the shelf is a solid monochrome rectangle with one side of length two.
  31: 
  32:     Rule
  33:     - Clear those source rectangles from their original locations.
  34:     - Rotate a rectangle if needed so it is two rows tall.
  35:     - Place each normalized rectangle bottom-aligned with the shelf row inside the unique slot whose width matches the rectangle's normalized width.
  36: 
  37:     Key insight
  38:     - The platform separators encode target slot widths, while each source rectangle's non-two dimension encodes the slot it belongs in.
  39:     """
  40:     g = np.asarray(grid, dtype=int)
  41:     H = int(g.shape[0])
  42:     bg = get_bg(g)
  43: 
  44:     bottom_colors = set(map(int, g[H - 1]))
  45:     assert len(bottom_colors) == 1
  46:     platform = next(iter(bottom_colors))
  47:     assert platform != bg
  48: 
  49:     shelf = H - 2
  50:     assert shelf >= 1
  51:     assert set(map(int, g[shelf])) <= {bg, platform}
  52: 
  53:     runs = _platform_runs(g[shelf], platform, bg)
  54:     assert len(runs) >= 2
  55: 
  56:     slots: list[tuple[int, int, int]] = []
  57:     for (_left_start, left_end), (right_start, _right_end) in zip(runs, runs[1:]):
  58:         start = left_end + 1
  59:         end = right_start - 1
  60:         assert start <= end
  61:         assert np.all(g[shelf, start : end + 1] == bg)
  62:         slots.append((start, end, end - start + 1))
  63: 
  64:     colors = sorted(set(map(int, g.ravel())) - {bg, platform})
  65:     components = find_components(g, bg=bg, colors=colors, connectivity=4, monochromatic=True)
  66: 
  67:     objects: list[dict] = []
  68:     for comp in components:
  69:         color = int(comp["color"])
  70:         r0, c0, r1, c1 = comp["bbox"]
  71:         assert r1 < shelf
  72: 
  73:         sprite = g[r0 : r1 + 1, c0 : c1 + 1]
  74:         assert np.all(sprite == color)
  75:         h, w = sprite.shape
  76:         assert h == 2 or w == 2
  77: 
  78:         if h == 2:
  79:             normalized = sprite.copy()
  80:         else:
  81:             normalized = np.rot90(sprite, k=1)
  82:             assert normalized.shape[0] == 2
  83: 
  84:         objects.append(
  85:             {
  86:                 "bbox": (r0, c0, r1, c1),
  87:                 "width": int(normalized.shape[1]),
  88:                 "sprite": normalized,
  89:             }
  90:         )
  91: 
  92:     assert len(objects) == len(slots)
  93:     slot_by_width = {width: (start, end) for start, end, width in slots}
  94:     object_by_width = {obj["width"]: obj for obj in objects}
  95:     assert len(slot_by_width) == len(slots)
  96:     assert len(object_by_width) == len(objects)
  97:     assert set(slot_by_width) == set(object_by_width)
  98: 
  99:     out = g.copy()
 100:     for obj in objects:
 101:         r0, c0, r1, c1 = obj["bbox"]
 102:         out[r0 : r1 + 1, c0 : c1 + 1] = bg
 103: 
 104:     for width, (start, end) in slot_by_width.items():
 105:         sprite = object_by_width[width]["sprite"]
 106:         h, w = sprite.shape
 107:         assert h == 2
 108:         assert w == width
 109:         top = shelf - h + 1
 110:         assert top >= 0
 111:         assert np.all(out[top : shelf + 1, start : end + 1] == bg)
 112:         out[top : shelf + 1, start : end + 1] = sprite
 113: 
 114:     return out
 115: 
 116: # --------------- generator (o5x) ---------------
 117: 
 118: # Canvas/platform geometry.
 119: BG = 0
 120: GRID_HEIGHTS = tuple(range(4, 10))
 121: GRID_WIDTH_MIN, GRID_WIDTH_MAX = 5, 12
 122: SHELF_FROM_BOTTOM, OPEN_ROWS_RESERVED = 2, 3
 123: 
 124: # Object, separator, palette, and retry choices.
 125: OBJECT_COUNTS = (1, 2, 3)
 126: NORMALIZED_WIDTHS, SEPARATOR_WIDTHS = (1, 2, 3, 4), (1, 2)
 127: OBJECT_SHORT_SIDE = 2
 128: VERTICAL_ORIENTATION, HORIZONTAL_ORIENTATION = "v", "h"
 129: PALETTE = tuple(range(1, 9))
 130: MAX_ATTEMPTS = 300
 131: 
 132: def _gen_configurations():
 133:     """Enumerate deterministic layouts that fit the open area above the shelf."""
 134:     configs = []
 135:     for h in GRID_HEIGHTS:
 136:         top_h = h - OPEN_ROWS_RESERVED
 137:         for n in OBJECT_COUNTS:
 138:             for widths in _gen_itertools.permutations(NORMALIZED_WIDTHS, n):
 139:                 for seps in _gen_itertools.product(SEPARATOR_WIDTHS, repeat=n + 1):
 140:                     w = sum(widths) + sum(seps)
 141:                     if not GRID_WIDTH_MIN <= w <= GRID_WIDTH_MAX:
 142:                         continue
 143:                     orientation_options = []
 144:                     for width in widths:
 145:                         opts = []
 146:                         if OBJECT_SHORT_SIDE <= top_h:
 147:                             opts.append(VERTICAL_ORIENTATION)
 148:                         if width <= top_h:
 149:                             opts.append(HORIZONTAL_ORIENTATION)
 150:                         if not opts:
 151:                             break
 152:                         orientation_options.append(opts)
