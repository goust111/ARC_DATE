 380:     output, triangle_mask, motif_mask = placed
 381: 
 382:     inp = output.copy()
 383:     inp[triangle_mask] = 0
 384: 
 385:     if not _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):
