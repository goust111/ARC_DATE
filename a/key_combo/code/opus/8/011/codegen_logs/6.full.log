   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """Stretch the colored rectangular frame outward until its far edge reaches the lone marker pixel.
   9: 
  10:     Input structure
  11:     - The background is the most common color.
  12:     - A single marker pixel is the only foreground color that appears once.
  13:     - All other foreground pixels form one solid rectangular frame with one border color and one interior color.
  14: 
  15:     Rule
  16:     - If the marker is above or below the frame and its column lies within the frame, extend the frame vertically to the marker row.
  17:     - If the marker is left or right of the frame and its row lies within the frame, extend the frame horizontally to the marker column.
  18:     - Redraw the expanded rectangle with the same border and interior colors; everything outside remains background.
  19: 
  20:     Key insight
  21:     The marker selects which side of the rectangle moves and where the new outer border lies; it is consumed by that border.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     bg = get_bg(g)
  25: 
  26:     colors = colors_present(g, exclude={bg})
  27:     singleton_colors = [color for color in colors if int((g == color).sum()) == 1]
  28:     assert len(singleton_colors) == 1
  29:     marker_color = singleton_colors[0]
  30:     marker_coords = np.argwhere(g == marker_color)
  31:     assert marker_coords.shape == (1, 2)
  32:     marker_r, marker_c = map(int, marker_coords[0])
