  75:     grid = np.full((width, height), Color.BLACK)
  76: 
  77:     # the red object will be a rectangle with a hole in the middle that the green dot fits into
  78:     # for the hole to fit perfectly in the middle, it needs to be of odd dimension
  79:     rectangle_width, rectangle_height = random.choice([3, 5]), random.choice([3, 5])
  80:     red_rectangle = np.full((rectangle_width, rectangle_height), Color.RED)
