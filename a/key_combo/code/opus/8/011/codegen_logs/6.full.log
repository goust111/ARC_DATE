+        [
+            np.array([[GREEN]], dtype=int),
+            np.array([[GREEN, GREEN]], dtype=int),
+            np.array([[GREEN], [GREEN]], dtype=int),
+            np.array([[GREEN, GREEN, GREEN]], dtype=int),
+            np.array([[GREEN], [GREEN], [GREEN]], dtype=int),
+        ]
+    )
+    return variants
+
