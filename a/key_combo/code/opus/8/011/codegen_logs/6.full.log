+from __future__ import annotations
+
+import math
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+PATTERN_COLORS = (BLUE, RED, GREEN, YELLOW)
+DIAG_COLORS = (RED, GREEN)
+GEN_ATTEMPTS = 500
