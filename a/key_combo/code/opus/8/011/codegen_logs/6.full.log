 127: def _gen_object_sequence(n_green_blocks, red_blocks, green_pixels, red_pixels):
 128:     block_objects = (
 129:         [(TARGET_COLOR, BLOCK_SIZE)] * n_green_blocks
 130:         + [(DISTRACTOR_COLOR, BLOCK_SIZE)] * red_blocks
 131:     )
 132:     pixel_objects = (
 133:         [(TARGET_COLOR, PIXEL_SIZE)] * green_pixels
 134:         + [(DISTRACTOR_COLOR, PIXEL_SIZE)] * red_pixels
 135:     )
 136:     random.shuffle(block_objects)
 137:     random.shuffle(pixel_objects)
 138:     return block_objects + pixel_objects
