+    cells = [(r, c) for r in range(height) for c in range(width)]
+    random.shuffle(cells)
+
+    sprite = np.empty((height, width), dtype=int)
+    for idx, color in enumerate(palette):
+        r, c = cells[idx]
+        sprite[r, c] = int(color)
