   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Count the full green 2x2 blocks and show that count as blue cells on the main diagonal of a 3x3 grid.
  10: 
  11:     Input structure:
  12:     - The background is black.
  13:     - The only foreground colors are red and green.
  14:     - Each monochromatic 4-connected foreground object is either a single pixel or a solid 2x2 block.
  15: 
  16:     Rule:
  17:     - Count the green objects whose bounding box is exactly 2x2 and whose area is four.
  18:     - Return a black 3x3 grid with that many blue cells filled from the top-left along the main diagonal.
  19: 
  20:     Key insight:
  21:     - Red objects and isolated green pixels are distractors; the output encodes only the number of complete green squares.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2, "expected a 2D grid"
  25: 
  26:     bg = get_bg(g)
  27:     assert bg == Color.BLACK, "expected black background"
  28: 
  29:     foreground = set(colors_present(g, exclude={bg}))
  30:     assert foreground <= {Color.RED, Color.GREEN}, "expected only red and green foreground"
  31:     assert Color.GREEN in foreground, "expected green foreground objects"
  32: 
  33:     green_blocks = 0
  34:     for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):
  35:         r0, c0, r1, c1 = obj["bbox"]
  36:         area = int(obj["area"])
  37:         height = int(r1 - r0 + 1)
  38:         width = int(c1 - c0 + 1)
  39:         assert (area, height, width) in {
  40:             (1, 1, 1),
  41:             (4, 2, 2),
  42:         }, "expected foreground objects to be single pixels or solid 2x2 blocks"
  43: 
  44:         if int(obj["color"]) == Color.GREEN and area == 4:
  45:             green_blocks += 1
  46: 
  47:     assert 0 <= green_blocks <= 3, "green block count must fit the 3x3 diagonal"
  48:     out = np.full((3, 3), bg, dtype=int)
  49:     for i in range(green_blocks):
  50:         out[i, i] = Color.BLUE
  51:     return out
  52: 
