  51:     border_colors = set(map(int, frame[edge_mask]))
  52:     interior_colors = set(map(int, frame[~edge_mask]))
  53:     assert len(border_colors) == 1
  54:     assert len(interior_colors) == 1
  55:     border_color = border_colors.pop()
  56:     interior_color = interior_colors.pop()
  57:     assert border_color != bg
  58:     assert interior_color != bg
  59:     assert border_color != interior_color
  60: 
  61:     expected_frame = np.full_like(frame, interior_color)
  62:     expected_frame[edge_mask] = border_color
  63:     assert np.array_equal(frame, expected_frame)
  64: 
  65:     expanded_boxes = []
  66:     if marker_r < r0 and c0 <= marker_c <= c1:
  67:         expanded_boxes.append((marker_r, c0, r1, c1))
  68:     if marker_r > r1 and c0 <= marker_c <= c1:
  69:         expanded_boxes.append((r0, c0, marker_r, c1))
  70:     if marker_c < c0 and r0 <= marker_r <= r1:
  71:         expanded_boxes.append((r0, marker_c, r1, c1))
  72:     if marker_c > c1 and r0 <= marker_r <= r1:
  73:         expanded_boxes.append((r0, c0, r1, marker_c))
  74:     assert len(expanded_boxes) == 1
  75:     nr0, nc0, nr1, nc1 = expanded_boxes[0]
  76:     assert 0 <= nr0 <= nr1 < g.shape[0]
  77:     assert 0 <= nc0 <= nc1 < g.shape[1]
  78:     assert nr1 - nr0 + 1 >= 3
  79:     assert nc1 - nc0 + 1 >= 3
  80: 
  81:     out = np.full_like(g, bg)
  82:     out[nr0 : nr1 + 1, nc0 : nc1 + 1] = interior_color
  83:     out[nr0, nc0 : nc1 + 1] = border_color
  84:     out[nr1, nc0 : nc1 + 1] = border_color
  85:     out[nr0 : nr1 + 1, nc0] = border_color
  86:     out[nr0 : nr1 + 1, nc1] = border_color
