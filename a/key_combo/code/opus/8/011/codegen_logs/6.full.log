 341:     fill_count = random.randint(_GEN_FILL_COUNT_BOUNDS[0], min(_GEN_FILL_COUNT_BOUNDS[1], side))
 342:     distractor_count = side - fill_count
 343:     distractor_choices = [c for c in colors if c != fill_color]
 344:     random.shuffle(distractor_choices)
 345:     control_colors = [fill_color] * fill_count + distractor_choices[:distractor_count]
 346:     random.shuffle(control_colors)
 347:     return control_colors
