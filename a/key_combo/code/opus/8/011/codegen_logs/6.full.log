 190: def _gen_scatter_sources(grid, shelf, widths, colors, orientations):
 191:     """Place source rectangles in the open area; return False if crowded."""
 192:     order = list(range(len(widths)))
 193:     _gen_random.shuffle(order)
 194:     top_area = grid[: shelf - 1, :]
 195:     for i in order:
 196:         width, color = int(widths[i]), int(colors[i])
 197:         if orientations[i] == VERTICAL_ORIENTATION:
 198:             sprite = np.full((OBJECT_SHORT_SIDE, width), color, dtype=int)
 199:         else:
 200:             sprite = np.full((width, OBJECT_SHORT_SIDE), color, dtype=int)
 201:         try:
 202:             r, c = _gen_random_free_location(top_area, sprite, transparent=BG)
 203:         except ValueError:
 204:             return False
 205:         _gen_paste(grid, sprite, r, c)
 206:     return True
