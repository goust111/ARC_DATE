 111: def _gen_place_object(grid, color, size):
 112:     patch = np.full((size, size), int(color), dtype=int)
 113:     height, width = grid.shape
 114:     locations = [
 115:         (r, c)
 116:         for r in range(height - size + 1)
 117:         for c in range(width - size + 1)
 118:         if _gen_can_place(grid, size, r, c, color)
 119:     ]
 120:     if not locations:
 121:         return False
 122:     r0, c0 = random.choice(locations)
 123:     paste(grid, patch, r0, c0)
 124:     return True
