  82:     # randomly place the red rectangle away from the edge
  83:     r, c = random_free_location(grid, red_rectangle, transparent=Color.BLACK, border=2, padding=0, padding_connectivity=8)
  84:     paste(grid, red_rectangle, r, c, transparent=Color.BLACK, clip=True)
