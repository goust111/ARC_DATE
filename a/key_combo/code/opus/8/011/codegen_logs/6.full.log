 351:     H, W = inp.shape
 352:     corner_rc = _gen_corner_cells((H, W))[corner]
 353:     inp[corner_rc] = random.choice(_gen_marker_choices(colors, motif_color, fill_color))
 354:     control_colors = _gen_control_colors(colors, side, fill_color)
 355: 
 356:     occupied_controls = np.zeros((H, W), dtype=bool)
 357:     occupied_controls[corner_rc] = True
 358:     blocked_controls = triangle_mask.copy()
 359:     for color in control_colors:
 360:         blocked = blocked_controls | _gen_dilate8(occupied_controls)
 361:         pool = _gen_control_pool(inp, motif_mask, blocked)
 362:         if not pool:
 363:             return False
 364:         r, c = random.choice(pool)
 365:         inp[r, c] = color
 366:         occupied_controls[r, c] = True
 367:     return True
