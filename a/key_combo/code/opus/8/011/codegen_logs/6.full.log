 172: def _gen_build_grids(H, W, widths, seps, colors, platform):
 173:     """Render the target, then clear target slots to form the source grid."""
 174:     shelf = H - SHELF_FROM_BOTTOM
 175:     out = np.full((H, W), BG, dtype=int)
 176:     inp = np.full((H, W), BG, dtype=int)
 177:     out[H - 1, :] = inp[H - 1, :] = platform
 178: 
 179:     c = 0
 180:     fill_rows = slice(shelf - OBJECT_SHORT_SIDE + 1, shelf + 1)
 181:     for i, width in enumerate(widths):
 182:         out[shelf, c : c + seps[i]] = inp[shelf, c : c + seps[i]] = platform
 183:         c += seps[i]
 184:         start = c
 185:         c += width
 186:         out[fill_rows, start:c] = colors[i]
 187:     out[shelf, c : c + seps[-1]] = inp[shelf, c : c + seps[-1]] = platform
 188:     return inp, out, shelf
