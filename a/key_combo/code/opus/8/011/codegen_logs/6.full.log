  14: def main(input_grid):
  15:     """
  16:     Extend a multicolor cross across the canvas by repeating its color sequences.
  17: 
  18:     Input structure:
  19:     - The grid contains one connected multicolor cross on a black background.
  20:     - One full row and one full column of the cropped sprite meet at the cross center.
  21:     - The row and column colors form the sequences to repeat.
  22: 
  23:     Rule:
  24:     - Crop the cross and locate the row and column that pass through its center.
  25:     - Copy the input grid as the output canvas.
  26:     - Paste the center column and center row sequences repeatedly in both directions.
  27: 
  28:     Key insight:
  29:     - The cross is a seed for periodic extension: its central row and column are reused
  30:       at intervals equal to their own lengths.
  31:     """
  32:     # Plan:
  33:     # 1. Parse the input and create output canvas to draw on top of
  34:     # 2. Extract the vertical and horizontal parts of the cross, and make note of the coordinate of the middle
  35:     # 3. Expand the horizontal part to the right and left, aligned with the middle y coordinate
  36:     # 4. Expand the vertical part to the top and bottom, aligned with the middle x coordinate    
  37: 
  38:     # 1. Input parsing
  39:     # Extract the cross, which has many colors and so is not monochromatic.
  40:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
  41:     assert len(objects) == 1, "exactly one cross expected"
  42:     obj = objects[0]
  43:     _b = bbox(obj != Color.BLACK)
  44:     assert _b is not None
  45:     cross_r, cross_c = bbox_anchor(_b, anchor="upper left")
  46: 
  47:     # Create output grid, which we are going to draw on top of, so we start with the input grid
  48:     output_grid = input_grid.copy()
  49:     width, height = input_grid.shape
  50: 
  51:     # 2. Cross analysis: Extract subsprites, get the middle
  52:     # Extract the horizontal/vertical parts of the cross sprite by figuring out where its middle is (where the horizontal and vertical lines meet)
  53:     _b = bbox(obj != Color.BLACK)
  54:     assert _b is not None
  55:     sprite = crop_bbox(obj, _b)
  56:     cross_width, cross_height = sprite.shape
  57:     # Middle is where they meet
  58:     cross_middle_r = next( r for r in range(cross_width) if np.all(sprite[r, :] != Color.BLACK) )
  59:     cross_middle_c = next( c for c in range(cross_height) if np.all(sprite[:, c] != Color.BLACK) )
  60:     # Extract the horizontal and vertical parts of the cross
  61:     vertical_sprite = sprite[cross_middle_r:cross_middle_r+1, :]
  62:     horizontal_sprite = sprite[:, cross_middle_c:cross_middle_c+1]
  63: 
  64:     # 3. Expand the horizontal line to the right and left
  65:     r_start, c_start, len_line = cross_r, cross_c + cross_middle_c, cross_width
  66:     for i in range(r_start, width, len_line):
  67:         paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
  68:     for i in range(r_start, -(len_line), -len_line):
  69:         paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
  70:     
  71:     # 4. Expand the vertical line to the top and bottom
  72:     r_start, c_start, len_line = cross_r + cross_middle_r, cross_c, cross_height
  73:     for i in range(c_start, height, len_line):
  74:         paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
  75:     for i in range(c_start, -(len_line), -len_line):
  76:         paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
  77:         
  78:     return output_grid
  79: 
  80: def generate_input():
  81:     # Generate the background grid
  82:     width, height = np.random.randint(20, 30, size=2)
  83:     grid = np.full((width, height), Color.BLACK)
  84: 
  85:     # Randomly choose the number of colors
  86:     num_colors = np.random.randint(2, 5)
  87:     colors = np.random.choice(Color.NOT_BLACK, size=num_colors, replace=False)
  88: 
  89:     # Generate a line with these colors in sequence
  90:     line = np.full((num_colors, 1), Color.BLACK)
  91:     for i in range(num_colors):
  92:         line[i, 0] = colors[i]
  93: 
  94:     # form a cross pattern randomly
  95:     cross_points = random.randint(0, num_colors - 1)
  96:     sprite = np.full((num_colors, num_colors), Color.BLACK)
  97:     line_t = np.transpose(line)
  98:     paste(sprite, line, 0, cross_points, transparent=Color.BLACK, clip=True)
  99:     paste(sprite, line_t, cross_points, 0, transparent=Color.BLACK, clip=True)
 100: 
 101:     # Randomly rotate the pattern
 102:     sprite = np.rot90(sprite, k=-(np.random.randint(4)))
 103: 
 104:     # Randomly place the pattern on the grid
 105:     _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
 106:     if _loc is None:
 107:         raise ValueError("no placement")
 108:     r, c = _loc
 109:     paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
 110: 
 111:     return grid

