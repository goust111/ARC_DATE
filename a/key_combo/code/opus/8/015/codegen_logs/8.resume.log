+    outer_h = int(spec["outer_h"])
+    outer_w = int(spec["outer_w"])
+    box = (int(top), int(left), int(top + outer_h - 1), int(left + outer_w - 1))
+    patch_r0 = int(top + spec["patch_offset"][0])
+    patch_c0 = int(left + spec["patch_offset"][1])
