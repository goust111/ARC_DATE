+
+def _bbox_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = map(int, box)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
