+    }
+
+
+def _connected_black_reachable(grid: np.ndarray, box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    framed = grid.copy()
+    _draw_frame(framed, box, 9)
+    return _reachable_black_inside(framed, box)
