+def _draw_frame(grid: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = map(int, box)
+    grid[r0, c0 : c1 + 1] = int(color)
+    grid[r1, c0 : c1 + 1] = int(color)
+    grid[r0 : r1 + 1, c0] = int(color)
+    grid[r0 : r1 + 1, c1] = int(color)
