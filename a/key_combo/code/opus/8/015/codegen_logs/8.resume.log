+        "template": template,
+        "holes": int(holes),
+        "outer_h": int(outer_h),
+        "outer_w": int(outer_w),
+        "patch_offset": (1 + top_gap, 1 + left_gap),
+    }
+
+
+def _paint_group(grid: np.ndarray, spec: dict, top: int, left: int) -> dict:
