+def _point_sides(r: int, c: int, box: tuple[int, int, int, int]) -> set[str]:
+    r0, c0, r1, c1 = map(int, box)
+    sides: set[str] = set()
+    if r == r0:
+        sides.add("top")
+    if r == r1:
+        sides.add("bottom")
+    if c == c0:
+        sides.add("left")
+    if c == c1:
+        sides.add("right")
+    return sides
+
