+def _contiguous_runs(values: list[int]) -> list[list[int]]:
+    if not values:
+        return []
+    runs = [[int(values[0])]]
+    for value in values[1:]:
+        value = int(value)
+        if value == runs[-1][-1] + 1:
+            runs[-1].append(value)
+        else:
+            runs.append([value])
+    return runs
