+        lower = any(r > int(info["fixed"]) for r, _c in blue_coords)
+        if not (upper and lower):
+            return False
+    else:
+        left = any(c < int(info["fixed"]) for _r, c in blue_coords)
+        right = any(c > int(info["fixed"]) for _r, c in blue_coords)
+        if not (left and right):
