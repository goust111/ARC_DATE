+def _intervals(limit: int, walls: list[int]) -> list[tuple[int, int]]:
+    walls = sorted(int(w) for w in walls)
+    intervals: list[tuple[int, int]] = []
+    start = 0
+    for wall in walls:
+        if start <= wall - 1:
+            intervals.append((start, wall - 1))
+        start = wall + 1
+    if start <= limit - 1:
+        intervals.append((start, limit - 1))
+    return intervals
+
