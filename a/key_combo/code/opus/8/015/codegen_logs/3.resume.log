+    forbidden = {(trunk[-1], direction)}
+    _grow_side_subtree(
+        rng,
+        nr,
+        nc,
+        occupied,
+        edge_colors,
+        trunk,
+        max_new_nodes=int(rng.integers(0, 3)),
+        forbidden_steps=forbidden,
+    )
+    return root, direction
