+    cavity = [(top + 1 + rr, 1 + cc) for rr in range(inner_h) for cc in range(inner_w)]
+    chosen_idx = rng.choice(len(cavity), size=content_count, replace=False)
+    for idx in chosen_idx:
+        rr, cc = cavity[int(idx)]
+        patch[rr, cc] = content_color
