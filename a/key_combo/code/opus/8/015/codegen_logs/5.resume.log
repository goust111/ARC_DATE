+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+FRAME_COLORS = (1, 3, 4, 6)
+CONTENT_COLORS = (2, 7)
+BG = 0
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS.values():
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _flood_from_side(empty_mask: np.ndarray, side: str) -> set[tuple[int, int]]:
+    h, w = empty_mask.shape
+    if side == "U":
+        seeds = [(0, c) for c in range(w) if empty_mask[0, c]]
+    elif side == "D":
+        seeds = [(h - 1, c) for c in range(w) if empty_mask[h - 1, c]]
+    elif side == "L":
+        seeds = [(r, 0) for r in range(h) if empty_mask[r, 0]]
+    else:
+        seeds = [(r, w - 1) for r in range(h) if empty_mask[r, w - 1]]
+
+    reached = set(seeds)
+    stack = list(seeds)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS.values():
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and empty_mask[nr, nc] and (nr, nc) not in reached:
+                reached.add((nr, nc))
+                stack.append((nr, nc))
+    return reached
+
+
+def _expected_body_mask(height: int, width: int, tail: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if tail == "U":
+        mask[0, :] = True
+        mask[1:, 0] = True
+        mask[1:, -1] = True
+    elif tail == "D":
+        mask[-1, :] = True
+        mask[:-1, 0] = True
+        mask[:-1, -1] = True
+    elif tail == "L":
+        mask[:, 0] = True
+        mask[0, 1:] = True
+        mask[-1, 1:] = True
+    else:
+        mask[:, -1] = True
+        mask[0, :-1] = True
+        mask[-1, :-1] = True
+    return mask
+
+
