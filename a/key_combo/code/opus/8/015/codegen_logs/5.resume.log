+        for r, c in spec["content_abs"]:
+            original.append((int(r), int(c), int(spec["content_color"])))
+    return _settle_emitted(np.zeros((h, w), dtype=int), original, BG)
+
+
+def _naive_single_column(h: int, w: int, placed: list[dict]) -> np.ndarray:
+    emitted = []
+    for spec in placed:
