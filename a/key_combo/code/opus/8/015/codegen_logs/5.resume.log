                    continue
                if sum(widths) + (n - 1) * INPUT_GAP > GRID_SIZE:
                    continue
                choices.append((tuple(map(int, heights)), tuple(map(int, widths))))
        _DIMENSION_CHOICES_CACHE[n] = choices
    return _DIMENSION_CHOICES_CACHE[n]


