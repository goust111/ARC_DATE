+                "top_left": (r0, c0),
+                "bbox_abs": box,
+                "tip_abs": (r0 + spec["tip_rel"][0], c0 + spec["tip_rel"][1]),
+                "content_abs": _placement_content(spec, r0, c0),
+                "emitted_abs": emitted,
