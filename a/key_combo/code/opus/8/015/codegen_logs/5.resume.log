+def _place_specs(rng: np.random.Generator, h: int, w: int, specs: list[dict], shared_col: int) -> list[dict] | None:
+    placed: list[dict] = []
+    placed_boxes: list[tuple[int, int, int, int]] = []
+    reserved_emits: set[tuple[int, int]] = set()
