SPRITE_W_MIN, SPRITE_W_MAX = 2, 7
SOURCE_BORDER, TARGET_BORDER = 1, 0
PLACEMENT_PADDING, PLACEMENT_PADDING_CONNECTIVITY = 1, 4

# Marker counts, adjacency, and color rates.
MARKER_TOTAL_MIN, MARKER_TOTAL_MAX_EXCLUSIVE = 3, 8
