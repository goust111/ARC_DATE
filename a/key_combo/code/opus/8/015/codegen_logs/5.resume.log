+def _shift_box(box: tuple[int, int, int, int], r0: int, c0: int) -> tuple[int, int, int, int]:
+    br0, bc0, br1, bc1 = box
+    return (r0 + br0, c0 + bc0, r0 + br1, c0 + bc1)
