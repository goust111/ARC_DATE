+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
