+    for idx, spec in enumerate(specs):
+        candidates: list[tuple[int, int]] = []
+        ph, pw = spec["shape"]
+        if idx == 0:
+            c0 = shared_col - spec["tip_rel"][1]
+            for r0 in _candidate_rows(spec, h):
+                candidates.append((r0, c0))
+        elif idx == 1:
