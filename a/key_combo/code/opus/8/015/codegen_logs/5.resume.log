+        dr, dc = DIRS[cup["tail"]]
+        tip_r, tip_c = cup["tip"]
+        for step in range(1, len(cup["content_cells"]) + 1):
+            rr = tip_r + dr * step
+            cc = tip_c + dc * step
+            if 0 <= rr < h and 0 <= cc < w:
