+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS.values():
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _flood_from_side(empty_mask: np.ndarray, side: str) -> set[tuple[int, int]]:
+    h, w = empty_mask.shape
+    if side == "U":
+        seeds = [(0, c) for c in range(w) if empty_mask[0, c]]
+    elif side == "D":
+        seeds = [(h - 1, c) for c in range(w) if empty_mask[h - 1, c]]
+    elif side == "L":
+        seeds = [(r, 0) for r in range(h) if empty_mask[r, 0]]
+    else:
+        seeds = [(r, w - 1) for r in range(h) if empty_mask[r, w - 1]]
+
+    reached = set(seeds)
+    stack = list(seeds)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS.values():
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and empty_mask[nr, nc] and (nr, nc) not in reached:
+                reached.add((nr, nc))
+                stack.append((nr, nc))
+    return reached
+
+
+def _expected_body_mask(height: int, width: int, tail: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if tail == "U":
+        mask[0, :] = True
+        mask[1:, 0] = True
+        mask[1:, -1] = True
+    elif tail == "D":
+        mask[-1, :] = True
+        mask[:-1, 0] = True
+        mask[:-1, -1] = True
+    elif tail == "L":
+        mask[:, 0] = True
+        mask[0, 1:] = True
+        mask[-1, 1:] = True
+    else:
+        mask[:, -1] = True
+        mask[0, :-1] = True
+        mask[-1, :-1] = True
+    return mask
+
+
+def _detect_cup(grid: np.ndarray, color: int, coords: np.ndarray, bg: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros(grid.shape, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
+
+    edge_counts = {
+        "U": int(mask[r0, c0 : c1 + 1].sum()),
+        "D": int(mask[r1, c0 : c1 + 1].sum()),
+        "L": int(mask[r0 : r1 + 1, c0].sum()),
+        "R": int(mask[r0 : r1 + 1, c1].sum()),
+    }
+    tails = [side for side, count in edge_counts.items() if count == 1]
+    if len(tails) != 1:
+        return None
+    tail = tails[0]
+
+    spike: list[tuple[int, int]] = []
+    if tail == "U":
+        col = None
+        rr = r0
+        while rr <= r1:
+            cols = np.flatnonzero(mask[rr, c0 : c1 + 1]) + c0
+            if len(cols) != 1:
+                break
+            if col is None:
+                col = int(cols[0])
+            elif int(cols[0]) != col:
+                return None
+            spike.append((int(rr), col))
+            rr += 1
+        if not spike or rr > r1:
+            return None
+        body_bbox = (rr, c0, r1, c1)
+        tip = spike[0]
+    elif tail == "D":
+        col = None
+        rr = r1
+        while rr >= r0:
+            cols = np.flatnonzero(mask[rr, c0 : c1 + 1]) + c0
+            if len(cols) != 1:
+                break
+            if col is None:
+                col = int(cols[0])
+            elif int(cols[0]) != col:
+                return None
+            spike.append((int(rr), col))
+            rr -= 1
+        if not spike or rr < r0:
+            return None
+        body_bbox = (r0, c0, rr, c1)
+        tip = spike[0]
+    elif tail == "L":
+        row = None
+        cc = c0
+        while cc <= c1:
+            rows = np.flatnonzero(mask[r0 : r1 + 1, cc]) + r0
+            if len(rows) != 1:
+                break
+            if row is None:
+                row = int(rows[0])
+            elif int(rows[0]) != row:
+                return None
+            spike.append((row, int(cc)))
+            cc += 1
+        if not spike or cc > c1:
+            return None
+        body_bbox = (r0, cc, r1, c1)
+        tip = spike[0]
+    else:
+        row = None
+        cc = c1
+        while cc >= c0:
+            rows = np.flatnonzero(mask[r0 : r1 + 1, cc]) + r0
+            if len(rows) != 1:
+                break
+            if row is None:
+                row = int(rows[0])
+            elif int(rows[0]) != row:
+                return None
+            spike.append((row, int(cc)))
+            cc -= 1
+        if not spike or cc < c0:
+            return None
+        body_bbox = (r0, c0, r1, cc)
+        tip = spike[0]
+
+    br0, bc0, br1, bc1 = body_bbox
