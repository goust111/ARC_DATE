+
+def _fits(shape: tuple[int, int], marker: tuple[int, int], direction: tuple[int, int]) -> bool:
+    min_r, max_r, min_c, max_c = SPRITE_EXTENTS[direction]
+    r, c = marker
+    h, w = shape
+    return 0 <= r + min_r and r + max_r < h and 0 <= c + min_c and c + max_c < w
+
