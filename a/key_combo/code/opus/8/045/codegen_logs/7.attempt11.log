+
+
+def _random_place(shape: tuple[int, int], color: int, occupied: set[tuple[int, int]]) -> dict | None:
+    h, w = shape
+    options = []
+    for direction in random.sample(DIRECTIONS, len(DIRECTIONS)):
+        min_r, max_r, min_c, max_c = SPRITE_EXTENTS[direction]
