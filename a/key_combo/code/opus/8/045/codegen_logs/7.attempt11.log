+
+
+def _trace_ray(
+    grid: np.ndarray,
+    marker: tuple[int, int],
+    direction: tuple[int, int],
+    length: int,
+) -> tuple[list[tuple[int, int]], bool]:
+    h, w = grid.shape
+    dr, dc = direction
+    rr, cc = marker[0] + dr, marker[1] + dc
