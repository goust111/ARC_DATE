+    for rec in records:
+        out[rec["marker"]] = rec["color"]
+    return out, has_overlap, has_skip
+
+
+def _make_core_records(shape: tuple[int, int], freqs: dict[int, int]) -> list[dict] | None:
+    ranked = sorted(freqs.items(), key=lambda item: item[1], reverse=True)
+    if len(ranked) < 2 or ranked[0][1] < 3:
+        return None
+
+    owner_color = ranked[0][0]
+    cross_color = ranked[1][0]
+    owner_dir = random.choice([(0, 1), (0, -1)])
+    blocker_above = random.choice([True, False])
+    cross_dir = (-1, 0) if blocker_above else (1, 0)
+
+    h, w = shape
+    row_mid = h // 2 + random.choice([-1, 0, 1])
+    col_mid = w // 2 + random.choice([-1, 0, 1])
+    sign = 1 if owner_dir == (0, 1) else -1
+
+    owner_marker = (row_mid, col_mid - sign)
+    cross_marker = (row_mid - cross_dir[0], col_mid)
+    blocker_col = col_mid + 2 * sign
+    blocker_row = row_mid - 2 if blocker_above else row_mid + 2
+    blocker_marker = (blocker_row, blocker_col)
+
+    records = [
+        {"color": owner_color, "marker": owner_marker, "direction": owner_dir},
+        {"color": cross_color, "marker": cross_marker, "direction": cross_dir},
+        {"color": owner_color, "marker": blocker_marker, "direction": owner_dir},
+    ]
+
+    occupied: set[tuple[int, int]] = set()
+    for rec in records:
+        if not _can_place(shape, rec["marker"], rec["direction"], occupied):
+            return None
+        occupied |= _sprite_cells(rec["marker"], rec["direction"])
