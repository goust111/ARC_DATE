+        assert color in MARKER_COLORS, "unexpected marker color"
+        assert all(v in MARKER_COLORS or v == BODY for v in colors)
+        direction = _decode_direction(body_coords, (mr, mc))
+        records.append(
+            {
+                "color": color,
+                "marker": (mr, mc),
+                "direction": direction,
