+    for rec in records:
+        ray_cells, skipped_grey = _trace_ray(grid, rec["marker"], rec["direction"], freqs[rec["color"]])
+        has_skip = has_skip or skipped_grey
+        mr, mc = rec["marker"]
+        for rr, cc in ray_cells:
