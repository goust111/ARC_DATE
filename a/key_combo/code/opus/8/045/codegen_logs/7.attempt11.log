+
+def _sprite_cells(marker: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = marker
+    return {(r, c)} | {(r + dr, c + dc) for dr, dc in BODY_REL[direction]}
