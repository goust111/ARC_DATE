+
+    out[grid == BODY] = BODY
+    for rec in records:
+        out[rec["marker"]] = rec["color"]
+    return out, {color: freqs[color] for color in sorted(freqs)}, crossing and len(claims) > 0 and any(
+        len({item[3] for item in items}) >= 2 for items in claims.values()
