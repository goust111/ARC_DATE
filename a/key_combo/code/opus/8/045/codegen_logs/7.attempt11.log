+def _find_cross_pair(shape: tuple[int, int], freqs: dict[int, int], occupied: set[tuple[int, int]]) -> list[dict] | None:
+    ranked = sorted(freqs.items(), key=lambda item: item[1], reverse=True)
+    if len(ranked) < 2:
