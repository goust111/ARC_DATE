+for _direction, _offsets in BODY_REL.items():
+    _all = _offsets + [(0, 0)]
+    SPRITE_EXTENTS[_direction] = (
+        min(dr for dr, _ in _all),
+        max(dr for dr, _ in _all),
+        min(dc for _, dc in _all),
+        max(dc for _, dc in _all),
+    )
