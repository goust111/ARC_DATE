+    for rec in records:
+        out[rec["marker"]] = rec["color"]
+    return out, has_overlap, has_skip
+
+
+def _generate_attempt() -> np.ndarray | None:
+    shape = (random.randint(14, 18), random.randint(14, 18))
+    specs, freqs = _build_specs()
+
