+
+def _find_blocker(
+    shape: tuple[int, int],
+    owner: dict,
+    freqs: dict[int, int],
+    blocker_color: int,
+    occupied: set[tuple[int, int]],
+) -> dict | None:
+    owner_len = freqs[owner["color"]]
