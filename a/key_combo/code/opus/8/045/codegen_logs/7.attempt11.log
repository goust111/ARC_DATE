def _black_shared_corners(out: np.ndarray, directions: set[tuple[int, int]]) -> None:
    """Set corner to black where two painted boundary sides meet."""
    H, W = out.shape
    if (-1, 0) in directions and (0, -1) in directions:
        out[0, 0] = 0
    if (-1, 0) in directions and (0, 1) in directions:
