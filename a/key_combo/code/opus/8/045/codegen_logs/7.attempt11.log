+
+def _non_adjacent(cells: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    if cells & occupied:
+        return False
+    blocked = set(occupied)
+    for rr, cc in occupied:
+        blocked.update(_neighbors8(rr, cc))
