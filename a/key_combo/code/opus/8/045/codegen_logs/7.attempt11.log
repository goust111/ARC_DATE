+    if len(ranked) < 2:
+        return None
+    color_a, freq_a = ranked[0]
+    color_b, freq_b = ranked[1]
+    h_dir = random.choice([(0, -1), (0, 1)])
+    v_dir = random.choice([(-1, 0), (1, 0)])
