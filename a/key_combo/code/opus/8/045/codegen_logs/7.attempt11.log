+                    occ_a = occupied | _sprite_cells(marker_a, h_dir)
+                    if not _can_place(shape, marker_b, v_dir, occ_a):
+                        continue
+                    if (ir, ic) in _sprite_cells(marker_a, h_dir) or (ir, ic) in _sprite_cells(marker_b, v_dir):
