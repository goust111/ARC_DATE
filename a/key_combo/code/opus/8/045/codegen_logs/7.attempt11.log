+    if not options:
+        return None
+    return random.choice(options)
+
+
+def _render_expected(grid: np.ndarray, records: list[dict], freqs: dict[int, int]) -> tuple[np.ndarray, bool, bool]:
+    claims: dict[tuple[int, int], list[tuple[int, int, int, int]]] = {}
