+    records = []
+    for coords in comps:
+        colors = [int(grid[r, c]) for r, c in coords]
+        marker_cells = [(int(r), int(c), int(grid[r, c])) for r, c in coords if int(grid[r, c]) != BODY]
+        body_coords = np.array([(int(r), int(c)) for r, c in coords if int(grid[r, c]) == BODY], dtype=int)
