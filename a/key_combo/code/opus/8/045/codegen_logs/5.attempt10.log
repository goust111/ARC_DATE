+    (-2, -1),
+    (-2, 0),
+    (-2, 1),
+    (-1, -2),
+    (-1, 2),
+    (0, -2),
+    (0, 2),
+    (1, -2),
+    (1, 2),
+    (2, -1),
+    (2, 0),
+    (2, 1),
+)
+NEIGHBORS8 = tuple(
