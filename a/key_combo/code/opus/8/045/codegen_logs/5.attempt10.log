+def _band_cells(shape: tuple[int, int], center: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = center
+    return [
+        (r + dr, c + dc)
+        for dr, dc in BOX_BAND_OFFSETS
+        if _in_bounds(shape, r + dr, c + dc)
