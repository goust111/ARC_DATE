+        r, c = seed["pos"]
+        grid[r, c] = int(seed["color"])
+    for r, c in boxes:
+        for dr, dc in BOX_RING_OFFSETS:
+            grid[r + dr, c + dc] = YELLOW
+    return grid
+
+
+def _output_with_rule_variant(
+    grid: np.ndarray,
+    seeds: list[dict],
+    boxes: list[tuple[int, int]],
+    *,
+    obstacle_mask: np.ndarray,
+    tie_mode: str,
