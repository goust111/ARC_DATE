+
+def _render_output(
+    grid: np.ndarray,
+    seeds: list[dict],
+    boxes: list[tuple[int, int]],
+    owners: np.ndarray,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    owner_sets = _box_owner_sets(owners, boxes)
+    for (r, c), owner_set in zip(boxes, owner_sets):
+        out[r - 1 : r + 2, c - 1 : c + 2] = BLACK
