+    no_obstacle_out, _ = _output_with_rule_variant(
+        grid,
+        seeds,
+        boxes,
+        obstacle_mask=np.zeros_like(grid, dtype=bool),
+        tie_mode="count_pos",
+    )
+    if np.array_equal(normal_out, no_obstacle_out):
+        return False
+
+    try:
+        solved = main(grid)
+    except Exception:
+        return False
+    return bool(np.array_equal(solved, normal_out))
