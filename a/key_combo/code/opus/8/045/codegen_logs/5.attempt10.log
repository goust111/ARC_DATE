+
+def _valid_example(grid: np.ndarray, seeds: list[dict], boxes: list[tuple[int, int]]) -> bool:
+    normal_out, normal = _output_with_rule_variant(
+        grid,
+        seeds,
+        boxes,
+        obstacle_mask=(grid == YELLOW),
