+    random.shuffle(colors)
+    for _ in range(80):
+        positions = [random.choice(slot) for slot in slots]
+        if min(_chebyshev(a, b) for i, a in enumerate(positions) for b in positions[i + 1 :]) < MIN_SEED_GAP:
