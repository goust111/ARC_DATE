+    base_grid = _draw_input(h, w, seeds, [])
+    base_owners, _counts, _stats = _simulate_growth(
+        base_grid.shape,
+        seeds,
+        np.zeros((h, w), dtype=bool),
+        tie_mode="count_pos",
+    )
+    mixed_like = []
+    single_like = []
+    edge_like = []
+    for center in candidates:
+        owner_set = _box_owner_sets(base_owners, [center])[0]
+        if len(owner_set) >= 2:
