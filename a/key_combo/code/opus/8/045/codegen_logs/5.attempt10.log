+            rr, cc = cell
+            owners[rr, cc] = winner
+            next_frontiers[winner].add(cell)
+
+        any_new = False
+        for idx, frontier in enumerate(next_frontiers):
+            counts[idx] += len(frontier)
+            if frontier:
+                any_new = True
+        if not any_new:
