+def _boxes_are_separate(boxes: list[tuple[int, int]]) -> bool:
+    for i, a in enumerate(boxes):
+        for b in boxes[i + 1 :]:
+            if abs(a[0] - b[0]) < 4 and abs(a[1] - b[1]) < 4:
+                return False
+    return True
+
+
+def _draw_input(h: int, w: int, seeds: list[dict], boxes: list[tuple[int, int]]) -> np.ndarray:
