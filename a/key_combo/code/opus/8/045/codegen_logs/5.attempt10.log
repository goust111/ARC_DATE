+    out: list[set[int]] = []
+    for center in boxes:
+        band = _band_cells(shape, center)
+        owner_set = {
+            int(owners[r, c]) for r, c in band if int(owners[r, c]) >= 0
+        }
+        out.append(owner_set)
+    return out
