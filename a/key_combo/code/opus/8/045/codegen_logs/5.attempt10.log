+    seed_positions = [seed["pos"] for seed in seeds]
+    mixed_like = []
+    single_like = []
+    edge_like = []
+    for center in candidates:
+        distances = sorted(_chebyshev(center, pos) for pos in seed_positions)
+        if distances[1] - distances[0] <= 1:
+            mixed_like.append(center)
+        if distances[1] - distances[0] >= 2:
+            single_like.append(center)
+        if center[0] in (1, h - 2) or center[1] in (1, w - 2):
+            edge_like.append(center)
+    if not mixed_like or not single_like:
+        return None
+
+    for _ in range(MAX_COMBO_ATTEMPTS):
+        box_count = random.choice(BOX_COUNT_CHOICES)
+        chosen = [random.choice(mixed_like), random.choice(single_like)]
+        pool = candidates.copy()
+        random.shuffle(pool)
+
+        if random.random() < 0.35 and edge_like:
+            chosen.append(random.choice(edge_like))
+
+        for center in pool:
+            if len(chosen) >= box_count:
+                break
+            if center not in chosen:
+                chosen.append(center)
+
+        chosen = chosen[:box_count]
+        if len(set(chosen)) != box_count:
+            continue
+        if not _boxes_are_separate(chosen):
+            continue
+
+        grid = _draw_input(h, w, seeds, chosen)
+        if _valid_example(grid, seeds, chosen):
+            return sorted(chosen)
+    return None
+
