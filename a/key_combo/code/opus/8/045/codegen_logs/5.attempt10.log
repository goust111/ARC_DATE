+        return False
+    if int(grid[r, c]) != BLACK:
+        return False
+    return all(int(grid[r + dr, c + dc]) == YELLOW for dr, dc in BOX_RING_OFFSETS)
+
+
+def _scan_boxes(grid: np.ndarray) -> list[tuple[int, int]]:
