+        "bottom": [(r + 2, c - 1), (r + 2, c), (r + 2, c + 1)],
+        "left": [(r - 1, c - 2), (r, c - 2), (r + 1, c - 2)],
+        "right": [(r - 1, c + 2), (r, c + 2), (r + 1, c + 2)],
+    }
+    sides = list(by_side)
+    rng.shuffle(sides)
