+
+def _place_region(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    grey_occupied: set[tuple[int, int]],
+    reserved_forbidden: set[tuple[int, int]],
+    candidates: list[set[tuple[int, int]]],
+) -> set[tuple[int, int]] | None:
+    for coords in candidates:
