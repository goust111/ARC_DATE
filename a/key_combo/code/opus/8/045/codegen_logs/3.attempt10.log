+                return False
+            cross_count += 1
+        else:
+            if not np.array_equal(patch, np.zeros((3, 3), dtype=int)):
+                return False
+            blank_count += 1
+    return cross_count >= 1 and blank_count >= 1
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(15, 19)
+    w = rng.randint(15, 19)
