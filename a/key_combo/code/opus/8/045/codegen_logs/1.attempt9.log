+            if depth == 0:
+                if out[sr, sc] == BLACK:
+                    out[sr, sc] = color
+                continue
+            top = sr - depth
+            bottom = sr + depth
+            left = sc - depth
+            right = sc + depth
+            for c in range(left, right + 1):
+                if _in_bounds((h, w), top, c) and out[top, c] == BLACK and grid[top, c] != GREY:
+                    out[top, c] = color
+                if _in_bounds((h, w), bottom, c) and out[bottom, c] == BLACK and grid[bottom, c] != GREY:
+                    out[bottom, c] = color
+            for r in range(top + 1, bottom):
