+def _draw_shells(grid: np.ndarray, regions: list[dict]) -> np.ndarray:
+    out = np.where(grid == GREY, GREY, BLACK).astype(int)
+    depth_count = len(regions)
+    h, w = grid.shape
+    for region in _region_order(regions):
