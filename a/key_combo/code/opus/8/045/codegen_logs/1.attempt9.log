+def _clearance(box: tuple[int, int, int, int], seed: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = box
+    sr, sc = seed
+    return min(sr - r0, r1 - sr, sc - c0, c1 - sc)
+
