    sizes = _gen_feasible_sizes(count, side)
    if not sizes:
        return None

    min_sum = _GEN_ROOMY_MIN_H_PLUS_W.get(count)
    if min_sum is not None:
        roomy = [item for item in sizes if item[2] + item[3] >= min_sum]
        if roomy:
