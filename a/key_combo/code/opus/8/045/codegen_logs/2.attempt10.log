+
+
+def _bbox(cells: np.ndarray | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    arr = np.asarray(cells, dtype=int)
+    return int(arr[:, 0].min()), int(arr[:, 1].min()), int(arr[:, 0].max()), int(arr[:, 1].max())
