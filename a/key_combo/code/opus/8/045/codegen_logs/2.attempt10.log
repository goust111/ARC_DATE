+def _canonical_shape_key(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    best = None
+    for rot in range(4):
+        for flip in (False, True):
+            cand = _transform_cells(cells, rot, flip)
+            if best is None or cand < best:
+                best = cand
+    assert best is not None
+    return best
