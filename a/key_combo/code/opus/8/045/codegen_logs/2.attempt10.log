+    if not np.any(expected == GREEN) or not np.any(expected == ORANGE):
+        return False
+
+    input_mask = inp == BLUE
+    input_sym, input_asym = _classify_mask(input_mask)
+    if np.array_equal(sym, input_sym) and np.array_equal(asym, input_asym):
+        return False
+
+    moved = [
+        int(final[:, 0].min() - inp_obj[:, 0].min())
