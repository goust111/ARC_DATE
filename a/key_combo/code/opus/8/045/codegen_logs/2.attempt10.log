+        if np.any(occupied[below[:, 0], below[:, 1]] & (below[:, 0] < H - 1)):
+            stacked += 1
+        occupied[coords[:, 0], coords[:, 1]] = True
+    if stacked == 0:
+        return False
+    return True
+
