+
+def _touches_8(coords_a: np.ndarray, coords_b: np.ndarray) -> bool:
+    cells_b = {tuple(map(int, p)) for p in coords_b}
+    for r, c in coords_a:
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIR8 + [(0, 0)]:
+            if (rr + dr, cc + dc) in cells_b:
