+    occupied = np.zeros((H, W), dtype=bool)
+    occupied[-1, :] = True
+    settled_objects: list[np.ndarray] = []
+
+    center_c = W // 2 - 2
+    base = np.asarray([(H - 2, center_c + c) for _, c in SPECIAL_TEMPLATE.cells], dtype=int)
+    occupied[base[:, 0], base[:, 1]] = True
+    settled_objects.append(base)
