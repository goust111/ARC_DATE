+        for _, moved in ranked:
+            assigned[idx] = moved
+            if rec(pos + 1, int(moved[:, 0].max()), placed + [moved]):
+                return True
+            assigned[idx] = None
+        return False
+
+    if not rec(0, None, []):
+        return None
+    return [arr for arr in assigned if arr is not None]
+
