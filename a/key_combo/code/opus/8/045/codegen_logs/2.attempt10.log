+    assigned: list[np.ndarray | None] = [None] * len(settled_objects)
+
+    def rec(pos: int, prev_bottom: int | None, placed: list[np.ndarray]) -> bool:
+        if pos == len(order):
+            return True
+
+        idx = order[pos]
+        final_coords = settled_objects[idx]
