+            moved_bottom = int(moved[:, 0].max())
+            if moved_bottom >= H - 2:
+                continue
+            if prev_bottom is not None and moved_bottom >= prev_bottom:
+                continue
+            if any(_touches_8(moved, other) for other in placed):
+                continue
+            ranked.append((shift, moved))
+
