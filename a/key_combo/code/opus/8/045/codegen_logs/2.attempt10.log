+    settled = _settle_components(g)
+    out = np.zeros_like(g)
+    out[-1, :] = RED
+    mask = np.zeros(g.shape, dtype=bool)
+    for coords in settled:
+        mask[coords[:, 0], coords[:, 1]] = True
