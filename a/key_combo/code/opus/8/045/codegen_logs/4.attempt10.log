    while current < target_count and attempts < _GEN_FILLER_ATTEMPTS:
        attempts += 1
        remaining = target_count - current
        run_len = random.randint(_GEN_MIN_ORANGE_RUN, min(_GEN_MAX_ORANGE_RUN, remaining, W))
