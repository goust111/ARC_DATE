) -> bool:
    if (r, c) in route_used:
        return False
    if int(grid[r, c]) != _GEN_BG or int(expected[r, c]) != _GEN_BG:
        return False
    expected[r, c] = color
    no_orange[r, c] = True
    route_used.add((r, c))
    return True


