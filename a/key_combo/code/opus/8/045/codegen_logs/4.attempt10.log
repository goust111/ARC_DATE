+            for row in range(height // 2, height - 3)
+            for col in range(1, width - 1)
+            if col not in seed_cols
+        ]
+        random.shuffle(candidates)
+        placed = False
+        for row, col in candidates:
+            if _isolated_red_ok(base_grid, row, col):
+                red_cells.append((row, col))
