    elif b[3] < a[1]:
        dc = a[1] - b[3]
    return dr + dc


def _gen_place_patch(canvas, patch, placed_bboxes):
    H, W = canvas.shape
    h, w = patch.shape
    mask = patch != 0
    candidates = []
    for r in range(H - h + 1):
        for c in range(W - w + 1):
            bb = (r, c, r + h - 1, c + w - 1)
