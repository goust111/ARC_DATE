+        if not placed:
+            return None
+
+    inp = _compose_input(blue, hole_specs, red_cells, seed_cols, seed_row)
+    if not _semantic_checks(inp, blue, modes, seed_cols, blocker_rows, special_seed_idx, special_hole_row):
