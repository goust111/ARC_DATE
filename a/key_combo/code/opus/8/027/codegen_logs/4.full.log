import random, numpy as np
from importlib.machinery import SourceFileLoader
mod = SourceFileLoader('arc_new_4', '/home/lixinyu/snap/a/key_combo/code/opus/8/027/4.py').load_module()

def random_blob(h,w,target):
    cells={(random.randrange(h), random.randrange(w))}
    while len(cells)<target:
        frontier=set()
        for r,c in cells:
            for nr,nc in mod.neighbors8(r,c):
                if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells:
                    frontier.add((nr,nc))
        if not frontier:
            return None
        cells.add(random.choice(list(frontier)))
    arr=np.zeros((h,w),dtype=bool)
    for r,c in cells:
        arr[r,c]=1
    return arr

success=0
for _ in range(2000):
    h=random.randint(5,8)
