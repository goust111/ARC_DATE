+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+SEED_COLORS = (BLUE, RED, GREEN, YELLOW)
+
+
+Coord = tuple[int, int]
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def component_coords(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    offsets = list(neighbors4(0, 0)) if connectivity == 4 else list(neighbors8(0, 0))
+    offsets = [(dr, dc) for dr, dc in offsets]
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in offsets:
+                    nr, nc = rr + dr, cc + dc
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def mask_has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    pad = np.zeros((h + 2, w + 2), dtype=bool)
+    pad[1:-1, 1:-1] = mask
+    seen = np.zeros_like(pad, dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if in_bounds(pad.shape, nr, nc) and not seen[nr, nc] and not pad[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return bool((~pad & ~seen).any())
+
+
+def outer_track_mask(grid: np.ndarray, obstacle_mask: np.ndarray) -> np.ndarray:
+    track = np.zeros_like(obstacle_mask, dtype=bool)
+    for r, c in np.argwhere(obstacle_mask):
+        rr, cc = int(r), int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if in_bounds(grid.shape, nr, nc) and not obstacle_mask[nr, nc]:
+                track[nr, nc] = True
+    return track
+
+
+def trace_cycle(mask: np.ndarray) -> list[Coord]:
+    coords = component_coords(mask, connectivity=4)
+    assert len(coords) == 1, "track must be one 4-connected component"
+    pts = {tuple(map(int, p)) for p in coords[0]}
+    degree_map: dict[Coord, list[Coord]] = {}
+    for r, c in pts:
+        neighbors = [(nr, nc) for nr, nc in neighbors4(r, c) if (nr, nc) in pts]
+        assert len(neighbors) == 2, "track must be a simple cycle"
+        degree_map[(r, c)] = sorted(neighbors)
+
+    start = min(pts)
+    path = [start]
+    prev = start
+    cur = degree_map[start][0]
+    while cur != start:
+        path.append(cur)
+        nxt = [p for p in degree_map[cur] if p != prev]
+        assert len(nxt) == 1
+        prev, cur = cur, nxt[0]
+        assert len(path) <= len(pts)
+    assert len(path) == len(pts)
+
+    signed = 0
+    for i, (r0, c0) in enumerate(path):
+        r1, c1 = path[(i + 1) % len(path)]
+        signed += c0 * r1 - c1 * r0
+    if signed < 0:
+        path = [path[0]] + list(reversed(path[1:]))
+    return path
+
+
+def circular_distance(n: int, i: int, j: int) -> int:
+    d = abs(i - j)
+    return min(d, n - d)
+
+
+def parse_puzzle(grid: np.ndarray) -> tuple[np.ndarray, list[Coord], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = get_bg(g)
+    assert bg == BLACK, "expected black background"
+
+    obstacle_components = component_coords(g == GREY, connectivity=8)
+    assert len(obstacle_components) == 1, "expected one grey obstacle"
+    obstacle_coords = obstacle_components[0]
+    obstacle_mask = np.zeros_like(g, dtype=bool)
+    obstacle_mask[obstacle_coords[:, 0], obstacle_coords[:, 1]] = True
+    assert not mask_has_hole(obstacle_mask), "obstacle must be hole-free"
+
+    track_mask = outer_track_mask(g, obstacle_mask)
+    cycle = trace_cycle(track_mask)
+    cycle_set = set(cycle)
+    pos_to_index = {pos: i for i, pos in enumerate(cycle)}
+
+    seeds: list[dict] = []
+    used_colors = set()
+    for color in SEED_COLORS:
+        comps = component_coords(g == color, connectivity=4)
+        assert len(comps) <= 1, "each seed color may appear at most once"
+        if not comps:
+            continue
+        coords = comps[0]
+        coord_set = {tuple(map(int, p)) for p in coords}
+        claim = []
+        for pos, idx in pos_to_index.items():
+            pr, pc = pos
+            if pos in coord_set or any((nr, nc) in coord_set for nr, nc in neighbors4(pr, pc)):
+                claim.append(idx)
+        assert claim, "every seed must touch the contour track"
+        used_colors.add(color)
+        seeds.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "coord_set": coord_set,
+                "area": int(len(coords)),
+                "claim": tuple(sorted(set(claim))),
+            }
+        )
+
+    assert 2 <= len(seeds) <= 4
+    assert len({seed["color"] for seed in seeds}) == len(seeds)
+    assert len({seed["area"] for seed in seeds}) == len(seeds), "seed areas must be distinct"
+    assert len(cycle) > 2 * len(seeds), "track must be long enough for two-sided growth"
+    return obstacle_mask, cycle, seeds
+
+
+def assign_cycle_by_distance(cycle: list[Coord], seeds: list[dict]) -> dict[int, int]:
+    n = len(cycle)
+    owner: dict[int, int] = {}
+    for idx in range(n):
+        best_key = None
+        best_seed = None
+        for s_idx, seed in enumerate(seeds):
+            dist = min(circular_distance(n, idx, claim_idx) for claim_idx in seed["claim"])
+            key = (dist, -seed["area"])
+            if best_key is None or key < best_key:
+                best_key = key
+                best_seed = s_idx
+        assert best_seed is not None
+        owner[idx] = best_seed
+    return owner
+
+
+def simulate_round_growth(cycle: list[Coord], seeds: list[dict]) -> dict[int, int]:
+    n = len(cycle)
+    owner: dict[int, int] = {}
+    for idx in range(n):
+        contenders = [s_idx for s_idx, seed in enumerate(seeds) if idx in seed["claim"]]
+        if contenders:
+            owner[idx] = max(contenders, key=lambda s_idx: seeds[s_idx]["area"])
+
+    while len(owner) < n:
+        proposals: dict[int, list[int]] = {}
+        for s_idx in range(len(seeds)):
+            for idx, own in tuple(owner.items()):
+                if own != s_idx:
+                    continue
+                for nxt in ((idx - 1) % n, (idx + 1) % n):
+                    if nxt not in owner:
+                        proposals.setdefault(nxt, []).append(s_idx)
+        assert proposals, "growth stalled before covering the full track"
+        for idx, contenders in proposals.items():
+            owner[idx] = max(set(contenders), key=lambda s_idx: seeds[s_idx]["area"])
+    return owner
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor the obstacle's outer contour ring by letting unequal-size seeds compete along that one-dimensional loop.
+
+    Input structure:
+    - A black background contains one large grey obstacle and 2-4 small seed components.
+    - The grey obstacle is a single 8-connected, hole-free region.
+    - Each seed is a small 4-connected component in a distinct color from blue/red/green/yellow and touches the obstacle's outside contour neighborhood.
+
+    Rule:
+    - Build the obstacle's outer contour track: every non-grey cell that is 4-adjacent to at least one grey obstacle cell.
+    - Order that track as one closed 4-connected cycle.
+    - Each seed initially claims every track cell that is itself part of the seed or 4-adjacent to any seed pixel.
+    - Grow every seed's claimed territory simultaneously in both cycle directions; when multiple seeds reach the same track cell in the same round, the larger original seed component wins that cell.
+    - Keep the grey obstacle and every non-track cell unchanged.
+
+    Key insight:
+    - Growth happens on the obstacle's contour ring, not through the 2D plane, and equal-time contour collisions are resolved by seed area rather than by color or by clockwise order.
+    """
+    g = np.asarray(grid, dtype=int)
+    obstacle_mask, cycle, seeds = parse_puzzle(g)
+    owner = assign_cycle_by_distance(cycle, seeds)
+
+    out = g.copy()
+    for idx, (r, c) in enumerate(cycle):
+        out[r, c] = seeds[owner[idx]]["color"]
+    out[obstacle_mask] = GREY
+    return out
+
+
+def obstacle_patch() -> np.ndarray:
+    for _ in range(300):
+        h = random.randint(5, 8)
+        w = random.randint(5, 8)
+        patch = np.ones((h, w), dtype=bool)
+        notch_count = random.choices([1, 2, 3], weights=[2, 5, 3], k=1)[0]
+        changed = False
+        for _ in range(notch_count):
+            side = random.choice(["top", "bottom", "left", "right"])
+            if side in ("top", "bottom"):
+                if w < 4:
+                    continue
+                span = random.randint(1, w - 2)
+                c0 = random.randint(1, w - span - 1)
+                depth = random.randint(1, h - 2)
+                if side == "top":
+                    patch[:depth, c0 : c0 + span] = False
+                else:
+                    patch[h - depth :, c0 : c0 + span] = False
+            else:
+                if h < 4:
+                    continue
+                span = random.randint(1, h - 2)
+                r0 = random.randint(1, h - span - 1)
+                depth = random.randint(1, w - 2)
+                if side == "left":
+                    patch[r0 : r0 + span, :depth] = False
+                else:
+                    patch[r0 : r0 + span, w - depth :] = False
+            changed = True
+
+        area = int(patch.sum())
+        if not changed or not (20 <= area <= 40):
+            continue
+        comps = component_coords(patch, connectivity=8)
+        if len(comps) != 1 or mask_has_hole(patch):
+            continue
+        return patch
+    raise RuntimeError("failed to generate obstacle patch")
+
+
+def embed_obstacle(patch: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = patch.shape
+    top = random.randint(4, 6)
+    left = random.randint(4, 6)
+    bottom = random.randint(4, 6)
+    right = random.randint(4, 6)
+    grid = np.zeros((h + top + bottom, w + left + right), dtype=int)
+    obstacle_mask = np.zeros_like(grid, dtype=bool)
+    obstacle_mask[top : top + h, left : left + w] = patch
+    grid[obstacle_mask] = GREY
+    return grid, obstacle_mask
+
+
+def anchor_candidates(grid: np.ndarray, obstacle_mask: np.ndarray, cycle: list[Coord]) -> list[tuple[int, Coord, Coord]]:
+    track_mask = np.zeros_like(obstacle_mask, dtype=bool)
+    for r, c in cycle:
+        track_mask[r, c] = True
+
+    out: list[tuple[int, Coord, Coord]] = []
+    for idx, (r, c) in enumerate(cycle):
+        obstacle_neighbors = [(nr, nc) for nr, nc in neighbors4(r, c) if in_bounds(grid.shape, nr, nc) and obstacle_mask[nr, nc]]
+        if len(obstacle_neighbors) != 1:
+            continue
+        orow, ocol = obstacle_neighbors[0]
+        dr = r - orow
+        dc = c - ocol
+        if abs(dr) + abs(dc) != 1:
+            continue
+        ok = True
+        for step in (1, 2):
+            nr = r + dr * step
+            nc = c + dc * step
+            if not in_bounds(grid.shape, nr, nc) or obstacle_mask[nr, nc] or track_mask[nr, nc]:
+                ok = False
+                break
+        if ok:
+            out.append((idx, (r, c), (dr, dc)))
+    return out
+
+
+def circular_gap_ok(indices: list[int], n: int, min_gap: int) -> bool:
+    ordered = sorted(indices)
+    for i, idx in enumerate(ordered):
+        nxt = ordered[(i + 1) % len(ordered)]
+        gap = (nxt - idx) % n
+        if gap == 0 or gap < min_gap:
+            return False
+    return True
+
+
+def place_seeds(grid: np.ndarray, cycle: list[Coord], anchors: list[tuple[int, Coord, Coord]], areas: list[int], colors: list[int]) -> np.ndarray | None:
+    out = grid.copy()
+    for area, color, (_idx, (r, c), (dr, dc)) in zip(areas, colors, anchors):
+        cells = [(r + dr * step, c + dc * step) for step in range(area)]
+        for rr, cc in cells:
+            if not in_bounds(out.shape, rr, cc) or out[rr, cc] != BLACK:
+                return None
+        for rr, cc in cells:
+            out[rr, cc] = color
+    return out
+
+
+def contested_indices(cycle: list[Coord], seeds: list[dict]) -> set[int]:
+    n = len(cycle)
+    out: set[int] = set()
+    for idx in range(n):
+        distances = []
+        for s_idx, seed in enumerate(seeds):
+            dist = min(circular_distance(n, idx, claim_idx) for claim_idx in seed["claim"])
+            distances.append((dist, s_idx))
+        best_dist = min(dist for dist, _s_idx in distances)
+        tied = [s_idx for dist, s_idx in distances if dist == best_dist]
+        if len(tied) >= 2:
+            out.add(idx)
+    return out
+
+
+def validate_instance(grid: np.ndarray) -> bool:
+    try:
+        obstacle_mask, cycle, seeds = parse_puzzle(grid)
+    except Exception:
+        return False
+
+    owner_by_distance = assign_cycle_by_distance(cycle, seeds)
+    owner_by_rounds = simulate_round_growth(cycle, seeds)
+    if owner_by_distance != owner_by_rounds:
+        return False
