_GEN_SKELETON_CACHE = {}


def _gen_skeleton_pool(size):
    size = int(size)
    if size in _GEN_SKELETON_CACHE:
        return _GEN_SKELETON_CACHE[size]

    shapes = {frozenset({(0, 0)})}
    for _ in range(size - 1):
