+    pad = np.zeros((h + 2, w + 2), dtype=bool)
+    pad[1:-1, 1:-1] = mask
+    seen = np.zeros_like(pad, dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
