+def outer_track_mask(grid: np.ndarray, obstacle_mask: np.ndarray) -> np.ndarray:
+    track = np.zeros_like(obstacle_mask, dtype=bool)
+    for r, c in np.argwhere(obstacle_mask):
+        rr, cc = int(r), int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if in_bounds(grid.shape, nr, nc) and not obstacle_mask[nr, nc]:
+                track[nr, nc] = True
+    return track
+
+
+def trace_cycle(mask: np.ndarray) -> list[Coord]:
+    coords = component_coords(mask, connectivity=4)
+    assert len(coords) == 1, "track must be one 4-connected component"
+    pts = {tuple(map(int, p)) for p in coords[0]}
+    degree_map: dict[Coord, list[Coord]] = {}
+    for r, c in pts:
+        neighbors = [(nr, nc) for nr, nc in neighbors4(r, c) if (nr, nc) in pts]
+        assert len(neighbors) == 2, "track must be a simple cycle"
+        degree_map[(r, c)] = sorted(neighbors)
+
+    start = min(pts)
+    path = [start]
+    prev = start
+    cur = degree_map[start][0]
+    while cur != start:
+        path.append(cur)
+        nxt = [p for p in degree_map[cur] if p != prev]
+        assert len(nxt) == 1
+        prev, cur = cur, nxt[0]
+        assert len(path) <= len(pts)
+    assert len(path) == len(pts)
