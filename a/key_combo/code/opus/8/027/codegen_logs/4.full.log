+    n = len(cycle)
+    owner: dict[int, int] = {}
+    for idx in range(n):
+        contenders = [s_idx for s_idx, seed in enumerate(seeds) if idx in seed["claim"]]
+        if contenders:
+            owner[idx] = max(contenders, key=lambda s_idx: seeds[s_idx]["area"])
+
+    while len(owner) < n:
+        proposals: dict[int, list[int]] = {}
+        for s_idx in range(len(seeds)):
+            for idx, own in tuple(owner.items()):
+                if own != s_idx:
+                    continue
+                for nxt in ((idx - 1) % n, (idx + 1) % n):
+                    if nxt not in owner:
+                        proposals.setdefault(nxt, []).append(s_idx)
+        assert proposals, "growth stalled before covering the full track"
+        for idx, contenders in proposals.items():
+            owner[idx] = max(set(contenders), key=lambda s_idx: seeds[s_idx]["area"])
+    return owner
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor the obstacle's outer contour ring by letting unequal-size seeds compete along that one-dimensional loop.
+
+    Input structure:
+    - A black background contains one large grey obstacle and 2-4 small seed components.
+    - The grey obstacle is a single 8-connected, hole-free region.
+    - Each seed is a small 4-connected component in a distinct color from blue/red/green/yellow and touches the obstacle's outside contour neighborhood.
+
+    Rule:
+    - Build the obstacle's outer contour track: every non-grey cell that is 4-adjacent to at least one grey obstacle cell.
+    - Order that track as one closed 4-connected cycle.
+    - Each seed initially claims every track cell that is itself part of the seed or 4-adjacent to any seed pixel.
+    - Grow every seed's claimed territory simultaneously in both cycle directions; when multiple seeds reach the same track cell in the same round, the larger original seed component wins that cell.
+    - Keep the grey obstacle and every non-track cell unchanged.
+
+    Key insight:
+    - Growth happens on the obstacle's contour ring, not through the 2D plane, and equal-time contour collisions are resolved by seed area rather than by color or by clockwise order.
+    """
+    g = np.asarray(grid, dtype=int)
+    obstacle_mask, cycle, seeds = parse_puzzle(g)
+    owner = assign_cycle_by_distance(cycle, seeds)
+
+    out = g.copy()
+    for idx, (r, c) in enumerate(cycle):
+        out[r, c] = seeds[owner[idx]]["color"]
+    out[obstacle_mask] = GREY
+    return out
+
+
+def obstacle_patch() -> np.ndarray:
+    for _ in range(300):
+        h = random.randint(5, 8)
+        w = random.randint(5, 8)
+        patch = np.ones((h, w), dtype=bool)
+        notch_count = random.choices([1, 2, 3], weights=[2, 5, 3], k=1)[0]
+        changed = False
+        for _ in range(notch_count):
+            side = random.choice(["top", "bottom", "left", "right"])
+            if side in ("top", "bottom"):
+                if w < 4:
+                    continue
+                span = random.randint(1, w - 2)
+                c0 = random.randint(1, w - span - 1)
+                depth = random.randint(1, h - 2)
+                if side == "top":
+                    patch[:depth, c0 : c0 + span] = False
+                else:
+                    patch[h - depth :, c0 : c0 + span] = False
+            else:
+                if h < 4:
+                    continue
+                span = random.randint(1, h - 2)
+                r0 = random.randint(1, h - span - 1)
+                depth = random.randint(1, w - 2)
+                if side == "left":
+                    patch[r0 : r0 + span, :depth] = False
+                else:
+                    patch[r0 : r0 + span, w - depth :] = False
+            changed = True
+
+        area = int(patch.sum())
+        if not changed or not (20 <= area <= 40):
+            continue
+        comps = component_coords(patch, connectivity=8)
+        if len(comps) != 1 or mask_has_hole(patch):
+            continue
+        return patch
+    raise RuntimeError("failed to generate obstacle patch")
+
+
+def embed_obstacle(patch: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = patch.shape
+    top = random.randint(4, 6)
+    left = random.randint(4, 6)
+    bottom = random.randint(4, 6)
+    right = random.randint(4, 6)
+    grid = np.zeros((h + top + bottom, w + left + right), dtype=int)
+    obstacle_mask = np.zeros_like(grid, dtype=bool)
+    obstacle_mask[top : top + h, left : left + w] = patch
+    grid[obstacle_mask] = GREY
+    return grid, obstacle_mask
+
+
+def anchor_candidates(grid: np.ndarray, obstacle_mask: np.ndarray, cycle: list[Coord]) -> list[tuple[int, Coord, Coord]]:
+    track_mask = np.zeros_like(obstacle_mask, dtype=bool)
+    for r, c in cycle:
+        track_mask[r, c] = True
+
+    out: list[tuple[int, Coord, Coord]] = []
+    for idx, (r, c) in enumerate(cycle):
+        obstacle_neighbors = [(nr, nc) for nr, nc in neighbors4(r, c) if in_bounds(grid.shape, nr, nc) and obstacle_mask[nr, nc]]
+        if len(obstacle_neighbors) != 1:
+            continue
+        orow, ocol = obstacle_neighbors[0]
+        dr = r - orow
+        dc = c - ocol
+        if abs(dr) + abs(dc) != 1:
+            continue
+        ok = True
+        for step in (1, 2):
+            nr = r + dr * step
+            nc = c + dc * step
+            if not in_bounds(grid.shape, nr, nc) or obstacle_mask[nr, nc] or track_mask[nr, nc]:
+                ok = False
+                break
+        if ok:
+            out.append((idx, (r, c), (dr, dc)))
+    return out
+
+
+def circular_gap_ok(indices: list[int], n: int, min_gap: int) -> bool:
+    ordered = sorted(indices)
+    for i, idx in enumerate(ordered):
+        nxt = ordered[(i + 1) % len(ordered)]
+        gap = (nxt - idx) % n
+        if gap == 0 or gap < min_gap:
+            return False
+    return True
+
+
+def place_seeds(grid: np.ndarray, cycle: list[Coord], anchors: list[tuple[int, Coord, Coord]], areas: list[int], colors: list[int]) -> np.ndarray | None:
+    out = grid.copy()
+    for area, color, (_idx, (r, c), (dr, dc)) in zip(areas, colors, anchors):
+        cells = [(r + dr * step, c + dc * step) for step in range(area)]
+        for rr, cc in cells:
+            if not in_bounds(out.shape, rr, cc) or out[rr, cc] != BLACK:
+                return None
+        for rr, cc in cells:
+            out[rr, cc] = color
+    return out
+
+
+def contested_indices(cycle: list[Coord], seeds: list[dict]) -> set[int]:
+    n = len(cycle)
+    out: set[int] = set()
+    for idx in range(n):
+        distances = []
+        for s_idx, seed in enumerate(seeds):
+            dist = min(circular_distance(n, idx, claim_idx) for claim_idx in seed["claim"])
+            distances.append((dist, s_idx))
+        best_dist = min(dist for dist, _s_idx in distances)
+        tied = [s_idx for dist, s_idx in distances if dist == best_dist]
+        if len(tied) >= 2:
+            out.add(idx)
+    return out
+
+
+def validate_instance(grid: np.ndarray) -> bool:
+    try:
+        obstacle_mask, cycle, seeds = parse_puzzle(grid)
+    except Exception:
+        return False
+
+    owner_by_distance = assign_cycle_by_distance(cycle, seeds)
+    owner_by_rounds = simulate_round_growth(cycle, seeds)
+    if owner_by_distance != owner_by_rounds:
+        return False
+
+    contested = contested_indices(cycle, seeds)
+    if not contested:
+        return False
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+
+    track_set = set(cycle)
+    growth_visible = []
+    for s_idx, seed in enumerate(seeds):
+        won = {cycle[idx] for idx, owner in owner_by_distance.items() if owner == s_idx}
+        if not (won - seed["coord_set"]):
+            return False
+        growth_visible.append(len(won))
+    if len(set(growth_visible)) == 1:
+        return False
+
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            if (r, c) not in track_set and not obstacle_mask[r, c]:
+                if out[r, c] != grid[r, c]:
+                    return False
+
+    if out.shape[0] > 30 or out.shape[1] > 30:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid, obstacle_mask = embed_obstacle(obstacle_patch())
+        track = trace_cycle(outer_track_mask(grid, obstacle_mask))
+        if len(track) < 16:
+            continue
+
+        candidates = anchor_candidates(grid, obstacle_mask, track)
+        if len(candidates) < 2:
+            continue
+
+        if len(candidates) >= 3 and random.random() < 0.7:
+            k = 3
+        else:
+            k = 2
+
+        areas = random.sample([1, 2, 3], k)
+        colors = random.sample(list(SEED_COLORS), k)
+
+        for _ in range(80):
+            chosen = random.sample(candidates, k)
+            indices = [idx for idx, _pos, _dir in chosen]
+            if not circular_gap_ok(indices, len(track), min_gap=4):
+                continue
+            random.shuffle(areas)
+            puzzle = place_seeds(grid, track, chosen, areas, colors)
+            if puzzle is None:
+                continue
+            if validate_instance(puzzle):
+                return puzzle
+
+    raise RuntimeError("failed to generate a valid contour-growth puzzle")

