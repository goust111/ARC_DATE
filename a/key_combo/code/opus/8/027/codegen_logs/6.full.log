+        coords = _shift_shape(shape, top, left)
+        if occupied[coords[:, 0], coords[:, 1]].any():
+            return None
+        occupied[coords[:, 0], coords[:, 1]] = True
+        placements.append({"area": area, "color": color, "coords": coords})
+    return placements
+
