+    obstacle_cols = _component_columns(obstacle["coords"])
+    top_profile = []
+    for col in sorted(obstacle_cols):
+        rows = obstacle["coords"][obstacle["coords"][:, 1] == col][:, 0]
+        top_profile.append(int(rows.min()))
+
