+    out = np.full(shape, int(bg), dtype=int)
+    for orientation in ("horizontal", "vertical"):
+        for seg in segments:
+            if seg["orientation"] != orientation:
+                continue
+            color = int(color_map.get(seg["color"], seg["color"])) if color_map else int(seg["color"])
+            for r, c in seg["cells"]:
