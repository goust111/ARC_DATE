+
+
+def _transforms() -> list[Callable[[np.ndarray], np.ndarray]]:
+    return [
+        lambda g: g.copy(),
+        lambda g: np.rot90(g, 1).copy(),
+        lambda g: np.rot90(g, 2).copy(),
+        lambda g: np.rot90(g, 3).copy(),
+        lambda g: np.fliplr(g).copy(),
+        lambda g: np.flipud(g).copy(),
