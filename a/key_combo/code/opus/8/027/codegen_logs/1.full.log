+
+
+def _vertical_span(row_lo: int, row_hi: int, min_len: int = 4) -> tuple[int, int] | None:
+    if row_hi - row_lo + 1 < min_len:
+        return None
+    options = []
+    for r0 in range(row_lo, row_hi + 1):
+        for r1 in range(r0 + min_len - 1, row_hi + 1):
+            options.append((r0, r1))
