+
+def _visible_shortcut(grid: np.ndarray) -> np.ndarray:
+    info = _analyze(grid)
+    seen: list[int] = []
+    for r, c in info["ray"]:
+        color = int(info["composite"][r, c])
+        if color != info["bg"] and color not in seen:
