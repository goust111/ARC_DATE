+    random.shuffle(outer_positions)
+    for top, left in outer_positions:
+        specs = [
+            {**outer, "p4": (int(top), int(left))},
+            {**inner1, "p4": (int(top + 1), int(left + 1))},
+            {**inner2, "p4": (int(top + 2), int(left + 1))},
+        ]
+        if _semantic_ok(specs, height, width):
