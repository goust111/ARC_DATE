+    if not pts:
+        return False
+    stack = [next(iter(pts))]
+    seen = set()
+    while stack:
+        cur = stack.pop()
+        if cur in seen:
+            continue
+        seen.add(cur)
+        for nxt in _neighbors4(*cur):
+            if nxt in pts and nxt not in seen:
+                stack.append(nxt)
+    return len(seen) == len(pts)
