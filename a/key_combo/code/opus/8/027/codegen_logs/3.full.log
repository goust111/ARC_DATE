+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(9, 10)
+    width = random.randint(8, 10)
+    scenario = random.choices(
+        ["single_h_2", "single_h_3", "single_v_2", "single_v_3", "double_h"],
+        weights=[18, 24, 18, 24, 16],
+        k=1,
+    )[0]
