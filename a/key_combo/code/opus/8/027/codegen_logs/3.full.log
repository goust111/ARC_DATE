+def _in_panel(shape: np.ndarray, top: int, left: int, height: int, width: int) -> bool:
+    h, w = _shape_dims(shape)
+    return 1 <= int(top) and int(top + h) <= int(height - 1) and 1 <= int(left) and int(left + w) <= int(width - 1)
