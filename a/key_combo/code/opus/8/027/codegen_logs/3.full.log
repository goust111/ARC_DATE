+
+
+def _blank_panel(height: int, width: int) -> np.ndarray:
+    out = np.zeros((int(height), int(width)), dtype=int)
+    out[0, :] = FRAME
+    out[-1, :] = FRAME
+    out[:, 0] = FRAME
