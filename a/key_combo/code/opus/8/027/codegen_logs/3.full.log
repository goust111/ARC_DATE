+
+
+def _pos_at(obj: dict, t: int) -> tuple[int, int]:
+    dr, dc = obj["delta"]
+    r4, c4 = obj["p4"]
+    step = 4 - int(t)
+    return int(r4 - step * dr), int(c4 - step * dc)
+
