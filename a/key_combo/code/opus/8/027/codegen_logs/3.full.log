+    "square": _rows_to_shape("##", "##"),
+    "el": _rows_to_shape("#.", "##"),
+    "line3_h": _rows_to_shape("###"),
+    "line3_v": _rows_to_shape("#", "#", "#"),
+    "zig5": _rows_to_shape("##.", ".##", "..#"),
