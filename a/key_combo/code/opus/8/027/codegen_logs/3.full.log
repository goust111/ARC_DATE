+        "color": int(colors[1]),
+        "shape": SHAPES["dom_h"],
+        "delta": (int(shift_r), 1),
+        "p4": None,
+    }
+    inner2 = {
+        "color": int(colors[2]),
+        "shape": SHAPES["dom_h"],
+        "delta": (int(shift_r), 1),
+        "p4": None,
