                _gen_right = RIGHT_CENTER_COL + _gen_p
                _gen_blob[_gen_r, _gen_left] = True
                _gen_blob[_gen_r, _gen_right] = True
                _gen_right_cells.append((_gen_r, _gen_right))
    return _gen_blob, _gen_right_cells


