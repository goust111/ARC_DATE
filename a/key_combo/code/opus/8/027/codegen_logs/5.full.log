+    pts = {(int(r), int(c)) for r, c in cells}
+    for _ in range(int(rot) % 4):
+        pts = {(int(c), int(-r)) for r, c in pts}
+    if flip:
+        pts = {(int(r), int(-c)) for r, c in pts}
+    return _normalize(pts)
