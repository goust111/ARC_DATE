+
+def _fits(cells: set[tuple[int, int]], occupied: set[tuple[int, int]], shape: tuple[int, int] = HALF_SHAPE) -> bool:
+    h, w = shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied:
+            return False
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in occupied:
+                return False
+    return True
