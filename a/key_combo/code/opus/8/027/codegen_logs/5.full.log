+def _build_input(components: list[dict]) -> np.ndarray:
+    top_components = [comp for comp in components if comp["color"] in components[0:0] or True]
+    top = []
+    bottom = []
+    split = len(components) // 2
+    for idx, comp in enumerate(components):
+        if idx < split:
+            top.append(comp)
+        else:
+            bottom.append(comp)
+    grid = np.full(GRID_SHAPE, BG, dtype=int)
+    grid[HALF_SHAPE[0], :] = SEP
+    grid[: HALF_SHAPE[0], :] = _render_half(top)
+    grid[HALF_SHAPE[0] + 1 :, :] = _render_half(bottom)
+    return grid
