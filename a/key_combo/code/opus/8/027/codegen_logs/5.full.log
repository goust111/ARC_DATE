+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nbr in neighbors4(*cell):
+            if nbr in cells and nbr not in seen:
+                stack.append(nbr)
+    return seen == cells
