+    merged, _winners, _conflict_wins, _top_components, _bottom_components = _merge_halves(top, bottom)
+
+    out = merged.copy()
+    components = find_components(
+        merged,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=FG_COLORS,
+        return_format="dict",
+    )
+    for comp in components:
+        color = _bucket_color(int(comp["area"]))
+        coords = comp["coords"]
+        out[coords[:, 0], coords[:, 1]] = color
+    return out
