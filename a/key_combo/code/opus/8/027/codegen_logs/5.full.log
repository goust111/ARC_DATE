+    top, bottom = _split_grid(grid)
+    merged, _winners, _conflict_wins, _top_components, _bottom_components = _merge_halves(top, bottom)
+
+    out = merged.copy()
+    components = find_components(
+        merged,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=FG_COLORS,
+        return_format="dict",
