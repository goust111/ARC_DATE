+            bottom_colors = _assign_colors(bottom_areas, bottom_palette)
+            for comp, color in zip(top_components, top_colors):
+                comp["color"] = int(color)
+            for comp, color in zip(bottom_components, bottom_colors):
+                comp["color"] = int(color)
+            return top_components + bottom_components
+    return None
+
+
+def _build_input(components: list[dict]) -> np.ndarray:
+    top_components = [comp for comp in components if comp["color"] in components[0:0] or True]
+    top = []
+    bottom = []
+    split = len(components) // 2
+    for idx, comp in enumerate(components):
+        if idx < split:
+            top.append(comp)
+        else:
+            bottom.append(comp)
