+def _normalize(cells: set[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    rows = [int(r) for r, _ in cells]
+    cols = [int(c) for _, c in cells]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in cells))
