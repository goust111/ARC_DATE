+def _count_choices() -> tuple[int, int]:
+    options = [
+        (2, 2),
+        (2, 3),
+        (3, 2),
+        (3, 3),
+        (2, 4),
+        (4, 2),
+        (3, 4),
+        (4, 3),
+        (4, 4),
+    ]
+    weights = [5, 5, 5, 5, 2, 2, 1, 1, 1]
+    return random.choices(options, weights=weights, k=1)[0]
