+
+
+def validate_generated_case(inp: np.ndarray) -> bool:
+    boxes = region_boxes(inp, divider=DIVIDER)
+    if len(boxes) not in {4, 6}:
+        return False
+
+    sprites = []
+    empty_boxes = []
+    colors = set()
+    min_empty_h = min(box[2] - box[0] + 1 for box in boxes)
