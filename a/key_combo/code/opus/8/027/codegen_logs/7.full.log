+
+    left_only_changed = False
+    for r, c in np.argwhere(left_only):
+        if _apply_chain(int(left[r, c]), pairs) != int(left[r, c]):
+            left_only_changed = True
+            break
+    if not left_only_changed:
+        return False
+
+    alt_right_source = np.zeros_like(out)
+    h, w = left.shape
+    for r in range(h):
