+
+def _solve_panels(left: np.ndarray, right: np.ndarray, pairs: list[tuple[int, int]]) -> np.ndarray:
+    assert left.shape == right.shape
+    out = np.zeros_like(left)
+    h, w = left.shape
+    for r in range(h):
+        for c in range(w):
+            lv = int(left[r, c])
+            rv = int(right[r, c])
+            if lv == BG and rv == BG:
+                continue
+            if lv != BG and rv != BG:
+                out[r, c] = _apply_chain(lv, pairs)
+            else:
+                out[r, c] = lv if lv != BG else rv
