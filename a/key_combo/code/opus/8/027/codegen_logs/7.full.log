+PANEL_W_RANGE = (6, 10)
+EXTRA_OVERLAP_RANGE = (1, 5)
+EXTRA_LEFT_ONLY_RANGE = (1, 4)
+EXTRA_RIGHT_ONLY_RANGE = (1, 4)
