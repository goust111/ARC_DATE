+            return None
+
+    grid = _render_input(
+        rng=rng,
+        mask_h=mask_h,
+        mask_w=mask_w,
+        top_gap=top_gap,
+        bottom_margin=bottom_margin,
+        seed_h=seed_h,
+        seed_w=seed_w,
+        rep_h=rep_h,
+        rep_w=rep_w,
+        seed_row=seed_row,
+        seed_col=seed_col,
+        left_seed=left_seed,
+        right_seed=right_seed,
+        frame_side=frame_side,
+        frame_outer_margin=frame_outer_margin,
