+
+
+def _render_input(
+    rng: np.random.Generator,
+    mask_h: int,
+    mask_w: int,
+    top_gap: int,
+    bottom_margin: int,
+    seed_h: int,
+    seed_w: int,
+    rep_h: int,
+    rep_w: int,
+    seed_row: int,
+    seed_col: int,
+    left_seed: np.ndarray,
+    right_seed: np.ndarray,
+    frame_side: str,
+    frame_outer_margin: int,
+) -> np.ndarray:
+    sep = mask_w
+    cavity_h = seed_h * rep_h
+    cavity_w = seed_w * rep_w
+    frame_h = cavity_h + 2
+    frame_w = cavity_w + 2
+    height = mask_h + top_gap + frame_h + bottom_margin
+    width = mask_w * 2 + 1
