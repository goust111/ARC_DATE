GEN_GRID_ROWS = (21, 25)
GEN_GRID_COLS = (21, 26)
GEN_FRAME_ROWS = (7, 10)
GEN_FRAME_COLS = (6, 9)
GEN_FRAME_MARGIN = 4

# Colors and corner labels.
GEN_FRAME_COLOR = 8
GEN_COLOR_VALUES = tuple(range(1, 10))
GEN_CORNERS = ("tl", "tr", "bl", "br")
GEN_MARKER_COLOR_POOL_SIZE = (6, 7)

