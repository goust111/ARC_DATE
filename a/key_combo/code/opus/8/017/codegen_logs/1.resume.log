+    right_c0 = sep + 1 + seed_col
+    grid[seed_row : seed_row + seed_h, right_c0 : right_c0 + seed_w] = np.where(right_seed, YELLOW, BLACK)
+
+    frame_r0 = mask_h + top_gap
+    frame_r1 = frame_r0 + frame_h - 1
