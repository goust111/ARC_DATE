+    quadrants = list(_quadrants(grid.shape, cross_r, cross_c).items())
+    for (name, (rs, cs)), color in zip(quadrants, colors):
+        qh = rs.stop - rs.start
+        qw = cs.stop - cs.start
+        region = _shape_with_noise(qh, qw, color)
