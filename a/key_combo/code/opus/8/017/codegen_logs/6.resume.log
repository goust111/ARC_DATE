+            dom_bbox = bbox(clean)
+            if dom_bbox is None:
+                return False
+            r0, c0, r1, c1 = dom_bbox
+            if r0 == 0 or c0 == 0 or r1 == region.shape[0] - 1 or c1 == region.shape[1] - 1:
+                return False
