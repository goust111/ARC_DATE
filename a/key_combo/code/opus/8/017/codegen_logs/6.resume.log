+    out = np.full_like(g, BG)
+    out[cross_r, :] = sep
+    out[:, cross_c] = sep
+
+    axes = {"UL": "horizontal", "UR": "vertical", "LL": "vertical", "LR": "horizontal"}
+    for name, (rs, cs) in _quadrants(g.shape, cross_r, cross_c).items():
