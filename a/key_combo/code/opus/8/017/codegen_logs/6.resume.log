+def _find_separator_cross(grid: np.ndarray) -> tuple[int, int, int]:
+    h, w = grid.shape
+    solid_rows = [(r, int(grid[r, 0])) for r in range(h) if np.all(grid[r, :] == grid[r, 0])]
+    solid_cols = [(c, int(grid[0, c])) for c in range(w) if np.all(grid[:, c] == grid[0, c])]
