+    counts = Counter(values)
+    assert counts, "quadrant must contain foreground"
+    ranked = counts.most_common()
+    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "quadrant dominant color must be unique"
+    return int(ranked[0][0])
