+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(14, 20)
+    w = random.randint(14, 20)
+    cross_r = random.randint(5, h - 6)
+    cross_c = random.randint(5, w - 6)
+    grid = np.zeros((h, w), dtype=int)
+    grid[cross_r, :] = SEP
+    grid[:, cross_c] = SEP
