  10: def main(grid: np.ndarray) -> np.ndarray:
  11:     """
  12:     Redraw foreground objects as nested square rings ordered by object size.
  13: 
  14:     Input structure:
  15:     - The grid has one dominant background color.
  16:     - Every foreground object is a 4-connected monochromatic component.
  17:     - Foreground object areas are distinct.
  18: 
  19:     Rule:
  20:     - Sort the foreground objects by decreasing pixel count.
  21:     - Create a square output with side length 2 * number_of_objects - 1.
  22:     - The largest object color fills the outer ring, each next object color fills
  23:       the next inner ring, and the smallest object color fills the center pixel.
  24: 
  25:     Key insight: The objects' original shapes do not get copied; their areas
  26:     determine only the outside-to-inside order of the nested square pattern.
  27:     """
  28:     g = np.asarray(grid, dtype=int)
  29:     bg = get_bg(g)
  30:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  31:     assert objects, "expected at least one foreground object"
  32: 
  33:     areas = [int(obj["area"]) for obj in objects]
  34:     assert len(areas) == len(set(areas)), "foreground object areas must be unique"
  35: 
  36:     ordered = sorted(objects, key=lambda obj: int(obj["area"]), reverse=True)
  37:     colors = [int(obj["color"]) for obj in ordered]
  38:     side = 2 * len(colors) - 1
  39: 
  40:     out = np.full((side, side), colors[0], dtype=int)
  41:     for layer, color in enumerate(colors[1:], start=1):
  42:         out[layer : side - layer, layer : side - layer] = int(color)
  43:     return out
