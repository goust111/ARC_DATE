+                "row_count": int(len(rows)),
+                "raw": raw,
+                "gaps": gaps,
+                "filled": raw + gaps,
+                "max_row_span": max(int(np.where(g[r] == color)[0][-1] - np.where(g[r] == color)[0][0] + 1) for r in rows),
