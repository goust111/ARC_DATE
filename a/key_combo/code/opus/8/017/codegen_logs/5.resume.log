+                "rows": tuple(map(int, rows)),
+                "top": int(rows.min()),
+                "row_count": int(len(rows)),
+                "raw": raw,
+                "gaps": gaps,
+                "filled": raw + gaps,
+                "max_row_span": max(int(np.where(g[r] == color)[0][-1] - np.where(g[r] == color)[0][0] + 1) for r in rows),
+            }
+        )
+    return stats
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """补齐每种颜色虚线中的单像素间隙后，按补填覆盖面积重排为同心方环。
