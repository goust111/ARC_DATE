+    row_counts = [1 + int(rng.random() < 0.45) for _ in range(color_count)]
+    if color_count >= 4 and (1 not in row_counts or 2 not in row_counts):
+        return None
+
+    colors = rng.choice(PALETTE, size=color_count, replace=False).tolist()
+    rng.shuffle(colors)
