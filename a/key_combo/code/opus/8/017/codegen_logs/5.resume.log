import numpy as np
from collections import Counter

rng = np.random.default_rng()

PALETTE = [1,2,3,4,5,6,7,8,9]

def get_bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]

def color_stats(grid):
    bg = get_bg(grid)
    stats = []
