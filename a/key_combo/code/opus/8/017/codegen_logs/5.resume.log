  15: def main(grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Compress the noisy four-region board split by a solid cross into a 3x3 color map.
  18: 
  19:     Input structure:
  20:     - A single full row and a single full column have the same solid separator color.
  21:     - The separator cross divides the input into four nonempty rectangular regions.
  22:     - Each region has a unique dominant color, with other colors acting as noise.
  23: 
  24:     Rule:
  25:     - Find the unique solid same-color row/column pair.
  26:     - Fill the middle row and middle column of the 3x3 output with the separator color.
  27:     - Put the unique dominant color of each quadrant into the corresponding corner.
  28: 
  29:     Key insight:
  30:     - The input grid is a noisy enlarged version of the desired 3x3 layout; the cross marks the coarse cell boundaries.
  31:     """
  32:     g = np.asarray(grid, dtype=int)
  33:     assert g.ndim == 2, "expected a 2D grid"
  34:     height, width = map(int, g.shape)
  35: 
  36:     solid_rows = [
  37:         (row, int(g[row, 0]))
  38:         for row in range(height)
  39:         if np.all(g[row, :] == int(g[row, 0]))
  40:     ]
  41:     solid_cols = [
  42:         (col, int(g[0, col]))
  43:         for col in range(width)
  44:         if np.all(g[:, col] == int(g[0, col]))
  45:     ]
  46:     crosses = [
  47:         (row, col, row_color)
  48:         for row, row_color in solid_rows
  49:         for col, col_color in solid_cols
  50:         if row_color == col_color
  51:     ]
  52:     assert len(crosses) == 1, "expected exactly one solid same-color separator cross"
  53: 
  54:     cross_row, cross_col, separator = crosses[0]
  55:     assert 0 < cross_row < height - 1, "separator row must split nonempty top and bottom regions"
  56:     assert 0 < cross_col < width - 1, "separator column must split nonempty left and right regions"
  57: 
  58:     out = np.full((3, 3), int(separator), dtype=int)
  59:     regions = [
  60:         ((slice(0, cross_row), slice(0, cross_col)), (0, 0)),
  61:         ((slice(0, cross_row), slice(cross_col + 1, width)), (0, 2)),
  62:         ((slice(cross_row + 1, height), slice(0, cross_col)), (2, 0)),
  63:         ((slice(cross_row + 1, height), slice(cross_col + 1, width)), (2, 2)),
  64:     ]
  65:     for src, dst in regions:
  66:         out[dst] = _unique_mode(g[src])
