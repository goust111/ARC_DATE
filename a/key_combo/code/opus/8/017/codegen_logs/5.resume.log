+            span = int(rng.integers(min_span, max_span + 1))
+            pattern = _build_row_pattern(span, run_count, rng)
+            rows.append({"span": span, "pattern": pattern, "gaps": run_count - 1})
+            raw_total += int(pattern.sum())
+            filled_total += span
+            max_row_span = max(max_row_span, span)
+        specs.append(
