+import numpy as np
+from collections import Counter
+
+
+BG = 0
+PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+GRID_HEIGHT_RANGE = (11, 18)
+GRID_WIDTH_RANGE = (16, 25)
+COLOR_COUNT_RANGE = (3, 5)
