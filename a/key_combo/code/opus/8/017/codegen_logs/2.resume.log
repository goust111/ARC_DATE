+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(rows, r0 + h + gap)
+    cc1 = min(cols, c0 + w + gap)
+    if np.any(grid[rr0:rr1, cc0:cc1] != BLACK):
