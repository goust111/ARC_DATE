+
+def _place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = map(int, patch.shape)
+    view = grid[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BLACK
+    view[mask] = patch[mask]
