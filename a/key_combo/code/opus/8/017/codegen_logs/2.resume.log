+    for patch, r0 in zip(anchor_patches, row_starts):
+        placed = False
+        for _ in range(80):
+            c0 = int(rng.integers(0, cols - patch.shape[1] + 1))
+            if not _can_place_patch(grid, patch, int(r0), c0):
+                continue
+            _place_patch(grid, patch, int(r0), c0)
+            placed = True
