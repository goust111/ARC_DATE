+
+
+def _noise_patch(rng: np.random.Generator) -> np.ndarray:
+    return _transform_mask(NOISE_LIBRARY[int(rng.integers(0, len(NOISE_LIBRARY)))], rng)
+
+
+def _colorize_mask(mask: np.ndarray, color: int) -> np.ndarray:
