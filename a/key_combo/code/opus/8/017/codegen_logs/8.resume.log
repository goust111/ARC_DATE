+                inner_boundary = np.array(
+                    [
+                        (r, c)
+                        for r, c in np.argwhere(component_mask)
+                        if _touches_mask8(patch == BLUE, int(r), int(c))
+                    ],
+                    dtype=int,
+                )
+                core_area = int(component_mask.sum()) - len(inner_boundary)
+                if core_area <= 0:
