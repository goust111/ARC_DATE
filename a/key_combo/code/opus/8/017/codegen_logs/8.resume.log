+        return mask
+    return None
+
+
+def _build_ring_patch(hole_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    h, w = hole_mask.shape
+    patch = np.zeros((h + 4, w + 4), dtype=int)
+    local_hole = np.zeros_like(patch, dtype=bool)
+    local_hole[2 : 2 + h, 2 : 2 + w] = hole_mask
