+    ph, pw = patch_shape
+    pos = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            r1, c1 = r0 + ph - 1, c0 + pw - 1
+            ok = True
+            for br0, bc0, br1, bc1 in boxes:
+                if not (r1 + gap < br0 or br1 + gap < r0 or c1 + gap < bc0 or bc1 + gap < c0):
