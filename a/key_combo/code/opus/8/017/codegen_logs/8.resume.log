+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    infos = _analyze_scene(g)
+    out = g.copy()
+
+    for info in infos:
+        r0, c0, r1, c1 = info["hole_bbox"]
+        tile = info["tile"]
+        tile_h, tile_w = tile.shape
+        for r, c in info["coords"]:
