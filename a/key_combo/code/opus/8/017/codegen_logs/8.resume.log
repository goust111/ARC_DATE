+            # keep the blue wall itself 4-connected.
+            for dr, dc in DIR8:
+                nr, nc = r + dr, c + dc
+                if _in_bounds(patch.shape, nr, nc) and local_hole[nr, nc]:
+                    ring[r, c] = True
