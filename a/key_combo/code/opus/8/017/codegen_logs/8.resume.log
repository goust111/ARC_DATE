+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+PALETTE = [2, 3, 4, 5, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
