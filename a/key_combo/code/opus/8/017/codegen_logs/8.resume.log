+        "actual_high": actual_high,
+        "actual_low": actual_low,
+        "seed_high": seed_high,
+        "seed_low": seed_low,
+        "anchor_diff": bool(np.any(rect_fill[hole_mask] != seed_fill[hole_mask])),
+    }
