+def _transform_patch(patch: np.ndarray) -> np.ndarray:
+    out = np.asarray(patch, dtype=int)
+    if random.random() < 0.8:
+        out = np.rot90(out, random.randint(0, 3))
+    if random.random() < 0.5:
