+        hole_h = hr1 - hr0 + 1
+        hole_w = hc1 - hc0 + 1
+        tile_h, tile_w = tile.shape
+        assert hole_h % tile_h == 0 and hole_w % tile_w == 0, "hole bbox must be a multiple of the seed bbox"
