+    if not all(int(info["component_mask"].sum()) < (info["hole_bbox"][2] - info["hole_bbox"][0] + 1) * (info["hole_bbox"][3] - info["hole_bbox"][1] + 1) for info in infos):
+        return False
+    if not all(info["core_area"] > 0 for info in infos):
+        return False
