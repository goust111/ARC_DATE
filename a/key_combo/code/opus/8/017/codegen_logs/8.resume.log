+        core_area = int(component_mask.sum()) - len(inner_boundary)
+
+        infos.append(
+            {
+                "object_id": object_id,
+                "object_mask": obj_mask,
+                "component_mask": component_mask,
+                "coords": coords,
+                "hole_bbox": hole_bbox,
+                "seed_bbox": seed_bbox,
+                "tile": tile,
+                "high": high,
+                "low": low,
+                "seed_high": seed_high,
+                "seed_low": seed_low,
+                "inner_boundary": inner_boundary,
+                "outer_boundary": outer_boundary,
+                "core_area": core_area,
+            }
+        )
+    return infos
