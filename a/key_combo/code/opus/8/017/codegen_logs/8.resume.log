+
+def _random_tile(sh: int, sw: int, color_a: int, color_b: int) -> np.ndarray:
+    area = sh * sw
+    count_a = random.randint(1, area - 1)
+    if 2 * count_a == area:
+        count_a = 1 if count_a != 1 else area - 1
+    cells = [(r, c) for r in range(sh) for c in range(sw)]
+    random.shuffle(cells)
