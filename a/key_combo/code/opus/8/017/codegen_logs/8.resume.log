+    for comp_id in range(1, n_non_blue + 1):
+        component_mask = non_blue_labels == comp_id
+        coords = np.argwhere(component_mask)
+        if coords.size == 0:
+            continue
+        if np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 1] == 0)
+            | (coords[:, 0] == g.shape[0] - 1)
+            | (coords[:, 1] == g.shape[1] - 1)
+        ):
+            continue
