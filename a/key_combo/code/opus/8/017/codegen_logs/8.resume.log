+                info["seed_bbox"][1] - info["hole_bbox"][1],
+            )[info["component_mask"][info["hole_bbox"][0] : info["hole_bbox"][2] + 1, info["hole_bbox"][1] : info["hole_bbox"][3] + 1]]
