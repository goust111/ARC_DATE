+        "high": stats["actual_high"],
+        "low": stats["actual_low"],
+        "seed_high": stats["seed_high"],
+        "seed_low": stats["seed_low"],
+        "seed_pos": seed_pos,
+        "anchor_diff": stats["anchor_diff"],
+        "flip": True,
+    }
+
+
+def _ring_input_patch(
+    color_a: int,
+    color_b: int,
+    require_flip: bool,
+    require_anchor_diff: bool,
