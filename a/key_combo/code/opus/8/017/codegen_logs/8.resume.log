+        local_hole = component_mask[hr0 : hr1 + 1, hc0 : hc1 + 1]
+        filled_local = _fill_hole_from_anchor(local_hole, tile, 0, 0)
+        filled_counts = Counter(
+            int(filled_local[r - hr0, c - hc0])
+            for r, c in coords
+            if int(filled_local[r - hr0, c - hc0]) != BLACK
