+            out[info["outer_boundary"][:, 0], info["outer_boundary"][:, 1]] = high
+        if len(info["inner_boundary"]) > 0:
+            out[info["inner_boundary"][:, 0], info["inner_boundary"][:, 1]] = low
+
+    return out
