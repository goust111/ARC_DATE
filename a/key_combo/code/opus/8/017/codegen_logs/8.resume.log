+        sr0, sc0, sr1, sc1 = seed_bbox
+
+        tile = g[sr0 : sr1 + 1, sc0 : sc1 + 1].copy()
+        seed_colors = [c for c in sorted(set(map(int, tile.ravel()))) if c not in (BLACK, BLUE)]
