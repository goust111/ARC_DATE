+
+
+def _find_positions(
+    grid_shape: tuple[int, int],
+    patch_shape: tuple[int, int],
+    boxes: list[tuple[int, int, int, int]],
+    gap: int,
+) -> list[tuple[int, int]]:
+    h, w = grid_shape
+    ph, pw = patch_shape
