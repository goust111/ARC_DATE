+    coords = np.argwhere(component_mask)
+    for r, c in coords:
+        for dr, dc in DIR4:
+            nr, nc = int(r) + dr, int(c) + dc
+            if not _in_bounds(component_mask.shape, nr, nc) or component_mask[nr, nc]:
+                continue
+            obj = int(blue_labels[nr, nc])
+            if obj == 0:
