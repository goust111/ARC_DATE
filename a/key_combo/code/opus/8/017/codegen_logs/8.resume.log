+        return None
+    patch[ring] = BLUE
+    return patch, ring, local_hole
+
+
+def _seed_positions(hole_mask: np.ndarray, sh: int, sw: int) -> list[tuple[int, int]]:
+    h, w = hole_mask.shape
+    pos = []
