+        return None
+    patch[ring] = BLUE
+    return patch, ring, local_hole
+
+
+def _seed_positions(hole_mask: np.ndarray, sh: int, sw: int) -> list[tuple[int, int]]:
+    h, w = hole_mask.shape
+    pos = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if hole_mask[r0 : r0 + sh, c0 : c0 + sw].all():
