+GEN_ATTEMPTS = 600
+GRID_SIDE_RANGE = (22, 28)
+RING_COUNT_CHOICES = (2, 3)
+SEED_SHAPES = [(2, 2), (2, 3), (3, 2), (3, 3)]
+REPEAT_CHOICES = (2, 3)
