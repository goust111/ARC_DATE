+                trial[rows, c0 : c0 + notch_w] = False
+            else:
+                depth_max = min(2, w - 2)
+                if depth_max < 1:
+                    continue
+                depth = random.randint(1, depth_max)
+                notch_h = random.randint(1, h - 1)
