+    ring = np.zeros_like(patch, dtype=bool)
+    for r in range(patch.shape[0]):
+        for c in range(patch.shape[1]):
+            if local_hole[r, c]:
+                continue
+            # Use the 8-neighbor shell around the cavity so diagonal corner caps
+            # keep the blue wall itself 4-connected.
+            for dr, dc in DIR8:
