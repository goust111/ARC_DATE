+    hole_mask: np.ndarray,
+    tile: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+) -> np.ndarray:
+    h, w = hole_mask.shape
+    tile_h, tile_w = tile.shape
+    out = np.zeros((h, w), dtype=int)
+    coords = np.argwhere(hole_mask)
+    for r, c in coords:
+        out[r, c] = int(tile[(int(r) - anchor_r) % tile_h, (int(c) - anchor_c) % tile_w])
+    return out
+
+
