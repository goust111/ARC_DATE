    return count, rows, cols, rects


def _gen_render_cavity(rng: np.random.Generator, inp: np.ndarray, out: np.ndarray, rect: tuple[int, int, int, int], seed_color: int) -> bool:
    r0, c0, r1, c1 = rect
    cavity_h, cavity_w = r1 - r0 + 1, c1 - c0 + 1
