   211	                target = by_pos.get((origin[0] + rr * scale, origin[1] + cc * scale))
   212	                if target is None:
   213	                    break
   214	                member_ids.append(int(target["id"]))
   215	            else:
   216	                key = frozenset(member_ids)
   217	                prev = instances.get(key)
   218	                assert prev in (None, origin), "ambiguous target grouping"
   219	                instances[key] = origin
