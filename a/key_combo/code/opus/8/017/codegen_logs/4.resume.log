    seed_rep_c = int(rng.integers(0, rep_c))
    sr = r0 + seed_rep_r * tile_h
    sc = c0 + seed_rep_c * tile_w
    inp[sr : sr + tile_h, sc : sc + tile_w] = tile
    return True



