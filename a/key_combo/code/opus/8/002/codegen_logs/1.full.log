+def _chebyshev_clear(cell: tuple[int, int], others: set[tuple[int, int]]) -> bool:
+    r, c = cell
+    for orow, ocol in others:
+        if max(abs(r - orow), abs(c - ocol)) <= 1:
+            return False
+    return True
