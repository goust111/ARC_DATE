    top_box, bottom_box = _find_two_frames(g)
    top_inner = g[top_box[0] + 1 : top_box[2], top_box[1] + 1 : top_box[3]].copy()
    bottom_inner = g[bottom_box[0] + 1 : bottom_box[2], bottom_box[1] + 1 : bottom_box[3]].copy()
