    out[top_box[0] + 1 : top_box[2], top_box[1] + 1 : top_box[3]] = shifted_top
    out[bottom_box[0] + 1 : bottom_box[2], bottom_box[1] + 1 : bottom_box[3]] = swapped_bottom
    return out


