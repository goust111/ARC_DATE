    inp = np.full((height, width), BACKGROUND_COLOR, dtype=int)
    inp[r0 : r0 + tile.shape[0], :] = expected[r0 : r0 + tile.shape[0], :]

    if np.array_equal(main(inp), expected):
        return inp
    return None


