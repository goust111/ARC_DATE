+    mask = _random_connected_mask(side, rng)
+    if not _has_quarter_turn_distinction(mask):
+        return None
+
+    if mask[0].all() and mask[-1].all() and mask[:, 0].all() and mask[:, -1].all():
+        return None
+
+    grid = np.zeros((side, side), dtype=int)
+    grid[mask] = fg
+    return grid
+
+
+def generate_input() -> np.ndarray:
