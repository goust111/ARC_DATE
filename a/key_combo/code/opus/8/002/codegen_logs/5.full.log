def _gen_matching_groups() -> dict[tuple[int, int], list[tuple[tuple[int, int], ...]]]:
    global _GEN_MATCHING_GROUPS
    if _GEN_MATCHING_GROUPS is None:
        groups: dict[tuple[int, int], list[tuple[tuple[int, int], ...]]] = {}
