+    _place_template(left_panel, template_mask)
+    grid[:, panel_w + 1 : panel_w * 2 + 1] = middle
+    grid[:, panel_w * 2 + 2 :] = right
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
