    shape_count = random.randint(_GEN_SHAPE_COUNT_MIN, _GEN_SHAPE_COUNT_MAX)
    available = {
        area: [bits for bits in bits_by_area[area] if bits != prototype_bits]
        for area in range(_GEN_MASK_AREA_MIN, _GEN_MASK_AREA_MAX + 1)
