GEN_REQUIRED_COMPONENTS, GEN_MAX_ATTEMPTS = 1, 300


def _gen_shift_for_distance(distance_from_bottom):
    if distance_from_bottom % 2 == 0:
        return GEN_NO_SHIFT
    return -1 if (distance_from_bottom // 2) % 2 == 0 else 1


