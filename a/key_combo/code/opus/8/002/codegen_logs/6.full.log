        assert cols.size > 0
        shift = _wave_shift(r1 - r)
        if shift == 0:
            continue

        new_cols = cols + shift
        assert int(new_cols.min()) >= 0
        assert int(new_cols.max()) < g.shape[1]
        out[r, cols] = bg
        assert bool(np.all(out[r, new_cols] == bg))
        out[r, new_cols] = fg

    return out

