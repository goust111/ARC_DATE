+    hi_r = min(row_hi, row_window[1])
+    lo_c = max(col_lo, col_window[0])
+    hi_c = min(col_hi, col_window[1])
+    if lo_r > hi_r or lo_c > hi_c:
+        return None
+    return random.randint(lo_r, hi_r), random.randint(lo_c, hi_c)
