+        r0, c0, r1, c1 = box
+        objects.append(
+            {
+                "color": int(comp["color"]),
+                "coords": coords,
+                "bbox": box,
+                "mask": mask,
+                "signature": _shape_signature(mask),
+                "center": ((r0 + r1) // 2, (c0 + c1) // 2),
