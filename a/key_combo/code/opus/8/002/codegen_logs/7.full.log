+    candidates.sort(
+        key=lambda seg: (
+            seg[1] - seg[0] + 1,
+            int(np.count_nonzero(grid[seg[0] : seg[1] + 1] != bg)),
+        ),
+        reverse=True,
+    )
+    r0, r1 = candidates[0]
+    tile = grid[r0 : r1 + 1].copy()
