+def _find_row_band(grid: np.ndarray, bg: int) -> tuple[int, int, np.ndarray]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    r = 0
+    while r < h:
+        nz = np.flatnonzero(grid[r] != bg)
+        if nz.size > 0 and int(nz[0]) == 0 and int(nz[-1]) == w - 1:
+            start = r
+            r += 1
+            while r < h:
