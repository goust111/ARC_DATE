+            inserted_empty = True
+            continue
+
+        roll = random.random()
+        if roll < 0.35:
+            specs.append(None)
+            inserted_empty = True
+        elif roll < 0.75:
+            specs.append((_random_miss_row(current, height), _random_color()))
+        else:
