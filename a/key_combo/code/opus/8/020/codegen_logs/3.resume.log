+    r = int(rows[0])
+    colors = {int(v) for v in patch[r] if int(v) in (Color.BLUE, Color.GREEN)}
+    assert len(colors) == 1
+    color = next(iter(colors))
+    assert np.all(patch[r] == color), "obstacle must cover the whole channel width"
+    assert int(mask.sum()) == patch.shape[1]
+    return r, color
