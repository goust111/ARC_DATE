+def _extract_bar(grid: np.ndarray, c0: int, c1: int) -> tuple[int, int] | None:
+    patch = grid[:, c0 : c1 + 1]
+    assert set(map(int, np.unique(patch))).issubset({Color.BLACK, Color.BLUE, Color.GREEN})
+    mask = np.isin(patch, [Color.BLUE, Color.GREEN])
+    if not mask.any():
