+OBJECT_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW, Color.ORANGE, Color.TEAL, Color.MAROON)
+OBJECT_DIMS = ((2, 2), (2, 3), (3, 2), (3, 3), (2, 4), (4, 2))
+MAX_GEN_ATTEMPTS = 600
