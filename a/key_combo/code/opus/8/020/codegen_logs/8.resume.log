            enters = d < h
            candidates.append((r0 if enters else r0 - 1, c))
            marker_entries.append((d, (r, c), enters))
        if c0 <= c <= c1 and r > r1:
            d = r - r1
            enters = d < h
            candidates.append((r1 if enters else r1 + 1, c))
            marker_entries.append((d, (r, c), enters))
        if r0 <= r <= r1 and c < c0:
