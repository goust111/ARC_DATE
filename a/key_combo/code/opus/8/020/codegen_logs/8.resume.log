+def _make_frame_patch(inner_h: int, inner_w: int) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), Color.BLACK, dtype=int)
+    patch[0, :] = Color.GREY
+    patch[-1, :] = Color.GREY
+    patch[:, 0] = Color.GREY
+    patch[:, -1] = Color.GREY
+    return patch
