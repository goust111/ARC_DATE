+        c = left
+        for idx, ((inner_h, inner_w), outer_h, outer_w) in enumerate(
+            zip(inners, outer_heights, outer_widths, strict=False)
+        ):
+            top = random.randint(top_min, height - outer_h - 1)
+            specs.append(
