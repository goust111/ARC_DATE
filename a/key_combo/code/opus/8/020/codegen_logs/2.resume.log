+def _stamp(out: np.ndarray, patch: np.ndarray, anchor: tuple[int, int], target: tuple[int, int]) -> None:
+    tr, tc = target
+    ar, ac = anchor
+    paste(out, patch, int(tr) - int(ar), int(tc) - int(ac), transparent=BG, clip=True)
