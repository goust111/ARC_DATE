+
+
+BG = Color.BLACK
+BODY_A = Color.RED
+BODY_B = Color.BLUE
+HIDE = Color.GREEN
+ANCHOR_A = Color.ORANGE
+ANCHOR_B = Color.YELLOW
+
+GRID_HEIGHTS = tuple(range(18, 25))
+GRID_WIDTHS = tuple(range(18, 25))
+CENTRAL_SIZES = (9, 11)
+MAX_GEN_ATTEMPTS = 400
