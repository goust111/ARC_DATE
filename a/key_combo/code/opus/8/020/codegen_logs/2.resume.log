+    targets = []
+    for color in (ANCHOR_A, ANCHOR_B):
+        for rr, cc in np.argwhere(g == int(color)):
+            rr = int(rr)
+            cc = int(cc)
+            if cr0 <= rr <= cr1 and cc0 <= cc <= cc1:
+                continue
+            targets.append((cc, rr, int(color)))
