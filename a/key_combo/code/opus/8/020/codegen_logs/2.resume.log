+def _body_color(value: int) -> int:
+    value = int(value)
+    if value == ANCHOR_A:
+        return BODY_A
+    if value == ANCHOR_B:
+        return BODY_B
+    return value
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
