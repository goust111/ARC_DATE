+        if color == ANCHOR_A:
+            _stamp(out, patch_a, anchor_a, (row, col))
+        else:
+            _stamp(out, patch_b, anchor_b, (row, col))
+    return out
+
+
+def _validate_case(inp: np.ndarray, expected: np.ndarray, meta: dict) -> bool:
+    try:
+        if not np.array_equal(main(inp), expected):
