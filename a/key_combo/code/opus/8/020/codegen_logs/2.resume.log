+    ):
+        return None
+    return targets_a, targets_b
+
+
+def _expected_output(
+    inp: np.ndarray,
+    central_bbox: tuple[int, int, int, int],
+    patch_a: np.ndarray,
+    anchor_a: tuple[int, int],
+    patch_b: np.ndarray,
+    anchor_b: tuple[int, int],
+) -> np.ndarray:
