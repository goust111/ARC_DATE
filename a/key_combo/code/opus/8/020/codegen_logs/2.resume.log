+            return None
+
+    pool = candidates[:]
+    random.shuffle(pool)
+    for pos in pool:
+        if len(targets_a) >= count_a and len(targets_b) >= count_b:
+            break
+        choices = []
+        if len(targets_a) < count_a:
+            choices.append("A")
+        if len(targets_b) < count_b:
+            choices.append("B")
+        if not choices:
+            break
+        color = random.choice(choices)
+        add_one(color, pos)
+
+    if len(targets_a) != count_a or len(targets_b) != count_b:
+        return None
+
+    placements = []
+    for pos in targets_a:
