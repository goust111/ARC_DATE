+
+
+def _cross_mask(size: int) -> np.ndarray:
+    center = size // 2
+    mask = np.zeros((size, size), dtype=bool)
+    family = random.choice(["cross", "diamond"])
+    if family == "diamond":
+        radius = 2 if size == 9 else random.choice([2, 3])
+        for r in range(size):
