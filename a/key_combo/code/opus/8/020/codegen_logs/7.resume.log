+def _marker_distance(marker: Coord, rect: BBox) -> tuple[int, Coord]:
+    r, c = marker
+    r0, c0, r1, c1 = rect
+    row_aligned = r0 <= r <= r1
+    col_aligned = c0 <= c <= c1
