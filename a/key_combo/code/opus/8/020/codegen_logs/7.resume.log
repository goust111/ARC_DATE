+
+def _choose_markers(rect: BBox, shape: tuple[int, int], chain_len: int) -> list[dict] | None:
+    candidates = _candidate_markers(rect, shape)
+    by_dist: dict[int, list[dict]] = {}
+    for cand in candidates:
