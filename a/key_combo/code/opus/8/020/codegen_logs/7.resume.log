MIN_POSITION_SIDES_WITH_MARGIN, MIN_POSITION_MARGIN = 2, 2
CLOSE_DIST_MIN, DIST_MAX = 2, 7
KIND_CLOSE, KIND_FAR = "close", "far"
BG_COLOR, RECT_INPUT_COLOR, RECT_OUTPUT_COLOR, MARKER_COLOR = 7, 1, 2, 9
