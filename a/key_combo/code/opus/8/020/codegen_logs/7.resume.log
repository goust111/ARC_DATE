+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RECT_COLOR = 1
+CHAIN_RED = 2
+OUTPUT_RECT = 3
+MARKER = 9
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _find_rectangle_and_chain(grid: np.ndarray) -> tuple[BBox, dict[int, tuple[int, int]], int]:
+    blue = _components(grid == RECT_COLOR)
+    rects = []
+    starts = []
+    for comp in blue:
+        box = _bbox(comp)
+        r0, c0, r1, c1 = box
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if int(comp.shape[0]) != h * w:
+            continue
+        if h >= 2 and w >= 2:
+            rects.append(box)
+        elif w == 1:
+            starts.append((c0, h, box))
+    assert len(rects) == 1
+    assert len(starts) == 1
+    rect = rects[0]
+
+    reds = _components(grid == CHAIN_RED)
+    red_bars: dict[int, tuple[int, int]] = {}
+    for comp in reds:
+        box = _bbox(comp)
+        r0, c0, r1, c1 = box
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert w == 1 and int(comp.shape[0]) == h
+        red_bars[c0] = (h, r1)
+
+    start_col, start_h, start_box = starts[0]
+    _sr0, _sc0, _sr1, start_bottom = start_box
+    return rect, red_bars, (start_col, start_h, start_bottom)
+
+
+def _chain_length(grid: np.ndarray) -> int:
+    _rect, red_bars, start = _find_rectangle_and_chain(grid)
+    col, height, bottom = start
+    length = 1
+    while True:
+        next_col = col + height
+        nxt = red_bars.get(next_col)
+        if nxt is None:
