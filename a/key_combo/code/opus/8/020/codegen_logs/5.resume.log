+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GRAY = 5
+
+MAX_ATTEMPTS = 400
+GRID_MIN = 24
+GRID_MAX = 30
+OBJECT_COUNT_RANGE = (3, 5)
+OBJECT_SIDE_RANGE = (7, 11)
