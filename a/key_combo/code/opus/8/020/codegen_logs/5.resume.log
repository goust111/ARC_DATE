+def _place_patch(canvas: np.ndarray, blocked: np.ndarray, patch: np.ndarray) -> bool:
+    h, w = patch.shape
+    ch, cw = canvas.shape
+    candidates = [(r, c) for r in range(ch - h + 1) for c in range(cw - w + 1)]
+    random.shuffle(candidates)
