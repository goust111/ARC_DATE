        src = (r0 - dist, lane)
    elif side_name == SIDE_BOTTOM:
        dest = (r1 if kind == KIND_CLOSE else r1 + 1, lane)
        src = (r1 + dist, lane)
    elif side_name == SIDE_LEFT:
        dest = (lane, c0 if kind == KIND_CLOSE else c0 - 1)
        src = (lane, c0 - dist)
    else:
        dest = (lane, c1 if kind == KIND_CLOSE else c1 + 1)
        src = (lane, c1 + dist)
    return dest, src


