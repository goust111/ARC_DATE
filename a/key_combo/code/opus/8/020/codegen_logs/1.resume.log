+
+def _is_connected4(cells: tuple[tuple[int, int], ...]) -> bool:
+    cell_set = set(cells)
+    stack = [next(iter(cell_set))]
+    seen = set(stack)
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in cell_set and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
