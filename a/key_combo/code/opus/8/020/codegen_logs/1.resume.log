+    analysis = _analyze_grid(grid)
+    out = np.asarray(grid, dtype=int).copy()
+    for sprite in analysis["sprites"]:
+        color = int(sprite["recolor"])
+        for r, c in sprite["component"]["coords"]:
+            out[int(r), int(c)] = color
