        colors = np.unique(patch)
        assert len(colors) == 1 and int(colors[0]) == outer, "targets must be solid outer-color rectangles"
        r0, c0, r1, c1 = b
        out[r0 : r1 + 1, c0 : c1 + 1] = _stretch_pattern(exemplar, patch.shape)

