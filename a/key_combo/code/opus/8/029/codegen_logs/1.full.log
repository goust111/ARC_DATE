+def _normalize_shape(coords):
+    arr = np.array(coords, dtype=int)
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    arr = np.unique(arr, axis=0)
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return [tuple(map(int, rc)) for rc in arr[order]]
+
+
+def _transform_shape(coords, rot, flip):
