+                continue
+            r0 = random.randint(r0_min, r0_max)
+        elif side == "right":
+            c0_min = cc1 + gap + 1
+            c0_max = w - sw - 4
+            if c0_min > c0_max:
+                return None
+            c0 = random.randint(c0_min, c0_max)
+            r0_min = max(3, rr0 - sh + 1)
+            r0_max = min(rr1, h - sh - 3)
+            if r0_min > r0_max:
+                continue
+            r0 = random.randint(r0_min, r0_max)
+        elif side == "top":
