+
+
+def _sample_free_region(grid):
+    h, w = grid.shape
+    for _ in range(400):
+        shape = _random_shape()
+        sr0, sc0, sr1, sc1 = _shape_bbox(shape)
+        sh = sr1 - sr0 + 1
+        sw = sc1 - sc0 + 1
+        r0 = random.randint(2, h - sh - 3)
+        c0 = random.randint(2, w - sw - 3)
+        coords = _shift(shape, r0, c0)
+        if _region_fits(grid, coords):
