+
+def _enumerate_edge_candidates(grid):
+    h, w = grid.shape
+    candidates = []
+    for _ in range(400):
+        side = random.choice(list(SIDE_TO_STEP))
+        fh = random.choice(list(FRAME_SIZES))
+        fw = random.choice(list(FRAME_SIZES))
