+def _bbox_expanded_clear(grid, bbox):
+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox
+    if not in_bounds(grid.shape, r0, c0) or not in_bounds(grid.shape, r1, c1):
+        return False
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
