+                    continue
+                r0 = random.randint(r0_min, r0_max)
+                bbox = (r0, c0, r0 + fh - 1, c1)
+                gap = (r0, cell_c)
+            else:
+                r1_min = fh
+                r1_max = cell_r - 2
+                if r1_min > r1_max:
