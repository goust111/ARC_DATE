+            variant
+            for variant in _ALL_SHAPE_VARIANTS
+            if max(r for r, _ in variant) + 1 >= _min_rows and max(c for _, c in variant) + 1 >= _min_cols
+        ]
+
+
+def _random_shape(min_rows=1, min_cols=1):
