+    for _ in range(rot):
+        arr = np.stack([-arr[:, 1], arr[:, 0]], axis=1)
+    return _normalize_shape(arr)
+
+
+_ALL_SHAPE_VARIANTS = []
+for _base in SHAPE_LIBRARY:
