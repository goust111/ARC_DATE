+            _variant = _transform_shape(_base, _rot, _flip)
+            if _variant not in _ALL_SHAPE_VARIANTS:
+                _ALL_SHAPE_VARIANTS.append(_variant)
+
+SHAPE_VARIANTS = {}
+for _min_rows in (1, 2):
