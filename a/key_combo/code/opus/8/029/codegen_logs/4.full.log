    grid = np.zeros((rows, cols), dtype=int)
    _gen_place_block(grid, path[0], GEN_START_COLOR)
    for pos in path[1:]:
        _gen_place_block(grid, pos, GEN_TARGET_COLOR)
    for pos in distractors:
