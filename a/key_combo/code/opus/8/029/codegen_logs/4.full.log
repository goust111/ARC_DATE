+        frame["id"] = idx
+    assert frames, "expected at least one gray frame"
+    return start_box, frames
+
+
+def _simulate_walk(grid: np.ndarray, dynamic: bool) -> dict[str, object]:
+    start_box, frames = _parse_input(grid)
