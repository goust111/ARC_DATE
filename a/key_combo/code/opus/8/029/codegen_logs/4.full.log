+def _horizontal_visibility(grid: np.ndarray, a: BBox, b: BBox) -> dict[str, int | str] | None:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    overlap_r0 = max(ar0, br0)
+    overlap_r1 = min(ar1, br1)
