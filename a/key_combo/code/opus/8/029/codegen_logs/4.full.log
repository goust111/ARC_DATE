+    return grid
+
+
+def _candidate_obstructed_by_corridor(
+    stopped_grid: np.ndarray,
+    current_box: BBox,
+    target_box: BBox,
+    original_info: dict[str, int | str],
+) -> bool:
+    r0, c0, r1, c1 = _corridor_bounds(current_box, target_box, original_info)
+    if r0 > r1 or c0 > c1:
