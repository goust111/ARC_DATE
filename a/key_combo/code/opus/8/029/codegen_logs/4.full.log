+
+def _fill_frame_interior(grid: np.ndarray, box: BBox, color: int) -> None:
+    r0, c0, r1, c1 = box
+    if r1 - r0 >= 2 and c1 - c0 >= 2:
+        grid[r0 + 1 : r1, c0 + 1 : c1] = int(color)
