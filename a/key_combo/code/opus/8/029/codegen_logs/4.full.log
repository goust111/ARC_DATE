+    a_c0 = 2 + gap_sa
+    a = (a_r0, a_c0, a_r0 + h_a - 1, a_c0 + w_a - 1)
+
+    h_b = int(rng.integers(4, 7))
+    w_b = int(rng.integers(4, 7))
+    gap_ab = int(rng.integers(2, 6))
