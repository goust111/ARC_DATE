+def _vertical_visibility(grid: np.ndarray, a: BBox, b: BBox) -> dict[str, int | str] | None:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    overlap_c0 = max(ac0, bc0)
+    overlap_c1 = min(ac1, bc1)
+    if overlap_c1 - overlap_c0 + 1 < 2:
