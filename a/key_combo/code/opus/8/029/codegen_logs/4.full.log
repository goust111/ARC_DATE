+    v_info = _vertical_visibility(grid, a, b)
+    if h_info is not None and v_info is not None:
+        if int(h_info["distance"]) <= int(v_info["distance"]):
+            return h_info
+        return v_info
+    return h_info if h_info is not None else v_info
