+    min_c = min(box[1] for box in core_boxes)
+    max_r = max(box[2] for box in core_boxes)
+    max_c = max(box[3] for box in core_boxes)
+    core_h = max_r - min_r + 1
+    core_w = max_c - min_c + 1
