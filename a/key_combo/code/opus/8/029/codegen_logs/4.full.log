+    br0, bc0, br1, bc1 = b
+    overlap_r0 = max(ar0, br0)
+    overlap_r1 = min(ar1, br1)
+    if overlap_r1 - overlap_r0 + 1 < 2:
+        return None
+    if ac1 < bc0:
+        gap_c0, gap_c1 = ac1 + 1, bc0 - 1
+    elif bc1 < ac0:
+        gap_c0, gap_c1 = bc1 + 1, ac0 - 1
+    else:
+        return None
+
+    for band_r in range(overlap_r0, overlap_r1):
