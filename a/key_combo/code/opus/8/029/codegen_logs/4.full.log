+
+    h_d = int(rng.integers(4, 7))
+    w_d = int(rng.integers(4, 7))
+    gap_cd = int(rng.integers(2, 6))
+    d_c0 = c[3] - 1
+    d_r1 = c[0] - gap_cd - 1
