+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    if axis == "h":
+        if ac1 < bc0:
+            return band, ac1 + 1, band + 1, bc0 - 1
+        return band, bc1 + 1, band + 1, ac0 - 1
+    if br1 < ar0:
