+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    core = _sample_core_boxes(rng)
+    if core is None:
+        return None
+
+    extra_count = int(rng.integers(0, 3))
+    shifted = _sample_grid_and_shift(rng, core, extra_count)
