+        ww = int(rng.integers(4, 7))
+        if hh >= h - 1 or ww >= w - 1:
+            continue
+        r0 = int(rng.integers(1, h - hh))
+        c0 = int(rng.integers(1, w - ww))
+        cand = (r0, c0, r0 + hh - 1, c0 + ww - 1)
+        if not _isolated_from_all(cand, all_boxes):
+            continue
+        extras.append(cand)
+        all_boxes.append(cand)
+    if len(extras) != extra_count:
+        return None
+    return extras
