+            else:
+                if interior.size and not np.all(interior == BLACK):
+                    return False
+        return True
+    except Exception:
+        return False
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    core = _sample_core_boxes(rng)
+    if core is None:
