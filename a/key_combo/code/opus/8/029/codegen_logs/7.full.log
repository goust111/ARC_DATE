13:def main(grid: np.ndarray) -> np.ndarray:
14:    """
15:    Recolor the separated outer regions by rotating their colors one step clockwise around the yellow-orange divider.
16:
17:    Input structure:
18:    - The grid contains a fixed yellow/orange divider structure.
19:    - All other colors form separated 4-connected monochrome regions around that divider.
20:
21:    Rule:
22:    - Leave the yellow and orange pixels unchanged.
23:    - Sort the non-divider regions by their centroid angle around the divider centroid in screen-coordinate clockwise order.
24:    - Each region keeps its cells and receives the color of the previous region in that cyclic order.
25:
26:    Key insight:
27:    - The objects do not move; only the color labels cycle through the spatial order of the regions around the divider.
28:    """
29:    g = np.asarray(grid, dtype=int)
30:    assert g.ndim == 2, "expected a 2D grid"
31:
32:    present = set(map(int, np.unique(g)))
33:    assert STATIC_COLORS <= present, "expected yellow and orange divider colors"
34:    moving_colors = present - STATIC_COLORS
35:    assert len(moving_colors) >= 2, "expected at least two regions to cycle"
36:
37:    components = find_components(
38:        g,
39:        bg=-1,
40:        colors=sorted(moving_colors),
41:        connectivity=4,
42:        monochromatic=True,
43:        return_format="dict",
44:    )
45:    assert len(components) == len(moving_colors), "each moving color must form exactly one 4-connected region"
46:
47:    divider_coords = np.argwhere(np.isin(g, sorted(STATIC_COLORS)))
48:    assert divider_coords.size, "expected divider pixels"
49:    center_r, center_c = divider_coords.mean(axis=0)
50:
51:    ordered = []
52:    for component in components:
53:        coords = component["coords"]
54:        centroid_r, centroid_c = coords.mean(axis=0)
55:        angle = math.atan2(float(centroid_r - center_r), float(centroid_c - center_c))
56:        ordered.append((angle, component))
57:
58:    ordered.sort(key=lambda item: item[0])
59:    angles = [angle for angle, _component in ordered]
60:    for left, right in zip(angles, angles[1:]):
61:        assert not math.isclose(left, right), "region angles must define a unique cyclic order"
62:
63:    regions = [component for _angle, component in ordered]
64:    out = g.copy()
65:    for i, region in enumerate(regions):
66:        source = regions[(i - 1) % len(regions)]
67:        coords = region["coords"]
68:        out[coords[:, 0], coords[:, 1]] = int(source["color"])
69:
70:    return out
