+        grid[:, mid_c] = 4
+        grid[mid_r, :] = 7
+        return 4
+    if kind == "t_right":
+        grid[:, mid_c] = 4
+        grid[mid_r, mid_c:] = 7
+        return 3
+    if kind == "t_left":
+        grid[:, mid_c] = 4
+        grid[mid_r, : mid_c + 1] = 7
+        return 3
+    if kind == "t_down":
+        grid[mid_r, :] = 4
+        grid[mid_r:, mid_c] = 7
+        return 3
+    if kind == "t_up":
