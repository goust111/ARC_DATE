938:def randomly_spaced_indices(max_len: int, n_indices: int, border_size: int = 1, padding: int = 1) -> np.ndarray:
939:    """Generate randomly-spaced indices guaranteed to not be adjacent."""
940:    max_len = int(max_len)
941:    n_indices = int(n_indices)
942:    border_size = int(border_size)
943:    padding = int(padding)
944:
945:    if border_size > 0:
946:        return (
947:            randomly_spaced_indices(max_len - border_size - 2, n_indices, border_size=0, padding=padding) + border_size
948:        )
949:
950:    indices = [0 for _ in range(max_len)]
951:    while sum(indices) < n_indices:
952:        possible = [
953:            i
954:            for i in range(max_len)
955:            if sum(indices[max(0, i - padding) : min(i + 1 + padding, max_len)]) == 0
956:        ]
957:        if not possible:
958:            raise ValueError("randomly_spaced_indices: no feasible placement")
959:        indices[random.choice(possible)] = 1
960:    return np.argwhere(indices).flatten()
