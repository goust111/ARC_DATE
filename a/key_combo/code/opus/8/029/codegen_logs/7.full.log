83:def _gen_be94b721_connected_mask(height: int, width: int, area: int) -> np.ndarray:
84:    mask = np.zeros((height, width), dtype=bool)
85:    if random.choice([False, True]):
86:        r, c = 0, random.choice([0, width - 1])
87:        end_r, end_c = height - 1, width - 1 - c
88:    else:
89:        r, c = random.choice([0, height - 1]), 0
90:        end_r, end_c = height - 1 - r, width - 1
91:
92:    mask[r, c] = True
93:    while (r, c) != (end_r, end_c):
94:        moves = []
95:        if r != end_r:
96:            moves.append((r + (1 if end_r > r else -1), c))
97:        if c != end_c:
98:            moves.append((r, c + (1 if end_c > c else -1)))
99:        r, c = random.choice(moves)
100:        mask[r, c] = True
101:
102:    while int(mask.sum()) < int(area):
103:        frontier: set[tuple[int, int]] = set()
104:        for rr, cc in np.argwhere(mask):
105:            for dr, dc in FOUR_NEIGHBOR_OFFSETS:
106:                nr, nc = rr + dr, cc + dc
107:                if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
108:                    frontier.add((int(nr), int(nc)))
109:        if not frontier:
110:            return mask
111:        rr, cc = random.choice(tuple(frontier))
112:        mask[rr, cc] = True
113:    return mask
