+    regions.sort(key=lambda item: item["angle"])
+    assert 3 <= len(regions) <= 4, "expected 3 or 4 surrounding regions"
+    gaps = [((regions[(i + 1) % len(regions)]["angle"] - regions[i]["angle"]) % (2 * math.pi)) for i in range(len(regions))]
