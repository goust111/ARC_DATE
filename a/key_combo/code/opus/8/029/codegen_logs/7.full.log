95:def main(grid: np.ndarray) -> np.ndarray:
96:    """
97:    Stretch the compact colored line prototype onto the sparse yellow skeleton canvas.
98:
99:    Input structure
100:    - The grid has black background with grey separator/filler cells.
101:    - One panel contains only a sparse yellow skeleton; its bounding box is the output canvas.
102:    - The other panel is a compact colored prototype made from horizontal and vertical line segments.
103:
104:    Rule
105:    - Treat endpoints, corners, and crossings of the prototype foreground as graph vertices.
106:    - The yellow pixels are the same vertex pattern after independently stretching rows and columns.
107:    - Map sorted prototype vertex rows/columns to sorted yellow rows/columns.
108:    - Paint every prototype foreground cell and adjacent foreground edge through the mapped row/column spans.
109:
110:    Key insight
111:    - The yellow pixels are anchors for the prototype's graph vertices, while the compact prototype supplies the colors for the stretched line segments.
112:    """
113:    g = np.asarray(grid, dtype=int)
114:
115:    yellow_box = bbox(g == Color.YELLOW)
116:    assert yellow_box is not None
117:    skeleton = crop_bbox(g, yellow_box) == Color.YELLOW
118:
119:    proto_box = bbox((g != Color.BLACK) & (g != Color.YELLOW) & (g != Color.GREY))
120:    assert proto_box is not None
121:    proto = crop_bbox(g, proto_box)
122:    assert not np.any((proto == Color.YELLOW) | (proto == Color.GREY))
123:
124:    vertices = _vertex_mask(proto)
125:    vertex_coords = np.argwhere(vertices)
126:    assert len(vertex_coords) > 0
127:    vertex_rows = sorted(set(map(int, vertex_coords[:, 0])))
128:    vertex_cols = sorted(set(map(int, vertex_coords[:, 1])))
129:    anchor_rows = np.flatnonzero(skeleton.any(axis=1)).astype(int).tolist()
130:    anchor_cols = np.flatnonzero(skeleton.any(axis=0)).astype(int).tolist()
131:    assert len(vertex_rows) == len(anchor_rows)
132:    assert len(vertex_cols) == len(anchor_cols)
133:
134:    sampled_skeleton = skeleton[np.ix_(anchor_rows, anchor_cols)]
135:    expected_skeleton = np.array(
136:        [[vertices[r, c] for c in vertex_cols] for r in vertex_rows],
137:        dtype=bool,
138:    )
139:    assert np.array_equal(sampled_skeleton, expected_skeleton)
140:
141:    row_spans = _axis_spans(proto.shape[0], vertex_rows, anchor_rows)
142:    col_spans = _axis_spans(proto.shape[1], vertex_cols, anchor_cols)
143:
144:    out = np.zeros(skeleton.shape, dtype=int)
145:    fg = proto != Color.BLACK
146:    for r, c in np.argwhere(fg):
147:        _paint(out, row_spans[int(r)], col_spans[int(c)], int(proto[r, c]))
148:
149:    h, w = proto.shape
150:    for r in range(h):
151:        for c in range(w):
152:            if not fg[r, c]:
153:                continue
154:
155:            if r + 1 < h and fg[r + 1, c]:
156:                start = row_spans[r][1] + 1
157:                end = row_spans[r + 1][0] - 1
158:                if start <= end:
159:                    color = _edge_color(proto, (r, c), (r + 1, c), "vertical")
160:                    _paint(out, (start, end), col_spans[c], color)
161:
162:            if c + 1 < w and fg[r, c + 1]:
163:                start = col_spans[c][1] + 1
164:                end = col_spans[c + 1][0] - 1
165:                if start <= end:
166:                    color = _edge_color(proto, (r, c), (r, c + 1), "horizontal")
167:                    _paint(out, row_spans[r], (start, end), color)
168:
169:    return out
