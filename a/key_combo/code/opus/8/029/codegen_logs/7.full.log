+    solved_regions, center = _extract_regions_and_patterns(inp)
+    angles = [region["angle"] for region in solved_regions]
+    gaps = [((angles[(i + 1) % len(angles)] - angles[i]) % (2 * math.pi)) for i in range(len(angles))]
+    if min(gaps) < MIN_ANGLE_GAP:
