+    kind = random.choice(["cross", "cross", "t_right", "t_left", "t_down", "t_up"])
+    grid = np.zeros((h, w), dtype=int)
+    expected_regions = _paint_divider(grid, kind, mid_r, mid_c)
+    return grid, expected_regions
