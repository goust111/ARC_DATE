+def stretch_patch(patch: np.ndarray, out_h: int, out_w: int) -> np.ndarray:
+    src_h, src_w = patch.shape
+    row_idx = np.floor(np.arange(out_h) * src_h / out_h).astype(int)
+    col_idx = np.floor(np.arange(out_w) * src_w / out_w).astype(int)
