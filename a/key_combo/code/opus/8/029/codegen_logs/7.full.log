+def _paint_divider(grid: np.ndarray, kind: str, mid_r: int, mid_c: int) -> int:
+    h, w = grid.shape
+    if kind == "cross":
+        grid[:, mid_c] = 4
+        grid[mid_r, :] = 7
+        return 4
+    if kind == "t_right":
+        grid[:, mid_c] = 4
+        grid[mid_r, mid_c:] = 7
+        return 3
+    if kind == "t_left":
+        grid[:, mid_c] = 4
+        grid[mid_r, : mid_c + 1] = 7
+        return 3
+    if kind == "t_down":
+        grid[mid_r, :] = 4
+        grid[mid_r:, mid_c] = 7
+        return 3
+    if kind == "t_up":
+        grid[mid_r, :] = 4
+        grid[: mid_r + 1, mid_c] = 7
+        return 3
+    raise ValueError(kind)
+
