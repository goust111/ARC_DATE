+        src_patch = region_infos[src_index]["pattern"]
+        r0, c0, r1, c1 = region_infos[dst_index]["box"]
+        stretched = stretch_patch(src_patch, r1 - r0 + 1, c1 - c0 + 1)
+        out[r0 : r1 + 1, c0 : c1 + 1] = BG
+        paste(out, stretched, r0, c0)
+    return out
+
