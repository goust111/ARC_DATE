+
+    for pos, dst_index in enumerate(order):
+        src_index = order[(pos - 1) % len(order)]
+        dst_patch = region_infos[dst_index]["pattern"]
+        src_patch = region_infos[src_index]["pattern"]
+        stretched = stretch_patch(src_patch, *dst_patch.shape)
