+
+    if np.array_equal(inp, expected):
+        return False
+
+    divider = _divider_mask(inp)
+    if not np.array_equal(inp[divider], expected[divider]):
+        return False
+
+    solved = main(inp)
+    if not np.array_equal(solved, expected):
