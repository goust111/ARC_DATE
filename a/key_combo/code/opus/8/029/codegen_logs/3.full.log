+        dr, dc = 0, -1
+    else:
+        r, c = r0 + 1 + gap_index, c1
+        dr, dc = 0, 1
+
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < rows and 0 <= c < cols:
+        cells.append((int(r), int(c)))
+        r += dr
+        c += dc
+    return cells
+
+
+def _frame_spec(
+    rng: np.random.Generator,
+    side: str,
+    box: tuple[int, int, int, int],
+    *,
+    require_main_shift: bool,
+) -> dict:
