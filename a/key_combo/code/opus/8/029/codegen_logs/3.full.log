+
+def _gap_index_from_side(box: tuple[int, int, int, int], side: str, gap: tuple[int, int]) -> int:
+    r0, c0, _, _ = map(int, box)
+    r, c = map(int, gap)
+    return int(c - c0 - 1) if side in ("top", "bottom") else int(r - r0 - 1)
