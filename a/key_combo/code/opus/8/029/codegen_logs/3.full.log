   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """Complete each row by stretching its left closed color prefix and repeating the prefix interior at the right edge.
   8: 
   9:     Input structure
  10:     Each row starts with a contiguous non-background prefix, followed only by background cells.
  11:     The first and last cells of that prefix have the same boundary color.
  12: 
  13:     Rule
  14:     For each row, keep the prefix in place, fill the middle background gap with the prefix boundary color, and copy the prefix without its first cell into the last cells of the row.
  15: 
  16:     Key insight
  17:     The left prefix is a closed horizontal motif: its boundary color forms the long span, while the interior symbols reappear at the right end to close the motif again.
  18:     """
  19:     g = np.asarray(grid, dtype=int)
  20:     bg = get_bg(g)
  21:     h, w = g.shape
  22:     out = g.copy()
  23: 
  24:     for r in range(h):
  25:         row = g[r]
  26:         non_bg_cols = np.flatnonzero(row != bg)
  27:         assert non_bg_cols.size >= 2
  28:         assert np.array_equal(non_bg_cols, np.arange(non_bg_cols[-1] + 1))
