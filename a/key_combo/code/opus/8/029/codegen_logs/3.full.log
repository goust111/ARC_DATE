+
+def _blank_gap_between(a0: int, a1: int, b0: int, b1: int) -> int:
+    if a1 < b0:
+        return int(b0 - a1 - 1)
+    if b1 < a0:
+        return int(a0 - b1 - 1)
+    return 0
+
+
+def _boxes_separated(boxes: list[tuple[int, int, int, int]], min_gap: int = 2) -> bool:
+    for i, a in enumerate(boxes):
+        ar0, ac0, ar1, ac1 = a
+        for b in boxes[i + 1 :]:
