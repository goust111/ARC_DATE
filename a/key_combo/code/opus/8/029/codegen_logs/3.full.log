+            row_gap = _blank_gap_between(ar0, ar1, br0, br1)
+            col_gap = _blank_gap_between(ac0, ac1, bc0, bc1)
+            if row_gap == 0 and col_gap < min_gap:
+                return False
+            if col_gap == 0 and row_gap < min_gap:
