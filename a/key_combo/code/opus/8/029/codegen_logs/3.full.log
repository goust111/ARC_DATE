+def _gap_side_and_direction(gap: tuple[int, int], box: tuple[int, int, int, int]) -> tuple[str, tuple[int, int]]:
+    r, c = map(int, gap)
+    r0, c0, r1, c1 = map(int, box)
+    if r == r0:
+        return "top", (-1, 0)
+    if r == r1:
