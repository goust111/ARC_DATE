+
+
+def _build_expected(
+    shape: tuple[int, int],
+    markers: dict[int, list[tuple[int, int]]],
+    object_specs: list[dict[str, object]],
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for color, pts in markers.items():
+        for r, c in pts:
+            out[int(r), int(c)] = int(color)
+    for spec in object_specs:
