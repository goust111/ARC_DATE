+    steps: dict[int, int] = {}
+    for color, pts in markers.items():
+        a = _alignment_value(edge, *pts[0])
+        b = _alignment_value(edge, *pts[1])
+        steps[int(color)] = abs(int(a) - int(b))
+        assert steps[int(color)] >= 1
