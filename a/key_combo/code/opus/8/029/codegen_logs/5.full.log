+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _orbit(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    assert h == w, "expected a square grid"
+    return sorted(
+        {
+            (int(r), int(c)),
+            (h - 1 - int(r), int(c)),
+            (int(r), w - 1 - int(c)),
+            (h - 1 - int(r), w - 1 - int(c)),
+        }
+    )
