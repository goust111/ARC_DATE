+    allowed = {BG, BLUE, RED, OBSTACLE}
+    assert set(map(int, np.unique(g))).issubset(allowed), "unexpected colors in grid"
+
+    blue_coords = np.argwhere(g == BLUE)
+    red_coords = np.argwhere(g == RED)
