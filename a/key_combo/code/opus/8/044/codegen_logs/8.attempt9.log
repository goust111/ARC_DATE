+    shifted_tracks: set[int] = set()
+    obstacles: list[tuple[int, int, int, int]] = []
+    seed_cells = {blue, red}
+    seed_pos_by_track: dict[int, int] = {}
+    if orientation == "horizontal":
+        seed_pos_by_track[blue[0]] = blue[1]
