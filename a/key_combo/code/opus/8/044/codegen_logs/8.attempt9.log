+
+def _build_input_grid(
+    shape: tuple[int, int],
+    blue: tuple[int, int],
+    red: tuple[int, int],
+    obstacles: list[tuple[int, int, int, int]],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for r0, c0, r1, c1 in obstacles:
+        grid[r0 : r1 + 1, c0 : c1 + 1] = OBSTACLE
+    grid[blue] = BLUE
+    grid[red] = RED
