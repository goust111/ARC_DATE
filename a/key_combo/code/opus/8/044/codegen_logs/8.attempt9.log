+def _expanded_overlaps(reserved: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> bool:
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(reserved.shape[0], r1 + pad + 1)
+    cc1 = min(reserved.shape[1], c1 + pad + 1)
+    return bool(reserved[rr0:rr1, cc0:cc1].any())
