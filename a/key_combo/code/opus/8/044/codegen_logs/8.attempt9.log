+        row0 = track
+    elif height_choice == 1:
+        row0 = track
+    else:
+        row0 = track - 1
+    return row0, hit_col, row0 + height_choice - 1, hit_col + width_choice - 1
+
+
+def _vertical_obstacle_bbox(
+    track: int, shift: int, width_choice: int, height_choice: int, hit_row: int
