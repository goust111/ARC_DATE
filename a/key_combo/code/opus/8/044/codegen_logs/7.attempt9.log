spec:
  grid: 10-23 rows x 14-25 cols
  colors: bg=black(0), guide_color=blue(1), object_color=red(2)
  guide_lines:
    count: 1-3 total (0-2 horizontal + 0-1 vertical, at least 1)
    markers: each line defined by 2 singleton pixels of guide_color on opposite borders (L/R for horizontal, T/B for vertical)
    position: interior rows/cols only (not on grid border)
    input_content: only the 2 border marker pixels per line; rest of line is bg or objects
  objects:
    shape: axis-aligned solid rectangles, always [observed]
    bbox_side: 2-9 per dimension
    count: 5-10
    placement: no two objects 4-adjacent to each other; objects may lie on grid border
    no_marker_overlap: objects never occupy marker cell positions
  touching_rule: an object is touched if any of its cells overlaps or is 4-adjacent to a guide line
  touched_vs_untouched: 1-7 touched, 3-4 untouched per example [observed]
  output:
    guide_lines: drawn across full row/col in guide_color (overwriting bg and objects)
    touched_objects: entirely recolored to guide_color
    untouched_objects: unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size (H x W) in ranges above
    2. Choose 1-3 guide lines (mix of H and V); pick interior row/col positions with spacing >=3
    3. Build the output guide mask (full rows/cols painted guide_color)
    4. Place 5-10 non-overlapping solid rectangles (2-5 x 2-6 bbox); ensure no two are 4-adjacent
    5. Ensure >=1 rectangle overlaps or is 4-adjacent to a guide line (touched) and >=2 are far from all lines (untouched)
    6. Build output: draw guide lines over everything, recolor touched rectangles to guide_color
    7. Build input from output: remove guide lines (restore bg), keep touched rectangles as object_color (undo recolor), place 2 marker singletons on opposite borders for each guide line
    8. Verify solver reproduces the output
