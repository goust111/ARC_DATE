+    colors = chosen + [random.choice(chosen) for _ in range(4 - k)]
+    random.shuffle(colors)
+    assert len(set(colors)) == k
+    return colors
+
+
+def _orange_shape_key(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], bytes]:
