+        r1 = r0 + fh - 1
+        c1 = c0 + fw - 1
+        grid[r0, c0 : c1 + 1] = FRAME_COLOR
+        grid[r1, c0 : c1 + 1] = FRAME_COLOR
+        grid[r0 : r1 + 1, c0] = FRAME_COLOR
+        grid[r0 : r1 + 1, c1] = FRAME_COLOR
+        grid[r0 + 1 : r1, c0 + 1 : c1] = frame["interior"]
+        frame["bbox"] = (r0, c0, r1, c1)
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(h, r1 + 2)
+        cc1 = min(w, c1 + 2)
+        blocked[rr0:rr1, cc0:cc1] = True
