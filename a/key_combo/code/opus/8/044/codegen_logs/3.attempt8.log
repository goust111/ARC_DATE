+    row_heights = [max(int(item.shape[0]) for item in row) for row in rows]
+    row_widths = [sum(int(item.shape[1]) for item in row) + len(row) - 1 for row in rows]
+    out = np.full((sum(row_heights), max(row_widths)), BG, dtype=int)
