+def _pack_results(results: list[np.ndarray], max_width: int = MAX_OUTPUT_WIDTH) -> np.ndarray:
+    assert results
+    rows: list[list[np.ndarray]] = []
+    current: list[np.ndarray] = []
+    used_width = 0
+    for res in results:
+        w = int(res.shape[1])
+        if not current:
+            current = [res]
+            used_width = w
+            continue
+        candidate = used_width + 1 + w
+        if candidate <= max_width:
+            current.append(res)
+            used_width = candidate
+        else:
+            rows.append(current)
+            current = [res]
+            used_width = w
+    if current:
+        rows.append(current)
