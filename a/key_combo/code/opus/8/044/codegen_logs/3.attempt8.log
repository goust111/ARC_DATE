+        cc = slice(sample_orange[1] * k, (sample_orange[1] + 1) * k)
+        if not np.all(result[rr, cc] == ORANGE):
+            return False
+
+    if len({frame["shape_key"] for frame in frames}) != len(frames):
+        return False
+    return max(solver_out.shape) <= 30
+
+
+def _gen_attempt() -> np.ndarray | None:
