+    interior = np.zeros((h, w), dtype=int)
+    tl, tr, bl, br = _sample_corner_assignment(k)
+    interior[0, 0] = tl
+    interior[0, w - 1] = tr
+    interior[h - 1, 0] = bl
+    interior[h - 1, w - 1] = br
