+
+
+def _gen_attempt() -> np.ndarray | None:
+    frames = _plan_frames()
+    if frames is None:
+        return None
+    grid = _place_frames(frames)
+    if grid is None:
+        return None
+    if not _semantic_checks(grid, frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
