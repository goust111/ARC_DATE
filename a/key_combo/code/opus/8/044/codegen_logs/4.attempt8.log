+def _choose_shape(obj_width: int, rng: np.random.Generator) -> np.ndarray:
+    bank = WIDTH1_SHAPES if obj_width == 1 else WIDTH2_SHAPES
+    return bank[int(rng.integers(len(bank)))].copy()
