+    assert len(set(top_rows)) == len(top_rows)
+    ordered = sorted(comps, key=lambda comp: int(comp["bbox"][0]))
+
+    h, w = grid.shape
+    shifted: list[np.ndarray] = []
+    for rank, comp in enumerate(ordered, start=1):
+        dc = -1 if rank % 2 == 1 else 1
+        pts = []
+        for r, c in comp["coords"]:
+            nc = int(c) + dc
+            if 0 <= nc < w:
