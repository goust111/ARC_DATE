+SIDE_TO_TURNS = {"top": 0, "right": 1, "bottom": 2, "left": 3}
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+TEMPLATE_DIMS = ((3, 5), (5, 3), (4, 6), (6, 4))
