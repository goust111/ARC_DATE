+                ((inp == color) & ((np.indices(inp.shape)[0] == 0) | (np.indices(inp.shape)[0] == inp.shape[0] - 1) | (np.indices(inp.shape)[1] == 0) | (np.indices(inp.shape)[1] == inp.shape[1] - 1)))
+            )
+        )
+        if marker_count != 1:
