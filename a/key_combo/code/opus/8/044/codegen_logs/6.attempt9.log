+    dst_r1 = min(out_h, r0 + in_h)
+    dst_c1 = min(out_w, c0 + in_w)
+    src_r1 = src_r0 + (dst_r1 - dst_r0)
+    src_c1 = src_c0 + (dst_c1 - dst_c0)
