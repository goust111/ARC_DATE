+def _rects_separated(
+    a: tuple[int, int], b: tuple[int, int], h: int, w: int, gap: int
+) -> bool:
+    ar, ac = a
+    br, bc = b
+    return (
+        ar + h + gap <= br
+        or br + h + gap <= ar
+        or ac + w + gap <= bc
+        or bc + w + gap <= ac
+    )
