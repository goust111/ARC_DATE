+                subset = set(random.choice(weighted_patterns))
+            keepers[coord] = subset
+
+        for coord in bottom_cells:
+            if shrink_h in keepers[coord] and coord not in protected[shrink_h]:
+                if keepers[coord] == {shrink_h}:
