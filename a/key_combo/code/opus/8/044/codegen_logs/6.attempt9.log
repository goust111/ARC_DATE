+    if side == "top":
+        return 0, random.randint(1, w - 2)
+    if side == "right":
+        return random.randint(1, h - 2), w - 1
+    if side == "bottom":
+        return h - 1, random.randint(1, w - 2)
+    return random.randint(1, h - 2), 0
+
+
+def _render_objects(
+    shape: tuple[int, int],
+    colors: list[int],
+    origins: list[tuple[int, int]],
+    masks: list[np.ndarray],
+) -> np.ndarray:
