    rows, cols = zip(*coords)
    grid[rows, cols] = color


def _render_input_grid(placed):
    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    for _, coords in placed:
