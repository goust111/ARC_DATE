+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+NW_SE = "nw_se"
+NE_SW = "ne_sw"
+ORIENTATIONS = (NW_SE, NE_SW)
+
+GEN_ATTEMPTS = 800
+GRID_MIN = 12
+GRID_MAX = 18
