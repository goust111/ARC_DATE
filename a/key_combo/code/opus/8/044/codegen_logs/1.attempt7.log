+    return None
+
+
+def _render_grid(items: list[dict], h: int, w: int) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for item in items:
+        for r, c in item["cells"]:
+            grid[r, c] = MARKER
