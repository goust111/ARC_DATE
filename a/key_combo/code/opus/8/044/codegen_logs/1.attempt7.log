+        total_count = random.randint(max(5, len(placed) + 1), 8)
+        sym_needed = total_count - len(placed)
+        special = _place_special_symmetric(
+            placed,
+            random.choice(SYM_VARIANTS).copy(),
+            h,
+            w,
+            mode=mode,
+            target_row=target_row,
+            target_col=target_col,
