+            placed,
+            random.choice(SYM_VARIANTS).copy(),
+            h,
+            w,
+            mode=mode,
+            target_row=target_row,
+            target_col=target_col,
+        )
+        if special is None:
+            continue
+        placed.append(special)
+
+        while len(placed) < total_count:
+            extra = _place_sprite(placed, random.choice(SYM_VARIANTS).copy(), h, w)
