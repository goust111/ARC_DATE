    rows = _spaced_combos(list(range(1, H - 1)), n_walls)
    cols = _spaced_combos(list(range(1, W - 1)), n_walls)
    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []
    for start_rows in rows:
        for cols_asc in cols:
            end_cols = tuple(reversed(cols_asc))
