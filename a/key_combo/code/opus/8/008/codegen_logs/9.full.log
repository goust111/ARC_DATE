                if 0<=rr<H and 0<=cc<W and g[rr,cc]==1:
                    blue4+=1
            black8=0
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    if dr==0 and dc==0: continue
                    rr,cc=r+dr,c+dc
                    if 0<=rr<H and 0<=cc<W and g[rr,cc]==0:
                        black8+=1
            if blue4<=1 and black8>=5:
                kill.append((r,c))
    for r,c in kill: out[r,c]=0
    return out

def defects(g):
    H,W=g.shape
    ds=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]!=0: continue
            ok=True
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    if dr==0 and dc==0: continue
                    rr,cc=r+dr,c+dc
                    if 0<=rr<H and 0<=cc<W and g[rr,cc] not in (1,7):
                        ok=False
            if ok: ds.append((r,c))
    return ds

def mark(g):
    H,W=g.shape
    out=g.copy()
    ds=defects(g)
    dset=set(ds)
    for r,c in ds:
        ring=[]
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==0 and dc==0: continue
                rr,cc=r+dr,c+dc
                if 0<=rr<H and 0<=cc<W:
                    ring.append((rr,cc))
                    if out[rr,cc] in (1,7): out[rr,cc]=7
        for rr,cc in ring:
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    if dr==0 and dc==0: continue
                    r2,c2=rr+dr,cc+dc
                    if 0<=r2<H and 0<=c2<W and out[r2,c2]==0 and (r2,c2) not in dset:
                        out[r2,c2]=7
    for r,c in ds: out[r,c]=0
    return out

def slide(g):
    out=g.copy()
    H,W=out.shape
    for r in range(H-1,-1,-1):
        for c in range(W-1,-1,-1):
            if out[r,c] not in (1,7): continue
            if c+1>=W: continue
            moved = np.any(np.isin(out[r+1:,c+1:], (1,7)))
            if moved:
                out[r,c+1]=out[r,c]
                out[r,c]=0
    return out

def slide_labels(g,labels):
    out=g.copy(); lab=labels.copy(); H,W=g.shape
    for r in range(H-1,-1,-1):
        for c in range(W-1,-1,-1):
            if out[r,c] not in (1,7): continue
            if c+1>=W: continue
            if np.any(np.isin(out[r+1:,c+1:], (1,7))):
                out[r,c+1]=out[r,c]; out[r,c]=0
                lab[r,c+1]=lab[r,c]; lab[r,c]=0
    return out,lab

