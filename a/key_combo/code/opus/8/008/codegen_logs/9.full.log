    """Sample one random cell per row/column, then optional extra cells."""
    mask = np.zeros((MOTIF_SIZE, MOTIF_SIZE), dtype=bool)
    cols = np.random.permutation(MOTIF_SIZE)
    for r, c in enumerate(cols):
