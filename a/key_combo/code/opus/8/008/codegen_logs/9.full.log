+        return None
+
+    defect_count = len(_find_defects(grid))
+    if defect_count < object_count or defect_count > 2 * object_count:
+        return None
+
+    if not _marking_changes_original_motion(grid):
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape or max(out.shape) > 30:
+        return None
+    return grid
