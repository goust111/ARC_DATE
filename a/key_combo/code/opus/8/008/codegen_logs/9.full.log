+def _original_label_grid(grid: np.ndarray) -> np.ndarray:
+    labels = np.zeros_like(grid, dtype=int)
+    idx = 1
+    for r, c in np.argwhere(grid == BLUE):
+        labels[int(r), int(c)] = idx
+        idx += 1
+    return labels
+
