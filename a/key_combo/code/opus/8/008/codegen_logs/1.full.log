from collections import deque

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def label(mask):
    h,w=mask.shape
    lab=np.zeros((h,w),int); n=0
    for r in range(h):
      for c in range(w):
        if mask[r,c] and lab[r,c]==0:
          n+=1; q=deque([(r,c)]); lab[r,c]=n
          while q:
            x,y=q.popleft()
            for nx,ny in neighbors4(x,y):
              if 0<=nx<h and 0<=ny<w and mask[nx,ny] and lab[nx,ny]==0:
                lab[nx,ny]=n; q.append((nx,ny))
    return lab,n

def ordered_path(cells):
    cells=set(cells)
    deg={p:sum((q in cells) for q in neighbors4(*p)) for p in cells}
    ends=sorted([p for p,d in deg.items() if d==1])
    if len(ends)"'!=2: return None
    cur=ends[0]; prev=None; out=[]
    while True:
      out.append(cur)
      nxt=[q for q in neighbors4(*cur) if q in cells and q!=prev]
      if not nxt: break
      if len(nxt)!=1: return None
      prev,cur=cur,nxt[0]
    return out if len(out)==len(cells) else None

def solve(g):
