def build_path(g):
 H,W=g.shape
 safe=[]
 for r in range(H):
  for c in range(W):
   if g[r,c]"'!=0: continue
   if any(0<=nr<H and 0<=nc<W and g[nr,nc]==1 for nr,nc in n4(r,c)): continue
   safe.append((r,c))
 safe=set(safe)
 if len(safe)<15: return None
 starts=sorted(safe, key=lambda p:(p[0]+p[1], p[0], p[1]))[:20]
 for start in starts:
