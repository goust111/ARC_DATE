+    assert 2 <= len(markers) <= 4, "expected 2-4 markers"
+
+    arrow_cells = set()
+    for arrow in arrows:
+        arrow_cells |= arrow["coord_set"]
+
+    hits: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for marker in markers:
