+    for arrow in arrows:
+        dist = min(abs(r - ar) + abs(c - ac) for ar, ac in arrow["coords"])
+        if best_dist is None or dist < best_dist:
+            best_dist = dist
+            best_arrow = arrow
+            tied = False
+        elif dist == best_dist:
