+def _marker_positions(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    markers = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            value = int(grid[r, c])
+            if value not in (BG, GREY):
