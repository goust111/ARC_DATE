SOLID_DIM_BY_COUNT = {4: (8, 8), 5: (8, 7), 6: (7, 7), 7: (6, 6)}
SOLID_DIM_MIN, ELONGATED_PROB, ELONGATED_SHORT_MAX, ELONGATED_LONG_MIN = 2, 0.25, 4, 5

