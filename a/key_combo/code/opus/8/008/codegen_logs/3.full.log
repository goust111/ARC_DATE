        n=sum(bits)
        if not (6<=n<=12): continue
        mask=np.array(bits,dtype=bool).reshape(K,K)
        if not connected(mask) or not bbox_full(mask): continue
        total+=1
        if enclosed(expand(mask)):
            valid+=1
            if orig_hole(mask): withhole+=1
            else: nohole+=1
    print('K',K,'total',total,'valid',valid,'nohole',nohole,'withhole',withhole)
