def bbox_full(mask):
    rs,cs=np.where(mask)
    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1

def expand(mask):
    K=mask.shape[0]
    out=np.zeros((K*K,K*K),dtype=int)
    for r,c in zip(*np.where(mask)):
