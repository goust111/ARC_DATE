        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]: ext[nr,nc]=1;q.append((nr,nc))
    return np.any(bg & ~ext)

def orig_hole(mask):
    K=mask.shape[0]
    bg=~mask
    ext=np.zeros_like(bg,dtype=bool)
    q=deque()
    for r in range(K):
        for c in (0,K-1):
            if bg[r,c] and not ext[r,c]: ext[r,c]=1;q.append((r,c))
    for c in range(K):
