+    r0, c0, r1, c1 = rect
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            candidates = []
+            for rr, cc in {
+                (r, w - 1 - c),
+                (h - 1 - r, c),
