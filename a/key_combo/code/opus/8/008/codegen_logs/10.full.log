+def _marker_rectangle(grid: np.ndarray) -> tuple[int, int, int, int] | None:
+    mask = grid == OCCLUDER
+    if not np.any(mask):
+        return None
+    rect = bbox(mask)
+    assert rect is not None, "occluder must exist when magenta pixels are present"
+    r0, c0, r1, c1 = rect
