BACKGROUND_COLOR = Color.ORANGE
WALL_COLOR = Color.RED

# Wall geometry constraints.
WALL_LENGTH_RANGE = (4, 13)
WALL_TURN_RANGE = (1, 5)
ENDPOINT_SPACING = 2
MAX_STAIR_PARTS = 3
MIN_FIRST_STAIR_COL = 1

# Left-right corridor layout.
