+MAX_PERIOD = 6
+
+GEN_H_RANGE = (16, 24)
+GEN_W_RANGE = (16, 24)
+GEN_PATTERN_WIDTHS = (2, 3)
+GEN_MIN_PATH_LEN = 12
+GEN_MIN_TURNS = 2
+GEN_MAX_ATTEMPTS = 400
+GEN_EDGE_SAMPLE = 8
