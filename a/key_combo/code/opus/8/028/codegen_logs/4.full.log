+
+
+def _implicit_obstacles(
+    grid: np.ndarray, orange_cells: list[tuple[int, int]], period_x: int, period_y: int
+) -> set[tuple[int, int]]:
+    obstacles: set[tuple[int, int]] = set()
+    h, w = grid.shape
+    for base_r, base_c in orange_cells:
+        for r in range(base_r, h, period_y):
