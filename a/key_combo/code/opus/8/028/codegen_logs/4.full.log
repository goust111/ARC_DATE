+    for r, c in orange_cells:
+        grid[r, c] = Color.ORANGE
+    grid[0, pattern_w : pattern_w + period_x] = Color.GREY
+    grid[PATTERN_HEIGHT : PATTERN_HEIGHT + period_y, 0] = Color.GREY
+    return grid
+
+
+def _component_is_tree(cells: list[tuple[int, int]]) -> bool:
+    cell_set = set(cells)
+    edges = 0
+    for cell in cells:
