+    return forbidden
+
+
+def _passable_mask(grid: np.ndarray, forbidden: np.ndarray) -> np.ndarray:
+    return ((grid == Color.TEAL) | (grid == Color.MAROON)) & ~forbidden
+
+
+def _bfs_path(
+    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]] | None:
