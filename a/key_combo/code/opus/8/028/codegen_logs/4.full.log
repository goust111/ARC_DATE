+
+
+def _candidate_endpoint_pairs(passable: np.ndarray) -> list[tuple[int, int, list[tuple[int, int]], tuple[int, int], tuple[int, int]]]:
+    h, w = passable.shape
+    candidates = []
+    specs = [
