def n4(r,c):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]: yield r+dr,c+dc

def n8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr or dc: yield r+dr,c+dc

def count_paths(passable, s, t, limit=2):
    stack=[(s,{s})]
    cnt=0
    while stack:
        p,seen=stack.pop()
        if p==t:
            cnt+=1
            if cnt>=limit: return cnt
            continue
        for q in n4(*p):
            rr,cc=q
            if inb(passable.shape,rr,cc) and passable[rr,cc] and q not in seen:
                stack.append((q, seen|{q}))
    return cnt

def bfs(passable,s):
    q=deque([s]); d={s:0}
    while q:
        p=q.popleft()
        for q2 in n4(*p):
            rr,cc=q2
            if inb(passable.shape,rr,cc) and passable[rr,cc] and q2 not in d:
                d[q2]=d[p]+1; q.append(q2)
    return d

def edge_name(H,W,p):
    r,c=p; out=[]
    if r==0: out.append('T')
    if r==H-1: out.append('B')
    if c==0: out.append('L')
    if c==W-1: out.append('R')
    return ''.join(out)

