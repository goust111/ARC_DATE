from collections import deque
TEAL, ORANGE, GREY = 8,7,5

def inb(shape,r,c): return 0<=r<shape[0] and 0<=c<shape[1]

def n4(r,c):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]: yield r+dr,c+dc

def n8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr or dc: yield r+dr,c+dc

def components(mask):
    H,W=mask.shape; seen=set(); out=[]
    for r in range(H):
      for c in range(W):
        if mask[r,c] and (r,c) not in seen:
          q=deque([(r,c)]); seen.add((r,c)); comp=[]
          while q:
            p=q.popleft(); comp.append(p)
            for q2 in n4(*p):
              rr,cc=q2
              if inb(mask.shape,rr,cc) and mask[rr,cc] and q2 not in seen:
                seen.add(q2); q.append(q2)
          out.append(comp)
