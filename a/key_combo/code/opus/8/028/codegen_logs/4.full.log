+def _component_bbox(shape: tuple[int, int], coords: np.ndarray) -> tuple[int, int, int, int]:
+    mask = np.zeros(shape, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
+    box = bbox(mask)
+    assert box is not None
+    return box
