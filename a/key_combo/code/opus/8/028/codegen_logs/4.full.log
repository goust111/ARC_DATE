+            if nxt in entry:
+                low[node] = min(low[node], entry[nxt])
+                continue
+            parent[nxt] = node
+            dfs(nxt)
+            low[node] = min(low[node], low[nxt])
+            if low[nxt] > entry[node]:
+                bridges.add(frozenset((node, nxt)))
