+                        continue
+                    path = []
+                    cur = end
+                    while cur is not None:
+                        path.append(cur)
+                        cur = parent[cur]
+                    path.reverse()
+                    turns = _path_turns(path)
+                    if turns < GEN_MIN_TURNS:
