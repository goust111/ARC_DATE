+    out = grid.copy()
+    out[start] = Color.MAROON
+    out[end] = Color.MAROON
+
+    if len(path) - 1 < GEN_MIN_PATH_LEN or _path_turns(path) < GEN_MIN_TURNS:
+        return None
+    if not _validate_generated_case(out):
+        return None
+    return out
