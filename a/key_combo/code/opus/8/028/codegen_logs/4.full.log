import itertools, numpy as np
from collections import deque

TEAL, ORANGE, GREY = 8,7,5

def inb(shape,r,c): return 0<=r<shape[0] and 0<=c<shape[1]

def n4(r,c):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]: yield r+dr,c+dc

def n8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr or dc: yield r+dr,c+dc

def bfs_path(passable,s,t):
    q=deque([s]); par={s:None}
    while q:
        p=q.popleft()
        if p==t: break
        for q2 in n4(*p):
            rr,cc=q2
            if inb(passable.shape,rr,cc) and passable[rr,cc] and q2 not in par:
                par[q2]=p; q.append(q2)
    if t not in par: return None
    path=[]; cur=t
    while cur is not None:
        path.append(cur); cur=par[cur]
    return path[::-1]

def bridges(passable,start):
    tin={}; low={}; par={start:None}; out=set(); timer=0
    import sys; sys.setrecursionlimit(10000)
    def dfs(v):
        nonlocal timer
        tin[v]=low[v]=timer; timer+=1
        for to in n4(*v):
            rr,cc=to
            if not(inb(passable.shape,rr,cc) and passable[rr,cc]): continue
            if to==par[v]: continue
            if to in tin:
                low[v]=min(low[v], tin[to]); continue
            par[to]=v; dfs(to); low[v]=min(low[v], low[to])
            if low[to] > tin[v]: out.add(frozenset((v,to)))
    dfs(start)
    return out

def turns(path):
    t=0
    for i in range(1,len(path)-1):
        d1=(path[i][0]-path[i-1][0], path[i][1]-path[i-1][1])
        d2=(path[i+1][0]-path[i][0], path[i+1][1]-path[i][1])
        if d1"'!=d2:t+=1
    return t

for H,W in [(18,18),(20,20),(22,22),(18,22),(22,18),(24,24)]:
  print('"'GRID',H,W)
  found=[]
  for px in [4,5,6]:
    for py in [4,5,6]:
      for pw in [2,3]:
        for pts in itertools.combinations([(r,c) for r in range(2) for c in range(pw)],1):
          g=np.full((H,W),TEAL,int)
          g[0,pw:pw+px]=GREY
          g[2:2+py,0]=GREY
          for r,c in pts:g[r,c]=ORANGE
          obs=set()
          for br,bc in pts:
            for rr in range(br,H,py):
              for cc in range(bc,W,px):
                if g[rr,cc] in (TEAL,ORANGE): obs.add((rr,cc))
          forb=set(obs)
          for r,c in list(obs):
            for nr,nc in n8(r,c):
              if inb(g.shape,nr,nc) and g[nr,nc]==TEAL: forb.add((nr,nc))
          passable=np.array([[g[r,c]==TEAL and (r,c) not in forb for c in range(W)] for r in range(H)], bool)
          edge=[(r,c) for r in range(H) for c in range(W) if passable[r,c] and (r in (0,H-1) or c in (0,W-1))]
          cand1=[p for p in edge if p[1]==0 or p[0]==H-1]
          cand2=[p for p in edge if p[0]==0 or p[1]==W-1]
          for s in cand1:
            br=bridges(passable,s)
            for t in cand2:
              if t==s: continue
              path=bfs_path(passable,s,t)
              if not path or len(path)-1 < 12 or turns(path)<2: continue
              if all(frozenset((a,b)) in br for a,b in zip(path,path[1:])):
                found.append((len(path)-1,px,py,pw,pts,s,t,turns(path)))
                break
            if found:
              break
  print(found[:20])
