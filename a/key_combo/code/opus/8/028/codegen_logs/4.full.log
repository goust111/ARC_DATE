+
+    passable = _passable_mask(grid, forbidden)
+    path = _unique_path(passable, endpoints[0], endpoints[1])
+    if path is None or len(path) - 1 < GEN_MIN_PATH_LEN or _path_turns(path) < GEN_MIN_TURNS:
