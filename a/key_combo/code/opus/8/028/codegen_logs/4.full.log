+def _bfs_path(
+    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]] | None:
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == end:
+            break
+        for nxt in neighbors4(*cur):
+            nr, nc = nxt
+            if in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in parent:
