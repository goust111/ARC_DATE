+def _gen_attempt(
+    *,
+    period_x: int | None = None,
+    period_y: int | None = None,
+    pattern_w: int | None = None,
+    orange_count: int | None = None,
+) -> np.ndarray | None:
+    h = random.randint(*GEN_H_RANGE)
