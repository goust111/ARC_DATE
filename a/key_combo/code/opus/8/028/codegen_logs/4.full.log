+def generate_input() -> np.ndarray:
+    target_px = random.randint(MIN_PERIOD, MAX_PERIOD)
+    target_py = random.randint(MIN_PERIOD, MAX_PERIOD)
+
+    stage_attempts = GEN_MAX_ATTEMPTS // 2
+    for _ in range(stage_attempts):
+        grid = _gen_attempt(period_x=target_px, period_y=target_py)
+        if grid is not None:
+            return grid
+
+    for _ in range(GEN_MAX_ATTEMPTS - stage_attempts):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid periodic-obstacle routing puzzle")

