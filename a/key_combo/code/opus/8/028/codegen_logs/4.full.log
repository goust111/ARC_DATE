+    for r, c in path:
+        if out[r, c] == Color.TEAL:
+            out[r, c] = Color.MAROON
+    return out
+
+
+def _render_base_grid(
+    h: int,
+    w: int,
+    pattern_w: int,
+    period_x: int,
+    period_y: int,
+    orange_cells: tuple[tuple[int, int], ...],
+) -> np.ndarray:
