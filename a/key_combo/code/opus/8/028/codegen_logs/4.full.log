+                for end in end_pool:
+                    if end == start or end not in dist or dist[end] < GEN_MIN_PATH_LEN:
+                        continue
+                    path = []
+                    cur = end
+                    while cur is not None:
+                        path.append(cur)
+                        cur = parent[cur]
+                    path.reverse()
+                    turns = _path_turns(path)
+                    if turns < GEN_MIN_TURNS:
+                        continue
+                    score = dist[end] * 10 + turns
+                    candidates.append((score, turns, path, start, end))
