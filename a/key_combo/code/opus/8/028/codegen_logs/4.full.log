+if str(_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_UTILS_DIR))
+
+from arc_utils import Color, bbox, components_mask, crop_bbox, in_bounds, neighbors4, neighbors8
+
+
+PATTERN_HEIGHT = 2
+MIN_PERIOD = 4
+MAX_PERIOD = 6
+
+GEN_H_RANGE = (16, 24)
+GEN_W_RANGE = (16, 24)
+GEN_PATTERN_WIDTHS = (2, 3)
+GEN_MIN_PATH_LEN = 12
+GEN_MIN_TURNS = 2
+GEN_MAX_ATTEMPTS = 400
+GEN_EDGE_SAMPLE = 8
