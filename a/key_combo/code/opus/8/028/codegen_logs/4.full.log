            for c in range(pw,pw+px):
              if c<W: g[0,c]=GREY
            for r in range(2,2+py):
              if r<H: g[r,0]=GREY
            for r,c in pts: g[r,c]=ORANGE
            obs=set()
            for br,bc in pts:
              rr=br
              while rr<H:
                cc=bc
                while cc<W:
                  if g[rr,cc] in (TEAL,ORANGE): obs.add((rr,cc))
                  cc += px
                rr += py
            forb=set(obs)
            for r,c in list(obs):
              for nr,nc in n8(r,c):
                if inb(g.shape,nr,nc) and g[nr,nc]==TEAL: forb.add((nr,nc))
            passable=np.array([[g[r,c]==TEAL and (r,c) not in forb for c in range(W)] for r in range(H)], bool)
            edge=[(r,c) for r in range(H) for c in range(W) if passable[r,c] and (r in (0,H-1) or c in (0,W-1))]
            cand1=[p for p in edge if p[0]==H-1 or p[1]==0]
            cand2=[p for p in edge if p[0]==0 or p[1]==W-1]
            best=None
            for s in cand1:
              d=bfs(passable,s)
              for t in cand2:
