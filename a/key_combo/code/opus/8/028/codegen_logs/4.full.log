+    path = []
+    cur = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
+
+
+def _bridge_edges(passable: np.ndarray, start: tuple[int, int]) -> set[frozenset[tuple[int, int]]]:
+    sys.setrecursionlimit(10000)
