+    r0, c0, r1, c1 = rect_bbox
+    for r, c, color in sources:
+        if r0 <= r <= r1 and c > c1:
+            for cc in range(c1 + 1, c + 1):
+                out[r, cc] = color
+        elif r0 <= r <= r1 and c < c0:
+            for cc in range(c, c0):
+                out[r, cc] = color
+        elif c0 <= c <= c1 and r < r0:
