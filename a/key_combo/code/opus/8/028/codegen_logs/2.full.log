+    orange_rows = [interaction_rows[0], interaction_rows[1], rect_only_row, vertical_barrier_row, left_edge_row]
+    run_lengths = {r: random.randint(2, 4) for r in orange_rows}
+
+    colors = list(RAY_COLORS)
+    random.shuffle(colors)
