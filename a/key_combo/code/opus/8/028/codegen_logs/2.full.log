+    return {
+        "shape": (h, w),
+        "rect": (r0, c0, r1, c1),
+        "horizontal_sources": horiz_specs,
+        "vertical_source": vertical_spec,
+        "orange_rows": orange_rows,
+        "run_lengths": run_lengths,
+        "interaction_rows": interaction_rows,
