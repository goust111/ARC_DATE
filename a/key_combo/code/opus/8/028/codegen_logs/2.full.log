+
+
+def _render_input(spec: dict) -> np.ndarray:
+    h, w = spec["shape"]
+    r0, c0, r1, c1 = spec["rect"]
+    grid = np.full((h, w), BG, dtype=int)
+    grid[r0 : r1 + 1, c0 : c1 + 1] = RECT
