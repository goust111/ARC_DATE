+    bbox = _bbox_coords(rect_coords)
+    r0, c0, r1, c1 = bbox
+    if not np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == RECT):
+        raise AssertionError("largest gray component must be a solid rectangle")
+    return bbox
