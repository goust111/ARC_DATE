+        target_start = int(blockers[-1]) + 1 if len(blockers) else 0
+        out[row, start:w] = BG
+        out[row, target_start : target_start + run_len] = MOVING
+    return out
+
+
+def _validate_spec_and_grid(spec: dict, grid: np.ndarray) -> bool:
