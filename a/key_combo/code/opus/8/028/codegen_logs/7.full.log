+        color = frame_colors[frame_idx]
+        for r, c in _border_cells(rects[frame_idx]):
+            inp[r, c] = color
+            out[r, c] = color
+
+    for frame_idx, cells in enumerate(masks):
+        rank = depth_order.index(frame_idx) + 1
+        color = rank_colors[rank]
+        for r, c in cells:
+            out[r, c] = color
+
