+def _normalized_shape(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
