+def _render_case(
+    rects: list[tuple[int, int, int, int]],
+    frame_colors: list[int],
+    depth_order: list[int],
+    masks: list[list[tuple[int, int]]],
+    rank_colors: dict[int, int],
+    rng: np.random.Generator,
+    area_h: int,
+    area_w: int,
+) -> tuple[np.ndarray, np.ndarray]:
