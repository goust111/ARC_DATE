+
+def _unique_topological_order(n: int, edges: set[tuple[int, int]]) -> list[int]:
+    outgoing = {i: set() for i in range(n)}
+    indeg = [0] * n
+    for src, dst in edges:
+        if dst not in outgoing[src]:
+            outgoing[src].add(dst)
+            indeg[dst] += 1
