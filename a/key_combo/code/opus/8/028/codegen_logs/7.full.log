+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        frame_idx = order[pos]
+        options = candidates[frame_idx][:]
+        rng.shuffle(options)
+        for subset in options[:MASK_PICK_RETRIES]:
+            shape = _normalized_shape(subset)
+            if shape in used_shapes:
+                continue
+            used_shapes.add(shape)
+            chosen[frame_idx] = subset
+            if backtrack(pos + 1):
