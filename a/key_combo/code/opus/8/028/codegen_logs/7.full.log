+    order = []
+    remaining = set(range(n))
+    while remaining:
+        roots = [node for node in remaining if indeg[node] == 0]
+        assert len(roots) == 1, "depth constraints must define a unique total order"
+        node = roots[0]
+        remaining.remove(node)
+        order.append(node)
+        for dst in outgoing[node]:
