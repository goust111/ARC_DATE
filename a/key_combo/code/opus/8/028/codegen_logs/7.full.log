+
+
+def _visible_side_counts(grid: np.ndarray, color: int, bbox: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    top = int(np.sum(grid[r0, c0 : c1 + 1] == color))
+    bottom = int(np.sum(grid[r1, c0 : c1 + 1] == color))
