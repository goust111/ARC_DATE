        if any(nc in allb for nc in neigh4(cell)):
          continue
        ex.append(cell)
      counts.append(len(ex))
    if min(counts)>=3: return rects, counts
  return None

for n in [3,4]:
  succ=0
  for _ in range(10):
    if sample(n): succ+=1
  print(n,succ)
