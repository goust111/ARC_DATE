+import itertools
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLORS = (1, 2, 3, 4)
+MASK_COLOR = 5
+LEGEND_COLORS = (6, 7, 8, 9)
+
+GEN_RETRIES = 400
+RECT_RETRIES = 3000
+MASK_PICK_RETRIES = 80
