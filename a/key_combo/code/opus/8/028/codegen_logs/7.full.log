+    rank_colors = {rank: legend_palette[rank - 1] for rank in range(1, n + 1)}
+    masks = _pick_masks(rects, rng)
+    if masks is None:
+        return None
+
+    inp, expected = _render_case(rects, frame_colors, depth_order, masks, rank_colors, rng, area_h, area_w)
