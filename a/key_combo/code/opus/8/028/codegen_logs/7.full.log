+    legend_palette = [int(v) for v in rng.choice(np.array(LEGEND_COLORS), size=n, replace=False)]
+    depth_order = [int(v) for v in rng.permutation(n)]
+    if _is_trivial_order(rects, frame_colors, depth_order):
