+            continue
+        seen.add(cell)
+        for nxt in _neighbors4(cell):
+            if nxt in cell_set and nxt not in seen:
+                stack.append(nxt)
+    return seen == cell_set
+
+
+def _normalized_shape(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
