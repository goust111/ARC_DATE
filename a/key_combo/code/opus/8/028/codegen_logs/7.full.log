+def _is_trivial_order(
+    rects: list[tuple[int, int, int, int]],
+    frame_colors: list[int],
+    order: list[int],
+) -> bool:
+    naive_orders = []
+    naive_orders.append(tuple(sorted(range(len(rects)), key=lambda i: (rects[i][0], rects[i][1]))))
+    naive_orders.append(tuple(sorted(range(len(rects)), key=lambda i: (rects[i][1], rects[i][0]))))
+    naive_orders.append(tuple(sorted(range(len(rects)), key=lambda i: ((rects[i][2] - rects[i][0] + 1) * (rects[i][3] - rects[i][1] + 1), i))))
+    naive_orders.append(tuple(sorted(range(len(rects)), key=lambda i: (frame_colors[i], i))))
