import random

def border(b):
    r0,c0,r1,c1=b
    s=set()
    for c in range(c0,c1+1): s.add((r0,c)); s.add((r1,c))
    for r in range(r0,r1+1): s.add((r,c0)); s.add((r,c1))
    return s

def interior(b):
    r0,c0,r1,c1=b
    return {(r,c) for r in range(r0+1,r1) for c in range(c0+1,c1)}

def safe(b):
    r0,c0,r1,c1=b
    return {(r,c) for r in range(r0+2,r1-1) for c in range(c0+2,c1-1)}

def neigh4(cell):
    r,c=cell
    return [(r,c),(r+1,c),(r-1,c),(r,c+1),(r,c-1)]

def sample(n,tries=50000):
  area_h, area_w = 15, 16
  for t in range(tries):
    rects=[]
    for i in range(n):
      h=random.choice([6,7])
      w=random.choice([6,7])
      r0=random.randint(0, area_h-h)
      c0=random.randint(0, area_w-w)
      rects.append((r0,c0,r0+h-1,c0+w-1))
    if len(set(rects)) "'!= n: continue
    vals=[[r[0] for r in rects],[r[2] for r in rects],[r[1] for r in rects],[r[3] for r in rects]]
    if any(len(set(v))<n for v in vals): continue
    borders=[border(b) for b in rects]
    if any(not (borders[i]&borders[j]) for i in range(n) for j in range(i+1,n)): continue
    if any(sum(cell in b for b in borders)>=3 for cell in set().union(*borders)): continue
    ints=[interior(b) for b in rects]
    allb=set().union(*borders)
    counts=[]
    for i,b in enumerate(rects):
      ex=[]
      for cell in safe(b):
        if any(cell in ints[j] for j in range(n) if j!=i):
