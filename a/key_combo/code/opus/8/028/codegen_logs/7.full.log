+
+def _is_connected(cells: tuple[tuple[int, int], ...] | list[tuple[int, int]] | set[tuple[int, int]]) -> bool:
+    cell_set = set(cells)
+    if not cell_set:
+        return False
+    stack = [next(iter(cell_set))]
+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nxt in _neighbors4(cell):
