+    for bbox, color in zip(rects, frame_colors):
+        coords = np.argwhere(inp == color)
+        found = _bbox_from_coords(coords)
+        if found != bbox:
+            return None
+        if min(_visible_side_counts(inp, color, bbox)) < 2:
