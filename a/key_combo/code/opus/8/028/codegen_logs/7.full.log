+
+
+def _pick_masks(
+    rects: list[tuple[int, int, int, int]], rng: np.random.Generator
+) -> list[list[tuple[int, int]]] | None:
+    interiors = [_interior_cells(bbox) for bbox in rects]
+    borders = [_border_cells(bbox) for bbox in rects]
