+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    frames = _extract_frames(g)
+    legend = _extract_legend(g, len(frames))
+    order = _infer_depth_order(g, frames)
+    masks = _assign_masks(g, frames)
