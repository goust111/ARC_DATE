def border(b):
    r0,c0,r1,c1=b
    s=set()
    for c in range(c0,c1+1): s.add((r0,c)); s.add((r1,c))
    for r in range(r0,r1+1): s.add((r,c0)); s.add((r,c1))
    return s

def interior(b):
    r0,c0,r1,c1=b
    return {(r,c) for r in range(r0+1,r1) for c in range(c0+1,c1)}

def safe(b):
