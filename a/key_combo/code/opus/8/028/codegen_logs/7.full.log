+        assert min(r1 - r0 + 1, c1 - c0 + 1) >= 4, "frame must be at least 4x4"
+        for r, c in coords:
+            rr = int(r)
+            cc = int(c)
+            assert rr in (r0, r1) or cc in (c0, c1), "frame color must lie on its rectangle border"
