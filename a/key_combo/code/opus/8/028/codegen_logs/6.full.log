        if idx < rows - 1:
            grid[cursor, :] = WALL
            cursor += 1

    cursor = 1
    for idx, span in enumerate(col_spans):
        room_cols.append((cursor, cursor + span - 1))
        cursor += span
        if idx < cols - 1:
            grid[:, cursor] = WALL
            cursor += 1

    if chamber_count == 5:
        doorway_vertical = random.choice([False, True])
        if doorway_vertical and cols >= 2:
