    red = np.zeros(GRID_SHAPE, dtype=bool)
    r, c = DIAGONAL_START_ROW, LOWER_LEFT[1]
    red[r, c] = True
    for gap in range(end_col + 1):
        if gap in down_gaps:
            r += 1
            red[r, c] = True
        if gap < end_col:
            c += 1
            red[r, c] = True
    return red


