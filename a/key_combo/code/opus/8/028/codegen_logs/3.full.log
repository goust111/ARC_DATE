/bin/bash -lc "python - <<'PY'
from collections import deque
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/8/028/3.py')
mod = SourceFileLoader('new_arc_task_check', str(p)).load_module()
BG, BLUE, RED = 0, 1, 2


def comps(mask):
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cur = []
            while q:
                rr, cc = q.popleft()
                cur.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(cur)
    return out


def hole_count(crop):
    total = 0
    for comp in comps(crop == BG):
        rs = [r for r, _ in comp]
        cs = [c for _, c in comp]
        if min(rs) == 0 or min(cs) == 0 or max(rs) == crop.shape[0] - 1 or max(cs) == crop.shape[1] - 1:
            continue
        total += len(comp)
    return total


def expected(grid):
    red_comps = comps(grid == RED)
    blues = {(r, c) for r, c in zip(*np.where(grid == BLUE))}
    assert len(red_comps) == len(blues) >= 3
    out = grid.copy()
    out[out == RED] = BG
    for comp in sorted(red_comps, key=lambda pts: (min(r for r, _ in pts), min(c for _, c in pts))):
        rs = [r for r, _ in comp]
        cs = [c for _, c in comp]
        r0, r1 = min(rs), max(rs)
        c1 = max(cs)
        matches = sorted((r, c) for r, c in blues if r0 <= r <= r1 and c > c1)
        assert len(matches) == 1
        barrier_c = matches[0][1]
        crop = grid[r0 : r1 + 1, min(cs) : c1 + 1]
        shift = min(hole_count(crop), barrier_c - 1 - c1)
        for r, c in comp:
            out[r, c + shift] = RED
    return out

for _ in range(200):
    inp = mod.generate_input()
    got = mod.main(inp)
    want = expected(inp)
    assert np.array_equal(got, want)
print('independent semantic check passed')
