        left = rng.randint(1, max_left)
        lefts.append(left)
        barrier_col = left + spec["width"] + spec["gap"]
        needed_width = max(needed_width, barrier_col + 1)
    width = needed_width + rng.randint(1, 3)
    if width > 30:
        return None

    grid = np.full((height, width), BG, dtype=int)
    plan = []

