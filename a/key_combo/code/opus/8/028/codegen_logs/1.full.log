+    elif arm == "E":
+        mask[mid, mid:] = True
+    elif arm == "S":
+        mask[mid:, mid] = True
+    elif arm == "W":
+        mask[mid, : mid + 1] = True
+    else:
+        raise ValueError(f"unknown arm {arm}")
+
+
