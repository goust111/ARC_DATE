+    return {key: random.choice(MARKER_COLORS) for key in keys}
+
+
+def _place_markers(
+    size: int,
+    full_wall: np.ndarray,
+    chambers: dict[tuple[int, int, int], np.ndarray],
+    targets: dict[tuple[int, int, int], int],
