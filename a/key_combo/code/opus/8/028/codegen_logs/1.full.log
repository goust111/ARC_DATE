+    mid = mask.shape[0] // 2
+    lo = mid - radius
+    hi = mid + radius
+    if side == "T":
+        mask[lo, lo : hi + 1] = True
+    elif side == "R":
+        mask[lo : hi + 1, hi] = True
+    elif side == "B":
+        mask[hi, lo : hi + 1] = True
+    elif side == "L":
+        mask[lo : hi + 1, lo] = True
+    else:
