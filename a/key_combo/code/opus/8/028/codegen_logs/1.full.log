+    candidates = _good_marker_cells(coords)
+    random.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    for r, c in candidates:
+        if all(abs(r - rr) + abs(c - cc) >= 2 for rr, cc in chosen):
+            chosen.append((r, c))
+        if len(chosen) == count:
+            return chosen
+    for cell in candidates:
+        if cell not in chosen:
+            chosen.append(cell)
+        if len(chosen) == count:
+            return chosen
