+    wall[mid, :] = True
+    wall[:, mid] = True
+
+    lo = mid - radius
+    hi = mid + radius
+    wall[lo, lo : hi + 1] = True
+    wall[hi, lo : hi + 1] = True
+    wall[lo : hi + 1, lo] = True
+    wall[lo : hi + 1, hi] = True
+    return wall
+
+
+def _add_arm(mask: np.ndarray, arm: str) -> None:
+    size = mask.shape[0]
+    mid = size // 2
