+    mid = size // 2
+    wall = np.zeros((size, size), dtype=bool)
+    wall[mid, :] = True
+    wall[:, mid] = True
+
+    lo = mid - radius
+    hi = mid + radius
+    wall[lo, lo : hi + 1] = True
+    wall[hi, lo : hi + 1] = True
+    wall[lo : hi + 1, lo] = True
+    wall[lo : hi + 1, hi] = True
+    return wall
+
+
