+    candidates: list[tuple[str, int, int]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if int(ideal[rr, cc]) != int(color):
+            continue
+        if int(mask.sum()) <= 3:
+            break
+        shrunk = mask.copy()
+        shrunk[rr, cc] = False
+        if shrunk.sum() >= 3 and _single_component(shrunk):
+            candidates.append(("remove", rr, cc))
