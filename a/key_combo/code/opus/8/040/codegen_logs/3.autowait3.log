+def _valid_right_panel(right: np.ndarray, n_obj: int) -> bool:
+    colors = [int(c) for c in np.unique(right) if int(c) != Color.BLACK]
+    if len(colors) != n_obj:
+        return False
+    comps = find_components(right, bg=Color.BLACK, connectivity=4, monochromatic=True)
+    if len(comps) != n_obj:
+        return False
