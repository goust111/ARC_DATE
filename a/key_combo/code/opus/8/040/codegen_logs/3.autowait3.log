+
+
+def _single_component(mask: np.ndarray) -> bool:
+    comps = components_mask(mask, connectivity=4)
+    return len(comps) == 1
+
+
+def _noise_candidates(actual: np.ndarray, ideal: np.ndarray, color: int) -> list[tuple[str, int, int]]:
+    mask = actual == int(color)
+    if not mask.any():
