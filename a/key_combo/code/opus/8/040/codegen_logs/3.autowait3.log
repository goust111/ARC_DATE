+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    arr = np.array([(r - r0, c - c0) for r, c in coords], dtype=int)
+    return arr[np.lexsort((arr[:, 1], arr[:, 0]))]
+
+
+def _random_object_mask(area: int) -> np.ndarray:
+    coords = {(0, 0)}
+    while len(coords) < area:
