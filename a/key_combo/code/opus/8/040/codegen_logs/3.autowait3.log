+def _separator_col(grid: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    candidates: list[int] = []
+    for c in range(1, w - 1):
+        col = grid[:, c]
+        if np.all(col == col[0]) and int(col[0]) != int(bg) and c == w - c - 1:
+            candidates.append(int(c))
