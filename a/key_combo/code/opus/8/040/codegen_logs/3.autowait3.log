  "type": "symmetry/pattern",
  "src": "8-connected yellow object s touching one side of a contiguous red vertical mirror segment, plus the lone marker pixel in s's reflected footprint",
  "dst": "opposite-side mirror footprint of s across the red segment",
  "transform": "paint every pixel of dst with the marker color; preserve the original yellow object, red segment, and marker"
}
</annotation>
<generation_spec>
```yaml
