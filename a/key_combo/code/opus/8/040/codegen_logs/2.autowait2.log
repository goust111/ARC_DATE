+            new_left = lefts[-1] + int(rng.choice([-1, 0, 1]))
+            new_right = rights[-1] + int(rng.choice([-1, 0, 1]))
+            if ROW_SPAN_RANGE[0] <= new_right - new_left <= ROW_SPAN_RANGE[1]:
