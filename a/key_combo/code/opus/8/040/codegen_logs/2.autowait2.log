+    cells: list[tuple[int, int]] = []
+    for r in sorted(contour["row_bounds"]):
+        left, right = contour["row_bounds"][r]
+        for c in range(int(left) + 1, int(right)):
+            cells.append((int(r), int(c)))
+    return cells
