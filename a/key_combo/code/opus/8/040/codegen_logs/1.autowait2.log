+    dc = 1 if cc == 0 else -1
+    return int(dr), int(dc)
+
+
+def _edge_for_component(coords: np.ndarray, shape: tuple[int, int]) -> str | None:
+    h, w = map(int, shape)
+    rs = coords[:, 0]
+    cs = coords[:, 1]
+    if np.all(rs < 3):
+        return "top"
+    if np.all(rs >= h - 3):
+        return "bottom"
+    if np.all(cs < 3):
+        return "left"
+    if np.all(cs >= w - 3):
+        return "right"
+    return None
