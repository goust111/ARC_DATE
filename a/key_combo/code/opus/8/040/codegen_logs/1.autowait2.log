+    comps = find_components(g, bg=get_bg(g), connectivity=8, monochromatic=True, colors=[GLYPH], return_format="dict")
+    glyph_comps: list[dict] = []
+    by_edge = {edge: [] for edge in EDGE_NAMES}
+    for comp in comps:
+        area = int(comp["area"])
+        if not (3 <= area <= 7):
