+        reserve_right = 5 if start[1] >= w - 3 else 1
+        lo = reserve_left
+        hi = w - reserve_right - total_span
+        if hi < lo:
+            return None
+        cur = random.randint(lo, hi)
+        origins = []
+        for idx in range(count):
+            origins.append(cur)
+            cur += 3
+            if idx < count - 1:
