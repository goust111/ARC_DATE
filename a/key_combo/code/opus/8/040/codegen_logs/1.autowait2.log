+def _advance_one_counted(
+    state: tuple[int, int, int, int, int],
+    shape: tuple[int, int],
+    wall_map: dict[tuple[int, int], int],
+) -> tuple[tuple[int, int, int, int, int], tuple[int, int], bool, int]:
