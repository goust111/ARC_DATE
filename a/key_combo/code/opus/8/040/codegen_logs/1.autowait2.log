+    glyph_mask: np.ndarray | None = None,
+) -> tuple[np.ndarray, dict[str, object]]:
+    out = np.asarray(base_grid, dtype=int).copy()
+    state = (int(start[0]), int(start[1]), *_initial_direction(start, out.shape), START)
+    stats = {
+        "hit_count": 0,
+        "boundary_bounces": 0,
+        "path_cells": [],
+        "path_set": set(),
+        "hit_colors": set(),
+        "touched_band": False,
+        "touched_glyph": False,
+        "revisited_start": False,
+    }
