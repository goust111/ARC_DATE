+        return origins
+
+    reserve_top = 5 if start[0] <= 2 else 1
+    reserve_bottom = 5 if start[0] >= h - 3 else 1
+    lo = reserve_top
+    hi = h - reserve_bottom - total_span
+    if hi < lo:
