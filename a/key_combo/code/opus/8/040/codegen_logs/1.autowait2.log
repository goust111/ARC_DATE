+            mask = GLYPH_TEMPLATES[int(area)].astype(bool)
+            grid[int(r0) : int(r0) + 3, col0 : col0 + 3][mask] = GLYPH
+
+
+def _layout_glyphs(shape: tuple[int, int], edge: str, start: tuple[int, int], areas: list[int]) -> list[int] | None:
+    h, w = map(int, shape)
+    count = len(areas)
