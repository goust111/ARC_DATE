+START = 5
+GLYPH = 7
+WALL_COLORS = (1, 2, 3, 4)
+EDGE_NAMES = ("top", "bottom", "left", "right")
+
+GLYPH_TEMPLATES = {
+    3: np.array([[1, 0, 0], [0, 1, 0], [0, 0, 1]], dtype=int),
+    4: np.array([[1, 1, 0], [0, 1, 0], [0, 0, 1]], dtype=int),
+    5: np.array([[1, 0, 1], [0, 1, 0], [1, 0, 1]], dtype=int),
+    6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),
