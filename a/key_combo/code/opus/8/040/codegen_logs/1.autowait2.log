+        row0 = 0 if edge == "top" else grid.shape[0] - 3
+        for c0, area in zip(origins, areas):
+            mask = GLYPH_TEMPLATES[int(area)].astype(bool)
+            grid[row0 : row0 + 3, int(c0) : int(c0) + 3][mask] = GLYPH
+    else:
