+
+_ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
+_ARC_UTILS_SPEC = spec_from_file_location("_shared_arc_utils_for_040_1", _ARC_UTILS_PATH)
