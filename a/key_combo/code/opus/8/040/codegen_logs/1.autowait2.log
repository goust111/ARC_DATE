+            return None
+
+        min_future = 1 if idx == len(colors) - 1 else 2
+        future = [item for item in future if total_steps - (counted_done + item[0]) >= min_future]
+        if not future:
+            return None
+
+        dist, landed = random.choice(future[: min(len(future), 6)])
