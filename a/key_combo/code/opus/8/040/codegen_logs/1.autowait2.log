+            if landed == start:
+                stats["revisited_start"] = True
+            if out[r, c] != GLYPH:
+                out[r, c] = int(state[4])
+            if hit_wall:
+                stats["hit_count"] += 1
+                stats["hit_colors"].add(int(state[4]))
+            stats["path_cells"].append((int(r), int(c)))
+            stats["path_set"].add((int(r), int(c)))
