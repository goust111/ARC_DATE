    main_color = random.choice(MAIN_COLORS)
    stamp_size = random.choice(STAMP_SIZES)
    stamp = _gen_stamp(stamp_size)

    macro_h = _randint(MACRO_H_RANGE)
    macro_w = _randint(MACRO_W_RANGE)
    selector = _gen_selector(macro_h, macro_w)

