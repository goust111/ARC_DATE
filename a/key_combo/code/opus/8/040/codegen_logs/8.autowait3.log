51: # Canvas, palette, sampling bounds, and retry limit.
52: CANVAS_SIZE = 10
53: BACKGROUND = 0
54: COLOR_RANGE = range(1, 10)
55: OUTLINE_COUNT_BOUNDS = (1, 3)
56: HEIGHT_BOUNDS = (3, 5)
57: GENERATION_ATTEMPTS = 300
