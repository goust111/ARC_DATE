162: def _gen_max_gap(region: dict[str, int | str], color: int, width: int, split_type: str) -> int:
163:     reg_w = int(region["c1"]) - int(region["c0"]) + 1
164:     max_gap = reg_w - width
165:     if split_type == "vertical":
166:         if color == _GEN_BLUE and region["side"] == "right":
167:             max_gap -= _GEN_VERTICAL_SPLIT_CLEARANCE
168:         elif color == _GEN_TEAL and region["side"] == "left":
169:             max_gap -= _GEN_VERTICAL_SPLIT_CLEARANCE
170:     return min(_GEN_MAX_SLIDE_GAP, max_gap)
