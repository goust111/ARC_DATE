187:             min_rows = count * _GEN_MIN_RECT_HEIGHT + (count - 1) * _GEN_MIN_ROW_GAP
188:             if _gen_region_capacity(region, split_type) < min_rows:
189:                 ok = False
190:                 break
191:         if ok:
192:             options.append(counts)
193:     if not options:
194:         return None
195:     return list(options[int(rng.integers(0, len(options)))])
