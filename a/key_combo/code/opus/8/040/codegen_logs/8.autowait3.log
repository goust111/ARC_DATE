spec:
  grid: 18-20 rows x 18-20 cols; bg = 0; 2-7 non-bg colors
  arrows:
    shape: |
      3 pixels in a 2x2 bbox with one corner missing — an L-shape.
      Missing corner determines diagonal fire direction (away from it).
      Ray starts at the right-angle vertex (the pixel with 2 neighbors).
    count: 1-14
    colors: each arrow one non-bg color; multiple arrows may share a color
  walls:
    shape: single pixel (size 1) or 3-pixel axis-aligned line; each mono-color
    count: 0-6 segments; equals total bounces across all arrows
    placement: |
      1 cell off the ray diagonal in the direction of travel on one axis.
      Vertical wall flips dc; horizontal wall flips dr (side-touch only).
      Each wall is adjacent to exactly 1 ray cell (the bounce point).
  ray_rule:
    trace: step diagonally (dr,dc) from arrow start, painting bg cells in current color
    bounce: |
      Side-touch only in eval data [observed]. After advancing to (r,c):
        if (r+dr,c) is wall -> flip dr, adopt wall color, recolor (r,c)
        if (r,c+dc) is wall -> flip dc, adopt wall color, recolor (r,c)
      Corner bounce (head-on into wall) reverses both axes — handled by solver but not observed.
    color_inherit: ray starts in arrow color; adopts wall color at each bounce
    stop: exit grid (all rays exit grid in eval data [observed])
    bounces_per_arrow: 0-4
    segment_length: 2-16 cells between bounces [observed]
    no_overlap: rays, arrows, and walls never share cells

generation_strategy:
  approach: output-first — plan ray zigzag paths, then derive input
  steps:
