149: def _gen_safe_rows(region: dict[str, int | str], split_type: str) -> tuple[int, int] | None:
150:     r0 = int(region["r0"])
151:     r1 = int(region["r1"])
152:     if split_type == "horizontal":
153:         if region["side"] == "top":
154:             r1 -= 1
155:         else:
156:             r0 += 1
157:     if r0 > r1:
158:         return None
159:     return r0, r1
