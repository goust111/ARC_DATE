+    if black_coords.shape[0] == 1:
+        gap = tuple(map(int, black_coords[0]))
+        assert gap in {(0, 1), (2, 1), (1, 0), (1, 2)}
+        info["kind"] = "door"
+        info["gap_local"] = gap
+    else:
+        assert black_coords.shape[0] == 0
+        info["kind"] = "normal"
+    return info
