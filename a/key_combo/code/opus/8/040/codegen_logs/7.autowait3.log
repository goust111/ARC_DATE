+    door_dir_a, door_dir_b = door_directions[int(rng.integers(0, len(door_directions)))]
+    moved_dirs = [door_dir_a, door_dir_b] + [str(rng.choice(list(_DIRS.keys()))) for _ in range(ordinary_count)]
+
+    moved_final: list[tuple[int, int]] = []
