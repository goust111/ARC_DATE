+def _detect_blocks(grid: np.ndarray) -> list[dict[str, object]]:
+    blocks = []
+    for coords in components_mask(grid != Color.BLACK, connectivity=4):
+        b = bbox_coords(coords)
+        assert b[2] - b[0] == 2 and b[3] - b[1] == 2, "every block must be 3x3"
