+    "left": (0, -1),
+    "right": (0, 1),
+}
+_OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+_EDGE_MID = {"up": (0, 1), "down": (2, 1), "left": (1, 0), "right": (1, 2)}
+_MARKER_PATTERNS = {
+    "up": [[(0, 1)], [(0, 1), (0, 0)], [(0, 1), (0, 2)]],
+    "down": [[(2, 1)], [(2, 1), (2, 0)], [(2, 1), (2, 2)]],
+    "left": [[(1, 0)], [(1, 0), (0, 0)], [(1, 0), (2, 0)]],
+    "right": [[(1, 2)], [(1, 2), (0, 2)], [(1, 2), (2, 2)]],
+}
+_MARKER_COLORS = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
+_RETRY_LIMIT = 500
