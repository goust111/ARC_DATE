+}
+_MARKER_COLORS = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
+_RETRY_LIMIT = 500
