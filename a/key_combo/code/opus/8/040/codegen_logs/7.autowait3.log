+    if direction == "up":
+        return 0, c
+    if direction == "down":
+        return h - 3, c
+    if direction == "left":
+        return r, 0
+    assert direction == "right"
+    return r, w - 3
+
+
+def _reachable(
+    grid: np.ndarray,
+    seed: tuple[int, int],
+    moves: list[tuple[int, int]],
+    bounds: tuple[int, int, int, int],
+) -> np.ndarray:
+    r0, c0, r1, c1 = bounds
+    assert grid[seed] == Color.BLACK
+    seen = np.zeros(grid.shape, dtype=bool)
+    seen[seed] = True
+    q = deque([seed])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in moves:
+            rr, cc = r + dr, c + dc
+            if r0 <= rr <= r1 and c0 <= cc <= c1 and grid[rr, cc] == Color.BLACK and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _solve_layout(grid: np.ndarray) -> tuple[np.ndarray, list[tuple[int, int]], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    blocks = _detect_blocks(g)
+    doors: list[tuple[tuple[int, int], tuple[int, int]]] = []
+
+    for block in blocks:
+        kind = block["kind"]
+        r0, c0, r1, c1 = block["bbox"]
+        if kind == "blank":
+            continue
+
+        patch = block["patch"]
