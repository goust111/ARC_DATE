 261: def _gen_pair_is_valid(inp: np.ndarray, out: np.ndarray) -> bool:
 262:     wall_fraction = float(np.count_nonzero(inp == _GEN_WALL)) / inp.size
 263:     if not (_GEN_WALL_FRACTION_RANGE[0] <= wall_fraction <= _GEN_WALL_FRACTION_RANGE[1]):
 264:         return False
 265:     try:
 266:         solved = main(inp)
 267:     except Exception:
 268:         return False
 269:     return bool(np.array_equal(solved, out))
