+def _infer_cycle(grid: np.ndarray, side: str) -> tuple[int, dict[int, int]]:
+    visible: list[tuple[int, int, int]] = []
+    for r, c in _band_coords(grid.shape, side):
+        value = int(grid[r, c])
+        if value not in (BLACK, MARKER):
+            visible.append((r, c, value))
