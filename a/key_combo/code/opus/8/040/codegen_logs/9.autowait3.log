        x2, y2 = _loc
        paste(grid, rectangle2, x2, y2, transparent=Color.BLACK, clip=True)
        # Ensure the two rectangles can be connected
        main(grid)
    except Exception as e:
        # If not, regenerate the input
        return generate_input()

