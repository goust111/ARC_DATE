 240: def _gen_render_cavity(rng: np.random.Generator, inp: np.ndarray, out: np.ndarray, rect: tuple[int, int, int, int], seed_color: int) -> bool:
 241:     r0, c0, r1, c1 = rect
 242:     cavity_h, cavity_w = r1 - r0 + 1, c1 - c0 + 1
 243:     tile_specs = _gen_tile_specs(rng, cavity_h, cavity_w)
 244:     if tile_specs is None:
 245:         return False
 246:     tile_h, tile_w, seed_count = tile_specs
 247:     tile = _gen_tile(rng, tile_h, tile_w, int(seed_color), seed_count)
 248: 
 249:     rep_r, rep_c = cavity_h // tile_h, cavity_w // tile_w
 250:     out[r0 : r1 + 1, c0 : c1 + 1] = np.tile(tile, (rep_r, rep_c))
 251:     inp[r0 : r1 + 1, c0 : c1 + 1] = _GEN_EMPTY
 252: 
 253:     seed_rep_r = int(rng.integers(0, rep_r))
 254:     seed_rep_c = int(rng.integers(0, rep_c))
 255:     sr = r0 + seed_rep_r * tile_h
 256:     sc = c0 + seed_rep_c * tile_w
 257:     inp[sr : sr + tile_h, sc : sc + tile_w] = tile
 258:     return True
