spec:
  grid: 20-23 rows x 20-23 cols, always square [observed]
  background: 0 (black)
  foreground: exactly 1 non-background color (any ARC color)
  objects:
    count: exactly 4, 8-connected components of the single foreground color
    symmetric: 3 objects whose tight-bbox foreground mask is LR-symmetric
    asymmetric: exactly 1 object whose tight-bbox foreground mask is NOT LR-symmetric (the target)
    bbox_size: 3-7 rows x 4-9 cols per object; area 15-36 cells
    fill_density: 0.40-0.66
    none_are_UD_symmetric: true [observed]
  placement:
    objects are non-overlapping with >=2 cell gap between bboxes
    objects may touch grid edges (margin >=0)
  output: tight bbox crop of the single LR-asymmetric object on background

generation_strategy:
  approach: direct construction
  steps:
    1. Pick grid size N in [20,23], set grid NxN, choose 1 foreground color.
    2. Generate 3 LR-symmetric sprites (random shape, then mirror left-to-right).
       Each bbox 3-7 rows x 4-9 cols, fill 0.40-0.66, 8-connected.
    3. Generate 1 LR-asymmetric sprite (random 8-connected shape, reject if LR-symmetric).
       Same bbox/fill constraints.
    4. Randomly place all 4 sprites on the grid with >=2 cell gap between bboxes.
       Allow touching grid edges. Retry placement on overlap.
    5. Output is the tight bbox crop of the asymmetric sprite.
```
