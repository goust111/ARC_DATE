+SPRITE_COLORS = [Color.BLUE, Color.GREEN, Color.YELLOW, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+GRID_HEIGHT_RANGE = (18, 24)
