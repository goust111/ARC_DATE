+                r0, c0, r1, c1 = map(int, rect["bbox"])
+                top_min, top_max = r0 + 1, r1 - box_h
+                left_min, left_max = c0 + 1, c1 - box_w
+                if top_min > top_max or left_min > left_max:
+                    continue
+                top = random.randint(top_min, top_max)
+                left = random.randint(left_min, left_max)
