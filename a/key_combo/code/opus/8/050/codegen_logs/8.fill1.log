+    if out_h > q or out_w > q:
+        if out_h > q and np.array_equal(base[: q, :out_w], base[out_h - q :, :out_w]):
+            return False
+        if out_w > q and np.array_equal(base[:out_h, : q], base[:out_h, out_w - q :]):
+            return False
+
+    return True
+
+
