+import random
+from math import ceil, floor
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+BASE_COLORS = (TEAL, GREEN, GREY)
+CONTROL_COLORS = (GREY, PINK, ORANGE, MAROON)
