        for i in range(band_rows):
            row = []
            for j in range(NUM_COL_BANDS):
                row.append(TARGET_COLOR_OFFSET + ((bits >> (i * NUM_COL_BANDS + j)) & 1))
            target.append(row)
        if _gen_target_ok(target, row_bands, col_bands):
