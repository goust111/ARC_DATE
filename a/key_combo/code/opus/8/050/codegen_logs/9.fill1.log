+    sr, sc = source["anchor"]
+    source_offsets = [(int(r) - sr, int(c) - sc) for r, c in source["cells"]]
+
+    out = g.copy()
+    for target in targets:
+        tr, tc = target["anchor"]
+        out[tr, tc] = BG
+        if target["active"]:
+            for r, c in target["label_cells"]:
+                out[r, c] = BG
