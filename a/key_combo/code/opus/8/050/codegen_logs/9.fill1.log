+                    "anchor": anchor,
+                    "label_cells": label_cells,
+                    "label_color": spec["color"],
+                    "label_area": spec["area"],
+                    "active": True,
+                    "copy_cells": copy_cells,
+                    "exposed_erased_cells": label_cells - copy_cells,
+                }
