+            assert _in_bounds(g.shape, rr, cc), "translated copy must stay in bounds"
+            out[rr, cc] = int(color)
+
+    return _crop_nonblack(out)
+
+
+def _build_target_specs(
+    rng: np.random.Generator, source_rel_cells: set[tuple[int, int]]
+) -> list[dict] | None:
