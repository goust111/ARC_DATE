+
+    grid = np.zeros((H, W), dtype=int)
+    occupied = np.zeros((H, W), dtype=bool)
+
+    fr0, fc0, fr1, fc1 = frame_bbox
+    grid[fr0, fc0 : fc1 + 1] = FRAME
+    grid[fr1, fc0 : fc1 + 1] = FRAME
