+def _sprite_cells(anchor: tuple[int, int], sprite: np.ndarray) -> set[tuple[int, int]]:
+    ar, ac = anchor
+    cells = set()
+    for r, c in np.argwhere(sprite):
+        cells.add((ar + int(r), ac + int(c)))
+    return cells
+
