+        legend_cols.reverse()
+    legend = np.array([[legend_cols[0], legend_cols[1]], [mapping[legend_cols[0]], mapping[legend_cols[1]]]], dtype=int)
+    legend_pos = _random_patch_positions(occupied, legend.shape)
+    if legend_pos is None:
