+    changed_targets = 0
+    for r, c in parsed["targets"]:
+        r0, r1 = parsed["row_spans"][r]
+        c0, c1 = parsed["col_spans"][c]
+        before = inp[r0 : r1 + 1, c0 : c1 + 1]
+        after = expected[r0 : r1 + 1, c0 : c1 + 1]
+        if np.count_nonzero(after != before) == 0:
+            return False
+        changed_targets += 1
+    if changed_targets == 0:
+        return False
