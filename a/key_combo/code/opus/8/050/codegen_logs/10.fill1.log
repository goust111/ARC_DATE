+            return False
+        altered = _replace_cell(
+            inp,
+            parsed["row_spans"],
+            parsed["col_spans"],
+            majority_cells[0],
+            parsed["cells"][parsed["minority_positions"][0][0]][parsed["minority_positions"][0][1]],
