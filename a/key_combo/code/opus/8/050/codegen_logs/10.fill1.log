+        _cell_sig(majority),
+        _cell_sig(exemplar_cell),
+        _cell_sig(target_cell),
+        _cell_sig(stamped_target),
+    }
+    pattern_pool = [_random_pattern(cell_size, avoid=avoid) for _ in range(minority_types)]
