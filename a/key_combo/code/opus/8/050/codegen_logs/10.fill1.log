+    assert targets, "expected at least one target marker cell"
+
+    counts: Counter[tuple[int, ...]] = Counter()
+    sig_to_cell: dict[tuple[int, ...], np.ndarray] = {}
+    non_marker_positions: list[CellPos] = []
