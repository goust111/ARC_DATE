+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        built = _generate_once()
+        if built is None:
+            continue
+        inp, out, clipped = built
+        if _validate_instance(inp, out, require_clip=clipped and random.random() < 0.7):
