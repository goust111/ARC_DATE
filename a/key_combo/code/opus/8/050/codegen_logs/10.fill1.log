+        count = random.randint(1, min(5, cell_size + 1))
+        coords = random.sample(
+            [(r, c) for r in range(cell_size) for c in range(cell_size)],
+            count,
+        )
+        palette = [colors[0]] if random.random() < 0.55 else colors[:2]
+        for r, c in coords:
+            pat[r, c] = random.choice(palette)
