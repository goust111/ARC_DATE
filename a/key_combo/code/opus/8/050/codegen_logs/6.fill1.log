+            continue
+        comp: set[tuple[int, int]] = set()
+        queue = deque([(rr, cc)])
+        seen[rr, cc] = True
+        while queue:
+            cr, cc2 = queue.popleft()
+            comp.add((cr, cc2))
+            for nr, nc in _neighbors4(cr, cc2):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
