+    return True
+
+
+def _slot_boxes(out_h: int, out_w: int, shift: int) -> dict[str, tuple[int, int, int, int]]:
+    boxes = {}
+    for name, start in zip(("left", "center", "right"), BASE_SLOT_STARTS):
+        boxes[name] = (1, start + shift, out_h - 2, SLOT_WIDTH)
