+    options: list[set[tuple[int, int]]] = []
+    for mask in _variants_for_area(area, box_h, box_w):
+        h, w = mask.shape
+        for dr in range(box_h - h + 1):
+            for dc in range(box_w - w + 1):
+                cells = {
+                    (r0 + dr + rr, c0 + dc + cc)
+                    for rr, cc in np.argwhere(mask)
+                }
+                options.append(cells)
+    return options
