+    grown = set(winner)
+    for r, c in winner:
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(mask.shape, nr, nc) and not mask[nr, nc]:
+                grown.add((nr, nc))
+    for r, c in grown:
+        out_mask[r, c] = True
+
+    for comp in components:
+        if comp is winner:
+            continue
+        for r, c in comp:
+            if all((nr, nc) in comp for nr, nc in _neighbors4(r, c)):
+                out_mask[r, c] = True
+    return out_mask
