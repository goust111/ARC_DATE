+    for sprite in sorted(sprites, key=lambda item: (int(item["left"]), int(item["top"]))):
+        mask = sprite["mask"]
+        color = int(sprite["color"])
+        top = int(sprite["top"])
+        left = int(sprite["left"])
+        h = int(mask.shape[0])
+        occupied_local = np.argwhere(mask)
