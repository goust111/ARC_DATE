def _gen_cell_ranges(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int], int]:
    ranges = []
    dividers = []
    pos = 0
    for i, size in enumerate(sizes):
        ranges.append((pos, pos + size - 1))
        pos += size
        if i != len(sizes) - 1:
            dividers.append(pos)
            pos += 1
    return ranges, dividers, pos


