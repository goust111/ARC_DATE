+
+
+def _rotate_corners(block: np.ndarray, steps: int) -> np.ndarray:
+    out = np.array(block, dtype=int, copy=True)
+    for _ in range(steps % 4):
+        prev = out.copy()
+        out[0, 0] = prev[2, 0]
+        out[0, 2] = prev[0, 0]
+        out[2, 2] = prev[0, 2]
+        out[2, 0] = prev[2, 2]
