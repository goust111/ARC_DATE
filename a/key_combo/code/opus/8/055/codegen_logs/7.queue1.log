188: def _gen_skeleton_pool(size):
189:     size = int(size)
190:     if size in _GEN_SKELETON_CACHE:
191:         return _GEN_SKELETON_CACHE[size]
192: 
193:     shapes = {frozenset({(0, 0)})}
194:     for _ in range(size - 1):
