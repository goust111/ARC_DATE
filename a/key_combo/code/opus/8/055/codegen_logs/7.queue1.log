196:         for shape in shapes:
197:             frontier = set()
198:             for cell in shape:
199:                 frontier.update(neighbors4(*cell))
200:             for cell in frontier - set(shape):
201:                 next_shapes.add(_gen_normalize_shape(set(shape) | {cell}))
202:         shapes = next_shapes
203: 
204:     max_h, max_w = _GEN_SKELETON_BBOX_MAX
205:     pool = []
206:     for shape in shapes:
207:         rows = [r for r, _c in shape]
208:         cols = [c for _r, c in shape]
209:         h = max(rows) - min(rows) + 1
210:         w = max(cols) - min(cols) + 1
211:         if h <= max_h and w <= max_w:
212:             pool.append(tuple(sorted(shape)))
213: 
214:     _GEN_SKELETON_CACHE[size] = pool
215:     return pool
