+    dr = int(r) - int(origin_r)
+    dc = int(c) - int(origin_c)
+    if abs(dr) == abs(dc):
+        return "ray"
+    if abs(dr) > abs(dc):
+        return "up" if dr < 0 else "down"
+    return "left" if dc < 0 else "right"
+
