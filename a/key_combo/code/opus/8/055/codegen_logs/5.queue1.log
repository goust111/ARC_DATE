    n_cells = random.choice(GROUP_CELL_CHOICES)
    options = []
    for width in GROUP_WIDTH_CHOICES:
        for right_row in range(GEN_HEIGHT):
            for path in _gen_paths(width, n_cells, left_row, right_row):
