+                ways[node] = 1
+                q.append(node)
+            elif dist[node] == 1:
+                ways[node] = min(limit, ways[node] + 1)
+
+    best_target_dist: int | None = None
+    while q:
+        node = q.popleft()
+        cur_dist = dist[node]
