+        return False
+    occupied = {(top + int(r), left + int(c)) for r, c in coords}
+    for r, c in occupied:
+        if int(grid[r, c]) != BG:
+            return False
+        if require_clear_8:
+            for nr, nc in _neighbors8(r, c):
