+
+
+def _validate_input_structure(grid: np.ndarray) -> None:
+    assert grid.ndim == 2
+    assert max(grid.shape) <= 30
+    yellows = np.argwhere(grid == YELLOW)
+    assert 1 <= len(yellows) <= 2
