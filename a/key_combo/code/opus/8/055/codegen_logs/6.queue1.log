+    dist: dict[tuple[int, int], int] = {}
+    ways: dict[tuple[int, int], int] = {}
+    q = deque()
+
+    for sr, sc in [tuple(map(int, xy)) for xy in comp_a]:
+        for dr, dc in MOVE_ORDER:
+            nr, nc = sr + dr, sc + dc
+            node = (nr, nc)
+            if not _in_bounds(canvas.shape, nr, nc):
+                continue
