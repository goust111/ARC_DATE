+
+def _layout_rows(h: int, n_colors: int, upper_half: bool, center_r: int) -> list[int] | None:
+    if upper_half:
+        pool = [r for r in range(2, center_r - 1)]
+        if len(pool) < n_colors:
+            return None
+        base = sorted(random.sample(pool, n_colors))
+        return base
