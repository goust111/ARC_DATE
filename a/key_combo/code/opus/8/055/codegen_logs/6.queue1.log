+        path_cells, dist, key = _best_path(canvas, comps[0], comps[1])
+        shortest_path_count = _count_shortest_paths(canvas, comps[0], comps[1], limit=2)
+        for r, c in path_cells:
+            assert int(out[r, c]) == BG
