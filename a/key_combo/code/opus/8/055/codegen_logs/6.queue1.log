+        frontier = []
+        for r, c in cells:
+            for dr, dc in MOVE_ORDER:
+                nxt = (r + dr, c + dc)
+                if nxt not in cells:
+                    frontier.append(nxt)
+        cells.add(random.choice(frontier))
