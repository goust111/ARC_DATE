+        left_top = max(1, min(h - lh - 1, rows[idx] - lh // 2 + random.choice([-1, 0, 0, 1])))
+        right_top = max(1, min(h - rh - 1, rows[idx] - rh // 2 + random.choice([-1, 0, 0, 1])))
