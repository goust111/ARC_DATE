+def _source_colors(grid: np.ndarray) -> list[int]:
+    return [
+        color
+        for color in sorted(set(map(int, grid.ravel())))
+        if color not in (BG, YELLOW, TEAL)
+    ]
+
+
+def _order_colors(grid: np.ndarray) -> list[tuple[int, int, list[np.ndarray]]]:
