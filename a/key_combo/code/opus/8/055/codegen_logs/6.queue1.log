+from __future__ import annotations
+
+from collections import deque
+import heapq
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+TEAL = 8
+CONNECT_COLORS = [1, 2, 3, 5, 6, 7, 9]
+MOVE_ORDER = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # horizontal first, then up, then down
