+            node = (nr, nc)
+            if not _in_bounds(canvas.shape, nr, nc):
+                continue
+            if not _allowed_step(canvas, target, nr, nc):
+                continue
+            if node not in dist:
+                dist[node] = 1
+                ways[node] = 1
+                q.append(node)
+            elif dist[node] == 1:
+                ways[node] = min(limit, ways[node] + 1)
+
+    best_target_dist: int | None = None
+    while q:
+        node = q.popleft()
+        cur_dist = dist[node]
