+            if _semantic_ok(grid2, require_blocked=True):
+                return grid2
+            placed = True
+        if placed:
+            return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        if random.random() < 0.45:
+            grid = _blocked_pair_scene()
+        else:
+            grid = _random_open_scene()
+        if grid is not None:
