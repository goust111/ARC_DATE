+            s["c0"] = random.randint(min_c0, max_c0)
+            s["r0"] = random.randint(min_r0, max_r0)
+            blocker_r = s["r0"] - 1 - block_step
+            blocker_c = s["c0"] - 1 - block_step
+            t["c0"] = blocker_c - t["inner_w"] - 1
+            t["r0"] = blocker_r - t["inner_h"]
