 108: def neighbors4(r: int, c: int) -> Iterator[Coord]:
 109:     """4-neighborhood of (r,c)."""
 110:     r = int(r)
 111:     c = int(c)
 112:     yield r - 1, c
 113:     yield r + 1, c
 114:     yield r, c - 1
 115:     yield r, c + 1
 116: 
 117: 
 118: def neighbors8(r: int, c: int) -> Iterator[Coord]:
 119:     """8-neighborhood of (r,c)."""
 120:     r = int(r)
 121:     c = int(c)
 122:     for dr in (-1, 0, 1):
 123:         for dc in (-1, 0, 1):
 124:             if dr == 0 and dc == 0:
 125:                 continue
 126:             yield r + dr, c + dc
