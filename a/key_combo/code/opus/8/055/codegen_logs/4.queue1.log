  61:         marker_mask = patch != int(base)
  62:         has_marker = has_marker or bool(marker_mask.any())
  63:         rows, cols = np.where(marker_mask)
  64:         for r, c in zip(rows, cols):
  65:             value = int(patch[int(r), int(c)])
  66:             assert int(out[int(r), int(c)]) in {int(base), value}
  67:             out[int(r), int(c)] = value
  68: 
