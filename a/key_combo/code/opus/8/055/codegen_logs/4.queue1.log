   9: # description:
  10: # In the input you will see several blue "cups", meaning an almost-enclosed shape with a small opening at the top, and empty space (black pixels) inside, as well as a single colored pixel inside.
  11: # To make the output grid, you should fill the interior of each cup with the same color as the colored pixel inside it. 
  12: # Also, put a single layer of colored pixels above the cup with the same color as what's inside.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Fill each blue cup with its internal marker color and add a matching cap layer above it.
  17: 
  18:     Input structure:
  19:     - The grid contains one or more blue cup-shaped outlines on a black background.
  20:     - Each cup has a black interior with exactly one non-blue colored marker inside.
  21:     - The cup bounding box defines the interior area to fill.
  22: 
  23:     Rule:
  24:     - Detect each blue cup object.
  25:     - Find the unique non-black, non-blue color inside its bounding box.
  26:     - Fill the cup interior with that color and paint one matching row above the cup.
  27: 
  28:     Key insight:
  29:     - The marker pixel supplies the fill color, while the blue outline supplies the geometry
  30:       for both the interior and the added top layer.
  31:     """
  32:     # Plan:
  33:     # 1. Detect all the blue cups
  34:     # 2. For each cup, find the mask of what is inside of it
  35:     # 3. Find the color of the single pixel inside the cup
  36:     # 4. Fill the cup with the color
  37:     # 5. Put a single layer of colored pixels above the cup with the same color as what's inside
  38:     
  39:     # Detect all the blue cups
  40:     blue_cups = detect_objects(grid=input_grid, colors=[Color.BLUE], monochromatic=True, connectivity=4, background=Color.BLACK)
  41: 
  42:     output_grid = input_grid.copy()
  43: 
  44:     # For each cup object...
  45:     for obj in blue_cups:
  46:         # Extract what's inside the cup (as its own object), which is everything in the bounding box that is not the object itself
  47:         b = bbox(obj != Color.BLACK)
  48:         assert b is not None
  49:         r0, c0, r1, c1 = b
  50:         inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
  51:         inside_cup_mask[r0 : r1 + 1, c0 : c1 + 1] = True
  52:         inside_cup_mask = inside_cup_mask & (obj != Color.BLUE)
  53:         object_inside_cup = np.where(inside_cup_mask, input_grid, Color.BLACK)
  54: 
  55:         # Find the color of the single pixel inside the cup
  56:         colors = set(map(int, np.unique(object_inside_cup))) - {Color.BLACK, Color.BLUE}
  57:         assert len(colors) == 1, "There should be exactly one color inside the cup"
  58:         color = next(iter(colors))
  59: 
  60:         # Fill the cup with the color
  61:         output_grid[inside_cup_mask] = color
  62: 
  63:         # Put a single layer of colored pixels above the cup with the same color as what's inside
  64:         top_r = r0 - 1
  65:         if top_r >= 0:
  66:             output_grid[top_r, c0 : c1 + 1] = color
  67: 
