 107:         for r in range(INTERIOR_MARGIN, side - INTERIOR_MARGIN)
 108:         for c in range(INTERIOR_MARGIN, side - INTERIOR_MARGIN)
 109:         if (r, c) not in taken
 110:     ]
 111:     return [
 112:         combo
 113:         for combo in itertools.combinations(interior, size)
