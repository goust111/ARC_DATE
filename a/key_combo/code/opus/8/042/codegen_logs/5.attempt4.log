+def _random_square_components(square: tuple[int, int]) -> list[dict]:
+    for _ in range(80):
+        side_count = random.choice((1, 2, 2, 3))
+        sides = random.sample(SIDES, side_count)
+        colors = random.sample(PALETTE, side_count)
+        multi_side = None
+        if random.random() < 0.65:
