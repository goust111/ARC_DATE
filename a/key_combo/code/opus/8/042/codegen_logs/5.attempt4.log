+def _find_grey_squares(grid: np.ndarray) -> list[dict]:
+    squares: list[dict] = []
+    for coords in _components_of_mask(grid == GREY):
+        r0, c0, r1, c1 = _bbox(coords)
+        if len(coords) != 9 or r1 - r0 != 2 or c1 - c0 != 2:
+            continue
+        if np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == GREY):
+            squares.append(
