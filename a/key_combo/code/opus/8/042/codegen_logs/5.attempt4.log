        b = bbox(obj != Color.BLACK)
        if b is None:
            continue
        r0, c0, _r1, _c1 = b
        length = bbox_h(b)
        width = bbox_w(b)
        # Find out the single isolated red object with size of 1x1 and change it to blue.
        if length == 1 and width == 1:
            output_grid[r0, c0] = Color.BLUE

    return output_grid

def generate_input():
