+def _colorize_mask(mask: np.ndarray, palette: list[int], counts: list[int]) -> np.ndarray:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    color_list = []
+    for color, count in zip(palette, counts):
