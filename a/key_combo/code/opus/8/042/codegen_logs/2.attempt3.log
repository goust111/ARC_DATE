def _can_cover_pocket(
    shape: np.ndarray,
    pocket: np.ndarray,
    blue_cells: set[tuple[int, int]],
    grid_shape: tuple[int, int],
) -> bool:
    pocket_cells = {tuple(map(int, rc)) for rc in pocket}
    H, W = grid_shape

