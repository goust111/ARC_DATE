+    return None
+
+
+def _random_color_counts(area: int, num_colors: int) -> list[int]:
+    cuts = sorted(random.sample(range(1, area), num_colors - 1))
+    parts = []
+    prev = 0
+    for cut in cuts + [area]:
+        parts.append(cut - prev)
+        prev = cut
+    random.shuffle(parts)
+    return parts
+
