        for nc in range(c + step, tc + step, step):
            cells.append((r, nc))
        step = 1 if tr >= r else -1
        for nr in range(r + step, tr + step, step):
            cells.append((nr, tc))
    return cells


def _make_sprite(color: int, h: int, w: int, anchor: tuple[int, int]) -> np.ndarray | None:
    for _ in range(60):
