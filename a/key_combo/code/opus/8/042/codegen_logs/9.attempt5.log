+
+
+def _can_place(occupied: np.ndarray, sprite: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = occupied.shape
+    for sr, sc in np.argwhere(sprite != BLACK):
+        tr = r0 + int(sr)
+        tc = c0 + int(sc)
