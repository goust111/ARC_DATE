+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+SPRITE_COLORS = (BLUE, RED, GREEN, YELLOW)
+ORTHO_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+ALL_DIRS = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
