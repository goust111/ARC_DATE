+def _path_between(a: tuple[int, int], b: tuple[int, int], row_first: bool) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    cells = [(r, c)]
+    if row_first:
+        step = 1 if tr >= r else -1
+        for nr in range(r + step, tr + step, step):
+            cells.append((nr, c))
+        step = 1 if tc >= c else -1
+        for nc in range(c + step, tc + step, step):
+            cells.append((tr, nc))
+    else:
+        step = 1 if tc >= c else -1
+        for nc in range(c + step, tc + step, step):
+            cells.append((r, nc))
+        step = 1 if tr >= r else -1
+        for nr in range(r + step, tr + step, step):
+            cells.append((nr, tc))
+    return cells
+
