+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors(r: int, c: int, h: int, w: int, connectivity: int) -> list[tuple[int, int]]:
+    dirs = ORTHO_DIRS if connectivity == 4 else ALL_DIRS
+    out = []
+    for dr, dc in dirs:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        coords: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            coords.append((cr, cc))
+            for nr, nc in _neighbors(cr, cc, h, w, connectivity):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
