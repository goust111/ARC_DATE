+
+
+def _place_upper_sprites(sprites: list[np.ndarray], top_h: int, width: int) -> list[tuple[int, int]] | None:
+    for _ in range(250):
+        occupied = np.zeros((top_h, width), dtype=bool)
+        placements: list[tuple[int, int] | None] = [None] * len(sprites)
+        ok = True
