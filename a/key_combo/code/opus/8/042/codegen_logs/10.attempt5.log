def valid_cells(H,W,seg,line):
    pts=[]
    lineset=set(line)
    for r in range(H):
        for c in range(W):
            if (r,c) in seg: continue
            if any(max(abs(r-sr),abs(c-sc))<=1 for sr,sc in seg):
                continue
            block={(2*r+dr,2*c+dc) for dr in (0,1) for dc in (0,1)}
            if block & lineset:
                continue
            pts.append((r,c))
    return pts

def max_independent(cells):
    best=0
    for k in range(1,4):
