from itertools import product, combinations

def segs(H,W,L):
    out=[]
    for r_top in range(H):
        for c_top in range(W):
            seg=[(r_top+k,c_top-k) for k in range(L)]
            if any(not (0<=r<H and 0<=c<W) for r,c in seg):
                continue
