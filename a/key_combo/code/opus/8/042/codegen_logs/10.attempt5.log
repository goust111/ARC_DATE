        for comb in combinations(cells,k):
            if all(max(abs(a[0]-b[0]),abs(a[1]-b[1]))>1 for i,a in enumerate(comb) for b in comb[i+1:]):
                best=max(best,k)
                ok=True
        if not ok and k>best:
            pass
    return best

