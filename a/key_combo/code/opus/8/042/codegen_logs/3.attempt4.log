+            "tr": min(mt, mr),
+            "bl": min(mb, ml),
+            "br": min(mb, mr),
+        }
+        active_names = [name for flag, name in zip(signature, ("tl", "tr", "bl", "br")) if flag]
+        active_names.sort(key=lambda name: (frame_corners[name][0], frame_corners[name][1]))
