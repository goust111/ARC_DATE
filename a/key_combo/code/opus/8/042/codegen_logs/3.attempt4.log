+def _active_rays(grid: np.ndarray) -> tuple[list[Ray], list[dict[str, int]]]:
+    divider_col = _find_divider_col(grid)
+    bars = _extract_bars(grid, divider_col)
+    solid_box, frame_box, corners = _parse_geometry(grid)
