+def _build_signature_table() -> dict[tuple[bool, bool, bool, bool], list[tuple[int, int, int, int]]]:
+    table: dict[tuple[bool, bool, bool, bool], list[tuple[int, int, int, int]]] = {}
+    for gt in range(1, 6):
