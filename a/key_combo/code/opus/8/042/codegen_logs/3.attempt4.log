    out[r0 + sr0 : r0 + sr1 + 1, c0 + sc0 : c0 + sc1 + 1] = solid_color

    trail_cells = _gen_paint_trails(out, n, r0, c0, active, solid_color)

    inp = out.copy()
    for r, c in trail_cells:
