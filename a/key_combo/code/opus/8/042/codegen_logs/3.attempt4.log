+def _first_non_bg_non_solid(grid: np.ndarray, start: tuple[int, int], direction: tuple[int, int]) -> tuple[int, int] | None:
+    r, c = start
+    dr, dc = direction
+    r += dr
+    c += dc
+    while _in_bounds(grid.shape, r, c):
+        value = int(grid[r, c])
+        if value not in (BG, SOLID):
+            return (r, c)
+        r += dr
+        c += dc
+    return None
