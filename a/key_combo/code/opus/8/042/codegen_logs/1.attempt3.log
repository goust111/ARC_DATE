+
+def _neighbors4(shape: tuple[int, int], r: int, c: int):
+    h, w = shape
+    for dr, dc in DIRS4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _red_neighbor_count(grid: np.ndarray, r: int, c: int) -> int:
+    return sum(int(grid[rr, cc] == RED) for rr, cc in _neighbors4(grid.shape, r, c))
