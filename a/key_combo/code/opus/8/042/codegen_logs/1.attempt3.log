+def _filter_unsupported(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    red_coords = np.argwhere(out == RED)
+    for r0, c0 in red_coords:
+        r, c = int(r0), int(c0)
+        if _red_neighbor_count(grid, r, c) < 2:
+            out[r, c] = BLACK
+    return out
