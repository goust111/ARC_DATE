GEN_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]

# Marker center sampling bounds and required diagonal separation.
GEN_TOP_ROWS, GEN_BOT_ROWS = (2, 5), (9, 12)
GEN_LEFT_COLS, GEN_RIGHT_COLS = (2, 5), (9, 12)
GEN_MIN_SEP = 5

