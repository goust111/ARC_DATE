+
+        rows = {r for r, _c in cells}
+        cols = {c for _r, c in cells}
+        if area >= 4 and (len(rows) == 1 or len(cols) == 1):
+            continue
+
+        mask = np.zeros((block_size, block_size), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        return mask
+    return None
+
