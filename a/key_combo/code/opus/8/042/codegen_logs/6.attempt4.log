+    ranked = sorted(records, reverse=True)
+    n = len(ranked)
+    side = 2 * n - 1
+    out = np.zeros((side, side), dtype=int)
+    for inset, (_area, color) in enumerate(ranked):
+        lo = inset
+        hi = side - inset - 1
+        out[lo, lo : hi + 1] = color
+        out[hi, lo : hi + 1] = color
+        out[lo : hi + 1, lo] = color
+        out[lo : hi + 1, hi] = color
+    return out
