+            r += 1
+            c += 1
+        length = len(diag)
+        assert 2 <= length <= 3, f"diagonal length out of range: {length}"
+
+        end_r, end_c = diag[-1]
+        multiplier = 0
+        cc = end_c + 1
+        while (end_r, cc) in coords:
