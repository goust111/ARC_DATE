+def _parse_reference_objects(grid: np.ndarray, divider: int) -> list[dict]:
+    left = grid[:, :divider]
+    comps = find_components(
+        left,
+        bg=BG,
+        connectivity=8,
+        monochromatic=True,
+        colors=SOURCE_COLORS,
+        return_format="dict",
+    )
+    assert 2 <= len(comps) <= 4, f"expected 2-4 reference objects, got {len(comps)}"
+
+    objects = []
+    seen_multipliers = set()
+    seen_colors = set()
