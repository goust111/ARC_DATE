    out[0, :] = frame_color
    out[-1, :] = frame_color
    out[:, divider] = frame_color
    out[1 : total_h - 1, 1:divider] = left_bg
    out[1 : total_h - 1, divider + 1 : total_w - 1] = right_bg
    left_start = LEFT_ACTIVE_START
