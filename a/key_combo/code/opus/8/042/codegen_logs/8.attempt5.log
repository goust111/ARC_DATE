    """Build one structural config, rejecting overlaps, contacts, and run-count mismatches."""
    run_count = sum(int(segment["run_count"]) for segment in segments)
    if not _GEN_MIN_RUN_COUNT <= run_count <= _GEN_MAX_RUN_COUNT:
