  colors: 5 distinct -- bg (most frequent), sep_color (fills separator row), top_marker, source, trail; top_marker not in {source, trail}; colors={7,9,5,2,6} [observed]
  separator: solid row of sep_color spanning full width at row sep
  top_half:
    content: K pixels of top_marker color on bg; these mirror the source positions across separator
  bottom_half:
    sources: K pixels of source_color; their reflection (2*sep - r, c) equals the top marker set
    trails: straight 4-connected paths of trail_color, one per source; each trail is adjacent to its source and extends in one cardinal direction (no turns)
    trail_length: 1-4 pixels per trail [observed]
    constraints: trails do not touch each other; endpoints are all distinct; all trail pixels are accounted for by exactly one source
  num_sources: 2-5
