+    for idx, comp in enumerate(comps):
+        for cell in comp["coords"]:
+            cell_to_comp[cell] = idx
+    attached = set()
+    for coords in paths:
+        ordered = order_path([tuple(map(int, p)) for p in coords])
+        assert len(ordered) >= 3
+        end_ids = []
+        for endpoint in (ordered[0], ordered[-1]):
+            nbrs = {
