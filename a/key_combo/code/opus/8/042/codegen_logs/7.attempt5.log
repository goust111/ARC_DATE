+    if min_side > max_side:
+        return None
+
+    for _ in range(80):
+        h = random.randint(min_side, max_side)
+        w = random.randint(min_side, max_side)
+        canvas_in = np.zeros((h, w), dtype=int)
+        canvas_out = np.zeros((h, w), dtype=int)
+        order = list(range(scene_count))
