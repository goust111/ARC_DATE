+    if r0 < 0 or c0 < 0 or r0 + h > canvas.shape[0] or c0 + w > canvas.shape[1]:
+        return False
+    occ = patch != BLACK
+    for dr, dc in np.argwhere(occ):
+        rr = r0 + int(dr)
+        cc = c0 + int(dc)
+        r1 = max(0, rr - padding)
+        r2 = min(canvas.shape[0], rr + padding + 1)
+        c1 = max(0, cc - padding)
+        c2 = min(canvas.shape[1], cc + padding + 1)
