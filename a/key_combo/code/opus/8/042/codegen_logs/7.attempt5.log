+    roll = random.random()
+    if roll < 0.30:
+        return ["equal", random.choice(["a_smaller", "b_smaller"])], True
+    if roll < 0.55:
+        return ["equal", random.choice(["a_smaller", "b_smaller"])], False
+    if roll < 0.78:
+        return [random.choice(["a_smaller", "b_smaller"]), random.choice(["a_smaller", "b_smaller"])], True
+    if roll < 0.92:
