+            cc = c - min_c
+            assert grid[rr, cc] == BLACK
+            grid[rr, cc] = comp["color"]
+    if path is not None:
+        for r, c in path:
+            rr = r - min_r
+            cc = c - min_c
+            assert grid[rr, cc] == BLACK
+            grid[rr, cc] = GREY
