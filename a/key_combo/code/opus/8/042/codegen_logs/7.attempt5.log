+def absolute_coords(component: dict, anchor_abs: tuple[int, int]) -> list[tuple[int, int]]:
+    ar, ac = component["anchor"]
+    rr, cc = anchor_abs
+    return [(r - ar + rr, c - ac + cc) for r, c in component["coords"]]
