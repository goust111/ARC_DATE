+    if path is not None:
+        all_cells.extend(path)
+    min_r = min(r for r, _ in all_cells) - margin
+    max_r = max(r for r, _ in all_cells) + margin
+    min_c = min(c for _, c in all_cells) - margin
+    max_c = max(c for _, c in all_cells) + margin
