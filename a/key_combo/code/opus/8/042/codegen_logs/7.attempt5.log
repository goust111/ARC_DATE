+                shift_coords(comp_b["coords"], dest_b[0] - anchor_b[0], dest_b[1] - anchor_b[1]),
+                comp_b["color"],
+            )
+        elif comp_a["area"] < comp_b["area"]:
+            dest_a = path[-1]
+            render[cid_a] = (
+                shift_coords(comp_a["coords"], dest_a[0] - anchor_a[0], dest_a[1] - anchor_a[1]),
+                comp_b["color"],
+            )
+        else:
+            dest_b = path[0]
+            render[cid_b] = (
+                shift_coords(comp_b["coords"], dest_b[0] - anchor_b[0], dest_b[1] - anchor_b[1]),
+                comp_a["color"],
