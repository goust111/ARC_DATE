+        cc = c0 + int(dc)
+        r1 = max(0, rr - padding)
+        r2 = min(canvas.shape[0], rr + padding + 1)
+        c1 = max(0, cc - padding)
+        c2 = min(canvas.shape[1], cc + padding + 1)
