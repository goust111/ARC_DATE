        return False

    top_sets, bottom_sets = random.choice(splits)
    planned = [("top", start, end) for start, end in random.choice(top_sets)]
    planned += [("bottom", start, end) for start, end in random.choice(bottom_sets)]
    random.shuffle(planned)

