+
+    for path in paths:
+        assert len(path) >= 3, "path length must be at least 3"
+        end_a = path[0]
+        end_b = path[-1]
+
+        touch_a = {
+            comp_id_by_cell[(nr, nc)]
+            for nr, nc in neighbors4(*end_a)
+            if (nr, nc) in comp_id_by_cell
+        }
+        touch_b = {
+            comp_id_by_cell[(nr, nc)]
+            for nr, nc in neighbors4(*end_b)
+            if (nr, nc) in comp_id_by_cell
