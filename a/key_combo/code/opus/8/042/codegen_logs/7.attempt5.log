+                for nr, nc in neighbors4(*endpoint)
+                if (nr, nc) in cell_to_comp
+            }
+            assert len(nbrs) == 1
+            cid = next(iter(nbrs))
+            assert cid not in attached
+            attached.add(cid)
+            end_ids.append(cid)
+        assert end_ids[0] != end_ids[1]
+        for mid in ordered[1:-1]:
+            assert not any((nr, nc) in cell_to_comp for nr, nc in neighbors4(*mid))
