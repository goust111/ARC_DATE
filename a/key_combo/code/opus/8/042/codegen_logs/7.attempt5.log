+            paste_patch(canvas_out, patch_out, r0, c0)
+        if not placed:
+            continue
+        try:
+            validate_generated_input(canvas_in)
+            actual = main(canvas_in)
+        except Exception:
+            continue
+        if np.array_equal(actual, canvas_out):
+            return canvas_in
