+    h, w = mask.shape
+    H, W = shape
+    support_coords = np.argwhere(anchor_mask if support_mask is None else support_mask)
+    anchor_center = support_coords.mean(axis=0) if support_coords.size else np.array([H / 2, W / 2], dtype=float)
