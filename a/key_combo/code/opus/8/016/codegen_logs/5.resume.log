+        cc0 = max(0, int(c0))
+        rr1 = min(dst.shape[0], int(r0) + h)
+        cc1 = min(dst.shape[1], int(c0) + w)
+        if rr0 >= rr1 or cc0 >= cc1:
+            return dst
+        pr0 = rr0 - int(r0)
