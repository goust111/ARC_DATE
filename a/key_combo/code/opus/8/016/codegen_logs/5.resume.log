+    for r0 in range(H - h + 1):
+        for c0 in range(W - w + 1):
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(H, r0 + h + 1)
+            cc1 = min(W, c0 + w + 1)
