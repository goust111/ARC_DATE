+    chain_base = max(distance_sets[0][0], distance_sets[1][0]) + 1
+    for idx in range(2, len(plans)):
+        options = list(range(chain_base, min(max(shape), chain_base + 3)))
+        random.shuffle(options)
+        distance_sets[idx] = options
