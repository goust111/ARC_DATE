+    assert anchor is not None, "expected one teal 2x2 anchor"
+    assert 3 <= len(fragments) <= 4, "expected 3-4 fragments"
+    assert len({frag["angle"] for frag in fragments}) == len(fragments), "fragment rotations must be distinct"
