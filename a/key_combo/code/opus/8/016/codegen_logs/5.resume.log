+    H, W = shape
+    for _ in range(80):
+        r0 = random.randint(0, H - h)
+        c0 = random.randint(0, W - w)
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(H, r0 + h + 1)
+        cc1 = min(W, c0 + w + 1)
+        if not blocked[rr0:rr1, cc0:cc1].any():
