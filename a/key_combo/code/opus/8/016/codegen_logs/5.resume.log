+    reserved = np.zeros(shape, dtype=bool)
+    order = sorted(range(len(plans)), key=lambda idx: -max(distance_sets[idx]))
+
+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        plan = plans[idx]
+        for dist in distance_sets[idx]:
