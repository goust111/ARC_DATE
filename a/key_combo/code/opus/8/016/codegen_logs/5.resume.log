+def _render_scene(shape: tuple[int, int], template_patch: np.ndarray, template_top: tuple[int, int], plans: list[dict], anchor_top: tuple[int, int], use_initial: bool) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
