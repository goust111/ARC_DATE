+            prev_coords = _coords_from_mask(mask, prev_top)
+            if not _all_in_bounds(prev_coords, shape):
+                continue
+            if _overlaps(prev_coords, occupied):
+                continue
+            if _touches(prev_coords, occupied):
+                continue
