    anchor_top = (random.randint(7, H - 9), random.randint(7, W - 9))
    anchor_mask = np.zeros(shape, dtype=bool)
    anchor_mask[anchor_top[0]:anchor_top[0]+2, anchor_top[1]:anchor_top[1]+2] = True
    support_specs = [('anchor', None), ('anchor', None)]
    if n_fragments == 3:
        support_specs.append(('piece', random.choice([0, 1])))
    else:
        support_specs.extend([('piece', 0), ('piece', 1)])

    plans = []
    occupied_final = anchor_mask.copy()
    final_piece_masks = []
    failed = None
    for angle, color, (support_kind, support_idx) in zip(angles, fragment_colors, support_specs):
        frag_mask = mod._rotate_cw(mask, angle)
        patch = mod._mask_to_patch(frag_mask, color)
        if support_kind == 'anchor':
            support_mask = anchor_mask
            forbid_anchor_touch = False
        else:
            support_mask = final_piece_masks[int(support_idx)]
            forbid_anchor_touch = True
        candidates = mod._position_candidates(shape, frag_mask, mod.ANGLE_TO_DIR[angle], occupied_final, support_mask, anchor_mask, forbid_anchor_touch)
        if not candidates:
            failed = f'final_{support_kind}'
            break
        final_top = random.choice(candidates[: min(8, len(candidates))])
        coords = mod._coords_from_mask(frag_mask, final_top)
        piece_mask = np.zeros(shape, dtype=bool)
        mod._paint_bool(piece_mask, coords)
        final_piece_masks.append(piece_mask)
        mod._paint_bool(occupied_final, coords)
        plans.append({'mask': frag_mask, 'patch': patch, 'angle': int(angle), 'direction': mod.ANGLE_TO_DIR[angle], 'color': int(color), 'final_top': tuple(map(int, final_top)), 'initial_top': None, 'distance': None})
    if failed is None and not mod._choose_initial_positions(plans, shape, anchor_mask):
        failed = 'initial_positions'
    if failed is None:
        blocked_for_template = occupied_final.copy()
        for plan in plans:
            mod._paint_bool(blocked_for_template, mod._coords_from_mask(plan['mask'], plan['initial_top']))
            for coords in mod._path_positions(plan['mask'], plan['final_top'], plan['direction'], plan['distance']):
                mod._paint_bool(blocked_for_template, coords)
        template_top = mod._find_template_top(shape, template_patch, blocked_for_template)
        if template_top is None:
            failed = 'template_top'
    if failed is None:
        inp = mod._render_scene(shape, template_patch, template_top, plans, anchor_top, use_initial=True)
        expected = mod._render_scene(shape, template_patch, template_top, plans, anchor_top, use_initial=False)
        if np.array_equal(inp, expected):
            failed = 'same_io'
        elif not mod._validate_generated(inp, expected):
            failed = 'semantic_validate'
        elif not np.array_equal(mod.main(inp), expected):
            failed = 'main_mismatch'
    if failed is None:
        failed = 'success'
    counts[failed] = counts.get(failed, 0) + 1

print(counts)
