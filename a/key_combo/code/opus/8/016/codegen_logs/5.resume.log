+            {
+                "bbox": obj["bbox"],
+                "top": obj["top"],
+                "mask": obj["mask"],
+                "patch": _mask_to_patch(obj["mask"], color),
+                "color": color,
+                "angle": angle,
+                "direction": ANGLE_TO_DIR[angle],
+            }
+        )
