+from __future__ import annotations
+
+import random
+import sys
+from collections import Counter
+from typing import Iterable
+
+import numpy as np
+
+try:
+    _ARC_UTILS_DIR = "/home/lixinyu/snap/new/solvers"
+    if _ARC_UTILS_DIR not in sys.path:
