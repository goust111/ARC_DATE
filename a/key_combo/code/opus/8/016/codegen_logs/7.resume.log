+        return oc1 < cc0 and rr0 <= or0 <= rr1 and rr0 <= or1 <= rr1
+    if direction == "left":
+        return oc0 > cc1 and rr0 <= or0 <= rr1 and rr0 <= or1 <= rr1
+    if direction == "down":
+        return or1 < rr0 and cc0 <= oc0 <= cc1 and cc0 <= oc1 <= cc1
