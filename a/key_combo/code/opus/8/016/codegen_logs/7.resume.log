+                r_lo = PLACEMENT_MARGIN
+                r_hi = grid_h - rect_h - gap - obj_h - PLACEMENT_MARGIN
+                c_lo = PLACEMENT_MARGIN
+                c_hi = grid_w - rect_w - PLACEMENT_MARGIN
