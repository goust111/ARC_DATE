+def _shell_coords(r0: int, c0: int, h: int, w: int, depth: int) -> list[tuple[int, int]]:
+    rr0 = int(r0 + depth)
+    cc0 = int(c0 + depth)
+    rr1 = int(r0 + h - 1 - depth)
+    cc1 = int(c0 + w - 1 - depth)
+    coords: set[tuple[int, int]] = set()
+    for cc in range(cc0, cc1 + 1):
+        coords.add((rr0, cc))
+        coords.add((rr1, cc))
+    for rr in range(rr0, rr1 + 1):
