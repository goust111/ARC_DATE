+
+def _side_matches_direction(spec: dict) -> bool:
+    rr0, cc0, rr1, cc1 = spec["rect_bbox"]
+    or0, oc0, or1, oc1 = spec["object_bbox"]
+    direction = spec["direction"]
+    if direction == "right":
