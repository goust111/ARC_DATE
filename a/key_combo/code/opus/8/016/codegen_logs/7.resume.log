+        "direction": direction,
+        "rect_h": rect_h,
+        "rect_w": rect_w,
+        "rect_colors": colors,
+        "object_coords_local": object_coords,
+        "obj_h": obj_h,
+        "obj_w": obj_w,
+        "object_color": object_color,
+    }
+
+
+def _try_place_blueprints(grid_h: int, grid_w: int, blueprints: list[dict]) -> list[dict] | None:
