+def _normalize_coords(coords: np.ndarray) -> np.ndarray:
+    norm = np.array(coords, dtype=int)
+    norm[:, 0] -= norm[:, 0].min()
+    norm[:, 1] -= norm[:, 1].min()
+    order = np.lexsort((norm[:, 1], norm[:, 0]))
+    return norm[order]
