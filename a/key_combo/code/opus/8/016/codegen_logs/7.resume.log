+    mask[coords[:, 0], coords[:, 1]] = 1
+    if bool(_RNG.integers(2)):
+        mask = np.fliplr(mask)
+    mask = np.rot90(mask, k=int(_RNG.integers(4)))
+    return _normalize_coords(np.argwhere(mask == 1))
