+        {"cells": [(r0 - 1, c1), (r0 - 2, c1)], "count": 1},
+        {"cells": [(r0, c1 + 1), (r0, c1 + 2)], "count": 1},
+        {"cells": [(r1 + 1, c0), (r1 + 2, c0)], "count": 1},
+        {"cells": [(r1, c0 - 1), (r1, c0 - 2)], "count": 1},
