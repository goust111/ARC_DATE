+def _reflection_value(
+    g: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    r: int,
+    c: int,
+    axis: str,
+) -> int:
+    r0, c0, r1, c1 = map(int, bbox)
+    if axis == "horizontal":
+        rr, cc = r0 + r1 - int(r), int(c)
+    else:
+        rr, cc = int(r), c0 + c1 - int(c)
+    assert int(g[rr, cc]) != MARKER_COLOR
+    return int(g[rr, cc])
