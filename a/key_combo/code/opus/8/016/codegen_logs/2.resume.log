+def _marker_options(pattern_h: int, pattern_w: int, axis: str) -> list[tuple[int, int, int, int]]:
+    options = []
+    for mh, mw in MARKER_DIMS:
+        max_r = pattern_h // 2 - mh
+        max_c = pattern_w // 2 - mw
