+    mark_count = 0
+    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):
+        if _has_complete_square_border(g, obj):
+            for r, c in _corner_marker_coords(obj["bbox"]):
+                if in_bounds(g.shape, r, c) and int(g[r, c]) == bg:
+                    out[r, c] = Color.RED
+                    mark_count += 1
