+            )
+            patch = np.empty((h, w), dtype=int)
+            patch[: seed.shape[0], :] = seed
+            for r in range(seed.shape[0], h):
+                patch[r, :] = patch[h - 1 - r, :]
+        else:
+            seed = np.array(
+                [[random.choice(palette) for _ in range((w + 1) // 2)] for _ in range(h)],
+                dtype=int,
