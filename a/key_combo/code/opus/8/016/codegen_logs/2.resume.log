+def _mirror_patch(patch: np.ndarray, axis: str) -> np.ndarray:
+    h, w = map(int, patch.shape)
+    out = patch.copy()
+    if axis == "horizontal":
+        for r in range(h):
+            out[h - 1 - r, :] = out[r, :]
+    else:
+        for c in range(w):
+            out[:, w - 1 - c] = out[:, c]
+    return out
+
