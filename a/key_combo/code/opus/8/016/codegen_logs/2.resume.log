+                    vc = pattern_w - 1 - c
+                    if rr <= hr < rr + mh and cc <= c < cc + mw:
+                        ok = False
+                    if rr <= r < rr + mh and cc <= vc < cc + mw:
+                        ok = False
+                if ok:
+                    options.append((rr, cc, mh, mw))
+    return options
