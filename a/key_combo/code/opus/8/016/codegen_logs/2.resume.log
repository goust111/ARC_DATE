+        max_r = pattern_h // 2 - mh
+        max_c = pattern_w // 2 - mw
+        if max_r < 1 or max_c < 1:
+            continue
+        for rr in range(1, max_r + 1):
+            for cc in range(1, max_c + 1):
+                cells = [(rr + dr, cc + dc) for dr in range(mh) for dc in range(mw)]
+                ok = True
+                for r, c in cells:
