+    noisy_marker_total = random.randint(quiet_marker_total + 1, min(quiet_marker_total + 3, noisy_capacity))
+    noisy_specs = _build_panel_specs(
+        slot_h,
+        slot_w,
+        noisy_slots,
+        noisy_shape_map,
+        force_different_from=quiet_color_by_slot,
+        marker_total=noisy_marker_total,
