+    return specs
+
+
+def _marker_capacity(specs: list[dict]) -> int:
+    return sum(min(3, int(spec["mask"].sum()) - 1) for spec in specs)
+
+
+def _shape_map_for_slots(
+    chosen_slots: list[int],
+    slot_h: int,
+    slot_w: int,
+    preset: dict[int, dict] | None = None,
+) -> dict[int, dict]:
