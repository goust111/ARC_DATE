+    specs: list[dict] = []
+    maxima: list[int] = []
+    for idx, slot in enumerate(chosen_slots):
+        shape_spec = shared_shapes.get(int(slot), _new_shape_spec(slot_h, slot_w))
+        area = int(shape_spec["mask"].sum())
+        max_markers = min(3, area - 1)
