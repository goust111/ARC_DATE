+def _priority_variant(quiet: np.ndarray, noisy_processed: np.ndarray) -> np.ndarray:
+    out = noisy_processed.copy()
+    only_quiet = (out == BG) & (quiet != BG)
+    out[only_quiet] = quiet[only_quiet]
+    return out
