from __future__ import annotations
import numpy as np
from arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location
import random
from functools import lru_cache
from itertools import combinations

def main(grid: np.ndarray) -> np.ndarray:
    """
    Count colored objects and record tallies inside a legend box.

    Input structure:
    - A black rectangular legend box with key-color pixels in its leftmost non-black column.
    - Outside the box, distinct objects of each key color are scattered across the grid.

    Rule:
    - For each key color, count separate same-colored objects outside the legend box.
    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.

    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    _bg = int(get_bg(g))

    black = 0

    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.
    best = None  # (area, bbox)
    for coords in components_mask(g == int(black), connectivity=8):
        if coords.size == 0:
            continue
        b = bbox_coords(coords)
        sub = crop_bbox(g, b)
        if (sub != int(black)).any():
            area = int(coords.shape[0])
            cand = (area, tuple(map(int, b)))
            if best is None or cand[0] > best[0]:
                best = cand

    assert not (best is None)

    r0, c0, r1, c1 = map(int, best[1])
    box = crop_bbox(g, (r0, c0, r1, c1))
    bh, bw = map(int, box.shape)

    # STEP 2) Inside the legend bbox, find the key column:
    # leftmost column with any non-black pixels (the "key pixels").
    key_col = None
    for cc in range(bw):
        if (box[:, int(cc)] != int(black)).any():
            key_col = int(cc)
            break
    if key_col is None:
        return np.zeros_like(box)

    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]
    keys.sort(key=lambda t: int(t[0]))

    outside = np.ones((H, W), dtype=bool)
    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False
    out = np.zeros((bh, bw), dtype=int)

    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.
    for rr, col in keys:
        mask = (g == int(col)) & outside
        _labc, nc = label_mask(mask, connectivity=8)
        for i in range(int(nc)):
            cc = int(key_col + 2 * i)
            if 0 <= cc < bw:
                out[int(rr), int(cc)] = int(col)

    return out

# --------------- generator (o5x) ---------------

# Palette and legend color choices.
COLOR_POOL = tuple(range(1, 10))
BLACK = 0
DISTRACTOR_PROB = 0.5

# Key rows and tally dimensions.
KEY_COUNT_RANGE = (2, 4)
TARGET_COUNT_RANGE = (1, 5)
KEY_ROW_FIRST = 1
KEY_ROW_STEP = 2
KEY_COLUMN = 1
TALLY_COL_STEP = 2
LEGEND_HEIGHT_TAIL = 1
LEGEND_WIDTH_TAIL = 1
LEGEND_SLACK_RANGE = (0, 3)

# Canvas size and legend placement bounds.
GRID_HEIGHT_RANGE = (20, 25)
GRID_WIDTH_RANGE = (20, 25)
LEGEND_EDGE_MARGIN = 2

# Sprite shape and placement constraints.
SPRITE_AREA_RANGE = (4, 7)
SPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))
SPRITE_CONNECTIVITY = 8
SPRITE_PADDING = 1
SPRITE_PADDING_CONNECTIVITY = 8

# Retry budget for rejection sampling.
GENERATION_ATTEMPTS = 300


def _randint(bounds: tuple[int, int]) -> int:
    """Return an inclusive randint from a configured (low, high) pair."""
    return random.randint(bounds[0], bounds[1])


@lru_cache(maxsize=None)
def _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:
    """Return connected masks that span all four sides of the sprite bbox."""
    masks = []
    for cells in combinations(range(h * w), area):
        mask = np.zeros((h, w), dtype=bool)
        for cell in cells:
            mask[cell // w, cell % w] = True
        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()
        if not spans_edges:
            continue
        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)
        if n == 1:
            masks.append(mask)
    return tuple(masks)


def _make_sprite(color: int, bg: int) -> np.ndarray:
    """Sample one connected same-color sprite drawn on the background color."""
    area = _randint(SPRITE_AREA_RANGE)
    dims = []
    for h, w in SPRITE_BBOXES:
        if h * w >= area and _valid_masks(h, w, area):
            dims.append((h, w))
    h, w = random.choice(dims)
    mask = random.choice(_valid_masks(h, w, area))
    sprite = np.full((h, w), int(bg), dtype=int)
    sprite[mask] = int(color)
    return sprite


def _sample_palette() -> tuple[int, list[int], int | None]:
    """Choose background, key colors, and optional distractor color."""
    colors = list(COLOR_POOL)
    bg = random.choice(colors)

    k = _randint(KEY_COUNT_RANGE)
    remaining = [c for c in colors if c != bg]
    key_colors = random.sample(remaining, k)
    remaining = [c for c in remaining if c not in key_colors]
    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None
    return bg, key_colors, distractor_color


def _sample_counts(k: int) -> list[int]:
    """Sample the target outside-component count for each key color."""
    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]


def _legend_shape(k: int, max_count: int) -> tuple[int, int]:
    """Return legend height and width for the key count and largest tally."""
    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL
    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)
    return bh, bw


def _key_row(i: int) -> int:
    """Map a zero-based key index to its row inside the legend/output box."""
    return KEY_ROW_FIRST + KEY_ROW_STEP * i


def _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:
    """Render the black output tally canvas implied by key colors and counts."""
    max_count = max(counts)
    bh, bw = _legend_shape(len(key_colors), max_count)

    expected = np.full((bh, bw), BLACK, dtype=int)
    for i, (color, count) in enumerate(zip(key_colors, counts)):
        rr = _key_row(i)
        for j in range(count):
            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)
    return expected


def _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:
    """Return a black legend patch with only the key-column pixels filled."""
    legend = np.full(shape, BLACK, dtype=int)
    for i, color in enumerate(key_colors):
        legend[_key_row(i), KEY_COLUMN] = int(color)
    return legend


def _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:
    """Sample a grid and paste the legend away from all canvas edges."""
    bh, bw = map(int, legend.shape)
    H = _randint(GRID_HEIGHT_RANGE)
    W = _randint(GRID_WIDTH_RANGE)
    min_h = bh + 2 * LEGEND_EDGE_MARGIN
    min_w = bw + 2 * LEGEND_EDGE_MARGIN
    if H < min_h or W < min_w:
        return None

    grid = np.full((H, W), int(bg), dtype=int)
    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)
    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)
    paste(grid, legend, r0, c0)
    return grid


def _build_sprite_queue(
    key_colors: list[int],
    counts: list[int],
    distractor_color: int | None,
    bg: int,
) -> list[np.ndarray]:
    """Create canonical key sprites, optional distractor sprite, and shuffle them."""
    sprites = []
    for color, count in zip(key_colors, counts):
        sprite = _make_sprite(color, bg)
        for _ in range(count):
            sprites.append(sprite.copy())
    if distractor_color is not None:
        sprites.append(_make_sprite(distractor_color, bg))
    random.shuffle(sprites)
    return sprites


def _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:
    """Paste sprites into random non-touching free locations in queue order."""
    for sprite in sprites:
        sr, sc = random_free_location(
            grid,
            sprite,
            transparent=bg,
            padding=SPRITE_PADDING,
            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,
        )
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds
import random


def _has_complete_square_border(g: np.ndarray, obj: dict) -> bool:
    r0, c0, r1, c1 = obj["bbox"]
    h = bbox_h(obj["bbox"])
    w = bbox_w(obj["bbox"])
    if h != w or h < 2:
        return False

    color = int(obj["color"])
    return bool(
        np.all(g[r0, c0 : c1 + 1] == color)
        and np.all(g[r1, c0 : c1 + 1] == color)
        and np.all(g[r0 : r1 + 1, c0] == color)
        and np.all(g[r0 : r1 + 1, c1] == color)
    )


def _corner_marker_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    return [
        (r0 - 1, c0),
        (r0, c0 - 1),
        (r0 - 1, c1),
        (r0, c1 + 1),
        (r1 + 1, c0),
        (r1, c0 - 1),
        (r1 + 1, c1),
        (r1, c1 + 1),
    ]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Mark every complete square object with red pixels just outside its corners.

    Input structure:
    - A uniform background contains one or more monochrome 4-connected foreground objects.
    - The relevant objects are square frames or filled squares: their bbox is square
      and all cells on the bbox border have the object's color.
    - Non-square bars and incomplete fragments may also appear and are ignored.

    Rule:
    - Keep the input unchanged.
    - For each complete square object, paint red on the two outside background
      pixels orthogonally adjacent to each of the square's four corners.

    Key insight: The transformation is not based on size or color; it selects
    objects whose bounding box is a complete square border and labels only their
    exposed outer corner-adjacent cells.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    out = g.copy()

    square_objects = [
        obj
        for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True)
        if _has_complete_square_border(g, obj)
    ]
    assert square_objects, "expected at least one complete square object"

    for obj in square_objects:
        coords = _corner_marker_coords(obj["bbox"])
        for r, c in coords:
            assert in_bounds(g.shape, r, c), "square object should have one-cell outside margin"
            assert int(g[r, c]) == int(bg), "corner marker positions should be background"
            out[r, c] = Color.RED

    return out

# --------------- generator (c) ---------------

# ---- Configuration ----
GRID_H, GRID_W = 10, 10
BG_COLOR = Color.ORANGE                       # background color (7)
FG_COLORS = [Color.PINK, Color.TEAL]          # foreground color choices
SQUARE_COUNT_RANGE = [1, 2, 3, 4]             # number of squares to attempt
SQUARE_SIZE_MIN = 2                            # minimum square side length
MAX_SZ_BY_COUNT = {1: 8, 2: 6, 3: 5, 4: 4}   # max square size per count
EDGE_MARGIN = 1                                # min gap from grid edge for squares
DISTRACTOR_COUNT_MAX = 5                       # max distractor objects
DISTRACTOR_TYPES = ['pixel', 'hbar', 'vbar', 'rect']
DISTRACTOR_BAR_RANGE = (2, 4)                  # bar/rect dimension range
DISTRACTOR_PLACE_RETRIES = 80                  # retries per distractor placement
GEN_MAX_RETRIES = 300                          # outer generate_input retry limit


def _marker_coords(r0, c0, sz):
    """Return the 8 corner-adjacent cells outside a square at (r0,c0) with side `sz`."""
    r1, c1 = r0 + sz - 1, c0 + sz - 1
    return [
        (r0 - 1, c0), (r0, c0 - 1),
        (r0 - 1, c1), (r0, c1 + 1),
        (r1 + 1, c0), (r1, c0 - 1),
        (r1 + 1, c1), (r1, c1 + 1),
    ]


def _border_mask(r0, c0, sz, shape):
    """Return a boolean mask with True on the border cells of a square."""
    mask = np.zeros(shape, dtype=bool)
    r1, c1 = r0 + sz - 1, c0 + sz - 1
    mask[r0, c0:c1+1] = True
    mask[r1, c0:c1+1] = True
    mask[r0:r1+1, c0] = True
    mask[r0:r1+1, c1] = True
    return mask


def _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg):
    """Draw a square frame (or filled 2x2) onto the grid and update tracking masks."""
    r1, c1 = r0 + sz - 1, c0 + sz - 1
    if sz == 2:
        grid[r0:r1+1, c0:c1+1] = fg
    else:
        grid[r0, c0:c1+1] = fg
        grid[r1, c0:c1+1] = fg
        grid[r0:r1+1, c0] = fg
        grid[r0:r1+1, c1] = fg
    occupied |= _border_mask(r0, c0, sz, grid.shape)
    for mr, mc in _marker_coords(r0, c0, sz):
        marker_reserved[mr, mc] = True


def _distractor_dims(dtype):
    """Return (height, width) for a distractor of the given type."""
    lo, hi = DISTRACTOR_BAR_RANGE
    if dtype == 'pixel':
        return 1, 1
    elif dtype == 'hbar':
        return 1, random.randint(lo, hi)
    elif dtype == 'vbar':
        return random.randint(lo, hi), 1
    else:
        dh = random.randint(lo, hi)
        dw = random.randint(lo, hi)
        if dh == dw:
            dw = dh + 1 if dh < hi else dh - 1
        return dh, dw


def _gen_attempt() -> np.ndarray | None:
    fg = random.choice(FG_COLORS)
    grid = np.full((GRID_H, GRID_W), BG_COLOR, dtype=int)
    occupied = np.zeros((GRID_H, GRID_W), dtype=bool)
    marker_reserved = np.zeros((GRID_H, GRID_W), dtype=bool)

    num_squares = random.choice(SQUARE_COUNT_RANGE)
    max_sz = MAX_SZ_BY_COUNT[num_squares]
    sizes = sorted([random.randint(SQUARE_SIZE_MIN, max_sz)
                     for _ in range(num_squares)], reverse=True)

    placed_squares = []

    def can_place(r0, c0, sz):
        r1, c1 = r0 + sz - 1, c0 + sz - 1
        if r0 < EDGE_MARGIN or c0 < EDGE_MARGIN or r1 > GRID_H - EDGE_MARGIN - 1 or c1 > GRID_W - EDGE_MARGIN - 1:
            return False
        for mr, mc in _marker_coords(r0, c0, sz):
            if mr < 0 or mr >= GRID_H or mc < 0 or mc >= GRID_W:
                return False
            if occupied[mr, mc] or marker_reserved[mr, mc]:
                return False
        # Border cells must not overlap existing occupied cells
        if (np.any(occupied[r0, c0:c1+1]) or np.any(occupied[r1, c0:c1+1]) or
                np.any(occupied[r0:r1+1, c0]) or np.any(occupied[r0:r1+1, c1])):
            return False
        return True

    for sz in sizes:
        positions = [(r0, c0)
                     for r0 in range(EDGE_MARGIN, GRID_H - sz)
                     for c0 in range(EDGE_MARGIN, GRID_W - sz)
                     if can_place(r0, c0, sz)]
        if not positions:
            continue
        r0, c0 = random.choice(positions)
        _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg)
        placed_squares.append((r0, c0, sz))

    if not placed_squares:
        return None

    # Place distractors
    num_distractors = random.randint(0, DISTRACTOR_COUNT_MAX)
    for _ in range(num_distractors):
        dtype = random.choice(DISTRACTOR_TYPES)
        for _try in range(DISTRACTOR_PLACE_RETRIES):
            dh, dw = _distractor_dims(dtype)
            r0 = random.randint(0, GRID_H - dh)
            c0 = random.randint(0, GRID_W - dw)
            region = grid[r0:r0+dh, c0:c0+dw]
            reserved = marker_reserved[r0:r0+dh, c0:c0+dw]
            if np.all(region == BG_COLOR) and not np.any(reserved):
                grid[r0:r0+dh, c0:c0+dw] = fg
                occupied[r0:r0+dh, c0:c0+dw] = True
                break

    # Validate with solver
    try:
        out = main(grid)
    except Exception:
        return None

    expected = grid.copy()
    for r0, c0, sz in placed_squares:
        for mr, mc in _marker_coords(r0, c0, sz):
            expected[mr, mc] = Color.RED
    if not np.array_equal(out, expected):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate input after %d attempts" % GEN_MAX_RETRIES)
import numpy as np

from arc_utils import find_components, get_bg


def _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:
    height = g.shape[0]
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert len(components) >= 2

    bars: list[dict[str, int]] = []
    for comp in components:
        r0, c0, r1, c1 = map(int, comp["bbox"])
        color = int(comp["color"])
        area = int(comp["area"])

        assert c0 == c1
        assert r1 == height - 1
        assert area == r1 - r0 + 1
        assert bool(np.all(g[r0 : r1 + 1, c0] == color))

        bars.append({"color": color, "col": c0, "height": area})

    bars.sort(key=lambda bar: bar["col"])
    assert len({bar["col"] for bar in bars}) == len(bars)
    return bars


def main(grid: np.ndarray) -> np.ndarray:
    """Rotate each vertical bar's color one slot right and its height one slot left.

    Input structure
    - A dominant background surrounds several monochrome one-cell-wide vertical bars.
    - Every bar is bottom-aligned and occupies a distinct column.
    - The ordered bar slots are read from left to right.

    Rule
    - Keep the grid shape and the bar columns unchanged.
    - At slot i, use the color from the previous slot cyclically.
    - At slot i, use the height from the next slot cyclically.

    Key insight
    - Color and height are independent cyclic attributes of the ordered bar slots:
      colors rotate right while heights rotate left.
    """
    g = np.asarray(grid, dtype=int)
    height = g.shape[0]
    bg = get_bg(g)
    bars = _extract_bars(g, bg)

    out = np.full_like(g, bg)
    count = len(bars)
    for i, bar in enumerate(bars):
        color = bars[(i - 1) % count]["color"]
        bar_height = bars[(i + 1) % count]["height"]
        assert 1 <= bar_height <= height
        out[height - bar_height : height, bar["col"]] = color

    return out

# --------------- generator (o5x) ---------------

_RNG = np.random.default_rng()

# Canvas/bar bounds.
BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6
BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1
BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2
# Color and transform sampling.
COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]
OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1
# Retry limit.
MAX_GENERATION_ATTEMPTS = 300


def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)
    for i, (color, bar_height) in enumerate(zip(colors, heights)):
        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET
        grid[side - int(bar_height) : side, col] = int(color)
    return grid


def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)
    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)
    return _render_bars(n, out_colors, out_heights)


def _gen_attempt() -> np.ndarray | None:
    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))
    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)
    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)
    if len(set(map(int, heights))) == 1:
        idx = int(_RNG.integers(n))
        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]
        heights[idx] = int(_RNG.choice(choices))

    grid = _render_bars(n, colors, heights)
    if np.array_equal(main(grid), _expected_output(n, colors, heights)):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

