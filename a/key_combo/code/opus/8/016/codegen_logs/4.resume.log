+    H, W = g.shape
+    keys = []
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color == BG:
+                continue
+            if (r > 0 and int(g[r - 1, c]) != BG) or (r + 1 < H and int(g[r + 1, c]) != BG):
+                continue
+            if (c > 0 and int(g[r, c - 1]) != BG) or (c + 1 < W and int(g[r, c + 1]) != BG):
+                continue
+            keys.append((r, c, color))
+    return keys
