+    candidates = []
+    for col, items in by_col.items():
+        items = sorted(items)
+        if not (2 <= len(items) <= 3):
+            continue
+        rows = [r for r, _c, _color in items]
+        if len(set(color for _r, _c, color in items)) != len(items):
+            continue
