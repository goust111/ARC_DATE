import math

import numpy as np

from arc_utils import get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Move each vertical stream of pixels into a bottom-aligned centered pile.

    Input structure
    - A mostly background grid contains one or more vertical source columns of
      foreground pixels.
    - Each source column has n^2 foreground pixels, and the top-to-bottom color
      sequence splits into monochrome groups of lengths 1, 3, 5, ...

    Rule
    - Clear the canvas to background.
    - For each source column, read the foreground colors from top to bottom and
      rebuild them at the bottom below the same column as odd-width centered
      rows of lengths 1, 3, 5, ...

    Key insight
    - The scattered vertical pixels are falling grains; a square number of
      grains decomposes into the odd row widths of a centered pyramid.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape

    source_cols: list[tuple[int, list[int]]] = []
    for c in range(W):
        sequence = [int(g[r, c]) for r in range(H) if int(g[r, c]) != bg]
        if sequence:
            source_cols.append((c, sequence))

    assert source_cols

    out = np.full_like(g, bg)
    for center_c, sequence in source_cols:
        height = math.isqrt(len(sequence))
        assert height * height == len(sequence)
        assert height <= H

        idx = 0
        for layer_idx in range(height):
            width = 2 * layer_idx + 1
            layer = sequence[idx : idx + width]
            assert len(layer) == width
            assert len(set(layer)) == 1

            r = H - height + layer_idx
            c0 = center_c - layer_idx
            c1 = center_c + layer_idx
            assert 0 <= c0 <= c1 < W
            assert np.all(out[r, c0 : c1 + 1] == bg)

            out[r, c0 : c1 + 1] = layer[0]
            idx += width

        assert idx == len(sequence)

    return out

# --------------- generator (att1, Claude) ---------------

# Canvas and palette bounds.
GRID_HEIGHT_RANGE = (16, 30)
GRID_WIDTH_RANGE = (9, 13)
BACKGROUND_COLOR = 0
FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]

# Source-column, pyramid, placement, and retry choices.
SOURCE_COLUMN_COUNTS = [1, 2]
PYRAMID_HEIGHTS = [2, 3]
MIN_FOOTPRINT_GAP = 1
MAX_GENERATION_ATTEMPTS = 300


def _second_center_candidates(lo, hi, first_center, first_height, height):
    first_radius = first_height - 1
    radius = height - 1
    right_edge = first_center + first_radius
    left_edge = first_center - first_radius

    candidates = []
    right_lo = max(lo, right_edge + radius + MIN_FOOTPRINT_GAP)
    if right_lo <= hi:
        candidates.extend(range(right_lo, hi + 1))
    left_hi = min(hi, left_edge - radius - MIN_FOOTPRINT_GAP)
    if left_hi >= lo:
        candidates.extend(range(lo, left_hi + 1))
    return candidates


def _choose_centers(width, heights):
    """Pick source columns whose bottom pyramid footprints do not overlap."""
    centers = []
    for i, height in enumerate(heights):
        margin = height - 1
        lo, hi = margin, width - 1 - margin
        if lo > hi:
            return None
        if i == 0:
            centers.append(random.randint(lo, hi))
            continue

        candidates = _second_center_candidates(lo, hi, centers[0], heights[0], height)
        if not candidates:
            return None
        centers.append(random.choice(candidates))
    return centers


def _flatten_layers(colors):
    sequence = []
    for layer_idx, color in enumerate(colors):
        sequence.extend([color] * (2 * layer_idx + 1))
    return sequence


def _build_pyramid_data(centers, heights):
    """Return (center_col, height, flattened_layer_sequence) tuples."""
    pyramid_data = []
    for center, height in zip(centers, heights):
        colors = [random.choice(FOREGROUND_COLORS) for _ in range(height)]
        pyramid_data.append((center, height, _flatten_layers(colors)))
    return pyramid_data


def _draw_pyramids(shape, pyramid_data):
    """Render bottom-aligned output pyramids from flattened layer sequences."""
    H, W = shape
    out = np.full((H, W), BACKGROUND_COLOR, dtype=int)
    for center, height, sequence in pyramid_data:
        idx = 0
        for layer_idx in range(height):
            width = 2 * layer_idx + 1
            r = H - height + layer_idx
            c0 = center - layer_idx
            out[r, c0:c0 + width] = sequence[idx]
            idx += width
    return out


def _scatter_source_columns(shape, pyramid_data):
    """Scatter each flattened layer sequence above its pyramid top row."""
    H, W = shape
    inp = np.full((H, W), BACKGROUND_COLOR, dtype=int)
    for center, height, sequence in pyramid_data:
        top_pyramid_row = H - height
        num_pixels = height * height
        available_rows = list(range(top_pyramid_row))
        if len(available_rows) < num_pixels:
            return None
        chosen_rows = sorted(random.sample(available_rows, num_pixels))
        for row, color in zip(chosen_rows, sequence):
            inp[row, center] = color
    return inp


def _gen_attempt():
    """Generate a single input grid for the pyramid-scatter task."""
    H = random.randint(*GRID_HEIGHT_RANGE)
    W = random.randint(*GRID_WIDTH_RANGE)
    K = random.choice(SOURCE_COLUMN_COUNTS)
    heights = [random.choice(PYRAMID_HEIGHTS) for _ in range(K)]

    centers = _choose_centers(W, heights)
    if centers is None:
        return None

    pyramid_data = _build_pyramid_data(centers, heights)
    out = _draw_pyramids((H, W), pyramid_data)
    inp = _scatter_source_columns((H, W), pyramid_data)
    if inp is not None:
        try:
            if np.array_equal(main(inp), out):
                return inp
        except Exception:
            pass
    return None


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input in {MAX_GENERATION_ATTEMPTS} attempts")
from __future__ import annotations

from collections import deque

import numpy as np

from arc_utils import bbox


def _solid_rectangle_marker(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
    for color in np.unique(g):
        mask = g == int(color)
        b = bbox(mask)
        assert b is not None
        r0, c0, r1, c1 = b
        area = int((r1 - r0 + 1) * (c1 - c0 + 1))
        if area > 1 and int(mask.sum()) == area and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1])):
            candidates.append((area, int(color), b))

    assert len(candidates) == 1
    _area, color, b = candidates[0]
    return color, b


def _find_reflected_strip_start(g: np.ndarray, marker: int) -> int:
    n, m = map(int, g.shape)
    assert n == m
    hi = n - 1

    for lo in range(n // 2 + 1):
        strip = g[:, lo : hi + 1]
        strip_reflected = strip[:, ::-1]
        known = (strip != marker) & (strip_reflected != marker)
        if bool(np.any((strip != strip_reflected) & known)):
            continue

        strip = g[lo : hi + 1, :]
        strip_reflected = strip[::-1, :]
        known = (strip != marker) & (strip_reflected != marker)
        if bool(np.any((strip != strip_reflected) & known)):
            continue

        return lo

    raise AssertionError("no reflected strip found")


def _reflection_orbit_values(g: np.ndarray, r: int, c: int, lo: int, marker: int) -> set[int]:
    n = int(g.shape[0])
    hi = n - 1
    seen: set[tuple[int, int]] = set()
    values: set[int] = set()
    q: deque[tuple[int, int]] = deque([(int(r), int(c))])

    while q:
        rr, cc = q.popleft()
        if (rr, cc) in seen:
            continue
        seen.add((rr, cc))

        value = int(g[rr, cc])
        if value != marker:
            values.add(value)

        if lo <= cc <= hi:
            q.append((rr, lo + hi - cc))
        if lo <= rr <= hi:
            q.append((lo + hi - rr, cc))

    return values


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.

    Input structure:
    - A square colored pattern with one solid rectangular marker color occluding a patch.
    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.
    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.

    Rule:
    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.
    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.
    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.

    Key insight:
    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.
    """
    g = np.asarray(grid, dtype=int)
    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)
    lo = _find_reflected_strip_start(g, marker)

    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    out = np.empty((h, w), dtype=int)

    for rr in range(h):
        for cc in range(w):
            r = int(r0 + rr)
            c = int(c0 + cc)
            values = _reflection_orbit_values(g, r, c, lo, marker)
            if values:
                assert len(values) == 1
                out[rr, cc] = values.pop()
            else:
                assert r < lo or c < lo
                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]
                value = int(g[c, r])
                assert value != marker
                out[rr, cc] = value

    return out

# --------------- generator (o5x) ---------------

# --- CFG: canvas & structure ---
_N = 30                  # grid side length (always square)
_LO = 2                  # outer border width (rows/cols 0..lo-1 are "free" border)
_HI = _N - 1             # max row/col index

# --- CFG: colors ---
_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors
_MARKER = 8              # marker fill color

# --- CFG: marker rectangle size ---
_MARKER_DIM_LO = 3       # min marker side length
_MARKER_DIM_HI = 9       # max marker side length (inclusive)
_MARKER_AREA_LO = 16     # min marker area
_MARKER_AREA_HI = 36     # max marker area

# --- CFG: generation retries ---
_MAX_RETRIES = 300

_RNG = np.random.default_rng()
_SIZE_PAIRS = [
    (h, w)
    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)
    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)
    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI
]
_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}


def _orbit(r: int, c: int) -> set[tuple[int, int]]:
    """Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes."""
    rows = {r}
    cols = {c}
    if _LO <= r <= _HI:
        rows.add(_LO + _HI - r)
    if _LO <= c <= _HI:
        cols.add(_LO + _HI - c)
    return {(rr, cc) for rr in rows for cc in cols}


def _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:
    """Identify marker cells whose entire orbit is inside the marker (need transpose fallback).

    Returns None if the placement is invalid (a fully-covered orbit cell lies
    inside the inner block, or its transpose is also inside the marker).
    """
    r1, c1 = r0 + h, c0 + w
    cells: list[tuple[int, int]] = []
    for r in range(r0, r1):
        for c in range(c0, c1):
            if all(r0 <= rr < r1 and c0 <= cc < c1 for rr, cc in _orbit(r, c)):
                if r >= _LO and c >= _LO:
                    return None  # orbit fully hidden but no transpose fallback available
                if r0 <= c < r1 and c0 <= r < c1:
                    return None  # transpose cell also hidden by marker
                cells.append((r, c))
    return cells


def _valid_placements(h: int, w: int) -> list[tuple[int, int, list[tuple[int, int]]]]:
    """Return all valid (r0, c0, fallback_cells) placements for a h x w marker, cached."""
    key = (h, w)
    if key not in _PLACEMENT_CACHE:
        placements: list[tuple[int, int, list[tuple[int, int]]]] = []
        for r0 in range(_N - h + 1):
            for c0 in range(_N - w + 1):
                fallback = _fallback_cells(r0, c0, h, w)
                if fallback is not None:
                    placements.append((r0, c0, fallback))
        _PLACEMENT_CACHE[key] = placements
    return _PLACEMENT_CACHE[key]


def _unify_groups(clean: np.ndarray, groups: list[set[tuple[int, int]]]) -> None:
    """Merge coordinate groups with union-find so all members share a random color."""
    parent: dict[tuple[int, int], tuple[int, int]] = {}

    def find(x: tuple[int, int]) -> tuple[int, int]:
        parent.setdefault(x, x)
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a: tuple[int, int], b: tuple[int, int]) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for group in groups:
        coords = list(group)
        if not coords:
            continue
        for coord in coords[1:]:
            union(coords[0], coord)

    merged: dict[tuple[int, int], list[tuple[int, int]]] = {}
    for coord in parent:
        merged.setdefault(find(coord), []).append(coord)

    for coords in merged.values():
        color = int(_RNG.choice(_PALETTE))
        for r, c in coords:
            clean[r, c] = color


def _build_clean() -> np.ndarray:
    """Build a clean NxN grid with bilateral LR+UD symmetry on the [lo..N-1] axes."""
    half = (_N - _LO) // 2
    clean = np.empty((_N, _N), dtype=int)

    # Inner block: quarter tile mirrored LR then UD
    q = _RNG.choice(_PALETTE, size=(half, half))
    top = np.concatenate([q, q[:, ::-1]], axis=1)
    clean[_LO:_N, _LO:_N] = np.concatenate([top, top[::-1, :]], axis=0)

    # Top border rows: LR-symmetric on [lo..N-1]
    for r in range(_LO):
        vals = _RNG.choice(_PALETTE, size=half)
        clean[r, _LO : _LO + half] = vals
        clean[r, _LO + half : _N] = vals[::-1]

    # Left border cols: UD-symmetric on [lo..N-1]
    for c in range(_LO):
        vals = _RNG.choice(_PALETTE, size=half)
        clean[_LO : _LO + half, c] = vals
        clean[_LO + half : _N, c] = vals[::-1]

    # Top-left corner: free (no symmetry constraint)
    clean[:_LO, :_LO] = _RNG.choice(_PALETTE, size=(_LO, _LO))
    return clean


def _gen_attempt() -> np.ndarray | None:
    """Try once to generate a valid input grid. Returns None on failure."""
    clean = _build_clean()
    h, w = _SIZE_PAIRS[int(_RNG.integers(len(_SIZE_PAIRS)))]
    placements = _valid_placements(h, w)
