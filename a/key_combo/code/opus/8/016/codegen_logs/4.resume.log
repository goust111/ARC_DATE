+        spec["bbox"] = (r0, c0, r0 + h - 1, c0 + w - 1)
+        rr0 = max(0, r0 - 1)
+        rr1 = min(H, r0 + h + 1)
+        cc0 = max(0, c0 - 1)
+        cc1 = min(W, c0 + w + 1)
+        blocked[rr0:rr1, cc0:cc1] = True
