+
+        changed = False
+        saw_full = False
+        saw_partial = False
+        for obj in objects:
+            r0, c0, r1, c1 = obj["bbox"]
+            out_patch = out[r0 : r1 + 1, c0 : c1 + 1]
+            t = min(counts[int(obj["outer"])], len(obj["layers"]))
+            expected_layers = list(reversed(obj["layers"][:t])) + list(obj["layers"][t:])
+            assert np.array_equal(out_patch, _render_nested(obj["shape"], expected_layers))
+            if t > 1:
+                changed = True
+            if counts[int(obj["outer"])] > len(obj["layers"]):
+                saw_full = True
+            if 1 < counts[int(obj["outer"])] < len(obj["layers"]):
+                saw_partial = True
+
+        assert changed
+        assert saw_full or saw_partial
+        assert not np.array_equal(inp, out)
+        return True
+    except Exception:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {GEN_RETRIES} attempts")

