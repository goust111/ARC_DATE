+        for cj in range(len(col_segs) - 1):
+            c = int(col_starts[cj] + col_segs[cj] - 1)
+            edge_a = rect[int(row_starts[ri]) : int(row_starts[ri] + rh), c]
+            edge_b = rect[int(row_starts[ri]) : int(row_starts[ri] + rh), c + 1]
