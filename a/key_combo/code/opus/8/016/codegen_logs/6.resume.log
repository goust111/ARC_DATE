+        flex_choices = _choose_flex_cells(row_segs, col_segs, corner_piece_idx)
+        if len(flex_choices) < 1:
+            continue
+        max_single = 2 if len(piece_boxes) >= 6 else 1
+        wanted_single = random.randint(1, max_single)
