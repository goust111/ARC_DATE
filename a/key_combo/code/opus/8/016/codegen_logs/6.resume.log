+    if r0 < 0 or c0 < 0 or r0 + ph > gh or c0 + pw > gw:
+        return None
+    if any(not (0 <= r < gh and 0 <= c < gw) for r, c in marker):
+        return None
+    return (gap_r, gap_c), top_left, marker
+
