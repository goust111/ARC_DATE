+
+        def can_place(idx: int, r0: int, c0: int) -> bool:
+            arr = pieces[idx]
+            ph, pw = map(int, arr.shape)
+            if r0 + ph > hh or c0 + pw > ww:
+                return False
+            if np.any(canvas[r0 : r0 + ph, c0 : c0 + pw] != -1):
+                return False
+            if c0 > 0:
