+        def bt() -> None:
+            nonlocal total_count, first_solution
+            if total_count >= limit:
+                return
+            nxt = next_empty()
+            if nxt is None:
+                total_count += 1
+                if first_solution is None:
+                    first_solution = canvas.copy()
+                return
+            r0, c0 = nxt
