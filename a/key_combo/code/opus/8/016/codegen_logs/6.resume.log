        for cj, cw in enumerate(col_segs):
            edge_a = rect[r, int(col_starts[cj]) : int(col_starts[cj] + cw)]
            edge_b = rect[r + 1, int(col_starts[cj]) : int(col_starts[cj] + cw)]
            if not _compat(edge_a, edge_b, wildcard):
                return False
    return True


