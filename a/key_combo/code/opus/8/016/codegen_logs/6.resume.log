+        anchor_box = piece_boxes[corner_piece_idx]
+        if corner == "TL":
+            anchor_corner = (anchor_box[0], anchor_box[1])
+        elif corner == "TR":
+            anchor_corner = (anchor_box[0], anchor_box[3])
+        elif corner == "BL":
+            anchor_corner = (anchor_box[2], anchor_box[1])
+        else:
+            anchor_corner = (anchor_box[2], anchor_box[3])
