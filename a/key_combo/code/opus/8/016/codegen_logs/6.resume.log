+                sig = _piece_sig(pieces[idx])
+                if sig in tried:
+                    continue
+                tried.add(sig)
+                if can_place(idx, r0, c0):
+                    place(idx, r0, c0)
+                    bt()
+                    unplace(idx, r0, c0)
