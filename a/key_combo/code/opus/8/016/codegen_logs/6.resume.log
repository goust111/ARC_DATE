+        single_piece_indices: list[int] = []
+        for r0, c0, r1, c1 in flex_choices:
+            piece_idx = None
+            for idx, (pr0, pc0, pr1, pc1) in enumerate(piece_boxes):
+                if pr0 <= r0 <= pr1 and pc0 <= c0 <= pc1:
