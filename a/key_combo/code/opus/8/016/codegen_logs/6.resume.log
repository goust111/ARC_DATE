+        def place(idx: int, r0: int, c0: int) -> None:
+            arr = pieces[idx]
+            ph, pw = map(int, arr.shape)
+            canvas[r0 : r0 + ph, c0 : c0 + pw] = arr
+            used[idx] = True
+
+        def unplace(idx: int, r0: int, c0: int) -> None:
+            arr = pieces[idx]
+            ph, pw = map(int, arr.shape)
+            canvas[r0 : r0 + ph, c0 : c0 + pw] = -1
+            used[idx] = False
