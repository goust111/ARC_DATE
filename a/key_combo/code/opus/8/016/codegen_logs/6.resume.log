+
+    order = sorted(range(len(pieces)), key=lambda i: (-pieces[i].shape[0] * pieces[i].shape[1], -pieces[i].shape[0], -pieces[i].shape[1], i))
+    total_count = 0
+    first_solution: np.ndarray | None = None
+
+    def anchor_pos(hh: int, ww: int) -> tuple[int, int] | None:
+        if hh < ah or ww < aw:
+            return None
+        if corner == "TL":
+            return 0, 0
+        if corner == "TR":
+            return 0, ww - aw
+        if corner == "BL":
