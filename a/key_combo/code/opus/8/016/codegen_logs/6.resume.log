    print('found case', attempt, 'cands', candn, 'unique outputs', len(outputs), 'grid', grid.shape, 'survivors', len(replaced), 'decoys', len(decoys), 'corner', corner)
    # print true marker and maybe whether target output included
    print('target among outputs', mod._piece_sig(target_rect) in outputs)
    break
else:
    print('no case found')
