+def _make_target(
+    row_segs: tuple[int, ...],
+    col_segs: tuple[int, ...],
+    wildcard: int,
+    extras: list[int],
+    corner: str,
+) -> tuple[np.ndarray, list[tuple[int, int, int, int]], dict[int, tuple[int, int]]] | None:
+    row_count = len(row_segs)
