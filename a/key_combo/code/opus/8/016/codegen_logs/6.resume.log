+    def anchor_pos(hh: int, ww: int) -> tuple[int, int] | None:
+        if hh < ah or ww < aw:
+            return None
+        if corner == "TL":
+            return 0, 0
+        if corner == "TR":
+            return 0, ww - aw
+        if corner == "BL":
+            return hh - ah, 0
+        return hh - ah, ww - aw
