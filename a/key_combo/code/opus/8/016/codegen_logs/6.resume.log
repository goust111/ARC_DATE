+                continue
+            if (r0, c0) == anchor_corner:
+                continue
+            rect[r0, c0] = wildcard
+            rect[r1, c1] = random.choice(extras)
+            used_cells.add((r0, c0))
+            single_piece_indices.append(piece_idx)
+            if len(single_piece_indices) == wanted_single:
+                break
+        if len(single_piece_indices) != wanted_single:
+            continue
