+    max_piece_h = max(arr.shape[0] for arr in all_pieces)
+    max_piece_w = max(arr.shape[1] for arr in all_pieces)
+    gh = random.randint(max(18, max_piece_h + 8), 24)
+    gw = random.randint(max(18, max_piece_w + 8), 24)
