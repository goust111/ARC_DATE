+def _compat(edge_a: np.ndarray, edge_b: np.ndarray, wildcard: int) -> bool:
+    mask = (edge_a != wildcard) & (edge_b != wildcard)
+    return bool(np.all(edge_a[mask] == edge_b[mask]))
