+def _piece_bboxes(row_segs: tuple[int, ...], col_segs: tuple[int, ...]) -> list[tuple[int, int, int, int]]:
+    bboxes = []
+    r0 = 0
+    for rh in row_segs:
+        c0 = 0
+        for cw in col_segs:
+            bboxes.append((r0, c0, r0 + rh - 1, c0 + cw - 1))
+            c0 += cw
+        r0 += rh
+    return bboxes
