+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _extract_rectangles(grid: np.ndarray, bg: int) -> list[dict] | None:
+    pieces = []
+    for coords in _components(grid != bg):
+        r0, c0, r1, c1 = bbox_coords(coords)
+        arr = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+        if np.any(arr == bg):
+            return None
+        ph, pw = arr.shape
+        if not (2 <= ph <= 4 and 3 <= pw <= 5):
+            return None
+        pieces.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "arr": arr,
+                "area": int(ph * pw),
+            }
+        )
+    return pieces
+
+
+def _gap_corner(local_gap: tuple[int, int]) -> str:
+    mapping = {
+        (0, 0): "BR",
+        (0, 1): "BL",
+        (1, 0): "TR",
+        (1, 1): "TL",
+    }
+    return mapping[tuple(map(int, local_gap))]
