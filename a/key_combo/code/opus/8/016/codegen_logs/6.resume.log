+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+PIECE_COLOR_POOL = [3, 4, 5, 6, 8]
+MAX_GEN_ATTEMPTS = 400
+GRID_COMBOS = [(2, 2), (2, 3), (3, 2)]
+CORNERS = ["TL", "TR", "BL", "BR"]
