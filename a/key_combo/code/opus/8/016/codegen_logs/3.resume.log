  14: def main(input_grid):
  15:     """
  16:     Reconstruct scattered fragments by placing scaled and rotated copies of the multicolor template.
  17: 
  18:     Input structure:
  19:     - The background is a non-black color.
  20:     - One object is the multicolor template with the largest variety of colors.
  21:     - Other objects are partial scaled and rotated fragments of that template.
  22: 
  23:     Rule:
  24:     - Treat the most common non-black color as the background.
  25:     - Try rotations and scale factors of the template against the remaining fragments.
  26:     - Iteratively paste the best color-compatible placement and erase the matched fragment pixels.
  27: 
  28:     Key insight:
  29:     - The complete template is distinguished by color variety, while fragments are partial observations of transformed copies.
  30:     """
  31:     # Plan:
  32:     # 1. Detect the object, separating the small multicolored puzzle piece from its fragments
  33:     # 2. Rescale/rotate/translate the small object
  34:     # 3. Find the transformation covering as much of the fragments as possible, matching colors whenever they overlap
  35:     # 4. Copy the resulting transformation to the output grid; delete the fragments from the input
  36:     # 5. Repeat until all the fragments are gone
  37: 
  38:     # 1. object detection
  39:     # because the background is not black, set it to be the most common color
  40:     background = max(Color.NOT_BLACK, key=lambda color: np.sum(input_grid == color))
  41:     # detect the objects and figure out which is the template puzzle piece, which is going to be the one with the largest variety of colors
  42:     objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=False, return_format="objects")
  43:     template_object = max(objects, key=lambda obj: len(colors_present(obj, exclude={ background })))
  44:     _b = bbox(template_object != background)
  45:     assert _b is not None
  46:     template_sprite = crop_bbox(template_object, _b)
  47: 
  48:     output_grid = np.full_like(input_grid, background)
  49: 
  50:     # 2. rescale/rotate/translate the small object to cover as much of the fragments as possible, matching colors whenever they overlap
  51:     rescaled_and_rotated = [ np.rot90(scale_sprite(template_sprite, scale), k=rot)
  52:                             for scale in [1, 2, 3, 4]
  53:                             for rot in range(4) ]
  54:     # A placement solution is a tuple of (x, y, sprite) where x, y is the top-left corner of the rotated/scaled sprite
  55:     possible_solutions = [ (r, c, sprite)
  56:                           for sprite in rescaled_and_rotated
  57:                           for r in range(output_grid.shape[0] - sprite.shape[0])
  58:                           for c in range(output_grid.shape[1] - sprite.shape[1]) ]
  59:     
  60:     # Keep on looping until we are out of things to copy to the output
  61:     while np.any(input_grid != background):
  62: 
  63:         def score_solution(r, c, sprite):
  64:             # The score is -inf if the placement violates non-background colors
  65:             # Otherwise it is the number of pixels that match in color between the sprite and the input
  66:             test_canvas = np.full_like(input_grid, background)
  67:             paste(test_canvas, sprite, r, c, transparent=Color.BLACK, clip=True)
  68: 
  69:             if np.any( (test_canvas != background) & (input_grid != background) & (test_canvas != input_grid) ):
  70:                 return float("-inf")
  71:             
  72:             return np.sum( (test_canvas == input_grid) & (input_grid != background) )
  73:         
  74:         # Remove -inf solutions, and zero solutions
  75:         possible_solutions = [ solution for solution in possible_solutions if score_solution(*solution) > 0 ]
  76:         
  77:         best_r, best_c, best_sprite = max(possible_solutions, key=lambda solution: score_solution(*solution))
  78: 
  79:         # 4. Copy the resulting transformation to the output grid; delete the fragments from the input
  80:         # Copy output
  81:         paste(output_grid, best_sprite, best_r, best_c, transparent=Color.BLACK, clip=True)
  82:         # Delete from input
  83:         for dr, dc in np.argwhere(best_sprite != background):
  84:             input_grid[best_r + dr, best_c + dc] = background
  85:         
  86:         # 5. Repeat until all the fragments are gone
  87:     
  88:     return output_grid
  89: 
  90: 
  91: def generate_input():
  92:     # Create a multicolored template puzzle piece, plus 1-2 fragments that have strictly fewer colors
  93:     # (so the solver's `template_object = max(..., key=len(colors_present))` picks the true template).
  94: 
  95:     background = int(random.choice(Color.NOT_BLACK))
  96:     H, W = int(np.random.randint(18, 30)), int(np.random.randint(18, 30))
  97:     grid = np.full((H, W), background, dtype=int)
  98:     occupied = np.zeros((H, W), dtype=int)
  99: 
 100:     # Build a small contiguous template with many distinct colors (no BLACK, no background).
 101:     template_h = int(random.choice([3, 4]))
 102:     template_w = int(random.choice([3, 4]))
 103:     available = [int(c) for c in Color.NOT_BLACK if int(c) != background]
 104:     n_colors = int(min(len(available), max(3, min(template_h * template_w, 7))))
 105:     palette = random.sample(available, k=n_colors)
 106: 
 107:     template_puzzle_piece = np.full((template_h, template_w), background, dtype=int)
 108:     cells = [(r, c) for r in range(template_h) for c in range(template_w)]
 109:     random.shuffle(cells)
 110:     for i, (r, c) in enumerate(cells):
 111:         template_puzzle_piece[r, c] = palette[i % n_colors]
 112: 
 113:     r, c = random_free_location(occupied, np.ones_like(template_puzzle_piece), transparent=0, border=1, padding=0, padding_connectivity=8)
 114:     occupied[r : r + template_h, c : c + template_w] = 1
 115:     paste(grid, template_puzzle_piece, r, c, transparent=background, clip=True)
 116: 
 117:     n_fragments = int(np.random.randint(1, 2 + 1))
 118:     for _ in range(n_fragments):
 119:         fragment = template_puzzle_piece.copy()
 120: 
 121:         # Remove an entire color so fragments have strictly fewer colors than the template.
 122:         drop_color = random.choice(palette)
 123:         fragment[fragment == drop_color] = background
 124: 
 125:         # Additional random occlusion.
 126:         fragment[np.random.rand(*fragment.shape) < 0.2] = background
 127: 
 128:         # If we accidentally removed everything, skip this fragment.
 129:         if not bool((fragment != background).any()):
 130:             continue
 131: 
 132:         # Random rotation and (bounded) scaling.
 133:         fragment = np.rot90(fragment, k=int(np.random.randint(0, 4)))
 134:         fragment = scale_sprite(fragment, int(np.random.randint(1, 4)))
 135: 
 136:         try:
 137:             fh, fw = fragment.shape
 138:             r, c = random_free_location(occupied, np.ones((fh, fw), dtype=int), transparent=0, border=1, padding=2, padding_connectivity=8)
 139:         except ValueError:
 140:             break
 141:         occupied[r : r + fh, c : c + fw] = 1
 142:         paste(grid, fragment, r, c, transparent=background, clip=True)
 143: 
 144:     return grid

