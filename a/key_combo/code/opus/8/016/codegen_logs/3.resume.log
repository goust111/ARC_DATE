+def _boxes_separated(boxes: list[tuple[int, int, int, int]], candidate: tuple[int, int, int, int], gap: int = 1) -> bool:
+    r0, c0, r1, c1 = map(int, candidate)
+    for br0, bc0, br1, bc1 in boxes:
