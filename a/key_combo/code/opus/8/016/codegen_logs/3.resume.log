  74: def main(grid: np.ndarray) -> np.ndarray:
  75:     """
  76:     Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.
  77: 
  78:     Input structure:
  79:     - A square colored pattern with one solid rectangular marker color occluding a patch.
  80:     - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.
  81:     - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.
  82: 
  83:     Rule:
  84:     - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.
  85:     - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.
  86:     - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.
  87: 
  88:     Key insight:
  89:     The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.
  90:     """
  91:     g = np.asarray(grid, dtype=int)
  92:     marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)
  93:     lo = _find_reflected_strip_start(g, marker)
  94: 
  95:     h = int(r1 - r0 + 1)
  96:     w = int(c1 - c0 + 1)
  97:     out = np.empty((h, w), dtype=int)
  98: 
  99:     for rr in range(h):
 100:         for cc in range(w):
 101:             r = int(r0 + rr)
 102:             c = int(c0 + cc)
 103:             values = _reflection_orbit_values(g, r, c, lo, marker)
 104:             if values:
 105:                 assert len(values) == 1
 106:                 out[rr, cc] = values.pop()
 107:             else:
 108:                 assert r < lo or c < lo
 109:                 assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]
 110:                 value = int(g[c, r])
 111:                 assert value != marker
 112:                 out[rr, cc] = value
 113: 
 114:     return out
 115: 
