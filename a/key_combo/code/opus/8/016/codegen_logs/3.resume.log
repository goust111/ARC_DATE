+    specs = _transformed_specs(bars, locked_cols, rotate_colors=rotate_colors, rotate_heights=rotate_heights)
+    for bar in bars:
+        col = int(bar["col"])
+        color, height = specs[col]
+        out[baseline - height + 1 : baseline + 1, col] = color
