+    for dr, dc, kl, kr in specs:
+        left = (center[0] - kl * dr, center[1] - kl * dc)
+        right = (center[0] + kr * dr, center[1] + kr * dc)
+        if not (3 <= left[0] < H and 3 <= right[0] < H and 0 <= left[1] < W and 0 <= right[1] < W):
+            return None
+        endpoints.append((left, right))
