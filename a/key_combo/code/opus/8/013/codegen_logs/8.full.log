+
+def _bresenham_points(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+
+    points: list[tuple[int, int]] = []
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
+
+    while True:
+        points.append((int(r0), int(c0)))
+        if r0 == r1 and c0 == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dr:
