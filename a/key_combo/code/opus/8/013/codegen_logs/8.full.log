+    left_cols = [pair["endpoints"][0][1] for pair in pairs]
+    assert len(left_cols) == len(set(left_cols)), "left endpoints must be uniquely ordered"
+    pairs.sort(key=lambda pair: (pair["endpoints"][0][1], pair["endpoints"][0][0]))
+    return pairs
