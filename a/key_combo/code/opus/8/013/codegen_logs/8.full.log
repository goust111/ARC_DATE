+            if r < H - 1:
+                grid[r + 1, c] = OBSTACLE
+
+    line_points = set().union(*(set(pts) for pts in lines))
+    for pair in pairs:
+        left, right = pair["endpoints"]
+        grid[random.randint(0, 1), left[1]] = int(pair["color"])
+        grid[random.randint(0, 1), right[1]] = int(pair["color"])
