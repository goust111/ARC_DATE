+def _gen_attempt() -> np.ndarray | None:
+    H = random.randint(*GRID_SIDE_RANGE)
+    W = random.randint(*GRID_SIDE_RANGE)
+    pair_count = random.choice(PAIR_COUNT_CHOICES)
+    want_bottom = random.random() < 0.5
+
+    for _ in range(250):
+        center = (
+            random.randint(max(5, H // 3), min(H - 4, H - 6)),
+            random.randint(max(5, W // 3), min(W - 4, W - 6)),
+        )
+        vectors = random.sample(LINE_VECTORS, pair_count)
+        endpoints: list[tuple[tuple[int, int], tuple[int, int]]] = []
+        used_cols: set[int] = set()
+        bottom_hits = 0
+
+        ok = True
+        for vec in vectors:
+            left_steps, right_steps = _valid_steps(center, vec, H, W)
+            if not left_steps or not right_steps:
+                ok = False
+                break
+            random.shuffle(left_steps)
+            random.shuffle(right_steps)
+
+            chosen = None
+            for kl in left_steps:
+                left = (center[0] - kl * vec[0], center[1] - kl * vec[1])
+                if left[1] in used_cols:
+                    continue
+                for kr in right_steps:
+                    right = (center[0] + kr * vec[0], center[1] + kr * vec[1])
+                    if right[1] in used_cols or right[1] == left[1]:
+                        continue
+                    chosen = (left, right)
+                    break
+                if chosen is not None:
+                    break
+            if chosen is None:
+                ok = False
+                break
+
+            used_cols.add(int(chosen[0][1]))
+            used_cols.add(int(chosen[1][1]))
+            bottom_hits += int(chosen[0][0] == H - 1) + int(chosen[1][0] == H - 1)
+            endpoints.append(chosen)
+
+        if not ok:
+            continue
+        if want_bottom and bottom_hits == 0:
+            continue
+        if not want_bottom and bottom_hits > pair_count:
+            continue
+
+        pairs = []
+        colors = random.sample(MARKER_COLORS, pair_count)
+        for color, (left, right) in zip(colors, endpoints):
+            a, b = sorted([left, right], key=lambda rc: (rc[1], rc[0]))
+            pairs.append({"color": int(color), "endpoints": [a, b]})
+        pairs.sort(key=lambda pair: (pair["endpoints"][0][1], pair["endpoints"][0][0]))
+
+        lines = [_bresenham_points(pair["endpoints"][0], pair["endpoints"][1]) for pair in pairs]
+        if not _line_center_crosses(lines, center):
+            continue
+
+        grid = np.full((H, W), BG, dtype=int)
+        for pair in pairs:
+            for r, c in pair["endpoints"]:
+                if r < H - 1:
+                    grid[r + 1, c] = OBSTACLE
+
+        line_points = set().union(*(set(pts) for pts in lines))
+        occupied = line_points | set(tuple(map(int, rc)) for rc in np.argwhere(grid == OBSTACLE))
+        for pair in pairs:
+            left, right = pair["endpoints"]
+            mr0 = random.randint(0, 1)
+            mr1 = random.randint(0, 1)
+            if (mr0, left[1]) in occupied or (mr1, right[1]) in occupied:
+                ok = False
+                break
+            grid[mr0, left[1]] = int(pair["color"])
+            grid[mr1, right[1]] = int(pair["color"])
+        if not ok:
+            continue
+
+        target_obstacles = random.randint(max(5, int(np.count_nonzero(grid == OBSTACLE))), 10)
+        free_candidates = [
+            (r, c)
+            for r in range(2, H - 1)
+            for c in range(W)
+            if grid[r, c] == BG
+            and (r, c) not in line_points
+            and c not in used_cols
+        ]
+        random.shuffle(free_candidates)
+        for r, c in free_candidates:
+            if int(np.count_nonzero(grid == OBSTACLE)) >= target_obstacles:
+                break
+            grid[r, c] = OBSTACLE
+
+        if not (5 <= int(np.count_nonzero(grid == OBSTACLE)) <= 10):
+            continue
+
+        try:
+            parsed_pairs = _extract_pairs(grid)
+            out = main(grid)
+        except AssertionError:
+            continue
+        if not np.array_equal(out, _render_output(grid, parsed_pairs)):
+            continue
+        if not _semantic_checks(grid, out, parsed_pairs, center):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

