+            used_cols.add(int(chosen[0][1]))
+            used_cols.add(int(chosen[1][1]))
+            bottom_hits += int(chosen[0][0] == H - 1) + int(chosen[1][0] == H - 1)
+            endpoints.append(chosen)
+
+        if not ok:
+            continue
+        if want_bottom and bottom_hits == 0:
+            continue
+        if not want_bottom and bottom_hits > pair_count:
