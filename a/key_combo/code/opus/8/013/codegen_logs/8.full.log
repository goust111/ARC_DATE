+    center = (int(center[0]), int(center[1]))
+    for pts in lines:
+        if center not in set(pts):
+            return False
+    for i in range(len(lines)):
+        hit = False
+        set_i = set(lines[i])
+        for j in range(len(lines)):
+            if i == j:
