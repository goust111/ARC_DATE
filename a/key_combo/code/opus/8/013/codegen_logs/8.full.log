+
+BG = 0
+OBSTACLE = 5
+MARKER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+LINE_VECTORS = [(-1, 1), (1, 1), (-1, 2), (1, 2), (-2, 1), (2, 1)]
+GRID_SIDE_RANGE = (14, 19)
+PAIR_COUNT_CHOICES = (3, 4)
+GENERATION_ATTEMPTS = 500
