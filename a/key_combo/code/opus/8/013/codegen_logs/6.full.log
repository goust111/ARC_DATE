+        cc = w // 2
+        half_h = int(rng.integers(2, cr))
+        half_w = int(rng.integers(2, cc))
+        _draw_rect_outline(crop, cr - half_h, cc - half_w, cr + half_h, cc + half_w)
+    else:
+        cr = h // 2
+        cc = w // 2
+        box_h = int(rng.integers(2, cr - 1))
+        box_w = int(rng.integers(2, cc - 1))
