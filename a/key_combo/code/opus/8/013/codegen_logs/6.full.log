+
+def _mirror_orbit(h: int, w: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    assert h % 2 == 1 and w % 2 == 1, "crop dimensions must be odd"
+    cr = h // 2
+    cc = w // 2
+    pts = {
+        (int(r), int(c)),
+        (int(2 * cr - r), int(c)),
+        (int(r), int(2 * cc - c)),
+        (int(2 * cr - r), int(2 * cc - c)),
+    }
+    for rr, cc2 in pts:
+        assert 0 <= rr < h and 0 <= cc2 < w
+    return tuple(sorted(pts))
