+def _embed_crop(rng: np.random.Generator, crop: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    h, w = crop.shape
+    H = int(rng.integers(max(h + 4, 14), min(25, 30) + 1))
+    W = int(rng.integers(max(w + 4, 14), min(25, 30) + 1))
+    grid = np.zeros((H, W), dtype=int)
+    for _ in range(100):
