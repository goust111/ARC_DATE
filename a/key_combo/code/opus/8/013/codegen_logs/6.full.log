+    def get_bg(grid: np.ndarray) -> int:
+        values, counts = np.unique(grid, return_counts=True)
+        return int(values[np.argmax(counts)])
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors=None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ):
+        if bg is None:
