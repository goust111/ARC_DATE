            for dc in (-1, 0, 1)
            if (dr, dc) != (0, 0)
        ]
        for color in palette:
            mask = grid == color
            visited[:] = False
            for r, c in np.argwhere(mask):
                r = int(r)
                c = int(c)
                if visited[r, c]:
                    continue
                stack = [(r, c)]
                coords = []
                visited[r, c] = True
                while stack:
                    rr, cc = stack.pop()
                    coords.append((rr, cc))
                    for dr, dc in dirs:
                        nr = rr + dr
                        nc = cc + dc
                        if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and not visited[nr, nc] and mask[nr, nc]:
                            visited[nr, nc] = True
                            stack.append((nr, nc))
                if len(coords) < min_area:
                    continue
                arr = np.array(coords, dtype=int)
                r0, c0 = arr.min(axis=0)
                r1, c1 = arr.max(axis=0)
                out.append(
                    {
                        "color": color,
                        "coords": arr,
                        "bbox": (int(r0), int(c0), int(r1), int(c1)),
                        "area": int(len(coords)),
                    }
                )
        return out


