+    noise_cells = [
+        (r, c)
+        for r in range(H)
+        for c in range(W)
+        if not (top <= r < top + h and left <= c < left + w)
+    ]
+    rng.shuffle(noise_cells)
+    for r, c in noise_cells[: int(rng.integers(1, 6))]:
+        grid[r, c] = int(rng.choice(GREY_NOISE_FREE_COLORS))
