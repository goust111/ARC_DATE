+
+def _all_orbits_of_color(crop: np.ndarray, color: int) -> list[tuple[tuple[int, int], ...]]:
+    h, w = crop.shape
+    seen = set()
+    out = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            orbit = _mirror_orbit(h, w, r, c)
+            if orbit in seen:
+                continue
+            seen.add(orbit)
+            if all(int(crop[rr, cc]) == int(color) for rr, cc in orbit):
+                out.append(orbit)
+    return out
