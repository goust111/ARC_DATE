+        k = 1 if rng.random() < 0.7 else min(2, len(orbit_cells) - 1)
+        if yellow_count + k > 4:
+            continue
+        chosen = rng.choice(len(orbit_cells), size=k, replace=False)
+        for idx in np.atleast_1d(chosen):
