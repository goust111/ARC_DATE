+    red_holes = 0
+    used = set()
+
+    for orbit in red_orbits:
+        if yellow_count >= 2 and red_holes >= 2:
+            break
+        orbit_cells = [cell for cell in orbit if cell not in used]
+        if len(orbit_cells) < 2:
+            continue
+        k = 2 if len(orbit_cells) >= 3 else 1
+        if yellow_count + k > 4:
