        bg: int | None = None,
        connectivity: int = 4,
        monochromatic: bool = True,
        colors=None,
        min_area: int = 1,
        return_format: str = "dict",
    ):
        if bg is None:
            bg = get_bg(grid)
        if colors is None:
            palette = [int(c) for c in np.unique(grid) if int(c) != int(bg)]
        else:
