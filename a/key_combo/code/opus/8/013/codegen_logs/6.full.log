+def _validate_instance(inp: np.ndarray, complete_crop: np.ndarray) -> bool:
+    expected = _fill_between_red_pairs(complete_crop)
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
+        return False
+    if not np.any(actual == Color.GREEN):
+        return False
