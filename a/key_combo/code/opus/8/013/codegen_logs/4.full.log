+def _place_isolated_extras(grid: np.ndarray, color_plan: dict[int, int]) -> bool:
+    slots = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != BG:
+                continue
+            ok = True
+            for rr, cc in _neighbors4(r, c):
+                if _in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) != BG:
