+
+def _find_gate_pair(
+    positions: set[tuple[int, int]],
+    cover: dict[tuple[int, int], list[tuple[int, int]]],
+    start: tuple[int, int],
+    target: tuple[int, int],
+    decoys: list[tuple[int, int]],
