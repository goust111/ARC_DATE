+    random.shuffle(slots)
+
+    needed = sum(color_plan.values())
+    if len(slots) < needed:
+        return False
+
+    chosen = []
+    while slots and len(chosen) < needed:
+        cell = slots.pop()
+        chosen.append(cell)
+        slots = [
+            other
+            for other in slots
