+    col_off = random.randint(2, canvas_w - inner_w - 2)
+
+    grid = np.zeros((canvas_h, canvas_w), dtype=int)
+    grid[row_off : row_off + inner_h, col_off : col_off + inner_w][corridor_mask] = GREY
