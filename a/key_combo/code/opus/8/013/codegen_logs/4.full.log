+def _build_layout() -> tuple[set[tuple[int, int]], tuple[int, int], tuple[int, int], list[tuple[int, int]]]:
+    h = random.randint(3, 5)
+    w = random.randint(3, 5)
+    perimeter = {(0, c) for c in range(w + 1)}
+    perimeter |= {(h, c) for c in range(w + 1)}
