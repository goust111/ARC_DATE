+    for k in range(steps):
+        rr = int(start[0] + dr * k)
+        cc = int(start[1] + dc * k)
+        out[rr, cc] = int(color)
+
+
+def _draw_diag(out: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int) -> None:
+    dr = _sign(end[0] - start[0])
+    dc = _sign(end[1] - start[1])
+    steps = abs(end[0] - start[0])
