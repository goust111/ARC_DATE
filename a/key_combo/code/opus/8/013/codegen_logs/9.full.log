+    for item in sorted(meta["markers"], key=lambda m: (m["marker"][0], m["marker"][1]), reverse=True):
+        _draw_diag(out, item["marker"], item["far"], RED)
+        _draw_axis(out, item["marker"], item["near"], YELLOW)
+    return out
