+    isolated = [meta["marker"] for meta in marker_meta]
+    grid = np.full((H, W), BG, dtype=int)
+    for r, c in object_cells:
+        grid[r, c] = BLUE
+    for r, c in embedded:
+        grid[r, c] = ORANGE
+    for r, c in isolated:
