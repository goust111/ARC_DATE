+        "endpoints": lambda r0, c0, r1, c1: {"top": (r0, c0), "bottom": (r1, c0)},
+        "marker": lambda pt, d: (pt[0], pt[1] - d),
+    },
+    "right": {
+        "length": lambda h, w: h,
+        "endpoints": lambda r0, c0, r1, c1: {"top": (r0, c1), "bottom": (r1, c1)},
+        "marker": lambda pt, d: (pt[0], pt[1] + d),
+    },
+    "top": {
+        "length": lambda h, w: w,
