+    },
+    "bottom": {
+        "length": lambda h, w: w,
+        "endpoints": lambda r0, c0, r1, c1: {"left": (r1, c0), "right": (r1, c1)},
+        "marker": lambda pt, d: (pt[0] + d, pt[1]),
