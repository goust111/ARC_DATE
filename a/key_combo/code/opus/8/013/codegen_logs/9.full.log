+    for k in range(steps):
+        rr = int(start[0] + dr * k)
+        cc = int(start[1] + dc * k)
+        out[rr, cc] = int(color)
+
+
+def _solve(grid: np.ndarray, *, repair: bool) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
