+        out[r, c] = BLUE
+    edge = meta["edge"]
+    if edge == "top":
+        out[0, :] = GREY
+    elif edge == "bottom":
+        out[-1, :] = GREY
+    elif edge == "left":
+        out[:, 0] = GREY
+    else:
+        out[:, -1] = GREY
