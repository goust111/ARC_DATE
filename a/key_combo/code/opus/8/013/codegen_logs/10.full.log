+
+    if not np.array_equal(interior, region & (~(closed != BG))):
+        return False
+
+    for item in chosen:
+        altered = inp.copy()
+        sr, sc = item["start"]
+        altered[sr, sc] = BG
+        try:
+            alt_out = main(altered)
+        except Exception:
+            continue
+        if np.array_equal(alt_out, out):
