+                cells.append((sr, sc))
+            if max_dist == 0:
+                continue
+            cands.append(
+                {
+                    "target": (r, c),
+                    "color": color,
+                    "dir": (dr, dc),
+                    "forward": (fr, fc),
+                    "starts": tuple(cells),
+                }
+            )
+    return cands
+
+
+def choose_plugs(cands: list[dict]) -> list[dict] | None:
+    variants: list[dict] = []
+    for cand in cands:
+        dr, dc = cand["dir"]
+        for start in cand["starts"]:
+            sr, sc = start
