+def boundary_from_region(region: np.ndarray) -> np.ndarray:
+    h, w = region.shape
+    out = np.zeros_like(region, dtype=bool)
+    cells = np.argwhere(region)
+    for r0, c0 in cells:
+        r = int(r0)
+        c = int(c0)
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(region.shape, nr, nc) or not bool(region[nr, nc]):
+                out[r, c] = True
+                break
+    return out
