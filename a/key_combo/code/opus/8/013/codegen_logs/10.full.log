+        q = deque([(r, c)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in neighbors4(rr, cc):
+                if in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
