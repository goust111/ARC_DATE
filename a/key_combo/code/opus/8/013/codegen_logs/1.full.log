+                break
+            overlap = random.randint(min_overlap, max_overlap)
+            left = prev_right - overlap + 1
+            if left + widths[i] > width:
+                ok = False
+                break
+            lefts_sorted[i] = left
+        if not ok:
+            continue
+        lefts = [0] * count
+        for idx, left in zip(order, lefts_sorted):
