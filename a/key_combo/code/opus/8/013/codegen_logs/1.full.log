+
+def _drop_distance(coords: np.ndarray, height: int, rows_by_col: dict[int, list[int]]) -> int:
+    best = height
+    for r0, c0 in coords:
+        r = int(r0)
+        c = int(c0)
+        rows = rows_by_col.get(c, [])
+        idx = bisect_right(rows, r)
+        floor_r = rows[idx] if idx < len(rows) else height
+        best = min(best, int(floor_r - r - 1))
+    assert best >= 0
+    return int(best)
