+        lefts_sorted = [0] * count
+        lefts_sorted[0] = random.randint(0, width - widths[0])
+        ok = True
+        for i in range(1, count):
+            prev_left = lefts_sorted[i - 1]
+            prev_right = prev_left + widths[i - 1] - 1
+            min_overlap = 1
+            max_overlap = min(2, widths[i - 1] - 1, widths[i] - 1)
+            if max_overlap < min_overlap:
+                ok = False
+                break
+            overlap = random.randint(min_overlap, max_overlap)
+            left = prev_right - overlap + 1
