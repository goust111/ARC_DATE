  11: def main(input_grid):
  12:     """
  13:     Crop out the rectangle bounded by the two gray vertical rails and teal corner markers.
  14: 
  15:     Input structure:
  16:     - The grid has a black background with scattered teal pixels.
  17:     - Two vertical gray line objects form the left and right sides of the target crop.
  18:     - Teal corner pixels sit one row beyond the gray line endpoints.
  19: 
  20:     Rule:
  21:     - Detect the gray vertical line objects and order them from left to right.
  22:     - Crop between their columns and extend one row above and below their line extents.
  23:     - Clamp the crop to the input canvas.
  24: 
  25:     Key insight:
  26:     - The gray rails provide the side boundaries, and the row expansion includes the teal
  27:       corner markers that complete the rectangle.
  28:     """
  29:     bg = Color.BLACK
  30:     # Detect the two vertical gray lines.
  31:     vertical_lines = detect_objects(grid=input_grid, colors=[Color.GREY], monochromatic=True, connectivity=4, background=bg)
  32:     bbs = []
  33:     for line in vertical_lines:
  34:         b = bbox(line != bg)
  35:         if b is not None:
  36:             bbs.append(b)
  37:     assert len(bbs) >= 2
  38: 
  39:     # Sort left-to-right by column.
  40:     bbs.sort(key=lambda b: b[1])
  41:     left, right = bbs[0], bbs[1]
  42: 
  43:     r0 = min(left[0], right[0]) - 1
  44:     r1 = max(left[2], right[2]) + 1
  45:     c0 = min(left[1], right[1])
  46:     c1 = max(left[3], right[3])
  47: 
  48:     H, W = input_grid.shape
  49:     r0 = max(0, int(r0))
  50:     c0 = max(0, int(c0))
  51:     r1 = min(H - 1, int(r1))
  52:     c1 = min(W - 1, int(c1))
  53:     return input_grid[r0 : r1 + 1, c0 : c1 + 1]
