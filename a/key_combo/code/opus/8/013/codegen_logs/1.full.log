+        r = random.randint(height // 2, height - 2)
+        if grid[r, c] != BG or (r, c) in obstacles:
+            continue
+        obstacles.add((r, c))
+    if len(obstacles) != desired_obstacle_count:
+        return None
+
+    for r, c in obstacles:
+        grid[r, c] = OBSTACLE
+
+    if not _semantic_ok(grid):
+        return None
+
+    actual = main(grid)
+    if actual.ndim != 2 or max(actual.shape) > 30:
+        return None
+    return grid
+
