+    pairs = 0
+    for i in range(len(as_sets)):
+        for j in range(i + 1, len(as_sets)):
+            if as_sets[i] & as_sets[j]:
+                pairs += 1
+    return pairs
+
+
+def _same_order(a: list[LandedSprite], b: list[LandedSprite]) -> bool:
