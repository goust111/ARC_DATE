+        return cropped
+    return None
+
+
+def _random_sprite_mask() -> np.ndarray | None:
+    for _ in range(100):
+        height = random.randint(2, 3)
+        width = random.randint(3, 4)
+        max_area = min(7, height * width - 1)
+        if max_area < 4:
+            continue
+        area = random.randint(4, max_area)
+        mask = _grow_mask(height, width, area)
+        if mask is not None:
