+    return None
+
+
+def _expand_grid(base: np.ndarray, row_repeats: list[int], col_repeats: list[int]) -> np.ndarray:
+    rows = np.repeat(base, row_repeats, axis=0)
+    return np.repeat(rows, col_repeats, axis=1)
