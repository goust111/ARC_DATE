+        picked = []
+        cur_rows = set(used_rows)
+        cur_cols = set(used_cols)
+        for rr, cc in candidates:
+            if rr in cur_rows or cc in cur_cols:
+                continue
+            picked.append((rr, cc))
+            cur_rows.add(rr)
+            cur_cols.add(cc)
+            if len(picked) == need:
