+        max_gain[idx] = max_gain[idx + 1] + max_here
+
+    targets = list(range(2, max_holes + 1))
+    rng.shuffle(targets)
+
+    def search(
+        idx: int,
+        target: int,
+        used_rows: set[int],
+        used_cols: set[int],
+        chosen: list[tuple[int, int]],
+    ) -> list[tuple[int, int]] | None:
