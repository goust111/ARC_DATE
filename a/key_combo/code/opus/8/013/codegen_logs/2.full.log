+    if expanded.shape[0] <= h or expanded.shape[1] <= w:
+        return None
+    return expanded
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid puzzle after {GEN_RETRIES} attempts")

