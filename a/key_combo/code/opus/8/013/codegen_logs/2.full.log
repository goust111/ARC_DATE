+        h = rng.randint(4, 6)
+        w = rng.randint(4, 6)
+        fg_count = 2 if rng.random() < 0.55 else 3
+        fg_colors = rng.sample(FG_POOL, fg_count)
+        palette = [BG] + fg_colors
+        weights = [1] + [3] * fg_count
