+    if not np.array_equal(main(expanded), base_out):
+        return None
+    if expanded.shape[0] <= h or expanded.shape[1] <= w:
+        return None
+    return expanded
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
