+def _hole_options(
+    orbit: tuple[tuple[int, int], ...], row_repeats: list[int], col_repeats: list[int]
+) -> list[tuple[tuple[int, int], ...]]:
+    eligible = [
+        cell
+        for cell in orbit
+        if row_repeats[cell[0]] > 1 and col_repeats[cell[1]] > 1
