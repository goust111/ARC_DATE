+def _families_disjoint(cells: list[tuple[int, int]], axis_r: int, axis_c: int) -> bool:
+    occupied: set[tuple[int, int]] = set()
+    for r, c in cells:
+        family = {(r, c), *_mirror_positions(r, c, axis_r, axis_c)}
+        if occupied & family:
+            return False
+        occupied |= family
+    return True
