+        return False
+
+    inside_originals = [cell for cell in markers if _hourglass_hit(cell[0], cell[1], axis_r, axis_c, separator_axis)]
+    if not inside_originals:
+        return False
+    if any(actual[cell] != BLUE for cell in inside_originals):
