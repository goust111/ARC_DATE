+
+def _expand_with_separators(compressed: np.ndarray, separator_axis: int, separator_boundaries: list[int]) -> np.ndarray:
+    h, w = compressed.shape
+    if separator_axis == 0:
+        raw_h = h + len(separator_boundaries)
