+        kept_rows: list[int] = []
+        separator_rows: set[int] = set()
+        raw_r = 0
+        for r in range(h):
+            kept_rows.append(raw_r)
+            raw_r += 1
+            if (r + 1) in separator_boundaries:
+                separator_rows.add(raw_r)
+                raw_r += 1
