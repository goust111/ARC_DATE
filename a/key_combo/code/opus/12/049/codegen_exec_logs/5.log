+def _build_compressed_grid(
+    h: int,
+    w: int,
+    axis_r: int,
+    axis_c: int,
+    markers: list[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full((h, w), BLACK, dtype=int)
+    grid[axis_r, :] = PINK
+    grid[:, axis_c] = PINK
+    for r, c in markers:
+        grid[r, c] = BLUE
+    return grid
