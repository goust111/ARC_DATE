+
+BLACK = 0
+BLUE = 1
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_MIN = 10
+GRID_MAX = 16
+SEPARATOR_COUNT_RANGE = (2, 3)
+MARKER_COUNT_RANGE = (3, 5)
