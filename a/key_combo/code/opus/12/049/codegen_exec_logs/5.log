+            raw[sep_r, :] = GREY
+        return raw
+
+    raw_w = w + len(separator_boundaries)
+    raw = np.full((h, raw_w), BLACK, dtype=int)
+    kept_cols: list[int] = []
+    separator_cols: set[int] = set()
+    raw_c = 0
+    for c in range(w):
+        kept_cols.append(raw_c)
+        raw_c += 1
+        if (c + 1) in separator_boundaries:
+            separator_cols.add(raw_c)
+            raw_c += 1
