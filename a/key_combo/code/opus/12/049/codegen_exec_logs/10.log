+def _normalize(coords: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = sorted({(int(r), int(c)) for r, c in coords})
+    r0 = min(r for r, _c in pts)
+    c0 = min(c for _r, c in pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
