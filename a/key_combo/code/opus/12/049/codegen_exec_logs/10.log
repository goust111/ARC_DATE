+    pts = np.array(shape, dtype=int)
+    for _ in range(int(rot) % 4):
+        pts = np.stack([pts[:, 1], -pts[:, 0]], axis=1)
+    if flip:
+        pts = np.stack([pts[:, 0], -pts[:, 1]], axis=1)
+    return _normalize(map(tuple, pts.tolist()))
+
+
