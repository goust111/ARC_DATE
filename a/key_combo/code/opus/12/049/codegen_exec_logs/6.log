+    min_gap = min(gaps)
+    assert gaps.count(min_gap) == 1, "minimum green-pair gap must be unique"
+    axis_row, c0, c1, _gap = next(item for item in pairs if item[3] == min_gap)
+    return axis_row, c0, c1
