+def _filled_base(grid: np.ndarray) -> tuple[np.ndarray, int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert set(map(int, np.unique(g))).issubset({BG, RED, GREEN})
