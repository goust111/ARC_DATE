+def _mirror_full(base: np.ndarray, axis_row: int) -> np.ndarray:
+    h, w = base.shape
+    out = base.copy()
+    src = np.argwhere(base != BG)
+    for r, c in src:
+        r = int(r)
+        c = int(c)
+        if r == axis_row:
+            continue
+        rr = 2 * axis_row - r
+        if 0 <= rr < h and out[rr, c] == BG:
