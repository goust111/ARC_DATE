+
+    if len(_find_cavities(inp)) != len(cavities):
+        return None
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        case = _try_generate_case(rng)
+        if case is None:
