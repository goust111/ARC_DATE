    "NW": (-1, -1),
    "NE": (-1, 2),
    "SW": (2, -1),
    "SE": (2, 2),
}

DIAGONAL_DIRS = {
    "NW": (-1, -1),
    "NE": (-1, 1),
    "SW": (1, -1),
    "SE": (1, 1),
}

ROTATED_SOURCE = {
    "NW": "SW",
    "NE": "NW",
    "SE": "NE",
    "SW": "SE",
}


def _block_color(g: np.ndarray, bg: int) -> int:
    candidates: list[int] = []
    for color in colors_present(g, exclude={bg}):
        comps = find_components(
            g,
            bg=bg,
            connectivity=4,
            monochromatic=True,
            colors=[color],
            return_format="dict",
        )
        if comps and all(
            int(comp["area"]) == 4
            and bbox_h(comp["bbox"]) == 2
            and bbox_w(comp["bbox"]) == 2
            for comp in comps
