+                continue
+            if not np.all(g[r0 - 1 : r0 + CAVITY_SIZE + 1, c0 - 1] == FRAME):
+                continue
+            if not np.all(g[r0 - 1 : r0 + CAVITY_SIZE + 1, c0 + CAVITY_SIZE] == FRAME):
+                continue
+            if np.any(g[r0 : r0 + CAVITY_SIZE, c0 : c0 + CAVITY_SIZE] == FRAME):
+                continue
+            cavities.append((int(r0), int(c0)))
