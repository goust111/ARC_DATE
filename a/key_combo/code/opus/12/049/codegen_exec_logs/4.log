+        if int(mask.sum()) != target:
+            continue
+
+        cropped = _crop_non_bg(mask.astype(int), bg=0).astype(bool)
+        if cropped.shape[0] > CAVITY_SIZE or cropped.shape[1] > CAVITY_SIZE:
+            continue
+        if int(cropped.sum()) < 4 or int(cropped.sum()) > 8:
