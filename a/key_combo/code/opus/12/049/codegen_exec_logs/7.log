+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+TEAL = 8
+
+ENCODE_COLORS = (BLUE, RED, YELLOW, ORANGE)
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
