+    total_encoded = int(np.count_nonzero(np.isin(grid, ENCODE_COLORS)))
+    assert 3 <= total_encoded <= 4, "generator uses 3-4 encoded turn blockers"
+
+    r, c = inner_pt
+    seg_len = 2
