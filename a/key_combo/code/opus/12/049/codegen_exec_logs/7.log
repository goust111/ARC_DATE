+def _paint_square(out: np.ndarray, center: tuple[int, int], half: int, color: int) -> None:
+    cr, cc = center
+    r0 = max(0, cr - half)
+    r1 = min(out.shape[0] - 1, cr + half)
+    c0 = max(0, cc - half)
+    c1 = min(out.shape[1] - 1, cc + half)
+    out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
