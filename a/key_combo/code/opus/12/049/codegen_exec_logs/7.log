    if any(p in path or p in {bp,ip} for p in bpos): continue
    sols=traces(H,W,(bp,ip),tuple(blockers))
    maxk=max(len(enc) for enc,_,_ in sols)
    best=[s for s in sols if len(s[0])==maxk]
    target=(tuple(b for b,_ in blockers), tuple(lens), tuple(c for _,c in blockers))
    best2=[s for s in best if s[0]==target[0] and s[1]==target[1] and s[2]==target[2]]
    if len(best)==1 and best2:
        print('found',attempt,H,N,lens,(bp,ip),dirs,blockers,'numsol',len(sols),'best',best[0])
