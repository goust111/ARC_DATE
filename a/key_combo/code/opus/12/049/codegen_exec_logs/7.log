+        return None
+    if len(path_cells) < 8:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(800):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError("generate_input failed after 800 attempts")

