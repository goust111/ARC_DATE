        raw_c += 1
        if (c + 1) in separator_boundaries:
            separator_cols.add(raw_c)
            raw_c += 1
    for src_c, dst_c in enumerate(kept_cols):
        raw[:, dst_c] = compressed[:, src_c]
    for sep_c in separator_cols:
        raw[:, sep_c] = GREY
    return raw


def _sample_marker_set(
    h: int,
    w: int,
