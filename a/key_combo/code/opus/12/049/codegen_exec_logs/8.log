)
SHAPE_H3 = (
    np.array([[1], [1], [1]], dtype=int),
    np.array([[1, 0, 0], [1, 0, 0], [1, 1, 1]], dtype=int),
    np.array([[0, 0, 1], [0, 0, 1], [1, 1, 1]], dtype=int),
