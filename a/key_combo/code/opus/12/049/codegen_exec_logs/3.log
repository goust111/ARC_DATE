+            colors = sorted(set(map(int, block[block != BACKGROUND])))
+            assert len(colors) == 1, "each frame must use exactly one visible color"
+            color = colors[0]
+            assert np.all(block[0, :] == color)
+            assert np.all(block[-1, :] == color)
+            assert np.all(block[:, 0] == color)
+            assert np.all(block[:, -1] == color)
