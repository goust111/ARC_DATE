+
+
+def _pick_shape(category: str, rng: random.Random) -> np.ndarray:
+    if category == "h1":
+        return rng.choice(SHAPE_H1).copy()
+    assert category == "h3"
+    return rng.choice(SHAPE_H3).copy()
+
+
+def _place_shape(
+    shape: np.ndarray,
+    side: str,
+    center_col: int,
+    bar_r: int,
+    height: int,
+) -> np.ndarray:
+    coords = _shape_coords(shape)
+    center_r_off, center_c_off = _shape_center_offset(shape)
