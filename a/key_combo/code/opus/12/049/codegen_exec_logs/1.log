+        center_list = []
+        for coords in comps:
+            moved = _slide_to_barrier(coords, bar_r)
+            assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < g.shape[0]) & (0 <= moved[:, 1]) & (moved[:, 1] < g.shape[1]))
