+    moved_by_color: dict[int, list[np.ndarray]] = {}
+    moved_centers: dict[int, list[tuple[int, int]]] = {}
+
+    occupied = np.zeros(g.shape, dtype=bool)
+    occupied[bar_r, :] = True
+    for color, comps in objects.items():
