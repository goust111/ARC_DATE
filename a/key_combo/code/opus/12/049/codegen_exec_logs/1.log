+    if mode == "column":
+        if tuple(win_info["priority"])[0] != tuple(lose_info["priority"])[0]:
+            return False
+        if tuple(win_info["priority"])[1] >= tuple(lose_info["priority"])[1]:
+            return False
+
+    if visible_overlap:
