+def _line_coords(h: int, w: int, slope: int, key: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    if slope == 1:
+        for r in range(h):
+            c = r - key
+            if 0 <= c < w:
+                coords.append((r, c))
+    else:
+        for r in range(h):
+            c = key - r
+            if 0 <= c < w:
