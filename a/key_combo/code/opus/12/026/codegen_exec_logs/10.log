+    all_candidates = _enumerate_candidates(h, w, frames)
+    if not all_candidates:
+        return None
+
+    by_mask: dict[int, list[dict]] = {}
+    rng.shuffle(all_candidates)
+    for cand in all_candidates:
+        by_mask.setdefault(cand["mask"], []).append(cand)
