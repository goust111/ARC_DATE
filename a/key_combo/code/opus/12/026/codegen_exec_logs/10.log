+    pool: list[dict] = []
+    mask_keys = list(by_mask)
+    rng.shuffle(mask_keys)
+    for mask in mask_keys:
+        group = by_mask[mask]
+        group.sort(key=lambda cand: (cand["length"], len(cand["frames"])), reverse=True)
+        take = 6 if mask else 4
+        pool.extend(group[:take])
