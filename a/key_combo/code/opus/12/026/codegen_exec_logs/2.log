+def _gen_attempt() -> np.ndarray | None:
+    shape = (
+        random.randint(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1]),
+        random.randint(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1]),
