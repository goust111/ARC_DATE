+def _all_domino_candidates(shape: tuple[int, int]) -> list[dict]:
+    h, w = shape
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w - 1):
+            out.append(_make_domino(((r, c), (r, c + 1)), shape))
