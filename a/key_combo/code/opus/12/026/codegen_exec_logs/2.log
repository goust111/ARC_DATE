+    components_mask = _ARC_UTILS.components_mask
+
+
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
+
+
+GRID_SIDE_RANGE = (14, 18)
+DOMINO_COUNT_RANGE = (2, 5)
