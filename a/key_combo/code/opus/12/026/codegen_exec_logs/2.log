    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)

    assert len(objects) >= 2
    colors = {int(obj["color"]) for obj in objects}
    assert len(colors) == 1
    fg = next(iter(colors))

