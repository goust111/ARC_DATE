+        return None
+    slack = total_h - required
+    extras = _random_distribution(slack, len(heights) + 1)
+    tops = []
+    row = extras[0]
+    for i, height in enumerate(heights):
+        tops.append(row)
+        row += height
+        if i < len(heights) - 1:
+            row += 1 + extras[i + 1]
+    return tops
