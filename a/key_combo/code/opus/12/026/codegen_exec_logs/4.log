    h, w = tile.shape
    r_off, c_off = map(int, offset)
    out = np.empty((H, W), dtype=tile.dtype)
    for r in range(H):
        tr = (r - r_off) % h
        for c in range(W):
            tc = (c - c_off) % w
            out[r, c] = tile[tr, tc]
    return out




