+    groups = []
+    start = values[0]
+    prev = values[0]
+    for value in values[1:]:
+        if value == prev + 1:
+            prev = value
+            continue
+        groups.append((start, prev))
+        start = prev = value
+    groups.append((start, prev))
+    return groups
