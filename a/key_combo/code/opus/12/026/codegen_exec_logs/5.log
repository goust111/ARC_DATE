+        left = int(rng.integers(1, max_left + 1))
+
+        sprite = _make_cup_sprite(box_h, box_w, opening_side, hole_len, hole_start)
+        grid = np.zeros((H, W), dtype=int)
+        grid[top : top + box_h, left : left + box_w] = sprite
