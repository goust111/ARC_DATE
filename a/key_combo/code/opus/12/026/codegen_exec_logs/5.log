+from __future__ import annotations
+
+import numpy as np
+
+
+BACKGROUND = 0
+OUTLINE = 1
+FILL = 8
+
+QUADRANT_ORDER = (
+    ("lu", 0, 0),
+    ("ru", 0, 1),
+    ("ll", 1, 0),
+    ("rl", 1, 1),
+)
