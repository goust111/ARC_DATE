+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_GEN_GRID_RANGE = (17, 23)
+_GEN_TOTAL_CANDIDATES = (4, 6)
+_GEN_MATCH_RANGE = (2, 4)
+_GEN_MAX_ATTEMPTS = 400
+_GEN_HALO = 2
+_GEN_MAX_BBOX = 6
+_GEN_MAX_AREA = 12
+
+
+@dataclass(frozen=True)
+class _PlacedObject:
+    kind: str
+    mask: np.ndarray
+    top: int
+    left: int
+    grew: bool = False
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in _NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _dedupe_adjacent_rows(mask: np.ndarray) -> np.ndarray:
+    keep = [0]
+    for r in range(1, mask.shape[0]):
+        if not np.array_equal(mask[r], mask[r - 1]):
+            keep.append(r)
+    return mask[keep, :]
