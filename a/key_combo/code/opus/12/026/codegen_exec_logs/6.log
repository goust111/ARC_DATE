+    for c in range(1, mask.shape[1]):
+        if not np.array_equal(mask[:, c], mask[:, c - 1]):
+            keep.append(c)
+    return mask[:, keep]
+
+
+def _compress_runs(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
