+
+def _surface_maps(object_cells: set[tuple[int, int]]):
+    cols: dict[int, list[int]] = {}
+    rows: dict[int, list[int]] = {}
+    for r, c in object_cells:
+        cols.setdefault(c, []).append(r)
+        rows.setdefault(r, []).append(c)
