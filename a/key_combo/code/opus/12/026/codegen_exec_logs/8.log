+        if collect:
+            details.append(
+                {
+                    "marker": (mr, mc),
+                    "color": color,
+                    "direction": (dr, dc),
+                    "projection_cells": projection_cells,
+                    "projection_overwrites": projection_overwrites,
+                    "trigger": trigger_hit,
+                    "target": target_hit,
+                    "rays": ray_details,
+                }
+            )
