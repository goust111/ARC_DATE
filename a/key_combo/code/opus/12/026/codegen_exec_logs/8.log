+                    ray_cells.append((nr, nc))
+                    nr += br
+                    nc += bc
+                ray_details.append(
+                    {
+                        "dir": (br, bc),
+                        "cells": ray_cells,
+                        "stop_reason": stop_reason,
+                        "stop_cell": stop_cell,
