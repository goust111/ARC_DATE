+def _gen_attempt() -> np.ndarray | None:
+    axis = random.choice(AXES)
+    n_frames = _choice_from_weighted_pairs(FRAME_COUNT_WEIGHTS)
+    n_solids = random.randint(*SOLID_COUNT_RANGE)
