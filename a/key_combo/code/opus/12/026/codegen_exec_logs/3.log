+    positions = [(row_anchors[rs], col_anchors[cs]) for rs, cs in zip(row_slots, col_slots)]
+    cols = [c for _r, c in positions]
+    rows = [r for r, _c in positions]
+    if max(cols) - min(cols) > max(rows) - min(rows):
