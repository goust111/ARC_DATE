+    return {
+        "grid": g,
+        "frames": frames,
+        "solids": solids,
+        "axis": axis,
+        "axis_key": axis_key,
+        "row_span": row_span,
+        "col_span": col_span,
+    }
+
+
+def _pack_frames(frames: list[dict], axis: str) -> np.ndarray:
+    ordered = sorted(frames, key=lambda obj: MARKER_PRIORITY[obj["marker_color"]])
+    n = len(ordered)
+    if axis == "horizontal":
