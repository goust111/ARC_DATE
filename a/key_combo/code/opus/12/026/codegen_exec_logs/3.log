def _slot_anchors(length: int) -> list[int]:
    count = (length + OBJECT_GAP) // (FRAME_SIZE + OBJECT_GAP)
    total = count * FRAME_SIZE + (count - 1) * OBJECT_GAP
    slack = length - total
    offset = random.randint(0, slack)
