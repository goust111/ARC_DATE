    col_step = _sign(end[1] - start[1])
    assert row_step != 0 and col_step != 0

    moves = [(row_step, 0), (0, col_step)]
    r0, r1 = sorted([start[0], end[0]])
    c0, c1 = sorted([start[1], end[1]])
