+    qh, qw = int(row_sep), int(col_sep)
+    assert grid.shape == (2 * qh + 1, 2 * qw + 1), "quadrants must have equal size"
+    quadrants = [
+        grid[:qh, :qw].copy(),
+        grid[:qh, col_sep + 1 :].copy(),
+        grid[row_sep + 1 :, :qw].copy(),
+        grid[row_sep + 1 :, col_sep + 1 :].copy(),
+    ]
