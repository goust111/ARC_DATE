+    if index == 0:
+        return _rot180(base)
+    if index == 1:
+        return np.flipud(base)
+    if index == 2:
+        return np.fliplr(base)
+    if index == 3:
+        return base.copy()
+    raise ValueError("invalid quadrant index")
+
+
+def _difference_output(actual: np.ndarray, correct: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(actual)
+    diff = actual != correct
+    out[diff] = actual[diff]
+    return out
+
+
