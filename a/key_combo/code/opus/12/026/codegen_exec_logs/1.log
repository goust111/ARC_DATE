+        return _rot180(quadrant)
+    if index == 1:
+        return np.flipud(quadrant)
+    if index == 2:
+        return np.fliplr(quadrant)
+    if index == 3:
+        return quadrant.copy()
+    raise ValueError("invalid quadrant index")
+
