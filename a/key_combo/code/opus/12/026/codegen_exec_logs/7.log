+            out[r0 + 1 : r0 + 1 + inner_h, c0 + 1 : c0 + 1 + inner_w] = _tile_seed(seed, (inner_h, inner_w))
+        else:
+            out[r0 + 1 : r0 + 1 + inner_h, c0 + 1 : c0 + 1 + inner_w] = RED if area % 2 == 0 else YELLOW
+    return out
+
+
+def _validate_generation(
