+def _make_symmetric_rectangle() -> np.ndarray:
+    h = random.randint(6, 9)
+    w = random.randint(5, 8) if random.random() < 0.5 else random.randint(6, 9)
+    half = (w + 1) // 2
+    palette = random.sample(PALETTE, k=random.randint(2, min(4, len(PALETTE))))
