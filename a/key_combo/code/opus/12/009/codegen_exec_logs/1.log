  "src": "8-connected same-color foreground objects on the dominant background",
  "transform": "select the unique object whose tight-bbox mask is not mirror-symmetric left-to-right and render only that object",
  "grid_shape": "tight bbox crop of the selected object"
}
</annotation>
<generation_spec>
