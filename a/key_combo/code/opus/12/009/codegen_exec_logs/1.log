+
+def _paste_clean(canvas: np.ndarray, local: np.ndarray, r0: int, c0: int) -> np.ndarray:
+    out = canvas.copy()
+    h, w = local.shape
+    out[r0 : r0 + h, c0 : c0 + w] = local
+    return out
+
+
+def _visible_lr_symmetric(rect: np.ndarray) -> bool:
+    h, w = rect.shape
+    for r in range(h):
