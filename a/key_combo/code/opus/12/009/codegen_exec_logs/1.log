+    c0 = random.randint(0, canvas_w - w)
+    inp = np.zeros((canvas_h, canvas_w), dtype=int)
+    out = np.zeros((canvas_h, canvas_w), dtype=int)
+    inp[r0 : r0 + h, c0 : c0 + w] = local
+    return inp, out + _paste_clean(out, local, r0, c0)
