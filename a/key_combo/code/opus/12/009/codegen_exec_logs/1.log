+    rect = _make_symmetric_rectangle()
+    h, w = rect.shape
+    masked_rect = _mask_rectangle(rect)
+    if masked_rect is None:
+        return None
+
+    clean_sheared = _shear_rectangle(rect)
+    masked_sheared = _shear_rectangle(masked_rect)
+    canvas = _place_on_canvas(masked_sheared)
+    if canvas is None:
+        return None
+
+    input_grid, expected_output = canvas
+    expected_with_clean = np.zeros_like(input_grid)
+    rows, cols = np.nonzero(expected_output)
+    expected_with_clean[rows, cols] = expected_output[rows, cols]
+
