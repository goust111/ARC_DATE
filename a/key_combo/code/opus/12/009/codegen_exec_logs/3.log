+
+def _simulate_paths(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    h, w = out.shape
+    starts = [int(c) for c in np.flatnonzero(out[h - 1] == RED)]
