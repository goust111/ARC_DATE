+    grown = _simulate_paths(g)
+    out = grown.copy()
+
+    for coords in _open_components(grown):
+        colors = [int(grown[r, c]) for r, c in coords if int(grown[r, c]) in MARKER_COLORS]
+        assert len(colors) == 1, "each open region must contain exactly one marker"
+        fill_color = colors[0]
+        for r, c in coords:
