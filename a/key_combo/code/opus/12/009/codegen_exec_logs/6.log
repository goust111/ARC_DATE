+
+
+def _walk_segment(
+    shape: tuple[int, int],
+    r: int,
+    c: int,
+    dr: int,
+    dc: int,
+    length: int,
+    blocked: set[tuple[int, int]],
+) -> tuple[int, int, list[tuple[int, int]]] | None:
+    painted: list[tuple[int, int]] = []
+    for _ in range(length):
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc) or (nr, nc) in blocked:
+            return None
