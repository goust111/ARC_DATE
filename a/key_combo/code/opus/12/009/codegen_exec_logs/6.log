+    mirror_bars: list[tuple[str, list[tuple[int, int]]]] = []
+    r, c = seed_cells[-1]
+
+    first_required = None
+    if need_both_hits:
+        first_required = random.choice(["horizontal", "vertical"])
+
+    for idx in range(hit_count):
