+
+def _has_orthogonal_contact(cells: set[tuple[int, int]], other: set[tuple[int, int]]) -> bool:
+    for r, c in cells:
+        for nr, nc in _neighbors(r, c, 4):
+            if (nr, nc) in other and (nr, nc) not in cells:
