+    return None
+
+
+def _render_input(
+    shape: tuple[int, int],
+    seed_cells: list[tuple[int, int]],
+    mirror_bars: list[tuple[str, list[tuple[int, int]]]],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for r, c in seed_cells:
+        grid[r, c] = BLUE
+    for _orient, cells in mirror_bars:
+        for r, c in cells:
+            grid[r, c] = RED
