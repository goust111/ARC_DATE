+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+ORANGE = 7
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
+    (1, 0),
