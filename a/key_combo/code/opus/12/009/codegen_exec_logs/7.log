+def _generate_candidate(rng: random.Random) -> np.ndarray | None:
+    h, w = rng.choice(GRID_SHAPES)
+    color_count = rng.choices([2, 3], weights=[3, 2], k=1)[0]
+    colors = rng.sample(COLOR_POOL, color_count)
+    focus, filler = colors[0], colors[1]
+
