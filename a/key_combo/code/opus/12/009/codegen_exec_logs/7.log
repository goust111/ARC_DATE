+    sizes = _component_sizes_by_cell(grid)
+    masks = _self_masks(grid)
+    saw_blank = False
+    saw_retained = False
+    saw_same_color_split = False
+
+    for color in colors:
+        color_has_large = False
+        color_has_small = False
+        for r, c in np.argwhere(grid == color):
+            block = out[r * h : (r + 1) * h, c * w : (c + 1) * w]
