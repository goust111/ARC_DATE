+            border = np.ones((FRAME_SIZE, FRAME_SIZE), dtype=bool)
+            border[1, 1] = False
+            assert np.all(frame[border] == SCAFFOLD), "invalid frame border"
+            assert frame[1, 1] in (BG, FILL), "invalid frame center"
