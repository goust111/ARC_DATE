+def _contiguous_span(indices: np.ndarray) -> tuple[int, int]:
+    assert indices.size > 0
+    lo = int(indices[0])
+    hi = int(indices[-1])
+    assert np.array_equal(indices, np.arange(lo, hi + 1))
