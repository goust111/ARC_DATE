+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+TEAL = 8
+
+DIR_ORDER = (
+    ("top", "row", -1),
+    ("bottom", "row", 1),
+    ("left", "col", -1),
+    ("right", "col", 1),
