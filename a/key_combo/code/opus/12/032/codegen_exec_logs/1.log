+def _wrong_global_parity(grid: np.ndarray) -> np.ndarray:
+    regions = _region_bboxes(grid)
+    first_box = regions[0]
+    blue_cells = np.argwhere(grid[first_box[0] : first_box[2] + 1, first_box[1] : first_box[3] + 1] == BLUE)
+    br, bc = map(int, blue_cells[0])
