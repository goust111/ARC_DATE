+    forced = ((br + first_box[0]) % 2, (bc + first_box[1]) % 2)
+
+    out = grid.copy()
+    out[out == YELLOW] = BLACK
+    for bbox in regions:
+        for r, c in _simulate_region(grid, bbox, forced_parity=forced):
