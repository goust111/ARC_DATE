+    parity_rows = [r for r in range(r0, r1 + 1) if r % 2 == p_r]
+    parity_cols = [c for c in range(c0, c1 + 1) if c % 2 == p_c]
+    input_rows = [r for r in parity_rows if r <= upper_end and r != br]
+    assert len(input_rows) >= 2
+
+    landing_rows = {
