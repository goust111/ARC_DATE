+            out = main(grid)
+            if np.array_equal(out, grid):
+                continue
+            if np.array_equal(out, _wrong_global_parity(grid)):
+                continue
+            if np.array_equal(out, _blue_blocking_variant(grid)):
+                continue
+
+            for bbox in regions:
+                region = grid[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1]
+                assert np.count_nonzero(region == BLUE) == 1
+                y_count = int(np.count_nonzero(region == YELLOW))
+                assert 2 <= y_count <= 4
+
+            return grid
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid input")

