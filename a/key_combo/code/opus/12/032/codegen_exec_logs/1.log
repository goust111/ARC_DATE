+                continue
+            if r == br and c == bc:
+                continue
+            rows.append(r)
+        landing_rows[c] = rows
+
+    movers = [(int(r), int(c)) for r, c in np.argwhere(grid == YELLOW) if r0 <= r <= r1 and c0 <= c <= c1]
+    movers.sort(key=lambda rc: (-rc[0], rc[1]))
+
+    occupied: set[tuple[int, int]] = set()
+    settled: list[tuple[int, int]] = []
+    for sr, sc in movers:
+        candidates = []
+        for rr in landing_rows.get(sc, []):
