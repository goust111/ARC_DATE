+
+
+def _nonadjacent(points: list[tuple[int, int]]) -> bool:
+    for i, (r1, c1) in enumerate(points):
+        for r2, c2 in points[i + 1 :]:
+            if abs(r1 - r2) + abs(c1 - c2) == 1:
