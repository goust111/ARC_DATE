+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+YELLOW = 4
+GREY = 5
+
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _region_bboxes(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    regions = []
+    for comp in _components(grid != GREY):
+        r0, c0 = comp.min(axis=0)
+        r1, c1 = comp.max(axis=0)
+        regions.append((int(r0), int(c0), int(r1), int(c1)))
+    regions.sort()
+    return regions
+
+
+def _simulate_region(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    *,
+    blue_blocks: bool = False,
+    forced_parity: tuple[int, int] | None = None,
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    blue_cells = np.argwhere(grid[r0 : r1 + 1, c0 : c1 + 1] == BLUE)
+    assert blue_cells.shape[0] == 1
+    br, bc = map(int, blue_cells[0])
+    br += r0
+    bc += c0
