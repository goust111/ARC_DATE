+    final_positions: list[tuple[int, int]] = []
+    initial_positions: list[tuple[int, int]] = []
+    for c in sorted(parity_cols):
+        k = counts[c]
+        if not k:
+            continue
+        rows = landing_rows[c]
+        assert len(rows) >= k
+        chosen_final = rows[-k:]
+        final_positions.extend((r, c) for r in chosen_final)
