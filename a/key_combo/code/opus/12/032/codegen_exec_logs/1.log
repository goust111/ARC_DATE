+        w = rng.randint(13, 18)
+        heights = _bounded_composition(h - 2, 3, min_region_h, rng)
+        widths = [w]
+    else:
+        h = rng.randint(13, 18)
+        w = rng.randint(17, 20)
+        heights = [h]
+        widths = _bounded_composition(w - 2, 3, min_region_w, rng)
+
+    assert heights is not None and widths is not None
+    grid = np.full((sum(heights) + len(heights) - 1, sum(widths) + len(widths) - 1), BLACK, dtype=int)
+
+    r = 0
+    for i, hh in enumerate(heights):
+        if i:
+            grid[r - 1, :] = GREY
+        r += hh + (1 if i else 0)
+
+    c = 0
+    for j, ww in enumerate(widths):
+        if j:
+            grid[:, c - 1] = GREY
+        c += ww + (1 if j else 0)
+
+    regions = []
+    r0 = 0
+    for i, hh in enumerate(heights):
+        c0 = 0
+        for j, ww in enumerate(widths):
+            regions.append((r0, c0, r0 + hh - 1, c0 + ww - 1))
+            c0 += ww + 1
+        r0 += hh + 1
+    return grid, regions
+
+
+def _pick_blue(
+    bbox: tuple[int, int, int, int],
+    rng: random.Random,
+    need_cross: bool,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    upper_end = r0 + h // 2 - 1
