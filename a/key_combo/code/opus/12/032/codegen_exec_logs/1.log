+    assert blue_cells.shape[0] == 1
+    br, bc = map(int, blue_cells[0])
+    br += r0
+    bc += c0
+
+    if forced_parity is None:
+        p_r, p_c = br % 2, bc % 2
+    else:
+        p_r, p_c = forced_parity
+
+    landing_rows: dict[int, list[int]] = {}
+    for c in range(c0, c1 + 1):
+        rows = []
+        for r in range(r0, r1 + 1):
+            if r % 2 != p_r or c % 2 != p_c:
+                continue
+            if r == br and c == bc:
+                continue
+            rows.append(r)
