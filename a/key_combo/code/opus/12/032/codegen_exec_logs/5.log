+        return False
+    if len(components_mask(mask)) != 1:
+        return False
+    r0, c0, r1, c1 = bbox_coords(coords)
+    if (r0, c0) != (0, 0) or (r1, c1) != (mask.shape[0] - 1, mask.shape[1] - 1):
