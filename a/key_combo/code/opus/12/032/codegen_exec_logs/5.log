+            grey_coords = np.argwhere(patch == GREY)
+            if len(grey_coords) != 2:
+                continue
+            non_grey = patch[patch != GREY]
+            if non_grey.size != 7:
+                continue
+            fill_colors = set(map(int, non_grey))
+            if len(fill_colors) != 1:
+                continue
+            color = next(iter(fill_colors))
+            if color in {BG, GREY}:
