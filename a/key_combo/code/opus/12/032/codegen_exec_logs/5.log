+
+        grid = np.full((h, w), BG, dtype=int)
+
+        ok = True
+        for color in colors:
+            r0, c0, r1, c1 = bboxes[color]
+            mode = assignments[color]
+            mask = _generate_shape(r1 - r0 + 1, c1 - c0 + 1, transpose_mode=(mode == "transpose"))
