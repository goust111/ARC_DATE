+def _legend_origin(side: str, h: int, w: int) -> tuple[int, int]:
+    if side == "top":
+        return 0, random.randint(3, w - 6)
+    if side == "bottom":
+        return h - 3, random.randint(3, w - 6)
+    if side == "left":
+        return random.randint(3, h - 6), 0
+    if side == "right":
+        return random.randint(3, h - 6), w - 3
+    raise ValueError(side)
+
+
