+
+
+def _parse_objects(grid: np.ndarray, legends: dict[int, dict[str, object]]) -> dict[int, np.ndarray]:
+    g = np.asarray(grid, dtype=int).copy()
+    for info in legends.values():
+        for r, c in info["coords"]:
+            g[r, c] = BG
