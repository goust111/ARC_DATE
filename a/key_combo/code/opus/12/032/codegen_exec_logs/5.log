        elif mode == "mixed" and walk_options and random.random() < GEN_MIXED_WALK_PROB:
            nxt = random.choice(walk_options)
        else:
            nxt = random.choice(tuple(frontier))
        coords.add(nxt)
        current = nxt

    return coords


def _gen_pattern_count(h: int, w: int) -> int | None:
    area = h * w
