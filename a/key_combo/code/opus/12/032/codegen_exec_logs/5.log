+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+
+    legends = _find_legends(g)
+    objects = _parse_objects(g, legends)
+
+    out = g.copy()
+    for info in legends.values():
+        for r, c in info["coords"]:
+            out[r, c] = bg
+
+    for color, coords in objects.items():
+        out[coords[:, 0], coords[:, 1]] = bg
+
+    for color, coords in objects.items():
