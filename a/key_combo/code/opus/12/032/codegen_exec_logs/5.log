+    objects: dict[int, np.ndarray] = {}
+    for color in colors_present(g, exclude={BG, GREY}):
+        coords = np.argwhere(g == color)
+        if len(coords) == 0:
+            continue
+        objects[color] = coords.astype(int)
+    return objects
