+def _connected_mask(shape: tuple[int, int], area: int) -> np.ndarray | None:
+    h, w = shape
+    seed = (random.randrange(h), random.randrange(w))
+    cells = {seed}
+    frontier = set()
+    for nr, nc in neighbors4(*seed):
+        if 0 <= nr < h and 0 <= nc < w:
+            frontier.add((nr, nc))
