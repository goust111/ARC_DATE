            available.discard((nr, nc))

    draws = []
    for color, count in plan:
        draws.extend([int(color)] * int(count))
    random.shuffle(draws)

    placed = []
    for color in draws:
        if not available:
            return None
        r, c = random.choice(tuple(available))
        inp[r, c] = int(color)
        placed.append((r, c))
        reserved.add((r, c))
        for dr, dc in FOUR_NEIGHBOR_OFFSETS:
            nr, nc = r + dr, c + dc
            available.discard((nr, nc))
            reserved.add((nr, nc))
