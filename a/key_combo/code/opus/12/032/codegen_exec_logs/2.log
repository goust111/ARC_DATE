+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+DIRECTIONS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+TEMPLATE_SIZE = 5
+MAX_ATTEMPTS = 400
