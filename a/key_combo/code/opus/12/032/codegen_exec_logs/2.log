+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _monochrome_components(
+    grid: np.ndarray,
+    *,
+    exclude: set[int] | None = None,
+    connectivity: int = 4,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    blocked = set() if exclude is None else {int(v) for v in exclude}
+    seen: set[tuple[int, int]] = set()
+    out: list[dict] = []
+    neigh = _neighbors4 if connectivity == 4 else _neighbors8
+
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color in blocked or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neigh(rr, cc):
+                    if not _in_bounds((H, W), nr, nc) or (nr, nc) in seen:
+                        continue
