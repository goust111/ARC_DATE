    mid_r0 = N + 1
    out = np.full((N * N, N * N), bg, dtype=int)
    slot_owner = {}

    for st in starts:
        tile_color = None
        for lr in range(N):
            for lc in range(N):
                v = int(g[mid_r0 + lr, st + lc])
                if v == bg or v == sep:
                    continue
                assert tile_color is None or v == tile_color, "tile column must have uniform marker color"
                tile_color = v
