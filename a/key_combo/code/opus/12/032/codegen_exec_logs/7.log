+def _find_unique_marker(grid: np.ndarray) -> tuple[int, int]:
+    coords = np.argwhere(grid == RED)
+    assert coords.shape == (1, 2), "expected exactly one red marker"
+    return int(coords[0, 0]), int(coords[0, 1])
