            if _gen_edge_dist(r, c, h, w) <= SEED_EDGE_BAND and not _gen_in_bbox(r, c, core_box):
                is_corner = (r in (0, h - 1)) and (c in (0, w - 1))
                weight = SEED_BASE_WEIGHT + int(is_corner) * SEED_CORNER_EXTRA_WEIGHT
                cells.extend([(r, c)] * weight)
