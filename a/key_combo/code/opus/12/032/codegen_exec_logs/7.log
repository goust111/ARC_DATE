+    out = np.asarray(grid, dtype=int).copy()
+    marker = _find_unique_marker(out)
+    parity = (marker[0] % 2, marker[1] % 2)
+    h, w = out.shape
+
+    seen = {marker}
+    queue: deque[tuple[int, int]] = deque([marker])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _step2_neighbors(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in seen:
