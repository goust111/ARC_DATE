+def _random_connected_mask(tile_size: int, used_shapes: set[tuple[tuple[int, int], ...]]) -> np.ndarray | None:
+    max_area = min(MAX_FG_CELLS, tile_size * tile_size - 1)
+    for _ in range(300):
