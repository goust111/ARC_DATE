+            mask[r, c] = True
+
+        if not _mask_connected(mask):
+            continue
+        used_shapes.add(norm)
+        return mask
+    return None
+
+
+def _build_candidate() -> np.ndarray | None:
+    tile_size = int(TILE_SIZES[int(np.random.randint(len(TILE_SIZES)))])
+    side = 3 * tile_size + 2
