+def _grow_fragment(allowed: set[tuple[int, int]], anchor: tuple[int, int], size: int) -> set[tuple[int, int]] | None:
+    if anchor not in allowed:
+        return None
+    comp = {anchor}
+    frontier = {
+        n
+        for n in _neighbors4(*anchor)
+        if n in allowed and n not in comp
