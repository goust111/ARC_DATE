+def _legend_patch(fill: int, move: tuple[int, int]) -> np.ndarray:
+    patch = np.full((3, 3), fill, dtype=int)
+    patch[1, 1] = GREY
+    dr, dc = move
+    patch[1 + dr, 1 + dc] = GREY
+    return patch
+
