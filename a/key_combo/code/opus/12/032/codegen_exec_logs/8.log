+    ctrl_vertical = random.choice(("top", "bottom"))
+    ctrl_horizontal = random.choice(("left", "right"))
+    if ctrl_vertical == "top":
+        grid[0, c_split] = CTRL
+    else:
+        grid[h - 1, c_split] = CTRL
+    if ctrl_horizontal == "left":
+        grid[r_split, 0] = CTRL
+    else:
+        grid[r_split, w - 1] = CTRL
