+    dr, dc = move
+    cur = list(comp)
+    while True:
+        nxt = [(r + dr, c + dc) for r, c in cur]
+        ok = True
+        for nr, nc in nxt:
+            if not (0 <= nr < h and 0 <= nc < w):
+                ok = False
+                break
+            if (nr, nc) in occupied:
+                ok = False
+                break
+        if not ok:
+            break
+        cur = nxt
