+        fragments.append(
+            {
+                "coords": sorted(coords),
+                "colors": colors,
+                "dom": frag_dom_colors[idx],
+                "quad": quad,
+            }
+        )
+
+    seam = {(r_split, c_split)}
+    if any(q in occupied_quads for q in ("TL", "TR")):
+        seam.add((r_split - 1, c_split))
+    if any(q in occupied_quads for q in ("BL", "BR")):
