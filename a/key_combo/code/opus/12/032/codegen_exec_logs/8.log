+        occupied.add(pos)
+
+    by_color = {f["dom"]: f for f in matched}
+    for info in legends:
+        frag = by_color[info["fill"]]
+        moved = _slide(frag["coords"], frag["colors"], info["dir"], g.shape, occupied)
+        for pos, color in moved.items():
+            out[pos] = color
+            occupied.add(pos)
+
+    return out
