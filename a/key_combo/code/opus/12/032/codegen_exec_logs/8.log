+        if not original & moved_coords:
+            moved += 1
+    if np.array_equal(actual, np.zeros_like(actual)):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _make_input()
+        if grid is not None:
+            return grid
