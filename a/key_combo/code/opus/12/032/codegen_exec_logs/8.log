+    assert g.ndim == 2
+    h, w = g.shape
+
+    legends = _extract_legends(g)
+    assert len(legends) == 2
+    legend_mask = np.zeros((h, w), dtype=bool)
+    for info in legends:
+        r0, c0, r1, c1 = info["bbox"]
+        legend_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+
