+    while len(comp) < size and frontier:
+        nxt = random.choice(sorted(frontier))
+        frontier.remove(nxt)
+        comp.add(nxt)
+        for cand in _neighbors4(*nxt):
+            if cand in allowed and cand not in comp:
+                frontier.add(cand)
