+    assert comps
+    best = max(comps, key=len)
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in best:
+        out[r, c] = True
+    return out
+
+
+def _split_lines(controls: list[tuple[int, int]], shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    r_split = None
+    c_split = None
