    min_total = max(MIN_GAP * n_gaps, min_width - start_col - BLOCK_SIZE)
    max_total = min(MAX_GAP * n_gaps, MAX_WIDTH - start_col - BLOCK_SIZE)
    if min_total > max_total:
        return None

