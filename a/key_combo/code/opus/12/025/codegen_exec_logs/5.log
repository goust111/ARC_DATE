+def _random_partition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))
+    values = [cuts[0], *[b - a for a, b in zip(cuts, cuts[1:])], int(total) - cuts[-1]]
+    return [int(v) for v in values]
