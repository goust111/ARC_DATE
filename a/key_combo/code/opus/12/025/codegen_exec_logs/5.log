+        dirty = np.array(clean, copy=True)
+        for r, c in cells:
+            dirty[r, c] = MARKER
+        if not np.array_equal(_clean_template(dirty), clean):
+            continue
+        return {
+            "shape": (int(h), int(w)),
+            "clean": clean,
+            "dirty": dirty,
+            "marker_count": int(marker_count),
+            "marker_cells": tuple(cells),
+        }
+    return None
