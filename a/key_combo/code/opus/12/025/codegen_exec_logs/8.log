+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
