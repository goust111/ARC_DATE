+def _connected(mask: np.ndarray) -> bool:
+    points = np.argwhere(mask)
+    if points.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, points[0]))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
