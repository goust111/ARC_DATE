+    left_bg = {(r, c) for r in range(top_h) for c in range(panel_w) if int(left[r, c]) == BACKGROUND}
+    right_bg = {(r, c) for r in range(top_h) for c in range(panel_w) if int(right[r, c]) == BACKGROUND}
