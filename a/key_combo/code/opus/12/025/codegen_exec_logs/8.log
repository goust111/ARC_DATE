+    available = list(targets)
+    for obj in objects:
+        if not available:
+            continue
+        center = _bbox_center(obj["coords"])
+        ranked = sorted(
+            available,
+            key=lambda target: (
+                abs(center[0] - target[0]) + abs(center[1] - target[1]),
+                target[0],
+                target[1],
+            ),
+        )
+        for target in ranked:
+            shift = np.array([target[0] - center[0], target[1] - center[1]], dtype=int)
+            moved = obj["coords"] + shift
+            if (
+                moved[:, 0].min() < 0
