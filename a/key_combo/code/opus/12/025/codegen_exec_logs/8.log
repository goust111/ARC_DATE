+def _find_components(grid: np.ndarray, bg: int = BACKGROUND) -> list[dict]:
+    comps: list[dict] = []
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            cells = []
+            while stack:
