+def _place_bottom_objects(
+    bottom_h: int,
+    bottom_w: int,
+    rng: random.Random,
+) -> np.ndarray | None:
+    bottom = np.zeros((bottom_h, bottom_w), dtype=int)
+    existing: set[tuple[int, int]] = set()
+    colors = list(rng.sample(OBJECT_COLORS, len(OBJECT_AREAS)))
