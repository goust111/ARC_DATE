+def _make_top_masks(
+    panel_h: int,
+    panel_w: int,
+    targets: list[tuple[int, int]],
+    rng: random.Random,
+) -> tuple[np.ndarray, np.ndarray] | None:
+    target_set = set(targets)
+    total = panel_h * panel_w
+    cells = [(r, c) for r in range(panel_h) for c in range(panel_w) if (r, c) not in target_set]
+    for _ in range(200):
