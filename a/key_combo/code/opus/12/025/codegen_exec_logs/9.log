+    rod_count = random.choice([1, 1, 2])
+    random.shuffle(candidates)
+    by_orientation = {"h": [c for c in candidates if c["orientation"] == "h"], "v": [c for c in candidates if c["orientation"] == "v"]}
+
+    for _ in range(120):
