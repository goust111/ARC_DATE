+                                        "final_comp": final_comp,
+                                        "input_orig": input_orig,
+                                        "final_orig": final_orig,
+                                        "envelope_orig": input_orig | final_orig,
+                                        "endpoint_comp": endpoint,
+                                        "hinge_comp": (r, c),
+                                        "tail_len": tail_len,
