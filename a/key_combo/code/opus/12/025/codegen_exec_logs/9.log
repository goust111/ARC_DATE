+    rods = _choose_rods(candidates)
+    if rods is None:
+        return None
+
+    inp = _render_input(base, row_to_orig, col_to_orig, (total_h, total_w), rods)
+    expected = _expected_output(base, rods)
+    return inp if _semantic_ok(inp, expected, rods) else None
