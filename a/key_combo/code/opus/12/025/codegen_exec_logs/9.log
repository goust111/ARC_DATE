+
+ROD_COLOR = 6
+HINGE_COLOR = 4
+ENDPOINT_COLOR = 9
+FILLER_A = 5
+FILLER_B = 7
+ROD_PALETTE = {ROD_COLOR, HINGE_COLOR, ENDPOINT_COLOR}
+HIDDEN_COLOR_POOL = [0, 1, 2, 3, 8]
+MAX_GENERATION_ATTEMPTS = 600
