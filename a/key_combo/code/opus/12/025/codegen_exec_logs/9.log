            out[p] = RED
        for p in rec["tail"]:
            inp[p] = RED
        for p in rec["folded"]:
            out[p] = RED
    return inp, out


def _place_records(n: int, rod_count: int) -> list[Record] | None:
    """Sample non-touching rods and their fold envelopes for one grid."""
    blocked: set[tuple[int, int]] = set()
    records: list[Record] = []
