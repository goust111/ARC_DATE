+            pool = by_orientation[orient] or candidates
+            pools.append(random.sample(pool, min(len(pool), 40)))
+        ok = True
+        for pool in pools:
+            found = None
+            random.shuffle(pool)
+            for candidate in pool:
+                if _compatible(candidate, chosen):
+                    found = candidate
+                    break
+            if found is None:
+                ok = False
+                break
+            chosen.append(found)
+        if ok:
