+
+def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < QUADRANT_SIZE and 0 <= cc < QUADRANT_SIZE:
+            out.append((rr, cc))
