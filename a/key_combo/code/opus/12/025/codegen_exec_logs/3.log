+def _symmetry_transform(cell: tuple[int, int], rot: int, flip: bool) -> tuple[int, int]:
+    r, c = cell
+    for _ in range(rot):
+        r, c = c, 2 - r
+    if flip:
+        c = 2 - c
+    return r, c
