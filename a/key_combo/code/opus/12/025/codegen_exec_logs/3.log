+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if not coords:
+        return False
+    seen = {coords[0]}
+    q = deque([coords[0]])
+    while q:
+        cell = q.popleft()
+        for nxt in _neighbors4(cell):
