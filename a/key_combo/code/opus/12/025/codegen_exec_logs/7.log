+        cc = left + int(pc)
+        if not (0 <= rr < canvas.shape[0] and 0 <= cc < canvas.shape[1]):
+            return True
+        r0 = max(0, rr - padding)
+        r1 = min(canvas.shape[0], rr + padding + 1)
+        c0 = max(0, cc - padding)
+        c1 = min(canvas.shape[1], cc + padding + 1)
