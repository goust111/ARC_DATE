+        cc = left + int(pc)
+        if not (0 <= rr < canvas.shape[0] and 0 <= cc < canvas.shape[1]):
+            return True
+        r0 = max(0, rr - padding)
+        r1 = min(canvas.shape[0], rr + padding + 1)
+        c0 = max(0, cc - padding)
+        c1 = min(canvas.shape[1], cc + padding + 1)
+        if np.any(canvas[r0:r1, c0:c1] != 0):
+            return True
+    return False
+
+
+def _center_row_in_half(top: int, patch_h: int, size: int, half: str) -> bool:
+    row = top + (patch_h - 1) // 2
+    return row < size // 2 if half == "top" else row >= size // 2
+
+
+def _candidate_positions(
+    canvas: np.ndarray,
+    patch: np.ndarray,
+    half: str | None,
+    *,
+    touch_border: bool,
