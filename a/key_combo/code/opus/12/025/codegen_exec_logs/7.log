+    for r in range(h):
+        border_color = int(a_obj["color"]) if r < mid else int(b_obj["color"])
+        for c in (0, w - 1):
+            if (r, c) not in protected:
+                out[r, c] = border_color
+    for c in range(w):
+        for r in (0, h - 1):
+            border_color = int(a_obj["color"]) if r < mid else int(b_obj["color"])
+            if (r, c) not in protected:
+                out[r, c] = border_color
