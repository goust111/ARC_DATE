+    border_positions = []
+    other_positions = []
+    for top in range(size - h + 1):
+        if half is not None and not _center_row_in_half(top, h, size, half):
+            continue
+        for left in range(size - w + 1):
+            if _touches_forbidden(canvas, patch, top, left):
+                continue
+            on_border = top == 0 or left == 0 or top + h == size or left + w == size
+            if on_border:
