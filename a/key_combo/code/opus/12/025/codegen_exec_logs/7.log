+    size = canvas.shape[0]
+    h, w = patch.shape
+    border_positions = []
+    other_positions = []
+    for top in range(size - h + 1):
+        if half is not None and not _center_row_in_half(top, h, size, half):
+            continue
+        for left in range(size - w + 1):
+            if _touches_forbidden(canvas, patch, top, left):
+                continue
+            on_border = top == 0 or left == 0 or top + h == size or left + w == size
+            if on_border:
+                border_positions.append((top, left))
+            else:
+                other_positions.append((top, left))
+    if touch_border:
+        return border_positions + other_positions
+    return other_positions + border_positions
+
+
+def _place_patch(
+    canvas: np.ndarray,
+    patch: np.ndarray,
