+    touch_border_idx = random.choice([None, 0, 1]) if random.random() < 0.55 else None
+
+    for idx, half in [
+        (0, "top" if larger_in_top else "bottom"),
+        (1, "bottom" if larger_in_top else "top"),
+    ]:
+        border_side = None
+        if half == "top":
