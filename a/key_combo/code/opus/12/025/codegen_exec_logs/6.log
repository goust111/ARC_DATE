    return True


def _gen_build_objects(n_rim, n_dist, height, width):
    objects = []
    for _ in range(n_rim):
        obj = _gen_make_rim_object(height, width)
        if obj is None:
            return None
        objects.append(obj)
    for _ in range(n_dist):
        obj = _gen_make_distractor_object(height, width)
        if obj is None:
