+    out[cross_r + 1 :, :cross_c] = out_quadrants[2]
+    out[cross_r + 1 :, cross_c + 1 :] = out_quadrants[3]
+    out[cross_r, :] = SEPARATOR
+    out[:, cross_c] = SEPARATOR
