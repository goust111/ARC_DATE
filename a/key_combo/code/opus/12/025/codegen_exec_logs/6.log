            minority = random.choice(choices)
        r0 = SEP + br * (BLOCK_H + SEP)
        c0 = SEP + bc * (BLOCK_W + SEP)
        grid[r0 : r0 + BLOCK_H, c0 : c0 + BLOCK_W] = _render_block(majority, minority, noise_count)
    return grid


