+        mask[idx // COMPRESSED_SIZE, idx % COMPRESSED_SIZE] = True
+    return mask
+
+
+def _render_content_quadrant(pattern: np.ndarray, noise_mask: np.ndarray) -> np.ndarray:
+    quadrant = np.zeros((QUADRANT_SIZE, QUADRANT_SIZE), dtype=int)
