+def _most_common_color(values: np.ndarray) -> int:
+    counts = Counter(int(v) for v in values.ravel())
+    color, freq = counts.most_common(1)[0]
+    assert list(counts.values()).count(freq) == 1, "expected a unique majority color"
+    return int(color)
