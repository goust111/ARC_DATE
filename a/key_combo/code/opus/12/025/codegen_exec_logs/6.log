    counts = _gen_hole_counts_by_blue_object(grid)
    if counts is None or len(counts) != n_rim + n_dist:
        return False
    if any(count not in (0, 1) for count in counts):
        return False
    if sum(counts) != n_rim:
        return False
    try:
