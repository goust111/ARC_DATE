+    if random.random() < 0.8 and np.array_equal(mask_a, mask_b):
+        return None
+
+    inp = _build_scene(diag_name, pattern, mask_a, mask_b)
+    try:
+        out = main(inp)
+        _validate_output(inp, out)
+    except Exception:
+        return None
+    return inp
+
+
