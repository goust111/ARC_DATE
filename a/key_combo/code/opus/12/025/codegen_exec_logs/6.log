+    assert q == cross_c == grid.shape[0] - cross_r - 1 == grid.shape[1] - cross_c - 1
+    return [
+        grid[:cross_r, :cross_c].copy(),
+        grid[:cross_r, cross_c + 1 :].copy(),
+        grid[cross_r + 1 :, :cross_c].copy(),
+        grid[cross_r + 1 :, cross_c + 1 :].copy(),
+    ]
