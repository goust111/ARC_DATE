+def shifted_bbox(rect: dict, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    dr, dc = rect_shift(rect, shape)
+    r0, c0, r1, c1 = rect["input_bbox"]
+    return r0 + dr, c0 + dc, r1 + dr, c1 + dc
