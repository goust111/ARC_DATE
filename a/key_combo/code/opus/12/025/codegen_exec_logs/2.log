+def _parse_rectangles(grid: np.ndarray) -> list[dict]:
+    comps = find_color_components(grid, set(RECT_COLORS))
+    assert 4 <= len(comps) <= 6
+    rects: list[dict] = []
+    h, w = grid.shape
+    for comp in comps:
+        bbox = comp["bbox"]
+        r0, c0, r1, c1 = bbox
+        rh = r1 - r0 + 1
+        rw = c1 - c0 + 1
