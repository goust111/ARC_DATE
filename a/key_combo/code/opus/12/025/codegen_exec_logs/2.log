+    return comps
+
+
+def bbox_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+
+
+def bbox_contains(bbox: tuple[int, int, int, int], cell: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    r, c = cell
