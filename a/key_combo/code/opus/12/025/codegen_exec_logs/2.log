+    br0, bc0, br1, bc1 = b
+    return not (ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0)
+
+
+def rect_shift(rect: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = rect["size"]
+    r0, c0, r1, c1 = rect["input_bbox"]
+    grid_h, grid_w = shape
+    dr = 0
+    dc = 0
+    if r0 == 0:
