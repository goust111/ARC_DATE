+    blocked_markers: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    out = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            cell = (r, c)
+            if any(bbox_contains(bbox, cell) for bbox in blocked_bboxes):
