+    count: int,
+    blocked: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    cells = [cell for cell in bbox_cells(bbox) if cell not in blocked]
+    valid = []
+    for combo in itertools.combinations(cells, count):
+        ok = True
+        for a, b in itertools.combinations(combo, 2):
