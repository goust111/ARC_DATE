  grid: 13-14 rows x 12-15 cols
  colors:
    bg: 0 [observed]
    dense: 1 [observed]
    marker: 8 [observed]
  objects:
    count: 6-7 solid rectangles (100% fill)
    height: 2-4
    width: 2-6
    pixels: each cell is dense or marker color
    marker_per_object: 0-4; kept objects have 0 or 1, removed have 2-4
    separation: min Chebyshev distance >= 2 between any two objects
    may_touch_border: true
  transform:
    rule: erase (set to bg) every object containing >= 2 marker pixels
    kept_count: 3 [observed]
    removed_count: 3-4
    both_kept_and_removed: required
  totals:
    marker_pixels: 9-14
    dense_to_marker_ratio: 4-8x [observed]

generation_strategy:
