+
+def _cell_options_with_gap(bbox: tuple[int, int, int, int], blocked: set[tuple[int, int]], margin: int) -> list[tuple[int, int]]:
+    choices = []
+    for cell in bbox_cells(bbox):
+        if cell in blocked:
+            continue
+        ok = True
+        for br, bc in blocked:
+            if abs(cell[0] - br) + abs(cell[1] - bc) <= margin:
