+def _random_bbox(kind: str, size: tuple[int, int], shape: tuple[int, int], rng: random.Random):
+    h, w = size
+    grid_h, grid_w = shape
+    if kind == "top":
+        if grid_w - w - 2 < 1:
+            return None
+        return 0, rng.randint(1, grid_w - w - 2), h - 1, rng.randint(1, grid_w - w - 2) + w - 1
+    if kind == "bottom":
