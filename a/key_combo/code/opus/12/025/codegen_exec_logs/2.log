+    if kind == "bl":
+        return grid_h - h, 0, grid_h - 1, w - 1
+    if kind == "br":
+        return grid_h - h, grid_w - w, grid_h - 1, grid_w - 1
+    return None
+
+
+def _candidate_bbox(kind: str, size: tuple[int, int], shape: tuple[int, int], rng: random.Random):
+    if kind in {"top", "bottom", "left", "right"}:
+        for _ in range(20):
