+        fr0, fc0, fr1, fc1 = final_bbox
+        assert 0 <= fr0 <= fr1 < h and 0 <= fc0 <= fc1 < w
+        overlap = occupied[fr0 : fr1 + 1, fc0 : fc1 + 1] != 0
+        assert not bool(overlap.any())
+        occupied[fr0 : fr1 + 1, fc0 : fc1 + 1] = int(rect["color"])
