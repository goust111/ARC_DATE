+def rect_shift(rect: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = rect["size"]
+    r0, c0, r1, c1 = rect["input_bbox"]
+    grid_h, grid_w = shape
+    dr = 0
+    dc = 0
+    if r0 == 0:
+        dr += h
+    if r1 == grid_h - 1:
+        dr -= h
+    if c0 == 0:
+        dc += w
+    if c1 == grid_w - 1:
+        dc -= w
+    return dr, dc
