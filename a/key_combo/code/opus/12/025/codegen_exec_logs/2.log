+import numpy as np
+
+
+BG = 0
+MARKER = 6
+RECT_COLORS = (1, 2, 3, 4, 7)
+DIM_OPTIONS = (
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+    (4, 2),
+    (2, 4),
+    (4, 3),
+    (3, 4),
+)
+PLACEMENT_KINDS = ("top", "bottom", "left", "right", "tl", "tr", "bl", "br")
+GEN_RETRIES = 1000
