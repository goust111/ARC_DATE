+def _target_region_id(region: dict, fold_dir: str, pos_to_id: dict[tuple[int, int], int]) -> int | None:
+    ri, cj = int(region["ri"]), int(region["cj"])
+    if fold_dir == "up":
+        return pos_to_id.get((ri - 1, cj))
+    if fold_dir == "down":
+        return pos_to_id.get((ri + 1, cj))
+    if fold_dir == "left":
+        return pos_to_id.get((ri, cj - 1))
+    return pos_to_id.get((ri, cj + 1))
