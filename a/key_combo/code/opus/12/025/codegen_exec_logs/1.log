+def _conflict_profile(chosen: list[dict]) -> tuple[dict[int, int], int]:
+    counts: dict[int, int] = Counter(int(c["target_region_id"]) for c in chosen)
+    twice = sum(1 for v in counts.values() if int(v) == 2)
+    return counts, int(twice)
