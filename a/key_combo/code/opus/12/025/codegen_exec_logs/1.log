+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+REGION_COLORS = (BLUE, RED, GREEN, YELLOW, ORANGE, TEAL)
+FOLD_DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+MAX_GEN_ATTEMPTS = 400
