+                        candidate = {
+                            "source_region_id": int(region["id"]),
+                            "source_color": int(region["color"]),
+                            "source_area": int(region["area"]),
+                            "target_region_id": int(target_id),
+                            "orientation": "v",
+                            "endpoint": endpoint,
+                            "hinge": hinge,
