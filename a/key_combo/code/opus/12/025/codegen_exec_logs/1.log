+                        if not want_conflict and any(v > 1 for v in target_counts.values()):
+                            continue
+                        if want_conflict and len(trial) == desired_count and twice != 1:
+                            continue
+                        chosen.append(cand)
+                        used_sources.add(source_id)
+                        occupied |= set(cand["output_cells"])
+                        break
