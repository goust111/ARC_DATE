+        diff_hits = [ctrl for ctrl in path if int(ctrl["color"]) != int(slider["color"])]
+        if len(diff_hits) > 1:
+            return False
+
+        first_diff = diff_hits[0] if diff_hits else None
+        same_before = []
+        for ctrl in path:
+            if first_diff is not None and ctrl["row"] == first_diff["row"]:
+                break
+            if int(ctrl["color"]) == int(slider["color"]):
