def _frame_origins_for_axis(axis_len: int) -> list[int]:
    return [pos for pos in range(axis_len - FRAME_SIZE + 1) if pos <= FRAME_MARGIN_MAX and axis_len - FRAME_SIZE - pos <= FRAME_MARGIN_MAX]


