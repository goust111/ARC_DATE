            if (
                VISIBLE_STAMP_MIN <= total <= VISIBLE_STAMP_MAX
                and chain_a >= MIN_CHAIN_STAMPS
                and chain_b >= MIN_CHAIN_STAMPS
            ):
                opts.append((r0, c0))
    return opts


