+        indices: list[int] = []
+        if direction == "left":
+            indices = [
+                idx
+                for idx, col in enumerate(chosen)
+                if idx > 0 and col <= width - 1 - col
+            ]
+        else:
+            indices = [
+                idx
+                for idx, col in enumerate(chosen)
+                if idx < count - 1 and col > width - 1 - col
+            ]
