def _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:
    r0, c0, r1, c1 = bbox
    h, w = shape
    sides = []
    if r0 == 0:
        sides.append("top")
    if r1 == h - 1:
        sides.append("bottom")
    if c0 == 0:
        sides.append("left")
    if c1 == w - 1:
