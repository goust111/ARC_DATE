+
+
+def _slider_cells(slider: dict) -> list[tuple[int, int]]:
+    return [
+        (r, c)
+        for r in range(int(slider["r0"]), int(slider["r1"]) + 1)
+        for c in range(int(slider["c0"]), int(slider["c1"]) + 1)
+    ]
+
+
+def _band_hits_box(slider: dict, box: tuple[int, int, int, int]) -> bool:
