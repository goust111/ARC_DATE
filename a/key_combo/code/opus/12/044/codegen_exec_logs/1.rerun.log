+
+def _interior_coords(box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    cells = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+    return np.array(cells, dtype=int)
