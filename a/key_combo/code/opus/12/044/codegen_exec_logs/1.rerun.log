+
+
+def _hit_candidates(frame: dict, shape: tuple[int, int]) -> list[dict]:
+    h, w = shape
+    r0, c0, r1, c1 = frame["interior"]
+    ih = r1 - r0 + 1
+    iw = c1 - c0 + 1
+    out: list[dict] = []
+
