+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+SLIDER_COLORS = (BLUE, GREEN, YELLOW, ORANGE)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDES = ("top", "bottom", "left", "right")
+
+FRAME_SIZE_RANGE = (4, 5)
+FRAME_GAP = 2
+FRAME_MARGIN = 2
+GRID_MIN = 18
+GRID_MAX = 30
+GEN_ATTEMPTS = 500
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _edge_side(box: tuple[int, int, int, int], shape: tuple[int, int]) -> str:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    sides = []
+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    assert len(sides) == 1, "each slider must touch exactly one outer edge"
+    return sides[0]
+
+
+def _exterior_background(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    def add(r: int, c: int) -> None:
+        if grid[r, c] == BLACK and not exterior[r, c]:
+            exterior[r, c] = True
+            q.append((r, c))
+
+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w:
+                add(nr, nc)
+
+    return exterior
+
+
+def _enclosed_regions(grid: np.ndarray) -> list[np.ndarray]:
+    enclosed = (grid == BLACK) & ~_exterior_background(grid)
+    return _components(enclosed)
+
+
+def _detect_sliders(grid: np.ndarray) -> list[dict]:
