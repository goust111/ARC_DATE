        for frame in frames
    }
    actual_sets = [{tuple(cell) for cell in region} for region in regions]
    if sorted(actual_sets, key=len) != sorted(expected.values(), key=len):
        return False

    open_interior = {tuple(cell) for cell in _interior_coords(open_box)}
    return all(open_interior != region_set for region_set in actual_sets)


def _independent_expected(grid: np.ndarray, frames: list[dict], intended_hits: dict[int, int]) -> np.ndarray:
    out = grid.copy()
    out[(out != BLACK) & (out != RED)] = BLACK
