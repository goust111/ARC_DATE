+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+SLIDER_COLORS = (BLUE, GREEN, YELLOW, ORANGE)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDES = ("top", "bottom", "left", "right")
+
+FRAME_SIZE_RANGE = (4, 5)
+FRAME_GAP = 2
+FRAME_MARGIN = 2
