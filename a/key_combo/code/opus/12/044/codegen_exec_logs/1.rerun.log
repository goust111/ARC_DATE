        color = intended_hits.get(int(frame["id"]))
        if color is None:
            continue
        r0, c0, r1, c1 = frame["interior"]
        out[r0 : r1 + 1, c0 : c1 + 1] = color
    return out


def _attempt() -> np.ndarray | None:
    made = _make_layout()
    if made is None:
