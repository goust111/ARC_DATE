+        if frame_idx not in matched_frames and np.any(box != BACKGROUND):
+            return False
+    if np.any(out[(expected == BACKGROUND)] != BACKGROUND):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
