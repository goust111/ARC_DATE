import random

BBox = tuple[int, int, int, int]


def _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:
    r0, c0, r1, c1 = bbox
    h, w = shape
    sides = []
    if r0 == 0:
        sides.append("top")
    if r1 == h - 1:
        sides.append("bottom")
    if c0 == 0:
        sides.append("left")
    if c1 == w - 1:
        sides.append("right")
    assert len(sides) == 1, "each black rectangle must touch exactly one grid edge"
    return sides[0]


def main(grid: np.ndarray) -> np.ndarray:
