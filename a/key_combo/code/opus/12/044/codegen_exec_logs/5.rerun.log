+    visible_order = tuple(sorted(range(4), key=lambda idx: visible_counts[idx], reverse=True))
+    raw_order = tuple(sorted(range(4), key=lambda idx: raw_counts[idx], reverse=True))
+    if visible_order == raw_order:
