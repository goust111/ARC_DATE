+            path.append((r, c))
+        while c != cc:
+            c += 1 if cc > c else -1
+            path.append((r, c))
+    else:
+        while c != cc:
+            c += 1 if cc > c else -1
+            path.append((r, c))
+        while r != rr:
+            r += 1 if rr > r else -1
+            path.append((r, c))
+    return path
