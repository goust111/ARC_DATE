  grid: 10x10 (2x2 arrangement of 5x5 panels) [observed constant]
  background: 0
  panels:
    layout: upper-left, upper-right, lower-left, lower-right quadrants
    colors: each panel has exactly 1 distinct foreground color; all 4 are distinct
    fixed_assignment: UL=4(yellow), UR=3(green), LL=9(maroon), LR=8(azure) [observed]
    fg_cell_count: 8-17 per panel (density 0.32-0.68)
    connectivity: 1-6 connected components per panel (random scatter, not single blob)
