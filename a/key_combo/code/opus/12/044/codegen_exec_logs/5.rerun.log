+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc]:
+                cell = (rr, cc)
+                if cell not in seen:
+                    seen.add(cell)
+                    q.append(cell)
