+BG = 5
+MARKER_COLORS = (6, 9)
+BODY_COLORS = (1, 2, 3, 4, 7)
+SIDES = ("T", "B", "L", "R")
+OPPOSITE = {"T": "B", "B": "T", "L": "R", "R": "L"}
+SIDE_DIR = {"T": (-1, 0), "B": (1, 0), "L": (0, -1), "R": (0, 1)}
+TYPE_HOLLOW = "hollow"
+TYPE_SOLID = "solid"
+MAX_GEN_ATTEMPTS = 400
