+
+    spec: list[tuple[str, int]] = []
+    if scenario == "one_pair":
+        pair_kind = random.choice((TYPE_HOLLOW, TYPE_SOLID))
+        other_kind = TYPE_SOLID if pair_kind == TYPE_HOLLOW else TYPE_HOLLOW
+        spec.extend([(pair_kind, pair_a), (pair_kind, pair_a)])
