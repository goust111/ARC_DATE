+    if r == 0:
+        sides.append("T")
+    if r == h - 1:
+        sides.append("B")
+    if c == 0:
+        sides.append("L")
+    if c == w - 1:
+        sides.append("R")
+    assert len(sides) == 1, "marker must lie on exactly one border side"
+    return sides[0]
