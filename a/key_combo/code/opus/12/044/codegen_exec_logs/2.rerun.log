+        sides.append("T")
+    if r == h - 1:
+        sides.append("B")
+    if c == 0:
+        sides.append("L")
+    if c == w - 1:
+        sides.append("R")
+    assert len(sides) == 1, "marker must lie on exactly one border side"
+    return sides[0]
+
+
+def side_coord(side: str, offset: int) -> tuple[int, int]:
+    if side == "T":
+        return 0, offset
+    if side == "B":
+        return 3, offset
+    if side == "L":
+        return offset, 0
+    return offset, 3
