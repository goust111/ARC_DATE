+    bg = get_bg(g)
+    objects = analyze_objects(g)
+    hollow_items = build_items(objects, TYPE_HOLLOW, bg)
+    solid_items = build_items(objects, TYPE_SOLID, bg)
+    return stack_columns(hollow_items, solid_items, bg)
