+    actual_counts = Counter((obj["kind"], obj["marker_color"]) for obj in objects)
+    plan_counts = Counter((obj["kind"], obj["marker_color"]) for obj in plans)
+    if actual_counts != plan_counts:
+        return False
+    return True
