+def _glyph_patch(color: int, direction: tuple[int, int]) -> np.ndarray:
+    patch = np.zeros((3, 3), dtype=int)
+    patch[0, 0] = color
+    patch[0, 2] = color
+    patch[2, 0] = color
+    patch[2, 2] = color
+    mr, mc = DIR_TO_MARKER[direction]
+    patch[mr, mc] = color
+    return patch
