    r1 = min(_GEN_N, int(coords[:, 0].max()) + padding + 1)
    c0 = max(0, int(coords[:, 1].min()) - padding)
    c1 = min(_GEN_N, int(coords[:, 1].max()) + padding + 1)
    return not existing[r0:r1, c0:c1].any()


def _gen_merged_pair(existing, h1, w1, h2, w2):
