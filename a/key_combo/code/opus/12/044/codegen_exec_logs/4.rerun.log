+                neighs = [
+                    (nr, nc)
+                    for nr, nc in ((br - 1, bc), (br + 1, bc), (br, bc - 1), (br, bc + 1))
+                    if _in_bounds(wallpaper.shape, nr, nc) and int(wallpaper[nr, nc]) != BLACK
+                ]
