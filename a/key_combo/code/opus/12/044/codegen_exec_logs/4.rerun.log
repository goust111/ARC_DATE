+GEN_HEIGHT_RANGE = (14, 19)
+GEN_WIDTH_RANGE = (14, 19)
+GEN_PERIOD_RANGE = (3, 6)
+GEN_TILE_ATTEMPTS = 150
+GEN_ERASE_ATTEMPTS = 120
+GEN_PAIR_SAMPLES = 260
+GEN_ATTEMPTS = 320
