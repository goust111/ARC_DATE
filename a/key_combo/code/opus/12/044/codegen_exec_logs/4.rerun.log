+def _has_smaller_period(tile: np.ndarray) -> bool:
+    rp, cp = tile.shape
+    for p in range(1, rp):
+        if np.array_equal(tile, tile[np.arange(rp)[:, None] % p, np.arange(cp)[None, :]]):
+            return True
+    for q in range(1, cp):
+        if np.array_equal(tile, tile[np.arange(rp)[:, None], np.arange(cp)[None, :] % q]):
+            return True
+    return False
