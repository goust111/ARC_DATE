+def _single_coord(grid: np.ndarray, color: int) -> tuple[int, int]:
+    pts = np.argwhere(grid == color)
+    assert len(pts) == 1, f"expected exactly one {color}-cell"
+    return int(pts[0, 0]), int(pts[0, 1])
