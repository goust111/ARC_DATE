+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+WALL_COLORS = (4, 6, 7, 8, 9)
+MARKER_COLORS = {BLUE, RED}
+SPECIAL_INPUT_COLORS = {BLACK, BLUE, RED}
+DIRS8 = [
+    (-1, 0),   # up
+    (-1, 1),   # up-right
+    (0, 1),    # right
+    (1, 1),    # down-right
+    (1, 0),    # down
