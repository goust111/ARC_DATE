+        return None
+    wallpaper = _wallpaper_from_tile(tile, (h, w))
+    row_period, col_period = tile.shape
+
+    erased_cells = _sample_erased_cells(wallpaper, row_period, col_period, rng)
+    if erased_cells is None:
