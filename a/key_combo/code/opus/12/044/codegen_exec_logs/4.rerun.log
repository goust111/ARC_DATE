+
+    walkable = wallpaper == BLACK
+    walkable[start] = True
+    walkable[goal] = True
+    path = _lex_shortest_path(walkable, start, goal)
+    assert path is not None, "markers must be connected through background"
+
+    out = wallpaper.copy()
+    for r, c in path[1:-1]:
+        out[r, c] = GREEN
+    out[start] = BLUE
+    out[goal] = RED
+    return out
