0016: def main(grid: np.ndarray) -> np.ndarray:
0017:     """
0018:     Connect the blue marker to the red marker with a green shortest king-move path.
0019: 
0020:     Input structure
0021:     - A mostly background grid contains exactly one blue pixel and one red pixel.
0022:     - The marker pixels are separated in both row and column.
0023: 
0024:     Rule
0025:     - Preserve the input pixels.
0026:     - Starting next to the blue pixel, paint green diagonal steps toward the red
0027:       pixel until one diagonal step remains.
0028:     - Paint the remaining straight middle run along the longer axis, leaving the
0029:       final diagonal step into the red pixel unpainted.
0030: 
0031:     Key insight
0032:     - The path is a Chebyshev-shortest route whose straight segment absorbs the
0033:       unequal row and column distances between the two markers.
0034:     """
0035:     g = np.asarray(grid, dtype=int)
0036:     bg = int(get_bg(g))
0037:     assert set(map(int, np.unique(g))) - {bg} == {Color.BLUE, Color.RED}, "expected only blue and red markers"
0038: 
0039:     blue_r, blue_c = _single_coord(g, Color.BLUE)
0040:     red_r, red_c = _single_coord(g, Color.RED)
0041: 
0042:     step_r = _sign(red_r - blue_r)
0043:     step_c = _sign(red_c - blue_c)
0044:     row_dist = abs(red_r - blue_r)
0045:     col_dist = abs(red_c - blue_c)
0046:     assert row_dist > 0 and col_dist > 0, "markers must differ in both row and column"
0047:     assert row_dist != col_dist, "path must have one longer axis"
0048: 
0049:     out = g.copy()
0050:     r, c = blue_r, blue_c
0051: 
0052:     for _ in range(min(row_dist, col_dist) - 1):
0053:         r += step_r
0054:         c += step_c
0055:         assert int(out[r, c]) == bg, "path must cross only background cells"
0056:         out[r, c] = Color.GREEN
0057: 
0058:     if row_dist > col_dist:
0059:         for _ in range(row_dist - col_dist):
0060:             r += step_r
0061:             assert int(out[r, c]) == bg, "path must cross only background cells"
0062:             out[r, c] = Color.GREEN
0063:     else:
0064:         assert col_dist > row_dist
0065:         for _ in range(col_dist - row_dist):
0066:             c += step_c
0067:             assert int(out[r, c]) == bg, "path must cross only background cells"
0068:             out[r, c] = Color.GREEN
0069: 
0070:     assert (r + step_r, c + step_c) == (red_r, red_c), "path must end one diagonal step before red"
0071:     return out
