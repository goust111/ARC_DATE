+def _pair_indices(n: int, rng: np.random.Generator, limit: int) -> list[tuple[int, int]]:
+    all_pairs = n * (n - 1) // 2
+    if all_pairs <= limit:
+        pairs = [(i, j) for i in range(n) for j in range(i + 1, n)]
+        rng.shuffle(pairs)
