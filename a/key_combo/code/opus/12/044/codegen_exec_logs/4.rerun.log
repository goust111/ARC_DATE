+
+
+def _count_shortest_paths(
+    walkable: np.ndarray, start: tuple[int, int], goal: tuple[int, int], cap: int = 2
+) -> int:
+    dist, order = _dist_and_order(walkable, start)
+    if dist[goal] < 0:
+        return 0
+    ways = np.zeros(walkable.shape, dtype=int)
+    ways[start] = 1
