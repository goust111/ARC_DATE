+    walk_clean = wallpaper == BLACK
+    walk_erased = erased_wallpaper == BLACK
+    restored_as_obstacle = (wallpaper != BLACK) & (erased_wallpaper == BLACK)
+    bg_cells = [tuple(map(int, rc)) for rc in np.argwhere(walk_clean)]
+    if len(bg_cells) < 2:
+        return None
+
