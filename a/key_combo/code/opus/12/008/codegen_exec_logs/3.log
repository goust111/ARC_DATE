+
+
+def _interior_frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    if not mask.any():
+        return [(r, c) for r in range(BLOCK_SIZE) for c in range(1, BLOCK_SIZE - 1)]
+
+    candidates = []
+    for r in range(BLOCK_SIZE):
+        for c in range(1, BLOCK_SIZE - 1):
+            if mask[r, c]:
