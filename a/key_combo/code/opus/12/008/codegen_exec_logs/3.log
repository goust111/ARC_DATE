+BG = 0
+FG = 5
+BLOCK_SIZE = 5
+LEGEND_HEIGHT = 3
+CHAIN_GAP = 1
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 600
+MAX_MASK_ATTEMPTS = 120
