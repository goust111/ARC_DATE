+def _edge_rows(block: np.ndarray, side: str) -> set[int]:
+    if side == "left":
+        return set(np.where(block[:, 0] != BG)[0].tolist())
+    if side == "right":
+        return set(np.where(block[:, -1] != BG)[0].tolist())
+    raise ValueError(f"unknown side: {side}")
