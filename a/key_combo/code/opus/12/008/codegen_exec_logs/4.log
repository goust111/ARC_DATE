    return MIRROR_ORBIT_SINGLE_WEIGHT if c == w - 1 - c else MIRROR_ORBIT_PAIR_WEIGHT


def _gen_half_area(half: np.ndarray, w: int) -> int:
    weights = np.array([_gen_orbit_weight(c, w) for c in range(half.shape[1])], dtype=int)
