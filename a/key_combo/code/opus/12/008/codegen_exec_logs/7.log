import random, numpy as np
from collections import Counter

def make_positions(H,W,n):
    m=random.randint(2,4)
    j=lambda lo,hi: random.randint(lo,hi)
    anchors=[
        (m, j(m+1, W-m-2)),
        (H-1-m, j(m+1, W-m-2)),
        (j(m+1, H-m-2), m),
        (j(m+1, H-m-2), W-1-m),
        (m, m), (m, W-1-m), (H-1-m, m), (H-1-m, W-1-m),
    ]
    random.shuffle(anchors)
    pos=[]
    for r,c in anchors:
        if all(max(abs(r-r2),abs(c-c2))>2 for r2,c2 in pos):
            pos.append((r,c))
            if len(pos)==n: break
    return pos

def draw(sources, shape):
    H,W=shape
    g=np.zeros(shape,dtype=int)
    colls=0
    for r,c,color in sources: g[r,c]=color
    for r,c,color in sorted(sources):
        for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc]==0:g[rr,cc]=color
                else: colls += 1
                rr+=dr; cc+=dc
    return g,colls

def sel(g):
    H,W=g.shape; s=[]; cands=[]
    for side in range(min(H,W),1,-1):
        cur=[]
        for r in range(H-side+1):
            for c in range(W-side+1):
                if np.all(g[r:r+side,c:c+side]==0):
                    cur.append((r,c,side))
                    if all(r+side<=rr or rr+ss<=r or c+side<=cc or cc+ss<=c for rr,cc,ss in s):
                        s.append((r,c,side))
        cands.extend(cur)
    return cands,s

def ok(square,g):
    H,W=g.shape; r,c,side=square
    for cc in range(c,c+side):
        for nr,nc in [(r-1,cc),(r+side,cc)]:
            if 0<=nr<H and 0<=nc<W and g[nr,nc]"'!=0:return True
    for rr in range(r,r+side):
        for nr,nc in [(rr,c-1),(rr,c+side)]:
            if 0<=nr<H and 0<=nc<W and g[nr,nc]!=0:return True
    return False

def same_ov(cands):
    by={}
    for x in cands: by.setdefault(x[2],[]).append(x)
    for arr in by.values():
        for i,a in enumerate(arr):
            for b in arr[i+1:]:
                r,c,s=a; rr,cc,ss=b
                if not (r+s<=rr or rr+ss<=r or c+s<=cc or cc+ss<=c): return True
    return False

