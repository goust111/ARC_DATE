+GEN_HEIGHT_RANGE = (14, 20)
+GEN_WIDTH_RANGE = (14, 20)
+GEN_SOURCE_COUNT_CHOICES = (2, 3)
+GEN_MARGIN_CHOICES = (2, 3, 4)
