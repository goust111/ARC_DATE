import random, numpy as np
from collections import Counter

def draw(sources, shape):
    H,W=shape
    g=np.zeros(shape,dtype=int)
    src={c:(r,cc) for r,cc,c in sources}
    for r,c,color in sources:
        g[r,c]=color
    colls=0
    for r,c,color in sorted(sources):
        for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc]==0:
                    g[rr,cc]=color
                else:
                    colls += 1
                rr+=dr; cc+=dc
    return g,src,colls

def squares(g):
    H,W=g.shape
    selected=[]
    cands=[]
    for side in range(min(H,W),1,-1):
        by=[]
        for r in range(H-side+1):
            for c in range(W-side+1):
                if np.all(g[r:r+side,c:c+side]==0):
                    by.append((r,c,side))
        cands.extend(by)
        for r,c,side in by:
            if all(r+side<=rr or rr+ss<=r or c+side<=cc or cc+ss<=c for rr,cc,ss in selected):
                selected.append((r,c,side))
    return cands,selected

def fill(square,g,src):
    H,W=g.shape
    r,c,side=square
    counts=Counter()
    for cc in range(c,c+side):
        for nr,nc in [(r-1,cc),(r+side,cc)]:
            if 0<=nr<H and 0<=nc<W and g[nr,nc]"'!=0:
                counts[int(g[nr,nc])] += 1
    for rr in range(r,r+side):
        for nr,nc in [(rr,c-1),(rr,c+side)]:
            if 0<=nr<H and 0<=nc<W and g[nr,nc]!=0:
                counts[int(g[nr,nc])] += 1
    if not counts:
        return None, False
    best=max(counts.values())
    cols=[col for col,v in counts.items() if v==best]
    return cols[0], len(cols)>1

def same_size_overlap(cands):
    by={}
    for x in cands:
        by.setdefault(x[2],[]).append(x)
    for side,arr in by.items():
        for i,a in enumerate(arr):
