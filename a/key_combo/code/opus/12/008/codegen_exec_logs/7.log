import random, numpy as np
from collections import Counter

def draw(sources, shape):
    H,W=shape
    g=np.zeros(shape,dtype=int)
    srcmap={c:(r,c0) for r,c0,c in sources}
    for (r,c,color) in sources:
        g[r,c]=color
    for r,c,color in sorted(sources):
        for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc]==0:
                    g[rr,cc]=color
                rr+=dr; cc+=dc
    return g,srcmap

def squares(g):
    H,W=g.shape
    selected=[]
    for side in range(min(H,W),1,-1):
        for r in range(H-side+1):
            for c in range(W-side+1):
                if np.all(g[r:r+side,c:c+side]==0):
                    ok=True
                    for rr,cc,ss in selected:
                        if not (r+side<=rr or rr+ss<=r or c+side<=cc or cc+ss<=c):
                            ok=False; break
                    if ok:
                        selected.append((r,c,side))
    return selected

def color_for(square,g,srcmap):
    H,W=g.shape
    r,c,side=square
    counts=Counter()
    for cc in range(c,c+side):
        for nr,nc in [(r-1,cc),(r+side,cc)]:
            if 0<=nr<H and 0<=nc<W and g[nr,nc]"'!=0:
                counts[int(g[nr,nc])]+=1
    for rr in range(r,r+side):
        for nr,nc in [(rr,c-1),(rr,c+side)]:
            if 0<=nr<H and 0<=nc<W and g[nr,nc]!=0:
                counts[int(g[nr,nc])]+=1
    if not counts: return None,False
    best=max(counts.values())
    cols=[col for col,v in counts.items() if v==best]
    tie=len(cols)>1
    cols.sort(key=lambda col: srcmap[col])
    return cols[0], tie

tie_cases=0
samples=0
for _ in range(1000):
    H=W=random.randint(14,20)
    n=random.choice([2,3])
    colors=random.sample(range(1,10),n)
    pos=[]
    cells=[(r,c) for r in range(2,H-2) for c in range(2,W-2)]
    random.shuffle(cells)
    for r,c in cells:
        if all(max(abs(r-r2),abs(c-c2))>2 for r2,c2,_ in pos):
            pos.append((r,c,colors[len(pos)]))
            if len(pos)==n: break
    g,srcmap=draw(pos,(H,W))
    s=squares(g)
    if len(s)<2: continue
    samples+=1
    if any(color_for(x,g,srcmap)[1] for x in s):
        tie_cases += 1
print('"'samples',samples,'tie_cases',tie_cases,'rate',tie_cases/samples)
