+Square = tuple[int, int, int]  # (top_row, left_col, side)
+Source = tuple[int, int, int]  # (row, col, color)
+
+
+BLACK = 0
+NON_BLACK_COLORS = tuple(range(1, 10))
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
