    if mask[point]:
        return True

    filled = [tuple(map(int, p)) for p in np.argwhere(mask)]
    filled.sort(key=lambda p: abs(p[0] - point[0]) + abs(p[1] - point[1]))
    starts = filled[: min(CONNECT_START_LIMIT, len(filled))]
    random.shuffle(starts)

    for start in starts:
