+        rr = int(r)
+        cc = int(c)
+        if all(
+            not (0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and int(g[nr, nc]) == RED)
+            for nr, nc in _neighbors4(rr, cc)
+        ):
