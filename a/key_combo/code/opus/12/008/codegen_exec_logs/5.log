+        cells.add((r, c1))
+    return frozenset(cells)
+
+
+def _side_cells(rect: Rect, side: str) -> frozenset[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    if side == "top":
+        return frozenset((r0, c) for c in range(c0, c1 + 1))
+    if side == "bottom":
