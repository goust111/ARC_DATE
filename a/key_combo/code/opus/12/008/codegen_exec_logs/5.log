_GEN_GRID_SIZE = 10
_GEN_SHAPE = (_GEN_GRID_SIZE, _GEN_GRID_SIZE)
# Pocket layout.
_GEN_POCKET_COUNT_RANGE = (3, 5)
_GEN_POCKET_SIDE_CHOICES = (2, 3)
