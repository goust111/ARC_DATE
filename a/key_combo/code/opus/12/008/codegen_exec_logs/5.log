+        bhw = random.choice(HALF_OPTIONS)
+        if direction in ("up", "down"):
+            if ahh < 3:
+                return None
+            dist = random.randint(2, ahh - 1)
+            bcr = acr - dist - bhh if direction == "up" else acr + dist + bhh
+            if not (bhh <= bcr < height - bhh):
+                continue
+            if not abs(bcr - overlap_point[0]) <= bhh - 1:
+                continue
+            cols = [
+                cc
+                for cc in _center_values_for_overlap(width, bhw, overlap_point[1], strict=True)
+                if abs(cc - acc) <= bhw
+            ]
+            if not cols:
+                continue
+            bcc = random.choice(cols)
+        else:
+            if ahw < 3:
+                return None
+            dist = random.randint(2, ahw - 1)
+            bcc = acc - dist - bhw if direction == "left" else acc + dist + bhw
