+            if not cols:
+                continue
+            for cr in rows:
+                for cc in cols:
+                    center = (cr, cc)
+                    if center in used_centers:
+                        continue
+                    rect = _rect_from_center(cr, cc, half_h, half_w)
+                    trial = existing_rects + [rect]
