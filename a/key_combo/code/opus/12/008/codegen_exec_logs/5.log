+            acr_hi = height - 1 - ahh if direction == "up" else height - 1 - dist - 2 * bhh
+            if acr_lo > acr_hi:
+                continue
+            acr = random.randint(acr_lo, acr_hi)
+            acc = random.randint(ahw, width - 1 - ahw)
