+
+def _semantic_scene_ok(grid: np.ndarray, rects: list[Rect]) -> bool:
+    if not _centers_match_markers(grid, rects):
+        return False
+
+    if not _interior_overlap_exists(rects):
+        return False
+
+    if not _all_have_two_clean_sides(rects):
