+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randint(18, 24)
+    width = random.randint(18, 24)
+    rect_count = random.randint(3, 4)
+    overlap_point = (random.randint(4, height - 5), random.randint(4, width - 5))
+
+    force_vertical = random.choice((True, False))
+    if force_vertical:
+        anchor_half_h = random.choice((3, 4, 5, 6))
+        anchor_half_w = random.choice(HALF_OPTIONS)
+    else:
+        anchor_half_h = random.choice(HALF_OPTIONS)
+        anchor_half_w = random.choice((3, 4, 5, 6))
+
+    rows = _center_values_for_overlap(height, anchor_half_h, overlap_point[0], strict=True)
+    cols = _center_values_for_overlap(width, anchor_half_w, overlap_point[1], strict=True)
+    if not rows or not cols:
+        return None
+
+    anchor_center = (random.choice(rows), random.choice(cols))
+    anchor = _rect_from_center(anchor_center[0], anchor_center[1], anchor_half_h, anchor_half_w)
+    rects = [anchor]
+    used_centers = {anchor_center}
+
+    blocker = _forced_blocker(
+        (height, width),
+        anchor,
+        overlap_point,
+        random.choice(("up", "down", "left", "right")),
+        used_centers,
+    )
