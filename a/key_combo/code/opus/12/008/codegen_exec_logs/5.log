+def _render_output(shape: tuple[int, int], rects: list[Rect], red_mask: np.ndarray) -> np.ndarray:
+    depth = np.zeros(shape, dtype=int)
+    for r0, c0, r1, c1 in rects:
+        depth[r0 + 1 : r1, c0 + 1 : c1] += 1
