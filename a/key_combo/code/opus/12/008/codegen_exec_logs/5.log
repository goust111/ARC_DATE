+    rects = _solve_rectangles(g)
+    return _render_output(g.shape, rects, g == RED)
+
+
+def _draw_input(shape: tuple[int, int], rects: list[Rect]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
