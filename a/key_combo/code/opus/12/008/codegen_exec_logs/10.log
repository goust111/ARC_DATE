+    shapes = set()
+    cells = [(r, c) for r in range(3) for c in range(3)]
+    for size in range(3, 7):
+        for combo in itertools.combinations(cells, size):
+            norm = _normalize(combo)
+            h, w = _bbox_dims(norm)
+            if h < 2 or w < 2:
