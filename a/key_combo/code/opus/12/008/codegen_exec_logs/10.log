+    h, w = _bbox_dims(coords)
+    tests = ["flipud", "fliplr", "rot180"]
+    if h == w:
+        tests.extend(["transpose", "anti", "rot90", "rot270"])
+    return all(_transform_set(coords, h, w, name) != coords for name in tests)
