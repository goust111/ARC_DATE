+        core_max_w = W - 2
+        rect_shapes = [random.choice([(1, 2), (2, 1)]), random.choice([(1, 2), (2, 1)])]
+    else:
+        H = random.choice([5, 6, 7])
+        W = random.choice([5, 6, 7])
+        core_max_h = max(4, H - 1)
+        core_max_w = max(4, W - 1)
+        rect_shapes = [random.choice([(1, 2), (2, 1), (2, 2)])]
