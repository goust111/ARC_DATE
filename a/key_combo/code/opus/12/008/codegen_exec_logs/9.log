+            candidates.sort(
+                key=lambda pos: sum(
+                    0 <= rr < h and 0 <= cc < w and (rr, cc) not in seen
+                    for rr, cc in _neighbors4(pos[0], pos[1])
+                ),
+                reverse=True,
+            )
+            for nxt in candidates:
+                seen.add(nxt)
+                path.append(nxt)
+                if dfs():
