+def _free_positions(canvas: np.ndarray, patch: np.ndarray, padding: int = 1) -> list[tuple[int, int]]:
+    H, W = canvas.shape
+    h, w = patch.shape
+    positions = []
+    for r0 in range(H - h + 1):
