+def _path_turns(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    for a, b, c in zip(path, path[1:], path[2:]):
+        d1 = (b[0] - a[0], b[1] - a[1])
+        d2 = (c[0] - b[0], c[1] - b[1])
+        if d1 != d2:
