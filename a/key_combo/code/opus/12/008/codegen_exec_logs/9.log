+            continue
+        if np.array_equal(patch, np.fliplr(patch)) or np.array_equal(patch, np.flipud(patch)):
+            continue
+        return patch, colors
+    return None
+
+
+def _can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int = 1) -> bool:
+    h, w = patch.shape
+    H, W = canvas.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
