+def _plan_paths(
+    modes: tuple[str, str, str, str],
+    marker: tuple[int, int],
+    starts: list[int],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]], list[dict]] | None:
+    controls = {(GRID_SIZE - 1, c) for c in starts}
+    state = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
