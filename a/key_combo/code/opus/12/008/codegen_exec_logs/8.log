+MAX_GENERATION_ATTEMPTS = 400
+FEASIBLE_ZONES = (0, 2, 3)
+
+
+def _quadrant_of(r: int, c: int) -> int:
+    return (2 if r >= HALF else 0) + (1 if c >= HALF else 0)
+
+
+def _marker_zone(r: int, c: int) -> int:
+    return (2 if r >= 4 else 0) + (1 if c >= 4 else 0)
+
+
