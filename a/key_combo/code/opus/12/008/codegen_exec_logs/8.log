+    coords = np.argwhere(grid == MAGENTA)
+    assert len(coords) == 1, "expected exactly one magenta marker"
+    r, c = map(int, coords[0])
+    assert r < HALF and c < HALF, "marker must lie in the upper-left quadrant"
+    return r, c
+
