+                and obstacle_counts[_quadrant_of(fr, fc)] < 5
+                and _cell_ok_for_obstacle(fr, fc, marker, path_cells | obstacle_cells)
+                and RNG.random() < 0.6
+            )
+            if can_turn:
+                state[fr, fc] = GRAY
