+        candidates = list(range(1, 7)) if dc > 0 else list(range(2, 8))
+    else:
+        dc = MODE_DELTAS[modes[BR]][1]
+        candidates = list(range(9, 15)) if dc < 0 else list(range(8, 14))
+    return int(RNG.choice(candidates))
