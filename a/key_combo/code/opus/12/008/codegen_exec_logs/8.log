+import numpy as np
+
+
+GRID_SIZE = 16
+HALF = GRID_SIZE // 2
+BG = 0
+RED = 2
+GRAY = 5
+MAGENTA = 6
+
+UL, UR, BL, BR = 0, 1, 2, 3
+
+MODE_BY_ZONE = (
+    ("orig", "hflip", "vflip", "dflip"),
+    ("hflip", "orig", "dflip", "vflip"),
+    ("vflip", "dflip", "orig", "hflip"),
+    ("dflip", "vflip", "hflip", "orig"),
+)
+
