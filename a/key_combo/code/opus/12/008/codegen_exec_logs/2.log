# Fixed mask geometry and colors.
MASK_HEIGHT, MASK_WIDTH = 4, 4
MASK_SHAPE = (MASK_HEIGHT, MASK_WIDTH)
N_CELLS = MASK_HEIGHT * MASK_WIDTH
BACKGROUND_COLOR, SEPARATOR_COLOR = 0, 4
