+        if ring_idx is not None:
+            counted = any((ar, ac) in ring_cells_list[ring_idx] for ar, ac in _neighbors4(r, c))
+            return {
+                "endpoint": (r, c),
+                "path": path,
+                "ring_idx": ring_idx,
+                "counted": counted,
+                "shadow": _farther_ring_exists(ring_by_cell, shape, ring_idx, nr, nc, dr, dc),
+            }
+        path.append((nr, nc))
+        r, c = nr, nc
