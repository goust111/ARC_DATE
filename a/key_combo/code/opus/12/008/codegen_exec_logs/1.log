+    candidates = []
+    for r in range(H):
+        for c in range(W):
+            if (r, c) in ring_cells:
+                continue
+            if not _cell_is_isolated_from_rings((r, c), ring_cells, shape):
+                continue
+            rays = [_trace_ray(shape, (r, c), dr, dc, ring_by_cell, ring_cells_list) for dr, dc in DIAGONALS]
