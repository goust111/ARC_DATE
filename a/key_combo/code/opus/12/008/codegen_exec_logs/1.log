+
+def _semantic_checks(grid: np.ndarray) -> None:
+    rings = _detect_rings(grid)
+    assert 2 <= len(rings) <= 4
+    ring_cells = set().union(*(ring["cells"] for ring in rings))
+    sources = _source_cells(grid, ring_cells)
+    assert 2 <= len(sources) <= 3
