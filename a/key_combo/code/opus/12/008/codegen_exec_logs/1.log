+        rr += dr
+        cc += dc
+    return False
+
+
+def _trace_ray(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    dr: int,
+    dc: int,
+    ring_by_cell: dict[tuple[int, int], int],
+    ring_cells_list: list[set[tuple[int, int]]],
