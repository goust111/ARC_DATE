+        arrows.append(arrow)
+
+    found_objects = sorted(_components_of_color(grid, OBJECT), key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))
+    found_arrows = sorted(_components_of_color(grid, ARROW), key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))
