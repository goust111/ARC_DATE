+    random.shuffle(placements)
+    for obj_r, obj_c, arrow_r, arrow_c in placements:
+        obj_view = grid[zr0 + obj_r : zr0 + obj_r + oh, zc0 + obj_c : zc0 + obj_c + ow]
+        arrow_view = grid[zr0 + arrow_r : zr0 + arrow_r + ah, zc0 + arrow_c : zc0 + arrow_c + aw]
