+
+def _sample_directions(count: int, viable_lists: list[tuple[str, ...]]) -> list[str] | None:
+    for _ in range(200):
+        dirs = [random.choice(vs) for vs in viable_lists]
+        if len(set(dirs)) < 2:
+            continue
+        return dirs
+    return None
