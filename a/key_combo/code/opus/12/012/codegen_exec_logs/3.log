+        if arrow["direction"] == "right" and not np.any(cc == c1 - 1):
+            return None
+        if arrow["direction"] == "up" and not np.any(rr == r0 + 1):
+            return None
+        if arrow["direction"] == "down" and not np.any(rr == r1 - 1):
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
