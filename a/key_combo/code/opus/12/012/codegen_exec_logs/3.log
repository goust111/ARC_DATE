+    for _ in range(200):
+        dirs = [random.choice(vs) for vs in viable_lists]
+        if len(set(dirs)) < 2:
+            continue
+        return dirs
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(22, 26)
+    w = random.randint(22, 26)
+    count = random.randint(3, 4)
