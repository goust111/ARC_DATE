            return None
        h, w = choices[int(rng.integers(0, len(choices)))]
        rects.append((h, w))
        row_budget -= h
    rng.shuffle(rects)
    return rects


def _gen_rows_for_rects(
    safe_r0: int, safe_r1: int, rects: list[tuple[int, int]], rng: np.random.Generator
) -> list[int]:
