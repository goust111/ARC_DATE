+
+def _erase_expected(grid: np.ndarray, objects: list[dict], arrows: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    out[out == ARROW] = BG
+    for obj, arrow in zip(objects, arrows, strict=False):
+        coords = obj["coords"]
+        r0, c0, r1, c1 = obj["bbox"]
+        rr = coords[:, 0]
+        cc = coords[:, 1]
+        if arrow["direction"] == "left":
