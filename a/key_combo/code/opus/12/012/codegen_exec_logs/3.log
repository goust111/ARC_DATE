+BG = 0
+ARROW = 2
+OBJECT = 3
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ALL_DIRECTIONS = ("up", "down", "left", "right")
+SIDE_TO_DIR = ("top", "bottom", "left", "right")
