    """
    Find connected components in a grid (unified API for ARC-2 + migrated seeds).

    return_format:
      - \"dict\": list of dicts {color, coords, bbox, area}
      - \"objects\": list of full-grid arrays containing exactly one component
    """
    if bg is None:
