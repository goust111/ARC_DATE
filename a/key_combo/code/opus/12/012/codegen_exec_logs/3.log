SOURCE_COLOR = 1
MARKER_COLOR = 2
GRID_HEIGHT_RANGE = (14, 20)
GRID_WIDTH_RANGE = (12, 21)

# Template shape and content bounds.
TEMPLATE_WIDTH_RANGE = (3, 4)
TEMPLATE_HEIGHT_RANGE = (1, 4)
TEMPLATE_MIN_HEIGHT_FOR_WIDTH3 = 2
