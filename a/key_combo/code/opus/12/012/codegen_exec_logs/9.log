+
+def _frame_gap_ok(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 2) -> bool:
+    r0a, c0a, r1a, c1a = a
+    r0b, c0b, r1b, c1b = b
+    return (
+        r1a + pad < r0b
+        or r1b + pad < r0a
+        or c1a + pad < c0b
+        or c1b + pad < c0a
