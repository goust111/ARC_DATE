+        return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_frames = random.choice(FRAME_COUNT_CHOICES)
+    (h0, h1), (w0, w1) = GRID_RANGE_BY_COUNT[n_frames]
+    grid_h = random.randint(h0, h1)
+    grid_w = random.randint(w0, w1)
