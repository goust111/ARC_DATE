+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _normalize_shape(cells) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in cells))
+
+
+def _transform_shape(cells, rot: int, flip: bool) -> tuple[tuple[int, int], ...]:
+    pts = [(r, c) for r, c in cells]
+    if flip:
+        pts = [(r, -c) for r, c in pts]
+    for _ in range(rot % 4):
+        pts = [(c, -r) for r, c in pts]
+    return _normalize_shape(pts)
+
+
+def _shape_dims(shape: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    comps = _components(grid == RED)
+    frames = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert h == w and 5 <= h <= 7
+        crop = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros_like(crop, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        assert np.all(crop[border] == RED)
+        assert not np.any(crop[~border] == RED)
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "center": ((r0 + r1) / 2.0, (c0 + c1) / 2.0),
+                "interior_h": h - 2,
+                "interior_w": w - 2,
+            }
+        )
