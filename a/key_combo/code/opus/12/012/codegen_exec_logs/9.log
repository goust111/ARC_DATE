+        cells = [(r0, c) for c in range(c0 + 1, c1)]
+        delta = (-1, 0)
+    elif side == "bottom":
+        cells = [(r1, c) for c in range(c0 + 1, c1)]
+        delta = (1, 0)
+    elif side == "left":
+        cells = [(r, c0) for r in range(r0 + 1, r1)]
+        delta = (0, -1)
+    else:
+        cells = [(r, c1) for r in range(r0 + 1, r1)]
+        delta = (0, 1)
+    random.shuffle(cells)
+    for br, bc in cells:
+        sr = br + delta[0]
+        sc = bc + delta[1]
