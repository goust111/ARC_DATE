+    for pos, (r, c) in enumerate(path):
+        if not (0 <= r < grid_h and 0 <= c < grid_w):
+            return False
+        if (r, c) in blocked:
+            return False
+        if any((nr, nc) in blue_cells for nr, nc in _neighbors4(r, c)):
+            return False
+        touched = {frame_owner[(nr, nc)] for nr, nc in _neighbors4(r, c) if (nr, nc) in frame_owner}
