+    marker_colors = random.sample(PALETTE, len(frames))
+    glyph_colors = []
+    for idx in range(len(frames)):
+        choices = [color for color in PALETTE if color != marker_colors[idx]]
+        glyph_colors.append(random.choice(choices))
