+def _best_side(frame_bbox: tuple[int, int, int, int], target_r: float, target_c: float) -> str:
+    r0, c0, r1, c1 = frame_bbox
+    cr = (r0 + r1) / 2.0
+    cc = (c0 + c1) / 2.0
+    dr = target_r - cr
+    dc = target_c - cc
+    if abs(dr) > abs(dc):
+        return "bottom" if dr > 0 else "top"
+    return "right" if dc > 0 else "left"
