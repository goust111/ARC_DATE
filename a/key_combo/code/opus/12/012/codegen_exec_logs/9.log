+BG = 0
+BLUE = 1
+RED = 2
+PALETTE = [3, 4, 6, 7, 8, 9]
+
+FRAME_COUNT_CHOICES = [3, 4]
+GRID_RANGE_BY_COUNT = {
+    3: ((22, 28), (22, 28)),
+    4: ((25, 29), (25, 29)),
