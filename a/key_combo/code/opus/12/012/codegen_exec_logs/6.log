+BLACK = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+FRAME_COUNT_CHOICES = (2, 2, 3)
