+GRID_W_RANGE = (18, 26)
+FRAME_COUNT_CHOICES = (2, 2, 3)
+INTERIOR_H_RANGE = (4, 9)
+INTERIOR_W_RANGE = (5, 11)
+FRAME_GAP = 2
+OUTSIDE_DOODLE_PROB = 0.65
+GENERATION_ATTEMPTS = 500
+
+SLOPES = (-1, 1)
