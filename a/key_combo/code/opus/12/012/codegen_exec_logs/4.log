    out[nr0, nc0 : nc1 + 1] = border_color
    out[nr1, nc0 : nc1 + 1] = border_color
    out[nr0 : nr1 + 1, nc0] = border_color
    out[nr0 : nr1 + 1, nc1] = border_color
    return out

