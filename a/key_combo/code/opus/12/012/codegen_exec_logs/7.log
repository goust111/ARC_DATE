0183: def _frame_ring_coords(r0, c0, ch, cw):
0184:     """Return (ring_coords, cavity_coords) for a rounded-rect frame.
0185: 
0186:     Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).
0187:     Ring = bbox boundary minus 4 corners.
0188:     """
0189:     H, W = ch + 2, cw + 2
0190:     ring = []
0191:     for dr in range(H):
0192:         for dc in range(W):
0193:             on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)
0194:             corner = (dr in (0, H - 1)) and (dc in (0, W - 1))
0195:             if on_bdr and not corner:
0196:                 ring.append((r0 + dr, c0 + dc))
0197:     cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]
0198:     return ring, cavity
0199: 
