0068: def main(grid: np.ndarray) -> np.ndarray:
0069:     """
0070:     Extend diagonal rays outward from outer-border segments adjacent to diamond shapes on a checkerboard.
0071: 
0072:     Input structure:
0073:     - Checkerboard bg (two most common colors).
0074:     - Hollow diamond outlines (8-pixel) in a non-bg color (inner border).
0075:     - Short diagonal line segments in another non-bg color adjacent to each diamond edge (outer border).
0076: 
0077:     Rule:
0078:     - For each outer-border segment, determine the outward direction (perpendicular to the segment, away from the diamond).
0079:     - From each endpoint of the segment, cast a diagonal ray outward, painting over bg pixels with the segment's color until hitting a non-bg pixel or the grid edge.
0080: 
0081:     Key insight: Rays emit only from the two endpoints of each outer-border segment, not every pixel, and travel diagonally away from the diamond.
0082:     """
0083:     g = np.asarray(grid, dtype=int)
0084:     h, w = g.shape
0085: 
0086:     # The checkerboard background uses the two most frequent colors (typically 0 and 1).
0087:     bg_colors = set(_top_k_colors(g, 2))
0088: 
0089:     # Find diamond inner borders (size-8 diamond components) in non-background colors.
0090:     non_bg = set(int(v) for v in np.unique(g)) - bg_colors
0091:     comps = _components8_by_color(g, non_bg)
0092:     diamonds: list[tuple[int, list[tuple[int, int]]]] = [(col, pts) for col, pts in comps if _is_diamond8(pts)]
0093: 
0094:     out = g.copy()
0095: 
0096:     # Process diamonds in stable order (top-left by bbox).
0097:     def bbox_key(item):
0098:         _, pts = item
0099:         return _bbox(pts)
0100: 
0101:     for _, dpts in sorted(diamonds, key=bbox_key):
0102:         dset = set(dpts)
0103: 
0104:         # Collect all adjacent non-bg (non checkerboard) pixels that are not part of the diamond.
0105:         adj = []
0106:         for r, c in dpts:
0107:             for rr, cc in neighbors8(r, c):
0108:                 if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dset:
0109:                     v = int(g[rr, cc])
0110:                     if v not in bg_colors:
0111:                         adj.append((rr, cc))
0112: 
0113:         if not adj:
0114:             continue
0115: 
0116:         # Build mask for these adjacent pixels and extract their 8-connected components.
0117:         adj_mask = np.zeros((h, w), dtype=bool)
0118:         for r, c in adj:
0119:             adj_mask[r, c] = True
0120:         outer_comps = _cc8(adj_mask)
0121: 
0122:         for oc in outer_comps:
0123:             ocol = int(g[oc[0][0], oc[0][1]])
0124:             info = _outer_line_info(oc)
0125:             if info is None:
0126:                 continue
0127:             slope_key, endpoints = info
0128: 
0129:             if slope_key == "rc_diff":
0130:                 # line direction along (1,1); candidate normals are (-1,1) and (1,-1)
0131:                 normals = [(-1, 1), (1, -1)]
0132:             else:
0133:                 # line direction along (1,-1); candidate normals are (-1,-1) and (1,1)
0134:                 normals = [(-1, -1), (1, 1)]
0135: 
0136:             # Choose inward normal by best overlap with diamond when shifting outer by that normal.
0137:             best_n = None
0138:             best_score = -1
0139:             for n in normals:
0140:                 sc = sum(((r + n[0], c + n[1]) in dset) for r, c in oc)
0141:                 if sc > best_score:
0142:                     best_score = sc
0143:                     best_n = n
0144:             if best_n is None or best_score <= 0:
0145:                 continue
0146:             outward = (-best_n[0], -best_n[1])
0147: 
0148:             # Endpoints (two extremes along the diagonal line).
0149:             p0 = endpoints[0]
0150:             p1 = endpoints[-1]
