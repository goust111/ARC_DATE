0129: 
0130: # Marker center sampling bounds and required diagonal separation.
0131: GEN_TOP_ROWS, GEN_BOT_ROWS = (2, 5), (9, 12)
0132: GEN_LEFT_COLS, GEN_RIGHT_COLS = (2, 5), (9, 12)
0133: GEN_MIN_SEP = 5
0134: 
