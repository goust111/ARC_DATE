+    sep = int(g[0, 0])
+    assert np.all(g[0, :] == sep) and np.all(g[-1, :] == sep), "expected separator border rows"
+    assert np.all(g[:, 0] == sep) and np.all(g[:, -1] == sep), "expected separator border columns"
