0144: def _gen_choose_centers() -> list[tuple[int, int]]:
0145:     top_r = _gen_randint(*GEN_TOP_ROWS)
0146:     bot_r = _gen_randint(max(GEN_BOT_ROWS[0], top_r + GEN_MIN_SEP), GEN_BOT_ROWS[1])
0147: 
0148:     if _gen_randint(*GEN_ORIENTATION_RANGE) == GEN_TL_BR_ORIENTATION:
0149:         left_c = _gen_randint(*GEN_LEFT_COLS)
0150:         right_c = _gen_randint(max(GEN_RIGHT_COLS[0], left_c + GEN_MIN_SEP), GEN_RIGHT_COLS[1])
0151:         return [(top_r, left_c), (bot_r, right_c)]
0152: 
0153:     right_c = _gen_randint(*GEN_RIGHT_COLS)
0154:     left_c = _gen_randint(GEN_LEFT_COLS[0], min(GEN_LEFT_COLS[1], right_c - GEN_MIN_SEP))
0155:     return [(top_r, right_c), (bot_r, left_c)]
