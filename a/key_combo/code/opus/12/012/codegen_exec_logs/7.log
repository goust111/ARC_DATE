0158: def _gen_place_frame(
0159:     grid: np.ndarray, r: int, c: int, direction: tuple[int, int]
0160: ) -> tuple[tuple[int, int], tuple[int, int]]:
0161:     dr, dc = direction
0162:     gap = (r + dr, c + dc)
0163:     exterior = (r + GEN_EXTERIOR_STEP * dr, c + GEN_EXTERIOR_STEP * dc)
0164: 
0165:     r0, r1 = r - GEN_FRAME_RADIUS, r + GEN_FRAME_RADIUS + 1
0166:     c0, c1 = c - GEN_FRAME_RADIUS, c + GEN_FRAME_RADIUS + 1
0167:     grid[r0:r1, c0:c1] = GEN_FRAME
0168:     grid[r, c] = GEN_MARKER
0169:     grid[gap] = GEN_BG
0170:     return gap, exterior
0171: 
0172: 
0173: def _gen_expected_output(
0174:     base: np.ndarray, doors: list[tuple[tuple[int, int], tuple[int, int]]]
0175: ) -> np.ndarray:
0176:     start = doors[0][1]
0177:     end = doors[1][1]
0178:     row_step = _sign(end[0] - start[0])
0179:     col_step = _sign(end[1] - start[1])
0180:     assert row_step != 0 and col_step != 0
0181: 
0182:     moves = [(row_step, 0), (0, col_step)]
0183:     r0, r1 = sorted([start[0], end[0]])
0184:     c0, c1 = sorted([start[1], end[1]])
0185:     bounds = (r0, c0, r1, c1)
0186:     forward = _reachable(base, GEN_BG, start, moves, bounds)
0187:     backward = _reachable(base, GEN_BG, end, [(-dr, -dc) for dr, dc in moves], bounds)
0188:     path = forward & backward
0189:     assert path[start] and path[end]
0190: 
0191:     out = base.copy()
0192:     out[path] = GEN_FILL
0193:     for gap, _ in doors:
0194:         out[gap] = GEN_FILL
0195:     return out
0196: 
0197: 
0198: def _gen_attempt() -> np.ndarray | None:
0199:     base = np.full(GEN_GRID_SHAPE, GEN_BG, dtype=int)
0200:     doors = []
0201: 
0202:     for r, c in _gen_choose_centers():
0203:         direction = GEN_DIRECTIONS[_gen_randint(0, len(GEN_DIRECTIONS) - 1)]
0204:         doors.append(_gen_place_frame(base, r, c, direction))
0205: 
0206:     try:
0207:         expected = _gen_expected_output(base, doors)
0208:         inp = expected.copy()
0209:         inp[inp == GEN_FILL] = GEN_BG
0210:         if not np.array_equal(main(inp), expected):
0211:             return None
0212:         return inp
0213:     except Exception:
0214:         return None
0215: 
0216: 
0217: def generate_input() -> np.ndarray:
0218:     for _ in range(GEN_MAX_ATTEMPTS):
0219:         grid = _gen_attempt()
0220:         if grid is not None:
0221:             return grid
0222:     raise RuntimeError("failed to generate valid 692cd3b6 input")
