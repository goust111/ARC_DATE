+        return False
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+    if np.array_equal(inp, out):
+        return False
+    if np.count_nonzero(inp != out) < 4:
+        return False
+
+    orientations = {group["orientation"] for group in groups}
+    if orientations != {"H", "V"}:
