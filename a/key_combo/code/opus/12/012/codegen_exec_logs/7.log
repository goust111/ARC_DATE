+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+SEP = 5
+BG = 0
+CORNER_OFFSETS = ((0, 0), (0, 2), (2, 0), (2, 2))
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+TILE_ROWS_RANGE = (3, 5)
+TILE_COL_CHOICES = (3, 5)
+MIN_SEG_LEN = 3
+MAX_GEN_ATTEMPTS = 500
+CONFLICT_PROB = 0.45
