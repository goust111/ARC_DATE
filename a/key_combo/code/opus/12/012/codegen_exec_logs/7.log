0201: def _validate_frame_placement(canvas, ring, cavity, line_col, h, w):
0202:     """Check that ring+cavity can be placed on canvas without conflicts.
0203: 
0204:     Returns True if: ring and cavity cells are empty, no cavity cell is
0205:     8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and
0206:     at least one ring cell is 8-adjacent to a line_col pixel.
0207:     """
0208:     # Ring and cavity cells must all be empty
0209:     for rr, cc in ring:
0210:         if canvas[rr, cc] != -1:
0211:             return False
0212:     for rr, cc in cavity:
0213:         if canvas[rr, cc] != -1:
0214:             return False
0215: 
0216:     # No cavity cell may be 8-adjacent to any line_col pixel
0217:     for cr, cc in cavity:
0218:         for nr, nc in neighbors8(cr, cc):
0219:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
0220:                 return False
0221: 
0222:     # Ring must not be 8-adjacent to any non-bg, non-line_col pixel
0223:     ring_set = set(ring)
0224:     for rr, cc in ring:
0225:         for nr, nc in neighbors8(rr, cc):
0226:             if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:
0227:                 continue
0228:             v = canvas[nr, nc]
0229:             if v != -1 and v != line_col:
0230:                 return False
0231: 
0232:     # At least one ring cell must be 8-adjacent to a line_col pixel
0233:     for rr, cc in ring:
0234:         for nr, nc in neighbors8(rr, cc):
0235:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
0236:                 return True
0237:     return False
