+        free_positions = [pos for pos in CORNER_OFFSETS if pos not in used_positions]
+        if free_positions:
+            specs.append(
+                {
+                    "color": other,
+                    "pos": random.choice(free_positions),
+                    "orientation": random.choice(("H", "V")),
+                    "desired_start_parity": random.choice((0, 1)),
+                }
+            )
