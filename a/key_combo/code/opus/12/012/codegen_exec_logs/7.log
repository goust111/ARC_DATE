0042: def main(grid: np.ndarray) -> np.ndarray:
0043:     """
0044:     Paint yellow the background cells on the unobstructed shortest monotone corridor between two doorway frames.
0045: 
0046:     Input structure
0047:     - The grid has a background, two small frame objects in one foreground color, and one center marker in each frame.
0048:     - Each marker has exactly one background 4-neighbor, the doorway gap; the next cell outward is the exterior doorway cell.
0049: 
0050:     Rule
0051:     - Treat all existing foreground cells as blockers.
0052:     - Between the two exterior doorway cells, allow only row/column steps that move toward the other exterior cell.
0053:     - Paint every background cell that lies on some such path from one exterior cell to the other, plus the two doorway gaps, yellow.
0054: 
0055:     Key insight
0056:     - The output is not a single chosen route: it is the union of all shortest monotone paths that can pass between the two frames.
0057:     """
0058:     g = np.asarray(grid, dtype=int)
0059:     bg = get_bg(g)
0060:     counts = Counter(map(int, g.ravel()))
0061:     fg_colors = [color for color in counts if color != bg]
0062:     assert len(fg_colors) == 2
0063: 
0064:     marker_colors = [color for color in fg_colors if counts[color] == 2]
0065:     assert len(marker_colors) == 1
0066:     marker_color = marker_colors[0]
0067:     frame_colors = [color for color in fg_colors if color != marker_color]
0068:     assert len(frame_colors) == 1
0069:     frame_color = frame_colors[0]
0070: 
0071:     doors: list[tuple[tuple[int, int], tuple[int, int]]] = []
0072:     for r0, c0 in zip(*np.where(g == marker_color)):
0073:         r, c = int(r0), int(c0)
0074:         neighbors = []
0075:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
0076:             rr, cc = r + dr, c + dc
0077:             assert in_bounds(g.shape, rr, cc)
0078:             neighbors.append((int(g[rr, cc]), dr, dc, rr, cc))
0079: 
0080:         gaps = [item for item in neighbors if item[0] == bg]
0081:         frame_neighbors = [item for item in neighbors if item[0] == frame_color]
0082:         assert len(gaps) == 1
0083:         assert len(frame_neighbors) == 3
0084: 
0085:         _, dr, dc, gap_r, gap_c = gaps[0]
0086:         ext_r, ext_c = r + 2 * dr, c + 2 * dc
0087:         assert in_bounds(g.shape, ext_r, ext_c)
0088:         assert g[ext_r, ext_c] == bg
0089:         doors.append(((gap_r, gap_c), (ext_r, ext_c)))
0090: 
0091:     assert len(doors) == 2
0092:     start = doors[0][1]
0093:     end = doors[1][1]
0094:     row_step = _sign(end[0] - start[0])
0095:     col_step = _sign(end[1] - start[1])
0096:     assert row_step != 0 or col_step != 0
0097: 
0098:     moves = []
0099:     if row_step:
0100:         moves.append((row_step, 0))
0101:     if col_step:
0102:         moves.append((0, col_step))
0103: 
0104:     r0, r1 = sorted([start[0], end[0]])
0105:     c0, c1 = sorted([start[1], end[1]])
0106:     bounds = (r0, c0, r1, c1)
0107:     forward = _reachable(g, bg, start, moves, bounds)
0108:     backward = _reachable(g, bg, end, [(-dr, -dc) for dr, dc in moves], bounds)
0109:     path = forward & backward
0110:     assert path[start]
0111:     assert path[end]
0112: 
0113:     out = g.copy()
0114:     out[path] = Color.YELLOW
0115:     for gap, _ in doors:
0116:         assert g[gap] == bg
0117:         out[gap] = Color.YELLOW
0118:     return out
