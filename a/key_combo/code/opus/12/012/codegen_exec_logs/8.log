+def _nearest_marker_color(r: int, c: int, markers: list[tuple[int, int, int]]) -> int:
+    best = min(markers, key=lambda item: (abs(item[0] - r) + abs(item[1] - c), item[0], item[1]))
+    return int(best[2])
