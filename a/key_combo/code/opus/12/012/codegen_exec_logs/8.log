+def _tie_holds(
+    point: tuple[int, int],
+    markers: list[tuple[int, int, int]],
+) -> tuple[bool, int | None]:
+    pr, pc = point
+    dists = sorted((abs(r - pr) + abs(c - pc), r, c, color) for r, c, color in markers)
+    if len(dists) < 2 or dists[0][0] != dists[1][0]:
+        return False, None
+    return True, int(dists[0][3])
+
