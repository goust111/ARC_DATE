+    succ = {color: set() for color in colors}
+    indeg = {color: 0 for color in colors}
+    for lower, upper in edges:
+        if upper not in succ[lower]:
+            succ[lower].add(upper)
+            indeg[upper] += 1
+
+    remaining = set(colors)
