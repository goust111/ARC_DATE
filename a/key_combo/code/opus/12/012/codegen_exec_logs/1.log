+    left = int(rng.choice(margin_choices, p=margin_probs))
+    bottom = int(rng.choice(margin_choices, p=margin_probs))
+    right = int(rng.choice(margin_choices, p=margin_probs))
+
+    h = top + (n - 1) + heights[-1] + bottom
