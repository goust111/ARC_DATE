+    if max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+    if len(placed_frames) not in (2, 3):
+        return False
+    if len({frame["scale"] for frame in placed_frames}) < 2:
+        return False
+    if np.array_equal(inp, expected):
+        return False
+    if not np.array_equal(main(inp), expected):
