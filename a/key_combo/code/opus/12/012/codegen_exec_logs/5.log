+    if len(parsed_frames) != len(placed_frames):
+        return False
+    inner_sizes = sorted(frame["inner_size"] for frame in parsed_frames)
+    if inner_sizes != sorted(frame["scale"] * template.shape[0] for frame in placed_frames):
+        return False
