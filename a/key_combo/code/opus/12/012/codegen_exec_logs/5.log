+        border = np.zeros_like(box, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if not np.all(box[border] == FRAME_COLOR):
+            continue
+        if np.any(box[1:-1, 1:-1] == FRAME_COLOR):
