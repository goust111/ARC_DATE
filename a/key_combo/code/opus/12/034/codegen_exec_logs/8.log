+def _covered_positions(length: int, limit: int) -> list[int]:
+    cells: list[int] = []
+    for start in range(2 * int(length), int(limit), 2 * int(length)):
+        stop = min(start + int(length), int(limit))
+        cells.extend(range(start, stop))
+    return cells
+
