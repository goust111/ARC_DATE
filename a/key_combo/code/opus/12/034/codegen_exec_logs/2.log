  grid: 8-13 rows x 15-20 cols [observed]
  colors:
    bg: 0
    separator: single color s_color (not 0), any color except 0 and bar colors
    bars: monochrome runs, colors distinct from separator and 0
  separator:
    orientation: vertical column [observed]
    column: a single column with >=H-1 cells filled with s_color (typically all H cells);
      divides grid into bar_side and ext_side; may omit one terminal-row cell [observed, rare]
    position: anywhere such that bar_side has 3-12 cols wide and ext_side has 2-14 cols wide
  bar_side:
    side: left or right of separator (all bars on same side)
    bar_side_len: 2-12 cols
  bars:
    per_active_row: 1-2 monochrome bars (contiguous same-color runs); if 2 they are adjacent (no gap between them)
    bar_length: 1 to bar_side_len pixels
    anchoring: rightmost-bar's inner edge abuts separator (gap=0) typically; gap of 1 to separator allowed [observed, rare]
    colors_per_row: 1-2 distinct colors; colors differ across rows [observed, usually]
  active_rows:
    count: 2-5 rows containing bars
    spacing: at least 1 empty row between any two active rows (spacings observed: 1-4)
    margins: >=0 empty rows at top and bottom
  ext_side:
    ext_side_len: 2-14 cols
    in input: entirely 0
    in output: each active row r receives a periodic extension built by processing row r's bars
      in order of proximity to separator (nearest first):
        for bar (color, length), paint color at ext positions 0, length, 2*length, ...
        (pos 0 = cell immediately past separator), never overwriting a non-zero cell
  non_active_rows:
    bar_side and ext_side are all 0 in both input and output
  transform: |
    output = input with each active row's ext_side filled per the periodic rule above.
    separator column is preserved unchanged.

generation_strategy:
  approach: output-first (then strip ext_side to get input)
  steps:
    - Pick H in 8-13, W in 15-20, bar_side_len in 3-12, ext_side_len = W - 1 - bar_side_len (>=2)
    - Pick bar_side in {left, right}; place separator column at bar_side_len (if left) or W-1-bar_side_len (if right)
    - Pick sep_color and a disjoint palette of 5-8 bar colors (all non-zero, distinct)
    - Pick 2-5 active rows with pairwise row-spacing >=2 and top/bottom margin >=0
    - For each active row:
        * pick 1 or 2 bars; pick distinct colors from palette; pick lengths in [1, bar_side_len]
          (with total length <= bar_side_len if 2 bars)
        * place bars contiguously abutting separator (nearest bar has inner edge at separator-1 or separator+1);
          occasionally insert a 1-cell gap between the nearest bar and separator [rare]
    - Build output by simulating the periodic extension (nearest-first, no-overwrite) on ext_side
    - Input = output with ext_side cleared to 0 (keep separator + bars + bg)
    - Final validation: simulate(input) == output
```
