+    bottom_count = int(np.count_nonzero(bottom_fg))
+    if not (PANEL_FG_RANGE[0] <= top_count <= PANEL_FG_RANGE[1]):
+        return False
+    if not (PANEL_FG_RANGE[0] <= bottom_count <= PANEL_FG_RANGE[1]):
+        return False
+
