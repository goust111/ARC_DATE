+            (r, c)
+            for r in range(1, panel_h - 1)
+            for c in range(1, width - 1)
+            if (r, c) not in protected_empty and (r, c) not in reserved
+        ]
+        second = _pick_sparse_cells(interior, 1, reserved)
+        if second is None:
+            return None
+        collisions.extend(second)
+        reserved.extend(second)
