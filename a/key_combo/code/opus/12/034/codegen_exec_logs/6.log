+        _parse_mask("#.#/###/#.#"),
+        _parse_mask("#######"),
+    ],
+}
+
+ASYMMETRIC_LIBRARY = {
+    3: [_parse_mask("##/#."), _parse_mask("##/.#"), _parse_mask("#./##")],
+    4: [_parse_mask("#../###"), _parse_mask("##./.#./.#."), _parse_mask("#./##/.#")],
+    5: [
+        _parse_mask("#../#../###"),
+        _parse_mask("##./.##/..#"),
+        _parse_mask("###/#../#.."),
