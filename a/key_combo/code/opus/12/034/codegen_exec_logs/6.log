+        for cc in range(w):
+            if not mask[rr, cc]:
+                continue
+            gr = r0 + rr
+            gc = c0 + cc
+            if clip:
+                if 0 <= gr < gh and 0 <= gc < gw:
+                    grid[gr, gc] = int(color)
+            else:
+                if not (0 <= gr < gh and 0 <= gc < gw):
+                    raise ValueError("paint out of bounds")
