+def _choose_pairs(rng: random.Random) -> list[dict]:
+    pairs = []
+    used_areas = set()
+
+    for required in ("larger", "smaller"):
+        options = [c for c in PAIR_CANDIDATES if c["relation"] == required and c["area"] not in used_areas]
+        if not options:
