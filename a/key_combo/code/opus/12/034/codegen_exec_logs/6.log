+    seen = {start}
+    q: deque[tuple[int, int]] = deque([start])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
