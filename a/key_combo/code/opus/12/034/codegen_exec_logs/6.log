+                g_bbox_area = int(target.shape[0] * target.shape[1])
+                if t_bbox_area > g_bbox_area:
+                    relation = "larger"
+                elif t_bbox_area < g_bbox_area:
+                    relation = "smaller"
+                else:
+                    relation = "equal"
+                combos.append(
+                    {
+                        "area": area,
+                        "template": template,
+                        "target": target,
+                        "relation": relation,
+                    }
+                )
+    return combos
+
