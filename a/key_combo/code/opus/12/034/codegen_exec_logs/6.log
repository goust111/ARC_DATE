+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7)
+GRID_SIDE_RANGE = (18, 26)
+MIN_BBOX_GAP = 2
+GEN_ATTEMPTS = 400
+
+
+def _parse_mask(spec: str) -> np.ndarray:
+    lines = spec.split("/")
+    width = len(lines[0])
+    mask = np.array([[ch == "#" for ch in row] for row in lines], dtype=bool)
+    assert all(len(row) == width for row in lines)
+    assert mask.any()
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+SYMMETRIC_LIBRARY = {
+    3: [_parse_mask("###"), _parse_mask("#/#/#")],
+    4: [_parse_mask("##/##"), _parse_mask("###/.#."), _parse_mask("####")],
+    5: [
+        _parse_mask(".#./###/.#."),
+        _parse_mask("###/.#./.#."),
+        _parse_mask("#.#/###"),
+        _parse_mask("#####"),
+    ],
+    6: [_parse_mask("##/##/##"), _parse_mask(".#./###/#.#"), _parse_mask("######")],
+    7: [
+        _parse_mask("###/.#./###"),
+        _parse_mask("..#../#####/..#.."),
+        _parse_mask("#.#/###/#.#"),
+        _parse_mask("#######"),
+    ],
+}
+
+ASYMMETRIC_LIBRARY = {
+    3: [_parse_mask("##/#."), _parse_mask("##/.#"), _parse_mask("#./##")],
+    4: [_parse_mask("#../###"), _parse_mask("##./.#./.#."), _parse_mask("#./##/.#")],
+    5: [
+        _parse_mask("#../#../###"),
+        _parse_mask("##./.##/..#"),
+        _parse_mask("###/#../#.."),
+        _parse_mask("##./##./#.."),
+    ],
+    6: [
+        _parse_mask("####/##.."),
+        _parse_mask("#../###/##."),
+        _parse_mask("##./###/#.."),
+        _parse_mask("###/##./#.."),
+    ],
+    7: [
+        _parse_mask(".##/###/##."),
+        _parse_mask("####/###."),
+        _parse_mask("###/###/#.."),
+        _parse_mask("##../####/.#.."),
+        _parse_mask("##./###/.##"),
+    ],
+}
