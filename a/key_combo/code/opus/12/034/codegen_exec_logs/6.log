+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7)
+GRID_SIDE_RANGE = (18, 26)
+MIN_BBOX_GAP = 2
+GEN_ATTEMPTS = 400
