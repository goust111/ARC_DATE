+            assert _is_vertically_symmetric(mask)
+    for area, masks in ASYMMETRIC_LIBRARY.items():
+        for mask in masks:
+            assert int(mask.sum()) == area
+            assert _mask_connected(mask)
+            assert not _is_vertically_symmetric(mask)
