+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7)
+GRID_SIDE_RANGE = (18, 26)
+MIN_BBOX_GAP = 2
+GEN_ATTEMPTS = 400
+
+
+def _parse_mask(spec: str) -> np.ndarray:
+    lines = spec.split("/")
+    width = len(lines[0])
+    mask = np.array([[ch == "#" for ch in row] for row in lines], dtype=bool)
+    assert all(len(row) == width for row in lines)
+    assert mask.any()
+    assert mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()
+    return mask
+
+
+SYMMETRIC_LIBRARY = {
+    3: [_parse_mask("###"), _parse_mask("#/#/#")],
+    4: [_parse_mask("##/##"), _parse_mask("###/.#."), _parse_mask("####")],
+    5: [
+        _parse_mask(".#./###/.#."),
+        _parse_mask("###/.#./.#."),
+        _parse_mask("#.#/###"),
+        _parse_mask("#####"),
+    ],
+    6: [_parse_mask("##/##/##"), _parse_mask(".#./###/#.#"), _parse_mask("######")],
+    7: [
+        _parse_mask("###/.#./###"),
+        _parse_mask("..#../#####/..#.."),
+        _parse_mask("#.#/###/#.#"),
+        _parse_mask("#######"),
+    ],
+}
+
+ASYMMETRIC_LIBRARY = {
+    3: [_parse_mask("##/#."), _parse_mask("##/.#"), _parse_mask("#./##")],
+    4: [_parse_mask("#../###"), _parse_mask("##./.#./.#."), _parse_mask("#./##/.#")],
+    5: [
+        _parse_mask("#../#../###"),
+        _parse_mask("##./.##/..#"),
+        _parse_mask("###/#../#.."),
+        _parse_mask("##./##./#.."),
+    ],
+    6: [
+        _parse_mask("####/##.."),
+        _parse_mask("#../###/##."),
+        _parse_mask("##./###/#.."),
+        _parse_mask("###/##./#.."),
+    ],
+    7: [
+        _parse_mask(".##/###/##."),
+        _parse_mask("####/###."),
+        _parse_mask("###/###/#.."),
+        _parse_mask("##../####/.#.."),
+        _parse_mask("##./###/.##"),
+    ],
+}
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _bbox_of_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return None
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    bbox = _bbox_of_mask(mask)
+    if bbox is None:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0, r1, c1 = bbox
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q: deque[tuple[int, int]] = deque([start])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _is_vertically_symmetric(mask: np.ndarray) -> bool:
+    return np.array_equal(mask, np.fliplr(mask))
+
+
+def _flip_variant(mask: np.ndarray, rng: random.Random, preserve_vertical_symmetry: bool) -> np.ndarray:
+    out = mask.copy()
+    if rng.random() < 0.5:
+        out = np.flipud(out)
+    if not preserve_vertical_symmetry and rng.random() < 0.5:
+        out = np.fliplr(out)
+    return out.copy()
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            coords = []
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            r0, c0, r1, c1 = _bbox_from_coords(coords)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for cr, cc in coords:
+                mask[cr - r0, cc - c0] = True
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                }
+            )
+    return objects
+
+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int, *, clip: bool) -> None:
+    h, w = mask.shape
+    gh, gw = grid.shape
+    for rr in range(h):
+        for cc in range(w):
+            if not mask[rr, cc]:
+                continue
+            gr = r0 + rr
+            gc = c0 + cc
+            if clip:
+                if 0 <= gr < gh and 0 <= gc < gw:
+                    grid[gr, gc] = int(color)
+            else:
+                if not (0 <= gr < gh and 0 <= gc < gw):
+                    raise ValueError("paint out of bounds")
+                grid[gr, gc] = int(color)
+
+
+def _expanded_boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int) -> bool:
+    ar0, ac0, ar1, ac1 = a[0] - pad, a[1] - pad, a[2] + pad, a[3] + pad
+    br0, bc0, br1, bc1 = b[0] - pad, b[1] - pad, b[2] + pad, b[3] + pad
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+
+
+def _visible_patch(mask: np.ndarray, grid_shape: tuple[int, int], r0: int, c0: int) -> tuple[np.ndarray, tuple[int, int, int, int] | None]:
+    gh, gw = grid_shape
+    h, w = mask.shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(gh, r0 + h)
+    cc1 = min(gw, c0 + w)
+    if rr0 >= rr1 or cc0 >= cc1:
