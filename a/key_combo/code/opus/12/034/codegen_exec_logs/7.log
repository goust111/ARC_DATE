+def _tile_pattern(unit: np.ndarray, out_shape: tuple[int, int]) -> np.ndarray:
+    h, w = unit.shape
+    out_h, out_w = out_shape
+    out = np.zeros((out_h, out_w), dtype=int)
+    for r0 in range(0, out_h, h):
+        for c0 in range(0, out_w, w):
+            rr1 = min(out_h, r0 + h)
+            cc1 = min(out_w, c0 + w)
+            patch = unit[: rr1 - r0, : cc1 - c0]
