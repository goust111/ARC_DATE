+    return seen_output_colors == {BLUE, GREEN}
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    odd_areas = [3, 5]
+    even_choices = [2, 4, 6]
+    even_areas = list(rng.choice(even_choices, size=2, replace=False))
+    areas = odd_areas + even_areas
+    rng.shuffle(areas)
