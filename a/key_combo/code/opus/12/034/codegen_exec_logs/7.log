+        pattern_offsets.append((r0, c0))
+    if all(offset == (0, 0) for offset in pattern_offsets):
+        return None
+
+    try:
+        out = main(inp)
+    except AssertionError:
+        return None
+
+    if not _semantic_check(inp, out):
+        return None
+    return inp
+
