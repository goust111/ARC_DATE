            objects.append({"mask": mask, "r0": row, "c0": c0, "coords": coords, "group": gi})
        row += height + gaps[gi + 1]
    return objects


def _gen_apply_input_shifts(objects, group_count):
    """Choose a shared left shift per group and attach input coords in place."""
    group_shifts = {}
