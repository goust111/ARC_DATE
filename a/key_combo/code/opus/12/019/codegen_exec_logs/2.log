+            variants = [arr for arr in _dihedral_variants(mask) if _has_unique_vertical_extremes(arr)]
+            if not variants:
+                continue
+            signature = _shape_signature(mask)
+            slot = library.setdefault(signature, [])
+            known = {_mask_key(arr) for arr in slot}
+            for arr in variants:
+                key = _mask_key(arr)
+                if key not in known:
+                    slot.append(arr)
+                    known.add(key)
