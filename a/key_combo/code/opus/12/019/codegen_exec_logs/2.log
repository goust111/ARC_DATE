+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BACKGROUND = 0
+DIVIDER = 5
+PALETTE = (1, 2, 3, 4, 6, 7)
+MIN_SIZE = 18
+MAX_SIZE = 24
+MIN_OBJECT_AREA = 3
+MAX_OBJECT_AREA = 6
+MAX_GEN_ATTEMPTS = 400
