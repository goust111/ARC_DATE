+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            r0 = int(rows.min())
+            r1 = int(rows.max())
+            c0 = int(cols.min())
+            c1 = int(cols.max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[rows - r0, cols - c0] = True
+            side = "top" if r1 < divider_row else "bottom"
+            objects.append(
+                {
+                    "index": next_index,
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "side": side,
+                }
