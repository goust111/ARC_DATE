from collections import defaultdict

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

def frontier(cells):
    s=set(cells)
    out=set()
    for r,c in s:
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            p=(r+dr,c+dc)
            if p not in s:
                out.add(p)
    return out

def build(nmax=6):
    by_n=defaultdict(set)
    by_n[1].add(((0,0),))
    for n in range(1,nmax):
