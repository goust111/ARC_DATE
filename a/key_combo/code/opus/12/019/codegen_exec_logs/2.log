+    color = int(obj["color"])
+    if obj["side"] == "top":
+        rows = range(start_r, divider_row) if toward_divider else range(start_r, -1, -1)
+    else:
+        rows = range(start_r, divider_row, -1) if toward_divider else range(start_r, out.shape[0])
