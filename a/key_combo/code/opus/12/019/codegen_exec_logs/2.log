+def _normalize_cells(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    r0 = min(rows)
+    c0 = min(cols)
