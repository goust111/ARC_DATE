0143: def _neighbors4(r: int, c: int, h: int, w: int):
0144:     if r > 0:
0145:         yield r - 1, c
0146:     if r + 1 < h:
0147:         yield r + 1, c
0148:     if c > 0:
0149:         yield r, c - 1
0150:     if c + 1 < w:
0151:         yield r, c + 1
