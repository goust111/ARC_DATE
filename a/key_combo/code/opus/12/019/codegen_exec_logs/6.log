0034:             left_bg = cc > 0 and int(g[rr, cc - 1]) == int(bg)
0035:             right_bg = cc + 1 < W and int(g[rr, cc + 1]) == int(bg)
0036:             assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"
0037: 
0038:     def component_count(points: set[tuple[int, int]], use_diagonal: bool) -> int:
0039:         remaining = set(points)
0040:         if use_diagonal:
0041:             neighbors = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
0042:         else:
0043:             neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
0044:         count = 0
0045:         while remaining:
0046:             count += 1
0047:             stack = [remaining.pop()]
0048:             while stack:
0049:                 r, c = stack.pop()
0050:                 for dr, dc in neighbors:
0051:                     nxt = (int(r + dr), int(c + dc))
0052:                     if nxt in remaining:
0053:                         remaining.remove(nxt)
0054:                         stack.append(nxt)
0055:         return count
0056: 
0057:     bottom_colors = set(map(int, g[H - 1]))
0058:     for color in sorted(set(map(int, g[:7].flatten())) - {bg, water} - bottom_colors):
0059:         pts = {(int(r), int(c)) for r, c in np.argwhere(g[:7] == int(color))}
0060:         diag_links = sum(1 for r, c in pts if (r + 1, c - 1) in pts or (r + 1, c + 1) in pts)
0061:         if diag_links >= 3:
0062:             assert any(c in (0, W - 1) for _r, c in pts), "guide must enter from a grid edge"
