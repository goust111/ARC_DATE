0080:                 and int(g[rr + 1, cc - 1]) == int(bg)
0081:             ):
0082:                 opts.append((int(rr + 1), int(cc - 1)))
0083:             if (
0084:                 rr + 1 < H
0085:                 and cc + 1 < W
0086:                 and int(g[rr, cc + 1]) == int(bg)
0087:                 and int(g[rr + 1, cc + 1]) == int(bg)
