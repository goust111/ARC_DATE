0110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:
0111:     seq: list[int] = []
0112:     unused = set(colors)
0113:     for i in range(int(n_runs)):
0114:         slots_left = int(n_runs) - i
0115:         choices = [c for c in colors if not seq or c != seq[-1]]
0116:         if len(unused) >= slots_left:
0117:             choices = [c for c in choices if c in unused]
0118:         elif unused and random.random() < UNUSED_COLOR_BIAS:
0119:             preferred = [c for c in choices if c in unused]
0120:             if preferred:
0121:                 choices = preferred
0122:         color = random.choice(choices)
0123:         seq.append(int(color))
0124:         unused.discard(int(color))
0125:     return seq
