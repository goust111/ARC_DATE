+        max_drop = int(final_top - band_start)
+        if max_drop < 0:
+            return None
+        if max_drop == 0:
+            drop = 0
+        elif must_drop and order == 0:
+            drop = random.randint(1, max_drop)
+        else:
+            drop = random.randint(0, max_drop)
+            if max_drop > 0 and random.random() < 0.75:
+                drop = max(drop, 1)
+        input_top = int(final_top - drop)
