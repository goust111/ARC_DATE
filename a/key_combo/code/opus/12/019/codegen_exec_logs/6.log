+                "track": track,
+                "shape": shape,
+                "final_coords": final_coords,
+                "input_coords": input_coords,
+                "final_bbox": _bbox_from_top_left(shape, final_top, final_left),
+                "input_bbox": _bbox_from_top_left(shape, input_top, input_left),
