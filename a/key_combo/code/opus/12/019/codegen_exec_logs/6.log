0154: def _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:
0155:     """Grow a connected mask with full row/column span to the target area."""
0156:     mask = np.zeros((int(height), int(width)), dtype=bool)
0157:     steps = ["D"] * (int(height) - 1) + ["R"] * (int(width) - 1)
0158:     random.shuffle(steps)
0159: 
0160:     r = c = 0
0161:     mask[r, c] = True
0162:     for step in steps:
0163:         if step == "D":
0164:             r += 1
0165:         else:
0166:             c += 1
0167:         mask[r, c] = True
0168: 
0169:     if int(mask.sum()) > int(target_area):
0170:         return None
0171: 
0172:     frontier: set[tuple[int, int]] = set()
0173: 
0174:     def add_frontier(rr: int, cc: int) -> None:
0175:         for nr, nc in _neighbors4(rr, cc, int(height), int(width)):
0176:             if not mask[nr, nc]:
0177:                 frontier.add((int(nr), int(nc)))
0178: 
0179:     for rr, cc in np.argwhere(mask):
0180:         add_frontier(int(rr), int(cc))
0181: 
0182:     while int(mask.sum()) < int(target_area):
0183:         if not frontier:
0184:             return None
0185:         cell = random.choice(tuple(frontier))
0186:         frontier.remove(cell)
0187:         rr, cc = cell
0188:         mask[rr, cc] = True
0189:         add_frontier(rr, cc)
0190: 
0272:     return None
