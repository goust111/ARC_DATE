+    track_rows = _track_rows(inp)
+    if len(track_rows) < 3:
+        return False
+    if max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+    if not any(int(count) >= 2 for count in counts.values()):
+        return False
+    if bottom_count and not np.any(expected[-1] != BG):
+        return False
+    return True
