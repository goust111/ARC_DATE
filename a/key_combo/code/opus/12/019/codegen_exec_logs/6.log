+        for j in range(i + 1, len(bboxes)):
+            r0b, c0b, r1b, c1b = bboxes[j]
+            if _intervals_overlap(c0a, c1a, c0b, c1b) and not _intervals_overlap(r0a, r1a, r0b, r1b):
