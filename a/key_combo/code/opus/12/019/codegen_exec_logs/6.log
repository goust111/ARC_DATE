+        if coords.size == 0:
+            return False
+        if np.any(coords[:, 0] < 0) or np.any(coords[:, 0] >= int(height)):
+            return False
+        if np.any(coords[:, 1] < 0) or np.any(coords[:, 1] >= int(width)):
+            return False
+        if np.any(mask[coords[:, 0], coords[:, 1]]):
+            return False
+        mask[coords[:, 0], coords[:, 1]] = True
+    return True
