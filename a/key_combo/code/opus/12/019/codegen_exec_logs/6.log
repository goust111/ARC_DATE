+        final_left = int(final_lefts_rt[order])
+        input_left = int(input_lefts_rt[order])
+        final_coords = _shape_coords(shape, final_top, final_left)
+        input_coords = _shape_coords(shape, input_top, input_left)
+        objects.append(
