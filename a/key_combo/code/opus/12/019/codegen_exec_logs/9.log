+    assert dr == 0 or dc == 0 or abs(dr) == abs(dc), "expected horizontal, vertical, or 45-degree line"
+    sr = 0 if dr == 0 else dr // abs(dr)
+    sc = 0 if dc == 0 else dc // abs(dc)
+    steps = max(abs(dr), abs(dc))
