+
+
+def _scan_matches(
+    grid: np.ndarray,
+    shape: tuple[int, int],
+    red_offsets: list[tuple[int, int]],
+    support_offsets: list[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    bh, bw = shape
+    out = grid.copy()
+    matches: list[tuple[int, int]] = []
+    for r0 in range(h - bh + 1):
