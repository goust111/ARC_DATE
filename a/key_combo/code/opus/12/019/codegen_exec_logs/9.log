+    support_offsets: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+    target_matches: set[tuple[int, int]],
+) -> int:
+    added = 0
+    desired = random.choices([0, 1, 2], weights=[2, 2, 1], k=1)[0]
+    h, w = grid.shape
+    for _ in range(desired):
