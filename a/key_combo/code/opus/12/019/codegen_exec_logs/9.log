+            changed = []
+            for r, c in cluster:
+                grid[r, c] = GREY
+                changed.append((r, c))
+            if _match_set(grid, shape, red_offsets, support_offsets) == target_matches:
+                protected.update(cluster)
+                added += 1
+                break
+            for r, c in changed:
