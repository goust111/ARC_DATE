+def _max_distance(center: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int], grid_shape: tuple[int, int]) -> int:
+    cr, cc = center
+    dr, dc = direction
+    h, w = shape
+    before_r, after_r = _center_offsets(h)
+    before_c, after_c = _center_offsets(w)
