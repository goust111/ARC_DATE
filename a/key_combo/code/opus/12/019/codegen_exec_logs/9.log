+    added = 0
+    desired = random.choices([0, 1, 2], weights=[2, 2, 1], k=1)[0]
+    h, w = grid.shape
+    for _ in range(desired):
+        for _ in range(60):
+            size = random.randint(1, 3)
+            candidates = [(r, c) for r in range(h) for c in range(w) if grid[r, c] == BG and (r, c) not in protected]
+            if not candidates:
