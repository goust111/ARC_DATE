+            seed = random.choice(candidates)
+            cluster = {seed}
+            frontier = {seed}
+            while len(cluster) < size and frontier:
+                rr, cc = random.choice(tuple(frontier))
+                nbrs = []
+                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
