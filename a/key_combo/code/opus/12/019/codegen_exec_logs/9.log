+def _render_with_metadata(
+    grid: np.ndarray,
+    shape: tuple[int, int],
+    red_offsets: list[tuple[int, int]],
+    original_origin: tuple[int, int],
+    slot_origins: list[tuple[int, int]],
+) -> np.ndarray:
+    base = grid.copy()
+    for r0, c0 in slot_origins:
+        for dr, dc in red_offsets:
+            base[r0 + dr, c0 + dc] = RED
