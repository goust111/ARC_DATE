+    if dr < 0:
+        limits.append(cr - before_r)
+    elif dr > 0:
+        limits.append(grid_shape[0] - 1 - after_r - cr)
+    if dc < 0:
+        limits.append(cc - before_c)
+    elif dc > 0:
