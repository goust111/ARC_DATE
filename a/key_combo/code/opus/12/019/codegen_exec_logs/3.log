+def _line_crosses_other_rectangles(src: Source, others: list[Source], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    r, c = src.indicator
+    dr, dc = {
+        "up": (-1, 0),
+        "down": (1, 0),
+        "left": (0, -1),
+        "right": (0, 1),
+    }[src.direction]
+    rr, cc = r + dr, c + dc
+    while 0 <= rr < h and 0 <= cc < w:
+        for other in others:
