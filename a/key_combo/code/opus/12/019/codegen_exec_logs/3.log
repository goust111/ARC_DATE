+            rows = np.arange(0, r0, dtype=int)
+        else:
+            rows = np.arange(r1 + 1, h, dtype=int)
+        if rows.size == 0:
+            return rows
+        rel = rows - (r0 + 1)
+        return rows[(rel % src.period) == src.residue]
