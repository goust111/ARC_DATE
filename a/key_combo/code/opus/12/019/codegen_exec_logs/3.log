+        used_weights.add(proto.weight)
+        protos.append(proto)
+    return protos
+
+
+def _gen_attempt() -> np.ndarray | None:
+    shape = (random.randint(18, 24), random.randint(18, 24))
+    force_conflict = random.random() < 0.7
+    protos = _sample_prototypes(force_conflict)
