172:     frontier: set[tuple[int, int]] = set()
173: 
174:     def add_frontier(rr: int, cc: int) -> None:
175:         for nr, nc in _neighbors4(rr, cc, int(height), int(width)):
176:             if not mask[nr, nc]:
177:                 frontier.add((int(nr), int(nc)))
178: 
179:     for rr, cc in np.argwhere(mask):
180:         add_frontier(int(rr), int(cc))
181: 
182:     while int(mask.sum()) < int(target_area):
