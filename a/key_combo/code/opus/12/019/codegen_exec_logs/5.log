+
+BACKGROUND = 0
+VOTE_COLOR = 7
+MARKER_COLOR_POOL = (1, 2, 3, 4, 5, 6, 8, 9)
+
+GRID_HEIGHT_RANGE = (16, 24)
+GRID_WIDTH_RANGE = (12, 20)
