73: def main(grid: np.ndarray) -> np.ndarray:
74:     """
75:     Build a compact concentric square whose layer order is decided by marker votes inside separated color regions.
76: 
77:     Input structure:
78:     - The background is the dominant color, with 3-5 separated solid rectangular color regions.
79:     - One unique least-frequent non-background color appears only as single-pixel markers placed strictly inside those rectangles.
80:     - Every marker's 4-neighbors are all the base color of the rectangle that contains it.
81: 
82:     Rule:
83:     - Find the unique least-frequent non-background color and treat those pixels as markers.
84:     - Count how many markers belong to each surrounding region color by reading every marker's 4-neighbor owner color.
85:     - Sort the region colors by marker count from highest to lowest, then create a (2N-1) x (2N-1) square whose concentric layers use that outside-to-inside order.
86: 
87:     Key insight:
88:     - The marker pixels are only votes: they never appear in the output directly, but their per-region counts determine the spatial ordering of the concentric layers.
89:     """
90:     g = np.asarray(grid, dtype=int)
91:     assert g.ndim == 2, "expected a 2D grid"
92: 
93:     _marker_color, counts = _vote_counts(g)
94:     ordered_colors = [
95:         color for color, _count in sorted(counts.items(), key=lambda item: item[1], reverse=True)
96:     ]
97:     return _concentric_output(ordered_colors)
98: 
99: 
100: def _choose_region_count() -> int:
101:     # The prompt allows 3-5 regions, but 5 regions are incompatible with
102:     # 5-12 total markers under the additional "all counts distinct and >=1"
103:     # constraint. The solver supports 5; the generator samples the feasible cases.
104:     return random.choice([3, 4])
