110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:
111:     seq: list[int] = []
112:     unused = set(colors)
113:     for i in range(int(n_runs)):
114:         slots_left = int(n_runs) - i
115:         choices = [c for c in colors if not seq or c != seq[-1]]
116:         if len(unused) >= slots_left:
117:             choices = [c for c in choices if c in unused]
118:         elif unused and random.random() < UNUSED_COLOR_BIAS:
119:             preferred = [c for c in choices if c in unused]
120:             if preferred:
121:                 choices = preferred
122:         color = random.choice(choices)
123:         seq.append(int(color))
124:         unused.discard(int(color))
125:     return seq
