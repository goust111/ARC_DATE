117: def _gen_output_panel(h, w, mark_colors, sizes):
118:     """Render non-overlapping connected marks, or return None if packing fails."""
119:     out = np.full((h, w), BLANK_COLOR, dtype=int)
120:     occupied = set()
121:     for color, size in zip(mark_colors, sizes):
122:         cells = _gen_blob_cells(h, w, size, occupied)
123:         if cells is None:
124:             return None
125:         for r, c in cells:
126:             out[r, c] = color
127:         occupied.update(cells)
128:     return out
