107: def _all_count_tuples(n_regions: int) -> list[tuple[int, ...]]:
108:     results: list[tuple[int, ...]] = []
109: 
110:     def rec(start: int, remaining_regions: int, remaining_total: int, current: list[int]) -> None:
111:         if remaining_regions == 0:
112:             if remaining_total == 0:
113:                 results.append(tuple(current))
114:             return
115: 
116:         min_rest = sum(range(start + 1, start + remaining_regions))
117:         for value in range(start, remaining_total + 1):
118:             if remaining_total - value < min_rest:
119:                 break
120:             current.append(value)
121:             rec(value + 1, remaining_regions - 1, remaining_total - value, current)
122:             current.pop()
123: 
124:     for total in range(5, 13):
125:         rec(1, n_regions, total, [])
126: 
127:     assert results, "expected at least one feasible distinct count tuple"
128:     return results
