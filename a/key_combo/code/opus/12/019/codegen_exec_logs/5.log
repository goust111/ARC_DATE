+    best = max(vote_counts)
+    assert vote_counts.count(best) == 1, "expected a unique winning band"
+    return vote_counts.index(best)
+
+
+def _render_output(
+    shape: tuple[int, int],
+    markers: list[tuple[int, int, int]],
+    bands: list[tuple[int, int]],
+    winner: int,
+) -> np.ndarray:
