219: def _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:
220:     """Choose hole color and the same-width column palette row."""
221:     available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]
