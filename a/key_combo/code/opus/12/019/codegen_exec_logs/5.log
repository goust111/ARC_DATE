68: def main(grid: np.ndarray) -> np.ndarray:
69:     """
70:     Extend diagonal rays outward from outer-border segments adjacent to diamond shapes on a checkerboard.
71: 
72:     Input structure:
73:     - Checkerboard bg (two most common colors).
74:     - Hollow diamond outlines (8-pixel) in a non-bg color (inner border).
75:     - Short diagonal line segments in another non-bg color adjacent to each diamond edge (outer border).
76: 
77:     Rule:
78:     - For each outer-border segment, determine the outward direction (perpendicular to the segment, away from the diamond).
79:     - From each endpoint of the segment, cast a diagonal ray outward, painting over bg pixels with the segment's color until hitting a non-bg pixel or the grid edge.
80: 
81:     Key insight: Rays emit only from the two endpoints of each outer-border segment, not every pixel, and travel diagonally away from the diamond.
82:     """
83:     g = np.asarray(grid, dtype=int)
84:     h, w = g.shape
85: 
86:     # The checkerboard background uses the two most frequent colors (typically 0 and 1).
87:     bg_colors = set(_top_k_colors(g, 2))
88: 
89:     # Find diamond inner borders (size-8 diamond components) in non-background colors.
90:     non_bg = set(int(v) for v in np.unique(g)) - bg_colors
91:     comps = _components8_by_color(g, non_bg)
92:     diamonds: list[tuple[int, list[tuple[int, int]]]] = [(col, pts) for col, pts in comps if _is_diamond8(pts)]
93: 
94:     out = g.copy()
95: 
96:     # Process diamonds in stable order (top-left by bbox).
97:     def bbox_key(item):
98:         _, pts = item
99:         return _bbox(pts)
100: 
101:     for _, dpts in sorted(diamonds, key=bbox_key):
102:         dset = set(dpts)
103: 
104:         # Collect all adjacent non-bg (non checkerboard) pixels that are not part of the diamond.
105:         adj = []
106:         for r, c in dpts:
107:             for rr, cc in neighbors8(r, c):
108:                 if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dset:
109:                     v = int(g[rr, cc])
110:                     if v not in bg_colors:
111:                         adj.append((rr, cc))
112: 
113:         if not adj:
114:             continue
115: 
116:         # Build mask for these adjacent pixels and extract their 8-connected components.
117:         adj_mask = np.zeros((h, w), dtype=bool)
118:         for r, c in adj:
119:             adj_mask[r, c] = True
120:         outer_comps = _cc8(adj_mask)
121: 
122:         for oc in outer_comps:
123:             ocol = int(g[oc[0][0], oc[0][1]])
124:             info = _outer_line_info(oc)
125:             if info is None:
126:                 continue
127:             slope_key, endpoints = info
128: 
129:             if slope_key == "rc_diff":
130:                 # line direction along (1,1); candidate normals are (-1,1) and (1,-1)
131:                 normals = [(-1, 1), (1, -1)]
132:             else:
133:                 # line direction along (1,-1); candidate normals are (-1,-1) and (1,1)
134:                 normals = [(-1, -1), (1, 1)]
135: 
136:             # Choose inward normal by best overlap with diamond when shifting outer by that normal.
137:             best_n = None
138:             best_score = -1
139:             for n in normals:
140:                 sc = sum(((r + n[0], c + n[1]) in dset) for r, c in oc)
141:                 if sc > best_score:
142:                     best_score = sc
143:                     best_n = n
144:             if best_n is None or best_score <= 0:
145:                 continue
146:             outward = (-best_n[0], -best_n[1])
147: 
148:             # Endpoints (two extremes along the diagonal line).
149:             p0 = endpoints[0]
150:             p1 = endpoints[-1]
151:             for pr, pc in (p0, p1):
152:                 rr, cc = pr + outward[0], pc + outward[1]
153:                 while 0 <= rr < h and 0 <= cc < w:
154:                     if int(out[rr, cc]) in bg_colors:
155:                         out[rr, cc] = ocol
156:                     else:
157:                         break
158:                     rr += outward[0]
159:                     cc += outward[1]
160: 
161:     return out
