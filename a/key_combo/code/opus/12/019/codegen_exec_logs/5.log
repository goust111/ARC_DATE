127: def main(grid: np.ndarray) -> np.ndarray:
128:     """
129:     Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.
130: 
131:     Input structure
132:     - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.
133:     - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.
134: 
135:     Rule
136:     - Treat wall pixels as blocked and every other pixel as passable.
137:     - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.
138:     - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.
139: 
140:     Key insight
141:     - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.
142:     """
143:     g = np.asarray(grid, dtype=int)
144:     assert g.ndim == 2
145: 
146:     bg = get_bg(g)
147:     counts = Counter(map(int, g.flat))
148: 
149:     non_bg = colors_present(g, exclude={bg})
150:     assert len(non_bg) == 2
151:     assert counts[bg] > max(counts[color] for color in non_bg)
152:     non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}
153:     wall_count = max(non_bg_counts.values())
154:     wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]
155:     assert len(wall_candidates) == 1
156:     wall = wall_candidates[0]
157:     paint_candidates = [color for color in non_bg if color != wall]
158:     assert len(paint_candidates) == 1
159:     paint = paint_candidates[0]
160:     assert non_bg_counts[wall] > non_bg_counts[paint]
161: 
162:     endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)
163:     assert len(endpoints) == 2
164:     endpoint_coords = [component["coords"] for component in endpoints]
165: 
166:     room_sizes: set[int] = set()
167:     for coords in endpoint_coords:
168:         r0, c0, r1, c1 = bbox_coords(coords)
169:         bh = r1 - r0 + 1
170:         bw = c1 - c0 + 1
171:         assert coords.shape[0] == bh * bw
172:         room_sizes.add(max(bh, bw))
173: 
174:     passable = g != wall
175:     dist0 = _distances_from(endpoint_coords[0], passable)
176:     dist1 = _distances_from(endpoint_coords[1], passable)
177:     endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]
178:     reachable_distances = [d for d in endpoint_distances if d >= 0]
179:     assert len(reachable_distances) == len(endpoint_distances)
180:     shortest = min(reachable_distances)
