194: def _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:
195:     """Grid sizes where the mask remains the unique largest non-bg object."""
196:     max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))
197:     min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))
198:     min_w = max(GRID_SIDE_MIN, int(mask_w))
199:     choices: list[tuple[int, int]] = []
200:     for h in range(min_h, GRID_SIDE_MAX + 1):
201:         for w in range(min_w, GRID_SIDE_MAX + 1):
202:             if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:
203:                 choices.append((h, w))
204:     return choices
205: 
206: 
207: def _sample_dimensions() -> tuple[int, int, int, int, int] | None:
208:     """Sample mask size, layout gap, and compatible grid size."""
209:     mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)
210:     mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)
211:     gap = random.randint(GAP_MIN, GAP_MAX)
212:     grid_choices = _grid_choices(mask_h, mask_w, gap)
213:     if not grid_choices:
214:         return None
215:     grid_h, grid_w = random.choice(grid_choices)
216:     return mask_h, mask_w, gap, grid_h, grid_w
