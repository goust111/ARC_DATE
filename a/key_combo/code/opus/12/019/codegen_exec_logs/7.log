+
+def _gen_attempt() -> np.ndarray | None:
+    target_counts = _generate_counts()
+    one_positions = [(r, c) for r in range(GRID_BLOCKS) for c in range(GRID_BLOCKS) if int(target_counts[r, c]) == 1]
