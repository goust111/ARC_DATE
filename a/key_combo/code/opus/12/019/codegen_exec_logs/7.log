+    if not np.array_equal(actual_counts, target_counts):
+        return False
+    if len(set(map(int, target_counts.flatten()))) < 2:
+        return False
+    if not has_near_miss or not has_noisy_true:
+        return False
+    if not (set(blue_totals[0]) & set(blue_totals[1])):
