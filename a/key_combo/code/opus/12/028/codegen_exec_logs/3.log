+
+def semantic_checks(grid: np.ndarray) -> bool:
+    details = solve_details(grid)
+    if details["layer_order"] == details["size_order"]:
+        return False
+
+    sizes = details["sizes"]
+    for i in range(1, len(sizes)):
+        if sizes[i][0] > sizes[i - 1][0] - 2 or sizes[i][1] > sizes[i - 1][1] - 2:
