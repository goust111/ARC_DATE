+
+MIN_RING_SIDE = 4
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
+RING_COUNT_CHOICES = (3, 4)
+RING_COLORS = tuple(range(1, 10))
+CLIP_SIDES = (None, "top", "bottom", "left", "right")
+MAX_GEN_ATTEMPTS = 500
