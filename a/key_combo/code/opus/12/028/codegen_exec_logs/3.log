+    seen: set[tuple[int, int, int, int]] = set()
+    observed = {tuple(map(int, rc)) for rc in points}
+
+    for r0, r1, c0, c1 in itertools.product(tops, bottoms, lefts, rights):
+        bbox = (int(r0), int(c0), int(r1), int(c1))
+        if bbox in seen:
