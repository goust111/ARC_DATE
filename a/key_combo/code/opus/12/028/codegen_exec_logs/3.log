+    h_grid, w_grid = grid.shape
+    min_r, min_c = points.min(axis=0)
+    max_r, max_c = points.max(axis=0)
+
+    tops = [int(min_r)]
+    bottoms = [int(max_r)]
+    lefts = [int(min_c)]
+    rights = [int(max_c)]
+    if int(min_r) == 0:
+        tops.append(-1)
+    if int(max_r) == h_grid - 1:
