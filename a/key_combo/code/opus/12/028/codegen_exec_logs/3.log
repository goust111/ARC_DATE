+    elif clip_side == "bottom":
+        r0 = h_grid - height + 1
+    else:
+        r0 = rng.randint(0, h_grid - height)
+
+    if clip_side == "left":
+        c0 = -1
+    elif clip_side == "right":
+        c0 = w_grid - width + 1
+    else:
