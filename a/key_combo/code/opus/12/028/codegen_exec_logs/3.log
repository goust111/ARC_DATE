+def build_output(details: dict) -> np.ndarray:
+    outer_h, outer_w = details["sizes"][0]
+    out = np.zeros((outer_h, outer_w), dtype=int)
+
+    prev_r = 0
+    prev_c = 0
+    prev_h = outer_h
+    prev_w = outer_w
+    for idx, (height, width) in enumerate(details["sizes"]):
+        color = int(details["layer_order"][idx])
+        if idx == 0:
+            r = 0
+            c = 0
+        else:
