+        for idx in range(1, count):
+            remaining_children = count - idx - 1
+            min_h = 4 + 2 * remaining_children
+            min_w = 4 + 2 * remaining_children
+            choices: list[tuple[int, int]] = []
+            for next_h in range(min_h, cur_h - 1):
