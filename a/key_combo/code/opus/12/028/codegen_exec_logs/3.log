+def render_ring_patch(height: int, width: int, color: int) -> np.ndarray:
+    patch = np.zeros((height, width), dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
+
+
+def topo_unique(nodes: list[int], edges: dict[int, set[int]]) -> list[int] | None:
+    indeg = {node: 0 for node in nodes}
+    for src, dsts in edges.items():
+        for dst in dsts:
+            indeg[dst] += 1
+
+    ready = sorted(node for node in nodes if indeg[node] == 0)
+    order: list[int] = []
+    while ready:
+        if len(ready) != 1:
+            return None
+        node = ready.pop()
+        order.append(node)
+        for dst in sorted(edges[node]):
+            indeg[dst] -= 1
+            if indeg[dst] == 0:
+                ready.append(dst)
+        ready.sort()
+    if len(order) != len(nodes):
+        return None
+    return order
+
