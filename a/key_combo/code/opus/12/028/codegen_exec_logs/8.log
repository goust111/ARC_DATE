+            if values != {color_b}:
+                return False
+        else:
+            if values != {BACKGROUND}:
+                return False
+
+    if np.array_equal(left, np.fliplr(left)):
+        return False
+
+    return True
+
+
+def _gen_attempt(want_odd_distance: bool) -> np.ndarray | None:
+    height = random.randint(*HEIGHT_RANGE)
+    half_width = random.randint(*HALF_WIDTH_RANGE)
+    width = 2 * half_width
