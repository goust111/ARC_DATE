                dr = int(pr) - int(sr)
                dc = int(pc) - int(sc)
                placed = {
                    (dr + int(r), dc + int(c))
                    for r, c in shape_cells
                }
                if not pocket_cells <= placed:
                    continue
                if any(r < 0 or r >= H or c < 0 or c >= W for r, c in placed):
                    continue
                if placed & blue_cells:
                    continue
                return True
    return False


