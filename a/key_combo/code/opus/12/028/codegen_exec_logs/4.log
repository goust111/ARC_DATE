+        if int(grid[br, bc]) != color:
+            return None
+
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if np.any(interior == color) or np.any(interior == connector_color):
+        return None
+    motif_mask = interior != BG
+    if not motif_mask.any():
+        return None
+    motif = _crop_to_bbox(interior, motif_mask)
