        dr, dc = DIR_TO_STEP[sprite["direction"]]
        positions.append((int(pr + dr), int(pc + dc)))

    min_r = min(r for r, _ in positions)
    min_c = min(c for _, c in positions)
    max_r = max(r for r, _ in positions)
    max_c = max(c for _, c in positions)
