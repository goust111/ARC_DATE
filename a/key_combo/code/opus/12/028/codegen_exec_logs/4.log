    for _ in range(300):
        order = list(range(len(sprites)))
        rng.shuffle(order)
        placements: dict[int, tuple[int, int]] = {}
        blocked = np.zeros((h, w), dtype=bool)
        ok = True
        for idx in order:
            sh, sw = sprites[idx].shape
            cells: list[tuple[int, int]] = []
            for r in range(h - sh + 1):
