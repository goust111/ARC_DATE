    rr = 1 + (3 - mh) // 2
    cc = 1 + (3 - mw) // 2
    icon[rr : rr + mh, cc : cc + mw] = motif
    pr, pc = DIR_TO_ICON_POS[direction]
    icon[pr, pc] = connector_color
    return icon


