+                    (cr - 1, cc - 1),
+                    (cr - 1, cc),
+                    (cr - 1, cc + 1),
+                    (cr, cc - 1),
+                    (cr, cc + 1),
+                    (cr + 1, cc - 1),
+                    (cr + 1, cc),
+                    (cr + 1, cc + 1),
