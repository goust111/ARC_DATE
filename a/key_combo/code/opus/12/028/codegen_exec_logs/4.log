from __future__ import annotations

import random
from collections import deque

import numpy as np


BG = 0
TAIL_COLOR = 5
BORDER_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
MOTIF_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)

DIR_TO_STEP = {
    "up": (-4, 0),
    "right": (0, 4),
    "down": (4, 0),
    "left": (0, -4),
}

DIR_TO_ICON_POS = {
    "up": (0, 2),
    "right": (2, 4),
    "down": (4, 2),
    "left": (2, 0),
}


def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _crop_to_bbox(grid: np.ndarray, mask: np.ndarray) -> np.ndarray:
    b = _bbox(mask)
    assert b is not None
    r0, c0, r1, c1 = b
    return grid[r0 : r1 + 1, c0 : c1 + 1]


def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
    mask = grid == color
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while q:
                cr, cc = q.popleft()
                comp.append((cr, cc))
                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps


def _rounded_border_positions(h: int, w: int) -> set[tuple[int, int]]:
    pts = set()
    for c in range(1, w - 1):
        pts.add((0, c))
        pts.add((h - 1, c))
    for r in range(1, h - 1):
        pts.add((r, 0))
        pts.add((r, w - 1))
    return pts


def _make_icon(frame_color: int, connector_color: int, direction: str, motif: np.ndarray) -> np.ndarray:
    icon = np.zeros((5, 5), dtype=int)
    icon[0, 1:4] = frame_color
    icon[4, 1:4] = frame_color
    icon[1:4, 0] = frame_color
    icon[1:4, 4] = frame_color
