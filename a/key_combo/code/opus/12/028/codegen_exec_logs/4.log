+def _assemble_chain(ordered: list[dict]) -> np.ndarray:
+    positions = [(0, 0)]
+    for sprite in ordered[:-1]:
+        pr, pc = positions[-1]
+        dr, dc = DIR_TO_STEP[sprite["direction"]]
+        positions.append((int(pr + dr), int(pc + dc)))
