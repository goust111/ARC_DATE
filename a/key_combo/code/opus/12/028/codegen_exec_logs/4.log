+BG = 0
+TAIL_COLOR = 5
+BORDER_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MOTIF_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+DIR_TO_STEP = {
+    "up": (-4, 0),
+    "right": (0, 4),
+    "down": (4, 0),
+    "left": (0, -4),
+}
+
+DIR_TO_ICON_POS = {
+    "up": (0, 2),
+    "right": (2, 4),
+    "down": (4, 2),
+    "left": (2, 0),
