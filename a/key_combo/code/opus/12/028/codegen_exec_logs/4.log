    motif = _crop_to_bbox(interior, motif_mask)
    mh, mw = motif.shape
    if mh > 3 or mw > 3:
        return None

    return {
        "bbox": (int(r0), int(c0), int(r1), int(c1)),
        "border_color": int(color),
        "connector_color": int(connector_color),
        "direction": direction,
        "motif": motif.copy(),
        "icon": _make_icon(int(color), int(connector_color), direction, motif),
