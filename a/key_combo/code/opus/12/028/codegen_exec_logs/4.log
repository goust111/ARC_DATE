+
+
+def _make_walk(rng: random.Random, n: int) -> list[str]:
+    dirs = list(DIR_TO_STEP)
+    for _ in range(200):
+        path_dirs: list[str] = []
+        pos = (0, 0)
+        seen = {pos}
+        prev = None
+        ok = True
+        for step_idx in range(n - 1):
+            candidates = []
+            for name in dirs:
+                dr, dc = {
+                    "up": (-1, 0),
+                    "right": (0, 1),
+                    "down": (1, 0),
+                    "left": (0, -1),
+                }[name]
+                nxt = (pos[0] + dr, pos[1] + dc)
+                if nxt in seen:
+                    continue
+                candidates.append((name, nxt))
+            if not candidates:
+                ok = False
+                break
+            if prev is not None:
+                turners = [cand for cand in candidates if cand[0] != prev]
+                if turners and (step_idx == n - 2 or rng.random() < 0.7):
+                    candidates = turners
