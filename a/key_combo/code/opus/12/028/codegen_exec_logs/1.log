+def _simulate_staircases(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int).copy()
+    H, W = g.shape
+    anchors = _extract_anchors(g)
+    owner = np.full((H, W), -1, dtype=int)
+    for idx, (r, c, _color) in enumerate(anchors):
