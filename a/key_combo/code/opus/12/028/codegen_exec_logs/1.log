                    grid[rr][cc]=5; owner[rr][cc]=arm['idx']
            arm['ptr']+=1
        # arms with no proposal because stopped remain; proposals with single owner progress
    # holes
    vis=[[False]*W for _ in range(H)]
    holes=[]
    for r in range(H):
      for c in range(W):
        if grid[r][c]"'!=0 or vis[r][c]: continue
        st=[(r,c)]; vis[r][c]=True; comp=[]; touch=False
        while st:
          x,y=st.pop(); comp.append((x,y));
          if x in (0,H-1) or y in (0,W-1): touch=True
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W and not vis[nx][ny] and grid[nx][ny]==0:
              vis[nx][ny]=True; st.append((nx,ny))
        if not touch: holes.append(comp)
    return holes, grid

colors=[1,2,3,4,6,7,8,9]
pts=[(r,c) for r in range(3,H-3) for c in range(3,W-3)]

def ok_dist(ps):
    for i,(r1,c1) in enumerate(ps):
        for r2,c2 in ps[i+1:]:
            if abs(r1-r2)+abs(c1-c2) < 5:
