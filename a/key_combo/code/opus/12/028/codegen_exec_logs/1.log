+                "anchor_idx": idx,
+                "r": r,
+                "c": c,
+                "dirs": ((-1, 0), (0, 1)),
+                "dir_index": 0,
+                "steps_in_segment": 0,
+                "live": True,
+            }
+        )
+        arms.append(
+            {
+                "anchor_idx": idx,
+                "r": r,
+                "c": c,
+                "dirs": ((1, 0), (0, -1)),
+                "dir_index": 0,
+                "steps_in_segment": 0,
+                "live": True,
+            }
+        )
