+            if len(proposer_owners) > 1:
+                collision_count += len(arm_ids)
+                for arm_id in arm_ids:
+                    arms[arm_id]["live"] = False
+                continue
+
+            anchor_idx = arms[arm_ids[0]]["anchor_idx"]
+            if g[nr, nc] == BACKGROUND:
+                g[nr, nc] = STAIR
+                owner[nr, nc] = anchor_idx
+
+            for arm_id in arm_ids:
