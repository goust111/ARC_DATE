+    boundary_pixels = set()
+    for r, c in region:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < H and 0 <= nc < W and stair_grid[nr, nc] == STAIR:
+                boundary_pixels.add((nr, nc))
