        q=[(r,c)]; vis[r][c]=True; comp=[]; touch=False
        while q:
          x,y=q.pop(); comp.append((x,y));
          if x in (0,H-1) or y in (0,W-1): touch=True
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
