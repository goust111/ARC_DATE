    owner=[[None]*W for _ in range(H)]
    for idx,(r,c,col) in enumerate(anchors):
        grid[r][c]=col; owner[r][c]=idx
    arms=[]
    for idx,(r,c,col) in enumerate(anchors):
        for arm in (0,1):
            arms.append({'idx':idx,'seq':seq((r,c),arm),'ptr':0,'live':True})
    for t in range(200):
        proposals=defaultdict(list)
        live=False
        for ai,arm in enumerate(arms):
            if not arm['live']: continue
            live=True
            rr,cc=arm['seq'][arm['ptr']]
            if not (0<=rr<H and 0<=cc<W):
                arm['live']=False; continue
            cell=grid[rr][cc]
            own=owner[rr][cc]
            if cell==5 and own "'!= arm['"'idx']:
                arm['live']=False; continue
            if cell"'!=0 and cell!=5 and own != arm['"'idx']:
                arm['live']=False; continue
            proposals[(rr,cc)].append(ai)
        if not live: break
        # resolve proposals
        for cell,idxs in proposals.items():
            owners={arms[i]['idx'] for i in idxs}
            if len(owners) >= 2:
                # same-cell collision: all stop, no draw
                for i in idxs:
                    arms[i]['live']=False
