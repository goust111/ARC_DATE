+    collision_count = 0
+    for _ in range(H * W * 2):
+        proposals: dict[tuple[int, int], list[int]] = defaultdict(list)
+        any_live = False
+        for arm_id, arm in enumerate(arms):
+            if not arm["live"]:
+                continue
+            any_live = True
+            dr, dc = arm["dirs"][arm["dir_index"]]
+            nr = arm["r"] + dr
+            nc = arm["c"] + dc
+            if not (0 <= nr < H and 0 <= nc < W):
