+    if random.random() < 0.5:
+        grid = np.flipud(grid).copy()
+    if random.random() < 0.5:
+        grid = np.fliplr(grid).copy()
+    return grid
+
+
+def _valid_input(grid: np.ndarray) -> bool:
+    colors = sorted(set(map(int, grid.flatten())) - {BLACK})
+    if len(colors) != 1:
+        return False
