0017: def main(input_grid):
0018:     """
0019:     Expand a vertical colored line into a centered alternating-color pyramid.
0020: 
0021:     Input structure:
0022:     - The input contains one non-black line segment on a black background.
0023:     - The line's dominant column gives the pyramid center column.
0024:     - The line length determines the pyramid height and widest row.
0025: 
0026:     Rule:
0027:     - Identify the line color, center column, and lowest occupied row.
0028:     - Build a black output grid of the same size.
0029:     - For each row above the line base, draw a centered run whose colors alternate by distance from the center.
0030: 
0031:     Key insight:
0032:     - The original line is the pyramid axis; moving upward shortens the run, while
0033:       horizontal parity controls the alternating colors.
0034:     """
0035:     # Plan (from the original seed solver):
0036:     # 1. Parse the input
0037:     # 2. Draw the left side of the pyramid
0038:     # 3. Draw the right side of the pyramid
0039:     #
0040:     # Note: the legacy seed version ran under a transpose wrapper. This migrated solver
0041:     # runs canonical `(r,c)`, so some low-level details differ, but the intent is the same.
0042: 
0043:     coords = np.argwhere(input_grid != Color.BLACK)
0044:     if coords.size == 0:
0045:         return input_grid.copy()
0046: 
0047:     # Line parameters
0048:     r_max = int(coords[:, 0].max())
0049:     cols, counts = np.unique(coords[:, 1], return_counts=True)
0050:     c0 = int(cols[int(np.argmax(counts))])
0051:     line_color = int(input_grid[int(coords[0, 0]), int(coords[0, 1])])
0052: 
0053:     if line_color == Color.ORANGE:
0054:         alt_color = Color.TEAL
0055:     elif line_color == Color.TEAL:
0056:         alt_color = Color.ORANGE
0057:     else:
0058:         alt_color = Color.TEAL
0059: 
0060:     H, W = input_grid.shape
0061:     out = np.full((H, W), Color.BLACK, dtype=int)
0062: 
0063:     # For each row of the line, draw a centered run with alternating colors.
0064:     for r in range(r_max + 1):
0065:         half = r_max - r
