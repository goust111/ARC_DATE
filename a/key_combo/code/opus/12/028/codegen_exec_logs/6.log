+def _border_cells(sprite: dict) -> list[tuple[int, int]]:
+    r0, c0 = sprite["top_left"]
+    patch = sprite["patch"]
+    cells = []
+    for rr, cc in RING_POSITIONS:
+        if int(patch[rr, cc]) == sprite["border"]:
