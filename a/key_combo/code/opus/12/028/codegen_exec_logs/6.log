+def _rects_too_close(a: tuple[int, int], b: tuple[int, int], gap: int = 1) -> bool:
+    ar0, ac0 = a
+    br0, bc0 = b
+    ar1, ac1 = ar0 + 2, ac0 + 2
+    br1, bc1 = br0 + 2, bc0 + 2
