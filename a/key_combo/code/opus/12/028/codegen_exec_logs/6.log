+        for i in range(len(path) - 1)
+    ]
+    for d1, d2 in zip(directions, directions[1:]):
+        if d1 == d2:
+            continue
+        if d1[0] == -d2[0] and d1[1] == -d2[1]:
+            bends += 2
+        else:
