+    ar0, ac0 = a
+    br0, bc0 = b
+    ar1, ac1 = ar0 + 2, ac0 + 2
+    br1, bc1 = br0 + 2, bc0 + 2
+    return not (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
