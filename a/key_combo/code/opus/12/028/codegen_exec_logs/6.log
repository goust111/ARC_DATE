+
+def _make_sprite(border: int, center: int, notch_index: int) -> np.ndarray:
+    patch = np.full((3, 3), int(border), dtype=int)
+    patch[1, 1] = int(center)
+    nr, nc = NOTCH_OFFSETS[int(notch_index) % 4]
+    patch[nr, nc] = BG
