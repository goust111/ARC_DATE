+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PATH_COLOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+NOTCH_OFFSETS = ((0, 0), (0, 2), (2, 2), (2, 0))
+RING_POSITIONS = tuple((r, c) for r in range(3) for c in range(3) if (r, c) != (1, 1))
