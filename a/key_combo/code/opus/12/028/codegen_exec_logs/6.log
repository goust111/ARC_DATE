+        if len(nonzero_ring) not in {7, 8}:
+            continue
+        if len(set(nonzero_ring)) != 1:
+            continue
+        border = nonzero_ring[0]
+        if border == center or border == PATH_COLOR:
+            continue
+        if sum(color == BG for color in ring) > 1:
