  grid: 20-23 rows x 20-23 cols, always square [observed]
  background: 0 (black)
  foreground: exactly 1 non-background color (any ARC color)
  objects:
    count: exactly 4, 8-connected components of the single foreground color
    symmetric: 3 objects whose tight-bbox foreground mask is LR-symmetric
