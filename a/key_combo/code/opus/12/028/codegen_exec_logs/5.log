+                break
+        if not ok:
+            continue
+
+        if use_foil:
+            placed = False
+            for _ in range(160):
+                foil_specs = _make_input_mirror_foil_specs(height, width)
+                if foil_specs is not None and _can_add_specs(specs, foil_specs, height, width):
