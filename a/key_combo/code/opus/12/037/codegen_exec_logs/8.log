    """Valid marker-center row/col ranges ensuring EDGE_GAP from all grid edges."""
    min_r, max_r, min_c, max_c = _SPRITE_EXTENT[direction]
    return (range(EDGE_GAP - min_r, H - EDGE_GAP - max_r),
