+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+CTRL = 2
+RAY = 3
+BLOCK = 4
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SHAPES = [(3, 3), (3, 4), (4, 3)]
+GRID_ROWS = (18, 24)
+GRID_COLS = (18, 24)
+BLOCK_COUNT = (4, 6)
+LENGTHS = (1, 2, 3, 4)
+MIN_BLOCK_DISTANCE = 4
+GEN_ATTEMPTS = 400
+ASSIGN_ATTEMPTS = 250
+PAIR_ATTEMPTS = 250
