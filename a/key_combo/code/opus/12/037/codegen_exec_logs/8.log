+def _compatible_dirs(h: int, w: int) -> list[tuple[int, int]]:
+    dirs: list[tuple[int, int]] = []
+    if h % 2 == 1:
+        dirs.extend([(0, -1), (0, 1)])
+    if w % 2 == 1:
+        dirs.extend([(-1, 0), (1, 0)])
+    return dirs
