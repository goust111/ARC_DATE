+            sc = random.randint(0, max_sc)
+            ray_row = sr + sh // 2
+            min_or = max(0, ray_row - oh + 1)
+            max_or = min(ray_row, h - oh)
+            if min_or > max_or:
+                continue
+            orow = random.randint(min_or, max_or)
+            ocol = sc + sw + 3
+        elif direction == (0, -1):
+            max_sr = h - sh
+            min_sc = ow + 3
+            max_sc = w - sw
+            if max_sr < 0 or min_sc > max_sc:
+                continue
+            sr = random.randint(0, max_sr)
+            sc = random.randint(min_sc, max_sc)
+            ray_row = sr + sh // 2
+            min_or = max(0, ray_row - oh + 1)
+            max_or = min(ray_row, h - oh)
+            if min_or > max_or:
+                continue
+            orow = random.randint(min_or, max_or)
+            ocol = sc - ow - 3
+        elif direction == (1, 0):
+            max_sr = h - (sh + 3 + oh)
+            max_sc = w - sw
+            if max_sr < 0 or max_sc < 0:
+                continue
+            sr = random.randint(0, max_sr)
+            sc = random.randint(0, max_sc)
+            ray_col = sc + sw // 2
+            min_oc = max(0, ray_col - ow + 1)
+            max_oc = min(ray_col, w - ow)
+            if min_oc > max_oc:
+                continue
+            orow = sr + sh + 3
+            ocol = random.randint(min_oc, max_oc)
+        else:
+            min_sr = oh + 3
+            max_sr = h - sh
+            max_sc = w - sw
+            if min_sr > max_sr or max_sc < 0:
+                continue
+            sr = random.randint(min_sr, max_sr)
+            sc = random.randint(0, max_sc)
+            ray_col = sc + sw // 2
+            min_oc = max(0, ray_col - ow + 1)
+            max_oc = min(ray_col, w - ow)
+            if min_oc > max_oc:
+                continue
+            orow = sr - oh - 3
+            ocol = random.randint(min_oc, max_oc)
