+    if len({p["direction"] for p in plan}) < 2:
+        return False
+    if len({p["length"] for p in plan}) < 2:
+        return False
+    if not any(p["bounced"] for p in plan):
+        return False
+    if not any(not p["bounced"] for p in plan):
+        return False
+    return True
