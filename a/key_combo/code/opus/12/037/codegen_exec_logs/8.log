        if not options:
            return False
        option = random.choice(options)
        _gen_apply_notch(top, bottom, option)
        remaining_budget -= option[3]
        remaining_notches -= 1
    return True


def _gen_patch_from_profiles(top, bottom, color):
    height = max(bottom) + 1
