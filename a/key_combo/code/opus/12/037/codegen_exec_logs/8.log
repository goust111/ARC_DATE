        assert _color_set(g, comp["coords"]) <= {skeleton, anchor}, "target motif already has non-anchor markers"
        target_skeleton = {
            (int(r), int(c))
            for r, c in comp["coords"]
            if int(g[int(r), int(c)]) == int(skeleton)
        }
