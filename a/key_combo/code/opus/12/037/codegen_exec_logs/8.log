+def _placements() -> tuple[int, int, list[dict], int, tuple[int, int]] | None:
+    h = random.randint(*GRID_ROWS)
+    w = random.randint(*GRID_COLS)
+    count = random.randint(*BLOCK_COUNT)
+    pair = _place_bounce_pair(h, w)
