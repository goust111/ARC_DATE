+def _occupancy(placed: list[dict], shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray]:
+    grid = np.zeros(shape, dtype=int)
+    labels = np.full(shape, -1, dtype=int)
+    for block in placed:
+        r0, c0, r1, c1 = block["bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = BLOCK
