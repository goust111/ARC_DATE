+def _remaining_groups(rects: list[dict[str, object]], obstacle_color: int) -> list[list[Rect]]:
+    by_color: dict[int, list[Rect]] = defaultdict(list)
+    for item in rects:
+        color = int(item["color"])
+        if color == obstacle_color:
