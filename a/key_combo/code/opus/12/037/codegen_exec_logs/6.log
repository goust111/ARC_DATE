+def _rect_gap_ok(a: Rect, b: Rect, gap: int = 2) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
+
+
+def _find_rectangles(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    rects: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BACKGROUND or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if _in_bounds(g.shape, nr, nc) and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
