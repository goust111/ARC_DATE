+def _choose_blocker(src: Rect, dst: Rect, used_rects: list[Rect], reserved: set[tuple[int, int]], shape: tuple[int, int]) -> Rect | None:
+    h_path = _horizontal_first_path(src, dst)
+    v_path = set(_vertical_first_path(src, dst))
