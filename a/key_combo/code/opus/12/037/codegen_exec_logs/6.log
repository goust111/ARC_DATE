+    out, branches = _solve(grid, return_branches=True)
+    if not ({"H", "V"} <= set(branches)):
+        return None
+    if len(_find_rectangles(grid)) != obstacle_count + 2 * pair_count:
+        return None
+    if not np.any(out == OBSTACLE_COLOR):
+        return None
+    return grid
