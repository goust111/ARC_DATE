+    sr0, sc0, sr1, sc1 = src
+    tr0, tc0, tr1, tc1 = dst
+    assert tc0 > sc1 and tr0 > sr1
+
+    cells: list[tuple[int, int]] = []
+    for c in range(sc1 + 1, tc0 + 1):
+        cells.append((sr1, c))
+    for r in range(sr1 + 1, tr0):
+        cells.append((r, tc0))
+    return cells
+
+
+def _vertical_first_path(src: Rect, dst: Rect) -> list[tuple[int, int]]:
+    sr0, sc0, sr1, sc1 = src
+    tr0, tc0, tr1, tc1 = dst
+    assert tc0 > sc1 and tr0 > sr1
