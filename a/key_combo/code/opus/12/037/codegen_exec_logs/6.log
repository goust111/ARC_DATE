+        cells.append((r, sc1))
+    for c in range(sc1 + 1, tc0):
+        cells.append((tr0, c))
+    return cells
+
+
+def _path_is_background(path: list[tuple[int, int]], occupied: np.ndarray) -> bool:
+    return all(_in_bounds(occupied.shape, r, c) and not occupied[r, c] for r, c in path)
