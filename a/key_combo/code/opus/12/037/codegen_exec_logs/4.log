+    green_cells: set[tuple[int, int]] = set()
+    hits = {"horizontal": 0, "vertical": 0, "cross": 0}
+
+    while True:
+        state = (int(r), int(c), int(dr), int(dc))
+        assert state not in visited, "ray entered a non-start cycle"
+        visited.add(state)
