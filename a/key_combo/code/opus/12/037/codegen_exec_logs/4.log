+    assert out[p0] == TEAL and out[p1] == TEAL
+    return out
+
+
+def _block_start(block_index: int, side: int) -> int:
+    return int(block_index) * (int(side) + 1)
+
+
+def _edge_blocks(k: int) -> list[tuple[int, int]]:
+    blocks = []
+    for br in range(k):
+        for bc in range(k):
