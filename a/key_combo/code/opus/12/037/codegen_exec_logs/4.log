+
+
+def _valid_square_blocks(k: int) -> list[tuple[int, int]]:
+    blocks = _edge_blocks(k)
+    random.shuffle(blocks)
+    return blocks
+
+
+def _semantic_checks(inp: np.ndarray, out: np.ndarray, info: dict[str, object], side: int) -> bool:
+    try:
