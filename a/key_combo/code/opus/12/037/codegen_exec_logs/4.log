+
+    info = {
+        "output": out,
+        "termination": termination,
+        "hits": hits,
+        "profile": _candidate_profile(termination, hits),
+        "green_cells": green_cells,
+        "source": source,
+        "other": other,
+        "direction": choice["direction"],
+        "square_block": square_block,
+    }
+    return inp, info
