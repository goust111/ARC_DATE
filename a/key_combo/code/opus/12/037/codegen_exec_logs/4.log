+        "loop_split": 1.7,
+        "boundary_cross": 2.0,
+        "boundary_split_both": 1.6,
+        "boundary_horizontal": 1.3,
+        "boundary_vertical": 1.3,
+        "boundary_direct": 1.0,
+    }
+    return [weight_map[p] for p in profiles]
+
+
