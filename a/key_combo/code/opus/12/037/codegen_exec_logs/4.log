+                        "termination": termination,
+                        "hits": hits,
+                        "profile": profile,
+                    }
+                )
+
+            if not profiled:
+                continue
+
+            profiles = sorted(profiled)
+            chosen_profile = random.choices(profiles, weights=_profile_weights(profiles), k=1)[0]
+            choice = random.choice(profiled[chosen_profile])
