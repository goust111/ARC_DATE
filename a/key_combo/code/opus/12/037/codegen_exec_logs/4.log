+        separators = _line_positions(side, inp.shape[0])
+        for idx in separators:
+            row = out[idx]
+            col = out[:, idx]
+            if not np.all(np.isin(row, [GREY, RED])):
+                return False
+            if not np.all(np.isin(col, [GREY, RED])):
+                return False
