+def _marker_sides(marker_rc: tuple[int, int], shape: tuple[int, int]) -> set[str]:
+    r, c = marker_rc
+    h, w = shape
+    sides = set()
+    if r == 0:
+        sides.add("top")
+    if r == h - 1:
+        sides.add("bottom")
+    if c == 0:
+        sides.add("left")
+    if c == w - 1:
+        sides.add("right")
+    return sides
