  51:     """
  52:     Complete each marked object by mirroring its trusted side across the yellow axis.
  53: 
  54:     Input structure:
  55:     - The background is black.
  56:     - Each transformed object has one non-yellow foreground color plus yellow
  57:       pixels.
  58:     - Its yellow pixels contain one contiguous horizontal or vertical mirror
  59:       axis and at least one off-axis yellow control pixel.
  60: 
  61:     Rule:
  62:     - For every object with a yellow axis, use the side containing the off-axis
  63:       yellow control pixel as the source side.
  64:     - Reflect the whole rectangular source half of the object's bounding box
  65:       across the axis, copying both foreground and background pixels onto the
  66:       opposite side.
  67:     - Leave the source side, the axis, and unrelated pixels unchanged unless
  68:       they fall inside a reflected target half.
  69: 
  70:     Key insight:
  71:     - The extra yellow pixel is not another object detail; it marks which half
  72:       of the pattern is correct and should overwrite the other half by symmetry.
  73:     """
  74:     g = np.asarray(grid, dtype=int)
  75:     assert g.ndim == 2, "expected a 2D grid"
  76:     bg = get_bg(g)
  77:     assert bg == Color.BLACK, "expected black background"
  78: 
  79:     out = g.copy()
  80:     processed = 0
  81:     for coords in components_mask(g != bg, connectivity=4):
  82:         if not np.any(g[coords[:, 0], coords[:, 1]] == Color.YELLOW):
  83:             continue
  84: 
  85:         colors = set(map(int, g[coords[:, 0], coords[:, 1]]))
  86:         object_colors = colors - {int(Color.YELLOW)}
  87:         assert len(object_colors) == 1, "each marked object must have one non-yellow color"
  88: 
  89:         orient, axis, yellow = _mirror_axis(g, coords)
  90:         r0, c0, r1, c1 = bbox_coords(coords)
  91:         processed += 1
  92: 
  93:         if orient == "h":
  94:             source_side = _single_side({-1 if r < axis else 1 for r, _ in yellow if r != axis})
  95:             rows = range(r0, axis) if source_side < 0 else range(axis + 1, r1 + 1)
  96:             for src_r in rows:
  97:                 dst_r = 2 * axis - src_r
  98:                 assert 0 <= dst_r < g.shape[0], "reflected row must stay in bounds"
  99:                 out[dst_r, c0 : c1 + 1] = g[src_r, c0 : c1 + 1]
 100:         else:
 101:             source_side = _single_side({-1 if c < axis else 1 for _, c in yellow if c != axis})
 102:             cols = range(c0, axis) if source_side < 0 else range(axis + 1, c1 + 1)
 103:             for src_c in cols:
 104:                 dst_c = 2 * axis - src_c
 105:                 assert 0 <= dst_c < g.shape[1], "reflected column must stay in bounds"
