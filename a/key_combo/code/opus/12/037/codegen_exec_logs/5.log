+        mr, mc = 0, 0
+    elif marker_corner == "tr":
+        pr, pc = 1, 0
+        mr, mc = 0, w
+    elif marker_corner == "bl":
+        pr, pc = 0, 1
+        mr, mc = h, 0
+    elif marker_corner == "br":
+        pr, pc = 0, 0
+        mr, mc = h, w
