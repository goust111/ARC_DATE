+        sides.add("top")
+    if r == h - 1:
+        sides.add("bottom")
+    if c == 0:
+        sides.add("left")
+    if c == w - 1:
+        sides.add("right")
+    return sides
+
+
+def _find_bar_and_notches(grid: np.ndarray) -> tuple[dict, list[dict]]:
