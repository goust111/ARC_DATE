+
+BG = 0
+BAR = 5
+MARKER = 7
+BODY_COLORS = [1, 2, 3, 4]
+OPENING_TO_INWARD = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+CANONICAL_RECT_PAIRS = [(1, 2), (1, 3), (1, 4), (2, 3), (2, 4), (3, 4)]
+MARKER_CORNERS_BY_INWARD = {
