+    if r == 0:
+        sides.add("top")
+    if r == h - 1:
+        sides.add("bottom")
+    if c == 0:
+        sides.add("left")
+    if c == w - 1:
+        sides.add("right")
+    return sides
+
+
+def _find_bar_and_notches(grid: np.ndarray) -> tuple[dict, list[dict]]:
+    grey_comps = _components(grid == BAR, connectivity=4)
+    assert grey_comps, "expected a central grey bar"
+    bar_coords = max(grey_comps, key=len)
