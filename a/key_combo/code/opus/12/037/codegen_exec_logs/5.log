+        seen[r, c] = True
+        pts = []
+        while q:
+            rr, cc = q.popleft()
+            pts.append((rr, cc))
+            for nr, nc in _neighbors(rr, cc, mask.shape, connectivity):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
