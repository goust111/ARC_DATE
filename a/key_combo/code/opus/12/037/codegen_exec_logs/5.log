+
+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[tuple[int, int]]:
+    h, w = shape
+    out = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            if connectivity == 4 and abs(dr) + abs(dc) != 1:
+                continue
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                out.append((rr, cc))
+    return out
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        pts = []
+        while q:
+            rr, cc = q.popleft()
+            pts.append((rr, cc))
+            for nr, nc in _neighbors(rr, cc, mask.shape, connectivity):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(arr: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
