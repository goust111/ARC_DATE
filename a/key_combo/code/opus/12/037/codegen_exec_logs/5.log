+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BAR = 5
+MARKER = 7
+BODY_COLORS = [1, 2, 3, 4]
+OPENING_TO_INWARD = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
