+    r0, c0, r1, c1 = _bbox(bar_coords)
+    bar_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    bar_mask[bar_coords[:, 0] - r0, bar_coords[:, 1] - c0] = True
