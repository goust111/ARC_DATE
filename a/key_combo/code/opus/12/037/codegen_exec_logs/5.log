+    notches = []
+    for pts in _components(~bar_mask, connectivity=4):
+        sides = []
+        if np.any(pts[:, 0] == 0):
+            sides.append("top")
+        if np.any(pts[:, 0] == bar_mask.shape[0] - 1):
+            sides.append("bottom")
+        if np.any(pts[:, 1] == 0):
+            sides.append("left")
+        if np.any(pts[:, 1] == bar_mask.shape[1] - 1):
+            sides.append("right")
