+def _symmetry(coords: tuple[tuple[int, int], ...], idx: int) -> tuple[tuple[int, int], ...]:
+    pts = np.array(coords, dtype=int)
+    r = pts[:, 0]
+    c = pts[:, 1]
+    if idx == 0:
+        rr, cc = r, c
+    elif idx == 1:
+        rr, cc = c, -r
+    elif idx == 2:
+        rr, cc = -r, -c
+    elif idx == 3:
+        rr, cc = -c, r
+    elif idx == 4:
+        rr, cc = r, -c
+    elif idx == 5:
+        rr, cc = c, r
+    elif idx == 6:
+        rr, cc = -r, c
+    else:
