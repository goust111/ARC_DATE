+        key=lambda item: min(_top_left(coords) for coords in item[1]),
+    )
+    for color, (_sig, members) in zip(GROUP_COLORS, ordered):
+        for coords in members:
+            out[coords[:, 0], coords[:, 1]] = color
+    return out
+
