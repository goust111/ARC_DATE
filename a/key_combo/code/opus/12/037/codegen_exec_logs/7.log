+        mask = _mask_in_bbox(coords)
+        color = HOLE_COLOR if _has_hole(mask) else GROUP_COLORS[0]
+        out[coords[:, 0], coords[:, 1]] = color
+    return out
+
+
+def _validate_scene(grid: np.ndarray, placed, expected: np.ndarray, nohole_group_count: int) -> bool:
