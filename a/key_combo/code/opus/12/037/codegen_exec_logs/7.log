+BG = 0
+FG = 5
+HOLE_COLOR = 8
+GROUP_COLORS = (1, 2, 3, 4, 7)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+SLOT_SIZE = 5
+SLOT_GAP = 2
