+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+OBJECT = 5
+HALO = 8
+
+GRID_ROWS_RANGE = (24, 30)
+GRID_COLS_RANGE = (24, 30)
+GENERATION_RETRIES = 500
+PLACEMENT_GAP = 1
+EXTRA_HOLE_WEIGHTS = [0, 0, 1, 1, 2]
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components from a boolean mask as (N,2) coord arrays."""
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _count_holes_from_mask(mask: np.ndarray) -> int:
+    """Count 4-connected background holes inside one object's bbox-local mask."""
+    h, w = mask.shape
+    bg_seen = np.zeros_like(mask, dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or bg_seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            bg_seen[r, c] = True
+            touches_edge = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not bg_seen[nr, nc]:
+                        bg_seen[nr, nc] = True
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_edge = True
+                        q.append((nr, nc))
+            if not touches_edge:
+                holes += 1
+    return holes
+
+
+def _parse_mask(rows: tuple[str, ...]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _transform_mask(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    turns = random.randrange(4)
+    if turns:
+        out = np.rot90(out, k=turns)
+    return np.ascontiguousarray(out)
+
+
+HOLE_FREE_TEMPLATES = (
+    ("1111", "1111"),
+    ("111", "110", "111"),
+    ("1110", "1110", "0111"),
+    ("1111", "0111", "0011"),
+    ("111", "010", "111", "010"),
+)
