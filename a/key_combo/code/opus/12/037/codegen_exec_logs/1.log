+        range(len(specs)),
+        key=lambda idx: specs[idx]["expanded_shape"][0] * specs[idx]["expanded_shape"][1],
+        reverse=True,
+    )
+
+    def rec(k: int) -> bool:
+        if k == len(order):
+            return True
+
+        idx = order[k]
+        spec = specs[idx]
+        eh, ew = spec["expanded_shape"]
+        starts = [
