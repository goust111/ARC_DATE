+        ("1111", "1001", "1111"),
+        ("1111", "1001", "1001", "1111"),
+        ("111", "101", "101", "101", "111"),
+    ),
+    2: (
+        ("11111", "10101", "11111"),
+        ("1111", "1001", "1111", "1001", "1111"),
+        ("11111", "10101", "10101", "11111"),
+    ),
+    3: (
+        ("1111111", "1010101", "1111111"),
+        ("11111", "10001", "11111", "10101", "11111"),
+    ),
+}
