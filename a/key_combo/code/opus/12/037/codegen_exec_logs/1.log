+        ring = np.zeros_like(g, dtype=bool)
+        ring[er0 : er1 + 1, ec0 : ec1 + 1] = True
+        ring[r0 : r1 + 1, c0 : c1 + 1] = False
+        out[ring] = HALO
+
+    out[g == OBJECT] = OBJECT
+    return out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
