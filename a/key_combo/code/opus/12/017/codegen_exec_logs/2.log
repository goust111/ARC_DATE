def _gen_expected_output(inp: np.ndarray, columns: list[int], heights: list[int]) -> np.ndarray:
    out = np.full(inp.shape, BG_COLOR, dtype=int)
    tallest_i = max(range(len(heights)), key=heights.__getitem__)
