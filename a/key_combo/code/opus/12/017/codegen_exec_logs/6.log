def _gen_crop(sprite):
    coords = np.argwhere(sprite == Color.TEAL)
    if coords.size == 0:
        return sprite[:0, :0].copy()
    r0, c0, r1, c1 = bbox_coords(coords)
    return sprite[r0 : r1 + 1, c0 : c1 + 1].copy()


def _gen_hole_sizes_from_coords(coords):
    if coords.size == 0:
