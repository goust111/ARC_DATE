+import numpy as np
+
+
+BG = 0
+MOTIF = 5
+LEGEND_FRAME = 6
+LEGEND_PALETTE = (1, 2, 3, 4, 7, 8, 9)
+MOTIF_SIZE = 5
+INNER_SLICE = slice(1, 4)
+GEN_RETRIES = 400
