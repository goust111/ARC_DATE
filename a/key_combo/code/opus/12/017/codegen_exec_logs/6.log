+        for cc in range(c_count):
+            patch = _build_motif(int(count_grid[rr, cc]))
+            r0 = rr * (MOTIF_SIZE + 1)
+            c0 = cc * (MOTIF_SIZE + 1)
+            canvas[r0 : r0 + MOTIF_SIZE, c0 : c0 + MOTIF_SIZE] = patch
+    return canvas
+
+
+def _render_legend(colors: list[int], orientation: str) -> np.ndarray:
+    if orientation == "h":
