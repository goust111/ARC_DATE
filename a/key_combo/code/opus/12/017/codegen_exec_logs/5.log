    h = bbox_h(component["bbox"])
    w = bbox_w(component["bbox"])
    assert (h, w) == (3, 3)

    mask = np.zeros((h, w), dtype=bool)
    rel = component["coords"] - np.array([r0, c0])
    mask[rel[:, 0], rel[:, 1]] = True
