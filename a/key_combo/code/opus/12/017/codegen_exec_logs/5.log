+            else:
+                left_len += 1
+            rr += h
+            cc += dc_step
+            step += 1
+
+    return {
+        "top": int(top),
+        "left": int(left),
+        "original": original,
+        "all_output": original | copies,
+        "copy_cells": copies,
+        "left_cells": left_cells,
+        "right_cells": right_cells,
+        "red_cells": red_cells,
+        "left_len": left_len,
