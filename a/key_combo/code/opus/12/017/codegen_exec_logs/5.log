+_WINNER_MASKS = [m for m in _ALL_MASKS if int(m.sum()) <= 4 and m.shape[0] <= 3 and m.shape[1] <= 3]
+_LOSER_MASKS = [m for m in _ALL_MASKS if int(m.sum()) >= 4]
