+
+def _pick_winner_layout(grid_shape: tuple[int, int], winner_mask: np.ndarray, period: int) -> list[dict] | None:
+    candidates = _winner_candidates(grid_shape, winner_mask, period)
+    if not candidates:
+        return None
+
