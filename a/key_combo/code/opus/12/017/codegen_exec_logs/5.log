+            visible = {cell for cell in visible if 0 <= cell[0] < grid_shape[0] and 0 <= cell[1] < grid_shape[1]}
+            copies.update(visible)
+            bucket.update(visible)
+            if step % period == 0:
+                red_cells.update(visible)
