+    return {
+        "top": int(top),
+        "left": int(left),
+        "original": original,
+        "all_output": original | copies,
+        "copy_cells": copies,
+        "left_cells": left_cells,
+        "right_cells": right_cells,
+        "red_cells": red_cells,
+        "left_len": left_len,
+        "right_len": right_len,
+    }
+
+
+def _count_options(type_count: int) -> list[list[int]]:
+    options = []
+    for total in range(TOTAL_SPRITES[0], TOTAL_SPRITES[1] + 1):
+        if type_count == 2:
