+
+def _paint_stamp(
+    out: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    color: int,
+    *,
+    red_override: bool,
+    bg: int = BG,
+) -> None:
+    h, w = mask.shape
+    for dr, dc in _coords_from_mask(mask):
+        rr = int(top + dr)
+        cc = int(left + dc)
+        if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+            if red_override:
+                out[rr, cc] = RED
+            elif int(out[rr, cc]) == int(bg):
+                out[rr, cc] = int(color)
+
+
+def _stamp_sequence(
+    out: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    color: int,
+    period: int,
+    dc_step: int,
+    *,
+    bg: int = BG,
+) -> None:
+    h, w = mask.shape
+    step = 1
+    rr = top + h
+    cc = left + dc_step
+    while rr < out.shape[0] and cc < out.shape[1] and cc + w > 0:
+        _paint_stamp(out, mask, rr, cc, color, red_override=(step % period == 0), bg=bg)
+        rr += h
+        cc += dc_step
+        step += 1
+
+
+def _render_output(
+    grid_shape: tuple[int, int],
