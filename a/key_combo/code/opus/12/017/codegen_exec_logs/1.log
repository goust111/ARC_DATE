+    if len(assignments) != 1:
+        return False
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return False
+
+    if np.array_equal(inp, expected):
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+    if not np.any(expected != 0):
+        return False
+    return True
+
