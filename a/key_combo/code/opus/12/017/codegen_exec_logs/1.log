+        coords = [tuple(map(int, rc)) for rc in np.argwhere(grid == color)]
+        assert 2 <= len(coords) <= 5, "each source must be marker plus 1-4 trail cells"
+
+        rows = sorted({r for r, _c in coords})
+        cols = sorted({c for _r, c in coords})
