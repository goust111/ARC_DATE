    for row, left_len, right_len in ((rows[0], lengths[0], lengths[1]), (rows[1], lengths[2], lengths[3])):
        left_marker = left_len
        right_marker = width - 1 - right_len
        if right_marker - left_marker - 1 < _MIN_OVERLAP:
            return None
        if row in (0, height - 1):
