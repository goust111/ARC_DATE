+def _line_cells(marker: Coord, trail_dir: Coord, length: int) -> list[Coord]:
+    r0, c0 = marker
+    dr, dc = trail_dir
+    return [(r0 + step * dr, c0 + step * dc) for step in range(length + 1)]
