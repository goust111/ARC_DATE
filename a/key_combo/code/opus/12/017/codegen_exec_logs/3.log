CONNECTOR_CHOICE_TRIES = 300
CONNECTOR_DELTA_MAX = 12
CONNECTOR_DELTA_MIN_CAP = 5

# Endpoint room selection favors far rooms, with a minority near-exit branch.
NEAR_EXIT_ENDPOINT_PROB = 0.30
NEAR_EXIT_STEPS = [-1, 0, 1]

