+
+_GEN_RETRY_LIMIT = 500
+_CANVAS_MIN = 15
+_CANVAS_MAX = 28
+_LAYOUT_OPTIONS = {
+    2: [(1, 2, (0, 1)), (2, 1, (0, 1)), (2, 2, (0, 1)), (2, 2, (0, 2)), (2, 2, (0, 3)), (2, 2, (1, 3))],
