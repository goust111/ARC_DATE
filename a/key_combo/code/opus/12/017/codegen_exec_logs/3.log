+    total_h = sum(row.shape[0] for row in rows) + len(rows) - 1
+    total_w = max(row.shape[1] for row in rows)
+    out = np.zeros((total_h, total_w), dtype=int)
+    r = 0
+    for row in rows:
+        out[r : r + row.shape[0], : row.shape[1]] = row
+        r += row.shape[0] + 1
