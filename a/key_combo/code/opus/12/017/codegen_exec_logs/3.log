+def _tile_pattern(pattern: np.ndarray, copies: int) -> np.ndarray:
+    h, w = pattern.shape
+    out = np.zeros((h, copies * w + (copies - 1)), dtype=int)
+    for idx in range(copies):
+        c0 = idx * (w + 1)
+        out[:, c0 : c0 + w] = pattern
+    return out
