+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[Coord]]:
+    h, w = mask.shape
+    dirs = _DIR4 if connectivity == 4 else _DIR8
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr = rr + dr
+                    nc = cc + dc
