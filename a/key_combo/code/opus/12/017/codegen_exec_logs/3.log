+def _bbox_from_coords(coords: list[Coord] | np.ndarray) -> tuple[int, int, int, int]:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
