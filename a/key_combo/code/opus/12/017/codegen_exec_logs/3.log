+def _build_pattern_bank() -> dict[tuple[int, int], list[np.ndarray]]:
+    groups: dict[tuple[int, int], list[np.ndarray]] = defaultdict(list)
+    for h in range(1, 4):
+        for w in range(1, 4):
+            total = h * w
+            for bits in range(1, 1 << total):
+                if bits.bit_count() > 4:
+                    continue
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in range(total):
+                    if (bits >> idx) & 1:
