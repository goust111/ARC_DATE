+def _frame_containing_row(frames: list[dict], row: int) -> dict:
+    hits = [f for f in frames if f["bbox"][0] <= row <= f["bbox"][2]]
+    assert len(hits) == 1, f"expected one frame for row {row}, got {len(hits)}"
+    return hits[0]
