spec:
  grid: 19-23 rows x 19-22 cols, background=0
  frames:
    total_count: 4-6, each a distinct non-bg color
    structure: 1-cell-thick rectangular border (all border cells filled), height 4-7, width 4-10
    no_overlap: bounding boxes never overlap (min gap >= 1 cell)
  source_frame:
    count: exactly 1
    description: same as other frames but also has interior motif pixels (same color as border)
    interior_fill: 35-65% of (h-2)*(w-2) interior cells, not necessarily connected
  matching_frames:
    count: 2-3 (excluding source), same outer dimensions (h,w) as source
    interior: hollow (no interior pixels)
  distractor_frames:
    count: 1-3, each with dimensions different from source AND from each other
    interior: hollow
  output:
    keep only source + matching frames at original positions
    copy source's interior motif into each matching frame (recolored to that frame's color)
    distractor frames removed (set to bg)

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid size (19-23 x 19-22) and template frame shape (h in 5-7, w in 5-8, both >= 5 for non-trivial interior).
    2. Generate random interior motif for the template (fill 35-65% of (h-2)*(w-2) cells).
    3. Choose N_match=3-4 (including source) distinct colors. Place N_match non-overlapping frames of template shape on grid with min gap 1.
    4. Stamp the interior motif into ALL matching frames (each in its own color) to form the output.
    5. Choose N_distract=1-3 distractor shapes (each different from template and each other). Place distractor frames (hollow, distinct colors) in remaining space.
    6. Derive input from output by erasing interior motif from all matching frames EXCEPT one (the source). Add distractor frames to the grid.
```
