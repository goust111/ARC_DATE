+    seen_shapes = set()
+    for gate in gates:
+        right = _frame_containing_row(right_frames, gate["row"])
+        shape = right["shape"]
+        assert shape not in seen_shapes
+        seen_shapes.add(shape)
+        left = left_by_shape[shape]
