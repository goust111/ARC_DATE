    source_cells = {(sr, sc) for sr, sc, _, _, _ in moves}
    dest_cells = {(dr, dc) for _, _, dr, dc, _ in moves}
    assert len(dest_cells) == len(moves), "source pixels must have distinct destinations"

    for sr, sc, _, _, _ in moves:
