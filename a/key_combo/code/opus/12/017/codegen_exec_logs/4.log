+    for gate in gates:
+        right = next(spec for spec in right_specs if spec["gate_row"] == gate["row"])
+        rr0, rc0 = right["top"], right["left"]
+        h, w = right["shape"]
+        if gate["left_color"] != gate["right_color"]:
