  "src": "unique non-hollow rectangular frame s with same-colored interior motif",
  "dst": "one-cell-thick rectangular frames d",
  "match_cond": "d.outer_shape == s.outer_shape",
  "transform": "paint d.border and s.interior motif at d-relative positions with d.color; unmatched frames -> bg"
}
</annotation>
<generation_spec>
