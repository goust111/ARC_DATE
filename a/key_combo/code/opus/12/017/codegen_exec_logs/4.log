+            if not _is_frame_component(comp):
+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            side = "left" if c1 < sep else "right"
+            assert side in {"left", "right"}
+            frame = {
+                "color": int(color),
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "shape": (int(r1 - r0 + 1), int(c1 - c0 + 1)),
+                "side": side,
+            }
+            frames.append(frame)
+            frame_cells.update(comp)
