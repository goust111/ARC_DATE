+        mask = np.zeros((h, w), dtype=bool)
+        cells = random.sample(range(area), count)
+        for idx in cells:
+            rr, cc = divmod(idx, safe_w)
+            mask[rr + 2, cc + 2] = True
+        if np.array_equal(mask, np.fliplr(mask)):
