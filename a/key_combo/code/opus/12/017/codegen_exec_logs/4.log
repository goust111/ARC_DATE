+        out[rr0 : rr0 + h, rc0 : rc0 + w][_frame_mask(h, w)] = right["color"]
+        out[rr0 + 1 : rr0 + h - 1, rc0 + 1 : rc0 + w - 1][motif[1:-1, 1:-1]] = right["color"]
