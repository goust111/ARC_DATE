+    return left, right, frame_cells, sep
+
+
+def _gate_rows(grid: np.ndarray, sep: int, frame_cells: set[tuple[int, int]]) -> list[dict]:
+    H, _W = grid.shape
+    rows = []
+    for r in range(H):
