+        sweep = set()
+        step_r = 0 if away[0] == 0 else (1 if away[0] > 0 else -1)
+        step_c = 0 if away[1] == 0 else (1 if away[1] > 0 else -1)
+        steps = max(abs(away[0]), abs(away[1]))
+        for k in range(steps + 1):
