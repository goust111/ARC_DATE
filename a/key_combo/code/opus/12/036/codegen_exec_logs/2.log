0024: def main(grid: np.ndarray) -> np.ndarray:
0025:     """
0026:     Extend the single rectangular bar into two diagonal zigzag chains, alternating the bar with its 90-degree rotated copy in the paired color.
0027: 
0028:     Input structure
0029:     - The grid has one background color and exactly one 4-connected monochrome foreground object.
0030:     - That foreground object is a solid non-square rectangle, either green or pink.
0031:     - The foreground rectangle's height and width define the alternating step period.
0032: 
0033:     Rule
0034:     - Keep copies of the original rectangle on both diagonals through the seed, with row and column offsets of height + width.
0035:     - Between every adjacent pair of same-diagonal original copies, place a 90-degree rotated rectangle in the other color.
0036:     - Continue the pattern across the whole canvas and clip any rectangle that crosses an edge.
0037: 
0038:     Key insight
0039:     - The two visible colors encode alternating orientations of the same bar along two crossing 45-degree zigzag paths; boundary fragments are just clipped copies.
0040:     """
0041:     g = np.asarray(grid, dtype=int)
0042:     bg = int(get_bg(g))
0043:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0044:     assert len(components) == 1, "expected one foreground bar"
0045: 
0046:     comp = components[0]
0047:     color = int(comp["color"])
0048:     assert color in (Color.GREEN, Color.PINK), "bar color must be green or pink"
0049: 
0050:     r0, c0, r1, c1 = comp["bbox"]
0051:     h = bbox_h(comp["bbox"])
0052:     w = bbox_w(comp["bbox"])
0053:     assert h != w, "seed bar must be non-square"
0054:     assert int(comp["area"]) == h * w, "seed bar must be a solid rectangle"
