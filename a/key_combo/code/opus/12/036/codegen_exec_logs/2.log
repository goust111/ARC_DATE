+        "anchor_cells": anchor_cells,
+        "fragment_cells": fragment_cells,
+        "completed_cells": completed,
+        "side": side,
+        "moved_cells": moved,
+        "mirrored_cells": mirrored,
+        "final_cells": moved | mirrored,
