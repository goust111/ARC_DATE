+        return {
+            "side": side,
+            "gap": gap,
+            "anchor_bbox": anchor_bbox,
+            "anchor_cells": anchor_cells,
+            "initial_cells": initial,
+            "moved_cells": moved,
+            "mirrored_cells": mirrored,
+            "final_cells": output_cells,
+            "input_reservation": input_cells,
