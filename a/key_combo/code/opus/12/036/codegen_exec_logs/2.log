+    scene: list[dict] = []
+    colors = sorted({int(comp["color"]) for comp in components if int(comp["color"]) != int(template["color"])})
+    for color in colors:
+        scene.append(_solve_color(g, bg, color, template_offsets, components))
+    return template, template_offsets, scene, bg
