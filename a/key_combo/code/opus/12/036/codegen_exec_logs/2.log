+def _mirror_across_anchor(cells: frozenset[Coord], anchor_bbox: tuple[int, int, int, int], side: str) -> frozenset[Coord]:
+    ar0, ac0, ar1, ac1 = map(int, anchor_bbox)
+    mirrored = set()
+    for r, c in cells:
+        if side == "left":
+            mirrored.add((r, 2 * ac0 - 1 - c))
+        elif side == "right":
+            mirrored.add((r, 2 * ac1 + 1 - c))
+        elif side == "above":
