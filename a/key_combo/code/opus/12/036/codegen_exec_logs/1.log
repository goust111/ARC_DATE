+        color = int(comp["color"])
+        holes = _count_holes_in_patch(patch, color)
+        shift, support = _drop_sprite(comp["coords"], shelves, grid.shape[1], grid.shape[0])
+        bbox = tuple(map(int, comp["bbox"]))
