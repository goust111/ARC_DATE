+def _extract_shelves(grid: np.ndarray) -> list[dict]:
+    shelves: list[dict] = []
+    h, w = map(int, grid.shape)
+    for r in range(h):
+        c = 0
+        while c < w:
+            if int(grid[r, c]) != SHELF:
+                c += 1
