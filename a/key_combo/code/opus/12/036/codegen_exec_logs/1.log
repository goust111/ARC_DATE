+        mapped = int(RECOLOR_BY_HOLES[int(obj["holes"])])
+        choices = [color for color in remaining if int(color) != mapped]
+        if not choices:
+            return False
+        color = random.choice(choices)
+        remaining.remove(color)
+        obj["input_color"] = int(color)
+    return True
