  background: 0 (black) [observed]
  motif:
    shape: exactly 2x2, all 4 cells non-background
    position: columns 0-1, row r0 where S-1 <= r0 <= H-S-1
    colors: 2-4 distinct non-bg colors; may repeat within the 4 cells
