+PAIR_COUNTS = (2, 3)
+PAIR_ORIENTATIONS = ("horizontal", "vertical")
+PALETTE = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE)
+PAIR_GAP_RANGE = (4, 6)
