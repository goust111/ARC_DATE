+
+def _bbox_gap_ok(new_bbox: tuple[int, int, int, int], existing: list[tuple[int, int, int, int]], gap: int = MIN_OBJECT_GAP) -> bool:
+    r0, c0, r1, c1 = new_bbox
+    for er0, ec0, er1, ec1 in existing:
+        if r1 < er0:
+            dr = er0 - r1 - 1
+        elif er1 < r0:
+            dr = r0 - er1 - 1
+        else:
+            dr = 0
+
+        if c1 < ec0:
+            dc = ec0 - c1 - 1
+        elif ec1 < c0:
+            dc = c0 - ec1 - 1
+        else:
+            dc = 0
+
+        if max(dr, dc) < gap:
+            return False
+    return True
