+        out = main(grid)
+        if out.ndim != 2 or max(out.shape) > 30:
+            continue
+        if not np.array_equal(out, _render(mask_inner, mask_outer, palette)):
+            continue
+        if set(map(int, out[out != BG])) != set(palette):
+            continue
+        return grid
+
