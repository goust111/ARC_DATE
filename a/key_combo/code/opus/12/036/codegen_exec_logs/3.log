+def _render(mask_inner: np.ndarray, mask_outer: np.ndarray, palette: list[int]) -> np.ndarray:
+    n = int(mask_inner.shape[0])
+    out = np.zeros((n * n, n * n), dtype=int)
+    for outer_r in range(n):
