+    n = int(mask_inner.shape[0])
+    out = np.zeros((n * n, n * n), dtype=int)
+    tile = np.zeros((n, n), dtype=int)
+    for inner_c in range(n):
+        tile[:, inner_c][mask_inner[:, inner_c]] = int(palette[inner_c])
