+
+def _find_monochrome_components(grid: np.ndarray, color: int) -> list[dict]:
+    comps = []
+    for coords in _label_components(grid == int(color)):
+        comp_bbox = _bbox(coords)
+        comps.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": comp_bbox,
+                "mask": _crop_mask(grid.shape, coords),
