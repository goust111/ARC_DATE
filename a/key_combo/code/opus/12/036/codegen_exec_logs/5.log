+
+def _make_frame_mask(hole_count: int) -> np.ndarray:
+    mask = np.zeros((FRAME_SIZE, FRAME_SIZE), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    pockets = {
+        "tl": [(1, 2), (2, 2), (2, 1)],
+        "tr": [(1, 8), (2, 8), (2, 9)],
+        "bl": [(8, 1), (8, 2), (9, 2)],
+    }
+    order = ("tl", "tr", "bl")
+    for key in order[: hole_count - 1]:
+        for r, c in pockets[key]:
+            mask[r, c] = True
