+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    pockets = {
+        "tl": [(1, 2), (2, 2), (2, 1)],
+        "tr": [(1, 8), (2, 8), (2, 9)],
+        "bl": [(8, 1), (8, 2), (9, 2)],
+    }
+    order = ("tl", "tr", "bl")
