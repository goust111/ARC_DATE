+            "101",
+            "110",
+        ],
+        2: [
+            "11111",
+            "10101",
+            "11110",
+        ],
+        3: [
+            "11111",
+            "10101",
+            "11111",
+            "10111",
+            "11110",
+        ],
+        4: [
+            "11111",
+            "10101",
+            "11111",
+            "10101",
+            "11110",
+        ],
+    }
+    out: dict[int, np.ndarray] = {}
+    for holes, rows in raw.items():
+        arr = np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
