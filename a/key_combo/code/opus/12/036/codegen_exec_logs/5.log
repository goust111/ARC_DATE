+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 7 or w < 7:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    if not local[0, :].all() or not local[-1, :].all() or not local[:, 0].all() or not local[:, -1].all():
+        return False
+    return _hole_count(local) >= 1
