+
+
+SPRITE_TEMPLATES = _sprite_templates()
+
+
+def _make_frame_mask(hole_count: int) -> np.ndarray:
+    mask = np.zeros((FRAME_SIZE, FRAME_SIZE), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
