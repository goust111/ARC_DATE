+        frame_color = int(frame["color"])
+        r0, c0, r1, c1 = frame["bbox"]
+        inner_h = r1 - r0 - 1
+        inner_w = c1 - c0 - 1
+        sh, sw = sprite_mask.shape
+        assert sh <= inner_h and sw <= inner_w
+        dst_r = r0 + 1 + (inner_h - sh) // 2
+        dst_c = c0 + 1 + (inner_w - sw) // 2
