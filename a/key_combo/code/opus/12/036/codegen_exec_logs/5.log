+def _component_local_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[comp["coords"][:, 0] - r0, comp["coords"][:, 1] - c0] = True
+    return out
