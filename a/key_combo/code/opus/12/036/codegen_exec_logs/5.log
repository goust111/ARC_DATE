+    layout_choices = [
+        (29, 24, [(1, 1), (1, 13), (12, 7)]),
+        (30, 25, [(1, 1), (1, 13), (12, 1)]),
+        (30, 27, [(1, 3), (1, 15), (12, 9)]),
+    ]
+    grid_h, min_w, positions = random.choice(layout_choices)
+    grid_w = random.randint(min_w, 30)
+    shift = random.randint(0, grid_w - min_w)
+    shifted = [(r, c + shift) for r, c in positions]
+    return grid_h, grid_w, shifted
