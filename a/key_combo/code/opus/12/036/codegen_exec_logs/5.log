+    bar_r, bar_c = target["bar_pos"]
+    toggled[bar_r, bar_c] = target["bar"][1]
+    toggled[bar_r, bar_c + 1] = target["bar"][0]
+    assert not np.array_equal(main(toggled), out)
+
