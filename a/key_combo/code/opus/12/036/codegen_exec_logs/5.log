+
+def _random_frame_layout(count: int) -> tuple[int, int, list[tuple[int, int]]]:
+    if count == 4:
+        grid_h = 30
+        grid_w = random.randint(24, 30)
+        x0 = random.randint(0, grid_w - 24)
+        positions = [(1, x0), (1, x0 + 13), (13, x0), (13, x0 + 13)]
+        return grid_h, grid_w, positions
+
+    layout_choices = [
