+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 8
+BAR_COLORS = (2, 7)
+FRAME_COLORS = (1, 3, 4, 6)
+SPRITE_COLOR_POOL = (0, 1, 3, 4, 5, 6, 9)
+FRAME_SIZE = 11
+MAX_GEN_ATTEMPTS = 400
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _label_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _enclosed_background(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    bg_mask = ~mask
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bg_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return bg_mask & ~outside
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    return len(_label_components(_enclosed_background(mask)))
+
+
+def _sprite_templates() -> dict[int, np.ndarray]:
+    raw = {
+        1: [
+            "111",
+            "101",
+            "110",
+        ],
+        2: [
+            "11111",
+            "10101",
+            "11110",
+        ],
+        3: [
+            "11111",
+            "10101",
+            "11111",
+            "10111",
+            "11110",
+        ],
+        4: [
+            "11111",
+            "10101",
+            "11111",
+            "10101",
+            "11110",
+        ],
+    }
