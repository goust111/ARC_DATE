+def _room_partition(grid: np.ndarray, door_mask: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    h, w = grid.shape
+    roomable = (grid != WALL) & ~door_mask
+    room_id = np.full((h, w), -1, dtype=int)
