+    candidates.sort()
+    if top_bias == "high":
+        chosen = candidates[0]
+    elif top_bias == "low":
+        chosen = candidates[-1]
+    else:
+        chosen = random.choice(candidates)
+    r0, c0 = chosen
+    for rr in range(sh):
