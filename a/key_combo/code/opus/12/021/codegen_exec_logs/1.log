+
+
+def _place_shape_of_kind(
+    grid: np.ndarray,
+    room_mask: np.ndarray,
+    kind: str,
+    color: int,
+    top_bias: str | None = None,
+) -> tuple[int, int] | None:
+    if kind == "H":
