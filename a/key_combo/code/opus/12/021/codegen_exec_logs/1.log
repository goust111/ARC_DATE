+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+WALL = 5
+SEED_COLORS = (BLUE, RED, GREEN)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
