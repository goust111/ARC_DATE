+    col_ranges = _room_ranges(col_sizes)
+    rooms: list[dict] = []
+    rid = 0
+    for rr, (r0, r1) in enumerate(row_ranges):
+        for cc, (c0, c1) in enumerate(col_ranges):
+            rooms.append(
+                {
+                    "id": rid,
+                    "row": rr,
+                    "col": cc,
