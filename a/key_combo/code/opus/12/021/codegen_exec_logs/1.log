+    return _solve_with_details(np.asarray(grid, dtype=int))["output"]
+
+
+H_SHAPES = [
+    np.array([[1, 0, 0], [1, 1, 0], [1, 0, 0]], dtype=int),
+    np.array([[1, 1, 0], [0, 1, 0], [1, 1, 0]], dtype=int),
+    np.array([[1, 1, 0, 0], [1, 0, 0, 0], [1, 1, 0, 0]], dtype=int),
