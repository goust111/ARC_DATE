+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bool_component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _seed_components(grid: np.ndarray) -> list[dict]:
+    comps: list[dict] = []
+    for color in SEED_COLORS:
+        for coords in _bool_component_coords(grid == color):
+            coord_list = [tuple(map(int, rc)) for rc in coords]
+            bbox = _bbox_from_coords(coord_list)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox,
+                    "top_row": int(bbox[0]),
+                    "left_col": int(bbox[1]),
