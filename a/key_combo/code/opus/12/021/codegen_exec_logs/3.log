+def _find_components(grid: np.ndarray, color: int) -> list[dict]:
+    mask = np.asarray(grid == color, dtype=bool)
+    seen = np.zeros_like(mask, dtype=bool)
+    components = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ORTHO_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            coords.sort()
+            components.append(
+                {
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return components
