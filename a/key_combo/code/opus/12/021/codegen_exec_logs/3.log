+def _paint_segment(
+    out: np.ndarray,
+    a: tuple[int, int],
+    b: tuple[int, int],
+    color: int,
+) -> None:
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        step = 1 if bc >= ac else -1
+        for cc in range(ac, bc + step, step):
