+        if side == "bottom":
+            return {(r, c), (r + 1, c)}
+        if side == "left":
+            return {(r, c - 1), (r, c)}
+        return {(r, c), (r, c + 1)}
+    if side == "top":
+        return {(r, c), (r + 1, c)}
+    if side == "bottom":
+        return {(r - 1, c), (r, c)}
+    if side == "left":
+        return {(r, c), (r, c + 1)}
+    return {(r, c - 1), (r, c)}
