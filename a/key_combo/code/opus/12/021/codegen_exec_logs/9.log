+def _counterpart_bbox(box: tuple[int, int, int, int], shape: tuple[int, int], axis: str) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    if axis == "vertical":
+        return r0, w - 1 - c1, r1, w - 1 - c0
+    if axis == "horizontal":
+        return h - 1 - r1, c0, h - 1 - r0, c1
+    raise ValueError(axis)
