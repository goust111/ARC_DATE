+    reserved = _reserve_mask(grid.shape, [hidden, visible], pad=1)
+    deco_colors = [c for c in GEN_BG_AND_DECO if c != bg]
+    placed = 0
+    target = random.randint(5, 11)
+    for _ in range(DECOR_ATTEMPTS):
