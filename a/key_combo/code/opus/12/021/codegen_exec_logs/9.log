+
+def _flip_patch(patch: np.ndarray, axis: str) -> np.ndarray:
+    if axis == "vertical":
+        return np.fliplr(patch)
+    if axis == "horizontal":
+        return np.flipud(patch)
+    raise ValueError(axis)
