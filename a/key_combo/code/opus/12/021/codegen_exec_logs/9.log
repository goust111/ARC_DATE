+    r0, c0, r1, c1 = occluder["bbox"]
+    side = bbox_h(occluder["bbox"])
+    assert side == bbox_w(occluder["bbox"])
+    assert np.count_nonzero(g == PINK) == side * side, "magenta must appear only in the occluder"
