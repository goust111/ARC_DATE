+
+def _place_unreachable_box(grid: np.ndarray, blocked: set[tuple[int, int]]) -> tuple[bool, tuple[int, int] | None]:
+    h, w = grid.shape
+    sizes = [size for size in (4, 5) if size <= h and size <= w]
+    random.shuffle(sizes)
+    for size in sizes:
