+
+def _marker_neighbors(marker: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = marker
+    cells = []
+    for rr in range(r - 1, r + 2):
+        for cc in range(c - 1, c + 2):
