+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+HALO = 1
+MARKER = 5
+WALL = 6
+TOKEN = 9
+
+ORTH_DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+
+SIDE_CELLS = {
+    "N": [(-1, -1), (-1, 0), (-1, 1)],
+    "S": [(1, -1), (1, 0), (1, 1)],
+    "W": [(-1, -1), (0, -1), (1, -1)],
+    "E": [(-1, 1), (0, 1), (1, 1)],
+}
+
+EXTRA_BY_DIR = {
+    "N": [(-1, -1), (-1, 1)],
+    "S": [(1, -1), (1, 1)],
+    "W": [(-1, -1), (1, -1)],
+    "E": [(-1, 1), (1, 1)],
+}
+
