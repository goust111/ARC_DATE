+    candidates: list[list[int]] = []
+    for marker in markers:
+        opts = [
+            idx
+            for idx, sprite in enumerate(sprites)
+            if 1 <= _min_manhattan(marker, sprite) <= 2
+        ]
+        assert opts, "marker must be near at least one same-color sprite"
+        candidates.append(opts)
