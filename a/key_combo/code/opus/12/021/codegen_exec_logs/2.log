from collections import Counter
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/12/021/2.py')
mod = SourceFileLoader('new_arc_task_cov', str(p)).load_module()

stats = Counter()
for _ in range(120):
    g = mod.generate_input()
    pairs = mod._legend_pairs(g)
    k = len(pairs)
    stats[f'scale_{k}'] += 1
    legend_mask = np.zeros_like(g, dtype=bool)
    legend_mask[:k, :2] = True
    outside = g.copy()
    outside[legend_mask] = 0
    used = 0
    stamps = []
    for pri, (src, _dst) in enumerate(pairs):
        comps = mod._components(outside == src)
        if comps:
            used += 1
        markers = [tuple(map(int, comp[0])) for comp in comps if len(comp) == 1]
        sprites = [comp for comp in comps if len(comp) > 1]
        for marker, sprite in mod._match_markers_to_sprites(markers, sprites):
            r0, c0, _r1, _c1 = mod._bbox_coords(sprite)
            shape = tuple(sorted((int(r)-r0, int(c)-c0) for r, c in sprite))
            full = mod._scaled_cells(shape, marker, k)
            vis = mod._visible_cells(full, *g.shape)
            stamps.append((pri, vis, full))
            if full "'!= vis:
                stats['"'clipped'] += 1
    stats[f'objects_{used}'] += 1
    if used < k:
        stats['unused_legend'] += 1
    overlapped = False
    for i in range(len(stamps)):
        for j in range(i+1, len(stamps)):
            if stamps[i][1] & stamps[j][1]:
                overlapped = True
    if overlapped:
        stats['overlap'] += 1
print(dict(stats))
