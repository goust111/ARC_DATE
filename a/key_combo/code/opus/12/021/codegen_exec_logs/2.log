+    return candidates
+
+
+def _paint_input_object(grid: np.ndarray, color: int, sprite_cells: set[Coord], marker: Coord) -> None:
+    for r, c in sprite_cells:
+        grid[r, c] = color
+    grid[marker] = color
+
