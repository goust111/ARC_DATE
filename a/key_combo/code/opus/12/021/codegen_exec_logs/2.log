+def _valid_overlap_size(a: dict, b: dict) -> bool:
+    overlap = len(a["visible_stamp"] & b["visible_stamp"])
+    if overlap == 0:
+        return False
+    smaller = min(len(a["visible_stamp"]), len(b["visible_stamp"]))
+    return overlap <= max(6, smaller // 3)
