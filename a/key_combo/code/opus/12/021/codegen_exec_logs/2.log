+def _stamp_cells(sprite: np.ndarray, marker: Coord, scale: int) -> tuple[set[Coord], bool]:
+    r0, c0, r1, c1 = _bbox_coords(sprite)
+    coords = {(int(r) - r0, int(c) - c0) for r, c in sprite}
+    cells: set[Coord] = set()
+    clipped = False
+    for rel_r, rel_c in coords:
+        for dr in range(scale):
