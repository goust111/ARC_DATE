+Coord = tuple[int, int]
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _normalize_shape(coords: tuple[Coord, ...]) -> tuple[Coord, ...]:
+    r0 = min(r for r, _ in coords)
+    c0 = min(c for _, c in coords)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def _shape_variants(base: tuple[Coord, ...]) -> set[tuple[Coord, ...]]:
+    variants: set[tuple[Coord, ...]] = set()
+    current = tuple(base)
+    for _ in range(4):
+        rotated = tuple((c, -r) for r, c in current)
+        current = rotated
+        for reflected in (current, tuple((r, -c) for r, c in current)):
+            norm = _normalize_shape(reflected)
+            h = max(r for r, _ in norm) + 1
+            w = max(c for _, c in norm) + 1
+            if h <= 3 and w <= 3:
+                variants.add(norm)
+    return variants
+
+
+def _build_shape_bank() -> list[tuple[Coord, ...]]:
+    bases = [
+        ((0, 0), (0, 1)),
+        ((0, 0), (0, 1), (0, 2)),
+        ((0, 0), (1, 0), (1, 1)),
+        ((0, 1), (1, 0), (1, 1), (1, 2)),
+        ((0, 0), (1, 0), (2, 0), (2, 1)),
+        ((0, 1), (0, 2), (1, 0), (1, 1)),
+    ]
+    shapes: set[tuple[Coord, ...]] = set()
+    for base in bases:
+        shapes.update(_shape_variants(base))
+    return sorted(shapes)
