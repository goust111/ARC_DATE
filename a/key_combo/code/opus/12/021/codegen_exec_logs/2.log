+    solutions: list[list[int]] = []
+    used: set[int] = set()
+
+    def dfs(i: int, assign: list[int]) -> None:
+        if len(solutions) > 1:
+            return
+        if i == len(markers):
+            solutions.append(assign[:])
+            return
+        for idx in candidates[i]:
+            if idx in used:
+                continue
+            used.add(idx)
+            assign.append(idx)
+            dfs(i + 1, assign)
+            assign.pop()
+            used.remove(idx)
