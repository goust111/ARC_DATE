+def _render_expected(
+    shape_by_color: dict[int, tuple[Coord, ...]],
+    placements: list[dict],
+    pairs: list[tuple[int, int]],
+    h: int,
+    w: int,
+) -> np.ndarray:
+    scale = len(pairs)
+    out = np.zeros((h, w), dtype=int)
