+def _scaled_cells(shape: tuple[Coord, ...], top_left: Coord, scale: int) -> set[Coord]:
+    cells: set[Coord] = set()
+    for rel_r, rel_c in shape:
+        for dr in range(scale):
+            for dc in range(scale):
+                cells.add((top_left[0] + rel_r * scale + dr, top_left[1] + rel_c * scale + dc))
+    return cells
+
