+
+def _candidate_markers(sprite_cells: set[Coord], h: int, w: int) -> list[Coord]:
+    candidates: set[Coord] = set()
+    for r, c in sprite_cells:
+        for dr in range(-2, 3):
+            dc = 2 - abs(dr)
+            for sign in (-1, 1):
+                rr = r + dr
+                cc = c + sign * dc
+                if dc == 0 and sign == 1:
+                    continue
