+    return pairs
+
+
+def _min_manhattan(point: Coord, coords: np.ndarray) -> int:
+    pr, pc = point
+    return min(abs(pr - int(r)) + abs(pc - int(c)) for r, c in coords)
+
+
+def _match_markers_to_sprites(
