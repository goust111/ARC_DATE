+        if occupied[r, c]:
+            return False
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and occupied[nr, nc] and (nr, nc) not in cells:
+                return False
+    return True
+
+
+def _candidate_markers(sprite_cells: set[Coord], shape: tuple[int, ...], h: int, w: int) -> list[Coord]:
+    del shape
+    candidates: set[Coord] = set()
+    for r, c in sprite_cells:
+        for dr in range(-2, 3):
+            dc = 2 - abs(dr)
+            for sign in (-1, 1):
+                rr = r + dr
+                cc = c + sign * dc
+                if dc == 0 and sign == 1:
+                    continue
+                candidates.add((rr, cc))
+    out = []
+    for marker in candidates:
