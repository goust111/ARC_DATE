+        r0, r1 = row_bands[ri]
+        c0, c1 = col_bands[ci]
+        region = grid[r0:r1, c0:c1]
+        seq = _stripe_sequence(region)
+        assert len(seq) in LENGTH_TO_FILL, "compressed stripe length must be 2, 3, or 4"
