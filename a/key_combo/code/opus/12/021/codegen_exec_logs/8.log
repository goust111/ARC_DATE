+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+SEPARATOR = GREY
+STRIPE_PALETTE = (PINK, 7, 8, 9)
+LENGTH_TO_FILL = {2: RED, 3: BLUE, 4: YELLOW}
+CORNERS = ("tl", "tr", "bl", "br")
+
+GEN_RETRIES = 400
+CORNER_BAND_MIN = 4
+CORNER_BAND_MAX = 9
+MIDDLE_BAND_MIN = 3
