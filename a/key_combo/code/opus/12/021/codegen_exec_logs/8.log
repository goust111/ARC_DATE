+    h, w = g.shape
+    sep_rows = [r for r in range(h) if np.all(g[r, :] == SEPARATOR)]
+    sep_cols = [c for c in range(w) if np.all(g[:, c] == SEPARATOR)]
+    assert len(sep_rows) == 2 and len(sep_cols) == 2
