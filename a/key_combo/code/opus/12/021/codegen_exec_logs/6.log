+def _touches_crop_border(box: tuple[int, int, int, int], shape: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    return r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1
+
