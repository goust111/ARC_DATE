+            rr0, cc0, _rr1, _cc1 = cavity["bbox"]
+            _paint_mask(out, sprite["mask"], rr0, cc0, color)
+
+    return out
+
+
+def _random_connected_shape(h: int, w: int) -> np.ndarray | None:
+    max_area = min(8, h * w)
+    if max_area < 3:
+        return None
+
+    for _ in range(120):
+        target = random.randint(3, max_area)
+        if h * w > 3 and target == h * w:
+            target -= 1
+        if target < 3:
