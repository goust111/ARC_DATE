+    assert any(count >= 2 for count in shape_counts.values()), "expected repeated shapes"
+
+    return {
+        "grid": g,
+        "template_box": template_box,
+        "template": template,
+        "cavities": cavities,
+        "sprites": sprites,
+        "shape_counts": shape_counts,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
