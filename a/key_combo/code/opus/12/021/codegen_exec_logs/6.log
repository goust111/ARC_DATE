+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    coords = np.argwhere(mask)
+    return tuple(sorted((int(r), int(c)) for r, c in coords))
+
