+        grid[r0 : r1 + 1, c0 : c1 + 1] = RECT_COLOR
+
+    if not _place_controls(grid, split_c, rects):
+        return None
+    if not _validate_generated(grid, rects, split_c):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
