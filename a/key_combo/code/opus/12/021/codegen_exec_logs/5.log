+DIVIDER = 5
+LEFT_PANEL_COLOR = 1
+RIGHT_PANEL_COLOR = 3
+CONTROL_COLOR = 2
+RECT_COLOR = 7
+
+SIDES = ("up", "down", "left", "right")
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
