+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(MIN_HEIGHT, MAX_HEIGHT)
+    width = random.randint(MIN_WIDTH, MAX_WIDTH)
+    split_c = random.randint(MIN_PANEL_WIDTH, width - MIN_PANEL_WIDTH - 1)
