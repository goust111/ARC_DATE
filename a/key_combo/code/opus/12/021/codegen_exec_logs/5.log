+MIN_HEIGHT = 16
+MAX_HEIGHT = 22
+MIN_WIDTH = 23
+MAX_WIDTH = 29
+MIN_PANEL_WIDTH = 11
+MAX_GENERATION_ATTEMPTS = 400
+MIN_MARGIN = 4
+RECT_SIDE_RANGE = (3, 4)
