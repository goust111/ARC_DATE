+    cells: list[tuple[int, int]] = []
+    if side == "up":
+        for r in range(0, r0):
+            for c in range(c0, c1 + 1):
+                cells.append((r, c))
+    elif side == "down":
+        for r in range(r1 + 1, h):
+            for c in range(c0, c1 + 1):
