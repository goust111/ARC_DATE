+        r0, c0, r1, c1 = rect["bbox"]
+        counts = rect["counts"]
+        if counts["up"]:
+            out[r0 - counts["up"] : r0, c0 : c1 + 1] = target
+        if counts["down"]:
+            out[r1 + 1 : r1 + 1 + counts["down"], c0 : c1 + 1] = target
+        if counts["left"]:
+            out[r0 : r1 + 1, c0 - counts["left"] : c0] = target
+        if counts["right"]:
