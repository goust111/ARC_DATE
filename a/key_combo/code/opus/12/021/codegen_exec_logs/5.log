+def _place_controls(grid: np.ndarray, split_c: int, rects: list[dict]) -> bool:
+    occupied = {
+        tuple(map(int, rc))
+        for rc in np.argwhere((grid == RECT_COLOR) | (grid == DIVIDER) | (grid == CONTROL_COLOR))
+    }
+    for rect_idx, rect in enumerate(rects):
