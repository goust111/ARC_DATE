    safe = _gen_safe_rows(region, split_type)
    if safe is None:
        return False
    rows = _gen_rows_for_rects(safe[0], safe[1], rects, rng)

    for (h, w), r0 in zip(rects, rows):
        out_c0 = int(region["c1"]) - w + 1 if color == _GEN_BLUE else int(region["c0"])

