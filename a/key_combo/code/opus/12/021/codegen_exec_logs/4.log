+        r0, c0, _r1, _c1 = comp["bbox"]
+        opening_global = [(r0 + r, c0 + c) for r, c in opening_local]
+        interior_global = [(r0 + r, c0 + c) for r, c in np.argwhere(interior_local)]
+        path = _ray_path(grid, opening_global, direction)
+        cups.append(
