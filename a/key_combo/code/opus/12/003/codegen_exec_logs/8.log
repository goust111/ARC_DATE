+def _feature_mode_ok(stats: dict[str, int], mode: str) -> bool:
+    if mode == "lookahead_obstacle":
+        return stats["lookahead_settled"] > 0 and stats["settled_block"] > 0
+    if mode == "self_spiral":
+        return stats["lookahead_green"] > 0 and stats["wall_block"] > 0
+    return (
