+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+PALETTE = (1, 2, 4, 5, 6, 7, 8, 9)
+DIRS = ((0, 1), (1, 0), (0, -1), (-1, 0))
+
+SIZE_MIN = 8
+SIZE_MAX = 12
+FOREGROUND_MIN = 5
+FOREGROUND_MAX = 12
+COUNT_CHOICES = (1, 2, 3)
+GEN_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _settle_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = np.zeros_like(g)
+    height, width = g.shape
+    for col in range(width):
+        values = g[:, col][g[:, col] != BLACK]
+        if values.size:
+            out[height - values.size :, col] = values
+    return out
+
+
+def _draw_spiral(base: np.ndarray) -> tuple[np.ndarray, dict[str, int]]:
+    out = np.asarray(base, dtype=int).copy()
+    height, width = out.shape
+    stats = {
+        "steps": 1,
+        "wall_block": 0,
+        "settled_block": 0,
+        "green_block": 0,
+        "lookahead_settled": 0,
+        "lookahead_green": 0,
+    }
+
+    if out[0, 0] != BLACK:
+        return out, stats
+
+    r, c = 0, 0
+    dir_idx = 0
+    out[r, c] = GREEN
+
+    while True:
+        moved = False
+        for _ in range(4):
+            dr, dc = DIRS[dir_idx]
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(out.shape, nr, nc):
+                stats["wall_block"] += 1
+                dir_idx = (dir_idx + 1) % 4
+                continue
+            if out[nr, nc] != BLACK:
+                if out[nr, nc] == GREEN:
+                    stats["green_block"] += 1
+                else:
+                    stats["settled_block"] += 1
+                dir_idx = (dir_idx + 1) % 4
+                continue
+
+            fr, fc = r + 2 * dr, c + 2 * dc
+            if _in_bounds(out.shape, fr, fc) and out[fr, fc] != BLACK:
+                if out[fr, fc] == GREEN:
+                    stats["lookahead_green"] += 1
+                else:
+                    stats["lookahead_settled"] += 1
+                dir_idx = (dir_idx + 1) % 4
+                continue
+
+            r, c = nr, nc
+            out[r, c] = GREEN
+            stats["steps"] += 1
