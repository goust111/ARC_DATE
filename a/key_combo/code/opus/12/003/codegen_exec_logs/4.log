+    cells: list[tuple[int, int]] = []
+    if orientation == "down":
+        for d in range(1, height + 1):
+            rr = r + d
+            for cc in range(c - d + 1, c + d):
+                cells.append((rr, cc))
+    elif orientation == "up":
+        for d in range(1, height + 1):
+            rr = r - d
+            for cc in range(c - d + 1, c + d):
+                cells.append((rr, cc))
+    elif orientation == "right":
+        for d in range(1, height + 1):
+            cc = c + d
+            for rr in range(r - d + 1, r + d):
+                cells.append((rr, cc))
+    elif orientation == "left":
+        for d in range(1, height + 1):
+            cc = c - d
+            for rr in range(r - d + 1, r + d):
+                cells.append((rr, cc))
