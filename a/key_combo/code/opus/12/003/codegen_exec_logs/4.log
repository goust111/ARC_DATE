+            value = int(g[r, c])
+            if value not in (BLACK, GREEN):
+                assert (r, c) in interior_union, "foreground pixels must lie inside wedges"
+
+    out = g.copy()
+    for wedge in wedges:
+        _settle_wedge(g, out, wedge)
+    return out
