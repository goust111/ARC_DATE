+def _generate_attempt() -> np.ndarray | None:
+    shape = (
+        random.randint(GRID_MIN, GRID_MAX),
+        random.randint(GRID_MIN, GRID_MAX),
+    )
+    specs = _choose_wedge_specs()
+    wedges = _place_wedges(shape, specs)
+    if wedges is None:
