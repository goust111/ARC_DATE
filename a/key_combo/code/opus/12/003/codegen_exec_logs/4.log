+
+def _settle_wedge(
+    source: np.ndarray, out: np.ndarray, wedge: dict
+) -> None:
+    interior = wedge["interior"]
+    for r, c in interior:
+        assert source[r, c] != GREEN
+        out[r, c] = BLACK
+
+    for ordered in wedge["lines"].values():
+        colors = [
+            int(source[r, c])
+            for r, c in ordered
+            if int(source[r, c]) not in (BLACK, GREEN)
