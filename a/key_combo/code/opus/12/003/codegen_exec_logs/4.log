+
+GRID_MIN = 12
+GRID_MAX = 16
+WEDGE_COUNT_RANGE = (2, 3)
+HEIGHT_RANGE = (3, 5)
+GEN_ATTEMPTS = 400
+
+
+def _wedge_geometry(
+    shape: tuple[int, int], tip: tuple[int, int], orientation: str, height: int
