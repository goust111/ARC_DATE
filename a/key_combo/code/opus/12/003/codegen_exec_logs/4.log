+def _ray_boundary_cells(
+    tip: tuple[int, int], orientation: str, height: int
+) -> set[tuple[int, int]]:
+    r, c = tip
+    cells = {(r, c)}
+    for dr, dc in TIP_DIRS[orientation]:
+        for d in range(1, height + 1):
+            cells.add((r + dr * d, c + dc * d))
+    return cells
+
