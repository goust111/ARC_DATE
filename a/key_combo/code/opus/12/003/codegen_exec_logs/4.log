+
+def _place_wedges(shape: tuple[int, int], specs: list[tuple[str, int]]) -> list[dict] | None:
+    caches = {
+        spec: _candidate_wedges(shape, spec[0], spec[1])
+        for spec in set(specs)
+    }
+    for _ in range(120):
+        used: set[tuple[int, int]] = set()
+        placed: list[dict] = []
+        ok = True
+        for spec in specs:
