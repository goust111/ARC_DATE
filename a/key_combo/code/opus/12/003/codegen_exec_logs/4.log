+def _line_combinations(
+    capacity: int,
+    count: int,
+    *,
+    unsettled: bool,
+    require_gap: bool,
+) -> list[tuple[int, ...]]:
+    settled = tuple(range(capacity - count, capacity))
+    combos = []
+    for combo in itertools.combinations(range(capacity), count):
+        if unsettled and combo == settled:
+            continue
+        if require_gap and count >= 2:
