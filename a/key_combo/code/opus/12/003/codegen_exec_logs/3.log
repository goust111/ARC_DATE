+        return (dr, -1), (dr, 1)
+    return (-1, dc), (1, dc)
+
+
+def _walk_diagonal_path(
+    grid: np.ndarray,
+    start: Coord,
+    step: Coord,
+    component: set[Coord],
+    bg: int,
+) -> list[Coord]:
+    g = np.asarray(grid, dtype=int)
+    path: list[Coord] = []
+    r, c = start
+    dr, dc = step
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not _in_bounds(g.shape, nr, nc):
+            break
+        if int(g[nr, nc]) != bg:
+            break
+        if not _adjacent_to_component((nr, nc), component):
