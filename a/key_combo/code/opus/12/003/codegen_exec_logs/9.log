+def _forbidden_with_gap(cells: tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
+    blocked = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                blocked.add((r + dr, c + dc))
