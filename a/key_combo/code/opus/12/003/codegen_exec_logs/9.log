+    g = np.asarray(grid, dtype=int)
+    out = g.copy() if start_with_sources else np.full_like(g, BLACK)
+    owners = [[("bg", -1) for _ in range(g.shape[1])] for _ in range(g.shape[0])]
+    if start_with_sources:
