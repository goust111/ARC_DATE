+    objects = _find_objects(np.asarray(grid, dtype=int))
+    out, _meta = _render(
+        np.asarray(grid, dtype=int),
+        objects,
+        include_rays=True,
+        start_with_sources=True,
+        restore_sources=True,
+    )
+    return out
