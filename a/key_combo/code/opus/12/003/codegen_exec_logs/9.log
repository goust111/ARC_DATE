+    no_source_obstacles, _ = _render(grid, objects, include_rays=True, start_with_sources=False, restore_sources=True)
+    reversed_colors, _ = _render(
+        grid,
+        objects,
+        include_rays=True,
+        start_with_sources=True,
+        restore_sources=True,
+        color_order=(GREEN, YELLOW),
