+    return tuple(
+        (r0 + rr, c0 + cc)
+        for rr in (0, 1)
+        for cc in (0, 1)
+        if (rr, cc) != missing
+    )
+
+
+def _missing_vector(missing: tuple[int, int]) -> tuple[int, int]:
+    mr, mc = missing
+    return (-1 if mr == 0 else 1, -1 if mc == 0 else 1)
