+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SOURCE_COLORS = (RED, GREY)
+COPY_COLOR = {RED: GREEN, GREY: YELLOW}
+MISSING_CORNERS = ((0, 0), (0, 1), (1, 0), (1, 1))
+
+GRID_ROWS = (13, 18)
+GRID_COLS = (13, 18)
