+
+GRID_H_RANGE = (13, 19)
+GRID_W_RANGE = (13, 19)
+PATH_COUNT_CHOICES = (2, 3)
+PALETTE_LEN_CHOICES = (2, 3)
+PATH_LENGTH_RANGE = (5, 12)
