+
+
+def gap_options(path: list[Coord], visible: Coord, inward: Coord, gap_len: int) -> list[tuple[list[Coord], Coord, Coord]]:
+    cells = set(path)
+    options = []
+    for direction in DIRECTIONS:
+        if direction == inward:
+            continue
