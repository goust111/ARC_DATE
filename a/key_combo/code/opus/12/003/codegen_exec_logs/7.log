+        for _ in range(120):
+            seed = (random.randrange(h), random.randrange(w))
+            cells = {seed}
+            while len(cells) < area:
+                frontier = []
+                for r, c in cells:
+                    for dr, dc in FOUR_DIRS:
+                        nr, nc = r + dr, c + dc
