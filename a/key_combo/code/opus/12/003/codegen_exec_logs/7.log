        range(len(pieces)),
        key=lambda idx: (
            -pieces[idx]["area"],
            pieces[idx]["bbox"][1],
            pieces[idx]["bbox"][0],
            pieces[idx]["bbox"][3],
            pieces[idx]["bbox"][2],
