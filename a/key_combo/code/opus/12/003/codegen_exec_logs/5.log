+    aw = section_a.shape[1]
+    bw = section_b.shape[1]
+    cw = section_c.shape[1]
+    grid = np.zeros((h, aw + 1 + bw + 1 + cw), dtype=int)
+    grid[:, :aw] = section_a
+    grid[:, aw] = SEP
+    grid[:, aw + 1 : aw + 1 + bw] = section_b
+    grid[:, aw + 1 + bw] = SEP
+    grid[:, aw + 2 + bw :] = section_c
