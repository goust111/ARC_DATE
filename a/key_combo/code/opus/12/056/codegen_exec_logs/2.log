            top_bar = vertical_bars[0]
            order = [horizontal_bars[0], vertical_bars[0]]
    elif mode == "single_top":
        if top_orient == "h":
            top_bar = horizontal_bars[0]
            order = vertical_bars[:] + [horizontal_bars[0]]
            random.shuffle(order[:-1])
        else:
