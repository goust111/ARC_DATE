0062:     assert len(set(c1 - c0 for c0, c1 in col_segments)) == 1
0063: 
0064:     row_colors: list[int] = []
0065:     for r0, r1 in row_segments:
0066:         c0, c1 = col_segments[0]
0067:         cell = g[r0:r1, c0:c1]
0068:         marker_colors = colors_present(cell, exclude={bg})
0069:         assert len(marker_colors) == 1
0070:         assert marker_colors[0] != divider_color
0071:         row_colors.append(marker_colors[0])
0072: 
0073:     template_masks: list[np.ndarray] = []
0074:     for r0, r1 in row_segments:
0075:         for c0, c1 in col_segments[1:]:
0076:             cell = g[r0:r1, c0:c1]
0077:             cell_colors = colors_present(cell, exclude={bg})
0078:             if not cell_colors:
0079:                 continue
0080:             assert len(cell_colors) == 1
