0055:     H, W = g.shape
0056:     bg = get_bg(g)
0057:     divider_color, divider_rows, divider_cols = _divider_grid(g, bg)
0058: 
0059:     row_segments = _segments(H, divider_rows)
0060:     col_segments = _segments(W, divider_cols)
