    min_span = MARKER_GAP_RANGE[0] * (marker_count - 1)
    max_span = min(MARKER_GAP_RANGE[1] * (marker_count - 1), last_marker_row)
    span = _gen_randint(min_span, max_span)
    start = _gen_randint(0, last_marker_row - span)
