+        idx = int(rng.integers(0, len(cols)))
+        tile = tiles[idx]
+        max_blue = width - tile.size - 2
+        alternatives = [c for c in range(1, max_blue + 1) if c != cols[idx]]
+        if alternatives:
+            cols[idx] = int(rng.choice(alternatives))
+    return cols
+
+
