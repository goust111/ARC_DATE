    if not (_GEN_WALL_FRACTION_RANGE[0] <= wall_fraction <= _GEN_WALL_FRACTION_RANGE[1]):
        return False
    try:
        solved = main(inp)
    except Exception:
        return False
    return bool(np.array_equal(solved, out))


