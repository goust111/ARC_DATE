+                and end < w - 1
+                and grid[r, start - 1] == GREY
+                and grid[r, end + 1] == GREY
+                and np.all(grid[r - 1, start : end + 1] == GREY)
+                and np.all(grid[r + 1, start : end + 1] == GREY)
