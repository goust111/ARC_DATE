+    marker_blue_cols = [int(np.flatnonzero(inp[r] == BLUE)[0]) for r in range(divider) if np.any(inp[r] == BLUE)]
+    if len(marker_blue_cols) > 1 and len(set(marker_blue_cols)) == 1:
