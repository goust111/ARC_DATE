+    out = inp.copy()
+    for tile, (r, c0, width) in zip(tiles, cavity_specs):
+        out[r, c0 : c0 + width] = _repeat_row(tile, width)
+    return out
+
+
+def _semantic_checks(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        produced = main(inp)
+    except Exception:
