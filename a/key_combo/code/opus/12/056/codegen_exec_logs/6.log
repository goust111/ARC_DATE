    )

    marker_rows = _gen_marker_rows(height, marker_count)
    blue_cols = _gen_marker_cols(marker_count, segment_width, grid_width)
    for out_r, (grid_r, blue_col) in enumerate(zip(marker_rows, blue_cols)):
