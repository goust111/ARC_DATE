+        mid = divider + 1 + local_mid
+        top = mid - 1
+        bottom = mid + 1
+        grid[top, left - 1 : left + width + 1] = GREY
+        grid[mid, left - 1] = GREY
+        grid[mid, left + width] = GREY
+        grid[bottom, left - 1 : left + width + 1] = GREY
+        cavity_specs_global.append((mid, left, width))
