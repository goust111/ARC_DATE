+    r0, c0, r1, c1 = rect
+    th, tw = tile_shape
+    corners = [
+        (r0, c0),
+        (r0, c1 - tw + 1),
+        (r1 - th + 1, c0),
+        (r1 - th + 1, c1 - tw + 1),
+    ]
