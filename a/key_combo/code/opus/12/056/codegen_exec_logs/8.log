+                continue
+
+            # j left of i
+            if c1b < c0a:
+                gap = c0a - c1b - 1
+                lo = max(r0a, r0b)
+                hi = min(r1a, r1b)
+                if gap == 1 and lo <= hi:
+                    wall = [(r, c1b + 1) for r in range(lo, hi + 1)]
+                    if all(int(grid[r, c]) == WALL for r, c in wall):
+                        conns.append({"a": i, "b": j, "wall": wall, "key": wall[0]})
+                continue
+
+            # i above j
+            if r1a < r0b:
+                gap = r0b - r1a - 1
+                lo = max(c0a, c0b)
+                hi = min(c1a, c1b)
+                if gap == 1 and lo <= hi:
+                    wall = [(r1a + 1, c) for c in range(lo, hi + 1)]
+                    if all(int(grid[r, c]) == WALL for r, c in wall):
+                        conns.append({"a": i, "b": j, "wall": wall, "key": wall[0]})
+                continue
+
+            # j above i
+            if r1b < r0a:
+                gap = r0a - r1b - 1
+                lo = max(c0a, c0b)
+                hi = min(c1a, c1b)
+                if gap == 1 and lo <= hi:
+                    wall = [(r1b + 1, c) for c in range(lo, hi + 1)]
