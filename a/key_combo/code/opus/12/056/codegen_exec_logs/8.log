+def _bfs_component(graph: dict[int, set[int]], start: int) -> tuple[set[int], dict[int, int]]:
+    q = deque([start])
+    dist = {start: 0}
+    while q:
+        cur = q.popleft()
+        for nxt in graph[cur]:
+            if nxt not in dist:
+                dist[nxt] = dist[cur] + 1
