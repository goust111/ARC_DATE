+                r0b, c0b, r1b, c1b = rects[idx2]
+                gap = r0b - r1 - 1
+                wall = [(r, c) for r in range(r1 + 1, r0b) for c in range(max(c0, c0b), min(c1, c1b) + 1)]
+                info.append({"a": idx, "b": idx2, "gap": gap, "wall": wall})
+    return info
