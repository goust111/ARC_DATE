+            ("block_left", [True], [True, False], 3),
+            ("block_right", [True], [False, True], 3),
+            ("full", [True], [True, True], 1),
+        ]
+    if (nrows, ncols) == (3, 2):
+        return [
+            ("line", [True, True], [False], 4),
+            ("block_top", [True, False], [True], 3),
+            ("block_bottom", [False, True], [True], 3),
+            ("full", [True, True], [True], 1),
+        ]
+    raise ValueError((nrows, ncols))
