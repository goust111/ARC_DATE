+def _thin_graph(
+    nrows: int,
+    ncols: int,
+    row_thins: list[bool],
+    col_thins: list[bool],
+) -> dict[int, set[int]]:
+    def idx(i: int, j: int) -> int:
+        return i * ncols + j
+
+    graph = {k: set() for k in range(nrows * ncols)}
+    for i in range(nrows):
+        for j in range(ncols):
+            here = idx(i, j)
+            if i + 1 < nrows and row_thins[i]:
+                down = idx(i + 1, j)
+                graph[here].add(down)
+                graph[down].add(here)
+            if j + 1 < ncols and col_thins[j]:
+                right = idx(i, j + 1)
+                graph[here].add(right)
+                graph[right].add(here)
