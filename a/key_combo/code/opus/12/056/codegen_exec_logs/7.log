+    gap = _sample_gap(h, parity)
+    if gap is None:
+        return None
+    dist = gap + 3
+    col = random.randint(EDGE_MARGIN, w - EDGE_MARGIN - 1)
+    top = random.randint(EDGE_MARGIN, h - EDGE_MARGIN - 1 - dist)
