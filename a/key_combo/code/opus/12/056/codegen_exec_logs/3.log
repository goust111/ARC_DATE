+
+def _marker_colors(grid: np.ndarray, bg: int) -> list[int]:
+    colors = [int(c) for c in np.unique(grid) if int(c) != bg]
+    marker_colors: list[int] = []
+    for color in colors:
+        coords = np.argwhere(grid == color)
+        if coords.shape[0] != 2:
+            continue
+        comps = _color_components(grid == color)
