+
+    seed_cells = _seed_cells_from_mask(seed_top_left, seed_mask)
+    if not seed_cells or not all(_in_bounds(shape, r, c) for r, c in seed_cells):
+        return None
+    if p1 in seed_cells or p2 in seed_cells:
