+
+def _pair_semantics_ok(pair: dict) -> bool:
+    residues = {
+        (
+            (r - pair["seed_bbox"][0]) % pair["tile"].shape[0],
+            (c - pair["seed_bbox"][1]) % pair["tile"].shape[1],
