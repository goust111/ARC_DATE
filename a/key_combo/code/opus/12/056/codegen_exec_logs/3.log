+        "seed_color": seed_color,
+        "p1": p1,
+        "p2": p2,
+        "diag": diag,
+        "axis": axis,
+        "vertices": vertices,
+        "boundary": boundary,
+        "interior": interior,
+        "seed_cells": seed_cells,
+        "seed_bbox": (sr0, sc0, sr1, sc1),
+        "tile": tile,
+        "mode": "vertical" if axis[0] != 0 else "horizontal",
