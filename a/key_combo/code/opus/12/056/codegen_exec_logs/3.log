+    if mode == "vertical":
+        dr = diag_len + straight_len
+        dc = dc_sign * diag_len
+        seed_top_left = (p1[0], p1[1] + 1)
+    else:
+        dr = diag_len
+        dc = dc_sign * (diag_len + straight_len)
+        seed_top_left = (p1[0] + 1, p1[1])
