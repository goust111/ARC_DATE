+    return cells
+
+
+def _tile_value(pair: dict, cell: tuple[int, int]) -> int:
+    r, c = cell
+    sr0, sc0, _sr1, _sc1 = pair["seed_bbox"]
+    tile = pair["tile"]
+    return int(tile[(r - sr0) % tile.shape[0], (c - sc0) % tile.shape[1]])
