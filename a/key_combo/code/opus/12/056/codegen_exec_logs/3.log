+    dr = r1 - r0
+    dc = c1 - c0
+    steps = max(abs(dr), abs(dc))
+    assert steps > 0
+    assert abs(dr) in (0, steps)
+    assert abs(dc) in (0, steps)
+    sr = _sign(dr)
+    sc = _sign(dc)
+    return [(r0 + i * sr, c0 + i * sc) for i in range(steps + 1)]
