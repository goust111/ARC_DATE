+    saw_overlap = False
+    for other in placed:
+        other_input = other["seed_cells"] | {other["p1"], other["p2"]}
+        if pair_input & other_input:
+            return False
+        if pair["boundary"] & (other_input | other["boundary"]):
+            return False
+        if pair["interior"] & other_input:
+            return False
+
+        overlap = pair["interior"] & other["interior"]
+        if overlap:
