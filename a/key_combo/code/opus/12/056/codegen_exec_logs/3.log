+
+def _make_pair(
+    shape: tuple[int, int],
+    marker_color: int,
+    seed_color: int,
+    mode: str,
+    p1: tuple[int, int],
+    dc_sign: int,
+    diag_len: int,
+    straight_len: int,
+    seed_mask: np.ndarray,
