+
+
+def _render_output(grid: np.ndarray, pairs: list[dict]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    _owners, values = _fill_assignments(pairs)
+    for (r, c), value in values.items():
