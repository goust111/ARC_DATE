  grid: square, 7-17 rows/cols
  background: 0 (black)
  markers:
    count: 2-3 distinct non-zero colors placed at grid corners
    positions: subset of {TL, TR, BL, BR}; all 4 corners NOT used [observed]
    colors: each marker has a unique non-zero color (1-9)
  output_rule:
    ownership: each cell assigned to its unique nearest marker by squared Euclidean distance; tied cells stay background
    coloring: owned cell gets marker color iff Chebyshev distance from that marker is even (0, 2, 4, ...), else background
    result: concentric square rings around each corner, clipped by Voronoi boundaries

generation_strategy:
