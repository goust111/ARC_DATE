+    color = _target_color(g)
+    center = CELL_SIZE // 2
+
+    template_cell: tuple[int, int] | None = None
+    marker_cells: list[tuple[int, int]] = []
+    for rr, row_span in enumerate(row_spans):
+        for cc, col_span in enumerate(col_spans):
