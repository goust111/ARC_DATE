+            continue
+
+        view = g[r0 : r1 + 1, c0 : c1 + 1]
+        expected_blue = np.zeros((h, w), dtype=bool)
+        expected_blue[:, 0] = True
+        expected_blue[:, -1] = True
+        expected_blue[-1, :] = True
+        if not np.array_equal(view == BLUE, expected_blue):
+            continue
+
+        inner = view[:-1, 1:-1]
+        if inner.size == 0 or np.any(inner == BLUE):
