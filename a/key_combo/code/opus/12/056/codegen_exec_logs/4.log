+    for row in rows:
+        _bridge_row(work, row)
+
+    summary = np.zeros((2, 3), dtype=int)
+    for r, row in enumerate(rows):
+        for c, cup in enumerate(row):
+            summary[r, c] = GREY if _cup_bridged(work, cup) else int(cup["color"])
