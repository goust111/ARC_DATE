+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30, "expected a 2D ARC grid"
+
+    rows = _parse_cups(g)
+    work = g.copy()
+    for row in rows:
+        for cup in row:
+            _fill_and_cap(work, cup)
+    for row in rows:
+        _bridge_row(work, row)
