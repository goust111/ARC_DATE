+def _build_candidate() -> tuple[np.ndarray, set[int]] | None:
+    height = random.randint(18, 24)
+    width = random.randint(18, 24)
+
+    split_options = [c for c in range(6, width - 6) if c >= 6 and width - c - 1 >= 6]
+    if not split_options:
