+
+def _assign_chambers(
+    chambers: list[dict],
+    n_rects: int,
+    n_selected: int,
+) -> tuple[dict, list[dict]] | None:
+    candidates = [ch for ch in chambers if _place_frames_in_chamber(ch["box"], n_selected) is not None]
+    if not candidates:
+        return None
+    selected = random.choice(candidates)
