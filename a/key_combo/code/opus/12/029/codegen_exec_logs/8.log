+    h_grid, w_grid = grid.shape
+    matches = {}
+    for spec in _unique_transforms(source_patch):
+        patch = spec["patch"]
+        marker_mask = patch == MARKER
+        h, w = patch.shape
+        for r0 in range(h_grid - h + 1):
