+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SOURCE_FILL = 3
+MARKER = 7
+PALETTE_COLORS = (1, 2, 4, 5, 6, 8, 9)
+
+GRID_SIDE_MIN = 20
+GRID_SIDE_MAX = 24
+MATCH_COUNT_CHOICES = (2, 3, 4)
