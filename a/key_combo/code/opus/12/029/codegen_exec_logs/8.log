+def _unique_transforms(arr: np.ndarray) -> list[dict]:
+    unique = []
+    seen = set()
+    for flip in (False, True):
+        for rot in range(4):
+            transformed = _transform_array(arr, flip, rot)
+            key = (transformed.shape, transformed.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            unique.append(
+                {
+                    "flip": flip,
+                    "rot": rot,
+                    "patch": transformed.copy(),
