+            break
+    if source_pos is None:
+        return None
+
+    placed_matches = []
+    random.shuffle(chosen_specs)
+    for spec in chosen_specs:
+        patch = spec["patch"]
+        ph, pw = patch.shape
+        positions = [
+            (r0, c0)
+            for r0 in range(h_grid - ph + 1)
+            for c0 in range(w_grid - pw + 1)
+            if _region_is_clear(inp, r0, c0, ph, pw, pad=1)
+        ]
+        if not positions:
+            return None
