+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+RECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_ROWS = (18, 24)
+GRID_COLS = (18, 24)
+RECT_COUNT_RANGE = (3, 5)
+RECT_SIDE_RANGE = (4, 7)
+COUNTS_POOL = [0, 1, 2, 3, 4]
+GEN_RETRIES = 400
+PLACE_RETRIES = 300
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in NEIGHBORS4:
+        yield r + dr, c + dc
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BLACK or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _is_solid_rectangle(comp: dict, grid: np.ndarray) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    color = int(comp["color"])
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    return int(comp["area"]) >= 9 and np.all(patch == color)
+
+
+def _border_mask(box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _touches_rect_border(small: dict, rect: dict) -> bool:
+    r0, c0, r1, c1 = rect["bbox"]
+    border = _border_mask(rect["bbox"])
