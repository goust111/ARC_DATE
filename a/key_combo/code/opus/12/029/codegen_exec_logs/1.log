+    for rect in rects:
+        touches = sum(1 for small in smalls if _touches_rect_border(small, rect))
+        if touches % 2 == 1:
+            r0, c0, r1, c1 = rect["bbox"]
+            interior = out[r0 + 1 : r1, c0 + 1 : c1]
+            rows, cols = np.indices(interior.shape)
+            interior[(rows + cols) % 2 == 0] = BLACK
+
+    for small in smalls:
+        coords = small["coords"]
