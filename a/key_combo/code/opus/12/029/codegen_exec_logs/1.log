+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+RECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_ROWS = (18, 24)
+GRID_COLS = (18, 24)
+RECT_COUNT_RANGE = (3, 5)
+RECT_SIDE_RANGE = (4, 7)
+COUNTS_POOL = [0, 1, 2, 3, 4]
+GEN_RETRIES = 400
+PLACE_RETRIES = 300
