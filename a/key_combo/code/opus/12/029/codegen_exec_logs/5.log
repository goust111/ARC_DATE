+        if len(set(colors)) != len(colors):
+            return False
+        if any(color not in RECT_COLORS for color in colors):
+            return False
+        for i, rect in enumerate(rects):
+            if marker_r >= rect["r0"] and marker_r <= rect["r1"] and marker_c >= rect["c0"] and marker_c <= rect["c1"]:
