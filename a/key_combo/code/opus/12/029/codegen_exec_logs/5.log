+        rr, cc = _reflect(axis_kind, axis_index, marker_r, marker_c)
+        if not (0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1]):
+            return False
+        target = _target_index(rects, (rr, cc))
+
+        out = main(grid)
+        if out.shape != grid.shape:
