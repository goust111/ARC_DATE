+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid reflected-phase rectangle puzzle")

