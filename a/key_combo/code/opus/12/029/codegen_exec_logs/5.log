+        for idx, rect in enumerate(rects)
+        if rect["r0"] < rr < rect["r1"] and rect["c0"] < cc < rect["c1"]
+    ]
+    assert len(hits) == 1, "reflected marker must land in exactly one rectangle interior"
+    return hits[0]
