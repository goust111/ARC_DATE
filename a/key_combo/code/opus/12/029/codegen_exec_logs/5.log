+# --------------- generator (o5x) ---------------
+
+GEN_HEIGHT_RANGE = (16, 23)
+GEN_WIDTH_RANGE = (16, 23)
+GEN_RECT_COUNT_RANGE = (3, 5)
+GEN_RECT_SIDE_RANGE = (4, 7)
+GEN_RETRY_LIMIT = 600
+GEN_AXIS_MARGIN = 6
+GEN_RECT_AXIS_GAP = 1
+GEN_RECT_PAD = 1
+GEN_MARKER_PAD = 1
