+def _bfs_dist(traversable: np.ndarray, seed: tuple[int, int]) -> np.ndarray:
+    h, w = traversable.shape
+    dist = np.full((h, w), INF, dtype=int)
+    sr, sc = seed
+    if not traversable[sr, sc]:
+        return dist
