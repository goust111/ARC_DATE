    backward = _reachable(base, GEN_BG, end, [(-dr, -dc) for dr, dc in moves], bounds)
    path = forward & backward
    assert path[start] and path[end]

    out = base.copy()
    out[path] = GEN_FILL
    for gap, _ in doors:
        out[gap] = GEN_FILL
    return out


def _gen_attempt() -> np.ndarray | None:
    base = np.full(GEN_GRID_SHAPE, GEN_BG, dtype=int)
    doors = []

