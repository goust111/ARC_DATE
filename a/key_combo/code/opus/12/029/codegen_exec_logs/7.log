+    grid[r0 - 1 : r0 + 3, c0 - 1] = GREY
+    grid[r0 - 1 : r0 + 3, c0 + 2] = GREY
+    grid[r0 - 1, c0 - 1 : c0 + 3] = GREY
+    grid[r0 + 2, c0 - 1 : c0 + 3] = GREY
+    return r0, c0
+
+
+def _protected_mask(shape: tuple[int, int], block_rc: tuple[int, int]) -> np.ndarray:
