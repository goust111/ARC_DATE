+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _corner_coords(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+
