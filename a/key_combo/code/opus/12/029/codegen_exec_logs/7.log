+        int(block[0, 1]),
+        int(block[1, 0]),
+        int(block[1, 1]),
+    ]
+    for (r, c), color in zip(_corner_coords(g.shape), corner_colors):
+        seeded[r, c] = color
+    return seeded, corner_colors
