+    q = deque([seed])
+    dist[sr, sc] = 0
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and traversable[rr, cc] and dist[rr, cc] == INF:
+                dist[rr, cc] = dist[r, c] + 1
+                q.append((rr, cc))
