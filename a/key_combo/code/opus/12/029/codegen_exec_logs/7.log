+
+    if branch == "asym":
+        _build_asymmetric_walls(grid, protected)
+    else:
+        _build_symmetric_walls(grid, protected)
+
+    return grid if _validate_generated_input(grid, branch) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
