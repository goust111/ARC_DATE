+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+BLOCK_COLORS = (BLUE, RED, GREEN, YELLOW)
+CORNERS = ((0, 0), (0, -1), (-1, 0), (-1, -1))
+INF = 10**9
+GEN_ATTEMPTS = 600
