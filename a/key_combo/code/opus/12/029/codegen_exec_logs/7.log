+def _prepare_seeded_grid(grid: np.ndarray) -> tuple[np.ndarray, list[int]]:
+    g = np.asarray(grid, dtype=int)
+    r0, c0 = _find_block(g)
+    block = g[r0 : r0 + 2, c0 : c0 + 2].copy()
