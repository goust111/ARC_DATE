+                coords.append((r, c))
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and grid[rr, cc] != BG and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
