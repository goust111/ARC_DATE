+
+BLACK = 0
+GREY = 5
+NON_SPECIAL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_ATTEMPTS = 400
+
+
+def _runs(flags: list[bool]) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = None
+    for idx, flag in enumerate(flags):
+        if flag and start is None:
