            options.append((1, length))
            options.append((-1, length))

    if top == BOTTOM_ROW and must_reach_bottom:
        for length in range(LINE_LENGTH_BOUNDS[0], LINE_LENGTH_BOUNDS[1] + 1):
            options.append((0, length))
