+    length = random.randint(3, 5)
+    steps = _random_stair_steps(length - 1, 1 if orientation == "dr" else -1)
+    down_moves = sum(dr for dr, _ in steps)
+    side_moves = sum(abs(dc) for _, dc in steps)
+    top = random.randint(0, H - 1 - down_moves)
+    if orientation == "dr":
