+def _box_mask(shape: tuple[int, int], box: BBox, *, strict: bool) -> np.ndarray:
+    h, w = shape
+    r0, c0, r1, c1 = map(int, box)
+    if strict:
+        r0 += 1
+        c0 += 1
+        r1 -= 1
+        c1 -= 1
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(h - 1, r1)
+    cc1 = min(w - 1, c1)
+    mask = np.zeros(shape, dtype=bool)
+    if rr0 <= rr1 and cc0 <= cc1:
+        mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+    return mask
