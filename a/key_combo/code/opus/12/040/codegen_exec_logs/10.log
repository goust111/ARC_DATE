+    sides = []
+    if np.all(mask[r0, c0 : c1 + 1]):
+        sides.append("top")
+    if np.all(mask[r1, c0 : c1 + 1]):
+        sides.append("bottom")
+    if np.all(mask[r0 : r1 + 1, c0]):
+        sides.append("left")
+    if np.all(mask[r0 : r1 + 1, c1]):
+        sides.append("right")
+    return tuple(sides)
