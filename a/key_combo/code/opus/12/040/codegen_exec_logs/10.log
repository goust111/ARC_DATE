+
+def _box_area(box: BBox) -> int:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
+
+
+def _box_dims(box: BBox) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
