+def _input_from_design(shape: tuple[int, int], boxes: list[BBox], sides: SideSet, observed_start: int, marker: tuple[int, int], marker_color: int) -> np.ndarray:
+    inp = np.zeros(shape, dtype=int)
+    for box in boxes[observed_start : observed_start + 3]:
+        inp[_draw_sides(shape, box, sides)] = Color.GREY
+    inp[marker] = int(marker_color)
+    return inp
+
