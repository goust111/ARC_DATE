+SIDE_SETS: list[SideSet] = [
+    ("top", "left"),
+    ("top", "right"),
+    ("bottom", "left"),
+    ("bottom", "right"),
+    ("top", "bottom", "left"),
+    ("top", "bottom", "right"),
+    ("top", "left", "right"),
+    ("bottom", "left", "right"),
