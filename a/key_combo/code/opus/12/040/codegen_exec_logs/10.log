+    assert observed_start + 3 < len(boxes), "at least one larger family member must be hidden"
+    assert _strictly_contains(boxes[0], marker), "marker must sit inside the true innermost region"
+    if _box_dims(_add_box(boxes[0], (-1, -1, 1, 1), sign=-1))[0] >= 3:
