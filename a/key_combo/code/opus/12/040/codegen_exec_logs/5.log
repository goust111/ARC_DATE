+    for r, c in np.argwhere(target_mask):
+        colors = colors_by_root.get(find(int(r) * w + int(c)), set())
+        assert len(colors) == 1, "every target class must remain visible somewhere else"
+        out[int(r), int(c)] = next(iter(colors))
+    return out
+
