+    h = g.shape[0] // 2
+    top = g[:h, :]
+    bottom = g[h:, :]
+    targets = (top == BLACK) & (bottom == BLACK)
+    merged = _merge_visible_pattern(top, bottom)
+    assert np.any(merged != MISSING), "need at least one visible pattern pixel"
