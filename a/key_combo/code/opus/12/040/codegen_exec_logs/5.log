+
+    return top_black, bottom_black, blue, red
+
+
+def _oracle_output(field: np.ndarray, shared: np.ndarray) -> np.ndarray:
+    out = np.zeros(field.shape, dtype=int)
+    out[shared] = field[shared]
+    return out
+
+
+def _attempt() -> np.ndarray | None:
