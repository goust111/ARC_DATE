+            if masks is None:
+                continue
+            top_black, bottom_black, blue, red = masks
+            shared = top_black & bottom_black
+
+            top = field.copy()
+            top[top_black] = BLACK
+            top[blue] = BLUE
+
+            bottom = field.copy()
+            bottom[bottom_black] = BLACK
+            bottom[red] = RED
+
+            top_visible = ~np.isin(top, list(SPECIAL))
+            bottom_visible = ~np.isin(bottom, list(SPECIAL))
