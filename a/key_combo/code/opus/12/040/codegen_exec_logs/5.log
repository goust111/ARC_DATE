+def _attempt() -> np.ndarray | None:
+    half_h = random.randint(7, 12)
+    half_w = random.randint(10, 16)
+    shape = (half_h, half_w)
+
+    for shift in _candidate_vectors(half_h, half_w):
+        built = _build_periodic_field(shape, shift)
+        if built is None:
+            continue
+        field, class_ids = built
+
+        for _ in range(80):
