+    blob = {(seed_r, seed_c)}
+    frontier = set()
+    for nr, nc in _neighbors4(seed_r, seed_c):
+        if _in_bounds(shape, nr, nc) and allowed[nr, nc]:
+            frontier.add((nr, nc))
