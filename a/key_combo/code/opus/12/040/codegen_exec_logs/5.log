+    shared = _blob_union(shape, shared_size, 1, np.zeros(shape, dtype=bool))
+    if shared is None:
+        return None
+
+    top_only = _blob_union(
+        shape,
+        top_extra_size,
+        random.choice((1, 1, 2)),
+        shared.copy(),
+    )
+    if top_only is None:
+        return None
+
+    bottom_only = _blob_union(
+        shape,
+        bottom_extra_size,
+        random.choice((1, 1, 2)),
+        shared | top_only,
+    )
+    if bottom_only is None:
+        return None
+
+    top_black = shared | top_only
+    bottom_black = shared | bottom_only
+
+    blue_pref = bottom_only.copy()
+    red_pref = top_only.copy()
+    blue = _blob_union(
+        shape,
+        blue_size,
+        random.choice((1, 1, 2)),
+        top_black.copy(),
+        preferred_seed=blue_pref,
+    )
+    if blue is None:
+        return None
+
+    red = _blob_union(
+        shape,
+        red_size,
+        random.choice((1, 1, 2)),
