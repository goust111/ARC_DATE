+            chosen = None
+            for r0, c0 in candidates:
+                in_box = (r0, c0, r0 + ih - 1, c0 + iw - 1)
+                out_box = (r0, c0, r0 + oh - 1, c0 + ow - 1)
+                if any(not _boxes_separated(in_box, old, pad=1) for old in input_boxes):
