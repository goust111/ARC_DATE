+        return None
+
+    for _ in range(200):
+        src_r = random.randint(3, lattice_h - 4)
+        c1 = random.randint(2, 3)
+        source = (src_r, 0)
+        nodes = {source}
+        edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+
+        def add_line(start: tuple[int, int], dr: int, dc: int, length: int):
+            cur = start
+            for _ in range(length):
+                nxt = (cur[0] + dr, cur[1] + dc)
