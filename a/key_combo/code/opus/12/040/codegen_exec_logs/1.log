_GEN_CANVAS_MIN_H, _GEN_CANVAS_MAX_H = 16, 24
_GEN_CANVAS_MIN_W, _GEN_CANVAS_MAX_W = 12, 26
_GEN_EDGE_PADDING = 1
_GEN_VERTICAL_GAP, _GEN_HORIZONTAL_GAP = 4, 7

