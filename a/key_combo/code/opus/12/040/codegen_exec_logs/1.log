def _gen_place_pair(grid_shape: tuple[int, int], template: np.ndarray, target: np.ndarray, layout: str) -> tuple[tuple[int, int], tuple[int, int]] | None:
    """Sample non-overlapping top-left positions under the chosen layout."""
    h, w = grid_shape
