+import numpy as np
+
+
+BG = 0
+CRACK = 4
+PALETTE = (1, 2, 3, 5, 6, 7, 8, 9)
+MAX_ATTEMPTS = 500
+
+WIDE_DIMS = ((4, 5), (4, 6), (4, 7), (5, 6), (5, 7))
+TALL_DIMS = tuple((w, h) for h, w in WIDE_DIMS)
