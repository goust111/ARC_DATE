+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        pair = _generate_pair()
+        if pair is not None:
+            return pair[0]
+    raise RuntimeError("failed to generate a valid crack-majority ARC input")

