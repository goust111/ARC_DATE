    if np.array_equal(_gen_inp == _gen_dominant, _gen_out == _gen_dominant):
        return False
    _gen_components = [
        comp
        for comp in find_components(
            _gen_out, bg=BACKGROUND_SENTINEL, connectivity=4, monochromatic=True,
            colors=[_gen_dominant], return_format="dict",
