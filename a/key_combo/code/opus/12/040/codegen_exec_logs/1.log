+    random.shuffle(out)
+    return out
+
+
+def _choose_two_colors() -> tuple[int, int]:
+    a, b = random.sample(PALETTE, 2)
+    return int(a), int(b)
+
+
+def _target_majority_count(size: int) -> int:
