  row_groups: 2-4 horizontally separated bands of consecutive foreground rows, separated by >=1 empty rows
  top_group:
    spans all W columns (every column has at least one fg pixel)
    height: 1-3 rows
    column_state_pattern: each column characterized by tuple of row-offsets with fg; compressing consecutive equal states yields 1-10 runs
  lower_groups:
