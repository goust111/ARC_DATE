    Bounding box (bbox) of a boolean mask.

    Args:
        mask: boolean array where True indicates foreground.

    Returns:
        (r0,c0,r1,c1) inclusive, or None if the mask has no True values.
    """
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    return bbox_coords(coords)


