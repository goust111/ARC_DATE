+        for c in range(w)
+        if int(g[0, c]) != BG and np.all(g[:, c] == int(g[0, c]))
+    ]
+    matches = [
+        (r, c, color)
+        for r, color in solid_rows
+        for c, col_color in solid_cols
+        if color == col_color
