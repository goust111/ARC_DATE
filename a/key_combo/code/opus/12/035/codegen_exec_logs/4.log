+    assert color not in {BG, WIRE, HOLE}, "wire must terminate at a colored source"
+    return color, path, (rr, cc)
+
+
+def _fill_by_symmetry(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    out = grid.copy()
+    r0, c0, r1, c1 = bbox
+    row_sum = r0 + r1
+    col_sum = c0 + c1
+
+    changed = True
+    while changed:
+        changed = False
+        for r in range(r0, r1 + 1):
