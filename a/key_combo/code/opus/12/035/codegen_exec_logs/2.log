  24: def main(grid: np.ndarray) -> np.ndarray:
  25:     """
  26:     Paint the empty gutters of a rectangular lattice of grey 2x2 blocks.
  27: 
  28:     Input structure:
  29:     - The background is the most common color.
  30:     - The only foreground color forms a complete rectangular array of separated 2x2 blocks.
  31:     - Blank row bands and column bands between adjacent block bands are the lattice gutters.
  32: 
  33:     Rule:
  34:     - Keep the grey blocks unchanged.
  35:     - Paint gutter background pixels red inside the foreground bounding rectangle.
  36:     - Paint gutter background pixels blue where the same gutter rows or columns extend outside that bounding rectangle.
  37: 
  38:     Key insight:
  39:     - The grey blocks define row bands and column bands; their intervening blank bands are the lines to color, and the block-array bbox separates internal gutters from exterior extensions.
  40:     """
  41:     g = np.asarray(grid, dtype=int)
  42: 
  43:     bg = get_bg(g)
  44:     colors = colors_present(g, exclude={bg})
  45:     assert len(colors) == 1
  46:     block_color = int(colors[0])
  47: 
  48:     block_mask = g == block_color
  49:     block_bbox = bbox(block_mask)
  50:     assert block_bbox is not None
  51:     inside_block_bbox = bbox_mask(block_mask)
  52: 
  53:     components = find_components(g, bg=bg, connectivity=4, colors=[block_color])
  54:     assert components
  55:     for component in components:
  56:         assert int(component["area"]) == 4
  57:         assert bbox_h(component["bbox"]) == 2
  58:         assert bbox_w(component["bbox"]) == 2
  59: 
  60:     row_bands = _true_intervals(block_mask.any(axis=1))
  61:     col_bands = _true_intervals(block_mask.any(axis=0))
  62:     assert len(row_bands) >= 2
  63:     assert len(col_bands) >= 2
  64:     assert all(e - s + 1 == 2 for s, e in row_bands)
  65:     assert all(e - s + 1 == 2 for s, e in col_bands)
  66: 
  67:     row_band_mask = np.zeros(g.shape[0], dtype=bool)
  68:     col_band_mask = np.zeros(g.shape[1], dtype=bool)
  69:     for s, e in row_bands:
  70:         row_band_mask[s : e + 1] = True
  71:     for s, e in col_bands:
  72:         col_band_mask[s : e + 1] = True
  73:     assert np.array_equal(block_mask, row_band_mask[:, None] & col_band_mask[None, :])
  74: 
  75:     row_gutters = np.zeros(g.shape[0], dtype=bool)
  76:     col_gutters = np.zeros(g.shape[1], dtype=bool)
  77:     for (_prev_s, prev_e), (next_s, _next_e) in zip(row_bands, row_bands[1:]):
  78:         assert next_s > prev_e + 1
  79:         row_gutters[prev_e + 1 : next_s] = True
  80:     for (_prev_s, prev_e), (next_s, _next_e) in zip(col_bands, col_bands[1:]):
  81:         assert next_s > prev_e + 1
  82:         col_gutters[prev_e + 1 : next_s] = True
  83:     assert bool(row_gutters.any())
  84:     assert bool(col_gutters.any())
  85: 
  86:     gutter_mask = (row_gutters[:, None] | col_gutters[None, :]) & (g == bg)
