 140:     row_bands = _true_intervals(block_mask.any(axis=1))
 141:     col_bands = _true_intervals(block_mask.any(axis=0))
 142:     row_gutters = np.zeros(block_mask.shape[0], dtype=bool)
 143:     col_gutters = np.zeros(block_mask.shape[1], dtype=bool)
