 145:     for bands, gutters in ((row_bands, row_gutters), (col_bands, col_gutters)):
 146:         for (_prev_s, prev_e), (next_s, _next_e) in zip(bands, bands[1:]):
 147:             gutters[prev_e + 1 : next_s] = True
 148:     return row_gutters, col_gutters
