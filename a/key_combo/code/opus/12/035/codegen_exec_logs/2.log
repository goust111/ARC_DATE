  82: def _gen_grow_parts(total, n):
  83:     n_twos = total - n
  84:     parts = [2] * n_twos + [1] * (n - n_twos)
  85:     random.shuffle(parts)
  86:     return parts
  87: 
  88: def _gen_drop_parts(total, n):
  89:     if n == 0:
  90:         return []
  91:     n_twos = random.randint(max(0, total - n), min(total // 2, n))
  92:     n_ones = total - 2 * n_twos
  93:     parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)
  94:     random.shuffle(parts)
  95:     return parts
