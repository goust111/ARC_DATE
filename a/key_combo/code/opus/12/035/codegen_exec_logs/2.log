 115: def _gen_axis_layout(rng: np.random.Generator, n_bands: int) -> tuple[list[int], int]:
 116:     gutter_widths = [
 117:         int(rng.integers(MIN_GUTTER_WIDTH, MAX_GUTTER_WIDTH + 1))
 118:         for _ in range(n_bands - 1)
 119:     ]
 120:     margin = GRID_SIZE - n_bands * BLOCK_SIZE - sum(gutter_widths)
 121:     if margin < 0:
 122:         return [], -1
 123: 
 124:     min_before = max(0, margin - MAX_SIDE_MARGIN)
 125:     max_before = min(MAX_SIDE_MARGIN, margin)
 126:     before = int(rng.integers(min_before, max_before + 1))
 127: 
 128:     starts: list[int] = []
 129:     pos = before
 130:     for i in range(n_bands):
 131:         starts.append(pos)
 132:         pos += BLOCK_SIZE
 133:         if i < len(gutter_widths):
 134:             pos += gutter_widths[i]
 135:     return starts, margin
