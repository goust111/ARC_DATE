  15: def main(input_grid):
  16:     """
  17:     Drop each non-background, non-baseline pixel to the lowest available cell in its column.
  18: 
  19:     Input structure:
  20:     - The bottom row is a uniform baseline color.
  21:     - The most common color is the background.
  22:     - Other colored pixels may sit above baseline or background cells in their columns.
  23: 
  24:     Rule:
  25:     - Identify the baseline color from the bottom row and the background by frequency.
  26:     - Scan each column from bottom to top.
  27:     - Move every non-background, non-baseline pixel to the lowest background or baseline cell below it.
  28: 
  29:     Key insight:
  30:     - The baseline is treated as passable landing space, so falling pixels can replace it at the bottom.
  31:     """
  32:     output_grid = np.copy(input_grid)
  33: 
  34:     H, W = output_grid.shape
  35: 
  36:     # Find the color of the bottom baseline
  37:     baseline = output_grid[H - 1, :]
  38:     baseline_colors = np.unique(baseline)
  39:     assert len(baseline_colors) == 1
  40:     baseline_color = baseline_colors[0]
  41: 
  42:     # Find the color of the background, which is the most common color
  43:     background_color = np.argmax(np.bincount(output_grid.flatten()))
  44: 
  45:     # Now make all the other colors fall down (along rows).
  46:     for c in range(W):
  47:         for r in range(H - 2, -1, -1):
  48:             if output_grid[r, c] != background_color and output_grid[r, c] != baseline_color:
  49:                 # Find the lowest background/baseline spot below it.
  50:                 possible_r_values = [
  51:                     rr
  52:                     for rr in range(r + 1, H)
  53:                     if output_grid[rr, c] == background_color or output_grid[rr, c] == baseline_color
  54:                 ]
  55:                 if possible_r_values:
  56:                     rr_dest = max(possible_r_values)
  57:                     output_grid[rr_dest, c] = output_grid[r, c]
  58:                     output_grid[r, c] = background_color                  
  59:   
  60:     return output_grid
