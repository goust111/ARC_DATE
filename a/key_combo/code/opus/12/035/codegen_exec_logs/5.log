7: def main(grid: np.ndarray) -> np.ndarray:
8:     """Extract the upper-left tile from a four-quadrant rotational collage.
9: 
10:     Input structure
11:     - A mostly background grid contains one even-sided square motif bbox.
12:     - The motif bbox is split into four equal square quadrants.
13: 
14:     Rule
15:     - Use the upper-left quadrant as the source tile.
16:     - Assert the upper-right, lower-left, and lower-right quadrants are that tile
17:       rotated 90 degrees clockwise, 90 degrees counterclockwise, and 180 degrees.
18:     - Return the upper-left quadrant.
19: 
20:     Key insight
21:     - The input object is a duplicated rotational pattern; the output is the
22:       unrotated source tile embedded at the upper-left of the motif.
23:     """
24:     g = np.asarray(grid, dtype=int)
25:     assert g.ndim == 2, "expected a 2D grid"
26: 
27:     bg = get_bg(g)
28:     box = bbox(g != bg)
29:     assert box is not None, "expected a foreground motif"
30:     r0, c0, r1, c1 = box
31:     motif = g[r0 : r1 + 1, c0 : c1 + 1]
32: 
33:     height, width = motif.shape
34:     assert height == width and height % 2 == 0, "expected an even-sided square motif"
35:     half = height // 2
36:     source = motif[:half, :half]
37: 
38:     assert np.array_equal(
39:         motif[:half, half:], np.rot90(source, -1)
40:     ), "upper-right quadrant must be the clockwise rotation"
41:     assert np.array_equal(
42:         motif[half:, :half], np.rot90(source, 1)
43:     ), "lower-left quadrant must be the counterclockwise rotation"
44:     assert np.array_equal(
45:         motif[half:, half:], np.rot90(source, 2)
46:     ), "lower-right quadrant must be the 180-degree rotation"
47: 
48:     return source.copy()
49: 
