6: def main(grid: np.ndarray) -> np.ndarray:
7:     """
8:     Connect framed squares via colored bridges following a control-pixel sequence.
9: 
10:     Input structure:
11:     - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.
12:     - Control row below squares: colored pixels read left-to-right encode visitation order.
13: 
14:     Rule:
15:     - Start at the square matching first control color c0.
16:     - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.
17:     - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.
18: 
19:     Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.
20:     """
21:     g = np.array(grid, dtype=int)
22:     H, W = g.shape
23:     bg = int(get_bg(g))
24: 
25:     # border color = most common non-bg color
26:     cnt = Counter(map(int, g.flatten()))
27:     border = None
28:     for col, _k in cnt.most_common():
29:         if int(col) != int(bg):
30:             border = int(col)
31:             break
32:     assert not (border is None)
33: 
34:     # detect framed squares as connected components of the border color
35:     lab, n = label_mask(g == int(border), connectivity=4)
36:     frames: list[dict] = []
37:     for cid in range(1, int(n) + 1):
38:         pts = np.argwhere(lab == int(cid))
39:         if int(pts.shape[0]) < 8:
40:             continue
41:         r0, c0 = pts.min(axis=0)
42:         r1, c1 = pts.max(axis=0)
43:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
44:         h = int(r1 - r0 + 1)
45:         w = int(c1 - c0 + 1)
46:         if h < 3 or w < 3:
47:             continue
48: 
49:         t = None
