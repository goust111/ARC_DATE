+def _add_marker(
+    layer_idx: int,
+    row: int,
+    layer_markers: list[list[tuple[int, int]]],
+    layer_rows: list[set[int]],
+    occupied_cols_by_row: dict[int, set[int]],
+    interior_cols: list[int],
+    row_counts: dict[int, int],
