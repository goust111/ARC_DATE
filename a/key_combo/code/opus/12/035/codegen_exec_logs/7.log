+        placed.append((top, left, top + h - 1, left + w - 1))
+    return grid
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(*RECT_HEIGHT_RANGE)
+    w = random.randint(*RECT_WIDTH_RANGE)
+    n_rects = random.choice(RECT_COUNT_OPTIONS)
