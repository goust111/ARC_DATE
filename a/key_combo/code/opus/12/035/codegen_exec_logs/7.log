+
+def _oracle_valid_layers(shape: tuple[int, int], layer_markers: list[list[tuple[int, int]]]) -> bool:
+    h, w = shape
+    merged_counts = np.zeros(h, dtype=int)
+    for markers in layer_markers:
+        if not (1 <= len(markers) <= 3):
