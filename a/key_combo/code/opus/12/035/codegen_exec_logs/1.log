+
+    for cell in _bar_cells(spec, anchor):
+        grid[cell] = BLUE
+        input_occupied[cell] = True
+
+    marker = _marker_cell(spec, anchor)
+    grid[marker] = GREY
+    input_occupied[marker] = True
+    for nr, nc in _neighborhood8(marker, grid.shape):
