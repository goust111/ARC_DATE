+
+def _marker_cell(spec: dict[str, object], anchor: tuple[int, int, int]) -> tuple[int, int]:
+    direction = str(spec["direction"])
+    length = int(spec["length"])
+    a0, a1, side = anchor
+    if direction == "right":
