+_RNG = np.random.default_rng()
+_GRID_MIN = 16
+_GRID_MAX = 25
+_COUNT_CHOICES = np.array([2, 3, 4], dtype=int)
+_COUNT_WEIGHTS = np.array([1, 2, 3], dtype=float)
+_LENGTHS = np.array([5, 6, 7, 8, 9], dtype=int)
+_MAX_ATTEMPTS = 400
