+                            out[rr, cc] = TEAL
+        else:
+            col = int(info["col"])
+            r0 = int(info["r0"])
+            r1 = int(info["r1"])
+            center = float(info["center"])
+            for offset in range(1, radius + 1):
+                top = r0 + offset
+                bottom = r1 - offset
+                for cc in (col - offset, col + offset):
