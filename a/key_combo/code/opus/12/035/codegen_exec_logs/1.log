+        length = int(info["length"])
+        radius = int(info["radius"])
+        dr, dc = info["direction"]  # type: ignore[misc]
+
+        if info["orientation"] == "H":
+            row = int(info["row"])
+            c0 = int(info["c0"])
+            c1 = int(info["c1"])
+            center = float(info["center"])
