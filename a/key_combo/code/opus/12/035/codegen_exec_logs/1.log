+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREY = 5
+TEAL = 8
+
+_DIR_TO_VEC = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
