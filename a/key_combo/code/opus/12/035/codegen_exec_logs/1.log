+            "row": rows[0],
+            "c0": c0,
+            "c1": c1,
+            "length": length,
+            "radius": (length - 1) // 2,
+            "center": (c0 + c1) / 2.0,
+            "endpoints": ((rows[0], c0), (rows[0], c1)),
+        }
+    if len(cols) == 1:
+        length = r1 - r0 + 1
+        expected = {(r, cols[0]) for r in range(r0, r1 + 1)}
+        assert len(coords) == length and expected == set(map(tuple, coords)), "blue object must be a solid vertical bar"
+        return {
+            "orientation": "V",
+            "col": cols[0],
+            "r0": r0,
+            "r1": r1,
+            "length": length,
+            "radius": (length - 1) // 2,
