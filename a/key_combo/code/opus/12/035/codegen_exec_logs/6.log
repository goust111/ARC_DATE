   9: def _alternating_row(start: int, width: int) -> np.ndarray:
  10:     assert start in (Color.BLACK, Color.YELLOW), "alternating row must start with black or yellow"
  11:     other = Color.YELLOW if start == Color.BLACK else Color.BLACK
