 138: def scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
 139:     """
 140:     Scale a sprite by an integer factor using nearest-neighbor replication.
 141: 
 142:     Returns an array of shape (h*factor, w*factor).
 143:     """
 144:     k = int(factor)
 145:     if k <= 0:
 146:         raise ValueError("scale_sprite: factor must be >= 1")
 147:     return np.kron(sprite, np.ones((k, k), dtype=sprite.dtype))
