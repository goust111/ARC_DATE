  15: def main(grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Recolor the yellow pixels in every third column of the three-row alternating lattice to pink.
  18: 
  19:     Input structure
  20:     - A 3-row grid containing only black bg and yellow foreground.
  21:     - The middle row is solid yellow.
  22:     - The top row alternates black/yellow, and the bottom row is its color complement.
  23: 
  24:     Rule
  25:     - Keep the grid shape and all black pixels unchanged.
  26:     - In columns 0, 3, 6, ..., recolor any yellow pixel to pink.
  27: 
  28:     Key insight
  29:     - The pink marks are not new objects; they are a regular column-period highlight applied only where the yellow lattice already has pixels.
  30:     """
  31:     g = np.asarray(grid, dtype=int)
  32:     assert g.ndim == 2, "expected a 2D grid"
  33:     height, width = map(int, g.shape)
  34:     assert height == 3, "expected exactly three rows"
  35:     assert width > 0, "expected a nonempty lattice"
  36:     assert set(map(int, np.unique(g))) == {Color.BLACK, Color.YELLOW}, "expected only black and yellow"
  37:     assert np.all(g[1, :] == Color.YELLOW), "middle row must be solid yellow"
  38: 
  39:     expected_top = _alternating_row(int(g[0, 0]), width)
  40:     expected_bottom = np.where(expected_top == Color.YELLOW, Color.BLACK, Color.YELLOW)
  41:     assert np.array_equal(g[0, :], expected_top), "top row must alternate"
  42:     assert np.array_equal(g[2, :], expected_bottom), "bottom row must complement the top row"
  43: 
  44:     out = g.copy()
  45:     recolor = np.zeros(g.shape, dtype=bool)
  46:     recolor[:, ::3] = g[:, ::3] == Color.YELLOW
  47:     out[recolor] = Color.PINK
  48:     return out
