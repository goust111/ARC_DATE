+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MAIN = 1
+DISTRACTOR = 2
+MARKER = 7
+
+GRID_MIN = 13
+GRID_MAX = 18
+BLUE_AREA_MIN = 15
+BLUE_AREA_MAX = 25
+MAX_GENERATION_ATTEMPTS = 500
