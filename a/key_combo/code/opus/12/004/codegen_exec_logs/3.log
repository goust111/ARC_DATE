+
+
+def _semantic_check(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    if not set(np.unique(grid)).issubset({BG, MAIN, DISTRACTOR, MARKER}):
+        return False
+
+    try:
