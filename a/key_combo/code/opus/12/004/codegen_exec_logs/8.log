+def _extract_pairs(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    colors = [int(color) for color in np.unique(g) if int(color) != BACKGROUND]
+    assert 3 <= len(colors) <= 4, "expected 3-4 colored marker pairs"
