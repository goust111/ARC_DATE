+def _simulate_paths(grid: np.ndarray, pairs: list[dict]) -> tuple[np.ndarray, list[dict]]:
+    out = np.asarray(grid, dtype=int).copy()
+    path_mask = np.zeros(out.shape, dtype=bool)
+    events: list[dict] = []
+
+    for pair in pairs:
+        color = int(pair["color"])
+        start = tuple(pair["start"])
+        end = tuple(pair["end"])
+        r, c = start
+        end_r, end_c = end
+        route = [start]
+
+        dc = 1 if end_c > c else -1
+        collided_h = False
+        while c != end_c:
+            next_c = c + dc
+            if path_mask[r, next_c]:
+                collided_h = True
+                break
+            c = next_c
+            route.append((r, c))
+            if out[r, c] == BACKGROUND:
+                out[r, c] = color
+                path_mask[r, c] = True
+
+        dr = 1 if end_r > r else -1
+        stopped_v = False
+        while r != end_r:
+            next_r = r + dr
+            if path_mask[next_r, c]:
+                stopped_v = True
+                break
+            r = next_r
+            route.append((r, c))
+            if out[r, c] == BACKGROUND:
+                out[r, c] = color
+                path_mask[r, c] = True
+
+        events.append(
