+GRID_HEIGHT_RANGE = (16, 22)
+GRID_WIDTH_RANGE = (16, 24)
+PAIR_COUNT_CHOICES = (3, 4)
+START_COL_MAX = 4
+ROW_GAP_AFTER_CLEAR = 2
+MAX_GENERATION_ATTEMPTS = 500
