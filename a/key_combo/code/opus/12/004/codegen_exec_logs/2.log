+        color_idx += 1
+
+    return assignments
+
+
+def _place_left_seeds(grid: np.ndarray, divider: int, projected: list[dict]) -> None:
+    for item in projected:
+        r = item["proj_r"]
+        proj_c = item["proj_c"]
+        seed_c = 2 * divider - proj_c
+        assert 0 <= r < grid.shape[0]
+        assert 0 <= seed_c < divider
+        assert grid[r, seed_c] == BG
