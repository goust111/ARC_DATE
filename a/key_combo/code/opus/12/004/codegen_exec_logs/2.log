+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        height = random.randint(12, 18)
+        width = random.choice([18, 20, 22, 24])
+        seed_count = random.randint(4, 6)
+
+        grid = _make_partitioned_grid(height, width)
+        divider = _find_divider(grid)
