    H, W = input_grid.shape
    step = H - 1
    out_H = step * 4 + 1
    out_W = W
    output_grid = np.full((out_H, out_W), Color.BLACK, dtype=int)

    flipped_input = np.flipud(input_grid)
    for k in range(4):
