+AREA_TO_SHIFT = {3: -2, 4: -1, 5: 0, 6: 1, 7: 2}
+
+GLYPH_TEMPLATES = {
+    3: np.array([[1, 0, 0], [0, 1, 0], [0, 0, 1]], dtype=int),
+    4: np.array([[1, 1, 0], [0, 1, 0], [0, 0, 1]], dtype=int),
+    5: np.array([[1, 1, 0], [0, 1, 0], [1, 0, 1]], dtype=int),
+    6: np.array([[1, 1, 0], [1, 1, 1], [1, 0, 0]], dtype=int),
