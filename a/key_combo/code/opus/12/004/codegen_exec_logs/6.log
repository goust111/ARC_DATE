+def _neighbors(r: int, c: int, conn8: bool) -> Iterable[tuple[int, int]]:
+    if conn8:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                yield r + dr, c + dc
+        return
