+    assert total_shear > 0, "expected a left-leaning shear"
+    assert total_shear % span == 0, "expected an integer shear rate"
+    return {
+        "top": top,
+        "bottom": bottom,
+        "span": span,
+        "S": total_shear,
+        "k": total_shear // span,
+    }
