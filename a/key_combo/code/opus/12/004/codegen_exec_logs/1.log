+    h, w = shape
+    restored = []
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c) + int(shear_rate) * (int(bottom) - int(r))
+        if 0 <= rr < h and 0 <= cc < w:
+            restored.append((rr, cc))
+    return restored
+
