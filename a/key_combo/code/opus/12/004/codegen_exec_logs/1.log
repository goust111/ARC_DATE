+        if int(row[c]) == BG:
+            c += 1
+            continue
+        color = int(row[c])
+        start = c
+        while c < row.shape[0] and int(row[c]) == color:
+            c += 1
+        width = c - start
+        legend[width] = color
+    return legend
+
