+def _component_coords(mask: np.ndarray) -> list[tuple[int, int]]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return []
+    seen = set()
+    q = [tuple(map(int, coords[0]))]
+    seen.add(q[0])
+    out = []
+    while q:
+        r, c = q.pop()
+        out.append((r, c))
+        for dr, dc in DIRS4:
