+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return bool(
+        np.any(mask[0, :])
+        and np.any(mask[-1, :])
+        and np.any(mask[:, 0])
+        and np.any(mask[:, -1])
+    )
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    return len(_component_coords(mask)) == int(mask.sum())
+
+
+def _path_seed(h: int, w: int) -> set[tuple[int, int]]:
+    left_to_right = random.choice([False, True])
+    if left_to_right:
+        r, c = 0, 0
+        horizontal_step = 1
+    else:
+        r, c = 0, w - 1
+        horizontal_step = -1
+    cells = {(r, c)}
+    steps = ["V"] * (h - 1) + ["H"] * (w - 1)
+    random.shuffle(steps)
+    for step in steps:
+        if step == "V":
+            r += 1
+        else:
+            c += horizontal_step
+        cells.add((r, c))
+    return cells
+
