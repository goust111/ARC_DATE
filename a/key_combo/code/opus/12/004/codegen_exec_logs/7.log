+        patch = np.where(mask, color, BG)
+        grid[r0 : r0 + box_h, c0 : c0 + box_w] = patch
+
+    return grid
+
+
+def _semantic_ok(grid: np.ndarray, require_counterexample: bool) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
