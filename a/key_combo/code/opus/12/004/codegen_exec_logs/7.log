+        horizontal_step = 1
+    else:
+        r, c = 0, w - 1
+        horizontal_step = -1
+    cells = {(r, c)}
+    steps = ["V"] * (h - 1) + ["H"] * (w - 1)
+    random.shuffle(steps)
+    for step in steps:
