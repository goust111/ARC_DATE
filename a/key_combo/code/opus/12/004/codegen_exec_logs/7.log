+    from arc_utils import bbox, crop_bbox, scale_sprite
+except ModuleNotFoundError:
+    _ARC_UTILS = SourceFileLoader(
+        "arc_utils_fallback",
+        "/home/lixinyu/snap/new/solvers/arc_utils.py",
+    ).load_module()
