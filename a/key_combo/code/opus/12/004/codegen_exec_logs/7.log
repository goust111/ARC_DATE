spec:
  grid: 9x9, background 0 [observed]
  foreground:
    color: exactly 1 non-background color; always 4 (yellow) [observed]
    pixel_count: 4-8
    bbox: 3-5 rows x 3-5 cols; each dimension <=5 so 2x output <=10
    density: 0.4-0.7 of bbox area
    bbox_edge_contact: fg touches all 4 edges of its bbox
    connectivity: not required (can be 1 or many 4-connected components)
    placement: bbox fits within the 9x9 grid with >=1 cell margin on each side [observed]
  transform: crop bbox, then scale each pixel to a 2x2 block
  output: (2*bbox_h) x (2*bbox_w) grid

generation_strategy:
  approach: direct (input-first) -- transformation is trivial, no constraint inversion needed
