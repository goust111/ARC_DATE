+        require_counterexample = random.random() < 0.6
+        counts = _find_count_tuple(region_heights, boxes, desired_winner, require_counterexample)
+        if counts is None and require_counterexample:
+            require_counterexample = False
+            counts = _find_count_tuple(region_heights, boxes, desired_winner, require_counterexample)
+        if counts is None:
