+import numpy as np
+
+
+BG = 0
+MARKER_COLORS = (2, 3, 4, 6)
+CENTER_COLORS = (1, 5, 7, 8)
+MARKER_AREA_VALUES = (2, 3)
+MARKER_PIXELS_PER_CLUSTER = 12
