+    if ne["bbox"][0] != outer_r0 or ne["bbox"][3] != outer_c1:
+        return None
+    if sw["bbox"][2] != outer_r1 or sw["bbox"][1] != outer_c0:
+        return None
+    if se["bbox"][2] != outer_r1 or se["bbox"][3] != outer_c1:
