+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+
+    clusters = _find_clusters(grid)
+    solved_colors = sorted(cluster["marker_color"] for cluster in clusters)
+    if solved_colors != sorted(MARKER_COLORS):
