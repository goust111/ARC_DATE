+def _random_connected_mask(height: int, width: int) -> np.ndarray:
+    for _ in range(120):
+        area = random.randint(5, min(9, height * width))
+        mask = np.zeros((height, width), dtype=bool)
+        start = (random.randrange(height), random.randrange(width))
+        mask[start] = True
