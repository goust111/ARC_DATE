+        while int(mask.sum()) < area:
+            frontier = set()
+            for r, c in np.argwhere(mask):
+                for nr, nc in _neighbors4(int(r), int(c)):
+                    if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
