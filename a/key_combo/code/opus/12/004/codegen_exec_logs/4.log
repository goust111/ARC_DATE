+    return True
+
+
+def _add_noise_pixels(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    color_to_extra: dict[int, int],
+) -> bool:
+    h, w = grid.shape
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+
+    for color, count in color_to_extra.items():
+        placed = 0
+        for r, c in cells:
+            if _can_place_noise(grid, occupied, r, c):
