+        "reroute_meta": tuple(reroute_meta),
+        "tie_reroutes": tie_reroutes,
+        "horizontal_turn": horizontal_turn,
+        "final_col": c,
+    }
+
+
+def _solve_with_trace(grid: np.ndarray) -> tuple[np.ndarray, list[dict], np.ndarray]:
