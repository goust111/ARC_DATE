+        "obstacle_rows": (1, 3),
+        "endpoint_count": 3,
+        "require_tie_reroute": False,
+        "require_second_band_reroute": True,
+        "require_offcol_endpoint": True,
+    },
+    {
+        "source_count": 4,
+        "start_choices": (3, 4, 5),
+        "obstacle_rows": (3,),
