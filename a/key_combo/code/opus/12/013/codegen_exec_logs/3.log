+
+BG = 0
+BLUE = 1
+RED = 2
+GREY = 5
+TEAL = 8
+
+MAX_ATTEMPTS = 500
+GRID_H_RANGE = (13, 18)
+GRID_W_RANGE = (13, 18)
+CHAIN_ARM_RANGE = (4, 7)
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components_from_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    neigh = neighbors4 if connectivity == 4 else neighbors8
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neigh(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
