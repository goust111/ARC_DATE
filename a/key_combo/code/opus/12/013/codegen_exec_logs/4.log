        "tr": (r0, c0 + side),
        "bl": (r0 + side, c0),
        "br": (r0 + side, c0 + side),
    }


def _gen_orient_from_tl_anchor(mask: np.ndarray, sign: tuple[int, int]) -> np.ndarray:
    out = mask.copy()
    if sign[0] > 0:
        out = out[::-1, :]
    if sign[1] > 0:
        out = out[:, ::-1]
    return out


