+def _sprite_global_cells(sprite: np.ndarray, origin: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0 = origin
+    return {(r0 + r, c0 + c) for r, c in np.argwhere(sprite != BG)}
+
+
+def _render_expected_output(
