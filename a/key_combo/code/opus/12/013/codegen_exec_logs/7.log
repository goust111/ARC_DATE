+        if random.random() < 0.6:
+            diag = _find_single_cell(patch, cells, diagonal_only=True)
+            if diag is not None:
+                patch[diag] = MARKER
+                cells.add(diag)
+
+        if asymmetric:
+            cell = _find_single_cell(patch, cells, off_diagonal_only=True)
+            if cell is None:
+                continue
+            tr = (cell[1], cell[0])
+            if patch[tr] == MARKER:
+                continue
+            patch[cell] = MARKER
+            cells.add(cell)
+        else:
+            if random.random() < 0.5:
+                choices = [(r, c) for r in range(size) for c in range(r + 1, size)]
+                random.shuffle(choices)
+                placed = False
+                for r, c in choices:
+                    if not _can_place(cells, ((0, 0),), r, c, size, size):
+                        continue
+                    if not _can_place(cells, ((0, 0),), c, r, size, size):
+                        continue
+                    patch[r, c] = MARKER
+                    patch[c, r] = MARKER
+                    cells.add((r, c))
+                    cells.add((c, r))
+                    placed = True
+                    break
+                if not placed and random.random() < 0.2:
+                    continue
