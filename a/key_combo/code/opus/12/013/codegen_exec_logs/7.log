+    7: [
+        ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (3, 1), (4, 1)),
+        ((0, 0), (0, 1), (1, 0), (1, 1), (2, 0), (2, 1), (3, 0)),
+    ],
