+    best = max(counts)
+    winners = [item for item in summary if item["count5"] == best]
+    if len(winners) != 2:
+        return None
+    if sum(not item["symmetric"] for item in winners) != 1:
+        return None
+    if not _distinct_shapes([item["patch"] for item in summary]):
