+
+def _rotate_shape(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    h = max(r for r, _ in cells) + 1
+    return _normalize_shape(tuple((c, h - 1 - r) for r, c in cells))
+
