+import numpy as np
+
+
+BACKGROUND = 3
+MARKER = 7
+FILL_COLORS = (1, 2, 4, 5, 6, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+MIN_REGION_GAP = 1
