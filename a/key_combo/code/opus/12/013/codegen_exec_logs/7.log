+def _place_patches(patches: list[np.ndarray]) -> np.ndarray | None:
+    heights = [patch.shape[0] for patch in patches]
+    widths = [patch.shape[1] for patch in patches]
+    min_h = max(15, max(heights) + 2)
+    min_w = max(15, max(widths) + 2)
+    max_h = 24
+    max_w = 24
+    for _ in range(180):
