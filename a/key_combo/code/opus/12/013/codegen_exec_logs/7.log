+
+def _make_general_patch(h: int, w: int, fill: int, area5_count: int) -> np.ndarray | None:
+    for _ in range(120):
+        patch = np.full((h, w), int(fill), dtype=int)
+        cells: set[tuple[int, int]] = set()
+        ok = True
