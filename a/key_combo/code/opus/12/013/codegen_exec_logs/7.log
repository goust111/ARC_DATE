+    off_diagonal_only: bool = False,
+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    choices = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(choices)
+    for r, c in choices:
+        if diagonal_only and r != c:
+            continue
+        if off_diagonal_only and r == c:
+            continue
+        if not _can_place(cells, ((0, 0),), r, c, h, w):
