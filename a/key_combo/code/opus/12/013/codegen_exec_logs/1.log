+BG = 0
+YELLOW = 4
+GREY = 5
+TOKEN_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+GEN_HEIGHT_RANGE = (14, 18)
+GEN_WIDTH_RANGE = (14, 18)
+GEN_ANCHOR_COUNTS = (2, 3)
+GEN_COLOR_COUNTS = (3, 4)
