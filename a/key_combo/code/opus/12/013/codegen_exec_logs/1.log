+    start, end = _pair_start_end(a, b)
+    step = 1 if end[1] >= start[1] else -1
+    cells = [(start[0], c) for c in range(start[1], end[1] + step, step)]
+    cells.extend((r, end[1]) for r in range(start[0] + 1, end[0] + 1))
+    return start, end, cells
