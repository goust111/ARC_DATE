+        return options
+    left_idx, right_idx = spec["anchors"]
+    return [(a, b) for a in usable[left_idx] for b in usable[right_idx]]
+
+
+def _assign_targets(
+    anchors: list[dict],
+    specs: list[dict],
+    usable: dict[int, list[tuple[int, int]]],
+    require_crossing: bool,
+) -> list[dict] | None:
