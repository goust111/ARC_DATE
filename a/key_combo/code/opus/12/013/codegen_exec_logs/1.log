+    if np.array_equal(out, grid):
+        return False
+    if not np.any(out == YELLOW):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        h = random.randint(*GEN_HEIGHT_RANGE)
+        w = random.randint(*GEN_WIDTH_RANGE)
