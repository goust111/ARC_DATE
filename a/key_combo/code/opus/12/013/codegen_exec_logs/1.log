+        if not ok:
+            continue
+        target_list = [chosen[i] for i in range(len(specs))]
+        if _validate_target_pairs(anchors, target_list, require_crossing):
+            return target_list
+    return None
+
+
+def _far_enough_from_selected(
+    cell: tuple[int, int], selected: set[tuple[int, int]]
