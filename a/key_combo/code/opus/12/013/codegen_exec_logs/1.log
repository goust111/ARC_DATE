+    if len(set(used_targets)) != len(used_targets):
+        return False
+
+    anchor_cells = set().union(*(anchor["cells"] for anchor in anchors))
+    cross_routes = []
+    same_targets = set()
+    interrupted = False
+    for item in pair_targets:
+        if item["mode"] == "same":
+            same_targets.update(item["targets"])
