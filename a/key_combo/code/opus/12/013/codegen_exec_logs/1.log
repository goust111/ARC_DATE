+    for item in token_defs:
+        options = candidates.get((item["anchor_idx"], item["target"]), [])
+        if not options:
+            return None
+        enriched.append({**item, "options": options[:]})
+    order = sorted(range(len(enriched)), key=lambda i: len(enriched[i]["options"]))
