+
+
+def _sample_pair_specs(n_colors: int, n_anchors: int) -> tuple[list[dict], bool]:
+    if n_colors == 3:
+        same_count = 1 if random.random() < 0.65 else 2
+    else:
+        same_count = random.choice([1, 2, 2, 3])
+    cross_count = n_colors - same_count
+    if cross_count == 0:
+        cross_count = 1
+        same_count -= 1
+    if same_count == 0:
+        same_count = 1
+        cross_count -= 1
+
+    specs = []
