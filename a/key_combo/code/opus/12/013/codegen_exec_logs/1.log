+    if any(len(options_by_index[i]) == 0 for i in range(len(specs))):
+        return None
+
+    random.shuffle(order)
+    chosen: dict[int, dict] = {}
+    used: set[tuple[int, int]] = set()
+
+    def backtrack(pos: int) -> bool:
