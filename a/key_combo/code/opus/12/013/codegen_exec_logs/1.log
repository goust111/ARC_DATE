+            same_count += 1
+            pair_targets.append(
+                {
+                    "mode": "same",
+                    "anchors": (pair[0]["anchor_idx"],),
+                    "targets": (pair[0]["target"], pair[1]["target"]),
+                }
+            )
+        else:
