+    by_color: dict[int, list[dict]] = defaultdict(list)
+    for rec in records:
+        by_color[rec["color"]].append(rec)
+
+    out = g.copy()
+    for rec in records:
+        out[rec["source"]] = BG
+    for rec in records:
+        out[rec["target"]] = rec["color"]
