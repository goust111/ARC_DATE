+def _anchor_separated(existing: list[dict], top: int, left: int) -> bool:
+    new_cells = {(top + dr, left + dc) for dr in range(2) for dc in range(2)}
+    for anchor in existing:
+        for a in new_cells:
+            for b in anchor["cells"]:
