+        (top, left + 1),
+        (top + 1, left),
+        (top + 1, left + 1),
+    }
+    frame = [
+        (r, c)
+        for r in range(top - 1, top + 3)
+        for c in range(left - 1, left + 3)
+        if (r, c) not in cells
+    ]
+    side_frame = [
+        (top, left - 1),
+        (top + 1, left - 1),
+        (top, left + 2),
+        (top + 1, left + 2),
+    ]
+    return {
+        "top": top,
+        "left": left,
+        "cells": cells,
+        "frame": frame,
+        "side_frame": side_frame,
