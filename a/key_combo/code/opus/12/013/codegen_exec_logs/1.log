+
+def _chebyshev_to_anchor(cell: tuple[int, int], anchor: dict) -> int:
+    r, c = cell
+    return min(max(abs(r - ar), abs(c - ac)) for ar, ac in anchor["cells"])
+
+
+def _manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
