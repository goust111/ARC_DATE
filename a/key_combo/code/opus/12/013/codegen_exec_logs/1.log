+                token_defs.append({"color": color, "anchor_idx": left_idx, "target": pair["targets"][0]})
+                token_defs.append({"color": color, "anchor_idx": right_idx, "target": pair["targets"][1]})
+
+        tokens = _assign_sources(token_defs, candidates)
