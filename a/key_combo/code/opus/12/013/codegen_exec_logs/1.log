+    frame_distances = [_manhattan(cell, target) for target in anchor["frame"]]
+    best_frame_distance = min(frame_distances)
+    best_targets = [
+        target
+        for target, dist in zip(anchor["frame"], frame_distances, strict=False)
+        if dist == best_frame_distance
