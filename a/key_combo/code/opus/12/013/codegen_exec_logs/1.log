+def _pair_start_end(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    return (a, b) if a <= b else (b, a)
+
+
+def _path_cells(
+    a: tuple[int, int], b: tuple[int, int]
