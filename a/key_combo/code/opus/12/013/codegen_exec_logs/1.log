+        if not options:
+            return None
+        enriched.append({**item, "options": options[:]})
+    for _ in range(200):
+        order = sorted(
+            range(len(enriched)),
+            key=lambda i: (len(enriched[i]["options"]), random.random()),
+        )
+        chosen: dict[int, tuple[int, int]] = {}
+        used: set[tuple[int, int]] = set()
+        ok = True
+        for idx in order:
