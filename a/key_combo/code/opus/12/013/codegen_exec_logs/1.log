+            out[b["target"]] = YELLOW
+        else:
+            start, end, cells = _path_cells(a["target"], b["target"])
+            path_jobs.append(
+                {
+                    "color": color,
+                    "start": start,
+                    "end": end,
+                    "cells": cells,
+                }
+            )
