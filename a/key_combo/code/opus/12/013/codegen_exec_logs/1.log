+    targets = [rec["target"] for rec in records]
+    if len(set(targets)) != len(targets):
+        return False
+
+    by_color: dict[int, list[dict]] = defaultdict(list)
+    for rec in records:
+        by_color[rec["color"]].append(rec)
+    same_count = 0
+    cross_count = 0
+    pair_targets = []
+    for pair in by_color.values():
