+
+def _random_connected_shape(area: int) -> np.ndarray:
+    dims = []
+    for h in range(1, 5):
+        for w in range(1, 5):
+            if area <= h * w and h * w <= area + 3:
+                dims.append((h, w))
+    for _ in range(200):
+        h, w = random.choice(dims)
+        mask = np.zeros((h, w), dtype=bool)
+        start = (random.randrange(h), random.randrange(w))
+        mask[start] = True
+        cells = {start}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            pick = random.choice(frontier)
+            cells.add(pick)
+            mask[pick] = True
+        if len(cells) != area:
+            continue
+        rows = np.any(mask, axis=1)
+        cols = np.any(mask, axis=0)
+        mask = mask[rows][:, cols]
+        if int(mask.sum()) == area:
+            return mask
+    raise RuntimeError(f"failed to build a connected shape of area {area}")
+
+
+def _place_shape(
+    mask: np.ndarray,
+    forbidden: set[tuple[int, int]] | None = None,
+    occupied: set[tuple[int, int]] | None = None,
+    require_gap8: bool = False,
+) -> set[tuple[int, int]] | None:
+    forbidden = set() if forbidden is None else set(forbidden)
+    occupied = set() if occupied is None else set(occupied)
+    h, w = mask.shape
+    placements = []
+    for r0 in range(PANEL_SIZE - h + 1):
+        for c0 in range(PANEL_SIZE - w + 1):
+            coords = {
+                (r0 + r, c0 + c)
+                for r, c in zip(*np.where(mask))
+            }
+            if coords & forbidden:
+                continue
+            if coords & occupied:
+                continue
+            if require_gap8 and any(
+                (nr, nc) in occupied
+                for r, c in coords
+                for nr, nc in _neighbors8(r, c)
+            ):
+                continue
