+    mask = np.isin(left, (RED, GREEN))
+    pairs: list[list[tuple[int, int]]] = []
+    for comp in _mask_components(mask):
+        if len(comp) != 2:
+            continue
+        colors = {int(left[r, c]) for r, c in comp}
+        if colors == {RED, GREEN}:
+            pairs.append(comp)
+    return pairs
+
+
