+
+
+def _assemble_grid(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    grid = np.full(GRID_SHAPE, YELLOW, dtype=int)
+    grid[:, PANEL_SIZE] = GREY
+    grid[:, :PANEL_SIZE] = left
+    grid[:, PANEL_SIZE + 1 :] = right
+    return grid
