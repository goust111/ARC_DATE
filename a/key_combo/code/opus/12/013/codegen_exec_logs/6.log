+
+def _render_right_panel(objects: list[set[tuple[int, int]]]) -> np.ndarray:
+    right = np.full((PANEL_SIZE, PANEL_SIZE), YELLOW, dtype=int)
+    for obj in objects:
+        for r, c in obj:
+            right[r, c] = ORANGE
