+def _domino_pairs(left: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.isin(left, (RED, GREEN))
+    pairs: list[list[tuple[int, int]]] = []
+    for comp in _mask_components(mask):
+        if len(comp) != 2:
