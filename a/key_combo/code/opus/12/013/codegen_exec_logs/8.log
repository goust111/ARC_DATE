+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+TEAL = 8
+
+DIRS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if (dr, dc) != (0, 0)
+)
+
+Shape = tuple[tuple[int, int], ...]
+
+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dirs = DIRS8 if connectivity == 8 else ((-1, 0), (1, 0), (0, -1), (0, 1))
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in dirs:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(cells, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _normalize(coords: np.ndarray | Shape) -> Shape:
+    pts = np.asarray(coords, dtype=int)
+    pts = pts - pts.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in pts))
+
+
+def _shape_size(shape: Shape) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
