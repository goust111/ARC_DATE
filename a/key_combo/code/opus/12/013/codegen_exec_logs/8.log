+    occupied: set[tuple[int, int]] = set()
+    matches: list[dict] = []
+    for rotation, flip in _sample_match_transforms(match_count):
+        placed = _try_place_match(grid, occupied, template_shape, stamp_shape, rotation, flip)
+        if placed is None:
+            return None
+        matches.append(placed)
