  "type": "transform_in_place",
  "src": "noisy lattice with complete non-background separator rows/columns and scattered marker-color pixels",
  "transform": "clear marker pixels outside lattice intersections; repaint separator rows/columns with the lattice color and paint every intersection with the marker color"
}
</annotation>
