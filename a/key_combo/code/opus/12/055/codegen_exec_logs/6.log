spec:
  grid: 12-19 rows x 12-19 cols
  colors:
    bg: 0 (black)
    bar_color: any non-bg color [observed: always 8]
    ctrl_color: any non-bg color != bar_color [observed: always 2]
  bars:
    count: 1-2 complete parallel lines (all-bar_color rows or all-bar_color columns)
    orientation: horizontal (full rows) XOR vertical (full cols)
    edge_margin: each bar >= 3 from nearest grid edge (for 3x3 stamp)
    inter_bar_gap: >= 5 if 2 bars (observed 6-11)
  control_pixels:
    count: 1-4 isolated pixels of ctrl_color
    placement: not on any bar line; each has unique perpendicular coord (no shared column for H-bars / no shared row for V-bars) [observed]
    min_dist_to_nearest_bar: >= 3 (so 3x3 stamp does not overwrite ctrl pixel)
    perpendicular_margin: >= 1 from grid edge (hit stamp needs 3x3 room)
  output_rule: |
    For each ctrl pixel, cast rays perpendicular to bars in both directions.
    Each ray stops at the first bar it hits; fill ctrl-to-hit segment with ctrl_color.
    After all rays: stamp 3x3 bar_color block centered on each hit, restore center to ctrl_color.
  hits:
    total: 2-5 per example (observed); no two hits within Manhattan distance 2 (no 3x3 overlap)
    ray_length: 3-12 cells (ctrl-to-bar distance along perpendicular axis)

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dims 12-19 x 12-19, orientation (H or V), n_bars in {1,2}, n_ctrl in 1-4.
    2. Place bars with edge_margin >= 3 and inter-gap >= 5.
    3. For each ctrl pixel, choose a unique perpendicular coord (>= 1 from edge).
       Choose a parallel coord >= 3 from the nearest bar it will hit. Ensure no two
       ctrl pixels produce hit points within distance 2 of each other.
    4. Build output: fill rays, stamp 3x3 markers.
    5. Derive input: output minus rays and stamps (just bars + ctrl pixels on bg).
