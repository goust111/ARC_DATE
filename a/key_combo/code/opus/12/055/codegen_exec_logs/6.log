+            intersection_crossings = 0
+            if point[0] == target[0]:
+                lo, hi = sorted((point[1], target[1]))
+                intersection_crossings = sum(lo < c < hi for c in cols)
+            else:
+                lo, hi = sorted((point[0], target[0]))
+                intersection_crossings = sum(lo < r < hi for r in rows)
