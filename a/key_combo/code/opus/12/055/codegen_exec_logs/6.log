+
+def _render_input(
+    h: int,
+    w: int,
+    rows: list[int],
+    cols: list[int],
+    start: tuple[int, int],
+    obstacles: list[tuple[int, int]],
+    obstacle_colors: list[int],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    grid[rows, :] = ROW_LINE
+    grid[:, cols] = COL_LINE
+    for (r, c), color in zip(obstacles, obstacle_colors):
+        grid[r, c] = int(color)
