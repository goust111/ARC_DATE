spec:
  grid: 10-17 rows x 15-17 cols, background 0 (black)
  foreground_rectangle:
    shape: 4-7 rows x 5-8 cols, fully filled (no background inside)
    colors: exactly 2 non-background colors -- one dominant, one accent
    dominant_fill: 75-84% of rectangle cells
    accent_fill: 16-25% of rectangle cells, NOT LR-symmetric [observed]
    accent_components: 1-4 connected components, each size 1-5 cells
  placement: rectangle placed anywhere in the grid with >=1 cell border of background on all sides
  transform: crop to foreground bbox, then flip columns left-to-right
  output: the cropped rectangle with columns reversed (horizontal mirror)

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dims H in [10,17], W in [15,17]
    2. Pick rect dims rh in [4,7], rw in [5,8]
    3. Pick 3 distinct colors -- bg=0, dominant (non-0), accent (non-0, != dominant)
    4. Build rect filled with dominant color
    5. Scatter accent pixels (15-25% of rect area) in 1-4 connected blobs, ensuring the pattern is NOT left-right symmetric
    6. This rect IS the output (after LR flip)
    7. Flip rect LR to get the input version of the rectangle
    8. Place the input rect at random position (r0, c0) with r0>=1, c0>=1, r0+rh<=H-1, c0+rw<=W-1
    9. Fill remaining grid with background 0
