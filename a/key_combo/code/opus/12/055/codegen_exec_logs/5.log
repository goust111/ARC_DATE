def bbox_h(b: BBox) -> int:
    r0, _c0, r1, _c1 = b
    return int(r1 - r0 + 1)


def bbox_w(b: BBox) -> int:
    _r0, c0, _r1, c1 = b
    return int(c1 - c0 + 1)


