+def _component_aligned_to_marker(comp: dict, markers: dict[int, tuple[int, int]]) -> int | None:
+    hits = []
+    for color, (mr, mc) in markers.items():
+        if mr in comp["rows"] or mc in comp["cols"]:
+            if (mr in comp["rows"]) and (mc in comp["cols"]):
+                continue
+            hits.append(color)
+    if len(hits) == 1:
+        return int(hits[0])
+    return None
