+            if not _candidate_uniquely_aligns(marker, other_marker, slot, r0, c0):
+                return None
+            patch = np.full((2, 2), next(color_iter), dtype=int)
+            try:
+                _paint_patch(core, r0, c0, patch, BG)
+            except AssertionError:
+                return None
+            blocks.append(
+                {
+                    "marker_color": marker_color,
+                    "marker": marker,
+                    "slot": slot,
+                    "output_r0": r0,
+                    "output_c0": c0,
+                    "color": int(patch[0, 0]),
+                }
