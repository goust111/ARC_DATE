+        if int(comp["color"]) in (BLUE_MARKER, RED_MARKER):
+            continue
+        marker_color = _component_aligned_to_marker(comp, markers)
+        if marker_color == RED_MARKER:
+            red_count += 1
+        elif marker_color == BLUE_MARKER:
+            blue_count += 1
