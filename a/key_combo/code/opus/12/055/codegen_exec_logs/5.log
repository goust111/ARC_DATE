+    red_count = 0
+    blue_count = 0
+    n_valid = 0
+    for comp in comps:
+        if int(comp["color"]) in (BLUE_MARKER, RED_MARKER):
+            assert int(comp["area"]) == 1
+            continue
+        if not _is_solid_2x2(comp):
+            continue
+        marker_color, axis = _aligned_marker(comp, markers)
+        r0, c0 = _slide_bbox(comp, markers[marker_color], axis)
