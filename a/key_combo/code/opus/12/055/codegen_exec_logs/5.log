+def _generate_attempt() -> np.ndarray | None:
+    size = random.randint(11, 14)
+    branch = random.choice(("h", "v", "t"))
+    blue_count, red_count = None, None
+    red_count, blue_count = random.choice(BRANCH_COUNTS[branch])
