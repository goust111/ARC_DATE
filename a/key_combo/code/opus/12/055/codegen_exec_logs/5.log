+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE_MARKER = 1
+RED_MARKER = 2
+VALID_BLOCK_COLORS = (3, 4, 6, 7, 8, 9)
