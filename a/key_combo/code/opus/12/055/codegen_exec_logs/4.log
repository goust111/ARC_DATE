+    out = g.copy()
+    for ray in rays:
+        for dist, (r, c) in enumerate(ray["cells"], start=1):
+            out[r, c] = cycle[(dist - 1) % len(cycle)]
+        ray["actual_len"] = len(ray["cells"])
+        ray["center_color"] = cycle[(len(ray["cells"]) - 1) % len(cycle)] if ray["cells"] else None
+
+    stamps: list[dict[str, Any]] = []
+    stamped_rays = sorted(
