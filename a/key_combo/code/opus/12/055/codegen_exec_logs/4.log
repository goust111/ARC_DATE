+
+    sim = analysis["sim"]
+    if sim["seeds"] != sorted(seeds):
+        return None
+    if not analysis["dynamic_change"]:
+        return None
+    if analysis["collisions"] <= 0:
+        return None
+    if active_obstacle_target and not analysis["obstacle_hit"]:
