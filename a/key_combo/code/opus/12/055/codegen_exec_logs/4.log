+        stamps.append(
+            {
+                "seed_idx": ray["seed_idx"],
+                "seed": ray["seed"],
+                "endpoint": (er, ec),
+                "center_color": int(ray["center_color"]),
+                "clipped": clipped,
+                "bbox": (r0, c0, r1, c1),
+            }
+        )
+
+    for seed in seeds:
+        out[seed] = SEED
+    for i in range(3):
+        out[bar_r, bar_c + i] = cycle[i]
+
+    return {
+        "output": out,
+        "cycle": cycle,
+        "bar_origin": (bar_r, bar_c),
+        "bar_cells": bar_cells,
+        "seeds": seeds,
+        "obstacles": obstacles,
+        "rays": rays,
+        "stamps": stamps,
+        "collisions": collision_events,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
