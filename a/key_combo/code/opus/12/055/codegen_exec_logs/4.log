+        if not _in_bounds(shape, nr, nc) or (nr, nc) in seed_set:
+            return cells
+        cells.append((nr, nc))
+        r, c = nr, nc
+
+
+def _pick_collision_pair(h: int, w: int) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
