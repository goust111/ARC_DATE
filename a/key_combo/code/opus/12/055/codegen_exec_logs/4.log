+            sr, sc = ray["seed"]
+            dr, dc = ray["dir"]
+            nr = sr + dr * step
+            nc = sc + dc * step
+            cell = (nr, nc)
+            if not _in_bounds((h, w), nr, nc) or _on_edge((h, w), nr, nc):
