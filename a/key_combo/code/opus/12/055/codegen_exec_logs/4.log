+        "output": out,
+        "cycle": cycle,
+        "bar_origin": (bar_r, bar_c),
+        "bar_cells": bar_cells,
+        "seeds": seeds,
+        "obstacles": obstacles,
+        "rays": rays,
+        "stamps": stamps,
