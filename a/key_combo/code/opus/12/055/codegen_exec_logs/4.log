+    used_rows: set[int],
+    used_cols: set[int],
+) -> tuple[int, int] | None:
+    candidates = []
+    for r, c in (
+        *[(3, cc) for cc in range(4, w - 3)],
+        *[(h - 4, cc) for cc in range(4, w - 3)],
+        *[(rr, 3) for rr in range(4, h - 3)],
+        *[(rr, w - 4) for rr in range(4, h - 3)],
