+        cell = extra_candidates.pop()
+        obstacles.append(cell)
+        taken.add(cell)
+    if len(obstacles) != obstacle_total:
+        return None
+
+    grid = _build_grid(h, w, cycle, seeds, obstacles)
+    analysis = _analyze_grid(grid)
+    if analysis is None:
+        return None
+
+    sim = analysis["sim"]
