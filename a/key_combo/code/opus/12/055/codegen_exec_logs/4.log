+
+def _build_grid(
+    h: int,
+    w: int,
+    cycle: list[int],
+    seeds: list[tuple[int, int]],
+    obstacles: list[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    grid[0, 0:3] = np.array(cycle, dtype=int)
+    for r, c in seeds:
+        grid[r, c] = SEED
+    for r, c in obstacles:
+        grid[r, c] = OBSTACLE
