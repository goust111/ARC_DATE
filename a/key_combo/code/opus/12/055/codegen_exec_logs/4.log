+        edge_seed = _pick_edge_seed(h, w, seeds, bar_cells, used_rows, used_cols)
+        if edge_seed is None:
+            return None
+        seeds.append(edge_seed)
+        used_rows.add(edge_seed[0])
+        used_cols.add(edge_seed[1])
