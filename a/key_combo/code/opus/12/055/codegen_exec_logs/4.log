+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _on_edge(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return r == 0 or c == 0 or r == h - 1 or c == w - 1
