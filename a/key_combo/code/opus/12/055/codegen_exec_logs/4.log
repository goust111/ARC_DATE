+
+
+def _static_length(
+    shape: tuple[int, int],
+    seed: tuple[int, int],
+    direction: tuple[int, int],
+    seed_set: set[tuple[int, int]],
+    obstacles: set[tuple[int, int]],
+) -> int:
+    r, c = seed
+    dr, dc = direction
+    steps = 0
+    while True:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return steps
+        if (nr, nc) in seed_set or (nr, nc) in obstacles:
+            return steps
+        steps += 1
+        r, c = nr, nc
+
