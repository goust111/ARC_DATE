+    if analysis["collisions"] <= 0:
+        return None
+    if active_obstacle_target and not analysis["obstacle_hit"]:
+        return None
+    if need_clipped and not analysis["clipped_stamp"]:
+        return None
+    if analysis["stamp_color_count"] < 2:
+        return None
+    if len(sim["stamps"]) < 6:
