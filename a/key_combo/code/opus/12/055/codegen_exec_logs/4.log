+        "sim": sim,
+        "dynamic_change": dynamic_change,
+        "obstacle_hit": obstacle_hit,
+        "clipped_stamp": clipped_stamp,
+        "stamp_color_count": len(stamp_colors),
+        "stamp_overlap_count": overlap_count,
