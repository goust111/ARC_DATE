+                ray["stop_reason"] = "boundary"
+                continue
+            if cell in obstacles:
+                ray["active"] = False
+                ray["stop_reason"] = "obstacle"
+                continue
+            if cell in seed_set:
+                ray["active"] = False
+                ray["stop_reason"] = "seed"
+                continue
+            if cell in painted_owner:
+                ray["active"] = False
