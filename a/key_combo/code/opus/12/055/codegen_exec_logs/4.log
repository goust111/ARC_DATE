+
+
+def _candidate_obstacle_cells(
+    h: int,
+    w: int,
+    cycle: list[int],
+    seeds: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+    bar_cells: list[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    preview = _simulate(_build_grid(h, w, cycle, seeds, []), strict_counts=False)
