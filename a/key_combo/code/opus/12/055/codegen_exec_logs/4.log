+    rays: list[dict[str, Any]] = []
+    for seed_idx, seed in enumerate(seeds):
+        for dir_idx, direction in enumerate(DIRS):
+            rays.append(
+                {
+                    "seed_idx": seed_idx,
+                    "seed": seed,
+                    "dir_idx": dir_idx,
+                    "dir": direction,
+                    "cells": [],
+                    "active": True,
