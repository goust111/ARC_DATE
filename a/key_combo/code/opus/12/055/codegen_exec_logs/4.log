+    for ray in preview["rays"]:
+        for cell in ray["cells"][1:4]:
+            if cell in protected or cell in set(seeds):
+                continue
+            if _dist_to_bar(cell, bar_cells) < 4:
+                continue
+            candidates.append(cell)
+    random.shuffle(candidates)
+    dedup = []
+    seen = set()
+    for cell in candidates:
+        if cell not in seen:
+            dedup.append(cell)
+            seen.add(cell)
+    return dedup
+
+
+def _random_obstacle_cells(
+    h: int,
+    w: int,
+    seeds: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+    bar_cells: list[tuple[int, int]],
+    taken: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    seed_set = set(seeds)
+    cells = []
+    for r in range(2, h - 2):
+        for c in range(2, w - 2):
+            cell = (r, c)
+            if cell in seed_set or cell in protected or cell in taken:
+                continue
+            if _dist_to_bar(cell, bar_cells) < 4:
+                continue
+            cells.append(cell)
+    random.shuffle(cells)
+    return cells
+
+
+def _build_grid(
+    h: int,
+    w: int,
+    cycle: list[int],
+    seeds: list[tuple[int, int]],
+    obstacles: list[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    grid[0, 0:3] = np.array(cycle, dtype=int)
+    for r, c in seeds:
+        grid[r, c] = SEED
+    for r, c in obstacles:
+        grid[r, c] = OBSTACLE
