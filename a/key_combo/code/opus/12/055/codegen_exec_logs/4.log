+
+
+def _is_clip_endpoint(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
+    h, w = shape
+    r, c = cell
+    return r in (0, h - 1) or c in (0, w - 1)
+
+
+def _clip_protected_cells(
