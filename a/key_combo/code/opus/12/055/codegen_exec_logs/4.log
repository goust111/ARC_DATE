+
+
+def _candidate_obstacle_cells(
+    h: int,
+    w: int,
+    seeds: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+    bar_cells: list[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    seed_set = set(seeds)
+    candidates = []
+    for seed in seeds:
+        for direction in DIRS:
+            cells = _ray_cells_until_static_stop((h, w), seed, direction, seed_set)
