+    while True:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc) or _on_edge(shape, nr, nc):
+            return steps
+        if (nr, nc) in seed_set or (nr, nc) in obstacles:
+            return steps
+        steps += 1
+        r, c = nr, nc
+
+
+def _simulate(grid: np.ndarray) -> dict[str, Any]:
