+            sr, sc = ray["seed"]
+            dr, dc = ray["dir"]
+            nr = sr + dr * step
+            nc = sc + dc * step
+            cell = (nr, nc)
+            if not _in_bounds((h, w), nr, nc) or _on_edge((h, w), nr, nc):
+                ray["active"] = False
+                ray["stop_reason"] = "boundary"
+                continue
+            if cell in obstacles:
+                ray["active"] = False
+                ray["stop_reason"] = "obstacle"
+                continue
+            if cell in seed_set:
+                ray["active"] = False
+                ray["stop_reason"] = "seed"
+                continue
+            if cell in painted_owner:
+                ray["active"] = False
+                ray["stop_reason"] = "painted"
+                ray["stop_info"] = painted_owner[cell]
