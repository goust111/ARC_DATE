+import numpy as np
+
+
+BG = 0
+SEED = 5
+OBSTACLE = 7
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SAFE_CYCLE_COLORS = [1, 2, 3, 4, 6, 8, 9]
+GEN_ATTEMPTS = 600
