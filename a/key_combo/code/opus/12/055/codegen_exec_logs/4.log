+def _stamps_avoid_sources(
+    stamps: list[dict[str, Any]],
+    seeds: list[tuple[int, int]],
+    bar_cells: set[tuple[int, int]],
+) -> bool:
+    protected = set(seeds) | set(bar_cells)
+    for stamp in stamps:
+        r0, c0, r1, c1 = stamp["bbox"]
