+            return cells
+        cells.append((nr, nc))
+        r, c = nr, nc
+
+
+def _pick_collision_pair(h: int, w: int) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    horizontal = random.choice([False, True])
+    protected: set[tuple[int, int]] = set()
