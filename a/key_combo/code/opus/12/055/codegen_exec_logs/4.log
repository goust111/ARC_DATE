+    for r, c in (
+        *[(2, cc) for cc in range(4, w - 3)],
+        *[(h - 3, cc) for cc in range(4, w - 3)],
+        *[(rr, 2) for rr in range(4, h - 3)],
+        *[(rr, w - 3) for rr in range(4, h - 3)],
