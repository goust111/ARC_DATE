+        (ray for ray in rays if ray["cells"]),
+        key=lambda ray: (ray["seed"][0], ray["seed"][1], ray["dir_idx"]),
+    )
+    for ray in stamped_rays:
+        er, ec = ray["cells"][-1]
+        r0, r1 = er - 1, er + 1
+        c0, c1 = ec - 1, ec + 1
