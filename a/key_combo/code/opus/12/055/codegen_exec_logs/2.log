+        for coords in _mask_components(g == color):
+            components.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return components
+
+
+def _is_rectangular_perimeter(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * h + 2 * w - 4
+    if int(comp["area"]) != expected:
+        return False
+    coords = comp["coords"]
+    on_border = (
+        (coords[:, 0] == r0)
+        | (coords[:, 0] == r1)
+        | (coords[:, 1] == c0)
+        | (coords[:, 1] == c1)
