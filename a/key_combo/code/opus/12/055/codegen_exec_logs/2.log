+def _is_asymmetric(mask: np.ndarray) -> bool:
+    variants = (
+        np.fliplr(mask),
+        np.flipud(mask),
+        np.rot90(mask, 1),
+        np.rot90(mask, 2),
+        np.rot90(mask, 3),
+    )
