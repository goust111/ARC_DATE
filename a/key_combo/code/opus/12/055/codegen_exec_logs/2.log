+    for group in groups:
+        pattern = group["pattern"]
+        frames = group["frames_inner_to_outer"]
+        depth = int(group["depth"])
+        inner = frames[0]
+        outer = frames[-1]
+
+        rr, cc = pattern["coords"][:, 0], pattern["coords"][:, 1]
+        out[rr, cc] = bg
