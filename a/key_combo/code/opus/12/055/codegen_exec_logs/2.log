+
+
+SHAPES = _shape_library()
+
+
+def _choose_pattern(depth: int, group_count: int) -> np.ndarray:
+    if depth == 3 and group_count == 2 and random.random() < 0.55 and SHAPES["depth3_nonsquare"]:
+        pool = SHAPES["depth3_nonsquare"]
+    elif group_count == 3:
