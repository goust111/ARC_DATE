+    nonsquare = [mask for mask in by_depth_3 if mask.shape[0] != mask.shape[1]]
+    small_square = [mask for mask in all_shapes if mask.shape == (3, 3)]
+    return {
+        "all": all_shapes,
+        "depth2": by_depth_2,
+        "depth3": by_depth_3,
+        "depth3_nonsquare": nonsquare,
