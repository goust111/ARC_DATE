                if body_height < MIN_H:
                    c = c1 + 1
                    continue

                body_bottom = body_top + body_height - 1
                if body_bottom >= r1:
                    c = c1 + 1
                    continue

                block = g[body_top : body_bottom + 1, c : c1 + 1]
