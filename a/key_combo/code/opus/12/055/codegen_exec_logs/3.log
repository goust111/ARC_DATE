+import numpy as np
+
+
+BG = 0
+DIVIDER = 5
+STOP = 1
+PASS = 9
+BODY_COLORS = (1, 2, 3, 4, 7)
+GEN_BODY_COLORS = (2, 3, 4, 7)
+
+MIN_H = 2
+MAX_H = 3
+MIN_W = 2
