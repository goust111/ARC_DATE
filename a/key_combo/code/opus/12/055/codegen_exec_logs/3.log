+def _landing_top(rect: dict, sep_rows: list[int], height: int, mode: str = "normal") -> int:
+    body_bottom = int(rect["top"]) + int(rect["height"]) - 1
+    control = int(rect["control"])
+
+    if mode == "all_pass":
+        control = PASS
+    elif mode == "all_stop":
+        control = STOP
+
+    if control == STOP:
