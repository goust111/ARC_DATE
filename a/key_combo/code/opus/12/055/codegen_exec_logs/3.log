+
+def _rand_size(band_h: int) -> tuple[int, int]:
+    height = random.randint(MIN_H, min(MAX_H, band_h - 2))
+    width = random.randint(MIN_W, MAX_W)
+    return height, width
+
+
+def _top_for_height(band: tuple[int, int], band_h: int, rect_h: int) -> int:
