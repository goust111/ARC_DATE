+        stop_left = _slot_left(stop_slot_start, stop_slot_width, stop_w)
+
+        stop_color_choices = [color for color in GEN_BODY_COLORS if color != pass_color]
+        stop_color = random.choice(stop_color_choices)
+        rects.append(
