+        out[top - 1, int(rect["control_col"])] = int(rect["control"])
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_bands = random.choice([3, 4])
+    band_h = random.choice([5, 6])
+    height = n_bands * band_h + (n_bands - 1)
+    width = random.randint(16, 18)
+
