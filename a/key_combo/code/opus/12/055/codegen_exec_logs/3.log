+                "band": band_index,
+                "color": pass_color,
+                "control": PASS,
+                "top": top_pass,
+                "left": pass_left,
+                "height": pass_h,
+                "width": pass_w,
+                "area": pass_h * pass_w,
+                "control_col": pass_left + (overlap_ctrl_cols[band_index] if band_index in overlap_ctrl_cols else random.randint(0, pass_w - 1)),
