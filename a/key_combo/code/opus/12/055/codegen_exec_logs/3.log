+        rect_left = _slot_left(slot_start, slot_width, rect_w)
+        rect_color_choices = [color for color in GEN_BODY_COLORS if color not in used_colors] or list(GEN_BODY_COLORS)
+        rect_color = random.choice(rect_color_choices)
