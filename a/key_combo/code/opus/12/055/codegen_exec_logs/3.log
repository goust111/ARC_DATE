+        for left_b in range(start, start + CENTER_SLOT_WIDTH - width_b + 1):
+            overlap = max(
+                0,
+                min(left_a + width_a - 1, left_b + width_b - 1) - max(left_a, left_b) + 1,
+            )
+            if overlap > 0:
+                choices.append((left_a, left_b))
