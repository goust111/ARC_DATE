+            return True
+        idx = order[pos]
+        for box in candidates[idx]:
+            if any(_boxes_too_close(box, placed[other]) for other in placed):
+                continue
+            placed[idx] = box
+            if backtrack(pos + 1):
+                return True
+            del placed[idx]
+        return False
+
+    if not backtrack(0):
+        return None
+
+    result = []
+    for idx, spec in enumerate(specs):
+        box = placed[idx]
+        result.append({**spec, "bbox_local": box})
+    return result
+
