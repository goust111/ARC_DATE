+        sprite = _sprite_array(sprites[guide["sprite_index"]]["mask"], sprites[guide["sprite_index"]]["color"])
+        if guide["mode"] == "col":
+            sprite = np.rot90(sprite, -1)
+        _stamp_into_box(out, global_box, sprite, color)
