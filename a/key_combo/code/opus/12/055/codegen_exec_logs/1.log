+            return False
+
+    modes = [match["mode"] for match in scene["matches"]]
+    if not ("row" in modes and "col" in modes):
+        return False
+
+    any_half_offset = False
+    for match in scene["matches"]:
+        guide = match["guide"]
+        sprite = scene["sprites"][match["sprite_index"]]["sprite"]
+        if match["mode"] == "col":
+            sprite = np.rot90(sprite, -1)
