  "type": "transform_in_place",
  "src": "monochrome rectangular foreground perimeters, some strictly nested inside larger perimeters",
  "transform": "for each outermost rectangle, recolor every non-background pixel in its interior to the outer rectangle's color; leave background and top-level borders unchanged"
}
</annotation>
<generation_spec>
