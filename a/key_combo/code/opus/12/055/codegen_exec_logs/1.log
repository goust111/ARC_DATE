spec:
  grid: 12-29 rows x 18-28 cols, background 0
  objects:
    type: monochromatic rectangular perimeters (hollow rects), 4-connected
    total_count: 4-10
    sizes: 1x2 up to 16x21; degenerate rects (h<=2 or w<=2) allowed, these are filled solid
    arrangement: either strictly nested or fully disjoint (no partial overlap)
  nesting:
    hierarchy: forest of trees; outermost rects are roots (2-4 roots)
    max_depth: 1-3 levels below root
    at_least_one_root_has_children: true (solver asserts)
    0-1 roots have no children [observed]
    children_per_parent: 1-2
    colors_within_each_tree: all distinct (each rect in a tree has unique color)
    colors_across_trees: may repeat
    gap_child_to_parent_interior: >=0 on all sides (typically >=1, 0 means child abuts parent border)
  foreground_colors: 4-6 distinct non-bg colors total
  transform:
    rule: for each outermost rect with children, recolor every non-bg pixel strictly inside its bbox to the outermost rect's color
    unchanged: outermost borders, background, childless outermost rects

generation_strategy:
  approach: direct construction (nesting is constructive, not search-heavy)
  steps:
    1. Pick grid size in range. Pick 2-4 outermost rects with distinct colors.
    2. For each outermost rect, decide nesting depth (0-3). Depth-0 = no children.
       Ensure at least one root has depth >= 1.
    3. Build each nesting tree inside-out. Start from innermost (smallest) rect,
       assign unique color within the tree. Place each parent around child with
       >=0 gap on each side (>=1 preferred). Parent must be >= child + 2 on each
       axis to have interior.
    4. Place outermost rects on grid with >=1 cell gap to grid edge and no overlap
       between trees. One may touch grid edge (gap=0) rarely.
    5. To build output, copy input then for each outermost rect with children,
       recolor all non-bg pixels inside its bbox to the outermost color.
