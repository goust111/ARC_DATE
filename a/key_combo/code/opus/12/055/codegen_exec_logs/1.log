+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+DIVIDER_COLOR = 5
+SPRITE_COLORS = (2, 3, 1)
+GUIDE_COLORS = (4, 7, 9)
+GEN_ATTEMPTS = 400
