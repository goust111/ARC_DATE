+    if used > height:
+        return None
+    slack = height - used
+    top_margin = random.randint(0, slack)
+    bottom_margin = slack - top_margin
+
+    rows = []
+    r = top_margin
+    for i, (shape, color) in enumerate(zip(shapes, colors)):
+        rows.append((r, shape, color))
+        r += shape.shape[0]
