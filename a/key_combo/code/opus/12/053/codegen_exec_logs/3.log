+    if kind in {"even_v", "zero_v"}:
+        panel[:, MID] = guide_color
+        pool = EVEN_VARIANTS if kind == "even_v" else ZERO_VARIANTS
+        mask = _pick_variant(pool, max_w=MID)
+        top = random.randint(0, PANEL_SIZE - mask.shape[0])
