+ODD_BASE = _mask(
+    (
+        "#####.",
+        "#...##",
+        "#####.",
+    )
+)
+EVEN_BASE = _mask(
+    (
+        "#####",
+        "#.#.#",
+        "#####",
+    )
+)
+ZERO_BASES = (
+    _mask(
+        (
+            "####.",
+            "#....",
+            "#####",
+        )
+    ),
+    _mask(
+        (
+            ".####",
+            "....#",
+            "#####",
+        )
+    ),
+    _mask(
+        (
+            "###..",
+            "..#..",
+            "..###",
+        )
+    ),
