+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        guide_color = random.choice(NON_GREY_NON_BLACK)
+        grid = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
+        grid[SEPARATOR_ROWS, :] = GREY
