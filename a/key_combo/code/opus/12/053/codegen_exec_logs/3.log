  "type": "symmetry/pattern",
  "src": "9x9 panel lattice; each panel has four monochrome 3x3 quadrant slots and optionally a full center-row or center-column guide line",
  "transform": "reflect each guided panel across its guide line; for each unguided panel, recolor all four slots to the slot color that appears only once"
}
</annotation>
