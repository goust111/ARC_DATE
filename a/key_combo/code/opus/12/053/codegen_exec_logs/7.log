+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+GRID_SIZE = 12
+PANEL_SIZE = 12
+SEPARATOR_COL = 12
+INPUT_WIDTH = PANEL_SIZE * 2 + 1
+MAX_GENERATION_ATTEMPTS = 600
