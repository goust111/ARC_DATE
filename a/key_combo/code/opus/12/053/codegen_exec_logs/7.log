+    for c, (top, bottom) in zip(cols, intervals):
+        mask[top : bottom + 1, c] = True
+
+    area = int(mask.sum())
+    thicknesses = [bottom - top + 1 for top, bottom in intervals]
+    if area < 8 or area > 14:
+        return None
+    if len(set(intervals)) == 1:
+        return None
+    if max(thicknesses) < 2:
+        return None
+    if not _connected(mask):
