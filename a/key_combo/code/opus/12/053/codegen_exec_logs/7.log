+        r = int(r)
+        c = int(c)
+        if c == left_only_col:
+            left_mask[r, c] = True
+        elif c == right_only_col:
+            right_mask[r, c] = True
+        elif overlap_coord is not None and (r, c) == overlap_coord:
+            left_mask[r, c] = True
+            right_mask[r, c] = True
+        else:
+            mode = random.choices(("left", "right", "both"), weights=(4, 4, 3), k=1)[0]
