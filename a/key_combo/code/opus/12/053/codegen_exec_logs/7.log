+    left_only = _solve_from_masks(np.where(left_mask, YELLOW, BLACK), np.zeros_like(left_mask, dtype=int))
+    right_only = _solve_from_masks(np.zeros_like(right_mask, dtype=int), np.where(right_mask, YELLOW, BLACK))
+    if np.array_equal(left_only, expected) or np.array_equal(right_only, expected):
