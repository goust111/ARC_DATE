+        if expected[dest_top : dest_top + height, c].sum() == 0:
+            return False
+    if not any(not left_mask[:, c].any() for c in bar_heights):
+        return False
+    if not any(not right_mask[:, c].any() for c in bar_heights):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
