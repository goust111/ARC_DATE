+        assert int(teal_rows.max()) < top
+        dest_top = int(teal_rows.max()) + 1
+        dest_bottom = dest_top + int(height)
+        assert dest_bottom <= left.shape[0]
+        out[dest_top:dest_bottom, c] = RED
