+OUTLINE = 3
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+ROT_K_CCW = {"right": 0, "down": 3, "left": 2, "up": 1}
+AREA_POOL = (3, 4, 5, 6)
+GEN_ATTEMPTS = 500
