+                    "area": area,
+                    "color": color,
+                    "direction": direction,
+                    "stem_len": stem_len,
+                    "body_patch": body_patch,
+                    "final_patch": final_patch,
+                    "outline_patch": outline_patch,
+                    "inner_mask": inner_mask,
+                    "sprite_patch": sprite_patch,
+                    "outline_pos": outline_pos,
+                    "sprite_pos": sprite_pos,
+                }
