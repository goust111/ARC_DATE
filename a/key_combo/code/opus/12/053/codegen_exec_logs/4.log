+def _nonzero_patch(patch: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(patch != 0)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=int)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return patch[r0 : r1 + 1, c0 : c1 + 1].copy()
