+                if r0 + stem_len >= mask.shape[0] or not mask[r0 + stem_len, cc]:
+                    continue
+                stem = np.zeros_like(mask)
+                for rr in rows:
+                    stem[rr, cc] = True
+                body = mask & ~stem
+                if _valid_body(body) and _bbox_coords(np.argwhere(body))[0] == r0 + stem_len:
+                    return body, stem
