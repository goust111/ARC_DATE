+    for direction in ("right", "down", "left", "up"):
+        split = _candidate_split(mask, direction)
+        if split is None:
+            continue
+        body, stem = split
+        candidates.append((direction, body, stem, int(stem.sum())))
+    if len(candidates) != 1:
+        return None
+    direction, body, stem, _ = candidates[0]
+    return body, stem, direction
