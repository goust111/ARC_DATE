+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+MIRROR = 5
+SOURCE_COLORS = (2, 3, 4, 6, 7, 8, 9)
+LOOP_TEMPLATES = ((3, 4), (3, 5), (4, 4), (4, 5))
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        deltas = ((-1, 0), (1, 0), (0, -1), (0, 1))
+    else:
+        deltas = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
+        )
+
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in deltas:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _enclosed_regions(wall_coords: np.ndarray, box: tuple[int, int, int, int]) -> list[np.ndarray]:
+    r0, c0, r1, c1 = map(int, box)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    wall = np.zeros((h, w), dtype=bool)
+    local = wall_coords - np.array([r0, c0], dtype=int)
+    wall[local[:, 0], local[:, 1]] = True
+    passable = ~wall
+
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for rr in range(h):
+        for cc in (0, w - 1):
+            if passable[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+    for cc in range(w):
+        for rr in (0, h - 1):
+            if passable[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+
+    while q:
+        rr, cc = q.popleft()
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
