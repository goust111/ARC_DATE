+    r0, c0, r1, c1 = map(int, box)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    wall = np.zeros((h, w), dtype=bool)
+    local = wall_coords - np.array([r0, c0], dtype=int)
+    wall[local[:, 0], local[:, 1]] = True
+    passable = ~wall
+
+    outside = np.zeros((h, w), dtype=bool)
