+                seen_ids.add(comp_id)
+                targets.append((comp_id, c))
+        c += int(dc)
+    return targets
+
+
+def _trace_ray(
+    grid: np.ndarray,
+    contours: list[dict],
+    blue_map: np.ndarray,
+    source_r: int,
+    source_c: int,
