+def _extract_contours(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    comps = _components_mask(grid == BLUE, connectivity=4)
+    blue_map = np.full(grid.shape, -1, dtype=int)
+    contours: list[dict] = []
+    for idx, coords in enumerate(comps):
