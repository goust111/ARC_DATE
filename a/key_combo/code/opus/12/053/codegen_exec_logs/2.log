+    out = g.copy()
+    for ray in rays:
+        sr, sc = ray["source"]
+        out[sr, sc] = BG
+        for rr, cc in ray["path"]:
+            out[rr, cc] = ray["color"]
+
+    for target_id, ray in winners.items():
+        out[contours[target_id]["interior_mask"]] = ray["color"]
+
+    return out
