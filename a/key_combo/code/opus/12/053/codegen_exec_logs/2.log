+def _accessible_targets(
+    grid: np.ndarray,
+    contours: list[dict],
+    blue_map: np.ndarray,
+    row: int,
+    start_col: int,
+    dc: int,
+) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    targets: list[tuple[int, int]] = []
+    seen_ids: set[int] = set()
+    c = int(start_col) + int(dc)
+    while 0 <= c < w:
+        if int(grid[row, c]) == BLUE:
+            comp_id = int(blue_map[row, c])
+            nc = c + int(dc)
+            if (
+                comp_id >= 0
+                and comp_id not in seen_ids
+                and 0 <= nc < w
+                and contours[comp_id]["interior_mask"][row, nc]
+            ):
+                seen_ids.add(comp_id)
+                targets.append((comp_id, c))
+        c += int(dc)
+    return targets
+
+
+def _trace_ray(
+    grid: np.ndarray,
+    contours: list[dict],
+    blue_map: np.ndarray,
+    source_r: int,
+    source_c: int,
+) -> dict:
+    h, w = grid.shape
+    hit_r = None
+    for rr in range(source_r + 1, h):
+        if int(grid[rr, source_c]) != BG:
+            hit_r = rr
+            break
