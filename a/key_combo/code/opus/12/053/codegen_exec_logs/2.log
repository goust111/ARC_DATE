            _gen_add_segment(cells, b, c, b, inner)
            _gen_add_segment(cells, a, inner, b, inner)


def _gen_rect_perimeter_cells(h, w):
    cells = set()
    for c in range(w):
        cells.add((0, c))
        cells.add((h - 1, c))
    for r in range(h):
        cells.add((r, 0))
        cells.add((r, w - 1))
    return cells


def _gen_closed_patch(color, closed_count):
    for _ in range(CLOSED_PATCH_ATTEMPTS):
