  "transform": "preserve exterior pixels; paint shells outside-to-inside with repeating cycle grey, red, grey, black, with the 9x9 frame's final singleton remaining black"
}
</annotation>
<generation_spec>
```yaml
spec:
  type: symmetry/pattern
  grid: 6-30 rows x 6-30 cols, always square [observed]
  background: black
  frame:
    shape: 1-cell-thick hollow square, grey (color 5)
    side: 6-25, both even and odd observed
    position: anywhere in grid with 0-4 cells padding per side; padding can be asymmetric
    interior: all black in input
    exterior: all black
  output:
    exterior: unchanged (all black)
    frame_bbox: filled with concentric square shells by Chebyshev distance from border
    color_cycle: depth 0=grey, 1=red, 2=grey, 3=black, repeating with period 4
    special_case: when side=9 (max_depth=4), center cell is black instead of grey

generation_strategy:
  approach: direct construction (input is trivial, output is deterministic)
  steps:
    1. pick square grid size G in [6, 30]
    2. pick frame side S in [3, G] (at least 3, at most G)
    3. pick top-left corner (r0, c0) such that frame fits in grid; padding 0-4 per side
    4. draw 1-cell-thick grey square frame at (r0, c0) with side S on black grid
    5. output is computed deterministically via the depth-based color cycle
```
