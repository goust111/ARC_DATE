+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 5
+NOISE_COLOR = 6
+CORNERS = ("TL", "TR", "BR", "BL")
+CORNER_INDEX = {corner: idx for idx, corner in enumerate(CORNERS)}
+SPRITE_COLORS = (1, 2, 3, 4)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GEN_ATTEMPTS = 500
+
+
+FRAME_TEMPLATES = {
