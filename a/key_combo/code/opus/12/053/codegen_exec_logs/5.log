import itertools, random, numpy as np
P=7
ALL=[(r,c) for r in range(P) for c in range(P)]

def cover(pos, step=3, slopes=None):
    r,c=pos
    if slopes is None:
        slopes=((1,1),(-1,-1),(-1,1),(1,-1))
    s={pos}
    for dr,dc in slopes:
        rr,cc=r+dr*step,c+dc*step
        while 0<=rr<P and 0<=cc<P:
            s.add((rr,cc)); rr+=dr*step; cc+=dc*step
    return s

def expand(seed, step=3, slopes=None, order=(2,1,4)):
    if slopes is None:
        slopes=((1,1),(-1,-1),(-1,1),(1,-1))
    rank={c:i for i,c in enumerate(order)}
    out=np.zeros((P,P),int)
    score=np.full((P,P),-1,int)
    for (r,c),color in seed.items():
        for rr,cc in cover((r,c), step=step, slopes=slopes):
            if rank[color]>score[rr,cc]:
                score[rr,cc]=rank[color]; out[rr,cc]=color
    return out

def contrib(seed):
    cells=[[set() for _ in range(P)] for _ in range(P)]
    for pos,color in seed.items():
        for rr,cc in cover(pos):
            cells[rr][cc].add(color)
    return cells

def valid(seed):
    out=expand(seed)
    if set(np.unique(out))-{0}"'!={1,2,4}: return False
    cs=contrib(seed)
    conflicts=[frozenset(cs[r][c]) for r in range(P) for c in range(P) if len(cs[r][c])>=2]
    if len(conflicts)<2: return False
    if frozenset({1,2}) not in conflicts: return False
    if not any(4 in s and len(s)>=2 for s in conflicts): return False
    if np.array_equal(out, np.array([[seed.get((r,c),0) for c in range(P)] for r in range(P)])): return False
    if np.array_equal(out, expand(seed, slopes=((1,1),(-1,-1)))): return False
    if np.array_equal(out, expand(seed, slopes=((-1,1),(1,-1)))): return False
    if np.array_equal(out, expand(seed, step=1)): return False
    if np.array_equal(out, expand(seed, order=(2,4,1))): return False
    for pos,color in list(seed.items()):
        if color==4:
            ok=False
            for repl in (2,1,0):
                s=dict(seed)
                if repl:
                    s[pos]=repl
                else:
                    del s[pos]
                if not np.array_equal(out, expand(s)):
                    ok=True; break
            if not ok: return False
        else:
            s=dict(seed); del s[pos]
            if np.array_equal(out, expand(s)): return False
    return True

