+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_MIN = 13
+GRID_MAX = 18
+MIN_LINE_LENGTH = 4
+MAX_GENERATION_ATTEMPTS = 1500
+LAYOUT_ATTEMPTS = 250
+MARKER_ATTEMPTS = 80
