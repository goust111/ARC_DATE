+
+
+def _marker_candidates(
+    chamber: np.ndarray,
+    blocked: set[tuple[int, int]],
+    chosen: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    coords = [tuple(map(int, rc)) for rc in chamber]
+    random.shuffle(coords)
