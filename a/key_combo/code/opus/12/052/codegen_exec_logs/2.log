+
+
+def _still_connected_after_removals(
+    coords: np.ndarray, removed: set[tuple[int, int]]
+) -> bool:
+    remaining = [tuple(map(int, rc)) for rc in coords if tuple(map(int, rc)) not in removed]
+    if not remaining:
+        return False
+    remaining_set = set(remaining)
+    q = deque([remaining[0]])
+    seen = {remaining[0]}
+    while q:
