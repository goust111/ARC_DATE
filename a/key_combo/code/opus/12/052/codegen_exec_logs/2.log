+def _diag_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = a
+    r1, c1 = b
+    dr = r1 - r0
+    dc = c1 - c0
+    assert dr != 0 and abs(dr) == abs(dc), "endpoints must define a strict 45-degree segment"
+    step_r = _sign(dr)
+    step_c = _sign(dc)
+    return [(r0 + k * step_r, c0 + k * step_c) for k in range(abs(dr) + 1)]
+
