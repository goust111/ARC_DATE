+                break
+        if not ok:
+            continue
+
+        crossings = sum(1 for count in occupancy.values() if count > 1)
+        if require_crossing and crossings == 0:
+            continue
+
+        line_mask = np.zeros((h, w), dtype=bool)
+        for seg in segments:
