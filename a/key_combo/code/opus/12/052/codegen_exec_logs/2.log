+
+    chamber_colors = []
+    for chamber in chambers:
+        colors = {int(out[r, c]) for r, c in chamber}
+        if len(colors) != 1:
+            return False
+        chamber_colors.extend(colors)
+    return len(set(chamber_colors)) >= 2
+
