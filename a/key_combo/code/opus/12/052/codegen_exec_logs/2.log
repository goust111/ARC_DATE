+def _line_and_marker_roles(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    counts = Counter(map(int, grid.ravel()))
+    line_colors = sorted(color for color, count in counts.items() if color != BACKGROUND and count == 2)
