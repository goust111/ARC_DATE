+                    and all(_manhattan(cell, other) > 1 for other in chosen_set)
+                    and _still_connected_after_removals(chamber, removed_now | {cell})
+                ]
+                if not candidates:
+                    continue
+                pick = random.choice(candidates)
+                chosen.append(pick)
+                chosen_set.add(pick)
