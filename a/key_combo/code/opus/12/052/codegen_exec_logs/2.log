+    out: list[tuple[int, int]] = []
+    for r0, c0 in chamber:
+        for r, c in _neighbors4(int(r0), int(c0)):
+            if 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1] and int(grid[r, c]) != BACKGROUND:
+                pos = (int(r), int(c))
+                if pos not in seen:
+                    seen.add(pos)
+                    out.append(pos)
+    return out
