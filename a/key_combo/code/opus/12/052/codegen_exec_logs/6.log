    13	def _trace_cycle(coords: np.ndarray) -> list[tuple[int, int]]:
    14	    pts = {tuple(map(int, p)) for p in coords}
    15	    for r, c in pts:
    16	        degree = sum((nr, nc) in pts for nr, nc in neighbors4(r, c))
    17	        assert degree == 2, (r, c, degree)
    18	
