+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        attempt = _generate_attempt()
+        if attempt is not None:
+            return attempt[0]
+    raise RuntimeError("failed to generate a valid symmetric-outline input")

