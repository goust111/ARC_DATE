    20	    neighbors = sorted((nr, nc) for nr, nc in neighbors4(*start) if (nr, nc) in pts)
    21	    assert len(neighbors) == 2
    22	
    23	    path = [start]
    24	    prev = start
    25	    cur = neighbors[0]
    26	    while cur != start:
    27	        path.append(cur)
    28	        next_cells = [
    29	            (nr, nc)
    30	            for nr, nc in neighbors4(*cur)
    31	            if (nr, nc) in pts and (nr, nc) != prev
    32	        ]
    33	        assert len(next_cells) == 1, (cur, next_cells)
    34	        prev, cur = cur, next_cells[0]
    35	        assert len(path) <= len(pts)
    36	
    37	    assert len(path) == len(pts)
    38	    return path
