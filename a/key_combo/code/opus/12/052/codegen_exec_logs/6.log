+def _shape_from_row_bounds(rows: list[tuple[int, int]]) -> dict | None:
+    height = len(rows)
+    boundary_local: list[tuple[int, int]] = []
+    fill_local: set[tuple[int, int]] = set()
+    max_c = -1
+    prev_left = None
+    prev_right = None
+    asymmetric_steps = 0
+    for r, (left, right) in enumerate(rows):
+        if right - left < 1:
+            return None
+        if prev_left is not None:
