     9	def _enclosed_region_coords(wall_coords: np.ndarray, box: tuple[int, int, int, int]) -> list[np.ndarray]:
    10	    r0, c0, r1, c1 = map(int, box)
    11	    h, w = r1 - r0 + 1, c1 - c0 + 1
    12	
    13	    wall = np.zeros((h, w), dtype=bool)
    14	    local = wall_coords - np.array([r0, c0])
    15	    wall[local[:, 0], local[:, 1]] = True
    16	    passable = ~wall
    17	
    18	    outside = np.zeros((h, w), dtype=bool)
    19	    q: deque[tuple[int, int]] = deque()
    20	    for rr in range(h):
    21	        for cc in (0, w - 1):
    22	            if passable[rr, cc] and not outside[rr, cc]:
    23	                outside[rr, cc] = True
    24	                q.append((rr, cc))
    25	    for cc in range(w):
    26	        for rr in (0, h - 1):
    27	            if passable[rr, cc] and not outside[rr, cc]:
    28	                outside[rr, cc] = True
    29	                q.append((rr, cc))
    30	
    31	    while q:
    32	        rr, cc = q.popleft()
    33	        for nr, nc in neighbors4(rr, cc):
    34	            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not outside[nr, nc]:
    35	                outside[nr, nc] = True
    36	                q.append((nr, nc))
    37	
    38	    enclosed = passable & ~outside
    39	    return [coords + np.array([r0, c0]) for coords in components_mask(enclosed, connectivity=4)]
