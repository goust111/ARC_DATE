    11	def _component_crop(grid: np.ndarray, coords: np.ndarray, bg: int) -> np.ndarray:
    12	    r0, c0, r1, c1 = bbox_coords(coords)
    13	    crop = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
    14	    rr = coords[:, 0] - r0
    15	    cc = coords[:, 1] - c0
    16	    crop[rr, cc] = grid[coords[:, 0], coords[:, 1]]
    17	    return crop
