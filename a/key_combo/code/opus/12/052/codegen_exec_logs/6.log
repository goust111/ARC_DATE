    59	def _translated_cells(
    60	    variant: np.ndarray,
    61	    target_skeleton: set[tuple[int, int]],
    62	    target_anchor: set[tuple[int, int]],
    63	    bg: int,
    64	    skeleton: int,
    65	    anchor: int,
    66	) -> tuple[tuple[int, int, int], ...] | None:
    67	    variant_skeleton = set(map(tuple, np.argwhere(variant == int(skeleton)).tolist()))
    68	    variant_anchor = set(map(tuple, np.argwhere(variant == int(anchor)).tolist()))
    69	    if len(variant_skeleton) != len(target_skeleton) or len(variant_anchor) != len(target_anchor):
    70	        return None
    71	
    72	    dr = min(r for r, _c in target_skeleton) - min(r for r, _c in variant_skeleton)
    73	    dc = min(c for _r, c in target_skeleton) - min(c for _r, c in variant_skeleton)
    74	    if {(r + dr, c + dc) for r, c in variant_skeleton} != target_skeleton:
    75	        return None
    76	    if {(r + dr, c + dc) for r, c in variant_anchor} != target_anchor:
