    87	def main(grid: np.ndarray) -> np.ndarray:
    88	    """Copy the complete colored annotation from the fully marked motif onto each red-anchored copy.
    89	
    90	    Input structure
    91	    - The background surrounds several 8-connected foreground motifs.
    92	    - Every motif contains the same structural skeleton color and exactly one shared anchor-color pixel.
    93	    - Exactly one motif also contains the other marker colors; the remaining motifs contain only the skeleton and anchor.
    94	
    95	    Rule
    96	    - Use the fully marked motif as the source template.
    97	    - For each incomplete motif, find the unique rotation/reflection and translation that maps the source skeleton and anchor pixel onto the target skeleton and anchor pixel.
    98	    - Stamp all non-skeleton source marker pixels through that alignment, leaving the skeleton cells unchanged.
    99	
   100	    Key insight
   101	    - The anchor pixel fixes the orientation of an otherwise reusable skeleton, so the same local marker pattern can be transferred by a dihedral transform.
   102	    """
   103	    g = np.asarray(grid, dtype=int)
   104	    bg = get_bg(g)
   105	    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False)
   106	    assert len(comps) >= 2, "expected a reference motif and at least one target motif"
   107	
   108	    skeleton, anchor, extra_colors = _infer_role_colors(g, comps, bg)
   109	    ref_indices = [
   110	        i
   111	        for i, comp in enumerate(comps)
   112	        if any(int(g[int(r), int(c)]) in extra_colors for r, c in comp["coords"])
   113	    ]
   114	    assert len(ref_indices) == 1, "expected exactly one fully marked reference motif"
   115	    ref_index = ref_indices[0]
   116	    reference = _component_patch(g, comps[ref_index], bg)
   117	    variants = _dihedral_variants(reference)
   118	
   119	    out = g.copy()
   120	    for i, comp in enumerate(comps):
   121	        if i == ref_index:
   122	            continue
   123	        assert _color_set(g, comp["coords"]) <= {skeleton, anchor}, "target motif already has non-anchor markers"
   124	        target_skeleton = {
   125	            (int(r), int(c))
   126	            for r, c in comp["coords"]
   127	            if int(g[int(r), int(c)]) == int(skeleton)
   128	        }
   129	        target_anchor = {
   130	            (int(r), int(c))
   131	            for r, c in comp["coords"]
   132	            if int(g[int(r), int(c)]) == int(anchor)
   133	        }
   134	        assert len(target_anchor) == 1, "target motif must have one anchor pixel"
   135	
   136	        candidates = [
   137	            cells
   138	            for variant in variants
   139	            if (cells := _translated_cells(variant, target_skeleton, target_anchor, bg, skeleton, anchor)) is not None
   140	        ]
   141	        unique_candidates = sorted(set(candidates))
   142	        assert len(unique_candidates) == 1, "target motif must have a unique source alignment"
   143	
   144	        for r, c, color in unique_candidates[0]:
   145	            assert 0 <= r < out.shape[0] and 0 <= c < out.shape[1], "stamped marker leaves the grid"
   146	            assert int(out[r, c]) in (int(bg), int(color)), "stamped marker conflicts with existing content"
   147	            out[r, c] = int(color)
   148	
   149	    return out
