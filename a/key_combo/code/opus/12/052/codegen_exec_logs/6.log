+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
