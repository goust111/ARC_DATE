+BACKGROUND = 0
+MASK = 6
+PALETTE = (1, 2, 3, 4, 5, 7, 8, 9)
+GEN_ATTEMPTS = 500
+
+_MODE_BAG: list[str] = []
+_PAIR_BAG: list[int] = []
