    34	def _infer_role_colors(g: np.ndarray, comps: list[dict], bg: int) -> tuple[int, int, set[int]]:
    35	    counts = [
    36	        Counter(int(g[int(r), int(c)]) for r, c in comp["coords"])
    37	        for comp in comps
    38	    ]
    39	    fg_colors = {int(v) for v in np.unique(g) if int(v) != int(bg)}
    40	    common = [color for color in fg_colors if all(cnt.get(color, 0) > 0 for cnt in counts)]
    41	    assert len(common) >= 2, "motifs must share a skeleton color and an anchor color"
    42	
    43	    totals = {color: sum(cnt.get(color, 0) for cnt in counts) for color in common}
    44	    max_total = max(totals.values())
    45	    skeleton_candidates = [color for color, total in totals.items() if total == max_total]
    46	    assert len(skeleton_candidates) == 1, "skeleton color must be uniquely most frequent among shared colors"
    47	    skeleton = skeleton_candidates[0]
    48	
    49	    anchor_candidates = [
    50	        color
    51	        for color in common
    52	        if color != skeleton and all(cnt.get(color, 0) == 1 for cnt in counts)
    53	    ]
    54	    assert len(anchor_candidates) == 1, "anchor color must appear once in every motif"
    55	    anchor = anchor_candidates[0]
    56	    return skeleton, anchor, fg_colors - {skeleton, anchor}
