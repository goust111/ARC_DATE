     9	def _component_patch(g: np.ndarray, comp: dict, bg: int) -> np.ndarray:
    10	    r0, c0, r1, c1 = comp["bbox"]
    11	    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
    12	    for r, c in comp["coords"]:
    13	        patch[int(r) - r0, int(c) - c0] = int(g[int(r), int(c)])
    14	    return patch
