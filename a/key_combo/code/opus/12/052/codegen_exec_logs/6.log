+
+
+def _generate_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    mode = _choose_mode()
+    pair_count = _choose_pair_count(mode)
+    width = random.choice((11, 13, 15, 17))
+    height = random.randint(11, 16)
+    axis = width // 2
+
+    shapes: list[dict] = []
+    for _ in range(pair_count):
