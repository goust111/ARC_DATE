    17	def _dihedral_variants(patch: np.ndarray) -> list[np.ndarray]:
    18	    variants: list[np.ndarray] = []
    19	    seen: set[tuple[tuple[int, int], bytes]] = set()
    20	    for k in range(4):
    21	        rotated = np.rot90(patch, k)
    22	        for variant in (rotated, np.fliplr(rotated)):
    23	            key = (variant.shape, variant.tobytes())
    24	            if key not in seen:
    25	                seen.add(key)
    26	                variants.append(variant.copy())
    27	    return variants
