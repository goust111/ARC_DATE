   181	def _gen_cycle_metrics(mask):
   182	    path = _gen_trace_cycle(mask)
   183	    if path is None:
   184	        return None
   185	    counts = {1: 0, -1: 0}
   186	    n = len(path)
   187	    for i, (r, c) in enumerate(path):
   188	        pr, pc = path[i - 1]
   189	        nr, nc = path[(i + 1) % n]
   190	        incoming = (r - pr, c - pc)
   191	        outgoing = (nr - r, nc - c)
   192	        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
   193	        if cross:
   194	            counts[1 if cross > 0 else -1] += 1
   195	    convex = max(counts.values())
   196	    concave = min(counts.values())
   197	    return len(path), convex, concave
