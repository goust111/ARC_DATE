+        steps = [0] * (height - 1)
+        available = [i for i in range(height - 1) for _ in range(2)]
+        random.shuffle(available)
+        for idx in available[:delta]:
+            steps[idx] += 1
+        if sum(step > 0 for step in steps) < max(1, height - 2):
+            continue
+
+        left = 0
+        right = top_width - 1
+        rows = [(left, right)]
+        for step in steps:
+            if step == 2:
+                dl, dr = 1, 1
+            elif step == 1:
+                dl, dr = random.choice(((1, 0), (0, 1)))
+            else:
