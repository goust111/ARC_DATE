+        key = (int(sprite["anchor"]), int(sh), int(sw), int(sprite["color"]))
+        lookup0.setdefault(key, []).append(idx)
+    for idx, sprite in side1:
+        sh, sw = sprite["size"]
+        key = (int(sprite["anchor"]), int(sh), int(sw), int(sprite["color"]))
+        lookup1.setdefault(key, []).append(idx)
