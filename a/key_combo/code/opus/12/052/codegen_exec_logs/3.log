+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BARRIER = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+BOX_SHAPES = ((2, 2), (2, 3), (3, 2), (3, 3))
+GENERATION_RETRIES = 400
