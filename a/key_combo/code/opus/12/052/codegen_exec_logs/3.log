+    spans_width = c0 == 0 and c1 == w - 1
+    spans_height = r0 == 0 and r1 == h - 1
+    assert spans_width ^ spans_height, "barrier must span exactly one full axis"
+    return barrier, ("horizontal" if spans_width else "vertical")
+
