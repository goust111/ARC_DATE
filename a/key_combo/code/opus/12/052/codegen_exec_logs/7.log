+                for dr, dc in NEIGHBORS4:
+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
