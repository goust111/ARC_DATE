+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+OBJECT_COLORS = (1, 2, 7, 9)
+LABEL_COLORS = (3, 4, 6, 8)
+DIR_BY_LABEL = {
+    3: "left",
+    4: "down",
+    6: "up",
+    8: "right",
+}
