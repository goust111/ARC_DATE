+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+OBJECT_COLORS = (1, 2, 7, 9)
+LABEL_COLORS = (3, 4, 6, 8)
+DIR_BY_LABEL = {
+    3: "left",
+    4: "down",
+    6: "up",
+    8: "right",
+}
+
+GEN_ATTEMPTS = 400
+GEN_SIZE_RANGE = (11, 15)
+GEN_SCENARIOS = (
+    "horizontal_collision",
+    "vertical_collision",
+    "mixed",
+    "all_directions",
+    "single_active",
+)
+GEN_SCENARIO_WEIGHTS = (3, 3, 3, 2, 2)
