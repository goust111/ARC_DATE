+def _touches_edge(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return bool(
+        np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 1] == 0)
+            | (coords[:, 0] == h - 1)
+            | (coords[:, 1] == w - 1)
