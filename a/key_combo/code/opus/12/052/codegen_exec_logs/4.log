+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _touches_edge(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return bool(
+        np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 1] == 0)
+            | (coords[:, 0] == h - 1)
+            | (coords[:, 1] == w - 1)
+        )
+    )
+
+
+def _has_enclosed_background(grid: np.ndarray) -> bool:
+    for coords in _components(grid == BG):
+        if not _touches_edge(coords, grid.shape):
+            return True
+    return False
+
+
+def _quadrants(grid: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
