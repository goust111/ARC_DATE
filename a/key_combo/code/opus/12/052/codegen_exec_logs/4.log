spec:
  grid: 2N x 2M where N=4, M=4 [observed]; solver requires even dims
  background: 0
  quadrants: 4 equal NxM regions (TL, TR, BL, BR), each with exactly 1 distinct fg color
  colors: TL=4, TR=5, BL=6, BR=9 [observed]; solver only requires 4 distinct non-bg colors
  fg_density: 25-75% per quadrant (4-12 of 16 pixels when N=M=4)
  connectivity: 1-4 connected components per mask; no constraint on shape
  union_coverage: 81-100% of output cells covered by at least 1 mask; 0-3 bg cells in output
  stacking_order: TL(back) -> BR -> BL -> TR(front); later layers overwrite earlier
  output: NxM canvas; stamp masks back-to-front, each mask painted in its quadrant color

generation_strategy:
