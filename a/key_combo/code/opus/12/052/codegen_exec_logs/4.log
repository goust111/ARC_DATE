+import numpy as np
+
+
+BG = 0
+WALL = 5
+MARKER_COLORS = (1, 2, 3, 4, 7)
+QUADRANT_ORDER = ("TL", "TR", "BL", "BR")
+CONFLICT_PAIRS = ((0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3))
+MAX_GENERATION_ATTEMPTS = 400
