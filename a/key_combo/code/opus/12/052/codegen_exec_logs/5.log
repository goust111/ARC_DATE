  transform:
    rule: for each active marker, paint its 8-neighborhood blue; active marker centers stay red
    overlap: if two active markers are 8-adjacent, each center stays red (not overwritten to blue)
    distractors: unchanged unless in an active marker's 8-neighborhood (then overwritten to blue)

generation_strategy:
