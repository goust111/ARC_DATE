 113: def generate_input():
 114:     # Create a little object and then rescale it to make a big version.
 115:     # Cover up some parts of the big version with black pixels, and put yellow markers in the corners.
 116:     # Finally figure out how to put everything on a big canvas
 117: 
 118:     little_sprite = random_sprite([2,3,4], [2,3,4], connectivity=4, color_palette=[color for color in Color.NOT_BLACK if color != Color.YELLOW], background=Color.BLACK)
 119:     scaling_factor = np.random.randint(2, 4+1)
 120:     big_sprite = scale_sprite(little_sprite, scaling_factor)
 121: 
 122:     # Cover up some parts of the big sprite with black pixels
 123:     for _ in range(np.random.randint(1, 3)):
 124:         x0, y0 = np.random.randint(0, big_sprite.shape[0]), np.random.randint(0, big_sprite.shape[1])
 125:         x1, y1 = np.random.randint(x0, big_sprite.shape[0]), np.random.randint(y0, big_sprite.shape[1])
 126:         big_sprite[x0:x1+1, y0:y1+1] = Color.BLACK
 127: 
 128:     # Create a fixed big canvas so we can safely place corner markers and keep the little object
 129:     # entirely outside the marked big region.
 130:     width = height = 30
 131:     grid = np.full((width, height), Color.BLACK, dtype=int)
 132:     
 133:     # Put the big sprite in the canvas
 134:     _loc = first_free_location(grid, big_sprite, transparent=Color.BLACK, border=6, padding=0, padding_connectivity=8)
 135:     if _loc is None:
 136:         raise ValueError("no placement")
 137:     r, c = _loc
 138:     paste(grid, big_sprite, r, c, transparent=Color.BLACK, clip=True)
 139: 
 140:     # Put yellow markers in the corners
 141:     grid[r-1, c-1] = Color.YELLOW
 142:     grid[r-1, c+big_sprite.shape[1]] = Color.YELLOW
 143:     grid[r+big_sprite.shape[0], c-1] = Color.YELLOW
 144:     grid[r+big_sprite.shape[0], c+big_sprite.shape[1]] = Color.YELLOW
 145:     
 146:     # Place the little sprite outside the marked region (top-left corner).
 147:     paste(grid, little_sprite, 0, 0, transparent=Color.BLACK, clip=True)
 148: 
 149:     return grid

