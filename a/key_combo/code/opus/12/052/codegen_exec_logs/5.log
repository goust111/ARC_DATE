 116: def _gen_path_is_valid(path, width):
 117:     cells = set(path)
 118:     degrees = [_gen_degree(cells, r, c, width) for r, c in cells]
 119:     if any(deg < 1 or deg > 2 for deg in degrees):
 120:         return False
 121:     if degrees.count(1) != 2:
 122:         return False
 123: 
 124:     left_endpoints, right_endpoints = [], []
 125:     for r, c in cells:
 126:         deg = _gen_degree(cells, r, c, width)
 127:         if deg == 1 and c == 0:
 128:             left_endpoints.append(r)
 129:         if deg == 1 and c == width - 1:
 130:             right_endpoints.append(r)
 131:     return len(left_endpoints) == 1 and len(right_endpoints) == 1
