+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_objects = random.choice((3, 3, 4))
+    colors = random.sample(DIAMOND_COLORS, n_objects)
+    counts = _sample_branch_counts(n_objects)
+    base_specs = []
