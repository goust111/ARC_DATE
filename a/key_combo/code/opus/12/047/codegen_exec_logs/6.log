+    sr, sc = sym_cell
+    r0, r1 = row_bands[sr]
+    c0, c1 = col_bands[sc]
+    out[r0 : r1 + 1, c0 : c1 + 1] = np.where(sym_pattern, GREY, BLACK)
+    return out
