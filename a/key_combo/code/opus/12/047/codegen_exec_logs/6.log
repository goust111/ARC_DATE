+
+def _build_parallel_markers(n_cells: int, blocked: set[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    orientation = random.choice(("rows", "cols"))
+    for _ in range(120):
+        if orientation == "rows":
+            if n_cells < 4:
+                return None
+            r1, r2 = random.sample(range(n_cells), 2)
+            cols = random.sample(range(n_cells), 4)
+            c1, c2, c3, c4 = cols
