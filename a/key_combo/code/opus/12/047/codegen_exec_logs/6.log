+
+def _preferred_positions(index: int, n_cells: int) -> list[int]:
+    far = [pos for pos in range(n_cells) if pos != index and abs(pos - index) >= 2]
+    if far:
+        return far
+    return [pos for pos in range(n_cells) if pos != index]
