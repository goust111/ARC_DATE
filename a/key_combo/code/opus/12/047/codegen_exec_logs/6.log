+                return None
+            r1, r2, r3 = random.sample(range(n_cells), 3)
+            c1, c2, c3 = random.sample(range(n_cells), 3)
+            markers = [(r1, c1), (r1, c2), (r2, c1), (r2, c3), (r3, c1)]
+        else:
+            if n_cells < 3:
+                return None
+            r1, r2, r3 = random.sample(range(n_cells), 3)
+            c1, c2, c3 = random.sample(range(n_cells), 3)
+            markers = [(r1, c1), (r2, c1), (r1, c2), (r3, c2), (r1, c3)]
