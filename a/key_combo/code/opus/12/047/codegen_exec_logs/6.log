+
+    sr, sc = sym_cell
+    r0, r1 = row_bands[sr]
+    c0, c1 = col_bands[sc]
+    grid[r0 : r1 + 1, c0 : c1 + 1] = np.where(sym_pattern, GREY, BLACK)
+
+    for color, markers in model["markers_by_color"].items():
+        for rr, cc in markers:
+            r0, r1 = row_bands[rr]
+            c0, c1 = col_bands[cc]
