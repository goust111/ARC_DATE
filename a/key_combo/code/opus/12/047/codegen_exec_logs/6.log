+    assert total_row_groups >= 1 and total_col_groups >= 1
+    return _render_output_from_sets(
+        parsed["grid"].shape,
+        row_bands,
+        col_bands,
+        parsed["sym_cell"],
+        parsed["sym_pattern"],
+        filled_by_color[RED],
+        filled_by_color[GREEN],
