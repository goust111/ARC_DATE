+        c = random.randrange(n_cells)
+        pivot = (r, c)
+        if pivot in blocked:
+            continue
+        h_choices = [cc for cc in _preferred_positions(c, n_cells) if (r, cc) not in blocked]
+        v_choices = [rr for rr in _preferred_positions(r, n_cells) if (rr, c) not in blocked]
