+) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for rr, cc in (
+            (r, c),
+            (2 * axis_r - r, c),
+            (r, 2 * axis_c - c),
+            (2 * axis_r - r, 2 * axis_c - c),
