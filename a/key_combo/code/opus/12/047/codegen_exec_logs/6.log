+    row_sizes = {r1 - r0 + 1 for r0, r1 in row_bands}
+    col_sizes = {c1 - c0 + 1 for c0, c1 in col_bands}
+    assert len(row_sizes) == 1 and len(col_sizes) == 1
+    assert next(iter(row_sizes)) == next(iter(col_sizes))
