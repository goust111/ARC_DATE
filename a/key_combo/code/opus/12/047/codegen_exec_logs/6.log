+    for base_cells, row_groups, col_groups in (
+        (red_base, red_rows, red_cols),
+        (green_base, green_rows, green_cols),
+    ):
+        total_row_groups += row_groups
+        total_col_groups += col_groups
+        all_base |= base_cells
+        for r, c in base_cells:
