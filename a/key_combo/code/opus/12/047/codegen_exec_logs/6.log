+    return [pos for pos in range(n_cells) if pos != index]
+
+
+def _symmetry_cell_choices(n_cells: int) -> list[tuple[int, int]]:
+    raw = {
+        (0, 0),
+        (0, 1),
+        (1, 0),
+        (0, n_cells - 1),
+        (0, n_cells - 2),
+        (1, n_cells - 1),
+        (n_cells - 1, 0),
+        (n_cells - 2, 0),
+        (n_cells - 1, 1),
+        (n_cells - 1, n_cells - 1),
+        (n_cells - 1, n_cells - 2),
+        (n_cells - 2, n_cells - 1),
+    }
