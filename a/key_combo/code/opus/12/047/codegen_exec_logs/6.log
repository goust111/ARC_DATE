+                color = RED if has_red else GREEN
+                assert np.count_nonzero(cell == color) == 1
+                assert np.count_nonzero((cell != BLACK) & (cell != color)) == 0
+                markers_by_color[color].append((rr, cc))
+            else:
+                assert np.count_nonzero(cell != BLACK) == 0
