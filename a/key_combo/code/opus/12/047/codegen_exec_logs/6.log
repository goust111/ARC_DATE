+
+def _orbit_cells(
+    cells: set[tuple[int, int]],
+    axis_r: int,
+    axis_c: int,
+    n_rows: int,
+    n_cols: int,
+) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for rr, cc in (
+            (r, c),
+            (2 * axis_r - r, c),
+            (r, 2 * axis_c - c),
+            (2 * axis_r - r, 2 * axis_c - c),
