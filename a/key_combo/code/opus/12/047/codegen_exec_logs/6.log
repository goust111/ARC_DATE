+        if not filled or used != set(markers) or row_groups + col_groups != 3:
+            continue
+        return markers
+    return None
+
+
+def _sample_markers(n_cells: int, blocked: set[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    builders = [
+        _build_l_markers,
+        _build_parallel_markers,
+        _build_fork_markers,
