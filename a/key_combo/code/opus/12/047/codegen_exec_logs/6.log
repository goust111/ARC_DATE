+    green_cells: set[tuple[int, int]],
+    wall_rows: list[int],
+    wall_cols: list[int],
+) -> np.ndarray:
+    out = np.full(shape, BLACK, dtype=int)
+    out[wall_rows, :] = TEAL
+    out[:, wall_cols] = TEAL
