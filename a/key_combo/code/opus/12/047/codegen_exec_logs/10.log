+    row_step = 1 if end[0] > start[0] else -1
+    col_step = 1 if end[1] > start[1] else -1
+    moves = [(row_step, 0)] * abs(end[0] - start[0]) + [(0, col_step)] * abs(end[1] - start[1])
+    random.shuffle(moves)
+
+    mask = np.zeros((h, w), dtype=bool)
+    r, c = start
+    mask[r, c] = True
+    for dr, dc in moves:
+        r += dr
+        c += dc
+        mask[r, c] = True
+    return mask
