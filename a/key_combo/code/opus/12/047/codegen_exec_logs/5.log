+
+def _segment_cells(center: tuple[int, int], length: int, vertical: bool) -> list[tuple[int, int]]:
+    r, c = center
+    half = length // 2
+    if vertical:
+        return [(r + dr, c) for dr in range(-half, half + 1)]
+    return [(r, c + dc) for dc in range(-half, half + 1)]
+
