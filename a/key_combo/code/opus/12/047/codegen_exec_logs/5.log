+def _touch4(coords: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        out.add((r, c))
+        out.add((r - 1, c))
+        out.add((r + 1, c))
+        out.add((r, c - 1))
+        out.add((r, c + 1))
