+    cells = set(meta["line"])
+    cells.update(meta["rect_cap"])
+    cells.update(meta["marker_cap"])
+    h, w = shape
+    for r, c in cells:
+        assert 0 <= r < h and 0 <= c < w
+    return sorted(cells)
