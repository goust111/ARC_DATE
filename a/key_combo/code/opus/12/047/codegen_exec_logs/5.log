+    for _ in range(extra_count):
+        bar = _place_extra_bar(
+            (height, width),
+            forbidden_rotated,
+            occupied_static,
+            used_input,
+            used_rotated,
+        )
+        if bar is None:
+            return None
+        original, rotated = bar
+        bars_input.append(original)
+        used_input.update(original)
