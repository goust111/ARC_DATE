+
+def _ray_meta(
+    bbox: tuple[int, int, int, int], marker: tuple[int, int]
+) -> dict[str, object]:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
+    horizontal = r0 <= mr <= r1 and (mc < c0 or mc > c1)
+    vertical = c0 <= mc <= c1 and (mr < r0 or mr > r1)
