+            "rect_cap": [(mr - 1, side_c), (mr, side_c), (mr + 1, side_c)],
+            "marker_cap": [(mr - 1, mc), (mr + 1, mc)],
+            "target": (mr, mc),
+            "beyond": (mr, mc + dc),
