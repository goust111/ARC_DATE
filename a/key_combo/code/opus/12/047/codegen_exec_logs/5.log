+def _transform(grid: np.ndarray, rotate_bars: bool = True) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    groups, marker_positions = _find_structures(g, bg)
+    scene = _scene_after_bars(g, bg, rotate_bars=rotate_bars)
