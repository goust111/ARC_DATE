+        assert cols == list(range(cols[0], cols[-1] + 1))
+        length = len(cols)
+        assert length % 2 == 1
+        return "H", row, cols[length // 2], length
+    assert len(cols) == 1
+    col = cols[0]
+    assert rows == list(range(rows[0], rows[-1] + 1))
+    length = len(rows)
+    assert length % 2 == 1
+    return "V", rows[length // 2], col, length
