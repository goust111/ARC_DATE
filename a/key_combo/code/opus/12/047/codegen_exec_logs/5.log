+def _render_input(
+    shape: tuple[int, int],
+    rects: list[dict[str, object]],
+    bars: list[list[tuple[int, int]]],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for rect in rects:
+        color = int(rect["color"])
+        r0, c0, r1, c1 = rect["bbox"]
