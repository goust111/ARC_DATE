+
+
+def _path_signature(path: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    return tuple(sorted(path))
+
+
+def _validate_semantics(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
