+        detour.add((row + sign * step, b))
+    for c in range(a, b + 1):
+        detour.add((row + sign * 3, c))
+    obstacle = {(row + sign * 2, mid)}
+    return detour, obstacle
+
+
+def _gray_module(row: int, a: int, b: int, side: str, mid: int, length: int):
+    sign = -1 if side == "above" else 1
+    half = length // 2
+    detour = set()
+    upper_row = row + sign * 2
+    lower_row = row + sign
+
+    detour.add((lower_row, a))
+    detour.add((upper_row, a))
+    for c in range(min(a, mid), max(a, mid) + 1):
+        detour.add((upper_row, c))
+    detour.add((lower_row, mid))
+    for c in range(min(mid, b), max(mid, b) + 1):
+        detour.add((lower_row, c))
+    detour.add((lower_row, b))
+
+    bar_row = row + sign * (half + 2)
