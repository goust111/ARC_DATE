+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+LAYOUTS = [
+    (25, [5, 11, 17]),
+    (27, [6, 12, 18]),
+    (29, [5, 11, 17, 23]),
+    (29, [8, 14, 20]),
+]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        comp = set()
+        q = deque([(r, c)])
+        seen[r, c] = True
+        while q:
+            cr, cc = q.popleft()
+            comp.add((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bar_bbox(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _rotated_bar_pixels(coords: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = _bar_bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    area = len(coords)
+    assert height == 1 or width == 1
+    length = max(height, width)
+    assert area == length and length % 2 == 1
+
+    cr = (r0 + r1) // 2
+    cc = (c0 + c1) // 2
+    half = length // 2
+    if height == 1:
+        return {(cr + d, cc) for d in range(-half, half + 1)}
+    return {(cr, cc + d) for d in range(-half, half + 1)}
+
+
+def _extract_bars(grid: np.ndarray) -> list[set[tuple[int, int]]]:
+    bars = _component_sets(grid == GREY)
+    for bar in bars:
+        r0, c0, r1, c1 = _bar_bbox(bar)
+        assert r0 == r1 or c0 == c1
+        assert len(bar) % 2 == 1
+        if r0 == r1:
+            assert bar == {(r0, c) for c in range(c0, c1 + 1)}
+        else:
+            assert bar == {(r, c0) for r in range(r0, r1 + 1)}
+    return bars
+
+
+def _distances(passable: np.ndarray, start: tuple[int, int]) -> dict[tuple[int, int], int]:
+    q = deque([start])
+    dist = {start: 0}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in dist:
+                dist[nxt] = dist[(r, c)] + 1
+                q.append(nxt)
+    return dist
+
+
+def _count_simple_paths(
+    passable: np.ndarray,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    limit: int = 2,
+) -> int:
+    count = 0
+    stack = [(start, {start})]
+    while stack:
+        node, seen = stack.pop()
+        if node == end:
+            count += 1
+            if count >= limit:
+                return count
+            continue
+        r, c = node
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in seen:
+                stack.append((nxt, seen | {nxt}))
+    return count
+
+
+def _shortest_path_nodes(
+    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]]:
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        node = q.popleft()
+        if node == end:
+            break
+        r, c = node
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in parent:
+                parent[nxt] = node
+                q.append(nxt)
+    assert end in parent
+    path = []
+    cur: tuple[int, int] | None = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
