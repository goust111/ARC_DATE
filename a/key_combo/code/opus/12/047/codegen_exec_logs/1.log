+    comps: list[set[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        comp = set()
+        q = deque([(r, c)])
+        seen[r, c] = True
+        while q:
+            cr, cc = q.popleft()
+            comp.add((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
