+def _distances(passable: np.ndarray, start: tuple[int, int]) -> dict[tuple[int, int], int]:
+    q = deque([start])
+    dist = {start: 0}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in dist:
+                dist[nxt] = dist[(r, c)] + 1
+                q.append(nxt)
+    return dist
