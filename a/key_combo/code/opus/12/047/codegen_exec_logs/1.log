+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+LAYOUTS = [
