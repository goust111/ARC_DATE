+def _shortest_path_nodes(
+    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]]:
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        node = q.popleft()
+        if node == end:
+            break
+        r, c = node
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in parent:
+                parent[nxt] = node
+                q.append(nxt)
