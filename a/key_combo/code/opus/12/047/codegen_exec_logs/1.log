+        grid[r, c] = TEAL
+    grid[start] = MAROON
+    grid[end] = MAROON
+
+    for r, c in occupied_obstacles:
+        grid[r, c] = GREY
+    orange_positions = []
+    for r, c in list(occupied_obstacles):
+        # Placeholder, refined below.
+        orange_positions.append((r, c))
+
+    # Recover which obstacle cells are orange by looking for singleton cells after
+    # temporarily painting all obstacle pixels with a sentinel.
+    # In this generator, only orange modules contribute singleton obstacles.
+    comps = _component_sets(grid == GREY)
+    # The initial paint made every obstacle grey; reclassify singleton obstacles as orange,
+    # keeping multi-pixel bars grey.
+    for comp in comps:
+        if len(comp) == 1:
+            r, c = next(iter(comp))
+            grid[r, c] = ORANGE
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        base = _attempt_base_grid()
+        if base is None:
+            continue
+        grid = _apply_random_transform(base)
+        if _validate_semantics(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

