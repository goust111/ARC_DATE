+    stack = [(start, {start})]
+    while stack:
+        node, seen = stack.pop()
+        if node == end:
+            count += 1
+            if count >= limit:
+                return count
+            continue
+        r, c = node
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in seen:
