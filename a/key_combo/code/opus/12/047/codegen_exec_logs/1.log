+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in parent:
+                parent[nxt] = node
+                q.append(nxt)
+    assert end in parent
+    path = []
+    cur: tuple[int, int] | None = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
