+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        comp = set()
+        q = deque([(r, c)])
+        seen[r, c] = True
+        while q:
+            cr, cc = q.popleft()
+            comp.add((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bar_bbox(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _rotated_bar_pixels(coords: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = _bar_bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    area = len(coords)
+    assert height == 1 or width == 1
+    length = max(height, width)
+    assert area == length and length % 2 == 1
+
