+    for c in range(0, c_left + 1):
+        track.add((lane_rows[0], c))
+
+    if (len(lane_rows) - 1) % 2 == 0:
+        end = (lane_rows[-1], width - 1)
+        for c in range(c_right, width):
+            track.add((lane_rows[-1], c))
+    else:
+        end = (lane_rows[-1], 0)
+        for c in range(0, c_left + 1):
+            track.add((lane_rows[-1], c))
