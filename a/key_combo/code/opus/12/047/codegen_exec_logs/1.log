+        return False
+
+    oranges = [tuple(map(int, rc)) for rc in np.argwhere(g == ORANGE)]
+    if not (2 <= len(oranges) <= 3):
+        return False
+
+    track = _track_mask(g)
+    if _count_simple_paths(track, endpoints[0], endpoints[1], limit=2) < 2:
+        return False
+
+    try:
