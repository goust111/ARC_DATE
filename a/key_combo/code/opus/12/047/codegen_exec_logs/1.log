+def _forbidden_layers(
+    grid: np.ndarray,
+) -> tuple[np.ndarray, list[np.ndarray], list[np.ndarray], list[set[tuple[int, int]]], list[tuple[int, int]]]:
+    bars = _extract_bars(grid)
+    oranges = [tuple(map(int, rc)) for rc in np.argwhere(grid == ORANGE)]
