+BLACK = 0
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+LAYOUTS = [
+    (25, [5, 11, 17]),
+    (27, [6, 12, 18]),
