+    detour.add((upper_row, a))
+    for c in range(min(a, mid), max(a, mid) + 1):
+        detour.add((upper_row, c))
+    detour.add((lower_row, mid))
+    for c in range(min(mid, b), max(mid, b) + 1):
+        detour.add((lower_row, c))
+    detour.add((lower_row, b))
