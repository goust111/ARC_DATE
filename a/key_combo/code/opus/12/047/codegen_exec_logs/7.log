+            row0 = max(left["r0"], right["r0"])
+            row1 = min(left["r1"], right["r1"])
+            if row0 > row1:
+                continue
+            gap0 = left["c1"] + 1
+            gap1 = right["c0"] - 1
+            if gap0 > gap1:
