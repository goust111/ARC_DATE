+            blocked = False
+            for k, blocker in enumerate(rects):
+                if k in (i, j):
+                    continue
+                if _overlap(gap0, gap1, blocker["c0"], blocker["c1"]) and _overlap(
+                    row0, row1, blocker["r0"], blocker["r1"]
