+
+
+BG = 0
+SEP = 5
+PALETTE = (1, 2, 3, 4)
+TARGET_COUNTS = (4, 6, 8)
+RECT_HEIGHT = 2
+AREA_TO_WIDTH = {4: 2, 6: 3, 8: 4}
