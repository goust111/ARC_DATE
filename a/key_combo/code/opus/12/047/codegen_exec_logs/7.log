+        assert {color: counts.get(color, 0) for color in all_colors} == target
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_TRIES):
+        grid = _build_input()
+        try:
+            _validate_instance(grid)
+            return grid
+        except Exception:
+            continue
+    raise RuntimeError("failed to generate a valid instance")

