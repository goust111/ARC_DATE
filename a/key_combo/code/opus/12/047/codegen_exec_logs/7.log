+    grid = np.zeros((2 * qh + 1, 2 * qw + 1), dtype=int)
+    cross_r, cross_c = qh, qw
+    grid[cross_r, :] = SEP
+    grid[:, cross_c] = SEP
+    slices = _region_slices(cross_r, cross_c, *grid.shape)
+    for region, (rs, cs) in zip(regions, slices):
+        grid[rs, cs] = region
+    return grid
