+        rr, cc = corner
+        dr, dc = direction
+        rr += dr
+        cc += dc
+        while _in_bounds(g.shape, rr, cc):
+            if int(g[rr, cc]) != BG:
+                break
+            out[rr, cc] = color
+            rr += dr
+            cc += dc
