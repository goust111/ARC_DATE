+    h, w = shape
+    pr0, pc0, pr1, pc1 = pattern_box
+    boxes: list[tuple[int, int, int, int]] = []
+    for fh in range(5, 10):
+        for fw in range(5, 10):
+            if fh >= h or fw >= w:
+                continue
+            for r0 in range(1, h - fh):
+                r1 = r0 + fh - 1
+                for c0 in range(1, w - fw):
+                    c1 = c0 + fw - 1
