+    unique = set(int(v) for v in np.unique(patch) if int(v) != BG)
+    if len(unique) < 3:
+        accent_cells = [(0, 0), (0, w // 2), (h // 2, 0), (h - 1, w // 2)]
+        for idx, (r, c) in enumerate(accent_cells):
+            orbit = {
+                (r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, c),
+                (h - 1 - r, w - 1 - c),
+            }
+            color = int(PATTERN_COLORS[idx % len(PATTERN_COLORS)])
+            for rr, cc in orbit:
+                if border[rr, cc]:
