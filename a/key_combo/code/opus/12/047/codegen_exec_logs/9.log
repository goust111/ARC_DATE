+        corner_targets: dict[tuple[int, int], list[tuple[int, int]]] = {}
+        for corner, direction in _frame_corners(frame_box):
+            ray = _trace_ray_cells(base.shape, corner, direction)
+            hit = None
+            for idx, cell in enumerate(ray):
