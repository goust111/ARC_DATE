+
+def _mirror_candidates(cur: np.ndarray, r: int, c: int, a2: int, b2: int) -> list[int]:
+    h, w = cur.shape
+    vals: list[int] = []
+    c2 = a2 - c
+    if 0 <= c2 < w and int(cur[r, c2]) not in (BG, FRAME):
+        vals.append(int(cur[r, c2]))
