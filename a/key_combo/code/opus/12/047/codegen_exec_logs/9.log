+        for c in range((w + 1) // 2):
+            orbit = {
+                (r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, c),
+                (h - 1 - r, w - 1 - c),
+            }
+            if orbit & used:
+                continue
+            color = int(PATTERN_COLORS[int(rng.integers(0, len(PATTERN_COLORS)))])
+            for rr, cc in orbit:
+                patch[rr, cc] = color
+            used |= orbit
+
+    unique = set(map(int, np.unique(patch)))
+    if len(unique) < 3:
+        anchors = [
+            (0, 0),
+            (0, w // 2),
+            (h // 2, 0),
+            (h // 2, w // 2),
+        ]
+        for idx, (r, c) in enumerate(anchors):
+            color = int(PATTERN_COLORS[idx % len(PATTERN_COLORS)])
+            orbit = {
+                (r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, c),
+                (h - 1 - r, w - 1 - c),
+            }
+            for rr, cc in orbit:
+                patch[rr, cc] = color
+    return patch
