+        key = (mismatches, -pairs)
+        if best_key is None or key < best_key:
+            best_key = key
+            best_a2 = a2
+    return int(best_a2)
+
+
+def _best_horizontal_axis(g: np.ndarray, known: np.ndarray) -> int:
