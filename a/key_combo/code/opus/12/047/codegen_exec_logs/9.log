+    center_frame = (pr0 + pr1 - fh + 1) // 2, (pc0 + pc1 - fw + 1) // 2
+    frame_boxes: list[tuple[int, int, int, int]] = []
+    for fr0 in range(fr_min, fr_max + 1):
