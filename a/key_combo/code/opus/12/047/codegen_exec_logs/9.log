+    pr0, pc0, pr1, pc1 = pat_box
+
+    a2 = _best_vertical_axis(g, pattern_known)
+    b2 = _best_horizontal_axis(g, pattern_known)
+
+    out = g.copy()
+    repaired: dict[tuple[int, int], int] = {}
+
+    changed = True
+    for _ in range(6):
+        if not changed:
+            break
+        changed = False
+        for r in range(pr0, pr1 + 1):
