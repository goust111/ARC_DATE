+    best_a2 = 0
+    best_key = None
+    for a2 in range(0, 2 * (w - 1) + 1):
+        mismatches = 0
+        pairs = 0
+        for r in range(h):
+            cols = np.where(known[r])[0]
+            for c in cols:
