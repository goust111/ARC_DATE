+def _orbit_key(cell: tuple[int, int], pattern_box: tuple[int, int, int, int]) -> tuple[tuple[int, int], ...]:
+    r, c = cell
+    pr0, pc0, pr1, pc1 = pattern_box
+    orbit = {
+        (r, c),
+        (r, pc0 + pc1 - c),
+        (pr0 + pr1 - r, c),
+        (pr0 + pr1 - r, pc0 + pc1 - c),
+    }
+    return tuple(sorted((int(rr), int(cc)) for rr, cc in orbit))
