+    pc0 = int(rng.integers(min_c0, max_c0 + 1))
+    pr1 = pr0 + ph - 1
+    pc1 = pc0 + pw - 1
+    grid[pr0 : pr1 + 1, pc0 : pc1 + 1] = pattern
