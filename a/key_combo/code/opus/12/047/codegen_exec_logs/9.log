+    r0, c0, r1, c1 = box
+    return [
+        ((r0, c0), (-1, -1)),
+        ((r0, c1), (-1, 1)),
+        ((r1, c0), (1, -1)),
+        ((r1, c1), (1, 1)),
+    ]
