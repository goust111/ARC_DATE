+def _all_corner_ray_cells(shape: tuple[int, int], frame_box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for corner, direction in _frame_corners(frame_box):
