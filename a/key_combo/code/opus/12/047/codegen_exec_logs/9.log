+                (r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, c),
+                (h - 1 - r, w - 1 - c),
+            }
+            occupied = [(rr, cc) for rr, cc in orbit if border[rr, cc]]
+            if not occupied or orbit & used:
+                continue
+            color = int(PATTERN_COLORS[int(rng.integers(0, len(PATTERN_COLORS)))])
+            for rr, cc in occupied:
