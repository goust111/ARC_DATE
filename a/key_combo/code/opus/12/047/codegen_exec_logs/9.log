+    best_b2 = 0
+    best_key = None
+    rows = np.where(known.any(axis=1))[0]
+    for b2 in range(0, 2 * (h - 1) + 1):
+        mismatches = 0
+        pairs = 0
+        for r in rows:
+            r2 = b2 - int(r)
+            if not (0 <= r2 < h):
+                continue
+            cols = np.where(known[r] & known[r2])[0]
+            pairs += int(len(cols))
+            if len(cols):
+                mismatches += int(np.sum(g[r, cols] != g[r2, cols]))
+        key = (mismatches, -pairs)
+        if best_key is None or key < best_key:
+            best_key = key
+            best_b2 = b2
+    return int(best_b2)
