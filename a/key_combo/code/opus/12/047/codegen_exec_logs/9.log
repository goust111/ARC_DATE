+        if not changed:
+            break
+        changed = False
+        for r in range(pr0, pr1 + 1):
+            for c in range(pc0, pc1 + 1):
+                if int(out[r, c]) != BG:
+                    continue
+                candidates = _mirror_candidates(out, r, c, a2, b2)
