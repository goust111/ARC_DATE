0014: def main(input_grid):
0015:     """
0016:     Mirror gray objects across their nearest red frame so the reflected copies land inside the frames.
0017: 
0018:     Input structure:
0019:     - The input is a black grid with red frame objects and gray objects outside them.
0020:     - All objects are aligned along one row or one column.
0021:     - Each gray object belongs to the closest red frame.
0022: 
0023:     Rule:
0024:     - Detect the red frames and gray objects.
0025:     - Infer whether the reflection axis is horizontal or vertical from object alignment.
0026:     - Reflect each gray object across the center line of its closest frame and redraw the frame.
0027: 
0028:     Key insight:
0029:     - The red frames define local mirror axes; each gray object moves by reflection, not by free translation.
0030:     """
0031:     # Extract the framework
0032:     frame_color = Color.RED
0033:     object_color = Color.GRAY 
0034:     background = Color.BLACK
0035: 
0036:     # Create an empty grid
0037:     n, m = input_grid.shape
0038:     output_grid = np.zeros((n, m), dtype=int)
0039: 
0040:     # parse the input
0041:     objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=True, return_format="objects")
0042:     frames = [ obj for obj in objects if frame_color in colors_present(obj, exclude={ background }) ]
