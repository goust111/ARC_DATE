+    out = g.copy()
+    repaired: dict[tuple[int, int], int] = {}
+
+    changed = True
+    for _ in range(6):
+        if not changed:
+            break
+        changed = False
+        for r in range(pr0, pr1 + 1):
+            for c in range(pc0, pc1 + 1):
+                if int(out[r, c]) != BG:
