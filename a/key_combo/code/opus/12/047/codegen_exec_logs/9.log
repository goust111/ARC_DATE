+
+    desired_triggers = 3 if int(rng.integers(0, 100)) < 40 else 2
+    fh = int(rng.choice([5, 7]))
+    fw = int(rng.choice([5, 7]))
+    fr_min = pr0 + 2
+    fc_min = pc0 + 2
+    fr_max = pr1 - fh - 1
+    fc_max = pc1 - fw - 1
+    if fr_min > fr_max or fc_min > fc_max:
+        return None
