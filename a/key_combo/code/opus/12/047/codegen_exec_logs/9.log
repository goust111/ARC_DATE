+def _build_outline_pattern(rng: np.random.Generator, h: int, w: int) -> np.ndarray:
+    patch = np.zeros((h, w), dtype=int)
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
