+        ((r0, c0), (-1, -1)),
+        ((r0, c1), (-1, 1)),
+        ((r1, c0), (1, -1)),
+        ((r1, c1), (1, 1)),
+    ]
+
+
+def _solve_with_metadata(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    pattern_known = (g != BG) & (g != FRAME)
