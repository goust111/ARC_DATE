+def _expected_from_blueprint(
+    grid: np.ndarray,
+    rows: list[int],
+    cols: list[int],
+    row_colors: list[int],
+    col_colors: list[int],
+) -> np.ndarray:
+    row_map = {r: int(color) for r, color in zip(rows, row_colors)}
+    col_map = {c: int(color) for c, color in zip(cols, col_colors)}
+    return _render_output(grid, rows, cols, row_map, col_map)
+
+
+def _valid_instance(
+    grid: np.ndarray,
+    rows: list[int],
+    cols: list[int],
+    row_colors: list[int],
+    col_colors: list[int],
