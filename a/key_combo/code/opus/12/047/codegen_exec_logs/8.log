+
+def _candidate_origins(shape: tuple[int, int], direction: tuple[int, int], lane: int | None) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    if dr < 0:
+        row_range = range(1, h - 3)
+    elif dr > 0:
+        row_range = range(1, h - 3)
+    else:
+        assert lane is not None
+        row_range = [lane]
+    if dc < 0:
+        col_range = range(1, w - 3)
+    elif dc > 0:
+        col_range = range(1, w - 3)
+    else:
+        assert lane is not None
+        col_range = [lane]
