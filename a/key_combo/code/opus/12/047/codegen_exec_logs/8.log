+    owner = np.full((h, w), -1, dtype=int)
+    final_color = np.full((h, w), BLACK, dtype=int)
+    for idx in order:
+        for (r, c), value in moved[idx]["translated"].items():
+            owner[r, c] = idx
+            final_color[r, c] = value
