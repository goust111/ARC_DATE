+def _collision_profile(trace: dict) -> tuple[list[list[int]], list[str]]:
+    movers = trace["movers"]
+    n = len(movers)
+    graph = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if movers[i]["occupied"] & movers[j]["occupied"]:
+                graph[i].append(j)
+                graph[j].append(i)
+    groups = []
+    seen = [False] * n
+    for i in range(n):
+        if seen[i] or not graph[i]:
+            continue
+        stack = [i]
+        seen[i] = True
+        group = []
+        while stack:
+            cur = stack.pop()
+            group.append(cur)
+            for nxt in graph[cur]:
+                if not seen[nxt]:
+                    seen[nxt] = True
+                    stack.append(nxt)
