+
+def _translate_bbox(bbox: tuple[int, int, int, int], direction: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    dr, dc = direction
+    shift_r = 0
+    shift_c = 0
+    if dr < 0:
+        shift_r = -r0
+    elif dr > 0:
+        shift_r = h - 1 - r1
+    if dc < 0:
+        shift_c = -c0
+    elif dc > 0:
+        shift_c = w - 1 - c1
+    return shift_r, shift_c
