+        lo, hi = sorted((a, b), key=lambda idx: movers[idx]["grey_area"])
+        if movers[lo]["grey_area"] == movers[hi]["grey_area"]:
+            kinds.append("invalid")
+        elif movers[lo]["visible_grey_count"] == 0:
+            kinds.append("full")
+        elif movers[lo]["partial"]:
