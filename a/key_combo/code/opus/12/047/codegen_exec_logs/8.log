+        "bbox": (r0, c0, r1, c1),
+        "cells": values,
+        "local_cells": local_cells,
+        "grey_local": grey_local,
+        "color_local": color_local,
+        "grey_area": len(grey_local),
+        "direction": _infer_direction_from_cells(grey_local, color_local),
