+
+
+def _candidate_origins(shape: tuple[int, int], direction: tuple[int, int], lane: int | None) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    if dr < 0:
+        row_range = range(2, h - 3)
+    elif dr > 0:
+        row_range = range(1, h - 4)
+    else:
+        assert lane is not None
+        row_range = [lane]
+    if dc < 0:
+        col_range = range(2, w - 3)
+    elif dc > 0:
+        col_range = range(1, w - 4)
+    else:
+        assert lane is not None
+        col_range = [lane]
+    return [(r, c) for r in row_range for c in col_range]
+
+
+def _collision_profile(trace: dict) -> tuple[list[list[int]], list[str]]:
+    movers = trace["movers"]
+    n = len(movers)
+    graph = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if movers[i]["occupied"] & movers[j]["occupied"]:
+                graph[i].append(j)
+                graph[j].append(i)
+    groups = []
+    seen = [False] * n
+    for i in range(n):
+        if seen[i] or not graph[i]:
+            continue
+        stack = [i]
+        seen[i] = True
+        group = []
+        while stack:
+            cur = stack.pop()
+            group.append(cur)
+            for nxt in graph[cur]:
+                if not seen[nxt]:
+                    seen[nxt] = True
+                    stack.append(nxt)
