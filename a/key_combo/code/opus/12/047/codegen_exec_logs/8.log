+    grey_local = [tuple(pos) for pos in np.argwhere(sprite == GREY)]
+    color_local = [tuple(pos) for pos in np.argwhere((sprite != GREY) & (sprite != BLACK))]
+    if _infer_direction_from_cells(grey_local, color_local) != direction:
