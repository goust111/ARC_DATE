+    return direction
+
+
+def _parse_sprite(grid: np.ndarray, comp: list[tuple[int, int]]) -> dict:
+    values = {pos: int(grid[pos]) for pos in comp}
+    r0, c0, r1, c1 = _bbox(comp)
