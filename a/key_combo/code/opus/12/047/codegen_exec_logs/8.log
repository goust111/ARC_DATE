+    edge_dir = random.choice(CARDINALS)
+    partial_pair = _make_collision_pair(
+        _transform_support(RING8, rot_part, flip_part),
+        _transform_support(CARDINAL7, rot_part, flip_part),
+        edge_dir,
+        (colors[2], colors[3]),
