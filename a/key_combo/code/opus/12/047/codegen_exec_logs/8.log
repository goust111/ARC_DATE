+
+    extra_count = random.choice((1, 2))
+    extras: list[tuple[np.ndarray, tuple[int, int], int | None]] = []
+    for extra_idx in range(extra_count):
+        for _ in range(80):
+            direction = random.choice(DIRS8)
+            lane = None
+            if direction in CARDINALS:
