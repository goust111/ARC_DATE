+def _make_collision_pair(
+    big_support: set[tuple[int, int]],
+    small_support: set[tuple[int, int]],
+    direction: tuple[int, int],
+    colors: tuple[int, int],
+) -> tuple[np.ndarray, np.ndarray] | None:
