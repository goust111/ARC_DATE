+        return None
+    best_score = max(score for score, _ in combos)
+    chosen = random.choice([combo for score, combo in combos if score == best_score])
+
+    sprite = np.zeros((3, 3), dtype=int)
+    for pos in cells:
+        sprite[pos] = GREY
+    for pos in chosen:
+        sprite[pos] = color
