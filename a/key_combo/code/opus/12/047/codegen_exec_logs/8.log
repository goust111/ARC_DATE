+PARTIAL7 = {(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (2, 0), (2, 1)}
+CARDINAL7 = {(0, 0), (0, 1), (0, 2), (1, 1), (2, 0), (2, 1), (2, 2)}
+STAIR6 = {(0, 0), (0, 1), (0, 2), (1, 1), (1, 2), (2, 2)}
+STAIR6_M = {(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (2, 0)}
