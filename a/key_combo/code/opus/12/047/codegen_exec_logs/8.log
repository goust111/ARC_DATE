+
+
+def _sample_unique_colors(n: int) -> list[int]:
+    palette = list(MARKER_COLORS)
+    random.shuffle(palette)
+    return palette[:n]
+
+
+def _build_extra_sprite(direction: tuple[int, int], color: int) -> np.ndarray | None:
