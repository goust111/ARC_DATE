+
+
+def _orbit_positions(r: int, c: int, axis_r: int, axis_c: int) -> tuple[tuple[int, int], ...]:
+    return (
+        (r, c),
+        (2 * axis_r - r, c),
+        (r, 2 * axis_c - c),
+        (2 * axis_r - r, 2 * axis_c - c),
+    )
+
+
+def _paint_outline(out: np.ndarray, sprite_infos: list[dict[str, object]]) -> None:
+    for info in sprite_infos:
