+    infos: list[dict[str, object]] = []
+    for idx, comp in enumerate(grey_components):
+        marker_r, marker_c, marker_color = markers_by_component[idx]
+        body = {(int(r), int(c)) for r, c in comp}
+        outline_color = MARKER_TO_OUTLINE[marker_color]
+        outline = set()
+        for r, c in body:
