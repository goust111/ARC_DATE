+def _neighbors4(r: int, c: int):
+    for dr, dc in CARDINAL_DIRS:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
