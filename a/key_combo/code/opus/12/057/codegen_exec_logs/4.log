+        for shape in shapes:
+            frontier = set()
+            for cell in shape:
+                frontier.update(neighbors4(*cell))
+            for cell in frontier - set(shape):
+                grown = set(shape)
+                grown.add(cell)
+                next_shapes.add(_normalize_shape(grown))
