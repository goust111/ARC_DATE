+def _semantic_checks(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    active_color: int,
+    total_markers: int,
+    template_index: int,
+    placements: list[tuple[int, int]],
+    full_variants: list[np.ndarray],
+    active_variants: list[np.ndarray],
+    core_variants: list[np.ndarray],
+    separator_row: int,
