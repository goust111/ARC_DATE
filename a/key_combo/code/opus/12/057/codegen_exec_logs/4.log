+
+    code_row = _build_code_row(width, marker_counts, active_color, total_markers)
+    inp, expected = _expected_output(
+        (height, width),
+        placements,
+        chosen_full,
+        active_variants,
+        core_variants,
+        template_index,
+        separator_row,
+        code_row,
