+        active_color,
+        total_markers,
+        template_index,
+        placements,
+        chosen_full,
+        active_variants,
+        core_variants,
+        separator_row,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
