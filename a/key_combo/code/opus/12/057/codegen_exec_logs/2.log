+from arc_utils import Color, get_bg, in_bounds
+
+
+LINE_COLOR = Color.RED
+MARKER_COLOR = Color.PINK
+PATTERN_COLORS = (Color.BLUE, Color.GREEN)
+UNKNOWN_COLORS = {LINE_COLOR, MARKER_COLOR}
+
+GEN_ATTEMPTS = 500
+GRID_MIN = 14
+GRID_MAX = 18
+PERIOD_MIN = 2
+PERIOD_MAX = 5
