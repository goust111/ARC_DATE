+        _in_bounds(grid.shape, r - 1, c - 1) and int(grid[r - 1, c - 1]) == GREEN
+    ) or (
+        _in_bounds(grid.shape, r + 1, c + 1) and int(grid[r + 1, c + 1]) == GREEN
+    )
+    has_ne_sw = (
+        _in_bounds(grid.shape, r - 1, c + 1) and int(grid[r - 1, c + 1]) == GREEN
+    ) or (
+        _in_bounds(grid.shape, r + 1, c - 1) and int(grid[r + 1, c - 1]) == GREEN
