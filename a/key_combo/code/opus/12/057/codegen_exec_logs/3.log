  "trajectory": "paint each visited background pixel red",
  "transform": "keep the original markers and all other cells unchanged"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 15x15 [observed]
  background: BLACK (0) [observed]
  markers:
    count: exactly 3
    color: single non-RED foreground color; BLUE in all eval [observed]
    arrangement: equally spaced on a straight arithmetic line
    step_vector: (dr, dc) with dr=dc>0 (diagonal down-right) [observed]; solver allows any nonzero equal-step direction
    step_magnitude_per_component: 2-4 [observed]
    first_marker_position: row 0-1, col 0-1 [observed]
  continuation:
    color: RED (2)
    direction: same step vector as markers, starting one step past last marker
    length: 1-4 red pixels; equals number of in-bounds steps after last marker
    cells_must_be: background before painting
  output: input grid unchanged + continuation pixels painted RED

generation_strategy:
  approach: direct construction (simple enough for forward generation)
  steps:
    1. Create 15x15 BLACK grid
    2. Pick step magnitude s in 1-5 for each of dr and dc (allow any direction, not just diagonal, to generalize beyond eval)
    3. Pick first marker (r0, c0) such that all 3 markers and at least 1 continuation step fit in bounds
    4. Place 3 markers at (r0, c0), (r0+dr, c0+dc), (r0+2*dr, c0+2*dc) in a non-RED color
    5. Verify at least 1 and at most ~6 continuation steps land in-bounds (reject if 0)
  constraint_satisfaction:
    - 3 equally-spaced markers guaranteed by construction
    - >=1 red continuation guaranteed by step-3 bounds check
    - no collisions since grid is otherwise empty
```
