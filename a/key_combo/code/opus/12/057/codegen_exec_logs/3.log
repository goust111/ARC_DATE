+        "greens": greens,
+        "axis": axis,
+        "path": path,
+        "step": step,
+        "pattern": pattern,
+    }
+
+
+def _sample_group_orientations(rng: np.random.Generator, majority_axis: str, count: int) -> list[str]:
+    minority_axis = NE_SW if majority_axis == NW_SE else NW_SE
+    if count == 2:
