+    if not all(_in_bounds(shape, r, c) for r, c in markers):
+        return None
+
+    middle = markers[1]
+    greens = [(middle[0] + dr, middle[1] + dc) for dr, dc in pattern]
+    if not all(_in_bounds(shape, r, c) for r, c in greens):
