import numpy as np
from collections import Counter

NW_SE='nw_se'
NE_SW='ne_sw'
patterns={
    NW_SE:[
        [(-2,-2),(-1,-1)],
        [(1,1),(2,2)],
        [(-2,-1),(-1,0),(0,1)],
        [(0,-1),(1,0),(2,1)],
        [(-1,0),(0,1),(1,2),(0,-2),(1,-1),(2,0)],
        [(-2,-1),(-1,0),(0,1),(1,-1),(2,0)],
    ],
    NE_SW:[
        [(-2,2),(-1,1)],
        [(1,-1),(2,-2)],
        [(-2,1),(-1,0),(0,-1)],
        [(0,1),(1,0),(2,-1)],
        [(-1,0),(0,-1),(1,-2),(0,2),(1,1),(2,0)],
        [(-2,1),(-1,0),(0,-1),(1,1),(2,0)],
    ]
}

def classify(g,r,c):
    H,W=g.shape
    orth=((r-1,c),(r+1,c),(r,c-1),(r,c+1))
    assert not any(0<=rr<H and 0<=cc<W and g[rr,cc]==3 for rr,cc in orth)
    has_nwse=((r>0 and c>0 and g[r-1,c-1]==3) or (r+1<H and c+1<W and g[r+1,c+1]==3))
    has_nesw=((r>0 and c+1<W and g[r-1,c+1]==3) or (r+1<H and c>0 and g[r+1,c-1]==3))
    assert has_nwse "'^ has_nesw, ((r,c), has_nwse, has_nesw)
    return NW_SE if has_nwse else NE_SW

for orient, plist in patterns.items():
    for pat in plist:
        g=np.zeros((11,11),dtype=int)
        m=(5,5)
        for dr,dc in pat:
            g[m[0]+dr,m[1]+dc]=3
        inside=[]
        for dr,dc in pat:
            if max(abs(dr),abs(dc))==1:
                inside.append((dr,dc))
        classes=[classify(g,m[0]+dr,m[1]+dc) for dr,dc in pat]
        print(orient, pat, '"'inside', len(inside), 'ok', Counter(classes))
