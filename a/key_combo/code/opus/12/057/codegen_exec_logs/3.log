+
+def _continuation_cells(
+    shape: tuple[int, int], start: tuple[int, int], step: tuple[int, int]
+) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    r, c = start
+    dr, dc = step
+    while _in_bounds(shape, r, c):
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
