+def _find_marker_groups(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    blue_coords = _sort_row_major([tuple(x) for x in np.argwhere(grid == BLUE)])
+    assert len(blue_coords) in (6, 9)
+    blue_set = set(blue_coords)
