+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+TEAL = 8
+
+NW_SE = "nw_se"
+NE_SW = "ne_sw"
+
+STEP_OPTIONS = [
+    (0, 2),
+    (0, 3),
+    (0, 4),
+    (2, 0),
+    (3, 0),
+    (4, 0),
+    (2, 2),
+    (3, 3),
+    (4, 4),
+    (2, -2),
+    (3, -3),
+    (4, -4),
+]
+
