+    red_painted = int(np.sum((grid == RED) & (true_out == BLUE)))
+    red_preserved = int(np.sum((grid == RED) & (true_out == RED)))
+    if require_reds and (red_total < 2 or red_painted < 1 or red_preserved < 1):
+        return None
+    if stop_count < 1:
