+    if int(np.sum(true_out == GREY)) < 3:
+        return None
+
+    return {
+        "green_objects": green_objects,
+        "emitters": emitters,
+        "blockers": blockers,
+        "output": true_out,
+        "stop_count": stop_count,
+    }
+
+
