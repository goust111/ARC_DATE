+
+    if not starts or not ends:
+        return None
+
+    random.shuffle(starts)
+    starts.sort(key=lambda rc: min(abs(rc[0] - er) + abs(rc[1] - ec) for er, ec in ends))
+    for start in starts:
+        q = deque([start])
+        parent = {start: None}
+        while q:
+            r, c = q.popleft()
+            if (r, c) in ends and (r, c) != start:
+                path = []
+                cur = (r, c)
+                while cur is not None:
+                    path.append(cur)
+                    cur = parent[cur]
+                path.reverse()
+                if len(path) >= 2:
