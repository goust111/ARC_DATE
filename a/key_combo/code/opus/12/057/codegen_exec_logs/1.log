+
+    for r, c in np.argwhere(grid == RED):
+        if any(
+            0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and grid[nr, nc] in (GREEN, TEAL)
+            for nr, nc in _neighbors4(int(r), int(c))
