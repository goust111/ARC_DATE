+
+    nonblack_labels, nonblack_components = _label_mask(grid != BLACK)
+    group_sizes = []
+    for coords in nonblack_components:
+        comp_id = nonblack_labels[coords[0][0], coords[0][1]]
+        obj_count = 0
+        seen = set()
+        for r, c in coords:
+            if grid[r, c] == GREEN:
+                seen.add((r, c))
+        if seen:
