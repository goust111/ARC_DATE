+
+
+def _paint_path(grid: np.ndarray, path: list[tuple[int, int]]) -> None:
+    for r, c in path:
+        grid[r, c] = TEAL
+
+
+def _is_hit_by_emitter(
+    grid: np.ndarray,
+    cells: set[tuple[int, int]],
+    emitter_cells: list[tuple[int, int]],
+) -> bool:
