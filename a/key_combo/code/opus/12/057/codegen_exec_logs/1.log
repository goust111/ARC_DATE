+        min_c = min(c for _, c in coords)
+        norm = tuple(sorted((r - min_r, c - min_c) for r, c in coords))
+        h, w = _bbox_of_shape(norm)
+        full_rect = len(norm) == h * w
+        line_like = min(h, w) == 1
