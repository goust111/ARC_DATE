+    starts = []
+    ends = set()
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if grid[r, c] != BLACK:
+                continue
+            adj_ids = adjacent_green_ids(r, c)
+            if adj_ids == {start_obj} and not any(
+                0 <= nr < h and 0 <= nc < w and grid[nr, nc] == TEAL for nr, nc in _neighbors4(r, c)
+            ):
+                starts.append((r, c))
+            if adj_ids == {end_obj} and not any(
