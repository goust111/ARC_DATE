+                    continue
+                if (nr, nc) in ends:
+                    parent[(nr, nc)] = (r, c)
+                    q.append((nr, nc))
+                elif not adjacent_nonblack(nr, nc):
+                    parent[(nr, nc)] = (r, c)
+                    q.append((nr, nc))
