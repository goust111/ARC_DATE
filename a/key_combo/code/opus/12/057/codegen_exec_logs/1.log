+
+def _absolute_cells(shape: tuple[tuple[int, int], ...], top: int, left: int) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in shape]
+
+
+def _random_shape() -> tuple[tuple[int, int], ...]:
