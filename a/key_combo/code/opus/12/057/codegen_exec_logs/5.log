+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+ORANGE = 7
+TEAL = 8
+
+LEGEND_STEP = 2
+GEN_ATTEMPTS = 600
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
