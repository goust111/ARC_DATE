+    blocks: list[tuple[int, int, int, int]] = []
+    for comp in _components(grid != BLACK):
+        r0, c0, r1, c1 = _bbox(comp)
+        color = int(grid[comp[0][0], comp[0][1]])
+        if len(comp) == 1:
+            singles.append((r0, c0, color))
+            continue
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
