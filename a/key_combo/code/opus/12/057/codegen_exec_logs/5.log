+    min_base_c = phys_w + 3
+    max_base_r = grid_h - ((rows - 1) * step + size)
+    max_base_c = grid_w - ((cols - 1) * step + size)
+    if min_base_r > max_base_r or min_base_c > max_base_c:
+        return None
