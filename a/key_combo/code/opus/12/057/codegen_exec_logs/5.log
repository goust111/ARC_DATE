+    best_score = max(len(cand["present"]) for cand in candidates)
+    best = [cand for cand in candidates if len(cand["present"]) == best_score]
+    unique: list[dict] = []
+    seen = set()
+    for cand in best:
+        key = (
+            cand["size"],
+            cand["step"],
+            cand["base_r"],
+            cand["base_c"],
+            tuple(sorted(cand["present"])),
