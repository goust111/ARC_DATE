+        grid[origin_r + int(rr) * LEGEND_STEP, origin_c + int(cc) * LEGEND_STEP] = int(legend[rr, cc])
+
+    for rr, cc in sorted(present):
+        color = int(legend[rr, cc])
+        tr = base_r + rr * step
+        tc = base_c + cc * step
