+        color = int(grid[comp[0][0], comp[0][1]])
+        if len(comp) == 1:
+            singles.append((r0, c0, color))
+            continue
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height == width and 3 <= height <= 5:
+            sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+            if np.all(sub == color) and len(comp) == height * width:
+                blocks.append((r0, c0, height, color))
