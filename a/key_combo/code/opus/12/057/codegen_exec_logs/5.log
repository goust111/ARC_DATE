+    target = TEAL if len(params["missing"]) % 2 == 1 else RED
+    if not any(int(params["legend"][r, c]) == target for r, c in params["missing"]):
+        return False
+    if not any(int(params["legend"][r, c]) == target for r, c in params["present"]):
