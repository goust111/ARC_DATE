+
+
+ANGLE_BY_COLOR = {
+    Color.RED: "cw90",
+    Color.GREEN: "halfturn",
+    Color.YELLOW: "ccw90",
+}
+SOURCE_COLORS = tuple(ANGLE_BY_COLOR)
+ROTATION_LABELS = tuple(ANGLE_BY_COLOR[color] for color in SOURCE_COLORS)
+
+
+GRID_SIDE_RANGE = (14, 19)
+PIVOT_COUNT_RANGE = (3, 5)
