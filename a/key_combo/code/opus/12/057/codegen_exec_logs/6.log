+            slots,
+            candidates_by_slot,
+            idx + 1,
+            used_sources,
+            used_targets,
+            chosen,
+            row_count + int(same_row),
+            col_count + int(not same_row),
+        )
+        if result is not None:
+            return result
+        chosen.pop()
+        used_sources.remove(source)
