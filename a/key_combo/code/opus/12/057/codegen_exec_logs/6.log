+
+
+def _slot_colors(total: int) -> list[int]:
+    colors = [Color.RED, Color.GREEN, Color.YELLOW]
+    while len(colors) < total:
+        colors.append(random.choice(SOURCE_COLORS))
+    random.shuffle(colors)
+    return colors
+
+
+def _candidate_placements(
+    pivot: Coord,
+    color: int,
+    shape: tuple[int, int],
