+
+def _unique_pivot(source: Coord, pivots: list[Coord]) -> Coord:
+    matches = [pivot for pivot in pivots if pivot[0] == source[0] or pivot[1] == source[1]]
+    assert len(matches) == 1, "each source must align with exactly one pivot"
