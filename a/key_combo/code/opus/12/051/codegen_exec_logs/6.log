+
+    return out
+
+
+def _paint_motif(grid: np.ndarray, cell: dict, center: tuple[int, int], *, state: str) -> None:
+    cr = cell["r0"] + center[0]
+    cc = cell["c0"] + center[1]
+    shell = [(cr + dr, cc + dc) for dr, dc in CARDINAL]
+    if state in {"complete", "shell_only"}:
+        for rr, cc2 in shell:
+            grid[rr, cc2] = BLUE
+    if state in {"complete", "center_only"}:
+        grid[cr, cc] = RED
