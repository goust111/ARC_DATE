spec:
  grid: 10x10, background BLACK
  markers:
    count: 3 [observed]
    location: row 0 only, each a single pixel, distinct columns
    colors: 3 distinct non-BLACK non-GREY colors
  grey_rectangles:
    count: equal to marker count (1:1 mapping)
    shape: solid axis-aligned rectangles, height 2-7, width 2-5
    top_row: >=2 (row 1 always empty)
    placement: no two rects overlap in 2D; may share row-range or col-range but not both; may touch grid boundary
    marker_assignment: each rect's column span contains exactly one marker column; each marker falls in exactly one rect
  transform: recolor each GREY rect with the color of the unique marker whose column lies within its col span

generation_strategy:
  approach: output-first
  steps:
    1. Pick 3 distinct non-BLACK non-GREY colors for markers.
    2. Place 3 non-overlapping solid rectangles (h 2-7, w 2-5) on the 10x10 grid, all starting at row >=2, ensuring no 2D bbox overlap. Rects may touch grid edges. Color them with the 3 chosen colors (this is the output state).
    3. For each colored rect, pick one column within its col span as the marker column. Verify each marker column falls in exactly one rect's span.
    4. Place marker pixels at row 0 at those columns with the corresponding colors.
    5. To get the input, replace all colored rect cells with GREY.
```
