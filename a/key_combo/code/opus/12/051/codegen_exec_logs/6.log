+                    "c1": c1,
+                    "height": r1 - r0 + 1,
+                    "width": c1 - c0 + 1,
+                    "area": (r1 - r0 + 1) * (c1 - c0 + 1),
+                }
+            )
+    return cells
+
+
+def _classify_cell(cell: np.ndarray) -> dict:
+    h, w = cell.shape
+    nonblack = np.argwhere(cell != BLACK)
+    if nonblack.size == 0:
+        return {"state": "empty"}
