+        left_hits = [c for c in marker_cols if c0 <= c <= c0 + 1]
+        mirror_c0 = width - 2 - c0
+        right_hits = [c for c in marker_cols if mirror_c0 <= c <= mirror_c0 + 1]
+        if len(left_hits) == 1 and len(right_hits) == 1:
+            records.append(
