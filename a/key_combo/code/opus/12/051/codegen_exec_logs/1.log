+        {"source": 2, "target": 3, "out": (row_cd, right), "hit": (row_cd, left + s - 1), "dir": (0, -1)},
+        {"source": 3, "target": 0, "out": (bottom, col_da), "hit": (top + s - 1, col_da), "dir": (-1, 0)},
+    ]
