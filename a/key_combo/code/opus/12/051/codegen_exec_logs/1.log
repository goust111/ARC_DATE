+def _build_layout(rng: random.Random) -> dict:
+    n = rng.choice([3, 4, 5])
+    if n == 3:
+        return _build_cycle3(rng)
+    if n == 5:
+        return _build_cycle5(rng)
+    return rng.choice([_build_cycle4, _build_pair4])(rng)
