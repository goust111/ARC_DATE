+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+TEAL = 8
+
+GEN_ATTEMPTS = 500
+ROW_BAND_OPTIONS = (3, 4)
+COL_BAND_OPTIONS = (3, 4)
+BAND_SIZE_MIN = 2
+BAND_SIZE_MAX = 6
