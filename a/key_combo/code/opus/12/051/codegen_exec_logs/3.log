+
+def trim_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise ValueError("empty mask")
+    r0, c0, r1, c1 = bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy().astype(bool)
