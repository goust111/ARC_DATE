+def _choose_centers(height: int, width: int, n_objects: int) -> list[tuple[int, int]] | None:
+    row_pool = list(range(3, height - 3))
+    col_pool = list(range(3, width - 3))
+    for _ in range(MAX_PLACEMENT_ATTEMPTS):
