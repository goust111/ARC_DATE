+    if set(record_by_center) != {tuple(obj["center"]) for obj in objects}:
+        return False
+
+    gated_count = 0
+    swapped_count = 0
+    tricky_swap_seen = False
+    for obj in objects:
+        rec = record_by_center[tuple(obj["center"])]
+        if obj["side"] != rec["side"]:
