+    objects = _extract_objects(g, frame)
+    assert 3 <= len(objects) <= 5, "expected 3-5 interior objects"
+    seen_rows = set()
+    seen_cols = set()
+    for obj in objects:
+        r, c = obj["center"]
+        assert r not in seen_rows and c not in seen_cols, "object centers must be row/col distinct"
