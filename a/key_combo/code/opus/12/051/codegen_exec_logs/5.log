+        "bottom": {c for c in range(left + 1, right) if int(g[bottom, c]) == BACKGROUND},
+        "left": {r for r in range(top + 1, bottom) if int(g[r, left]) == BACKGROUND},
+        "right": {r for r in range(top + 1, bottom) if int(g[r, right]) == BACKGROUND},
