+    if gated_count < 1 or swapped_count < 1 or not tricky_swap_seen:
+        return False
+    if sum(len(v) for v in gaps.values()) != len(objects):
+        return False
+    if np.array_equal(inp, expected):
+        return False
+
+    try:
