+        list(range(_detect_lattice_offsets(grid, axis)[0], grid.shape[0], SPACING)),
+        list(range(_detect_lattice_offsets(grid, axis)[1], axis, SPACING)),
+        axis,
+        grid.shape,
+        gate=False,
