0167:     """Choose shuffled same-color horizontal edge targets."""
0168:     all_h_edges = [
0169:         ((r, c), (r, c + 1))
0170:         for r in range(r_count)
0171:         for c in range(c_count - 1)
0172:     ]
0173:     np.random.shuffle(all_h_edges)
0174:     h_limit = min(MAX_HORIZONTAL_EDGES, len(all_h_edges))
0175:     h_target = int(np.random.randint(MIN_HORIZONTAL_EDGES, h_limit + 1))
0176:     return all_h_edges[:h_target]
0177: 
0178: 
0179: def _choose_holes(r_count, c_count, protected, min_foreground):
0180:     total = r_count * c_count
0181:     max_holes = min(MAX_HOLES, total - min_foreground)
0182:     if max_holes <= 0:
0183:         return set()
0184: 
0185:     target = int(np.random.randint(max_holes + 1))
0186:     rows_left = [c_count] * r_count
0187:     cols_left = [r_count] * c_count
0188:     holes = set()
0189: 
0190:     while len(holes) < target:
0191:         safe = []
0192:         for r in range(r_count):
0193:             for c in range(c_count):
0194:                 cell = (r, c)
0195:                 if cell in protected or cell in holes:
0196:                     continue
0197:                 if rows_left[r] > 1 and cols_left[c] > 1:
0198:                     safe.append(cell)
0199:         if not safe:
0200:             break
0201:         cell = _pick(safe)
0202:         holes.add(cell)
0203:         rows_left[cell[0]] -= 1
0204:         cols_left[cell[1]] -= 1
0205: 
0206:     return holes
0207: 
0208: 
0209: def _foreground_cells(r_count, c_count, protected, equal_edges):
0210:     """Choose foreground lattice cells while protecting required edge endpoints."""
0211:     total = r_count * c_count
0212:     all_cells = {(r, c) for r in range(r_count) for c in range(c_count)}
0213:     min_foreground = _component_duplicate_slots(all_cells, equal_edges)
0214:     min_foreground += MIN_DISTINCT_COLORS
0215:     fill_floor = (MIN_FILL_NUMERATOR * total + MIN_FILL_DENOMINATOR - 1) // MIN_FILL_DENOMINATOR
0216:     min_foreground = max(min_foreground, fill_floor)
0217:     holes = _choose_holes(r_count, c_count, protected, min_foreground)
0218:     return {(r, c) for r in range(r_count) for c in range(c_count) if (r, c) not in holes}
0219: 
