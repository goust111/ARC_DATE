0001: from __future__ import annotations
0002: 
0003: import numpy as np
0004: 
0005: from arc_utils import get_bg
0006: 
0007: 
0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Fill the empty upper half with a vertical mirror of the lower-half pattern.
0011: 
0012:     Input structure
0013:     The grid has even height. The upper half is entirely background, and the
0014:     lower half contains the foreground pattern to be completed.
0015: 
0016:     Rule
0017:     Copy the lower half into the upper half after reversing its row order.
0018:     Leave the original lower half unchanged.
0019: 
0020:     Key insight
0021:     The blank upper region is the missing reflected counterpart of the visible
0022:     lower region.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     assert g.ndim == 2, "expected a 2D grid"
0026:     height, _ = g.shape
0027:     assert height % 2 == 0, "expected an even-height grid"
0028: 
0029:     bg = get_bg(g)
0030:     mid = height // 2
0031:     assert np.all(g[:mid] == bg), "expected the upper half to be background"
0032:     assert np.any(g[mid:] != bg), "expected a nonempty lower-half pattern"
0033: 
0034:     out = g.copy()
0035:     out[:mid] = g[mid:][::-1]
0036:     return out
0037: 
0038: # --------------- generator (o5x) ---------------
0039: # Canvas/object size bounds.
0040: HEIGHT_CHOICES, WIDTH_MIN, WIDTH_MAX, BACKGROUND = [6, 8, 10, 12, 14], 3, 5, 0
0041: # Color assignment bounds.
0042: FOREGROUND_COLORS, COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE = np.arange(1, 10), 3, 5
0043: # Secondary-color mutation bounds.
0044: SECONDARY_COL_MAX, SECONDARY_DEPTH_MAX = 2, 2
0045: # Retry limit.
0046: MAX_ATTEMPTS = 300
0047: 
0048: def _sample_layout():
0049:     """Return dimensions and shuffled distinct lower-half bar heights."""
0050:     height = int(np.random.choice(HEIGHT_CHOICES))
0051:     half = height // 2
0052:     width = int(np.random.randint(WIDTH_MIN, min(WIDTH_MAX, half) + 1))
0053:     heights = list(np.random.choice(np.arange(1, half), size=width - 1, replace=False))
0054:     heights.append(half)
0055:     return height, half, width, [int(v) for v in np.random.permutation(heights)]
0056: 
0057: def _assign_primary_colors(width):
0058:     """Return primary colors by column plus unused colors needing coverage."""
0059:     color_count = int(np.random.randint(COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE))
0060:     colors = [int(v) for v in np.random.choice(FOREGROUND_COLORS, size=color_count, replace=False)]
0061:     cols = [int(v) for v in np.random.permutation(width)]
0062:     primary = [None] * width
0063:     for col, color in zip(cols, colors):
0064:         primary[col] = color
0065:     if width >= color_count:
0066:         for col in cols[color_count:]:
0067:             primary[col] = int(np.random.choice(colors))
0068:         return primary, colors, []
0069:     return primary, colors, colors[width:]
0070: 
0071: def _paint_lower_half(half, width, heights, primary, colors, unused_colors):
0072:     """Render the lower half, or return None when constraints cannot fit."""
0073:     lower = np.zeros((half, width), dtype=int)
0074:     for col, bar_height in enumerate(heights):
0075:         lower[half - bar_height :, col] = primary[col]
0076:     eligible = [col for col, bar_height in enumerate(heights) if 2 <= bar_height < half]
0077:     max_two_color = min(SECONDARY_COL_MAX, (width - 1) // 2, len(eligible))
0078:     need_two_color = 1 if unused_colors else 0
0079:     if max_two_color < need_two_color:
0080:         return None
0081:     two_color_count = int(np.random.randint(need_two_color, max_two_color + 1))
0082:     if not two_color_count:
0083:         return lower
0084:     two_color_cols = [int(v) for v in np.random.choice(eligible, size=two_color_count, replace=False)]
0085:     shared_second = unused_colors[0] if unused_colors else int(np.random.choice(colors))
0086:     for col in two_color_cols:
0087:         choices = [c for c in colors if c != primary[col]]
0088:         second = shared_second if shared_second != primary[col] else int(np.random.choice(choices))
0089:         depth = int(np.random.randint(1, min(SECONDARY_DEPTH_MAX, heights[col] - 1) + 1))
0090:         lower[half - depth :, col] = second
0091:     return lower
0092: 
0093: def _gen_attempt() -> np.ndarray | None:
0094:     height, half, width, heights = _sample_layout()
0095:     primary, colors, unused_colors = _assign_primary_colors(width)
0096:     lower = _paint_lower_half(half, width, heights, primary, colors, unused_colors)
0097:     if lower is None:
0098:         return None
0099:     out = np.zeros((height, width), dtype=int)
0100:     out[half:], out[:half] = lower, lower[::-1]
0101:     inp = out.copy()
0102:     inp[:half] = BACKGROUND
0103:     return inp if np.array_equal(main(inp), out) else None
0104: 
0105: def generate_input() -> np.ndarray:
0106:     for _ in range(MAX_ATTEMPTS):
0107:         grid = _gen_attempt()
0108:         if grid is not None:
0109:             return grid
0110:     raise RuntimeError(f"generate_input: failed after {MAX_ATTEMPTS} attempts")

