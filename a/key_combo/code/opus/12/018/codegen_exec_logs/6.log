0100:     paste(
0101:         output_grid,
0102:         rect,
0103:         r - rect_h // 2,
0104:         middle_c - rect_w // 2,
0105:         transparent=Color.BLACK,
0106:         clip=True,
0107:     )
0108: 
0109:     # Connect left/right pixels to the rectangle via horizontal lines
0110:     draw_line(
0111:         grid=output_grid,
0112:         r=r,
0113:         c=c_left + 1,
0114:         direction=(0, 1),
0115:         color=left_color,
0116:         stop_at=Color.NOT_BLACK,
0117:     )
0118:     draw_line(
0119:         grid=output_grid,
0120:         r=r,
0121:         c=c_right - 1,
0122:         direction=(0, -1),
0123:         color=right_color,
0124:         stop_at=Color.NOT_BLACK,
0125:     )
0126: 
0127:     if rotated:
0128:         output_grid = np.rot90(output_grid, k=-1)
0129:     return output_grid
