+                )
+
+    def compatible(a: dict[str, object], b: dict[str, object]) -> bool:
+        return set(a["nonzero"]).isdisjoint(set(b["window"])) and set(b["nonzero"]).isdisjoint(
+            set(a["window"])
+        )
+
+    for h_seed in horizontal_seeds:
