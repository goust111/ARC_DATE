0006: # concepts:
0007: # symmetry detection, boolean indicator
0008: 
0009: # description:
0010: # In the input you will see a 3x3 grid with red pixels scattered randomly.
0011: # To make the output grid, you should recognize if the input grid has mirror symmetry along the x-axis.
0012: # If the input grid has mirror symmetry along the x-axis, output a 1x1 grid with a blue pixel.
0013: # Otherwise, output a 1x1 grid with an orange pixel.
0014: 
0015: def main(input_grid):
0016:     """
0017:     Return a one-pixel blue or orange indicator for horizontal mirror symmetry in a 3 by 3 red pattern.
0018: 
0019:     Input structure:
0020:     - The input is a 3 by 3 grid.
0021:     - Red pixels form a pattern on a black background.
0022:     - The middle row is the mirror axis candidate.
0023: 
0024:     Rule:
0025:     - Compare the rows above the middle with the reversed rows below it.
0026:     - Output a 1 by 1 blue grid if they match.
0027:     - Output a 1 by 1 orange grid otherwise.
0028: 
0029:     Key insight:
0030:     - The spatial symmetry test is reduced to a single color-coded boolean result.
0031:     """
0032:     # Check if the input grid has mirror symmetry along the middle x-axis.
0033:     width, height = input_grid.shape
0034:     middle_r = width // 2
0035:     
0036:     # If the input grid has mirror symmetry along the middle x-axis, output a blue pixel.
0037:     # Otherwise, output an orange pixel.
0038:     if np.all(input_grid[0: middle_r] == input_grid[middle_r + 1:][::-1]):
0039:         output_grid = np.full((1,1), Color.BLUE)
0040:     else:
0041:         output_grid = np.full((1,1), Color.ORANGE)
0042:     
0043:     return output_grid
0044: 
0045: def generate_input():
0046:     width, height = 3, 3
0047:     grid = np.zeros((width, height), dtype=int)
0048:     
0049:     # Randomly generate a 3x3 grid with symmetric pattern or not.
0050:     has_y_axis_symmetry = np.random.choice([True, False])
0051:     symmetry_type = "horizontal" if has_y_axis_symmetry else "not_symmetric"
0052:     density = random.choice([0.3, 0.4, 0.5, 0.6])
0053:     grid = random_sprite(n=3, m=3, density=density, color_palette=[Color.RED], symmetry=symmetry_type)
0054:     
0055:     # If the pattern is not symmetric, scatter some black pixels on the grid to make it not symmetric.
0056:     if not has_y_axis_symmetry:
0057:         # Randomly 40% colored pixels on the grid
0058:         target_density = 0.4
0059:         target_number_of_pixels = int(target_density * height * width)
0060:         for i in range(target_number_of_pixels):
0061:             r = np.random.randint(0, width)
0062:             c = np.random.randint(0, height)
0063:             grid[r, c] = Color.BLACK
0064: 
0065:     return grid
