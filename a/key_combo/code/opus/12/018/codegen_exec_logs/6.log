0014: def main(input_grid):
0015:     """
0016:     Fit two monochromatic puzzle pieces together into the tightest rectangular assembly.
0017: 
0018:     Input structure:
0019:     - The input is a black grid containing exactly two non-black monochromatic objects.
0020:     - Each object is a puzzle piece that may be translated but not rotated.
0021:     - The pieces come from a compact two-color object.
0022: 
0023:     Rule:
0024:     - Crop the two pieces from the input.
0025:     - Try all non-overlapping translations on a canvas large enough to hold both pieces.
0026:     - Return the placement whose cropped bounding box leaves the fewest black cells.
0027: 
0028:     Key insight:
0029:     - The reconstruction is the densest translation-only packing of the two pieces.
0030:     """
0031:     # Plan:
0032:     # 1. Detect the pieces
0033:     # 2. Consider different ways of placing them together
0034:     # 3. Pick the way which makes them the most tightly packed, meaning that there is as little empty pixels remaining as possible
0035: 
0036:     # 1. Extract puzzle pieces
0037:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
0038:     assert len(objects) == 2, "There should be exactly 2 objects"
0039:     sprites = []
