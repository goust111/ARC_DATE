0045:     width = max(sprite.shape[0] for sprite in sprites) + min(sprite.shape[0] for sprite in sprites)
0046:     height = max(sprite.shape[1] for sprite in sprites) + min(sprite.shape[1] for sprite in sprites)
0047:     output_grid = np.full((width, height), Color.BLACK)
0048: 
0049:     # 2. Try to fit the pieces together
0050:     possible_placements = [ (x1, x2, y1, y2)
0051:                            for x1 in range(width - sprites[0].shape[0] + 1)
0052:                            for x2 in range(width - sprites[1].shape[0] + 1)
0053:                            for y1 in range(height - sprites[0].shape[1] + 1)
0054:                            for y2 in range(height - sprites[1].shape[1] + 1) 
0055:                            if not collision(object1=sprites[0], object2=sprites[1], r1=x1, r2=x2, c1=y1, c2=y2) ]
0056:     
0057:     def score_placement(x1, x2, y1, y2):
0058:         # We are trying to make the puzzle pieces fit together perfectly
0059:         # Therefore, there shouldn't be very many unfilled (black) pixels remaining after we place the pieces
0060:         # So we are minimizing the number of black pixels
0061:         # Equivalently maximizing the negative number of black pixels
0062:         test_canvas = np.full_like(output_grid, Color.BLACK)
0063:         paste(test_canvas, sprites[0], x1, y1, transparent=Color.BLACK, clip=True)
0064:         paste(test_canvas, sprites[1], x2, y2, transparent=Color.BLACK, clip=True)
0065:         _b = bbox(test_canvas != Color.BLACK)
