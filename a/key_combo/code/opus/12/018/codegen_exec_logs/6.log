0016: def main(input_grid):
0017:     """
0018:     Connect two aligned colored pixels through a centered split-color hollow rectangle.
0019: 
0020:     Input structure:
0021:     - Two single pixels of different colors are aligned horizontally or vertically.
0022:     - The background is black.
0023:     - There is enough space between the pixels for the hollow rectangle bridge.
0024: 
0025:     Rule:
0026:     - Rotate vertical cases into a horizontal canonical form.
0027:     - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
0028:     - Paste it midway between the pixels and connect each pixel to the nearest side.
0029: 
0030:     Key insight:
0031:     - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
0032:     """
0033:     # Plan (from the original seed solver):
0034:     # 1. Parse the input
0035:     # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
0036:     # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
0037:     # 4. Place the rectangle in the middle of the two pixels
0038:     # 5. Draw lines to connect the original two pixels with the rectangle
0039:     # 6. Rotate the grid back if it was not originally horizontal
0040:     #
0041:     # Implementation note:
0042:     # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
0043:     #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
0044:     comps = find_components(
0045:         input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
0046:     )
0047:     if len(comps) != 2:
0048:         return input_grid.copy()
0049: 
0050:     p0 = tuple(map(int, comps[0]["coords"][0]))
0051:     p1 = tuple(map(int, comps[1]["coords"][0]))
0052: 
0053:     rotated = False
0054:     grid = input_grid
0055:     if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
0056:         grid = np.rot90(grid)
0057:         rotated = True
0058: 
0059:     comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
0060:     if len(comps) != 2:
0061:         out = grid.copy()
0062:         return np.rot90(out, k=-1) if rotated else out
0063: 
0064:     p0 = tuple(map(int, comps[0]["coords"][0]))
0065:     p1 = tuple(map(int, comps[1]["coords"][0]))
0066:     c0 = int(comps[0]["color"])
0067:     c1 = int(comps[1]["color"])
0068: 
0069:     # Should now be horizontally aligned
0070:     if p0[0] != p1[0]:
0071:         out = grid.copy()
0072:         return np.rot90(out, k=-1) if rotated else out
0073: 
0074:     # Sort left->right by column
0075:     if p0[1] <= p1[1]:
0076:         left_pos, right_pos = p0, p1
0077:         left_color, right_color = c0, c1
0078:     else:
0079:         left_pos, right_pos = p1, p0
0080:         left_color, right_color = c1, c0
0081: 
0082:     r = left_pos[0]
0083:     c_left = left_pos[1]
0084:     c_right = right_pos[1]
0085: 
0086:     output_grid = grid.copy()
0087: 
0088:     # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
0089:     # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
0090:     rect_h, rect_w = 5, 4
0091:     rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
0092:     rect[:, 0] = left_color
0093:     rect[:, -1] = right_color
0094:     rect[0, : rect_w // 2] = left_color
0095:     rect[0, rect_w // 2 :] = right_color
0096:     rect[-1, : rect_w // 2] = left_color
0097:     rect[-1, rect_w // 2 :] = right_color
0098: 
