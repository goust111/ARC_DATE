+def _vertical_symmetric(logical: np.ndarray, r: int, c: int) -> bool:
+    rows, cols = logical.shape
+    r0 = max(0, r - 1)
+    r1 = min(rows - 1, r + 2)
+    c0 = max(0, c - 1)
+    c1 = min(cols - 1, c + 1)
+    mirror_sum = 2 * r + 1
+
+    for rr in range(r0, r1 + 1):
+        mr = mirror_sum - rr
+        if not (r0 <= mr <= r1):
+            return False
+        for cc in range(c0, c1 + 1):
