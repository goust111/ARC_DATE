+
+def _horizontal_symmetric(logical: np.ndarray, r: int, c: int) -> bool:
+    rows, cols = logical.shape
+    r0 = max(0, r - 1)
+    r1 = min(rows - 1, r + 1)
+    c0 = max(0, c - 1)
+    c1 = min(cols - 1, c + 2)
+    mirror_sum = 2 * c + 1
+
+    for rr in range(r0, r1 + 1):
+        for cc in range(c0, c1 + 1):
+            mc = mirror_sum - cc
+            if not (c0 <= mc <= c1):
+                return False
+            if logical[rr, cc] != logical[rr, mc]:
