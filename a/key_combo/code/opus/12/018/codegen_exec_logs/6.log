+    target_points = int(np.random.randint(7, 11))
+    empty = [
+        (r, c)
+        for r in range(rows)
+        for c in range(cols)
+        if logical[r, c] == BACKGROUND and (r, c) not in protected
+    ]
+    np.random.shuffle(empty)
