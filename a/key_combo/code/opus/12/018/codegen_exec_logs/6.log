+def _apply_seed(logical: np.ndarray, seed: dict[str, object], palette: tuple[int, ...]) -> None:
+    kind = str(seed["kind"])
+    r, c = tuple(seed["anchor"])
+    pair_color = int(np.random.choice(palette))
+
+    if kind == "ah":
+        logical[r, c] = pair_color
+        logical[r, c + 1] = pair_color
