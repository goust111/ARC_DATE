+def _seed_positions(rect_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect_bbox
+    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
