    max_width=GEN_PATCH_WIDTH_RANGE[1],
):
    if desired_notches is None:
        notch_count = random.choices(GEN_NOTCH_COUNTS, weights=GEN_NOTCH_WEIGHTS)[0]
    else:
        notch_count = int(desired_notches)
