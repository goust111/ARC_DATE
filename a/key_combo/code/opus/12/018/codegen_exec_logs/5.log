+def _choose_counts(area: int) -> tuple[int, int, int]:
+    for _ in range(200):
+        cuts = sorted(random.sample(range(1, area), 2))
+        a = cuts[0]
+        b = cuts[1] - cuts[0]
+        c = area - cuts[1]
+        counts = tuple(sorted((a, b, c)))
+        if counts[0] >= 1 and len(set(counts)) == 3:
+            return counts
