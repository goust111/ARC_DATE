+        inner_w = random.randint(INTERIOR_MIN, INTERIOR_MAX)
+        rect_h = inner_h + 2
+        rect_w = inner_w + 2
+        pat_h = random.randint(PATTERN_MIN, PATTERN_MAX)
+        pat_w = random.randint(PATTERN_MIN, PATTERN_MAX)
+        gap = random.randint(PATTERN_GAP_MIN, PATTERN_GAP_MAX)
