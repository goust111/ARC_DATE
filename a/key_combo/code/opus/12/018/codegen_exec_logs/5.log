+            {
+                "index": idx,
+                "group_r": gr,
+                "group_c": gc,
+                "rect_bbox": rect_bbox,
+                "pattern_bbox": pattern_bbox,
+                "group_bbox": group_bbox,
+                **spec,
+            }
+        )
