+        if orientation == "above":
+            group_h = pat_h + gap + rect_h
+            group_w = rect_w
+            offset = random.randint(0, rect_w - pat_w)
+        else:
+            group_h = rect_h
+            group_w = pat_w + gap + rect_w
+            offset = random.randint(0, rect_h - pat_h)
