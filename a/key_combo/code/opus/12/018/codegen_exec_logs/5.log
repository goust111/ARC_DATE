    a_in_b = ar0 >= br0 and ac0 >= bc0 and ar1 <= br1 and ac1 <= bc1
    b_in_a = br0 >= ar0 and bc0 >= ac0 and br1 <= ar1 and bc1 <= ac1
    return a_in_b or b_in_a


