+
+BACKGROUND = 0
+MARKER = 7
+PALETTE = [1, 2, 3, 4, 5, 6, 8, 9]
+
+GRID_MIN = 20
+GRID_MAX = 28
+RECT_COUNT_CHOICES = [2, 3]
+INTERIOR_MIN = 6
+INTERIOR_MAX = 8
+PATTERN_MIN = 3
+PATTERN_MAX = 5
+PATTERN_GAP_MIN = 1
+PATTERN_GAP_MAX = 3
+GROUP_GAP = 2
+GEN_RETRIES = 500
+
+
