+    return mask
+
+
+def _validate_input(grid: np.ndarray, frames: list[dict], gaps: list[int]) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    if any(gap < 3 for gap in gaps):
+        return False
