+    inner_w = random.choice(inner_w_choices)
+    outer_h = inner_h + 2 * inset_total
+    outer_w = inner_w + 2 * inset_total
+
+    top_margin = random.randint(1, 2)
+    bottom_margin = random.randint(1, 2)
+    left_margin = random.randint(1, 2)
