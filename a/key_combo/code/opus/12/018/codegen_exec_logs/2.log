    top_margin = random.randint(0, 3)
    bottom_margin = random.randint(0, 3)
    left_margin = random.randint(0, 3)
    right_margin = random.randint(0, 3)
    grid_h = outer_h + top_margin + bottom_margin
    grid_w = outer_w + left_margin + right_margin
    if grid_h > 30 or grid_w > 30:
        raise AssertionError("sampled grid exceeds ARC size bound")

    outer_r0 = top_margin
    outer_c0 = left_margin
    bboxes = []
    inset = 0
    for depth in range(count):
        bboxes.append(
            (
                outer_r0 + inset,
