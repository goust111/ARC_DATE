+            return False
+        if want["bbox"] != got["bbox"]:
+            return False
+        if want["notch_side"] != got["notch_side"]:
+            return False
+        if want["depth"] != got["depth"]:
+            return False
+    return True
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray]:
+    grid_h, grid_w, bboxes, gaps = _sample_geometry()
+    count = len(bboxes)
