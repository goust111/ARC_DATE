                outer_c0 + outer_w - inset - 1,
            )
        )
        if depth + 1 < count:
            inset += gaps[depth]
    return grid_h, grid_w, bboxes, gaps


def _paint_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int, notch_side: str) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    mask = _frame_mask(r1 - r0 + 1, c1 - c0 + 1, notch_side)
