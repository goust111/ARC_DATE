+    else:
+        ws = _split_sizes(width - 2, 3, MIN_REGION_WIDTH, rng)
+        wall1 = ws[0]
+        wall2 = ws[0] + 1 + ws[1]
+        grid[:, wall1] = WALL
+        grid[:, wall2] = WALL
+        regions = [
+            (0, 0, height - 1, ws[0] - 1),
+            (0, wall1 + 1, height - 1, wall1 + ws[1]),
+            (0, wall2 + 1, height - 1, width - 1),
+        ]
+    return grid, regions
+
+
+def _choose_palette_pair(
+    rng: random.Random,
+    template_pair: tuple[int, int],
