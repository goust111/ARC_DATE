+    out = g.copy()
+    for coords in _components(g != WALL):
+        r0, c0, r1, c1 = _bbox(coords)
+        assert r1 - r0 + 1 >= 3, "region must have at least template, prefix, and fill rows"
+        template = g[r0, c0 : c1 + 1]
