+def _build_regions(
+    branch: str, height: int, width: int, rng: random.Random
+) -> tuple[np.ndarray, list[tuple[int, int, int, int]]]:
+    grid = np.full((height, width), BG, dtype=int)
+    regions: list[tuple[int, int, int, int]] = []
+
+    if branch == "quad":
