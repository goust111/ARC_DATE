+    for pts in comps:
+        hr0, hc0, hr1, hc1 = bbox_coords(pts)
+        assert 0 < hr0 and hr1 < window.shape[0] - 1
+        assert 0 < hc0 and hc1 < window.shape[1] - 1
+        patch = window[hr0 : hr1 + 1, hc0 : hc1 + 1]
+        assert np.all(patch != RED), "hole bbox must be fully non-red"
