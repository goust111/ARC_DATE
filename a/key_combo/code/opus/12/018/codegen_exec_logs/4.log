+        elif bc1 + 2 == ac0 and _intervals_overlap(ar0, ar1, br0, br1):
+            matches.append(i)
+        elif ar1 + 2 == br0 and _intervals_overlap(ac0, ac1, bc0, bc1):
+            matches.append(i)
+        elif br1 + 2 == ar0 and _intervals_overlap(ac0, ac1, bc0, bc1):
