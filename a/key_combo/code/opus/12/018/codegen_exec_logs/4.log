+        right = rects[2]
+        left_h = left[0][0] + gap_a + left[1][0]
+        left_w = max(left[0][1], left[1][1])
+        inner_h = margin_t + max(left_h, right[0]) + margin_b
+        inner_w = margin_l + left_w + gap_b + right[1] + margin_r
