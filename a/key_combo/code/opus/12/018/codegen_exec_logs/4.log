+    specs = []
+    for i in range(count):
+        width = widths[i]
+        height = random.choice([3, 4, 5] if width == 1 else [2, 3])
+        marker_cells = [(r, c) for r in range(height) for c in range(width)]
+        marker_pos = random.choice(marker_cells)
+        specs.append(
+            {
+                "body_h": height,
+                "body_w": width,
+                "anchor": width,
+                "scale": scales[i],
