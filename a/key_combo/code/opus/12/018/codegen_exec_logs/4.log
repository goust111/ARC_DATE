+                nr = int(r) + dr
+                nc = int(c) + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    forbidden[nr, nc] = True
+
+
+def _place_patch(grid: np.ndarray, forbidden: np.ndarray, patch: np.ndarray) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    nz = np.argwhere(patch != BG)
+    for _ in range(300):
+        r0 = random.randint(0, h - ph)
+        c0 = random.randint(0, w - pw)
