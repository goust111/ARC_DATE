+    top = random.randint(3, min(6, extra_h - 3))
+    left = random.randint(3, min(6, extra_w - 3))
+    bottom = random.randint(3, min(6, extra_h - top))
+    right = random.randint(3, min(6, extra_w - left))
+    H = red_h + top + bottom
+    W = red_w + left + right
