+        pairs = [(a, b) for a in range(len(sources)) for b in range(len(sources)) if a != b]
+        random.shuffle(pairs)
+        placed = False
+        for owner, witness in pairs:
+            shape = sources[owner]["shape"]
+            sh, sw = _shape_dims(shape)
+            if c0 + sw - 1 >= w - 1:
