+        pass
+
+    witness_exists = any(
+        d["id"] not in activated and contacts[d["id"]]["mismatched"]
+        for d in deflectors
+    )
+    if not witness_exists:
+        return False
+
+    if np.array_equal(out, grid):
+        return False
+
+    return True
