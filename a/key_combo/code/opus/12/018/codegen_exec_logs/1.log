+
+def _shape_library() -> list[tuple[tuple[int, int], ...]]:
+    shapes = []
+    seen = set()
+    cells = [(r, c) for r in range(3) for c in range(3)]
+    for area in range(3, 6):
+        for combo in itertools.combinations(cells, area):
