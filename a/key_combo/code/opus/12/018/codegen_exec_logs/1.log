+    return [top for top in range(1, h - shape_h) if top <= row <= top + shape_h - 1]
+
+
+def _place_deflectors(grid: np.ndarray, sources: list[dict], active_counts: list[int], inactive_count: int) -> tuple[np.ndarray, list[dict]] | None:
