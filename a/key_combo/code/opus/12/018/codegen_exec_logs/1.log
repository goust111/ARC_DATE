+            witness_row = snapshot[witness]
+            owner_row = snapshot[owner]
+            tops = _top_rows_for_hit(witness_row, sh, h)
+            tops = [top for top in tops if not (top <= owner_row <= top + sh - 1)]
+            random.shuffle(tops)
