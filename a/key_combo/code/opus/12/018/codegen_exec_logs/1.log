    return out


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(GRID_MIN, GRID_MAX)
    W = random.randint(GRID_MIN, GRID_MAX)
    frame_r = random.choice(_frame_origins_for_axis(H))
    frame_c = random.choice(_frame_origins_for_axis(W))

    target_r = frame_r + 1
    target_c = frame_c + 1
