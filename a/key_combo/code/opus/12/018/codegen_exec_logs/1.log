+    assert 3 <= len(deflectors) <= 5, "expected 3-5 deflectors"
+    return {
+        "sources": sorted(sources, key=lambda x: x["row"]),
+        "deflectors": sorted(deflectors, key=lambda x: (x["bbox"][1], x["bbox"][0])),
