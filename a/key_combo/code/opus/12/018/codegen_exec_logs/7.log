+TILE_H_CHOICES = [4, 5]
+TILE_W_CHOICES = [4, 5]
+GAP_CHOICES = [2, 3, 4, 5]
+MARGIN_CHOICES = [0, 1, 2, 3, 4]
+NON_SPECIAL_COLORS = [1, 2, 3, 4, 5, 6, 7, 8]
+MAX_GENERATION_ATTEMPTS = 400
