+
+        cover_order = active_frames[:]
+        random.shuffle(cover_order)
+        ok = True
+        for idx in cover_order:
+            options = [r for r in placed_frames[idx]["seed_rows"] if r not in used_rows]
+            if not options:
+                ok = False
