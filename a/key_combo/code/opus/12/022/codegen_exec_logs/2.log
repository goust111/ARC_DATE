+
+
+def _seed_rows_for_frame(frame: dict[str, int], frame_grid: np.ndarray) -> list[int]:
+    rows: list[int] = []
+    r0, c0, r1 = int(frame["r0"]), int(frame["c0"]), int(frame["r1"])
