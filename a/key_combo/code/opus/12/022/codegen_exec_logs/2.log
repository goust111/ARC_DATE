+def _choose_seed_assignments(placed_frames: list[dict[str, int]], seed_count: int) -> list[tuple[int, int]] | None:
+    frame_indices = list(range(len(placed_frames)))
+    max_active = min(seed_count, len(placed_frames) - 1)
+    if max_active <= 0:
