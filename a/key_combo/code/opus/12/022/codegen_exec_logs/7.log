+
+def _quadrant(marker: tuple[int, int], frame_box: tuple[int, int, int, int]) -> str:
+    r, c = marker
+    r0, c0, r1, c1 = frame_box
+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
+    if c > center_c and r < center_r:
+        return "ru"
+    if c < center_c and r > center_r:
+        return "ld"
+    if c > center_c and r > center_r:
+        return "rd"
+    return "lu"
