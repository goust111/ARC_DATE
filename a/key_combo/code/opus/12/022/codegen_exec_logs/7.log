+def _transform_for_quadrant(patch: np.ndarray, quadrant: str) -> np.ndarray:
+    if quadrant == "ru":
+        return np.fliplr(patch)
+    if quadrant == "ld":
+        return np.flipud(patch)
+    if quadrant == "rd":
+        return np.flipud(np.fliplr(patch))
+    return patch
