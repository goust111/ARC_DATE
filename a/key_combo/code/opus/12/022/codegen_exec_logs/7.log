+
+def _full_bbox(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _generate_mask(size: int) -> np.ndarray:
+    anchor_r, anchor_c = _anchor((size, size))
+    for _ in range(400):
