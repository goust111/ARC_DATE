+        variants = {
+            patch.tobytes(),
+            np.fliplr(patch).tobytes(),
+            np.flipud(patch).tobytes(),
+            np.flipud(np.fliplr(patch)).tobytes(),
+        }
+        if len(variants) != 4:
+            continue
+        return patch
