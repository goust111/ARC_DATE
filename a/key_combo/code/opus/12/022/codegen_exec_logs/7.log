+    frame_patch = g[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all(frame_patch[0, :] == RED)
+    assert np.all(frame_patch[-1, :] == RED)
+    assert np.all(frame_patch[:, 0] == RED)
+    assert np.all(frame_patch[:, -1] == RED)
+
+    pattern_mask = (g != BLACK) & (g != RED) & (g != GRAY)
+    pattern_box = _bbox(pattern_mask)
