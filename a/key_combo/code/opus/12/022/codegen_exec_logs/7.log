+    h, w = grid_shape
+    ph, pw = pattern_shape
+    ar, ac = _anchor(pattern_shape)
+    fr0, fc0, fr1, fc1 = frame_box
+    candidates = []
+    if quadrant == "lu":
+        row_range = range(0, fr0 - gap - ph + 1)
+        col_range = range(0, fc0 - gap - pw + 1)
+    elif quadrant == "ru":
+        row_range = range(0, fr0 - gap - ph + 1)
+        col_range = range(fc1 + gap + 1, w - pw + 1)
+    elif quadrant == "ld":
+        row_range = range(fr1 + gap + 1, h - ph + 1)
+        col_range = range(0, fc0 - gap - pw + 1)
+    else:
