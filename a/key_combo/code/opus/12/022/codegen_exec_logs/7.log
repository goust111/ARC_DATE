+    g = np.asarray(grid, dtype=int)
+    red_box = _bbox(g == RED)
+    assert red_box is not None, "expected one red frame"
+    r0, c0, r1, c1 = red_box
+    assert r1 - r0 >= 3 and c1 - c0 >= 3, "frame must have an interior"
