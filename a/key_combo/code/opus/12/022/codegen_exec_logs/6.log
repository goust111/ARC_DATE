+    if not np.array_equal(expected, _overlay_panels(transformed_panels)):
+        return None
+    try:
+        solved = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    if np.array_equal(inp[: height, :], expected):
+        return None
+    return inp
