+    grid[h, :] = SEPARATOR
+    grid[h + 1 : 2 * h + 1, :] = panels[1]
+    grid[2 * h + 1, :] = SEPARATOR
+    grid[2 * h + 2 :, :] = panels[2]
+    return grid
