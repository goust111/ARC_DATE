+    reserved_targets = {(int(row), int(LANE_MAP[color])) for row, color in edges}
+    mask = transformed != PANEL_BG
+    for r, c in np.argwhere(mask):
+        coord = (int(r), int(c))
+        if coord not in reserved_targets:
+            inp[coord] = transformed[coord]
