  grid: 10x10, background black (0)
  src: 7-8 colored pixels, all in column 0; 2-3 rows are empty (background)
  colors: exactly {teal(8), red(2), yellow(4), green(3)}, each appearing 1-3 times, all 4 present
  lane_mapping: teal->col1, red->col2, yellow->col3, green->col4
  output: erase column 0, place each pixel at (same_row, lane_column_for_its_color)
  constraints:
