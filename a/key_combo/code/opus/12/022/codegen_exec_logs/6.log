+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+SEPARATOR = 2
+PANEL_BG = 5
+LANE_MAP = {8: 1, 1: 2, 4: 3, 3: 4}
+LANE_COLORS = tuple(LANE_MAP)
+MARK_COLORS = (1, 3, 4, 6, 7, 8, 9)
