from __future__ import annotations
from collections import Counter, defaultdict
import numpy as np
from scipy.ndimage import label
from arc_utils import STRUCT4, bbox_coords, colors_present, components_mask, paste
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Move bordered containers toward same-colored destination markers, charging gray cells to orange.

    Input structure:
    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.
    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.

    Rule:
    - Each container translates toward its destination along the head-to-dest axis.
    - Steps = min(head-to-dest distance, number of gray interior cells).
    - Gray cells become orange from the head-facing side inward, one per step.

    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    BORDER = 0
    GREY = 5
    FILL = 7
    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    # True background is dominant non-border color (border can dominate in some cases).
    cnt = Counter(map(int, g.flatten()))
    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))

    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):
        for c in range(c0, c1 + 1):
            yield (r0, c)
            yield (r1, c)
        for r in range(r0 + 1, r1):
            yield (r, c0)
            yield (r, c1)

    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---
    containers = []
    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):
        if pts.size == 0:
            continue
        ir0, ic0, ir1, ic1 = bbox_coords(pts)
        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)
        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:
            continue
        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):
            continue
        inner = g[r0 + 1 : r1, c0 + 1 : c1]
        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):
            continue
        containers.append({"box": (r0, c0, r1, c1)})

    assert not (not containers)

    # head + destination are in some non-bg, non-border color (not GREY/FILL)
    out = g.copy()

    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]

    # Precompute components for each head color.
    comp_by_color: dict[int, list[dict]] = defaultdict(list)
    for col in all_head_colors:
        labc, nc = label(g == int(col), structure=STRUCT4)
        for k in range(1, int(nc) + 1):
            coords = np.argwhere(labc == int(k))
            if coords.size == 0:
                continue
            r0, c0, r1, c1 = bbox_coords(coords)
            pts = {(int(r), int(c)) for r, c in coords}
            shape = {(int(r - r0), int(c - c0)) for r, c in pts}
            comp_by_color[int(col)].append({"pts": pts, "shape": shape, "tl": (int(r0), int(c0))})

    def pick_head_for_container(box_):
        r0, c0, r1, c1 = box_
        head_seeds = []
        for r, c in rect_border_coords(r0, c0, r1, c1):
            for dr, dc in DIR4:
                rr, cc = r + dr, c + dc
                if 0 <= rr < H and 0 <= cc < W:
                    val = int(g[rr, cc])
                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):
                        head_seeds.append((rr, cc, val))
        if not head_seeds:
            return None

        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])
        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}
        cands = comp_by_color.get(hc, [])
        comp0 = None
        for comp in cands:
            if comp["pts"] & seed_pts:
                comp0 = comp
                break
        if comp0 is None:
            return None

        # Split head vs destination even if same-color pixels touch:
        # head pixels are those with minimal manhattan distance to this container border.
        border_pts = list(rect_border_coords(r0, c0, r1, c1))
        best_d = None
        dist = {}
        for pr, pc in comp0["pts"]:
            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)
            dist[(int(pr), int(pc))] = int(d)
            if best_d is None or d < best_d:
                best_d = int(d)
        if best_d is None:
            return None
        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}

        # direction from head bbox relative to container box
        coords = np.array(list(head_pts), dtype=int)
        hr0, hc0, hr1, hc1 = bbox_coords(coords)
        if hc1 < c0:
            direction = (0, -1)
        elif hc0 > c1:
            direction = (0, 1)
        elif hr1 < r0:
            direction = (-1, 0)
        elif hr0 > r1:
            direction = (1, 0)
        else:
            direction = (0, 0)

        # normalized head shape + top-left
        r00, c00 = int(hr0), int(hc0)
        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}
        return {
            "color": hc,
            "head_pts": head_pts,
            "head_shape": head_shape,
            "head_tl": (r00, c00),
            "comp_pts": set(comp0["pts"]),
            "dir": direction,
        }

    for cont in containers:
        box_ = cont["box"]
        r0, c0, r1, c1 = box_

        head_info = pick_head_for_container(box_)
        if head_info is None:
            continue
        hc = int(head_info["color"])
        head_pts = set(head_info["head_pts"])
        head_shape = head_info["head_shape"]
        head_tl = head_info["head_tl"]
        comp_pts = set(head_info["comp_pts"])
        direction = head_info["dir"]
        if direction == (0, 0):
            continue

        # destination candidates
        dests = []
        for d in comp_by_color.get(hc, []):
            if d["shape"] != head_shape:
                continue
            if d["pts"] == comp_pts:
                continue
            dests.append(d)

        # add split-from-same-component destinations (when dest touches head by color)
        rem = comp_pts - head_pts
        if rem:
            mask_rem = np.zeros((H, W), dtype=bool)
            for rr, cc in rem:
                mask_rem[int(rr), int(cc)] = True
            labr, nr = label(mask_rem, structure=STRUCT4)
            for k in range(1, int(nr) + 1):
                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}
                if not pts:
                    continue
                # reject if adjacent to BORDER
                adj = False
                for r, c in pts:
                    for dr, dc in DIR4:
                        rr, cc = int(r + dr), int(c + dc)
                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):
                            adj = True
                            break
                    if adj:
                        break
                if adj:
                    continue
                rs = [r for r, _c in pts]
                cs = [c for _r, c in pts]
                r00, c00 = int(min(rs)), int(min(cs))
                shp = {(int(r - r00), int(c - c00)) for r, c in pts}
                if shp != head_shape:
                    continue
                dests.append({"pts": pts, "shape": shp, "tl": (r00, c00)})

        if not dests:
            continue

        best = None
        best_dest = None
        for d in dests:
            tr0 = int(d["tl"][0] - head_tl[0])
            tc0 = int(d["tl"][1] - head_tl[1])
            if direction[0] != 0 and tc0 != 0:
                continue
            if direction[1] != 0 and tr0 != 0:
                continue
            if direction[0] == 1 and tr0 <= 0:
                continue
            if direction[0] == -1 and tr0 >= 0:
                continue
            if direction[1] == 1 and tc0 <= 0:
                continue
            if direction[1] == -1 and tc0 >= 0:
                continue
            dist = abs(tr0) + abs(tc0)
            if best is None or dist < best:
                best = dist
                best_dest = d
        if best_dest is None:
            continue

        # translation to overlap head onto destination, capped by number of GREY cells
        tr0 = int(best_dest["tl"][0] - head_tl[0])
        tc0 = int(best_dest["tl"][1] - head_tl[1])
        steps = abs(tr0) + abs(tc0)

        inner = g[r0 + 1 : r1, c0 + 1 : c1]
        grey_coords = [
            (int(r0 + 1 + rr), int(c0 + 1 + cc))
            for rr in range(inner.shape[0])
            for cc in range(inner.shape[1])
            if int(inner[rr, cc]) == GREY
        ]
        steps = min(int(steps), int(len(grey_coords)))

        dr, dc = direction
        tr = int(dr * steps)
        tc = int(dc * steps)

        # choose which greys to fill in order from head side inward
        if direction == (0, 1):
            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))
        elif direction == (0, -1):
            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))
        elif direction == (1, 0):
            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))
        else:  # (-1,0)
            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))
        to_fill = set(order[:steps])

        # erase original container rect and original head pixels (destination stays)
        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
        for r, c in head_pts:
            if int(out[int(r), int(c)]) == int(hc):
                out[int(r), int(c)] = int(bg)

from collections import Counter

import numpy as np
import random as random
from arc_utils import find_components as find_components


def main(grid: np.ndarray) -> np.ndarray:
    """Complete the dominant-color object by adding its left-right mirror image.

    Input structure
    A rectangular grid contains one uniquely most frequent color forming the main
    foreground object, with other colors acting as clutter/noise.

    Rule
    Reflect every pixel of the dominant color across the vertical centerline of
    the grid and recolor the reflected cells with that same dominant color.

    Key insight
    The noisy cells are exactly the missing counterpart pixels needed to make the
    dominant-color mask horizontally symmetric.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    counts = Counter(map(int, g.flat))
    ranked = counts.most_common()
    assert len(ranked) >= 2
    main_color, main_count = ranked[0]
    assert main_count > ranked[1][1]

    out = g.copy()
    rows, cols = np.where(g == main_color)
    out[rows, g.shape[1] - 1 - cols] = main_color
    return out

# --------------- generator (o5x) ---------------

# Canvas/mirror geometry.
GRID_SIZE = 10
PAIR_COLS = GRID_SIZE // 2
LEFT_CENTER_COL, RIGHT_CENTER_COL = PAIR_COLS - 1, PAIR_COLS
BACKGROUND_SENTINEL = -1
# Palette bounds.
DOMINANT_COLORS = range(1, 10)
BACKGROUND_COLOR, NONDOMINANT_NONZERO_COUNT, COLOR_COUNT = 0, 2, 10
# Blob/noise validation bounds.
INPUT_DOMINANT_COUNT_RANGE = (30, 34)
BLOB_SIZE_RANGE, NOISE_COUNT_RANGE, ROW_SPAN_RANGE = (36, 48), (6, 14), (6, 8)
MAX_RIGHT_NOISE_FRACTION, MIN_DOMINANCE_GAP = 0.58, 3
# Retry and adjacency controls.
GENERATION_RETRIES = 300
ORTHOGONAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_choose_palette():
    _gen_dominant = random.choice(DOMINANT_COLORS)
    _gen_other_pool = [c for c in DOMINANT_COLORS if c != _gen_dominant]
    _gen_nondom = [BACKGROUND_COLOR] + random.sample(_gen_other_pool, NONDOMINANT_NONZERO_COUNT)
    random.shuffle(_gen_nondom)
    return _gen_dominant, _gen_nondom


def _gen_choose_blob_parameters():
    _gen_input_d_count = random.randint(*INPUT_DOMINANT_COUNT_RANGE)
    _gen_min_blob = max(BLOB_SIZE_RANGE[0], _gen_input_d_count + NOISE_COUNT_RANGE[0])
    _gen_max_blob = min(BLOB_SIZE_RANGE[1], _gen_input_d_count + NOISE_COUNT_RANGE[1])
    _gen_valid_blob_sizes = [
        n
        for n in range(_gen_min_blob, _gen_max_blob + 1)
        if n % 2 == 0
        and (n - _gen_input_d_count) / (n // 2) <= MAX_RIGHT_NOISE_FRACTION
    ]
    _gen_blob_size = random.choice(_gen_valid_blob_sizes)
    _gen_span = random.randint(*ROW_SPAN_RANGE)
    _gen_top = random.randint(0, GRID_SIZE - _gen_span)
    return _gen_input_d_count, _gen_blob_size // 2, _gen_blob_size - _gen_input_d_count, _gen_span, _gen_top


def _gen_connected_pair_mask(_gen_rows, _gen_pair_count):
    """Grow a connected mask in half-grid pair coordinates."""
    _gen_mask = np.zeros((_gen_rows, PAIR_COLS), dtype=bool)
    _gen_mask[:, 0] = True
    _gen_active = {(r, 0) for r in range(_gen_rows)}
    _gen_frontier = {(r, 1) for r in range(_gen_rows)}

    while len(_gen_active) < _gen_pair_count:
        _gen_choice = random.choice(tuple(_gen_frontier))
        _gen_frontier.remove(_gen_choice)
        _gen_r, _gen_p = _gen_choice
        _gen_mask[_gen_r, _gen_p] = True
        _gen_active.add(_gen_choice)
        for _gen_dr, _gen_dp in ORTHOGONAL_STEPS:
            _gen_nr = _gen_r + _gen_dr
            _gen_np = _gen_p + _gen_dp
            if 0 <= _gen_nr < _gen_rows and 0 <= _gen_np < PAIR_COLS:
                if not _gen_mask[_gen_nr, _gen_np]:
                    _gen_frontier.add((_gen_nr, _gen_np))
    return _gen_mask


def _gen_reflect_pair_mask(_gen_pair_mask, _gen_top):
    """Expand half-grid pair coordinates into a full LR-symmetric blob mask."""
    _gen_blob = np.zeros((GRID_SIZE, GRID_SIZE), dtype=bool)
    _gen_right_cells = []
    for _gen_rr in range(_gen_pair_mask.shape[0]):
        _gen_r = _gen_top + _gen_rr
        for _gen_p in range(PAIR_COLS):
            if _gen_pair_mask[_gen_rr, _gen_p]:
                _gen_left = LEFT_CENTER_COL - _gen_p
                _gen_right = RIGHT_CENTER_COL + _gen_p
                _gen_blob[_gen_r, _gen_left] = True
                _gen_blob[_gen_r, _gen_right] = True
                _gen_right_cells.append((_gen_r, _gen_right))
    return _gen_blob, _gen_right_cells


def _gen_balanced_values(_gen_colors, _gen_count):
    _gen_order = list(_gen_colors)
    random.shuffle(_gen_order)
    _gen_base = _gen_count // len(_gen_order)
    _gen_extra = _gen_count % len(_gen_order)
    _gen_values = []
    for _gen_i, _gen_color in enumerate(_gen_order):
        _gen_values.extend([_gen_color] * (_gen_base + (_gen_i < _gen_extra)))
    random.shuffle(_gen_values)
    return _gen_values


def _gen_build_grids(_gen_blob, _gen_right_cells, _gen_noise_count, _gen_dominant, _gen_nondom):
    """Render output and input grids while preserving background/noise value order."""
    _gen_noise_cells = set(random.sample(_gen_right_cells, _gen_noise_count))
    _gen_out = np.full((GRID_SIZE, GRID_SIZE), _gen_dominant, dtype=int)
    _gen_inp = _gen_out.copy()

    _gen_out[~_gen_blob] = BACKGROUND_SENTINEL
    _gen_inp[~_gen_blob] = BACKGROUND_SENTINEL
    _gen_positions = [(int(_gen_r), int(_gen_c), True) for _gen_r, _gen_c in np.argwhere(~_gen_blob)]
    for _gen_r, _gen_c in _gen_noise_cells:
        _gen_positions.append((_gen_r, _gen_c, False))

    _gen_values = _gen_balanced_values(_gen_nondom, len(_gen_positions))
    for (_gen_r, _gen_c, _gen_is_background), _gen_value in zip(_gen_positions, _gen_values):
        _gen_inp[_gen_r, _gen_c] = _gen_value
        if _gen_is_background:
            _gen_out[_gen_r, _gen_c] = _gen_value

    return _gen_inp, _gen_out


def _gen_is_valid_instance(_gen_inp, _gen_out, _gen_dominant, _gen_input_d_count):
    _gen_counts = np.bincount(_gen_inp.ravel(), minlength=COLOR_COUNT)
    _gen_other_max = max(_gen_counts[c] for c in range(COLOR_COUNT) if c != _gen_dominant)
    if _gen_counts[_gen_dominant] != _gen_input_d_count:
        return False
    if _gen_counts[_gen_dominant] - _gen_other_max < MIN_DOMINANCE_GAP:
        return False
    if np.array_equal(_gen_inp == _gen_dominant, _gen_out == _gen_dominant):
        return False
    _gen_components = [
        comp
        for comp in find_components(
            _gen_out, bg=BACKGROUND_SENTINEL, connectivity=4, monochromatic=True,
            colors=[_gen_dominant], return_format="dict",
        )
        if comp["color"] == _gen_dominant
    ]
    return len(_gen_components) == 1 and np.array_equal(main(_gen_inp), _gen_out)


def _gen_attempt() -> np.ndarray | None:
    _gen_dominant, _gen_nondom = _gen_choose_palette()
    _gen_input_d_count, _gen_pair_count, _gen_noise_count, _gen_span, _gen_top = _gen_choose_blob_parameters()
    _gen_pair_mask = _gen_connected_pair_mask(_gen_span, _gen_pair_count)
    _gen_blob, _gen_right_cells = _gen_reflect_pair_mask(_gen_pair_mask, _gen_top)
    _gen_inp, _gen_out = _gen_build_grids(_gen_blob, _gen_right_cells, _gen_noise_count, _gen_dominant, _gen_nondom)
    if not _gen_is_valid_instance(_gen_inp, _gen_out, _gen_dominant, _gen_input_d_count):
        return None
    return _gen_inp


def generate_input() -> np.ndarray:
    for _gen_attempt_i in range(GENERATION_RETRIES):
        _gen_grid = _gen_attempt()
        if _gen_grid is not None:
            return _gen_grid
    raise RuntimeError("failed to generate c35c1b4c input")
from __future__ import annotations
from collections import Counter

import numpy as np

from arc_utils import bbox, colors_present, get_bg, label_mask


def _unique_most_common(grid: np.ndarray, colors: list[int]) -> int:
    counts = Counter(map(int, grid.ravel()))
    best_count = max(counts[c] for c in colors)
    best = [c for c in colors if counts[c] == best_count]
    assert len(best) == 1
    return int(best[0])


def main(grid: np.ndarray) -> np.ndarray:
    """Tile each rectangular non-wall cavity with the colored seed pattern it already contains.

    Input structure
    - The dominant color forms solid walls around one or more rectangular cavities.
    - A unique most common non-wall color is the empty cavity color.
    - Each cavity contains exactly one other color, arranged as one copy of a repeat tile.

    Rule
    - For each 4-connected non-wall cavity, take the bbox of its seed color as the tile.
    - Repeat that tile across the entire cavity, preserving the phase set by the seed's current position.
    - Leave wall cells unchanged and leave tile-empty positions as the empty cavity color.

    Key insight
    - The colored pixels are not moved objects; they are one visible instance of a periodic mask that fills its containing rectangle.
    """
    g = np.asarray(grid, dtype=int)
    wall = get_bg(g)
    non_wall_colors = colors_present(g, exclude={wall})
    assert len(non_wall_colors) >= 2
    empty = _unique_most_common(g, non_wall_colors)

    out = g.copy()
    labels, n_regions = label_mask(g != wall, connectivity=4)
    assert n_regions >= 1

    for region_id in range(1, n_regions + 1):
        region_mask = labels == region_id
        region_bbox = bbox(region_mask)
        assert region_bbox is not None
        r0, c0, r1, c1 = region_bbox
        assert region_mask[r0 : r1 + 1, c0 : c1 + 1].all()

        region_colors = set(map(int, g[region_mask]))
        assert empty in region_colors
        seed_colors = region_colors - {empty}
        assert len(seed_colors) == 1
        seed_color = seed_colors.pop()

        seed_bbox = bbox((g == seed_color) & region_mask)
        assert seed_bbox is not None
        sr0, sc0, sr1, sc1 = seed_bbox
        tile = g[sr0 : sr1 + 1, sc0 : sc1 + 1]
        assert set(map(int, tile.ravel())) <= {empty, seed_color}

        tile_h, tile_w = tile.shape
        region_h, region_w = r1 - r0 + 1, c1 - c0 + 1
        assert region_h % tile_h == 0
        assert region_w % tile_w == 0
        assert (sr0 - r0) % tile_h == 0
        assert (sc0 - c0) % tile_w == 0

        rr = np.arange(r0, r1 + 1)[:, None]
        cc = np.arange(c0, c1 + 1)[None, :]
        out[r0 : r1 + 1, c0 : c1 + 1] = tile[(rr - sr0) % tile_h, (cc - sc0) % tile_w]

    return out

# --------------- generator (o5x) ---------------
# Colors and palette.
_GEN_WALL = 8
_GEN_EMPTY = 0
_GEN_SEED_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)

# Canvas and cavity coverage.
_GEN_GRID_ROWS = range(19, 27)
_GEN_GRID_COLS = range(13, 23)
_GEN_CAVITY_COUNT_RANGE = (1, 3)
_GEN_NON_WALL_PCT_RANGE = (23, 36)
_GEN_WALL_FRACTION_RANGE = (0.64, 0.77)

# Cavity dimensions and wall spacing.
_GEN_CAVITY_HEIGHT_OPTIONS = (6, 8, 9, 10, 12)
_GEN_CAVITY_WIDTH_OPTIONS = (6, 8, 9, 10, 12, 15)
_GEN_CAVITY_DIMS = [(h, w) for h in _GEN_CAVITY_HEIGHT_OPTIONS for w in _GEN_CAVITY_WIDTH_OPTIONS]
_GEN_BORDER_WALL_THICKNESS = 2
_GEN_CAVITY_START_GAP = 3
_GEN_MIN_CAVITY_AREA = min(h * w for h, w in _GEN_CAVITY_DIMS)
_GEN_MAX_CAVITY_AREA = max(h * w for h, w in _GEN_CAVITY_DIMS)
_GEN_CAVITY_WIDTH_WEIGHT_POWER = 2

# Tile dimensions, repetition, and density.
_GEN_TILE_HEIGHT_RANGE = (2, 3)
_GEN_TILE_WIDTH_RANGE = (2, 5)
_GEN_REPS_PER_AXIS_RANGE = (2, 5)
_GEN_TILE_DENSITY_PCT_RANGE = (56, 78)

# Retry limits.
_GEN_MAX_ATTEMPTS = 300
_GEN_PERCENT_DENOM = 100


def _gen_floor_percent(percent: int, value: int) -> int: return (percent * value) // _GEN_PERCENT_DENOM


def _gen_ceil_percent(percent: int, value: int) -> int: return (percent * value + _GEN_PERCENT_DENOM - 1) // _GEN_PERCENT_DENOM


def _gen_factor_options(length: int, lo: int, hi: int) -> list[int]:
    rep_min, rep_max = _GEN_REPS_PER_AXIS_RANGE
    return [d for d in range(lo, hi + 1) if length % d == 0 and rep_min <= length // d <= rep_max]


def _gen_choose_grid(rng: np.random.Generator, count: int) -> tuple[int, int] | None:
    choices = []
    min_cavity_area = _GEN_MIN_CAVITY_AREA * count
    max_cavity_area = _GEN_MAX_CAVITY_AREA * count
    for rows in _GEN_GRID_ROWS:
        for cols in _GEN_GRID_COLS:
            area = rows * cols
            if min_cavity_area <= _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area) and max_cavity_area >= _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area):
                choices.append((rows, cols))
    if not choices:
        return None
    return choices[int(rng.integers(0, len(choices)))]


def _gen_choose_cavity_dims(rng: np.random.Generator, rows: int, cols: int, count: int) -> list[tuple[int, int]] | None:
    area = rows * cols
    min_area = _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area)
    max_area = _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area)
    max_h = rows - 2 * _GEN_BORDER_WALL_THICKNESS
    max_w = cols - 2 * _GEN_BORDER_WALL_THICKNESS
    options = [(h, w) for h, w in _GEN_CAVITY_DIMS if h <= max_h and w <= max_w]
    combos: list[tuple[tuple[int, int], ...]] = []

    def rec(start: list[tuple[int, int]], area: int) -> None:
        if len(start) == count:
            if min_area <= area <= max_area:
                combos.append(tuple(start))
            return
        remaining = count - len(start)
        if area + remaining * _GEN_MIN_CAVITY_AREA > max_area:
            return
        if area + remaining * _GEN_MAX_CAVITY_AREA < min_area:
            return
        order = rng.permutation(len(options))
        for idx in order:
            h, w = options[int(idx)]
            rec(start + [(h, w)], area + h * w)

    rec([], 0)
    if not combos:
        return None
    weights = np.array([(sum(w for _, w in combo) / count) ** _GEN_CAVITY_WIDTH_WEIGHT_POWER for combo in combos], dtype=float)
    weights /= weights.sum()
    return list(combos[int(rng.choice(len(combos), p=weights))])


def _gen_rect_is_clear(rect: tuple[int, int, int, int], placed: list[tuple[int, int, int, int]]) -> bool:
    r0, c0, r1, c1 = rect
    for pr0, pc0, pr1, pc1 in placed:
        separated = r1 + _GEN_CAVITY_START_GAP <= pr0 or pr1 + _GEN_CAVITY_START_GAP <= r0 or c1 + _GEN_CAVITY_START_GAP <= pc0 or pc1 + _GEN_CAVITY_START_GAP <= c0
        if not separated:
            return False
    return True


def _gen_place_cavities(rng: np.random.Generator, rows: int, cols: int, dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
    placed: list[tuple[int, int, int, int]] = []
    for h, w in sorted(dims, key=lambda x: x[0] * x[1], reverse=True):
        positions: list[tuple[int, int, int, int]] = []
        for r0 in range(_GEN_BORDER_WALL_THICKNESS, rows - h - _GEN_BORDER_WALL_THICKNESS + 1):
            for c0 in range(_GEN_BORDER_WALL_THICKNESS, cols - w - _GEN_BORDER_WALL_THICKNESS + 1):
                rect = (r0, c0, r0 + h - 1, c0 + w - 1)
                if _gen_rect_is_clear(rect, placed):
                    positions.append(rect)
        if not positions:
            return None
        placed.append(positions[int(rng.integers(0, len(positions)))])
    return placed


def _gen_tile_specs(rng: np.random.Generator, cavity_h: int, cavity_w: int) -> tuple[int, int, int] | None:
    groups: dict[int, list[tuple[int, int, int]]] = {}
    for tile_h in _gen_factor_options(cavity_h, *_GEN_TILE_HEIGHT_RANGE):
        for tile_w in _gen_factor_options(cavity_w, *_GEN_TILE_WIDTH_RANGE):
            area = tile_h * tile_w
