+    for name, color in MARKER_COLORS.items():
+        rs, cs = _corner_slice(name, height, width)
+        region = grid[rs, cs]
+        empties = [tuple(map(int, rc)) for rc in np.argwhere(region == BACKGROUND)]
+        if not empties:
+            return False
+        r, c = random.choice(empties)
+        region[r, c] = color
+    return True
+
+
