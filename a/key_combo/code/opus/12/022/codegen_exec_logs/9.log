+    for index, name in enumerate(CLOCKWISE):
+        own = int(corner_colors[name])
+        borrow = int(corner_colors[CLOCKWISE[(index + 1) % 4]])
+        r0, c0 = OUTPUT_ANCHORS[name]
+        for dr in range(2):
+            for dc in range(2):
+                out[r0 + dr, c0 + dc] = own if (dr, dc) in mask_set else borrow
+    return out
