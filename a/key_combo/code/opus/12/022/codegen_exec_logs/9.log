+    coords = np.argwhere(grid == SPRITE_COLOR)
+    if len(coords) == 0:
+        return False
+    span = coords.max(axis=0) - coords.min(axis=0)
+    return bool(span[0] >= 2 and span[1] >= 2)
+
+
+def _is_valid_generated_input(grid: np.ndarray, mask: tuple[tuple[int, int], ...]) -> bool:
+    if set(map(int, np.unique(grid))) - {BACKGROUND, 1, 2, 3, 4, SPRITE_COLOR}:
