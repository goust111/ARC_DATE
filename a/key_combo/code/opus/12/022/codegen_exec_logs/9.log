+BACKGROUND = 0
+MARKER_COLORS = {
+    "ul": 1,
+    "ur": 2,
+    "lr": 3,
+    "ll": 4,
+}
+SPRITE_COLOR = 8
+CLOCKWISE = ("ul", "ur", "lr", "ll")
+OUTPUT_ANCHORS = {
+    "ul": (0, 0),
+    "ur": (0, 3),
+    "ll": (3, 0),
+    "lr": (3, 3),
