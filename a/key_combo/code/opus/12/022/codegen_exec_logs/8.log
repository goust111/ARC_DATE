+    if direction == "top":
+        candidate = (br0 + 1, bc0, br1, bc1)
+    elif direction == "bottom":
+        candidate = (br0, bc0, br1 - 1, bc1)
+    elif direction == "left":
+        candidate = (br0, bc0 + 1, br1, bc1)
+    else:
+        candidate = (br0, bc0, br1, bc1 - 1)
