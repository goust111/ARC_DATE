    patch[:border, :] = frame_color
    patch[-border:, :] = frame_color
    patch[:, :border] = frame_color
    patch[:, -border:] = frame_color
    interior = patch[border:-border, border:-border]
    interior[0::2, 0::2] = marker_color
    interior[1::2, 1::2] = marker_color
    return patch


