+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+TEAL = 8
+
+_N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_CROSS = [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)]
+_GEN_RETRIES = 400
