  colors: input uses only BLACK and TEAL; output adds GREEN
  background: ~50% TEAL pixels scattered randomly (no pattern), 39-52% BLACK
  plus_centers:
    count: 2-5 black pixels whose 4 orthogonal neighbors are also black
    position: rows 1-10, cols 1-10 (need 1-cell margin for arms)
    groups: 1-3 connected components where centers within L1 dist <=2 merge
    group_size: 1-2 centers per group
    inter_group_distance: >=5 L1
  near_plus_distractors: 8-12 black pixels with exactly 3/4 orthogonal black neighbors [observed]
  transform:
