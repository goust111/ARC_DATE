+    meta = {"room_anchor": (r0 + room_h // 2, c0 + room_w // 2)}
+    return cells, meta
+
+
+def _open_cross_structure(
+    h: int,
+    w: int,
+) -> tuple[set[tuple[int, int]], dict[str, object]]:
