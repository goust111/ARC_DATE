+                    cells = {(r, c) for r in range(r0, r0 + room_h) for c in range(c0, c0 + room_w)}
+                    cells |= {(r, door_c) for r in range(0, r0 - 1)}
+                    cells.add(center)
+                    cells.add((r0 - 1, door_c - 1))
+                    cells.add((r0 - 1, door_c + 1))
+                    meta = {
