+            return False
+        for rr in range(r - padding, r + padding + 1):
+            for cc in range(c - padding, c + padding + 1):
+                if 0 <= rr < h and 0 <= cc < w and occupied[rr, cc] and (rr, cc) not in cells:
+                    return False
+    return True
