+            if side == "left":
+                if w < 7:
+                    continue
+                c0 = random.randint(3, w - room_w - 2)
+                door_r = random.choice([r0, r0 + 1])
+                center = (door_r, c0 - 1)
+                cells = {(r, c) for r in range(r0, r0 + room_h) for c in range(c0, c0 + room_w)}
+                cells |= {(door_r, c) for c in range(0, c0 - 1)}
+                cells.add(center)
