+                center = (r1 + 1, door_c)
+                cells = {(r, c) for r in range(r0, r0 + room_h) for c in range(c0, c0 + room_w)}
+                cells |= {(r, door_c) for r in range(r1 + 2, h)}
+                cells.add(center)
