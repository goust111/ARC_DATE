+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                if cr == 0 or cc == 0 or cr == h - 1 or cc == w - 1:
+                    touches_edge = True
+                for dr, dc in _N4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
