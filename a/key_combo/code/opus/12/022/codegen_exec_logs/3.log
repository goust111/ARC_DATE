+    c0 = random.randint(1, w - room_w - 2)
+    cells = {(r, c) for r in range(r0, r0 + room_h) for c in range(c0, c0 + room_w)}
+    meta = {"room_anchor": (r0 + room_h // 2, c0 + room_w // 2)}
+    return cells, meta
