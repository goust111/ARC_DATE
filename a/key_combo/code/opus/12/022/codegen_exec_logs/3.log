+    for side in sides:
+        for _ in range(60):
+            if side in {"top", "bottom"}:
+                room_h = random.randint(3, 5)
+                room_w = 2
+                c0 = random.randint(1, w - room_w - 2)
+                if side == "top":
+                    if h < 7:
+                        continue
+                    r0 = random.randint(3, h - room_h - 2)
