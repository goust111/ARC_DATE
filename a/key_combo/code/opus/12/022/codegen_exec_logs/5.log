+
+def slot_ranges(h: int, w: int) -> dict[str, tuple[int, int, int, int]]:
+    return {
+        "up": (h - 8, 1, h - 2, 8),
+        "down": (1, w - 9, 7, w - 2),
+        "right": (1, 1, 7, 8),
+        "left": (h - 8, w - 9, h - 2, w - 2),
+        "plain": (max(1, h // 2 - 3), max(1, w // 2 - 4), min(h - 2, h // 2 + 3), min(w - 2, w // 2 + 4)),
