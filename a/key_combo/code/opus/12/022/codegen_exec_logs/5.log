+
+
+def place_component(
+    grid: np.ndarray,
+    rng: np.random.Generator,
+    slot: tuple[int, int, int, int],
+    shape: np.ndarray,
+    defect: list[tuple[int, int]],
+    direction: str | None,
+    cap_run: int | None,
+) -> dict | None:
+    sr0, sc0, sr1, sc1 = slot
+    h, w = shape.shape
+
+    r_min = sr0
+    r_max = sr1 - h + 1
+    c_min = sc0
+    c_max = sc1 - w + 1
+    if direction == "up":
+        r_min = max(r_min, sr0 + 1)
+    elif direction == "down":
+        r_max = min(r_max, sr1 - h)
+    elif direction == "left":
+        c_min = max(c_min, sc0 + 1)
+    elif direction == "right":
+        c_max = min(c_max, sc1 - w)
+
+    if r_min > r_max or c_min > c_max:
+        return None
+
+    candidates = [(r, c) for r in range(r_min, r_max + 1) for c in range(c_min, c_max + 1)]
+    rng.shuffle(candidates)
