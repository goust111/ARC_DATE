+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+GEN_ATTEMPTS = 500
+HEIGHT_RANGE = (10, 16)
+WIDTH_RANGE = (12, 18)
