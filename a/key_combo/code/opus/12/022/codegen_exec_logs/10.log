+
+def _place_blue_task(
+    grid: np.ndarray,
+    blue_row: int,
+    green_col: int,
+    mode: str,
+    visual_reserved: set[tuple[int, int]],
+    halo_reserved: set[tuple[int, int]],
+) -> dict | None:
