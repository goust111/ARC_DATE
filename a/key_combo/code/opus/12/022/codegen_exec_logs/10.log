  colors: input uses BLACK(0) background, BLUE(1) walls, RED(2) endpoints only
  endpoints:
    count: exactly 2 RED pixels
    placement: both on grid border; mostly at corners [observed]
  walls:
    color: BLUE
    structure: 1-5 connected components; each is a line segment (thickness 1-2 cells), H or V
    span: each wall spans 40-85% of the grid dimension it crosses
    anchoring: each wall touches at least one grid edge [observed]
    gap: each wall leaves a gap at one end, gaps alternate sides across successive walls to force a serpentine path
    density: 19-36% of grid cells are BLUE
  path:
