+            dr = 1 if blue_row > r else -1
+            stop = (blue_row - dr, c)
+            obstacle: tuple[int, int] | None = None
+            for rr in range(r + dr, blue_row, dr):
+                if int(g[rr, c]) == RED:
+                    obstacle = (rr, c)
+                    stop = (rr - dr, c)
+                    break
+            sr, sc = stop
+            if int(out[sr, sc]) == BLACK:
