+    h, w = map(int, shape)
+    row_choices = [r for r in range(max(3, h // 2 - 1), min(h - 3, h // 2 + 1) + 1)]
+    col_choices = [c for c in range(max(3, w // 2 - 1), min(w - 3, w // 2 + 1) + 1)]
+    return random.choice(row_choices), random.choice(col_choices)
