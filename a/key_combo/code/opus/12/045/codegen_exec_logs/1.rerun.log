+    if len(candidates) < 2:
+        return None
+
+    want_same_radius = random.random() < 0.5
+    random.shuffle(candidates)
+    for dr1, dc1 in candidates:
+        radius1 = max(abs(dr1), abs(dc1))
+        others = candidates[:]
