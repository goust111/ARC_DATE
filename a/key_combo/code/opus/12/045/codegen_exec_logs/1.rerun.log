+def _pairwise_separated(emitters: Iterable[tuple[int, int, int]]) -> bool:
+    pts = [(int(r), int(c)) for r, c, _ in emitters]
+    for i, (r1, c1) in enumerate(pts):
+        for r2, c2 in pts[i + 1 :]:
+            if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+                return False
+    return True
