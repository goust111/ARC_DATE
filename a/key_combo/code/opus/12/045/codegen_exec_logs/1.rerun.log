+
+def _candidate_offsets(shape: tuple[int, int], pivot: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    pr, pc = map(int, pivot)
+    candidates = []
+    for dr in range(-(h - 1), h):
