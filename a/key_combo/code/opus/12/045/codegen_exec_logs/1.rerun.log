+
+
+def _valid_offset_pair(
+    shape: tuple[int, int], pivot: tuple[int, int]
+) -> tuple[list[tuple[int, int]], list[int]] | None:
+    candidates = _candidate_offsets(shape, pivot)
+    if len(candidates) < 2:
+        return None
+
+    want_same_radius = random.random() < 0.5
+    random.shuffle(candidates)
