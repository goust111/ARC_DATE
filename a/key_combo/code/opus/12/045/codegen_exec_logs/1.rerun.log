+            if len(set(orbit)) != 4:
+                continue
+            if not all(in_bounds(shape, r, c) for r, c in orbit):
+                continue
+            if max(abs(dr), abs(dc)) > min(pr, h - 1 - pr, pc, w - 1 - pc) - 1:
+                continue
+            candidates.append((int(dr), int(dc)))
+    return candidates
