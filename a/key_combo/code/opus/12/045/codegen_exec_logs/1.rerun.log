+    completed = _complete_rotational(g)
+    pivot = _find_pivot(completed)
+    emitters = _emitters_from_grid(completed)
+    out, _ = _render_rays(completed, pivot, emitters)
+    return out
+
+
+def _grid_from_emitters(
+    shape: tuple[int, int],
+    pivot: tuple[int, int],
+    emitters: Iterable[tuple[int, int, int]],
+) -> np.ndarray:
