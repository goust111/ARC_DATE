+            cur_dr, cur_dc = _quarter_turn(cur_dr, cur_dc)
+            nr, nc = pr + cur_dr, pc + cur_dc
+            assert in_bounds(out.shape, nr, nc), "rotated counterpart left the grid"
+            if int(out[nr, nc]) == BG:
