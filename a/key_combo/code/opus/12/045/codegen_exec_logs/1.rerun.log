+    analyses: list[dict] = []
+    for r, c, color in _sorted_emitters(emitters, pivot):
+        dr, dc = _direction_away((r, c), pivot)
+        nr, nc = r + dr, c + dc
+        drawn: list[tuple[int, int]] = []
