+def _full_emitters_from_offsets(
+    pivot: tuple[int, int],
+    offsets: list[tuple[int, int]],
+    colors: list[int],
+) -> list[tuple[int, int, int]]:
+    emitters: list[tuple[int, int, int]] = []
+    for (dr, dc), color in zip(offsets, colors):
+        for r, c in _orbit_positions(pivot, dr, dc):
+            emitters.append((int(r), int(c), int(color)))
+    return emitters
+
+
+def _has_cross_color_ray_block(analyses: list[dict]) -> bool:
+    for item in analyses:
+        if item["blocked_kind"] == "ray" and item["blocked_color"] != item["color"]:
+            return True
+    return False
