+def _emitters_from_grid(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    coords = np.argwhere((grid != BG) & (grid != PIVOT))
+    return [(int(r), int(c), int(grid[r, c])) for r, c in coords]
+
