+    for cell, cols in overlaps.items():
+        winner = max(cols)
+        assert out[cell] == trigger_color_by_col[winner], "rightmost trigger should win on overlapping rays"
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(MIN_SIZE, MAX_SIZE)
