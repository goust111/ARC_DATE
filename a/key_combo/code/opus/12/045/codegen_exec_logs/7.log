+def _ray_trace(shape: tuple[int, int], start: tuple[int, int], dc: int) -> list[tuple[int, int]]:
+    h, w = shape
+    rr = start[0] - 1
+    cc = start[1] + dc
+    cells: list[tuple[int, int]] = []
+    while 0 <= rr < h and 0 <= cc < w:
