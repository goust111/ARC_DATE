+import numpy as np
+
+
+BG_COLOR = 0
+PIVOT_COLOR = 5
+BAR_COLOR = 7
+PALETTE = (1, 2, 3, 4, 6, 8, 9)
+
+MIN_SIZE = 10
+MAX_SIZE = 16
+MIN_PIXELS = 3
+MAX_PIXELS = 5
+GEN_RETRIES = 500
+OVERLAP_PROB = 0.55
