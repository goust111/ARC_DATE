+def _trigger_combo_info(
+    shape: tuple[int, int],
+    bar_r: int,
+    pivot: tuple[int, int],
+    cols: tuple[int, ...],
+) -> tuple[dict[int, tuple[tuple[int, int], ...]], dict[tuple[int, int], tuple[int, ...]]] | None:
+    per_col: dict[int, tuple[tuple[int, int], ...]] = {}
+    touched_by: dict[tuple[int, int], list[int]] = {}
+    for col in cols:
+        cells = tuple(
+            itertools.chain(
+                _ray_trace(shape, (bar_r - 1, col), -1),
+                _ray_trace(shape, (bar_r - 1, col), 1),
