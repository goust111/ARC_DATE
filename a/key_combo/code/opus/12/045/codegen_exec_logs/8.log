+def _is_connected(coords) -> bool:
+    pts = set(coords)
+    start = next(iter(pts))
+    queue = deque([start])
+    seen = {start}
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in pts and (nr, nc) not in seen:
+                seen.add((nr, nc))
