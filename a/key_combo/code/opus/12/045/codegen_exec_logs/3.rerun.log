+        r = int(spec["row"])
+        carrier = int(spec["carrier"])
+        red_start = int(spec["red_start"])
+        red_len = int(spec["red_len"])
+        greens = tuple(int(c) for c in spec["greens"])
+        grid[r, :] = carrier
+        grid[r, greens[0]] = GREEN
+        grid[r, greens[1]] = GREEN
+        grid[r, red_start : red_start + red_len] = RED
+    return grid
+
