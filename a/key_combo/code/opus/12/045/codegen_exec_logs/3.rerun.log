+        return None
+    if not np.any(actual == YELLOW):
+        return None
+    if not any(bool(spec["need_skip"]) for spec in row_specs):
+        return None
+    if not any(not bool(spec["need_skip"]) for spec in row_specs):
+        return None
+    return grid
