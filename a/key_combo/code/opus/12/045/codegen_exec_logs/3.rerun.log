+    banned = set(range(red_start, red_start + red_len))
+    if red_start - 1 >= 0:
+        banned.add(red_start - 1)
+    if red_start + red_len < width:
+        banned.add(red_start + red_len)
+    if carrier == BLUE:
+        banned.update(range(width - red_len, width))
+    else:
