+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+BLOCKER = 9
+SIDE_COLORS = (1, 2, 3, 4)
+DIAG_COLORS = (1, 2, 3, 4, 6, 7)
+MAX_ATTEMPTS = 500
