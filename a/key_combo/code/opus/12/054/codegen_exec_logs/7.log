+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+BLOCKER = 9
+SIDE_COLORS = (1, 2, 3, 4)
+DIAG_COLORS = (1, 2, 3, 4, 6, 7)
+MAX_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
