+
+def _ray_cells(
+    grid: np.ndarray,
+    center: tuple[int, int],
+    radius: int,
+    marker: tuple[int, int, int, int, int],
+) -> tuple[list[tuple[int, int]], bool]:
+    r, c, _color, dr, dc = marker
+    rr, cc = r + dr, c + dc
+    cells: list[tuple[int, int]] = []
+    entered = False
+    blocked = False
