+
+def _inside(center: tuple[int, int], radius: int, r: int, c: int) -> bool:
+    return abs(int(r) - center[0]) + abs(int(c) - center[1]) < radius
+
+
+def _read_diagonal_palette(
+    grid: np.ndarray, top_vertex: tuple[int, int]
