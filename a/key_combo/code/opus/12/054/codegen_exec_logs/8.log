+    target_w = random.randint(TARGET_W_RANGE[0], min(TARGET_W_RANGE[1], grid_w - 4))
+    top_lo, top_hi = 2, grid_h - target_h - 2
+    left_lo, left_hi = 3, grid_w - target_w - 3
+    if top_lo > top_hi or left_lo > left_hi:
