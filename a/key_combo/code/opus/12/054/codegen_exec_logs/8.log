+            specs.append(extra_spec)
+        break
+    else:
+        return None
+
+    row_idx = next(i for i, spec in enumerate(specs) if spec["mode"] == "row")
+    col_idx = next(i for i, spec in enumerate(specs) if spec["mode"] == "col")
+    shared_targets = set(specs[row_idx]["cell_map"].values()) & set(specs[col_idx]["cell_map"].values())
+
+    for _ in range(200):
+        final_specs = [dict(spec) for spec in specs]
+        shared = random.choice(sorted(shared_targets))
+        row_required = [random.choice([cell for cell, dst in specs[row_idx]["cell_map"].items() if dst == shared])]
+        col_required = [random.choice([cell for cell, dst in specs[col_idx]["cell_map"].items() if dst == shared])]
+
+        row_markers = _sample_markers(*specs[row_idx]["shape"], target_shape, "row", required=row_required)
+        col_markers = _sample_markers(*specs[col_idx]["shape"], target_shape, "col", required=col_required)
+        if row_markers is None or col_markers is None:
