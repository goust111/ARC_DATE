+
+    n_sources = 3 if random.random() < 0.35 else 2
+    chosen_colors = random.sample(SOURCE_COLORS, n_sources)
+    extra_mode = random.choice(("row", "col")) if n_sources == 3 else None
+
+    for _ in range(150):
+        row_spec = sample_shape_spec(chosen_colors[0], "row")
+        col_spec = sample_shape_spec(chosen_colors[1], "col")
+        if row_spec is None or col_spec is None:
+            return None
+        shared_targets = set(row_spec["cell_map"].values()) & set(col_spec["cell_map"].values())
+        if not shared_targets:
+            continue
+
+        specs = [row_spec, col_spec]
+        if extra_mode is not None:
+            extra_spec = sample_shape_spec(chosen_colors[2], extra_mode)
+            if extra_spec is None:
