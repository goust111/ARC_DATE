+            random.shuffle(left_candidates)
+            for gap in gap_values:
+                rect_top = target_top - gap - src_h if slot == "top" else target_top + target_h + gap
+                if rect_top < 1 or rect_top + src_h >= grid.shape[0] - 1:
+                    continue
