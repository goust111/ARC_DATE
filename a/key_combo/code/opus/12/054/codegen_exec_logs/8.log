+def _mark_occupied(occupied: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    for r, c in cells:
+        occupied[r, c] = True
+
+
+def _unmark_occupied(occupied: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    for r, c in cells:
