+def _component_cells(
+    rect_top: int,
+    rect_left: int,
+    shape: tuple[int, int],
+    mode: str,
+    side: str,
+    offset: int,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = map(int, shape)
+    rect_cells = [(rect_top + r, rect_left + c) for r in range(h) for c in range(w)]
+    r1 = rect_top + h - 1
+    c1 = rect_left + w - 1
