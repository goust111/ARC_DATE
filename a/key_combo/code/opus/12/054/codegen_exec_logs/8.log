+    def backtrack(i: int, row_slots: list[str], col_slots: list[str]) -> bool:
+        if i == len(ordered):
+            return True
+        spec = ordered[i]
+        slots = row_slots if spec["mode"] == "row" else col_slots
+        slot_order = random.sample(slots, len(slots))
