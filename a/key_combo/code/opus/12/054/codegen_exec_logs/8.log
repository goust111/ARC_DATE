        max_h = min(mod.SOURCE_H_RANGE[1], target_shape[0])
        max_w = min(mod.SOURCE_W_RANGE[1], target_shape[1])
        if min_h > max_h or min_w > max_w:
            bad=True; break
        for _ in range(100):
            src_h = random.randint(min_h, max_h)
            src_w = random.randint(min_w, max_w)
            allowed = mod._allowed_marker_cells(src_h, src_w, mode)
            if len(allowed) < 2:
                continue
            cell_map = {cell: next(iter(mod._map_pattern([cell], (src_h, src_w), target_shape, mode))) for cell in allowed}
            specs.append({'color':color,'mode':mode,'shape':(src_h,src_w),'allowed':allowed,'cell_map':cell_map})
            break
        else:
            bad=True; break
    if bad:
        counts['shape_fail'] += 1
        continue
    row_idx = next(i for i,s in enumerate(specs) if s['mode']=='row')
    col_idx = next(i for i,s in enumerate(specs) if s['mode']=='col')
    shared_targets = set(specs[row_idx]['cell_map'].values()) & set(specs[col_idx]['cell_map'].values())
    if not shared_targets:
        counts['shared_none'] += 1
        continue
    ok=False
    for _ in range(200):
        shared = random.choice(sorted(shared_targets))
        row_required = [random.choice([cell for cell, dst in specs[row_idx]['cell_map'].items() if dst == shared])]
        col_required = [random.choice([cell for cell, dst in specs[col_idx]['cell_map'].items() if dst == shared])]
        row_markers = mod._sample_markers(*specs[row_idx]['shape'], target_shape, 'row', required=row_required)
        col_markers = mod._sample_markers(*specs[col_idx]['shape'], target_shape, 'col', required=col_required)
        if row_markers is None or col_markers is None:
            continue
        finals = [dict(s) for s in specs]
        finals[row_idx]['grey_rel'], finals[row_idx]['mapped'] = row_markers
        finals[col_idx]['grey_rel'], finals[col_idx]['mapped'] = col_markers
        failed=False
        for i,s in enumerate(finals):
            if i in {row_idx,col_idx}: continue
            sampled = mod._sample_markers(*s['shape'], target_shape, s['mode'])
            if sampled is None:
                failed=True; break
            s['grey_rel'], s['mapped'] = sampled
        if failed: continue
        row_union = set().union(*(s['mapped'] for s in finals if s['mode']=='row'))
        col_union = set().union(*(s['mapped'] for s in finals if s['mode']=='col'))
        if row_union and col_union and (row_union & col_union) and (row_union-col_union) and (col_union-row_union):
            ok=True; break
    if ok: counts['ok'] += 1
    else: counts['loop_fail'] += 1
print(counts)
