+        min_h = 4 if mode == "row" else SOURCE_H_RANGE[0]
+        min_w = 4 if mode == "col" else SOURCE_W_RANGE[0]
+        max_h = min(SOURCE_H_RANGE[1], target_h)
+        max_w = min(SOURCE_W_RANGE[1], target_w)
