+        src_h, src_w = spec["shape"]
+        opts: list[tuple[str, int]] = []
+        if spec["mode"] == "row":
+            opts.extend([("top", i) for i in range(src_w - 1)])
+            opts.extend([("bottom", i) for i in range(src_w - 1)])
