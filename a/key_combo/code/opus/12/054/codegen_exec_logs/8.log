+            tr = _edge_preserved_index(rr, src_h, dst_h)
+            tc = _scaled_index(cc, src_w, dst_w)
+        else:
+            tr = _scaled_index(rr, src_h, dst_h)
+            tc = _edge_preserved_index(cc, src_w, dst_w)
