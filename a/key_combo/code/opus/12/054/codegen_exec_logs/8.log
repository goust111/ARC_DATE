+        k = random.randint(MARKER_COUNT_RANGE[0], min(MARKER_COUNT_RANGE[1], len(cells)))
+        chosen = sorted(random.sample(cells, k))
+        rows = {r for r, _ in chosen}
+        cols = {c for _, c in chosen}
+        if len(rows) < min(2, len(inner_rows)):
+            continue
+        if len(cols) < min(2, len(inner_cols)):
+            continue
