+BG = 0
+TARGET_COLOR = 4
+MARKER_COLOR = 5
+SOURCE_COLORS = (1, 2, 3)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (18, 26)
+TARGET_H_RANGE = (6, 8)
+TARGET_W_RANGE = (6, 9)
