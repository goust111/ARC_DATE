+
+
+def _allowed_marker_cells(src_h: int, src_w: int, mode: str) -> list[tuple[int, int]]:
+    inner_rows = list(range(1, src_h - 1))
+    inner_cols = list(range(1, src_w - 1))
+    if mode == "row" and src_h % 2 == 1:
