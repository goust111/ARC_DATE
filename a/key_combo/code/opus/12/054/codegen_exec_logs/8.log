+        right_band = max((spec["shape"][1] + 2 for spec, slot in zip(row_specs, row_slots) if slot == "right"), default=0)
+        top_band = max((spec["shape"][0] + 2 for spec, slot in zip(col_specs, col_slots) if slot == "top"), default=0)
