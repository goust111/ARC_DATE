+def _choose_source_specs(target_shape: tuple[int, int]) -> list[dict] | None:
+    target_h, target_w = map(int, target_shape)
+    n_sources = 3 if random.random() < 0.65 else 2
+    modes = ["row", "col"]
+    if n_sources == 3:
+        modes.append(random.choice(("row", "col")))
+    random.shuffle(modes)
+
+    specs: list[dict] = []
+    for color, mode in zip(random.sample(SOURCE_COLORS, n_sources), modes):
+        min_h = 4 if mode == "row" else SOURCE_H_RANGE[0]
+        min_w = 4 if mode == "col" else SOURCE_W_RANGE[0]
+        max_h = min(SOURCE_H_RANGE[1], target_h)
+        max_w = min(SOURCE_W_RANGE[1], target_w)
+        if min_h > max_h or min_w > max_w:
+            return None
+        for _ in range(100):
+            src_h = random.randint(min_h, max_h)
+            src_w = random.randint(min_w, max_w)
+            grey_rel = _sample_markers(src_h, src_w, target_shape, mode)
+            if grey_rel is None:
+                continue
+            mapped = _map_pattern(grey_rel, (src_h, src_w), target_shape, mode)
+            specs.append(
+                {
+                    "color": int(color),
+                    "mode": mode,
+                    "shape": (src_h, src_w),
