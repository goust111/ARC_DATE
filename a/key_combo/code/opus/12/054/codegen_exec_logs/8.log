+    ordered = sorted(
+        specs,
+        key=lambda s: len(s["mapped"]) * max(s["shape"]),
+        reverse=True,
+    )
+    placement_cache = {
+        (id(spec), slot): slot_placements(spec, slot)
+        for spec in ordered
+        for slot in (["left", "right"] if spec["mode"] == "row" else ["top", "bottom"])
