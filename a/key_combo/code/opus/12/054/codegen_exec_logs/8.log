+
+                    rect = sub[r0 : r1 + 1, c0 : c1 + 1]
+                    grey_rel = [tuple(map(int, rc)) for rc in np.argwhere(rect == MARKER_COLOR)]
+                    if not grey_rel:
+                        continue
+
+                    candidates.append(
+                        {
+                            "base_color": base_color,
+                            "mode": mode,
+                            "rect_bbox": (bbox[0] + r0, bbox[1] + c0, bbox[0] + r1, bbox[1] + c1),
+                            "shape": rect.shape,
+                            "grey_rel": sorted(grey_rel),
+                        }
+                    )
