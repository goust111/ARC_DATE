+def _place_sources(grid: np.ndarray, target_rect: tuple[int, int, int, int], specs: list[dict]) -> bool:
+    target_top, target_left, target_h, target_w = target_rect
+    occupied = np.zeros_like(grid, dtype=bool)
+    _mark_occupied(
+        occupied,
