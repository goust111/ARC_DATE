+    return backtrack(0, ["left", "right"], ["top", "bottom"])
+
+
+def _expected_output(target_shape: tuple[int, int], specs: list[dict]) -> np.ndarray:
+    out = np.full(target_shape, TARGET_COLOR, dtype=int)
+    for mode in ("col", "row"):
+        for spec in specs:
