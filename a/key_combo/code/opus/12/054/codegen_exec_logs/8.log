+    col_slots = random.sample(["top", "bottom"], k=len(col_specs))
+
+    for spec, slot in zip(sorted(row_specs, key=lambda s: s["shape"][1], reverse=True), row_slots):
+        if not try_slot(spec, slot):
+            return False
+    for spec, slot in zip(sorted(col_specs, key=lambda s: s["shape"][0], reverse=True), col_slots):
