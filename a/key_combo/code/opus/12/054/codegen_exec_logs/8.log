+
+BG = 0
+TARGET_COLOR = 4
+MARKER_COLOR = 5
+SOURCE_COLORS = (1, 2, 3)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_H_RANGE = (16, 20)
+GRID_W_RANGE = (22, 28)
+TARGET_H_RANGE = (6, 8)
+TARGET_W_RANGE = (6, 8)
+SOURCE_H_RANGE = (3, 5)
+SOURCE_W_RANGE = (3, 5)
+MARKER_COUNT_RANGE = (2, 5)
+MAX_GENERATE_ATTEMPTS = 500
