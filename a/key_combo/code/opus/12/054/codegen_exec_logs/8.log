+                                    "rect_top": rect_top,
+                                    "rect_left": rect_left,
+                                    "rect_cells": rect_cells,
+                                    "domino": domino,
+                                    "all_cells": all_cells,
+                                }
+                            )
+        random.shuffle(placements)
+        return placements
