+def _choose_domino_for_slot(spec: dict, rect_top: int, rect_left: int, slot: str) -> list[tuple[int, int]] | None:
+    mode = spec["mode"]
+    h, w = spec["shape"]
+    side_order = _slot_side_choices(mode, slot)
