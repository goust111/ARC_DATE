+
+        row_union = set().union(*(spec["mapped"] for spec in final_specs if spec["mode"] == "row"))
+        col_union = set().union(*(spec["mapped"] for spec in final_specs if spec["mode"] == "col"))
+        if not row_union or not col_union:
+            continue
+        if not (row_union & col_union):
