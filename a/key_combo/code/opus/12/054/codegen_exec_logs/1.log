+    nodes = int(mask.sum())
+    edges = 0
+    max_deg = 0
+    for r, c in np.argwhere(mask):
+        deg = 0
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if _in_bounds(mask.shape, nr, nc) and mask[nr, nc]:
