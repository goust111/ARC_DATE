+Coord = tuple[int, int]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(mask.shape, nr, nc) or not mask[nr, nc]:
+                continue
+            nxt = (nr, nc)
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            queue.append(nxt)
+    return len(seen) == int(mask.sum())
+
+
+def _graph_stats(mask: np.ndarray) -> tuple[int, int, int]:
+    nodes = int(mask.sum())
+    edges = 0
+    max_deg = 0
+    for r, c in np.argwhere(mask):
+        deg = 0
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if _in_bounds(mask.shape, nr, nc) and mask[nr, nc]:
+                deg += 1
+        max_deg = max(max_deg, deg)
+        edges += deg
+    return nodes, edges // 2, max_deg
+
+
+def _bfs_distances(channel: np.ndarray, start: Coord) -> np.ndarray:
+    dist = np.full(channel.shape, INF, dtype=int)
+    assert channel[start], "seed must lie on a channel cell"
+    dist[start] = 0
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(channel.shape, nr, nc) or not channel[nr, nc]:
+                continue
+            if dist[nr, nc] != INF:
+                continue
+            dist[nr, nc] = dist[r, c] + 1
+            queue.append((nr, nc))
+    return dist
+
