+            if not (channel[seeds[RED]] and channel[seeds[GREEN]]):
+                continue
+
+            out, meta = _solve_from_mask(mask, seeds)
+            owner_only, _ = _paint_channel(channel, seeds, parity=False)
+            direct_region, _ = _paint_channel(region_open, seeds, parity=True)
+            owner_counts = meta["owner_counts"]
+
+            if not np.all(out[channel] != BG):
+                continue
+            if len(set(map(int, np.unique(out))) - {BG}) != 2:
+                continue
+            if owner_counts[RED] < 3 or owner_counts[GREEN] < 3:
+                continue
+            if np.array_equal(out, owner_only):
+                continue
+            if np.array_equal(out, direct_region):
+                continue
+
+            records.append(
+                {
+                    "seeds": seeds,
+                    "output": out,
+                    "tie_count": int(meta["tie_count"]),
+                    "same_row": seeds[RED][0] == seeds[GREEN][0],
+                }
+            )
+    return records
+
+
+def _pick_seeding(mask: np.ndarray) -> tuple[dict[int, Coord], np.ndarray]:
+    records = _valid_seed_records(mask)
+    assert records, "expected at least one valid seed configuration"
+
+    same_row_ties = [rec for rec in records if rec["same_row"] and rec["tie_count"] > 0]
+    ties = [rec for rec in records if rec["tie_count"] > 0]
+    no_ties = [rec for rec in records if rec["tie_count"] == 0]
+
+    pools = []
+    if same_row_ties:
+        pools.extend([same_row_ties] * 3)
+    if ties:
+        pools.extend([ties] * 2)
+    if no_ties:
+        pools.extend([no_ties] * 2)
+    if not pools:
+        pools = [records]
+
+    rec = random.choice(random.choice(pools))
+    return rec["seeds"], rec["output"]
+
+
+def _semantic_checks(mask: np.ndarray, seeds: dict[int, Coord], expected: np.ndarray, inp: np.ndarray) -> bool:
+    if not np.array_equal(main(inp), expected):
+        return False
