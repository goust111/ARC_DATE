  "path": "continuous green path from the marker toward the gate",
  "trajectory": "move the marker along the green path to dst",
  "dst": "green path pixel adjacent to the gate center and outside the two black gate ends",
  "transform": "erase the old marker and traversed green path except the gate center; leave components without both marker and gate unchanged"
}
</annotation>
<generation_spec>
