+
+        rec = _seed_record(mask, seeds)
+        if rec is None:
+            continue
+        if mode == "same_row_tie" and not (rec["same_row"] and rec["tie_count"] > 0):
+            continue
+        if mode == "tie" and not (rec["tie_count"] > 0):
+            continue
+        if mode == "no_tie" and rec["tie_count"] != 0:
+            continue
+        return rec
+    return None
