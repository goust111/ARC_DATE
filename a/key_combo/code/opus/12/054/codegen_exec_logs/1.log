+        red_off = random.choice(open_offsets)
+        green_off = random.choice(open_offsets)
+        seeds = {
+            RED: (3 * red_block[0] + red_off[0], 3 * red_block[1] + red_off[1]),
+            GREEN: (3 * green_block[0] + green_off[0], 3 * green_block[1] + green_off[1]),
