+    for r, c in np.argwhere(channel):
+        r = int(r)
+        c = int(c)
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(channel.shape, nr, nc) and channel[nr, nc] and expected[r, c] != expected[nr, nc]:
