+                tmp[sr, sc] = OPEN
+                assert np.all(tmp == OPEN), "seed tiles must otherwise be gray"
+                seeds[color] = (3 * br + sr, 3 * bc + sc)
+                seed_blocks[color] = (br, bc)
+            else:
+                assert np.all(tile == OPEN), "non-seed open tiles must be uniformly gray"
+            mask[br, bc] = True
