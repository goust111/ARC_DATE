+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+OPEN = 5
+RED = 2
+GREEN = 3
+
+TILE = 3
+MASK_SIDE = 3
+REGION_SIDE = TILE * MASK_SIDE
+GRID_SIDE = 13
+REGION_TOP = 2
+REGION_LEFT = 2
+
