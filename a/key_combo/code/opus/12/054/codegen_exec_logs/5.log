+
+
+def _evaluate_reflection(shape_cells, indicator, side, interval, H, W):
+    visible = []
+    left, right = interval
+    for rr, cc in _mirrored_targets(shape_cells, indicator, side):
+        if 0 <= rr < H and left <= cc <= right:
