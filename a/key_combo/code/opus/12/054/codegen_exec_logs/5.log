+        if w > interval_width:
+            continue
+        if role == "plain":
+            pool.append(shape)
+        elif role in ("left_trunc", "right_trunc"):
+            if interval_width >= 4 and 2 <= w <= min(3, interval_width - 1):
+                pool.append(shape)
+        elif role in ("left_full", "right_full"):
