from arc_utils import Color, bbox_coords, components_mask, in_bounds, neighbors4


def _carrier_color(g: np.ndarray, coords: np.ndarray) -> int:
    adjacent = set()
    for r_raw, c_raw in coords:
        r = int(r_raw)
        c = int(c_raw)
