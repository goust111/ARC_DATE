MIN_GRID_SIZE, MAX_GRID_SIZE = 2, 5
MIN_FOREGROUND_PIXELS, MAX_FOREGROUND_PIXELS = 1, 5
BACKGROUND_COLOR, MIN_BACKGROUND_CELLS, MAX_GENERATION_ATTEMPTS = 0, 2, 300
