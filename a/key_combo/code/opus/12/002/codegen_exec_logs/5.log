+            db = abs(r - b[0]) + abs(c - b[1])
+            color = BLUE if da <= db else RED
+            sprite[r, c] = color
+            blue_count += color == BLUE
+            red_count += color == RED
+        if blue_count >= 2 and red_count >= 2:
+            return sprite
+    raise RuntimeError("failed to color sprite")
