+    return result
+
+
+def _place_noise(
+    grid: np.ndarray,
+    forbidden: np.ndarray,
+    count: int,
+    rng: np.random.Generator,
+) -> None:
+    H, W = grid.shape
+    choices = [
+        (r, c)
+        for r in range(H)
+        for c in range(W)
+        if not forbidden[r, c] and grid[r, c] == BG
+    ]
+    rng.shuffle(choices)
+    used_rows: set[int] = set()
+    used_cols: set[int] = set()
+    placed = 0
+    for r, c in choices:
+        if r in used_rows or c in used_cols:
+            continue
+        grid[r, c] = int(NOISE_COLORS[int(rng.integers(len(NOISE_COLORS)))])
+        used_rows.add(r)
+        used_cols.add(c)
+        placed += 1
+        if placed == count:
+            return
