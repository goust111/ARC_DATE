+    except RuntimeError:
+        return None
+
+    expected = _gen_expected_output(grid, sprite, frames)
+    analysis = _analyze(grid)
+    if analysis["row_bands"] != row_bands or analysis["col_bands"] != col_bands:
+        return None
+    if sorted(analysis["frames"]) != sorted(frames):
