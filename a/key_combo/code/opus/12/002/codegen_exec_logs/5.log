+        for r, c in chosen:
+            remaining[(r, c)] -= 1
+            palette = [col for col in NOISE_COLORS if col != int(sprite[r, c])]
+            new_color = int(palette[int(rng.integers(len(palette)))])
+            if rng.random() < 0.45:
