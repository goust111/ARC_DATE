+    depths: dict[int, int] = {}
+    roots = [i for i, parent in enumerate(parents) if parent is None]
+    stack = [(root, 1) for root in roots]
+    while stack:
+        node, depth = stack.pop()
+        depths[node] = depth
+        for child in children[node]:
+            stack.append((child, depth + 1))
+    return parents, children, depths
