+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PALETTE = (1, 2, 3, 4)
+MAX_SIDE = 30
+GEN_ATTEMPTS = 600
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
