+            r0, c0, r1, c1 = box
+            color = cycle[(depth - 1) % len(cycle)]
+            mask = np.zeros(grid.shape, dtype=bool)
+            mask[r0 + 1 : r1, c0 + 1 : c1] = True
+            if depth < len(group["boxes"]):
+                cr0, cc0, cr1, cc1 = group["boxes"][depth]
+                mask[cr0 : cr1 + 1, cc0 : cc1 + 1] = False
+            out[mask & (grid == BG)] = color
