+    r0, c0, r1, c1 = bbox
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    pts = {tuple(map(int, pt)) for pt in coords}
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    return pts == expected
