+def _is_rectangular_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    if not np.all(grid[r0, c0 : c1 + 1] == FRAME):
+        return False
+    if not np.all(grid[r1, c0 : c1 + 1] == FRAME):
+        return False
+    if not np.all(grid[r0 : r1 + 1, c0] == FRAME):
+        return False
+    if not np.all(grid[r0 : r1 + 1, c1] == FRAME):
+        return False
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    return not np.any(interior == FRAME)
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    frames = []
+    for coords in _components_of_color(grid, FRAME):
+        bbox = _bbox(coords)
+        if _is_rectangular_frame(grid, bbox):
+            frames.append(
+                {
+                    "coords": coords,
+                    "bbox": bbox,
+                    "bbox_area": (bbox[2] - bbox[0] + 1) * (bbox[3] - bbox[1] + 1),
+                }
+            )
+    assert frames, "expected at least one rectangular frame"
+    return frames
