+        if anchor_top:
+            clear_candidates = [r for r in usable_rows if r >= blocked_row + 2]
+        else:
+            clear_candidates = [r for r in usable_rows if r <= blocked_row - 2]
+        if len(clear_candidates) >= pair_count - 1:
