+    except Exception:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_horizontal_instance()
+        if random.random() < 0.5:
+            grid = grid.T.copy()
+        if _validate_instance(grid):
+            return grid
