+    _add_random_decorations(grid, clear_rows, blocked_row, (start, end))
+    return grid
+
+
+def _expected_pair_info(grid: np.ndarray):
+    structural, decorative = _classify_walls(grid)
+    pairs = _find_pairs(grid)
