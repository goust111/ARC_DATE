+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        _in_bounds(g.shape, nr, nc)
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return out
+
+
+def _is_complete_square(grid: np.ndarray, obj: dict) -> bool:
+    r0, c0, r1, c1 = obj["bbox"]
+    color = int(obj["color"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != w or h < 2:
+        return False
+    if not np.all(grid[r0, c0 : c1 + 1] == color):
+        return False
+    if not np.all(grid[r1, c0 : c1 + 1] == color):
+        return False
+    if not np.all(grid[r0 : r1 + 1, c0] == color):
+        return False
+    if not np.all(grid[r0 : r1 + 1, c1] == color):
+        return False
+    return True
