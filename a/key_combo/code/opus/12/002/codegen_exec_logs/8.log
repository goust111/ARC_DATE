    sprite = generate_sprite(
        n=int(m),
        m=int(n),
        symmetry_type=symmetry,
        color_palate=color_palette,
        fill_percentage=density,
        connectivity=connectivity,
        background=background,
        no_repeated_colors=no_repeated_colors,
    )
