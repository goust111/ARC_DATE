+        boxes = [a_bbox, b_bbox]
+        ok = True
+        for r0, c0, r1, c1 in boxes:
+            if r0 < 3 or c0 < 3 or r1 > h - 4 or c1 > w - 4:
+                ok = False
+                break
+        if not ok:
+            continue
+        if not (
+            a_bbox[2] + 1 < b_bbox[0]
+            or b_bbox[2] + 1 < a_bbox[0]
+            or a_bbox[3] + 1 < b_bbox[1]
+            or b_bbox[3] + 1 < a_bbox[1]
