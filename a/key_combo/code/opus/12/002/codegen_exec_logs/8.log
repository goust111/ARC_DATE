+                        _in_bounds(g.shape, nr, nc)
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
