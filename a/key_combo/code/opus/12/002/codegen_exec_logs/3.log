+            if _row_col_reach(corridors, a["r"], a["c"], a["r"], b["c"]) and _row_col_reach(
+                corridors, b["r"], b["c"], a["r"], b["c"]
+            ):
+                reachable_crossings += 1
+        if reachable_crossings == 0:
+            continue
