+            arr = np.array(coords, dtype=int)
+            r0, c0, r1, c1 = bbox_coords(arr)
+            if (
+                len(coords) == 9
+                and r1 - r0 == 2
+                and c1 - c0 == 2
+                and np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color)
+            ):
