+            out[rr, c] = color
+        for rr in range(r + 1, h):
+            if corridors[rr, c]:
+                break
+            out[rr, c] = color
+    return out
+
+
+def _reset_crossings(grid: np.ndarray, corridors: np.ndarray, blocks: list[Block]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for i, (r, _c, _color, _bbox) in enumerate(blocks):
