+    while int(mask.sum()) < target:
+        frontier = set()
+        for r, c in np.argwhere(mask):
+            for nr, nc in _neighbors4(int(r), int(c), h, w):
+                if not mask[nr, nc]:
+                    frontier.add((nr, nc))
+        if not frontier:
+            break
+        nr, nc = list(frontier)[int(rng.integers(0, len(frontier)))]
+        mask[nr, nc] = True
