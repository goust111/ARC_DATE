+def _blank_lines(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    rows = [int(r) for r in range(grid.shape[0]) if np.all(grid[r] == BACKGROUND)]
+    cols = [int(c) for c in range(grid.shape[1]) if np.all(grid[:, c] == BACKGROUND)]
+    return rows, cols
