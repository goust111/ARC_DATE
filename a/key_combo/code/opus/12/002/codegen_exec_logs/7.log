+    assert _components_count(mask) == 1
+    assert np.all(mask.sum(axis=1) >= 1)
+    assert np.all(mask.sum(axis=0) >= 1)
+    return mask
+
+
+def _grow_blue_mask(h: int, w: int, rng: np.random.Generator) -> np.ndarray:
+    mask = _make_covering_backbone(h, w, rng)
