0003: import numpy as np
0004: 
0005: from arc_utils import Color, colors_present
0006: 
0007: 
0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Paint every completely blank row and column red while preserving the foreground pattern.
0011: 
0012:     Input structure
0013:     - The grid contains one background color and one foreground color.
0014:     - The background color is the only color that forms at least one full row or full column.
0015:     - Red is absent from the input and is reserved for the output guide lines.
0016: 
0017:     Rule
0018:     - Find all rows and columns made entirely of the background color.
0019:     - Recolor every cell in those full blank rows and columns red.
0020:     - Leave all other cells unchanged.
0021: 
0022:     Key insight
0023:     - The blank rows and columns are missing guide lines; because they contain no foreground pixels, they can be detected directly as full same-color lines.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     assert g.ndim == 2, "expected a 2D grid"
0027:     assert not np.any(g == Color.RED), "red must be absent from the input"
0028: 
0029:     candidates: list[tuple[int, np.ndarray, np.ndarray]] = []
0030:     for color in colors_present(g):
0031:         row_mask = np.all(g == color, axis=1)
0032:         col_mask = np.all(g == color, axis=0)
0033:         if np.any(row_mask) or np.any(col_mask):
0034:             candidates.append((color, row_mask, col_mask))
0035: 
0036:     assert len(candidates) == 1, "expected exactly one color to form complete rows or columns"
0037:     bg, blank_rows, blank_cols = candidates[0]
0038:     assert len(colors_present(g, exclude={bg})) == 1, "expected one foreground color"
0039:     assert np.any(blank_rows) or np.any(blank_cols), "expected at least one blank row or column"
0040: 
0041:     target = blank_rows[:, None] | blank_cols[None, :]
0042:     assert np.all(g[target] == bg), "blank-line mask must contain only background cells"
0043: 
0044:     out = g.copy()
0045:     out[target] = Color.RED
0046:     return out
0047: 
