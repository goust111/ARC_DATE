+def _expand_with_blank_lines(
+    mask: np.ndarray, blank_rows: list[int], blank_cols: list[int]
+) -> np.ndarray:
+    h = mask.shape[0] + len(blank_rows)
+    w = mask.shape[1] + len(blank_cols)
+    grid = np.zeros((h, w), dtype=int)
