+        stack = [(int(r), int(c))]
+        seen[r, c] = True
+        while stack:
+            cr, cc = stack.pop()
+            for nr, nc in _neighbors4(cr, cc, h, w):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
