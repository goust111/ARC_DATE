+def _components_count(mask: np.ndarray) -> int:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return 0
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    for r, c in coords:
+        if seen[r, c]:
