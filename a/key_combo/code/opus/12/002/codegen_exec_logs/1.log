+    assert (r, c) in {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}, "marker must be in a corner"
+    return r, c
+
+
+def _region_from_seed(grid: np.ndarray, seed: Coord) -> set[Coord]:
+    rr, cc = seed
+    region = _flood_mask(grid, [(rr, cc)], lambda r, c: int(grid[r, c]) != WALL)
