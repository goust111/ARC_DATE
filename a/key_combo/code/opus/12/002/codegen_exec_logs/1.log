+        forbidden |= set(item["source"])  # type: ignore[arg-type]
+        forbidden |= set(item["mirrors"])  # type: ignore[arg-type]
+        patterns.append(item)
+
+    if not _validate_generated(grid, regions, marker, patterns, reachable_region):
+        return None
+    return grid
