+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+PATTERN_COLORS = (2, 3, 4)
+CENTER = 5
+MARKER = 6
+
+GEN_ATTEMPTS = 400
+GRID_RANGE = (17, 23)
+TARGET_REGION_RANGE = (3, 5)
+MIN_REGION_SPAN = 5
+MAX_PATTERNS = 3  # bounded by the three visible pattern colors
+
+
+Coord = tuple[int, int]
+Region = tuple[int, int, int, int]  # r0, r1, c0, c1 inclusive
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _flood_mask(grid: np.ndarray, starts: list[Coord], passable) -> np.ndarray:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[Coord] = deque()
+    for r, c in starts:
+        if _in_bounds(grid.shape, r, c) and not seen[r, c] and passable(r, c):
+            seen[r, c] = True
+            q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and passable(nr, nc):
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
+
+def _connected_components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: list[Coord] = []
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
