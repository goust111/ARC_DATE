+            q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and passable(nr, nc):
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
