+def _solve_from_panels(panels: list[np.ndarray], sep_width: int) -> np.ndarray:
+    ranked = sorted(
+        ((int(np.count_nonzero(_foreground_mask(panel))), idx, panel) for idx, panel in enumerate(panels)),
+        key=lambda item: (item[0], item[1]),
