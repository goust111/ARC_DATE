+def _count_enclosed_black_regions(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    black = grid == BLACK
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not black[r, c] or seen[r, c]:
