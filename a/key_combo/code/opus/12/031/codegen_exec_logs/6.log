   104	def main(grid: np.ndarray) -> np.ndarray:
   105	    """
   106	    Count the enclosed black regions inside the red shape, rotate the whole grid by that amount, then stack two framed copies vertically.
   107	
   108	    Input structure:
   109	    - The input is a small square grid with black background and no blue pixels.
   110	    - A single 4-connected red shape occupies the central area.
   111	    - The red shape may contain 0 to 3 enclosed black 4-connected regions that do not touch the grid boundary.
   112	
   113	    Rule:
   114	    - Count all black 4-connected components that are not connected to any edge cell; call that count N.
   115	    - Rotate the entire input grid clockwise by N quarter-turns.
   116	    - Copy the rotated grid twice and stack the two copies vertically.
   117	    - Surround the stack with a blue one-pixel frame and insert a blue separator row between the copies, but keep the two end pixels of each horizontal frame/separator row black.
   118	
   119	    Key insight:
   120	    - The red shape encodes its own rotation angle through topology: the number of enclosed black holes determines how many 90-degree clockwise turns are applied.
   121	    """
   122	    g = np.asarray(grid, dtype=int)
   123	    assert g.ndim == 2
   124	    assert set(map(int, np.unique(g))).issubset({BLACK, RED})
   125	    assert BLUE not in set(map(int, g.ravel()))
   126	    red_mask = g == RED
   127	    assert red_mask.any()
   128	    assert _component_count(red_mask) == 1
   129	
   130	    turns = _count_enclosed_black_regions(g)
   131	    assert 0 <= turns <= 3
   132	    return _stack_with_blue_frame(_rotate_cw(g, turns))
