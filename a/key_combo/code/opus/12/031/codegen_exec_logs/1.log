+BACKGROUND = 5
+COMPONENT_COLOR = 1
+MARKER_COLOR = 2
+ODD_COLOR = 3
+EVEN_COLOR = 4
+
+GRID_MIN = 12
+GRID_MAX = 16
+MARKER_COUNT_RANGE = (2, 4)
+COMPONENT_COUNT_RANGE = (3, 6)
