    out_h, out_w = canvas.shape
    assert out_h % stamp_h == 0 and out_w % stamp_w == 0, "canvas must be tiled by control-sized blocks"
    macro_h, macro_w = out_h // stamp_h, out_w // stamp_w

    pattern_h, pattern_w = pattern.shape
