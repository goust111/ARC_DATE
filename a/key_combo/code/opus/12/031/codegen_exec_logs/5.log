) -> list[tuple[int, int, int]]:
    height, width = map(int, g.shape)
    cells = []
    step = 1
    rr = r + dr
    cc = c + dc
    while 0 <= rr < height and 0 <= cc < width:
        if int(g[rr, cc]) in colors:
            cells.append((step, rr, cc))
        rr += dr
        cc += dc
        step += 1
    return cells


def main(grid: np.ndarray) -> np.ndarray:
