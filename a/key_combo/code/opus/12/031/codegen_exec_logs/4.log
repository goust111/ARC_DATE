        counts = [base, base, base]
        for i in random.sample(range(3), period - 3 * base):
            counts[i] += 1
        rest = [colors[1]] * counts[1] + [colors[2]] * counts[2]
        random.shuffle(rest)
        word = [colors[0]] * counts[0] + rest

