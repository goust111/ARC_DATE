+def _detect_puzzle_objects(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    candidates = []
+    for comp in _components_of_color(g, BRACKET_COLOR):
+        match = _match_corner_bracket(comp)
+        if match is None:
+            continue
+        r0, c0, r1, c1 = match["bbox"]
+        markers = [
