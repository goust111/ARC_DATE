+import numpy as np
+
+
+BG = 0
+BRACKET_COLOR = 5
+MARKER_COLORS = (1, 2, 3)
+PATTERN_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+ORIENTATIONS = ("tl", "tr", "bl", "br")
+GEN_RETRIES = 400
+
