    h = int(rng.integers(*GEN_ROW_RANGE))
    w = int(rng.integers(*GEN_COL_RANGE))
    domino_count = int(rng.integers(*GEN_DOMINO_COUNT_RANGE))
    single_count = int(rng.integers(*GEN_SINGLE_COUNT_RANGE))
    grid = np.zeros((h, w), dtype=int)

