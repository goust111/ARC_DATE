        size = int(np.random.randint(NOISE_COMPONENT_SIZE_RANGE[0], min(NOISE_COMPONENT_SIZE_RANGE[1], remaining - NOISE_COMPONENT_TAIL_BUFFER) + 1))
        sizes.append(size)
