+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+MARKER_COLOR = 1
+FRAME_COLOR = 5
+
+GRID_ROWS_RANGE = (18, 24)
+GRID_COLS_RANGE = (18, 24)
+FRAME_COUNT_RANGE = (4, 6)
+SMALL_INTERIORS = ((2, 3), (3, 2), (2, 4), (4, 2))
+LARGE_INNER_SIDE_RANGE = (3, 7)
+PLACEMENT_GAP = 1
+GEN_ATTEMPTS = 600
