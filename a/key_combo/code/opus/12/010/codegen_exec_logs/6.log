+GRID_COLS_RANGE = (18, 24)
+FRAME_COUNT_RANGE = (4, 6)
+SMALL_INTERIORS = ((2, 3), (3, 2), (2, 4), (4, 2))
+LARGE_INNER_SIDE_RANGE = (3, 7)
