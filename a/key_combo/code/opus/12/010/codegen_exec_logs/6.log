+    small_visible = False
+    large_clipped = False
+    large_off_center = False
+    blue_growth = int(np.count_nonzero(out == MARKER_COLOR)) > int(np.count_nonzero(inp == MARKER_COLOR))
+
+    for frame in frames:
+        inner_h, inner_w = map(int, frame["inner_shape"])
