+def _small_frame_spec() -> dict[str, object]:
+    inner_h, inner_w = random.choice(SMALL_INTERIORS)
+    gainful = [
+        (r, c)
+        for r in range(inner_h)
+        for c in range(inner_w)
+        if _stamp_cells(inner_h, inner_w, (r, c), 1) != _stamp_cells(inner_h, inner_w, (r, c), 2)
