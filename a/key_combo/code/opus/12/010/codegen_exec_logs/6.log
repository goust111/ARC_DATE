+        placed_here = False
+        for _ in range(PLACEMENT_TRIES_PER_FRAME):
+            r0 = random.choice(row_choices)
+            c0 = random.choice(col_choices)
+            box = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
+            if not _boxes_clear(box, used_boxes):
+                continue
+            used_boxes.append(box)
+            placed[idx] = box
+            placed_here = True
