+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _stamp_cells(inner_h: int, inner_w: int, marker: tuple[int, int], radius: int) -> set[tuple[int, int]]:
