+        r0, c0, r1, c1 = map(int, frame["bbox"])
+        out_patch = out[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
