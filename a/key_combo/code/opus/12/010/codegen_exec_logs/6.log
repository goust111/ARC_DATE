+    used_boxes: list[tuple[int, int, int, int]] = []
+
+    def search(pos: int) -> bool:
+        if pos == len(order):
+            return True
+
+        idx = order[pos]
+        outer_h, outer_w = map(int, specs[idx]["outer_shape"])
+        candidates = [
+            (r0, c0)
