+        "branch": "small",
+    }
+
+
+def _large_frame_spec() -> dict[str, object]:
+    while True:
+        inner_h = random.randint(*LARGE_INNER_SIDE_RANGE)
+        inner_w = random.randint(*LARGE_INNER_SIDE_RANGE)
+        if inner_h * inner_w <= 9:
