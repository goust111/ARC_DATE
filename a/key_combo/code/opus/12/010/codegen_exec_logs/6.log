+    for comp in grey_comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert h >= 3 and w >= 3, "frame must enclose a non-empty interior"
+
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros((h, w), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
