+
+
+def _d4_orbit(r: int, c: int, n: int) -> tuple[tuple[int, int], ...]:
+    m = n - 1
+    coords = {
+        (r, c),
+        (c, m - r),
+        (m - r, m - c),
+        (m - c, r),
+        (r, m - c),
+        (m - r, c),
+        (c, r),
+        (m - c, m - r),
+    }
+    return tuple(sorted(coords))
+
+
+def _all_d4_orbits(n: int) -> list[tuple[tuple[int, int], ...]]:
