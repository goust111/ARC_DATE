+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(n):
+        for c in range(n):
+            if (r, c) in seen:
+                continue
+            orbit = _d4_orbit(r, c, n)
+            seen.update(orbit)
+            orbits.append(orbit)
+    return orbits
+
+
+PATTERN_ORBITS = _all_d4_orbits(PATTERN_SIZE)
+
+
+def _recover_pattern(pattern: np.ndarray) -> np.ndarray:
