+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+
+    return components
+
+
+def _d4_orbit(r: int, c: int, n: int) -> tuple[tuple[int, int], ...]:
+    m = n - 1
+    coords = {
+        (r, c),
+        (c, m - r),
+        (m - r, m - c),
+        (m - c, r),
+        (r, m - c),
+        (m - r, c),
+        (c, r),
+        (m - c, m - r),
+    }
