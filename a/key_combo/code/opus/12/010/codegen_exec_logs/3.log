+    cols = random.randint(*GRID_COLS_RANGE)
+    frame_count = random.randint(*FRAME_COUNT_RANGE)
+
+    inner_sizes = [
+        _sample_inner_dims(force_parity="odd"),
+        _sample_inner_dims(force_parity="even"),
+    ]
