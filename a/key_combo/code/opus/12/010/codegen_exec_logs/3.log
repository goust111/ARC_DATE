def _gen_perimeter(size: tuple[int, int]) -> int:
    h, w = size
    return 2 * (h + w) - 4


_GEN_SIZE_POOL = tuple(
    (h, w)
    for h in range(_GEN_LOOP_SIZE_MIN, _GEN_LOOP_SIZE_MAX + 1)
