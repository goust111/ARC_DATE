+    return out
+
+
+def _sample_inner_dims(force_parity: str | None = None) -> tuple[int, int]:
+    while True:
+        inner_h = random.choice(INNER_DIM_VALUES)
+        inner_w = random.choice(INNER_DIM_VALUES)
+        area_is_even = (inner_h * inner_w) % 2 == 0
