_GEN_LOOP_COUNT_OPTIONS = (2, 3, 4)
_GEN_APPEND_TOTAL_MIN = 2
_GEN_APPEND_TOTAL_MAX = 10
_GEN_MIN_ENDPOINTS = 2
_GEN_MAX_ENDPOINTS = 10
