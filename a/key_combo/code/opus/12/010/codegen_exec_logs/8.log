_MARKER_TO_STENCIL = {
    Color.BLUE: ((0, 0, 1), (1, 1, 0), (0, 1, 0)),
    Color.RED: ((0, 0, 0), (1, 1, 1), (0, 0, 0)),
    Color.GREEN: ((0, 1, 1), (0, 1, 0), (0, 1, 0)),
