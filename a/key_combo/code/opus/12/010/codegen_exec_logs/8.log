    total_min, total_max = GEN_DISTRACTOR_TOTAL_PIXELS_RANGE
    fg_min, fg_max = GEN_TOTAL_FG_PIXELS_RANGE
    frac_min, frac_max = GEN_DOMINANT_FRACTION_RANGE
    per_min, per_max = GEN_DISTRACTOR_PIXELS_PER_COLOR_RANGE
