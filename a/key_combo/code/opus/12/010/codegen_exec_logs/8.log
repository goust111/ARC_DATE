from itertools import combinations

def neigh(cell):
    r,c=cell
    return {(r-1,c),(r+1,c),(r,c-1),(r,c+1)}

def conn(cells):
    cells=set(cells)
    seen={next(iter(cells))}
    stack=list(seen)
    while stack:
        x=stack.pop()
        for y in neigh(x)&cells:
            if y not in seen:
                seen.add(y); stack.append(y)
    return len(seen)==len(cells)

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

for n in range(3,6):
    shapes=set()
    stable=[]
    # search in 4x4 box
    pts=[(r,c) for r in range(4) for c in range(4)]
    for cells in combinations(pts,n):
        if not conn(cells):
            continue
        nm=norm(cells)
        if nm in shapes:
            continue
        shapes.add(nm)
        mindeg=min(sum(nb in cells for nb in neigh(x)) for x in cells)
        if mindeg>=2:
            stable.append(nm)
    print('n',n,'stable',len(stable))
    for s in stable[:20]:
        print(s)
