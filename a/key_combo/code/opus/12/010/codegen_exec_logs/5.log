+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    if np.array_equal(inp, expected):
+        return None
+    if int(np.count_nonzero(expected[:, 4:] == color)) == 0:
+        return None
+    if set(map(int, np.unique(inp[:, 4:]))) != {BLACK, GREY, MAROON}:
+        return None
+    return inp, expected
+
