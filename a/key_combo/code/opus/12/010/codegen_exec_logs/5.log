_GEN_CANVAS_MAX_EXCLUSIVE = 16
_GEN_SPLIT_MIN_RATIO = 0.30
_GEN_SPLIT_MAX_RATIO = 0.70
_GEN_SPLIT_TYPES = ("horizontal", "vertical")

# Red rectangle layout.
_GEN_RECT_SIZES = (
    (1, 1),
    (1, 2),
    (2, 1),
    (2, 2),
    (2, 3),
    (2, 4),
    (3, 2),
    (4, 2),
)
