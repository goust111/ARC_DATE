+
+    out = np.asarray(analysis["output"], dtype=int)
+    if out.ndim != 2 or max(out.shape) > 30:
+        return False
+    return np.array_equal(main(g), out)
+
+
+def _generate_attempt() -> np.ndarray | None:
+    width = random.choice([10, 12, 14, 16])
