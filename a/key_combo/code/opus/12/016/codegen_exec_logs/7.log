+    if len(components) < 2:
+        return False
+    if int(kept["area"]) >= sum(int(comp["area"]) for comp in components):
+        return False
+    if not any(int(comp["area"]) < int(kept["area"]) for comp in components if comp is not kept):
+        return False
+    if any(int(comp["bbox"][0]) == int(analysis["min_top_row"]) for comp in ties if comp is not kept):
+        return False
+
+    out = np.asarray(analysis["output"], dtype=int)
+    if out.ndim != 2 or max(out.shape) > 30:
+        return False
+    return np.array_equal(main(g), out)
+
+
+def _generate_attempt() -> np.ndarray | None:
+    width = random.choice([10, 12, 14, 16])
+    height = width // 2
+    run_length = random.randint(3, min(6, height))
