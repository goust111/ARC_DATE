+def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:
+    h, w = grid.shape
+    if not _in_bounds((h, w), r, c):
+        return False
+    if int(grid[r, c]) not in {BLACK, PINK}:
+        return False
+
+    if direction in {"left", "right"}:
+        if r == 0 or r == h - 1:
+            return False
+        a, b = int(grid[r - 1, c]), int(grid[r + 1, c])
+    else:
+        if c == 0 or c == w - 1:
