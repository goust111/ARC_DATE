+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+PINK = 6
+ORANGE = 7
+
+DELTAS = {
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+    "up": (-1, 0),
+}
+PERPENDICULAR = {
+    "right": ("up", "down"),
+    "down": ("left", "right"),
+    "left": ("up", "down"),
+    "up": ("left", "right"),
+}
+ROT_K = {
+    "right": 0,
+    "down": 3,  # clockwise 90
+    "left": 2,
+    "up": 1,  # clockwise 270
