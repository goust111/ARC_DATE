+
+BLACK = 0
+GREEN = 3
+PINK = 6
+ORANGE = 7
+
+DELTAS = {
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+    "up": (-1, 0),
+}
+PERPENDICULAR = {
+    "right": ("up", "down"),
+    "down": ("left", "right"),
+    "left": ("up", "down"),
+    "up": ("left", "right"),
+}
