+def _trace_particle(grid: np.ndarray) -> tuple[list[tuple[int, int]], str]:
+    starts = np.argwhere(grid == PINK)
+    assert starts.shape == (1, 2), "expected exactly one magenta particle"
+    r, c = map(int, starts[0])
