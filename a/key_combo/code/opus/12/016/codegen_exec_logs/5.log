+
+def _path_bbox(vertices: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    cells = _path_cells(vertices)
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    return min(rs), min(cs), max(rs), max(cs)
