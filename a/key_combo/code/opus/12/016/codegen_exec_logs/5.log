+        count = random.randint(4, 6)
+        picks = random.sample(range(9), count)
+        for idx in picks:
+            patch[idx // 3, idx % 3] = GREEN
+        if any(np.array_equal(patch, np.rot90(patch, k)) for k in (1, 2, 3)):
+            continue
+        return patch
+    raise RuntimeError("failed to generate asymmetric tile")
