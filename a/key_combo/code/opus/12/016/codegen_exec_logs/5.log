+    grid[r0 - 1 : r0 + height + 1, c0 + width] = ORANGE
+    grid[r0 - 1, c0 - 1 : c0 + width + 1] = ORANGE
+    grid[r0 + height, c0 - 1 : c0 + width + 1] = ORANGE
+
