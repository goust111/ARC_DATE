+    idx = 0
+    for rr in range(r0, r1 + 1, 3):
+        for cc in range(c0, c1 + 1, 3):
+            block = base if idx % 2 == 0 else np.rot90(base, 2)
+            out[rr : rr + 3, cc : cc + 3] = block
+            idx += 1
+
+    return out
+
