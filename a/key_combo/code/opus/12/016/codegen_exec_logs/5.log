+    original = g.copy()
+    path, final_dir = _trace_particle(original)
+    rect = _largest_black_rectangle(original)
+
+    out = original.copy()
+    for r, c in path[1:]:
+        if int(out[r, c]) == BLACK:
+            out[r, c] = PINK
