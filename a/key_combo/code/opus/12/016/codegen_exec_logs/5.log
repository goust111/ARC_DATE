+
+def _draw_stripes(grid: np.ndarray) -> None:
+    h, w = grid.shape
+    for r in range(0, h, 4):
+        grid[r, :] = ORANGE
+    for c in range(0, w, 4):
+        grid[:, c] = ORANGE
