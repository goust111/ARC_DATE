+    return "down" if b[0] > a[0] else "up"
+
+
+def _paint_path(grid: np.ndarray, vertices: list[tuple[int, int]]) -> None:
+    h, w = grid.shape
+    dirs = [_direction(a, b) for a, b in zip(vertices, vertices[1:])]
+
