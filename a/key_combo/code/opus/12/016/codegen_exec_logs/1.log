+def _select_bars_for_quadrant(
+    bars: list[dict],
+    candidate_count: int,
+) -> list[dict] | None:
+    for first in bars:
+        blocked = set(first["blocked"])
+        if len(blocked) < candidate_count:
+            selected = [first]
+            if random.random() < 0.45:
+                for second in bars:
