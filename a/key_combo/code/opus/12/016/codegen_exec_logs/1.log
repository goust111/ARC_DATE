+    if quadrant == "TR":
+        return mr - gap_r - h, mc + 2 + gap_c
+    if quadrant == "BL":
+        return mr + 2 + gap_r, mc - gap_c - w
+    return mr + 2 + gap_r, mc + 2 + gap_c
+
