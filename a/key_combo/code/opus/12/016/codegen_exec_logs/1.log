+    out = g.copy()
+    for r, c in source_coords:
+        for target in _reflect_targets(r, c, mr, mc):
+            tr, tc = target
+            if int(g[tr, tc]) == MARKER:
+                continue
+            if _reachable(g, mr, mc, target):
+                out[tr, tc] = SOURCE
