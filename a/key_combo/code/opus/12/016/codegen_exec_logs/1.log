+    vr = -1 if r < mr else 1
+    vc = -1 if c < mc else 1
+    row_gap = mr - r if r < mr else r - (mr + 1)
+    col_gap = mc - c if c < mc else c - (mc + 1)
+    assert row_gap >= 1 and col_gap >= 1
+
+    if row_gap == col_gap:
+        rr = mr - 1 if vr < 0 else mr + 2
+        cc = mc - 1 if vc < 0 else mc + 2
+        path = []
+        while True:
+            path.append((rr, cc))
+            if (rr, cc) == (r, c):
+                return path
+            rr += vr
+            cc += vc
+
+    if row_gap > col_gap:
+        rr = mr - 1 if vr < 0 else mr + 2
