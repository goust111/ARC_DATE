+    if not np.array_equal(main(out), out):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_SIDE_RANGE)
+    width = random.randint(*GRID_SIDE_RANGE)
