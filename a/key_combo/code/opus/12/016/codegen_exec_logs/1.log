        for c in range(1, 4):
            if not keep[r, c] or len(owners[r][c]) != 1:
                continue
            owner = next(iter(owners[r][c]))
            if _run_reaches_target_edge(owners, owner, r, c, top_corner=top_corner):
                continue
            if owner not in owners[toward(r)][c]:
