+    return mr + 2, h - 1, mc + 2, w - 1
+
+
+def _ray_family(mr: int, mc: int, cell: tuple[int, int]) -> str:
+    r, c = cell
+    row_gap = mr - r if r < mr else r - (mr + 1)
+    col_gap = mc - c if c < mc else c - (mc + 1)
+    if row_gap == col_gap:
+        return "diag"
+    if row_gap > col_gap:
+        return "vert"
+    return "horiz"
