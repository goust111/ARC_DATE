+    for first in bars:
+        blocked = set(first["blocked"])
+        if len(blocked) < candidate_count:
+            selected = [first]
+            if random.random() < 0.45:
+                for second in bars:
+                    if second is first or not _bars_compatible(selected, second):
+                        continue
+                    union = blocked | set(second["blocked"])
+                    if 1 <= len(union) < candidate_count:
