+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SOURCE = 2
+MARKER = 3
+OBSTACLE = 7
+
+QUADRANTS = ("TL", "TR", "BL", "BR")
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIDE_RANGE = (13, 19)
+MARKER_MARGIN = 4
+SOURCE_SIZE_RANGE = (4, 8)
+SOURCE_BOX_RANGE = (3, 5)
+BAR_LENGTH_RANGE = (3, 6)
