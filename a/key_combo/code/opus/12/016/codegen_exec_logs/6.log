+
+            steps = max(abs(delta_r), abs(delta_c))
+            step_r = 0 if delta_r == 0 else (1 if delta_r > 0 else -1)
+            step_c = 0 if delta_c == 0 else (1 if delta_c > 0 else -1)
+            ok = True
+            for t in range(steps):
+                pos2 = (
+                    tf["rotated_top_left"][0] + step_r * t,
