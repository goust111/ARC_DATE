+        dr = b[0] - a[2] - 1
+    elif b[2] < a[0]:
+        dr = a[0] - b[2] - 1
+    dc = 0
+    if a[3] < b[1]:
+        dc = b[1] - a[3] - 1
+    elif b[3] < a[1]:
+        dc = a[1] - b[3] - 1
+    return max(dr, dc) if dr == 0 or dc == 0 else min(dr, dc)
