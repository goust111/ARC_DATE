+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    comps = _components(np.isin(grid, [BLUE, RED]))
+    out = []
+    for coords in comps:
+        out.append(_component_info(grid, coords))
+    return out
+
+
+def _build_scaled_component_id(grid: np.ndarray, comps: list[dict]) -> np.ndarray:
+    h, w = grid.shape
