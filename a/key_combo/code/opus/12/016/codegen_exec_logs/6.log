+    out = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            if ray_dir == "right" and c0 <= target_c + 1:
+                continue
+            if ray_dir == "left" and c0 + pw - 1 >= target_c - 1:
+                continue
+            if ray_dir == "down" and r0 <= target_r + 1:
+                continue
+            if ray_dir == "up" and r0 + ph - 1 >= target_r - 1:
