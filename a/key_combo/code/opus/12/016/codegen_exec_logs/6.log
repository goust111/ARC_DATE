+    cr = (h - 1) / 2.0
+    cc = (w - 1) / 2.0
+    dr = mr - cr
+    dc = mc - cc
+    if abs(dr) < 1e-9:
+        return "right" if dc > 0 else "left"
+    if abs(dc) < 1e-9:
+        return "down" if dr > 0 else "up"
+    if abs(dr) >= abs(dc):
+        return "down" if dr > 0 else "up"
+    return "right" if dc > 0 else "left"
+
+
+def _anchor_local(mask: np.ndarray) -> tuple[int, int]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    cr = (mask.shape[0] - 1) / 2.0
+    cc = (mask.shape[1] - 1) / 2.0
