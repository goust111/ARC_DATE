def _gen_mark_half_path(half: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:
    r, c = a
    tr, tc = b
    half[r, c] = True
    while (r, c) != (tr, tc):
        moves = []
        if r < tr:
            moves.append((r + 1, c))
        elif r > tr:
            moves.append((r - 1, c))
        if c < tc:
            moves.append((r, c + 1))
        elif c > tc:
            moves.append((r, c - 1))
