+def _component_abs_coords(patch: np.ndarray, top_left: tuple[int, int]) -> np.ndarray:
+    r0, c0 = top_left
+    coords = np.argwhere(patch != BLACK)
+    coords[:, 0] += int(r0)
+    coords[:, 1] += int(c0)
+    return coords
