+        while 0 <= rr < h and 0 <= cc < w:
+            if scaled_ids[rr, cc] >= 0:
+                key = (int(scaled_ids[rr, cc]), "right")
+                hits[key] = min(hits.get(key, 10**9), dist)
+                break
+            if int(scaled_grid[rr, cc]) != BLACK:
