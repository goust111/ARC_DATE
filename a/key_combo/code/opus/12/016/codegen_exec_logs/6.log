+def _placement_candidates(
+    grid: np.ndarray,
+    structures: list[tuple[int, int]],
+    target_idx: int,
+    patch: np.ndarray,
+    ray_dir: str,
+    reserved_final: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    target_center = structures[target_idx]
+    target_r, target_c = target_center
+    target_bbox_scaled = {
