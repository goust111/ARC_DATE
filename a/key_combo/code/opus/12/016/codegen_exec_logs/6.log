   452	        for c in cols:
   453	            if any(r == rr or c == cc for rr, cc in centers):
   454	                continue
   455	            bb = (r - 1, c - 1, r + 1, c + 1)
   456	            if any(_bbox_gap(bb, (rr - 1, cc - 1, rr + 1, cc + 1)) < 2 for rr, cc in centers):
