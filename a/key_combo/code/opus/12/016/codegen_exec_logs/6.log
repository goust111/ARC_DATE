+
+def _paint_original_patch(grid: np.ndarray, patch: np.ndarray, top_left: tuple[int, int]) -> None:
+    r0, c0 = top_left
+    h, w = patch.shape
+    sub = grid[r0 : r0 + h, c0 : c0 + w]
+    sub[patch != BLACK] = patch[patch != BLACK]
+
+
+def _unmatched_candidate_positions(
