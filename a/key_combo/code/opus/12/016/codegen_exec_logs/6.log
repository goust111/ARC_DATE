+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "patch": patch,
+        "mask": mask,
+        "marker_dir": marker_dir,
+        "rotation_k": k,
+        "anchor_local": _anchor_local(mask),
+    }
+
+
+def _find_structures(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
