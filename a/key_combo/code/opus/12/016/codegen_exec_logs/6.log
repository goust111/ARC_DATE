   347	def main(grid: np.ndarray) -> np.ndarray:
   348	    """
   349	    Double the grid, ray-match each marked tetromino to a boxed cavity, rotate it from its marker, and dock it into the cavity.
   350	
   351	    Input structure:
   352	    - The background is black.
   353	    - There are 2-3 grey 3x3 box structures whose center cell is a black cavity.
   354	    - There are 2-3 movable blue components, each a 4-connected 4-cell L or T tetromino with exactly one red marker pixel.
   355	
   356	    Rule:
   357	    - First upscale the whole grid by a factor of two so every input pixel becomes a 2x2 block.
   358	    - For each structure, cast axis-aligned rays outward from the scaled cavity lines; the first hit movable component is that structure's partner and the hit side identifies the docking side.
   359	    - Read the component's marker position inside its original tight bbox: above -> 0 degrees, right -> 90 clockwise, below -> 180 degrees, left -> 270 clockwise; rotate the upscaled component accordingly around its bbox center.
   360	    - Move the rotated component inward from its hit side until its central 2x2 anchor block lands exactly on the structure's 2x2 cavity, erase the component's original position to black, and paint the traversed path maroon.
   361	    - Components that are never hit by any structure ray stay in place.
   362	
   363	    Key insight:
   364	    - The 2x upscale is not cosmetic: it creates a 2x2 cavity that the rotated component can dock into, while the single red marker independently encodes how much that component must rotate before sliding.
   365	    """
   366	    g = np.asarray(grid, dtype=int)
   367	    if g.ndim != 2:
   368	        raise ValueError("expected a 2D grid")
   369	
   370	    analysis = _analyze_scene(g)
   371	    out = _scale2(g)
   372	
   373	    for assignment in analysis["assignments"]:
   374	        comp = analysis["components"][assignment["component_idx"]]
   375	        structure = analysis["structures"][assignment["structure_idx"]]
   376	        tf = _transform_component_for_target(comp, structure["center"])
   377	
   378	        for r, c in comp["coords"]:
   379	            rr = int(r) * 2
   380	            cc = int(c) * 2
   381	            out[rr : rr + 2, cc : cc + 2] = BLACK
   382	
   383	        delta_r, delta_c = tf["delta"]
   384	        steps = max(abs(delta_r), abs(delta_c))
   385	        step_r = 0 if delta_r == 0 else (1 if delta_r > 0 else -1)
   386	        step_c = 0 if delta_c == 0 else (1 if delta_c > 0 else -1)
   387	        for t in range(steps):
   388	            pos = (
   389	                tf["rotated_top_left"][0] + step_r * t,
   390	                tf["rotated_top_left"][1] + step_c * t,
   391	            )
   392	            _paint_patch(out, tf["rotated_patch"], pos, color=MAROON)
   393	
