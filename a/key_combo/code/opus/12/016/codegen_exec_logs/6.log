+        for rr in range(2 * (target_r - 1), 2 * (target_r + 2))
+        for cc in range(2 * (target_c - 1), 2 * (target_c + 2))
+    }
+    other_struct_scaled = set()
+    for i, (sr, sc) in enumerate(structures):
+        if i == target_idx:
+            continue
