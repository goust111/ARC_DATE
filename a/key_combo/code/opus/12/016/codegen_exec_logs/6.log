+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_ORDER = ("up", "right", "down", "left")
+ROTATION_K = {"up": 0, "right": 3, "down": 2, "left": 1}
