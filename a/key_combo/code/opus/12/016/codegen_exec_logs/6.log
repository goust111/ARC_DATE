   431	def _bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
   432	    dr = 0
   433	    if a[2] < b[0]:
   434	        dr = b[0] - a[2] - 1
   435	    elif b[2] < a[0]:
   436	        dr = a[0] - b[2] - 1
   437	    dc = 0
   438	    if a[3] < b[1]:
   439	        dc = b[1] - a[3] - 1
   440	    elif b[3] < a[1]:
   441	        dc = a[1] - b[3] - 1
   442	    return max(dr, dc) if dr == 0 or dc == 0 else min(dr, dc)
