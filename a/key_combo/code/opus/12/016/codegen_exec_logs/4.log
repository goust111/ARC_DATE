我在把生成器改成“先找一组满足距离条件的锚点，再向安全方向长出不规则分量”。这样能显式控制邻接图、分支覆盖和拒绝条件，而不是靠低概率随机碰运气。
exec
/bin/bash -lc "python - <<'PY'
import itertools
from collections import Counter

def cheb(a,b):
    return max(abs(a[0]-b[0]), abs(a[1]-b[1]))

def degrees(points):
    n=len(points)
    deg=[0]*n
    for i in range(n):
        for j in range(i+1,n):
            d=cheb(points[i],points[j])
            if d==2:
                deg[i]+=1;deg[j]+=1
    return tuple(deg)

for n in [4,5,6]:
    found=[]
    pts=[(r,c) for r in range(7) for c in range(7)]
    # symmetry breaking: include (0,0)
    for comb in itertools.combinations(pts[1:], n-1):
        P=((0,0),)+comb
        ds=[cheb(a,b) for a,b in itertools.combinations(P,2)]
        if min(ds)<2 or max(ds)>4:
            continue
        deg=degrees(P)
        if len(set(deg))==1:
            continue
        if sum(d==2 for d in ds) < 2:
            continue
        if not any(d>3 for d in ds):
            continue
        # prefer some ties and max degree >=2
        if max(deg)<2:
            continue
        bbox=(max(r for r,c in P), max(c for r,c in P))
        found.append((bbox,deg,P))
        if len(found)>=10:
            break
    print('n',n,'found',len(found))
    for bbox,deg,P in found[:5]:
        print(' bbox',bbox,'deg',deg,'pts',P)
    print()
