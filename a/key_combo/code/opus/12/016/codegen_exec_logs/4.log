+            center=center,
+            target_area=targets[idx],
+        )
+        if grown is None:
+            return None
+        occupied[idx] = grown
+
+    grid = np.zeros((height, width), dtype=int)
+    for color, cells in zip(colors, occupied):
+        for r, c in cells:
+            grid[r, c] = color
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
