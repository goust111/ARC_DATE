  39: def main(grid: np.ndarray) -> np.ndarray:
  40:     """
  41:     Paint the top-connected middle channel between two orange path components teal.
  42: 
  43:     Input structure
  44:     - The background is black.
  45:     - One foreground color forms exactly two 4-connected one-pixel-wide path components.
  46:     - Optional non-background control pixels may sit in the channel between the two paths.
  47: 
  48:     Rule
  49:     - Dilate each path component by one cell in the 8-neighborhood and intersect the two dilations; this gives the one-cell-wide middle channel.
  50:     - A control pixel in that channel is a blocker only when its 4-neighbors touch fewer than both path components; otherwise it is part of the channel and is repainted.
  51:     - After removing blockers, paint the channel component connected to the top edge teal and keep all other pixels unchanged.
  52: 
  53:     Key insight
  54:     - The desired pixels are not found by region filling; they are the geometric overlap of the two paths' one-cell halos, with weakly attached control pixels splitting the channel.
  55:     """
  56:     g = np.asarray(grid, dtype=int)
  57:     assert g.ndim == 2, "expected a 2D grid"
  58:     bg = get_bg(g)
  59:     assert bg == Color.BLACK, "expected black background"
  60: 
  61:     path_color = _path_color(g, bg)
  62:     path_labels, n_paths = label_mask(g == path_color, connectivity=4)
  63:     assert n_paths == 2, "expected two path components"
  64: 
  65:     channel = g != path_color
  66:     for label_id in range(1, n_paths + 1):
  67:         channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)
  68:     assert np.any(channel), "expected a middle channel between the paths"
  69: 
  70:     blocked = []
  71:     for r_raw, c_raw in np.argwhere(channel & (g != bg)):
  72:         r = int(r_raw)
  73:         c = int(c_raw)
  74:         adjacent = _adjacent_path_labels(path_labels, r, c)
  75:         assert adjacent, "control pixel in channel must touch a path component"
  76:         if len(adjacent) < n_paths:
  77:             blocked.append((r, c))
  78:         else:
  79:             assert len(adjacent) == n_paths, "channel control pixel cannot touch extra path labels"
  80: 
  81:     passable = channel.copy()
  82:     for r, c in blocked:
  83:         passable[r, c] = False
  84: 
  85:     channel_labels, n_channels = label_mask(passable, connectivity=4)
  86:     assert n_channels >= 1, "expected at least one passable channel component"
  87:     top_components = [
  88:         label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)
  89:     ]
  90:     assert len(top_components) == 1, "expected exactly one channel component connected to the top edge"
  91: 
  92:     paint = channel_labels == top_components[0]
  93:     assert np.any(paint), "expected cells to paint"
  94:     out = g.copy()
  95:     out[paint] = Color.TEAL
  96:     return out
