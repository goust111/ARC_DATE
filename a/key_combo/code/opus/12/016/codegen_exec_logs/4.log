+
+def _transform_points(points, mode):
+    pts = []
+    for r, c in points:
+        if mode == 0:
+            nr, nc = r, c
+        elif mode == 1:
+            nr, nc = r, -c
+        elif mode == 2:
+            nr, nc = -r, c
+        elif mode == 3:
+            nr, nc = -r, -c
+        elif mode == 4:
+            nr, nc = c, r
+        elif mode == 5:
+            nr, nc = c, -r
+        elif mode == 6:
+            nr, nc = -c, r
+        else:
+            nr, nc = -c, -r
+        pts.append((nr, nc))
+    min_r = min(r for r, _ in pts)
+    min_c = min(c for _, c in pts)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in pts))
+
