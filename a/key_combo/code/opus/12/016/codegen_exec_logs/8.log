+    for r in range(h):
+        if not path[r, mid]:
+            continue
+        color = BLUE
+        for layer in reversed(layers):
+            rect = layer["rect"]
+            assert isinstance(rect, tuple)
+            if _inside(rect, r, mid):
+                color = int(layer["color"])
