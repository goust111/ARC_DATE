+            lr, lc = left_cells[int(rng.integers(len(left_cells)))]
+            rr, rc = right_cells[int(rng.integers(len(right_cells)))]
+            grid[lr, lc] = GREEN
+            grid[rr, rc] = GREEN
+
+            for row in chosen_rows[2:]:
