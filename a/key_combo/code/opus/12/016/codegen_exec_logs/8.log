+    path = np.zeros_like(g, dtype=bool)
+    for _r, c in markers:
+        c = int(c)
+        path[:, c] = True
+        if c < mid:
+            path[0, c:] = True
+            path[h - 1, : c + 1] = True
+        elif c > mid:
+            path[0, : c + 1] = True
+            path[h - 1, c:] = True
+        else:
+            path[0, c:] = True
+            path[h - 1, : c + 1] = True
