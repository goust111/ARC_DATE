+                        "first_color": int(seq[0]),
+                        "multi_color": len(set(seq)) >= 2,
+                        "k1_center": (center_r + dr, center_c + dc),
+                    }
+                )
+    candidates.sort(key=lambda item: (item["angle"], len(item["seq"])))
