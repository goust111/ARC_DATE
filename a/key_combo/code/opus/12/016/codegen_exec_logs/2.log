+    center_c = float(np.mean(sprite_coords[:, 1]))
+    ordered = sorted(
+        [(math.atan2(dr, dc) % (2 * math.pi), dr, dc) for dr, dc in vectors],
+        key=lambda item: item[0],
+    )
+
+    for _ang, dr, dc in ordered:
