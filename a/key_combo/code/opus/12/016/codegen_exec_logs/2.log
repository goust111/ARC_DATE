+                    "vector": (int(dr), int(dc)),
+                    "guide": guide_coords,
+                    "seq": seq,
+                    "sig": _vector_signature(dr, dc),
+                    "angle": math.atan2(dr, dc) % (2 * math.pi),
+                    "first_color": int(seq[0]),
+                    "multi_color": len(set(seq)) >= 2,
+                    "k1_center": (center_r + dr, center_c + dc),
+                }
