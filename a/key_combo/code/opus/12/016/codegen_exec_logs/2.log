+            cols = [c for c in cols if c != c1]
+        return [(r1, c) for c in cols]
+    if side == "left":
+        if omit_side == "left":
+            return []
+        rows = list(range(r0, r1 + 1))
+        if omit_side == "top":
+            rows = [r for r in rows if r != r0]
+        if omit_side == "bottom":
+            rows = [r for r in rows if r != r1]
+        return [(r, c0) for r in rows]
+    if omit_side == "right":
+        return []
+    rows = list(range(r0, r1 + 1))
+    if omit_side == "top":
+        rows = [r for r in rows if r != r0]
+    if omit_side == "bottom":
+        rows = [r for r in rows if r != r1]
+    return [(r, c1) for r in rows]
