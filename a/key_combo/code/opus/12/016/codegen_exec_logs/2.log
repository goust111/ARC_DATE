+    ideal_c = (c0 + c1) // 2 - 1
+    row_lo = max(r0 + 1, ideal_r - 1)
+    row_hi = min(r1 - 3, ideal_r + 1)
+    col_lo = max(c0 + 1, ideal_c - 1)
+    col_hi = min(c1 - 3, ideal_c + 1)
