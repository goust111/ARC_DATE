+        if side == "top":
+            r0_lo = max(r0_lo, int(rows.max()) + 1)
+            r0_hi = min(r0_hi, int(math.floor(centroid_r)))
+        elif side == "bottom":
+            r1_lo = max(r1_lo, int(math.ceil(centroid_r)))
+            r1_hi = min(r1_hi, int(rows.min()) - 1)
+        elif side == "left":
