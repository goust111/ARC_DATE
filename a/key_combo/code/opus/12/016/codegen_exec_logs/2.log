+    r0_max = min(sr0 - 1, cr1 - min_margin_to_container - 4)
+    c0_min = max(cc0 + min_margin_to_container, sc0 - 3)
+    c0_max = min(sc0 - 1, cc1 - min_margin_to_container - 4)
