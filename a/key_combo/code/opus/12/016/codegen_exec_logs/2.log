+
+        candidates = _build_candidate_guides((h, w), layers, sprite_coords)
+        if not candidates:
+            continue
+        selected = _choose_guides(candidates, len(layers))
+        if not selected:
+            continue
+
+        inp = _make_input_grid((h, w), layers, raw_specs, sprite_coords, selected)
