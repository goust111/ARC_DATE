+            continue
+
+        for _ in range(120):
+            top = random.randint(2, 4)
+            bottom = random.randint(2, 4)
+            left = random.randint(2, 4)
+            right = random.randint(2, 4)
+            child = (pr0 + top, pc0 + left, pr1 - bottom, pc1 - right)
