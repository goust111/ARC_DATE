+
+def _guides_far_apart(selected: list[dict]) -> bool:
+    for a, b in combinations(selected, 2):
+        a_cells = {tuple(map(int, p)) for p in a["guide"]}
+        b_cells = {tuple(map(int, p)) for p in b["guide"]}
+        for ar, ac in a_cells:
