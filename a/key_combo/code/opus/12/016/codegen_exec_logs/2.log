+    return layers, rects, raw_specs
+
+
+def _side_positions(rect: tuple[int, int, int, int], side: str, omit_side: str | None) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    if side == "top":
+        if omit_side == "top":
+            return []
+        cols = list(range(c0, c1 + 1))
+        if omit_side == "left":
+            cols = [c for c in cols if c != c0]
+        if omit_side == "right":
