+            if not _guides_far_apart(list(combo)):
+                continue
+            used_colors = set()
+            for item in combo:
+                used_colors.update(item["seq"])
+            if len(used_colors) < min(2, layer_count):
+                continue
+            if multi_color_exists and not any(item["multi_color"] for item in combo):
+                continue
+            combos.append(list(combo))
+        if combos:
+            break
