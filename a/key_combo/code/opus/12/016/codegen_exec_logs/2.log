+            continue
+        candidates = _infer_vector_candidates(sprite_coords, guide)
+        norms = [a * a + b * b for a, b in candidates]
+        best_norm = max(norms)
+        if sum(int(n == best_norm) for n in norms) != 1:
+            continue
+        return guide
+    return None
+
+
+def _choose_outer_from_guides(
+    shape: tuple[int, int], sprite_coords: np.ndarray, guides: list[dict]
