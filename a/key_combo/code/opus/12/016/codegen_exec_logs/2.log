+) -> list[dict]:
+    h, w = shape
+    outer = layers[0]["rect"]
+    center_r = float(np.mean(sprite_coords[:, 0]))
+    center_c = float(np.mean(sprite_coords[:, 1]))
+    sprite_list = [tuple(map(int, p)) for p in sprite_coords]
+    candidates = []
+    for dr in range(-8, 9):
+        for dc in range(-8, 9):
+            if dr == 0 and dc == 0:
+                continue
