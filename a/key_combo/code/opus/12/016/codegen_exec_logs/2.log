+    c1_min = max(sc1 + 1, cc0 + min_margin_to_container + 4)
+    c1_max = min(cc1 - min_margin_to_container, sc1 + 3)
+    if r0_min > r0_max or c0_min > c0_max or r1_min > r1_max or c1_min > c1_max:
+        return None
+    for _ in range(80):
