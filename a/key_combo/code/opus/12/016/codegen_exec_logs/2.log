+def _ordered_layers_from_grid(grid: np.ndarray) -> list[dict]:
+    colors = sorted(set(map(int, grid.flat)) - {BG, SPRITE_COLOR, GUIDE_COLOR})
+    layers = []
+    for color in colors:
