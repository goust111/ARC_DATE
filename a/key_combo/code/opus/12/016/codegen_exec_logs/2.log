+
+def _build_candidate_guides(
+    shape: tuple[int, int],
+    layers: list[dict],
+    sprite_coords: np.ndarray,
+) -> list[dict]:
+    h, w = shape
+    outer = layers[0]["rect"]
+    center_r = float(np.mean(sprite_coords[:, 0]))
+    center_c = float(np.mean(sprite_coords[:, 1]))
