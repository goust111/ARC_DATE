+    multi_color_exists = any(item["multi_color"] for item in candidates)
+    combos = []
+    for count in range(desired_count, 0, -1):
+        for combo in combinations(candidates, count):
+            sigs = {item["sig"] for item in combo}
+            if len(sigs) != len(combo):
