+    completed: list[dict] = []
+    for layer in layers:
+        raw = layer["raw"]
+        rect = raw
+        if completed:
+            parents = [
+                parent
+                for parent in completed
+                if _contains_rect(parent["rect"], raw) and parent["rect"] != raw
