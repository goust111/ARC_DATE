+def _place_sprite(rect: tuple[int, int, int, int], sprite_mask: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = rect
+    ideal_r = (r0 + r1) // 2 - 1
+    ideal_c = (c0 + c1) // 2 - 1
+    row_lo = max(r0 + 1, ideal_r - 1)
+    row_hi = min(r1 - 3, ideal_r + 1)
+    col_lo = max(c0 + 1, ideal_c - 1)
+    col_hi = min(c1 - 3, ideal_c + 1)
