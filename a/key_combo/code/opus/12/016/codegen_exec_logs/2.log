+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+OUTER_COLOR = 1
+SPRITE_COLOR = 2
+GUIDE_COLOR = 3
+MIDDLE_COLOR = 5
+INNER_COLOR = 9
+
+ORTHO4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ORTHO8 = [
