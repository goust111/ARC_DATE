+def _render_output_from_solution(
+    shape: tuple[int, int], layers: list[dict], sprite_coords: np.ndarray, vectors: list[tuple[int, int]]
+) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    for layer in layers:
