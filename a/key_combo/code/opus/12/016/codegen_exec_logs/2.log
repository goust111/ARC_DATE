+        return False
+    if len(_components(inp == GUIDE_COLOR, connectivity=8)) != len(guides):
+        return False
+
+    solved = main(inp)
+    if not np.array_equal(solved, expected):
+        return False
+    if np.array_equal(inp, expected):
+        return False
+
