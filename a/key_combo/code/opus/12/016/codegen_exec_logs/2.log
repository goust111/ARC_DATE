+    guide = {tuple(map(int, p)) for p in guide_coords}
+    candidates = set()
+    for sr, sc in sprite:
+        for gr, gc in guide:
+            dr, dc = gr - sr, gc - sc
+            shifted = {(r + dr, c + dc) for r, c in sprite}
+            if guide <= shifted:
