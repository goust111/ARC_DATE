+GUIDE_TEMPLATES = {
+    "top": [(-4, 0), (-4, -1), (-4, 1), (-5, 0)],
+    "bottom": [(4, 0), (4, -1), (4, 1), (5, 0)],
+    "left": [(0, -4), (-1, -4), (1, -4), (0, -5)],
+    "right": [(0, 4), (-1, 4), (1, 4), (0, 5)],
