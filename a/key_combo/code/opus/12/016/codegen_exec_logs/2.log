+    center_r = float(np.mean(sprite_coords[:, 0]))
+    center_c = float(np.mean(sprite_coords[:, 1]))
+    dr, dc = vector
+    colors = []
+    for k in range(1, max(shape) + 1):
+        color = _deepest_layer_color(layers, center_r + k * dr, center_c + k * dc)
+        if color is None:
+            break
+        colors.append(int(color))
+    return colors
