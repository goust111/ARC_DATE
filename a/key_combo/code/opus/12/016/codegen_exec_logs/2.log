+    if not candidates:
+        raise AssertionError("guide is not a subset of any translated central sprite")
+    best_norm = max(dr * dr + dc * dc for dr, dc in candidates)
+    best = [vec for vec in candidates if vec[0] * vec[0] + vec[1] * vec[1] == best_norm]
+    best.sort()
+    return best[-1]
