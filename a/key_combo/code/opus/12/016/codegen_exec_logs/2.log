+def _deepest_layer_color(layers: list[dict], r: float, c: float) -> int | None:
+    for layer in sorted(layers, key=lambda item: _rect_area(item["rect"])):
+        if _rect_contains_point(layer["rect"], r, c):
+            return int(layer["color"])
+    return None
