+    solved = main(inp)
+    if not np.array_equal(solved, expected):
+        return False
+    if np.array_equal(inp, expected):
+        return False
+
+    output_colors = set(map(int, expected.flat)) - {BG}
+    if len(output_colors) < 2:
+        return False
