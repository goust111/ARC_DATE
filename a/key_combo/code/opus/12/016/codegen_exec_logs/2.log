+    out[overlay != BG] = overlay[overlay != BG]
+    for layer in layers:
+        _paint_frame(out, layer["rect"], int(layer["color"]))
+    out[sprite_coords[:, 0], sprite_coords[:, 1]] = SPRITE_COLOR
+    return out
