+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    dirs = ORTHO4 if int(connectivity) == 4 else ORTHO8
+    seen = np.zeros(mask.shape, dtype=bool)
+    parts: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
