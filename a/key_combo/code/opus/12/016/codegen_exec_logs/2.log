+                continue
+            seq = _projection_sequences(shape, layers, sprite_coords, (dr, dc))
+            if not seq:
+                continue
+            outside = [(r, c) for r, c in shifted if not _rect_contains_point(outer, r, c)]
+            if len(outside) < 2:
+                continue
+            subsets = _connected_subsets(outside)
+            if not subsets:
+                continue
+            for subset in subsets:
+                guide_coords = np.array(subset, dtype=int)
+                inferred = _infer_guide_vector(sprite_coords, guide_coords)
+                if inferred != (dr, dc):
+                    continue
+                top_vectors = _infer_vector_candidates(sprite_coords, guide_coords)
+                norms = [a * a + b * b for a, b in top_vectors]
+                best_norm = max(norms)
+                if sum(int(n == best_norm) for n in norms) != 1:
+                    continue
