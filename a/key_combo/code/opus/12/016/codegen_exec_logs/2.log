+def _validate_instance(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    layers: list[dict],
+    sprite_coords: np.ndarray,
+    guides: list[dict],
+) -> bool:
+    outer = layers[0]["rect"]
+    for guide in guides:
+        coords = guide["guide"]
+        if coords.shape[0] not in (2, 3):
