+GUIDE_TEMPLATES = {
+    "top": [(-6, 0), (-6, -1), (-6, 1), (-5, 0)],
+    "bottom": [(6, 0), (6, -1), (6, 1), (5, 0)],
+    "left": [(0, -6), (-1, -6), (1, -6), (0, -5)],
+    "right": [(0, 6), (-1, 6), (1, 6), (0, 5)],
+}
+
+SEARCH_VECTORS = [
+    (-6, 0),
+    (-6, -1),
+    (-6, 1),
+    (-4, -4),
+    (-4, 4),
+    (0, -6),
+    (-1, -6),
+    (1, -6),
+    (0, 6),
+    (-1, 6),
+    (1, 6),
+    (4, -4),
+    (4, 4),
+    (6, 0),
+    (6, -1),
+    (6, 1),
+]
