+    if side == "bottom":
+        if omit_side == "bottom":
+            return []
+        cols = list(range(c0, c1 + 1))
+        if omit_side == "left":
+            cols = [c for c in cols if c != c0]
+        if omit_side == "right":
+            cols = [c for c in cols if c != c1]
+        return [(r1, c) for c in cols]
+    if side == "left":
+        if omit_side == "left":
