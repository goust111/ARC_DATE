+            c0_hi = min(c0_hi, int(math.floor(centroid_c)))
+        else:
+            c1_lo = max(c1_lo, int(math.ceil(centroid_c)))
+            c1_hi = min(c1_hi, int(cols.min()) - 1)
+
+    if r0_lo > r0_hi or c0_lo > c0_hi or r1_lo > r1_hi or c1_lo > c1_hi:
+        return None
+
+    for _ in range(120):
