+        c0 = random.randint(c0_lo, c0_hi)
+        r1 = random.randint(max(r1_lo, r0 + 8), r1_hi)
+        c1 = random.randint(max(c1_lo, c0 + 8), c1_hi)
+        outer = (r0, c0, r1, c1)
