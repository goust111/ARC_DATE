+        c0 = random.randint(c0_min, c0_max)
+        r1 = random.randint(max(r1_min, r0 + 4), r1_max)
+        c1 = random.randint(max(c1_min, c0 + 4), c1_max)
+        rect = (r0, c0, r1, c1)
+        if _contains_rect(rect, sprite_box) and rect[2] - rect[0] + 1 >= 5 and rect[3] - rect[1] + 1 >= 5:
