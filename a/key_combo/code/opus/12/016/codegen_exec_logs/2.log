  for r,c in np.argwhere(mask):
    r=int(r); c=int(c)
    if (r,c) in seen: continue
    st=[(r,c)]; seen.add((r,c)); comp=[]
    while st:
      rr,cc=st.pop(); comp.append((rr,cc))
      for dr,dc in dirs:
        nr,nc=rr+dr,cc+dc
        if 0<=nr<3 and 0<=nc<3 and mask[nr,nc] and (nr,nc) not in seen:
          seen.add((nr,nc)); st.append((nr,nc))
    out.append(comp)
