+def _random_sprite_mask() -> np.ndarray:
+    banks = [
+        ((0, 0), (0, 1), (1, 0), (2, 0), (2, 1)),
+        ((0, 0), (0, 1), (1, 1), (2, 1), (2, 2)),
+        ((0, 1), (0, 2), (1, 1), (2, 1), (2, 2)),
+        ((0, 1), (0, 2), (1, 1), (2, 0), (2, 1)),
+        ((0, 0), (1, 0), (1, 1), (1, 2), (2, 2)),
+        ((0, 2), (1, 0), (1, 1), (1, 2), (2, 0)),
+        ((0, 0), (0, 1), (0, 2), (1, 0), (1, 2)),
+        ((0, 0), (0, 2), (1, 0), (1, 1), (1, 2)),
+    ]
+    cells = random.choice(banks)
+    mask = np.zeros((3, 3), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
