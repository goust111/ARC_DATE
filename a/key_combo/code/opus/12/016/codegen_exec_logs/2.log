+            if parents:
+                parent = min(parents, key=lambda item: _rect_area(item["rect"]))
+                inset = _inset_rect(parent["rect"])
+                if inset[0] <= inset[2] and inset[1] <= inset[3] and _contains_rect(inset, raw):
