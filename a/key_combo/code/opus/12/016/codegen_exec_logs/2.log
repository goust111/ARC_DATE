+        coords = guide["guide"]
+        grid[coords[:, 0], coords[:, 1]] = GUIDE_COLOR
+    return grid
+
+
+def _validate_instance(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    layers: list[dict],
+    sprite_coords: np.ndarray,
+    guides: list[dict],
+) -> bool:
+    outer = layers[0]["rect"]
+    for guide in guides:
+        coords = guide["guide"]
+        if coords.shape[0] not in (2, 3):
+            return False
+        if any(_rect_contains_point(outer, int(r), int(c)) for r, c in coords):
+            return False
