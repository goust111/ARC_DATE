+            continue
+        if side == "bottom" and not all(r > centroid_r for r, _ in subset):
+            continue
+        if side == "left" and not all(c < centroid_c for _, c in subset):
+            continue
+        if side == "right" and not all(c > centroid_c for _, c in subset):
