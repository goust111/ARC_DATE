+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6)
+
+GRID_H_RANGE = (15, 23)
+GRID_W_RANGE = (15, 23)
+HOLLOW_COUNT = 3
+SOLID_COUNT_WEIGHTS = ((0, 2), (1, 3), (2, 2))
+COMMON_INTERIOR_H_RANGE = (4, 6)
+COMMON_INTERIOR_W_RANGE = (4, 6)
+EXTRA_INTERIOR_MARGIN_MAX = 1
+SOLID_H_RANGE = (3, 7)
+SOLID_W_RANGE = (3, 7)
+TEMPLATE_AREA_RANGE = (5, 10)
