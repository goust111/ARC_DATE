+def _fits_with_gap(occupied: np.ndarray, top: int, left: int, height: int, width: int, gap: int) -> bool:
+    h, w = occupied.shape
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(h, top + height + gap)
+    c1 = min(w, left + width + gap)
+    return not occupied[r0:r1, c0:c1].any()
