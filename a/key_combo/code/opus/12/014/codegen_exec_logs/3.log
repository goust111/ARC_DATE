+    solid_count = _choose_solid_count()
+    colors = random.sample(FRAME_COLORS, HOLLOW_COUNT + solid_count)
+    hollow_colors = colors[:HOLLOW_COUNT]
+    solid_colors = colors[HOLLOW_COUNT:]
