def _column_groups(g: np.ndarray, bg: int) -> list[np.ndarray]:
    nonempty = np.any(g != bg, axis=0)
    groups = []
    c = 0
    while c < g.shape[1]:
        if not nonempty[c]:
            c += 1
            continue
        c0 = c
        while c < g.shape[1] and nonempty[c]:
            c += 1
        group = g[:, c0:c].copy()
        assert len(set(map(int, group[group != bg]))) == 1
        groups.append(group)
    assert groups
