+    for obj in hollows:
+        r0, c0, r1, c1 = obj["bbox"]
+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
+        inner[:] = BACKGROUND
+        ih, iw = inner.shape
+        stamp = template[:ih, :iw]
+        inner[stamp] = int(obj["color"])
