+        patches.append(_make_solid_patch(color))
+
+    placed = _place_patches(patches)
+    if placed is None:
+        return None
+    grid, _positions = placed
+
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return None
+    if not _validate_generated_scene(grid, padded_template):
+        return None
+    return grid
