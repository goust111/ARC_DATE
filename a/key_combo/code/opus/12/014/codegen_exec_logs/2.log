THREE_WALL_ROW_MIDDLES = (4, 5)
FOUR_WALL_ROWS = (0, 3, 6, 9)
WALL_COL_MIN = 1
WALL_COL_MAX = 8
WALL_COL_GAP_MIN = 3
WALL_COL_GAP_MAX = 5
WALL_COL_PAIRS = tuple(
    (c0, c0 + gap)
    for c0 in range(WALL_COL_MIN, WALL_COL_MAX + 1)
    for gap in range(WALL_COL_GAP_MIN, WALL_COL_GAP_MAX + 1)
    if c0 + gap <= WALL_COL_MAX
