+    panel_count = int(_RNG.choice([3, 4]))
+    height = int(_RNG.integers(4, 8))
+    max_panel_width = min(6, (30 - (panel_count - 1)) // panel_count)
+    panel_width = int(_RNG.integers(4, max_panel_width + 1))
