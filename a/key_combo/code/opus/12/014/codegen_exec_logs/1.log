+    mirrored_wrong = np.zeros_like(counts)
+    for idx, mask in enumerate(masks, start=1):
+        mirrored_wrong += (mask if idx % 2 == 1 else np.fliplr(mask)).astype(int)
+    if np.array_equal(mirrored_wrong, counts):
+        return False
+
+    return True
+
+
