+        ordered_free = sorted(free)
+        seed = ordered_free[int(_RNG.integers(len(ordered_free)))]
+        free.remove(seed)
+        component = [seed]
+        frontier = {nb for nb in _neighbors4(seed[0], seed[1], height, width) if nb in free}
