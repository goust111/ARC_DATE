def _gen_split_counts(primary_count, secondary_count):
    total = primary_count + secondary_count
    overlap = int(np.random.randint(0, min(MAX_OVERLAP, total) + 1))
    options = []
    for left_count in range(SIDE_COUNT_MIN, SIDE_COUNT_MAX + 1):
