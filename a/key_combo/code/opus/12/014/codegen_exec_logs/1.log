+        patch = mask if idx % 2 == 1 else np.fliplr(mask)
+        start = (idx - 1) * (panel_width + 1)
+        grid[:, start:start + panel_width] = np.where(patch, FOREGROUND, BACKGROUND)
+        if idx < panel_count:
