+from __future__ import annotations
+
+import numpy as np
+
+
+BACKGROUND = 0
+NEGATIVE_BG = 8
+INPUT_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)
+
+MIN_RECT_SIZE = 3
+MAX_RECT_SIZE = 7
+MIN_OBJECTS = 2
+MAX_OBJECTS = 3
+MIN_HEIGHT = 8
+MAX_HEIGHT = 14
+MIN_WIDTH = 8
+MAX_WIDTH = 15
+MAX_GENERATION_ATTEMPTS = 400
