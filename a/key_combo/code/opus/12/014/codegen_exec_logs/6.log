+    corner_name = random.choices([name for name, _ in choices], weights=[wt for _, wt in choices], k=1)[0]
+    max_side = min(10, H - 2, W - 2)
+    min_side = max(6, stamp_h, stamp_w)
+    if min_side > max_side:
