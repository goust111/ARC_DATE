+    distractor = random.choice(inner_candidates)
+    return (r0, c0, r1, c1), missing, present, distractor
+
+
+def _build_input() -> np.ndarray | None:
+    H = random.randint(18, 24)
+    W = random.randint(18, 24)
+    grid = np.zeros((H, W), dtype=int)
