  grid: 8x8 [observed]
  background: orange (7)
  markers:
    color: grey (5) [observed]; any color except teal and background works per solver
    count: exactly 4
    bounding_box: square with side length 3-7
    layout: 3 of 4 bbox corners occupied; 4th marker is 1 diagonal step inward from the missing corner toward the opposite corner
    missing_corner: any of TL/TR/BL/BR (all four seen across examples)
  output:
    triangle_color: teal (8)
    triangle: right isosceles triangle inscribed in the marker bbox
    right_angle_vertex: the missing corner
    legs: two axis-aligned edges of the bbox adjacent to the missing corner
    hypotenuse: diagonal from one adjacent corner to the other
