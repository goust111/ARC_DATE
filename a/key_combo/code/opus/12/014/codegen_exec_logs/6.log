    random.shuffle(steps)

    cells = {(r, c)}
    for dr, dc in steps:
        r += dr
        c += dc
        cells.add((r, c))

    while len(cells) < k:
        frontier = []
        for rr, cc in cells:
            for dr, dc in FOUR_NEIGHBORS:
                nr, nc = rr + dr, cc + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
                    frontier.append((nr, nc))
