+    placed_markers = _place_markers(H, W, scaled.shape[0], scaled.shape[1])
+    if placed_markers is None:
+        return None
+    square, _missing, _present, distractor = placed_markers
+    r0, c0, r1, c1 = square
+
+    blocked = np.zeros((H, W), dtype=bool)
