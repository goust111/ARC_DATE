+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert set(map(int, np.unique(g))) <= ALLOWED_COLORS
+    assert int(np.count_nonzero(g == BG)) > 0
