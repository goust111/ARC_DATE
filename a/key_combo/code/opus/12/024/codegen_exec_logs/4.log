+
+
+def _analyze_geometry(
+    shape: tuple[int, int],
+    blocks: list[tuple[int, int]],
+    row_bars: set[int],
+    col_bars: set[int],
+) -> list[dict[str, object]]:
+    occupied: set[tuple[int, int]] = set()
+    corner_maps = {block: _corner_positions(block) for block in blocks}
+    for block in blocks:
