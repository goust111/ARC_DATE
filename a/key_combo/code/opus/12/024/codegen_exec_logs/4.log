+    return sorted(blocks)
+
+
+def _detect_bars(grid: np.ndarray) -> tuple[set[int], set[int]]:
+    row_bars = {r for r in range(grid.shape[0]) if np.all(grid[r, :] == BAR)}
+    col_bars = {c for c in range(grid.shape[1]) if np.all(grid[:, c] == BAR)}
