+
+BG = 0
+BLUE = 1
+RED = 2
+BLOCK = 3
+YELLOW = 4
+BAR = 5
+ORANGE = 7
+
+CORNER_ORDER = ("NW", "NE", "SE", "SW")
+CORNER_OFFSETS = {
+    "NW": (-1, -1),
+    "NE": (-1, 2),
+    "SE": (2, 2),
+    "SW": (2, -1),
+}
+RAY_DIRS = {
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SE": (1, 1),
+    "SW": (1, -1),
+}
+ROTATED_SOURCE = {
+    "NW": "SW",
+    "NE": "NW",
+    "SE": "NE",
+    "SW": "SE",
+}
+CORNER_COLORS = (BLUE, RED, YELLOW, ORANGE)
+ALLOWED_COLORS = {BG, BLUE, RED, BLOCK, YELLOW, BAR, ORANGE}
+
+GEN_GRID_ROWS = (15, 21)
+GEN_GRID_COLS = (15, 21)
+GEN_BLOCK_COUNTS = (2, 3)
+GEN_BAR_COUNTS = (1, 2, 3)
+GEN_MAX_ATTEMPTS = 400
