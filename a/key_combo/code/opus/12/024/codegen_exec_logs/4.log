+                path.append((r, c))
+                r += dr
+                c += dc
+
+            rays.append(
+                {
+                    "block_id": block_id,
+                    "corner": corner,
+                    "start": start,
+                    "path": path,
+                    "stop_kind": stop_kind,
+                    "stop_detail": stop_detail,
+                    "stop_cell": stop_cell,
+                }
