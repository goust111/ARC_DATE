+                    if r in row_bars:
+                        bar_hits.append(("row", int(r)))
+                    if c in col_bars:
+                        bar_hits.append(("col", int(c)))
+                    if bar_hits:
+                        stop_kind = "bar"
+                        stop_detail = tuple(bar_hits)
+                        stop_cell = (r, c)
+                        break
+                    if (r, c) in occupied:
+                        stop_kind = "block"
+                        stop_detail = (r, c)
+                        stop_cell = (r, c)
