+                    "block_id": block_id,
+                    "corner": corner,
+                    "color": color,
+                    "start": start,
+                    "path": path,
+                    "stop_kind": stop_kind,
+                    "stop_detail": stop_detail,
+                    "stop_cell": stop_cell,
