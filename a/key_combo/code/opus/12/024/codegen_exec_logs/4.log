+    by_key = {(ray["block_id"], ray["corner"]): ray for ray in unobstructed_rays}
+    bar_truncated = []
+    non_bar = 0
+    for ray in rays:
+        full = by_key[(ray["block_id"], ray["corner"])]
+        if ray["stop_kind"] == "bar":
+            bar_truncated.append((ray, full))
+        else:
