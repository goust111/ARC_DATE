+
+
+def _choose_bars(
+    shape: tuple[int, int],
+    blocks: list[tuple[int, int]],
+    corner_assignments: list[dict[str, int]],
+    require_block_stop: bool,
+) -> tuple[set[int], set[int]] | None:
+    unobstructed_rays = _analyze_geometry(shape, blocks, set(), set())
