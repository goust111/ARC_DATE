+            {
+                "id": block_id,
+                "top_left": top_left,
+                "body_cells": _block_body_cells(top_left),
+                "corner_positions": _corner_positions(top_left),
+                "corner_colors": {"NW": BLUE, "NE": RED, "SE": YELLOW, "SW": ORANGE},
