+BLUE = 1
+RED = 2
+BLOCK = 3
+YELLOW = 4
+BAR = 5
+ORANGE = 7
+
+CORNER_ORDER = ("NW", "NE", "SE", "SW")
+CORNER_OFFSETS = {
+    "NW": (-1, -1),
+    "NE": (-1, 2),
+    "SE": (2, 2),
+    "SW": (2, -1),
+}
