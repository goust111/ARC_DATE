+            continue
+        mask = np.zeros((box_h, box_w), dtype=bool)
+        rel = coords - np.array([r0, c0])
+        mask[rel[:, 0], rel[:, 1]] = True
+        if not np.array_equal(mask, _rect_border_mask(box_h, box_w)):
