+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+SHAPE_LIBRARY = [
+    _mask(["111"]),
+    _mask(["10", "11"]),
+    _mask(["11", "11"]),
+    _mask(["1111"]),
+    _mask(["100", "111"]),
+    _mask(["111", "010"]),
+    _mask(["110", "011"]),
+    _mask(["010", "111", "010"]),
+    _mask(["100", "100", "111"]),
+    _mask(["111", "110"]),
+    _mask(["111", "101"]),
+    _mask(["110", "011", "001"]),
