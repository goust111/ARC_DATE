+
+
+def _render_container_patch(container: dict, fill_holes: bool, charge_steps: int = 0) -> tuple[np.ndarray, int]:
+    oh, ow = container["outer"]
+    ih, iw = oh - 2, ow - 2
+    patch = np.full((oh, ow), BG, dtype=int)
