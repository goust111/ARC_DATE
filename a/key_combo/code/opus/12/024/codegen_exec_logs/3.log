+    patch[:, 0] = BORDER
+    patch[:, -1] = BORDER
+    patch[1:-1, 1:-1] = GREY
+
+    matched = 0
+    for hole in container["holes"]:
+        hr, hc = hole["pos"]
+        rr, cc = np.nonzero(hole["mask"])
+        hole_color = hole.get("color")
+        color = hole_color if fill_holes and hole_color is not None else BG
+        if hole_color is not None:
+            matched += 1
+        patch[1 + hr + rr, 1 + hc + cc] = color
