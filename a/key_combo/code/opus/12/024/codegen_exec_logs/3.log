+        head = container["head"]
+        target = container["target"]
+        direction = container["dir"]
+        distance = abs(target[0] - head[0]) + abs(target[1] - head[1])
+        steps = min(energy, distance)
+        patch, _ = _render_container_patch(container, fill_holes=True, charge_steps=steps)
