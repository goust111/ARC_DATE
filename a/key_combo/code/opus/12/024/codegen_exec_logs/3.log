+BORDER = 0
+GREY = 5
+ORANGE = 7
+MARKER = 9
+SPRITE_COLORS = (1, 2, 3, 4, 8)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
