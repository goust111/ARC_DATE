+
+
+def _head_for_box(box: tuple[int, int, int, int], side: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if side == "left":
+        return ((r0 + r1) // 2, c0 - 1)
+    if side == "right":
+        return ((r0 + r1) // 2, c1 + 1)
+    if side == "top":
+        return (r0 - 1, (c0 + c1) // 2)
+    return (r1 + 1, (c0 + c1) // 2)
+
+
+def _target_for_box(box: tuple[int, int, int, int], side: str, gap: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if side == "left":
+        return ((r0 + r1) // 2, c1 + gap + 1)
+    if side == "right":
