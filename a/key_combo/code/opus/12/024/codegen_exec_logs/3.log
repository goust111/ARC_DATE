+def _target_for_box(box: tuple[int, int, int, int], side: str, gap: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if side == "left":
+        return ((r0 + r1) // 2, c1 + gap + 1)
+    if side == "right":
