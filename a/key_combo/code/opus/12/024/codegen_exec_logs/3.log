+def _mark_bbox(occupied: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    h, w = occupied.shape
+    pr0 = max(0, r0 - pad)
+    pc0 = max(0, c0 - pad)
+    pr1 = min(h - 1, r1 + pad)
+    pc1 = min(w - 1, c1 + pad)
+    occupied[pr0 : pr1 + 1, pc0 : pc1 + 1] = True
