+    out = np.full_like(g, BG)
+    for container in containers:
+        r0, c0, r1, c1 = container["box"]
+        inner = g[r0 + 1 : r1, c0 + 1 : c1]
+        holes = []
+        for coords in _components(inner == BG, connectivity=4):
+            hole_mask = _coords_to_mask(coords)
+            holes.append(
