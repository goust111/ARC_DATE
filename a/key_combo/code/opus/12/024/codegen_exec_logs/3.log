+import numpy as np
+
+BG = 6
+BORDER = 0
+GREY = 5
+ORANGE = 7
+MARKER = 9
+SPRITE_COLORS = (1, 2, 3, 4, 8)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+MAX_GEN_ATTEMPTS = 400
