+
+
+def _rect_border_mask(h: int, w: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    m[0, :] = True
+    m[-1, :] = True
+    m[:, 0] = True
+    m[:, -1] = True
