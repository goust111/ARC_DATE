+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
