+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+SEED_COLORS = (1, 3, 4, 5, 7)
+DIR4 = [(-1, 0), (0, -1), (0, 1), (1, 0)]
+
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (14, 20)
+INNER_H_RANGE = (7, 12)
+INNER_W_RANGE = (7, 12)
+MARGIN_RANGE = (2, 4)
+TARGET_CAVITIES = (3, 5)
+MIN_REGION_SIDE = 2
+MIN_REGION_AREA = 4
+GEN_RETRIES = 500
