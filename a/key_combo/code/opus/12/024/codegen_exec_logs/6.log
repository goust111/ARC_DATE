+SIDES = ("top", "bottom", "left", "right")
+ADJACENT_PAIRS = {
+    frozenset(("top", "left")),
+    frozenset(("top", "right")),
+    frozenset(("bottom", "left")),
+    frozenset(("bottom", "right")),
