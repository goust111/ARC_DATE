+
+def _find_components(grid: np.ndarray, bg: int = 0) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append({"coords": coords, "bbox": _bbox(coords), "area": len(coords)})
+    return comps
+
+
+def _paste_nonoverlap(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = dst.shape
+    ph, pw = patch.shape
+    for pr in range(ph):
+        rr = r0 + pr
+        if rr < 0 or rr >= h:
+            continue
+        for pc in range(pw):
+            cc = c0 + pc
+            if cc < 0 or cc >= w:
+                continue
+            val = int(patch[pr, pc])
+            if val != 0 and int(dst[rr, cc]) == 0:
+                dst[rr, cc] = val
+
+
+def _transform(patch: np.ndarray, k: int, flip: bool) -> np.ndarray:
+    out = np.rot90(patch, int(k))
+    return np.fliplr(out) if flip else out
+
