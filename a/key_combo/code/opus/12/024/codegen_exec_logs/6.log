+def _erase_controls(grid: np.ndarray, controls: dict[str, int]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    if "top" in controls:
+        out[0, :] = 0
+    if "bottom" in controls:
+        out[h - 1, :] = 0
+    if "left" in controls:
+        out[:, 0] = 0
+    if "right" in controls:
+        out[:, w - 1] = 0
+    return out
