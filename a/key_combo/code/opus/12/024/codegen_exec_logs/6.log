+def _paste_nonoverlap(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = dst.shape
+    ph, pw = patch.shape
+    for pr in range(ph):
+        rr = r0 + pr
+        if rr < 0 or rr >= h:
+            continue
