+        return gap // h + 1
+    if direction == "left":
+        if seed_c % w != 0:
+            return 0
+        return seed_c // w + 1
+    gap = gw - (seed_c + w)
+    if gap < 0 or gap % w != 0:
+        return 0
+    return gap // w + 1
