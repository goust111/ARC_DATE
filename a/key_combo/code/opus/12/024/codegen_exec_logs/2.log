+        [(c, r) for r, c in points],
+        [(c, -r) for r, c in points],
+        [(-c, r) for r, c in points],
+        [(-c, -r) for r, c in points],
+    ]
+
+
+def _fit_points(
+    points: list[tuple[int, int]],
+    shape: tuple[int, int],
+    force_edge: bool,
+) -> list[tuple[int, int]] | None:
