+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+STAMP_ENDPOINTS = {
+    BLUE: (-1, 0),
+    GREEN: (0, 1),
+    YELLOW: (1, 0),
+    ORANGE: (0, -1),
