+
+    if row_shift is None:
+        row_shift = random.randint(row_low, row_high)
+    if col_shift is None:
+        col_shift = random.randint(col_low, col_high)
+
+    return [(r + row_shift, c + col_shift) for r, c in transformed]
+
+
