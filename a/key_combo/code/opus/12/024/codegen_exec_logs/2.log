+def _pairwise_separated(anchors: list[tuple[int, int]]) -> bool:
+    for i, (r0, c0) in enumerate(anchors):
+        for r1, c1 in anchors[i + 1 :]:
+            if max(abs(r0 - r1), abs(c0 - c1)) < MIN_CENTER_SEPARATION:
+                return False
+    return True
