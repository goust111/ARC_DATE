+        _motif_blocked3,
+        _motif_blocked3,
+        _motif_rectangle4,
+        _motif_two_pairs4,
+        _motif_mixed5,
+    ]
+    return random.choice(motif_builders)()
+
+
+def generate_input() -> np.ndarray:
