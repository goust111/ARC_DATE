+        _motif_rectangle4,
+        _motif_two_pairs4,
+        _motif_mixed5,
+    ]
+    return random.choice(motif_builders)()
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
