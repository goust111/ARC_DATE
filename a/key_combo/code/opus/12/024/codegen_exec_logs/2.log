+        grid = np.full(shape, BLACK, dtype=int)
+        for r, c in anchors:
+            grid[r, c] = RED
+
+        out = main(grid)
+        if np.array_equal(out, analysis["stamped"]):
+            continue
+        if not np.array_equal(out, analysis["output"]):
+            continue
+
+        return grid
+
+    raise RuntimeError("failed to generate a valid non-degenerate input")

