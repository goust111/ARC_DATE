+            if max(abs(r0 - r1), abs(c0 - c1)) < MIN_CENTER_SEPARATION:
+                return False
+    return True
+
+
+def _stamp_grid(shape: tuple[int, int], anchors: list[tuple[int, int]]) -> np.ndarray:
