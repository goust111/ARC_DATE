+def _recolor_by_horizontal_symmetry(grid: np.ndarray, divider_color: int) -> np.ndarray:
+    out = grid.copy()
+    colors = [int(color) for color in np.unique(grid) if int(color) not in (BLACK, divider_color)]
+    for color in colors:
