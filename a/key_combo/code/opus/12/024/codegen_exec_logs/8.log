+            out[r0 : r1 + 1, c0 : c1 + 1] = int(cell_grid[r_idx, c_idx])
+    return out
+
+
+def _recolor_by_horizontal_symmetry(grid: np.ndarray, divider_color: int) -> np.ndarray:
