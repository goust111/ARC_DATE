+    connected_cells = _connect_seed_cells(seed_cells, divider_color)
+    connected_pixels = _render_cell_grid(
+        connected_cells,
+        row_segments,
+        col_segments,
+        g.shape,
+        divider_rows,
+        divider_cols,
+        divider_color,
+    )
+    return _recolor_by_horizontal_symmetry(connected_pixels, divider_color)
+
