+        "name": str(template["name"]),
+        "row_span": row_span,
+        "col_span": col_span,
+        "cells": tuple(cells),
+    }
+
+
+def _logical_capacity(cell_size: int) -> int:
+    return min(7, 31 // (cell_size + 1))
+
+
+def _contiguous_blocks(total: int, spans: list[int]) -> list[list[int]]:
