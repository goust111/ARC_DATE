+        col_span = int(template["col_span"])
+        chosen_rows = sorted(row_order[row_cursor : row_cursor + row_span])
+        chosen_cols = sorted(col_order[col_cursor : col_cursor + col_span])
+        row_cursor += row_span
+        col_cursor += col_span
