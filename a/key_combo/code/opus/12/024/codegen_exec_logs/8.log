+        "row_span": 3,
+        "col_span": 3,
+        "cells": ((0, 0), (0, 2), (2, 0), (2, 2)),
+    },
+)
+
+
+ASYMMETRIC_TEMPLATES = (
+    {
+        "name": "L_corner",
