+    if best_area <= 0 or len(best_rects) != 1:
+        return None
+    return next(iter(best_rects))
+
+
+def _expected_output(
+    grid: np.ndarray,
+    largest_box: tuple[int, int, int, int],
+    marker: tuple[int, int],
+) -> np.ndarray:
+    return _apply_rule(grid, largest_box, marker)
+
+
