  "src": "single centered red marker in a one-row black input",
  "transform": "expand to an N x N black canvas; draw a red V from the top-center marker to both side edges; paint blue on the modulo-4 NW-SE diagonal lattice inside the V and on all rows below it",
  "grid_shape": "N x N square, where N is the input width"
}
</annotation>
<generation_spec>
