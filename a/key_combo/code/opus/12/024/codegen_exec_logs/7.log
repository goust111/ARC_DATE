+            for r1 in range(r0, grid.shape[0]):
+                for c1 in range(c0, grid.shape[1]):
+                    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+                    if area < best_area:
+                        continue
+                    if _rect_black_count(prefix, r0, c0, r1, c1) != area:
+                        continue
+                    rect = (r0, c0, r1, c1)
+                    if area > best_area:
+                        best_area = area
+                        best_rects = {rect}
+                    else:
