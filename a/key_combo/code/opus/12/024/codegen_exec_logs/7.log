+def _largest_solid_black_rectangle(grid: np.ndarray) -> tuple[int, int, int, int]:
+    heights = np.zeros(grid.shape[1], dtype=int)
+    best_area = -1
+    best_rects: set[tuple[int, int, int, int]] = set()
