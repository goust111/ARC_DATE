+    smaller_dims = _sample_smaller_dims(largest_h * largest_w, rect_count - 1, h, w, rng)
+    rect_dims = [(largest_h, largest_w), *smaller_dims]
+    boxes = _place_rectangles(h, w, rect_dims, rng)
