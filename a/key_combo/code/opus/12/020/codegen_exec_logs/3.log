+def _is_connected(mask: np.ndarray) -> bool:
+    cells = [tuple(cell) for cell in np.argwhere(mask)]
+    if not cells:
+        return False
+    seen = {cells[0]}
+    stack = [cells[0]]
+    cell_set = set(cells)
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cell_set and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(cells)
