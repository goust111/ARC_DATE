+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+FRAME_SIZE = 7
+TEMPLATE_SIZE = 5
+SIDE_TO_ROTATION = {"top": 0, "right": 1, "bottom": 2, "left": 3}
+FIXED_SIDE_COLORS = {"top": RED, "right": GREEN, "bottom": BLUE, "left": YELLOW}
