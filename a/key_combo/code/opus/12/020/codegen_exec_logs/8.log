+
+
+def _shape_cells() -> list[tuple[int, int]] | None:
+    h, w = random.choice([(2, 3), (2, 4), (3, 2), (3, 3), (3, 4), (4, 2), (4, 3), (4, 4)])
+    target = random.randint(5, min(8, h * w - 1))
