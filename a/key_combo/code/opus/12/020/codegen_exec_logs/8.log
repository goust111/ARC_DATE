  "type": "transform_in_place",
  "src": "red marker pixels on a black background, with optional other foreground markers",
  "transform": "fill every black pixel in each red marker's clipped 3x3 neighborhood with blue; preserve the red markers and all other foreground pixels"
}
</annotation>
<generation_spec>
