+    spans = sorted([(blue_box[1], blue_box[3]), (red_box[1], red_box[3]), (green_box[1], green_box[3])])
+    for (_, c1), (n0, _) in zip(spans, spans[1:]):
+        if n0 - c1 < 3:
+            return False
+
