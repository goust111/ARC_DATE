import random
from collections import deque

import numpy as np


BG = 0
GREY = 5
MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
GEN_RETRIES = 400


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def _obstacle_components(grid: np.ndarray) -> tuple[list[list[tuple[int, int]]], dict[tuple[int, int], int]]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    index: dict[tuple[int, int], int] = {}
    for r in range(h):
        for c in range(w):
            if grid[r, c] != GREY or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                comp.append((rr, cc))
                index[(rr, cc)] = len(comps)
                for nr, nc in _neighbors4(rr, cc):
                    if _in_bounds((h, w), nr, nc) and not seen[nr, nc] and grid[nr, nc] == GREY:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps, index


def _marker_rows(grid: np.ndarray) -> list[tuple[int, int]]:
    rows = []
    for r in range(grid.shape[0]):
        color = int(grid[r, 0])
        if color not in (BG, GREY):
            rows.append((r, color))
    return rows


def _cast_shadow(shadow: np.ndarray, obstacle: list[tuple[int, int]]) -> None:
    h, w = shadow.shape
    for r, c in obstacle:
        rr, cc = r, c
        while 0 <= rr < h and 0 <= cc < w:
            shadow[rr, cc] = True
            rr += 1
            cc += 1


def _solve(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()
    shadow = np.zeros((h, w), dtype=bool)
