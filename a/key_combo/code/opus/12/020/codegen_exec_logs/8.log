+    input_coords, final_coords, _final_lefts, shifts = layout
+
+    input_sets = _sprite_sets(input_coords)
+    final_sets = _sprite_sets(final_coords)
+    markers = _pick_markers((h, w), input_sets, final_sets)
+    if markers is None:
