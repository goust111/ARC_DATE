        assert np.all(base[moved[:, 0], moved[:, 1]] == carrier), "destination must stay inside the carrier region"
        assert not np.any(occupied[moved[:, 0], moved[:, 1]]), "moved red objects must not overlap"

        occupied[moved[:, 0], moved[:, 1]] = True
