+    if not (3 <= len(markers) <= 5):
+        return False
+    if any(int(inp[r, c]) != YELLOW for r, c in markers):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    shape = _shape_cells()
+    if shape is None:
+        return None
+
