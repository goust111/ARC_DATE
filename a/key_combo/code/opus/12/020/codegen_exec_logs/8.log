+
+
+def _marker_effect_diff(inp: np.ndarray, solved: np.ndarray) -> bool:
+    aligned = _align_only(inp, BLUE)
+    markers = [tuple(map(int, p)) for p in np.argwhere(inp == YELLOW)]
+    for marker in markers:
