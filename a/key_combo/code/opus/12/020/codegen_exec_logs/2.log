+PALETTE = tuple(range(1, 10))
+GRID_SIDE_RANGE = (13, 22)
+FRAME_COUNT_CHOICES = (3, 4)
+MIN_FRAME_SIDE = 5
+MAX_GENERATION_ATTEMPTS = 400
