+def _cell_spans(dividers: list[int], limit: int) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for div in dividers:
+        spans.append((start, div - 1))
+        start = div + 1
+    spans.append((start, limit - 1))
+    return spans
