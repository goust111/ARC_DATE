+def _canonical_signature(cell: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    normalized = cell.copy()
+    normalized[(normalized == BLUE) | (normalized == RED)] = 7
+    return tuple(tuple(int(v) for v in row) for row in normalized)
