+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+MAROON = 9
+
+GRID_CELLS = 4
+CELL_SIZE = 4
+STEP = CELL_SIZE + 1
+GRID_SIZE = GRID_CELLS * CELL_SIZE + (GRID_CELLS - 1)
