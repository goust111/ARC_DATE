/bin/bash -lc "python -u - <<'PY'
from itertools import combinations
from collections import deque
import numpy as np

H=W=6
cells=[(r,c) for r in range(4) for c in range(4)]

def conn(shape):
    s=set(shape)
    q=[next(iter(s))]; seen={q[0]}
    while q:
        r,c=q.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (nr,nc) in s and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(s)

def mirror(g):
    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)],[np.fliplr(g), g]])

def comp_info(g,start):
    HH,WW=g.shape
    q=deque([start]); seen={start}; n=0; touch=False
    while q:
        x,y=q.popleft(); n+=1
        if x in (0,HH-1) or y in (0,WW-1): touch=True
        for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<HH and 0<=ny<WW and (nx,ny) not in seen and g[nx,ny] in (0,2):
                seen.add((nx,ny)); q.append((nx,ny))
    return n,touch

def mirrored_infos(g):
    mg=mirror(g); HH,WW=mg.shape
    infos=[]; seen=np.zeros((HH,WW),bool)
    for r,c in np.argwhere(mg==2):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=True; n=0; touch=False
        while q:
            x,y=q.popleft(); n+=1
            if x in (0,HH-1) or y in (0,WW-1): touch=True
            for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
                if 0<=nx<HH and 0<=ny<WW and not seen[nx,ny] and mg[nx,ny] in (0,2):
                    seen[nx,ny]=True; q.append((nx,ny))
        infos.append((n,touch))
    return infos

def solve(g):
    out=mirror(g).copy(); HH,WW=out.shape
    q=deque(); seen=np.zeros((HH,WW),bool)
    for r,c in np.argwhere(out==2): q.append((int(r),int(c))); seen[r,c]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<HH and 0<=nc<WW and not seen[nr,nc] and out[nr,nc]"'!=5 and out[nr,nc] in (0,2):
                seen[nr,nc]=True
                if out[nr,nc]==0: out[nr,nc]=2
                q.append((nr,nc))
    return out

best=[]
for k in range(3,7):
  for shape in combinations(cells,k):
    if not conn(shape): continue
    # must touch top or left edge of local 4x4 box to be able to close
    if not any(r==0 for r,c in shape) and not any(c==0 for r,c in shape):
        continue
    g0=np.zeros((H,W),int)
    for r,c in shape: g0[r,c]=5
    for sr in range(H):
      for sc in range(W):
        if g0[sr,sc]!=0: continue
        # seed near wall and input must touch border via opening
        if min(abs(sr-r)+abs(sc-c) for r,c in shape)>2: continue
        g=g0.copy(); g[sr,sc]=2
        _,touch=comp_info(g,(sr,sc))
        if not touch: continue
        mins=mirrored_infos(g)
        closed=sum(not t for _,t in mins)
        if closed==0:
            out=solve(g)
            frac=(out==2).sum()/out.size
            best.append((round(frac,3), (out==2).sum()-4, shape, (sr,sc), mins))
best.sort(key=lambda x:(x[0], x[1]))
print('"'open candidates',len(best))
for row in best[:120]:
    print(row)
