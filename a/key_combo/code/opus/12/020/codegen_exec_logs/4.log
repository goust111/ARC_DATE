from collections import deque
import numpy as np

def mirror(g):
    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)],[np.fliplr(g), g]])

def solve(g):
    out=mirror(g).copy(); H,W=out.shape
    q=deque(); seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(out==2): q.append((int(r),int(c))); seen[r,c]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and out[nr,nc]"'!=5 and out[nr,nc] in (0,2):
                seen[nr,nc]=True
                if out[nr,nc]==0: out[nr,nc]=2
                q.append((nr,nc))
    return out

walls=np.array([(0,2),(1,2),(2,2),(3,0),(3,1),(3,2)])
seed_closed=np.array((1,1))
seed_open=np.array((2,3))
h=w=4
rot180=lambda rc:(h-1-rc[0],w-1-rc[1])
for H,W in [(5,6),(6,5),(5,7),(7,5)]:
    # closure top-left
    g=np.zeros((H,W),int)
    for r,c in walls:g[r,c]=5
    g[tuple(seed_closed)]=2
    out=solve(g)
    print('"'closure',H,W,'frac',round((out==2).sum()/out.size,3),'added',(out==2).sum()-4)
    # open bottom-right
    g=np.zeros((H,W),int)
    for r,c in [rot180(tuple(x)) for x in walls]:g[H-h+r,W-w+c]=5
    s=rot180(tuple(seed_open))
    g[H-h+s[0],W-w+s[1]]=2
    out=solve(g)
    print('open',H,W,'frac',round((out==2).sum()/out.size,3),'added',(out==2).sum()-4)
