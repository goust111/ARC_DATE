0008: # growing
0009: 
0010: # description:
0011: # In the input you will see a grid with some green rectangles. Each rectangle has one red pixel on one of its borders.
0012: # To make the output, you should extend the green region of each rectangle to the border of the grid in the direction of the red pixel, with the extent of the line increasing with the extent of the rectangle.
0013: # Also you should draw a red line from the red pixel to the border of the grid.
0014: 
0015: 
0016: def main(input_grid):
0017:     """
0018:     Grow each green rectangle outward from its red border indicator to the canvas edge.
0019: 
0020:     Input structure:
0021:     - Each foreground object is a green rectangle with one red pixel on its border.
0022:     - Objects sit on a black background.
0023:     - The red pixel indicates the side from which growth should extend.
0024: 
0025:     Rule:
0026:     - Find each rectangle-and-indicator component.
0027:     - Extend a green band from the rectangle toward the canvas edge on the indicator side.
0028:     - Draw a red line from the indicator pixel to that same edge.
0029: 
0030:     Key insight:
0031:     - The indicator side controls direction, while the rectangle thickness controls the grown band.
0032:     """
0033:     # Initialize the output grid
0034:     output_grid = np.copy(input_grid)
0035:     
0036:     rectangle_color = Color.GREEN
0037:     indicator_color = Color.RED
0038:     background = Color.BLACK
0039: 
0040:     # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
0041:     objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
0042:     for obj in objects:
0043:         # find the red indicator
0044:         for red_r, red_c in np.argwhere(obj == indicator_color):
0045:             break
0046: 
0047:         # Get the dimensions of the object, and its position
0048:         _b = bbox(obj != background)
0049:         assert _b is not None
0050:         r, c, _r1, _c1 = _b
0051:         width = _r1 - r + 1
0052:         height = _c1 - c + 1
0053: 
0054:         # depending on which side of the rectangle that the indicator is on, we draw in different directions
0055:         # left edge: draw to the left
0056:         if red_r == r:
0057:             # Extend the green rectangle to the left until it reaches the border
0058:             output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
0059:             # Draw the red line from the red pixel to the border
0060:             draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
0061:         elif red_r == r + width - 1:
0062:             # Extend the green rectangle to the right until it reaches the border
0063:             output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
0064:             # Draw the red line from the red pixel to the border
0065:             draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
0066:         elif red_c == c:
0067:             # Extend the green rectangle to the top until it reaches the border
0068:             output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
0069:             # Draw the red line from the red pixel to the border
0070:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
0071:         elif red_c == c + height - 1:
0072:             # Extend the green rectangle to the bottom until it reaches the border
0073:             output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
0074:             # Draw the red line from the red pixel to the border
0075:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
0076:         else:
0077:             assert False, "The red pixel is not on the border of the rectangle"
0078: 
0079:     return output_grid
