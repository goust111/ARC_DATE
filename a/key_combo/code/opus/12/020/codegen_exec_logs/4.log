生成策略我先用小模板做原型验证：只保留符合“输入半封闭、镜像后按 opening_direction 分成闭合/开放两类、填充规模不过度淹没整图”的候选。验证通过后再落成正式代码。
exec
/bin/bash -lc "python - <<'PY'
from collections import deque
import numpy as np

def mirror(g):
    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)], [np.fliplr(g), g]])

def solve(g):
    out = mirror(g)
    H,W = out.shape
    q=deque()
    seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(out==2):
        q.append((int(r),int(c)))
        seen[r,c]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and out[nr,nc]"'!=5:
                if out[nr,nc] in (0,2):
                    seen[nr,nc]=True
                    if out[nr,nc]==0:
                        out[nr,nc]=2
                    q.append((nr,nc))
    return out

def seed_comp_touches_border(g):
    H,W = g.shape
    comps=[]
    seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(g==2):
        r=int(r); c=int(c)
        if seen[r,c]:
            continue
        q=deque([(r,c)])
        seen[r,c]=True
        cells=[]; touch=False
        while q:
            x,y=q.popleft(); cells.append((x,y))
            if x in (0,H-1) or y in (0,W-1): touch=True
            for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
                if 0<=nx<H and 0<=ny<W and not seen[nx,ny] and g[nx,ny]!=5 and g[nx,ny] in (0,2):
                    seen[nx,ny]=True; q.append((nx,ny))
        comps.append((len(cells), touch))
    return comps

def make(H,W,ori,r0,c0):
    g=np.zeros((H,W),int)
    if ori=='"'up':
        walls=[(r0+1,c0),(r0+1,c0+2),(r0+2,c0),(r0+2,c0+1),(r0+2,c0+2)]
        seed=(r0+1,c0+1)
    elif ori=='down':
        walls=[(r0,c0),(r0,c0+1),(r0,c0+2),(r0+1,c0),(r0+1,c0+2)]
        seed=(r0+1,c0+1)
    elif ori=='left':
        walls=[(r0,c0+1),(r0,c0+2),(r0+1,c0+2),(r0+2,c0+1),(r0+2,c0+2)]
        seed=(r0+1,c0+1)
    else:
        walls=[(r0,c0),(r0,c0+1),(r0+1,c0),(r0+2,c0),(r0+2,c0+1)]
        seed=(r0+1,c0+1)
    for r,c in walls:g[r,c]=5
    g[seed]=2
    return g

for H in range(5,8):
  for W in range(5,8):
    for ori in ['up','down','left','right']:
      ok=[]
      for r0 in range(1,H-3+1):
        for c0 in range(1,W-3+1):
          g=make(H,W,ori,r0,c0)
          mg=mirror(g)
          comps=seed_comp_touches_border(mg)
          filled=solve(g)
          add=(filled==2).sum()-(mg==2).sum()
          frac=(filled==2).sum()/filled.size
          ok.append((r0,c0,comps,add,frac))
      print('H,W,ori',H,W,ori,'count',len(ok))
      for item in ok[:10]:
        print(' ',item)
      print()
