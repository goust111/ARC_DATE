from collections import deque
import numpy as np

def mirror(g):
    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)],[np.fliplr(g), g]])

def infos(g):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    out=[]
    for r,c in np.argwhere(g==2):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=True; n=0; touch=False
        while q:
            x,y=q.popleft(); n+=1
            if x in (0,H-1) or y in (0,W-1): touch=True
            for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
                if 0<=nx<H and 0<=ny<W and not seen[nx,ny] and g[nx,ny] in (0,2):
                    seen[nx,ny]=True; q.append((nx,ny))
        out.append((n,touch))
    return out

def solve(g):
    out=mirror(g).copy(); H,W=out.shape
    q=deque(); seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(out==2): q.append((int(r),int(c))); seen[r,c]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and out[nr,nc]"'!=5 and out[nr,nc] in (0,2):
                seen[nr,nc]=True
                if out[nr,nc]==0: out[nr,nc]=2
                q.append((nr,nc))
    return out

base_w=[(0,2),(1,2),(2,2),(3,0),(3,1),(3,2)]
base_seed_closed=(1,1)
base_seed_open=(2,3)
# transpose
trans_w=[(c,r) for r,c in base_w]
trans_seed_closed=(base_seed_closed[1],base_seed_closed[0])
trans_seed_open=(base_seed_open[1],base_seed_open[0])
for name,walls,sc,so in [('"'base',base_w,base_seed_closed,base_seed_open),('trans',trans_w,trans_seed_closed,trans_seed_open)]:
  H=W=6
  h=max(r for r,c in walls)+1; ww=max(c for r,c in walls)+1
  # closure top-left
  g=np.zeros((H,W),int)
  for r,c in walls:g[r,c]=5
  g[sc]=2
  out=solve(g)
  print(name,'closure',infos(mirror(g)),round((out==2).sum()/out.size,3),(out==2).sum()-4)
  # open bottom-right via 180 rotation inside patch
  rot180=lambda rc:(h-1-rc[0],ww-1-rc[1])
  rw=[rot180(x) for x in walls]; rs=rot180(so)
  g=np.zeros((H,W),int)
  for r,c in rw:g[H-h+r,W-ww+c]=5
  g[H-h+rs[0],W-ww+rs[1]]=2
  out=solve(g)
  print(name,'open',infos(mirror(g)),round((out==2).sum()/out.size,3),(out==2).sum()-4)
