from itertools import combinations
from collections import deque,defaultdict
import numpy as np

CELLS=[(r,c) for r in range(4) for c in range(4)]

def conn(cells):
    cells=set(cells)
    q=[next(iter(cells))]
    seen={q[0]}
    while q:
        r,c=q.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (nr,nc) in cells and (nr,nc) not in seen:
                seen.add((nr,nc));q.append((nr,nc))
    return len(seen)==len(cells)

def mirror(g):
    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)],[np.fliplr(g), g]])

def solve(g):
    out=mirror(g).copy(); H,W=out.shape
    q=deque(); seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(out==2):
        q.append((int(r),int(c))); seen[r,c]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and out[nr,nc]"'!=5 and out[nr,nc] in (0,2):
                seen[nr,nc]=True
                if out[nr,nc]==0: out[nr,nc]=2
                q.append((nr,nc))
    return out

def reach_info(g, seed):
    H,W=g.shape
    q=deque([seed]); seen={seed}; touch=False
    while q:
        r,c=q.popleft()
        if r in (0,H-1) or c in (0,W-1): touch=True
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<H and 0<=nc<W and (nr,nc) not in seen and g[nr,nc] in (0,2):
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen), touch

def mirrored_seed_infos(g):
    mg=mirror(g); H,W=mg.shape
    infos=[]; seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(mg==2):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=True; cells=[]; touch=False
        while q:
            x,y=q.popleft(); cells.append((x,y))
            if x in (0,H-1) or y in (0,W-1): touch=True
            for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
                if 0<=nx<H and 0<=ny<W and not seen[nx,ny] and mg[nx,ny] in (0,2):
                    seen[nx,ny]=True; q.append((nx,ny))
        infos.append((len(cells),touch))
    return infos

def bbox(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs),min(cs),max(rs),max(cs)

results=[]
H=W=6
positions=[(1,1)] # fixed one-cell margin with 4x4 bbox
for k in range(4,7):
  for comb in combinations(CELLS,k):
    if not conn(comb): continue
    r0,c0,r1,c1=bbox(comb)
    if r0!=0 or c0!=0 or r1!=3 or c1!=3: # use full 4x4 bbox to get bigger effects
        continue
    comp=set(comb)
    # endpoints / line-ish: degrees <=2 and exactly 2 endpoints maybe allow 3?
    degs=[]
    for r,c in comp:
        deg=sum((nr,nc) in comp for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)))
        degs.append(deg)
    if max(degs)>2 or sum(d==1 for d in degs)!=2:
        continue
    for sr in range(4):
      for sc in range(4):
        if (sr,sc) in comp: continue
        # build grid with bbox at 1,1
        g=np.zeros((H,W),int)
        for r,c in comp: g[r+1,c+1]=5
        seed=(sr+1,sc+1)
        g[seed]=2
        in_size,touch=reach_info(g,seed)
        if not touch: continue
        if in_size>=H*W-k-1: # too open in input
            continue
        infos=mirrored_seed_infos(g)
        out=solve(g)
        red_frac=(out==2).sum()/out.size
        added=(out==2).sum()-4
        # require at least 2 distinct components or mixed behavior maybe
        nclosed=sum(not t for _,t in infos)
        if 0.12 <= red_frac <= 0.7:
            results.append((nclosed,added,red_frac,comb,(sr,sc),infos,in_size))

print('"'count',len(results))
# sort preferring some closed or moderate fill
results.sort(key=lambda x:(-x[0], abs(x[2]-0.35), x[1]))
for row in results[:80]:
    nclosed,added,frac,comb,seed,infos,in_size=row
    print('closed',nclosed,'added',added,'frac',round(frac,3),'seed',seed,'infos',infos,'inputreach',in_size,'cells',comb)
