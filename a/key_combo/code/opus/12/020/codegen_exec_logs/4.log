0204: def bbox(mask: np.ndarray) -> BBox | None:
0205:     """
0206:     Bounding box (bbox) of a boolean mask.
0207: 
0208:     Args:
0209:         mask: boolean array where True indicates foreground.
0210: 
0211:     Returns:
0212:         (r0,c0,r1,c1) inclusive, or None if the mask has no True values.
0213:     """
0214:     coords = np.argwhere(mask)
0215:     if coords.size == 0:
0216:         return None
0217:     return bbox_coords(coords)
0218: 
0219: 
0220: def bbox_mask(mask: np.ndarray) -> np.ndarray:
0221:     """
0222:     Return a boolean mask that is True exactly inside the bbox of `mask`.
0223: 
0224:     This corresponds to `bounding_box_mask(...)` in the legacy seeds API.
0225:     If `mask` is empty, returns an all-False mask.
0226:     """
0227:     out = np.zeros_like(mask, dtype=bool)
0228:     b = bbox(mask)
0229:     if b is None:
0230:         return out
0231:     r0, c0, r1, c1 = b
0232:     out[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True
0233:     return out
0234: 
0235: 
0236: def bbox_union(bboxes: Iterable[BBox]) -> BBox | None:
0237:     """Union of bboxes, or None for empty input."""
0238:     bbs = list(bboxes)
0239:     if not bbs:
0240:         return None
0241:     r0 = min(b[0] for b in bbs)
0242:     c0 = min(b[1] for b in bbs)
0243:     r1 = max(b[2] for b in bbs)
0244:     c1 = max(b[3] for b in bbs)
0245:     return int(r0), int(c0), int(r1), int(c1)
0246: 
0247: 
0248: def bbox_h(b: BBox) -> int:
0249:     r0, _c0, r1, _c1 = b
0250:     return int(r1 - r0 + 1)
0251: 
0252: 
0253: def bbox_w(b: BBox) -> int:
0254:     _r0, c0, _r1, c1 = b
0255:     return int(c1 - c0 + 1)
0256: 
0257: 
0258: def bbox_anchor(b: BBox, *, anchor: str = "upper left") -> Coord:
0259:     """
0260:     Return an anchor point (r,c) for a bbox.
0261: 
0262:     anchor:
0263:         upper left/right, lower left/right,
0264:         center,
0265:         upper center, lower center,
0266:         left center, right center
0267:     """
0268:     anchor = anchor.lower().replace(" ", "").replace("top", "upper").replace("bottom", "lower")
0269:     r0, c0, r1, c1 = map(int, b)
0270:     h = bbox_h(b)
0271:     w = bbox_w(b)
0272: 
0273:     if anchor == "upperleft":
0274:         rr, cc = r0, c0
0275:     elif anchor == "upperright":
0276:         rr, cc = r0, c1
0277:     elif anchor == "lowerleft":
0278:         rr, cc = r1, c0
0279:     elif anchor == "lowerright":
0280:         rr, cc = r1, c1
0281:     elif anchor == "center":
0282:         rr, cc = r0 + (h - 1) / 2, c0 + (w - 1) / 2
0283:     elif anchor == "uppercenter":
0284:         rr, cc = r0, c0 + (w - 1) / 2
0285:     elif anchor == "lowercenter":
0286:         rr, cc = r1, c0 + (w - 1) / 2
0287:     elif anchor == "leftcenter":
0288:         rr, cc = r0 + (h - 1) / 2, c0
0289:     elif anchor == "rightcenter":
0290:         rr, cc = r0 + (h - 1) / 2, c1
0291:     else:
0292:         raise ValueError("bbox_anchor: invalid anchor")
0293: 
0294:     return int(round(rr)), int(round(cc))
