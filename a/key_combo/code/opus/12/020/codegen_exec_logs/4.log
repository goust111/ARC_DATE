from collections import deque
import numpy as np

def mirror(g):
    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)], [np.fliplr(g), g]])

def infos(g):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    out=[]
    for r,c in np.argwhere(g==2):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=True; n=0; touch=False
        while q:
            x,y=q.popleft(); n+=1
            if x in (0,H-1) or y in (0,W-1): touch=True
            for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
                if 0<=nx<H and 0<=ny<W and not seen[nx,ny] and g[nx,ny] in (0,2):
                    seen[nx,ny]=True; q.append((nx,ny))
        out.append((n,touch))
    return out

def solve(g):
    out=mirror(g).copy(); H,W=out.shape
    q=deque(); seen=np.zeros((H,W),bool)
    for r,c in np.argwhere(out==2):
        q.append((int(r),int(c))); seen[r,c]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and out[nr,nc]"'!=5 and out[nr,nc] in (0,2):
                seen[nr,nc]=True
                if out[nr,nc]==0: out[nr,nc]=2
                q.append((nr,nc))
    return out

cases={
  '"'u_up_touch_top': ([(0,0),(0,2),(1,0),(1,1),(1,2)], (0,1)),
  'u_down_touch_top': ([(0,0),(0,1),(0,2),(1,0),(1,2)], (1,1)),
  'u_left_touch_left': ([(0,0),(0,1),(1,1),(2,0),(2,1)], (1,0)),
  'u_right_touch_left': ([(0,0),(0,1),(1,0),(2,0),(2,1)], (1,1)),
  'L_corner': ([(0,1),(1,0),(1,1)], (0,0)),
  'L_other': ([(0,0),(0,1),(1,0)], (1,1)),
}
for name,(walls,seed) in cases.items():
  for H,W in [(6,6),(7,7)]:
    g=np.zeros((H,W),int)
    for r,c in walls:g[r,c]=5
    g[seed]=2
    mg=mirror(g); m_infos=infos(mg)
    out=solve(g)
    print(name,(H,W),'mirrored',m_infos,'frac',round((out==2).sum()/out.size,3),'added',(out==2).sum()-4)
