    if not ok: continue
    s=(r0+seed_closed[0],seed_closed[1])
    if s[0]>=H: continue
    g[s]=2
    out=solve(g)
    print('closed left',H,W,'r0',r0,'mirrored',infos(mirror(g)),'frac',round((out==2).sum()/out.size,3),'added',(out==2).sum()-4)
