0197: def bbox_coords(coords: np.ndarray) -> BBox:
0198:     """BBox of an (N,2) coords array (r,c). Returns (r0,c0,r1,c1) inclusive."""
0199:     r0, c0 = coords.min(axis=0)
0200:     r1, c1 = coords.max(axis=0)
0201:     return int(r0), int(c0), int(r1), int(c1)
0202: 
