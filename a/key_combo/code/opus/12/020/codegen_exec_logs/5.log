+def _validate_generated(grid: np.ndarray) -> bool:
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2:
+        return False
+    h, w = grid.shape
+    if max(h, w) > 30:
+        return False
+    if np.any(grid[:, 0] == GREY):
