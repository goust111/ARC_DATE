+def _valid_obstacle(candidate: list[tuple[int, int]], h: int, w: int) -> bool:
+    rows = {r for r, _ in candidate}
+    cols = {c for _, c in candidate}
+    if any(not _in_bounds((h, w), r, c) for r, c in candidate):
