+def _place_distractor_obstacle(
+    rng: random.Random,
+    grid: np.ndarray,
+    orientation: str,
+    occupied: set[tuple[int, int]],
+    marker_rows: list[int],
+) -> bool:
+    h, w = grid.shape
+    cells = [(r, c) for r in range(h) for c in range(1, w)]
+    rng.shuffle(cells)
+    for r, c in cells:
+        if orientation == "h":
+            candidate = [(r, c), (r, c + 1)]
+        else:
