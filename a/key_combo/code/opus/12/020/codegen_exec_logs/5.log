+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(12, 17)
+    w = rng.randint(12, 20)
+    max_markers = min(5, (h - 3) // 2)
+    if max_markers < 3:
+        return None
+    marker_count = rng.randint(3, max_markers)
+    marker_rows = _choose_marker_rows(rng, h, marker_count)
