+def _obstacle_shapes(grid: np.ndarray) -> list[tuple[int, int]]:
+    comps, _ = _obstacle_components(grid)
+    shapes = []
+    for comp in comps:
+        rs = [r for r, _ in comp]
+        cs = [c for _, c in comp]
+        shapes.append((max(rs) - min(rs) + 1, max(cs) - min(cs) + 1))
+    return shapes
