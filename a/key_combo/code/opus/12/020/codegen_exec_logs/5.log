+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _obstacle_components(grid: np.ndarray) -> tuple[list[list[tuple[int, int]]], dict[tuple[int, int], int]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    index: dict[tuple[int, int], int] = {}
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != GREY or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                index[(rr, cc)] = len(comps)
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds((h, w), nr, nc) and not seen[nr, nc] and grid[nr, nc] == GREY:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps, index
+
