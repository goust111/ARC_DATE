+        "marker_rows": [r for r, _ in markers],
+        "marker_count": len(markers),
+        "obstacle_shapes": _obstacle_shapes(grid),
+        "blocked": blocked,
+        "unblocked": unblocked,
+        "painted_lengths": painted_lengths,
+        "new_cells": int(np.count_nonzero((out != grid) & (grid == BG))),
+    }
+
