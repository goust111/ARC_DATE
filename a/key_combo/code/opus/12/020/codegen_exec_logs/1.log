+def _remove_cells(grid: np.ndarray, cells: np.ndarray) -> np.ndarray:
+    g2 = np.asarray(grid, dtype=int).copy()
+    g2[cells[:, 0], cells[:, 1]] = BLACK
+    return g2
+
+
+def _obstacle_components(grid: np.ndarray) -> list[np.ndarray]:
