def _halo_offsets(fh, fw):
    """Compute offsets around a frame bbox that lie outside it (the halo)."""
    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)
            if not (0 <= dr < fh and 0 <= dc < fw)]


