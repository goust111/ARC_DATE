+    return True
+
+
+def _paint(grid: np.ndarray, cells: np.ndarray, color: int) -> None:
+    grid[cells[:, 0], cells[:, 1]] = int(color)
+
+
+def _sample_gap_rows(row_limit: int) -> tuple[int, int] | None:
+    pairs: list[tuple[int, int]] = []
+    for a_top in range(1, row_limit - 1):
