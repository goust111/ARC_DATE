+            matched_hole = None
+            next_cells = frozenset((int(r), int(c)) for r, c in next_coords)
+            if len({int(r) for r, _c in next_cells}) == 1:
+                for hole in holes:
+                    if hole["filled"]:
+                        continue
+                    if next_cells == hole["cell_set"]:
+                        matched_hole = hole
+                        break
