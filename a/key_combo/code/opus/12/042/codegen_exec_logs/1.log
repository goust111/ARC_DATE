+    holes: list[dict] = []
+    for platform in platforms:
+        for hole in platform["holes"]:
+            holes.append({**hole, "filled": False})
+
+    order = sorted(
+        sprites,
+        key=lambda comp: (
+            _nearest_platform_distance(comp, platforms),
+            int(comp["bbox"][1]),
+            int(comp["bbox"][0]),
+        ),
+    )
