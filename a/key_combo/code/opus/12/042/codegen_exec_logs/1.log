+    trace: dict[int, dict] = {}
+    for idx, sprite in enumerate(order):
+        coords = sprite["coords"].copy()
+        color = int(sprite["color"])
+        event = "bottom"
+        embedded_hole: frozenset[tuple[int, int]] | None = None
+
