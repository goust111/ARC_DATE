+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _component_mask(coords: np.ndarray) -> np.ndarray:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _find_sprite_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    fg = (grid != BG) & (grid != PLATFORM)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not fg[r, c] or seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                assert int(grid[cr, cc]) == color, "each sprite must be monochromatic"
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and fg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": _component_mask(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _parse_platforms(grid: np.ndarray) -> list[dict]:
+    platforms: list[dict] = []
+    for r in range(grid.shape[0]):
+        cols = np.flatnonzero(grid[r] == PLATFORM)
+        if cols.size == 0:
+            continue
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        holes: list[dict] = []
+        c = c0
+        while c <= c1:
+            if grid[r, c] != BG:
+                c += 1
+                continue
+            start = c
+            while c <= c1 and grid[r, c] == BG:
+                c += 1
+            end = c - 1
+            cells = tuple((r, cc) for cc in range(start, end + 1))
+            holes.append(
+                {
+                    "row": r,
+                    "c0": start,
+                    "c1": end,
+                    "cells": cells,
+                    "cell_set": frozenset(cells),
+                    "length": end - start + 1,
+                }
+            )
+        platforms.append({"row": r, "c0": c0, "c1": c1, "holes": holes})
+    return platforms
+
+
+def _nearest_platform_distance(sprite: dict, platforms: list[dict]) -> int:
+    _r0, c0, r1, c1 = sprite["bbox"]
+    cols = range(c0, c1 + 1)
+    best: int | None = None
+    for platform in platforms:
+        if platform["row"] <= r1:
+            continue
+        if any(platform["c0"] <= c <= platform["c1"] for c in cols):
+            dist = int(platform["row"] - r1 - 1)
+            if best is None or dist < best:
+                best = dist
+    if best is None:
+        return 10**6
+    return best
