+
+def _can_place_sprite(
+    shape: Iterable[tuple[int, int]],
+    top: int,
+    left: int,
+    h: int,
+    w: int,
+    occupied: set[tuple[int, int]],
+) -> bool:
+    cells = _sprite_cells(shape, top, left)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied:
+            return False
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if (nr, nc) in occupied:
+                    return False
