+    top_row = random.randint(5, 7)
+    gap1 = random.randint(3, 4)
+    gap2 = random.randint(3, 4)
+    row2 = top_row + gap1
+    row3 = row2 + gap2
+    if row3 >= h - 2:
+        return None
+    use_row4 = row3 + 3 < h and random.random() < 0.65
+    row4 = row3 + random.randint(3, 4) if use_row4 else None
+    if row4 is not None and row4 >= h:
+        return None
