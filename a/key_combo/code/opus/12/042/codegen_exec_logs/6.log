+        if hit:
+            assert vals == {Color.GREEN}, "selected hole must be fully green"
+        else:
+            assert vals == {Color.BLACK}, "unselected hole must stay black"
+    assert np.all(out[top == Color.RED] == Color.RED), "frame walls must remain red"
