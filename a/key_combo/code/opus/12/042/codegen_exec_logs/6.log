+def _black_components(panel: np.ndarray) -> list[np.ndarray]:
+    h, w = panel.shape
+    black = panel == Color.BLACK
+    seen = np.zeros_like(black, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not black[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
