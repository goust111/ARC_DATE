+            c0 = int(np.random.randint(0, w - outer_w + 1))
+            rect = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
+            if any(_expanded_overlap(rect, other, pad=1) for other in rects):
+                continue
