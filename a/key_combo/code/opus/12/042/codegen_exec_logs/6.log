+    exterior_black = (top == Color.BLACK) & ~union_holes
+
+    for r, c in _choose_signal_positions(red_border, 1, 4):
+        active[r, c] = True
+    for r, c in _choose_signal_positions(exterior_black, 1, 5):
+        active[r, c] = True
+
+    if np.random.rand() < 0.5:
