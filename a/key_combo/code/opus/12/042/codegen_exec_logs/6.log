            flood_fill(mask, r, W - 1, 42)
    for c in range(W):
        if int(grid[0, c]) == bg:
            flood_fill(mask, 0, c, 42)
        if int(grid[H - 1, c]) == bg:
            flood_fill(mask, H - 1, c, 42)

    return mask != 42


def object_boundary(grid: np.ndarray, background: int = Color.BLACK) -> np.ndarray:
