+            rects.append(rect)
+            _draw_frame(panel, rect)
+            hole = np.zeros((h, w), dtype=bool)
+            hole[r0 + 1 : r0 + outer_h - 1, c0 + 1 : c0 + outer_w - 1] = True
+            hole_masks.append(hole)
