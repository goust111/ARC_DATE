  "type": "transform_in_place",
  "src": "red marker pixels inside the bbox of a 4-connected green object; red pixels outside all such bboxes are distractors",
  "transform": "paint each selected marker's in-bounds 8-neighborhood blue, except selected marker centers remain red; pixels outside all stamps stay unchanged"
}
</annotation>
