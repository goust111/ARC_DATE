+    selected = set(map(int, np.random.choice(hole_count, size=selected_count, replace=False)))
+
+    active = np.zeros_like(top, dtype=bool)
+    union_holes = np.zeros_like(top, dtype=bool)
+    for hole in holes:
+        union_holes |= hole
