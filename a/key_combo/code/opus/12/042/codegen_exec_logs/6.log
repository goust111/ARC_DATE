+def _split_panels(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    sep = _find_separator_row(grid)
+    top = grid[:sep, :]
+    bottom = grid[sep + 1 :, :]
+    assert top.shape == bottom.shape, "top and bottom panels must align"
+    return top, bottom
