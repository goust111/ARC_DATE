+def _possible_anchors(shape: tuple[tuple[int, int], ...], side: str, grid_shape: tuple[int, int]) -> list[int]:
+    h, w = grid_shape
+    arr = np.array(shape, dtype=int)
+    max_r = int(arr[:, 0].max())
+    max_c = int(arr[:, 1].max())
+    if side in ("top", "bottom"):
+        lo = 1
+        hi = w - 2 - max_c
