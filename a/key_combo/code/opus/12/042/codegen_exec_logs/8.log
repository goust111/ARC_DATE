+def _shape_variants() -> list[tuple[tuple[int, int], ...]]:
+    seeds = [
+        ((0, 0), (0, 1)),
+        ((0, 0), (0, 1), (0, 2)),
+        ((0, 0), (1, 0), (1, 1)),
+    ]
