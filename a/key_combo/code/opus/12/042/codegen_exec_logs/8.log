+        active = random.sample(list(SIDES), active_count)
+        counts = [1] * active_count
+        remaining = total - active_count
+        while remaining > 0:
+            idx = random.randrange(active_count)
+            if counts[idx] < 4:
+                counts[idx] += 1
+                remaining -= 1
+        if len(set(counts)) == 1:
+            continue
+        if not any(v == 4 for v in counts) and random.random() < 0.35:
