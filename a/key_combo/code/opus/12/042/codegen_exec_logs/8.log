+    out: list[tuple[tuple[int, int], ...]] = []
+    for seed in seeds:
+        cur = _normalize(list(seed))
+        for _ in range(4):
+            if cur not in seen:
+                seen.add(cur)
+                out.append(cur)
+            cur = _rotate(cur)
