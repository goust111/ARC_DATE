+                q.append((nr, nc))
+    return exterior
+
+
+def _endpoint_pairs(grid: np.ndarray) -> list[tuple[int, Coord, Coord]]:
+    pairs: list[tuple[int, Coord, Coord]] = []
+    for color in sorted(int(x) for x in np.unique(grid) if int(x) not in (BLACK, BLUE, GRAY)):
