+def _unique_shortest_path(grid: np.ndarray, start: Coord, goal: Coord) -> list[Coord]:
+    h, w = grid.shape
+    dist = np.full((h, w), -1, dtype=int)
+    ways = np.zeros((h, w), dtype=int)
+    q: deque[Coord] = deque([start])
+    dist[start] = 0
+    ways[start] = 1
