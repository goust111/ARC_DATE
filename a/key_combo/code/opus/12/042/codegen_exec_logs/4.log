+def _bbox_clear(grid: np.ndarray, r0: int, c0: int, h: int, w: int, margin: int) -> bool:
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(grid.shape[0], r0 + h + margin)
+    cc1 = min(grid.shape[1], c0 + w + margin)
+    return not np.any(grid[rr0:rr1, cc0:cc1] != BLACK)
