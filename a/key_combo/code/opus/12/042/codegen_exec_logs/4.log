+    exterior = _exterior_black_mask(with_paths)
+    enclosed_comps = []
+    seen = exterior.copy()
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            if with_paths[r, c] != BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            boundary_colors: set[int] = set()
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
