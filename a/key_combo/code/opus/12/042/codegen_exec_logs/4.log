+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GRAY = 5
+ENDPOINT_COLORS = (2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
