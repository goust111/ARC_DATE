+
+
+def _sample_anchors(panel_h: int, panel_w: int) -> list[tuple[int, int]]:
+    positions = [(r, c) for r in range(panel_h - TEMPLATE_H + 1) for c in range(panel_w - TEMPLATE_W + 1)]
+    pairs = []
+    for idx, (r0, c0) in enumerate(positions):
