+    if not np.array_equal(out, expected):
+        return False
+
+    catalog_h = _catalog_height(grid)
+    lower = grid[catalog_h:, :]
+    sep = _separator_col(lower)
+    left = lower[:, :sep]
+    right = lower[:, sep + 1 :]
+
+    templates = _extract_catalog_templates(grid[:catalog_h, :])
+    if len(templates) != 4:
