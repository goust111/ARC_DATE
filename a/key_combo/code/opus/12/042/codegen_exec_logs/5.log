  templates:
    count: 2-3, embedded inside catalog strip, 8-adjacent to catalog background
    size: 2x2 to 5x5; each template has exactly 2 colors
    structure: frame-and-fill (border color wraps interior color) or patterned; always 180-degree rotationally symmetric [observed]
    border_color: at least one color touches the sprite bbox boundary
    constraint: if two templates share the same bbox shape, their border colors must be disjoint
  workspace:
    region: the black area outside the catalog strip
    matched_objects: 2-5 solid-filled rectangles, each same bbox shape as a template, filled with that template's border color; solver stamps the full template at aligned position
    distractors: 7-11 solid-filled rectangles of 1x1 to 3x3; use template colors, catalog color, or novel colors; must NOT match any template (wrong size or wrong border color)
    total_objects: 11-16
    spacing: objects >=2 apart (Chebyshev); stamps may overlap distractors in output
  output: input with each matched object replaced by the full template sprite at aligned position; distractors unchanged

generation_strategy:
