+
+            right_mask = np.zeros_like(template, dtype=bool)
+            for coord in list(_RIGHT_VISIBLE_SHARED) + list(_RIGHT_FEATURES[right_idx]):
+                tr, tc = _transform_coord(coord, flip_vertical)
