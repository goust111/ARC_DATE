+    return grid
+
+
+def _validate_generated_instance(
+    grid: np.ndarray,
+    family_by_id: dict[int, dict],
+    expected_left: np.ndarray,
+    expected_right: np.ndarray,
+) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+
+    out = main(grid)
