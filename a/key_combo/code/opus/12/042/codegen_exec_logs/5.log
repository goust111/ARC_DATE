+    mirrored = [np.fliplr(t) for t in templates]
+
+    left_objects = _components(left != BLACK)
+    right_objects = _components(right != BLACK)
+    if len(left_objects) != 2 or len(right_objects) != 2:
+        return False
+
+    for obj in left_objects:
