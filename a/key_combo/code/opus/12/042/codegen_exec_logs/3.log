+    candidates = []
+    for pr in range(h):
+        for pc in range(w):
+            shape = _shape_cells((pr, pc), orientation)
+            if any(not (0 <= r < h and 0 <= c < w) for r, c in shape):
+                continue
+            if shape & sprite_cells:
+                continue
+            blocked = False
+            for r, c in shape:
+                if (r, c) in marker_cells:
+                    blocked = True
+                    break
