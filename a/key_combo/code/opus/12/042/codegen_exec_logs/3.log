+def _distance_to_boundary(coords: np.ndarray, push: str, shape: tuple[int, int]) -> int:
+    h, w = shape
+    if push == "up":
+        return int(np.min(coords[:, 0]))
+    if push == "down":
+        return int(h - 1 - np.max(coords[:, 0]))
