+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+
+SHAPES = {
+    "up": {(-1, 0), (0, -1), (0, 0), (0, 1)},
+    "down": {(1, 0), (0, -1), (0, 0), (0, 1)},
+    "left": {(-1, 0), (0, 0), (1, 0), (0, -1)},
+    "right": {(-1, 0), (0, 0), (1, 0), (0, 1)},
