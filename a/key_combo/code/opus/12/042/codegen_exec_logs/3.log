+        (sr, sc), marker = touches[0]
+        assert marker not in used_markers, "a marker cannot serve multiple sprites"
+        used_markers.add(marker)
+        dr = marker[0] - sr
+        dc = marker[1] - sc
+        contact = next(name for name, vec in DIRS.items() if vec == (dr, dc))
+        push = OPPOSITE[contact]
