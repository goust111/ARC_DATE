+        assert comp["area"] == 4, "every sprite must have exactly four cells"
+        coords = comp["coords"]
+        orientation = _decode_orientation(coords)
+        touches = []
+        for r, c in coords.tolist():
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if (nr, nc) in marker_cells:
