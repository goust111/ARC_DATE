+        cands = _candidate_input_shapes(spec["cells"], shape, lengths[idx], force_slide, allow_blocked)
+        if not cands:
+            return None
+        candidate_cache[idx] = cands[:60]
+
+    records: list[dict | None] = [None] * len(final_specs)
+    occupied: set[Coord] = set()
+
+    def dfs(pos: int) -> bool:
