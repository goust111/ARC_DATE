+    lengths = list(range(3, 3 + len(final_specs)))
+    random.shuffle(lengths)
+    if collision_ids:
+        collider_idx = next(iter(collision_ids))
+        blocker_idx = collider_idx - 1
+        lengths[blocker_idx], lengths[collider_idx] = min(lengths), max(lengths)
+
+    order = list(range(len(final_specs)))
+    if collision_ids:
+        collider_idx = next(iter(collision_ids))
+        order = [collider_idx, collider_idx - 1] + [i for i in order if i not in {collider_idx, collider_idx - 1}]
