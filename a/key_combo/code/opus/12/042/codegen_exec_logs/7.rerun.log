+    records: list[dict | None] = [None] * len(final_specs)
+    input_occupied: set[Coord] = set()
+    for idx in order:
+        spec = final_specs[idx]
+        allow_blocked = idx in collision_ids
+        force_slide = spec.get("preferred_slide")
+        candidates = _candidate_input_shapes(spec["cells"], shape, lengths[idx], force_slide, allow_blocked)
+        placed = None
+        for cand in candidates:
+            if _touches_any(cand["all_cells"], input_occupied, shape):
