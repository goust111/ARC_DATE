+
+
+def _place_bridge_pair(shape: tuple[int, int], occupied: set[Coord], color: int) -> list[dict] | None:
+    h, w = shape
+    for _ in range(200):
+        orient = random.choice(("h", "v"))
+        gap = random.randint(2, 4)
+        if orient == "h":
+            r = random.randint(2, h - 3)
+            c1 = random.randint(1, w - (gap + 6))
+            c2 = c1 + gap + 3
+            cells_a = [(r, c1), (r, c1 + 1)]
+            cells_b = [(r, c2), (r, c2 + 1)]
