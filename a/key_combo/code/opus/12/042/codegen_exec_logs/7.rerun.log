+            {
+                "color": obj["color"],
+                "cells": chosen_cells,
+                "attach": chosen_attach,
+                "body_vec": body_vec,
+                "path": list(obj["path"]),
+                "blocked": chosen_attach != obj["path"][-1],
+            }
+        )
+    return settled
+
+
+def _paint_bridges(out: np.ndarray, settled: list[dict]) -> None:
+    by_color: dict[int, list[dict]] = defaultdict(list)
+    for obj in settled:
+        by_color[int(obj["color"])].append(obj)
