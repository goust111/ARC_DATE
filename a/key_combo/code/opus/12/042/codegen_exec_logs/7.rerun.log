+                        bottom_start = a_rows[0]
+                    else:
+                        top_end = a_rows[-1]
+                        bottom_start = b_rows[0]
+                    if bottom_start - top_end > 1 and np.all(out[top_end + 1 : bottom_start, col] == FILL_COLOR):
+                        has_bridge = True
