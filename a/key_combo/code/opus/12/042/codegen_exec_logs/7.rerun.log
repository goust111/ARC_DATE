+                                "other0": other0,
+                                "path": path,
+                                "attach_final": attach_final,
+                                "cells_final": set(final_cells),
+                                "body_vec": body_vec,
+                                "slide_dir": d2,
+                                "all_cells": all_cells,
+                            }
+                        )
+    random.shuffle(candidates)
+    return candidates
+
+
+def _render_input(records: list[dict], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for rec in records:
+        color = int(rec["color"])
+        for r, c in rec["path"]:
