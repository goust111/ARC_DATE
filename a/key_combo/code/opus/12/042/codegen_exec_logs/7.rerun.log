+    if not any(_turn_count([obj["other"], obj["attach"]] + obj["path"]) >= 2 for obj in parsed):
+        return None
+    if np.array_equal(inp, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
