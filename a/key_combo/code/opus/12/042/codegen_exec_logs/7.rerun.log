+            start = random.randint(1, w - 7)
+            cells_collider = [(r, start), (r, start + 1)]
+            cells_blocker = [(r, start + 3), (r, start + 4)]
+            slide_dir = (0, 1)
+        else:
+            c = random.randint(2, w - 3)
+            start = random.randint(1, h - 7)
+            cells_collider = [(start, c), (start + 1, c)]
+            cells_blocker = [(start + 3, c), (start + 4, c)]
+            slide_dir = (1, 0)
