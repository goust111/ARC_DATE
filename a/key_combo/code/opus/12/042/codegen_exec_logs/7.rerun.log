+
+
+def _place_collision_pair(shape: tuple[int, int], occupied: set[Coord], blocker_color: int, collider_color: int) -> list[dict] | None:
+    h, w = shape
+    for _ in range(200):
+        orient = random.choice(("h", "v"))
+        if orient == "h":
