+
+def _cells_for_domino(anchor: Coord, orient: str) -> list[Coord]:
+    r, c = anchor
+    if orient == "h":
+        return [(r, c), (r, c + 1)]
+    return [(r, c), (r + 1, c)]
+
+
+def _touches_any(cells: set[Coord], occupied: set[Coord], shape: tuple[int, int]) -> bool:
+    for r, c in cells:
+        if not _in_bounds(shape, r, c):
