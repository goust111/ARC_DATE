            bad=True
            break
        rec = {'color': spec['color'], **placed}
        records[idx] = rec
        input_occupied.update(placed['all_cells'])
    if bad:
        continue

    inp = mod._render_input([rec for rec in records if rec is not None], shape)
    try:
