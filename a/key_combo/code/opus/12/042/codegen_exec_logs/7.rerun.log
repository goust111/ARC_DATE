+
+def _turn_count(points: list[Coord]) -> int:
+    if len(points) < 3:
+        return 0
+    turns = 0
+    prev = _direction(points[0], points[1])
+    for i in range(1, len(points) - 1):
+        cur = _direction(points[i], points[i + 1])
+        if cur != prev:
+            turns += 1
+        prev = cur
+    return turns
