+                            continue
+                        candidates.append(candidate)
+    random.shuffle(candidates)
+    return candidates
+
+
+def _render_input(records: list[dict], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for rec in records:
+        color = int(rec["color"])
+        for r, c in rec["path"]:
