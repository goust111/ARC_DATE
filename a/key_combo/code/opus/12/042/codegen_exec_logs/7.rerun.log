+                        right_start = a_cols[0]
+                    else:
+                        left_end = a_cols[-1]
+                        right_start = b_cols[0]
+                    if right_start - left_end > 1 and np.all(out[row, left_end + 1 : right_start] == FILL_COLOR):
+                        has_bridge = True
+                elif same_col:
