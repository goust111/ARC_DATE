+    # Straight same-color chains are ambiguous; generated inputs avoid them.
+    uniq: list[dict] = []
+    for cand in candidates:
+        key = (cand["attach"], cand["other"], tuple(cand["path"]))
+        if all((key != (u["attach"], u["other"], tuple(u["path"]))) for u in uniq):
