        continue
    if collision_ids and not any(obj['blocked'] for obj in settled):
        reasons['collision_missing'] += 1
        continue
    if not any(mod._turn_count([obj['other'], obj['attach']] + obj['path']) >= 2 for obj in parsed):
        reasons['no_two_turn_chain'] += 1
        continue
    if (inp == out).all():
        reasons['same_io'] += 1
        continue
    reasons['success'] += 1
print(reasons)
