+from __future__ import annotations
+
+from collections import defaultdict
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+DIRS4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MOVE_TO_ORIENT = {(0, 1): "h", (0, -1): "h", (1, 0): "v", (-1, 0): "v"}
+NON_FILL_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+FILL_COLOR = 8
+GEN_ATTEMPTS = 600
