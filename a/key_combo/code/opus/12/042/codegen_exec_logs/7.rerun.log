+    attach_neighbors = [cell for cell in remaining if attach in _neighbors4(*cell)]
+    if len(attach_neighbors) != 1:
+        return None
+    start = attach_neighbors[0]
+    ordered = [start]
+    used = {start}
+    prev = attach
+    cur = start
+    while True:
+        nxt = [nb for nb in _neighbors4(*cur) if nb in remaining and nb != prev]
+        if len(nxt) > 1:
+            return None
+        if not nxt:
+            break
+        prev, cur = cur, nxt[0]
+        if cur in used:
+            return None
+        used.add(cur)
+        ordered.append(cur)
+    if used != remaining:
+        return None
+    if start not in starts and len(remaining) > 1:
+        return None
+    return ordered
+
+
