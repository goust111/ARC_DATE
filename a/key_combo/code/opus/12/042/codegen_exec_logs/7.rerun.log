+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    objects = _parse_objects(g)
+    settled = _settle_objects(objects, g.shape)
+
+    out = np.zeros_like(g)
+    for obj in settled:
+        for r, c in obj["cells"]:
+            out[r, c] = int(obj["color"])
+    _paint_bridges(out, settled)
+    return out
