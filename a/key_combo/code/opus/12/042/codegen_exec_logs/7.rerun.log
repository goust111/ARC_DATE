+                    {
+                        "color": color,
+                        "other": other,
+                        "attach": attach,
+                        "path": path,
+                        "body_vec": (other[0] - attach[0], other[1] - attach[1]),
+                        "path_len": len(path),
+                        "chain_turns": _turn_count(chain),
