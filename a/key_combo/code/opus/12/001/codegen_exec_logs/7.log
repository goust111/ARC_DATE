+import numpy as np
+
+
+BG = 0
+TEMPLATE = 1
+OVERLAP = 2
+WALL = 9
+
+GRID_H_RANGE = (14, 18)
+GRID_W_RANGE = (22, 28)
+TEMPLATE_BBOX_CHOICES = [(3, 3), (3, 4), (4, 3)]
+TEMPLATE_AREA_RANGE = (5, 8)
+COPY_COUNT_RANGE = (4, 6)
+GEN_ATTEMPTS = 800
