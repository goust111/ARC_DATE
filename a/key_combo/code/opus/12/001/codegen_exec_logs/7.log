+    grid = _build_input(rel_cells, (box_h, box_w), lattice, origin, (grid_h, grid_w), template_top, markers)
+    if not _validate_generated(grid, rel_cells, lattice, origin, template_top, (box_h, box_w)):
+        return None
+    return grid
