+def _shape_mask(rel_cells: list[tuple[int, int]], box_h: int, box_w: int) -> np.ndarray:
+    mask = np.zeros((box_h, box_w), dtype=bool)
+    for r, c in rel_cells:
+        mask[r, c] = True
+    return mask
