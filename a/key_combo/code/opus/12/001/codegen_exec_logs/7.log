+    box_h = parsed["box_h"]
+    box_w = parsed["box_w"]
+    origin_r, origin_c, _ = parsed["markers"][0]
+    copies: list[dict] = []
+    for mr, mc, is_origin in parsed["markers"]:
+        dr = mr - origin_r
+        dc = mc - origin_c
+        assert dr % box_h == 0 and dc % box_w == 0, "marker offsets must be whole template units"
+        unit_r = dr // box_h
+        unit_c = dc // box_w
