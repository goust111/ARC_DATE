def _component_crop(grid: np.ndarray, coords: np.ndarray, bg: int) -> np.ndarray:
    r0, c0, r1, c1 = bbox_coords(coords)
    crop = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
    rr = coords[:, 0] - r0
    cc = coords[:, 1] - c0
    crop[rr, cc] = grid[coords[:, 0], coords[:, 1]]
    return crop


