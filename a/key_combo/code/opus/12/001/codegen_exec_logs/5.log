+    return {
+        "grid": g,
+        "frames": frames,
+        "active_by_color": active_by_color,
+        "inactive_frames": inactive_frames,
+        "control_rows": control_rows,
+        "valid_rows": valid_rows,
+        "bridges_by_row": bridges_by_row,
+    }
