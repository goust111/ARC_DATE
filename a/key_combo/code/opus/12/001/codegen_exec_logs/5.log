def _gen_place_rectangles(
    sizes: list[tuple[int, int]],
) -> list[tuple[int, int, int, int]] | None:
    sizes = sorted(sizes, key=lambda s: s[0] * s[1], reverse=True)
    placed: list[tuple[int, int, int, int]] = []

    def search(i: int) -> bool:
        if i == len(sizes):
