+
+    row0 = max(iar0, ibr0)
+    row1 = min(iar1, ibr1)
+    if row0 <= row1:
+        if ac1 < bc0 - 1:
+            candidates.append(
+                {
+                    "orientation": "h",
+                    "r0": row0,
+                    "r1": row1,
+                    "c0": ac1 + 1,
+                    "c1": bc0 - 1,
+                    "gap": bc0 - ac1 - 1,
+                }
+            )
+        elif bc1 < ac0 - 1:
+            candidates.append(
+                {
+                    "orientation": "h",
+                    "r0": row0,
+                    "r1": row1,
+                    "c0": bc1 + 1,
+                    "c1": ac0 - 1,
+                    "gap": ac0 - bc1 - 1,
+                }
+            )
+
+    col0 = max(iac0, ibc0)
+    col1 = min(iac1, ibc1)
+    if col0 <= col1:
+        if ar1 < br0 - 1:
+            candidates.append(
+                {
+                    "orientation": "v",
+                    "r0": ar1 + 1,
+                    "r1": br0 - 1,
+                    "c0": col0,
+                    "c1": col1,
+                    "gap": br0 - ar1 - 1,
+                }
+            )
+        elif br1 < ar0 - 1:
+            candidates.append(
+                {
+                    "orientation": "v",
+                    "r0": br1 + 1,
+                    "r1": ar0 - 1,
+                    "c0": col0,
+                    "c1": col1,
+                    "gap": ar0 - br1 - 1,
+                }
+            )
