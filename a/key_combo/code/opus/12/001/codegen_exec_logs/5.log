+def _adjacent_nodes(rows: int, cols: int, node: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = node
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < rows:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < cols:
+        out.append((r, c + 1))
