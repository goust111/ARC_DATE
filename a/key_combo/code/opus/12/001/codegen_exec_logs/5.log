+    def dfs(path: list[tuple[int, int]], used: set[tuple[int, int]]) -> list[tuple[int, int]] | None:
+        if len(path) == length:
+            if not require_turn or _path_has_turn(path):
+                return path[:]
+            return None
+        for nxt in _adjacent_nodes(rows, cols, path[-1]):
+            if nxt in used:
+                continue
+            used.add(nxt)
+            path.append(nxt)
+            found = dfs(path, used)
+            if found is not None:
+                return found
+            path.pop()
+            used.remove(nxt)
