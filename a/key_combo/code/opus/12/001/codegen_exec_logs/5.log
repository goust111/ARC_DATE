+def _partition_repeated_count(total: int) -> list[int] | None:
+    if total < 2:
+        return None
+    if total == 2:
+        return [2]
+    if total == 3:
+        return [3]
+    options = ([2, 2], [4])
+    if total == 5:
+        options = ([2, 3], [5])
+    if total == 6:
+        options = ([3, 3], [2, 4], [6])
+    valid = [list(opt) for opt in options if sum(opt) == total]
