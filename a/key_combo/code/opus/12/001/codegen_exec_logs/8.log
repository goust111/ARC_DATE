+    opened_markers: set[tuple[int, int]] = set()
+    horizontal_segments: list[tuple[int, int, int]] = []
+
+    while pending:
+        r, c, axis = pending.pop()
+        key = (r, c, axis)
+        if key in seen_segments:
+            continue
+        seen_segments.add(key)
+
+        if axis == "h":
