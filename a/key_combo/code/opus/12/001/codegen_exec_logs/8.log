+        if axis == "h":
+            dirs = ((0, -1), (0, 1))
+            next_axis = "v"
+        else:
+            dirs = ((-1, 0), (1, 0))
+            next_axis = "h"
+
+        segment_cells = {(r, c)}
+        new_segments: list[tuple[int, int, str]] = []
+        for dr, dc in dirs:
+            prev_r, prev_c = r, c
+            rr, cc = r + dr, c + dc
