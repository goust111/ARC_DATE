+    pending: list[tuple[int, int, str]] = [(start[0], start[1], "h")]
+    seen_segments: set[tuple[int, int, str]] = set()
+    opened_markers: set[tuple[int, int]] = set()
+    horizontal_segments: list[tuple[int, int, int]] = []
+
+    while pending:
