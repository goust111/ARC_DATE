+        generation += 1
+        paint_color = PINK if generation % 2 == 1 else ORANGE
+
+        for seed in seeds:
+            row = int(seed["row"])
+            active: set[int] = set(seed["active"])
+            if row + 2 >= h or len(active) < 3:
+                continue
+
+            mask = np.zeros(w, dtype=bool)
+            for c in active:
+                mask[c] = True
