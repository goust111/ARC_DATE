+            continue
+        if not np.array_equal(full, np.flipud(full)):
+            continue
+        if _exact_axis_period(full, axis=0) != row_period:
+            continue
+        if _exact_axis_period(full, axis=1) != col_period:
+            continue
+        return full, row_period, col_period
+
+
