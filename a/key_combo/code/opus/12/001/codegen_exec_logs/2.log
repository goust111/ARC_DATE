+            bottom = r0 + CELL_SIZE if r0 + CELL_SIZE < h else h - 1
+            left = c0 - 1 if c0 > 0 else 0
+            right = c0 + CELL_SIZE if c0 + CELL_SIZE < w else w - 1
+            if (
+                np.any(grid_with_rays[top, c0 : c0 + CELL_SIZE] == RED)
