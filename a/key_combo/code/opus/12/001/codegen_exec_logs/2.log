+                continue
+            cell = g[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
+            if np.all(cell[mask] == BLUE):
+                out_cell = out[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
+                out_cell[mask] = GREEN
+
