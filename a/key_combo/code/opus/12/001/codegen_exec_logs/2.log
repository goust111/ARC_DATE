+            if np.all(patch == GREEN):
+                mask[mr, mc] = True
+            else:
+                assert np.all(patch == BLACK), "instruction bits must be solid 2x2 green blocks"
+    assert np.any(mask), "instruction mask must contain at least one marked bit"
+    return mask
+
