+        probe_active_nonmatch[0] : probe_active_nonmatch[0] + CELL_SIZE,
+        probe_active_nonmatch[1] : probe_active_nonmatch[1] + CELL_SIZE,
+    ]
+    if np.any(probe_out[mask] == GREEN):
+        return None
+
+    if len(opened) == len(markers) and np.random.rand() < 0.45:
+        return None
+
+    return grid
