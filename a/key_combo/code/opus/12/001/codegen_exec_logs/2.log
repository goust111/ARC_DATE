+    assert g.shape == (GRID_SIZE, GRID_SIZE), "expected a 19x19 grid"
+
+    mask = _instruction_mask(g)
+    traced, _opened, _hit_counts = _trace_rays(g)
+    active = _active_cells(traced)
+
+    out = traced.copy()
+    for r0 in CELL_STARTS:
+        for c0 in CELL_STARTS:
