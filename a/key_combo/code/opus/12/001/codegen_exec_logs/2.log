+
+    for r0, c0 in active_match:
+        out_cell = actual[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
+        in_cell = grid[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
