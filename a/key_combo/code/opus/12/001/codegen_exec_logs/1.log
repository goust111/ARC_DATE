+    coords = np.argwhere(frame == color)
+    return tuple(
+        sorted((int(r) - r0, int(c) - c0) for r, c in coords)
+    )
+
+
+def _shift_sprite(frame: np.ndarray, color: int, dr: int, dc: int, bg: int) -> np.ndarray:
+    out = frame.copy()
+    out[out == color] = bg
+    h, w = frame.shape
