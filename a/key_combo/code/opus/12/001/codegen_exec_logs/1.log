+def _attempt_generate(rng: np.random.Generator) -> np.ndarray | None:
+    built = _build_compressed_frames(rng)
+    if built is None:
+        return None
+    compressed_frames, dr, dc, hc, wc = built
+
+    observed = _build_observed_panels(rng, compressed_frames[:4], dr, dc, hc, wc)
+    if observed is None:
+        return None
+    panels, _row_runs, _col_runs = observed
