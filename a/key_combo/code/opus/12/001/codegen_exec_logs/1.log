+def _run_starts(grid: np.ndarray, axis: int) -> list[int]:
+    starts = [0]
+    for i in range(1, grid.shape[axis]):
+        prev = grid[i - 1, :] if axis == 0 else grid[:, i - 1]
+        cur = grid[i, :] if axis == 0 else grid[:, i]
+        if not np.array_equal(prev, cur):
+            starts.append(i)
+    return starts
