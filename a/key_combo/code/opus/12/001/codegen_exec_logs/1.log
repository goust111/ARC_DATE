+            continue
+        if any(np.all(sprite[:, c] == 0) for c in range(shape_w)):
+            continue
+        if any(np.array_equal(sprite[r, :], sprite[r + 1, :]) for r in range(shape_h - 1)):
+            continue
+        if any(np.array_equal(sprite[:, c], sprite[:, c + 1]) for c in range(shape_w - 1)):
