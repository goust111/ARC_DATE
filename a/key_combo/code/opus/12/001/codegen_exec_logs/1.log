+    shape_h = hc - 2
+    shape_w = int(rng.integers(2, 5))
+    wc = int(rng.integers(shape_w + 6, shape_w + 9))
+    max_cells = min(6, shape_h * shape_w)
+    cells = int(rng.integers(max(3, shape_w), max_cells + 1))
