+    inp = _stack_panels(panels)
+    expected = compressed_frames[4]
+    if inp.shape[0] > 30 or inp.shape[1] > 30 or expected.shape[0] > 30 or expected.shape[1] > 30:
+        return None
+    if not _semantic_check(inp, expected, dr, dc):
+        return None
+    return inp
