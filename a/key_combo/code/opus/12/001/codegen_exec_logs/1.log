+def _colored_coords(panel: np.ndarray, bg: int) -> set[tuple[int, int, int]]:
+    return {
+        (int(r), int(c), int(panel[r, c]))
+        for r, c in np.argwhere(panel != bg)
+    }
+
+
+def _translation_delta(a: np.ndarray, b: np.ndarray, bg: int) -> tuple[int, int] | None:
+    coords_a = _colored_coords(a, bg)
+    coords_b = _colored_coords(b, bg)
+    if len(coords_a) != len(coords_b) or not coords_a:
+        return None
+    a_top = _top_left(a, bg)
+    b_top = _top_left(b, bg)
+    dr = b_top[0] - a_top[0]
+    dc = b_top[1] - a_top[1]
+    shifted = {(r + dr, c + dc, color) for r, c, color in coords_a}
+    if shifted == coords_b:
+        return int(dr), int(dc)
+    return None
+
+
+def _raw_motion_is_too_easy(panels: list[np.ndarray], bg: int) -> bool:
+    deltas = [_translation_delta(panels[i], panels[i + 1], bg) for i in range(3)]
+    return deltas[0] is not None and deltas[0] == deltas[1] == deltas[2]
+
+
+def _build_compressed_frames(
+    rng: np.random.Generator,
+) -> tuple[list[np.ndarray], int, int, int, int] | None:
+    branch = "horizontal" if bool(rng.integers(2)) else "vertical"
+    color = int(rng.choice(SPRITE_COLORS))
+
+    if branch == "horizontal":
+        hc = int(rng.integers(4, 6))
+        wc = 6
+        shape_h = int(rng.integers(2, min(4, hc + 1)))
+        shape_w = 1 if bool(rng.integers(2)) else 2
+        max_cells = min(6, shape_h * shape_w)
+        if max_cells < 3:
+            return None
+        cells = int(rng.integers(3, max_cells + 1))
+        coords = _connected_shape(rng, shape_h, shape_w, cells)
+        sh, sw = _shape_bbox(coords)
+        dc = -1 if bool(rng.integers(2)) else 1
+        dr = 0
+        rb = _start_bounds(hc, sh, dr)
+        cb = _start_bounds(wc, sw, dc)
+        if rb is None or cb is None:
+            return None
+        r0 = int(rng.integers(rb[0], rb[1] + 1))
+        c0 = int(rng.integers(cb[0], cb[1] + 1))
+    else:
+        hc = 5
+        wc = int(rng.integers(4, 7))
+        shape_w = int(rng.integers(3, min(6, wc) + 1))
+        coords = tuple((0, c) for c in range(shape_w))
+        sh, sw = 1, shape_w
+        dr = -1 if bool(rng.integers(2)) else 1
+        dc = 0
+        rb = _start_bounds(hc, sh, dr)
+        cb = _start_bounds(wc, sw, dc)
+        if rb is None or cb is None:
+            return None
+        r0 = int(rng.integers(rb[0], rb[1] + 1))
+        c0 = int(rng.integers(cb[0], cb[1] + 1))
+
+    frames = [
+        _paint_shape((hc, wc), coords, color, r0 + t * dr, c0 + t * dc)
+        for t in range(5)
+    ]
