+def _paint_shape(shape: tuple[int, int], coords: tuple[tuple[int, int], ...], color: int, r0: int, c0: int) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for dr, dc in coords:
+        out[r0 + dr, c0 + dc] = int(color)
+    return out
