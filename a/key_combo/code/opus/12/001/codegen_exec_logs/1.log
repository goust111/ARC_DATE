+
+def _sample_run_vectors(
+    rng: np.random.Generator,
+    parts: int,
+    total: int,
+    max_part: int,
+    count: int,
+) -> list[tuple[int, ...]] | None:
+    vectors: list[tuple[int, ...]] = []
+    seen = set()
+    for _ in range(200):
+        if len(vectors) == count:
+            return vectors
+        vec = _bounded_composition(total, parts, max_part, rng)
+        if vec is None or vec in seen:
