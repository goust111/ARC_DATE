+    if not np.array_equal(out[INSTR_R0 : INSTR_R0 + 6, INSTR_C0 : INSTR_C0 + 6], inp[INSTR_R0 : INSTR_R0 + 6, INSTR_C0 : INSTR_C0 + 6]):
