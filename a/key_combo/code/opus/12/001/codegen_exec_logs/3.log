+EMPTY = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+PINK = 6
+
+CELL_SIZE = 3
+STRIDE = 4
+CELL_ROWS = 6
+CELL_COLS = 5
+GRID_SHAPE = (23, 19)
