# Canvas and palette.
GRID_SHAPE = (10, 10)
BACKGROUND_COLOR = Color.ORANGE
N_COLORS = len(PALETTE_ORDER)

# Histogram count sampling.
NONZERO_COLOR_RANGE = (3, 6)
MAX_COUNT_RANGE = (2, 7)
TOTAL_OBJECT_RANGE = (4, 12)

# Blob shape sampling.
N_BLOB_SHAPES = 6
LINE_LENGTH_RANGE = (2, 5)
SMALL_DIM_RANGE = (2, 4)
GROWN_BLOB_MIN_SIZE = 3
PLUS_SHAPE_SIZE = 3

