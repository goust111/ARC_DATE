            _gen_add_segment(cells, 0, b, depth, b)
            _gen_add_segment(cells, depth, a, depth, b)
        else:
            r = h - 1
            inner = r - depth
            for c in range(a + 1, b):
                cells.discard((r, c))
            _gen_add_segment(cells, r, a, inner, a)
            _gen_add_segment(cells, r, b, inner, b)
