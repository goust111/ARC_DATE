+        mr, mc = placed["marker"]
+        grid[mr, mc] = int(placed["marker_color"])
+    return grid
+
+
+def _expected_from_placements(grid: np.ndarray, placements: list[dict]) -> np.ndarray:
+    out = grid.copy()
