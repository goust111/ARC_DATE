+GRID_MAX = 22
+MAX_ATTEMPTS = 400
+MIN_FRAME_GAP = 2
+EXTRA_REGION_WEIGHTS = (0, 1, 1)
+ODD_BLACK_SHAPES = [(3, 4), (4, 4), (3, 6), (4, 5), (5, 6)]
+EVEN_BLACK_SHAPES = [(3, 3), (3, 5), (5, 5)]
+
