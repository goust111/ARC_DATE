+                    if _in_bounds(grid.shape, nr, nc) and grid[nr, nc] == BLACK and labels[nr, nc] < 0:
+                        labels[nr, nc] = comp_id
+                        q.append((nr, nc))
+            components.append(coords)
+            comp_id += 1
+    return components, labels
