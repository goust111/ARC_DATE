+def _compose_ring(sprite: np.ndarray) -> np.ndarray:
+    h, w = map(int, sprite.shape)
+    out = np.full((h + 2 * w, h + 2 * w), BG, dtype=int)
+    out[w : w + h, :w] = sprite
+    out[w : w + h, w + h :] = np.fliplr(sprite)
+    out[:w, w : w + h] = np.rot90(sprite, -1)
+    out[w + h :, w : w + h] = np.rot90(sprite, 1)
+    return out
