                    nnc=c-1 if side=='L' else c+1
                    if not (0<=nnc<W and g[rr,nnc]==GREY):
                        break
                    seen.add((rr,c))
                    rr+=1
                segs+=1
    for side in ('T','B'):
        seen=set()
        for r,c in region:
            nr=r-1 if side=='T' else r+1
            if 0<=nr<H and g[nr,c]==GREY:
                if (r,c) in seen:
                    continue
                pc=c-1
                if pc>=0 and m[r,pc]:
                    pnr=r-1 if side=='T' else r+1
                    if 0<=pnr<H and g[pnr,pc]==GREY:
                        continue
                cc=c
                while cc<W and m[r,cc]:
                    nnr=r-1 if side=='T' else r+1
                    if not (0<=nnr<H and g[nnr,cc]==GREY):
                        break
                    seen.add((r,cc))
                    cc+=1
                segs+=1
    return segs


def regions(g):
    H,W=g.shape
    seen=set(); regs=[]
    for r in range(H):
