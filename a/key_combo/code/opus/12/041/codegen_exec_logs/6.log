+        row_rooms = []
+        for cc, (c0, c1) in enumerate(col_spans):
+            room = {
+                "row": rr,
+                "col": cc,
+                "bbox": (r0, c0, r1, c1),
+                "center2": (r0 + r1, c0 + c1),
