spec:
  grid: 10x10 [observed]
  colors: black (background), red (divider), one payload color (any non-black non-red)
  divider:
    structure: 8-connected path of red pixels spanning border-to-border (left-to-right or left-to-bottom etc.)
    pixel_count: 10-17
    span: occupies 1-3 rows (horizontal-ish) or traces a diagonal staircase; each column has 0-2 red pixels
    partition: non-red cells form exactly 2 four-connected regions
    lower_left: cell (H-1, 0) is never red
  regions:
    smaller_fraction: 0.33-0.49 of non-red area
    fill_side: the region containing (H-1, 0); in output filled solid with payload color
    clear_side: the other region (contains (0, W-1)); in output filled solid black
  noise: in input, both regions have a random mix of payload and black (density ~0.40-0.59 payload) [observed]
  output: same size; red pixels preserved; fill_side solid payload; clear_side solid black

generation_strategy:
  approach: output-first
  steps:
