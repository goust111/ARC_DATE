+    col_spans = _room_spans(col_lines, w)
+    rooms: List[List[Room]] = []
+    pixel_to_room: Dict[Tuple[int, int], Tuple[int, int]] = {}
+    for rr, (r0, r1) in enumerate(row_spans):
+        row_rooms = []
+        for cc, (c0, c1) in enumerate(col_spans):
+            room = {
+                "row": rr,
+                "col": cc,
+                "bbox": (r0, c0, r1, c1),
+                "center2": (r0 + r1, c0 + c1),
