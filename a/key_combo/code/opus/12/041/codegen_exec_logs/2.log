0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Extend the eight non-center cells of a filled 3x3 block as rays to the grid edge.
0009: 
0010:     Input structure
0011:     - The background is the dominant color.
0012:     - All foreground pixels form exactly one filled 3x3 block.
0013:     - The middle cell of that block is the center, and the other eight cells are compass-direction ray seeds.
0014: 
0015:     Rule
0016:     - Keep the input grid unchanged as the base output.
0017:     - For each non-center cell in the 3x3 block, continue its color away from the center in that cell's compass direction.
0018:     - Paint that ray through the starting cell and onward until it leaves the grid.
0019: 
0020:     Key insight
0021:     - The local position of a cell around the 3x3 center is also its global ray direction.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     bg = get_bg(g)
0025:     box = bbox(g != bg)
0026:     assert box is not None
0027:     assert bbox_h(box) == 3
0028:     assert bbox_w(box) == 3
