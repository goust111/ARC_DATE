0013: def main(input_grid):
0014:     """
0015:     Recolor each green object according to how many bends its shape contains.
0016: 
0017:     Input structure:
0018:     - The grid has several green connected objects on a black background.
0019:     - Each object is a small bent shape with one, two, or three corner bends.
0020:     - The generated inputs include at least one object for each bend count.
0021: 
0022:     Rule:
0023:     - Detect each green object and crop its bounding box.
0024:     - Count L-shaped 2x2 bend patterns across all rotations.
0025:     - Recolor objects with one, two, and three bends to blue, pink, and red respectively.
0026: 
0027:     Key insight:
0028:     - Object color is determined by topology of the mask, not by position or size.
0029:     """
0030:     # Create a copy of the input grid to avoid modifying the original
0031:     output_grid = np.copy(input_grid)
0032: 
0033:     # Find all the green objects in the grid
0034:     object_color = Color.GREEN
