0057: def main(grid: np.ndarray) -> np.ndarray:
0058:     """
0059:     Slide every colored domino straight toward the full red edge wall until it is blocked.
0060: 
0061:     Input structure
0062:     - The background is empty space.
0063:     - One non-background color forms a complete one-cell-thick edge wall and appears nowhere else.
0064:     - Every other foreground object is a monochromatic 4-connected domino, either horizontal or vertical.
0065: 
0066:     Rule
0067:     - Keep the edge wall fixed and clear the other foreground objects from their original positions.
0068:     - The wall side gives the gravity direction: objects move up, down, left, or right toward that wall.
0069:     - Settle dominoes nearest the wall first; each domino slides rigidly along the gravity direction until the next step would hit the wall, another settled domino, or the grid boundary.
0070: 
0071:     Key insight
0072:     - The full edge wall is the only anchor; the output is the gravity-packed state of all remaining dominoes against that wall.
0073:     """
0074:     g = np.asarray(grid, dtype=int)
0075:     bg = get_bg(g)
0076:     wall_color, (dr, dc), wall_mask = _find_wall(g, bg)
0077:     moving_colors = colors_present(g, exclude={bg, wall_color})
0078:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=moving_colors)
0079: 
0080:     assert comps, "expected at least one moving domino"
0081:     for comp in comps:
0082:         assert comp["area"] == 2, "expected every moving object to be a domino"
0083: 
0084:     out = np.full_like(g, bg)
0085:     out[wall_mask] = wall_color
