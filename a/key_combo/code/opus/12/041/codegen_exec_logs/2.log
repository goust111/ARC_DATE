0101: def _place_one_bar(N, length, occupied):
0102:     """Return input pixels for one placed bar, mutating occupied on success."""
0103:     half = length // 2
0104:     lo, hi = half, N - 1 - half
0105:     if lo > hi:
0106:         return None
0107:     orient = random.choice(ORIENTATIONS)
0108:     out_orient = "V" if orient == "H" else "H"
0109:     candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]
0110:     random.shuffle(candidates)
0111: 
0112:     for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:
0113:         inp_pixels = _bar_pixels(cr, cc, length, orient)
0114:         out_pixels = _bar_pixels(cr, cc, length, out_orient)
0115:         footprint = inp_pixels | out_pixels
0116:         if footprint & occupied:
0117:             continue
0118:         occupied |= footprint
0119:         return inp_pixels
0120:     return None
0121: 
0122: def _place_bars(N, K):
0123:     occupied = set()
0124:     bars_input = []
0125:     for length in _sample_lengths(N, K):
