0029: def main(grid: np.ndarray) -> np.ndarray:
0030:     """Rotate every foreground bar 90 degrees around its own center on the same canvas.
0031: 
0032:     Input structure
0033:     The background is the dominant color, and all foreground pixels share one color.
0034:     Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical
0035:     bar with odd length, with single-pixel bars allowed.
0036: 
0037:     Rule
0038:     Clear the canvas to the background, then redraw every bar with its midpoint, length,
0039:     and color preserved while swapping horizontal and vertical orientation.
0040: 
0041:     Key insight
0042:     The bars are independent objects: their centers and lengths identify the output
0043:     placement, so no matching, ordering, or global symmetry is needed.
0044:     """
0045:     g = np.asarray(grid, dtype=int)
0046:     bg = get_bg(g)
0047:     fg_colors = colors_present(g, exclude={bg})
0048:     assert len(fg_colors) == 1
0049: 
0050:     out = np.full_like(g, bg)
0051:     h, w = g.shape
0052:     components = find_components(
0053:         g,
0054:         bg=bg,
0055:         connectivity=4,
0056:         monochromatic=True,
0057:         colors=fg_colors,
0058:     )
0059:     assert components
0060: 
0061:     for comp in components:
0062:         color = int(comp["color"])
0063:         for r, c in _rotated_bar_coords(comp["coords"]):
0064:             assert 0 <= r < h and 0 <= c < w
0065:             assert out[r, c] == bg
0066:             out[r, c] = color
0067: 
0068:     return out
0069: 
0070: # --------------- generator (c) ---------------
0071: 
0072: # Palette and canvas options.
0073: BG_COLOR = 7
0074: FG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)
0075: GRID_SIDES = (9, 11, 13)
0076: 
0077: # Bar counts and weighted odd-length sampling.
0078: MIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5
0079: MAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}
0080: LENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}
0081: DEFAULT_LENGTH_WEIGHT = 1
0082: ORIENTATIONS = ("H", "V")
0083: 
0084: # Retry and placement search limits.
0085: OUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50
0086: CENTER_TRIAL_LIMIT = 80
0087: 
0088: def _sample_lengths(N, K):
0089:     possible_lengths = list(range(1, N + 1, 2))
0090:     weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]
0091:     lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)
0092:     lengths.sort(reverse=True)
0093:     return lengths
0094: 
0095: def _bar_pixels(cr, cc, length, orient):
0096:     half = length // 2
0097:     if orient == "H":
0098:         return {(cr, cc + d) for d in range(-half, half + 1)}
0099:     return {(cr + d, cc) for d in range(-half, half + 1)}
