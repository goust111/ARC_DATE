+
+
+def _perimeter_is_nonblack(grid: np.ndarray, rect: tuple[int, int, int, int]) -> bool:
+    for r, c in _perimeter_cells(rect):
+        if int(grid[r, c]) == 0:
+            return False
+    return True
+
+
+def _coords_lie_on_perimeter(coords: np.ndarray, rect: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = rect
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        on_h = rr in (r0, r1) and c0 <= cc <= c1
+        on_v = cc in (c0, c1) and r0 <= rr <= r1
+        if not (on_h or on_v):
+            return False
+    return True
+
+
+def _perimeter_cells(rect: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _rect_height(rect: tuple[int, int, int, int]) -> int:
+    return int(rect[2] - rect[0] + 1)
+
+
+def _rect_width(rect: tuple[int, int, int, int]) -> int:
+    return int(rect[3] - rect[1] + 1)

