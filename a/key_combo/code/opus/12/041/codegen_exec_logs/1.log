+def _sample_instance(rng: random.Random) -> tuple[np.ndarray, dict[int, tuple[int, int, int, int]]] | None:
+    has_third_nested = rng.random() < 0.58
+    min_size = 19 if has_third_nested else 17
+    h = rng.randint(min_size, 21)
