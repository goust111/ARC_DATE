+        c0 = oc0
+        if mc0 - 2 < oc0 + 2 or mr1 + 2 > or1 - 2 or or1 + 2 > h - 1:
+            return None
+        c1 = rng.randint(oc0 + 2, mc0 - 2)
+        r0 = rng.randint(mr1 + 2, or1 - 2)
