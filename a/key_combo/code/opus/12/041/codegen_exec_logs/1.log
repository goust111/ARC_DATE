+            r1 = rng.randint(or0 + 2, mr0 - 2)
+        else:
+            if mc1 + 2 > oc1 - 2 or mr1 + 2 > or1 - 2 or or1 + 2 > h - 1:
+                return None
+            c0 = rng.randint(mc1 + 2, oc1 - 2)
