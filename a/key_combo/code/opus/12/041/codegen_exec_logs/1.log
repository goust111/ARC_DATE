+        if mr1 + 2 > or1 - 2 or oc0 - 2 < 0 or mc0 - 2 < oc0 + 2:
+            return None
+        r0 = rng.randint(mr1 + 2, or1 - 2)
+        c0 = rng.randint(0, oc0 - 2)
+        c1 = rng.randint(oc0 + 2, mc0 - 2)
+    elif variant == "bottom_right":
+        r1 = or1
+        if mr1 + 2 > or1 - 2 or mc1 + 2 > oc1 - 2 or oc1 + 2 > w - 1:
