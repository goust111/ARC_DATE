+        c0 = oc0
+        if mc0 - 2 < oc0 + 2 or or0 - 2 < 0 or mr0 - 2 < or0 + 2:
+            return None
+        c1 = rng.randint(oc0 + 2, mc0 - 2)
+        r0 = rng.randint(0, or0 - 2)
+        r1 = rng.randint(or0 + 2, mr0 - 2)
