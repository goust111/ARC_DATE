+        if _bbox_gap(bbox, other_bbox) < MIN_BBOX_GAP:
+            return False
+    return True
+
+
+def _place_marker(
+    placed: list[dict[str, int | str]],
+    shape: tuple[int, int],
+    r: int,
+    c: int,
+    direction: str,
+    color: int,
+) -> bool:
+    if not _can_place(placed, shape, r, c, direction):
+        return False
+    dr, dc = DIRS[direction]
+    placed.append(
+        {
+            "row": r,
+            "col": c,
+            "color": color,
+            "grey_row": r + dr,
+            "grey_col": c + dc,
+            "direction": direction,
+        }
+    )
+    return True
+
+
+def _try_random_marker(
