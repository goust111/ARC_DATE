+
+BACKGROUND = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4)
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
