+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_FROM_DELTA = {delta: name for name, delta in DIRS.items()}
+PERPENDICULAR = {
+    "up": (0, 1),
+    "down": (0, 1),
+    "left": (1, 0),
+    "right": (1, 0),
+}
+
+GRID_SIDE_MIN = 16
+GRID_SIDE_MAX = 24
+GEN_RETRIES = 500
+MIN_BBOX_GAP = 5
+MIN_RAY_SPACE = 3
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _ray_space(shape: tuple[int, int], r: int, c: int, direction: str) -> int:
+    h, w = shape
+    if direction == "up":
+        return r
+    if direction == "down":
+        return h - 1 - r
