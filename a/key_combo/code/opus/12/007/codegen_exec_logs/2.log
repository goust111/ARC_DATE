+def _direction_bbox(r: int, c: int, direction: str) -> tuple[int, int, int, int]:
+    dr, dc = DIRS[direction]
+    rr, cc = r + dr, c + dc
+    return min(r, rr), min(c, cc), max(r, rr), max(c, cc)
