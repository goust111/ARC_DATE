+            sig = (kind, value)
+            cells = cell_cache[sig]
+            new_cross_cells: list[tuple[int, int]] = []
+            crosses_prev = idx == 0
+            valid = True
+            extra_crosses = 0
+            for prev_idx, prev_sig in enumerate(chosen):
+                inter = cell_cache[prev_sig] & cells
+                if not inter:
