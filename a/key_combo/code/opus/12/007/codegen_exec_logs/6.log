+    else:
+        c0_lo, c0_hi = margin, w - margin - 1
+
+    assert r0_lo <= r0_hi and c0_lo <= c0_hi
+    sr = random.randint(r0_lo, r0_hi)
+    sc = random.randint(c0_lo, c0_hi)
+    yr = sr + dr * distance
+    yc = sc + dc * distance
+    return (sr, sc), (yr, yc)
+
+
+def _expected_from_meta(meta: dict) -> np.ndarray:
+    grid = np.array(meta["input"], copy=True)
+    sr, sc = meta["start"]
