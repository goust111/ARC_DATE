+def _single_coord(grid: np.ndarray, color: int) -> tuple[int, int]:
+    coords = np.argwhere(grid == int(color))
+    assert coords.shape == (1, 2), f"expected exactly one marker of color {color}"
+    return int(coords[0, 0]), int(coords[0, 1])
