HORIZONTAL_DIRECTION, VERTICAL_DIRECTION = 0, 1
STEP_CHOICES = (-1, 1)

def _rand_grid_size():
    """Return height and width with the original square-grid bias."""
    if np.random.random() < SQUARE_GRID_PROB:
