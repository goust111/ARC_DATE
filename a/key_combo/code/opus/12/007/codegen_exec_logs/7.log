+def _occupied_layers(crop: np.ndarray, line_rows: list[int], line_cols: list[int]) -> tuple[list[int], list[int]]:
+    depth = _depth_grid(crop.shape)
+    mask = _line_mask(crop.shape, line_rows, line_cols)
