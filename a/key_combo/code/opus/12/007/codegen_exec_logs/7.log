+def _depth_grid(shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    return np.minimum(
+        np.minimum(rows, h - 1 - rows),
+        np.minimum(cols, w - 1 - cols),
+    )
