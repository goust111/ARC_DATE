+def _line_mask(shape: tuple[int, int], line_rows: list[int], line_cols: list[int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[np.asarray(line_rows, dtype=int), :] = True
+    mask[:, np.asarray(line_cols, dtype=int)] = True
