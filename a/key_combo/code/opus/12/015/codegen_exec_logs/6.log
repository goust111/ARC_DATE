+        for (top_r, top_c), (ar, ac) in zip(target_tops, anchor_locs)
+    ]
+
+
+def _markers_are_isolated(markers: list[tuple[int, int]]) -> bool:
+    for i, (r1, c1) in enumerate(markers):
+        for r2, c2 in markers[i + 1 :]:
+            if abs(r1 - r2) + abs(c1 - c2) <= 1:
