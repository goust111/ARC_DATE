+    out[fr0, fc0 : fc1 + 1] = FRAME
+    out[fr1, fc0 : fc1 + 1] = FRAME
+    out[fr0 : fr1 + 1, fc0] = FRAME
+    out[fr0 : fr1 + 1, fc1] = FRAME
+    return out
+
