+    canvas[2 : 2 + mask.shape[0], 2 : 2 + mask.shape[1]] = mask
+
+    for _ in range(random.randint(0, 3)):
+        coords = np.argwhere(canvas)
+        bbox = _bbox_from_coords(coords)
+        candidates = set()
+        for r, c in coords:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in _neighbors4(rr, cc):
