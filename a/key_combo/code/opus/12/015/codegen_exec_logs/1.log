+import numpy as np
+
+
+BG = 0
+ANCHOR = 8
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+DIR_BY_HOLES = {
+    1: (-1, 0),  # up
+    2: (0, 1),   # right
+    3: (1, 0),   # down
+    4: (0, -1),  # left
