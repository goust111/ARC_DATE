+    for cell in [(1, 1), (1, 3), (3, 1), (3, 3)]:
+        mask[cell] = False
+    return mask
+
+
+def _make_object_mask(holes: int) -> np.ndarray:
+    mask = _base_mask(holes)
+    canvas = np.zeros((mask.shape[0] + 4, mask.shape[1] + 4), dtype=bool)
+    canvas[2 : 2 + mask.shape[0], 2 : 2 + mask.shape[1]] = mask
