+
+
+def _is_adjacent_to_mask(coords: np.ndarray, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and occupied[nr, nc]:
+                return True
+    return False
+
+
+def _shift_coords(coords: np.ndarray, dr: int, dc: int) -> np.ndarray:
+    shifted = coords.copy()
+    shifted[:, 0] += int(dr)
+    shifted[:, 1] += int(dc)
+    return shifted
+
+
+def _can_place(coords: np.ndarray, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        if occupied[rr, cc]:
+            return False
