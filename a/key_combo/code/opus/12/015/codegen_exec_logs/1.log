+            return False
+        if holes == 3 and not (bbox[2] < anchor_bbox[0] and col_overlap):
+            return False
+        if holes == 4 and not (bbox[1] > anchor_bbox[3] and row_overlap):
+            return False
+        center2 = _center2(bbox)
+        dist2 = abs(center2[0] - anchor_center2[0]) + abs(center2[1] - anchor_center2[1])
