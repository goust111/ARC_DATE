+        mask = np.ones((3, 3), dtype=bool)
+        mask[1, 1] = False
+        return mask
+    if holes == 2:
+        mask = np.ones((3, 5), dtype=bool)
+        mask[1, 1] = False
+        mask[1, 3] = False
