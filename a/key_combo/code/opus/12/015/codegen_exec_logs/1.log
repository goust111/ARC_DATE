+        if row0 is None:
+            return None
+        widths = [mask.shape[1] for mask in ordered_masks]
+        placed = []
+        if direction == 2:
+            final_lefts = []
+            cursor = ac0
+            for ww in widths:
+                left = cursor - ww
+                if left < 0:
+                    return None
+                final_lefts.append(left)
+                cursor = left
+            steps = _choose_increasing_steps(final_lefts)
