+            bbox = _bbox_from_coords(arr)
+            local = np.zeros((bbox[2] - bbox[0] + 1, bbox[3] - bbox[1] + 1), dtype=bool)
+            local[arr[:, 0] - bbox[0], arr[:, 1] - bbox[1]] = True
+            holes = _count_holes(local)
