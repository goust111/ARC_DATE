+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+ANCHOR = 8
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+DIR_BY_HOLES = {
+    1: (-1, 0),  # up
+    2: (0, 1),   # right
+    3: (1, 0),   # down
+    4: (0, -1),  # left
+}
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+    return count
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    bg = np.pad(~mask, 1, constant_values=True)
+    h, w = bg.shape
+    seen = np.zeros_like(bg, dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_border = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _find_anchor_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(grid == ANCHOR)
+    assert coords.shape[0] == 4
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2)
+    assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == ANCHOR)
+    return r0, c0, r1, c1
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (BG, ANCHOR) or seen[r, c]:
+                continue
