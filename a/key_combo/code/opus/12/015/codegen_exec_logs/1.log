+                    collision_blocked += 1
+                    break
+
+    if any(count == 2 for count in counts_by_direction.values()) and collision_blocked == 0:
+        return False
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    h = random.randint(18, 20)
