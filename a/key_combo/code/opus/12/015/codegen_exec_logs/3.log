+            assert secondary_count in SECONDARY_COUNTS
+            assert int(np.sum(tile == main_color)) > secondary_count
+
+            hole = (hole_r, hole_c)
+            seen_holes.add(hole)
+            infos.append(((r0, r1), (c0, c1), hole, tile.copy()))
