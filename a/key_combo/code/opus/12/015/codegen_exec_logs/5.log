+def _collect_orbits(mask: np.ndarray) -> list[dict[str, object]]:
+    height, width = mask.shape
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    orbits: list[dict[str, object]] = []
+    for row in range(height):
