+            if mode == "rect":
+                rh = int(rng.integers(1, qh + 1))
+                rw = int(rng.integers(1, qw + 1))
+                r0 = int(rng.integers(0, qh - rh + 1))
+                c0 = int(rng.integers(0, qw - rw + 1))
+                _paint_rect(quarter, r0, c0, r0 + rh - 1, c0 + rw - 1, False)
+            else:
