+def _reflection_orbit(row: int, col: int, height: int, width: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        sorted(
+            {
+                (row, col),
+                (row, width - 1 - col),
+                (height - 1 - row, col),
+                (height - 1 - row, width - 1 - col),
+            }
+        )
