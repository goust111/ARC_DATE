+                r1 = qh - 1 if rng.random() < 0.65 else int(rng.integers(r0, qh))
+                _paint_rect(quarter, r0, c0, r1 - 1 if r1 > r0 else r0, c1 - 1 if c1 > c0 else c0, True)
