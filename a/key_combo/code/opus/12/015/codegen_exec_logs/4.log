        t=random.randint(max(0,ar-h+1), min(ar-1, H-h))
        r=l+w-1; bm=t+h-1
        if ac in (l,r) or ar in (t,bm):
          continue
        rects.append((t,l,bm,r)); ok=True; break
      if not ok:
        okset=False; break
    if not okset:
      continue
    bs=[border_set(b) for b in rects]
    if any(not (bs[i]&bs[j]) for i,j in itertools.combinations(range(n),2)):
      continue
    order=list(range(n)); random.shuffle(order)
    ok,res=valid(rects,order,H,W)
    if ok:
      success+=1
