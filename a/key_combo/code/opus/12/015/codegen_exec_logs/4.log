+        r0, c0, r1, c1 = bbox
+        if not np.all(
+            (coords[:, 0] == r0)
+            | (coords[:, 0] == r1)
+            | (coords[:, 1] == c0)
+            | (coords[:, 1] == c1)
+        ):
+            continue
+
+        if not (
+            np.any(coords[:, 0] == r0)
+            and np.any(coords[:, 0] == r1)
+            and np.any(coords[:, 1] == c0)
+            and np.any(coords[:, 1] == c1)
