+    for rect_a, rect_b in itertools.combinations(rectangles, 2):
+        top = _pair_top_color(grid, rect_a, rect_b)
+        bottom = rect_b["color"] if top == rect_a["color"] else rect_a["color"]
+        if top not in edges[bottom]:
+            edges[bottom].add(top)
+            indegree[top] += 1
