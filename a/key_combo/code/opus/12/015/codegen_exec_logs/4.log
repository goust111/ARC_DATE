def border_points(b):
    t,l,bm,r=b
    pts=[]
    for c in range(l,r+1):
        pts.append((t,c)); pts.append((bm,c))
    for rr in range(t+1,bm):
        pts.append((rr,l)); pts.append((rr,r))
    return pts

def border_set(b):
    return set(border_points(b))

def draw(rects, colors, order, H, W):
    g=np.zeros((H,W),dtype=int)
    for idx in order:
        for p in border_points(rects[idx]):
            g[p]=colors[idx]
    return g

def extract(g):
    out=[]
    for color in sorted(set(map(int,g.flat))-{0}):
        coords=np.argwhere(g==color)
        if len(coords)<8: continue
        r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
        h,w=r1-r0+1,c1-c0+1
        short,long=sorted((h,w))
        if not (4<=short<=7 and 5<=long<=9): continue
        if not np.all((coords[:,0]==r0)|(coords[:,0]==r1)|(coords[:,1]==c0)|(coords[:,1]==c1)):
