+    order: list[int] = []
+    while indegree:
+        candidates = sorted(color for color, deg in indegree.items() if deg == 0)
+        assert len(candidates) == 1, "occlusion comparisons must imply a unique total order"
+        color = candidates[0]
+        order.append(color)
+        del indegree[color]
+        for above in edges[color]:
