+    return visible.pop()
+
+
+def _bottom_to_top_order(rectangles: list[dict], grid: np.ndarray) -> list[int]:
+    edges = {rect["color"]: set() for rect in rectangles}
+    indegree = {rect["color"]: 0 for rect in rectangles}
