    union_r0=min(b[0] for b in rects); union_c0=min(b[1] for b in rects); union_r1=max(b[2] for b in rects); union_c1=max(b[3] for b in rects)
    if (union_r1-union_r0+1)<8 or (union_c1-union_c0+1)<8:
        return False,'small union'
    return True,g

for n in [3,4,5]:
  ok_count=0
