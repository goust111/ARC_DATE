+def _gen_attempt() -> np.ndarray | None:
+    count = random.choices([3, 4, 5], weights=[4, 4, 2], k=1)[0]
+    height, width = _dimensions_for_count(count)
+    bboxes = _sample_rectangles(count, height, width)
