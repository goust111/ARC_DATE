+            (r, c)
+            for r in range(out.shape[0])
+            for c in range(out.shape[1])
+            if isolated_zero(r, c)
+        ]
+        if not candidates:
+            break
+        r, c = random.choice(candidates)
+        out[r, c] = int(color)
+        placed += 1
+
