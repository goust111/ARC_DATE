    if len(rects)"'!=n: continue
    colors=random.sample([1,2,3,4,5],n)
    order=list(range(n)); random.shuffle(order)
    ok,res=nice(rects,colors,order,H,W)
    if ok:
      print('"'n',n,'attempt',attempt,'shape',res.shape,'rects',rects,'order',order)
      ok_count+=1
      break
  print('done',n,ok_count)
