    bs=[border_set(b) for _c,b in rects]
    for i,j in itertools.combinations(range(n),2):
        inter=bs[i]&bs[j]
        vis={int(g[p]) for p in inter if int(g[p]) in (rects[i][0],rects[j][0])}
