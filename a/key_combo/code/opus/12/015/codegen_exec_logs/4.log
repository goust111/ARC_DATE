  markers:
    count_per_block: exactly N-1 (one per other block color), each a single pixel
    row_rule: within a block, each marker is on a distinct row
    col_position: each marker occupies a single interior column of its block [observed]
  marker_alignment:
    aligned_case: all markers of the same foreign color share the same row across all blocks (4/6 examples)
    unaligned_case: markers of a given foreign color may be on different rows in different blocks (2/6 examples)
  permutation_rule:
    reverse: if aligned AND N marker-rows are consecutive AND marker colors top-to-bottom equal block colors right-to-left -> reverse block order
    left_shift: otherwise -> move leftmost block to far right, shift rest left
  output: same grid dimensions; blocks reordered per permutation rule, each block's internal pixels preserved exactly

generation_strategy:
