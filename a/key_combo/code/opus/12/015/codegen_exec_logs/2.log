+def _transform_cells(cells: set[Coord], shape: tuple[int, int], open_dir: str) -> tuple[set[Coord], tuple[int, int]]:
+    h, w = shape
+    if open_dir == "U":
+        return set(cells), (h, w)
+    if open_dir == "D":
+        return {(h - 1 - r, c) for r, c in cells}, (h, w)
+    if open_dir == "L":
+        return {(w - 1 - c, r) for r, c in cells}, (w, h)
+    if open_dir == "R":
