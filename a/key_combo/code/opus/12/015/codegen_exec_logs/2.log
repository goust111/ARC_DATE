+    if (r + 1, c) in border_set:
+        sides.add("U")
+    if (r - 1, c) in border_set:
+        sides.add("D")
+    if (r, c + 1) in border_set:
+        sides.add("L")
+    if (r, c - 1) in border_set:
+        sides.add("R")
+    if len(sides) != 1:
+        return None
+    return next(iter(sides))
