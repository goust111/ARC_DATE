+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+FRAME_COLORS = (1, 3, 5, 6, 7, 8, 9)
+OPEN_DIRS = ("U", "D", "L", "R")
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+GEN_RETRIES = 500
