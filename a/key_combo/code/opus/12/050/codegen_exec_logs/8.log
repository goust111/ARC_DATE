+import numpy as np
+
+
+BBox = tuple[int, int, int, int]
+
+_BG = 0
+_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+_RECT_COUNT_CHOICES = [3, 4, 5]
+_GRID_SIDE_RANGE = (13, 18)
+_SHORT_SIDE_RANGE = (3, 5)
+_LONG_SIDE_RANGE = (4, 7)
+_MARGIN = 1
+_GEN_ATTEMPTS = 600
