+
+def _bbox_center(box: BBox) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _bbox_area(box: BBox) -> int:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
