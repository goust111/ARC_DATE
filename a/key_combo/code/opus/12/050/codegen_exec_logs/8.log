+    centers = [tuple(map(int, rect["center"])) for rect in rects]
+    if len(set(centers)) != len(centers):
+        return False
+    rows = [cr for cr, _ in centers]
+    cols = [cc for _, cc in centers]
+    return len(set(rows)) == len(rows) and len(set(cols)) == len(cols)
