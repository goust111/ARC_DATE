        mask[r, c] = True

    while _gen_component_count(mask) > _GEN_MAX_COMPONENTS:
        if int(mask.sum()) >= _GEN_MAX_PIXELS:
            return None
        current = _gen_component_count(mask)
        choices = []
        best_count = current
        for r, c in _GEN_CELLS:
