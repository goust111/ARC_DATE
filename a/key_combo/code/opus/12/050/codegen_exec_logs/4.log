+    col_bands = _bands(col_seps, g.shape[1])
+    assert all(hi - lo == TILE_SIZE for lo, hi in row_bands + col_bands)
+
+    non_separator = np.ones_like(g, dtype=bool)
+    non_separator[row_seps, :] = False
+    non_separator[:, col_seps] = False
