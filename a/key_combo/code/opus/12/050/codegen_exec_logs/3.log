import random
from collections import deque

RAY_DIRS=[(-1,-1),(-1,1),(1,-1),(1,1)]

def draw(shape,sources):
    h,w=shape
    g=[[0]*w for _ in range(h)]
    counts=[[0]*w for _ in range(h)]
    for r,c in sources:
        for dr,dc in RAY_DIRS:
            rr,cc=r,c
            while 0<=rr<h and 0<=cc<w:
                g[rr][cc]=5
                counts[rr][cc]+=1
                rr+=dr; cc+=dc
    return g,counts

def comps(g):
    h,w=len(g),len(g[0])
    seen=[[False]*w for _ in range(h)]
    out=[]
    for r in range(h):
        for c in range(w):
            if g[r][c]"'!=0 or seen[r][c]:
                continue
            q=deque([(r,c)])
            seen[r][c]=True
            cells=[]
            while q:
                rr,cc=q.popleft(); cells.append((rr,cc))
                for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and g[nr][nc]==0 and not seen[nr][nc]:
                        seen[nr][nc]=True; q.append((nr,nc))
            out.append(cells)
    return out

def valid(shape,sources):
    h,w=shape
    # pairwise constraints
    for i,(r1,c1) in enumerate(sources):
        for r2,c2 in sources[i+1:]:
            if r1==r2 or c1==c2 or r1-c1==r2-c2 or r1+c1==r2+c2:
                return False
            if max(abs(r1-r2),abs(c1-c2))<=1:
                return False
    g,counts=draw(shape,sources)
    inter=0
    src=set(sources)
    for r in range(1,h-1):
        for c in range(1,w-1):
            if (r,c) in src:
                continue
            if counts[r][c]>=2:
                inter+=1
    if inter==0:
        return False
    cs=comps(g)
    if len(cs)<4:
        return False
    areas=sorted(len(x) for x in cs)
    if len(set(areas))!=len(areas):
        return False
    return len(cs),areas,inter

