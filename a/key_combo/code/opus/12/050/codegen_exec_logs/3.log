+def _count_internal_crossings(
+    hit_counts: np.ndarray, sources: list[tuple[int, int]]
+) -> int:
+    source_set = set(sources)
+    h, w = hit_counts.shape
+    crossings = 0
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if (r, c) in source_set:
+                continue
+            if hit_counts[r, c] >= 2:
+                crossings += 1
+    return crossings
+
+
