+
+def _pick_distinct(values: list[int], count: int, min_gap: int) -> list[int] | None:
+    candidates = []
+    for combo in __import__("itertools").combinations(values, count):
+        if all(b - a >= min_gap for a, b in zip(combo, combo[1:])):
