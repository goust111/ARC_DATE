    return n_blue == 1


def _gen_rim_patch_ok(patch):
    blue = patch == Color.BLUE
    if not blue.any():
        return False
    if not (blue[0, :].any() and blue[-1, :].any() and blue[:, 0].any() and blue[:, -1].any()):
