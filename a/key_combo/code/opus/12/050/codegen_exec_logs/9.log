+def _render_rays_only(shape: tuple[int, int], objects: list[dict[str, object]]) -> np.ndarray:
+    rays = np.full(shape, BG, dtype=int)
+    for obj in objects:
+        color = int(obj["color"])
+        for r, c in obj["path"]:
+            rays[r, c] = color
+    return rays
