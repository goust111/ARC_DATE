+            rays[r, c] = color
+        end_r, end_c = path[-1]
+        endpoints.append((end_r, end_c, color))
+
+    rays[rays == MARKER] = BG
+    out = rays.copy()
+    for axis, fixed, start, stop in _segments_from_endpoints(endpoints):
+        if axis == "row":
+            for c in range(start + 1, stop):
+                if rays[fixed, c] == BG:
+                    out[fixed, c] = FILL
