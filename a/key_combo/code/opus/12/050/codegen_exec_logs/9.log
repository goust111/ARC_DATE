+            for c in range(start + 1, stop):
+                if rays[fixed, c] == BG:
+                    out[fixed, c] = FILL
+        else:
+            for r in range(start + 1, stop):
+                if rays[r, fixed] == BG:
+                    out[r, fixed] = FILL
