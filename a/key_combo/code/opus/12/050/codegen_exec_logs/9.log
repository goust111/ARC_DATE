+    endpoints: list[tuple[int, int, int]] = []
+    for obj in objects:
+        color = int(obj["color"])
+        path = obj["path"]
+        for r, c in path:
+            rays[r, c] = color
+        end_r, end_c = path[-1]
+        endpoints.append((end_r, end_c, color))
+
+    rays[rays == MARKER] = BG
+    out = rays.copy()
