+    lane_positions: list[tuple[dict, int, int]] = []
+    for lane in ("A", "B"):
+        outer = next(obj for obj in by_lane[lane] if obj["role"] == "outer")
+        inner_objs = sorted(
+            [obj for obj in by_lane[lane] if obj["role"] != "outer"],
