                        continue
                    rr, cc = int(r + dr), int(c + dc)
                    if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc]:
                        frontier.append((rr, cc))
        if not frontier:
            return False
        mask[random.choice(frontier)] = True
    return True


