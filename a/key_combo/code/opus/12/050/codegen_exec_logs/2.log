+
+def _extract_components(grid: np.ndarray) -> list[dict]:
+    comps = find_components(
+        np.asarray(grid, dtype=int),
+        bg=BG,
+        connectivity=8,
+        monochromatic=True,
+        return_format="dict",
+    )
+    for comp in comps:
+        comp["color"] = int(comp["color"])
+        comp["area"] = int(comp["area"])
+        comp["bbox"] = tuple(map(int, comp["bbox"]))
+    return comps
