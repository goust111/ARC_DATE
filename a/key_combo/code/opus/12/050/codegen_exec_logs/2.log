+    comps.sort(key=lambda comp: (comp["bbox"][2], comp["bbox"][0], comp["bbox"][1]), reverse=True)
+
+    settled = np.zeros_like(g)
+    for comp in comps:
+        coords = comp["coords"].copy()
+        color = int(comp["color"])
+        shift = 0
+        while True:
+            moved = coords.copy()
+            moved[:, 0] += shift + 1
+            if int(moved[:, 0].max()) >= h:
+                break
+            if np.any(settled[moved[:, 0], moved[:, 1]] != BG):
+                break
+            shift += 1
