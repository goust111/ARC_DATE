+
+
+def _mask(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _unique_transforms(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for base in (mask, np.fliplr(mask)):
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = cur.tobytes()
+            if key not in seen:
+                seen.add(key)
+                out.append(cur.copy())
+    return out
+
+
+LARGE_SHAPES = [
+    _mask(
+        [
+            "1001",
+            "1001",
+            "1001",
+            "0110",
+        ]
+    ),
+    np.fliplr(
+        _mask(
+            [
+                "1001",
+                "1000",
+                "1001",
+                "0111",
+            ]
+        )
+    ),
+    _mask(
+        [
+            "1001",
+            "1000",
+            "1001",
+            "0111",
+        ]
+    ),
+]
+
+MEDIUM_SHAPES = [
+    _mask(
+        [
+            "101",
+            "100",
+            "011",
+        ]
+    ),
+    np.fliplr(
+        _mask(
+            [
+                "101",
+                "100",
+                "011",
+            ]
+        )
+    ),
+]
+
+SMALL_SHAPES = []
+for base in (
+    _mask(["11", "10"]),
+    _mask(["11", "01"]),
+    _mask(["10", "11", "01"]),
+    _mask(["11", "10", "11"]),
+    _mask(["111", "010"]),
+):
+    SMALL_SHAPES.extend(_unique_transforms(base))
+
+INNER_SMALL_SHAPES = [
+    shape.copy()
+    for shape in SMALL_SHAPES
+    if shape.shape[1] <= 2
+]
+
+
+def _colorize(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = int(color)
+    return patch
+
+
+def _bbox_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    return (
+        outer[0] <= inner[0]
+        and outer[1] <= inner[1]
+        and inner[2] <= outer[2]
+        and inner[3] <= outer[3]
