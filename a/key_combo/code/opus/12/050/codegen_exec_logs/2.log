+        t_top, t_left = random.choice(tiny_places)
+        _paste(grid, tiny, t_top, t_left)
+        tiny_color = int(np.max(tiny))
+        objects.append(
+            {
+                "patch": tiny,
+                "settled_top": int(t_top),
+                "settled_left": int(t_left),
+                "role": "tiny",
+                "color": tiny_color,
+                "lane": "A",
