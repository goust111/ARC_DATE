+GRID_W_RANGE = (15, 18)
+
+
+def _mask(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _unique_transforms(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for base in (mask, np.fliplr(mask)):
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = cur.tobytes()
+            if key not in seen:
+                seen.add(key)
+                out.append(cur.copy())
+    return out
+
+
+LARGE_SHAPES = _unique_transforms(
+    _mask(
+        [
+            "1110",
+            "1000",
+            "1000",
+            "1110",
+        ]
+    )
+) + _unique_transforms(
+    _mask(
+        [
+            "1001",
+            "1000",
+            "1001",
+            "0111",
+        ]
+    )
+)
+
+MEDIUM_SHAPES = _unique_transforms(
+    _mask(
+        [
+            "110",
+            "100",
+            "110",
+        ]
+    )
+) + _unique_transforms(
+    _mask(
+        [
+            "011",
+            "001",
+            "011",
+        ]
+    )
+)
+
+SMALL_SHAPES = []
+for base in (
+    _mask(["11", "10"]),
+    _mask(["11", "01"]),
+    _mask(["10", "11", "01"]),
+    _mask(["11", "10", "11"]),
+    _mask(["111", "010"]),
