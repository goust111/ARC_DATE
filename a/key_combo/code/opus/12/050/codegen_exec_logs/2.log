+
+
+def _validate_candidate(inp: np.ndarray, meta: dict) -> bool:
+    comps = _extract_components(inp)
+    if not (4 <= len(comps) <= 6):
+        return False
+    if any(not (3 <= int(comp["area"]) <= 8) for comp in comps):
