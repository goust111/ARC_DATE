+    for comp in comps:
+        comp["color"] = int(comp["color"])
+        comp["area"] = int(comp["area"])
+        comp["bbox"] = tuple(map(int, comp["bbox"]))
+    return comps
+
+
+def _drop_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, _w = g.shape
