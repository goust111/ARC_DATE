+    erased_colors: list[int] = []
+
+    if nested:
+        medium = _colorize(_sample_medium_shape(), next(color_iter))
+        a_box = _patch_bbox(a_top, a_left, outer_a)
+        medium_places = _placements_within_bbox(grid, medium, a_box)
