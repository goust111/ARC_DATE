+        medium_color = int(np.max(medium))
+        objects.append(
+            {
+                "patch": medium,
+                "settled_top": int(m_top),
+                "settled_left": int(m_left),
+                "role": "medium",
+                "color": medium_color,
+                "lane": "A",
