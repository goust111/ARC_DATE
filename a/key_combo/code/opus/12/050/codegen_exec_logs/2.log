+
+def _find_outside_bottom_position(
+    grid: np.ndarray,
+    patch: np.ndarray,
+    forbidden_boxes: list[tuple[int, int, int, int]],
+) -> tuple[int, int] | None:
+    top = int(grid.shape[0] - patch.shape[0])
+    candidates = []
