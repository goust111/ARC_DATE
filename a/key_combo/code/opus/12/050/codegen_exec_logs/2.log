+def _erase_layers(grid: np.ndarray) -> tuple[np.ndarray, list[set[int]]]:
+    out = np.asarray(grid, dtype=int).copy()
+    layers: list[set[int]] = []
+    while True:
+        nxt, erased = _erase_one_layer(out)
