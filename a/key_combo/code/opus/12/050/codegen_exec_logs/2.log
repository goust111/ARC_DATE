+    erased_colors: set[int] = set()
+    for idx in erasable:
+        comp = comps[idx]
+        coords = comp["coords"]
+        out[coords[:, 0], coords[:, 1]] = BG
+        erased_colors.add(int(comp["color"]))
+    return out, erased_colors
