+
+def _placements_within_bbox(
+    grid: np.ndarray,
+    patch: np.ndarray,
+    box: tuple[int, int, int, int],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, box)
+    ph, pw = patch.shape
+    places = []
+    for top in range(r0, r1 - ph + 2):
+        for left in range(c0, c1 - pw + 2):
+            if _can_place(grid, patch, top, left):
+                places.append((int(top), int(left)))
