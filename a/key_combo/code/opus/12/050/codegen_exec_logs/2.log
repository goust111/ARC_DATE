+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_ARC_UTILS_DIR))
+
+from arc_utils import find_components
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MAX_ATTEMPTS = 500
+GRID_H_RANGE = (14, 18)
+GRID_W_RANGE = (15, 18)
+
+
+def _mask(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _unique_transforms(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for base in (mask, np.fliplr(mask)):
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = cur.tobytes()
+            if key not in seen:
+                seen.add(key)
+                out.append(cur.copy())
+    return out
+
+
+LARGE_SHAPES = _unique_transforms(
+    _mask(
+        [
+            "1110",
+            "1000",
+            "1000",
+            "1110",
+        ]
+    )
+) + _unique_transforms(
+    _mask(
+        [
+            "1001",
+            "1000",
+            "1001",
+            "0111",
+        ]
+    )
+)
+
+MEDIUM_SHAPES = _unique_transforms(
+    _mask(
+        [
+            "110",
+            "100",
+            "110",
+        ]
+    )
+) + _unique_transforms(
+    _mask(
+        [
+            "011",
+            "001",
+            "011",
+        ]
+    )
+)
+
+SMALL_SHAPES = []
+for base in (
+    _mask(["11", "10"]),
+    _mask(["11", "01"]),
+    _mask(["10", "11", "01"]),
+    _mask(["11", "10", "11"]),
+    _mask(["111", "010"]),
+):
