+        )
+        erased_colors.append(medium_color)
+
+        tiny = _colorize(_sample_inner_small_shape(max_area=4), next(color_iter))
+        medium_box = _patch_bbox(m_top, m_left, medium)
+        tiny_places = _placements_within_bbox(grid, tiny, medium_box)
+        if not tiny_places:
