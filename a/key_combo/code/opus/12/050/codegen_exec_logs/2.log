+    secondary = _colorize(_sample_inner_small_shape(max_area=5), next(color_iter))
+    b_box = _patch_bbox(b_top, b_left, outer_b)
+    secondary_places = _placements_within_bbox(grid, secondary, b_box)
+    if not secondary_places:
