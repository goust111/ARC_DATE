    """Set out[r,c]=color for each coord (in-bounds only)."""
    H, W = out.shape
    v = int(color)
    for r, c in coords:
        rr = int(r)
        cc = int(c)
        if 0 <= rr < H and 0 <= cc < W:
            out[rr, cc] = v


