+    _paste(grid, outer_b, b_top, b_left)
+
+    objects = [
+        {
+            "patch": outer_a,
+            "settled_top": int(a_top),
+            "settled_left": int(a_left),
+            "role": "outer",
+            "color": int(np.max(outer_a)),
