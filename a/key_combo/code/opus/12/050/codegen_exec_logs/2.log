+
+
+def _unique_transforms(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for base in (mask, np.fliplr(mask)):
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = cur.tobytes()
+            if key not in seen:
+                seen.add(key)
+                out.append(cur.copy())
+    return out
