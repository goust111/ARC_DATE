+        d_top, d_left = random.choice(direct_places)
+        _paste(grid, direct, d_top, d_left)
+        direct_color = int(np.max(direct))
+        objects.append(
+            {
+                "patch": direct,
+                "settled_top": int(d_top),
+                "settled_left": int(d_left),
+                "role": "target",
+                "color": direct_color,
+                "lane": "A",
