+def _step_between(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    dr = int(b[0] - a[0])
+    dc = int(b[1] - a[1])
+    if dr == 0:
+        sdr = 0
+    else:
+        sdr = dr // abs(dr)
+    if dc == 0:
+        sdc = 0
+    else:
+        sdc = dc // abs(dc)
+    if not (dr == 0 or dc == 0 or abs(dr) == abs(dc)):
+        raise ValueError(f"edge {a}->{b} is not H/V/45-degree aligned")
+    return sdr, sdc
