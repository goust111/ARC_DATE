spec:
  grid:
    width: 10 (fixed)
    input_height: 5-8
    output_height: 10 (fixed)
  colors:
    background: 0 (black)
    foreground: exactly 1 non-zero color
  pattern:
    description: |
      Rows form a translated periodic sequence: each row is obtained by
      horizontally shifting the row one period above by a fixed offset dc.
    period: 1-3
    horizontal_shift: 0 or positive (observed 0, 2); must be unique for the minimal period
    base_rows: the first `period` rows define the template; 1-5 fg pixels total across base rows [observed]
    clipping: when shift != 0, fg pixels that drift past column 9 are dropped
  input_output:
    input: top input_height rows of the 10x10 periodic pattern
    output: full 10x10 grid extending the pattern downward
    constraint: input must contain >= 2 full periods so period+shift are uniquely inferable

generation_strategy:
  approach: output-first
  steps:
    1. Pick fg color (non-zero), period P in [1,3], horizontal shift dc in {0,1,2}.
    2. Design P base rows (width 10) with 1-5 total fg pixels; if dc>0 place fg
       toward the left so the pattern survives several shifts before clipping.
    3. Build the full 10x10 output by repeating: row[r] = shift(row[r-P], dc),
       clipping any column outside [0,9].
    4. Verify the pattern has >= 2 full periods of non-trivially-shifted rows
       (i.e. not all rows become empty due to clipping).
    5. Choose input_height in [max(2*P+1, 5), 8] and take the top input_height
       rows as the input grid.
