+
+TEMPLATES = (
+    _template_rectangle,
+    _template_diamond,
+    _template_house,
+    _template_hexagon,
+    _template_cut_corner,
+)
+
+
+def _place_vertices(
+    local_vertices: list[tuple[int, int]],
+    rng: random.Random,
