+    if observed_edges < 2:
+        return None
+    if not any(0 < len(observed[idx]) < len(shadow_lists[idx]) for idx in range(len(edges)) if shadow_lists[idx]):
+        return None
+    if not any(len(observed[idx]) == 0 for idx in eligible):
+        return None
+    return observed
+
