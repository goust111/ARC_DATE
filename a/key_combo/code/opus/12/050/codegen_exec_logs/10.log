+def _line_points(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = _step_between(a, b)
+    length = max(abs(int(b[0] - a[0])), abs(int(b[1] - a[1])))
+    return [(int(a[0] + i * dr), int(a[1] + i * dc)) for i in range(length + 1)]
