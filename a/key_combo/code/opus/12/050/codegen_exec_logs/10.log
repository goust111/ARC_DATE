+    h = rng.randint(min_h, 22)
+    w = rng.randint(min_w, 22)
+
+    if touch_border:
+        sides = []
+        if h >= max_r + 1:
+            sides.extend(["top", "bottom"])
+        if w >= max_c + 1:
+            sides.extend(["left", "right"])
+        side = rng.choice(sides)
+        if side == "top":
+            r_shift = 0
+            c_shift = rng.randint(0, w - max_c - 1)
+        elif side == "bottom":
+            r_shift = h - max_r - 1
+            c_shift = rng.randint(0, w - max_c - 1)
+        elif side == "left":
