+def _normalize_vertices(vertices: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    min_r = min(r for r, _ in vertices)
+    min_c = min(c for _, c in vertices)
+    return [(int(r - min_r), int(c - min_c)) for r, c in vertices]
