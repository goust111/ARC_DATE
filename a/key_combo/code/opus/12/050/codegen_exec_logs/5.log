+        "raw_key": raw_key,
+        "clean_key": chosen["clean_key"],
+        "clean_coords": chosen["clean_coords"],
+        "axis_type": chosen["axis_type"],
+        "axis_k": chosen["k"],
+        "best_score": best_score,
+        "n_best": len(best),
