+@lru_cache(None)
+def _shape_catalog() -> tuple[tuple[np.ndarray, ...], tuple[np.ndarray, ...]]:
+    vertical: list[np.ndarray] = []
+    horizontal: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], tuple[tuple[int, int], ...]]] = set()
