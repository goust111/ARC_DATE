+                    "axis_type": "v",
+                    "k": k,
+                    "score": int(len(kept)),
+                    "clean_coords": kept,
+                    "clean_key": _shape_key(kept),
+                }
+            )
+    for k in range(0, 2 * (h - 1) + 1):
+        kept = _paired_subset(local, "h", k)
+        if len(kept) > 0:
+            candidates.append(
+                {
+                    "axis_type": "h",
+                    "k": k,
+                    "score": int(len(kept)),
+                    "clean_coords": kept,
+                    "clean_key": _shape_key(kept),
+                }
+            )
