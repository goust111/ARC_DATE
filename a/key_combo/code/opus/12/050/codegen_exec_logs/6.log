    if pair_count == 1:
        return [(p,) for p in pairs]

    choices: list[tuple[tuple[int, int], ...]] = []
    for combo in itertools.combinations(pairs, pair_count):
        used = [x for pair in combo for x in pair]
        if len(set(used)) == len(used):
            choices.append(combo)
