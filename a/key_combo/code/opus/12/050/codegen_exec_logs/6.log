    cd = random.choice([c for c in remaining if c != cs and c not in {c0, c1}])

    visible = {(0, c0), (0, c1), (3, c1), (2, cs)}
    hidden = {(3, c0), (1, cd)}
    obstacle = (1, c1)
    visible_pairs = {
