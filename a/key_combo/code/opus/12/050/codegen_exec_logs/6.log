+def _overlay_bands(bands: list[np.ndarray]) -> np.ndarray:
+    """Overlay same-size bands with fixed priority band0 > band1 > band2."""
+    out = np.zeros_like(bands[0])
+    for band in reversed(bands):
+        mask = band != BLACK
+        out[mask] = band[mask]
+    return out
