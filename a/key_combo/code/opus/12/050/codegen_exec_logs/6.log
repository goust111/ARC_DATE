spec:
  grid: 3-12 rows x 3-13 cols, output same size as input
  background: black (0), single marker color azure (8) [observed], green (3) absent from input
  markers:
    count: 1-7 isolated pixels of the marker color
    per_row: at most 2 markers; per_column: at most 2 markers
    no marker participates in both a row-pair and a column-pair [observed]
    gap between aligned pairs: 2-7 cells of pure background
  pairs: 0-3 total axis-aligned pairs (row-pairs 0-2, col-pairs 0-2); 0-2 unpaired markers
  transform: for each row/column with exactly 2 markers, fill background cells strictly between them with green (3); markers and all other cells unchanged

generation_strategy:
