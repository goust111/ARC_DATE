+from __future__ import annotations
+
+from collections import deque
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+CHANNEL = 5
+MOVER = 1
+TARGET = 2
+
+HRECT = (2, 3)
+VRECT = (3, 2)
+DIR_DELTA = {"R": (0, 1), "L": (0, -1), "D": (1, 0), "U": (-1, 0)}
+GEN_ATTEMPTS = 400
