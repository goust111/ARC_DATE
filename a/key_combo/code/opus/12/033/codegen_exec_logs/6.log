+def _exclusive_marker_candidates(grid: np.ndarray, bar: dict[str, int]) -> tuple[tuple[int, int], list[tuple[int, int]]]:
+    h = grid.shape[0]
+    c = bar["col"]
+    top = bar["top"]
+    top_marker = (top - 1, c)
+    assert top_marker[0] >= 0
