+    for r in range(top, h):
+        for nc in (c - 1, c + 1):
+            pos = (r, nc)
+            if not _in_bounds(grid.shape, pos[0], pos[1]) or int(grid[pos]) != BACKGROUND:
+                continue
+            blue_neighbors = [
+                (nr, nnc)
+                for nr, nnc in _neighbors4(pos[0], pos[1])
+                if _in_bounds(grid.shape, nr, nnc) and int(grid[nr, nnc]) == BAR_COLOR
