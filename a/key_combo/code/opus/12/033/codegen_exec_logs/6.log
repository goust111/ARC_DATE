+        for pos_index in range(start, len(positions)):
+            pos = positions[pos_index]
+            if not _can_place_marker(grid, pos, allow_blue_touch=True):
+                continue
+            grid[pos] = int(extra_colors[index])
+            if backtrack(index + 1, pos_index + 1):
