+            else:
+                r0 = int(_RNG.integers(low, high + 1))
+        c0 = col
+        r1 = r0 + frame_h - 1
+        c1 = c0 + frame_w - 1
+        bbox = (r0, c0, r1, c1)
+
+        _draw_frame(grid, bbox, int(color))
+        inner_h = frame_h - 2
+        inner_w = frame_w - 2
+        placement = _place_holes(inner_h, inner_w, int(hole_count), int(color))
+        if placement is None:
