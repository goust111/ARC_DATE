+        if idx == 0:
+            r0 = int(_RNG.integers(0, max_r0 + 1))
+        else:
+            prev_r0 = specs[-1].bbox[0]
+            low = max(0, prev_r0 - 2)
+            high = min(max_r0, prev_r0 + 2)
+            if low > high:
