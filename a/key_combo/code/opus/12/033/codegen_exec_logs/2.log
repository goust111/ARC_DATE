+def _generate_attempt() -> np.ndarray | None:
+    n = int(_RNG.integers(3, 6))
+    hole_counts = _sample_hole_counts(n)
+    colors = _RNG.choice(np.array(FRAME_COLORS, dtype=int), size=n, replace=False).tolist()
