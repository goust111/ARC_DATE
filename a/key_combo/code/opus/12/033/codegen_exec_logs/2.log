+
+
+BLACK = 0
+GREEN = 3
+FRAME_COLORS = (1, 2, 4, 6, 7, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+_RNG = np.random.default_rng()
+_GEN_ATTEMPTS = 500
+
