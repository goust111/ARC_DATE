+            if 0 <= nr < hole_patch.shape[0] and 0 <= nc < hole_patch.shape[1] and not hole_patch[nr, nc]:
+                wall_patch[nr, nc] = True
+
+    patch = np.zeros_like(hole_patch, dtype=int)
+    patch[wall_patch] = color
