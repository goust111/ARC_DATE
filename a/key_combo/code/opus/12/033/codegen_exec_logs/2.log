+        width = 4 if n == 5 or _RNG.random() < 0.65 else 5
+    elif hole_count == 1:
+        height = int(_RNG.integers(6, 10))
+        width = 5 if n >= 4 or _RNG.random() < 0.6 else 6
+    else:
