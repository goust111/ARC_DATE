+        "tr": (0, w - 1, 0, w - 2, 1, w - 1),
+        "bl": (h - 1, 0, h - 1, 1, h - 2, 0),
+        "br": (h - 1, w - 1, h - 1, w - 2, h - 2, w - 1),
+    }
+    for corner, (cr, cc, hr, hc, vr, vc) in candidates.items():
