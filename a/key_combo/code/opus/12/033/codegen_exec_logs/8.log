+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+RECT_COLORS = np.array([BLUE, RED, GREEN, YELLOW, PINK, TEAL, MAROON], dtype=int)
+VISIBLE_HEIGHTS = np.array([1, 2, 4], dtype=int)
