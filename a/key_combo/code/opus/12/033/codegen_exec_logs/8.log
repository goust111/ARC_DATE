+            for r0 in range(top_h - rect_h + 1):
+                r1 = r0 + rect_h - 1
+                if r0 <= axis_r <= r1:
+                    continue
+                for c0 in range(width - rect_w + 1):
+                    c1 = c0 + rect_w - 1
+                    if c0 <= axis_c <= c1:
+                        continue
+                    box = (r0, c0, r1, c1)
+                    cands.append(
+                        {
+                            "bbox": box,
+                            "h": rect_h,
+                            "w": rect_w,
+                            "d2": abs((r0 + r1) - 2 * axis_r) + abs((c0 + c1) - 2 * axis_c),
+                        }
+                    )
+    return cands
+
