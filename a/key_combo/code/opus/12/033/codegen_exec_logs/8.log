+    col_sides = {1 if rect["bbox"][1] + rect["bbox"][3] > 2 * axis_c else -1 for rect in rects}
+    return row_sides == {-1, 1} and col_sides == {-1, 1} and dist_order != left_order and dist_order != top_order
+
