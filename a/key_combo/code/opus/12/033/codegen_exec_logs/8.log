+
+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    return (
+        a[2] + gap < b[0]
+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
+    )
+
+
+def _find_axes(grid: np.ndarray) -> tuple[int, int]:
+    grey = grid == GREY
+    row_counts = grey.sum(axis=1)
+    col_counts = grey.sum(axis=0)
