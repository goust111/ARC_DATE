+
+def _candidate_rectangles(top_h: int, width: int, axis_r: int, axis_c: int) -> list[dict]:
+    cands: list[dict] = []
+    for rect_h in range(2, 6):
+        for rect_w in range(2, 6):
+            for r0 in range(top_h - rect_h + 1):
+                r1 = r0 + rect_h - 1
+                if r0 <= axis_r <= r1:
+                    continue
+                for c0 in range(width - rect_w + 1):
+                    c1 = c0 + rect_w - 1
+                    if c0 <= axis_c <= c1:
+                        continue
+                    box = (r0, c0, r1, c1)
+                    cands.append(
