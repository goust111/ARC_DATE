+                    box = (r0, c0, r1, c1)
+                    cands.append(
+                        {
+                            "bbox": box,
+                            "h": rect_h,
+                            "w": rect_w,
+                            "d2": abs((r0 + r1) - 2 * axis_r) + abs((c0 + c1) - 2 * axis_c),
+                        }
+                    )
+    return cands
+
