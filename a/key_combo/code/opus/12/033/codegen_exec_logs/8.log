+def _gen_attempt() -> np.ndarray | None:
+    count = int(RNG.integers(3, 6))
+    width = int(RNG.integers(max(18, 2 * count + 8), 25))
+    top_h = int(RNG.integers(11, 17))
+    axis_r = int(RNG.integers(2, top_h - 2))
+    axis_c = int(RNG.integers(2, width - 2))
