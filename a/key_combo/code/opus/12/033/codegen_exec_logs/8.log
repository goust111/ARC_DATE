+    cur_r = 0
+    for patch in patches:
+        ph, pw = patch.shape
+        cur_c = (out_w - pw) // 2
+        out[cur_r : cur_r + ph, cur_c : cur_c + pw] = patch
+        cur_r += ph + 1
+    return out
