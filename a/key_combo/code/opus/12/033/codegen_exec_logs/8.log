+def _pick_rectangles(cands: list[dict], count: int) -> list[dict] | None:
+    for _ in range(300):
+        chosen: list[dict] = []
+        used_d2: set[int] = set()
+        for idx in RNG.permutation(len(cands)):
+            cand = cands[int(idx)]
+            if cand["d2"] in used_d2:
