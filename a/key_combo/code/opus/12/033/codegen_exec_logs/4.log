+        matches = markers_by_shape.get(key, [])
+        assert len(matches) == 1, f"expected one external marker for hole shape {key}, got {len(matches)}"
+        color = int(matches[0]["color"])
+        matched_colors[key] = color
+        out[hole[:, 0], hole[:, 1]] = color
