+    g = np.asarray(grid, dtype=int)
+    host = _largest_component(g == BLUE)
+    host_box = _bbox_coords(host)
+    crop = _crop_bbox(g, host_box)
+    local_host = host - np.array([host_box[0], host_box[1]])
