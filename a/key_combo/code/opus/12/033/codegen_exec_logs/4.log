+        for c0 in range(grid.shape[1] - w + 1):
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(not _bbox_separated(box, other) for other in existing_boxes):
+                continue
+            candidates.append((r0, c0))
