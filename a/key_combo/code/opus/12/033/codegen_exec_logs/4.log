+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    out: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(cells, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _shape_key(coords: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
+    origin = coords.min(axis=0)
+    norm = coords - origin
+    h = int(norm[:, 0].max()) + 1
+    w = int(norm[:, 1].max()) + 1
+    cells = tuple(sorted((int(r), int(c)) for r, c in norm))
+    return h, w, cells
+
+
+def _mask_from_coords(coords: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    out[coords[:, 0], coords[:, 1]] = True
+    return out
+
+
+def _enclosed_holes(local_host_mask: np.ndarray) -> list[np.ndarray]:
+    h, w = local_host_mask.shape
+    passable = ~local_host_mask
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds((h, w), nr, nc) and passable[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    return _components(passable & ~outside)
