+
+def _bbox_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 2) -> bool:
+    return a[2] + pad < b[0] or b[2] + pad < a[0] or a[3] + pad < b[1] or b[3] + pad < a[1]
