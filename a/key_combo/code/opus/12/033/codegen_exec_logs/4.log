+def _nearest_edge(center: tuple[int, int], host_shape: tuple[int, int]) -> str:
+    edge = _nearest_edge_or_none(center, host_shape)
+    assert edge is not None, f"hole center has tied nearest edges for shape {host_shape}: {center}"
+    return edge
