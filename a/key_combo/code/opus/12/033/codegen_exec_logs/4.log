+    "plus5": np.array([(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)], dtype=int),
+    "t_up5": np.array([(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)], dtype=int),
+    "t_down5": np.array([(0, 1), (1, 1), (2, 0), (2, 1), (2, 2)], dtype=int),
+    "t_left5": np.array([(0, 0), (1, 0), (1, 1), (2, 0), (2, 1)], dtype=int),
