+    passable = ~local_host_mask
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds((h, w), nr, nc) and passable[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
