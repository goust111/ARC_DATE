+def _expected_crop(host_shape: tuple[int, int], hole_specs: list[dict]) -> np.ndarray:
+    out = np.full(host_shape, BLUE, dtype=int)
+    for spec in hole_specs:
+        coords = spec["coords"]
+        local = coords.copy()
+        out[local[:, 0], local[:, 1]] = int(spec["color"])
+    for spec in hole_specs:
