        x0, y0 = base_r - dr, base_c - dc
        while 0 <= x0 < len(input_grid) and 0 <= y0 < len(input_grid[0]):
            if input_grid[x0, y0] == Color.BLACK:
                output_grid[x0, y0] = base_color
            x0, y0 = x0 - dr, y0 - dc

        return output_grid

