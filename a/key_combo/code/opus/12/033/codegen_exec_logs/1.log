+                        "seg_b": seg_b,
+                        "k0": k0,
+                        "k1": k1,
+                        "b0": b0,
+                        "b1": b1,
+                        "anchor": anchor,
+                        "marker_color": marker_color,
+                        "body_color": body_color,
+                        "final_cells": final_cells,
+                        "input_cells": input_cells,
+                        "marker_index": marker_index,
+                        "branch": branch,
+                    }
