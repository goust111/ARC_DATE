+def _pair_candidates_for_sprite(sprite: dict, segments: list[dict]) -> list[dict]:
+    cells = sprite["coords"]
+    candidates = []
+    for i in range(len(segments)):
+        for j in range(i + 1, len(segments)):
+            a = segments[i]
+            b = segments[j]
+            low_k = min(a["k"], b["k"])
+            high_k = max(a["k"], b["k"])
+            overlap0 = max(a["b0"], b["b0"])
+            overlap1 = min(a["b1"], b["b1"])
+            if overlap0 > overlap1:
+                continue
+            ok = True
+            for r, c in cells:
