+                        "pair": (i, j),
+                        "k0": low_k,
+                        "k1": high_k,
+                        "b0": overlap0,
+                        "b1": overlap1,
+                        "gap": high_k - low_k,
+                    }
+                )
+    candidates.sort(key=lambda item: (item["gap"], item["pair"]))
+    return candidates
