+def _transform(rel_cells, marker, op: int):
+    def apply(cell):
+        r, c = cell
+        if op == 0:
+            return r, c
+        if op == 1:
+            return c, -r
+        if op == 2:
+            return -r, -c
+        if op == 3:
+            return -c, r
+        if op == 4:
+            return r, -c
+        if op == 5:
+            return -r, c
+        if op == 6:
+            return c, r
+        return -c, -r
+
+    transformed = [apply(cell) for cell in rel_cells]
+    mr, mc = apply(marker)
+    normalized = sorted((r - mr, c - mc) for r, c in transformed)
+    return normalized
