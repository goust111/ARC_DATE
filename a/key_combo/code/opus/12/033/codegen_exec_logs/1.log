+    marker_r, marker_c = sprite["marker"]
+    anchor_r, anchor_c = anchor
+    if anchor_r in (0, h - 1) and anchor_c not in (0, w - 1):
+        t = anchor_c - marker_c
+    else:
+        t = anchor_r - marker_r
