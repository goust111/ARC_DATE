+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    if connectivity == 4:
+        steps = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
+        steps = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
