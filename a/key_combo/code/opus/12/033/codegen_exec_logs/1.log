+
+def _pair_candidates_for_sprite(sprite: dict, segments: list[dict]) -> list[dict]:
+    cells = sprite["coords"]
+    candidates = []
+    for i in range(len(segments)):
+        for j in range(i + 1, len(segments)):
+            a = segments[i]
+            b = segments[j]
+            low_k = min(a["k"], b["k"])
+            high_k = max(a["k"], b["k"])
+            overlap0 = max(a["b0"], b["b0"])
+            overlap1 = min(a["b1"], b["b1"])
+            if overlap0 > overlap1:
+                continue
+            ok = True
+            for r, c in cells:
+                b_val = int(r - c)
+                k_val = int(r + c)
+                if not (overlap0 <= b_val <= overlap1 and low_k < k_val < high_k):
+                    ok = False
+                    break
+            if ok:
+                candidates.append(
+                    {
+                        "pair": (i, j),
+                        "k0": low_k,
+                        "k1": high_k,
+                        "b0": overlap0,
+                        "b1": overlap1,
+                        "gap": high_k - low_k,
+                    }
+                )
+    candidates.sort(key=lambda item: (item["gap"], item["pair"]))
+    return candidates
