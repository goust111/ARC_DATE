+    ur_seq: np.ndarray,
+    ll_seq: np.ndarray,
+    lr_seq: np.ndarray,
+) -> np.ndarray:
+    side = int(len(ul_seq))
+    out = np.empty((2 * side, 2 * side), dtype=int)
+    for r in range(side):
+        for c in range(side):
+            out[r, c] = int(ul_seq[min(r, c)])
+            out[r, side + c] = int(ur_seq[min(r, side - 1 - c)])
+            out[side + r, c] = int(ll_seq[min(side - 1 - r, c)])
+            out[side + r, side + c] = int(lr_seq[min(side - 1 - r, side - 1 - c)])
+    return out
+
+
+def _count_enclosed_black_regions(quadrant: np.ndarray) -> int:
+    h, w = quadrant.shape
+    seen = np.zeros((h, w), dtype=bool)
+    enclosed = 0
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(quadrant[r, c]) != 0:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while queue:
+                cr, cc = queue.popleft()
+                if cr == 0 or cc == 0 or cr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
