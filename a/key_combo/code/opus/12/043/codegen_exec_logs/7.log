+
+def _read_blocks_reverse_row_major(grid: np.ndarray) -> list[np.ndarray]:
+    h, w = grid.shape
+    blocks: list[np.ndarray] = []
+    for br in range(h // 2 - 1, -1, -1):
+        for bc in range(w // 2 - 1, -1, -1):
+            blocks.append(grid[2 * br : 2 * br + 2, 2 * bc : 2 * bc + 2].copy())
+    return blocks
