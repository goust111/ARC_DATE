+        (slice(side, 2 * side), slice(side, 2 * side)),
+    ]
+    for rs, cs in quadrants:
+        quadrant = raw[rs, cs]
+        fill_color = _recolor_for_count(_count_enclosed_black_regions(quadrant))
+        recolored = quadrant.copy()
