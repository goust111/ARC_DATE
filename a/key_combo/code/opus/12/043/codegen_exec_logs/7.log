+def _count_enclosed_runs(layer_seq: np.ndarray) -> int:
+    count = 0
+    for idx in range(1, len(layer_seq)):
+        if int(layer_seq[idx]) == 0 and int(layer_seq[idx - 1]) != 0:
+            count += 1
+    return count
+
+
+def _build_binary_layers(side: int, enclosed_count: int, force_prefix_zero: bool | None) -> list[int]:
+    candidates: list[list[int]] = []
+
+    def add_candidate(states: list[int]) -> None:
+        if len(states) <= side:
+            candidates.append(states)
+
+    if enclosed_count == 0:
+        add_candidate([1])
+        add_candidate([0, 1])
+    else:
+        states = [1]
+        for idx in range(enclosed_count):
+            states.append(0)
+            if idx != enclosed_count - 1:
+                states.append(1)
+        add_candidate(states)
+        add_candidate(states + [1])
+
+        prefixed = [0]
+        for _ in range(enclosed_count):
+            prefixed.extend([1, 0])
+        add_candidate(prefixed)
+        add_candidate(prefixed + [1])
+
+    if force_prefix_zero is not None:
+        candidates = [cand for cand in candidates if bool(cand[0] == 0) == force_prefix_zero]
+    candidates = [cand for cand in candidates if 1 in cand]
+    if not candidates:
+        raise ValueError("no feasible layer pattern")
+
+    states = random.choice(candidates)
+    lengths = [1] * len(states)
+    for _ in range(side - len(states)):
+        lengths[random.randrange(len(lengths))] += 1
+
+    bits: list[int] = []
+    for state, run_length in zip(states, lengths):
+        bits.extend([state] * run_length)
+    assert len(bits) == side
+    assert _count_enclosed_runs(np.array([0 if bit == 0 else 9 for bit in bits], dtype=int)) == enclosed_count
+    return bits
+
+
+def _can_force_prefix_zero(side: int, enclosed_count: int) -> bool:
+    if enclosed_count == 0:
+        return side >= 2
+    return 2 * enclosed_count + 1 <= side
+
+
+def _colorize_layers(bits: list[int]) -> np.ndarray:
+    seq: list[int] = []
+    last_run_color: int | None = None
+    prev_bit: int | None = None
+    for bit in bits:
+        if bit == 0:
+            seq.append(0)
+            prev_bit = 0
