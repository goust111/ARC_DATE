+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+MARKER_COLORS = [1, 3, 5, 6, 7, 8, 9]
+
+GRID_ROWS = (14, 17)
+GRID_COLS = (16, 19)
+NUM_OBJECTS = (3, 4)
+UNIT_SEARCH_SIZE = 11
+PADDING = 1
+MAX_GENERATE_ATTEMPTS = 400
+MAX_UNIT_ATTEMPTS = 200
