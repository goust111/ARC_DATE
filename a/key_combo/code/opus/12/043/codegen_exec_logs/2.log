+        input_unit = output_unit.copy()
+        input_unit[dst_rel[:, 0], dst_rel[:, 1]] = BG
+        mr, mc = dst_rel[random.randrange(len(dst_rel))]
+        input_unit[int(mr), int(mc)] = marker_color
