+        assert len(adjacent_segments) == 1
+        assert len(contact_dirs) == 1
+        seg_idx = next(iter(adjacent_segments))
+        direction = next(iter(contact_dirs))
+        segment = red_info[seg_idx]
+        assert _all_on_side(coords, segment, direction)
