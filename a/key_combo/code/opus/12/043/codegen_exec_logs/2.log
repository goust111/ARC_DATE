+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+MARKER_COLORS = [1, 3, 5, 6, 7, 8, 9]
+
+GRID_ROWS = (14, 17)
+GRID_COLS = (16, 19)
