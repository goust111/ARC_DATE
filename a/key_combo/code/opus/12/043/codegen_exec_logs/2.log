+        bends = _count_bends(local_mask)
+        assert bends in {1, 2, 3}
+
+        transformed = _transform_coords(coords, segment, bends)
+        transformed_set = {(int(r), int(c)) for r, c in transformed}
+        assert len(transformed_set) == len(transformed)
+        h, w = g.shape
