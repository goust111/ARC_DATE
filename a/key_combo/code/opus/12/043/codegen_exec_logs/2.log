+        for r, c in coords:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in _neighbors4(rr, cc):
+                seg_idx = red_by_cell.get((nr, nc))
+                if seg_idx is not None:
+                    adjacent_segments.add(seg_idx)
+                    contact_dirs.add((nr - rr, nc - cc))
