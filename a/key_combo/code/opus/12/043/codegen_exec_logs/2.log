+        src, dst = random.choice(candidates)
+        all_coords = np.vstack([src, red_coords, np.array(dst, dtype=int)])
+        r0, c0 = all_coords.min(axis=0)
+        r1, c1 = all_coords.max(axis=0)
+        shape = (int(r1 - r0 + 1), int(c1 - c0 + 1))
+        src_rel = src - np.array([r0, c0])
