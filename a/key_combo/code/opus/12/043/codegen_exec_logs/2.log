+def _can_place(occupied: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch.shape
+    hh, ww = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
