+        (int(r), int(c))
+        for r, c in np.argwhere((step1 != BLACK) & (step1 != BLUE) & (step1 != YELLOW))
+    }
+
+    passable = step1 == BLACK
+    for r, c in blue_dots:
+        if step1[r, c] == BLUE:
+            passable[r, c] = True
