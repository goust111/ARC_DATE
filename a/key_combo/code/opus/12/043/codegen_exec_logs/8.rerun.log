+
+
+def _dot_ok(grid: np.ndarray, cell: tuple[int, int], chosen: set[tuple[int, int]]) -> bool:
+    if cell in chosen:
+        return False
+    if grid[cell] != BLACK:
+        return False
+    for nr, nc in _neighbors4(*cell):
