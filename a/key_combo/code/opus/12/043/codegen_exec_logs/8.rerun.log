+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and grid[nr, nc] == BLUE:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
