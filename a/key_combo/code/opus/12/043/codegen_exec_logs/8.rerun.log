+        for r in range(r0 + 1, r1):
+            wall_cells.add((r, vc))
+        for c in range(c0 + 1, c1):
+            wall_cells.add((hr, c))
+        markers = [(r0 + 1, vc), (hr, c0 + 1), (hr, c1 - 1), (r1 - 1, vc)]
+    elif pattern == "double_v":
