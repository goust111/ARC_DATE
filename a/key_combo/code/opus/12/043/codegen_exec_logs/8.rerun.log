+                if all(_rects_far_apart(rect, other, GEN_RECT_GAP) for other in rects):
+                    rects.append(rect)
+                    placed = True
+                    break
+            if not placed:
+                ok = False
+                break
+        if ok:
+            return sorted(rects)
+    return None
+
+
+def _build_rectangle_pattern(
