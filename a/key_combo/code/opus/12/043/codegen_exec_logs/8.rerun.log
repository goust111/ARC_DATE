+def _build_rectangle_pattern(
+    rng: np.random.Generator, rect: tuple[int, int, int, int]
+) -> dict:
+    r0, c0, r1, c1 = rect
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    patterns = ["cross", "double_v", "double_h"]
+    if inner_w < 6:
+        patterns.remove("double_v")
+    if inner_h < 6:
+        patterns.remove("double_h")
+    pattern = str(rng.choice(patterns))
