+                c0 = int(rng.integers(1, w - rw - 1))
+                rect = (r0, c0, r0 + rh - 1, c0 + rw - 1)
+                if all(_rects_far_apart(rect, other, GEN_RECT_GAP) for other in rects):
+                    rects.append(rect)
+                    placed = True
+                    break
