+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    regions = []
+    for r in range(h):
+        for c in range(w):
+            if not passable[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            dots = []
+            adj_seen = set()
+            adjacent_markers = []
+
+            while q:
