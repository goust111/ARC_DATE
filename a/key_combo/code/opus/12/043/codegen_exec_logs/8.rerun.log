+GEN_HEIGHT_RANGE = (18, 25)
+GEN_WIDTH_RANGE = (18, 25)
+GEN_RECT_COUNT_CHOICES = (1, 2)
+GEN_RECT_HEIGHT_RANGE = (8, 12)
+GEN_RECT_WIDTH_RANGE = (8, 12)
