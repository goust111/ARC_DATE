+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GEN_ATTEMPTS = 500
+GRID_SIZE_RANGE = (13, 19)
+K_RANGE = (3, 6)
+GUIDE_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+OBJECT_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _paint_bars(
+    out: np.ndarray,
+    orientation: str,
+    origin: tuple[int, int],
+    guide_color: int,
+    k: int,
+) -> None:
+    h, w = out.shape
+    r0, c0 = origin
+    if orientation == "vertical":
+        top = r0 - (k - 1)
+        bottom = r0 + (k - 1)
+        for rr in range(top, bottom + 1):
+            if 0 <= rr < h:
+                if 0 <= c0 - k < w:
+                    out[rr, c0 - k] = guide_color
+                if 0 <= c0 + k < w:
+                    out[rr, c0 + k] = guide_color
+    else:
+        left = c0 - (k - 1)
+        right = c0 + (k - 1)
+        for cc in range(left, right + 1):
+            if 0 <= cc < w:
+                if 0 <= r0 - k < h:
+                    out[r0 - k, cc] = guide_color
+                if 0 <= r0 + k < h:
+                    out[r0 + k, cc] = guide_color
+
+
+def _render_output(
+    shape: tuple[int, int],
+    bg: int,
+    guide_color: int,
+    orientation: str,
+    center_segment: list[tuple[int, int]],
+    origin: tuple[int, int],
+    palette: list[int],
+) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    protected = np.zeros(shape, dtype=bool)
+    for r, c in center_segment:
+        protected[r, c] = True
+        out[r, c] = guide_color
+
+    rows, cols = np.indices(shape)
+    r0, c0 = origin
+    dist = np.maximum(np.abs(rows - r0), np.abs(cols - c0))
+    for d, color in enumerate(palette):
+        mask = (dist == d) & ~protected
+        out[mask] = int(color)
+
+    _paint_bars(out, orientation, origin, guide_color, len(palette))
+    return out
+
+
