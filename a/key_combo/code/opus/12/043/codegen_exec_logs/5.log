spec:
  grid: odd square NxN, N in 9-19
  colors: exactly 3 — background (7), guide (0), object (5) [observed: always these colors]
  guide_structure:
    parallel_pair: two full-spanning bars symmetric about grid center, even gap 4-8
    perpendicular_bar: spans entire axis EXCEPT between the parallel pair (split by object region)
    orientation: either vertical (full cols) or horizontal (full rows)
    all_centered: pair midpoint = perp bar position = grid center (N//2)
  object:
    color: does not touch grid boundary
    connectivity: single 8-connected component
    area: odd, range 5-13, must be <= N (fits as line along grid dimension)
    location: entirely between the parallel pair bars
    shape: arbitrary connected blob fitting within the gap interior
  output_structure:
    guide_rebuilt: perpendicular bar becomes full + parallel bars collapse to center-1 and center+1
    object_flattened: single-pixel-wide line of length=area, parallel to original pair, centered on perp bar
generation_strategy:
  approach: output-first
  steps:
    1. Pick odd N (9-19), orientation (H or V), object area A (odd, 5 to N)
    2. Build output — center = N//2; place two full guide bars at center-1, center+1; place full perp bar at center; fill A pixels of object color centered on perp bar along center line
    3. Choose pair gap G (even, 4 to N-4, G >= ceil(sqrt(A))+2 to fit a blob); place parallel bars at center-G//2 and center+G//2
    4. Build input — keep the two parallel bars full, replace perp bar with split version (only outside parallel pair); generate a random 8-connected blob of area A fitting between the pair bars, then place it in the interior region
