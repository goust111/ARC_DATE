+def transform_template(
+    points: tuple[tuple[int, int], ...],
+    *,
+    swap_axes: bool,
+    flip_rows: bool,
+    flip_cols: bool,
+) -> list[tuple[int, int]]:
+    out = []
+    for r, c in points:
+        rr, cc = (c, r) if swap_axes else (r, c)
+        if flip_rows:
+            rr = -rr
+        if flip_cols:
+            cc = -cc
+        out.append((rr, cc))
+    min_r = min(r for r, _ in out)
+    min_c = min(c for _, c in out)
+    return [(r - min_r, c - min_c) for r, c in out]
