-def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
-    h, w = shape
-    return 0 <= r < h and 0 <= c < w
-
-
-def neighbors4(r: int, c: int):
-    yield r - 1, c
-    yield r + 1, c
-    yield r, c - 1
-    yield r, c + 1
-
-
-def neighbors8(r: int, c: int):
-    for dr in (-1, 0, 1):
-        for dc in (-1, 0, 1):
-            if dr == 0 and dc == 0:
-                continue
-            yield r + dr, c + dc
-
-
-def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
-    r0, c0 = coords.min(axis=0)
-    r1, c1 = coords.max(axis=0)
-    return int(r0), int(c0), int(r1), int(c1)
-
-
-def components(mask: np.ndarray, *, conn8: bool) -> list[np.ndarray]:
-    h, w = mask.shape
-    seen = np.zeros((h, w), dtype=bool)
-    out: list[np.ndarray] = []
-    neigh = neighbors8 if conn8 else neighbors4
-    for r in range(h):
-        for c in range(w):
-            if not mask[r, c] or seen[r, c]:
-                continue
-            q = deque([(r, c)])
-            seen[r, c] = True
-            pts: list[tuple[int, int]] = []
-            while q:
-                cr, cc = q.popleft()
-                pts.append((cr, cc))
-                for nr, nc in neigh(cr, cc):
-                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
-                        seen[nr, nc] = True
-                        q.append((nr, nc))
-            out.append(np.array(pts, dtype=int))
-    return out
-
-
-def plus_cells(center: tuple[int, int]) -> set[tuple[int, int]]:
