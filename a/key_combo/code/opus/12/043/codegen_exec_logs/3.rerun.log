+def labels_fit_layout(
+    layout: dict,
+    centers: list[tuple[int, int]],
+    labels: list[int | None],
+    *,
+    want_tie: bool,
+    want_unlabeled: bool,
+) -> bool:
+    if set(color for color in labels if color is not None) != set(KEY_COLORS):
