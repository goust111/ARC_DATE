+    swap_axes: bool,
+    flip_rows: bool,
+    flip_cols: bool,
+) -> list[tuple[int, int]]:
+    out = []
+    for r, c in points:
+        rr, cc = (c, r) if swap_axes else (r, c)
+        if flip_rows:
+            rr = -rr
+        if flip_cols:
