+def _build_input_grid(
+    h: int,
+    w: int,
+    floor_row: int,
+    floor_c0: int,
+    floor_c1: int,
+    stacks: list[tuple[int, str, int]],
+) -> tuple[np.ndarray, np.ndarray]:
+    floor_mask = _make_floor_mask((h, w), floor_row, floor_c0, floor_c1)
+    grid = np.full((h, w), BG, dtype=int)
+    grid[floor_mask] = GREY
