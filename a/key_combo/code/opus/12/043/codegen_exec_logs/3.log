+def instantiate_chain_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    max_col = legend_bbox[1] - 3
+    if max_col < 14:
+        return None
+    for _ in range(80):
+        d = 3
+        start_r = rng.randint(2, h - 3 - d)
+        start_c = rng.randint(2, max_col - 4 * d)
+        flip = rng.choice((-1, 1))
+        base = [
+            (start_r, start_c),
+            (start_r + d, start_c + d),
+            (start_r, start_c + 2 * d),
+            (start_r + d, start_c + 3 * d),
+            (start_r, start_c + 4 * d),
+        ]
+        if flip < 0:
+            min_c = min(c for _, c in base)
+            max_c = max(c for _, c in base)
