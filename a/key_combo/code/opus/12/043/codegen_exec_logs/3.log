+        r0, c0, r1, c1 = bbox_coords(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        if int(comp.shape[0]) != 2 * (h + w) - 4:
+            continue
