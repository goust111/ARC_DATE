+def choose_labels(centers: list[tuple[int, int]], rng: random.Random, *, want_unlabeled: bool) -> list[int | None]:
+    n = len(centers)
+    labels: list[int | None] = [None] * n
+    order = list(range(n))
+    rng.shuffle(order)
+    for idx, color in zip(order[:3], KEY_COLORS):
+        labels[idx] = color
+    remainder = order[3:]
+    if want_unlabeled and remainder:
+        unlabeled_need = rng.randint(1, min(2, len(remainder)))
+        unlabeled_idxs = set(rng.sample(remainder, unlabeled_need))
+    else:
