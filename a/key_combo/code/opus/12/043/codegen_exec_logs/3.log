+def instantiate_stacked_diamond_template(
+    shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random
+):
+    h, w = shape
+    del w
+    max_col = legend_bbox[1] - 3
+    for _ in range(120):
