+def diagonal_connectors(grid: np.ndarray, pluses: list[dict]) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    pairs: list[tuple[int, int]] = []
+    connector_cells: set[tuple[int, int]] = set()
