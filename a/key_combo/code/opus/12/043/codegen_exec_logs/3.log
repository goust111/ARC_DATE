+    plus_pixel_owner: dict[tuple[int, int], int] = {}
+    barrier = np.zeros_like(g, dtype=bool)
+    for idx, plus in enumerate(pluses):
+        for r, c in plus["pixels"]:
+            plus_pixel_owner[(r, c)] = idx
+            barrier[r, c] = True
