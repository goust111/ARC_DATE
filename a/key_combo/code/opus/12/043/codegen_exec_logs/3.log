+def choose_labels(centers: list[tuple[int, int]], rng: random.Random, *, want_unlabeled: bool) -> list[int | None]:
+    n = len(centers)
+    labels: list[int | None] = [None] * n
+    order = list(range(n))
+    rng.shuffle(order)
+    for idx, color in zip(order[:3], KEY_COLORS):
+        labels[idx] = color
+    remainder = order[3:]
+    if want_unlabeled and remainder:
+        unlabeled_need = rng.randint(1, min(2, len(remainder)))
+        unlabeled_idxs = set(rng.sample(remainder, unlabeled_need))
+    else:
+        unlabeled_idxs = set()
+    for idx in remainder:
+        if idx in unlabeled_idxs:
+            labels[idx] = None
+        else:
+            labels[idx] = rng.choice(KEY_COLORS)
+    if not want_unlabeled and all(label is not None for label in labels) and rng.random() < 0.25:
+        labels[rng.randrange(n)] = None
+        missing = [color for color in KEY_COLORS if color not in labels]
+        if missing:
+            alt = rng.choice([i for i, color in enumerate(labels) if color is None or color in KEY_COLORS])
+            labels[alt] = missing[0]
+    return labels
