+def instantiate_stacked_diamond_template(
+    shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random
+):
+    h, w = shape
+    del w
+    max_col = legend_bbox[1] - 3
+    for _ in range(120):
+        d = rng.choice((3, 4))
+        if h - 2 - 4 * d < 1:
+            continue
+        center_c = d + 1
+        if center_c + d > max_col:
+            continue
+        top_r = rng.randint(1, h - 2 - 4 * d)
+        centers = [
+            (top_r, center_c),
+            (top_r + d, center_c - d),
+            (top_r + d, center_c + d),
+            (top_r + 2 * d, center_c),
+            (top_r + 3 * d, center_c - d),
+            (top_r + 3 * d, center_c + d),
+            (top_r + 4 * d, center_c),
+        ]
+        occupied: set[tuple[int, int]] = set()
+        ok = True
+        for center in centers:
+            if not center_ok(center, shape, legend_bbox, occupied):
+                ok = False
+                break
+            occupied.update(plus_cells(center))
+        if ok:
+            return centers
+    return None
