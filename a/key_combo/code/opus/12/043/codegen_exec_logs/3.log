+        centers = [
+            hub,
+            (hub[0] - d, hub[1] - d),
+            (hub[0] - d, hub[1] + d),
+            (hub[0] + d, hub[1] - d),
+            (hub[0] + d, hub[1] + d),
+        ]
+        occupied: set[tuple[int, int]] = set()
