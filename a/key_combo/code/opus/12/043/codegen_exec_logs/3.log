+
+
+def center_ok(
+    center: tuple[int, int],
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    occupied: set[tuple[int, int]],
+) -> bool:
+    for cell in plus_cells(center):
+        if cell in occupied:
+            return False
+        r, c = cell
+        if not in_bounds(shape, r, c):
+            return False
