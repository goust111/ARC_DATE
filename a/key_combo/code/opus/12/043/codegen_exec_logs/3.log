+    labels: list[int | None],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    draw_legend(grid, legend_bbox, row_order)
+    for center, label in zip(centers, labels):
+        draw_plus(grid, center, label)
+    return grid
