+def draw_legend(grid: np.ndarray, bbox: tuple[int, int, int, int], row_order: tuple[int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    key_col = c0 + 1
