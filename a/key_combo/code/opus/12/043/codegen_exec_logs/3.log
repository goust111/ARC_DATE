+
+
+def draw_plus(grid: np.ndarray, center: tuple[int, int], label_color: int | None) -> None:
+    r, c = center
+    for dr, dc in PLUS_OFFSETS[1:]:
+        grid[r + dr, c + dc] = GREEN
