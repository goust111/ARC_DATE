+        if missing:
+            alt = rng.choice([i for i, color in enumerate(labels) if color is None or color in KEY_COLORS])
+            labels[alt] = missing[0]
+    return labels
+
+
+def validate_semantics(grid: np.ndarray, *, want_tie: bool, want_unlabeled: bool) -> bool:
+    try:
