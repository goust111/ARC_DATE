+def center_ok(center: tuple[int, int], legend_bbox: tuple[int, int, int, int], occupied: set[tuple[int, int]]) -> bool:
+    for cell in plus_cells(center):
+        if cell in occupied:
+            return False
+        r, c = cell
+        if r < 1 or c < 1:
+            return False
+        r0, c0, r1, c1 = legend_bbox
+        if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
