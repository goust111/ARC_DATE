+            (top_r + d, center_c - d),
+            (top_r + d, center_c + d),
+            (top_r + 2 * d, center_c),
+            (top_r + 3 * d, center_c - d),
+            (top_r + 3 * d, center_c + d),
+            (top_r + 4 * d, center_c),
+        ]
+        occupied: set[tuple[int, int]] = set()
+        ok = True
+        for center in centers:
+            if not center_ok(center, legend_bbox, occupied):
+                ok = False
+                break
+            occupied.update(plus_cells(center))
+        if ok:
+            return centers
