+                winners = [color for color, count in votes.items() if count == max_count]
+                if len(winners) > 1:
+                    tie = True
+                winner = min(
+                    winners,
+                    key=lambda color: min(
+                        pluses[idx]["center"] for idx in adjacent_plus_ids if pluses[idx]["label_color"] == color
