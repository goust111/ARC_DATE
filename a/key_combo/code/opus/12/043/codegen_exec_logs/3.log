+    neigh = neighbors8 if conn8 else neighbors4
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neigh(cr, cc):
