+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+KEY_COLORS = (BLUE, RED, YELLOW)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LABEL_ATTEMPTS = 220
+EXTRA_ATTEMPTS = 120
+ROW_RANGE = (18, 22)
+COL_RANGE = (26, 29)
+LEGEND_H = 7
+LEGEND_W = 9
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components(mask: np.ndarray, *, conn8: bool) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    neigh = neighbors8 if conn8 else neighbors4
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neigh(cr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def plus_cells(center: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = center
+    return {(r + dr, c + dc) for dr, dc in PLUS_OFFSETS}
+
+
+def find_legend(grid: np.ndarray) -> dict:
+    candidates = []
+    for comp in components(grid == GREY, conn8=False):
+        if comp.shape[0] < 16:
+            continue
+        r0, c0, r1, c1 = bbox_coords(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        if int(comp.shape[0]) != 2 * (h + w) - 4:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not (sub[0, :] == GREY).all():
+            continue
+        if not (sub[-1, :] == GREY).all():
+            continue
+        if not (sub[:, 0] == GREY).all():
+            continue
+        if not (sub[:, -1] == GREY).all():
+            continue
+        if (sub[1:-1, 1:-1] == GREY).any():
+            continue
+        key_col = None
+        for rel_c in range(1, w - 1):
+            if (sub[1:-1, rel_c] != BLACK).any():
+                key_col = c0 + rel_c
+                break
+        if key_col is None:
+            continue
+        rows_by_color: dict[int, int] = {}
+        for rr in range(r0 + 1, r1):
+            color = int(grid[rr, key_col])
+            if color != BLACK:
