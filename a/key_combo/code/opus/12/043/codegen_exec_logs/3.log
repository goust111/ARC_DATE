+    legend = analysis["legend"]
+    r0, c0, r1, c1 = legend["bbox"]
+    interior = out[r0 + 1 : r1, c0 + 1 : c1]
+    if (interior == GREY).any():
+        return False
+    for color in KEY_COLORS:
+        row = legend["rows_by_color"][color]
+        expected = int(counts[color])
+        seen = [int(out[row, legend["key_col"] + 2 * k]) for k in range(expected)]
+        if seen != [color] * expected:
+            return False
+    return True
