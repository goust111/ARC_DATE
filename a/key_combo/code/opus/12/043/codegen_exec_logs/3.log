+            (top_r + d, center_c - d),
+            (top_r + d, center_c + d),
+            (top_r + 2 * d, center_c),
+            (top_r + 3 * d, center_c - d),
+            (top_r + 3 * d, center_c + d),
+            (top_r + 4 * d, center_c),
