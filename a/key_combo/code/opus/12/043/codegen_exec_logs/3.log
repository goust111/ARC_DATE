+def find_pluses(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    pluses = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r - 1, c]) != GREEN or int(grid[r + 1, c]) != GREEN:
