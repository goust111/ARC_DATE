+    for _ in range(80):
+        d = 3
+        start_r = rng.randint(2, h - 3 - d)
+        start_c = rng.randint(2, max_col - 4 * d)
+        flip = rng.choice((-1, 1))
+        base = [
+            (start_r, start_c),
+            (start_r + d, start_c + d),
+            (start_r, start_c + 2 * d),
+            (start_r + d, start_c + 3 * d),
+            (start_r, start_c + 4 * d),
+        ]
+        if flip < 0:
+            min_c = min(c for _, c in base)
+            max_c = max(c for _, c in base)
+            base = [(r, max_c - (c - min_c)) for r, c in base]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in base):
+            for center in base:
+                occupied.update(plus_cells(center))
+            return base
+    return None
