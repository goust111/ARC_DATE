+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+KEY_COLORS = (BLUE, RED, YELLOW)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LABEL_ATTEMPTS = 220
+EXTRA_ATTEMPTS = 120
