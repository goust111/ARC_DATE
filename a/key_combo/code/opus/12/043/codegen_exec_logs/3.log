+
+def instantiate_x_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    _r0, _c0, _r1, _c1 = legend_bbox
+    max_col = legend_bbox[1] - 3
+    for _ in range(80):
+        d = rng.choice((3, 4))
+        if max_col < 2 + 2 * d:
+            continue
+        hub = (
+            rng.randint(2 + d, h - 3 - d),
+            rng.randint(2 + d, max_col - d),
+        )
+        centers = [
+            hub,
+            (hub[0] - d, hub[1] - d),
+            (hub[0] - d, hub[1] + d),
+            (hub[0] + d, hub[1] - d),
+            (hub[0] + d, hub[1] + d),
+        ]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in centers):
+            for center in centers:
+                occupied.update(plus_cells(center))
+            return centers
+    return None
