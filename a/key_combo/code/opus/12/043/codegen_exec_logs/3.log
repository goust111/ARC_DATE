+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+KEY_COLORS = (BLUE, RED, YELLOW)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LABEL_ATTEMPTS = 220
+EXTRA_ATTEMPTS = 120
+ROW_RANGE = (18, 22)
+COL_RANGE = (26, 29)
+LEGEND_H = 7
+LEGEND_W = 9
