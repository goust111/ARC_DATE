+            votes = Counter(pluses[idx]["label_color"] for idx in adjacent_plus_ids)
+            tie = False
+            winner = None
+            if votes:
+                max_count = max(votes.values())
+                winners = [color for color, count in votes.items() if count == max_count]
+                if len(winners) > 1:
