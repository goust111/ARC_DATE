+        if not (sub[0, :] == GREY).all():
+            continue
+        if not (sub[-1, :] == GREY).all():
+            continue
+        if not (sub[:, 0] == GREY).all():
+            continue
+        if not (sub[:, -1] == GREY).all():
+            continue
+        if (sub[1:-1, 1:-1] == GREY).any():
+            continue
+        key_col = None
+        for rel_c in range(1, w - 1):
+            if (sub[1:-1, rel_c] != BLACK).any():
+                key_col = c0 + rel_c
+                break
+        if key_col is None:
+            continue
