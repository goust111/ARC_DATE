+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+KEY_COLORS = (BLUE, RED, YELLOW)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LABEL_ATTEMPTS = 220
+EXTRA_ATTEMPTS = 120
+ROW_RANGE = (18, 22)
+COL_RANGE = (26, 29)
+LEGEND_H = 7
+LEGEND_W = 9
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components(mask: np.ndarray, *, conn8: bool) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    neigh = neighbors8 if conn8 else neighbors4
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neigh(cr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def plus_cells(center: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = center
+    return {(r + dr, c + dc) for dr, dc in PLUS_OFFSETS}
+
+
+def find_legend(grid: np.ndarray) -> dict:
+    candidates = []
+    for comp in components(grid == GREY, conn8=False):
+        if comp.shape[0] < 16:
+            continue
+        r0, c0, r1, c1 = bbox_coords(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        if int(comp.shape[0]) != 2 * (h + w) - 4:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not (sub[0, :] == GREY).all():
+            continue
+        if not (sub[-1, :] == GREY).all():
+            continue
+        if not (sub[:, 0] == GREY).all():
+            continue
+        if not (sub[:, -1] == GREY).all():
+            continue
+        if (sub[1:-1, 1:-1] == GREY).any():
+            continue
+        key_col = None
+        for rel_c in range(1, w - 1):
+            if (sub[1:-1, rel_c] != BLACK).any():
+                key_col = c0 + rel_c
+                break
+        if key_col is None:
+            continue
+        rows_by_color: dict[int, int] = {}
+        for rr in range(r0 + 1, r1):
+            color = int(grid[rr, key_col])
+            if color != BLACK:
+                rows_by_color[color] = rr
+        if set(rows_by_color) != set(KEY_COLORS):
+            continue
+        candidates.append((h * w, r1, c1, r0, c0, r1, c1, key_col, rows_by_color))
+    assert candidates, "legend box not found"
+    _area, _r1, _c1, r0, c0, r1, c1, key_col, rows_by_color = max(candidates)
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "key_col": key_col,
+        "rows_by_color": rows_by_color,
+        "slots": len(range(key_col, c1, 2)),
+    }
+
+
+def find_pluses(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    pluses = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r - 1, c]) != GREEN or int(grid[r + 1, c]) != GREEN:
+                continue
+            if int(grid[r, c - 1]) != GREEN or int(grid[r, c + 1]) != GREEN:
+                continue
+            center_color = int(grid[r, c])
+            if center_color not in (GREEN, BLUE, RED, YELLOW):
+                continue
+            label_color = center_color if center_color in KEY_COLORS else None
+            pluses.append(
+                {
+                    "center": (r, c),
+                    "label_color": label_color,
+                    "pixels": plus_cells((r, c)),
+                }
+            )
+    pluses.sort(key=lambda item: item["center"])
+    assert 5 <= len(pluses) <= 7, "expected 5-7 pluses"
+    return pluses
+
+
+def diagonal_connectors(grid: np.ndarray, pluses: list[dict]) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    pairs: list[tuple[int, int]] = []
+    connector_cells: set[tuple[int, int]] = set()
+    for i, plus_a in enumerate(pluses):
+        r1, c1 = plus_a["center"]
+        for j in range(i + 1, len(pluses)):
+            r2, c2 = pluses[j]["center"]
+            dr = r2 - r1
+            dc = c2 - c1
+            if abs(dr) != abs(dc):
+                continue
+            sr = 1 if dr > 0 else -1
+            sc = 1 if dc > 0 else -1
+            gap = [(r1 + k * sr, c1 + k * sc) for k in range(1, abs(dr))]
+            if all(int(grid[r, c]) == BLACK for r, c in gap):
+                pairs.append((i, j))
+                connector_cells.update(gap)
+    return pairs, connector_cells
+
+
+def analyze_instance(grid: np.ndarray, *, use_connectors: bool = True) -> dict:
+    g = np.asarray(grid, dtype=int)
+    legend = find_legend(g)
+    pluses = find_pluses(g)
+    connector_pairs, connector_cells = diagonal_connectors(g, pluses) if use_connectors else ([], set())
+
+    plus_pixel_owner: dict[tuple[int, int], int] = {}
+    barrier = np.zeros_like(g, dtype=bool)
+    for idx, plus in enumerate(pluses):
+        for r, c in plus["pixels"]:
+            plus_pixel_owner[(r, c)] = idx
+            barrier[r, c] = True
+    for r, c in connector_cells:
+        barrier[r, c] = True
+    r0, c0, r1, c1 = legend["bbox"]
+    barrier[r0 : r1 + 1, c0 : c1 + 1] = True
+
+    passable = (g == BLACK) & ~barrier
+    seen = np.zeros_like(passable, dtype=bool)
+    regions = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            if not passable[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            adjacent_plus_ids: set[int] = set()
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if in_bounds(g.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                for nr, nc in neighbors8(cr, cc):
+                    owner = plus_pixel_owner.get((nr, nc))
+                    if owner is not None and pluses[owner]["label_color"] is not None:
+                        adjacent_plus_ids.add(owner)
+
+            votes = Counter(pluses[idx]["label_color"] for idx in adjacent_plus_ids)
+            tie = False
+            winner = None
+            if votes:
+                max_count = max(votes.values())
+                winners = [color for color, count in votes.items() if count == max_count]
+                if len(winners) > 1:
+                    tie = True
+                winner = min(
+                    winners,
+                    key=lambda color: min(
+                        pluses[idx]["center"] for idx in adjacent_plus_ids if pluses[idx]["label_color"] == color
+                    ),
+                )
+            regions.append(
+                {
+                    "cells": cells,
+                    "adjacent_plus_ids": adjacent_plus_ids,
+                    "votes": votes,
+                    "winner": winner,
+                    "tie": tie,
+                }
+            )
+
+    counts = Counter(region["winner"] for region in regions if region["winner"] is not None)
+    return {
+        "legend": legend,
+        "pluses": pluses,
+        "connector_pairs": connector_pairs,
+        "connector_cells": connector_cells,
+        "regions": regions,
+        "counts": counts,
+    }
+
+
+def render_output(grid: np.ndarray, analysis: dict) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for r, c in analysis["connector_cells"]:
+        out[r, c] = GREY
+
+    r0, c0, r1, c1 = analysis["legend"]["bbox"]
+    out[r0 + 1 : r1, c0 + 1 : c1] = BLACK
+    key_col = analysis["legend"]["key_col"]
+    for color in KEY_COLORS:
+        row = analysis["legend"]["rows_by_color"][color]
+        count = int(analysis["counts"].get(color, 0))
+        for step in range(count):
+            out[row, key_col + 2 * step] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Draw diagonal plus-to-plus barriers, classify open regions by adjacent labeled pluses, and tally them in the legend.
+
+    Input structure:
+    - Black is the background.
+    - The main field contains 5-7 standard 5-pixel green plus objects whose centers are either green or one of the legend colors.
+    - A grey rectangular legend box sits in the lower-right area, with one blue, red, and yellow key pixel inside its leftmost keyed column.
+
+    Rule:
+    - For every pair of plus centers on the same 45-degree diagonal, fill the interior diagonal cells grey if and only if every interior cell is black.
+    - Treat all plus pixels, labeled centers, newly drawn grey diagonal cells, and the entire legend box as barriers; flood-fill the remaining black pixels into 4-connected open regions.
+    - For each region, collect the labeled pluses touched by the region's 8-neighborhood, vote by label color, and break color ties by the smallest adjacent plus-center row, then column.
+    - Keep the field unchanged except for the grey connectors, and rewrite the legend so each key row shows one dot per region assigned to that key color.
+
+    Key insight:
+    - The diagonal connectors are not decoration: together with the plus bodies they create the topology of the open regions, and the labeled plus centers then determine which legend row each region contributes to.
+    """
+    analysis = analyze_instance(np.asarray(grid, dtype=int), use_connectors=True)
+    return render_output(grid, analysis)
+
+
+def draw_legend(grid: np.ndarray, bbox: tuple[int, int, int, int], row_order: tuple[int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    key_col = c0 + 1
+    for rel_row, color in zip((1, 3, 5), row_order):
+        grid[r0 + rel_row, key_col] = color
+
+
+def draw_plus(grid: np.ndarray, center: tuple[int, int], label_color: int | None) -> None:
+    r, c = center
+    for dr, dc in PLUS_OFFSETS[1:]:
+        grid[r + dr, c + dc] = GREEN
+    grid[r, c] = GREEN if label_color is None else label_color
+
+
+def center_ok(center: tuple[int, int], legend_bbox: tuple[int, int, int, int], occupied: set[tuple[int, int]]) -> bool:
+    for cell in plus_cells(center):
+        if cell in occupied:
+            return False
+        r, c = cell
+        if r < 1 or c < 1:
+            return False
+        r0, c0, r1, c1 = legend_bbox
+        if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
+            return False
+    return True
+
+
+def instantiate_x_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    _r0, _c0, _r1, _c1 = legend_bbox
+    max_col = legend_bbox[1] - 3
+    for _ in range(80):
+        d = rng.choice((3, 4))
+        if max_col < 2 + 2 * d:
+            continue
+        hub = (
+            rng.randint(2 + d, h - 3 - d),
+            rng.randint(2 + d, max_col - d),
+        )
+        centers = [
+            hub,
+            (hub[0] - d, hub[1] - d),
+            (hub[0] - d, hub[1] + d),
+            (hub[0] + d, hub[1] - d),
+            (hub[0] + d, hub[1] + d),
+        ]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in centers):
+            for center in centers:
+                occupied.update(plus_cells(center))
+            return centers
+    return None
+
+
+def instantiate_chain_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    max_col = legend_bbox[1] - 3
+    if max_col < 14:
+        return None
+    for _ in range(80):
+        d = 3
+        start_r = rng.randint(2, h - 3 - d)
+        start_c = rng.randint(2, max_col - 4 * d)
+        flip = rng.choice((-1, 1))
+        base = [
+            (start_r, start_c),
+            (start_r + d, start_c + d),
+            (start_r, start_c + 2 * d),
+            (start_r + d, start_c + 3 * d),
+            (start_r, start_c + 4 * d),
+        ]
+        if flip < 0:
+            min_c = min(c for _, c in base)
+            max_c = max(c for _, c in base)
+            base = [(r, max_c - (c - min_c)) for r, c in base]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in base):
+            for center in base:
+                occupied.update(plus_cells(center))
+            return base
+    return None
+
+
+def add_extra_centers(
+    centers: list[tuple[int, int]],
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    out = list(centers)
+    occupied = set()
+    for center in out:
+        occupied.update(plus_cells(center))
+    temp = np.zeros(shape, dtype=int)
+    draw_legend(temp, legend_bbox, KEY_COLORS)
+    for center in out:
+        draw_plus(temp, center, None)
+    protected_connectors = diagonal_connectors(temp, [{"center": c} for c in out])[1]
+    target = rng.randint(5, 7)
+    while len(out) < target:
+        added = False
+        for _ in range(EXTRA_ATTEMPTS):
+            candidate = (rng.randint(2, shape[0] - 3), rng.randint(2, legend_bbox[1] - 3))
+            if not center_ok(candidate, legend_bbox, occupied):
+                continue
+            if plus_cells(candidate) & protected_connectors:
+                continue
+            if any(max(abs(candidate[0] - r), abs(candidate[1] - c)) < 3 for r, c in out):
+                continue
+            out.append(candidate)
+            occupied.update(plus_cells(candidate))
+            added = True
+            break
+        if not added:
+            break
+    return out
+
+
+def build_grid(
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    row_order: tuple[int, int, int],
+    centers: list[tuple[int, int]],
+    labels: list[int | None],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    draw_legend(grid, legend_bbox, row_order)
+    for center, label in zip(centers, labels):
+        draw_plus(grid, center, label)
+    return grid
+
+
+def choose_labels(centers: list[tuple[int, int]], rng: random.Random, *, want_unlabeled: bool) -> list[int | None]:
+    n = len(centers)
+    labels: list[int | None] = [None] * n
+    order = list(range(n))
+    rng.shuffle(order)
+    for idx, color in zip(order[:3], KEY_COLORS):
+        labels[idx] = color
+    remainder = order[3:]
+    if want_unlabeled and remainder:
+        unlabeled_need = rng.randint(1, min(2, len(remainder)))
+        unlabeled_idxs = set(rng.sample(remainder, unlabeled_need))
+    else:
+        unlabeled_idxs = set()
+    for idx in remainder:
+        if idx in unlabeled_idxs:
+            labels[idx] = None
+        else:
+            labels[idx] = rng.choice(KEY_COLORS)
+    if not want_unlabeled and all(label is not None for label in labels) and rng.random() < 0.25:
+        labels[rng.randrange(n)] = None
+        missing = [color for color in KEY_COLORS if color not in labels]
+        if missing:
+            alt = rng.choice([i for i, color in enumerate(labels) if color is None or color in KEY_COLORS])
+            labels[alt] = missing[0]
+    return labels
+
+
+def validate_semantics(grid: np.ndarray, *, want_tie: bool, want_unlabeled: bool) -> bool:
+    try:
+        analysis = analyze_instance(grid, use_connectors=True)
+        no_line = analyze_instance(grid, use_connectors=False)
+        out = main(grid)
+    except AssertionError:
+        return False
+
+    plus_labels = [plus["label_color"] for plus in analysis["pluses"]]
+    if set(color for color in plus_labels if color is not None) != set(KEY_COLORS):
+        return False
+    if want_unlabeled and all(color is not None for color in plus_labels):
+        return False
+    if len(analysis["connector_pairs"]) < 2:
+        return False
+    if len(analysis["regions"]) < 4:
+        return False
+    if any(not region["votes"] for region in analysis["regions"]):
+        return False
+    if not any(len(region["votes"]) >= 2 for region in analysis["regions"]):
+        return False
+    if want_tie:
+        if not any(region["tie"] for region in analysis["regions"]):
+            return False
+    else:
+        if not any((not region["tie"]) and len(region["votes"]) >= 2 for region in analysis["regions"]):
+            return False
+    counts = analysis["counts"]
+    if any(int(counts.get(color, 0)) < 1 for color in KEY_COLORS):
+        return False
+    if max(int(counts[color]) for color in KEY_COLORS) > analysis["legend"]["slots"]:
+        return False
+    if len(analysis["regions"]) == len(no_line["regions"]) and counts == no_line["counts"]:
+        return False
+
+    legend = analysis["legend"]
+    r0, c0, r1, c1 = legend["bbox"]
+    interior = out[r0 + 1 : r1, c0 + 1 : c1]
+    if (interior == GREY).any():
+        return False
+    for color in KEY_COLORS:
+        row = legend["rows_by_color"][color]
+        expected = int(counts[color])
+        seen = [int(out[row, legend["key_col"] + 2 * k]) for k in range(expected)]
+        if seen != [color] * expected:
+            return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for attempt in range(GEN_ATTEMPTS):
+        h = rng.randint(*ROW_RANGE)
+        w = rng.randint(*COL_RANGE)
+        legend_bbox = (h - LEGEND_H - 1, w - LEGEND_W - 1, h - 2, w - 2)
+        row_order = tuple(rng.sample(KEY_COLORS, len(KEY_COLORS)))
+
+        builders = [instantiate_x_template]
+        if w >= 27:
+            builders.append(instantiate_chain_template)
+        rng.shuffle(builders)
+        centers = None
+        for builder in builders:
+            centers = builder((h, w), legend_bbox, rng)
+            if centers is not None:
+                break
+        if centers is None:
+            continue
+        centers = add_extra_centers(centers, (h, w), legend_bbox, rng)
+        centers.sort()
+
+        want_tie = attempt % 2 == 0
+        want_unlabeled = attempt % 3 == 0
+        for _ in range(LABEL_ATTEMPTS):
+            labels = choose_labels(centers, rng, want_unlabeled=want_unlabeled)
+            grid = build_grid((h, w), legend_bbox, row_order, centers, labels)
+            if validate_semantics(grid, want_tie=want_tie, want_unlabeled=want_unlabeled):
+                return grid
+    raise RuntimeError("failed to generate valid input")

diff --git a/key_combo/code/opus/12/043/3.py b/key_combo/code/opus/12/043/3.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ee35e41052a67ff9e23459dda1931fa6023e357
--- /dev/null
+++ b/key_combo/code/opus/12/043/3.py
@@ -0,0 +1,527 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+KEY_COLORS = (BLUE, RED, YELLOW)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LABEL_ATTEMPTS = 220
+EXTRA_ATTEMPTS = 120
+ROW_RANGE = (18, 22)
+COL_RANGE = (26, 29)
+LEGEND_H = 7
+LEGEND_W = 9
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components(mask: np.ndarray, *, conn8: bool) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    neigh = neighbors8 if conn8 else neighbors4
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neigh(cr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def plus_cells(center: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = center
+    return {(r + dr, c + dc) for dr, dc in PLUS_OFFSETS}
+
+
+def find_legend(grid: np.ndarray) -> dict:
+    candidates = []
+    for comp in components(grid == GREY, conn8=False):
+        if comp.shape[0] < 16:
+            continue
+        r0, c0, r1, c1 = bbox_coords(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        if int(comp.shape[0]) != 2 * (h + w) - 4:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not (sub[0, :] == GREY).all():
+            continue
+        if not (sub[-1, :] == GREY).all():
+            continue
+        if not (sub[:, 0] == GREY).all():
+            continue
+        if not (sub[:, -1] == GREY).all():
+            continue
+        if (sub[1:-1, 1:-1] == GREY).any():
+            continue
+        key_col = None
+        for rel_c in range(1, w - 1):
+            if (sub[1:-1, rel_c] != BLACK).any():
+                key_col = c0 + rel_c
+                break
+        if key_col is None:
+            continue
+        rows_by_color: dict[int, int] = {}
+        for rr in range(r0 + 1, r1):
+            color = int(grid[rr, key_col])
+            if color != BLACK:
+                rows_by_color[color] = rr
+        if set(rows_by_color) != set(KEY_COLORS):
+            continue
+        candidates.append((h * w, r1, c1, r0, c0, r1, c1, key_col, rows_by_color))
+    assert candidates, "legend box not found"
+    _area, _r1, _c1, r0, c0, r1, c1, key_col, rows_by_color = max(candidates)
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "key_col": key_col,
+        "rows_by_color": rows_by_color,
+        "slots": len(range(key_col, c1, 2)),
+    }
+
+
+def find_pluses(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    pluses = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r - 1, c]) != GREEN or int(grid[r + 1, c]) != GREEN:
+                continue
+            if int(grid[r, c - 1]) != GREEN or int(grid[r, c + 1]) != GREEN:
+                continue
+            center_color = int(grid[r, c])
+            if center_color not in (GREEN, BLUE, RED, YELLOW):
+                continue
+            label_color = center_color if center_color in KEY_COLORS else None
+            pluses.append(
+                {
+                    "center": (r, c),
+                    "label_color": label_color,
+                    "pixels": plus_cells((r, c)),
+                }
+            )
+    pluses.sort(key=lambda item: item["center"])
+    assert 5 <= len(pluses) <= 7, "expected 5-7 pluses"
+    return pluses
+
+
+def diagonal_connectors(grid: np.ndarray, pluses: list[dict]) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    pairs: list[tuple[int, int]] = []
+    connector_cells: set[tuple[int, int]] = set()
+    for i, plus_a in enumerate(pluses):
+        r1, c1 = plus_a["center"]
+        for j in range(i + 1, len(pluses)):
+            r2, c2 = pluses[j]["center"]
+            dr = r2 - r1
+            dc = c2 - c1
+            if abs(dr) != abs(dc):
+                continue
+            sr = 1 if dr > 0 else -1
+            sc = 1 if dc > 0 else -1
+            gap = [(r1 + k * sr, c1 + k * sc) for k in range(1, abs(dr))]
+            if all(int(grid[r, c]) == BLACK for r, c in gap):
+                pairs.append((i, j))
+                connector_cells.update(gap)
+    return pairs, connector_cells
+
+
+def analyze_instance(grid: np.ndarray, *, use_connectors: bool = True) -> dict:
+    g = np.asarray(grid, dtype=int)
+    legend = find_legend(g)
+    pluses = find_pluses(g)
+    connector_pairs, connector_cells = diagonal_connectors(g, pluses) if use_connectors else ([], set())
+
+    plus_pixel_owner: dict[tuple[int, int], int] = {}
+    barrier = np.zeros_like(g, dtype=bool)
+    for idx, plus in enumerate(pluses):
+        for r, c in plus["pixels"]:
+            plus_pixel_owner[(r, c)] = idx
+            barrier[r, c] = True
+    for r, c in connector_cells:
+        barrier[r, c] = True
+    r0, c0, r1, c1 = legend["bbox"]
+    barrier[r0 : r1 + 1, c0 : c1 + 1] = True
+
+    passable = (g == BLACK) & ~barrier
+    seen = np.zeros_like(passable, dtype=bool)
+    regions = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            if not passable[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            adjacent_plus_ids: set[int] = set()
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if in_bounds(g.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                for nr, nc in neighbors8(cr, cc):
+                    owner = plus_pixel_owner.get((nr, nc))
+                    if owner is not None and pluses[owner]["label_color"] is not None:
+                        adjacent_plus_ids.add(owner)
+
+            votes = Counter(pluses[idx]["label_color"] for idx in adjacent_plus_ids)
+            tie = False
+            winner = None
+            if votes:
+                max_count = max(votes.values())
+                winners = [color for color, count in votes.items() if count == max_count]
+                if len(winners) > 1:
+                    tie = True
+                winner = min(
+                    winners,
+                    key=lambda color: min(
+                        pluses[idx]["center"] for idx in adjacent_plus_ids if pluses[idx]["label_color"] == color
+                    ),
+                )
+            regions.append(
+                {
+                    "cells": cells,
+                    "adjacent_plus_ids": adjacent_plus_ids,
+                    "votes": votes,
+                    "winner": winner,
+                    "tie": tie,
+                }
+            )
+
+    counts = Counter(region["winner"] for region in regions if region["winner"] is not None)
+    return {
+        "legend": legend,
+        "pluses": pluses,
+        "connector_pairs": connector_pairs,
+        "connector_cells": connector_cells,
+        "regions": regions,
+        "counts": counts,
+    }
+
+
+def render_output(grid: np.ndarray, analysis: dict) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for r, c in analysis["connector_cells"]:
+        out[r, c] = GREY
+
+    r0, c0, r1, c1 = analysis["legend"]["bbox"]
+    out[r0 + 1 : r1, c0 + 1 : c1] = BLACK
+    key_col = analysis["legend"]["key_col"]
+    for color in KEY_COLORS:
+        row = analysis["legend"]["rows_by_color"][color]
+        count = int(analysis["counts"].get(color, 0))
+        for step in range(count):
+            out[row, key_col + 2 * step] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Draw diagonal plus-to-plus barriers, classify open regions by adjacent labeled pluses, and tally them in the legend.
+
+    Input structure:
+    - Black is the background.
+    - The main field contains 5-7 standard 5-pixel green plus objects whose centers are either green or one of the legend colors.
+    - A grey rectangular legend box sits in the lower-right area, with one blue, red, and yellow key pixel inside its leftmost keyed column.
+
+    Rule:
+    - For every pair of plus centers on the same 45-degree diagonal, fill the interior diagonal cells grey if and only if every interior cell is black.
+    - Treat all plus pixels, labeled centers, newly drawn grey diagonal cells, and the entire legend box as barriers; flood-fill the remaining black pixels into 4-connected open regions.
+    - For each region, collect the labeled pluses touched by the region's 8-neighborhood, vote by label color, and break color ties by the smallest adjacent plus-center row, then column.
+    - Keep the field unchanged except for the grey connectors, and rewrite the legend so each key row shows one dot per region assigned to that key color.
+
+    Key insight:
+    - The diagonal connectors are not decoration: together with the plus bodies they create the topology of the open regions, and the labeled plus centers then determine which legend row each region contributes to.
+    """
+    analysis = analyze_instance(np.asarray(grid, dtype=int), use_connectors=True)
+    return render_output(grid, analysis)
+
+
+def draw_legend(grid: np.ndarray, bbox: tuple[int, int, int, int], row_order: tuple[int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    key_col = c0 + 1
+    for rel_row, color in zip((1, 3, 5), row_order):
+        grid[r0 + rel_row, key_col] = color
+
+
+def draw_plus(grid: np.ndarray, center: tuple[int, int], label_color: int | None) -> None:
+    r, c = center
+    for dr, dc in PLUS_OFFSETS[1:]:
+        grid[r + dr, c + dc] = GREEN
+    grid[r, c] = GREEN if label_color is None else label_color
+
+
+def center_ok(center: tuple[int, int], legend_bbox: tuple[int, int, int, int], occupied: set[tuple[int, int]]) -> bool:
+    for cell in plus_cells(center):
+        if cell in occupied:
+            return False
+        r, c = cell
+        if r < 1 or c < 1:
+            return False
+        r0, c0, r1, c1 = legend_bbox
+        if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
+            return False
+    return True
+
+
+def instantiate_x_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    _r0, _c0, _r1, _c1 = legend_bbox
+    max_col = legend_bbox[1] - 3
+    for _ in range(80):
+        d = rng.choice((3, 4))
+        if max_col < 2 + 2 * d:
+            continue
+        hub = (
+            rng.randint(2 + d, h - 3 - d),
+            rng.randint(2 + d, max_col - d),
+        )
+        centers = [
+            hub,
+            (hub[0] - d, hub[1] - d),
+            (hub[0] - d, hub[1] + d),
+            (hub[0] + d, hub[1] - d),
+            (hub[0] + d, hub[1] + d),
+        ]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in centers):
+            for center in centers:
+                occupied.update(plus_cells(center))
+            return centers
+    return None
+
+
+def instantiate_chain_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    max_col = legend_bbox[1] - 3
+    if max_col < 14:
+        return None
+    for _ in range(80):
+        d = 3
+        start_r = rng.randint(2, h - 3 - d)
+        start_c = rng.randint(2, max_col - 4 * d)
+        flip = rng.choice((-1, 1))
+        base = [
+            (start_r, start_c),
+            (start_r + d, start_c + d),
+            (start_r, start_c + 2 * d),
+            (start_r + d, start_c + 3 * d),
+            (start_r, start_c + 4 * d),
+        ]
+        if flip < 0:
+            min_c = min(c for _, c in base)
+            max_c = max(c for _, c in base)
+            base = [(r, max_c - (c - min_c)) for r, c in base]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in base):
+            for center in base:
+                occupied.update(plus_cells(center))
+            return base
+    return None
+
+
+def add_extra_centers(
+    centers: list[tuple[int, int]],
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    out = list(centers)
+    occupied = set()
+    for center in out:
+        occupied.update(plus_cells(center))
+    temp = np.zeros(shape, dtype=int)
+    draw_legend(temp, legend_bbox, KEY_COLORS)
+    for center in out:
+        draw_plus(temp, center, None)
+    protected_connectors = diagonal_connectors(temp, [{"center": c} for c in out])[1]
+    target = rng.randint(5, 7)
+    while len(out) < target:
+        added = False
+        for _ in range(EXTRA_ATTEMPTS):
+            candidate = (rng.randint(2, shape[0] - 3), rng.randint(2, legend_bbox[1] - 3))
+            if not center_ok(candidate, legend_bbox, occupied):
+                continue
+            if plus_cells(candidate) & protected_connectors:
+                continue
+            if any(max(abs(candidate[0] - r), abs(candidate[1] - c)) < 3 for r, c in out):
+                continue
+            out.append(candidate)
+            occupied.update(plus_cells(candidate))
+            added = True
+            break
+        if not added:
+            break
+    return out
+
+
+def build_grid(
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    row_order: tuple[int, int, int],
+    centers: list[tuple[int, int]],
+    labels: list[int | None],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    draw_legend(grid, legend_bbox, row_order)
+    for center, label in zip(centers, labels):
+        draw_plus(grid, center, label)
+    return grid
+
+
+def choose_labels(centers: list[tuple[int, int]], rng: random.Random, *, want_unlabeled: bool) -> list[int | None]:
+    n = len(centers)
+    labels: list[int | None] = [None] * n
+    order = list(range(n))
+    rng.shuffle(order)
+    for idx, color in zip(order[:3], KEY_COLORS):
+        labels[idx] = color
+    remainder = order[3:]
+    if want_unlabeled and remainder:
+        unlabeled_need = rng.randint(1, min(2, len(remainder)))
+        unlabeled_idxs = set(rng.sample(remainder, unlabeled_need))
+    else:
+        unlabeled_idxs = set()
+    for idx in remainder:
+        if idx in unlabeled_idxs:
+            labels[idx] = None
+        else:
+            labels[idx] = rng.choice(KEY_COLORS)
+    if not want_unlabeled and all(label is not None for label in labels) and rng.random() < 0.25:
+        labels[rng.randrange(n)] = None
+        missing = [color for color in KEY_COLORS if color not in labels]
+        if missing:
+            alt = rng.choice([i for i, color in enumerate(labels) if color is None or color in KEY_COLORS])
+            labels[alt] = missing[0]
+    return labels
+
+
+def validate_semantics(grid: np.ndarray, *, want_tie: bool, want_unlabeled: bool) -> bool:
+    try:
+        analysis = analyze_instance(grid, use_connectors=True)
+        no_line = analyze_instance(grid, use_connectors=False)
+        out = main(grid)
+    except AssertionError:
+        return False
+
+    plus_labels = [plus["label_color"] for plus in analysis["pluses"]]
+    if set(color for color in plus_labels if color is not None) != set(KEY_COLORS):
+        return False
+    if want_unlabeled and all(color is not None for color in plus_labels):
+        return False
+    if len(analysis["connector_pairs"]) < 2:
+        return False
+    if len(analysis["regions"]) < 4:
+        return False
+    if any(not region["votes"] for region in analysis["regions"]):
+        return False
+    if not any(len(region["votes"]) >= 2 for region in analysis["regions"]):
+        return False
+    if want_tie:
+        if not any(region["tie"] for region in analysis["regions"]):
+            return False
+    else:
+        if not any((not region["tie"]) and len(region["votes"]) >= 2 for region in analysis["regions"]):
+            return False
+    counts = analysis["counts"]
+    if any(int(counts.get(color, 0)) < 1 for color in KEY_COLORS):
+        return False
+    if max(int(counts[color]) for color in KEY_COLORS) > analysis["legend"]["slots"]:
+        return False
+    if len(analysis["regions"]) == len(no_line["regions"]) and counts == no_line["counts"]:
+        return False
+
+    legend = analysis["legend"]
+    r0, c0, r1, c1 = legend["bbox"]
+    interior = out[r0 + 1 : r1, c0 + 1 : c1]
+    if (interior == GREY).any():
+        return False
+    for color in KEY_COLORS:
+        row = legend["rows_by_color"][color]
+        expected = int(counts[color])
+        seen = [int(out[row, legend["key_col"] + 2 * k]) for k in range(expected)]
+        if seen != [color] * expected:
+            return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for attempt in range(GEN_ATTEMPTS):
+        h = rng.randint(*ROW_RANGE)
+        w = rng.randint(*COL_RANGE)
+        legend_bbox = (h - LEGEND_H - 1, w - LEGEND_W - 1, h - 2, w - 2)
+        row_order = tuple(rng.sample(KEY_COLORS, len(KEY_COLORS)))
+
+        builders = [instantiate_x_template]
+        if w >= 27:
+            builders.append(instantiate_chain_template)
+        rng.shuffle(builders)
+        centers = None
+        for builder in builders:
+            centers = builder((h, w), legend_bbox, rng)
+            if centers is not None:
+                break
+        if centers is None:
+            continue
+        centers = add_extra_centers(centers, (h, w), legend_bbox, rng)
+        centers.sort()
+
+        want_tie = attempt % 2 == 0
+        want_unlabeled = attempt % 3 == 0
+        for _ in range(LABEL_ATTEMPTS):
+            labels = choose_labels(centers, rng, want_unlabeled=want_unlabeled)
+            grid = build_grid((h, w), legend_bbox, row_order, centers, labels)
+            if validate_semantics(grid, want_tie=want_tie, want_unlabeled=want_unlabeled):
+                return grid
+    raise RuntimeError("failed to generate valid input")

diff --git a/key_combo/code/opus/12/043/3.py b/key_combo/code/opus/12/043/3.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ee35e41052a67ff9e23459dda1931fa6023e357
--- /dev/null
+++ b/key_combo/code/opus/12/043/3.py
@@ -0,0 +1,527 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+KEY_COLORS = (BLUE, RED, YELLOW)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LABEL_ATTEMPTS = 220
+EXTRA_ATTEMPTS = 120
+ROW_RANGE = (18, 22)
+COL_RANGE = (26, 29)
+LEGEND_H = 7
+LEGEND_W = 9
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components(mask: np.ndarray, *, conn8: bool) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    neigh = neighbors8 if conn8 else neighbors4
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neigh(cr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def plus_cells(center: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = center
+    return {(r + dr, c + dc) for dr, dc in PLUS_OFFSETS}
+
+
+def find_legend(grid: np.ndarray) -> dict:
+    candidates = []
+    for comp in components(grid == GREY, conn8=False):
+        if comp.shape[0] < 16:
+            continue
+        r0, c0, r1, c1 = bbox_coords(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        if int(comp.shape[0]) != 2 * (h + w) - 4:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not (sub[0, :] == GREY).all():
+            continue
+        if not (sub[-1, :] == GREY).all():
+            continue
+        if not (sub[:, 0] == GREY).all():
+            continue
+        if not (sub[:, -1] == GREY).all():
+            continue
+        if (sub[1:-1, 1:-1] == GREY).any():
+            continue
+        key_col = None
+        for rel_c in range(1, w - 1):
+            if (sub[1:-1, rel_c] != BLACK).any():
+                key_col = c0 + rel_c
+                break
+        if key_col is None:
+            continue
+        rows_by_color: dict[int, int] = {}
+        for rr in range(r0 + 1, r1):
+            color = int(grid[rr, key_col])
+            if color != BLACK:
+                rows_by_color[color] = rr
+        if set(rows_by_color) != set(KEY_COLORS):
+            continue
+        candidates.append((h * w, r1, c1, r0, c0, r1, c1, key_col, rows_by_color))
+    assert candidates, "legend box not found"
+    _area, _r1, _c1, r0, c0, r1, c1, key_col, rows_by_color = max(candidates)
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "key_col": key_col,
+        "rows_by_color": rows_by_color,
+        "slots": len(range(key_col, c1, 2)),
+    }
+
+
+def find_pluses(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    pluses = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r - 1, c]) != GREEN or int(grid[r + 1, c]) != GREEN:
+                continue
+            if int(grid[r, c - 1]) != GREEN or int(grid[r, c + 1]) != GREEN:
+                continue
+            center_color = int(grid[r, c])
+            if center_color not in (GREEN, BLUE, RED, YELLOW):
+                continue
+            label_color = center_color if center_color in KEY_COLORS else None
+            pluses.append(
+                {
+                    "center": (r, c),
+                    "label_color": label_color,
+                    "pixels": plus_cells((r, c)),
+                }
+            )
+    pluses.sort(key=lambda item: item["center"])
+    assert 5 <= len(pluses) <= 7, "expected 5-7 pluses"
+    return pluses
+
+
+def diagonal_connectors(grid: np.ndarray, pluses: list[dict]) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    pairs: list[tuple[int, int]] = []
+    connector_cells: set[tuple[int, int]] = set()
+    for i, plus_a in enumerate(pluses):
+        r1, c1 = plus_a["center"]
+        for j in range(i + 1, len(pluses)):
+            r2, c2 = pluses[j]["center"]
+            dr = r2 - r1
+            dc = c2 - c1
+            if abs(dr) != abs(dc):
+                continue
+            sr = 1 if dr > 0 else -1
+            sc = 1 if dc > 0 else -1
+            gap = [(r1 + k * sr, c1 + k * sc) for k in range(1, abs(dr))]
+            if all(int(grid[r, c]) == BLACK for r, c in gap):
+                pairs.append((i, j))
+                connector_cells.update(gap)
+    return pairs, connector_cells
+
+
+def analyze_instance(grid: np.ndarray, *, use_connectors: bool = True) -> dict:
+    g = np.asarray(grid, dtype=int)
+    legend = find_legend(g)
+    pluses = find_pluses(g)
+    connector_pairs, connector_cells = diagonal_connectors(g, pluses) if use_connectors else ([], set())
+
+    plus_pixel_owner: dict[tuple[int, int], int] = {}
+    barrier = np.zeros_like(g, dtype=bool)
+    for idx, plus in enumerate(pluses):
+        for r, c in plus["pixels"]:
+            plus_pixel_owner[(r, c)] = idx
+            barrier[r, c] = True
+    for r, c in connector_cells:
+        barrier[r, c] = True
+    r0, c0, r1, c1 = legend["bbox"]
+    barrier[r0 : r1 + 1, c0 : c1 + 1] = True
+
+    passable = (g == BLACK) & ~barrier
+    seen = np.zeros_like(passable, dtype=bool)
+    regions = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            if not passable[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            adjacent_plus_ids: set[int] = set()
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if in_bounds(g.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                for nr, nc in neighbors8(cr, cc):
+                    owner = plus_pixel_owner.get((nr, nc))
+                    if owner is not None and pluses[owner]["label_color"] is not None:
+                        adjacent_plus_ids.add(owner)
+
+            votes = Counter(pluses[idx]["label_color"] for idx in adjacent_plus_ids)
+            tie = False
+            winner = None
+            if votes:
+                max_count = max(votes.values())
+                winners = [color for color, count in votes.items() if count == max_count]
+                if len(winners) > 1:
+                    tie = True
+                winner = min(
+                    winners,
+                    key=lambda color: min(
+                        pluses[idx]["center"] for idx in adjacent_plus_ids if pluses[idx]["label_color"] == color
+                    ),
+                )
+            regions.append(
+                {
+                    "cells": cells,
+                    "adjacent_plus_ids": adjacent_plus_ids,
+                    "votes": votes,
+                    "winner": winner,
+                    "tie": tie,
+                }
+            )
+
+    counts = Counter(region["winner"] for region in regions if region["winner"] is not None)
+    return {
+        "legend": legend,
+        "pluses": pluses,
+        "connector_pairs": connector_pairs,
+        "connector_cells": connector_cells,
+        "regions": regions,
+        "counts": counts,
+    }
+
+
+def render_output(grid: np.ndarray, analysis: dict) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for r, c in analysis["connector_cells"]:
+        out[r, c] = GREY
+
+    r0, c0, r1, c1 = analysis["legend"]["bbox"]
+    out[r0 + 1 : r1, c0 + 1 : c1] = BLACK
+    key_col = analysis["legend"]["key_col"]
+    for color in KEY_COLORS:
+        row = analysis["legend"]["rows_by_color"][color]
+        count = int(analysis["counts"].get(color, 0))
+        for step in range(count):
+            out[row, key_col + 2 * step] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Draw diagonal plus-to-plus barriers, classify open regions by adjacent labeled pluses, and tally them in the legend.
+
+    Input structure:
+    - Black is the background.
+    - The main field contains 5-7 standard 5-pixel green plus objects whose centers are either green or one of the legend colors.
+    - A grey rectangular legend box sits in the lower-right area, with one blue, red, and yellow key pixel inside its leftmost keyed column.
+
+    Rule:
+    - For every pair of plus centers on the same 45-degree diagonal, fill the interior diagonal cells grey if and only if every interior cell is black.
+    - Treat all plus pixels, labeled centers, newly drawn grey diagonal cells, and the entire legend box as barriers; flood-fill the remaining black pixels into 4-connected open regions.
+    - For each region, collect the labeled pluses touched by the region's 8-neighborhood, vote by label color, and break color ties by the smallest adjacent plus-center row, then column.
+    - Keep the field unchanged except for the grey connectors, and rewrite the legend so each key row shows one dot per region assigned to that key color.
+
+    Key insight:
+    - The diagonal connectors are not decoration: together with the plus bodies they create the topology of the open regions, and the labeled plus centers then determine which legend row each region contributes to.
+    """
+    analysis = analyze_instance(np.asarray(grid, dtype=int), use_connectors=True)
+    return render_output(grid, analysis)
+
+
+def draw_legend(grid: np.ndarray, bbox: tuple[int, int, int, int], row_order: tuple[int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    key_col = c0 + 1
+    for rel_row, color in zip((1, 3, 5), row_order):
+        grid[r0 + rel_row, key_col] = color
+
+
+def draw_plus(grid: np.ndarray, center: tuple[int, int], label_color: int | None) -> None:
+    r, c = center
+    for dr, dc in PLUS_OFFSETS[1:]:
+        grid[r + dr, c + dc] = GREEN
+    grid[r, c] = GREEN if label_color is None else label_color
+
+
+def center_ok(center: tuple[int, int], legend_bbox: tuple[int, int, int, int], occupied: set[tuple[int, int]]) -> bool:
+    for cell in plus_cells(center):
+        if cell in occupied:
+            return False
+        r, c = cell
+        if r < 1 or c < 1:
+            return False
+        r0, c0, r1, c1 = legend_bbox
+        if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
+            return False
+    return True
+
+
+def instantiate_x_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    _r0, _c0, _r1, _c1 = legend_bbox
+    max_col = legend_bbox[1] - 3
+    for _ in range(80):
+        d = rng.choice((3, 4))
+        if max_col < 2 + 2 * d:
+            continue
+        hub = (
+            rng.randint(2 + d, h - 3 - d),
+            rng.randint(2 + d, max_col - d),
+        )
+        centers = [
+            hub,
+            (hub[0] - d, hub[1] - d),
+            (hub[0] - d, hub[1] + d),
+            (hub[0] + d, hub[1] - d),
+            (hub[0] + d, hub[1] + d),
+        ]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in centers):
+            for center in centers:
+                occupied.update(plus_cells(center))
+            return centers
+    return None
+
+
+def instantiate_chain_template(shape: tuple[int, int], legend_bbox: tuple[int, int, int, int], rng: random.Random):
+    h, w = shape
+    max_col = legend_bbox[1] - 3
+    if max_col < 14:
+        return None
+    for _ in range(80):
+        d = 3
+        start_r = rng.randint(2, h - 3 - d)
+        start_c = rng.randint(2, max_col - 4 * d)
+        flip = rng.choice((-1, 1))
+        base = [
+            (start_r, start_c),
+            (start_r + d, start_c + d),
+            (start_r, start_c + 2 * d),
+            (start_r + d, start_c + 3 * d),
+            (start_r, start_c + 4 * d),
+        ]
+        if flip < 0:
+            min_c = min(c for _, c in base)
+            max_c = max(c for _, c in base)
+            base = [(r, max_c - (c - min_c)) for r, c in base]
+        occupied: set[tuple[int, int]] = set()
+        if all(center_ok(center, legend_bbox, occupied) for center in base):
+            for center in base:
+                occupied.update(plus_cells(center))
+            return base
+    return None
+
+
+def add_extra_centers(
+    centers: list[tuple[int, int]],
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    out = list(centers)
+    occupied = set()
+    for center in out:
+        occupied.update(plus_cells(center))
+    temp = np.zeros(shape, dtype=int)
+    draw_legend(temp, legend_bbox, KEY_COLORS)
+    for center in out:
+        draw_plus(temp, center, None)
+    protected_connectors = diagonal_connectors(temp, [{"center": c} for c in out])[1]
+    target = rng.randint(5, 7)
+    while len(out) < target:
+        added = False
+        for _ in range(EXTRA_ATTEMPTS):
+            candidate = (rng.randint(2, shape[0] - 3), rng.randint(2, legend_bbox[1] - 3))
+            if not center_ok(candidate, legend_bbox, occupied):
+                continue
+            if plus_cells(candidate) & protected_connectors:
+                continue
+            if any(max(abs(candidate[0] - r), abs(candidate[1] - c)) < 3 for r, c in out):
+                continue
+            out.append(candidate)
+            occupied.update(plus_cells(candidate))
+            added = True
+            break
+        if not added:
+            break
+    return out
+
+
+def build_grid(
+    shape: tuple[int, int],
+    legend_bbox: tuple[int, int, int, int],
+    row_order: tuple[int, int, int],
+    centers: list[tuple[int, int]],
+    labels: list[int | None],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    draw_legend(grid, legend_bbox, row_order)
+    for center, label in zip(centers, labels):
+        draw_plus(grid, center, label)
+    return grid
+
+
+def choose_labels(centers: list[tuple[int, int]], rng: random.Random, *, want_unlabeled: bool) -> list[int | None]:
+    n = len(centers)
+    labels: list[int | None] = [None] * n
+    order = list(range(n))
+    rng.shuffle(order)
+    for idx, color in zip(order[:3], KEY_COLORS):
+        labels[idx] = color
+    remainder = order[3:]
+    if want_unlabeled and remainder:
+        unlabeled_need = rng.randint(1, min(2, len(remainder)))
+        unlabeled_idxs = set(rng.sample(remainder, unlabeled_need))
+    else:
+        unlabeled_idxs = set()
+    for idx in remainder:
+        if idx in unlabeled_idxs:
+            labels[idx] = None
+        else:
+            labels[idx] = rng.choice(KEY_COLORS)
+    if not want_unlabeled and all(label is not None for label in labels) and rng.random() < 0.25:
+        labels[rng.randrange(n)] = None
+        missing = [color for color in KEY_COLORS if color not in labels]
+        if missing:
+            alt = rng.choice([i for i, color in enumerate(labels) if color is None or color in KEY_COLORS])
+            labels[alt] = missing[0]
+    return labels
+
+
+def validate_semantics(grid: np.ndarray, *, want_tie: bool, want_unlabeled: bool) -> bool:
+    try:
+        analysis = analyze_instance(grid, use_connectors=True)
+        no_line = analyze_instance(grid, use_connectors=False)
+        out = main(grid)
+    except AssertionError:
+        return False
+
+    plus_labels = [plus["label_color"] for plus in analysis["pluses"]]
+    if set(color for color in plus_labels if color is not None) != set(KEY_COLORS):
+        return False
+    if want_unlabeled and all(color is not None for color in plus_labels):
+        return False
+    if len(analysis["connector_pairs"]) < 2:
+        return False
+    if len(analysis["regions"]) < 4:
+        return False
+    if any(not region["votes"] for region in analysis["regions"]):
+        return False
+    if not any(len(region["votes"]) >= 2 for region in analysis["regions"]):
+        return False
+    if want_tie:
+        if not any(region["tie"] for region in analysis["regions"]):
+            return False
+    else:
+        if not any((not region["tie"]) and len(region["votes"]) >= 2 for region in analysis["regions"]):
+            return False
+    counts = analysis["counts"]
+    if any(int(counts.get(color, 0)) < 1 for color in KEY_COLORS):
+        return False
+    if max(int(counts[color]) for color in KEY_COLORS) > analysis["legend"]["slots"]:
+        return False
+    if len(analysis["regions"]) == len(no_line["regions"]) and counts == no_line["counts"]:
+        return False
+
+    legend = analysis["legend"]
+    r0, c0, r1, c1 = legend["bbox"]
+    interior = out[r0 + 1 : r1, c0 + 1 : c1]
