+def _alternating_recolor(core: np.ndarray, marker_color: int) -> np.ndarray:
+    out = core.copy()
+    coords = np.argwhere(out != BACKGROUND)
+    for index, (r, c) in enumerate(coords, start=1):
+        if index % 2 == 1:
+            out[int(r), int(c)] = marker_color
+    return out
