+            for r, c in mover:
+                manual[r, c] = BG
+            for r, c in shifted:
+                manual[r, c] = color
+        return np.array_equal(produced, manual)
+    except Exception:
+        return False
+
+
+def _attempt() -> np.ndarray | None:
