+
+def _find_square(grid: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(grid == SQUARE)
+    assert coords.shape[0] == 9, "expected one grey 3x3 square"
+    r0, c0 = coords.min(axis=0)
