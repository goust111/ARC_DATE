+    color: int,
+    ray_length: int,
+    rect_side: int,
+    bar_len: int,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]], set[tuple[int, int]]] | None:
+    h, w = grid.shape
+    rm, cm = center
+    axis = "v" if direction in ("left", "right") else "h"
+    sign = 1 if direction in ("right", "down") else -1
+    gap = ray_length + rect_side
+    if gap < 2:
+        return None
+
+    for _ in range(80):
+        if direction == "right":
