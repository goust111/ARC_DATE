+
+def _ray_lengths(grid: np.ndarray, square_bbox: tuple[int, int, int, int]) -> dict[str, int]:
+    h, w = grid.shape
+    r0, c0, r1, c1 = square_bbox
+    rm = r0 + 1
+    cm = c0 + 1
+    starts = {
+        "up": (r0 - 1, cm, -1, 0),
+        "down": (r1 + 1, cm, 1, 0),
+        "left": (rm, c0 - 1, 0, -1),
+        "right": (rm, c1 + 1, 0, 1),
