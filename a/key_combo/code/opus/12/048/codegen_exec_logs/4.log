+            anchor_axis = random.randint(cm + 4, w - gap - 2)
+            anchor = _bar_cells(axis, start_r, anchor_axis, bar_len)
+            mover = _shift_cells(anchor, 0, gap)
+        elif direction == "left":
+            start_r = random.randint(max(0, rm - 3), min(h - bar_len, rm + 2))
+            anchor_axis = random.randint(gap + 1, cm - 4)
+            anchor = _bar_cells(axis, start_r, anchor_axis, bar_len)
+            mover = _shift_cells(anchor, 0, -gap)
+        elif direction == "down":
+            start_c = random.randint(max(0, cm - 3), min(w - bar_len, cm + 2))
+            anchor_axis = random.randint(rm + 4, h - gap - 2)
+            anchor = _bar_cells(axis, anchor_axis, start_c, bar_len)
+            mover = _shift_cells(anchor, gap, 0)
+        else:
