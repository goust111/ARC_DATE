+    h, w = grid.shape
+    rm, cm = center
+    axis = "v" if direction in ("left", "right") else "h"
+    sign = 1 if direction in ("right", "down") else -1
+    gap = ray_length + rect_side
+    if gap < 2:
+        return None
+
+    for _ in range(80):
