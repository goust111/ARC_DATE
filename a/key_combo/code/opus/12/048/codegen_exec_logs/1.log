+            return path
+    return None
+
+
+def _cell_origin(cell: tuple[int, int]) -> tuple[int, int]:
+    r, c = cell
+    return 4 * r, 4 * c
+
+
+def _paint_cell_segment(grid: np.ndarray, cell: tuple[int, int], dirs: set[str]) -> None:
+    top, left = _cell_origin(cell)
+    grid[top + 2, left + 2] = GREEN
