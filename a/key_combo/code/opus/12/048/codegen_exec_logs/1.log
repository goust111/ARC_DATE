+from __future__ import annotations
+
+import random
+from bisect import bisect_right
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_TO_DELTA = {"N": (-1, 0), "S": (1, 0), "W": (0, -1), "E": (0, 1)}
+CORNER_MOVES = {
+    "TL": (("N", "BL"), ("W", "TR")),
+    "TR": (("N", "BR"), ("E", "TL")),
+    "BL": (("S", "TL"), ("W", "BR")),
+    "BR": (("S", "TR"), ("E", "BL")),
+}
+CORNER_OFFSETS = {
+    "TL": (1, 1),
+    "TR": (1, -1),
+    "BL": (-1, 1),
+    "BR": (-1, -1),
+}
+
+
+def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r + dr, c + dc) for dr, dc in DIRS4]
+
+
+def _find_lattice_lines(grid: np.ndarray) -> tuple[list[int], list[int], int]:
+    h, w = grid.shape
+    grey_rows = [r for r in range(h) if int(np.sum(grid[r] == GREY)) > w // 2]
+    grey_cols = [c for c in range(w) if int(np.sum(grid[:, c] == GREY)) > h // 2]
+
+    assert len(grey_rows) >= 4 and len(grey_cols) >= 4
+    assert grey_rows[0] == 0 and grey_rows[-1] == h - 1
+    assert grey_cols[0] == 0 and grey_cols[-1] == w - 1
+
+    row_steps = [b - a for a, b in zip(grey_rows, grey_rows[1:])]
+    col_steps = [b - a for a, b in zip(grey_cols, grey_cols[1:])]
+    assert len(set(row_steps)) == 1 and len(set(col_steps)) == 1
+    stride_r = row_steps[0]
+    stride_c = col_steps[0]
+    assert stride_r == stride_c
+    assert stride_r in (3, 4)
+    return grey_rows, grey_cols, stride_r - 1
+
+
+def _cell_of_coord(
+    coord: tuple[int, int], line_rows: list[int], line_cols: list[int]
+) -> tuple[int, int] | None:
+    r, c = coord
+    if r in set(line_rows) or c in set(line_cols):
+        return None
+
+    ri = bisect_right(line_rows, r) - 1
+    ci = bisect_right(line_cols, c) - 1
+    if not (0 <= ri < len(line_rows) - 1 and 0 <= ci < len(line_cols) - 1):
+        return None
+    if not (line_rows[ri] < r < line_rows[ri + 1] and line_cols[ci] < c < line_cols[ci + 1]):
+        return None
+    return ri, ci
+
+
+def _trace_path(path_cells: set[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
+    prev: tuple[int, int] | None = None
+    cur = start
+    for _ in range(len(path_cells)):
+        order.append(cur)
+        next_cells = [n for n in _neighbors4(cur) if n in path_cells and n != prev]
+        if not next_cells:
+            break
+        assert len(next_cells) == 1
+        prev, cur = cur, next_cells[0]
+    assert len(order) == len(path_cells)
+    return order
+
+
+def _cell_class(cell: tuple[int, int], n_rows: int, n_cols: int) -> int:
+    r, c = cell
+    return RED if r in (0, n_rows - 1) or c in (0, n_cols - 1) else BLUE
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Straighten the cell-resident pixels of a snake path through a lattice, recoloring them by perimeter-vs-interior cell status.
+
+    Input structure:
+    - A grey lattice fills the whole outer border and all regular internal separators, partitioning the board into a complete rectangular array of 2x2 or 3x3 cells.
+    - A green 4-connected snake runs through lattice openings; in every visited cell exactly one green pixel lies inside the cell interior, while the remaining green pixels occupy the one-cell connector gaps.
+    - The snake is a simple chain with exactly two endpoints, and it visits both perimeter cells and strictly interior cells of the lattice array.
+
+    Rule:
+    - Recover the lattice row/column lines and therefore the cell-array coordinates.
+    - Choose the endpoint whose visited cell has the smaller array row; if tied, choose the smaller array column, then trace the snake to the other end.
+    - Emit a single-column output containing only the traversed green pixels that lie inside cells, in traversal order: recolor them red if their cell is on the outer perimeter of the array, otherwise blue.
+
+    Key insight:
+    - The output sequence depends on combining two independent structures: the snake fixes the readout order, while the lattice coordinates decide whether each visited cell is perimeter or interior.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    line_rows, line_cols, _ = _find_lattice_lines(g)
+    n_cell_rows = len(line_rows) - 1
+    n_cell_cols = len(line_cols) - 1
+
+    path = {(int(r), int(c)) for r, c in np.argwhere(g == GREEN)}
+    assert path
+
+    degrees = {
+        p: sum((n in path) for n in _neighbors4(p))
+        for p in path
+    }
+    endpoints = [p for p, deg in degrees.items() if deg == 1]
+    assert len(endpoints) == 2
+
+    endpoint_keys = []
+    for p in endpoints:
+        cell = _cell_of_coord(p, line_rows, line_cols)
+        assert cell is not None
+        endpoint_keys.append((cell[0], cell[1], p[0], p[1], p))
+    start = min(endpoint_keys)[-1]
+
+    path_order = _trace_path(path, start)
+
+    out_colors: list[int] = []
+    seen_cells: set[tuple[int, int]] = set()
+    line_row_set = set(line_rows)
+    line_col_set = set(line_cols)
+    for p in path_order:
+        if p[0] in line_row_set or p[1] in line_col_set:
+            continue
+        cell = _cell_of_coord(p, line_rows, line_cols)
+        assert cell is not None
+        assert cell not in seen_cells
+        seen_cells.add(cell)
+        out_colors.append(_cell_class(cell, n_cell_rows, n_cell_cols))
+
+    return np.asarray(out_colors, dtype=int).reshape(-1, 1)
+
+
+def _valid_state_moves(
+    state: tuple[int, int, str], n_rows: int, n_cols: int, visited: set[tuple[int, int]]
+) -> list[tuple[int, int, str]]:
+    r, c, corner = state
+    out = []
+    for direction, next_corner in CORNER_MOVES[corner]:
+        dr, dc = DIR_TO_DELTA[direction]
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < n_rows and 0 <= nc < n_cols and (nr, nc) not in visited:
+            out.append((nr, nc, next_corner))
+    return out
+
+
+def _generate_state_path(n_rows: int, n_cols: int) -> list[tuple[int, int, str]] | None:
+    max_len = min(12, n_rows * n_cols)
+    if max_len < 6:
+        return None
+
+    all_states = [(r, c, corner) for r in range(n_rows) for c in range(n_cols) for corner in CORNER_MOVES]
+    random.shuffle(all_states)
+    target_len = random.randint(6, max_len)
+
+    for start in all_states:
+        path = [start]
+        visited = {(start[0], start[1])}
+        while len(path) < target_len:
+            options = _valid_state_moves(path[-1], n_rows, n_cols, visited)
+            if not options:
+                break
+            current_r, current_c, _ = path[-1]
+            random.shuffle(options)
+            options.sort(
+                key=lambda s: (
+                    (s[0] in (0, n_rows - 1) or s[1] in (0, n_cols - 1)),
+                    abs(s[0] - current_r) + abs(s[1] - current_c),
+                    random.random(),
+                )
+            )
+            nxt = options[-1]
+            path.append(nxt)
+            visited.add((nxt[0], nxt[1]))
+
+        if len(path) < 6:
+            continue
+
+        cells = [(r, c) for r, c, _ in path]
+        classes = [
+            (r in (0, n_rows - 1) or c in (0, n_cols - 1))
+            for r, c in cells
+        ]
+        edge_count = sum(classes)
+        interior_count = len(classes) - edge_count
+        if edge_count < 2 or interior_count < 1:
+            continue
+        if not any(classes[i] != classes[i + 1] for i in range(len(classes) - 1)):
+            continue
+        return path
+    return None
+
+
+def _cell_pixel(
+    state: tuple[int, int, str], cell_size: int
+) -> tuple[int, int]:
+    r, c, corner = state
+    stride = cell_size + 1
+    base_r = r * stride
+    base_c = c * stride
+    off_r, off_c = CORNER_OFFSETS[corner]
+    rr = base_r + (1 if off_r > 0 else cell_size)
+    cc = base_c + (1 if off_c > 0 else cell_size)
+    return rr, cc
+
+
+def _gap_pixel(
+    state_a: tuple[int, int, str], state_b: tuple[int, int, str], cell_size: int
+) -> tuple[int, int]:
+    ra, ca, _ = state_a
+    rb, cb, _ = state_b
+    pr, pc = _cell_pixel(state_a, cell_size)
+    stride = cell_size + 1
+    if rb == ra and cb == ca + 1:
+        return pr, (ca + 1) * stride
+    if rb == ra and cb == ca - 1:
+        return pr, ca * stride
+    if cb == ca and rb == ra + 1:
+        return (ra + 1) * stride, pc
+    if cb == ca and rb == ra - 1:
+        return ra * stride, pc
+    raise AssertionError("non-adjacent states")
+
+
+def _render_grid(
+    path: list[tuple[int, int, str]], n_rows: int, n_cols: int, cell_size: int
+) -> np.ndarray:
+    stride = cell_size + 1
+    height = n_rows * stride + 1
+    width = n_cols * stride + 1
+    grid = np.full((height, width), BG, dtype=int)
+
+    for r in range(0, height, stride):
+        grid[r, :] = GREY
+    for c in range(0, width, stride):
+        grid[:, c] = GREY
+
+    for state in path:
+        rr, cc = _cell_pixel(state, cell_size)
+        grid[rr, cc] = GREEN
+    for a, b in zip(path, path[1:]):
+        rr, cc = _gap_pixel(a, b, cell_size)
+        grid[rr, cc] = GREEN
+
+    return grid
+
+
+def _expected_output(
+    path: list[tuple[int, int, str]], n_rows: int, n_cols: int
+) -> np.ndarray:
+    cells = [(r, c) for r, c, _ in path]
+    if cells[-1] < cells[0]:
+        cells = list(reversed(cells))
+    colors = [_cell_class(cell, n_rows, n_cols) for cell in cells]
+    return np.asarray(colors, dtype=int).reshape(-1, 1)
+
+
+def _validate_generated_grid(
+    grid: np.ndarray, path: list[tuple[int, int, str]], n_rows: int, n_cols: int, cell_size: int
+) -> bool:
+    try:
+        parsed_rows, parsed_cols, parsed_size = _find_lattice_lines(grid)
+        if len(parsed_rows) - 1 != n_rows or len(parsed_cols) - 1 != n_cols or parsed_size != cell_size:
+            return False
+
+        path_pixels = {(int(r), int(c)) for r, c in np.argwhere(grid == GREEN)}
+        degrees = {p: sum((n in path_pixels) for n in _neighbors4(p)) for p in path_pixels}
+        if sorted(degrees.values()).count(1) != 2:
+            return False
+        if any(deg not in (1, 2) for deg in degrees.values()):
+            return False
+
+        interior_counts: dict[tuple[int, int], int] = {}
+        for p in path_pixels:
+            cell = _cell_of_coord(p, parsed_rows, parsed_cols)
+            if cell is None:
+                continue
+            interior_counts[cell] = interior_counts.get(cell, 0) + 1
+        target_cells = {(r, c) for r, c, _ in path}
+        if target_cells != set(interior_counts):
+            return False
+        if any(count != 1 for count in interior_counts.values()):
+            return False
+
+        expected = _expected_output(path, n_rows, n_cols)
+        actual = main(grid)
+        return np.array_equal(actual, expected)
+    except Exception:
+        return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_rows = random.randint(3, 5)
+    n_cols = random.randint(3, 5)
+    cell_size = random.choice((2, 3))
+
+    path = _generate_state_path(n_rows, n_cols)
+    if path is None:
+        return None
+
+    grid = _render_grid(path, n_rows, n_cols, cell_size)
+    if not _validate_generated_grid(grid, path, n_rows, n_cols, cell_size):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
