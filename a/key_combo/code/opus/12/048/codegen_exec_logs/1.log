+        visited.add(nxt)
+        path.append(nxt)
+        result = _dfs_cell_path(path, visited, target_len, n_rows, n_cols)
+        if result is not None:
+            return result
+        path.pop()
+        visited.remove(nxt)
+    return None
+
+
+def _generate_cell_path(n_rows: int, n_cols: int) -> list[tuple[int, int]] | None:
+    max_len = min(12, n_rows * n_cols - 1)
