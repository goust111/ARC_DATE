+    "TL": (("N", "BL"), ("W", "TR")),
+    "TR": (("N", "BR"), ("E", "TL")),
+    "BL": (("S", "TL"), ("W", "BR")),
+    "BR": (("S", "TR"), ("E", "BL")),
+}
+CORNER_OFFSETS = {
+    "TL": (1, 1),
+    "TR": (1, -1),
+    "BL": (-1, 1),
+    "BR": (-1, -1),
+}
+
+
+def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r + dr, c + dc) for dr, dc in DIRS4]
+
+
+def _find_lattice_lines(grid: np.ndarray) -> tuple[list[int], list[int], int]:
+    h, w = grid.shape
+    grey_rows = [r for r in range(h) if int(np.sum(grid[r] == GREY)) > w // 2]
+    grey_cols = [c for c in range(w) if int(np.sum(grid[:, c] == GREY)) > h // 2]
+
+    assert len(grey_rows) >= 4 and len(grey_cols) >= 4
+    assert grey_rows[0] == 0 and grey_rows[-1] == h - 1
+    assert grey_cols[0] == 0 and grey_cols[-1] == w - 1
+
+    row_steps = [b - a for a, b in zip(grey_rows, grey_rows[1:])]
+    col_steps = [b - a for a, b in zip(grey_cols, grey_cols[1:])]
+    assert len(set(row_steps)) == 1 and len(set(col_steps)) == 1
+    stride_r = row_steps[0]
+    stride_c = col_steps[0]
+    assert stride_r == stride_c
+    assert stride_r in (3, 4)
+    return grey_rows, grey_cols, stride_r - 1
+
+
+def _cell_of_coord(
+    coord: tuple[int, int], line_rows: list[int], line_cols: list[int]
+) -> tuple[int, int] | None:
+    r, c = coord
+    if r in set(line_rows) or c in set(line_cols):
+        return None
+
+    ri = bisect_right(line_rows, r) - 1
+    ci = bisect_right(line_cols, c) - 1
+    if not (0 <= ri < len(line_rows) - 1 and 0 <= ci < len(line_cols) - 1):
+        return None
+    if not (line_rows[ri] < r < line_rows[ri + 1] and line_cols[ci] < c < line_cols[ci + 1]):
+        return None
+    return ri, ci
+
+
+def _trace_path(path_cells: set[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:
