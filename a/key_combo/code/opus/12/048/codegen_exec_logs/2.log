    colors = [int(color) for color in np.unique(g) if int(color) not in (BG, FRAME)]
    assert len(colors) == len(frames), "foreground colors must pair one-to-one with frames"

    rectangles: list[dict] = []
    for color in colors:
        mask = g == color
