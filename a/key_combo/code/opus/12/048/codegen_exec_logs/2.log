+    pair_specs: list[dict] = []
+    for side, cavity_spec, rect_shape, color in zip(side_pattern, cavity_specs, rect_shapes, colors):
+        pair_specs.append(
+            {
+                "side": side,
+                "cavity": cavity_spec["cavity"],
+                "cavity_area": cavity_spec["area"],
+                "rect_shape": rect_shape,
+                "color": color,
+            }
+        )
+
