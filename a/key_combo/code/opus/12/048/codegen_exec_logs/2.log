+
+
+def _place_rectangle(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    rect_shape: tuple[int, int],
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    rect_h, rect_w = rect_shape
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(1, h - rect_h):
+        for c0 in range(1, w - rect_w):
+            if occ[r0 : r0 + rect_h, c0 : c0 + rect_w].any():
+                continue
