+            if cand is None:
+                continue
+            if any(_boxes_overlap(cand, other["bbox"], margin=1) for other in placed):
+                continue
+            bbox = cand
+            break
+        if bbox is None:
+            return None
+        placed.append(
+            {
+                **spec,
+                "bbox": bbox,
+                "cavity_bbox": (bbox[0] + 1, bbox[1] + 1, bbox[2] - 1, bbox[3] - 1),
+            }
+        )
+    return placed
+
+
+def _place_rectangle(
+    grid: np.ndarray,
