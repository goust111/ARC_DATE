+        if side == "top":
+            r0 = 0
+            c0 = random.randint(0, w - outer_w)
+        elif side == "bottom":
+            r0 = h - outer_h
+            c0 = random.randint(0, w - outer_w)
+        elif side == "left":
+            r0 = random.randint(0, h - outer_h)
+            c0 = 0
+        else:
+            r0 = random.randint(0, h - outer_h)
+            c0 = w - outer_w
+        return (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
+    return None
+
+
+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
