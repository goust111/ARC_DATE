+    chosen: list[tuple[int, int]] = []
+    blocked = occ.copy()
+    for _ in range(count):
+        candidates: list[tuple[int, int]] = []
+        for r in range(1, h - 1):
+            for c in range(1, w - 1):
+                if blocked[r, c]:
+                    continue
+                if any(blocked[nr, nc] for nr, nc in _neighbors4(r, c)):
