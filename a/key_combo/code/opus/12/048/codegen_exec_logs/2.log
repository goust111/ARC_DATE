+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    h = random.randint(*GEN_GRID_RANGE)
+    w = random.randint(*GEN_GRID_RANGE)
+    num_pairs = random.choice(GEN_NUM_PAIRS_OPTIONS)
