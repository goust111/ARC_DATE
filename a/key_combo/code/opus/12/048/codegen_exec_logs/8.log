+
+def _random_composition(total: int, parts: int, minimum: int) -> list[int] | None:
+    base = parts * minimum
+    if base > total:
+        return None
+    vals = [minimum] * parts
+    extra = total - base
+    for _ in range(extra):
+        vals[random.randrange(parts)] += 1
+    return vals
+
