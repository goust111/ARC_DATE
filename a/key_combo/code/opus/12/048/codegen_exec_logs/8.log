MIN_WIDTH, MAX_WIDTH = 10, 17
ROW_VALUES = tuple(range(GRID_HEIGHT))
BG_COLOR, MARKER_COLOR, OUTPUT_COLOR = Color.BLACK, Color.GREY, Color.GREEN
