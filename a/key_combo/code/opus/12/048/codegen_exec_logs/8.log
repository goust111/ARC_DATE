+def _band_ranges(H: int, sep_rows: list[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start = 1
+    for row in sep_rows:
+        bands.append((start, row - 1))
+        start = row + 1
+    bands.append((start, H - 2))
+    return bands
+
