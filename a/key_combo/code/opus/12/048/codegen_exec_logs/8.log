+def _pick_band_rows(bands: list[tuple[int, int]]) -> list[int]:
+    rows = []
+    for lo, hi in bands:
+        rows.append(random.randint(lo, hi))
+    return rows
+
+
+def _pick_crossing_columns(W: int, count: int) -> list[int] | None:
+    cols = [random.randint(2, W - 3)]
