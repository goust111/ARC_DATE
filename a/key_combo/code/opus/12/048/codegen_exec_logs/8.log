+        tr, tc = target
+        if r != tr:
+            step = (r + (1 if tr > r else -1), c)
+        else:
+            step = (r, c + (1 if tc > c else -1))
+        if not _append_step(path, occupied, step, shape):
+            return False
+    return True
+
