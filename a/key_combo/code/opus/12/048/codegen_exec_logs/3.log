+def _component_sort_key(edge: str, item: dict) -> tuple[int, int, int]:
+    r0, c0, _r1, _c1 = item["bbox"]
+    if edge in ("left", "right"):
+        return item["distance"], r0, c0
+    return item["distance"], c0, r0
