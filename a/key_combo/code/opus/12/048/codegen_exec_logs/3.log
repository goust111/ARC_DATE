+            elif edge == "top":
+                lo = obj["out_r0"] + 1
+                hi = h - mh - 1
+                if prev is not None:
+                    lo = max(lo, prev + 1)
+                candidates = list(range(lo, hi + 1))
+                random.shuffle(candidates)
