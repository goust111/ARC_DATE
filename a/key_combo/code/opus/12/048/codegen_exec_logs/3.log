+                        obj["in_r0"], obj["in_c0"] = obj["out_r0"], c0
+                        _stamp_occupied(occupied, obj["mask"], obj["in_r0"], obj["in_c0"])
+                        prev = c0
+                        placed = True
+                        break
+            elif edge == "top":
+                lo = obj["out_r0"] + 1
+                hi = h - mh - 1
+                if prev is not None:
+                    lo = max(lo, prev + 1)
+                candidates = list(range(lo, hi + 1))
+                random.shuffle(candidates)
