+def _distance_to_edge(edge: str, bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> int:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    if edge == "left":
+        return c0
+    if edge == "top":
+        return r0
+    if edge == "right":
+        return w - 1 - c1
+    return h - 1 - r1
