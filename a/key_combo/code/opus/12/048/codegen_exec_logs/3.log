+def _random_transform(mask: np.ndarray) -> np.ndarray:
+    out = np.array(mask, dtype=bool)
+    out = np.rot90(out, random.randint(0, 3))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    return _normalize_mask(out)
