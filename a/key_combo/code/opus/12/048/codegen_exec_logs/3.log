+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+EDGE_ORDER = ("left", "top", "right", "bottom")
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _tight_mask_from_coords(coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _detect_markers(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    by_edge: dict[str, tuple[int, int, int]] = {}
+    for c in range(1, w - 1):
+        if int(grid[0, c]) != BG:
+            by_edge["top"] = (0, c, int(grid[0, c]))
+        if int(grid[h - 1, c]) != BG:
+            by_edge["bottom"] = (h - 1, c, int(grid[h - 1, c]))
+    for r in range(1, h - 1):
+        if int(grid[r, 0]) != BG:
+            by_edge["left"] = (r, 0, int(grid[r, 0]))
+        if int(grid[r, w - 1]) != BG:
+            by_edge["right"] = (r, w - 1, int(grid[r, w - 1]))
+    markers = []
+    for edge in EDGE_ORDER:
+        if edge in by_edge:
+            r, c, color = by_edge[edge]
