+    out = np.full_like(g, BG)
+    for edge in EDGE_ORDER:
+        offset = 0
+        for item in sorted(groups[edge], key=lambda x, e=edge: _component_sort_key(e, x)):
+            mask = item["mask"]
+            r0, c0, r1, c1 = item["bbox"]
+            ph, pw = mask.shape
+            if edge == "left":
+                dest_r0, dest_c0 = r0, offset
+                offset += pw
+            elif edge == "right":
+                dest_r0, dest_c0 = r0, w - offset - pw
+                offset += pw
+            elif edge == "top":
