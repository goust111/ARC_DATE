+                        obj["in_r0"], obj["in_c0"] = r0, obj["out_c0"]
+                        _stamp_occupied(occupied, obj["mask"], obj["in_r0"], obj["in_c0"])
+                        prev = r0
+                        placed = True
+                        break
+            if not placed:
+                return False
+    return True
