+BG = 0
+GREY = 5
+EDGE_ORDER = ("left", "top", "right", "bottom")
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 500
