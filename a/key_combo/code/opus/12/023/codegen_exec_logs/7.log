+def _random_connected_patch(
+    rng: random.Random,
+    dims: tuple[int, int],
+    color_choices: list[int],
+    n_cells: int,
+) -> np.ndarray | None:
+    h, w = dims
+    if n_cells < len(color_choices) or n_cells > h * w:
+        return None
+    start = (rng.randrange(h), rng.randrange(w))
+    cells = {start}
+    frontier = set()
+    for nr, nc in _neighbors4(*start):
+        if 0 <= nr < h and 0 <= nc < w:
+            frontier.add((nr, nc))
