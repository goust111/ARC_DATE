+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+LEGEND_BORDER = GREY
+LEGEND_TARGET_POOL = [BLUE, RED]
+RECT_COLORS = [GREEN, YELLOW, ORANGE]
+COMP_EXTRA_COLORS = [PINK, TEAL, MAROON]
+
+MAX_GEN_ATTEMPTS = 400
