+        pt = rng.choice(tuple(frontier))
+        frontier.remove(pt)
+        cells.add(pt)
+        for nr, nc in _neighbors4(*pt):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
