+                    if 0 <= nr < cell_size and 0 <= nc < cell_size and (nr, nc) not in coords:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            coords.add(random.choice(frontier))
+        if len(coords) != area:
+            continue
+        patch = np.full((cell_size, cell_size), BLACK, dtype=int)
+        for r, c in coords:
+            patch[r, c] = GREEN
