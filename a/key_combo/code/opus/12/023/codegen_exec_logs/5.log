+
+        if not np.array_equal(out[grid == RED], grid[grid == RED]):
+            return False
+
+        template = info["template_patch"]
+        hflip = np.fliplr(template)
+        vflip = np.flipud(template)
+        row_copies = 0
+        col_copies = 0
