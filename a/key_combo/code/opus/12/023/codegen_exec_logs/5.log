+    grid = _blank_lattice(cell_size)
+    template_patch = _make_template_patch(cell_size)
+    center = cell_size // 2
+
+    rs = _cell_slice(template_cell[0], cell_size)
+    cs = _cell_slice(template_cell[1], cell_size)
