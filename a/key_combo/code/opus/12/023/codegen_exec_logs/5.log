+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+    for attempt in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(_GEN_COUNTER + attempt)
+        if grid is not None:
+            _GEN_COUNTER += attempt + 1
+            return grid
+    raise RuntimeError("failed to generate a valid input")

