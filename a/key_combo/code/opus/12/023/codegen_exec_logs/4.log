+
+def _place_sprite(grid: np.ndarray, forbidden: np.ndarray, sprite: np.ndarray, top_left: tuple[int, int]) -> None:
+    r0, c0 = top_left
+    h, w = grid.shape
+    for r, c in np.argwhere(sprite != BACKGROUND):
+        rr = r0 + int(r)
+        cc = c0 + int(c)
+        grid[rr, cc] = int(sprite[int(r), int(c)])
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w:
