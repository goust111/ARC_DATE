+
+def _generate_thin_mask(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        h = int(rng.integers(5, 8))
+        w = int(rng.integers(5, 8))
+        target = int(rng.integers(5, 13))
+        start = (int(rng.integers(0, h)), int(rng.integers(0, w)))
+        path = [start]
+        cells = {start}
