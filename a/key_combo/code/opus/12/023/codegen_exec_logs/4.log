+    rows = int(rng.integers(14, 19))
+    cols = int(rng.integers(12, 18))
+    grid = np.zeros((rows, cols), dtype=int)
+    forbidden = np.zeros((rows, cols), dtype=bool)
+
+    place_order = sorted(
+        range(len(specs)),
