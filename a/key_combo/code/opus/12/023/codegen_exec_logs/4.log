+def _would_make_2x2(cells: set[tuple[int, int]], r: int, c: int) -> bool:
+    trial = set(cells)
+    trial.add((r, c))
+    for r0 in (r - 1, r):
+        for c0 in (c - 1, c):
+            square = {
+                (r0, c0),
+                (r0 + 1, c0),
+                (r0, c0 + 1),
+                (r0 + 1, c0 + 1),
+            }
+            if square.issubset(trial):
