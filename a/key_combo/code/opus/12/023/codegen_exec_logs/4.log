+            ComponentInfo(
+                coords=coords,
+                bbox=bbox,
+                mask=_crop_mask(coords, bbox),
+                area=len(coords),
+                marker_color=marker_color,
+                marker_pos=marker_cells[0],
+                thick=bool(_supported_blue_cells(grid, coords)),
