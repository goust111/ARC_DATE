+
+def _frontier_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    frontier: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIR4:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                frontier.add((nr, nc))
+    return sorted(frontier)
