+        if grid[r, 0] != GREY:
+            seen[r, 0] = True
+            q.append((r, 0))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] != GREY and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
