+        marker_mask = values != BLUE
+        assert int(marker_mask.sum()) == 1, "each component must contain exactly one marker"
+        marker_idx = int(np.flatnonzero(marker_mask)[0])
+        marker = tuple(map(int, coords[marker_idx]))
