+        side_masks["left"],
+        counts[0],
+        marker_colors[: counts[0]],
+        forbidden,
+        dist_map,
+    ):
+        return None
+    if not _place_side_components(
+        rng,
+        grid,
+        side_masks["right"],
+        counts[1],
+        marker_colors[counts[0] :],
+        forbidden,
+        dist_map,
+    ):
+        return None
+
+    if not _validate_generated_grid(grid, counts):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        seed = random.randrange(1 << 30)
+        grid = _generate_attempt(random.Random(seed))
+        if grid is not None:
