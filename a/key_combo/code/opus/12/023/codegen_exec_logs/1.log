+
+def _wall_distances(shape: tuple[int, int], wall_cells: list[tuple[int, int]]) -> np.ndarray:
+    h, w = shape
+    dist = np.full((h, w), 10**9, dtype=int)
+    for r in range(h):
+        for c in range(w):
