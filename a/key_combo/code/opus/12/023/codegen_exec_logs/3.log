+def _make_template(side: int, rng: random.Random) -> np.ndarray:
+    min_count = 12
+    max_count = min(16, int(math.floor(side * side * 0.58)))
+    for _ in range(300):
+        count = rng.randint(min_count, max_count)
+        mask = _grow_connected_mask(side, count, rng)
