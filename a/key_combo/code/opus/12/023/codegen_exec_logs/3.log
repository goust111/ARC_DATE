+        )
+        if not np.any(exclusive):
+            return False
+
+    for a, b in PAIR_ORDER:
+        if not np.any(visibility_masks[a] & visibility_masks[b]):
+            return False
+
+    consistent = _consistent_assignments(_split_regions(inp)[1])
