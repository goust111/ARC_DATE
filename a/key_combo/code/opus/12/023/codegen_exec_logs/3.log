+
+
+def _make_visibility_masks(template: np.ndarray, rng: random.Random) -> list[np.ndarray]:
+    coords = [tuple(int(v) for v in rc) for rc in np.argwhere(template != BLACK)]
+    count = len(coords)
+    indices = list(range(count))
