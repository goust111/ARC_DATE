+                for idx in range(count)
+                if idx not in visible_sets[region]
+                and counts[region] < cap
+            ]
+            if not candidates:
+                return []
+            idx = rng.choice(candidates)
+            visible_sets[region].add(idx)
+            counts[region] += 1
+
