+    grid[side, :] = GREY
+    grid[:, side] = GREY
+
+    slices = [
+        (slice(0, side), slice(0, side)),
+        (slice(0, side), slice(side + 1, 2 * side + 1)),
+        (slice(side + 1, 2 * side + 1), slice(0, side)),
+        (slice(side + 1, 2 * side + 1), slice(side + 1, 2 * side + 1)),
+    ]
