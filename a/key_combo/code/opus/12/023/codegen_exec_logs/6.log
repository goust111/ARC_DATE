+    r0, c0, r1, c1 = box
+    grid[r0, c0 + 1 : c1] = RED
+    grid[r1, c0 + 1 : c1] = GREEN
+    grid[r0 + 1 : r1, c0] = BLUE
+    grid[r0 + 1 : r1, c1] = YELLOW
+
+
