+def _bbox_of_nonblack(grid: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(grid != BLACK)
+    if coords.size == 0:
+        raise AssertionError("expected non-black frame pixels")
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
