+    r0, _c0, r1, _c1 = box
+    bottom = r1 - 1
+    assert r0 < r < r1
+    return (bottom - r) % 2 == 1
+
+
+def _step1_destination(
+    r: int,
+    c: int,
+    color: int,
+    box: tuple[int, int, int, int],
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    dr, dc = MOVE_DIRS[color]
+    nr, nc = r + dr, c + dc
+    if nr in (r0, r1) or nc in (c0, c1):
+        return r, c
+    return nr, nc
+
+
+def _apply_step1(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    *,
+    return_groups: bool = False,
+):
+    g = np.asarray(grid, dtype=int)
+    r0, c0, r1, c1 = box
+    out = g.copy()
