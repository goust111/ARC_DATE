+            continue
+        row = out[r, c0 + 1 : c1].copy()
+        out[r, c0 + 1 : c1] = np.roll(row, 1)
+    return out
+
+
+def _transform(grid: np.ndarray) -> np.ndarray:
+    box = _find_frame(grid)
+    return _apply_wave(_apply_step1(grid, box), box)
+
+
