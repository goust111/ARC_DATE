+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+TILE_ROWS = 4
+TILE_COLS = 4
+SEPARATOR_WIDTH = 1
