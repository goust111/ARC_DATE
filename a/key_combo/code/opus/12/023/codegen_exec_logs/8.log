+    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for tr in range(r0, r1 + 1):
+        for tc in range(c0, c1 + 1):
+            assert (tr, tc) in solid_tiles, "solid tiles must form one filled rectangle"
+            out[tr - r0, tc - c0] = solid_tiles[(tr, tc)]
