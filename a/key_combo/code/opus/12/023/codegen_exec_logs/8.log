+    height = TILE_ROWS * tile_h + (TILE_ROWS - 1) * SEPARATOR_WIDTH
+    width = TILE_COLS * tile_w + (TILE_COLS - 1) * SEPARATOR_WIDTH
+    grid = np.full((height, width), GREY, dtype=int)
