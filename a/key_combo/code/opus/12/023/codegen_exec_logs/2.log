+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+PAIR_COLORS = (BLUE, RED, GREEN)
+MAX_GENERATION_ATTEMPTS = 400
+
+
+Coord = tuple[int, int]
+
+
+@dataclass(frozen=True)
+class Line:
+    color: int
+    slope: int
+    start: Coord
+    end: Coord
+    path: tuple[Coord, ...]
