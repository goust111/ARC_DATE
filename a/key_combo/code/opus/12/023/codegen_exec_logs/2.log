+            r, c = outside_cells[cursor]
+            cursor += 1
+            grid[r, c] = color
+    extra = int(rng.integers(0, min(8, len(outside_cells) - cursor + 1)))
+    for _ in range(extra):
+        if cursor >= len(outside_cells):
