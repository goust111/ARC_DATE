+
+def _solid_panel_boxes(grid: np.ndarray, bg: int) -> list[tuple[int, int, int, int]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
