spec:
  grid: 12x12, background 0
  panel:
    size: 8x8 (always)
    placement: anywhere on grid that fits (top-left row 0-4, col 0-4)
    rest_of_grid: all background (0)
    symmetry: full D4 (LR, UD, rot90, rot180, transpose all hold)
    structure: 2x2 mosaic of reflected copies of a 4x4 source quadrant
  quadrant:
    size: 4x4 (the upper-left quadrant of the panel = the output)
    symmetry: transpose-symmetric (q[r,c] == q[c,r])
    independent_cells: 10 (upper triangle including diagonal)
    distinct_colors: 4-7 including 0
    background_cells: 4-7 cells are 0 [observed]
