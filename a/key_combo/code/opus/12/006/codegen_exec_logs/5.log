+        return False
+
+    largest_mask = np.zeros(
+        (largest["bbox"][2] - largest["bbox"][0] + 1, largest["bbox"][3] - largest["bbox"][1] + 1),
+        dtype=bool,
+    )
+    for r, c in largest["coords"]:
