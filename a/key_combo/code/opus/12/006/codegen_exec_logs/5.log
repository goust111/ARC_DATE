+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+PAIR_COLOR = {
+    8: 2,  # teal -> red
+    3: 1,  # green -> blue
+    5: 4,  # grey -> yellow
+}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+INPUT_COLORS = tuple(PAIR_COLOR.keys())
+
+GRID_SIZE_RANGE = (12, 18)
+OBJECT_COUNT_CHOICES = (4, 5)
+LARGEST_AREA_RANGE = (8, 12)
+SMALL_AREAS = (3, 4, 5, 6)
+MAX_GENERATION_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 300
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coord_array = np.array(coords, dtype=int)
+            r0, c0, r1, c1 = _bbox_from_coords(coord_array)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coord_array,
+                    "area": int(coord_array.shape[0]),
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    return objects
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    padded = np.pad(mask.astype(bool), 1, constant_values=False)
+    h, w = padded.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and not padded[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    return bool(np.any((~padded) & (~seen)))
+
+
+def _random_connected_shape(
+    area: int,
+    *,
+    box_h_range: tuple[int, int],
+    box_w_range: tuple[int, int],
+    require_bbox_slack: bool,
+    require_hole_free: bool,
+    min_height: int = 2,
+    min_width: int = 2,
+) -> np.ndarray:
+    for _ in range(SHAPE_ATTEMPTS):
+        box_h = random.randint(*box_h_range)
+        box_w = random.randint(*box_w_range)
+        if box_h * box_w < area:
+            continue
+
+        cells = {(random.randrange(box_h), random.randrange(box_w))}
+        while len(cells) < area:
+            frontier: set[tuple[int, int]] = set()
+            for r, c in cells:
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < box_h and 0 <= nc < box_w and (nr, nc) not in cells:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(tuple(frontier)))
+        if len(cells) != area:
+            continue
+
+        mask = np.zeros((box_h, box_w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        coords = np.argwhere(mask)
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+
