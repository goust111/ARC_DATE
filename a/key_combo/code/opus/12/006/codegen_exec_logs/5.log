+        require_hole_free=True,
+        min_height=3,
+        min_width=3,
+    )
+
+    small_areas = random.sample(SMALL_AREAS, object_count - 1)
+    small_patches = [
+        _random_connected_shape(
+            area,
+            box_h_range=(2, 4),
