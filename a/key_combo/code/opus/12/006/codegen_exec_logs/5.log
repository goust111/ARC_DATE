+        box_h_range=(3, 5),
+        box_w_range=(3, 5),
+        require_bbox_slack=False,
+        require_hole_free=True,
+        min_height=3,
+        min_width=3,
+    )
+
+    small_areas = random.sample(SMALL_AREAS, object_count - 1)
+    small_patches = [
+        _random_connected_shape(
+            area,
+            box_h_range=(2, 4),
+            box_w_range=(2, 4),
+            require_bbox_slack=True,
+            require_hole_free=True,
+            min_height=2,
+            min_width=2,
+        )
+        for area in small_areas
+    ]
