+
+def _add_rect_frame(panel: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:
+    r1 = r0 + size - 1
+    c1 = c0 + size - 1
+    panel[r0, c0 : c1 + 1] = color
+    panel[r1, c0 : c1 + 1] = color
+    panel[r0 : r1 + 1, c0] = color
+    panel[r0 : r1 + 1, c1] = color
+
