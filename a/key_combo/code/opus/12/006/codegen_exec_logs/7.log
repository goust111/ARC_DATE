+        return False
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    return bool(np.array_equal(actual, expected))
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
