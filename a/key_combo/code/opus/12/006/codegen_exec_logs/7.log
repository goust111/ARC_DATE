+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and bool(zero_mask[nr, nc]) and not bool(outside[nr, nc]):
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = zero_mask & ~outside
+    return _components_from_mask(holes)
+
