+def _outer_frame(h: int, w: int, color: int) -> np.ndarray:
+    panel = np.zeros((h, w), dtype=int)
+    panel[0, :] = color
+    panel[-1, :] = color
+    panel[:, 0] = color
+    panel[:, -1] = color
+    return panel
