+def _hole_components(panel: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(panel, dtype=int)
+    h, w = g.shape
+    zero_mask = g == BG
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(zero_mask[r, c]) and not bool(outside[r, c]):
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(zero_mask[r, c]) and not bool(outside[r, c]):
+                outside[r, c] = True
+                q.append((r, c))
