+def _fill_holes(panel: np.ndarray) -> np.ndarray:
+    out = np.asarray(panel, dtype=int).copy()
+    for coords in _hole_components(out):
+        out[coords[:, 0], coords[:, 1]] = FILL_COLOR
+    return out
