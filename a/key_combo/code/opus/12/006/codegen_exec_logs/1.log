+                    "coords": np.asarray(coords, dtype=int),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _paint_coords(grid, coords, color):
+    for r, c in coords:
+        grid[int(r), int(c)] = int(color)
+
