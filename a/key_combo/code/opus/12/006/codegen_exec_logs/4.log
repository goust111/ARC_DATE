+            winner = None
+        elif len(colors) == 1:
+            fill_color = int(next(iter(colors)))
+            winner = None
+        else:
+            winner = max(seeds, key=lambda seed: (int(seed["score"]), -int(seed["anchor"][0]), -int(seed["anchor"][1])))
