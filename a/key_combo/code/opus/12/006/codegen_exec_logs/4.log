+        occupied.add((int(r), int(c)))
+
+
+def _place_blob(grid: np.ndarray, region: dict, color: int, size: int, occupied: set[tuple[int, int]], rng: random.Random, *, require_wall_adj: bool = False, forbid_wall_adj: bool = False) -> bool:
