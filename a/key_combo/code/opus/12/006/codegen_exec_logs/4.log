+    seeds: list[dict] = []
+    for comp in comps:
+        coords = sorted(comp["coords"])
+        anchor = coords[0]
+        ar, ac = anchor
+        same_color_count = int(np.sum(cleaned[max(0, ar - 1) : ar + 2, max(0, ac - 1) : ac + 2] == int(comp["color"])))
+        seeds.append(
