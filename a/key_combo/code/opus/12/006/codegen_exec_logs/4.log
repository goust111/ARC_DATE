+
+        for r, c in region["cells"]:
+            out[r, c] = fill_color
+
+        region_details.append(
+            {
+                "id": int(region["id"]),
+                "area": int(region["area"]),
+                "seed_count": len(seeds),
+                "seed_colors": sorted(colors),
+                "fill_color": fill_color,
+                "winner": winner,
+                "seeds": seeds,
+            }
+        )
