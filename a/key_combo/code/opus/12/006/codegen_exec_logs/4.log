class Color:
    """ARC palette color ids (ints, not Enum)."""

    BLACK = 0
    BLUE = 1
    RED = 2
    GREEN = 3
    YELLOW = 4
    GREY = 5
    GRAY = 5
    PINK = 6
    ORANGE = 7
    TEAL = 8
    MAROON = 9

    WHITE = 10  # debug / visualization
    PAD = 11

