+        wall_adj = set()
+        interior = set()
+        for r, c in cells:
+            near_wall = False
+            for nr, nc in _neighbors4(r, c):
+                if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == WALL:
+                    near_wall = True
+                    break
+            if near_wall:
+                wall_adj.add((r, c))
+            if not near_wall and 0 < r < h - 1 and 0 < c < w - 1:
+                interior.add((r, c))
+        infos.append(
+            {
+                "id": rid,
+                "cells": cells,
+                "set": cell_set,
+                "wall_adjacent": wall_adj,
+                "interior": interior,
+                "area": len(cells),
+            }
+        )
+    return labels, infos
