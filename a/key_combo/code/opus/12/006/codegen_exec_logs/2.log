+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SEED = 2
+GREEN = 3
+GREY = 5
+OUTLINE = 8
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+Tree = tuple["Tree", ...]
+
+LEAF: Tree = ()
+CHAIN2: Tree = (LEAF,)
+CHAIN3: Tree = (CHAIN2,)
+SIBLINGS: Tree = (LEAF, LEAF)
+SIBLING_CHAIN: Tree = (LEAF, CHAIN2)
+
+TOPOLOGIES: tuple[tuple[Tree, ...], ...] = (
+    (CHAIN2,),
+    (CHAIN3,),
+    (SIBLINGS,),
+    (SIBLING_CHAIN,),
+    (CHAIN2, LEAF),
+    (SIBLINGS, LEAF),
+)
+
