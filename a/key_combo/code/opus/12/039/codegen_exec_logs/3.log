+
+def _paint_scene(
+    shape: tuple[int, int],
+    block_positions: dict[int, tuple[int, int]],
+    sprite_positions: dict[int, set[Coord]],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for color, (r0, c0) in block_positions.items():
+        grid[r0 : r0 + 2, c0 : c0 + 2] = color
