+        return 0, c0 - 1 - sc1
+    if direction == "left":
+        return 0, c1 + 1 - sc0
+    if direction == "down":
+        return r0 - 1 - sr1, 0
+    if direction == "up":
+        return r1 + 1 - sr0, 0
