+                clear = True
+                for cc in range(sc + step, bc, step):
+                    if (sr, cc) in occupied:
+                        clear = False
+                        break
+                if clear:
+                    directions.add("right" if bc > sc else "left")
+            if sc == bc:
+                step = 1 if br > sr else -1
+                clear = True
+                for rr in range(sr + step, br, step):
+                    if (rr, sc) in occupied:
