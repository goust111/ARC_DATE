+                "sprite": sprite,
+                "block": block,
+                "block_bbox": _bbox(block),
+                "size": len(sprite),
+                "distance": _component_min_manhattan(sprite, block),
+                "top_row": _bbox(sprite)[0],
+                "left_col": _bbox(sprite)[1],
