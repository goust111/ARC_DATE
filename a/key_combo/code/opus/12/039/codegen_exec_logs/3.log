0104: 
0105:     # --- STEP 2) For each layer, rotate according to its unique outside cue size ---
0106:     colors = colors_present(crop, exclude={int(bg)})
0107:     assert colors, "expected the cropped board to contain foreground colors"
0108:     out = crop.copy()
