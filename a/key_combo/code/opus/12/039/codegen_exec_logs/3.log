+        return set(coords)
+    r0, c0, r1, c1 = _bbox(coords)
+    cr = (r0 + r1) / 2.0
+    cc = (c0 + c1) / 2.0
+    out = {(r, c) for r, c in coords}
+    for _ in range(k):
+        nxt: set[Coord] = set()
+        for r, c in out:
+            dr = r - cr
+            dc = c - cc
+            nr = cr + dc
+            nc = cc - dr
+            nxt.add((int(round(nr)), int(round(nc))))
+        out = nxt
