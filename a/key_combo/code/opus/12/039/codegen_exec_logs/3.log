+                "size": len(sprite),
+                "distance": _component_min_manhattan(sprite, block),
+                "top_row": _bbox(sprite)[0],
+                "left_col": _bbox(sprite)[1],
+            }
+        )
+    scene.sort(key=lambda item: (item["distance"], item["top_row"], item["left_col"], item["color"]))
