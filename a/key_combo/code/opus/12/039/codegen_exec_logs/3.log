+                initial_occ = input_occupied | sprite
+                if _unique_sightline(sprite, block, initial_occ) != direction:
+                    continue
+                prior_occ = previous_finals | sprite
+                dynamic_dir = _unique_sightline(sprite, block, prior_occ)
+                if want_blocked:
