+            return None
+        placed[color] = picked
+    return placed
+
+
+def _blocked_layout(
+    h: int,
+    w: int,
+    colors: list[int],
+    order: list[int],
+) -> tuple[dict[int, tuple[int, int]], dict[int, str], Coord] | None:
+    blocker, blocked = order[0], order[1]
