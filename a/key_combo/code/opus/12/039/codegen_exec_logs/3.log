+
+def _apply_delta(coords: set[Coord], delta: tuple[int, int]) -> set[Coord]:
+    dr, dc = delta
+    return {(r + dr, c + dc) for r, c in coords}
+
+
+def _final_coords(
+    sprite: set[Coord],
