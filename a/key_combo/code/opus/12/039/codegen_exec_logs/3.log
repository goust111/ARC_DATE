+    return all(0 <= r < h and 0 <= c < w for r, c in coords)
+
+
+def _component_min_manhattan(a: set[Coord], b: set[Coord]) -> int:
+    return min(abs(ar - br) + abs(ac - bc) for ar, ac in a for br, bc in b)
