+        return set(coords)
+    r0, c0, r1, c1 = _bbox(coords)
+    cr = (r0 + r1) / 2.0
+    cc = (c0 + c1) / 2.0
+    out = {(r, c) for r, c in coords}
+    for _ in range(k):
