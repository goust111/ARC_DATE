+    if expect_blocked and not any(item["status"] == "blocked" for item in meta):
+        return False
+    alt_no_rot = _solve_variant(grid, rotate_mode="none")
+    alt_post = _solve_variant(grid, rotate_mode="post_slide")
+    if np.array_equal(out, alt_no_rot):
