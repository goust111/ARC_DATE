+    usable_rect = []
+    usable_nonrect = []
+    for idx, region in enumerate(regions):
+        candidates = _candidate_marker_cells(region, shape, plus_set)
+        if not candidates:
+            continue
+        entry = (idx, candidates)
+        if region["is_rect"]:
+            usable_rect.append(entry)
+        else:
