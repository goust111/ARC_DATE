+def _is_isolated_marker(grid: np.ndarray, r: int, c: int) -> bool:
+    for dr, dc in NEIGHBORS8:
+        nr = r + dr
+        nc = c + dc
+        if _in_bounds(grid.shape, nr, nc) and grid[nr, nc] != BG:
+            return False
+    return True
