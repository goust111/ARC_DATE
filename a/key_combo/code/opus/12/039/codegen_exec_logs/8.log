spec:
  grid: 9 cols wide; 9-11 rows tall (region_h = 4-5 rows above and below)
  background: black (0)
  divider: single full-width gray (5) row splitting grid into equal upper/lower regions
  markers:
    count: exactly 2 distinct non-bg non-gray colors
    colors: any 2 from palette; both colors are red(2) and yellow(4) [observed]
    layout: each color occupies a single fixed column; columns differ between colors
    columns: columns 2 and 6 [observed]; must be separated by >=2 cols
    bar_shape: contiguous vertical run starting from row 0 of each region
    above_height: 1 to region_h-1 pixels (never fills entire region)
    below_height: strictly greater than above_height for both colors (both grow)
  winner_constraint: the two diffs (below - above) must be unequal (unique winner)
  output: 2x2 grid filled with the color whose (below_count - above_count) is largest

generation_strategy:
  approach: direct construction (simple enough, no inversion needed)
  steps:
    1. Pick region_h in {4, 5}; grid height = 2*region_h + 1, width = 9
    2. Pick 2 distinct colors from non-bg non-gray palette
    3. Pick 2 distinct columns (separated by >=2) for the two color bars
    4. For each color, sample above_bar_h in [1, region_h-1]
    5. For each color, sample below_bar_h in [above_bar_h+1, region_h] (strictly greater)
    6. Compute diffs; if tied, resample (low rejection rate ~10-20%)
    7. Place divider row at row region_h; fill bar pixels; rest is background
