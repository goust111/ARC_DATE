+    occupied: list[tuple[int, int]] = []
+    for color, (region_id, candidates) in zip(chosen_colors, chosen_regions):
+        pick = None
+        for r, c in candidates:
+            if _king_far_enough(occupied, r, c):
+                pick = (r, c)
+                break
+        if pick is None:
