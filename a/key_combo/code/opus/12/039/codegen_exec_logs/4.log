from __future__ import annotations
import numpy as np
from functools import cmp_to_key

BG=0
RECT_POOL=(1,2,3,4)
BAR_POOL=(6,7,8,9)


def bbox_of(coords):
    r0,c0=coords.min(axis=0)
    r1,c1=coords.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def inter(a,b):
    r0=max(a[0],b[0]); c0=max(a[1],b[1]); r1=min(a[2],b[2]); c1=min(a[3],b[3])
    if r0>r1 or c0>c1:
        return None
    return r0,c0,r1,c1

def render(shape, layers, recolor=None):
    g=np.zeros(shape,dtype=int)
    for item in layers:
        color=recolor.get(item['color'], item['color']) if recolor else item['color']
        r0,c0,r1,c1=item['box']
        g[r0:r1+1,c0:c1+1]=color
    return g

def ratio_cmp(a,b):
    left=a['occluded']*b['area']
    right=b['occluded']*a['area']
    return -1 if left>right else (1 if left<right else 0)

def solve(grid):
    g=np.asarray(grid,dtype=int)
    scene=g[:-1]
    bar=[int(v) for v in g[-1] if int(v)"'!=0]
    rect_colors=sorted(int(v) for v in np.unique(scene) if int(v)!=0)
    infos={}
    for color in rect_colors:
        coords=np.argwhere(scene==color)
        box=bbox_of(coords)
        r0,c0,r1,c1=box
        infos[color]={
            '"'box': box,
            'visible': int(len(coords)),
            'area': int((r1-r0+1)*(c1-c0+1)),
        }
        infos[color]['occluded']=infos[color]['area']-infos[color]['visible']
    edges={c:set() for c in rect_colors}
    indeg={c:0 for c in rect_colors}
    for a in rect_colors:
        for b in rect_colors:
            if a>=b: continue
            ov=inter(infos[a]['box'], infos[b]['box'])
            if ov is None: continue
            r0,c0,r1,c1=ov
            reg=scene[r0:r1+1,c0:c1+1]
            a_seen=bool(np.any(reg==a))
            b_seen=bool(np.any(reg==b))
            if a_seen and b_seen:
                raise AssertionError('both seen')
            if a_seen:
                lo,hi=b,a
            elif b_seen:
                lo,hi=a,b
            else:
                continue
            if hi not in edges[lo]:
                edges[lo].add(hi); indeg[hi]+=1
    order=[]
    avail=sorted([c for c in rect_colors if indeg[c]==0], key=lambda c:(infos[c]['box'][0],infos[c]['box'][1],c))
    while avail:
        c=avail.pop(0)
        order.append(c)
        for d in sorted(edges[c]):
            indeg[d]-=1
            if indeg[d]==0:
                avail.append(d)
                avail.sort(key=lambda x:(infos[x]['box'][0],infos[x]['box'][1],x))
    if len(order)"'!=len(rect_colors): raise AssertionError('"'cycle')
    ranked=sorted(rect_colors,key=cmp_to_key(lambda x,y: ratio_cmp(infos[x],infos[y])))
    recolor={color: bar[i] for i,color in enumerate(ranked)}
    return render(scene.shape,[{'color':c,'box':infos[c]['box']} for c in order], recolor)

def valid_boxes(shape, layers):
    scene=render(shape,layers)
    ratios=[]
    occ_cnt=0
    for item in layers:
        color=item['color']; box=item['box']
        coords=np.argwhere(scene==color)
        if len(coords)==0: return None
        if bbox_of(coords)"'!=box: return None
        r0,c0,r1,c1=box
        reg=scene[r0:r1+1,c0:c1+1]
        if np.any(reg==0): return None
        top=np.any(scene[r0,c0:c1+1]==color)
        bot=np.any(scene[r1,c0:c1+1]==color)
        left=np.any(scene[r0:r1+1,c0]==color)
        right=np.any(scene[r0:r1+1,c1]==color)
        if not (top and bot and left and right): return None
        corners=sum(int(scene[r,c]==color) for r,c in [(r0,c0),(r0,c1),(r1,c0),(r1,c1)])
        if corners<2: return None
        area=(r1-r0+1)*(c1-c0+1)
        occ=area-len(coords)
        if item is not layers[-1] and occ==0: return None
        if occ*100>=area*55: return None
        ratios.append((occ,area))
