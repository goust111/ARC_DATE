+        tail = local[: h - body_h, :]
+        if int(tail.sum()) != h - body_h:
+            return None
+        cols = np.where(np.all(tail, axis=0))[0]
+        if len(cols) != 1:
+            return None
+        if int(local[:, cols[0]].sum()) != h:
+            return None
