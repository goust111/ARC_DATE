+            return None
+        cols = np.where(np.all(tail, axis=0))[0]
+        if len(cols) != 1:
+            return None
+        if int(local[:, cols[0]].sum()) != h:
+            return None
+        return int(cols[0]), h - body_h
+    return None
+
+
+def _detect_object(grid: np.ndarray, frame: FrameInfo, color: int) -> TailObject:
