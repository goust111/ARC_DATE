+from arc_utils import bbox_coords, components_mask, get_bg  # type: ignore  # noqa: E402
+
+
+BG = 0
+FRAME = 6
+GREY = 5
+OBJECT_COLORS = (1, 2, 3, 4, 7, 8, 9)
+BODY_SIZES = ((2, 2), (2, 3), (3, 2))
+DIRECTIONS = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
+}
+MAX_ATTEMPTS = 500
+
+
+@dataclass(frozen=True)
+class FrameInfo:
+    bbox: tuple[int, int, int, int]
+    line_rows: tuple[int, ...]
+    line_cols: tuple[int, ...]
+    n_cells: int
+    cell_size: int
