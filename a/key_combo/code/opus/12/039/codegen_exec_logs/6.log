+    dests = []
+    for obj in objects:
+        r0 = obj["top"]
+        r1 = r0 + obj["height"] - 1
+        width = obj["width"]
+        if side == "left":
+            left = 1
+            while any(_overlap_bbox((r0, left, r1, left + width - 1), prev) for prev in placed):
+                left += width
+        else:
+            left = panel_w - width - 1
+            while any(_overlap_bbox((r0, left, r1, left + width - 1), prev) for prev in placed):
+                left -= width
+        placed.append((r0, left, r1, left + width - 1))
+        dests.append(left)
+    return dests
