+            objects.append(
+                {
+                    "color": color,
+                    "coords": sorted(coords),
+                    "bbox": (r0, c0, r1, c1),
+                    "shape": _normalize(coords),
+                    "height": r1 - r0 + 1,
+                    "width": c1 - c0 + 1,
+                    "top": r0,
+                    "left": c0,
+                }
+            )
