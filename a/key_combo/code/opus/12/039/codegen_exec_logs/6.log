+    else:
+        for _ in range(200):
+            rows = []
+            ok = True
+            for height in heights:
+                row = rng.randint(0, panel_h - height)
+                if any(_overlap_1d(row, row + height - 1, prev, prev + ph - 1) for prev, ph in rows):
