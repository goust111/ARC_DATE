+def _choose_masks(records: list[dict], count: int, rng: np.random.Generator) -> list[dict] | None:
+    requirements = [
+        "tie_multicolor",
+        "diff_no_mirror",
+        "diff_no_reverse",
+        "zone_above",
+        "zone_right",
+        "zone_below",
