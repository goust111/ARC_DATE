+    r0, c0, r1, c1 = box
+    t = int(thickness)
+    patch[r0 : r0 + t, c0 : c1 + 1] = color
+    patch[r1 - t + 1 : r1 + 1, c0 : c1 + 1] = color
+    patch[r0 : r1 + 1, c0 : c0 + t] = color
+    patch[r0 : r1 + 1, c1 - t + 1 : c1 + 1] = color
