+    best_dist = int(dists.min())
+    tied = np.flatnonzero(dists == best_dist)
+    tied_coords = structure_coords[tied]
+    order = np.lexsort((tied_coords[:, 1], tied_coords[:, 0]))
+    best_idx = int(tied[order[0]])
+    chosen = structure_coords[best_idx]
