+        nonlocal best
+        if len(chain) > len(best):
+            best = chain.copy()
+        elif len(chain) == len(best):
+            area = sum(frame["area"] for frame in chain)
+            best_area = sum(frame["area"] for frame in best)
+            if area > best_area:
