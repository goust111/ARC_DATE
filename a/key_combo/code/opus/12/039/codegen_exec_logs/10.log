+        return None
+    rng.shuffle(cells)
+    chosen: list[tuple[int, int]] = []
+    for pos in cells:
+        if all(max(abs(pos[0] - rr), abs(pos[1] - cc)) > 1 for rr, cc in chosen):
+            chosen.append(pos)
+            if len(chosen) == count:
+                return chosen
+    return None
+
+
+def _attempt_generate(rng: np.random.Generator) -> np.ndarray | None:
+    built = _build_nested_patch(rng)
