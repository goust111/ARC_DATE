+    full_patch = _transform_structure(_extract_layers(grid)[1], _extract_layers(grid)[2], mirror=True, reverse=True)
+    no_mirror_patch = _transform_structure(_extract_layers(grid)[1], _extract_layers(grid)[2], mirror=False, reverse=True)
+    no_reverse_patch = _transform_structure(_extract_layers(grid)[1], _extract_layers(grid)[2], mirror=True, reverse=False)
+    records = _candidate_records(grid, grid.shape, outer_bbox, full_patch, no_mirror_patch, no_reverse_patch)
+    mask_count = int(rng.integers(5, 9))
+    masks = _choose_masks(records, mask_count, rng)
+    if masks is None:
+        return None
+
+    for item in masks:
+        r, c = item["pos"]
+        grid[r, c] = GREY
+
+    noise_count = int(rng.integers(2, 5))
+    noise_positions = _noise_cells(grid, outer_bbox, masks, noise_count, rng)
+    if noise_positions is None:
+        return None
+    for r, c in noise_positions:
+        grid[r, c] = int(rng.choice(colors))
