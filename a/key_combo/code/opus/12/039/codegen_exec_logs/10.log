+
+def _frame_mask(shape: tuple[int, int], thickness: int) -> np.ndarray:
+    h, w = shape
+    t = int(thickness)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:t, :] = True
+    mask[h - t :, :] = True
