+def _zone_of(pos: tuple[int, int], nearest: tuple[int, int]) -> str | None:
+    pr, pc = pos
+    nr, nc = nearest
+    if pr < nr:
+        return "above"
+    if pc > nc:
+        return "right"
+    if pr > nr:
+        return "below"
+    if pc < nc:
+        return "left"
+    return None
