+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+_OFFSETS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
