+    full_coords, full_colors = _structure_arrays(outer_bbox, full_patch)
+    nm_coords, nm_colors = _structure_arrays(outer_bbox, no_mirror_patch)
+    nr_coords, nr_colors = _structure_arrays(outer_bbox, no_reverse_patch)
