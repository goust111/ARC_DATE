+
+def _find_best_chain(frames: list[dict]) -> list[dict]:
+    frames = sorted(
+        frames,
+        key=lambda frame: (
+            -((frame["bbox"][2] - frame["bbox"][0] + 1) * (frame["bbox"][3] - frame["bbox"][1] + 1)),
