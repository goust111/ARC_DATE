+        dfs(idx, [frames[idx]])
+    return best
+
+
+def _extract_layers(grid: np.ndarray) -> tuple[tuple[int, int, int, int], list[np.ndarray], list[int]]:
+    mask = (grid != BLACK) & (grid != GREY)
