def _gen_layer_masks(
    out: np.ndarray,
    fg: dict[str, int],
    min_fill: int,
    max_fill: int,
) -> dict[str, np.ndarray] | None:
    masks: dict[str, np.ndarray] = {}
    br_mask = out == fg["BR"]
    if not (min_fill <= int(br_mask.sum()) <= max_fill):
