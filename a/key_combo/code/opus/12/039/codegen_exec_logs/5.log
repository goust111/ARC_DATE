    anchor[picked] = True

    higher = masks["BR"].copy()
    for name in LOWER_PANEL_NAMES:
        visible = out == fg[name]

        base_count = int(visible.sum()) + int(anchor.sum())
        available = int((higher & ~visible & ~anchor).sum())
        low = max(min_fill, base_count)
        high = min(max_fill, base_count + available)
