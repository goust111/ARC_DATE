+
+def _build_expected(tile_in: np.ndarray, legend: dict[int, tuple[frozenset[tuple[int, int]], tuple[int, int]]], rot_k: int) -> np.ndarray:
+    matrix = np.empty(tile_in.shape, dtype=object)
+    for r in range(tile_in.shape[0]):
