def _d4_variants(shape: frozenset[tuple[int, int]], dims: tuple[int, int]):
    h, w = dims
    transforms = (
        lambda r, c: (r, c),
        lambda r, c: (c, h - 1 - r),
        lambda r, c: (h - 1 - r, w - 1 - c),
        lambda r, c: (w - 1 - c, r),
        lambda r, c: (r, w - 1 - c),
        lambda r, c: (h - 1 - r, c),
        lambda r, c: (c, r),
        lambda r, c: (w - 1 - c, h - 1 - r),
