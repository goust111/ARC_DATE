+def _place_blocks(
+    grid: np.ndarray,
+    blocks_r0: int,
+    blocks_c0: int,
+    tile_in: np.ndarray,
+    anchor_color: int,
+    rot_k: int,
+) -> None:
+    row_gap = 1 if tile_in.shape[0] > 1 else 0
+    col_gap = 1 if tile_in.shape[1] > 1 else 0
