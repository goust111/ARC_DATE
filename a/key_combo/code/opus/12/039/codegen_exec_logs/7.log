+    legend: dict[int, tuple[frozenset[tuple[int, int]], tuple[int, int]]] = {}
+    for color in sorted(set(map(int, region.ravel())) - {BG, LEGEND_PANEL}):
+        coords = np.argwhere(region == int(color))
