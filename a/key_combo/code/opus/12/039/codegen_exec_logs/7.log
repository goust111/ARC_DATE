+    col_gap = 1 if tile_in.shape[1] > 1 else 0
+    anchor_cell = tuple(map(int, np.argwhere(tile_in == int(anchor_color))[0]))
+    for r in range(tile_in.shape[0]):
+        for c in range(tile_in.shape[1]):
