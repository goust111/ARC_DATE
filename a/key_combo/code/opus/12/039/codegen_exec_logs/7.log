+
+BG = 0
+LEGEND_PANEL = 8
+ANCHOR_MARKER = 7
+PATTERN_BG = 9
+BLOCK_SIZE = 5
+LEGEND_COLORS = (1, 2, 3, 4)
+PANEL_SLOTS = ((1, 1), (1, 4), (4, 1), (4, 4))
