+    blocked_directions = 0
+    allowed_directions = 0
+    mixed_edge_exists = False
+    fully_free_exists = False
+
+    for r, c in map(tuple, np.argwhere(blue)):
+        r = int(r)
+        c = int(c)
+        dirs = _edge_directions(blue, r, c)
+        if not dirs:
