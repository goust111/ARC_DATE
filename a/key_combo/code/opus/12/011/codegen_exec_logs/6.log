        w = random.choice([ww for hh, ww in pairs if hh == h])
    else:
        widths = sorted({w for _h, w in pairs})
        w = random.choice(widths)
        h = random.choice([hh for hh, ww in pairs if ww == w])
    return int(h), int(w)


