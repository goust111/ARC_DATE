+    block_r, block_c, _dirs, in_bounds_dirs = random.choice(mixed_edge_candidates)
+    grey_cells = {(random.choice(in_bounds_dirs)[1], random.choice(in_bounds_dirs)[2])}
+
+    # Re-pick carefully so row/col stay matched.
+    direction_name, gr, gc = random.choice(in_bounds_dirs)
+    grey_cells = {(gr, gc)}
+
+    # Keep one edge pixel entirely free of grey on all of its outward sides.
+    free_candidates = []
+    for r, c, dirs in edge_cells:
+        outward_neighbors = []
+        blocked = False
+        for name, dr, dc in DIR_ORDER:
+            if name not in dirs:
+                continue
+            nr, nc = r + dr, c + dc
+            if _in_bounds(nr, nc, blue_mask.shape):
+                outward_neighbors.append((nr, nc))
+            if (nr, nc) in grey_cells:
+                blocked = True
+                break
+        if not blocked:
+            free_candidates.append((r, c, outward_neighbors))
+    if not free_candidates:
+        return None
+
+    adjacent = list(_adjacent_candidates(shape) - grey_cells)
+    random.shuffle(adjacent)
+    target_grey_count = random.randint(1, 3)
+    for cell in adjacent:
+        if len(grey_cells) >= target_grey_count:
+            break
+        if any(cell in neighbors for _r, _c, neighbors in free_candidates):
+            continue
+        grey_cells.add(cell)
