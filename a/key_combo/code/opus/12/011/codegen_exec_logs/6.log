    mask = g != bg
    coords = np.argwhere(mask)
    assert len(coords) > 0

    out = np.full((n * (n + 2), n * (n + 2)), bg, dtype=int)

    def paint_pattern(top: int, left: int) -> None:
        assert 0 <= top <= out.shape[0] - n
        assert 0 <= left <= out.shape[1] - n
        for rr, cc in coords:
            out[top + int(rr), left + int(cc)] = fg

