+    variants: set[tuple[tuple[int, int], ...]] = set()
+    for k in range(4):
+        rotated = np.rot90(mask, k)
+        for arr in (rotated, np.fliplr(rotated)):
+            coords = tuple(sorted((int(r), int(c)) for r, c in np.argwhere(arr)))
+            variants.add(_normalize_cells(coords))
