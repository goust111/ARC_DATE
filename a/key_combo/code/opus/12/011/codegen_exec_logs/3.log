+def _selected_components(grid: np.ndarray) -> tuple[tuple[int, int, int, int], tuple[tuple[int, int], ...], list[dict], list[dict]]:
+    frame_bbox, template_shape = _frame_bbox_and_template(grid)
+    r0, c0, r1, c1 = frame_bbox
