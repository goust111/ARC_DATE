+    r1, c1 = coords.max(axis=0)
+    frame_cells = {(int(r), int(c)) for r, c in coords}
+    expected = {(r1, c) for c in range(c0, c1 + 1)} | {(r, c1) for r in range(r0, r1 + 1)}
