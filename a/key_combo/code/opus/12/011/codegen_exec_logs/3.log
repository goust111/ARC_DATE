+    if np.array_equal(out, base_match_grid):
+        return None
+    return full_input
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

