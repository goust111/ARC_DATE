+    if not aligned and not _place_shape(distractors, blocked, first_shape, external_colors[match_count], h, w):
+        return None
+
+    while len(distractors) < distractor_count:
+        idx = len(distractors)
+        if not _place_shape(
+            distractors,
+            blocked,
+            distractor_shapes[idx],
+            external_colors[match_count + idx],
+            h,
+            w,
+        ):
