+    for size in range(2, max_cells + 1):
+        prev = shapes_by_size[size - 1]
+        cur: set[tuple[tuple[int, int], ...]] = set()
+        for shape in prev:
+            cells = set(shape)
+            frontier = set()
+            for r, c in shape:
+                frontier.update(_neighbors4(r, c))
+            for nr, nc in frontier - cells:
