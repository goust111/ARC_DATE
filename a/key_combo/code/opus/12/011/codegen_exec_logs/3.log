+def _normalize_cells(cells: set[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    pts = list(cells)
+    r0 = min(r for r, _c in pts)
+    c0 = min(c for _r, c in pts)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in pts))
