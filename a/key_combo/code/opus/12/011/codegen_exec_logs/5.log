        if len(nxt) != 1 or len(path) > len(pts):
            return None
        prev, cur = cur, nxt[0]
    return path if len(path) == len(pts) else None


def _gen_cycle_metrics(mask):
    path = _gen_trace_cycle(mask)
    if path is None:
        return None
    counts = {1: 0, -1: 0}
    n = len(path)
