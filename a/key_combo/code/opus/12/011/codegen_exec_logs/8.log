+
+def _decorate_barrier_column(
+    grid: np.ndarray,
+    outer: tuple[int, int, int, int],
+    inner: tuple[int, int, int, int],
+    c: int,
+) -> None:
+    lr0, _lc0, lr1, _lc1 = outer
+    ir0, _ic0, ir1, _ic1 = inner
+    bottom = lr1 - 1
+
+    base = _place_seed(grid, bottom, c)
+
