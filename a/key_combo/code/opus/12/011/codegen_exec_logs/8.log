+def _ignore_barriers(crop: np.ndarray) -> np.ndarray:
+    out = crop.copy()
+    h, w = crop.shape
+    marker_row = h - 2
+    marked_cols = [c for c in range(w) if int(crop[marker_row, c]) not in (BG, RED)]
+    for c in marked_cols:
