+
+    return (
+        lr0 + top_margin,
+        lc0 + left_margin,
+        lr1 - bottom_margin,
+        lc1 - right_margin,
+    )
+
+
+def _random_outside_frame(
+    shape: tuple[int, int],
+    forbidden: list[tuple[int, int, int, int]],
+    largest_area: int,
+) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    max_area = largest_area * 2 // 3
+    for _ in range(120):
