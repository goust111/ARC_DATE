+    starts = _slot_starts(k)
+
+    non_bg_colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    solid_rects = []
+    for color in non_bg_colors:
+        mask = g == int(color)
+        box = _bbox(mask)
+        if box is None:
