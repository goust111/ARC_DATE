+    separator_cells = []
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != GEN_BG:
+                continue
+            if any((nr, nc) in chosen for nr, nc in _neighbor_coords(r, c, grid.shape)):
+                continue
+            target = separator_cells if r in sep_rows or c in sep_cols else slot_cells
+            target.append((int(r), int(c)))
