+def _valid_configs(mask: np.ndarray) -> list[tuple[str, str, int]]:
+    k = mask.shape[0]
+    configs: list[tuple[str, str, int]] = []
+    corner_locs = {
+        "TL": (0, 0),
+        "TR": (0, k - 1),
+        "BL": (k - 1, 0),
+        "BR": (k - 1, k - 1),
