+        "TR": (0, w - 1),
+        "BL": (h - 1, 0),
+        "BR": (h - 1, w - 1),
+    }
+
+
+def _distance_sum(shape: tuple[int, int], corner: str, r: int, c: int) -> int:
+    h, w = shape
+    if corner == "TL":
+        return int(r + c)
+    if corner == "TR":
+        return int(r + (w - 1 - c))
+    if corner == "BL":
+        return int((h - 1 - r) + c)
+    assert corner == "BR"
+    return int((h - 1 - r) + (w - 1 - c))
