+
+
+def _apply_occluder(grid: np.ndarray, k: int, axis: str, idx: int, color: int) -> None:
+    start = _slot_starts(k)[idx]
+    if axis == "row":
+        grid[start : start + k, :] = int(color)
+    else:
+        grid[:, start : start + k] = int(color)
+
