+        return int(r + c)
+    if corner == "TR":
+        return int(r + (w - 1 - c))
+    if corner == "BL":
+        return int((h - 1 - r) + c)
+    assert corner == "BR"
+    return int((h - 1 - r) + (w - 1 - c))
+
+
+def _paint_triangle(grid: np.ndarray, corner: str, side: int, color: int) -> None:
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if _distance_sum((h, w), corner, r, c) < int(side):
+                grid[r, c] = int(color)
