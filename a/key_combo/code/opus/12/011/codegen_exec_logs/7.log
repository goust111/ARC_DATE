+GEN_BG = 0
+GEN_CONTROL = 1
+GEN_SPRITE = 2
+GEN_OCCLUDER = 7
+
+GEN_K_CHOICES = (3, 4)
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _infer_k(size: int) -> int:
+    for k in range(2, 6):
+        if k * (k + 1) - 1 == int(size):
+            return int(k)
+    raise AssertionError(f"unsupported lattice size: {size}")
