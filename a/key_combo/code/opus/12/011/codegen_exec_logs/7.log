+def _place_controls(grid: np.ndarray, corner_rc: tuple[int, int], count: int) -> bool:
+    chosen = {tuple(map(int, corner_rc))}
+    grid[corner_rc] = GEN_CONTROL
+    for _ in range(count - 1):
+        pool = _blue_pool(grid, chosen)
+        if not pool:
