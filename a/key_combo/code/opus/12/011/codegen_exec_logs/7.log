+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                out.append((int(rr), int(cc)))
+    return out
+
+
+def _blue_pool(grid: np.ndarray, chosen: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    h, w = grid.shape
