67: def main(grid: np.ndarray) -> np.ndarray:
68:     """
69:     Copy colored control-ray ports from one rectangular sprite orientation to every matching transformed sprite.
70: 
71:     Input structure:
72:     - bg is the most common color.
73:     - Several dense 2-by-N or N-by-2 rectangular sprites are dihedral transforms of one template.
74:     - Isolated single-pixel control markers sit on rays projected outward from the dominant long edge of some sprites.
75: 
76:     Rule:
77:     - For each sprite, the active edge is the long side whose cells have the strongest same-color majority.
78:     - A control marker seen first along an outward ray from an active-edge cell assigns its color to that template cell.
79:     - On every transformed sprite, draw that assigned color outward from the corresponding active-edge cell through bg cells until blocked or out of bounds.
80: 
81:     Key insight:
82:     - The marker positions are not absolute; they label cells of a shared rectangular template, then the labels follow each sprite's rotation/reflection.
83:     """
84:     g = np.asarray(grid, dtype=int)
85:     bg = int(get_bg(g))
86:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False)
87: 
88:     sprites_raw: list[dict] = []
89:     markers: dict[tuple[int, int], int] = {}
90:     for comp in comps:
91:         r0, c0, r1, c1 = map(int, comp["bbox"])
92:         h = r1 - r0 + 1
93:         w = c1 - c0 + 1
94:         area = int(comp["area"])
95:         if area == 1:
96:             r, c = map(int, comp["coords"][0])
97:             markers[(r, c)] = int(g[r, c])
98:         else:
99:             assert area == h * w, "sprite components must be dense rectangles"
100:             sprites_raw.append({"bbox": (r0, c0, r1, c1), "sub": crop_bbox(g, (r0, c0, r1, c1))})
101: 
102:     assert len(sprites_raw) >= 2, "expected multiple transformed rectangular sprites"
103:     assert markers, "expected isolated control markers"
104:     assert len(set(markers.values())) == len(markers), "control marker colors must be unique"
105: 
106:     variants = _dihedral_variants(sprites_raw[0]["sub"])
107:     sprites = []
108:     for sprite in sprites_raw:
109:         matches = [
110:             (ids, name)
111:             for name, sub, ids in variants
112:             if sub.shape == sprite["sub"].shape and np.array_equal(sub, sprite["sub"])
113:         ]
114:         assert len(matches) == 1, "each sprite must match the template in exactly one orientation"
115:         ids, _name = matches[0]
116:         direction, active = _active_side(sprite["sub"])
117:         sprites.append({**sprite, "ids": ids, "direction": direction, "active": active})
118: 
119:     color_to_template_id: dict[int, int] = {}
120:     template_id_to_color: dict[int, int] = {}
121:     for sprite in sprites:
122:         r0, c0, _r1, _c1 = sprite["bbox"]
123:         dr, dc = sprite["direction"]
124:         for lr, lc in sprite["active"]:
125:             marker_color = _first_marker_on_ray(g, bg, markers, r0 + lr, c0 + lc, dr, dc)
126:             if marker_color is None:
127:                 continue
128:             template_id = int(sprite["ids"][lr, lc])
129:             if marker_color in color_to_template_id:
130:                 assert color_to_template_id[marker_color] == template_id
131:             if template_id in template_id_to_color:
132:                 assert template_id_to_color[template_id] == marker_color
133:             color_to_template_id[marker_color] = template_id
134:             template_id_to_color[template_id] = marker_color
135: 
136:     assert set(color_to_template_id) == set(markers.values()), "every control marker must label one active-edge cell"
137: 
138:     out = g.copy()
139:     H, W = g.shape
140:     for sprite in sprites:
141:         r0, c0, _r1, _c1 = sprite["bbox"]
142:         dr, dc = sprite["direction"]
143:         for color, template_id in color_to_template_id.items():
144:             locs = np.argwhere(sprite["ids"] == template_id)
145:             assert locs.shape[0] == 1
146:             lr, lc = map(int, locs[0])
147:             assert (lr, lc) in sprite["active"], "mapped port must land on the sprite active edge"
148: 
149:             r = r0 + lr + dr
150:             c = c0 + lc + dc
151:             while 0 <= r < H and 0 <= c < W:
152:                 if int(g[r, c]) != bg:
153:                     break
154:                 assert int(out[r, c]) in (bg, color), "control rays must not conflict"
155:                 out[r, c] = color
156:                 r += dr
157:                 c += dc
158: 
159:     return out
