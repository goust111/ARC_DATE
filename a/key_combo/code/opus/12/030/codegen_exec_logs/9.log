+# --------------- generator ---------------
+
+_GEN_RETRIES = 400
+
+
+def _random_shape(rng: np.random.Generator, *, force_complex: bool) -> tuple[np.ndarray, bool]:
+    choices = list(_BASE_SHAPES)
+    rng.shuffle(choices)
