131: def _line_mask(h: int, w: int) -> np.ndarray:
132:     """Create a seed mask along a diagonal line spanning the bbox, randomly flipped."""
133:     mask = np.zeros((h, w), dtype=bool)
134:     if h == 1:
135:         mask[0, :] = True
136:         return mask
137:     if w == 1:
138:         mask[:, 0] = True
139:         return mask
140:     steps = max(h, w)
141:     for i in range(steps):
142:         r = int(round(i * (h - 1) / (steps - 1)))
143:         c = int(round(i * (w - 1) / (steps - 1)))
144:         mask[r, c] = True
145:     if bool(_RNG.integers(0, 2)):
146:         mask = np.flipud(mask)
147:     if bool(_RNG.integers(0, 2)):
148:         mask = np.fliplr(mask)
149:     return mask
