162: 
163: # --- CFG: tuneable generation parameters ---
164: _BG = 8
165: _NON_BG_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]  # all colors except bg
166: _GRID_H_RANGE = (21, 29)           # canvas height bounds
167: _GRID_W_RANGE = (27, 29)           # canvas width bounds
168: _TEMPLATE_N_RANGE = (7, 9)         # long dimension of the Nx2 template
169: _TEMPLATE_COLOR_COUNT = (3, 4)     # distinct colors in the template
170: _ACTIVE_MAJORITY_RANGE = (5, 9)    # majority count on the active edge
171: _SPRITE_COUNT_RANGE = (3, 4)       # number of sprites to place
172: _NUM_MARKERS = 3                   # control markers to place
173: _PLACEMENT_PAD = 2                 # min gap between sprites
174: _PLACEMENT_CLEARANCE = 2           # min ray clearance from boundary to sprite edge
175: _PLACEMENT_RETRIES = 100           # random placement attempts per sprite
176: _GEN_RETRIES = 300                 # outer retry budget
177: 
178: 
179: def _build_column(n: int, colors: list[int], majority: int, dominant: int) -> list[int]:
180:     """Build a column of length *n* with *dominant* appearing exactly *majority* times."""
181:     col = [dominant] * majority
182:     others = [c for c in colors if c != dominant]
183:     fill = others if others else colors
184:     for _ in range(n - majority):
185:         col.append(random.choice(fill))
186:     random.shuffle(col)
