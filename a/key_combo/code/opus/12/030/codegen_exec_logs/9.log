+        coords = np.asarray(obj["coords"], dtype=int)
+        r0, _c0, r1, _c1 = map(int, obj["bbox"])
+        color = int(obj["color"])
+        dr = 1 - r0 if color == BLUE else (h - 2) - r1
+        moved = coords + np.array([dr, 0], dtype=int)
+        assert np.all(out[moved[:, 0], moved[:, 1]] == BG)
+        out[moved[:, 0], moved[:, 1]] = color
