+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _has_row_width_variation(coords: np.ndarray) -> bool:
+    rows = coords[:, 0]
+    widths = [int(np.sum(rows == r)) for r in np.unique(rows)]
+    return len(widths) >= 2 and len(set(widths)) >= 2
