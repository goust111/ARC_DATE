+def _slide_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = np.full_like(g, BG)
+    out[0, :] = BLUE
+    out[h - 1, :] = RED
