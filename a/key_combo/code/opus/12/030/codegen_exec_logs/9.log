+def _mark_foreground_columns(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    selected = np.any(out[1:-1, :] != BG, axis=0)
+    out[(out == BG) & selected[np.newaxis, :]] = MARK
+    return out
