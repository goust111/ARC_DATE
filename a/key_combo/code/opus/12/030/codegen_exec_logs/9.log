  grid: 2-6 rows x 2-6 cols, square [observed]
  background: black (0)
  foreground:
    color: exactly 1 non-background color, not teal (8)
    count: 1-3 pixels, sparse (<=~25% of cells)
    placement: at most 1 fg pixel per column [observed]; at least 1 column has no fg
