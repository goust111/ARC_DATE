        for length in LEGEND_LEN_RANGE:
            remaining = count - len(prefix) - 1
            if sum(prefix) + length + LEGEND_LEN_RANGE.start * remaining > max_total:
                continue
            rec(prefix + [length])

    rec([])
    return options


