+    placements = (
+        (0, 0, crops[0]),
+        (0, left_w, crops[1]),
+        (top_h, 0, crops[2]),
+        (top_h, left_w, crops[3]),
+    )
+    for r0, c0, crop in placements:
+        h, w = crop.shape
+        out[r0 : r0 + h, c0 : c0 + w] = crop
