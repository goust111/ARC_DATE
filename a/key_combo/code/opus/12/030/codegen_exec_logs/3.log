+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    top_h, bottom_h, left_w, right_w = _sample_crop_dims(rng)
+    dims = [
+        (top_h, left_w),
+        (top_h, right_w),
+        (bottom_h, left_w),
+        (bottom_h, right_w),
