+    colors = [color for _crop_grid, color in crops_and_colors]
+
+    processed = []
+    for idx, (crop, _color) in enumerate(crops_and_colors):
+        processed.append(_fill_square_holes(crop, colors[DIAGONAL_INDEX[idx]]))
