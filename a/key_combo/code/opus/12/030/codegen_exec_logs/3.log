+def _extract_sprite_crop(region: np.ndarray) -> tuple[np.ndarray, int]:
+    colors = sorted(int(v) for v in np.unique(region) if int(v) != BG)
+    assert len(colors) == 1
+    box = _bbox_from_mask(region != BG)
+    assert box is not None
