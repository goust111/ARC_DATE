+    pattern = candidates[int(rng.integers(0, len(candidates)))]
+    ph, pw = pattern.shape
+    hole = np.zeros((height, width), dtype=bool)
+    r0 = int(rng.integers(1, height - ph))
+    c0 = int(rng.integers(1, width - pw))
+    hole[r0 : r0 + ph, c0 : c0 + pw] = pattern
