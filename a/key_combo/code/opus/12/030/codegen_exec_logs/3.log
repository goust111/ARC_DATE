+            return top_h, bottom_h, left_w, right_w
+
+
+def _expected_from_specs(crops: list[np.ndarray], colors: list[int], square_flags: list[bool]) -> np.ndarray:
+    filled = []
+    for idx, crop in enumerate(crops):
+        out = crop.copy()
+        if square_flags[idx]:
