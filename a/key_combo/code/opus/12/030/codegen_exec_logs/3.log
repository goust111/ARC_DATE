+
+
+def _build_crop(height: int, width: int, color: int, square_hole: bool, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(120):
+        hole_mask = (
+            _square_hole_pattern(height, width, rng)
+            if square_hole
