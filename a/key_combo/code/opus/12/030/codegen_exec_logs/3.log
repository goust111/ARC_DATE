+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4)
+SEPARATOR = 5
+QUADRANT_ORDER = ("ul", "ur", "ll", "lr")
+DIAGONAL_INDEX = {0: 3, 1: 2, 2: 1, 3: 0}
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in NEIGHBORS4:
+        yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _boundary_zero_reachable(zero_mask: np.ndarray) -> np.ndarray:
+    h, w = zero_mask.shape
+    reachable = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if zero_mask[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if zero_mask[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(zero_mask.shape, nr, nc) and zero_mask[nr, nc] and not reachable[nr, nc]:
+                reachable[nr, nc] = True
+                stack.append((nr, nc))
+    return reachable
+
+
+def _hole_components(crop: np.ndarray) -> list[np.ndarray]:
+    zero_mask = crop == BG
+    exterior = _boundary_zero_reachable(zero_mask)
+    holes = zero_mask & ~exterior
+    return _component_coords(holes)
+
+
+def _is_solid_square(coords: np.ndarray) -> bool:
+    if coords.size == 0:
+        return False
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height != width:
+        return False
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in coords:
+        mask[int(r - r0), int(c - c0)] = True
+    return bool(mask.all())
+
