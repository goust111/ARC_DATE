+    bottom_h = max(crops[2].shape[0], crops[3].shape[0])
+    left_w = max(crops[0].shape[1], crops[2].shape[1])
+    right_w = max(crops[1].shape[1], crops[3].shape[1])
+    out = np.zeros((top_h + bottom_h, left_w + right_w), dtype=int)
