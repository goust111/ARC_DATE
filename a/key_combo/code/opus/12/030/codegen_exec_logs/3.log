+        top_h = int(rng.integers(5, 8))
+        bottom_h = int(rng.integers(5, 8))
+        left_w = int(rng.integers(5, 8))
+        right_w = int(rng.integers(5, 8))
+        dims = (
+            (top_h, left_w),
+            (top_h, right_w),
+            (bottom_h, left_w),
+            (bottom_h, right_w),
+        )
+        if all(dim in ALLOWED_DIMS for dim in dims):
+            return top_h, bottom_h, left_w, right_w
