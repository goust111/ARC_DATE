+
+def _quadrant_regions(grid: np.ndarray, cross_r: int, cross_c: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    return [
+        grid[:cross_r, :cross_c],
+        grid[:cross_r, cross_c + 1 : w],
+        grid[cross_r + 1 : h, :cross_c],
+        grid[cross_r + 1 : h, cross_c + 1 : w],
+    ]
+
