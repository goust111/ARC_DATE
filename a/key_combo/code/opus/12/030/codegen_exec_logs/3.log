+        (0, 0, cross_r, cross_c),
+        (0, cross_c + 1, cross_r, w - cross_c - 1),
+        (cross_r + 1, 0, h - cross_r - 1, cross_c),
+        (cross_r + 1, cross_c + 1, h - cross_r - 1, w - cross_c - 1),
+    ]
