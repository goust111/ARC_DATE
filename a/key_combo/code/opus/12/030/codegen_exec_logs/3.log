+
+IRREGULAR_PATTERNS = (
+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1], [0, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[1, 0], [1, 1], [0, 1]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1], [0, 0, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0], [1, 0, 0]], dtype=bool),
+)
+
+ALLOWED_DIMS = {
