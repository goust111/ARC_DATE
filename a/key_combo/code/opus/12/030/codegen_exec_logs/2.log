+def _layer_centers(layers: list[dict]) -> set[tuple[float, float]]:
+    centers = set()
+    for layer in layers:
+        r0, c0, r1, c1 = layer["bbox"]
+        centers.add(((r0 + r1) / 2.0, (c0 + c1) / 2.0))
+    return centers
+
