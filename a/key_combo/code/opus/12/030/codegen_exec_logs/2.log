+    layers: list[np.ndarray] = []
+    for idx, mask in enumerate(filled_masks):
+        if idx == len(filled_masks) - 1:
+            layers.append(mask.copy())
+        else:
+            layers.append(mask & ~filled_masks[idx + 1])
+    return layers
+
