+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _is_rot90_symmetric(mask: np.ndarray) -> bool:
+    cropped = _crop_mask(mask)
+    if cropped.size == 0 or cropped.shape[0] != cropped.shape[1]:
+        return False
+    return bool(np.array_equal(cropped, np.rot90(cropped)))
+
+
+def _extract_layers(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    layers: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(g) if int(c) != 0):
+        comps = _component_coords(g == color)
+        for coords in comps:
+            bbox = _bbox_from_coords(coords)
+            r0, c0, r1, c1 = bbox
+            layers.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "bbox_area": (r1 - r0 + 1) * (c1 - c0 + 1),
+                    "area": int(coords.shape[0]),
+                }
