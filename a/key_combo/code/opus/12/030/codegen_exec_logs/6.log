+    if sorted(node["depth"] for node in path_nodes) != [1, 2, 3]:
+        return None
+    if info["shortest_length"] != 4 or info["shortest_count"] != 1:
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+
+    return inp, expected
+
+
