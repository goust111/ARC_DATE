+
+def _terminal_sprite(size: int) -> np.ndarray:
+    return np.full((size, size), RED, dtype=int)
+
+
+def _place_node(
+    grid: np.ndarray,
+    cell: tuple[int, int],
+    sprite: np.ndarray,
+    rng: random.Random,
+) -> tuple[int, int, int, int]:
+    size = sprite.shape[0]
+    base_r = 2 + cell[0] * PITCH
+    base_c = 2 + cell[1] * PITCH
+    if size == 3:
+        off_r = off_c = 1
+    elif size == 4:
+        off_r = rng.choice([0, 1])
+        off_c = rng.choice([0, 1])
