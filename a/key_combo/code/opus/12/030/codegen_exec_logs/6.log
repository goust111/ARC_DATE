+
+
+def _detour_candidates(path: list[tuple[int, int]], rows: int, cols: int) -> list[tuple[int, tuple[int, int], tuple[int, int]]]:
+    occupied = set(path)
+    out = []
+    for i, (a, b) in enumerate(zip(path, path[1:], strict=False)):
+        ar, ac = a
+        br, bc = b
+        if ar == br:
+            c0 = min(ac, bc)
+            for dr in (-1, 1):
+                x = (ar + dr, c0)
+                y = (ar + dr, c0 + 1)
