+    q = deque([start])
+    dist = {start: 0}
+    count = {start: 1}
+    prev_node = {start: None}
+    prev_edge = {start: None}
+
+    while q:
+        cur = q.popleft()
+        for nxt, edge_id in adjacency[cur]:
+            nd = dist[cur] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                count[nxt] = count[cur]
+                prev_node[nxt] = cur
+                prev_edge[nxt] = edge_id
+                q.append(nxt)
+            elif dist[nxt] == nd:
+                count[nxt] += count[cur]
