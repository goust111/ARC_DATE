+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DEPTH_TO_COLOR = {1: GREEN, 2: YELLOW, 3: ORANGE}
+INNER_COLORS = [YELLOW, GREY, TEAL, MAROON]
+PITCH = 7
+SLOT = 5
+CANVAS = 30
