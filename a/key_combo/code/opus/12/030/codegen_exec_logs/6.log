+                y = (r0 + 1, ac + dc)
+                if 0 <= x[1] < cols and 0 <= y[1] < cols and x not in occupied and y not in occupied:
+                    out.append((i, x, y))
+    return out
+
+
+def _edge_key(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    return (a, b) if a < b else (b, a)
+
+
+def _shortest_stats(
+    adjacency: dict[tuple[int, int], list[tuple[int, int]]],
+    start: tuple[int, int],
+    goal: tuple[int, int],
+) -> tuple[int, int]:
+    q = deque([start])
+    dist = {start: 0}
+    count = {start: 1}
+    while q:
+        cur = q.popleft()
+        for nxt in adjacency[cur]:
+            nd = dist[cur] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                count[nxt] = count[cur]
+                q.append(nxt)
+            elif dist[nxt] == nd:
+                count[nxt] += count[cur]
+    return dist[goal], count[goal]
+
+
+def _count_simple_paths(
+    adjacency: dict[tuple[int, int], list[tuple[int, int]]],
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    limit: int = 3,
+) -> int:
+    total = 0
+
+    def dfs(cur: tuple[int, int], seen: set[tuple[int, int]]):
+        nonlocal total
+        if total >= limit:
+            return
+        if cur == goal:
+            total += 1
+            return
+        for nxt in adjacency[cur]:
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            dfs(nxt, seen)
+            seen.remove(nxt)
+
+    dfs(start, {start})
+    return total
+
+
+def _choose_size(depth: int, rng: random.Random) -> int:
+    if depth == 3:
+        return 5
+    if depth == 2:
+        return rng.choice([4, 5])
+    return rng.choice([3, 4, 5])
+
+
+def _station_sprite(depth: int, size: int, rng: random.Random) -> np.ndarray:
+    sprite = np.full((size, size), BLUE, dtype=int)
