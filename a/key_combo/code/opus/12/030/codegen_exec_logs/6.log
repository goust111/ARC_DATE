+    return r0, c0, r1, c1
+
+
+def _route_edge(
+    grid: np.ndarray,
+    box_a: tuple[int, int, int, int],
+    box_b: tuple[int, int, int, int],
+) -> list[tuple[int, int]]:
+    ar0, ac0, ar1, ac1 = box_a
+    br0, bc0, br1, bc1 = box_b
+    pixels = []
+    if ar0 <= br1 and br0 <= ar1 and ac1 < bc0:
