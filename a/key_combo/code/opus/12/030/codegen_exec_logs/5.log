+    def order_key(idx: int) -> tuple[int, int]:
+        overlap, disjoint = offset_choices[idx]
+        preferred = overlap if preferred_group[idx] == "overlap" else disjoint
+        return (0 if forced[idx] else 1, len(preferred))
