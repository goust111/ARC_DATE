+
+def _render_final_grid(h: int, w: int, objects: list[dict]) -> np.ndarray:
+    out = np.full((h, w), BG, dtype=int)
+    out[0, :] = TOP
+    out[h - 1, :] = BOTTOM
+    for obj in objects:
