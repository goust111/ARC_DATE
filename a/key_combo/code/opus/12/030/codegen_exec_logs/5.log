+    order = sorted(range(len(objects)), key=order_key)
+
+    grid = np.full((h, w), BG, dtype=int)
+    grid[0, :] = TOP
+    grid[h - 1, :] = BOTTOM
+    occupied = np.zeros((h, w), dtype=bool)
+    offsets: dict[int, int] = {}
