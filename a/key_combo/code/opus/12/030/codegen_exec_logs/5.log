+def _offset_buckets(obj: dict, h: int) -> tuple[list[int], list[int]]:
+    coords = np.asarray(obj["final_coords"], dtype=int)
+    if obj["side"] == "top":
+        max_shift = (h - 2) - int(coords[:, 0].max())
+    else:
+        max_shift = int(coords[:, 0].min()) - 1
