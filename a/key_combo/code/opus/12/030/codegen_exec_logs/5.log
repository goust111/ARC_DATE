+def _shift_input_coords(obj: dict, offset: int) -> np.ndarray:
+    dr = int(offset) if obj["side"] == "top" else -int(offset)
+    return np.asarray(obj["final_coords"], dtype=int) + np.array([dr, 0], dtype=int)
