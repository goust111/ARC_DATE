+GEN_HEIGHT_RANGE = (16, 22)
+GEN_WIDTH_RANGE = (16, 22)
+GEN_COUNT_CHOICES = (2, 3, 4)
+GEN_SHAPE_HEIGHT_RANGE = (2, 4)
+GEN_SHAPE_WIDTH_RANGE = (2, 5)
+GEN_AREA_RANGE = (3, 8)
+GEN_SHAPE_ATTEMPTS = 100
+GEN_PLACE_ATTEMPTS = 200
+GEN_BUILD_ATTEMPTS = 400
