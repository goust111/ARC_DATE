+    disjoint_offsets: list[int] = []
+    for offset in range(1, max_shift + 1):
+        shifted = _shift_input_coords(obj, offset)
+        shifted_set = {tuple(map(int, rc)) for rc in shifted}
+        if final_set & shifted_set:
