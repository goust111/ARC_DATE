+def _mask_from_signature(sig: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = max(r for r, _ in sig) + 1
+    w = max(c for _, c in sig) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in sig:
+        mask[r, c] = True
+    return mask
+
+
