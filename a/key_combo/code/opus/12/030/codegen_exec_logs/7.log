+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+REFERENCE_COLORS = (1, 2, 3, 8, 9)
+OUTSIDE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+MIN_GRID = 22
