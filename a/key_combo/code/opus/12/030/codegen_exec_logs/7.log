+def _find_free_rect(occupied: np.ndarray, h: int, w: int, margin: int) -> tuple[int, int] | None:
+    H, W = occupied.shape
+    positions = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
+    random.shuffle(positions)
+    for r, c in positions:
+        r0 = max(0, r - margin)
+        c0 = max(0, c - margin)
