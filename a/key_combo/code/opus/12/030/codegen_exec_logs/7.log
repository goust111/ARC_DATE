+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color not in allowed_colors:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
