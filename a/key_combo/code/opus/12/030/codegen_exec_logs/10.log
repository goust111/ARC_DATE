0199: def _place_frames(rng: random.Random, h: int, w: int, n_frames: int) -> list[tuple[int, int, int, int]] | None:
0200:     frames: list[tuple[int, int, int, int]] = []
0201:     for _ in range(250):
0202:         inner_h = rng.randint(3, 5)
0203:         inner_w = rng.randint(3, 5)
0204:         outer_h = inner_h + 2
0205:         outer_w = inner_w + 2
0206:         r0 = rng.randint(1, h - outer_h - 1)
0207:         c0 = rng.randint(1, w - outer_w - 1)
0208:         frame = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
0209:         if any(_boxes_too_close(frame, other) for other in frames):
0210:             continue
0211:         frames.append(frame)
0212:         if len(frames) == n_frames:
0213:             return sorted(frames)
0214:     return None
