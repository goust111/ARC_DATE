0142: def main(grid: np.ndarray) -> np.ndarray:
0143:     """
0144:     Fill each hollow blue frame according to how many red diagonal connections cross its interior.
0145: 
0146:     Input structure:
0147:     - A black background contains several blue one-cell-thick hollow rectangular frames.
0148:     - Four to eight red single pixels act as diagonal endpoints, with each valid pair lying on one shared 45-degree or 135-degree diagonal.
0149:     - Red endpoints start outside every frame, while the implied diagonal connections may pass through frame interiors.
0150: 
0151:     Rule:
0152:     - Pair red endpoints whenever exactly two red pixels share the same `r-c` or `r+c` diagonal invariant.
0153:     - Draw each pair's red diagonal segment between its endpoints, but do not overwrite blue frame-border pixels.
0154:     - For every blue frame, count how many distinct red segments have at least one pixel strictly inside that frame.
0155:     - Keep count-0 interiors black, fill only black interior cells green for count 1, and yellow for count 2 or more.
0156: 
0157:     Key insight:
0158:     - The blue rectangles are passive detectors: their fill color depends on external diagonal events, not on the frames' own geometry.
0159:     """
0160:     g = np.asarray(grid, dtype=int)
0161:     out = g.copy()
0162: 
0163:     frames = _find_frames(g)
0164:     pairs = _pair_red_pixels(g)
0165:     paths = [_diag_path(a, b) for a, b in pairs]
0166: 
0167:     for path in paths:
0168:         for r, c in path:
0169:             if int(out[r, c]) != BLUE:
0170:                 out[r, c] = RED
0171: 
0172:     counts = _intersection_counts(frames, paths)
0173:     for (r0, c0, r1, c1), count in zip(frames, counts):
0174:         fill = BLACK if count == 0 else GREEN if count == 1 else YELLOW
0175:         if fill == BLACK:
0176:             continue
0177:         for r in range(r0 + 1, r1):
0178:             for c in range(c0 + 1, c1):
0179:                 if int(out[r, c]) == BLACK:
0180:                     out[r, c] = fill
0181: 
0182:     return out
0183: 
0184: 
0185: def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = FRAME_GAP) -> bool:
0186:     ar0, ac0, ar1, ac1 = a
0187:     br0, bc0, br1, bc1 = b
0188:     return not (ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0)
