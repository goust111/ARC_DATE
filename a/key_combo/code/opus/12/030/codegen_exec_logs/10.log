0217: def _line_coords(h: int, w: int, slope: int, key: int) -> list[tuple[int, int]]:
0218:     coords: list[tuple[int, int]] = []
0219:     if slope == 1:
0220:         for r in range(h):
0221:             c = r - key
0222:             if 0 <= c < w:
0223:                 coords.append((r, c))
0224:     else:
0225:         for r in range(h):
0226:             c = key - r
0227:             if 0 <= c < w:
0228:                 coords.append((r, c))
0229:     return coords
