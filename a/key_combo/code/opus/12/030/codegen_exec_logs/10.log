0232: def _frame_maps(
0233:     h: int,
0234:     w: int,
0235:     frames: list[tuple[int, int, int, int]],
0236: ) -> tuple[np.ndarray, np.ndarray]:
0237:     blocked = np.zeros((h, w), dtype=bool)
0238:     interior_bits = np.zeros((h, w), dtype=np.int64)
0239:     for idx, (r0, c0, r1, c1) in enumerate(frames):
0240:         blocked[r0 : r1 + 1, c0 : c1 + 1] = True
0241:         interior_bits[r0 + 1 : r1, c0 + 1 : c1] |= 1 << idx
0242:     return blocked, interior_bits
