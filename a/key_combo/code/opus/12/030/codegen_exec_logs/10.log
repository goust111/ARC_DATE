0191: def _draw_frame(grid: np.ndarray, frame: tuple[int, int, int, int]) -> None:
0192:     r0, c0, r1, c1 = frame
0193:     grid[r0, c0 : c1 + 1] = BLUE
0194:     grid[r1, c0 : c1 + 1] = BLUE
0195:     grid[r0 : r1 + 1, c0] = BLUE
0196:     grid[r0 : r1 + 1, c1] = BLUE
