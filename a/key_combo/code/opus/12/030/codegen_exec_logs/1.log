+    line = _frame_line_cells(bbox, step)
+    if not line or count <= 0:
+        return []
+    max_with_gap2 = (len(line) + 1) // 2
+    if count <= max_with_gap2:
+        stride = 2
+        usable = count
+    else:
+        stride = 1
+        usable = min(count, len(line))
+    return [line[i * stride] for i in range(usable)]
