+    _validate_metadata(grid, frame_meta, pattern_meta, marker, want_dense)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
