+    ray: list[tuple[int, int]] = []
+    r = center[0] + dr
+    c = center[1] + dc
+    h, w = grid.shape
+    while 0 <= r < h and 0 <= c < w:
+        ray.append((r, c))
+        r += dr
+        c += dc
+    return center, (dr, dc), ray
