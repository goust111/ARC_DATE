+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    _center, step, ray = _find_marker(g)
+    ray_set = set(ray)
+
+    colors = [
+        int(color)
+        for color in np.unique(g)
+        if int(color) not in (BG, BAR_COLOR, CONTROL_COLOR, STAMP_COLOR)
