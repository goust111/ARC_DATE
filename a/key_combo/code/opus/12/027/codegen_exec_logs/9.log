041: def main(grid: np.ndarray) -> np.ndarray:
042:     """
043:     Fill enclosed regions along a line seeded by unique border pixels.
044: 
045:     Input structure:
046:     - bg = most common color.
047:     - Colored lines/drawings on the grid.
048:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.
049: 
050:     Rule:
051:     - Each border seed pixel connects (8-connected) to a line drawing.
052:     - Find closed bg cavities whose boundary touches that line.
053:     - Flood-fill each such cavity with the seed pixel's color.
054: 
055:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.
056:     """
057:     g = np.asarray(grid, dtype=int)
058:     h, w = g.shape
059:     bg = get_bg(g)
060: 
061:     out = g.copy()
062: 
063:     # Precompute background regions (4-connected). Exclude those containing background corners as "outside".
064:     bg_comps = _components_mask(g == bg, conn8=False)
065:     regions = []  # list of (set_pts, boundary_set, touches_border, size)
066:     for pts in bg_comps:
067:         region = set(pts)
068:         touches = _touches_border(pts, h, w)
069:         boundary = set()
070:         for r, c in region:
071:             for nr, nc in neighbors4(r, c):
072:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:
073:                     boundary.add((nr, nc))
074:         regions.append((region, boundary, touches, len(region)))
075: 
076:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
077:     outside_idxs = set()
078:     for i, (reg, _, _, _) in enumerate(regions):
079:         if any(p in reg for p in corners if int(g[p]) == bg):
080:             outside_idxs.add(i)
081: 
082:     cavities = []
083:     for i, (reg, bnd, _, _) in enumerate(regions):
084:         if i in outside_idxs or not bnd:
085:             continue
086:         bcols = {int(g[p]) for p in bnd}
087:         cavities.append((reg, bnd, bcols))
