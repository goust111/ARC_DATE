001: import numpy as np
002: 
003: import random
004: from arc_utils import Color, bbox, bbox_anchor, bbox_h, bbox_w, colors_present, draw_line, find_components, first_free_location, paste, random_sprite
005: 
006: # concepts:
007: # counting
008: 
009: # description:
010: # In the input, you will see a 10x10 black grid containing a few 2x2 squares. Each square contains 1-4 colors.
011: # To create the output, draw a green 2xL rectangle just below each 2x2 square, where L is the number of colors in the square.
012: 
013: def main(input_grid):
014:     """
015:     Draw a green marker rectangle below each 2x2 square sized by its color count.
016: 
017:     Input structure:
018:     - The input is a 10x10 black grid with separated 2x2 colored squares.
019:     - Each square may contain one to four non-black colors.
020:     - The generated placement leaves room around squares for added markers.
021: 
022:     Rule:
023:     - Detect each multicolor square object.
024:     - Count the distinct non-black colors inside it.
025:     - Paste a green rectangle directly below the square with height equal to that count and matching square width.
026: 
027:     Key insight:
028:     - The added green shape encodes diversity inside each square: more distinct colors
029:       produce a taller marker.
030:     """
031:     # copy the input grid to the output grid
032:     output_grid = input_grid.copy()
033:     # find all connected components in the input grid
034:     bg = Color.BLACK
035:     objects = find_components(
036:         input_grid,
037:         bg=bg,
038:         connectivity=4,
039:         monochromatic=False,
040:         return_format="objects",
041:     )
042: 
043:     # for each object, draw a green rectangle below it of shape 2xL, where L is the number of colors in the square
044:     for obj in objects:
045:         b = bbox(obj != bg)
046:         if b is None:
047:             continue
048:         r0, c0 = bbox_anchor(b, anchor="upper left")
049:         h = bbox_h(b)
050:         w = bbox_w(b)
051:         num_colors = len(colors_present(obj, exclude={bg}))
052:         # Place a green rectangle just below the square.
053:         # In canonical (r,c), the rectangle extends downward with height = (#colors in the square)
054:         # and width = (square width).
055:         green_rectangle = np.full((num_colors, w), Color.GREEN)
056:         output_grid = paste(output_grid, green_rectangle, r0 + h, c0, clip=True)
057: 
058:     return output_grid
059: 
060: 
061: def generate_input():
062:     input_grid = np.full((10, 10), Color.BLACK)
063:     num_squares = np.random.randint(1, 5)
064:     for _ in range(num_squares):
065:         square = random_sprite(2, 2, density=1.0, color_palette=Color.NOT_BLACK)
066:         _loc = first_free_location(input_grid, square, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
067:         if _loc is None:
068:             raise ValueError("no placement")
069:         r, c = _loc
070:         input_grid = paste(input_grid, square, r, c, transparent=Color.BLACK, clip=True)
071: 
072:     return input_grid
