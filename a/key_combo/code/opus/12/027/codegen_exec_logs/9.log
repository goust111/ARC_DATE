009: def _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:
010:     h, w = passable.shape
011:     dist = np.full((h, w), -1, dtype=int)
012:     q: deque[tuple[int, int]] = deque()
013:     for r, c in sources:
014:         rr = int(r)
015:         cc = int(c)
016:         assert passable[rr, cc]
017:         dist[rr, cc] = 0
018:         q.append((rr, cc))
019: 
020:     while q:
021:         r, c = q.popleft()
022:         nd = int(dist[r, c]) + 1
023:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
024:             nr = r + dr
025:             nc = c + dc
026:             if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:
027:                 dist[nr, nc] = nd
028:                 q.append((nr, nc))
029:     return dist
030: 
