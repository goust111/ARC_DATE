057: def _component_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int, int]]:
058:     h, w = mask.shape
059:     seen = np.zeros_like(mask, dtype=bool)
060:     components: list[tuple[int, int, int, int, int]] = []
061:     for r in range(h):
062:         for c in range(w):
063:             if not mask[r, c] or seen[r, c]:
064:                 continue
065:             q: deque[tuple[int, int]] = deque([(r, c)])
066:             seen[r, c] = True
067:             r0 = r1 = r
068:             c0 = c1 = c
069:             area = 0
070:             while q:
071:                 rr, cc = q.popleft()
072:                 area += 1
073:                 r0 = min(r0, rr)
074:                 c0 = min(c0, cc)
075:                 r1 = max(r1, rr)
076:                 c1 = max(c1, cc)
077:                 for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
078:                     nr = rr + dr
079:                     nc = cc + dc
080:                     if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
081:                         seen[nr, nc] = True
082:                         q.append((nr, nc))
083:             components.append((r0, c0, r1, c1, area))
084:     return components
