200: GEN_BG, GEN_COLOR = 0, 3
201: 
202: # Canvas bounds.
203: GEN_GRID_SIZE = 30
204: 
205: # Room count and size distribution.
206: GEN_ROOM_COUNT_MIN, GEN_ROOM_COUNT_MAX = 6, 8
207: GEN_SMALL_ROOM_MIN, GEN_SMALL_ROOM_MAX = 3, 4
208: GEN_LARGE_ROOM_MIN = 5
209: GEN_LARGE_ROOM_FALLBACK_MAX = 11
210: GEN_SIZE_PROFILE_BY_ROOM_COUNT = {
211:     8: (8, 0.34),
212:     7: (10, 0.25),
213:     6: (11, 0.18),
214: }
215: 
216: # Corridor geometry constraints.
217: GEN_GAP_MIN, GEN_GAP_MAX = 1, 7
218: GEN_OVERLAP_MIN, GEN_OVERLAP_MAX = 1, 7
219: 
220: # Placement scoring and retry limits.
