+def _validate_generated(grid: np.ndarray) -> bool:
+    try:
+        rects, chosen, corridor = _corridor_grid(grid)
+        n = len(rects)
+        if not 3 <= n <= 5:
+            return False
+        edges = _candidate_edges(grid, rects)
+        if n >= 4 and len(edges) <= n - 1:
+            return False
+        marker_sets = []
+        for rect in rects:
