006: def main(grid: np.ndarray) -> np.ndarray:
007:     """
008:     Fill each one-gap rectangular frame in red and let the fill spill straight out through the gap.
009: 
010:     Input structure
011:     - The grid has a uniform background color and one foreground color.
012:     - Each 4-connected foreground object is a 4x4 rectangular frame border with exactly one non-corner border pixel missing.
013:     Rule
014:     - Preserve the foreground frame pixels.
015:     - Recolor each frame's 2x2 interior, its missing border pixel, and the background ray continuing outward from that gap to red.
016:     Key insight
017:     - The missing border pixel identifies both the leak point and the outward direction for the red fill.
018:     """
019:     g = np.asarray(grid, dtype=int)
020:     assert g.ndim == 2, "expected a 2D grid"
021: 
022:     bg = get_bg(g)
023:     assert bg != Color.RED, "red is reserved for the output fill"
024:     frame_colors = colors_present(g, exclude={bg})
025:     assert len(frame_colors) == 1, "expected exactly one frame color"
026:     frame_color = frame_colors[0]
027:     assert frame_color != Color.RED, "input frame color must differ from red"
028: 
029:     frames = find_components(
030:         g,
031:         bg=bg,
032:         connectivity=4,
033:         monochromatic=True,
034:         colors=[frame_color],
035:         return_format="dict",
036:     )
037:     assert frames, "expected at least one frame"
038: 
039:     out = g.copy()
040:     height, width = map(int, g.shape)
041: 
042:     for frame in frames:
043:         assert frame["color"] == frame_color
