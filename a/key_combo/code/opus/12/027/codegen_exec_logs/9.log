+                            "gap": c1 - c0 + 1,
+                            "a": left_i,
+                            "b": right_i,
+                            "r0": r0,
+                            "r1": r1,
+                            "c0": c0,
+                            "c1": c1,
+                            "span": r1 - r0 + 1,
