007: def main(grid: np.ndarray) -> np.ndarray:
008:     """
009:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.
010: 
011:     Input structure:
012:     - bg = most common color.
013:     - Multi-color sprites in the interior; each has a minority-color "marker" pixel.
014:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.
015: 
016:     Rule:
017:     - Match each sprite to the border anchor sharing its marker color.
018:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.
019:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.
020: 
021:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.
022:     """
023:     g = np.array(grid, dtype=int)
024:     H, W = g.shape
025:     bg = int(get_bg(g))
026: 
027:     def is_border(r: int, c: int) -> bool:
028:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))
029: 
030:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---
031:     anchors_by_color: dict[int, tuple[int, int]] = {}
032:     for r in range(H):
033:         for c in range(W):
034:             if not is_border(r, c):
035:                 continue
036:             v = int(g[r, c])
037:             if v == int(bg):
038:                 continue
039:             ok = True
040:             for rr, cc in neighbors4(int(r), int(c)):
041:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):
042:                     ok = False
043:                     break
044:             if ok and v not in anchors_by_color:
045:                 anchors_by_color[int(v)] = (int(r), int(c))
046: 
047:     assert not (not anchors_by_color)
048: 
049:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}
050: 
051:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---
052:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
053: 
054:     def component_marker_color(coords: np.ndarray) -> int | None:
055:         # For multi-color sprites, the marker color is the least frequent color inside the component.
056:         vals = [int(g[int(r), int(c)]) for r, c in coords]
057:         cnt = Counter(vals)
058:         if len(cnt) <= 1:
059:             return None
060:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
061: 
062:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:
063:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).
064:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]
065:         if not pts:
066:             return None
067:         if len(pts) == 1:
068:             return pts[0]
069:         S = {(int(r), int(c)) for r, c in coords}
070:         for r, c in pts:
071:             for rr, cc in neighbors4(int(r), int(c)):
072:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):
073:                     return (int(r), int(c))
074:         return pts[0]
075: 
076:     moves: list[tuple[np.ndarray, int, int]] = []
077: 
078:     for comp in comps:
079:         coords = comp["coords"]
080:         if coords.size == 0:
081:             continue
082: 
083:         # --- STEP 3) Decide marker color for this component. ---
084:         marker_col = component_marker_color(coords)
085:         if marker_col is None:
086:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.
087:             if int(coords.shape[0]) != 1:
088:                 continue
089:             r, c = map(int, coords[0])
090:             v = int(g[r, c])
091:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:
092:                 continue
093:             marker_col = int(v)
094: 
095:         if int(marker_col) not in anchors_by_color:
096:             continue
097: 
098:         mp = marker_pixel(coords, int(marker_col))
099:         if mp is None:
100:             continue
101: 
102:         ar, ac = anchors_by_color[int(marker_col)]
103: 
104:         # --- STEP 4) Compute translation (dr,dc). ---
105:         on_top_bottom = int(ar) in (0, int(H - 1))
106:         on_left_right = int(ac) in (0, int(W - 1))
107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner
108: 
109:         dr = 0
110:         dc = 0
111:         if horizontal:
112:             dc = int(ac - mp[1])
113:         else:
114:             dr = int(ar - mp[0])
115: 
116:         moves.append((coords, int(dr), int(dc)))
117: 
118:     out = g.copy()
119: 
120:     # --- STEP 5) Apply all moves. ---
121:     # Clear moved components first (prevents collisions with their original locations).
122:     for coords, _dr, _dc in moves:
123:         out[coords[:, 0], coords[:, 1]] = int(bg)
124: 
125:     # Paste moved components:
126:     # - clip out-of-bounds pixels
127:     # - do not overwrite existing non-bg pixels
128:     for coords, dr, dc in moves:
129:         for r, c in coords:
130:             rr = int(r) + int(dr)
131:             cc = int(c) + int(dc)
132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):
133:                 out[rr, cc] = int(g[int(r), int(c)])
134: 
135:     return out
