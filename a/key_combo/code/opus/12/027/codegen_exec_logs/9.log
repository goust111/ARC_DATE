117:             return False
118:         a0 = min(start for start, _end in intervals_a)
119:         a1 = max(end for _start, end in intervals_a)
120:         b0 = min(start for start, _end in intervals_b)
121:         b1 = max(end for _start, end in intervals_b)
122:         return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1
123: 
124:     return spans_contain(left, right, r0, r1) or spans_contain(above, below, c0, c1)
