001: from __future__ import annotations
002: from collections import Counter, defaultdict
003: import numpy as np
004: from arc_utils import get_bg, in_bounds, neighbors4, label_mask
005: 
006: def main(grid: np.ndarray) -> np.ndarray:
007:     """
008:     Connect framed squares via colored bridges following a control-pixel sequence.
009: 
010:     Input structure:
011:     - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.
012:     - Control row below squares: colored pixels read left-to-right encode visitation order.
013: 
014:     Rule:
015:     - Start at the square matching first control color c0.
016:     - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.
017:     - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.
018: 
019:     Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.
020:     """
021:     g = np.array(grid, dtype=int)
022:     H, W = g.shape
023:     bg = int(get_bg(g))
024: 
025:     # border color = most common non-bg color
026:     cnt = Counter(map(int, g.flatten()))
027:     border = None
028:     for col, _k in cnt.most_common():
029:         if int(col) != int(bg):
030:             border = int(col)
031:             break
032:     assert not (border is None)
033: 
034:     # detect framed squares as connected components of the border color
035:     lab, n = label_mask(g == int(border), connectivity=4)
036:     frames: list[dict] = []
037:     for cid in range(1, int(n) + 1):
038:         pts = np.argwhere(lab == int(cid))
039:         if int(pts.shape[0]) < 8:
040:             continue
041:         r0, c0 = pts.min(axis=0)
042:         r1, c1 = pts.max(axis=0)
043:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
044:         h = int(r1 - r0 + 1)
045:         w = int(c1 - c0 + 1)
046:         if h < 3 or w < 3:
047:             continue
048: 
049:         t = None
050:         inner_col = None
051:         for tt in range(1, int(min(h, w) // 2) + 1):
052:             inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]
053:             if inner.size == 0:
054:                 continue
055:             if bool((inner == int(border)).any()):
056:                 continue
057:             u = set(map(int, inner.flatten()))
058:             if len(u) != 1:
059:                 continue
060: 
061:             ok = True
062:             if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):
063:                 ok = False
064:             if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):
065:                 ok = False
066:             if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):
067:                 ok = False
068:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):
069:                 ok = False
070:             if not ok:
071:                 continue
072: 
073:             t = int(tt)
074:             inner_col = int(next(iter(u)))
075:             break
076: 
077:         if t is None or inner_col is None:
078:             continue
079: 
080:         frames.append(
081:             {
082:                 "bbox": (int(r0), int(c0), int(r1), int(c1)),
083:                 "t": int(t),
084:                 "inner": int(inner_col),
085:                 "inner_bbox": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),
086:             }
087:         )
088: 
089:     assert not (not frames)
090: 
091:     by: dict[int, list[dict]] = defaultdict(list)
092:     for f in frames:
093:         by[int(f["inner"])].append(f)
094: 
095:     max_frame_r = max(int(f["bbox"][2]) for f in frames)
096: 
097:     # control row = bottom-most row below the squares with >=2 non-bg pixels
098:     ctrl_r = None
099:     for r in range(int(H - 1), int(max_frame_r), -1):
100:         if int((g[int(r)] != int(bg)).sum()) >= 2:
101:             ctrl_r = int(r)
102:             break
103:     assert not (ctrl_r is None)
104: 
105:     ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]
106:     assert not (len(ctrl) < 2)
107: 
108:     def center(f: dict) -> tuple[int, int]:
109:         r0, c0, r1, c1 = map(int, f["bbox"])
110:         return int((r0 + r1) // 2), int((c0 + c1) // 2)
111: 
112:     def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:
113:         a = f1["inner_bbox"]
114:         b = f2["inner_bbox"]
115:         same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))
116:         same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))
117:         return same_row, same_col
118: 
119:     # choose start frame
120:     start_color = int(ctrl[0])
121:     assert not (start_color not in by)
122:     start_cands = by[start_color]
123:     if len(start_cands) == 1:
124:         cur = start_cands[0]
125:     else:
126:         nxt_color = int(ctrl[1])
127:         nxt_cands = by.get(nxt_color, [])
128:         best = None
129:         bestf = None
130:         for f in start_cands:
131:             for g2 in (nxt_cands if nxt_cands else [f]):
132:                 sr, sc = aligned(f, g2)
133:                 al = 1 if (sr or sc) else 0
134:                 (r1_, c1_) = center(f)
135:                 (r2_, c2_) = center(g2)
136:                 d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))
137:                 cand = (int(al), -int(d))
138:                 if best is None or cand > best:
139:                     best = cand
140:                     bestf = f
141:         cur = bestf
142: 
143:     out = g.copy()
144: 
145:     def draw_bridge(fa: dict, fb: dict, color: int) -> None:
146:         (r0a, c0a, r1a, c1a) = map(int, fa["bbox"])
147:         (r0b, c0b, r1b, c1b) = map(int, fb["bbox"])
148:         ia = fa["inner_bbox"]
149:         sr, sc = aligned(fa, fb)
150:         if sr:
151:             rr0, rr1 = int(ia[0]), int(ia[2])
152:             if int(c1a) < int(c0b):
153:                 cc0, cc1 = int(c1a + 1), int(c0b - 1)
154:             else:
155:                 cc0, cc1 = int(c1b + 1), int(c0a - 1)
156:             for r in range(int(rr0), int(rr1) + 1):
157:                 for c in range(int(cc0), int(cc1) + 1):
158:                     if 0 <= r < H and 0 <= c < W:
159:                         out[int(r), int(c)] = int(color)
160:             return
161:         if sc:
162:             cc0, cc1 = int(ia[1]), int(ia[3])
163:             if int(r1a) < int(r0b):
164:                 rr0, rr1 = int(r1a + 1), int(r0b - 1)
165:             else:
166:                 rr0, rr1 = int(r1b + 1), int(r0a - 1)
167:             for r in range(int(rr0), int(rr1) + 1):
168:                 for c in range(int(cc0), int(cc1) + 1):
169:                     if 0 <= r < H and 0 <= c < W:
170:                         out[int(r), int(c)] = int(color)
171: 
172:     for i in range(int(len(ctrl)) - 1):
173:         a = int(ctrl[i])
174:         b = int(ctrl[i + 1])
175:         assert int(cur["inner"]) == int(a)
176:         assert b in by, f"control color {b} has no matching frame"
177:         cands = by[b]
178:         best = None
179:         bestf = None
180:         for f in cands:
181:             sr, sc = aligned(cur, f)
182:             al = 1 if (sr or sc) else 0
183:             (r1_, c1_) = center(cur)
184:             (r2_, c2_) = center(f)
185:             d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))
186:             cand = (int(al), -int(d))
187:             if best is None or cand > best:
188:                 best = cand
189:                 bestf = f
190:         nxt = bestf
191:         draw_bridge(cur, nxt, int(a))
192:         cur = nxt
193: 
194:     return out
195: 
