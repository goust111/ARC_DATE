+def _corridor_grid(grid: np.ndarray) -> tuple[list[tuple[int, int, int, int]], list[dict], np.ndarray]:
+    rects = _find_rectangles(grid)
+    edges = _candidate_edges(grid, rects)
+    chosen = _spanning_edges(edges, len(rects))
