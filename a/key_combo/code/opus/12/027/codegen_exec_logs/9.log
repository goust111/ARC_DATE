001: from collections import Counter, deque
002: 
003: import numpy as np
004: 
005: from arc_utils import Color, get_bg, in_bounds
006: 
007: 
008: def _sign(n: int) -> int:
009:     if n > 0:
010:         return 1
011:     if n < 0:
012:         return -1
013:     return 0
014: 
015: 
016: def _reachable(
017:     g: np.ndarray,
018:     bg: int,
019:     seed: tuple[int, int],
020:     moves: list[tuple[int, int]],
021:     bounds: tuple[int, int, int, int],
022: ) -> np.ndarray:
023:     r0, c0, r1, c1 = bounds
024: 
025:     def valid(r: int, c: int) -> bool:
026:         return r0 <= r <= r1 and c0 <= c <= c1 and g[r, c] == bg
027: 
028:     assert valid(*seed)
029:     seen = np.zeros(g.shape, dtype=bool)
030:     seen[seed] = True
031:     q = deque([seed])
032:     while q:
033:         r, c = q.popleft()
034:         for dr, dc in moves:
035:             rr, cc = r + dr, c + dc
036:             if valid(rr, cc) and not seen[rr, cc]:
037:                 seen[rr, cc] = True
038:                 q.append((rr, cc))
039:     return seen
040: 
041: 
042: def main(grid: np.ndarray) -> np.ndarray:
043:     """
044:     Paint yellow the background cells on the unobstructed shortest monotone corridor between two doorway frames.
045: 
046:     Input structure
047:     - The grid has a background, two small frame objects in one foreground color, and one center marker in each frame.
048:     - Each marker has exactly one background 4-neighbor, the doorway gap; the next cell outward is the exterior doorway cell.
049: 
050:     Rule
051:     - Treat all existing foreground cells as blockers.
052:     - Between the two exterior doorway cells, allow only row/column steps that move toward the other exterior cell.
053:     - Paint every background cell that lies on some such path from one exterior cell to the other, plus the two doorway gaps, yellow.
054: 
055:     Key insight
056:     - The output is not a single chosen route: it is the union of all shortest monotone paths that can pass between the two frames.
057:     """
058:     g = np.asarray(grid, dtype=int)
059:     bg = get_bg(g)
060:     counts = Counter(map(int, g.ravel()))
061:     fg_colors = [color for color in counts if color != bg]
062:     assert len(fg_colors) == 2
063: 
064:     marker_colors = [color for color in fg_colors if counts[color] == 2]
065:     assert len(marker_colors) == 1
066:     marker_color = marker_colors[0]
067:     frame_colors = [color for color in fg_colors if color != marker_color]
068:     assert len(frame_colors) == 1
069:     frame_color = frame_colors[0]
070: 
071:     doors: list[tuple[tuple[int, int], tuple[int, int]]] = []
072:     for r0, c0 in zip(*np.where(g == marker_color)):
073:         r, c = int(r0), int(c0)
074:         neighbors = []
075:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
076:             rr, cc = r + dr, c + dc
077:             assert in_bounds(g.shape, rr, cc)
078:             neighbors.append((int(g[rr, cc]), dr, dc, rr, cc))
079: 
080:         gaps = [item for item in neighbors if item[0] == bg]
081:         frame_neighbors = [item for item in neighbors if item[0] == frame_color]
082:         assert len(gaps) == 1
083:         assert len(frame_neighbors) == 3
084: 
085:         _, dr, dc, gap_r, gap_c = gaps[0]
086:         ext_r, ext_c = r + 2 * dr, c + 2 * dc
087:         assert in_bounds(g.shape, ext_r, ext_c)
088:         assert g[ext_r, ext_c] == bg
089:         doors.append(((gap_r, gap_c), (ext_r, ext_c)))
090: 
091:     assert len(doors) == 2
092:     start = doors[0][1]
093:     end = doors[1][1]
094:     row_step = _sign(end[0] - start[0])
095:     col_step = _sign(end[1] - start[1])
096:     assert row_step != 0 or col_step != 0
097: 
098:     moves = []
099:     if row_step:
100:         moves.append((row_step, 0))
101:     if col_step:
102:         moves.append((0, col_step))
103: 
104:     r0, r1 = sorted([start[0], end[0]])
105:     c0, c1 = sorted([start[1], end[1]])
106:     bounds = (r0, c0, r1, c1)
107:     forward = _reachable(g, bg, start, moves, bounds)
108:     backward = _reachable(g, bg, end, [(-dr, -dc) for dr, dc in moves], bounds)
109:     path = forward & backward
110:     assert path[start]
111:     assert path[end]
112: 
113:     out = g.copy()
114:     out[path] = Color.YELLOW
115:     for gap, _ in doors:
116:         assert g[gap] == bg
117:         out[gap] = Color.YELLOW
118:     return out
119: 
120: # --------------- generator (o5x) ---------------
121: 
122: # Colors used by the fixed 692cd3b6 object/corridor vocabulary.
123: GEN_BG, GEN_FRAME, GEN_MARKER, GEN_FILL = Color.BLACK, Color.RED, Color.GREY, Color.YELLOW
124: 
125: # Canvas and frame geometry.
126: GEN_GRID_SHAPE = (15, 15)
127: GEN_FRAME_RADIUS, GEN_EXTERIOR_STEP = 1, 2
128: GEN_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
129: 
130: # Marker center sampling bounds and required diagonal separation.
131: GEN_TOP_ROWS, GEN_BOT_ROWS = (2, 5), (9, 12)
132: GEN_LEFT_COLS, GEN_RIGHT_COLS = (2, 5), (9, 12)
133: GEN_MIN_SEP = 5
134: 
135: # Sampling controls and retry budget.
136: GEN_TL_BR_ORIENTATION, GEN_ORIENTATION_RANGE = 0, (0, 1)
137: GEN_MAX_ATTEMPTS = 300
138: 
139: 
140: def _gen_randint(lo: int, hi: int) -> int:
141:     return int(np.random.randint(lo, hi + 1))
142: 
143: 
144: def _gen_choose_centers() -> list[tuple[int, int]]:
145:     top_r = _gen_randint(*GEN_TOP_ROWS)
146:     bot_r = _gen_randint(max(GEN_BOT_ROWS[0], top_r + GEN_MIN_SEP), GEN_BOT_ROWS[1])
147: 
148:     if _gen_randint(*GEN_ORIENTATION_RANGE) == GEN_TL_BR_ORIENTATION:
149:         left_c = _gen_randint(*GEN_LEFT_COLS)
150:         right_c = _gen_randint(max(GEN_RIGHT_COLS[0], left_c + GEN_MIN_SEP), GEN_RIGHT_COLS[1])
151:         return [(top_r, left_c), (bot_r, right_c)]
152: 
153:     right_c = _gen_randint(*GEN_RIGHT_COLS)
154:     left_c = _gen_randint(GEN_LEFT_COLS[0], min(GEN_LEFT_COLS[1], right_c - GEN_MIN_SEP))
155:     return [(top_r, right_c), (bot_r, left_c)]
156: 
157: 
158: def _gen_place_frame(
159:     grid: np.ndarray, r: int, c: int, direction: tuple[int, int]
160: ) -> tuple[tuple[int, int], tuple[int, int]]:
161:     dr, dc = direction
162:     gap = (r + dr, c + dc)
163:     exterior = (r + GEN_EXTERIOR_STEP * dr, c + GEN_EXTERIOR_STEP * dc)
164: 
165:     r0, r1 = r - GEN_FRAME_RADIUS, r + GEN_FRAME_RADIUS + 1
166:     c0, c1 = c - GEN_FRAME_RADIUS, c + GEN_FRAME_RADIUS + 1
167:     grid[r0:r1, c0:c1] = GEN_FRAME
168:     grid[r, c] = GEN_MARKER
169:     grid[gap] = GEN_BG
170:     return gap, exterior
171: 
172: 
173: def _gen_expected_output(
174:     base: np.ndarray, doors: list[tuple[tuple[int, int], tuple[int, int]]]
175: ) -> np.ndarray:
176:     start = doors[0][1]
177:     end = doors[1][1]
178:     row_step = _sign(end[0] - start[0])
179:     col_step = _sign(end[1] - start[1])
180:     assert row_step != 0 and col_step != 0
181: 
182:     moves = [(row_step, 0), (0, col_step)]
183:     r0, r1 = sorted([start[0], end[0]])
184:     c0, c1 = sorted([start[1], end[1]])
185:     bounds = (r0, c0, r1, c1)
186:     forward = _reachable(base, GEN_BG, start, moves, bounds)
187:     backward = _reachable(base, GEN_BG, end, [(-dr, -dc) for dr, dc in moves], bounds)
188:     path = forward & backward
189:     assert path[start] and path[end]
190: 
191:     out = base.copy()
192:     out[path] = GEN_FILL
193:     for gap, _ in doors:
194:         out[gap] = GEN_FILL
195:     return out
196: 
197: 
198: def _gen_attempt() -> np.ndarray | None:
199:     base = np.full(GEN_GRID_SHAPE, GEN_BG, dtype=int)
200:     doors = []
201: 
202:     for r, c in _gen_choose_centers():
203:         direction = GEN_DIRECTIONS[_gen_randint(0, len(GEN_DIRECTIONS) - 1)]
204:         doors.append(_gen_place_frame(base, r, c, direction))
205: 
206:     try:
207:         expected = _gen_expected_output(base, doors)
208:         inp = expected.copy()
209:         inp[inp == GEN_FILL] = GEN_BG
210:         if not np.array_equal(main(inp), expected):
211:             return None
212:         return inp
213:     except Exception:
214:         return None
215: 
216: 
217: def generate_input() -> np.ndarray:
218:     for _ in range(GEN_MAX_ATTEMPTS):
219:         grid = _gen_attempt()
220:         if grid is not None:
