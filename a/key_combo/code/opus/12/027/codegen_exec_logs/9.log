083: 
084: def get_bg(grid: np.ndarray) -> int:
085:     """Background color = most common value in the grid."""
086:     return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
087: 
088: 
089: def colors_present(grid: np.ndarray, *, exclude: Iterable[int] | None = None) -> list[int]:
090:     """
091:     Return the sorted unique colors present in `grid`.
092: 
093:     Args:
094:         exclude: optional iterable of colors to exclude (e.g. `{bg}`)
095:     """
096:     cols = set(map(int, grid.flatten()))
097:     if exclude is not None:
098:         cols -= set(map(int, exclude))
099:     return sorted(cols)
100: 
101: 
102: def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
103:     """Return True iff (r,c) is within a grid of shape (H,W)."""
104:     H, W = map(int, shape)
105:     return 0 <= int(r) < H and 0 <= int(c) < W
106: 
107: 
108: def neighbors4(r: int, c: int) -> Iterator[Coord]:
109:     """4-neighborhood of (r,c)."""
110:     r = int(r)
111:     c = int(c)
112:     yield r - 1, c
113:     yield r + 1, c
114:     yield r, c - 1
115:     yield r, c + 1
116: 
117: 
118: def neighbors8(r: int, c: int) -> Iterator[Coord]:
119:     """8-neighborhood of (r,c)."""
120:     r = int(r)
121:     c = int(c)
122:     for dr in (-1, 0, 1):
123:         for dc in (-1, 0, 1):
124:             if dr == 0 and dc == 0:
125:                 continue
126:             yield r + dr, c + dc
