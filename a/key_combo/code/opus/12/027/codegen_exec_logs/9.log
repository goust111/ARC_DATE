001: from __future__ import annotations
002: import numpy as np
003: 
004: from arc_utils import colors_present, find_components, get_bg
005: import random
006: 
007: 
008: def _rectangles(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int, int]]]:
009:     colors = colors_present(g, exclude={bg})
010:     assert len(colors) == 1
011:     color = colors[0]
012: 
013:     rects = []
014:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color])
015:     assert len(comps) > 1
016:     for comp in comps:
017:         r0, c0, r1, c1 = comp["bbox"]
018:         h = r1 - r0 + 1
019:         w = c1 - c0 + 1
020:         assert h >= 3 and w >= 3
021: 
022:         frame = np.zeros((h, w), dtype=bool)
023:         frame[0, :] = True
024:         frame[-1, :] = True
025:         frame[:, 0] = True
026:         frame[:, -1] = True
027:         patch = g[r0 : r1 + 1, c0 : c1 + 1]
028:         assert np.array_equal(patch == color, frame)
029:         assert int(comp["area"]) == int(frame.sum())
030:         rects.append((r0, c0, r1, c1))
031: 
032:     return color, rects
033: 
034: 
035: def _candidate_edges(g: np.ndarray, bg: int, rects: list[tuple[int, int, int, int]]) -> list[dict]:
036:     edges = []
037:     for i, a in enumerate(rects):
038:         for j in range(i + 1, len(rects)):
039:             b = rects[j]
040: 
041:             if a[3] < b[1] or b[3] < a[1]:
042:                 if a[3] < b[1]:
043:                     left_i, right_i, left, right = i, j, a, b
044:                 else:
045:                     left_i, right_i, left, right = j, i, b, a
046:                 r0 = max(left[0] + 1, right[0] + 1)
047:                 r1 = min(left[2] - 1, right[2] - 1)
048:                 c0 = left[3] + 1
049:                 c1 = right[1] - 1
050:                 if r0 <= r1 and c0 <= c1 and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == bg):
051:                     edges.append(
052:                         {
053:                             "gap": c1 - c0 + 1,
054:                             "kind": "h",
055:                             "a": left_i,
056:                             "b": right_i,
057:                             "r0": r0,
058:                             "r1": r1,
059:                             "c0": c0,
060:                             "c1": c1,
061:                         }
062:                     )
063: 
064:             if a[2] < b[0] or b[2] < a[0]:
065:                 if a[2] < b[0]:
066:                     upper_i, lower_i, upper, lower = i, j, a, b
067:                 else:
068:                     upper_i, lower_i, upper, lower = j, i, b, a
069:                 c0 = max(upper[1] + 1, lower[1] + 1)
070:                 c1 = min(upper[3] - 1, lower[3] - 1)
071:                 r0 = upper[2] + 1
072:                 r1 = lower[0] - 1
073:                 if c0 <= c1 and r0 <= r1 and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == bg):
074:                     edges.append(
075:                         {
076:                             "gap": r1 - r0 + 1,
077:                             "kind": "v",
078:                             "a": upper_i,
079:                             "b": lower_i,
080:                             "r0": r0,
081:                             "r1": r1,
082:                             "c0": c0,
083:                             "c1": c1,
084:                         }
085:                     )
086:     return edges
087: 
088: 
089: def _spanning_edges(edges: list[dict], n_rects: int) -> list[dict]:
090:     parent = list(range(n_rects))
091: 
092:     def find(x: int) -> int:
093:         while parent[x] != x:
094:             parent[x] = parent[parent[x]]
095:             x = parent[x]
096:         return x
097: 
098:     def union(a: int, b: int) -> None:
099:         ra = find(a)
100:         rb = find(b)
101:         assert ra != rb
102:         parent[rb] = ra
103: 
104:     chosen = []
105:     for gap in sorted({edge["gap"] for edge in edges}):
106:         group = [edge for edge in edges if edge["gap"] == gap]
107:         eligible = [edge for edge in group if find(edge["a"]) != find(edge["b"])]
108: 
109:         temp_parent: dict[int, int] = {}
110: 
111:         def temp_find(x: int) -> int:
112:             temp_parent.setdefault(x, x)
113:             while temp_parent[x] != x:
114:                 temp_parent[x] = temp_parent[temp_parent[x]]
115:                 x = temp_parent[x]
116:             return x
117: 
118:         for edge in eligible:
119:             ra = find(edge["a"])
120:             rb = find(edge["b"])
121:             ta = temp_find(ra)
122:             tb = temp_find(rb)
123:             assert ta != tb
124:             temp_parent[tb] = ta
125: 
126:         for edge in eligible:
127:             union(edge["a"], edge["b"])
128:             chosen.append(edge)
129: 
130:         if len(chosen) == n_rects - 1:
131:             break
132: 
133:     assert len(chosen) == n_rects - 1
134:     root = find(0)
135:     assert all(find(i) == root for i in range(n_rects))
136:     return chosen
137: 
138: 
139: def _apply_edge(
140:     out: np.ndarray,
141:     bg: int,
142:     color: int,
143:     rects: list[tuple[int, int, int, int]],
144:     edge: dict,
145: ) -> None:
146:     r0 = edge["r0"]
147:     r1 = edge["r1"]
148:     c0 = edge["c0"]
149:     c1 = edge["c1"]
150:     if edge["kind"] == "h":
151:         left = rects[edge["a"]]
152:         right = rects[edge["b"]]
153:         out[r0, c0 : c1 + 1] = color
154:         out[r1, c0 : c1 + 1] = color
155:         if r0 + 1 <= r1 - 1:
156:             out[r0 + 1 : r1, left[3]] = bg
157:             out[r0 + 1 : r1, right[1]] = bg
158:     else:
159:         upper = rects[edge["a"]]
160:         lower = rects[edge["b"]]
161:         out[r0 : r1 + 1, c0] = color
162:         out[r0 : r1 + 1, c1] = color
163:         if c0 + 1 <= c1 - 1:
164:             out[upper[2], c0 + 1 : c1] = bg
165:             out[lower[0], c0 + 1 : c1] = bg
166: 
167: 
168: def main(grid: np.ndarray) -> np.ndarray:
169:     """
170:     Connect hollow rectangular frames into one shortest visible corridor network.
171: 
172:     Input structure
173:     - A single foreground color forms disconnected hollow rectangular frames on the background.
174:     - A visible candidate gap is horizontal or vertical, has overlapping frame interiors, and is clear background between the two frames.
175: 
176:     Rule
177:     - Select the minimum-length spanning set of visible frame-to-frame gaps.
178:     - For a horizontal selected gap, paint the two boundary rows of the overlapping interiors across the gap, then erase the facing wall cells strictly between those rows.
179:     - For a vertical selected gap, do the transposed operation with boundary columns and the facing top/bottom wall cells.
180: 
181:     Key insight
182:     - The connector is determined by the overlap of the rooms' interiors, and longer redundant visible gaps are ignored once the shortest spanning network connects all frames.
183:     """
184:     g = np.asarray(grid, dtype=int)
185:     bg = get_bg(g)
186:     color, rects = _rectangles(g, bg)
187:     edges = _candidate_edges(g, bg, rects)
188:     chosen = _spanning_edges(edges, len(rects))
189: 
190:     out = g.copy()
191:     for edge in chosen:
192:         _apply_edge(out, bg, color, rects, edge)
193: 
194:     comps = find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[color])
195:     assert len(comps) == 1
196:     return out
197: 
