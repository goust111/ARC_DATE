+
+def _enclosed_regions(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    passable = grid != FRAME
+    outside = np.zeros_like(passable, dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
