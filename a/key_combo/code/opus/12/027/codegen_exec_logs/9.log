+        r0, c0, r1, c1 = _bbox(comp)
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        h, w = patch.shape
+        frame = np.zeros((h, w), dtype=bool)
+        frame[0, :] = True
+        frame[-1, :] = True
+        frame[:, 0] = True
+        frame[:, -1] = True
+        if h < 4 or w < 4 or not np.array_equal(patch == FRAME, frame):
+            raise ValueError("expected only hollow blue rectangles")
