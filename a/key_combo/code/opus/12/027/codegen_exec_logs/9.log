024: import numpy as np
025: from scipy.ndimage import label
026: from scipy import ndimage
027: 
028: # =============================================================================
029: # Colors
030: # =============================================================================
031: 
032: 
033: class Color:
034:     """ARC palette color ids (ints, not Enum)."""
035: 
036:     BLACK = 0
037:     BLUE = 1
038:     RED = 2
039:     GREEN = 3
040:     YELLOW = 4
041:     GREY = 5
042:     GRAY = 5
043:     PINK = 6
044:     ORANGE = 7
045:     TEAL = 8
046:     MAROON = 9
047: 
048:     WHITE = 10  # debug / visualization
049:     PAD = 11
050: 
051:     BACKGROUND = 0
052: 
053:     ALL_COLORS = [BLACK, BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]
054:     NOT_BLACK = [BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]
055: 
056: 
057: ARC_RGB = np.array(
058:     [
059:         (0x00, 0x00, 0x00),  # 0 black
060:         (0x00, 0x74, 0xD9),  # 1 blue
061:         (0xFF, 0x41, 0x36),  # 2 red
062:         (0x2E, 0xCC, 0x40),  # 3 green
063:         (0xFF, 0xDC, 0x00),  # 4 yellow
064:         (0xA0, 0xA0, 0xA0),  # 5 grey
065:         (0xF0, 0x12, 0xBE),  # 6 magenta/pink
066:         (0xFF, 0x85, 0x1B),  # 7 orange
067:         (0x7F, 0xDB, 0xFF),  # 8 teal/azure
068:         (0x87, 0x0C, 0x25),  # 9 maroon
069:         (0xFF, 0xFF, 0xFF),  # 10 white
070:         (0x00, 0x00, 0x00),  # 11 pad fallback
071:     ],
072:     dtype=np.uint8,
073: )
074: 
