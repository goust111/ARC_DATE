032: def _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:
033:     h, w = g.shape
034:     rooms: list[tuple[int, int, int]] = []
035:     for n in sorted(sizes):
036:         assert n > 1
037:         for r in range(h - n + 1):
038:             for c in range(w - n + 1):
039:                 if np.any(g[r : r + n, c : c + n] == wall):
040:                     continue
041: 
042:                 side_wall_counts: list[int] = []
043:                 if r > 0:
044:                     side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))
045:                 if r + n < h:
046:                     side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))
047:                 if c > 0:
048:                     side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))
049:                 if c + n < w:
050:                     side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))
051: 
052:                 if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):
053:                     rooms.append((r, c, n))
054:     return rooms
055: 
