+        for edge in eligible:
+            ra = find(edge["a"])
+            rb = find(edge["b"])
+            ta = temp_find(ra)
+            tb = temp_find(rb)
+            if ta == tb:
+                raise ValueError("ambiguous equal-gap cycle")
+            temp_parent[tb] = ta
