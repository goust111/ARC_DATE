+def _runs(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = None
+    for i, value in enumerate(values.tolist()):
+        if value and start is None:
+            start = i
+        elif not value and start is not None:
+            runs.append((start, i - 1))
+            start = None
+    if start is not None:
+        runs.append((start, len(values) - 1))
+    return runs
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, *, colors: set[int] | None = None) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            if colors is not None and color not in colors:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return components
+
+
+def _marker_side(grid: np.ndarray) -> str:
+    sides = []
+    if np.all(grid[0, :] == MARKER):
+        sides.append("top")
+    if np.all(grid[:, -1] == MARKER):
+        sides.append("right")
+    if np.all(grid[-1, :] == MARKER):
+        sides.append("bottom")
+    if np.all(grid[:, 0] == MARKER):
+        sides.append("left")
+    assert len(sides) == 1, sides
+    return sides[0]
+
+
+def _strip_marker(grid: np.ndarray, side: str) -> np.ndarray:
+    if side == "top":
+        return grid[1:, :].copy()
+    if side == "right":
+        return grid[:, :-1].copy()
+    if side == "bottom":
+        return grid[:-1, :].copy()
+    if side == "left":
+        return grid[:, 1:].copy()
+    raise AssertionError(side)
+
+
+def _parse_legend(core: np.ndarray) -> tuple[int, dict[int, np.ndarray]]:
+    occupied_rows = np.any(core != BG, axis=1)
+    legend_r0 = int(np.argmax(occupied_rows))
