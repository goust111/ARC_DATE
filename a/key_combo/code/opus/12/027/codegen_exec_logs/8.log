+def _generate_case() -> np.ndarray | None:
+    side = random.choice(tuple(SIDE_TO_DIRECTION))
+    direction = SIDE_TO_DIRECTION[side]
+    height = random.randint(2, 4)
+    width = random.randint(2, 4)
+
