+def _uncompact_canonical(compacted: np.ndarray, direction: str) -> np.ndarray:
+    h, w = compacted.shape
+    out = np.full_like(compacted, BG)
+    if direction == "right":
+        for r in range(h):
+            values = [int(v) for v in compacted[r, :] if int(v) != BG]
+            out[r, : len(values)] = values
+    elif direction == "left":
+        for r in range(h):
