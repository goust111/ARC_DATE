+    core_height = TEMPLATE_SIZE + SEPARATOR_ROWS + symbol_height
+    core = np.full((core_height, core_width), BG, dtype=int)
+
+    for i, color in enumerate(colors):
+        c0 = i * 3
+        core[0:2, c0 : c0 + 2] = int(color)
