+BG = 0
+MARKER = 2
+NEUTRAL = 5
+TEMPLATE_SIZE = 2
+SYMBOL_SIZE = 3
+CELL_STRIDE = 4
+LEGEND_GAP = 2
+SEPARATOR_ROWS = 1
+SWATCH_COLORS = (1, 3, 4, 6, 7, 8, 9)
