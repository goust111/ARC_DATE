+    assert len(template_runs) == len(swatch_order)
+    stencils: dict[int, np.ndarray] = {}
+    for color, (c0, c1) in zip(swatch_order, template_runs):
+        assert c1 - c0 + 1 == TEMPLATE_SIZE
+        mask = legend[:, c0 : c1 + 1] == NEUTRAL
