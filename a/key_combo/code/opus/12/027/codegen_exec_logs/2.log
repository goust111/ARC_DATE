+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    return max(rows) + 1, max(cols) + 1
+
+
+def _place_shape(shape: tuple[tuple[int, int], ...], top: int, left: int) -> np.ndarray:
+    return np.array([(top + r, left + c) for r, c in shape], dtype=int)
