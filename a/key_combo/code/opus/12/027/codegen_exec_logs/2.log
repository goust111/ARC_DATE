+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
