+def min_chebyshev_distance(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> int:
+    best = 10**9
+    for r0, c0 in a:
+        for r1, c1 in b:
+            best = min(best, max(abs(r0 - r1), abs(c0 - c1)))
+    return best
+
+
+def sample_frame_top_left(h: int, w: int, side: str) -> tuple[int, int]:
+    if side == "top":
