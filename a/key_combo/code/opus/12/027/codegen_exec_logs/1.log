+        for idx in range(obstacle_count):
+            placed = False
+            for _try in range(60):
+                straight_len = random.randint(1, 4)
+                straight = [
+                    (cursor[0] + t * direction[0], cursor[1] + t * direction[1])
+                    for t in range(straight_len)
