+def obstacle_options(
+    shape: tuple[int, int],
+    current: tuple[int, int],
+    hit: tuple[int, int],
+    direction: tuple[int, int],
+    input_occ: set[tuple[int, int]],
+    path_occ: set[tuple[int, int]],
