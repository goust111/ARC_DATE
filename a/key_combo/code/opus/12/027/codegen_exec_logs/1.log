+        c0 = random.randint(SIDE_MARGIN, w - FRAME_SIZE - SIDE_MARGIN)
+    elif side == "bottom":
+        r0 = random.randint(SIDE_MARGIN, h - FRAME_SIZE - OUTWARD_MARGIN)
+        c0 = random.randint(SIDE_MARGIN, w - FRAME_SIZE - SIDE_MARGIN)
+    elif side == "left":
+        r0 = random.randint(SIDE_MARGIN, h - FRAME_SIZE - SIDE_MARGIN)
