+    else:
+        r0 = random.randint(SIDE_MARGIN, h - FRAME_SIZE - SIDE_MARGIN)
+        c0 = random.randint(SIDE_MARGIN, w - FRAME_SIZE - OUTWARD_MARGIN)
+    return r0, c0
+
+
+def boundary_path_cells(
