+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 1
+OBSTACLE = 2
+FILL = 3
+
+FRAME_SIZE = 4
+FRAME_INTERIOR = 2
+GAP_OFFSETS = (1, 2)
+SIDES = ("top", "bottom", "left", "right")
+DIR_BY_SIDE = {
