+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GEN_ATTEMPTS = 600
+FRAME_ATTEMPTS = 220
+PATH_ATTEMPTS = 90
+OUTWARD_MARGIN = 7
+SIDE_MARGIN = 2
