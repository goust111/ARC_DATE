+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    out = g.copy()
+    frames = detect_frames(g)
+
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1):
