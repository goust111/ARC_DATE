+def boundary_path_cells(
+    start: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]
+) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    r, c = start
+    dr, dc = direction
+    while in_bounds(shape, r, c):
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
