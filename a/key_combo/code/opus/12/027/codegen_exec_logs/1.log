+    top = hr
+    bottom = hr
+    while top - 1 >= 0 and grid[top - 1, hc] == OBSTACLE:
+        top -= 1
+    while bottom + 1 < h and grid[bottom + 1, hc] == OBSTACLE:
+        bottom += 1
