+def trace_ray(
+    grid: np.ndarray, gap: tuple[int, int], direction: tuple[int, int]
+) -> tuple[set[tuple[int, int]], int]:
+    h, w = map(int, grid.shape)
+    dr, dc = direction
+    r = gap[0] + dr
+    c = gap[1] + dc
