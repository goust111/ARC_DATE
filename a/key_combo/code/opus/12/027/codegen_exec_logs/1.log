+                out[r, c] = FILL
+        gr, gc = frame["gap"]
+        assert g[gr, gc] == BG
+        out[gr, gc] = FILL
+        path, _ = trace_ray(g, frame["gap"], frame["dir"])
+        for r, c in path:
+            assert g[r, c] == BG
+            out[r, c] = FILL
+
+    return out
