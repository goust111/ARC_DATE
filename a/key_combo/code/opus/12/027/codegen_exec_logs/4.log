+def _apply_transform(grid: np.ndarray, frames: list[dict]) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        gap_r, gap_c = frame["gap"]
+        dr, dc = DIRS[frame["direction"]]
+
+        for rr in range(r0 + 1, r1):
