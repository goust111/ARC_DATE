+def _render_expected(base: np.ndarray, frame_specs: list[dict]) -> np.ndarray:
+    out = base.copy()
+    for spec in sorted(frame_specs, key=lambda item: item["bbox"]):
+        r0, c0, r1, c1 = spec["bbox"]
+        gap_r, gap_c = spec["gap"]
