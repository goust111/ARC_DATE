def _gen_lanes(width: int, count: int) -> list[tuple[int, int]] | None:
    gap_cols = _GEN_LANE_GAP_WIDTH * (count - 1)
    usable = width - gap_cols
    min_usable = _GEN_MIN_LANE_WIDTH * count
    if usable < min_usable:
        return None

