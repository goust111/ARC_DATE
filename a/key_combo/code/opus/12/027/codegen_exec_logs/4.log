  "path": "straight cardinal ray starting at the missing border pixel and continuing outward perpendicular to that side until the grid edge",
  "trajectory": "paint the missing border pixel and every background pixel on the ray red",
  "transform": "also fill s's 2x2 interior red; preserve all frame pixels and unrelated background"
}
</annotation>
