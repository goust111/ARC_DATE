+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+FRAME_COLORS = (BLUE, GREEN, YELLOW, ORANGE)
+FRAME_SIZE = 4
+GAP_OFFSETS = (1, 2)
+PARTITIONS = ("tl", "tr", "bl", "br")
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ALLOWED_DIRS = {
+    "tl": ("down", "right"),
+    "tr": ("down", "left"),
+    "bl": ("up", "right"),
+    "br": ("up", "left"),
+}
+TARGET_PARTITION = {
+    ("tl", "down"): "bl",
+    ("tl", "right"): "tr",
+    ("tr", "down"): "br",
+    ("tr", "left"): "tl",
+    ("bl", "up"): "tl",
+    ("bl", "right"): "br",
+    ("br", "up"): "tr",
+    ("br", "left"): "bl",
