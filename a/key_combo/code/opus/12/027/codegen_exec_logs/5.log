+        zone_rows[start:stop] = i
+    for i, (start, stop) in enumerate(col_bands):
+        zone_cols[start:stop] = i
+    for r in sep_rows:
+        zone_rows[r] = -1
+    for c in sep_cols:
+        zone_cols[c] = -1
+
+    indicators: dict[tuple[int, int], int] = {}
+    indicator_cells: set[tuple[int, int]] = set()
