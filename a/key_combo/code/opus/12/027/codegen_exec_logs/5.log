+            indicator_cells.add((r0, c0))
+
+    return {
+        "row_bands": row_bands,
+        "col_bands": col_bands,
+        "zone_rows": zone_rows,
+        "zone_cols": zone_cols,
+        "indicators": indicators,
+        "indicator_cells": indicator_cells,
