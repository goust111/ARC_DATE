+    if not _fill_zone_colors(layout, template):
+        return None
+    if not _semantic_checks(grid, template):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid partition-aware pathfinding instance")

