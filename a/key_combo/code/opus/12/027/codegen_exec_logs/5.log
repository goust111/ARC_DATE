+
+def _rand_between(lo: int, hi: int) -> int | None:
+    if lo > hi:
+        return None
+    return random.randint(lo, hi)
+
+
+def _build_template(layout: dict) -> dict | None:
+    grid = layout["grid"]
+    h, w = grid.shape
+    row_bands = layout["row_bands"]
+    col_bands = layout["col_bands"]
