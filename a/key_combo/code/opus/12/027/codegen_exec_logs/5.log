+    h = sum(row_sizes) + len(row_sizes) - 1
+    w = sum(col_sizes) + len(col_sizes) - 1
+    grid = np.full((h, w), BLACK, dtype=int)
+
+    row_bands: list[tuple[int, int]] = []
+    start = 0
+    for size in row_sizes:
