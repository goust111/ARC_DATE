+    ks = [rng.choice([2, 3]) for _ in range(region_total)]
+    ks[0] = rng.choice([2, 3])
+    ks[1] = 5 - ks[0]
+
+    specs: list[list[tuple[int, int]]] = []
+    specs.append(_make_color_spec(rng, ks[0], shared_color=shared_color, shared_count=4))
+    shared_low = rng.choice([1, 2])
+    specs.append(
