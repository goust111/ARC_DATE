+def _gen_attempt() -> np.ndarray | None:
+    shape = (random.randint(18, 24), random.randint(18, 24))
+    sprite_count = random.choice([3, 4])
+    colors = random.sample(PALETTE, sprite_count + 2)
+    signature_colors = colors[:sprite_count]
