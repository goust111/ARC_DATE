+
+                non_sig_a = _placed_non_signature(sprite_a, anchor_a, shape)
+                non_sig_b = _placed_non_signature(sprite_b, anchor_b, shape)
+                overlap = set(non_sig_a) & set(non_sig_b)
+                if not (1 <= len(overlap) <= 3):
