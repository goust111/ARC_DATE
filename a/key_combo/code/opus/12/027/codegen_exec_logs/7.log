  "type": "move_to_match",
  "src": "8-connected multicolor sprite s",
  "dst": "partial target mask d of same-color marker pixels outside source sprites",
  "match_cond": "d is the maximal exact same-color overlap of s under one translation",
  "transform": "stamp full s onto d; erase any single-pixel source color not used by the matched marker mask"
}
