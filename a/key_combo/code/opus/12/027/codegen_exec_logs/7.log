+        cells_b = [(dr, dc, color) for dr, dc, color in sprite_b["rel_cells"]]
+        deltas = list(
+            {
+                (int(dra - drb), int(dca - dcb))
+                for dra, dca, color_a in cells_a
+                for drb, dcb, color_b in cells_b
+                if int(color_a) != int(color_b)
