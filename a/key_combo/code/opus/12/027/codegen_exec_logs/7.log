+            abs_cells.append((rr, cc))
+            color = int(g[rr, cc])
+            if color == signature_color:
+                continue
+            rel_cells.append((rr - sr, cc - sc, color))
+
+        sprites[signature_color] = {
+            "signature_color": signature_color,
+            "signature_abs": (sr, sc),
+            "rel_cells": tuple(rel_cells),
+            "abs_cells": tuple(abs_cells),
