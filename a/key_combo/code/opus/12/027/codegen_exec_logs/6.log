+from __future__ import annotations
+
+from collections import deque
+from itertools import product
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+TEAL = 8
+MAROON = 9
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MATCH_PATTERNS = [
+    (2, 2),
+    (2, 3),
+    (3, 2),
+]
+
+DISTRACTOR_PATTERNS = [
+    (3, 3),
+    (2, 4),
+    (4, 2),
+    (4,),
+    (5,),
+    (3, 5),
+    (5, 3),
+    (2, 2, 2),
+    (2, 3, 2),
+    (3, 2, 2),
+]
+
+MAX_GEN_ATTEMPTS = 500
