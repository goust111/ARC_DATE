    if not diagonal:
        return [[(int(r), int(c))] for r, c in np.argwhere(ss_mask)]

    groups: list[list[tuple[int, int]]] = []
    for r, c in np.argwhere(ss_mask):
        r, c = int(r), int(c)
        if r > c:
            continue
        group = [(r, c)] if r == c else [(r, c), (c, r)]
