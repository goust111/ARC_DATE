+        return None
+    if len(_components_of_color(aligned, TEAL)) != 1:
+        return None
+
+    out = main(grid)
+    recolored_components = len(_components_of_color(out, TEAL))
+    if recolored_components < 1 + match_count:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
