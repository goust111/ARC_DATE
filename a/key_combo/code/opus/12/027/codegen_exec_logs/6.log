+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _build_candidate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

