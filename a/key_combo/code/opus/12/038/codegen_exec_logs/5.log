    w = random.randint(*PANEL_WIDTH_BOUNDS)
    n = random.randint(*PANEL_COUNT_BOUNDS)

    separator = random.choice(ARC_COLORS)
    mark_colors = random.sample([c for c in ARC_COLORS if c != separator], n)
    sizes = _gen_size_tuple(h, w, n)

