+
+BLACK = 0
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+
+BAR_COLORS = (RED, TEAL)
+GEN_RETRIES = 400
+BAR_COUNT_RANGE = (2, 5)
+GRID_HEIGHT_RANGE = (9, 13)
+GRID_WIDTH_MAX = 18
+MARKER_TOTAL_MAX = 7
