+def _is_isolated(pos: tuple[int, int], occupied: set[tuple[int, int]]) -> bool:
+    r, c = pos
+    return (
+        (r - 1, c) not in occupied
+        and (r + 1, c) not in occupied
+        and (r, c - 1) not in occupied
+        and (r, c + 1) not in occupied
