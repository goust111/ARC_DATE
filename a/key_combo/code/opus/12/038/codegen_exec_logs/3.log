+def _reveal_grid(grid: np.ndarray) -> tuple[np.ndarray, list[dict[str, int]]]:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    runs = _find_runs(g)
+    run_by_row = {run["row"]: run for run in runs}
