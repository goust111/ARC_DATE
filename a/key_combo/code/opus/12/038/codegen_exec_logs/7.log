+def _sample_rays(
+    anchor: tuple[int, int, int, int],
+    own_color: int,
+    row_colors: list[int],
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    force_diagonal: bool,
+) -> list[dict]:
