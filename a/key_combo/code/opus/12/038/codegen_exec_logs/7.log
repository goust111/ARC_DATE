+            ((r0 - 1, c0 - 1), (-1, -1)),
+            ((r0 - 1, c1 + 1), (-1, 1)),
+            ((r1 + 1, c0 - 1), (1, -1)),
+            ((r1 + 1, c1 + 1), (1, 1)),
