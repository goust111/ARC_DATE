+
+    force_live_diagonal = random.random() < 0.6
+    force_dead_diagonal = random.random() < 0.6
+    try:
+        live_rays = _sample_rays(
+            anchor_boxes[0],
+            anchor_colors[0],
+            row_colors,
+            base.shape,
+            occupied,
+            force_live_diagonal,
+        )
+        dead_rays = _sample_rays(
+            anchor_boxes[1],
+            anchor_colors[1],
+            row_colors,
+            base.shape,
+            occupied,
+            force_dead_diagonal,
+        )
