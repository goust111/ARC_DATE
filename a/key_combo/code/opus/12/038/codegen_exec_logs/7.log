+
+def _available_distances(
+    terminal: tuple[int, int],
+    outward: tuple[int, int],
+    row_colors: list[int],
+    own_color: int,
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+) -> list[int]:
+    h, w = shape
+    tr, tc = terminal
+    dr, dc = outward
+    distances: list[int] = []
+    dist = 1
+    while True:
+        rr = tr + dist * dr
+        cc = tc + dist * dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        if row_colors[rr] == own_color:
+            break
+        if (rr, cc) not in occupied:
+            distances.append(dist)
+        dist += 1
+    return distances
