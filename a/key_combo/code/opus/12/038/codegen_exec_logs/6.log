+    seen = set()
+    orbits = []
+    for r in range(n):
+        for c in range(n):
+            orbit = _symmetry_orbit(n, r, c)
+            if orbit in seen:
+                continue
+            seen.add(orbit)
+            orbits.append(orbit)
+
+    out = tuple(orbits)
+    _ORBIT_CACHE[n] = out
+    return out
