+def _symmetry_orbit(n: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    cells = {
+        (r, c),
+        (r, n - 1 - c),
+        (n - 1 - r, c),
+        (n - 1 - r, n - 1 - c),
+        (c, r),
+        (c, n - 1 - r),
+        (n - 1 - c, r),
+        (n - 1 - c, n - 1 - r),
+    }
+    return tuple(sorted(cells))
