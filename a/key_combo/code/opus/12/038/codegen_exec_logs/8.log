+    tr, tc = anchors["template"]
+    inp[tr : tr + th, tc : tc + tw] = template_patch
+
+    targets: list[dict[str, object]] = []
+    for spec in target_specs:
+        key = f"target_{int(spec['markers'])}"
+        r0, c0 = anchors[key]
