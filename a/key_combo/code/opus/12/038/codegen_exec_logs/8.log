    markers:
      colors: subset of {4, 6} per rect; at least 1 marker color per rect
      count_per_rect: 1-6 pixels that differ from the fill color
      placement: anywhere inside the rectangle (border or interior)
  selection_rule:
    winner: the unique rectangle with the strictly fewest marker pixels
    winner_marker_count: 1-3
    runner_up gap: >=1 more markers than winner
  output: tight crop of the winner rectangle (same pixels)

generation_strategy:
