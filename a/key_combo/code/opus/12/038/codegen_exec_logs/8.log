+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], padding: int = 0
+) -> bool:
+    return (
+        a[2] + padding < b[0]
+        or b[2] + padding < a[0]
+        or a[3] + padding < b[1]
+        or b[3] + padding < a[1]
+    )
+
