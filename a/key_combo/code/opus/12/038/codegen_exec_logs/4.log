+    h, w = patch.shape
+    out = patch.copy()
+    if w > h:
+        axis = (w - 1) // 2
+        if w % 2 == 0:
+            out[:, axis + 1 :] = np.fliplr(patch[:, : axis + 1])
+        else:
+            out[:, axis + 1 :] = np.fliplr(patch[:, :axis])
+        return out
+
+    if h > w:
+        axis = (h - 1) // 2
+        if h % 2 == 0:
+            out[axis + 1 :, :] = np.flipud(patch[: axis + 1, :])
+        else:
+            out[axis + 1 :, :] = np.flipud(patch[:axis, :])
+        return out
