0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Complete each framed motif by reflecting it to the opposite side of its frame.
0012: 
0013:     Input structure
0014:     - A background canvas contains one or more large same-color rectangular frame
0015:       objects and a smaller motif color inside each frame's bounding box.
0016: 
0017:     Rule
0018:     - Infer the frame color as the unique non-background color with the largest
0019:       area; the other non-background color is the motif color.
0020:     - For each frame bounding box, reflect all motif pixels inside that box:
0021:       wide frames mirror left-to-right, while tall frames mirror top-to-bottom.
0022: 
0023:     Key insight
0024:     - The frame's aspect ratio identifies the symmetry direction, and the output is
0025:       the union of the original motif with its reflection inside the same frame.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     bg = get_bg(g)
0029:     colors = colors_present(g, exclude={bg})
0030:     assert len(colors) == 2, "expected exactly one frame color and one motif color"
0031: 
0032:     counts = {c: int(np.count_nonzero(g == c)) for c in colors}
0033:     largest = max(counts.values())
0034:     frame_candidates = [c for c, n in counts.items() if n == largest]
0035:     assert len(frame_candidates) == 1, "frame color must be uniquely largest"
0036:     frame_color = frame_candidates[0]
0037: 
0038:     motif_colors = [c for c in colors if c != frame_color]
0039:     assert len(motif_colors) == 1, "expected one motif color"
0040:     motif_color = motif_colors[0]
0041: 
0042:     frames = find_components(
0043:         g,
0044:         bg=bg,
0045:         connectivity=8,
0046:         monochromatic=True,
0047:         colors=[frame_color],
0048:     )
0049:     assert frames, "expected at least one frame object"
0050: 
0051:     out = g.copy()
0052:     for frame in frames:
0053:         r0, c0, r1, c1 = frame["bbox"]
0054:         h = bbox_h(frame["bbox"])
0055:         w = bbox_w(frame["bbox"])
0056:         assert h != w, "frame bbox must have a clear orientation"
0057: 
0058:         box_mask = np.zeros(g.shape, dtype=bool)
0059:         box_mask[r0 : r1 + 1, c0 : c1 + 1] = True
0060:         motif_coords = np.argwhere(box_mask & (g == motif_color))
0061:         assert motif_coords.size > 0, "each frame must contain a motif"
0062: 
0063:         for r, c in motif_coords:
0064:             if w > h:
0065:                 rr, cc = int(r), int(c0 + c1 - c)
0066:             else:
0067:                 rr, cc = int(r0 + r1 - r), int(c)
0068:             assert int(g[rr, cc]) != frame_color, "reflection must stay inside the frame interior"
0069:             out[rr, cc] = motif_color
0070: 
0071:     return out
