+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLUE = 1
+BLACK = 0
+SEPARATOR = 6
+PALETTE = (2, 3, 4, 5, 7, 8, 9)
+
+BLOCK_SIZES = (4, 5)
+LAYOUTS = ((2, 3), (3, 3))
+MAX_SIDE = 30
+GEN_RETRIES = 400
