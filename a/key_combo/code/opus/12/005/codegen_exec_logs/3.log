+def _solid_lines(grid: np.ndarray, axis: int) -> list[tuple[int, int]]:
+    lines: list[tuple[int, int]] = []
+    limit = grid.shape[axis]
+    for idx in range(limit):
+        line = grid[idx, :] if axis == 0 else grid[:, idx]
+        color = int(line[0])
