+    seed: np.ndarray,
+    consensus: int,
+    orientations: list[int],
+    damaged_idx: int,
+    damage_cells: list[tuple[int, int]],
+) -> bool:
+    if max(grid.shape) > MAX_SIDE or max(expected.shape) > MAX_SIDE:
+        return False
+    if len(set(orientations)) < 2:
+        return False
+    if orientations[damaged_idx] == consensus:
+        return False
