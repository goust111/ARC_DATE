+def _rotated_damage_mask(size: int, damage_cells: list[tuple[int, int]], k: int) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
+    for r, c in damage_cells:
+        mask[r, c] = True
+    return np.rot90(mask, k)
