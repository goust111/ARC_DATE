+def _majority_tile(blocks: list[np.ndarray]) -> np.ndarray:
+    stack = np.stack(blocks, axis=0)
+    size = stack.shape[1]
+    tile = np.empty((size, size), dtype=int)
+    for r in range(size):
+        for c in range(size):
+            tile[r, c] = _unique_mode(stack[:, r, c])
+    return tile
