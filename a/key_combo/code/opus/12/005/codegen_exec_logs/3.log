+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= MAX_SIDE
+    assert not np.any(g == BLUE), "blue is reserved for the output marker"
+
+    motif, damage_mask, _prototype = _solve(g)
+    out = motif.copy()
+    out[damage_mask] = BLUE
+    return out
