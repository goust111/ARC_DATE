+        full_matches = 0
+        for other in blocks:
+            _, scores = _best_rotation(other, block)
+            best = max(scores)
+            total_score += best
+            full_matches += int(best == area)
+        candidates.append(((raw_matches, full_matches, total_score, sig), np.asarray(block, dtype=int)))
