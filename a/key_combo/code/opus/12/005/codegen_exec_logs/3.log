+
+        if len({tuple(coord) for coord in np.argwhere(motif != BLACK)}) < 6:
+            continue
+        if len({int(r) for r, _ in np.argwhere(motif != BLACK)}) < 2:
+            continue
+        if len({int(c) for _, c in np.argwhere(motif != BLACK)}) < 2:
+            continue
