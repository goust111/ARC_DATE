+def _second_frame_fully_inside(
+    shape: tuple[int, int], center: tuple[int, int], d: int
+) -> bool:
+    r, c = map(int, center)
+    return (
+        r - 2 * d >= 0
+        and r + 2 * d < shape[0]
+        and c - 2 * d >= 0
+        and c + 2 * d < shape[1]
+    )
+
+
