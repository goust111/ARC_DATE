+    grid = np.zeros((h, w), dtype=int)
+    center_r, center_c = map(int, center)
+    grid[center_r, center_c] = RED
+    grid[center_r - d, center_c - diag_sign * d] = RED
+    grid[center_r + d, center_c + diag_sign * d] = RED
+    grid[blue[0], blue[1]] = BLUE
+    return grid
+
