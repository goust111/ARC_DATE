+
+    return _output_is_unique_for_blue_start(grid)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    shape = _sample_shape()
+    d = int(random.choice(STEP_CHOICES))
+    diag_sign = random.choice((-1, 1))
