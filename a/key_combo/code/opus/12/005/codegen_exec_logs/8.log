+
+    random.shuffle(blue_choices)
+    for blue in blue_choices[: min(len(blue_choices), 16)]:
+        grid = _build_input(shape, center, d, diag_sign, blue)
+        if _is_valid_instance(grid):
+            return grid
+    return None
+
