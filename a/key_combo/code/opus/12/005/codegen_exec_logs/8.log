+    if random.random() < 0.45:
+        side = random.randint(GRID_MIN, GRID_MAX)
+        return int(side), int(side)
+    return random.randint(GRID_MIN, GRID_MAX), random.randint(GRID_MIN, GRID_MAX)
+
