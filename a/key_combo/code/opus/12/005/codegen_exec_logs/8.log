+    assert not _diagonal_mask(g.shape, center, diag_sign)[blue[0], blue[1]]
+
+    ring_index = int(blue_dist // d)
+    ring = _ring_mask(g.shape, center, d, ring_index)
+
+    out = np.array(g, copy=True)
+    out[_frame_mask(g.shape, center, d)] = RED
