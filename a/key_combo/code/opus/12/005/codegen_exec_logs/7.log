+
+def _connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _component_cells(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    H, W = grid.shape
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(H):
+        for c in range(W):
+            if int(grid[r, c]) != color or (r, c) in seen:
+                continue
+            q = deque([(r, c)])
+            seen.add((r, c))
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == color and (nr, nc) not in seen:
+                        seen.add((nr, nc))
+                        q.append((nr, nc))
+            comps.append(cells)
+    return comps
