+    masks = {color: random.choice(MASK_LIBRARY).copy() for color in mask_colors}
+    if not _place_templates(grid, marker, mask_colors, masks):
+        return None
+
+    if not _independent_scene_check(grid, require_tie):
+        return None
+    return grid
+
