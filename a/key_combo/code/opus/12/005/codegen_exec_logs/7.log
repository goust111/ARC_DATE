+
+def _place_templates(
+    grid: np.ndarray,
+    marker: tuple[int, int],
+    used_colors: list[int],
+    masks: dict[int, np.ndarray],
+) -> bool:
+    occupied = {tuple(map(int, p)) for p in np.argwhere(grid != BG)}
+    corners = _corner_origins(*grid.shape)
