+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MARKER = 6
+WALL_COLORS = (1, 2, 3)
+DIR_ORDER = ("left", "right", "up", "down")
+DIRS = {
+    "left": (0, -1),
+    "right": (0, 1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
