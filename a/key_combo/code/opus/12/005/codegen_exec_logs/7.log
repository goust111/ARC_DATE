+    if len(rows) == 1:
+        span = list(range(cols[0], cols[-1] + 1))
+        return cols == span and 2 <= len(cells) <= 4
+    if len(cols) == 1:
+        span = list(range(rows[0], rows[-1] + 1))
+        return rows == span and 2 <= len(cells) <= 4
