                while lo - 1 >= 0 and g[lo - 1, nc] == WALL_COLOR:
                    lo -= 1
                while hi + 1 < h and g[hi + 1, nc] == WALL_COLOR:
                    hi += 1
                for y in (lo - 1, hi + 1):
                    if 0 <= y < h and g[y, nc] != WALL_COLOR:
                        stack.append(((y, nc), next_depth))
