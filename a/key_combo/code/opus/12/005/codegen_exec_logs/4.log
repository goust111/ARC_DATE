+    out = g.copy()
+    stack = [start]
+    seen_starts: set[tuple[int, int]] = set()
+    painted: list[tuple[int, int]] = []
+    hit_segments: list[tuple[int, int, int]] = []
+    branch_starts: list[tuple[int, int]] = []
