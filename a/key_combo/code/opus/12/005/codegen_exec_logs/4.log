+
+def _edge_direction(pos: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int]:
+    r, c = pos
+    h, w = shape
+    options = []
+    if r == 0:
+        options.append((1, 0))
+    if r == h - 1:
+        options.append((-1, 0))
+    if c == 0:
+        options.append((0, 1))
+    if c == w - 1:
+        options.append((0, -1))
+    assert len(options) == 1, "marker must lie on exactly one edge"
+    return options[0]
+
