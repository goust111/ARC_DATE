+
+
+def _render_input(h: int, w: int, placed: list[dict]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for comp in placed:
+        for r, c in comp["cells"]:
+            grid[r, c] = GREY
+        pr, pc = comp["pivot"]
+        grid[pr, pc] = RED
+    return grid
+
+
+def _render_output(h: int, w: int, placed: list[dict]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for comp in placed:
+        pr, pc = comp["pivot"]
+        grid[pr, pc] = RED
