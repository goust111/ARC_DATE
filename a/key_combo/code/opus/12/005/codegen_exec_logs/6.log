    if not np.array_equal(main(grid), expected):
        return None
    return grid

def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e21a174a input")

