    """Draw dimensions and colors in the generator's sampling order."""
    num_sprites = random.randint(SPRITE_COUNT_MIN, SPRITE_COUNT_MAX)
    cols = random.randint(GRID_COLS_MIN, GRID_COLS_MAX)
