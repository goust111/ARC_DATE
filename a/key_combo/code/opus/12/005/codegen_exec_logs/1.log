        for (r,c),cols in claims.items():
            if len(cols)>=2 and conflict: out[r,c]=5
            else:
                col=min(cols); out[r,c]=col; new.setdefault(col,set()).add((r,c))
        frontier={k:v for k,v in new.items() if v}
    return out

