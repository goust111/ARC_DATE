        if not progressed: break
        frontier={col:cells for col,cells in next_frontier.items() if cells}
        if not frontier: break
    blacks=comps(out==0)
    edge=encl=0
    for pts in blacks:
        touch=any(r in (0,h-1) or c in (0,w-1) for r,c in pts)
        edge+=touch; encl+=not touch
    return out, edge, encl, np.count_nonzero(out==5)-np.count_nonzero(g==5)

