+def _try_add_extra_segment(
+    rng: random.Random,
+    grid: np.ndarray,
+    segments: list[tuple[str, int, int, int]],
+    seeds: list[tuple[int, int]],
+) -> None:
+    options = _extra_segment_candidates(grid, seeds)
+    rng.shuffle(options)
