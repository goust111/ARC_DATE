    h,w=out.shape
    blacks=comps(out==0)
    edge=sum(any(r in (0,h-1) or c in (0,w-1) for r,c in pts) for pts in blacks)
    encl=len(blacks)-edge
    return edge,encl,np.count_nonzero(out==5)-np.count_nonzero(g==5)

def trial(with_third=False):
    H=random.randint(12,18); W=random.randint(12,18)
    g=np.zeros((H,W),int)
    p=random.randint(3,4)
    g[0:p, p]=5
    g[p, 0:p]=5
    seed_r=random.randint(0,1)
    top=random.randint(seed_r+2, min(seed_r+4, H-5))
    L=random.randint(3,4)
    pc=random.randint(p+2, W-5)
    if top+L>H: return False
    g[top:top+L, pc]=5
    g[top:top+L, pc+2]=5
    if g[seed_r, pc-1] or g[seed_r, pc+3]: return False
    g[seed_r, pc-1]=2
    g[seed_r, pc+3]=3
    if with_third:
        opts=[]
        for r in range(H):
            for c in range(W):
                if g[r,c]"'!=0: continue
                if any(abs(r-r0)+abs(c-c0)<=1 for r0,c0 in [(seed_r,pc-1),(seed_r,pc+3)]): continue
                if any(0<=r+dr<H and 0<=c+dc<W and g[r+dr,c+dc]==5 for dr,dc in N4): continue
                opts.append((r,c))
        if not opts: return False
        # bias far corners
        opts.sort(key=lambda x: min(x[0]+x[1], x[0]+(W-1-x[1]), (H-1-x[0])+x[1], (H-1-x[0])+(W-1-x[1])))
        pool=opts[-max(1,len(opts)//4):]
        r,c=random.choice(pool); g[r,c]=1
    out=grow(g,True); e,en,conf=stats(out,g)
    out2=grow(g,False); e2,en2,_=stats(out2,g)
    return e>=1 and en>=1 and conf>=2 and en2<en
for mode in [False,True]:
    ok=0
    for _ in range(2000):
        ok+=trial(mode)
    print(mode, ok)
