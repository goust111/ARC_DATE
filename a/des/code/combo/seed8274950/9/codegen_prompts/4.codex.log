MAIN_EDGE_GAP = 2
MAIN_MIN_PIXELS, MAIN_MAX_PIXELS = 10, 51
MAIN_MIN_NON_EDGE_RATIO, MAIN_MAX_NON_EDGE_RATIO = 0.15, 0.30
BLOB_DEGREE_BIAS, BLOB_DEGREE_POWER = 0.35, 3

