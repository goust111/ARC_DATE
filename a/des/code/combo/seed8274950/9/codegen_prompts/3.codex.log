+import numpy as np
+
+
+ORTHO_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BIG_BBOX_CHOICES = ((5, 5), (5, 7), (7, 5), (7, 7))
+BIG_KIND_CHOICES = ("full", "cut_corners", "center_hole", "inner_corners")
+GRID_HEIGHT_RANGE = (22, 31)
+GRID_WIDTH_RANGE = (22, 31)
+MAX_GENERATION_ATTEMPTS = 400
+MIN_MOVE_DISTANCE = 4
+SEPARATION = 1
