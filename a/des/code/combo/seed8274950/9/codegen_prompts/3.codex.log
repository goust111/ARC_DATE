+
+
+SMALL_SHAPES = (
+    _cells_from_mask(np.array([[1]], dtype=bool)),
+    _cells_from_mask(np.array([[1, 1, 1]], dtype=bool)),
+    _cells_from_mask(np.array([[1], [1], [1]], dtype=bool)),
