+def _place_unpaired(
+    mask: np.ndarray,
+    height: int,
+    width: int,
+    input_forbidden: set[tuple[int, int]],
+    output_forbidden: set[tuple[int, int]],
+    rng: random.Random,
+) -> dict | None:
+    h, w = mask.shape
+    for _ in range(MAX_PLACEMENT_RETRIES):
+        top = (rng.randrange(height - h + 1), rng.randrange(width - w + 1))
+        coords = _coords_at(mask, top)
