+        return None
+    if np.count_nonzero(actual == OVERLAP_COLOR) == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
