+def _random_path(start: tuple[int, int], end: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    r, c = start
+    path = [(r, c)]
+    while (r, c) != end:
+        steps: list[tuple[int, int]] = []
+        if r < end[0]:
+            steps.append((1, 0))
+        elif r > end[0]:
+            steps.append((-1, 0))
+        if c < end[1]:
+            steps.append((0, 1))
+        elif c > end[1]:
+            steps.append((0, -1))
+        dr, dc = rng.choice(steps)
+        r += dr
+        c += dc
+        path.append((r, c))
+    return path
