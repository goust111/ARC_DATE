+def _random_path(start: tuple[int, int], end: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    r, c = start
+    path = [(r, c)]
+    while (r, c) != end:
+        steps: list[tuple[int, int]] = []
+        if r < end[0]:
+            steps.append((1, 0))
+        elif r > end[0]:
+            steps.append((-1, 0))
+        if c < end[1]:
+            steps.append((0, 1))
+        elif c > end[1]:
+            steps.append((0, -1))
+        dr, dc = rng.choice(steps)
+        r += dr
+        c += dc
+        path.append((r, c))
+    return path
+
+
+def _grow_connected_shape(h: int, w: int, rng: random.Random) -> np.ndarray:
+    anchors = [
+        (0, rng.randrange(w)),
+        (h - 1, rng.randrange(w)),
+        (rng.randrange(h), 0),
+        (rng.randrange(h), w - 1),
+    ]
+    order = anchors[:]
+    rng.shuffle(order)
+    cells = {order[0]}
+    for anchor in order[1:]:
+        target = rng.choice(tuple(cells))
+        cells.update(_random_path(anchor, target, rng))
+
+    max_area = min(h * w, max(len(cells) + 1, int(np.ceil(h * w * 0.8))))
+    target_area = rng.randint(len(cells), max_area)
+    while len(cells) < target_area:
+        frontier: set[tuple[int, int]] = set()
+        for r, c in cells:
+            for dr, dc in NEIGHBORS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        if not frontier:
+            break
+        cells.add(rng.choice(tuple(frontier)))
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
