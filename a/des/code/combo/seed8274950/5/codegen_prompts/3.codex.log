+SIDES = ("top", "bottom", "left", "right")
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _mode(values: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(values, dtype=int), return_counts=True)
+    return int(vals[int(counts.argmax())])
