+            continue
+        if not mask[0, :].any():
+            continue
+        if not mask[-1, :].any():
+            continue
+        if not mask[:, 0].any():
+            continue
+        if not mask[:, -1].any():
+            continue
+        if mask.all() and random.random() < 0.8:
+            continue
+        return mask
+
