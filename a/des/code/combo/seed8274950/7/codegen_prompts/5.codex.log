+            grid[r, 1:] = int(color)
+            grid[r, 0] = int(marker)
+        else:
+            grid[r, : w - 1] = int(color)
+            grid[r, w - 1] = int(marker)
+
+    return grid
+
+
+def _render_output(
+    h: int,
+    w: int,
+    bg: int,
