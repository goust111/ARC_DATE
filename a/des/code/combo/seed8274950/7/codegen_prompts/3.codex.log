+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    mins = coords.min(axis=0)
+    maxs = coords.max(axis=0)
+    return int(mins[0]), int(mins[1]), int(maxs[0]), int(maxs[1])
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _extract_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or visited[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+
+            arr = np.asarray(coords, dtype=int)
+            bbox = _bbox_from_coords(arr)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox,
+                    "bbox_area": _bbox_area(bbox),
+                    "area": int(arr.shape[0]),
+                }
+            )
+
+    return objects
+
+
+def _enclosed_region_labels(obj: dict) -> np.ndarray:
+    r0, c0, r1, c1 = obj["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    mask = np.zeros((h, w), dtype=bool)
+    rel = obj["coords"] - np.asarray([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for rr in range(h):
+        for cc in (0, w - 1):
+            if not mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+    for cc in range(w):
+        for rr in (0, h - 1):
+            if not mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+
+    while q:
+        rr, cc = q.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    enclosed = (~mask) & (~outside)
+    labels = np.zeros((h, w), dtype=int)
+    next_label = 0
+    for rr in range(h):
+        for cc in range(w):
+            if not enclosed[rr, cc] or labels[rr, cc] != 0:
+                continue
+            next_label += 1
+            labels[rr, cc] = next_label
+            q.append((rr, cc))
+            while q:
+                cr, cc2 = q.popleft()
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc2 + dc
+                    if 0 <= nr < h and 0 <= nc < w and enclosed[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_label
+                        q.append((nr, nc))
