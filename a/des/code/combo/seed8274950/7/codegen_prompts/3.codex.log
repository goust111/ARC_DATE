+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GEN_ATTEMPTS = 400
+MAX_SCENE_SIDE = 30
+MIN_SCENE_SIDE = 8
