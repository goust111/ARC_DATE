                padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_PADDING_CONNECTIVITY,
            )
            paste(grid, layer, r, c)
        actual = main(grid)
    except (AssertionError, ValueError):
        return None

    if not np.array_equal(actual, expected):
        return None
    return grid


