+_GRID_ROWS_RANGE = (2, 5)
+_GRID_COLS_RANGE = (2, 5)
+_CELL_SIZE_RANGE = (2, 4)
+_MAX_LABELS = 7
+_CANVAS_EXTRA_RANGE = (4, 10)
+_MAX_GENERATION_ATTEMPTS = 300
+_SIDES = ("top", "bottom", "left", "right")
