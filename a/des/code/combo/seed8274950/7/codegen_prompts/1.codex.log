+                    frontier.add((nr, nc))
+        if not frontier:
+            return None
+        frontier_list = list(frontier)
+        frontier_weights = [score(r, c) for r, c in frontier_list]
+        pick_r, pick_c = random.choices(frontier_list, weights=frontier_weights, k=1)[0]
+        selected.add((pick_r, pick_c))
+        sel_rows.add(pick_r)
+        sel_cols.add(pick_c)
+        if pick_r == 0:
+            sel_edges.add("top")
+        if pick_r == h - 1:
+            sel_edges.add("bottom")
+        if pick_c == 0:
+            sel_edges.add("left")
+        if pick_c == w - 1:
