+    for i in range(count):
+        left = count - i - 1
+        cur_lo = max(lo, remaining - left * hi)
+        cur_hi = min(hi, remaining - left * lo)
+        if cur_lo > cur_hi:
+            return None
+        sizes.append(random.randint(cur_lo, cur_hi))
+        remaining -= sizes[-1]
