+    empty_rows = ~fg.any(axis=1)
+    for start, end in _true_runs(empty_rows):
+        if fg[:start, :].any() and fg[end + 1 :, :].any():
+            cand = _candidate_from_gap(grid, bg, "rows", start, end)
+            if cand is not None:
