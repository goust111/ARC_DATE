+            r0 = random.randint(min_r0, max_r1 - outer_h + 1)
+            c0 = random.randint(1, grid_w - outer_w - 1)
+            bbox = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
+            if any(_boxes_overlap(bbox, other, pad=2) for other in boxes):
