            min_r0 = 2 if legend_side == "top" else 1
            max_r1 = grid_h - 3 if legend_side == "bottom" else grid_h - 2
            if max_r1 - min_r0 + 1 < outer_h:
                continue
            r0 = random.randint(min_r0, max_r1 - outer_h + 1)

