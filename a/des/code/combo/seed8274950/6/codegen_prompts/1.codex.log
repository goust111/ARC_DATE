+    grid[r0, c0 : c1 + 1] = int(wall)
+    grid[r1, c0 : c1 + 1] = int(wall)
+    grid[r0 : r1 + 1, c0] = int(wall)
+    grid[r0 : r1 + 1, c1] = int(wall)
