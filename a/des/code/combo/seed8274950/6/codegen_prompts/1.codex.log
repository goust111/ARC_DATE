+                        elif value == int(wall):
+                            edge_wall_counts[side] += 1
+                        elif value == int(bg):
+                            gaps.append((r, c))
+                        else:
+                            valid = False
+                            break
+                    if not valid:
+                        break
+                if not valid:
+                    continue
+
+                for r in range(r0 + 1, r1):
+                    for c, side in ((c0, "left"), (c1, "right")):
+                        value = int(grid[r, c])
+                        if value == int(wall):
+                            edge_wall_counts[side] += 1
+                        elif value == int(bg):
+                            gaps.append((r, c))
