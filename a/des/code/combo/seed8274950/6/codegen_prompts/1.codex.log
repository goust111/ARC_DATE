+    best_color = None
+    best_score = None
+    for color, count in counts.items():
+        pts = np.argwhere((grid == int(color)) & (~legend_mask))
+        inner = int(np.sum((pts[:, 0] > 0) & (pts[:, 0] < h - 1) & (pts[:, 1] > 0) & (pts[:, 1] < w - 1)))
