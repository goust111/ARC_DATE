+        gaps = region["gaps"]
+        counts = Counter(_gap_orientation(r, c, *bbox) for r, c in gaps)
+        orientation = max(ORIENTATION_ORDER, key=lambda side: counts.get(side, 0))
+        gap_count = len(gaps)
+        assert 1 <= gap_count <= len(legend_colors), "gap count must be covered by the legend"
