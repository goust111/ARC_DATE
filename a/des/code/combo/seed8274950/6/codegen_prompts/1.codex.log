+    for pos in gap_layout["up"]:
+        grid[r0, c0 + pos] = int(bg)
+    for pos in gap_layout["down"]:
+        grid[r1, c0 + pos] = int(bg)
+    for pos in gap_layout["left"]:
+        grid[r0 + pos, c0] = int(bg)
+    for pos in gap_layout["right"]:
+        grid[r0 + pos, c1] = int(bg)
