+        return
+    offset = (span - length) // 2
+    lo = start + offset
+    hi = lo + length
+    if horizontal:
+        out[fixed, lo:hi] = int(color)
+    else:
+        out[lo:hi, fixed] = int(color)
+
+
+def _apply_gradient(out: np.ndarray, bbox: tuple[int, int, int, int], orientation: str, color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    if inner_h <= 0 or inner_w <= 0:
+        return
