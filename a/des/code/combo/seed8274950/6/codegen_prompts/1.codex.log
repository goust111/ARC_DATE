+    regions: list[dict[str, object]] = []
+    used: list[tuple[int, int, int, int]] = []
+    for candidate in sorted(candidates, key=lambda item: item["area"], reverse=True):
+        bbox = candidate["bbox"]
+        if any(_boxes_overlap(bbox, other, pad=0) for other in used):
