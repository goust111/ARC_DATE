+
+def _find_wall_color(grid: np.ndarray, bg: int, legend_mask: np.ndarray) -> int:
+    h, w = grid.shape
+    counts = Counter(int(v) for v in grid[~legend_mask].ravel().tolist() if int(v) != bg)
