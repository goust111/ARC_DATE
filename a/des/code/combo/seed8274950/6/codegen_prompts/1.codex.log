+def _find_legend(grid: np.ndarray, bg: int) -> tuple[str, int, int, list[int]]:
+    h, _ = grid.shape
+    candidates: list[tuple[tuple[int, int], str, int, int, list[int]]] = []
+    for side, row, inner_row in (("top", 0, 1), ("bottom", h - 1, h - 2)):
+        arr = grid[row]
+        start = 0
+        while start < arr.size:
