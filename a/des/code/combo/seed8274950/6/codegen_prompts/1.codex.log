+            layout_counts[major_side] = major_count
+            layout_counts.update(other_counts)
+            chosen: dict[str, tuple[int, ...]] = {}
+            ok = True
+            for side, count in layout_counts.items():
+                options = _non_adjacent_choices(side_spans[side], count)
