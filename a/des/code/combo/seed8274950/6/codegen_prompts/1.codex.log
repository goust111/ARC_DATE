+def _paint_centered_span(out: np.ndarray, fixed: int, start: int, span: int, length: int, color: int, horizontal: bool) -> None:
+    if length <= 0:
+        return
+    offset = (span - length) // 2
+    lo = start + offset
+    hi = lo + length
+    if horizontal:
+        out[fixed, lo:hi] = int(color)
+    else:
+        out[lo:hi, fixed] = int(color)
