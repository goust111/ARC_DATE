+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        candidate = _gen_attempt()
