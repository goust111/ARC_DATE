+                edge_wall_counts = {side: 0 for side in ORIENTATION_ORDER}
+                valid = True
+
+                for c in range(c0, c1 + 1):
+                    for r, side in ((r0, "up"), (r1, "down")):
+                        value = int(grid[r, c])
+                        if c in (c0, c1):
