+
+def _build_ring_with_tail(avail: int, rng: np.random.Generator) -> np.ndarray:
+    core_h = _randint(rng, 3, avail - 1)
+    core_w = _randint(rng, 3, avail)
+    tpl = np.zeros((core_h + 1, core_w), dtype=bool)
+    tpl[1, :] = True
+    tpl[-1, :] = True
+    tpl[1:, 0] = True
+    tpl[1:, -1] = True
+    tpl[0, core_w // 2] = True
+    return tpl
