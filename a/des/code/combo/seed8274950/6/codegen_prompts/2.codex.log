+def _frame_template(h: int, w: int) -> np.ndarray:
+    tpl = np.zeros((h, w), dtype=bool)
+    tpl[0, :] = True
+    tpl[-1, :] = True
+    tpl[:, 0] = True
+    tpl[:, -1] = True
+    return tpl
