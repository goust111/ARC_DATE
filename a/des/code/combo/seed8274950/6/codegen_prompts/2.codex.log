+        col_sizes = {c1 - c0 + 1 for c0, c1 in col_spans}
+        if len(row_sizes) != 1 or len(col_sizes) != 1:
+            continue
+        cell_h = next(iter(row_sizes))
+        cell_w = next(iter(col_sizes))
+        if cell_h != cell_w:
+            continue
+        score = (
+            len(row_spans) * len(col_spans),
+            len(row_lines[color]) + len(col_lines[color]),
