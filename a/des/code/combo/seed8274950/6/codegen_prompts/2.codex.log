+def _spans_from_lines(lines: list[int], size: int) -> list[tuple[int, int]]:
+    bounds = [-1] + sorted(set(int(x) for x in lines)) + [int(size)]
+    spans: list[tuple[int, int]] = []
+    for a, b in zip(bounds, bounds[1:]):
+        if b - a > 1:
+            spans.append((int(a + 1), int(b - 1)))
+    return spans
