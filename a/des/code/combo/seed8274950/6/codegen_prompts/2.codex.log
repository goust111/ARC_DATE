+        probe[mask] = 1
+        if _cell_has_ring(probe, 0) != want_ring:
+            continue
+        return mask
+    raise RuntimeError("failed to build a valid cell pattern")
+
+
+def _layout_from_params(count: int, cell_size: int, bordered: bool) -> tuple[int, list[tuple[int, int]], list[int]]:
+    if bordered:
