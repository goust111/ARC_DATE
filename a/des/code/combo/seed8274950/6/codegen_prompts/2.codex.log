+    out = np.full((len(row_spans), len(col_spans)), bg, dtype=int)
+    for rr, (r0, r1) in enumerate(row_spans):
+        for cc, (c0, c1) in enumerate(col_spans):
+            cell = g[r0 : r1 + 1, c0 : c1 + 1]
