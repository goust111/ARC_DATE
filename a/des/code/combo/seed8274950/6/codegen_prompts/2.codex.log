+
+RED = 2
+_GEN_RETRIES = 300
+_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+_COLOR_POOL = tuple(c for c in range(10) if c != RED)
+_RNG = np.random.default_rng()
