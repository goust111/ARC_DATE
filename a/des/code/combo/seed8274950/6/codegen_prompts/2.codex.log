+
+def _build_l_shape(avail: int, rng: np.random.Generator) -> np.ndarray:
+    h = _randint(rng, 3, avail)
+    w = _randint(rng, 3, avail)
+    tpl = np.zeros((h, w), dtype=bool)
+    tpl[:, 0] = True
+    tpl[-1, :] = True
