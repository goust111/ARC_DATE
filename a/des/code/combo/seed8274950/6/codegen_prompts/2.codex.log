+            perimeter.extend(int(grid[r0, c]) for c in range(c0, c1 + 1))
+            if r1 != r0:
+                perimeter.extend(int(grid[r1, c]) for c in range(c0, c1 + 1))
+            for r in range(r0 + 1, r1):
+                perimeter.append(int(grid[r, c0]))
