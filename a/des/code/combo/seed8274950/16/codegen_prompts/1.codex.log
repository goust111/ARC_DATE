+def _ray_cells_from_bbox(
+    bbox: tuple[int, int, int, int], direction: str, length: int
+) -> list[tuple[int, int]]:
+    (sr, sc), (dr, dc) = _opening_start_and_delta(bbox, direction)
+    return [(sr + dr * step, sc + dc * step) for step in range(length)]
+
+
+def _expand_cells(
