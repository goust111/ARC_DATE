+def _opening_start_and_delta(
+    bbox: tuple[int, int, int, int], direction: str
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if direction == "up":
+        return (r0, (c0 + c1) // 2), (-1, 0)
+    if direction == "down":
+        return (r1, (c0 + c1) // 2), (1, 0)
+    if direction == "left":
+        return ((r0 + r1) // 2, c0), (0, -1)
+    return ((r0 + r1) // 2, c1), (0, 1)
