+    elif direction == "left":
+        for c in range(w):
+            cells.add((0, c))
+            cells.add((h - 1, c))
+        for r in range(h):
+            cells.add((r, w - 1))
+    else:
+        for c in range(w):
+            cells.add((0, c))
+            cells.add((h - 1, c))
+        for r in range(h):
+            cells.add((r, 0))
