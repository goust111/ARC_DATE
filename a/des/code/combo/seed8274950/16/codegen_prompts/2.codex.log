+    expected = _build_expected(grid, lines)
+    if np.array_equal(expected, grid):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
