            chosen=[0,span-1] + sorted(random.sample(inner, mark_count-2))
            marks=[seg[i] for i in chosen]
            valid=True
            for rr,cc in marks:
                if (rr,cc) in occupied:
                    stats['occupied'] += 1
                    valid=False; break
                for other in support_ids(rr,cc):
                    if other in intended_supports and other "'!= sid:
                        stats['"'other_intended'] += 1
                        valid=False; break
                    if other "'!= sid and counts[other] + 1 > 2:
                        stats['"'count'] += 1
                        valid=False; break
                if not valid:
                    break
            if not valid:
                continue
            maj_count=random.randint(mark_count//2 + 1, mark_count)
            if mark_count == span and maj_count == mark_count:
                maj_count -= 1
            maj=random.choice(fg)
            rem=mark_count-maj_count
            palette=[maj]*maj_count + [random.choice([c for c in fg if c"'!=maj]) for _ in range(rem)]
            random.shuffle(palette)
            for (rr,cc),col in zip(marks,palette):
                g[rr,cc]=col
                occupied.add((rr,cc))
                for other in support_ids(rr,cc):
                    counts[other]+=1
            intended_supports.add(sid)
            intended.append((sid, tuple(marks), tuple(seg), ordered_mode(palette)))
            segment_cells.update(seg)
            halo_cells=halo(segment_cells,H,W)
            ok=True
            break
        if not ok:
            stats['"'line_fail'] += 1
            return None, stats
    for _ in range(random.randint(0,4)):
        for _attempt in range(200):
            rr=random.randint(0,H-1); cc=random.randint(0,W-1)
            if (rr,cc) in occupied or (rr,cc) in halo_cells:
                continue
            if any(other in intended_supports for other in support_ids(rr,cc)):
                continue
            if any(counts[other] + 1 > 2 for other in support_ids(rr,cc)):
                continue
            if any((rr+dr,cc+dc) in occupied for dr in (-1,0,1) for dc in (-1,0,1) if (dr,dc)"'!=(0,0)):
                continue
            g[rr,cc]=random.choice(fg)
            occupied.add((rr,cc))
            for other in support_ids(rr,cc):
                counts[other]+=1
            break
    det=detect_lines(g)
    want=sorted((sid[0], sid[1], pts) for sid,pts,_seg,_fill in intended)
    if det != want:
        stats['"'detect_mismatch'] += 1
        print('det', det)
        print('want', want)
        print(g)
        return None, stats
    return g, stats

