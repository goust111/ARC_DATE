+_MARKER_COUNT_MAX = 5
+_ISOLATE_COUNT_RANGE = (0, 4)
+_MAX_ATTEMPTS = 400
+_COLORS = tuple(range(10))
+
+
+def _segment_halo(cells: set[Coord], height: int, width: int) -> set[Coord]:
+    halo: set[Coord] = set()
+    for r, c in cells:
