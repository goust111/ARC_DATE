/bin/bash -lc "python - <<'PY'
from collections import Counter
import random
import numpy as np

DIRECTIONS = {'h': (0, 1), 'v': (1, 0), 'd1': (1, 1), 'd2': (1, -1)}

def bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])

def support_ids(r,c):
    return (('h',r),('v',c),('d1',r-c),('d2',r+c))

def ordered_mode(colors):
    counts = Counter(colors)
    best = None
    best_count = -1
    for color in colors:
        ct = counts[color]
        if ct > best_count:
            best = color
            best_count = ct
    return int(best)

def detect_lines(g):
    g = np.asarray(g, dtype=int)
    bgc = bg(g)
    by = {'h':{},'v':{},'d1':{},'d2':{}}
    H,W = g.shape
    for r in range(H):
        for c in range(W):
            color = int(g[r,c])
            if color == bgc:
                continue
            by['h'].setdefault(r, []).append((c,(r,c),color))
            by['v'].setdefault(c, []).append((r,(r,c),color))
            by['d1'].setdefault(r-c, []).append((r,(r,c),color))
            by['d2'].setdefault(r+c, []).append((r,(r,c),color))
    lines=[]
    for kind, groups in by.items():
        for key, items in groups.items():
            if len(items) < 3:
                continue
            items.sort(key=lambda x: x[0])
            points=tuple(pt for _,pt,_ in items)
            colors=[col for _,_,col in items]
            fill=ordered_mode(colors)
            if kind=='h':
                r=key
                c0=points[0][1]; c1=points[-1][1]
                seg=tuple((r,c) for c in range(c0,c1+1))
            elif kind=='v':
                c=key
                r0=points[0][0]; r1=points[-1][0]
                seg=tuple((r,c) for r in range(r0,r1+1))
            elif kind=='d1':
                r0,c0=points[0]; r1,_=points[-1]
                seg=tuple((r0+i,c0+i) for i in range(r1-r0+1))
            else:
                r0,c0=points[0]; r1,_=points[-1]
                seg=tuple((r0+i,c0-i) for i in range(r1-r0+1))
            lines.append({'support':(kind,key),'points':points,'segment':seg,'fill':fill})
    return lines

def main(g):
    out=np.array(g, dtype=int, copy=True)
    for line in detect_lines(g):
        for r,c in line['segment']:
            out[r,c]=line['fill']
    return out

def halo(cells, H, W):
    out=set()
    for r,c in cells:
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                rr,cc=r+dr,c+dc
                if 0<=rr<H and 0<=cc<W:
                    out.add((rr,cc))
    return out

