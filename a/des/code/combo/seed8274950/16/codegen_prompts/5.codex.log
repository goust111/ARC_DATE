+    best: tuple[list[int], set[tuple[int, int]]] | None = None
+
+    for coords in _line_candidates(h, w):
+        vals = [int(grid[r, c]) for r, c in coords]
+        if any(v in (bg, frame_color) for v in vals):
+            continue
+        if len(set(vals)) != LEGEND_LEN:
+            continue
