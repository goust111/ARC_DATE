+def _placeable(used: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> bool:
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(used.shape[0] - 1, r1 + 1)
+    cc1 = min(used.shape[1] - 1, c1 + 1)
+    return not bool(used[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
