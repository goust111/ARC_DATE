+                [(i, 0) for i in range(LEGEND_LEN)],
+                [(i, w - 1) for i in range(LEGEND_LEN)],
+                [(h - 1 - i, 0) for i in range(LEGEND_LEN)],
+                [(h - 1 - i, w - 1) for i in range(LEGEND_LEN)],
+            ]
+        )
+    return seqs
