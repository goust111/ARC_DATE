+                [(0, i) for i in range(LEGEND_LEN)],
+                [(0, w - 1 - i) for i in range(LEGEND_LEN)],
+                [(h - 1, i) for i in range(LEGEND_LEN)],
+                [(h - 1, w - 1 - i) for i in range(LEGEND_LEN)],
+            ]
+        )
+    if h >= LEGEND_LEN:
+        seqs.extend(
