+    r, c = start[0] + delta[0], start[1] + delta[1]
+    path: list[tuple[int, int]] = []
+    while _in_bounds(grid.shape, r, c):
+        if (r, c) in source_lookup:
+            return source_lookup[(r, c)], path, len(path) + 1
+        if int(grid[r, c]) != bg:
+            return None
+        path.append((r, c))
