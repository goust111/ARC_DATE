+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+GREY = 5
+GRID_MIN = 18
+GRID_MAX = 28
+SOURCE_COUNT_MIN = 2
+SOURCE_COUNT_MAX = 5
+LINE_COUNT_MIN = 2
+LINE_COUNT_MAX = 5
+LINE_LENGTH_MIN = 2
+LINE_LENGTH_MAX = 6
