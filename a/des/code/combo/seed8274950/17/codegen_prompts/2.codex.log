+                    "color": color,
+                    "r0": r0,
+                    "c0": c0,
+                    "r1": r0 + 2,
+                    "c1": c0 + 2,
+                    "cells": cells,
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+    return sources
