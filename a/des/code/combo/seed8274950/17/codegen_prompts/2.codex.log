+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if (
+                        _in_bounds(grid.shape, nr, nc)
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_sources(grid: np.ndarray, bg: int) -> list[dict]:
+    sources: list[dict] = []
+    for color in sorted(set(map(int, np.unique(grid)))):
+        if color in (bg, GREY):
+            continue
+        for comp in _components_of_color(grid, color):
+            rows = [r for r, _ in comp]
+            cols = [c for _, c in comp]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            if len(comp) != 9 or r1 - r0 != 2 or c1 - c0 != 2:
+                continue
+            if np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color):
+                cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+                sources.append(
+                    {
+                        "color": color,
+                        "r0": r0,
+                        "c0": c0,
+                        "r1": r1,
+                        "c1": c1,
+                        "cells": cells,
+                    }
+                )
+    return sources
+
+
+def _find_line_components(grid: np.ndarray) -> list[dict]:
+    comps = []
+    for comp in _components_of_color(grid, GREY):
+        rows = sorted({r for r, _ in comp})
+        cols = sorted({c for _, c in comp})
+        if len(rows) == 1:
+            r = rows[0]
+            c0, c1 = min(cols), max(cols)
+            if len(comp) != c1 - c0 + 1:
+                continue
+            cells = [(r, c) for c in range(c0, c1 + 1)]
+            comps.append(
+                {
+                    "orientation": "h",
+                    "cells": cells,
