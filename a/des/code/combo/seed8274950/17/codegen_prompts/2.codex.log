+            c0 = random.randint(EDGE_MARGIN, w - EDGE_MARGIN - 3)
+            if not _source_can_fit(grid, r0, c0, int(grid[0, 0])):
+                continue
+            grid[r0 : r0 + 3, c0 : c0 + 3] = color
+            cells = {(r, c) for r in range(r0, r0 + 3) for c in range(c0, c0 + 3)}
+            sources.append(
