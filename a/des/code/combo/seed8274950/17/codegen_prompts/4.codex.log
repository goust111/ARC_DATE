+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _place_region(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    soil_cells: set[tuple[int, int]],
+    seed: tuple[int, int],
+    seed_color: int,
+    rng: random.Random,
+) -> bool:
