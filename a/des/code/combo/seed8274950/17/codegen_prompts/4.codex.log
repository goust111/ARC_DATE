+SIDE_ORDER = {
+    "top": [(1, 0), (0, -1), (0, 1), (-1, 0)],
+    "bottom": [(-1, 0), (0, -1), (0, 1), (1, 0)],
+    "left": [(0, 1), (-1, 0), (1, 0), (0, -1)],
+    "right": [(0, -1), (-1, 0), (1, 0), (0, 1)],
+}
+
+GEN_ATTEMPTS = 300
+REGION_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 80
