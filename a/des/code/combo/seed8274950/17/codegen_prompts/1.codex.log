                        continue
                    if not touches(pts, head_pts):
                        continue
                    moves.append((pi, top, left, pts, v))
            return moves

        # Try extending any chain.
        for ch in chains:
            moves = gen_extend_moves(ch, remaining)
            if not moves:
                continue
            # small branching factor is enough for this puzzle
