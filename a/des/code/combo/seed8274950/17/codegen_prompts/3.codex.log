+    elif direction == "left":
+        r0 = int(rng.integers(ar - h + 1, ar + 1))
+        c0 = ac - w + 1
+    else:
+        r0 = int(rng.integers(ar - h + 1, ar + 1))
+        c0 = ac
+    return Shape(color, int(r0), int(c0), int(h), int(w))
+
+
+def _place_next_shape(
+    rng: np.random.Generator,
+    color: int,
