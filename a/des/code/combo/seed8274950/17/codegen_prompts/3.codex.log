+    colors = [int(color) for color in np.unique(g) if int(color) != bg]
+    shapes = [_shape_from_visible_color(g, color) for color in colors]
+    ordered = _infer_layer_order(g, shapes)
+    return _pack_shapes(ordered, bg)
+
+
