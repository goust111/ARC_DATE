+
+def _overlap_bbox(a: Shape, b: Shape) -> tuple[int, int, int, int] | None:
+    r0 = max(a.r0, b.r0)
+    c0 = max(a.c0, b.c0)
+    r1 = min(a.r1, b.r1)
+    c1 = min(a.c1, b.c1)
+    if r0 > r1 or c0 > c1:
