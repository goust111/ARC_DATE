+TOP_BOTTOM_MARGIN_CHOICES = (1, 2, 3, 4)
+SIDE_MARGIN_CHOICES = (1, 2, 3, 4)
+PALETTE_SIDE_MARGIN_CHOICES = (3, 4, 5)
+PALETTE_CORNERS = ("TL", "TR", "BL", "BR")
+COUNT_RELATIONS = ("short", "equal", "long")
