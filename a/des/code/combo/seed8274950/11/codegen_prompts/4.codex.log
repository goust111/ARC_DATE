+def _find_windows(grid: np.ndarray, bg: int) -> list[dict]:
+    windows = [comp for comp in _monochrome_components(grid, bg) if _is_rect_frame(grid, comp)]
+    assert windows, "expected at least one window frame"
+    return windows
