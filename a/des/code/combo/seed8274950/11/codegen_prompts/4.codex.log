+def _is_rect_frame(grid: np.ndarray, comp: dict) -> bool:
+    color = int(comp["color"])
+    r0, c0, r1, c1 = comp["bbox"]
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return False
+    if len(comp["coords"]) != 2 * (height + width) - 4:
+        return False
