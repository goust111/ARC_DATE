+        if not ((r0 == 0 or r1 == height - 1) and (c0 == 0 or c0 == width - 1)):
+            continue
+        colors = [int(grid[r, c0]) for r in range(r0, r1 + 1)]
+        if len(set(colors)) != len(colors):
+            continue
+        candidates.append((r0, c0, r1, c1, colors))
