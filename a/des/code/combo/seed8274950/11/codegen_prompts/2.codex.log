+                            "kind": "vertical",
+                            "keep_idx": int(left_idx),
+                            "move_idx": int(right_idx),
+                            "axis2": int(l_c0 + r_c0 + a_w - 1),
+                            "gap": int(r_c0 - l_c1 - 1),
+                            "sort_key": (int(r_c0 - l_c1 - 1), 0, l_r0, l_c0, r_c0),
+                        }
+                    )
+
+            if a_c0 == b_c0 and a_c1 == b_c1:
