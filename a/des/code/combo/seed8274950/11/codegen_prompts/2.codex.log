+                top = comps[top_idx]
+                bottom = comps[bottom_idx]
+                t_r0, t_c0, t_r1, t_c1 = map(int, top["bbox"])
+                b_r0b, b_c0b, b_r1b, b_c1b = map(int, bottom["bbox"])
+                if t_r1 < b_r0b:
+                    candidates.append(
+                        {
+                            "kind": "horizontal",
+                            "keep_idx": int(top_idx),
+                            "move_idx": int(bottom_idx),
