+def _manhattan_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = end
+    out = [(int(r), int(c))]
+    if random.randrange(2) == 0:
+        while c != tc:
+            c += 1 if tc > c else -1
+            out.append((int(r), int(c)))
+        while r != tr:
+            r += 1 if tr > r else -1
+            out.append((int(r), int(c)))
+    else:
+        while r != tr:
+            r += 1 if tr > r else -1
+            out.append((int(r), int(c)))
+        while c != tc:
+            c += 1 if tc > c else -1
+            out.append((int(r), int(c)))
+    return out
