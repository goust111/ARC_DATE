+    if int(counts[bg]) <= int(max(counts[i] for i in range(10) if i != bg)):
+        return None
+    if not np.array_equal(main(input_grid), expected):
+        return None
+    return input_grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
