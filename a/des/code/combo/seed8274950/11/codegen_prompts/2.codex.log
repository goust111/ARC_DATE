+                left = comps[left_idx]
+                right = comps[right_idx]
+                l_r0, l_c0, l_r1, l_c1 = map(int, left["bbox"])
+                r_r0, r_c0, r_r1, r_c1 = map(int, right["bbox"])
+                if l_c1 < r_c0:
+                    candidates.append(
