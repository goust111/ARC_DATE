+            orientation = random.choice(["vertical", "horizontal"])
+            masks = _pair_masks(*dims)
+            if masks is None:
+                continue
+            keep_mask, move_target = masks
+            positions = _try_place_pair(occupied, H, W, dims, orientation)
+            if positions is None:
+                continue
