+    if np.array_equal(input_grid, expected):
+        return None
+    counts = np.bincount(input_grid.ravel(), minlength=10)
+    if int(counts[bg]) <= int(max(counts[i] for i in range(10) if i != bg)):
+        return None
+    if not np.array_equal(main(input_grid), expected):
+        return None
+    return input_grid
