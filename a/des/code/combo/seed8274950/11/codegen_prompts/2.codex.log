+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < H and 0 <= nc < W and not bool(seen[nr, nc]) and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
