+    occupied = set(seed) | set(blocked)
+    for _ in range(count):
+        frontier: set[tuple[int, int]] = set()
+        for r, c in seed | chosen:
+            for dr, dc in DIR4:
+                nr = int(r + dr)
+                nc = int(c + dc)
