+    used: set[int] = set()
+    pairs: list[dict[str, object]] = []
+    for cand in candidates:
+        keep_idx = int(cand["keep_idx"])
+        move_idx = int(cand["move_idx"])
+        if keep_idx in used or move_idx in used:
+            continue
+        used.add(keep_idx)
+        used.add(move_idx)
+        pairs.append(cand)
+    return pairs
