+    out = g.copy()
+    for pair in _candidate_pairs(comps):
+        keep = comps[int(pair["keep_idx"])]
+        move = comps[int(pair["move_idx"])]
+        keep_cells = {tuple(map(int, coord)) for coord in keep["coords"]}
+        merge_color = _overlap_color(keep, move)
