+            mask[coords_arr[:, 0] - r0, coords_arr[:, 1] - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords_arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": mask,
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
+
+    comps.sort(key=lambda comp: tuple(int(v) for v in comp["bbox"]))
