+        center = (random.randrange(h), random.randrange(w))
+        anchors = [
+            (0, random.randrange(w)),
+            (h - 1, random.randrange(w)),
+            (random.randrange(h), 0),
+            (random.randrange(h), w - 1),
+        ]
+        cells: set[tuple[int, int]] = set()
+        for anchor in anchors:
