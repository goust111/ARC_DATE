+            r += 1 if tr > r else -1
+            out.append((int(r), int(c)))
+    else:
+        while r != tr:
+            r += 1 if tr > r else -1
+            out.append((int(r), int(c)))
+        while c != tc:
+            c += 1 if tc > c else -1
+            out.append((int(r), int(c)))
