+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color == int(bg) or bool(seen[r, c]):
+                continue
