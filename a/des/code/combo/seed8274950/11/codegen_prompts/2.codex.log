+def _overlap_color(keep: dict[str, object], move: dict[str, object]) -> int:
+    keep_area = int(keep["area"])
+    move_area = int(move["area"])
+    if keep_area < move_area:
+        return int(keep["color"])
+    if move_area < keep_area:
+        return int(move["color"])
+    return int(move["color"])
