+def _group_runs(indices: np.ndarray) -> list[tuple[int, int]]:
+    if len(indices) == 0:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = int(indices[0])
+    prev = int(indices[0])
+    for raw in indices[1:]:
+        cur = int(raw)
+        if cur != prev + 1:
+            runs.append((start, prev))
+            start = cur
+        prev = cur
+    runs.append((start, prev))
+    return runs
