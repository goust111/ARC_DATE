+def _gen_attempt() -> np.ndarray | None:
+    rows, cols, cell_size, line_size, sep_size = _sample_geometry()
+    show_control_grid = random.random() < 0.5
+    allow_overwrite = random.random() < 0.5
+
+    colors = list(range(10))
+    random.shuffle(colors)
