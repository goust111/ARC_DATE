+def _intervals_between_bands(length: int, bands: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    intervals: list[tuple[int, int]] = []
+    prev_end = -1
+    for start, end in bands:
+        if start > prev_end + 1:
+            intervals.append((prev_end + 1, start - 1))
+        prev_end = end
+    if prev_end < length - 1:
