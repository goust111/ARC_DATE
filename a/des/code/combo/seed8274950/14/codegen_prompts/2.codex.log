+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+
+            color = int(grid[r, c])
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+
+            while q:
