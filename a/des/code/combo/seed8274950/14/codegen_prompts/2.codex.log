+    r0, c0, r1, c1 = bbox
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+
+    expected_area = 2 * (h + w) - 4
+    if len(coords) != expected_area:
+        return False
+
+    cells = set(coords)
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in cells or (r1, c) not in cells:
+            return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in cells or (r, c1) not in cells:
+            return False
