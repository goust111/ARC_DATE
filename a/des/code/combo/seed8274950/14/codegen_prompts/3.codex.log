+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(
+                {
+                    "coords": np.array(coords, dtype=int),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
+                }
+            )
+    return comps
+
