+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+TRAIL_BLUE = 1
+TRAIL_RED = 2
+TRAIL_GREEN = 3
+
+BG_CHOICES = [0, 4, 5, 6, 7, 8, 9]
+FG_CHOICES = [4, 5, 6, 7, 8, 9]
+
+GRID_MIN = 10
+GRID_MAX = 18
+MIN_OBJECTS = 2
+MAX_OBJECTS = 4
+LANE_GAP = 1
+GEN_RETRIES = 400
