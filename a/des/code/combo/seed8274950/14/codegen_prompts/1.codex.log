+    if direction == "left":
+        return base.T
+    if direction == "right":
+        return np.fliplr(base.T)
+    raise ValueError(direction)
+
+
+def _random_composition(total: int, parts: int) -> list[int]:
+    bins = [0] * parts
+    for _ in range(total):
+        bins[random.randrange(parts)] += 1
+    return bins
+
+
+def _place_vertical(
+    grid: np.ndarray,
+    masks: list[np.ndarray],
+    colors: list[int],
+    direction: str,
