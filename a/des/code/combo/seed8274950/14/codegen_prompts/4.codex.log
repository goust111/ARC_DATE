+            len(path_a) + len(path_b) - 1,
+            len(path_a),
+            len(path_b),
+            gap[0],
+            gap[1],
+            idx,
+        )
+        if best is None or score < best["score"]:
+            best = {
+                "score": score,
+                "segment": segment,
+                "gap": gap,
+                "path_a": path_a,
+                "path_b": path_b,
+            }
