+        if grid is None:
+            continue
+
+        try:
+            if _bg_color(grid) != bg:
+                continue
+            found_wall, _segments = _find_wall_color(grid, bg)
+            if found_wall != wall_color:
+                continue
+            out = main(grid)
+        except AssertionError:
+            continue
+
+        if np.array_equal(out, grid):
+            continue
+        return grid
+
+    raise AssertionError("generator exhausted its retry budget")

