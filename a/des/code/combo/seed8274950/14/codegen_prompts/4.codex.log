+def _same_side(segment: dict, side: int, r: int, c: int, goal: tuple[int, int]) -> bool:
+    if (r, c) == goal:
+        return True
+    if segment["orient"] == "v":
+        return c < int(segment["fixed"]) if side < 0 else c > int(segment["fixed"])
+    return r < int(segment["fixed"]) if side < 0 else r > int(segment["fixed"])
