+            rows = arr[:, 0]
+            cols = arr[:, 1]
+            bbox = (int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max()))
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": bbox,
