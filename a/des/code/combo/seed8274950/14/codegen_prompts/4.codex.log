+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        pair_count = random.randint(*PAIR_COUNT_RANGE)
+        bg = random.choice(COLORS)
+        remaining = [color for color in COLORS if color != bg]
