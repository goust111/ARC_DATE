+    while q:
+        r, c = q.popleft()
+        if (r, c) == goal:
+            break
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
