+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (0, -1), (0, 1), (1, 0)]
+COLORS = list(range(10))
+
+# Generator configuration.
+PAIR_COUNT_RANGE = (1, 4)
+SCENE_ATTEMPTS = 160
+PLACEMENT_ATTEMPTS = 160
+GENERATION_ATTEMPTS = 320
+GRID_BASE = 13
+GRID_EXTRA = 5
