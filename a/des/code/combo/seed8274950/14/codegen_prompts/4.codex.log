+            parent[nxt] = (r, c)
+            q.append(nxt)
+
+    assert goal in parent, "gap must be reachable from each object on its own side"
+
+    path: list[tuple[int, int]] = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
