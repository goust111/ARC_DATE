def _explode_relative(coords: np.ndarray) -> np.ndarray:
    mins = coords.min(axis=0)
    maxs = coords.max(axis=0)
    center_r = (int(mins[0]) + int(maxs[0])) // 2
    center_c = (int(mins[1]) + int(maxs[1])) // 2
