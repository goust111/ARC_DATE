+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _gen_attempt(_GEN_RNG)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {_GEN_ATTEMPTS} attempts")

