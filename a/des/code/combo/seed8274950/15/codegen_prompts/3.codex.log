+
+def _trace_path(
+    start: tuple[int, int], end: tuple[int, int], horizontal_first: bool
+) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    path = [(r, c)]
+
+    if horizontal_first:
+        while c != ec:
+            c += 1 if ec > c else -1
+            path.append((r, c))
+        while r != er:
+            r += 1 if er > r else -1
+            path.append((r, c))
+    else:
+        while r != er:
+            r += 1 if er > r else -1
+            path.append((r, c))
+        while c != ec:
+            c += 1 if ec > c else -1
+            path.append((r, c))
+
+    return path
+
+
+def _shape_cells(h: int, w: int, rng: np.random.Generator) -> np.ndarray:
+    center = (h // 2, w // 2)
+    cells = {center}
+    anchors: list[tuple[int, int]] = []
+
+    if h > 1:
+        anchors.extend([(0, int(rng.integers(w))), (h - 1, int(rng.integers(w)))])
+    if w > 1:
+        anchors.extend([(int(rng.integers(h)), 0), (int(rng.integers(h)), w - 1)])
+
+    rng.shuffle(anchors)
+    for anchor in anchors:
