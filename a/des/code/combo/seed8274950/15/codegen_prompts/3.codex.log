    cells: set[tuple[int, int]], shape: tuple[int, int], dirs: tuple[tuple[int, int], ...]
) -> set[tuple[int, int]]:
    out: set[tuple[int, int]] = set()
    for r, c in cells:
        out.add((r, c))
        for dr, dc in dirs:
            nr, nc = r + dr, c + dc

