+def _components(grid: np.ndarray, bg: int) -> list[tuple[int, np.ndarray]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, np.ndarray]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
