+    in_cmax = int(rel_in[:, 1].max())
+    out_rmin = int(rel_out[:, 0].min())
+    out_rmax = int(rel_out[:, 0].max())
+    out_cmin = int(rel_out[:, 1].min())
+    out_cmax = int(rel_out[:, 1].max())
