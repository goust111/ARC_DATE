+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _trace_path(
+    start: tuple[int, int], end: tuple[int, int], horizontal_first: bool
+) -> list[tuple[int, int]]:
