+    if max_extra > 0:
+        extra = int(rng.integers(0, max_extra + 1))
+        if extra == max_extra and h * w > 5 and rng.random() < 0.7:
+            extra -= 1
+        for _ in range(extra):
+            frontier: list[tuple[int, int]] = []
+            frontier_seen: set[tuple[int, int]] = set()
+            for r, c in cells:
