+                continue
+
+            for r, c in input_cells:
+                grid[r, c] = color
+
+            used_area += len(input_cells)
+            input_forbidden.update(_expanded_cells(input_cells, (h, w), DIRS8))
+            output_forbidden.update(_expanded_cells(visible_out, (h, w), DIRS4))
+            clipped_seen += int(clipped)
+            placed = True
+            break
