+    for row in queries:
+        blocks = _parse_blocks(row, bg)
+        assert len(blocks) == block_count, "query rows must match the learned block count"
+        outputs.append(_paint_blocks(row.shape[0], bg, blocks, permutation, out_gaps, anchor))
+
