    for left, right in zip(blocks, blocks[1:]):
        assert right["start"] - left["end"] >= 2, "blocks must be separated by background"
    return blocks


def _gap_pattern(blocks: list[dict[str, int]]) -> tuple[int, ...]:
    return tuple(
        int(blocks[i + 1]["start"] - blocks[i]["end"] - 1)
