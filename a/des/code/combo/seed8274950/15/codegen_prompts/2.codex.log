+    c = int(start)
+    for i, block in enumerate(ordered):
+        length = int(block["length"])
+        assert c + length <= width, "transformed row must fit inside the grid"
+        out[c : c + length] = int(block["color"])
+        c += length
+        if i < len(out_gaps):
+            c += int(out_gaps[i])
+    return out
+
