    return int(candidates[0])


def _parse_blocks(row: np.ndarray, bg: int) -> list[dict[str, int]]:
    arr = np.asarray(row, dtype=int)
    blocks: list[dict[str, int]] = []
    c = 0
    width = arr.shape[0]
    while c < width:
        if int(arr[c]) == int(bg):
            c += 1
            continue
        color = int(arr[c])
        start = c
        while c < width and int(arr[c]) == color:
            c += 1
        end = c - 1
        blocks.append(
            {
                "color": color,
                "start": int(start),
                "end": int(end),
                "length": int(end - start + 1),
            }
