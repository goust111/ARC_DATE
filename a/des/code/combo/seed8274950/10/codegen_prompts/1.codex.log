+        if placed is None:
+            return None
+        cells, info = placed
+        for r, c in cells:
+            grid[r, c] = int(color)
+        occupied |= cells
+        blocked |= _chebyshev_buffer(cells, (h, w))
+        reserved_output |= set(info["footprint"])
