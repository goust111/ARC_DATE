+def _chebyshev_buffer(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    out = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
