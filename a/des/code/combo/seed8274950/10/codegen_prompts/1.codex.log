+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if int(np.count_nonzero(out == RED)) == 0 or int(np.count_nonzero(out == BLUE)) == 0:
+        return None
+    if int(np.count_nonzero(grid != bg)) < 18:
+        return None
+    return grid
