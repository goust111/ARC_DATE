+    arr = np.array(sorted(coords), dtype=int)
+    skeleton = _component_skeleton(arr)
+    endpoints = _skeleton_endpoints(skeleton)
+    rays: list[tuple[list[tuple[int, int]], int]] = []
+    footprint = set(skeleton)
+    for endpoint in endpoints:
