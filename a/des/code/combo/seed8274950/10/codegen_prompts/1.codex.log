+            edge, _unique = _edge_choice(endpoint, g.shape)
+            for rr, cc in _ray_cells(endpoint, edge[2], g.shape):
+                out[rr, cc] = int(edge[3])
+
+    return out
+
+
+GEN_ATTEMPTS = 400
+GRID_MIN = 16
+GRID_MAX = 24
+OBJECT_COUNT_CHOICES = (2, 3, 4)
