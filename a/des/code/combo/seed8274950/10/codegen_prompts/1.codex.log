+            return None
+        local_cells = _generate_ribbon(axis, max_major)
+        prefer_axis = "h" if idx % 2 == 0 else "v"
+        placed = _place_object((h, w), local_cells, occupied, blocked, reserved_output, prefer_axis)
+        if placed is None:
+            return None
+        cells, info = placed
+        for r, c in cells:
