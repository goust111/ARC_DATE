+def _orientation_schedule(count: int) -> list[str]:
+    base = ["h", "v"] * 2
+    if count == 2:
+        out = ["h", "v"]
+    elif count == 3:
+        out = ["h", "v", random.choice(("h", "v"))]
+    else:
+        out = base[:count]
+    random.shuffle(out)
+    return out
