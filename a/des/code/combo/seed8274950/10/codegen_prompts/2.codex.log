+import numpy as np
+
+
+MAX_GENERATION_ATTEMPTS = 300
+MIN_PANELS = 2
+MAX_PANELS = 5
+SEPARATOR_THICKNESS_CHOICES = (1, 2)
+MAX_GRID_HEIGHT = 28
+MAX_GRID_WIDTH = 28
+SELECTOR_WIDTH_RANGE = (4, 9)
+CONTENT_SIDE_RANGE = (2, 7)
+PANEL_MARGIN_RANGE = (1, 4)
+PANEL_EXTRA_WIDTH_RANGE = (0, 3)
+PANEL_EXTRA_HEIGHT_RANGE = (0, 3)
