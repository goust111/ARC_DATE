+        bottom = int(rng.integers(PANEL_MARGIN_RANGE[0], PANEL_MARGIN_RANGE[1]))
+        left = int(rng.integers(PANEL_MARGIN_RANGE[0], PANEL_MARGIN_RANGE[1]))
+        right = int(rng.integers(PANEL_MARGIN_RANGE[0], PANEL_MARGIN_RANGE[1]))
