+    if len(coords) != len(border) - 1:
+        return None
+
+    direction = _gap_direction(gap, (r0, c0, r1, c1))
+    if direction is None:
+        return None
+
+    return {
+        "color": int(comp["color"]),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "gap": (int(gap[0]), int(gap[1])),
+        "direction": direction,
+        "height": h,
+        "width": w,
+    }
