  51: def main(grid: np.ndarray) -> np.ndarray:
  52:     """
  53:     Complete the framed area by expanding the unique upper template that contains the existing seed pixels.
  54: 
  55:     Input structure:
  56:     - A teal background contains small colored template masks above a larger rectangular frame.
  57:     - The frame encloses one fill color arranged as a partial block-scaled copy of one template.
  58:     - The frame interior dimensions are an integer square scale of the matching template bbox.
  59: 
  60:     Rule:
  61:     - Crop to the rectangular frame.
  62:     - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.
  63:     - Reset the frame interior to background and paint the whole scaled mask with the fill color.
  64: 
  65:     Key insight:
  66:     The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.
  67:     """
  68:     g = np.asarray(grid, dtype=int)
  69:     bg = int(get_bg(g))
  70:     frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)
  71: 
  72:     out = g[r0 : r1 + 1, c0 : c1 + 1].copy()
  73:     interior = out[1:-1, 1:-1]
  74:     fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}
  75:     assert len(fill_colors) == 1, "frame interior must contain exactly one fill color"
  76:     fill_color = fill_colors.pop()
  77: 
  78:     seed = interior == fill_color
  79:     assert np.any(seed), "frame must contain seed pixels"
  80:     ih, iw = seed.shape
  81: 
  82:     matches: list[np.ndarray] = []
  83:     for template in _templates_above_frame(g, bg, r0):
  84:         th, tw = template.shape
  85:         if ih % th != 0 or iw % tw != 0:
  86:             continue
  87:         scale_h = ih // th
  88:         scale_w = iw // tw
  89:         if scale_h != scale_w:
  90:             continue
  91: 
  92:         scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))
  93:         if np.all(~seed | scaled):
  94:             matches.append(scaled)
  95: 
  96:     assert len(matches) == 1, "seed pixels must select exactly one scaled template"
  97:     completed = matches[0]
  98:     assert completed.shape == interior.shape
  99: 
 100:     interior[:, :] = bg
 101:     interior[completed] = fill_color
