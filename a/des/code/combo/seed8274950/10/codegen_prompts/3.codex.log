+    return {
+        "direction": direction,
+        "frame_color": int(frame_color),
+        "pattern_color": int(pattern_color),
+        "frame_cells": frame_cells,
+        "pattern_cells": pattern,
+        "moved_cells": moved,
+        "keep_r0": int(keep_r0),
+        "keep_c0": int(keep_c0),
+        "keep_h": int(keep_r1 - keep_r0 + 1),
+        "keep_w": int(keep_c1 - keep_c0 + 1),
