+
+    if not _valid_generated_grid(grid, n_frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt(rng)
