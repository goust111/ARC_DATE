+    for _ in range(untouched_count):
+        obj = _place_object((height, width), off_line_cells, set(), blocked, line_sets)
+        if obj is None:
+            return None
+        obj_cells = set(obj)
+        objects.append({"cells": obj, "hits": set()})
+        blocked |= _king_expand(obj_cells, (height, width))
