+
+    candidates: list[tuple[int, list[tuple[int, int]], list[tuple[int, int]]]] = []
+    for color in np.unique(g):
+        color = int(color)
+        row_mask = np.all(g == color, axis=1)
+        col_mask = np.all(g == color, axis=0)
+        if not bool(row_mask.any()) or not bool(col_mask.any()):
+            continue
