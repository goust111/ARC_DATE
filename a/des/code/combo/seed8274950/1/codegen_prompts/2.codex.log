+
+    inp = _render_grid(panels, panel_rows, panel_cols, panel_h, panel_w, separator)
+    if np.any(inp == RED):
+        return None
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp, expected
