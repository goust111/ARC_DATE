+            balanced = [panel_idx for panel_idx in candidates if panel_loads[panel_idx] <= min_load + 1]
+            panel_idx = random.choice(balanced)
+            assignments[site_idx].add(panel_idx)
+            remaining[site_idx] -= 1
+            panel_loads[panel_idx] += 1
+
