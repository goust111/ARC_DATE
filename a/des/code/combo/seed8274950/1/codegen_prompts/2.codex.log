+) -> np.ndarray:
+    panel_h = int(row_bands[0][1] - row_bands[0][0])
+    panel_w = int(col_bands[0][1] - col_bands[0][0])
+    panels = np.empty((len(row_bands) * len(col_bands), panel_h, panel_w), dtype=int)
