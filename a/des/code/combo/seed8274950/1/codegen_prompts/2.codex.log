+        row_sizes = {int(r1 - r0) for r0, r1 in row_bands}
+        col_sizes = {int(c1 - c0) for c0, c1 in col_bands}
+        if len(row_sizes) != 1 or len(col_sizes) != 1:
+            continue
+
+        candidates.append((color, row_bands, col_bands))
