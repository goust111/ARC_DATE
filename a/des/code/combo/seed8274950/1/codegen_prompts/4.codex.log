+    for _ in range(SPEC_RETRIES):
+        specs: list[dict] = []
+        used_areas: set[int] = set()
+        used_markers: set[tuple[int, int]] = set()
+        footprint_masks: list[np.ndarray] = []
+        overlap_pairs = 0
