  17: def main(grid: np.ndarray) -> np.ndarray:
  18:     """
  19:     Select the majority interior marker color, then redraw the framed board as that color's frame plus its bounding-box outline.
  20: 
  21:     Input structure:
  22:     - The top row is a copied palette made from adjacent equal color pairs.
  23:     - Below it is a one-cell-thick rectangular frame around a black interior.
  24:     - Non-black, non-frame interior pixels are marker colors; one marker color has
  25:       the unique highest count.
  26: 
  27:     Rule:
  28:     - Keep the palette row unchanged.
  29:     - Pick the uniquely most frequent interior marker color.
  30:     - Clear the lower board to black, recolor its outer frame with the picked color,
  31:       and draw the picked color's interior bounding-box border.
  32: 
  33:     Key insight:
  34:     - The noisy marker cloud is not preserved as pixels; only the majority marker
  35:       color and its spatial extent define the output.
  36:     """
  37:     g = np.asarray(grid, dtype=int)
  38:     assert g.ndim == 2, "expected a 2D grid"
  39:     height, width = map(int, g.shape)
  40:     assert height >= 4 and width >= 4, "expected room for a palette row, frame, and interior"
  41: 
  42:     palette = g[0, :].copy()
  43:     assert width % 2 == 0, "palette row must split into adjacent color pairs"
  44:     palette_pairs = palette.reshape(-1, 2)
  45:     assert np.all(palette_pairs[:, 0] == palette_pairs[:, 1]), "expected paired palette colors"
  46:     palette_colors = set(map(int, palette_pairs[:, 0]))
