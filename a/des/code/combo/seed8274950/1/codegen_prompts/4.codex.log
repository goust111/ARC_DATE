+def _random_rect(style: str, h: int, w: int, rng: random.Random) -> tuple[int, int, int, int]:
+    min_span = 1 if style == "full" else 2
+    rect_h = rng.randint(min_span + 1, h)
+    rect_w = rng.randint(min_span + 1, w)
