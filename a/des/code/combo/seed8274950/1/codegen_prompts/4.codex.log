+    pair_count, open_count = rng.choice(COUNT_OPTIONS)
+    total = pair_count + open_count
+    if total > len(colors):
+        return None
+
+    styles = ["full"] * pair_count + ["open"] * open_count
+    rng.shuffle(styles)
+    want_overlap = total >= 3 and rng.random() < 0.5
