+                        "color": colors[len(specs)],
+                        "style": style,
+                        "r0": r0,
+                        "c0": c0,
+                        "r1": r1,
+                        "c1": c1,
+                        "area": area,
+                        "markers": markers,
+                    }
+                )
+                used_areas.add(area)
+                used_markers.update(markers)
+                footprint_masks.append(mask)
+                overlap_pairs += local_overlap_pairs
+                overlap_points += local_overlap_points
