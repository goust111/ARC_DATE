+    if np.array_equal(inp, expected):
+        return None
+    if _get_bg(inp) != bg:
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
