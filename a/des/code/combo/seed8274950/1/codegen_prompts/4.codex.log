+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(10, 20)
+    w = rng.randint(10, 20)
+    bg = rng.randint(0, 9)
+
+    specs = _try_build_specs(h, w, bg, rng)
+    if specs is None:
