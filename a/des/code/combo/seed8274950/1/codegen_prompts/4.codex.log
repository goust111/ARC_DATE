+                local_overlap_points = 0
+                for old_mask in footprint_masks:
+                    inter = int(np.count_nonzero(mask & old_mask))
+                    if inter > 0:
+                        local_overlap_pairs += 1
+                        local_overlap_points += inter
+                if local_overlap_pairs > 1:
+                    continue
