 119: def main(grid: np.ndarray) -> np.ndarray:
 120:     """
 121:     Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.
 122: 
 123:     Input structure:
 124:     - Black background with several axis-aligned colored line drawings.
 125:     - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.
 126:     - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.
 127: 
 128:     Rule:
 129:     - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.
 130:     - Count the 4-connected background regions fully enclosed by those reconstructed walls.
 131:     - The color with no enclosed region is the noise/pad color.
 132:     - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.
 133: 
 134:     Key insight:
 135:     - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.
 136:     """
 137:     g = np.asarray(grid, dtype=int)
 138:     bg = int(get_bg(g))
 139:     assert bg == 0
 140: 
 141:     counts: list[tuple[int, int, np.ndarray]] = []
 142:     for color in colors_present(g, exclude={bg}):
 143:         rooms = _room_count_for_color(g, int(color))
 144:         walls = _walls_for_color(g, int(color))
 145:         counts.append((int(color), int(rooms), walls))
 146: 
 147:     drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]
 148:     pad_colors = [color for color, rooms, _walls in counts if rooms == 0]
 149:     assert drawings
 150:     assert len(pad_colors) == 1
 151: 
 152:     pad = int(pad_colors[0])
 153:     ordered: list[tuple[int, int, np.ndarray]] = []
 154:     for rooms in sorted({rooms for _color, rooms, _walls in drawings}):
 155:         group = [item for item in drawings if item[1] == rooms]
 156:         ordered.extend(_cover_order(g, group))
 157: 
 158:     width = max(rooms for _color, rooms, _walls in ordered)
 159: 
 160:     out = np.full((len(ordered), width), pad, dtype=int)
 161:     for r, (color, rooms, _walls) in enumerate(ordered):
 162:         out[r, :rooms] = int(color)
