 153: def _cast_main_rays(n, orientation, length, pos, colors):
 154:     """Place the main run and cast 4 diagonal rays from each pixel (with occlusion). Returns (ray_grid, coords) or (None, None)."""
 155:     ray = np.zeros((n, n), dtype=int)
 156:     if orientation == "H":
 157:         coords = [(pos, c) for c in range(n - length, n)]
 158:     else:
 159:         coords = [(r, pos) for r in range(n - length, n)]
