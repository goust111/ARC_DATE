 377: def _choose_colors(rng, N, num_filled):
 378:     """Pick palette border/fill colors, distractor color, and filled-sprite keys."""
 379:     all_c = list(range(1, 10))
 380:     rng.shuffle(all_c)
 381:     border_keys = all_c[:N]
 382:     rng.shuffle(all_c)
 383:     fill_values = all_c[:N]
 384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]
 385:     distractor_color = rng.choice(dist_cands)
 386:     mapping = dict(zip(border_keys, fill_values))
 387:     filled_keys = rng.sample(border_keys, num_filled)
 388:     return border_keys, fill_values, distractor_color, mapping, filled_keys
