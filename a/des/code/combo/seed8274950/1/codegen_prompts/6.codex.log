 227: def _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:
 228:     """Top-left coordinate for a patch placed at the given grid corner."""
 229:     if corner == 'TL': return 0, 0
 230:     if corner == 'TR': return 0, w - pw
 231:     if corner == 'BL': return h - ph, 0
 232:     if corner == 'BR': return h - ph, w - pw
 233:     raise ValueError(corner)
