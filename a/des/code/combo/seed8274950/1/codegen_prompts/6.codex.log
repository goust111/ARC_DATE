 244: def _flood_mask(start, blocked, h, w):
 245:     """BFS from `start` on the ~blocked bool grid; return reach as (h,w) bool array."""
 246:     reach = np.zeros((h, w), dtype=bool)
 247:     reach[start] = True
 248:     q = deque([start])
 249:     while q:
 250:         r, c = q.popleft()
 251:         for nr, nc in neighbors4(r, c):
 252:             if 0 <= nr < h and 0 <= nc < w and not reach[nr, nc] and not blocked[nr, nc]:
 253:                 reach[nr, nc] = True
 254:                 q.append((nr, nc))
 255:     return reach
 256: 
 257: 
 258: def _touches_border(mask):
 259:     return mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any()
 260: 
 261: 
 262: def _dilate4(mask):
 263:     """4-connected dilation by 1 via boolean slicing."""
 264:     out = mask.copy()
 265:     out[1:, :] |= mask[:-1, :]
 266:     out[:-1, :] |= mask[1:, :]
 267:     out[:, 1:] |= mask[:, :-1]
 268:     out[:, :-1] |= mask[:, 1:]
 269:     return out
 270: 
 271: 
 272: def _dilate8(mask):
 273:     """8-connected dilation by 1 via 4-conn dilation of a 4-conn dilation."""
 274:     m = _dilate4(mask)
 275:     # add diagonals
 276:     m[1:, 1:] |= mask[:-1, :-1]
 277:     m[1:, :-1] |= mask[:-1, 1:]
 278:     m[:-1, 1:] |= mask[1:, :-1]
 279:     m[:-1, :-1] |= mask[1:, 1:]
 280:     return m
