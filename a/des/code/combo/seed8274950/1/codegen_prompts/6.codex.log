 178:     next_label = 0
 179:     for sr, sc in np.argwhere(ray == 0):
 180:         sr, sc = int(sr), int(sc)
 181:         if labels[sr, sc] >= 0:
 182:             continue
 183:         for cell in _diag_flood(ray, [(sr, sc)]):
 184:             labels[cell] = next_label
 185:         next_label += 1
 186:     return labels
