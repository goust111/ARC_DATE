 138: def _diag_flood(ray, seeds):
 139:     """BFS all zero-cells in *ray* diag-reachable from *seeds*. Returns the visited set (includes seeds)."""
 140:     n = ray.shape[0]
 141:     seen = set(seeds)
 142:     q = deque(seeds)
 143:     while q:
 144:         r, c = q.popleft()
 145:         for dr, dc in _DIAG_DIRS:
 146:             nr, nc = r + dr, c + dc
 147:             if 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0 and (nr, nc) not in seen:
 148:                 seen.add((nr, nc))
 149:                 q.append((nr, nc))
 150:     return seen
