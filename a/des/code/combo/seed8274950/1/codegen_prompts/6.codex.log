 243: def _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:
 244:     """Sample start/end markers on opposite outer corridors."""
 245:     edge_lo, edge_hi = MARKER_EDGE_RANGE
 246:     if orientation == "vertical":
 247:         start_col = rng.randint(edge_lo, edge_hi)
 248:         start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
 249:         end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)
 250:         end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
 251:     else:
 252:         start_row = rng.randint(edge_lo, edge_hi)
 253:         start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
 254:         end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)
 255:         end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
