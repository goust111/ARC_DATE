 287: def _place_structural_walls(h, w, marker_rc, rng):
 288:     """Place 1..NUM_STRUCTS_RANGE non-overlapping shapes; skip any that cover marker."""
 289:     num = rng.randint(*NUM_STRUCTS_RANGE)
 290:     structural = np.zeros((h, w), dtype=bool)
 291:     placed = 0
 292:     for _ in range(num):
 293:         for _try in range(STRUCT_SHAPE_RETRIES):
 294:             cells = rng.choice(SHAPE_FACTORIES)(h, w, rng)
 295:             if not cells:
 296:                 continue
 297:             if marker_rc in cells or any(structural[r, c] for r, c in cells):
 298:                 continue
 299:             for r, c in cells:
 300:                 structural[r, c] = True
 301:             placed += 1
 302:             break
 303:     return structural if placed > 0 else None
 304: 
 305: 
 306: def _validate_structural(structural, reach, h, w):
 307:     """Every 4-conn structural component must touch a border AND be 4-adj to reach;
 308:     this mirrors how the solver re-identifies structural walls."""
 309:     reach_nbr = _dilate4(reach)
 310:     for comp_arr in components_mask(structural, connectivity=4):
 311:         cmask = np.zeros((h, w), dtype=bool)
 312:         cmask[comp_arr[:, 0], comp_arr[:, 1]] = True
 313:         if not _touches_border(cmask):
 314:             return False
 315:         if not (cmask & reach_nbr).any():
 316:             return False
 317:     return True
 318: 
 319: 
 320: def _paint_output(structural, reach, marker_rc):
 321:     """Build solver-style output: BG / WALL / MARKER / FILL."""
 322:     h, w = structural.shape
 323:     out = np.full((h, w), BG, dtype=int)
 324:     out[structural] = WALL
 325:     out[marker_rc] = MARKER
 326: 
 327:     # Cells eligible to become FILL: reachable BG interior.
 328:     candidate = reach & (out == BG)
 329: 
 330:     # On grid edge.
 331:     edge = np.zeros_like(candidate)
 332:     edge[0, :] = edge[-1, :] = True
 333:     edge[:, 0] = edge[:, -1] = True
 334: 
 335:     # 8-adjacent to a structural wall.
 336:     near_struct = _dilate8(structural)
 337: 
 338:     # 4-adjacent to an unreachable cell.
 339:     near_unreach = _dilate4(~reach)
 340: 
 341:     fill = candidate & (edge | near_struct | near_unreach)
 342:     out[fill] = FILL
 343:     return out
