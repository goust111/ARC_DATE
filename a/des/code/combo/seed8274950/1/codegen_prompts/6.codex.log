 449: def _gen_attempt():
 450:     rng = random.Random()
 451:     bg = 0
 452: 
 453:     # Grid size and palette side
 454:     H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
 455:     W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
 456:     side = rng.choice(['top', 'bottom', 'left', 'right'])
 457:     if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:
 458:         side = rng.choice(['left', 'right'])
 459: 
 460:     max_N = H if side in ('left', 'right') else W
 461:     N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))
 462: 
 463:     # Sprite dimension bounds
 464:     max_sh = min(_SPRITE_H_MAX, H)
 465:     max_sw = min(_SPRITE_W_MAX, W)
 466:     if H <= _TINY_H_THRESHOLD:
 467:         max_sh = 3
 468: 
 469:     # Sprite counts
 470:     num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))
 471:     total_sprites = num_filled + 1
 472: 
 473:     # Generate sprite shapes
 474:     shapes = []
 475:     for _ in range(total_sprites):
 476:         sh = rng.randint(3, max_sh)
 477:         sw = rng.randint(3, max_sw)
 478:         if sh + sw > _SPRITE_DIM_SUM_CAP:
 479:             sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
 480:         if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
 481:             mask = _make_diamond()
 482:         else:
 483:             mask = _make_hollow_sprite(sh, sw, rng)
 484:         if mask is None:
 485:             return None
 486:         shapes.append(mask)
 487: 
 488:     # Colors and palette
 489:     border_keys, fill_values, distractor_color, mapping, filled_keys = \
 490:         _choose_colors(rng, N, num_filled)
 491:     pal = _build_palette(side, border_keys, fill_values)
 492: 
 493:     grid = np.full((H, W), bg, dtype=int)
 494:     occ = np.zeros((H, W), dtype=bool)
 495:     _place_palette(grid, occ, pal, side, rng)
 496: 
 497:     # Assign colors to sprites: filled sprites use palette keys, last one is distractor
 498:     infos = []
 499:     for i, mask in enumerate(shapes):
 500:         if i < num_filled:
 501:             c, f = filled_keys[i], mapping[filled_keys[i]]
 502:         else:
 503:             c, f = distractor_color, None
 504:         infos.append((mask, c, f))
 505: 
 506:     # Place sprites
 507:     placed = []
 508:     for mask, color, fill in infos:
 509:         holes = _get_enclosed_holes(mask)
 510:         positions = _find_valid_positions(H, W, occ, mask, holes)
 511:         if not positions:
 512:             return None
 513:         r0, c0 = rng.choice(positions)
 514:         _paint_sprite(grid, r0, c0, mask, color, fill, holes)
 515:         placed.append((r0, c0, mask, fill))
 516:         sh, sw = mask.shape
 517:         occ[max(0, r0 - 1):min(H, r0 + sh + 1),
 518:             max(0, c0 - 1):min(W, c0 + sw + 1)] = True
 519: 
