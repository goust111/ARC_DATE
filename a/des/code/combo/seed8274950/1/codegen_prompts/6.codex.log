 161:     for (r, c), color in zip(coords, colors):
 162:         if ray[r, c] != 0:
 163:             return None, None
 164:         ray[r, c] = color
 165:         for dr, dc in _DIAG_DIRS:
 166:             nr, nc = r + dr, c + dc
 167:             while 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0:
 168:                 ray[nr, nc] = color
 169:                 nr += dr
 170:                 nc += dc
 171:     return ray, coords
