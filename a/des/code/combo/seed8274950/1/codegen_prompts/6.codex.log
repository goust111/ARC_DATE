 338: def _make_diamond():
 339:     """Return a 3x3 diamond-shaped boolean mask."""
 340:     s = np.zeros((3, 3), dtype=bool)
 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
 342:     return s
