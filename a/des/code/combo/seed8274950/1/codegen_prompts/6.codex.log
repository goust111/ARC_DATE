 346: def _place_decor(allowed_mask, count, rng):
 347:     """Place `count` decoration patches in `allowed_mask` cells.
 348: 
 349:     Enforces border>=DECOR_BORDER and padding=DECOR_PADDING (8-conn) so each
 350:     patch stays isolated. Returns a bool mask, or None if any patch fails.
 351:     """
 352:     h, w = allowed_mask.shape
 353:     placed = np.zeros((h, w), dtype=bool)
 354:     if count == 0:
 355:         return placed
 356:     for _ in range(count):
 357:         area = rng.randint(*DECOR_AREA_RANGE)
 358:         shapes = [(1, area), (area, 1)]
 359:         if area >= 3:
 360:             shapes.append((2, 2))
 361:         rng.shuffle(shapes)
 362:         for ph, pw in shapes:
 363:             if ph > h or pw > w:
 364:                 continue
 365:             patch = np.ones((ph, pw), dtype=int)
 366:             canvas = np.where(allowed_mask & ~placed, 0, 9)
 367:             try:
 368:                 r0, c0 = random_free_location(
 369:                     canvas, patch, transparent=0,
 370:                     border=DECOR_BORDER, padding=DECOR_PADDING, padding_connectivity=8,
 371:                 )
 372:             except ValueError:
 373:                 continue
 374:             placed[r0:r0 + ph, c0:c0 + pw] = True
 375:             break
