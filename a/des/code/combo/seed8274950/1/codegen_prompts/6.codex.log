 318: def _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:
 319:     nr, nc = r + dr, c + dc
 320:     if (nr, nc) not in region_set:
 321:         return False
 322:     if dr != 0 and dc != 0:
 323:         if (r + dr, c) not in region_set or (r, c + dc) not in region_set:
 324:             return False
 325:     return True
 326: 
 327: 
 328: def _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,
 329:                    blocked: set) -> tuple[int, int]:
 330:     """Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker."""
 331:     r, c = start
 332:     while True:
 333:         if not _slide_step_valid(region_set, r, c, dr, dc):
 334:             break
 335:         nr, nc = r + dr, c + dc
 336:         if (nr, nc) in blocked:
 337:             break
 338:         r, c = nr, nc
 339:     return (r, c)
