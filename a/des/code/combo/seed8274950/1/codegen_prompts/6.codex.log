 236: # ── Blob growing / topology ──────────────────────────────────────
 237: 
 238: def _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,
 239:                rng: random.Random) -> set[tuple[int, int]] | None:
 240:     """Random-walk growth of a 4-connected blob on free cells."""
 241:     h, w = canvas_mask.shape
 242:     sr, sc = seed
 243:     if not canvas_mask[sr, sc]:
 244:         return None
 245:     blob = {(sr, sc)}
 246:     frontier = []
 247:     def push_neighbors(r, c):
 248:         for nr, nc in neighbors4(r, c):
 249:             if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:
 250:                 frontier.append((nr, nc))
 251:     push_neighbors(sr, sc)
 252:     while len(blob) < target_size and frontier:
 253:         idx = rng.randrange(len(frontier))
 254:         r, c = frontier.pop(idx)
 255:         if (r, c) in blob or not canvas_mask[r, c]:
 256:             continue
 257:         blob.add((r, c))
 258:         push_neighbors(r, c)
 259:     if len(blob) < target_size:
 260:         return None
 261:     return blob
 262: 
