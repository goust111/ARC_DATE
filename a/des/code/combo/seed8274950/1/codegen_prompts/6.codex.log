  21: def main(grid: np.ndarray) -> np.ndarray:
  22:     """
  23:     Paint an inner border around the region reachable from a corner marker pixel.
  24: 
  25:     Input structure:
  26:     - bg = most common color; wall color (blue) forms barriers dividing the grid.
  27:     - A unique single pixel (magenta) sits on one corner — the start marker.
  28:     - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.
  29: 
  30:     Rule:
  31:     - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.
  32:     - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).
  33:     - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.
  34: 
  35:     Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.
  36:     """
  37:     g = np.asarray(grid, dtype=int)
  38:     h, w = g.shape
  39:     bg = get_bg(g)
  40: 
  41:     out = g.copy()
  42: 
  43:     # Marker pixel is a unique (count==1) non-bg pixel on a corner.
  44:     counts = Counter(int(v) for v in g.ravel())
  45:     corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
  46:     marker = None
  47:     for r, c in corners:
  48:         v = int(g[r, c])
  49:         if v != bg and counts.get(v, 0) == 1:
  50:             marker = (r, c, v)
  51:             break
  52:     assert marker is not None, "no unique single-pixel corner marker found"
  53: 
  54:     mr, mc, marker_col = marker
  55: 
  56:     # Wall color: most frequent non-bg, non-marker color.
  57:     other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]
  58:     assert other_cols, "no non-bg non-marker colors found; cannot determine wall color"
  59:     wall_col = max(other_cols, key=lambda c: counts[c])
  60: 
  61:     # First reach: treat all wall pixels as obstacles.
  62:     reach0 = _flood(
  63:         (mr, mc),
  64:         lambda r, c: int(g[r, c]) in (bg, marker_col),
  65:         h,
  66:         w,
  67:     )
  68: 
  69:     # Structural walls are wall-color components that touch the border AND are adjacent to reach0.
  70:     walls: set[tuple[int, int]] = set()
  71:     for comp_arr in components_mask(g == wall_col, connectivity=4):
  72:         comp = [(int(r), int(c)) for r, c in comp_arr]
  73:         touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)
  74:         if not touches_border:
  75:             continue
  76:         adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)
  77:         if adjacent_to_reach0:
  78:             walls |= set(comp)
  79: 
  80:     # Second reach: allow passing through non-wall wall-color pixels (decorations) so they don't create borders.
  81:     reach = _flood(
  82:         (mr, mc),
  83:         lambda r, c: int(g[r, c]) in (bg, marker_col) or (int(g[r, c]) == wall_col and (r, c) not in walls),
  84:         h,
  85:         w,
  86:     )
  87: 
  88:     # Remove wall-colored decorations that are not reachable (they lie behind structural walls).
  89:     for r in range(h):
  90:         for c in range(w):
  91:             if int(out[r, c]) == wall_col and (r, c) not in walls and (r, c) not in reach:
  92:                 out[r, c] = bg
  93: 
  94:     fill_col = 7
  95:     # Paint a 1-cell-thick inner border of the reachable region (on background cells only).
  96:     for r, c in reach:
  97:         if int(out[r, c]) != bg:
  98:             continue
  99:         if r == 0 or c == 0 or r == h - 1 or c == w - 1:
 100:             out[r, c] = fill_col
 101:             continue
 102:         if any((nr, nc) in walls for nr, nc in neighbors8(r, c)):
 103:             out[r, c] = fill_col
 104:             continue
 105:         if any((nr, nc) not in reach for nr, nc in neighbors4(r, c)):
 106:             out[r, c] = fill_col
 107: 
 108:     return out
