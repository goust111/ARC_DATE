 168: def _shape_rectangle(h, w, rng):
 169:     rh = rng.randint(2, max(2, h // RECT_MAX_DIM_DIV))
 170:     rw = rng.randint(2, max(2, w // RECT_MAX_DIM_DIV))
 171:     anchor = rng.choice(['top', 'right', 'tr', 'top_mid', 'right_mid', 'bottom_right'])
 172:     if anchor == 'top':
 173:         r0, c0 = 0, rng.randint(1, max(1, w - rw - 1))
 174:     elif anchor == 'right':
 175:         r0, c0 = rng.randint(1, max(1, h - rh - 1)), w - rw
 176:     elif anchor == 'tr':
 177:         r0, c0 = 0, w - rw
 178:     elif anchor == 'top_mid':
 179:         r0, c0 = 0, rng.randint(2, max(2, w - rw - 2))
 180:     elif anchor == 'right_mid':
 181:         r0, c0 = rng.randint(2, max(2, h - rh - 2)), w - rw
 182:     else:
 183:         r0, c0 = h - rh, w - rw
 184:     return [(r, c) for r in range(r0, r0 + rh) for c in range(c0, c0 + rw)]
