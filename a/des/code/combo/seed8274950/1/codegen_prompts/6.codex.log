 268:     else:
 269:         for wall_row, door_col in zip(walls, doors):
 270:             grid[wall_row, :] = wall_color
 271:             grid[wall_row, door_col - 1 : door_col + 2] = door_color
 272: 
 273:     grid[start] = marker_color
 274:     grid[end] = marker_color
 275:     return grid
