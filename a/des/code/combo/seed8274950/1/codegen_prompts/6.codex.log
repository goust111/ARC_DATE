 227: def _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):
 228:     """Return wall positions and per-wall door centers for the chosen orientation."""
 229:     wall_axis, door_axis = (GRID_W, GRID_H) if orientation == "vertical" else (GRID_H, GRID_W)
 230:     walls = _place_positions(
 231:         n_walls,
 232:         lo=WALL_POS_LO,
 233:         hi=wall_axis - WALL_POS_HI_MARGIN,
 234:         min_gap=WALL_MIN_GAP,
 235:         rng=rng,
 236:     )
 237:     if walls is None:
 238:         return None
 239:     doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]
 240:     return walls, doors
