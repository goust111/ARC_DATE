 147: def _shape_vertical_line(h, w, rng):
 148:     c = rng.randint(2, w - 2)
 149:     mode = rng.choice(['top', 'bottom', 'full'])
 150:     if mode == 'full':
 151:         r0, r1 = 0, h - 1
 152:     elif mode == 'top':
 153:         r0, r1 = 0, rng.randint(max(1, h // 3), h - 2)
 154:     else:
 155:         r0, r1 = rng.randint(1, h - max(2, h // 3)), h - 1
 156:     return [(r, c) for r in range(r0, r1 + 1)]
