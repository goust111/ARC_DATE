+def _expand_cells(base: np.ndarray, seeds: list[tuple[int, int]], steps: int, bg: int) -> list[tuple[int, int]]:
+    if steps <= 0:
+        return []
+    h, w = base.shape
+    seen = np.zeros((h, w), dtype=bool)
