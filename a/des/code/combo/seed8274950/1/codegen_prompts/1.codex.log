+        for r, c in _expand_cells(filled, region["coords"], int(region["k"]), bg):
+            grow_mask[r, c] = True
+    out[grow_mask] = int(main_color)
+    for sprite in sprites:
+        for r, c in sprite["coords"]:
+            out[r, c] = int(bg)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = random.randrange(10)
