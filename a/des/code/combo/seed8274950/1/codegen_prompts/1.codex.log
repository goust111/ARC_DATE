+def _build_expected(
+    inp: np.ndarray,
+    *,
+    bg: int,
+    main_color: int,
+    regions: list[dict[str, object]],
+    sprites: list[dict[str, object]],
+) -> np.ndarray:
+    out = inp.copy()
+    for region in regions:
+        for hole in region["holes"]:
+            for r, c in hole["coords"]:
+                out[r, c] = int(hole["color"])
