+            if not placed:
+                return None
+
+    expected = _build_expected(inp, bg=bg, main_color=main_color, regions=placed_regions, sprites=sprites)
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
