+    if not bool(bg.any()):
+        return False
+    h, w = bg.shape
+    seen = np.zeros_like(bg, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(bg[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(bg[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nr = int(r + dr)
+            nc = int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w and bool(bg[nr, nc]) and not bool(seen[nr, nc]):
+                seen[nr, nc] = True
+                stack.append((nr, nc))
