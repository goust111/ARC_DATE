+    while q:
+        r, c, dist = q.popleft()
+        if dist >= steps:
+            continue
+        for dr, dc in DIR4:
+            nr = int(r + dr)
+            nc = int(c + dc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if bool(seen[nr, nc]) or int(base[nr, nc]) != int(bg):
+                continue
+            seen[nr, nc] = True
+            grown.append((nr, nc))
+            q.append((nr, nc, dist + 1))
