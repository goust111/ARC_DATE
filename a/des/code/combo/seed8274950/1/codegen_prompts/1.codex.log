+def _random_span(length: int) -> tuple[int, int]:
+    if length <= 2:
+        return 0, length
+    lo = max(2, length // 3)
+    hi = length if random.random() < 0.35 else max(lo, length - 1)
+    span = random.randint(lo, hi)
+    start = random.randint(0, length - span)
+    return start, span
