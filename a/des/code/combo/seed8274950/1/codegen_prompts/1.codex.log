def _gen_attempt() -> np.ndarray | None:
    design = _sample_design()
    if design is None:
        return None
    colors, oriented_masks, expected = design
    grid = _build_input_grid(colors, oriented_masks)
    if grid is None:
        return None
    try:
        actual = main(grid)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


