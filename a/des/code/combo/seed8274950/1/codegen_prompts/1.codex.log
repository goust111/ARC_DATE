+def _unique_shapes(n: int) -> list[np.ndarray] | None:
+    shapes: list[np.ndarray] = []
+    seen: set[tuple[str, ...]] = set()
+    for _ in range(GEN_SHAPE_RETRIES):
+        mask = _random_connected_mask()
+        if mask is None:
+            continue
+        sig = _shape_signature(mask)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        shapes.append(mask)
+        if len(shapes) == n:
+            return shapes
+    return None
