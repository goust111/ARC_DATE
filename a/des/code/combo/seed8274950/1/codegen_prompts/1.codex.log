+                _paste_patch(inp, sprite_patch, r0, c0, bg)
+                coords = [(int(r0 + r), int(c0 + c)) for r, c in np.argwhere(shape)]
+                sprites.append({"coords": coords, "bbox": cand_bbox})
+                placed = True
