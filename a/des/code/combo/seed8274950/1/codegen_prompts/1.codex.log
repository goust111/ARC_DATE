+                    {
+                        "coords": [(int(r0 + r), int(c0 + c)) for r, c in hole["coords"]],
+                        "color": int(hole["color"]),
+                        "signature": hole["signature"],
+                    }
+                )
+            placed_regions.append(
+                {
+                    "coords": [(int(r0 + r), int(c0 + c)) for r, c in spec["region_coords"]],
+                    "bbox": cand_bbox,
+                    "k": int(spec["k"]),
+                    "holes": holes,
+                }
