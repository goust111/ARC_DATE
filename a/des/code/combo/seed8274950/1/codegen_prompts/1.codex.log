+def _dilate_box(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    if radius <= 0:
+        return mask.copy()
+    h, w = mask.shape
+    padded = np.pad(mask, radius, constant_values=False)
+    out = np.zeros((h, w), dtype=bool)
+    span = 2 * radius + 1
+    for dr in range(span):
+        for dc in range(span):
