+GEN_MAX_ATTEMPTS = 400
+GEN_REGION_RETRIES = 120
+GEN_GRID_H = (24, 36)
+GEN_GRID_W = (24, 38)
+GEN_REGION_COUNT = (1, 3)
+GEN_HOLES_PER_REGION = (1, 3)
+GEN_REGION_BORDER = 4
+GEN_REGION_PADDING = 2
+GEN_SPRITE_PADDING = 1
+GEN_SPRITE_REGION_GAP = 5
+GEN_SHAPE_RETRIES = 300
