import numpy as np


def dominant_direction(coords):
    coords = np.asarray(coords, dtype=int)
    n = len(coords)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    vr = int(2 * coords[:, 0].sum() - n * (r0 + r1))
    vc = int(2 * coords[:, 1].sum() - n * (c0 + c1))
    if abs(vr) == abs(vc):
        return None, vr, vc
    if abs(vr) > abs(vc):
