+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR_TO_TURNS = {
+    "up": 0,
+    "right": 1,
+    "down": 2,
+    "left": 3,
+}
+
+BG_PALETTE = tuple(range(10))
+GRID_HEIGHT_RANGE = (22, 30)
+GRID_WIDTH_RANGE = (22, 30)
+OBJECT_COUNT_OPTIONS = (4, 5)
+CLEARANCE = 1
+BORDER = 1
+GEN_ATTEMPTS = 300
+SHAPE_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 250
+ODD_DIMS = (3, 5, 7)
+EVEN_DIMS = (4, 6)
