+            nc_num = C + 2 * r - R
+            assert nr_num % 2 == 0 and nc_num % 2 == 0, "90-degree rotation must stay on the integer lattice"
+            nr, nc = nr_num // 2, nc_num // 2
+        out.append((int(nr), int(nc)))
