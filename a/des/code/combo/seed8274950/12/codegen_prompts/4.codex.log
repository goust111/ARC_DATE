+
+        for r, c in placed_input:
+            grid[r, c] = color
+        blocked_input.update(_expand(placed_input, h, w, CLEARANCE))
+        blocked_output.update(_expand(placed_output, h, w, CLEARANCE))
+        return True
+
+    return False
