+            if r == 0 or w <= 3 or _RNG.random() < 0.55:
+                left, right = 0, w - 1
+            else:
+                dent_left = _RNG.randint(0, 1)
+                dent_right = _RNG.randint(0, 1)
+                if dent_left + dent_right >= w - 1:
