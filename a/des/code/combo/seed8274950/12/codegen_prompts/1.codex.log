  59: def main(grid: np.ndarray) -> np.ndarray:
  60:     """
  61:     Fill the small background compartments bounded by the long contour color.
  62: 
  63:     Input structure:
  64:     - The grid has one dominant background color and two foreground colors.
  65:     - The more frequent foreground color forms long 8-connected contour fragments.
  66:     - The other foreground color is a fixed distractor/obstacle color that partitions
  67:       the background but is never recolored.
  68: 
  69:     Rule:
  70:     - Split the background into 4-connected regions using all foreground pixels as
  71:       barriers.
  72:     - Keep the two largest background regions as the outside of the contour drawing.
  73:     - Recolor every other background region that touches a long contour component
  74:       to the contour color; leave all foreground pixels unchanged.
  75: 
  76:     Key insight:
  77:     The apparent area fill is exactly a component-level fill of bounded background
  78:     compartments, not a row-wise interpolation between individual contour pixels.
  79:     """
  80:     g = np.asarray(grid, dtype=int)
  81:     bg = get_bg(g)
  82:     foreground = colors_present(g, exclude={bg})
  83:     assert len(foreground) == 2, "expected exactly two foreground colors"
  84: 
  85:     fill_color = _unique_largest_color(g, foreground)
  86:     fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)
  87:     long_ids = _long_component_ids(fill_lab, _n_fill)
  88: 
