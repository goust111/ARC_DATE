+            r1 = min(h, top + mh + 1)
+            c0 = max(0, left - 1)
+            c1 = min(w, left + mw + 1)
+            blocked[r0:r1, c0:c1] = True
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = int(RNG.integers(0, 10))
+    double_count = int(RNG.integers(*DOUBLE_COUNT_RANGE))
+    categories = ["both"] * double_count + ["h", "v", "none"]
+
