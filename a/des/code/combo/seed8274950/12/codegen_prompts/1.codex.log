+    max_w = max(int(spec["mask"].shape[1]) for spec in specs)
+    reserve_area = sum((int(spec["mask"].shape[0]) + 2) * (int(spec["mask"].shape[1]) + 2) for spec in specs)
+    approx_side = int(np.ceil(np.sqrt(reserve_area)))
