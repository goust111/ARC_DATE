+    h_low = max(GRID_H_RANGE[0], max_h + 4, min(approx_side, GRID_H_RANGE[1]))
+    w_low = max(GRID_W_RANGE[0], max_w + 4, min(approx_side, GRID_W_RANGE[1]))
