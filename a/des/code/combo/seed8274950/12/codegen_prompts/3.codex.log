+                counts[color] = counts.get(color, 0) + 1
+            best = max(counts.values())
+            winners = [color for color, count in counts.items() if count == best]
+            if len(winners) != 1:
+                return None
+            pattern[rr, cc] = winners[0]
+    return pattern
+
