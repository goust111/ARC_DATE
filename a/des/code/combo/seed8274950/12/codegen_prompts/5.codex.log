+                continue
+
+            queue = deque([(r0, c0)])
+            seen[r0, c0] = True
+            touches_border = False
+            area = 0
+            adjacent_components: set[int] = set()
+
+            while queue:
+                r, c = queue.popleft()
+                area += 1
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_border = True
+
+                for dr, dc in DIRS4:
+                    rr = int(r + dr)
+                    cc = int(c + dc)
+                    if not (0 <= rr < h and 0 <= cc < w):
