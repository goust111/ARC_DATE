+                c0 + cc * cell_w : c0 + (cc + 1) * cell_w,
+            ]
+            color = int(patch[0, 0])
+            assert color != bg and color != frame_color
+            assert np.all(patch == color), "each source tile must be monochrome"
+            matrix[rr, cc] = color
