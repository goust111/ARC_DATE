+
+    assert frame_count > 0, "expected at least one frame with enclosed holes"
+    return out
+
+
+def _make_frame(rng: random.Random, bg: int, color: int, hole_count: int) -> np.ndarray:
+    for _ in range(FRAME_RETRIES):
