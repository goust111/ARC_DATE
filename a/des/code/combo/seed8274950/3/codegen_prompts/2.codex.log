+
+GEN_RETRIES = 400
+FRAME_RETRIES = 200
+PLACEMENT_TRIES = 300
+GRID_MIN = 16
+GRID_MAX = 30
+LEGEND_LEN_MIN = 2
+LEGEND_LEN_MAX = 5
+FRAME_COUNT_MIN = 2
+FRAME_COUNT_MAX = 4
