+        out[r, c] = bg
+    for top, left, frame, hole_count in placements:
+        fill_color = legend_colors[hole_count - 1]
+        target = out[top : top + frame.shape[0], left : left + frame.shape[1]]
+        target[frame == bg] = fill_color
+    return out
