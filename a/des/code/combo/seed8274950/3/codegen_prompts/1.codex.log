+    left = bool(np.all(cols < center_c))
+    right = bool(np.all(cols > center_c))
+    assert top ^ bottom, "sprite rows must stay within one half"
+    assert left ^ right, "sprite cols must stay within one half"
+    if top and left:
+        return "tl"
+    if top and right:
+        return "tr"
+    if bottom and left:
+        return "bl"
+    return "br"
+
+
