+        assert deg in (1, 2), "component must be a simple path"
+        degrees[(r, c)] = deg
+
+    endpoints = [pt for pt, deg in degrees.items() if deg == 1]
+    assert len(endpoints) == 2, "path must have exactly two endpoints"
