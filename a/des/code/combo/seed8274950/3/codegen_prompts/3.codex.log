+        p1, p2 = _diag_markers(box, orientation)
+        path = _line_cells(p1, p2)
+        if any(_in_box(cell, anchor_box) for cell in path):
+            continue
+
+        return {"box": box, "p1": p1, "p2": p2, "area": area}
+
+    return None
