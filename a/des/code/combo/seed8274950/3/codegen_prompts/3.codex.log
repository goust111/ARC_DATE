+        w = rng.randint(min_w, max_w)
+        area = h * w
+        if area in used_areas:
+            continue
+
+        r0_lo = sr0 + 2
+        r0_hi = sr1 - h - 1
+        c0_lo = sc0 + 2
+        c0_hi = sc1 - w - 1
+        if r0_lo > r0_hi or c0_lo > c0_hi:
