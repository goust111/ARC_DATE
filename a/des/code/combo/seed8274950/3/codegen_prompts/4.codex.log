+            out[r0:r1, c0:c1] = int(legend_colors[board_counts[row_idx][col_idx] - 1])
+    legend_r0, legend_r1 = row_cells[-1]
+    for c0, c1 in col_cells:
+        out[legend_r0:legend_r1, c0:c1] = background
+    return out
+
+
