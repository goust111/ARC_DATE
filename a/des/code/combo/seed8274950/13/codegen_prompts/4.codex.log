from __future__ import annotations
import random
from collections import deque
import hashlib
import numpy as np

OUTPUT_SIDE_MAX = 28
MAX_GEN_ATTEMPTS = 300


def get_bg(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def fill_holes(mask: np.ndarray) -> np.ndarray:
    padded = np.pad(mask.astype(bool), 1, constant_values=False)
    seen = np.zeros_like(padded, dtype=bool)
    q = deque([(0, 0)])
    seen[0, 0] = True
    while q:
        r, c = q.popleft()
        for nr, nc in neighbors4(r, c):
            if 0 <= nr < padded.shape[0] and 0 <= nc < padded.shape[1]:
                if padded[nr, nc] or seen[nr, nc]:
                    continue
                seen[nr, nc] = True
                q.append((nr, nc))
    filled = padded.copy()
    filled[(~padded) & (~seen)] = True
    return filled[1:-1, 1:-1]


def count_outline_corners(mask: np.ndarray) -> int:
    solid = fill_holes(mask)
    padded = np.pad(solid.astype(np.uint8), 1, constant_values=0)
    corners = 0
    for r in range(padded.shape[0] - 1):
        for c in range(padded.shape[1] - 1):
            s = int(padded[r : r + 2, c : c + 2].sum())
            if s == 1 or s == 3:
                corners += 1
    return corners


def scale_for_corners(corners: int) -> int:
    if corners == 4:
        return 1
    if corners >= 12:
        return 3
    return 2


def find_objects(grid: np.ndarray, bg: int):
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    objects = []
    for color in np.unique(g):
        color = int(color)
        if color == bg:
            continue
        mask = g == color
        seen = np.zeros_like(mask, dtype=bool)
        for r in range(h):
            for c in range(w):
                if not mask[r, c] or seen[r, c]:
                    continue
                q = [(r, c)]
                seen[r, c] = True
                cells = []
                while q:
                    cr, cc = q.pop()
                    cells.append((cr, cc))
                    for nr, nc in neighbors4(cr, cc):
                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                            seen[nr, nc] = True
                            q.append((nr, nc))
                rows = [rr for rr, _ in cells]
                cols = [cc for _, cc in cells]
                r0, r1 = min(rows), max(rows)
                c0, c1 = min(cols), max(cols)
                sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
                for rr, cc in cells:
                    sprite[rr - r0, cc - c0] = color
                objects.append({
                    'color': color,
                    'bbox': (r0, c0, r1, c1),
                    'sprite': sprite,
                    'mask': sprite == color,
                })
    objects.sort(key=lambda obj: (obj['bbox'][1], obj['bbox'][0]))
    return objects


def paste(out: np.ndarray, sprite: np.ndarray, top: int, left: int, bg: int) -> None:
    h, w = sprite.shape
    window = out[top : top + h, left : left + w]
    mask = sprite "'!= bg
    window[mask] = sprite[mask]


def main(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    objects = find_objects(g, bg)
    assert objects
    scaled = []
    for obj in objects:
        corners = count_outline_corners(obj['"'mask'])
        factor = scale_for_corners(corners)
        sprite = np.repeat(np.repeat(obj['sprite'], factor, axis=0), factor, axis=1)
        scaled.append(sprite)
    out_h = max(sprite.shape[0] for sprite in scaled)
    out_w = sum(sprite.shape[1] for sprite in scaled) + len(scaled) - 1
    out = np.full((out_h, out_w), bg, dtype=int)
    c = 0
    for sprite in scaled:
        top = out_h - sprite.shape[0]
        paste(out, sprite, top, c, bg)
        c += sprite.shape[1] + 1
    return out


def _inflate(mask: np.ndarray, factor: int) -> np.ndarray:
    if factor == 1:
        return mask.copy()
    block = np.ones((factor, factor), dtype=np.uint8)
    return np.kron(mask.astype(np.uint8), block).astype(bool)


def _random_orient(mask: np.ndarray, rng: random.Random) -> np.ndarray:
    out = np.rot90(mask, rng.randrange(4))
    if rng.random() < 0.5:
        out = np.fliplr(out)
    return out.copy()


def _make_rectangle(rng: random.Random) -> np.ndarray:
    return np.ones((rng.randint(1, 4), rng.randint(1, 5)), dtype=bool)


def _make_t(rng: random.Random) -> np.ndarray:
    t = rng.randint(1, 2)
    left = rng.randint(1, 2)
    right = rng.randint(1, 2)
    down = rng.randint(1, 3)
    h = t + down
    w = left + t + right
    mask = np.zeros((h, w), dtype=bool)
    mask[:t, :] = True
    mask[:, left : left + t] = True
    return mask


def _make_u(rng: random.Random) -> np.ndarray:
    t = rng.randint(1, 2)
    gap = rng.randint(1, 2)
    rise = rng.randint(1, 3)
    h = rise + t
    w = 2 * t + gap
    mask = np.zeros((h, w), dtype=bool)
    mask[:, :t] = True
    mask[:, -t:] = True
    mask[-t:, :] = True
    return mask


def _make_plus(rng: random.Random) -> np.ndarray:
    t = rng.randint(1, 2)
    up = rng.randint(1, 2)
    down = rng.randint(1, 2)
    left = rng.randint(1, 2)
    right = rng.randint(1, 2)
    h = up + t + down
    w = left + t + right
    mask = np.zeros((h, w), dtype=bool)
    mask[:, left : left + t] = True
    mask[up : up + t, :] = True
    return mask


def _make_h(rng: random.Random) -> np.ndarray:
    t = rng.randint(1, 2)
    gap = rng.randint(1, 2)
    top = rng.randint(1, 2)
    bottom = rng.randint(1, 2)
    h = top + t + bottom
    w = 2 * t + gap
    mask = np.zeros((h, w), dtype=bool)
    mask[:, :t] = True
    mask[:, -t:] = True
    mask[top : top + t, :] = True
    return mask


def _sample_shape(category: int, rng: random.Random):
    builders = {
        0: [_make_rectangle],
        1: [_make_t, _make_u],
        2: [_make_plus, _make_h],
    }[category]
    for _ in range(40):
        mask = builders[rng.randrange(len(builders))](rng)
        if rng.random() < 0.45:
            mask = _inflate(mask, 2)
        mask = _random_orient(mask, rng)
        corners = count_outline_corners(mask)
        scale = scale_for_corners(corners)
        if category == 0 and scale == 1:
            return mask, corners
        if category == 1 and scale == 2 and 4 < corners < 12:
            return mask, corners
        if category == 2 and scale == 3 and corners >= 12:
            return mask, corners
    return None


def _choose_categories(n: int, rng: random.Random):
    base = [0, 1, 2]
    rng.shuffle(base)
    cats = base[: min(n, 3)]
    while len(cats) < n:
        cats.append(rng.randrange(3))
    rng.shuffle(cats)
    return cats


def _gen_attempt(rng: random.Random):
    bg = rng.randrange(10)
    n = rng.choice([2, 3])
    colors = rng.sample([c for c in range(10) if c "'!= bg], n)
    categories = _choose_categories(n, rng)
    objects = []
    for color, category in zip(colors, categories):
        sampled = _sample_shape(category, rng)
        if sampled is None:
            return None
        mask, corners = sampled
        objects.append((mask, color, corners))
    out_h = max(mask.shape[0] * scale_for_corners(corners) for mask, _, corners in objects)
    out_w = sum(mask.shape[1] * scale_for_corners(corners) for mask, _, corners in objects) + (n - 1)
    if out_h > OUTPUT_SIDE_MAX or out_w > OUTPUT_SIDE_MAX:
        return None
    widths = [mask.shape[1] for mask, _, _ in objects]
    heights = [mask.shape[0] for mask, _, _ in objects]
    gaps = [rng.randint(2, 4) for _ in range(n - 1)]
    left_margin = rng.randint(1, 3)
    right_margin = rng.randint(1, 4)
    grid_w = left_margin + sum(widths) + sum(gaps) + right_margin
    grid_h = max(heights) + rng.randint(2, 7)
    if grid_w > 28 or grid_h > 28:
        return None
    grid = np.full((grid_h, grid_w), bg, dtype=int)
    col = left_margin
    for i, (mask, color, _corners) in enumerate(objects):
        h, w = mask.shape
        top = rng.randint(1, grid_h - h - 1)
        grid[top : top + h, col : col + w][mask] = color
        if i < n - 1:
            col += w + gaps[i]
    if get_bg(grid) != bg:
        return None
    found = find_objects(grid, bg)
    if len(found) != n:
        return None
    out = main(grid)
    if out.shape[0] > OUTPUT_SIDE_MAX or out.shape[1] > OUTPUT_SIDE_MAX:
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GEN_ATTEMPTS):
        grid = _gen_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError('"'failed')

sigs=set()
for i in range(100):
    inp = generate_input()
    out = main(inp)
    sigs.add(hashlib.md5(inp.tobytes()+str(inp.shape).encode()).hexdigest())
    if i < 10:
        print(inp.shape, out.shape, [count_outline_corners(obj['mask']) for obj in find_objects(inp, get_bg(inp))])
print('variants', len(sigs))
