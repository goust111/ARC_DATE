# 8 straight + 12 L-bend combos, all verified to partition the 5x5 grid.
_STRAIGHT_CONFIGS = [
    ((0, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row
    ((4, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row
