+        return None
+
+    i, j = room_a
+    wall_col = col_walls[j + 1]
+    rows = list(range(rooms[room_a][0], rooms[room_a][2] + 1))
+    random.shuffle(rows)
+    for row in rows:
+        if row not in used_rows[room_a] and row not in used_rows[room_b]:
+            return row, wall_col
+    return None
+
+
+def _door_site_horizontal(
+    room_a: tuple[int, int],
+    room_b: tuple[int, int],
