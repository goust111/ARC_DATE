+
+def _sample_counts(mode: str) -> tuple[int, int]:
+    if mode == "vertical_only":
+        options = [(1, 2), (1, 3), (2, 2), (2, 3), (3, 2)]
+    elif mode == "horizontal_only":
+        options = [(2, 1), (3, 1), (2, 2), (2, 3), (3, 2)]
+    else:
