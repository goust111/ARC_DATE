    lab8, n8 = label_mask(g == Color.GREY, connectivity=8)
    assert n8 >= 1

    for k in range(1, n8 + 1):
        mask = lab8 == k
        if _is_target_region(mask):
            out[mask] = Color.TEAL

    return out

