+            lr, lc = label_cells[0]
+            labeled_regions.append((comp, (int(lr), int(lc)), int(g[lr, lc])))
+
+        if ok and len(labeled_regions) >= 2:
+            candidates.append((int(wall_color), int(bg_color), labeled_regions))
