        lr, lc = label_cell
        for r, c in comp:
            if int(g[r, c]) == bg_color:
                out[r, c] = label_color
                changed += 1
        out[lr, lc] = bg_color

    assert changed > 0, "expected at least one background cell to be filled"
    return out


def _sample_lengths(total: int, parts: int, min_size: int) -> list[int] | None:
    slack = total - parts * min_size
    if slack < 0:
