    h, w = grid.shape
    row_lengths = _sample_lengths(h - 2 - horizontal_cuts, horizontal_cuts + 1, MIN_ROOM_SIZE)
    col_lengths = _sample_lengths(w - 2 - vertical_cuts, vertical_cuts + 1, MIN_ROOM_SIZE)
    if row_lengths is None or col_lengths is None:
