    return intervals


def _make_canvas(h: int, w: int, bg_color: int, wall_color: int) -> np.ndarray:
    grid = np.full((h, w), bg_color, dtype=int)
    grid[0, :] = wall_color
    grid[-1, :] = wall_color
    grid[:, 0] = wall_color
    grid[:, -1] = wall_color
    return grid


def _grid_partition(
    grid: np.ndarray,
    wall_color: int,
    horizontal_cuts: int,
    vertical_cuts: int,
