+
+def _render_output(bg: int, ordered_objects: list[dict[str, object]]) -> np.ndarray:
+    n = len(ordered_objects)
+    size = 2 * n - 1
+    out = np.full((size, size), bg, dtype=int)
+    for layer, obj in enumerate(ordered_objects):
+        color = int(obj["color"])
