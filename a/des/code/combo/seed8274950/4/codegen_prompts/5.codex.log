+
+def _mask_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    q: deque[tuple[int, int]] = deque([start])
+    seen = {start}
