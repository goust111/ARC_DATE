+
+def _boundary_pixels(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    total = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                    total += 1
+                    break
+    return total
