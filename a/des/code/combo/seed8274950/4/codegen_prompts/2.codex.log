+    mask[r0 : r1 + 1, c0 : c1 + 1] = False
+    values = [int(v) for v in grid[mask].reshape(-1) if int(v) != bg]
+    assert values
+    unique, counts = np.unique(np.array(values, dtype=int), return_counts=True)
+    return int(unique[np.argmax(counts)])
