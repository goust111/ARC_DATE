    return _solve(grid)


def _all_keys(marker_colors: list[int]) -> tuple[list[frozenset[int]], list[frozenset[int]]]:
    singles = [frozenset((color,)) for color in marker_colors]
    pairs = [frozenset(pair) for pair in combinations(marker_colors, 2)]
