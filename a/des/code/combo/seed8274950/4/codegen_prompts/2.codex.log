+            raise RuntimeError("failed to create distinct patterns")
+    return mapping
+
+
+def _legend_patch(
+    bg: int,
+    sep: int,
+    legend_keys: list[frozenset[int]],
+    patterns: dict[frozenset[int], np.ndarray],
+) -> np.ndarray:
+    height = 1 + 4 * len(legend_keys)
+    patch = np.full((height, LEGEND_WIDTH), bg, dtype=int)
+    patch[::4, :] = sep
+    patch[:, 0] = sep
+    patch[:, 4] = sep
+    patch[:, 8] = sep
