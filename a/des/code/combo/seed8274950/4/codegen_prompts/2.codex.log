+    bases = rng.sample(list(PATTERN_BASES), len(legend_keys))
+    mapping: dict[frozenset[int], np.ndarray] = {}
+    used: set[bytes] = set()
+    for key, base in zip(legend_keys, bases):
+        for _ in range(50):
+            pattern = _colorize_pattern(base, rng, pattern_colors)
+            blob = pattern.tobytes()
+            if blob not in used:
+                used.add(blob)
+                mapping[key] = pattern
+                break
