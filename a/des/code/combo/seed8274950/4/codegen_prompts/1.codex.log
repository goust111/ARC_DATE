+def _marker_direction(grid: np.ndarray, coords: np.ndarray) -> tuple[int, int]:
+    colors = sorted({int(grid[r, c]) for r, c in coords.tolist()})
+    directions: list[tuple[int, int]] = []
+    for color in colors:
