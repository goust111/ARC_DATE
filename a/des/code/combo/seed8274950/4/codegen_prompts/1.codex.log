+        for (r, c), value in zip(shifted.tolist(), values.tolist(), strict=False):
+            rr, cc = int(r), int(c)
+            assert 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1]
+            assert (rr, cc) not in occupied, "moved objects must not overlap obstacles or each other"
+            occupied.add((rr, cc))
+            out[rr, cc] = int(value)
