+                return None
+            row_options = range(1, height - ph + 1)
+            col_options = range(0, width - pw + 1)
+        elif dr > 0:
+            if height - ph - 1 < 0:
+                return None
+            row_options = range(0, height - ph)
+            col_options = range(0, width - pw + 1)
+        elif dc < 0:
+            if width - pw < 1:
