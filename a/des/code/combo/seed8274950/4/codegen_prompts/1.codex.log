+def _leading_edge(coords: np.ndarray, direction: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = direction
+    lanes: dict[int, tuple[int, int]] = {}
+    for r, c in coords.tolist():
+        rr = int(r)
+        cc = int(c)
