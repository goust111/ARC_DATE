+            final_top, final_left, dedicated_obstacle = placement
+            future_obstacles = set(obstacle_cells)
+            if dedicated_obstacle is not None:
+                future_obstacles.add(dedicated_obstacle)
+
+            shifts = _valid_shifts(
+                patch,
+                final_top,
+                final_left,
+                directions[idx],
+                height,
