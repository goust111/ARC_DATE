def _squares(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int]]:
    out: list[tuple[int, int, int, int, int]] = []
    for comp in find_components(
        g,
        bg=bg,
        colors=[Color.GREY, Color.PINK],
        connectivity=4,
    ):
        color = int(comp["color"])
        r0, c0, r1, c1 = comp["bbox"]
