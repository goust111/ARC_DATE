+def _make_patch(
+    rng: random.Random,
+    direction: tuple[int, int],
+    body_color: int,
+    marker_color: int,
+) -> np.ndarray:
+    cells = _random_shape(rng)
+    block_r, block_c = rng.choice(_full_blocks(cells))
+    h = max(r for r, _c in cells) + 1
+    w = max(c for _r, c in cells) + 1
