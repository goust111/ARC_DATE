_GEN_BG = 8
_GEN_FG = 1
_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Canvas and placement bounds.
_GEN_ROWS_RANGE = (13, 16)
_GEN_COLS_RANGE = (15, 17)
_GEN_MARGIN = 1

