+
+def _too_close(coords: set[tuple[int, int]], occupied: set[tuple[int, int]], margin: int = 1) -> bool:
+    for r, c in coords:
+        for rr in range(r - margin, r + margin + 1):
+            for cc in range(c - margin, c + margin + 1):
+                if (rr, cc) in occupied:
