+
+
+def _generate_case(rng: random.Random) -> np.ndarray | None:
+    height = rng.randint(10, 18)
+    width = rng.randint(10, 18)
+    bg = rng.choice([0, 1, 2, 3, 4, 6, 7, 8, 9])
+    object_count = rng.randint(2, 4)
+
