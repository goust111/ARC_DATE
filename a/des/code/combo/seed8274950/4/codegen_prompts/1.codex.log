+    assert gaps
+    steps = min(gaps)
+    for r, c in front:
+        for delta in range(1, steps + 1):
+            rr = r + dr * delta
+            cc = c + dc * delta
+            assert 0 <= rr < h and 0 <= cc < w
+            assert int(grid[rr, cc]) == bg, "movement lanes must be background for the actual travel distance"
