+
+def _steps_to_blocker(
+    grid: np.ndarray,
+    coords: np.ndarray,
+    direction: tuple[int, int],
+    bg: int,
+) -> int:
+    h, w = grid.shape
+    dr, dc = direction
+    front = _leading_edge(coords, direction)
+    gaps: list[int] = []
+    for r, c in front:
+        gap = 0
+        rr, cc = r + dr, c + dc
+        while 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) != OBSTACLE_COLOR:
+            gap += 1
+            rr += dr
+            cc += dc
+        gaps.append(gap)
