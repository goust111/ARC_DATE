+
+
+def _random_shape(rng: random.Random) -> set[tuple[int, int]]:
+    for _ in range(100):
+        area = rng.randint(7, 12)
+        cells = {(0, 0), (0, 1), (1, 0), (1, 1)}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    nxt = (r + dr, c + dc)
+                    if nxt not in cells:
+                        frontier.append(nxt)
