    r: int, c: int, square: tuple[int, int, int, int, int]
) -> str | None:
    r0, c0, r1, c1, _color = square
    if r0 <= r <= r1:
        if c == c0 - 1:
            return "left"
        if c == c1 + 1:
            return "right"
    if c0 <= c <= c1:
        if r == r0 - 1:
            return "above"
        if r == r1 + 1:
            return "below"
    return None


