+
+
+def _patch_positions(patch: np.ndarray, top: int, left: int) -> list[tuple[int, int, int]]:
+    out: list[tuple[int, int, int]] = []
+    for r, c in np.argwhere(patch != EMPTY):
+        out.append((top + int(r), left + int(c), int(patch[r, c])))
+    return out
