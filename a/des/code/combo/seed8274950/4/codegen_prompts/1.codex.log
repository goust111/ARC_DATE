+def _valid_shifts(
+    patch: np.ndarray,
+    final_top: int,
+    final_left: int,
+    direction: tuple[int, int],
+    height: int,
+    width: int,
+    obstacle_cells: set[tuple[int, int]],
+    input_occ: set[tuple[int, int]],
+    clear_reserved: set[tuple[int, int]],
