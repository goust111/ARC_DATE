+        if len(pts) != 3:
+            continue
+        rs = [r for r, _c in pts]
+        cs = [c for _r, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        if r1 - r0 != 1 or c1 - c0 != 1:
+            continue
+        corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+        marker = set(pts)
+        if marker - corners:
+            continue
+        missing = corners - marker
+        if len(missing) != 1:
