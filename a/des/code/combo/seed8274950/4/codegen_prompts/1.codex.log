+def _balanced_blocker_types(rng: random.Random, count: int) -> list[str]:
+    types = ["boundary"] * (count // 2) + ["obstacle"] * (count - count // 2)
+    if "boundary" not in types:
+        types[0] = "boundary"
+    if "obstacle" not in types:
+        types[-1] = "obstacle"
