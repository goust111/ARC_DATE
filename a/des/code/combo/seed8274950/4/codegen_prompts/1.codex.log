+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _marker_direction(grid: np.ndarray, coords: np.ndarray) -> tuple[int, int]:
+    colors = sorted({int(grid[r, c]) for r, c in coords.tolist()})
+    directions: list[tuple[int, int]] = []
+    for color in colors:
+        pts = [(int(r), int(c)) for r, c in coords.tolist() if int(grid[r, c]) == color]
+        if len(pts) != 3:
+            continue
+        rs = [r for r, _c in pts]
+        cs = [c for _r, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        if r1 - r0 != 1 or c1 - c0 != 1:
+            continue
+        corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+        marker = set(pts)
+        if marker - corners:
+            continue
+        missing = corners - marker
+        if len(missing) != 1:
+            continue
+        mr, mc = next(iter(missing))
+        directions.append(MISSING_TO_DIR[(mr - r0, mc - c0)])
