+    if np.array_equal(grid, _render_swapped(rects, grid_h, grid_w, bg)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        mode = random.choice(MODES)
