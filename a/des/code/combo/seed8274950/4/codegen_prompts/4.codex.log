+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_RETRIES = 600
+PLACEMENT_RETRIES = 250
+GRID_SIDE_MIN = 11
+GRID_SIDE_MAX = 20
+RECT_SIDE_SHORT_MAX = 4
