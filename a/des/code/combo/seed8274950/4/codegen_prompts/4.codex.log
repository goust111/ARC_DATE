+    ordered = sorted(rects, key=lambda rect: (-(rect[2] * rect[3]), rect[0], rect[1], rect[4]))
+    for rect in ordered:
+        r0, c0, r1, c1, _clipped = _swapped_bbox(rect, grid_h, grid_w)
