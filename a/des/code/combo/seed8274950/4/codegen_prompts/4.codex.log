+    used_areas: set[int],
+) -> tuple[int, int, int, int, int] | None:
+    for _ in range(PLACEMENT_RETRIES):
+        orientation = random.choice(("wide", "tall"))
+        dims = _sample_oriented_dims(grid_h, grid_w, orientation)
