+        r1 = random.randint(0, r1_max)
+        c1_max = grid_w - w1
+        if c1_max < 0:
+            continue
+        c1 = random.randint(0, c1_max)
+
+        r2_min = r1 + h1 + INPUT_GAP
+        r2_max = min(grid_h - h2, r1 + w1 - 1)
+        if r2_min > r2_max:
+            continue
+        r2 = random.randint(r2_min, r2_max)
+
+        c2_min = c1
+        c2_max = min(grid_w - h2, c1 + h1 - 1)
+        if c2_min > c2_max:
