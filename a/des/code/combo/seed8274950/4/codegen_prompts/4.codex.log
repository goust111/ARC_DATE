+    if not any(height > width for _r0, _c0, height, width, _color in rects):
+        return False
+    if not any(height < width for _r0, _c0, height, width, _color in rects):
+        return False
+
+    bg_cells = grid_h * grid_w - sum(areas)
+    if bg_cells <= max(areas):
+        return False
+    return True
