+
+    for color, coords in _find_components(grid, bg):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        r0, r1 = int(rows.min()), int(rows.max())
+        c0, c1 = int(cols.min()), int(cols.max())
+        height = int(r1 - r0 + 1)
+        width = int(c1 - c0 + 1)
