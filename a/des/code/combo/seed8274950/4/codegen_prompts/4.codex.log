+def _find_components(grid: np.ndarray, bg: int) -> list[tuple[int, np.ndarray]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[tuple[int, np.ndarray]] = []
