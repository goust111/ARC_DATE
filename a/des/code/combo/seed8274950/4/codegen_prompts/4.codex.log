+    if r0 < 0 or c0 < 0 or r0 + height > grid_h or c0 + width > grid_w:
+        return False
+    candidate_box = _input_box(rect)
+    for other in rects:
+        if _boxes_too_close(candidate_box, _input_box(other), INPUT_GAP):
