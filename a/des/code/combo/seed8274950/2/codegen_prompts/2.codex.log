+    if not row_is_sep.any() or not col_is_sep.any():
+        return None
+    if row_is_sep.all() or col_is_sep.all():
+        return None
+
+    row_spans = _spans_from_mask(~row_is_sep)
+    col_spans = _spans_from_mask(~col_is_sep)
+    if len(col_spans) < 3:
