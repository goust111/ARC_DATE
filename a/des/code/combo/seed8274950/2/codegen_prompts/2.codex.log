+def _spans_from_mask(mask: np.ndarray) -> list[tuple[int, int]]:
+    idx = np.flatnonzero(mask)
+    assert idx.size > 0
+    spans: list[tuple[int, int]] = []
+    start = prev = int(idx[0])
+    for value in idx[1:]:
+        value = int(value)
+        if value == prev + 1:
+            prev = value
+            continue
+        spans.append((start, prev))
+        start = prev = value
