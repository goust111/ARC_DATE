+    row_sizes = {r1 - r0 + 1 for r0, r1 in row_spans}
+    col_sizes = {c1 - c0 + 1 for c0, c1 in col_spans}
+    if len(row_sizes) != 1 or len(col_sizes) != 1:
+        return None
+    return row_spans, col_spans
