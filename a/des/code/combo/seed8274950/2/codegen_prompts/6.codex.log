+from __future__ import annotations
+
+import numpy as np
+
+
+GREY = 5
+GEN_ATTEMPTS = 400
+PAIR_TRIES = 200
+DISTRACTOR_TRIES = 80
+SIZE_MIN = 12
+SIZE_MAX = 21
+GAP_MIN = 3
+GAP_MAX = 9
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
