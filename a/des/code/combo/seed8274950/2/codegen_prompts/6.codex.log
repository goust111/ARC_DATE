+            cell_set = set(cells)
+            if cell_set & path_cells or cell_set & occupied:
+                continue
+            d_box = _box(cell_set, h, w, margin=1)
+            if any(_boxes_overlap(d_box, b) for b in boxes):
+                continue
+            color = _sample_colors(rng, 1, {bg, GREY})[0]
+            distractors.append((cells, color))
+            occupied |= cell_set
+            boxes.append(d_box)
+            placed = True
+            break
+        if not placed:
