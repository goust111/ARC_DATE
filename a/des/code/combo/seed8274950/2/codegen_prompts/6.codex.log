+    bg = _bg_color(g)
+    markers = _marker_cells(g, bg)
+    marker_set = set(markers)
+    out = g.copy()
+
+    for r, c0, c1 in _horizontal_pairs(markers):
+        path = [(r, c) for c in range(c0 + 1, c1)]
+        color = _path_color(g, bg, marker_set, path)
+        if path:
