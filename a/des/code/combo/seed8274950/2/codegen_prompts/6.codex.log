+def _box(cells: set[tuple[int, int]], h: int, w: int, margin: int = 1) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    return (
+        max(0, min(rs) - margin),
+        max(0, min(cs) - margin),
+        min(h - 1, max(rs) + margin),
+        min(w - 1, max(cs) + margin),
+    )
