+        marker_colors = _sample_colors(rng, 2, {bg, GREY, line_color} if with_region else {bg, GREY})
+        markers = [(r0, c), (r1, c)]
+        cells = set(markers) | set(path) | set(region_cells)
+        pair_box = _box(cells, h, w, margin=1)
