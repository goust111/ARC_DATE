+        else:
+            c = int(pair["markers"][0][1])
+            r0 = int(pair["markers"][0][0])
+            r1 = int(pair["markers"][1][0])
+            for idx, r in enumerate(range(r0 + 1, r1)):
+                if idx % 2 == 0:
+                    out[r, c] = line_color
