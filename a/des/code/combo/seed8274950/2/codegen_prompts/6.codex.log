+        path = [(r, c) for r in range(r0 + 1, r1)]
+        region_cells = []
+        line_color = GREY
+        if with_region:
+            patch = _vertical_region_patch(rng, w, c, r0, r1)
+            if patch is None:
+                continue
+            region_cells = patch
+            line_color = _sample_colors(rng, 1, {bg, GREY})[0]
