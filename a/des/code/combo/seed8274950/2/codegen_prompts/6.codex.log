+
+
+def _sample_distractor_shape(
+    rng: np.random.Generator, h: int, w: int
+) -> list[tuple[int, int]] | None:
+    kind = str(rng.choice(["h2", "v2", "b22"]))
+    if kind == "h2":
+        if w < 2:
+            return None
+        r = int(rng.integers(h))
+        c = int(rng.integers(w - 1))
