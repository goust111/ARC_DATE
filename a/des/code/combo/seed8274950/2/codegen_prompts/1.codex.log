+        main_color, main_count = colors.most_common(1)[0]
+        marker_cells = [(r, c) for r, c in comp if int(grid[r, c]) != main_color]
+        valid = (
+            len(colors) == 2
+            and len(marker_cells) == 1
+            and main_count >= 3
+            and min(colors.values()) == 1
+        )
+        if not valid:
+            if strict:
+                raise ValueError("invalid object marker structure")
