+        if len(gaps) != 1:
+            if strict:
+                raise ValueError("expected exactly one bbox gap")
+            continue
+
+        side, start, end = gaps[0]
+        objects.append(
+            {
+                "cells": comp,
+                "main_color": int(main_color),
+                "marker_color": int(grid[marker_cells[0]]),
+                "marker_cell": marker_cells[0],
+                "bbox": (r0, r1, c0, c1),
+                "side": side,
+                "gap_start": int(start),
+                "gap_end": int(end),
+                "gap_width": int(end - start + 1),
