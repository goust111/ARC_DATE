+def _place_blocked(
+    spec: dict, blocker: dict, placed: list[dict], grid_h: int, grid_w: int, bg: int, rng: random.Random
+) -> bool:
+    for r0, c0 in _candidate_positions_for_blocked(spec, blocker, grid_h, grid_w, rng):
+        spec["r0"], spec["c0"] = r0, c0
