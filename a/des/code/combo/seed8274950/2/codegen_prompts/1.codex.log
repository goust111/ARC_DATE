+    for obj in _extract_objects(g, strict=True):
+        for segment in _beam_segments(obj, g.shape):
+            if any(occupied[r, c] for r, c in segment):
+                break
+            for r, c in segment:
+                out[r, c] = obj["marker_color"]
+
+    return out
