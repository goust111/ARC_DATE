+
+def _bbox(spec: dict) -> tuple[int, int, int, int]:
+    r0, c0 = spec["r0"], spec["c0"]
+    return (r0, r0 + spec["h"] - 1, c0, c0 + spec["w"] - 1)
+
+
+def _boxes_separated(spec: dict, placed: list[dict], pad: int = 1) -> bool:
