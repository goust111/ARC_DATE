+            for _ in range(PLACE_TRIES):
+                beam_len = rng.randint(MIN_BLOCKED_LEN, max(MIN_BLOCKED_LEN, 5))
+                c0 = bc1 + beam_len + 1
+                r0 = rng.randint(rmin, rmax)
+                if 0 <= c0 <= grid_w - w:
+                    out.append((r0, c0))
+    else:
+        rmin = max(0, br0 - (gap_start + gap_width - 1))
+        rmax = min(grid_h - h, br1 - gap_start)
+        if rmin <= rmax:
