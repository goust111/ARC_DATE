+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit a marker-colored band from each object's unique bbox-side gap.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    out = g.copy()
+    occupied = g != bg
