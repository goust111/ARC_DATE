+def _beam_segments(obj: dict, shape: tuple[int, int]):
+    h, w = shape
+    r0, r1, c0, c1 = obj["bbox"]
+    start, end = obj["gap_start"], obj["gap_end"]
+    side = obj["side"]
+    if side == "top":
