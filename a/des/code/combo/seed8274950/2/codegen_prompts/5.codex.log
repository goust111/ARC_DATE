+        box = _bbox(visible)
+        assert box is not None, "each foreground color must remain visible"
+        mask = _frame_mask(g.shape, box)
+        assert np.all(mask[visible]), "visible pixels must lie on the reconstructed frame border"
+        frame_masks[color] = mask
