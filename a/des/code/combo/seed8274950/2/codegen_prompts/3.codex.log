+
+def _mark_blocked(blocked: np.ndarray, shape: np.ndarray, r0: int, c0: int) -> None:
+    h, w = blocked.shape
+    for dr, dc in np.argwhere(shape):
+        rr = r0 + int(dr)
+        cc = c0 + int(dc)
+        for nr in range(max(0, rr - 1), min(h, rr + 2)):
+            for nc in range(max(0, cc - 1), min(w, cc + 2)):
