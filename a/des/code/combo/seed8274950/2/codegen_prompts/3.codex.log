+    legend_mask = np.zeros((h, w), dtype=bool)
+    legend_mask[legend_rows, 0] = True
+    if not np.any((grid != out) & ~legend_mask):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
