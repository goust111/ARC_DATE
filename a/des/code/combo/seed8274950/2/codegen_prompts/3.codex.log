+
+def _can_place(blocked: np.ndarray, shape: np.ndarray, r0: int, c0: int) -> bool:
+    for dr, dc in np.argwhere(shape):
+        if blocked[r0 + int(dr), c0 + int(dc)]:
+            return False
+    return True
