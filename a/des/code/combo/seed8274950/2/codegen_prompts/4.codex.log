+    col_candidates: list[tuple[int, int]] = []
+    for c in range(w):
+        values, counts = np.unique(grid[:, c], return_counts=True)
+        idx = int(np.argmax(counts))
+        color = int(values[idx])
+        count = int(counts[idx])
