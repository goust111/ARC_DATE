    return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1


def _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return (
        a[2] + RING_GAP < b[0]
        or b[2] + RING_GAP < a[0]
        or a[3] + RING_GAP < b[1]
        or b[3] + RING_GAP < a[1]
    )


