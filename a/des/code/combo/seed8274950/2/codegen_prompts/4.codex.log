+    matches: list[tuple[int, int, int, int, int]] = []
+    for r, row_color in row_candidates:
+        row_mismatch = [int(c) for c in np.flatnonzero(grid[r, :] != row_color)]
+        for c, col_color in col_candidates:
+            if row_color == col_color:
