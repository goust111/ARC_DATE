+    bg: int,
+    wall: int,
+    marker_colors: list[int],
+) -> np.ndarray:
+    grid = np.full((2 * rows + 1, 2 * cols + 1), wall, dtype=int)
+    marker_idx = 0
+    marker_positions: set[tuple[int, int]] = set()
+
+    for mode, path in paths:
+        for cell in path:
+            cr, cc = _center_pixel(cell)
+            grid[cr, cc] = bg
+        for a, b in zip(path, path[1:]):
