+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return None
+    if not np.array_equal(out[grid == wall], grid[grid == wall]):
+        return None
+    for r, c in marker_positions:
+        if int(out[r, c]) != int(grid[r, c]):
+            return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
