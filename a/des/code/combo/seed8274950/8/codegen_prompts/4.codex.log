+def _bg_and_markers(grid: np.ndarray, wall: int):
+    h, w = grid.shape
+    edge_set = set(_edge_positions(h, w))
+    edge_candidates = [(r, c) for r, c in edge_set if int(grid[r, c]) != wall]
+
+    interior_colors = [
+        int(grid[r, c])
+        for r in range(h)
+        for c in range(w)
+        if int(grid[r, c]) != wall and (r, c) not in edge_set
+    ]
