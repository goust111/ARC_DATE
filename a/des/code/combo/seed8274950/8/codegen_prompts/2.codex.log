+                        "top": top,
+                        "left": left,
+                        "frame_color": frame_color,
+                        "center": (top + 1, left + 1),
+                    }
+                )
+    return receivers
+
+
+def _find_transmitters(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    transmitters: list[dict[str, object]] = []
+    for top in range(h - 2):
+        for left in range(w - 2):
