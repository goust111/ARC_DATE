+    (2, 0), (2, 1), (2, 2),
+)
+_MARKER_TO_DIR = {
+    (0, 1): (1, 0),
+    (2, 1): (-1, 0),
+    (1, 0): (0, 1),
+    (1, 2): (0, -1),
+}
+_DIR_TO_MARKER = {direction: marker for marker, direction in _MARKER_TO_DIR.items()}
