+_RECEIVER_COLOR = 5  # ARC grey
+_RING = (
+    (0, 0), (0, 1), (0, 2),
+    (1, 0),         (1, 2),
+    (2, 0), (2, 1), (2, 2),
+)
+_MARKER_TO_DIR = {
+    (0, 1): (1, 0),
+    (2, 1): (-1, 0),
+    (1, 0): (0, 1),
+    (1, 2): (0, -1),
