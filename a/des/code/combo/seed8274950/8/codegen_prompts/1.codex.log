+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r
+            min_c = max_c = c
+
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                min_r = min(min_r, cr)
+                max_r = max(max_r, cr)
+                min_c = min(min_c, cc)
+                max_c = max(max_c, cc)
+
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min_r, min_c, max_r, max_c),
+                    "area": len(coords),
+                }
+            )
+
+    return comps
+
+
+def _center2(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 + r1, c0 + c1
+
+
+def _center_dist2(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar, ac = _center2(a)
+    br, bc = _center2(b)
+    return (ar - br) ** 2 + (ac - bc) ** 2
