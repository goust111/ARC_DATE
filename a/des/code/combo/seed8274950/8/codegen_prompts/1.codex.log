+            min_r = max_r = r
+            min_c = max_c = c
+
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                min_r = min(min_r, cr)
+                max_r = max(max_r, cr)
+                min_c = min(min_c, cc)
+                max_c = max(max_c, cc)
