+
+
+def _coords_fit_forbidden(coords: list[tuple[int, int]], forbidden: np.ndarray) -> bool:
+    return all(not bool(forbidden[r, c]) for r, c in coords)
+
+
+def _mark_forbidden(forbidden: np.ndarray, coords: list[tuple[int, int]]):
+    h, w = forbidden.shape
+    for r, c in coords:
