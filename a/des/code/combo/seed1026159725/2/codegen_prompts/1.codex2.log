+import math
+from collections import Counter, deque
+
+import numpy as np
+
+
+CORNER_ORDER = ("TL", "TR", "BL", "BR")
+CORNER_INDEX = {name: idx for idx, name in enumerate(CORNER_ORDER)}
+CORNER_SIGNS = {
+    "TL": (-1, -1),
+    "TR": (-1, 1),
+    "BL": (1, -1),
+    "BR": (1, 1),
+}
+SINGLE_MOVES = {
+    "TL": (1, 1),
+    "TR": (1, -1),
+    "BL": (-1, 1),
+    "BR": (-1, -1),
+}
+DOUBLE_MOVES = {
+    frozenset(("TL", "TR")): (2, 0),
+    frozenset(("BL", "BR")): (-2, 0),
+    frozenset(("TL", "BL")): (0, 2),
+    frozenset(("TR", "BR")): (0, -2),
+}
+TRIPLE_PATTERNS = [
+    ("TR", "BL", "BR"),
+    ("TL", "BL", "BR"),
+    ("TL", "TR", "BR"),
+    ("TL", "TR", "BL"),
+]
+BRANCH_PATTERNS = {
+    1: [("TL",), ("TR",), ("BL",), ("BR",)],
+    2: [("TL", "TR"), ("BL", "BR"), ("TL", "BL"), ("TR", "BR")],
+    3: TRIPLE_PATTERNS,
+}
+MAX_ATTEMPTS = 400
+MAX_SIZE = 30
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _corner_positions(h: int, w: int) -> dict[str, tuple[int, int]]:
+    return {
+        "TL": (0, 0),
+        "TR": (0, w - 1),
+        "BL": (h - 1, 0),
+        "BR": (h - 1, w - 1),
+    }
+
+
+def _movement_from_missing(missing: tuple[str, ...]) -> tuple[int, int]:
+    missing = tuple(sorted(missing, key=lambda name: CORNER_INDEX[name]))
+    miss_set = frozenset(missing)
+    if len(missing) == 1:
+        return SINGLE_MOVES[missing[0]]
+    if len(missing) == 2:
+        if miss_set not in DOUBLE_MOVES:
+            raise AssertionError("two missing corners must lie on one side")
+        return DOUBLE_MOVES[miss_set]
+    if len(missing) == 3:
+        kept = next(iter(set(CORNER_ORDER) - miss_set))
+        sr, sc = CORNER_SIGNS[kept]
+        return 3 * sr, 3 * sc
