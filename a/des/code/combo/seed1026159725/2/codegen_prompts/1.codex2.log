+
+def _branch_of_pattern(pattern: tuple[str, ...]) -> int:
+    return len(pattern)
+
+
+def _pick_patterns(rng: np.random.Generator, n_objects: int) -> list[tuple[str, ...]]:
+    pools = {branch: list(patterns) for branch, patterns in BRANCH_PATTERNS.items()}
