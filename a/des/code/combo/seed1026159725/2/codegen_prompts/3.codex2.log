    61	    return (
    62	        outer_r0 <= r0 <= r1 <= outer_r1
    63	        and outer_c0 <= c0 <= c1 <= outer_c1
    64	        and nw["cr2"] < center["cr2"] < sw["cr2"]
    65	        and nw["cc2"] < center["cc2"] < ne["cc2"]
