+
+def _transform(arr: np.ndarray, kind: str) -> np.ndarray:
+    if kind == "tb":
+        return np.flipud(arr)
+    if kind == "lr":
+        return np.fliplr(arr)
+    assert kind == "rot"
+    return np.rot90(arr, 2)
