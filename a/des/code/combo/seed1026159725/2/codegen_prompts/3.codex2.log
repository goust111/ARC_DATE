+        full = _crop_mask(base | np.rot90(base, 2))
+        if not _is_connected(full):
+            continue
+        if np.array_equal(full, np.flipud(full)) or np.array_equal(full, np.fliplr(full)):
+            continue
+        return full
+    return None
