+    mh, mw = marker_mask.shape
+    if mh >= ih - 1 or mw >= iw - 1:
+        return None
+    for _ in range(120):
+        pr = random.randint(1, ih - mh - 1)
+        pc = random.randint(1, iw - mw - 1)
+        probe = used.copy()
+        if _reserve_rect(probe, pr, pc, mh, mw, pad=1):
