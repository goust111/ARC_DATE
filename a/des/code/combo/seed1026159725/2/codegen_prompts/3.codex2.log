   451	        out = main(canvas)
   452	    except Exception:
   453	        return None
   454	    if not np.array_equal(out, output):
   455	        return None
   456	    return canvas
   457	
   458	
   459	def generate_input() -> np.ndarray:
   460	    for _ in range(MAX_ATTEMPTS):
   461	        g = _gen_attempt()
   462	        if g is not None:
