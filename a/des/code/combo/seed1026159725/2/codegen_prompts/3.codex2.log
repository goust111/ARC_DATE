   407	        except ValueError:
   408	            return None
   409	        region = canvas[r0:r0 + patch.shape[0], c0:c0 + patch.shape[1]]
   410	        mask = patch != 0
   411	        region[mask] = patch[mask]
   412	    return canvas
   413	
   414	
   415	def _gen_attempt() -> np.ndarray | None:
   416	    N = random.randint(N_MIN, N_MAX)
   417	    p = random.randint(1, N - 1)
   418	
   419	    # Build quadrant ownership grid
   420	    own = _build_ownership(N, p, _random_tab_specs(N))
   421	    if own is None:
