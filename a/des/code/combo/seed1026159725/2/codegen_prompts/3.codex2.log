   523	                    paste(inp, dist_arr, pr, pc, transparent=bg)
   524	                except ValueError:
   525	                    pass  # skip distractor if no room
   526	
   527	    # Oracle check
   528	    result = main(inp)
   529	    if not np.array_equal(result, out):
   530	        return None
   531	
   532	    return inp
   533	
