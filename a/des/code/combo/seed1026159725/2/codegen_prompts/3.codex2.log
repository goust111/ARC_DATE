+def _sample_marker_position(
+    marker_mask: np.ndarray, interior_shape: tuple[int, int], used: np.ndarray
+) -> tuple[int, int] | None:
+    ih, iw = interior_shape
+    mh, mw = marker_mask.shape
+    if mh >= ih - 1 or mw >= iw - 1:
