   295	
   296	def _build_ownership(N: int, p: int, tab_specs: dict) -> np.ndarray | None:
   297	    """Build 2Nx2N quadrant-ownership grid with tab intrusions.
   298	
   299	    tab_specs maps tab name -> (depth, direction) or None.
   300	    Returns (2N,2N) array with values TL/TR/BL/BR, or None if any
   301	    quadrant region is empty or not 8-connected.
   302	    """
   303	    S = 2 * N
   304	    own = np.zeros((S, S), dtype=int)
   305	    own[:N, :N] = TL
   306	    own[:N, N:] = TR
   307	    own[N:, :N] = BL
   308	    own[N:, N:] = BR
   309	
   310	    # H-tabs: single-column strips crossing the horizontal boundary (row N)
   311	    for kind, col, up_owner, down_owner in [
   312	        ('H_left',  p,         BL, TL),
   313	        ('H_right', S - 1 - p, BR, TR),
   314	    ]:
   315	        spec = tab_specs.get(kind)
   316	        if spec is None:
   317	            continue
   318	        depth, direction = spec
   319	        if direction == 'up':
   320	            own[N - depth:N, col] = up_owner
   321	        else:
   322	            own[N:N + depth, col] = down_owner
   323	
   324	    # V-tabs: single-row strips crossing the vertical boundary (col N)
   325	    for kind, row, left_owner, right_owner in [
   326	        ('V_top', p,         TR, TL),
   327	        ('V_bot', S - 1 - p, BR, BL),
   328	    ]:
   329	        spec = tab_specs.get(kind)
   330	        if spec is None:
   331	            continue
   332	        depth, direction = spec
   333	        if direction == 'left':
   334	            own[row, N - depth:N] = left_owner
   335	        else:
   336	            own[row, N:N + depth] = right_owner
   337	
   338	    # Verify all four quadrant regions are non-empty and 8-connected
   339	    for q in (TL, TR, BL, BR):
   340	        mask = (own == q).astype(int)
   341	        if mask.sum() == 0:
   342	            return None
   343	        if not is_contiguous(mask, background=0, connectivity=8):
   344	            return None
   345	    return own
   346	
   347	
   348	def _extract_piece(own: np.ndarray, q: int, color: int,
   349	                   marker_pos: tuple[int, int] | None = None) -> list[tuple[int, int, int]]:
   350	    """Extract cells for quadrant *q* in local (0-based) coordinates.
   351	
   352	    All cells get *color*, except *marker_pos* which gets MARKER_COLOR.
   353	    """
   354	    rows, cols = np.where(own == q)
   355	    min_r, min_c = rows.min(), cols.min()
   356	    cells = [(int(r) - min_r, int(c) - min_c, color) for r, c in zip(rows, cols)]
   357	    if marker_pos is not None:
   358	        mr, mc = marker_pos[0] - min_r, marker_pos[1] - min_c
   359	        cells = [(r, c, MARKER_COLOR if (r, c) == (mr, mc) else col)
   360	                 for r, c, col in cells]
   361	    return cells
   362	
   363	
   364	def _cells_to_patch(cells) -> np.ndarray:
   365	    """Render cell list into a tight numpy patch (bg=0)."""
   366	    h = max(r for r, _, _ in cells) + 1
   367	    w = max(c for _, c, _ in cells) + 1
   368	    patch = np.zeros((h, w), dtype=int)
   369	    for r, c, col in cells:
   370	        patch[r, c] = col
   371	    return patch
   372	
   373	
   374	def _random_tab_specs(N: int) -> dict:
   375	    """Sample random tab specs for all four boundaries.
   376	
   377	    At N=2, one tab is randomly dropped (spec says only 3 may be present).
   378	    """
   379	    specs = {}
   380	    for tn in TAB_NAMES:
   381	        depth = random.randint(1, N - 1)
   382	        if tn.startswith('H'):
   383	            direction = random.choice(['up', 'down'])
   384	        else:
   385	            direction = random.choice(['left', 'right'])
   386	        specs[tn] = (depth, direction)
   387	
   388	    if N == 2:
   389	        specs[random.choice(TAB_NAMES)] = None
   390	    return specs
   391	
   392	
   393	def _scatter_patches(patches: list[np.ndarray]) -> np.ndarray | None:
   394	    """Place patches on a canvas in random order with padding.
   395	
   396	    Returns the canvas, or None if any patch doesn't fit.
   397	    """
   398	    canvas = np.zeros((CANVAS_H, CANVAS_W), dtype=int)
   399	    order = list(range(len(patches)))
   400	    random.shuffle(order)
   401	    for i in order:
   402	        patch = patches[i]
