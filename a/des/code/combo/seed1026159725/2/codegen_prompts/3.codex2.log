   309	        # Now verify exactly 1 valid attachment across all 4 rotations x 4 sides.
   310	        # The solver, for each side, tries rot90 x 0-3 and checks:
   311	        #   - correct symmetry (fliplr for top/bot, flipud for left/right)
   312	        #   - contact edge = e contiguous cells on the correct side
   313	        # We need exactly 1 such (rotation, side) pair across all possibilities.
   314	        # Actually, the solver matches by color, so each sprite is only tested against
   315	        # one side. But we need: for ANY side the solver might try, only 1 rotation works.
   316	        # Since the solver already picks the first valid rotation, we just need that
   317	        # for the intended side, exactly 1 rotation of the sprite is valid.
   318	
   319	        # Check: for the canonical "left" side, how many rotations are valid?
   320	        valid_for_left = 0
