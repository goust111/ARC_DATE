   327	            cc0, cc1 = np.where(ca)[0][[0, -1]]
   328	            cr = rot[rr0:rr1+1, cc0:cc1+1]
   329	            # Left side needs flipud + right-edge = e contiguous
   330	            if not np.array_equal(cr, np.flipud(cr)):
   331	                continue
   332	            rc = cr[:, -1]
   333	            runs2 = []
   334	            cnt2 = 0
   335	            for v in rc:
   336	                if v: cnt2 += 1
   337	                else:
   338	                    if cnt2 > 0: runs2.append(cnt2)
   339	                    cnt2 = 0
   340	            if cnt2 > 0: runs2.append(cnt2)
   341	            if len(runs2) == 1 and runs2[0] == e:
   342	                valid_for_left += 1
   343	
   344	        if valid_for_left != 1:
   345	            continue
   346	
   347	        # Success! Now rotate to target side.
   348	        # grid is in "left-attach" frame (contact on right, flipud symmetric).
   349	        # left -> as-is
   350	        # right -> fliplr (contact moves to left side)
   351	        # top -> rot90 CW (contact moves to bottom)
   352	        # bot -> rot90 CCW (contact moves to top)
   353	        if side == "left":
