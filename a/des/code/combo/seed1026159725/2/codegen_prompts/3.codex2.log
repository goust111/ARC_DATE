    36	def _aligned_markers(markers: tuple[dict, dict, dict, dict]) -> bool:
    37	    bnw, bne, bsw, bse = map(_bbox, markers)
    38	    return (
    39	        (bnw[0], bnw[2]) == (bne[0], bne[2])
    40	        and (bsw[0], bsw[2]) == (bse[0], bse[2])
    41	        and (bnw[1], bnw[3]) == (bsw[1], bsw[3])
    42	        and (bne[1], bne[3]) == (bse[1], bse[3])
    43	        and bnw[2] < bsw[0]
    44	        and bne[2] < bse[0]
    45	        and bnw[3] < bne[1]
    46	        and bsw[3] < bse[1]
