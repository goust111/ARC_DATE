+        elif side == "bottom":
+            grid[fr1, fc0 + 1 + anchor] = color
+        elif side == "left":
+            grid[fr0 + 1 + anchor, fc0] = color
+        else:
+            grid[fr0 + 1 + anchor, fc1] = color
