   494	        # Crop to bounding box of the mask
   495	        rows_any = rotated_mask.any(axis=1)
   496	        cols_any = rotated_mask.any(axis=0)
   497	        r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]
   498	        c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]
   499	        cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]
   500	        cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]
   501	        patch = np.where(cropped_mask, cropped_arr, bg).astype(int)
   502	
   503	        try:
   504	            pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)
   505	        except ValueError:
   506	            return None
   507	        paste(canvas, patch, pr, pc, transparent=bg)
   508	        paste(inp, patch, pr, pc, transparent=bg)
   509	
   510	    # Optionally add a distractor (0 or 1)
   511	    if rng.random() < 0.3:
   512	        used_colors = set(side_colors.values())
   513	        distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]
   514	        if distractor_colors:
   515	            dcol = rng.choice(distractor_colors)
   516	            # Make a small distractor sprite
   517	            dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)
