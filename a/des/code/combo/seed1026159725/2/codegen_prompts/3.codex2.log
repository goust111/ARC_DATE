   434	    output[0, 0] = MARKER_COLOR
   435	
   436	    # Extract pieces: anchor gets marker at (0,0)
   437	    anchor_cells = _extract_piece(own, TL, ANCHOR_COLOR, marker_pos=(0, 0))
   438	    other_cells = [_extract_piece(own, q, quad_colors[q]) for q in (TR, BL, BR)]
   439	
   440	    # Rotate: anchor to random orientation, each other piece randomly
   441	    all_cells = [_rotate_cells(anchor_cells, random.randint(0, 3))] + \
   442	                [_rotate_cells(c, random.randint(0, 3)) for c in other_cells]
   443	
   444	    # Scatter on canvas
   445	    canvas = _scatter_patches([_cells_to_patch(c) for c in all_cells])
   446	    if canvas is None:
   447	        return None
