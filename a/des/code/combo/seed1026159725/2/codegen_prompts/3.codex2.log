+            pc = random.randint(0, iw - pw)
+        elif side == "left":
+            pr = random.randint(0, ih - ph)
+            pc = 0
+        else:
+            pr = random.randint(0, ih - ph)
+            pc = iw - pw
+        probe = used.copy()
+        if _reserve_rect(probe, pr, pc, ph, pw, pad=1):
+            return pr, pc
+    return None
+
