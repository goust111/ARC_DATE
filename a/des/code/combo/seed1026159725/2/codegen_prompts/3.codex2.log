    76	def _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:
    77	    if not points:
    78	        return []
    79	    # Process from the far end (closest to destination boundary) inward.
    80	    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)
    81	    occupied = set()
    82	    out_pts = []
    83	    for r0, c0 in points_sorted:
    84	        r, c = r0, c0
    85	        while True:
    86	            nr, nc = r + dr, c + dc
    87	            if (nr, nc) not in region_set:
    88	                break
    89	            # For diagonal steps, disallow "corner cutting": both orthogonal intermediates must be inside the region.
    90	            if dr != 0 and dc != 0:
    91	                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:
    92	                    break
    93	            if (nr, nc) in occupied:
    94	                break
    95	            r, c = nr, nc
    96	        occupied.add((r, c))
    97	        out_pts.append((r, c))
    98	    return out_pts
