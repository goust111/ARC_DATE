+def _bottom_to_top_order(grid: np.ndarray, rects: list[dict]) -> list[int]:
+    n = len(rects)
+    edges = [set() for _ in range(n)]
+    indeg = [0] * n
+    by_color = {int(rect["color"]): idx for idx, rect in enumerate(rects)}
