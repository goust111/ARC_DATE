+    rng: np.random.Generator,
+) -> set[tuple[int, int]]:
+    cells = set(seed)
+    while len(cells) < target_area:
+        frontier = []
+        for r in range(height):
+            for c in range(width):
+                if (r, c) in cells:
+                    continue
+                if any((nr, nc) in cells for nr, nc in _neighbors4(r, c)):
+                    frontier.append((r, c))
