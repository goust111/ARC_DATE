+        center_c = (c0 + c1) // 2
+        edge = _nearest_edge(h, w, (r0, c0, r1, c1))
+
+        if edge == "top":
+            row = 0
+            for offset in range(area):
+                col = center_c + offset
+                if 0 <= col < w:
+                    out[row, col] = color
+        elif edge == "bottom":
+            row = h - 1
+            for offset in range(area):
+                col = center_c + offset
+                if 0 <= col < w:
+                    out[row, col] = color
+        elif edge == "left":
+            col = 0
+            for offset in range(area):
+                row = center_r + offset
+                if 0 <= row < h:
+                    out[row, col] = color
+        else:
+            col = w - 1
+            for offset in range(area):
+                row = center_r + offset
+                if 0 <= row < h:
+                    out[row, col] = color
+
+    return out
