+        step = rng.choice([s for s in (1, 2) if s <= max_step])
+        span = 1 + (count - 1) * step
+        start = rng.randint(r0, r1 - span + 1)
+        return [(start + i * step, col) for i in range(count)]
+
+    max_step = max(1, min(height - 1, width - 1) // max(1, count - 1))
+    step = rng.choice([s for s in (1, 2) if s <= max_step])
+    span = 1 + (count - 1) * step
+
+    if orientation == "d1":
