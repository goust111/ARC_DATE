+def _marker_positions(
+    bounds: tuple[int, int, int, int], orientation: str, count: int, rng: random.Random
+) -> list[tuple[int, int]]:
+    r0, r1, c0, c1 = bounds
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+
+    if orientation == "h":
