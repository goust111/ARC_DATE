+def _room_bounds(sizes: list[int]) -> list[tuple[int, int]]:
+    bounds: list[tuple[int, int]] = []
+    start = 1
+    for size in sizes:
+        bounds.append((start, start + size - 1))
+        start += size + 1
+    return bounds
+
