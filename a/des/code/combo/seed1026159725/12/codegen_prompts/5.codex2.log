+# --------------- generator ---------------
+
+GRID_RANGE = (12, 18)
+NUM_OBJECTS_RANGE = (2, 5)
+MOLD_SIDE_RANGE = (2, 5)
+MAX_OBJECT_SIDE = 6
+MAX_RETRIES = 400
+BG_CHOICES = [0, 1, 2, 3, 4, 6, 7, 8, 9]
