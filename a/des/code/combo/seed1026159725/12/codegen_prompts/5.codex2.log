+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and bool(mask[nr, nc]) and (nr, nc) not in seen:
