+            frontier.remove((rr, cc))
+            if (rr, cc) in cells:
+                continue
+            cells.add((rr, cc))
+            mask[rr, cc] = True
+            for dr, dc in DIR4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
