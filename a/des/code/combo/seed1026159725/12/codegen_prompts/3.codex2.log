+        actual = {(r0, c0) for r0, c0, r1, c1 in boxes}
+        if actual != expected:
+            continue
+        candidates.append((color, sorted(boxes)))
+    assert len(candidates) == 1, "expected exactly one 3x3 panel-frame color"
+    return candidates[0]
