+    seeds = _seed_data(g, bg)
+    seed_cells = {(r, c) for _idx, r, c, _color in seeds}
+    hits: dict[tuple[int, int], set[int]] = {}
+    stop_reasons: list[str] = []
+
+    for idx, r, c, _color in seeds:
