+        center_r = 1 + int(distance)
+        center_c_choices = list(range(1 + half_c, w - 1 - half_c))
+    elif side == "bottom":
+        center_r = h - 2 - int(distance)
+        center_c_choices = list(range(1 + half_c, w - 1 - half_c))
+    elif side == "left":
