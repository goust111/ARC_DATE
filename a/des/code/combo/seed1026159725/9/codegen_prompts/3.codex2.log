+    _parse_shape(["#", "#", "#"]),
+    _parse_shape(["###", "###", "###"]),
+    _parse_shape([".#.", "###", ".#."]),
+    _parse_shape(["###", ".#.", ".#."]),
+    _parse_shape(["#..", "###", "..."]),
+    _parse_shape(["#####", "..#..", "..#.."]),
+    _parse_shape(["..#..", "..#..", "#####"]),
+    _parse_shape([".#...", "#####", "...#."]),
