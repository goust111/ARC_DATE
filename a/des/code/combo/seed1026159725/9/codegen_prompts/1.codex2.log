+    c0, c1 = min(cols), max(cols)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    expected = 2 * (h + w) - 4
+    if len(comp) != expected:
+        return None
+    pts = set(comp)
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return None
+    for r in range(r0, r1 + 1):
