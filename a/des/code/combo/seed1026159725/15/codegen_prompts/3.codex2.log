+        if lines is None:
+            continue
+        row_lines, col_lines = lines
+        score = int((grid == color).sum()) + 8 * (len(row_lines) + len(col_lines))
+        if best is None or score > best[3]:
+            best = (color, row_lines, col_lines, score)
