+        r0, r1 = row_spans[ri]
+        c0, c1 = col_spans[ci]
+        out[r0 : r1 + 1, c0 : c1 + 1] = color
+    out[row_lines, :] = bg
+    out[:, col_lines] = bg
+    return out
+
