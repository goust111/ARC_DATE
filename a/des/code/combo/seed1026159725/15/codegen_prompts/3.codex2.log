+
+    for (ri, ci), color in zip(chosen_cells, object_colors):
+        r0, r1 = row_spans[ri]
+        c0, c1 = col_spans[ci]
+        cell_h = r1 - r0 + 1
+        cell_w = c1 - c0 + 1
