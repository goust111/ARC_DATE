+def _grow_blob(h: int, w: int, target_area: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    start = (random.randrange(h), random.randrange(w))
+    cells = {start}
+    mask[start] = True
+    while len(cells) < target_area:
+        frontier = []
+        for r, c in cells:
