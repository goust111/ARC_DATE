+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+LAYER_A_COLORS = (RED, ORANGE, MAROON)
+LAYER_B_COLORS = (BLUE, AZURE, GREEN)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
