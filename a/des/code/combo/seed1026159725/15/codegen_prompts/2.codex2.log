+    a_w = random.randint(LOCAL_SHAPE_MIN, min(LOCAL_SHAPE_MAX, width - 1))
+    b_h = random.randint(LOCAL_SHAPE_MIN, min(LOCAL_SHAPE_MAX, height - 1))
