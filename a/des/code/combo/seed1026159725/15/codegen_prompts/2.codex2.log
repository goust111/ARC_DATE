+GRID_HEIGHT_RANGE = (10, 19)
+GRID_WIDTH_RANGE = (10, 19)
+LOCAL_SHAPE_MIN = 4
+LOCAL_SHAPE_MAX = 9
+GENERATION_ATTEMPTS = 400
