+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in NEIGHBORS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
