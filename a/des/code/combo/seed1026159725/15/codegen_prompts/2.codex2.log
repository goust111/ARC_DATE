+        return False
+    if not np.array_equal(right[only_b], grid[only_b]):
+        return False
+    if not np.array_equal(left[overlap], np.full(int(overlap.sum()), RED, dtype=int)):
+        return False
+    if not np.array_equal(right[overlap], np.full(int(overlap.sum()), BLUE, dtype=int)):
+        return False
+    return True
