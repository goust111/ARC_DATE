+        rect_w = random.randint(2, max(2, min(w, 5)))
+        top = max(0, min(h - rect_h, pr - random.randrange(rect_h)))
+        left = max(0, min(w - rect_w, pc - random.randrange(rect_w)))
+        mask[top : top + rect_h, left : left + rect_w] = True
+    return mask
