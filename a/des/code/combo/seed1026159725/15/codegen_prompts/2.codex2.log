+def _colorize(mask: np.ndarray, palette: tuple[int, ...]) -> np.ndarray:
+    colors = random.sample(list(palette), random.randint(1, len(palette)))
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=int)
+    if len(colors) == 1:
