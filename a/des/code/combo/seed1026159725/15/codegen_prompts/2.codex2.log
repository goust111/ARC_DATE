+    mask = np.zeros((h, w), dtype=bool)
+    start = (random.randrange(h), random.randrange(w))
+    cells = {start}
+    mask[start] = True
+    while len(cells) < target_area:
+        frontier = []
+        for r, c in cells:
+            for rr, cc in _neighbors4(r, c, h, w):
+                if not mask[rr, cc]:
+                    frontier.append((rr, cc))
