+def _find_nodes(grid: np.ndarray, structure: int) -> tuple[list[tuple[int, int]], dict[tuple[int, int], int]]:
+    h, w = grid.shape
+    nodes: list[tuple[int, int]] = []
+    cell_to_node: dict[tuple[int, int], int] = {}
