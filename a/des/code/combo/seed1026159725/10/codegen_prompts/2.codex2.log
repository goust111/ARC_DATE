+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(*GRID_H_RANGE)
+    w = rng.randint(*GRID_W_RANGE)
+    rect_count = rng.randint(*RECT_COUNT_RANGE)
