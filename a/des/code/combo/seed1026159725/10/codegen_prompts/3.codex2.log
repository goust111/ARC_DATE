+    end = tuple(map(int, ends[0]))
+
+    out = g.copy()
+    prev: tuple[int, int] | None = None
+    cur = start
+    visited_states: set[tuple[int, int, int, int]] = set()
+    paint: set[tuple[int, int]] = set()
+
+    for _ in range(g.size * 4):
