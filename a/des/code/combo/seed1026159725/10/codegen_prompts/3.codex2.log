+    grid[r + 1, c - 1] = body
+    grid[r + 1, c + 1] = body
+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    mh = random.randint(*MACRO_RANGE)
+    mw = random.randint(*MACRO_RANGE)
