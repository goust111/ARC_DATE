+    if ni == (pi + 1) % 4:
+        return "cw"
+    if ni == (pi - 1) % 4:
+        return "ccw"
+    raise AssertionError("self-avoiding walk should not reverse")
+
+
+def _macro_to_pixel(x: int) -> int:
+    return 2 + STEP * x
+
+
