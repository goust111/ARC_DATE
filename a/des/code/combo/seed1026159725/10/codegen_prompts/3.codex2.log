+    return (-d[0], -d[1])
+
+
+def _transition_kind(prev_dir: tuple[int, int], next_dir: tuple[int, int]) -> str:
+    pi = DIR_TO_IDX[prev_dir]
+    ni = DIR_TO_IDX[next_dir]
+    if pi == ni:
