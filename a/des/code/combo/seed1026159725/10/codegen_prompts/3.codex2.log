+import random
+from collections import Counter
+
+import numpy as np
+
+
+RED = 2
+BLUE = 1
+GREY = 5
+ORANGE = 7
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+DIR_TO_IDX = {d: i for i, d in enumerate(DIRS)}
+
+PASSABLE = {RED, BLUE, GREY, ORANGE}
