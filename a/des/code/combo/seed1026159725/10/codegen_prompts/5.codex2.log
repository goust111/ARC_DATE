+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SHAPE_TYPES = ("H", "V", "L")
+L_ORIENTATIONS = ("dr", "dl", "ur", "ul")
+
+GRID_SIDE_RANGE = (12, 18)
+OBJECT_COUNT_RANGE = (3, 5)
