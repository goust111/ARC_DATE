+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) == bg:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+            components.append(coords)
+    return components
+
+
