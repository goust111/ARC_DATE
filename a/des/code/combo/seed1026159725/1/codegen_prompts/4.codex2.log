+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    n_frames = random.randint(*FRAME_COUNT_RANGE)
+    min_side = max(GRID_MIN, 12 + 3 * n_frames)
+    h = random.randint(min_side, GRID_MAX)
