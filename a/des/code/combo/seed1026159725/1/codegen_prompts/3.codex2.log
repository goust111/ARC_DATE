+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            inp, _ = _generate_case()
+            return inp
+        except AssertionError:
+            continue
+    raise AssertionError("failed to generate a valid input")

