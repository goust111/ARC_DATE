+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    norm = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+    h = max(r for r, _ in norm) + 1
+    w = max(c for _, c in norm) + 1
+    return norm, int(h), int(w)
