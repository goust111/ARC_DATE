+    return grid, row_bands, col_bands
+
+
+def _choose_pair_positions(rows: int, cols: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    branch = random.choice(("same_row", "same_col", "diag"))
+    if branch == "same_row":
