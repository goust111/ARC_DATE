+    for rr, (r0, r1) in enumerate(row_bands):
+        for cc, (c0, c1) in enumerate(col_bands):
+            cell = g[r0 : r1 + 1, c0 : c1 + 1]
+            by_shape[_shape_signature(cell, bg, sep)].append((rr, cc))
