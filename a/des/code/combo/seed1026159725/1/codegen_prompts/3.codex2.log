+    rr1 = row_bands[max(r0, r1)][1]
+    cc0 = col_bands[min(c0, c1)][0]
+    cc1 = col_bands[max(c0, c1)][1]
+    return grid[rr0 : rr1 + 1, cc0 : cc1 + 1].copy()
