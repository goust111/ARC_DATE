+    for r in range(h):
+        if bool(np.all(grid[r] == grid[r, 0])):
+            counts[int(grid[r, 0])] += 1
+    for c in range(w):
+        if bool(np.all(grid[:, c] == grid[0, c])):
+            counts[int(grid[0, c])] += 1
+    counts.pop(int(bg), None)
