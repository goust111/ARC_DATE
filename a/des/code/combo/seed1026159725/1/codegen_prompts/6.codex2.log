+    if big_max < big_min:
+        return None
+
+    for _ in range(80):
+        small = _grow_connected_shape(allowed, small_area, seed_candidates=near_marker)
+        if small is None:
+            continue
+        big_area = random.randint(int(big_min), int(big_max))
+        big = _grow_connected_shape(allowed, big_area, initial=small)
+        if big is None:
