+    small_area = random.randint(int(SMALL_AREA_RANGE[0]), int(small_max))
+
+    big_min = small_area + int(BIG_EXTRA_RANGE[0])
+    big_max = min(small_area + int(BIG_EXTRA_RANGE[1]), panel_cells // 2, panel_cells - 1)
