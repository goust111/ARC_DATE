+            left, right = sorted(pair, key=lambda item: int(item["bbox"][2]))
+            line_r = int(left["global_marker"][0])
+            for c in range(int(left["bbox"][3]), int(right["bbox"][2])):
+                if bool(col_sep[c]):
+                    out[line_r, c] = int(marker_color)
