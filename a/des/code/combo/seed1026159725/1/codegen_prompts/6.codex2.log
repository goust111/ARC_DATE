+        return small, big
+    return None
+
+
+def _paint_panel(
+    grid: np.ndarray,
+    row_span: tuple[int, int],
+    col_span: tuple[int, int],
+    shape: set[tuple[int, int]],
+    marker: tuple[int, int],
+    object_color: int,
+    marker_color: int,
+    bg: int,
+) -> None:
