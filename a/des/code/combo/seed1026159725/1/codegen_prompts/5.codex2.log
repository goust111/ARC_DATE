 158:         label[r, c] = i
 159:         comps.append({(r, c)})
 160: 
 161:     for i, size in enumerate(sizes, start=1):
 162:         while len(comps[i - 1]) < size:
 163:             frontier = set()
 164:             for rr, cc in comps[i - 1]:
