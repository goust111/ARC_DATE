 141: def _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:
 142:     size = int(labels.shape[0])
 143:     for rr, cc in _gen_neighbors4(r, c, size):
 144:         if labels[rr, cc] not in (0, label):
 145:             return False
 146:     return True
