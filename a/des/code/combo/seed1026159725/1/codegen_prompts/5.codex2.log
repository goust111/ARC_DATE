  86:     out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)
  87:     out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)
  88:     return _render_bars(n, out_colors, out_heights)
  89: 
