 120: def _partition(total: int, parts: int) -> list[int]:
 121:     mins = [PART_MIN_SIZE] * parts if total >= PART_MIN_SIZE * parts else [1] * parts
 122:     remaining = total - sum(mins)
 123:     weights = [random.random() + PART_WEIGHT_OFFSET for _ in range(parts)]
 124:     sizes = mins[:]
 125:     for _ in range(remaining):
