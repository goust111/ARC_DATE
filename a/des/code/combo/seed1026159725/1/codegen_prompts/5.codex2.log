 133: def _gen_partition(total: int, parts: int) -> list[int]:
 134:     sizes = [1] * parts
 135:     for _ in range(total - parts):
 136:         sizes[random.randrange(parts)] += 1
 137:     random.shuffle(sizes)
 138:     return sizes
