+        label_index = int(np.flatnonzero(values == label_color)[0])
+        label_pos = (int(rows[label_index]), int(cols[label_index]))
+
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        mask[rows - r0, cols - c0] = True
