+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _build_main_path(
+    rng: np.random.Generator,
+    coarse_shape: tuple[int, int],
+    length: int,
+) -> list[tuple[int, int]] | None:
+    for _ in range(200):
+        start = (int(rng.integers(coarse_shape[0])), int(rng.integers(coarse_shape[1])))
+        path = [start]
+        used = {start}
+        while len(path) < length:
+            current = path[-1]
+            options = [nbr for nbr in _coarse_neighbors(current, coarse_shape) if nbr not in used]
+            if not options:
+                break
+            if len(path) >= 2:
+                prev = path[-2]
+                dr = current[0] - prev[0]
+                dc = current[1] - prev[1]
+                straight = (current[0] + dr, current[1] + dc)
+                if straight in options and rng.random() < 0.55:
+                    nxt = straight
+                else:
