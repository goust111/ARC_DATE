+def _path_between(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    adjacency: dict[tuple[int, int], list[tuple[int, int]]],
+) -> list[tuple[int, int]]:
+    parent = {start: None}
+    queue = [start]
+    head = 0
+    while head < len(queue):
+        node = queue[head]
+        head += 1
+        if node == goal:
+            break
+        for nbr in adjacency[node]:
+            if nbr not in parent:
+                parent[nbr] = node
+                queue.append(nbr)
+    assert goal in parent, "endpoints must be connected"
+
+    path: list[tuple[int, int]] = []
+    node = goal
+    while node is not None:
+        path.append(node)
+        node = parent[node]
+    path.reverse()
+    return path
