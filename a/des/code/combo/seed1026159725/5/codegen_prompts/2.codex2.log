+    branch_count = [0, int(rng.integers(1, 3)), int(rng.integers(2, 5))][branch_mode]
+    internal_nodes = main_path[1:-1]
+
+    for _ in range(branch_count):
+        branch = _add_branch(rng, coarse_shape, nodes, internal_nodes, (1, 4))
+        if branch is None:
