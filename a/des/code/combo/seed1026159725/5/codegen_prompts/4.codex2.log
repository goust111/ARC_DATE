+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while q:
+                cr, cc = q.popleft()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = int(cr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            comps.append({"color": color, "coords": coords, "size": len(coords)})
+
+    return comps
