+    assert g.ndim == 2 and g.size > 0
+
+    comps = _components(g)
+    max_size = max(comp["size"] for comp in comps)
+
+    out = np.empty_like(g)
+    for comp in comps:
+        size = int(comp["size"])
+        if size == max_size:
+            fill = YELLOW
+        else:
+            fill = RED if size % 2 == 1 else GREEN
+        for r, c in comp["coords"]:
+            out[r, c] = fill
+
+    return out
+
+
+def _choose_mode(rng: random.Random) -> dict:
+    if rng.random() < 0.55:
+        return {
+            "max_h": 2,
+            "nonmax_h_choices": (1,),
+            "max_w_choices": (4, 5),
+        }
+    return {
+        "max_h": 3,
+        "nonmax_h_choices": (1, 2),
+        "max_w_choices": (3,),
+    }
+
+
+def _sample_band_sizes(
+    rng: random.Random,
+    count: int,
+    max_value: int,
+    nonmax_choices: tuple[int, ...],
