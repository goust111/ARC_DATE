+            sizes.append(int(max_value))
+        else:
+            sizes.append(int(rng.choice(nonmax_choices)))
+    return sizes
+
+
+def _force_required_values(
+    sizes: list[int],
+    required: list[int],
+    nonmax_value: int,
+    max_value: int,
+    rng: random.Random,
+) -> None:
