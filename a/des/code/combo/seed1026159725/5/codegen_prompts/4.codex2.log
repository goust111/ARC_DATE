+
+GEN_RETRIES = 400
+MIN_COMPONENTS = 8
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while q:
+                cr, cc = q.popleft()
+                coords.append((int(cr), int(cc)))
