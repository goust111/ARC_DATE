+def _expanded(cells: set[tuple[int, int]], shape: tuple[int, int], pad: int) -> set[tuple[int, int]]:
+    h, w = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w:
