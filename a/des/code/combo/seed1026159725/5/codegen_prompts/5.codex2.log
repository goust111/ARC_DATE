+def _touches_marker(marker: tuple[int, int], obj_cells: set[tuple[int, int]]) -> bool:
+    mr, mc = marker
+    for dr, dc in DIRS4:
+        if (int(mr + dr), int(mc + dc)) in obj_cells:
+            return True
+    return False
+
