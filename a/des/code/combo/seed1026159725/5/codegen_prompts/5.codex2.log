+def _side_from_marker(center: tuple[int, int], marker: tuple[int, int]) -> str:
+    cr, cc = center
+    mr, mc = marker
+    if mc == cc and mr < cr:
+        return "up"
+    if mr == cr and mc > cc:
+        return "right"
+    if mc == cc and mr > cr:
+        return "down"
+    if mr == cr and mc < cc:
+        return "left"
+    raise AssertionError("marker must be axis-aligned with the object center")
