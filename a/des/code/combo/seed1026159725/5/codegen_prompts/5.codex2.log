+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if -3 <= nr <= 3 and -3 <= nc <= 3:
+                        frontier.add((nr, nc))
+            frontier -= cells
+            cells.add(random.choice(tuple(frontier)))
