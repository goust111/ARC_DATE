+def _random_shape(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(SHAPE_H_RANGE[0], SHAPE_H_RANGE[1] + 1))
+    w = int(rng.integers(SHAPE_W_RANGE[0], SHAPE_W_RANGE[1] + 1))
+    total = h * w
+    if total == 1:
