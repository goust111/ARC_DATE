+    return out
+
+
+def _source_cell(side: str, index: int, h: int, w: int) -> tuple[int, int]:
+    if side == "top":
+        return (0, index)
+    if side == "bottom":
+        return (h - 1, index)
+    if side == "left":
+        return (index, 0)
+    if side == "right":
+        return (index, w - 1)
+    raise AssertionError("unknown side")
+
+
+def _edge_candidates(side: str, h: int, w: int) -> list[int]:
+    if side in ("top", "bottom"):
+        return list(range(1, w - 1))
+    return list(range(1, h - 1))
+
+
+def _line_cells_from_source(pos: tuple[int, int], step: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = pos
+    dr, dc = step
+    cells = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return cells
+        cells.append((r, c))
+
+
+def _diagonal_cells_from_prism(
+    prism: tuple[int, int],
+    step: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r, c = prism
+    dr, dc = step
+    cells = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return cells
+        cells.append((r, c))
+
+
