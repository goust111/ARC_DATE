+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords_arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": _bbox(coords_arr),
+                }
+            )
+
+    return components
+
+
+def _crop_component(grid: np.ndarray, component: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    color = int(component["color"])
+    for r, c in component["coords"]:
+        patch[int(r) - r0, int(c) - c0] = color
+    return patch
+
+
+def _longest_consecutive_true_1d(arr: np.ndarray) -> int:
+    best = 0
+    run = 0
+    for value in arr:
+        if bool(value):
+            run += 1
+            if run > best:
+                best = run
+        else:
+            run = 0
+    return int(best)
