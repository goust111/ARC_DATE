+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+COLOR_POOL = tuple(range(10))
+GEN_RETRY_LIMIT = 400
+_RNG = np.random.default_rng()
