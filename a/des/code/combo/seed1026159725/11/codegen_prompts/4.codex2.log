+def _normalize_coords(coords: set[tuple[int, int]]) -> np.ndarray:
+    arr = np.array(sorted(coords), dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    return arr
