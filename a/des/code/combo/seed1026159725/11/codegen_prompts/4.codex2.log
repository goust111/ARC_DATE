+        old_w = int(c1 - c0 + 1)
+        new_h, new_w = map(int, patch.shape)
+        top, left = _centered_top_left(r0, c0, old_h, old_w, new_h, new_w)
+        _paste_non_bg(out, patch, bg, top, left)
+
+    return out
