+def _make_object_patch(orientation: str, color: int, bg: int, rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        stem_len = int(rng.integers(4, 8))
+        arm_count = int(rng.integers(1, min(5, stem_len)))
+        arm_rows = rng.choice(np.arange(1, stem_len - 1), size=arm_count, replace=False)
+
+        coords: set[tuple[int, int]] = set()
+        if orientation == "vertical":
+            for r in range(stem_len):
+                coords.add((r, 0))
