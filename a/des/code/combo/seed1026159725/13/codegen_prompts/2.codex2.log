+        _paint_hline,
+        _paint_vline,
+        lambda canvas, color: _paint_diag(canvas, color, anti=False),
+        lambda canvas, color: _paint_diag(canvas, color, anti=True),
+        _paint_plus,
+        _paint_l,
+    )
+
+    for _ in range(100):
+        canvas = np.full((cell_size, cell_size), bg, dtype=int)
+        steps = int(np.random.randint(3, 6))
