+def _random_composition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(np.random.choice(range(1, total), size=parts - 1, replace=False).tolist())
+    points = [0] + cuts + [total]
+    return [points[i + 1] - points[i] for i in range(parts)]
