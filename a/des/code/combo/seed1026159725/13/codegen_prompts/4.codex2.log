0156: def main(grid: np.ndarray) -> np.ndarray:
0157:     """
0158:     Swap each 5x5 sprite with its corner marker color and stamp same-marker composite masks into the matching corner.
0159: 
0160:     Input structure:
0161:     - A 30x30 grid has one dominant background color.
0162:     - Non-background corner pixels are marker labels.
0163:     - Every other foreground color is the body of one 5x5 sprite containing exactly one pixel of a corner marker color.
0164: 
0165:     Rule:
0166:     - For each sprite, recolor body pixels to the sprite marker color and recolor the marker pixel back to its body color.
0167:     - If a marker lies on the side facing its matching corner and another same-marker sprite has a body pixel at that same local cell, use that visible body color for the marker pixel.
0168:     - For each corner marker, overlay the masks of all sprites with that marker color into the corner 5x5 block and paint the visible composite with the marker color.
0169: 
0170:     Key insight:
0171:     The corner pixels are labels that group 5x5 sprites by their embedded marker color; each labeled corner shows the grouped sprite silhouette.
0172:     """
0173:     g = np.asarray(grid, dtype=int)
0174:     h, w = g.shape
0175:     bg = int(get_bg(g))
0176:     labels, label_corner = _corner_labels(g, bg)
0177:     sprites = _find_sprites(g, bg, labels)
0178: 
0179:     by_marker: dict[int, list[Sprite]] = defaultdict(list)
0180:     for sprite in sprites:
0181:         by_marker[sprite.marker].append(sprite)
0182: 
0183:     out = g.copy()
0184:     for sprite in sprites:
0185:         window = g[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]
0186:         patch = out[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]
0187:         patch[window == sprite.body] = sprite.marker
0188: 
0189:         mr, mc = sprite.marker_rc
0190:         replacement = sprite.body
0191:         _corner_r, corner_c = label_corner[sprite.marker]
0192:         side_col = 0 if corner_c == 0 else 4
0193:         if mc == side_col:
0194:             overlaps = [
0195:                 other.body
0196:                 for other in by_marker[sprite.marker]
0197:                 if other is not sprite and bool(other.body_mask[mr, mc])
0198:             ]
0199:             if overlaps:
0200:                 assert len(overlaps) == 1, "side marker overlap must identify one visible body color"
0201:                 replacement = overlaps[0]
0202:         patch[mr, mc] = replacement
0203: 
0204:     for r, c in _corners(h, w):
0205:         label = int(g[r, c])
0206:         if label == bg:
0207:             continue
0208:         group = by_marker[label]
0209:         assert group, "each corner marker must have at least one matching sprite"
0210:         mask = _corner_composite_mask(group, top_corner=(r == 0))
0211:         rows = slice(0, 5) if r == 0 else slice(h - 5, h)
0212:         cols = slice(0, 5) if c == 0 else slice(w - 5, w)
0213:         patch = out[rows, cols]
0214:         patch[mask] = label
0215: 
0216:     return out
