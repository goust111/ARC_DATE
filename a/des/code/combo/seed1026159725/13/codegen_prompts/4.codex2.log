0139: def _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:
0140:     """Pick up to n values from candidates with at least min_spacing between any two."""
0141:     if not candidates:
0142:         return None
0143:     if n == 1:
0144:         return [random.choice(candidates)]
0145:     random.shuffle(candidates)
0146:     picked: list[int] = []
0147:     for v in candidates:
0148:         if all(abs(v - p) >= min_spacing for p in picked):
0149:             picked.append(v)
0150:             if len(picked) == n:
0151:                 return picked
0152:     return picked if picked else None
