+        existing = list(map(tuple, np.argwhere(mask)))
+        _add_path(mask, (random.randrange(height), 0), random.choice(existing))
+        existing = list(map(tuple, np.argwhere(mask)))
+        _add_path(mask, (random.randrange(height), width - 1), random.choice(existing))
