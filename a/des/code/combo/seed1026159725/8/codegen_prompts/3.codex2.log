+    small_right = small_outer[3]
+    big_left_edge = big_outer[1]
+    big_right = big_outer[3]
+    small_left_edge = small_outer[1]
+    if order_small_left:
+        grid[channel_r, small_right : big_left_edge + 1] = frame
+    else:
+        grid[channel_r, big_right : small_left_edge + 1] = frame
