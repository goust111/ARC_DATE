+    left_big = rng.randint(1, 4) + max(0, -left_delta)
+    left_small = left_big + left_delta
+
+    top_margin = rng.randint(1, 5)
+    bottom_margin = rng.randint(1, 5)
+    right_margin = rng.randint(1, 5)
+    order_small_top = bool(rng.randint(0, 1))
