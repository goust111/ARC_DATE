+    c0 = random.randint(0, panel_w - box_w)
+    return frozenset((int(r + r0), int(c + c0)) for r, c in shape)
+
+
+def _all_arrow_placements(panel_h: int, panel_w: int, obj_cells: frozenset[tuple[int, int]]) -> list[tuple[int, int]]:
