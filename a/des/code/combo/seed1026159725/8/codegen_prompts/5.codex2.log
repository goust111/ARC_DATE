+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        q = deque([(r, c)])
+        while q:
