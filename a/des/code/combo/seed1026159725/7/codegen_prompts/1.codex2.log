+
+    return base_specs, cluster_h, cluster_w, want_tie, want_isolated, isolated_count
+
+
+def _gen_attempt() -> np.ndarray | None:
+    mode = random.choice(("line_unique_iso", "hub_unique_iso", "line_tie", "hub_tie"))
