+    fg_counts = [len(obj["coords"]) for obj in objects]
+    if not fg_counts or bg_count <= max(fg_counts):
+        return False
+
+    has_tie, has_isolated, max_degree = _branch_summary(grid)
+    if has_tie != want_tie:
+        return False
+    if has_isolated != want_isolated:
+        return False
+    if max_degree > 3:
+        return False
+
