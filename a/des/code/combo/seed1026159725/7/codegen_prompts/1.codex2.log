+
+        if side == "top":
+            for rr in range(r0 - depth, r0):
+                for cc in range(c0 + offset, c0 + offset + span):
+                    arm.add((rr, cc))
+        elif side == "bottom":
+            for rr in range(r1 + 1, r1 + 1 + depth):
+                for cc in range(c0 + offset, c0 + offset + span):
