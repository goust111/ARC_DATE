+
+def _gen_horizontal_mask() -> np.ndarray:
+    for _ in range(200):
+        height = int(_RNG.choice([3, 5, 7]))
+        min_width = max(5, height + 1)
+        width = int(_RNG.integers(min_width, min_width + 4))
