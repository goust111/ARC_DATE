+def _has_vertical_axis(coords) -> bool:
+    pts = set(coords)
+    _, c0, _, c1 = _bbox_from_coords(coords)
+    total = c0 + c1
+    return all((int(r), int(total - c)) in pts for r, c in pts)
+
