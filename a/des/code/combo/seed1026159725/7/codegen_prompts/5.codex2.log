+def _gen_diagonal_mask() -> np.ndarray:
+    for _ in range(200):
+        side = int(_RNG.integers(4, 8))
+        mask = np.zeros((side, side), dtype=bool)
+        for i in range(side):
+            mask[i, i] = True
+        for i in range(side - 1):
+            mask[i, i + 1] = True
+            mask[i + 1, i] = True
