+
+
+def _gen_vertical_mask() -> np.ndarray:
+    for _ in range(200):
+        width = int(_RNG.choice([3, 5, 7]))
+        min_height = max(5, width + 1)
+        height = int(_RNG.integers(min_height, min_height + 4))
+        center = width // 2
+        mask = np.zeros((height, width), dtype=bool)
+        mask[:, center] = True
