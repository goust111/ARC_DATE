    ((0, 4), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag
    ((4, 0), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag
]
_LBEND_CONFIGS = [
