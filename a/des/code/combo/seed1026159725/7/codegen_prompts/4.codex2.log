+        return None
+    for _ in range(MASK_RETRIES):
+        area = random.randint(area_lo, area_hi)
+        mask = _grow_connected_mask(h, w, area)
+        inv = ~mask
+        if mask.sum() != area:
+            continue
+        if not _is_connected(mask):
