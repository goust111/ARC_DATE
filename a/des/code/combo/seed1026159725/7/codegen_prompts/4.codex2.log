+    occupied = np.zeros((H, W), dtype=bool)
+
+    placements: list[dict] = []
+    order = list(range(pair_count))
+    random.shuffle(order)
+    order.sort(key=lambda idx: -(pair_specs[idx]["full_h"] * pair_specs[idx]["full_w"]))
+    for idx in order:
