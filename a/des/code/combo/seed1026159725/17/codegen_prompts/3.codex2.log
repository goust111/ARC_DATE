+                    "coords": coords,
+                    "sprite": sprite,
+                    "bbox": (r0, c0, r1, c1),
+                    "bbox_area": int(sprite.shape[0] * sprite.shape[1]),
+                    "pixel_area": int(coords.shape[0]),
+                }
+            )
+    return objects
+
+
+def _center_offsets(outer_shape: tuple[int, int], inner_shape: tuple[int, int]) -> tuple[int, int]:
+    oh, ow = outer_shape
+    ih, iw = inner_shape
+    return (oh - ih) // 2, (ow - iw) // 2
+
+
