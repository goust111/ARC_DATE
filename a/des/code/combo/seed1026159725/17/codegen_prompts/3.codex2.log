+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                        frontier.append((rr, cc))
+                        break
+        if not frontier:
+            break
+        rr, cc = frontier[int(rng.integers(len(frontier)))]
+        mask[rr, cc] = True
+    return mask
