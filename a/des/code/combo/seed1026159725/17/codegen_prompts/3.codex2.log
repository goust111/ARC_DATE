+    largest_h, largest_w = ordered[0]["sprite"].shape
+    layers = len(ordered) - 1
+    out_h = largest_h + 2 * layers
+    out_w = largest_w + 2 * layers
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    for obj in ordered:
+        _paste_sprite(out, obj["sprite"], bg)
+    return out
