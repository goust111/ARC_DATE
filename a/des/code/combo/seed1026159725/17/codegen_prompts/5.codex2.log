N3_LEFT_PEAK_RIGHT_RANGE, N3_LEFT_END_LEFT_RANGE = (5, 7), (1, 4)
N3_RIGHT_PEAK_LEFT_RANGE = (0, 2)
N3_RIGHT_END_LEFT_CAP, N3_RIGHT_END_RIGHT_CAP = 4, 6
N2_END_LEFT_RANGE, N2_END_RIGHT_RANGE = (0, 3), (4, 7)

