+def _extend_run(
+    path: list[Coord],
+    used: set[Coord],
+    direction: Coord,
+    steps: int,
+    shape: tuple[int, int],
+) -> tuple[list[Coord], set[Coord]] | None:
+    h, w = shape
+    dr, dc = direction
