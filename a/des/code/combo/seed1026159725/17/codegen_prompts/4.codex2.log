+            found = search(run_idx + 1, direction, extended[0], extended[1])
+            if found is not None:
+                return found
+        return None
+
+    for start in starts[:START_TRIALS]:
+        found = search(0, None, [start], {start})
+        if found is not None:
+            return found
+    return None
+
+
