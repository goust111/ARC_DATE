+def _turn_dirs(direction: Coord) -> tuple[Coord, Coord]:
+    dr, dc = direction
+    return (-dc, dr), (dc, -dr)
+
+
+def _direction_order(previous: Coord | None) -> list[Coord]:
+    if previous is None:
+        dirs = list(CARDINAL_DIRS)
+        random.shuffle(dirs)
+        return dirs
+    left, right = _turn_dirs(previous)
+    dirs = [previous, left, right]
+    random.shuffle(dirs)
+    return dirs
+
