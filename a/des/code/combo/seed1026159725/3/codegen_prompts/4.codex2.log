    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    moves = _rectangle_moves(g, bg)

    out = g.copy()
    for r0, c0, r1, c1, _color, _dr, _dc in moves:
        out[r0 : r1 + 1, c0 : c1 + 1] = bg

    occupied = np.zeros_like(g, dtype=bool)
    for r0, c0, r1, c1, color, dr, dc in moves:
        tr0, tr1 = r0 + dr, r1 + dr
