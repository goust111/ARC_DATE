+    if row_candidates:
+        r = row_candidates[0]
+        return 0, r, int(grid[r, 0])
+    c = col_candidates[0]
+    return 1, c, int(grid[0, c])
+
+
+def _reflect_fragment(coords: np.ndarray, flip_axis: int) -> np.ndarray:
