+            union = anchor_set | shifted_set
+            union_arr = np.array(list(union), dtype=int)
+            r0, c0, r1, c1 = _bbox(union_arr)
+            if (r1 - r0 + 1) * (c1 - c0 + 1) != len(union):
+                continue
+            candidates.append(shifted)
+    if len(candidates) != 1:
+        return None
+    return candidates[0]
