+    expected = grid.copy()
+    for side_index, placements in enumerate([place0, place1]):
+        row_off, col_off = offsets[side_index]
+        for info in placements:
+            color = info["color"]
+            top = row_off + info["top"]
+            left = col_off + info["left"]
+            if info["role"] == "fragment":
