+        return [(r, 0) for r in range(h)]
+    return [(r, w - 1) for r in range(h)]
+
+
+def _generate_missing_mask(rect_h: int, rect_w: int, flip_axis: int) -> np.ndarray | None:
+    max_missing = max(2, min(rect_h * rect_w - 3, rect_h * rect_w // 3 + 1))
+    for _ in range(100):
