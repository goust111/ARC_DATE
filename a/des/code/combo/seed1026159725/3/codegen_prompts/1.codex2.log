+    cells = np.argwhere(mask)
+    if len(cells) == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    seen = {start}
+    queue = deque([start])
+    h, w = mask.shape
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
