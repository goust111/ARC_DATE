    visited=set(); segs=[]
    def edge(a,b): return tuple(sorted((a,b)))
    for p in verts:
        for q in nbrs[p]:
            e=edge(p,q)
            if e in visited: continue
            pts=[p]; prev=p; cur=q; visited.add(e)
            while True:
                pts.append(cur)
                if not straight(cur): break
                dr=cur[0]-prev[0]; dc=cur[1]-prev[1]
                nxt=(cur[0]+dr,cur[1]+dc)
                e2=edge(cur,nxt)
                if nxt not in fg or e2 in visited: break
                visited.add(e2)
                prev,cur=cur,nxt
            segs.append(pts)
    return segs

def count(g):
