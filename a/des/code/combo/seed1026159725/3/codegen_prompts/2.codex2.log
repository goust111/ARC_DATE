        r1 = min(h, top + ph + RECT_PAD)
        c1 = min(w, left + pw + RECT_PAD)
        blocked[r0:r1, c0:c1] = True
        return True
    return False


def _valid_generated_grid(grid: np.ndarray, expected_counts: list[int], bg: int) -> bool:
