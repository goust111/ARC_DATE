+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+FILL_BY_SIDES = {3: 2, 4: 1, 5: 3}
+LINE_COLOR = 5
+BG_CHOICES = (0, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 32)
+GRID_W_RANGE = (18, 32)
+POLY_COUNT_CHOICES = (1, 2, 3, 4)
+POLY_COUNT_WEIGHTS = (2, 3, 3, 2)
