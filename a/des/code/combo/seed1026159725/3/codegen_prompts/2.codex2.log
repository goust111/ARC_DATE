+PLACEMENT_RETRIES = 120
+GEN_RETRIES = 400
+RECT_PAD = 2
+
+POLYGON_TEMPLATES: dict[int, list[tuple[list[tuple[int, int]], int, int]]] = {
+    3: [
+        ([(0, 0), (0, 4), (2, 2)], 2, 4),
+        ([(0, 0), (4, 0), (2, 2)], 2, 4),
+        ([(0, 2), (2, 0), (2, 4)], 2, 4),
+    ],
+    4: [
+        ([(0, 0), (0, 4), (3, 4), (3, 0)], 1, 4),
+        ([(0, 2), (2, 4), (4, 2), (2, 0)], 1, 4),
+        ([(0, 0), (0, 4), (2, 6), (2, 2)], 2, 4),
+    ],
+    5: [
+        ([(0, 2), (2, 4), (4, 4), (4, 0), (2, 0)], 1, 4),
+        ([(0, 0), (0, 4), (2, 6), (4, 4), (4, 0)], 1, 4),
+    ],
+}
+
