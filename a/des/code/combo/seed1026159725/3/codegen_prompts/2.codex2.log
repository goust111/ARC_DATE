import numpy as np
DIRS4=[(-1,0),(1,0),(0,-1),(0,1)]
DIAGS=[(-1,-1),(-1,1),(1,-1),(1,1)]

def make_neighbors(mask):
    h,w=mask.shape
    fg={(int(r),int(c)) for r,c in np.argwhere(mask)}
    nbrs={p:[] for p in fg}
    for r,c in fg:
        for dr,dc in DIRS4:
            q=(r+dr,c+dc)
            if q in fg:
                nbrs[(r,c)].append(q)
        for dr,dc in DIAGS:
            nr,nc=r+dr,c+dc
            q=(nr,nc)
            if q not in fg:
                continue
            if 0<=r+dr<h and 0<=c<w and 0<=r<h and 0<=c+dc<w:
                if mask[r+dr,c] or mask[r,c+dc]:
                    continue
            nbrs[(r,c)].append(q)
    return fg,nbrs

def comps(mask,conn=4):
    h,w=mask.shape
    vis=np.zeros((h,w),bool)
    ds=DIRS4 if conn==4 else DIRS4+DIAGS
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or vis[r,c]: continue
            st=[(r,c)]; vis[r,c]=1; cur=[]
            while st:
                x,y=st.pop(); cur.append((x,y))
                for dx,dy in ds:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not vis[nx,ny]:
                        vis[nx,ny]=1; st.append((nx,ny))
            out.append(cur)
    return out

def draw(vertices):
    pts=set(); n=len(vertices)
    for i in range(n):
        r0,c0=vertices[i]; r1,c1=vertices[(i+1)%n]
        dr=(r1>r0)-(r1<r0); dc=(c1>c0)-(c1<c0)
        steps=max(abs(r1-r0),abs(c1-c0))
        assert abs(r1-r0)==0 or abs(c1-c0)==0 or abs(r1-r0)==abs(c1-c0)
        for k in range(steps+1): pts.add((r0+dr*k,c0+dc*k))
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    h=max(rs)-min(rs)+3; w=max(cs)-min(cs)+3
    arr=np.zeros((h,w),dtype=int); ro=1-min(rs); co=1-min(cs)
    for r,c in pts: arr[r+ro,c+co]=1
    return arr

def segments(g):
    fg,nbrs=make_neighbors(g==1)
    def straight(p):
        ds=[(q[0]-p[0],q[1]-p[1]) for q in nbrs[p]]
        return len(ds)==2 and ds[0][0]==-ds[1][0] and ds[0][1]==-ds[1][1]
    verts=[p for p in fg if not straight(p)]
    print('nbr sample', {p:nbrs[p] for p in sorted(list(fg))[:10]})
