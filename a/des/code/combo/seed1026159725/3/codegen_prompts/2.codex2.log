    if actual_counts != sorted(expected_counts):
        return False

    out = main(grid)
    if not np.array_equal(out[grid == LINE_COLOR], grid[grid == LINE_COLOR]):
        return False

    for region in regions:
        fill = FILL_BY_SIDES[_region_side_count(region)]
        for r, c in region:
            if int(out[r, c]) != fill:
                return False

    return True


