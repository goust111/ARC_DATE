        for k in range(steps+1): pts.add((r0+dr*k,c0+dc*k))
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    h=max(rs)-min(rs)+3; w=max(cs)-min(cs)+3
    arr=np.zeros((h,w),dtype=int); ro=1-min(rs); co=1-min(cs)
    for r,c in pts: arr[r+ro,c+co]=1
    return arr

DIR4=[(-1,0),(1,0),(0,-1),(0,1)]
def comps(mask):
    h,w=mask.shape; vis=np.zeros((h,w),bool); out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or vis[r,c]: continue
