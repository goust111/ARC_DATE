+        (0, 2): int(np.sum(masks[0] & masks[2])),
+        (1, 2): int(np.sum(masks[1] & masks[2])),
+    }
+    triple = int(np.sum(bits == 7))
+    return exclusives, pair_only, pair_any, triple
