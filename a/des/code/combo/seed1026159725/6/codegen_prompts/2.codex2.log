+
+    exclusives = [int(np.sum(bits == (1 << i))) for i in range(3)]
+    pair_only = {
+        (0, 1): int(np.sum(bits == 3)),
+        (0, 2): int(np.sum(bits == 5)),
+        (1, 2): int(np.sum(bits == 6)),
+    }
+    pair_any = {
