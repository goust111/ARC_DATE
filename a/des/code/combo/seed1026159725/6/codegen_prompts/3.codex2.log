+        canvas = np.zeros((outer_h + 4, outer_w + 4), dtype=bool)
+        canvas[2 : 2 + outer_h, 2 : 2 + outer_w] = True
+        canvas[2 + hole_r : 2 + hole_r + hole_h, 2 + hole_c : 2 + hole_c + hole_w] = False
+        for _ in range(rng.randint(0, 3)):
