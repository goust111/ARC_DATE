+
+
+def _grow_polyomino(rng: random.Random, min_area: int, max_area: int) -> np.ndarray | None:
+    target = rng.randint(min_area, max_area)
+    h = rng.randint(4, 8)
+    w = rng.randint(4, 8)
+    start = (rng.randrange(h), rng.randrange(w))
+    cells = {start}
+    for _ in range(target * 6):
