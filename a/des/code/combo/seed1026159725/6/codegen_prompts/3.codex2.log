+def _mask_has_hole(mask: np.ndarray) -> bool:
+    h, w = map(int, mask.shape)
+    open_mask = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if open_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
