+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+def _neighbors(connectivity: int) -> tuple[tuple[int, int], ...]:
+    if connectivity == 4:
+        return ((1, 0), (-1, 0), (0, 1), (0, -1))
