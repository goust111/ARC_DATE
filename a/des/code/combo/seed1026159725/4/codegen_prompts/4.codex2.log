+GEN_COLOR_POOL = [0, 4, 5, 6, 7, 8, 9]
+GRID_HEIGHT_RANGE = (15, 30)
+GRID_WIDTH_RANGE = (15, 30)
+GROUP_COUNT_CHOICES = [1, 2, 3, 4]
