+    bg: int,
+    groups: list[tuple[np.ndarray, list[tuple[tuple[int, int, int, int], int]]]],
+    placements: dict[int, tuple[int, int]],
+) -> tuple[np.ndarray, list[tuple[tuple[int, int, int, int], int]]]:
