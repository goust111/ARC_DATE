    patch = np.full((h + 2, w + 2), frame_color, dtype=int)
    patch[1:-1, 1:-1] = bg
    return patch


def _make_dashed_patch(inner: np.ndarray, frame_color: int, bg: int, phase: int) -> np.ndarray:
    h, w = inner.shape
    patch = np.full((h + 2, w + 2), bg, dtype=int)
    patch[1:-1, 1:-1] = inner
