+    h = random.randint(GRID_MIN, GRID_MAX)
+    w = random.randint(GRID_MIN, GRID_MAX)
+    bg = random.randrange(10)
+    pair_count = random.choice(PAIR_CHOICES)
+
+    palette = [c for c in range(10) if c != bg]
+    if len(palette) < pair_count + 2:
