+
+    if _get_bg(grid) != bg:
+        return None
+
+    parts = _components(grid != bg)
+    if len(parts) != 4:
+        return None
+
+    quadrant_names = set()
+    for coords in parts:
+        try:
+            corner, patch = _sprite_patch(grid, coords, bg)
+        except AssertionError:
+            return None
+        if patch.shape != (h, w):
+            return None
+        quadrant_names.add(corner)
+    if quadrant_names != set(_CORNERS):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
