/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/2.md:284:  "type": "symmetry/pattern",
/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/2.md:285:  "src": "sparse non-background marker pixels on one side of a full-row/full-column cross",
/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/2.md:286:  "dst": "their mirror positions across the cross row and cross column",
