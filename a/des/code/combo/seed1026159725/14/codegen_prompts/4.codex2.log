/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/2.md:317:  "src": "maroon marker pixels or segments adjacent to solid grey or pink 3x3 square objects",
/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/2.md:318:  "transform": "erase grey squares after stamping maroon into each touched near-edge cell; keep grey-adjacent markers in place; keep pink squares, remove pink-adjacent markers, and stamp their maroon cells onto the matching middle row or column of the pink square"
