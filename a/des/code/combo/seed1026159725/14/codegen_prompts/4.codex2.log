/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/1.md:293:  "type": "move_along_path",
/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/1.md:294:  "src": "4-connected objects in the moving color",
/home/lixinyu/snap/a/des/seed1026159725/14/codegen_prompts/1.md:295:  "path": "vertical downward path through background cells until the next step would hit blocked space or another moving object",
