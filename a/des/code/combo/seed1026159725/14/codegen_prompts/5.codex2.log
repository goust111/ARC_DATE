+    h, w = grid.shape
+    data_h = h - 1
+    kinds = ["pixel", "hline", "vline", "rect"]
+    kind = random.choice(kinds)
+
+    if kind == "pixel":
+        r = random.randint(1, h - 1)
+        c = random.randint(0, w - 1)
+    elif kind == "hline":
+        r = random.randint(1, h - 1)
+        c = random.randint(0, w - 2)
+    elif kind == "vline":
+        r = random.randint(1, h - min(2, data_h))
