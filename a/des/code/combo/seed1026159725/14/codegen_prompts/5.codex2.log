+    erase_cols = np.flatnonzero(template != template[0])
+    data = inp[1:]
+    return (
+        np.any(data[:, keep_cols] != bg)
+        and np.any(data[:, erase_cols] != bg)
+        and np.any(data[:, keep_cols] == bg)
+        and np.any(data[:, erase_cols] == bg)
