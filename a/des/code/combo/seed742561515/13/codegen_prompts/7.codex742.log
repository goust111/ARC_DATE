+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+SEED_COLORS = (RED, GREEN, BLUE, YELLOW)
+BORDER_COLORS = (5, 6, 7, 8, 9)
+
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
+INNER_H_RANGE = (2, 8)
+INNER_W_RANGE = (2, 10)
+PLACEMENT_RETRIES = 80
+GENERATION_RETRIES = 400
+
