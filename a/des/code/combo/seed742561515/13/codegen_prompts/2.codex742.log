+    out = g.copy()
+    original_foreground = g != BG
+    ray_mask = np.zeros_like(g, dtype=bool)
+    stats = {
+        "visited": 0,
+        "claimed": 0,
+        "blocked_by_arrow": 0,
+        "blocked_by_ray": 0,
+    }
+
+    for arrow in ordered_arrows:
+        r, c = arrow.head
+        dr, dc = arrow.direction
+        r += dr
+        c += dc
+        while 0 <= r < h and 0 <= c < w:
