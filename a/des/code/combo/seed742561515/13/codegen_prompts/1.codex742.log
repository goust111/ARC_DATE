+    order = sorted(range(len(patches)), key=lambda i: int(patches[i].shape[0] * patches[i].shape[1]), reverse=True)
+
+    for idx in order:
+        patch = patches[idx]
+        ph, pw = patch.shape
+        candidates = [
+            (r, c)
+            for r in range(h - ph + 1)
+            for c in range(w - pw + 1)
+            if _can_place(reserved, (int(ph), int(pw)), int(r), int(c))
