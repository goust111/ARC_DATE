+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(local, border))
+
+
+def _extract_keys(grid: np.ndarray) -> list[dict]:
