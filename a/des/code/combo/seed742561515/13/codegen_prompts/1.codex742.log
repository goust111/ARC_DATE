+
+def _place_patches(
+    patches: list[np.ndarray],
+) -> tuple[np.ndarray, list[tuple[int, int]]] | None:
+    h, w = _sample_grid_shape(patches)
+    grid = np.full((h, w), BG, dtype=int)
+    reserved = np.zeros((h, w), dtype=bool)
