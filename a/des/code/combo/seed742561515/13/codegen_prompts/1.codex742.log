+        color = colors.pop()
+        keys.append({"shape": _shape_from_coords(coords), "color": int(color)})
+    assert keys, "expected at least one grey frame"
+    return keys
+
+
+def _extract_lock_cavities(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
