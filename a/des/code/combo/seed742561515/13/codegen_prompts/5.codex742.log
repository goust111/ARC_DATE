    current: dict[int, int] = {}
    solutions: list[dict[int, int]] = []

    def search(i: int) -> None:
        if len(solutions) > 1:
            return
        if i == len(order):
            solutions.append(current.copy())
            return
        pi = order[i]
        for hi in candidates[pi]:
