+    split_r = int(info["split_r"])  # type: ignore[index]
+    split_c = int(info["split_c"])  # type: ignore[index]
+    if np.count_nonzero(grid[split_r] == sep) < grid.shape[1] - 4:
+        return False
+    if np.count_nonzero(grid[:, split_c] == sep) < grid.shape[0] - 4:
+        return False
+
