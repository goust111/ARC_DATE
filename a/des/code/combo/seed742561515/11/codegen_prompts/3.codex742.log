+    if quadrant == QUADRANT_TR:
+        return 1, split_r, split_c + 1, w - 1
+    if quadrant == QUADRANT_BL:
+        return split_r + 1, h - 1, 1, split_c
+    return split_r + 1, h - 1, split_c + 1, w - 1
+
+
+def _quadrant_mask(
+    quadrant: int,
+    split_r: int,
+    split_c: int,
+    h: int,
+    w: int,
