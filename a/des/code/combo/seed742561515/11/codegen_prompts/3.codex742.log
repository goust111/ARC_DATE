+    allowed_a = _quadrant_mask(qa, split_r, split_c, h, w) & ~blocked
+    allowed_b = _quadrant_mask(qb, split_r, split_c, h, w) & ~blocked
+    allowed_a[connector_a] = True
+    allowed_b[connector_b] = True
