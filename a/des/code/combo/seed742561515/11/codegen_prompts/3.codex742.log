+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+INTERFACES = ("top", "bottom", "left", "right")
+
+QUADRANT_TL = 0
+QUADRANT_TR = 1
+QUADRANT_BL = 2
+QUADRANT_BR = 3
+
+# --------------- solver ---------------
