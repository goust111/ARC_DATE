+def _random_bfs_path(start: tuple[int, int], goal: tuple[int, int], allowed: np.ndarray) -> list[tuple[int, int]] | None:
+    if not allowed[start] or not allowed[goal]:
+        return None
+
+    q = deque([start])
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    h, w = allowed.shape
+
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        dirs = list(DIRS4)
+        random.shuffle(dirs)
+        for dr, dc in dirs:
