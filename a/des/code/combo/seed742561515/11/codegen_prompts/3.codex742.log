+    gap_pos: int,
+    split_r: int,
+    split_c: int,
+) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
+    if interface == "top":
+        return (gap_pos, split_c), (gap_pos, split_c - 1), (gap_pos, split_c + 1)
+    if interface == "bottom":
+        return (gap_pos, split_c), (gap_pos, split_c - 1), (gap_pos, split_c + 1)
+    if interface == "left":
+        return (split_r, gap_pos), (split_r - 1, gap_pos), (split_r + 1, gap_pos)
+    return (split_r, gap_pos), (split_r - 1, gap_pos), (split_r + 1, gap_pos)
