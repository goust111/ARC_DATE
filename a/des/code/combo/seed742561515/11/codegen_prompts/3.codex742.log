+    for r, c in path:
+        blocked[r, c] = True
+        for dr, dc in DIRS4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                blocked[nr, nc] = True
+
