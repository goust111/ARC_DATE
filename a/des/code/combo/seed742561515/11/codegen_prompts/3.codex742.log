+            nc = cur[1] + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if not allowed[nr, nc] or nxt in prev:
+                continue
+            prev[nxt] = cur
+            q.append(nxt)
+
+    if goal not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _choose_endpoint(allowed: np.ndarray, connector: tuple[int, int]) -> tuple[int, int] | None:
+    candidates: list[tuple[int, int]] = []
+    h, w = allowed.shape
+    for r in range(h):
+        for c in range(w):
+            if not allowed[r, c]:
+                continue
+            dist = abs(r - connector[0]) + abs(c - connector[1])
+            if dist < 3:
+                continue
+            candidates.append((r, c))
+
+    random.shuffle(candidates)
+    if not candidates:
+        return None
+
+    candidates.sort(
+        key=lambda p: (
+            -abs(p[0] - connector[0]) - abs(p[1] - connector[1]),
+            int(p[0] == connector[0] or p[1] == connector[1]),
+        )
+    )
+    best_span = max(1, min(10, len(candidates)))
+    return candidates[random.randrange(best_span)]
+
+
+def _is_simple_chain(path: list[tuple[int, int]]) -> bool:
+    if len(path) < 2 or len(set(path)) != len(path):
+        return False
+    pts = set(path)
+    degrees = []
+    for r, c in path:
+        degree = 0
+        for dr, dc in DIRS4:
+            if (r + dr, c + dc) in pts:
+                degree += 1
+        degrees.append(degree)
+    return degrees.count(1) == 2 and all(deg <= 2 for deg in degrees)
+
+
+def _build_interface_path(
+    blocked: np.ndarray,
+    interface: str,
+    gap_pos: int,
+    split_r: int,
+    split_c: int,
+    h: int,
+    w: int,
