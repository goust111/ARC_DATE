    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)
    feasible = [(v, n_rects - v) for v in range(n_rects + 1)
                if v <= max_vert and (n_rects - v) <= max_horiz]
    if not feasible:
        return None
    return random.choice(feasible)


