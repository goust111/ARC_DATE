+import numpy as np
+
+
+_RNG = np.random.default_rng()
+_GEN_RETRIES = 400
+_SAMPLE_SIDE_OPTIONS = ("bottom", "right")
+_SAMPLE_DIM_OPTIONS = (
+    (1, 2),
+    (1, 3),
+    (2, 2),
+    (1, 5),
+    (2, 3),
+    (2, 4),
+    (3, 3),
+    (2, 5),
+    (3, 4),
+    (3, 5),
