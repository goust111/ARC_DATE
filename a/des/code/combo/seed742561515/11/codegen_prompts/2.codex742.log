+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [p[0] for p in points]
+    cols = [p[1] for p in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        coords.append((r, c1))
+    for c in range(c1 - 1, c0 - 1, -1):
+        coords.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        coords.append((r, c0))
+    return coords
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _tile_pattern(height: int, width: int, pattern: np.ndarray) -> np.ndarray:
+    ph, pw = pattern.shape
+    reps = ((height + ph - 1) // ph, (width + pw - 1) // pw)
+    tiled = np.tile(pattern, reps)
+    return tiled[:height, :width]
+
+
+def _find_fences_for_color(grid: np.ndarray, bg: int, color: int) -> list[dict]:
+    mask = grid == color
+    if not np.any(mask):
+        return []
+
+    dilated = _dilate4(mask)
+    fences: list[dict] = []
+    covered = np.zeros_like(mask, dtype=bool)
+
+    for comp in _components(dilated):
+        orig = [(r, c) for r, c in comp if mask[r, c]]
+        if not orig:
+            continue
+        r0, c0, r1, c1 = _bbox(orig)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            return []
