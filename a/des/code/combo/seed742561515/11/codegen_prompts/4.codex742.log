+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+def _mode_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _frame_bbox(component: np.ndarray) -> tuple[int, int, int, int] | None:
+    if component.size == 0:
+        return None
+    r0, c0 = component.min(axis=0)
+    r1, c1 = component.max(axis=0)
+    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    expected = 2 * (h + w) - 4
+    if int(component.shape[0]) != expected:
+        return None
+    for r, c in component:
+        rr = int(r)
+        cc = int(c)
+        if rr not in (r0, r1) and cc not in (c0, c1):
+            return None
+    return r0, c0, r1, c1
+
+
+def _detect_frames(grid: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int, int]]]:
+    frame_candidates: list[tuple[int, list[tuple[int, int, int, int]]]] = []
+    for color in np.unique(grid):
+        color = int(color)
