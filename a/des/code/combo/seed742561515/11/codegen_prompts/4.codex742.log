+        r0, c0 = random.choice(candidates)
+        _mark_occupied(occupied, r0, c0, outer_h, outer_w)
+        boxes.append((r0, c0, r0 + outer_h - 1, c0 + outer_w - 1))
+    return boxes
+
+
