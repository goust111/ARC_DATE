+        out[info["lock_coords"][:, 0], info["lock_coords"][:, 1]] = info["key_color"]
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    pair_count = random.randint(*PAIR_COUNT_RANGE)
