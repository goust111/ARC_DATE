+    base_side = max(
+        GRID_SIDE_RANGE[0],
+        int(np.ceil(np.sqrt(total_area) * 1.25)),
+        max(item["patch"].shape[0] for item in items) + 2 * OUTER_MARGIN,
+        max(item["patch"].shape[1] for item in items) + 2 * OUTER_MARGIN,
