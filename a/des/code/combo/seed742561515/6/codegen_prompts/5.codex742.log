+
+def _find_mix_table(grid: np.ndarray, bg: int) -> tuple[np.ndarray, dict[tuple[int, int], int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    non_bg = g != bg
+    candidates: list[tuple[int, int, list[tuple[int, int]]]] = []
+
