+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+PIPE = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
