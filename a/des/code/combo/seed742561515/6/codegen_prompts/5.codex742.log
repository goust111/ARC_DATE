+
+def _bfs_dist(traversable: np.ndarray, sources: list[tuple[int, int]]) -> np.ndarray:
+    h, w = traversable.shape
+    inf = h * w + 1
+    dist = np.full((h, w), inf, dtype=int)
+    q = deque()
+    for r, c in sources:
+        dist[r, c] = 0
+        q.append((r, c))
