+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(15, 22)
+    w = random.randint(18, 27)
+    _seed_colors, _mix_colors, rows = _table_height_and_pairs()
+    table_h = len(rows)
+
+    grid = np.full((h, w), BG, dtype=int)
+    for r, (a, b, mix) in enumerate(rows):
+        grid[r, w - 3] = a
+        grid[r, w - 2] = b
+        grid[r, w - 1] = mix
