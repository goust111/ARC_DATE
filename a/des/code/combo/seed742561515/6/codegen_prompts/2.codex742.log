+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray | None, tuple[int, int] | None]:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return None, None
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (int(r0), int(c0))
+
+
