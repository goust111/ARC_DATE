+            ac = random.randint(0, W - aw)
+            if _can_place(reserved, ar, ac, ah, aw, pad=1):
+                anchor_pos = (ar, ac)
+                _reserve(reserved, ar, ac, ah, aw, pad=1)
+                break
+        if anchor_pos is None:
+            return None
+
+        filler_pos = None
+        for _ in range(PLACEMENT_RETRIES):
