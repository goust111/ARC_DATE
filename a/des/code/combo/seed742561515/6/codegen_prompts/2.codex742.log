+def _read_lookup(grid: np.ndarray, comp: dict, bg: int) -> dict[frozenset[int], int]:
+    r0, c0, r1, c1 = comp["bbox"]
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert patch.shape[1] == 3
+    assert np.all(patch != bg)
