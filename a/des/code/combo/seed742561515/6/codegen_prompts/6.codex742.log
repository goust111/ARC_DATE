+        (arrow_r - 1, arrow_c + 1),
+        (arrow_r + 2, arrow_c),
+        (arrow_r + 2, arrow_c + 1),
+        (arrow_r, arrow_c - 1),
+        (arrow_r + 1, arrow_c - 1),
+        (arrow_r, arrow_c + 2),
+        (arrow_r + 1, arrow_c + 2),
