+        for target in side_targets.values():
+            best_dist = min(abs(r - target[0]) + abs(c - target[1]) for r, c in cells)
+            starts = [cell for cell in cells if abs(cell[0] - target[0]) + abs(cell[1] - target[1]) == best_dist]
