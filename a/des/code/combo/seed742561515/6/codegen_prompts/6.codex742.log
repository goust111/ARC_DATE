+def _touching_sides(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> list[str]:
+    r0, c0, r1, c1 = bbox
+    h, w = shape
+    touched = []
+    if r0 == 0:
+        touched.append("top")
+    if c1 == w - 1:
+        touched.append("right")
+    if r1 == h - 1:
+        touched.append("bottom")
+    if c0 == 0:
+        touched.append("left")
+    assert touched, "every object bbox must touch at least one grid side"
+    return touched
