+        "top": (0, w // 2),
+        "right": (h // 2, w - 1),
+        "bottom": (h - 1, w // 2),
+        "left": (h // 2, 0),
+    }
+    assert len(set(positions.values())) == 4, "edge marker positions must be distinct"
+    return positions
