+def _monotone_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    out = [(r, c)]
+    while (r, c) != end:
+        moves = []
+        if r < end[0]:
+            moves.append((1, 0))
+        elif r > end[0]:
