+def _candidate_bboxes(contact: str, hh: int, ww: int, h: int, w: int) -> list[tuple[int, int, int, int]]:
+    mid_r = h // 2
+    mid_c = w // 2
+    bboxes: list[tuple[int, int, int, int]] = []
