+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        if not bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
