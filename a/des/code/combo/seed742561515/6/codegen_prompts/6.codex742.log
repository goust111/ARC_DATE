+        if min_area > max_area:
+            max_area = min(h * w - 1, len(cells) + max(1, (h * w) // 8))
+            min_area = min(len(cells) + 1, max_area)
+        if min_area <= max_area:
+            _grow_mask(cells, h, w, random.randint(min_area, max_area))
