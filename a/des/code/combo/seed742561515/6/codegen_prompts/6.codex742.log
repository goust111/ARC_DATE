+    target = canvas[r0 : r1 + 1, c0 : c1 + 1]
+    assert not bool(np.any((target != BG) & (patch != BG)))
+    canvas[r0 : r1 + 1, c0 : c1 + 1][patch != BG] = patch[patch != BG]
