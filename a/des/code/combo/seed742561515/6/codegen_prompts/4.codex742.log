+    labels = np.zeros((h, w), dtype=int)
+    comps: list[list[tuple[int, int]]] = []
+    next_id = 0
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if not bool(mask[r0, c0]) or int(labels[r0, c0]) != 0:
+                continue
+            next_id += 1
+            stack = [(int(r0), int(c0))]
+            labels[r0, c0] = next_id
+            comp: list[tuple[int, int]] = []
+            while stack:
