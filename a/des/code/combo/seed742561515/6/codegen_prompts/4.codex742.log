+        return False
+    if any(len(region_holes) > k for region_holes in holes.values()):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        k = random.randint(*PALETTE_K_RANGE)
