+def _tile_to_shape(pattern: np.ndarray, height: int, width: int) -> np.ndarray:
+    ph, pw = pattern.shape
+    reps_r = (height + ph - 1) // ph
+    reps_c = (width + pw - 1) // pw
+    tiled = np.tile(pattern, (reps_r, reps_c))
+    return tiled[:height, :width]
