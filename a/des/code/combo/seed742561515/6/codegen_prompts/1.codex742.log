+    elif kind == "vstripe":
+        mask = cc % 2 == 0
+    elif kind == "hstripe":
+        mask = rr % 2 == 0
+    elif kind == "dots":
+        mask = (rr % 2 == 0) & (cc % 2 == 0)
+    elif kind == "plus":
+        mask = (rr == h // 2) | (cc == w // 2)
+    elif kind == "diag":
+        mask = (rr - cc) % 3 == 0
+    elif kind == "blocks":
+        mask = ((rr // 2) + (cc // 2)) % 2 == 0
+    else:
+        raise ValueError(f"unknown pattern {kind}")
