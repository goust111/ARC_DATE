+                color = BLUE
+            else:
+                next_dir = (1, 0)
+                color = RED
+            turns.append(
+                {
+                    "orientation": "horizontal",
+                    "turn_at": (int(r), int(c)),
+                    "color": int(color),
+                    "next_dir": (int(next_dir[0]), int(next_dir[1])),
+                }
+            )
+            direction = next_dir
+            continue
+
+        y = int(rows[row_idx])
+        row_idx += 1
+        extend_to(y, c)
+        if turn_idx == turn_count - 1:
+            next_dir = (0, -1)
+            color = RED
+        else:
+            next_dir = (0, 1)
+            color = BLUE
+        turns.append(
+            {
+                "orientation": "vertical",
+                "turn_at": (int(r), int(c)),
