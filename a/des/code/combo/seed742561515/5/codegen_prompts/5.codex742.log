+        nonlocal r, c
+        step_r = 0 if target_r == r else (1 if target_r > r else -1)
+        step_c = 0 if target_c == c else (1 if target_c > c else -1)
+        while (r, c) != (target_r, target_c):
+            r += step_r
+            c += step_c
+            path.append((int(r), int(c)))
+
