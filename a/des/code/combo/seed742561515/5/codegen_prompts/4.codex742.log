+    safe_w = ic1 - ic0 - 3
+    if safe_h < 2 or safe_w < 2:
+        return None
+
+    for _ in range(80):
+        patch_h = int(rng.integers(2, min(5, safe_h) + 1))
+        patch_w = int(rng.integers(2, min(5, safe_w) + 1))
+        max_area = min(7, patch_h * patch_w - 1)
