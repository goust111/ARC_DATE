+    specs.sort(key=lambda spec: spec["room_h"] * spec["room_w"], reverse=True)
+    placements = []
+    for spec in specs:
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            top = rng.randint(1, h - spec["room_h"] - 1)
+            left = rng.randint(1, w - spec["room_w"] - 1)
