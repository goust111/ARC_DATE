+        g[tooth_r, stem_c0 + tooth_index] = color
+    else:
+        stem_r0 = rng.randint(ir0, ir1 - 2)
+        if direction == "left":
+            stem_c = rng.randint(ic0 + 1, ic1)
+            tooth_c = stem_c - 1
+        else:
+            stem_c = rng.randint(ic0, ic1 - 1)
+            tooth_c = stem_c + 1
