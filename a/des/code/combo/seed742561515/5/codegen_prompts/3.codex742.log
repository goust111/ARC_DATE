+            assert dist_left != dist_right, "straight key direction is ambiguous"
+            direction = "left" if dist_left < dist_right else "right"
+        wall_col = wc0 if direction == "left" else wc1
+        door = [(r, wall_col) for r in rows_sorted]
+
+    return {
+        "color": color,
