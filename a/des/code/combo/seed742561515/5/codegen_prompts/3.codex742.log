+        rooms.append(
+            {
+                "interior_bbox": (ir0, ic0, ir1, ic1),
+                "wall_bbox": (wr0, wc0, wr1, wc1),
+            }
+        )
+
+    rooms.sort(key=lambda room: room["wall_bbox"])
+    assert rooms, "expected at least one blue room"
+    return rooms
+
+
+def _longest_segment(coords: list[tuple[int, int]]) -> dict:
