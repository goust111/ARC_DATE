+                "room_h": _rand_int(rng, ROOM_H_RANGE),
+                "room_w": _rand_int(rng, ROOM_W_RANGE),
+                "direction": rng.choice(["up", "down", "left", "right"]),
+                "tooth_index": rng.choice([0, 1, 2]),
