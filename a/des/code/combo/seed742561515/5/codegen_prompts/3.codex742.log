+    stem = _longest_segment(key_coords)
+    stem_coords = stem["coords"]
+    stem_set = set(stem_coords)
+    extras = [coord for coord in key_coords if coord not in stem_set]
+    ir0, ic0, ir1, ic1 = room["interior_bbox"]
