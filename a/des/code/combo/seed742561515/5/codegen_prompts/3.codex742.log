+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+
+DIR_TO_DELTA = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+KEY_COLORS = [2, 3, 4, 5, 6, 7, 8, 9]
+
+# --------------- core helpers ---------------
+
