+        stem_c0 = rng.randint(ic0, ic1 - 2)
+        if direction == "up":
+            stem_r = rng.randint(ir0 + 1, ir1)
+            tooth_r = stem_r - 1
+        else:
+            stem_r = rng.randint(ir0, ir1 - 1)
+            tooth_r = stem_r + 1
