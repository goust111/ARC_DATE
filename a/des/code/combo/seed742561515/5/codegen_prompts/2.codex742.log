+        if side == "left":
+            max_gap = final_left - width
+            if max_gap < 2:
+                return None
+            gap = rng.randint(2, min(4, max_gap))
+            init_left = final_left - gap - width
+        else:
+            max_gap = w - (c1 + width + 1)
+            if max_gap < 2:
+                return None
