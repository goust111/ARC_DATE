+def _piece_mask(side: str, height: int, width: int, offset: int, depth: int) -> np.ndarray:
+    mask = np.ones((height, width), dtype=bool)
+    if side == "top":
+        mask[1 : depth + 1, offset] = False
+    elif side == "bottom":
+        mask[height - depth - 1 : height - 1, offset] = False
+    elif side == "left":
