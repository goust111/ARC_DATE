+            break
+        if not placed:
+            return None
+
+    pegs = _pick_pegs(rng, frame_bbox, selected_specs, final_piece_cells)
+    if not pegs:
+        return None
+
+    frame_grid = _draw_frame((h, w), frame_bbox, pegs)
+    all_peg_cells: set[tuple[int, int]] = set()
+    for peg in pegs:
