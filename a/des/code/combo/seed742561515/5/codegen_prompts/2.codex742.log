+    frame_w = rng.randint(8, 10)
+    r0 = rng.randint(7, h - frame_h - 7)
+    c0 = rng.randint(7, w - frame_w - 7)
+    frame_bbox = (r0, c0, r0 + frame_h - 1, c0 + frame_w - 1)
