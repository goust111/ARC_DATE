+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SIDES = ("top", "bottom", "left", "right")
+SIDE_TO_MOVE = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+MOVE_TO_SIDE = {v: k for k, v in SIDE_TO_MOVE.items()}
+ARROW_SHAPES = {
+    (-1, 0): {(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)},
+    (1, 0): {(0, 1), (1, 1), (2, 0), (2, 1), (2, 2)},
+    (0, -1): {(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)},
+    (0, 1): {(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)},
+}
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _coords_to_mask(coords: np.ndarray) -> tuple[int, int, np.ndarray]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return r0, c0, mask
+
+
+def _match_arrow(mask: np.ndarray) -> tuple[int, int] | None:
+    if mask.shape != (3, 3):
+        return None
+    pts = {tuple(map(int, p)) for p in np.argwhere(mask)}
+    for move, shape in ARROW_SHAPES.items():
+        if pts == shape:
+            return move
+    return None
+
+
+def _frame_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(grid == FRAME)
+    assert len(pts) > 0
+    r0 = int(pts[:, 0].min())
+    c0 = int(pts[:, 1].min())
+    r1 = int(pts[:, 0].max())
+    c1 = int(pts[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _extract_pegs(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> list[dict[str, int | str]]:
+    r0, c0, r1, c1 = frame_bbox
+    inner = np.zeros_like(grid, dtype=bool)
+    inner[r0 + 1 : r1, c0 + 1 : c1] = grid[r0 + 1 : r1, c0 + 1 : c1] == FRAME
+    pegs: list[dict[str, int | str]] = []
+    for comp in _components(inner):
+        rows = comp[:, 0]
+        cols = comp[:, 1]
+        if int(cols.min()) == int(cols.max()) and int(rows.min()) == r0 + 1:
+            pegs.append({"side": "top", "anchor": int(cols[0]), "depth": int(rows.max() - r0)})
+            continue
+        if int(cols.min()) == int(cols.max()) and int(rows.max()) == r1 - 1:
+            pegs.append({"side": "bottom", "anchor": int(cols[0]), "depth": int(r1 - rows.min())})
+            continue
+        if int(rows.min()) == int(rows.max()) and int(cols.min()) == c0 + 1:
+            pegs.append({"side": "left", "anchor": int(rows[0]), "depth": int(cols.max() - c0)})
+            continue
+        if int(rows.min()) == int(rows.max()) and int(cols.max()) == c1 - 1:
