+            spec["color"] = color
+            specs.append(spec)
+            selected_specs[side] = spec
+            final_piece_cells |= final_cells
+            initial_occ |= init_cells
+            matched_peg_cells |= peg_cells
+            placed = True
+            break
+        if not placed:
+            return None
+
+    pegs = _pick_pegs(rng, frame_bbox, selected_specs, final_piece_cells)
+    if not pegs:
