+    tri_c = random.randint(0, inner_w - 2)
+    triangle = _triangle_cells(direction, tri_r, tri_c)
+
+    candidates = [
+        (r, c)
+        for r in range(inner_h)
+        for c in range(inner_w)
+        if (r, c) not in triangle and _chebyshev_far_enough((r, c), triangle)
