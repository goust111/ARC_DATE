+    r0, c0, r1, c1 = bbox
+    h, w = shape
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+
+    if direction == "up":
+        rr, cc = r0 - 1, mid_c
+    elif direction == "down":
+        rr, cc = r1 + 1, mid_c
+    elif direction == "left":
