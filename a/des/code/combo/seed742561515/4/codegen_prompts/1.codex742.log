+GRID_H_RANGE = (14, 25)
+GRID_W_RANGE = (14, 25)
+OUTER_SIZE_OPTIONS = (5, 7, 9)
+MAX_RECTANGLES = 4
+PLACEMENT_ATTEMPTS = 160
+GEN_RETRIES = 300
