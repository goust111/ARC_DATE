+    coords: np.ndarray,
+    bbox: tuple[int, int, int, int],
+) -> bool:
+    r0, c0, r1, c1 = bbox
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height < 4 or width < 4:
+        return False
+    if coords.shape[0] != 2 * height + 2 * width - 4:
