+def _triangle_cells(direction: str, top: int, left: int) -> list[tuple[int, int]]:
+    pattern = TRIANGLE_PATTERNS[direction]
+    cells: list[tuple[int, int]] = []
+    for dr in range(2):
+        for dc in range(2):
+            if pattern[dr, dc]:
