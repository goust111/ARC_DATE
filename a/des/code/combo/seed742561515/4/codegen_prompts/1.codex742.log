+def _draw_expected(grid: np.ndarray, objects: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for obj in objects:
+        for rr, cc in obj["ray_cells"]:
+            out[rr, cc] = obj["color"]
+    return out
+
