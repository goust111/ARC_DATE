+    out = g.copy()
+    rectangles: list[tuple[int, int, int, int]] = []
+    for coords in _components4(g == GREY):
+        bbox = _bbox(coords)
+        if _is_grey_rectangle(g, coords, bbox):
+            rectangles.append(bbox)
