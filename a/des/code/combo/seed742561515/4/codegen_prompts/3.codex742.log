+
+
+def _build_graph(variant: str, rows: int, cols: int):
+    if variant == "path":
+        return _build_path_graph(rows, cols)
+    if variant == "t":
+        return _build_t_graph(rows, cols)
+    if variant == "cross":
+        return _build_cross_graph(rows, cols)
+    return _build_mixed_graph(rows, cols)
