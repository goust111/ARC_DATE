+        if _is_tree(graph) and len(_leaves(graph)) == 3 and _has_degree(graph, 3):
+            return graph
+    return None
+
+
+def _build_cross_graph(rows: int, cols: int) -> dict[tuple[int, int], set[tuple[int, int]]] | None:
