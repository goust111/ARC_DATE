+        if not branched:
+            continue
+
+        for d, leaf in arms.items():
+            if d == trunk_dir:
+                continue
+            _extend_from_leaf(
+                graph,
+                leaf,
+                random.randint(0, 2),
+                rows,
+                cols,
+                prefer_turn=(random.random() < 0.4),
