+
+BG = 0
+MARKER = 4  # yellow
+OBJECT_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+SIDES = ("left", "right", "up", "down")
+
+GRID_MIN = 14
+GRID_MAX = 24
+K_MIN = 2
+K_MAX = 5
+OBJECT_COUNT_MIN = 1
+OBJECT_COUNT_MAX = 4
+POLYOMINO_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 180
+GEN_MAX_ATTEMPTS = 400
+CLIP_PROB = 0.35
+MAX_TEMPLATE_DIM = 5
