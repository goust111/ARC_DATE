+            clipped_r1 = min(h - 1, r0 + h_obj * k - 1)
+            clipped_c1 = min(w - 1, c0 + w_obj * k - 1)
+            output_rect = _expanded_rect(r0, c0, clipped_r1, clipped_c1, h, w, pad=1)
