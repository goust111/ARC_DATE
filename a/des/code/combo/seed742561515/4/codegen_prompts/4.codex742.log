+    row_clip_possible = row_clip_lo <= r_max and col_safe_hi >= c_min
+    col_clip_possible = col_clip_lo <= c_max and row_safe_hi >= r_min
+    both_clip_possible = row_clip_lo <= r_max and col_clip_lo <= c_max
