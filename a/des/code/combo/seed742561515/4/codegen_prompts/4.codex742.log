+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 4  # yellow
+OBJECT_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+SIDES = ("left", "right", "up", "down")
+
+GRID_MIN = 14
+GRID_MAX = 24
+K_MIN = 2
+K_MAX = 5
+OBJECT_COUNT_MIN = 1
+OBJECT_COUNT_MAX = 4
