+        cells = {seed}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= nr < canvas_h and 0 <= nc < canvas_w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != area:
+            continue
