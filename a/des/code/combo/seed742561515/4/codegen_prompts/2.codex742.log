+def _rect_clear(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = PLACEMENT_PAD) -> bool:
+    H, W = blocked.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
