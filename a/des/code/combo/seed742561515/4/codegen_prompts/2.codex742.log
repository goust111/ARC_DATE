+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _tight_mask(points: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(points)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _is_frame(points: list[tuple[int, int]], grid: np.ndarray, color: int) -> bool:
+    r0, c0, r1, c1 = _bbox(points)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    for r, c in points:
+        local[r - r0, c - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(local, border):
+        return False
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    return bool(np.all(interior == BG) and np.all(grid[r0 : r1 + 1, c0 : c1 + 1][border] == color))
