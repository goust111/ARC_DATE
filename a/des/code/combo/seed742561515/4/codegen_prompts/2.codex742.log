+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != area:
+            continue
+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        r0, c0, r1, c1 = min(rows), min(cols), max(rows), max(cols)
