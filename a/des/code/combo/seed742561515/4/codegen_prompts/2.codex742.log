+            D = -dr2
+            lo = max(0, _ceil_div(-(D - 1) - col_bias, 2))
+            hi = min(W - frag_w, ((D - 1) - col_bias) // 2)
+            for c0 in range(lo, hi + 1):
+                if _rect_clear(blocked, r0, c0, frag_h, frag_w):
