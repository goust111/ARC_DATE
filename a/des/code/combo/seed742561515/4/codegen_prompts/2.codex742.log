+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in cells:
+            mask[r - r0, c - c0] = True
+        return mask
+    raise RuntimeError("failed to sample a fragment shape")
+
+
+def _rect_clear(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = PLACEMENT_PAD) -> bool:
+    H, W = blocked.shape
