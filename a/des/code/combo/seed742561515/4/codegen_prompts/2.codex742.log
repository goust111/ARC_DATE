+def _sample_pair_specs() -> tuple[int, int, list[dict[str, object]]]:
+    n_pairs = random.randint(2, 4)
+    height = random.randint(16 + 3 * n_pairs, 20 + 3 * n_pairs)
+    width = random.randint(16 + 3 * n_pairs, 22 + 3 * n_pairs)
