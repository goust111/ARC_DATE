+        col = inner_c0 + inner_w - frag_w
+    elif source_direction == "right":
+        row = inner_r0 + (inner_h - frag_h) // 2
+        col = inner_c0
+    elif source_direction == "up":
+        row = inner_r0 + inner_h - frag_h
+        col = inner_c0 + (inner_w - frag_w) // 2
+    else:
+        row = inner_r0
+        col = inner_c0 + (inner_w - frag_w) // 2
+    return int(row), int(col)
