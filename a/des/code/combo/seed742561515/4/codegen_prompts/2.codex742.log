+    sr0, sc0, sr1, sc1 = fragment_bbox
+    dr2 = (sr0 + sr1) - (fr0 + fr1)
+    dc2 = (sc0 + sc1) - (fc0 + fc1)
+    if abs(dc2) >= abs(dr2):
+        return "left" if dc2 < 0 else "right"
+    return "up" if dr2 < 0 else "down"
