+    for spec in specs:
+        color = int(spec["color"])
+        direction = str(spec["direction"])
+        tie_case = bool(spec["tie_case"])
+        frag = np.asarray(spec["frag"], dtype=bool)
+        outer_h = int(spec["outer_h"])
+        outer_w = int(spec["outer_w"])
+        frag_h, frag_w = frag.shape
+
+        placements: list[tuple[tuple[int, int, int, int], list[tuple[int, int]]]] = []
+        for fr0 in range(0, H - outer_h + 1):
+            for fc0 in range(0, W - outer_w + 1):
+                if not _rect_clear(blocked, fr0, fc0, outer_h, outer_w):
+                    continue
+                frame_bbox = (fr0, fc0, fr0 + outer_h - 1, fc0 + outer_w - 1)
+                frag_positions = _fragment_candidates(blocked, frame_bbox, (frag_h, frag_w), direction, tie_case)
+                if frag_positions:
