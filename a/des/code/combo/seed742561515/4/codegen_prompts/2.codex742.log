+            if r0 + frag_h >= fr0:
+                continue
+            for c0 in range(0, W - frag_w + 1):
+                if not _rect_clear(blocked, r0, c0, frag_h, frag_w):
+                    continue
+                bbox = (r0, c0, r0 + frag_h - 1, c0 + frag_w - 1)
