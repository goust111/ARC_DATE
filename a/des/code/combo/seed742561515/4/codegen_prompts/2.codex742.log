+                    continue
+                bbox = (r0, c0, r0 + frag_h - 1, c0 + frag_w - 1)
+                if _direction_matches(bbox, frame_bbox, direction, tie_case):
+                    candidates.append((r0, c0))
+    elif direction == "up":
