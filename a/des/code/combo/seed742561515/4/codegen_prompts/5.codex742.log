DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures
MIN_COL_GAP = 1                   # minimum column gap between components
MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top

