+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+CYAN = 8
+MAROON = 9
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+TRANSFORM_NAMES = (
+    "id",
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_h",
+    "flip_v",
+    "diag_main",
+    "diag_anti",
+)
+TRANSFORM_BLOCKS = (
+    ("id", "rot90", "rot180"),
+    ("rot270", "flip_h", "flip_v"),
+    ("diag_main", "diag_anti"),
+)
+BORDER_COLOR_BY_TRANSFORM = {
+    "id": RED,
+    "rot90": BLUE,
+    "rot180": BLUE,
+    "rot270": BLUE,
+    "flip_h": GREEN,
+    "flip_v": GREEN,
+    "diag_main": ORANGE,
+    "diag_anti": ORANGE,
+}
+
+TOP_COLOR_POOL = (BLUE, RED, GREEN, YELLOW, PINK, ORANGE, CYAN)
+MIN_OBJECTS = 2
+MAX_OBJECTS = 4
+MIN_AREA = 4
+MAX_AREA = 8
+MAX_SHAPE_DIM = 4
+MAX_SHAPE_ATTEMPTS = 160
+MAX_GENERATION_ATTEMPTS = 400
