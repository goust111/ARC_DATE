+    top_height += int(_RNG.integers(0, 5))
+    bottom_height = max(max(int(mask.shape[0]) for mask in transformed_masks) + 2 * BOTTOM_SIDE_PAD, 6)
+    bottom_height += int(_RNG.integers(0, 5))
