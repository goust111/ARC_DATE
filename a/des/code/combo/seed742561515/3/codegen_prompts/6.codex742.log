+    max_colors_by_cells = 0
+    while (max_colors_by_cells + 1) * (max_colors_by_cells + 2) // 2 <= total_cells:
+        max_colors_by_cells += 1
+    max_colors = min(5, max_colors_by_width, max_colors_by_cells)
+    if max_colors < 3:
