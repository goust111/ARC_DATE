+def _cell_bounds(lengths: list[int]) -> tuple[list[tuple[int, int]], list[int]]:
+    bounds: list[tuple[int, int]] = []
+    lines: list[int] = []
+    cursor = 0
+    for i, size in enumerate(lengths):
+        start = cursor
+        end = start + size - 1
+        bounds.append((start, end))
+        cursor = end + 1
+        if i + 1 < len(lengths):
+            lines.append(cursor)
+            cursor += 1
