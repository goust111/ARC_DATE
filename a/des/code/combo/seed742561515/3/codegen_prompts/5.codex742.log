+def _path_to_center(
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> set[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    coords = {(r, c)}
+    while (r, c) != (er, ec):
+        options = []
+        if r < er:
+            options.append((r + 1, c))
+        elif r > er:
+            options.append((r - 1, c))
+        if c < ec:
