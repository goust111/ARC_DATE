+    for pair in pairs:
+        _stamp(inp, pair["source_mask"], pair["src_r0"], pair["src_c0"], pair["color"])
+        _stamp(inp, pair["arrow_mask"], pair["arrow_r0"], pair["arrow_c0"], pair["color"])
