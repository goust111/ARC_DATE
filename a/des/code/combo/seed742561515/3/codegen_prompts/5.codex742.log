+        r_start = max(h + 2, gap + 3)
+        r_stop = H - h
+        c_start = 0
+        c_stop = W - w
+    elif side == "down":
+        r_start = 0
+        r_stop = min(H - h - gap - 3, H - 2 * h - 2)
