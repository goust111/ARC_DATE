+            return {
+                "color": color,
+                "source_mask": source_mask,
+                "src_r0": src_r0,
+                "src_c0": src_c0,
+                "arrow_mask": arrow_mask,
+                "arrow_r0": arrow_r0,
+                "arrow_c0": arrow_c0,
+                "mirror_mask": mirror_mask,
+                "mirror_r0": mirror_r0,
+                "mirror_c0": mirror_c0,
+                "input_pair": input_pair,
+                "output_pair": output_pair,
+            }
