+def _find_legend_start(grid: np.ndarray) -> int:
+    rows_with_fg = np.any(grid != BACKGROUND, axis=1)
+    r = grid.shape[0] - 1
+    while r >= 0 and not rows_with_fg[r]:
+        r -= 1
+    if r < 0:
