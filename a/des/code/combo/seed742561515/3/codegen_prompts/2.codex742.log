+def _paint_cells(grid: np.ndarray, top: int, left: int, cells: Iterable[tuple[int, int]], color: int, row_limit: int) -> None:
+    h, w = grid.shape
+    for dr, dc in cells:
+        rr = top + int(dr)
+        cc = left + int(dc)
+        if 0 <= rr < min(h, row_limit) and 0 <= cc < w:
