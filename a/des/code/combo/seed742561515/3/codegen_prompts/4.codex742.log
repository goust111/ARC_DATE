+def _room_spans(size: int, walls: list[int]) -> list[tuple[int, int]]:
+    bounds = [-1, *walls, size]
+    spans: list[tuple[int, int]] = []
+    for a, b in zip(bounds, bounds[1:]):
+        if b - a > 1:
+            spans.append((a + 1, b - 1))
