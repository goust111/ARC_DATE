+        center = (lr0 + 1, lc0 + 1)
+        assert int(g[center]) == color, "legend example must have a colored center"
+
+        dirs: list[tuple[int, int]] = []
+        coords = np.argwhere(cell == color)
+        for rr, cc in coords:
+            ar = lr0 + int(rr)
+            ac = lc0 + int(cc)
+            if (ar, ac) == center:
+                continue
+            dr = ar - center[0]
+            dc = ac - center[1]
