+    height = 1 + sum(row_heights) + (len(row_heights) - 1) + (1 if bottom_border else 0)
+    width = 1 + sum(col_widths) + (len(col_widths) - 1) + (1 if right_border else 0)
+    grid = np.full((height, width), BG, dtype=int)
