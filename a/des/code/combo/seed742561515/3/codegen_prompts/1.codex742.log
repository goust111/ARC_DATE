+        (r0 + 1 + int(r), c0 + 1 + int(c))
+        for r, c in np.argwhere(pattern_mask)
+    )
+    marker_local = np.argwhere(interior == marker_color)
+    assert marker_local.shape == (1, 2)
+    marker_pos = (r0 + 1 + int(marker_local[0, 0]), c0 + 1 + int(marker_local[0, 1]))
