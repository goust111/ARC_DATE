+    return len(_components(mask.astype(bool))) == 1
+
+
+def _pattern_projection(
+    pattern_coords: tuple[tuple[int, int], ...] | list[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+    gap: tuple[int, int],
+    current_side: str,
