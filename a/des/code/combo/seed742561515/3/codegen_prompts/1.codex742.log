+BG = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+ORTHOGONAL = {
+    "top": {"left", "right"},
+    "bottom": {"left", "right"},
+    "left": {"top", "bottom"},
+    "right": {"top", "bottom"},
+}
+
