+class Region:
+    bbox: tuple[int, int, int, int]
+    gap: tuple[int, int]
+    gap_side: str
+    label_color: int
+    pattern_color: int
+    pattern_coords: tuple[tuple[int, int], ...]
+    marker_pos: tuple[int, int]
+    marker_color: int
