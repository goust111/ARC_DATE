+
+
+def _parse_region(grid: np.ndarray, grey_cells: list[tuple[int, int]]) -> Region:
+    h, w = grid.shape
+    rows = [r for r, _c in grey_cells]
+    cols = [c for _r, c in grey_cells]
+    r0, r1 = min(rows), max(rows)
