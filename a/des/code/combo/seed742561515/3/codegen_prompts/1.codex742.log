+                target_side,
+                label_colors[idx],
+                pattern_colors[idx],
+                label_colors[perm[idx]],
+            )
+            if tile is None:
+                ok = False
+                break
+            top = margin_h + slot_r * (tile_h + gap_h)
+            left = margin_w + slot_c * (tile_w + gap_w)
+            grid[top : top + tile_h, left : left + tile_w] = tile
+        if not ok:
+            continue
+
+        try:
+            _ = main(grid)
+        except AssertionError:
