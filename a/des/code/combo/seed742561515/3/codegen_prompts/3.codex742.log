+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+PALETTE_LENGTH_RANGE = (3, 5)
+OBJECT_COUNT_RANGE = (3, 5)
+GRID_SIDE_MIN = 16
+GRID_SIDE_MAX = 30
+OBJECT_MIN_COL = 3
