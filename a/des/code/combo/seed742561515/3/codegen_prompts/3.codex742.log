+                continue
+            rr, cc = np.where(mask)
+            grid[top + rr, left + cc] = GREY
+            _mark_blocked(blocked, int(top), int(left), obj_h, obj_w)
+            placements[idx] = (int(top), int(left))
+            placed = True
