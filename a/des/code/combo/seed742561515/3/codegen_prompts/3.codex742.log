+            if random.random() < 0.5:
+                _add_boundary_bumps(canvas, random.randint(0, 2))
+        else:
+            rows, cols = random.choice(_hole_layout_candidates(hole_count))
+            slot_h = random.randint(2, 3)
+            slot_w = random.randint(2, 3)
