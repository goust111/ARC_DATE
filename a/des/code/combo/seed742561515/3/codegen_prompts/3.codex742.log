+def _can_place(blocked: np.ndarray, top: int, left: int, height: int, width: int) -> bool:
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(blocked.shape[0], top + height + 1)
+    c1 = min(blocked.shape[1], left + width + 1)
+    return not bool(blocked[r0:r1, c0:c1].any())
