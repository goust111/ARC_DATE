+def _neighbors8(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr != 0 or dc != 0
