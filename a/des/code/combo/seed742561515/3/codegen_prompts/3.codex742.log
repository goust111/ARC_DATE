+                    mask[r1 + 1 : rr1, start : start + span] = True
+        else:
+            span = random.randint(1, max(1, height - 1))
+            start = random.randint(r0, r1 - span + 1)
+            if side == "left":
+                cc0 = max(0, c0 - depth)
+                if cc0 < c0:
+                    mask[start : start + span, cc0:c0] = True
+            else:
+                cc1 = min(mask.shape[1], c1 + 1 + depth)
+                if cc1 > c1 + 1:
