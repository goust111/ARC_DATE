+        if side in ("top", "bottom") and width >= 4:
+            span = random.randint(1, width - 2)
+            start = random.randint(c0 + 1, c1 - span)
+            row = r0 if side == "top" else r1
+            mask[row, start : start + span] = False
+        elif side in ("left", "right") and height >= 4:
