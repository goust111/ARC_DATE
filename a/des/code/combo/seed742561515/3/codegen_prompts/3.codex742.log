+        return None
+
+    compact = [
+        shape
+        for shape in candidates
+        if shape[0] <= min_h + 6 and shape[1] <= min_w + 8
+    ]
+    pool = compact if compact and random.random() < 0.7 else candidates
+    return random.choice(pool)
