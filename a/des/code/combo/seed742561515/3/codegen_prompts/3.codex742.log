+def _hole_count(mask: np.ndarray) -> int:
+    h, w = map(int, mask.shape)
+    bg = ~mask
+    count = 0
+    for comp in _components(bg, connectivity=4):
+        touches_border = np.any(
+            (comp[:, 0] == 0) | (comp[:, 0] == h - 1) | (comp[:, 1] == 0) | (comp[:, 1] == w - 1)
+        )
+        if not bool(touches_border):
