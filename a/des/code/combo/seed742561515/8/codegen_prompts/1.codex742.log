+def _extract_fragments(grid: np.ndarray) -> list[dict]:
+    fragments: list[dict] = []
+    for pts in _components(grid == BLUE):
+        mask = _mask_from_points(pts)
+        fragments.append(
+            {
+                "cells": pts,
+                "bbox": _bbox(pts),
+                "area": int(len(pts)),
+                "sig": _canonical_signature(mask),
+            }
+        )
+    assert fragments, "missing blue fragments"
+    return fragments
