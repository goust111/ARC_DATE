+    assert set(holes_by_sig) == set(frags_by_sig), "hole and fragment shapes must match"
+
+    out = g.copy()
+    out[g == BLUE] = BG
+    out[legend_mask] = BG
+
+    for sig, hole_group in holes_by_sig.items():
