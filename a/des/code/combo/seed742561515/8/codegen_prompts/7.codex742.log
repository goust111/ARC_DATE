+
+def _ray_cells(head: tuple[int, int], direction: str, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = DIR_VECTORS[direction]
+    r, c = head[0] + dr, head[1] + dc
+    cells: list[tuple[int, int]] = []
+    while _in_bounds(shape, r, c):
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
