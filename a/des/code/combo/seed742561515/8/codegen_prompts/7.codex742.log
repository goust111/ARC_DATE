+    def scan_from(head: tuple[int, int], direction: str) -> tuple[str, int] | None:
+        dr, dc = DIR_VECTORS[direction]
+        r, c = head[0] + dr, head[1] + dc
+        while _in_bounds(g.shape, r, c):
+            if int(g[r, c]) != bg:
