+    else:
+        lengths = [random.randint(2, MAX_CHAIN_LENGTH) for _ in range(n)]
+    random.shuffle(lengths)
+    return lengths[:n]
+
+
+def _blank_scene(shape: tuple[int, int]) -> dict[str, object]:
