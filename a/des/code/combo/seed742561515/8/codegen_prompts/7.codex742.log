+                alt_head = (anchor[0] + template["alt_head"][0], anchor[1] + template["alt_head"][1])
+                primary_ray = _ray_cells(head, direction, shape)
+                alt_ray = _ray_cells(alt_head, template["alt_direction"], shape)
