+MAX_CHAIN_LENGTH = 4
+STRAY_OPTIONS = (0, 1, 1, 2)
+MAX_LINK_DISTANCE = 7
+PADDING = 1
+GEN_ATTEMPTS = 400
+
+
+def _expand(cells: set[tuple[int, int]], shape: tuple[int, int], radius: int = PADDING) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
