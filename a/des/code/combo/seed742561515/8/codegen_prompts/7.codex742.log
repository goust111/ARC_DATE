+            return None
+
+    inp = state["grid"]
+    try:
+        out = main(inp)
+    except Exception:
+        return None
+
+    # Ensure the sample actually exercises the rule set.
+    if not np.any(inp == ARROW):
+        return None
+    if np.array_equal(inp, out):
+        return None
+    if stray_count > 0 and not np.any(out == ARROW):
+        return None
+    return inp.copy()
