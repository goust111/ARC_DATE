+def _entry_cells(cells: set[tuple[int, int]], direction: str) -> list[tuple[int, int]]:
+    dr, dc = DIR_VECTORS[direction]
+    return sorted(cell for cell in cells if (cell[0] - dr, cell[1] - dc) not in cells)
