+
+def _sample_chain_lengths(n: int) -> list[int]:
+    mode = random.choice(("mixed", "direct", "indirect"))
+    lengths: list[int]
+    if mode == "mixed":
+        lengths = [1, random.randint(2, MAX_CHAIN_LENGTH)]
+        while len(lengths) < n:
+            lengths.append(random.randint(1, MAX_CHAIN_LENGTH))
+    elif mode == "direct":
