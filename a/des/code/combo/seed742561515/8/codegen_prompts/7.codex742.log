+    shape = grid.shape
+    candidates: list[dict[str, object]] = []
+    directions = list(DIR_VECTORS)
+    random.shuffle(directions)
+    for direction in directions:
+        entry_cells = _entry_cells(target_cells, direction)
+        if not entry_cells:
