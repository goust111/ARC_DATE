+    memo: dict[int, int | None] = {}
+    visiting: set[int] = set()
+
+    def resolve_arrow(idx: int) -> int | None:
+        if idx in memo:
+            return memo[idx]
+        if idx in visiting:
+            return None
+
+        visiting.add(idx)
+        colors: list[int] = []
+        for cand in arrows[idx]["candidates"]:
+            hit = scan_from(cand["head"], cand["direction"])
+            if hit is None:
+                continue
+            kind, hit_idx = hit
+            if kind == "block":
+                colors.append(int(blocks[hit_idx]["color"]))
+            else:
+                child = resolve_arrow(hit_idx)
+                if child is not None:
+                    colors.append(int(child))
+        visiting.remove(idx)
+
+        if not colors:
+            memo[idx] = None
+        elif len(set(colors)) == 1:
+            memo[idx] = colors[0]
+        else:
+            memo[idx] = None
+        return memo[idx]
