+            used_edges.add(edge_id)
+            for cell in edge["cells"]:
+                if int(out[cell]) == AZURE:
+                    out[cell] = edge["color"]
+            if int(out[cur]) == MAROON:
+                out[cur] = edge["color"]
+            nxt = edge["b"] if edge["a"] == cur else edge["a"]
+            if markers[nxt] == GREY:
+                break
+            assert markers[nxt] == ORANGE
+            prev_edge = edge_id
+            cur = nxt
