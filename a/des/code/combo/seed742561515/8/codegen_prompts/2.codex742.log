+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+AZURE = 8
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+TRACK_COLORS = (RED, GREEN, YELLOW, MAGENTA)
+SPECIAL_COLORS = {MAROON, ORANGE, GREY}
+
+# --------------- solver ---------------
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components_for_colors(grid: np.ndarray, colors: set[int]) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) not in colors:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _scan_to_marker(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[int, int]:
+    h, w = grid.shape
+    r, c = start
+    dr, dc = direction
+    r += dr
+    c += dc
+    while 0 <= r < h and 0 <= c < w:
+        color = int(grid[r, c])
+        if color == AZURE:
+            r += dr
+            c += dc
+            continue
+        assert color in SPECIAL_COLORS, "segment extensions may only end at special markers"
+        return (r, c)
+    raise AssertionError("segment extension must hit a marker before leaving the grid")
+
+
+def _edge_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    ar, ac = a
+    br, bc = b
+    cells: list[tuple[int, int]] = []
+    if ar == br:
+        step = 1 if bc > ac else -1
+        for c in range(ac + step, bc, step):
+            cells.append((ar, c))
+    else:
+        assert ac == bc
+        step = 1 if br > ar else -1
+        for r in range(ar + step, br, step):
+            cells.append((r, ac))
+    return cells
+
