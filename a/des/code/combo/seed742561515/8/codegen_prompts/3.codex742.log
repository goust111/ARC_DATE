+
+        grid = np.full((height, width), BG, dtype=int)
+        for color, pair in zip(colors, marker_pairs):
+            for r, c in pair:
+                grid[r, c] = color
+
+        produced = main(grid)
+        if not isinstance(produced, np.ndarray) or produced.shape != grid.shape:
+            continue
+        return grid
