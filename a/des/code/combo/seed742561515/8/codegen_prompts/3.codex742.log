+OVERLAP_PROB = 0.55
+
+MIN_SIDE = 3
+MAX_SIDE = 9
+MAX_OVERLAP_FRACTION = 0.45
+MAX_OUTPUT_DENSITY = 0.36
+MIN_VISIBLE_PER_COLOR = 5
