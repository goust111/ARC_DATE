+    col_lanes, w = _sample_strips(rng, col_count, GEN_LANE_SIZE_RANGE, GEN_GAP_RANGE, GEN_MARGIN_RANGE)
+    if h > GEN_MAX_SIDE or w > GEN_MAX_SIDE:
