+    else:
+        occupied_cells = _random_occupancy(row_count, col_count, rng)
+
+    if not (GEN_OBJECT_COUNT_RANGE[0] <= len(occupied_cells) <= 9):
+        return None
+
+    grid = _build_grid(row_bands, col_lanes, (h, w), occupied_cells, rng)
+    if not _valid_sample(grid):
+        return None
+    return grid
+
