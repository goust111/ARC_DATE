+
+        left1 = int(rng.integers(left_zone, left1_max + 1))
+        left2 = left1 + w1 + gap
+        a = {"top": row - h1 // 2, "left": left1, "h": h1, "w": w1, "color": colors[0], "side": "right"}
+        b = {"top": row - h2 // 2, "left": left2, "h": h2, "w": w2, "color": colors[1], "side": "left"}
+        return a, b
+    return None
