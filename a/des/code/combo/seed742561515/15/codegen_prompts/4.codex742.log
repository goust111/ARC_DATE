+            continue
+        border_mask = np.zeros((h, w), dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
+        if not np.array_equal(sub == FRAME, border_mask):
+            continue
+        if not np.all(sub[1:-1, 1:-1] == BG):
