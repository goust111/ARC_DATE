+def _count_turns(path: list[tuple[int, int]]) -> int:
+    steps = []
+    for i in range(len(path) - 1):
+        r0, c0 = path[i]
+        r1, c1 = path[i + 1]
+        steps.append((r1 - r0, c1 - c0))
+    return sum(steps[i] != steps[i - 1] for i in range(1, len(steps)))
