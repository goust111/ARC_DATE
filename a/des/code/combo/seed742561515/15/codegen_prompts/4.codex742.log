+            cell for cell in path if any(nbr in source_cells for nbr in _neighbors4(*cell))
+        }
+        pool_touch = {
+            cell for cell in path if any(nbr in pool_border for nbr in _neighbors4(*cell))
+        }
+        if source_touch != {path[0]}:
+            continue
+        if pool_touch != {path[-1]}:
+            continue
