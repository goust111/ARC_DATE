+    pairs.sort(key=lambda pair: pair["height"] * pair["width"], reverse=True)
+
+    area_need = sum(
+        (pair["height"] + 2 * PAIR_MARGIN) * (pair["width"] + 2 * PAIR_MARGIN)
+        for pair in pairs
+    )
+    min_side = max(
+        GRID_MIN,
+        max(pair["height"] for pair in pairs) + 2,
+        max(pair["width"] for pair in pairs) + 2,
