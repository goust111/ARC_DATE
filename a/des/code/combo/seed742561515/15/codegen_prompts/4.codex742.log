+    grid[top + pr1, left + pc0 : left + pc1 + 1] = FRAME
+    grid[top + pr0 : top + pr1 + 1, left + pc0] = FRAME
+    grid[top + pr0 : top + pr1 + 1, left + pc1] = FRAME
