+BG = 0
+PATH = 3
+FRAME = 5
+STRIPE_COLORS = (1, 2, 4, 6, 7, 8, 9)
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+
+GRID_MIN = 22
+GRID_MAX = 30
+PAIR_COUNT_VALUES = (1, 2, 3)
+PAIR_COUNT_WEIGHTS = (3, 4, 2)
+SOURCE_H_RANGE = (2, 4)
+SOURCE_W_RANGE = (3, 6)
+TURN_OPTIONS = {0: (0, 2), 1: (1, 3)}
+SEG_LEN_RANGE = (2, 5)
+PAIR_SIZE_CAP = 16
+PAIR_MARGIN = 1
+PATH_ATTEMPTS = 200
