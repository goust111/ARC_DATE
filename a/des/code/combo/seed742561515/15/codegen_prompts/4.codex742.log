+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _iter_bbox(bbox: tuple[int, int, int, int]):
+    r0, c0, r1, c1 = bbox
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            yield r, c
+
+
+def _iter_border(bbox: tuple[int, int, int, int]):
+    r0, c0, r1, c1 = bbox
+    for c in range(c0, c1 + 1):
+        yield r0, c
+        yield r1, c
+    for r in range(r0 + 1, r1):
+        yield r, c0
+        yield r, c1
+
+
+def _touching(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r, c in a:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in b:
+                return True
+    return False
+
+
+def _find_sources(grid: np.ndarray) -> list[dict]:
+    mask = (grid != BG) & (grid != PATH) & (grid != FRAME)
+    sources = []
+    for coords in _components(mask):
+        r0, c0, r1, c1 = _bbox(coords)
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        h, w = sub.shape
+        if not (2 <= h <= 4 and w >= 2):
+            continue
+        if coords.shape[0] != h * w:
+            continue
+        row_colors = []
+        ok = True
+        for rr in range(h):
+            vals = np.unique(sub[rr])
+            if len(vals) != 1 or int(vals[0]) in (BG, PATH, FRAME):
+                ok = False
+                break
