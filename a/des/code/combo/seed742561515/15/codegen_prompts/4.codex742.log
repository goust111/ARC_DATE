+def _make_pair(rng: random.Random):
+    for _ in range(PAIR_ATTEMPTS):
+        h = rng.randint(*SOURCE_H_RANGE)
+        w = rng.randint(*SOURCE_W_RANGE)
+        turns = rng.choice(TURN_OPTIONS[rng.randrange(2)])
