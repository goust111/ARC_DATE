+def _draw_pair(grid: np.ndarray, pair: dict, top: int, left: int) -> None:
+    sr0, sc0, sr1, sc1 = pair["source_bbox"]
+    for i, color in enumerate(pair["colors"]):
+        grid[top + sr0 + i, left + sc0 : left + sc1 + 1] = color
