+def _iter_border(bbox: tuple[int, int, int, int]):
+    r0, c0, r1, c1 = bbox
+    for c in range(c0, c1 + 1):
+        yield r0, c
+        yield r1, c
+    for r in range(r0 + 1, r1):
+        yield r, c0
+        yield r, c1
