+    shape: tuple[int, int], tip: tuple[int, int], direction: tuple[int, int]
+) -> int:
+    h, w = shape
+    r, c = map(int, tip)
+    dr, dc = map(int, direction)
+    steps = 0
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            return steps
+        steps += 1
+
