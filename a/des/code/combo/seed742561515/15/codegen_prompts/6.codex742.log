+    blocked: set[tuple[int, int]] = set()
+    for r, c in points:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = int(r) + dr
+                cc = int(c) + dc
+                if _in_bounds(shape, rr, cc):
+                    blocked.add((rr, cc))
+    return blocked
+
