+def _skeleton_cells(tip: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:
+    tr, tc = map(int, tip)
+    cells = {(tr, tc)}
+    for dr, dc in _WINGS_BY_DIR[direction]:
+        cells.add((tr + int(dr), tc + int(dc)))
+    return cells
+
