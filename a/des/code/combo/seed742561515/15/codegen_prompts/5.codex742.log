+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0, "expected a non-empty mask"
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return np.asarray(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool).copy()
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    queue: deque[tuple[int, int]] = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                queue.append((rr, cc))
+    return len(seen) == int(mask.sum())
+
+
+def _grow_mask(
+    shape: tuple[int, int],
+    target: int,
+    seeds: list[tuple[int, int]],
+    allowed: np.ndarray | None = None,
+) -> np.ndarray | None:
+    h, w = map(int, shape)
+    if allowed is None:
+        allowed = np.ones((h, w), dtype=bool)
+    mask = np.zeros((h, w), dtype=bool)
+    frontier: set[tuple[int, int]] = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for dr, dc in DIRS4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and allowed[rr, cc] and not mask[rr, cc]:
+                frontier.add((rr, cc))
+
+    for r, c in seeds:
+        if not (0 <= r < h and 0 <= c < w and allowed[r, c]):
+            return None
+        mask[r, c] = True
+
+    for r, c in seeds:
+        add_frontier(int(r), int(c))
+
