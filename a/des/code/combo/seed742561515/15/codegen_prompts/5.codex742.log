+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
