+) -> list[tuple[int, int]]:
+    cells = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+    assert len(cells) >= count
+
+    for _ in range(50):
+        order = list(cells)
+        rng.shuffle(order)
+        chosen: list[tuple[int, int]] = []
+        for cell in order:
+            if all(abs(cell[0] - r) + abs(cell[1] - c) > 1 for r, c in chosen):
+                chosen.append(cell)
+                if len(chosen) == count:
+                    return chosen
+
+    return rng.sample(cells, count)
