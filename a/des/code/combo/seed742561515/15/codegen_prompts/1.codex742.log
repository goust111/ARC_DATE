+            for (mr, mc), color in zip(marker_positions, marker_colors):
+                grid[mr, mc] = color
+
+            frames.append((r0, c0, r1, c1, marker_count))
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    if not _validate_generated(grid):
+        return None
+    return grid
