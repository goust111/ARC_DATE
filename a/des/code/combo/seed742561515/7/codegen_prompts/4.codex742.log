+    top += extra_top
+    bottom += extra_h - extra_top
+    body_h += extra_h
+
+    extra_w = rng.randint(0, min(EXTRA_SLACK_MAX, BODY_W_RANGE[1] - body_w))
+    extra_left = rng.randint(0, extra_w)
+    left += extra_left
