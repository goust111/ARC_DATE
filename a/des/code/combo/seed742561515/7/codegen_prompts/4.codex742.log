+    legend_row = np.full((1, body.shape[1]), BG, dtype=int)
+    start = rng.randint(0, body.shape[1] - span)
+    for idx, color in enumerate(legend):
+        legend_row[0, start + 2 * idx] = color
+    return np.vstack([body, legend_row])
