+def _winner_for_leaf(node: GenNode, ranks: dict[int, int]) -> int:
+    best_color = node.color
+    best_rank = ranks[best_color]
+    cur = node.parent
+    while cur is not None:
+        cur_rank = ranks[cur.color]
+        if cur_rank > best_rank:
+            best_color = cur.color
+            best_rank = cur_rank
+        cur = cur.parent
+    return best_color
