+    ranks = _legend_ranks(g)
+    body = g[:-1].copy()
+    frames = _extract_frames(body)
+    _build_containment(frames)
+
+    out = body.copy()
+    for frame in frames:
+        if frame.children:
+            continue
+        fill = _winner_color(frame, ranks)
+        out[frame.r0 + 1 : frame.r1, frame.c0 + 1 : frame.c1] = fill
+    return out
