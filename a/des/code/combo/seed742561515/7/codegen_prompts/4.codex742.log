+def _make_forest(rng: random.Random) -> list[GenNode]:
+    total = rng.randint(*TOTAL_FRAMES_RANGE)
+    if total >= 3 and rng.random() < 0.4:
+        cut = rng.randint(1, total - 1)
+        budgets = [cut, total - cut]
+        rng.shuffle(budgets)
+    else:
