+ROOM_COUNT_OPTIONS = (1, 2, 2, 3)
+ROOM_SIDE_MIN = 4
+ROOM_SIDE_MAX = 7
+ROOM_PADDING = 1
+RING_SEGMENT_MIN_LEN = 4
+ROOM_PLACEMENT_TRIES = 120
