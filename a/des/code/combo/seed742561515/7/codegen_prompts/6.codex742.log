+def _windows_keep_wall_connected(bbox: tuple[int, int, int, int], windows: list[tuple[int, int, str]]) -> bool:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
