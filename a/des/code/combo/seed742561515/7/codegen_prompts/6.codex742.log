+def _ring_segment_colors(grid: np.ndarray) -> list[int]:
+    ring = [int(grid[r, c]) for r, c in _ring_positions(*grid.shape)]
+    assert ring, "outer ring must be non-empty"
+    segments = [ring[0]]
+    for color in ring[1:]:
+        if color != segments[-1]:
+            segments.append(color)
+    return segments
