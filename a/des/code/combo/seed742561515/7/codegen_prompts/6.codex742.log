+        )
+    for idx, r in enumerate(range(r0 + 1, r1)):
+        slots["left"].append({"r": r, "c": c0, "side": "left", "idx": idx, "border_color": int(grid[r, 0])})
+        slots["right"].append(
+            {"r": r, "c": c1, "side": "right", "idx": idx, "border_color": int(grid[r, grid.shape[1] - 1])}
+        )
+    return slots
