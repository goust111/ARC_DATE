+
+def _no_adjacent_subsets(slots: list[dict]) -> list[list[dict]]:
+    count = len(slots)
+    subsets: list[list[dict]] = []
+    for mask in range(1 << count):
+        if mask & (mask << 1):
+            continue
+        subsets.append([slots[i] for i in range(count) if (mask >> i) & 1])
+    return subsets
+
