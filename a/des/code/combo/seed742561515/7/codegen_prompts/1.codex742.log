+    if not found:
+        return None
+
+    modes = list(found)
+    weights = [MODE_WEIGHTS[mode] for mode in modes]
+    chosen_mode = str(rng.choices(modes, weights=weights, k=1)[0])
+    return found[chosen_mode], chosen_mode
