+    for r in range(h):
+        for c in range(w):
+            if not grey_mask[r, c]:
+                continue
+            matched = False
+            if 0 < c < w - 1:
+                left = int(labels[r, c - 1])
+                right = int(labels[r, c + 1])
+                if left and right and {left, right} == {a_id, b_id}:
+                    matched = True
+            if not matched and 0 < r < h - 1:
+                up = int(labels[r - 1, c])
+                down = int(labels[r + 1, c])
+                if up and down and {up, down} == {a_id, b_id}:
