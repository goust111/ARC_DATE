+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MAROON = 9
+INPUT_COLORS = (1, 2, 3, 4, 5, 6, 7, 8)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+GEN_RETRIES = 400
+WORK_H = 30
+WORK_W = 30
+RECT_DIMS = (
+    (2, 4),
+    (2, 5),
+    (2, 6),
+    (3, 4),
+    (3, 5),
+    (3, 6),
+    (4, 4),
+    (4, 5),
+    (4, 6),
+    (5, 4),
+    (5, 5),
+    (5, 6),
+)
+MAX_PARTITION_ATTEMPTS = 160
+MAX_MOVE_PLACEMENT_ATTEMPTS = 200
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in DIRS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _bbox_from_cells(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _connected_cells(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    q = deque([start])
