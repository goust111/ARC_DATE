+
+    lower_zone_top = max_anchor_bottom + random.randint(4, 6)
+    if lower_zone_top >= WORK_H - 4:
+        return None
+
+    for spec in specs:
+        piece_a = spec["piece_a"]
+        piece_b = spec["piece_b"]
