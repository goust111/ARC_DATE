+
+def _build_expected_patch(
+    rect_h: int,
+    rect_w: int,
+    piece_a: dict,
+    piece_b: dict,
+    color_a: int,
+    color_b: int,
+) -> np.ndarray:
+    patch = np.full((rect_h, rect_w), BG, dtype=int)
+    area_a = int(piece_a["area"])
+    area_b = int(piece_b["area"])
+    if area_a == area_b:
+        split_row = (rect_h + 1) // 2
+        for r, c in piece_a["cells"]:
