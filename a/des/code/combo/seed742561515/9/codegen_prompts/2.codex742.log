+def _components_monochrome(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            q = deque([(int(r), int(c))])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
