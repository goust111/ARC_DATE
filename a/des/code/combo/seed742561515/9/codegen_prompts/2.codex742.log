+            if (
+                _has_color(grid, r, c + 1, color)
+                and _has_color(grid, r + 1, c, color)
+                and not _has_color(grid, r, c - 1, color)
+                and not _has_color(grid, r - 1, c, color)
+            ):
+                tls.add((int(r), int(c)))
+            if (
+                _has_color(grid, r, c - 1, color)
+                and _has_color(grid, r + 1, c, color)
+                and not _has_color(grid, r, c + 1, color)
+                and not _has_color(grid, r - 1, c, color)
+            ):
+                trs.add((int(r), int(c)))
+            if (
+                _has_color(grid, r, c + 1, color)
+                and _has_color(grid, r - 1, c, color)
+                and not _has_color(grid, r, c - 1, color)
+                and not _has_color(grid, r + 1, c, color)
+            ):
+                bls.add((int(r), int(c)))
+            if (
+                _has_color(grid, r, c - 1, color)
+                and _has_color(grid, r - 1, c, color)
+                and not _has_color(grid, r, c + 1, color)
+                and not _has_color(grid, r + 1, c, color)
