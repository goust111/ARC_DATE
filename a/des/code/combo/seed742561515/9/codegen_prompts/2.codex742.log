+def _find_divider(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for c in range(w):
+        column = grid[:, c]
+        if int(column[0]) == bg:
+            continue
+        if not np.all(column == column[0]):
+            continue
+        if c == 0 or c == w - 1:
