+                        q.append((int(nr), int(nc)))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            rel = arr - np.array([r0, c0], dtype=int)
+            mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+            mask[rel[:, 0], rel[:, 1]] = True
+            comps.append(
