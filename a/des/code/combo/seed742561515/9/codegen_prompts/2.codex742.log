+    forbidden = np.zeros((h, left_w), dtype=bool)
+    placements: dict[tuple[int, int], tuple[int, int]] = {}
+
+    order = sorted(frame_specs, key=lambda item: (item["mask"].shape[0] * item["mask"].shape[1]), reverse=True)
+    for spec in order:
