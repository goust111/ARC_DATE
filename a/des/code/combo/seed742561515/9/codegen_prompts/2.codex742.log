+                continue
+            cells = [(int(r0 + rr), int(c0 + cc)) for rr, cc in np.argwhere(mask)]
+            placements[tuple(map(int, mask.shape))] = (int(r0), int(c0))
+            _mark_forbidden(forbidden, cells)
+            placed = True
+            break
+        if not placed:
