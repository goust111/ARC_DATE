+    max_r = max(r1 for _, r1, _, _ in rects)
+    max_c = max(c1 for _, _, _, c1 in rects)
+    mask = np.zeros((max_r - min_r, max_c - min_c), dtype=bool)
+    for r0, r1, c0, c1 in rects:
