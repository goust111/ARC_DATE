+    frames = [comp for comp in components if _is_hollow_frame(g, comp)]
+    assert frames, "expected at least one target frame"
+
+    out = g.copy()
+    used_sources: set[int] = set()
+
+    for frame in frames:
+        candidates = _frame_side_candidates(g, frame)
