+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+import random
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+HORIZONTAL_SIDES = {"left", "right"}
+VERTICAL_SIDES = {"top", "bottom"}
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: set[Coord]) -> BBox:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_connected(cells: set[Coord]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _find_components(g: np.ndarray) -> tuple[list[dict], dict[Coord, int]]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    cell_to_comp: dict[Coord, int] = {}
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: set[Coord] = set()
+            while queue:
+                cr, cc = queue.popleft()
+                coords.add((cr, cc))
+                cell_to_comp[(cr, cc)] = len(components)
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(g.shape, nr, nc) and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+
+    return components, cell_to_comp
+
+
+def _is_hollow_frame(g: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    color = int(comp["color"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["area"]) != 2 * h + 2 * w - 4:
+        return False
+
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if on_border:
+                if int(g[r, c]) != color:
+                    return False
+            elif int(g[r, c]) != 0:
+                return False
