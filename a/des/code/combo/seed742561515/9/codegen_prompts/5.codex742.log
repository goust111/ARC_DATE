+    patches: list[tuple[np.ndarray, np.ndarray]] = []
+    for i, side in enumerate(sides):
+        pair = _build_pair(side, colors[2 * i], colors[2 * i + 1])
+        if pair is None:
+            return None
+        patches.append(pair)
