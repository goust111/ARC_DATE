+        obj_h, obj_w = mirrored.shape
+        assert obj_h <= inner_h and obj_w <= inner_w, "mirrored object must fit inside its frame"
+
+        start_r = (inner_h - obj_h) // 2
+        start_c = (inner_w - obj_w) // 2
