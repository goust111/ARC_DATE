+def _draw_orange_bar(grid, block_bbox, direction):
+    r0, c0, r1, c1 = block_bbox
+    if direction == "up":
+        grid[r0 - 1, c0 : c1 + 1] = ORANGE
+    elif direction == "down":
+        grid[r1 + 1, c0 : c1 + 1] = ORANGE
+    elif direction == "left":
+        grid[r0 : r1 + 1, c0 - 1] = ORANGE
+    else:
