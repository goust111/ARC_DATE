+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+ORANGE = 7
+
+PATTERN_COLORS = (4, 6, 8, 9)
+KINDS = ("horizontal", "vertical", "rotation")
+LEGEND_COLOR_BY_KIND = {
+    "horizontal": BLUE,
+    "vertical": GREEN,
+    "rotation": RED,
+}
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+CORNERS = ("tl", "tr", "bl", "br")
