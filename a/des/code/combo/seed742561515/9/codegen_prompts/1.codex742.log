+
+def _legend_layout(corner, h, w):
+    if corner == "tl":
+        return {
+            "frame_bbox": (1, 4, 5, 8),
+            "gap": (3, 4),
+            "block_bbox": (2, 1, 3, 2),
+            "bar_dirs": ("up", "left"),
+            "zone": (0, 0, 6, 9),
+        }
+    if corner == "tr":
+        return {
+            "frame_bbox": (1, w - 9, 5, w - 5),
+            "gap": (3, w - 5),
+            "block_bbox": (2, w - 3, 3, w - 2),
+            "bar_dirs": ("up", "right"),
+            "zone": (0, w - 10, 6, w - 1),
