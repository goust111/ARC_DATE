+    if not candidates:
+        return None
+    candidates.sort()
+    return {"color": candidates[0][1]}
+
+
+def _ray_cells(grid, frame):
+    h, w = grid.shape
+    r, c = frame["gap"]
+    dr, dc = DIRS[frame["gap_dir"]]
+    cells = []
+    while 0 <= r < h and 0 <= c < w and grid[r, c] != GRAY:
+        cells.append((r, c))
+        r += dr
+        c += dc
