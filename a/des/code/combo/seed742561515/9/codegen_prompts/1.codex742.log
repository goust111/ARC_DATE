+# --------------- generator ---------------
+
+GRID_H_RANGE = (26, 35)
+GRID_W_RANGE = (26, 35)
+REGULAR_FRAME_COUNT_RANGE = (3, 5)
+REGULAR_FRAME_PAD = 1
+PLACE_RETRIES = 80
+GEN_RETRIES = 400
+
+
+def _draw_frame(grid, bbox, gap):
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = GRAY
+    grid[r1, c0 : c1 + 1] = GRAY
+    grid[r0 : r1 + 1, c0] = GRAY
+    grid[r0 : r1 + 1, c1] = GRAY
