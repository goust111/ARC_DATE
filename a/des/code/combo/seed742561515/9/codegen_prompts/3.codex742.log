+    for arrow in arrows:
+        matches: list[tuple[int, tuple[int, int], tuple[int, int], tuple[int, int]]] = []
+        for idx, band in enumerate(bands):
+            for endpoint in band["endpoints"]:
+                cell = endpoint["cell"]
+                outward = endpoint["outward"]
+                handle = (int(cell[0] + outward[0]), int(cell[1] + outward[1]))
+                if handle in arrow:
