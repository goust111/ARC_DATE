+            line = _line_component(comp)
+            if line is None:
+                continue
+            orientation, ordered = line
+            if orientation == "h":
+                endpoints = [
+                    {"cell": ordered[0], "outward": (0, -1)},
+                    {"cell": ordered[-1], "outward": (0, 1)},
+                ]
+            else:
+                endpoints = [
+                    {"cell": ordered[0], "outward": (-1, 0)},
+                    {"cell": ordered[-1], "outward": (1, 0)},
+                ]
+            bands.append(
+                {
