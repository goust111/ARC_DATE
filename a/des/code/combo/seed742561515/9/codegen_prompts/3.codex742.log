+    if np.any(out == ARROW):
+        return None
+    if not np.any((grid == BG) & (out != BG)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _generate_attempt()
+        if grid is not None:
