+    rows = sorted({r for r, _c in comp})
+    cols = sorted({c for _r, c in comp})
+    if len(rows) == 1:
+        ordered = sorted(comp, key=lambda rc: rc[1])
+        vals = [c for _r, c in ordered]
+        if vals == list(range(vals[0], vals[-1] + 1)):
+            return "h", ordered
+    if len(cols) == 1:
+        ordered = sorted(comp, key=lambda rc: rc[0])
