+        for color, frontier in frontiers.items():
+            for r, c in frontier:
+                for nr, nc in _neighbors4(r, c, h, w):
+                    if out[nr, nc] != BLACK:
+                        continue
+                    claims.setdefault((nr, nc), set()).add(color)
