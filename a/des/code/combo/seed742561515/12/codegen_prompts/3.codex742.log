+    frontiers: dict[int, set[tuple[int, int]]] = {}
+    for r, c in np.argwhere((g != BLACK) & (g != GREY)):
+        color = int(g[r, c])
+        out[r, c] = color
+        frontiers.setdefault(color, set()).add((int(r), int(c)))
