+        if not claims:
+            break
+
+        next_frontiers: dict[int, set[tuple[int, int]]] = {}
+        for cell, colors in claims.items():
+            r, c = cell
+            if len(colors) == 1:
+                color = next(iter(colors))
+                out[r, c] = color
