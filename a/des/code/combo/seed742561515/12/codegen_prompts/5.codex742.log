+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+
+DIR_FROM_EDGE = {
+    "top": DOWN,
+    "bottom": UP,
+    "left": RIGHT,
+    "right": LEFT,
+}
+
+REFLECT = {
+    "\\": {
+        RIGHT: DOWN,
+        DOWN: RIGHT,
+        LEFT: UP,
+        UP: LEFT,
+    },
+    "/": {
