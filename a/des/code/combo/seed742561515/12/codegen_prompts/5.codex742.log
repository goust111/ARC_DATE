+        (r0, c0), (r1, c1) = sorted(comp)
+        dr = r1 - r0
+        dc = c1 - c0
+        assert abs(dr) == 1 and abs(dc) == 1, "mirror cells must be diagonally adjacent"
+        orient = "\\" if dr == dc else "/"
+
+        mirror_id = len(mirrors)
+        mirrors.append((orient, ((r0, c0), (r1, c1))))
+        for coord in comp:
+            cell_to_mirror[coord] = mirror_id
+
