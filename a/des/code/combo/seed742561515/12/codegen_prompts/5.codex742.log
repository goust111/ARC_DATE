+    free_colors = [c for c in SOURCE_COLORS if c not in used_colors]
+    if not free_colors:
+        return
+
+    candidates: list[tuple[str, int]] = []
+    for c in range(max(2, w // 2), w - 1):
+        candidates.append(("top", c))
+    for r in range(max(2, h // 2), h - 1):
+        candidates.append(("left", r))
