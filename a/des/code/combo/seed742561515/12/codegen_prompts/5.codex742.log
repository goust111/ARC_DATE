+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GRAY = 5
+SOURCE_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+
+DIR_FROM_EDGE = {
+    "top": DOWN,
+    "bottom": UP,
+    "left": RIGHT,
+    "right": LEFT,
+}
+
+REFLECT = {
+    "\\": {
+        RIGHT: DOWN,
+        DOWN: RIGHT,
+        LEFT: UP,
+        UP: LEFT,
+    },
+    "/": {
+        RIGHT: UP,
+        UP: RIGHT,
+        LEFT: DOWN,
+        DOWN: LEFT,
+    },
+}
+
+ROTATION_LIMIT = 4
+GEN_RETRIES = 300
