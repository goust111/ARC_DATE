+
+def _place_mirror(grid: np.ndarray, anchor_r: int, anchor_c: int, orient: str) -> bool:
+    cells = _candidate_mirror_cells(anchor_r, anchor_c, orient)
+    if not _can_place_mirror(grid, cells):
+        return False
+    for r, c in cells:
+        grid[r, c] = GRAY
