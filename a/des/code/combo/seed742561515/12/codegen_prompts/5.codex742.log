+def _build_straight_no_collision(rng: random.Random) -> np.ndarray:
+    h = rng.randint(10, 16)
+    w = rng.randint(10, 16)
+    r1 = rng.randint(2, min(5, h - 3))
+    r2 = rng.randint(max(r1 + 2, h // 2), h - 2)
+    grid = np.full((h, w), BLACK, dtype=int)
