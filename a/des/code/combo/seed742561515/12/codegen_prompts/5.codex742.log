+    if mode == "straight_no_collision" and not (stats["collisions"] == 0 and stats["reflections"] == 0):
+        return None
+
+    if stats["sources"] < 1 or stats["sources"] > 4:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
