def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
    """Paint a boolean mask into a colored patch on a bg-filled array."""
    pat = np.full(mask.shape, bg, dtype=int)
    pat[mask] = color
    return pat


