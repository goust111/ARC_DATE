+    size_h, size_w = map(int, template.shape)
+    bottom = top + size_h + 1
+    right = left + size_w + 1
+    grid[top, left : right + 1] = GREY
+    grid[bottom, left : right + 1] = GREY
+    grid[top : bottom + 1, left] = GREY
+    grid[top : bottom + 1, right] = GREY
+    grid[top + 1 : bottom, left + 1 : right] = template
+
