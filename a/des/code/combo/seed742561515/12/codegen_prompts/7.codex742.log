    dilated[:, :-1] |= occupied[:, 1:]
    dilated[1:, 1:] |= occupied[:-1, :-1]
    dilated[1:, :-1] |= occupied[:-1, 1:]
    dilated[:-1, 1:] |= occupied[1:, :-1]
    dilated[:-1, :-1] |= occupied[1:, 1:]
