+    r0 = top_margin
+    c0 = left_margin
+    r1 = r0 + frame_h - 1
+    c1 = c0 + frame_w - 1
+    frame_bbox = (r0, c0, r1, c1)
+    _paint_frame(grid, r0, c0, r1, c1, FRAME)
