        coords = obj["coords"]
        assert int(obj["color"]) == 2
        if int(obj["area"]) == 1:
            continue

        color = _symmetry_color(_component_mask(coords, obj["bbox"]))
        out[coords[:, 0], coords[:, 1]] = color

