 270: GRID_MIN = 16              # minimum grid dimension (rows or cols)
 271: GRID_MAX = 25              # maximum grid dimension
 272: MAX_EXTRA_PAD = 12         # max total padding beyond drawing extent
 273: MAX_PAD_PER_SIDE = 6       # max padding on one side
 274: 
 275: # Frame geometry
 276: FRAME_H_RANGE = (7, 20)    # allowed frame bbox height
 277: FRAME_W_RANGE = (7, 24)    # allowed frame bbox width
 278: FRAME_CORNER_MAX = 5       # max corner wobble displacement
 279: FRAME_MIN_EDGE = 2         # min straight-edge length between corners
 280: FRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops
