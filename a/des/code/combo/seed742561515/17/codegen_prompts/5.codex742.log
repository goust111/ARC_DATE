 250: def _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:
 251:     seen: set[tuple[int, int]] = set()
 252:     orbits: list[list[tuple[int, int]]] = []
 253:     for r in range(h):
 254:         for c in range(w):
 255:             if r not in (0, h - 1) and c not in (0, w - 1):
 256:                 continue
 257:             if (r, c) in seen:
 258:                 continue
 259:             orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})
 260:             seen.update(orbit)
 261:             orbits.append(orbit)
 262:     return orbits
