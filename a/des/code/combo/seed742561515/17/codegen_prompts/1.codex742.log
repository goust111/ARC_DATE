+GEN_RETRIES = 400
+GRID_SIZE_RANGE = (22, 30)
+REGION_COUNT_RANGE = (2, 5)
+COLOR_POOL = tuple(range(1, 10))
+PATCH_MARGIN = 2
+PATCH_PADDING = 1
