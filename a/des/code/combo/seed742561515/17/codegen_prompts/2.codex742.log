+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PAIR_COLORS = [2, 1, 4, 6, 7, 8, 9, 3, 5]
+RNG = np.random.default_rng()
+
+MIN_PAIRS = 2
+MAX_PAIRS = 4
+GRID_H_RANGE = (20, 31)
+GRID_W_RANGE = (20, 31)
+PAIR_SHAPE_RETRIES = 100
+PLACEMENT_RETRIES = 8
+GEN_RETRIES = 400
