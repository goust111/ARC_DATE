+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+WINDOW_TYPES: dict[str, tuple[int, int, int, int]] = {
+    "horizontal": (2, 2, 1, 1),
+    "vertical": (1, 1, 2, 2),
+    "both": (2, 2, 2, 2),
+}
+GENERATION_RETRIES = 400
