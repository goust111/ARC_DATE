    for r in range(h):
        cols=[c for rr,c in S if rr==r]
        if cols and max(cols)-min(cols)+1"'!=len(cols): return False
    for c in range(w):
        rows=[r for r,cc in S if cc==c]
        if rows and max(rows)-min(rows)+1!=len(rows): return False
    # visually L-ish: exactly one direction of row counts monotone and one of col counts monotone after some rotation
    def rot(S,h,w):
        T={(c,h-1-r) for r,c in S}
        rs=[r for r,c in T]; cs=[c for r,c in T]
        r0,c0=min(rs),min(cs)
        T={(r-r0,c-c0) for r,c in T}
        return w,h,T
    for _ in range(4):
        row_counts=[sum((r,c) in S for c in range(w)) for r in range(h)]
        col_counts=[sum((r,c) in S for r in range(h)) for c in range(w)]
        if row_counts[-1]==w and all(row_counts[i]<=row_counts[i+1] for i in range(h-1)) and col_counts[0]==h and all(col_counts[i]>=col_counts[i+1] for i in range(w-1)):
            return True
        h,w,S=rot(S,h,w)
    return False

found=[]
for H in range(3,7):
  for W in range(3,8,2):  # odd widths preferred
    cells=[(r,c) for r in range(H) for c in range(W)]
    n=len(cells)
    # iterate subset sizes not too small/large
    for k in range(3,n-2):
      # simple pruning for unequal areas
      if k==n-k: continue
      for comb in combinations(cells,k):
        A=set(comb)
        if (0,0) not in A: # dedup by requiring top-left in A
          continue
        B=set(cells)-A
        if not connected(A) or not connected(B):
          continue
        if not nice(A) or not nice(B):
          continue
        ah,aw,An=bbox(A); bh,bw,Bn=bbox(B)
        found.append((H,W,k,n-k,ah,aw,bh,bw,An,Bn))
        print('"'rect',H,W,'areas',k,n-k,'A bbox',ah,aw,'B bbox',bh,bw)
        for name,S,h,w in [('A',An,ah,aw),('B',Bn,bh,bw)]:
          print(name)
          for r in range(h):
            print(''.join('#' if (r,c) in S else '.' for c in range(w)))
        print()
        if len(found)>=20:
          raise SystemExit
print('total',len(found))
