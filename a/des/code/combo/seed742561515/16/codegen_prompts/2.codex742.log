import numpy as np
from collections import defaultdict, deque

BLACK, GREY, MAROON = 0,5,9
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def normalize(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    r0,c0=min(rs),min(cs)
    norm={(r-r0,c-c0) for r,c in coords}
    return norm, max(r for r,c in norm)+1, max(c for r,c in norm)+1

def rot(coords,h,w,k):
    S=set(coords); hh,ww=h,w
    for _ in range(k%4):
        S={(c,hh-1-r) for r,c in S}
        hh,ww=ww,hh
        norm,hh,ww=normalize(S)
        S=norm
    return S,hh,ww

def rot180(coords,h,w):
    return {(h-1-r,w-1-c) for r,c in coords}

def fit(a,ha,wa,b,hb,wb):
    cand=set()
    def try_pair(x,hx,wx,y_in,hy,wy):
        y=rot180(y_in,hy,wy)
        for dr in range(-hy, hx+1):
            for dc in range(-wy, wx+1):
                shifted={(r+dr,c+dc) for r,c in y}
                if x & shifted:
                    continue
                union=x|shifted
                rs=[r for r,c in union]; cs=[c for r,c in union]
                h=max(rs)-min(rs)+1; w=max(cs)-min(cs)+1
                if len(union)==h*w:
                    cand.add((h,w))
    try_pair(a,ha,wa,b,hb,wb)
    try_pair(b,hb,wb,a,ha,wa)
    return cand

def make_partition(H,W,full_rows,tail):
    rows=[W]*full_rows + list(tail)
    A={(r,c) for r,n in enumerate(rows) for c in range(n)}
    allc={(r,c) for r in range(H) for c in range(W)}
    B=allc-A
    return normalize(A), normalize(B)

for H,W in [(3,5),(5,7),(5,5),(3,7)]:
    m=H-1
    if H==3:
        opts=[(1,[3,1]),(1,[4,2]),(1,[2,1])]
    else:
        opts=[(2,[5,3,1]),(1,[6,4,2,1]),(3,[4,2])]
    for full,tail in opts:
        if full+len(tail)"'!=H or max(tail)>=W:
            continue
        (A,ha,wa),(B,hb,wb)=make_partition(H,W,full,tail)
        for k in range(4):
            A2,ha2,wa2=rot(A,ha,wa,k)
            B2,hb2,wb2=rot(B,hb,wb,k+2)
            cand=fit(A2,ha2,wa2,B2,hb2,wb2)
            print((H,W,full,tail,k),'"'cands',cand)
