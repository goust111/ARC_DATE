    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    norm={(r-r0,c-c0) for r,c in cells}
    return (r1-r0+1,c1-c0+1,norm)

def is_rect(cells):
    h,w,S=bbox(cells)
    return len(S)==h*w

def l_like(cells):
    h,w,S=bbox(cells)
    if len(S) < 3 or len(S)==h*w:
        return False
    # exactly two extreme tips heuristic: row counts and col counts vary; and removing one full row/col leaves rectangle?
    # Accept if shape can be written as union of one full row segment and one full col segment after some rotation.
    for rot in range(4):
        T=S
        hh,ww=h,w
        for _ in range(rot):
            T={(c,hh-1-r) for r,c in T}
            hh,ww=ww,hh
        # test classic corner-notch L: cells = bottom row all + left col all + optional filled rectangle at corner? too strict.
        # Instead test if one border row and one border col are completely filled and all remaining filled cells lie on one of them.
        if all((hh-1,c) in T for c in range(ww)) and all((r,0) in T for r in range(hh)):
            if all((r==hh-1 or c==0) for r,c in T):
                return True
        # thick two-row/col L: bottom row all, top row suffix/prefix contiguous
        # simply require each row occupied cells contiguous and nested, with one row full and one side touching all rows.
    return False

# relax: select connected non-rect shapes with bbox at least 2x2 and each row/col contiguous; useful visually.
def nice(cells):
    h,w,S=bbox(cells)
    if len(S) < 3 or len(S)==h*w or h<2 or w<2:
        return False
    for r in range(h):
        cols=[c for rr,c in S if rr==r]
        if cols and max(cols)-min(cols)+1"'!=len(cols): return False
    for c in range(w):
        rows=[r for r,cc in S if cc==c]
        if rows and max(rows)-min(rows)+1!=len(rows): return False
    # not too many turns: boundary row counts monotone from top and bottom maybe
    row_counts=[sum((r,c) in S for c in range(w)) for r in range(h)]
    col_counts=[sum((r,c) in S for r in range(h)) for c in range(w)]
    def bitonic(arr):
        n=len(arr)
        for k in range(n):
            if all(arr[i]<=arr[i+1] for i in range(k)) and all(arr[i]>=arr[i+1] for i in range(k,n-1)):
                return True
        return False
    return bitonic(row_counts) and bitonic(col_counts)

