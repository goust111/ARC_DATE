from itertools import product

def classic_L(h,w):
    # normalized corner at bottom-left: full bottom row + full left col
    return {(r,0) for r in range(h)} | {(h-1,c) for c in range(w)}

def rot90(cells):
    h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1
    R={(c,h-1-r) for r,c in cells}
    rs=[r for r,c in R]; cs=[c for r,c in R]
    r0,c0=min(rs),min(cs)
    return {(r-r0,c-c0) for r,c in R}

def all_orients(cells):
    seen=[]
    cur=cells
    for _ in range(4):
        if cur not in seen: seen.append(cur)
        cur=rot90(cur)
    return seen

def bbox(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs),min(cs),max(rs),max(cs)

def shift(cells,dr,dc):
    return {(r+dr,c+dc) for r,c in cells}

def norm(cells):
    r0,c0,_,_=bbox(cells)
    return {(r-r0,c-c0) for r,c in cells}

