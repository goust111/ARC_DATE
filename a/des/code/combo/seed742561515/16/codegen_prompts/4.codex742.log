+        while frontier and len(cells) < target:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            cells.add(cell)
+            r, c = cell
+            for dr, dc in NEIGHBORS4:
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:
+                    frontier.add((rr, cc))
