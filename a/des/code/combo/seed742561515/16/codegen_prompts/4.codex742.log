+            width = random.randint(2, 5)
+            if direction in {DIR_UP_LEFT, DIR_UP_RIGHT, DIR_DOWN_LEFT, DIR_DOWN_RIGHT} and random.random() < 0.65:
+                while width == height:
+                    width = random.randint(2, 5)
