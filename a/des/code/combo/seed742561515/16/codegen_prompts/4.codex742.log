+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Apply the transformation encoded by each lower instruction block to the same-colored object above the divider.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h >= 7 and w >= 7
