+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+DIVIDER = 5
+CENTER = 0
+ARROW = 9
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7)
+
+DIR_UP = (-1, 0)
+DIR_DOWN = (1, 0)
+DIR_LEFT = (0, -1)
+DIR_RIGHT = (0, 1)
+DIR_UP_LEFT = (-1, -1)
+DIR_UP_RIGHT = (-1, 1)
+DIR_DOWN_LEFT = (1, -1)
+DIR_DOWN_RIGHT = (1, 1)
+
+ALL_DIRECTIONS = (
+    DIR_UP,
+    DIR_DOWN,
+    DIR_LEFT,
+    DIR_RIGHT,
+    DIR_UP_LEFT,
+    DIR_UP_RIGHT,
+    DIR_DOWN_LEFT,
+    DIR_DOWN_RIGHT,
+)
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_DIRECTION_BAG: list[tuple[int, int]] = []
+
