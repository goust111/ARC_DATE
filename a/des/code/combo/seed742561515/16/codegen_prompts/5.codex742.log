+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+SIDES = ("top", "bottom", "left", "right")
+
+# --------------- generator config ---------------
+
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 34
+OBJECT_COUNT_RANGE = (2, 4)
+OPEN_LEN_RANGE = (2, 6)
+PATTERN_DEPTH_RANGE = (1, 4)
+INNER_GAP_RANGE = (1, 2)
+SIDE_MARGIN_EXTRA_RANGE = (0, 2)
+PLACEMENT_TRIES = 200
+GEN_RETRIES = 300
