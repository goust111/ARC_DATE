+    patch = np.full((env_h, env_w), int(envelope_color), dtype=int)
+    patch[opening] = BG
+    pattern = _paint_mask(
+        rng,
+        mask,
+        [color for color in COLORS if color != int(envelope_color)],
+    )
+    for r, c in np.argwhere(mask):
+        patch[pattern_r0 + r, pattern_c0 + c] = int(pattern[r, c])
