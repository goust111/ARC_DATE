+def _perimeter_coords(h: int, w: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(w):
+        coords.append((0, c))
+        if h > 1:
+            coords.append((h - 1, c))
+    for r in range(1, h - 1):
+        coords.append((r, 0))
+        if w > 1:
+            coords.append((r, w - 1))
+    return coords
