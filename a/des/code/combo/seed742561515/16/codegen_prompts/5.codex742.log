+        for r in range(h)
+        for c in range(w)
+        if int(crop[r, c]) not in (BG, envelope_color)
+    ]
+    if not pattern_cells:
+        return None
+
+    rows = [r for r, _, _ in pattern_cells]
+    cols = [c for _, c, _ in pattern_cells]
+    if side == "top":
+        shift = (-max(rows) - 1, 0)
+    elif side == "bottom":
+        shift = (h - min(rows), 0)
+    elif side == "left":
+        shift = (0, -max(cols) - 1)
+    else:
