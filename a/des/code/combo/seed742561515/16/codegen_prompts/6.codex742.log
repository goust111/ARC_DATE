+                continue
+
+            image = grid[tick_row + 1 : order_row, left : left + width]
+            if image.shape[0] < 2:
+                continue
+            if np.any((image == BLACK) | (image == GREY)):
+                continue
+            if np.any(grid[tick_row + 1 : order_row, :left] != BLACK):
+                continue
+            if np.any(grid[tick_row + 1 : order_row, left + width :] != BLACK):
