+        tick_cols = np.flatnonzero(row == GREY)
+        strip_w = _constant_step(tick_cols)
+        if strip_w is None:
+            continue
+        if np.any((row != BLACK) & (row != GREY)):
+            continue
+
+        strip_count = int(tick_cols.size)
+        left = int(tick_cols[0])
+        width = strip_count * strip_w
+        if left + width > w:
+            continue
+
