    ]
    queue = deque()

    for r, c, color in sources:
        if best_time[r, c] == -1:
            best_time[r, c] = 0
            owners[r][c].add(color)
            queue.append((r, c, color, 0))
        elif best_time[r, c] == 0 and color not in owners[r][c]:
            owners[r][c].add(color)
            queue.append((r, c, color, 0))

    while queue:
        r, c, color, time = queue.popleft()
        if best_time[r, c] != time or color not in owners[r][c]:
