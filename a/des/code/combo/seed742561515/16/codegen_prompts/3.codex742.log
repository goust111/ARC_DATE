+        if not pairs:
+            continue
+
+        leaf_a, leaf_b, dist_a, dist_b = random.choice(pairs)
+        if mode == "hub_tie":
+            return {"mode": mode, "hub": hub, "leaves": [leaf_a, leaf_b]}
+
+        winner = leaf_a if dist_a < dist_b else leaf_b
+        return {
+            "mode": mode,
+            "hub": hub,
+            "leaves": [leaf_a, leaf_b],
+            "winner": winner,
+        }
+    return None
+
+
