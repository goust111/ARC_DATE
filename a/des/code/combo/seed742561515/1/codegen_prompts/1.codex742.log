     6	def _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:
     7	    """
     8	    Detect legend blocks on the border.
     9	
    10	    A legend is a border-touching non-background component whose most common color is the legend
    11	    background `C` (and also the region border color it controls). The legend contains at least
    12	    two additional colors: a "center" color (more frequent) and an "indicator" color (less frequent).
    13	
    14	    The movement direction for regions with border color `C` is:
    15	      sign(centroid(indicator) - centroid(center))
    16	    """
    17	    h, w = g.shape
    18	    non_bg = g != bg
    19	    best: dict[int, tuple[int, tuple[int, int]]] = {}
    20	    for pts in components_mask(non_bg, connectivity=4):
    21	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
    22	            continue
    23	        # Legends are filled rectangles on the border.
    24	        r0, c0, r1, c1 = bbox_coords(pts)
    25	        area = (r1 - r0 + 1) * (c1 - c0 + 1)
    26	        if area != len(pts):
    27	            continue
    28	
    29	        counts: dict[int, int] = {}
    30	        for r, c in pts:
    31	            v = int(g[r, c])
    32	            counts[v] = counts.get(v, 0) + 1
    33	        if len(counts) != 3:
    34	            continue
    35	
    36	        bg_col = max(counts, key=counts.get)
    37	        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]
    38	        if len(others) < 2:
    39	            continue
    40	        others.sort()  # ascending by count
    41	        if others[0][0] == others[1][0]:
    42	            # Tie: choose center as the color closer to the rectangle center.
    43	            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])
    44	            cols = [others[0][1], others[1][1]]
    45	            cents = []
    46	            for col in cols:
    47	                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)
    48	                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))
    49	            cents.sort()
    50	            center_col = cents[0][1]
    51	            indicator_col = cents[1][1]
    52	        else:
    53	            indicator_col = others[0][1]
    54	            center_col = others[-1][1]
    55	
    56	        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]
    57	        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]
    58	        if not center or not indic:
    59	            continue
    60	
    61	        cc = np.mean(np.array(center, dtype=float), axis=0)
    62	        ci = np.mean(np.array(indic, dtype=float), axis=0)
    63	        vr, vc = (ci - cc).tolist()
    64	        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)
    65	        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)
    66	        if dr == 0 and dc == 0:
    67	            continue
    68	
