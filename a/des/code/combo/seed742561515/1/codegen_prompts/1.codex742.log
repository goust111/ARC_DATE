    31	def _scaled_index(i: int, src_len: int, dst_len: int) -> int:
    32	    assert src_len >= 1 and dst_len >= 1, "axis lengths must be positive"
    33	    if src_len == 1:
    34	        assert dst_len == 1, "a one-pixel motif axis maps to a one-pixel interior axis"
    35	        return 0
    36	    assert dst_len >= 2, "multi-pixel motif axis needs a multi-pixel interior axis"
    37	    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))
