   201	def _validate_frame_placement(canvas, ring, cavity, line_col, h, w):
   202	    """Check that ring+cavity can be placed on canvas without conflicts.
   203	
   204	    Returns True if: ring and cavity cells are empty, no cavity cell is
   205	    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and
   206	    at least one ring cell is 8-adjacent to a line_col pixel.
   207	    """
   208	    # Ring and cavity cells must all be empty
   209	    for rr, cc in ring:
   210	        if canvas[rr, cc] != -1:
   211	            return False
   212	    for rr, cc in cavity:
   213	        if canvas[rr, cc] != -1:
   214	            return False
   215	
   216	    # No cavity cell may be 8-adjacent to any line_col pixel
   217	    for cr, cc in cavity:
   218	        for nr, nc in neighbors8(cr, cc):
   219	            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
   220	                return False
   221	
   222	    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel
   223	    ring_set = set(ring)
   224	    for rr, cc in ring:
   225	        for nr, nc in neighbors8(rr, cc):
   226	            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:
   227	                continue
   228	            v = canvas[nr, nc]
   229	            if v != -1 and v != line_col:
   230	                return False
   231	
   232	    # At least one ring cell must be 8-adjacent to a line_col pixel
   233	    for rr, cc in ring:
   234	        for nr, nc in neighbors8(rr, cc):
   235	            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
   236	                return True
   237	    return False
