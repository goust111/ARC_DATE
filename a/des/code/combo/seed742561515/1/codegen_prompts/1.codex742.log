    70	def _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:
    71	    src_h, src_w = sprite.shape
    72	    dst_h, dst_w = target_shape
    73	    assert sprite.any(), "expected a nonempty sprite"
    74	
    75	    stroke = np.zeros((dst_h, dst_w), dtype=int)
    76	    coords = np.argwhere(sprite)
    77	    mapped: dict[tuple[int, int], tuple[int, int]] = {}
    78	    for sr, sc in coords:
    79	        tr = _scaled_index(int(sr), src_h, dst_h)
    80	        tc = _scaled_index(int(sc), src_w, dst_w)
    81	        mapped[(int(sr), int(sc))] = (tr, tc)
    82	        stroke[tr, tc] = 1
    83	
    84	    for sr, sc in coords:
    85	        sr = int(sr)
    86	        sc = int(sc)
    87	        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):
    88	            if (nr, nc) in mapped:
    89	                r0, c0 = mapped[(sr, sc)]
    90	                r1, c1 = mapped[(nr, nc)]
    91	                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)
    92	
    93	    return _fill_enclosed(stroke.astype(bool))
