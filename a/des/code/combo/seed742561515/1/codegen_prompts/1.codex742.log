   154	DIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps
   155	ORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps
   156	ORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps
   157	BORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells
   158	BIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck
   159	
   160	# Distractor network
   161	DISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames
   162	DISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network
   163	DISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range
   164	DISTRACTOR_SOLO_MAX = 2            # max solo distractor frames
   165	DISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network
   166	
   167	# Generation
   168	GEN_RETRIES = 300                  # outer retry budget in generate_input()
   169	# =========================================================
   170	
   171	DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
   172	ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
