    11	def _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    12	    b = bbox(mask)
    13	    if b is None:
    14	        return None
    15	    r0, c0, r1, c1 = b
    16	    h = int(r1 - r0 + 1)
    17	    w = int(c1 - c0 + 1)
    18	    if h < 3 or w < 3:
    19	        return None
    20	
    21	    expected = np.zeros_like(mask, dtype=bool)
    22	    expected[r0 : r1 + 1, c0] = True
    23	    expected[r0 : r1 + 1, c1] = True
    24	    expected[r0, c0 : c1 + 1] = True
    25	    expected[r1, c0 : c1 + 1] = True
    26	    if not np.array_equal(mask, expected):
    27	        return None
    28	    return int(r0), int(c0), int(r1), int(c1)
