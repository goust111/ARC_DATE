    40	def _fill_enclosed(stroke: np.ndarray) -> np.ndarray:
    41	    h, w = stroke.shape
    42	    open_space = ~stroke.astype(bool)
    43	    padded = np.pad(open_space, 1, constant_values=True)
    44	    seen = np.zeros_like(padded, dtype=bool)
    45	    q: deque[tuple[int, int]] = deque()
    46	    ph, pw = padded.shape
    47	
    48	    for r in range(ph):
    49	        for c in (0, pw - 1):
    50	            if padded[r, c] and not seen[r, c]:
    51	                seen[r, c] = True
    52	                q.append((int(r), int(c)))
    53	    for c in range(pw):
    54	        for r in (0, ph - 1):
    55	            if padded[r, c] and not seen[r, c]:
    56	                seen[r, c] = True
    57	                q.append((int(r), int(c)))
    58	
    59	    while q:
    60	        r, c = q.popleft()
    61	        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
    62	            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:
    63	                seen[nr, nc] = True
    64	                q.append((int(nr), int(nc)))
    65	
    66	    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]
    67	    return stroke.astype(bool) | holes
