   244	def _grow_line(grid, start, line_col, target_len, rng):
   245	    """Grow a meandering 8-connected 1px-wide path of line_col from start."""
   246	    h, w = grid.shape
   247	    path = [start]
   248	    dr_bias = 1 if start[0] < h // 2 else -1
   249	    dc_bias = 1 if start[1] < w // 2 else -1
   250	    cur = start
   251	    path_set = {start}
   252	    while len(path) < target_len:
   253	        # Build weighted direction list: diagonals preferred, bias-aligned boosted
   254	        dirs = []
   255	        for ddr, ddc in DIAG_DIRS:
   256	            aligned = (ddr == dr_bias or ddc == dc_bias)
   257	            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER
   258	            dirs.extend([(ddr, ddc)] * w_d)
   259	        for ddr, ddc in ORTHO_DIRS:
   260	            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)

