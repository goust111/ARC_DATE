 344: def _place_legends(rng: random.Random, grid: np.ndarray,
 345:                    ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:
 346:     """Place 1-2 legend patches at grid corners.
 347: 
 348:     Returns (legend_occupied mask, list of (wall_color, direction) pairs).
 349:     """
 350:     h, w = grid.shape
 351:     n_legends = rng.choice([1, 2])
 352:     corners = rng.sample(CORNERS, n_legends)
 353:     wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)
 354: 
 355:     legend_occupied = np.zeros((h, w), dtype=bool)
 356:     legends = []
 357: 
 358:     for corner, wc in zip(corners, wall_colors):
 359:         if rng.random() < CARDINAL_PROB:
 360:             dr, dc = rng.choice(CARDINAL_DIRS)
 361:             patch = _legend_5x5(wc, dr, dc)
 362:         else:
 363:             dr, dc = rng.choice(DIAGONAL_DIRS)
 364:             patch = _legend_6x7(wc, dr, dc)
 365:         ph, pw = patch.shape
 366:         r0, c0 = _corner_origin(corner, h, w, ph, pw)
 367:         paste(grid, patch, r0, c0)
 368:         # Reserve legend cells + buffer.
 369:         r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)
 370:         c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)
 371:         legend_occupied[r_lo:r_hi, c_lo:c_hi] = True
 372:         legends.append((wc, (dr, dc)))
 373: 
 374:     return legend_occupied, legends
 375: 
