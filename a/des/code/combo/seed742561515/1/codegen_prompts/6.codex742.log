 211: def _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],
 212:                    h: int, w: int) -> np.ndarray | None:
 213:     """Assign random colors to filled cells; returns None if coverage is incomplete."""
 214:     rows = {r for r, _ in filled}
 215:     cols = {c for _, c in filled}
 216:     if rows != set(range(h)) or cols != set(range(w)):
 217:         return None
 218:     non_red = [p for p in filled if p not in red_cells]
 219:     random.shuffle(non_red)
 220:     max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
 221:     if max_colors < MOTIF_COLORS_MIN:
 222:         return None
 223:     n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
 224:     pool = COLOR_POOL[:]
 225:     random.shuffle(pool)
 226:     extras = pool[: n_colors - 1]
 227:     grid = np.full((h, w), BG, dtype=int)
 228:     for r, c in red_cells:
 229:         grid[r, c] = RED
 230:     for i, (r, c) in enumerate(non_red):
 231:         grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
 232:     return grid
