 524: def _overlay_composites(canvas, legends):
 525:     """Stamp each legend's tiled composite onto the canvas (non-{0,6} pixels overwrite)."""
 526:     output = canvas.copy()
 527:     for leg in legends:
 528:         sp, rf = leg["sprite"], leg["rotated_frame"]
 529:         N = leg["N"]
 530:         t, l = leg["comp_top"], leg["comp_left"]
 531:         fh, fw = rf.shape
 532: 
 533:         # Build full composite by tiling the unit sprite into active frame cells
 534:         comp = np.zeros((fh * N, fw * N), dtype=int)
 535:         sprite_mask = (sp != 0) & (sp != 6)
 536:         for i in range(fh):
 537:             for j in range(fw):
 538:                 if rf[i, j]:
 539:                     r0, c0 = i * N, j * N
 540:                     comp[r0:r0 + N, c0:c0 + N][sprite_mask] = sp[sprite_mask]
 541: 
 542:         # Overwrite canvas where composite has content and canvas isn't color 6
 543:         region = output[t:t + fh * N, l:l + fw * N]
 544:         write_mask = (comp != 0) & (region != 6)
 545:         region[write_mask] = comp[write_mask]
 546:     return output
