 293: def _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:
 294:     """Stamp non-bg pixels from a scaled patch onto the output grid, aligned by red anchor.
 295:     Skips divider row/col, out-of-bounds pixels, and existing red pixels."""
 296:     rr_red, cc_red = np.where(patch_s == RED)
 297:     place_r0 = anchor_r - int(rr_red.min())
 298:     place_c0 = anchor_c - int(cc_red.min())
 299: 
 300:     # Source pixel coordinates and their target positions
 301:     src_rr, src_cc = np.where(patch_s != BG)
 302:     tgt_rr = src_rr + place_r0
 303:     tgt_cc = src_cc + place_c0
 304: 
 305:     # Mask: in-bounds, not on divider, target is not already red
 306:     valid = ((tgt_rr >= 0) & (tgt_rr < GRID_SIZE) &
 307:              (tgt_cc >= 0) & (tgt_cc < GRID_SIZE) &
 308:              (tgt_rr != MID) & (tgt_cc != MID))
 309:     tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]
 310:     not_red = out[tgt_rr, tgt_cc] != RED
 311:     out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]
