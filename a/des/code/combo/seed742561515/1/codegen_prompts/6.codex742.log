 191: def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
 192:     """Grow a 4-connected region from seeds until it has n_fill cells."""
 193:     filled = set(seeds)
 194:     frontier = set()
 195:     for r, c in seeds:
 196:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
 197:             nr, nc = r + dr, c + dc
 198:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
 199:                 frontier.add((nr, nc))
 200:     while len(filled) < n_fill and frontier:
 201:         cell = random.choice(list(frontier))
 202:         filled.add(cell)
 203:         frontier.discard(cell)
 204:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
 205:             nr, nc = cell[0] + dr, cell[1] + dc
 206:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
 207:                 frontier.add((nr, nc))
 208:     return filled
