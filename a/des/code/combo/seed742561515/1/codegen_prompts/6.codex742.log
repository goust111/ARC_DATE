 386: def _allocate_colors(num_legends):
 387:     """Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend."""
 388:     pool = list(USABLE_COLORS)
 389:     random.shuffle(pool)
 390: 
 391:     unit_color_sets = []
 392:     used_unit = set()
 393:     for _ in range(num_legends):
 394:         if len(pool) < 2:
 395:             return None
 396:         c1, c2 = pool.pop(), pool.pop()
 397:         unit_color_sets.append((c1, c2))
 398:         used_unit.update([c1, c2])
 399: 
 400:     bg_cands = [c for c in pool if c not in used_unit]
 401:     if len(bg_cands) < 2:
 402:         return None
 403:     random.shuffle(bg_cands)
 404:     bg_colors = (bg_cands[0], bg_cands[1])
 405: 
 406:     frame_colors = []
 407:     all_set = set(USABLE_COLORS)
 408:     for uc in unit_color_sets:
 409:         candidates = list(all_set - set(uc))
 410:         frame_colors.append(random.choice(candidates))
 411: 
 412:     return unit_color_sets, bg_colors, frame_colors
