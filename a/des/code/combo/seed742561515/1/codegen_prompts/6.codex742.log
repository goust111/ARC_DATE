 247:     def push_neighbors(r, c):
 248:         for nr, nc in neighbors4(r, c):
 249:             if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:
 250:                 frontier.append((nr, nc))
 251:     push_neighbors(sr, sc)
 252:     while len(blob) < target_size and frontier:
 253:         idx = rng.randrange(len(frontier))
 254:         r, c = frontier.pop(idx)
 255:         if (r, c) in blob or not canvas_mask[r, c]:
 256:             continue
 257:         blob.add((r, c))
 258:         push_neighbors(r, c)
 259:     if len(blob) < target_size:
 260:         return None
 261:     return blob
 262: 
 263: 
 264: def _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
 265:     """Cells 4-adjacent to blob but not in blob."""
 266:     wall = set()
 267:     for r, c in blob:
 268:         for nr, nc in neighbors4(r, c):
 269:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:
 270:                 wall.add((nr, nc))
 271:     return wall
 272: 
 273: 
 274: def _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
 275:     """Return blob with interior holes absorbed.
 276: 
 277:     Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid
 278:     border through non-barrier cells is trapped and gets absorbed into the blob.
 279:     """
 280:     walls = _blob_wall_cells(blob, h, w)
 281:     barrier = np.zeros((h, w), dtype=bool)
 282:     for r, c in blob:
 283:         barrier[r, c] = True
 284:     for r, c in walls:
 285:         barrier[r, c] = True
 286: 
 287:     # Flood-fill from border through non-barrier cells.
 288:     reachable = np.zeros((h, w), dtype=bool)
 289:     stack = []
 290:     for r in range(h):
 291:         for c in (0, w - 1):
 292:             if not barrier[r, c]:
 293:                 stack.append((r, c))
 294:     for c in range(w):
 295:         for r in (0, h - 1):
 296:             if not barrier[r, c]:
 297:                 stack.append((r, c))
 298:     while stack:
 299:         r, c = stack.pop()
 300:         if reachable[r, c] or barrier[r, c]:
 301:             continue
 302:         reachable[r, c] = True
 303:         for nr, nc in neighbors4(r, c):
 304:             if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:
 305:                 stack.append((nr, nc))
 306: 
 307:     trapped = (~reachable) & (~barrier)
 308:     if not trapped.any():
 309:         return blob
 310:     filled = set(blob)
 311:     for r, c in np.argwhere(trapped):
 312:         filled.add((int(r), int(c)))
 313:     return filled
 314: 
