 170: def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
 171:     """Nearest-neighbor resize supporting fractional scale ratios."""
 172:     src_h, src_w = img.shape
 173:     rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
 174:     cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
 175:     return img[rr[:, None], cc[None, :]]
