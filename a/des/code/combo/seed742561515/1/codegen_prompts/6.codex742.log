 268: def _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int]:
 269:     """Pick a random anchor position for the red block within the quadrant,
 270:     preferring positions where the full scaled motif fits inside the quadrant."""
 271:     q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
 272:     rr, cc = np.where(patch_s == RED)
 273:     red_r0, red_c0 = int(rr.min()), int(cc.min())
 274: 
 275:     # Range where the full motif fits inside the quadrant
 276:     fit_r0 = q_r0 + red_r0
 277:     fit_r1 = q_r1 - patch_s.shape[0] + 1 + red_r0
 278:     fit_c0 = q_c0 + red_c0
 279:     fit_c1 = q_c1 - patch_s.shape[1] + 1 + red_c0
 280: 
 281:     # Range where the anchor block itself fits inside the quadrant
 282:     anch_r0, anch_r1 = q_r0, q_r1 - size + 1
 283:     anch_c0, anch_c1 = q_c0, q_c1 - size + 1
 284: 
 285:     # Intersect: prefer full-fit, fall back to anchor-only fit
 286:     r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)
 287:     c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)
 288:     if r_lo <= r_hi and c_lo <= c_hi:
 289:         return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
 290:     return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)
