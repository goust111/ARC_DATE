 514:     bw = random.randint(BAND_WIDTH_MIN, max(BAND_WIDTH_MIN, dim // 2))
 515:     band_indices = np.arange(dim) // bw % 2
 516:     colors = np.array([bg1, bg2])
 517:     if band_dir == "h":
 518:         canvas[:] = colors[band_indices][:, None]
 519:     else:
 520:         canvas[:] = colors[band_indices][None, :]
