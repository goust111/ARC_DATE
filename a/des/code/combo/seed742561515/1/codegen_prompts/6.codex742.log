   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.
  10: 
  11:     Input structure:
  12:     - bg = most common color.
  13:     - Multi-color sprites in the interior; each has a minority-color "marker" pixel.
  14:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.
  15: 
  16:     Rule:
  17:     - Match each sprite to the border anchor sharing its marker color.
  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.
  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.
  20: 
  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.
  22:     """
  23:     g = np.array(grid, dtype=int)
  24:     H, W = g.shape
  25:     bg = int(get_bg(g))
  26: 
  27:     def is_border(r: int, c: int) -> bool:
  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))
  29: 
  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---
  31:     anchors_by_color: dict[int, tuple[int, int]] = {}
  32:     for r in range(H):
  33:         for c in range(W):
  34:             if not is_border(r, c):
  35:                 continue
  36:             v = int(g[r, c])
  37:             if v == int(bg):
  38:                 continue
  39:             ok = True
  40:             for rr, cc in neighbors4(int(r), int(c)):
  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):
  42:                     ok = False
  43:                     break
  44:             if ok and v not in anchors_by_color:
  45:                 anchors_by_color[int(v)] = (int(r), int(c))
  46: 
  47:     assert not (not anchors_by_color)
  48: 
  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}
  50: 
  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---
  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
  53: 
  54:     def component_marker_color(coords: np.ndarray) -> int | None:
  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.
  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]
  57:         cnt = Counter(vals)
  58:         if len(cnt) <= 1:
  59:             return None
  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
  61: 
  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:
  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).
  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]
  65:         if not pts:
  66:             return None
  67:         if len(pts) == 1:
  68:             return pts[0]
  69:         S = {(int(r), int(c)) for r, c in coords}
  70:         for r, c in pts:
  71:             for rr, cc in neighbors4(int(r), int(c)):
  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):
  73:                     return (int(r), int(c))
  74:         return pts[0]
  75: 
  76:     moves: list[tuple[np.ndarray, int, int]] = []
  77: 
  78:     for comp in comps:
  79:         coords = comp["coords"]
  80:         if coords.size == 0:
  81:             continue
  82: 
  83:         # --- STEP 3) Decide marker color for this component. ---
  84:         marker_col = component_marker_color(coords)
  85:         if marker_col is None:
  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.
  87:             if int(coords.shape[0]) != 1:
  88:                 continue
  89:             r, c = map(int, coords[0])
  90:             v = int(g[r, c])
  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:
  92:                 continue
  93:             marker_col = int(v)
  94: 
  95:         if int(marker_col) not in anchors_by_color:
  96:             continue
  97: 
  98:         mp = marker_pixel(coords, int(marker_col))
  99:         if mp is None:
 100:             continue
 101: 
 102:         ar, ac = anchors_by_color[int(marker_col)]
 103: 
 104:         # --- STEP 4) Compute translation (dr,dc). ---
 105:         on_top_bottom = int(ar) in (0, int(H - 1))
 106:         on_left_right = int(ac) in (0, int(W - 1))
 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner
 108: 
 109:         dr = 0
 110:         dc = 0
 111:         if horizontal:
 112:             dc = int(ac - mp[1])
 113:         else:
 114:             dr = int(ar - mp[0])
 115: 
 116:         moves.append((coords, int(dr), int(dc)))
 117: 
 118:     out = g.copy()
 119: 
 120:     # --- STEP 5) Apply all moves. ---
 121:     # Clear moved components first (prevents collisions with their original locations).
 122:     for coords, _dr, _dc in moves:
 123:         out[coords[:, 0], coords[:, 1]] = int(bg)
 124: 
 125:     # Paste moved components:
 126:     # - clip out-of-bounds pixels
 127:     # - do not overwrite existing non-bg pixels
 128:     for coords, dr, dc in moves:
 129:         for r, c in coords:
 130:             rr = int(r) + int(dr)
 131:             cc = int(c) + int(dc)
 132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):
 133:                 out[rr, cc] = int(g[int(r), int(c)])
 134: 
 135:     return out
 136: 
 137: # --------------- generator (o5x) ---------------
 138: 
 139: # CFG: palette and canvas bounds.
 140: _COLORS = tuple(range(10))
 141: _BG_COLOR_RANGE = (1, 8)
 142: _GRID_HEIGHT_RANGE = (10, 22)
 143: _GRID_WIDTH_RANGE = (8, 22)
 144: 
 145: # CFG: placement isolation and anchor location.
 146: _NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
 147: _INNER_BORDER_GAP = 1
 148: _ANCHOR_EDGE_MARGIN = 2
 149: _ISOLATION_RADIUS = 1
 150: 
 151: # CFG: anchor, sprite, and retry counts.
 152: _ANCHOR_COUNT_RANGE = (1, 3)
 153: _SPRITE_COUNT_RANGE = (3, 5)
 154: _BODY_AREA_RANGE = (4, 13)
 155: _GEN_RETRY_LIMIT = 300
 156: 
 157: # CFG: body geometry and shape mix.
 158: _BODY_HEIGHT_RANGE = (2, 5)
 159: _BODY_WIDTH_RANGE = (3, 7)
 160: _FRAME_HEIGHT_RANGE = (3, 5)
 161: _FRAME_WIDTH_RANGE = (3, 7)
 162: _FRAME_MIN_AREA = 8
 163: _FRAME_MAX_GAP = 3
 164: _FRAME_BODY_THRESHOLD = 0.28
 165: _WIDE_BODY_THRESHOLD = 0.55
 166: _SYMMETRIC_BODY_THRESHOLD = 0.82
 167: _SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3
 168: _SYMMETRIC_TRANSPOSE_PROB = 0.45
 169: _MARKER_INTERIOR_PROB = 0.65
 170: _FLIP_PROB = 0.5
 171: 
 172: # CFG: optional singleton distractors.
 173: _DISTRACTOR_PROB = 0.15
 174: _DISTRACTOR_COUNT_RANGE = (1, 4)
 175: 
 176: _GROW_BODY_SEEDS = [
 177:     {(0, 0), (0, 1), (0, 2), (1, 0)},
 178:     {(0, 0), (0, 1), (0, 2), (1, 2)},
 179:     {(0, 0), (1, 0), (1, 1), (1, 2)},
 180:     {(0, 2), (1, 0), (1, 1), (1, 2)},
 181:     {(0, 1), (1, 0), (1, 1), (1, 2)},
 182: ]
 183: 
 184: 
 185: def _norm(cells):
 186:     r0 = min(r for r, _c in cells)
 187:     c0 = min(c for _r, c in cells)
 188:     return {(r - r0, c - c0) for r, c in cells}
 189: 
 190: 
 191: def _bbox(cells):
 192:     return (
 193:         min(r for r, _c in cells),
 194:         min(c for _r, c in cells),
 195:         max(r for r, _c in cells),
 196:         max(c for _r, c in cells),
 197:     )
 198: 
 199: 
 200: def _flip(cells):
 201:     cells = set(cells)
 202:     if random.random() < _FLIP_PROB:
 203:         mc = max(c for _r, c in cells)
 204:         cells = {(r, mc - c) for r, c in cells}
 205:     if random.random() < _FLIP_PROB:
 206:         mr = max(r for r, _c in cells)
 207:         cells = {(mr - r, c) for r, c in cells}
 208:     return _norm(cells)
 209: 
 210: 
 211: def _inclusive_range(bounds):
 212:     return range(int(bounds[0]), int(bounds[1]) + 1)
 213: 
 214: 
 215: def _frontier_cells(cells, height, width):
 216:     """Return empty 4-neighbor cells inside the shape canvas."""
 217:     frontier = []
 218:     for r, c in cells:
 219:         for dr, dc in _NEIGHBORS4:
 220:             rr, cc = r + dr, c + dc
 221:             if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:
 222:                 frontier.append((rr, cc))
 223:     return frontier
 224: 
 225: 
 226: def _grow_body(area):
 227:     choices = [
 228:         (h, w)
 229:         for h in _inclusive_range(_BODY_HEIGHT_RANGE)
 230:         for w in _inclusive_range(_BODY_WIDTH_RANGE)
 231:         if h * w >= area
 232:     ]
 233:     h, w = random.choice(choices)
 234:     cells = set(random.choice(_GROW_BODY_SEEDS))
 235:     while len(cells) < area:
 236:         frontier = _frontier_cells(cells, h, w)
 237:         if not frontier:
 238:             return _grow_body(area)
 239:         cells.add(random.choice(frontier))
 240:     return _flip(cells)
 241: 
 242: 
 243: def _symmetric_body(area):
 244:     choices = []
 245:     for height in _inclusive_range(_BODY_HEIGHT_RANGE):
 246:         extra = area - height
 247:         if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:
 248:             choices.append((height, extra // 2))
 249:     if not choices:
 250:         return _grow_body(area)
 251: 
 252:     height, pair_count = random.choice(choices)
 253:     cells = {(r, 1) for r in range(height)}
 254:     rows = list(range(height))
 255:     random.shuffle(rows)
 256:     for r in rows[:pair_count]:
 257:         cells.add((r, 0))
 258:         cells.add((r, 2))
 259: 
 260:     if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:
 261:         cells = {(c, r) for r, c in cells}
 262:     return _flip(cells)
 263: 
 264: 
 265: def _wide_body(area):
 266:     width = random.randint(_BODY_WIDTH_RANGE[0], min(_BODY_WIDTH_RANGE[1], area - 1))
 267:     height = random.choice([h for h in _inclusive_range(_BODY_HEIGHT_RANGE) if h * width >= area])
 268:     cells = {(0, c) for c in range(width)}
 269:     cells.add((1, random.randrange(width)))
 270:     while len(cells) < area:
 271:         frontier = _frontier_cells(cells, height, width)
 272:         cells.add(random.choice(frontier))
 273:     return _flip(cells)
 274: 
 275: 
 276: def _frame_body(area):
 277:     choices = []
 278:     for h in _inclusive_range(_FRAME_HEIGHT_RANGE):
 279:         for w in _inclusive_range(_FRAME_WIDTH_RANGE):
 280:             perim = 2 * h + 2 * w - 4
 281:             removable = 2 * max(0, h - 2) + 2 * max(0, w - 2)
 282:             if perim >= area and perim - area <= min(_FRAME_MAX_GAP, removable):
 283:                 choices.append((h, w))
 284:     if not choices:
 285:         return _grow_body(area)
 286: 
 287:     h, w = random.choice(choices)
 288:     cells = {
 289:         (r, c)
 290:         for r in range(h)
 291:         for c in range(w)
 292:         if r in (0, h - 1) or c in (0, w - 1)
 293:     }
 294:     gap = len(cells) - area
 295:     if gap:
 296:         removable = [
 297:             (r, c)
 298:             for r, c in cells
 299:             if not (r in (0, h - 1) and c in (0, w - 1))
 300:         ]
 301:         for cell in random.sample(removable, gap):
 302:             cells.remove(cell)
 303:     return _flip(cells)
 304: 
 305: 
 306: def _make_body(area):
 307:     x = random.random()
 308:     if area >= _FRAME_MIN_AREA and x < _FRAME_BODY_THRESHOLD:
 309:         return _frame_body(area)
 310:     if x < _WIDE_BODY_THRESHOLD:
 311:         return _wide_body(area)
 312:     if x < _SYMMETRIC_BODY_THRESHOLD:
 313:         return _symmetric_body(area)
 314:     return _grow_body(area)
 315: 
 316: 
 317: def _marker_cell(body):
 318:     r0, c0, r1, c1 = _bbox(body)
 319:     interior, exterior = set(), set()
 320:     for r, c in body:
 321:         for dr, dc in _NEIGHBORS4:
 322:             p = (r + dr, c + dc)
 323:             if p in body:
 324:                 continue
 325:             if r0 <= p[0] <= r1 and c0 <= p[1] <= c1:
 326:                 interior.add(p)
 327:             else:
 328:                 exterior.add(p)
 329:     pool = list(interior if interior and random.random() < _MARKER_INTERIOR_PROB else (exterior | interior))
 330:     return random.choice(pool)
 331: 
 332: 
 333: def _make_sprite(area, body_color, marker_color, bg):
 334:     body = _make_body(area)
 335:     marker = _marker_cell(body)
 336:     all_cells = set(body) | {marker}
 337:     r0, c0, r1, c1 = _bbox(all_cells)
 338:     patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
 339:     for r, c in body:
 340:         patch[r - r0, c - c0] = int(body_color)
 341:     patch[marker[0] - r0, marker[1] - c0] = int(marker_color)
 342:     return {"patch": patch, "offset": (marker[0] - r0, marker[1] - c0)}
 343: 
 344: 
 345: def _top_left(sprite, marker_r, marker_c):
 346:     off_r, off_c = sprite["offset"]
 347:     return int(marker_r) - int(off_r), int(marker_c) - int(off_c)
 348: 
 349: 
 350: def _can_place(canvas, sprite, marker_r, marker_c, bg):
 351:     patch = sprite["patch"]
 352:     top, left = _top_left(sprite, marker_r, marker_c)
 353:     h, w = patch.shape
 354:     H, W = canvas.shape
 355:     if top < _INNER_BORDER_GAP or left < _INNER_BORDER_GAP:
 356:         return False
 357:     if top + h > H - _INNER_BORDER_GAP or left + w > W - _INNER_BORDER_GAP:
 358:         return False
 359:     mask = patch != int(bg)
 360:     view = canvas[top : top + h, left : left + w]
 361:     if bool((view[mask] != int(bg)).any()):
 362:         return False
 363:     return not _touches_foreground(canvas, mask, top, left, bg)
 364: 
 365: 
 366: def _touches_foreground(canvas, mask, top, left, bg):
 367:     """Return True if any patch cell has a non-bg 8-neighbor on canvas."""
 368:     h, w = mask.shape
 369:     radius = _ISOLATION_RADIUS
 370:     occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)
 371:     touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)
 372:     span = 2 * radius + 1
 373:     for dr in range(span):
 374:         for dc in range(span):
 375:             touch_zone[dr : dr + h, dc : dc + w] |= mask
 376:     return bool((occupied & touch_zone).any())
 377: 
 378: 
 379: def _place(canvas, sprite, marker_r, marker_c, bg):
 380:     top, left = _top_left(sprite, marker_r, marker_c)
 381:     paste(canvas, sprite["patch"], top, left, transparent=int(bg))
 382: 
 383: 
 384: def _anchor_ok(canvas, r, c, bg):
 385:     H, W = canvas.shape
 386:     if not (r in (0, H - 1) or c in (0, W - 1)):
 387:         return False
 388:     if r in (0, H - 1) and c in (0, W - 1):
 389:         return False
 390:     return _isolated_bg_cell(canvas, r, c, bg)
 391: 
 392: 
 393: def _isolated_bg_cell(canvas, r, c, bg):
 394:     """Return True when a cell and its in-bounds 8-neighborhood are bg."""
 395:     H, W = canvas.shape
 396:     radius = _ISOLATION_RADIUS
 397:     r0, r1 = max(0, r - radius), min(H, r + radius + 1)
 398:     c0, c1 = max(0, c - radius), min(W, c + radius + 1)
 399:     return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())
 400: 
 401: 
 402: def _anchor_candidates(canvas, bg):
 403:     H, W = canvas.shape
 404:     rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))
 405:     rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))
 406:     cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))
 407:     cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))
 408:     out = []
 409:     for c in cols:
 410:         out.append(("h", 0, c))
 411:         out.append(("h", H - 1, c))
 412:     for r in rows:
 413:         out.append(("v", r, 0))
 414:         out.append(("v", r, W - 1))
 415:     random.shuffle(out)
 416:     return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]
 417: 
 418: 
 419: def _put_anchor(canvas, r, c, color):
 420:     paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))
 421: 
 422: 
 423: def _aligned_positions(canvas, sprite, anchor, bg):
 424:     H, W = canvas.shape
 425:     if anchor["axis"] == "h":
 426:         return [
 427:             (r, anchor["c"])
 428:             for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)
 429:             if _can_place(canvas, sprite, r, anchor["c"], bg)
 430:         ]
 431:     return [
 432:         (anchor["r"], c)
 433:         for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)
 434:         if _can_place(canvas, sprite, anchor["r"], c, bg)
 435:     ]
 436: 
 437: 
 438: def _scatter_positions(canvas, sprite, anchor, marker, bg):
 439:     H, W = canvas.shape
 440:     mr, mc = marker
 441:     if anchor["axis"] == "h":
 442:         return [
 443:             (mr, c)
 444:             for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)
 445:             if c != mc and _can_place(canvas, sprite, mr, c, bg)
 446:         ]
 447:     return [
 448:         (r, mc)
 449:         for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)
 450:         if r != mr and _can_place(canvas, sprite, r, mc, bg)
 451:     ]
 452: 
 453: 
 454: def _body_color(bg, marker, used):
 455:     pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]
 456:     if not pool:
 457:         pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]
 458:     return random.choice(pool)
 459: 
 460: 
 461: def _bg_is_mode(grid, bg):
 462:     counts = Counter(map(int, grid.ravel()))
 463:     return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)
 464: 
 465: 
 466: def _add_distractors(out, inp, anchors, bg):
 467:     vertical = [a for a in anchors if a["axis"] == "v"]
 468:     if not vertical or random.random() >= _DISTRACTOR_PROB:
 469:         return
 470:     anchor = random.choice(vertical)
 471:     sprite = {"patch": np.array([[anchor["color"]]], dtype=int), "offset": (0, 0)}
 472:     for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):
 473:         pairs = []
 474:         for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):
 475:             if not _can_place(out, sprite, anchor["r"], c, bg):
 476:                 continue
 477:             for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):
 478:                 if r != anchor["r"] and _can_place(inp, sprite, r, c, bg):
 479:                     pairs.append((r, c))
 480:         if not pairs:
 481:             return
 482:         in_r, col = random.choice(pairs)
 483:         _place(out, sprite, anchor["r"], col, bg)
 484:         _place(inp, sprite, in_r, col, bg)
 485: 
 486: 
 487: def _gen_attempt():
 488:     bg, out, inp = _new_canvas_pair()
 489:     placed = _place_anchors(out, inp, bg)
 490:     if placed is None:
 491:         return None
 492:     anchor_colors, anchors = placed
 493: 
 494:     marker_colors = _marker_color_sequence(anchor_colors)
 495:     sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)
 496:     if sprites is None:
 497:         return None
 498: 
 499:     if not _scatter_sprites(inp, sprites, bg):
 500:         return None
 501: 
 502:     _add_distractors(out, inp, anchors, bg)
 503:     if not _generated_grid_is_valid(inp, out, bg):
 504:         return None
 505:     return inp
 506: 
 507: 
 508: def _new_canvas_pair():
 509:     """Choose grid size/background and return matching output/input canvases."""
 510:     H = random.randint(*_GRID_HEIGHT_RANGE)
 511:     W = random.randint(*_GRID_WIDTH_RANGE)
 512:     bg = random.randint(*_BG_COLOR_RANGE)
 513:     out = np.full((H, W), int(bg), dtype=int)
 514:     inp = np.full((H, W), int(bg), dtype=int)
 515:     return bg, out, inp
 516: 
 517: 
 518: def _place_anchors(out, inp, bg):
 519:     """Place distinct isolated border anchors into both canvases."""
 520:     anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))
 521:     anchors = []
 522:     for color in anchor_colors:
 523:         candidates = _anchor_candidates(out, bg)
 524:         if not candidates:
 525:             return None
 526:         axis, r, c = random.choice(candidates)
 527:         anchor = {"color": int(color), "r": int(r), "c": int(c), "axis": axis}
 528:         anchors.append(anchor)
 529:         _put_anchor(out, r, c, color)
 530:         _put_anchor(inp, r, c, color)
 531:     return anchor_colors, anchors
 532: 
 533: 
 534: def _marker_color_sequence(anchor_colors):
 535:     """Expand anchor colors to the sprite count, allowing repeated markers."""
 536:     n_sprites = random.randint(*_SPRITE_COUNT_RANGE)
 537:     marker_colors = anchor_colors[:]
 538:     while len(marker_colors) < n_sprites:
 539:         marker_colors.append(random.choice(anchor_colors))
 540:     random.shuffle(marker_colors)
 541:     return marker_colors
 542: 
 543: 
 544: def _place_aligned_sprites(out, anchors, marker_colors, bg):
 545:     """Build sprites in their solved locations and return their align metadata."""
 546:     by_color = {a["color"]: a for a in anchors}
 547:     used_body = set()
 548:     sprites = []
 549:     for marker in marker_colors:
 550:         anchor = by_color[int(marker)]
 551:         body = _body_color(bg, marker, used_body)
 552:         used_body.add(body)
 553:         sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)
