 178: def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:
 179:     """Reflect and scale the source patch for a given quadrant and target anchor size."""
 180:     p = patch
 181:     if qr:
 182:         p = np.fliplr(p)
 183:     if qb:
 184:         p = np.flipud(p)
 185:     ratio = target_size / SOURCE_ANCHOR_SIZE
 186:     h = max(1, int(round(p.shape[0] * ratio)))
 187:     w = max(1, int(round(p.shape[1] * ratio)))
 188:     return _resize_nn(p, h, w)
