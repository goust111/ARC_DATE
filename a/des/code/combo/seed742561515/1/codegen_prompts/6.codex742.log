 235: def _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:
 236:     """Build the TL motif patch. Block method upscales a logical grid by SOURCE_ANCHOR_SIZE;
 237:     freeform method grows directly at pixel resolution with a 2x2 red anchor."""
 238:     S = SOURCE_ANCHOR_SIZE
 239:     use_block = needs_block or random.random() < BLOCK_PROB
 240:     if use_block:
 241:         lh, lw = random.choice(BLOCK_DIMS)
 242:         n_cells = lh * lw
 243:         min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
 244:         max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
 245:         ar, ac = random.randrange(lh), random.randrange(lw)
 246:         filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
 247:         logical = _assign_colors(filled, {(ar, ac)}, lh, lw)
 248:         if logical is None:
 249:             return None
 250:         patch = np.repeat(np.repeat(logical, S, axis=0), S, axis=1)
 251:         return patch, ar * S, ac * S
 252:     else:
 253:         h = random.randint(*FREEFORM_H_RANGE)
 254:         w = random.randint(*FREEFORM_W_RANGE)
 255:         ar, ac = random.randint(0, h - S), random.randint(0, w - S)
 256:         red_cells = {(ar + dr, ac + dc) for dr in range(S) for dc in range(S)}
 257:         min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))
 258:         max_fill = int(np.floor(FILL_RATIO_MAX * h * w))
 259:         if max_fill < min_fill:
 260:             return None
 261:         filled = _grow_4conn(h, w, red_cells, random.randint(min_fill, max_fill))
 262:         patch = _assign_colors(filled, red_cells, h, w)
 263:         if patch is None:
 264:             return None
 265:         return patch, ar, ac
