+
+    order = list(range(n_pairs))
+    rng.shuffle(order)
+    for idx in order:
+        if not _place_pair(
+            rng,
+            grid,
+            out,
+            occupied,
+            frame_colors[idx],
+            fill_colors[idx],
+            orientations[idx],
+        ):
+            return None
+
+    return grid, out
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        case = _generate_case(rng)
+        if case is None:
+            continue
+        grid, expected = case
+        try:
+            if np.array_equal(main(grid), expected):
