    out[kr, kc] = color
    out[left.r0 : left.r1 + 1, left.c1 + 1 : right.c0] = fill


def _fill_horizontal_pair(out: np.ndarray, color: int, a: _Bar, b: _Bar) -> None:
    top, bottom = sorted([a, b], key=lambda bar: bar.r0)
