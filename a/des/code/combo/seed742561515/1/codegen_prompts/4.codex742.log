+    grid[r0 + top_h + gap : r0 + top_h + gap + bottom_h, c0 : c0 + width] = frame_color
+    out[r0 : r0 + top_h, c0 : c0 + width] = frame_color
+    out[r0 + top_h + gap : r0 + top_h + gap + bottom_h, c0 : c0 + width] = frame_color
