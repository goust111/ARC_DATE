+def _path_capacity(path: list[tuple[int, int]], reserved: set[tuple[int, int]]) -> int:
+    best = 0
+    run = 0
+    for cell in path:
+        if cell in reserved:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+    return best
+
+
+def _paint_rectangle(
+    grid: np.ndarray,
+    reserved: set[tuple[int, int]],
+    path: list[tuple[int, int]],
+    orientation: str,
+    color: int,
+    length: int,
