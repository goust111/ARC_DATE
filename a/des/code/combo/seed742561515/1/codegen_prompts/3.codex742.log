+
+
+def _try_place_multi(
+    grid: np.ndarray,
+    reserved: set[tuple[int, int]],
+    paths: dict[str, list[tuple[int, int]]],
+    usable_dirs: list[str],
+    palette: tuple[int, ...],
+) -> bool:
+    if len(usable_dirs) < 2 or len(palette) < 2:
+        return False
+
+    color_count = 2
+    if len(usable_dirs) >= 3 and len(palette) >= 3 and random.random() < 0.35:
+        color_count = 3
+
