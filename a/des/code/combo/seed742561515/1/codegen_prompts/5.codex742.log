+
+    regions = _extract_regions(grid)
+    if len(regions) != n_regions:
+        return None
+
+    orientations = {_region_orientation(region) for region in regions}
+    if n_regions >= 2 and orientations != {"horizontal", "vertical"}:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
