+def _sample_branch_plan(n_regions: int, rng: random.Random) -> list[str]:
+    if n_regions == 1:
+        return ["h_tie" if rng.random() < 0.2 else ("h_strict" if rng.random() < 0.5 else "v_strict")]
+
+    plan = ["h_strict", "v_strict"]
