+        geom = _sample_geometry(branch, h, w, rng)
+        if geom is None:
+            return None
+        inner_h, inner_w, candidates = geom
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+        if h - outer_h < 2 or w - outer_w < 2:
+            return None
+
+        for _ in range(PLACE_RETRIES):
