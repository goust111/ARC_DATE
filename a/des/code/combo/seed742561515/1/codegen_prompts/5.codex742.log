+def _seed_candidates(inner_h: int, inner_w: int, branch: str) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for r in range(1, inner_h - 1):
+        for c in range(1, inner_w - 1):
+            if _branch_for_seed(r, c, inner_h, inner_w) == branch:
+                coords.append((r, c))
+    return coords
+
