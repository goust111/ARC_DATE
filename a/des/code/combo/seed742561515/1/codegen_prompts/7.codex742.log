+            bottom_h = random.randint(3, 7)
+            total_h = top_h + 1 + bottom_h
+            max_r0 = h - total_h - 1
+            max_c0 = w - span_w - 1
+            if max_r0 < 1 or max_c0 < 1:
+                continue
+            c0 = random.randint(1, max_c0)
+            r0 = _rand_with_parity(1, max_r0, (want - c0) % 2)
