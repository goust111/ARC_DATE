+def _analyze_ring(grid: np.ndarray, bg: np.ndarray, coords: np.ndarray) -> Ring:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0, r1 = int(rows.min()), int(rows.max())
+    c0, c1 = int(cols.min()), int(cols.max())
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
