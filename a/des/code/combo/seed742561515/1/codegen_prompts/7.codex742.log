+    want = _mode_parity(blue_even, mode)
+    for _ in range(PLACE_ATTEMPTS):
+        rh, rw = _sample_dims(mode)
+        max_r0 = h - rh - 1
+        max_c0 = w - rw - 1
+        if max_r0 < 1 or max_c0 < 1:
