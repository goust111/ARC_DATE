+
+
+def _candidate_ok(bbox: BBox, mode: str, placed: list[Ring]) -> bool:
+    safe = _safe_bbox(mode, bbox)
+    for other in placed:
+        if _boxes_overlap_with_gap(bbox, other.bbox, 1):
+            return False
+        if _boxes_overlap_with_gap(safe, _safe_bbox(other.mode, other.bbox), 1):
+            return False
+    return True
