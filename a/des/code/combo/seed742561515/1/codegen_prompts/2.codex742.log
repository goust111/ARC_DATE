+
+def _can_place_with_padding(occupied: np.ndarray, mask: np.ndarray, top: int, left: int, pad: int) -> bool:
+    h, w = occupied.shape
+    mh, mw = mask.shape
+    if top < 0 or left < 0 or top + mh > h or left + mw > w:
+        return False
+    for dr, dc in np.argwhere(mask):
+        rr = int(top + dr)
+        cc = int(left + dc)
+        r0 = max(0, rr - pad)
+        r1 = min(h, rr + pad + 1)
+        c0 = max(0, cc - pad)
+        c1 = min(w, cc + pad + 1)
