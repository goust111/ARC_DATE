+def _neighbors(r: int, c: int, h: int, w: int, dirs) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in dirs:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
