+    tower_leaves = rng.sample(leaves, towers_count)
+    tower_colors = rng.sample(list(TOWER_COLORS), towers_count)
+    tower_by_leaf = {leaf: color for leaf, color in zip(tower_leaves, tower_colors, strict=False)}
