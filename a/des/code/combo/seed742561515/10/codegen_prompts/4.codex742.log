+    h = margin * 2 + step * (rows - 1) + 1
+    w = margin * 2 + step * (cols - 1) + 1
+    inp = np.full((h, w), BLACK, dtype=int)
+
+    for a, b in edges:
+        ca = _node_center(a, step, margin)
+        cb = _node_center(b, step, margin)
