+    bounds: list[tuple[int, int]] = []
+    start = 0
+    for idx in range(parts):
+        extra = remainder if idx == parts - 1 else 0
+        stop = start + base + extra
+        bounds.append((start, stop))
+        start = stop
+    assert bounds[-1][1] == height
+    return bounds
