+def _valid_generated_grid(grid: np.ndarray) -> bool:
+    try:
+        buildings = _extract_buildings(grid)
+        output = main(grid)
+    except Exception:
+        return False
+
+    flags_present = {int(building["flag"]) for building in buildings}
