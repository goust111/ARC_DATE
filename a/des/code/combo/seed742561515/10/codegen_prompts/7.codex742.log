+
+    collector_inner_w, collector_inner_h = _choose_collector_geometry(rng, sprites)
+    collector_outer_w = collector_inner_w + 2
+    collector_outer_h = collector_inner_h + 2
+
+    board_top = rng.randint(1, 2)
