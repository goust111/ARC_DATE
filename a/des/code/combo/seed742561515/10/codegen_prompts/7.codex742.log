+
+
+def _choose_collector_geometry(
+    rng: random.Random, sprites: list[np.ndarray]
+) -> tuple[int, int]:
+    max_w = max(sprite.shape[1] for sprite in sprites)
+    total_w = sum(sprite.shape[1] for sprite in sprites)
+    candidates: list[tuple[int, int, int]] = []
