+
+    grid_h = collector_top + collector_outer_h + rng.randint(1, 2)
+    grid_w = max(
+        mold_right + rng.randint(1, 2),
+        collector_left + collector_outer_w + rng.randint(1, 2),
+        board_right + rng.randint(2, 4),
