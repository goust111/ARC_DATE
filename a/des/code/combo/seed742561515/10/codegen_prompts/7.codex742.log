+    r0 = int(points[:, 0].min())
+    r1 = int(points[:, 0].max())
+    c0 = int(points[:, 1].min())
+    c1 = int(points[:, 1].max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
