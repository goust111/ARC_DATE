+
+
+def _find_unique_template_match(board_mask: np.ndarray, template: np.ndarray) -> tuple[int, int]:
+    hits = _all_template_matches(board_mask, template)
+    assert len(hits) == 1, f"template must match exactly once, got {len(hits)}"
