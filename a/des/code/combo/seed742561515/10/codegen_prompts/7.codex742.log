+def _feature_corners(
+    board_rect: tuple[int, int, int, int], holes: list[tuple[int, int, int, int]]
+) -> list[tuple[int, int]]:
+    rects = [board_rect] + holes
+    corners: list[tuple[int, int]] = []
+    for r0, c0, h, w in rects:
+        r1 = r0 + h - 1
+        c1 = c0 + w - 1
+        corners.extend([(r0, c0), (r0, c1), (r1, c0), (r1, c1)])
