+
+def _label_rooms(grid: np.ndarray, doors: list[dict[str, int | str]]) -> tuple[np.ndarray, dict[int, dict[str, object]]]:
+    closed = np.asarray(grid, dtype=int).copy()
+    for door in doors:
+        closed[int(door["r"]), int(door["c"])] = WALL
