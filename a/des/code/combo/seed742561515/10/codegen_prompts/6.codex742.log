+            coords = np.asarray(pts, dtype=int)
+            r0, c0, r1, c1 = _bbox(coords)
+            assert bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1]))
+            rooms[next_id] = {
+                "bbox": (r0, c0, r1, c1),
+                "source": None,
+                "doors": [],
