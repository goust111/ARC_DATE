+def _trace_room(
+    grid: np.ndarray,
+    contrib: np.ndarray,
+    rooms: dict[int, dict[str, object]],
+    door_map: dict[tuple[int, int], dict[str, int | str]],
+    room_id: int,
+    direction: str,
+    line: int,
+    color: int,
