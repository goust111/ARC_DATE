+    width = col_starts[-1] + room_w[-1] + 1
+
+    grid = np.full((height, width), BLACK, dtype=int)
+    grid[0, :] = WALL
+    grid[-1, :] = WALL
+    grid[:, 0] = WALL
+    grid[:, -1] = WALL
