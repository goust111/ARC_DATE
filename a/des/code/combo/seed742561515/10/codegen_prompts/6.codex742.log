+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+AZURE = 8
+
+WALL = GREY
+SOURCE_COLORS = (RED, GREEN, BLUE)
+ROTATE_COLOR = {RED: GREEN, GREEN: BLUE, BLUE: RED}
+COLOR_TO_BIT = {RED: 1, GREEN: 2, BLUE: 4}
+BIT_TO_COLOR = {
+    1: RED,
+    2: GREEN,
+    3: YELLOW,
