+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _detect_doors(grid: np.ndarray) -> list[dict[str, int | str]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
