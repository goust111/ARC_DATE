+        sr0, sc0, sr1, sc1 = source["bbox"]  # type: ignore[index]
+        color = int(source["color"])  # type: ignore[index]
+        source_rows = {int(sr0), int(sr1)}
+        source_cols = {int(sc0), int(sc1)}
