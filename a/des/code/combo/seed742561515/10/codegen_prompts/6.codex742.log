+            if int(g[r, c]) != BLACK:
+                continue
+            vertical = (
+                int(g[r - 1, c]) == WALL
+                and int(g[r + 1, c]) == WALL
+                and int(g[r, c - 1]) != WALL
+                and int(g[r, c + 1]) != WALL
+            )
+            horizontal = (
+                int(g[r, c - 1]) == WALL
+                and int(g[r, c + 1]) == WALL
+                and int(g[r - 1, c]) != WALL
+                and int(g[r + 1, c]) != WALL
+            )
+            if vertical:
+                doors.append({"r": r, "c": c, "orient": "vertical"})
