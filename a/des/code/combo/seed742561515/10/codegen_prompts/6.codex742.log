+        exit_info = door_map.get(exit_pos)
+        if exit_info is not None and str(exit_info["orient"]) == "vertical" and int(exit_info["right"]) == room_id:
+            _mark_cell(contrib, grid, exit_pos[0], exit_pos[1], color)
+            _trace_room(
+                grid,
+                contrib,
+                rooms,
+                door_map,
+                int(exit_info["left"]),
+                direction,
+                line,
+                ROTATE_COLOR[color],
