+    rng.shuffle(regions)
+    for color, region in zip(piece_colors, regions):
+        for r, c in region:
+            container[r + 1, c + 1] = color
+
+    gap = rng.randint(*STACK_GAP_RANGE)
+    patch = np.full((projection.shape[0] + gap + container.shape[0], container.shape[1]), BLACK, dtype=int)
