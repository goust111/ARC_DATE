+GREY = 5
+MAROON = 9
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8)
+SPECIAL_COLORS = {BLACK, GREY, MAROON}
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
