+    for arrow in arrows:
+        direction = str(arrow["direction"])
+        tip_r, tip_c = map(int, arrow["tip"])
+        arrow_rows = [int(r) for r, _c in arrow["coords"]]
+        arrow_cols = [int(c) for _r, c in arrow["coords"]]
