+    "left": frozenset({(0, 0), (1, 0), (1, 1), (2, 0)}),
+    "down": frozenset({(0, 1), (1, 0), (1, 1), (1, 2)}),
+    "up": frozenset({(0, 0), (0, 1), (0, 2), (1, 1)}),
+}
+
