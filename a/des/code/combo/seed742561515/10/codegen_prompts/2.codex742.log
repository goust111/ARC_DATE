+def _detect_ribbons(grid: np.ndarray, bg: int, arrow_color: int) -> list[dict[str, object]]:
+    mask = (grid != bg) & (grid != arrow_color)
+    ribbons: list[dict[str, object]] = []
+    for comp in _components(mask, connectivity=4):
