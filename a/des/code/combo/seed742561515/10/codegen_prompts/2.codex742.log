+def _render_output(h: int, w: int, specs: list[dict[str, object]]) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    for spec in specs:
+        for (r, c), color in spec["output_cells"].items():
+            grid[int(r), int(c)] = int(color)
+    return grid
+
