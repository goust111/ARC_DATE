+    dr = int(ordered_cells[1][0] - ordered_cells[0][0])
+    dc = int(ordered_cells[1][1] - ordered_cells[0][1])
+    base_r, base_c = map(int, ordered_cells[0])
+
+    out: dict[tuple[int, int], int] = {}
+    for t in range(k, n):
