+    if missing[-1] - missing[0] + 1 != len(missing):
+        return None
+    if not np.all(side[: missing[0]] == ROOM):
+        return None
+    if not np.all(side[missing[-1] + 1 :] == ROOM):
+        return None
+    return int(missing[0]), int(missing[-1] + 1)
