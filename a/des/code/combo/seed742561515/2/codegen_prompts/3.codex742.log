+def _nonzero_runs(arr: np.ndarray) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    i = 0
+    while i < len(arr):
+        if int(arr[i]) == BG:
+            i += 1
+            continue
+        j = i
+        while j < len(arr) and int(arr[j]) != BG:
+            j += 1
+        out.append((i, j))
+        i = j
+    return out
