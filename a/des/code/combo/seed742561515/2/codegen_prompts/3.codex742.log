+def _runs(arr: np.ndarray, value: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    i = 0
+    while i < len(arr):
+        if int(arr[i]) != value:
+            i += 1
+            continue
+        j = i
+        while j < len(arr) and int(arr[j]) == value:
+            j += 1
+        out.append((i, j))
+        i = j
+    return out
+
