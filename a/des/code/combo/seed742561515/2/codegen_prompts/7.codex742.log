+def _shuffled_cells(shape: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    h, w = shape
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    rng.shuffle(cells)
+    return cells
