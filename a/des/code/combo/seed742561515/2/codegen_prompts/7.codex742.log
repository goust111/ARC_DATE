+
+def _ring_zone_clear(grid: np.ndarray, center: tuple[int, int]) -> bool:
+    h, w = grid.shape
+    r, c = center
+    r0 = max(0, r - 2)
+    r1 = min(h, r + 3)
+    c0 = max(0, c - 2)
+    c1 = min(w, c + 3)
+    return not np.any(grid[r0:r1, c0:c1] != BG)
