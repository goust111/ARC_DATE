+    if not _validate_generated(grid, rings_sorted, absorbed_by_color, offline_by_color):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
