+    candidates = _scan_positions(ring, grid.shape)
+    rng.shuffle(candidates)
+    placed: list[tuple[int, int]] = []
+    target = rng.randint(min_count, min(ONLINE_DOT_RANGE[1], max(min_count, len(candidates))))
