+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(pts, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _cropped_mask_from_coords(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _shape_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    return int(mask.shape[0]), int(mask.shape[1]), mask.astype(np.uint8).tobytes()
+
+
+def _connected(mask: np.ndarray) -> bool:
+    if not np.any(mask):
+        return False
+    return len(_components(mask)) == 1
