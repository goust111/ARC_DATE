+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+ROOM_KEYS = ("tl", "tr", "bl", "br")
+ROOM_SIDES = {
+    "tl": ("top", "left"),
+    "tr": ("top", "right"),
+    "bl": ("bottom", "left"),
+    "br": ("bottom", "right"),
