+    if _edge_touches(mask) != (True, True, True, True):
+        return False
+    if np.array_equal(mask, np.fliplr(mask)):
+        return False
+    if np.array_equal(mask, np.flipud(mask)):
+        return False
+    return True
+
+
+def _random_room_mask(h: int, w: int) -> np.ndarray | None:
+    area = h * w
