+
+def _edge_touches(mask: np.ndarray) -> tuple[bool, bool, bool, bool]:
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False, False, False, False
+    top = bool(np.any(mask[0, 1:-1]))
+    bottom = bool(np.any(mask[-1, 1:-1]))
