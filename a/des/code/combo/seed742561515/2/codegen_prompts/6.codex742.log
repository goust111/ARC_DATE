+def _blank_canvas(top_h: int, bottom_h: int, left_w: int, right_w: int) -> tuple[np.ndarray, tuple[int, int], tuple[int, int]]:
+    rows = top_h + 2 + bottom_h
+    cols = left_w + 2 + right_w
