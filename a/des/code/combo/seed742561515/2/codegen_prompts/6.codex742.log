+        )
+        near_row, far_row, cursor, step = _storage_params(quadrant, cross_rows, cross_cols)
+        for spec in blocks:
+            color = int(spec["color"])
+            if spec["shape"] == "v":
+                targets = [(far_row, cursor), (near_row, cursor)]
+                cursor += step
+            else:
