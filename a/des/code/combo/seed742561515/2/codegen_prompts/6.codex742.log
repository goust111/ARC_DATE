+
+    return specs
+
+
+def _expected_from_specs(
+    inp: np.ndarray,
+    specs: list[dict],
+    cross_rows: tuple[int, int],
+    cross_cols: tuple[int, int],
+) -> np.ndarray:
+    out = inp.copy()
+    by_quadrant: dict[str, list[dict]] = {quadrant: [] for quadrant in QUADRANTS}
+
+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = BG
