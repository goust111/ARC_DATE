+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+QUADRANTS = ("UL", "UR", "LL", "LR")
