+    for rank, tower in enumerate(ordered_towers):
+        color = int(tower["color"])
+        target_color = palette_colors[rank]
+        r0, c0, r1, c1 = receiver_by_color[color]["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = target_color
+
+    return out
