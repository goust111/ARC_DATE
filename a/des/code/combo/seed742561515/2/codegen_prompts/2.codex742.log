+        tower_color = int(pair["tower_color"])
+        tower_height = int(pair["height"])
+        receiver_top = int(pair["receiver_top"])
+        grid[h - tower_height : h, col] = tower_color
+        grid[receiver_top : receiver_top + RECEIVER_SIZE, col - 1 : col + 2] = tower_color
+
+    return grid
+
+
