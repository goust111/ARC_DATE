+
+def _component_cells(mask: np.ndarray, start: tuple[int, int], seen: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    stack = [start]
+    seen[start] = True
+    cells: list[tuple[int, int]] = []
+    while stack:
+        r, c = stack.pop()
