+    for r, c in members:
+        mask[r, c] = True
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if r + 1 < h and mask[r + 1, c]:
+                if not (set(members[(r, c)]) & set(members[(r + 1, c)])):
