+def _choose_next(prev: Coord | None, curr: Coord, nbrs: list[Coord]) -> Coord | None:
+    if prev is None:
+        assert len(nbrs) == 1, "path start must be a degree-1 endpoint"
+        return nbrs[0]
+
+    others = [cell for cell in nbrs if cell != prev]
+    if not others:
+        return None
+
+    dr = curr[0] - prev[0]
+    dc = curr[1] - prev[1]
+    forward = (curr[0] + dr, curr[1] + dc)
