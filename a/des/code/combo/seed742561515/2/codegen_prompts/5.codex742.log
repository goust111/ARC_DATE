+    prev = path[idx - 1]
+    curr = path[idx]
+    nxt = path[idx + 1]
+    if prev[0] == curr[0] == nxt[0]:
+        return "h"
+    if prev[1] == curr[1] == nxt[1]:
+        return "v"
+    return None
