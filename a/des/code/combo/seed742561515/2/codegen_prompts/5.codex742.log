+    others = [cell for cell in nbrs if cell != prev]
+    if not others:
+        return None
+
+    dr = curr[0] - prev[0]
+    dc = curr[1] - prev[1]
+    forward = (curr[0] + dr, curr[1] + dc)
+    if forward in others:
