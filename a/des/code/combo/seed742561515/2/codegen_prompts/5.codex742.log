+        a, b = ids
+        len_a = len(paths[a])
+        len_b = len(paths[b])
+        if len_a > len_b:
+            color = int(original_colors[a])
+        elif len_b > len_a:
+            color = int(original_colors[b])
+        elif tie_grid is not None:
+            color = int(tie_grid[cell])
+        else:
