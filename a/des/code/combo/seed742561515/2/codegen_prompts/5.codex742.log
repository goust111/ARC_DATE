+# --------------- generator ---------------
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+MAX_ATTEMPTS = 500
