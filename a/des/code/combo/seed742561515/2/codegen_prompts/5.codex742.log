+    path = [(r, c)]
+    for seg_idx, steps in enumerate(horizontal_steps):
+        for _ in range(steps):
+            c += sign
+            path.append((r, c))
+        if seg_idx + 1 < len(rows):
+            target_r = rows[seg_idx + 1]
+            step = 1 if target_r > r else -1
+            while r != target_r:
+                r += step
+                path.append((r, c))
+    return path
+
