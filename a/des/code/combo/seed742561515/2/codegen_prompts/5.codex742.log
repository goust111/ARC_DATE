+    seen = {start}
+    prev: Coord | None = None
+    curr = start
+    while True:
+        nxt = _choose_next(prev, curr, neighbor_map[curr])
+        if nxt is None:
+            break
+        assert nxt not in seen, "paths must be simple chains"
+        path.append(nxt)
+        seen.add(nxt)
+        prev, curr = curr, nxt
+    return path
