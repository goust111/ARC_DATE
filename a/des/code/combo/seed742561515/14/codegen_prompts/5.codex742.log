+def _random_cavity_shape() -> np.ndarray | None:
+    for _ in range(SHAPE_ATTEMPTS):
+        target_area = random.randint(5, 10)
+        dims = [
+            (h, w)
+            for h in range(3, 6)
+            for w in range(3, 7)
+            if target_area + 2 <= h * w <= target_area + 6
