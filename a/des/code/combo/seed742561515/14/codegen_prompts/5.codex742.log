+def _has_internal_hole(mask: np.ndarray) -> bool:
+    m = np.asarray(mask, dtype=bool)
+    h, w = map(int, m.shape)
+    empty = ~np.pad(m, 1, constant_values=False)
+    seen = np.zeros_like(empty, dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
