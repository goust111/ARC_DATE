+        if not dims:
+            continue
+        h, w = random.choice(dims)
+        mask = np.ones((h, w), dtype=bool)
+        remove_steps = int(h * w - target_area)
+        touched_sides: set[str] = set()
+        ok = True
+        for _step in range(remove_steps):
+            options = []
+            for r in range(h):
+                for c in range(w):
