+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
