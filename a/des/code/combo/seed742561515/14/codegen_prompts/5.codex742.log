+def _canonical_rotation_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    variants = []
+    for k in range(4):
+        rot = np.rot90(np.asarray(mask, dtype=bool), k)
+        variants.append((tuple(map(int, rot.shape)), rot.tobytes()))
+    return min(variants)
