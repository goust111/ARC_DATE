+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+FRAME_COLOR = 5
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 300
+SHAPE_ATTEMPTS = 120
+LAYOUT_ATTEMPTS = 80
+CANVAS_ATTEMPTS = 60
