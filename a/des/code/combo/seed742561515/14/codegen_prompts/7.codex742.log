+        low_w = ROOM_SIZE_RANGE[0]
+    else:
+        low_h = max(5, ROOM_SIZE_RANGE[0])
+        low_w = max(5, ROOM_SIZE_RANGE[0])
+    height = int(rng.integers(low_h, ROOM_SIZE_RANGE[1] + 1))
+    width = int(rng.integers(low_w, ROOM_SIZE_RANGE[1] + 1))
+    return height, width
