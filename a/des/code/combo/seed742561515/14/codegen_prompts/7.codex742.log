+        room_block = out[r0 : r1 + 1, c0 : c1 + 1]
+        _paint_thick_border(room_block, color, thickness)
+
+    return out
+
+
+def _expected_room_block(height: int, width: int, color: int | None, count: int) -> np.ndarray:
+    block = np.full((height, width), BLACK, dtype=int)
+    block[0, :] = GREY
+    block[-1, :] = GREY
+    block[:, 0] = GREY
+    block[:, -1] = GREY
