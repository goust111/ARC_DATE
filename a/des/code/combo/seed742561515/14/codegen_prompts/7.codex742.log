+
+def _paint_thick_border(block: np.ndarray, color: int, thickness: int) -> None:
+    h, w = block.shape
+    rr = np.arange(h)[:, None]
+    cc = np.arange(w)[None, :]
+    dist = np.minimum(np.minimum(rr, h - 1 - rr), np.minimum(cc, w - 1 - cc))
+    block[dist < thickness] = int(color)
+
