+        cols = [c for _, c in coords]
+        ir0, ir1 = min(rows), max(rows)
+        ic0, ic1 = min(cols), max(cols)
+        if len(coords) != (ir1 - ir0 + 1) * (ic1 - ic0 + 1):
+            continue
+        r0, c0, r1, c1 = ir0 - 1, ic0 - 1, ir1 + 1, ic1 + 1
+        if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:
