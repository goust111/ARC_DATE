+    ready = [idx for idx in range(n) if indeg[idx] == 0]
+    order = []
+    while ready:
+        ready.sort(key=sort_key)
+        idx = ready.pop(0)
+        order.append(idx)
+        for nxt in sorted(edges[idx], key=sort_key):
+            indeg[nxt] -= 1
+            if indeg[nxt] == 0:
+                ready.append(nxt)
