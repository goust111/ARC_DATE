+def _render_patch(height: int, width: int, color: int, direction: str) -> np.ndarray:
+    patch = np.full((height, width), int(color), dtype=int)
+    mask = ARROW_MASKS[direction]
+    cr = height // 2
+    cc = width // 2
+    patch[cr - 1 : cr + 2, cc - 1 : cc + 2][mask] = YELLOW
+    return patch
