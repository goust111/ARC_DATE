+
+    assignments = []
+    if count == 1:
+        assignments = [[assemblies]]
+    else:
+        for mask in range(1 << count):
+            rows = [[], []]
+            for idx, asm in enumerate(assemblies):
+                rows[(mask >> idx) & 1].append(asm)
+            rows = [row for row in rows if row]
+            if not rows or len(rows) > 2:
+                continue
+            assignments.append(rows)
