+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+BODY_COLORS = (1, 2, 3, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ARROW_MASKS = {
+    "up": np.array(
