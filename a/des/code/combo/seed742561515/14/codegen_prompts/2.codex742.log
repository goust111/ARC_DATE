+                    if (rr, cc) in visible_sets[j]:
+                        j_seen = True
+            if i_seen and not j_seen:
+                if i not in edges[j]:
+                    edges[j].add(i)
+                    indeg[i] += 1
+            elif j_seen and not i_seen:
