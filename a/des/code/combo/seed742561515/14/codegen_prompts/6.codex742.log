+        for _ in range(300):
+            root = rng.choice(trunk)
+            if root in gadget_roots:
+                continue
+            side = rng.choice((-1, 1))
+            builders = (_try_add_split_pair, _try_add_junction_pair)
+            builder = rng.choice(builders)
+            if builder(
+                rng,
+                root,
+                axis,
+                perp,
+                side,
+                color,
+                rows,
+                cols,
+                used_vertices,
+                used_edges,
+                node_colors,
+                pair_paths,
