from __future__ import annotations
import random
from collections import defaultdict, deque
import numpy as np

BLACK=0
GREY=5
STEP=4
COLORS=[1,2,3,4,6,7,8,9]


def canon_edge(a,b):
    return tuple(sorted((a,b)))

def move(v, axis, sign):
    lst=list(v)
    lst[axis]+=sign
    return tuple(lst)

def ray(start, axis, sign, length):
    pts=[start]
    cur=start
    for _ in range(length):
        cur=move(cur,axis,sign)
        pts.append(cur)
    return pts

def in_bounds(v, nr, nc):
    r,c=v
    return 0<=r<nr and 0<=c<nc

def free_len(start, axis, sign, used, nr, nc):
    cur=start
    n=0
    while True:
        cur=move(cur,axis,sign)
        if not in_bounds(cur,nr,nc) or cur in used:
            return n
        n+=1

def can_add(seq, used_v, used_e, nr, nc):
    if len(seq) < 2:
        return False
    if seq[0] not in used_v:
        return False
    for p in seq[1:]:
        if not in_bounds(p,nr,nc) or p in used_v:
            return False
    for a,b in zip(seq, seq[1:]):
        if abs(a[0]-b[0])+abs(a[1]-b[1]) "'!= 1 or canon_edge(a,b) in used_e:
            return False
    return True

def add(seq, used_v, used_e):
    for p in seq[1:]:
        used_v.add(p)
    for a,b in zip(seq, seq[1:]):
        used_e.add(canon_edge(a,b))

def port(pixel, direction, colored):
    r,c=pixel
    if not colored:
        return pixel
    dr,dc=direction
    if dr == -1:
        return (r-1,c)
    if dr == 1:
        return (r+2,c)
    if dc == -1:
        return (r,c-1)
    return (r,c+2)

def draw_segment(a,b):
    r0,c0=a; r1,c1=b
    pts=[]
    if r0 == r1:
        step = 1 if c1 >= c0 else -1
        for c in range(c0, c1+step, step):
            pts.append((r0,c))
    else:
        step = 1 if r1 >= r0 else -1
        for r in range(r0, r1+step, step):
            pts.append((r,c0))
    return pts

def render(used_v, used_e, node_colors, paths):
    base={v:(v[0]*STEP, v[1]*STEP) for v in used_v}
    grey=set()
    for v in used_v:
        if v not in node_colors:
            grey.add(base[v])
    for a,b in used_e:
        dr = 0 if b[0]==a[0] else (1 if b[0] > a[0] else -1)
        dc = 0 if b[1]==a[1] else (1 if b[1] > a[1] else -1)
        sa = port(base[a], (dr,dc), a in node_colors)
        sb = port(base[b], (-dr,-dc), b in node_colors)
        grey.update(draw_segment(sa,sb))
    all_pts=set(grey)
    for v in node_colors:
        r,c=base[v]
        all_pts.update({(r,c),(r,c+1),(r+1,c),(r+1,c+1)})
    min_r=min(r for r,_ in all_pts); max_r=max(r for r,_ in all_pts)
    min_c=min(c for _,c in all_pts); max_c=max(c for _,c in all_pts)
    pad=2
    H=max_r-min_r+1+2*pad; W=max_c-min_c+1+2*pad
    inp=np.full((H,W), BLACK, int)
    shift=lambda p: (p[0]-min_r+pad, p[1]-min_c+pad)
    for p in grey:
        rr,cc=shift(p); inp[rr,cc]=GREY
    for v,col in node_colors.items():
        r,c=shift(base[v])
        inp[r:r+2,c:c+2]=col
    out=inp.copy()
    for color,path in paths:
        for v in path:
            if v in node_colors:
                continue
            rr,cc=shift(base[v])
            if out[rr,cc] == GREY:
                out[rr,cc]=color
        for a,b in zip(path, path[1:]):
            dr = 0 if b[0]==a[0] else (1 if b[0] > a[0] else -1)
            dc = 0 if b[1]==a[1] else (1 if b[1] > a[1] else -1)
            sa = port(base[a], (dr,dc), a in node_colors)
            sb = port(base[b], (-dr,-dc), b in node_colors)
            for p in draw_segment(sa,sb):
                rr,cc=shift(p)
                if out[rr,cc] == GREY:
                    out[rr,cc]=color
    return inp,out

def comps_of_color(g,color):
    H,W=g.shape
    vis=np.zeros((H,W), bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if vis[r,c] or g[r,c] != color:
                continue
            q=deque([(r,c)]); vis[r,c]=True; coords=[]
            while q:
                x,y=q.popleft(); coords.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and not vis[nx,ny] and g[nx,ny]==color:
                        vis[nx,ny]=True; q.append((nx,ny))
            out.append(coords)
    return out

def solve(grid):
    g=np.array(grid,int)
    H,W=g.shape
    nodes=[]
    for color in sorted(set(map(int,g.ravel())) - {BLACK,GREY}):
        comps=comps_of_color(g, color)
        for coords in comps:
            rows=[r for r,_ in coords]; cols=[c for _,c in coords]
            if len(coords)!=4 or max(rows)-min(rows)!=1 or max(cols)-min(cols)!=1:
                raise AssertionError(('"'bad node',color,coords))
            cells=set(coords)
            if cells "'!= {(min(rows),min(cols)),(min(rows),min(cols)+1),(min(rows)+1,min(cols)),(min(rows)+1,min(cols)+1)}:
                raise AssertionError('"'not full 2x2')
            nodes.append({'color':color,'cells':cells})
    graph=defaultdict(set)
    greys={(r,c) for r in range(H) for c in range(W) if g[r,c]==GREY}
    for r,c in greys:
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nb=(r+dr,c+dc)
            if nb in greys:
                graph[(r,c)].add(nb)
    for i,node in enumerate(nodes):
        key=('n',i)
