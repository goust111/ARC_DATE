+                else:
+                    return False
+    return True
+
+
+def _paint_mask(grid: np.ndarray, top: int, left: int, mask: np.ndarray, color: int) -> None:
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                grid[top + r, left + c] = color
+
+
+def _k_sequence(count: int) -> list[int]:
+    base = [0, 1, 2, 3, 4]
+    random.shuffle(base)
+    seq = []
+    while len(seq) < count:
+        seq.extend(base)
+        random.shuffle(base)
+    seq = seq[:count]
+    if len(set(seq)) == 1:
+        seq[-1] = (seq[-1] + 1) % 5
+    return seq
