+        if any(cols[i + 1] != cols[i] + 1 for i in range(len(cols) - 1)):
+            continue
+        if len(cols) < 2:
+            continue
+        signature = len(cols) - 1
+        color = int(grid[r, cols[-1]])
+        mapping[signature] = color
