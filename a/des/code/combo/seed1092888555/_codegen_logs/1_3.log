+    outside[:, :c0] = True
+    outside[:, c1 + 1 :] = True
+    outside[:r0, :] = True
+    outside[r1 + 1 :, :] = True
+
+    mapping: dict[int, int] = {}
+    for r in range(grid.shape[0]):
+        cols = [int(c) for c in np.where(outside[r] & (grid[r] != bg))[0]]
+        if not cols:
+            continue
