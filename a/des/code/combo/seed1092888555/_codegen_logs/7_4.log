+    pts = np.argwhere(mask)
+    if corner == "tl":
+        primary = -pts[:, 0].mean() - pts[:, 1].mean()
+    elif corner == "tr":
+        primary = -pts[:, 0].mean() + pts[:, 1].mean()
+    elif corner == "bl":
+        primary = pts[:, 0].mean() - pts[:, 1].mean()
+    else:
+        primary = pts[:, 0].mean() + pts[:, 1].mean()
