+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 26)
+    w = random.randint(18, 26)
+    k = random.randint(1, 4)
+    dr = random.choice([-k, k])
+    dc = random.choice([-k, k])
+    n_frames = random.randint(3, 6)
+    want_occlusion = random.random() < 0.5
+
+    frames: list[dict] = []
+    colors = random.sample(FRAME_COLORS, n_frames)
+    for color in colors:
+        placed = False
+        for _ in range(200):
+            side = random.randint(4, 7)
+            r0_min = max(0, -dr)
+            c0_min = max(0, -dc)
+            r0_max = h - side - max(0, dr)
+            c0_max = w - side - max(0, dc)
+            if r0_min > r0_max or c0_min > c0_max:
+                return None
+            r0 = random.randint(r0_min, r0_max)
+            c0 = random.randint(c0_min, c0_max)
+            bbox = (r0, c0, r0 + side - 1, c0 + side - 1)
+            if any(_rects_overlap(bbox, (f["r0"], f["c0"], f["r0"] + f["side"] - 1, f["c0"] + f["side"] - 1), pad=1) for f in frames):
+                continue
+            frame = {"color": color, "r0": r0, "c0": c0, "side": side, "border": _border_coords(r0, c0, side)}
+            frames.append(frame)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    frame_infos = []
+    perimeter_min = 999
+    for frame in frames:
+        free_count = _shadow_free_count(frame, frames, dr, dc, h, w)
+        frame_infos.append((frame, free_count))
+        perimeter_min = min(perimeter_min, len(frame["border"]))
+
+    demos = [f for f, free in frame_infos if free >= max(4, len(f["border"]) // 3)]
+    no_shadow = [f for f, free in frame_infos if free == 0]
+    partial = [f for f, free in frame_infos if 0 < free < len(f["border"])]
+    clear = [f for f, free in frame_infos if free == len(f["border"])]
+    if not demos:
+        return None
+
+    if want_occlusion:
+        target_missing = partial if partial else no_shadow
+        if not target_missing:
+            return None
+    else:
+        target_missing = [f for f, _ in frame_infos]
+
+    candidates = [f for f in target_missing if f not in demos]
+    if not candidates:
+        candidates = [f for f, _ in frame_infos if f not in demos]
+    if not candidates:
+        return None
+
+    random.shuffle(demos)
+    n_demo = random.randint(1, max(1, len(demos) - 1))
+    demo_set = set(id(f) for f in demos[:n_demo])
+
+    missing_frames = [f for f, _ in frame_infos if id(f) not in demo_set]
+    if not missing_frames:
+        return None
+    if want_occlusion and not any(f in partial or f in no_shadow for f in missing_frames):
+        return None
+
+    if not want_occlusion and len(clear) < 2:
+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    for frame in frames:
+        _draw_frame(grid, frame)
+    for frame in frames:
+        if id(frame) not in demo_set:
+            continue
+        for r, c in frame["border"]:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == BG:
+                grid[rr, cc] = SHADOW
+
+    if len(set(map(int, grid.ravel()))) < 4:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input failed after 400 attempts")

