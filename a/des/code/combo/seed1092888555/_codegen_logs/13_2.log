+    want_occlusion = random.random() < 0.5
+
+    frames: list[dict] = []
+    colors = random.sample(FRAME_COLORS, n_frames)
+    reserved_demo_shadow: set[tuple[int, int]] = set()
+
+    def sample_frame(color: int, side_lo: int = 4, side_hi: int = 7) -> dict | None:
+        for _ in range(250):
