+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            if not np.all(patch[0, :] == color) or not np.all(patch[-1, :] == color):
+                continue
+            if not np.all(patch[:, 0] == color) or not np.all(patch[:, -1] == color):
+                continue
+            if np.any(patch[1:-1, 1:-1] == color):
+                continue
