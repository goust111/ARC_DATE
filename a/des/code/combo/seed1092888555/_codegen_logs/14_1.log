+        grid[r0 + sr, c0 + sc] = seed_color
+        occupied[r0 : r0 + rh, c0 : c0 + rw] = True
+        objects.append((r0, c0, rh, rw, sr, sc))
+
+    if len(objects) != target_count:
+        return None
+    if want_positive and not have_positive:
+        return None
+    return grid
