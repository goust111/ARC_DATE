+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                ring = max(abs(r - sr), abs(c - sc))
+                if 1 <= ring <= dist:
+                    out[r, c] = seed_color if ring % 2 == 1 else GREY
