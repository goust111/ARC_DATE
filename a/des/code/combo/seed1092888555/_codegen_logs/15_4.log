    for _ in range(length):
        options = [prefix + (pattern,) for prefix in options for pattern in base]

    return [
        patterns
        for patterns in options
        if sum(2 if pattern == DOUBLE_PATTERN else 1 for pattern in patterns) >= run_color_count
