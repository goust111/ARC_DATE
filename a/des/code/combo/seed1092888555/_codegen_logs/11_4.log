+    mid_c = (c0 + c1) / 2.0
+    counts = {"top": 0, "bottom": 0, "left": 0, "right": 0}
+    for r, c in cells:
+        if r <= mid_r:
+            counts["top"] += 1
+        if r >= mid_r:
+            counts["bottom"] += 1
+        if c <= mid_c:
+            counts["left"] += 1
+        if c >= mid_c:
+            counts["right"] += 1
+    return counts
+
+
+def _choose_side(cells: list[tuple[int, int]], bbox: tuple[int, int, int, int]) -> str:
