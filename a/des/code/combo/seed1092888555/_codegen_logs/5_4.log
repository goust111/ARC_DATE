+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        try:
+            inp, _out = _build_example()
+        except Exception:
+            continue
+        return inp
+    raise RuntimeError("failed to generate valid input")

