+
+def _stamp_seed(panel: np.ndarray, seed: np.ndarray, direction: str) -> None:
+    ph, pw = panel.shape
+    sh, sw = seed.shape
+    if direction == "down":
+        panel[:sh, :sw] = seed
+    elif direction == "up":
+        panel[ph - sh :, :sw] = seed
+    elif direction == "right":
+        panel[:sh, :sw] = seed
+    elif direction == "left":
+        panel[:sh, pw - sw :] = seed
+    else:
+        raise AssertionError(direction)
