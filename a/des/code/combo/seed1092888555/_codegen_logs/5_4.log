+            out[r0 : r0 + sh, cc : cc + sw] = patch
+    elif direction == "left":
+        assert c1 == pw - 1 and pw % sw == 0
+        for k, cc in enumerate(range(pw - 2 * sw, -1, -sw), start=1):
