+        dr_num = abs((ar0 + ar1) - (br0 + br1))
+        dc_num = abs((ac0 + ac1) - (bc0 + bc1))
+        assert dr_num % 2 == 0
+        assert dc_num % 2 == 0
+        dr = dr_num // 2
+        dc = dc_num // 2
+        do_vflip = dr % 2 == 0
+        do_hflip = dc % 2 == 0
+        _transform_component_in_place(out, a, do_vflip, do_hflip, bg)
+        _transform_component_in_place(out, b, do_vflip, do_hflip, bg)
+
+    return out
+
