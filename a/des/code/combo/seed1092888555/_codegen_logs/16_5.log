+            r0, c0, r1, c1 = comp["bbox"]
+            assert (r1 - r0 + 1) % 2 == 1
+            assert (c1 - c0 + 1) % 2 == 1
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for r, c in comp["coords"]:
+                mask[r - r0, c - c0] = True
+            assert not np.array_equal(mask, np.flipud(mask))
+            assert not np.array_equal(mask, np.fliplr(mask))
