+    assert g.ndim == 2
+
+    bg = get_bg(g)
+    colors = [int(c) for c in np.unique(g) if int(c) != bg]
+    assert colors
+
+    pairs = []
+    for color in colors:
+        comps = _find_components_of_color(g, color)
