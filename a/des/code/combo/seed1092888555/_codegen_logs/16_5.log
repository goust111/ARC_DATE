+def _connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    start = tuple(int(x) for x in pts[0])
+    seen = {start}
+    q = deque([start])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
