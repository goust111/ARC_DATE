+                if max(abs(r2 - r1), abs(c2 - c1)) < max(h, w) + 1:
+                    continue
+                candidates.append((r2, c2))
+        if candidates:
+            r2, c2 = rng.choice(candidates)
+            return r1, c1, r2, c2
+    return None
+
+
+def _sample_branch_multiset(rng: random.Random, num_pairs: int) -> list[tuple[bool, bool]]:
+    order = list(BRANCHES)
+    rng.shuffle(order)
