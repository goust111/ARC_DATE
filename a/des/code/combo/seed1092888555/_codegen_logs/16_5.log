+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 4
+PALETTE = [c for c in range(10) if c != BG]
+BRANCHES = (
+    (False, False),
+    (False, True),
+    (True, False),
+    (True, True),
+)
+MAX_GEN_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _transform_component_in_place(out: np.ndarray, comp: dict, do_vflip: bool, do_hflip: bool, bg: int) -> None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    local = np.zeros((h, w), dtype=bool)
+    for r, c in comp["coords"]:
+        out[r, c] = bg
+        local[r - r0, c - c0] = True
+    if do_vflip:
+        local = np.flipud(local)
+    if do_hflip:
+        local = np.fliplr(local)
+    color = int(comp["color"])
+    for rr, cc in np.argwhere(local):
+        out[r0 + int(rr), c0 + int(cc)] = color
