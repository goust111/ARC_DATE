+def _draw_frame(grid: np.ndarray, r0: int, c0: int, inner_h: int, inner_w: int) -> None:
+    r1 = r0 + inner_h + 1
+    c1 = c0 + inner_w + 1
+    grid[r0, c0 : c1 + 1] = GREEN
+    grid[r1, c0 : c1 + 1] = GREEN
+    grid[r0 : r1 + 1, c0] = GREEN
+    grid[r0 : r1 + 1, c1] = GREEN
+
