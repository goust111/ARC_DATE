+            continue
+        if len(comp) != 2 * (h + w) - 4:
+            continue
+        ok = True
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                on_border = r in (r0, r1) or c in (c0, c1)
+                if on_border != (grid[r, c] == GREEN):
+                    ok = False
+                    break
+            if not ok:
