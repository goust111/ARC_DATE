+        for r0, c0, r1, c1 in corner_boxes:
+            if r0 < 0 or c0 < 0 or r1 > h or c1 > w:
+                continue
+            sub = grid[r0:r1, c0:c1]
+            if sub.shape != (n, 2):
+                continue
+            if np.any(sub == BG):
+                continue
+            mapping: dict[int, int] = {}
+            ok = True
+            for row in sub:
+                left, right = int(row[0]), int(row[1])
+                if left == right or left in mapping:
+                    ok = False
+                    break
+                mapping[left] = right
+            if not ok:
