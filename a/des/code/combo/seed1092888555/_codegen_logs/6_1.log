+        blocked_cols = {w - 2, w - 1}
+    # Keep outer frame away from palette columns.
+    if layout[0][1] <= max(blocked_cols) + 1 and corner in ("tl", "bl"):
+        return None
+    if layout[0][3] >= min(blocked_cols) - 1 and corner in ("tr", "br"):
+        return None
+
+    colors = list(COLOR_POOL)
+    rng.shuffle(colors)
+    frame_colors = colors[:n_frames]
+    allowed_colors = colors[n_frames : 2 * n_frames]
+    distractor_colors = colors[2 * n_frames :]
+    mapping = dict(zip(frame_colors, allowed_colors))
