+def _extract_palette(grid: np.ndarray) -> tuple[dict[int, int], np.ndarray]:
+    candidates = _corner_palette_candidates(grid)
+    assert candidates, "expected a corner legend"
+    frame_like_counts = []
+    for mapping, mask in candidates:
