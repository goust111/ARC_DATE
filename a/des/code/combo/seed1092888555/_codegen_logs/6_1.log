  56:     """
  57:     Recover the repeating background pattern hidden under the largest solid rectangle.
  58: 
  59:     Input structure:
  60:     - The grid is covered by a small row/column periodic pattern.
  61:     - Several non-pattern colors form solid rectangular foreground objects that
  62:       overwrite the pattern.
  63:     - The requested output region is the largest of those solid rectangles.
  64: 
  65:     Rule:
  66:     - Find every 4-connected monochromatic object whose bounding box is a filled
  67:       rectangle with both dimensions greater than one.
  68:     - Treat those rectangles as masks, infer the smallest repeating tile that is
  69:       consistent with all remaining visible pixels, and repaint the largest
  70:       rectangle's coordinates with that tile.
  71: 
  72:     Key insight: The rectangle colors are occluders; the visible pixels outside
  73:     them are enough to reconstruct the original periodic background underneath.
  74:     """
  75:     g = np.asarray(grid, dtype=int)
  76:     rects = _solid_rectangles(g)
  77:     assert rects, "expected at least one solid rectangular occluder"
  78: 
  79:     max_area = max(area for area, *_ in rects)
  80:     targets = [rect for rect in rects if rect[0] == max_area]
  81:     assert len(targets) == 1, "largest rectangle must be unique"
  82:     target = targets[0]
  83: 
  84:     blocked = np.zeros(g.shape, dtype=bool)
  85:     for _, _, r0, c0, r1, c1 in rects:
  86:         blocked[r0 : r1 + 1, c0 : c1 + 1] = True
  87: 
  88:     h, w = g.shape
  89:     period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []
  90:     for row_period in range(1, h + 1):
  91:         for col_period in range(1, w + 1):
  92:             values = _period_values(g, blocked, row_period, col_period)
  93:             if values is not None:
  94:                 period_candidates.append((row_period, col_period, values))
  95:     assert period_candidates, "visible pixels must define a periodic pattern"
  96: 
  97:     min_period_area = min(rp * cp for rp, cp, _ in period_candidates)
  98:     outputs = [
  99:         _reconstruct_rect(values, row_period, col_period, target)
 100:         for row_period, col_period, values in period_candidates
 101:         if row_period * col_period == min_period_area
 102:     ]
 103:     assert outputs, "expected at least one minimal period"
 104:     first = outputs[0]
 105:     assert all(np.array_equal(first, out) for out in outputs), "minimal periods must agree"
