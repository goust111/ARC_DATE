+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _place_palette(grid: np.ndarray, mapping: dict[int, int], corner: str) -> np.ndarray:
+    n = len(mapping)
+    rows = list(mapping.items())
+    block = np.array(rows, dtype=int)
