+def _corner_palette_candidates(grid: np.ndarray) -> list[tuple[dict[int, int], np.ndarray]]:
+    h, w = grid.shape
+    out: list[tuple[dict[int, int], np.ndarray]] = []
+    sizes = (2, 3)
+    for n in sizes:
+        corner_boxes = [
+            (0, 0, n, 2),
+            (0, w - 2, n, w),
+            (h - n, 0, h, 2),
+            (h - n, w - 2, h, w),
