+        max_gap_c = (pc1 - pc0 - 4) // 2
+        if max_gap_r < min_gap or max_gap_c < min_gap:
+            return None
+        gap_top = rng.randint(min_gap, max_gap_r)
+        gap_left = rng.randint(min_gap, max_gap_c)
+        gap_bottom = rng.randint(min_gap, max_gap_r)
+        gap_right = rng.randint(min_gap, max_gap_c)
