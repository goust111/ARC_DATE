+
+def _categories_for_instance() -> list[int]:
+    cats = [0, 1, 2, 3, 4]
+    extras = random.randint(0, 3)
+    for _ in range(extras):
+        cats.append(random.randint(0, 4))
+    random.shuffle(cats)
+    return cats
