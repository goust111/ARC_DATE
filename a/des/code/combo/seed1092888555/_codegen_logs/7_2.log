+    items: list[tuple[int, int, int]] = []
+    for comp in comps:
+        coords = comp["coords"]
+        coord_set = {tuple(map(int, xy)) for xy in coords}
+        p = _perimeter(coords, coord_set)
+        assert p <= 20
