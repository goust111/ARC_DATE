+            local = {(rr - r0, cc - c0) for rr, cc in cells}
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "bbox": (r0, c0, r1, c1),
+                    "local": local,
+                }
+            )
