                if not pal:
                    pal = [2, 3]

                tile = np.full((ph, pw), int(bg), dtype=int)
                # Ensure at least one non-bg in the tile.
                tile[int(np.random.randint(0, ph)), int(np.random.randint(0, pw))] = int(pal[0])
                # Add a few more colored cells.
