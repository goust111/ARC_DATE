+                    return False
+    return True
+
+
+def _stamp(arr: np.ndarray, patch: np.ndarray, top: int, left: int, color: int) -> None:
+    ph, pw = patch.shape
+    for dr in range(ph):
+        for dc in range(pw):
+            if int(patch[dr, dc]) != 0:
