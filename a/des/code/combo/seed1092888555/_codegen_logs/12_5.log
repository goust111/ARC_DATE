+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    seen = {tuple(map(int, pts[0]))}
+    stack = [tuple(map(int, pts[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
