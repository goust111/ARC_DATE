    panel = np.full((panel_h, panel_w), BG, dtype=int)
    factor = int(rng.integers(1, 4))

    candidates = [s for s in SHAPES if s.shape[0] <= min(3, panel_h) and s.shape[1] <= min(3, panel_w)]
    if force_big:
