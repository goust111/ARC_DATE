+    row_full = np.all(g == g[:, :1], axis=1) & (g[:, 0] != BG)
+    col_full = np.all(g == g[:1, :], axis=0) & (g[0, :] != BG)
+    row_ids = _separator_runs(row_full)
+    col_ids = _separator_runs(col_full)
