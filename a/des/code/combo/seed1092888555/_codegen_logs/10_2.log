+        nxt = rng.choice(tuple(candidates))
+        chosen.add(nxt)
+        frontier.append(nxt)
+    return chosen
+
+
+def _make_symmetric_mask(
+    size: int,
+    direction: tuple[int, int],
+    arrow_cells: list[tuple[int, int]],
+    stripe_width: int,
+    rng: random.Random,
