+        return [(r, c) for r in range(size) for c in range(half + 1)]
+    half = size // 2
+    return [(r, c) for r in range(half + 1) for c in range(size)]
+
+
+def _grow_connected_subset(
+    valid: set[tuple[int, int]],
+    target: int,
+    rng: random.Random,
+) -> set[tuple[int, int]]:
