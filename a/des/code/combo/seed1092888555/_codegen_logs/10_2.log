+    mask = np.zeros((size, size), dtype=bool)
+    for r, c in seed:
+        mask[r, c] = True
+        mr, mc = _reflect(size, r, c, direction)
+        mask[mr, mc] = True
+
+    stripe = _stripe_mask(size, _occluder_side(direction), stripe_width)
+    if not np.any(mask & stripe):
