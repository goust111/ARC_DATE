+    tail = rng.choice(((size - 1, 0), (size - 1, size - 1)))
+    return [tail, (tail[0] - 1, tail[1])]
+
+
+def _arrow_corner_mask(size: int, arrow_cells: Iterable[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
