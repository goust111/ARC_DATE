            top = int(rng.integers(0, grid_h - 2 - mh + 1))
            left = int(rng.integers(0, grid_w - mw + 1))
            if not _can_place(occupied, top, left, mask):
                continue
            _place_mask(grid, occupied, top, left, mask, color)
            objects.append((color, top, left, mask.copy()))
            placed = True
            break
        if not placed:
