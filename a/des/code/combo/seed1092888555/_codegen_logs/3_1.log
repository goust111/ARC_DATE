    if set(_category(mask) for _, _, _, mask in objects) != {"horizontal", "vertical", "square"}:
        return None
    out = main(grid)
    if out.shape != grid.shape:
        return None
    if np.any(out[-2:, :] != BG):
        return None
    return grid



def generate_input() -> np.ndarray:
