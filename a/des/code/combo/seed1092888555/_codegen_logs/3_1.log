    legend_width = obj_count
    if legend_width > grid_w:
        return None
    legend_start = int(rng.integers(0, grid_w - legend_width + 1))
    for idx, color in enumerate(obj_colors):
        c = legend_start + idx
        grid[grid_h - 2, c] = color
