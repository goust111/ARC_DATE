+# Direction is derived from the missing-corner position.
+_ARROW_SPECS = {
+    "right": {
+        "missing": (0, 1),
+        "cells": ((0, 0), (1, 0), (1, 1)),
+        "vertex": (1, 0),
+        "axis": "h",
+    },
+    "down": {
+        "missing": (1, 0),
+        "cells": ((0, 0), (0, 1), (1, 1)),
+        "vertex": (0, 1),
+        "axis": "v",
+    },
+    "left": {
+        "missing": (0, 0),
+        "cells": ((0, 1), (1, 0), (1, 1)),
+        "vertex": (1, 1),
+        "axis": "h",
+    },
+    "up": {
+        "missing": (1, 1),
+        "cells": ((0, 0), (0, 1), (1, 0)),
+        "vertex": (0, 0),
+        "axis": "v",
+    },
