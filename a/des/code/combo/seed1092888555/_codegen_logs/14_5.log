+        "bottom": (h - 1) - cr,
+        "left": cc,
+        "right": (w - 1) - cc,
+    }
+    best_edge = min(distances, key=distances.get)
+    best_value = distances[best_edge]
+    ties = [edge for edge, value in distances.items() if abs(value - best_value) < 1e-9]
