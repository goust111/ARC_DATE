+        vertical_gap = min(abs(new_bbox[0] - r1), abs(r0 - new_bbox[2])) - 1
+        if same_rows and horizontal_gap == 1:
+            return False
+        if same_cols and vertical_gap == 1:
+            return False
+    return True
