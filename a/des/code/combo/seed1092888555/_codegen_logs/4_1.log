   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Slide a solid square through a winding channel to reach a same-sized target square.
  11: 
  12:     Input structure:
  13:     - bg (most common color). A river color forms a winding corridor.
  14:     - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.
  15: 
  16:     Rule:
  17:     - The mover square travels along the river toward the destination.
  18:     - It can only pass through positions where the full NxN area is river.
  19:     - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.
  20:     - The mover's original position is filled with the river color.
  21: 
  22:     Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.
  23:     """
  24:     g = np.array(grid, dtype=int)
  25:     H, W = g.shape
  26: 
  27:     # Corner-majority background (more stable than global mode here).
  28:     bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
