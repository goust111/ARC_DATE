+    if top < 0 or left < 0 or top + side > legend_row or left + side > w:
+        return False
+    new_bbox = (top, left, top + side - 1, left + side - 1)
+    for bbox in existing:
+        r0, c0, r1, c1 = bbox
+        if not (new_bbox[2] < r0 or r1 < new_bbox[0] or new_bbox[3] < c0 or c1 < new_bbox[1]):
+            return False
