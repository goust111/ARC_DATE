+def _bands(size: int, cuts: list[int]) -> list[tuple[int, int]]:
+    bands = []
+    start = 0
+    for cut in cuts:
+        if start < cut:
+            bands.append((start, cut))
+        start = cut + 1
+    if start < size:
+        bands.append((start, size))
+    return bands
