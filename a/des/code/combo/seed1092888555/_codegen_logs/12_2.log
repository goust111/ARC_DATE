+def _orbit_cells(side: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    seen: set[tuple[int, int]] = set()
+    rr, cc = int(r), int(c)
+    for _ in range(4):
+        seen.add((rr, cc))
+        rr, cc = cc, side - 1 - rr
+    return tuple(sorted(seen))
+
