+    for r in range(side):
+        for c in range(side):
+            orbit = _orbit_cells(side, r, c)
+            if orbit[0] == (r, c):
+                yield r, c
+    assert center >= 1
+
+
+def _make_symmetric_panel(side: int) -> np.ndarray:
