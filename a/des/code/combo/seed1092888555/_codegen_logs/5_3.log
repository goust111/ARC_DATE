+
+def _can_place(
+    occupied: np.ndarray,
+    cells: set[tuple[int, int]],
+    top: int,
+    left: int,
+    pad: int = 1,
+) -> bool:
+    h, w = occupied.shape
+    global_cells = [(top + r, left + c) for r, c in cells]
+    for r, c in global_cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+    for r, c in global_cells:
