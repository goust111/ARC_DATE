+        ("top", "right"),
+        ("bottom", "left"),
+        ("bottom", "right"),
+        ("top", "bottom"),
+        ("left", "right"),
+    ]
+    return choices[int(rng.integers(0, len(choices)))]
+
+
+def _place_object(
