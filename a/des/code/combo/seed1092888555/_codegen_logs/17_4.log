+        return False
+    up = r - 1 >= 0 and int(grid[r - 1, c]) == gray
+    down = r + 1 < grid.shape[0] and int(grid[r + 1, c]) == gray
+    left = c - 1 >= 0 and int(grid[r, c - 1]) == gray
+    right = c + 1 < grid.shape[1] and int(grid[r, c + 1]) == gray
+    return (up and down) or (left and right)
