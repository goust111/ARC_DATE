+
+    any_two = False
+    for bbox in receivers:
+        wire_count = random.choice([1, 2])
+        any_two |= wire_count == 2
+        sides = ["left", "right", "up", "down"]
+        random.shuffle(sides)
+        chosen_sides = sides[:wire_count]
+        colors = random.sample(SOURCE_COLORS, k=wire_count)
