+
+
+def _try_attach_wire(
+    grid: np.ndarray,
+    used: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    side: str,
+    color: int,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    r0, c0, r1, c1 = bbox
+    if side in ("left", "right"):
+        slots = list(range(r0, r1 + 1))
+    else:
+        slots = list(range(c0, c1 + 1))
