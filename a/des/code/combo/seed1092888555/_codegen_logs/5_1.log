+    size = patch.shape[0]
+    for idx in range(layers):
+        side = size + 2 + 2 * idx
+        r0 = top + (layers - 1 - idx)
+        c0 = left + (layers - 1 - idx)
+        r1 = r0 + side - 1
+        c1 = c0 + side - 1
+        color = int(frame_colors[idx])
