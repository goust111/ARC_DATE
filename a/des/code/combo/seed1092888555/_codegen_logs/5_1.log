+def _color_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _is_frame(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+    return set(comp["coords"]) == border
+
+
+def _extract_groups(grid: np.ndarray) -> list[dict]:
+    comps = _color_components(grid, BG)
+    frames = [comp for comp in comps if _is_frame(comp)]
+    frame_by_bbox = {tuple(comp["bbox"]): comp for comp in frames}
+    roots: list[tuple[int, int, int, int]] = []
+    for comp in frames:
+        r0, c0, r1, c1 = comp["bbox"]
+        inner_bbox = (r0 + 1, c0 + 1, r1 - 1, c1 - 1)
+        if inner_bbox not in frame_by_bbox:
+            roots.append(tuple(comp["bbox"]))
+
+    groups = []
+    frame_cells = {coord for comp in frames for coord in comp["coords"]}
+    for root_bbox in sorted(roots):
+        chain = []
+        bbox = root_bbox
+        while bbox in frame_by_bbox:
+            chain.append(frame_by_bbox[bbox])
+            r0, c0, r1, c1 = bbox
+            bbox = (r0 - 1, c0 - 1, r1 + 1, c1 + 1)
+        inner = chain[0]["bbox"]
+        ir0, ic0, ir1, ic1 = inner
+        object_coords = []
+        for r in range(ir0 + 1, ir1):
+            for c in range(ic0 + 1, ic1):
+                if int(grid[r, c]) != BG and (r, c) not in frame_cells:
+                    object_coords.append((r, c))
+        if not object_coords:
+            continue
+        groups.append({"frames": chain, "object_coords": object_coords})
+    return groups
+
+
+def _rotate_object_patch(grid: np.ndarray, coords: list[tuple[int, int]], turns_cw: int) -> tuple[np.ndarray, tuple[int, int], tuple[int, int]]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, c0, r1, c1 = min(rows), min(cols), max(rows), max(cols)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        patch[r - r0, c - c0] = int(grid[r, c])
+    rotated = np.rot90(patch, -turns_cw)
+    return rotated, (r0, c0), (r1, c1)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Rotate each center object clockwise once per nested frame layer."""
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    groups = _extract_groups(g)
+    for group in groups:
+        turns = len(group["frames"]) % 4
+        coords = group["object_coords"]
+        rotated, (r0, c0), (r1, c1) = _rotate_object_patch(g, coords, turns)
+        for r, c in coords:
+            out[r, c] = BG
+        new_h, new_w = rotated.shape
+        center_r2 = r0 + r1
+        center_c2 = c0 + c1
+        dest_r0 = (center_r2 - (new_h - 1)) // 2
+        dest_c0 = (center_c2 - (new_w - 1)) // 2
+        inner_bbox = group["frames"][0]["bbox"]
+        fr0, fc0, fr1, fc1 = inner_bbox
+        for rr in range(new_h):
+            for cc in range(new_w):
+                val = int(rotated[rr, cc])
+                if val == BG:
+                    continue
+                gr = dest_r0 + rr
+                gc = dest_c0 + cc
+                assert fr0 < gr < fr1 and fc0 < gc < fc1
+                out[gr, gc] = val
+    return out
+
+
+def _mask_to_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = color
+    return patch
