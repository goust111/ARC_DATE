+def _build_candidate_grid(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(12, 22)
+    w = rng.randint(12, 22)
+    k = rng.randint(4, min(7, 9))
+    owner = _grow_partition(h, w, k, rng)
+    sizes = Counter(owner.flatten().tolist())
