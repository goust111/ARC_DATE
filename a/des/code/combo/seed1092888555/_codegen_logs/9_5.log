+                    adj[b][a] += 1
+            if c + 1 < w:
+                b = int(labels[r, c + 1])
+                if b != 0 and b != a:
+                    adj[a][b] += 1
+                    adj[b][a] += 1
+    return adj
+
+
+def _winner_neighbor(adj: dict[int, Counter], region_id: int) -> int | None:
+    if region_id not in adj or not adj[region_id]:
+        return None
+    items = list(adj[region_id].items())
+    items.sort(key=lambda x: (-x[1], x[0]))
+    return int(items[0][0])
