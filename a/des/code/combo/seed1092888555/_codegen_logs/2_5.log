+        if not placed:
+            return None
+
+    if len(_find_components(grid == RED)) != obj_count:
+        return None
+    if np.array_equal(main(grid), grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

