+        used_cols.add(center_col)
+        return True
+    return False
+
+
+def _bars_do_not_overlap(out: np.ndarray, bg: int) -> bool:
+    painted = out != bg
+    unique_painted = sum(np.count_nonzero(out == color) for color in np.unique(out) if int(color) != bg)
+    return int(painted.sum()) == int(unique_painted)
