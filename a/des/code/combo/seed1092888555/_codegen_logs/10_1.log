+    row_by_col[-1] = box_h - 1
+    cells = {(row_by_col[c], c) for c in range(box_w)}
+
+    remaining = [(r, c) for r in range(box_h) for c in range(box_w) if (r, c) not in cells]
+    random.shuffle(remaining)
+    for cell in remaining[: count - len(cells)]:
+        cells.add(cell)
+    return cells
+
+
