+    kind = rng.choice(["hollow", "notch", "plus", "l"])
+    if kind == "hollow":
+        h = rng.randint(3, 6)
+        w = rng.randint(3, 6)
+        return _hollow_rect(h, w)
+    if kind == "notch":
+        h = rng.randint(2, 6)
+        w = rng.randint(2, 6)
+        return _notched_rect(h, w, rng)
+    if kind == "plus":
+        h = rng.choice([3, 5])
+        w = rng.choice([3, 5])
+        return _plus_shape(h, w)
+    h = rng.randint(3, 6)
+    w = rng.randint(3, 6)
+    return _l_shape(h, w)
+
+
+def _sample_solid_shape(rng: random.Random) -> np.ndarray:
+    h = rng.randint(2, 5)
+    w = rng.randint(2, 6)
+    return _solid_rect(h, w)
+
+
+def _mask_is_4_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    stack = [start]
