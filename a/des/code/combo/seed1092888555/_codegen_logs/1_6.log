+    red_pts = np.argwhere(panel == RED)
+    assert red_pts.shape == (1, 2), "each panel must contain exactly one red marker"
+    r, c = map(int, red_pts[0])
+    h, w = panel.shape
+    assert h == w and h > 0
+    top = r < h // 2
+    left = c < w // 2
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and left:
+        return "bl"
+    return "br"
+
+
+def _center_top_left(outer: int, inner: int) -> int:
