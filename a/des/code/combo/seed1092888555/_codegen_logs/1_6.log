+    h, w = panel.shape
+    assert h == w and h > 0
+    top = r < h // 2
+    left = c < w // 2
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and left:
+        return "bl"
+    return "br"
+
