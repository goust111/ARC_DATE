+INSTRUCTIONS = ("tl", "tr", "bl", "br")
+
+
+def _separator_runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    indices = sorted(indices)
+    runs: list[tuple[int, int]] = []
+    start = end = indices[0]
+    for idx in indices[1:]:
+        if idx == end + 1:
+            end = idx
+        else:
+            runs.append((start, end))
+            start = end = idx
+    runs.append((start, end))
+    return runs
+
