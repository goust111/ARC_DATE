+            elif side == "top":
+                mask[gap, pos] = True
+            else:
+                mask[h - 1 - gap, pos] = True
+        # Prefer candidates whose marker cells are all isolated singletons.
+        score = 0
+        for r, c in zip(*np.where(mask), strict=False):
