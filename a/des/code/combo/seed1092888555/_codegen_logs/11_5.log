+        if len(cols) == 1 and 1 <= int(cols[0]) <= 5:
+            left_entries.append((r, int(cols[0]), int(grid[r, int(cols[0])])))
+    add_candidate("left", left_entries)
+
+    right_entries = []
+    for r in range(h):
