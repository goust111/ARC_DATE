+    add_candidate("left", left_entries)
+
+    right_entries = []
+    for r in range(h):
+        cols = np.flatnonzero(grid[r] != bg)
+        if len(cols) == 1:
+            gap = w - 1 - int(cols[0])
+            if 1 <= gap <= 5:
