+    used_colors = {BG}
+    pair_frames = []
+    for horizontal in orientations:
+        (_, _, _), rel_frames = _sample_pair(rng, horizontal)
+        pair_h = max(f["top"] + f["oh"] for f in rel_frames)
+        pair_w = max(f["left"] + f["ow"] for f in rel_frames)
