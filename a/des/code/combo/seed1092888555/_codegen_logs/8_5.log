+        interior = {(r - min_r, c - min_c) for r, c in interior}
+        boundary = {(r - min_r, c - min_c) for r, c in boundary}
+        box_h = max(r for r, _ in boundary) + 1
+        box_w = max(c for _, c in boundary) + 1
+
+        placed = False
+        if box_h > h - 2 or box_w > w - 2:
