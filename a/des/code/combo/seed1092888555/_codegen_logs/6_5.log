+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "area": len(coords),
