+    if dr == 0:
+        return [(-1, 0), (0, 0), (1, 0)]
+    if dc == 0:
+        return [(0, -1), (0, 0), (0, 1)]
+    if dr == dc:
+        return [(-1, 1), (0, 0), (1, -1)]
+    return [(-1, -1), (0, 0), (1, 1)]
+
+
