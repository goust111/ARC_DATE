+    r1 = min(grid.shape[0], top + h + 1)
+    c0 = max(0, left - 1)
+    c1 = min(grid.shape[1], left + w + 1)
+    occupied[r0:r1, c0:c1] = True
+
+
+def _free(occupied: np.ndarray, top: int, left: int, height: int, width: int) -> bool:
+    h, w = occupied.shape
