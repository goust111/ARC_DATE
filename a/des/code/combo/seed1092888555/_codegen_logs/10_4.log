+    comps = _find_components(g, bg)
+    out = g.copy()
+    used: set[int] = set()
+
+    for left_idx, right_idx in _candidate_pairs(comps):
+        if left_idx in used or right_idx in used:
+            continue
+        left = comps[left_idx]
+        right = comps[right_idx]
+        if not _is_mirror_pair(left, right):
+            continue
+
+        used.add(left_idx)
+        used.add(right_idx)
