+    if total_colors > len(PALETTE):
+        return None
+    colors = random.sample(PALETTE, total_colors)
+    pair_colors = colors[:pair_count]
+    distractor_colors = colors[pair_count:]
+
+    used_shape_keys: set[tuple] = set()
