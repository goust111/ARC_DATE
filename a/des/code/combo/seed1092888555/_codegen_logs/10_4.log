+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        if min(rows) == 0 and max(rows) == height - 1 and min(cols) == 0 and max(cols) == width - 1:
+            break
+        if min(rows) > 0:
+            cells.add((0, random.randrange(width)))
+        if max(rows) < height - 1:
+            cells.add((height - 1, random.randrange(width)))
+        if min(cols) > 0:
+            cells.add((random.randrange(height), 0))
