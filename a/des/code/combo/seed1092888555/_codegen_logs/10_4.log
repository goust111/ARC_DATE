+        r0, c0, r1, _ = left["bbox"]
+        _, _, _, rc1 = right["bbox"]
+        union_w = rc1 - c0 + 1
+        merged_w = left["width"] + right["width"]
+        start_c = c0 + (union_w - merged_w) // 2
+
+        for rr, cc in left["coords"]:
+            out[rr, cc] = bg
+        for rr, cc in right["coords"]:
+            out[rr, cc] = bg
