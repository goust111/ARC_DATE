    r0, c0 = qr * QUADRANT_SIZE, qc * QUADRANT_SIZE
    return [(r, c) for r in range(r0, r0 + QUADRANT_SIZE) for c in range(c0, c0 + QUADRANT_SIZE)]


def _place_marker(grid):
