+            interior[pr, pc] = frame_colors[target]
+        if np.count_nonzero(interior == _BG) < 2:
+            return None
+        grid[r0 + 1 : r0 + 1 + inner_h, c0 + 1 : c0 + 1 + inner_w] = interior
