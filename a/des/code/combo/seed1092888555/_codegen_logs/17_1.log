+_BG = 0
+_FRAME_COUNT_RANGE = (3, 6)
+_INNER_H_RANGE = (4, 8)
+_INNER_W_RANGE = (4, 8)
+_GRID_H_RANGE = (20, 31)
+_GRID_W_RANGE = (20, 31)
+_MIN_FRAME_GAP = 2
+_MAX_GEN_ATTEMPTS = 400
