+def _solid_shape(rng: random.Random) -> np.ndarray:
+    style = rng.choice(["rect", "plus", "step"])
+    if style == "rect":
+        h = rng.randint(4, 8)
+        w = rng.randint(4, 8)
+        return np.ones((h, w), dtype=bool)
