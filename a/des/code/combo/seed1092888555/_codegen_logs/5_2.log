+def _place_shape(grid: np.ndarray, occupied: np.ndarray, shape: np.ndarray, color: int, top: int, left: int):
+    h, w = shape.shape
+    region = grid[top : top + h, left : left + w]
+    region[shape] = color
+    occupied[top : top + h, left : left + w] |= shape
+
