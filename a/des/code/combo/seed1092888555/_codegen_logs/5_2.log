+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    gh = rng.randint(*GRID_H_RANGE)
+    gw = rng.randint(*GRID_W_RANGE)
+    grid = np.full((gh, gw), BG_COLOR, dtype=int)
+    occupied = np.zeros((gh, gw), dtype=bool)
