+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                cr, cc = q.popleft()
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _erode4(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            keep = True
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                    keep = False
+                    break
+            out[r, c] = keep
+    return out
+
+
+def _outline_mask(mask: np.ndarray, thickness: int) -> np.ndarray:
+    eroded = mask.copy()
+    for _ in range(thickness):
+        eroded = _erode4(eroded)
+        if not eroded.any():
+            break
+    return mask & ~eroded
