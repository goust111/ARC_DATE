+    side_lo, side_hi = FRAME_SIDE_RANGE
+    if large:
+        fh = rng.randint(max(6, side_lo + 2), min(h - 2, side_hi + 2))
+        fw = rng.randint(max(6, side_lo + 2), min(w - 2, side_hi + 2))
+    else:
