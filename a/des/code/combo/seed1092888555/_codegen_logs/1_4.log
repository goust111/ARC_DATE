+    bottom = np.any(grid[r1, c0 : c1 + 1] == color)
+    left = np.any(grid[r0 : r1 + 1, c0] == color)
+    right = np.any(grid[r0 : r1 + 1, c1] == color)
+    return bool(top and bottom and left and right)
+
