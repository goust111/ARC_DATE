def _gen_triangle_mask(shape, corner, side):
    H, W = shape
    rr, cc = np.indices((H, W))
    if corner == "TL":
        return rr + cc < side
    if corner == "TR":
        return rr + (W - 1 - cc) < side
    if corner == "BL":
        return (H - 1 - rr) + cc < side
    return (H - 1 - rr) + (W - 1 - cc) < side


def _gen_dilate8(mask):
    out = mask.copy()
    out[1:, :] |= mask[:-1, :]
    out[:-1, :] |= mask[1:, :]
    out[:, 1:] |= mask[:, :-1]
    out[:, :-1] |= mask[:, 1:]
    out[1:, 1:] |= mask[:-1, :-1]
    out[1:, :-1] |= mask[:-1, 1:]
    out[:-1, 1:] |= mask[1:, :-1]
    out[:-1, :-1] |= mask[1:, 1:]
    return out


