+) -> list[list[int]] | None:
+    capacities = [w - 2, h - 2, w - 2, h - 2]
+    for _ in range(300):
+        buckets = [[] for _ in range(4)]
+        for idx in rng.permutation(len(lengths)):
+            edge = int(rng.integers(0, 4))
