+    random.shuffle(specs)
+    grid = _place_objects(h, w, specs)
+    if grid is None:
+        return None
+    if not _validate(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid compass-slide input")

