+    by_color: dict[int, list[dict]] = {}
+    for color in [int(x) for x in np.unique(g) if int(x) != bg]:
+        for coords in _find_components(g == color):
+            info = _frame_info(g, color, coords)
+            if info is not None:
+                by_color.setdefault(int(color), []).append(info)
