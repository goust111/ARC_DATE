+    ww = c1 - c0 + 1
+    if hh < 3 or ww < 3:
+        return None
+    expected = 2 * (hh + ww) - 4
+    if len(coords) != expected:
+        return None
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((hh, ww), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
