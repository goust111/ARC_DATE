+        need_h = spec["reserve_h"]
+        need_w = spec["reserve_w"]
+        for r0 in range(grid_h - need_h + 1):
+            for c0 in range(grid_w - need_w + 1):
+                rr0 = max(0, r0 - 1)
+                cc0 = max(0, c0 - 1)
