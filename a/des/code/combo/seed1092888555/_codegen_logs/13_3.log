+                cc1 = min(grid_w, c0 + need_w + 1)
+                if occupied[rr0:rr1, cc0:cc1].any():
+                    continue
+                candidates.append((r0, c0))
+        if not candidates:
+            return None
+        chosen = random.choice(candidates)
