+            choices = [BG] + list(PATTERN_COLORS)
+            rng.shuffle(choices)
+            for val in choices:
+                if val != pattern[r, partner] and val != pattern[rr, partner]:
+                    pattern[r, c] = val
+                    pattern[rr, c] = val
+                    return pattern
+    return pattern
+
+
+def _force_break_horizontal(pattern: np.ndarray, rng: random.Random) -> np.ndarray:
+    size = pattern.shape[0]
+    if size < 2:
+        return pattern
+    for _ in range(40):
