+    horiz = np.array_equal(pattern, np.flipud(pattern))
+    vert = np.array_equal(pattern, np.fliplr(pattern))
+    if horiz and vert:
+        return "both"
+    if horiz:
+        return "horiz"
+    if vert:
+        return "vert"
+    return "none"
+
