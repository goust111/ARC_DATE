+
+def _generate_quadrant_masks(size: int) -> list[np.ndarray] | None:
+    bridge_rows = {
+        "top": int(_RNG.integers(size)),
+        "bottom": int(_RNG.integers(size)),
+    }
+    bridge_cols = {
