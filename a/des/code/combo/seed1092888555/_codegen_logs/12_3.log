+    h, w = patch.shape
+    split_r = random.randint(3, h - 3)
+    split_c = random.randint(3, w - 3)
+    block_colors = random.sample(colors, 4) if len(colors) >= 4 else [colors[0], colors[1], colors[0], colors[1]]
