+    main_c = random.randint(1, W - main_w - 1)
+    main_patch = _make_main_patch(main_h, main_w)
+
+    hole_count = random.randint(1, min(4, len(SHAPE_LIBRARY)))
+    shapes = random.sample(SHAPE_LIBRARY, hole_count)
