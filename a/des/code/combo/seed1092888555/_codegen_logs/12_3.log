+
+def _paint_stripes(patch: np.ndarray, colors: list[int], vertical: bool) -> None:
+    h, w = patch.shape
+    spans = _rand_partition(w if vertical else h, len(colors), 3)
+    pos = 0
+    for span, color in zip(spans, colors):
+        if vertical:
+            patch[:, pos : pos + span] = color
+        else:
