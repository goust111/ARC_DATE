+    elif side == "left":
+        starters = [(r, 0) for r in np.where(hole[:, 0])[0]]
+    else:
+        starters = [(r, hole.shape[1] - 1) for r in np.where(hole[:, -1])[0]]
+
+    q = deque(starters)
+    for sr, sc in starters:
