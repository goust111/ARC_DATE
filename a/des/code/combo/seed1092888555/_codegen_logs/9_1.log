+def _dilate(coords: Iterable[tuple[int, int]], shape: tuple[int, int], radius: int = 1) -> set[tuple[int, int]]:
+    h, w = shape
+    out = set()
+    for r, c in coords:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
+
