+def _cavity_info(grid: np.ndarray, comp: dict, bg: int) -> tuple[str, np.ndarray]:
+    r0, c0, r1, c1 = comp["bbox"]
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    hole = patch == bg
