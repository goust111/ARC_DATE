+    occupancy: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> tuple[list[tuple[int, int]], bool]:
+    h, w = shape
+    dr, dc = DIR_VECS[side]
+    painted = set()
+    hit_object = False
+    for sr, sc in cavity_abs:
+        r, c = sr, sc
+        while 0 <= r < h and 0 <= c < w:
+            if (r, c) in occupancy:
+                hit_object = True
+                break
+            painted.add((r, c))
+            r += dr
+            c += dc
+    return sorted(painted), hit_object
