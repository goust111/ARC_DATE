+        c0 = random.randint(0, panel.shape[1] - w)
+        placed = {(r0 + r, c0 + c) for r, c in cells}
+        dilated = {
+            nbr
+            for cell in placed
+            for nbr in ([cell] + [n for n in _neighbors(*cell) if 0 <= n[0] < panel.shape[0] and 0 <= n[1] < panel.shape[1]])
