+    max_dr = max(dr for dr, _ in offsets)
+    min_dc = min(dc for _, dc in offsets)
+    max_dc = max(dc for _, dc in offsets)
+
+    interior = random.random() < 0.5
+    for _ in range(120):
+        if interior:
+            r_lo = max(0, -min_dr)
+            r_hi = min(out_shape[0] - 1, out_shape[0] - 1 - max_dr)
