+                degree = {cell: sum((nbr in coords) for nbr in _neighbors(*cell)) for cell in coords}
+                endpoints = sorted([cell for cell, d in degree.items() if d == 1])
+                if len(endpoints) != 2:
+                    upper[upper == color] = BG
