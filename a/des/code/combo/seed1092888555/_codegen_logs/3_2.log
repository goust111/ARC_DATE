+import numpy as np
+
+
+BG = 5
+SEP = 9
+PALETTE = [1, 2, 3, 4, 6, 7, 8]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_ATTEMPTS = 400
