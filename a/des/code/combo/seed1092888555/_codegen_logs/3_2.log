+
+    r0, c0, _, _ = comp["bbox"]
+    rel = [(r - r0, c - c0) for r, c in ordered]
+    start_rel = rel[0][0], rel[0][1]
+    return comp["color"], [(r - start_rel[0], c - start_rel[1]) for r, c in rel]
