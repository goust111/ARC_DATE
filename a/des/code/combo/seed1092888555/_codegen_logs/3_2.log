+    comps = []
+    for r, c in np.argwhere((g != bg) & (g != SEP)):
+        rr, cc = int(r), int(c)
+        if used[rr, cc]:
+            continue
+        coords = _component_from(g, (rr, cc), used)
+        rows = [p[0] for p in coords]
+        cols = [p[1] for p in coords]
+        comps.append(
+            {
+                "color": int(g[rr, cc]),
+                "coords": coords,
+                "bbox": (min(rows), min(cols), max(rows), max(cols)),
+            }
+        )
+    return comps
