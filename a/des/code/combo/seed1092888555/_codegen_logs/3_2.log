+        r, c = q.popleft()
+        coords.append((r, c))
+        for nr, nc in _neighbors(r, c):
+            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and not used[nr, nc] and g[nr, nc] == color:
+                used[nr, nc] = True
