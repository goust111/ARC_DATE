+    col_starts = _room_starts(widths, left_margin)
+    wall_rows = [top_margin] + [row_starts[i] + heights[i] for i in range(room_rows)]
+    wall_cols = [left_margin] + [col_starts[j] + widths[j] for j in range(room_cols)]
+
+    for wr in wall_rows:
