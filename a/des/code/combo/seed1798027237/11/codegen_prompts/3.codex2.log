+    doors: dict[tuple[int, int], int] = {}
+    for comp in _same_color_components(grid, colored):
+        if len(comp) != 1:
+            continue
+        r, c = comp[0]
+        if not (0 < r < h - 1 and 0 < c < w - 1):
+            continue
+        vertical = (
+            int(grid[r - 1, c]) == WALL
+            and int(grid[r + 1, c]) == WALL
+            and int(grid[r, c - 1]) != WALL
+            and int(grid[r, c + 1]) != WALL
+        )
+        horizontal = (
+            int(grid[r, c - 1]) == WALL
+            and int(grid[r, c + 1]) == WALL
+            and int(grid[r - 1, c]) != WALL
+            and int(grid[r + 1, c]) != WALL
+        )
+        if vertical or horizontal:
+            doors[(r, c)] = int(grid[r, c])
+    return doors
+
