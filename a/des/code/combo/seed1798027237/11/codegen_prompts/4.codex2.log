+    comps = _components(holes)
+    assert len(comps) == 1, "each object must contain exactly one enclosed hole"
+    hole_mask, _ = _coords_to_local_mask(comps[0])
+    return hole_mask
+
+
+def _match_rotation(key: np.ndarray, hole: np.ndarray) -> int | None:
