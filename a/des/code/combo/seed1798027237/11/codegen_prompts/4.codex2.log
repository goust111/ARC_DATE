+def _make_object_mask(hole: np.ndarray, rng: random.Random) -> np.ndarray:
+    hh, ww = hole.shape
+    for _ in range(80):
+        pad_r = rng.randint(2, 3)
+        pad_c = rng.randint(2, 3)
+        mask = np.ones((hh + 2 * pad_r, ww + 2 * pad_c), dtype=bool)
+        center = mask[pad_r : pad_r + hh, pad_c : pad_c + ww]
+        center[hole] = False
