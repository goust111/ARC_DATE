+def _dihedral_masks(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for variant in (rot, np.fliplr(rot)):
+            key = (tuple(map(int, variant.shape)), variant.tobytes())
+            if key not in seen:
