+            coords_np = np.array(coords, dtype=int)
+            r0, c0 = coords_np.min(axis=0)
+            r1, c1 = coords_np.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
