            if c > 0 and c + 1 < w and out[r, c - 1] == out[r, c + 1] != UNKNOWN:
                candidates.append(int(out[r, c - 1]))
            if candidates and len(set(candidates)) == 1:
                out[r, c] = candidates[0]
                changed = True

    return out


