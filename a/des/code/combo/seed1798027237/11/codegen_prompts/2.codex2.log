            patch[r, right_wall] = BLACK
        patch[main_h - 1, :] = BLACK  # connection row
        patch[-1, :mini_w] = BLACK
        for r in range(main_h, sh):
            patch[r, 0] = BLACK
            patch[r, mini_w - 1] = BLACK


