+UP = "up"
+DOWN = "down"
+LEFT = "left"
+RIGHT = "right"
+
+DIR_VEC = {
+    UP: (-1, 0),
+    DOWN: (1, 0),
+    LEFT: (0, -1),
+    RIGHT: (0, 1),
+}
+
+BODY_OFFSETS = {
+    UP: ((-2, 0), (-1, -1), (-1, 0), (-1, 1), (0, 0), (1, 0)),
+    DOWN: ((-1, 0), (0, 0), (1, 0), (1, -1), (1, 1), (2, 0)),
+    LEFT: ((0, -2), (0, -1), (0, 0), (-1, -1), (1, -1), (0, 1)),
+    RIGHT: ((0, -1), (0, 0), (0, 1), (-1, 1), (1, 1), (0, 2)),
+}
+
+ROD_OFFSETS = {
+    UP: ((-1, 0), (0, 0), (1, 0)),
+    DOWN: ((-1, 0), (0, 0), (1, 0)),
+    LEFT: ((0, -1), (0, 0), (0, 1)),
+    RIGHT: ((0, -1), (0, 0), (0, 1)),
+}
+
+TIP_OFFSET = {
+    UP: (-2, 0),
+    DOWN: (2, 0),
+    LEFT: (0, -2),
+    RIGHT: (0, 2),
+}
+
+TAIL_OFFSET = {
+    UP: (2, 0),
+    DOWN: (-2, 0),
+    LEFT: (0, 2),
+    RIGHT: (0, -2),
+}
+
+TEMPLATE_BY_BBOX = {
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (3, 1)): {
+        "dir": UP,
+        "center_in_bbox": (2, 1),
+        "tip_in_bbox": (0, 1),
+        "tail_in_bbox": (4, 1),
+        "rod_in_bbox": ((1, 1), (2, 1), (3, 1)),
+    },
+    ((0, 1), (1, 1), (2, 0), (2, 1), (2, 2), (3, 1)): {
+        "dir": DOWN,
+        "center_in_bbox": (1, 1),
+        "tip_in_bbox": (3, 1),
+        "tail_in_bbox": (-1, 1),
