+    return cells
+
+
+def _lane_to_edge(shape: tuple[int, int], tip: tuple[int, int], direction: str) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = DIR_VEC[direction]
+    r = tip[0] + dr
+    c = tip[1] + dc
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
