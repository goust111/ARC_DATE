    c0 = random.randint(1, W - fullw - 1)
    fg, noise_a, noise_b = random.sample(PALETTE, 3)
    clean = np.zeros((H, W), dtype=int)
    clean[r0:r0+fullh, c0:c0+fullw][local] = fg
    axis = (orientation, 2*c0+fullw-1) if orientation == 'vertical' else (orientation, 2*r0+fullh-1)
