from __future__ import annotations
import random
import numpy as np

BACKGROUND = 0
PALETTE = [1,2,3,4,5,6,7,8,9]
NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))


def mirror(axis, r, c):
