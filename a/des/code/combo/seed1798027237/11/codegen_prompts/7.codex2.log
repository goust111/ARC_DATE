    return [('vertical', s) for s in range(2*w-1)] + [('horizontal', s) for s in range(2*h-1)]


def score(g, fg, bg, axis):
    h, w = g.shape
    contradictions = 0
    unmatched = 0
    signal = 0
    exact = 0
    recover = 0
    self_noise = 0
    for r in range(h):
        for c in range(w):
            rr, cc = mirror(axis, r, c)
            if not (0 <= rr < h and 0 <= cc < w):
                if g[r, c] "'!= bg:
                    unmatched += 1
                continue
            if (rr < r) or (rr == r and cc < c):
                continue
            va = int(g[r, c])
            vb = int(g[rr, cc])
            if va != bg or vb != bg:
                signal += 1
            a_known = va == bg or va == fg
            b_known = vb == bg or vb == fg
            if a_known and b_known:
                if va == vb:
                    exact += 1
                else:
                    contradictions += 1
            else:
                recover += 1
            if r == rr and c == cc and not a_known:
                self_noise += 1
    return (contradictions, unmatched, -signal, -exact, -recover, self_noise)


def sorted_axes(g, fg, bg):
    return sorted((score(g, fg, bg, axis), axis) for axis in candidates(g.shape))


def infer_axis(g, fg, bg):
    return sorted_axes(g, fg, bg)[0][1]


def repair_pair(va, vb, fg, bg):
    a_known = va == bg or va == fg
    b_known = vb == bg or vb == fg
    if a_known and b_known:
        if va == vb:
            return va
        return fg if va == fg or vb == fg else bg
    if a_known:
        return va
    if b_known:
        return vb
    return fg


def solve(g):
    g = np.asarray(g, dtype=int)
    bg = 0
    colors, counts = np.unique(g[g != bg], return_counts=True)
    fg = int(colors[np.argmax(counts)])
    axis = infer_axis(g, fg, bg)
    h, w = g.shape
    out = np.full_like(g, bg)
    for r in range(h):
        for c in range(w):
            rr, cc = mirror(axis, r, c)
            if not (0 <= rr < h and 0 <= cc < w):
                out[r, c] = fg if g[r, c] == fg else bg
                continue
            if (rr < r) or (rr == r and cc < c):
                continue
            fill = repair_pair(int(g[r, c]), int(g[rr, cc]), fg, bg)
            out[r, c] = fill
            out[rr, cc] = fill
    return out


def grow_blob(h, w, target):
    for _ in range(60):
        seed = (random.randrange(h), random.randrange(w))
        cells = {seed}
        frontier = set()
        def add(rr, cc):
            for dr, dc in NEIGHBORS4:
