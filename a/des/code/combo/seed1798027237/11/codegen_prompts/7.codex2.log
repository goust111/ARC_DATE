            return m
    return None


def choose_disjoint(fg_pool, bg_pool, total, banned):
    fg_choices = [x for x in fg_pool if x not in banned]
    bg_choices = [x for x in bg_pool if x not in banned]
    if not fg_choices:
        return None
    pick = {random.choice(fg_choices)}
    remaining = total - 1
    others = [x for x in fg_choices + bg_choices if x not in pick]
    if remaining > len(others):
        return None
    if remaining > 0:
        pick.update(random.sample(others, remaining))
    return pick


def build():
    orientation = random.choice(['"'vertical', 'horizontal'])
