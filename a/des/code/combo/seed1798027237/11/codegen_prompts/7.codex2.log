    row0 = _sample_offset(grid_h, local_h)
    col0 = _sample_offset(grid_w, local_w)
    axis = ("horizontal", 2 * row0 + local_h - 1)
    return local, axis, row0, col0


def _pair_descriptors(
    local: np.ndarray, axis: Axis, row0: int, col0: int
