+def _source_cells(start_pipe: tuple[int, int], direction: tuple[int, int], offset: int) -> set[tuple[int, int]]:
+    r, c = start_pipe
+    if direction == (0, 1):
+        top, left = r - offset, c - 2
+    elif direction == (0, -1):
+        top, left = r - offset, c + 1
+    elif direction == (1, 0):
+        top, left = r - 2, c - offset
+    else:
