+        c = start
+        for color, length in zip(band_colors, lengths):
+            grid[-1, c : c + length] = color
+            c += length
+        return
+    if side == "left":
+        start = near_margin if near_low_end else grid.shape[0] - near_margin - total
+        r = start
+        for color, length in zip(band_colors, lengths):
+            grid[r : r + length, 0] = color
+            r += length
+        return
+
+    start = near_margin if near_low_end else grid.shape[0] - near_margin - total
+    r = start
+    for color, length in zip(band_colors, lengths):
+        grid[r : r + length, -1] = color
+        r += length
+
+
