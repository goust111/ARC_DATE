+from __future__ import annotations
+
+from collections import deque
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 400
+LAYER_RANGE = (2, 5)
+INNER_SIZE_RANGE = (3, 8)
+EXTRA_MARGIN_RANGE = (4, 6)
