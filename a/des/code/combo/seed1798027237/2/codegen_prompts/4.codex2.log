+    for layer in range(layers):
+        bbox = (
+            top_margin + 2 * layer,
+            left_margin + 2 * layer,
+            top_margin + outer_h - 1 - 2 * layer,
+            left_margin + outer_w - 1 - 2 * layer,
+        )
+        layer_bboxes.append(bbox)
+        _draw_frame(grid, bbox, frame_colors[layer])
