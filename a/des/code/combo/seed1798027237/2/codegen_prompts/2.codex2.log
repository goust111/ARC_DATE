import random, numpy as np

def comp(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    comps=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                comps+=1
                st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return comps

def touches_all(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def rand_growth(h,w):
    area=h*w
    k=random.randint(max(3,area//3), min(area-3, 2*area//3))
    mask=np.zeros((h,w),dtype=bool)
    seed=(random.randrange(h),random.randrange(w))
    mask[seed]=1
    frontier={(seed[0]+dr,seed[1]+dc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=seed[0]+dr<h and 0<=seed[1]+dc<w}
    while mask.sum()<k and frontier:
        cell=random.choice(tuple(frontier))
        frontier.remove(cell)
        mask[cell]=1
        r,c=cell
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and not mask[nr,nc]:
                frontier.add((nr,nc))
    return mask

for dims in [(4,4),(5,5),(6,6),(4,6),(5,7)]:
