import random, numpy as np
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1
                st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def rand_path(h,w,steps=100):
    edges=[]
    for c in range(w): edges.append((0,c)); edges.append((h-1,c))
    for r in range(1,h-1): edges.append((r,0)); edges.append((r,w-1))
    start=random.choice(edges)
    path=[start]; seen={start}
    touched={('top' if start[0]==0 else 'bottom' if start[0]==h-1 else 'left' if start[1]==0 else 'right')}
    cur=start
    for _ in range(steps):
        nbrs=[]
        for dr,dc in DIRS:
            nr,nc=cur[0]+dr,cur[1]+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:
                nbrs.append((nr,nc))
        if not nbrs: break
        # bias to boundaries not yet touched
        scored=[]
        for cell in nbrs:
            s=1
            r,c=cell
            for name,cond in [('top',r==0),('bottom',r==h-1),('left',c==0),('right',c==w-1)]:
                if cond and name not in touched: s+=5
            scored.append(s)
        cur=random.choices(nbrs,weights=scored)[0]
        path.append(cur); seen.add(cur)
        r,c=cur
        if r==0: touched.add('top')
        if r==h-1: touched.add('bottom')
        if c==0: touched.add('left')
        if c==w-1: touched.add('right')
        if len(touched)==4 and len(path)>=max(h,w)+2:
            break
    m=np.zeros((h,w),dtype=bool)
    for p in path: m[p]=1
    return m

for dims in [(5,5),(6,6),(5,7),(6,7)]:
    ok=0
    ex=None
    for t in range(20000):
        m=rand_path(*dims)
        if not touches(m) or not touches(~m): continue
        if comps(m)==1 and comps(~m)==1:
            ok+=1
            ex=m; break
    print(dims, 'ok', ok)
    if ex is not None:
        print(ex.astype(int))
