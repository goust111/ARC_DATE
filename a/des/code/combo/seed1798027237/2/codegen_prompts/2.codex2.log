import random, numpy as np, math, time
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1
                st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def touch_count(mask):
    return sum([mask[0].any(),mask[-1].any(),mask[:,0].any(),mask[:,-1].any()])

def score(m):
    a=comps(m); b=comps(~m)
    s=100*(a-1)+100*(b-1)
    s += 10*(4-touch_count(m)) + 10*(4-touch_count(~m))
    # encourage both colors on each edge and area balance
    h,w=m.shape
    area=int(m.sum())
    s += abs(area - (h*w//2))
    return s

h=w=6
m=np.zeros((h,w),dtype=bool)
m[:,:3]=1
# add crude tunnels
m[1,0]=0; m[1,1]=0; m[2,1]=0; m[2,2]=0
m[3,3]=1; m[3,4]=1; m[4,4]=1; m[4,5]=1
cur=score(m)
print('start',cur)
print('\\n'.join(''.join('1' if x else '0' for x in row) for row in m))
T=5
best=m.copy(); bests=cur
start=time.time()
for step in range(200000):
    if cur==0:
        print('FOUND step',step,'time',time.time()-start)
        print('\\n'.join(''.join('1' if x else '0' for x in row) for row in m))
        break
    r1,c1=random.randrange(h),random.randrange(w)
    r2,c2=random.randrange(h),random.randrange(w)
    if m[r1,c1]==m[r2,c2]:
        continue
    m[r1,c1]=~m[r1,c1]
    m[r2,c2]=~m[r2,c2]
    ns=score(m)
    if ns<=cur or random.random()<math.exp((cur-ns)/max(T,1e-9)):
        cur=ns
        if cur<bests:
            bests=cur; best=m.copy(); print('best',bests,'step',step)
            print('\\n'.join(''.join('1' if x else '0' for x in row) for row in best)); print()
    else:
        m[r1,c1]=~m[r1,c1]
        m[r2,c2]=~m[r2,c2]
    T*=0.99998
else:
    print('final best',bests)
    print('\\n'.join(''.join('1' if x else '0' for x in row) for row in best))
