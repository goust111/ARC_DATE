                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def ok(arr):
    return comps(arr)==1 and comps(~arr)==1 and arr[0].any() and arr[-1].any() and arr[:,0].any() and arr[:,-1].any() and (~arr)[0].any() and (~arr)[-1].any() and (~arr)[:,0].any() and (~arr)[:,-1].any()

top_ones=[(0,c) for c in range(8) if base[0,c]]
left_ones=[(r,0) for r in range(8) if base[r,0]]
all_ones=[(r,c) for r in range(8) for c in range(8) if base[r,c]]
# Candidate zeros near existing B mass.
all_zeros=[(r,c) for r in range(8) for c in range(8) if not base[r,c]]
