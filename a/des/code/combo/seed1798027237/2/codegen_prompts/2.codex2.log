base=np.array([[ch=='1' for ch in row] for row in ['1111110','0000010','0111010','0100010','0101110','0100000','0111111']],dtype=bool)
zero_cands=[(2,4),(3,3),(4,2),(3,4),(3,2)]
rem_cands=[(3,1),(4,1),(5,1),(2,5),(3,5),(4,5)]

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def ok(arr):
    return comps(arr)==1 and comps(~arr)==1 and arr[0].any() and arr[-1].any() and arr[:,0].any() and arr[:,-1].any() and (~arr)[0].any() and (~arr)[-1].any() and (~arr)[:,0].any() and (~arr)[:,-1].any()
