import numpy as np
n=9
m=np.zeros((n,n),dtype=bool)
# draw spiral path manually by shrinking bounds alternating directions
r0=c0=0; r1=c1=n-1
# custom spiral with gaps: top row to c1-1, right col to r1-1, bottom row back to c0+1, left col up to r0+2, then shrink by 2
while r0<=r1 and c0<=c1:
    for c in range(c0, c1): m[r0,c]=1
    for r in range(r0, r1): m[r,c1-1]=1
    if r1>r0:
        for c in range(c1-1, c0, -1): m[r1-1,c]=1
    if c1>c0:
        for r in range(r1-1, r0+1, -1): m[r,c0+1]=1
    r0+=2; c0+=2; r1-=2; c1-=2

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k
for arr,name in [(m,'A'),(~m,'B')]:
    print(name,'comp',comps(arr),'touch',arr[0].any(),arr[-1].any(),arr[:,0].any(),arr[:,-1].any(),'area',arr.sum())
print('\\n'.join(''.join('1' if x else '0' for x in row) for row in m.astype(int)))
