import itertools, numpy as np
rows=['1111110','0000010','0111010','0100010','0101110','0100000','0111111']
base=np.array([[ch=='1' for ch in row] for row in rows],dtype=bool)

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def ok(arr):
    return comps(arr)==1 and comps(~arr)==1 and arr[0].any() and arr[-1].any() and arr[:,0].any() and arr[:,-1].any() and (~arr)[0].any() and (~arr)[-1].any() and (~arr)[:,0].any() and (~arr)[:,-1].any()
# cells near interface
cand=[(r,c) for r in range(7) for c in range(7) if 1<=r<=5 and 0<=c<=6]
ones=[p for p in cand if base[p]]
zeros=[p for p in cand if not base[p]]
for k in [1,2,3]:
  for rem in itertools.combinations(ones,k):
    arr0=base.copy()
    for p in rem: arr0[p]=0
    for add in itertools.combinations(zeros,k):
      arr=arr0.copy()
      for p in add: arr[p]=1
      if ok(arr):
        print('found rem',rem,'add',add)
        print('\\n'.join(''.join('1' if x else '0' for x in row) for row in arr)); raise SystemExit
print('none')
