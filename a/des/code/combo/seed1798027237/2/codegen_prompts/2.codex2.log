import numpy as np

def cycle(h,w):
    if h%2==0:
        out=[]
        out.extend((0,c) for c in range(w))
        for r in range(1,h):
            if r%2==1:
                out.extend((r,c) for c in range(w-1,0,-1))
            else:
                out.extend((r,c) for c in range(1,w))
        out.extend((r,0) for r in range(h-1,0,-1))
        return out
    assert w%2==0
    base=cycle(w,h)
    return [(c,r) for r,c in base]

def touches(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    s=set(cells)
    return any(r==0 for r,c in s) and any(r==h-1 for r,c in s) and any(c==0 for r,c in s) and any(c==w-1 for r,c in s)

