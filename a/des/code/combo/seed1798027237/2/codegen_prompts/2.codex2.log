print('top',top_ones,'left',left_ones,'zeros',len(zero_candidates))
for top in top_ones:
    for left in left_ones:
        mandatory={top,left}
        rem_pool=[p for p in all_ones if p not in mandatory]
        for extra_rem_count in range(0,3):
            for extra_rem in itertools.combinations(rem_pool, extra_rem_count):
                rem=mandatory|set(extra_rem)
                arr0=base.copy()
                for p in rem: arr0[p]=0
                zeros=[p for p in zero_candidates if not arr0[p]]
                for add_count in range(0,5):
