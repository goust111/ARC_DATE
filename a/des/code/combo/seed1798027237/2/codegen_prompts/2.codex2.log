import random, numpy as np, math
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1
                st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def score(m):
    h,w=m.shape
    s=0
    for arr in (m,~m):
        s += (0 if arr[0].any() else 3)
        s += (0 if arr[-1].any() else 3)
        s += (0 if arr[:,0].any() else 3)
        s += (0 if arr[:,-1].any() else 3)
        s += 4*(comps(arr)-1)
    # discourage empty/full rows/cols for either side
    for r in range(h):
        a=int(m[r].sum())
        if a==0 or a==w: s+=4
    for c in range(w):
        a=int(m[:,c].sum())
        if a==0 or a==h: s+=4
    area=int(m.sum())
    if area<3 or area>h*w-3: s+=10
    return s

def rand_init(h,w):
    while True:
        m=np.random.rand(h,w)<0.5
        if 0<m.sum()<h*w:
            return m

def solve(h,w,tries=50,steps=20000):
    best=None; bests=10**9
    for _ in range(tries):
        m=rand_init(h,w)
