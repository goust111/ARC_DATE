import random, numpy as np
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def rand_tree(h,w):
    cells=[(r,c) for r in range(h) for c in range(w)]
    start=random.choice(cells)
    seen={start}
    stack=[start]
    edges=[]
    while stack:
        r,c=stack[-1]
        nbrs=[(r+dr,c+dc) for dr,dc in DIRS if 0<=r+dr<h and 0<=c+dc<w and (r+dr,c+dc) not in seen]
        if nbrs:
            nb=random.choice(nbrs)
            seen.add(nb)
            stack.append(nb)
            edges.append(((r,c),nb))
        else:
            stack.pop()
    return edges

def touches(nodes,h,w):
    return any(r==0 for r,c in nodes) and any(r==h-1 for r,c in nodes) and any(c==0 for r,c in nodes) and any(c==w-1 for r,c in nodes)

def comps_after_cut(edges, cut):
    adj={}
    for a,b in edges:
        if (a,b)==cut or (b,a)==cut:
            continue
        adj.setdefault(a,[]).append(b); adj.setdefault(b,[]).append(a)
    start=cut[0]
    st=[start]; seen={start}
    while st:
        x=st.pop()
        for y in adj.get(x,[]):
            if y not in seen:
                seen.add(y); st.append(y)
    allnodes=set(adj)|{cut[0],cut[1]}
    other=allnodes-seen
    return seen, other

for dims in [(5,5),(5,6),(6,6),(5,7),(6,7),(7,7),(6,8)]:
    h,w=dims
    ok=0
    for t in range(2000):
        edges=rand_tree(h,w)
        random.shuffle(edges)
        found=False
        for e in edges:
            a,b=comps_after_cut(edges,e)
            if min(len(a),len(b))<5: continue
            if touches(a,h,w) and touches(b,h,w):
                ok+=1
                print('found',dims,'tree',t,'edge',e,'sizes',len(a),len(b))
                grid=np.full((h,w),'.',dtype='<U1')
                for r,c in a: grid[r,c]='A'
                for r,c in b: grid[r,c]='B'
                print('\\n'.join(''.join(row) for row in grid))
                raise SystemExit
        
    print('none',dims)
