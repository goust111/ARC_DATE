import numpy as np
DIRS=[(0,1),(1,0),(0,-1),(-1,0)]

def spiral_variant(n,start_dir=0,turn=1,gap_side=1):
    # grow a one-cell-wide spiral corridor inside n x n by walking rectangle bounds.
    g=np.zeros((n,n),dtype=bool)
    top,left,bottom,right=0,0,n-1,n-1
    dir_idx=start_dir
    # position at corner implied by dir
    corners=[(0,0),(0,n-1),(n-1,n-1),(n-1,0)]
    # use start corner preceding direction
    r,c=corners[start_dir]
    g[r,c]=1
    steps=0
    while top<=bottom and left<=right:
        if dir_idx==0: # right
            end=right-(1 if gap_side==0 else 0)
            for cc in range(c+1,end+1): g[r,cc]=1
            c=end; top+=1
        elif dir_idx==1: # down
            end=bottom-(1 if gap_side==1 else 0)
            for rr in range(r+1,end+1): g[rr,c]=1
            r=end; right-=1
        elif dir_idx==2: # left
            end=left+(1 if gap_side==2 else 0)
            for cc in range(c-1,end-1,-1): g[r,cc]=1
            c=end; bottom-=1
        else: # up
            end=top+(1 if gap_side==3 else 0)
            for rr in range(r-1,end-1,-1): g[rr,c]=1
            r=end; left+=1
        dir_idx=(dir_idx+turn)%4
        steps+=1
        if steps>4*n: break
        gap_side=(gap_side+1)%4
    return g

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dr,y+dc
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def ok(arr):
    return comps(arr)==1 and comps(~arr)==1 and arr[0].any() and arr[-1].any() and arr[:,0].any() and arr[:,-1].any() and (~arr)[0].any() and (~arr)[-1].any() and (~arr)[:,0].any() and (~arr)[:,-1].any()
for n in [7,8,9,10]:
  for start in range(4):
    for gap in range(4):
      m=spiral_variant(n,start_dir=start,gap_side=gap)
      if ok(m):
        print('found',n,start,gap)
        print('\\n'.join(''.join('1' if x else '0' for x in row) for row in m)); raise SystemExit
print('none')
