import random, numpy as np, math, time, sys
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1
                st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def touch(mask):
    return [mask[0].any(), mask[-1].any(), mask[:,0].any(), mask[:,-1].any()]

def score(m):
    ta,tb=touch(m),touch(~m)
    return 500*(comps(m)-1)+500*(comps(~m)-1)+120*(4-sum(ta))+120*(4-sum(tb))

h=w=10
best=None; best_score=10**9
start_time=time.time()
for restart in range(200):
    m=np.zeros((h,w),dtype=bool)
    split=random.choice([4,5,6])
    m[:,:split]=1
    for _ in range(25):
        r,c=random.randrange(h),random.randrange(w)
        m[r,c]=~m[r,c]
    cur=score(m)
    T=8.0
    for step in range(300000):
        if cur==0:
            print('FOUND',restart,step,time.time()-start_time)
            print('\\n'.join(''.join('1' if x else '0' for x in row) for row in m))
            sys.exit(0)
        r,c=random.randrange(h),random.randrange(w)
        m[r,c]=~m[r,c]
        ns=score(m)
        if ns<=cur or random.random()<math.exp((cur-ns)/max(T,1e-9)):
            cur=ns
            if cur<best_score:
                best_score=cur; best=m.copy()
                print('best',best_score,'restart',restart,'step',step,'touch',touch(best),touch(~best),'comp',comps(best),comps(~best), 'time', round(time.time()-start_time,1))
                print('\\n'.join(''.join('1' if x else '0' for x in row) for row in best)); print(); sys.stdout.flush()
        else:
            m[r,c]=~m[r,c]
        T*=0.99998
print('DONE best',best_score)
if best is not None:
    print('\\n'.join(''.join('1' if x else '0' for x in row) for row in best))
