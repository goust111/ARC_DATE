from z3 import *

def find(h,w):
    N=h*w
    boundary=[(0,c) for c in range(w)]+[(h-1,c) for c in range(w)]+[(r,0) for r in range(1,h-1)]+[(r,w-1) for r in range(1,h-1)]
    cells=[(r,c) for r in range(h) for c in range(w)]
    def neigh(r,c):
        return [(nr,nc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0 <= (nr:=r+dr) < h and 0 <= (nc:=c+dc) < w]
    for rootA in boundary:
        for rootB in boundary:
            if rootA==rootB: continue
            x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
            oa=[[Int(f'oa_{r}_{c}') for c in range(w)] for r in range(h)]
            ob=[[Int(f'ob_{r}_{c}') for c in range(w)] for r in range(h)]
            s=Solver(); s.set(timeout=2000)
            area=Sum([If(x[r][c],1,0) for r,c in cells])
            s.add(area>=N//3, area<=2*N//3)
            for lits in ([x[0][c] for c in range(w)], [x[h-1][c] for c in range(w)], [x[r][0] for r in range(h)], [x[r][w-1] for r in range(h)]):
                s.add(Or(lits)); s.add(Or([Not(v) for v in lits]))
            s.add(x[rootA[0]][rootA[1]])
            s.add(Not(x[rootB[0]][rootB[1]]))
            s.add(oa[rootA[0]][rootA[1]]==1)
            s.add(ob[rootB[0]][rootB[1]]==1)
            for r,c in cells:
                s.add(If(x[r][c], And(oa[r][c]>=1, oa[r][c]<=N), oa[r][c]==0))
                s.add(If(Not(x[r][c]), And(ob[r][c]>=1, ob[r][c]<=N), ob[r][c]==0))
            for r,c in cells:
                pa=[And(x[nr][nc], oa[nr][nc] < oa[r][c]) for nr,nc in neigh(r,c)]
                pb=[And(Not(x[nr][nc]), ob[nr][nc] < ob[r][c]) for nr,nc in neigh(r,c)]
                if (r,c)"'!=rootA:
                    s.add(Implies(x[r][c], Or(pa)))
                if (r,c)!=rootB:
                    s.add(Implies(Not(x[r][c]), Or(pb)))
            res=s.check()
            if res==sat:
                m=s.model()
                arr=[[1 if is_true(m[x[r][c]]) else 0 for c in range(w)] for r in range(h)]
                print('"'sat roots',rootA,rootB)
                print('\\n'.join(''.join(str(v) for v in row) for row in arr))
                return
    print('none')

