    n=5000
    for _ in range(n):
        m=rand_growth(*dims)
        if m.all() or (~m).all():
            continue
        if comp(m)==1 and comp(~m)==1 and touches_all(m) and touches_all(~m):
            ok+=1
    print(dims, ok/n)
