                            arr=arr1.copy()
                            for p in add: arr[p]=1
                            if ok(arr):
                                print('found',left,add_right,'rem',rem,'add',add)
                                print('\\n'.join(''.join('1' if x else '0' for x in row) for row in arr)); raise SystemExit
print('none')
