    return comps

def touches_all(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def grow2(h,w):
    area=h*w
    target=random.randint(max(4,area//3), min(area-4, 2*area//3))
    remain={0:target-1,1:area-target-1}
    lab=-np.ones((h,w),int)
    seeds=[]
    while len(seeds)<2:
        p=(random.randrange(h),random.randrange(w))
        if p not in seeds:
            seeds.append(p)
    for i,p in enumerate(seeds):
        lab[p]=i
    front={0:set(),1:set()}
    def addf(i,r,c):
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and lab[nr,nc]<0:
                front[i].add((nr,nc))
    for i,(r,c) in enumerate(seeds): addf(i,r,c)
    while (lab<0).any():
        choices=[i for i in (0,1) if remain[i]>0 and front[i]]
        if not choices:
            return None
        weights=[remain[i] for i in choices]
        i=random.choices(choices,weights=weights)[0]
        cell=random.choice(tuple(front[i]))
        front[i].remove(cell)
        if lab[cell]>=0: continue
        lab[cell]=i
        remain[i]-=1
        addf(i,*cell)
    return lab==0

for dims in [(4,4),(5,5),(6,6),(4,6),(5,7)]:
    ok=0
    n=5000
    for _ in range(n):
        m=grow2(*dims)
        if m is None: continue
        if comps(m)==1 and comps(~m)==1 and touches_all(m) and touches_all(~m): ok+=1
    print(dims, ok/n)
