rows=['11111111','11101111','11000011','11100001','10000011','11001001','10001000','11111110']
base=np.array([[ch=='1' for ch in row] for row in rows],dtype=bool)

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); k=0
