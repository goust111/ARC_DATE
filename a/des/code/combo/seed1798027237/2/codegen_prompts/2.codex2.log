import itertools, numpy as np
rows=['1111000000','1001100000','1011111000','1001111000','1100001100','1101101100','1111000100','1101000000','1100000100','1111111100']
base=np.array([[ch=='1' for ch in row] for row in rows],dtype=bool)

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); k=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                k+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    x,y=st.pop()
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; st.append((nx,ny))
    return k

def ok(arr):
    return comps(arr)==1 and comps(~arr)==1 and arr[0].any() and arr[-1].any() and arr[:,0].any() and arr[:,-1].any() and (~arr)[0].any() and (~arr)[-1].any() and (~arr)[:,0].any() and (~arr)[:,-1].any()
left_candidates=[(r,0) for r in range(10) if base[r,0] and any((0<=r+dr<10 and 0<=0+dc<10 and not base[r+dr,0+dc]) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)))]
right_candidates=[(r,c) for r in range(10) for c in range(7,10) if not base[r,c]]
# Also allow removing a few 1s / adding a few 1s in local vicinity.
extra_remove=[(r,c) for r in range(10) for c in range(10) if base[r,c] and (c<=1 or c>=7)]
extra_add=[(r,c) for r in range(10) for c in range(10) if not base[r,c] and (c<=2 or c>=6)]
print('left',left_candidates)
for left in left_candidates:
    for add_right_count in range(1,4):
        for add_right in itertools.combinations(right_candidates, add_right_count):
            arr0=base.copy(); arr0[left]=0
            for p in add_right: arr0[p]=1
            if ok(arr0):
                print('direct',left,add_right)
                print('\\n'.join(''.join('1' if x else '0' for x in row) for row in arr0)); raise SystemExit
            for rem_count in range(0,3):
                for rem in itertools.combinations([p for p in extra_remove if arr0[p]], rem_count):
                    arr1=arr0.copy()
                    for p in rem: arr1[p]=0
                    for add_count in range(0,3):
