+    for region in _extract_regions(g):
+        group_size = int(region["gap_count"])
+        if group_size <= 0:
+            continue
+
+        r0, c0, r1, c1 = region["bbox"]
+        color = int(region["color"])
+        markers = list(region["markers"])
+        groups = _chunk_points(markers, group_size)
