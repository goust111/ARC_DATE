+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+FRAME_COLORS = [1, 2, 3, 5, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
