+    (rr0, rr1), (cc0, cc1) = _find_cross_bands(g)
+    ul = g[:rr0, :cc0]
+    ur = g[:rr0, cc1 + 1 :]
+    ll = g[rr1 + 1 :, :cc0]
+    lr = g[rr1 + 1 :, cc1 + 1 :]
