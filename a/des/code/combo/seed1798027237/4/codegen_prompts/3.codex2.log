+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+PIECE_COLORS = (1, 2, 3, 4, 6, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
