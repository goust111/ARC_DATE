+    used = set()
+    for piece in pieces:
+        assert piece["sig"] in hole_by_sig, "every piece must match a hole after rotation"
+        hole = hole_by_sig[piece["sig"]]
+        key = (hole["r0"], hole["c0"])
+        assert key not in used, "each hole must be filled exactly once"
+        used.add(key)
