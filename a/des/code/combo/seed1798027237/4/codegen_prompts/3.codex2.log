+    pieces = []
+    pieces.extend(_piece_records(ur, 3))
+    pieces.extend(_piece_records(ll, 1))
+    pieces.extend(_piece_records(lr, 2))
+    assert len(pieces) == len(holes), "piece count must equal hole count"
