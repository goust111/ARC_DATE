+BG = 0
+COLORS = tuple(range(1, 10))
+GRID_MIN = 16
+GRID_MAX = 24
+MIN_SIDE = 5
+MAX_SIDE = 12
+MIN_RECTS = 3
+MAX_RECTS = 5
+GEN_RETRIES = 200
+CHAIN_CASE_RETRIES = 25
+SHIFT_RETRIES = 30
+SHIFT_CHOICES = (-3, -2, -1, 0, 1, 2, 3)
