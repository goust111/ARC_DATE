+
+def _overlap_graph_connected(bboxes: dict[int, BBox]) -> bool:
+    colors = list(bboxes)
+    if not colors:
+        return False
+
+    seen = {colors[0]}
+    stack = [colors[0]]
+    while stack:
+        color = stack.pop()
+        for other in colors:
+            if other in seen:
+                continue
+            if _overlap_box(bboxes[color], bboxes[other]) is None:
+                continue
+            seen.add(other)
+            stack.append(other)
+    return len(seen) == len(colors)
