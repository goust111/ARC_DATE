+def _bbox_of_color(grid: np.ndarray, color: int) -> BBox:
+    coords = np.argwhere(grid == int(color))
+    assert coords.size > 0
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return (
+        int(rows.min()),
+        int(cols.min()),
+        int(rows.max()),
+        int(cols.max()),
+    )
