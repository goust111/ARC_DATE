+BBox = tuple[int, int, int, int]
+
+
+def _bbox_height(box: BBox) -> int:
+    return int(box[2] - box[0] + 1)
+
+
+def _bbox_width(box: BBox) -> int:
+    return int(box[3] - box[1] + 1)
+
