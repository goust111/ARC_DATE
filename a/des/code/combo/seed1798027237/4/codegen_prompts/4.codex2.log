+def _paint_seed(labels: np.ndarray, colors: list[int]) -> np.ndarray:
+    h, w = labels.shape
+    seed = np.full((h, w), BG, dtype=int)
+    for idx, color in enumerate(colors):
+        seed[labels == idx] = color
+    return seed
