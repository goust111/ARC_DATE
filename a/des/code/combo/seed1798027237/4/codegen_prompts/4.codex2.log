+
+    seed_left = left_margin
+    canvas_left = seed_left + seed_outer_w + gap
+    grid_h = max(seed_top + seed_outer_h, canvas_top + canvas_outer_h) + bottom_margin
+    grid_w = canvas_left + canvas_outer_w + right_margin
