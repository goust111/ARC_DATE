+    seed = min(seed_candidates, key=lambda f: (int(f["bbox"][1]), int(f["inner_area"])))
+    canvas = max(canvas_candidates, key=lambda f: (int(f["bbox"][1]), int(f["inner_area"])))
+    return seed, canvas
