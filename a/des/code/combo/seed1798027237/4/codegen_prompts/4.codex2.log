+
+def _ordered_colors_by_area(seed_inner: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    counts: Counter[int] = Counter()
+    first_pos: dict[int, tuple[int, int]] = {}
+    h, w = seed_inner.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(seed_inner[r, c])
