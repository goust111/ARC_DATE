+    out = g.copy()
+    start = canvas_r0 + 1
+    for (color, _count), stripe_h in zip(ordered, heights):
+        if stripe_h > 0:
+            out[start : start + stripe_h, canvas_c0 + 1 : canvas_c1] = color
