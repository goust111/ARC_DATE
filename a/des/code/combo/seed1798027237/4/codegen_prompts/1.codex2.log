+
+def _paste_non_bg(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = patch.shape
+    assert 0 <= r0 and 0 <= c0 and r0 + h <= out.shape[0] and c0 + w <= out.shape[1]
+    mask = patch != int(bg)
+    view = out[r0 : r0 + h, c0 : c0 + w]
+    view[mask] = patch[mask]
