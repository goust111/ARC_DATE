+
+def _find_components(
+    grid: np.ndarray, excluded: set[int]
+) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((int(nr), int(nc)))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _contiguous_run(indices: np.ndarray) -> tuple[int, int]:
+    assert indices.size > 0
+    start = int(indices[0])
+    end = int(indices[-1])
+    assert np.array_equal(indices, np.arange(start, end + 1))
+    return start, end
+
+
+def _edge_gap(
+    line: np.ndarray, frame_color: int, offset: int
+) -> tuple[int, int]:
+    missing = np.where(line != int(frame_color))[0]
+    start, end = _contiguous_run(missing)
