+        stamp["patch"] = patch
+        stamp["height"] = size
+        stamp["width"] = size
+        r0, c0 = _moved_stamp_position(side, stamp, frame_bbox, gaps)
+        box = (r0, c0, r0 + size - 1, c0 + size - 1)
+        if not (0 <= box[0] and 0 <= box[1] and box[2] < height and box[3] < width):
