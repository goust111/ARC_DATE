+def _moved_stamp_position(
+    side: str,
+    stamp: dict[str, object],
+    frame_bbox: tuple[int, int, int, int],
+    gaps: dict[str, tuple[int, int]],
+) -> tuple[int, int]:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    gap_start, _gap_end = gaps[side]
+    notch_start = int(stamp["notch_start"])
+    h = int(stamp["height"])
+    w = int(stamp["width"])
