+        "tr": (0, fr0 - 1, fc1 + 1, width - 1),
+        "bl": (fr1 + 1, height - 1, 0, fc0 - 1),
+        "br": (fr1 + 1, height - 1, fc1 + 1, width - 1),
+    }
+    corners = list(corner_regions.keys())
