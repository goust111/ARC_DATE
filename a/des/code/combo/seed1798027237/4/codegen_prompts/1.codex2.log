+        "top": int(r0 - fr0),
+        "bottom": int(fr1 - r1),
+        "left": int(c0 - fc0),
+        "right": int(fc1 - c1),
+    }
+    ordered = sorted(dists.items(), key=lambda item: (item[1], item[0]))
+    assert ordered[0][1] < ordered[1][1]
