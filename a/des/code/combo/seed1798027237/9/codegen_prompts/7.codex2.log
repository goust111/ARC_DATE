+def _border_color(grid: np.ndarray) -> int:
+    top = grid[0, :]
+    bottom = grid[-1, :]
+    left = grid[1:-1, 0]
+    right = grid[1:-1, -1]
+    border = np.concatenate([top, bottom, left, right])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[int(np.argmax(cnts))])
