+# --------------- generator ---------------
+
+BACKGROUND_COLOR = 0
+TEMPLATE_COLOR = 5
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_HEIGHT_RANGE = (18, 28)
+GRID_WIDTH_RANGE = (18, 28)
+TEMPLATE_HEIGHT_MAX = 18
+TEMPLATE_WIDTH_MAX = 18
+TEMPLATE_MIN_SIDE = 10
+HOLE_COUNT_RANGE = (2, 4)
+HOLE_AREA_RANGE = (4, 9)
