+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
