+    r1, c1 = arr.max(axis=0)
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[arr[:, 0] - r0, arr[:, 1] - c0] = True
+    return mask, (int(r0), int(c0), int(r1), int(c1))
+
+
+def _internal_voids(mask: np.ndarray) -> list[list[tuple[int, int]]]:
