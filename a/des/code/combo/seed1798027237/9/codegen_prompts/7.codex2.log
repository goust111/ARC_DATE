+        coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+        mask = _coords_to_mask(coords)[0]
+        if mask.shape[0] < 2 or mask.shape[1] < 2:
+            continue
+        if bool(np.all(mask)):
