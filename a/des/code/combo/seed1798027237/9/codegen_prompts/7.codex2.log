+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = rr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
+    return out
+
