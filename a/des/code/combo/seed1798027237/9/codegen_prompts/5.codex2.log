+            continue
+        if want_hole:
+            mask = _carve_single_hole(mask)
+            if mask is None:
+                continue
+        transformed = _random_transform(mask)
+        if want_hole:
+            holes = _hole_regions(transformed)
+            if len(holes) != 1 or len(holes[0]) != 1:
+                continue
+        else:
