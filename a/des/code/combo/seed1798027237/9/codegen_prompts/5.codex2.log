+
+def _make_shape(want_hole: bool) -> np.ndarray | None:
+    min_side = 4 if want_hole else SHAPE_SIDE_MIN
+    for _ in range(200):
+        box_h = random.randint(min_side, SHAPE_SIDE_MAX)
