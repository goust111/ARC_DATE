+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(int(cr), int(cc), h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            comps.append(pts)
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    start = tuple(int(x) for x in pts[0])
+    h, w = mask.shape
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if bool(mask[nr, nc]) and (nr, nc) not in seen:
+                seen.add((int(nr), int(nc)))
+                q.append((int(nr), int(nc)))
+    return len(seen) == int(mask.sum())
+
+
+def _tight_mask(points: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    r0 = min(rs)
+    r1 = max(rs)
+    c0 = min(cs)
+    c1 = max(cs)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    return mask, (int(r0), int(c0), int(r1), int(c1))
