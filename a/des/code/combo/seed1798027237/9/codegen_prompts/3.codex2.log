+            continue
+        a = room_label_to_id[left_label]
+        b = room_label_to_id[right_label]
+        if a == b:
+            continue
+        key = (min(a, b), max(a, b))
+        if key in seen_pairs:
+            continue
+        seen_pairs.add(key)
+        adjacency[a].append((b, flip))
+        adjacency[b].append((a, flip))
