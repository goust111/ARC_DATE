+    pr0, pc0 = map(int, pattern_coords.min(axis=0))
+    pr1, pc1 = map(int, pattern_coords.max(axis=0))
+    pattern = np.array(g[pr0 : pr1 + 1, pc0 : pc1 + 1], copy=True)
