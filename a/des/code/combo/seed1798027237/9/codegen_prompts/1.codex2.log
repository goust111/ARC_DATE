+        success = False
+        for _ in range(PLACEMENT_TRIES):
+            top = random.randint(min_r, max_r)
+            left = random.randint(min_c, max_c)
+            rect = _reserved_rect(spec, top, left)
+            if any(_rects_overlap(rect, other) for other in reserved):
