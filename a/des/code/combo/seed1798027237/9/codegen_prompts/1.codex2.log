+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+CONTAINER_COUNT_RANGE = (1, 3)
+OUTER_H_RANGE = (6, 11)
+OUTER_W_RANGE = (6, 11)
+MAX_FRAGMENTS_PER_DIRECTION = 3
+MAX_TOTAL_FRAGMENTS = len(FRAGMENT_COLORS)
+PLACEMENT_TRIES = 200
+COUNT_TRIES = 80
+CELL_TRIES = 150
+GEN_RETRIES = 400
+SEPARATION = 1
