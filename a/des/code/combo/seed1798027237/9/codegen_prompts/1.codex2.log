+        gaps = {
+            "up": left + int(spec["gaps"]["up"]),
+            "right": top + int(spec["gaps"]["right"]),
+            "down": left + int(spec["gaps"]["down"]),
+            "left": top + int(spec["gaps"]["left"]),
