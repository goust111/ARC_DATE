+    patch[0, :] = FRAME
+    patch[-1, :] = FRAME
+    patch[:, 0] = FRAME
+    patch[:, -1] = FRAME
+
+    gaps = {
+        "up": random.randint(1, w - 2),
+        "right": random.randint(1, h - 2),
+        "down": random.randint(1, w - 2),
+        "left": random.randint(1, h - 2),
