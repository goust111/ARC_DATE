+
+def _build_route(
+    segment_lengths: list[int], gap_lengths: list[int]
+) -> tuple[list[list[tuple[int, int]]], list[tuple[tuple[int, int], tuple[int, int]]], list[tuple[int, int]], list[tuple[int, int]]] | None:
