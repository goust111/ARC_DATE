+def _gen_attempt() -> np.ndarray | None:
+    n_segments = random.randint(*SEGMENT_COUNT_RANGE)
+    segment_lengths = [random.randint(*SEGMENT_LENGTH_RANGE) for _ in range(n_segments)]
