+        start_ray.append(probe)
+
+    end_ray: list[tuple[int, int]] = []
+    ray_dir = directions[-1]
+    probe = segments[-1][-1]
+    for _ in range(segment_lengths[-1] - 2):
+        probe = _add_step(probe, ray_dir)
+        if not register(probe):
+            return None
+        end_ray.append(probe)
