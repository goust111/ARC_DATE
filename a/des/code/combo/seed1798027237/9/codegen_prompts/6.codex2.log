+def _clear_between(grid: np.ndarray, bg: int, a: tuple[int, int], b: tuple[int, int]) -> bool:
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        step = 1 if ac < bc else -1
+        for c in range(ac + step, bc, step):
+            if int(grid[ar, c]) != bg:
+                return False
+        return True
+    if ac == bc:
+        step = 1 if ar < br else -1
+        for r in range(ar + step, br, step):
+            if int(grid[r, ac]) != bg:
+                return False
+        return True
+    return False
