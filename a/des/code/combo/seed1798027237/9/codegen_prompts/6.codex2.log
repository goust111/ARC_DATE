+    directions = [random.choice(DIRS4)]
+    for _ in range(2 * n_segments - 2):
+        directions.append(_choose_next_direction(directions[-1]))
+
+    current = (0, 0)
+    occupied = {current}
+    segments: list[list[tuple[int, int]]] = []
+    connectors: list[tuple[tuple[int, int], tuple[int, int]]] = []
