+            cells.append(current)
+        segments.append(cells)
+
+        if idx == n_segments - 1:
+            continue
+
+        gap_dir = directions[2 * idx + 1]
+        start = current
+        for _ in range(gap_lengths[idx] + 1):
+            current = _add_step(current, gap_dir)
+            if not register(current):
