+
+def _choose_next_direction(prev: tuple[int, int]) -> tuple[int, int]:
+    candidates = [prev, _turn_left(prev), _turn_right(prev)]
+    weights = [2, 3, 3]
+    return random.choices(candidates, weights=weights, k=1)[0]
