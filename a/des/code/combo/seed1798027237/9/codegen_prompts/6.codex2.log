+    chosen = _choose_pairs(endpoints, len(segments), candidates)
+    matched = {idx for pair in chosen for idx in pair}
+
+    out = g.copy()
+    for a, b in chosen:
+        color = int(endpoints[a]["color"])
+        _draw_line(out, endpoints[a]["pos"], endpoints[b]["pos"], color)
