+        for idx, cell in enumerate((ordered[0], ordered[-1])):
+            endpoints.append(
+                {
+                    "segment": seg_id,
+                    "pos": cell,
+                    "color": int(grid[cell]),
+                    "outward": outward[idx],
+                }
+            )
+        segments.append(
+            {
+                "id": seg_id,
+                "cells": ordered,
+                "orientation": orientation,
+                "length": length,
+                "body_len": body_len,
+                "body_color": body_color,
+                "endpoints": endpoints,
+            }
