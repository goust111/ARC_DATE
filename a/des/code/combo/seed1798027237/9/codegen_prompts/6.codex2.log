+def _draw_line(out: np.ndarray, a: tuple[int, int], b: tuple[int, int], color: int) -> None:
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        c0, c1 = sorted((ac, bc))
+        out[ar, c0 : c1 + 1] = color
