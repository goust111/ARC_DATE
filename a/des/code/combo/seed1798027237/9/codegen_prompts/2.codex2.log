+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    (r0, c0), (r1, c1) = a, b
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        return [(r0, c) for c in range(lo, hi + 1)]
+    if c0 == c1:
+        lo, hi = sorted((r0, r1))
+        return [(r, c0) for r in range(lo, hi + 1)]
