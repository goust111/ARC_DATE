+                regions: list[dict] = []
+                ok = True
+
+                for r0, r1 in row_parts:
+                    for c0, c1 in col_parts:
+                        info = _analyze_block(g[r0:r1, c0:c1], seed_colors)
+                        if info is None or int(info["seed_color"]) in used:
+                            ok = False
+                            break
