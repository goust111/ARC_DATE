+
+            grid[r0:r1, c0:c1] = _render_stripes(row_size, col_size, bg_pair, orientation, phase)
+
+            case_name = random.choice(("row", "col", "bend", "bend", "tie"))
+            seeds_rel = _sample_seed_pair(row_size, col_size, case_name)
