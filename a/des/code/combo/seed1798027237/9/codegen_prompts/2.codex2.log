+
+    grid = np.zeros((h, w), dtype=int)
+    regions: list[dict] = []
+    row_starts = [0]
+    col_starts = [0]
+    for size in row_sizes[:-1]:
+        row_starts.append(row_starts[-1] + size)
+    for size in col_sizes[:-1]:
+        col_starts.append(col_starts[-1] + size)
+
