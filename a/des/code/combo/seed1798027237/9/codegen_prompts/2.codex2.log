+            return sorted([(r0, c0), (r1, c1)])
+        return None
+
+    for _ in range(100):
+        a = (random.randrange(height), random.randrange(width))
+        b = (random.randrange(height), random.randrange(width))
+        if a == b or a[0] == b[0] or a[1] == b[1]:
