+
+def _gen_attempt() -> np.ndarray | None:
+    region_count = random.choice((2, 3, 4, 6))
+    nr, nc = _layout_for_region_count(region_count)
+    row_sizes = _sample_sizes(nr)
+    col_sizes = _sample_sizes(nc)
