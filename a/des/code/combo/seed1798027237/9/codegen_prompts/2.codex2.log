+    present_seed_colors = [color for color in seed_colors if np.any(block == color)]
+    if len(present_seed_colors) != 1:
+        return None
+
+    seed_color = int(present_seed_colors[0])
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(block == seed_color)]
+    if len(coords) != 2:
