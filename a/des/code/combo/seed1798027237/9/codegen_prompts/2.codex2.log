+    seed_colors = set(seeds)
+    region_count = len(seeds)
+    layouts = LAYOUTS_BY_REGION_COUNT.get(region_count, ())
+    candidates: dict[tuple, tuple[tuple[int, int, int], list[dict]]] = {}
+
+    for nr, nc in layouts:
