+
+            regions.append(
+                {
+                    "r0": int(r0),
+                    "r1": int(r1),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "seed_color": seed_color,
+                    "orientation": orientation,
+                    "seeds": sorted(seeds_abs),
+                }
+            )
+            region_index += 1
+
+    counts = _color_counts(grid)
