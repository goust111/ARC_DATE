+                        used.add(int(info["seed_color"]))
+                        seeds_abs = [(r0 + rr, c0 + cc) for rr, cc in info["seeds_rel"]]
+                        regions.append(
+                            {
+                                "r0": int(r0),
+                                "r1": int(r1),
+                                "c0": int(c0),
+                                "c1": int(c1),
+                                "seed_color": int(info["seed_color"]),
+                                "orientation": str(info["orientation"]),
+                                "seeds": sorted(seeds_abs),
