+
+    chosen_idx = rng.choice(len(PAIR_OPTIONS), size=group_count, replace=False)
+    pairs = [PAIR_OPTIONS[int(i)] for i in chosen_idx.tolist()]
+    rng.shuffle(pairs)
+
+    grid = np.zeros((height, width), dtype=int)
