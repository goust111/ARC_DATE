+
+        rows = [r for r, _c in cells]
+        cols = [c for _r, c in cells]
+        if min(rows) == r0 and max(rows) == r1 and min(cols) == c0 and max(cols) == c1:
+            return cells
+
+    return None
+
+
+def _sample_bboxes(
+    height: int,
+    width: int,
+    group_count: int,
+    overlap_mode: bool,
+    rng: np.random.Generator,
+) -> list[tuple[int, int, int, int]] | None:
