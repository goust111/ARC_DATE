+
+
+def _add_green_markers(
+    grid: np.ndarray,
+    passable_rooms: set[tuple[int, int]],
+    boxes: dict[tuple[int, int], tuple[int, int, int, int]],
+    rng: random.Random,
+) -> None:
+    for room in passable_rooms:
