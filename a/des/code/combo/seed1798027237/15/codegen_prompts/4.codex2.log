+def _monotone_path(
+    start: tuple[int, int], goal: tuple[int, int], rng: random.Random
+) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = goal
+    steps = []
+    dr = 1 if r1 >= r0 else -1
+    dc = 1 if c1 >= c0 else -1
+    steps.extend([(dr, 0)] * abs(r1 - r0))
+    steps.extend([(0, dc)] * abs(c1 - c0))
+    rng.shuffle(steps)
+
+    path = [start]
+    cur_r, cur_c = r0, c0
+    for step_r, step_c in steps:
+        cur_r += step_r
+        cur_c += step_c
+        path.append((cur_r, cur_c))
+    return path
+
