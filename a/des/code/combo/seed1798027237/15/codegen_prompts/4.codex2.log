+
+def _pair_key(a, b):
+    return (a, b) if a <= b else (b, a)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _analyze_maze(
+    grid: np.ndarray,
+) -> tuple[
+    list[list[tuple[int, int]]],
+    np.ndarray,
+    list[bool],
+    list[set[int]],
+    dict[tuple[int, int], tuple[int, int]],
+    list[tuple[tuple[int, int], int]],
+]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    room_mask = (g != WALL) & (g != DOOR)
+    rooms = _components(room_mask)
+    room_of = np.full((h, w), -1, dtype=int)
+    passable: list[bool] = []
+
+    for room_id, cells in enumerate(rooms):
+        has_green = False
+        for r, c in cells:
+            room_of[r, c] = room_id
+            if int(g[r, c]) == GREEN:
+                has_green = True
+        passable.append(has_green)
+
+    edge_to_door: dict[tuple[int, int], tuple[int, int]] = {}
+    border_doors: list[tuple[tuple[int, int], int]] = []
+    for r, c in np.argwhere(g == DOOR):
+        rr, cc = int(r), int(c)
+        room_ids = sorted(
+            {
+                int(room_of[nr, nc])
+                for dr, dc in DIRS4
+                for nr, nc in [(rr + dr, cc + dc)]
+                if 0 <= nr < h and 0 <= nc < w and int(room_of[nr, nc]) >= 0
+            }
+        )
+        if len(room_ids) == 2:
+            edge_to_door[_pair_key(room_ids[0], room_ids[1])] = (rr, cc)
+        elif len(room_ids) == 1 and (rr in (0, h - 1) or cc in (0, w - 1)):
+            border_doors.append(((rr, cc), room_ids[0]))
