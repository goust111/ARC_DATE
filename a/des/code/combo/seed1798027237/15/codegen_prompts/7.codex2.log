+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_mask_components(mask)) == 1
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    open_bg = ~mask
+    padded = np.pad(open_bg, 1, constant_values=True)
+    seen = np.zeros_like(padded, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    ph, pw = padded.shape
+    for r in range(ph):
+        for c in (0, pw - 1):
+            if padded[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(pw):
+        for r in (0, ph - 1):
+            if padded[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
