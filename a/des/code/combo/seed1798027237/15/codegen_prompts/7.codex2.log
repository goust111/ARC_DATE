+        out[ir0 : ir1 + 1, ic0 : ic1 + 1][scaled] = int(obj["color"])
+    return out
+
+
+def _random_transform(mask: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = np.rot90(mask, int(rng.integers(0, 4)))
+    if bool(rng.integers(0, 2)):
+        out = np.fliplr(out)
+    if bool(rng.integers(0, 2)):
