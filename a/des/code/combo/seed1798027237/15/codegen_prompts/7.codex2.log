+    grid[frame_r0 : frame_r1 + 1, frame_c1] = FRAME
+    grid[frame_r0, frame_c0 : frame_c1 + 1] = FRAME
+    grid[frame_r1, frame_c0 : frame_c1 + 1] = FRAME
+
+    assert frame_r1 - frame_r0 + 1 == total_h - 1
+    assert frame_c1 - frame_c0 + 1 == total_w - marker_len
