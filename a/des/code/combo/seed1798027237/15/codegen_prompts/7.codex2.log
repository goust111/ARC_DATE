+
+def _draw_object(grid: np.ndarray, mask: np.ndarray, color: int, top: int, left: int) -> np.ndarray:
+    coords = np.argwhere(mask)
+    rows = top + coords[:, 0]
+    cols = left + coords[:, 1]
