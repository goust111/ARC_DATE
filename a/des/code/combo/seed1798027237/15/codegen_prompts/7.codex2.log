+
+def _find_marker_segments(grid: np.ndarray) -> dict[tuple[int, int], int]:
+    segments: dict[tuple[int, int], int] = {}
+    for comp in _mask_components(grid == MARKER):
+        r0, c0, r1, c1 = _bbox(comp)
