+        frames_data.append(
+            {
+                "marker_len": int(marker_len),
+                "interior_shape": interior_shape,
+                "size": (interior_shape[0] + 3, interior_shape[1] + 2 + int(marker_len)),
+            }
+        )
+    rng.shuffle(frames_data)
