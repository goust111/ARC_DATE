+    half_h = max(obj_zone_h, frame_zone_h) + int(rng.integers(1, 4))
+    sep_gap = int(rng.integers(2, 5))
+    usable_w = max(obj_zone_w, frame_zone_w) + int(rng.integers(2, 6))
