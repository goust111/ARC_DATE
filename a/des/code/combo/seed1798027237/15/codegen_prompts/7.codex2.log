+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BG = 8
+FRAME = 5
+MARKER = 9
+OBJECT_COLORS = (0, 1, 2, 3, 4, 6, 7)
+
+GEN_ATTEMPTS = 400
+GEN_OBJECT_ATTEMPTS = 200
+GEN_MAX_HEIGHT = 36
+GEN_MAX_WIDTH = 36
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_mask_components(mask)) == 1
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    open_bg = ~mask
+    padded = np.pad(open_bg, 1, constant_values=True)
+    seen = np.zeros_like(padded, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    ph, pw = padded.shape
+    for r in range(ph):
+        for c in (0, pw - 1):
+            if padded[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(pw):
+        for r in (0, ph - 1):
+            if padded[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = open_bg & ~seen[1 : h + 1, 1 : w + 1]
+    return len(_mask_components(holes))
+
+
+def _scale_mask(mask: np.ndarray, dst_h: int, dst_w: int) -> np.ndarray:
+    src_h, src_w = mask.shape
+    out = np.zeros((dst_h, dst_w), dtype=bool)
+    for sr in range(src_h):
+        r0 = (sr * dst_h) // src_h
+        r1 = ((sr + 1) * dst_h + src_h - 1) // src_h
+        for sc in range(src_w):
+            if not mask[sr, sc]:
+                continue
+            c0 = (sc * dst_w) // src_w
+            c1 = ((sc + 1) * dst_w + src_w - 1) // src_w
+            out[r0:r1, c0:c1] = True
