+    out = g.copy()
+    used_lengths: set[int] = set()
+    for obj in objects:
+        coords = obj["coords"]
+        out[coords[:, 0], coords[:, 1]] = BG
+        hole_count = int(obj["holes"])
+        if hole_count == 0:
