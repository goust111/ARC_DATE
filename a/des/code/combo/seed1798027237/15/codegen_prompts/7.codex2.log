+import numpy as np
+
+
+BG = 8
+FRAME = 5
+MARKER = 9
+OBJECT_COLORS = (0, 1, 2, 3, 4, 6, 7)
+
+GEN_ATTEMPTS = 400
+GEN_OBJECT_ATTEMPTS = 200
+GEN_MAX_HEIGHT = 36
+GEN_MAX_WIDTH = 36
