+    rows = {r for r, _c in coords}
+    cols = {c for _r, c in coords}
+    if len(rows) == 1:
+        cols_sorted = sorted(cols)
+        return cols_sorted == list(range(cols_sorted[0], cols_sorted[-1] + 1))
+    if len(cols) == 1:
