+
+    pair_count = random.choices(PAIR_COUNT_CHOICES, weights=PAIR_COUNT_WEIGHTS, k=1)[0]
+    for _pair_idx in range(pair_count):
+        placed = False
+        for _ in range(PAIR_TRIES):
+            wall_len = random.randint(*WALL_LEN_RANGE)
