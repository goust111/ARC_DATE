+                grid[r, c] = WALL
+            for r, c, color in blueprint["towers"]:
+                grid[r, c] = color
+            reserved |= inflated
+            placed = True
+            break
+        if not placed:
+            return None
+
+    for _ in range(random.randint(*EXTRA_WALL_COUNT_RANGE)):
+        extra = _add_extra_wall(grid, reserved)
+        if extra is None:
