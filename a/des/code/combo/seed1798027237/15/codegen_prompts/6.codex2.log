+        for _ in range(PAIR_TRIES):
+            wall_len = random.randint(*WALL_LEN_RANGE)
+            h_color, v_color = random.sample([RED, BLUE], 2)
+            outcome = random.choice(["red", "blue", "equal"])
+            dh, dv = random.choice(_distance_pairs(outcome, h_color, v_color))
