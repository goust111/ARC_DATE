+        if not run_cols:
+            continue
+
+        upper_colors = [int(g[top_row, c]) for c in run_cols]
+        lower_colors = [int(g[bottom_row, c]) for c in run_cols]
+        if len(set(upper_colors)) != len(upper_colors):
+            continue
+        if len(set(lower_colors)) != len(lower_colors):
+            continue
