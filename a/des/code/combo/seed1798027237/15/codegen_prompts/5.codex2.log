+
+def _best_axis(coords: set[tuple[int, int]]) -> tuple[dict, int]:
+    candidates = _axis_candidates(coords)
+    best = max(candidates, key=lambda item: item["score"])
+    ties = sum(1 for item in candidates if item["score"] == best["score"])
+    return best, ties
