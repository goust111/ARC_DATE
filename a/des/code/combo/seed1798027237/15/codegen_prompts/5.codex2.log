+
+        extras = [0] * height
+        extra_rows = random.sample(range(height), random.randint(1, max(1, height // 2)))
+        for row in extra_rows:
+            extras[row] = random.randint(1, 2)
+
+        coords: set[tuple[int, int]] = set()
