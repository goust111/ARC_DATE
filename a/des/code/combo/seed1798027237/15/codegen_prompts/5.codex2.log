+def _find_monochrome_components(grid: np.ndarray, ignore: np.ndarray | None = None) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if ignore is None:
+        ignore = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or ignore[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = [(r, c)]
+            coords = []
+            while queue:
+                rr, cc = queue.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or ignore[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": set(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _mirror(coord: tuple[int, int], orient: str, axis: int) -> tuple[int, int]:
+    r, c = coord
+    if orient == "v":
+        return (r, 2 * axis - c)
+    return (2 * axis - r, c)
+
+
+def _side(coord: tuple[int, int], orient: str, axis: int) -> int:
+    r, c = coord
+    value = c if orient == "v" else r
+    if value < axis:
+        return -1
+    if value > axis:
+        return 1
+    return 0
+
+
+def _axis_candidates(coords: set[tuple[int, int]]) -> list[dict]:
+    arr = np.array(sorted(coords), dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    out: list[dict] = []
+
+    for orient, axes in (("v", range(c0, c1 + 1)), ("h", range(r0, r1 + 1))):
+        for axis in axes:
+            matched = 0
+            neg_only = 0
+            pos_only = 0
+            for coord in coords:
+                side = _side(coord, orient, axis)
+                if _mirror(coord, orient, axis) in coords:
+                    matched += 1
+                elif side < 0:
+                    neg_only += 1
+                elif side > 0:
