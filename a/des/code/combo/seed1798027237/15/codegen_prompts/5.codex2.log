+    cols = [c for _, c in coords]
+    h = max(rows) - min(rows) + 1
+    w = max(cols) - min(cols) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[r - min(rows), c - min(cols)] = True
