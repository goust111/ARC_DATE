+    return None
+
+
+def _legend_positions(h: int, w: int, count: int, corner: str) -> list[tuple[int, int, int]]:
+    if corner == "tl":
+        cols = list(range(count))
+        return [(0, 1, c) for c in cols]
+    if corner == "tr":
+        cols = list(range(w - count, w))
+        return [(0, 1, c) for c in cols]
+    if corner == "bl":
