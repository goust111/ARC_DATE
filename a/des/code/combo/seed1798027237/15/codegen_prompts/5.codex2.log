+    max_h = max(obj["mask"].shape[0] for obj in objects)
+    max_w = max(obj["mask"].shape[1] for obj in objects)
+    min_h = max(18, max_h + 8, (2 * max_h + 7) if count >= 3 else 0)
+    min_w = max(18, max_w + 8, (2 * max_w + 7) if count >= 3 else 0, count + 6)
