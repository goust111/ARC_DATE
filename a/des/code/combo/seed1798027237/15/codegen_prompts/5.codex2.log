+    candidates = []
+    corner_specs = [
+        (0, 1, list(range(w))),
+        (0, 1, list(range(w - 1, -1, -1))),
+        (h - 2, h - 1, list(range(w))),
+        (h - 2, h - 1, list(range(w - 1, -1, -1))),
+    ]
+
+    for top_row, bottom_row, scan_cols in corner_specs:
+        run_cols = []
+        for c in scan_cols:
+            upper = int(g[top_row, c])
+            lower = int(g[bottom_row, c])
+            if upper != BG and lower != BG:
+                run_cols.append(c)
+            else:
