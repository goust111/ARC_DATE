+def _transformed_cells(spec: RectSpec, grid_h: int, grid_w: int) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    counts = [0, 0]
+    if spec.orientation == "H":
+        shift = spec.width
+        for dr in range(spec.split):
+            rr = spec.r0 + dr - shift
+            if not (0 <= rr < grid_h):
+                continue
+            for dc in range(spec.width):
+                cc = spec.c0 + dc
+                if 0 <= cc < grid_w:
+                    cells.append((rr, cc))
+                    counts[0] += 1
+        for dr in range(spec.split + 1, spec.height):
+            rr = spec.r0 + dr + shift
+            if not (0 <= rr < grid_h):
+                continue
+            for dc in range(spec.width):
+                cc = spec.c0 + dc
+                if 0 <= cc < grid_w:
+                    cells.append((rr, cc))
+                    counts[1] += 1
+    else:
+        shift = spec.height
+        for dc in range(spec.split):
+            cc = spec.c0 + dc - shift
+            if not (0 <= cc < grid_w):
+                continue
+            for dr in range(spec.height):
+                rr = spec.r0 + dr
+                if 0 <= rr < grid_h:
+                    cells.append((rr, cc))
+                    counts[0] += 1
+        for dc in range(spec.split + 1, spec.width):
+            cc = spec.c0 + dc + shift
+            if not (0 <= cc < grid_w):
+                continue
+            for dr in range(spec.height):
+                rr = spec.r0 + dr
+                if 0 <= rr < grid_h:
