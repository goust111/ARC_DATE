+            rr1 = mask.shape[0] + min(0, dr)
+            cc0 = max(0, dc)
+            cc1 = mask.shape[1] + min(0, dc)
+            out[rr0:rr1, cc0:cc1] |= mask[rr0 - dr:rr1 - dr, cc0 - dc:cc1 - dc]
+    return out
