+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIRS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0, c0 in np.argwhere(mask):
+        r0 = int(r0)
+        c0 = int(c0)
+        if seen[r0, c0]:
+            continue
+        seen[r0, c0] = True
+        q = deque([(r0, c0)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for rr, cc in _neighbors4(r, c, h, w):
+                if mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+        comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _enclosed_background(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if bg[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    return bg & ~seen
+
+
+def _palette_legend(grid: np.ndarray) -> tuple[dict[int, int], np.ndarray]:
+    grey_mask = grid == GREY
+    comps = _components(grey_mask)
+    h, w = grid.shape
+    candidates: list[tuple[int, dict[int, int], np.ndarray]] = []
+
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        bh = r1 - r0 + 1
+        bw = c1 - c0 + 1
+        if r0 != 0 or c1 != w - 1 or bw != 5 or bh < 3 or bh % 2 == 0:
+            continue
+
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        expected_grey = np.fromfunction(
+            lambda rr, cc: (rr % 2 == 0) | (cc % 2 == 0),
+            (bh, bw),
+            dtype=int,
+        ).astype(bool)
+        if not np.array_equal(sub == GREY, expected_grey):
+            continue
+
+        mapping: dict[int, int] = {}
+        ok = True
+        for rr in range(1, bh, 2):
+            src = int(sub[rr, 1])
+            fill = int(sub[rr, 3])
+            if src in (BG, GREY) or fill in (BG, GREY) or src == fill or src in mapping:
+                ok = False
+                break
+            mapping[src] = fill
+        if not ok or not mapping:
+            continue
