+
+def _find_gap(mask: np.ndarray) -> tuple[tuple[int, int], tuple[int, int]]:
+    h, w = mask.shape
+    candidates: list[tuple[tuple[int, int], tuple[int, int], int]] = []
+    for r in range(1, h - 1):
