+
+
+def _carve_notch(filled: np.ndarray, side: str) -> None:
+    h, w = filled.shape
+    if side in ("top", "bottom"):
+        notch_w = random.randint(1, w - 4)
+        start = random.randint(2, w - notch_w - 2)
+        depth = random.randint(1, h - 4)
+        if side == "top":
+            filled[:depth, start : start + notch_w] = False
+        else:
