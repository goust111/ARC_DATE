+
+        opposite = {(-1, 0), (1, 0)} == set(neighbor_dirs) or {(0, -1), (0, 1)} == set(neighbor_dirs)
+        if not opposite:
+            continue
+
+        inside_dirs = []
+        for dr, dc in DIRS4:
+            rr = r + dr
+            cc = c + dc
