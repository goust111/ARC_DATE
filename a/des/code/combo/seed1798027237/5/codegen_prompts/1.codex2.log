+
+
+def _local_ray(gap: tuple[int, int], direction: tuple[int, int], length: int, h: int, w: int) -> list[tuple[int, int]]:
+    dr, dc = direction
+    rr, cc = gap
+    cells: list[tuple[int, int]] = []
+    for _ in range(length):
