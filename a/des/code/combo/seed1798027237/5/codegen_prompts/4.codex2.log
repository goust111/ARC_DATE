+                "id": obj_id,
+                "bbox": (r0, c0, r1, c1),
+                "color": color,
+                "pointer": (pr, pc),
+                "direction": direction,
+            }
+        )
+
+    colors = [int(obj["color"]) for obj in objects]
+    assert len(colors) == len(set(colors)), "input rectangle colors must be unique"
+    return objects, bg
+
