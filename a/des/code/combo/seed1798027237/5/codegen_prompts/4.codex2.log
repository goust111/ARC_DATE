+    out = np.full_like(g, bg)
+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]  # type: ignore[assignment]
+        out[r0 : r1 + 1, c0 : c1 + 1] = final_colors[int(obj["id"])]
+    return out
