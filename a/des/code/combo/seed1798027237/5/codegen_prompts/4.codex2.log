+        valids.append("up")
+    if not any(rr > r and cc == c for rr, cc in occupied):
+        valids.append("down")
+    if not any(rr == r and cc < c for rr, cc in occupied):
+        valids.append("left")
+    if not any(rr == r and cc > c for rr, cc in occupied):
+        valids.append("right")
+    return valids
