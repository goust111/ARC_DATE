+def _neighbors(pos: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    r, c = pos
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIR_TO_DELTA.values():
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < rows and 0 <= nc < cols:
+            out.append((nr, nc))
+    return out
+
