+        height, width = spec["shape"]  # type: ignore[assignment]
+        center_r = lr * step
+        center_c = lc * step
+        half_h = height // 2
+        half_w = width // 2
+        spec["bbox0"] = (center_r - half_h, center_c - half_w, center_r + half_h, center_c + half_w)
