+def _pointer_cell(bbox: tuple[int, int, int, int], direction: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    if direction == "up":
+        return r0, mid_c
+    if direction == "down":
+        return r1, mid_c
+    if direction == "left":
+        return mid_r, c0
+    if direction == "right":
+        return mid_r, c1
