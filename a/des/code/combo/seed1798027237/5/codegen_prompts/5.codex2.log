+        if not hint_values:
+            raise ValueError("hole border not found")
+        hint_color = int(Counter(hint_values).most_common(1)[0][0])
+        hole_infos.append(
+            {
+                "coords": hole,
+                "hole_set": hole_set,
+                "border": sorted(border),
+                "hint_color": hint_color,
+            }
