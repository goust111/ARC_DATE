+    fragment_masks = [_coords_to_mask(comp) for comp in fragment_components]
+    _match_fragments_to_holes(hole_masks, fragment_masks)
+
+    out = g.copy()
+    for comp in fragment_components:
+        out[comp[:, 0], comp[:, 1]] = BLACK
+
+    for hole_info in hole_infos:
