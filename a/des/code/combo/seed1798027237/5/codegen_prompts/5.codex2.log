+    holes: list[np.ndarray] = []
+    for comp in _find_components(sub == BLACK):
+        touches_edge = (
+            np.any(comp[:, 0] == 0)
+            or np.any(comp[:, 0] == sub.shape[0] - 1)
+            or np.any(comp[:, 1] == 0)
+            or np.any(comp[:, 1] == sub.shape[1] - 1)
+        )
+        if touches_edge:
+            continue
+        hole = comp + np.array([r0, c0], dtype=int)
+        holes.append(hole)
