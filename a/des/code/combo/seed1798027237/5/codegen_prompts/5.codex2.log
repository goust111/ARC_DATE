+    def dfs(depth: int) -> bool:
+        if depth == len(order):
+            return True
+        frag_idx = order[depth]
+        for hole_idx in compatibility[frag_idx]:
+            if used[hole_idx]:
+                continue
+            used[hole_idx] = True
+            assignment[frag_idx] = hole_idx
+            if dfs(depth + 1):
+                return True
+            used[hole_idx] = False
+            del assignment[frag_idx]
+        return False
