+
+def _match_fragments_to_holes(hole_masks: list[np.ndarray], fragment_masks: list[np.ndarray]) -> dict[int, int]:
+    if len(hole_masks) != len(fragment_masks):
+        raise ValueError("hole count and fragment count differ")
