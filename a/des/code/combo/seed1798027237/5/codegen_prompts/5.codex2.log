+import numpy as np
+from collections import Counter
+
+
+BLACK = 0
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    return tuple((int(r), int(c)) for r, c in np.argwhere(mask))
+
+
+def _rotation_signatures(mask: np.ndarray) -> list[tuple[tuple[int, int], ...]]:
+    sigs: list[tuple[tuple[int, int], ...]] = []
+    for k in range(4):
+        sig = _mask_signature(np.rot90(mask, k))
+        if sig not in sigs:
+            sigs.append(sig)
+    return sigs
+
+
+def _largest_component(mask: np.ndarray) -> np.ndarray:
+    comps = _find_components(mask)
+    if not comps:
+        raise ValueError("expected at least one component")
+    return max(comps, key=len)
