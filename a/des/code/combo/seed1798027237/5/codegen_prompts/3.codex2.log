+        solids = []
+        molds = []
+        for comp in comps:
+            bbox = _bbox(comp)
+            area = int(comp.shape[0])
+            bbox_area = (bbox[2] - bbox[0] + 1) * (bbox[3] - bbox[1] + 1)
+            if area == bbox_area:
+                solids.append((bbox, comp))
+            else:
+                molds.append((bbox, comp))
