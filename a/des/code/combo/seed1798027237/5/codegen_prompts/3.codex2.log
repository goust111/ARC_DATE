+    if orientation == "left":
+        mold_bbox = (10, 13, 10 + mold_h - 1, 13 + mold_w - 1)
+    elif orientation == "right":
+        mold_bbox = (10, 31, 10 + mold_h - 1, 31 + mold_w - 1)
+    elif orientation == "up":
+        mold_bbox = (3, 20, 3 + mold_h - 1, 20 + mold_w - 1)
