+
+
+def _fragment_patch(cells: list[tuple[int, int]], color: int) -> np.ndarray:
+    coords = np.array(cells, dtype=int)
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    for r, c in cells:
