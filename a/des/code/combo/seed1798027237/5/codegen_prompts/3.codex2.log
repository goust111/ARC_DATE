+
+            rr0, rc0, rr1, rc1 = rect_bbox
+            mr0, mc0, mr1, mc1 = mold_bbox
+            color = spec["color"]
+            grid[rr0 : rr1 + 1, rc0 : rc1 + 1] = color
+            grid[mr0 : mr1 + 1, mc0 : mc1 + 1] = color
+            for hr, hc in spec["holes"]:
