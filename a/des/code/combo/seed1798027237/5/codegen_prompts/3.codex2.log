+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+AZURE = 8
+PAIR_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+ORIENTATIONS = ("left", "right", "up", "down")
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 300
