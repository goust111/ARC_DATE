+    rr0, rc0, rr1, rc1 = rect_bbox
+    mr0, mc0, mr1, mc1 = mold_bbox
+    mh = mr1 - mr0 + 1
+    mw = mc1 - mc0 + 1
+
+    row_overlap = max(rr0, mr0) <= min(rr1, mr1)
