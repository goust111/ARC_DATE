+    out = g.copy()
+    for group in groups:
+        if len(group) == 1:
+            continue
+        total = sum(containers[i]["liquid_height"] for i in group)
+        base, extra = divmod(total, len(group))
+        leader = max(group, key=lambda i: (containers[i]["liquid_height"], -i))
+        color = containers[leader]["liquid_color"]
