+    runs = sorted(bottom_candidates[bottom])
+    max_count = len(runs)
+    assert sum(len(v) == max_count for v in bottom_candidates.values()) == 1
+    assert len(runs) >= 2, "expected multiple containers"
+
+    inner_width = runs[0][1] - runs[0][0] - 1
