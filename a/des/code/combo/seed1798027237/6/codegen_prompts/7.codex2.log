+
+    mode = random.choice(("all_isolated", "all_connected", "split", "mixed"))
+    if mode == "all_isolated":
+        return [0] * (count - 1)
+    if mode == "all_connected":
+        return [1] * (count - 1)
+    if mode == "split":
+        gap = random.randrange(count - 1)
+        return [0 if i == gap else 1 for i in range(count - 1)]
