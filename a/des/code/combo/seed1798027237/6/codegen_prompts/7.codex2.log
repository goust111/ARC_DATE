+                if needed > capacity:
+                    ok = False
+                    break
+            if ok:
+                totals.append(base * count + extra)
+    return sorted(set(totals))
+
+
+def _sample_positive_heights(capacities: list[int], total: int) -> list[int] | None:
+    remaining = total
+    heights: list[int] = []
+    for i, capacity in enumerate(capacities):
