+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        sample = _sample_case()
+        if sample is None:
+            continue
+        grid, _expected = sample
+        return grid
+    raise RuntimeError("failed to generate a valid input grid")

