+def _group_slices(edges: list[int]) -> list[tuple[int, int]]:
+    groups: list[tuple[int, int]] = []
+    start = 0
+    for i, edge in enumerate(edges, start=0):
+        if edge == 0:
+            groups.append((start, i + 1))
+            start = i + 1
+    groups.append((start, len(edges) + 1))
+    return groups
+
