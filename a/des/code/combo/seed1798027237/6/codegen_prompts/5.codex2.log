MARKER_SIZES = (2, 3)
CENTER_BOUNDS_BY_MARKER = {
    2: ((2, 4), (2, 5)),
    3: ((3, 4), (3, 5)),
}
CLUSTER_COUNT_RANGE = (4, 6)
CENTER_OFFSET = 2

