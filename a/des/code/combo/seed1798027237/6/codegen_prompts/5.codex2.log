+import numpy as np
+from collections import deque
+
+
+BG = 0
+AXIS_COLOR = 9
+OBJECT_COLORS = (1, 2, 3, 4, 5, 6)
+GRID_MIN = 18
+GRID_MAX = 28
+PAIR_COUNT_RANGE = (2, 4)
+ROW_GAP_RANGE = (1, 4)
+NEAR_GAP_RANGE = (0, 3)
