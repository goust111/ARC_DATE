+        options = [(j, s) for j, s in candidate_map[next_i] if j not in used_pos]
+        for j, score in options:
+            chosen[next_i] = j
+            used_pos.add(j)
+            search(chosen, used_pos, total_score + score)
+            used_pos.remove(j)
+            del chosen[next_i]
