        if bar["color"] != MARKER_COLOR:
            continue

        group = [bar]
        current = bar
        while True:
            next_col = current["col"] + current["height"]
            next_bar = by_col.get(next_col)
            if next_bar is None:
                break
            if next_bar["color"] != BODY_COLOR:
                break
            group.append(next_bar)
            current = next_bar

        for item in group:
            rows = item["coords"][:, 0]
            cols = item["coords"][:, 1]
            out[rows, cols] = bg

        for item in group:
            col = item["col"]
            height = item["height"]
            assert col + height <= g.shape[1]
            out[baseline, col : col + height] = item["color"]

    return out

