+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+MAROON = 9
+
+MARKER_COLORS = (BLUE, RED, GREEN)
+LINE_COLORS = (MAROON, BLUE, RED, GREEN)
+OBJECT_COLORS = (YELLOW, GRAY, MAGENTA, ORANGE, CYAN)
+
+MAX_GENERATION_ATTEMPTS = 300
+SHAPE_ATTEMPTS = 200
