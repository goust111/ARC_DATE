+BG = 0
+FRAME_COLOR = 5
+GEN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+MIN_GRID = 22
+MAX_GRID = 30
+FRAME_COUNT_CHOICES = (4, 5)
+FRAME_H_MIN = 6
+FRAME_H_MAX = 9
+FRAME_W_MIN = 6
+FRAME_W_MAX = 9
+LEGEND_PAIR_CHOICES = (2, 3)
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 200
