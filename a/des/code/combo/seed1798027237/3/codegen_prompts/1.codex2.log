+def _runs(mask: np.ndarray) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    start = None
+    for i, flag in enumerate(mask.tolist()):
+        if flag and start is None:
+            start = i
+        elif not flag and start is not None:
