+    top, top_mask = _horizontal_legend(grid, 0, 1, bg)
+    bottom, bottom_mask = _horizontal_legend(grid, h - 2, h - 1, bg)
+    left, left_mask = _vertical_legend(grid, 0, 1, bg)
+    right, right_mask = _vertical_legend(grid, w - 2, w - 1, bg)
