+        for obj in objects:
+            shape = obj["shape"]
+            for rr, cc in np.argwhere(shape):
+                grid[r0 + 1 + obj["row"] + int(rr), c0 + 1 + obj["col"] + int(cc)] = obj["color"]
+
+        frame_copy = dict(frame)
+        frame_copy["objects"] = objects
+        populated.append(frame_copy)
+    return populated
