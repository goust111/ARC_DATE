+
+def _expected_output(
+    grid: np.ndarray,
+    legends: dict[str, list[tuple[int, int]]],
+    frames: list[dict[str, Any]],
+) -> np.ndarray:
+    out = grid.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
