+            rect = _sample_rect(h, w)
+            if rect in rects:
+                continue
+            if idx > 0 and not any(_intersection_count(shape, rect, prev) > 0 for prev in rects):
+                continue
+            rects.append(rect)
+            break
+        else:
+            return None
+    return rects
+
