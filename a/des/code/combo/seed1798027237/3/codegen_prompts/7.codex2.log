+    return (
+        bool(allowed[r0, c0 : c1 + 1].all())
+        and bool(allowed[r1, c0 : c1 + 1].all())
+        and bool(allowed[r0 : r1 + 1, c0].all())
+        and bool(allowed[r0 : r1 + 1, c1].all())
+    )
