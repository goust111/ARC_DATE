+    if not _is_valid_instance((h, w), rects, colors):
+        return None
+
+    body = _compose_body((h, w), rects, colors)
+    legend = _legend_row(w, colors)
+    return np.vstack([body, legend])
+
+
+def generate_input() -> np.ndarray:
