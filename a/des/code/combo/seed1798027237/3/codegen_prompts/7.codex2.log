+    return (
+        bool(visible[r0, c0 : c1 + 1].any()),
+        bool(visible[r1, c0 : c1 + 1].any()),
+        bool(visible[r0 : r1 + 1, c0].any()),
+        bool(visible[r0 : r1 + 1, c1].any()),
