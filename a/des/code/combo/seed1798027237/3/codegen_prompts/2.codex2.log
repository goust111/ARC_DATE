+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RNG = np.random.default_rng()
+
+# Canvas.
+GRID_H_RANGE = (20, 31)  # inclusive-low, exclusive-high
+GRID_W_RANGE = (20, 31)
+PAIR_COUNT_CHOICES = [2, 3, 4]
+COLOR_POOL = list(range(1, 10))
