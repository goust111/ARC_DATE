+    board_order = sorted(range(pair_count), key=lambda i: int(np.prod(pairs[i]["board"].shape)), reverse=True)
+    filler_order = sorted(range(pair_count), key=lambda i: int(np.prod(pairs[i]["filler"].shape)), reverse=True)
