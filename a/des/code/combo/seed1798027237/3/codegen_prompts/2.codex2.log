+    r0 = max(0, top - OBJECT_PAD)
+    c0 = max(0, left - OBJECT_PAD)
+    r1 = min(h, top + ph + OBJECT_PAD)
+    c1 = min(w, left + pw + OBJECT_PAD)
+    blocked[r0:r1, c0:c1] = True
