+            delta = (-1, 0)
+            length = width
+        elif side == "bottom":
+            start = (r1, c0 + int(offset))
+            delta = (1, 0)
+            length = width
+        elif side == "left":
+            start = (r0 + int(offset), c0)
+            delta = (0, -1)
+            length = height
+        else:
+            start = (r0 + int(offset), c1)
+            delta = (0, 1)
+            length = height
+
+        cells = []
+        for step in range(length):
+            rr = start[0] + delta[0] * step
+            cc = start[1] + delta[1] * step
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            cells.append((rr, cc))
+        rays.append(
+            {
