+def _analyze_side(line: np.ndarray) -> tuple[bool, int | None]:
+    if int(line[0]) != FENCE or int(line[-1]) != FENCE:
+        return False, None
+    inner = line[1:-1]
+    if inner.size == 0:
+        return False, None
+    if np.any((inner != BG) & (inner != FENCE)):
+        return False, None
