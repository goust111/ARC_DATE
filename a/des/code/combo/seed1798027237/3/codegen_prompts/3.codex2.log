+
+def _placeable_positions(occupied: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = occupied.shape
+    bh, bw = shape
+    positions: list[tuple[int, int]] = []
+
+    for r in range(h - bh + 1):
+        for c in range(w - bw + 1):
+            r0 = max(0, r - 1)
+            c0 = max(0, c - 1)
+            r1 = min(h, r + bh + 1)
+            c1 = min(w, c + bw + 1)
+            if not occupied[r0:r1, c0:c1].any():
