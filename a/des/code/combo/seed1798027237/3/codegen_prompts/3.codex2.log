+        r0, c0, r1, c1 = _bbox(coords)
+        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        mask = patch != BG
+        assert int(mask.sum()) == int(coords.shape[0])
+        objects.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "patch": patch,
+                "mask": mask,
+            }
+        )
