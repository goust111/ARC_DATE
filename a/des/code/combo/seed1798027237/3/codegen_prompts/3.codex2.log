+GRID_HEIGHT_RANGE = (21, 30)
+GRID_WIDTH_RANGE = (21, 30)
+OBJECT_COUNT_OPTIONS = (2, 3)
+PROFILE_LENGTH_RANGE = (4, 8)
+HALF_SPAN_RANGE = (2, 5)
