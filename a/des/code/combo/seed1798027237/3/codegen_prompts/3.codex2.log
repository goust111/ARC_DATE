+    r0, c0, r1, c1 = bbox
+    h, w = patch.shape
+    assert h == r1 - r0 + 1 and w == c1 - c0 + 1
+
+    candidates: list[tuple[int, int]] = []
+    for ar, ac in anchors:
+        if ar == r0 - 2 and c0 <= ac <= c1 and r0 - 1 >= 0:
+            rel_c = ac - c0
+            if grid[r0 - 1, ac] == BG and patch[0, rel_c] != BG:
