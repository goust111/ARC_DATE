+        else:
+            total = _add(total, seg["exit_out"])
+    return total
+
+
+def _render_candidate(
+    shape: tuple[int, int],
+    start: Coord,
+    end: Coord,
+    oriented_segments: list[dict],
+) -> np.ndarray | None:
