+    for i, seg in enumerate(oriented_segments):
+        if i == 0:
+            entry_abs = _sub(start, seg["entry_out"])
+        else:
+            assert prev_exit is not None and prev_dir is not None
+            if seg["entry_out"] != _neg(prev_dir):
