+        assert len(nxts) == 1
+        prev, cur = cur, nxts[0]
+        ordered.append(cur)
+
+    assert ordered[-1] == endpoints[1]
+    return ordered
+
+
+def _segment_orientations(color: int, coords: np.ndarray) -> list[dict]:
+    ordered = _ordered_path(coords)
+    variants = []
