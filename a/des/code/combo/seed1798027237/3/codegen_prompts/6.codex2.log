+
+def _turn_count(path: list[Coord]) -> int:
+    turns = 0
+    for i in range(1, len(path) - 1):
+        a = _sub(path[i], path[i - 1])
+        b = _sub(path[i + 1], path[i])
+        turns += int(a != b)
+    return turns
+
+
+def _walk_dfs(
+    path: list[Coord],
+    used: set[Coord],
+    target_len: int,
+    shape: tuple[int, int],
+) -> bool:
+    if len(path) == target_len:
+        return True
+
+    cur = path[-1]
+    candidates: list[tuple[int, float, Coord]] = []
+    for nbr in _neighbors4(cur):
+        if not _in_bounds(nbr, shape) or nbr in used:
+            continue
+        freedom = sum(
+            1
+            for nxt in _neighbors4(nbr)
+            if _in_bounds(nxt, shape) and nxt not in used and nxt != cur
+        )
+        candidates.append((freedom, random.random(), nbr))
+
+    random.shuffle(candidates)
+    candidates.sort(key=lambda item: (-item[0], item[1]))
+
+    for _freedom, _noise, nbr in candidates:
+        used.add(nbr)
+        path.append(nbr)
+        if _walk_dfs(path, used, target_len, shape):
+            return True
+        path.pop()
+        used.remove(nbr)
+    return False
+
+
+def _random_walk(length: int, shape: tuple[int, int]) -> list[Coord] | None:
+    h, w = shape
+    starts = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    random.shuffle(starts)
+    for start in starts[: min(40, len(starts))]:
+        path = [start]
+        used = {start}
+        if _walk_dfs(path, used, length, shape):
+            return path
+    return None
+
+
+def _split_segments(path: list[Coord], lengths: list[int]) -> tuple[Coord, Coord, list[list[Coord]], list[Coord]]:
+    start = path[0]
+    cursor = 1
+    segments: list[list[Coord]] = []
+    connectors: list[Coord] = []
+    for i, length in enumerate(lengths):
+        seg = path[cursor : cursor + length]
+        assert len(seg) == length
+        segments.append(seg)
+        cursor += length
+        if i + 1 < len(lengths):
+            connectors.append(path[cursor])
+            cursor += 1
+    end = path[cursor]
+    assert cursor == len(path) - 1
+    return start, end, segments, connectors
+
+
+def _shape_spec(coords: list[Coord], color: int) -> dict:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    r0, c0 = min(rows), min(cols)
+    r1, c1 = max(rows), max(cols)
+    return {
+        "color": int(color),
+        "rel": [(r - r0, c - c0) for r, c in coords],
+        "h": int(r1 - r0 + 1),
+        "w": int(c1 - c0 + 1),
+        "original": set(coords),
+        "bbox_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+    }
+
+
+def _mark_blocked(blocked: np.ndarray, cells: list[Coord]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if 0 <= rr < h and 0 <= cc < w:
+                    blocked[rr, cc] = True
+
+
+def _place_scattered_segments(
+    shape: tuple[int, int],
+    start: Coord,
+    end: Coord,
+    segments: list[list[Coord]],
+    colors: list[int],
+) -> np.ndarray | None:
+    inp = np.full(shape, BG, dtype=int)
+    inp[start] = START_COLOR
+    inp[end] = END_COLOR
+
+    blocked = np.zeros(shape, dtype=bool)
+    _mark_blocked(blocked, [start, end])
