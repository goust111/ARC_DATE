+            path.pop()
+            used.remove(nxt)
+
+    dfs(base.copy())
+    _SEGMENT_PATH_CACHE[key] = paths
+    return paths
+
+
+def _extension_valid(
+    prefix_end: Coord,
+    occupied: set[Coord],
+    new_positions: list[Coord],
+    shape: tuple[int, int],
+) -> bool:
