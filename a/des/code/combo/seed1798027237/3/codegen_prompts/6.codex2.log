+                return None
+            connector = _add(prev_exit, prev_dir)
+            if not _in_bounds(connector, shape) or connector in occupied:
+                return None
+            out[connector] = CONNECTOR_COLOR
+            occupied.add(connector)
+            entry_abs = _add(connector, prev_dir)
