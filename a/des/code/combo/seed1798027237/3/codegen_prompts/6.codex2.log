+
+
+def _render_candidate(
+    shape: tuple[int, int],
+    start: Coord,
+    end: Coord,
+    oriented_segments: list[dict],
+) -> np.ndarray | None:
+    out = np.full(shape, BG, dtype=int)
+    out[start] = START_COLOR
