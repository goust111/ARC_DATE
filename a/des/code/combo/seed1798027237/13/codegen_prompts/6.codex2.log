+                    sc = rng.randint(c0 + 1, c1 - 1)
+                elif mode == 1:
+                    sr = r1 - 1
+                    sc = rng.randint(c0 + 1, c1 - 1)
+                elif mode == 2:
+                    sr = rng.randint(r0 + 1, r1 - 1)
+                    sc = c0 + 1
+                else:
