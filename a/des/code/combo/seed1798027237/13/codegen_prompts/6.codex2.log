+def extract_templates(grid: np.ndarray, frame: tuple[int, int, int, int]) -> dict[int, list[tuple[int, int]]]:
+    r0, c0, r1, c1 = frame
+    mask = grid != BLACK
+    mask[r0 : r1 + 1, c0 : c1 + 1] = False
