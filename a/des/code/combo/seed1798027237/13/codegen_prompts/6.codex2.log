+            left = rng.randint(0, w - box_w)
+            abs_cells = [(top + r, left + c) for r, c in shape]
+            if any(blocked[r, c] for r, c in abs_cells):
+                continue
+
+            for r, c in abs_cells:
+                grid[r, c] = MAROON if (r - top, c - left) == anchor else color
