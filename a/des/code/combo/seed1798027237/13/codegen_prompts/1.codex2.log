+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+OBJECT_COUNT_RANGE = (3, 5)
+REGION_RETRIES = 120
+PLACEMENT_RETRIES = 200
