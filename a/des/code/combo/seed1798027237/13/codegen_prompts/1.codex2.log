+def _sorted_colors_by_area(counts: Counter[int]) -> list[int]:
+    ranked = sorted(counts.items(), key=lambda item: item[1], reverse=True)
+    sizes = [count for _, count in ranked]
+    if len(set(sizes)) != len(sizes):
