import numpy as np, random
from collections import deque, defaultdict
rng = random.Random(0)
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def components_from_cut(h,w,path):
    blocked=set()
    # path vertices on dual grid; each step crosses adjacency between cells if internal edge
    for (r1,c1),(r2,c2) in zip(path,path[1:]):
        if abs(r1-r2)+abs(c1-c2)"'!=1:
            raise ValueError
        if r1==r2:
            r=r1
            c=min(c1,c2)
            # horizontal dual edge at row r between cols c,c+1 crosses vertical adjacency between cells (r-1,c) and (r,c)
            if 0<r<h+1:
                a=(r-1,c); b=(r,c)
                if 0<=a[0]<h and 0<=b[0]<h and 0<=a[1]<w and 0<=b[1]<w:
                    blocked.add((a,b)); blocked.add((b,a))
        else:
            r=min(r1,r2)
            c=c1
            # vertical dual edge at col c crosses horizontal adjacency between cells (r,c-1) and (r,c)
            if 0<c<w+1:
                a=(r,c-1); b=(r,c)
                if 0<=a[0]<h and 0<=b[0]<h and 0<=a[1]<w and 0<=b[1]<w:
                    blocked.add((a,b)); blocked.add((b,a))
    comps=[]
    seen=set()
    for r in range(h):
      for c in range(w):
        if (r,c) in seen: continue
        q=deque([(r,c)]); seen.add((r,c)); comp=[]
        while q:
          x=q.popleft(); comp.append(x)
          rr,cc=x
          for dr,dc in DIRS:
            y=(rr+dr,cc+dc)
            if 0<=y[0]<h and 0<=y[1]<w and y not in seen and ((x,y) not in blocked):
              seen.add(y); q.append(y)
        comps.append(comp)
    return comps

def touches_all(cells,h,w):
    s=set(cells)
    return any(r==0 for r,c in s) and any(r==h-1 for r,c in s) and any(c==0 for r,c in s) and any(c==w-1 for r,c in s)

def rand_path(h,w,steps=2000):
    # dual grid size (h+1)x(w+1)
    b=[]
    for c in range(1,w):
        b.append((0,c)); b.append((h,c))
    for r in range(1,h):
        b.append((r,0)); b.append((r,w))
    start=rng.choice(b)
    path=[start]; used={start}
    for _ in range(steps):
        r,c=path[-1]
        neigh=[]
        for dr,dc in DIRS:
            rr,cc=r+dr,c+dc
            if 0<=rr<=h and 0<=cc<=w and (rr,cc) not in used:
                # avoid stepping onto boundary too early? allow
                neigh.append((rr,cc))
        if not neigh:
            break
        # bias toward continuing and toward unvisited interior/boundary end
        rng.shuffle(neigh)
        nxt=neigh[0]
        path.append(nxt); used.add(nxt)
        if len(path)>=4 and (nxt in b) and nxt!=start:
            return path
    return None

def find(h,w,tries=5000):
    for _ in range(tries):
        p=rand_path(h,w,steps=(h+w)*4)
        if not p: continue
        comps=components_from_cut(h,w,p)
        if len(comps)!=2: continue
        if all(touches_all(comp,h,w) for comp in comps):
            a=np.zeros((h,w),bool)
            for r,c in comps[0]: a[r,c]=True
            return p,a
    return None
for h,w in [(5,5),(6,6),(7,7),(8,8),(6,8),(8,6),(9,11)]:
    ans=find(h,w,tries=1000)
    print((h,w), bool(ans))
    if ans:
      p,a=ans
      print('"'path len',len(p))
      print(a.astype(int))
