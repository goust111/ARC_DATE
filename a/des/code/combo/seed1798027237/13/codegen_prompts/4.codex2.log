rng=random.Random(0)
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_count(mask):
    H,W=mask.shape
    seen=np.zeros((H,W),bool)
    cnt=0
    for r in range(H):
      for c in range(W):
        if not mask[r,c] or seen[r,c]:
