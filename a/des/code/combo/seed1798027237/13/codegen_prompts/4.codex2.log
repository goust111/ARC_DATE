import itertools, numpy as np
from collections import deque

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    q=deque([tuple(pts[0])]); seen={tuple(pts[0])}
    H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def lpath(a,b,mode):
    (r1,c1),(r2,c2)=a,b
    pts=[]
    if mode==0:
        step = 1 if c2>=c1 else -1
        for c in range(c1, c2+step, step): pts.append((r1,c))
        step = 1 if r2>=r1 else -1
        for r in range(r1, r2+step, step): pts.append((r,c2))
    else:
        step = 1 if r2>=r1 else -1
        for r in range(r1, r2+step, step): pts.append((r,c1))
        step = 1 if c2>=c1 else -1
        for c in range(c1, c2+step, step): pts.append((r2,c))
    out=[]; seen=set()
    for p in pts:
        if p not in seen:
            out.append(p); seen.add(p)
    return out

def search(h,w):
    sides={
      'T':[(0,c) for c in range(1,w-1)],
      'B':[(h-1,c) for c in range(1,w-1)],
      'L':[(r,0) for r in range(1,h-1)],
      'R':[(r,w-1) for r in range(1,h-1)],
    }
    for order in itertools.permutations('TBLR'):
      for anchors in itertools.product(*(sides[s] for s in order)):
        for modes in itertools.product([0,1], repeat=3):
          b=np.zeros((h,w),bool)
          path=[]
          for i in range(3):
            seg=lpath(anchors[i], anchors[i+1], modes[i])
            path.extend(seg)
          for p in path: b[p]=True
          a=~b
          if conn(a) and conn(b) and touches(a) and touches(b):
            return order, anchors, modes, b
    return None
