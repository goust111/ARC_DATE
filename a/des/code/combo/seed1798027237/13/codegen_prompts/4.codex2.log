    return len(seen)==len(pts)

def touches_all(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def rand_path(a,b):
    r,c=a
    path=[a]
    while (r,c)"'!=b:
        opts=[]
        if r < b[0]: opts.append((r+1,c))
        if r > b[0]: opts.append((r-1,c))
        if c < b[1]: opts.append((r,c+1))
        if c > b[1]: opts.append((r,c-1))
        r,c=rng.choice(opts)
        path.append((r,c))
    return path

def try_one(h,w,tries=5000):
    for _ in range(tries):
        top=(0,rng.randrange(1,w-1))
        right=(rng.randrange(1,h-1),w-1)
        bottom=(h-1,rng.randrange(1,w-1))
        left=(rng.randrange(1,h-1),0)
        anchors=[top,right,bottom,left]
        rng.shuffle(anchors)
        b=np.zeros((h,w),dtype=bool)
        cur=anchors[0]
        b[cur]=True
        for nxt in anchors[1:]:
            for p in rand_path(cur,nxt):
                b[p]=True
            cur=nxt
        # random expansions
        for _ in range(rng.randrange(0, h*w//3)):
            fringe=[]
            for r in range(h):
                for c in range(w):
                    if b[r,c]:
                        continue
                    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                        rr,cc=r+dr,c+dc
                        if 0<=rr<h and 0<=cc<w and b[rr,cc]:
                            fringe.append((r,c)); break
            if not fringe: break
            r,c=rng.choice(fringe)
            b[r,c]=True
        a=~b
        if b.all() or (~b).all():
            continue
        if conn(a) and conn(b) and touches_all(a) and touches_all(b):
            return b
    return None
