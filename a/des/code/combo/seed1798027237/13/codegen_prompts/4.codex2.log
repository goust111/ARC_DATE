  cells=[(r,c) for r in range(h) for c in range(w)]
  border=[(0,c) for c in range(1,w-1)] + [(h-1,c) for c in range(1,w-1)] + [(r,0) for r in range(1,h-1)] + [(r,w-1) for r in range(1,h-1)]
  for attempt in range(tries):
    b=np.zeros((h,w),bool)
    b[rng.choice(border)]=True
    target=rng.randrange(h+w, max(h+w+1, h*w//2))
    for step in range(h*w*4):
