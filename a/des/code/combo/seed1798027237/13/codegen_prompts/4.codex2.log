def spiral(h,w):
    top,left=0,0
    bottom,right=h-1,w-1
    out=[]
    while top<=bottom and left<=right:
        for c in range(left,right+1): out.append((top,c))
        top+=1
        for r in range(top,bottom+1): out.append((r,right))
        right-=1
        if top<=bottom:
            for c in range(right,left-1,-1): out.append((bottom,c))
            bottom-=1
        if left<=right:
            for r in range(bottom,top-1,-1): out.append((r,left))
            left+=1
    return out

def touches(seg,h,w):
    rows={r for r,c in seg}; cols={c for r,c in seg}
    return 0 in rows and h-1 in rows and 0 in cols and w-1 in cols
