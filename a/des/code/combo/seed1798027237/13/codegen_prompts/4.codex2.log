def rand_find(h,w,tries=5000):
    choices=[]
    for t in range(1, min(h,w)//2 + 1):
      if h-2*t >= 1 and w-2*t >= 1:
        rows=list(range(t,h-t)); cols=list(range(t,w-t))
        if rows and cols:
