import itertools, numpy as np
from collections import deque

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    q=deque([tuple(pts[0])]); seen={tuple(pts[0])}
    H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def build(h,w,x1,x2,y0,y1,y2,topc,left_r,right_r):
    b=np.zeros((h,w),bool)
    b[y0:y2+1,x1]=True
    b[y1:y2+1,x2]=True
    b[y2,x1:x2+1]=True
    # branches to top/left/right
    b[0:y0+1,topc]=True
    # connect top branch horizontally/vertically to left leg if needed using row y0
    b[y0, min(topc,x1):max(topc,x1)+1]=True
    b[left_r,0:x1+1]=True
    b[right_r,x2:w]=True
    return b

def search(h,w):
