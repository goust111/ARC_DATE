import numpy as np, random, math, time, sys
from collections import deque
rng=random.Random(42)

def comp_count(mask):
    H,W=mask.shape
    seen=np.zeros((H,W),bool)
    cnt=0
    for r in range(H):
      for c in range(W):
        if not mask[r,c] or seen[r,c]: continue
        cnt+=1
        q=deque([(r,c)]); seen[r,c]=True
        while q:
          x,y=q.popleft()
          if x and mask[x-1,y] and not seen[x-1,y]: seen[x-1,y]=True; q.append((x-1,y))
          if x+1<H and mask[x+1,y] and not seen[x+1,y]: seen[x+1,y]=True; q.append((x+1,y))
          if y and mask[x,y-1] and not seen[x,y-1]: seen[x,y-1]=True; q.append((x,y-1))
          if y+1<W and mask[x,y+1] and not seen[x,y+1]: seen[x,y+1]=True; q.append((x,y+1))
    return cnt

def miss(mask):
    return int(not mask[0].any()) + int(not mask[-1].any()) + int(not mask[:,0].any()) + int(not mask[:,-1].any())

def score(a):
    b=~a
    s=(comp_count(a)-1)*10 + (comp_count(b)-1)*10 + miss(a)*20 + miss(b)*20
    frac=a.mean()
    s += abs(frac-0.5)
    return s

h=w=8
best=None; bests=1e9
t0=time.time()
for restart in range(200):
    a=np.array([[rng.random()<0.5 for _ in range(w)] for __ in range(h)],dtype=bool)
    # ensure both colors hit each side initially
    for arr in [a[0],a[-1],a[:,0],a[:,-1]]:
        if arr.all() or (~arr).all():
            arr[rng.randrange(len(arr))]=not arr[0]
    cur=a.copy(); cur_s=score(cur)
    if cur_s < bests:
        best,bests=cur.copy(),cur_s
    T=4.0
    for step in range(3000):
        cand=cur.copy()
        flips=1 if rng.random()<0.7 else 2
        for _ in range(flips):
            r=rng.randrange(h); c=rng.randrange(w)
            cand[r,c]=~cand[r,c]
        sc=score(cand)
        if sc < bests:
            best,bests=cand.copy(),sc
            print('best',bests,'restart',restart,'step',step,'time',time.time()-t0)
            print(best.astype(int))
            sys.stdout.flush()
            if bests==0:
                raise SystemExit
        if sc <= cur_s or rng.random() < math.exp((cur_s-sc)/max(T,1e-6)):
            cur,cur_s = cand,sc
        T*=0.999
print('final',bests)
print(best.astype(int))
