import numpy as np

def cycle(h,w):
    assert h % 2 == 0
    path=[]
    for r in range(h):
        if r % 2 == 0:
            cols = range(0, w) if r == 0 else range(1, w)
        else:
            cols = range(w-1, 0, -1)
        for c in cols:
            path.append((r,c))
    for r in range(h-1,0,-1):
        path.append((r,0))
    return path

def touches(seg,h,w):
    rows=[r for r,c in seg]; cols=[c for r,c in seg]
    return 0 in rows and h-1 in rows and 0 in cols and w-1 in cols
for h,w in [(6,6),(6,8),(8,6),(8,8),(10,12)]:
    p=cycle(h,w)
    n=len(p)
    found=None
    for i in range(n):
        for j in range(i+1,n):
            seg1=p[i:j+1]
            seg2=p[j+1:]+p[:i]
            if len(seg1)<3 or len(seg2)<3:
                continue
            if touches(seg1,h,w) and touches(seg2,h,w):
                found=(i,j,len(seg1),len(seg2))
                break
        if found: break
    print((h,w), found)
