      ct=rng.choice(cols); cb=rng.choice(cols); rl=rng.choice(rows); rr=rng.choice(rows)
      b=np.zeros((h,w),bool)
      b[t:h-t,t:w-t]=True
      b[:t,ct]=True
      b[h-t:,cb]=True
      b[rl,:t]=True
      b[rr,w-t:]=True
      a=~b
