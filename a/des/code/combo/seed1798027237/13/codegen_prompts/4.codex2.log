import numpy as np, random, math
from collections import deque
rng=random.Random(0)
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_count(mask):
    H,W=mask.shape
    seen=np.zeros((H,W),bool)
    cnt=0
    for r in range(H):
      for c in range(W):
        if not mask[r,c] or seen[r,c]:
          continue
        cnt+=1
        q=deque([(r,c)]); seen[r,c]=True
        while q:
          x,y=q.popleft()
          for dx,dy in DIRS:
            xx,yy=x+dx,y+dy
            if 0<=xx<H and 0<=yy<W and mask[xx,yy] and not seen[xx,yy]:
              seen[xx,yy]=True; q.append((xx,yy))
    return cnt

def misses(mask):
    m=0
    if not mask[0].any(): m+=1
    if not mask[-1].any(): m+=1
    if not mask[:,0].any(): m+=1
    if not mask[:,-1].any(): m+=1
    return m

def score(a):
    b=~a
    s=(comp_count(a)-1)+(comp_count(b)-1)+misses(a)+misses(b)
    frac=a.mean()
    if frac<0.2 or frac>0.8:
      s += 5 + int(20*abs(frac-0.5))
    return s

def gen(h,w,steps=20000):
    a=np.array([[rng.random()<0.5 for _ in range(w)] for __ in range(h)],dtype=bool)
    # ensure mixed borders
    for arr in [a[0],a[-1],a[:,0],a[:,-1]]:
      if arr.all() or (~arr).all():
        arr[rng.randrange(len(arr))]=not arr[0]
    cur=score(a)
    best=a.copy(); bests=cur
    temp=2.0
    for t in range(steps):
      r=rng.randrange(h); c=rng.randrange(w)
      a[r,c]=~a[r,c]
      sc=score(a)
      if sc<=cur or rng.random()<math.exp((cur-sc)/max(temp,1e-6)):
        cur=sc
        if sc<bests:
          bests=sc; best=a.copy()
          if sc==0:
            return best
      else:
        a[r,c]=~a[r,c]
      temp*=0.9997
    return best if bests==0 else None
for h,w in [(5,5),(6,6),(7,7),(8,8),(6,8),(8,6),(9,11)]:
    ans=gen(h,w,steps=50000)
    print((h,w), ans is not None)
    if ans is not None:
