import random, numpy as np, time
from collections import deque
rng=random.Random(0)

def conn(mask):
    H,W=mask.shape
    seen=np.zeros((H,W),bool)
    start=None
    cnt=mask.sum()
    for r in range(H):
      for c in range(W):
        if mask[r,c]: start=(r,c); break
      if start: break
    if start is None: return False
    q=deque([start]); seen[start]=True; seen_cnt=1
    while q:
      r,c=q.popleft()
      if r and mask[r-1,c] and not seen[r-1,c]: seen[r-1,c]=True; seen_cnt+=1; q.append((r-1,c))
      if r+1<H and mask[r+1,c] and not seen[r+1,c]: seen[r+1,c]=True; seen_cnt+=1; q.append((r+1,c))
      if c and mask[r,c-1] and not seen[r,c-1]: seen[r,c-1]=True; seen_cnt+=1; q.append((r,c-1))
      if c+1<W and mask[r,c+1] and not seen[r,c+1]: seen[r,c+1]=True; seen_cnt+=1; q.append((r,c+1))
    return seen_cnt==cnt

def touch(m):
    return bool(m[0].any()) and bool(m[-1].any()) and bool(m[:,0].any()) and bool(m[:,-1].any())

def trial(h,w,tries=200000):
  intervals=[(l,r) for l in range(w) for r in range(l,w)]
  first=[iv for iv in intervals if iv[0]>0 or iv[1]<w-1]  # top mixed
  last=first
  t0=time.time()
  for t in range(tries):
    rows=[]
    cur=rng.choice(first)
    rows.append(cur)
    ok=True
    hit_left = cur[0]==0
    hit_right = cur[1]==w-1
    for i in range(1,h-1):
      pl,pr=rows[-1]
      # choose overlapping interval and maybe help reach sides
      cands=[iv for iv in intervals if max(iv[0],pl) <= min(iv[1],pr)]
      cur=rng.choice(cands)
      rows.append(cur)
      hit_left |= cur[0]==0
      hit_right |= cur[1]==w-1
    pl,pr=rows[-1]
    cands=[iv for iv in last if max(iv[0],pl) <= min(iv[1],pr)]
    if not cands:
      continue
    cur=rng.choice(cands); rows.append(cur)
    a=np.zeros((h,w),bool)
    for r,(l,rr) in enumerate(rows): a[r,l:rr+1]=True
    if hit_left and hit_right and conn(a) and conn(~a) and touch(a) and touch(~a):
      print('found after',t,'time',time.time()-t0)
      return rows,a
  print('none in time',time.time()-t0)
  return None,None
rows,a=trial(6,6,tries=500000)
print(rows)
if a is not None:
  print(a.astype(int))
