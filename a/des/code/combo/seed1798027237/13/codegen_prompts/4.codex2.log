from collections import deque
rng=random.Random(0)

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    q=deque([tuple(pts[0])]); seen={tuple(pts[0])}
    H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
