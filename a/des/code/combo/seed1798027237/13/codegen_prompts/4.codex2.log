import numpy as np, random
from collections import deque
rng=random.Random(0)
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    q=deque([tuple(pts[0])]); seen={tuple(pts[0])}
    H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def gen(h,w,tries=2000):
  cells=[(r,c) for r in range(h) for c in range(w)]
  for _ in range(tries):
    a=np.zeros((h,w),bool)
    seed=(rng.randrange(h), rng.randrange(w))
    a[seed]=True
    target=rng.randrange(max(h+w, h*w//3), min(h*w-h-w, 2*h*w//3)+1)
    for step in range(h*w*4):
      b=~a
      if a.sum()>=target and conn(a) and conn(b) and touches(a) and touches(b):
        return a
      cand=[]
      for r,c in cells:
        if a[r,c]:
          continue
        if not any(0<=r+dr<h and 0<=c+dc<w and a[r+dr,c+dc] for dr,dc in DIRS):
          continue
        na=a.copy(); na[r,c]=True
        nb=~na
        if not conn(nb):
          continue
        if not touches(nb):
          continue
        # avoid completing whole side for A? not needed if B touches
        missA=sum(not x for x in touches(na))
        score=0
        if r==0 and not na[0].any(): score+=0
        # prefer helping A touch missing sides and staying balanced
        score += 5 - missA
        score += min(r,h-1-r,c,w-1-c)
        cand.append((score,(r,c),na))
      if not cand:
        break
      # bias toward cells on missing A sides if any
      miss=touches(a)
      def weight(item):
        (_, (r,c), _na)=item
        wgt=1
        if not miss[0] and r==0: wgt+=5
        if not miss[1] and r==h-1: wgt+=5
        if not miss[2] and c==0: wgt+=5
        if not miss[3] and c==w-1: wgt+=5
        return wgt
      weights=[weight(x) for x in cand]
      total=sum(weights)
      t=rng.uniform(0,total)
      s=0
      chosen=cand[-1]
      for item,wg in zip(cand,weights):
        s+=wg
        if s>=t:
          chosen=item; break
      a=chosen[2]
  return None
