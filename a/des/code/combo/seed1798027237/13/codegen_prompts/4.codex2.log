              for left_r in range(1,h-1):
                for right_r in range(1,h-1):
                  b=build(h,w,x1,x2,y0,y1,y2,topc,left_r,right_r)
                  a=~b
                  if conn(a) and conn(b) and touches(a) and touches(b):
                    return (x1,x2,y0,y1,y2,topc,left_r,right_r,b)
  return None
for h,w in [(5,5),(6,6),(7,7),(8,8),(6,8),(8,6),(9,11)]:
