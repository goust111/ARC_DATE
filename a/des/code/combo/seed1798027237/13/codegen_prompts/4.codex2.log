def score(a):
    b=~a
    ca=comp_count(a); cb=comp_count(b)
    ta=touches(a); tb=touches(b)
    s=(ca-1)+(cb-1)+(4-sum(ta))+(4-sum(tb))
    frac=a.mean()
    s += abs(frac-0.5)
    return s,ca,cb,ta,tb

def search(h,w,restarts=2000,steps=2000):
    best=None; bests=1e9
    t0=time.time()
    for restart in range(restarts):
        a=np.array([[rng.random()<0.5 for _ in range(w)] for __ in range(h)],dtype=bool)
        # make sure each side mixed
        for row in [0,h-1]:
            if a[row].all() or (~a[row]).all():
                a[row,rng.randrange(w)] = ~a[row,0]
        for col in [0,w-1]:
            cc=a[:,col]
            if cc.all() or (~cc).all():
                a[rng.randrange(h),col] = ~a[0,col]
        cur,*_ = score(a)
        T=1.5
        for step in range(steps):
            if cur < bests:
                bests=cur; best=a.copy()
                if bests==0:
                    print('found restart',restart,'step',step,'time',time.time()-t0)
                    return best
            # flip one or two cells
            for _ in range(2):
                r=rng.randrange(h); c=rng.randrange(w)
                a[r,c]=~a[r,c]
