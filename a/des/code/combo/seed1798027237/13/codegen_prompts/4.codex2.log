import numpy as np, random, time
from collections import deque
rng=random.Random(0)
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    q=deque([tuple(pts[0])]); seen={tuple(pts[0])}
    H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return (bool(mask[0].any()), bool(mask[-1].any()), bool(mask[:,0].any()), bool(mask[:,-1].any()))

def gen(h,w,tries=200):
  cells=[(r,c) for r in range(h) for c in range(w)]
  border=[(0,c) for c in range(1,w-1)] + [(h-1,c) for c in range(1,w-1)] + [(r,0) for r in range(1,h-1)] + [(r,w-1) for r in range(1,h-1)]
  for attempt in range(tries):
    b=np.zeros((h,w),bool)
    b[rng.choice(border)]=True
    target=rng.randrange(h+w, max(h+w+1, h*w//3))
    for step in range(h*w*4):
      a=~b
      if b.sum()>=target and all(touches(a)) and all(touches(b)) and conn(a) and conn(b):
        return b
      miss=touches(b)
      cand=[]
      for r,c in cells:
        if b[r,c]:
          continue
        deg=sum(0<=r+dr<h and 0<=c+dc<w and b[r+dr,c+dc] for dr,dc in DIRS)
        if deg==0:
          continue
        nb=b.copy(); nb[r,c]=True
        na=~nb
        if not conn(na) or not all(touches(na)):
          continue
        wgt=1 + (5 if deg==1 else 0)
        if not miss[0] and r==0: wgt+=20
        if not miss[1] and r==h-1: wgt+=20
        if not miss[2] and c==0: wgt+=20
        if not miss[3] and c==w-1: wgt+=20
        cand.append((wgt,nb))
      if not cand:
        break
      tot=sum(w for w,_ in cand)
      x=rng.uniform(0,tot); s=0
      for wgt,nb in cand:
        s+=wgt
        if s>=x:
          b=nb; break
  return None
for h,w in [(6,12),(8,12),(10,14),(12,12)]:
  t=time.time(); ans=gen(h,w,tries=200); print((h,w),'time',time.time()-t, ans is not None)
  if ans is not None:
    print(ans.astype(int))
    break
