+def _classify_component(points: list[tuple[int, int]], box: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = box
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    area = h * w
+    point_set = set(points)
+
+    if len(points) == area:
+        return "fill"
+
+    if h >= 3 and w >= 3 and len(points) == 2 * h + 2 * w - 4:
+        for r in range(r0, r1 + 1):
