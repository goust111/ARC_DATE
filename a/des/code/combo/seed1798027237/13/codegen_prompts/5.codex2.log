DIRS = ('up','down','left','right')
DIR_VEC = {'up':(-1,0),'down':(1,0),'left':(0,-1),'right':(0,1)}


def components(mask: np.ndarray, connectivity: int = 4):
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    if connectivity == 4:
        steps = [(-1,0),(1,0),(0,-1),(0,1)]
    else:
        steps = [(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            stack = [(r,c)]
            seen[r,c] = True
            pts = []
            while stack:
                rr, cc = stack.pop()
                pts.append((rr,cc))
                for dr, dc in steps:
                    nr, nc = rr+dr, cc+dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc] = True
                        stack.append((nr,nc))
            out.append(np.array(pts, dtype=int))
    return out


def bbox(coords):
    return (int(coords[:,0].min()), int(coords[:,1].min()), int(coords[:,0].max()), int(coords[:,1].max()))


def decode_arrow(coords):
    r0,c0,r1,c1 = bbox(coords)
    rel = {(int(r-r0), int(c-c0)) for r,c in coords}
    h = r1-r0+1
    w = c1-c0+1
    if h == 3 and w >= 2:
        row_counts = [sum((rr,cc) in rel for cc in range(w)) for rr in range(h)]
        center_rel_r = int(np.argmax(row_counts))
        if center_rel_r "'!= 1 or row_counts != [1, w, 1]:
            raise ValueError(('"'bad horizontal rows', row_counts, rel))
        left_rows = {rr for rr,cc in rel if cc == 0}
        right_rows = {rr for rr,cc in rel if cc == w-1}
        col_counts = [sum((rr,cc) in rel for rr in range(h)) for cc in range(w)]
        if right_rows == {1} and w >= 2 and col_counts[-2] == 3:
            return 'right', w-1, (r0+1, c0)
        if left_rows == {1} and w >= 2 and col_counts[1] == 3:
            return 'left', w-1, (r0+1, c1)
        raise ValueError(('bad horizontal cols', col_counts, rel))
    if w == 3 and h >= 2:
        col_counts = [sum((rr,cc) in rel for rr in range(h)) for cc in range(w)]
        center_rel_c = int(np.argmax(col_counts))
        if center_rel_c "'!= 1 or col_counts != [1, h, 1]:
            raise ValueError(('"'bad vertical cols', col_counts, rel))
        top_cols = {cc for rr,cc in rel if rr == 0}
        bot_cols = {cc for rr,cc in rel if rr == h-1}
        row_counts = [sum((rr,cc) in rel for cc in range(w)) for rr in range(h)]
        if bot_cols == {1} and h >= 2 and row_counts[-2] == 3:
            return 'down', h-1, (r0, c0+1)
        if top_cols == {1} and h >= 2 and row_counts[1] == 3:
            return 'up', h-1, (r1, c0+1)
        raise ValueError(('bad vertical rows', row_counts, rel))
    raise ValueError(('bad bbox', (h,w), rel))


def main(grid):
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    pattern_mask = (g "'!= BG) & (g != RED)
    pattern_comps = components(pattern_mask, connectivity=4)
    labels = -np.ones((h,w), dtype=int)
    patterns = []
    for idx, comp in enumerate(pattern_comps):
        r0,c0,r1,c1 = bbox(comp)
        patch = g[r0:r1+1, c0:c1+1].copy()
        patterns.append({'"'bbox':(r0,c0,r1,c1), 'patch':patch, 'h':r1-r0+1, 'w':c1-c0+1})
        labels[comp[:,0], comp[:,1]] = idx
    actions = []
    for comp in components(g == RED, connectivity=4):
        d, L, start = decode_arrow(comp)
        sr, sc = start
        if d == 'right':
            ar, ac = sr, sc - 1
        elif d == 'left':
            ar, ac = sr, sc + 1
        elif d == 'down':
            ar, ac = sr - 1, sc
        else:
            ar, ac = sr + 1, sc
        if not (0 <= ar < h and 0 <= ac < w):
