def build_spec(obj_r0, obj_c0, pat, direction, L, attach):
    h, w = pat.shape
    r0, c0 = obj_r0, obj_c0
    r1, c1 = r0 + h - 1, c0 + w - 1
    cells = []
    if direction == 'right':
        rr = attach
        cells.extend((rr, c) for c in range(c1 + 1, c1 + L + 1))
        cells.extend([(rr - 1, c1 + L), (rr + 1, c1 + L), (rr, c1 + L + 1)])
        copy_bbox = (r0, c0 + w + L, r1, c1 + w + L)
    elif direction == 'left':
        rr = attach
        cells.extend((rr, c) for c in range(c0 - L, c0))
        cells.extend([(rr - 1, c0 - L), (rr + 1, c0 - L), (rr, c0 - L - 1)])
        copy_bbox = (r0, c0 - (w + L), r1, c1 - (w + L))
    elif direction == 'down':
        cc = attach
        cells.extend((r, cc) for r in range(r1 + 1, r1 + L + 1))
        cells.extend([(r1 + L, cc - 1), (r1 + L, cc + 1), (r1 + L + 1, cc)])
        copy_bbox = (r0 + h + L, c0, r1 + h + L, c1)
    else:
        cc = attach
        cells.extend((r, cc) for r in range(r0 - L, r0))
        cells.extend([(r0 - L, cc - 1), (r0 - L, cc + 1), (r0 - L - 1, cc)])
        copy_bbox = (r0 - (h + L), c0, r1 - (h + L), c1)
    return {'bbox': (r0,c0,r1,c1), 'pattern': pat, 'direction': direction, 'length': int(L), 'attach': attach, 'arrow_cells': cells, 'copy_bbox': copy_bbox}


def rect_cells(rect):
    r0,c0,r1,c1 = rect
    return [(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)]


def overlap(a,b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def gen_attempt(rng):
    need_overlap = bool(rng.random() < 0.35)
    if need_overlap:
        H = int(rng.integers(12, 18))
        W = int(rng.integers(12, 18))
        n = int(rng.integers(2, 5))
    else:
        H = int(rng.integers(12, 23))
        W = int(rng.integers(12, 23))
        n = int(rng.choice([1,2,3,4], p=[0.15,0.35,0.3,0.2]))
    occupied = np.zeros((H,W), dtype=bool)
    blocked = np.zeros((H,W), dtype=bool)
    reserved = np.zeros((H,W), dtype=bool)
    specs = []
    for _ in range(n):
        ok = None
        for _attempt in range(300):
            ph = int(rng.integers(2, 6))
            pw = int(rng.integers(2, 6))
            pat = sample_pattern(rng, ph, pw)
            direction = str(rng.choice(DIRS))
            L = int(rng.integers(1, 6))
            r0 = int(rng.integers(0, H - ph + 1))
            c0 = int(rng.integers(0, W - pw + 1))
            if direction in ('left','right'):
                rows = [r for r in range(r0, r0 + ph) if 1 <= r <= H - 2]
                if not rows:
