+        direction, length, pattern_idx = matches[0]
+        pattern = patterns[pattern_idx]
+        span = int(pattern["w"]) if direction in ("left", "right") else int(pattern["h"])
+        shift = length + span
+        dr, dc = DIR_STEP[direction]
+        actions.append(
+            (
+                length,
+                pattern["bbox"],
+                pattern["patch"],
