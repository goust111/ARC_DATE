+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    need_overlap = bool(rng.random() < OVERLAP_PROB)
+    max_side = OVERLAP_GRID_MAX if need_overlap else GRID_MAX
+    h = int(rng.integers(GRID_MIN, max_side + 1))
