+    actions: list[tuple[int, tuple[int, int, int, int], np.ndarray, int, int]] = []
+    for comp in _components(g == RED, connectivity=4):
+        matches: list[tuple[str, int, int]] = []
+        for direction, length, start in _arrow_candidates(comp):
