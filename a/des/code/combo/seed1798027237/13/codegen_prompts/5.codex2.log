                if not cols:
                    continue
                attach = int(rng.choice(cols))
            spec = build_spec(r0, c0, pat, direction, L, attach)
            cr0, cc0, cr1, cc1 = spec['copy_bbox']
            if not (0 <= cr0 <= cr1 < H and 0 <= cc0 <= cc1 < W):
                continue
            arrow = spec['arrow_cells']
            if any(not (0 <= r < H and 0 <= c < W) for r,c in arrow):
                continue
            obj_cells = rect_cells(spec['bbox'])
            input_cells = obj_cells + arrow
            bad = False
            for r,c in input_cells:
                if blocked[r,c] or reserved[r,c]:
                    bad = True
                    break
            if bad:
                continue
            if occupied[cr0:cr1+1, cc0:cc1+1].any():
                continue
            ok = spec
            break
        if ok is None:
            return None
        specs.append(ok)
        for r,c in rect_cells(ok['bbox']) + ok['arrow_cells']:
            occupied[r,c] = True
        pts = np.argwhere(occupied)
        blocked = np.zeros((H,W), dtype=bool)
        for r,c in pts:
