        pat = patterns[pi]
        shift = L + (pat['w'] if d in ('left','right') else pat['h'])
        dr, dc = DIR_VEC[d]
        actions.append((L, pi, dr*shift, dc*shift))
    out = g.copy()
    out[out == RED] = BG
    actions.sort(key=lambda x: x[0])
    for _L, pi, dr, dc in actions:
