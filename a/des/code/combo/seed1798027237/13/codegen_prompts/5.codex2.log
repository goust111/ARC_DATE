+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+PALETTE = np.array([1, 3, 4, 5, 6, 7, 8, 9], dtype=int)
+
+DIRS = ("up", "down", "left", "right")
+DIR_STEP = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
