+    elif mode == 4:
+        for r in range(h):
+            for c in range(w):
+                idx = ((r >= h // 2) * 2 + (c >= w // 2)) % color_count
+                pat[r, c] = int(colors[idx])
+    else:
+        pat[:] = int(colors[0])
+        for r in range(h):
+            for c in range(w):
