        pr0 = rs0 - nr0
        pc0 = cs0 - nc0
        out[rs0:rs1, cs0:cs1] = patch[pr0:pr0 + (rs1-rs0), pc0:pc0 + (cs1-cs0)]
    return out


def sample_pattern(rng, h, w):
    colors = rng.choice(PALETTE, size=int(rng.integers(1, min(4, len(PALETTE)+1))), replace=False)
    mode = int(rng.integers(0, 6))
    pat = np.empty((h,w), dtype=int)
    if mode == 0 or len(colors) == 1:
        pat[:] = int(colors[0])
    elif mode == 1:
        for c in range(w):
            pat[:, c] = int(colors[c % len(colors)])
    elif mode == 2:
        for r in range(h):
            pat[r, :] = int(colors[r % len(colors)])
    elif mode == 3:
        for r in range(h):
            for c in range(w):
                pat[r, c] = int(colors[(r + c) % len(colors)])
    elif mode == 4:
        for r in range(h):
            for c in range(w):
                idx = (r >= h // 2) * 2 + (c >= w // 2)
                pat[r, c] = int(colors[idx % len(colors)])
    else:
        base = int(colors[0])
        pat[:] = base
        for r in range(h):
            for c in range(w):
                if (r + c) % 2 == 0 or (r == h//2 or c == w//2):
                    pat[r,c] = int(colors[(r*3 + c) % len(colors)])
