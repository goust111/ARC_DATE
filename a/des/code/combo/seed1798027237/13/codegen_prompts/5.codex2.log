+def _paste_clipped(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = out.shape
+    ph, pw = patch.shape
+    r0 = max(0, top)
+    c0 = max(0, left)
+    r1 = min(h, top + ph)
+    c1 = min(w, left + pw)
+    if r0 >= r1 or c0 >= c1:
+        return
+    pr0 = r0 - top
+    pc0 = c0 - left
+    out[r0:r1, c0:c1] = patch[pr0 : pr0 + (r1 - r0), pc0 : pc0 + (c1 - c0)]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
