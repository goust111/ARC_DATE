+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+MARKER_COLOR = 4  # yellow
+SEPARATOR_COLOR = 5  # grey
+PATH_COLOR = 8  # azure
+
+SLOT_SIZE = 6
+GEN_ATTEMPTS = 300
+RNG = random.Random()
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(int(v) for v in grid.ravel()).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(comp: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in comp]
+    cs = [c for _, c in comp]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _find_separator_col(grid: np.ndarray, bg: int) -> int:
+    candidates: list[int] = []
+    for c in range(grid.shape[1]):
+        col = grid[:, c]
+        if int(col[0]) != bg and bool(np.all(col == col[0])):
+            candidates.append(c)
+    exact = [c for c in candidates if int(grid[0, c]) == SEPARATOR_COLOR]
+    if exact:
+        assert len(exact) == 1
+        return int(exact[0])
+    assert len(candidates) == 1
+    return int(candidates[0])
+
