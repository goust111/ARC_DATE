+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+MARKER_COLOR = 4  # yellow
+SEPARATOR_COLOR = 5  # grey
+PATH_COLOR = 8  # azure
+
+SLOT_SIZE = 6
+GEN_ATTEMPTS = 300
+RNG = random.Random()
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(int(v) for v in grid.ravel()).most_common(1)[0][0])
