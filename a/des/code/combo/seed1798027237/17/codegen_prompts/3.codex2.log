+            neighbors = [
+                (r - 1, c),
+                (r + 1, c),
+                (r, c - 1),
+                (r, c + 1),
+            ]
+            if sum(
+                1
+                for nr, nc in neighbors
+                if 0 <= nr < h and 0 <= nc < sep_col and int(grid[nr, nc]) != _bg_color(grid)
