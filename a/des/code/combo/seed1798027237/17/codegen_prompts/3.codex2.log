+def _find_marker(grid: np.ndarray, sep_col: int) -> tuple[int, int]:
+    pts = np.argwhere(grid[:, :sep_col] == MARKER_COLOR)
+    if pts.shape[0] == 1:
+        return int(pts[0, 0]), int(pts[0, 1])
