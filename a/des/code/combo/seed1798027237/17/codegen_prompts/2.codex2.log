+def _mark_blocked(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in coords:
+        r0 = max(0, r - 1)
+        r1 = min(h, r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(w, c + 2)
+        blocked[r0:r1, c0:c1] = True
