+        occupied = np.zeros((h, w), dtype=bool)
+
+        order = list(range(len(rooms)))
+        random.shuffle(order)
+        order.sort(key=lambda idx: rooms[idx].shape[0] * rooms[idx].shape[1], reverse=True)
+
+        ok = True
+        for idx in order:
+            room = rooms[idx]
+            rh, rw = room.shape
+            placed = False
+            for _ in range(300):
