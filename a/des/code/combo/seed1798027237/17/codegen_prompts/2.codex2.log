+        if random.random() < 0.5:
+            transformed = {(c, r) for r, c in transformed}
+        if random.random() < 0.5:
+            transformed = {(-r, c) for r, c in transformed}
+        if random.random() < 0.5:
+            transformed = {(r, -c) for r, c in transformed}
