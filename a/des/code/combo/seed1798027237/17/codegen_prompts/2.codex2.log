+def _find_monochrome_components(grid: np.ndarray, mask: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            pts: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and mask[nr, nc]
+                        and not visited[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.array(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(len(pts)),
+                }
+            )
+
+    return comps
