+GRID_MIN = 12
+GRID_MAX = 30
+SIDE_CHOICES = (5, 7, 9)
+GAP_RANGE = (1, 4)
+MAX_GENERATION_ATTEMPTS = 300
+PATTERN_ATTEMPTS = 80
+LAYOUT_ATTEMPTS = 80
+COLOR_POOL = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+
+ROTATIONS_TO_TOP = {
+    "top": 0,
+    "right": 1,
+    "bottom": 2,
+    "left": 3,
+}
+GAP_CELLS = {
+    "top": lambda side: (0, side // 2),
+    "right": lambda side: (side // 2, side - 1),
+    "bottom": lambda side: (side - 1, side // 2),
+    "left": lambda side: (side // 2, 0),
