+    for solid in solids:
+        enclosing = [frame for frame in frames if _strictly_contains(frame["bbox"], solid["bbox"])]
+        if enclosing:
+            ranked.append((len(enclosing), _bbox_area(solid["bbox"]), solid, enclosing))
