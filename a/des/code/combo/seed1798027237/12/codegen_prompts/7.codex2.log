+    stayed_grey = 0
+    pipe_mask = grid == PIPE_COLOR
+    for (r, c), total in _intersection_sums(pipe_mask).items():
+        if total in color_by_length:
+            expected[r, c] = color_by_length[total]
+            changed += 1
