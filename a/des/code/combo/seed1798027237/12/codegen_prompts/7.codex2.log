+        return None
+    if matched_lengths != set(sums.values()) and stayed_grey == 0:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATE_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
