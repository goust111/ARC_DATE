+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATE_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid pipe-legend input")

