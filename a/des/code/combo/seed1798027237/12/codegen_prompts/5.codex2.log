+# Palette and layout.
+ALL_COLORS = tuple(range(10))
+SEPARATOR_COLOR = 5
+QUAD_SIZE_RANGE = (10, 14)
+LEGEND_BLOCK_SIZES = (1, 2, 3)
+LEGEND_GAPS = (1, 2)
