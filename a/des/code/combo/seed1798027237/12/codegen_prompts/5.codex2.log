+    for src, dst_center in zip(ordered_objects, ordered_positions):
+        box = int(src["box"])
+        radius = box // 2
+        top = r0 + int(dst_center[0]) - radius
+        left = c0 + int(dst_center[1]) - radius
+        _paint_coords(grid, int(top), int(left), src["shape"], int(src["color"]))
