+def _random_shape(box: int) -> np.ndarray:
+    center = (box // 2, box // 2)
+    anchors = [
+        (0, random.randint(0, box - 1)),
+        (box - 1, random.randint(0, box - 1)),
+        (random.randint(0, box - 1), 0),
