+def _components_in_rect(
+    grid: np.ndarray, r0: int, r1: int, c0: int, c1: int, ignored: set[int]
+) -> list[dict]:
+    sub_h = int(r1 - r0)
+    sub_w = int(c1 - c0)
+    seen = np.zeros((sub_h, sub_w), dtype=bool)
+    comps: list[dict] = []
+
+    for lr in range(sub_h):
