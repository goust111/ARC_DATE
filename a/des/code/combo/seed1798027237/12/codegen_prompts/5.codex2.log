+    h, w = map(int, occupied.shape)
+    r0 = max(0, int(top - OBJECT_PADDING))
+    r1 = min(h, int(top + box + OBJECT_PADDING))
+    c0 = max(0, int(left - OBJECT_PADDING))
+    c1 = min(w, int(left + box + OBJECT_PADDING))
+    occupied[r0:r1, c0:c1] = True
