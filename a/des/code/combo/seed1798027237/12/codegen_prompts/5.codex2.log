+            if seen[lr, lc]:
+                continue
+            color = int(grid[r0 + lr, c0 + lc])
+            if color in ignored:
+                seen[lr, lc] = True
+                continue
+
+            seen[lr, lc] = True
+            stack = [(lr, lc)]
