+    sub_w = int(c1 - c0)
+    seen = np.zeros((sub_h, sub_w), dtype=bool)
+    comps: list[dict] = []
+
+    for lr in range(sub_h):
+        for lc in range(sub_w):
+            if seen[lr, lc]:
+                continue
+            color = int(grid[r0 + lr, c0 + lc])
+            if color in ignored:
+                seen[lr, lc] = True
+                continue
+
+            seen[lr, lc] = True
+            stack = [(lr, lc)]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((r0 + cr, c0 + cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < sub_h and 0 <= nc < sub_w) or seen[nr, nc]:
+                        continue
+                    if int(grid[r0 + nr, c0 + nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
