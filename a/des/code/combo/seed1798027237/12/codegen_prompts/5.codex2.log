+def _manhattan_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    out = [(int(r), int(c))]
+    if random.random() < 0.5:
+        while c != end[1]:
+            c += 1 if end[1] > c else -1
+            out.append((int(r), int(c)))
+        while r != end[0]:
+            r += 1 if end[0] > r else -1
+            out.append((int(r), int(c)))
