+    return comps
+
+
+def _legend_axis(components: list[dict]) -> str | None:
+    if len(components) < 2:
+        return None
+    rows = {int(comp["center2"][0]) for comp in components}
+    cols = {int(comp["center2"][1]) for comp in components}
+    if len(rows) == 1 and len(cols) > 1:
+        return "row"
+    if len(cols) == 1 and len(rows) > 1:
+        return "col"
+    return None
