+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(int(r), int(c))])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
