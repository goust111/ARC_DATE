+def _pairwise_overlap_sizes(cell_sets: list[set[tuple[int, int]]]) -> list[int]:
+    overlaps: list[int] = []
+    for i in range(len(cell_sets)):
+        for j in range(i + 1, len(cell_sets)):
+            overlaps.append(int(len(cell_sets[i] & cell_sets[j])))
