+    "up": [(0, 1), (1, 0), (1, 2)],
+    "down": [(0, 0), (0, 2), (1, 1)],
+    "left": [(0, 1), (1, 0), (2, 1)],
+    "right": [(0, 0), (1, 1), (2, 0)],
