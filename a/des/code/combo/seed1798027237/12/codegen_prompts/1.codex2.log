+    gap_x = rng.randint(1, 2)
+
+    inner_h = pad_top + pad_bottom + sum(row_heights) + gap_y * (nrows - 1)
+    inner_w = pad_left + pad_right + sum(col_widths) + gap_x * (ncols - 1)
+    region = np.full((inner_h + 2, inner_w + 2), bg, dtype=int)
