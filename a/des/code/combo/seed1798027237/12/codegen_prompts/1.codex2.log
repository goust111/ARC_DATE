+def _detect_grey_and_legend(grid: np.ndarray, bg: int) -> tuple[int, list[int], np.ndarray]:
+    colors = [int(c) for c in np.unique(grid) if int(c) != bg]
+    preferred = []
+    if GREY in colors:
+        preferred.append(GREY)
+    preferred.extend([c for c in colors if c != GREY])
