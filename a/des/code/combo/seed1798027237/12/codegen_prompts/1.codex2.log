+def _inside_of_barrier(barrier: np.ndarray) -> np.ndarray:
+    h, w = barrier.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not barrier[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not barrier[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
