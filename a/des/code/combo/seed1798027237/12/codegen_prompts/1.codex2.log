+    if not candidates:
+        return False
+    top, left = rng.choice(candidates)
+    grey_mask = region == GREY
+    sub = grid[top : top + rh, left : left + rw]
+    sub[grey_mask] = GREY
+    occ[
+        max(0, top - 1) : min(h, top + rh + 1),
+        max(0, left - 1) : min(w, left + rw + 1),
+    ] = True
+    return True
