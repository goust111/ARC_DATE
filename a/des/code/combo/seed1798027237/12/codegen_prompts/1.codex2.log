+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(pts: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(pts[:, 0].min()),
+        int(pts[:, 1].min()),
+        int(pts[:, 0].max()),
+        int(pts[:, 1].max()),
+    )
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _legend_spec_for_grey(
+    grid: np.ndarray, bg: int, grey: int
+) -> tuple[list[int], np.ndarray] | None:
+    h, w = grid.shape
+    colors = [int(c) for c in np.unique(grid) if int(c) not in (bg, grey)]
+    if not colors:
+        return None
+
+    entries = []
+    for color in colors:
+        comps = _components(grid == color)
+        if len(comps) != 1:
+            return None
+        pts = comps[0]
+        entries.append({"color": color, "bbox": _bbox(pts), "pts": pts})
+
+    legend_mask = np.isin(grid, colors)
+    all_pts = np.argwhere(legend_mask)
+    r0, c0, r1, c1 = _bbox(all_pts)
+    sides = []
+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    if len(sides) != 1:
+        return None
+
+    side = sides[0]
+    if side in ("top", "bottom"):
+        if (r1 - r0 + 1) > 4:
+            return None
+        ordered = sorted(entries, key=lambda e: (e["bbox"][1], e["bbox"][0]))
+        prev_end = -1
+        row_overlap_lo = max(int(e["bbox"][0]) for e in ordered)
+        row_overlap_hi = min(int(e["bbox"][2]) for e in ordered)
+        if row_overlap_lo > row_overlap_hi:
+            return None
+        for entry in ordered:
