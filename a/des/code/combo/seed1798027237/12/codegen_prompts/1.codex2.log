+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GREY = 5
+GEN_ATTEMPTS = 300
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 30
+LEGEND_LEN_MIN = 3
+LEGEND_LEN_MAX = 5
+REGION_COUNT_MIN = 2
+REGION_COUNT_MAX = 4
