+    out = main(grid)
+    produced = _inspect_output(grid, out, islands)
+    if produced != kinds:
+        return None
+    if not wall_cells:
+        return None
+    if not _ordered_lighthouses(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
