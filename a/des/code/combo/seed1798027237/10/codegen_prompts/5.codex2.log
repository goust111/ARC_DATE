+        left = col_starts[perm[idx]]
+        height = row_sizes[idx]
+        width = col_sizes[perm[idx]]
+        shape = _make_island_shape(height, width, rng)
+        abs_cells = {(top + r, left + c) for r, c in shape}
+        if abs_cells & all_island_cells:
