+
+    offset = rng.randrange(3)
+    kinds = [((offset + i) % 3) for i in range(n_islands)]
+    rng.shuffle(kinds)
+    palette = list(rng.sample(LIGHTHOUSE_COLORS, rng.randint(3, 4)))
