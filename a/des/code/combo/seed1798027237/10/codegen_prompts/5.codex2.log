+                    start_max = min(int(col), w - 1 - length)
+                    starts = list(range(start_min, start_max + 1))
+                    rng.shuffle(starts)
+                    for start in starts:
+                        wall = [(wall_row, c) for c in range(start, start + length)]
+                        if int(col) not in {c for _, c in wall}:
