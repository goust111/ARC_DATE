+    gaps = [base_gaps[i] + extras[i] for i in range(len(base_gaps))]
+    starts: list[int] = []
+    pos = gaps[0]
+    for idx, size in enumerate(sizes):
+        starts.append(pos)
+        pos += size
+        if idx < len(sizes) - 1:
+            pos += gaps[idx + 1]
+    return starts
