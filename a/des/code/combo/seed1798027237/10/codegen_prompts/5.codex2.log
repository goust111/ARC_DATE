+        block_side, block_coord, wall = blocked
+        for r, c in wall:
+            grid[r, c] = WALL
+            wall_cells.add((r, c))
+
+        forbidden = set(plan["visible_colors"].values())  # type: ignore[union-attr]
+        block_color = _choose_color(palette, forbidden, rng)
