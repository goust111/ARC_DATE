+
+
+def _inspect_output(grid: np.ndarray, out: np.ndarray, islands: list[dict[str, object]]) -> list[int]:
+    branch_kinds: list[int] = []
+    for island in islands:
+        colors = {int(out[r, c]) for r, c in island["cells"]}  # type: ignore[index]
+        if colors == {ISLAND}:
