+    assert len(seed_positions) == 4, "expected one colored seed per quadrant"
+
+    seeds: list[dict[str, int]] = []
+    seen_quadrants: set[str] = set()
+    seen_colors: set[int] = set()
+    for row, col in seed_positions:
