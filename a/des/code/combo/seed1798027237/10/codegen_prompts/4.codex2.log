+        frame_h = int(rng.integers(max(FRAME_H_RANGE[0], gap + 4), FRAME_H_RANGE[1] + 1))
+        frame_w = int(rng.integers(max(FRAME_W_RANGE[0], sprite_w + 4), FRAME_W_RANGE[1] + 1))
