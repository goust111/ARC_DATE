+def _apply_extrusion(out: np.ndarray, frame: dict, sprite: dict, bg: int) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    side = frame["gap_side"]
+    count = int(frame["gap_width"])
+    top = int(sprite["top"])
+    left = int(sprite["left"])
+    patch = np.asarray(sprite["patch"], dtype=int)
+    ph, pw = patch.shape
