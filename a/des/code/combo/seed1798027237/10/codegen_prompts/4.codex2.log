+
+    pts = np.argwhere(mask)
+    sr0, sc0 = pts.min(axis=0)
+    sr1, sc1 = pts.max(axis=0)
+    sr0, sc0, sr1, sc1 = map(int, (sr0, sc0, sr1, sc1))
+    patch = inner[sr0 : sr1 + 1, sc0 : sc1 + 1].copy()
+    if np.any((patch != bg) & (patch == int(frame["color"]))):
+        return None
