+    for step in range(1, count + 1):
+        if side == "top":
+            dest_top = r0 - step * ph
+            dest_left = left
+        elif side == "bottom":
+            dest_top = r1 + 1 + (step - 1) * ph
+            dest_left = left
+        elif side == "left":
+            dest_top = top
+            dest_left = c0 - step * pw
+        else:
+            dest_top = top
+            dest_left = c1 + 1 + (step - 1) * pw
