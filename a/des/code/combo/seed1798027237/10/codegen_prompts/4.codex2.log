+def _missing_run(line: np.ndarray) -> tuple[int, int] | None:
+    miss = np.flatnonzero(~line)
+    if miss.size == 0:
+        return (0, 0)
+    if miss[-1] - miss[0] + 1 != miss.size:
+        return None
+    return int(miss[0]), int(miss.size)
