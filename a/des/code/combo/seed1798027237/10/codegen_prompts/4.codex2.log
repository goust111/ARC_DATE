+def _components_by_color(grid: np.ndarray, bg: int) -> list[tuple[int, np.ndarray]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, np.ndarray]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+            comps.append((color, np.asarray(cells, dtype=int)))
+    return comps
