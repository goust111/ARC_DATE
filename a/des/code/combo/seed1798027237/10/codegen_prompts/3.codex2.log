+                shape,
+                head_tip,
+                new_dir,
+                turns_left - 1,
+                occupied | set(bg_cells) | new_gray,
+                gray_cells | new_gray,
+                arrows + [new_arrow],
+            )
+            if result is not None:
+                return result
+
+    return None
+
