_GEN_MARKER_ROW = 0
_GEN_MIN_WALL_ROW = 2
_GEN_LAST_WALL_ROW = 8

# Closed container interior size ranges, with exclusive upper bounds.
_GEN_INTERIOR_H_RANGE = (2, 4)
_GEN_INTERIOR_W_RANGE = (1, 6)

# Broken distractor patch size ranges, with exclusive upper bounds.
