+        "tail": tail,
+        "center": center,
+        "head_mid": head_mid,
+        "head_tip": head_tip,
+        "in_dir": in_dir,
+        "out_dir": out_dir,
+        "cells": pts,
+    }
+
+
+def _trace(
+    grid: np.ndarray,
+    bg: int,
+    arrows_by_tail: dict[tuple[int, int], dict[str, object]],
+    start: tuple[int, int],
+    target: tuple[int, int],
+) -> list[tuple[int, int]] | None:
