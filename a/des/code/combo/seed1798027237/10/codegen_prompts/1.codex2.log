+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 400
+ALL_COLORS = tuple(range(10))
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _reachable(passable: np.ndarray, seeds: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    reach = np.zeros((h, w), dtype=bool)
+    q = deque()
+    seed_pts = np.argwhere(passable & seeds)
+    for r, c in seed_pts:
+        rr, cc = int(r), int(c)
+        reach[rr, cc] = True
+        q.append((rr, cc))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not reach[nr, nc]:
+                reach[nr, nc] = True
+                q.append((nr, nc))
+    return reach
+
+
+def _parse_legend_strip(primary: np.ndarray, secondary: np.ndarray, bg: int):
