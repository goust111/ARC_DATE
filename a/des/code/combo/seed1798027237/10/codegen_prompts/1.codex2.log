+    colors = rng.sample(fill_palette, k)
+    cells = interior_cells[:]
+    rng.shuffle(cells)
+    for idx, color in enumerate(colors):
+        r, c = cells[idx]
+        patch[r, c] = color
+    extras = cells[k:]
+    rng.shuffle(extras)
+    extra_count = rng.randint(0, min(len(extras), k + 2))
+    for r, c in extras[:extra_count]:
+        patch[r, c] = rng.choice(colors)
+    return patch
