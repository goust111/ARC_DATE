+            (h - 2, 1),
+            (h - 2, 0),
+            (1, 0),
+            (1, 1),
+            (0, 1),
+        ]
+        wall = _draw_polyline((h, w), points)
+    else:
+        side = rng.choice(("left", "right"))
+        notch_r = rng.randint(1, h - 3)
+        if side == "right":
+            points = [
+                (0, 0),
+                (0, w - 1),
+                (notch_r, w - 1),
+                (notch_r, w - 2),
+                (notch_r + 1, w - 2),
+                (notch_r + 1, w - 1),
+                (h - 1, w - 1),
+                (h - 1, 0),
+                (0, 0),
+            ]
+        else:
+            points = [
+                (0, w - 1),
+                (0, 0),
+                (notch_r, 0),
+                (notch_r, 1),
+                (notch_r + 1, 1),
+                (notch_r + 1, 0),
+                (h - 1, 0),
+                (h - 1, w - 1),
+                (0, w - 1),
