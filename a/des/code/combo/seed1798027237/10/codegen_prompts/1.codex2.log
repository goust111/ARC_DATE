+            r0, c0 = pos
+            ph, pw = patch.shape
+            grid[r0 : r0 + ph, c0 : c0 + pw] = patch
+            blocked[r0 - 1 : r0 + ph + 1, c0 - 1 : c0 + pw + 1] = True
