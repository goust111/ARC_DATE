+def _make_loop_patch(rng: random.Random):
+    family = rng.choice(("rect", "bevel", "notch"))
+    h = rng.randint(5, 9)
+    w = rng.randint(5, 11)
+
+    if family == "rect":
+        wall = np.zeros((h, w), dtype=bool)
+        wall[0, :] = True
+        wall[h - 1, :] = True
