+        legend_mask = np.zeros_like(grid, dtype=bool)
+        legend_mask[height - 2 : height, :] = legend_local_mask
+
+    blocked[:, 0] = True
+    blocked[:, width - 1] = True
+    region_count = rng.randint(2, 5)
+    ks = rng.sample([1, 2, 3, 4, 5], region_count)
+    rng.shuffle(ks)
+
+    for k in ks:
