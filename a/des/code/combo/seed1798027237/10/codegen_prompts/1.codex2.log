+    h, w = passable.shape
+    seeds = np.zeros((h, w), dtype=bool)
+    seeds[0, :] |= passable[0, :]
+    seeds[h - 1, :] |= passable[h - 1, :]
+    seeds[:, 0] |= passable[:, 0]
+    seeds[:, w - 1] |= passable[:, w - 1]
+    for r, c in np.argwhere(legend_mask):
+        rr, cc = int(r), int(c)
+        for dr, dc in DIR4:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc]:
+                seeds[nr, nc] = True
+    return seeds
