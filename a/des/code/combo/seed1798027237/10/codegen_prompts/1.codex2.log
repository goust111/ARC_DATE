+        top_color = rng.choice(top_color_choices or count_palette)
+        legend[0, pos : pos + length] = top_color
+        legend[1, pos : pos + length] = fill
+        mapping[length] = fill
+        pos += length
+        if idx != len(order) - 1:
+            pos += 1
