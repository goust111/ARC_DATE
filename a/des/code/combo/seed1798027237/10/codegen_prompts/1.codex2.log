+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+
+    halo_colors = {int(v) for v in np.unique(out[(grid == bg) & (out != bg)])}
+    if not halo_colors or not halo_colors.issubset(set(mapping.values())):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
