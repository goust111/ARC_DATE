+    seeds = np.zeros((h, w), dtype=bool)
+    seeds[0, :] = passable[0, :]
+    seeds[h - 1, :] = passable[h - 1, :]
+    seeds[:, 0] |= passable[:, 0]
+    seeds[:, w - 1] |= passable[:, w - 1]
+    outside = _reachable(passable, seeds)
+    interior = passable & (~outside)
+    cells = [tuple(map(int, pt)) for pt in np.argwhere(interior)]
+    if len(cells) < 1:
