 345: def _build_expected_output(pieces: list[dict], layout_h: int, layout_w: int,
 346:                            k: int, frame_color: int) -> np.ndarray:
 347:     """Assemble the expected output grid: frame_color background with pieces placed."""
 348:     out = np.full(((layout_h + 2) * k, (layout_w + 2) * k), frame_color, dtype=int)
 349:     for p in pieces:
 350:         coords = p["slot"]["coords"]
 351:         top = (int(coords[:, 0].min()) + 1) * k
 352:         left = (int(coords[:, 1].min()) + 1) * k
 353:         paste(out, p["out_patch"], top, left, mask=p["out_mask"], overwrite=True)
 354:     return out
