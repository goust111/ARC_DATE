   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Inflate a frame's hole-layout and fill each hole with its matching piece.
   9: 
  10:     Input structure:
  11:     - bg = most common color. Largest component is a monochrome frame enclosing bg holes.
  12:     - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.
  13: 
  14:     Rule:
  15:     - Extract connected hole regions inside the frame as slots.
  16:     - Match each piece to a slot by comparing block-level shapes under rotation/flip.
  17:     - Output the layout scaled by k, with pieces placed in slots; frame color as background.
  18: 
  19:     Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.
  20:     """
  21:     g = np.array(grid, dtype=int)
  22:     bg = int(get_bg(g))
  23: 
  24:     # --- find the largest connected component of foreground (multicolor) ---
  25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
  26:     assert not (not comps)
  27:     frame_comp = max(comps, key=lambda d: int(d["area"]))
  28:     fr0, fc0, fr1, fc1 = map(int, frame_comp["bbox"])
  29: 
  30:     # The frame is monochrome; use its dominant color as output background.
  31:     frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp["coords"]]
  32:     bgc = int(Counter(frame_cols).most_common(1)[0][0])
  33: 
  34:     # --- layout = bg holes inside the frame bbox, tight-cropped ---
  35:     sub = crop_bbox(g, (fr0, fc0, fr1, fc1))
  36:     hole = sub == int(bg)
  37:     hole_box = bbox(hole)
  38:     assert hole_box is not None, "frame must enclose at least one bg hole"
  39:     lr0, lc0, lr1, lc1 = map(int, hole_box)
  40:     layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]
  41: 
  42:     # --- slot components in the layout ---
  43:     slots = []
  44:     for coords in components_mask(layout, connectivity=4):
  45:         rr0, cc0, rr1, cc1 = bbox_coords(coords)
  46:         rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))
  47:         h = int(rr1 - rr0 + 1)
  48:         w = int(cc1 - cc0 + 1)
  49:         sm = np.zeros((h, w), dtype=bool)
  50:         sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True
  51:         slots.append({"area": int(sm.sum()), "r0": int(rr0), "c0": int(cc0), "mask": sm})
  52:     slots.sort(key=lambda s: (-int(s["area"]), int(s["r0"]), int(s["c0"])))
  53: 
  54:     assert slots, "frame must contain at least one slot"
  55: 
  56:     # --- pieces = non-singleton foreground components excluding the frame component ---
  57:     pieces = []
  58:     for comp in comps:
  59:         if comp is frame_comp:
  60:             continue
  61:         coords = comp["coords"]
  62:         if coords.size == 0 or int(coords.shape[0]) <= 1:
  63:             continue
  64:         pr0, pc0, pr1, pc1 = map(int, comp["bbox"])
  65:         patch = crop_bbox(g, (pr0, pc0, pr1, pc1))
  66:         ph, pw = map(int, patch.shape)
  67:         pm = np.zeros((ph, pw), dtype=bool)
  68:         pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True
  69:         pieces.append({"area": int(pm.sum()), "mask": pm, "patch": patch})
  70: 
  71:     assert pieces, "at least one non-frame piece must exist"
