 533: def _random_sprite_location(
 534:     static_blocked: np.ndarray, occupied: np.ndarray, sprite: np.ndarray
 535: ) -> tuple[int, int] | None:
 536:     """Find a random valid placement for sprite, avoiding blocked and occupied areas."""
 537:     h, w = sprite.shape
 538:     sprite_mask = sprite == GREY
 539:     occupied_pad = _dilate_mask(occupied != BG)
 540:     N = GRID_SIZE
 541:     candidates = [(r, c) for r in range(N - h + 1) for c in range(N - w + 1)]
 542:     random.shuffle(candidates)
 543:     for r, c in candidates:
 544:         rr0, cc0 = max(0, r - 1), max(0, c - 1)
 545:         rr1, cc1 = min(N, r + h + 1), min(N, c + w + 1)
 546:         if np.any(static_blocked[rr0:rr1, cc0:cc1] != BG):
 547:             continue
 548:         if np.any(occupied_pad[r : r + h, c : c + w] & sprite_mask):
 549:             continue
 550:         return int(r), int(c)
 551:     return None
