 214: def _make_frame(frame_size: int, hole_count: int, frame_color: int) -> np.ndarray | None:
 215:     """Build an input-style frame: solid frame_color square with `hole_count`
 216:     single-pixel bg cells scattered in interior (each 4-isolated)."""
 217:     frame = np.full((frame_size, frame_size), frame_color, dtype=int)
 218:     if hole_count == 0:
 219:         return frame
 220:     inner_cells = (frame_size - 2) ** 2
 221:     if inner_cells < hole_count:
 222:         return None
 223: 
 224:     seeds = _place_isolated_seeds(frame_size, hole_count)
 225:     if seeds is None:
 226:         return None
 227: 
 228:     for r, c in seeds:
 229:         frame[r, c] = BG
 230: 
 231:     _, num = label_mask(frame != frame_color, connectivity=4)
 232:     if num != hole_count:
 233:         return None
 234:     return frame
