 436: def _seal_and_connect(mask: np.ndarray, forbidden: set[tuple[int, int]]) -> np.ndarray:
 437:     """Seal gaps around forbidden cells and keep only the largest connected component."""
 438:     csz = mask.shape[0]
 439:     for _ in range(SEAL_ITERS):
 440:         sealed = False
 441:         for r, c in sorted(forbidden):
 442:             for nr, nc in neighbors4(r, c):
 443:                 if 0 <= nr < csz and 0 <= nc < csz and not mask[nr, nc] and (nr, nc) not in forbidden:
 444:                     mask[nr, nc] = True
 445:                     sealed = True
 446:         if not sealed:
 447:             break
 448:     if np.any(mask):
 449:         labeled, n_comp = label_mask(mask)
 450:         if n_comp > 1:
 451:             best = max(range(1, n_comp + 1), key=lambda l: int(np.sum(labeled == l)))
 452:             mask = labeled == best
 453:     return mask
 454: 
