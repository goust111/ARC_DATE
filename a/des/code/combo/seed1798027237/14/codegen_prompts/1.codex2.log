 237: def _legend(src: int, tgt: int) -> np.ndarray:
 238:     """Build a 3x4 legend block mapping src color to tgt color."""
 239:     return np.array(
 240:         [[src, src, tgt, tgt],
 241:          [src, src, src, tgt],
