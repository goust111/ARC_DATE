 162: def _make_sprite_interior(size: int, hole_count: int, sprite_color: int) -> np.ndarray | None:
 163:     """Build a size x size sprite with solid border and exactly `hole_count`
 164:     4-connected bg-hole components in the interior (grown from isolated seeds)."""
 165:     sprite = np.full((size, size), sprite_color, dtype=int)
 166:     if hole_count == 0:
 167:         return sprite
 168:     inner_cells = (size - 2) ** 2
 169:     if inner_cells < hole_count:
 170:         return None
 171: 
 172:     seeds = _place_isolated_seeds(size, hole_count)
 173:     if seeds is None:
 174:         return None
 175: 
 176:     # Initialize each component as its seed
 177:     comps: list[set[tuple[int, int]]] = [{s} for s in seeds]
 178:     all_hole = set(seeds)
 179:     for r, c in seeds:
 180:         sprite[r, c] = BG
 181: 
 182:     # Grow each component randomly; keep components 4-separated
 183:     max_grow = max(1, inner_cells // max(hole_count, 1) - 1)
 184:     for ci, comp in enumerate(comps):
 185:         grow = random.randint(0, min(max_grow, inner_cells - len(all_hole)))
 186:         for _ in range(grow):
 187:             frontier = []
 188:             for r, c in comp:
 189:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
 190:                     nr, nc = r + dr, c + dc
 191:                     if not (1 <= nr <= size - 2 and 1 <= nc <= size - 2):
 192:                         continue
 193:                     if (nr, nc) in all_hole:
 194:                         continue
 195:                     # Must not be 4-adjacent to any OTHER component
 196:                     if any((nr + dr2, nc + dc2) in other
 197:                            for j, other in enumerate(comps) if j != ci
 198:                            for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1), (0, 0)]):
 199:                         continue
 200:                     frontier.append((nr, nc))
 201:             if not frontier:
 202:                 break
 203:             cell = random.choice(frontier)
 204:             comp.add(cell)
 205:             all_hole.add(cell)
 206:             sprite[cell[0], cell[1]] = BG
 207: 
 208:     _, num = label_mask(sprite != sprite_color, connectivity=4)
 209:     if num != hole_count:
 210:         return None
 211:     return sprite
