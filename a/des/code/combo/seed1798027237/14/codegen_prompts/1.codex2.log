+    occupied: list[tuple[int, int, int, int]] = []
+    for spec in sorted(frame_specs, key=lambda item: -item["frame_patch"].size):
+        pos = _place_bbox(grid, spec["frame_patch"], occupied, pad=1, border=1, tries=250)
+        if pos is None:
