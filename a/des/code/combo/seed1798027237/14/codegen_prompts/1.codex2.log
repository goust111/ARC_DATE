 476: def _make_sprite(hole_count: int) -> np.ndarray | None:
 477:     """Generate a random amorphous grey sprite with the specified number of holes."""
 478:     for _ in range(SPRITE_RETRIES):
 479:         area = _sprite_area(hole_count)
 480:         csz = max(CANVAS_MIN, int(area ** 0.5 * CANVAS_SCALE) + CANVAS_PAD)
 481:         center = csz // 2
 482: 
 483:         forbidden = set()
 484:         if hole_count > 0:
 485:             seeds = _place_hole_seeds(hole_count, center, csz, area)
 486:             if seeds is None:
 487:                 continue
 488:             forbidden = _grow_hole_blobs(seeds, hole_count, area, csz)
 489: 
 490:         start = _find_start(center, csz, forbidden)
 491:         mask = _grow_mask(csz, area, start, forbidden)
 492:         mask = _seal_and_connect(mask, forbidden)
 493: 
 494:         result = _crop_and_validate(mask, forbidden, hole_count)
 495:         if result is not None:
 496:             return result
 497:     return None
