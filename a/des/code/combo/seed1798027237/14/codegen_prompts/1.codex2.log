 156: """Generator for ARC-AGI-2 task 898e7135.
 157: 
 158: Output-first strategy:
 159:   1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).
 160:   2. For each slot, pick a distinct color + dihedral transform; upscale slot mask
 161:      by k to get the piece sprite (solid k*k blocks).
 162:   3. Assemble the frame (layout + 1-cell border of frame_color).
 163:   4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel
 164:      distractor noise in a fresh color.
 165: 
 166: The generator validates main(input) == expected_output before returning.
 167: """
 168: 
 169: import random
 170: import numpy as np
 171: 
 172: from arc_utils import paste, random_free_location
 173: 
 174: # --- tunables ----------------------------------------------------------------
 175: 
 176: K_CHOICES = [2, 3]                  # block scale factor
 177: LAYOUT_H_RANGE = (4, 12)           # inner layout rows
 178: LAYOUT_W_RANGE = (4, 8)            # inner layout cols
 179: N_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)
 180: N_UNITS_MAX = 2                    # max unit-slot count per example
 181: NON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots
 182: 
 183: HOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area
 184: UNIT_SLOT_RETRIES = 20             # attempts per unit slot placement
 185: NON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement
 186: GROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call
 187: 
 188: CANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width
 189: AREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing
 190: AREA_BUFFER_CONST = 50             # additive constant for canvas area budget
 191: 
 192: DISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count
 193: DISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement
 194: MIN_DISTRACTORS = 8                # minimum placed distractors to accept
 195: 
 196: GENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input
