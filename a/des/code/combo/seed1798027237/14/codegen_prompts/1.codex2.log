 237: def _build_expected_output(frames, sprites, frame_colors, rows_grid, cols_grid,
 238:                            frame_size, sprite_size) -> np.ndarray:
 239:     """Build the expected output grid: frame borders with matched sprites nested inside."""
 240:     expected = np.full((rows_grid * frame_size, cols_grid * frame_size), BG, dtype=int)
 241:     sprite_by_k = {k: spatch for k, spatch in sprites}
 242:     for idx, (k, _) in enumerate(frames):
 243:         ri, ci = idx // cols_grid, idx % cols_grid
 244:         rr, cc = ri * frame_size, ci * frame_size
 245:         fc = frame_colors[idx]
 246:         expected[rr:rr + frame_size, cc:cc + frame_size] = fc
 247:         content = sprite_by_k[k].copy()
 248:         content[content == BG] = fc
 249:         expected[rr + 1:rr + 1 + sprite_size, cc + 1:cc + 1 + sprite_size] = content
 250:     return expected
