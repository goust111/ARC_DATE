+        spec["frame_pos"] = pos
+
+    sprite_places: list[tuple[int, int]] = []
+    for spec in frame_specs:
+        pos = _place_bbox(grid, spec["sprite_patch"], occupied, pad=1, border=1, tries=250)
+        if pos is None:
