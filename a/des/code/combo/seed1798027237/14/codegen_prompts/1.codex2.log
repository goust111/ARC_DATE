 350: def _place_hole_seeds(hole_count: int, center: int, csz: int, area: int) -> list[tuple[int, int]] | None:
 351:     """Find well-separated seed positions for holes inside the canvas.
 352: 
 353:     Returns a list of seed coordinates, or None if insufficient seeds found.
 354:     """
 355:     margin = HOLE_SEED_MARGIN
 356:     radius = max(HOLE_SEED_MIN_RADIUS, int(HOLE_SEED_RADIUS_FACTOR * area ** 0.5))
 357:     positions = [(r, c) for r in range(center - radius, center + radius + 1)
 358:                  for c in range(center - radius, center + radius + 1)
 359:                  if margin <= r < csz - margin and margin <= c < csz - margin]
 360:     random.shuffle(positions)
 361:     seeds = []
 362:     for r, c in positions:
 363:         if all(max(abs(r - sr), abs(c - sc)) >= HOLE_SEED_MIN_SEP for sr, sc in seeds):
 364:             seeds.append((r, c))
 365:             if len(seeds) == hole_count:
 366:                 return seeds
 367:     return None
