 328: def _make_bordered_frame(h: int, w: int, bg: int) -> np.ndarray:
 329:     """Create an h x w frame filled with bg and a 1-cell FRAME_COL border."""
 330:     frame = np.full((h, w), bg, dtype=int)
 331:     frame[0, :] = frame[-1, :] = FRAME_COL
 332:     frame[:, 0] = frame[:, -1] = FRAME_COL
 333:     return frame
