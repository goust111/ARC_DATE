 370: def _grow_hole_blobs(seeds: list[tuple[int, int]], hole_count: int,
 371:                      area: int, csz: int) -> set[tuple[int, int]]:
 372:     """Grow irregular blob regions around each hole seed. Returns the full forbidden set."""
 373:     margin = HOLE_SEED_MARGIN
 374:     max_hole = (max(2, area // (hole_count + 2)) if hole_count <= 2
 375:                 else max(1, area // (hole_count * 2 + 1)))
 376:     forbidden = set()
 377:     for sr, sc in seeds:
 378:         forbidden.add((sr, sc))
 379:         blob = {(sr, sc)}
 380:         target = random.randint(1, max(1, max_hole))
 381:         while len(blob) < target:
 382:             cands = []
 383:             for r, c in blob:
 384:                 for nr, nc in neighbors4(r, c):
 385:                     if not (margin <= nr < csz - margin and margin <= nc < csz - margin):
 386:                         continue
 387:                     if (nr, nc) in forbidden:
 388:                         continue
 389:                     if any((nnr, nnc) in forbidden and (nnr, nnc) not in blob
 390:                            for nnr, nnc in neighbors4(nr, nc)):
 391:                         continue
 392:                     cands.append((nr, nc))
 393:             if not cands:
 394:                 break
 395:             p = random.choice(cands)
 396:             forbidden.add(p)
 397:             blob.add(p)
 398:     return forbidden
