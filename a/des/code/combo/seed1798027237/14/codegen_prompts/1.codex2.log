 308: def _choose_empty_slots(
 309:     rows: int, cols: int, empty_count: int
 310: ) -> tuple[set[tuple[int, int]], list[tuple[int, int]]]:
 311:     """Choose which grid slots are empty, ensuring every row and column has at least one filled slot.
 312: 
 313:     Returns (empty_slots, shuffled filled_slots).
 314:     """
 315:     slots = [(r, c) for r in range(rows) for c in range(cols)]
 316:     valid = []
 317:     for combo in itertools.combinations(slots, empty_count):
 318:         empty = set(combo)
 319:         filled = [s for s in slots if s not in empty]
 320:         if len({r for r, _ in filled}) == rows and len({c for _, c in filled}) == cols:
 321:             valid.append(empty)
 322:     empty_slots = random.choice(valid)
 323:     filled_slots = [s for s in slots if s not in empty_slots]
 324:     random.shuffle(filled_slots)
 325:     return empty_slots, filled_slots
