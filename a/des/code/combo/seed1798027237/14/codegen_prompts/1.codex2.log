 336: def _place_patch(
 337:     grid: np.ndarray, reserve: np.ndarray, patch: np.ndarray, bg: int,
 338:     *, transparent: bool,
 339: ) -> bool:
 340:     """Find a free location for patch and paste it onto grid/reserve. Returns success."""
 341:     blocker = np.full(patch.shape, FRAME_COL, dtype=int)
 342:     try:
 343:         r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)
 344:     except ValueError:
 345:         return False
 346:     paste(reserve, blocker, r, c)
 347:     paste(grid, patch, r, c, transparent=bg if transparent else None)
 348:     return True
