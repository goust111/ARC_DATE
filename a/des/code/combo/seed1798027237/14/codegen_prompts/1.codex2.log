 245: def _sprite_mask(n: int) -> np.ndarray:
 246:     """Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX]."""
 247:     lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))
 248:     hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)
 249:     target = random.randint(lo, hi)
 250: 
 251:     # Seed: random walk column + one full row, then random orientation
 252:     mask = np.zeros((n, n), dtype=bool)
 253:     c = random.randrange(n)
 254:     for r in range(n):
 255:         c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))
 256:         mask[r, c] = True
 257:     mask[random.randrange(n), :] = True
 258: 
 259:     if random.random() < 0.5:
 260:         mask = mask.T.copy()
 261:     if random.random() < 0.5:
 262:         mask = np.flipud(mask)
 263:     if random.random() < 0.5:
 264:         mask = np.fliplr(mask)
 265: 
 266:     # Grow to target fill by adding random frontier cells
 267:     while int(mask.sum()) < target:
 268:         dilated = np.zeros_like(mask)
 269:         dilated[1:, :] |= mask[:-1, :]
 270:         dilated[:-1, :] |= mask[1:, :]
 271:         dilated[:, 1:] |= mask[:, :-1]
 272:         dilated[:, :-1] |= mask[:, 1:]
 273:         frontier = list(zip(*np.where(dilated & ~mask)))
 274:         r, c = random.choice(frontier)
 275:         mask[r, c] = True
 276:     return mask
