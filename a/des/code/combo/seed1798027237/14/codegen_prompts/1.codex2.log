 582: def _gen_attempt() -> np.ndarray | None:
 583:     """Single attempt: build layout, place sprites, validate via oracle."""
 584:     N = GRID_SIZE
 585:     grid = np.zeros((N, N), dtype=int)
 586:     expected = np.zeros((N, N), dtype=int)
 587:     blocked = np.zeros((N, N), dtype=int)
 588: 
 589:     legends = _add_layout(grid, blocked)
 590:     expected[:, :] = grid
 591:     if not _place_sprites(grid, expected, blocked, legends):
 592:         return None
 593:     if int(np.sum(grid == BG)) <= int(np.sum(grid == GREY)):
 594:         return None
 595:     if not np.array_equal(main(grid), expected):
 596:         return None
 597:     return grid
