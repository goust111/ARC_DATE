 528: def _dilate_mask(mask: np.ndarray) -> np.ndarray:
 529:     """8-connectivity dilation of a boolean mask (1-cell padding in all directions)."""
 530:     return binary_dilation(mask, structure=_STRUCT8).astype(bool)
