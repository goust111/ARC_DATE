 554: def _place_sprites(
 555:     grid: np.ndarray, expected: np.ndarray, blocked: np.ndarray, legends: list[tuple[int, int]]
 556: ) -> bool:
 557:     """Generate and place all sprites (matches + distractors) onto the grid."""
 558:     items = []
 559:     for hole_count, color in _sprite_plan(legends):
 560:         sprite = _make_sprite(hole_count)
 561:         if sprite is None:
 562:             return False
 563:         items.append((sprite.size, sprite, color))
 564:     items.sort(key=lambda x: x[0], reverse=True)
 565: 
 566:     occupied = np.zeros_like(grid)
 567:     for _, sprite, color in items:
 568:         loc = _random_sprite_location(blocked, occupied, sprite)
 569:         if loc is None:
 570:             return False
 571:         r, c = loc
 572:         paste(grid, sprite, r, c, transparent=BG)
 573:         paste(occupied, sprite, r, c, transparent=BG)
 574:         if color is not None:
 575:             out_patch = np.where(sprite == GREY, int(color), BG)
 576:             paste(expected, out_patch, r, c, transparent=BG)
 577:     return True
