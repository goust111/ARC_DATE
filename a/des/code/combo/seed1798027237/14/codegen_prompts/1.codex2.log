 401: def _find_start(center: int, csz: int, forbidden: set[tuple[int, int]]) -> tuple[int, int]:
 402:     """Find the nearest non-forbidden cell to the canvas center."""
 403:     if (center, center) not in forbidden:
 404:         return center, center
 405:     for d in range(1, csz):
 406:         for dr in range(-d, d + 1):
 407:             for dc in range(-d, d + 1):
 408:                 nr, nc = center + dr, center + dc
 409:                 if 0 <= nr < csz and 0 <= nc < csz and (nr, nc) not in forbidden:
 410:                     return nr, nc
 411:     return center, center  # fallback (shouldn't happen)
