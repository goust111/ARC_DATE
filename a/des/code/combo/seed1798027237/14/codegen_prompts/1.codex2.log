 456: def _crop_and_validate(mask: np.ndarray, forbidden: set[tuple[int, int]],
 457:                        hole_count: int) -> np.ndarray | None:
 458:     """Crop mask to tight bbox (including forbidden cells), validate shape and holes."""
 459:     pts = np.argwhere(mask)
 460:     if len(pts) == 0:
 461:         return None
 462:     rmin, cmin = pts.min(axis=0)
 463:     rmax, cmax = pts.max(axis=0)
 464:     for r, c in forbidden:
 465:         rmin, cmin = min(rmin, r), min(cmin, c)
 466:         rmax, cmax = max(rmax, r), max(cmax, c)
 467:     h, w = rmax - rmin + 1, cmax - cmin + 1
 468:     if h > SPRITE_MAX_H or w > SPRITE_MAX_W or max(h, w) > SPRITE_MAX_ASPECT * min(h, w):
 469:         return None
 470:     cropped = mask[rmin:rmax + 1, cmin:cmax + 1].copy()
 471:     if _hole_count(cropped) != hole_count:
 472:         return None
 473:     return np.where(cropped, GREY, BG).astype(int)
