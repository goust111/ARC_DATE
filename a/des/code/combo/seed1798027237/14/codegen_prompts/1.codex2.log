+        side = sides[i]
+        gap_len = gap_lengths[i]
+        frame_patch, gap_rel, frag_rel = _make_frame_patch(
+            int(frame_colors[i]),
+            int(frag_colors[i]),
+            fh,
+            fw,
+            side,
+            gap_len,
+        )
+        frame_specs.append(
+            {
