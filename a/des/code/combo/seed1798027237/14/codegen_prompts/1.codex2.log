 279: def _colored_sprite(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
 280:     """Render a binary mask as a colored sprite on bg."""
 281:     out = np.full(mask.shape, bg, dtype=int)
 282:     out[mask] = int(color)
 283:     return out
