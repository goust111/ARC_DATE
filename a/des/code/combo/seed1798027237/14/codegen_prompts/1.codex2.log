 502: def _sprite_plan(legends: list[tuple[int, int]]) -> list[tuple[int, int | None]]:
 503:     """Build a shuffled list of (hole_count, color_or_None) for all sprites to generate."""
 504:     total = random.randint(*TOTAL_SPRITES_RANGE)
 505:     remaining = total - len(legends)
 506:     max_d = min(MAX_DISTRACTORS, remaining)
 507:     valid_d = [d for d in range(1, max_d + 1)
 508:                if remaining - d <= MAX_EXTRA_PER_LEGEND * len(legends)]
 509:     n_distractors = random.choice(valid_d)
 510:     extra_matches = remaining - n_distractors
 511:     extras = [0] * len(legends)
 512:     for _ in range(extra_matches):
 513:         choices = [i for i, x in enumerate(extras) if x < MAX_EXTRA_PER_LEGEND]
 514:         extras[random.choice(choices)] += 1
 515: 
 516:     plan = []
 517:     for i, (hole_count, color) in enumerate(legends):
 518:         for _ in range(1 + extras[i]):
 519:             plan.append((hole_count, color))
 520:     legend_holes = {h for h, _ in legends}
 521:     distractor_holes = [h for h in range(MAX_HOLE_COUNT) if h not in legend_holes]
 522:     for _ in range(n_distractors):
 523:         plan.append((random.choice(distractor_holes), None))
 524:     random.shuffle(plan)
 525:     return plan
