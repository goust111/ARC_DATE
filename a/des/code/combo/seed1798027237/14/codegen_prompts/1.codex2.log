 286: def _content_extent(n: int, grid_rows: int, grid_cols: int) -> tuple[int, int]:
 287:     """Content area needed for grid_rows x grid_cols of NxN blocks with 1-cell gaps."""
 288:     return (grid_rows * n + grid_rows - 1, grid_cols * n + grid_cols - 1)
