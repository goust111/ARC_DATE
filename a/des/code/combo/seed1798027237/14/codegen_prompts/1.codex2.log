 340: def _sprite_area(hole_count: int) -> int:
 341:     """Sample a random sprite area based on hole count."""
 342:     if hole_count == 0:
 343:         return random.randint(*SPRITE_AREA_0)
 344:     elif hole_count <= 2:
 345:         return random.randint(SPRITE_AREA_LOW_MIN, 25 + 10 * hole_count)
 346:     else:
 347:         return random.randint(10 + 2 * hole_count, 20 + 4 * hole_count)
