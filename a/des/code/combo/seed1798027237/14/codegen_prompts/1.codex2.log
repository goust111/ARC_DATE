 414: def _grow_mask(csz: int, area: int, start: tuple[int, int],
 415:                forbidden: set[tuple[int, int]]) -> np.ndarray:
 416:     """Grow a random connected blob of target area, avoiding forbidden cells."""
 417:     mask = np.zeros((csz, csz), dtype=bool)
 418:     sr, sc = start
 419:     mask[sr, sc] = True
 420:     frontier = list(neighbors4(sr, sc))
 421:     filled = 1
 422:     while filled < area and frontier:
 423:         idx = random.randrange(len(frontier))
 424:         frontier[idx], frontier[-1] = frontier[-1], frontier[idx]
 425:         r, c = frontier.pop()
 426:         if not (0 <= r < csz and 0 <= c < csz) or mask[r, c] or (r, c) in forbidden:
 427:             continue
 428:         mask[r, c] = True
 429:         filled += 1
 430:         for nr, nc in neighbors4(r, c):
 431:             if 0 <= nr < csz and 0 <= nc < csz and not mask[nr, nc]:
 432:                 frontier.append((nr, nc))
 433:     return mask
