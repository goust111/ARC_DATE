 291: def _choose_structure() -> tuple[int, int, int, int, int] | None:
 292:     """Pick (n, rows, cols, empty_count, total) satisfying frame size constraints."""
 293:     total = random.randint(*TOTAL_BLOCKS_RANGE)
 294:     options = []
 295:     for n in range(*SPRITE_N_RANGE):
 296:         for rows in range(*GRID_ROWS_RANGE):
 297:             for cols in range(*GRID_COLS_RANGE):
 298:                 ch, cw = _content_extent(n, rows, cols)
 299:                 base_fh = ch + 4  # +2 border +2 min margin
 300:                 base_fw = cw + 4
 301:                 slots = rows * cols
 302:                 empty = slots - total
 303:                 if base_fh <= MAX_FRAME_DIM and base_fw <= MAX_FRAME_DIM and 0 <= empty <= MAX_EMPTY_SLOTS:
 304:                     options.append((n, rows, cols, empty, total))
 305:     return random.choice(options) if options else None
