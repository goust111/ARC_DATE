 183: def _frame_ring_coords(r0, c0, ch, cw):
 184:     """Return (ring_coords, cavity_coords) for a rounded-rect frame.
 185: 
 186:     Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).
 187:     Ring = bbox boundary minus 4 corners.
 188:     """
 189:     H, W = ch + 2, cw + 2
 190:     ring = []
 191:     for dr in range(H):
 192:         for dc in range(W):
 193:             on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)
 194:             corner = (dr in (0, H - 1)) and (dc in (0, W - 1))
 195:             if on_bdr and not corner:
 196:                 ring.append((r0 + dr, c0 + dc))
 197:     cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]
 198:     return ring, cavity
