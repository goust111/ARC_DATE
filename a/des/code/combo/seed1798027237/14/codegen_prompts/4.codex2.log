+def _removable_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    removable: list[tuple[int, int]] = []
+    for r, c in zip(*np.nonzero(mask)):
+        trial = mask.copy()
+        trial[r, c] = False
+        if trial.sum() >= 5 and _preserves_full_bbox(trial) and _mask_connected(trial):
