+BLACK = 0
+GREY = 5
+PATH_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MIN_GRID_SIZE = 14
+MAX_GRID_SIZE = 22
+MIN_GAP = 3
+MAX_HORIZONTAL_PATHS = 3
+MAX_VERTICAL_PATHS = 3
+MAX_EXTRA_PATHS = 2
