+def _hole_shape_is_valid(mask: np.ndarray) -> bool:
+    if not bool(mask.any()):
+        return False
+    if len(_components(mask)) != 1:
+        return False
+    comp_false = _components(~mask)
+    h, w = mask.shape
+    for comp in comp_false:
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
