+def _nearest_side(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    h, w = shape
+    dists = {
+        "top": int(r0),
+        "bottom": int(h - 1 - r1),
+        "left": int(c0),
+        "right": int(w - 1 - c1),
+    }
+    best = min(dists.values())
+    sides = [side for side, dist in dists.items() if dist == best]
+    assert len(sides) == 1, "rectangle must be uniquely closest to one boundary"
+    return sides[0]
+
+
+def _hole_shape(region: np.ndarray, bg: int) -> np.ndarray:
+    bg_mask = region == bg
