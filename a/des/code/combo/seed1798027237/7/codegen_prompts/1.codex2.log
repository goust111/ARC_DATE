+    return True
+
+
+def _inflate_bbox_mask(n: int, bbox: tuple[int, int, int, int], pad: int = 1) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((n, n), dtype=bool)
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(n - 1, r1 + pad)
+    cc1 = min(n - 1, c1 + pad)
+    mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+    return mask
