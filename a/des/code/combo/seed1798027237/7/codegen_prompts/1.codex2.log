+    rect_mask = _inflate_bbox_mask(n, rect_bbox, pad=1)
+    stamp_mask = _inflate_bbox_mask(n, stamp_bbox, pad=1)
+    return not bool(np.any(blocked & (rect_mask | stamp_mask)))
