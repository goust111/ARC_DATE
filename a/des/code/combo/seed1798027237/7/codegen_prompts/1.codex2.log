+                    "bbox": bbox,
+                    "color": int(color),
+                    "hole": hole.copy(),
+                    "side": side,
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+
+    expected = _expected_output(grid, objects)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if np.array_equal(actual, expected):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

