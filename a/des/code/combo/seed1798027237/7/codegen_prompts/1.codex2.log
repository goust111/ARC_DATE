+RAW_HOLE_SIDE_RANGE = (1, 5)
+RECT_MARGIN_RANGE = (1, 3)
+HOLE_GAP_EXTRA_RANGE = (0, 2)
+PLACEMENT_ATTEMPTS = 240
+GENERATION_ATTEMPTS = 400
