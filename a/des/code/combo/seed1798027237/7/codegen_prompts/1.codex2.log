+            return None
+        r0 = gap if side == "top" else n - gap - rect_h
+        c0 = random.randint(0, n - rect_w)
+    else:
+        gap = random.randint(hw + HOLE_GAP_EXTRA_RANGE[0], hw + HOLE_GAP_EXTRA_RANGE[1])
+        if rect_h > n or gap + rect_w > n:
+            return None
+        r0 = random.randint(0, n - rect_h)
