+    for comp in _components(g != bg):
+        r0, c0, r1, c1 = _bbox(comp)
+        region = g[r0 : r1 + 1, c0 : c1 + 1]
+        colors = set(map(int, region[region != bg].tolist()))
+        assert len(colors) == 1, "each component must be monochrome"
+        color = int(next(iter(colors)))
