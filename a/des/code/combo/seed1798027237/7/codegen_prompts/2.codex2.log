+            vertical_side = "top"
+            far_r = int(vseg["r1"])
+        else:
+            assert inter_r > int(vseg["r1"])
+            vertical_side = "bottom"
+            far_r = int(vseg["r0"])
+
+        if inter_c < int(hseg["c0"]):
+            horizontal_side = "left"
+            far_c = int(hseg["c1"])
