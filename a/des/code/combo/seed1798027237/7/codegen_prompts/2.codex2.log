+    candidates: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            vals = [
+                int(grid[r, c]),
+                int(grid[r, c + 1]),
+                int(grid[r + 1, c]),
+                int(grid[r + 1, c + 1]),
+            ]
+            if BG in vals or len(set(vals)) != 4:
+                continue
+            if any(counts[v] != 1 for v in vals):
+                continue
+            candidates.append((r, c))
+    assert len(candidates) == 1, "expected a unique 2x2 palette"
+    r, c = candidates[0]
+    return {
+        "ul": int(grid[r, c]),
+        "ur": int(grid[r, c + 1]),
+        "ll": int(grid[r + 1, c]),
+        "lr": int(grid[r + 1, c + 1]),
+    }
