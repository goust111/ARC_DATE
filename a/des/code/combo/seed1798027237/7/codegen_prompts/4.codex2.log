+        coords = np.array(comp, dtype=int)
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        border = _border_set(r0, c0, r1, c1)
+        if len(comp) != len(border) or set(comp) != border:
