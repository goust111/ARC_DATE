+    r0, c0, r1, c1 = bbox
+    distances = [
+        ("top", int(sr - r0)),
+        ("bottom", int(r1 - sr)),
+        ("left", int(sc - c0)),
+        ("right", int(c1 - sc)),
+    ]
+    distances.sort(key=lambda item: (item[1], SIDES.index(item[0])))
+    return distances[0][0]
+
