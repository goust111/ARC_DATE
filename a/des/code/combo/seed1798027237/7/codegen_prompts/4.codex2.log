+            blk_r0_lo = max(0, line - (blk_h - 2))
+            blk_r0_hi = min(h - blk_h, line - 1)
+            if blk_r0_lo > blk_r0_hi:
+                continue
+            blk_r0 = random.randint(blk_r0_lo, blk_r0_hi)
+            sep = random.randint(1, w - src_w - src_c0 - blk_w)
+            blk_c0 = src_c0 + src_w + sep
