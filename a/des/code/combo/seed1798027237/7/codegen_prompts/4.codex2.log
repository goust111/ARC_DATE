+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        border = _border_set(r0, c0, r1, c1)
+        if len(comp) != len(border) or set(comp) != border:
+            continue
+        inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+        if inner.size == 0 or bool(np.any(inner == FRAME)):
