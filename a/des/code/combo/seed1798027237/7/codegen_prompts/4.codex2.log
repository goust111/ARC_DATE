                "forced_line": None,
                "forbid_sides": {OPPOSITE_SIDE[side]},
                "prefer": "boundary",
                "role": "blocker",
            }
        )
        return True
    return False


def _try_add_free_frame(h: int, w: int, specs: list[dict]) -> bool:
    for _ in range(PLACEMENT_TRIES):
        fh, fw = _random_size()
        r0 = random.randint(0, h - fh)
        c0 = random.randint(0, w - fw)
        box = (r0, c0, r0 + fh - 1, c0 + fw - 1)
