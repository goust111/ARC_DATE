        random.randint(*FRAME_SIZE_RANGE),
    )


def _sample_line_for_source(box: tuple[int, int, int, int], side: str) -> int | None:
    r0, c0, r1, c1 = box
    if side in ("top", "bottom"):
        lo, hi = c0 + 2, c1 - 2
    else:
        lo, hi = r0 + 2, r1 - 2
    if lo > hi:
        return None
    return random.randint(lo, hi)


