            blk_r1 = src_r0 - sep - 1
            blk_r0 = blk_r1 - blk_h + 1
            blk_box = (blk_r0, blk_c0, blk_r1, blk_c0 + blk_w - 1)
        elif side == "bottom":
            max_sep_room = h - src_h - blk_h - 1
            if max_sep_room < 0:
                continue
            src_r0 = random.randint(0, max_sep_room)
