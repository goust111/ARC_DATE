+                "bottom": int(r1 - sr),
+                "left": int(sc - c0),
+                "right": int(c1 - sc),
+            }
+            best_d = min(distances.values())
+            best_sides = [side for side, dist in distances.items() if dist == best_d]
+            if len(best_sides) != 1:
+                continue
+            side = best_sides[0]
+            if side in forbid_sides:
