+def _border_set(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((int(r0), int(c)))
+        cells.add((int(r1), int(c)))
+    for r in range(r0 + 1, r1):
+        cells.add((int(r), int(c0)))
+        cells.add((int(r), int(c1)))
+    return cells
