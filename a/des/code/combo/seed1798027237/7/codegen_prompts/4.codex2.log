+    gap_r, gap_c = _gap_cell(bbox, side, sr, sc)
+    dr, dc = DIR_BY_SIDE[side]
+    rr, cc = gap_r + dr, gap_c + dc
+    ray: list[tuple[int, int]] = []
+    while 0 <= rr < h and 0 <= cc < w:
+        if (rr, cc) in grey_cells:
+            return ray, "blocked"
+        ray.append((int(rr), int(cc)))
+        rr += dr
