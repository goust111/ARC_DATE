+# --------------- generator ---------------
+
+GRID_H_RANGE = (14, 24)
+GRID_W_RANGE = (14, 24)
+FRAME_SIZE_RANGE = (5, 9)  # outer size
+FRAME_COUNT_CHOICES = (1, 2, 3, 4, 5)
+FRAME_COUNT_WEIGHTS = (1, 2, 3, 3, 2)
+PAIR_COUNT_BY_MAX = {
+    0: ((0,), (1,)),
+    1: ((0, 1), (2, 3)),
+    2: ((0, 1, 2), (2, 4, 1)),
+}
+PLACEMENT_TRIES = 120
+GEN_RETRIES = 500
