+            src_r0 = random.randint(0, max_sep_room)
+            src_c0 = random.randint(0, w - src_w)
+            src_box = (src_r0, src_c0, src_r0 + src_h - 1, src_c0 + src_w - 1)
+            line = _sample_line_for_source(src_box, side)
+            if line is None:
