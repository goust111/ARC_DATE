+        for dr, dc in ARROW_TEMPLATES[direction]:
+            rr = r0 + dr
+            cc = c0 + dc
+            if int(grid[rr, cc]) != BG_COLOR:
+                return None
+            grid[rr, cc] = color
+
+    if not _validate_generated(grid, expected):
+        return None
+
+    return grid
+
