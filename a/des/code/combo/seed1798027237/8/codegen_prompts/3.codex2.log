+def _is_simple_path(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+
+    points = {tuple(map(int, coord)) for coord in coords}
+    start = next(iter(points))
+    stack = [start]
+    seen = {start}
