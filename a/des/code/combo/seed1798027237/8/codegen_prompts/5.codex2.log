+            r0, c0, r1, c1 = box
+            or0, oc0, or1, oc1 = other["bbox"]
+            if or0 < r0 and oc0 < c0 and or1 > r1 and oc1 > c1:
+                area = _bbox_area(other["bbox"])
+                if parent_area is None or area < parent_area:
