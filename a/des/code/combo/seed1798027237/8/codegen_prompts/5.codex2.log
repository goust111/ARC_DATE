+            }
+        )
+
+    assert rectangles, "expected at least one rectangle"
+
+    for i, rect in enumerate(rectangles):
+        box = rect["bbox"]
+        parent_idx = None
+        parent_area = None
+        for j, other in enumerate(rectangles):
+            if i == j:
