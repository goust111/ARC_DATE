+# ARC colors used by the puzzle description.
+BG = 0
+RECT = 5
+SEED = 9
+LEGEND_COLORS = (1, 2, 3, 4, 7)  # blue, red, green, yellow, orange
+
+
+# Generator configuration.
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 32)
