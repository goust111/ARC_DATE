+
+
+def _min_side_for_depth(depth: int) -> int:
+    return MIN_LEAF_SIDE + 4 * (depth - 1)
+
+
+def _boxes_too_close(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    margin: int,
