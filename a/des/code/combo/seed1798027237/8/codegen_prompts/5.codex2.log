+
+
+def _visible_cells(
+    box: tuple[int, int, int, int],
+    child_boxes: list[tuple[int, int, int, int]],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells: list[tuple[int, int]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
