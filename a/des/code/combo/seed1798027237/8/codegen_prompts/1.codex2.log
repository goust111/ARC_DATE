+def _shape_el(rng: random.Random) -> np.ndarray:
+    h = rng.randint(2, 5)
+    w = rng.randint(2, 5)
+    mask = np.zeros((h, w), dtype=bool)
+    corner = rng.choice(((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)))
+    if corner[1] == 0:
+        mask[:, 0] = True
+    else:
+        mask[:, -1] = True
+    if corner[0] == 0:
+        mask[0, :] = True
+    else:
