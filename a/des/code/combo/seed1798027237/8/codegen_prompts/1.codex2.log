+    if len(pts) == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    q = deque([tuple(map(int, pts[0]))])
+    seen[q[0]] = True
+    count = 0
+    while q:
+        r, c = q.popleft()
+        count += 1
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
