+        cell = rng.choice(tuple(frontier))
+        nbrs = []
+        for dr, dc in NEIGHBORS4:
+            nr, nc = cell[0] + dr, cell[1] + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                nbrs.append((nr, nc))
+        if nbrs:
+            nxt = rng.choice(nbrs)
+            mask[nxt] = True
+            frontier.add(nxt)
+        else:
+            frontier.remove(cell)
