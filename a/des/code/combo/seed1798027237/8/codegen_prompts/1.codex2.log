+    n = len(sizes)
+    row_count = rng.randint(1, min(n, 3 if n >= 4 else 2))
+    order = list(range(n))
+    rng.shuffle(order)
+    rows = [[] for _ in range(row_count)]
+    for i, idx in enumerate(order):
+        rows[i % row_count].append(idx)
+    for row in rows:
+        rng.shuffle(row)
