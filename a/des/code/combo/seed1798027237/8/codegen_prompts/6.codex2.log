+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+SHADOW_COLOR = 5
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIRECTIONS = ("up", "down", "left", "right")
+INPUT_COLORS = tuple(color for color in range(10) if color != SHADOW_COLOR)
