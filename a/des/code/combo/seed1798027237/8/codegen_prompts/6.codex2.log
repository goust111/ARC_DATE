+        corridor = {
+            (r, c) for r in range(height, height - 1 + distance + 1) for c in range(width)
+        }
+
+    shadow = set(_shadow_cells(cells, direction))
+    colored = set(cells) | {marker}
+    required = set(cells) | corridor
+    protected = colored | shadow
+
+    return {
+        "color": color,
+        "cells": set(cells),
+        "marker": marker,
+        "direction": direction,
+        "required": required,
+        "protected": protected,
