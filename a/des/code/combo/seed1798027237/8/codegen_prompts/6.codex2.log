+
+
+# --------------- generator ---------------
+
+GRID_MIN_SIDE = 11
+GRID_MAX_SIDE = 24
+OBJECT_COUNT_MIN = 1
+OBJECT_COUNT_MAX = 4
+SHAPE_SIDE_MIN = 2
+SHAPE_SIDE_MAX = 5
+SHAPE_AREA_MIN = 3
+MARKER_DIST_MIN = 2
+MARKER_DIST_MAX = 4
+GEN_MAX_ATTEMPTS = 400
+SHAPE_MAX_ATTEMPTS = 200
