+def _unfolded_arrow_cells(
+    shaft_front: tuple[int, int],
+    direction: tuple[int, int],
+    shaft_len: int,
+) -> set[tuple[int, int]]:
+    arrow_cells, shaft, tip = _arrow_cells(shaft_front, direction, shaft_len)
+    pr, pc = _perp(direction)
+    out = {tip}
