+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return mask[:0, :0].copy(), (0, 0, -1, -1)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
