+        return int(RNG.integers(20, 27)), int(RNG.integers(20, 27))
+    if frame_count == 2:
+        return int(RNG.integers(24, 31)), int(RNG.integers(24, 31))
+    return int(RNG.integers(28, 35)), int(RNG.integers(28, 35))
