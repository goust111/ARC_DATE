+        colors, counts = np.unique(patch[local_mask], return_counts=True)
+        base_color = int(colors[np.argmax(counts)])
+        marker_pts = []
+        marker_colors = []
+        for rr, cc in np.argwhere(local_mask):
+            color = int(patch[rr, cc])
+            if color != base_color:
