+            {
+                "patch": patch,
+                "mask": local_mask,
+                "bbox": (r0, c0, r1, c1),
+                "base_color": base_color,
+                "marker_points": marker_pts,
+                "marker_colors": marker_colors,
+                "canon": _canonical_shape(local_mask),
