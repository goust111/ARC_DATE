+
+def _adjacent_to_mask(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        for dr, dc in ORTHO_DIRS:
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w:
