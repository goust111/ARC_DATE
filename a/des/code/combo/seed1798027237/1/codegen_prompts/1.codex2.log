+        row_off = 0
+        col_off = int(RNG.integers(1, frame_w - gw))
+    elif side == "bottom":
+        row_off = frame_h - gh
+        col_off = int(RNG.integers(1, frame_w - gw))
+    elif side == "left":
+        row_off = int(RNG.integers(1, frame_h - gh))
+        col_off = 0
+    else:
+        row_off = int(RNG.integers(1, frame_h - gh))
