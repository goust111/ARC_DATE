+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                src_r0 = max(0, -dr)
+                src_r1 = mask.shape[0] - max(0, dr)
+                src_c0 = max(0, -dc)
+                src_c1 = mask.shape[1] - max(0, dc)
+                dst_r0 = max(0, dr)
+                dst_r1 = dst_r0 + (src_r1 - src_r0)
+                dst_c0 = max(0, dc)
+                dst_c1 = dst_c0 + (src_c1 - src_c0)
