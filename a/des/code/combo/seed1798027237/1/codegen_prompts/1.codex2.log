+                dst_r1 = dst_r0 + (src_r1 - src_r0)
+                dst_c0 = max(0, dc)
+                dst_c1 = dst_c0 + (src_c1 - src_c0)
+                grown[dst_r0:dst_r1, dst_c0:dst_c1] |= out[src_r0:src_r1, src_c0:src_c1]
+        out = grown
+    return out
