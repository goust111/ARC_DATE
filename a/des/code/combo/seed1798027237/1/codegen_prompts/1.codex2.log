+
+def _crop_patch(patch: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    cropped_mask, (r0, c0, r1, c1) = _crop_mask(mask)
+    return patch[r0 : r1 + 1, c0 : c1 + 1].copy(), cropped_mask
