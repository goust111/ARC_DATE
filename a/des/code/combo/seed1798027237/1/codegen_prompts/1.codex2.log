+
+def _rotate_coords(points: list[tuple[int, int]], k: int) -> list[tuple[int, int]]:
+    mask = _mask_from_points(points).astype(int)
+    rotated = np.rot90(mask, k=k) > 0
+    return [(int(r), int(c)) for r, c in np.argwhere(rotated)]
