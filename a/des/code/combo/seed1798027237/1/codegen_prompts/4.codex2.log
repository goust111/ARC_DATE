+        rows = pts[:, 0]
+        cols = pts[:, 1]
+        touches_border = bool(
+            np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1))
+        )
+        if not touches_border:
+            holes += 1
+    return holes
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    comps = _components_of_mask(mask)
+    return len(comps) == 1
+
+
+def _core_pixel_count(mask: np.ndarray) -> int:
+    h, w = map(int, mask.shape)
+    if h < 3 or w < 3:
+        return 0
