+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not ext[r, c]:
+                ext[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not ext[r, c]:
+                ext[r, c] = True
+                stack.append((r, c))
