+def _components_of_mask(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components of a boolean mask as coordinate arrays."""
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
