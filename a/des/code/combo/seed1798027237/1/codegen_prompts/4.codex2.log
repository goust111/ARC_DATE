+        cols = pts[:, 1]
+        touches_box = bool(
+            np.any((rows == 0) | (rows == sub.shape[0] - 1) | (cols == 0) | (cols == sub.shape[1] - 1))
+        )
+        if touches_box:
+            continue
+        adjacent_colors: set[int] = set()
+        for rr, cc in pts:
+            for dr, dc in DIR4:
+                nr, nc = int(rr + dr), int(cc + dc)
+                if 0 <= nr < sub.shape[0] and 0 <= nc < sub.shape[1]:
+                    v = int(sub[nr, nc])
+                    if v != 0:
+                        adjacent_colors.add(v)
+        if adjacent_colors == {int(color)}:
+            holes += 1
