+def _count_mask_holes(mask: np.ndarray) -> int:
+    h, w = map(int, mask.shape)
+    holes = 0
+    for pts in _components_of_mask(~mask):
+        rows = pts[:, 0]
+        cols = pts[:, 1]
+        touches_border = bool(
+            np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1))
+        )
+        if not touches_border:
+            holes += 1
+    return holes
