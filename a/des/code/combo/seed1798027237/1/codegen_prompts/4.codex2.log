+        if adjacent_colors == {int(color)}:
+            holes += 1
+    return holes
+
+
+def _boundary_pixels(grid: np.ndarray, coords: np.ndarray) -> list[tuple[int, int]]:
+    """Return component pixels 4-adjacent to black."""
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    boundary: list[tuple[int, int]] = []
+    for r, c in coords:
