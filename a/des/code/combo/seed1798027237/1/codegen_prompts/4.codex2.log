+def _exterior_background(mask: np.ndarray) -> np.ndarray:
+    h, w = map(int, mask.shape)
+    bg = ~mask
+    ext = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not ext[r, c]:
+                ext[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not ext[r, c]:
+                ext[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not ext[nr, nc]:
+                ext[nr, nc] = True
+                stack.append((nr, nc))
+    return ext
+
+
+def _outer_boundary_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = map(int, mask.shape)
+    ext = _exterior_background(mask)
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w):
+                    cells.append((r, c))
+                    break
+                if ext[nr, nc]:
+                    cells.append((r, c))
+                    break
+    return cells
+
+
+def _exterior_growth_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = map(int, mask.shape)
+    ext = _exterior_background(mask)
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not ext[r, c]:
+                continue
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
