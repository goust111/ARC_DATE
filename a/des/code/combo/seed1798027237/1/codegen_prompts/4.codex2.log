+def _core_pixel_count(mask: np.ndarray) -> int:
+    h, w = map(int, mask.shape)
+    if h < 3 or w < 3:
+        return 0
+    core = mask[1:-1, 1:-1].copy()
+    core &= mask[:-2, 1:-1]
+    core &= mask[2:, 1:-1]
+    core &= mask[1:-1, :-2]
+    core &= mask[1:-1, 2:]
