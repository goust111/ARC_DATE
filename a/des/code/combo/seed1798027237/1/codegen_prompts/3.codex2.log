+
+    top = r0 == 0
+    bottom = r1 == height - 1
+    left = c0 == 0
+    right = c1 == width - 1
+    assert top != bottom and left != right, "seed must occupy exactly one corner"
+
+    if top and left:
+        corner = "tl"
+    elif top and right:
+        corner = "tr"
+    elif bottom and left:
+        corner = "bl"
+    else:
