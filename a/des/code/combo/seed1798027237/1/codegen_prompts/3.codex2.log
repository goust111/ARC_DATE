+    colors = set(map(int, np.unique(region[mask])))
+    assert len(colors) == 1, "each region must use one seed color"
+
+    coords = np.argwhere(mask)
+    r0, c0 = map(int, coords.min(axis=0))
+    r1, c1 = map(int, coords.max(axis=0))
