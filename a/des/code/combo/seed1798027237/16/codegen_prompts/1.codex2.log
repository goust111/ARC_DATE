+        "holes": norm_holes,
+        "height": height,
+        "width": width,
+        "signature": signature,
+    }
+
+
+def _place_region(
+    grid: np.ndarray,
+    forbidden: np.ndarray,
+    region: dict[str, object],
+    color: int,
+    min_row: int,
