+        exterior = _exterior_background_mask(g, component_mask, bg)
+        halo = np.zeros_like(component_mask, dtype=bool)
+        for r, c in coords.tolist():
+            for dr, dc in DIR4:
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and exterior[nr, nc]:
+                    halo[nr, nc] = True
+        out[halo] = halo_color
+
+    return out
