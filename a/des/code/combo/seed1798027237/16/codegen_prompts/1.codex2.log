+    norm_cells = sorted((r - min_r, c - min_c) for r, c in cells)
+    norm_holes = sorted((r - min_r, c - min_c) for r, c in holes)
+    height = max(r for r, _ in norm_cells) + 1
+    width = max(c for _, c in norm_cells) + 1
