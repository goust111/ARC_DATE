+        if random.random() < 0.5:
+            patch = patch.T
+        if random.random() < 0.5:
+            patch = np.flipud(patch)
+        if random.random() < 0.5:
+            patch = np.fliplr(patch)
+        if len(_corner_positions(patch)) == turns:
+            return patch
+    raise RuntimeError("failed to construct a valid polyline patch")
