+COLOR_POOL = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+FRAME_COUNT_CHOICES = (2, 3, 4, 5)
+INNER_SIZE_RANGE = (3, 7)
+PLACEMENT_PAD = 1
+PALETTE_PAD = 2
+GEN_RETRIES = 400
