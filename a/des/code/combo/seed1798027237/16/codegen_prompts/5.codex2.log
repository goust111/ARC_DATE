+def _rect_is_free(mask: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> bool:
+    hh, ww = mask.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not bool(mask[rr0:rr1, cc0:cc1].any())
+
+
+def _occupy_rect(mask: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> None:
+    hh, ww = mask.shape
