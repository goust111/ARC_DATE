+import numpy as np
+
+
+BG = 0
+GREY = 5
+RNG = np.random.default_rng()
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    if np.any(vals == BG):
+        return BG
+    return int(vals[np.argmax(counts)])
+
+
+def _monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
+                }
+            )
+
+    return comps
+
+
+def _is_frame_component(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+
+    mask = np.zeros((h, w), dtype=bool)
+    coords = comp["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _monochrome_components(grid, bg):
+        if not _is_frame_component(comp):
+            continue
+        r0, c0, r1, c1 = comp["bbox"]
+        inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+        if inner.size == 0 or inner.shape[0] != inner.shape[1]:
+            continue
+        inner_colors = set(map(int, np.unique(inner))) - {bg}
+        if len(inner_colors) != 1:
+            continue
+        frames.append(comp)
+
+    frames.sort(key=lambda d: (d["bbox"][0], d["bbox"][1], d["color"]))
+    return frames
+
+
+def _palette_candidates(grid: np.ndarray, bg: int, frame_colors: set[int]) -> list[dict]:
+    h, w = grid.shape
+    out: list[dict] = []
+
+    for r in range(h):
+        c = 0
+        while c < w:
+            if int(grid[r, c]) == bg:
+                c += 1
+                continue
+            c0 = c
+            while c < w and int(grid[r, c]) != bg:
+                c += 1
+            c1 = c - 1
+
+            vals = grid[r, c0 : c1 + 1]
+            seg_len = int(c1 - c0 + 1)
+            grey_count = int(np.sum(vals == GREY))
+            if seg_len < 2 or seg_len > 4 or grey_count not in (1, 2, 3):
+                continue
+            if grey_count != seg_len - 1:
+                continue
+
+            other = [int(v) for v in vals if int(v) != GREY]
+            if len(other) != 1:
+                continue
+            color = other[0]
+            if color not in frame_colors:
+                continue
+
+            cells = [(r, cc) for cc in range(c0, c1 + 1)]
+            out.append(
+                {
+                    "color": color,
+                    "turns": grey_count,
+                    "row": int(r),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "cells": cells,
+                }
+            )
+
+    return out
+
+
+def _corner_distance(cand: dict, shape: tuple[int, int], corner: str) -> int:
+    h, w = shape
+    row = int(cand["row"])
+    c0 = int(cand["c0"])
+    c1 = int(cand["c1"])
+    if corner == "tl":
+        return row + c0
+    if corner == "tr":
+        return row + (w - 1 - c1)
+    if corner == "bl":
+        return (h - 1 - row) + c0
+    if corner == "br":
+        return (h - 1 - row) + (w - 1 - c1)
+    raise ValueError(corner)
