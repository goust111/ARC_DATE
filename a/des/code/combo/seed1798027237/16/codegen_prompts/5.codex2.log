                        if odc == -1 and c < bc0:
                            outside += 1
                        elif odc == 1 and c > bc1:
                            outside += 1
                        elif odr == -1 and r < br0:
                            outside += 1
                        elif odr == 1 and r > br1:
                            outside += 1

                    for plug_col in plug_colors:
                        if plug_col is None:
                            plug_score = (0, 0, 0, 0)
                        else:
                            plug_hits = 0
                            plug_outside = 0
                            nonplug_in_cav = 0
                            for rr, cc in coords:
                                r = int(r0 + rr)
                                c = int(c0 + cc)
                                in_cav = bool(cav[r, c])
                                col = int(p[rr, cc])
