from itertools import product

def comps(R,C,h,v):
    n=R*C
    adj={ (r,c): set() for r in range(R) for c in range(C)}
    for i,x in enumerate(h):
        a=(i,x); b=(i+1,x); adj[a].add(b); adj[b].add(a)
    for j,x in enumerate(v):
        a=(x,j); b=(x,j+1); adj[a].add(b); adj[b].add(a)
    seen=set(); sizes=[]
    for node in adj:
        if node in seen: continue
        stack=[node]; seen.add(node); comp=[]
        while stack:
            u=stack.pop(); comp.append(u)
            for w in adj[u]:
                if w not in seen:
                    seen.add(w); stack.append(w)
