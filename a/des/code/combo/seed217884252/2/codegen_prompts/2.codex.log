+        elif hole_count == 1:
+            inner_h, inner_w = random.choice([(1, 1), (1, 2), (2, 1), (2, 2)])
+            mask = _ring_mask(inner_h, inner_w)
+            if random.random() < 0.55:
+                grown = _try_add_arm(mask, 1, 1)
+                if grown is not None and grown.shape[0] <= 4 and grown.shape[1] <= 4:
