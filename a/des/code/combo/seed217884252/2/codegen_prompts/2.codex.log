+import random
+
+import numpy as np
+
+
+BG = 8
+GREY = 5
+LEGEND_COLORS = [1, 2, 3, 4, 6, 7, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIRS4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            cells = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for rr, cc in _neighbors4(r, c, h, w):
+                    if mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _crop(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r0 in range(h):
+        for c0 in range(w):
+            if not bg[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            touches_edge = False
+            while stack:
+                r, c = stack.pop()
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_edge = True
+                for rr, cc in _neighbors4(r, c, h, w):
+                    if bg[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            if not touches_edge:
+                holes += 1
+    return holes
+
+
+def _outside_background(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    stack = []
+    for r in range(h):
+        for c in (0, w - 1):
