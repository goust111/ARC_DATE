+        frontier = set()
+        frontier.update({(1, 0), (-1, 0), (0, 1), (0, -1)})
+        while len(cells) < cell_count and frontier:
+            r, c = random.choice(tuple(frontier))
+            frontier.remove((r, c))
+            cells.add((r, c))
+            for dr, dc in DIRS4:
+                nb = (r + dr, c + dc)
+                if nb not in cells:
