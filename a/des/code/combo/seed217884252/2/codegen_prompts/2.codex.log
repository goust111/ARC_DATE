+        for r in (0, h - 1):
+            if not mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if not mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                stack.append((rr, cc))
