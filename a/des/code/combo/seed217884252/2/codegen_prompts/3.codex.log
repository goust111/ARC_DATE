+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Find the odd panel in each row of a separator-divided panel grid and stack those panels vertically.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
