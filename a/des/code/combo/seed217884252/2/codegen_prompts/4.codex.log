+def _side_bar_cells(rect: tuple[int, int, int, int], side: str) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    if side == "top":
+        return {(int(r0 - 1), int(c)) for c in range(c0, c1 + 1)}
+    if side == "bottom":
