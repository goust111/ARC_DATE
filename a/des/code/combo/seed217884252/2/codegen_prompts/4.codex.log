+def _expanded(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    expanded: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
