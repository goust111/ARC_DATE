+def _extract_paths_for_color(
+    g: np.ndarray,
+    color: int,
+    length_by_color: dict[int, int],
+    legend_mask: np.ndarray,
+) -> list[tuple[list[tuple[int, int]], tuple[int, int]]]:
+    h, w = g.shape
