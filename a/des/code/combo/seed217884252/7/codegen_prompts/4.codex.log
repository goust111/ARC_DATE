+def _normalize_shape(cells: set[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int]]:
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    norm = np.array(sorted((r - min_r, c - min_c) for r, c in cells), dtype=int)
+    anchor = (-min_r, -min_c)
+    return norm, anchor
