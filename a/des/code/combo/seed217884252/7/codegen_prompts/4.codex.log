+            return None
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            r0 = random.randint(0, height - spec.height)
+            c0 = random.randint(0, width - spec.width)
+            r1 = r0 + spec.height - 1
+            c1 = c0 + spec.width - 1
