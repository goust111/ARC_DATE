+            assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < g.shape[1]))
+            rows = moved[:, 0]
+            cols = moved[:, 1]
+            assert not np.any(occupied[rows, cols]), "moved objects must not overlap"
