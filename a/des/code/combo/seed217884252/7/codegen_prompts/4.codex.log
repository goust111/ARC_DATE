+    anchor_c = max(top_anchor[1], bottom_anchor[1])
+    top_offset = np.array([0, anchor_c - top_anchor[1]], dtype=int)
+    top_cells = top_cells + top_offset
+    top_anchor_row = top_anchor[0]
