+def _paint(grid: np.ndarray, coords: np.ndarray, color: int, offset_r: int, offset_c: int) -> None:
+    shifted = coords + np.array([offset_r, offset_c], dtype=int)
+    rows = shifted[:, 0]
+    cols = shifted[:, 1]
