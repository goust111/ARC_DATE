+            r0 = random.randint(0, height - spec.height)
+            c0 = random.randint(0, width - spec.width)
+            r1 = r0 + spec.height - 1
+            c1 = c0 + spec.width - 1
+            if not _rect_clear(used, r0, c0, r1, c1, pad=1):
+                continue
+            used[r0 : r1 + 1, c0 : c1 + 1] = True
+            placements.append((spec, r0, c0))
+            placed = True
