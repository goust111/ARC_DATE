+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(used.shape[0] - 1, r1 + pad)
+    cc1 = min(used.shape[1] - 1, c1 + pad)
+    return not np.any(used[rr0 : rr1 + 1, cc0 : cc1 + 1])
