+
+    order = sorted(masks, key=lambda m: -int(m.sum()))
+    placements: list[tuple[int, int, np.ndarray]] = []
+    for mask in order:
+        mh, mw = mask.shape
+        row_min = 1
+        row_max = h - mh - 1
+        col_min = c_min_global
+        col_max = c_max_global - mw + 1
+        if row_min > row_max or col_min > col_max:
