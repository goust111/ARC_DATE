+        fw = int(item["frame_w"])
+        grid[r, c : c + fw] = FRAME
+        grid[r + fh - 1, c : c + fw] = FRAME
+        grid[r : r + fh, c] = FRAME
+        grid[r : r + fh, c + fw - 1] = FRAME
+
+        sprite = item["sprite"]
+        sr = r + 1 + int(item["offset_r"])
+        sc = c + 1 + int(item["offset_c"])
