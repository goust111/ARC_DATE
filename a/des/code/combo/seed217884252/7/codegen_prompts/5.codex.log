+    for r in range(height):
+        for c in range(width):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
