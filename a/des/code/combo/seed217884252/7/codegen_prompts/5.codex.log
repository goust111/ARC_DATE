+        forbidden[r, c] = True
+        for nr, nc in _neighbors4(int(r), int(c), height, width):
+            forbidden[nr, nc] = True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    items = _sample_objects()
+    if items is None:
+        return None
+
+    canvas_choices = _canvas_choices(items)
