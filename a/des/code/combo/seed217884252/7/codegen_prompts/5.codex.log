+
+def _randint(bounds: tuple[int, int]) -> int:
+    return random.randint(int(bounds[0]), int(bounds[1]))
+
+
+def _flip_mask(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    if random.random() < 0.5:
+        out = out[::-1, :]
+    if random.random() < 0.5:
+        out = out[:, ::-1]
+    return out
+
