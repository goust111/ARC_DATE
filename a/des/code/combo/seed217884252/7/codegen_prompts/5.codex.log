+        offset_r = random.randint(0, inner_h - int(sprite.shape[0]))
+        offset_c = random.randint(0, inner_w - int(sprite.shape[1]))
+        used_areas.add(int(chosen_area))
+        items[idx] = {
+            "color": int(colors[idx]),
+            "area": int(chosen_area),
+            "sprite": sprite,
+            "inner_h": int(inner_h),
+            "inner_w": int(inner_w),
+            "frame_h": int(inner_h + 2),
