+def _neighbors4(r: int, c: int, height: int, width: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < height:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < width:
+        yield r, c + 1
