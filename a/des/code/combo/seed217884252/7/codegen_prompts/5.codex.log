+# --------------- generator ---------------
+
+GRID_HEIGHT_RANGE = (16, 28)
+GRID_WIDTH_RANGE = (18, 30)
+FRAME_COUNT_RANGE = (2, 4)
+INTERIOR_HEIGHT_RANGE = (4, 8)
+INTERIOR_WIDTH_RANGE = (4, 8)
+NOISE_COUNT_RANGE = (0, 6)
