def neigh4(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def comps(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            pts=[]
            while q:
                x,y=q.popleft(); pts.append((x,y))
                for xx,yy in neigh4(x,y,h,w):
                    if mask[xx,yy] and not seen[xx,yy]:
                        seen[xx,yy]=True; q.append((xx,yy))
            out.append(pts)
    return out

def bbox(pts):
    rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
    return min(rs),min(cs),max(rs),max(cs)

def hole_sets(mask):
    res=[]
    for pts in comps(~mask):
        if any(r==0 or c==0 or r==mask.shape[0]-1 or c==mask.shape[1]-1 for r,c in pts):
            continue
        res.append(pts)
    return res

def find_legend(g):
    h,w=g.shape
    cand=[]
    for pts in comps(g"'!=BG):
        if not any(r==0 or c==0 or r==h-1 or c==w-1 for r,c in pts):
            continue
        r0,c0,r1,c1=bbox(pts)
        if len(pts)==8 and r1-r0+1==4 and c1-c0+1==2 and np.all(g[r0:r1+1,c0:c1+1]!=BG):
            cand.append((r0,c0,r1,c1))
    assert len(cand)==1, cand
    r0,c0,r1,c1=cand[0]
    mask=np.zeros_like(g,dtype=bool); mask[r0:r1+1,c0:c1+1]=True
    fills=[int(g[r0+i,c0+1]) for i in range(4)]
    return fills,mask

def main(g):
    g=np.asarray(g,dtype=int)
    fills, lmask=find_legend(g)
    out=g.copy()
    for pts in comps((g!=BG)&(~lmask)):
        r0,c0,r1,c1=bbox(pts)
        mask=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)
        for r,c in pts:
            mask[r-r0,c-c0]=True
        opens=[np.any(~mask[0,:]), np.any(~mask[:,-1]), np.any(~mask[-1,:]), np.any(~mask[:,0])]
        assert sum(opens)==1, opens
        fill=fills[opens.index(True)]
        for hole in hole_sets(mask):
            for rr,cc in hole:
                out[r0+rr,c0+cc]=fill
    return out

def make_patch(h,w,direction,hole_count,rng):
    if h<5 or w<5: return None
    patch=np.full((h,w),OBJ,dtype=int)
    if direction=='"'up':
        patch[0,rng.randint(1,w-2)] = BG
    elif direction=='down':
        patch[h-1,rng.randint(1,w-2)] = BG
    elif direction=='left':
        patch[rng.randint(1,h-2),0] = BG
    else:
