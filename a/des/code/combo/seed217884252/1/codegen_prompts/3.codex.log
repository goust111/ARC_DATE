+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(int(cr), int(cc), h, w):
