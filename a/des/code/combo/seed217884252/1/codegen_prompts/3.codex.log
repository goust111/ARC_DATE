def main(grid: np.ndarray) -> np.ndarray:
    """
    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.

    Input structure:
    - The grid is a mosaic of monochrome regions.
    - Color 1 forms T-shaped control markers on region boundaries.
    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.
    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.

    Rule:
    - For a color-1 T marker, the single stem points at the destination region to repaint.
    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.
    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.
    - All marker cells are filled with the final color of the source-side region.
    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.

    Key insight:
    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.
    """
    g = np.asarray(grid, dtype=int)
    out = _solve_unrotated(g)
    l9 = _find_l9_orientation(g)
    if l9 == 'top_right':
        return np.rot90(out, 1)
    if l9 == 'top_left':
        return np.rot90(out, 3)
    return out

# --------------- generator (l9rot) ---------------

# ── Tunable constants ──────────────────────────────────────────────────
# Canvas / region sizing
GRID_SIZE_MAX = 30                          # max rows or cols
MIN_REGION_CELLS = 6                        # per-spec minimum
REGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)
REGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts
REGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS

# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)
MARKER_MIN = 4
MARKER_MAX = 8
NORMAL_MAX = 6
COLORED_MAX = 2

# Color pool (all ARC colors except 1, which is reserved for T-marker cells)
COLOR_POOL = [c for c in range(10) if c != 1]

# L9 rotation marker
L9_PROBABILITY = 0.5                        # chance of placing a rotation marker
L9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation
    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],
    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],
}

# Generation retry budget
SEED_ATTEMPTS = 200                         # tries to place n distinct region seeds
GEN_RETRIES = 300                           # outer generate_input retry budget

_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]


# ── Small geometry helpers ─────────────────────────────────────────────

def _get_bar(stem):
    """Return the two bar directions perpendicular to *stem*."""
    if stem[0] == 0:
        return [(-1, 0), (1, 0)]
    return [(0, -1), (0, 1)]


def _t_cells(center, stem):
    """Return the 4 cells of a T marker: center + stem tip + 2 bar cells."""
    r, c = center
    bar = _get_bar(stem)
    return {(r, c), (r + stem[0], c + stem[1]),
            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}


def _t_branch_cells(center, stem):
    """Return the 3 branch cells (stem tip + 2 bar), excluding the center."""
    r, c = center
    bar = _get_bar(stem)
    return {(r + stem[0], c + stem[1]),
            (r + bar[0][0], c + bar[0][1]),
            (r + bar[1][0], c + bar[1][1])}


def _t_neighborhood(center, stem):
    """Return cells adjacent to any T cell but not part of the T itself."""
    cells = _t_cells(center, stem)
    neighborhood = set()
    for r, c in cells:
        for dr, dc in _DIRS:
            nb = (r + dr, c + dc)
            if nb not in cells:
                neighborhood.add(nb)
    return neighborhood


# ── Region partitioning ────────────────────────────────────────────────

def _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:
    """Grow n_regions from random seeds via randomized BFS; returns region-id array or None."""
    region = np.full((H, W), -1, dtype=int)
    seeds = set()
    for _ in range(SEED_ATTEMPTS):
        if len(seeds) >= n_regions:
            break
        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))
    if len(seeds) < n_regions:
        return None

    frontier = []
    for i, (r, c) in enumerate(list(seeds)):
        region[r, c] = i
        for dr, dc in _DIRS:
            nr, nc = r + dr, c + dc
            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:
                frontier.append((nr, nc, i))
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")

