+        if segment is None:
+            return None
+        segments.append(segment)
+        used_rows.add(int(segment["fixed"]))
+        used_endpoints |= _segment_endpoints(segment)
+        used_cells |= _segment_cells(segment)
+        color_index += 1
+
+    for _ in range(extra_v):
+        segment = _place_extra_vertical(
+            h=h,
+            w=w,
