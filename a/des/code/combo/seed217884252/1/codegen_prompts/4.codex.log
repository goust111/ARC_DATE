from __future__ import annotations

import numpy as np


BG_COLOR = 7
SEPARATOR_COLOR = 3
FOREGROUND_COLORS = [1, 2, 4, 5, 6, 8, 9]
DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))

# --------------- solver ---------------


def _get_bg(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
