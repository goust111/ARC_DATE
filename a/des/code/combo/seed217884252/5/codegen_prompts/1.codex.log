+def _direction_plan(pair_count: int, rng: random.Random) -> list[str]:
+    if pair_count == 1:
+        return [rng.choice(("h", "v"))]
+    mode = rng.choice(("h", "v", "mixed"))
+    if mode == "h":
+        return ["h"] * pair_count
+    if mode == "v":
+        return ["v"] * pair_count
+    dirs = ["h", "v"] + [rng.choice(("h", "v")) for _ in range(pair_count - 2)]
+    rng.shuffle(dirs)
+    return dirs
+
