+    pads = [(int(rng.integers(1, 4)), int(rng.integers(1, 4))) for _ in range(2)]
+    return np.pad(grid, pads, constant_values=BG_COLOR)
+
+
+def _expected_output(pattern: np.ndarray, count: int) -> np.ndarray:
