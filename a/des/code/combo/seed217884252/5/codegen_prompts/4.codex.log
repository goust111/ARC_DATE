+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_to_mask(grid: np.ndarray, mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
+    assert box is not None
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
