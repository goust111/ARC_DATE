+    area = len(allowed)
+    max_size = min(8, (area - 1) // 2)
+    if max_size < 3:
+        return None
+    positions = list(allowed)
+    for _ in range(30):
+        seed = positions[int(rng.integers(len(positions)))]
+        target = int(rng.integers(3, max_size + 1))
+        shape = _grow_shape(allowed, {seed}, target, rng)
