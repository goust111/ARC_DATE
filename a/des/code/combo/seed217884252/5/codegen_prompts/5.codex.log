+REGION_COLORS = (0, 1, 2, 3, 4, 6, 7, 8, 9)
+NONBLACK_REGION_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+LAYOUT_OPTIONS = ((2, 2), (2, 3), (3, 2))
+BAND_SIZE_MIN = 4
+BAND_SIZE_MAX = 8
+OBJECT_COUNT_MIN = 2
+OBJECT_COUNT_MAX = 3
+MAX_GENERATION_ATTEMPTS = 400
