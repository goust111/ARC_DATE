+def _cell_positions(cell: dict) -> set[tuple[int, int]]:
+    return {
+        (r, c)
+        for r in range(int(cell["r0"]), int(cell["r1"]) + 1)
+        for c in range(int(cell["c0"]), int(cell["c1"]) + 1)
+    }
