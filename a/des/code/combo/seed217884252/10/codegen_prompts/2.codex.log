+    signature: list[int] = []
+    for c in range(mask.shape[1]):
+        rows = coords[coords[:, 1] == c][:, 0]
+        anchor = int(rows.max()) if direction > 0 else int(rows.min())
+        signature.append(anchor)
+    return tuple(signature)
+
+
