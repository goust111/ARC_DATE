+    h = rng.randint(2, 5)
+    w = rng.randint(2, 6)
+    heights = [rng.randint(1, h) for _ in range(w)]
+    if len(set(heights)) == 1:
+        idx = rng.randrange(w)
+        heights[idx] = h if heights[idx] < h else 1
+
+    mask = np.zeros((h, w), dtype=bool)
+    if direction > 0:
+        for c, height in enumerate(heights):
+            mask[:height, c] = True
+    else:
+        for c, height in enumerate(heights):
+            mask[h - height :, c] = True
