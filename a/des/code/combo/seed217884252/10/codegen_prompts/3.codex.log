+        masks.append(_mask_t(h, w, rot))
+        masks.append(_mask_stairs(h, w, rot))
+    if h >= 3 and w >= 3:
+        masks.append(_mask_frame(h, w, 1))
+        masks.append(_mask_plus(h, w, 1, 1))
