+            if any(len(_components(remaining == color)) != 1 for color in legend_colors):
+                continue
+
+            candidates.append((side, r0, r1, c0, c1))
+
+    assert len(candidates) == 1, "legend must be uniquely identifiable"
+    return candidates[0]
