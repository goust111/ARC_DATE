+
+def _mask_frame(h: int, w: int, thickness: int = 1) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    t = int(thickness)
+    m[:t, :] = True
+    m[-t:, :] = True
+    m[:, :t] = True
+    m[:, -t:] = True
+    return m
+
+
+def _mask_plus(h: int, w: int, row_thick: int = 1, col_thick: int = 1) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    rt = int(row_thick)
+    ct = int(col_thick)
+    r0 = (h - rt) // 2
+    c0 = (w - ct) // 2
+    m[r0 : r0 + rt, :] = True
+    m[:, c0 : c0 + ct] = True
+    return m
