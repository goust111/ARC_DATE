+
+def _mask_l(h: int, w: int, rot: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    m[0, :] = True
+    m[:, 0] = True
+    return _rot(m, rot)
+
+
+def _mask_t(h: int, w: int, rot: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    m[0, :] = True
+    m[:, w // 2] = True
+    return _rot(m, rot)
+
+
+def _mask_stairs(h: int, w: int, rot: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    col = 0
+    m[0, 0] = True
+    for r in range(1, h):
+        new_col = int(round(r * (w - 1) / max(1, h - 1)))
+        lo = min(col, new_col)
+        hi = max(col, new_col)
+        m[r, lo : hi + 1] = True
+        m[r, col] = True
+        col = new_col
+    return _rot(m, rot)
+
+
+def _mask_h(h: int, w: int, bar_w: int, mid_h: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    bw = int(bar_w)
+    mh = int(mid_h)
+    m[:, :bw] = True
+    m[:, -bw:] = True
+    r0 = (h - mh) // 2
+    m[r0 : r0 + mh, :] = True
+    return m
+
+
+def _mask_u(h: int, w: int, bar_w: int, base_h: int, rot: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    bw = int(bar_w)
+    bh = int(base_h)
+    m[:, :bw] = True
+    m[:, -bw:] = True
+    m[-bh:, :] = True
+    return _rot(m, rot)
+
+
+def _mask_c(h: int, w: int, bar_w: int, rail_h: int, rot: int) -> np.ndarray:
+    m = np.zeros((h, w), dtype=bool)
+    bw = int(bar_w)
+    rh = int(rail_h)
+    m[:, :bw] = True
+    m[:rh, :] = True
+    m[-rh:, :] = True
+    return _rot(m, rot)
