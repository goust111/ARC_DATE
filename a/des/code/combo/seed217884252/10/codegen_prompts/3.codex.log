+
+def _big_mask_candidates(h: int, w: int) -> list[np.ndarray]:
+    masks = [_mask_rect(h, w)]
+
+    if h >= 4 and w >= 4:
+        max_cut_h = min(2, h - 2)
+        max_cut_w = min(2, w - 2)
+        for corner in ("tl", "tr", "bl", "br"):
+            for cut_h in range(1, max_cut_h + 1):
+                for cut_w in range(1, max_cut_w + 1):
