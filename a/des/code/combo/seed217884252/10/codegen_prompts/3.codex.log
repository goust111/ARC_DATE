+def _make_big_mask(small_mask: np.ndarray, mode: str) -> np.ndarray:
+    sh, sw = small_mask.shape
+    small_area = int(small_mask.sum())
+
+    if mode == "partial":
+        h_lo = max(3, sh)
+        h_hi = max(h_lo, min(8, sh + 2))
+        w_lo = max(3, sw)
