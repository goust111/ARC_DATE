+
+def _mask_dented_rect(h: int, w: int, corner: str, cut_h: int, cut_w: int) -> np.ndarray:
+    m = np.ones((h, w), dtype=bool)
+    ch = int(cut_h)
+    cw = int(cut_w)
+    if corner == "tl":
