GRID_H_RANGE = (19, 23)          # output grid height
GRID_W_RANGE = (22, 27)          # output grid width
BG_COLORS = (3, 4)               # candidate background colors
STRUCT_COLORS = (1, 4, 8)        # candidate structure colors

