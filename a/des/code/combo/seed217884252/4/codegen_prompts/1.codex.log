+def _sample_balanced_orientations(rng: np.random.Generator, count: int) -> list[str]:
+    if count == 1:
+        return [str(rng.choice(["h", "v"]))]
+    n_h = count // 2 + int(count % 2 and rng.integers(0, 2))
+    n_v = count - n_h
+    items = ["h"] * n_h + ["v"] * n_v
+    rng.shuffle(items)
+    return items
