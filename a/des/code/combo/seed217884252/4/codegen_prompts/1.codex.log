+        run = _best_bg_run(patch[r, :], bg)
+        if run is None:
+            continue
+        c0, c1 = run
+        run_len = c1 - c0
+        if c0 == 0 or c1 == w:
+            continue
+        if run_len < max(2, (w - 2) // 2):
+            continue
+        if int(patch[r, c0 - 1]) != color or int(patch[r, c1]) != color:
+            continue
+        if not np.any(patch[r - 1, c0:c1] == color):
+            continue
+        if not np.any(patch[r + 1, c0:c1] == color):
+            continue
+        score = run_len / max(1, w - 2)
+        if score > best_score:
