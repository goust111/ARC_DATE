+def _horizontal_patch(rng: np.random.Generator, color: int) -> np.ndarray:
+    width = int(rng.integers(5, 11))
+    top_h = int(rng.integers(2, 5))
+    delta = int(rng.choice(np.array([-1, 0, 1])))
