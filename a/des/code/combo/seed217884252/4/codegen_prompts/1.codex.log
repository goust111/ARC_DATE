+def _candidate_positions(h: int, w: int, patch: np.ndarray, orientation: str) -> list[tuple[int, int]]:
+    ph, pw = patch.shape
+    if orientation == "h":
+        row_range = range(1, h - ph)
+        col_range = range(1, w - pw)
+    else:
+        row_range = range(1, h - ph)
+        col_range = range(1, w - pw)
+    return list(itertools.product(row_range, col_range))
+
