+def _render_input(h: int, w: int, objects: list[PlacedObject]) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    for obj in objects:
+        _paste(grid, obj.patch, obj.top, obj.left, BG)
+    return grid
