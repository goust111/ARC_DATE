+
+    for c in range(1, w - 1):
+        run = _best_bg_run(patch[:, c], bg)
+        if run is None:
+            continue
+        r0, r1 = run
+        run_len = r1 - r0
+        if r0 == 0 or r1 == h:
+            continue
+        if run_len < max(2, (h - 2) // 2):
+            continue
