+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+BG = 0
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GROUP_CONFIGS = [(2, 2), (2, 3), (3, 2), (3, 3), (2, 2, 2)]
+TWO_MEMBER_SCALES = [(1, 2), (1, 3), (2, 3)]
+MAX_GENERATION_ATTEMPTS = 300
