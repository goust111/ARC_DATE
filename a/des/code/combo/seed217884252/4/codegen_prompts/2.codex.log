+        c1 = int(coords[:, 1].max())
+        region = g[r0 : r1 + 1, c0 : c1 + 1]
+        obj_mask = region != BG
+        shape_key, scale = _shape_key_and_scale(obj_mask)
+        control_color = _extract_control_color(region, obj_mask)
+        objects.append(
