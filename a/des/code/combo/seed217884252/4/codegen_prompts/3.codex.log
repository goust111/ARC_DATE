+def _components_from_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    m = np.asarray(mask, dtype=bool)
+    h, w = m.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not m[r, c] or seen[r, c]:
+                continue
+
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or not m[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            comps.append(coords)
+
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return np.asarray(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    shape = np.asarray(mask, dtype=bool)
+    h, w = shape.shape
+    bg = ~shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            touches_border = False
+
+            while q:
+                cr, cc = q.popleft()
+                if cr == 0 or cc == 0 or cr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
