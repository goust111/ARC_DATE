+    rows = slice(top + start, top + start + seg)
+    if side == "left":
+        if left - thick < 0:
+            return
+        canvas[rows, left - thick : left] = True
+    else:
+        if left + width + thick > canvas.shape[1]:
+            return
+        canvas[rows, left + width : left + width + thick] = True
+
+
+def _place_holes(
+    canvas: np.ndarray,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    rng: np.random.Generator,
+) -> bool:
