+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+ORANGE = 7
+BLUE = 1
+RED = 2
+GREY = 5
+
+GRID_HEIGHT_RANGE = (15, 23)
+GRID_WIDTH_RANGE = (15, 23)
+OBJECT_COUNT_RANGE = (2, 5)
+PLACEMENT_MARGIN = 2
+PLACEMENT_GAP = 1
+SHAPE_ATTEMPTS = 200
+GENERATION_ATTEMPTS = 400
