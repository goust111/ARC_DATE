+
+
+def _balanced_labels(rng: np.random.Generator, count: int) -> list[bool]:
+    if count == 2:
+        labels = [False, True]
+    else:
+        hole_count = count // 2 + int(count % 2 and _randint(rng, 0, 1))
+        labels = [True] * hole_count + [False] * (count - hole_count)
+    rng.shuffle(labels)
+    return labels
+
