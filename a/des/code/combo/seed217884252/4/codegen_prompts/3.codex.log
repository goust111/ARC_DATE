+
+            blocked_boxes.append(box)
+            placements[idx] = (patch, has_hole, top, left)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    assert all(item is not None for item in placements)
+    return [item for item in placements if item is not None]
+
