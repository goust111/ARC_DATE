+    count = _randint(rng, OBJECT_COUNT_RANGE[0], max_objects)
+    labels = _balanced_labels(rng, count)
+    crowded = count >= 4 or min(height, width) <= 17
+
+    items: list[tuple[np.ndarray, bool]] = []
+    for has_hole in labels:
