        return np.ones((h, w), dtype=bool)


def _random_grown_blob(rng) -> np.ndarray:
    """Grow a small mask by repeatedly adding an 8-neighbor of existing pixels."""
    h = int(rng.integers(*SMALL_DIM_RANGE))
