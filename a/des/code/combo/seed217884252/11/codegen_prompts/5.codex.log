    r0, c0 = start
    r1, c1 = end
    dr = r1 - r0
    dc = c1 - c0
    if dr == 0 and dc != 0:
        family = "h"
        const = r0
        t0, t1 = sorted((c0, c1))
    elif dc == 0 and dr != 0:
        family = "v"

