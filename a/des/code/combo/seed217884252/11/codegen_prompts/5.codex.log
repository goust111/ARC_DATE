  35:     (frame_color,) = tuple(frame_colors)
  36: 
  37:     assert np.all(g[0, 1 : w - 1] == frame_color)
  38:     assert np.all(g[h - 1, 1 : w - 1] == frame_color)
  39:     assert np.all(g[1 : h - 1, 0] == frame_color)
  40:     assert np.all(g[1 : h - 1, w - 1] == frame_color)
