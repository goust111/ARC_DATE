 110: def main(grid: np.ndarray) -> np.ndarray:
 111:     """
 112:     Thicken the sparse frame and stamp the external sparse sprites into it in positional order.
 113: 
 114:     Input structure
 115:     The grid has a dominant background color, a regular lattice color, one large
 116:     sparse rectangular frame, and one or more external monochrome sprites whose
 117:     pixels also sit on a two-step lattice.
 118: 
 119:     Rule
 120:     Use the largest sparse rectangular perimeter as the frame. Clear that frame
 121:     region and the external sprite pixels to background, draw a solid one-pixel
 122:     border in the frame color, solidify each sparse sprite into its contiguous
 123:     two-step mask, and place the sprites inside the frame with equal gaps.
 124:     Wide frames receive sprites left-to-right by source position; tall frames
 125:     receive them top-to-bottom by source position.
 126: 
 127:     Key insight
 128:     The frame supplies ordered slots: the sprite-to-slot assignment is by visible
 129:     source order, not by numeric color or by matching individual cells.
 130:     """
 131:     g = np.asarray(grid, dtype=int)
 132:     assert g.ndim == 2
 133: 
 134:     bg = get_bg(g)
 135:     counts = Counter(map(int, g.ravel()))
 136:     non_bg = colors_present(g, exclude={bg})
 137:     assert non_bg, "expected foreground colors"
 138: 
 139:     max_non_bg_count = max(counts[c] for c in non_bg)
 140:     lattice_candidates = [c for c in non_bg if counts[c] == max_non_bg_count]
 141:     assert len(lattice_candidates) == 1, "lattice color must be uniquely most frequent"
 142:     lattice_color = lattice_candidates[0]
 143: 
 144:     special_colors = [c for c in non_bg if c != lattice_color]
 145:     assert len(special_colors) >= 2, "expected one frame and at least one sprite"
 146: 
 147:     coords_by_color = {c: np.argwhere(g == c) for c in special_colors}
 148:     frame_candidates = []
 149:     for color, coords in coords_by_color.items():
 150:         if _is_sparse_rect_perimeter(coords):
 151:             frame_candidates.append((color, bbox_coords(coords)))
 152:     assert frame_candidates, "expected a sparse rectangular frame"
 153: 
 154:     max_area = max(_bbox_area(b) for _color, b in frame_candidates)
 155:     largest_frames = [(color, b) for color, b in frame_candidates if _bbox_area(b) == max_area]
 156:     assert len(largest_frames) == 1, "frame must be the unique largest sparse perimeter"
 157:     frame_color, frame_bbox = largest_frames[0]
 158: 
 159:     source_colors = [c for c in special_colors if c != frame_color]
 160:     r0, c0, r1, c1 = frame_bbox
 161:     interior_h = r1 - r0 - 1
 162:     interior_w = c1 - c0 - 1
 163:     assert interior_h != interior_w, "frame must have a unique long axis"
 164: 
 165:     sprites = []
 166:     for color in source_colors:
 167:         coords = coords_by_color[color]
 168:         b = bbox_coords(coords)
 169:         assert not _bboxes_overlap(b, frame_bbox), "sprites must be outside the frame"
 170:         mask = _solidified_mask(coords)
 171:         assert mask.any(), "sprite mask must be nonempty"
 172:         sprites.append({"color": color, "bbox": b, "mask": mask})
 173: 
 174:     out = g.copy()
 175:     for color in source_colors:
 176:         coords = coords_by_color[color]
 177:         out[coords[:, 0], coords[:, 1]] = bg
