  25:     h, w = g.shape
  26:     assert h >= 3 and w >= 3
  27: 
  28:     corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])
  29:     assert len(set(map(int, corners))) == 1
  30:     bg = int(corners[0])
  31: 
  32:     border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))
  33:     frame_colors = set(map(int, border)) - {bg}
