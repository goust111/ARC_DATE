+def _unique_topological_order(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:
+    n = len(colors)
+    graph = [set() for _ in range(n)]
+    indeg = [0] * n
+    for u, v in edges:
+        if v not in graph[u]:
+            graph[u].add(v)
+            indeg[v] += 1
