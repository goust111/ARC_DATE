+BG = 0
+FAMILIES = ("h", "v", "d1", "d2")
+ORIENTED_STEPS = (
+    ("h", (0, 1)),
+    ("h", (0, -1)),
+    ("v", (1, 0)),
+    ("v", (-1, 0)),
+    ("d1", (1, 1)),
+    ("d1", (-1, -1)),
+    ("d2", (1, -1)),
+    ("d2", (-1, 1)),
