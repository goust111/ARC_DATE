+def _line_point(family: str, const: int, t: int) -> tuple[int, int]:
+    if family == "h":
+        return const, t
+    if family == "v":
+        return t, const
+    if family == "d1":
+        return t, t + const
+    assert family == "d2"
+    return t, const - t
