+        assert len(zeros) == 1, "occlusion constraints must determine a unique total order"
+        cur = zeros[0]
+        remaining.remove(cur)
+        order.append(colors[cur])
+        for nxt in graph[cur]:
+            indeg[nxt] -= 1
