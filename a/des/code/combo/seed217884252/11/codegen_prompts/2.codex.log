+    grid[r0 : r1 + 1, c1] = FRAME_COLOR
+    grid[r0 - 1, c0 + 1 : c1] = np.asarray(spec["top_strip"], dtype=int)
+    grid[r0 + 1 : r1, c0 - 1] = np.asarray(spec["left_strip"], dtype=int)
+
