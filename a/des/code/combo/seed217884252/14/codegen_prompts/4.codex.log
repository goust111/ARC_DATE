+    grid = np.full((height, width), BG_COLOR, dtype=int)
+
+    x = frame_left
+    for idx, color in enumerate(frame_order):
+        grid[frame_top : frame_top + frame_h, x : x + frame_w] = patches[color]
+        x += frame_w
+        if idx < len(frame_gaps):
