+    ]
+    frame_color_indices = set(
+        int(x) for x in rng.choice(np.arange(n_palette), size=n_frames, replace=False)
+    )
+    sorted_frame_colors = [
+        color for idx, color in enumerate(palette_order) if idx in frame_color_indices
+    ]
