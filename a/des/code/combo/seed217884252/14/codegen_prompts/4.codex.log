+def _random_motif_mask(rng: np.random.Generator, max_h: int, max_w: int) -> np.ndarray:
+    box_h = int(rng.integers(1, max_h + 1))
+    box_w = int(rng.integers(1, max_w + 1))
+    area = int(rng.integers(1, box_h * box_w + 1))
