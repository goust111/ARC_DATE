+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GENERATION_ATTEMPTS = 400
+
+PANEL_ROWS_RANGE = (2, 5)
+PANEL_COLS_RANGE = (2, 5)
+PANEL_HEIGHT_RANGE = (4, 8)
+PANEL_WIDTH_RANGE = (4, 8)
