+    up = random.randint(0, cr)
+    down = random.randint(0, height - 1 - cr)
+    left = random.randint(0, cc)
+    right = random.randint(0, width - 1 - cc)
+    mask[cr - up : cr + down + 1, cc] = True
+    mask[cr, cc - left : cc + right + 1] = True
