+def _intervals(length: int, groups: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    prev_end = -1
+    for start, end in groups:
+        if start > prev_end + 1:
+            spans.append((prev_end + 1, start))
+        prev_end = end
+    if prev_end < length - 1:
+        spans.append((prev_end + 1, length))
