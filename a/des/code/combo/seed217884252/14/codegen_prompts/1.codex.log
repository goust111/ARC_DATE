+
+
+def _random_mask(height: int, width: int) -> np.ndarray:
+    families = ("blob", "diag", "plus", "rect", "frame", "l", "stripe")
+    for _ in range(MASK_ATTEMPTS):
+        family = random.choice(families)
+        if family == "blob":
