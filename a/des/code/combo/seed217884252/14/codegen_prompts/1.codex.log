        comp_h = r1 - r0 + 1
        comp_w = c1 - c0 + 1
        sides: list[tuple[list[tuple[int, int]], tuple[int, int], str]] = []
        if comp_w < 3:
            sides.append(([(r0, c) for c in range(c0, c1 + 1)], (-1, 0), "hbar"))
            sides.append(([(r1, c) for c in range(c0, c1 + 1)], (1, 0), "hbar"))
