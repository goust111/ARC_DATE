    out = g.copy()
    out[g == Color.GREY] = bg

    paint: set[tuple[int, int]] = set()
    remove_sources: list[tuple[int, int]] = []
    pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}
    for r, c in np.argwhere(g == Color.MAROON):
        hits = []
