    counts = _gen_split_marker_total(marker_total, caps)
    if counts is None:
        return None

    markers: list[_GenMarker] = []
    for (side, slots), count in zip(combo, counts):
        for r, c in random.sample(slots, count):
            markers.append((r, c, side))
