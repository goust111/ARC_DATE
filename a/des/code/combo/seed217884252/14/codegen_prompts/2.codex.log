+            for cc in range(min(anchor_c, offset), max(anchor_c, offset) + 1):
+                cells.add((anchor_r, cc))
+            edge_r = 0 if side == "up" else tile_h - 1
+            for rr in range(min(anchor_r, edge_r), max(anchor_r, edge_r) + 1):
