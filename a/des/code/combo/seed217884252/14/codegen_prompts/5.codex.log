+
+
+def _pair_to_transform(pair: tuple[str, str]) -> str:
+    key = frozenset(pair)
+    if key in (frozenset(("tl", "tr")), frozenset(("bl", "br"))):
+        return "rot180"
+    if key in (frozenset(("tl", "bl")), frozenset(("tr", "br"))):
+        return "flip_h"
+    if key == frozenset(("tl", "br")):
