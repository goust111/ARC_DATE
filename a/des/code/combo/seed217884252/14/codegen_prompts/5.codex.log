+
+    counts = Counter(frame["kind"] for frame in frames)
+    if any(counts[kind] < 1 for kind in TRANSFORMS):
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
