+def _draw_rect(canvas: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> None:
+    """Draw a solid rectangle, rejecting overlap and out-of-bounds placement."""
+    H, W = canvas.shape
+    assert 0 <= r0 <= H - h
+    assert 0 <= c0 <= W - w
+    target = canvas[r0 : r0 + h, c0 : c0 + w]
