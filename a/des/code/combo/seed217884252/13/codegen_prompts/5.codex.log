+
+def _centered_top_left(square_r0: int, square_c0: int, side: int, h: int, w: int) -> tuple[int, int]:
+    """Top-left of an h×w rectangle centered inside a side×side safety square."""
+    return square_r0 + (side - h) // 2, square_c0 + (side - w) // 2
