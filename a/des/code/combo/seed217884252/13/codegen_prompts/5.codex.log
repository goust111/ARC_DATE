+            c0, c1 = min(cols), max(cols)
+            rect_h = r1 - r0 + 1
+            rect_w = c1 - c0 + 1
+            assert len(coords) == rect_h * rect_w
+            assert bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color))
+
+            rects.append(
+                {
+                    "color": color,
+                    "r0": r0,
+                    "c0": c0,
+                    "h": rect_h,
+                    "w": rect_w,
+                }
+            )
+
+    assert rects
+    rects.sort(key=lambda item: (item["r0"], item["c0"], item["color"]))
+    return rects
+
