+        c0 = int(rect["c0"])
+        h = int(rect["h"])
+        w = int(rect["w"])
+        color = int(rect["color"])
+
+        if h == w:
+            _draw_rect(out, r0, c0, h, w, color)
+            continue
+
+        new_h, new_w = w, h
+        new_r0 = r0 + (h - new_h) // 2
+        new_c0 = c0 + (w - new_w) // 2
+        _draw_rect(out, new_r0, new_c0, new_h, new_w, GREY)
