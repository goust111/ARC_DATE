+    W = max(GRID_W_RANGE[0], min(GRID_W_RANGE[1] - 1, span))
+    return H, W
+
+
+def _fits(occupied: np.ndarray, r0: int, c0: int, side: int) -> bool:
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + side > H or c0 + side > W:
+        return False
+    r_lo = max(0, r0 - 1)
+    c_lo = max(0, c0 - 1)
+    r_hi = min(H, r0 + side + 1)
+    c_hi = min(W, c0 + side + 1)
