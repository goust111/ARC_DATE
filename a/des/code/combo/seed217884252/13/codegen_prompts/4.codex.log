+
+BG_COLOR = 7
+FRAME_COLOR = 5
+COLOR_POOL = tuple(color for color in range(10) if color not in (BG_COLOR, FRAME_COLOR))
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
