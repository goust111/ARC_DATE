+    order = list(RNG.permutation(len(jobs)))
+    pair_meta = [{} for _ in range(num_pairs)]
+    for job_index in order:
+        job = jobs[int(job_index)]
+        pos = _place_patch(grid, reserved, job["patch"], pad=1)
+        if pos is None:
