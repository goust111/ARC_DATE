+def _mask_has_enclosed_hole(mask: np.ndarray) -> bool:
+    for comp in _component_records(~mask):
+        coords = comp["coords"]
+        touches_edge = (
+            np.any(coords[:, 0] == 0)
+            or np.any(coords[:, 0] == mask.shape[0] - 1)
+            or np.any(coords[:, 1] == 0)
+            or np.any(coords[:, 1] == mask.shape[1] - 1)
+        )
+        if not touches_edge:
+            return True
+    return False
