+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            coords = []
+            min_r = max_r = int(r)
+            min_c = max_c = int(c)
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                min_r = min(min_r, rr)
+                max_r = max(max_r, rr)
+                min_c = min(min_c, cc)
+                max_c = max(max_c, cc)
+
+                for dr, dc in DIRS:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (min_r, min_c, max_r, max_c),
+                }
+            )
+
+    return comps
