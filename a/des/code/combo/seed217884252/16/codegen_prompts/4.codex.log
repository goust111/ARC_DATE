+
+    inp, specs = placed
+    if not _matches_structure(inp):
+        return None
+
+    expected = _render_expected(inp.shape, specs)
+    try:
+        if np.array_equal(main(inp), expected):
+            return inp
+    except AssertionError:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
