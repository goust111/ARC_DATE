+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(GRID_HEIGHT_RANGE[0], GRID_HEIGHT_RANGE[1])
+    width = random.randint(GRID_WIDTH_RANGE[0], GRID_WIDTH_RANGE[1])
