+    else:
+        edge_row = height - 1
+        inner_row = height - 2
+
+    if corner in {"tl", "bl"}:
+        edge_col = 0
+        inner_col = 1
+    else:
+        edge_col = width - 1
+        inner_col = width - 2
+
+    mask[edge_row, :] = True
