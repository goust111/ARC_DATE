+            c0 = random.randint(0, width - patch_w)
+            union_box = (r0, c0, r0 + patch_h - 1, c0 + patch_w - 1)
+            if any(_boxes_touch_or_overlap(union_box, other, pad=PLACEMENT_PADDING) for other in placed_boxes):
