+        out[r0 : r1 + 1, c0 : c1 + 1] = int(spec["color"])
+        ir0, ic0, ir1, ic1 = spec["intersection"]
+        out[ir0 : ir1 + 1, ic0 : ic1 + 1] = SPECIAL
+    return out
