+import random
+
+import numpy as np
+
+
+BACKGROUND = 7
+SPECIAL = 9
+PAIR_COLORS = (1, 2, 3, 4, 5, 6, 8)
+DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
