from arc_utils import components_mask

# Canvas and band choices.
HEIGHT_BAND_EMPTY_OPTIONS = ((11, 5, 1), (11, 6, 1), (11, 6, 2), (12, 6, 1), (12, 6, 2), (12, 7, 1), (12, 7, 2))
GRID_WIDTH_RANGE = (11, 12)
BAND_TOP_ROW = 2

# Palette and marker placement.
