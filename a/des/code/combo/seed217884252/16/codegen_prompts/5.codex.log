+        if not _can_place(occupied, mask, int(r0), int(c0)):
+            continue
+        _paint_mask(grid, mask, int(r0), int(c0), int(color))
+        occupied[r0 : r0 + h, c0 : c0 + w] |= mask
+        return int(r0), int(c0)
+    return None
+
