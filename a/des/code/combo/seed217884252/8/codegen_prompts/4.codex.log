+        patches.append(patch)
+
+    if not changed:
+        return None
+
+    grid = _place_patches(patches)
+    if grid is None:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
