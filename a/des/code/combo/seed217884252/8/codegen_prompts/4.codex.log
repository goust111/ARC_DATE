+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+ORANGE = 7
+GREY = 5
+PALETTE = tuple(color for color in range(10) if color not in (ORANGE, GREY))
+
+GRID_MIN = 18
+GRID_MAX = 30
