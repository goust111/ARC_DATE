+
+    out = g.copy()
+    for _count, _first, color, bbox in sorted(groups, key=lambda item: (-item[0], item[1])):
+        _draw_outline(out, bbox, color)
+
+    out[marker_mask] = g[marker_mask]
+    return out
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
