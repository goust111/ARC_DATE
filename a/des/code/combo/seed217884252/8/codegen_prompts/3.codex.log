+
+
+def _pick_marker_points(
+    bbox: tuple[int, int, int, int],
+    count: int,
+    occupied: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    r0, c0, r1, c1 = bbox
+    candidates = [
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if (r, c) not in occupied
