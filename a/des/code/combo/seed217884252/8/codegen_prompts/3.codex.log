+    candidate_set = set(candidates)
+    neighbor_map = {
+        cell: {
+            (cell[0] - 1, cell[1]),
+            (cell[0] + 1, cell[1]),
+            (cell[0], cell[1] - 1),
+            (cell[0], cell[1] + 1),
