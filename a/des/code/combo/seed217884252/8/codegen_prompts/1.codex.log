+            if h - frame_h - 1 < 1 or field_right - frame_w - 1 < 1:
+                return False
+            r0 = random.randint(1, h - frame_h - 1)
+            c0 = random.randint(1, field_right - frame_w - 1)
+            rr0 = max(0, r0 - FRAME_PADDING)
+            cc0 = max(0, c0 - FRAME_PADDING)
