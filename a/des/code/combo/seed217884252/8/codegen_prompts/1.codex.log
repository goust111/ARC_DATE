+        + [(height - 1, c) for c in range(1, width - 1)]
+        + [(r, 0) for r in range(1, height - 1)]
+        + [(r, width - 1) for r in range(1, height - 1)]
+    )
+    chosen = random.sample(border, gap_count)
+    for r, c in chosen:
+        patch[r, c] = bg
