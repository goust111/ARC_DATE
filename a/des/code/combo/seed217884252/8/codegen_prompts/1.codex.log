+            cc1 = min(field_right, c0 + frame_w + FRAME_PADDING)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+            mask = patch != bg
+            grid[r0 : r0 + frame_h, c0 : c0 + frame_w][mask] = patch[mask]
+            occupied[rr0:rr1, cc0:cc1] = True
+            placed = True
+            break
+
+        if not placed:
+            return False
+
+    return True
+
