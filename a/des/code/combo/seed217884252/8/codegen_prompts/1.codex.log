+def _gen_attempt() -> np.ndarray | None:
+    bg = 0
+    n_frames = random.choice(FRAME_COUNT_OPTIONS)
+    counts = random.sample([1, 2, 3, 4, 5], n_frames)
+    palette = random.sample([1, 2, 3, 4, 5, 6, 7, 8, 9], 2 * n_frames)
+    frame_colors = palette[:n_frames]
