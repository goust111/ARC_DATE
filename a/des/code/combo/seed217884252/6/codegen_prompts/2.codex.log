+    rendered: np.ndarray, rectangle: tuple[int, int, int, int], color: int
+) -> bool:
+    coords = np.argwhere(rendered == color)
+    if coords.size == 0:
+        return False
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return (int(r0), int(c0), int(r1), int(c1)) == rectangle
