+def _paint_legend(grid: np.ndarray, side: str, start_row: int) -> None:
+    col = 0 if side == "left" else grid.shape[1] - 1
+    for offset, color in enumerate(LEGEND_SEQUENCE):
+        grid[start_row + offset, col] = color
+
