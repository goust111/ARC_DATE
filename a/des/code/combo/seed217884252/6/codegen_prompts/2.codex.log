+    visible[legend_mask] = bg
+    rectangles = _rectangles_from_visible(visible, bg)
+
+    cover = _coverage_map(g.shape, rectangles)
+    out = np.full(g.shape, bg, dtype=int)
+    out[cover == 1] = BLUE
+    out[cover == 2] = GREEN
+    out[cover == 3] = RED
+    out[cover >= 4] = YELLOW
+    return out
+
+
