+def _local_density(g: np.ndarray, r: int, c: int, color: int) -> int:
+    r0 = max(0, int(r) - 1)
+    r1 = min(int(g.shape[0]), int(r) + 2)
+    c0 = max(0, int(c) - 1)
+    c1 = min(int(g.shape[1]), int(c) + 2)
+    return int(np.count_nonzero(g[r0:r1, c0:c1] == int(color)))
