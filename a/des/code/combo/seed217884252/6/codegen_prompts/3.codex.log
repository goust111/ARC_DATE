+        if placed is None:
+            return None
+        placed_info, blocked_cells = placed
+        for r, c in placed_info["cells"]:
+            grid[r, c] = int(color)
+        blocked |= blocked_cells
+        placed_components.append(placed_info)
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+
+    for placed in placed_components:
+        cr, cc = placed["center"]
+        if out[cr, cc] == BG:
+            return None
+
+    return grid
+
