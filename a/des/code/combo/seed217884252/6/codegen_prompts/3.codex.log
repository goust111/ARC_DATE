+
+def _visual_centroid(g: np.ndarray, coords: list[tuple[int, int]], color: int) -> tuple[int, int]:
+    best_pos = coords[0]
+    best_score = -1
+    for r, c in coords:
+        score = _local_density(g, int(r), int(c), int(color))
+        if score > best_score or (score == best_score and (int(r), int(c)) < best_pos):
