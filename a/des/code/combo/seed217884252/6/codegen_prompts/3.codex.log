+    return cells, core_shape, True
+
+
+def _tail_start_options(core_h: int, core_w: int) -> list[tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]]]:
+    options: list[tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]]] = []
