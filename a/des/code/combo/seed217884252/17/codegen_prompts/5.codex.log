+        horizontal_score = _horizontal_score(mask)
+        vertical_score = _vertical_score(mask)
+        folded = _fold_horizontal(mask) if horizontal_score >= vertical_score else _fold_vertical(mask)
+
+        r0, c0, r1, c1 = bbox
+        region = out[r0 : r1 + 1, c0 : c1 + 1]
