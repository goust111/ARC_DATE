+        keep = _grow_connected_mask(half, w, area, anchor="bottom")
+        if keep is None or not np.any(keep[-1, :]):
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        mask[:half, :] = keep
+        mask[h - half :, :] |= keep[::-1, :]
+
+        if h % 2 == 1:
