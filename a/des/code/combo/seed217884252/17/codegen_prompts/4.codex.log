+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    ranked = _ranked_colors_by_frequency(g)
+    mirrored = ranked[::-1]
+    mapping = {src: dst for src, dst in zip(ranked, mirrored)}
+
+    out = g.copy()
+    for src, dst in mapping.items():
+        out[g == src] = dst
+    return out
