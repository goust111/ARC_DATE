+
+def _mask_is_valid(mask: np.ndarray) -> bool:
+    if mask.dtype != bool:
+        mask = mask.astype(bool)
+    area = int(mask.size)
+    count = int(mask.sum())
+    if count < 2 or count >= area:
+        return False
+    if np.any(mask.all(axis=0)) or np.any(mask.all(axis=1)):
+        return False
+    return True
