+def _contiguous_runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = end = int(indices[0])
+    for value in indices[1:]:
+        value = int(value)
