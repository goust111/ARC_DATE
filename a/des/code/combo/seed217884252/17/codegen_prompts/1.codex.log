+    full_cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == divider)]
+    row_slices = _spans(grid.shape[0], _contiguous_runs(full_rows))
+    col_slices = _spans(grid.shape[1], _contiguous_runs(full_cols))
