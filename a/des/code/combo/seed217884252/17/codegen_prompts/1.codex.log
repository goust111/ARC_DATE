+
+def _panel_offsets(count: int, size: int, separator: int) -> list[slice]:
+    spans: list[slice] = []
+    cursor = 0
+    for index in range(count):
+        spans.append(slice(cursor, cursor + size))
+        cursor += size
+        if index != count - 1:
+            cursor += separator
+    return spans
