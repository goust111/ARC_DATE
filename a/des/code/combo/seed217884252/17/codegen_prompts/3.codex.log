+    mask_h, mask_w = map(int, mask.shape)
+    copy_h = int(obj["copy_h"])
+    copy_w = int(obj["copy_w"])
+    reserve_h = mask_h + copy_h
+    reserve_w = max(mask_w, copy_w)
