+def _copy_extent(holes: list[dict]) -> tuple[int, int]:
+    if not holes:
+        return 0, 0
+    height = max(int(hole["mask"].shape[0]) for hole in holes)
+    width = sum(int(hole["mask"].shape[1]) for hole in holes) + max(0, len(holes) - 1)
+    return height, width
