+def _delta_for_direction(direction: str, h: int, w: int) -> tuple[int, int]:
+    if direction == "up":
+        return (-h, 0)
+    if direction == "down":
+        return (h, 0)
+    if direction == "left":
+        return (0, -w)
+    if direction == "right":
+        return (0, w)
