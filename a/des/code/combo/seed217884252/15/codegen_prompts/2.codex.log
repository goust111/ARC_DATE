+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
