+    else:
+        for c in range(mask.shape[1]):
+            rows = np.flatnonzero(mask[:, c])
+            if rows.size == 0:
+                sigs.append((0, 0))
+            else:
+                sigs.append((int(rows[-1] - rows[0] + 1), int(rows.size)))
+    return sigs
+
+
+def _narrow_end(signatures: list[tuple[int, int]]) -> int:
+    for i in range(len(signatures)):
+        a = signatures[i]
+        b = signatures[-1 - i]
+        if a != b:
+            return -1 if a < b else 1
