+def _can_place(blocked: np.ndarray, spec: dict, top: int, left: int) -> bool:
+    h, w = blocked.shape
+    r0, c0, r1, c1 = _object_reserved_bbox(spec, top, left)
+    if r0 < 1 or c0 < 1 or r1 >= h - 1 or c1 >= w - 1:
+        return False
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
