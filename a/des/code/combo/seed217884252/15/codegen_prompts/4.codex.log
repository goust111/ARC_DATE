+
+
+def _scene_has_direction_variety(specs: list[dict]) -> bool:
+    directions = {side for spec in specs for side in spec["groups"]}
+    return len(directions) >= 2
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
