+        for r, c in bases:
+            for step in range(arm_len):
+                rr = int(r + dr * step)
+                cc = int(c + dc * step)
+                if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1] and out[rr, cc] != OBJECT:
+                    out[rr, cc] = color
+
