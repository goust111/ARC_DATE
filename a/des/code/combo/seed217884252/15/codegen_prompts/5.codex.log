+    indegree: dict[int, int] = {color: 0 for color in colors}
+    for lower, higher in edges:
+        assert lower != higher, "self-ordering is invalid"
+        if higher not in above[lower]:
+            above[lower].add(higher)
+            indegree[higher] += 1
