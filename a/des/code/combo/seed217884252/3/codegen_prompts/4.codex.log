 146: def _orbit(r: int, c: int) -> set[tuple[int, int]]:
 147:     """Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes."""
 148:     rows = {r}
 149:     cols = {c}
 150:     if _LO <= r <= _HI:
 151:         rows.add(_LO + _HI - r)
 152:     if _LO <= c <= _HI:
 153:         cols.add(_LO + _HI - c)
 154:     return {(rr, cc) for rr in rows for cc in cols}
