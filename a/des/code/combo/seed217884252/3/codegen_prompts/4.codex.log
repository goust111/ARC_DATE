+def _sample_canvas_shape(rng: random.Random, n_frames: int) -> tuple[int, int]:
+    low_h = max(GRID_H_RANGE[0], 10 + 2 * n_frames)
+    low_w = max(GRID_W_RANGE[0], 10 + 2 * n_frames)
+    high_h = GRID_H_RANGE[1]
+    high_w = GRID_W_RANGE[1]
