+def _find_frames(grid: np.ndarray) -> list[FrameInfo]:
+    g = np.asarray(grid, dtype=int)
+    frames: list[FrameInfo] = []
+    for comp in _components4(g != BG):
+        frame = _frame_from_component(g, comp)
+        if frame is not None:
+            frames.append(frame)
+    return frames
