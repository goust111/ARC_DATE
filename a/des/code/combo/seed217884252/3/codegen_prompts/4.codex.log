 157: def _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:
 158:     """Identify marker cells whose entire orbit is inside the marker (need transpose fallback).
 159: 
 160:     Returns None if the placement is invalid (a fully-covered orbit cell lies
 161:     inside the inner block, or its transpose is also inside the marker).
 162:     """
 163:     r1, c1 = r0 + h, c0 + w
 164:     cells: list[tuple[int, int]] = []
 165:     for r in range(r0, r1):
 166:         for c in range(c0, c1):
 167:             if all(r0 <= rr < r1 and c0 <= cc < c1 for rr, cc in _orbit(r, c)):
 168:                 if r >= _LO and c >= _LO:
 169:                     return None  # orbit fully hidden but no transpose fallback available
 170:                 if r0 <= c < r1 and c0 <= r < c1:
 171:                     return None  # transpose cell also hidden by marker
 172:                 cells.append((r, c))
 173:     return cells
 174: 
