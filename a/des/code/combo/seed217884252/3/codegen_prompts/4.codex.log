+    cc0 = max(0, c0 - PLACEMENT_PADDING)
+    rr1 = min(rows, r0 + h + PLACEMENT_PADDING)
+    cc1 = min(cols, c0 + w + PLACEMENT_PADDING)
+    occupied[rr0:rr1, cc0:cc1] = True
