 194:     def find(x: tuple[int, int]) -> tuple[int, int]:
 195:         parent.setdefault(x, x)
 196:         while parent[x] != x:
 197:             parent[x] = parent[parent[x]]
 198:             x = parent[x]
 199:         return x
 200: 
 201:     def union(a: tuple[int, int], b: tuple[int, int]) -> None:
 202:         ra, rb = find(a), find(b)
 203:         if ra != rb:
 204:             parent[rb] = ra
 205: 
