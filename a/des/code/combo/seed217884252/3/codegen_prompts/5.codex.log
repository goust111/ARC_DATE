+        abs_coords = [(r0 + rr, c0 + cc) for rr, cc in comp]
+        sr0, sc0, sr1, sc1 = _bbox(abs_coords)
+        area = len(abs_coords)
+        assert area == (sr1 - sr0 + 1) * (sc1 - sc0 + 1), "slot must be a filled rectangle"
