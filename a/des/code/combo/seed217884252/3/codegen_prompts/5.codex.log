+        color = next(iter(neighbor_colors))
+        assert color not in slots, "each region color should own one unique slot"
+        slots[color] = {
+            "bbox": (sr0, sc0, sr1, sc1),
+            "coords": abs_coords,
+            "shape": (sr1 - sr0 + 1, sc1 - sc0 + 1),
+        }
