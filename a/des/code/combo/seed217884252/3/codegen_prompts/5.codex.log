+    sub_bg = grid[r0 : r1 + 1, c0 : c1 + 1] == bg
+    slots: dict[int, dict] = {}
+    sub_h, sub_w = sub_bg.shape
+    for comp in _components(sub_bg):
+        if any(rr == 0 or cc == 0 or rr == sub_h - 1 or cc == sub_w - 1 for rr, cc in comp):
+            continue
