+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+LEGEND_COMMANDS = (GREEN, RED, BLUE)
+MARKER_POOL = (4, 6, 7, 8, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return mask.any() and len(_components4(mask)) == 1
+
+
+def _is_marker_interior(mask: np.ndarray, marker: tuple[int, int]) -> bool:
+    r, c = marker
+    if not mask[r, c]:
+        return False
+    for dr, dc in DIRS4:
+        nr = r + dr
+        nc = c + dc
+        if not (0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]):
+            return False
+    return True
