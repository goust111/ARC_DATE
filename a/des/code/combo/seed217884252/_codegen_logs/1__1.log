+    grid[frame_r0, frame_c0 : frame_c0 + frame_w] = FRAME_COLOR
+    grid[frame_r0 + frame_h - 1, frame_c0 : frame_c0 + frame_w] = FRAME_COLOR
+    grid[frame_r0 : frame_r0 + frame_h, frame_c0] = FRAME_COLOR
