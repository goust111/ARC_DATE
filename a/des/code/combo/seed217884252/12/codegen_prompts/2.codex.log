+                "color": color,
+                "area": int(shape.sum()),
+            }
+        )
+
+    min_h = max(GRID_MIN, max((obj["area"] if not obj["horizontal"] else 0) for obj in shapes) + 4)
+    min_w = max(GRID_MIN, max((obj["area"] if obj["horizontal"] else 0) for obj in shapes) + 4)
+    if min_h > GRID_MAX or min_w > GRID_MAX:
