+            placed_boxes.append(box)
+            used_segment_cells.update(seg)
+            break
+        else:
+            return None
+
+    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)
+    for idx, obj in enumerate(shapes):
+        top, left = placements[idx]
