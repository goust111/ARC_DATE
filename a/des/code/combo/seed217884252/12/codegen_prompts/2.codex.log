+    order = sorted(range(object_count), key=lambda i: (-shapes[i]["area"], shapes[i]["horizontal"]))
+    placed_boxes: list[tuple[int, int, int, int]] = []
+    used_segment_cells: set[tuple[int, int]] = set()
+    placements: dict[int, tuple[int, int]] = {}
