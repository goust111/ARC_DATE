+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        occupied[r0:r1, c0:c1] = True
+
+
+def _random_path(
+    start: tuple[int, int], goal: tuple[int, int], rng: random.Random
+) -> list[tuple[int, int]]:
+    r, c = start
+    gr, gc = goal
+    out = []
+    while (r, c) != (gr, gc):
+        steps = []
+        if r < gr:
+            steps.append((r + 1, c))
+        elif r > gr:
+            steps.append((r - 1, c))
+        if c < gc:
+            steps.append((r, c + 1))
+        elif c > gc:
+            steps.append((r, c - 1))
+        r, c = rng.choice(steps)
+        out.append((r, c))
