    pattern = _make_pattern(colors, side)
    pattern_col = random.randint(0, grid.shape[1] - side)
    paste(grid, pattern, size + gap, pattern_col)

    expected = _expand(pattern, colors, stencils)
    if not np.array_equal(main(grid), expected):
