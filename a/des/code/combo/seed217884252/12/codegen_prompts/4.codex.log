+    categories = [CAT_OPPOSITE, CAT_CORNER, CAT_ONE, CAT_NONE]
+    extra_count = rng.randint(*EXTRA_OBJECTS_RANGE)
+    extras = [rng.choice([CAT_NONE, CAT_ONE, CAT_CORNER, CAT_OPPOSITE]) for _ in range(extra_count)]
