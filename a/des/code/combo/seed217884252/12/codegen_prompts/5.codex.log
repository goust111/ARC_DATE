        tip_r, tip_c = anchor, base_left + rect_w - 1 + length
        offsets = [dr for dr in (-1, 1) if 0 <= tip_r + dr < mask.shape[0]]
        if offsets and random.random() < TIP_PROBABILITY:
            mask[tip_r + random.choice(offsets), tip_c] = True
        return

