+
+    k = random.randrange(4)
+    inp = np.rot90(inp, k)
+    out = np.rot90(out, k)
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        pair = _oracle_input()
