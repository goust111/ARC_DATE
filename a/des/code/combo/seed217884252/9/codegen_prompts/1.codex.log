+    inputs, outputs = placed
+
+    inp = np.full((h, w), BG, dtype=int)
+    out = np.full((h, w), BG, dtype=int)
+    _build_legend(inp, mapping, count_color, arrow_color, row_order)
+    for coords in inputs:
