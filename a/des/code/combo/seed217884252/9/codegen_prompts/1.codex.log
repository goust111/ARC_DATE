+    count_color: int,
+    arrow_color: int,
+    row_order: list[int],
+) -> None:
+    for row_idx, count in enumerate(row_order):
+        r0 = row_idx * LEGEND_ROW_H
+        grid[r0 + LEGEND_ROW_H - count : r0 + LEGEND_ROW_H, 0] = count_color
+        patch = _arrow_mask(mapping[count])
