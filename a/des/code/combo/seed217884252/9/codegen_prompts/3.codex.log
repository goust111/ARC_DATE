0020: def main(grid: np.ndarray) -> np.ndarray:
0021:     """Build the woven rectangle determined by the two marked cells on each crossed bar.
0022: 
0023:     Input structure
0024:     A black-background grid contains one long horizontal bar and one long vertical bar.
0025:     Each bar has a dominant base color and exactly two same-colored marker pixels.
0026: 
0027:     Rule
0028:     The horizontal marker pair gives the output column span.  From the horizontal bar
0029:     row, walk toward the farther vertical marker; rows and columns alternate every
0030:     other cell.  Even step/even offset cells use the horizontal marker color until
0031:     the nearer vertical marker is reached, then use the vertical marker color.
0032:     Odd row steps use the horizontal base on marker columns and the original
0033:     crossing color on spacer columns.  Spacer columns on even row steps use the
0034:     vertical base, except at the switch row where they use the crossing color.
0035: 
0036:     Key insight
0037:     The original cross cell records which base color wins at base/base lattice
0038:     crossings; the nearer vertical marker is the color-switch boundary.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     bg = get_bg(g)
0042:     fg = g != bg
0043: 
0044:     h_rows = np.flatnonzero(fg.sum(axis=1) > 1)
0045:     v_cols = np.flatnonzero(fg.sum(axis=0) > 1)
0046:     assert len(h_rows) == 1
0047:     assert len(v_cols) == 1
0048:     h_row = int(h_rows[0])
0049:     v_col = int(v_cols[0])
0050: 
0051:     h_cols = np.flatnonzero(g[h_row] != bg)
0052:     v_rows = np.flatnonzero(g[:, v_col] != bg)
0053:     assert h_cols.size >= 2
0054:     assert v_rows.size >= 2
0055:     assert np.array_equal(h_cols, np.arange(h_cols[0], h_cols[-1] + 1))
0056:     assert np.array_equal(v_rows, np.arange(v_rows[0], v_rows[-1] + 1))
0057: 
0058:     h_base, h_marker = _base_and_pair_marker(g[h_row, h_cols])
0059:     v_base, v_marker = _base_and_pair_marker(g[v_rows, v_col])
0060: 
0061:     h_marker_cols = h_cols[g[h_row, h_cols] == h_marker]
0062:     v_marker_rows = v_rows[g[v_rows, v_col] == v_marker]
0063:     assert h_marker_cols.size == 2
0064:     assert v_marker_rows.size == 2
0065:     left_col = int(h_marker_cols.min())
0066:     right_col = int(h_marker_cols.max())
0067: 
0068:     if np.all(v_marker_rows > h_row):
0069:         direction = 1
0070:         near_row = int(v_marker_rows.min())
0071:         far_row = int(v_marker_rows.max())
0072:     elif np.all(v_marker_rows < h_row):
0073:         direction = -1
0074:         near_row = int(v_marker_rows.max())
0075:         far_row = int(v_marker_rows.min())
0076:     else:
0077:         raise AssertionError("vertical markers must lie on one side of the horizontal bar")
0078: 
0079:     cross_color = int(g[h_row, v_col])
0080:     assert cross_color in (h_base, v_base)
0081: 
0082:     out = np.full_like(g, bg)
0083:     near_step = abs(near_row - h_row)
0084:     far_step = abs(far_row - h_row)
0085: 
0086:     for step in range(far_step + 1):
0087:         r = h_row + direction * step
0088:         for offset, c in enumerate(range(left_col, right_col + 1)):
0089:             if offset % 2 == 0:
0090:                 if step % 2 == 0:
0091:                     out[r, c] = h_marker if step < near_step else v_marker
0092:                 else:
0093:                     out[r, c] = h_base
0094:             elif step % 2 == 0:
0095:                 out[r, c] = cross_color if step == near_step else v_base
0096:             else:
0097:                 out[r, c] = cross_color
0098: 
0099:     return out
