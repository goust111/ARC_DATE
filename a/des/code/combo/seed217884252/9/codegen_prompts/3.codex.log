0055: def main(grid: np.ndarray) -> np.ndarray:
0056:     """
0057:     Fill partitioned regions with concentric colored bands derived from marker pixels.
0058: 
0059:     Input structure:
0060:     - Grid partitioned into regions by wall-colored lines.
0061:     - Each region has a dominant base color and a few isolated marker pixels of other colors at varying depths from the region boundary.
0062: 
0063:     Rule:
0064:     - For each region, read marker colors ordered by their Chebyshev distance from the boundary to build a color palette.
0065:     - If no marker sits on the boundary itself, the base color leads the palette.
0066:     - Paint every cell with palette[distance mod palette_length], producing repeating concentric rectangular frames that radiate inward.
0067: 
0068:     Key insight: Each marker's depth from the boundary defines its position in the cyclic palette; the pattern then tiles inward automatically.
0069:     """
0070:     g = np.asarray(grid, dtype=int)
0071:     h, w = g.shape
0072: 
0073:     # Global background and wall color (the main partition lines).
0074:     bg = _mode(g)
0075:     other = g[g != bg]
0076:     wall = bg if other.size == 0 else _mode(other)
0077: 
0078:     out = g.copy()
0079:     free = g != wall
0080:     comps = _cc4(free)
0081: 
0082:     for pts in comps:
0083:         # Build component mask
0084:         comp_mask = np.zeros((h, w), dtype=bool)
0085:         for r, c in pts:
0086:             comp_mask[r, c] = True
0087: 
0088:         vals = g[comp_mask]
0089:         base = _mode(vals)
0090:         dist = _boundary_distance(comp_mask)
0091: 
0092:         # Markers are cells whose color differs from the region base.
0093:         # Pick at most one marker color per distance (closest in reading order).
0094:         dist_to_color: dict[int, int] = {}
0095:         for r, c in pts:
0096:             v = int(g[r, c])
0097:             if v == base:
0098:                 continue
0099:             d = int(dist[r, c])
0100:             if d < 0:
0101:                 continue
0102:             if d not in dist_to_color:
0103:                 dist_to_color[d] = v
0104:             else:
0105:                 # stable tie-breaker: prefer earlier (r,c)
0106:                 pass
0107: 
0108:         palette: list[int] = []
0109:         if dist_to_color:
0110:             ds = sorted(dist_to_color.keys())
0111:             if ds[0] > 0:
0112:                 palette.append(int(base))
0113:             for d in ds:
0114:                 palette.append(int(dist_to_color[d]))
0115:         else:
0116:             palette = [int(base)]
0117: 
0118:         m = len(palette)
0119:         for r, c in pts:
0120:             d = int(dist[r, c])
0121:             out[r, c] = palette[d % m]
0122: 
0123:     return out
