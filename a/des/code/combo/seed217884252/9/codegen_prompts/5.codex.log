+
+        while int(mask.sum()) < target_area and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            rr, cc = cell
+            mask[rr, cc] = True
+            for nr, nc in _neighbors4(rr, cc):
+                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
+                    frontier.add((int(nr), int(nc)))
