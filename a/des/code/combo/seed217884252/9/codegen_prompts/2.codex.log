+            item["row"] = int(item["row"] - r0)
+            item["c0"] = int(item["c0"] - c0)
+            item["c1"] = int(item["c1"] - c0)
+        else:
+            item["col"] = int(item["col"] - c0)
+            item["r0"] = int(item["r0"] - r0)
+            item["r1"] = int(item["r1"] - r0)
