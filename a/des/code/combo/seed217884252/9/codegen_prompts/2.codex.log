+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a valid overlaid-line puzzle")

