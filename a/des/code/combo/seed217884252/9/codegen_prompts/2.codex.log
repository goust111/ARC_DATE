+def _embed_region(region: np.ndarray) -> np.ndarray:
+    top = random.randint(*_MARGIN_RANGE)
+    bottom = random.randint(*_MARGIN_RANGE)
+    left = random.randint(*_MARGIN_RANGE)
+    right = random.randint(*_MARGIN_RANGE)
