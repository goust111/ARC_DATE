169:     masks: list[np.ndarray] = []
170:     seen: set[bytes] = set()
171:     total = interior_size * interior_size
172:     for _ in range(C):
173:         for _ in range(_MASK_RETRIES):
174:             density = random.uniform(_FILL_DENSITY_LO, _FILL_DENSITY_HI)
175:             m = np.random.random((interior_size, interior_size)) < density
176:             fill = m.sum()
177:             if fill < _FILL_DENSITY_LO * total or fill > _FILL_DENSITY_HI * total:
178:                 continue
179:             if fill == 0:
180:                 continue
181:             key = m.tobytes()
182:             if key not in seen:
183:                 seen.add(key)
184:                 masks.append(m)
185:                 break
186:         else:
187:             return None
188:     return masks
