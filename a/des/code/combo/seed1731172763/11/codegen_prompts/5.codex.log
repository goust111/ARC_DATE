344:     has_divider, divider_color, target_region = _gen_place_divider(grid, available, src_colors, legend_row, legend_col, legend_rows)
345: 
346:     target_colors = _gen_target_colors(available, src_colors, divider_color, pairs)
347:     if target_colors is None:
348:         return None
349:     placed_targets = _gen_place_targets(grid, target_colors, bg, target_region, has_divider)
350:     if placed_targets < MIN_PLACED_TARGETS:
351:         return None
352: 
353:     if not _gen_is_valid(grid, bg, legend_row, legend_col, legend_rows):
354:         return None
355: 
356:     return grid
