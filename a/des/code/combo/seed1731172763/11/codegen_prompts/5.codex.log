7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Swap the upper two-pixel segment and the lower two-pixel segment around the fixed center pixel.
10: 
11:     Input structure:
12:     - The grid is a 5x1 vertical column of individual colored pixels.
13:     - The middle pixel is a separator between two same-size two-pixel segments.
14: 
15:     Rule:
16:     - Keep the middle pixel in place.
17:     - Reverse the order of the two pixels above the middle.
18:     - Reverse the order of the two pixels below the middle.
19: 
20:     Key insight:
21:     - The transformation is local vertical order reversal on each side of the center, not a color-specific rule.
22:     """
23:     g = np.asarray(grid, dtype=int)
24:     assert g.shape == (5, 1), "expected a 5x1 vertical column"
25: 
26:     out = g.copy()
27:     out[0, 0], out[1, 0] = g[1, 0], g[0, 0]
28:     out[3, 0], out[4, 0] = g[4, 0], g[3, 0]
29:     return out
30: 
31: # --------------- generator (att2) ---------------
32: 
33: # Fixed 5x1 column and color vocabulary.
34: GRID_SHAPE = (5, 1)
35: COLOR_DOMAIN = range(10)
36: COLORS_PER_GRID = GRID_SHAPE[0]
37: 
38: # Oracle/retry controls.
39: OUTPUT_ROW_ORDER = (1, 0, 2, 4, 3)
40: MAX_ATTEMPTS = 300
41: 
42: 
---
43: def generate_input() -> np.ndarray:
44:     for _ in range(MAX_ATTEMPTS):
45:         inp = np.array(random.sample(COLOR_DOMAIN, COLORS_PER_GRID), dtype=int).reshape(GRID_SHAPE)
46:         if np.array_equal(main(inp), inp[OUTPUT_ROW_ORDER, :]):
47:             return inp
