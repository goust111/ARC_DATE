+    template_mask = template != BG
+
+    miss_i = 0
+    fill_i = 0
+    col = 0
+    for panel_idx in range(panel_count):
+        if panel_idx > 0:
+            col += sep_w
+
+        if panel_idx != complete_idx:
+            panel = out[:, col : col + w]
+            missing = missing_masks[miss_i]
+            assert np.array_equal(missing, template_mask & (panel == BG))
+            panel[missing] = FILL_SEQUENCE[fill_i]
+            miss_i += 1
