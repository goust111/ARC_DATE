610: def _place_legend(grid, leg, col_start, sep_col, marker_r0, is_right):
611:     """Draw one legend panel (separator, marker square, rotation patch, sprite, frame)."""
612:     N = leg["N"]
613:     grid[:, sep_col] = 6
614: 
615:     # Marker square column: sprite at col_start+1 must fit within the 5-wide panel
616:     mc0 = (col_start + max(0, N - 4)) if not is_right else (sep_col + max(0, N - 3))
617: 
618:     # 5x5 border-6 marker square
619:     grid[marker_r0:marker_r0 + 5, mc0:mc0 + 5] = 0
620:     grid[marker_r0, mc0:mc0 + 5] = 6
621:     grid[marker_r0 + 4, mc0:mc0 + 5] = 6
622:     grid[marker_r0:marker_r0 + 5, mc0] = 6
623:     grid[marker_r0:marker_r0 + 5, mc0 + 4] = 6
624:     grid[marker_r0 + 1 + leg["pr"], mc0 + 1 + leg["pc"]] = 4
625: 
626:     # Rotation patch: 3x5 block with 6-borders on cols 0,4 and 3x3 clock-hand inside
627:     rr0 = marker_r0 + 5
628:     grid[rr0:rr0 + 3, mc0:mc0 + 5] = 0
629:     grid[rr0:rr0 + 3, mc0] = 6
630:     grid[rr0:rr0 + 3, mc0 + 4] = 6
631:     cx_r, cx_c = rr0 + 1, mc0 + 2
632:     dr, dc = ROTATION_DIRS[leg["rot_k"]]
633:     grid[cx_r, cx_c] = 7
634:     grid[cx_r + dr, cx_c + dc] = 7
635: 
636:     # Unit sprite at row 1
637:     sp_col = col_start + 1 - mc0
638:     grid[1:1 + N, mc0 + sp_col:mc0 + sp_col + N] = leg["legend_sprite"]
639: 
640:     # Frame mask between unit sprite bottom and marker top
641:     fH, fW = leg["frame_H"], leg["frame_W"]
642:     avail = marker_r0 - (N + 1)
643:     gap = random.randint(1, max(1, avail - fH))
644:     fr_start = N + 1 + gap
645:     f_col = random.randint(0, max(0, 4 - fW))
646:     frame_region = grid[fr_start:fr_start + fH, mc0 + f_col:mc0 + f_col + fW]
647:     frame_region[leg["frame_mask"]] = leg["frame_color"]
