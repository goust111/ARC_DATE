261: def main(grid: np.ndarray) -> np.ndarray:
262:     """
263:     Assemble and place enlarged sprites on a canvas using legend-panel instructions.
264: 
265:     Input structure:
266:     - Color-6 separators divide the grid into a left legend column and a main canvas.
267:     - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.
268: 
269:     Rule:
270:     - Tile the unit sprite into each active cell of the frame to build an enlarged composite.
271:     - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).
272:     - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.
273: 
274:     Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).
275:     """
276:     g = np.asarray(grid, dtype=int)
277:     h, w = g.shape
278:     assert w >= 2, "grid width must be >= 2"
279: 
280:     # Output canvas is the region between the left separator run and (optionally) a
281:     # right-side separator run near the far edge (right legend panel).
282:     left_sep, right_sep = _split_canvas(g)
283:     left_sep_c1 = left_sep[1]
284:     canvas_c0 = left_sep_c1 + 1
285:     canvas_c1 = right_sep[0] if right_sep is not None else w
286:     main = g[:, canvas_c0:canvas_c1].copy()
287: 
288:     # Paint one constructed sprite per marker panel that lies outside the output canvas.
289:     marker_squares = _all_marker_panel_squares(g)
290:     assert marker_squares, "no marker panel found"
291: 
292:     # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).
293:     eff_h, eff_w = main.shape
294:     full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]
295:     if full6_cols:
296:         eff_w = min(full6_cols)
297:     full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]
298:     if full6_rows:
299:         eff_h = min(full6_rows)
300: 
301:     out = main.copy()
302:     composite_written = np.zeros(out.shape, dtype=bool)
303: 
304:     for marker_r0, marker_c0 in marker_squares:
305:         # Ignore marker panels inside the output canvas; only legends should drive drawing.
306:         if canvas_c0 <= marker_c0 < canvas_c1:
307:             continue
308: 
309:         if marker_c0 + 5 > w:
310:             continue
311:         panel = g[:, marker_c0 : marker_c0 + 5]
312: 
313:         unit = _extract_unit_sprite(panel)
314:         if unit is None:
315:             continue
316:         unit_sprite, unit_bb = unit
317: 
318:         frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)
319:         if frame_bb is None:
320:             continue
321:         fr0, fc0, fr1, fc1 = frame_bb
322:         frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]
323:         frame_mask0 = (frame != 0) & (frame != 6)
324:         _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))
325:         assert n8 == 1, f"frame must be 8-connected, got {n8} components"
326: 
327:         # Rotate layout according to clockhand.
328:         dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3
329:         frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)
330: 
331:         # Build composite by tiling the unit sprite into active frame cells.
332:         m_unit = (unit_sprite != 0) & (unit_sprite != 6)
333:         uh, uw = unit_sprite.shape
334:         fh, fw = frame_mask.shape
335:         comp = np.zeros((fh * uh, fw * uw), dtype=int)
336:         for i in range(fh):
337:             for j in range(fw):
338:                 if not frame_mask[i, j]:
339:                     continue
340:                 rr0 = i * uh
341:                 cc0 = j * uw
342:                 comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]
343: 
344:         pos = _position_indices_from_border_square(g, marker_r0, marker_c0)
345:         if pos is None:
346:             continue
347:         pr, pc = pos
348: 
349:         top = _anchor_to_top_left(pr, eff_h, comp.shape[0])
350:         left = _anchor_to_top_left(pc, eff_w, comp.shape[1])
351: 
352:         ch, cw = comp.shape
353:         for r in range(ch):
354:             rr = top + r
355:             assert 0 <= rr < out.shape[0], "sprite row out of canvas bounds"
356:             for c in range(cw):
357:                 cc = left + c
358:                 assert 0 <= cc < out.shape[1], "sprite col out of canvas bounds"
359:                 if out[rr, cc] == 6:
360:                     continue
361:                 val = int(comp[r, c])
362:                 if val != 0 and val != 6:
363:                     assert not composite_written[rr, cc], "composites must not overlap"
364:                     composite_written[rr, cc] = True
365:                     out[rr, cc] = val
366:     return out
367: 
368: # --------------- generator (refine_8conn_fill_overlap) ---------------
369: 
370: # ── CFG: tunable generation parameters ──────────────────────────────
371: GRID_H_RANGE = (20, 30)         # output grid height
372: GRID_W = 30                     # output grid width (fixed)
373: LEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]
374: UNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length
375: MIN_CANVAS_W = 8                # reject if canvas narrower than this
376: FRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)
377: FRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)
378: FRAME_DENSITY = 0.5             # density for random_sprite frame generation
379: BAND_WIDTH_MIN = 4              # minimum band width for canvas background
380: MARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)
381: USABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)
382: ROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets
383: GEN_RETRIES = 300               # max attempts in generate_input
