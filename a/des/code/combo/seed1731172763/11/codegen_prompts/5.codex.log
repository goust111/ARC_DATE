82:     def rec(prefix: list[int], remaining: int) -> None:
83:         if len(prefix) == band_count:
84:             if remaining == 0:
85:                 options.append(tuple(prefix))
86:             return
87:         slots_left = band_count - len(prefix) - 1
88:         for width in range(min_width, max_width + 1):
89:             remainder = remaining - width
90:             if min_width * slots_left <= remainder <= max_width * slots_left:
91:                 rec([*prefix, width], remainder)
92: 
