415: def _color_swap(sprite, c1, c2):
416:     """Return a copy of sprite with the two colors swapped."""
417:     sa, sb = sorted([c1, c2])
418:     out = sprite.copy()
419:     out[sprite == sa] = sb
420:     out[sprite == sb] = sa
421:     return out
