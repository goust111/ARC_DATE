        rw = random.randint(1, w)
        r0 = random.randint(0, h - rh)
        c0 = random.randint(0, w - rw)
        mask[r0 : r0 + rh, c0 : c0 + rw] = True
    return mask


def _random_mask_strokes(h: int, w: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
