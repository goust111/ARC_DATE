+
+PANEL_COUNT_RANGE = (3, 6)
+PANEL_HEIGHT_RANGE = (5, 9)
+PANEL_WIDTH_RANGE = (5, 9)
+SEPARATOR_WIDTH_RANGE = (1, 2)
+TEMPLATE_COLOR_COUNT_RANGE = (1, 3)
+MASK_DENSITY_RANGE = (0.28, 0.62)
