        return None

    for _ in range(100):
        mode = random.choice(("noise", "rectangles", "strokes"))
        if mode == "noise":
            mask = _random_mask_noise(h, w)
        elif mode == "rectangles":
            mask = _random_mask_rectangles(h, w)
        else:
