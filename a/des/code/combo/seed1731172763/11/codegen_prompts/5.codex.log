471: def _assign_anchors(legends, grid_h, canvas_w):
472:     """Assign anchor positions to legends, avoiding overlap for 2-legend case. Returns False on failure."""
473:     if len(legends) == 1:
474:         pr, pc = random.randint(0, 2), random.randint(0, 2)
475:         ch, cw = _comp_size(legends[0])
476:         legends[0].update(pr=pr, pc=pc,
477:                           comp_top=_anchor_to_top_left(pr, grid_h, ch),
478:                           comp_left=_anchor_to_top_left(pc, canvas_w, cw))
479:         return True
480: 
481:     a, b = legends[0], legends[1]
482:     a_ch, a_cw = _comp_size(a)
483:     b_ch, b_cw = _comp_size(b)
484:     valid_pairs = []
485:     for apr in range(3):
486:         for apc in range(3):
487:             at = _anchor_to_top_left(apr, grid_h, a_ch)
488:             al = _anchor_to_top_left(apc, canvas_w, a_cw)
489:             if at < 0 or al < 0 or at + a_ch > grid_h or al + a_cw > canvas_w:
490:                 continue
491:             for bpr in range(3):
492:                 for bpc in range(3):
493:                     bt = _anchor_to_top_left(bpr, grid_h, b_ch)
494:                     bl = _anchor_to_top_left(bpc, canvas_w, b_cw)
495:                     if bt < 0 or bl < 0 or bt + b_ch > grid_h or bl + b_cw > canvas_w:
496:                         continue
497:                     # Reject overlapping bounding boxes
498:                     if at < bt + b_ch and bt < at + a_ch and al < bl + b_cw and bl < al + a_cw:
499:                         continue
500:                     valid_pairs.append((apr, apc, at, al, bpr, bpc, bt, bl))
501:     if not valid_pairs:
502:         return False
503:     apr, apc, at, al, bpr, bpc, bt, bl = random.choice(valid_pairs)
504:     a.update(pr=apr, pc=apc, comp_top=at, comp_left=al)
505:     b.update(pr=bpr, pc=bpc, comp_top=bt, comp_left=bl)
506:     return True
