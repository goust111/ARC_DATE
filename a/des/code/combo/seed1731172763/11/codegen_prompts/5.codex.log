509: def _build_banded_canvas(grid_h, canvas_w, bg1, bg2):
510:     """Build a canvas with alternating horizontal or vertical color bands."""
511:     canvas = np.zeros((grid_h, canvas_w), dtype=int)
512:     band_dir = random.choice(["h", "v"])
513:     dim = grid_h if band_dir == "h" else canvas_w
514:     bw = random.randint(BAND_WIDTH_MIN, max(BAND_WIDTH_MIN, dim // 2))
515:     band_indices = np.arange(dim) // bw % 2
516:     colors = np.array([bg1, bg2])
517:     if band_dir == "h":
518:         canvas[:] = colors[band_indices][:, None]
519:     else:
520:         canvas[:] = colors[band_indices][None, :]
521:     return canvas
