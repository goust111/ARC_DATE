549: def _gen_attempt() -> np.ndarray | None:
550:     grid_h = random.randint(*GRID_H_RANGE)
551:     num_legends = random.choices([1, 2], weights=LEGEND_COUNT_WEIGHTS)[0]
552: 
553:     # Per legend: pick N, compute legend_w
554:     legends = []
555:     for _ in range(num_legends):
556:         N = random.randint(*UNIT_SIZE_RANGE)
557:         legends.append({"N": N, "legend_w": N + 2})
558: 
559:     # Layout widths
560:     left_lw = legends[0]["legend_w"]
561:     left_total = left_lw + 1  # legend + 1 separator col
562:     right_total = (1 + legends[1]["legend_w"]) if num_legends == 2 else 0
563:     canvas_w = GRID_W - left_total - right_total
564:     if canvas_w < MIN_CANVAS_W:
565:         return None
566: 
567:     # Color allocation
568:     colors = _allocate_colors(num_legends)
569:     if colors is None:
570:         return None
571:     unit_color_sets, (bg1, bg2), frame_colors = colors
572: 
573:     marker_r0 = grid_h - MARKER_PANEL_HEIGHT
574: 
575:     # Design each legend panel
576:     for li in range(num_legends):
577:         if not _design_legend(legends[li], unit_color_sets[li], frame_colors[li],
578:                               marker_r0, grid_h, canvas_w):
579:             return None
580: 
581:     # Assign anchor positions
582:     if not _assign_anchors(legends, grid_h, canvas_w):
583:         return None
584: 
585:     # Build canvas and overlay composites
586:     canvas = _build_banded_canvas(grid_h, canvas_w, bg1, bg2)
587:     output = _overlay_composites(canvas, legends)
588: 
589:     # Assemble input grid
590:     grid = np.zeros((grid_h, GRID_W), dtype=int)
591:     canvas_c0 = left_total
592:     grid[:, canvas_c0:canvas_c0 + canvas_w] = canvas
593: 
594:     _place_legend(grid, legends[0], col_start=0, sep_col=left_lw,
595:                   marker_r0=marker_r0, is_right=False)
596:     if num_legends == 2:
597:         r_sep = canvas_c0 + canvas_w
598:         _place_legend(grid, legends[1], col_start=r_sep + 1, sep_col=r_sep,
599:                       marker_r0=marker_r0, is_right=True)
600: 
601:     # Validate via solver
602:     try:
603:         if np.array_equal(main(grid), output):
604:             return grid
605:     except Exception:
606:         pass
607:     return None
608: 
