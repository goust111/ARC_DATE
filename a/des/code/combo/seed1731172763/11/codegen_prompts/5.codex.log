+        col += w
+
+    return grid
+
+
+def _build_expected_output(
+    template: np.ndarray,
+    panel_count: int,
+    complete_idx: int,
+    missing_masks: list[np.ndarray],
+    sep_w: int,
+) -> np.ndarray:
+    out = _build_input(template, panel_count, complete_idx, missing_masks, sep_w)
