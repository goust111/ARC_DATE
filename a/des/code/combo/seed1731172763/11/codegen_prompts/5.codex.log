424: def _design_legend(leg, unit_colors, frame_color, marker_r0, grid_h, canvas_w):
425:     """Fill in sprite, frame, and rotation for one legend dict. Returns False on failure."""
426:     N = leg["N"]
427:     uc1, uc2 = unit_colors
428: 
429:     # Unit sprite: NxN, fully filled, exactly 2 colors
430:     sprite = np.full((N, N), uc1, dtype=int)
431:     num_c2 = random.randint(1, N * N - 1)
432:     for p in random.sample(range(N * N), num_c2):
433:         sprite[p // N, p % N] = uc2
434: 
435:     legend_sprite = _color_swap(sprite, uc1, uc2)
436: 
437:     avail = marker_r0 - (N + 1)
438:     # Enumerate valid (frame_H, frame_W, rot_k) combos
439:     combos = []
440:     for fH in range(*FRAME_H_RANGE):
441:         if avail < fH + 1:
442:             continue
443:         for fW in range(*FRAME_W_RANGE):
444:             for rk in range(4):
445:                 rh, rw = (fH, fW) if rk % 2 == 0 else (fW, fH)
446:                 if rh * N <= grid_h and rw * N <= canvas_w:
447:                     combos.append((fH, fW, rk))
448:     if not combos:
449:         return False
450:     frame_H, frame_W, rot_k = random.choice(combos)
451: 
452:     frame_mask = random_sprite(
453:         frame_H, frame_W, density=FRAME_DENSITY, connectivity=8,
454:         color_palette=[1], symmetry="not_symmetric"
455:     ) != 0
456:     rot_frame = np.rot90(frame_mask, (-rot_k) % 4)
457: 
458:     leg.update(sprite=sprite, legend_sprite=legend_sprite, frame_mask=frame_mask,
459:                frame_H=frame_H, frame_W=frame_W, frame_color=frame_color,
460:                rot_k=rot_k, rotated_frame=rot_frame)
461:     return True
462: 
