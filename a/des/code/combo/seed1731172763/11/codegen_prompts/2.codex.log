+        elif mode == "line":
+            horizontal = rng.choice([False, True])
+            if horizontal and width >= 2:
+                line_w = rng.randint(2, width)
+                r0 = rng.randrange(height)
+                c0 = rng.randint(0, width - line_w)
+                mask[r0, c0:c0 + line_w] = True
+            elif not horizontal and height >= 2:
