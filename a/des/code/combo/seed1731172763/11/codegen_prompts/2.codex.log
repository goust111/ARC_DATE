+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    panel_rows = rng.randint(2, 4)
+    panel_cols = rng.randint(2, 4)
+    total_panels = panel_rows * panel_cols
+    num_groups = rng.randint(2, min(4, total_panels - 1))
