+        mask = np.zeros((height, width), dtype=bool)
+
+        if mode == "rect":
+            box_h = rng.randint(1, height)
+            box_w = rng.randint(1, width)
+            if box_h == height and box_w == width:
+                continue
+            r0 = rng.randint(0, height - box_h)
+            c0 = rng.randint(0, width - box_w)
