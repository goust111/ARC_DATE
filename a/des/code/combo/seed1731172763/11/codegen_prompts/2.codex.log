+    for border_color, group in zip(BORDER_COLORS, groups):
+        for r0, r1, c0, c1 in group["panels"]:
+            out[r0, c0:c1] = border_color
+            out[r1 - 1, c0:c1] = border_color
+            out[r0:r1, c0] = border_color
+            out[r0:r1, c1 - 1] = border_color
