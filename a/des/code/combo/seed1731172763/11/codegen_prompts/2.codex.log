+def _make_panel_prototype(panel_h: int, panel_w: int, rng: random.Random) -> np.ndarray:
+    panel = np.full((panel_h, panel_w), BLACK, dtype=int)
+    inner = panel[1:-1, 1:-1]
+    inner[_random_shape_mask(panel_h - 2, panel_w - 2, rng)] = rng.choice(PATTERN_COLORS)
+    return panel
