+    raise RuntimeError("failed to sample valid group sizes")
+
+
+def _layout_starts(count: int, panel_size: int) -> list[int]:
+    starts: list[int] = []
+    cursor = 0
+    for idx in range(count):
+        starts.append(cursor)
+        cursor += panel_size
+        if idx < count - 1:
+            cursor += 1
+    return starts
+
