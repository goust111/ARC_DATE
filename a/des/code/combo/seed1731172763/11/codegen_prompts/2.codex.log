+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+BORDER_COLORS = [RED, BLUE, GREEN, YELLOW, MAGENTA, ORANGE, CYAN, BROWN]
+PATTERN_COLORS = [MAGENTA, ORANGE, CYAN, BROWN]
+GENERATION_RETRIES = 200
