+
+def _find_components(grid: np.ndarray, bg: int = _BG, connectivity: int = 8) -> list[CoordArray]:
+    neighbors = _NEIGHBORS8 if connectivity == 8 else _NEIGHBORS4
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[CoordArray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in neighbors:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+
+    comps.sort(key=lambda coords: _bbox(coords))
+    return comps
+
+
+def _bbox(coords: CoordArray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return (
+        int(rows.min()),
+        int(cols.min()),
+        int(rows.max()),
+        int(cols.max()),
+    )
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
