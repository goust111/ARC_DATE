+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((int(r), int(c)))
+
+    while stack:
