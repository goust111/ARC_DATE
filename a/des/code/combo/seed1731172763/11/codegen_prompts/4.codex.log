+def _shape_info(coords: list[tuple[int, int]]) -> dict[str, object]:
+    pts = sorted(set(coords))
+    by_row: dict[int, list[int]] = defaultdict(list)
+    by_col: dict[int, list[int]] = defaultdict(list)
+    for dr, dc in pts:
+        by_row[dr].append(dc)
