+
+    grid = np.full((h, w), BG, dtype=int)
+    forbidden = np.zeros((h, w), dtype=bool)
+
+    for pair_idx in range(pair_count):
+        color = colors[pair_idx]
+        placed = False
+        for _ in range(PAIR_PLACEMENT_ATTEMPTS):
+            orientation = rng.choice(("H", "V"))
