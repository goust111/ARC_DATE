+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    h = rng.randint(*GRID_H_RANGE)
+    w = rng.randint(*GRID_W_RANGE)
+    area = h * w
+    max_pairs = _max_pairs_for_area(area)
+    pair_count = rng.randint(1, max_pairs)
