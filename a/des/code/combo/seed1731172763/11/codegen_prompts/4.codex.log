+        coords = [(dr, dc) for dr in range(-radius, radius + 1) for dc in range(-radius, radius + 1) if abs(dr) + abs(dc) <= radius]
+    else:
+        h = rng.choice((3, 5))
+        w = rng.choice((3, 5))
