+        "coords": tuple(pts),
+        "by_row": {dr: tuple(dcs) for dr, dcs in by_row.items()},
+        "by_col": {dc: tuple(drs) for dc, drs in by_col.items()},
+        "rmin": min(dr for dr, _ in pts),
+        "rmax": max(dr for dr, _ in pts),
+        "cmin": min(dc for _, dc in pts),
