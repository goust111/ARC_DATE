+                    if 0 <= rr < height and 0 <= cc < width and not seen[rr, cc] and int(g[rr, cc]) == color:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+
+            rows = [r for r, _c in coords]
+            cols = [c for _r, c in coords]
+            objects.append(
