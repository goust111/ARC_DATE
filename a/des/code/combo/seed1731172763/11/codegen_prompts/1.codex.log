+    if len(objects) != n_objects:
+        return None
+
+    expected = _render_expected(grid_h, grid_w, descriptors)
+    if not np.array_equal(main(grid), expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
