    for color, expected_count in zip(PALETTE_ORDER, counts):
        mask = grid == color
        if expected_count == 0:
            if mask.any():
                return False
        elif len(components_mask(mask, connectivity=8)) != expected_count:
            return False
    return True


def _solver_matches_expected(grid: np.ndarray, counts: list[int]) -> bool:
    try:
