+from __future__ import annotations
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+INPUT_COLORS = (5, 6, 7, 8, 9)
+KIND_TO_OUTPUT = {
+    ("cold", "deep"): BLUE,
+    ("cold", "light"): GREEN,
+    ("warm", "deep"): RED,
+    ("warm", "light"): YELLOW,
+}
