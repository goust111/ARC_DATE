    vertical = bool(np.array_equal(mask, mask[:, ::-1]))
    diagonal = bool(
        mask.shape[0] == mask.shape[1]
        and (np.array_equal(mask, mask.T) or np.array_equal(mask, np.fliplr(mask).T))
    )
    if sum((horizontal, vertical, diagonal)) != 1:
        return None
    if horizontal:
        return "H"
    if vertical:
        return "V"
    return "D"


