+def _weighted_choice_index(rng: np.random.Generator, weights: np.ndarray) -> int:
+    total = float(weights.sum())
+    assert total > 0.0
+    pick = float(rng.random() * total)
+    running = 0.0
+    for idx, weight in enumerate(weights):
+        running += float(weight)
+        if pick <= running:
+            return idx
+    return len(weights) - 1
