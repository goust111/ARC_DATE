+    max_w = max(min_w + 1, 25)
+    grid_h = int(rng.integers(min_h, max_h))
+    grid_w = int(rng.integers(min_w, max_w))
+
+    grid = _place_objects(rng, (grid_h, grid_w), objects)
+    if grid is None:
+        return None
+
+    try:
+        main(grid)
+    except Exception:
+        return None
+    return grid
+
