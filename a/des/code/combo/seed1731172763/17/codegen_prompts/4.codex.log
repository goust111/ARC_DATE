+from __future__ import annotations
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+INPUT_COLORS = (5, 6, 7, 8, 9)
+KIND_TO_OUTPUT = {
+    ("cold", "deep"): BLUE,
+    ("cold", "light"): GREEN,
+    ("warm", "deep"): RED,
+    ("warm", "light"): YELLOW,
+}
+KIND_ORDER = tuple(KIND_TO_OUTPUT)
+
+SHAPE_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 200
+GENERATION_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_components(grid: np.ndarray) -> list[tuple[int, np.ndarray]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[tuple[int, np.ndarray]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BACKGROUND or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            components.append((color, np.array(coords, dtype=int)))
+
+    return components
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
