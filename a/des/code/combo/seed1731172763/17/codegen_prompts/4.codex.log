+        return True
+    if np.array_equal(mask, np.fliplr(mask)):
+        return True
+    if np.array_equal(mask, np.rot90(mask, 2)):
+        return True
+    if mask.shape[0] == mask.shape[1]:
+        if np.array_equal(mask, mask.T):
