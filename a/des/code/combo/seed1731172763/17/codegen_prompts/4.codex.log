+        row_lo = 1 if h - obj_h >= 2 else 0
+        row_hi = h - obj_h - 1 if h - obj_h >= 2 else h - obj_h
+        col_lo = 1 if w - obj_w >= 2 else 0
+        col_hi = w - obj_w - 1 if w - obj_w >= 2 else w - obj_w
