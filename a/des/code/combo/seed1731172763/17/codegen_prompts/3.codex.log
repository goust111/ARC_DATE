+    for color_value in np.unique(grid):
+        color = int(color_value)
+        if color == bg:
+            continue
+
+        rows, cols = np.where(grid == color)
+        assert rows.size > 0, "each non-background color must be present"
+
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
