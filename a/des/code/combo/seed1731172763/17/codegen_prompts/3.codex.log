+    elif corner == "bl":
+        mask[r0 : r0 + leg_h, c0] = True
+        mask[r0 + leg_h - 1, c0 : c0 + leg_w] = True
+    else:
+        mask[r0 : r0 + leg_h, c0 + leg_w - 1] = True
