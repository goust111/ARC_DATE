+def _random_polyomino(height: int, width: int, rng: random.Random) -> np.ndarray:
+    total = height * width
+    target = rng.randint(1, max(1, min(total - 1, (total + 1) // 2)))
+    cells = {(rng.randrange(height), rng.randrange(width))}
+    while len(cells) < target:
