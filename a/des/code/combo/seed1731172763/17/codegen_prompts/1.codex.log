+def _norm_with_dims(points: Iterable[tuple[int, int]]) -> tuple[tuple[tuple[int, int], ...], int, int]:
+    norm = _normalize(points)
+    h = max(r for r, _ in norm) + 1
+    w = max(c for _, c in norm) + 1
+    return norm, h, w
+
