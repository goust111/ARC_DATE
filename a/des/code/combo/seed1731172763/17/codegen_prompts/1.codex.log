+def _normalize(points: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = list(points)
+    r0, c0, _, _ = _bbox(pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
