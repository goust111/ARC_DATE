+def _line(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r1, c1 = a
+    r2, c2 = b
+    if r1 == r2:
+        step = 1 if c2 >= c1 else -1
+        return [(r1, c) for c in range(c1, c2 + step, step)]
+    if c1 == c2:
