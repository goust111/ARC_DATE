+def _legend_bbox(h: int, w: int, entry_count: int, corner: str) -> tuple[int, int, int, int]:
+    height = 2 * entry_count - 1
+    if corner in ("tl", "tr"):
+        r0 = 0
+    else:
+        r0 = h - height
+    if corner in ("tl", "bl"):
+        c0 = 0
+    else:
+        c0 = w - 3
+    return (r0, c0, r0 + height - 1, c0 + 2)
