+    return random.choice(bottom_rows), random.choice(right_cols)
+
+
+def _render_horizontal(
+    inp: np.ndarray, out: np.ndarray, rect: tuple[int, int, int, int], pair: tuple[int, int], mix: int
+) -> None:
