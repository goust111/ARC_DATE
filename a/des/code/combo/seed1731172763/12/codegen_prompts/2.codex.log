+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 8
+GREY = 5
+VISIBLE_COLORS = (0, 1, 2, 3, 4, 6, 7, 9)
+TEMPLATES = ("h", "v", "hv", "vh")
+GEN_RETRIES = 400
