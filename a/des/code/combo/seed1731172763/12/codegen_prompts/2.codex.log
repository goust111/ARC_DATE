+        if found is None:
+            return None
+        placed.append(
+            {
+                "pair": spec["pair"],
+                "mix": spec["mix"],
+                "template": spec["template"],
+                "rect": found,
+            }
+        )
+    return placed
+
+
+def _corner_pos(rect: tuple[int, int, int, int], corner: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    top_rows = [r0 + 1, r0 + 2]
+    bottom_rows = [r0 + h - 4, r0 + h - 3]
+    left_cols = [c0 + 1, c0 + 2]
