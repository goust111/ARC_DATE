+    segments = 0
+    prev_color: int | None = None
+    for value in np.asarray(row, dtype=int):
+        color = int(value)
+        if color == BG:
+            prev_color = None
+            continue
+        if prev_color != color:
+            segments += 1
+        prev_color = color
+    return segments
+
+
+def _row_is_scattered(row: np.ndarray) -> bool:
+    arr = np.asarray(row, dtype=int)
