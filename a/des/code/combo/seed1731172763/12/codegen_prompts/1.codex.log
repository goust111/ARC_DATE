+
+RNG = np.random.default_rng()
+BG = 0
+DIRS = ("up", "down", "left", "right")
+MAX_GENERATION_ATTEMPTS = 300
+OBJECT_COUNT_CHOICES = (4, 5)
+MIN_SHAPE_DIM = 3
+MAX_STANDARD_HEIGHT = 15
+MAX_STANDARD_WIDTH = 17
+PLACEMENT_MARGIN = 1
+PLACEMENT_TRIES = 250
