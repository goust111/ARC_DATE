+def _rotate_up_shape_to_direction(shape: np.ndarray, direction: str) -> np.ndarray:
+    k_by_direction = {"up": 0, "left": 1, "down": 2, "right": 3}
+    return np.rot90(shape, k_by_direction[direction])
