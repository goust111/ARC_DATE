+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    color_values = np.unique(grid[rows, cols])
+    assert color_values.size == 1, "each object must be monochromatic"
+    color = int(color_values[0])
+
+    shape = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    shape[rows - r0, cols - c0] = color
