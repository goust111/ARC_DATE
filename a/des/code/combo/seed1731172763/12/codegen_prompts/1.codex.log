+        if not closed
+    ]
+    assert len(openings) == 1, "expected exactly one opening side"
+    return openings[0]
+
+
+def _make_up_u(height: int, width: int, color: int) -> np.ndarray:
+    assert height >= MIN_SHAPE_DIM and width >= MIN_SHAPE_DIM
+    shape = np.zeros((height, width), dtype=int)
+    shape[:, 0] = color
+    shape[:, -1] = color
+    shape[-1, :] = color
