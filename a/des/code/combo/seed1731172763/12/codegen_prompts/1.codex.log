+            occupied[top : top + h, left : left + w] = True
+            placed = True
+            break
+        if not placed:
+            return None
+
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    count = int(RNG.choice(np.array(OBJECT_COUNT_CHOICES)))
+    dims = _sample_nested_dimensions(count)
