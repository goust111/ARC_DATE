+        for _ in range(PLACEMENT_ATTEMPTS):
+            cr = int(rng.integers(radius, h - radius))
+            cc = int(rng.integers(radius, w - radius))
+            bbox = (cr - radius, cc - radius, cr + radius, cc + radius)
