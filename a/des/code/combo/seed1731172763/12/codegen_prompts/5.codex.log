+    bg, crosses = _extract_crosses(g)
+
+    out = np.full(g.shape, bg, dtype=int)
+    for cr, cc, radius, fill_color in crosses:
+        r0 = cr - radius
+        r1 = cr + radius + 1
+        c0 = cc - radius
+        c1 = cc + radius + 1
+        assert np.all(out[r0:r1, c0:c1] == bg), "output squares must not overlap"
+        out[r0:r1, c0:c1] = fill_color
+    return out
+
