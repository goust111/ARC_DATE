+def _collect_component(mask: np.ndarray, start: tuple[int, int], seen: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    stack = [start]
+    seen[start] = True
+    pts = [start]
+
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and not bool(seen[rr, cc]):
+                seen[rr, cc] = True
+                stack.append((rr, cc))
+                pts.append((rr, cc))
+
+    return pts
+
