+        radii[0] = int(rng.choice(larger))
+
+    rng.shuffle(radii)
+    radii.sort(reverse=True)
+    return radii
+
+
+def _bbox_is_free(reserved: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> bool:
+    h, w = reserved.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
