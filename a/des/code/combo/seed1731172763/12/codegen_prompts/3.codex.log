+from __future__ import annotations
+
+import numpy as np
+
+
+TL = 0
+TR = 1
+BL = 2
+BR = 3
+QUADRANTS = (TL, TR, BL, BR)
+
+BG = 0
+MIN_FRAME_SIZE = 6
+MAX_FRAME_SIZE = 11
+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (22, 31)
+FRAME_COUNT_RANGE = (2, 5)
+MAX_GEN_ATTEMPTS = 400
