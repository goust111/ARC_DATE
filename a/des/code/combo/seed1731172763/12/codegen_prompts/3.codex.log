+    c1 = int(c0 + fw - 1)
+    if quad == TL:
+        return int(r0 - dr), int(c0 - dc)
+    if quad == TR:
+        return int(r0 - dr), int(c1 + dc)
+    if quad == BL:
+        return int(r1 + dr), int(c0 - dc)
+    return int(r1 + dr), int(c1 + dc)
+
