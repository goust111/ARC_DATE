+    for idx, frame in enumerate(frames):
+        if idx not in assignments:
+            continue
+        top, left, h2, w2 = _inner_copy_origin(frame, assignments[idx])
+        _draw_frame(out, top, left, h2, w2, int(frame["color"]))
