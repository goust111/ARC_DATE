+def _quadrants_for_count(rng: np.random.Generator, n: int) -> list[int]:
+    if n <= 4:
+        return [int(q) for q in rng.permutation(np.array(QUADRANTS))[:n]]
+    quads = [int(q) for q in rng.permutation(np.array(QUADRANTS))]
