+def _frame_info(comp: dict) -> dict | None:
+    coords = comp["coords"]
+    color = int(comp["color"])
+    rs = coords[:, 0]
+    cs = coords[:, 1]
+    r0 = int(rs.min())
+    c0 = int(cs.min())
+    r1 = int(rs.max())
+    c1 = int(cs.max())
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * h + 2 * w - 4:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    mask[rs - r0, cs - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(mask, border):
+        return None
+
+    return {
