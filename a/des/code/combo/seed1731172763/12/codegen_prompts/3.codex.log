+            r0, c0, fh, fw, dr, dc = sample
+            mr, mc = _marker_for_frame(r0, c0, fh, fw, dr, dc, quad)
+            r1 = int(r0 + fh - 1)
+            c1 = int(c0 + fw - 1)
