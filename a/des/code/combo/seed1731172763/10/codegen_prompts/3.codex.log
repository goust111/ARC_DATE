+import numpy as np
+from collections import deque
+
+
+BG = 8
+FG_COLORS = tuple(color for color in range(10) if color != BG)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+RNG = np.random.default_rng()
