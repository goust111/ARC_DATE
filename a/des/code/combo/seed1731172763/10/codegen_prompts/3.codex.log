+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == BG:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != BG:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            components.append(
+                {
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+
+    return components
+
+
+def _spiral_coords(h: int, w: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    top, bottom = 0, h - 1
+    left, right = 0, w - 1
+
+    while top <= bottom and left <= right:
+        for c in range(left, right + 1):
+            coords.append((top, c))
+        top += 1
+
+        for r in range(top, bottom + 1):
+            coords.append((r, right))
+        right -= 1
+
+        if top <= bottom:
+            for c in range(right, left - 1, -1):
+                coords.append((bottom, c))
+            bottom -= 1
+
+        if left <= right:
+            for r in range(bottom, top - 1, -1):
+                coords.append((r, left))
+            left += 1
+
+    return coords
+
+
+def _spiral_repack(patch: np.ndarray) -> np.ndarray:
+    h, w = patch.shape
+    seq = [int(patch[r, c]) for r, c in _spiral_coords(h, w)]
+    return np.array(seq, dtype=int).reshape(h, w)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Spiral-read each foreground object's bbox and stack the repacked rectangles."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
