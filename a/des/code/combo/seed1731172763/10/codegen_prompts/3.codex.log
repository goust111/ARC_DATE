+GRID_MAX = 30
+OBJECT_COUNT_MIN = 2
+OBJECT_COUNT_MAX_EXCLUSIVE = 5
+OBJECT_SIZE_MIN = 3
+OBJECT_SIZE_MAX = 6
+INPUT_GAP_MIN = 2
+INPUT_GAP_MAX = 4
