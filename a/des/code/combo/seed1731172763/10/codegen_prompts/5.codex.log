+    side = random.randint(*PANEL_SIDE_RANGE)
+    n_panels = n_rows * n_cols
+
+    touch_counts = [0, 1, 2, 3, 4]
+    touch_counts.extend(random.randint(0, 4) for _ in range(n_panels - len(touch_counts)))
