+    spans = []
+    prev_end = -1
+    for start, end in runs:
+        if prev_end + 1 < start:
+            spans.append((prev_end + 1, start))
+        prev_end = end
+    if prev_end + 1 < length:
+        spans.append((prev_end + 1, length))
+    return spans
