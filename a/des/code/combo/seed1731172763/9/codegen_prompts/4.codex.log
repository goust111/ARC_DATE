def _gen_pick_axis_layout() -> tuple[str, int]:
    axis_kind = random.choice(_GEN_AXIS_KINDS)
    if axis_kind in _GEN_CENTER_AXIS_KINDS:
        n = random.choice(_GEN_ODD_GRID_SIZES)
    else:
