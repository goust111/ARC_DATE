    legend_w = 3 * len(pairs) - 1
    for _ in range(PLACEMENT_ATTEMPTS):
        legend_h = random.randint(*LEGEND_HEIGHT_RANGE)
        body_h = random.randint(*BODY_HEIGHT_RANGE)
        min_width = max(BODY_WIDTH_RANGE[0], legend_w)
