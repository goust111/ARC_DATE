+
+def _place_objects(body_shape: tuple[int, int], specs: list[dict]) -> list[tuple[int, int]] | None:
+    occupied = np.zeros(body_shape, dtype=bool)
+    placements: list[tuple[int, int] | None] = [None] * len(specs)
