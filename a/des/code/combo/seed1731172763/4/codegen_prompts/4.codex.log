+import random
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+BRANCH_TYPES = (
+    "top",
+    "bottom",
+    "left",
+    "right",
+    "h_over_v_top",
+    "h_over_v_bottom",
+    "top_over_bottom",
+)
+
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+FRAME_COUNT_RANGE = (2, 4)
+INTERIOR_H_RANGE = (3, 10)
+INTERIOR_W_RANGE = (3, 11)
+PLACEMENT_PAD = 2
+MAX_GENERATION_ATTEMPTS = 400
+GEOMETRY_ATTEMPTS = 200
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_rect_frame(cells: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(cells)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * h + 2 * w - 4
+    if len(cells) != expected:
+        return False
+
+    cellset = set(cells)
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in cellset or (r, c1) not in cellset:
+            return False
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in cellset or (r1, c) not in cellset:
+            return False
+    for r, c in cells:
+        if r0 < r < r1 and c0 < c < c1:
+            return False
+    return True
+
+
+def _choose_edge_from_distances(d_top: int, d_bottom: int, d_left: int, d_right: int) -> str:
+    # Horizontal edges win ties; among them top wins; otherwise use left before right
+    # as a stable fallback for underspecified vertical-only ties.
+    candidates = [
+        ("top", d_top, 0, 0, 0),
+        ("bottom", d_bottom, 0, 1, 0),
+        ("left", d_left, 1, 1, 0),
+        ("right", d_right, 1, 1, 1),
+    ]
+    return min(candidates, key=lambda item: item[1:])[0]
+
+
+def _choose_edge_for_marker(
+    bbox: tuple[int, int, int, int], marker: tuple[int, int]
+) -> str:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
+    return _choose_edge_from_distances(
+        mr - (r0 + 1),
+        (r1 - 1) - mr,
+        mc - (c0 + 1),
+        (c1 - 1) - mc,
+    )
+
+
