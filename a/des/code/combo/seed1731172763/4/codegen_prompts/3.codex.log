        SLOT_COLS * cell_size + (SLOT_COLS + 1) * GAP,
    )


def _slot_origin(slot_index: int, cell_size: int) -> tuple[int, int]:
    slot_r, slot_c = divmod(slot_index, SLOT_COLS)
    return (
