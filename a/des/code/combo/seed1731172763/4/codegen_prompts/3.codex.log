    for r0 in range(h):
        for c0 in range(w):
            if seen[r0, c0] or int(grid[r0, c0]) == bg:
                continue

            color = int(grid[r0, c0])
            q = deque([(r0, c0)])
            seen[r0, c0] = True
            coords: list[tuple[int, int]] = []

            while q:
                r, c = q.popleft()
                coords.append((r, c))
                for rr, cc in _neighbors4(r, c):
                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc]:
                        if int(grid[rr, cc]) == color:
                            seen[rr, cc] = True
                            q.append((rr, cc))

            rows = [r for r, _ in coords]
            cols = [c for _, c in coords]
            r1, r2 = min(rows), max(rows)
            c1, c2 = min(cols), max(cols)
            mask = np.zeros((r2 - r1 + 1, c2 - c1 + 1), dtype=bool)
            for r, c in coords:
                mask[r - r1, c - c1] = True

            objects.append(
                {
                    "color": color,
                    "bbox": (r1, c1, r2, c2),
                    "mask": mask,
                    "h": int(mask.shape[0]),
                    "w": int(mask.shape[1]),
                    "area": int(mask.sum()),
                }
            )

    return objects


def _has_enclosed_background(mask: np.ndarray) -> bool:
    bg_mask = ~mask
    if not bool(bg_mask.any()):
        return False

    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    q: deque[tuple[int, int]] = deque()

    for r in range(h):
        for c in (0, w - 1):
            if bg_mask[r, c] and not seen[r, c]:
