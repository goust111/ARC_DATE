+def _is_isolated(cell: tuple[int, int], taken: set[tuple[int, int]]) -> bool:
+    r, c = cell
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if (r + dr, c + dc) in taken:
