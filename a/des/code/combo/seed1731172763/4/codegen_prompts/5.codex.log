+        c0 = rng.randint(1, w - rw - 1)
+        rect = (r0, c0, r0 + rh - 1, c0 + rw - 1)
+        if all(not _expanded_intersects(rect, other, pad=1) for other in keepouts):
+            return rect
+    return None
