+    total_extra = random.randint(1, budget)
+    positions = [0] * len(widths)
+
+    if gravity_right:
+        extras = _split_nonnegative(total_extra, len(widths))
+        between = extras[:-1]
+        right_gap = extras[-1]
+        cursor = width - 1 - right_gap
