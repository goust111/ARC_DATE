+def _choose_lines(candidates: list[int], count: int, min_gap: int) -> list[int] | None:
+    if count == 1:
+        return [random.choice(candidates)] if candidates else None
+    options = [
+        [a, b]
+        for i, a in enumerate(candidates)
+        for b in candidates[i + 1 :]
+        if abs(a - b) >= min_gap
