+    if int(coords.shape[0]) != 3:
+        return None
+
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    matches: list[dict] = []
+
+    if (
+        int(cols.min()) == 0
+        and int(cols.max()) == 1
+        and int(rows.max() - rows.min()) == 1
+        and int(np.count_nonzero(cols == 0)) == 2
+        and int(np.count_nonzero(cols == 1)) == 1
+    ):
+        tip = coords[cols == 1][0]
+        matches.append(
+            {
+                "axis": "h",
+                "line": int(tip[0]),
+                "direction": "right",
+                "side": "left",
+                "tip": (int(tip[0]), int(tip[1])),
+                "coords": coords.copy(),
+            }
+        )
+
+    if (
+        int(cols.min()) == w - 2
+        and int(cols.max()) == w - 1
+        and int(rows.max() - rows.min()) == 1
+        and int(np.count_nonzero(cols == w - 1)) == 2
+        and int(np.count_nonzero(cols == w - 2)) == 1
+    ):
+        tip = coords[cols == w - 2][0]
+        matches.append(
+            {
+                "axis": "h",
+                "line": int(tip[0]),
+                "direction": "left",
+                "side": "right",
+                "tip": (int(tip[0]), int(tip[1])),
+                "coords": coords.copy(),
+            }
+        )
+
+    if (
+        int(rows.min()) == 0
+        and int(rows.max()) == 1
+        and int(cols.max() - cols.min()) == 1
+        and int(np.count_nonzero(rows == 0)) == 2
+        and int(np.count_nonzero(rows == 1)) == 1
+    ):
+        tip = coords[rows == 1][0]
+        matches.append(
+            {
+                "axis": "v",
+                "line": int(tip[1]),
+                "direction": "down",
+                "side": "top",
+                "tip": (int(tip[0]), int(tip[1])),
+                "coords": coords.copy(),
+            }
+        )
+
+    if (
+        int(rows.min()) == h - 2
+        and int(rows.max()) == h - 1
+        and int(cols.max() - cols.min()) == 1
+        and int(np.count_nonzero(rows == h - 1)) == 2
+        and int(np.count_nonzero(rows == h - 2)) == 1
+    ):
+        tip = coords[rows == h - 2][0]
+        matches.append(
+            {
+                "axis": "v",
+                "line": int(tip[1]),
+                "direction": "up",
+                "side": "bottom",
+                "tip": (int(tip[0]), int(tip[1])),
