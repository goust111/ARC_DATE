+        extras = _split_nonnegative(total_extra, len(heights))
+        between = extras[:-1]
+        bottom_gap = extras[-1]
+        cursor = height - 1 - bottom_gap
+        for i in range(len(heights) - 1, -1, -1):
+            positions[i] = int(cursor - heights[i] + 1)
+            cursor = positions[i] - 1
+            if i > 0:
+                cursor -= between[i - 1]
+        if positions[0] < margin:
+            return None
+    else:
+        extras = _split_nonnegative(total_extra, len(heights))
+        top_gap = extras[0]
+        between = extras[1:]
+        cursor = top_gap
