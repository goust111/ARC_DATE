+def _arrow_cells(side: str, line: int, h: int, w: int) -> list[tuple[int, int]]:
+    if side == "left":
+        if random.random() < 0.5:
+            return [(line, 1), (line, 0), (line - 1, 0)]
+        return [(line, 1), (line, 0), (line + 1, 0)]
+    if side == "right":
+        if random.random() < 0.5:
+            return [(line, w - 2), (line, w - 1), (line - 1, w - 1)]
+        return [(line, w - 2), (line, w - 1), (line + 1, w - 1)]
+    if side == "top":
+        if random.random() < 0.5:
+            return [(1, line), (0, line), (0, line - 1)]
+        return [(1, line), (0, line), (0, line + 1)]
+    if random.random() < 0.5:
