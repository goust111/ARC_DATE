+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+ARROW = 9
+NON_SPECIAL_COLORS = [0, 1, 2, 3, 4, 5, 6, 7]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
