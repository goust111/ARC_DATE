+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+ARROW = 9
+NON_SPECIAL_COLORS = [0, 1, 2, 3, 4, 5, 6, 7]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _extract_objects(grid: np.ndarray, arrow_mask: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if bool(seen[r, c]) or bool(arrow_mask[r, c]) or int(grid[r, c]) == BG:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if bool(seen[nr, nc]) or bool(arrow_mask[nr, nc]) or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            pts = np.array(coords, dtype=int)
+            r0, c0 = pts.min(axis=0)
+            r1, c1 = pts.max(axis=0)
+            rel = pts - np.array([r0, c0], dtype=int)
+            mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+            mask[rel[:, 0], rel[:, 1]] = True
+            objects.append(
+                {
+                    "color": color,
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "h": int(mask.shape[0]),
+                    "w": int(mask.shape[1]),
+                    "cells": np.argwhere(mask),
+                }
+            )
+
+    return objects
+
+
+def _parse_arrow(coords: np.ndarray, shape: tuple[int, int]) -> dict | None:
+    h, w = shape
+    if int(coords.shape[0]) != 3:
+        return None
+
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    matches: list[dict] = []
+
+    if (
+        int(cols.min()) == 0
+        and int(cols.max()) == 1
+        and int(rows.max() - rows.min()) == 1
+        and int(np.count_nonzero(cols == 0)) == 2
+        and int(np.count_nonzero(cols == 1)) == 1
+    ):
+        tip = coords[cols == 1][0]
+        matches.append(
+            {
+                "axis": "h",
+                "line": int(tip[0]),
+                "direction": "right",
+                "side": "left",
+                "tip": (int(tip[0]), int(tip[1])),
+                "coords": coords.copy(),
+            }
+        )
+
+    if (
+        int(cols.min()) == w - 2
+        and int(cols.max()) == w - 1
+        and int(rows.max() - rows.min()) == 1
+        and int(np.count_nonzero(cols == w - 1)) == 2
+        and int(np.count_nonzero(cols == w - 2)) == 1
+    ):
+        tip = coords[cols == w - 2][0]
+        matches.append(
+            {
+                "axis": "h",
+                "line": int(tip[0]),
+                "direction": "left",
+                "side": "right",
+                "tip": (int(tip[0]), int(tip[1])),
+                "coords": coords.copy(),
+            }
+        )
