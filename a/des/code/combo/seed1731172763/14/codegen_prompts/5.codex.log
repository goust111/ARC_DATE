+        and int(np.count_nonzero(cols == w - 1)) == 2
+        and int(np.count_nonzero(cols == w - 2)) == 1
+    ):
+        tip = coords[cols == w - 2][0]
+        matches.append(
+            {
+                "axis": "h",
+                "line": int(tip[0]),
+                "direction": "left",
+                "side": "right",
+                "tip": (int(tip[0]), int(tip[1])),
