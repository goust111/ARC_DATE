+def _intersects_line(obj: dict, arrow: dict) -> bool:
+    if arrow["axis"] == "h":
+        return bool(np.any(obj["cells"][:, 0] + int(obj["r0"]) == int(arrow["line"])))
+    return bool(np.any(obj["cells"][:, 1] + int(obj["c0"]) == int(arrow["line"])))
