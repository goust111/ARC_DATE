+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
