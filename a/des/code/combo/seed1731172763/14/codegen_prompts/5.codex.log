+def _scatter_vertical(heights: list[int], gravity_down: bool, height: int, margin: int = 2) -> list[int] | None:
+    span = sum(heights)
+    budget = int(height - margin - span)
+    if budget < 1:
+        return None
+
+    total_extra = random.randint(1, budget)
+    positions = [0] * len(heights)
+
