    n = blocked.shape[0]
    for r_raw, c_raw in coords:
        r = int(r_raw)
        c = int(c_raw)
        blocked[r, c] = True
        for dr, dc in _GEN_DIRS4:
            rr = r + dr
            cc = c + dc
            if 0 <= rr < n and 0 <= cc < n:
                blocked[rr, cc] = True


