    if side == "lower":
        return rows - cols >= LOCAL_DIAGONAL_GAP
    raise AssertionError(f"unknown side: {side}")


def _mark_blocked(blocked: np.ndarray, cells: list[tuple[int, int]]) -> None:
    local_size = blocked.shape[0]
    for u, v in cells:
        for a, b in ((u, v), (v, u)):
            for du, dc in DIRS8:
