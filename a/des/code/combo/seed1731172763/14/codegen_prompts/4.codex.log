+        RNG.shuffle(anchors)
+        shapes = list(PATTERN_SHAPES)
+        RNG.shuffle(shapes)
+
+        placed = False
+        for shape in shapes:
+            for anchor_r, anchor_c in anchors:
+                if not _cluster_fits(shape, anchor_r, anchor_c, allowed, occupied):
+                    continue
+                for dr, dc in shape:
+                    rr = int(anchor_r + dr)
+                    cc = int(anchor_c + dc)
+                    pattern[rr, cc] = int(color)
+                    occupied[rr, cc] = True
