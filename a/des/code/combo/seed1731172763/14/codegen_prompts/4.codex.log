+def _can_place(occupied: np.ndarray, top: int, left: int, height: int, width: int) -> bool:
+    h, w = occupied.shape
+    r0 = max(0, int(top) - PLACEMENT_MARGIN)
+    c0 = max(0, int(left) - PLACEMENT_MARGIN)
