+def _is_rectangular_frame(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+
+    rel = coords - np.array([r0, c0], dtype=int)
+    on_border = (
+        (rel[:, 0] == 0)
+        | (rel[:, 0] == h - 1)
+        | (rel[:, 1] == 0)
+        | (rel[:, 1] == w - 1)
+    )
+    if not bool(np.all(on_border)):
+        return False
+
+    expected = 2 * h + 2 * w - 4
+    if int(coords.shape[0]) != expected:
+        return False
