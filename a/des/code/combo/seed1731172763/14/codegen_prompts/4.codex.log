+def _nest_centered(parent: np.ndarray, child: np.ndarray) -> np.ndarray:
+    ph, pw = map(int, parent.shape)
+    ch, cw = map(int, child.shape)
+    assert ch <= ph - 4 and cw <= pw - 4, "child frame must fit with a one-pixel gap"
