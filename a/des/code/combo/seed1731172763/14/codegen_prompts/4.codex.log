+    items = _extract_frames(g)
+    items.sort(
+        key=lambda item: (
+            -int(item["complexity"]),
+            -int(item["area"]),
+            int(item["bbox"][0]),
+            int(item["bbox"][1]),
+        )
+    )
+    return _assemble_sorted_items(items)
