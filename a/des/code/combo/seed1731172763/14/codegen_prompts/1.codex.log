+def _area_preserving_dims(n_pairs: int) -> list[tuple[int, int]]:
+    area_to_dims: dict[int, list[tuple[int, int]]] = {}
+    for h in range(RECT_SIDE_MIN, RECT_SIDE_MAX + 1):
