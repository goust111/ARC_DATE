+    order = list(int(v) for v in RNG.permutation(len(masks)))
+
+    for idx in order:
+        mask = masks[idx]
+        color = int(colors[idx])
+        hh, ww = map(int, mask.shape)
+        coords = coords_list[idx]
+        candidates: list[tuple[int, int]] = []
+        for r0 in range(h - hh + 1):
+            for c0 in range(w - ww + 1):
