+    areas = sorted(area_to_dims)
+    chosen_areas = RNG.choice(areas, size=n_pairs, replace=False)
+    dims = [area_to_dims[int(area)][int(RNG.integers(len(area_to_dims[int(area)])))] for area in chosen_areas]
+    return dims
