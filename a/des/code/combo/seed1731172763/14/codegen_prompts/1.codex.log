+from __future__ import annotations
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 8
+RNG = np.random.default_rng()
+
+
+PAIR_COUNT_MIN = 2
+PAIR_COUNT_MAX = 4
+RECT_SIDE_MIN = 3
+RECT_SIDE_MAX = 6
+GRID_SIDE_MIN = 20
+GRID_SIDE_MAX = 30
+MAX_GENERATION_ATTEMPTS = 400
