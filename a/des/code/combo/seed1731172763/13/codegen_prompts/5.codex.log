+def _branch_of_scores(scores: dict[str, int]) -> str:
+    max_score = max(int(v) for v in scores.values())
+    winners = [direction for direction in PRIORITY if int(scores[direction]) == max_score]
+    if len(winners) == 1:
+        return winners[0]
+    if "top" in winners:
+        return "tie_top"
+    if "right" in winners:
+        return "tie_right"
+    return "other"
+
