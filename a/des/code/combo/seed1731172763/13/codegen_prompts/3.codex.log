+    w = random.randint(1, 5)
+    return np.full((h, w), color, dtype=int)
+
+
+def _hollow_patch(color: int) -> np.ndarray:
+    h = random.randint(3, 7)
+    w = random.randint(3, 7)
+    patch = np.full((h, w), BG, dtype=int)
+    patch[0, :] = color
