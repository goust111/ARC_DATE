+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+OBJECT_COLORS = (4, 5, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 400
+
+MARKER_BY_KIND = {
+    "solid": RED,
+    "partial": GREEN,
+    "hollow": BLUE,
+}
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+
+    return components
+
+
+def _is_hollow_frame(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    if not np.all(mask[0, :]) or not np.all(mask[-1, :]):
+        return False
+    if not np.all(mask[:, 0]) or not np.all(mask[:, -1]):
+        return False
+    return not np.any(mask[1:-1, 1:-1])
+
+
+def _kind_from_mask(mask: np.ndarray) -> str:
+    if np.all(mask):
+        return "solid"
+    if _is_hollow_frame(mask):
+        return "hollow"
+    return "partial"
+
