+            c0, c1 = min(cols), max(cols)
+            obj_h = r1 - r0 + 1
+            obj_w = c1 - c0 + 1
+            mask = np.zeros((obj_h, obj_w), dtype=bool)
+            for rr, cc in cells:
+                mask[rr - r0, cc - c0] = True
+
+            objects.append(
+                {
+                    "color": color,
+                    "area": len(cells),
+                    "bbox": (r0, c0, r1, c1),
+                    "h": obj_h,
+                    "w": obj_w,
+                    "mask": mask,
+                }
+            )
+
+    return objects
+
+
