+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
