+    r1 = min(H, top + h + 1)
+    c0 = max(0, left - 1)
+    c1 = min(W, left + w + 1)
+    occupied[r0:r1, c0:c1] = True
+
+
+def _place_objects(specs: list[dict], H: int, W: int) -> np.ndarray | None:
+    grid = np.full((H, W), BG_COLOR, dtype=int)
+    occupied = np.zeros((H, W), dtype=bool)
