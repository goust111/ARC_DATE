+                break
+            else:
+                return None
+
+    return specs
+
+
+def _free_positions(occupied: np.ndarray, h: int, w: int) -> list[tuple[int, int]]:
+    H, W = occupied.shape
+    positions: list[tuple[int, int]] = []
+    for r in range(H - h + 1):
