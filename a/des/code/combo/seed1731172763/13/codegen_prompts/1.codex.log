+SEP = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+
+
+def _separator_runs(grid: np.ndarray) -> list[tuple[int, int]]:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == SEP)]
+    assert cols, "expected at least one full grey separator column"
