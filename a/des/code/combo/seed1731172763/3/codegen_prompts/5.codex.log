+            grid[top + r, left + c] = color
+        r0 = max(0, top - GEN_MARGIN)
+        r1 = min(h, top + oh + GEN_MARGIN)
+        c0 = max(0, left - GEN_MARGIN)
+        c1 = min(w, left + ow + GEN_MARGIN)
+        blocked[r0:r1, c0:c1] = True
+        return True
+    return False
+
