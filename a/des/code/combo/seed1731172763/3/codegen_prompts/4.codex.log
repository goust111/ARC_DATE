+def _panel_slices(n: int, panel_h: int, panel_w: int) -> list[tuple[slice, slice]]:
+    return [
+        (
+            slice(r * (panel_h + 1), r * (panel_h + 1) + panel_h),
+            slice(c * (panel_w + 1), c * (panel_w + 1) + panel_w),
+        )
+        for r in range(n)
+        for c in range(n)
+    ]
