+def _max_room_count(root: Room) -> int:
+    r0, r1, c0, c1 = root
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    max_rows = max(1, (h + 1) // (MIN_ROOM_SPAN + 1))
+    max_cols = max(1, (w + 1) // (MIN_ROOM_SPAN + 1))
+    return max_rows * max_cols
