+def _find_objects(grid: np.ndarray) -> tuple[list[np.ndarray], np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    owner = np.full((h, w), -1, dtype=int)
+    objects: list[np.ndarray] = []
