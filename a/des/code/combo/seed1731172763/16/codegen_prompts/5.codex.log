+        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
+        for idx in _scatter_indices(box_area, count):
+            rr = int(r0 + idx // box_w)
+            cc = int(c0 + idx % box_w)
+            out[rr, cc] = int(color)
+
+    return out
