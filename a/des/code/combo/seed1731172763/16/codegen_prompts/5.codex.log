+        r0, c0, r1, c1 = obj["bbox"]
+        count = int(obj["area"])
+        box_h = int(r1 - r0 + 1)
+        box_w = int(c1 - c0 + 1)
+        box_area = int(box_h * box_w)
+        assert count <= box_area
