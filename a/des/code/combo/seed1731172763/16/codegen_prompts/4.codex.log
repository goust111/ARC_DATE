+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()) + 1, int(cols.max()) + 1
+
+
+def _panel_slices(grid: np.ndarray) -> list[slice]:
+    is_sep = np.all(grid == SEPARATOR, axis=0)
+    spans: list[slice] = []
+    c = 0
+    while c < grid.shape[1]:
+        while c < grid.shape[1] and is_sep[c]:
