+
+
+def _stamp_fits(
+    large_mask: np.ndarray,
+    large_top: int,
+    large_left: int,
+    small_mask: np.ndarray,
+    bounds: tuple[int, int, int, int],
+) -> bool:
+    lr0, lc0 = large_top, large_left
+    lh, lw = large_mask.shape
+    sh, sw = small_mask.shape
