+            return [ORTHOGONAL_SLOTS[int(_RNG.integers(0, len(ORTHOGONAL_SLOTS)))]]
+        return [DIAGONAL_SLOTS[int(_RNG.integers(0, len(DIAGONAL_SLOTS)))]]
