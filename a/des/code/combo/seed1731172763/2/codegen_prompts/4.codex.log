+def _manhattan_path(
+    a: tuple[int, int], b: tuple[int, int], first_axis: str
+) -> list[tuple[int, int]]:
+    if a[0] == b[0] or a[1] == b[1]:
+        return _segment(a, b)
+    corner = (a[0], b[1]) if first_axis == "h" else (b[0], a[1])
+    first = _segment(a, corner)
+    second = _segment(corner, b)
