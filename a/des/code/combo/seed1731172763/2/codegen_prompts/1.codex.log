+def _extract_panels(grid: np.ndarray) -> list[np.ndarray]:
+    grey_mask = grid == int(GREY)
+    r0, c0, r1, c1 = _bbox(grey_mask)
+    strip = grid[r0 : r1 + 1, c0 : c1 + 1]
