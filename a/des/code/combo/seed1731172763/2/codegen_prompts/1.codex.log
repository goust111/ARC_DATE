+def _paste_patch(canvas: np.ndarray, patch: np.ndarray, top: int, left: int, fill: int) -> None:
+    h, w = patch.shape
+    H, W = canvas.shape
+    for r in range(h):
+        for c in range(w):
+            rr = int(top + r)
+            cc = int(left + c)
+            if 0 <= rr < H and 0 <= cc < W and int(patch[r, c]) != int(fill):
+                canvas[rr, cc] = int(patch[r, c])
