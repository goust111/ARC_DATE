+        if not np.all(grid[r0 : r1 + 1, c0 : c1 + 1] != BG):
+            continue
+        touches_corner = (
+            (r0 == 0 and c0 == 0)
+            or (r0 == 0 and c1 == w - 1)
+            or (r1 == h - 1 and c0 == 0)
+            or (r1 == h - 1 and c1 == w - 1)
+        )
+        if touches_corner:
