+        if hv_clear:
+            orders.append("hv")
+            routes.append(hv)
+        else:
+            orders.append("vh")
+            routes.append(vh)
+    return orders, routes
+
+
+def _parse_objects(grid: np.ndarray) -> tuple[int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
