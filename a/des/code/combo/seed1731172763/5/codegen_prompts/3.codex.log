+    out_h = max(canvas.shape[0] for canvas in canvases)
+    out_w = sum(canvas.shape[1] for canvas in canvases) + GROUP_GAP * (len(canvases) - 1)
+    out = np.full((out_h, out_w), BG, dtype=int)
