+    cur_c = 0
+    for canvas in canvases:
+        hh, ww = canvas.shape
+        mask = canvas != BG
+        out[:hh, cur_c : cur_c + ww][mask] = canvas[mask]
+        cur_c += ww + GROUP_GAP
+
+    return out
