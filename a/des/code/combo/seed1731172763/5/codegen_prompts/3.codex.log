+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Group same-colored solid rectangles, infer the smallest axis-aligned gap per color,
+    and redraw each color group as concentric rectangular frames packed left-to-right.
+    """
+    return _solve(grid)
