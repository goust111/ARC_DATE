DENSE_COUNT_THRESHOLD = 6
DENSE_PREFERRED_MAX_SHORT_SIDE = 3
PACKED_COUNT_THRESHOLD = 4
PACKED_PREFERRED_MAX_SHORT_SIDE = 4

