+
+def _make_diamond(rng: np.random.Generator) -> np.ndarray:
+    radius = int(rng.integers(2, 5))
+    size = 2 * radius + 1
+    rr, cc = np.indices((size, size))
+    return (np.abs(rr - radius) + np.abs(cc - radius)) <= radius
