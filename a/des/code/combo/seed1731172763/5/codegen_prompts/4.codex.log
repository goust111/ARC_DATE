+    current_start = (start_pixel[0] + 1, start_pixel[1] + 1)
+    current_end = (current_start[0], current_start[1] + 1)
+    current_pixel = start_pixel
+    current_direction = 0
+    start_state = (current_start, current_end, current_pixel, current_direction)
