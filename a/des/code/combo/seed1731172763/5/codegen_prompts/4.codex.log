+        if pixel not in seen:
+            seen.add(pixel)
+            ordered.append(pixel)
+
+    if len(ordered) < len(contour_pixels):
+        missing = [pixel for pixel in contour_pixels if pixel not in seen]
+        ordered.extend(_clockwise_fallback(missing, start_pixel))
+
+    return ordered
+
