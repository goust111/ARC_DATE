+    cw = (w - 1) / 2.0
+    yr = max(1.25, h / 2.0 - 0.35)
+    xr = max(1.25, w / 2.0 - 0.35)
+    return ((rr - cr) / yr) ** 2 + ((cc - cw) / xr) ** 2 <= 1.0
