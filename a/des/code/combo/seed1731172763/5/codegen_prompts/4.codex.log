+        angle = angle_of(pixel)
+        clockwise_delta = (start_angle - angle) % tau
+        radius = (pixel[0] - center_r) ** 2 + (pixel[1] - center_c) ** 2
+        return clockwise_delta, -radius, pixel[0], pixel[1]
+
+    return sorted(pixels, key=sort_key)
