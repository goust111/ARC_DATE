+def _clockwise_fallback(
+    pixels: list[tuple[int, int]],
+    start_pixel: tuple[int, int],
+) -> list[tuple[int, int]]:
+    if not pixels:
+        return []
+
+    center_r = sum(r for r, _ in pixels) / len(pixels)
+    center_c = sum(c for _, c in pixels) / len(pixels)
