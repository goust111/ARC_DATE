+    out_h = 2 * len(bands) - 1
+    out_w = max(len(band) for band in bands)
+    out = np.zeros((out_h, out_w), dtype=int)
+    for idx, band in enumerate(bands):
+        out[2 * idx, : len(band)] = np.array(band, dtype=int)
+    return out
