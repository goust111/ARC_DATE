        groups.append(group)

    out_w = sum(group.shape[1] + 1 for group in groups)
    out = np.full((out_h, out_w), bg, dtype=int)
    c = 0
    for group in groups:
        w = group.shape[1]
        out[:, c:c + w] = group
        c += w + 1
    return out

