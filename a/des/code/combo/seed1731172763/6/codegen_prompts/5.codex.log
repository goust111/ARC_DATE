+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    return _coords_to_mask(coords)
+
+
+def _all_orientations(mask: np.ndarray) -> list[np.ndarray]:
+    base = _normalize_mask(mask)
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    out: list[np.ndarray] = []
