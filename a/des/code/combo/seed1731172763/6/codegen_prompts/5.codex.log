+
+LEGEND_MASKS = {
+    "single": np.array([[1, 0], [0, 0]], dtype=bool),
+    "domino": np.array([[1, 1], [0, 0]], dtype=bool),
+    "ell": np.array([[1, 1], [1, 0]], dtype=bool),
