+def _find_legend_entries(grid: np.ndarray, bg: int) -> tuple[int, list[dict]]:
+    grey_coords = np.argwhere(grid == GREY)
+    assert grey_coords.size > 0, "legend grey mask not found"
+    legend_r0 = int(grey_coords[:, 0].min())
