+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    rows, cols = np.where(mask)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            rr = rows + dr
+            cc = cols + dc
+            ok = (0 <= rr) & (rr < h) & (0 <= cc) & (cc < w)
+            out[rr[ok], cc[ok]] = True
+    return out
+
