HOLLOW_EXT_SIDE_W_RANGE = (1, 3)  # width range for left/right extensions
HOLLOW_HOLE_SEARCH_RETRIES = 200   # retries to find a valid hole position
HOLLOW_GEN_RETRIES = 50            # retries to build one hollow component
