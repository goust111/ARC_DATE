FG_COLOR = 1

# Component counts
COMP_COUNT_RANGE = (3, 4)          # total components per grid
HOLLOW_COUNT_RANGE = (1, 2)        # how many are hollow (capped by total - 1)

# Polyomino construction (solid shapes)
