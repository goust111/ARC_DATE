+BG = 0
+PALETTE = list(range(1, 10))
+
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+GEN_ATTEMPTS = 400
+GROUP_COUNT_OPTIONS = (2, 3)
+HOLEY_COUNTS = (1, 2, 3)
