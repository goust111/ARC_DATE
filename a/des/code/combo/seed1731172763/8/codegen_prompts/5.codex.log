+        while len(colors) < n_shapes:
+            colors.append(int(np.random.choice(extra_pool)))
+
+        placed_required = 0
+        ok = True
+        for i, color in enumerate(colors):
+            placed = False
+            for _ in range(SHAPE_PLACEMENT_ATTEMPTS):
+                stamp = _make_stamp(h, w)
+                if _place_stamp(region, stamp, int(color)):
