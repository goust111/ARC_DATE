+    box_b = _sample_box_from_core(
+        height,
+        width,
+        core,
+        up_range=LONG_EXTRA_RANGE,
+        down_range=SHORT_EXTRA_RANGE,
+        left_range=SHORT_EXTRA_RANGE,
