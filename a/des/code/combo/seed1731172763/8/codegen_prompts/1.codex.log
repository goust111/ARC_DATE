+    markers: list[set[tuple[int, int]]],
+    coverage: np.ndarray,
+) -> None:
+    used = set().union(*markers)
+    order = list(range(len(boxes)))
+    random.shuffle(order)
+    for idx in order:
+        if random.random() < 0.35:
+            continue
+
+        candidates_overlap = [
+            cell
+            for cell in _iter_box_cells(boxes[idx])
+            if int(coverage[cell]) >= 2 and cell not in used
