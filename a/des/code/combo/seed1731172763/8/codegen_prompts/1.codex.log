+
+def _sample_box_from_core(
+    height: int,
+    width: int,
+    core: tuple[int, int, int, int],
+    up_range: tuple[int, int],
+    down_range: tuple[int, int],
+    left_range: tuple[int, int],
+    right_range: tuple[int, int],
