+
+def _box_boundary(box: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells: list[tuple[int, int]] = []
+    for r in range(int(r0), int(r1) + 1):
+        for c in range(int(c0), int(c1) + 1):
+            if r in (int(r0), int(r1)) or c in (int(c0), int(c1)):
