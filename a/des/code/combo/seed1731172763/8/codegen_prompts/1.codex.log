+            for r, c in points:
+                if grid[int(r), int(c)] != BG:
+                    break
+                grid[int(r), int(c)] = int(color)
+            else:
+                continue
+            break
+        else:
+            ok = True
+            for color, box, points in zip(colors, boxes, markers, strict=False):
+                coords = np.argwhere(grid == int(color))
+                if len(coords) < 3:
+                    ok = False
