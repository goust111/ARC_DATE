+                            continue
+                        if int(coverage[r, c]) == 1:
+                            own_fill += 1
+                if own_fill < MIN_EXCLUSIVE_FILL:
+                    ok = False
+                    break
+
+            if not ok:
+                continue
+
+            out = _render_from_boxes(grid, colors, boxes)
+            if not np.array_equal(main(grid), out):
