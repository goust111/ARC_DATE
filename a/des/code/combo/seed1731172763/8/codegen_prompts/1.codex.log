+                r0, c0 = coords.min(axis=0)
+                r1, c1 = coords.max(axis=0)
+                if (int(r0), int(c0), int(r1), int(c1)) != box:
+                    ok = False
+                    break
+
+                own_fill = 0
+                for r in range(int(box[0]), int(box[2]) + 1):
+                    for c in range(int(box[1]), int(box[3]) + 1):
