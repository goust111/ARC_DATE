+GRID_W_RANGE = (14, 24)
+BOX_MIN_SIZE = 4
+BOX_MAX_SIZE = 9
+CORE_SIZE_RANGE = (2, 3)
+SHORT_EXTRA_RANGE = (0, 2)
+LONG_EXTRA_RANGE = (1, 4)
