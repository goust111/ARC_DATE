+def _corner_patterns(box: tuple[int, int, int, int]) -> list[tuple[tuple[int, int], ...]]:
+    r0, c0, r1, c1 = box
+    corners = [(int(r0), int(c0)), (int(r0), int(c1)), (int(r1), int(c0)), (int(r1), int(c1))]
+    patterns = [tuple(corners)]
+    for combo in combinations(corners, 3):
