+        if mode == "deep" and max_depth < 4:
+            continue
+        if mode != "deep" and max_depth < 3:
+            continue
+        if len(components) < OBJECT_COUNT_RANGE[0]:
+            continue
+        main(grid)
+        return grid
+
+    raise RuntimeError("failed to generate a valid ARC instance")

