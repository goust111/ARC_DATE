+
+    for r in range(h):
+        for c in range(w):
+            if int(g[r, c]) == BG or int(labels[r, c]) != -1:
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            labels[r, c] = len(components)
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((int(cr), int(cc)))
