+import numpy as np
+
+
+BG = 8
+RED = 2
+BLUE = 1
+GREEN = 3
+YELLOW = 4
+MAROON = 9
+
+DEPTH_COLORS = {
+    0: RED,
+    1: BLUE,
+    2: GREEN,
+    3: YELLOW,
+}
+
+INPUT_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_BY_DIR = {
+    (-1, 0): "up",
+    (1, 0): "down",
+    (0, -1): "left",
+    (0, 1): "right",
+}
+DIR_BY_SIDE = {name: delta for delta, name in SIDE_BY_DIR.items()}
+
+OBJECT_COUNT_RANGE = (4, 8)
+COARSE_SIZE_RANGE = (5, 7)
+TILE_SIZE_CHOICES = (4, 5, 6)
