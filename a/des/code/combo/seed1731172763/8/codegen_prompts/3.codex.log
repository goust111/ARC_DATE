+
+def _grow_branched_tree(
+    n_objects: int,
+    coarse_shape: tuple[int, int],
+    root: tuple[int, int],
+    trunk_depth: int,
+) -> tuple[list[tuple[int, int]], dict[tuple[int, int], tuple[int, int]], dict[tuple[int, int], int]] | None:
+    occupied = {root}
+    parent: dict[tuple[int, int], tuple[int, int]] = {}
