+
+def _coarse_neighbors(pos: tuple[int, int], coarse_shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = pos
+    h, w = coarse_shape
+    out = []
+    for dr, dc in DIRS4:
