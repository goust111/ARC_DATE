+
+def _random_connected_shape(
+    min_area: int = TARGET_SHAPE_AREA[0],
+    max_area: int = TARGET_SHAPE_AREA[1],
+    side_min: int = TARGET_SHAPE_SIDE[0],
+    side_max: int = TARGET_SHAPE_SIDE[1],
