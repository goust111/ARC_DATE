+    top_high = h - 1 - sh - row_max
+    left_low = 1 - col_min
+    left_high = w - 1 - sw - col_max
+    if top_low > top_high or left_low > left_high:
+        return None
+
+    top = random.randint(top_low, top_high)
+    left = random.randint(left_low, left_high)
