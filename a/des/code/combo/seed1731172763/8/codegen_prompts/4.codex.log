+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+ARRANGEMENT_DIRECTIONS = ((0, 1), (1, 0), (1, 1), (1, -1))
+
+MIN_GRID = 12
+MAX_GRID = 30
+TARGET_COUNT_SMALL = (3, 5)
+TARGET_COUNT_WRAP = 6
+TARGET_SHAPE_AREA = (3, 7)
+TARGET_SHAPE_SIDE = (2, 4)
+DISTRACTOR_COUNT_RANGE = (1, 3)
