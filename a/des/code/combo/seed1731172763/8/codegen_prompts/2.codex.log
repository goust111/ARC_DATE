# Canvas, palette, and retry budget.
BACKGROUND_COLOR = 0
FOREGROUND_COLORS = tuple(range(1, 10))
MAX_GRID_SIZE = 19
MIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)
GENERATION_RETRIES = 300

