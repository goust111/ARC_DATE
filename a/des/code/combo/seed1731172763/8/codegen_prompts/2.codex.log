+def _can_place(occupied: np.ndarray, top: int, left: int, h: int, w: int) -> bool:
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(occupied.shape[0], top + h + 1)
+    c1 = min(occupied.shape[1], left + w + 1)
+    return not bool(occupied[r0:r1, c0:c1].any())
+
