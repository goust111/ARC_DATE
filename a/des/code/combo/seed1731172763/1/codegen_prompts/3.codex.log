    marker_cols = np.count_nonzero(grid != BG_COLOR, axis=0)
    if marker_rows.max() < 2 and marker_cols.max() < 2:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

