        remaining_rows = [r for r in range(nrows) if r not in primary_rows]
        col_order = list(range(ncols))
        random.shuffle(col_order)
        for i, r in enumerate(remaining_rows):
            mask[r, col_order[i % ncols]] = True

    return mask


