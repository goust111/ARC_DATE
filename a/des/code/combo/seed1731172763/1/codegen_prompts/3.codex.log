import random

import numpy as np


BG_COLOR = 7
FILL_COLOR = 9
MARKER_COLORS = (1, 2, 3, 4, 5, 6, 8)

MIN_ACTIVE_ROWS = 2
MAX_ACTIVE_ROWS = 6
