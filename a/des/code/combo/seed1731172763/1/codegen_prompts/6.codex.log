  "type": "move_to_match",
  "src": "solid monochrome sprite s",
  "dst": "attach to an edge of hollow polychrome sprite d with bg corners and 4 differently-colored side edges",
  "match_cond": "s.head.color == d.edge.color and s.head.length == d.edge.length",
  "transform": "rotate s to align matching edge with d.side"
}
</annotation>
</reference_puzzle>

