+    return tuple("".join("1" if cell else "0" for cell in row) for row in mask)
+
+
+def _is_asymmetric(cells: set[tuple[int, int]]) -> bool:
+    mask = _tight_mask(cells)
+    keys = {_mask_key(np.rot90(mask, k)) for k in range(4)}
+    return len(keys) == 4
