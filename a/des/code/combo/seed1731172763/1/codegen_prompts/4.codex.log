+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    expanded.add((nr, nc))
+    return expanded
+
+
+def _corridor_cells(
+    obj_bbox: tuple[int, int, int, int],
+    direction: str,
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
