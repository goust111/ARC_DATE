+        saw_moved = np.any(out == YELLOW)
+        saw_locked = np.any(out == RED)
+        if not (saw_moved and saw_locked):
+            return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATE_ATTEMPTS):
+        grid = _gen_attempt(rng)
