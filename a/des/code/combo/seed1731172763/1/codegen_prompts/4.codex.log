+def _candidate_cells(spec: dict, top: int, left: int, shape: tuple[int, int]) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    container = set(_shift(_u_cells(spec["height"], spec["width"], spec["open_dir"]), top, left))
