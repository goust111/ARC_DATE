+    r0, c0, r1, c1 = obj_bbox
+    cells: set[tuple[int, int]] = set()
+    if direction == "up":
+        row_range = range(0, r1 + 1)
+        col_range = range(c0, c1 + 1)
+    elif direction == "down":
+        row_range = range(r0, h)
+        col_range = range(c0, c1 + 1)
+    elif direction == "left":
+        row_range = range(r0, r1 + 1)
+        col_range = range(0, c1 + 1)
+    else:
+        assert direction == "right"
+        row_range = range(r0, r1 + 1)
+        col_range = range(c0, w)
