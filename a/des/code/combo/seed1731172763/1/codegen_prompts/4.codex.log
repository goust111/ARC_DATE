+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(points)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_connected(points: Iterable[tuple[int, int]]) -> bool:
+    pts = set(points)
+    if not pts:
+        return False
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for nbr in _neighbors4(r, c):
+            if nbr in pts and nbr not in seen:
+                seen.add(nbr)
+                stack.append(nbr)
+    return len(seen) == len(pts)
+
+
+def _shift(points: Iterable[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:
+    return [(r + dr, c + dc) for r, c in points]
+
+
+def _u_cells(height: int, width: int, open_dir: str) -> list[tuple[int, int]]:
+    cells = set()
+    for r in range(height):
+        cells.add((r, 0))
+        cells.add((r, width - 1))
+    for c in range(width):
+        cells.add((0, c))
+        cells.add((height - 1, c))
+
+    if open_dir == "up":
+        for c in range(1, width - 1):
+            cells.discard((0, c))
+    elif open_dir == "down":
+        for c in range(1, width - 1):
+            cells.discard((height - 1, c))
+    elif open_dir == "left":
+        for r in range(1, height - 1):
+            cells.discard((r, 0))
+    else:
+        assert open_dir == "right"
+        for r in range(1, height - 1):
+            cells.discard((r, width - 1))
