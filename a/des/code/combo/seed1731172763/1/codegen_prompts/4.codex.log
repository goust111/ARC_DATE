+# --------------- generator ---------------
+
+
+def _balanced_match_flags(count: int, rng: random.Random) -> list[bool]:
+    if count == 1:
+        return [rng.choice([False, True])]
+    n_match = count // 2 if rng.random() < 0.5 else (count + 1) // 2
+    flags = [True] * n_match + [False] * (count - n_match)
+    rng.shuffle(flags)
+    return flags
