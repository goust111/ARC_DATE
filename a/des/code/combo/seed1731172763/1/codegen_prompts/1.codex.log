+    max_w = max(int(mask.shape[1]) for mask in hole_masks)
+    min_side = max(
+        MIN_FRAME_SIDE,
+        max_h + 2,
+        max_w + 2,
+        2 * n_holes + 1,
+        int(np.ceil(np.sqrt(sum(areas) * 2.2))) + 2,
+    )
+    candidates: list[tuple[int, int]] = []
+    for h in range(min_side, MAX_FRAME_SIDE + 1):
