+                    try:
+                        actual = main(canvas)
+                    except AssertionError:
+                        continue
+                    if np.array_equal(actual, expected):
+                        return canvas
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to build a valid input")

