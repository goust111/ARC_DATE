+        transformed = _apply_frame_rule(patch, int(patch[0, 0]), holes, colors)
+        hh, ww = transformed.shape
+        out[r0 : r0 + hh, c0 : c0 + ww] = transformed
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
