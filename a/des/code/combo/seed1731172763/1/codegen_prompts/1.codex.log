+
+
+def _paint_mask(canvas: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> None:
+    hh, ww = mask.shape
+    patch = canvas[r0 : r0 + hh, c0 : c0 + ww]
+    patch[mask] = int(color)
+
+
+def _place_sprites(
+    canvas_h: int,
+    canvas_w: int,
+    union_bbox: tuple[int, int, int, int],
+    sprite_masks: list[np.ndarray],
+    rng: random.Random,
