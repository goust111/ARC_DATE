+    def rec(idx: int, cur_blocked: np.ndarray) -> bool:
+        if idx == len(order):
+            return True
+        hole_idx = order[idx]
+        mask = masks[hole_idx]
+        hh, ww = mask.shape
+        candidates = [
+            (r, c)
+            for r in range(border_gap, board_h - hh - border_gap + 1)
+            for c in range(border_gap, board_w - ww - border_gap + 1)
