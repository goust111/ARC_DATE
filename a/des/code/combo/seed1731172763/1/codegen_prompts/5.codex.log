+                        continue
+                    if not np.all(grid[top, left : right + 1] == int(color)):
+                        continue
+                    if not np.all(grid[bottom, left : right + 1] == int(color)):
+                        continue
+                    if not np.all(grid[top : bottom + 1, left] == int(color)):
+                        continue
+                    if not np.all(grid[top : bottom + 1, right] == int(color)):
+                        continue
