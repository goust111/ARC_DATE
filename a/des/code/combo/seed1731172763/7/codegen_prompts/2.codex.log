+def _random_connected_mask(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(1, 5)
+    w = rng.randint(1, 5)
+    min_area = 2 if h * w > 1 else 1
+    max_area = min(h * w, 8)
+    if min_area > max_area:
+        return None
