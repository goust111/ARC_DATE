+    return min(variants)
+
+
+def _coords_from_mask(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:
+    coords = np.argwhere(mask).astype(int, copy=False)
+    coords[:, 0] += int(r0)
+    coords[:, 1] += int(c0)
