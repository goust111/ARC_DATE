+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(grid[r0, c0])
+            if color == BG or seen[r0, c0]:
+                continue
+
+            queue = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for dr, dc in DIRS4:
+                    nr, nc = r + dr, c + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r_min = int(arr[:, 0].min())
+            c_min = int(arr[:, 1].min())
+            r_max = int(arr[:, 0].max())
+            c_max = int(arr[:, 1].max())
+            mask = np.zeros((r_max - r_min + 1, c_max - c_min + 1), dtype=bool)
+            mask[arr[:, 0] - r_min, arr[:, 1] - c_min] = True
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r_min, c_min, r_max, c_max),
+                    "mask": mask,
+                }
