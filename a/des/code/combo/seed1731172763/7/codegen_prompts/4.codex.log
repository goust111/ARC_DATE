+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    frames = [_decode_frame(component) for component in _find_components(g)]
+    out = g.copy()
+    obstacle_mask = g != BG
+    for frame in frames:
+        _draw_beam(out, obstacle_mask, frame)
+    return out
