+
+def _beam_stop_reason(frame: dict, obstacle_mask: np.ndarray, shape: tuple[int, int]) -> str:
+    step = 1
+    while True:
+        cells = _ray_strip(frame, step)
+        if not _in_bounds(shape, cells):
+            return "edge"
+        if any(bool(obstacle_mask[r, c]) for r, c in cells):
+            return "frame"
+        step += 1
