+def _blocked_corridor(emitter: dict, blocker_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]] | None:
+    er0, ec0, er1, ec1 = map(int, emitter["bbox"])
+    br0, bc0, br1, bc1 = map(int, blocker_bbox)
+    gap_lo = int(emitter["gap_lo"])
