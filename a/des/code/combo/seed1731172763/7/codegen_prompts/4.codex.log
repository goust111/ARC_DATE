+def _gap_world_span(frame: dict) -> tuple[int, int]:
+    r0, c0, _r1, _c1 = map(int, frame["bbox"])
+    return (
+        c0 + int(frame["gap_lo"]),
+        c0 + int(frame["gap_hi"]),
