+    if r0_lo > r0_hi or c0_lo > c0_hi:
+        return None
+    for _ in range(BBOX_SAMPLE_TRIES):
+        r0 = random.randint(r0_lo, r0_hi)
+        c0 = random.randint(c0_lo, c0_hi)
