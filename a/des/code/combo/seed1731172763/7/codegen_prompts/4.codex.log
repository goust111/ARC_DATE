+def _bbox_free(forbidden: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = map(int, bbox)
+    return not bool(forbidden[r0 : r1 + 1, c0 : c1 + 1].any())
