+def _ray_strip(frame: dict, step: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, frame["bbox"])
+    gap_lo = int(frame["gap_lo"])
+    gap_hi = int(frame["gap_hi"])
