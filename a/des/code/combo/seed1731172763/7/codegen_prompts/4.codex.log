+def _find_components(g: np.ndarray) -> list[dict]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (
+                        int(rows.min()),
+                        int(cols.min()),
+                        int(rows.max()),
+                        int(cols.max()),
+                    ),
+                }
+            )
+    return components
