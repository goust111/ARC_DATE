+
+def _sample_gap(side: str, h: int, w: int) -> tuple[int, int]:
+    span = w if side in ("top", "bottom") else h
+    gap_width = random.randint(1, span - 2)
+    gap_lo = random.randint(1, span - gap_width - 1)
+    return gap_lo, gap_lo + gap_width - 1
+
+
+def _sample_bbox(
+    scene: dict,
+    h: int,
+    w: int,
+    r0_lo: int,
+    r0_hi: int,
+    c0_lo: int,
+    c0_hi: int,
