+    if side == "top":
+        start = br1 + 1
+        stop = er0 - 1
+        if stop - start + 1 < MIN_RAY_STEPS:
+            return None
+        for r in range(start, stop + 1):
+            for c in range(ec0 + gap_lo, ec0 + gap_hi + 1):
+                cells.append((r, c))
+    elif side == "bottom":
+        start = er1 + 1
+        stop = br0 - 1
+        if stop - start + 1 < MIN_RAY_STEPS:
+            return None
+        for r in range(start, stop + 1):
+            for c in range(ec0 + gap_lo, ec0 + gap_hi + 1):
+                cells.append((r, c))
+    elif side == "left":
+        start = bc1 + 1
+        stop = ec0 - 1
+        if stop - start + 1 < MIN_RAY_STEPS:
+            return None
+        for c in range(start, stop + 1):
+            for r in range(er0 + gap_lo, er0 + gap_hi + 1):
