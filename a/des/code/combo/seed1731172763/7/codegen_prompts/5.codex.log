import random
import numpy as np
from functools import lru_cache

INPUT_COLORS = [1,2,3,4,6,7,8]

@lru_cache(maxsize=None)
def parts(n, min_part=2):
    out=[]
    for s in (2,3,4):
        if s>n: continue
        if s==n:
            out.append((s,))
        else:
            for rest in parts(n-s, s):
                if s <= rest[0]:
                    out.append((s,)+rest)
    return tuple(out)

def singleton_index(vals):
    uniq, counts = np.unique(vals, return_counts=True)
    singles = uniq[counts==1]
    if len(singles)"'!=1:
        raise AssertionError((vals, uniq, counts, singles))
    color = int(singles[0])
    idx = np.flatnonzero(vals==color)
    if len(idx)!=1:
        raise AssertionError(idx)
    return int(idx[0]), color

for _ in range(200):
    n = random.randint(5,12)
    ps = [p for p in parts(n) if 2 in p and any(x>=3 for x in p)]
    sizes = list(random.choice(ps))
    rows = list(range(n))
    random.shuffle(rows)
    groups=[]
    i=0
    for s in sizes:
        group=rows[i:i+s]
        i+=s
        groups.append(group)
    base_colors = random.sample(INPUT_COLORS, k=len(groups))
    large_idxs = [i for i,s in enumerate(sizes) if s>=3]
    support_idx = random.choice(large_idxs)
    support_color = base_colors[support_idx]
    rem = [c for c in INPUT_COLORS if c not in base_colors]
    accent = random.choice(rem)
    row_group = {}
    row_base = {}
    row_size = {}
    row_partner = {}
    for gi, group in enumerate(groups):
        for r in group:
            row_group[r]=gi
            row_base[r]=base_colors[gi]
            row_size[r]=sizes[gi]
        if sizes[gi]==2:
            a,b = group
            row_partner[a]=b
            row_partner[b]=a
    p = random.sample(range(n), n)
    g = np.empty((n,n), int)
    for r in range(n):
        g[r,:] = row_base[r]
    for r in range(n):
        if row_size[r]==2:
            g[r,p[r]] = support_color
        else:
            g[r,p[r]] = accent
    # validate
    row_pos=[]
    for r in range(n):
        row_pos.append(singleton_index(g[r])[0])
    col_pos=[]
    for c in range(n):
        col_pos.append(singleton_index(g[:,c])[0])
    assert row_pos == p
    overlap=0
    for r,c in enumerate(row_pos):
        if col_pos[c]==r:
            overlap += 1
            assert row_size[r] >= 3
        else:
            assert row_size[r] == 2 and col_pos[c] == row_partner[r]
    assert 0 < overlap < n
