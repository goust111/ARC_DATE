+        base = order[start]
+        rel_cells = [(r - base[0], c - base[1]) for r, c in order[start:stop]]
+        rotated_cells = [_rotate_cw(rel) for rel in rel_cells]
+        placed = [(anchor[0] + dr, anchor[1] + dc) for dr, dc in rotated_cells]
