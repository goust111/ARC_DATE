+                visited.remove(nxt)
+                path.pop()
+            return False
+
+        if rec():
+            if path[-1] < path[0]:
+                path.reverse()
+            return path
+
+    return None
+
+
+def _sample_segment_colors(segment_count: int) -> list[int]:
+    palette_size = int(_RNG.integers(2, min(5, segment_count) + 1))
+    palette = list(map(int, _RNG.choice(_FG_COLORS, size=palette_size, replace=False)))
+    unused = palette.copy()
+    _RNG.shuffle(unused)
