+        partition = _try_partition(grid, sep)
+        if partition is not None:
+            row_bands, col_bands = partition
+            score = int(np.count_nonzero(np.all(grid == sep, axis=1))) + int(
+                np.count_nonzero(np.all(grid == sep, axis=0))
+            )
