+def _bands_from_separator_mask(mask: np.ndarray) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    n = int(mask.size)
+    pos = 0
+    while pos < n:
+        if bool(mask[pos]):
+            return []
+        start = pos
+        while pos < n and not bool(mask[pos]):
+            pos += 1
+        if start == pos:
+            return []
+        bands.append((start, pos))
+        while pos < n and bool(mask[pos]):
+            pos += 1
+        if pos == n and bool(mask[n - 1]):
+            return []
+    return bands
+
