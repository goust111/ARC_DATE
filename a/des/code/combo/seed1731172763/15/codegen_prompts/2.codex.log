+        for i, (src, dst) in enumerate(pairs):
+            grid[row, pos] = int(src)
+            grid[row, pos + 1] = int(dst)
+            pos += 2
+            if i < len(pairs) - 1:
+                pos += 1 + int(gaps[i + 1])
+    elif edge == "bottom":
+        row = h - 1
+        for i, (src, dst) in enumerate(pairs):
+            grid[row, pos] = int(src)
+            grid[row, pos + 1] = int(dst)
+            pos += 2
+            if i < len(pairs) - 1:
+                pos += 1 + int(gaps[i + 1])
+    elif edge == "left":
