+def _shift_input_position(
+    placement: dict[str, object], edge: str, shift: int
+) -> tuple[int, int]:
+    out_r0 = int(placement["out_r0"])
+    out_c0 = int(placement["out_c0"])
+    if edge == "top":
+        return int(out_r0 + shift), int(out_c0)
+    if edge == "bottom":
+        return int(out_r0 - shift), int(out_c0)
+    if edge == "left":
+        return int(out_r0), int(out_c0 + shift)
+    return int(out_r0), int(out_c0 - shift)
