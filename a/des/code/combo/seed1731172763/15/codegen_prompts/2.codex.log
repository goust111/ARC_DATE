+    width = int(placement["width"])
+    if edge == "top":
+        return int(h - (out_r0 + height))
+    if edge == "bottom":
+        return int(out_r0)
+    if edge == "left":
+        return int(w - (out_c0 + width))
+    return int(out_c0)
