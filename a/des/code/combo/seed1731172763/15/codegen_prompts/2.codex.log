+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 8
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 9)
+EDGE_ORDER = ("top", "bottom", "left", "right")
+MAX_GEN_ATTEMPTS = 500
