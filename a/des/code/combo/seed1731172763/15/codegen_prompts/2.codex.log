+            grid[pos + 1, col] = int(dst)
+            pos += 2
+            if i < len(pairs) - 1:
+                pos += 1 + int(gaps[i + 1])
+    else:
+        col = w - 1
+        for i, (src, dst) in enumerate(pairs):
+            grid[pos, col] = int(src)
+            grid[pos + 1, col] = int(dst)
+            pos += 2
+            if i < len(pairs) - 1:
+                pos += 1 + int(gaps[i + 1])
