+        width = int(cells[:, 1].max()) + 1
+
+        placed = False
+        for _ in range(80):
+            if edge in ("top", "bottom"):
+                if w - width - 2 < 0:
+                    return None
+                c0 = random.randint(1, w - width - 1)
+                row_iter = range(0, h - height + 1) if edge == "top" else range(h - height, -1, -1)
