+def _can_place(occupied: np.ndarray, cells: np.ndarray, r0: int, c0: int) -> bool:
+    rr = cells[:, 0] + int(r0)
+    cc = cells[:, 1] + int(c0)
+    return not bool(np.any(occupied[rr, cc]))
