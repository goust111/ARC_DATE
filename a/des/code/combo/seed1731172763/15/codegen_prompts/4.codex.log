+
+def _slice_is_clear(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> bool:
+    return 0 <= r0 < r1 <= blocked.shape[0] and 0 <= c0 < c1 <= blocked.shape[1] and not bool(blocked[r0:r1, c0:c1].any())
