+    keep_low = int(np.ceil(DENSE_KEEP_FRAC_RANGE[0] * area))
+    keep_high = int(np.floor(DENSE_KEEP_FRAC_RANGE[1] * area))
+    if keep_low > keep_high:
+        return None
+
+    mask = np.ones((height, width), dtype=bool)
+    target = random.randint(keep_low, keep_high)
