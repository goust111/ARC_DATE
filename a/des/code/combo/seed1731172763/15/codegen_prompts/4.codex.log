+            r0, c0, r1, c1 = _bbox(pts)
+            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            local[pts[:, 0] - r0, pts[:, 1] - c0] = True
+            objects.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": local,
+                    "area": int(local.sum()),
