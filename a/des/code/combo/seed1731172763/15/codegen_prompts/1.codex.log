+    h, w = rng.choice(choices)
+    return [(r, c) for r in range(h) for c in range(w)]
+
+
+def _random_corner_cut(rng: random.Random, parity: int) -> list[tuple[int, int]] | None:
+    candidates: list[tuple[int, int, int, int]] = []
+    for h in range(2, 7):
