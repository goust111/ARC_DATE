+def _can_place(blocked: np.ndarray, shape: list[tuple[int, int]], r0: int, c0: int) -> bool:
+    h, w = blocked.shape
+    for r, c in shape:
+        rr, cc = r0 + r, c0 + c
+        if not (0 <= rr < h and 0 <= cc < w) or blocked[rr, cc]:
+            return False
+    return True
+
