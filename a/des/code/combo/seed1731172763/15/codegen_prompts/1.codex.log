+def _random_rectangle(rng: random.Random, parity: int) -> list[tuple[int, int]] | None:
+    choices = [
+        (h, w)
+        for h in range(1, 6)
+        for w in range(1, 6)
+        if 1 <= h * w <= 16 and (h * w) % 2 == parity
+    ]
+    if not choices:
