h,w=6,6

def comps(mask):
    seen=[[False]*w for _ in range(h)]
    n=0
    for r in range(h):
        for c in range(w):
            if not mask[r][c] or seen[r][c]:
                continue
            n+=1
            q=deque([(r,c)]); seen[r][c]=True
            while q:
