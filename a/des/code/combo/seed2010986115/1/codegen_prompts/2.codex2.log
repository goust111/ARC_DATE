import numpy as np

def conn(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),bool)
    n=0
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            n+=1
            q=deque([(r,c)]); seen[r,c]=True
            while q:
                rr,cc=q.popleft()
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        if dr==0 and dc==0: continue
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=True; q.append((nr,nc))
    return n==1

def touches(mask):
    h,w=mask.shape
    return mask[0,:].any() and mask[-1,:].any() and mask[:,0].any() and mask[:,-1].any()

families = {
    'checker': lambda r,c: (r+c)%2==0,
