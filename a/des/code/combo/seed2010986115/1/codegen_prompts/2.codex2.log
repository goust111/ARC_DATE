+                while cur not in region:
+                    path.append(cur)
+                    cur = parent[cur]
+                path.reverse()
+                return path
+            q.append(cell)
+    return None
+
+
+def _frontier(region: set[tuple[int, int]], unassigned: set[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
