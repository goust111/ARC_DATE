+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _crop_component(coords: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return (r0, c0, r1, c1), mask
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _is_cross_component(coords: np.ndarray) -> bool:
+    if coords.shape[0] != 5:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return False
+    mask = np.zeros((3, 3), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.array(
+        [
+            [False, True, False],
+            [True, True, True],
+            [False, True, False],
+        ],
+        dtype=bool,
+    )
+    return bool(np.array_equal(mask, expected))
+
+
+def _pair_rectangle_shape(comps: list[np.ndarray]) -> tuple[int, int] | None:
+    if len(comps) != 2:
+        return None
+    crop_a = _crop_component(comps[0])[1]
+    crop_b = _crop_component(comps[1])[1]
+    if crop_a.shape != crop_b.shape:
+        return None
+    if np.any(crop_a & crop_b):
