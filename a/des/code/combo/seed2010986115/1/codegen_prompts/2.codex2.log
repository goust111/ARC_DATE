+
+_RNG = np.random.default_rng()
+_GEN_ATTEMPTS = 400
+_PARTITION_ATTEMPTS = 200
+_PLACEMENT_ATTEMPTS = 200
+
+
+def _randint(lo: int, hi: int) -> int:
+    return int(_RNG.integers(int(lo), int(hi) + 1))
+
+
+def _choice(seq):
+    return seq[_randint(0, len(seq) - 1)]
+
+
+def _shuffled(seq):
+    items = list(seq)
+    _RNG.shuffle(items)
+    return items
+
+
+def _sample(seq, k: int):
+    idx = _RNG.choice(len(seq), size=int(k), replace=False)
+    return [seq[int(i)] for i in idx]
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    comps = _components_from_mask(mask)
+    return len(comps) == 1
+
+
+def _path_from_region(
+    region: set[tuple[int, int]],
+    target: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> list[tuple[int, int]] | None:
+    if target in region:
+        return []
+    q = deque(region)
+    parent = {cell: None for cell in region}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            cell = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if cell in parent or cell in blocked:
+                continue
+            parent[cell] = (r, c)
+            if cell == target:
+                path = [cell]
+                cur = (r, c)
+                while cur not in region:
+                    path.append(cur)
+                    cur = parent[cur]
+                path.reverse()
+                return path
+            q.append(cell)
+    return None
+
+
+def _frontier(region: set[tuple[int, int]], unassigned: set[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    cells = set()
+    for r, c in region:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) in unassigned:
+                cells.add((nr, nc))
+    return list(cells)
+
+
+def _make_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray]:
+    interior_rows = list(range(1, h - 1))
+    interior_cols = list(range(1, w - 1))
+    total = h * w
