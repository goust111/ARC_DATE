+
+def _paint_cross(grid: np.ndarray, center: tuple[int, int], color: int) -> None:
+    r, c = center
+    grid[r, c] = color
+    grid[r - 1, c] = color
+    grid[r + 1, c] = color
+    grid[r, c - 1] = color
