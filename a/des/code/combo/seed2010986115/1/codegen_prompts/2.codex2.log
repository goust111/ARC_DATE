+def _is_cross_component(coords: np.ndarray) -> bool:
+    if coords.shape[0] != 5:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return False
+    mask = np.zeros((3, 3), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.array(
