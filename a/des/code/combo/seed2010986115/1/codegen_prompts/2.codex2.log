def connected(bits,h,w,inv=False):
    seen=[[False]*w for _ in range(h)]
    n=0
    for r in range(h):
        for c in range(w):
            val=((bits>>(r*w+c))&1)==1
            if inv: val=not val
            if not val or seen[r][c]:
                continue
            n+=1
            if n>1:
                return False
            q=deque([(r,c)]); seen[r][c]=True
            while q:
                rr,cc=q.popleft()
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<h and 0<=nc<w and not seen[nr][nc]:
                        v=((bits>>(nr*w+nc))&1)==1
                        if inv: v=not v
                        if v:
                            seen[nr][nc]=True; q.append((nr,nc))
    return n==1

def touches(bits,h,w,inv=False):
    def val(r,c):
        v=((bits>>(r*w+c))&1)==1
        return (not v) if inv else v
    return any(val(0,c) for c in range(w)) and any(val(h-1,c) for c in range(w)) and any(val(r,0) for r in range(h)) and any(val(r,w-1) for r in range(h))

