+def _pair_rectangle_shape(comps: list[np.ndarray]) -> tuple[int, int] | None:
+    if len(comps) != 2:
+        return None
+    crop_a = _crop_component(comps[0])[1]
+    crop_b = _crop_component(comps[1])[1]
+    if crop_a.shape != crop_b.shape:
+        return None
+    if np.any(crop_a & crop_b):
