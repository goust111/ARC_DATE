import random
from collections import deque


def comps(mask):
    h=len(mask); w=len(mask[0])
    seen=[[False]*w for _ in range(h)]
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r][c] or seen[r][c]:
                continue
            q=deque([(r,c)]); seen[r][c]=True; pts=[]
            while q:
                rr,cc=q.popleft(); pts.append((rr,cc))
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<h and 0<=nc<w and mask[nr][nc] and not seen[nr][nc]:
                        seen[nr][nc]=True; q.append((nr,nc))
            out.append(pts)
    return out

def conn(mask): return len(comps(mask))==1

def touches(mask):
    h=len(mask); w=len(mask[0])
    return any(mask[0][c] for c in range(w)) and any(mask[h-1][c] for c in range(w)) and any(mask[r][0] for r in range(h)) and any(mask[r][w-1] for r in range(h))

for h,w in [(5,5),(5,7),(7,7)]:
    for _ in range(200000):
        m=[[random.random()<0.5 for _ in range(w)] for _ in range(h)]
        if not conn(m):
            continue
        cm=[[not x for x in row] for row in m]
        if not conn(cm):
            continue
        if not touches(m) or not touches(cm):
            continue
        print('found',h,w)
        for row in m:
            print(''.join('1' if x else '0' for x in row))
        raise SystemExit
print('none')
