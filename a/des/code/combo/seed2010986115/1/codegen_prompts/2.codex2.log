+def _path_from_region(
+    region: set[tuple[int, int]],
+    target: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> list[tuple[int, int]] | None:
+    if target in region:
+        return []
+    q = deque(region)
+    parent = {cell: None for cell in region}
+    while q:
+        r, c = q.popleft()
