+        candidates = []
+        row_lo = rh // 2
+        row_hi = h - rh // 2
+        col_lo = rw // 2
+        col_hi = w - rw // 2
+        for cr in range(row_lo, row_hi):
+            for cc in range(col_lo, col_hi):
+                key = (cr, cc)
+                if key <= prev_key:
+                    continue
+                top = cr - rh // 2
+                left = cc - rw // 2
+                if not _can_place(output_occ, top, left, rh, rw, margin=1):
+                    continue
