+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
