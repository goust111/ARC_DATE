+        top = center[0] - rh // 2
+        left = center[1] - rw // 2
+        _mark_occ(output_occ, top, left, rh, rw, margin=1)
+        _mark_occ(cross_occ, center[0] - 1, center[1] - 1, 3, 3, margin=1)
