+def _make_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray]:
+    interior_rows = list(range(1, h - 1))
+    interior_cols = list(range(1, w - 1))
+    total = h * w
+    min_area = max(8, total // 4)
+
+    for _ in range(_PARTITION_ATTEMPTS):
+        seed_a = (h // 2, max(1, w // 2 - 1))
+        seed_b = (h // 2, min(w - 2, w // 2 + 1))
+        if seed_a == seed_b:
+            seed_b = (max(1, h // 2 - 1), min(w - 2, w // 2 + 1))
+        if seed_a == seed_b:
+            continue
+
+        top_a, top_b = _sample(interior_cols, 2)
+        bottom_a, bottom_b = _sample(interior_cols, 2)
+        left_a, left_b = _sample(interior_rows, 2)
+        right_a, right_b = _sample(interior_rows, 2)
+
+        anchors = {
+            "A": [(0, top_a), (h - 1, bottom_a), (left_a, 0), (right_a, w - 1)],
+            "B": [(0, top_b), (h - 1, bottom_b), (left_b, 0), (right_b, w - 1)],
+        }
+        regions = {"A": {seed_a}, "B": {seed_b}}
+        reserved = {
+            "A": set(anchors["B"]) | {seed_b},
+            "B": set(anchors["A"]) | {seed_a},
+        }
+
+        ok = True
+        for turn in range(8):
+            label = "A" if turn % 2 == 0 else "B"
+            other = "B" if label == "A" else "A"
+            pending = [anchor for anchor in anchors[label] if anchor not in regions[label]]
+            if not pending:
+                continue
+            pending.sort(
+                key=lambda cell: min(abs(cell[0] - r) + abs(cell[1] - c) for r, c in regions[label])
+            )
+            best = pending[0]
+            blocked = set(regions[other]) | (reserved[label] - {best})
+            path = _path_from_region(regions[label], best, blocked, h, w)
+            if path is None:
+                ok = False
+                break
+            regions[label].update(path)
+        if not ok:
+            continue
+
+        unassigned = {(r, c) for r in range(h) for c in range(w)} - regions["A"] - regions["B"]
+        while unassigned:
+            front_a = _frontier(regions["A"], unassigned, h, w)
+            front_b = _frontier(regions["B"], unassigned, h, w)
+            if not front_a and not front_b:
+                ok = False
+                break
+
+            if front_a and front_b:
+                if len(regions["A"]) < len(regions["B"]):
+                    label = "A" if _RNG.random() < 0.6 else "B"
+                elif len(regions["B"]) < len(regions["A"]):
+                    label = "B" if _RNG.random() < 0.6 else "A"
+                else:
+                    label = "A" if _RNG.random() < 0.5 else "B"
+            else:
+                label = "A" if front_a else "B"
+
+            frontier_cells = front_a if label == "A" else front_b
+            cell = frontier_cells[_randint(0, len(frontier_cells) - 1)]
+            regions[label].add(cell)
+            unassigned.remove(cell)
+        if not ok:
+            continue
+
+        mask_a = np.zeros((h, w), dtype=bool)
+        mask_b = np.zeros((h, w), dtype=bool)
+        for r, c in regions["A"]:
+            mask_a[r, c] = True
+        for r, c in regions["B"]:
+            mask_b[r, c] = True
+
+        area_a = int(mask_a.sum())
+        area_b = int(mask_b.sum())
+        if not (min_area <= area_a <= total - min_area and min_area <= area_b <= total - min_area):
+            continue
+        if not (_touches_all_sides(mask_a) and _touches_all_sides(mask_b)):
+            continue
+        if not (_mask_connected(mask_a) and _mask_connected(mask_b)):
+            continue
+        return mask_a, mask_b
+
+    raise RuntimeError("failed to build a valid complementary partition")
+
+
+def _can_place(occ: np.ndarray, top: int, left: int, height: int, width: int, margin: int) -> bool:
+    h, w = occ.shape
+    if top < 0 or left < 0 or top + height > h or left + width > w:
+        return False
+    r0 = max(0, top - margin)
+    c0 = max(0, left - margin)
+    r1 = min(h, top + height + margin)
+    c1 = min(w, left + width + margin)
+    return not bool(occ[r0:r1, c0:c1].any())
+
+
+def _mark_occ(occ: np.ndarray, top: int, left: int, height: int, width: int, margin: int) -> None:
+    h, w = occ.shape
+    r0 = max(0, top - margin)
+    c0 = max(0, left - margin)
+    r1 = min(h, top + height + margin)
+    c1 = min(w, left + width + margin)
+    occ[r0:r1, c0:c1] = True
+
+
+def _paint_mask(grid: np.ndarray, top: int, left: int, mask: np.ndarray, color: int) -> None:
+    h, w = mask.shape
+    sub = grid[top : top + h, left : left + w]
+    sub[mask] = int(color)
+
+
+def _paint_cross(grid: np.ndarray, center: tuple[int, int], color: int) -> None:
+    r, c = center
+    grid[r, c] = color
+    grid[r - 1, c] = color
+    grid[r + 1, c] = color
+    grid[r, c - 1] = color
+    grid[r, c + 1] = color
+
+
+def _generate_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    pair_count = _choice([2, 3, 4])
+    if pair_count == 2:
+        h_range = (22, 30)
+        w_range = (22, 32)
+        size_choices = [5, 7, 9, 11]
+    elif pair_count == 3:
+        h_range = (26, 34)
+        w_range = (26, 34)
+        size_choices = [5, 7, 9]
+    else:
+        h_range = (30, 36)
+        w_range = (30, 36)
+        size_choices = [5, 7, 9]
+
+    h = _randint(*h_range)
+    w = _randint(*w_range)
+
+    colors = list(range(10))
+    bg = _choice(colors)
+    remaining = [c for c in colors if c != bg]
+    marker_color = _choice(remaining)
+    piece_colors = _sample([c for c in remaining if c != marker_color], pair_count)
+
+    specs = []
+    for color in piece_colors:
+        rect_h = _choice(size_choices)
+        rect_w = _choice(size_choices)
+        if rect_h >= h - 2 or rect_w >= w - 2:
+            return None
+        try:
+            mask_a, mask_b = _make_partition(rect_h, rect_w)
+        except RuntimeError:
