    m=rows
    cm=[[not m[r][c] for c in range(w)] for r in range(h)]
    return comps(m), touches(m), comps(cm), touches(cm)

def score(m):
    ca,ta,cb,tb=props(m)
    return abs(ca-1)*100 + abs(cb-1)*100 + (4-ta)*10 + (4-tb)*10 + abs(sum(sum(r) for r in m)-len(m)*len(m[0])//2)

