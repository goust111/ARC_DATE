+def _can_place(occupied: np.ndarray, top: int, left: int, patch: np.ndarray, bg: int) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    if top < 1 or left < 1 or top + ph >= h or left + pw >= w:
+        return False
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(h, top + ph + 1)
+    c1 = min(w, left + pw + 1)
+    if occupied[r0:r1, c0:c1].any():
