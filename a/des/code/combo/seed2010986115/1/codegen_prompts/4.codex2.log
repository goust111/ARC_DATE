+    arrow_r, arrow_c = arrow_pos
+    arrow_region = patch[ir0 + arrow_r : ir0 + arrow_r + arrow_h, ic0 + arrow_c : ic0 + arrow_c + arrow_w]
+    arrow_region[arrow == ARROW_COLOR] = ARROW_COLOR
+    return patch
+
