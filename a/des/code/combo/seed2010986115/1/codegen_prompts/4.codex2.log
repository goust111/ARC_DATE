+def _stamp_tile(out: np.ndarray, tile: np.ndarray, top: int, left: int, bg: int) -> None:
+    mask = tile != bg
+    region = out[top : top + tile.shape[0], left : left + tile.shape[1]]
+    region[mask] = tile[mask]
