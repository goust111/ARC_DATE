+        trial[r, c] = False
+        if not trial[0].any() or not trial[-1].any() or not trial[:, 0].any() or not trial[:, -1].any():
+            continue
+        if not _mask_connected(trial):
+            continue
+        mask = trial
+    return mask
+
+
+def _make_arrow(direction: str, long_len: int) -> np.ndarray:
+    assert long_len >= 2
+    if direction in ("left", "right"):
