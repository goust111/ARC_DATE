+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _touches_border(coords: np.ndarray, h: int, w: int) -> bool:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(
+        np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1))
+    )
+
+
+def _most_common_color(grid: np.ndarray, *, exclude: set[int]) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    best_color = None
+    best_count = -1
+    for color, count in zip(values, counts):
+        color = int(color)
+        count = int(count)
+        if color in exclude:
+            continue
+        if count > best_count:
+            best_color = color
+            best_count = count
+    assert best_color is not None
+    return best_color
+
+
