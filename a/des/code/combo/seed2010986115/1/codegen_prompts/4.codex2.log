+    wr0 = extra_top
+    wc0 = extra_left
+    wr1 = wr0 + base_h - 1
+    wc1 = wc0 + base_w - 1
+    patch[wr0, wc0 : wc1 + 1] = WALL_COLOR
+    patch[wr1, wc0 : wc1 + 1] = WALL_COLOR
+    patch[wr0 : wr1 + 1, wc0] = WALL_COLOR
+    patch[wr0 : wr1 + 1, wc1] = WALL_COLOR
+
+    if extra_top > 0 and base_w >= 3 and random.random() < 0.7:
