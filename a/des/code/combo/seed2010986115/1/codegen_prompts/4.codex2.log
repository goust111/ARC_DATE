+
+def _seed_origin(direction: str, interior_h: int, interior_w: int, tile_h: int, tile_w: int) -> tuple[int, int]:
+    if direction == "right":
+        return 0, 0
+    if direction == "left":
+        return 0, interior_w - tile_w
+    if direction == "down":
+        return 0, 0
+    assert direction == "up"
