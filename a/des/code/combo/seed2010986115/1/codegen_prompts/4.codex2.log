+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+WALL_COLOR = 5
+ARROW_COLOR = 2
+PALETTE = tuple(color for color in range(10) if color not in (WALL_COLOR, ARROW_COLOR))
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 120
