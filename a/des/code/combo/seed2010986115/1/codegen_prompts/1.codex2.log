+    if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+        return None
+    if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+        return None
+
+    cellset = set(cells)
+    perimeter = set()
+    for c in range(c0, c1 + 1):
