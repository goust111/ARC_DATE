+        perimeter.add((r1, c))
+    for r in range(r0 + 1, r1):
+        perimeter.add((r, c0))
+        perimeter.add((r, c1))
+
+    if cellset - perimeter:
+        return None
+
+    missing = perimeter - cellset
+    if len(missing) != 1:
+        return None
+
+    gap = next(iter(missing))
+    if gap in {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}:
+        return None
+
