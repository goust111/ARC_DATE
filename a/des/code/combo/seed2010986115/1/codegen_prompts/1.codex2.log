+        sort_key = c0 + c1
+    elif gap[0] == r1:
+        side = "bottom"
+        sort_key = c0 + c1
+    elif gap[1] == c0:
+        side = "left"
+        sort_key = r0 + r1
+    else:
+        side = "right"
+        sort_key = r0 + r1
+
+    return {
