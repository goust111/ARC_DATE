+def _ray_cells(side: str, box: tuple[int, int, int, int], length: int) -> list[tuple[int, int]]:
+    sr, sc, dr, dc = _ray_spec(side, box)
+    return [(sr + dr * step, sc + dc * step) for step in range(length)]
