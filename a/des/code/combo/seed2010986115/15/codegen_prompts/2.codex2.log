+    placements: list[tuple[int, tuple[int, int, int, int]]] = []
+    for color in fg_colors:
+        comps = _find_components(g == color)
+        assert len(comps) == 2
+        _, bbox = _pair_solution(comps, arrows, used_arrow_ids)
+        placements.append((color, bbox))
