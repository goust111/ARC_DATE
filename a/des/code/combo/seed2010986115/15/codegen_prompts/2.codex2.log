+        idx += row_size
+        row_h = max(p.shape[0] for p in row_patches)
+        x = 0
+        for patch in row_patches:
+            jitter = rng.randint(0, row_h - patch.shape[0])
+            placements.append((patch, y + jitter, x))
+            x += patch.shape[1] + h_gap
+        arrangement_w = max(arrangement_w, x - h_gap)
+        y += row_h + v_gap
