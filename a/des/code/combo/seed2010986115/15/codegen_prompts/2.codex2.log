+        shared_c1 = min(tbox[3], bbox2[3])
+        gap = bbox2[0] - tbox[2] - 1
+        assert gap > 0
+        candidates = []
+        for arrow in arrows:
+            if arrow["id"] in used_arrow_ids:
+                continue
