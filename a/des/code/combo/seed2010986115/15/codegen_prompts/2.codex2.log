+    directions = [rng.choice(list(DIRS.keys())) for _ in range(n_pairs)]
+    patches = [_build_case(direction, color, rng) for direction, color in zip(directions, colors)]
+    grid = _assemble_grid(patches, rng)
+    if grid is None:
