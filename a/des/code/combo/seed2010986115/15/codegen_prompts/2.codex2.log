+    extra_h = rng.randint(2, min(8, MAX_GRID_SIZE - arrangement_h))
+    extra_w = rng.randint(2, min(8, MAX_GRID_SIZE - arrangement_w))
+    grid_h = max(12, arrangement_h + extra_h)
+    grid_w = max(12, arrangement_w + extra_w)
