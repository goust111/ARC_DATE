+def _projection_box(
+    bbox: tuple[int, int, int, int], dr: int, dc: int
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    if dr == 1:
+        return r1 + 1, c0 + 1, r1 + inner_h, c1 - 1
+    if dr == -1:
+        return r0 - inner_h, c0 + 1, r0 - 1, c1 - 1
+    if dc == 1:
+        return r0 + 1, c1 + 1, r1 - 1, c1 + inner_w
+    return r0 + 1, c0 - inner_w, r1 - 1, c0 - 1
