+
+
+def _expand_box(
+    box: tuple[int, int, int, int], pad: int, h: int, w: int
+) -> tuple[int, int, int, int]:
+    return (
+        max(0, box[0] - pad),
+        max(0, box[1] - pad),
+        min(h - 1, box[2] + pad),
+        min(w - 1, box[3] + pad),
