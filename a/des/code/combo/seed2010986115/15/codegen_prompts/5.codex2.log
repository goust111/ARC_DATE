+        else:
+            low = inner_h if dr == -1 else 0
+            high = h - box_h if dr == -1 else h - (box_h + inner_h)
+            if low > high:
+                return None
+            r0 = random.randint(low, high)
+        if 0 > r0 or r0 + box_h > h:
