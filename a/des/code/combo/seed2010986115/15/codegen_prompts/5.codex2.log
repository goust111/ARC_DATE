+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+GREY = 5
+AZURE = 8
+PALETTE_CHOICES = (1, 2, 3, 4, 6, 7, 9)
+DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_H_RANGE = (22, 30)
