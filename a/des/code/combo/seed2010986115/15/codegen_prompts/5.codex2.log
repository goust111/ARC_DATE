+def _find_legend(grid: np.ndarray, bg: int) -> tuple[list[int], np.ndarray]:
+    h, w = grid.shape
+    candidates: list[tuple[tuple[int, int, int], list[int], np.ndarray]] = []
+    for comp in _components(grid == GREY):
