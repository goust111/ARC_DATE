+        colors = [value for _, _, value in sorted(dots, key=lambda item: (item[0], item[1]))]
+        mask = np.zeros((h, w), dtype=bool)
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+        score = (r0, c0, (r1 - r0 + 1) * (c1 - c0 + 1))
+        candidates.append((score, colors, mask))
