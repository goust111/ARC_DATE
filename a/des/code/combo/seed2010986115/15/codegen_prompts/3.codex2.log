+        return False
+
+    for _ in range(PLACEMENT_TRIES):
+        r0 = rng.randint(1, gh - ph - 1)
+        c0 = rng.randint(1, gw - pw - 1)
+        rs = slice(max(0, r0 - MIN_GAP), min(gh, r0 + ph + MIN_GAP))
+        cs = slice(max(0, c0 - MIN_GAP), min(gw, c0 + pw + MIN_GAP))
