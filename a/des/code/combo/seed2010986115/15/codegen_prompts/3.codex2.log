+def _normalize_order(order: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    min_r = min(r for r, _ in order)
+    min_c = min(c for _, c in order)
+    return [(r - min_r, c - min_c) for r, c in order]
+
