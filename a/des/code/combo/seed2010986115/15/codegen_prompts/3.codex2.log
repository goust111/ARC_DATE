+def _rectangle_cycle(h: int, w: int) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
+    for c in range(w):
+        order.append((0, c))
+    for r in range(1, h):
+        order.append((r, w - 1))
+    for c in range(w - 2, -1, -1):
+        order.append((h - 1, c))
+    for r in range(h - 2, 0, -1):
+        order.append((r, 0))
+    return order
