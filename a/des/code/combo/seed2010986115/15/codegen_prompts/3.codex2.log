+def _valid_cycle_order(order: list[tuple[int, int]]) -> bool:
+    if len(set(order)) != len(order):
+        return False
+    cell_set = set(order)
+    n = len(order)
+    for i in range(n):
+        r0, c0 = order[i]
+        r1, c1 = order[(i + 1) % n]
+        if abs(r0 - r1) + abs(c0 - c1) != 1:
+            return False
+    return _is_simple_cycle(cell_set)
+
