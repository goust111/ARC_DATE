+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+OBJECT_COUNT_CHOICES = [1, 2, 3, 4]
+OBJECT_COUNT_WEIGHTS = [0.22, 0.32, 0.28, 0.18]
