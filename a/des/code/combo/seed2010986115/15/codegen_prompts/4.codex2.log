+    if not _place_object(folded_small, small_occ, colors[color_idx], rng, large_band_occ, "none"):
+        return None
+    color_idx += 1
+    placed_small = 1
+
+    if want_overlap:
+        if not _place_object(folded_small, small_occ, colors[color_idx], rng, large_band_occ, "any"):
+            return None
+        color_idx += 1
