+def _merge_band(base: np.ndarray, band: np.ndarray, side: str) -> np.ndarray:
+    out = base.copy()
+    if side == "top":
+        target = out[: band.shape[0], :]
+    elif side == "bottom":
+        target = out[-band.shape[0] :, :]
+    elif side == "left":
+        target = out[:, : band.shape[1]]
+    else:
+        target = out[:, -band.shape[1] :]
+
+    fill = (target == BG) & (band != BG)
+    target[fill] = band[fill]
+    return out
