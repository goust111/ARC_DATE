+    for _ in range(SHAPE_RETRIES):
+        center = (rng.randrange(bbox_h), rng.randrange(bbox_w))
+        anchors = [
+            (0, rng.randrange(bbox_w)),
+            (bbox_h - 1, rng.randrange(bbox_w)),
+            (rng.randrange(bbox_h), 0),
+            (rng.randrange(bbox_h), bbox_w - 1),
+        ]
