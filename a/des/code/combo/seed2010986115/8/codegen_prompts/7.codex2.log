+def _place_rectangles(
+    grid_h: int, grid_w: int, bbox_h: int, bbox_w: int, count: int, rng: random.Random
+) -> list[tuple[int, int]] | None:
+    rects: list[tuple[int, int, int, int]] = []
+    tops_lefts: list[tuple[int, int]] = []
+    for _ in range(count):
