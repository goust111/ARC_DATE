+def _random_shortest_path(
+    start: tuple[int, int], end: tuple[int, int], rng: random.Random
+) -> list[tuple[int, int]]:
+    r, c = start
+    path = [(r, c)]
+    while (r, c) != end:
+        options = []
+        if r < end[0]:
+            options.append((1, 0))
+        elif r > end[0]:
+            options.append((-1, 0))
+        if c < end[1]:
+            options.append((0, 1))
+        elif c > end[1]:
+            options.append((0, -1))
