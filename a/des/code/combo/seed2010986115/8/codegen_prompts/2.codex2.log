+        items = []
+        for j, idx in enumerate(row):
+            patch_h, patch_w = patches[idx].shape
+            dy = 0 if patch_h == row_h else rng.randint(0, row_h - patch_h)
+            items.append((idx, int(total_h + dy), int(x)))
+            x += int(patch_w)
+            if j < len(row) - 1:
+                x += gaps[j]
