+    lower_y = int(sep_row + 1 + gap_after_sep)
+    height = int(lower_y + lower_h + bottom_margin)
+
+    if height > MAX_SIDE or width > MAX_SIDE:
+        return None
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[sep_row, :] = SEPARATOR_COLOR
+
