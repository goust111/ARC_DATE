+def _opening_side(mask: np.ndarray) -> str:
+    specs = _density_specs(mask)
+    best_side = None
+    best_num = 0
+    best_den = 1
+    ties = 0
+    for side in DIRECTIONS:
+        num, den = specs[side]
+        if best_side is None or num * best_den < best_num * den:
+            best_side = side
+            best_num = num
+            best_den = den
+            ties = 1
+        elif num * best_den == best_num * den:
