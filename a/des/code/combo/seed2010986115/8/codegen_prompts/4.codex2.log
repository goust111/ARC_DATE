+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+DIRS: tuple[tuple[int, int], ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+COLOR_POOL: tuple[int, ...] = tuple(range(2, 10))
+GEN_MAX_ATTEMPTS = 400
