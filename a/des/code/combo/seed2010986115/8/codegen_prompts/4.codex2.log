+    order = list(range(len(patches)))
+    rng.shuffle(order)
+
+    for patch_idx in order:
+        ph, pw, patch_cells = patches[patch_idx]
+        candidates = [
+            (r, c)
+            for r in range(grid_h - ph + 1)
+            for c in range(grid_w - pw + 1)
