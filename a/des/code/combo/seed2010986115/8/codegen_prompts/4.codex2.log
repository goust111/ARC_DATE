def _gen_place_left_shift_markers(grid, widths, colors):
    if random.random() < GEN_ALIGNED_LEFT_SHIFT_PROB:
        block_count = len(colors)
        if random.random() < GEN_NONCONSECUTIVE_LEFT_SHIFT_PROB:
