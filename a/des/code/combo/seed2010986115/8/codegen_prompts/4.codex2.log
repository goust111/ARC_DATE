+    rows = [r for r, _ in path]
+    cols = [c for _, c in path]
+    min_r = min(rows)
+    min_c = min(cols)
+    max_r = max(rows)
+    max_c = max(cols)
+
+    cells: list[tuple[int, int, int]] = []
+    for idx, (r, c) in enumerate(path):
+        color = marker_color if idx == len(path) - 1 else body_color
