+    top: int,
+    left: int,
+) -> bool:
+    h, w = map(int, grid.shape)
+    placed = {(int(top + r), int(left + c)) for r, c, _ in patch_cells}
+
+    for rr, cc in placed:
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        if int(grid[rr, cc]) != BLACK:
+            return False
+
+    for rr, cc in placed:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = rr + dr
+                nc = cc + dc
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if (nr, nc) in placed:
+                    continue
+                if int(grid[nr, nc]) != BLACK:
