        used = set()
        by_color = {}
        for color in common_colors:
            if color != base:
                row = row_by_common[color]
                used.add(row)
                by_color[color] = row
        foreign = [color for color in colors if color != base and color not in common_colors]
        rows = random.sample([r for r in range(height) if r not in used], len(foreign))
