+def _place_library(grid: np.ndarray, occ: np.ndarray, items: list[dict], rng: random.Random) -> bool:
+    h, w = grid.shape
+    order = sorted(range(len(items)), key=lambda idx: int(items[idx]["mask"].sum()), reverse=True)
+    for idx in order:
