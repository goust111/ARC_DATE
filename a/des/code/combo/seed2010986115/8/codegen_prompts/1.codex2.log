+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
+        inner.fill(BG)
+        scaled = _resize_mask(patterns[frame["color"]], frame["inner_h"], frame["inner_w"])
+        inner[scaled] = frame["color"]
