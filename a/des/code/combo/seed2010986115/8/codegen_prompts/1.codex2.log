+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    if len(coords) != 2 * (h + w) - 4:
+        return None
+    coord_set = set(coords)
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in coord_set or (r, c1) not in coord_set:
+            return None
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in coord_set or (r1, c) not in coord_set:
+            return None
+    return r0, c0, r1, c1
