+    if not _place_frames(inp, occ, frame_specs, rng):
+        return None
+
+    out = _expected_output(inp, library, frame_specs)
+    if np.array_equal(inp, out):
+        return None
+    try:
+        solved = main(inp)
+    except AssertionError:
