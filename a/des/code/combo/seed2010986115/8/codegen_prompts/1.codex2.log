+    frame_specs = []
+    for item, scale in zip(library, scales):
+        inner_h = int(item["mask"].shape[0] * scale)
+        inner_w = int(item["mask"].shape[1] * scale)
+        frame_specs.append(
+            {
+                "color": item["color"],
+                "pattern": item["mask"],
+                "outer_h": inner_h + 2,
+                "outer_w": inner_w + 2,
