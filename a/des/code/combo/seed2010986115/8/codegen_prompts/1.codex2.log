+def _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
