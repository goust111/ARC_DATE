+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return _normalize_mask(mask)
+
+
+def _l_mask(rng: random.Random, h: int, w: int) -> np.ndarray:
+    thick = 1 if min(h, w) <= 3 else rng.randint(1, min(2, min(h, w) - 1))
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:, :thick] = True
+    mask[h - thick :, :] = True
+    return mask
+
+
+def _plus_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[h // 2, :] = True
+    mask[:, w // 2] = True
+    if h >= 5:
+        mask[h // 2 - 1 : h // 2 + 2, w // 2] = True
+    if w >= 5:
+        mask[h // 2, w // 2 - 1 : w // 2 + 2] = True
+    return mask
+
+
+def _ring_mask(h: int, w: int) -> np.ndarray:
+    mask = np.ones((h, w), dtype=bool)
+    if h > 2 and w > 2:
+        mask[1:-1, 1:-1] = False
+    return mask
+
+
+def _stair_mask(rng: random.Random, h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    r = 0
+    c = 0
+    mask[r, c] = True
+    while r < h - 1 or c < w - 1:
+        if r == h - 1:
+            c += 1
+        elif c == w - 1:
+            r += 1
+        elif rng.random() < 0.5:
+            r += 1
+        else:
+            c += 1
+        mask[r, c] = True
+        if r + 1 < h and rng.random() < 0.25:
+            mask[r + 1, c] = True
+        if c + 1 < w and rng.random() < 0.25:
+            mask[r, c + 1] = True
+    return _normalize_mask(mask)
+
+
+def _random_pattern_mask(rng: random.Random) -> np.ndarray:
+    for _ in range(40):
+        kind = rng.choice(["poly", "poly", "l", "plus", "ring", "stair"])
+        if kind == "poly":
+            h = rng.randint(2, 5)
+            w = rng.randint(2, 5)
+            mask = _random_polyomino(rng, h, w)
+        elif kind == "l":
+            h = rng.randint(2, 5)
+            w = rng.randint(2, 5)
+            mask = _l_mask(rng, h, w)
+        elif kind == "plus":
+            h = rng.choice([3, 5])
+            w = rng.choice([3, 5])
+            mask = _plus_mask(h, w)
+        elif kind == "ring":
+            h = rng.randint(3, 5)
+            w = rng.randint(3, 5)
+            mask = _ring_mask(h, w)
+        else:
+            h = rng.randint(2, 5)
+            w = rng.randint(2, 5)
