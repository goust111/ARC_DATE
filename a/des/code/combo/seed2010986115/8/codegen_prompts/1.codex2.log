+def _paint_frame(grid: np.ndarray, r0: int, c0: int, outer_h: int, outer_w: int, color: int, rng: random.Random) -> dict:
+    r1 = r0 + outer_h - 1
+    c1 = c0 + outer_w - 1
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
