+def _place_frames(grid: np.ndarray, occ: np.ndarray, frames: list[dict], rng: random.Random) -> bool:
+    h, w = grid.shape
+    order = sorted(range(len(frames)), key=lambda idx: frames[idx]["outer_h"] * frames[idx]["outer_w"], reverse=True)
