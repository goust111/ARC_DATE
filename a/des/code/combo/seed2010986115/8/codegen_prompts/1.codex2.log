+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+LIBRARY_BAND = 6
+GEN_ATTEMPTS = 400
