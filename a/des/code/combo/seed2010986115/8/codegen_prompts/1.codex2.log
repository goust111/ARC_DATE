+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q = deque([(r, c)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            comp.append((cr, cc))
+            for dr, dc in DIR4:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
