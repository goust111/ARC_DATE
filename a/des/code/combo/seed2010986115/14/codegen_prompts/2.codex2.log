+_CROSS_SHAPE = frozenset({(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)})
+_CROSS_TIPS = {
+    "up": (0, 1),
+    "right": (1, 2),
+    "down": (2, 1),
+    "left": (1, 0),
