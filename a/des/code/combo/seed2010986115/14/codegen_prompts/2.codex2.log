+        moved = _translated(comp, dr, dc)
+        target_tip = (int(tip[0] + dr), int(tip[1] + dc))
+        assert 0 <= target_tip[0] < h and 0 <= target_tip[1] < w
+
+        for r, c in moved:
+            assert 0 <= r < h and 0 <= c < w, "moved arrow left the grid"
+            current = int(out[r, c])
+            if (r, c) == target_tip:
