+            block, shape = c0, c1
+        elif rect1 and not rect0:
+            block, shape = c1, c0
+        else:
+            block, shape = (c0, c1) if c0["area"] >= c1["area"] else (c1, c0)
+
+        signature = _normalize(shape["coords"])
+        mapping[signature] = int(block["color"])
+
+    return mapping
