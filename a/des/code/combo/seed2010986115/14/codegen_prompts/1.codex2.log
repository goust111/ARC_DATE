+
+def _components_touch(a: dict, b: dict) -> bool:
+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    if ar1 < br0 - 1 or br1 < ar0 - 1 or ac1 < bc0 - 1 or bc1 < ac0 - 1:
+        return False
