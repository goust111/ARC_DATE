+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _normalize(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    rel = sorted((int(r - r0), int(c - c0)) for r, c in coords)
+    return tuple(rel)
+
+
+def _shape_dims(shape: Shape) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _color_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    cid = 0
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.asarray(pts, dtype=int)
+            r0, c0, r1, c1 = _bbox(coords)
+            comps.append(
+                {
+                    "id": cid,
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set((int(rr), int(cc)) for rr, cc in coords),
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(len(coords)),
+                }
+            )
+            cid += 1
+    return comps
+
+
+def _component_is_solid_rect(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return comp["area"] == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _hole_signature(grid: np.ndarray, bg: int, comp: dict) -> tuple[tuple[int, int], ...] | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    color = int(comp["color"])
+
+    if np.any((sub != color) & (sub != bg)):
+        return None
+    if not np.all(sub[0, :] == color):
+        return None
+    if not np.all(sub[-1, :] == color):
+        return None
+    if not np.all(sub[:, 0] == color):
+        return None
+    if not np.all(sub[:, -1] == color):
+        return None
+
+    hole_mask = sub == bg
+    if not hole_mask.any():
+        return None
+
+    hole_comps = _components_mask(hole_mask)
+    if len(hole_comps) != 1:
+        return None
+
+    hole = hole_comps[0]
+    if np.any(hole[:, 0] == 0) or np.any(hole[:, 0] == sub.shape[0] - 1):
+        return None
+    if np.any(hole[:, 1] == 0) or np.any(hole[:, 1] == sub.shape[1] - 1):
+        return None
+    return _normalize(hole)
