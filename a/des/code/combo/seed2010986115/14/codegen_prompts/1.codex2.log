+    for i in range(len(small)):
+        for j in range(i + 1, len(small)):
+            if _components_touch(small[i], small[j]):
+                graph[small[i]["id"]].add(small[j]["id"])
+                graph[small[j]["id"]].add(small[i]["id"])
