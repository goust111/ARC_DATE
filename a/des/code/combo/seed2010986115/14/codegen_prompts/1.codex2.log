+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
