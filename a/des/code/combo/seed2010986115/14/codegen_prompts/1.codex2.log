+    seen: set[int] = set()
+    mapping: dict[tuple[tuple[int, int], ...], int] = {}
+    for comp in small:
+        cid = comp["id"]
+        if cid in seen:
+            continue
+        stack = [cid]
+        cluster: list[int] = []
+        seen.add(cid)
+        while stack:
+            cur = stack.pop()
+            cluster.append(cur)
+            for nxt in graph[cur]:
+                if nxt not in seen:
+                    seen.add(nxt)
+                    stack.append(nxt)
