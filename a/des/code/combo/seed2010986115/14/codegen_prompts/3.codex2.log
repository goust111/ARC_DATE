+    r0, c0, r1, c1 = region
+    top_wall = r0 - 1
+    bottom_wall = r1 + 1
+    left_wall = c0 - 1
+    right_wall = c1 + 1
+
+    distances = {
+        "top": r - top_wall,
+        "bottom": bottom_wall - r,
+        "left": c - left_wall,
+        "right": right_wall - c,
+    }
+    min_dist = min(distances.values())
+    sides = [side for side, dist in distances.items() if dist == min_dist]
+    if len(sides) != 1:
+        return None
+
+    side = sides[0]
+    if side == "top":
+        return top_wall, c
+    if side == "bottom":
+        return bottom_wall, c
+    if side == "left":
+        return r, left_wall
+    return r, right_wall
