+    r, c = map(int, open_coords[int(open_pick[0])])
+    back[r, c] = True
+    r, c = map(int, open_coords[int(open_pick[1])])
+    back[r, c] = False
+
+    r, c = map(int, closed_coords[int(closed_pick[0])])
+    back[r, c] = True
+    r, c = map(int, closed_coords[int(closed_pick[1])])
+    back[r, c] = False
