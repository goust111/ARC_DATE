+def _enforce_branch_coverage(mask: np.ndarray, back: np.ndarray, rng: np.random.Generator) -> None:
+    open_coords = np.argwhere(mask)
+    closed_coords = np.argwhere(~mask)
+    assert len(open_coords) >= 2 and len(closed_coords) >= 2
