+    min_h = max(_GRID_RANGE[0], max_side + 6)
+    min_w = max(_GRID_RANGE[0], max_side + 6)
+    H = random.randint(min_h, _GRID_RANGE[1])
+    W = random.randint(min_w, _GRID_RANGE[1])
