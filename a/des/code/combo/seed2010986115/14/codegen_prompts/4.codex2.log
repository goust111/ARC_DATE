+def _make_standard_sprite(mask: np.ndarray, body: int, marker: int) -> np.ndarray | None:
+    choices = _top_left_marker_choices(mask)
+    if not choices:
+        return None
+    r, c = random.choice(choices)
+    sprite = np.full(mask.shape, _BG, dtype=int)
