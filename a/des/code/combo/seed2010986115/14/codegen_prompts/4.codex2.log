+def _render_cells(sprite: np.ndarray, top: int, left: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    coords = np.argwhere(sprite != _BG)
+    rows = coords[:, 0] + int(top)
+    cols = coords[:, 1] + int(left)
+    vals = sprite[coords[:, 0], coords[:, 1]]
