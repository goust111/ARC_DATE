+def _choose_orientations(count: int) -> list[int]:
+    distinct = random.randint(2, min(4, count))
+    base = [0] + random.sample([1, 2, 3], distinct - 1)
+    out = base[:]
+    while len(out) < count:
+        out.append(random.choice(base))
+    random.shuffle(out)
+    return out
