+    original: np.ndarray,
+    obstacle_mask: np.ndarray,
+    row: int,
+    color: int,
+    shadow_color: int,
+) -> None:
+    for c in range(1, original.shape[1]):
+        if obstacle_mask[row, c]:
+            out[row, c] = shadow_color
+            break
+        if int(original[row, c]) == BLACK:
+            out[row, c] = color
+
