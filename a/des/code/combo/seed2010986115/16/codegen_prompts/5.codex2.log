+            return None
+        return [near_spec, far_spec]
+
+    band_width = c_hi - c_lo + 1
+    band_height = r_hi - r_lo + 1
+    if band_width < 4 or band_height < 2:
+        return None
+
+    count_near = random.randint(2, min(5, band_height))
+    count_far = random.randint(2, min(5, band_height))
