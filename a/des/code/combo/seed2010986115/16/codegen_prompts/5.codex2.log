+    if row < cross_row and col > cross_col:
+        return "TR"
+    if row > cross_row and col < cross_col:
+        return "BL"
+    if row > cross_row and col > cross_col:
+        return "BR"
+    raise AssertionError("seed must not lie on the separator cross")
