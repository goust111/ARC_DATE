def valid_path(path):
    seen=set()
    for p in path:
        if p in seen: return False
        seen.add(p)
    # check 4-neighbor graph degree <=2 and exactly path sequence adjacencies only
    pos_to_idx={p:i for i,p in enumerate(path)}
    for i,(r,c) in enumerate(path):
        nbs=[]
        for nr,nc in [(r+1,c),(r-1,c),(r,c+1),(r,c-1)]:
            if (nr,nc) in pos_to_idx:
                nbs.append(pos_to_idx[(nr,nc)])
        if len(nbs)>2: return False
        expected=[]
        if i>0: expected.append(i-1)
        if i+1<len(path): expected.append(i+1)
        if sorted(nbs)!=expected:
