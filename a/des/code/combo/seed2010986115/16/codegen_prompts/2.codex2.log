bounds=[]; s=0
for ln in lens:
    bounds.append((s,s+ln-1)); s+=ln
N=sum(lens)

def neigh4(p):
    r,c=p
    for dr,dc in DIRS:
        nr,nc=r+dr,c+dc
        if 0<=nr<H and 0<=nc<W:
            yield (nr,nc)

def adj8(a,b):
    return max(abs(a[0]-b[0]),abs(a[1]-b[1]))==1

def seg_of_index(idx):
    for s,(lo,hi) in enumerate(bounds):
        if lo <= idx <= hi:
            return s
    raise ValueError(idx)

def interior_of_seg(seg_idx,path):
    lo,hi=bounds[seg_idx]
    return path[lo+1:hi]

def topo_ok(path):
    segs=[]
    for lo,hi in bounds: segs.append(path[lo:hi+1])
    E=set()
    for i,a in enumerate(segs):
        for j,b in enumerate(segs):
            if i==j or len(b)<3: continue
            ints=set(b[1:-1])
            for e in [a[0],a[-1]]:
                if any((e[0]+dr,e[1]+dc) in ints for dr,dc in DIR8):
                    E.add((i,j)); break
    indeg=[0]*3; out=[[] for _ in range(3)]
    for a,b in E: indeg[b]+=1; out[a].append(b)
    q=[i for i,d in enumerate(indeg) if d==0]; order=[]
    while q:
        if len(q)"'!=1: return False,E,None
        x=q.pop(0); order.append(x)
        for y in out[x]:
            indeg[y]-=1
            if indeg[y]==0: q.append(y)
    return order==[0,2,1],E,order if len(order)==3 else None

seen=0

def dfs(path,occ):
    global seen
    if len(path)==N:
        ok,E,order=topo_ok(path)
        if ok:
            print('"'FOUND',E,order)
            for r in range(H):
                row=''
                for c in range(W):
                    row += str(path.index((r,c))%10) if (r,c) in occ else '.'
                print(row)
            print(path)
            return True
        return False
    seen += 1
    if seen % 200000 == 0:
        print('seen',seen,file=sys.stderr)

    next_index=len(path)
    next_seg=seg_of_index(next_index)
    cur=path[-1]
    prev=path[-2] if len(path)>=2 else None
    cands=[]
    for nb in neigh4(cur):
        if nb in occ: continue
        bad=False
        for nn in neigh4(nb):
            if nn in occ and nn "'!= cur:
                bad=True; break
        if bad: continue
        score=0
        if prev is not None and (nb[0]-cur[0],nb[1]-cur[1]) != (cur[0]-prev[0],cur[1]-prev[1]):
            score += 1
        score += sum(adj8(nb,p) for p in occ)
        # encourage seg2 interior near seg0 end
        if next_seg==2 and next_index < bounds[2][1] and adj8(nb, path[bounds[0][1]]):
            score += 8
        # final endpoint near seg1 interior
        if next_index == bounds[2][1]:
            if any(adj8(nb,p) for p in interior_of_seg(1,path)):
                score += 20
            else:
                score -= 20
        cands.append((score, random.random(), nb))
    cands.sort(reverse=True)
    for _score,_rnd,nb in cands:
        path.append(nb); occ.add(nb)
        ok=True
        if len(path)-1 == bounds[2][1]:
            if not any(adj8(path[bounds[0][1]], p) for p in interior_of_seg(2,path)):
                ok=False
            if not any(adj8(path[bounds[2][1]], p) for p in interior_of_seg(1,path)):
                ok=False
        if ok and dfs(path,occ):
            return True
        occ.remove(path.pop())
    return False

random.seed(1)
starts=[(r,c) for r in range(H) for c in range(W)]
random.shuffle(starts)
for start in starts:
    if dfs([start], {start}):
        print('"'start',start)
        raise SystemExit
print('none')
