DIRS=[(1,0),(-1,0),(0,1),(0,-1)]
DIR8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]

def gen_path(H=10,W=10,L=30,tries=1000):
    for _ in range(tries):
        start=(random.randrange(H),random.randrange(W))
        path=[start]; vis={start}; stack=[]
        while True:
            if len(path)>=L: return path
            cur=path[-1]; prev=path[-2] if len(path)>=2 else None
            cands=[]
            for dr,dc in DIRS:
                nr,nc=cur[0]+dr,cur[1]+dc
                if 0<=nr<H and 0<=nc<W and (nr,nc) not in vis:
                    near8=sum((nr+er,nc+ec) in vis for er,ec in DIR8)
                    free4=sum(0<=nr+er<H and 0<=nc+ec<W and (nr+er,nc+ec) not in vis for er,ec in DIRS)
                    turn=0 if prev is None else int((dr,dc)"'!=(cur[0]-prev[0],cur[1]-prev[1]))
                    cands.append(((near8,turn,-free4,random.random()),(nr,nc)))
            cands.sort(reverse=True)
            if cands:
                choices=[p for _,p in cands]
                stack.append((len(path), choices[1:]))
                nxt=choices[0]; path.append(nxt); vis.add(nxt)
            else:
                while stack and not stack[-1][1]:
                    depth,_=stack.pop()
                    while len(path)>depth:
                        vis.remove(path.pop())
                if not stack: break
                depth,alts=stack[-1]
                nxt=alts.pop(0)
                while len(path)>depth:
                    vis.remove(path.pop())
                path.append(nxt); vis.add(nxt)
    return None

def near(a,b):
    return max(abs(a[0]-b[0]),abs(a[1]-b[1]))==1

def edges_for_bounds(path,b1,b2,b3):
    segs=[path[:b1+1], path[b1+1:b2+1], path[b2+1:b3+1], path[b3+1:]]
    edges=set()
    for i,a in enumerate(segs):
        ends=(a[0],a[-1])
        for j,b in enumerate(segs):
            if i==j or len(b)<3: continue
            ints=b[1:-1]
            if any(near(e,x) for e in ends for x in ints):
                edges.add((i,j))
    return edges

def unique_order(edges):
    k=4; indeg=[0]*k; out=[[] for _ in range(k)]
    for a,b in edges: indeg[b]+=1; out[a].append(b)
    q=[i for i,d in enumerate(indeg) if d==0]
    order=[]
    while q:
        if len(q)!=1: return None
        x=q.pop(0); order.append(x)
        for y in out[x]:
            indeg[y]-=1
            if indeg[y]==0: q.append(y)
    return order if len(order)==k else None

def find(path,minlen=4):
    n=len(path)
    for b1 in range(minlen-1, n-3*minlen+1):
        # endpoint seg0 near future seg2 interior
        if not any(near(path[b1], path[t]) for t in range(b1+minlen+1, n-minlen-1)):
            continue
        for b2 in range(b1+minlen, n-2*minlen+1):
            # seg1 length ok
            for b3 in range(b2+minlen, n-minlen):
                if b3-b2<minlen or n-(b3+1)<minlen: continue
                edges=edges_for_bounds(path,b1,b2,b3)
                order=unique_order(edges)
                if order==[0,2,1,3]:
                    return (b1,b2,b3,edges)
    return None

random.seed(0)
found=0
trials=100
for _ in range(trials):
    path=gen_path(H=random.randint(9,12),W=random.randint(9,12),L=random.randint(24,34))
    if path and find(path):
        found+=1
print('"'rate',found/trials)
