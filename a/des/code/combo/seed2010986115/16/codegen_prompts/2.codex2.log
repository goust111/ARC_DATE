    edges=set()
    for i,a in enumerate(segs):
        ends=[a[0],a[-1]]
        for j,b in enumerate(segs):
            if i==j or len(b)<3: continue
            interior=set(b[1:-1])
            if any((er+dr,ec+dc) in interior for er,ec in ends for dr,dc in DIR8):
                edges.add((i,j))
    return edges

def unique_topo(k,edges):
    indeg=[0]*k; out=[[] for _ in range(k)]
    for a,b in edges: indeg[b]+=1; out[a].append(b)
