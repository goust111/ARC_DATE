+def _gen_random_path(height: int, width: int, length: int) -> list[tuple[int, int]] | None:
+    for _ in range(_GEN_PATH_RETRIES):
+        start = (random.randrange(height), random.randrange(width))
+        path = [start]
+        occupied = {start}
+        stack: list[tuple[int, list[tuple[int, int]]]] = []
+
+        while True:
