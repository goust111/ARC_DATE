import random, sys
DIR8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]

def build(lens, dirs, start_col=0):
    # dirs: +1 or -1 for each lane horizontal direction starting from connector/start point.
    path=[]
    r=0; c=start_col
    path.append((r,c))
    for i,(L,d) in enumerate(zip(lens,dirs)):
        if i>0:
            # already at row 2*i and start col from prev connector
            pass
        target = c + d*(L-1)
        while c "'!= target:
            c += d
            path.append((r,c))
        if i == len(lens)-1:
            break
        r += 1; path.append((r,c))
        r += 1; path.append((r,c))
    return path

def valid(path):
    S={p:i for i,p in enumerate(path)}
    if len(S)!=len(path): return False
    for i,(r,c) in enumerate(path):
        n=[]
        for q in [(r+1,c),(r-1,c),(r,c+1),(r,c-1)]:
            if q in S: n.append(S[q])
        exp=[]
        if i>0: exp.append(i-1)
        if i+1<len(path): exp.append(i+1)
        if sorted(n)!=exp: return False
    return True

def comps(n,k,minp):
    out=[]
    def rec(rem,kk,p):
        if kk==1:
            if rem>=minp: out.append(p+[rem])
            return
        for x in range(minp, rem-minp*(kk-1)+1): rec(rem-x,kk-1,p+[x])
    rec(n,k,[])
    return out

def topo(path,lens):
    segs=[]; s=0
    for ln in lens: segs.append(path[s:s+ln]); s+=ln
    E=set()
    for i,a in enumerate(segs):
        for j,b in enumerate(segs):
            if i==j or len(b)<3: continue
            ints=set(b[1:-1])
            for e in [a[0],a[-1]]:
                if any((e[0]+dr,e[1]+dc) in ints for dr,dc in DIR8):
                    E.add((i,j)); break
    k=len(segs); indeg=[0]*k; out=[[] for _ in range(k)]
    for a,b in E: indeg[b]+=1; out[a].append(b)
    q=[i for i,d in enumerate(indeg) if d==0]; order=[]
    while q:
        if len(q)!=1: return None,E
        x=q.pop(0); order.append(x)
        for y in out[x]: indeg[y]-=1; q += [y] if indeg[y]==0 else []
    return tuple(order) if len(order)==k else None,E

random.seed(0)
