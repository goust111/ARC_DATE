DIRS=[(1,0),(-1,0),(0,1),(0,-1)]
DIR8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]

def gen_path(H=10,W=10,L=28,tries=300):
    for _ in range(tries):
        start=(random.randrange(H),random.randrange(W))
        path=[start]; occ={start}; stack=[]
        while True:
            if len(path)>=L: return path
            cur=path[-1]; prev=path[-2] if len(path)>=2 else None
            cands=[]
            for dr,dc in DIRS:
                nr,nc=cur[0]+dr,cur[1]+dc
                if not (0<=nr<H and 0<=nc<W) or (nr,nc) in occ: continue
                bad=False; near8=0
                for rr,cc in occ:
                    if abs(rr-nr)+abs(cc-nc)==1 and (rr,cc)"'!=(cur[0],cur[1]): bad=True; break
                    if max(abs(rr-nr),abs(cc-nc))==1: near8 += 1
                if bad: continue
                turn=0 if prev is None else int((dr,dc)!=(cur[0]-prev[0],cur[1]-prev[1]))
                cands.append(((near8,turn,random.random()),(nr,nc)))
            cands.sort(reverse=True)
            if cands:
                choices=[p for _,p in cands]
                stack.append((len(path), choices[1:]))
                nxt=choices[0]; path.append(nxt); occ.add(nxt)
            else:
                while stack and not stack[-1][1]:
                    depth,_=stack.pop()
                    while len(path)>depth: occ.remove(path.pop())
                if not stack: break
                depth,alts=stack[-1]
                nxt=alts.pop(0)
                while len(path)>depth: occ.remove(path.pop())
                path.append(nxt); occ.add(nxt)
    return None

def comps(n,k,minp):
    out=[]
    def rec(rem,kk,p):
        if kk==1:
            if rem>=minp: out.append(p+[rem])
            return
        for x in range(minp, rem-minp*(kk-1)+1): rec(rem-x,kk-1,p+[x])
    rec(n,k,[])
    return out

comp_cache={}
def get_comps(n):
    return comp_cache.setdefault(n, comps(n,4,4))

def unique_order(path,lens):
    segs=[]; s=0
    for ln in lens: segs.append(path[s:s+ln]); s+=ln
    E=set()
    for i,a in enumerate(segs):
        ends=(a[0],a[-1])
        for j,b in enumerate(segs):
            if i==j or len(b)<3: continue
            ints=set(b[1:-1])
            hit=False
            for er,ec in ends:
                for dr,dc in DIR8:
                    if (er+dr,ec+dc) in ints:
                        E.add((i,j)); hit=True; break
                if hit: break
    indeg=[0]*4; out=[[] for _ in range(4)]
    for a,b in E: indeg[b]+=1; out[a].append(b)
    q=[i for i,d in enumerate(indeg) if d==0]; order=[]
    while q:
        if len(q)!=1: return None
        x=q.pop(0); order.append(x)
        for y in out[x]:
            indeg[y]-=1
            if indeg[y]==0: q.append(y)
    return order if len(order)==4 else None

random.seed(0)
count=0; found=0
start=time.time()
for _ in range(200):
    L=random.randint(22,34)
    p=gen_path(H=random.randint(9,12),W=random.randint(9,12),L=L)
    if p is None: continue
    count+=1
    ok=False
    for lens in get_comps(L):
        order=unique_order(p,lens)
        if order and order[0]==0 and order!=[0,1,2,3]:
