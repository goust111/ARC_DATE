+    counts: Counter = Counter()
+
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            expected = even_bg if (r + c) % 2 == 0 else odd_bg
+            color = int(grid[r, c])
+            if color == expected:
+                continue
+            markers.append((r, c, color))
+            counts[color] += 1
+
+    assert markers, "expected at least one colored marker"
+    return markers, counts
+
+
