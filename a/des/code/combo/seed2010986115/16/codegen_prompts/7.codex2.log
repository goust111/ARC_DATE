+def _checkerboard(h: int, w: int, even_color: int, odd_color: int) -> np.ndarray:
+    rows = np.arange(h, dtype=int)[:, None]
+    cols = np.arange(w, dtype=int)[None, :]
+    return np.where((rows + cols) % 2 == 0, even_color, odd_color).astype(int)
+
