    31	def _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:
    32	    r0 = min(r for r, _ in coords)
    33	    r1 = max(r for r, _ in coords)
    34	    c0 = min(c for _, c in coords)
    35	    c1 = max(c for _, c in coords)
    36	    height = r1 - r0 + 1
    37	    width = c1 - c0 + 1
    38	    if height != width:
    39	        return None
    40	    n = height
    41	    local = {(r - r0, c - c0) for r, c in coords}
    42	    main_ok = all((c, r) in local for r, c in local)
    43	    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)
    44	    if main_ok:
    45	        if (0, 0) in local and (n - 1, n - 1) not in local:
    46	            return "TL"
    47	        if (n - 1, n - 1) in local and (0, 0) not in local:
    48	            return "BR"
    49	    if anti_ok:
    50	        if (0, n - 1) in local and (n - 1, 0) not in local:
    51	            return "TR"
    52	        if (n - 1, 0) in local and (0, n - 1) not in local:
    53	            return "BL"
    54	    return None
