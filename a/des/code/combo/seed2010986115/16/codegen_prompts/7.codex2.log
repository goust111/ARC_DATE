+    else:
+        even_bg, odd_bg = BLACK, GREY
+    grid = _checkerboard(h, w, even_bg, odd_bg)
+
+    colors = [int(c) for c in rng.choice(MARKER_COLORS, size=n_colors, replace=False)]
+    for color, cells in zip(colors, groups):
