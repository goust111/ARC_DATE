+    cells: list[tuple[int, int]] = []
+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        cells.append((center_r + dr, center_c + dc))
+        if dc != 0:
+            cells.append((center_r + dr, center_c - dc))
