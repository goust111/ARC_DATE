+    order: list[int] = []
+    prev = -1
+    cur = start
+    while True:
+        order.append(cur)
+        next_nodes = [nxt for nxt in adjacency[cur] if nxt != prev]
+        if not next_nodes:
+            break
+        assert len(next_nodes) == 1
+        prev, cur = cur, next_nodes[0]
