+    left_margin = int(rng.integers(MARGIN_MIN, MARGIN_MAX + 1))
+    bottom_margin = int(rng.integers(MARGIN_MIN, MARGIN_MAX + 1))
+    right_margin = int(rng.integers(MARGIN_MIN, MARGIN_MAX + 1))
