+    out = np.full_like(g, BG)
+    for pos, node_idx in enumerate(order, start=1):
+        paint_color = nodes[node_idx]["color"] if pos % 2 == 1 else AZURE
+        for r, c in nodes[node_idx]["points"]:
+            out[r, c] = paint_color
