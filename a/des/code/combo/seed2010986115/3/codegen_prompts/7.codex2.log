+            return False
+        order = rng.permutation(len(candidates))
+        shuffled = [candidates[i] for i in order]
+        shuffled.sort(key=lambda item: item[0], reverse=True)
+        for _, nxt in shuffled:
+            seen.add(nxt)
+            path.append(nxt)
