+            end = _outside_port(center_b, size_b, (0, -1))
+        else:
+            start = _outside_port(center_a, size_a, (0, -1))
+            end = _outside_port(center_b, size_b, (0, 1))
+        assert start[0] == end[0]
+        c0, c1 = sorted((start[1], end[1]))
+        return [(start[0], c) for c in range(c0, c1 + 1)]
