+    out[:-1, :] |= src[1:, :]
+    out[:, 1:] |= src[:, :-1]
+    out[:, :-1] |= src[:, 1:]
+    out[1:, 1:] |= src[:-1, :-1]
+    out[1:, :-1] |= src[:-1, 1:]
+    out[:-1, 1:] |= src[1:, :-1]
+    out[:-1, :-1] |= src[1:, 1:]
