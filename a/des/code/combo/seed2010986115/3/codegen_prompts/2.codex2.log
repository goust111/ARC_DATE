+        r0 = random.randint(r_lo, r_hi)
+        c0 = random.randint(c_lo, c_hi)
+        obj = _materialize_object(color, ray_len, variant, r0, c0)
+        if _can_place_object(obj, placed, occupied):
+            return obj
+
+    return None
+
+
+def _ray_prefix_clear(
+    obj: dict[str, object],
+    occupied: set[tuple[int, int]],
