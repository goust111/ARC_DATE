+                        return obj
+
+    return None
+
+
+def _render_grid(grid_shape: tuple[int, int], objects: list[dict[str, object]]) -> np.ndarray:
+    grid = np.zeros(grid_shape, dtype=int)
+    for obj in objects:
+        for r, c in obj["cells"]:
