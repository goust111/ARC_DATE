+
+
+_BASE_TEMPLATES = [
+    ("101", "111"),
+    ("101", "111", "010"),
+    ("101", "111", "100"),
+    ("101", "111", "001"),
+    ("1011", "1110"),
+    ("1101", "0111"),
+]
+
+_GROUP_COUNT_OPTIONS = [
+    (2,),
+    (3,),
+    (4,),
+    (2, 2),
+    (2, 3),
+    (2, 4),
+    (3, 3),
+    (2, 2, 2),
+    (2, 2, 3),
+    (3, 4),
+]
