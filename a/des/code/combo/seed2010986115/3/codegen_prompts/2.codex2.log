+def _validate_candidate(
+    grid: np.ndarray,
+    objects: list[dict[str, object]],
+    want_blocked: bool,
+) -> bool:
+    comps = _find_components(grid)
+    if len(comps) != len(objects):
+        return False
+
+    used: set[tuple[int, int]] = set()
+    has_blocked = False
+    has_full = False
+
+    for obj in objects:
+        cells = _ray_cells_on_input(obj, grid)
+        if len(cells) < int(obj["ray_len"]):
