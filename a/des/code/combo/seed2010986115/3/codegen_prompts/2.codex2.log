+    if len(comps) != len(objects):
+        return False
+
+    used: set[tuple[int, int]] = set()
+    has_blocked = False
+    has_full = False
+
+    for obj in objects:
+        cells = _ray_cells_on_input(obj, grid)
+        if len(cells) < int(obj["ray_len"]):
+            has_blocked = True
+        else:
+            has_full = True
+        for cell in cells:
+            if cell in used:
+                return False
+            used.add(cell)
