+BG = 0
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return (
+        int(rows.min()),
+        int(cols.min()),
+        int(rows.max()),
+        int(cols.max()),
+    )
+
+
+def _find_components(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(grid[r0, c0])
+            if color == BG or seen[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in DIR_VECS.values():
+                    nr = r + dr
+                    nc = c + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                }
+            )
+
+    return comps
+
+
+def _coords_to_mask(
+    coords: np.ndarray,
+    bbox: tuple[int, int, int, int],
+) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _notch_index(line: np.ndarray) -> int | None:
+    if line.size < 3:
+        return None
+    gaps = np.flatnonzero(~line)
+    if gaps.size != 1:
+        return None
+    idx = int(gaps[0])
+    if idx == 0 or idx == line.size - 1:
+        return None
+    if bool(line[idx - 1]) and bool(line[idx + 1]):
+        return idx
+    return None
+
+
+def _detect_notch_from_mask(mask: np.ndarray) -> tuple[str, tuple[int, int]]:
+    h, w = mask.shape
+    candidates: list[tuple[str, tuple[int, int]]] = []
+
+    idx = _notch_index(mask[0, :])
+    if idx is not None:
+        candidates.append(("up", (0, idx)))
+
+    idx = _notch_index(mask[h - 1, :])
+    if idx is not None:
+        candidates.append(("down", (h - 1, idx)))
+
+    idx = _notch_index(mask[:, 0])
+    if idx is not None:
+        candidates.append(("left", (idx, 0)))
+
+    idx = _notch_index(mask[:, w - 1])
+    if idx is not None:
+        candidates.append(("right", (idx, w - 1)))
+
+    assert len(candidates) == 1, "expected exactly one boundary notch direction"
+    return candidates[0]
+
