+    dr, dc = DIR_VECS[obj["direction"]]
+    cells: list[tuple[int, int]] = []
+
+    for _ in range(int(obj["ray_len"])):
+        if not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]):
+            break
+        if int(grid[r, c]) != BG:
+            break
+        cells.append((r, c))
+        r += dr
+        c += dc
+
+    return cells
+
