+        pattern_zone = seg[:, 1:]
+        nz = np.argwhere(pattern_zone != bg)
+        if nz.size == 0:
+            return None
+        pr0, pc0 = nz.min(axis=0)
+        pr1, pc1 = nz.max(axis=0)
+        pattern = pattern_zone[int(pr0) : int(pr1) + 1, int(pc0) : int(pc1) + 1].copy()
