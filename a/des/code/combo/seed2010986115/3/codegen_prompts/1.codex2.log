+    if not candidates:
+        raise ValueError("legend strip not found")
+
+    candidates.sort(key=lambda item: (item[0], 0 if item[1] == "bottom" else 1, item[2]))
+    _, orientation, cut, mapping = candidates[0]
+    return orientation, cut, mapping
