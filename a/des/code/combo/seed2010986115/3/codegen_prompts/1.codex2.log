+def _tile(pattern: np.ndarray, height: int, width: int) -> np.ndarray:
+    rr = np.arange(height)[:, None] % pattern.shape[0]
+    cc = np.arange(width)[None, :] % pattern.shape[1]
+    return pattern[rr, cc]
