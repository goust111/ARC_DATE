+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PAYLOAD_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+SIDES = ("top", "bottom", "left", "right")
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GRID_MIN = 18
+GRID_MAX = 32
+ROOM_COUNT_MIN = 1
+ROOM_COUNT_MAX = 4
+ROOM_OUTER_MIN = 5
+ROOM_OUTER_MAX = 9
+MAX_PAYLOAD = 8
+MAX_RETRIES = 400
+PLACE_TRIES = 200
