+        max_payload = min(len(payload_cells), exterior, MAX_PAYLOAD)
+        if max_payload < 1:
+            continue
+
+        if max_payload >= 2 and rng.random() < 0.85:
+            count = int(rng.integers(2, max_payload + 1))
+        else:
+            count = int(rng.integers(1, max_payload + 1))
+        payload_cells = payload_cells[:count]
