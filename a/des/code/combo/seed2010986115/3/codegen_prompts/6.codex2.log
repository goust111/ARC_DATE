+            nr = door_r + dr * idx
+            nc = door_c + dc * idx
+            assert 0 <= nr < h and 0 <= nc < w, "queue must stay inside the grid"
+            assert int(g[nr, nc]) == BG, "queue path must start on background"
+            key = (nr, nc)
