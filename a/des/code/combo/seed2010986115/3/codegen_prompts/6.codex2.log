+def _draw_room(grid: np.ndarray, room: dict) -> None:
+    r0, c0, r1, c1 = room["bbox"]
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
