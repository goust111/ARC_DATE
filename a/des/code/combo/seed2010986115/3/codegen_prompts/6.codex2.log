+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _door_side(door: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = door
+    r0, c0, r1, c1 = bbox
+    matches = []
+    if r == r0:
+        matches.append("top")
+    if r == r1:
+        matches.append("bottom")
+    if c == c0:
+        matches.append("left")
+    if c == c1:
+        matches.append("right")
+    assert len(matches) == 1, "door must lie on exactly one side"
+    return matches[0]
+
+
+def _sorted_payload(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    side: str,
+) -> list[tuple[int, int, int]]:
+    r0, c0, r1, c1 = bbox
+    payload: list[tuple[int, int, int]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            color = int(grid[r, c])
+            if color not in (BG, FRAME):
+                payload.append((r, c, color))
+
+    if side == "top":
+        payload.sort(key=lambda item: (item[0], item[1]))
+    elif side == "bottom":
+        payload.sort(key=lambda item: (r1 - item[0], item[1]))
+    elif side == "left":
+        payload.sort(key=lambda item: (item[1], item[0]))
+    else:
+        payload.sort(key=lambda item: (c1 - item[1], item[0]))
+    return payload
