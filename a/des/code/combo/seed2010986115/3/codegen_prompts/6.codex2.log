+    size_min = max(GRID_MIN, 14 + room_count * 3)
+    h = int(rng.integers(size_min, GRID_MAX + 1))
+    w = int(rng.integers(size_min, GRID_MAX + 1))
+
+    grid = np.full((h, w), BG, dtype=int)
+    blocked: set[tuple[int, int]] = set()
+    rooms: list[dict] = []
