+        probe = _pack_rectangles([(h, w, 1) for h, w in rect_dims], bg=0, direction_edge=direction_edge)
+        if probe.shape[0] > MAX_OUTPUT_SIDE or probe.shape[1] > MAX_OUTPUT_SIDE:
