+    direction_edge: str,
+) -> bool:
+    h, w = grid.shape
+    sh, sw = _shape_dims(shape)
+
+    row_min = 1
+    row_max = h - sh - 1
+    col_min = 1
+    col_max = w - sw - 1
+
+    if direction_edge == "top":
+        row_min = 2
+    elif direction_edge == "bottom":
+        row_max = h - sh - 2
+    elif direction_edge == "left":
+        col_min = 2
+    else:
+        col_max = w - sw - 2
