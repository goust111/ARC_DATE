+            "shape_a": shape_a,
+            "shape_b": shape_b,
+        }
+    raise RuntimeError("failed to sample a pair descriptor")
+
+
+def _has_useful_tie(rectangles: list[tuple[int, int]]) -> bool:
+    by_area: dict[int, set[int]] = defaultdict(set)
+    for h, w in rectangles:
