+            min_r = min(r for r, _c in coords)
+            min_c = min(c for _r, c in coords)
+            max_r = max(r for r, _c in coords)
+            max_c = max(c for _r, c in coords)
+            shape = frozenset((r - min_r, c - min_c) for r, c in coords)
+            components.append(
+                {
+                    "color": color,
+                    "coords": tuple(coords),
+                    "bbox": (min_r, min_c, max_r, max_c),
+                    "shape": shape,
