+    return any(len(heights) >= 2 for heights in by_area.values())
+
+
+def _sample_descriptors(pair_count: int, direction_edge: str) -> list[dict[str, object]] | None:
+    force_tie = _RNG.random() < 0.5 and pair_count >= 2
