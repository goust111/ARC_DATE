+        return False
+
+    r0, c0 = _RNG.choice(candidates)
+    for dr, dc in shape:
+        grid[r0 + dr, c0 + dc] = color
+    occupied[r0 - 1 : r0 + sh + 1, c0 - 1 : c0 + sw + 1] = True
+    return True
+
+
+def _random_rotated(shape: frozenset[Coord]) -> frozenset[Coord]:
+    return _RNG.choice(_unique_rotations(shape))
+
+
