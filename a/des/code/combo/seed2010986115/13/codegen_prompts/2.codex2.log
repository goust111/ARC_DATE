def l_shapes(maxh=5,maxw=5):
    shapes=[]
    for h in range(2,maxh+1):
      for w in range(2,maxw+1):
        for miss_h in range(1,h):
          for miss_w in range(1,w):
            for corner in range(4):
              cells=set((r,c) for r in range(h) for c in range(w))
              miss=set()
              if corner==0: # tl
                miss={(r,c) for r in range(miss_h) for c in range(miss_w)}
              elif corner==1: # tr
                miss={(r,c) for r in range(miss_h) for c in range(w-miss_w,w)}
              elif corner==2: # bl
                miss={(r,c) for r in range(h-miss_h,h) for c in range(miss_w)}
              else: # br
                miss={(r,c) for r in range(h-miss_h,h) for c in range(w-miss_w,w)}
              shape=cells-miss
              # keep only if bbox is full h,w and connected
