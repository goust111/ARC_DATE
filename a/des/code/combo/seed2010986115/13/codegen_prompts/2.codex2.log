+def _normalize(shape: set[Coord] | frozenset[Coord]) -> frozenset[Coord]:
+    rows = [r for r, _c in shape]
+    cols = [c for _r, c in shape]
+    min_r = min(rows)
+    min_c = min(cols)
+    return frozenset((r - min_r, c - min_c) for r, c in shape)
