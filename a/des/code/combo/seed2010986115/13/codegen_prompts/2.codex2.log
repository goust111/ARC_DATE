+
+def _place_piece(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    shape: frozenset[Coord],
+    color: int,
+    direction_edge: str,
+) -> bool:
+    h, w = grid.shape
+    sh, sw = _shape_dims(shape)
+
+    row_min = 1
+    row_max = h - sh - 1
+    col_min = 1
+    col_max = w - sw - 1
