9:     """
10:     Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.
11: 
12:     Input structure:
13:     - Four 5×5 panels in one row, border-separated.
14:     - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)
15:                + one 8-isolated indicator pixel.
16:     - Panels 1–2: source patterns. Panel 3: blank (to fill).
17: 
18:     Rule:
19:     - Flood-fill (4-conn) from indicator, blocked by wall → inside region.
20:     - Inside → non-bg from panel 1; outside → non-bg from panel 2.
21:     - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.
22: 
23:     Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.
24:     """
25:     g = np.array(grid, dtype=int)
26: 
27:     border = int(g[0, 0])
28:     tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]
29:     t0, t1, t2, _t3 = tiles
30:     b = int(Counter(t1.flatten()).most_common(1)[0][0])
31:     assert border != b, "border color must differ from tile background"
32: 
33:     t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])
34:     cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}
35:     assert cue_set, "no cue pixels found"
36: 
37:     # --- Indicator = the unique 8-isolated cue pixel ---
38:     indicator = None
39:     for r, c in cue_set:
40:         if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):
41:             assert indicator is None, "multiple 8-isolated cue pixels"
42:             indicator = (r, c)
43:     assert indicator is not None, "no 8-isolated cue pixel found"
44: 
45:     # Indicator must sit at a tile corner or edge midpoint
46:     valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}
47:     assert indicator in valid_pos, f"indicator {indicator} not at corner/edge-midpoint"
48: 
49:     wall = cue_set - {indicator}
50: 
51:     # --- Structural assertions (feedback for generate_input agents) ---
52:     assert (2, 2) in wall, "wall must pass through the grid center (2,2)"
53: 
54:     # Wall must be symmetric about the line from indicator to center (2,2)
55:     ir, ic = indicator
56:     dr, dc = 2 - ir, 2 - ic
57:     if dr == 0:
58:         _refl = lambda r, c: (4 - r, c)
59:     elif dc == 0:
60:         _refl = lambda r, c: (r, 4 - c)
61:     elif dr * dc > 0:
62:         _refl = lambda r, c: (c, r)
63:     else:
64:         _refl = lambda r, c: (4 - c, 4 - r)
65:     assert wall == {_refl(r, c) for r, c in wall}, "wall must be symmetric about indicator→center axis"
66: 
67:     sides_touched = set()
68:     for r, c in wall:
69:         if r == 0: sides_touched.add("top")
70:         if r == 4: sides_touched.add("bottom")
71:         if c == 0: sides_touched.add("left")
72:         if c == 4: sides_touched.add("right")
73:     assert len(sides_touched) >= 2, f"wall must span edge-to-edge, only touches {sides_touched}"
74: 
75:     # --- Flood fill inside region ---
76:     EMPTY, WALL, INSIDE = 0, 1, 2
77:     tmp = np.zeros((5, 5), dtype=int)
78:     for r, c in wall:
79:         tmp[r, c] = WALL
80:     flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)
81:     inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}
82: 
83:     outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall
84:     assert outside, "wall must partition the grid — outside region is empty"
85: 
