+    for _ in range(200):
+        descriptors = [_RNG.choice(VALID_PAIR_DESCRIPTORS) for _ in range(pair_count)]
+        rect_dims = [tuple(desc["rect_dims"]) for desc in descriptors]
+        assert all(isinstance(item, tuple) for item in rect_dims)
