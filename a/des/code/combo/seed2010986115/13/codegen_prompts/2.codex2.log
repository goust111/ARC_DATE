+def _unique_rotations(shape: frozenset[Coord]) -> list[frozenset[Coord]]:
+    out: list[frozenset[Coord]] = []
+    seen: set[frozenset[Coord]] = set()
+    cur = _normalize(shape)
+    for _ in range(4):
