+    rows = [r for r, _c in missing]
+    cols = [c for _r, c in missing]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    if len(missing) != (r1 - r0 + 1) * (c1 - c0 + 1):
+        return False
+    return bool(
+        (r0 == 0 and c0 == 0)
+        or (r0 == 0 and c1 == w - 1)
+        or (r1 == h - 1 and c0 == 0)
+        or (r1 == h - 1 and c1 == w - 1)
