+    def block_cells(block_r: int, block_c: int) -> set[Coord]:
+        r0 = row_starts[block_r]
+        c0 = col_starts[block_c]
+        return {
+            (r, c)
+            for r in range(r0, r0 + row_blocks[block_r])
+            for c in range(c0, c0 + col_blocks[block_c])
+        }
