+    shape_a: set[Coord] = set()
+    shape_b: set[Coord] = set()
+    for block_r, block_c in MACRO_A:
+        shape_a |= block_cells(block_r, block_c)
+    for block_r, block_c in MACRO_B:
+        shape_b |= block_cells(block_r, block_c)
