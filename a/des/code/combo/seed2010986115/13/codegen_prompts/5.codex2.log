+        defect_r = r0 + defect_local[0]
+        defect_c = c0 + defect_local[1]
+        out[defect_r, 0] = color
+        out[defect_r, w - 1] = color
+        out[0, defect_c] = color
+        out[h - 1, defect_c] = color
+
+    return out
