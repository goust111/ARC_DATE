PALETTE_COLORS = [1, 2, 3, 4, 5]

# Interior bbox and marker sampling.
BBOX_HEIGHT_BOUNDS = (2, 6)
BBOX_WIDTH_BOUNDS = (2, 7)
INTERIOR_ROW_BOUNDS = (2, 8)
INTERIOR_COL_BOUNDS = (1, 8)
WINNER_COUNT_BOUNDS = (2, 10)
DIAGONAL_CHOICES = [False, True]
