+def _make_symmetric_mask() -> np.ndarray | None:
+    raw_h = random.randint(4, 8)
+    raw_w = random.randint(4, 8)
+    mask = np.zeros((raw_h, raw_w), dtype=bool)
+
+    orbit_reps = []
+    for r in range(raw_h):
+        for c in range(raw_w):
+            rr = raw_h - 1 - r
+            cc = raw_w - 1 - c
+            if (r, c) > (rr, cc):
