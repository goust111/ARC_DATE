+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        queue = deque([(r, c)])
+        seen[r, c] = True
+        coords = []
+        while queue:
+            rr, cc = queue.popleft()
+            coords.append((rr, cc))
+            for nr, nc in _neighbors8(rr, cc, h, w):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
