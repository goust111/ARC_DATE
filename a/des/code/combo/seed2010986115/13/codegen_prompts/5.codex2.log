import random, math
from collections import Counter, deque
import numpy as np


def neighbors8(r,c,h,w):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==0 and dc==0:
                continue
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w:
                yield rr,cc

def neighbors4(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def comp_count(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    cnt=0
    for r,c in np.argwhere(mask):
        if seen[r,c]:
            continue
        cnt+=1
        dq=[(int(r),int(c))]
        seen[r,c]=True
        while dq:
            x,y=dq.pop()
            for xx,yy in neighbors8(x,y,h,w):
                if mask[xx,yy] and not seen[xx,yy]:
                    seen[xx,yy]=True
                    dq.append((xx,yy))
    return cnt

def perimeter(mask):
    h,w=mask.shape
    p=0
    for r,c in np.argwhere(mask):
        r=int(r);c=int(c)
        for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if not (0<=rr<h and 0<=cc<w and mask[rr,cc]):
                p+=1
    return p

def tips(mask):
    h,w=mask.shape
    t=0
    for r,c in np.argwhere(mask):
        r=int(r);c=int(c)
        deg=sum(1 for rr,cc in neighbors4(r,c,h,w) if mask[rr,cc])
        if deg<=1:
            t+=1
    return t

def holes(mask):
    h,w=mask.shape
    bg=~mask
    seen=np.zeros_like(mask,dtype=bool)
    dq=[]
    for r in range(h):
        for c in (0,w-1):
            if bg[r,c] and not seen[r,c]:
                seen[r,c]=True; dq.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if bg[r,c] and not seen[r,c]:
                seen[r,c]=True; dq.append((r,c))
    while dq:
        x,y=dq.pop()
        for xx,yy in neighbors4(x,y,h,w):
            if bg[xx,yy] and not seen[xx,yy]:
                seen[xx,yy]=True; dq.append((xx,yy))
    return int(np.sum(bg & ~seen))

def score(mask):
    if not np.any(mask):
        return -10**9
    cc=comp_count(mask)
    p=perimeter(mask)
    a=int(mask.sum())
    t=tips(mask)
    h=holes(mask)
    compact=(p*p)/a
    return -200*(cc-1)-40*h-compact-0.5*p-0.5*t

def crop(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(axis=0)
    r1,c1=pts.max(axis=0)
    return mask[r0:r1+1,c0:c1+1]

def infer(mask):
    rot=mask[::-1,::-1]
    diff=mask"'^rot
    pts=np.argwhere(diff)
    if len(pts)!=2:
        return None
    occ=[tuple(map(int,p)) for p in pts if mask[tuple(p)]]
    emp=[tuple(map(int,p)) for p in pts if not mask[tuple(p)]]
    if len(occ)!=1 or len(emp)!=1:
        return None
    occ=occ[0]; emp=emp[0]
    cand_rm=mask.copy(); cand_rm[occ]=False
    cand_add=mask.copy(); cand_add[emp]=True
    if not np.array_equal(cand_rm,cand_rm[::-1,::-1]):
        return None
    if not np.array_equal(cand_add,cand_add[::-1,::-1]):
        return None
    srm=score(crop(cand_rm))
    sadd=score(crop(cand_add))
    return ('"'remove', occ, srm, sadd) if srm>sadd else ('add', emp, srm, sadd)

def gen_sym():
    H=random.randint(4,8); W=random.randint(4,8)
    mask=np.zeros((H,W),dtype=bool)
    centers=[]
    if H%2==1 and W%2==1:
        centers.append((H//2,W//2))
    # start orbit near center
    orbit_options=[]
    for r in range(H):
        for c in range(W):
            rr,cc=H-1-r,W-1-c
            orbit=sorted({(r,c),(rr,cc)})
            if orbit not in orbit_options:
                orbit_options.append(orbit)
    orbit_options.sort(key=lambda orb: min(abs(r-(H-1)/2)+abs(c-(W-1)/2) for r,c in orb))
    init=random.choice(orbit_options[:min(6,len(orbit_options))])
    for cell in init:
        mask[cell]=True
    target=random.randint(max(4, len(init)+2), min(H*W-1, max(6, (H*W*2)//3)))
    tries=0
    while mask.sum()<target and tries<500:
        tries+=1
        occs=[tuple(map(int,p)) for p in np.argwhere(mask)]
        r,c=random.choice(occs)
