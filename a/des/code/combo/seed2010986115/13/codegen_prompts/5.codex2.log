+
+def _shape_score(mask: np.ndarray) -> float:
+    cropped, _ = _crop_mask(mask)
+    if cropped.size == 0 or not np.any(cropped):
+        return -1e9
+    area = int(cropped.sum())
+    perimeter = _perimeter(cropped)
+    compactness = (perimeter * perimeter) / float(area)
