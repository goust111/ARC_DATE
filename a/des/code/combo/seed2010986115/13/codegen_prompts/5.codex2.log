+
+    if _mode_color(grid) != BG_COLOR:
+        return None
+
+    if return_output:
+        return grid, _render_output(grid, placements)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        result = _generate_case(return_output=False)
+        if result is not None:
