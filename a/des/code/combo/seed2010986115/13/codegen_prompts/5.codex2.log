+    init_r, init_c = random.choice(orbit_reps[: min(6, len(orbit_reps))])
+    init_rr = raw_h - 1 - init_r
+    init_cc = raw_w - 1 - init_c
+    mask[init_r, init_c] = True
+    mask[init_rr, init_cc] = True
+
+    max_area = min(raw_h * raw_w - 1, max(8, (raw_h * raw_w * 2) // 3))
