+        out[r0 + 1 : r0 + 1 + INNER_SIZE, c0 + 1 : c0 + 1 + INNER_SIZE] = patterns[degree - 1]
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
