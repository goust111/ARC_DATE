+            col = c0 + NODE_SIZE // 2
+            grid[r0 + NODE_SIZE : down_r0, col] = line
+    return pixel_nodes
+
+
+def _expected_output(
+    grid: np.ndarray,
+    pixel_nodes: dict[tuple[int, int], tuple[int, int]],
