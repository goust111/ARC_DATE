+    net_w = NODE_SIZE + (slot_w - 1) * pitch_c
+
+    dict_h = INNER_SIZE
+    dict_w = DICT_PATTERNS * INNER_SIZE + (DICT_PATTERNS - 1) * DICT_GAP
