+    if _most_common_color(grid) != bg:
+        return None
+    if _line_color(grid, bg) != line:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_ATTEMPTS):
