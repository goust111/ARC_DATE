+
+    out = g.copy()
+    for r, c, marker_color, orientation, object_color, crack_cells in jobs:
+        keep_lower_or_left = keep_lower_left[marker_color]
+        if orientation == "vertical":
+            left_seed = (r, c - 1)
+            right_seed = (r, c + 1)
