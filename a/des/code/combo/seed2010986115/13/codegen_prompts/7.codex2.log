+    row_colors = [set() for _ in range(h)]
+    col_colors = [set() for _ in range(w - 1)]
+    for r, c in towers:
+        color = int(grid[r, c])
+        row_colors[int(r)].add(color)
+        col_colors[int(c)].add(color)
+    return row_colors, col_colors
+
+
+def main(grid: np.ndarray) -> np.ndarray:
