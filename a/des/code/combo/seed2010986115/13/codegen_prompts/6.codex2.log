+def _extract_palette(grid: np.ndarray, bg: int) -> list[int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, int, list[int]]] = []
+    for row in (0, h - 1):
+        c = 0
+        while c < w:
