+
+    if side == "top":
+        r_values = [0]
+        c_values = range(0, ww - box_w + 1)
+    elif side == "bottom":
+        r_values = [hh - box_h]
+        c_values = range(0, ww - box_w + 1)
+    elif side == "left":
+        r_values = range(0, hh - box_h + 1)
+        c_values = [0]
+    else:
+        r_values = range(0, hh - box_h + 1)
+        c_values = [ww - box_w]
+
+    for r0 in r_values:
+        for c0 in c_values:
+            if _can_place(reserved, r0, c0, box_h, box_w):
