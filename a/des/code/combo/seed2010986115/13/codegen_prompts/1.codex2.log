+
+def _can_place(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    hh, ww = reserved.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not bool(reserved[rr0:rr1, cc0:cc1].any())
+
+
+def _reserve(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> None:
+    hh, ww = reserved.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    reserved[rr0:rr1, cc0:cc1] = True
+
+
+def _positions(
+    reserved: np.ndarray,
+    box_h: int,
+    box_w: int,
+    edge_margin: int,
+    side: str | None,
+) -> list[tuple[int, int]]:
+    hh, ww = reserved.shape
+    positions: list[tuple[int, int]] = []
+
+    if side is None:
+        r_start = edge_margin
+        r_stop = hh - box_h - edge_margin + 1
+        c_start = edge_margin
+        c_stop = ww - box_w - edge_margin + 1
