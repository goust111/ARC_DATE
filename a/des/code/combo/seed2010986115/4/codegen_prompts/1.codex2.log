+    frame_colors = set()
+    for r, c in hole_coords:
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and g[nr, nc] != BLACK:
+                frame_adjacent.append((nr, nc))
