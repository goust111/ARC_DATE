+def _make_sprite_patch(
+    mask: np.ndarray, color: int, rng: random.Random, side: str | None = None
+) -> np.ndarray:
+    h, w = mask.shape
+    if side is None:
+        patch = np.zeros((h, w), dtype=int)
+        patch[mask] = color
+        return patch
+
+    if side == "up":
+        patch = np.zeros((h + 1, w), dtype=int)
