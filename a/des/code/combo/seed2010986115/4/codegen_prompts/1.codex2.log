+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+SPRITE_COLORS = [1, 2, 3, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_ROT_CW = {"up": 0, "right": 1, "down": 2, "left": 3}
+
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 200
+PLACE_ATTEMPTS = 80
+
+
+def _rotate_cw(arr: np.ndarray, k: int) -> np.ndarray:
+    return np.rot90(arr, -(k % 4))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _component_from_seed(mask: np.ndarray, seed: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = seed
+    assert 0 <= sr < h and 0 <= sc < w and mask[sr, sc]
+    seen = {seed}
+    stack = [seed]
+    coords: list[tuple[int, int]] = []
+    while stack:
+        r, c = stack.pop()
+        coords.append((r, c))
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return coords
+
+
+def _touches_edge(coords: list[tuple[int, int]], h: int, w: int) -> bool:
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in coords)
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize_mask(coords: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        out[r - r0, c - c0] = True
+    return out
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    return mask[rows][:, cols]
+
+
+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    return tuple(tuple(int(v) for v in row) for row in mask.astype(int))
