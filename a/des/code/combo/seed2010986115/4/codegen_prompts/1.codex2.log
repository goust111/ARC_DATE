+def _side_from_marker(marker: tuple[int, int], sprite_coords: set[tuple[int, int]]) -> str | None:
+    r, c = marker
+    if (r + 1, c) in sprite_coords:
+        return "up"
+    if (r - 1, c) in sprite_coords:
+        return "down"
+    if (r, c + 1) in sprite_coords:
+        return "left"
+    if (r, c - 1) in sprite_coords:
+        return "right"
+    return None
+
