+    for rr, height in enumerate(row_heights):
+        for cc, width in enumerate(col_widths):
+            rid = rr * ncols + cc
+            rooms.append(
+                {
+                    "id": int(rid),
+                    "row": int(rr),
+                    "col": int(cc),
+                    "bbox": (
+                        int(row_lines[rr] + 1),
+                        int(col_lines[cc] + 1),
+                        int(row_lines[rr + 1] - 1),
+                        int(col_lines[cc + 1] - 1),
+                    ),
+                    "height": int(height),
+                    "width": int(width),
+                }
+            )
+    return grid, row_lines, col_lines, rooms
+
+
+def _room_id(rr: int, cc: int, ncols: int) -> int:
+    return int(rr * ncols + cc)
+
+
+def _candidate_moves(
+    row_heights: list[int], col_widths: list[int], row_lines: list[int], col_lines: list[int]
+) -> list[dict[str, object]]:
+    nrows = len(row_heights)
+    ncols = len(col_widths)
+    cands: list[dict[str, object]] = []
+
+    for rr in range(nrows):
+        for cc in range(ncols):
+            src = _room_id(rr, cc, ncols)
+            if rr + 1 < nrows:
+                dst = _room_id(rr + 1, cc, ncols)
+                wall_row = int(row_lines[rr + 1])
+                cands.append(
+                    {
+                        "source": int(src),
+                        "target": int(dst),
+                        "direction": (1, 0),
+                        "axis": "h",
+                        "wall_key": ("h", rr, cc),
+                        "fixed": int(wall_row),
+                        "span": (
+                            int(col_lines[cc] + 1),
+                            int(col_lines[cc + 1] - 1),
+                        ),
+                    }
+                )
+                cands.append(
+                    {
+                        "source": int(dst),
+                        "target": int(src),
+                        "direction": (-1, 0),
+                        "axis": "h",
+                        "wall_key": ("h", rr, cc),
+                        "fixed": int(wall_row),
+                        "span": (
+                            int(col_lines[cc] + 1),
+                            int(col_lines[cc + 1] - 1),
+                        ),
+                    }
+                )
+            if cc + 1 < ncols:
+                dst = _room_id(rr, cc + 1, ncols)
+                wall_col = int(col_lines[cc + 1])
+                cands.append(
+                    {
+                        "source": int(src),
+                        "target": int(dst),
+                        "direction": (0, 1),
+                        "axis": "v",
+                        "wall_key": ("v", rr, cc),
+                        "fixed": int(wall_col),
+                        "span": (
+                            int(row_lines[rr] + 1),
+                            int(row_lines[rr + 1] - 1),
+                        ),
+                    }
+                )
+                cands.append(
+                    {
+                        "source": int(dst),
+                        "target": int(src),
+                        "direction": (0, -1),
+                        "axis": "v",
+                        "wall_key": ("v", rr, cc),
+                        "fixed": int(wall_col),
+                        "span": (
