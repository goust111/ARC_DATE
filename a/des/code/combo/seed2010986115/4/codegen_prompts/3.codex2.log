+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in DIRS4:
+                    nr, nc = int(rr + dr), int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _translated_cells(
+    cells: list[tuple[int, int]],
+    direction: tuple[int, int],
+    target_bbox: tuple[int, int, int, int],
+) -> list[tuple[int, int]]:
+    sr0, sc0, sr1, sc1 = _bbox(cells)
+    tr0, tc0, tr1, tc1 = target_bbox
+    dr, dc = direction
+    if dr == -1:
+        shift_r, shift_c = int(tr0 - sr0), 0
+    elif dr == 1:
+        shift_r, shift_c = int(tr1 - sr1), 0
+    elif dc == -1:
+        shift_r, shift_c = 0, int(tc0 - sc0)
+    else:
+        shift_r, shift_c = 0, int(tc1 - sc1)
+    return [(int(r + shift_r), int(c + shift_c)) for r, c in cells]
+
