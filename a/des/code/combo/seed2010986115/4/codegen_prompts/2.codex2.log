    for h, w in dims:
        short, long = min(h, w), max(h, w)
        assert long <= out_h
        out[:short, c : c + long] = fg
        c += long + 1

    c = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        assert long <= out_h
        out[out_h - long : out_h, c : c + short] = fg
        c += short + 1

    return out

