+    h = random.randint(20, 30)
+    w = random.randint(24, 34)
+    lane_rows = list(range(2, h - 2, 3))
+    max_paths = min(len(PATH_COLORS), len(lane_rows) - 1, 5)
+    if max_paths < 3:
