+def _u_relative_cells(height: int, width: int, opening: str) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    if opening == "up":
+        for r in range(height):
+            cells.add((r, 0))
+            cells.add((r, width - 1))
+        for c in range(width):
+            cells.add((height - 1, c))
+        return cells
+    if opening == "down":
+        for r in range(height):
+            cells.add((r, 0))
+            cells.add((r, width - 1))
+        for c in range(width):
+            cells.add((0, c))
+        return cells
+    if opening == "left":
+        for c in range(width):
