+
+
+def _boxes_intersect(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _expanded(box: tuple[int, int, int, int], pad: int) -> tuple[int, int, int, int]:
