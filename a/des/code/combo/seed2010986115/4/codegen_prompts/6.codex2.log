+        for r in range(height):
+            cells.add((r, width - 1))
+        return cells
+    if opening == "right":
+        for c in range(width):
+            cells.add((0, c))
+            cells.add((height - 1, c))
+        for r in range(height):
+            cells.add((r, 0))
+        return cells
+    raise ValueError(opening)
