+        if poured & all_prev_bbox_cells:
+            allowed = set()
+            if require_overlap:
+                allowed = all_prev_visible
+            if (poured & all_prev_bbox_cells) - allowed:
+                continue
+
+        if not require_overlap:
+            if poured & all_prev_visible:
