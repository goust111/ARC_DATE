+def _grow_tree_cells(endpoint: tuple[int, int], direction: tuple[int, int], turns: int) -> set[tuple[int, int]]:
+    trunk = _add(endpoint, direction)
+    cells = {trunk}
+    if turns == 0:
+        return cells
