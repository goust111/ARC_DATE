+            nbr
+            for nbr in _neighbors4(current)
+            if _in_bounds(shape, nbr) and int(grid[nbr]) != BG and nbr != previous
+        ]
+        assert len(next_neighbors) <= 1, "path must be a simple polyline"
+        if not next_neighbors:
+            return {
+                "color": path_color,
+                "turns": turns,
+                "endpoint": current,
+                "final_dir": direction,
+            }
