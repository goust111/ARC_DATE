def build_d(main=True):
    for _ in range(200):
        s=random.choice([9,11,13])
        a=random.randint(2,(s-3)//2)
        rights=s-1-a; downs=a
        ok=False
        for _ in range(100):
            steps=['R']*rights+['D']*downs
            random.shuffle(steps)
            r,c=0,a
            path=[(r,c)]
            valid=True
            for st in steps:
                if st=='R': c+=1
                else: r+=1
                if c-r<1 or c>=s or r>=s:
                    valid=False; break
                path.append((r,c))
            if valid and (r,c)==(a,s-1):
                ok=True; break
        if not ok: continue
        cells=set(path)
        cells|={(c,r) for r,c in list(cells)}
        for x in range(a+1):
            cells.add((0,x)); cells.add((x,0))
        for x in range(a,s):
            cells.add((s-1,x)); cells.add((x,s-1))
        for i in range(s): cells.add((i,i))
        mask=np.zeros((s,s),bool)
        for r,c in cells: mask[r,c]=1
        if not main:
            mask=np.fliplr(mask)
        ax=detect(mask)
        want='d1' if main else 'd2'
        if len(ax)"'!=1 or ax[0][0]!=want:
