        mask[:, gap_col] = False
        return mask

    def horizontal_gap() -> np.ndarray:
        gap_row = random.randint(1, height - 2)
        mask = np.ones((height, width), dtype=bool)
        mask[gap_row, :] = False
        return mask

    def cross_gap() -> np.ndarray:
        gap_row = random.randint(1, height - 2)
        gap_col = random.randint(1, width - 2)
        mask = np.ones((height, width), dtype=bool)
        mask[gap_row, :] = False
        mask[:, gap_col] = False
        return mask

    def t_gap(split_top: bool) -> np.ndarray:
        gap_row = random.randint(1, height - 2)
