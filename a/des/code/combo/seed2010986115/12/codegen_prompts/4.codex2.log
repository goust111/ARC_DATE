+    if all((r0 + r1 - r, c) in pts for r, c in pts):
+        axes.append(("h", r0 + r1))
+    if all((r, c0 + c1 - c) in pts for r, c in pts):
+        axes.append(("v", c0 + c1))
+    if r1 - r0 == c1 - c0:
