def bbox(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    return min(rs),min(cs),max(rs),max(cs)

def reflect(pt, axis, box):
    r,c=pt
    r0,c0,r1,c1=box
    kind,val=axis
    if kind=='h': return (val-r,c)
    if kind=='v': return (r,val-c)
    if kind=='d1': return (c+val,r-val)
    return (val-c,val-r)

def detect(mask):
