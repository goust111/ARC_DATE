+def _detect_axis(coords: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[str, int]:
+    pts = set(coords)
+    r0, c0, r1, c1 = _bbox(pts)
+    axes: list[tuple[str, int]] = []
