    for r in range(rows[0], h-rows[0]):
        cells.add((r,0)); cells.add((r,w-1))
    return cells

def comps(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
