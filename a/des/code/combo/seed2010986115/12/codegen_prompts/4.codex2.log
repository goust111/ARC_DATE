    random.seed(seed)
    axis=h//2
    max_top=axis-1
    rows=[random.randint(1,max_top)]
    for _ in range(w-1):
        opts=[nr for nr in (rows[-1]-1,rows[-1],rows[-1]+1) if 1<=nr<=max_top]
        rows.append(random.choice(opts))
