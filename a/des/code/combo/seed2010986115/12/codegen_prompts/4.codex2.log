        pairs=pair_components(mask)
        if pairs:
            return mask,pairs
    return None,None

def pair_components(mask):
    H,W=mask.shape
    ax=detect(mask)[0]
    box=(0,0,H-1,W-1)
    bounded=[]
    for cc in components(~mask):
        if any(r in (0,H-1) or c in (0,W-1) for r,c in cc):
            continue
        bounded.append(set(cc))
    lookup={frozenset(cc):i for i,cc in enumerate(bounded)}
    pairs=[]; used=set()
    for i,cc in enumerate(bounded):
        if i in used: continue
        refl=frozenset(reflect(pt,ax,box) for pt in cc)
        j=lookup.get(refl)
        if j is None or j==i: continue
        used.add(i); used.add(j); pairs.append((i,j,bounded))
    out=[]
    for i,j,_ in pairs:
        out.append((bounded[i], bounded[j]))
    return out

for name,builder in [('"'h',build_h),('d1',lambda: build_d(True)),('d2',lambda: build_d(False))]:
