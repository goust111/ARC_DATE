+        if len(corridor) < MIN_CORRIDOR_LEN:
+            return False
+        if len(_ray_cells(frame_grid, frame["gap"], DIR_TO_VEC[frame["direction"]])) != len(corridor):
+            return False
+        if seen.intersection(corridor):
+            return False
+        seen.update(corridor)
+    return True
+
