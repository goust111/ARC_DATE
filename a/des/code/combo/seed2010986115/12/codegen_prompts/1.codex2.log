+def _expected_from_specs(grid: np.ndarray, frames: list[dict], keys: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    marker_by_index = {key["index"]: key["marker_color"] for key in keys}
+    for frame in frames:
