+
+def _ray_cells(grid: np.ndarray, start: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    r, c = start
+    dr, dc = step
+    cells = []
+    while 0 <= r < h and 0 <= c < w and int(grid[r, c]) == BG:
+        cells.append((r, c))
+        r += dr
+        c += dc
