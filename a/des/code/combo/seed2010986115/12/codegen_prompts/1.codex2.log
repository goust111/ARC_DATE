+        return mask
+    return None
+
+
+def _sample_unique_shapes(rng: random.Random, count: int) -> list[np.ndarray] | None:
+    shapes = []
+    seen = set()
+    while len(shapes) < count:
+        shape = _random_shape(rng)
+        if shape is None:
+            return None
+        sig = _canonical_shape(shape)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        shapes.append(shape)
+    return shapes
