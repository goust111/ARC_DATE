+
+def _shape_signature(mask: np.ndarray) -> tuple[int, int, tuple[int, ...]]:
+    arr = np.asarray(mask, dtype=bool)
+    return (
+        int(arr.shape[0]),
+        int(arr.shape[1]),
+        tuple(int(v) for v in arr.astype(np.uint8).ravel()),
