+def _line_to_edge(shape: tuple[int, int], start: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = start
+    dr, dc = step
+    cells = []
+    while 0 <= r < h and 0 <= c < w:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
