+    for frame in frames:
+        color = int(marker_by_index[frame["index"]])
+        for r, c in _ray_cells(grid, frame["gap"], DIR_TO_VEC[frame["direction"]]):
+            out[r, c] = color
+    return out
+
+
+def _validate_corridors(frame_grid: np.ndarray, frames: list[dict]) -> bool:
