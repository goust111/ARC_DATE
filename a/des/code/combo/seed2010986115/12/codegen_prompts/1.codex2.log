+                    hit_indices = [corridor_index[cell] for cell in cells if cell in corridor_index]
+                    if not hit_indices or min(hit_indices) < MIN_CORRIDOR_LEN:
+                        continue
+                    for r, c in cells:
+                        grid[r, c] = patch[r - top, c - left]
+                    _mark_cells(occupied, buffered, cells)
