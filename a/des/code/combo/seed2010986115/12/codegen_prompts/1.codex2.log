+                rng.shuffle(rel_coords)
+                for pr, pc in rel_coords:
+                    top = target[0] - pr
+                    left = target[1] - pc
+                    cells = _patch_cells(patch, top, left)
+                    if not _can_place_cells(cells, buffered, other_forbidden, own_set):
