+BG = 0
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_NAMES = tuple(DIR_TO_VEC)
