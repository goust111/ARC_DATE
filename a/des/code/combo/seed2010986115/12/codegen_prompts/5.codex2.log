+        lengths = [random.randint(*GEN_CHAIN_LEN_RANGE) for _ in range(chain_count)]
+        total = sum(lengths)
+        if not (GEN_TOTAL_ARROWS_RANGE[0] <= total <= GEN_TOTAL_ARROWS_RANGE[1]):
