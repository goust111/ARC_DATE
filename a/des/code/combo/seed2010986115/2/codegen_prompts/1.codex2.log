+GRID_MIN = 18
+GRID_MAX = 30
+FRAME_COUNT_CHOICES = (1, 2, 3)
+FRAME_SIZE_MIN = 4
+FRAME_SIZE_MAX = 8
+GEN_RETRIES = 400
