+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int = 0) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(g[r0, c0])
+            if color == bg or seen[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            rmin = int(arr[:, 0].min())
+            rmax = int(arr[:, 0].max())
+            cmin = int(arr[:, 1].min())
+            cmax = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (rmin, cmin, rmax, cmax),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _u_template(height: int, width: int, missing: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if missing == "top":
+        mask[1:, 0] = True
+        mask[1:, -1] = True
+        mask[-1, :] = True
+    elif missing == "bottom":
+        mask[:-1, 0] = True
+        mask[:-1, -1] = True
+        mask[0, :] = True
+    elif missing == "left":
+        mask[:, -1] = True
+        mask[0, 1:] = True
+        mask[-1, 1:] = True
+    elif missing == "right":
+        mask[:, 0] = True
+        mask[0, :-1] = True
+        mask[-1, :-1] = True
+    else:
+        raise ValueError(missing)
+    return mask
