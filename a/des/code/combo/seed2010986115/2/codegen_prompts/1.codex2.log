+    placed = _place_patches(rng, (grid_h, grid_w), patches)
+    if placed is None:
+        return None
+    inp, expected = placed
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
