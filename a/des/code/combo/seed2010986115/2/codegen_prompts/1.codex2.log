+def _u_template(height: int, width: int, missing: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if missing == "top":
+        mask[1:, 0] = True
+        mask[1:, -1] = True
+        mask[-1, :] = True
+    elif missing == "bottom":
+        mask[:-1, 0] = True
+        mask[:-1, -1] = True
+        mask[0, :] = True
+    elif missing == "left":
+        mask[:, -1] = True
+        mask[0, 1:] = True
+        mask[-1, 1:] = True
+    elif missing == "right":
