+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+SIDES = ("top", "bottom", "left", "right")
+OPPOSITE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int = 0) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(g[r0, c0])
+            if color == bg or seen[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            rmin = int(arr[:, 0].min())
+            rmax = int(arr[:, 0].max())
+            cmin = int(arr[:, 1].min())
+            cmax = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (rmin, cmin, rmax, cmax),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _u_template(height: int, width: int, missing: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if missing == "top":
+        mask[1:, 0] = True
+        mask[1:, -1] = True
+        mask[-1, :] = True
+    elif missing == "bottom":
+        mask[:-1, 0] = True
+        mask[:-1, -1] = True
+        mask[0, :] = True
+    elif missing == "left":
+        mask[:, -1] = True
+        mask[0, 1:] = True
+        mask[-1, 1:] = True
+    elif missing == "right":
+        mask[:, 0] = True
+        mask[0, :-1] = True
+        mask[-1, :-1] = True
+    else:
+        raise ValueError(missing)
+    return mask
+
+
+def _match_frame(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height < 3 or width < 3:
+        return None
+
+    mask = np.zeros((height, width), dtype=bool)
+    coords = comp["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    for missing in SIDES:
+        templ = _u_template(height, width, missing)
+        if np.array_equal(mask, templ):
+            return {
+                "color": int(comp["color"]),
+                "bbox": (r0, c0, r1, c1),
+                "missing": missing,
+            }
+    return None
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _find_components(grid, bg=0):
+        frame = _match_frame(comp)
+        if frame is not None:
+            frames.append(frame)
+    frames.sort(key=lambda item: item["bbox"])
+    return frames
+
+
+def _find_blocks(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    blocks: list[dict] = []
+    for comp in _find_components(g, bg=0):
+        r0, c0, r1, c1 = comp["bbox"]
+        if (r1 - r0 + 1, c1 - c0 + 1) != (2, 2):
+            continue
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all(patch == int(comp["color"])):
+            continue
+        blocks.append({"color": int(comp["color"]), "bbox": (r0, c0, r1, c1)})
+    return blocks
+
+
+def _block_touches_side(grid: np.ndarray, frame: dict, block: dict, side: str) -> bool:
+    g = np.asarray(grid, dtype=int)
+    fr0, fc0, fr1, fc1 = frame["bbox"]
+    br0, bc0, br1, bc1 = block["bbox"]
+    frame_color = int(frame["color"])
+
+    if side == "top":
+        return (
+            br1 == fr0 - 1
+            and bc0 >= fc0
+            and bc1 <= fc1
+            and np.all(g[fr0, bc0 : bc1 + 1] == frame_color)
+        )
+    if side == "bottom":
+        return (
+            br0 == fr1 + 1
+            and bc0 >= fc0
+            and bc1 <= fc1
+            and np.all(g[fr1, bc0 : bc1 + 1] == frame_color)
+        )
+    if side == "left":
+        return (
+            bc1 == fc0 - 1
+            and br0 >= fr0
+            and br1 <= fr1
+            and np.all(g[br0 : br1 + 1, fc0] == frame_color)
+        )
+    if side == "right":
+        return (
+            bc0 == fc1 + 1
+            and br0 >= fr0
+            and br1 <= fr1
+            and np.all(g[br0 : br1 + 1, fc1] == frame_color)
+        )
+    raise ValueError(side)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill each U-frame's interior with the color of the 2x2 block on the side opposite its opening.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
