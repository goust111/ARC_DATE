+def _candidate_block_positions(patch: np.ndarray, frame_bbox: tuple[int, int, int, int], side: str) -> list[tuple[int, int]]:
+    frame_top, frame_left, frame_bottom, frame_right = frame_bbox
+    positions: list[tuple[int, int]] = []
