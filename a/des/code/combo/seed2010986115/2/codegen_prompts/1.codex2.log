+        r0, c0 = rng.choice(candidates)
+        inp[r0 : r0 + ph, c0 : c0 + pw] = in_patch
+        out[r0 : r0 + ph, c0 : c0 + pw] = out_patch
+        used[r0 : r0 + ph, c0 : c0 + pw] = True
+
+    return inp, out
