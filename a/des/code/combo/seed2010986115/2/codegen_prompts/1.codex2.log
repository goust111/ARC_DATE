+            arr = np.array(coords, dtype=int)
+            rmin = int(arr[:, 0].min())
+            rmax = int(arr[:, 0].max())
+            cmin = int(arr[:, 1].min())
+            cmax = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (rmin, cmin, rmax, cmax),
