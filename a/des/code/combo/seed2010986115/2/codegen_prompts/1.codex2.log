+    if side == "top":
+        return (
+            br1 == fr0 - 1
+            and bc0 >= fc0
+            and bc1 <= fc1
+            and np.all(g[fr0, bc0 : bc1 + 1] == frame_color)
+        )
+    if side == "bottom":
+        return (
+            br0 == fr1 + 1
+            and bc0 >= fc0
+            and bc1 <= fc1
+            and np.all(g[fr1, bc0 : bc1 + 1] == frame_color)
+        )
+    if side == "left":
+        return (
+            bc1 == fc0 - 1
+            and br0 >= fr0
+            and br1 <= fr1
+            and np.all(g[br0 : br1 + 1, fc0] == frame_color)
+        )
+    if side == "right":
+        return (
+            bc0 == fc1 + 1
+            and br0 >= fr0
+            and br1 <= fr1
+            and np.all(g[br0 : br1 + 1, fc1] == frame_color)
+        )
+    raise ValueError(side)
