+    gap = (top + gr, left + gc)
+    grid[gap] = color
+    return {"bbox": (top, left, bottom, right), "gap": gap, "color": int(color)}
+
+
+def _place_shape(grid: np.ndarray, reserved: np.ndarray, mask: np.ndarray, color: int, rng: random.Random) -> np.ndarray | None:
