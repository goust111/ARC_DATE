+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
