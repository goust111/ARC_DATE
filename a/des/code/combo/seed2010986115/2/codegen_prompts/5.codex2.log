+    return {
+        "color": int(color),
+        "small_patch": small_patch,
+        "small_mask": small_mask,
+        "large_patch": large_patch,
+        "filled_large_patch": filled_large_patch,
+        "hole_bbox": (hole_r, hole_c, hole_r + h - 1, hole_c + w - 1),
+    }
