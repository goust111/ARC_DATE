+
+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_components(mask)) == 1
+
+
+def _touches_crop_border(coords: list[tuple[int, int]], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in coords)
