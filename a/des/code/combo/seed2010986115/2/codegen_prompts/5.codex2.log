+def _mask_from_coords(
+    coords: list[tuple[int, int]],
+    box: tuple[int, int, int, int] | None = None,
+) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    if box is None:
+        box = _bbox(coords)
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, box
