    counts = _bounded_counts(h * w)
    colors = COLOR_PALETTE[:]
    random.shuffle(colors)
    image = np.empty((h, w), dtype=int)
    path = _cell_path(h, w)
    idx = 0
    for color, count in zip(colors, counts):
        for r, c in path[idx : idx + count]:
            image[r, c] = color
        idx += count
    return image


