+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+REGION_COUNT_CHOICES = (1, 2, 3, 4)
