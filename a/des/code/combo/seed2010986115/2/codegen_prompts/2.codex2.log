+
+def _make_seed(rng: random.Random, seed_h: int, seed_w: int) -> np.ndarray:
+    n_colors = rng.randint(1, min(3, seed_h * seed_w, len(PALETTE)))
+    colors = rng.sample(PALETTE, n_colors)
