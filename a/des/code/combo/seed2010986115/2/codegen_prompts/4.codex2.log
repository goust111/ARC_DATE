+# --------------- generator ---------------
+
+GRID_WIDTH_RANGE = (18, 30)
+SEPARATOR_ROW_RANGE = (7, 11)
+SEGMENT_COUNT_RANGE = (2, 4)
+SEGMENT_MIN_WIDTH = 4
+OBJECT_COUNT_RANGE = (2, 5)
+SHAPE_HEIGHT_RANGE = (2, 5)
