+            mirrored[:, 0] = 2 * sep_row - mirrored[:, 0]
+            assert np.all((0 <= mirrored[:, 0]) & (mirrored[:, 0] < g.shape[0]))
+            out[mirrored[:, 0], mirrored[:, 1]] = target_color
+
+    return out
