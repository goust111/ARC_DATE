+    prev = path[idx - 1]
+    cur = path[idx]
+    nxt = path[idx + 1]
+    if prev[0] == cur[0] == nxt[0]:
+        return "h"
+    if prev[1] == cur[1] == nxt[1]:
+        return "v"
+    return None
