+
+
+def _track_degrees(all_track_cells: set[Cell], shape: tuple[int, int]) -> dict[Cell, int]:
+    return {
+        cell: sum(1 for nbr in _neighbors(cell, shape) if nbr in all_track_cells)
+        for cell in all_track_cells
+    }
+
