+
+def _orientation(path: list[Cell], idx: int) -> str | None:
+    if len(path) < 2:
+        return None
+    if idx == 0:
+        a = path[0]
+        b = path[1]
+        return "h" if a[0] == b[0] else "v"
+    if idx == len(path) - 1:
+        a = path[-2]
+        b = path[-1]
+        return "h" if a[0] == b[0] else "v"
