+            shared = set(track_i["path"]) & set(track_j["path"])
+            for cell in shared:
+                idx_i = track_i["path_index"][cell]
+                idx_j = track_j["path_index"][cell]
+                need_i = len(track_i["path"]) - idx_i
+                need_j = len(track_j["path"]) - idx_j
