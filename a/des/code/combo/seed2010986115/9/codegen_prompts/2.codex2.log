+        track["candidate_sites"] = _candidate_fragment_sites(base, track["path"], all_track_cells, endpoint_cells)
+        track["max_count"] = min(len(track["path"]), len(track["candidate_sites"]), GEN_MAX_FRAGMENTS)
+        if track["max_count"] < 1:
