+def _candidate_fragment_sites(base: np.ndarray, path: list[Cell], all_track_cells: set[Cell], endpoint_cells: set[Cell]) -> dict[int, list[Cell]]:
+    h, w = base.shape
+    degrees = _track_degrees(all_track_cells, base.shape)
