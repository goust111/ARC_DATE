+
+def _choose_fragment_positions(track: dict, existing: list[Cell]) -> list[Cell] | None:
+    count = int(track["count"])
+    path = track["path"]
+    sites = track["candidate_sites"]
+    preferred = [idx for idx in sites if idx < len(path) - count]
