+def _spaced_positions(n: int, lo: int, hi: int, min_gap: int) -> list[int] | None:
+    span = hi - lo + 1
+    need = n + (n - 1) * min_gap
+    if need > span:
+        return None
+    picks = sorted(random.sample(range(span - (n - 1) * min_gap), n))
+    return [lo + picks[i] + i * min_gap for i in range(n)]
