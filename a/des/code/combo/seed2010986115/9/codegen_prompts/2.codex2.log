+
+    expected = _render_expected(base, tracks)
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if not np.any(inp != expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
