+            c1 = min(grid_w, left + fw + 1)
+            if occupied[r0:r1, c0:c1].any():
+                continue
+            occupied[r0:r1, c0:c1] = True
+            positions[idx] = (top, left)
+            placed = True
+            break
+        if not placed:
+            return None
+    return [pos for pos in positions if pos is not None]
