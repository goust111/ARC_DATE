+        if np.array_equal(rotated, opposite):
+            continue
+        if np.array_equal(rotated, inside):
+            continue
+        if np.count_nonzero(rotated == ANIMAL_COLOR) == 0:
+            continue
+        if np.count_nonzero(rotated == FEED_COLOR) == 0:
+            continue
+        return inside
+    return None
