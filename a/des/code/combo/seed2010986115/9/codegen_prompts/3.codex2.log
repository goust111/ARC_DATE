+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_groups = rng.choice(GROUP_COUNT_CHOICES)
+    grid_h = rng.randint(GRID_H_RANGE[0], GRID_H_RANGE[1])
