+def _collect_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for coords in _components(grid == color):
+            if _is_hollow_frame(coords):
+                frames.append(
