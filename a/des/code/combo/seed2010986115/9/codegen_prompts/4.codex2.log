+def _line_axis(coords: list[tuple[int, int]]) -> tuple[str, int] | None:
+    if not (3 <= len(coords) <= 5):
+        return None
+    rows = sorted(r for r, _ in coords)
+    cols = sorted(c for _, c in coords)
