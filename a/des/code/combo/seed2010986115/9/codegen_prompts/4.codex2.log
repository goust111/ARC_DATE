+def _component_mask(coords: list[tuple[int, int]]) -> tuple[np.ndarray, int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, r0, c0
+
