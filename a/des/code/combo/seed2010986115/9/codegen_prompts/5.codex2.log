from __future__ import annotations

import random

import numpy as np


BLACK = 0
GREY = 5
MAROON = 9

DIRS4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
DIRS8 = DIRS4 + [(1, 1), (1, -1), (-1, 1), (-1, -1)]
DIRECTION_ORDER = ("up", "down", "left", "right")
ARROW_PATTERNS = {
    "up": {(0, 1), (1, 0), (1, 2)},
    "down": {(2, 1), (1, 0), (1, 2)},
    "left": {(1, 0), (0, 1), (2, 1)},
    "right": {(1, 2), (0, 1), (2, 1)},
}
ENTRY_H = 3
ENTRY_W = 6
ENTRY_GAP = 1


def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    steps = DIRS4 if connectivity == 4 else DIRS8
    out: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while stack:
                cr, cc = stack.pop()
                comp.append((cr, cc))
                for dr, dc in steps:
                    nr = cr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            out.append(comp)
    return out


def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rs = [r for r, _ in points]
    cs = [c for _, c in points]
    return min(rs), min(cs), max(rs), max(cs)


def _frame_components(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
    frames: list[tuple[int, int, int, int]] = []
    for comp in _components(grid == MAROON, connectivity=4):
        r0, c0, r1, c1 = _bbox(comp)
        side_h = r1 - r0 + 1
        side_w = c1 - c0 + 1
        if side_h != side_w or not (5 <= side_h <= 7):
            continue
        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
        border = np.zeros_like(patch, dtype=bool)
        border[0, :] = True
        border[-1, :] = True
        border[:, 0] = True
        border[:, -1] = True
        if int(border.sum()) != len(comp):
            continue
        if not np.all(patch[border] == MAROON):
            continue
        if np.any(patch[1:-1, 1:-1] == MAROON):
            continue
        frames.append((r0, c0, r1, c1))
    assert frames, "expected at least one maroon frame"
    return frames


