+def _read_arrow(zone: np.ndarray) -> str | None:
+    if zone.shape != (3, 3):
+        return None
+    grey_pts = {(int(r), int(c)) for r, c in np.argwhere(zone == GREY)}
+    if len(grey_pts) != 3:
+        return None
+    if np.any((zone != BLACK) & (zone != GREY)):
+        return None
+    for direction, pattern in ARROW_PATTERNS.items():
