+    frame_count = random.randint(2, 4)
+    placed: list[tuple[int, int, int, int]] = [legend_box]
+    other_colors = [1, 2, 3, 4, 6, 7, 8]
+
+    if legend_box[0] == 0:
+        min_r = legend_box[2] + 2
+        min_c = 1
+    else:
+        min_r = 1
+        min_c = legend_box[3] + 2
+
+    for _ in range(frame_count):
