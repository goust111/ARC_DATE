+def _gate_colors_on_path(grid: np.ndarray, path: list[tuple[int, int]]) -> frozenset[int]:
+    h, w = grid.shape
+    colors: set[int] = set()
+    for r, c in path:
+        if 0 < r < h - 1:
+            up = int(grid[r - 1, c])
+            down = int(grid[r + 1, c])
+            if up == down and up in GATE_COLORS:
+                colors.add(up)
+        if 0 < c < w - 1:
+            left = int(grid[r, c - 1])
+            right = int(grid[r, c + 1])
+            if left == right and left in GATE_COLORS:
+                colors.add(left)
+    return frozenset(colors)
