+def _trace_path_from_station(
+    grid: np.ndarray,
+    center: tuple[int, int],
+    all_station_cells: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    h, w = grid.shape
+    station = set(_station_cells(center))
