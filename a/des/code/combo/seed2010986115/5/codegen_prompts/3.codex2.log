+def _find_station_centers(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    centers: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != GREY:
+                continue
+            if bool((grid[r - 1 : r + 2, c - 1 : c + 2] == GREY).all()):
+                centers.append((r, c))
+    return centers
+
