+def _in_bounds(h: int, w: int, r: int, c: int) -> bool:
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIR4:
+        rr = r + dr
+        cc = c + dc
+        if _in_bounds(h, w, rr, cc):
+            out.append((rr, cc))
+    return out
