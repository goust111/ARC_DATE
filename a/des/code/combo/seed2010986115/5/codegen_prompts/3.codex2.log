+    attachment_map: dict[tuple[int, int], tuple[int, int]] = {}
+    for sr, sc in station:
+        for rr, cc in _neighbors4(h, w, sr, sc):
+            if (rr, cc) in station:
+                continue
+            if int(grid[rr, cc]) != GREY:
+                continue
+            attachment_map[(rr, cc)] = (sr, sc)
