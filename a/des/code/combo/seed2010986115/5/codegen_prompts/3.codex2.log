+
+GATE_COLORS = {BLUE, RED, YELLOW}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+
+MIX_MAP = {
+    frozenset([RED]): RED,
+    frozenset([BLUE]): BLUE,
+    frozenset([YELLOW]): YELLOW,
+    frozenset([RED, BLUE]): MAGENTA,
+    frozenset([RED, YELLOW]): ORANGE,
