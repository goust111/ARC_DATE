+GRID_MIN = 18
+GRID_MAX = 30
+PIECE_COUNT_MIN = 2
+PIECE_COUNT_MAX = 4
+SHAPE_MIN_AREA = 4
+SHAPE_MAX_AREA = 8
+SHAPE_CANVAS_MIN = 3
+SHAPE_CANVAS_MAX = 5
+INNER_PAD_MIN = 1
+INNER_PAD_MAX = 2
