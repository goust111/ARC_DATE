import random, numpy as np

BG=0
CROSS=8
POOL=[1,2,3,4,5,6,7,9]
QUADS=['TL','TR','BL','BR']

def rand_shape():
    area=random.randint(2,5)
    cells={(0,0)}
    while len(cells)<area:
        r,c=random.choice(list(cells))
        dr,dc=random.choice([(1,0),(-1,0),(0,1),(0,-1)])
        cells.add((r+dr,c+dc))
    rs=[r for r,_ in cells]; cs=[c for _,c in cells]
    r0=min(rs); c0=min(cs)
    cells={(r-r0,c-c0) for r,c in cells}
    rs=[r for r,_ in cells]; cs=[c for _,c in cells]
    h=max(rs)+1; w=max(cs)+1
    if h>4 or w>4:
        return rand_shape()
    return cells,h,w

def place_region(H,W,q):
    cr,cc=H//2,W//2
    if q=='TL': return range(0,cr), range(0,cc)
    if q=='TR': return range(0,cr), range(cc+1,W)
    if q=='BL': return range(cr+1,H), range(0,cc)
    return range(cr+1,H), range(cc+1,W)

def corner_colors(c1,c2,main_diag_a=True):
    if main_diag_a:
        return {'tl':c1,'br':c1,'tr':c2,'bl':c2}
    return {'tl':c2,'br':c2,'tr':c1,'bl':c1}

# scheme S1
HSTEP={'TL':'tl','TR':'tr','BL':'bl','BR':'br'}
VSTEP={'TL':'bl','TR':'br','BL':'tl','BR':'tr'}

def apply_op(coords, op, cr, cc, stage):
    out=[]
    if op=='M':
        if stage=='H':
            out=[(2*cr-r,c) for r,c in coords]
        else:
            out=[(r,2*cc-c) for r,c in coords]
    else:
        out=[(2*cr-r,2*cc-c) for r,c in coords]
    return out

def transform(coords,q,assign,corners,H,W):
    cr,cc=H//2,W//2
    t1=assign[corners[HSTEP[q]]]
    t2=assign[corners[VSTEP[q]]]
    coords=apply_op(coords,t1,cr,cc,'H')
    coords=apply_op(coords,t2,cr,cc,'V')
    return tuple(sorted(coords))

def quadrant_of(coords,H,W):
    cr,cc=H//2,W//2
    r,c=coords[0]
    return ('T' if r<cr else 'B')+('L' if c<cc else 'R')

def render(H,W,corners,objs):
    g=np.zeros((H,W),dtype=int)
    cr,cc=H//2,W//2
    g[cr,:]=CROSS; g[:,cc]=CROSS
    g[:2,:2]=corners['tl']; g[:2,-2:]=corners['tr']; g[-2:,:2]=corners['bl']; g[-2:,-2:]=corners['br']
    for color,coords in objs:
        for r,c in coords: g[r,c]=color
    return g

def out_for(g,corners,objs,assign):
    out=g.copy(); H,W=g.shape
    order=['TL','TR','BL','BR']
    for q in order:
        for color,coords in objs:
            if quadrant_of(coords,H,W)"'!=q: continue
            for r,c in transform(coords,q,assign,corners,H,W):
                out[r,c]=color
    return out

def score(inp,out):
    return int(np.sum(inp!=out))

def gen_once():
    H=W=random.choice([13,15])
    c1,c2=random.sample(POOL,2)
    corners=corner_colors(c1,c2,random.choice([True,False]))
    truth={c1:'"'M',c2:'R'} if random.choice([True,False]) else {c1:'R',c2:'M'}
    colors=[c for c in POOL if c not in {c1,c2}]
    objs=[]; occ=set()
    qs=random.sample(QUADS, random.randint(2,4))
    for q in qs:
        for _ in range(1 if random.random()<0.7 else 2):
            shape,h,w=rand_shape()
            rr,cc=place_region(H,W,q)
            rmin,rmax=min(rr),max(rr); cmin,cmax=min(cc),max(cc)
            for _ in range(40):
                r0=random.randint(rmin, rmax-h+1)
                c0=random.randint(cmin, cmax-w+1)
                coords={(r0+r,c0+c) for r,c in shape}
                if any((r,c) in occ for r,c in coords):
                    continue
                # avoid corners 2x2 only
                good=True
                for r,c in coords:
                    if r==H//2 or c==W//2: good=False
                    if (r<2 and c<2) or (r<2 and c>=W-2) or (r>=H-2 and c<2) or (r>=H-2 and c>=W-2): good=False
                if not good: continue
                occ|=coords
                objs.append((random.choice(colors), tuple(sorted(coords))))
                break
    if len(objs)<2: return None
    inp=render(H,W,corners,objs)
    cands=[]
    for assign in ({c1:'M',c2:'R'},{c1:'R',c2:'M'}):
        out=out_for(inp,corners,objs,assign)
        cands.append((assign,score(inp,out)))
    ts=score(inp,out_for(inp,corners,objs,truth))
    fs=[s for a,s in cands if a"'!=truth][0]
    return ts,fs

wins=ties=loss=0
samples=[]
for _ in range(1000):
    x=gen_once()
    if x is None: continue
    t,f=x
    if t>f: wins+=1; samples.append((t,f))
    elif t==f: ties+=1
    else: loss+=1
print('"'wins ties loss', wins, ties, loss)
print('sample', samples[:20])
