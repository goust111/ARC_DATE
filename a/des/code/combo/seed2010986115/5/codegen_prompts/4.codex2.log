        if pts.size == 0:
            return None
        if side == "top":
            rr = int(pts[:, 0].min())
            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])
            return ("h", int(rr), cols)
        if side == "bot":
            rr = int(pts[:, 0].max())
            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])
            return ("h", int(rr), cols)
        if side == "left":
            cc = int(pts[:, 1].min())
            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])
