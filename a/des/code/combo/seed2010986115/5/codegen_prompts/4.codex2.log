+    truth_out, truth_score = _simulate_with_mapping(
+        grid,
+        detected,
+        parsed_corners,
+        protected,
+        center_r,
+        center_c,
+        truth_actions,
+    )
+    false_out, false_score = _simulate_with_mapping(
+        grid,
+        detected,
+        parsed_corners,
+        protected,
+        center_r,
+        center_c,
+        false_actions,
+    )
+    if truth_score <= false_score:
+        return None
+    if truth_score[0] < 4:
+        return None
+    if np.array_equal(truth_out, false_out):
+        return None
+    if not np.array_equal(main(grid), truth_out):
