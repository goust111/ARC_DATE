+def _interior_black_components(area: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = area.shape
+    black = area == BLACK
+    seen = np.zeros_like(black, dtype=bool)
+    rooms: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not black[r, c] or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_border = False
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and black[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            if not touches_border:
