+        cols = np.flatnonzero(grid[r, :] != BLACK)
+        if cols.size == 0:
+            continue
+        if cols.size == 5 and np.all(cols == np.arange(cols[0], cols[0] + 5)):
+            colors = [int(grid[r, c]) for c in cols]
+            assert len(set(colors)) == 5, "legend colors must be distinct"
+            legend_colors = colors
