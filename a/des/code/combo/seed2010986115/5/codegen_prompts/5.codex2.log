+# --- solver helpers ---
+
+
+def _find_separator_and_legend(grid: np.ndarray) -> tuple[int, int, list[int]]:
+    h, w = grid.shape
+
+    separator = None
+    for r in range(h - 2, -1, -1):
+        if np.all(grid[r, :] == GREY):
+            separator = r
+            break
+    assert separator is not None, "expected a full-width grey separator row"
