40:        squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
41:
42:    assert not (len(squares) < 2)
43:
44:    # Choose the size that appears at least twice (most common size).
45:    by_n: dict[int, list[dict]] = defaultdict(list)
46:    for s in squares:
47:        by_n[int(s["n"])].append(s)
48:    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
49:    cand = by_n[int(nside)]
50:    assert not (len(cand) < 2)
51:
52:    cand.sort(key=lambda s: int(s["col"]))
53:    mover = cand[0]
54:    dest = cand[1]
55:
56:    n = int(mover["n"])
57:    sr, sc = int(mover["r0"]), int(mover["c0"])
58:    dr, dc = int(dest["r0"]), int(dest["c0"])
59:
60:    # River = most common remaining color (excluding bg and the two square colors).
61:    counts = Counter(map(int, g.flatten()))
62:    river = None
63:    for col, _ct in counts.most_common():
64:        if int(col) == int(bg):
