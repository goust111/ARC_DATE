+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+TRAP_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+RECT_H_RANGE = (5, 10)
+RECT_W_RANGE = (5, 10)
+RECT_COUNT_CHOICES = (1, 2, 3, 4)
+RECT_COUNT_WEIGHTS = (2, 4, 3, 1)
+MAX_TRAPS_PER_RECT = 3
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 200
+GEN_MODES = ("open", "boundary", "wall_block")
