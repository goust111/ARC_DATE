+    for idx, rect in enumerate(rects):
+        slots = _slot_map(rect["bbox"])
+        used: set[tuple[int, int]] = set()
+        chosen: list[tuple[str, tuple[int, int]]] = []
+
+        for forced in rect["forced"]:
