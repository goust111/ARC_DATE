+                preferred_lengths = list(
+                    range(
+                        min(len(ray), SEGMENT_LEN_RANGE[1]),
+                        SEGMENT_LEN_RANGE[0] - 1,
+                        -1,
+                    )
+                )
+                random.shuffle(preferred_lengths)
+                for length in preferred_lengths:
