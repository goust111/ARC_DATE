+        if not path_options:
+            continue
+        longer = [item for item in path_options if item[0] >= 2]
+        steps, positions, bbox_union = random.choice(longer or path_options)
+        blocker_segment = None
+        if stop_kind == "obstacle":
+            blocker_segment = _choose_blocker_segment(
