+    cols = [c for _r, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    r1 = max(rows)
+    c1 = max(cols)
+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return None
+    local = frozenset((r - r0, c - c0) for r, c in coords)
+    for missing, shape in ARROW_SHAPES.items():
+        if local == frozenset(shape["occupied"]):
+            return {
+                "missing": missing,
+                "top_left": (int(r0), int(c0)),
