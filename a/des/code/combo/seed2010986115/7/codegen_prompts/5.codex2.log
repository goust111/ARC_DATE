+                ray: list[tuple[int, int]] = []
+                for dist in range(SEGMENT_LEN_RANGE[1]):
+                    rr = int(block_cell[0] + axis_r * sign * dist)
+                    cc = int(block_cell[1] + axis_c * sign * dist)
