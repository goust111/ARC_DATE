+        arrow.update(
+            {
+                "top_left": start_top_left,
+                "final_top_left": final_top_left,
+                "stop_kind": stop_kind,
+                "steps": int(steps),
+                "path_bboxes": bbox_union,
+                "blocker_segment": blocker_segment or [],
