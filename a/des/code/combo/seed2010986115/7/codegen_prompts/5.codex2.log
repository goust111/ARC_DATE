+    },
+    "bl": {
+        "direction": (-1, 1),
+        "occupied": ((0, 0), (0, 1), (0, 2), (1, 2), (2, 2)),
+        "stamp": ((1, 0), (1, 1), (2, 0), (2, 1)),
+    },
+    "br": {
+        "direction": (-1, -1),
+        "occupied": ((0, 0), (0, 1), (0, 2), (1, 0), (2, 0)),
+        "stamp": ((1, 1), (1, 2), (2, 1), (2, 2)),
+    },
+}
+
+ORTHOGONAL = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_H_RANGE = (10, 18)
+GRID_W_RANGE = (10, 18)
+ARROW_COUNT_BY_AREA = (
+    (125, 2),
+    (185, 3),
+    (10**9, 4),
+)
