+        length = random.randint(SEGMENT_LEN_RANGE[0], SEGMENT_LEN_RANGE[1])
+        if random.random() < 0.5:
+            rr = random.randint(0, h - 1)
+            cc0 = random.randint(0, w - length)
+            segment = [(int(rr), int(cc0 + k)) for k in range(length)]
+        else:
