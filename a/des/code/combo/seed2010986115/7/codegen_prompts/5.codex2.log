+def _translate_cells(top_left: tuple[int, int], local_cells: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    r0, c0 = top_left
+    return [(int(r0 + dr), int(c0 + dc)) for dr, dc in local_cells]
