+def _random_composition(total: int, parts: int, rng: random.Random) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.sample(range(1, total), parts - 1))
+    prev = 0
+    result = []
+    for cut in cuts + [total]:
+        result.append(cut - prev)
+        prev = cut
+    return result
