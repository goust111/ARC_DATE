+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+WINDOW = 4
+LEGEND = 5
+PATTERN_COLORS = (2, 3, 6, 7, 8, 9)
+
+MAX_GRID_H = 30
+MAX_GRID_W = 30
+GEN_ATTEMPTS = 400
