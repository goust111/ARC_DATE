+import numpy as np
+
+
+BG = 0
+SEP = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+QUADRANTS = ("tl", "tr", "br", "bl")
+GEN_RETRIES = 400
