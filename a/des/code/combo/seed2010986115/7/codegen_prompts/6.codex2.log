+    for i in range(slot_rows):
+        for j in range(slot_cols):
+            positions.append((1 + i * (slot_h + 1), 1 + j * (slot_w + 1)))
+    return positions
+
+
+def _build_template_patch(body: np.ndarray, seed: tuple[int, int]) -> np.ndarray:
+    patch = np.zeros(body.shape, dtype=int)
+    patch[body] = 1
+    patch[seed] = 2
+    return patch
+
+
