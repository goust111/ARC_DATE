+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    stack = [tuple(map(int, coords[0]))]
+    seen[stack[0]] = True
+    count = 0
+    while stack:
+        r, c = stack.pop()
+        count += 1
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return count == len(coords)
