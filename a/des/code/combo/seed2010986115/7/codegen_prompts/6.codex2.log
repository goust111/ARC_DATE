+            min(20, total_w // 2 + random.randint(0, 3)),
+            max_h + 4,
+        )
+        gap = random.randint(1, 3)
+        grid = np.full((panel_h, left_w + gap + panel_w), BG, dtype=int)
+
+        panel_c0 = left_w + gap
+        for r in range(0, panel_h, slot_h + 1):
