def _segments(indices: list[int]) -> list[tuple[int, int]]:
    if not indices:
        return []
    ordered = sorted(indices)
    spans: list[tuple[int, int]] = []
    start = end = int(ordered[0])
    for idx in ordered[1:]:
        idx = int(idx)
