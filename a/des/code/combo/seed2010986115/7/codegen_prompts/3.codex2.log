+
+    traced = _trace_signals(grid)
+    if traced is None:
+        return None
+    _best, stats, tie_seen = traced
+    if tie_seen:
+        return None
+    if stats["forced_continuations"] != 0:
+        return None
+    if stats["preferred_turns"] == 0 or stats["straight_fallbacks"] == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
