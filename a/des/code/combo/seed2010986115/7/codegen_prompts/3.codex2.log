import random, numpy as np
from collections import defaultdict

BG, BLUE, PATH = 0,1,5
DIRS = {'N':(-1,0),'E':(0,1),'S':(1,0),'W':(0,-1)}
OPP = {'N':'S','S':'N','E':'W','W':'E'}
PERP = {'H':['N','S'], 'V':['E','W']}

def add(a,b): return (a[0]+b[0], a[1]+b[1])

def neigh4(p):
    r,c=p
    for dr,dc in DIRS.values():
        yield (r+dr,c+dc)

def segment_cells(seg):
    (r1,c1),(r2,c2)=seg['a'],seg['b']
    if r1==r2:
        step = 1 if c2>=c1 else -1
        return [(r1,c) for c in range(c1,c2+step,step)]
    else:
        step = 1 if r2>=r1 else -1
        return [(r,c1) for r in range(r1,r2+step,step)]

def build_once(seed=None):
    if seed is not None:
        random.seed(seed)
    H=random.randint(17,29)
    W=random.randint(17,29)
    orient=random.choice('HV')
    if orient=='V':
        c=random.randint(4,W-5)
        r1=random.randint(2,max(2,H//4))
        r2=random.randint(min(H-3,3*H//4),H-3)
        root={'orientation':'V','a':(r1,c),'b':(r2,c)}
    else:
        r=random.randint(4,H-5)
        c1=random.randint(2,max(2,W//4))
        c2=random.randint(min(W-3,3*W//4),W-3)
        root={'orientation':'H','a':(r,c1),'b':(r,c2)}
    segs=[root]
    path=set(segment_cells(root))
    junction_dirs=defaultdict(set)
    branch_ops=random.randint(2,6)
    for _ in range(branch_ops):
        ok=False
        for _try in range(100):
            seg=random.choice(segs)
            cells=segment_cells(seg)
            if len(cells)<5:
                continue
            allow_existing_pivots=[p for p,dirs in junction_dirs.items() if p in cells[1:-1] and len(dirs)==1 and ((seg['orientation']=='V' and dirs<=set(['E','W'])) or (seg['orientation']=='H' and dirs<=set(['N','S'])))]
            if allow_existing_pivots and random.random()<0.3:
                pivot=random.choice(allow_existing_pivots)
            else:
                cand=[]
                for p in cells[2:-2]:
                    if any(max(abs(p[0]-q[0]),abs(p[1]-q[1]))<=2 for q in junction_dirs if q"'!=p):
                        continue
                    cand.append(p)
                if not cand:
                    continue
                pivot=random.choice(cand)
            dirs=PERP[seg['"'orientation']]
            used=junction_dirs[pivot]
            avail=[d for d in dirs if d not in used]
            if not avail:
                continue
            if len(used)==1 and OPP[next(iter(used))] in avail and random.random()<0.7:
                d=OPP[next(iter(used))]
            else:
                d=random.choice(avail)
            dr,dc=DIRS[d]
            maxlen=0
            rr,cc=pivot
            while True:
                rr+=dr; cc+=dc
                if not (1<=rr<H-1 and 1<=cc<W-1):
                    break
                maxlen+=1
            if maxlen<3:
                continue
            L=random.randint(3, min(maxlen, 8))
            new=[(pivot[0]+dr*i,pivot[1]+dc*i) for i in range(1,L+1)]
            marker=(pivot[0]+dr*(L+1), pivot[1]+dc*(L+1))
            good=True
            if marker in path or not (0<=marker[0]<H and 0<=marker[1]<W):
                good=False
            for i,p in enumerate(new):
                if p in path:
