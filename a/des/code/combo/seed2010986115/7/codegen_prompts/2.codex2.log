+    bg = _get_bg(grid)
+    r0, c0, r1, c1 = palette_bbox
+    out[r0 : r1 + 1, c0 : c1 + 1] = bg
+    for obj in objects:
+        color = obj["result_color"] if obj["result_color"] is not None else obj["color"]
+        coords = obj["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(color)
+    return out
