+def _random_connected_mask(area: int) -> np.ndarray:
+    for _ in range(100):
+        h = int(RNG.integers(1, MAX_SHAPE_SPAN + 1))
+        w = int(RNG.integers(1, MAX_SHAPE_SPAN + 1))
+        if h * w < area:
+            continue
+        seed = (int(RNG.integers(0, h)), int(RNG.integers(0, w)))
+        cells = {seed}
