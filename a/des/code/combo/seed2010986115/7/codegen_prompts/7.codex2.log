+    slots = []
+    for i in range(len(hlines) - 1):
+        for j in range(len(vlines) - 1):
+            r0 = hlines[i] + 1
+            r1 = hlines[i + 1] - 1
+            c0 = vlines[j] + 1
+            c1 = vlines[j + 1] - 1
