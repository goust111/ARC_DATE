+    for i in range(rows):
+        for j in range(cols):
+            sig = slot_sigs[idx]
+            idx += 1
+            r0 = hlines[i] + 1
+            r1 = hlines[i + 1] - 1
+            c0 = vlines[j] + 1
+            c1 = vlines[j + 1] - 1
+            for off in sig[0]:
+                patch[r0 - 1, c0 + off] = GREEN
+            for off in sig[1]:
+                patch[r0, c0 + off] = RED
+            for off in sig[2]:
+                patch[r0 + off, c1 + 1] = GREEN
+            for off in sig[3]:
