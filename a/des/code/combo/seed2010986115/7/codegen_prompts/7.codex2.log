+
+def _random_slot_signature(cell_h: int, cell_w: int, rng: random.Random) -> tuple[tuple[int, ...], ...]:
+    top_out, top_in = _random_edge(list(range(1, cell_w - 1)), rng)
+    right_out, right_in = _random_edge(list(range(1, cell_h - 1)), rng)
