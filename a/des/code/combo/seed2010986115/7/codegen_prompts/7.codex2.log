+
+    for off in sig[0]:
+        patch[r0 - 1, c0 + off] = GREEN
+    for off in sig[1]:
+        patch[r0, c0 + off] = RED
+    for off in sig[2]:
+        patch[r0 + off, c1 + 1] = GREEN
+    for off in sig[3]:
+        patch[r0 + off, c1] = RED
+    for off in sig[4]:
+        patch[r1 + 1, c0 + off] = GREEN
+    for off in sig[5]:
+        patch[r1, c0 + off] = RED
+    for off in sig[6]:
