+def _draw_piece_patch(color: int, cell_h: int, cell_w: int, sig: tuple[tuple[int, ...], ...]) -> np.ndarray:
+    top_pad = 1 if sig[0] else 0
+    right_pad = 1 if sig[2] else 0
+    bottom_pad = 1 if sig[4] else 0
+    left_pad = 1 if sig[6] else 0
