+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frame_color, frame_bbox, hlines, vlines = _frame_data(g, bg)
+    slots = _extract_slots(g, hlines, vlines)
