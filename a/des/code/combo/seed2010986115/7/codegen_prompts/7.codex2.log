+    for r in hlines:
+        out[fr0 + r, fc0 + vlines[0] : fc0 + vlines[-1] + 1] = GREY
+    for c in vlines:
+        out[fr0 + hlines[0] : fr0 + hlines[-1] + 1, fc0 + c] = GREY
+
+    idx = 0
+    for i in range(len(hlines) - 1):
+        for j in range(len(vlines) - 1):
+            r0 = fr0 + hlines[i] + 1
+            c0 = fc0 + vlines[j] + 1
+            out[r0 : r0 + cell_h, c0 : c0 + cell_w] = slot_colors[idx]
+            idx += 1
+    return out
