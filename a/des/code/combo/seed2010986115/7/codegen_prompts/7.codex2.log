+    slots = []
+    for i in range(len(hlines) - 1):
+        for j in range(len(vlines) - 1):
+            r0 = hlines[i] + 1
+            r1 = hlines[i + 1] - 1
+            c0 = vlines[j] + 1
+            c1 = vlines[j + 1] - 1
+            slots.append(
+                {
+                    "r0": int(r0),
+                    "r1": int(r1),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                    "sig": _edge_signature(grid, r0, c0, r1, c1),
