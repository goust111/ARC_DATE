+                {
+                    "r0": int(r0),
+                    "r1": int(r1),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                    "sig": _edge_signature(grid, r0, c0, r1, c1),
