+    board_w = cols * cell_w + cols + 1
+    patch = np.full((board_h, board_w), BLACK, dtype=int)
+    hlines = [i * (cell_h + 1) for i in range(rows + 1)]
+    vlines = [j * (cell_w + 1) for j in range(cols + 1)]
