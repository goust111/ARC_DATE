+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+GREY = 5
+PIECE_COLORS = (1, 4, 6, 7, 8, 9)
+GRID_SHAPES = ((2, 2), (2, 3), (3, 2))
+CELL_H_RANGE = (4, 6)
+CELL_W_RANGE = (4, 6)
