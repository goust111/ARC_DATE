+Coord = tuple[int, int]
+
+DIR4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8: tuple[Coord, ...] = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not _in_bounds((h, w), nr, nc):
+                        continue
+                    if not bool(mask[nr, nc]) or bool(seen[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            parts.append(comp)
+    return parts
+
+
+def _enclosed_components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = map(int, mask.shape)
+    enclosed = []
+    for comp in _components(mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        enclosed.append(comp)
+    return enclosed
