+
+    start = min(outgoing)
+    ordered_cells: list[Coord] = []
+    seen: set[Coord] = set()
+    cur = start
+    while cur not in seen:
+        seen.add(cur)
+        nxt, cell = outgoing[cur]
+        ordered_cells.append(cell)
+        cur = nxt
+
+    assert cur == start and len(seen) == len(outgoing), "boundary trace must close once"
+
