+
+def _unique_nearest_wall_index(seed: Coord, wall_cycle: list[Coord]) -> int:
+    distances = [abs(seed[0] - wr) + abs(seed[1] - wc) for wr, wc in wall_cycle]
+    best = min(distances)
+    winners = [i for i, dist in enumerate(distances) if dist == best]
