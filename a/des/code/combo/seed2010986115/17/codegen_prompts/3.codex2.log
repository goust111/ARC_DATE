+    contour = np.zeros_like(padded_region)
+    for r in range(h + 2):
+        for c in range(w + 2):
+            if not bool(padded_region[r, c]):
+                continue
+            for dr, dc in DIR8:
+                nr = r + dr
+                nc = c + dc
+                if _in_bounds(padded_region.shape, nr, nc) and not bool(padded_region[nr, nc]):
