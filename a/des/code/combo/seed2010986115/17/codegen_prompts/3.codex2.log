def neigh4(r,c,h,w):
    if r>0: yield r-1,c
    if r+1<h: yield r+1,c
    if c>0: yield r,c-1
    if c+1<w: yield r,c+1

def boundary_order(region):
    h,w=region.shape
    edges=[]
    for r in range(h):
        for c in range(w):
            if not region[r,c]:
                continue
            if r==0 or not region[r-1,c]:
                edges.append(((r,c),(r,c+1),(r,c)))
            if c==w-1 or not region[r,c+1]:
                edges.append(((r,c+1),(r+1,c+1),(r,c)))
            if r==h-1 or not region[r+1,c]:
                edges.append(((r+1,c+1),(r+1,c),(r,c)))
            if c==0 or not region[r,c-1]:
                edges.append(((r+1,c),(r,c),(r,c)))
    nxt={}
    indeg={}
    for e in edges:
        s,t,cell=e
        nxt[s]=e
        indeg[t]=indeg.get(t,0)+1
    start=min(nxt)
    seq=[]; seen=set(); cur=start
    while cur not in seen:
        seen.add(cur)
        e=nxt[cur]
        seq.append(e[2])
        cur=e[1]
    comp=[]
    for cell in seq:
        if not comp or comp[-1]"'!=cell:
            comp.append(cell)
    if comp[0]==comp[-1]: comp.pop()
    return comp

def analyze(region,name):
    order=boundary_order(region)
    wallset=set(order)
    core=[]
    for r,c in zip(*np.where(region)):
        if (r,c) not in wallset:
            core.append((int(r),int(c)))
    nearest={}
    for cell in core:
        ds=[abs(cell[0]-wr)+abs(cell[1]-wc) for wr,wc in order]
        m=min(ds)
        idxs=[i for i,d in enumerate(ds) if d==m]
        if len(idxs)==1:
            nearest[cell]=idxs[0]
    counts={}
    for idx in nearest.values(): counts[idx]=counts.get(idx,0)+1
    feasible=[]
    P=len(order)
    for K in range(1,min(6,len(core))+1):
        if P%K: continue
        L=P//K
        ok=False
        for o in range(P):
            starts=[(o+i*L)%P for i in range(K)]
            if all(s in counts for s in starts):
                ok=True; break
        if ok: feasible.append((K,L))
    print(name,'"'P',len(order),'core',len(core),'unique-starts',len(counts),'feasible',feasible[:10])

