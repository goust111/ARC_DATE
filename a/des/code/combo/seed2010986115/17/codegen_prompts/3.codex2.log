+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
