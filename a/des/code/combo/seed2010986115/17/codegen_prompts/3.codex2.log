+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        try:
+            inp, expected = _generate_pair()
+        except RuntimeError:
+            continue
+        try:
+            actual = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

