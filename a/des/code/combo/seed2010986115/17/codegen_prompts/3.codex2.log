+    for cell in ordered_cells:
+        if not cycle or cycle[-1] != cell:
+            cycle.append(cell)
+    if cycle and cycle[0] == cycle[-1]:
+        cycle.pop()
+    assert cycle and len(cycle) == len(set(cycle)), "wall cycle must visit unique cells once"
+    return cycle
