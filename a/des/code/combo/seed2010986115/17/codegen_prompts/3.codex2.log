import numpy as np
from collections import deque

def neigh8(r,c,h,w):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if not dr and not dc: continue
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w:
                yield nr,nc

def neigh4(r,c,h,w):
    if r>0: yield r-1,c
    if r+1<h: yield r+1,c
    if c>0: yield r,c-1
    if c+1<w: yield r,c+1

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=1; comp=[]
            while q:
                x,y=q.popleft(); comp.append((x,y))
                for nx,ny in neigh4(x,y,h,w):
                    if mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=1; q.append((nx,ny))
            out.append(comp)
    return out

for name,reg in [('rect',np.pad(np.ones((5,6),dtype=bool),2)), ('plus',None)]:
    if reg is None:
        reg=np.zeros((13,13),dtype=bool)
        reg[2:11,5:8]=1
