import numpy as np
from collections import deque

def neigh4(r,c,h,w):
    if r>0: yield r-1,c
    if r+1<h: yield r+1,c
    if c>0: yield r,c-1
    if c+1<w: yield r,c+1

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=1; comp=[]
            while q:
                x,y=q.popleft(); comp.append((x,y))
                for nx,ny in neigh4(x,y,h,w):
                    if mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=1; q.append((nx,ny))
            out.append(comp)
    return out

def patch(region):
    h,w=region.shape
    big=np.zeros((h+2,w+2),dtype=bool)
    big[1:1+h,1:1+w]=region
    cont=np.zeros_like(big)
    H,W=big.shape
    for r in range(H):
        for c in range(W):
            if not big[r,c]: continue
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    if not dr and not dc: continue
                    nr,nc=r+dr,c+dc
                    if 0<=nr<H and 0<=nc<W and not big[nr,nc]:
                        cont[nr,nc]=1
    enc=[comp for comp in comps(~cont) if not any(r in (0,H-1) or c in (0,W-1) for r,c in comp)]
    print('cont comps',len(comps(cont)),'enclosed',len(enc),[len(x) for x in enc],'region',int(big.sum()),'equal', len(enc)==1 and set(enc[0])==set(map(tuple,np.argwhere(big))))
    print(cont.astype(int))

