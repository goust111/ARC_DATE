+    patch[contour] = contour_color
+    enclosed = _enclosed_components(patch != contour_color)
+    expected_region = {(r, c) for r, c in np.argwhere(padded_region)}
+    assert len(enclosed) == 1 and set(enclosed[0]) == expected_region
