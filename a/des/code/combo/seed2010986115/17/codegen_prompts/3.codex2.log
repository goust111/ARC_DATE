+def _border_background(grid: np.ndarray) -> int:
+    g = np.asarray(grid, dtype=int)
+    border = np.concatenate((g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]))
+    values, counts = np.unique(border, return_counts=True)
+    return int(values[np.argmax(counts)])
