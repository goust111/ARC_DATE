+    h, w = map(int, canvas.shape)
+    ph, pw = map(int, patch.shape)
+    if ph + 2 > h or pw + 2 > w:
+        return None
+
+    top_left = _sample_patch_location(occupied, patch.shape)
+    if top_left is None:
+        return None
+    r0, c0 = top_left
+    _paste_patch(canvas, patch, top_left)
+    occupied[r0 : r0 + ph, c0 : c0 + pw] = True
+    return top_left
+
