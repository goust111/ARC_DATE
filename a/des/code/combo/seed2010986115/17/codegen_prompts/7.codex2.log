+def _chebyshev_clear(cells: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    cell_set = set(cells)
+    for r, c in cells:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if (nr, nc) in cell_set:
+                    continue
+                if (nr, nc) in occupied:
+                    return False
+    return True
