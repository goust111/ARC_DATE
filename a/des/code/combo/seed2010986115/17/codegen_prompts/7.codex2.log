+    coords += [(r, c0 + ww - 1) for r in range(r0 + 1, r0 + hh - 1)]
+    if hh > 1:
+        coords += [(r0 + hh - 1, c) for c in range(c0 + ww - 1, c0 - 1, -1)]
+    if ww > 1:
+        coords += [(r, c0) for r in range(r0 + hh - 2, r0, -1)]
+    return coords
+
