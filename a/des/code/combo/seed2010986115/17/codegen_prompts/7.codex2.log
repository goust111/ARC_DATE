+
+def _in_corner_window(r0: int, c0: int, r1: int, c1: int, h: int, w: int) -> bool:
+    return (
+        (r1 < 4 and c1 < 4)
+        or (r1 < 4 and c0 >= w - 4)
+        or (r0 >= h - 4 and c1 < 4)
+        or (r0 >= h - 4 and c0 >= w - 4)
