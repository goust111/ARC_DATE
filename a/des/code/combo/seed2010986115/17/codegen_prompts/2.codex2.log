+def _random_dihedral(pattern: np.ndarray) -> np.ndarray:
+    arr = np.array(pattern, copy=True)
+    if random.random() < 0.5:
+        arr = np.fliplr(arr)
+    if random.random() < 0.5:
+        arr = np.flipud(arr)
+    return np.rot90(arr, random.randrange(4))
