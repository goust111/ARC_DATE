+    if edge == "bottom":
+        return int(pattern[-1, 0]), int(pattern[-1, 1])
+    if edge == "left":
+        return int(pattern[0, 0]), int(pattern[1, 0])
+    if edge == "right":
+        return int(pattern[0, -1]), int(pattern[1, -1])
