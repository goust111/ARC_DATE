+
+        occ = np.zeros((h, w), dtype=bool)
+        marker_buffer = np.zeros((h, w), dtype=bool)
+        ok = True
+        for spec in placed_specs:
+            options = spec["options"].copy()
+            random.shuffle(options)
+            choice = None
+            for opt in options:
+                placed = opt["placed"]
+                ph, pw = placed.shape
+                if opt["edge"] in {"top", "bottom"}:
