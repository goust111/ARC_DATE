+            ordered = sorted(coords, key=lambda rc: rc[1])
+            assert ordered[0][1] + 1 == ordered[1][1]
+            edge = "top"
+            anchor = int(ordered[0][1])
+        elif len(rows) == 1 and next(iter(rows)) == h - 1:
