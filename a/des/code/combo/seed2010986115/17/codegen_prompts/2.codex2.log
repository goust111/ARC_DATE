+    start = next(iter(coords))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nxt = (int(r + dr), int(c + dc))
+            if nxt in coords and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
