+            pat[r, c] = int(color_a)
+        pat = _random_dihedral(pat)
+
+        ok = False
+        for edge in EDGES:
+            placed = _transform_for_edge(pat, edge)
+            sig = _edge_signature(placed, edge)
+            if sig[0] != sig[1]:
+                ok = True
+                break
