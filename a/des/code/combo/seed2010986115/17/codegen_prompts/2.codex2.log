+def _marker_cells(edge: str, anchor: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    if edge == "top":
+        return [(0, int(anchor)), (0, int(anchor + 1))]
+    if edge == "bottom":
+        return [(h - 1, int(anchor)), (h - 1, int(anchor + 1))]
+    if edge == "left":
