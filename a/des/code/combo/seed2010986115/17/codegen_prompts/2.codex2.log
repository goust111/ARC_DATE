+
+def _can_place_fragment(dilated: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    return not bool((dilated[int(r0) : int(r0) + h, int(c0) : int(c0) + w] & mask).any())
