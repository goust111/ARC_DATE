+        cs_src = slice(max(0, -dc), mask.shape[1] - max(0, dc))
+        rs_dst = slice(max(0, dr), mask.shape[0] - max(0, -dr))
+        cs_dst = slice(max(0, dc), mask.shape[1] - max(0, -dc))
