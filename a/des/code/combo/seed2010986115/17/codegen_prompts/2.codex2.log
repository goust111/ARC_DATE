+def _random_connected_subset(h: int, w: int, size: int) -> set[tuple[int, int]] | None:
+    seed = (random.randrange(h), random.randrange(w))
+    cells = {seed}
+    frontier = set()
+    while len(cells) < size:
+        frontier.clear()
+        for r, c in cells:
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
