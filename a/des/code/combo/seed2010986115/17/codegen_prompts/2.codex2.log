+
+def _generate_pair_pattern(color_a: int, color_b: int) -> np.ndarray | None:
+    for _ in range(PAIR_GEN_RETRIES):
+        rect_h, rect_w = random.choice(RECT_DIMS)
+        area = rect_h * rect_w
+        size_lo = max(2, area - 6)
+        size_hi = min(6, area - 2)
+        if size_lo > size_hi:
