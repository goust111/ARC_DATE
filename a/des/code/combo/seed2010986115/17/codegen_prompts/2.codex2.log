+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            comp = []
+            queue = deque([(int(r), int(c))])
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
