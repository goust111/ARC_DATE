+def _boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in NEIGHBORS4:
+            nr = rr + dr
+            nc = cc + dc
+            if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                out[rr, cc] = True
+                break
+    return out
