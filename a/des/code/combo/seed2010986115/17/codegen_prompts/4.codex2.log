+def _peel_layers(mask: np.ndarray) -> list[np.ndarray]:
+    work = mask.copy()
+    layers: list[np.ndarray] = []
+    while work.any():
+        ring = _boundary(work)
+        layers.append(np.argwhere(ring))
+        work[ring] = False
+    return layers
