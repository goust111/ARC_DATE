    components.append((kind, comp, rotated_target, source_color))
max_h = max(comp.shape[0] for _, comp, _, _ in components)
max_w = max(comp.shape[1] for _, comp, _, _ in components)
packed_area = sum((comp.shape[0] + 2) * (comp.shape[1] + 2) for _, comp, _, _ in components)
side = int(np.ceil(np.sqrt(packed_area))) + rng.randint(6, 10)
h = max(max_h + 4, side + rng.randint(0, 5))
w = max(max_w + 4, side + rng.randint(0, 7))
grid = np.full((h, w), bg_color, dtype=int)
occupied = np.zeros((h, w), dtype=bool)
for kind, comp, target, source_color in components:
    placed = mod._render_component(grid, occupied, comp, target, source_color, pipe_color, bg_color, rng)
    print('"'component', kind, comp.shape, 'placed', placed)

bg = mod._most_common_color(grid)
counts = Counter(map(int, grid.flatten()))
for col,_ in counts.most_common():
    if col "'!= bg:
        pipe = col
        break
print('"'bg', bg, 'pipe', pipe, 'counts', counts)
pipe_mask = grid == pipe
h_strips, v_strips = mod._extract_strips(pipe_mask)
print('H strips', h_strips)
print('V strips', v_strips)

nodes = {}
strip_events = defaultdict(list)
touched_ends = {}
for strip in h_strips:
    touched_ends[str(strip['id'])] = {'L': False, 'R': False}
for strip in v_strips:
    touched_ends[str(strip['id'])] = {'T': False, 'B': False}

junction_id = 0
for h_strip in h_strips:
    for v_strip in v_strips:
        rr0 = max(int(h_strip['r0']), int(v_strip['r0']))
        rr1 = min(int(h_strip['r1']), int(v_strip['r1']))
        cc0 = max(int(h_strip['c0']), int(v_strip['c0']))
        cc1 = min(int(h_strip['c1']), int(v_strip['c1']))
        if rr0 > rr1 or cc0 > cc1:
