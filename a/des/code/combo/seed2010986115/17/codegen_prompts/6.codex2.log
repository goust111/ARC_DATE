+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+NORTH = (-1, 0)
+SOUTH = (1, 0)
+WEST = (0, -1)
+EAST = (0, 1)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in (NORTH, SOUTH, WEST, EAST):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _uniform_color(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> int | None:
+    r0, c0, r1, c1 = bbox
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if patch.shape != (2, 2):
+        return None
+    color = int(patch[0, 0])
+    if bool((patch == color).all()):
+        return color
+    return None
+
+
+def _extract_strips(pipe_mask: np.ndarray) -> tuple[list[dict], list[dict]]:
+    h, w = pipe_mask.shape
+    left = np.zeros_like(pipe_mask, dtype=bool)
+    right = np.zeros_like(pipe_mask, dtype=bool)
+    up = np.zeros_like(pipe_mask, dtype=bool)
+    down = np.zeros_like(pipe_mask, dtype=bool)
+    left[:, 1:] = pipe_mask[:, :-1]
+    right[:, :-1] = pipe_mask[:, 1:]
+    up[1:, :] = pipe_mask[:-1, :]
+    down[:-1, :] = pipe_mask[1:, :]
+
+    hmask = pipe_mask & (left | right)
+    vmask = pipe_mask & (up | down)
+
+    h_strips: list[dict] = []
+    v_strips: list[dict] = []
+
+    for idx, comp in enumerate(_components(hmask)):
+        r0, c0, r1, c1 = _bbox(comp)
+        patch = pipe_mask[r0 : r1 + 1, c0 : c1 + 1]
+        assert bool(patch.all()), "horizontal strip must be a solid rectangle"
+        h_strips.append(
+            {
+                "id": f"H{idx}",
+                "orient": "H",
+                "r0": int(r0),
+                "c0": int(c0),
+                "r1": int(r1),
+                "c1": int(c1),
+                "width": int(r1 - r0 + 1),
+            }
+        )
+
+    for idx, comp in enumerate(_components(vmask)):
+        r0, c0, r1, c1 = _bbox(comp)
+        patch = pipe_mask[r0 : r1 + 1, c0 : c1 + 1]
+        assert bool(patch.all()), "vertical strip must be a solid rectangle"
+        v_strips.append(
+            {
+                "id": f"V{idx}",
+                "orient": "V",
+                "r0": int(r0),
+                "c0": int(c0),
+                "r1": int(r1),
+                "c1": int(c1),
+                "width": int(c1 - c0 + 1),
+            }
+        )
+
+    assert h_strips and v_strips, "expected both horizontal and vertical pipe strips"
+    return h_strips, v_strips
+
+
+def _candidate_terminal_bboxes(strip: dict, side: str) -> list[tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = map(int, (strip["r0"], strip["c0"], strip["r1"], strip["c1"]))
+    width = int(strip["width"])
+    out: list[tuple[int, int, int, int]] = []
+
+    if strip["orient"] == "H":
+        row_starts = [r0] if width == 2 else [r0 - 1, r0]
+        col_start = c0 - 2 if side == "L" else c1 + 1
+        for rs in row_starts:
+            out.append((rs, col_start, rs + 1, col_start + 1))
+    else:
+        col_starts = [c0] if width == 2 else [c0 - 1, c0]
+        row_start = r0 - 2 if side == "T" else r1 + 1
+        for cs in col_starts:
+            out.append((row_start, cs, row_start + 1, cs + 1))
+    return out
+
