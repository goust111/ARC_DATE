+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+NORTH = (-1, 0)
+SOUTH = (1, 0)
+WEST = (0, -1)
+EAST = (0, 1)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in (NORTH, SOUTH, WEST, EAST):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _uniform_color(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> int | None:
+    r0, c0, r1, c1 = bbox
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if patch.shape != (2, 2):
+        return None
+    color = int(patch[0, 0])
+    if bool((patch == color).all()):
+        return color
+    return None
+
+
+def _extract_strips(pipe_mask: np.ndarray) -> tuple[list[dict], list[dict]]:
