+def _choose_component_types(rng: random.Random, count: int) -> list[str]:
+    kinds = ["turn_wider", "straight_tie", "straight_wider"]
+    selected = rng.sample(kinds, k=min(count, len(kinds)))
+    while len(selected) < count:
