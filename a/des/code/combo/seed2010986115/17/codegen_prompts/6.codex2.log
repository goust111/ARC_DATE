+        assert len(events) >= 2, "each horizontal strip must connect at least two events"
+        for (_pa, node_a), (_pb, node_b) in zip(events, events[1:]):
+            if node_a == node_b:
+                continue
+            eid = f"E{edge_id}"
+            edge_id += 1
+            width = int(strip["width"])
