+    _paint_rect(arr, 0, 0, 2, 2, _SOURCE_CODE)
+    _paint_rect(arr, 0, 2, 2, total_h, _PIPE_CODE)
+    _paint_rect(arr, 0, 2 + total_h, 2, 2, _COLLECTOR_CODE)
+    _paint_rect(arr, 1, branch_col, lower_r + 1, 1, _PIPE_CODE)
