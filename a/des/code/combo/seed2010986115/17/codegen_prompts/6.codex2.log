+        color = int(source_info["color"])
+        first = adjacency[source_id][0]
+        prev_node = source_id
+        cur_node = str(first["to"])
+        move_dir = tuple(first["dir"])
+        seen: set[tuple[str, str, tuple[int, int]]] = {(prev_node, cur_node, move_dir)}
