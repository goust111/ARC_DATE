+        return None
+
+    if int(np.count_nonzero(solved != grid)) != 4 * component_count:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        rng = random.Random()
+        result = _gen_attempt(rng)
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a valid pipe-routing puzzle")

