+
+
+def _build_straight_tie(rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    h_lead = rng.randint(4, 6)
+    v_to_dec = rng.randint(3, 5)
+    v_after = rng.randint(5, 6)
