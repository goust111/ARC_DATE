+            next_node = str(step["to"])
+            next_dir = tuple(step["dir"])
+            state = (cur_node, next_node, next_dir)
+            assert state not in seen, "signal routing must not loop"
+            seen.add(state)
+            prev_node, cur_node, move_dir = cur_node, next_node, next_dir
