+    current = int(indices[pos])
+    for i in range(pos + 1, len(indices)):
+        nxt = int(indices[i])
+        if nxt - current > max_gap:
+            break
+        current = nxt
+    return current
+
+
+def _row_run_end(mask: np.ndarray, row: int, start_col: int) -> int:
+    cols = np.flatnonzero(mask[row])
+    return _run_end(cols, start_col)
