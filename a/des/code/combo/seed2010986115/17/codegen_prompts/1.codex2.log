+    for i, color in enumerate(palette):
+        grid[start_row + i * step, palette_col] = color
+
+    return grid, placed, palette
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
