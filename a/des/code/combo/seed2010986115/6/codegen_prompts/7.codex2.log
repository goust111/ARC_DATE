+                "color": int(comp["color"]),
+                "radius": int(len(coords)),
+                "center": _visual_center(coords),
+            }
+        )
+
+    bombs.sort(
+        key=lambda bomb: (
+            int(bomb["radius"]),
+            int(bomb["center"][0]),
+            int(bomb["center"][1]),
+            int(bomb["color"]),
+        )
+    )
+
+    for bomb in bombs:
+        radius = int(bomb["radius"])
+        color = int(bomb["color"])
+        cr, cc = bomb["center"]
+        for rr in range(max(0, cr - radius), min(h, cr + radius + 1)):
+            rem = radius - abs(rr - cr)
+            c0 = max(0, cc - rem)
+            c1 = min(w, cc + rem + 1)
