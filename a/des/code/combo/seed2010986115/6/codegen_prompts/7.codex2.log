+def _crop_cluster(
+    arr: np.ndarray,
+    bombs: list[dict[str, object]],
+) -> dict[str, object]:
+    pts = np.argwhere(arr != BLACK)
+    assert pts.size > 0
+    r0 = max(0, int(pts[:, 0].min()) - 1)
+    c0 = max(0, int(pts[:, 1].min()) - 1)
+    r1 = min(arr.shape[0] - 1, int(pts[:, 0].max()) + 1)
+    c1 = min(arr.shape[1] - 1, int(pts[:, 1].max()) + 1)
