+def _coverage_mask(
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    radius: int,
+) -> np.ndarray:
+    h, w = shape
+    cr, cc = center
+    cover = np.zeros((h, w), dtype=bool)
+    for rr in range(max(0, cr - radius), min(h, cr + radius + 1)):
+        rem = radius - abs(rr - cr)
+        c0 = max(0, cc - rem)
+        c1 = min(w, cc + rem + 1)
+        cover[rr, c0:c1] = True
