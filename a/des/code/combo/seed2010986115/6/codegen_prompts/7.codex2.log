+        return None
+    if not _valid_instance(grid, bombs, require_overlap=require_overlap):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
