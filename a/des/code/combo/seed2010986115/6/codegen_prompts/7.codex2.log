+            r += 1 if rr > r else -1
+            cells.add((int(r), int(c)))
+    else:
+        while r != rr:
+            r += 1 if rr > r else -1
+            cells.add((int(r), int(c)))
+        while c != cc:
+            c += 1 if cc > c else -1
+            cells.add((int(r), int(c)))
