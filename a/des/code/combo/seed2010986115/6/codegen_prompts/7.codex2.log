+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor grey cells inside each bomb's Manhattan blast, with smaller bombs
+    taking priority on overlaps.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
