+    r, c = cell
+    hits = []
+    if r == 0:
+        hits.append("up")
+    if r == height - 1:
+        hits.append("down")
+    if c == 0:
+        hits.append("left")
+    if c == width - 1:
+        hits.append("right")
+    assert len(hits) == 1, "leader pixel must lie on exactly one non-corner edge"
+    return hits[0]
+
+
