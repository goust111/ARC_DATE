+            if rr in (0, height - 1) or cc in (0, width - 1):
+                edge_cells.append((rr, cc))
+        assert len(edge_cells) == 1, "each color must have exactly one leader pixel on an edge"
+        direction = _edge_direction(edge_cells[0], height, width)
