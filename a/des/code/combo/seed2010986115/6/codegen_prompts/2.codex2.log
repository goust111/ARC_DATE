+    height, width = mask.shape
+    for r, c in cells:
+        r0 = max(0, r - gap)
+        r1 = min(height, r + gap + 1)
+        c0 = max(0, c - gap)
+        c1 = min(width, c + gap + 1)
+        if mask[r0:r1, c0:c1].any():
+            return False
+    return True
+
