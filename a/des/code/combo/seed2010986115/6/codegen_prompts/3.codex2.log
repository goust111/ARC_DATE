+        w = int(rng.integers(1, 4))
+        n_cells = int(rng.integers(1, h * w + 1))
+        mask = np.zeros((h, w), dtype=bool)
+        picks = rng.choice(h * w, size=n_cells, replace=False)
+        mask.flat[picks] = True
