+def _wrap_with_frames(obj: np.ndarray, frame_colors: list[int]) -> np.ndarray:
+    cur = np.asarray(obj, dtype=int)
+    for color in frame_colors:
+        h, w = map(int, cur.shape)
+        nxt = np.full((h + 2, w + 2), BG, dtype=int)
+        nxt[0, :] = int(color)
+        nxt[-1, :] = int(color)
+        nxt[:, 0] = int(color)
+        nxt[:, -1] = int(color)
+        nxt[1:-1, 1:-1] = cur
+        cur = nxt
+    return cur
+
