+        key_count = len(_key_objects(grid, 0))
+        lock_count = len(_lockholes(grid, 0))
+        if key_count != pair_count or lock_count != pair_count:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

