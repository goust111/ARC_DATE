+                break
+            if mask is None:
+                ok = False
+                break
+            masks.append(mask)
+        if not ok:
+            continue
+
+        patches: list[dict] = []
+        total_area = 0
+        for mask, color in zip(masks, colors, strict=False):
+            key_patch = _mask_patch(mask, color, 0)
+            lock_patch = _lock_patch(mask, 0)
+            total_area += int(np.prod(key_patch.shape) + np.prod(lock_patch.shape))
