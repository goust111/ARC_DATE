+    extra_w = random.randint(2, min(4, 8 - w))
+    top = random.randint(1, extra_h - 1)
+    bottom = extra_h - top
+    left = random.randint(1, extra_w - 1)
+    right = extra_w - left
+    patch = np.full((h + top + bottom, w + left + right), GREY, dtype=int)
+    window = patch[top : top + h, left : left + w]
+    window[mask] = bg
+    return patch
