+def _hole_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    holes: list[list[tuple[int, int]]] = []
+    for comp in _find_components(~mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        holes.append(comp)
+    return holes
