+            return []
+
+        mask = np.zeros((h, w), dtype=bool)
+        mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        border = np.zeros((h, w), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if np.any(mask & ~border):
+            return []
+
+        missing = np.argwhere(border & ~mask)
+        if len(missing) != 1:
+            return []
+        mr, mc = map(int, missing[0])
+        if (mr in {0, h - 1}) + (mc in {0, w - 1}) != 1:
+            return []
+        if mr == 0:
+            side = "top"
+        elif mr == h - 1:
+            side = "bottom"
+        elif mc == 0:
+            side = "left"
+        else:
+            side = "right"
