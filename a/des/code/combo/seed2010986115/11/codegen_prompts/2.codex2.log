+    grid[fr0, fc0 : fc1 + 1] = fence_color
+    grid[fr1, fc0 : fc1 + 1] = fence_color
+    grid[fr0 : fr1 + 1, fc0] = fence_color
+    grid[fr0 : fr1 + 1, fc1] = fence_color
