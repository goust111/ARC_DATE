+            reserved.append(patch_box)
+            seen_shapes.add(sig)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    expected = grid.copy()
+    for info in placed_infos:
+        _paint_transformed_sprite(expected, info)
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
