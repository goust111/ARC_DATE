+    sr0 = fr0 + obj["sprite_bbox_local"][0]
+    sc0 = fc0 + obj["sprite_bbox_local"][1]
+    sr1 = fr0 + obj["sprite_bbox_local"][2]
+    sc1 = fc0 + obj["sprite_bbox_local"][3]
