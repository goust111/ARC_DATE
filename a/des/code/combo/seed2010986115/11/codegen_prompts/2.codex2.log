+    sprite_bbox = (inner_r, inner_c, inner_r + sprite_h - 1, inner_c + sprite_w - 1)
+    dr, dc = _translation(side, frame_bbox, sprite_bbox)
+    moved_bbox = (
+        sprite_bbox[0] + dr,
+        sprite_bbox[1] + dc,
+        sprite_bbox[2] + dr,
+        sprite_bbox[3] + dc,
+    )
+
+    min_r = min(0, moved_bbox[0])
+    min_c = min(0, moved_bbox[1])
