+def _render_chain(order: list[int], segments: dict[int, dict[str, int | str]]) -> np.ndarray:
+    painted: dict[tuple[int, int], int] = {}
+    cur_r = 0
+    cur_c = 0
+    max_r = 0
+    max_c = 0
