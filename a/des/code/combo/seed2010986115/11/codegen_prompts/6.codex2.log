+    coords = {(r0, c) for c in range(c0, c1 + 1)}
+    coords |= {(r1, c) for c in range(c0, c1 + 1)}
+    coords |= {(r, c0) for r in range(r0, r1 + 1)}
+    coords |= {(r, c1) for r in range(r0, r1 + 1)}
+    coords.discard((int(gap[0]), int(gap[1])))
