+
+def _canonical_gap(bbox: tuple[int, int, int, int], side: str, index: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = map(int, bbox)
+    if side == "up":
+        return (r0, c0 + index)
+    if side == "right":
