from __future__ import annotations

import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
MAGENTA = 6

FRAME_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA)
SIDE_TO_TURNS = {"up": 0, "right": 1, "down": 2, "left": 3}
SIDES = tuple(SIDE_TO_TURNS)

LAYER_RANGE = (2, 8)
PAD_RANGE = (2, 5)
INNER_MARGIN = 1
CANVAS_MARGIN_RANGE = (1, 5)
MAX_STACK_SIZE = 22
MAX_GENERATION_ATTEMPTS = 400


PATTERN_LIBRARY = [
    np.array(
        [
            [1, 0, 0],
            [1, 0, 0],
            [1, 1, 0],
        ],
        dtype=bool,
    ),
