+    rotated = _rotate_coords(yellow, center2, turns)
+    assert bool(
+        np.all(
+            (rotated[:, 0] > ir0)
+            & (rotated[:, 0] < ir1)
+            & (rotated[:, 1] > ic0)
+            & (rotated[:, 1] < ic1)
+        )
+    ), "rotated pattern must remain inside the innermost frame"
+    out[rotated[:, 0], rotated[:, 1]] = YELLOW
+    return out
