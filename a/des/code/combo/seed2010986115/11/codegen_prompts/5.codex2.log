+        return None
+
+    segments: list[tuple[int, int]] = []
+    start = 0
+    for sep in seps:
+        if sep <= start:
+            return None
+        segments.append((start, sep))
+        start = sep + 1
+    if start >= length:
+        return None
+    segments.append((start, length))
+
+    if len(segments) < 3:
+        return None
+    widths = {b - a for a, b in segments}
+    if len(widths) != 1:
+        return None
+    return segments
+
+
