+            top = rng.randint(min_top_pos, max_top_pos)
+
+        wall_mask = spec["wall"]
+        patch = scene[top : top + sh, left : left + sw]
+        patch[np.asarray(wall_mask, dtype=bool)] = WALL
+
+        seed_r, seed_c = spec["seed"]
+        scene[top + seed_r, left + seed_c] = int(spec["seed_color"])
