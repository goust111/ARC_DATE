+def _make_stair_mask(rng: random.Random) -> np.ndarray:
+    h = rng.randint(3, 5)
+    w = rng.randint(4, 6)
+    mask = np.ones((h, w), dtype=bool)
+    side = rng.choice(["left", "right"])
+    order = list(range(h))
+    if rng.random() < 0.5:
+        order.reverse()
+    trim = 0
+    max_trim = w - 2
+    changed = False
+    for i, r in enumerate(order):
+        if i > 0 and trim < max_trim and rng.random() < 0.75:
+            trim += 1
+            changed = True
+        if side == "left":
+            mask[r, :trim] = False
+        else:
+            mask[r, w - trim :] = False
+    if not changed:
+        trim = 1
+        if side == "left":
+            mask[order[-1], :trim] = False
+        else:
+            mask[order[-1], w - trim :] = False
+    if rng.random() < 0.5:
+        mask = mask.T
+    return mask
+
+
+def _make_interior_mask(rng: random.Random) -> np.ndarray:
+    if rng.random() < 0.45:
+        h = rng.randint(2, 4)
