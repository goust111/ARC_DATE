+    max_bottom = max((int(spec["h"]) for spec, side in zip(specs, sides) if side == "bottom"), default=0)
+    trunk_row = max_top + 1 + rng.randint(0, 1)
+    scene_h = trunk_row + 1 + max_bottom + 1 + rng.randint(0, 2)
