+def _choose_anchor(points: list[tuple[int, int]], axis: str) -> tuple[int, int]:
+    if axis == "left":
+        target = min(c for _, c in points)
+        cand = sorted((r, c) for r, c in points if c == target)
+    elif axis == "right":
