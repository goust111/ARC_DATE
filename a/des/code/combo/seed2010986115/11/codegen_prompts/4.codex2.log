+    sides = [rng.choice(["top", "bottom"]) for _ in range(n)]
+    if n >= 2 and len(set(sides)) == 1 and rng.random() < 0.5:
+        sides[-1] = "bottom" if sides[0] == "top" else "top"
+
+    gaps = [rng.randint(1, 2) for _ in range(n - 1)]
