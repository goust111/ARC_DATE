+            "w": int(wall.shape[1]),
+            "wall": wall,
+            "seed": seed,
+            "seed_color": int(seed_color),
+            "anchors": {
+                "left": _choose_anchor(wall_points, "left"),
+                "right": _choose_anchor(wall_points, "right"),
+                "top": _choose_anchor(wall_points, "top"),
+                "bottom": _choose_anchor(wall_points, "bottom"),
