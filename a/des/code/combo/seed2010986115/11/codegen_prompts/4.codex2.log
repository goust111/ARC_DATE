+
+        anchor_r, anchor_c = spec["anchors"][side]
+        rr = top + anchor_r
+        ac = left + anchor_c
+        if side == "left":
+            scene[rr, ac : trunk_col + 1] = WALL
+        else:
+            scene[rr, trunk_col : ac + 1] = WALL
+
+        top += sh + (gaps[i] if i < len(gaps) else 0)
+
+    return scene
+
+
