+    out = g.copy()
+    for cavity in cavities:
+        pattern = mapping[int(cavity["seed"])]
+        rows: dict[int, list[int]] = defaultdict(list)
+        for r, c in cavity["pixels"]:
+            rows[int(r)].append(int(c))
+        for r in sorted(rows):
