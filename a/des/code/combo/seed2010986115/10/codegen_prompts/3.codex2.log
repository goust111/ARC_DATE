+def _depths(rows: int, cols: int) -> np.ndarray:
+    arr = np.zeros((rows, cols), dtype=int)
+    for i in range(rows):
+        for j in range(cols):
+            arr[i, j] = min(i, j, rows - 1 - i, cols - 1 - j)
