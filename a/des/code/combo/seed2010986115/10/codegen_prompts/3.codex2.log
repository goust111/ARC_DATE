+ROOM_COUNT_CHOICES = (3, 4, 5)
+ROOM_SIZE_MIN = 2
+ROOM_SIZE_MAX = 5
+GRID_DIM_MIN = 8
+GRID_DIM_MAX = 26
+GEN_ATTEMPTS = 300
+LAYOUT_ATTEMPTS = 100
