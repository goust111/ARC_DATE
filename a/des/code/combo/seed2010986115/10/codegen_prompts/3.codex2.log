+import numpy as np
+
+
+BLACK = 0
+MAGENTA = 6
+WALL_COLORS = (1, 2, 3, 4, 7, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+# --------------- solver ---------------
+
+
+def _floor_mask(grid: np.ndarray) -> np.ndarray:
+    return (grid == BLACK) | (grid == MAGENTA)
