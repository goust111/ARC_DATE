+def _find_separator_row(g: np.ndarray) -> int:
+    h = g.shape[0]
+    candidates = []
+    for r in range(h):
+        if int(g[r, 0]) == BLACK:
+            continue
+        if not np.all(g[r, :] == g[r, 0]):
+            continue
+        if not np.any(g[:r, :] != BLACK):
