+def _piece_anchor(side: str, fr0: int, fc0: int, fr1: int, fc1: int, start: int, mask: np.ndarray, gap: int = 4) -> tuple[int, int]:
+    sh, sw = mask.shape
+    if side == "top":
+        return fr0 - gap - sh, fc0 + start
+    if side == "bottom":
+        return fr1 + gap + 1, fc0 + start
+    if side == "left":
