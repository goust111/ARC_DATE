+SIDE_FROM_DIR = {
+    "up": "bottom",
+    "down": "top",
+    "left": "right",
+    "right": "left",
+}
+
+ARROW_MASKS = {
+    "up": np.array(
+        [
+            [1, 1, 1],
+            [0, 1, 0],
+            [0, 1, 0],
+        ],
+        dtype=bool,
+    ),
+    "down": np.array(
+        [
+            [0, 1, 0],
+            [0, 1, 0],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    ),
+    "left": np.array(
+        [
+            [1, 0, 0],
+            [1, 1, 1],
+            [1, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    "right": np.array(
+        [
+            [0, 0, 1],
+            [1, 1, 1],
+            [0, 0, 1],
+        ],
+        dtype=bool,
+    ),
+}
