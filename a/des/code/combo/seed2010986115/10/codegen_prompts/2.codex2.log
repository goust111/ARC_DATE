+
+def _monochrome_components(grid: np.ndarray, color: int) -> list[dict]:
+    comps = []
+    for coords in _components(grid == int(color)):
+        comps.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": _bbox_from_coords(coords),
+                "area": int(coords.shape[0]),
+                "mask": _tight_mask(coords),
+            }
+        )
+    return comps
+
