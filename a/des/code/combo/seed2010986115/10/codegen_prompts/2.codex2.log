+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+ARROW = 9
+PALETTE = [1, 2, 3, 4, 6, 7, 8]
+
+SIDE_FROM_DIR = {
+    "up": "bottom",
+    "down": "top",
+    "left": "right",
+    "right": "left",
+}
+
+ARROW_MASKS = {
+    "up": np.array(
