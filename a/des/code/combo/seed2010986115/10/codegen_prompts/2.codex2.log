+            p1 = (fr1 + 1, fc0 + s0 - 1)
+            p2 = (fr1 + 1, fc0 + s1 + 1)
+        elif side == "left":
+            opening = sorted(int(r) for r in coords[coords[:, 1] == 0, 0])
+            s0, s1 = opening[0], opening[-1]
+            p1 = (fr0 + s0 - 1, fc0 - 1)
+            p2 = (fr0 + s1 + 1, fc0 - 1)
+        else:
+            opening = sorted(int(r) for r in coords[coords[:, 1] == crop.shape[1] - 1, 0])
