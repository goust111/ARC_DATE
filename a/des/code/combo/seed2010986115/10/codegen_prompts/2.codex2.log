+    W = random.randint(outer_w + 16, min(30, outer_w + 18))
+    fr0 = random.randint(8, H - outer_h - 8)
+    fc0 = random.randint(8, W - outer_w - 8)
+    fr1 = fr0 + outer_h - 1
+    fc1 = fc0 + outer_w - 1
