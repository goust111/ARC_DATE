+
+def _orient_shape(base: np.ndarray, side: str) -> np.ndarray:
+    if side == "top":
+        return base.copy()
+    if side == "bottom":
+        return np.flipud(base)
+    if side == "left":
+        return base.T
+    return np.fliplr(base.T)
