+        touch = set()
+        if np.any(coords[:, 0] == 0):
+            touch.add("top")
+        if np.any(coords[:, 0] == crop.shape[0] - 1):
+            touch.add("bottom")
+        if np.any(coords[:, 1] == 0):
+            touch.add("left")
+        if np.any(coords[:, 1] == crop.shape[1] - 1):
+            touch.add("right")
