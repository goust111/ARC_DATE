+    used_slots: set[int] = set()
+    assignments: list[tuple[dict, dict]] = []
+    for arrow, piece in arrow_piece_pairs:
+        need_side = SIDE_FROM_DIR[arrow["direction"]]
+        candidates = []
+        for idx, slot in enumerate(slots):
