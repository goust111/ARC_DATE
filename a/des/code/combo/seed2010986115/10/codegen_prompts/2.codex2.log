+
+    n_slots = len(slot_specs)
+    piece_colors = random.sample(PALETTE, n_slots)
+    filter_colors = piece_colors[1:] + piece_colors[:1]
+    random.shuffle(slot_specs)
+    for idx, spec in enumerate(slot_specs):
