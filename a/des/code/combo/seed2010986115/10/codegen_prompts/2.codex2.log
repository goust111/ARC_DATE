+    slots = _extract_slots(g, bg, frame_color)
+    pieces: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) not in {int(bg), int(frame_color), int(arrow_color)}):
+        for comp in _monochrome_components(g, color):
+            if int(comp["area"]) > 1:
