+def _slot_cells(side: str, fr0: int, fc0: int, fr1: int, fc1: int, start: int, mask: np.ndarray) -> list[tuple[int, int]]:
+    sh, sw = mask.shape
+    cells = []
+    if side == "top":
+        rr_base, cc_base = fr0, fc0 + start
+    elif side == "bottom":
+        rr_base, cc_base = fr1 - sh + 1, fc0 + start
+    elif side == "left":
