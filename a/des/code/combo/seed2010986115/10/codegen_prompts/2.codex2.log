+            elif direction == "up" and pr1 < ar0 and _intervals_overlap(pc0, pc1, ac0, ac1):
+                score = ar0 - pr1
+            elif direction == "right" and pc0 > ac1 and _intervals_overlap(pr0, pr1, ar0, ar1):
+                score = pc0 - ac1
