+
+def _is_arrow_like(mask: np.ndarray) -> bool:
+    return _arrow_direction(mask) is not None
+
+
+def _generate_base_shape(depth: int, width: int) -> np.ndarray:
+    cells = {(0, c) for c in range(width)}
