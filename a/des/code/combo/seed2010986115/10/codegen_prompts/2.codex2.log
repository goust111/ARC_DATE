+def _pair_arrows_to_pieces(arrows: list[dict], pieces: list[dict]) -> list[tuple[dict, dict]]:
+    unused = set(range(len(pieces)))
+    pairs: list[tuple[dict, dict]] = []
+    for arrow in arrows:
+        ar0, ac0, ar1, ac1 = arrow["bbox"]
+        best = None
+        for idx in list(unused):
+            piece = pieces[idx]
