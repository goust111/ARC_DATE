+        for r, c in list(cells):
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < depth and 0 <= nc < width and (nr, nc) not in cells:
+                    frontier.append((nr, nc))
+        frontier = sorted(set(frontier))
+        if not frontier:
