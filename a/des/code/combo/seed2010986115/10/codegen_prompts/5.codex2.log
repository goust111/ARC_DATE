+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+PATTERN_COLORS = (GREY, MAROON)
+FRAME_COLOR_POOL = (1, 2, 3, 4, 6, 7, 8)
+
+PATTERN_SIZE_MIN = 2
+PATTERN_SIZE_MAX = 5
+INNER_PADDING_MIN = 0
+INNER_PADDING_MAX = 2
+MIN_LAYERS = 2
+MAX_LAYERS = 4
