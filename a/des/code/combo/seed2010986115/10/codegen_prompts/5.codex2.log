+        inner_bbox = frames[depth]["bbox"]  # type: ignore[index]
+        outer_bbox = frames[depth + 1]["bbox"]  # type: ignore[index]
+        for r, c in _gap_slots(inner_bbox, outer_bbox, current.shape):
+            h, w = current.shape
+            out[r : r + h, c : c + w] = current
+
