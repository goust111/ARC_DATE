import numpy as np

def normalize(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    r0=min(rs); c0=min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in coords))

def rot(coords):
    # rotate 90 clockwise around origin then normalize
    arr=[(c,-r) for r,c in coords]
    return normalize(arr)

def direction(coords):
    a=np.array(coords,float)
    center=a.mean(axis=0)
    vecs=a-center
    d2=np.sum(vecs*vecs,axis=1)
    m=d2.max()
    idxs=[i for i,v in enumerate(d2) if abs(v-m)<1e-9]
    # choose farthest lexicographically largest row,col
    pick=max(idxs,key=lambda i:(a[i,0],a[i,1]))
    dr,dc=vecs[pick]
    if abs(dr)>=abs(dc):
        return ('D' if dr>=0 else 'U'), abs(dr), abs(dc), tuple(a[pick]), tuple(center)
    return ('R' if dc>=0 else 'L'), abs(dr), abs(dc), tuple(a[pick]), tuple(center)

