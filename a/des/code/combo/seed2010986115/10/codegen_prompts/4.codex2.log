+OBJECT_COUNT_LARGE = (3, 4)
+LARGE_GRID_AREA = 260
+
+MAX_SCENE_ATTEMPTS = 400
+MAX_OBJECT_ATTEMPTS = 120
+MAX_PLACEMENT_ATTEMPTS = 120
