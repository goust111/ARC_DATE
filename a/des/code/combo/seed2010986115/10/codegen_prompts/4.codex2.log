+def _trajectory_cells(template: Template, top: int, left: int, visible_layers: int) -> set[Coord]:
+    coords = np.asarray(template["coords"], dtype=int)
+    span = int(template["span"])
+    step_r, step_c = template["step"]
+    cells: set[Coord] = set()
+
