+            lane = [(r, cc), (r + 1, cc)]
+            if any(bool(mask[lr, lc]) for lr, lc in lane):
+                return cells, True
+            cells.extend(lane)
+        return cells, False
+
+    raise ValueError(direction)
+
+
+def _render_output_from_towers(grid: np.ndarray, towers: list[dict]) -> np.ndarray:
