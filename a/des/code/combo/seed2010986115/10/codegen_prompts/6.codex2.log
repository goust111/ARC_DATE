+def _side_cells(r: int, c: int, direction: str) -> list[tuple[int, int]]:
+    if direction == "up":
+        return [(r - 1, c), (r - 1, c + 1)]
+    if direction == "down":
+        return [(r + 2, c), (r + 2, c + 1)]
+    if direction == "left":
+        return [(r, c - 1), (r + 1, c - 1)]
+    if direction == "right":
