+    grid = _build_grid((h, w), towers)
+    if grid is None:
+        return None
+
+    if not _has_intersection(towers, (h, w)):
+        return None
+
+    ray_sets, blocked_any = _ray_sets(towers, (h, w))
+    if want_blocker and not blocked_any:
+        return None
+
+    active_dirs = sum(len(tower["dirs"]) for tower in towers)
+    if active_dirs < 3:
+        return None
+
+    out = main(grid)
