+def _cast_ray(
+    h: int,
+    w: int,
+    tower: dict,
+    direction: str,
+    mask: np.ndarray,
+) -> tuple[list[tuple[int, int]], bool]:
+    r = int(tower["r"])
+    c = int(tower["c"])
+    cells: list[tuple[int, int]] = []
+
+    if direction == "up":
+        for rr in range(r - 1, -1, -1):
+            lane = [(rr, c), (rr, c + 1)]
+            if any(bool(mask[lr, lc]) for lr, lc in lane):
+                return cells, True
+            cells.extend(lane)
+        return cells, False
