+    ac = int(base_a["c"])
+    br = int(base_b["r"])
+    bc = int(base_b["c"])
+    min_c = min(ac, bc)
+    max_c = max(ac, bc)
+    min_r = min(ar, br)
+    max_r = max(ar, br)
+
+    if r == ar and max(c, min_c) <= min(c + 1, max_c + 1):
+        return False
+    if c == bc and max(r, min_r) <= min(r + 1, max_r + 1):
+        return False
