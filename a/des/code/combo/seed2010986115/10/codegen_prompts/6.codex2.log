+def _detect_towers(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    used = np.zeros_like(g, dtype=bool)
+    towers: list[dict] = []
+
+    for r in range(h - 1):
+        for c in range(w - 1):
