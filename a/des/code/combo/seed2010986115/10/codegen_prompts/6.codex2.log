+def _read_dirs(grid: np.ndarray, r: int, c: int) -> tuple[str, ...]:
+    h, w = grid.shape
+    active: list[str] = []
+    for direction in DIRS:
+        cells = _side_cells(r, c, direction)
+        if any(_in_bounds(h, w, rr, cc) and int(grid[rr, cc]) == MARKER for rr, cc in cells):
+            active.append(direction)
+    return tuple(active)
+
