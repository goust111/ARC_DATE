+
+    marker_count = int(np.count_nonzero(grid == MARKER))
+    if marker_count != active_dirs:
+        return None
+
+    overlap_cells = 0
+    for i in range(len(ray_sets)):
+        for j in range(i + 1, len(ray_sets)):
+            overlap_cells += len(ray_sets[i] & ray_sets[j])
+    if overlap_cells == 0:
+        return None
+
+    return grid
