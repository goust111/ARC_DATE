+
+def _make_region(rect_h: int, rect_w: int) -> np.ndarray:
+    for _ in range(200):
+        region = np.full((rect_h, rect_w), GREY, dtype=int)
+        color_count = random.randint(2, min(4, len(PALETTE)))
