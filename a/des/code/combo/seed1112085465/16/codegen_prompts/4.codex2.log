+GREY = 5
+PALETTE = tuple(color for color in range(10) if color not in {BG, GREY})
+
+
+TOP_TEMPLATES = (
+    ((0, 0), (0, 1)),
+    ((0, 0), (0, 1), (0, 2)),
+    ((0, 0), (0, 1), (-1, 1)),
+)
+BOTTOM_TEMPLATES = (
+    ((0, 0), (0, 1)),
+    ((0, 0), (0, 1), (0, 2)),
+    ((0, 0), (0, 1), (1, 0)),
+)
+LEFT_TEMPLATES = (
+    ((0, 0), (1, 0)),
+    ((0, 0), (1, 0), (2, 0)),
+    ((0, 0), (1, 0), (1, -1)),
+)
+RIGHT_TEMPLATES = (
+    ((0, 0), (1, 0)),
+    ((0, 0), (1, 0), (2, 0)),
+    ((0, 0), (1, 0), (0, 1)),
+)
+CONTROL_TEMPLATES = {
+    "top": TOP_TEMPLATES,
+    "bottom": BOTTOM_TEMPLATES,
+    "left": LEFT_TEMPLATES,
+    "right": RIGHT_TEMPLATES,
+}
