+    top = _round_half_up(r0 + (h - h * scale) / 2.0)
+    left = _round_half_up(c0 + (w - w * scale) / 2.0)
+
+    pixels: list[tuple[int, int]] = []
+    for pr, pc in np.argwhere(mask):
+        base_r = top + int(pr) * scale
+        base_c = left + int(pc) * scale
