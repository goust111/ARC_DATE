+    h, w = g.shape
+    for obj, scale in parsed:
+        for r, c in _scaled_pixels(obj["mask"], obj["bbox"], scale):
+            if 0 <= r < h and 0 <= c < w and int(out[r, c]) == BACKGROUND:
+                out[r, c] = TARGET
+    return out
