+        "bbox": bbox,
+        "scale": scale,
+        "target": target_abs,
+        "maroons": maroons_abs,
+        "gaps": gaps_abs,
+        "structure": structure_abs,
+        "scaled": scaled_abs,
+    }
+
+
+def _touches_blocked(spec: dict, blocked: set[tuple[int, int]]) -> bool:
+    return any(cell in blocked for cell in spec["structure"])
