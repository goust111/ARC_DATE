+GRID_H_RANGE = (18, 27)
+GRID_W_RANGE = (18, 27)
+OBJECT_COUNT_RANGE = (2, 5)
+MAX_SHAPE_SIDE = 3
+MAX_SHAPE_AREA = 5
+PLACE_TRIES = 120
+POSITION_TRIES = 160
