+MIN_GRID_SIZE = 18
+MAX_GRID_SIZE = 30
+MIN_FRAME_COUNT = 1
+MAX_FRAME_COUNT = 4
+FRAME_SIDES = (6, 8, 10, 12, 14)
+OUTER_MARGIN = 1
+FRAME_GAP = 2
+PLACE_TRIES_PER_FRAME = 100
+MAX_GENERATION_ATTEMPTS = 300
