+            continue
+        if not bool((patch[:, 0] == FRAME_COLOR).all()):
+            continue
+        if not bool((patch[:, -1] == FRAME_COLOR).all()):
+            continue
+        if bool((patch[1:-1, 1:-1] == FRAME_COLOR).any()):
+            continue
