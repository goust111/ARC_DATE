+    for row_idx, row_panels in enumerate(rows):
+        for col_idx, panel in enumerate(row_panels):
+            r0 = row_idx * (panel_height + 1)
+            c0 = col_idx * (panel_width + 1)
+            grid[r0 : r0 + panel_height, c0 : c0 + panel_width] = panel
