+    inp = _render_grid(input_rows, GREY)
+    out = _render_grid(output_rows, GREY)
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        inp, expected = _generate_case()
+        try:
+            actual = main(inp)
+        except AssertionError:
