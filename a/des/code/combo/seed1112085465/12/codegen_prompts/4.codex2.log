+import numpy as np
+
+
+BG = 8
+RING = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 9)
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+SCAN_START = {
+    "up": (-1, 1),
+    "right": (1, 3),
+    "down": (3, 1),
+    "left": (1, -1),
+}
+MAX_ATTEMPTS = 400
+
+
+def _build_specs():
+    base_u = np.array(
+        [
+            [0, 0, 0],
+            [1, 0, 1],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    )
+    base_c = np.array(
+        [
+            [1, 0, 1],
+            [1, 0, 1],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    )
+    specs = []
+    mask_to_spec = {}
+    for kind, base in (("u", base_u), ("c", base_c)):
+        for turns, direction in enumerate(("up", "right", "down", "left")):
+            mask = np.rot90(base, -turns)
+            spec = {
+                "kind": kind,
+                "direction": direction,
+                "mask": mask,
+                "fill": [tuple(map(int, p)) for p in np.argwhere(~mask)],
+            }
+            key = tuple(mask.astype(int).ravel())
+            specs.append(spec)
+            mask_to_spec[key] = spec
+    return specs, mask_to_spec
