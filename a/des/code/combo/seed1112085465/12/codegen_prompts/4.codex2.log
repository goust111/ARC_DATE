+def _find_marker(grid: np.ndarray, r0: int, c0: int, direction: str):
+    h, w = grid.shape
+    dr, dc = DIRS[direction]
+    sr, sc = SCAN_START[direction]
+    rr, cc = r0 + sr, c0 + sc
