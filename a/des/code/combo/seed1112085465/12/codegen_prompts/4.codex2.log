+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((cr, cc))
+            for dr, dc in DIRS.values():
+                nr, nc = cr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
