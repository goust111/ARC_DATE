+def _extract_tool(comp: dict) -> dict:
+    cells = [(int(r), int(c)) for r, c in comp["cells"]]
+    r0, c0, _r1, _c1 = _bbox(cells)
+    local = [(r - r0, c - c0) for r, c in cells]
+    shape = _normalize(local)
+    return {
+        "kind": "tool",
+        "color": int(comp["color"]),
+        "cells": cells,
+        "shape": shape,
+        "rotations": _rotations(shape),
+    }
