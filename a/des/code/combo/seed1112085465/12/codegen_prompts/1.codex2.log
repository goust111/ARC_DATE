+        tool = tools[ti]
+        notch_set = set(workpiece["notch_cells"])
+        for r, c in workpiece["notch_cells"]:
+            out[r, c] = workpiece["color"]
+        for r, c in workpiece["notch_cells"]:
+            if any((r + dr, c + dc) in workpiece["cell_set"] for dr, dc in DIRS4):
+                out[r, c] = tool["color"]
+
+    return out
+
