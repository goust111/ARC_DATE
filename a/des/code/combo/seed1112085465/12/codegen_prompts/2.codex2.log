+    r0, c0, r1, c1 = _bbox(coords)
+    if (r1 - r0, c1 - c0) != (1, 1):
+        return False
+    cells = {(int(r), int(c)) for r, c in coords}
+    return cells == {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
