+                reverse=True,
+            )
+            cell = random.choice(choices[: max(1, min(4, len(choices)))])
+        else:
+            cell = random.choice(choices)
+        frontier.discard(cell)
+        cells.add(cell)
+        add_frontier(*cell)
+
