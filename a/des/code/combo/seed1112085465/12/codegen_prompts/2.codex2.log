+    if mode == "all_on":
+        return [True] * count
+    if mode == "all_off":
+        return [False] * count
+
+    on_count = random.randint(1, count - 1)
+    states = [False] * count
+    for idx in random.sample(range(count), on_count):
+        states[idx] = True
+    return states
