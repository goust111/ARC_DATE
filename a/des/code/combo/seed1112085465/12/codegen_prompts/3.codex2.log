                occupied, rect, transparent=0, border=PLACEMENT_BORDER
            )
            occupied[r0 : r0 + h, c0 : c0 + w] = 1
            paste(grid, patch, r0, c0, transparent=bg)
    except ValueError:
        return None
    return grid


def _solves_to_expected(grid: np.ndarray, expected: np.ndarray) -> bool:
    try:
