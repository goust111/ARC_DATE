+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
