+    top_max = height - shape_h
+    left_min = 0
+    left_max = width - shape_w
+
+    if side == "left":
+        left_min = max(left_min, gap - ac)
+    elif side == "right":
+        left_max = min(left_max, width - 1 - ac - gap)
+    elif side == "up":
