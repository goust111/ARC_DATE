+    cols = [c for _, c in cells]
+    r0, c0 = min(rows), min(cols)
+    cells = {(r - r0, c - c0) for r, c in cells}
+    h = max(r for r, _ in cells) + 1
+    w = max(c for _, c in cells) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
