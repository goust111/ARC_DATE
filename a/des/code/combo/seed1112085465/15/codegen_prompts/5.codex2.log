+def _find_positions(blocked: np.ndarray, mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    mh, mw = mask.shape
+    positions = []
+    for r0 in range(1, h - mh):
+        for c0 in range(1, w - mw):
+            if blocked[r0 - 1 : r0 + mh + 1, c0 - 1 : c0 + mw + 1].any():
+                continue
+            positions.append((r0, c0))
+    return positions
+
