+    seen = {start}
+    pts: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        pts.append((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
