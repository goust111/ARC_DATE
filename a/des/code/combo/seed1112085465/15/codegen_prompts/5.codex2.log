+def _render_expected(
+    grid: np.ndarray,
+    legend_bbox: tuple[int, int, int, int],
+    objects: list[tuple[int, int, np.ndarray]],
+    c_border: int,
+    c_interior: int,
+) -> np.ndarray:
+    out = grid.copy()
+    r0, c0, r1, c1 = legend_bbox
+    out[r0 : r1 + 1, c0 : c1 + 1] = BG
+    for top, left, mask in objects:
