+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    comp = _component_from_seed(mask, tuple(map(int, pts[0])))
+    return len(comp) == int(mask.sum())
