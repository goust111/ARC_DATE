+            or (start == (0, w - 1) and r0 == 0 and c0 == w - 2 and c1 == w - 1)
+            or (start == (h - 1, 0) and r1 == h - 1 and c0 == 0 and c1 == 1)
+            or (start == (h - 1, w - 1) and r1 == h - 1 and c0 == w - 2 and c1 == w - 1)
