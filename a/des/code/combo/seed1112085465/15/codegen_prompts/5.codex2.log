+def _mark_blocked(blocked: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    hh, ww = blocked.shape
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(hh, r0 + h + 1)
+    cc1 = min(ww, c0 + w + 1)
+    blocked[rr0:rr1, cc0:cc1] = True
+
