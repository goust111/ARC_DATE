+def _random_polyomino(rng: random.Random) -> np.ndarray:
+    target = rng.randint(4, 9)
+    cells = {(0, 0)}
+    while len(cells) < target:
+        frontier = []
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if -4 <= nr <= 4 and -4 <= nc <= 4 and (nr, nc) not in cells:
+                    frontier.append((nr, nc))
