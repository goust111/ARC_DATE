+def _find_legend_bbox(grid: np.ndarray, bg: int, grey: int) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    mask = grid != bg
+    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+    candidates: list[tuple[int, int, int, int]] = []
