+        distinct_orders.add(order)
+        if any((end - start) not in {1, 2, 3} for start, end, _color in segments):
+            return False
+
+    return query_rows >= 2 and len(distinct_orders) >= 1
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
