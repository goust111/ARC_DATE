+from __future__ import annotations
+
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BACKGROUND = 0
+SEPARATOR = 9
+CONTENT_COLORS = tuple(range(1, 9))
+
+MAX_GRID_SIZE = 30
+MAX_GENERATION_ATTEMPTS = 400
+
+PANEL_ROW_RANGE = (3, 5)
+PANEL_COL_RANGE = (2, 4)
+PANEL_HEIGHT_RANGE = (3, 6)
+PANEL_WIDTH_RANGE = (3, 7)
