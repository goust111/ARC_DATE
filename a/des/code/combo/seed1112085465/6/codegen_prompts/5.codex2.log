+    out[r0, c0 : c1 + 1] = color
+    out[r1, c0 : c1 + 1] = color
+    out[r0 : r1 + 1, c0] = color
+    out[r0 : r1 + 1, c1] = color
+    for rr, cc in node.get("tabs", []):
+        out[rr, cc] = color
+
+    for child in node["children"]:
+        _paint_node(inp, out, child, depth + 1)
