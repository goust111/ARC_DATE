+            box_w = random.randint(node["min_w"], max_w)
+            r0 = random.randint(0, height - box_h)
+            c0 = random.randint(0, width - box_w)
+            bbox = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+            if any(_boxes_too_close(bbox, other, ROOT_GAP) for other in placed):
+                continue
+            node["bbox"] = bbox
+            placed.append(bbox)
