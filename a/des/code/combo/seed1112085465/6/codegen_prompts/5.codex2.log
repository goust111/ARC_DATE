+    inp[r0, c0 : c1 + 1] = INPUT_COLOR
+    inp[r1, c0 : c1 + 1] = INPUT_COLOR
+    inp[r0 : r1 + 1, c0] = INPUT_COLOR
+    inp[r0 : r1 + 1, c1] = INPUT_COLOR
+    for rr, cc in node.get("tabs", []):
+        inp[rr, cc] = INPUT_COLOR
