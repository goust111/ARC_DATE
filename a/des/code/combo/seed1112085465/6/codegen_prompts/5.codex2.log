+        node["min_w"] = sum(child["min_w"] for child in children) + SIBLING_GAP + 2 * MARGIN_TO_CHILD
+    else:
+        node["min_h"] = sum(child["min_h"] for child in children) + SIBLING_GAP + 2 * MARGIN_TO_CHILD
