+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+INPUT_COLOR = 5
+DEPTH_COLORS = (1, 2, 3, 4)  # blue, red, green, yellow
+
+MARGIN_TO_CHILD = 2
+SIBLING_GAP = 2
+ROOT_GAP = 2
+LEAF_MIN_SIZE = 4
+LEAF_MAX_SIZE = 8
