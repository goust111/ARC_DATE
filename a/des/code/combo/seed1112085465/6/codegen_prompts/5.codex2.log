+def _sample_tree(depth_left: int) -> dict:
+    node: dict[str, object] = {"children": []}
+    if depth_left > 1:
+        child_count = random.choices([1, 2], weights=[3, 2], k=1)[0]
+        deep_idx = random.randrange(child_count)
+        children = []
