+    depths = [-1] * len(parts)
+
+    def visit(idx: int) -> int:
+        if depths[idx] != -1:
+            return depths[idx]
+        parent = parents[idx]
+        depths[idx] = 0 if parent == -1 else visit(parent) + 1
+        assert depths[idx] < len(DEPTH_COLORS), "nesting depth exceeds supported palette"
+        return depths[idx]
+
+    for i in range(len(parts)):
+        visit(i)
+    return depths
