+    ic0 = c0 + MARGIN_TO_CHILD
+    inner_h = r1 - r0 + 1 - 2 * MARGIN_TO_CHILD
+    inner_w = c1 - c0 + 1 - 2 * MARGIN_TO_CHILD
+    if inner_h <= 0 or inner_w <= 0:
+        return False
