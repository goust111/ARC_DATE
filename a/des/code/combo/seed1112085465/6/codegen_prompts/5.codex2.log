+def _strictly_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    return (
+        outer[0] < inner[0]
+        and outer[1] < inner[1]
+        and inner[2] < outer[2]
+        and inner[3] < outer[3]
+    )
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    return (bbox[2] - bbox[0] + 1) * (bbox[3] - bbox[1] + 1)
