+def _components(mask: np.ndarray) -> list[dict[str, np.ndarray | tuple[int, int, int, int] | int]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts = []
+    for r in range(h):
