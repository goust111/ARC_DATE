+        box_w = random.randint(child["min_w"], inner_w)
+        child_r0 = ir0 + random.randint(0, inner_h - box_h)
+        child_c0 = ic0 + random.randint(0, inner_w - box_w)
+        child["bbox"] = (child_r0, child_c0, child_r0 + box_h - 1, child_c0 + box_w - 1)
