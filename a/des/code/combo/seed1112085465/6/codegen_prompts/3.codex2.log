+
+def neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def discrete_center_top_left(shape: tuple[int, int], center: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    return center[0] - (h - 1) // 2, center[1] - (w - 1) // 2
+
+
+def scaled_visible_mask(
+    local_mask: np.ndarray,
+    scale: int,
+    center: tuple[int, int],
+    grid_shape: tuple[int, int],
+) -> np.ndarray:
+    scaled = np.kron(local_mask.astype(bool), np.ones((scale, scale), dtype=bool))
+    top, left = discrete_center_top_left(scaled.shape, center)
+    h, w = grid_shape
+    visible = np.zeros((h, w), dtype=bool)
+    for rr, cc in np.argwhere(scaled):
+        gr = top + int(rr)
+        gc = left + int(cc)
+        if 0 <= gr < h and 0 <= gc < w:
+            visible[gr, gc] = True
+    return visible
+
+
+def exterior_reachable(obj_mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(obj_mask)
+    r0, c0, r1, c1 = bbox_from_coords(coords)
+    local = np.zeros((r1 - r0 + 3, c1 - c0 + 3), dtype=bool)
+    local[1:-1, 1:-1] = obj_mask[r0 : r1 + 1, c0 : c1 + 1]
+    passable = ~local
+    seen = np.zeros_like(local, dtype=bool)
+    queue = deque()
+    for r in range(local.shape[0]):
+        for c in range(local.shape[1]):
+            if r not in (0, local.shape[0] - 1) and c not in (0, local.shape[1] - 1):
+                continue
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    while queue:
+        cr, cc = queue.popleft()
+        for nr, nc in neighbors4(cr, cc, local.shape[0], local.shape[1]):
+            if passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+    out = np.zeros_like(obj_mask, dtype=bool)
+    out[r0 : r1 + 1, c0 : c1 + 1] = seen[1:-1, 1:-1]
+    return out
+
+
+def extract_entities(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    h, w = g.shape
+    coord_to_object: dict[tuple[int, int], int] = {}
+    objects: list[dict[str, object]] = []
+    for color in np.unique(g):
+        color = int(color)
+        if color in (BG, MARKER):
+            continue
+        for comp in components(g == color):
+            obj_mask = np.zeros((h, w), dtype=bool)
+            obj_mask[comp[:, 0], comp[:, 1]] = True
+            for r, c in comp:
+                coord_to_object[(int(r), int(c))] = len(objects)
+            objects.append(
+                {
+                    "color": color,
+                    "mask": obj_mask,
+                    "local_mask": crop_mask(obj_mask),
+                    "markers": [],
+                    "exterior": exterior_reachable(obj_mask),
+                }
+            )
