+            choice_idx = rng.choice(len(candidates), size=scale, replace=False)
+            markers = [candidates[int(idx)] for idx in np.atleast_1d(choice_idx)]
+            marker_mask = np.zeros((h, w), dtype=bool)
+            for r, c in markers:
