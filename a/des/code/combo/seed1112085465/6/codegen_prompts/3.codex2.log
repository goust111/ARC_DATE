+
+def local_boundary_candidates(local_mask: np.ndarray, top_left: tuple[int, int], grid_shape: tuple[int, int]):
+    top, left = top_left
+    h, w = grid_shape
+    cells = {
+        (top + int(r), left + int(c))
+        for r, c in np.argwhere(local_mask)
