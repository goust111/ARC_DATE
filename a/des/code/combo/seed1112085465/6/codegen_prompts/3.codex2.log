from __future__ import annotations

from collections import deque

import numpy as np


BG = 0
MARKER = 2
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]

GEN_ATTEMPTS = 500
GRID_BASE_RANGE = (18, 24)
GRID_EXTRA_PER_OBJECT = 3
