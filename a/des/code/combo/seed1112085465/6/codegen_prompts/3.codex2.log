+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc, h, w):
