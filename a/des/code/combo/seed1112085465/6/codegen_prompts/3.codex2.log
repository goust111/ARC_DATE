+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
+    return out
+
+
+def try_place_object(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    blocked_input: np.ndarray,
+    output_occ: np.ndarray,
+    scale: int,
+    color: int,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    h, w = grid.shape
+    local = random_shape(rng, scale)
+
+    for _ in range(120):
