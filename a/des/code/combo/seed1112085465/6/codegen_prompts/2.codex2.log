+
+    counts = np.bincount(grid.ravel(), minlength=10)
+    if int(np.argmax(counts)) != _BG:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    return grid
