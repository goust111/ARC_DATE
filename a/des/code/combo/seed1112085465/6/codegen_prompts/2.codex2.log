+def _gen_attempt() -> np.ndarray | None:
+    n_frames = int(_RNG.integers(*_FRAME_COUNT_RANGE))
+    patches: list[np.ndarray] = []
+    for _ in range(n_frames):
+        patch = _make_frame_patch()
+        if patch is None:
+            return None
+        patches.append(patch)
