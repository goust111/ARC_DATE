+    r1, c1 = coords.max(axis=0)
+    trimmed = arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+    marker = tuple(map(int, np.argwhere(trimmed == 2)[0]))
+    return trimmed > 0, marker
