+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BG_COLOR = 8
+COLORS = tuple(range(10))
+GENERATION_ATTEMPTS = 400
+GRID_HEIGHT_RANGE = (18, 30)
+GRID_WIDTH_RANGE = (18, 30)
+PAIR_COUNT_RANGE = (2, 4)
+PAIR_SHAPE_TRIES = 80
+PLACEMENT_TRIES = 400
+OBJECT_PADDING = 1
+
+SHAPE_TEMPLATES = (
+    (
+        ".#.",
+        "#M#",
+        ".#.",
+    ),
+    (
+        "###",
+        "#M#",
+        "###",
+    ),
+    (
+        "###",
+        ".M.",
+        ".#.",
+    ),
+    (
+        ".#.",
