+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+MAROON = 9
+GREY = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_H_RANGE = (10, 20)
+GRID_W_RANGE = (10, 20)
+MAX_RECT_DIM = 7
+GEN_RETRIES = 400
