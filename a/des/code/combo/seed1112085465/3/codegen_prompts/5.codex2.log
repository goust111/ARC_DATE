+        rect_h, rect_w, positions = random.choice(dims)
+        r0, c0 = random.choice(positions)
+        r1 = r0 + rect_h - 1
+        c1 = c0 + rect_w - 1
+        used[r0 : r1 + 1, c0 : c1 + 1] = True
+        rectangles.append((int(color), r0, c0, r1, c1))
+
+    inp = _checkerboard((height, width), even_color, odd_color)
