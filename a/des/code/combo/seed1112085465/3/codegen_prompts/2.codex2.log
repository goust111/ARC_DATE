+def _segments_between(limit: int, separators: list[int]) -> list[tuple[int, int]]:
+    runs = _group_runs(separators)
+    if not runs:
+        return [(0, limit - 1)]
+
+    spans: list[tuple[int, int]] = []
+    cursor = 0
+    for start, end in runs:
+        if cursor <= start - 1:
+            spans.append((cursor, start - 1))
+        cursor = end + 1
+    if cursor <= limit - 1:
+        spans.append((cursor, limit - 1))
+    return spans
