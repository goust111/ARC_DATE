    out_height = sum(int(obj["sprite"].shape[0]) for obj in objects) + count - 1
    max_width = max(int(obj["sprite"].shape[1]) for obj in objects)
    if out_height > MAX_OUTPUT_HEIGHT or max_width > MAX_GRID_SIDE:
