    return _make_frame(h, w)


def _sample_objects() -> list[dict[str, object]] | None:
    count = int(_RNG.integers(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX_EXCLUSIVE))
    branches = ["wide", "tall", "square"]
    for _ in range(count - 3):
