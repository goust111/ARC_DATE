+def _sample_dims(branch: str) -> tuple[int, int]:
+    if branch == "wide":
+        h = int(_RNG.integers(1, 4))
+        w = int(_RNG.integers(h + 1, min(h + 5, 8)))
+        return h, w
+    if branch == "tall":
+        w = int(_RNG.integers(1, 4))
+        h = int(_RNG.integers(w + 1, min(w + 5, 8)))
+        return h, w
+    side = int(_RNG.integers(2, 6))
+    return side, side
