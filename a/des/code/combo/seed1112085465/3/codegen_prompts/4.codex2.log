    out = np.full((out_h, out_w), BG, dtype=int)

    row = 0
    for sprite in sprites:
        h, w = sprite.shape
        col = _alignment_col(out_w, w, h)
        window = out[row : row + h, col : col + w]
        mask = sprite != BG
        window[mask] = sprite[mask]
        row += h + 1
    return out


