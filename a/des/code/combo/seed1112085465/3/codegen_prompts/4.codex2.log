    return np.ones((h, w), dtype=bool)


def _make_l(h: int, w: int, corner: str) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    if corner == "tl":
        mask[0, :] = True
        mask[:, 0] = True
    elif corner == "tr":
        mask[0, :] = True
        mask[:, -1] = True
    elif corner == "bl":
        mask[-1, :] = True
        mask[:, 0] = True
    else:
        mask[-1, :] = True
        mask[:, -1] = True
    return mask


def _make_t(h: int, w: int, side: str) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    if side == "up":
        mask[0, :] = True
        mask[:, w // 2] = True
    elif side == "down":
        mask[-1, :] = True
        mask[:, w // 2] = True
    elif side == "left":
        mask[:, 0] = True
        mask[h // 2, :] = True
    else:
        mask[:, -1] = True
        mask[h // 2, :] = True
    return mask


def _make_frame(h: int, w: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


