+            overlap_pair = (random.choice(bigger), random.choice(smaller))
+
+        grid_h = random.randint(*GRID_SIZE_RANGE)
+        grid_w = random.randint(*GRID_SIZE_RANGE)
+        placed = _place_specs(specs, grid_h, grid_w, overlap_pair)
