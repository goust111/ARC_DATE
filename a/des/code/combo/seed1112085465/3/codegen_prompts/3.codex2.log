+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        num_groups = random.choice((3, 4))
+        overlap_case = bool(random.getrandbits(1))
+        counts = _sample_counts(num_groups, overlap_case)
