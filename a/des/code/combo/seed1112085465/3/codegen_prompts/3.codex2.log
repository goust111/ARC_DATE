+                        break
+                    overlap_size = len(overlap)
+
+            if not ok:
+                continue
+
+            if overlap_pair is not None and idx in overlap_pair:
+                other = overlap_pair[0] if overlap_pair[1] == idx else overlap_pair[1]
+                if other in placed and overlap_size < MIN_OVERLAP_CELLS:
+                    continue
+
+            placed[idx] = {
+                "count": count,
+                "markers": markers,
+                "region": region,
+                "paint": paint,
