+    if len(colors) not in (3, 4):
+        return False
+
+    regions: dict[int, set[tuple[int, int]]] = {}
+    paint_sets: dict[int, set[tuple[int, int]]] = {}
+    counts: dict[int, int] = {}
+
+    for color in colors:
+        coords = [(int(r), int(c)) for r, c in np.argwhere(grid == color)]
+        if len(coords) not in (3, 4):
+            return False
