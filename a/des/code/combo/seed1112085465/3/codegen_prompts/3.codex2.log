+def _sample_counts(num_groups: int, overlap_case: bool) -> list[int]:
+    counts = [random.choice((3, 4)) for _ in range(num_groups)]
+    if overlap_case and len(set(counts)) == 1:
+        counts[random.randrange(num_groups)] = 7 - counts[0]
+    return counts
