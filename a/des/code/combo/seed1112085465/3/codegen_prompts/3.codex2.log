+import random
+
+import numpy as np
+
+
+BG_COLOR = 7
+FG_POOL = (1, 2, 3, 4, 5, 6, 8, 9)
+EPS = 1e-9
+
+GRID_SIZE_RANGE = (18, 30)
+GEN_RETRIES = 400
+SHAPE_RETRIES = 120
+PLACEMENT_MARGIN = 1
+MIN_PAINT_CELLS = 8
+MIN_OVERLAP_CELLS = 4
