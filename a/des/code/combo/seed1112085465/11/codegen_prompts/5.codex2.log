+                "own_count": int(len(pts)),
+                "bar_height": int(np.count_nonzero(region != bg)),
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "anchor": anchor,
+            }
+        )
+
+    records.sort(
+        key=lambda rec: (
+            -int(rec["own_count"]),
+            int(rec["anchor"][0]),
+            int(rec["anchor"][1]),
+            int(rec["bbox"][0]),
