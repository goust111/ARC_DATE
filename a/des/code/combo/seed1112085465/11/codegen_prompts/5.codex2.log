+
+def _validate_scene(
+    grid: np.ndarray,
+    colors: list[int],
+    counts: list[int],
+    rects: list[Rect],
+) -> bool:
+    records = _analyze_grid(grid, BG)
+    if len(records) != len(colors):
+        return False
+
+    bbox_by_color = {int(rec["color"]): rec["bbox"] for rec in records}
+    count_by_color = {int(rec["color"]): int(rec["own_count"]) for rec in records}
