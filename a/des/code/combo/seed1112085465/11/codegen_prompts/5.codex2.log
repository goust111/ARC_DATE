+                if prev_h < 3 or prev_w < 3:
+                    break
+                top_lo = prev[0] + 1
+                top_hi = prev[2] - 1
+                left_lo = prev[1] + 1
+                left_hi = prev[3] - 1
+                if top_lo > top_hi or left_lo > left_hi:
