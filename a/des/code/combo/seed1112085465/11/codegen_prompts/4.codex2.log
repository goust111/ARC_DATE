+def _orbit_adjacency(orbits: list[tuple[tuple[int, int], ...]]) -> list[set[int]]:
+    neighbors = [set() for _ in orbits]
+    for i, orbit_a in enumerate(orbits):
+        for j in range(i + 1, len(orbits)):
+            orbit_b = orbits[j]
+            touching = False
+            for r0, c0 in orbit_a:
+                for r1, c1 in orbit_b:
