+def _kind_of(mask: np.ndarray) -> str:
+    has_h = _has_horizontal_symmetry(mask)
+    has_v = _has_vertical_symmetry(mask)
+    if has_h and has_v:
+        return "HV"
+    if has_h:
+        return "H"
+    if has_v:
+        return "V"
+    return "A"
+
+
+def _connected(mask: np.ndarray) -> bool:
+    return len(_components(mask)) == 1
+
+
+def _grow_mask(
