+        for idx in selected:
+            for r, c in orbits[idx]:
+                mask[r, c] = True
+        mask = _trim_mask(mask)
+        if mask.shape[0] < 3 or mask.shape[1] < 3:
+            continue
+        if mask.sum() < 5 or not _connected(mask):
+            continue
+        return mask
+
+    return None
+
