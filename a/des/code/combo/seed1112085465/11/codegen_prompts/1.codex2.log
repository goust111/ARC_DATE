+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (16, 30)
+GRID_W_RANGE = (16, 30)
+CONTAINER_GAP = 2
+MAX_GEN_ATTEMPTS = 400
+PLACEMENT_TRIES = 100
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_bbox(grid: np.ndarray, comp: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    pts = np.array(comp, dtype=int)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    side_h = int(r1 - r0 + 1)
+    side_w = int(c1 - c0 + 1)
+    if side_h != side_w or side_h < 3:
+        return None
+
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((int(r0), int(c)))
+        expected.add((int(r1), int(c)))
+    for r in range(r0 + 1, r1):
+        expected.add((int(r), int(c0)))
+        expected.add((int(r), int(c1)))
+
+    if set(comp) != expected:
+        return None
+    if bool((grid[r0 + 1 : r1, c0 + 1 : c1] == FRAME).any()):
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    frames: list[tuple[int, int, int, int]] = []
+    for comp in _components(grid == FRAME):
+        bbox = _frame_bbox(grid, comp)
+        if bbox is not None:
+            frames.append(bbox)
+    frames.sort()
+    return frames
