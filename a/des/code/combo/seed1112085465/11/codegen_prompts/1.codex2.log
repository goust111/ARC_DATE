+    cells = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+    picks = rng.sample(cells, sum(counts))
+    cursor = 0
+    for color, count in zip(colors, counts):
+        for r, c in picks[cursor : cursor + count]:
