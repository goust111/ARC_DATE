+) -> bool:
+    h, w = grid.shape
+    mh, mw = mask.shape
+    pts = np.argwhere(mask)
+
+    if edge in ("left", "right"):
+        max_shift = (w - mw - 1) // 2
+        if max_shift < 1:
+            return False
+        orth_choices = _interior_choices(h, mh)
+        shifts = list(range(1, max_shift + 1))
+        rng.shuffle(orth_choices)
+        rng.shuffle(shifts)
+        for shift in shifts:
