+def _find_legend(grid: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    h, _ = grid.shape
+    candidates: list[tuple[int, np.ndarray]] = []
+    for pts in _components(grid != bg):
+        rows = pts[:, 0]
+        cols = pts[:, 1]
+        r0, r1 = int(rows.min()), int(rows.max())
