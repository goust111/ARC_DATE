+        box_w = c1 - c0 + 1
+        assert box_h != box_w
+        assert r0 > 0 and c0 > 0 and r1 < h - 1 and c1 < w - 1
+        if box_w > box_h:
+            assert c0 != w - 1 - c1
+        else:
+            assert r0 != h - 1 - r1
+        assert color in mapping
+
+    out = main(grid)
+    assert out.shape == grid.shape
+    assert np.any(out != grid)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_objects = rng.randint(2, 4)
+    h = rng.randint(13, 19)
