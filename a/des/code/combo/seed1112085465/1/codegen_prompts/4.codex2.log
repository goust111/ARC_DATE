+import random
+
+import numpy as np
+
+
+AZURE = 8
+RED = 2
+GREY = 5
+MAROON = 9
+
+ALL_TRANSFORMS = (
+    "id",
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_lr",
+    "flip_ud",
+    "transpose",
+    "anti_transpose",
