+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+AZURE = 8
+RED = 2
+GREY = 5
+MAROON = 9
+
+ALL_TRANSFORMS = (
+    "id",
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_lr",
+    "flip_ud",
+    "transpose",
+    "anti_transpose",
+)
+
+INVERSE_TRANSFORM = {
+    "id": "id",
+    "rot90": "rot270",
+    "rot180": "rot180",
+    "rot270": "rot90",
+    "flip_lr": "flip_lr",
+    "flip_ud": "flip_ud",
+    "transpose": "transpose",
+    "anti_transpose": "anti_transpose",
