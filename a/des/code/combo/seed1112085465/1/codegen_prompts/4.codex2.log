+    "id": "id",
+    "rot90": "rot270",
+    "rot180": "rot180",
+    "rot270": "rot90",
+    "flip_lr": "flip_lr",
+    "flip_ud": "flip_ud",
+    "transpose": "transpose",
+    "anti_transpose": "anti_transpose",
