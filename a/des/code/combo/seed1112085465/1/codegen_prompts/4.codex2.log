+    "id": "id",
+    "rot90": "rot270",
+    "rot180": "rot180",
+    "rot270": "rot90",
+    "flip_lr": "flip_lr",
+    "flip_ud": "flip_ud",
+    "transpose": "transpose",
+    "anti_transpose": "anti_transpose",
+}
+
+GEN_RETRIES = 300
+SHAPE_RETRIES = 200
+PANEL_SIZE_RANGE = (5, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _valid_transforms(shape: tuple[int, int]) -> tuple[str, ...]:
