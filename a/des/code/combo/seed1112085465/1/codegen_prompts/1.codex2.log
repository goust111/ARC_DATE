+FRAME_COLOR = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+EDGE_OPTIONS = ("top", "bottom", "left", "right")
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 300
