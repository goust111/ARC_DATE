+
+def _non_bg_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps = []
+    for coords in _connected_components(grid != bg):
+        bbox = _bbox_from_coords(coords)
+        mask = _mask_from_coords(coords, bbox)
