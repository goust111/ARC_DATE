+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min((cand.shape, cand.astype(np.uint8).tobytes()) for cand in _dihedral_masks(mask))
+
+
+def _background_color(grid: np.ndarray) -> int:
