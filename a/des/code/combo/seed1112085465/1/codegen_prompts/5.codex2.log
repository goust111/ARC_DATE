+    centroid_c = sum(c for _, c in coords) / len(coords)
+    dr = centroid_r - center_r
+    dc = centroid_c - center_c
+    assert abs(dr) > 1e-9 or abs(dc) > 1e-9, "sprite centroid must not match bbox center"
+    if abs(dr) >= abs(dc):
