+        assert r1 - r0 >= 2 and c1 - c0 >= 2, "frame must enclose interior space"
+        expected_border = _frame_border(r0, c0, r1, c1)
+        assert set(comp) == expected_border, "green component must be a 1-pixel rectangular frame"
