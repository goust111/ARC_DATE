+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+FRAME_COUNT_CHOICES = [1, 2, 3]
+FRAME_COUNT_WEIGHTS = [2, 3, 2]
+INNER_EXTRA_RANGE = (2, 4)
+PLACEMENT_RETRIES = 200
+GENERATE_RETRIES = 400
+COLOR_POOL = [1, 2, 4, 5, 6, 7, 8, 9]
