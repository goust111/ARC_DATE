+def _rect_cells(r0: int, c0: int, r1: int, c1: int, height: int, width: int) -> set[tuple[int, int]]:
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(height - 1, r1)
+    cc1 = min(width - 1, c1)
