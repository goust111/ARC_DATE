+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+    for _ in range(GENERATE_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            _GEN_COUNTER += 1
+            return grid
+    raise RuntimeError("failed to generate valid input")

