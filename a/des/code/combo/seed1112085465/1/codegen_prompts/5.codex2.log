+def _direction_cycle(n_frames: int) -> list[str]:
+    global _GEN_COUNTER
+    offset = _GEN_COUNTER % len(DIRS)
+    cycle = list(DIRS[offset:] + DIRS[:offset])
+    chosen = cycle[:n_frames]
+    random.shuffle(chosen)
+    return chosen
