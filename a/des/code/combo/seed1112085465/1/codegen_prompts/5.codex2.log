+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(height - 1, r1)
+    cc1 = min(width - 1, c1)
+    return {(r, c) for r in range(rr0, rr1 + 1) for c in range(cc0, cc1 + 1)}
+
