+    high = random.choice(((1, 1), (1, 2), (2, 1), (1, 3), (3, 1)))
+    extras = ((2, 2), (2, 3), (3, 2), (1, 4), (4, 1), (2, 4), (4, 2))
+    kinds = [rich, high]
+    if random.random() < 0.65:
+        kinds.append(random.choice(extras))
