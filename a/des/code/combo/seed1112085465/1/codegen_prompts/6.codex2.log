+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ORTHOGONAL_STEPS:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            arr = np.asarray(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+
+    return objects
+
+
+def _bbox_mask(obj: dict) -> np.ndarray:
+    r0, c0, r1, c1 = obj["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    coords = obj["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _infer_step2(center_values: list[int]) -> int:
+    vals = sorted(set(int(v) for v in center_values))
+    if len(vals) <= 1:
+        return 2
+
+    diffs = [b - a for a, b in zip(vals, vals[1:]) if b > a]
+    step2 = diffs[0]
+    for diff in diffs[1:]:
+        step2 = math.gcd(step2, diff)
+    assert step2 > 0
+    return int(step2)
+
+
+def _crop_non_bg(grid: np.ndarray, bg: int) -> np.ndarray:
+    nz = np.argwhere(grid != bg)
+    assert len(nz) > 0
+    r0, c0 = nz.min(axis=0)
+    r1, c1 = nz.max(axis=0)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _normalize_objects(grid: np.ndarray) -> list[dict]:
+    objects = _find_components(grid, bg=BG)
+    assert objects, "expected at least one foreground object"
+
+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        obj["h"] = int(r1 - r0 + 1)
+        obj["w"] = int(c1 - c0 + 1)
