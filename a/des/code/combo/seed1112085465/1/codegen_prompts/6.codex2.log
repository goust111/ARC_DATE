+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        frontier: set[tuple[int, int]] = set()
+
+        def add_frontier(cell: tuple[int, int]) -> None:
+            rr, cc = cell
+            for dr, dc in ORTHOGONAL_STEPS:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
