+
+
+BG = 4  # yellow
+PALETTE = [0, 1, 2, 3, 5, 6, 7, 8, 9]
+ORTHOGONAL_STEPS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
