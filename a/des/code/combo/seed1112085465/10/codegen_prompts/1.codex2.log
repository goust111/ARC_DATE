+        local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        border = np.zeros((height, width), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
