+            fw = rng.randint(FRAME_SIDE_RANGE[0], FRAME_SIDE_RANGE[1])
+            gap = _choose_gap(fh, fw, used_shapes, branch, rng)
+            if gap is None:
+                continue
+            gap_cells, shape = gap
+            placed = {
+                "frame_size": (fh, fw),
+                "gap_cells": gap_cells,
+                "shape": shape,
+                "color": int(color),
+            }
+            used_shapes.add(shape)
