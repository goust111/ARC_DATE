+def _extract_labels(grid: np.ndarray) -> list[dict]:
+    colors = sorted(set(map(int, np.unique(grid))) - {BG, FRAME_COLOR})
+    labels = []
+    for color in colors:
+        for coords in _components(grid == color):
+            labels.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "shape": _normalize(coords),
