+POINTER_COUNT_CHOICES = [1, 2, 3, 4]
+SQUARE_SIZE_CHOICES = [2, 4, 6]
+MAX_PLACEMENT_ATTEMPTS = 250
+MAX_GENERATION_ATTEMPTS = 400
