+    for spec in specs:
+        color = int(spec["color"])
+        side = int(spec["side"])
+        r0 = int(spec["square_r0"])
+        c0 = int(spec["square_c0"])
+        grid[r0 : r0 + side, c0 : c0 + side] = color
