        cc = col_index[c]
        assert symbolic[rr, cc] == bg
        symbolic[rr, cc] = color

    if side in ("top", "bottom"):
        dominant_cols = range(3, 6) if side == "top" else range(0, 3)
        dominant_values = [
            int(symbolic[r, c])
            for r in range(symbolic.shape[0])
