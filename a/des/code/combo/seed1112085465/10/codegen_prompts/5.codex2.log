+    ordered = sorted(objects, key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
+    rotated = [_rotate_by_edges(obj["patch"], obj["edges"]) for obj in ordered]
+    return _pack_patches(rotated)
