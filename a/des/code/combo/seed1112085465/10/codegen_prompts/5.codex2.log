+    frozenset(): 0,
+    frozenset({"top"}): 2,
+    frozenset({"right"}): 1,
+    frozenset({"bottom"}): 0,
+    frozenset({"left"}): 3,
+    frozenset({"top", "left"}): 1,
+    frozenset({"top", "right"}): 2,
+    frozenset({"bottom", "left"}): 0,
+    frozenset({"bottom", "right"}): 3,
