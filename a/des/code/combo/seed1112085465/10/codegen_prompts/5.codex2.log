+def _branch_edges(branch: str) -> frozenset[str]:
+    if branch == "none":
+        return frozenset()
+    if branch == "corner":
+        return CORNER_PATTERNS[int(RNG.integers(len(CORNER_PATTERNS)))]
+    return frozenset({branch})
