+def _crop_nonzero(arr: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(arr != BG)
+    assert coords.size > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
