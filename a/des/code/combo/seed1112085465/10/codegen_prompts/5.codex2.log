+    if r0 == 0:
+        edges.add("top")
+    if c0 == 0:
+        edges.add("left")
+    if r0 + h == grid_h:
+        edges.add("bottom")
+    if c0 + w == grid_w:
+        edges.add("right")
+    return frozenset(edges)
