+    if branch == "corner":
+        return CORNER_PATTERNS[int(RNG.integers(len(CORNER_PATTERNS)))]
+    return frozenset({branch})
+
+
+def _placement_candidates(
+    reserved: np.ndarray,
+    patch: np.ndarray,
+    edges: frozenset[str],
+) -> list[tuple[int, int]]:
