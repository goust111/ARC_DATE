+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+SEP = 5
+MARKER = 2
+PATTERN_COLORS = (0, 1, 3, 4, 6, 7, 9)
+DIRECTIONS = ("up", "down", "left", "right")
+STEP = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+PANEL_SIZE_RANGE = (4, 7)
+PATTERN_AREA_RANGE = (2, 8)
+GEN_ATTEMPTS = 300
+COLLISION_PROB = 0.5
+LOSS_PROB = 0.5
+SHAPE_GROW_ATTEMPTS = 80
