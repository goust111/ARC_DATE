+
+BG = 8
+SEP = 5
+MARKER = 2
+PATTERN_COLORS = (0, 1, 3, 4, 6, 7, 9)
+DIRECTIONS = ("up", "down", "left", "right")
+STEP = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
