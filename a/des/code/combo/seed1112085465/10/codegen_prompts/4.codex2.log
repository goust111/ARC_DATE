+
+
+def _render_input(
+    panel_h: int,
+    panel_w: int,
+    markers: dict[tuple[int, int], tuple[int, int]],
+    patterns: dict[tuple[int, int], dict[tuple[int, int], int]],
+) -> np.ndarray:
+    h = 3 * panel_h + 2
+    w = 3 * panel_w + 2
+    grid = np.full((h, w), BG, dtype=int)
