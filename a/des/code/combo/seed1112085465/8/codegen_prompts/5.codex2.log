+    grid[r1, c0 + 1 : c1] = _FRAME_COLORS["bottom"]
+    grid[r0 + 1 : r1, c0] = _FRAME_COLORS["left"]
+    grid[r0 + 1 : r1, c1] = _FRAME_COLORS["right"]
+
+
