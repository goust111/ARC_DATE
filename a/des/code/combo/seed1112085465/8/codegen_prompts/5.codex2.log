+_INTERIOR_H_RANGE = (14, 20)
+_INTERIOR_W_RANGE = (14, 20)
+_OUTER_MARGIN_RANGE = (1, 3)
+_OBJECT_COUNT_RANGE = (3, 5)
+_OBJECT_H_RANGE = (5, 8)
+_OBJECT_W_RANGE = (5, 8)
