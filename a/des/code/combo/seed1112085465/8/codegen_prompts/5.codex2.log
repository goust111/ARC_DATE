HORIZONTAL_LAYOUT = 0
VERTICAL_LAYOUT = 1
HORIZONTAL_OFFSETS = ("left", "right", "none")
VERTICAL_OFFSETS = ("top", "bottom", "none")

# Object geometry and placement constraints.
OBJECTS_PER_PANEL = (1, 2)
CORE_H_MIN = 3
CORE_H_MAX = 7
CORE_W_MIN = 3
