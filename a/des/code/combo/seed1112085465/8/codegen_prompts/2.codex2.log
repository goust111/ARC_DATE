+def _component_size(mask: np.ndarray) -> int:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return 0
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    sr, sc = map(int, coords[0])
+    q = deque([(sr, sc)])
+    seen[sr, sc] = True
+    size = 0
+    while q:
+        r, c = q.popleft()
+        size += 1
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
