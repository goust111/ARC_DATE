+        mask[r0 : r0 + rh, c0 : c0 + rw] = True
+
+    coords = np.argwhere(mask)
+    if coords.size:
+        for _ in range(3):
+            rr, cc = map(int, coords[int(rng.integers(0, len(coords)))])
