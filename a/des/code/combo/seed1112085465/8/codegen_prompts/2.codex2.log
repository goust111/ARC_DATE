+
+def _find_separator_col(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    candidates = []
+    for c in range(1, w - 1):
+        if c != w - c - 1:
+            continue
+        if np.all(grid[:, c] == grid[0, c]):
+            candidates.append(c)
