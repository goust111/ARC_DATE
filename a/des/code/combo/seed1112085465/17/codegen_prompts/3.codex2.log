+
+def _paint(out: np.ndarray, r: int, c: int, value: int, bg: int) -> None:
+    h, w = out.shape
+    assert 0 <= r < h and 0 <= c < w, "transformed pixels must stay in bounds"
+    prev = int(out[r, c])
+    assert prev in (bg, value), "transformed objects must not overlap inconsistently"
+    out[r, c] = value
