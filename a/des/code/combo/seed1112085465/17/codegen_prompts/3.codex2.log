+def _component_patch(grid: np.ndarray, comp: dict[str, object], bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]  # type: ignore[index]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    coords = comp["coords"]  # type: ignore[index]
