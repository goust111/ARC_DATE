+        if not frontier:
+            return None
+        r, c = random.choice(tuple(frontier))
+        frontier.remove((r, c))
+        occ[r, c] = True
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not occ[nr, nc]:
+                frontier.add((nr, nc))
+    return occ
