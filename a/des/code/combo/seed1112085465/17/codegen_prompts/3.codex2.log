+        return None
+
+    occ = np.zeros((h, w), dtype=bool)
+    frontier: set[tuple[int, int]] = set()
+    for r, c in required:
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        occ[r, c] = True
+
+    for r, c in required:
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not occ[nr, nc]:
