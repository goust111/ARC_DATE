+def _make_object(orient: str, colors: tuple[int, int]) -> tuple[np.ndarray, dict[str, object]] | None:
+    for _ in range(OBJECT_RETRIES):
+        mask = _build_vertical_mask()
+        if mask is None:
+            continue
