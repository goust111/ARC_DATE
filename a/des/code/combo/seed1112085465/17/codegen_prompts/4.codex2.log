+
+def _max_straight_branch_length(
+    start: tuple[int, int],
+    direction: str,
+    rows: int,
+    cols: int,
+    blocked: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    cap: int = 3,
+) -> int:
+    cur = start
+    length = 0
+    for _ in range(cap):
+        nxt = _move(cur, direction)
+        if not (0 <= nxt[0] < rows and 0 <= nxt[1] < cols):
+            break
+        if nxt in blocked or nxt in occupied:
+            break
+        length += 1
+        cur = nxt
+    return length
