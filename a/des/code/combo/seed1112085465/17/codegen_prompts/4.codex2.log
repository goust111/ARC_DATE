+        for cc in range(w):
+            distances: dict[str, int] = {}
+            ok = True
+            for r, c in coords:
+                if r == cr and c > cc:
+                    name = "right"
+                    dist = int(c - cc)
+                elif r == cr and c < cc:
+                    name = "left"
+                    dist = int(cc - c)
+                elif c == cc and r < cr:
+                    name = "up"
+                    dist = int(cr - r)
+                elif c == cc and r > cr:
+                    name = "down"
+                    dist = int(r - cr)
+                else:
