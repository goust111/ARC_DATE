+    direction: str,
+    rows: int,
+    cols: int,
+    blocked: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    edges: set[tuple[tuple[int, int], tuple[int, int]]],
+    rng: random.Random,
+) -> bool:
+    max_len = _max_straight_branch_length(attachment, direction, rows, cols, blocked, occupied)
+    if max_len == 0:
