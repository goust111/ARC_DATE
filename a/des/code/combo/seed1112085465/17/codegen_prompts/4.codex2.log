+    start_side = rng.choice(available_sides)
+    start = rng.choice(_side_cells(rows, cols, start_side, blocked))
+    min_len = rng.randint(max(10, (rows + cols) // 2), max(12, rows + cols + 1))
+    max_len = rows * cols // 2 + 6
