+
+def _direction_between(a: tuple[int, int], b: tuple[int, int]) -> str:
+    dr = b[0] - a[0]
+    dc = b[1] - a[1]
+    for name, vec in DIRS.items():
+        if vec == (dr, dc):
+            return name
+    raise AssertionError(f"non-cardinal step: {a} -> {b}")
