+import random
+
+import numpy as np
+
+
+BG = 8
+WALL = 5
+PATH = 2
+
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_NAMES = ("up", "right", "down", "left")
+
+LEGEND_COLORS = (0, 1, 3, 4, 6, 7, 9)
+LEGEND_RADIUS_MAX = 4
+LEGEND_CENTER_OFFSET = 5
+LEGEND_BLOCK_CELLS = 5
+
+CELL_ROWS_MIN = 10
+CELL_ROWS_MAX = 13
+CELL_COLS_MIN = 10
+CELL_COLS_MAX = 13
+ROUTE_ATTEMPTS = 180
+GEN_ATTEMPTS = 400
