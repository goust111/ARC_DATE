+        seen.add(state)
+
+        next_cell = None
+        for name in priority:
+            dr, dc = DIRS[name]
+            nr, nc = current[0] + dr, current[1] + dc
+            if not _in_bounds((h, w), nr, nc):
+                continue
+            if int(grid[nr, nc]) != BG:
+                continue
+            if previous is not None and (nr, nc) == previous:
+                continue
+            next_cell = (nr, nc)
+            break
