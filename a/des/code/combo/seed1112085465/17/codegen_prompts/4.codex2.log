+def _free_neighbors(
+    cell: tuple[int, int],
+    rows: int,
+    cols: int,
+    blocked: set[tuple[int, int]],
+    visited: set[tuple[int, int]],
+) -> list[tuple[str, tuple[int, int]]]:
+    out = []
+    for name in DIR_NAMES:
+        nxt = _move(cell, name)
+        if not (0 <= nxt[0] < rows and 0 <= nxt[1] < cols):
+            continue
+        if nxt in blocked or nxt in visited:
+            continue
+        out.append((name, nxt))
+    return out
