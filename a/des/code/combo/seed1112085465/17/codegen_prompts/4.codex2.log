+def _carve_grid(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    edges: set[tuple[tuple[int, int], tuple[int, int]]],
+    start_gap: tuple[int, int],
+    end_gap: tuple[int, int],
+) -> np.ndarray:
