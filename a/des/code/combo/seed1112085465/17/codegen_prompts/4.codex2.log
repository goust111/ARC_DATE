+                    break
+                if dist <= 0 or name in distances:
+                    ok = False
+                    break
+                distances[name] = dist
+            if ok and set(distances) == set(DIR_NAMES) and len(set(distances.values())) == 4:
+                candidates.append(((cr, cc), distances))
