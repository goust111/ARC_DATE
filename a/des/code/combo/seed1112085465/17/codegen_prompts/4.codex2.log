+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    actual = [_gap_cell(route[0], start_side, shape)]
+    prev_actual = _actual_cell(route[0])
+    actual.append(prev_actual)
+
+    for cell in route[1:]:
+        cur_actual = _actual_cell(cell)
+        mid = ((prev_actual[0] + cur_actual[0]) // 2, (prev_actual[1] + cur_actual[1]) // 2)
