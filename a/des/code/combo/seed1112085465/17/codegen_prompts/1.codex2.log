+_CLOCK_TEMPLATES = {
+    "up": {(r + 2, c) for (r, c) in _BASE_BORDER} | {(0, 2), (1, 2)},
+    "down": _BASE_BORDER | {(5, 2), (6, 2)},
+    "left": {(r, c + 2) for (r, c) in _BASE_BORDER} | {(2, 0), (2, 1)},
+    "right": _BASE_BORDER | {(2, 5), (2, 6)},
