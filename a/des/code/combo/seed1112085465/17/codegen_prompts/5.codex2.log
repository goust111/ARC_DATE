+
+def _render_rearranged(
+    shape: tuple[int, int],
+    bg: int,
+    anchor: dict,
+    ordered_objects: list[dict],
+) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    anchor_r0, anchor_c0, anchor_r1, anchor_c1 = anchor["bbox"]
+    out[int(anchor_r0) : int(anchor_r1) + 1, int(anchor_c0) : int(anchor_c1) + 1] = int(
+        anchor["color"]
