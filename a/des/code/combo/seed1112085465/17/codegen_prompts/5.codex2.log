+from __future__ import annotations
+
+import math
+from collections import deque
+
+import numpy as np
+
+
+BG_COLOR = 0
+ANCHOR_COLOR = 2
+PALETTE = np.array([1, 3, 4, 5, 6, 7, 8, 9], dtype=int)
+
+DIR_COUNT = 8
+DIR_STEP = math.pi / 4.0
+DIR_HALF_STEP = math.pi / 8.0
+INPUT_ANGLE_MARGIN = 0.05
+MAX_GENERATION_ATTEMPTS = 500
+MAX_SHAPE_ATTEMPTS = 200
+
+_RNG = np.random.default_rng()
+_NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _extract_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == int(bg):
+                continue
+
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in _NEIGHBORS4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0 = min(rows)
+            r1 = max(rows)
+            c0 = min(cols)
+            c1 = max(cols)
+            patch_h = int(r1 - r0 + 1)
+            patch_w = int(c1 - c0 + 1)
+            mask = np.zeros((patch_h, patch_w), dtype=bool)
+            for rr, cc in coords:
+                mask[int(rr - r0), int(cc - c0)] = True
+            patch = np.full((patch_h, patch_w), int(bg), dtype=int)
+            patch[mask] = int(color)
+
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": mask,
+                    "patch": patch,
+                    "area": int(len(coords)),
+                }
+            )
+
+    return components
+
+
+def _bbox_center(bbox: tuple[int, int, int, int]) -> tuple[float, float]:
+    r0, c0, r1, c1 = bbox
+    return (0.5 * (r0 + r1), 0.5 * (c0 + c1))
+
+
+def _choose_anchor(components: list[dict], shape: tuple[int, int]) -> tuple[int, dict]:
+    h, w = shape
+    mid_r = 0.5 * (h - 1)
+    mid_c = 0.5 * (w - 1)
+
+    candidates: list[tuple[float, int, int, int, int]] = []
+    for idx, comp in enumerate(components):
+        r0, c0, r1, c1 = comp["bbox"]
+        if int(comp["area"]) != 4:
