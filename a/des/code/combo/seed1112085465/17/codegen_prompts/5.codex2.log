+def _slot_top_left(
+    slot_idx: int,
+    patch_shape: tuple[int, int],
+    anchor_bbox: tuple[int, int, int, int],
+) -> tuple[int, int]:
+    anchor_r0, anchor_c0, anchor_r1, anchor_c1 = anchor_bbox
+    patch_h, patch_w = patch_shape
+    anchor_center_r, anchor_center_c = _bbox_center(anchor_bbox)
