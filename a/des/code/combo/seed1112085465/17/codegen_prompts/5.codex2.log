+        spec = remaining.pop(int(best_idx))
+        choice = best_positions[int(_RNG.integers(len(best_positions)))]
+        r0, c0 = choice
+        _mark_mask(occupied, spec["mask"], int(r0), int(c0))
+        spec["bbox"] = (
+            int(r0),
+            int(c0),
+            int(r0 + spec["mask"].shape[0] - 1),
+            int(c0 + spec["mask"].shape[1] - 1),
