+    for idx, comp in enumerate(components):
+        if int(idx) == int(anchor_idx):
+            continue
+        direction = _direction_index(comp["bbox"], anchor_center)
+        objects.append(
+            {
+                "color": int(comp["color"]),
+                "bbox": comp["bbox"],
+                "patch": comp["patch"].copy(),
+                "direction": int(direction),
