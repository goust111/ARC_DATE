+
+    grid = np.full(shape, BG_COLOR, dtype=int)
+    occupied: list[tuple[int, int, int, int]] = []
+    placed: list[dict[str, int | tuple[int, int, int, int] | list[tuple[int, int]]]] = []
+
+    for spec in specs:
