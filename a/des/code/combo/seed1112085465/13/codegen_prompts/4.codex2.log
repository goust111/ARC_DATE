+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 8
+FRAME_COLOR = 5
+MARKER_COLORS = [0, 1, 2, 3, 4, 6, 7, 9]
+
+GRID_HEIGHT_RANGE = (10, 21)
