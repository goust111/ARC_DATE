        first = random.randint(int(min_first_col), right - (k - 1))
        horiz = [first] + _split_positive(right - first, k - 1)
    vert = _split_positive(down, k)

    r, c = int(start_r), 0
    cells = [(r, c)]
    for h_run, v_run in zip(horiz, vert):
        for _ in range(h_run):
            c += 1
            cells.append((r, c))
        for _ in range(v_run):
            r += 1
            cells.append((r, c))

