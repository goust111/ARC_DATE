from __future__ import annotations
import random
import numpy as np

BLACK = 0
RED = 2
FRAGMENT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
DIRS = {
    'up': (-1, 0),
    'down': (1, 0),
    'left': (0, -1),
    'right': (0, 1),
}


def _unique_nearest_anchor(r, c, anchors):
    best_idx = -1
    best_dist = None
    tied = False
    for idx, (ar, ac) in enumerate(anchors):
        dist = abs(r - ar) + abs(c - ac)
        if best_dist is None or dist < best_dist:
            best_idx = idx
            best_dist = dist
            tied = False
        elif dist == best_dist:
            tied = True
    return None if tied else best_idx


def _fragment_direction(anchor, point):
    ar, ac = anchor
    r, c = point
    if r == ar and c "'!= ac:
        return ('"'left' if c < ac else 'right', abs(c - ac))
    if c == ac and r "'!= ar:
        return ('"'up' if r < ar else 'down', abs(r - ar))
    raise AssertionError


def _collect_assignments(g):
    anchors = [tuple(map(int, rc)) for rc in np.argwhere(g == RED)]
    assert anchors
    groups = {a: {d: [] for d in DIRS} for a in anchors}
    fragments = np.argwhere((g "'!= BLACK) & (g != RED))
    assert len(fragments) > 0
    for r0, c0 in fragments:
        r, c = int(r0), int(c0)
        idx = _unique_nearest_anchor(r, c, anchors)
        assert idx is not None
        anchor = anchors[idx]
        direction, dist = _fragment_direction(anchor, (r, c))
        groups[anchor][direction].append((dist, int(g[r, c])))
    return anchors, groups


def main(grid):
    g = np.asarray(grid, dtype=int)
    anchors, groups = _collect_assignments(g)
    out = np.full_like(g, BLACK)
    for ar, ac in anchors:
        out[ar, ac] = RED
    h, w = g.shape
    for ar, ac in anchors:
        for direction, (dr, dc) in DIRS.items():
            entries = sorted(groups[(ar, ac)][direction], key=lambda x: x[0])
            for offset, (_dist, color) in enumerate(entries, start=1):
                for sign in (1, -1):
                    rr = ar + sign * dr * offset
                    cc = ac + sign * dc * offset
                    assert 0 <= rr < h and 0 <= cc < w
                    cur = int(out[rr, cc])
                    assert cur in (BLACK, color)
                    out[rr, cc] = color
    return out


GRID_HEIGHT_RANGE = (11, 20)
GRID_WIDTH_RANGE = (11, 20)
MAX_ANCHORS = 4
MAX_GROUP_LEN = 3
MAX_GENERATION_ATTEMPTS = 400
ANCHOR_MARGIN = 3
MIN_ANCHOR_DISTANCE = 5


def _sample_anchors(h, w, count):
    row_choices = list(range(ANCHOR_MARGIN, h - ANCHOR_MARGIN))
    col_choices = list(range(ANCHOR_MARGIN, w - ANCHOR_MARGIN))
    if len(row_choices) < count or len(col_choices) < count:
        return None
    for _ in range(80):
        rows = random.sample(row_choices, count)
        cols = random.sample(col_choices, count)
        random.shuffle(cols)
        anchors = list(zip(rows, cols))
        if all(abs(r1-r2)+abs(c1-c2) >= MIN_ANCHOR_DISTANCE for i,(r1,c1) in enumerate(anchors) for r2,c2 in anchors[i+1:]):
            return anchors
    return None


def _ray_valid_distances(anchor_idx, direction, anchors, shape):
    ar, ac = anchors[anchor_idx]
    dr, dc = DIRS[direction]
    h, w = shape
    step = 1
    valid = []
    while True:
        rr = ar + dr * step
        cc = ac + dc * step
        if not (0 <= rr < h and 0 <= cc < w):
            break
        if _unique_nearest_anchor(rr, cc, anchors) == anchor_idx:
            valid.append(step)
        step += 1
    return valid


def _axis_capacity(anchor, shape, direction):
    ar, ac = anchor
    h, w = shape
    if direction in ('"'up', 'down'):
        return min(ar, h - 1 - ar)
    return min(ac, w - 1 - ac)


def _output_cells(anchor, direction, count):
    ar, ac = anchor
    dr, dc = DIRS[direction]
    cells = []
    for step in range(1, count + 1):
        cells.append((ar + dr * step, ac + dc * step))
        cells.append((ar - dr * step, ac - dc * step))
    return cells


def _choose_plan_for_anchor(anchor_idx, anchors, shape, occupied_input, reserved_output):
    anchor = anchors[anchor_idx]
    valid = {}
    for direction in DIRS:
        dists = _ray_valid_distances(anchor_idx, direction, anchors, shape)
        valid[direction] = [
            dist for dist in dists
            if (anchor[0] + DIRS[direction][0] * dist, anchor[1] + DIRS[direction][1] * dist) not in occupied_input
        ]
    vertical = [d for d in ('up', 'down') if min(len(valid[d]), _axis_capacity(anchor, shape, d), MAX_GROUP_LEN) >= 1]
    horizontal = [d for d in ('left', 'right') if min(len(valid[d]), _axis_capacity(anchor, shape, d), MAX_GROUP_LEN) >= 1]
    patterns = []
    for d in vertical:
        patterns.append((d,))
    for d in horizontal:
        patterns.append((d,))
    for dv in vertical:
        for dh in horizontal:
            patterns.append((dv, dh))
    random.shuffle(patterns)
    for pattern in patterns:
        for _ in range(20):
            plan = {}
            local_input = set()
            local_output = set()
            ok = True
            for direction in pattern:
                cands = [
                    dist for dist in valid[direction]
                    if (anchor[0] + DIRS[direction][0] * dist, anchor[1] + DIRS[direction][1] * dist) not in local_input
                ]
                max_count = min(len(cands), _axis_capacity(anchor, shape, direction), MAX_GROUP_LEN)
                if max_count < 1:
                    ok = False
                    break
                count = random.randint(1, max_count)
                output_cells = _output_cells(anchor, direction, count)
                if any(cell in reserved_output or cell in local_output for cell in output_cells):
                    ok = False
                    break
                chosen = random.sample(cands, count)
                plan[direction] = tuple(chosen)
                local_output.update(output_cells)
                for dist in chosen:
                    local_input.add((anchor[0] + DIRS[direction][0] * dist, anchor[1] + DIRS[direction][1] * dist))
            if ok:
                return plan, local_input, local_output
    return None


def _build_candidate():
    h = random.randint(*GRID_HEIGHT_RANGE)
    w = random.randint(*GRID_WIDTH_RANGE)
    max_count = min(MAX_ANCHORS, h - 2 * ANCHOR_MARGIN, w - 2 * ANCHOR_MARGIN)
    if max_count < 1:
        return None
    anchor_count = random.randint(1, max_count)
    anchors = _sample_anchors(h, w, anchor_count)
    if anchors is None:
        return None
    occupied_input = set(anchors)
    reserved_output = set(anchors)
    plans = {}
    order = list(range(anchor_count))
    random.shuffle(order)
    for anchor_idx in order:
        picked = _choose_plan_for_anchor(anchor_idx, anchors, (h, w), occupied_input, reserved_output)
        if picked is None:
            return None
        plan, new_inputs, new_outputs = picked
        plans[anchor_idx] = plan
        occupied_input.update(new_inputs)
        reserved_output.update(new_outputs)
    palette_size = random.randint(2, min(6, len(FRAGMENT_COLORS)))
    palette = random.sample(FRAGMENT_COLORS, palette_size)
    grid = np.full((h, w), BLACK, dtype=int)
    for ar, ac in anchors:
        grid[ar, ac] = RED
    for anchor_idx, plan in plans.items():
        ar, ac = anchors[anchor_idx]
        for direction, dists in plan.items():
            dr, dc = DIRS[direction]
            for dist in dists:
                rr = ar + dr * dist
                cc = ac + dc * dist
                grid[rr, cc] = random.choice(palette)
    return grid


def _is_valid_candidate(grid):
    try:
        anchors, groups = _collect_assignments(grid)
        out = main(grid)
    except Exception:
        return False
    fragments = int(np.count_nonzero((grid "'!= BLACK) & (grid != RED)))
    if fragments == 0 or np.array_equal(grid, out):
        return False
    if int(np.count_nonzero((out != BLACK) & (out != RED))) != 2 * fragments:
        return False
    for anchor in anchors:
        dirs = groups[anchor]
        if not any(dirs.values()):
            return False
        if dirs['"'up'] and dirs['down']:
            return False
        if dirs['left'] and dirs['right']:
            return False
    return True


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _build_candidate()
        if grid is not None and _is_valid_candidate(grid):
            return grid
    raise RuntimeError


for i in range(200):
    g = generate_input()
    o = main(g)
    if i < 3:
        print(g.shape)
        print(g)
        print(o)
        print()
print('ok')
