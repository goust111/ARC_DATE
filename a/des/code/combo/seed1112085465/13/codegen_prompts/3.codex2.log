+
+def _overlap_pair(height: int, width: int, max_area: int) -> list[Rect] | None:
+    for _ in range(180):
+        h1, w1 = _sample_rect_size(height, width)
+        h2, w2 = _sample_rect_size(height, width)
+        if h1 * w1 + h2 * w2 > max_area:
