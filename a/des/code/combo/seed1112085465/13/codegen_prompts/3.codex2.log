+    ar0, ac0, ar1, ac1 = ar0 - 1, ac0 - 1, ar1 + 1, ac1 + 1
+    br0, bc0, br1, bc1 = br0 - 1, bc0 - 1, br1 + 1, bc1 + 1
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
