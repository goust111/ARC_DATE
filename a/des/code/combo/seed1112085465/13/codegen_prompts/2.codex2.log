+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG_COLOR = 7
+SIDES = ("top", "bottom", "left", "right")
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def crop_true(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+
+
+def mask_to_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
+    patch = np.full(mask.shape, bg, dtype=int)
+    patch[mask] = color
+    return patch
+
+
+def paste_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    sub = grid[top : top + h, left : left + w]
+    mask = patch != bg
+    sub[mask] = patch[mask]
+
+
+def place_mask(grid: np.ndarray, mask: np.ndarray, color: int, top: int, left: int) -> None:
+    coords = np.argwhere(mask)
+    for rr, cc in coords:
+        grid[int(top + rr), int(left + cc)] = int(color)
+
+
+def component_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def find_components_for_color(grid: np.ndarray, color: int) -> list[dict]:
+    mask = grid == int(color)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                    "color": int(color),
+                }
+            )
+    return comps
+
+
+def analyze_lockhole(mask: np.ndarray) -> dict | None:
+    h, w = mask.shape
+    if h < 5 or w < 5:
+        return None
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(mask & ~border):
+        return None
+    if not (mask[0, 0] and mask[0, -1] and mask[-1, 0] and mask[-1, -1]):
+        return None
+
+    candidates = []
+    side_specs = {
+        "top": (mask[0, 1:-1], 0),
+        "bottom": (mask[-1, 1:-1], 0),
+        "left": (mask[1:-1, 0], 1),
+        "right": (mask[1:-1, -1], 1),
+    }
