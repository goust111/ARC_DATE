    g[hr0:hr0 + HUB_SIZE, hc0:hc0 + HUB_SIZE] = P

    # Hub perimeter = all cells on the border of the HUB_SIZE x HUB_SIZE square
    hub_perimeter = [(r, c) for r in range(hr0, hr0 + HUB_SIZE)
