+        rep_area = h * rep_w
+        target = random.randint(max(3, rep_w), min(rep_area, rep_w + h + 3))
+        rep = _grow_connected((h, rep_w), seed, target)
+        if rep is None:
+            continue
+        if all(c == bridge_col for _, c in rep):
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
