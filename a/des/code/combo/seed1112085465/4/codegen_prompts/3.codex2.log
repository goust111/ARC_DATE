+    placed: list[list[tuple[int, int]]] = []
+    order = sorted(range(len(masks)), key=lambda i: int(masks[i].sum()), reverse=True)
+    slots: dict[int, list[tuple[int, int]]] = {}
+
+    for idx in order:
+        mask = masks[idx]
