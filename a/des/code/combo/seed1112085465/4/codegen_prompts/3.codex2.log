+    out = g.copy()
+    color_map = {"lr": BLUE, "ud": RED, "rot": GREEN}
+    for coords in parts:
+        kind = _classify_mask(_normalized_mask(coords))
+        out[tuple(np.array(coords).T)] = color_map[kind]
