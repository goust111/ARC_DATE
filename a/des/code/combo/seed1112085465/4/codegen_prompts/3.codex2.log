+
+    max_h = max(mask.shape[0] for mask in masks)
+    max_w = max(mask.shape[1] for mask in masks)
+    grid_h = random.randint(max(14, max_h + 5), 24)
+    grid_w = random.randint(max(14, max_w + 5), 24)
