+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    r1 = max(rows)
+    c1 = max(cols)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
