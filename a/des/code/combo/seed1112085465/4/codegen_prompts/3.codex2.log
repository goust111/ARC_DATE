+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+INPUT_COLORS = (4, 5, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MASK_ATTEMPTS = 120
+GEN_ATTEMPTS = 400
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        seen[rr, cc] = True
+        queue = deque([(rr, cc)])
+        coords: list[tuple[int, int]] = []
+        while queue:
+            cr, cc = queue.popleft()
+            coords.append((cr, cc))
+            for dr, dc in DIRS4:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        parts.append(coords)
+    return parts
+
+
+def _trim(mask: np.ndarray) -> np.ndarray:
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    return mask[rows][:, cols]
+
+
+def _normalized_mask(coords: list[tuple[int, int]]) -> np.ndarray:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    r1 = max(rows)
+    c1 = max(cols)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    start_r, start_c = map(int, coords[0])
+    queue = deque([(start_r, start_c)])
+    seen[start_r, start_c] = True
+    count = 0
+    while queue:
+        r, c = queue.popleft()
+        count += 1
+        for dr, dc in DIRS4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+    return count == int(mask.sum())
+
+
+def _classify_mask(mask: np.ndarray) -> str:
+    lr = np.array_equal(mask, np.fliplr(mask))
+    ud = np.array_equal(mask, np.flipud(mask))
+    rot = np.array_equal(mask, np.rot90(mask, 2))
+    if lr and not ud:
+        return "lr"
+    if ud and not lr:
+        return "ud"
+    if rot and not lr and not ud:
+        return "rot"
+    raise AssertionError("object must have exactly one allowed symmetry")
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each monochrome object by its unique symmetry type.
+
+    Left-right reflection symmetry becomes blue, up-down reflection symmetry
+    becomes red, and 180-degree rotational symmetry without reflection becomes
