+
+def _random_ud_mask() -> np.ndarray:
+    return _random_lr_mask().T
+
+
+def _random_rot_mask() -> np.ndarray:
+    for _ in range(MASK_ATTEMPTS):
+        h = random.choice((3, 5, 7))
+        w = random.choice((3, 5, 7))
