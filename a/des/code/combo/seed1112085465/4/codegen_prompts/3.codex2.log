+) -> set[tuple[int, int]] | None:
+    h, w = shape
+    cells = set(seeds)
+    if allowed is not None and not cells <= allowed:
+        return None
+
+    while len(cells) < target_size:
+        frontier: list[tuple[int, int]] = []
+        for r, c in cells:
+            for dr, dc in DIRS4:
+                nr = r + dr
+                nc = c + dc
+                nxt = (nr, nc)
+                if not (0 <= nr < h and 0 <= nc < w):
