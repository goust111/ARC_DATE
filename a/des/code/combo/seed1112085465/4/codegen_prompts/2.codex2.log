+BG = 7
+PALETTE = [1, 2, 3, 4, 5, 6, 8, 9]
+GRID_SIZE_RANGE = (10, 24)
+FRAME_COUNT_WEIGHTS = [(1, 3), (2, 4), (3, 3)]
