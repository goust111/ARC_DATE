+
+def _marker_target(
+    grid: np.ndarray, bg: int, marker: tuple[int, int], frame: set[tuple[int, int]]
+) -> tuple[int, int]:
+    h, w = grid.shape
+    r, c = marker
+    candidates: list[tuple[int, int]] = []
