+
+    sides = {
+        "up": _gap_run(local[0, :]),
+        "down": _gap_run(local[-1, :]),
+        "left": _gap_run(local[:, 0]),
+        "right": _gap_run(local[:, -1]),
+    }
+    if any(run == (-1, -1) for run in sides.values()):
+        return None
+
+    missing = [(name, run) for name, run in sides.items() if run is not None]
+    if len(missing) != 1:
