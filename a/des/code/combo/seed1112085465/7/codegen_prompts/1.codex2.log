+def _gap_run(line: np.ndarray) -> tuple[int, int] | None:
+    missing = np.flatnonzero(~line)
+    if missing.size == 0:
+        return None
+    if missing[0] == 0 or missing[-1] == len(line) - 1:
+        return (-1, -1)
+    if int(missing[-1] - missing[0] + 1) != int(missing.size):
+        return (-1, -1)
+    return int(missing[0]), int(missing[-1])
