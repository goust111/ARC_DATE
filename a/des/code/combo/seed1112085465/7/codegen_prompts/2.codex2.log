+def _group_key(member_ids: set[int], objects: list[dict], orient: str) -> tuple[int, int]:
+    if orient == "v":
+        return (
+            min(objects[idx]["bbox"][1] for idx in member_ids),
+            min(objects[idx]["bbox"][0] for idx in member_ids),
+        )
+    return (
+        min(objects[idx]["bbox"][0] for idx in member_ids),
+        min(objects[idx]["bbox"][1] for idx in member_ids),
+    )
