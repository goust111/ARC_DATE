+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 7
+BLUE = 1
+RED = 2
+OBJECT_COLORS = (0, 3, 4, 5, 6, 8, 9)
+GROUP_GAP = 2
+MAX_GEN_RETRIES = 300
+MAX_PLACE_TRIES = 300
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or labels[r, c] != -1:
+                continue
+
+            q = deque([(r, c)])
+            labels[r, c] = len(comps)
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and labels[nr, nc] == -1 and int(grid[nr, nc]) == color:
+                        labels[nr, nc] = len(comps)
+                        q.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+            patch[arr[:, 0] - r0, arr[:, 1] - c0] = color
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "patch": patch,
+                    "neighbors": set(),
+                }
+            )
+
+    for r in range(h):
+        for c in range(w):
+            cid = int(labels[r, c])
+            if cid == -1:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w:
+                    nid = int(labels[nr, nc])
+                    if nid != -1 and nid != cid:
+                        comps[cid]["neighbors"].add(nid)
+
+    return comps, labels
