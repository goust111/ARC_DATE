+
+    expected = _expected_from_specs(shape, specs)
+    solved = main(grid)
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
