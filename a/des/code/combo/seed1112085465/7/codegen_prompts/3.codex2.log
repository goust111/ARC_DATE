+def _bbox_hw(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _apply_op(pattern: np.ndarray, op: str) -> np.ndarray:
+    if op == "identity":
+        return pattern.copy()
+    if op == "hflip":
+        return np.fliplr(pattern)
+    if op == "vflip":
+        return np.flipud(pattern)
+    if op == "rot180":
