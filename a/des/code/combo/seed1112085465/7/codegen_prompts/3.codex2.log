+        if (r0, c) not in pset or (r1, c) not in pset:
+            return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pset or (r, c1) not in pset:
+            return False
+    return True
+
+
+def _is_full_3x3(points: list[tuple[int, int]]) -> bool:
+    bbox = _bbox(points)
+    return _bbox_hw(bbox) == (3, 3) and len(points) == 9
