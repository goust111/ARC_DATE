+    h, w = blocked.shape
+    r0 = max(0, int(top - GEN_OBJECT_PADDING))
+    c0 = max(0, int(left - GEN_OBJECT_PADDING))
+    r1 = min(h, int(top + height + GEN_OBJECT_PADDING))
+    c1 = min(w, int(left + width + GEN_OBJECT_PADDING))
