+GEN_PANEL_HEIGHTS = (11, 12, 13, 14)
+GEN_PANEL_WIDTHS = (11, 12, 13, 14)
+GEN_SEPARATOR_WIDTHS = (1, 2)
+GEN_OBJECT_COUNTS = (3, 4)
