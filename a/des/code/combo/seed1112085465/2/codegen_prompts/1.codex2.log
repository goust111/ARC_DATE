+
+    grid = _compose_input(left["panel"], right["panel"], sep_w)
+    expected = _expected_output(grid, left, right, panel_w, sep_w)
+    if np.array_equal(grid, expected):
+        return None
+
+    try:
+        actual = main(grid)
+    except AssertionError:
