+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            shape = _normalize_shape(set(coords))
+            components.append(
+                {
+                    "coords": arr,
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                    "shape": shape,
+                }
+            )
