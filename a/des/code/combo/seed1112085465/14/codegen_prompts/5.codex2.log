+            placed = True
+            break
+        if not placed:
+            return None
+
+    if int(np.count_nonzero(grid)) * 2 >= grid.size:
+        return None
+
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
