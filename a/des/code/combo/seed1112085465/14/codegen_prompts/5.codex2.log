+            c1 = int(coords[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "area": int(mask.sum()),
