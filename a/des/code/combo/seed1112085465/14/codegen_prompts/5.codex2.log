+
+def _mask_component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                cr, cc = stack.pop()
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return count
+
