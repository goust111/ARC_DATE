+def _is_connected(mask: np.ndarray) -> bool:
+    return bool(mask.any()) and _mask_component_count(mask) == 1
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    bg = ~mask
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_edge = r in (0, h - 1) or c in (0, w - 1)
+            while stack:
+                cr, cc = stack.pop()
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        touches_edge |= nr in (0, h - 1) or nc in (0, w - 1)
+                        stack.append((nr, nc))
+            if not touches_edge:
+                return True
+    return False
