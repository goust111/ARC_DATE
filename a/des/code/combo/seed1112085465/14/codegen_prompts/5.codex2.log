+        if not placed:
+            return None
+
+    key_order = sorted(range(pair_count), key=lambda i: -int(pair_specs[i]["key_mask"].sum()))
+    for idx in key_order:
+        key_mask = pair_specs[idx]["key_mask"]
+        placed = False
+        for _ in range(PLACE_RETRIES):
