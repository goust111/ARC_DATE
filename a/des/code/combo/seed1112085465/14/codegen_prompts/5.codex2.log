+    c0 = max(0, left - PLACEMENT_PAD)
+    r1 = min(grid_h, top + h + PLACEMENT_PAD)
+    c1 = min(grid_w, left + w + PLACEMENT_PAD)
+    occupied[r0:r1, c0:c1] = True
