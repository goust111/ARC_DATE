+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Find each same-color lock/key pair, erase the key sprite, and cut the matching protrusion off the lock.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _background_color(g)
