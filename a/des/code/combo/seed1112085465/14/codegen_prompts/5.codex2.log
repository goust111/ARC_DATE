+from __future__ import annotations
+
+import random
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+COLORS = tuple(range(1, 10))
+
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
