+            lock_mask[body_h:, offset : offset + shape.shape[1]] |= shape
+            body_offset = (0, 0)
+    else:
+        max_shape_h = min(SHAPE_SPAN_MAX, body_h - 2)
+        if max_shape_h < 2:
