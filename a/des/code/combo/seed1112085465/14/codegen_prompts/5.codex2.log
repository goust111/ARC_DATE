+    lock_order = sorted(range(pair_count), key=lambda i: -int(pair_specs[i]["lock_mask"].sum()))
+    lock_positions: dict[int, tuple[int, int]] = {}
+    for idx in lock_order:
+        lock_mask = pair_specs[idx]["lock_mask"]
+        placed = False
+        for _ in range(PLACE_RETRIES):
