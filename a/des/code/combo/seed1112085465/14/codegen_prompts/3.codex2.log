+        inner_bbox = _draw_structure(
+            grid,
+            outer_bbox,
+            int(spec["outer_color"]),
+            int(spec["inner_color"]),
+        )
+        placements.append(
+            {
+                "outer_bbox": outer_bbox,
+                "inner_bbox": inner_bbox,
+                "outer_color": int(spec["outer_color"]),
+                "inner_color": int(spec["inner_color"]),
+            }
+        )
