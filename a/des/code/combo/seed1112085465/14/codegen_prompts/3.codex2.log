    return specs


def _expanded_bounds(
    rows: int,
    cols: int,
    r0: int,
    c0: int,
    h: int,
    w: int,
    padding: int,
) -> tuple[int, int, int, int]:
    return (
        max(0, r0 - padding),
        max(0, c0 - padding),
        min(rows, r0 + h + padding),
        min(cols, c0 + w + padding),
    )


def _placement_candidates(
    reserved: np.ndarray,
    h: int,
    w: int,
    padding: int,
) -> list[tuple[int, int]]:
    rows, cols = reserved.shape
