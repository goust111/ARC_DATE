  57: def main(grid: np.ndarray) -> np.ndarray:
  58:     """
  59:     Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.
  60: 
  61:     Input structure
  62:     - The background is the dominant color.
  63:     - Exactly one grid corner contains a foreground control pixel; it gives the
  64:       corner from which the triangle is painted.
  65:     - There is one unique largest 8-connected monochrome foreground object, the
  66:       motif that remains in the output; all other foreground pixels are controls.
  67:     - Every foreground component outside that motif is a singleton control pixel.
  68:     - The fill color is the unique control color that appears in at least two
  69:       non-corner control pixels.
  70: 
  71:     Rule
  72:     - Start from a blank background canvas and redraw only the largest motif.
  73:     - Count the non-corner control pixels; that count is the triangle side.
  74:     - Paint the fill color on the right-triangle region where those two distances
  75:       from the marked corner's edges sum to less than the side length.
  76: 
  77:     Key insight
  78:     - The scattered singleton controls are counted into a compact triangular
  79:       stack at the marked corner; only the largest motif is not part of the count.
  80:     """
  81:     g = np.asarray(grid, dtype=int)
  82:     bg = get_bg(g)
  83:     H, W = g.shape
  84: 
  85:     corners = {
  86:         "TL": (0, 0),
  87:         "TR": (0, W - 1),
  88:         "BL": (H - 1, 0),
  89:         "BR": (H - 1, W - 1),
  90:     }
  91:     marked_corners = [
  92:         (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)
  93:     ]
  94:     assert len(marked_corners) == 1, "expected exactly one foreground corner marker"
  95:     corner, (corner_r, corner_c) = marked_corners[0]
  96: 
  97:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)
  98:     assert comps, "expected at least one foreground component"
  99:     max_area = max(int(comp["area"]) for comp in comps)
 100:     motif_candidates = [comp for comp in comps if int(comp["area"]) == max_area]
 101:     assert len(motif_candidates) == 1, "expected a unique largest motif"
 102:     motif = motif_candidates[0]
 103:     motif_color = int(motif["color"])
 104:     motif_coords = {tuple(map(int, coord)) for coord in motif["coords"]}
 105:     motif_direction = _diagonal_direction(motif_coords)
 106:     assert motif_direction is not None, "motif must be square and diagonal-symmetric"
 107:     assert motif_direction == corner, "corner marker must match motif diagonal direction"
 108: 
 109:     control_coords = [
 110:         (int(r), int(c))
 111:         for r, c in np.argwhere(g != bg)
 112:         if (int(r), int(c)) not in motif_coords
 113:     ]
 114:     assert (corner_r, corner_c) in control_coords, "corner marker must be a control pixel"
 115:     assert len(control_coords) > 1, "expected non-corner control pixels"
 116: 
 117:     control_components = [comp for comp in comps if comp is not motif]
 118:     assert all(int(comp["area"]) == 1 for comp in control_components), "controls must be singleton components"
 119: 
 120:     control_counts = Counter(
 121:         int(g[r, c])
 122:         for r, c in control_coords
 123:         if (int(r), int(c)) != (corner_r, corner_c)
 124:     )
 125:     fill_candidates = [
 126:         int(color) for color, count in control_counts.items() if int(count) >= 2
