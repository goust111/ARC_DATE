  29: def main(grid: np.ndarray) -> np.ndarray:
  30:     """
  31:     Pack the non-background rows from three separated panels into one panel, scanning panels right-to-left.
  32: 
  33:     Input structure:
  34:     - A rectangular grid contains three equal-size panels separated by two full-height divider columns.
  35:     - The background is the dominant color; divider pixels use a color that appears only in the divider columns.
  36: 
  37:     Rule:
  38:     - Read panels from right to left, and within each panel read rows from top to bottom.
  39:     - Keep each row that contains any non-background pixel, discarding all-background rows.
  40:     - Place the kept rows at the bottom of a single panel-shaped output, padding above with background rows.
  41: 
  42:     Key insight:
  43:     - The task is row packing: the divider columns mark independent panels, and only the occupied rows are moved.
  44:     """
  45:     g = np.asarray(grid, dtype=int)
  46:     H, W = g.shape
  47:     bg = int(get_bg(g))
  48: 
  49:     s0, s1 = _separator_columns(g, bg)
  50:     panel_w = int(s0)
  51:     assert H == panel_w
  52: 
  53:     panels = [
  54:         g[:, :s0],
  55:         g[:, s0 + 1 : s1],
  56:         g[:, s1 + 1 :],
  57:     ]
  58:     rows: list[np.ndarray] = []
  59:     for panel in reversed(panels):
  60:         assert panel.shape == (H, panel_w)
  61:         for r in range(H):
  62:             row = panel[r, :]
  63:             if bool(np.any(row != bg)):
  64:                 rows.append(row.copy())
  65: 
  66:     assert 0 < len(rows) <= H
  67:     for i in range(len(rows) - 1):
  68:         cols_a = set(int(c) for c in range(panel_w) if int(rows[i][c]) != bg)
  69:         cols_b = set(int(c) for c in range(panel_w) if int(rows[i + 1][c]) != bg)
  70:         assert cols_a & cols_b, "consecutive non-bg rows must share at least one column"
  71:     out = np.full((H, panel_w), bg, dtype=int)
  72:     out[H - len(rows) :, :] = np.asarray(rows, dtype=int)
  73:     return out

