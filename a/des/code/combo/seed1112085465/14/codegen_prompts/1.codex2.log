   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Complete a grid of colored blocks to match a minimap legend in the top-left corner.
  11: 
  12:     Input structure:
  13:     - bg = most common color.
  14:     - Top-left corner: a small sprite of single colored pixels forming a minimap pattern on a regular lattice.
  15:     - Main area: uniformly colored square blocks (NxN) arranged on a regular grid; some positions are empty (bg).
  16: 
  17:     Rule:
  18:     - The legend pixels define a color pattern; each pixel's lattice position maps to a block position in the main grid via a fixed scale factor and offset.
  19:     - Existing colored blocks confirm the scale/offset alignment.
  20:     - For every legend pixel whose corresponding grid position is empty, place a new block of that color.
  21: 
  22:     Key insight: The top-left pixel pattern is a scaled-down minimap of the block layout; the mapping is inferred from blocks already present.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     h, w = g.shape
  26:     out = g.copy()
  27:     bg = get_bg(g)
  28: 
  29:     comps = components_mask(g != bg, connectivity=4)
  30:     singles: list[tuple[int, int, int]] = []
  31:     blocks: list[tuple[int, int, int, int]] = []  # (r0,c0,size,color)
  32:     for pts in comps:
  33:         if len(pts) == 1:
  34:             r, c = pts[0]
  35:             singles.append((int(r), int(c), int(g[r, c])))
  36:             continue
  37:         r0, c0, r1, c1 = bbox_coords(pts)
  38:         hh, ww = r1 - r0 + 1, c1 - c0 + 1
  39:         if hh != ww or hh < 2:
  40:             continue
  41:         sub = g[r0 : r1 + 1, c0 : c1 + 1]
  42:         col = int(sub[0, 0])
  43:         if col == bg:
  44:             continue
  45:         if np.all(sub == col) and sub.size == len(pts):
  46:             blocks.append((int(r0), int(c0), int(hh), col))
  47: 
  48:     assert singles and blocks, "grid must contain legend pixels and main blocks"
  49: 
  50:     # Legend pixels: singleton colored pixels in a small top-left window.
  51:     win_r = min(h, 12)
  52:     win_c = min(w, 12)
  53:     legend = [(r, c, v) for (r, c, v) in singles if r < win_r and c < win_c]
  54:     assert legend, "top-left legend must contain singleton pixels"
  55: 
  56:     # Infer legend lattice step (usually 2).
  57:     rs = sorted({r for r, _, _ in legend})
  58:     cs = sorted({c for _, c, _ in legend})
  59:     drs = [rs[i + 1] - rs[i] for i in range(len(rs) - 1)]
  60:     dcs = [cs[i + 1] - cs[i] for i in range(len(cs) - 1)]
  61:     stepL = reduce(gcd, drs + dcs)
  62:     assert stepL > 0, "legend lattice step must be positive"
  63:     rmin = min(r for r, _, _ in legend)
  64:     cmin = min(c for _, c, _ in legend)
  65: 
  66:     legend_pts: list[tuple[int, int, int]] = []
  67:     for r, c, v in legend:
  68:         rr = (r - rmin) // stepL
  69:         cc = (c - cmin) // stepL
  70:         legend_pts.append((int(rr), int(cc), int(v)))
  71: 
  72:     # Determine typical block size and step between blocks.
  73:     sizes = [s for _, _, s, _ in blocks]
  74:     _vals, _cnts = np.unique(np.array(sizes, dtype=int), return_counts=True)
  75:     block_size = int(_vals[_cnts.argmax()])
  76:     blocks = [b for b in blocks if b[2] == block_size]
  77:     assert blocks, "must contain at least one block of the dominant block size"
  78: 
  79:     by_color: dict[int, list[tuple[int, int]]] = {}
  80:     for r0, c0, s, col in blocks:
  81:         by_color.setdefault(int(col), []).append((int(r0), int(c0)))
  82:     for col in by_color:
  83:         by_color[col].sort()
  84: 
  85:     # Compute step from block top-left positions (gcd of diffs).
  86:     tops = sorted({r0 for r0, _, _, _ in blocks})
  87:     lefts = sorted({c0 for _, c0, _, _ in blocks})
  88:     step_candidates = []
  89:     step_candidates += [tops[i + 1] - tops[i] for i in range(len(tops) - 1)]
  90:     step_candidates += [lefts[i + 1] - lefts[i] for i in range(len(lefts) - 1)]
  91:     step = reduce(gcd, step_candidates)
  92:     assert step > 0, "block step must be positive"
  93: 
  94:     # Infer base offset: choose base that best maps legend pixels with existing block colors.
  95:     bases: dict[tuple[int, int], int] = {}
  96:     for rr, cc, col in legend_pts:
  97:         if col not in by_color:
  98:             continue
  99:         for br0, bc0 in by_color[col]:
 100:             base_r = br0 - rr * step
 101:             base_c = bc0 - cc * step
 102:             bases[(base_r, base_c)] = bases.get((base_r, base_c), 0) + 1
 103:     assert bases, "existing blocks must determine the legend-to-grid offset"
 104:     max_votes = max(bases.values())
 105:     best_bases = [base for base, votes in bases.items() if votes == max_votes]
 106:     assert len(best_bases) == 1, "legend-to-grid offset must be unique"
 107:     base = best_bases[0]
 108:     base_r, base_c = base
 109: 
 110:     # Paint blocks for all legend pixels (usually adding missing ones).
 111:     for rr, cc, col in legend_pts:
 112:         tr0 = base_r + rr * step
 113:         tc0 = base_c + cc * step
 114:         assert 0 <= tr0 <= h - block_size and 0 <= tc0 <= w - block_size, \
 115:             "legend block projection must fit in canvas"
 116:         out[tr0 : tr0 + block_size, tc0 : tc0 + block_size] = col
 117:     return out

