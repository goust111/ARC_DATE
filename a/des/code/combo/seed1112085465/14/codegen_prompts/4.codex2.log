+def _can_place(
+    entity_rect: tuple[int, int, int, int],
+    shadow_rect: tuple[int, int, int, int],
+    entity_rects: dict[int, tuple[int, int, int, int]],
+    shadow_rects: dict[int, tuple[int, int, int, int]],
+    grid_h: int,
+    grid_w: int,
+    overlap_shadow_idx: int | None = None,
