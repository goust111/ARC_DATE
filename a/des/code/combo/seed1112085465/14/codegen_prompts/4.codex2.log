+def _shuffled_positions(rng: np.random.Generator, h: int, w: int, rect_h: int, rect_w: int) -> list[tuple[int, int]]:
+    positions = [(r, c) for r in range(h - rect_h + 1) for c in range(w - rect_w + 1)]
+    rng.shuffle(positions)
