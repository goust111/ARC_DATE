+def _size_pool(dr: int, dc: int) -> list[tuple[int, int]]:
+    sizes = []
+    for h in range(1, SIZE_LIMIT + 1):
+        for w in range(1, SIZE_LIMIT + 1):
+            if h * w < 2:
