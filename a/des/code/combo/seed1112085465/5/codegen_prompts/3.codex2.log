 174:       continue to the next corridor; after the last door, connect to the other
 175:       marker.
 176: 
 177:     Key insight:
 178:     - The three-pixel door segments mark the only crossing points through a set
 179:       of parallel walls, so the output is the corridor path threaded through
 180:       those centers.
 181:     """
 182:     g = np.asarray(grid, dtype=int)
 183:     bg, path_color, door_color, wall_color = _roles(g)
 184:     orientation, centers = _door_centers(g, door_color)
 185:     markers = _markers(g, path_color)
 186: 
 187:     if orientation == "vertical":
 188:         return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)
 189:     assert orientation == "horizontal"
 190:     return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)
 191: 
