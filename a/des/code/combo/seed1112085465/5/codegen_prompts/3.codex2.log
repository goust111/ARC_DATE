  35: def main(grid: np.ndarray) -> np.ndarray:
  36:     """
  37:     Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.
  38: 
  39:     Input structure:
  40:     - The background is the dominant color.
  41:     - One non-background color forms a single full-width horizontal divider row.
  42:     - The other non-background color forms 4-connected sprites above the divider.
  43: 
  44:     Rule:
  45:     - Clear the original sprite pixels.
  46:     - A one-column sprite falls to the bottom of its column and deletes the divider
  47:       pixel it crossed.
  48:     - Any wider sprite falls until its unique widest horizontal row is immediately
  49:       above the divider row; if the moved sprite overlaps the divider, it covers it.
  50: 
  51:     Key insight:
  52:     The red row is not a generic floor: only one-column sprites pass through to the
  53:     bottom, while wider sprites are registered by their widest horizontal segment.
  54:     """
  55:     g = np.asarray(grid, dtype=int)
  56:     H, W = g.shape
  57:     bg = int(get_bg(g))
  58:     line_r, line_color = _divider_row(g, bg)
  59: 
  60:     non_bg_colors = set(map(int, g.ravel())) - {bg}
  61:     sprite_colors = non_bg_colors - {line_color}
  62:     assert len(sprite_colors) == 1, "expected exactly one sprite color"
  63:     sprite_color = next(iter(sprite_colors))
  64: 
  65:     sprites = find_components(
  66:         g,
  67:         bg=bg,
  68:         colors=[sprite_color],
  69:         connectivity=4,
  70:         monochromatic=True,
  71:     )
  72:     assert sprites, "expected at least one sprite"
  73: 
  74:     out = g.copy()
  75:     out[g == sprite_color] = bg
  76:     occupied = np.zeros((H, W), dtype=bool)
  77: 
  78:     for sprite in sprites:
  79:         coords = sprite["coords"]
  80:         _r0, c0, r1, c1 = map(int, sprite["bbox"])
  81:         assert r1 < line_r, "all sprites must begin above the divider"
  82: 
  83:         if c0 == c1:
  84:             shift = H - 1 - r1
  85:             assert shift >= 0
  86:             assert int(out[line_r, c0]) == line_color
  87:             out[line_r, c0] = bg
  88:         else:
  89:             widest_r = _unique_widest_row(coords)
  90:             shift = line_r - 1 - widest_r
  91:             assert shift >= 0
  92: 
  93:         moved = coords.copy()
  94:         moved[:, 0] += shift
  95:         assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))
  96:         assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))
  97: 
  98:         for rr, cc in moved:
  99:             r = int(rr)
 100:             c = int(cc)
