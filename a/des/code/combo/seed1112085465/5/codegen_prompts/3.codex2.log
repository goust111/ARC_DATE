  83: def main(grid: np.ndarray) -> np.ndarray:
  84:     """
  85:     Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.
  86: 
  87:     Input structure
  88:     The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.
  89: 
  90:     Rule
  91:     Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.
  92: 
  93:     Key insight
  94:     The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.
  95:     """
  96:     g = np.asarray(grid, dtype=int)
  97:     bg = get_bg(g)
  98:     colors = colors_present(g, exclude={bg})
  99:     assert len(colors) == 2
 100: 
 101:     components_by_color = {
 102:         color: [
 103:             component["coords"]
 104:             for component in find_components(g, bg=bg, colors=[color], connectivity=8)
 105:         ]
 106:         for color in colors
 107:     }
 108: 
 109:     connector_colors = [
 110:         color
 111:         for color, components in components_by_color.items()
 112:         if len(components) == 1 and _segment_endpoints(components[0]) is not None
 113:     ]
 114:     sprite_colors = [
 115:         color
 116:         for color, components in components_by_color.items()
 117:         if _are_repeated_centered_sprites(components)
 118:     ]
 119:     assert len(connector_colors) == 1
 120:     assert len(sprite_colors) == 1
 121: 
 122:     connector_color = connector_colors[0]
 123:     sprite_color = sprite_colors[0]
 124:     assert connector_color != sprite_color
 125: 
 126:     endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])
 127:     assert endpoint_pair is not None
 128: 
 129:     sprite_components = components_by_color[sprite_color]
 130:     anchors: list[Coord] = []
 131:     for coords in sprite_components:
 132:         anchor = _center_anchor(coords)
 133:         assert anchor is not None
 134:         anchors.append(anchor)
 135:     assert _non_collinear_three(anchors), "three repeated sprites must form a non-collinear triangle"
 136: 
 137:     reference_anchor = _center_anchor(sprite_components[0])
 138:     assert reference_anchor is not None
 139:     sprite_offsets = [
 140:         (int(r - reference_anchor[0]), int(c - reference_anchor[1]))
 141:         for r, c in sprite_components[0]
 142:     ]
 143: 
 144:     out = np.full_like(g, bg)
 145:     for a, b in combinations(anchors, 2):
 146:         assert _straight_line_cells(a, b) is not None
 147:         draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)
 148: 
 149:     height, width = out.shape
 150:     for endpoint_r, endpoint_c in endpoint_pair:
 151:         for dr, dc in sprite_offsets:
 152:             r = endpoint_r + dr
 153:             c = endpoint_c + dc
 154:             assert 0 <= r < height and 0 <= c < width
 155:             out[r, c] = sprite_color
 156: 
 157:     return out
 158: 
