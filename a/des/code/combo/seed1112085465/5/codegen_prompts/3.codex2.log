 160: 
 161: # Canvas and colors.
 162: GRID_SIZE_MIN = 11
 163: GRID_SIZE_MAX = 16
 164: BACKGROUND_COLOR = 7
 165: FOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]
