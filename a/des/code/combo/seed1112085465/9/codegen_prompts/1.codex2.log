+def _transform_cells(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    out = set(cells)
+    for _ in range(random.randint(0, 3)):
+        out = {(c, -r) for r, c in out}
+    if random.random() < 0.5:
+        out = {(r, -c) for r, c in out}
+    if random.random() < 0.5:
+        out = {(-r, c) for r, c in out}
+    return _normalize_cells(out)
