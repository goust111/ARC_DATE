 107: def _has_flanked_boundary_gap(mask: np.ndarray) -> bool:
 108:     h, w = mask.shape
 109:     for c in range(w):
 110:         if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():
 111:             return True
 112:         if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():
 113:             return True
 114:     for r in range(h):
 115:         if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():
 116:             return True
 117:         if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():
 118:             return True
