+        cols = [cc for _, cc in coords]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        assert len(coords) == (r1 - r0 + 1) * (c1 - c0 + 1), "grey objects must be solid rectangles"
+        boxes.append((r0, c0, r1, c1))
