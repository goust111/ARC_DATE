+        if found is not None:
+            return found
+    return None
+
+
+def _sample_path_colors(length: int) -> list[int]:
+    palette_size = random.randint(2, min(5, len(COLOR_POOL)))
+    palette = random.sample(COLOR_POOL, palette_size)
