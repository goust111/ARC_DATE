+def _neighbors4(r: int, c: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
