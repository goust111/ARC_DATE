+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+GRID_MAX_SIZE = 30
+PAIR_COUNT_CHOICES = (1, 2, 3)
+MAX_SINGLE_COUNT = 2
+PAIR_RECT_RANGE = (3, 7)
+SINGLE_RECT_RANGE = (2, 6)
+BRIDGE_GAP_RANGE = (1, 6)
+PATCH_ATTEMPTS = 100
+LAYOUT_ATTEMPTS = 200
+ROW_COUNT_MAX = 3
+ROW_GAP_RANGE = (0, 2)
+COL_GAP_RANGE = (0, 2)
+OUTER_MARGIN_RANGE = (0, 3)
+EXTRA_PAD_RANGE = (0, 4)
