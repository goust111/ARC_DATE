+    cols = coords[:, 1]
+    if np.all(rows == rows[0]):
+        return int(cols.max()) - int(cols.min()) + 1 == len(coords)
+    if np.all(cols == cols[0]):
+        return int(rows.max()) - int(rows.min()) + 1 == len(coords)
+    return False
