+    out: list[tuple[int, int]] = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _full_height_separator_cols(g: np.ndarray) -> list[int]:
+    h, w = g.shape
+    cols = []
+    for c in range(w):
