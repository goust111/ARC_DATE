+        coord_a = assignments[room_a][edge_id]
+        coord_b = assignments[room_b][edge_id]
+        if coord_a == coord_b:
+            return None
+        if grid[coord_a] != BACKGROUND or grid[coord_b] != BACKGROUND:
+            return None
+        grid[coord_a] = color
+        grid[coord_b] = color
