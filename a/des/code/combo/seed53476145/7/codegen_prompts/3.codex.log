+import numpy as np
+
+
+BACKGROUND = 0
+GEN_WALL = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+ROOM_ROW_RANGE = (2, 4)
+ROOM_COL_RANGE = (2, 4)
+ROOM_SIZE_RANGE = (3, 5)
