+    boundary_rows = [0]
+    cursor = 0
+    for room_h in heights:
+        cursor += room_h + 1
+        boundary_rows.append(cursor)
+    boundary_cols = [0]
+    cursor = 0
+    for room_w in widths:
+        cursor += room_w + 1
+        boundary_cols.append(cursor)
+
+    for row in boundary_rows:
+        grid[row, :] = GEN_WALL
+    for col in boundary_cols:
+        grid[:, col] = GEN_WALL
+
+    rooms: list[dict] = []
+    top = 1
+    room_id = 0
+    for rr, room_h in enumerate(heights):
+        left = 1
+        for cc, room_w in enumerate(widths):
+            rooms.append(
+                {
+                    "id": room_id,
+                    "bbox": (top, left, top + room_h - 1, left + room_w - 1),
+                    "grid_pos": (rr, cc),
+                }
+            )
+            room_id += 1
+            left += room_w + 1
+        top += room_h + 1
