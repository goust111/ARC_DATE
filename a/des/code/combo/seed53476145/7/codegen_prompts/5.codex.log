            sprites.append(
                {
                    "color": color,
                    "coords": tuple(sorted(coords)),
                    "bbox": (r1, c1, r2, c2),
                    "crop": crop,
                    "center_r": (r1 + r2) / 2.0,
                    "center_c": (c1 + c2) / 2.0,
                }
            )

