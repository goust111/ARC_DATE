+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+QUADRANTS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+RADIUS_OPTIONS = (3, 4, 5, 6)
+MAX_GENERATION_ATTEMPTS = 500
