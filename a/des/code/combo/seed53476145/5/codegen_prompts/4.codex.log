+    for dr, dc in DIR4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _ordered_path(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
