+from __future__ import annotations
+
+import numpy as np
+
+
+BACKGROUND = 0
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
