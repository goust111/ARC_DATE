+    c1 = c0 + outer_w - 1
+
+    for r, c in _perimeter_cells(r0, c0, r1, c1):
+        grid[r, c] = WALL
+
+    if side == "top":
+        gap = (r0, random.randint(c0 + 1, c1 - 1))
+    elif side == "bottom":
+        gap = (r1, random.randint(c0 + 1, c1 - 1))
+    elif side == "left":
+        gap = (random.randint(r0 + 1, r1 - 1), c0)
+    else:
+        gap = (random.randint(r0 + 1, r1 - 1), c1)
+    grid[gap] = BG
+
+    return (r0, c0, r1, c1, side)
+
