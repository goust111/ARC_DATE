+    r0, c0, r1, c1, side = spec
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    for local_r, local_c, color in _sample_marker_positions(inner_h, inner_w, side):
+        grid[r0 + 1 + local_r, c0 + 1 + local_c] = color
+
