+
+BG = 0
+WALL = 1
+MARKER_COLORS = (2, 3, 4, 5, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
+REGION_COUNT_RANGE = (1, 4)
