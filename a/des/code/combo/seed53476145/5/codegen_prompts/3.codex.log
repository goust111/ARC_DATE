+            if side == "top":
+                markers.sort(key=lambda item: item[0])
+                for depth, (_row, color) in enumerate(markers):
+                    target[r0 + 1 + depth, c0 + 1 + local_c] = color
+            else:
+                markers.sort(key=lambda item: item[0], reverse=True)
+                for depth, (_row, color) in enumerate(markers):
