+        c0_min, c0_max = 0, w - fw
+    elif odd_side == "bottom":
+        r0_min, r0_max = 0, h - fh - sh
+        c0_min, c0_max = 0, w - fw
+    elif odd_side == "left":
+        r0_min, r0_max = 0, h - fh
+        c0_min, c0_max = sw, w - fw
+    else:
