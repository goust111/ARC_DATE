+    min_fh = max(GEN_FRAME_SIDE[0], sh + 4)
+    min_fw = max(GEN_FRAME_SIDE[0], sw + 4)
+    max_fh = GEN_FRAME_SIDE[1]
+    max_fw = GEN_FRAME_SIDE[1]
