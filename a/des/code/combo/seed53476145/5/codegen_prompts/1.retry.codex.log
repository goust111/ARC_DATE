+            grid[r0, c0 + 1 : c1] = odd_color
+        elif spec["odd_side"] == "bottom":
+            grid[r1, c0 + 1 : c1] = odd_color
+        elif spec["odd_side"] == "left":
+            grid[r0 + 1 : r1, c0] = odd_color
+        else:
+            grid[r0 + 1 : r1, c1] = odd_color
