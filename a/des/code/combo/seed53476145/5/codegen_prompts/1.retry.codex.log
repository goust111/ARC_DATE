+        grid[coords[:, 0], coords[:, 1]] = spec["sprite_color"]
+
+
+def _render_expected(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
+        if spec["odd_side"] is None:
