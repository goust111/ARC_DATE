+    row_colors = np.broadcast_to(row_headers[:, None], data.shape)
+    col_colors = np.broadcast_to(col_headers[None, :], data.shape)
+
+    repaired = data.copy()
+    same = row_colors == col_colors
+    repaired[same] = row_colors[same]
