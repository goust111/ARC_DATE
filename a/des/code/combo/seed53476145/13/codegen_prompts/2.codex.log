# Palette and canvas bounds.
COLOR_IDS = list(range(10))
GRID_SIZE_MIN = 20
GRID_SIZE_MAX = 27

# Panel layout bounds and options.
MIN_PANEL_DIM = 9
MIN_VISIBLE_BORDERS = 2
BORDER_CHOICES = (0, 1)
OFFSET_MIN = 2
OFFSET_MAX = 6
HORIZONTAL_LAYOUT = 0
VERTICAL_LAYOUT = 1
HORIZONTAL_OFFSETS = ("left", "right", "none")
VERTICAL_OFFSETS = ("top", "bottom", "none")

