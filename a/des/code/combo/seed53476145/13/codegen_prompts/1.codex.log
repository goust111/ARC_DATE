+    for top in range(-min_r, height - max_r):
+        if spec["clip_y"]:
+            if top + sprite_h > height or top + exp_h <= height:
+                continue
+        else:
+            if top + exp_h > height:
+                continue
+
+        for left in range(-min_c, width - max_c):
+            if spec["clip_x"]:
