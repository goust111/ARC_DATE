+def _sprite_local(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
+    local[rel[:, 0], rel[:, 1]] = int(comp["color"])
+    return local
