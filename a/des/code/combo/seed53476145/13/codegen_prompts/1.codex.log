+        coords.append((int(row), int(col)))
+
+    if v_side == "up":
+        rows = [-2 - 2 * i for i in range(len(v_cols))]
+    elif v_side == "down":
+        rows = [sprite_h + 1 + 2 * i for i in range(len(v_cols))]
+    else:
+        rows = []
+    for row, col in zip(rows, v_cols):
+        coords.append((int(row), int(col)))
+
+    assert len(coords) == len(set(coords))
+    return coords
