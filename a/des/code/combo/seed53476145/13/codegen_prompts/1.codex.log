+
+    out = np.full_like(g, BG)
+
+    for sprite in sprites:
+        color = int(sprite["color"])
+        r0, c0, _r1, _c1 = sprite["bbox"]
+        local = _sprite_local(sprite)
+        sprite_h, sprite_w = map(int, local.shape)
+
+        horiz = 0
+        vert = 0
+        for mr, mc in markers_by_color.get(color, []):
