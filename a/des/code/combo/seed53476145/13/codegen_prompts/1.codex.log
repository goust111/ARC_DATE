+def _choose_clip_map(cases: list[str]) -> dict[int, str | None]:
+    clip_map = {i: None for i in range(len(cases))}
+    stretchable = [i for i, case in enumerate(cases) if case != "none"]
+    if not stretchable or random.random() >= 0.25:
+        return clip_map
