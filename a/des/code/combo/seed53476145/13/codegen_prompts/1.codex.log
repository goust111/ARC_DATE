+        "case": case,
+        "mask": mask,
+        "sprite_h": int(sprite_h),
+        "sprite_w": int(sprite_w),
+        "kh": int(kh),
+        "kv": int(kv),
+        "clip_x": bool(clip_x),
+        "clip_y": bool(clip_y),
