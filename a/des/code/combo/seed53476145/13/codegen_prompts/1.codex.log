+    input_cells = spec["sprite_cells"] + spec["marker_cells"]
+    min_r = min(r for r, _ in input_cells)
+    max_r = max(r for r, _ in input_cells)
+    min_c = min(c for _, c in input_cells)
+    max_c = max(c for _, c in input_cells)
