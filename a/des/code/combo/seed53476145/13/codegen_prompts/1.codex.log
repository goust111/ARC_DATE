+        sprite_h = int(r1 - r0 + 1)
+        sprite_w = int(c1 - c0 + 1)
+        assert 3 <= area <= 6, "sprite area must be 3..6"
+        assert sprite_h <= 3 and sprite_w <= 3, "sprite bbox must fit in 3x3"
