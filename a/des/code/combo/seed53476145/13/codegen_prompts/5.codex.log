        s, orient, locs = random.choice(choices)
        r, c = random.choice(locs)
        h, w = _object_dims(s, orient)
        originals.append((r, c, r + h - 1, c + w - 1))
        expanded.append(_expanded_bbox(r, c, h, w))
        placed.append((r, c, s, orient))

    return placed


