+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+SEED_COLORS = tuple(range(2, 10))
+
+DIRECTIONS = ("up", "down", "left", "right")
+STEPS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+
+REGION_COUNT_RANGE = (3, 6)
+GRID_MAX = 30
+RECT_H_RANGE = (5, 8)
+RECT_W_RANGE = (5, 8)
+PLACE_TRIES = 120
+GEN_TRIES = 400
