    39	def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    40	    h, w = mask.shape
    41	    seen = np.zeros_like(mask, dtype=bool)
    42	    comps: list[list[tuple[int, int]]] = []
    43	    for r, c in np.argwhere(mask):
    44	        rr = int(r)
    45	        cc = int(c)
    46	        if seen[rr, cc]:
    47	            continue
    48	        stack = [(rr, cc)]
    49	        seen[rr, cc] = True
    50	        comp: list[tuple[int, int]] = []
    51	        while stack:
    52	            cr, cc = stack.pop()
    53	            comp.append((cr, cc))
    54	            for dr, dc in STEPS.values():
    55	                nr = cr + dr
    56	                nc = cc + dc
    57	                if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
    58	                    seen[nr, nc] = True
    59	                    stack.append((nr, nc))
    60	        comps.append(comp)
    61	    return comps
