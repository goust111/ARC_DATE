   466	def _gen_attempt() -> np.ndarray | None:
   467	    region_count = random.randint(*REGION_COUNT_RANGE)
   468	    min_side = 14 + 2 * region_count
   469	    if min_side > GRID_MAX:
   470	        return None
   471	    shape = (
   472	        random.randint(min_side, GRID_MAX),
   473	        random.randint(min_side, GRID_MAX),
