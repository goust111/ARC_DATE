def _direction_search_order(preferred: str, forbidden: str) -> list[str]:
    order = []
    if preferred != forbidden:
        order.append(preferred)
    rest = [d for d in DIRECTIONS if d not in order and d != forbidden]
    random.shuffle(rest)
    order.extend(rest)
