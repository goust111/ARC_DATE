+    if abs(dr2) > abs(dc2):
+        return "down" if dr2 > 0 else "up"
+    return "right" if dc2 > 0 else "left"
+
+
+def _gap_and_step(
+    bbox: tuple[int, int, int, int], seed: tuple[int, int], direction: str
