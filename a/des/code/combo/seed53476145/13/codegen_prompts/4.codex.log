+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    expected = np.zeros(sub.shape, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(sub == WALL, expected))
