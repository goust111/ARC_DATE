+        out[gap] = BG
+        r = gap[0] + step[0]
+        c = gap[1] + step[1]
+        while _in_bounds(g.shape, r, c) and not blue_mask[r, c]:
+            out[r, c] = color
+            r += step[0]
+            c += step[1]
