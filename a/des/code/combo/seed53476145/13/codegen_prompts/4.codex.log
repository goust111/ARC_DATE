   153	def main(grid: np.ndarray) -> np.ndarray:
   154	    """
   155	    Open one wall gap per rectangular enclosure based on the seed's dominant offset
   156	    from the center, then cast the seed color outward from that gap.
   157	    """
   158	    g = np.asarray(grid, dtype=int)
   159	    out = g.copy()
   160	    blue_mask = g == WALL
   161	
   162	    for region in _parse_regions(g):
   163	        bbox = region["bbox"]
   164	        seed = region["seed"]
   165	        color = int(region["color"])
   166	        direction = _primary_direction(bbox, seed)
   167	        gap, step = _gap_and_step(bbox, seed, direction)
   168	
   169	        out[gap] = BG
   170	        r = gap[0] + step[0]
   171	        c = gap[1] + step[1]
   172	        while _in_bounds(g.shape, r, c) and not blue_mask[r, c]:
   173	            out[r, c] = color
   174	            r += step[0]
   175	            c += step[1]
   176	
   177	    return out
