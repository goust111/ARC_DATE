+
+def _mark_bbox(blocked: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> None:
+    r0, c0, r1, c1 = _expanded_bbox(bbox, blocked.shape, pad=pad)
+    blocked[r0 : r1 + 1, c0 : c1 + 1] = True
+
