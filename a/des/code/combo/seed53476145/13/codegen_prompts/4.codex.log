+    regions: list[dict[str, object]] = []
+    seen_seed_cells = 0
+    for comp in _components4(g == WALL):
+        box = _bbox(comp)
+        assert _is_rect_frame(g, box), "each blue component must be a one-pixel-thick rectangle"
