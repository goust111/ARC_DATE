+            max_r0 = min(h - bh - 1, sr - 1)
+            min_c0 = 1
+            max_c0 = ec0 - bw - 2
+            if min_r0 > max_r0 or min_c0 > max_c0:
+                continue
+            br0 = random.randint(min_r0, max_r0)
