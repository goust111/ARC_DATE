   477	    directions = _balanced_direction_pool(region_count)
   478	    pair_count = _choose_pair_count(region_count)
   479	    actions = ["pair"] * pair_count + ["single"] * (region_count - 2 * pair_count)
   480	    random.shuffle(actions)
   481	
   482	    blocked = np.zeros(shape, dtype=bool)
   483	    regions: list[dict[str, object]] = []
   484	    color_idx = 0
   485	    dir_idx = 0
   486	
   487	    for action in actions:
   488	        if action == "single":
   489	            region = _place_single(
   490	                shape,
   491	                blocked,
   492	                directions[dir_idx],
   493	                colors[color_idx],
   494	            )
   495	            if region is None:
   496	                return None
   497	            regions.append(region)
   498	            color_idx += 1
   499	            dir_idx += 1
   500	        else:
   501	            pair = _place_pair(
   502	                shape,
   503	                blocked,
   504	                directions[dir_idx],
   505	                directions[dir_idx + 1],
   506	                colors[color_idx],
   507	                colors[color_idx + 1],
   508	            )
   509	            if pair is None:
   510	                return None
   511	            regions.extend(pair)
   512	            color_idx += 2
   513	            dir_idx += 2
   514	
   515	    inp = _render_input(shape, regions)
   516	    expected = _render_expected(inp, regions)
   517	
   518	    try:
   519	        actual = main(inp)
   520	    except Exception:
   521	        return None
   522	    if not np.array_equal(actual, expected):
   523	        return None
   524	
   525	    stop_modes = {region["stop"] for region in regions}
   526	    if pair_count == 0 and "wall" in stop_modes:
   527	        return None
   528	    if pair_count > 0 and "wall" not in stop_modes:
   529	        return None
   530	    if len({_primary_direction(region["bbox"], region["seed"]) for region in regions}) < min(4, region_count):
   531	        return None
