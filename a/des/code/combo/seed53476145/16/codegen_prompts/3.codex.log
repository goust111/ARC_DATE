+
+
+def _seed_cells(cells: list[tuple[int, int]], k: int) -> list[tuple[int, int]]:
+    shuffled = cells[:]
+    random.shuffle(shuffled)
+    seeds: list[tuple[int, int]] = []
+    for cell in shuffled:
+        if all(abs(cell[0] - sr) + abs(cell[1] - sc) >= 3 for sr, sc in seeds):
+            seeds.append(cell)
+            if len(seeds) == k:
