+
+def _anchor_shape(local_h: int, local_w: int) -> np.ndarray:
+    mask = np.zeros((local_h, local_w), dtype=bool)
+    mask[1, 0] = True
+    mask[2, 1] = True
+    mask[2:5, 2:5] = True
