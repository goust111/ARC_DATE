+def _random_growth_mask(local_h: int, local_w: int) -> np.ndarray | None:
+    base = _anchor_shape(local_h, local_w)
+    mask = base.copy()
+    allowed = np.zeros_like(mask, dtype=bool)
+    allowed[3:, 3:] = True
+    allowed &= ~mask
