+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and shape_mask[nr, nc]:
+                degree += 1
+        out[r, c] = legend_colors[min(degree, 3)]
+    return out
+
+
+def _anchor_shape(local_h: int, local_w: int) -> np.ndarray:
