+    grid[:, LEGEND_WIDTH] = SEPARATOR
+
+    for row, color, template in zip(entry_rows, colors, templates):
+        grid[row : row + 2, 0:2] = color
+        patch = grid[row + 2 : row + 5, 0:3]
+        patch[template] = SEPARATOR
