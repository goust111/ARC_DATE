+    max_outer_w = max(inner_w + 2 for _, inner_w in sizes)
+    min_h = max(legend_height, max_outer_h + 2, 12)
+    min_w = max(LEGEND_WIDTH + 2 + max_outer_w + 1, 18)
+    if min_h > GRID_HEIGHT_MAX or min_w > GRID_WIDTH_MAX:
