+def _find_regions(grid: np.ndarray, bg: int) -> list[dict[str, tuple[int, int, int, int] | str]]:
+    regions: list[dict[str, tuple[int, int, int, int] | str]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == int(bg):
