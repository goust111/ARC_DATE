WIDTH_RANGE = (5, 23)
INPUT_HEIGHT_RANGE = (7, 13)
BAR_ROW = 0
BAR_WIDTH_PADDING = 2
# Oracle retry limit.
GENERATION_RETRIES = 300


def _expected_output(width: int, color: int, n: int) -> np.ndarray:
    run_lengths = list(range(1, n + 1)) + list(range(n - 1, 0, -1))
    seq: list[int] = []
    for i, run_len in enumerate(run_lengths):
