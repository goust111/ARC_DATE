    return [marker_colors[0]], [marker_colors[1], marker_colors[2]]


def _put_marker(grid: np.ndarray, orientation: str, line: int, pos: int, color: int) -> None:
    if orientation == HORIZONTAL:
        grid[pos, line] = color
    else:
        grid[line, pos] = color


