+        return None
+    return legend
+
+
+def _expected_scene(scene: np.ndarray, legend_map: dict[tuple[tuple[int, int], bytes], int]) -> np.ndarray:
+    out = scene.copy()
+    for coords in _components(scene != GREY):
+        key = _shape_key_from_coords(coords)
+        color = legend_map.get(key)
