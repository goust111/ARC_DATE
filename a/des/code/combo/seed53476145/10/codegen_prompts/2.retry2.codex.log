+
+def _render_legend(
+    grid_w: int,
+    legend_shapes: list[np.ndarray],
+    legend_colors: list[int],
+) -> np.ndarray | None:
+    legend = np.full((3, grid_w), BLUE, dtype=int)
+    left_margin = random.randint(1, 2)
+    col = left_margin
