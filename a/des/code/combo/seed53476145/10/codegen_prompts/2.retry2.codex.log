+        patch = _render_pair(shape, color)
+        if col + patch.shape[1] > grid_w - 1:
+            return None
+        legend[:, col : col + patch.shape[1]] = patch
+        col += patch.shape[1]
+        if idx != len(legend_shapes) - 1:
