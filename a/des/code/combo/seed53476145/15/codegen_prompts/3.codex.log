0018: def main(grid: np.ndarray) -> np.ndarray:
0019:     """Render the filled-square object counts as compact nested stacks ordered by count rank.
0020: 
0021:     Input structure
0022:     A large noisy grid has a dominant background, scattered non-square noise, and
0023:     filled monochrome square objects. Each square side length has exactly one
0024:     object color, and side lengths form consecutive sizes.
0025: 
0026:     Rule
0027:     Ignore non-square components. If the lowest square in the scene is of the
0028:     smallest side length, treat that one smallest square as a distractor and do
0029:     not count it. For count rank k from left to right, create one block from all
0030:     square sizes with at least k remaining objects; draw larger squares first and
0031:     smaller squares over their upper-left corner, then append one background
0032:     separator column.
0033: 
0034:     Key insight
0035:     The output is a count histogram of square side lengths, but each histogram
0036:     slot is rendered as nested upper-left square masks using the side colors.
0037:     """
0038:     g = np.asarray(grid, dtype=int)
0039:     assert g.ndim == 2, "expected a 2D grid"
0040: 
0041:     bg = get_bg(g)
0042:     objects = _square_objects(g, bg)
0043:     assert objects, "expected filled square objects"
0044: 
0045:     sides = sorted({obj["side"] for obj in objects})
0046:     assert sides == list(range(sides[0], sides[-1] + 1)), "expected consecutive square side lengths"
0047: 
0048:     by_side = {side: [obj for obj in objects if obj["side"] == side] for side in sides}
0049:     colors = {}
0050:     for side, side_objects in by_side.items():
0051:         side_colors = {obj["color"] for obj in side_objects}
0052:         assert len(side_colors) == 1, "each side length should have one color"
0053:         colors[side] = side_colors.pop()
0054: 
0055:     smallest = sides[0]
0056:     lowest_row = max(obj["bbox"][2] for obj in objects)
0057:     lowest_smallest = [obj for obj in by_side[smallest] if obj["bbox"][2] == lowest_row]
0058:     if lowest_smallest:
0059:         assert len(lowest_smallest) == 1, "expected at most one lowest smallest distractor"
0060:         drop_bbox = lowest_smallest[0]["bbox"]
0061:         by_side[smallest] = [obj for obj in by_side[smallest] if obj["bbox"] != drop_bbox]
0062: 
0063:     counts = {side: len(side_objects) for side, side_objects in by_side.items()}
0064:     assert all(count > 0 for count in counts.values()), "each square size should remain represented"
0065: 
0066:     out_h = sides[-1] + 1
0067:     groups = []
0068:     for rank in range(max(counts.values())):
0069:         present_sides = [side for side in sides if counts[side] > rank]
0070:         assert present_sides, "rank should contain at least one square size"
0071: 
0072:         group_w = max(present_sides)
0073:         group = np.full((out_h, group_w), bg, dtype=int)
0074:         for side in sorted(present_sides, reverse=True):
0075:             group[:side, :side] = colors[side]
0076:         groups.append(group)
0077: 
0078:     out_w = sum(group.shape[1] + 1 for group in groups)
0079:     out = np.full((out_h, out_w), bg, dtype=int)
0080:     c = 0
0081:     for group in groups:
0082:         w = group.shape[1]
0083:         out[:, c : c + w] = group
0084:         c += w + 1
0085: 
0086:     return out
0087: 
