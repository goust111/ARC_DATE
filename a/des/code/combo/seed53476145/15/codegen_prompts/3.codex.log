0115: def _make_square_queue(
0116:     counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool
0117: ) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
0118:     """Return regular squares plus the separately placed distractor candidate."""
0119:     squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]
0120:     if has_distractor:
0121:         squares.append((SIDES[0], square_colors[SIDES[0]]))
0122: 
0123:     random.shuffle(squares)
