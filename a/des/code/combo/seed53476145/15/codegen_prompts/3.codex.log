0128: def _gen_draw_axis(grid: np.ndarray, axis_kind: str, color: int) -> None:
0129:     n = grid.shape[0]
0130:     if axis_kind == "row":
0131:         grid[n // 2, :] = color
0132:     elif axis_kind == "col":
0133:         grid[:, n // 2] = color
0134:     elif axis_kind == "main_diag":
0135:         np.fill_diagonal(grid, color)
0136:     else:
0137:         np.fill_diagonal(np.fliplr(grid), color)
0138: 
0139: 
0140: def _gen_side_mask(n: int, axis_kind: str, side: int) -> np.ndarray:
0141:     rr, cc = np.indices((n, n))
0142:     if axis_kind == "row":
0143:         return rr < n // 2 if side == 0 else rr > n // 2
0144:     if axis_kind == "col":
0145:         return cc < n // 2 if side == 0 else cc > n // 2
0146:     if axis_kind == "main_diag":
0147:         return cc > rr if side == 0 else cc < rr
0148:     return rr + cc < n - 1 if side == 0 else rr + cc > n - 1
