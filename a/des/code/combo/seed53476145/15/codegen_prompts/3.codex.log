0071: def main(grid: np.ndarray) -> np.ndarray:
0072:     """
0073:     Mirror the smallest non-axis foreground color across the full straight axis.
0074: 
0075:     Input structure
0076:     - The background is the dominant color.
0077:     - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.
0078:     - The remaining foreground colors include a unique least-populated color to copy.
0079: 
0080:     Rule
0081:     - Preserve the input grid.
0082:     - Select every pixel of the unique smallest non-axis foreground color.
0083:     - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.
0084: 
0085:     Key insight
0086:     - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.
0087:     """
0088:     g = np.asarray(grid, dtype=int)
0089:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0090: 
0091:     bg = get_bg(g)
0092:     axis = _find_reflection_axis(g, bg)
0093:     axis_color = axis[0]
0094:     mirror_color = _smallest_non_axis_color(g, bg, axis_color)
0095: 
0096:     out = g.copy()
0097:     h, w = g.shape
0098:     for r_raw, c_raw in np.argwhere(g == mirror_color):
0099:         r = int(r_raw)
0100:         c = int(c_raw)
0101:         rr, cc = _reflect(axis, g.shape, r, c)
0102:         assert 0 <= rr < h and 0 <= cc < w, "reflected pixel must stay inside the grid"
0103:         assert int(out[rr, cc]) in {bg, mirror_color}, "reflection cannot overwrite another foreground object"
0104:         out[rr, cc] = mirror_color
0105: 
0106:     return out
0107: 
