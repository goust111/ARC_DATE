0161: def _gen_feasible_counts(total: int, lo: int, hi: int) -> list[int]:
0162:     return [count for count in _GEN_COMPONENT_COUNT_RANGE if count * lo <= total <= count * hi]
0163: 
0164: 
0165: def _gen_partition(total: int, count: int, lo: int, hi: int) -> list[int]:
0166:     sizes = []
0167:     remaining = total
0168:     for idx in range(count):
0169:         left = count - idx - 1
0170:         cur_lo = max(lo, remaining - left * hi)
0171:         cur_hi = min(hi, remaining - left * lo)
0172:         size = random.randint(cur_lo, cur_hi)
0173:         sizes.append(size)
0174:         remaining -= size
0175:     random.shuffle(sizes)
0176:     return sizes
0177: 
