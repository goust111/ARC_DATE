0059: def main(grid: np.ndarray) -> np.ndarray:
0060:     """
0061:     Fill the small background compartments bounded by the long contour color.
0062: 
0063:     Input structure:
0064:     - The grid has one dominant background color and two foreground colors.
0065:     - The more frequent foreground color forms long 8-connected contour fragments.
0066:     - The other foreground color is a fixed distractor/obstacle color that partitions
0067:       the background but is never recolored.
0068: 
0069:     Rule:
0070:     - Split the background into 4-connected regions using all foreground pixels as
0071:       barriers.
0072:     - Keep the two largest background regions as the outside of the contour drawing.
0073:     - Recolor every other background region that touches a long contour component
0074:       to the contour color; leave all foreground pixels unchanged.
0075: 
0076:     Key insight:
0077:     The apparent area fill is exactly a component-level fill of bounded background
0078:     compartments, not a row-wise interpolation between individual contour pixels.
0079:     """
0080:     g = np.asarray(grid, dtype=int)
0081:     bg = get_bg(g)
0082:     foreground = colors_present(g, exclude={bg})
0083:     assert len(foreground) == 2, "expected exactly two foreground colors"
0084: 
0085:     fill_color = _unique_largest_color(g, foreground)
0086:     fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)
0087:     long_ids = _long_component_ids(fill_lab, _n_fill)
0088: 
0089:     bg_lab, n_bg = label_mask(g == bg, connectivity=4)
0090:     exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)
0091: 
0092:     out = g.copy()
0093:     for comp_id in range(1, n_bg + 1):
0094:         if comp_id in exterior_ids:
0095:             continue
0096:         coords = np.argwhere(bg_lab == comp_id)
0097:         if _touches_long_contour(coords, fill_lab, long_ids):
0098:             out[bg_lab == comp_id] = fill_color
0099: 
0100:     return out
0101: 
