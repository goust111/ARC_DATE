0101: def _sample_mask(rng: np.random.Generator, n: int) -> np.ndarray:
0102:     """Return an n x n random mask whose actual fill passes the solver-facing bounds."""
0103:     while True:
0104:         fill = rng.uniform(MASK_FILL_MIN, MASK_FILL_MAX)
0105:         mask = rng.random((n, n)) < fill
0106:         actual_fill = mask.sum() / (n * n)
0107:         if MIN_ACTUAL_FILL < actual_fill < MAX_ACTUAL_FILL:
0108:             return mask
