0180:     mirror_total = random.randint(*_GEN_MIRROR_TOTAL_RANGE)
0181:     ratio_num, ratio_den = _GEN_MIN_NONMIRROR_RATIO
0182:     nonmirror_lo = max(
0183:         _GEN_NONMIRROR_TOTAL_RANGE[0],
0184:         (ratio_num * mirror_total + ratio_den - 1) // ratio_den,
0185:     )
0186:     nonmirror_hi = min(_GEN_NONMIRROR_TOTAL_RANGE[1], _GEN_MAX_NONMIRROR_MULTIPLIER * mirror_total)
0187:     nonmirror_total = random.randint(nonmirror_lo, nonmirror_hi)
0188: 
0189:     mirror_count = random.choice(_gen_feasible_counts(mirror_total, *_GEN_MIRROR_COMPONENT_SIZE_RANGE))
0190:     nonmirror_count = random.choice(_gen_feasible_counts(nonmirror_total, *_GEN_NONMIRROR_COMPONENT_SIZE_RANGE))
0191:     mirror_sizes = _gen_partition(mirror_total, mirror_count, *_GEN_MIRROR_COMPONENT_SIZE_RANGE)
