0030: def main(grid: np.ndarray) -> np.ndarray:
0031:     """Expand the second mask into a block grid by stamping the first mask with the two payload colors.
0032: 
0033:     Input structure
0034:     - A background grid has four panels separated by three full-height separator columns.
0035:     - The first two panels contain same-size binary masks; the last two contain solid same-size color squares.
0036:     Rule
0037:     - Use the second mask as an outer layout. For each foreground cell in that outer mask, place a tile equal to the first mask, coloring its foreground with the first solid-square color and its background with the second solid-square color; outer background cells become all second solid-square color.
0038:     Key insight
0039:     - The output is the Kronecker product of the two binary masks, with the two right-hand panel colors providing the palette.
0040:     """
0041:     g = np.asarray(grid, dtype=int)
0042:     h, w = g.shape
0043:     bg = _unique_dominant_color(g)
0044: 
0045:     sep_cols = [
0046:         c
0047:         for c in range(w)
0048:         if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg
0049:     ]
0050:     assert len(sep_cols) == 3
0051:     sep_colors = {int(g[0, c]) for c in sep_cols}
0052:     assert len(sep_colors) == 1
0053: 
0054:     cuts = [-1, *sep_cols, w]
0055:     spans = [(cuts[i] + 1, cuts[i + 1]) for i in range(4)]
0056:     assert all(c0 < c1 for c0, c1 in spans)
0057: 
0058:     masks: list[np.ndarray] = []
0059:     colors: list[int] = []
0060:     for c0, c1 in spans:
0061:         mask, color = _extract_panel_mask(g[:, c0:c1], bg)
0062:         masks.append(mask)
0063:         colors.append(color)
0064: 
0065:     n = masks[0].shape[0]
0066:     assert n > 0
0067:     assert h == n + 2
0068:     assert all(mask.shape == (n, n) for mask in masks)
0069:     assert masks[2].all()
0070:     assert masks[3].all()
0071:     assert colors[2] != colors[3]
0072: 
0073:     painted = np.kron(masks[1], masks[0])
0074:     out = np.full((n * n, n * n), colors[3], dtype=int)
0075:     out[painted] = colors[2]
0076:     assert out.shape == (n * n, n * n)
0077:     return out
0078: 
