0151: def _gen_reflect(axis_kind: str, n: int, r: int, c: int) -> tuple[int, int]:
0152:     if axis_kind == "row":
0153:         return n - 1 - r, c
0154:     if axis_kind == "col":
0155:         return r, n - 1 - c
0156:     if axis_kind == "main_diag":
0157:         return c, r
0158:     return n - 1 - c, n - 1 - r
