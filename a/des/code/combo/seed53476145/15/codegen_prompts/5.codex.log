+
+def _shape_signature(mask: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, int], ...]]:
+    rows, cols = np.nonzero(mask)
+    coords = tuple(sorted((int(r), int(c)) for r, c in zip(rows.tolist(), cols.tolist())))
+    return mask.shape, coords
