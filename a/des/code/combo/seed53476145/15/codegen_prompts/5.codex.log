+
+def _random_connected_mask(rng: np.random.Generator) -> np.ndarray:
+    box_h = int(rng.integers(1, SHAPE_SIDE_MAX + 1))
+    box_w = int(rng.integers(1, SHAPE_SIDE_MAX + 1))
