+
+# --------------- generator ---------------
+
+GRID_MIN_SIZE = 20
+GRID_MAX_SIZE = 30
+PAIR_COUNT_CHOICES = (1, 2, 3)
+UNPAIRED_COUNT_CHOICES = (0, 1, 2, 3)
+SHAPE_SIDE_MAX = 4
+LINE_LENGTH_MIN = 1
+LINE_LENGTH_MAX = 6
+PLACE_RETRIES = 180
+GENERATION_ATTEMPTS = 400
