+from __future__ import annotations
+
+import numpy as np
+
+
+BG_COLOR = 0
+LINE_COLOR = 5
+PALETTE = tuple(color for color in range(10) if color not in {BG_COLOR, LINE_COLOR})
+ORTHO_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))
