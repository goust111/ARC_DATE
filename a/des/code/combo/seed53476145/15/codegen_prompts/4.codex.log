+    grid = _draw_rectangles(shape, rectangles)
+    out = main(grid)
+    expected = _compress_rectangles(shape, rectangles, AZURE)
+
+    if np.array_equal(grid, out):
+        return None
+    if not np.array_equal(out, expected):
+        return None
+    return grid
+
