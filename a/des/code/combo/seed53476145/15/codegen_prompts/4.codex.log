+    shape: tuple[int, int], rectangles: list[tuple[int, tuple[int, int, int, int]]]
+) -> np.ndarray:
+    grid = np.full(shape, AZURE, dtype=int)
+    for color, (r0, c0, r1, c1) in rectangles:
+        grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+    return grid
+
