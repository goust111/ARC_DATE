+                        continue
+                    if not np.all(g[r0 + 1 : r1, c0] == GREY):
+                        continue
+                    if not np.all(g[r0 + 1 : r1, c1] == GREY):
+                        continue
+                    if np.any(g[r0 + 1 : r1, c0 + 1 : c1] == GREY):
