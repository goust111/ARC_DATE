+def _find_panes(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    marker_mask = np.isin(g, MARKER_COLORS)
+    panes: list[tuple[int, int, int, int]] = []
+
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
