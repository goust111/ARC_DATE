+) -> tuple[np.ndarray, np.ndarray] | None:
+    stage_h, stage_w = STAGING_SHAPE
+    grid_in = np.zeros((stage_h, stage_w), dtype=int)
+    grid_out = np.zeros((stage_h, stage_w), dtype=int)
+    occupied = np.zeros((stage_h, stage_w), dtype=bool)
