SPRITE_DIM_SWAP_PROB = 0.5
SPRITE_QUADRANT_FILL_PROB = 0.5
SPRITE_BUILD_RETRIES = 50

# Anchor layout.
THREE_SPRITE_PROB = 0.85
ANCHOR_LAYOUT_RETRIES = 100
ANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']
TWO_ANCHOR_DIST_MIN = 3
TWO_ANCHOR_DIST_MAX = 8
