+    h = int(RNG.integers(GRID_HEIGHT_RANGE[0], GRID_HEIGHT_RANGE[1] + 1))
+    w = int(RNG.integers(GRID_WIDTH_RANGE[0], GRID_WIDTH_RANGE[1] + 1))
