+    cc0 = max(0, c0 - halo)
+    rr1 = min(h - 1, r1 + halo)
+    cc1 = min(w - 1, c1 + halo)
+    return not np.any(blocked[rr0 : rr1 + 1, cc0 : cc1 + 1])
