+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                }
+            )
+    return components
+
+
+def _normalized_shape(component: dict[str, object]) -> tuple[int, int, frozenset[tuple[int, int]]]:
+    coords = np.asarray(component["coords"], dtype=int)
