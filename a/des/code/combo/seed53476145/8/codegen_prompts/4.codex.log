+
+    lr0, lc0, lr1, lc1 = left["bbox"]
+    rr0, rc0, rr1, rc1 = right["bbox"]
+
+    if lc1 >= rc0:
+        return None
+    if (lr0, lr1) != (rr0, rr1):
+        return None
+
