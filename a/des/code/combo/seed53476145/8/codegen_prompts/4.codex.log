+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or visited[r, c]:
+                continue
+
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
