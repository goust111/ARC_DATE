+            c += width + 1
+    else:
+        inner_w = _randint(rng, 2, 4)
+        heights = [_randint(rng, 1, 3) for _ in range(hole_count)]
+        h = sum(heights) + hole_count + 1
+        w = inner_w + 2
+        arr = np.full((h, w), color, dtype=int)
+        r = 1
+        for height in heights:
+            arr[r : r + height, 1:-1] = BG
+            r += height + 1
