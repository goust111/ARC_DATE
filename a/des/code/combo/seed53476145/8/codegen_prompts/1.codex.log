+
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_MIN = 24
+GRID_MAX = 32
+OBJECT_COUNT_CHOICES = (3, 4)
+GEN_ATTEMPTS = 400
