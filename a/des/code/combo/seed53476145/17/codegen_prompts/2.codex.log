import random
from collections import Counter
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]

def random_poly(area,h,w):
    start=(random.randrange(h),random.randrange(w))
    cells={start}
    frontier=[]
    def add_front(cell):
        r,c=cell
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells and (nr,nc) not in frontier:
                frontier.append((nr,nc))
    add_front(start)
    while len(cells)<area and frontier:
        cell=random.choice(frontier)
        frontier.remove(cell)
        if cell in cells:
            continue
        cells.add(cell)
        add_front(cell)
    if len(cells)"'!=area:
        return None
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    return {(r-r0,c-c0) for r,c in cells}

def side_counts(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    cnt={
        '"'U': sum(r==r0 for r,c in cells),
        'D': sum(r==r1 for r,c in cells),
        'L': sum(c==c0 for r,c in cells),
        'R': sum(c==c1 for r,c in cells),
    }
