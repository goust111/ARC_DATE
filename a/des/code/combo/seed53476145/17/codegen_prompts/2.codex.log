        if cell in cells:
            continue
        cells.add(cell)
        add_frontier(cell)

    if len(cells) != area:
        return None
    return _normalize(cells)


def _shape_dims(coords: list[tuple[int, int]]) -> tuple[int, int]:
    return max(r for r, _ in coords) + 1, max(c for _, c in coords) + 1


