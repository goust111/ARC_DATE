+            continue
+        for coords in _components(grid == color):
+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            r0 = int(rows.min())
+            r1 = int(rows.max())
+            c0 = int(cols.min())
+            c1 = int(cols.max())
