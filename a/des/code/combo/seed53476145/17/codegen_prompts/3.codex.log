+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+MATCH_NUMERATOR = 4
+MATCH_DENOMINATOR = 5
+
+GEN_BG = 0
+GEN_SEPARATOR = 5
+GEN_FOREGROUND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
