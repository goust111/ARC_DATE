+
+def _group_panels(panels: list[np.ndarray]) -> list[list[np.ndarray]]:
+    groups = [[panels[0]]]
+    for panel in panels[1:]:
+        if _is_merge_pair(groups[-1][-1], panel):
+            groups[-1].append(panel)
+        else:
+            groups.append([panel])
+    return groups
+
