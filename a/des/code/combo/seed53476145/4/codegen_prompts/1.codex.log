+    return (a + b - 1) // b
+
+
+def _choose_marker_cells(inner_height: int, inner_width: int, count: int, rng: random.Random) -> list[tuple[int, int]]:
+    parity_groups = [[], []]
+    for r in range(inner_height):
+        for c in range(inner_width):
