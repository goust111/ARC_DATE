+def _find_frames(grid: np.ndarray) -> list[dict]:
+    height, width = grid.shape
+    visited = np.zeros((height, width), dtype=bool)
+    frames: list[dict] = []
+
+    for r in range(height):
+        for c in range(width):
+            color = int(grid[r, c])
+            if visited[r, c] or color in (BG, RED):
