    fc = [int(c) for c in range(W) if bool((g[:, int(c)] == int(frame)).all())]
    fr = sorted(set(fr))
    fc = sorted(set(fc))

    assert fr
    assert fc

    if fr[0] != 0:
        fr = [-1] + fr
    if fr[-1] != (H - 1):
        fr = fr + [H]
    else:
