+
+    found_kinds = [_symmetry_kind(grid[r0 + 1 : r1, c0 + 1 : c1]) for r0, r1, c0, c1 in frames]
+    if sorted(found_kinds) != sorted(kinds_used):
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
