  64:     row_spans = _spans(g.shape[0], sep_rows)
  65:     col_spans = _spans(g.shape[1], sep_cols)
  66: 
  67:     tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}
  68:     tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}
  69:     assert len(tile_heights) == 1 and len(tile_widths) == 1, "expected equal-sized tile rows and columns"
  70:     tile_h = tile_heights.pop()
  71:     tile_w = tile_widths.pop()
  72: 
  73:     bg = _unique_mode(g[g != separator])
  74:     assert bg != separator, "background and separator colors must differ"
  75:     sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]
  76:     assert len(sprite_colors) == 1, "expected one sprite color"
  77:     sprite_color = sprite_colors[0]
  78: 
  79:     source_tiles = []
  80:     marked_origins = []
  81:     for r0, r1 in row_spans:
  82:         for c0, c1 in col_spans:
  83:             tile = g[r0 : r1 + 1, c0 : c1 + 1]
  84:             assert tile.shape == (tile_h, tile_w)
