+            continue
+        if np.array_equal(strip, strip[::-1, :]):
+            continue
+        return strip
+    raise RuntimeError("failed to build vertical-only strip")
+
+
+def _build_biaxial_tile(rng: random.Random, height: int, width: int) -> np.ndarray:
+    for _ in range(200):
+        palette = _palette(rng, rng.randint(2, 4))
