+        rng.choice(TEMPLATE_LIBRARY_4),
+    ]
+    pool = [mask for mask in TEMPLATE_LIBRARY_3 + TEMPLATE_LIBRARY_4 if all(not np.array_equal(mask, seen) for seen in picks)]
