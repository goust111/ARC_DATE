+
+    legend_w = 6
+    grid = np.zeros((scene_h, legend_w + 1 + scene_w), dtype=int)
+    sep = legend_w
+    grid[:, sep] = GREY
+    grid[:, sep + 1 :] = scene
+
+    for idx, mask in enumerate(templates):
+        r0, c0 = legend_slots[idx]
+        h, w = mask.shape
+        grid[r0 : r0 + h, c0 : c0 + w][mask] = GREY
+        fill_r0 = r0 + (h - 2) // 2
