+    used_fill = set()
+    mapping: dict[tuple[str, ...], int] = {}
+    for coords in template_comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        mask = _mask_from_coords(coords)
+        assert mask.shape in {(3, 3), (4, 4)}, "template must be 3x3 or 4x4"
+        candidates = []
+        for idx, comp in enumerate(fill_comps):
+            if idx in used_fill:
+                continue
