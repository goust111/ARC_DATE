+    )
+    corner_colors, corner_counts = np.unique(corners, return_counts=True)
+    winners = np.flatnonzero(corner_counts == corner_counts.max())
+    if len(winners) == 1:
+        return int(corner_colors[int(winners[0])])
+    return _dominant(grid)
