+    grid = np.zeros((h, w), dtype=int)
+    for center, direction, color in zip(centers, directions, colors):
+        shape = _transform_shape(random.choice(BASE_SHAPES))
+        cr, cc = center
+        top = int(cr - 1)
+        left = int(cc - 1)
