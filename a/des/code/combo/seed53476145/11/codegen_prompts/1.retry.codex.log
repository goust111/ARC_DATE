+    indegrees = _indegrees(targets, len(sprites))
+    if not _valid_branch(kind, indegrees):
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
