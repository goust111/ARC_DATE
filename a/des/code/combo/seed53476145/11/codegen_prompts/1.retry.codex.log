DEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]
DEFECT_CLEARANCE = 2             # min Chebyshev distance between defects
DEFECT_PLACE_TRIES = 50          # retries per defect placement
