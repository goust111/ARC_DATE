    r1: int,
    c0: int,
    c1: int,
    dominant: int,
) -> None:
    grid[r0:r1, c0:c1] = dominant
    border = _gen_border_coords(r0, r1, c0, c1)
    interior_area = max(0, r1 - r0 - 2) * max(0, c1 - c0 - 2)
    total_area = (r1 - r0) * (c1 - c0)
    min_dominant_on_border = max(0, total_area // 2 + 1 - interior_area)
