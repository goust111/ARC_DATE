+def _runs(mask: np.ndarray) -> list[tuple[int, int]]:
+    groups: list[tuple[int, int]] = []
+    start: int | None = None
+    for idx in range(int(mask.size) + 1):
+        active = bool(mask[idx]) if idx < int(mask.size) else False
+        if active and start is None:
