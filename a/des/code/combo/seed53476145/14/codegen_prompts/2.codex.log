OCCLUDER_HEIGHT_MIN = 1
OCCLUDER_HEIGHT_MAX = 6
OCCLUDER_WIDTH_MIN = 1
OCCLUDER_WIDTH_MAX = 6
HIDDEN_FRACTION_MIN = 0.10
HIDDEN_FRACTION_MAX = 0.57

