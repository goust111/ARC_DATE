+def _reserve_outer_box(occupied: np.ndarray, box: tuple[int, int, int, int], gap: int) -> None:
+    grid_h, grid_w = occupied.shape
+    r0, c0, r1, c1 = box
+    rs = max(0, r0 - gap)
+    re = min(grid_h, r1 + gap + 1)
+    cs = max(0, c0 - gap)
+    ce = min(grid_w, c1 + gap + 1)
+    occupied[rs:re, cs:ce] = True
