+def _find_outer_location(occupied: np.ndarray, h: int, w: int, gap: int) -> tuple[int, int] | None:
+    grid_h, grid_w = occupied.shape
+    positions: list[tuple[int, int]] = []
+    for r0 in range(1, grid_h - h):
