+def _target_color(enclosing: list[dict[str, object]], color_counts: dict[int, int]) -> int:
+    best = min(
+        enclosing,
+        key=lambda frame: (
+            color_counts[int(frame["color"])],
+            _frame_pixel_count(frame["bbox"]),
+            _box_area(frame["bbox"]),
