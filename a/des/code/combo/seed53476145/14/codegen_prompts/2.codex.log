+    enclosing: list[dict[str, object]] = []
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        if r0 < sr0 and c0 < sc0 and sr1 < r1 and sc1 < c1:
+            enclosing.append(frame)
+    return enclosing
