+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FRAME_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 18
+GRID_MAX = 30
+MAX_CHAINS = 3
+MAX_FRAME_DEPTH = 4
+MIN_DEEPEST_FRAME_SIZE = 5
+CHAIN_GAP = 2
+SPRITE_MIN_CELLS = 2
+SPRITE_MAX_CELLS = 9
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    mins = coords.min(axis=0)
+    maxs = coords.max(axis=0)
+    return int(mins[0]), int(mins[1]), int(maxs[0]), int(maxs[1])
+
+
+def _box_dims(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
+def _frame_pixel_count(box: tuple[int, int, int, int]) -> int:
+    h, w = _box_dims(box)
+    return 2 * (h + w) - 4
+
+
+def _box_area(box: tuple[int, int, int, int]) -> int:
+    h, w = _box_dims(box)
+    return h * w
+
+
+def _is_rectangular_frame(mask: np.ndarray, coords: np.ndarray) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h, w = _box_dims((r0, c0, r1, c1))
+    if h < 3 or w < 3:
