+    max_cells = min(SPRITE_MAX_CELLS, len(available))
+    min_cells = 1 if max_cells == 1 else min(SPRITE_MIN_CELLS, max_cells)
+    for _ in range(40):
+        target = random.randint(min_cells, max_cells)
+        cells = {random.choice(available)}
+        while len(cells) < target:
