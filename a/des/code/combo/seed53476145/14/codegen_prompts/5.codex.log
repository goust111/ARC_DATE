    pairs = []
    for height in range(MIN_GRID_SIZE, MAX_GRID_SIZE + 1):
        for width in range(MIN_GRID_SIZE, MAX_GRID_SIZE + 1):
            if _gen_dim_slots(height) * _gen_dim_slots(width) < n_regions:
