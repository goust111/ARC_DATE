ROW_BOUNDS = (9, 21)
COL_BOUNDS = (15, 24)
SEED_ROW_BOUNDS = (1, 4)
EXTRA_ROWS_BELOW_LAST_GEN_BOUNDS = (1, 8)
LEFT_MARGIN_MAX = 3
RIGHT_MARGIN_MAX = 3
RUN_COUNT_BOUNDS = (3, 9)
ORANGE_TOTAL_BOUNDS = (9, 12)
RUN_LENGTH_BOUNDS = (1, 7)
GAP_WIDTH = 1
LEVEL_CHOICES = tuple(range(1, 9))
LEVEL_WEIGHTS = (5, 4, 3, 2, 1, 0.5, 0.3, 0.2)
