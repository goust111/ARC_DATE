+    return int(np.argmax(counts))
+
+
+def _bbox_from_coords(coords: np.ndarray) -> BBox:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _intersection(a: BBox, b: BBox) -> BBox | None:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
