+def _render_visible(shape: tuple[int, int], rects: dict[int, BBox], order: tuple[int, ...], bg: int) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    for color in order:
+        r0, c0, r1, c1 = rects[int(color)]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+    return out
