+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+GREY = 5
+BG = 0
+INPUT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MIN_GRID = 12
+MAX_GRID = 24
+MAX_ATTEMPTS = 500
+
+
+BBox = tuple[int, int, int, int]
+
+
+def _dominant_color(grid: np.ndarray) -> int:
