+PLACEMENT_GAP = 1
+PLACEMENT_RETRIES = 250
+GENERATION_RETRIES = 400
+
+PATTERN_BITS = tuple(
+    np.array(
+        [[(mask >> 0) & 1, (mask >> 1) & 1], [(mask >> 2) & 1, (mask >> 3) & 1]],
+        dtype=int,
+    )
+    for mask in range(16)
+    if mask not in (0, 15)
