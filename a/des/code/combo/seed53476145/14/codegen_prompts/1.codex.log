+LEGEND_ENTRY_RANGE = (2, 4)
+LEGEND_GAP_CHOICES = (1, 2)
+RECT_COUNT_RANGE = (2, 5)
+RECT_HEIGHT_RANGE = (2, 7)
+RECT_WIDTH_RANGE = (2, 7)
