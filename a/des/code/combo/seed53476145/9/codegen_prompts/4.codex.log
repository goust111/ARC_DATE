_GEN_BG = 8
_GEN_GREY = 5
_GEN_PINK = 6
_GEN_MAROON = 9

# Canvas and square geometry.
_GEN_CANVAS_MIN = 9
_GEN_CANVAS_MAX = 15
_GEN_CANVAS_MAX_DELTA = 2
_GEN_SQUARE_SIZE = 3
_GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1
_GEN_SQUARE_GAP = 1

