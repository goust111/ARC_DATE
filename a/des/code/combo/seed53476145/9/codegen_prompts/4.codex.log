+    right = sorted(r for r, c in cells if c == w - 1)
+    if len(right) == 2 and right[1] == right[0] + 1:
+        inner = [(r, c) for r, c in cells if c != w - 1]
+        if len(inner) == 1 and inner[0][1] == w - 2 and inner[0][0] in right:
