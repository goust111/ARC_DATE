+    for comp in comps:
+        area = int(comp["area"])
+        if 15 <= area <= 30:
+            sprites.append(comp)
+        elif 2 <= area <= 6:
+            templates.append(comp)
+        else:
+            others.append(comp)
+    for sprite in sprites:
+        sprite_holes[sprite["id"]] = _component_holes(g, sprite, bg)
+    return {
+        "bg": bg,
