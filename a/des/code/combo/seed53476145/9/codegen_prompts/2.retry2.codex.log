+def _normalize_cells(cells):
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
+
+
+def _shape_dims(shape):
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
