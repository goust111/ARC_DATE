+            hole_shapes.append(hole["shape"])
+    if len(set(hole_shapes)) != len(hole_shapes):
+        return False
+    template_counts = Counter(comp["shape"] for comp in info["templates"])
+    if any(template_counts[shape] != 1 for shape in hole_shapes):
+        return False
+    return True
