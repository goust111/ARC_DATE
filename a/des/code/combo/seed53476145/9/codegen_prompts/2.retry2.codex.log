+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _background_color(grid: np.ndarray) -> int:
+    corners = [
+        int(grid[0, 0]),
+        int(grid[0, -1]),
+        int(grid[-1, 0]),
+        int(grid[-1, -1]),
+    ]
+    return Counter(corners).most_common(1)[0][0]
