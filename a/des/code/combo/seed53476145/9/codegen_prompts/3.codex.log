+    if non_turn_colors:
+        path_color = Counter(non_turn_colors).most_common(1)[0][0]
+    else:
+        path_color = Counter(int(g[pos]) for pos in occupied).most_common(1)[0][0]
+
+    source_colors = {}
+    for pos in nodes:
+        color = int(g[pos])
+        source_colors[pos] = None if color in (bg, path_color) else color
