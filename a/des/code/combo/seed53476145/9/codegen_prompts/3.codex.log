+
+def _is_turn(pos: Pos, neighbors: list[Pos]) -> bool:
+    if len(neighbors) != 2:
+        return False
+    (r1, c1), (r2, c2) = neighbors
+    dr1, dc1 = r1 - pos[0], c1 - pos[1]
+    dr2, dc2 = r2 - pos[0], c2 - pos[1]
+    return not (dr1 == -dr2 and dc1 == -dc2)
