+GRID_W_RANGE = (12, 22)
+COMPONENT_COUNT_RANGE = (1, 3)
+MANDATORY_TURNS_RANGE = (3, 5)
+EXTRA_TURNS_RANGE = (1, 4)
+SEG_LEN_RANGE = (2, 6)
