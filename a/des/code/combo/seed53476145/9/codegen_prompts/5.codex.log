+
+    pair = _build_grid(panel_h, widths, kinds)
+    if pair is None:
+        return None
+    inp, expected = pair
+
+    try:
+        solved = main(inp)
+    except AssertionError:
+        return None
+    return inp if np.array_equal(solved, expected) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
