GRID_COLS = (19, 27)
BACKGROUND_COLORS = [0, 4, 5, 7, 8, 9]
FOREGROUND_COLOR = 2
OUTPUT_COLOR_BY_KIND = {"H": 1, "V": 3, "D": 6}

# Object count and size constraints.
OBJECT_COUNT_RANGE = (3, 7)
H_COUNT_OPTIONS = (2, 3)
V_COUNT_OPTIONS = (1, 2)
D_COUNT_OPTIONS = (0, 1, 2)
AREA_MIN = 6
AREA_MAX = 28
