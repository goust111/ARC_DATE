+    panel_h = random.randint(*GRID_HEIGHT_RANGE)
+    panel_count = random.randint(*PANEL_COUNT_RANGE)
+    widths = [random.randint(*PANEL_WIDTH_RANGE) for _ in range(panel_count)]
