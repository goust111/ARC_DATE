+    frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)}): ((1, 0), LEFT),
+    frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)}): ((1, 2), RIGHT),
+}
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[int(np.argmax(counts))])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    out: list[dict[str, object]] = []
+
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != int(bg)):
+        mask = grid == int(color)
+        seen = np.zeros((h, w), dtype=bool)
+        for r0, c0 in np.argwhere(mask):
+            r0 = int(r0)
+            c0 = int(c0)
+            if seen[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        rr = int(r + dr)
+                        cc = int(c + dc)
+                        if (
+                            0 <= rr < h
+                            and 0 <= cc < w
+                            and not seen[rr, cc]
+                            and bool(mask[rr, cc])
+                        ):
+                            seen[rr, cc] = True
+                            stack.append((rr, cc))
+
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": np.array(coords, dtype=int),
+                }
+            )
+
+    return out
+
