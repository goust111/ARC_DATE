) -> set[tuple[int, int]]:
    h, w = shape
    dr, dc = MOVE_BY_MISSING[tuple(missing)]
    base_r = top + 3 * dr
    base_c = left + 3 * dc
    cells: set[tuple[int, int]] = set()
    for rr in range(3):
        for cc in range(3):
