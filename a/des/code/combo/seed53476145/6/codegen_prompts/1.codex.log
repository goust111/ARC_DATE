+        if 0 <= nr < h and 0 <= nc < w:
+            cells.add((nr, nc))
+    return cells
+
+
+def _guard(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    guarded: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
