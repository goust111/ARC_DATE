+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MISSING_CORNERS = ((0, 0), (0, 2), (2, 0), (2, 2))
+MOVE_BY_MISSING = {
+    (0, 0): (1, 1),
+    (0, 2): (1, -1),
+    (2, 0): (-1, 1),
+    (2, 2): (-1, -1),
