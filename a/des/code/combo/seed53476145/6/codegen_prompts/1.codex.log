            if 0 <= nr < h and 0 <= nc < w:
                cells.add((nr, nc))
    return cells


def _shifted_paint_cells(
    top: int,
    left: int,
    missing: tuple[int, int],
    shape: tuple[int, int],
) -> set[tuple[int, int]]:
    h, w = shape
    dr, dc = MOVE_BY_MISSING[tuple(missing)]
    base_r = top + 3 * dr
    base_c = left + 3 * dc
    cells: set[tuple[int, int]] = set()
    for rr, cc in _filled_offsets(missing):
        nr, nc = base_r + rr, base_c + cc
        if 0 <= nr < h and 0 <= nc < w:
