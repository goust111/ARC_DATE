+            continue
+        if sorted(tuple(sprite["missing"]) for sprite in sprites).count((0, 2)) == 0:
+            continue
+        if sorted(tuple(sprite["missing"]) for sprite in sprites).count((2, 0)) == 0:
+            continue
+        if sorted(tuple(sprite["missing"]) for sprite in sprites).count((2, 2)) == 0:
+            continue
