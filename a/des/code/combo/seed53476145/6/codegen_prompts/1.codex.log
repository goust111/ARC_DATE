    return [(r, c) for r in range(h - 2) for c in range(w - 2)]


def _place_sprite(
    shape: tuple[int, int],
    missing: tuple[int, int],
    require_clip: bool,
    used_input_guard: set[tuple[int, int]],
    used_output_guard: set[tuple[int, int]],
) -> dict | None:
    h, w = shape
