+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+INNER_COLORS = tuple(range(2, 10))
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+REGION_COUNT_RANGE = (1, 4)
+PLACEMENT_TRIES = 80
+PARTITION_TRIES = 80
+GEN_RETRIES = 300
+EXTRA_LAYER_MAX = 3
+MAX_SHORT_DIM = 12
+MAX_LONG_EXTRA = 5
+MIN_AREA_PER_COLOR = 2
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _boundary_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _sorted_colors_by_area(inner: np.ndarray) -> list[int]:
+    counts = Counter(map(int, inner.reshape(-1)))
+    anchors: dict[int, tuple[int, int]] = {}
+    for r in range(inner.shape[0]):
+        for c in range(inner.shape[1]):
+            color = int(inner[r, c])
+            anchors.setdefault(color, (r, c))
+    return sorted(
+        counts,
+        key=lambda color: (-counts[color], anchors[color][0], anchors[color][1]),
+    )
+
