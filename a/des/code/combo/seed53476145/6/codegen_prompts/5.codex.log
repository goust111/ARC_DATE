+def _dilate(mask: np.ndarray) -> np.ndarray:
+    dilated = mask.copy()
+    dilated[1:, :] |= mask[:-1, :]
+    dilated[:-1, :] |= mask[1:, :]
+    dilated[:, 1:] |= mask[:, :-1]
+    dilated[:, :-1] |= mask[:, 1:]
+    dilated[1:, 1:] |= mask[:-1, :-1]
+    dilated[1:, :-1] |= mask[:-1, 1:]
+    dilated[:-1, 1:] |= mask[1:, :-1]
+    dilated[:-1, :-1] |= mask[1:, 1:]
+    return dilated
+
