+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(panel[r, c]) == bg:
+                continue
+            color = int(panel[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
