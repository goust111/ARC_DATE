    out = g.copy()
    for r, color in left_markers:
        c = top_by_color[color]
        out[r, 1:] = color
        out[1:, c] = color
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """Translate matching top/left color markers into crossing row/column instructions.

