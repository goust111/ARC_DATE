        patch, budget, remaining = sampled
        objects[(i, i)] = patch
        paste(out, patch, 0, 0, transparent=_BG)

    for panel_i, obj_i in _DISTRACTOR_KEYS:
        sampled = _sample_patch(H, segs, obj_i, colors[(panel_i, obj_i)], budget, remaining)
        if sampled is None:
