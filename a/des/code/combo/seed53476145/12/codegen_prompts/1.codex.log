+        assert r1 - r0 >= 2 and c1 - c0 >= 2, "frame must enclose a nonempty interior"
+        assert set(comp) == _rect_border_cells(r0, c0, r1, c1), "grey component must be a 1-cell frame"
+        frames.append((r0, c0, r1, c1))
