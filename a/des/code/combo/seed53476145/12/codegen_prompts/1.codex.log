+
+GRID_HEIGHT_RANGE = (14, 30)
+GRID_WIDTH_RANGE = (14, 30)
+REGION_COUNT_RANGE = (1, 4)
+REGION_OUTER_SIZE_MAX = 13
+PLACEMENT_PADDING = 2
+REGION_PLACEMENT_TRIES = 100
+CELL_SAMPLING_TRIES = 40
