+def _render_nested(rectangles: list[tuple[int, int, int]]) -> np.ndarray:
+    outer_color, outer_h, outer_w = rectangles[0]
+    out = np.zeros((int(outer_h), int(outer_w)), dtype=int)
+    out[:, :] = int(outer_color)
