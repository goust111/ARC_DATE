+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    patch = scene[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all(patch == int(color)), "each object must be a solid rectangle"
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
