+    padded = np.pad(solid, 1, constant_values=False)
+    ph, pw = padded.shape
+    seen = np.zeros((ph, pw), dtype=bool)
+    queue = deque([(0, 0)])
+    seen[0, 0] = True
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < ph and 0 <= nc < pw and not seen[nr, nc] and not padded[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
