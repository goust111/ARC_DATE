+        inner_h = r1 - r0 - 1
+        inner_w = c1 - c0 - 1
+        points = _choose_points(inner_h, inner_w)
+        for pr, pc in points:
+            grid[r0 + pr, c0 + pc] = MAROON
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
