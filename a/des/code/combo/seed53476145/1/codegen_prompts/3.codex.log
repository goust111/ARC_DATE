+    local_coords = np.asarray(comp["coords"], dtype=int) - np.array([[r0, c0]], dtype=int)
+    local_mask[local_coords[:, 0], local_coords[:, 1]] = True
+    if np.any(local_mask & ~border):
+        return None
+    if not np.array_equal(local_mask, border & (sub == color)):
