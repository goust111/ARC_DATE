+    elif side == "left":
+        bias = center_c - mean_c
+        axis_span = float(pts[:, 1].max() - pts[:, 1].min()) if pts.shape[0] > 1 else 0.0
+        ortho = abs(mean_r - center_r)
+    else:
+        bias = mean_c - center_c
