+    assert frames, "expected at least one frame"
+    assert sprites, "expected at least one sprite"
+
+    out = np.array(g, copy=True)
+    for sprite in sprites:
+        coords = np.asarray(sprite["coords"], dtype=int)
+        out[coords[:, 0], coords[:, 1]] = int(BG)
