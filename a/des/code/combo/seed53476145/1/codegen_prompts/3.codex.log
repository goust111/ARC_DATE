+def _build_frame_patch(size: int, color: int, gaps: list[tuple[int, int]]) -> np.ndarray:
+    patch = np.full((size, size), int(BG), dtype=int)
+    patch[0, :] = int(color)
+    patch[-1, :] = int(color)
+    patch[:, 0] = int(color)
+    patch[:, -1] = int(color)
+    for r, c in gaps:
+        patch[int(r), int(c)] = int(BG)
+    assert _single_component(patch == int(color))
+    return patch
+
