+def _random_sprite_mask(count: int) -> np.ndarray:
+    if count == 1:
+        return np.array([[True]], dtype=bool)
+    if count == 2:
+        base = np.array([[True, True]], dtype=bool)
+        return np.rot90(base, random.randrange(4))
+    assert count == 3
+    base = np.array([[True, False], [True, True]], dtype=bool)
+    return np.rot90(base, random.randrange(4))
+
