+
+
+def _rotate_for_side(mask: np.ndarray, side: str) -> np.ndarray:
+    best_mask = np.asarray(mask, dtype=bool)
+    best_key = _rotation_key(best_mask, side)
+    for k in range(1, 4):
+        rotated = np.rot90(mask, k)
+        key = _rotation_key(rotated, side)
+        if key > best_key:
+            best_key = key
+            best_mask = rotated
