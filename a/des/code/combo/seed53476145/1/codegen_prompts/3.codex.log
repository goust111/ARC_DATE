+            h, w = rotated.shape
+            rr = int(frame["bbox"][0] + 1 + (inner_size - h) // 2)
+            cc = int(frame["bbox"][1] + 1 + (inner_size - w) // 2)
+            target = out[rr : rr + h, cc : cc + w]
+            target[rotated] = color
