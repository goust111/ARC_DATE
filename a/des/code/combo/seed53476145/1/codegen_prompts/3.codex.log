+    if side == "top":
+        bias = center_r - mean_r
+        axis_span = float(pts[:, 0].max() - pts[:, 0].min()) if pts.shape[0] > 1 else 0.0
+        ortho = abs(mean_c - center_c)
+    elif side == "bottom":
+        bias = mean_r - center_r
+        axis_span = float(pts[:, 0].max() - pts[:, 0].min()) if pts.shape[0] > 1 else 0.0
