+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "size": size_h,
+        "color": color,
+        "gap_count": gap_count,
+        "target_side": target_side,
+        "gaps": gaps,
+    }
+
+
+def _sprite_info(grid: np.ndarray, comp: dict, bg: int) -> dict | None:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    patch = np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+    color = int(comp["color"])
