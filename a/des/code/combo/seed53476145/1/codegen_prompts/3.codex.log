+def _gap_side_from_rel(size: int, gap: tuple[int, int]) -> str:
+    r, c = gap
+    if r == 0 and 0 < c < size - 1:
+        return "top"
+    if r == size - 1 and 0 < c < size - 1:
+        return "bottom"
+    if c == 0 and 0 < r < size - 1:
+        return "left"
+    if c == size - 1 and 0 < r < size - 1:
+        return "right"
