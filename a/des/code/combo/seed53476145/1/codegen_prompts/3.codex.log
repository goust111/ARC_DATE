+    frames: list[dict] = []
+    frame_component_ids: set[int] = set()
+    for idx, comp in enumerate(comps):
+        info = _frame_info(g, comp, BG)
+        if info is not None:
+            frames.append(info)
+            frame_component_ids.add(int(idx))
+
+    sprites: list[dict] = []
+    for idx, comp in enumerate(comps):
+        if idx in frame_component_ids:
+            continue
