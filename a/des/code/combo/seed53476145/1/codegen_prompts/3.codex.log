+    gap_count = len(gaps)
+    if not (1 <= gap_count <= 3):
+        return None
+
+    side_counts = {side: 0 for side in SIDES}
+    for _gr, _gc, side in gaps:
+        side_counts[side] += 1
+    best = max(side_counts.values())
+    best_sides = [side for side in SIDES if side_counts[side] == best]
+    if len(best_sides) == 1:
