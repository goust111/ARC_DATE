+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 8
+PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]
+SIDES = ("top", "bottom", "left", "right")
+GENERATE_MAX_RETRIES = 400
+
+_GAP_CACHE: dict[tuple[int, int], dict[tuple[str, bool], list[tuple[tuple[int, int], ...]]]] = {}
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == int(bg) or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _border_mask(size: int) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _frame_info(grid: np.ndarray, comp: dict, bg: int) -> dict | None:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    size_h = int(r1 - r0 + 1)
