+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG_COLOR = 7
+LEGEND_COLOR = 5
+THRESHOLD_WIDTH = 3
+OBJECT_COLORS = (1, 2, 3, 4, 6, 8, 9)
+
+GRID_HEIGHT_RANGE = (10, 18)
+GRID_WIDTH_RANGE = (10, 18)
+GENERATION_RETRIES = 400
+PLACEMENT_RETRIES = 200
