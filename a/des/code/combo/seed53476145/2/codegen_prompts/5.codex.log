+    even_mask = (rr + cc) % 2 == 0
+    odd_mask = ~even_mask
+    even_color = _dominant(grid[even_mask])
+    odd_color = _dominant(grid[odd_mask])
+    assert even_color != odd_color, "checkerboard phases must use two different colors"
+    return even_color, odd_color
+
