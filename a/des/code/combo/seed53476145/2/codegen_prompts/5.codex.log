+    r0 = min(r for r, _c in coords)
+    c0 = min(c for _r, c in coords)
+    arr = np.array(sorted((r - r0, c - c0) for r, c in coords), dtype=int)
+    return arr
+
+
+def _shape_frontier(
+    cells: set[tuple[int, int]],
+    available: set[tuple[int, int]],
