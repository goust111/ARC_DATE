+
+    obj_count = random.randint(*OBJECT_COUNT_RANGE)
+    phases = _phase_schedule(obj_count)
+    colors = random.sample(FG_COLORS, obj_count)
+    specs: list[tuple[int, int, np.ndarray]] = []
+
+    for phase in phases:
