+def _flip_coords(coords: np.ndarray, horizontal: bool) -> np.ndarray:
+    out = coords.copy()
+    r0 = int(coords[:, 0].min())
+    r1 = int(coords[:, 0].max())
+    c0 = int(coords[:, 1].min())
+    c1 = int(coords[:, 1].max())
+    if horizontal:
+        out[:, 1] = c0 + c1 - out[:, 1]
+    else:
+        out[:, 0] = r0 + r1 - out[:, 0]
+    return out
+
+
+def _sorted_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    return tuple(sorted((int(r), int(c)) for r, c in coords))
