+            arr = np.array(coords, dtype=int)
+            assert arr.size > 0
+            assert len({(int(rr) + int(cc)) % 2 for rr, cc in coords}) == 1
+            objects.append(
+                {
+                    "color": color,
+                    "phase": int(phase),
+                    "coords": arr,
+                }
+            )
