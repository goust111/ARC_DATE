+def _bbox_with_margin(
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    grid_shape: tuple[int, int],
+    margin: int = 1,
+) -> tuple[slice, slice]:
+    h, w = grid_shape
+    return (
