+def _transform(coords, variant: int) -> tuple[tuple[int, int], ...]:
+    transformed = []
+    for r, c in coords:
+        if variant == 0:
+            rr, cc = r, c
+        elif variant == 1:
+            rr, cc = r, -c
+        elif variant == 2:
+            rr, cc = -r, c
+        elif variant == 3:
+            rr, cc = -r, -c
+        elif variant == 4:
+            rr, cc = c, r
+        elif variant == 5:
+            rr, cc = c, -r
+        elif variant == 6:
+            rr, cc = -c, r
+        else:
+            rr, cc = -c, -r
+        transformed.append((int(rr), int(cc)))
+    return _normalize(transformed)
