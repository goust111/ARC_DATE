+
+
+def _uniform_rect(rng: random.Random, color: int, min_side: int, max_side: int) -> np.ndarray:
+    h = rng.randint(min_side, max_side)
+    w = rng.randint(min_side, max_side)
+    return np.full((h, w), int(color), dtype=int)
