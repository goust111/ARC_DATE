+            path_cells.update(cells)
+    else:
+        cols = _sample_spaced_positions(pair_count, 1, width - 2, MIN_LANE_GAP, rng)
+        if cols is None:
+            return None
+        for col, color, blocked in zip(cols, colors, blocked_flags):
+            cells = _place_vertical_pair(grid, col, color, blocked, rng)
+            if cells is None:
