+
+def _bbox(coords: list[Coord] | tuple[Coord, ...]) -> tuple[int, int, int, int]:
+    rows = [int(r) for r, _ in coords]
+    cols = [int(c) for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
