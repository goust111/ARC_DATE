+        else:
+            top_rel, bottom_rel = random.choice(doubles)
+            top_color, bottom_color = random.sample(marker_palette, 2)
+            markers = [
+                {"rel": top_rel, "color": int(top_color)},
+                {"rel": bottom_rel, "color": int(bottom_color)},
+            ]
+
+        frame_records.append(
+            {
