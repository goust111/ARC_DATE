+COLORS = tuple(range(10))
+GRID_H_RANGE = (28, 34)
+GRID_W_RANGE = (28, 34)
+FRAME_COUNT_RANGE = (2, 4)
+EXTRA_SHAPE_RANGE = (1, 3)
+SHAPE_DIM_RANGE = (3, 6)
+SHAPE_FILL_MIN = 0.42
+SHAPE_FILL_MAX = 0.78
+FRAME_EXTRA_RANGE = (0, 2)
