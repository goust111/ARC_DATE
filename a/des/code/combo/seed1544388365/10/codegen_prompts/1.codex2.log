+def _is_frame_component(comp: dict) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+
+    border = {
+        (r0, c)
+        for c in range(c0, c1 + 1)
+    }
+    border |= {
+        (r1, c)
+        for c in range(c0, c1 + 1)
+    }
+    border |= {
+        (r, c0)
+        for r in range(r0, r1 + 1)
+    }
+    border |= {
+        (r, c1)
+        for r in range(r0, r1 + 1)
+    }
+    return int(comp["area"]) == len(border) and set(comp["coords"]) == border
