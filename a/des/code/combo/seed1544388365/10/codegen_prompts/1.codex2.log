+def _background_color(g: np.ndarray) -> int:
+    boundary = np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))
+    try:
+        return _unique_mode(boundary)
+    except AssertionError:
+        return _unique_mode(g)
