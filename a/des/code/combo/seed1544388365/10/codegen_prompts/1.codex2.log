+def _neighbors4(shape: tuple[int, int], r: int, c: int) -> list[Coord]:
+    h, w = map(int, shape)
+    out = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = int(r + dr)
+        cc = int(c + dc)
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
