+def _sample_shape(existing: set[tuple], frame_sizes: list[tuple[int, int]] | None = None) -> dict | None:
+    for _ in range(SHAPE_ATTEMPTS):
+        mask = _generate_shape_mask()
+        if mask is None:
+            continue
+        shape = _shape_from_mask(mask)
+        if shape["signature"] in existing:
+            continue
