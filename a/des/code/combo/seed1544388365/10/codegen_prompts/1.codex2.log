+            r0, c0, r1, c1 = _bbox(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+
+    return comps
