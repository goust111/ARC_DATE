+
+def _shape_from_mask(mask: np.ndarray) -> dict:
+    coords = tuple(sorted((int(r), int(c)) for r, c in zip(*np.where(mask))))
+    return {
+        "coords": coords,
+        "coord_set": frozenset(coords),
+        "h": int(mask.shape[0]),
+        "w": int(mask.shape[1]),
