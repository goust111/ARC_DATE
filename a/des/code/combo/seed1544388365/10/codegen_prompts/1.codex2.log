+def _generate_shape_mask() -> np.ndarray | None:
+    for _ in range(SHAPE_ATTEMPTS):
+        raw_h = random.randint(*SHAPE_DIM_RANGE)
+        raw_w = random.randint(*SHAPE_DIM_RANGE)
