+def _shape_from_coords(coords: tuple[Coord, ...], shape_id: int) -> dict:
+    r0, c0, r1, c1 = _bbox(list(coords))
+    rel = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+    return {
+        "id": int(shape_id),
+        "coords": rel,
+        "coord_set": frozenset(rel),
+        "h": int(r1 - r0 + 1),
+        "w": int(c1 - c0 + 1),
+        "area": len(rel),
+        "bbox": (r0, c0, r1, c1),
+        "abs_coords": coords,
+    }
