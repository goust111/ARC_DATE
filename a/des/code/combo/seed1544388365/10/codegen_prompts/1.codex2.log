+def _find_components(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = map(int, g.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == int(bg) or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(g.shape, rr, cc):
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            r0, c0, r1, c1 = _bbox(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+
+    return comps
