+def _valid_single_markers(shape: dict, frame_size: tuple[int, int], shapes: list[dict]) -> list[Coord]:
+    coords = list(shape["coords"])
+    random.shuffle(coords)
+    return [
+        coord
+        for coord in coords
+        if _matching_shape_ids((coord,), frame_size, shapes) == {int(shape["id"])}
