+    bg: int,
+    color: int,
+    seg_a: Segment,
+    seg_b: Segment,
+) -> None:
+    left, right = sorted((seg_a.fixed, seg_b.fixed))
+    top, bottom = seg_a.start, seg_a.end
+    shadow = np.zeros_like(source, dtype=bool)
+
