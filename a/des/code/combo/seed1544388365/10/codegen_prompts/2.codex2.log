+        max_len = min(LINE_LENGTH_RANGE[1], h - 2)
+        max_gap = min(LINE_GAP_RANGE[1], w - 3)
+        if max_len < LINE_LENGTH_RANGE[0] or max_gap < LINE_GAP_RANGE[0]:
