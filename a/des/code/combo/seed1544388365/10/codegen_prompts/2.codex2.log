+        r = top + 1 + int(rr)
+        c = left + int(cc)
+        dist_top = r - top
+        dist_bottom = bottom - r
+        if dist_top < dist_bottom:
+            shadow[r:bottom, c] = True
+        elif dist_bottom < dist_top:
+            shadow[top + 1 : r + 1, c] = True
+        else:
