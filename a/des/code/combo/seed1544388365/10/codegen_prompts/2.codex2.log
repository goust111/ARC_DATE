  50:     assert g.ndim == 2, "expected a 2D grid"
  51: 
  52:     bg = get_bg(g)
  53:     active_rows = [int(r) for r in np.flatnonzero(np.any(g != bg, axis=1))]
  54:     active_cols = [int(c) for c in np.flatnonzero(np.any(g != bg, axis=0))]
  55:     assert active_rows and active_cols, "expected foreground logical lattice"
  56: 
  57:     row_spans = _axis_spans(active_rows, g.shape[0])
  58:     col_spans = _axis_spans(active_cols, g.shape[1])
  59:     col_position = {c: i for i, c in enumerate(active_cols)}
  60: 
  61:     def has_horizontal_peer(r: int, c: int, color: int) -> bool:
  62:         j = col_position[c]
  63:         for jj in (j - 1, j + 1):
  64:             if 0 <= jj < len(active_cols) and int(g[r, active_cols[jj]]) == color:
  65:                 return True
  66:         return False
  67: 
  68:     out = np.full((TARGET_SIZE, TARGET_SIZE), bg, dtype=int)
  69: 
  70:     for r in active_rows:
  71:         r0, r1 = row_spans[r]
  72:         for c in active_cols:
  73:             color = int(g[r, c])
  74:             if color == bg:
  75:                 continue
  76:             c0, c1 = col_spans[c]
  77:             out[r0:r1, c0:c1] = color
  78: 
  79:     for r in active_rows:
  80:         r0, r1 = row_spans[r]
  81:         for c_left, c_right in zip(active_cols, active_cols[1:]):
  82:             color = int(g[r, c_left])
  83:             if color != bg and int(g[r, c_right]) == color:
  84:                 c0 = col_spans[c_left][0]
  85:                 c1 = col_spans[c_right][1]
  86:                 out[r0:r1, c0:c1] = color
  87: 
  88:     for r_top, r_bottom in zip(active_rows, active_rows[1:]):
  89:         r0 = row_spans[r_top][0]
  90:         r1 = row_spans[r_bottom][1]
  91:         for c in active_cols:
