+import random
+from typing import NamedTuple
+
+import numpy as np
+
+
+GREY = 5
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 120
+GRID_HEIGHT_RANGE = (12, 22)
+GRID_WIDTH_RANGE = (12, 22)
+PAIR_COUNT_BY_SIZE = {
+    "small": (1, 2),
+    "large": (2, 3),
+}
+LINE_LENGTH_RANGE = (3, 8)
+LINE_GAP_RANGE = (2, 6)
