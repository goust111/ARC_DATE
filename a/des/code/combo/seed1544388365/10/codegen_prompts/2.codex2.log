 184: def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:
 185:     """Generate n gaps each in [min_gap, max_gap] with sum <= max_total."""
 186:     if n * min_gap > max_total:
 187:         return None
 188:     gaps = [min_gap] * n
 189:     remaining = max_total - sum(gaps)
 190:     for i in range(n):
 191:         extra = min(max_gap - gaps[i], remaining)
 192:         if extra > 0:
 193:             add = random.randint(0, extra)
 194:             gaps[i] += add
 195:             remaining -= add
 196:     random.shuffle(gaps)
 197:     return gaps
