+    top: int,
+    bottom: int,
+    left: int,
+    right: int,
+    count: int,
+) -> list[tuple[int, int]]:
+    left_cols = [c for c in range(left + 1, right) if c - left < right - c]
+    right_cols = [c for c in range(left + 1, right) if right - c < c - left]
+    rows = list(range(top, bottom + 1))
