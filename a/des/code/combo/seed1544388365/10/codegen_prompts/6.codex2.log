+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BG_COLOR = 0
+GREY_COLOR = 5
+REGION_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+GRID_SIDE_MIN = 22
+GRID_SIDE_MAX = 30
+REGION_COUNT_RANGE = (2, 4)
+HOLE_COUNT_CHOICES = (1, 2, 3)
