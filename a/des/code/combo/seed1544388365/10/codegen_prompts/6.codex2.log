+        union_coords = np.argwhere(mask)
+        signature, shape = normalize_coords(union_coords)
+        tight = np.zeros(shape, dtype=bool)
+        sig_arr = signature_to_array(signature)
+        tight[sig_arr[:, 0], sig_arr[:, 1]] = True
+        comps = components_mask(tight)
