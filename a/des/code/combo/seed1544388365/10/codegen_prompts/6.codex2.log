+
+    expected_pairs = {(spec["color"], spec["signature"]) for spec in region_specs}
+    if not validate_generated_grid(grid, expected_pairs):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        try:
+            grid = _gen_attempt()
+        except Exception:
+            grid = None
+        if grid is not None:
