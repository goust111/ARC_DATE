+def can_place_bbox(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> bool:
+    H, W = reserved.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    rs = max(0, r0 - pad)
+    re = min(H, r0 + h + pad)
+    cs = max(0, c0 - pad)
+    ce = min(W, c0 + w + pad)
+    return not reserved[rs:re, cs:ce].any()
