+    h, w = shape
+    H, W = grid.shape
+    positions = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
+    random.shuffle(positions)
+    coords = signature_to_array(signature)
+    for r0, c0 in positions:
