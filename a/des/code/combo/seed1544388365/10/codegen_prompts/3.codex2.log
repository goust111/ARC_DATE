    gaps = [int(rng.integers(*GEN_GAP_RANGE)) for _ in range(max(0, len(colors) - 1))]
    span = sum(major) + sum(gaps)
    max_start = height - span - 1
    if max_start < 1:
        return None

    start_r = int(rng.integers(1, max_start + 1))
    direction = 1 if rng.random() < 0.5 else -1

