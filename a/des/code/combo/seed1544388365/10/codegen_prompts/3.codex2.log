+    outgoing: dict[int, int | None] = {sid: None for sid in shapes}
+    incoming: dict[int, int] = {}
+    for sid, arrow in shape_to_arrow.items():
+        r, c = arrow["pos"]
+        dr, dc = arrow["dir"]
+        rr = r + dr
+        cc = c + dc
+        target = None
+        while 0 <= rr < h and 0 <= cc < w:
+            other = int(id_grid[rr, cc])
+            if other >= 0 and other != sid:
