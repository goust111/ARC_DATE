+def _parse_scene(grid: np.ndarray) -> tuple[int, dict[int, dict], dict[int, int | None], dict[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    h, w = g.shape
+    bg = get_bg(g)
+    shapes, id_grid = _extract_shapes(g, bg)
