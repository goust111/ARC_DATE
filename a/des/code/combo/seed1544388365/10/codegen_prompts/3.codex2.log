+GEN_MAX_LANE_LEN = 4
+GEN_BAND_SIZE_RANGE = (3, 6)  # high is exclusive
+GEN_MINOR_SIZE_RANGE = (1, 5)  # high is exclusive
+GEN_MAJOR_SIZE_RANGE = (2, 6)  # high is exclusive
