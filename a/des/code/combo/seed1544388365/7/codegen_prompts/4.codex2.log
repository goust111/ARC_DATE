    mask = np.zeros((PLUS_SHAPE_SIZE, PLUS_SHAPE_SIZE), dtype=bool)
    center = PLUS_SHAPE_SIZE // 2
    mask[center, :] = True
    mask[:, center] = True
    return mask


def _chebyshev_ok(new_coords: set, existing_blobs: list) -> bool:
