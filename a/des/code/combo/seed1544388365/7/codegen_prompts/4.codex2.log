+        base_r = int(_RNG.integers(row_lo, row_hi + 1))
+        base_c = int(_RNG.integers(col_lo, col_hi + 1))
+        path = [(base_r + r, base_c + c) for r, c in rel_path]
+        if all(not blocked[r, c] for r, c in path):
