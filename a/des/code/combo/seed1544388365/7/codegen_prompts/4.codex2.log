+    min_r = int(rel[:, 0].min())
+    max_r = int(rel[:, 0].max())
+    min_c = int(rel[:, 1].min())
+    max_c = int(rel[:, 1].max())
+
+    row_lo = 1 - min_r
+    row_hi = (h - 2) - max_r
+    col_lo = 1 - min_c
+    col_hi = (w - 2) - max_c
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
