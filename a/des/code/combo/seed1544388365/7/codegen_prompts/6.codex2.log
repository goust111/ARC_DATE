+    out = g.copy()
+    h, w = g.shape
+
+    for arrow in _find_arrows(g):
+        color = int(arrow["color"])
+        dr, dc = arrow["direction"]
+        r, c = arrow["start"]
+        nr, nc = r + dr, c + dc
+        while 0 <= nr < h and 0 <= nc < w:
+            cell = int(g[nr, nc])
+            if cell == BLACK:
+                out[nr, nc] = color
+                nr += dr
+                nc += dc
+                continue
+            if cell == color:
+                nr += dr
+                nc += dc
+                continue
+            out[nr, nc] = MAGENTA
+            break
+
+    return out
+
+
+def _reserve_with_moat(reserved: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    h, w = reserved.shape
