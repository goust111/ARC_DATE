+        for rr in range(max(0, r - 1), min(h, r + 2)):
+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                reserved[rr, cc] = True
+
+
+def _sample_scenarios(rng: np.random.Generator, n_arrows: int) -> list[str]:
