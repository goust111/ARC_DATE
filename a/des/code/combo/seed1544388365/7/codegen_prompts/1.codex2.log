+        patch = _mirror_patch(frame["interior"], frame["direction"])
+        ph, pw = patch.shape
+        top, left = _copy_origin(
+            frame["interior_top"],
+            frame["interior_left"],
+            ph,
+            pw,
+            frame["gap"],
+            frame["direction"],
+            anchor,
+        )
+        if top < 0 or left < 0 or top + ph > h or left + pw > w:
+            continue
