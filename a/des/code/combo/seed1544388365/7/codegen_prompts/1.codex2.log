+        anchor = (gap[0], gap[1] + distance)
+    elif direction == "left":
+        gap = (inner_top + gap_offset, c0)
+        anchor = (gap[0], gap[1] - distance)
+    elif direction == "down":
+        gap = (r0 + height + 1, inner_left + gap_offset)
+        anchor = (gap[0] + distance, gap[1])
+    else:
+        gap = (r0, inner_left + gap_offset)
+        anchor = (gap[0] - distance, gap[1])
