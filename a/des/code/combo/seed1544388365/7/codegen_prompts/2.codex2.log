+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            grid, expected = _generate_case()
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    raise RuntimeError(f"failed to generate a valid puzzle after {GEN_RETRIES} attempts")

