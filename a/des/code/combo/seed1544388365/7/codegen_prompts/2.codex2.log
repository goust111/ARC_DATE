+    color: int
+    mask: np.ndarray
+    sides: dict[str, Side]
+    top_pad: int
+    left_pad: int
+
+
+def _side(kind: str, pos: int = -1) -> Side:
+    return Side(kind, int(pos))
+
+
+def _is_flat(side: Side) -> bool:
+    return side.kind == "flat"
+
+
+def _complements(a: Side, b: Side) -> bool:
+    return (
+        a.kind in {"tab", "slot"}
+        and b.kind in {"tab", "slot"}
+        and a.kind != b.kind
+        and a.pos == b.pos
+    )
