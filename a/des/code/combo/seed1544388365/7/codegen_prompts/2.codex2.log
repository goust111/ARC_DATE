+    max_h = max(piece.mask.shape[0] for piece in pieces)
+    max_w = max(piece.mask.shape[1] for piece in pieces)
+    total_bbox_area = sum(int(piece.mask.shape[0] * piece.mask.shape[1]) for piece in pieces)
