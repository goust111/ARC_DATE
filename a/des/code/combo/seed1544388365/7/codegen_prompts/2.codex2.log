+                side_specs[r][c + 1]["left"] = _side("slot", pos)
+            else:
+                side_specs[r][c]["right"] = _side("slot", pos)
+                side_specs[r][c + 1]["left"] = _side("tab", pos)
+
+    v_idx = 0
+    for r in range(rows - 1):
+        for c in range(cols):
