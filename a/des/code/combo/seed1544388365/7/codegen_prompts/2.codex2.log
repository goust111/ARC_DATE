+    needed_w = cols * max(rows - 1, 0)
+    base_h = random.randint(max(4, needed_h + 2), max(5, needed_h + 4))
+    base_w = random.randint(max(4, needed_w + 2), max(5, needed_w + 4))
+    return base_h, base_w
+
+
