+            v_idx += 1
+            if random.random() < 0.5:
+                side_specs[r][c]["bottom"] = _side("tab", pos)
+                side_specs[r + 1][c]["top"] = _side("slot", pos)
+            else:
+                side_specs[r][c]["bottom"] = _side("slot", pos)
+                side_specs[r + 1][c]["top"] = _side("tab", pos)
