+        (0, 1): _mode(g[1:-1, -1]),
+        (1, 0): _mode(g[-1, 1:-1]),
+        (0, -1): _mode(g[1:-1, 0]),
+    }
+
+
+def _find_clocks(grid: np.ndarray) -> list[tuple[int, int, tuple[int, int]]]:
