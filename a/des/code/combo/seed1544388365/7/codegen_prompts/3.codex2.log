+def _too_close(pos_a: tuple[int, int], pos_b: tuple[int, int]) -> bool:
+    r1, c1 = pos_a
+    r2, c2 = pos_b
+    rows_separated = r1 + 4 < r2 - 1 or r2 + 4 < r1 - 1
+    cols_separated = c1 + 4 < c2 - 1 or c2 + 4 < c1 - 1
+    return not (rows_separated or cols_separated)
