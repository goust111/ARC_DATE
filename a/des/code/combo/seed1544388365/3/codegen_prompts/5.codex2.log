+            blocks.append(Block(core=core, arms=arms))
+
+    count = len(blocks)
+    pitch = side + 4
+    base = max(side + 4, int(math.ceil(math.sqrt(count))) * pitch)
+    height = rng.randint(base, base + pitch + 6)
+    width = rng.randint(base, base + pitch + 6)
