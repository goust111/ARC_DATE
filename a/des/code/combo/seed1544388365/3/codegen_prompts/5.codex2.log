+def _rects_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    at, al, ab, ar = a
+    bt, bl, bb, br = b
+    return not (ab + 1 < bt or bb + 1 < at or ar + 1 < bl or br + 1 < al)
