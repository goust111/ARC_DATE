+        for side_name, (off, color) in block.arms.items():
+            if side_name == "up":
+                grid[r0 - 1, c0 + off] = int(color)
+            elif side_name == "down":
+                grid[r0 + side, c0 + off] = int(color)
+            elif side_name == "left":
+                grid[r0 + off, c0 - 1] = int(color)
+            else:
+                grid[r0 + off, c0 + side] = int(color)
