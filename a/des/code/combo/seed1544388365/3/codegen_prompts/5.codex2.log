+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_ATTEMPTS):
+        try:
+            grid, expected = _build_instance(rng)
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
