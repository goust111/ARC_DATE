+    coords: dict[int, tuple[int, int]] = {root: (0, 0)}
+    q = deque([root])
+    while q:
+        idx = q.popleft()
+        row, col = coords[idx]
+        if idx in right_of:
+            nbr = right_of[idx]
+            target = (row, col + 1)
