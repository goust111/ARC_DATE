+        cols = np.array([c for _r, c, _color in fragments], dtype=int)
+        dst_rows, dst_cols = _direction_shift(direction, r0, c0, r1, c1, rows, cols)
+
+        for (dst_r, dst_c), (_src_r, _src_c, color) in zip(zip(dst_rows, dst_cols), fragments):
+            nr = int(dst_r)
