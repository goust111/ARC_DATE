+
+    for room in sorted(rooms, key=lambda spec: (spec["foot_bbox_rel"][2] - spec["foot_bbox_rel"][0] + 1) * (spec["foot_bbox_rel"][3] - spec["foot_bbox_rel"][1] + 1), reverse=True):
