+
+def _find_monochrome_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(g[r0, c0])
+            if color == int(bg) or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r0
+            min_c = max_c = c0
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                min_r = min(min_r, r)
+                max_r = max(max_r, r)
+                min_c = min(min_c, c)
+                max_c = max(max_c, c)
+                for dr, dc in DIRS4:
