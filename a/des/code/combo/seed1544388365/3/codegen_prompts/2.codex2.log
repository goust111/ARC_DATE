+GEN_ATTEMPTS = 400
+GRID_SIDE_RANGE = (16, 30)
+ROOM_COUNT_CHOICES = [1, 2, 2, 3, 3, 4]
+ROOM_OUTER_RANGE = (5, 9)
+FRAGMENT_COLORS_MAX = 3
