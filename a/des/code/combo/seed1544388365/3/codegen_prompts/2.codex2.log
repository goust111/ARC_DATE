+
+
+def _candidate_positions(room: dict, shape: tuple[int, int], blocked: np.ndarray) -> list[tuple[int, int]]:
+    h, w = shape
+    fr0, fc0, fr1, fc1 = room["foot_bbox_rel"]
+    r_min = -fr0
+    r_max = h - 1 - fr1
+    c_min = -fc0
+    c_max = w - 1 - fc1
+    if r_min > r_max or c_min > c_max:
