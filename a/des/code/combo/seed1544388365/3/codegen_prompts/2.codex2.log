+    ar0 = int(room["r0"]) + fr0
+    ac0 = int(room["c0"]) + fc0
+    ar1 = int(room["r0"]) + fr1
+    ac1 = int(room["c0"]) + fc1
+    pr0 = max(0, ar0 - 1)
+    pc0 = max(0, ac0 - 1)
+    pr1 = min(h - 1, ar1 + 1)
+    pc1 = min(w - 1, ac1 + 1)
