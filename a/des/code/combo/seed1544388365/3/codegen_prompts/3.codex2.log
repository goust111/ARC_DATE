+import numpy as np
+
+
+BG = 0
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (8, 19)
+GRID_W_RANGE = (11, 24)
+PALETTE_LEN_RANGE = (3, 7)
+PANEL_COL_OPTIONS = (0, 1, 2)
+SEED_COUNT_RANGE = (2, 7)
+GEN_RETRIES = 400
+POSITION_RETRIES = 120
