+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+PALETTE_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_H_RANGE = (11, 24)
+GRID_W_RANGE = (12, 30)
+LEGEND_LEN_RANGE = (3, 7)
