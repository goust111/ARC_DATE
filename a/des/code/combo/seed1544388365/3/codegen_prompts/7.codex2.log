+    out = g.copy()
+    for rect in rects:
+        candidates = _candidate_stamps(rect["shape"], rect["hints"], rotations)
+        assert len(candidates) == 1, "hint pair should determine a unique stamp placement"
+        r0, c0, _, _ = rect["bbox"]
+        for rr, cc in next(iter(candidates)):
+            out[r0 + rr, c0 + cc] = BG
