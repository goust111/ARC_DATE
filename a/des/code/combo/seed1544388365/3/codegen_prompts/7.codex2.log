+def _corner_bbox(corner: str, grid_h: int, grid_w: int, obj_h: int, obj_w: int) -> tuple[int, int, int, int]:
+    if corner == "TL":
+        r0, c0 = 0, 0
+    elif corner == "TR":
+        r0, c0 = 0, grid_w - obj_w
+    elif corner == "BL":
+        r0, c0 = grid_h - obj_h, 0
+    elif corner == "BR":
+        r0, c0 = grid_h - obj_h, grid_w - obj_w
+    else:
