+
+    max_pairs = min(PAIR_COUNT_RANGE[1], len(COLOR_POOL), max(PAIR_COUNT_RANGE[0], (H * W) // PAIR_DENSITY))
+    pair_count = random.randint(PAIR_COUNT_RANGE[0], max_pairs)
