+    region_keys = key_colors[:]
+    while len(region_keys) < n_regions:
+        region_keys.append(rng.choice(key_colors))
+    rng.shuffle(region_keys)
+
+    forbidden = np.zeros((h, w), dtype=bool)
+    forbidden[:, max_col_exclusive:] = True
