+
+def _random_shape(rng: random.Random) -> np.ndarray | None:
+    for _ in range(200):
+        h = rng.randint(3, 6)
+        w = rng.randint(3, 6)
+        min_area = max(6, (h * w * 3 + 4) // 5)
+        max_area = h * w - 1
+        if min_area > max_area:
+            continue
+        target = rng.randint(min_area, max_area)
