+def _region_from_shape(shape: np.ndarray, key_color: int, rng: random.Random) -> dict:
+    ih, iw = shape.shape
+    interior = np.zeros((ih + 2, iw + 2), dtype=bool)
+    interior[1 : ih + 1, 1 : iw + 1] = shape
