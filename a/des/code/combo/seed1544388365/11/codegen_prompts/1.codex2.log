+
+def _random_partition(total: int, parts: int, rng: random.Random) -> list[int]:
+    cuts = sorted(rng.randrange(total + 1) for _ in range(parts - 1))
+    values = []
+    prev = 0
+    for cut in cuts:
+        values.append(cut - prev)
+        prev = cut
+    values.append(total - prev)
+    return values
+
