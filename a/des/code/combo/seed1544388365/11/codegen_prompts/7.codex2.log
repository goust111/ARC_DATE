+    choices: list[tuple[int, int]] = []
+    for nxt in _neighbors(cell, passable):
+        step = _direction(cell, nxt)
+        if step != back:
+            choices.append(step)
+
+    if not choices:
+        return None
+    if len(choices) == 1:
+        return choices[0]
