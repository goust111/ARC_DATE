) -> np.ndarray:
    out = grid.copy()
    for i, (c0, c1, _color) in enumerate(bands):
        fill_color = bands[(i + 1) % len(bands)][2]
        band = out[:, c0 : c1 + 1]
        band[band == bg] = fill_color
    return out


def _gen_attempt() -> np.ndarray | None:
