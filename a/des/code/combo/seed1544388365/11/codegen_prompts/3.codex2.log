+    bg = _bg_color(g)
+    cross_r, cross_c, cross_color = _detect_cross(g, bg)
+    objects = _extract_objects(g, bg, cross_r, cross_c, cross_color)
+    assert len(objects) == 4, "expected one object per quadrant"
