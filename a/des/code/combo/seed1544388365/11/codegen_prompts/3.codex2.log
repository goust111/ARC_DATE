+    quadrant_order = {
+        "top-left": 0,
+        "top-right": 1,
+        "bottom-left": 2,
+        "bottom-right": 3,
+    }
+
+    out = np.full_like(g, bg)
+    out[cross_r, :] = cross_color
+    out[:, cross_c] = cross_color
