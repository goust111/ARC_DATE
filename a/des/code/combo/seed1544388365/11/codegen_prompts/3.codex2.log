+def _sample_offset(rng: random.Random, low: int, high: int, prefer_high: bool) -> int:
+    if low == high:
+        return low
+    if rng.random() < 0.65:
+        mid = (low + high) // 2
+        if prefer_high:
+            return rng.randint(mid, high)
