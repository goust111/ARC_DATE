+    outer_pad_r = rng.randint(0, 1)
+    outer_pad_c = rng.randint(0, 1)
+    inner_pad_r = rng.randint(0, 1)
+    inner_pad_c = rng.randint(0, 1)
+
+    if quadrant == "top-left":
+        row_low = outer_pad_r
+        row_high = cross_r - inner_pad_r - mh
+        col_low = outer_pad_c
+        col_high = cross_c - inner_pad_c - mw
