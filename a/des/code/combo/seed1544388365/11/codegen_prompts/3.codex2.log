+BG = 0
+CROSS = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_SIDE_MIN = 22
+GRID_SIDE_MAX = 30
+MAX_HOLES = 3
+GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 200
