+            r0, c0, r1, c1 = _bbox(coords)
+            local = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+            quadrant = _quadrant_name(coords, cross_r, cross_c)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "quadrant": quadrant,
+                    "holes": _count_holes(local),
+                }
+            )
+    return objects
