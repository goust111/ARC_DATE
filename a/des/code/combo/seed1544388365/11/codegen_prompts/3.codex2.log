+    objects.sort(key=lambda obj: (int(obj["holes"]), quadrant_order[str(obj["quadrant"])]))
+    for obj in objects:
+        steps = int(obj["holes"])
+        dr, dc = _shift_for_quadrant(str(obj["quadrant"]), steps)
+        coords = np.asarray(obj["coords"], dtype=int)
+        for r, c in coords:
+            rr = int(r) + dr
