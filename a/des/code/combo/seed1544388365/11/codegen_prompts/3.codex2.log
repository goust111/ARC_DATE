+    center_r = (h - 1) / 2.0
+    center_c = (w - 1) / 2.0
+    matches: list[tuple[float, int, int, int]] = []
+    for r, row_color in row_candidates:
+        for c, col_color in col_candidates:
+            if row_color == col_color:
+                score = abs(r - center_r) + abs(c - center_c)
+                matches.append((score, r, c, row_color))
+
