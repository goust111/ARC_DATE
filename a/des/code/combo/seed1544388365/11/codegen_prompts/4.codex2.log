+        col = cols[idx]
+        r0 = rows[idx]
+        r1 = rows[idx + 1]
+        grid[min(r0, r1) : max(r0, r1) + 1, col] = color
+        grid[r1, col] = body_colors[idx + 1] if idx + 1 < n_segments else terminal_color
+    return grid
