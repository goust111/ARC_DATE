def _components(mask: np.ndarray) -> list[list[Coord]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[Coord]] = []
    for r in range(h):
        for c in range(w):
            if not bool(mask[r, c]) or bool(seen[r, c]):
                continue
            stack = [(r, c)]
            seen[r, c] = True
            comp: list[Coord] = []
            while stack:
                rr, cc = stack.pop()
                comp.append((rr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(comp)
    return comps


def _straight_component_info(comp: list[Coord]) -> tuple[str, Coord, Coord] | None:
    rows = sorted({r for r, _ in comp})
    cols = sorted({c for _, c in comp})
    if len(rows) == 1:
        row = rows[0]
        if cols != list(range(cols[0], cols[-1] + 1)):
            return None
        return "h", (row, cols[0]), (row, cols[-1])
    if len(cols) == 1:
        col = cols[0]
        if rows != list(range(rows[0], rows[-1] + 1)):
            return None
        return "v", (rows[0], col), (rows[-1], col)
    return None


def _step_toward(start: Coord, end: Coord) -> Coord:
    dr = end[0] - start[0]
    dc = end[1] - start[1]
    if dr:
        return (1 if dr > 0 else -1, 0)
    if dc:
        return (0, 1 if dc > 0 else -1)
    raise AssertionError("expected distinct coordinates")


