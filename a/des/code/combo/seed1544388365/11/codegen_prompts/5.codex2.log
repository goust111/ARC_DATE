+def _extract_frame(grid: np.ndarray, color: int) -> dict | None:
+    pts = np.argwhere(grid == color)
+    if pts.size == 0:
+        return None
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+    if r1 - r0 < 2 or c1 - c0 < 2:
