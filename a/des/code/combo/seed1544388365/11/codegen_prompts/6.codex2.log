+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE_TRANSFORMS = ("identity", "hflip", "vflip", "rot_cw", "rot_ccw")
+ALL_COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+PLACEMENT_TRIES = 250
