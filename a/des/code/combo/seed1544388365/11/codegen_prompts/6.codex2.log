    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1].copy()


def _random_shape() -> np.ndarray | None:
    for _ in range(SHAPE_TRIES):
        raw_h = random.randint(3, 7)
        raw_w = random.randint(3, 7)
        mask = np.zeros((raw_h, raw_w), dtype=bool)
