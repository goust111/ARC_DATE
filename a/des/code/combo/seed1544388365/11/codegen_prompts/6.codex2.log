    r = 0 if corner in ("TL", "TR") else h - 1
    c = 0 if corner in ("TL", "BL") else w - 1
    return r, c


def _gen_step_range(a: int, b: int) -> range:
    step = 1 if b >= a else -1
    return range(a, b + step, step)


