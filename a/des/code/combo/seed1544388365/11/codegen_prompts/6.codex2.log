    if random.random() < 0.5:
        for r in _gen_step_range(sr, er):
            mask[r, sc] = True
        for c in _gen_step_range(sc, ec):
            mask[er, c] = True
    else:
        for c in _gen_step_range(sc, ec):
            mask[sr, c] = True
        for r in _gen_step_range(sr, er):
