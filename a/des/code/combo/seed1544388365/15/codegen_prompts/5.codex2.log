+        inner_w = w - 2
+        rect_h = int(spec["rect_h"])
+        rect_w = int(spec["rect_w"])
+        rr = int(r0 + 1 + (inner_h - rect_h) // 2)
+        cc = int(c0 + 1 + (inner_w - rect_w) // 2)
+        out[rr : rr + rect_h, cc : cc + rect_w] = int(spec["color"])
