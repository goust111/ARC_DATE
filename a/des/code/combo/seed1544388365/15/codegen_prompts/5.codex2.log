+        off_r = (inner_h - rect_h) // 2
+        off_c = (inner_w - rect_w) // 2
+        rr = int(r0 + 1 + off_r)
+        cc = int(c0 + 1 + off_c)
+        out[rr : rr + rect_h, cc : cc + rect_w] = int(item["color"])
+
+    return out
