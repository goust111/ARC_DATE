+
+def _mark_occupied(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    top = max(0, r0 - 1)
+    left = max(0, c0 - 1)
+    bottom = min(occupied.shape[0], r0 + h + 1)
+    right = min(occupied.shape[1], c0 + w + 1)
