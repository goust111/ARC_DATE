+    return specs
+
+
+def _slot_layout(specs: list[dict], rng: np.random.Generator) -> tuple[int, int, int, int, int]:
+    max_rect_h = max(int(spec["rect_h"]) for spec in specs)
+    max_rect_w = max(int(spec["rect_w"]) for spec in specs)
+    inner_h = max_rect_h + int(rng.integers(0, 3))
+    inner_w = max_rect_w + int(rng.integers(0, 3))
+    slot_h = inner_h + 2
+    slot_w = inner_w + 2
+    gap = int(rng.integers(2, 5))
+    left = int(rng.integers(1, 4))
+    right = int(rng.integers(1, 5))
+    width = left + len(specs) * slot_w + (len(specs) - 1) * gap + right
+    return inner_h, inner_w, slot_h, slot_w, width
+
+
+def _place_segments(
+    grid: np.ndarray,
+    specs: list[dict],
+    top_h: int,
+    rng: np.random.Generator,
+) -> bool:
+    occupied = np.zeros((top_h, grid.shape[1]), dtype=bool)
+    segments: list[dict] = []
+    for spec in specs:
+        for _ in range(int(spec["count"])):
+            segments.append(
+                {
+                    "color": int(spec["color"]),
+                    "length": int(spec["length"]),
+                    "orient": spec["orient"],
+                }
