+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+SLOT_COLOR = 5
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
