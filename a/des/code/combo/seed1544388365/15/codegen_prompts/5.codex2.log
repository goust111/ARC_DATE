+        6 + sum(int(spec["count"]) for spec in specs) // 2,
+        8,
+    ) + int(rng.integers(0, 6))
+    slot_gap_v = int(rng.integers(1, 3))
+    bottom_margin = int(rng.integers(0, 2))
+    height = top_h + slot_gap_v + slot_h + bottom_margin
+    slot_top = top_h + slot_gap_v
