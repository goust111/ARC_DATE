+GRID_SIDE_RANGE = (18, 26)
+ROOM_COUNT_RANGE = (1, 3)
+ROOM_PADDING = 1
+MAX_ROOM_PLACE_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 300
