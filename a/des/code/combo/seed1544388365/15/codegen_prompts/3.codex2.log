+    rr1 = r0 + room_h - 1 + ROOM_PADDING + (depth if gap_side == "down" else 0)
+    cc0 = c0 - ROOM_PADDING - (depth if gap_side == "left" else 0)
+    cc1 = c0 + room_w - 1 + ROOM_PADDING + (depth if gap_side == "right" else 0)
