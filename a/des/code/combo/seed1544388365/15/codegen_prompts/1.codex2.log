+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rows = comp["coords"][:, 0] - r0
+    cols = comp["coords"][:, 1] - c0
+    mask[rows, cols] = True
+    return mask
