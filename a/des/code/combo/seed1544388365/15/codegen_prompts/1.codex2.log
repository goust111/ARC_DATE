+            continue
+        r0, c0, r1, c1 = comp["bbox"]
+        size = r1 - r0 + 1
+        if c0 == 0:
+            key = ("left", size, c0)
+        elif c1 == w - 1:
+            key = ("right", size, c1)
+        else:
