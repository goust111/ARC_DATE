+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, Any]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict[str, Any]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+
+    return components
+
+
+def _component_mask(comp: dict[str, Any]) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rows = comp["coords"][:, 0] - r0
+    cols = comp["coords"][:, 1] - c0
+    mask[rows, cols] = True
+    return mask
+
+
+def _is_solid_square(comp: dict[str, Any]) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    return h == w and len(comp["coords"]) == h * w
+
+
+def _is_rectangular_frame(comp: dict[str, Any]) -> bool:
+    mask = _component_mask(comp)
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    if not mask[0, :].all() or not mask[-1, :].all():
+        return False
+    if not mask[:, 0].all() or not mask[:, -1].all():
+        return False
+    return not mask[1:-1, 1:-1].any()
+
+
+def _strictly_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    return (
+        outer[0] < inner[0]
+        and outer[1] < inner[1]
+        and outer[2] > inner[2]
+        and outer[3] > inner[3]
+    )
+
+
+def _find_legend(
+    components: list[dict[str, Any]], shape: tuple[int, int]
+) -> list[dict[str, Any]]:
+    h, w = shape
+    groups: dict[tuple[str, int, int], list[dict[str, Any]]] = {}
+
+    for comp in components:
