+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Move each outside monochrome fragment into the same-color hole inside its broken frame.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    out = g.copy()
