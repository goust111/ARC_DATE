+    next_color = {cycle[i]: cycle[(i + 1) % 4] for i in range(4)}
+    occupied = _build_occupied(shape, origin, seeds)
+    used: set[tuple[int, int]] = set()
+    reasons: list[str] = []
+    blocked: list[tuple[int, int] | None] = []
+    path_sizes: list[int] = []
+
+    for r, c, color in seeds:
