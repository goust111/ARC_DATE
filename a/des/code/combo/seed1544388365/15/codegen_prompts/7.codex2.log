        if any(v == bg for v in flat):
            continue
        if len(set(flat)) != 4:
            continue
        cycle = [int(patch[0, 0]), int(patch[0, 1]), int(patch[1, 1]), int(patch[1, 0])]
        coords = {(r0 + dr, c0 + dc) for dr in range(2) for dc in range(2)}
        candidates.append((cycle, coords, (r0, c0)))

