+    return grid
+
+
+def _build_occupied(shape: tuple[int, int], origin: tuple[int, int], seeds: list[tuple[int, int, int]]) -> np.ndarray:
+    occupied = _legend_mask(shape, origin)
+    for r, c, _color in seeds:
