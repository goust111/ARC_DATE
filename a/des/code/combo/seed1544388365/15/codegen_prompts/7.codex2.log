+                continue
+            if "occupied" not in analysis["reasons"]:
+                continue
+            return seeds2
+    return None
+
+
+def _valid_example(
+    inp: np.ndarray,
+    cycle: list[int],
+    origin: tuple[int, int],
+    mode: str,
+) -> bool:
+    legend_coords = {(origin[0] + dr, origin[1] + dc) for dr in range(2) for dc in range(2)}
