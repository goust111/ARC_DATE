+        path, _reason, _hit = _trace_path(start, first_color, dir_by_color, next_color, occupied)
+        blocker_candidates = [(r, c) for idx, (r, c, _col) in enumerate(path) if idx >= 2]
+        rng.shuffle(blocker_candidates)
