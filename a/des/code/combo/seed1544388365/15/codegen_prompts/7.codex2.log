+
+
+def _chebyshev_far_enough(a: tuple[int, int], b: tuple[int, int], gap: int = 1) -> bool:
+    return max(abs(a[0] - b[0]), abs(a[1] - b[1])) > gap
+
+
+def _candidate_cells(
+    shape: tuple[int, int],
+    moat: np.ndarray,
+    seeds: list[tuple[int, int, int]],
+) -> list[tuple[int, int]]:
