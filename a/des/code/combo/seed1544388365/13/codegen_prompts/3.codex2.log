+    mark_dr, mark_dc = DIR_VECTORS[direction]
+    for r in range(height):
+        for c in range(width):
+            marker = (r + mark_dr, c + mark_dc)
+            if _in_frame_box(r, c, frame_bbox) or _in_frame_box(marker[0], marker[1], frame_bbox):
