+import random
+
+import numpy as np
+
+
+DIRECTIONS = ("up", "right", "down", "left")
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+MAX_GENERATION_ATTEMPTS = 500
