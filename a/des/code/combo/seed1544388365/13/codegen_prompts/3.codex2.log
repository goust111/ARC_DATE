+        target_area = rng.randint(4, min(8, height * width - (width - 1)))
+        while int(mask.sum()) < target_area:
+            cells = np.argwhere(mask)
+            cr, cc = cells[rng.randrange(len(cells))]
+            dr, dc = rng.choice(((1, 0), (0, -1), (0, 1), (-1, 0)))
+            nr = int(cr + dr)
