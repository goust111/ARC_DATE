+        valid = True
+        for side in DIRECTIONS:
+            dr, dc = DIR_VECTORS[side]
+            nr = rr + dr
+            nc = cc + dc
+            if not (0 <= nr < height and 0 <= nc < width):
+                continue
+            value = int(grid[nr, nc])
+            if value == bg:
+                continue
+            if value == marker_color:
+                directions.append(side)
+            else:
+                valid = False
+                break
