+            height,
+            width,
+            direction,
+            stamp_offsets,
+            frame_bbox,
+            occupied_input,
+            occupied_output,
+        )
+        if not candidates:
+            return None
+
+        preferred = candidates
+        if need_clipped and not clipped_used:
