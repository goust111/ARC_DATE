+        contact = (0, int(np.flatnonzero(cropped[0, :])[0]))
+        offsets = np.argwhere(cropped).astype(int)
+        offsets[:, 0] -= int(contact[0])
+        offsets[:, 1] -= int(contact[1])
+        return offsets
