+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, height: int, width: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < height:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < width:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, height, width):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _border_mask(height: int, width: int) -> np.ndarray:
+    border = np.zeros((height, width), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return border
+
+
+def _frame_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    border = _border_mask(r1 - r0 + 1, c1 - c0 + 1)
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = border
+    return mask
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
+    for value in np.unique(grid):
+        color = int(value)
+        if color == bg:
+            continue
+        for coords in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(coords)
+            height = r1 - r0 + 1
+            width = c1 - c0 + 1
+            if height < 3 or width < 3:
+                continue
+            if len(coords) != 2 * (height + width) - 4:
+                continue
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = _border_mask(height, width)
+            if not np.all(patch[border] == color):
+                continue
+            if np.any(patch[~border] == color):
+                continue
+            inner_colors = set(map(int, np.unique(patch[1:-1, 1:-1]))) - {bg}
+            if len(inner_colors) != 1:
