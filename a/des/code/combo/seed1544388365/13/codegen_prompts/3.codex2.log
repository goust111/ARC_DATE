+def _rotate_offsets(offsets: np.ndarray, turns_cw: int) -> np.ndarray:
+    turns_cw %= 4
+    rotated = offsets.copy().astype(int)
+    for _ in range(turns_cw):
+        rotated = np.column_stack((rotated[:, 1], -rotated[:, 0]))
+    return rotated
