+    if base_side == "up":
+        contact = (0, int(np.flatnonzero(mask[0, :])[0]))
+    elif base_side == "down":
+        contact = (mask.shape[0] - 1, int(np.flatnonzero(mask[-1, :])[0]))
+    elif base_side == "left":
+        contact = (int(np.flatnonzero(mask[:, 0])[0]), 0)
+    else:
+        contact = (int(np.flatnonzero(mask[:, -1])[0]), mask.shape[1] - 1)
+
