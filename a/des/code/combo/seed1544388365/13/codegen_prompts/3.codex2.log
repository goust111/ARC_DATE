+    offsets[:, 0] -= int(contact[0])
+    offsets[:, 1] -= int(contact[1])
+    return color, base_side, offsets
+
+
+def _find_anchors(
+    grid: np.ndarray, frame_mask: np.ndarray, frame_color: int, marker_color: int, bg: int
