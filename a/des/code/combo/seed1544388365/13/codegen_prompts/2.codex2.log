+
+        occupied: set[tuple[int, int]] = set()
+        placed: list[tuple[tuple[int, int], ...]] = []
+
+        success = True
+        for piece_idx in order:
+            piece = pieces[piece_idx]
+            candidates: list[tuple[tuple[int, int], ...]] = []
+            for top in range(canvas_h - piece["h"] + 1):
