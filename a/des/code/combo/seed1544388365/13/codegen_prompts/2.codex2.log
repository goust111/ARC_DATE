+            sizes[piece_idx] += 1
+            remaining -= 1
+            add_frontier(piece_idx, choice)
+
+        if remaining != 0:
+            continue
+
+        pieces: list[list[tuple[int, int]]] = []
+        for idx in range(piece_count):
