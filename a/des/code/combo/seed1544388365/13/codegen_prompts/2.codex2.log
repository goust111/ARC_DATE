+    if not valid:
+        raise AssertionError("pieces must tile a rectangle")
+    if len(valid) == 1:
+        return valid[0]
+
+    valid.sort(
+        key=lambda dims: (
+            abs(dims[0] - row_hint) + abs(dims[1] - col_hint),
+            abs(dims[0] - dims[1]),
+            dims[0],
+            dims[1],
+        )
+    )
+    return valid[0]
