+
+def _projection_hint(grid: np.ndarray, color: int) -> tuple[int, int]:
+    coords = np.argwhere(grid == color)
+    rows = {int(r) for r, _ in coords}
+    cols = {int(c) for _, c in coords}
+    return len(rows), len(cols)
