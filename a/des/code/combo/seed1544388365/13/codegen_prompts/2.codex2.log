+    for h in range(1, int(area**0.5) + 1):
+        if area % h != 0:
+            continue
+        w = area // h
+        for out_h, out_w in ((h, w), (w, h)):
+            if out_h < max_h or out_w < max_w:
+                continue
+            if (out_h, out_w) in valid:
+                continue
+            if _can_tile_rectangle(pieces, out_h, out_w):
+                valid.append((out_h, out_w))
