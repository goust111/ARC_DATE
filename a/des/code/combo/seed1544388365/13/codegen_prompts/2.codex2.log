+        rectangles.append(
+            {
+                "color": color,
+                "count": len(pieces),
+                "area": sum(piece["area"] for piece in pieces),
+                "h": dims[0],
+                "w": dims[1],
+                "anchor": (top, left),
+            }
+        )
