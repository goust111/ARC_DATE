+
+    if color_count == 3:
+        if float(_RNG.random()) < 0.5:
+            repeated = int(_RNG.integers(2, 5))
+            other = int(_RNG.choice([count for count in (2, 3, 4) if count != repeated]))
+            counts = [repeated, repeated, other]
+        else:
+            counts = [2, 3, 4]
+        _RNG.shuffle(counts)
