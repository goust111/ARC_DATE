+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+OBJ_COLOR = 5
+FRAME_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+MAX_GENERATION_ATTEMPTS = 400
+PADDING = 1
+
+
+def _round_half_up(value: float) -> int:
+    return int(np.floor(float(value) + 0.5))
+
+
+def _sign(value: int) -> int:
+    if value > 0:
+        return 1
+    if value < 0:
+        return -1
+    return 0
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _bbox_area(box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
+
+
+def _rounded_centroid(coords: np.ndarray) -> tuple[int, int]:
+    return (
+        _round_half_up(float(coords[:, 0].mean())),
+        _round_half_up(float(coords[:, 1].mean())),
+    )
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            components.append(np.asarray(cells, dtype=int))
+    return components
+
+
+def _foreground_components(grid: np.ndarray, bg: int) -> list[dict]:
+    components: list[dict] = []
