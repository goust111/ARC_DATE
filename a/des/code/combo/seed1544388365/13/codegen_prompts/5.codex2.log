+        if cached is not None:
+            return int(cached)
+        parent = frame["parent"]
+        depth = 1 if parent is None else depth_of(int(parent)) + 1
+        frame["depth"] = depth
+        return depth
+
+    for idx in range(len(frames)):
+        depth_of(idx)
+
+    for frame in frames:
