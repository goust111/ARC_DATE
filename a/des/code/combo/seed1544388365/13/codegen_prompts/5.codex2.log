+                {
+                    "coords": coords,
+                    "shifted": info["shifted"],
+                    "row_steps": info["row_steps"],
+                    "col_steps": info["col_steps"],
+                    "axis": info["axis"],
+                    "clipped": info["clipped"],
+                }
+            )
+    return candidates
