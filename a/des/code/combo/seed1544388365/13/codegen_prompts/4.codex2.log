+
+    if np.array_equal(grid, expected):
+        return None
+    if any(int(np.sum(grid == int(path["color"]))) < 2 for path in paths):
+        return None
+    if not _is_unique_order_from_grid(grid, expected_order):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
