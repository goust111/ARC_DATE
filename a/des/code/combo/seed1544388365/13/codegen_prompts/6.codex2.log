+    top_margin = int(_RNG.integers(MIN_TOP_MARGIN, MAX_TOP_MARGIN + 1))
+    left_margin = int(_RNG.integers(MIN_SIDE_MARGIN, MAX_SIDE_MARGIN + 1))
