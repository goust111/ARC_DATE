+        row = int(tower["top_row"])
+        col = int(tower["col"])
+        ray_len = int(tower["height"])
+
+        if idx > 0:
+            _draw_ray(
+                out,
+                tower_mask,
+                row=row,
+                start_col=col,
+                direction=-1,
+                length=ray_len,
+                color=int(towers[idx - 1]["color"]),
+            )
+        if idx + 1 < len(towers):
+            _draw_ray(
