+                out,
+                tower_mask,
+                row=row,
+                start_col=col,
+                direction=1,
+                length=ray_len,
+                color=int(towers[idx + 1]["color"]),
+            )
+
+    return out
+
+
+def _ray_stats(towers: list[dict[str, int]], width: int) -> list[dict[str, int | bool]] | None:
+    stats: list[dict[str, int | bool]] = []
