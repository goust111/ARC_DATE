+    candidates.sort(reverse=True)
+
+    for _area, rr0, cc0, rr1, cc1 in candidates:
+        remainder = sub.copy()
+        remainder[rr0 : rr1 + 1, cc0 : cc1 + 1] = False
+        side = _marker_gap_side(remainder)
+        if side is not None:
