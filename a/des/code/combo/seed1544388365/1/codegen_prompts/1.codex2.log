+    side, colors = max(candidates, key=lambda item: (len(set(map(int, item[1]))), len(item[1])))
+    mask = np.zeros_like(grid, dtype=bool)
+    if side == "left":
+        mask[:, 0] = True
+    elif side == "right":
+        mask[:, -1] = True
+    elif side == "top":
