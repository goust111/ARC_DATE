+
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (12, 17)
+OBJECT_COUNT_RANGE = (2, 4)
+RECT_H_RANGE = (3, 5)
+RECT_W_RANGE = (3, 5)
+GEN_RETRIES = 400
