+            cells.extend(seg)
+    elif direction == "down":
+        for r in range(r1 + 1, grid.shape[0]):
+            seg = [(r, c) for c in range(c0, c1 + 1)]
+            if any(grid[rr, cc] != bg for rr, cc in seg):
