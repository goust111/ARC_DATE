+    if misses["up"] == 0 and not np.all(sub[0, 1:-1]):
+        return None
+    if misses["down"] == 0 and not np.all(sub[-1, 1:-1]):
+        return None
+    if misses["left"] == 0 and not np.all(sub[1:-1, 0]):
+        return None
+    if misses["right"] == 0 and not np.all(sub[1:-1, -1]):
