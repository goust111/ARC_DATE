+def _is_irregular(cells: set[tuple[int, int]] | frozenset[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(cells)
+    return len(cells) < (r1 - r0 + 1) * (c1 - c0 + 1)
