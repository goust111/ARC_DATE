+    out_width = sum(item["shape"][1] for item in ordered) + len(ordered) - 1
+    out = np.full((out_height, out_width), bg, dtype=int)
+    col = 0
+    for item in ordered:
+        height, width = item["shape"]
+        out[:height, col : col + width] = item["sprite"]
+        col += width + 1
+    return out
