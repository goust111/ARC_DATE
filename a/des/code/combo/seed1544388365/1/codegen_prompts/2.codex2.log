+            norm_a = tuple(sorted((r - min_r, c - min_c) for r, c in cells_a))
+            norm_b = tuple(sorted((r - min_r, c - min_c) for r, c in shifted_b))
+            key = (height, width, norm_a, norm_b)
+            variants[key] = {
+                "shape": (height, width),
+                "cells_a": norm_a,
+                "cells_b": norm_b,
+                "area": height * width,
