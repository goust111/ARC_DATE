+RECT_SPECS = [(2, 3), (2, 4), (3, 3), (2, 5), (3, 4), (3, 5), (4, 4), (4, 5)]
+PAIR_COUNT_OPTIONS = (2, 3, 4)
+CANVAS_HEIGHT_RANGE = (18, 26)
+CANVAS_WIDTH_RANGE = (18, 26)
+SPLIT_TRIES = 300
+PLACEMENT_TRIES = 300
+GEN_RETRIES = 500
