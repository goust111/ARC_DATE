+        sprite = np.empty((height, width), dtype=int)
+        for r, c in variant["cells_a"]:
+            sprite[r, c] = int(components[i]["color"])
+        for r, c in variant["cells_b"]:
+            sprite[r, c] = int(components[j]["color"])
