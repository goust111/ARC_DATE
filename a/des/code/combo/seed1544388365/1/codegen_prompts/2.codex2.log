+        return False
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(g_height, top + height + 1)
+    c1 = min(g_width, left + width + 1)
+    return bool(np.all(grid[r0:r1, c0:c1] == bg))
