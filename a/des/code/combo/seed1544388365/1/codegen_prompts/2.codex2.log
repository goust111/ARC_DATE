+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    bg = rng.randint(0, 9)
+    sampled = _sample_rectangles(rng, bg)
+    if sampled is None:
+        return None
+    rectangles, piece_sprites = sampled
+    grid = _place_pieces(piece_sprites, bg, rng)
+    if grid is None:
+        return None
+    if np.count_nonzero(grid != bg) * 2 >= grid.size:
+        return None
