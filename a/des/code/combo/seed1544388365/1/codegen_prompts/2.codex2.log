+
+    def rec(remaining: frozenset[int], picked: list[tuple[int, int]]) -> None:
+        if len(solutions) >= limit:
+            return
+        if not remaining:
+            solutions.append(tuple(picked))
+            return
+        i = min(remaining)
+        for j in sorted(remaining):
+            if j <= i or (i, j) not in edge_variants:
+                continue
+            picked.append((i, j))
+            rec(remaining - {i, j}, picked)
+            picked.pop()
