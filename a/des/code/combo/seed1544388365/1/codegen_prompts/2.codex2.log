+            local_cells, shape = _normalize_cells(cells)
+            components.append(
+                {
+                    "color": color,
+                    "cells": local_cells,
+                    "shape": shape,
+                    "area": len(local_cells),
+                }
+            )
+    return components
+
+
+def _mask_signature(shape: tuple[int, int], cells: tuple[tuple[int, int], ...]) -> tuple[int, ...]:
+    height, width = shape
+    mask = [0] * (height * width)
+    for r, c in cells:
+        mask[r * width + c] = 1
+    return tuple(mask)
