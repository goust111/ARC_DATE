+        for _ in range(PLACEMENT_TRIES):
+            top = rng.randint(0, height - sprite.shape[0])
+            left = rng.randint(0, width - sprite.shape[1])
+            if _can_place(grid, sprite, top, left, bg):
+                _paste_sprite(grid, sprite, top, left, bg)
