+        variants.values(),
+        key=lambda item: (
+            item["area"],
+            item["shape"][0],
+            item["shape"][1],
+            _mask_signature(item["shape"], item["cells_a"]),
+            _mask_signature(item["shape"], item["cells_b"]),
+        ),
+    )
