+        if direction == RIGHT:
+            options.append(((r, c), (r, c + 1), (r, c + 2)))
+        else:
+            options.append(((r, c), (r, c - 1), (r, c - 2)))
+    else:
+        options.append(((r, c - 1), (r, c), (r, c + 1)))
+        if direction == DOWN:
