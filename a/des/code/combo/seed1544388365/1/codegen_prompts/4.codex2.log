+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Cast a ray from each 3x3-plus-arrow tower, turning on magenta mirrors and
+    recoloring grey receivers when hit.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _most_common_color(g)
