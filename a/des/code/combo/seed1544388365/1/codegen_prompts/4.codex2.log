+def _tower_body_ranges(shape: tuple[int, int], direction: tuple[int, int]) -> tuple[range, range]:
+    h, w = shape
+    if direction == UP:
+        return range(2, h - 2), range(0, w - 2)
+    if direction == DOWN:
+        return range(0, h - 4), range(0, w - 2)
