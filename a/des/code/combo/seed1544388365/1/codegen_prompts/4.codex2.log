+        DOWN: ({(rr, cc) for rr in range(3) for cc in range(3)} | {(3, 1)}, (r0, c0)),
+        LEFT: ({(rr, cc) for rr in range(3) for cc in range(1, 4)} | {(1, 0)}, (r0, c0 + 1)),
+        RIGHT: ({(rr, cc) for rr in range(3) for cc in range(3)} | {(1, 3)}, (r0, c0)),
