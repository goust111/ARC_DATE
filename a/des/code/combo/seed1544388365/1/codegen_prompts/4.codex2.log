+    r, c = start
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w and (r, c) not in blocked_exact and (r, c) not in local_used:
+        cells.append((int(r), int(c)))
