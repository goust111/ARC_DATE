MEDIUM_RUN_WIDTH_MAX = 4
SHORT_OBSTACLE_MAX_H = 4
MEDIUM_RUN_HEIGHT_MIN = 2

# Sparse post profile sampling.
WIDTH_PLACEMENT_RETRIES = 80
SPARSE_POST_MIN_BOTTOM_FRAC = 3
SPARSE_POST_MAX_BOTTOM_FRAC = 0.45
