+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _generate_candidate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid fenced-region puzzle")

