+    r0, c0 = map(int, coords.min(axis=0))
+    r1, c1 = map(int, coords.max(axis=0))
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (height + width) - 4:
+        return None
