+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border_mask = np.zeros((height, width), dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+
+    if not np.all(region[border_mask] == int(color)):
+        return None
+    if np.any(region[~border_mask] == int(color)):
