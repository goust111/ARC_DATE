+    if orientation == "h":
+        skeleton = [(fixed, start + i) for i in range(length)]
+        if marker_on_negative_side:
+            ordered = skeleton[:]
+            marker = (fixed, start - 1)
+        else:
+            ordered = skeleton[::-1]
+            marker = (fixed, start + length)
+    else:
+        skeleton = [(start + i, fixed) for i in range(length)]
+        if marker_on_negative_side:
