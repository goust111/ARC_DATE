+def _slot_bounds(length: int, parts: int) -> list[tuple[int, int]]:
+    base = length // parts
+    extra = length % parts
+    start = 0
+    bounds: list[tuple[int, int]] = []
+    for i in range(parts):
+        span = base + (1 if i < extra else 0)
+        bounds.append((start, start + span - 1))
+        start += span
+    return bounds
