    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H
    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W
    if min_h > MAX_H or min_w > MAX_W:
