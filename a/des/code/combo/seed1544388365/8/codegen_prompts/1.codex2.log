+    interior_mask = (g != GREY) & (~legend_mask)
+    out = g.copy()
+    for comp in _components(interior_mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        marker_colors = {
+            int(g[r, c])
