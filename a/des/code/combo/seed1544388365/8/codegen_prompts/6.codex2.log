+        shape_a, shape_b = shapes
+
+        for dr, dc in shape_b:
+            rr, cc = a_r + dr, a_c + dc
+            assert 0 <= rr < h and 0 <= cc < w
+            out[rr, cc] = color
+        for dr, dc in shape_a:
+            rr, cc = b_r + dr, b_c + dc
+            assert 0 <= rr < h and 0 <= cc < w
+            out[rr, cc] = color
