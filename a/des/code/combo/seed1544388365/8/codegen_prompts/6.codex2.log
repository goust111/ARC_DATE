+RING_OFFSETS = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if (dr, dc) != (0, 0)
+)
+CARDINAL_OFFSETS = {(-1, 0), (1, 0), (0, -1), (0, 1)}
