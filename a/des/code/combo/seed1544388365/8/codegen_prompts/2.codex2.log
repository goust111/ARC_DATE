+            anchor,
+            count,
+            radius,
+            row_phase,
+            col_phase,
+            occupied,
+        )
+        if pts is None:
+            return None
+        for r, c in pts:
+            grid[r, c] = color
+            occupied.add((r, c))
+
+    out = main(grid)
+    if np.array_equal(grid, out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
