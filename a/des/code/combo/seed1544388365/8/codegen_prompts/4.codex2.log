+    boxes = _component_bboxes(g != BLACK)
+    pieces: list[Piece] = []
+    for r0, c0, r1, c1 in boxes:
+        sub = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        pieces.append(Piece(sub, (r0, c0, r1, c1)))
+    pieces.sort(key=lambda p: (p.bbox[0], p.bbox[1]))
+    return pieces
+
