+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    pieces, expected, piece_shape = _make_pieces(rng)
+    inp = _scatter_pieces(pieces, piece_shape, rng)
+    if inp is None:
+        return None
+    try:
+        out = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(out, expected):
+        return inp
+    return None
