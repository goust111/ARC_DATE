+            r0 = rng.randint(1, canvas_h - ph - 1)
+            c0 = rng.randint(1, canvas_w - pw - 1)
+            bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if all(_separated(bbox, other) for other in placed):
+                grid[r0 : r0 + ph, c0 : c0 + pw] = piece
+                placed.append(bbox)
