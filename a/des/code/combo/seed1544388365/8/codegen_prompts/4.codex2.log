+    canvas_h = max(18, int((ph + 3) * np.ceil(np.sqrt(n))) + rng.randint(2, 8))
+    canvas_w = max(18, int((pw + 3) * np.ceil(np.sqrt(n))) + rng.randint(2, 8))
+    grid = np.full((canvas_h, canvas_w), BLACK, dtype=int)
+    placed: list[tuple[int, int, int, int]] = []
+
+    order = list(range(n))
+    rng.shuffle(order)
+    for idx in order:
+        piece = pieces[idx]
+        done = False
