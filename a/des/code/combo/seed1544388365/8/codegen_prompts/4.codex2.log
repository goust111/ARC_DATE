+            right = pieces[r][c + 1]
+            out_col = c * (piece_w - 1)
+            row0 = r * (piece_h - 1)
+            for i, state in enumerate(states):
+                if state in (1, 3):
+                    left[i, -1] = AZURE
+                if state in (2, 3):
