+            if r == 0 and _has_interface(piece.top):
+                return False
+            if r == rows - 1 and _has_interface(piece.bottom):
+                return False
+            if c == 0 and _has_interface(piece.left):
+                return False
+            if c == cols - 1 and _has_interface(piece.right):
+                return False
+            return True
