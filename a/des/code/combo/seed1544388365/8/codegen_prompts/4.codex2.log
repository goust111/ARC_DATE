+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BLACK = 0
+ORANGE = 7
+AZURE = 8
+INTERFACE = {ORANGE, AZURE}
+BASE_COLORS = [1, 2, 3, 4, 5, 6, 9]
+GEN_RETRIES = 400
