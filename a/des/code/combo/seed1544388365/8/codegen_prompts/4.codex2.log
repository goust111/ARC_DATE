+def _ensure_palette_coverage(arr: np.ndarray, palette: list[int], rng: random.Random) -> None:
+    cells = [(r, c) for r in range(arr.shape[0]) for c in range(arr.shape[1])]
+    rng.shuffle(cells)
+    for color, (r, c) in zip(palette, cells):
+        arr[r, c] = color
