+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    pieces = _extract_pieces(g)
+    if not pieces:
+        return g.copy()
+    layout = _search_layout(pieces)
+    return _assemble(layout, pieces)
