+
+            for _neg_add, piece_idx in candidates:
+                add = 0
+                if c > 0:
+                    add += right_scores[order[pos - 1]][piece_idx]
+                if r > 0:
+                    add += down_scores[order[pos - cols]][piece_idx]
+                order[pos] = piece_idx
+                used[piece_idx] = True
+                backtrack(pos + 1, score + add)
+                used[piece_idx] = False
+                order[pos] = -1
