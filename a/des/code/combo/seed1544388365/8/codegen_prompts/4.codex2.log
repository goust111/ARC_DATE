+
+    for r in range(rows):
+        for c in range(cols - 1):
+            states = _sample_boundary_states(piece_h, rng, boundary_idx == double_target)
+            boundaries.append(("v", r, c, states, boundary_idx))
+            boundary_idx += 1
+
+    for r in range(rows - 1):
+        for c in range(cols):
+            states = _sample_boundary_states(piece_w, rng, boundary_idx == double_target)
+            boundaries.append(("h", r, c, states, boundary_idx))
+            boundary_idx += 1
+
+    for kind, r, c, states, _idx in boundaries:
+        if kind == "v":
+            left = pieces[r][c]
+            right = pieces[r][c + 1]
+            out_col = c * (piece_w - 1)
+            row0 = r * (piece_h - 1)
+            for i, state in enumerate(states):
+                if state in (1, 3):
+                    left[i, -1] = AZURE
+                if state in (2, 3):
+                    right[i, 0] = ORANGE
+                if state == 3:
+                    expected[row0 + i, out_col] = ORANGE
+        else:
+            top = pieces[r][c]
+            bottom = pieces[r + 1][c]
+            out_row = r * (piece_h - 1)
+            col0 = c * (piece_w - 1)
+            for i, state in enumerate(states):
+                if state in (1, 3):
+                    top[-1, i] = AZURE
+                if state in (2, 3):
+                    bottom[0, i] = ORANGE
+                if state == 3:
+                    expected[out_row, col0 + i] = ORANGE
