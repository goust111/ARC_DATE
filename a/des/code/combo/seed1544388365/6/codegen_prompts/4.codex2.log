+def _color_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR_TO_DELTA.values():
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
