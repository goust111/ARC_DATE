+def _extract_rings_and_markers(grid: np.ndarray) -> tuple[list[dict], list[tuple[int, int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _background_color(g)
+    rings: list[dict] = []
+    markers: list[tuple[int, int, int]] = []
