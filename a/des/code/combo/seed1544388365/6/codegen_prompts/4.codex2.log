+def _sample_chain() -> tuple[list[tuple[int, int]], list[str]] | None:
+    count = random.randint(*RING_COUNT_RANGE)
+    centers = [(WORK_CANVAS // 2, WORK_CANVAS // 2)]
+    directions: list[str] = []
