+import random
+
+import numpy as np
+
+
+RING_SIZE = 5
+BG = 0
+AZURE = 8
+RED = 2
+RING_COLORS = (1, 3, 4, 5, 6, 7, 9)
+DIRS = ("up", "down", "left", "right")
+DIR_TO_DELTA = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ORTH_TO_DELTA = {
+    "up": (0, 1),
+    "down": (0, 1),
+    "left": (1, 0),
+    "right": (1, 0),
+}
+GAP_POSITIONS = {
+    "up": (0, 2),
+    "down": (4, 2),
+    "left": (2, 0),
+    "right": (2, 4),
+}
+GEN_ATTEMPTS = 400
+WORK_CANVAS = 84
+RING_COUNT_RANGE = (3, 6)
+FORWARD_STEP_RANGE = (8, 14)
+ORTH_JITTER_RANGE = (-3, 3)
