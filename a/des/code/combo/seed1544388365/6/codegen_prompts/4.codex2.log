+    max_c = max(c1 for _r0, _c0, _r1, c1 in bboxes)
+
+    azure_candidates = []
+    for dr in range(MARGIN_RANGE[0], MARGIN_RANGE[1] + 1):
+        for dc in range(MARGIN_RANGE[0], MARGIN_RANGE[1] + 1):
+            pos = (start_bbox[0] - dr, start_bbox[1] - dc)
+            if pos[0] < 0 or pos[1] < 0:
