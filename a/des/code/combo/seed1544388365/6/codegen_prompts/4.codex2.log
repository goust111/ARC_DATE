+            jitter = random.randint(*ORTH_JITTER_RANGE)
+            dr, dc = DIR_TO_DELTA[direction]
+            orr, orc = ORTH_TO_DELTA[direction]
+            prev_r, prev_c = centers[-1]
+            next_center = (
