+    azure = (azure_pos[0] + shift_r, azure_pos[1] + shift_c)
+    red = (red_pos[0] + shift_r, red_pos[1] + shift_c)
+    max_r = max(max_r, azure[0], red[0])
+    max_c = max(max_c, azure[1], red[1])
