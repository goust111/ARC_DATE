import numpy as np

def compress_axis(mask, axis):
    keep=[0]
    if axis==0:
        for i in range(1,mask.shape[0]):
            if not np.array_equal(mask[i], mask[i-1]):
                keep.append(i)
        return mask[keep,:]
    keep=[0]
    for i in range(1,mask.shape[1]):
        if not np.array_equal(mask[:,i], mask[:,i-1]):
            keep.append(i)
    return mask[:,keep]

def reduce_mask(mask):
    arr=mask.astype(np.uint8)
    while True:
        prev=arr.copy()
        arr=compress_axis(arr,0)
        arr=compress_axis(arr,1)
        if arr.shape==prev.shape and np.array_equal(arr,prev):
            return arr

def sig(mask):
    sigs=[]
    for flip in (False, True):
        cur=np.fliplr(mask) if flip else mask
        for k in range(4):
            arr=reduce_mask(np.rot90(cur,k))
            sigs.append((arr.shape, ''.join(map(str, arr.astype(int).ravel().tolist()))))
    return min(sigs)

