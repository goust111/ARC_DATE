+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _strict_contains(
+    outer: tuple[int, int, int, int],
+    inner: tuple[int, int, int, int],
+) -> bool:
+    return (
+        outer[0] < inner[0]
+        and outer[1] < inner[1]
+        and outer[2] > inner[2]
+        and outer[3] > inner[3]
+    )
+
+
+def _shrink_bbox(
+    bbox: tuple[int, int, int, int], delta: int
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return (r0 + delta, c0 + delta, r1 - delta, c1 - delta)
+
+
+def _find_components(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc]:
+                        if int(grid[nr, nc]) == color:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(coords.shape[0]),
+                }
+            )
+
+    return components
+
+
+def _classify_component(component: dict[str, object]) -> str | None:
+    coords = np.asarray(component["coords"], dtype=int)
