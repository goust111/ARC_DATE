+        if (
+            bool(mask[0, :].all())
+            and bool(mask[-1, :].all())
+            and bool(mask[:, 0].all())
+            and bool(mask[:, -1].all())
+            and not bool(mask[1:-1, 1:-1].any())
+        ):
+            return "frame"
+
+    if h == w and h in (1, 2) and area == h * w and bool(mask.all()):
+        return "core"
+
+    return None
