+def _make_object_patch(rng: random.Random, color: int, want_filled: bool) -> np.ndarray | None:
+    for _ in range(PATCH_BUILD_RETRIES):
+        rows = rng.randint(*COARSE_ROW_RANGE)
+        cols = rng.randint(*COARSE_COL_RANGE)
