+        (r_a, c_a), (r_b, c_b) = info["endpoints"]
+        r0, r1 = sorted((r_a, r_b))
+        c0, c1 = sorted((c_a, c_b))
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        perimeter = _rectangle_perimeter(height, width)
+        filled = int(info["length"]) > perimeter
