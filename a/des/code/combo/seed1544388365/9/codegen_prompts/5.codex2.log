+
+def _draw_rectangle(out: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int, filled: bool) -> None:
+    if filled:
+        out[r0 : r1 + 1, c0 : c1 + 1] = color
+        return
+    out[r0, c0 : c1 + 1] = color
+    out[r1, c0 : c1 + 1] = color
+    out[r0 : r1 + 1, c0] = color
+    out[r0 : r1 + 1, c1] = color
