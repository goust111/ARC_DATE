+            [(r, c - 2), (r, c - 1), (r + 1, c - 2), (r + 1, c - 1)],
+        ],
+        "right": [
+            [(r - 1, c + 1), (r - 1, c + 2), (r, c + 1), (r, c + 2)],
+            [(r, c + 1), (r, c + 2), (r + 1, c + 1), (r + 1, c + 2)],
+        ],
