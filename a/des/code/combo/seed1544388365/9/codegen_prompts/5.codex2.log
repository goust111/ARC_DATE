+def _snake_vertices(rows: int, cols: int) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
+    for r in range(rows):
+        if r % 2 == 0:
+            iterable = range(cols)
+        else:
+            iterable = range(cols - 1, -1, -1)
+        for c in iterable:
+            order.append((r, c))
+    return order
+
