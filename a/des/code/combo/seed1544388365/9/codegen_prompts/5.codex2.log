+    path: list[tuple[int, int]] = []
+    pr, pc = _coarse_to_local(*segment[0])
+    path.append((pr, pc))
+    for vr, vc in segment[1:]:
+        nr, nc = _coarse_to_local(vr, vc)
+        path.append(((pr + nr) // 2, (pc + nc) // 2))
+        path.append((nr, nc))
+        pr, pc = nr, nc
+    return path
