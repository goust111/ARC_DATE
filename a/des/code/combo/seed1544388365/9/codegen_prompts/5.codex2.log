+        (-1, 0): "up",
+        (1, 0): "down",
+        (0, -1): "left",
+        (0, 1): "right",
+    }[(dr, dc)]
+    shapes = {
+        "up": [
+            [(r - 2, c - 1), (r - 2, c), (r - 1, c - 1), (r - 1, c)],
+            [(r - 2, c), (r - 2, c + 1), (r - 1, c), (r - 1, c + 1)],
+        ],
+        "down": [
+            [(r + 1, c - 1), (r + 1, c), (r + 2, c - 1), (r + 2, c)],
+            [(r + 1, c), (r + 1, c + 1), (r + 2, c), (r + 2, c + 1)],
