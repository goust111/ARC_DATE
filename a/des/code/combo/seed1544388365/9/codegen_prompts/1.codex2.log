+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    separated = ar1 + 1 < br0 or br1 + 1 < ar0 or ac1 + 1 < bc0 or bc1 + 1 < ac0
+    return not separated
+
