+
+    inp = _render_grid(rows, cols, tile)
+    expected = _expected_output(rows, cols, tile)
+    if np.array_equal(inp, expected):
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    return inp if np.array_equal(actual, expected) else None
+
+
+def generate_input() -> np.ndarray:
