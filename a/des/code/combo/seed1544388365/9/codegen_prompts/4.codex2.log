        for dr, dc in DIRS4:
            nr = cell[0] + dr
            nc = cell[1] + dc
            if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
                frontier.add((nr, nc))

    return mask if len(cells) == area else None


def _sample_pattern(tile_size: int, fg_color: int) -> np.ndarray | None:
    for _ in range(PATCH_ATTEMPTS):
