            out[r0 : r0 + tile_size, c0 : c0 + tile_size] = np.rot90(tile, -((tile_r + tile_c) % 4))
    return out


def _sample_grid_shape(tile_size: int) -> tuple[int, int]:
    max_tiles = min(5, (GRID_SIDE_LIMIT + 1) // (tile_size + 1))
    assert max_tiles >= 3
    choices = [
        (rows, cols)
        for rows in range(2, max_tiles + 1)
