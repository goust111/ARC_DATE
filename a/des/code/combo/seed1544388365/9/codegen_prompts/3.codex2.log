 132:     lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN
 133:     hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN
 134:     masks: list[np.ndarray] = []
 135:     for bits in range(1 << n):
 136:         count = int(bits.bit_count())
 137:         if count < lo or count > hi:
 138:             continue
 139:         flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)
 140:         mask = flat.reshape(th, tw)
 141:         if _gen_has_full_bbox(mask):
 142:             masks.append(mask)
 143:     return masks
