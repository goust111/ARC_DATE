+        colors = rng.sample(list(INPUT_COLORS), num_colors)
+        if want_overlap and len(set(colors) & set(MIXABLE_COLORS)) < 2:
+            continue
+        counts = {color: rng.choices([1, 2, 3], weights=[4, 4, 3])[0] for color in colors}
+        total = sum(counts.values())
