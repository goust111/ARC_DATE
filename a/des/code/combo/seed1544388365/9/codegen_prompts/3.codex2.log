+    "left": {"missing": (1, 0), "delta": (0, -1)},
+    "right": {"missing": (1, 2), "delta": (0, 1)},
+}
+DIR_NAMES = tuple(DIR_SPECS)
+REL_CELLS = {
+    name: tuple((r, c) for r in range(3) for c in range(3) if (r, c) != spec["missing"])
