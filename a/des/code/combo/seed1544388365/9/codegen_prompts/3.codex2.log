+
+def _bbox(top: int, left: int) -> tuple[int, int, int, int]:
+    return int(top), int(left), int(top + 2), int(left + 2)
+
+
+def _in_bounds(top: int, left: int, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return 0 <= int(top) <= h - 3 and 0 <= int(left) <= w - 3
