+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+AZURE = 8
+
+INPUT_COLORS = (BLUE, RED, GREEN, YELLOW)
+MIXABLE_COLORS = (BLUE, RED, GREEN)
