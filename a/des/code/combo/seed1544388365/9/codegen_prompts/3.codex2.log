+            continue
+        if not _rect_gap_ok(p2["input_bbox"], [p1["input_bbox"]], gap=1):
+            continue
+        overlap = p1["final_cells"] & p2["final_cells"]
+        if not (1 <= len(overlap) <= 4):
+            continue
+        if not (p1["final_cells"] - overlap and p2["final_cells"] - overlap):
+            continue
+        return [p1, p2]
+    return None
+
+
+def _place_single(
+    rng: random.Random,
+    shape: tuple[int, int],
