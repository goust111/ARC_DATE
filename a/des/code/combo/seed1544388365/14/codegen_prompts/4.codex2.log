+                "h": int(target_h),
+                "w": int(target_w),
+                "gap_side": side,
+                "gap_offset": _scale_gap_offset(int(frame["gap_offset"]), old_span, new_span),
+            }
+        )
+    return solved
+
+
+def _gen_attempt() -> np.ndarray | None:
