+
+    old_index = offset - 1
+    numerator = old_index * (new_slots - 1)
+    denominator = old_slots - 1
+    mapped = (2 * numerator + denominator) // (2 * denominator)
+    return 1 + int(min(max(mapped, 0), new_slots - 1))
