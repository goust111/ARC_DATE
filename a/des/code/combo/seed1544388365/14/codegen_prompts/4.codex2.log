+
+TOP = "top"
+BOTTOM = "bottom"
+LEFT = "left"
+RIGHT = "right"
+SIDES = (TOP, BOTTOM, LEFT, RIGHT)
+
+OPPOSITE = {
+    TOP: BOTTOM,
+    BOTTOM: TOP,
+    LEFT: RIGHT,
+    RIGHT: LEFT,
+}
+
+CORNER_ALLOWED = {
+    "tl": {TOP, LEFT},
+    "tr": {TOP, RIGHT},
+    "bl": {BOTTOM, LEFT},
+    "br": {BOTTOM, RIGHT},
+}
+
+BG_COLOR = 0
+MARKER_COLOR = 3
+FRAME_COLOR_POOL = [1, 2, 4, 5, 6, 7, 8, 9]
+FRAME_COUNT_RANGE = (3, 5)
+INNER_SIZE_RANGE = (3, 7)
+EXTRA_SIZE_CHOICES = [0, 0, 1, 2]
+PLACEMENT_PADDING = 1
+PLACEMENT_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 400
+
