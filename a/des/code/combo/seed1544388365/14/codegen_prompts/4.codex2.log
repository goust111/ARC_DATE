+
+def _corner_origins(height: int, width: int) -> dict[str, tuple[int, int]]:
+    return {
+        "tl": (0, 0),
+        "tr": (0, width - 2),
+        "bl": (height - 2, 0),
+        "br": (height - 2, width - 2),
+    }
+
