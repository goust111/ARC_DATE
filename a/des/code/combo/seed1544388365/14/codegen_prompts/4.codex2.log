+    TOP: BOTTOM,
+    BOTTOM: TOP,
+    LEFT: RIGHT,
+    RIGHT: LEFT,
+}
+
+CORNER_ALLOWED = {
+    "tl": {TOP, LEFT},
+    "tr": {TOP, RIGHT},
+    "bl": {BOTTOM, LEFT},
+    "br": {BOTTOM, RIGHT},
