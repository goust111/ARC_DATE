+def _turn_indicator(v_in: tuple[int, int], v_out: tuple[int, int]) -> int:
+    dot = int(v_in[0] * v_out[0] + v_in[1] * v_out[1])
+    cross = int(v_in[0] * v_out[1] - v_in[1] * v_out[0])
