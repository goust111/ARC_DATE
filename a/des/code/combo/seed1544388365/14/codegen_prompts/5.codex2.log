+
+def _build_legend(
+    grid: np.ndarray,
+    legend_colors: list[int],
+    legend_dirs: dict[int, tuple[tuple[int, int], ...]],
+    rng: random.Random,
+) -> None:
+    content_w = 3 * len(legend_colors) + max(0, len(legend_colors) - 1)
+    start = rng.randint(0, grid.shape[1] - content_w)
+    for i, color in enumerate(legend_colors):
