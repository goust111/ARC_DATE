+GEN_COLORS = (1, 2, 3, 4, 6, 7, 8)
+INTERIOR_SHAPES = ((2, 2), (2, 3), (3, 2), (2, 4), (4, 2), (3, 3))
+DIRECTION_COUNTS = (1, 2, 2, 3, 3, 4, 4, 5)
+GEN_RETRIES = 400
