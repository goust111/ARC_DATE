+        nxt: set[tuple[int, int]] = set()
+        for r, c in frontier:
+            for dr, dc in directions:
+                rr, cc = r + dr, c + dc
+                while 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == MAROON:
