+        ]
+        assert len(seed_pts) == 1, "each frame must contain exactly one seed pixel"
+        sr, sc = seed_pts[0]
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "seed": (sr, sc),
