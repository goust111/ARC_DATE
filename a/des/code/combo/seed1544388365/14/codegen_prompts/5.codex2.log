+
+        seed_pts = [
+            (r, c)
+            for r in range(r0 + 1, r1)
+            for c in range(c0 + 1, c1)
+            if int(g[r, c]) not in (BLACK, MAROON)
+        ]
+        assert len(seed_pts) == 1, "each frame must contain exactly one seed pixel"
+        sr, sc = seed_pts[0]
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "seed": (sr, sc),
+                "color": int(g[sr, sc]),
+                "ih": r1 - r0 - 1,
+                "iw": c1 - c0 - 1,
