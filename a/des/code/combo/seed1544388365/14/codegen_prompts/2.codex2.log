+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
