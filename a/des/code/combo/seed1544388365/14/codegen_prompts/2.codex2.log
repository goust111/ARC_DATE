+
+            _mark_bbox(target_reserved, bbox, pad=1)
+            plans.append(
+                {
+                    "color": color,
+                    "rect_h": rect_h,
+                    "rect_w": rect_w,
+                    "cut_h": cut_h,
+                    "cut_w": cut_w,
