+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+_PRIORITY_ORDER = (RED, BLUE, YELLOW, ORANGE, MAGENTA, AZURE)
