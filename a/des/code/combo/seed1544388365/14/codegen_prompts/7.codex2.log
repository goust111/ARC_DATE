+
+def _can_place_shape(
+    grid: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+    top: int,
+    left: int,
+    gap: int = 1,
+) -> bool:
+    h, w = grid.shape
+    coords = {(top + dr, left + dc) for dr, dc in shape}
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(grid[r, c]) != BLACK:
