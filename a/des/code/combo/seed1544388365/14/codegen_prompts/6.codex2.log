+
+BG = 0
+DIVIDER = 5
+OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PAD8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 0),
+    (0, 1),
+    (1, -1),
+    (1, 0),
+    (1, 1),
+)
+
+LR_ONLY = "lr_only"   # symmetric under left-right reflection only
+TB_ONLY = "tb_only"   # symmetric under top-bottom reflection only
+BOTH = "both"
+NONE = "none"
+
+GEN_RETRIES = 300
+SHAPE_RETRIES = 120
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.asarray(coords, dtype=int))
+    return parts
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    r0, r1 = int(rows.min()), int(rows.max())
+    c0, c1 = int(cols.min()), int(cols.max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    h, w = mask.shape
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _classify_mask(mask: np.ndarray) -> str:
+    left_right = np.array_equal(mask, np.fliplr(mask))
+    top_bottom = np.array_equal(mask, np.flipud(mask))
+    if left_right and top_bottom:
+        return BOTH
+    if left_right:
+        return LR_ONLY
+    if top_bottom:
+        return TB_ONLY
+    return NONE
+
+
+def _extract_objects(tl: np.ndarray, bg: int) -> list[dict[str, object]]:
+    objects: list[dict[str, object]] = []
+    for coords in _components(tl != bg):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        r0, r1 = int(rows.min()), int(rows.max())
+        c0, c1 = int(cols.min()), int(cols.max())
+        colors = {int(tl[r, c]) for r, c in coords.tolist()}
+        assert len(colors) == 1, "each object must be monochromatic"
+        color = colors.pop()
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        mask[rows - r0, cols - c0] = True
+        objects.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "color": color,
+                "mask": mask,
+                "category": _classify_mask(mask),
+            }
+        )
+    return objects
