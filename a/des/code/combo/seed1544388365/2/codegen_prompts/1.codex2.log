+        inner_w = rng.randint(*INNER_W_RANGE)
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+        side = rng.choice(SIDES)
+        gap_offset = rng.randint(1, (outer_w - 2) if side in ("top", "bottom") else (outer_h - 2))
