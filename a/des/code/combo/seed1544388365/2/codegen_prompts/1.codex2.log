+def _margin_to_edge(r0: int, c0: int, outer_h: int, outer_w: int, side: str, h: int, w: int) -> int:
+    r1 = r0 + outer_h - 1
+    c1 = c0 + outer_w - 1
+    if side == "top":
+        return r0
+    if side == "bottom":
+        return h - 1 - r1
+    if side == "left":
+        return c0
+    return w - 1 - c1
