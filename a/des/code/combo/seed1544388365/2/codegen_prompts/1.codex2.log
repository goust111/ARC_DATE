+def _ray_cells(rect: RectInfo, h: int, w: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for step in range(1, rect.area + 1):
+        rr = rect.gap_r + rect.dr * step
+        cc = rect.gap_c + rect.dc * step
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        cells.append((rr, cc))
+    return cells
+
