+def _paint_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    mask = patch != 0
+    sub = grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+    sub[mask] = patch[mask]
+    grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = sub
+
