+        elif orientation == "tr":
+            mask[0, :] = True
+            mask[:, -1] = True
+        elif orientation == "bl":
+            mask[-1, :] = True
+            mask[:, 0] = True
+        else:
+            mask[-1, :] = True
+            mask[:, -1] = True
+        return mask
+
+    if mode == "tee" and max_h >= 3 and max_w >= 3:
+        h = random.randint(3, min(5, max_h))
+        w = random.randint(3, min(5, max_w))
+        mask = np.zeros((h, w), dtype=bool)
+        orientation = random.choice(CORNERS)
+        if orientation == "tl":
