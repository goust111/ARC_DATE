+    qr0, qr1, qc0, qc1 = quad_bounds
+    qh = qr1 - qr0
+    qw = qc1 - qc0
+    max_outer_h = min(FRAME_OUTER_MAX, qh - 2)
+    max_outer_w = min(FRAME_OUTER_MAX, qw - 2)
+    if max_outer_h < FRAME_OUTER_MIN or max_outer_w < FRAME_OUTER_MIN:
