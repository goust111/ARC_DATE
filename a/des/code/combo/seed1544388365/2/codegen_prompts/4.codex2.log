+    grid[abs_r1, abs_c0 : abs_c1 + 1] = AZURE
+    grid[abs_r0 : abs_r1 + 1, abs_c0] = AZURE
+    grid[abs_r0 : abs_r1 + 1, abs_c1] = AZURE
+
+    corner = random.choice(CORNERS)
