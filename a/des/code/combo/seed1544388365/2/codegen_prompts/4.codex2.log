+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+PALETTE = tuple(color for color in range(10) if color not in {BLACK, GREY, AZURE})
+CORNERS = ("tl", "tr", "bl", "br")
+GEN_RETRIES = 300
+QUADRANT_SIZE_RANGE = (8, 14)
