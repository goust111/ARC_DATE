+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in points]
+    cols = [c for _r, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_separator(grid: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    candidates: list[int] = []
+    for c in range(w):
+        col = grid[:, c]
+        if int(col[0]) == int(bg):
+            continue
