+BG = 0
+DIVIDER = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+CORNERS = ["tl", "tr", "br", "bl"]
+CORNER_TO_K = {"tl": 0, "tr": 3, "br": 2, "bl": 1}
+MAX_GENERATION_ATTEMPTS = 500
