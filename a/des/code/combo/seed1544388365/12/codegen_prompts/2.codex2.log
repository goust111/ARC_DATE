+def _mask_el(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    v_thick = 1 if w <= 6 else random.choice((1, 2))
+    h_thick = 1 if h <= 6 else random.choice((1, 2))
+    mask[:, :v_thick] = True
