+    if min_area > max_area:
+        return None
+
+    builders = {
+        "cross": _mask_cross,
+        "el": _mask_el,
+        "frame": _mask_frame,
+        "fork": _mask_fork,
+        "polyline": _mask_polyline,
+    }
