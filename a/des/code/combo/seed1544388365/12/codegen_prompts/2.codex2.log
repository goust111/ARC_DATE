+def _make_mask(h: int, w: int, n_tiles: int) -> np.ndarray | None:
+    min_area = max(2 * n_tiles, int(np.ceil(MIN_DENSITY * h * w)))
+    max_area = int(np.floor(MAX_DENSITY * h * w))
