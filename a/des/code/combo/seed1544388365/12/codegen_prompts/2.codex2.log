+        if len(set(map(int, coords[:, 0]))) < 3 or len(set(map(int, coords[:, 1]))) < 3:
+            continue
+        if np.all(mask):
+            continue
+        return mask
+    return None
+
+
+def _balanced_sizes(total: int, parts: int) -> list[int]:
+    base = total // parts
+    sizes = [base] * parts
+    for idx in random.sample(range(parts), total % parts):
+        sizes[idx] += 1
+    assert min(sizes) >= 1
+    return sizes
+
