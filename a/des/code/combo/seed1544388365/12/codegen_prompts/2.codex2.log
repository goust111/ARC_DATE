+
+    groups = _partition_coords(mask, n_tiles)
+    if any(len(group) == 0 for group in groups):
+        return None
+
+    expected = np.full((tile_h, tile_w), BG, dtype=int)
+    patches: list[np.ndarray] = []
+    for color, group in zip(colors, groups):
