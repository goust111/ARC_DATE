SEPARATOR_WIDTH_RANGE = range(1, 4)
PADDING_MIN = 2
PADDING_MAX_EXCLUSIVE = 6
INPUT_SIDE_MIN = 19
INPUT_SIDE_MAX = 28

# Hidden foreground shape density and pattern mix.
