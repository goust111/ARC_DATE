+def _find_legend(grid: np.ndarray) -> list[int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    candidates: list[list[int]] = []
+
+    for coords in _components(g != 0):
+        r0, c0, r1, c1 = _bbox(coords)
+        if r0 != r1:
+            continue
+        width = c1 - c0 + 1
+        if width < 3 or int(coords.shape[0]) != width:
+            continue
+        if r0 not in (0, h - 1):
+            continue
+        if c0 != 0 and c1 != w - 1:
