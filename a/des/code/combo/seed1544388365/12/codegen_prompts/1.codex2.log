+def _find_legend(grid: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    color_mask = (grid != bg) & (grid != GREY)
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for coords in _components(color_mask):
