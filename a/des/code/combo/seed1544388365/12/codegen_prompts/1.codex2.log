+    cc0 = max(0, c0 - pad)
+    rr1 = min(mask.shape[0] - 1, r1 + pad)
+    cc1 = min(mask.shape[1] - 1, c1 + pad)
+    return not bool(mask[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
