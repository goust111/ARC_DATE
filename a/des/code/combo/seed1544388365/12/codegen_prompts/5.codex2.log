+
+def _is_connected(coords: set[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    start = next(iter(coords))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in NEIGHBORS4:
+            nxt = (r + dr, c + dc)
+            if nxt in coords and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return seen == coords
