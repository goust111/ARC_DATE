+GEN_COLORS: tuple[int, ...] = (1, 2, 3, 5, 6, 7, 8, 9)
+GEN_GRID_MIN = 14
+GEN_GRID_MAX = 28
+GEN_PAIR_COUNT_OPTIONS = (1, 2)
+GEN_DISTRACTOR_COUNT_OPTIONS = (0, 1, 2)
