+        assert len(candidates) == 1, f"expected a unique alignment for color {color}"
+        hidden = candidates[0]["hidden"]
+
+        for r, c in reference["coords"]:  # type: ignore[misc]
+            out[r, c] = BG_COLOR
+        for r, c in hidden:  # type: ignore[misc]
+            out[r, c] = YELLOW
