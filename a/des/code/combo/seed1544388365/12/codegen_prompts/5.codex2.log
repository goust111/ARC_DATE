    if side in ("top", "bottom"):
        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)
        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == "top" else range(0, GEN_SPLIT_INDEX)
