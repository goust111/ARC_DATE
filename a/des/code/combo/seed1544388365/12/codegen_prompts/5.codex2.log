+) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    diffs = {
+        (vr - rr, vc - rc)
+        for vr, vc in visible_coords
+        for rr, rc in reference_coords
