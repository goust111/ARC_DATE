+def _place_patch(
+    inp: np.ndarray,
+    out: np.ndarray,
+    patch_in: np.ndarray,
+    patch_out: np.ndarray,
+    reserved: list[tuple[int, int, int, int]],
+) -> bool:
+    h, w = inp.shape
+    ph, pw = patch_in.shape
+    positions = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+    random.shuffle(positions)
+
+    for top, left in positions:
