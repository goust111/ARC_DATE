        for r, c in cells:
            grid[r, c] = color
        chosen = set(cells)
        available = [
            (r, c)
            for r, c in available
            if (r, c) not in chosen
            and all(max(abs(r - pr), abs(c - pc)) > _GEN_NOISE_CLEARANCE for pr, pc in chosen)
        ]
