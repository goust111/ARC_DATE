+def _extract_objects(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    objects: list[dict[str, object]] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != BG):
