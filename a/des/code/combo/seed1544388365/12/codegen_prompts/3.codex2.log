+    cells = {start}
+    for _ in range(area - 1):
+        frontier = set()
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
