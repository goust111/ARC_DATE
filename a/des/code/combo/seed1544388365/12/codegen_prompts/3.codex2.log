+        sh, sw = sprite.shape
+        placed = False
+        for _ in range(MAX_PLACEMENT_ATTEMPTS):
+            r0 = rng.randint(1, height - sh - 1)
+            c0 = rng.randint(1, width - sw - 1)
+            rr0 = r0 - 1
+            cc0 = c0 - 1
+            rr1 = r0 + sh + 1
+            cc1 = c0 + sw + 1
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+            mask = sprite != BG
+            grid[r0 : r0 + sh, c0 : c0 + sw][mask] = sprite[mask]
+            occupied[rr0:rr1, cc0:cc1] = True
+            rec["bbox"] = (r0, c0, r0 + sh - 1, c0 + sw - 1)
+            placed = True
+            break
+        if not placed:
