+    sprite[mask] = color
+    return sprite
+
+
+def _place_objects(records: list[dict[str, object]], rng: random.Random) -> np.ndarray | None:
+    max_h = max(int(rec["sprite"].shape[0]) for rec in records)
+    max_w = max(int(rec["sprite"].shape[1]) for rec in records)
+    total_w = sum(int(rec["sprite"].shape[1]) + 2 for rec in records) + 2
+    total_h = sum(int(rec["sprite"].shape[0]) + 2 for rec in records) // 2 + max_h + 4
+
+    height = rng.randint(max(16, max_h + 4, total_h), max(24, max_h + 10, total_h + 6))
+    width = rng.randint(max(16, max_w + 4, total_w), max(28, max_w + 12, total_w + 8))
