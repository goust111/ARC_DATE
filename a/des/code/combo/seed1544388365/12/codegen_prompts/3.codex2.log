+            r0, c0, r1, c1 = _bbox(pts)
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+            mask = np.zeros_like(sprite, dtype=bool)
+            for r, c in pts:
+                sprite[r - r0, c - c0] = color
+                mask[r - r0, c - c0] = True
+            objects.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "sprite": sprite,
+                    "area": int(mask.sum()),
+                    "holes": _count_holes(mask),
