+    color_idx = 0
+    records: list[dict[str, object]] = []
+    for holes in (0, 1, 2):
+        for _ in range(counts[holes]):
+            mask = _random_mask(holes, rng)
+            color = colors[color_idx]
+            color_idx += 1
+            sprite = _mask_to_sprite(mask, color)
+            records.append(
+                {
+                    "color": color,
+                    "holes": holes,
+                    "area": int(mask.sum()),
+                    "sprite": sprite,
+                    "bbox": (0, 0, sprite.shape[0] - 1, sprite.shape[1] - 1),
+                }
+            )
+    return records
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    records = _make_records(rng)
+    grid = _place_objects(records, rng)
+    if grid is None:
+        return None
+
+    expected = _pack_objects(records)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

