+def _make_records(rng: random.Random) -> list[dict[str, object]]:
+    counts = {0: rng.randint(1, 2), 1: rng.randint(1, 2), 2: rng.randint(1, 2)}
+    if all(count == 1 for count in counts.values()):
+        counts[rng.choice((0, 1, 2))] = 2
