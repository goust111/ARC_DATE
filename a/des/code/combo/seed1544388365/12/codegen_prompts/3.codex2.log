+        return None
+    if not _is_connected(mask):
+        return None
+    if _count_holes(mask) != target_holes:
+        return None
+    return mask
+
+
+def _random_mask(target_holes: int, rng: random.Random) -> np.ndarray:
+    builders = []
+    if target_holes == 0:
+        builders = (
+            _random_polyomino_zero,
+            _open_frame_zero,
