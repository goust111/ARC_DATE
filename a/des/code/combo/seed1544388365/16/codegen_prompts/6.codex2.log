    obj_colors = [int(v) for v in vals if int(v) != bg]
    assert len(obj_colors) == 1, "expected one interior foreground object color"
    return bg, obj_colors[0]


def _direction_for_notch(g: np.ndarray, r: int, c: int, obj: int) -> list[str]:
    dirs = []
