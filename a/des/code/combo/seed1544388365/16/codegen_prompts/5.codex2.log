+def _is_connected_mask(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
