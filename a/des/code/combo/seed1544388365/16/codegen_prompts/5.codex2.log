+    ph, pw = piece.shape
+    exact: list[tuple[int, int]] = []
+    subset: list[tuple[int, int]] = []
+    for r in range(th - ph + 1):
+        for c in range(tw - pw + 1):
+            patch = template[r : r + ph, c : c + pw]
+            if np.all(~piece | patch):
