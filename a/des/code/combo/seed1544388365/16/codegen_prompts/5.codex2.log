+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            mask, bbox = _component_mask_from_coords(arr)
+            out.append({"color": color, "coords": arr, "mask": mask, "bbox": bbox, "area": int(mask.sum())})
