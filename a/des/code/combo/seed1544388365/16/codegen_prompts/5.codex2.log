+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color not in allowed:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
