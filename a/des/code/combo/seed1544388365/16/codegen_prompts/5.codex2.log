+        mask = _crop_mask(mask)
+        area = int(mask.sum())
+        if mask.shape[0] < 8 or mask.shape[1] < 8:
+            continue
+        if area < max(30, int(0.55 * mask.size)):
+            continue
+        if np.all(mask):
+            continue
+        if int((~mask).sum()) < 8:
+            continue
+        return mask
+    return None
