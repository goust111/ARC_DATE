+def _is_connected_mask(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
