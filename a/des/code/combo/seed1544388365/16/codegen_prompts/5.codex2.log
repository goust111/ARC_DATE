+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    mins = coords.min(axis=0)
+    maxs = coords.max(axis=0)
+    return int(mins[0]), int(mins[1]), int(maxs[0]), int(maxs[1])
