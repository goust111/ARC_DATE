+def _legend_mapping(grid: np.ndarray, bg: int, grey: int) -> dict[int, int]:
+    coords = _legend_coords(grid, bg, grey)
+    return {idx + 1: int(grid[r, c]) for idx, (r, c) in enumerate(coords)}
