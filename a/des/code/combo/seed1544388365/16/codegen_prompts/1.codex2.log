+            mask = np.zeros((canvas_h, canvas_w), dtype=bool)
+            center = canvas_w // 2
+            top = 1
+            prev_left = prev_w = prev_bottom = None
+            ok = True
+            for idx, (height, width) in enumerate(rings):
