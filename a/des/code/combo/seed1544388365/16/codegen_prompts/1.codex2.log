+def _can_place(blocked: np.ndarray, top: int, left: int, shape: np.ndarray) -> bool:
+    h, w = blocked.shape
+    sh, sw = shape.shape
+    rr0 = max(0, top - 1)
+    rr1 = min(h, top + sh + 1)
+    cc0 = max(0, left - 1)
+    cc1 = min(w, left + sw + 1)
+    return not bool(blocked[rr0:rr1, cc0:cc1].any())
