+def _exterior_empty(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not mask[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                stack.append((nr, nc))
+    return exterior
+
+
+def _one_neighbor_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    exterior = _exterior_empty(mask)
+    h, w = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
