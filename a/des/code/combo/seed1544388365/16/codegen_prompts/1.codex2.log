+                left += width
+                if idx < len(gaps):
+                    left += gaps[idx]
+        else:
+            canvas_h = sum(h for h, _w in rings) + sum(gaps) + 2
+            canvas_w = max(w for _h, w in rings) + 4
+            mask = np.zeros((canvas_h, canvas_w), dtype=bool)
+            center = canvas_w // 2
