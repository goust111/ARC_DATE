+                        break
+                    bridge_row = random.randint(row_lo, row_hi)
+                    mask[bridge_row, prev_right : left + 1] = True
+                prev_top, prev_h, prev_right = top, height, left + width - 1
+                left += width
+                if idx < len(gaps):
