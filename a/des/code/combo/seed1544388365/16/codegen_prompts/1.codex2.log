+            prev_left = prev_w = prev_bottom = None
+            ok = True
+            for idx, (height, width) in enumerate(rings):
+                left_lo = max(1, center - (width - 2))
+                left_hi = min(canvas_w - width - 1, center - 1)
+                if left_lo > left_hi:
