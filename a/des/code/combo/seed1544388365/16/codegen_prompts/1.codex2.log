+        counts = [random.randint(1, max_holes) for _ in range(n_objects)]
+        if len(set(counts)) == 1 and n_objects >= 2 and max_holes >= 2:
+            counts[0] = random.randint(1, max_holes)
+            counts[1] = random.randint(1, max_holes)
