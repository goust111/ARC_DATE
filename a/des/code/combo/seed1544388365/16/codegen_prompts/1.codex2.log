+                exterior[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not mask[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                stack.append((nr, nc))
