+
+def _place_legend(grid: np.ndarray, side: str, colors: list[int]) -> None:
+    h, w = grid.shape
+    n = len(colors)
+    if side == "top":
+        start = random.randint(1, w - n - 1)
+        for i, color in enumerate(colors):
+            grid[0, start + i] = int(color)
+    elif side == "bottom":
+        start = random.randint(1, w - n - 1)
+        for i, color in enumerate(colors):
