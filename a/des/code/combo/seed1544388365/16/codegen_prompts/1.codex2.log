+    elif side == "bottom":
+        start = random.randint(1, w - n - 1)
+        for i, color in enumerate(colors):
+            grid[h - 1, start + i] = int(color)
+    elif side == "left":
+        start = random.randint(1, h - n - 1)
+        for i, color in enumerate(colors):
+            grid[start + i, 0] = int(color)
+    else:
+        start = random.randint(1, h - n - 1)
+        for i, color in enumerate(colors):
+            grid[start + i, w - 1] = int(color)
