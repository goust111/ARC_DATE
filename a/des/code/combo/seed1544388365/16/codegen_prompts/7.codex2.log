+                if not _bbox_ok(r0, c0, shape, bbox_blocked, ray_blocked):
+                    continue
+                gap = (r0 + gap_rel[0], c0 + gap_rel[1])
+                path = _ray_prefix_to_target(gap, direction, source["pos"], shape)
+                if path is None or not _path_clear(path, occupied, ray_blocked):
+                    continue
+                candidates.append(
+                    {
+                        "r0": r0,
