+GAP_RELS_BY_DIR = {
+    "up": ((0, 1), (0, 2)),
+    "down": ((3, 1), (3, 2)),
+    "left": ((1, 0), (2, 0)),
+    "right": ((1, 3), (2, 3)),
+}
+GAP_DIR_BY_REL = {rel: direction for direction, rels in GAP_RELS_BY_DIR.items() for rel in rels}
+STEP_BY_DIR = {"up": (-1, 0), "down": (1, 0), "left": (0, -1), "right": (0, 1)}
