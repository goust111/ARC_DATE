+                        "target_kind": "source",
+                        "target_ref": source_idx,
+                        "target_pos": source["pos"],
+                    }
+                )
+
+    return candidates
+
+
+def _frame_candidates(
+    shape: tuple[int, int],
+    target_idx: int,
+    target_frame: dict,
+    bbox_blocked: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    ray_blocked: set[tuple[int, int]],
+) -> list[dict]:
+    h, w = shape
+    candidates: list[dict] = []
