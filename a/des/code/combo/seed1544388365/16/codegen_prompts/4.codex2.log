+        rooms = [{"color": None} for _ in range(nrows * ncols)]
+        rooms[a]["color"] = 2
+        rooms[b]["color"] = 3
+        labels = _final_room_colors(rooms, graph)
+        if GREY in [labels[idx] for idx, room in enumerate(rooms) if room["color"] is None]:
+            return [a, b]
