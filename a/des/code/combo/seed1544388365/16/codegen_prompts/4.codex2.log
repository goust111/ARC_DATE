+def _grow_component(
+    rng: np.random.Generator,
+    seed: int,
+    target_size: int,
+    available: set[int],
+    neighbors: list[list[int]],
+):
+    comp = {seed}
+    door_pairs: set[tuple[int, int]] = set()
