+def _bfs_distances(graph: list[set[int]], start: int) -> list[int]:
+    dist = [-1] * len(graph)
+    dist[start] = 0
+    q = deque([start])
+    while q:
+        cur = q.popleft()
+        for nxt in graph[cur]:
