+        if grown is None:
+            return None
+        comp, comp_pairs = grown
+        chosen_components.append(list(comp))
+        door_pairs |= comp_pairs
+        available -= comp
+
+    for comp in chosen_components:
+        comp_set = set(comp)
+        for a in comp:
