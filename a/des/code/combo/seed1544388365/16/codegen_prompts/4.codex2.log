+    comps = []
+    for start in range(len(graph)):
+        if start in seen:
+            continue
+        q = deque([start])
+        seen.add(start)
+        comp = []
+        while q:
+            cur = q.popleft()
+            comp.append(cur)
+            for nxt in graph[cur]:
+                if nxt in seen:
+                    continue
+                seen.add(nxt)
+                q.append(nxt)
