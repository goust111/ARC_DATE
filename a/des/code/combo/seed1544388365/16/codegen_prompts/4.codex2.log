+    graph = [set() for _ in rooms]
+    n_row_bands = len(row_bounds) - 1
+    n_col_bands = len(col_bounds) - 1
+
+    for ri in range(n_row_bands):
+        r0 = row_bounds[ri] + 1
+        r1 = row_bounds[ri + 1] - 1
