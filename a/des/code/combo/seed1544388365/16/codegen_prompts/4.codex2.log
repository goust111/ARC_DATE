+def _find_separators(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    h, w = grid.shape
+    sep_rows = [
+        r
+        for r in range(h)
+        if int(np.count_nonzero(grid[r] == BLUE)) > w // 2
+        and bool(np.isin(grid[r], [BLACK, BLUE]).all())
+    ]
+    sep_cols = [
+        c
+        for c in range(w)
+        if int(np.count_nonzero(grid[:, c] == BLUE)) > h // 2
