+
+def _conflict_mode_doors(
+    rng: np.random.Generator,
+    nrows: int,
+    ncols: int,
+    specs: list[dict],
+):
+    door_pairs = {tuple(sorted((int(spec["a"]), int(spec["b"])))) for spec in specs}
