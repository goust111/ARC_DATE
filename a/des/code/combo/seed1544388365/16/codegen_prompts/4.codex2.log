+
+def _edge_specs(
+    heights: list[int],
+    widths: list[int],
+    row_starts: list[int],
+    col_starts: list[int],
+    sep_rows: list[int],
+    sep_cols: list[int],
+):
+    nrows = len(heights)
+    ncols = len(widths)
+    specs = []
+    pair_to_spec = {}
+    neighbors = [[] for _ in range(nrows * ncols)]
+
+    for ri in range(nrows):
+        for ci in range(ncols - 1):
+            a = ri * ncols + ci
+            b = a + 1
+            spec = {
+                "a": a,
+                "b": b,
+                "kind": "v",
+                "sep": sep_cols[ci],
+                "r0": row_starts[ri],
+                "r1": row_starts[ri] + heights[ri] - 1,
+            }
+            specs.append(spec)
+            key = (a, b)
+            pair_to_spec[key] = spec
+            neighbors[a].append(b)
+            neighbors[b].append(a)
+
+    for ri in range(nrows - 1):
+        for ci in range(ncols):
+            a = ri * ncols + ci
+            b = (ri + 1) * ncols + ci
+            spec = {
+                "a": a,
+                "b": b,
+                "kind": "h",
+                "sep": sep_rows[ri],
+                "c0": col_starts[ci],
+                "c1": col_starts[ci] + widths[ci] - 1,
+            }
+            specs.append(spec)
+            key = (a, b)
+            pair_to_spec[key] = spec
+            neighbors[a].append(b)
+            neighbors[b].append(a)
