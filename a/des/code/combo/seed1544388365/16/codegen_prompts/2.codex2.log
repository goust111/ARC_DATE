def dilate8(mask):
    d = mask.copy()
    d[1:, :] |= mask[:-1, :]
    d[:-1, :] |= mask[1:, :]
    d[:, 1:] |= mask[:, :-1]
    d[:, :-1] |= mask[:, 1:]
    d[1:, 1:] |= mask[:-1, :-1]
    d[1:, :-1] |= mask[:-1, 1:]
    d[:-1, 1:] |= mask[1:, :-1]
    d[:-1, :-1] |= mask[1:, 1:]
