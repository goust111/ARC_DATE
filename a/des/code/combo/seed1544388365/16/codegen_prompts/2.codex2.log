+    out_width = sum(item["width"] for item in rectangles) + len(rectangles) - 1
+    out = np.full((out_height, out_width), BG, dtype=int)
+
+    col = 0
+    for item in rectangles:
+        h = item["height"]
+        w = item["width"]
+        out[out_height - h :, col : col + w] = item["color"]
+        col += w + 1
+
+    return out
