+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG_COLOR = 0
+START_COLOR = 9
+PATH_PALETTE = (1, 2, 3, 4, 5, 6, 7, 8)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 250
