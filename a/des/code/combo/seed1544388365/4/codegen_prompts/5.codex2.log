+    c_edges = np.cumsum([0] + col_widths)
+    patches: list[np.ndarray] = []
+
+    for r in range(rows):
+        for c in range(cols):
+            inner = image[r_edges[r] : r_edges[r + 1], c_edges[c] : c_edges[c + 1]]
+            h, w = inner.shape
+            patch = np.zeros((h + 2, w + 2), dtype=int)
+            patch[1:-1, 1:-1] = inner
+            patch[0, 1:-1] = np.array(top[r][c], dtype=int)
