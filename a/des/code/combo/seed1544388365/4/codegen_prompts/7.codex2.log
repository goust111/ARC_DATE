+def _canonical_signature(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    return min(_rotation_signatures(mask))
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    comps = _components(mask)
+    return len(comps) == 1
