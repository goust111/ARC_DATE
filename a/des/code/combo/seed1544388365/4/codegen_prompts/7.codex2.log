+            r0, c0, r1, c1 = _bbox(pts)
+            interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+            assert interior.size > 0
+            assert np.all((interior == BG) | (interior == GREY))
+            grey_mask = interior == GREY
+            comp_mask = interior == BG
+            assert grey_mask.any() and comp_mask.any()
+            frames.append(
