+        r0, c0, r1, c1 = frame["bbox"]
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        interior[frame["comp_mask"]] = int(frame["color"])
+
+    for r, c in matched_cells:
+        out[r, c] = BG
+
+    assert len(matched_cells) == int((g == ORANGE).sum())
+    return out
