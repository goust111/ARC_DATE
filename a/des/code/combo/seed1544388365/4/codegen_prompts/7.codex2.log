+    assert len(inner_sizes) == 1, "all frame interiors must share the same size"
+    sigs = [frame["sig"] for frame in frames]
+    assert len(set(sigs)) == len(sigs), "frame complement shapes must be unique up to rotation"
+    return frames
+
