+    left_margin = int(rng.integers(*BASE_SIDE_MARGIN_RANGE))
+    right_margin = int(rng.integers(*BASE_SIDE_MARGIN_RANGE))
+    gaps = [int(rng.integers(*BASE_GAP_RANGE)) for _ in range(max(0, len(specs) - 1))]
+
