+    min_w = left_margin + right_margin + sum(spec["band_w"] for spec in specs) + sum(gaps)
+    if min_w > MAX_GRID_W:
+        return None
+
+    extra_w = int(rng.integers(0, min(MAX_EXTRA_WIDTH, MAX_GRID_W - min_w) + 1))
+    slots = [left_margin, *gaps, right_margin]
+    for _ in range(extra_w):
