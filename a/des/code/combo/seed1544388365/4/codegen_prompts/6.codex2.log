+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _parse_container(grid: np.ndarray, coords: list[tuple[int, int]]):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    r1 = max(rows)
+    c0 = min(cols)
+    c1 = max(cols)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 5:
+        return None
+
+    coord_set = set(coords)
+
+    expected = {(r1, c) for c in range(c0, c1 + 1)}
+    for r in range(r0, r1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+
+    left_missing = [r for r in range(r0, r1) if grid[r, c0] != GREY]
+    right_missing = [r for r in range(r0, r1) if grid[r, c1] != GREY]
+    if len(left_missing) + len(right_missing) != 1:
+        return None
+    if left_missing:
+        hole_r = left_missing[0]
+        hole_c = c0
+        hole_side = "left"
+    else:
+        hole_r = right_missing[0]
+        hole_c = c1
+        hole_side = "right"
+    if hole_r <= r0 or hole_r >= r1:
+        return None
+
+    expected.remove((hole_r, hole_c))
+    if coord_set != expected:
+        return None
+
+    inner = grid[r0:r1, c0 + 1 : c1]
+    if inner.size == 0 or np.any(inner == GREY):
+        return None
+
+    liquid_mask = inner != BG
+    if not liquid_mask.any():
+        return None
+    colors = np.unique(inner[liquid_mask])
+    if colors.size != 1:
+        return None
+    color = int(colors[0])
+    inner_w = inner.shape[1]
+    area = int(liquid_mask.sum())
+    if area % inner_w != 0:
+        return None
+    liquid_h = area // inner_w
+    expected_liquid = np.zeros_like(liquid_mask, dtype=bool)
+    expected_liquid[-liquid_h:, :] = True
+    if not np.array_equal(liquid_mask, expected_liquid):
+        return None
+
+    liquid_top = r1 - liquid_h
+    if hole_r < liquid_top:
+        return None
+
+    liquid_coords = [(r, c) for r in range(liquid_top, r1) for c in range(c0 + 1, c1)]
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "hole": (hole_r, hole_c),
+        "hole_side": hole_side,
+        "color": color,
+        "inner_width": inner_w,
+        "liquid_height": liquid_h,
+        "liquid_coords": liquid_coords,
+    }
+
+
+def _find_containers(grid: np.ndarray) -> list[dict]:
+    containers = []
+    for comp in _components(grid == GREY):
+        parsed = _parse_container(grid, comp)
+        if parsed is not None:
+            containers.append(parsed)
+    containers.sort(key=lambda item: (item["bbox"][1], item["bbox"][0]))
+    return containers
+
+
+def _landing_bottom(grid: np.ndarray, hole_r: int, hole_c: int) -> int:
+    h = grid.shape[0]
+    for r in range(hole_r + 1, h):
+        if grid[r, hole_c] == GREY:
+            return r - 1
+    return h - 1
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Empty each leaky U-shaped grey container and rebuild the liquid as a puddle
+    beneath the hole, resting on the first grey platform below or on the grid bottom.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    containers = _find_containers(g)
+    if not containers:
+        return out
+
+    for container in containers:
+        for r, c in container["liquid_coords"]:
+            out[r, c] = BG
+
+    for container in containers:
+        hole_r, hole_c = container["hole"]
+        width = int(container["inner_width"])
+        height = int(container["liquid_height"])
+        bottom = _landing_bottom(g, hole_r, hole_c)
+
+        left = hole_c - width // 2
+        right = left + width - 1
+        top = bottom - height + 1
+        assert 0 <= left <= right < g.shape[1]
+        assert 0 <= top <= bottom < g.shape[0]
+        assert not np.any(g[top : bottom + 1, left : right + 1] == GREY)
+
+        out[top : bottom + 1, left : right + 1] = container["color"]
+
+    return out
+
+
+def _expected_output(grid: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    h = grid.shape[0]
+    for spec in specs:
+        bottom_r = spec["bottom_r"]
+        out[bottom_r - spec["liquid_h"] : bottom_r, spec["c0"] + 1 : spec["c1"]] = BG
+    for spec in specs:
+        bottom = spec["platform_r"] - 1 if spec["platform_r"] is not None else h - 1
+        top = bottom - spec["liquid_h"] + 1
+        out[top : bottom + 1, spec["puddle_left"] : spec["puddle_right"] + 1] = spec["color"]
+    return out
