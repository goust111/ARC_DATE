+import numpy as np
+
+
+BG = 0
+GREY = 5
+LIQUID_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+
+MIN_CONTAINERS = 2
+MAX_CONTAINERS = 4
+INNER_WIDTH_CHOICES = (3, 5)
+INTERIOR_HEIGHT_RANGE = (3, 7)  # inclusive low, exclusive high
+BASE_SIDE_MARGIN_RANGE = (1, 3)
+BASE_GAP_RANGE = (2, 5)
