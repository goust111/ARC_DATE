+import numpy as np
+
+
+BG = 0
+GREY = 5
+LIQUID_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+
+MIN_CONTAINERS = 2
+MAX_CONTAINERS = 4
