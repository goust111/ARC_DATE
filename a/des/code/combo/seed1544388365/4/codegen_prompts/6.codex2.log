+        left = hole_c - width // 2
+        right = left + width - 1
+        top = bottom - height + 1
+        assert 0 <= left <= right < g.shape[1]
+        assert 0 <= top <= bottom < g.shape[0]
+        assert not np.any(g[top : bottom + 1, left : right + 1] == GREY)
