+        if not (0 <= spec["puddle_left"] <= spec["puddle_right"] < width):
+            return False
+        if not (0 <= spec["top_r"] < spec["bottom_r"] < height):
+            return False
+        if not (spec["top_r"] < spec["hole_r"] < spec["bottom_r"]):
+            return False
