+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        markers = np.argwhere((interior != bg) & (interior != border))
+        assert len(markers) == 1, "expected exactly one interior marker pixel"
+        mr, mc = map(int, markers[0])
