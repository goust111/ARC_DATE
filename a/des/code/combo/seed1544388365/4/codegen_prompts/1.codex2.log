+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[Coord]:
+    cells: set[Coord] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
