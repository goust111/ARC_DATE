+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+@dataclass(frozen=True)
+class Rectangle:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    marker_color: int
