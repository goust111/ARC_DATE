+            break
+        if not placed:
+            return None
+    return rects
+
+
+def _trace_from_gap(
+    h: int,
+    w: int,
+    border_owner: dict[Coord, int],
+    gap: Coord,
+    direction: Coord,
+) -> tuple[tuple[Coord, ...], str, Coord | None]:
+    dr, dc = direction
+    r = gap[0] + dr
+    c = gap[1] + dc
+    if not (0 <= r < h and 0 <= c < w):
+        return (), "invalid", None
+
+    path: list[Coord] = []
+    while 0 <= r < h and 0 <= c < w:
+        if (r, c) in border_owner:
+            return tuple(path), "hit", (r, c)
+        path.append((r, c))
+        r += dr
+        c += dc
+    return tuple(path), "edge", None
+
