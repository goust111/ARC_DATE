+    direction: Coord
+    path: tuple[Coord, ...]
+    path_cells: frozenset[Coord]
+    stop_type: str
+    stop_cell: Coord | None
+
+
+BG_COLOR = 0
+PALETTE = tuple(range(10))
+GRID_MIN = 14
+GRID_MAX = 24
+RECT_COUNT_RANGE = (2, 4)
+RECT_OUTER_H_RANGE = (3, 7)
+RECT_OUTER_W_RANGE = (3, 7)
+PLACEMENT_PAD = 1
+MAX_RECT_PLACEMENT_TRIES = 100
+MAX_GENERATION_ATTEMPTS = 400
