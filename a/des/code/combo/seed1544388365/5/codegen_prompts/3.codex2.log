+        parity = inner_h % 2
+        limit = min(inner_h, inner_w) - 1
+        bbox_options = [
+            (box_h, box_w)
+            for box_h in range(2, limit + 1)
+            for box_w in range(2, limit + 1)
+            if box_h % 2 == parity and box_w % 2 == parity
