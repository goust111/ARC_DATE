+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if len(coords) != 2 * (h + w) - 4:
+        return False
+
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(sub[0, :]) or not np.all(sub[-1, :]):
+        return False
+    if not np.all(sub[:, 0]) or not np.all(sub[:, -1]):
+        return False
+    if h > 2 and w > 2 and np.any(sub[1:-1, 1:-1]):
+        return False
