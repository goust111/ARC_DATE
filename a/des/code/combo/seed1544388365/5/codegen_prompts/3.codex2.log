+    inner_top = top + 1
+    inner_left = left + 1
+    dst_top = inner_top + (inner_h - ph) // 2
+    dst_left = inner_left + (inner_w - pw) // 2
+    grid[dst_top : dst_top + ph, dst_left : dst_left + pw] = patch
