+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        inp = _gen_attempt()
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid room-ranking puzzle")

