+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    rooms = _find_rooms(g)
+    ranked = sorted(
+        rooms,
+        key=lambda room: (
+            int(room["area"]),
+            int(room["outer_top"]),
+            int(room["outer_left"]),
+        ),
+    )
+
+    out = g.copy()
+    for rank, room in enumerate(ranked):
+        inner_top = int(room["inner_top"])
+        inner_left = int(room["inner_left"])
+        inner_h = int(room["inner_h"])
+        inner_w = int(room["inner_w"])
