+def _random_pattern_mask(box_h: int, box_w: int) -> np.ndarray:
+    for _ in range(MAX_PATTERN_ATTEMPTS):
+        target = int(RNG.integers(3, box_h * box_w))
+        mask = np.zeros((box_h, box_w), dtype=bool)
+        seed = (int(RNG.integers(box_h)), int(RNG.integers(box_w)))
+        mask[seed] = True
+        frontier = {seed}
+
+        while int(mask.sum()) < target and frontier:
+            cr, cc = list(frontier)[int(RNG.integers(len(frontier)))]
+            frontier.remove((cr, cc))
+            neighbors = []
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = cr + dr, cc + dc
+                if 0 <= nr < box_h and 0 <= nc < box_w and not mask[nr, nc]:
+                    neighbors.append((nr, nc))
