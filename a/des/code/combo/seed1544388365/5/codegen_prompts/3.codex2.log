+                "outer_top": int(r0),
+                "outer_left": int(c0),
+                "inner_top": int(r0 + 1),
+                "inner_left": int(c0 + 1),
+                "inner_h": inner_h,
+                "inner_w": inner_w,
+                "area": inner_h * inner_w,
+                "patch": patch,
