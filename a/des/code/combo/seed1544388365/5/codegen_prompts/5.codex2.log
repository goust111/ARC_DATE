+        return False
+    if len(info["effective_walls"]) < 1:
+        return False
+    if info["painted_count"] < 8 or info["painted_count"] > int(inp.size * 0.6):
+        return False
+    if want_triple and len(info["triple_cells"]) < 1:
+        return False
+    if want_same_priority and len(info["same_color_cells"]) < 1:
+        return False
+    return True
