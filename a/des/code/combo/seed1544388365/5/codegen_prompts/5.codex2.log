+    height, width = shape
+    tower_positions = {(r, c) for r, c, _color in towers}
+    candidates: set[tuple[int, int]] = set()
+    for r, c, _color in towers:
+        for dr, dc in DIRS:
+            rr = int(r + dr)
+            cc = int(c + dc)
+            dist = 1
+            seen_protected = False
+            while 0 <= rr < height and 0 <= cc < width:
