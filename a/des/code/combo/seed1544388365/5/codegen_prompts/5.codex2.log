+    extra_limit = min(3, len(extras))
+    if extra_limit > 0:
+        extra_count = int(rng.integers(extra_limit + 1))
+        if extra_count:
+            picks = np.atleast_1d(rng.choice(len(extras), size=extra_count, replace=False))
