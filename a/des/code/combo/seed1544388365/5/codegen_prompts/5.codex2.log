+        return None
+    size = int(block.shape[0])
+    if size not in (3, 4):
+        return None
+    if np.any((block == BLACK) | (block == GRAY)):
+        return None
+
+    anchor = int(block[0, 0])
+    if int(np.count_nonzero(block == anchor)) != 1:
+        return None
