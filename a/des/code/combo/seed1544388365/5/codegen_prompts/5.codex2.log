+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+BROWN = 9
+
+SIGNAL_POOL = (RED, BLUE, YELLOW)
+TABLE_ANCHOR = BROWN
+BASE_MIX = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, YELLOW)): ORANGE,
+    frozenset((BLUE, YELLOW)): GREEN,
