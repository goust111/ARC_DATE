+    assert pairs, "expected at least one boundary marker pair"
+    assert covered == edge_fg, "every edge foreground cell must belong to a length-2 pair"
+    return pairs
+
+
+def _find_internal_components(g: np.ndarray) -> list[dict[str, object]]:
