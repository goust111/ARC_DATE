+
+    for r in range(h - 1):
+        if (
+            int(g[r, 0]) != 0
+            and int(g[r + 1, 0]) != 0
+            and (r == 0 or int(g[r - 1, 0]) == 0)
+            and (r + 2 == h or int(g[r + 2, 0]) == 0)
+        ):
