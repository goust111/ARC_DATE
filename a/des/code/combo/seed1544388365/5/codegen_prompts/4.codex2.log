+        if (
+            int(g[h - 1, c]) != 0
+            and int(g[h - 1, c + 1]) != 0
+            and (c == 0 or int(g[h - 1, c - 1]) == 0)
+            and (c + 2 == w or int(g[h - 1, c + 2]) == 0)
+        ):
