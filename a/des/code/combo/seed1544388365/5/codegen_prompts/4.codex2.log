+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+AXIS_BY_SIDE = {
+    "top": "horizontal",
+    "bottom": "horizontal",
+    "left": "vertical",
+    "right": "vertical",
+}
+GENERATION_RETRIES = 400
