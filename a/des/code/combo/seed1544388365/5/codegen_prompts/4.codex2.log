+        if (
+            int(g[r, w - 1]) != 0
+            and int(g[r + 1, w - 1]) != 0
+            and (r == 0 or int(g[r - 1, w - 1]) == 0)
+            and (r + 2 == h or int(g[r + 2, w - 1]) == 0)
