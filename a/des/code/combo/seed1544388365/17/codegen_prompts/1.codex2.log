+
+
+def _apply_orientation(arr: np.ndarray, rotations: int, flip_lr: bool) -> np.ndarray:
+    out = np.fliplr(arr) if flip_lr else arr
+    return np.rot90(out, rotations).copy()
+
+
+def _map_side(side: str, rotations: int, flip_lr: bool) -> str:
