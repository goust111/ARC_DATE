+    rng.shuffle(palette)
+    needed = 3 * n_frames
+    if len(palette) < needed:
+        return None
+    border_colors = palette[:n_frames]
+    shape_colors = palette[n_frames : 2 * n_frames]
+    marker_colors = palette[2 * n_frames : 3 * n_frames]
