+FLIP_LR = {"up": "up", "down": "down", "left": "right", "right": "left"}
+ORIENTATIONS = [
+    (0, False),
+    (1, False),
+    (2, False),
+    (3, False),
+    (0, True),
+    (1, True),
+    (2, True),
+    (3, True),
