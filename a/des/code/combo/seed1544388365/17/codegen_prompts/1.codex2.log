+            if edge == "top":
+                top = 0
+                left = rng.randint(0, gw - pw)
+            elif edge == "bottom":
+                top = gh - ph
+                left = rng.randint(0, gw - pw)
+            elif edge == "left":
+                top = rng.randint(0, gh - ph)
+                left = 0
+            else:
+                top = rng.randint(0, gh - ph)
+                left = gw - pw
+            if not _can_place(blocked, top, left, ph, pw, pad=1):
+                continue
+            _paste(grid, patch, top, left, bg)
+            _reserve(blocked, top, left, ph, pw, pad=1)
