+        for idx, color in ring["cargos"].items():
+            rr, cc = ring["cycle"][(idx + step) % len(ring["cycle"])]
+            out[rr, cc] = color
+        mr, mc = ring["center"]
+        out[mr, mc] = ring["marker"]
