+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+MARKER_TO_STEP = {
+    RED: 1,
+    BLUE: -1,
+}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    counts = Counter(map(int, grid.flat))
+    return counts.most_common(1)[0][0]
+
+
+def _rect_cycle(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        coords.append((r, c1))
+    for c in range(c1 - 1, c0 - 1, -1):
+        coords.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        coords.append((r, c0))
+    return coords
+
+
+def _scan_to_non_bg(
+    grid: np.ndarray,
+    bg: int,
+    r: int,
+    c: int,
+    dr: int,
+    dc: int,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    rr, cc = r + dr, c + dc
+    while 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == bg:
+        rr += dr
+        cc += dc
+    if 0 <= rr < h and 0 <= cc < w:
+        return rr, cc
+    return None
+
+
+def _ring_from_marker(
+    grid: np.ndarray,
+    bg: int,
+    mr: int,
+    mc: int,
+) -> dict | None:
+    marker = int(grid[mr, mc])
+    if marker not in MARKER_TO_STEP:
+        return None
+
+    up = _scan_to_non_bg(grid, bg, mr, mc, -1, 0)
+    down = _scan_to_non_bg(grid, bg, mr, mc, 1, 0)
