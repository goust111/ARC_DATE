+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color == bg:
+                continue
+            comp = int(labels[r, c])
+            assert comp >= 0
+            if color == GREY:
+                terminals.append((r, c, comp))
+            elif color not in (BLACK, MAROON):
+                comp_sources[comp].add(color)
