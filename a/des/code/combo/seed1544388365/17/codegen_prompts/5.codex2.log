+    out = g.copy()
+    for r, c, comp in terminals:
+        colors = comp_sources[comp]
+        if len(colors) == 1:
+            out[r, c] = next(iter(colors))
+        elif len(colors) >= 2:
+            out[r, c] = YELLOW
+    return out
