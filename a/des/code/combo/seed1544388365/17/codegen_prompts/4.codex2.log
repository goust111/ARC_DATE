+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    expected_area = 2 * (h + w) - 4
+    if int(coords.shape[0]) != expected_area:
+        return None
+
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
