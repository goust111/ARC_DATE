+    h, w = grid.shape
+    marker_flags = []
+    marker_neighbors = []
+    for r, c in endpoints:
+        neighbors = []
+        for dr, dc in DIR_VECS.values():
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == int(MARKER_COLOR):
+                neighbors.append((int(nr), int(nc)))
