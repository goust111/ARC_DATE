+
+    return {
+        "color": int(color),
+        "orient": orient,
+        "points": sorted(points),
+        "outer": outer,
+        "inner": inner,
+        "outer_dir": outer_dir,
+        "marker_neighbor": marker_neighbors[outer_idx][0],
+    }
+
+
+def _line_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
