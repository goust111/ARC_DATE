+                    if seen[rr, cc] or int(g[rr, cc]) != color:
+                        continue
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            r1, r2 = min(rows), max(rows)
+            c1, c2 = min(cols), max(cols)
+            mask = np.zeros((r2 - r1 + 1, c2 - c1 + 1), dtype=bool)
+            for r, c in coords:
+                mask[int(r - r1), int(c - c1)] = True
+
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r1), int(c1), int(r2), int(c2)),
+                    "mask": mask,
+                    "area": int(len(coords)),
+                }
+            )
+
+    return comps
+
+
+def _container_mask(shape: tuple[int, int], direction: str) -> np.ndarray | None:
+    h, w = map(int, shape)
+    if direction in ("up", "down") and (h < 2 or w < 3):
+        return None
+    if direction in ("left", "right") and (h < 3 or w < 2):
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    if direction == "up":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif direction == "down":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif direction == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    else:
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    return mask
+
+
+def _container_spec(mask: np.ndarray) -> dict | None:
+    h, w = map(int, mask.shape)
+    matches: list[dict] = []
+
+    for direction in _DIRS:
+        expected = _container_mask((h, w), direction)
+        if expected is None or not np.array_equal(mask, expected):
+            continue
+
+        if direction == "up":
+            matches.append(
+                {
+                    "direction": direction,
+                    "slot_top": 0,
+                    "slot_left": 1,
+                    "slot_h": int(h - 1),
+                    "slot_w": int(w - 2),
+                }
+            )
+        elif direction == "down":
+            matches.append(
+                {
+                    "direction": direction,
+                    "slot_top": 1,
+                    "slot_left": 1,
+                    "slot_h": int(h - 1),
+                    "slot_w": int(w - 2),
+                }
+            )
+        elif direction == "left":
+            matches.append(
+                {
+                    "direction": direction,
+                    "slot_top": 1,
+                    "slot_left": 0,
+                    "slot_h": int(h - 2),
+                    "slot_w": int(w - 1),
+                }
+            )
+        else:
+            matches.append(
+                {
+                    "direction": direction,
+                    "slot_top": 1,
+                    "slot_left": 1,
+                    "slot_h": int(h - 2),
+                    "slot_w": int(w - 1),
+                }
+            )
+
+    if len(matches) != 1:
+        return None
+    return matches[0]
+
+
+def _match_pairs(pieces: list[dict], containers: list[dict]) -> dict[int, int]:
+    candidates: dict[int, list[int]] = {}
+    for ci, container in enumerate(containers):
+        slot_h = int(container["slot_h"])
+        slot_w = int(container["slot_w"])
+        slot_area = int(slot_h * slot_w)
+        fit: list[int] = []
+        for pi, piece in enumerate(pieces):
+            piece_h, piece_w = map(int, piece["mask"].shape)
+            if int(piece["area"]) != slot_area:
+                continue
+            if (piece_h, piece_w) == (slot_h, slot_w) or (piece_w, piece_h) == (slot_h, slot_w):
+                fit.append(int(pi))
+        assert fit, "every container must have at least one matching piece"
+        candidates[int(ci)] = fit
+
+    order = sorted(
+        range(len(containers)),
+        key=lambda ci: (
+            len(candidates[int(ci)]),
+            int(containers[int(ci)]["slot_h"]) * int(containers[int(ci)]["slot_w"]),
+            int(containers[int(ci)]["bbox"][0]),
+            int(containers[int(ci)]["bbox"][1]),
+        ),
+    )
+
+    assign: dict[int, int] = {}
+    used: set[int] = set()
+
+    def search(k: int) -> bool:
+        if k == len(order):
+            return True
+        ci = int(order[k])
+        for pi in candidates[ci]:
+            if int(pi) in used:
+                continue
+            used.add(int(pi))
+            assign[ci] = int(pi)
+            if search(k + 1):
+                return True
+            used.remove(int(pi))
+            del assign[ci]
+        return False
+
+    assert search(0), "piece-container matching must be solvable"
+    return assign
