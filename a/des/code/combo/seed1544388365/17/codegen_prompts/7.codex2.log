+        used_areas: set[int] = set()
+        for idx in rng.permutation(len(candidates)):
+            slot_h, slot_w = candidates[int(idx)]
+            area = int(slot_h * slot_w)
+            if area in used_areas:
+                continue
+            picked.append((slot_h, slot_w))
+            used_areas.add(area)
