+# --------------- solver ---------------
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _local_mask(coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        local[r - r0, c - c0] = True
+    return local, (r0, c0, r1, c1)
+
+
+def _frame_info(coords: list[tuple[int, int]]) -> dict[str, object] | None:
+    local, bbox = _local_mask(coords)
+    h, w = local.shape
+    if h < 3 or w < 3:
+        return None
+    if bool(local[1:-1, 1:-1].any()):
+        return None
+
+    matches: list[str] = []
+    for side in SIDES:
+        expected = np.zeros((h, w), dtype=bool)
+        expected[0, :] = True
+        expected[-1, :] = True
+        expected[:, 0] = True
+        expected[:, -1] = True
+        if side == "top":
+            expected[0, 1:-1] = False
+        elif side == "bottom":
+            expected[-1, 1:-1] = False
+        elif side == "left":
+            expected[1:-1, 0] = False
+        else:
+            expected[1:-1, -1] = False
+        if np.array_equal(local, expected):
+            matches.append(side)
+
+    if len(matches) != 1:
+        return None
+
+    return {
+        "bbox": bbox,
+        "coords": coords,
+        "missing_side": matches[0],
+    }
+
+
+def _line_info(coords: list[tuple[int, int]]) -> dict[str, object] | None:
+    local, bbox = _local_mask(coords)
+    h, w = local.shape
+    if h != 1 and w != 1:
+        return None
+    if not bool(local.all()):
+        return None
+    length = int(max(h, w))
+    if length == 1:
+        orientation = "point"
+    else:
+        orientation = "horizontal" if h == 1 else "vertical"
+    return {
