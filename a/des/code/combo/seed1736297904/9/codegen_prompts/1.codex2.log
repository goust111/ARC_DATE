+        if edge_frame:
+            continue
+
+        seed_coords = np.argwhere(interior != bg)
+        if seed_coords.shape[0] != 1:
+            continue
+        sr, sc = map(int, seed_coords[0])
+        seed_color = int(interior[sr, sc])
