+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _monochrome_components(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_rectangular_frames(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    frames: list[dict[str, object]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for comp in _monochrome_components(grid, color):
+            rows = [r for r, _ in comp]
+            cols = [c for _, c in comp]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            height = r1 - r0 + 1
+            width = c1 - c0 + 1
+            if height < 3 or width < 3:
+                continue
+            if len(comp) != 2 * (height + width) - 4:
+                continue
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            mask = patch == color
+            expected = np.zeros((height, width), dtype=bool)
+            expected[0, :] = True
+            expected[-1, :] = True
+            expected[:, 0] = True
+            expected[:, -1] = True
+            if not np.array_equal(mask, expected):
+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    return frames
+
+
+def _touches_edge(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    h, w = shape
