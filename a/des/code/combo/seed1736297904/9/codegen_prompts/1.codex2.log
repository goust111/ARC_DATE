+def _legend_patch(border_color: int, pattern: np.ndarray) -> np.ndarray:
+    size = int(pattern.shape[0])
+    patch = np.full((size + 2, size + 2), border_color, dtype=int)
+    patch[1:-1, 1:-1] = pattern
+    return patch
