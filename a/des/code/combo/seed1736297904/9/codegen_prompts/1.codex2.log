+            height = rng.randint(TARGET_OUTER_H_RANGE[0], min(TARGET_OUTER_H_RANGE[1], r_max - r_min + 1))
+            width = rng.randint(TARGET_OUTER_W_RANGE[0], min(TARGET_OUTER_W_RANGE[1], c_max - c_min + 1))
