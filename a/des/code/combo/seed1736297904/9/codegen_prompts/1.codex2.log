+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+NON_BG_COLORS = tuple(range(1, 10))
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
