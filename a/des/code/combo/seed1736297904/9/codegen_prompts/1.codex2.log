+    h, w = grid_shape
+    r_min, c_min = 1, 1
+    r_max, c_max = h - 2, w - 2
+    if side == "top":
+        r_min = max(r_min, reserved_band)
+    elif side == "bottom":
+        r_max = min(r_max, h - reserved_band - 1)
+    elif side == "left":
+        c_min = max(c_min, reserved_band)
+    elif side == "right":
