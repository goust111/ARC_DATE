+            c += pw + LEGEND_GAP
+    else:
+        total = sum(int(spec["patch"].shape[0]) for spec in legend_specs) + LEGEND_GAP * (len(legend_specs) - 1)
+        if total > h - 2:
+            return None
+        start_r = rng.randint(1, h - 1 - total)
+        r = start_r
+        for spec in legend_specs:
+            patch = spec["patch"]
+            ph, pw = patch.shape
+            c0 = 0 if side == "left" else w - pw
