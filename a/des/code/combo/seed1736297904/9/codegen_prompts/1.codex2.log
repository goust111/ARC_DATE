+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+NON_BG_COLORS = tuple(range(1, 10))
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+LEGEND_COUNT_RANGE = (2, 4)
+TARGET_COUNT_RANGE = (1, 3)
