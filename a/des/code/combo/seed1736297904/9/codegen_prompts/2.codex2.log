+    if side == "up":
+        if not bool(mask[0, :].any()):
+            return []
+        rows = [0]
+        cols = list(range(target_w - pw + 1))
+    elif side == "down":
+        if not bool(mask[-1, :].any()):
+            return []
+        rows = [target_h - ph]
+        cols = list(range(target_w - pw + 1))
+    elif side == "left":
+        if not bool(mask[:, 0].any()):
+            return []
+        rows = list(range(target_h - ph + 1))
+        cols = [0]
+    elif side == "right":
+        if not bool(mask[:, -1].any()):
