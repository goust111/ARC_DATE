+                _partition_top_left_right,
+                _partition_bottom_left_right,
+                _partition_left_top_bottom,
+                _partition_right_top_bottom,
+            )
+        )(rng, h, w)
+    else:
+        pieces = rng.choice((_partition_top_bottom_left_right, _partition_left_right_top_bottom))(rng, h, w)
