+
+def _arrow_slots(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    preferred: list[tuple[int, int]] = []
+    fallback: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if not bool(mask[r : r + 2, c : c + 2].all()):
+                continue
+            fallback.append((r, c))
+            if 0 < r < h - 2 and 0 < c < w - 2:
