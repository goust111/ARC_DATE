+def _build_partition(rng: random.Random) -> tuple[int, int, list[dict[str, object]]] | None:
+    count = rng.randint(2, 4)
+    h = rng.randint(*RECT_H_RANGE)
+    w = rng.randint(*RECT_W_RANGE)
