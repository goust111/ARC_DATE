+            linear = np.asarray(placement["linear"], dtype=int)
+            if bool(occupied[linear].any()):
+                continue
+            occupied[linear] = True
+            current[idx] = placement
+            dfs(depth + 1)
+            current[idx] = None
+            occupied[linear] = False
