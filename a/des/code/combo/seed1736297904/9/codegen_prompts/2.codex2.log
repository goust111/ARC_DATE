+# The missing corner of the 2x2 marker rotates with the encoded direction.
+ARROW_PATTERNS: dict[str, set[tuple[int, int]]] = {
+    "up": {(0, 0), (0, 1), (1, 0)},
+    "right": {(0, 0), (0, 1), (1, 1)},
+    "down": {(0, 1), (1, 0), (1, 1)},
+    "left": {(0, 0), (1, 0), (1, 1)},
+}
