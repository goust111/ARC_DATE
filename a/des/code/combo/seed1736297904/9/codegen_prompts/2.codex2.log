+    for r0 in rows:
+        for c0 in cols:
+            linear = np.asarray([(r0 + int(r)) * target_w + c0 + int(c) for r, c in coords], dtype=int)
+            out.append({"row": int(r0), "col": int(c0), "linear": linear})
+    return out
