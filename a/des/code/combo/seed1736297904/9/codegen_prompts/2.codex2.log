+    return patch
+
+
+def _place_bbox(
+    rng: random.Random,
+    blocked: np.ndarray,
+    box_h: int,
+    box_w: int,
+) -> tuple[int, int] | None:
+    gh, gw = blocked.shape
+    if box_h > gh or box_w > gw:
+        return None
+
+    min_r = 1 if gh - box_h >= 2 else 0
+    max_r = gh - box_h - 1 if gh - box_h >= 2 else gh - box_h
+    min_c = 1 if gw - box_w >= 2 else 0
+    max_c = gw - box_w - 1 if gw - box_w >= 2 else gw - box_w
+    if max_r < min_r or max_c < min_c:
+        return None
