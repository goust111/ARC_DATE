+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDES = ("up", "down", "left", "right")
+COLOR_CHOICES = tuple(c for c in range(1, 10) if c != GREY)
