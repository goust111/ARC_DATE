+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+    mask = _mask_from_coords(coords)
+    expected = np.zeros_like(mask, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(mask, expected):
+        return None
+    return (r0, c0, r1, c1)
