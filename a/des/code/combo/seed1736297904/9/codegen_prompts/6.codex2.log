+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+LINE_GAP_TOLERANCE = 3
+GEN_RETRIES = 400
+REGION_LAYOUTS = ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (2, 3), (3, 2))
+REGION_SIZE_RANGE = (4, 7)
