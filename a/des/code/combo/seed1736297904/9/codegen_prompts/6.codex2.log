+    out = inp.copy()
+    _local_cross_fill(out, parsed)
+    _propagate_spills(out, parsed, sorted(gaps, key=lambda gap: (int(gap["row"]), int(gap["col"]), int(gap["orient"] == "v"))))
+    return out
