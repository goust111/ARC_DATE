+    col = random.choice(cols)
+    gaps.append({"orient": "h", "row": boundary, "col": col, "ri": ri, "cj": cj})
+    _remove_gray(top, (boundary - 1, col))
+    _remove_gray(bottom, (boundary + 1, col))
+    return True
