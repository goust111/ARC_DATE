+            b = regions[(ri + 1, cj)]
+            c = regions[(ri + 2, cj)]
+            col = int(a["marker"][1])
+            if col != int(b["marker"][1]) and col != int(c["marker"][1]):
+                key1 = ("h", ri, cj)
+                key2 = ("h", ri + 1, cj)
+                if key1 not in used and key2 not in used:
+                    candidates.append(("col", ri, cj))
+
+    if not candidates:
+        return False
+
+    kind, ri, cj = random.choice(candidates)
+    if kind == "row":
+        a = regions[(ri, cj)]
