+def _local_cross_fill(out: np.ndarray, regions: dict[tuple[int, int], dict]) -> None:
+    for region in regions.values():
+        r0, r1, c0, c1 = region["box"]
+        mr, mc = region["marker"]
+        color = region["color"]
+
+        row = out[mr, c0 : c1 + 1]
+        row[row == GREY] = color
+        col = out[r0 : r1 + 1, mc]
+        col[col == GREY] = color
+
+
+def _extract_gaps(
+    g: np.ndarray,
+    row_lines: list[int],
+    col_lines: list[int],
+) -> list[dict]:
+    gaps: list[dict] = []
+
