+def _setup_horizontal_inactive(regions: dict[tuple[int, int], dict], ri: int, cj: int, gaps: list[dict]) -> bool:
+    top = regions[(ri, cj)]
+    bottom = regions[(ri + 1, cj)]
+    boundary = int(top["box"][1] + 1)
+    c0 = int(top["box"][2])
