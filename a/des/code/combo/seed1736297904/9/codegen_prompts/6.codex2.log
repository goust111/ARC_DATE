+def _local_only(inp: np.ndarray, regions: dict[tuple[int, int], dict]) -> np.ndarray:
+    parsed = {
+        key: {"box": region["box"], "marker": region["marker"], "color": region["color"]}
+        for key, region in regions.items()
+    }
+    out = inp.copy()
+    _local_cross_fill(out, parsed)
+    return out
