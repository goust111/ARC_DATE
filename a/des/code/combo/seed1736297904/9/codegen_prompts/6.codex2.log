+def _render_input(row_lines: list[int], col_lines: list[int], regions: dict[tuple[int, int], dict], gaps: list[dict]) -> np.ndarray:
+    h = int(row_lines[-1] + 1)
+    w = int(col_lines[-1] + 1)
+    g = np.full((h, w), BLACK, dtype=int)
+    g[row_lines, :] = MAROON
+    g[:, col_lines] = MAROON
