+    a = regions[(ri, cj)]
+    b = regions[(ri + 1, cj)]
+    c = regions[(ri + 2, cj)]
+    col = int(a["marker"][1])
+    boundary1 = int(a["box"][1] + 1)
+    boundary2 = int(b["box"][1] + 1)
+
+    gaps.append({"orient": "h", "row": boundary1, "col": col, "ri": ri, "cj": cj})
+    gaps.append({"orient": "h", "row": boundary2, "col": col, "ri": ri + 1, "cj": cj})
+    used.add(("h", ri, cj))
+    used.add(("h", ri + 1, cj))
