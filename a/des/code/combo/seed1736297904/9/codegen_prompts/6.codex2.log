+LINE_GAP_TOLERANCE = 3
+GEN_RETRIES = 400
+REGION_LAYOUTS = ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (2, 3), (3, 2))
+REGION_SIZE_RANGE = (4, 7)
