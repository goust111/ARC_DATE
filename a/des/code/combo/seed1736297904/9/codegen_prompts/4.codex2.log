+    rows = [int(r) for r, cnt in enumerate(counts) if int(cnt) >= max(3, width // 2)]
+    if not rows or rows[0] != 0 or rows[-1] != int(grid.shape[0]) - 1:
+        raise AssertionError("failed to identify horizontal wall lines")
