+    top, bottom, left, right = rooms[root]["bounds"]
+    height = bottom - top + 1
+    width = right - left + 1
+    placements = _shelf_pack(final_order, height, width)
+    if placements is None:
+        raise AssertionError("terminal room is too small for the packed objects")
