+def _cell_grid_neighbors(rows: int, cols: int):
+    neighbors = {}
+    for rr in range(rows):
+        for cc in range(cols):
+            cell = (rr, cc)
+            links = []
+            if rr > 0:
+                links.append((rr - 1, cc))
+            if rr + 1 < rows:
+                links.append((rr + 1, cc))
+            if cc > 0:
