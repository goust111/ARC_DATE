+        if len(cells) >= MIN_LINE_LEN:
+            candidates.append(LocalLine("d1", d, cells, frozenset(cells)))
+    for s in range(h + w - 1):
+        cells = _local_line_cells(h, w, "d2", s)
+        if len(cells) >= MIN_LINE_LEN:
+            candidates.append(LocalLine("d2", s, cells, frozenset(cells)))
+    return candidates
+
