+def _visible_count(stack: list[LocalLine], idx: int) -> int:
+    line = stack[idx]
+    hidden = 0
+    for higher in stack[idx + 1 :]:
+        if _local_intersection(line, higher) is not None:
+            hidden += 1
+    return len(line.cells) - hidden
+
