+def _boxes_clear(existing: List[Tuple[int, int, int, int]], cand: Tuple[int, int, int, int], pad: int) -> bool:
+    r0, c0, r1, c1 = cand
+    for er0, ec0, er1, ec1 in existing:
+        if not (r1 + pad < er0 or er1 + pad < r0 or c1 + pad < ec0 or ec1 + pad < c0):
