+                if 0 <= nr < 3 and 0 <= nc < 3 and (nr, nc) not in chosen:
+                    frontier.add((nr, nc))
+        if len(chosen) != area:
+            continue
+        mask = np.zeros((3, 3), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+        if not (mask[0].any() and mask[2].any() and mask[:, 0].any() and mask[:, 2].any()):
+            continue
