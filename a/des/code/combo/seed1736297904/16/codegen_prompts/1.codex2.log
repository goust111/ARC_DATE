+    pw = int(pc1 - pc0 + 1)
+    assert (ph, pw) == (3, 3)
+    pattern = np.where(mask[pr0 : pr1 + 1, pc0 : pc1 + 1], pattern_color, BG)
+    return pattern, int(pr0), int(pc0)
