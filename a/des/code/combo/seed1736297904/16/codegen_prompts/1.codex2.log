+    containers: List[Dict[str, object]] = []
+    stamps: List[Dict[str, object]] = []
+    for comp in _color_components(g):
+        info = _classify_frame_component(g, comp)
+        if info is None:
+            continue
+        if info["kind"] == "container":
+            containers.append(info)
+        else:
+            stamps.append(info)
