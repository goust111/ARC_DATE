+
+PAIR_COUNT_CHOICES = [1, 2, 3]
+MAX_CANVAS = 30
+PLACEMENT_PAD = 1
+GEN_RETRIES = 300
+PLACEMENT_RETRIES = 200
+PATTERN_RETRIES = 100
