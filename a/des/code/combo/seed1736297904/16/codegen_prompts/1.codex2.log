+def _random_pattern(rng: random.Random) -> np.ndarray:
+    for _ in range(PATTERN_RETRIES):
+        area = rng.randint(4, 6)
+        cells = [(r, c) for r in range(3) for c in range(3)]
+        start = rng.choice(cells)
+        chosen = {start}
+        frontier = set()
+        for dr, dc in DIRS4:
+            nr, nc = start[0] + dr, start[1] + dc
