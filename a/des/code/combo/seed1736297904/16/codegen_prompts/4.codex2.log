def _extract_pattern(stamp: Dict[str, object], grid: np.ndarray) -> Tuple[np.ndarray, int, int]:
    r0, c0, r1, c1 = stamp["bbox"]
    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
    pattern_color = int(stamp["pattern_color"])
    mask = patch == pattern_color
