import random
from typing import Dict, List, Optional, Tuple

import numpy as np


BG = 0
DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
GAP_TO_ROT_K = {"up": 0, "right": 3, "down": 2, "left": 1}


def _bbox(coords: List[Tuple[int, int]]) -> Tuple[int, int, int, int]:
    rs = [r for r, _ in coords]
    cs = [c for _, c in coords]
    return min(rs), min(cs), max(rs), max(cs)


def _color_components(grid: np.ndarray) -> List[Dict[str, object]]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: List[Dict[str, object]] = []
    for r in range(h):
        for c in range(w):
            color = int(grid[r, c])
            if color == BG or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords: List[Tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for dr, dc in DIRS4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            r0, c0, r1, c1 = _bbox(coords)
            comps.append(
                {
                    "color": color,
                    "coords": coords,
                    "bbox": (r0, c0, r1, c1),
                    "height": r1 - r0 + 1,
                    "width": c1 - c0 + 1,
                }
            )
    return comps


def _classify_frame_component(grid: np.ndarray, comp: Dict[str, object]) -> Optional[Dict[str, object]]:
    color = int(comp["color"])
    coords = comp["coords"]
    r0, c0, r1, c1 = comp["bbox"]
    h = int(comp["height"])
    w = int(comp["width"])
    if h < 3 or w < 3:
        return None

    comp_set = set(coords)
    perimeter = set()
    for cc in range(c0, c1 + 1):
        perimeter.add((r0, cc))
        perimeter.add((r1, cc))
    for rr in range(r0, r1 + 1):
        perimeter.add((rr, c0))
        perimeter.add((rr, c1))
    if not comp_set.issubset(perimeter):
        return None

    inner = grid[r0 + 1 : r1, c0 + 1 : c1] if h > 2 and w > 2 else np.zeros((0, 0), dtype=int)
    inner_other_colors = {int(v) for v in np.unique(inner) if int(v) not in (BG, color)}
    missing = perimeter - comp_set

    if not missing:
        if h < 5 or w < 5 or len(inner_other_colors) != 1:
            return None
        return {
            "kind": "stamp",
            "color": color,
            "pattern_color": next(iter(inner_other_colors)),
            "bbox": (r0, c0, r1, c1),
            "height": h,
            "width": w,
        }

    if len(missing) != 1 or h < 7 or w < 7 or np.any(inner != BG):
        return None

    gap = next(iter(missing))
    centers = {
        (r0, c0 + w // 2): "up",
        (r1, c0 + w // 2): "down",
        (r0 + h // 2, c0): "left",
