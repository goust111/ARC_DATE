+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+MAROON = 9
+MAX_GENERATION_ATTEMPTS = 200
+
+
+PATTERN_LIBRARY = (
+    np.array([[1, 0], [0, 1]], dtype=int),
+    np.array([[1, 1], [0, 0]], dtype=int),
+    np.array([[1, 0], [1, 0]], dtype=int),
