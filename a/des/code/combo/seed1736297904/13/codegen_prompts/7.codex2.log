+        candidates = []
+        for r0 in range(padding, h - ph - padding + 1):
+            for c0 in range(padding, w - pw - padding + 1):
+                rr0 = r0 - padding
+                cc0 = c0 - padding
+                rr1 = r0 + ph + padding
+                cc1 = c0 + pw + padding
+                if not occupied[rr0:rr1, cc0:cc1].any():
