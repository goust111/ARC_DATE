+def _find_components(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comp_ids = np.full((h, w), -1, dtype=int)
