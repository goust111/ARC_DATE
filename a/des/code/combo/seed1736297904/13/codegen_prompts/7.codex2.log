+            cmin = int(arr[:, 1].min())
+            rmax = int(arr[:, 0].max())
+            cmax = int(arr[:, 1].max())
+            comp_id = len(components)
+            comp_ids[arr[:, 0], arr[:, 1]] = comp_id
+            components.append(
