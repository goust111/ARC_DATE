+        for c0 in range(w):
+            if visited[r0, c0] or int(grid[r0, c0]) == bg:
+                continue
+            color = int(grid[r0, c0])
+            stack = [(r0, c0)]
+            coords = []
+            visited[r0, c0] = True
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
