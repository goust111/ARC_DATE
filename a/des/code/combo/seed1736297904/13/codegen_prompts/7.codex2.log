+    canvas = _sample_canvas(input_patches, padding)
+    if canvas is None:
+        return None
+    scattered = _scatter_patches(input_patches, output_patches, canvas, padding)
+    if scattered is None:
+        return None
+    inp, expected = scattered
+    if np.array_equal(inp, expected):
+        return None
+
+    try:
