+    arrows = []
+    rectangles = []
+    arrow_dirs = {}
+    for comp in components:
+        kind, direction = _classify(comp)
+        if kind == "arrow":
+            arrows.append(comp)
+            arrow_dirs[comp["id"]] = direction
+        else:
+            rectangles.append(comp)
+
+    assert len(arrows) >= 2
+    assert len(arrows) == len(rectangles)
+    rectangle_ids = {comp["id"] for comp in rectangles}
+
