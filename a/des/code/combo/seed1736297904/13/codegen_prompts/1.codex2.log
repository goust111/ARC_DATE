+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SIDES = ("top", "bottom", "left", "right")
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (14, 26)
+GRID_W_RANGE = (14, 26)
+RECT_COUNT_OPTIONS = (1, 2, 2, 3, 3, 4)
+OUTER_H_RANGE = (4, 8)
+OUTER_W_RANGE = (4, 8)
+MAX_MARKERS_PER_RECT = 5
+GEN_RETRIES = 500
+PLACEMENT_RETRIES = 120
