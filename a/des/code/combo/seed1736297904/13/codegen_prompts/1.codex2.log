+def _trace_ray(
+    frame: dict,
+    h: int,
+    w: int,
+    border_cells: set[tuple[int, int]],
+    bbox_cells: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], bool] | None:
+    gr, gc = frame["gap"]
+    dr, dc = _ray_dir(frame["side"])
+    r, c = gr + dr, gc + dc
+    path: list[tuple[int, int]] = []
+    blocked = False
