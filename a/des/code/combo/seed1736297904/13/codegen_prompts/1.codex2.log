+        sh = _random_size(rng, max_h, OUTER_H_RANGE[0], OUTER_H_RANGE[1])
+        sw = _random_size(rng, max_w, OUTER_W_RANGE[0], OUTER_W_RANGE[1])
+        bh = _random_size(rng, max_h, OUTER_H_RANGE[0], OUTER_H_RANGE[1])
