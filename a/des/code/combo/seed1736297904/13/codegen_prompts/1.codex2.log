+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _border_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        coords.append((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c0))
+        coords.append((r, c1))
+    return coords
+
+
+def _gap_side(r0: int, c0: int, r1: int, c1: int, gap: tuple[int, int]) -> str:
+    gr, gc = gap
+    if gr == r0:
+        return "top"
+    if gr == r1:
+        return "bottom"
+    if gc == c0:
+        return "left"
+    return "right"
+
+
+def _ray_dir(side: str) -> tuple[int, int]:
+    return {
+        "top": (-1, 0),
+        "bottom": (1, 0),
+        "left": (0, -1),
+        "right": (0, 1),
+    }[side]
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    frames: list[dict] = []
+    for pts in _components4(g == GREY):
+        r0, c0 = map(int, pts.min(axis=0))
+        r1, c1 = map(int, pts.max(axis=0))
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+
+        border = set(_border_coords(r0, c0, r1, c1))
+        grey_pts = {tuple(map(int, p)) for p in pts}
+        if not grey_pts.issubset(border):
