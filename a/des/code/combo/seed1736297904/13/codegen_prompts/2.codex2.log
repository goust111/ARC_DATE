+def _clear_of_occupied(r: int, c: int, occupied: set[tuple[int, int]]) -> bool:
+    for rr, cc in occupied:
+        if max(abs(r - rr), abs(c - cc)) <= 1:
+            return False
+    return True
+
+
+def _candidate_cells(
+    h: int,
+    w: int,
+    quad: str,
+    size: int,
+    occupied: set[tuple[int, int]],
+    clipped_only: bool | None = None,
+) -> list[tuple[int, int]]:
