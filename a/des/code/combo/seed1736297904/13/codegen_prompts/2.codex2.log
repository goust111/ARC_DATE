+    cells: list[tuple[int, int]] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if r in (0, h - 1) or c in (0, w - 1):
+                continue
+            if _touches_corner_buffer(r, c, h, w, quad, size):
