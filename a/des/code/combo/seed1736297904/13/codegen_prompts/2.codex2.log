+    special_quads = [quad for quad in QUADS if sizes[quad] >= 3]
+    if (need_overlap or need_clip) and not special_quads:
+        return None
+
+    colors = dict(zip(QUADS, RNG.sample(PALETTE, len(QUADS))))
+    counts = {quad: 0 for quad in QUADS}
