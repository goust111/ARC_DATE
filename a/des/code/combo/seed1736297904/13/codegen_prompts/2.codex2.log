+    occupied: set[tuple[int, int]] = set()
+    placed: dict[str, list[tuple[int, int]]] = {quad: [] for quad in QUADS}
+
+    if overlap_quad is not None:
+        pair = _place_overlap_pair(h, w, overlap_quad, sizes[overlap_quad], occupied)
+        if pair is None:
+            return None
+        for cell in pair:
