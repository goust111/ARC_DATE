+    counts = {quad: 0 for quad in QUADS}
+
+    active_count = RNG.randint(*ACTIVE_QUADRANT_RANGE)
+    for quad in RNG.sample(list(QUADS), active_count):
+        counts[quad] = RNG.randint(1, SEEDS_PER_QUADRANT_MAX)
+
