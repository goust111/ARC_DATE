+def _paste_non_bg(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    region = dst[top : top + patch.shape[0], left : left + patch.shape[1]]
+    mask = patch != BG
+    region[mask] = patch[mask]
