+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+DOOR_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+PATH_COLORS = [1, 2, 3, 4, 6, 7, 9]
+
+
