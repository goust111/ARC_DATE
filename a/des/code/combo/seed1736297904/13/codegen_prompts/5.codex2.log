def _build_room_bboxes(row_heights: list[int], col_widths: list[int]) -> tuple[dict[tuple[int, int], tuple[int, int, int, int]], list[int], list[int], int, int]:
    separator_rows = [row_heights[0]]
    separator_cols = []
    c = 0
