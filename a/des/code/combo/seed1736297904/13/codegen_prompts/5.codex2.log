+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _left_of(dr: int, dc: int) -> tuple[int, int]:
+    return -dc, dr
+
+
+def _spans(size: int, separators: list[int]) -> list[tuple[int, int]]:
+    bounds = [-1] + separators + [size]
+    spans = []
+    for i in range(len(bounds) - 1):
