+        return [random.choice(("free", "clipped"))]
+    if random.random() < 0.7:
+        seq = ["free", "clipped"] + [random.choice(("free", "clipped")) for _ in range(n - 2)]
+        random.shuffle(seq)
+        return seq
+    return [random.choice(("free", "clipped")) for _ in range(n)]
