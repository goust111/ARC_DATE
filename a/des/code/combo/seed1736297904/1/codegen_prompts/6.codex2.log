+        if cells is None:
+            return None
+        rng.shuffle(dot_colors)
+        for (r, c), color in zip(cells, dot_colors):
+            grid[r, c] = color
+        loop_coords = np.argwhere(spec["boundary"])
+        loop_coords[:, 0] += r0
+        loop_coords[:, 1] += c0
+        placed.append(
+            {
+                "coords": loop_coords.astype(int),
+                "count": spec["count"],
+            }
+        )
