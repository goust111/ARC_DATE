+        c0 = rng.choice(cols)
+        if blocked[r0 - 1 : r0 + bh + 1, c0 - 1 : c0 + bw + 1].any():
+            continue
+        coords = np.argwhere(boundary)
+        grid[r0 + coords[:, 0], c0 + coords[:, 1]] = color
+        _mark_box(blocked, r0, c0, r0 + bh - 1, c0 + bw - 1, pad=1)
+        return r0, c0
