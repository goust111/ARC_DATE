+def _sample_spaced_cells(
+    cells: list[tuple[int, int]], count: int, rng: random.Random
+) -> list[tuple[int, int]] | None:
+    if len(cells) < count:
+        return None
+    pool = list(cells)
+    rng.shuffle(pool)
+    blocked: set[tuple[int, int]] = set()
+    chosen: list[tuple[int, int]] = []
+    for cell in pool:
+        if cell in blocked:
+            continue
+        chosen.append(cell)
+        r, c = cell
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
