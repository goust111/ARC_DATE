+
+
+def _mark_box(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int) -> None:
+    h, w = mask.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
