+def _paint_mask(grid: np.ndarray, occupied: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> None:
+    h, w = mask.shape
+    patch = grid[r0 : r0 + h, c0 : c0 + w]
+    patch[mask] = int(color)
+    occupied[r0 : r0 + h, c0 : c0 + w] |= mask
