+        for _ in range(ROOM_PLACE_TRIES):
+            room_h = rng.randint(*ROOM_H_RANGE)
+            room_w = rng.randint(*ROOM_W_RANGE)
+            if h - room_h - 2 < 2 or w - room_w - 2 < 2:
