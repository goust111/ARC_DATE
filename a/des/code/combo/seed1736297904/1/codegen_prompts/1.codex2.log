  "type": "transform_in_place",
  "src": "bottom-aligned one-cell-wide vertical bars on the background; blue bars start chains and red bars may follow",
  "transform": "for each blue-started chain, rotate each reached vertical bar clockwise onto the shared baseline; the next red bar is reached when its column is exactly the current bar's column plus the current bar's height"
}
</annotation>
</reference_puzzle>

