+    out = g.copy()
+    for room in rooms:
+        fill_color = stripes[room["side"]]
+        for r, c in room["path"]:
+            out[r, c] = fill_color
+    return out
+
+
+# --------------- generator ---------------
+
+
+GRID_H_RANGE = (14, 24)
+GRID_W_RANGE = (14, 24)
+ROOM_H_RANGE = (4, 8)
+ROOM_W_RANGE = (4, 8)
+MAX_ROOMS = 5
+ROOM_PAD = 1
+ROOM_PLACE_TRIES = 80
+GEN_RETRIES = 400
+SIDES = ["top", "right", "bottom", "left"]
