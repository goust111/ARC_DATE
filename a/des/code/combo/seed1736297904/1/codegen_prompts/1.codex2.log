+            occ[sr0:sr1, sc0:sc1] = True
+            rooms.append(room)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    counts = Counter(int(v) for v in grid.ravel())
+    if counts[bg] <= max(counts[c] for c in counts if c != bg):
