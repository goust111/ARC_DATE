+    rooms = _find_rooms(g, bg, stripes)
+
+    out = g.copy()
+    for room in rooms:
+        fill_color = stripes[room["side"]]
+        for r, c in room["path"]:
+            out[r, c] = fill_color
+    return out
+
+
+# --------------- generator ---------------
+
+
+GRID_H_RANGE = (14, 24)
+GRID_W_RANGE = (14, 24)
