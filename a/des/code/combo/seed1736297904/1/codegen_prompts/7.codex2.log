+    c = 0
+    while c < w and int(grid[0, c]) != bg:
+        legend.append(int(grid[0, c]))
+        c += 1
+
+    assert 3 <= len(legend) <= 5
+    assert len(set(legend)) == len(legend)
+    if h > 1:
+        assert np.all(grid[1, : len(legend)] == bg)
+    return legend
+
