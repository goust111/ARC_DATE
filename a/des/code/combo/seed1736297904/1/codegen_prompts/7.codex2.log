+                    labels[rr - 1, cc] = cid
+                    q.append((rr - 1, cc))
+                if rr + 1 < h and bool(mask[rr + 1, cc]) and labels[rr + 1, cc] == -1:
+                    labels[rr + 1, cc] = cid
+                    q.append((rr + 1, cc))
+                if cc > 0 and bool(mask[rr, cc - 1]) and labels[rr, cc - 1] == -1:
