+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray], list[bool]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[np.ndarray] = []
+    touches_border: list[bool] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or labels[r, c] != -1:
+                continue
+
+            cid = len(comps)
+            q = deque([(r, c)])
+            labels[r, c] = cid
+            pts: list[tuple[int, int]] = []
+            border = False
+
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    border = True
+
+                if rr > 0 and bool(mask[rr - 1, cc]) and labels[rr - 1, cc] == -1:
+                    labels[rr - 1, cc] = cid
+                    q.append((rr - 1, cc))
+                if rr + 1 < h and bool(mask[rr + 1, cc]) and labels[rr + 1, cc] == -1:
+                    labels[rr + 1, cc] = cid
+                    q.append((rr + 1, cc))
+                if cc > 0 and bool(mask[rr, cc - 1]) and labels[rr, cc - 1] == -1:
+                    labels[rr, cc - 1] = cid
+                    q.append((rr, cc - 1))
+                if cc + 1 < w and bool(mask[rr, cc + 1]) and labels[rr, cc + 1] == -1:
+                    labels[rr, cc + 1] = cid
+                    q.append((rr, cc + 1))
+
+            comps.append(np.array(pts, dtype=int))
+            touches_border.append(border)
+
+    return labels, comps, touches_border
+
+
+def _region_adjacency(
+    fg_mask: np.ndarray,
+    fg_labels: np.ndarray,
+    bg_labels: np.ndarray,
+    n_fg: int,
+    n_bg: int,
+) -> tuple[list[set[int]], list[set[int]]]:
+    h, w = fg_mask.shape
+    fg_to_bg = [set() for _ in range(n_fg)]
+    bg_to_fg = [set() for _ in range(n_bg)]
+
+    def link(r1: int, c1: int, r2: int, c2: int) -> None:
+        if bool(fg_mask[r1, c1]) == bool(fg_mask[r2, c2]):
+            return
+        if bool(fg_mask[r1, c1]):
+            fid = int(fg_labels[r1, c1])
+            bid = int(bg_labels[r2, c2])
+        else:
+            fid = int(fg_labels[r2, c2])
+            bid = int(bg_labels[r1, c1])
+        fg_to_bg[fid].add(bid)
+        bg_to_fg[bid].add(fid)
+
+    for r in range(h):
+        for c in range(w):
+            if r + 1 < h:
+                link(r, c, r + 1, c)
+            if c + 1 < w:
+                link(r, c, r, c + 1)
+
+    return fg_to_bg, bg_to_fg
+
+
+def _foreground_depths(fg_mask: np.ndarray) -> tuple[list[int], list[np.ndarray]]:
+    fg_labels, fg_comps, _ = _label_components(fg_mask)
+    if not fg_comps:
+        return [], []
+
+    bg_labels, bg_comps, bg_border = _label_components(~fg_mask)
+    fg_to_bg, bg_to_fg = _region_adjacency(
+        fg_mask,
+        fg_labels,
+        bg_labels,
+        len(fg_comps),
+        len(bg_comps),
+    )
+
+    fg_depth = [-1] * len(fg_comps)
+    bg_level: list[int | None] = [None] * len(bg_comps)
+    q = deque[tuple[str, int]]()
+
+    for bid, touches_border in enumerate(bg_border):
+        if touches_border:
+            bg_level[bid] = -1
+            q.append(("bg", bid))
+
+    while q:
+        kind, idx = q.popleft()
+        if kind == "bg":
+            assert bg_level[idx] is not None
+            for fid in bg_to_fg[idx]:
+                depth = int(bg_level[idx]) + 1
+                if fg_depth[fid] == -1:
+                    fg_depth[fid] = depth
+                    q.append(("fg", fid))
+                else:
+                    assert fg_depth[fid] == depth
+        else:
+            for bid in fg_to_bg[idx]:
+                level = int(fg_depth[idx])
+                if bg_level[bid] is None:
+                    bg_level[bid] = level
+                    q.append(("bg", bid))
+                else:
+                    assert bg_level[bid] == level
+
+    assert all(depth >= 0 for depth in fg_depth)
+    return fg_depth, fg_comps
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor nested same-color foreground regions by topological depth using the
+    horizontal legend in the top-left corner, then erase that legend to bg.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg = _mode_color(g)
+    legend = _read_legend(g, bg)
+
+    work = g.copy()
+    work[0, : len(legend)] = bg
+    fg_mask = work != bg
+    if not np.any(fg_mask):
+        return work
+
+    depths, comps = _foreground_depths(fg_mask)
+    out = work.copy()
+
+    for depth, pts in zip(depths, comps):
+        assert depth < len(legend)
+        out[pts[:, 0], pts[:, 1]] = int(legend[depth])
+
+    return out
+
+
+def _tight_crop(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    assert len(rows) > 0
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1].copy()
+
+
+def _add_outer_bars(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    h, w = mask.shape
+    pads = {
+        "top": rng.randint(0, 2),
+        "bottom": rng.randint(0, 2),
+        "left": rng.randint(0, 2),
+        "right": rng.randint(0, 2),
+    }
+    candidates = [side for side, extent in pads.items() if extent > 0]
+    if not candidates:
+        return mask.copy()
+
+    canvas = np.zeros(
+        (h + pads["top"] + pads["bottom"], w + pads["left"] + pads["right"]),
+        dtype=bool,
+    )
+    r0 = pads["top"]
+    c0 = pads["left"]
+    canvas[r0 : r0 + h, c0 : c0 + w] = mask
+
+    rng.shuffle(candidates)
+    n_bars = rng.randint(0, min(2, len(candidates)))
+    for side in candidates[:n_bars]:
+        if side in ("top", "bottom"):
+            extent = pads[side]
+            min_span = max(2, w // 3)
+            span = rng.randint(min_span, w)
+            start = rng.randint(0, w - span)
+            cc0 = c0 + start
+            cc1 = cc0 + span
+            if side == "top":
+                canvas[:extent, cc0:cc1] = True
+            else:
+                canvas[r0 + h :, cc0:cc1] = True
+        else:
+            extent = pads[side]
+            min_span = max(2, h // 3)
+            span = rng.randint(min_span, h)
+            start = rng.randint(0, h - span)
+            rr0 = r0 + start
+            rr1 = rr0 + span
+            if side == "left":
+                canvas[rr0:rr1, :extent] = True
