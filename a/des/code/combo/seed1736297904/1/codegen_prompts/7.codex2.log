+    q = deque[tuple[int, int]]()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not bool(fg_mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not bool(fg_mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        if r > 0 and not bool(fg_mask[r - 1, c]) and not bool(seen[r - 1, c]):
+            seen[r - 1, c] = True
+            q.append((r - 1, c))
+        if r + 1 < h and not bool(fg_mask[r + 1, c]) and not bool(seen[r + 1, c]):
