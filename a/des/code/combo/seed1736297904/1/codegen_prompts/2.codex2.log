+            coords.append((r, c))
+            for dr, dc in DIR4:
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
