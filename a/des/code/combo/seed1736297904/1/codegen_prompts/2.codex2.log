+SHAPE_LIBRARY = [
+    _arr([[1]]),
+    _arr([[1, 1]]),
+    _arr([[1, 1, 1]]),
+    _arr([[1, 0], [1, 1]]),
+    _arr([[1, 1], [1, 1]]),
