+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    starts = np.argwhere(mask)
+    for sr, sc in starts:
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords = []
+        while stack:
+            r, c = stack.pop()
