            _reserve(reserved_in, r0, c0, r0 + 2, c0 + 2, PLACEMENT_PAD)
            _reserve(reserved_out, out_r0, out_c0, out_r0 + 2, out_c0 + 2, PLACEMENT_PAD)
            objects.append(
                {
