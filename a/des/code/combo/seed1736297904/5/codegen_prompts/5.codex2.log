+
+def _abstract_neighbors(node: tuple[int, int], gh: int, gw: int) -> list[tuple[int, int]]:
+    r, c = node
+    out = []
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < gh and 0 <= nc < gw:
+            out.append((nr, nc))
+    return out
