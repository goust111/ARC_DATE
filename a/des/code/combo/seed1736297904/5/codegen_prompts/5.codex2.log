+            leaf = random.choice(leaves)
+            options = [nb for nb in _abstract_neighbors(leaf, gh, gw) if nb not in nodes]
+            if options:
+                extra = random.choice(options)
+                edges.append((leaf, extra))
+                nodes.add(extra)
