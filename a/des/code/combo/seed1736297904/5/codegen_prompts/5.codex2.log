+    nodes = set(path)
+    edges = [(path[i], path[i + 1]) for i in range(len(path) - 1)]
+    roots = path[1:-1]
+    random.shuffle(roots)
+    target_branches = random.randint(1, min(2, len(roots)))
+    added = 0
+    for root in roots:
