+                ok = False
+                break
+            arm_len = random.randint(1, limit)
+            prev = center
+            for step in range(1, arm_len + 1):
+                node = (center[0] + dr * step, center[1] + dc * step)
+                edges.append((prev, node))
+                nodes.add(node)
+                prev = node
+            leaves.append(prev)
