+        nodes = {center}
+        edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+        ok = True
+        leaves: list[tuple[int, int]] = []
+        for dr, dc in arm_dirs:
+            limit = 0
+            r, c = center
+            while 0 <= r + dr * (limit + 1) < gh and 0 <= c + dc * (limit + 1) < gw and limit < 3:
+                limit += 1
