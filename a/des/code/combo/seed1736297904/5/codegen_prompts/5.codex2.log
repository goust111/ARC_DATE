+        branch = [root, cur]
+        used = set(nodes)
+        used.add(cur)
+        for _ in range(branch_len - 1):
+            options = [nb for nb in _abstract_neighbors(cur, gh, gw) if nb not in used]
+            if not options:
+                break
+            cur = random.choice(options)
+            branch.append(cur)
+            used.add(cur)
+        for a, b in zip(branch, branch[1:], strict=False):
+            edges.append((a, b))
+            nodes.add(b)
