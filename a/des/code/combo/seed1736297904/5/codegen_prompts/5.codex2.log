+def _embed_graph(nodes: set[tuple[int, int]], edges: list[tuple[tuple[int, int], tuple[int, int]]]):
+    rows = [r for r, _ in nodes]
+    cols = [c for _, c in nodes]
+    rmin, rmax = min(rows), max(rows)
