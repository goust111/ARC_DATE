+def _make_source_pattern(h: int, w: int, colors: list[int]) -> np.ndarray:
+    mode = RNG.choice(("h_stripes", "v_stripes", "blocks", "voronoi", "checker"))
+    if mode == "h_stripes":
+        grid = _source_stripes(h, w, colors, horizontal=True)
+    elif mode == "v_stripes":
