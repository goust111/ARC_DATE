+    if len(np.unique(grid)) < 2:
+        grid[0, 0] = colors[0]
+        grid[-1, -1] = colors[1]
+    return grid
+
+
+def _hole_mask_rectangles(h: int, w: int) -> np.ndarray:
+    holes = np.zeros((h, w), dtype=bool)
