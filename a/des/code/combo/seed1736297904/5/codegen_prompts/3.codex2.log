+    cuts = sorted(RNG.sample(range(1, total), parts - 1))
+    points = [0] + cuts + [total]
+    return [int(points[i + 1] - points[i]) for i in range(parts)]
+
+
+def _nonrepeating_colors(length: int, colors: list[int]) -> list[int]:
+    out: list[int] = []
+    for _ in range(length):
