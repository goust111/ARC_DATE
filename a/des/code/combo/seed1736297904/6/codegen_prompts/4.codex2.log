+            rendered = _render_frames((height, width), tentative)
+            if _rectangles_for_color(rendered, GRAY) != tentative:
+                continue
+
+            rectangles = tentative
+            used_rows.update((r0, r1))
+            used_cols.update((c0, c1))
+            corner_points.update(_corners(rect))
