+            by_signature.setdefault(sig, []).append(cells)
+
+        signatures = sorted(by_signature)
+        if len(signatures) < 2:
+            continue
+        if max(len(sig) for sig in signatures) < 2:
+            continue
+
+        chosen_signatures = _choose_marker_signatures(signatures)
