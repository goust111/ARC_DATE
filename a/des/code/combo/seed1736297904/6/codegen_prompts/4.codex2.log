+    out[g == gray_color] = gray_color
+
+    passable = g != gray_color
+    for cells in _components(passable):
+        if _touches_boundary(cells, g.shape):
+            continue
+        sig = _region_signature(cells, rectangles)
+        fill_color = region_to_color.get(sig, BLACK)
+        for r, c in cells:
+            out[r, c] = fill_color
+
+    return out
