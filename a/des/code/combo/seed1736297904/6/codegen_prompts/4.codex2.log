+
+def _point_on_border(point: tuple[int, int], rect: tuple[int, int, int, int]) -> bool:
+    r, c = point
+    r0, c0, r1, c1 = rect
+    return ((r == r0 or r == r1) and c0 <= c <= c1) or ((c == c0 or c == c1) and r0 <= r <= r1)
