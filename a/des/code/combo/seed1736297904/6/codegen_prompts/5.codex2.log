+FRAME = 5
+MARKER = 8
+INNER_H = 2
+SIDES = ("top", "bottom", "left", "right")
+USABLE_COLORS = tuple(c for c in range(10) if c not in (BG, FRAME, MARKER))
+GEN_ATTEMPTS = 400
