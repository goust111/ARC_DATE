+def _apply_mapping(region: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    base = np.array(region, copy=True)
+    out = np.array(region, copy=True)
+    for src, dst in mapping.items():
+        out[base == int(src)] = int(dst)
