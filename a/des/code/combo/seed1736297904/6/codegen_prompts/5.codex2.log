+def _main_bbox(g: np.ndarray, filters: list[dict]) -> tuple[int, int, int, int]:
+    keep = g != BG
+    for filt in filters:
+        r0, c0, r1, c1 = filt["outer_bbox"]
+        keep[r0 : r1 + 1, c0 : c1 + 1] = False
+        mr, mc = filt["marker"]
+        keep[mr, mc] = False
