+def _repeat_tile(tile: np.ndarray, h: int, w: int) -> np.ndarray:
+    th, tw = tile.shape
+    out = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = int(tile[r % th, c % tw])
+    return out
