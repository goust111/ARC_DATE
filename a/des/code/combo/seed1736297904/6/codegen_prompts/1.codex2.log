+    row_spans = [(full_rows[i] + 1, full_rows[i + 1] - 1) for i in range(len(full_rows) - 1)]
+    col_spans = [(full_cols[i] + 1, full_cols[i + 1] - 1) for i in range(len(full_cols) - 1)]
+    if not row_spans or not col_spans:
