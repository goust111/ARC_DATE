+def _layout_options(count: int) -> list[tuple[int, int]]:
+    opts = {(1, count), (count, 1)}
+    for rows in range(2, count + 1):
+        if count % rows == 0:
+            opts.add((rows, count // rows))
+    return sorted(opts)
