+def _render_window(labels: np.ndarray, row_sizes: list[int], col_sizes: list[int]) -> np.ndarray:
+    rows, cols = map(int, labels.shape)
+    h = sum(row_sizes) + rows + 1
+    w = sum(col_sizes) + cols + 1
+    grid = np.zeros((h, w), dtype=int)
