+
+_RAW_SHAPES = [
+    _shape(["11", "10"]),
+    _shape(["11", "01"]),
+    _shape(["111"]),
+    _shape(["1", "1", "1"]),
+    _shape(["11", "11"]),
+    _shape(["111", "100"]),
+    _shape(["111", "001"]),
+    _shape(["100", "111"]),
+    _shape(["001", "111"]),
+    _shape(["111", "010"]),
+    _shape(["010", "111"]),
+    _shape(["10", "11", "10"]),
+    _shape(["01", "11", "01"]),
+    _shape(["110", "011"]),
+    _shape(["011", "110"]),
+    _shape(["11", "10", "10"]),
+    _shape(["11", "01", "01"]),
+    _shape(["1111"]),
+    _shape(["1", "1", "1", "1"]),
+]
