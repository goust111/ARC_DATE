+_RAW_SHAPES = [
+    _shape(["11", "10"]),
+    _shape(["11", "01"]),
+    _shape(["111"]),
+    _shape(["1", "1", "1"]),
+    _shape(["11", "11"]),
+    _shape(["111", "100"]),
+    _shape(["111", "001"]),
