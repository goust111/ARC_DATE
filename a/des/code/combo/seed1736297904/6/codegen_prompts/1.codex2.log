+        for base_r in range(r0, r1 - sh + 2):
+            for base_c in range(c0, c1 - sw + 2):
+                placed = [(base_r + dr, base_c + dc) for dr, dc in shape_pts]
+                if all(bool(target_mask[rr, cc]) for rr, cc in placed):
