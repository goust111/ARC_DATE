+    _shape(["110", "011"]),
+    _shape(["011", "110"]),
+    _shape(["11", "10", "10"]),
+    _shape(["11", "01", "01"]),
+    _shape(["1111"]),
+    _shape(["1", "1", "1", "1"]),
