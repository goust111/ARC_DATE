+
+BG = 0
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+UP, DOWN, LEFT, RIGHT = DIRS
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
