+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
