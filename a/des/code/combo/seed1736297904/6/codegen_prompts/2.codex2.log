+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = a
+    r1, c1 = b
+    dr = int(np.sign(r1 - r0))
+    dc = int(np.sign(c1 - c0))
+    assert (dr == 0) ^ (dc == 0), "segment must be axis-aligned"
+    out = [(r0, c0)]
+    r, c = r0, c0
+    while (r, c) != (r1, c1):
+        r += dr
+        c += dc
+        out.append((r, c))
+    return out
+
