+        for center, head in (cells, cells[::-1]):
+            dr = head[0] - center[0]
+            dc = head[1] - center[1]
+            assert (dr, dc) in DIRS
+            spacer = (center[0] - dr, center[1] - dc)
+            anchor = (center[0] - 2 * dr, center[1] - 2 * dc)
