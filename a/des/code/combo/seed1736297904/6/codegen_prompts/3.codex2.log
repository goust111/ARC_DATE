+def _shadow_mask(
+    shape: tuple[int, int], ground_row: int, obj: dict[str, int], direction: int
+) -> np.ndarray | None:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for dr in range(obj["h"]):
+        rr = ground_row + 1 + dr
+        cc0 = obj["c0"] + direction * dr
+        cc1 = cc0 + obj["w"]
+        if rr >= h or cc0 < 0 or cc1 > w:
