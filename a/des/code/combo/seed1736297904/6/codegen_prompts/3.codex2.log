+    base = np.zeros(n, dtype=int)
+    for i in range(1, n):
+        base[i] = base[i - 1] + widths[i - 1] + gaps[i - 1]
+
+    if direction == -1:
+        required_shift = int(max(0, np.max((heights - 1) - base)))
+    else:
+        required_shift = 0
