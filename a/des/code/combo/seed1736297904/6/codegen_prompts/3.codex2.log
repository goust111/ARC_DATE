+    grid_shape = (top_space + 1 + bottom_space, width)
+    colors = _RNG.choice(np.array(OBJECT_PALETTE, dtype=int), size=n_objects, replace=False)
+
+    objects = []
+    for c0, w, h, color in zip(c0s, widths, heights, colors):
+        objects.append(
+            {
+                "r0": ground_row - int(h),
+                "c0": int(c0),
+                "h": int(h),
+                "w": int(w),
+                "color": int(color),
+            }
+        )
