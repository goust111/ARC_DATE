+
+def _sample_cross_pair(h: int, w: int) -> tuple[dict, dict] | None:
+    for _ in range(200):
+        rh = random.randint(4, h - 5)
+        cv = random.randint(4, w - 5)
+
+        left_max = min(6, cv - 1)
+        right_max = min(6, w - 2 - cv)
