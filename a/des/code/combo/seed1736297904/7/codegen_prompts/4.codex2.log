+        occupied_paths |= _path_cells_for_mode(spec["a"], spec["b"], spec["mode"])
+        blocked_points |= {spec["a"], spec["b"]}
+
+    random.shuffle(specs)
+    colors = random.sample(PALETTE, len(specs))
