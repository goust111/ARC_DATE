+    if a[0] == b[0] or a[1] == b[1]:
+        coords = tuple(_straight_coords(a, b))
+        assert not any(cell in walls for cell in coords), "straight pipe cannot cross a wall"
+        return [
+            {
+                "mode": "line",
+                "coords": coords,
+                "coord_set": set(coords),
+                "corner": None,
+            }
+        ]
