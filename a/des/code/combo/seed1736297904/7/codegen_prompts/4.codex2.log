+
+    best_selected: list[dict] | None = None
+    best_score: tuple | None = None
+
+    for choice in product(*ranges):
+        selected = [options[i][choice[i]] for i in range(len(options))]
+        valid = True
+        unique_free = 0
+        occupied_unchosen = 0
