+def _build_input(
+    h: int,
+    w: int,
+    specs: list[dict],
+    colors: list[int],
+    walls: set[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    for r, c in walls:
