+        chosen_mode = random.choice(("hv", "vh"))
+        other_mode = "vh" if chosen_mode == "hv" else "hv"
+        chosen = tuple(_l_coords(a, b, chosen_mode))
+        other = tuple(_l_coords(a, b, other_mode))
