+    blocked_points: set[tuple[int, int]],
+    axis: str,
+) -> dict | None:
+    for _ in range(300):
+        if axis == "row":
+            r = random.randint(1, h - 2)
+            c1 = random.randint(1, w - 6)
+            c2 = random.randint(c1 + 4, min(w - 2, c1 + 8))
+            a, b = (r, c1), (r, c2)
+            cells = set(_straight_coords(a, b))
+        else:
+            c = random.randint(1, w - 2)
