+        patch = np.zeros((h, w), dtype=int)
+        cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+        locator_cell = random.choice(cells)
+
+        n_colors = 2 if random.random() < 0.5 else 3
+        body_colors = random.sample(body_pool, n_colors - 1)
