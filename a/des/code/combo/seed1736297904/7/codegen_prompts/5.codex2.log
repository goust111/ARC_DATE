    top_margin = random.randint(1, 2)
    bottom_margin = random.randint(1, 2)
    left_margin = random.randint(1, 2)
    right_margin = random.randint(1, 2)
    strip_a_h = max(int(p["patch"].shape[0]) for p in pieces) + random.randint(2, 4)
    strip_b_h = max(int(p["rotated_patch"].shape[0]) for p in pieces) + 2 + random.randint(2, 4)
    center_gap = random.randint(4, 7)
    h = top_margin + strip_a_h + center_gap + strip_b_h + bottom_margin
    w = left_margin + right_margin + sum(slot_sizes) + gap * (n - 1)
    if h > 30 or w > 30:
        return None

