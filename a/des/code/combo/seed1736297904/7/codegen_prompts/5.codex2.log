+
+BACKGROUND = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ["top", "right", "bottom", "left"]
+SIDE_TO_ROT_K = {
+    "top": 0,      # no rotation
+    "right": 3,    # clockwise 90 == ccw 270
+    "bottom": 2,   # 180
+    "left": 1,     # ccw 90
+}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = DIR4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
