+def _extract_piece(g: np.ndarray, coords: list[tuple[int, int]]) -> dict:
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+    counts = Counter(int(g[r, c]) for r, c in coords)
+    if len(counts) not in (2, 3):
