+
+def _components(mask: np.ndarray, *, connectivity: int) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    dirs = DIR4 if connectivity == 4 else DIR8
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in dirs:
+                    nr = int(cr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_side_from_marker(marker: tuple[int, int], shape: tuple[int, int]) -> str | None:
+    h, w = shape
+    centers = {
+        "top": (0, w // 2),
+        "right": (h // 2, w - 1),
+        "bottom": (h - 1, w // 2),
+        "left": (h // 2, 0),
+    }
+    for side, pos in centers.items():
+        if marker == pos:
+            return side
+    return None
+
