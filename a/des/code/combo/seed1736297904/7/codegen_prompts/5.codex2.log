+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if np.any(patch[1:-1, 1:-1] != BACKGROUND):
+        return None
+    if not np.all(patch[border] != BACKGROUND):
