+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in dirs:
