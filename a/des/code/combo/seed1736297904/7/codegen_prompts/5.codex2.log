+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if not np.all(out >= 0):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample after 300 attempts")

