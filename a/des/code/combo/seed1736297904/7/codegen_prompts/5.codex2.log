    zone_a_y = top_margin
    zone_b_y = top_margin + strip_a_h + center_gap
    cur = left_margin
    for i in range(n):
        piece = pieces[piece_order[i]]
        frame_piece = pieces[frame_order[i]]
        slot_w = int(slot_sizes[i])
        ph, pw = map(int, piece["patch"].shape)
