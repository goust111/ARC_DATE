+            {
+                "bbox": (r0, c0, r1, c1),
+                "shape": (r1 - r0 - 1, c1 - c0 - 1),
+                "frame_color": int(comp["color"]),
+                "marker_pos": (mr, mc),
+                "marker_color": marker_color,
+                "border": border,
+            }
+        )
+    frames.sort(key=lambda frame: frame["bbox"])
+    return frames
