+def _assign_frames(frames: list[dict], fragments: list[dict], arrangements: list[dict]) -> dict[int, int]:
+    assert len(fragments) == 2 * len(frames), "fragment count must equal twice the frame count"
+    candidates: list[list[int]] = []
+    for frame in frames:
