+def _frame_patch(inner_shape: tuple[int, int], marker_color: int) -> tuple[np.ndarray, int]:
+    h, w = inner_shape
+    patch = np.full((h + 2, w + 2), BG, dtype=int)
+    patch[0, :] = FRAME
+    patch[-1, :] = FRAME
+    patch[:, 0] = FRAME
+    patch[:, -1] = FRAME
