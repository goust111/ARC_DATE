+def _build_pair_library() -> list[dict]:
+    library: list[dict] = []
+    for h in range(2, 7):
+        for w in range(2, 7):
+            area = h * w
+            if area > 12:
+                continue
+            full_bits = (1 << area) - 1
+            for bits in range(1, full_bits):
+                count = bits.bit_count()
+                other = area - count
+                if count > 6 or other > 6 or count < 2 or other < 2:
+                    continue
+                comp_bits = full_bits ^ bits
+                if bits > comp_bits:
+                    continue
+                mask_a = _mask_from_bits(bits, h, w)
+                mask_b = ~mask_a
+                if not (_touches_all_sides(mask_a) and _touches_all_sides(mask_b)):
+                    continue
+                if not (_is_connected(mask_a) and _is_connected(mask_b)):
+                    continue
+                library.append(
+                    {
+                        "shape": (h, w),
+                        "bits": bits,
+                        "mask_a": mask_a,
+                        "mask_b": mask_b,
+                    }
+                )
+    assert library, "pair library must not be empty"
+    return library
+
