+PAIR_LIBRARY = _build_pair_library()
+PAIRS_BY_SHAPE: dict[tuple[int, int], list[dict]] = {}
+for item in PAIR_LIBRARY:
+    PAIRS_BY_SHAPE.setdefault(item["shape"], []).append(item)
