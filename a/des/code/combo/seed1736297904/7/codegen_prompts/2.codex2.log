+def _mask_from_bits(bits: int, h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    for idx in range(h * w):
+        if bits & (1 << idx):
+            mask[idx // w, idx % w] = True
+    return mask
