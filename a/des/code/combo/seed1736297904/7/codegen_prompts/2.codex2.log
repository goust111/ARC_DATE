+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 8
+FRAME = 5
+PIECE_COLORS = [0, 1, 2, 3, 4, 6, 7, 9]
+GEN_RETRIES = 300
+GRID_MIN = 18
+GRID_MAX = 30
+PAIR_COUNT_CHOICES = (2, 3, 4)
+PLACEMENT_PADDING = 1
+PLACEMENT_ATTEMPTS = 400
