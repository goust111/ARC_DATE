+def _frame_patch(inner_shape: tuple[int, int], marker_color: int) -> tuple[np.ndarray, int]:
+    h, w = inner_shape
+    patch = np.full((h + 2, w + 2), BG, dtype=int)
+    patch[0, :] = FRAME
+    patch[-1, :] = FRAME
+    patch[:, 0] = FRAME
+    patch[:, -1] = FRAME
+    marker_c = random.randint(0, w + 1)
+    patch[0, marker_c] = marker_color
+    return patch, marker_c
