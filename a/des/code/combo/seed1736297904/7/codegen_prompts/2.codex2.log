+                mask_a, off_a = _crop_mask(rect_mask_a)
+                mask_b, off_b = _crop_mask(rect_mask_b)
+                library.append(
+                    {
+                        "shape": (h, w),
+                        "bits": bits,
+                        "mask_a": mask_a,
+                        "mask_b": mask_b,
+                        "off_a": off_a,
+                        "off_b": off_b,
+                    }
