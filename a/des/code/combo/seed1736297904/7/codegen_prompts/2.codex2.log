+
+
+def _fragment_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.full(mask.shape, BG, dtype=int)
+    patch[mask] = color
+    return patch
+
+
+def _frame_patch(inner_shape: tuple[int, int], marker_color: int) -> tuple[np.ndarray, int]:
+    h, w = inner_shape
