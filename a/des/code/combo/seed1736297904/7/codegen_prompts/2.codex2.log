+    for h in range(2, 7):
+        for w in range(2, 7):
+            area = h * w
+            if area > 12:
+                continue
+            full_bits = (1 << area) - 1
+            for bits in range(1, full_bits):
+                count = bits.bit_count()
+                other = area - count
+                if count > 6 or other > 6 or count < 2 or other < 2:
