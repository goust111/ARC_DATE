+def _room_index(row: int, col: int, ncols: int) -> int:
+    return row * ncols + col
+
+
+def _direction_between(src: dict, dst: dict) -> str:
+    if dst["row"] == src["row"] and dst["col"] == src["col"] - 1:
+        return "left"
+    if dst["row"] == src["row"] and dst["col"] == src["col"] + 1:
+        return "right"
+    if dst["col"] == src["col"] and dst["row"] == src["row"] - 1:
+        return "up"
+    return "down"
+
