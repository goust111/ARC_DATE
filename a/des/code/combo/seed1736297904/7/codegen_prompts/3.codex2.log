+        if spec["side"] == "left":
+            near = left
+            far = right
+            move = (0, height)
+        else:
+            near = right
+            far = left
+            move = (0, -height)
+
+    else:
+        width = int(spec["width"])
+        top_h = int(spec["top_h"])
+        bottom_h = int(spec["bottom_h"])
+        total_h = top_h + 1 + bottom_h
+        if not (0 <= r0 and r0 + total_h <= h and 0 <= c0 and c0 + width <= w):
+            return None
