+
+def _component_from(grid: np.ndarray, start: tuple[int, int], color: int) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in seen:
+                continue
+            if int(grid[nr, nc]) != int(color):
+                continue
+            seen.add((nr, nc))
+            stack.append((nr, nc))
+    return seen
+
