+        crack_c = c0 + left_w
+        left = _rect_cells(r0, c0, height, left_w)
+        right = _rect_cells(r0, crack_c + 1, height, right_w)
+        marker = (r0 + int(spec["align"]), c0 - int(spec["marker_gap"]))
