+                    max_c0 = w - total_w - height
+                else:
+                    min_c0 = height
+                    max_c0 = w - total_w - int(spec["marker_gap"])
+                min_r0 = 0
+                max_r0 = h - height
+            else:
+                width = int(spec["width"])
+                total_h = int(spec["top_h"]) + 1 + int(spec["bottom_h"])
