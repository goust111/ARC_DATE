+        crack_r = r0 + top_h
+        top = _rect_cells(r0, c0, top_h, width)
+        bottom = _rect_cells(crack_r + 1, c0, bottom_h, width)
+        marker = (r0 - int(spec["marker_gap"]), c0 + int(spec["align"]))
