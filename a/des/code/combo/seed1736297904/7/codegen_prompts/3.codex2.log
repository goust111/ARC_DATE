+def _first_hit(
+    grid: np.ndarray, r: int, c: int, dr: int, dc: int
+) -> tuple[int, tuple[int, int], int] | None:
+    h, w = grid.shape
+    rr, cc = r + dr, c + dc
+    dist = 1
+    while 0 <= rr < h and 0 <= cc < w:
+        value = int(grid[rr, cc])
+        if value == MAGENTA:
+            rr += dr
+            cc += dc
+            dist += 1
+            continue
+        if value != BG:
+            return dist, (rr, cc), value
+        rr += dr
+        cc += dc
+        dist += 1
+    return None
+
