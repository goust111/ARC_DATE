+
+def _random_sprite_mask(interior_h: int, interior_w: int) -> np.ndarray:
+    box_h = random.randint(2, min(SPRITE_BOX_MAX, interior_h))
+    box_w = random.randint(2, min(SPRITE_BOX_MAX, interior_w))
