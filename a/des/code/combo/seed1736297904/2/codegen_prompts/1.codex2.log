  81: def main(grid: np.ndarray) -> np.ndarray:
  82:     """
  83:     Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.
  84: 
  85:     Input structure
  86:     - The background is the dominant color.
  87:     - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.
  88:     - For every control color, there is exactly one separate solid rectangular object of that color.
  89: 
  90:     Rule
  91:     - Match each sprite to the unique solid rectangle whose color equals the sprite center.
  92:     - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.
  93:     - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.
  94: 
  95:     Key insight
  96:     The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.
  97:     """
  98:     g = np.asarray(grid, dtype=int)
  99:     assert g.ndim == 2
 100:     h, w = g.shape
 101:     assert h >= 3 and w >= 3
 102: 
 103:     bg = int(get_bg(g))
 104:     sprites = _find_sprites(g, bg)
 105:     assert sprites, "expected at least one 3x3 control-center sprite"
 106: 
 107:     out = g.copy()
 108:     for sprite_bbox, patch, center in sprites:
 109:         targets = _solid_rectangles(g, bg, center)
 110:         assert len(targets) == 1, "each control color must have one solid rectangular target"
 111:         target_bbox = targets[0]["bbox"]
 112:         assert not _intersects(sprite_bbox, target_bbox), "sprite and target must start separate"
 113: 
 114:         dr, dc = _direction_to_target(sprite_bbox, target_bbox)
 115:         r, c = sprite_bbox[0], sprite_bbox[1]
