+            & (sprite_coords[:, 0] < r1)
+            & (sprite_coords[:, 1] > c0)
+            & (sprite_coords[:, 1] < c1)
+        )
+        sprite_coords = sprite_coords[inside]
+        assert len(sprite_coords) > 0, "sprite must have at least one pixel inside its frame"
