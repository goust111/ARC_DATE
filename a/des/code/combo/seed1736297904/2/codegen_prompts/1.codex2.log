+    if direction == "up":
+        shift = (-(max(rows) + 1 + clearance), 0)
+        dot = (min(rows) + shift[0], gap[1])
+    elif direction == "down":
+        shift = (frame_h + clearance - min(rows), 0)
+        dot = (max(rows) + shift[0], gap[1])
+    elif direction == "left":
