+def _parse_open_frame(coords: np.ndarray) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+
+    comp = {(int(r), int(c)) for r, c in coords}
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+
+    if len(comp) != len(border) - 1 or not comp.issubset(border):
+        return None
+
+    missing = list(border - comp)
+    if len(missing) != 1:
+        return None
+    gr, gc = missing[0]
+    if (gr in (r0, r1)) and (gc in (c0, c1)):
+        return None
+
+    if gr == r0:
+        direction = "up"
+    elif gr == r1:
+        direction = "down"
+    elif gc == c0:
+        direction = "left"
+    elif gc == c1:
+        direction = "right"
+    else:
