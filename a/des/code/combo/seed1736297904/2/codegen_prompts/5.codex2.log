+from __future__ import annotations
+
+import random
+from collections import deque
+from itertools import product
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 8
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 9)
