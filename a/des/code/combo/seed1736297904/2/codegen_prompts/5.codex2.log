+            continue
+        if bool(mask[r0 : r1 + 1, c0 : c1 + 1].all()):
+            continue
+        return mask
+    return None
+
+
+def _colorize_sprite(mask: np.ndarray, colors: list[int]) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
