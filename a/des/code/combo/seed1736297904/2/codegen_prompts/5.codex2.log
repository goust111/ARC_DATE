+        frames.append((r0, c0, r1, c1))
+    return frames
+
+
+def _detect_frames(grid: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int, int]]]:
+    best_color = None
+    best_frames: list[tuple[int, int, int, int]] = []
+    for value in np.unique(grid):
+        color = int(value)
+        if color == bg:
+            continue
