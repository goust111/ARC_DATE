+) -> list[tuple[int, int]]:
+    h, w = occ.shape
+    ph, pw = patch_shape
+    positions: list[tuple[int, int]] = []
+    for r0 in range(1, h - ph):
+        for c0 in range(max(1, min_col), w - pw):
+            if occ[r0 - 1 : r0 + ph + 1, c0 - 1 : c0 + pw + 1].any():
+                continue
+            positions.append((r0, c0))
+    return positions
