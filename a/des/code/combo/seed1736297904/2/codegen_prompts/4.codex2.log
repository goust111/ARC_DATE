+    row_scan: list[int],
+    grey_col: int,
+    color_col: int,
+    inner_col: int | None,
+) -> tuple[int, np.ndarray, dict[int, int], int] | None:
+    rows: list[int] = []
+    colors: list[int] = []
+    grey = None
+    for r in row_scan:
+        gv = int(grid[r, grey_col])
+        cv = int(grid[r, color_col])
+        if gv == bg or cv == bg or gv == cv:
+            break
+        if grey is None:
+            grey = gv
+        elif gv != grey:
+            break
+        rows.append(r)
+        colors.append(cv)
