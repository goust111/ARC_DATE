+def _walk_path(cells: set[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:
+    ordered = [start]
+    prev = None
+    cur = start
+    while True:
+        nxt = [nbr for nbr in _neighbors4(*cur) if nbr in cells and nbr != prev]
+        if not nxt:
