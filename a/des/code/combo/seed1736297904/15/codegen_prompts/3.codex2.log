+    comp[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    bg_mask = sub == int(bg)
+    seen = np.zeros(sub.shape, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    h, w = sub.shape
+    for r in range(h):
