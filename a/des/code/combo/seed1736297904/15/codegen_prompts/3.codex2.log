+    used: set[int] = set()
+    out: dict[int, int] = {}
+
+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        li = order[pos]
+        for ki in compat[li]:
+            if ki in used:
+                continue
+            used.add(ki)
+            out[li] = ki
+            if dfs(pos + 1):
