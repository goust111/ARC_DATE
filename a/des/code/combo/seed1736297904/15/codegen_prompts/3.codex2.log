+        while len(cells) < target and frontier:
+            idx = int(rng.integers(0, len(frontier)))
+            cell = list(frontier)[idx]
+            frontier.remove(cell)
+            cells.add(cell)
+            for dr, dc in DIRS4:
+                nr, nc = cell[0] + dr, cell[1] + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
