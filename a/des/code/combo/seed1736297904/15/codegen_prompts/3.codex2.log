+        mask = _cropped_mask(coords)
+        if min(mask.shape) < 2:
+            continue
+        if int(mask.sum()) == int(mask.size):
+            continue
+        if _has_hole(mask):
+            continue
+        if len(_rotation_variants(mask)) < 2:
+            continue
+        return mask
+    raise RuntimeError("failed to generate a valid key shape")
