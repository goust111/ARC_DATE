+    for patch, (r, c) in zip(key_patches, top_places):
+        _paint_patch(inp[:top_h], patch, r, c, bg)
+    for patch, (r, c), hole_coords, color in zip(lock_patches, bottom_places, hole_offsets, lock_colors):
