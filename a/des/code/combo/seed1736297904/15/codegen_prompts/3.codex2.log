+def _build_lock_patch(hole_mask: np.ndarray, color: int, bg: int) -> tuple[np.ndarray, np.ndarray]:
+    h, w = hole_mask.shape
+    patch = np.full((h + 2, w + 2), int(bg), dtype=int)
