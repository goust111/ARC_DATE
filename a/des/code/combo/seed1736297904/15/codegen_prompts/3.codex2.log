+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _cropped_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _rotation_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
+        if key not in seen:
+            seen.add(key)
+            variants.append(rot)
+    return variants
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min((tuple(map(int, rot.shape)), rot.tobytes()) for rot in _rotation_variants(mask))
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
