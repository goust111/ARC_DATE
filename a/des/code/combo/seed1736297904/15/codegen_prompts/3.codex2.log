+def _build_lock_patch(hole_mask: np.ndarray, color: int, bg: int) -> tuple[np.ndarray, np.ndarray]:
+    h, w = hole_mask.shape
+    patch = np.full((h + 2, w + 2), int(bg), dtype=int)
+    patch[0, :] = int(color)
+    patch[-1, :] = int(color)
+    patch[:, 0] = int(color)
+    patch[:, -1] = int(color)
+    inner = patch[1:-1, 1:-1]
+    inner[~hole_mask] = int(color)
