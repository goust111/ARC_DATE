+def _paint_patch(target: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    sub = target[top : top + h, left : left + w]
+    mask = patch != int(bg)
+    sub[mask] = patch[mask]
