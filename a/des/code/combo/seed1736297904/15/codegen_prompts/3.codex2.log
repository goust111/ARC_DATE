+    if n_pairs >= 2 and (all(same_flags) or not any(same_flags)):
+        flip_idx = int(rng.integers(0, n_pairs))
+        same_flags[flip_idx] = not same_flags[flip_idx]
+    key_colors: list[int] = []
+    for i in range(n_pairs):
