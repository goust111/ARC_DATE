+    cr0, cc0, cr1, cc1 = core
+    min_h = max(MIN_RECT_SIDE, cr1 - cr0 + 1)
+    min_w = max(MIN_RECT_SIDE, cc1 - cc0 + 1)
+    max_h = min(MAX_RECT_SIDE, height)
+    max_w = min(MAX_RECT_SIDE, width)
+    if min_h > max_h or min_w > max_w:
+        return None
