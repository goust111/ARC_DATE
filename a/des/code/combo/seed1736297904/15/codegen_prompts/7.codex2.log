+
+    counts = _choose_counts(rng, bboxes, tie_case)
+    if counts is None:
+        return None
+
+    palette = list(range(10))
+    bg = rng.choice(palette)
+    palette.remove(bg)
+    colors = rng.sample(palette, n_rects)
