+def _scene_to_input(shape: tuple[int, int], bg: int, objects: list[dict[str, object]]) -> np.ndarray:
+    grid = np.full(shape, int(bg), dtype=int)
+    for obj in objects:
+        if "color" not in obj:
+            continue
+        for r, c in obj["points"]:  # type: ignore[misc]
+            grid[int(r), int(c)] = int(obj["color"])
+    return grid
