+    if any(len(group) == 0 for group in groups.values()):
+        return None
+
+    cover_map: dict[tuple[int, int], set[str]] = {}
+    for cell in cells:
+        cover_map[cell] = {
+            name
+            for name, group_cells in groups.items()
+            if cell in group_cells
