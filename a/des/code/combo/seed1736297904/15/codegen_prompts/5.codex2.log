+        for r0 in range(min_r, max_r - box_h + 2):
+            for c0 in range(min_c, max_c - box_w + 2):
+                bbox = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+                if all(not _boxes_too_close(bbox, prev_bbox) for _prev_idx, prev_bbox in placed):
