+FRAME_COLOR = 5
+GRID_HEIGHT_RANGE = (14, 26)
+GRID_WIDTH_RANGE = (16, 32)
+PALETTE_LEN_RANGE = (2, 4)
+FRAME_COUNT_BY_PALETTE = {2: (1, 4), 3: (1, 3), 4: (1, 3)}
+MAX_GENERATION_ATTEMPTS = 400
