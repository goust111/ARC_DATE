def _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:
    H, W = shape
    if corner == "TL":
        return int(r), int(c)
    if corner == "TR":
        return int(r), int(W - 1 - c)
    if corner == "BL":
