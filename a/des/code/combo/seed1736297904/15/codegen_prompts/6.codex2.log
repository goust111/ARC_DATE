        if patch[0, 0] and not patch[n - 1, n - 1]:
            return "TL"
        if patch[n - 1, n - 1] and not patch[0, 0]:
            return "BR"
    if anti_ok:
        if patch[0, n - 1] and not patch[n - 1, 0]:
            return "TR"
        if patch[n - 1, 0] and not patch[0, n - 1]:
            return "BL"

