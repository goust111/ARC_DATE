+        for agent in agents:
+            if agent["done"]:
+                continue
+            nxt = _choose_next(
+                agent["curr"],
+                agent["prev"],
+                neighbors,
+                used_edges,
+            )
+            if nxt is None:
+                agent["done"] = True
+                agent["terminal"] = agent["curr"]
+            else:
