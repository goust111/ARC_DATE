+    return _normalize_component(pipe_rot, seeds_rot)
+
+
+def _build_chain_component() -> dict[str, object]:
+    root = (0, 0)
+    trunk_len = random.randint(2, 5)
+    child = (0, trunk_len)
+
+    root_side_dirs = [(-1, 0), (0, -1), (1, 0)]
