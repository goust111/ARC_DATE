+                "id": idx,
+                "color": color,
+                "curr": leaf,
+                "prev": None,
+                "done": False,
+                "terminal": None,
+            }
+        )
+
+    max_steps = max(1, len(pipe_cells) * (len(agents) + 2))
+    for _ in range(max_steps):
+        proposals: dict[int, tuple[int, int]] = {}
+        for agent in agents:
+            if agent["done"]:
+                continue
+            nxt = _choose_next(
+                agent["curr"],
+                agent["prev"],
+                neighbors,
+                used_edges,
+            )
+            if nxt is None:
+                agent["done"] = True
+                agent["terminal"] = agent["curr"]
+            else:
