+
+    pipe_cells = {root}
+    seed_slots: list[tuple[int, int]] = []
+    for step in range(1, trunk_len + 1):
+        pipe_cells.add((0, int(step)))
+
+    for d, length in zip(seed_dirs, seed_lengths):
+        dr, dc = d
+        for step in range(1, length + 1):
+            pipe_cells.add((int(dr * step), int(dc * step)))
