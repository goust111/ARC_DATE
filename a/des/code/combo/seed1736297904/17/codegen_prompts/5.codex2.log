+    fixed_color: dict[tuple[int, int], int | None] = {}
+    used_edges: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    agents = []
+    for idx, seed in enumerate(seeds):
+        leaf = seed["leaf"]
+        color = int(seed["color"])
+        if leaf not in fixed_color:
+            fixed_color[leaf] = color
+            out[leaf] = color
+        agents.append(
+            {
+                "id": idx,
+                "color": color,
+                "curr": leaf,
+                "prev": None,
+                "done": False,
+                "terminal": None,
+            }
+        )
