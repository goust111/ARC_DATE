+    for d, length in zip(sorted(seed_dirs), seed_lengths):
+        lengths[d] = int(length)
+
+    if len(target_dirs) >= 2 and random.random() < 0.5:
+        tie_len = random.randint(2, 6)
+        tied = random.sample(target_dirs, 2)
+        for d in target_dirs:
+            if d in tied:
