+        color = int(agent["color"])
+        for dr, dc in DIRS4:
+            rr = int(terminal[0] + dr)
+            cc = int(terminal[1] + dc)
+            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):
+                out[rr, cc] = color
