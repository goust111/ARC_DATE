+    memo: dict[tuple[tuple[int, int], tuple[int, int] | None], int] = {}
+    ranked = []
+    for nxt in options:
+        dr = int(nxt[0] - cell[0])
+        dc = int(nxt[1] - cell[1])
+        ranked.append(
+            (
+                -int(_remaining_len(nxt, cell, neighbors, used_edges, memo)),
+                int(DIR_PRIORITY[(dr, dc)]),
+                nxt,
+            )
+        )
+    ranked.sort()
+    return ranked[0][2]
