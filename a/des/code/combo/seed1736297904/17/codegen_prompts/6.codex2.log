+def _crop_hint_bar(grid: np.ndarray, edge: str) -> np.ndarray:
+    if edge == "top":
+        return grid[1:, :]
+    if edge == "bottom":
+        return grid[:-1, :]
+    if edge == "left":
+        return grid[:, 1:]
+    if edge == "right":
+        return grid[:, :-1]
+    raise AssertionError(f"unknown edge {edge}")
