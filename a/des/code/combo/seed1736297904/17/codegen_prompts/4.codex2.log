+
+import numpy as np
+
+
+BLACK = 0
+WALL_COLORS = (1, 2, 3)
+CELL_COLORS = (4, 5, 6, 7, 8, 9)
+
+SOLID = "solid"
+HORIZONTAL = "horizontal"
+VERTICAL = "vertical"
+
+
+GRID_MIN = 11
+GRID_MAX = 28
+CELL_ROWS_RANGE = (2, 4)
