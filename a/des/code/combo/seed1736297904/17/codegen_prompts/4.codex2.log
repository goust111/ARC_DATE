+        n_cols = random.randint(3, CELL_COLS_RANGE[1])
+    elif focus == VERTICAL:
+        n_rows = random.randint(3, CELL_ROWS_RANGE[1])
+        n_cols = random.randint(2, CELL_COLS_RANGE[1])
+    else:
+        n_rows = random.randint(*CELL_ROWS_RANGE)
+        n_cols = random.randint(*CELL_COLS_RANGE)
+
