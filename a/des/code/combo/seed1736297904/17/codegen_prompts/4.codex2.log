+def _axis_positions(sizes: list[int], margin_before: int) -> tuple[list[int], int]:
+    starts: list[int] = []
+    pos = margin_before
+    for i, size in enumerate(sizes):
+        starts.append(pos)
+        pos += size
+        if i != len(sizes) - 1:
