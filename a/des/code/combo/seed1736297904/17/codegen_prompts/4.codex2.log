+    h_uniform = bool(horizontal_walls) and len(set(horizontal_walls)) == 1
+    v_uniform = bool(vertical_walls) and len(set(vertical_walls)) == 1
+
+    if h_uniform and not v_uniform:
+        return HORIZONTAL
+    if v_uniform and not h_uniform:
+        return VERTICAL
