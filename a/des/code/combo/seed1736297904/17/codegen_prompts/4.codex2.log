+        for c in range(n_cols):
+            forbidden = set()
+            if r > 0:
+                forbidden.add(int(colors[r - 1, c]))
+            if c > 0:
+                forbidden.add(int(colors[r, c - 1]))
+            choices = [color for color in CELL_COLORS if color not in forbidden]
+            colors[r, c] = random.choice(choices or list(CELL_COLORS))
