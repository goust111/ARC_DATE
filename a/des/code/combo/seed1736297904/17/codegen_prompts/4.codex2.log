+    assert g.ndim == 2, "expected a 2D grid"
+
+    out = g.copy()
+    for region in _extract_regions(g):
+        r0, c0, r1, c1 = region["bbox"]
+        pattern = str(region["pattern"])
+        color = int(region["draw_color"])
