+def _depth(frame: dict[str, object], frames: list[dict[str, object]]) -> int:
+    r0, c0, r1, c1 = frame["bbox"]  # type: ignore[index]
+    depth = 1
+    for other in frames:
+        if other is frame:
+            continue
+        or0, oc0, or1, oc1 = other["bbox"]  # type: ignore[index]
+        if or0 < r0 and oc0 < c0 and or1 > r1 and oc1 > c1:
+            depth += 1
+    return depth
+
