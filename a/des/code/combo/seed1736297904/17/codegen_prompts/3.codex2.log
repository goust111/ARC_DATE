+BG = 0
+FRAME_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DEPTH_RANGE = (2, 5)
+LEAF_H_RANGE = (3, 6)
+LEAF_W_RANGE = (3, 7)
+MARGIN_CHOICES = (2, 3)
+PLACEMENT_PAD = 2
+GEN_ATTEMPTS = 400
+MAX_SIDE = 40
