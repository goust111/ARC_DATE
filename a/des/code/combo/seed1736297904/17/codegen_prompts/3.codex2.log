+        assert abs(prev_r - curr_r) + abs(prev_c - curr_c) == 1, "bar cells must be contiguous"
+    colors = [int(grid[r, c]) for r, c in ordered]
+    assert len(colors) == len(set(colors)), "bar colors should be distinct"
+    return colors, ordered
