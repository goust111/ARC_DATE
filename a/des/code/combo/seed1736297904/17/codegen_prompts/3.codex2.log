+    corner = random.choice(["tl", "tr", "bl", "br"])
+    orient = random.choice(["horizontal", "vertical"])
+    for (r, c), color in zip(_bar_cells(height, width, max_depth, corner, orient), color_bar):
+        grid[r, c] = int(color)
