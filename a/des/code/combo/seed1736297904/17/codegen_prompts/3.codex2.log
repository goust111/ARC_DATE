+        top = random.choice(MARGIN_CHOICES)
+        bottom = random.choice(MARGIN_CHOICES)
+        left = random.choice(MARGIN_CHOICES)
+        right = random.choice(MARGIN_CHOICES)
+        boxes.insert(0, (r0 - top, c0 - left, r1 + bottom, c1 + right))
