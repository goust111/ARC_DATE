+        return [(h - 1, w - 1 - i) for i in range(length)]
+    if corner == "tl":
+        return [(i, 0) for i in range(length)]
+    if corner == "tr":
+        return [(i, w - 1) for i in range(length)]
+    if corner == "bl":
+        return [(h - 1 - i, 0) for i in range(length)]
+    return [(h - 1 - i, w - 1) for i in range(length)]
