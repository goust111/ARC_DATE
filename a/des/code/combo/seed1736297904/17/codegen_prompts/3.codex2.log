+    out = g.copy()
+    for r, c in bar_cells:
+        out[r, c] = bg
+
+    for frame in frames:
+        depth = _depth(frame, frames)
+        assert 1 <= depth <= len(bar_colors), "frame depth exceeds bar length"
+        new_color = int(bar_colors[depth - 1])
+        for r, c in frame["coords"]:  # type: ignore[index]
+            out[r, c] = new_color
+
+    return out
