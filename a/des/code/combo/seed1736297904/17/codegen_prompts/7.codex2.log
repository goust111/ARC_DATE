+def _random_pattern_mask(rng: random.Random, side: str) -> np.ndarray:
+    for _ in range(60):
+        h = rng.randint(1, 3)
+        w = rng.randint(1, 3)
+        total = h * w
+        cell_count = 1 if total == 1 else rng.randint(2, min(5, total))
