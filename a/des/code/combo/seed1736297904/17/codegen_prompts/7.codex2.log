+def _arrow_cells_for_target(top: int, left: int, target_side: str) -> set[tuple[int, int]]:
+    missing = TARGET_TO_MISSING[target_side]
+    cells = set()
+    for dr in range(2):
+        for dc in range(2):
+            if (dr, dc) != missing:
+                cells.add((top + dr, left + dc))
+    return cells
