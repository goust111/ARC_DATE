+BLACK = 0
+GREY = 5
+MAROON = 9
+
+SIDE_ORDER = ("up", "right", "down", "left")
+SIDE_TO_INDEX = {side: idx for idx, side in enumerate(SIDE_ORDER)}
+MISSING_TO_TARGET = {
+    (0, 1): "up",
+    (0, 0): "left",
+    (1, 0): "down",
+    (1, 1): "right",
+}
+TARGET_TO_MISSING = {side: missing for missing, side in MISSING_TO_TARGET.items()}
