+GEN_RETRIES = 300
+ROOM_TRIES = 80
+ROOM_COUNT_CHOICES = (2, 3, 4)
+SIZE_RANGE = (24, 36)
+INNER_SIZE_RANGE = (6, 10)
+ARROW_COLORS = [1, 2, 3, 4, 6, 7, 8]
+ROOM_MARGIN = 4
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
