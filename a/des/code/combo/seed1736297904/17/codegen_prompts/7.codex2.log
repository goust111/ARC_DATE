+    grid[r0 : r1 + 1, c1] = GREY
+
+
+def _draw_arrow(
+    grid: np.ndarray,
+    room: tuple[int, int, int, int],
+    target_side: str,
+    arrow_top: int,
+    arrow_left: int,
+    color: int,
+) -> None:
