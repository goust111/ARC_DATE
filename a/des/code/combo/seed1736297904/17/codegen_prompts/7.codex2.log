+        if spec is None:
+            return None
+        rr0, rc0, rr1, rc1 = spec["reserve"]
+        used[rr0 : rr1 + 1, rc0 : rc1 + 1] = True
+        specs.append(spec)
+
+    if all(spec["source_side"] == spec["target_side"] for spec in specs):
+        return None
+    if len({spec["target_side"] for spec in specs}) == 1:
+        return None
+
+    for spec in specs:
