+
+def _touches_attachment_edge(mask: np.ndarray, side: str) -> bool:
+    if side == "up":
+        return bool(mask[-1, :].any())
+    if side == "down":
+        return bool(mask[0, :].any())
+    if side == "left":
+        return bool(mask[:, -1].any())
+    if side == "right":
+        return bool(mask[:, 0].any())
+    raise ValueError(side)
