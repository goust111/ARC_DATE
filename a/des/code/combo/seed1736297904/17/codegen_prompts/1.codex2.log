+
+def _symmetry_type(mask: np.ndarray, *, require_unique: bool = True) -> str | None:
+    horizontal = np.array_equal(mask, np.flipud(mask))
+    vertical = np.array_equal(mask, np.fliplr(mask))
+    diagonal = False
+    if mask.shape[0] == mask.shape[1]:
