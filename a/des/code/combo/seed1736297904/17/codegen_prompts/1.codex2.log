+KEY_COLUMN = np.array([BLUE, GREEN, MAGENTA], dtype=int)
+FILL_POOL = [YELLOW, GRAY, ORANGE, AZURE, BROWN]
+FRAME_POOL = [YELLOW, GRAY, ORANGE, AZURE, BROWN]
+SIDES = ("top", "bottom", "left", "right")
+
+RNG = np.random.default_rng()
+MAX_RETRIES = 400
+OBJECT_RETRIES = 250
