+def _enumerate_pattern_bank() -> dict[str, list[np.ndarray]]:
+    bank = {"horizontal": [], "vertical": [], "diagonal": []}
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for h in range(2, 4):
