+        _draw_cells(out, frame_cells, frame_color)
+        _draw_cells(inp, red_cells, RED)
+        _draw_cells(out, red_cells, RED)
+        _draw_cells(out, ray_cells, fill)
+        _mark_halo(reserved, output_cells)
