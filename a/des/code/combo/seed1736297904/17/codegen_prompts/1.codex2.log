+        for name, ok in (
+            ("horizontal", horizontal),
+            ("vertical", vertical),
+            ("diagonal", diagonal),
+        )
+        if ok
+    ]
+    if require_unique:
+        assert len(kinds) == 1, "red pattern must have exactly one symmetry class"
+    return kinds[0] if len(kinds) == 1 else None
+
+
