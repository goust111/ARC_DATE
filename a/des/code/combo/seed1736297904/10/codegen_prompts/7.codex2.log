+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+USABLE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+MAX_GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _adjacent(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1]) == 1
+
+
+def _point_on_segment(
+    p: tuple[float, float],
+    a: tuple[float, float],
+    b: tuple[float, float],
+) -> bool:
+    px, py = p
+    ax, ay = a
+    bx, by = b
+    cross = (px - ax) * (by - ay) - (py - ay) * (bx - ax)
+    if abs(cross) > 1e-9:
+        return False
+    dot = (px - ax) * (bx - ax) + (py - ay) * (by - ay)
+    if dot < -1e-9:
+        return False
+    sq_len = (bx - ax) ** 2 + (by - ay) ** 2
+    return dot <= sq_len + 1e-9
+
+
+def _point_in_polygon(point: tuple[float, float], polygon: list[tuple[float, float]]) -> bool:
+    x, y = point
+    inside = False
+    n = len(polygon)
+    for i in range(n):
+        x1, y1 = polygon[i]
+        x2, y2 = polygon[(i + 1) % n]
+        if _point_on_segment(point, (x1, y1), (x2, y2)):
+            return False
+        if (y1 > y) != (y2 > y):
+            x_cross = x1 + (y - y1) * (x2 - x1) / (y2 - y1)
+            if x_cross > x:
+                inside = not inside
+    return inside
+
+
+def _supercover_line(a: tuple[int, int], b: tuple[int, int]) -> set[tuple[int, int]]:
+    x0, y0 = a[1], a[0]
+    x1, y1 = b[1], b[0]
+    dx = x1 - x0
+    dy = y1 - y0
+    nx = abs(dx)
+    ny = abs(dy)
+    sx = 0 if dx == 0 else (1 if dx > 0 else -1)
+    sy = 0 if dy == 0 else (1 if dy > 0 else -1)
+
+    x, y = x0, y0
+    cells = {(y, x)}
+    ix = 0
+    iy = 0
+    while ix < nx or iy < ny:
+        lhs = (1 + 2 * ix) * ny
+        rhs = (1 + 2 * iy) * nx
+        if lhs == rhs:
+            x += sx
+            y += sy
+            ix += 1
+            iy += 1
+        elif lhs < rhs:
+            x += sx
+            ix += 1
+        else:
+            y += sy
+            iy += 1
+        cells.add((y, x))
+    return cells
+
+
+def _ordered_path(
+    comp_set: set[tuple[int, int]],
+    start: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    if len(comp_set) == 1:
+        return [start]
+
+    h, w = shape
+    ordered = [start]
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
+        nxts = [p for p in _neighbors4(cur[0], cur[1], h, w) if p in comp_set and p != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "grey path must be a simple non-branching polyline"
+        prev, cur = cur, nxts[0]
+        ordered.append(cur)
+    assert len(ordered) == len(comp_set), "failed to traverse the full grey path"
+    return ordered
+
+
+def _pair_interior(
+    shape: tuple[int, int],
+    marker_a: tuple[int, int],
+    marker_b: tuple[int, int],
+    ordered_path: list[tuple[int, int]],
+) -> set[tuple[int, int]]:
+    polygon = [(float(marker_a[1]), float(marker_a[0]))]
+    polygon.extend((float(c), float(r)) for r, c in ordered_path)
+    polygon.append((float(marker_b[1]), float(marker_b[0])))
+
+    boundary = set(ordered_path)
+    boundary.add(marker_a)
+    boundary.add(marker_b)
+    boundary |= _supercover_line(marker_a, marker_b)
+
+    h, w = shape
+    r0, c0, r1, c1 = _bbox(boundary)
+    r0 = max(0, r0)
+    c0 = max(0, c0)
+    r1 = min(h - 1, r1)
+    c1 = min(w - 1, c1)
+
+    inside: set[tuple[int, int]] = set()
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if (r, c) in boundary:
+                continue
+            if _point_in_polygon((float(c), float(r)), polygon):
+                inside.add((r, c))
+    return inside
