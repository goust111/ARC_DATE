+
+    out = g.copy()
+    grey_components = _components((g == GREY) & active_mask)
+    paths_by_color: dict[int, list[tuple[int, int]]] = {}
+
+    for comp in grey_components:
+        comp_set = set(comp)
+        adjacent_markers: set[tuple[int, int, int]] = set()
+        for r, c in comp:
+            for nr, nc in _neighbors4(r, c, h, w):
+                color = int(g[nr, nc])
