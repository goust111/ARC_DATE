+    for target in vertices[1:]:
+        dr = target[0] - cur[0]
+        dc = target[1] - cur[1]
+        step_r = 0 if dr == 0 else (1 if dr > 0 else -1)
+        step_c = 0 if dc == 0 else (1 if dc > 0 else -1)
+        assert step_r == 0 or step_c == 0
