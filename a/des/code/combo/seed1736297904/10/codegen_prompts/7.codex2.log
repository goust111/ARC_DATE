+        if (y1 > y) != (y2 > y):
+            x_cross = x1 + (y - y1) * (x2 - x1) / (y2 - y1)
+            if x_cross > x:
+                inside = not inside
+    return inside
+
+
+def _supercover_line(a: tuple[int, int], b: tuple[int, int]) -> set[tuple[int, int]]:
+    x0, y0 = a[1], a[0]
+    x1, y1 = b[1], b[0]
+    dx = x1 - x0
+    dy = y1 - y0
+    nx = abs(dx)
+    ny = abs(dy)
+    sx = 0 if dx == 0 else (1 if dx > 0 else -1)
+    sy = 0 if dy == 0 else (1 if dy > 0 else -1)
+
+    x, y = x0, y0
+    cells = {(y, x)}
+    ix = 0
+    iy = 0
+    while ix < nx or iy < ny:
+        lhs = (1 + 2 * ix) * ny
+        rhs = (1 + 2 * iy) * nx
+        if lhs == rhs:
+            x += sx
+            y += sy
+            ix += 1
+            iy += 1
+        elif lhs < rhs:
+            x += sx
+            ix += 1
+        else:
+            y += sy
+            iy += 1
+        cells.add((y, x))
+    return cells
+
+
+def _ordered_path(
+    comp_set: set[tuple[int, int]],
+    start: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    if len(comp_set) == 1:
+        return [start]
+
+    h, w = shape
+    ordered = [start]
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
+        nxts = [p for p in _neighbors4(cur[0], cur[1], h, w) if p in comp_set and p != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "grey path must be a simple non-branching polyline"
+        prev, cur = cur, nxts[0]
+        ordered.append(cur)
+    assert len(ordered) == len(comp_set), "failed to traverse the full grey path"
+    return ordered
+
