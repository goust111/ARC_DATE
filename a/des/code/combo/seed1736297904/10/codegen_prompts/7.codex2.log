+def _detect_palette(grid: np.ndarray) -> tuple[dict[int, int], np.ndarray]:
+    candidates: list[tuple[int, int, dict[int, int], np.ndarray]] = []
+    for comp in _components(grid == MAROON):
+        r0, c0, r1, c1 = _bbox(comp)
