+            top = int(grid[r, c])
+            if top == BG:
+                continue
+
+            for axis, deltas in specs:
+                (dr1, dc1), (dr2, dc2) = deltas
+                r1, c1 = r + dr1, c + dc1
+                r2, c2 = r + dr2, c + dc2
+                if not _in_bounds(grid.shape, r1, c1) or not _in_bounds(grid.shape, r2, c2):
+                    continue
+                if legend_mask[r1, c1] or legend_mask[r2, c2]:
+                    continue
+
+                v1 = int(grid[r1, c1])
+                v2 = int(grid[r2, c2])
+                if v1 == BG or v1 != v2 or v1 == top:
