+        choice = min(remaining, key=lambda idx: len(partners(idx)))
+        options = partners(choice)
+        if not options:
+            return
+        for other in options:
+            a, b = min(choice, other), max(choice, other)
+            used[a] = True
+            used[b] = True
+            current.append((a, b))
+            dfs()
+            current.pop()
+            used[a] = False
+            used[b] = False
