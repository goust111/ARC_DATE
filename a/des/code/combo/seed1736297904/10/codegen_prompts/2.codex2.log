+        if cursor > 0 and cursor + needed > width:
+            row_y += row_h + 1
+            row_h = 0
+            cursor = 0
+            needed = w
+        x = cursor if cursor == 0 else cursor + 1
+        positions.append((row_y, x, patch))
+        cursor = x + w
+        row_h = max(row_h, h)
