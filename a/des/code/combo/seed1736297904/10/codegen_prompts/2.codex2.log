+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(g[r0, c0]) == 0:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[Coord] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) != 0:
