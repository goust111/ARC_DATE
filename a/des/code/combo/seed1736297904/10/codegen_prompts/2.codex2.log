+
+Coord = tuple[int, int]
+Shape = tuple[Coord, ...]
+
+
+NEIGHBORS4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+# Generator configuration.
+AREA_CHOICES = (6, 8, 9, 10, 12)
+PAIR_COUNT_RANGE = (2, 4)
+WIDTH_RANGE = (7, 20)
+HEIGHT_RANGE = (12, 24)
+MAX_GENERATION_ATTEMPTS = 300
