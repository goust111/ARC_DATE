+    inp = _place_fragments(height, width, fragments)
+    if inp is None:
+        return None
+
+    comps = _find_components(inp)
+    if len(comps) != 2 * n_pairs:
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(actual, expected):
+        return inp
+    return None
+
