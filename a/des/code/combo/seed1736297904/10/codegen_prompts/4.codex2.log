+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if not mask[r, c]:
+                continue
+            if (
+                mask[r - 1, c]
+                and mask[r + 1, c]
+                and mask[r, c - 1]
+                and mask[r, c + 1]
