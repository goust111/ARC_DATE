+
+    legend = _render_legend(upper_w, legend_entries)
+    if legend is None:
+        return None
+
+    grid = np.vstack([upper, legend[None, :]])
+    fillable, blocked = _region_profile(grid)
+    if fillable != 2 or blocked != 2:
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if not np.array_equal(out[-1], grid[-1]):
+        return None
+    return grid
