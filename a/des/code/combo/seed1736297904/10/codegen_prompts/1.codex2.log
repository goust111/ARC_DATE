+    gaps = [int(_RNG.integers(LEGEND_GAP_MIN, LEGEND_GAP_MAX + 1)) for _ in range(max(0, len(entries) - 1))]
+    needed = 3 * len(entries) + sum(gaps)
+    if needed > width:
+        return None
