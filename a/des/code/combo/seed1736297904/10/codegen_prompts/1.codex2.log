+        return False
+    rr0 = max(0, r0 - PLACEMENT_MARGIN)
+    cc0 = max(0, c0 - PLACEMENT_MARGIN)
+    rr1 = min(hh, r0 + h + PLACEMENT_MARGIN)
+    cc1 = min(ww, c0 + w + PLACEMENT_MARGIN)
+    return not bool(occupied[rr0:rr1, cc0:cc1].any())
