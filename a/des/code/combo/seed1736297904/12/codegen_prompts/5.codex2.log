+        random.shuffle(pair_types)
+    else:
+        pair_types = [random.choice(PAIR_TYPES) for _ in colors]
+
+    pairs: dict[int, tuple[Coord, Coord]] = {}
+    working = reserved.copy()
+    generators = {
+        "horizontal": _random_horizontal,
+        "vertical": _random_vertical,
+        "elbow": _random_elbow,
+    }
