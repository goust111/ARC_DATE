+def _branch_values(output: np.ndarray, side: str) -> np.ndarray:
+    if side == "left":
+        return output[:, 0]
+    if side == "right":
+        return output[:, -1]
+    if side == "top":
+        return output[0, :]
+    return output[-1, :]
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    side = str(rng.choice(SIDES))
