+        if side == "left":
+            grid[:, 0] = GREY
+        else:
+            grid[:, -1] = GREY
+    else:
+        grid = np.full((depth_len + 2, axis_len), BLACK, dtype=int)
+        if side == "top":
+            grid[0, :] = GREY
+        else:
+            grid[-1, :] = GREY
+
+    _place_objects(grid, side, intervals, widths, starts, colors, rng)
+
+    comps = _foreground_components(grid)
+    if len(comps) != obj_count:
+        return None
+
+    out = main(grid)
