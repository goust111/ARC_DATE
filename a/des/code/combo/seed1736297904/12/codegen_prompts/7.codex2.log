+        else:
+            anchor = int(rng.integers(prev_l, prev_r + 1))
+        left = anchor - int(rng.integers(0, min(2, anchor) + 1))
+        right = anchor + int(rng.integers(0, min(2, width - 1 - anchor) + 1))
+        mask[r, left : right + 1] = True
