import random
from collections import Counter, deque
import numpy as np

BG=0
PALETTE=list(range(1,10))
CORNERS=['TL','TR','BL','BR']


def factor_pair_closest(n):
    best=None
    for h in range(1,int(n**0.5)+1):
        if n%h: continue
        w=n//h
        cand=(abs(w-h), h, w)
        if best is None or cand < best:
            best=cand
    return best[1], best[2]


def comp(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)]); seen[r,c]=True; pts=[]
            while q:
                rr,cc=q.popleft(); pts.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(pts)
    return out


def bbox(pts):
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    return min(rs),min(cs),max(rs),max(cs)


def partition(H,W,a,b,xt,xb,yl,yr):
    g=np.empty((H,W),dtype='<U2')
    for r in range(H):
        x = xt if r < a else xb
        for c in range(W):
            y = yl if c < b else yr
            left = c < x
            top = r < y
            g[r,c] = ('T' if top else 'B') + ('L' if left else 'R')
    return g


def valid_partition(g):
    H,W=g.shape
    checks={
        'TL':[(0,0),(0,1),(1,0),(1,1)],
        'TR':[(0,W-2),(0,W-1),(1,W-2),(1,W-1)],
        'BL':[(H-2,0),(H-2,1),(H-1,0),(H-1,1)],
        'BR':[(H-2,W-2),(H-2,W-1),(H-1,W-2),(H-1,W-1)],
    }
    for key,cells in checks.items():
        if any(g[r,c]"'!=key for r,c in cells):
            return False
    for key in CORNERS:
        mask=g==key
        cc=comp(mask)
        if len(cc)!=1:
            return False
        pts=cc[0]
        r0,c0,r1,c1=bbox(pts)
        if len(pts)==(r1-r0+1)*(c1-c0+1):
            return False
    return True


def random_partition(H,W):
    for _ in range(1000):
        a=random.randint(2,H-2)
        b=random.randint(2,W-2)
        xt=random.randint(2,W-2)
        xb=random.randint(2,W-2)
        yl=random.randint(2,H-2)
        yr=random.randint(2,H-2)
        if xt==xb or yl==yr:
            continue
        g=partition(H,W,a,b,xt,xb,yl,yr)
        if valid_partition(g):
            return g
    return None


def corner_marker_cell(key,H,W):
    return {
        '"'TL':(1,1),
        'TR':(1,W-2),
        'BL':(H-2,1),
        'BR':(H-2,W-2),
    }[key]


def build_sample():
    for _ in range(1000):
        area=random.choice([36,42,48,54,56,63,64,72,80])
        H,W=factor_pair_closest(area)
        if H<6 or W<6:
            continue
        part=random_partition(H,W)
        if part is None:
            continue
        colors=random.sample(PALETTE,8)
        body={k:colors[i] for i,k in enumerate(CORNERS)}
        marker={k:colors[i+4] for i,k in enumerate(CORNERS)}
        out=np.zeros((H,W),dtype=int)
        inp_pieces=[]
        for key in CORNERS:
            mask=(part==key)
            arr=np.zeros((H,W),dtype=int)
            arr[mask]=body[key]
            mr,mc=corner_marker_cell(key,H,W)
            if arr[mr,mc]"'!=body[key]:
                raise RuntimeError('"'marker not in piece')
            arr[mr,mc]=marker[key]
            ys,xs=np.where(arr"'!=0)
            r0,r1=ys.min(),ys.max(); c0,c1=xs.min(),xs.max()
            piece=arr[r0:r1+1,c0:c1+1].copy()
            inp_pieces.append(piece)
            out[mask]=body[key]
        # place pieces
        ph=max(p.shape[0] for p in inp_pieces)
        pw=max(p.shape[1] for p in inp_pieces)
        GH=max(H+10, 2*ph+10, 18)
        GW=max(W+10, 2*pw+10, 18)
        grid=np.zeros((GH,GW),dtype=int)
        occ=np.zeros((GH,GW),dtype=bool)
        random.shuffle(inp_pieces)
        for piece in inp_pieces:
            ph,pw=piece.shape
            placed=False
            for _ in range(500):
                r0=random.randint(0,GH-ph)
                c0=random.randint(0,GW-pw)
                mask=piece!=0
                # padding 1 in 8-neighborhood
                rr0=max(0,r0-1); cc0=max(0,c0-1); rr1=min(GH,r0+ph+1); cc1=min(GW,c0+pw+1)
                if occ[rr0:rr1,cc0:cc1].any() and mask.any():
