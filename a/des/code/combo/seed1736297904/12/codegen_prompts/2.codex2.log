+            "TR": ((1, pw - 2), (r0, c1)),
+            "BL": ((ph - 2, 1), (r1, c0)),
+            "BR": ((ph - 2, pw - 2), (r1, c1)),
+        }
+        for key, (marker_rel, anchor) in specs.items():
+            if rel == marker_rel:
+                candidates.append((key, anchor))
