    if not s: return False
    q=deque([next(iter(s))]); vis={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            p=(r+dr,c+dc)
            if p in s and p not in vis:
                vis.add(p); q.append(p)
    return vis==s

