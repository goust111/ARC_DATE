from collections import deque

def partition(H,W,a,b,xt,xb,yl,yr):
    def x(r): return xt if r < a else xb
    def y(c): return yl if c < b else yr
    regions={'TL':set(),'TR':set(),'BL':set(),'BR':set()}
    for r in range(H):
        for c in range(W):
            left = c < x(r)
            top = r < y(c)
            key = ('T' if top else 'B') + ('L' if left else 'R')
            regions[key].add((r,c))
    return regions

