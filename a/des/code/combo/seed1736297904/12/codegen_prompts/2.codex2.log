from collections import deque

def partition(H,W,a,b,xt,xb,yl,yr):
    def x(r): return xt if r < a else xb
    def y(c): return yl if c < b else yr
    regs={'TL':set(),'TR':set(),'BL':set(),'BR':set()}
    for r in range(H):
        for c in range(W):
            left = c < x(r)
            top = r < y(c)
            regs[('T' if top else 'B')+('L' if left else 'R')].add((r,c))
    return regs

def conn(s):
    if not s: return False
    q=deque([next(iter(s))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            p=(r+dr,c+dc)
            if p in s and p not in seen:
                seen.add(p); q.append(p)
    return seen==s

def bbox(s):
    rs=[r for r,c in s]; cs=[c for r,c in s]
    return min(rs),min(cs),max(rs),max(cs)

def nonrect(s):
    r0,c0,r1,c1=bbox(s)
    return len(s) < (r1-r0+1)*(c1-c0+1)

def corner_present(s,key,H,W):
    return {'TL':(0,0),'TR':(0,W-1),'BL':(H-1,0),'BR':(H-1,W-1)}[key] in s

def diag_inside(s,key):
    r0,c0,r1,c1=bbox(s)
    if key=='TL': return (r0+1,c0+1) in s
    if key=='TR': return (r0+1,c1-1) in s
    if key=='BL': return (r1-1,c0+1) in s
    return (r1-1,c1-1) in s

for H in range(6,11):
  for W in range(6,11):
    for a in range(1,H):
