+
+        target_corner, anchor = candidates[0]
+        cells = []
+        for r, c in pts:
+            color = body_color if (r, c) == (mr, mc) else int(g[r, c])
+            cells.append((r, c, color))
+
+        pieces.append((target_corner, anchor, cells))
+        total_area += len(pts)
