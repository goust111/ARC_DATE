+    assert signal_color in (SIGNAL_RED, SIGNAL_GREEN, SIGNAL_YELLOW), "unexpected signal color"
+    return (signal_r, 0), signal_color
+
+
+def _channel_components(
+    g: np.ndarray,
+    r0: int,
+    r1: int,
+    signal_rc: tuple[int, int],
+    separator_color: int,
+) -> list[dict]:
+    seen = np.zeros((r1 - r0 + 1, g.shape[1]), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(r0, r1 + 1):
+        for c in range(g.shape[1]):
+            if (r, c) == signal_rc:
+                continue
+            color = int(g[r, c])
+            if color in (BG, int(separator_color)):
+                continue
+            if seen[r - r0, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r - r0, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (r0 <= nr <= r1 and 0 <= nc < g.shape[1]):
+                        continue
+                    if (nr, nc) == signal_rc:
+                        continue
+                    if seen[nr - r0, nc]:
+                        continue
+                    if int(g[nr, nc]) != color:
+                        continue
+                    seen[nr - r0, nc] = True
+                    stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "left": int(arr[:, 1].min()),
+                    "top": int(arr[:, 0].min()),
