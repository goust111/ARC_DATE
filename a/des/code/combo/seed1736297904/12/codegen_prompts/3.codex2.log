+def _valid_yellow_layout(objects: list[dict]) -> bool:
+    max_area = max(int(obj["area"]) for obj in objects)
+    max_lefts = [int(obj["left"]) for obj in objects if int(obj["area"]) == max_area]
+    return len(max_lefts) == len(set(max_lefts))
