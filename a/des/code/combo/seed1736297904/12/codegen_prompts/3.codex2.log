+        signal_row = top + random.randrange(channel_h)
+        grid[signal_row, 0] = int(signals[idx])
+
+        for obj in channel_objects[idx]:
+            coords = obj["coords"]
+            abs_rows = top + coords[:, 0]
+            abs_cols = coords[:, 1]
+            grid[abs_rows, abs_cols] = int(obj["color"])
