+        if objects is None:
+            return None
+        channel_objects.append(objects)
+
+    inp = _render_scene(width, channel_heights, signals, channel_objects)
+    expected = _expected_output(inp)
+
+    if not np.array_equal(main(inp), expected):
+        return None
+    if np.array_equal(inp, expected):
+        return None
+    return inp
