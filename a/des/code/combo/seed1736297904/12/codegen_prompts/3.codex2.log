+    return signals
+
+
+def _gen_attempt() -> np.ndarray | None:
+    width = random.randint(*GEN_WIDTH_RANGE)
+    n_channels = random.randint(*GEN_CHANNEL_COUNT_RANGE)
+    channel_heights = [random.randint(*GEN_CHANNEL_HEIGHT_RANGE) for _ in range(n_channels)]
