+    assert comps, "each channel must contain at least one foreground object"
+    return comps
+
+
+def _yellow_target_color(components: list[dict]) -> int:
+    winner = min(
+        components,
+        key=lambda comp: (-int(comp["area"]), int(comp["left"]), int(comp["top"])),
+    )
+    return int(winner["color"])
+
