+        top += channel_h + 1
+
+    return grid
+
+
+def _expected_output(inp: np.ndarray) -> np.ndarray:
+    out = inp.copy()
+    separator_rows, separator_color = _separator_rows(inp)
+    spans = _channel_spans(inp.shape[0], separator_rows)
