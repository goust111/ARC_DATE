+    new_c0_num = abs_c0 + abs_c1 - (new_w - 1)
+    assert new_r0_num % 2 == 0 and new_c0_num % 2 == 0
+    new_r0 = new_r0_num // 2
+    new_c0 = new_c0_num // 2
+
