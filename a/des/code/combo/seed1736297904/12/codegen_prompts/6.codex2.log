+        if all(int(r) in row_set or int(c) in col_set for r, c in coords):
+            score = int(mask.sum())
+            if best is None or score > best[0]:
+                best = (score, color)
+
+    assert best is not None
+    return best[1]
+
+
+def _room_slices(row_lines: list[int], col_lines: list[int]) -> list[tuple[int, int, int, int]]:
