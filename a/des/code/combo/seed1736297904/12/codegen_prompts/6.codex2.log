+
+
+def _paint_object(
+    grid: np.ndarray,
+    room: tuple[int, int, int, int],
+    shape: np.ndarray,
+    color: int,
+) -> dict[str, int | np.ndarray]:
+    r0, r1, c0, c1 = room
+    room_h = r1 - r0 + 1
+    room_w = c1 - c0 + 1
+    h, w = map(int, shape.shape)
