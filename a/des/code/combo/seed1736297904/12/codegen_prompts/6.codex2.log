+    room: tuple[int, int, int, int],
+    exits: int,
+) -> None:
+    r0, r1, c0, c1 = room
+    interior = grid[r0 : r1 + 1, c0 : c1 + 1]
+    obj_mask = (interior != 0) & (interior != wall_color)
+    assert obj_mask.any()
