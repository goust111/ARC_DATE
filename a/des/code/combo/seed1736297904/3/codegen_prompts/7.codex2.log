+    horizontal_count = int(RNG.integers(1, pair_count))
+    vertical_count = pair_count - horizontal_count
+
+    rows = _sample_spaced(2, size - 3, horizontal_count, min_gap=2)
+    cols = _sample_spaced(2, size - 3, vertical_count, min_gap=2)
