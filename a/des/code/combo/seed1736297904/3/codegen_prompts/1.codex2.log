FRAME_COLOR_COUNT = 5
ALL_COLORS = list(range(COLOR_COUNT))

# Interior density and object counts.
MOVING_PIXELS_MIN = 8
MOVING_PIXELS_MAX = 19
STATIC_PIXELS_MIN = 0
STATIC_PIXELS_MAX = 9
DENSITY_MIN = 0.12
DENSITY_MAX = 0.27
STATIC_COLOR_MAX = 3

# Per-side moving pixel allocation.
SIDE_COUNT_BINS = 4
SIDE_COUNT_MIN = 0
SIDE_COUNT_MAX = 6

# Retry budget for rejection sampling.
