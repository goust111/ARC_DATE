+        _paint_growth(
+            expected,
+            int(band["r0"]),
+            int(band["r1"]),
+            int(band["direction"]),
+            int(band["color"]),
+            seed_cols,
+        )
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            inp, expected = _build_scene()
+        except Exception:
+            continue
+        try:
+            actual = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

