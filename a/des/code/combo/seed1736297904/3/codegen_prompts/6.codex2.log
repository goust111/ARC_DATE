def _add_contour_extras(grid: np.ndarray, long_mask: np.ndarray, paths: list[list[int]], contour: int, needed: int) -> bool:
    if needed < 0:
        return False
    candidates: list[tuple[int, int]] = []
    for side, path_i in [(-1, 0), (1, len(paths) - 1)]:
