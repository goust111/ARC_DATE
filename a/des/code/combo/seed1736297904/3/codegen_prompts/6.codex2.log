+
+def _segment_records(row_lines: Sequence[int], col_lines: Sequence[int]) -> List[Tuple[List[Tuple[int, int]], List[Tuple[int, int]]]]:
+    room_rows = len(row_lines) - 1
+    room_cols = len(col_lines) - 1
