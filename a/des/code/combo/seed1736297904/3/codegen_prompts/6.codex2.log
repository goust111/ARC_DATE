    obstacle_count = int((inp == obstacle).sum())
    if not (CONTOUR_PIXELS_MIN <= contour_count <= CONTOUR_PIXELS_MAX and OBSTACLE_PIXELS_MIN <= obstacle_count <= OBSTACLE_PIXELS_MAX):
