+    total += int(np.count_nonzero(maze[r1, c0 + 1 : c1] == BLACK))
+    total += int(np.count_nonzero(maze[r0 + 1 : r1, c0] == BLACK))
+    total += int(np.count_nonzero(maze[r0 + 1 : r1, c1] == BLACK))
+    return total
