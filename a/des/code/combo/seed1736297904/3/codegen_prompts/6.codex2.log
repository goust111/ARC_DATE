        return False
    interior_count = n_bg - EXTERIOR_REGION_COUNT
    if not (BG_REGIONS_MIN <= n_bg <= BG_REGIONS_MAX and INTERIOR_REGIONS_MIN <= interior_count <= INTERIOR_REGIONS_MAX and long_count in LONG_COMPONENT_COUNT_OPTIONS):
