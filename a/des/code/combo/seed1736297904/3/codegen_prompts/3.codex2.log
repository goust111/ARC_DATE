+GRID_SIZES = (20, 22, 24)
+INNER_SIZES = (6, 8, 10)
+GEN_ATTEMPTS = 400
+
+
+def _build_structure(side: int, inner: int) -> tuple[np.ndarray, dict[str, int]]:
