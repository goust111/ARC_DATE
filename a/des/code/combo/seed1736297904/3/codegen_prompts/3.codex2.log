+def _build_structure(side: int, inner: int) -> tuple[np.ndarray, dict[str, int]]:
+    grid = np.full((side, side), BG, dtype=int)
+    cross_r = cross_c = side // 2
+    top = cross_r - inner // 2 - 1
+    left = cross_c - inner // 2 - 1
+    bottom = top + inner + 1
