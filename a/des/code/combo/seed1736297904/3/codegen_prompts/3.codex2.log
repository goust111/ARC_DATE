+    left = info["left"]
+    bottom = info["bottom"]
+    right = info["right"]
+    cross_r = info["cross_r"]
+    cross_c = info["cross_c"]
+
+    if quadrant == "ul":
+        assert h <= cross_r - (top + 1)
+        assert w <= cross_c - (left + 1)
