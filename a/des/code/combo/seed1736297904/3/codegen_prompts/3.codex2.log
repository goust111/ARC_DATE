+    if quadrant == "ur":
+        assert h <= cross_r - (top + 1)
+        assert w <= right - cross_c
+        return top + 1, right - w
+    if quadrant == "lr":
+        assert h <= bottom - cross_r
+        assert w <= right - cross_c
+        return bottom - h, right - w
+    assert quadrant == "ll"
+    assert h <= bottom - cross_r
+    assert w <= cross_c - (left + 1)
+    return bottom - h, left + 1
