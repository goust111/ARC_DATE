+                border[-1, :] = True
+                border[:, 0] = True
+                border[:, -1] = True
+                sub = grid[top : bottom + 1, left : right + 1]
+                if not np.all(sub[border] == RED):
+                    continue
+                if not np.all(sub[~border] == BG):
+                    continue
+
+                row_hits = []
+                for r in range(top + 1, bottom):
+                    if np.all(grid[r, : left + 1] == RED) and np.all(grid[r, right:] == RED):
+                        row_hits.append(r)
+                col_hits = []
+                for c in range(left + 1, right):
