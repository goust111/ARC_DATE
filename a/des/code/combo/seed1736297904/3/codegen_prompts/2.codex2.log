+
+    arm_w = 0
+    while arm_w < w and grid[h - 1, arm_w] == MARKER:
+        arm_w += 1
+
+    arm_h = 0
+    while arm_h < h and grid[h - 1 - arm_h, 0] == MARKER:
+        arm_h += 1
+
