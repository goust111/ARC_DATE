/bin/bash -lc "python - <<'PY'
import random
from collections import deque
import hashlib
import numpy as np

BG = 0
MARKER = 3
SEGMENT_COLORS = [1, 2, 4, 5, 6, 7, 8, 9]
MAX_ATTEMPTS = 800


def find_components(mask):
    H, W = mask.shape
    seen = np.zeros((H, W), dtype=bool)
    comps = []
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                x, y = q.popleft()
                coords.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and mask[nx, ny] and not seen[nx, ny]:
                        seen[nx, ny] = True
                        q.append((nx, ny))
            comps.append(np.array(coords, dtype=int))
    return comps


def detect_marker(g):
    H, W = g.shape
    assert g[H - 1, 0] == MARKER
    ah = 0
    while ah < W and g[H - 1, ah] == MARKER:
        ah += 1
    av = 0
    while av < H and g[H - 1 - av, 0] == MARKER:
        av += 1
    expected = {(H - 1, c) for c in range(ah)} | {(r, 0) for r in range(H - av, H)}
    got = set(map(tuple, np.argwhere(g == MARKER)))
    assert got == expected
    return ah, av


def parse_segments(g):
    mask = (g "'!= BG) & (g != MARKER)
    segs = []
    for pts in find_components(mask):
        rows = pts[:, 0]
        cols = pts[:, 1]
        r0, r1 = int(rows.min()), int(rows.max())
        c0, c1 = int(cols.min()), int(cols.max())
        vals = np.unique(g[rows, cols])
        assert len(vals) == 1
        color = int(vals[0])
        if r0 == r1:
            assert len(pts) == c1 - c0 + 1
            orient = '"'h'
            length = c1 - c0 + 1
        else:
            assert c0 == c1
            assert len(pts) == r1 - r0 + 1
            orient = 'v'
            length = r1 - r0 + 1
        assert length >= 2
        segs.append({'color': color, 'orient': orient, 'length': length, 'row': r0, 'col': c0, 'coords': pts})
    return segs


def main(grid):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    ah, av = detect_marker(g)
    segs = parse_segments(g)
    out = g.copy()
    for seg in segs:
        rr = seg['coords'][:, 0]
        cc = seg['coords'][:, 1]
        out[rr, cc] = BG
    hs = sorted((s for s in segs if s['orient'] == 'h'), key=lambda s: (s['length'], s['row'], s['col']))
    vs = sorted((s for s in segs if s['orient'] == 'v'), key=lambda s: (s['length'], s['col'], s['row']))
    for i, seg in enumerate(hs):
        r = H - av - 1 - i
        L = seg['length']
        assert r >= 0 and L <= W
        assert np.all(out[r, :L] == BG)
        out[r, :L] = seg['color']
    for j, seg in enumerate(vs):
        c = ah + j
        L = seg['length']
        r0 = H - L
        assert c < W and r0 >= 0
        assert np.all(out[r0:, c] == BG)
        out[r0:, c] = seg['color']
    return out


def block_rect(blocked, r0, c0, r1, c1):
    H, W = blocked.shape
    blocked[max(0, r0 - 1):min(H, r1 + 2), max(0, c0 - 1):min(W, c1 + 2)] = True


def output_ok(H, W, ah, av, hs, vs):
    occ = np.zeros((H, W), dtype=bool)
    occ[H - av:H, 0] = True
    occ[H - 1, :ah] = True
    for i, L in enumerate(sorted(hs)):
        r = H - av - 1 - i
        if r < 0 or L > W:
            return False
        if np.any(occ[r, :L]):
            return False
        occ[r, :L] = True
    for j, L in enumerate(sorted(vs)):
        c = ah + j
        r0 = H - L
        if c >= W or r0 < 0:
            return False
        if np.any(occ[r0:, c]):
            return False
        occ[r0:, c] = True
    return True


def sample_both():
    nh = random.randint(1, 3)
    nv = random.randint(1, 3)
    ah = random.randint(2, 4)
    av = random.randint(2, 4)
    u = [random.randint(0, nv)]
    for _ in range(1, nh):
        u.append(random.randint(u[-1], nv))
    w_caps = [sum(x <= j for x in u) for j in range(nv)]
    w = []
    prev = 0
    for cap in w_caps:
        if prev > cap:
            return None
        prev = random.randint(prev, cap)
        w.append(prev)
    hs = [ah + x for x in u]
    vs = [av + x for x in w]
    if max(hs) == ah and max(vs) == av:
        return None
    min_H = max(vs, default=0) + 0
    min_H = max(min_H, av + nh)
    min_W = max(hs, default=0) + 0
    min_W = max(min_W, ah + nv)
    H = random.randint(min_H + 3, min(min_H + 9, 22))
    W = random.randint(min_W + 3, min(min_W + 9, 22))
    return H, W, ah, av, hs, vs


def sample_single(which):
    if which == 'h':
        nh = random.randint(2, 5)
        nv = 0
        ah = random.randint(1, 4)
        av = random.randint(1, 4)
        hs = sorted(random.randint(2, 8) for _ in range(nh))
        vs = []
    else:
        nh = 0
        nv = random.randint(2, 5)
        ah = random.randint(1, 4)
        av = random.randint(1, 4)
        hs = []
        vs = sorted(random.randint(2, 8) for _ in range(nv))
    min_H = max([av + nh, *vs, av + 1])
    min_W = max([ah + nv, *hs, ah + 1])
    H = random.randint(min_H + 3, min(min_H + 10, 24))
    W = random.randint(min_W + 3, min(min_W + 10, 24))
    return H, W, ah, av, hs, vs


def place_sources(H, W, ah, av, hs, vs):
    g = np.zeros((H, W), dtype=int)
    g[H - av:H, 0] = MARKER
    g[H - 1, :ah] = MARKER
    blocked = np.zeros((H, W), dtype=bool)
    block_rect(blocked, H - av, 0, H - 1, ah - 1)
    pieces = [('h', L) for L in hs] + [('v', L) for L in vs]
    random.shuffle(pieces)
    colors = random.sample(SEGMENT_COLORS, k=len(pieces))
    used_rows = set()
    used_cols = set()
    for color, (orient, L) in zip(colors, pieces):
        placed = False
        for _ in range(500):
            if orient == 'h':
                rows = [r for r in range(H) if r not in used_rows]
                if not rows:
                    return None
                r = random.choice(rows)
                c = random.randint(0, W - L)
                if np.any(blocked[r, c:c+L]):
                    continue
                g[r, c:c+L] = color
                block_rect(blocked, r, c, r, c + L - 1)
                used_rows.add(r)
                placed = True
                break
            else:
                cols = [c for c in range(W) if c not in used_cols]
                if not cols:
                    return None
                c = random.choice(cols)
                r = random.randint(0, H - L)
                if np.any(blocked[r:r+L, c]):
                    continue
                g[r:r+L, c] = color
                block_rect(blocked, r, c, r + L - 1, c)
                used_cols.add(c)
                placed = True
                break
        if not placed:
            return None
    return g


def generate_input():
    for _ in range(MAX_ATTEMPTS):
        mode = random.choices(['both', 'h', 'v'], weights=[0.5, 0.25, 0.25])[0]
        if mode == 'both':
            sample = sample_both()
        else:
            sample = sample_single(mode)
        if sample is None:
            continue
        H, W, ah, av, hs, vs = sample
        if not output_ok(H, W, ah, av, hs, vs):
            continue
        g = place_sources(H, W, ah, av, hs, vs)
        if g is None:
            continue
        out = main(g)
        if np.array_equal(g, out):
            continue
        return g
    raise RuntimeError('failed')

sigs = set()
for i in range(300):
    inp = generate_input()
    out = main(inp)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
print('variants', len(sigs))
print('ok')
