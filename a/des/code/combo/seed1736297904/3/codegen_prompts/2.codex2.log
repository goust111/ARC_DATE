import random
from collections import deque
import hashlib
import numpy as np

BG = 0
MARKER = 3
SEGMENT_COLORS = [1, 2, 4, 5, 6, 7, 8, 9]
MAX_ATTEMPTS = 500


def find_components(mask):
    H, W = mask.shape
    seen = np.zeros((H, W), dtype=bool)
    comps = []
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                x, y = q.popleft()
                coords.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and mask[nx, ny] and not seen[nx, ny]:
                        seen[nx, ny] = True
                        q.append((nx, ny))
            comps.append(coords)
    return comps


def detect_marker(g):
    H, W = g.shape
    assert g[H - 1, 0] == MARKER
    ah = 0
    while ah < W and g[H - 1, ah] == MARKER:
        ah += 1
    av = 0
    while av < H and g[H - 1 - av, 0] == MARKER:
        av += 1
    exp = {(H - 1, c) for c in range(ah)} | {(r, 0) for r in range(H - av, H)}
    got = set(map(tuple, np.argwhere(g == MARKER)))
    assert got == exp
    return ah, av


def parse_segments(g):
    mask = (g "'!= BG) & (g != MARKER)
    comps = find_components(mask)
    segs = []
    for coords in comps:
        pts = np.array(coords, dtype=int)
        rows = pts[:, 0]
        cols = pts[:, 1]
        r0, r1 = rows.min(), rows.max()
        c0, c1 = cols.min(), cols.max()
        vals = np.unique(g[rows, cols])
        assert len(vals) == 1
        color = int(vals[0])
        if r0 == r1:
            assert len(coords) == c1 - c0 + 1
            orient = '"'h'
            length = c1 - c0 + 1
        else:
            assert c0 == c1
            assert len(coords) == r1 - r0 + 1
            orient = 'v'
            length = r1 - r0 + 1
        segs.append({'color': color, 'orient': orient, 'length': length, 'row': int(r0), 'col': int(c0), 'coords': pts})
    return segs


def main(grid):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    assert np.any(g == BG)
    ah, av = detect_marker(g)
    segs = parse_segments(g)
    out = g.copy()
    for seg in segs:
        rr, cc = seg['coords'][:, 0], seg['coords'][:, 1]
        out[rr, cc] = BG
    hs = sorted((s for s in segs if s['orient'] == 'h'), key=lambda s: (s['length'], s['row'], s['col']))
    vs = sorted((s for s in segs if s['orient'] == 'v'), key=lambda s: (s['length'], s['col'], s['row']))
    for i, seg in enumerate(hs):
        r = H - 2 - i
        L = seg['length']
        assert r >= 0 and L <= W
        assert np.all(out[r, :L] == BG)
        out[r, :L] = seg['color']
    for j, seg in enumerate(vs):
        c = 1 + j
        L = seg['length']
        r0 = H - L
        assert c < W and r0 >= 0
        assert np.all(out[r0:, c] == BG)
        out[r0:, c] = seg['color']
    return out


def block_rect(blocked, r0, c0, r1, c1):
    H, W = blocked.shape
    rr0 = max(0, r0 - 1)
    cc0 = max(0, c0 - 1)
    rr1 = min(H - 1, r1 + 1)
    cc1 = min(W - 1, c1 + 1)
    blocked[rr0:rr1+1, cc0:cc1+1] = True


def output_ok(H,W,ah,av,hs,vs):
    occ = np.zeros((H,W), dtype=bool)
    for r in range(H-av, H):
        if occ[r,0]: return False
        occ[r,0]=True
    for c in range(ah):
        if occ[H-1,c]: return False
        occ[H-1,c]=True
    for i,L in enumerate(sorted(hs)):
        r = H-2-i
        if r<0 or L>W: return False
        if np.any(occ[r,:L]): return False
        occ[r,:L]=True
    for j,L in enumerate(sorted(vs)):
        c = 1+j
        r0 = H-L
        if c>=W or r0<0: return False
        if np.any(occ[r0:,c]): return False
        occ[r0:,c]=True
    return True


def sample_lengths(H,W):
    mode = random.choices(['both','h','v'], weights=[0.45,0.275,0.275])[0]
    for _ in range(200):
        if mode == 'both':
            nh = random.randint(1, 3)
            nv = random.randint(1, 3)
            if nh + nv > len(SEGMENT_COLORS):
                continue
            u = [random.randint(0, nv)]
            for _ in range(1, nh):
                u.append(random.randint(u[-1], nv))
            hs = [1 + x for x in u]
            caps = [sum(x <= j for x in u) for j in range(nv)]
            w = []
            prev = 0
            ok = True
            for cap in caps:
                if prev > cap:
                    ok = False
                    break
                prev = random.randint(prev, cap)
                w.append(prev)
            if not ok:
                continue
            vs = [1 + x for x in w]
            if max(hs) == 1 or max(vs) == 1:
                continue
            ah = av = 1
        elif mode == 'h':
            nh = random.randint(2, 5)
            nv = 0
            hs = sorted(random.randint(2, min(W - 1, 7)) for _ in range(nh))
            vs = []
            ah = random.randint(1, min(4, W - 1))
            av = 1
        else:
            nh = 0
            nv = random.randint(2, 5)
            hs = []
            vs = sorted(random.randint(2, min(H - 1, 7)) for _ in range(nv))
            ah = 1
            av = random.randint(1, min(4, H - 1))
        if output_ok(H,W,ah,av,hs,vs):
            return ah, av, hs, vs
    return None


def place_sources(H,W,ah,av,hs,vs):
    g = np.zeros((H,W), dtype=int)
    g[H-av:H,0] = MARKER
    g[H-1,:ah] = MARKER
    blocked = np.zeros((H,W), dtype=bool)
    block_rect(blocked, H-av, 0, H-1, ah-1)
    pieces = [('h',L) for L in hs] + [('v',L) for L in vs]
    random.shuffle(pieces)
    colors = random.sample(SEGMENT_COLORS, k=len(pieces))
    used_rows = set()
    used_cols = set()
    for color, (orient, L) in zip(colors, pieces):
        placed = False
        for _ in range(400):
            if orient == 'h':
                rows = [r for r in range(H) if r not in used_rows]
                if not rows:
                    return None
                r = random.choice(rows)
                c = random.randint(0, W - L)
                if np.any(blocked[r, c:c+L]):
                    continue
                g[r, c:c+L] = color
                block_rect(blocked, r, c, r, c+L-1)
                used_rows.add(r)
                placed = True
                break
            else:
                cols = [c for c in range(W) if c not in used_cols]
                if not cols:
                    return None
                c = random.choice(cols)
                r = random.randint(0, H - L)
                if np.any(blocked[r:r+L, c]):
                    continue
                g[r:r+L, c] = color
                block_rect(blocked, r, c, r+L-1, c)
                used_cols.add(c)
                placed = True
                break
        if not placed:
            return None
    return g


def generate_input():
    for _ in range(MAX_ATTEMPTS):
        H = random.randint(8, 16)
        W = random.randint(8, 16)
        sample = sample_lengths(H,W)
        if sample is None:
            continue
        ah,av,hs,vs = sample
        g = place_sources(H,W,ah,av,hs,vs)
        if g is None:
            continue
        out = main(g)
        if np.array_equal(out, g):
            continue
        return g
    raise RuntimeError

sigs = set()
for i in range(200):
    inp = generate_input()
    out = main(inp)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
print('variants', len(sigs))
print('ok')
