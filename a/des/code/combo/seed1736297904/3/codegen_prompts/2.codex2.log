                g[r, c:c+L] = color
                block_rect(blocked, r, c, r, c+L-1)
                used_rows.add(r)
                placed = True
                break
            else:
                cols = [c for c in range(W) if c not in used_cols]
                c = random.choice(cols)
                r = random.randint(0, H - L)
                if np.any(blocked[r:r+L, c]):
                    continue
                g[r:r+L, c] = color
                block_rect(blocked, r, c, r+L-1, c)
                used_cols.add(c)
                placed = True
                break
        if not placed:
            return None
    return g

for t in range(1000):
    H = random.randint(8,16)
    W = random.randint(8,16)
    sample = sample_lengths(H,W)
    if sample is None:
        continue
    ah,av,hs,vs = sample
    g = place_sources(H,W,ah,av,hs,vs)
    if g is None:
        continue
    try:
        main(g)
    except Exception as e:
        print('fail at', t, H,W,ah,av,hs,vs)
        print(type(e), e)
        print(g)
        break
else:
    print('no failures')
