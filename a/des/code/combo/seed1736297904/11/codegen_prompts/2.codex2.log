+    "D": frozenset({(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)}),
+    "L": frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)}),
+    "R": frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)}),
+}
