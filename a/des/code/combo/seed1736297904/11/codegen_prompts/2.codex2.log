+def _scene_matches(
+    arrows: list[dict[str, object]], targets_by_color: dict[int, list[tuple[int, int]]]
+) -> list[tuple[dict[str, object], tuple[int, int], int]]:
+    grouped_arrows: dict[int, list[dict[str, object]]] = {}
+    for arrow in arrows:
