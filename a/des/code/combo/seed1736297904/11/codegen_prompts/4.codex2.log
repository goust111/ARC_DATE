+                    "orientation": "h",
+                    "row": r,
+                    "left": start,
+                    "right": end,
+                    "seed_col": seed_c,
+                    "seed_color": seed_color,
+                }
+            )
+    return pipes
+
+
+def _extract_vertical_pipes(grid: np.ndarray) -> list[dict]:
+    pipes: list[dict] = []
+    height, width = grid.shape
+    for c in range(width):
+        col = grid[:, c]
+        for start, end in _nonblack_runs(col):
+            if end - start + 1 < 2:
