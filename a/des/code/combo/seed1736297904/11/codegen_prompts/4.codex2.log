+def _nonblack_runs(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    idx = 0
+    while idx < len(values):
+        if int(values[idx]) == BLACK:
+            idx += 1
+            continue
+        start = idx
+        while idx < len(values) and int(values[idx]) != BLACK:
+            idx += 1
+        runs.append((start, idx - 1))
+    return runs
+
