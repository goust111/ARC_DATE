+    cover = np.zeros(shape, dtype=int)
+    for pipe in horizontal:
+        cover[pipe["row"], pipe["left"] : pipe["right"] + 1] += 1
+    for pipe in vertical:
+        cover[pipe["top"] : pipe["bottom"] + 1, pipe["col"]] += 1
+    return cover
