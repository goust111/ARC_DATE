+    for _ in range(PLACEMENT_TRIES):
+        r0 = random.randint(1, gh - h - 1)
+        c0 = random.randint(1, gw - w - 1)
+        if not _reserve_is_clear(occupied, r0, c0, h, w, PLACEMENT_PAD):
+            continue
+
+        mask = patch != BG
+        grid[r0 : r0 + h, c0 : c0 + w][mask] = patch[mask]
