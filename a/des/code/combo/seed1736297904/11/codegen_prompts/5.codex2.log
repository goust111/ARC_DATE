+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "patch": patch,
+                    "size": patch.shape,
+                }
+            )
+
+    return objects
+
+
+def _classify_object(obj: dict, bg: int = BG) -> dict:
+    color = int(obj["color"])
+    patch = obj["patch"]
+
+    if np.all(patch == color):
+        result = dict(obj)
+        result["kind"] = "cast"
+        result["hole_mask"] = np.zeros_like(patch, dtype=bool)
+        return result
