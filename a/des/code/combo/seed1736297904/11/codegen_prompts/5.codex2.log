+        rr0 = max(0, r0 - PLACEMENT_PAD)
+        cc0 = max(0, c0 - PLACEMENT_PAD)
+        rr1 = min(gh, r0 + h + PLACEMENT_PAD)
+        cc1 = min(gw, c0 + w + PLACEMENT_PAD)
+        occupied[rr0:rr1, cc0:cc1] = True
+        return r0, c0
+
+    return None
+
+
+def _choose_pair_count(h: int, w: int) -> int:
+    max_pairs = 2
+    if h * w >= 280:
