+            hole_w = random.randint(1, max(1, (w - 2 + 1) // 2))
+            r0 = random.randint(1, h - hole_h - 1)
+            c0 = random.randint(1, w - hole_w - 1)
+            temp[r0 : r0 + hole_h, c0 : c0 + hole_w] = True
