            above = tuple(
                sorted(int(v) for v in np.unique(patch) if int(v) not in (bg, color))
            )
            out.append(Candidate(r0=r0, c0=c0, above=above))
    return out


def _partial_acyclic(assigned: dict[int, Candidate]) -> bool:
    state: dict[int, int] = {}

