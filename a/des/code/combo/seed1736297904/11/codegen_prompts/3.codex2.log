+    h, w = grid.shape
+    pts = np.argwhere(grid == color)
+    rmin, cmin = pts.min(axis=0)
+    rmax, cmax = pts.max(axis=0)
+
+    row_start = max(0, int(rmax) - size + 1)
+    row_stop = min(int(rmin), h - size)
+    col_start = max(0, int(cmax) - size + 1)
+    col_stop = min(int(cmin), w - size)
+
+    out: list[Candidate] = []
