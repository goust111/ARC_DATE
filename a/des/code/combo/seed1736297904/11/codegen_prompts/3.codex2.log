+def _infer_size(grid: np.ndarray, colors: list[int]) -> int:
+    spans = []
+    for color in colors:
+        pts = np.argwhere(grid == color)
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        spans.append(int(max(r1 - r0 + 1, c1 - c0 + 1)))
