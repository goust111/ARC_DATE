        out[r0 : r1 + 1, c0] = target
        out[r0 : r1 + 1, c1] = target
        out[r0 + 1 : r1, c0 + 1 : c1] = bg
    return out


def _build_attempt() -> tuple[np.ndarray, list[dict], list[int]] | None:
    bg = BG_COLOR
