+def _find_palette_row(grid: np.ndarray, bg: int) -> tuple[int, list[int], list[int]]:
+    h, _w = grid.shape
+    for r in range(h - 1, -1, -1):
+        cols = np.flatnonzero(grid[r] != bg)
