/bin/bash -lc "python - <<'PY'
import random
import numpy as np

BLACK = 0
GREY = 5
PATH_COLORS = [1,2,3,4,6,7,8,9]
DIRS = [(-1,0),(1,0),(0,-1),(0,1)]

def neigh4(cell):
    r,c = cell
    for dr,dc in DIRS:
        yield (r+dr,c+dc)

def trace(cells):
    cells = {tuple(x) for x in cells}
    adj = {cell: [] for cell in cells}
    for cell in cells:
        for nb in neigh4(cell):
            if nb in cells:
                adj[cell].append(nb)
    ends = sorted([cell for cell in cells if len(adj[cell])==1])
    path=[ends[0]]; prev=None; cur=ends[0]
    while True:
        nxt=[n for n in adj[cur] if n"'!=prev]
        if not nxt: break
        prev,cur=cur,nxt[0]
        path.append(cur)
    return path

def markers(path):
    out=[]
    for i in range(1,len(path)-1):
        a,b,c = path[i-1],path[i],path[i+1]
        d1=(b[0]-a[0], b[1]-a[1]); d2=(c[0]-b[0], c[1]-b[1])
        if d1!=d2:
            out.append((b[0]+d1[0]-d2[0], b[1]+d1[1]+d2[1]))
    return out

def try_extend(path,d,length,h,w,blocked):
    own=set(path); new=[]; r0,c0=path[-1]; dr,dc=d
    for step in range(1,length):
        cell=(r0+dr*step,c0+dc*step)
        if not (0<=cell[0]<h and 0<=cell[1]<w): return None
        if cell in own or cell in blocked or cell in new: return None
        prev=path[-1] if step==1 else new[-1]
        neighbors={nb for nb in neigh4(cell) if nb in own or nb in blocked or nb in new}
        if neighbors != {prev}: return None
        new.append(cell)
    return path+new

def perps(d):
    return [(0,-1),(0,1)] if d[0] else [(-1,0),(1,0)]

def grow(path,prev_dir,seg_idx,seg_total,h,w,blocked):
    if seg_idx==seg_total: return path
    dirs=DIRS[:] if seg_idx==0 else perps(prev_dir)
    random.shuffle(dirs)
    lens=[2,3,4]
    random.shuffle(lens)
    for d in dirs:
        for L in lens:
            ext=try_extend(path,d,L,h,w,blocked)
            if ext is None: continue
            got=grow(ext,d,seg_idx+1,seg_total,h,w,blocked)
            if got is not None: return got
    return None

