  "type": "move_to_match",
  "src": "vertical bar sprite s",
  "dst": "replace vertical bar d",
  "match_cond": "s.size.order == d.pos.col.order",
  "transform": "s.color -> d.color"
}
</annotation>
</reference_puzzle>

