import random
import numpy as np

BLACK = 0
GREY = 5
PATH_COLORS = [1,2,3,4,6,7,8,9]
DIRS = [(-1,0),(1,0),(0,-1),(0,1)]


def neigh4(cell):
    r,c = cell
    for dr,dc in DIRS:
        yield (r+dr,c+dc)

def trace_from_cells(cells):
    cells = {tuple(x) for x in cells}
    adj = {cell: [] for cell in cells}
    for r,c in cells:
        for nb in neigh4((r,c)):
            if nb in cells:
                adj[(r,c)].append(nb)
    if not cells:
        raise ValueError
    bad = [cell for cell, nbs in adj.items() if len(nbs) not in (1,2)]
    if bad:
        raise ValueError(('deg', bad[:5]))
    endpoints = sorted(cell for cell, nbs in adj.items() if len(nbs)==1)
    if len(endpoints) "'!= 2:
        raise ValueError(('"'end', endpoints))
    path = [endpoints[0]]
    prev = None
    cur = endpoints[0]
    while True:
        nxts = [nb for nb in adj[cur] if nb "'!= prev]
        if not nxts:
            break
        if len(nxts) != 1:
            raise ValueError(('"'branch', cur, nxts))
        prev, cur = cur, nxts[0]
        path.append(cur)
    if len(path) "'!= len(cells):
        raise ValueError(('"'conn', len(path), len(cells)))
    return path

def marker_offset(prev_dir, next_dir):
    return (prev_dir[0] - next_dir[0], prev_dir[1] + next_dir[1])

def markers_for_path(path):
    out = []
    for i in range(1, len(path)-1):
        p0 = path[i-1]
        p1 = path[i]
        p2 = path[i+1]
        prev_dir = (p1[0]-p0[0], p1[1]-p0[1])
        next_dir = (p2[0]-p1[0], p2[1]-p1[1])
        if prev_dir == next_dir:
            continue
        if prev_dir[0] and next_dir[0]:
            continue
        if prev_dir[1] and next_dir[1]:
            continue
        dr, dc = marker_offset(prev_dir, next_dir)
        out.append((p1[0]+dr, p1[1]+dc))
    return out

def try_extend(path, d, length, h, w, occupied):
    own = set(path)
    new = []
    r0,c0 = path[-1]
    dr,dc = d
    for step in range(1, length):
        cell = (r0+dr*step, c0+dc*step)
        if not (0 <= cell[0] < h and 0 <= cell[1] < w):
            return None
        if cell in own or cell in occupied or cell in new:
            return None
        prev = path[-1] if step == 1 else new[-1]
        neighbors = {nb for nb in neigh4(cell) if nb in own or nb in occupied or nb in new}
        if neighbors "'!= {prev}:
            return None
        new.append(cell)
    return path + new

def perpendiculars(d):
    if d[0]:
        return [(0,-1),(0,1)]
    return [(-1,0),(1,0)]

def grow(path, prev_dir, seg_idx, seg_total, h, w, occupied):
    if seg_idx == seg_total:
        return path
    dirs = DIRS[:] if seg_idx == 0 else perpendiculars(prev_dir)
    random.shuffle(dirs)
    lens = [2,3,4]
    random.shuffle(lens)
    for d in dirs:
        for length in lens:
            ext = try_extend(path, d, length, h, w, occupied)
            if ext is None:
                continue
            got = grow(ext, d, seg_idx+1, seg_total, h, w, occupied)
            if got is not None:
                return got
    return None

def build_path(h,w,blocked,seg_total):
    starts = [(r,c) for r in range(h) for c in range(w) if (r,c) not in blocked]
    random.shuffle(starts)
    for start in starts[:200]:
        if any(nb in blocked for nb in neigh4(start)):
            continue
        got = grow([start], (0,0), 0, seg_total, h, w, blocked)
        if got is None:
            continue
        traced = trace_from_cells(got)
        markers = markers_for_path(traced)
        mset = set()
        cells = set(got)
        ok = True
        for mr,mc in markers:
            if not (0 <= mr < h and 0 <= mc < w):
                ok = False
                break
            if (mr,mc) in blocked or (mr,mc) in cells or (mr,mc) in mset:
                ok = False
                break
            mset.add((mr,mc))
        if ok:
            return got, mset
    return None

def make_input():
    for _ in range(500):
        h = random.randint(12, 20)
        w = random.randint(12, 20)
        grid = np.zeros((h,w), dtype=int)
        npaths = random.randint(1,3)
