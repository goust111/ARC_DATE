+    for s, e in runs:
+        if s == 0 or e == grid.shape[1] - 1:
+            continue
+        score = (e - s + 1, -abs((s + e) / 2.0 - (grid.shape[1] - 1) / 2.0))
+        if best is None or score > best[0]:
+            best = (score, (s, e))
+    assert best is not None
+    return best[1]
