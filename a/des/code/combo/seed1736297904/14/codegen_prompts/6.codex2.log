+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SEP = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GEN_ATTEMPTS = 400
+_RNG = np.random.default_rng()
