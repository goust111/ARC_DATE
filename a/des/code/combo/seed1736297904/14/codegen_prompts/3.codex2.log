0058: def main(grid: np.ndarray) -> np.ndarray:
0059:     """Fill each plus-shaped background notch with the color of the frame side it opens toward.
0060: 
0061:     Input structure
0062:     - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.
0063:     - The frame interior contains a dominant background color and one foreground object color.
0064:     - Some object boundaries contain five-pixel plus-shaped background notches.
0065: 
0066:     Rule
0067:     - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.
0068:     - Recolor the five pixels of that plus with the color of the facing frame side.
0069:     - Leave all other pixels unchanged.
0070: 
0071:     Key insight
0072:     The frame side colors are direction labels for the open notches in the foreground object.
0073:     """
0074:     g = np.asarray(grid, dtype=int)
0075:     assert g.ndim == 2, "expected a 2D grid"
0076:     h, w = g.shape
0077:     assert h >= 5 and w >= 5, "expected room for a frame and plus notches"
0078: 
0079:     side_color = {
0080:         "top": _uniform_side(g[0, 1:-1]),
0081:         "bottom": _uniform_side(g[-1, 1:-1]),
0082:         "left": _uniform_side(g[1:-1, 0]),
0083:         "right": _uniform_side(g[1:-1, -1]),
0084:     }
0085:     bg, obj = _interior_colors(g[1:-1, 1:-1])
0086: 
0087:     out = g.copy()
0088:     painted: set[tuple[int, int]] = set()
0089:     notch_count = 0
0090:     for r in range(1, h - 1):
