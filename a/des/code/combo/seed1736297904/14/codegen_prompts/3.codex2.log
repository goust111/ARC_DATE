+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+_ARROW_DATA = {
+    (0, 1): {
+        "shape": frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)}),
+        "tail": (1, 0),
+        "nose": (1, 2),
+    },
+    (0, -1): {
+        "shape": frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)}),
+        "tail": (1, 2),
+        "nose": (1, 0),
+    },
+    (-1, 0): {
+        "shape": frozenset({(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)}),
+        "tail": (2, 1),
+        "nose": (0, 1),
+    },
+    (1, 0): {
+        "shape": frozenset({(0, 1), (1, 1), (2, 0), (2, 1), (2, 2)}),
+        "tail": (0, 1),
+        "nose": (2, 1),
