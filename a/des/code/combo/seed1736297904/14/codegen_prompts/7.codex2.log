+def _collect_doors(
+    g: np.ndarray,
+    row_lines: list[int],
+    col_lines: list[int],
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+) -> dict[tuple[tuple[int, int], tuple[int, int]], tuple[str, int, int]]:
