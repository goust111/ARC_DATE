+    marker_choices = [color for color in PALETTE if color != furniture_color]
+    marker_color = random.choice(marker_choices)
+
+    fr0, fc0, fr1, fc1 = fa
+    top = random.randint(fr0, fr1 - mask.shape[0] + 1)
+    left = random.randint(fc0, fc1 - mask.shape[1] + 1)
