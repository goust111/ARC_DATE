+WALL = 8
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 9)
+
+# Rooms are at least 4x4, so every library shape below fits somewhere.
+_BASE_SHAPES = (
+    np.array([[1, 1]], dtype=bool),
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 1], [1, 1]], dtype=bool),
