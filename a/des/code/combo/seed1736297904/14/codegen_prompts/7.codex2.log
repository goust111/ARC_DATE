        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        assert not np.any(patch == WALL), "room interiors cannot contain wall pixels"
        contents[room] = _classify_room(patch)
    return row_lines, col_lines, row_spans, col_spans, boxes, contents


def _collect_doors(
