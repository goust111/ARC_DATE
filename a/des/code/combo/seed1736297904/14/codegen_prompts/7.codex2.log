            boxes[(ri, ci)] = (r0, c0, r1, c1)
    return boxes


def _classify_room(patch: np.ndarray) -> dict:
    coords = np.argwhere((patch != BG) & (patch != WALL))
    if len(coords) == 0:
        return {"kind": "empty"}

