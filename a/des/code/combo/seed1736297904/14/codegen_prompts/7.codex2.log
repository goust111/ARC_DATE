        return {"kind": "marker", "color": color, "local": (rr, cc)}

    assert 2 <= len(coords) <= 5, "furniture area must stay small"
    assert _is_four_connected(coords), "furniture must be 4-connected"
    r0, c0 = map(int, coords.min(axis=0))
