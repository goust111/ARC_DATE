+def _room_boxes(row_spans: list[tuple[int, int]], col_spans: list[tuple[int, int]]):
+    boxes = {}
+    for ri, (r0, r1) in enumerate(row_spans):
+        for ci, (c0, c1) in enumerate(col_spans):
+            boxes[(ri, ci)] = (r0, c0, r1, c1)
+    return boxes
+
