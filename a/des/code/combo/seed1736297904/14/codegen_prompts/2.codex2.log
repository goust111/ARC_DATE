+        counts: dict[tuple[int, int], int] = defaultdict(int)
+        for top_r, top_c in ((nr0_a, nc0_a), (nr0_b, nc0_b)):
+            for dr, dc in a["local_cells"]:
+                rr = top_r + dr
+                cc = top_c + dc
+                if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1]:
+                    counts[(rr, cc)] += 1
