+        r1_max = top_r_limit if sign_r < 0 else top_r_limit - dr
+        c1_min = dc if sign_c < 0 else 0
+        c1_max = top_c_limit if sign_c < 0 else top_c_limit - dc
+        if r1_min > r1_max or c1_min > c1_max:
