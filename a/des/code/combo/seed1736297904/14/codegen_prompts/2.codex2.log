+        ar0, ac0, _, _ = a["bbox"]
+        br0, bc0, _, _ = b["bbox"]
+        nr0_a, nr0_b = _merge_axis(ar0, br0)
+        nc0_a, nc0_b = _merge_axis(ac0, bc0)
