+        rr1 = min(grid_h, r0 + frame_h + PLACEMENT_GAP)
+        cc0 = max(0, c0 - PLACEMENT_GAP)
+        cc1 = min(grid_w, c0 + frame_w + PLACEMENT_GAP)
+        occupied[rr0:rr1, cc0:cc1] = True
+        placed.append(
