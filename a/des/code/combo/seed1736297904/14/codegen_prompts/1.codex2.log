+        grid[r0 : r1 + 1, c0] = FRAME
+        grid[r0 : r1 + 1, c1] = FRAME
+        grid[r0, c0 : c1 + 1] = FRAME
+        grid[r1, c0 : c1 + 1] = FRAME
+
+        seed_r, seed_c = spec["seed_inner"]
+        grid[r0 + 1 + seed_r, c0 + 1 + seed_c] = int(spec["seed_color"])
+    return grid
+
