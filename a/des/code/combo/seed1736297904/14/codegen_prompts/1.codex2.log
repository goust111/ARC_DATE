+    positions: list[tuple[int, int]] = []
+    for r0 in range(1, h - frame_h):
+        for c0 in range(1, w - frame_w):
+            rr0 = max(0, r0 - gap)
+            rr1 = min(h, r0 + frame_h + gap)
