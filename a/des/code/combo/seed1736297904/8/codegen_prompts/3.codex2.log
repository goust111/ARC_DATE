+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL_FALLBACK = 5
+ROOM_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_BAND_RANGE = (5, 8)
+ROOM_H_RANGE = (2, 4)
+ROOM_W_RANGE = (2, 5)
+MACRO_ROWS = (2, 3)
+MACRO_COLS = (2, 3)
+ROOM_COUNT_RANGE = (2, 5)
+MARGIN_RANGE = (1, 3)
