+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and room_id[nr, nc] >= 0:
+                    ids.add(int(room_id[nr, nc]))
+            return ids
