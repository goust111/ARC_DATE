+    cs, ce = col_span
+    max_h = min(ROOM_H_RANGE[1], re - rs - 1)
+    max_w = min(ROOM_W_RANGE[1], ce - cs - 1)
+    assert max_h >= ROOM_H_RANGE[0] and max_w >= ROOM_W_RANGE[0]
