+def _find_exact_matches(pattern_mask: np.ndarray, template_mask: np.ndarray) -> list[tuple[int, int]]:
+    pattern_mask = np.asarray(pattern_mask, dtype=bool)
+    template_mask = np.asarray(template_mask, dtype=bool)
