+BG = 0
+GREY = 5
+COLOR_ORDER = (1, 2, 3, 4, 6, 7, 8, 9)
+ORDER_INDEX = {color: i for i, color in enumerate(COLOR_ORDER)}
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
