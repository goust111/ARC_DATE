+        r0, c0 = info["origin"]
+        mask = np.asarray(info["mask"], dtype=bool)
+        for dr, dc in np.argwhere(mask):
+            expected[pr0 + int(r0) + int(dr), pc0 + int(c0) + int(dc)] = int(dominant)
