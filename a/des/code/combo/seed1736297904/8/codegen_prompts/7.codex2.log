+    q = deque(starts)
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {cell: None for cell in starts}
+    while q:
+        r, c = q.popleft()
+        if (r, c) in targets:
+            path: list[tuple[int, int]] = []
+            cur: tuple[int, int] | None = (r, c)
+            while cur is not None:
+                path.append(cur)
+                cur = prev[cur]
+            path.reverse()
+            return path
