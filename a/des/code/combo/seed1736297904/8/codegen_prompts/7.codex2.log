+        return None
+
+    match_lookup: dict[tuple[tuple[int, int], bytes], tuple[int, int]] = {}
+    for info in placements:
+        mask = np.asarray(info["mask"], dtype=bool)
+        origin = tuple(info["origin"])
+        matches = _find_exact_matches(connected, mask)
+        if matches != [origin]:
+            return None
