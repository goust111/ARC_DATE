@lru_cache(None)
def _mask_options(h: int, w: int, area: int) -> tuple[tuple[int, ...], ...]:
    total = int(h) * int(w)
    holes = total - int(area)
    out: list[tuple[int, ...]] = []
    for removed in itertools.combinations(range(total), holes):
        mask = np.ones((h, w), dtype=bool)
