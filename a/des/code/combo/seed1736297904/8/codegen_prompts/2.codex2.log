+        arrow = _detect_arrow(comp["coords"])
+        if arrow is not None:
+            assert color not in arrow_colors, "same color cannot have two arrows"
+            arrow["color"] = color
+            arrow["coords"] = comp["coords"]
+            arrows.append(arrow)
+            arrow_colors.add(color)
