+def _neighbors4(r: int, c: int, h: int, w: int) -> Iterable[tuple[int, int]]:
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
