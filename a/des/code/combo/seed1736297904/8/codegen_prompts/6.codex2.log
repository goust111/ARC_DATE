+    elif mode == "horizontal_spine":
+        rows = _sample_spaced(3, SEED_MARGIN, height - 1 - SEED_MARGIN, 3)
+        cols = _sample_spaced(4, SEED_MARGIN, width - 1 - SEED_MARGIN, 2)
+        if rows is None or cols is None:
