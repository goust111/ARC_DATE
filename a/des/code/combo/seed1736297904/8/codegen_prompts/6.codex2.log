+            return None
+        seeds = {
+            colors[0]: [(rows[0], cols[1]), (rows[3], cols[1])],
+            colors[1]: [(rows[1], cols[0]), (rows[1], cols[2])],
+            colors[2]: [(rows[2], cols[0]), (rows[2], cols[2])],
+        }
+    elif mode == "horizontal_spine":
