+def _cells_to_mask(cells: set[tuple[int, int]]) -> tuple[np.ndarray, tuple[tuple[int, int], ...], int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    min_r, max_r = min(rows), max(rows)
+    min_c, max_c = min(cols), max(cols)
+    h = int(max_r - min_r + 1)
+    w = int(max_c - min_c + 1)
