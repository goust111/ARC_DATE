+
+
+def _contact_count(a_cells: set[tuple[int, int]], b_cells: set[tuple[int, int]]) -> int:
+    total = 0
+    for r, c in a_cells:
+        for dr, dc in DIR4:
+            if (r + dr, c + dc) in b_cells:
