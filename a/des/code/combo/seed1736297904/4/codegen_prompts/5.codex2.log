+    cells = [(int(r), int(c)) for r, c in np.argwhere(tight)]
+    cell_set = set(cells)
+    boundary: dict[tuple[int, int], list[tuple[int, int]]] = {d: [] for d in DIR4}
+    for r, c in cells:
+        for dr, dc in DIR4:
