+    mask = np.ones((rows * hole_h + rows + 1, cols * hole_w + cols + 1), dtype=bool)
+    slots = [(r, c) for r in range(rows) for c in range(cols)]
+    chosen = random.sample(slots, hole_count)
+    for sr, sc in chosen:
