+    pair_options: list[list[list[tuple[tuple[int, int], int]]]] = [[[] for _ in range(n)] for _ in range(n)]
+    for i in range(n):
+        for j in range(n):
+            if i != j:
+                pair_options[i][j] = _pair_offsets(pieces[i], pieces[j])
