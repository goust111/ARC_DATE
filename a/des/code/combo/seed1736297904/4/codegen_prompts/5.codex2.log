+    while len(assigned) < len(cells):
+        choices: list[tuple[int, tuple[int, int]]] = []
+        weights: list[float] = []
+        for idx, frontier in enumerate(frontiers):
+            if not frontier:
+                continue
+            weight = 1.0 / float(len(pieces[idx]) + 1)
+            for cell in frontier:
