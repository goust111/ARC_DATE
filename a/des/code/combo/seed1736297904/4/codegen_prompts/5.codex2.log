+    return placements
+
+
+def _expected_output(mask: np.ndarray, palette_colors: list[int], hole_count: int) -> np.ndarray:
+    out = np.full(mask.shape, BG, dtype=int)
+    out[mask] = int(palette_colors[hole_count - 1])
