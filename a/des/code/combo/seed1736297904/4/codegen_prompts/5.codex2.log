+    objects: list[dict] = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        mask = np.zeros_like(patch, dtype=bool)
+        colors = set()
+        for r, c in coords:
