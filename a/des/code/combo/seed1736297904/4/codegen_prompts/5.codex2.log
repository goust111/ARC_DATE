+    placed_offsets: dict[int, tuple[int, int]] = {0: (0, 0)}
+    placed_cells: dict[int, set[tuple[int, int]]] = {0: set(pieces[0]["cell_set"])}
+    union_cells = set(pieces[0]["cell_set"])
