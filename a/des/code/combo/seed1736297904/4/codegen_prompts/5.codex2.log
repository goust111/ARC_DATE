+def _make_holey_shape(hole_count: int) -> np.ndarray:
+    layouts: list[tuple[int, int]] = []
+    for rows in (1, 2):
+        cols = (hole_count + rows - 1) // rows
+        if rows * cols >= hole_count:
+            layouts.append((rows, cols))
+    rows, cols = random.choice(layouts)
