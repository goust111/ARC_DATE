+        for c in range(w):
+            if not bg_mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_edge = r == 0 or r == h - 1 or c == 0 or c == w - 1
+            while q:
+                cr, cc = q.popleft()
+                for dr, dc in DIR4:
