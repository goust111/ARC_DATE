+def _neighbors(cell: tuple[int, int], cell_set: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r + dr, c + dc) for dr, dc in DIR4 if (r + dr, c + dc) in cell_set]
