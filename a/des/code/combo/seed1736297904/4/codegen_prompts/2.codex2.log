+def _spec_rect(spec: dict) -> tuple[int, int, int, int]:
+    if spec["orientation"] == "h":
+        return spec["r"] - spec["d"], spec["c0"], spec["r"] + spec["d"], spec["c1"]
+    return spec["r0"], spec["c"] - spec["d"], spec["r1"], spec["c"] + spec["d"]
