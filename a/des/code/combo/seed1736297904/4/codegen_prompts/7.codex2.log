+        return None
+
+    expected = _render_expected(grid.shape, boxes_by_color, counts_by_color, [int(c) for c in bar_colors])
+    try:
+        solved = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+
+    return grid
