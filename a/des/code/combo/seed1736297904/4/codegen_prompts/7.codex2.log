+GRID_W_RANGE = (18, 30)
+N_COLORS_RANGE = (2, 4)
+BAR_GAP_RANGE = (2, 4)
+BAR_RIGHT_MARGIN_OPTIONS = (0, 1)
+OVERLAP_PROB = 0.5
+GEN_ATTEMPTS = 500
+PLACEMENT_TRIES = 200
+
+PATTERN_LIBRARY: dict[int, list[tuple[int, int, tuple[tuple[int, int], ...]]]] = {
+    3: [
+        (2, 3, ((0, 0), (0, 2), (1, 1))),
+        (3, 2, ((0, 0), (1, 1), (2, 0))),
+        (3, 3, ((0, 0), (0, 2), (2, 1))),
+    ],
+    4: [
+        (2, 4, ((0, 0), (0, 2), (1, 1), (1, 3))),
+        (4, 2, ((0, 0), (1, 1), (2, 0), (3, 1))),
+        (3, 3, ((0, 0), (0, 2), (2, 0), (2, 2))),
+    ],
+    5: [
+        (3, 4, ((0, 0), (0, 2), (1, 3), (2, 0), (2, 2))),
+        (4, 3, ((0, 0), (0, 2), (1, 1), (2, 0), (3, 1))),
+    ],
+    6: [
+        (3, 4, ((0, 0), (0, 2), (1, 1), (1, 3), (2, 0), (2, 2))),
+        (4, 3, ((0, 0), (0, 2), (1, 1), (2, 0), (2, 2), (3, 1))),
