+import numpy as np
+
+
+BG = 0
+ORANGE = 7
+MAROON = 9
+BORDER_PALETTE = (1, 2, 3, 4, 5, 6, 8)
+SIDES = ("top", "bottom", "left", "right")
+MODE_SHAPES = {
+    "none": ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (2, 3), (3, 2)),
+    "partial": ((1, 3), (3, 1), (2, 2), (2, 3), (3, 2)),
+    "all_connected": ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2)),
