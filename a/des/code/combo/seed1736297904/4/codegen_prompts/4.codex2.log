+        for j in range(i + 1, len(frames)):
+            br0, bc0, br1, bc1 = frames[j]["bbox"]
+            if ac1 == bc0:
+                row0 = max(ar0, br0)
+                row1 = min(ar1, br1)
+                if row0 < row1:
+                    edges.append((i, j, "right", "left", (row0, row1, ac1, 1)))
+            elif bc1 == ac0:
+                row0 = max(ar0, br0)
+                row1 = min(ar1, br1)
+                if row0 < row1:
+                    edges.append((i, j, "left", "right", (row0, row1, ac0, 1)))
+            elif ar1 == br0:
+                col0 = max(ac0, bc0)
+                col1 = min(ac1, bc1)
+                if col0 < col1:
+                    edges.append((i, j, "bottom", "top", (col0, col1, ar1, 0)))
