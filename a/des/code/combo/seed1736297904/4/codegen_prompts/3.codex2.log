+def _gen_attempt() -> Optional[np.ndarray]:
+    tile_rows = random.randint(*GEN_TILE_ROW_RANGE)
+    tile_cols = random.randint(*GEN_TILE_COL_RANGE)
+    tile_h = random.randint(*GEN_TILE_HEIGHT_RANGE)
