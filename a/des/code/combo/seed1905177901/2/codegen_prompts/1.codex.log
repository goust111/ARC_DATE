+    return out
+
+
+# --------------- generator ---------------
+
+GRID_SHAPES = ((2, 2), (2, 3), (3, 2))
+PANEL_H_RANGE = (7, 10)
+PANEL_W_RANGE = (7, 10)
+BG = 0
+SEP = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
