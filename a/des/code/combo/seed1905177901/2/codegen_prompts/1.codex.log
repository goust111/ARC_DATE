+        else:
+            patch[:, depth:] = color
+            patch[slot_top : slot_top + slot_h, total_w - depth :] = BG
+            patch[slot_top : slot_top + slot_h, :depth] = color
+            rect = (top, top + base_h, left + depth, left + total_w)
