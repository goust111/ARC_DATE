+    directions: dict[tuple[int, int], str] = {}
+    notch_sizes: dict[tuple[int, int], tuple[int, int]] = {}
+    for orient, a, b in tile:
+        if orient == "h":
+            depth = random.randint(1, 2)
+            slot_h = random.randint(2, panel_h - 2)
+            shared = (slot_h, depth)
