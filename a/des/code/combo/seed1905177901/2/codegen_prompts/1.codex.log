+def _build_expected(
+    directions: dict[tuple[int, int], str],
+    rects: dict[tuple[int, int], tuple[int, int, int, int]],
+    colors: dict[tuple[int, int], int],
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    sep_rows: list[int],
+    sep_cols: list[int],
+    shape: tuple[int, int],
