+    spans: list[tuple[int, int]] = []
+    start = 0
+    for sep in separators:
+        if start >= sep:
+            return []
+        spans.append((start, sep))
+        start = sep + 1
+    if start >= size:
+        return []
+    spans.append((start, size))
+    return spans
