+        return None
+
+    sep_rows, row_spans = _panel_spans(rows, panel_h)
+    sep_cols, col_spans = _panel_spans(cols, panel_w)
+    grid_h = rows * panel_h + len(sep_rows)
+    grid_w = cols * panel_w + len(sep_cols)
+    grid = np.full((grid_h, grid_w), BG, dtype=int)
