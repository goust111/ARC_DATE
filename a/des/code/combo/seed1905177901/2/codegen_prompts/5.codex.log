+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor 3x3 node blocks from the colors of their incoming paths.
+
+    This version uses a fixed visible path-color legend instead of illegal
+    color-id ordering:
+    - 1: left -> right
+    - 2: right -> left
+    - 3: top -> bottom
+    - 4: bottom -> top
+
