+SHORT_SIDE_MAX = 4
+LONG_SIDE_MAX = 6
+AREA_CAP = 16
+GRID_LIMIT = 30
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _make_connected_mask(h: int, w: int, area: int) -> np.ndarray:
+    assert h >= 1 and w >= 1 and h != w
+    min_area = h + w - 1
+    assert min_area <= area <= h * w
+
+    mask = np.zeros((h, w), dtype=bool)
+    r = c = 0
+    mask[r, c] = True
+
+    steps = ["D"] * (h - 1) + ["R"] * (w - 1)
+    random.shuffle(steps)
