+        grid = _place_objects(specs, height, width)
+        if grid is None:
+            continue
+        if np.array_equal(main(grid), expected):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
