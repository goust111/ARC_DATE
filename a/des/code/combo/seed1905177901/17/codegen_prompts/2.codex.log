+def _bresenham(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    """Return the rasterized line between two endpoints, inclusive."""
+    points: list[tuple[int, int]] = []
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
+    r, c = r0, c0
+    while True:
+        points.append((r, c))
+        if r == r1 and c == c1:
+            return points
+        err2 = err * 2
+        if err2 > -dr:
+            err -= dr
+            c += sc
+        if err2 < dc:
+            err += dc
+            r += sr
