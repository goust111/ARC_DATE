+import numpy as np
+
+
+BLACK = 0
+FRAME = 5
+PALETTE = tuple(c for c in range(10) if c not in (BLACK, FRAME))
+
+GRID_HEIGHT_RANGE = (16, 24)
+GRID_WIDTH_RANGE = (16, 24)
+LEGEND_LEN_RANGE = (4, 6)
+CONTAINER_COUNT_RANGE = (2, 5)
+MARKER_COUNT_RANGE = (2, 4)
