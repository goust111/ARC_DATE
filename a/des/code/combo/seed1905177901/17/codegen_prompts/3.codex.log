+
+    order: list[int] = []
+    seen: set[int] = set()
+    for c in best_cols.tolist():
+        color = int(grid[best_row, int(c)])
+        if color != BLACK and color not in seen:
+            seen.add(color)
+            order.append(color)
+    return order
