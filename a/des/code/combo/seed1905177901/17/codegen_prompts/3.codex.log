+def _axis_positions(length: int, count: int) -> list[int]:
+    if count == 1:
+        return [length // 2]
+    vals = np.rint(np.linspace(0, length - 1, count)).astype(int).tolist()
+    assert len(set(vals)) == count
+    return [int(v) for v in vals]
