+def _panel_spans(count: int, size: int, sep_w: int, border_w: int) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    pos = border_w
+    for idx in range(count):
+        spans.append((pos, pos + size))
+        pos += size
+        if idx < count - 1:
