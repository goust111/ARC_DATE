+        if not frontier:
+            break
+        nxt = frontier[_RNG.randrange(len(frontier))]
+        cell_set.add(nxt)
+        cells.append(nxt)
+
+    if len(cells) < 2:
+        return None
+    return cells
+
+
+def _is_rotationally_distinct(tile: np.ndarray) -> bool:
