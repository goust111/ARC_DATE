+            k = int(np.count_nonzero(cell == MARKER_COLOR))
+            if k == 0:
+                continue
+            assert 1 <= k <= len(templates), "marker count must index an existing template"
+            out[r0:r1, c0:c1] = _scale_template(templates[k - 1], cell_size)
+
+    return out
+
+
