+            segment = {
+                "axis": "V",
+                "color": color,
+                "length": int(local_row - start),
+                "col": int(col0 + local_col),
+                "row0": int(row0 + start),
+                "row1": int(row0 + local_row - 1),
+            }
+            if best is None:
+                best = segment
+            elif segment["length"] > best["length"]:
+                best = segment
+            elif segment["length"] == best["length"] and (segment["col"], segment["row0"]) < (best["col"], best["row0"]):
