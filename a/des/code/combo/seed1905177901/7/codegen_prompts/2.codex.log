+
+
+def _can_place(cells: np.ndarray, occupied: np.ndarray) -> bool:
+    height, width = map(int, occupied.shape)
+    for row, col in cells:
+        r = int(row)
+        c = int(col)
+        if r <= 0 or c <= 0 or r >= height - 1 or c >= width - 1:
+            return False
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if occupied[r + dr, c + dc]:
