+def _make_horizontal_shape(rng: np.random.Generator) -> np.ndarray:
+    length = int(rng.integers(SKELETON_LENGTH_MIN, SKELETON_LENGTH_MAX + 1))
+    coords = {(0, col) for col in range(length)}
