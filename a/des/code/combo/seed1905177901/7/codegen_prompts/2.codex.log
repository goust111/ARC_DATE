+def _component_mask(component: dict) -> tuple[np.ndarray, int, int]:
+    coords = component["coords"]
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    row0 = int(rows.min())
+    col0 = int(cols.min())
+    row1 = int(rows.max())
+    col1 = int(cols.max())
