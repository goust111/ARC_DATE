+    except AssertionError:
+        return None
+
+    if out.size == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_TRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

