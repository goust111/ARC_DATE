+def _normalize_coords(coords) -> np.ndarray:
+    arr = np.asarray(list(coords), dtype=int)
+    arr = np.unique(arr, axis=0)
+    arr = arr - arr.min(axis=0, keepdims=True)
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
