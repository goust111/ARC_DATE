+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+SIDES = ("top", "bottom", "left", "right")
+
+_RNG = np.random.default_rng()
+
+MIN_FRAME_H = 4
+MAX_FRAME_H = 9
+MIN_FRAME_W = 4
+MAX_FRAME_W = 10
+
