+    out = np.full(grid_shape, BG, dtype=int)
+    for obj, (r0, c0) in zip(objects, placements):
+        _paste(inp, obj["input"], r0, c0)  # type: ignore[index]
+        _paste(out, obj["output"], r0, c0)  # type: ignore[index]
+
+    return inp, out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    for _ in range(40):
