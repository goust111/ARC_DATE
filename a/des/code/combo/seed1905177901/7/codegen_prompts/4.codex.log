+    h_lo, h_hi = GRID_H_BY_COLOR_COUNT[n_colors]
+    w_lo, w_hi = GRID_W_BY_COLOR_COUNT[n_colors]
+    h = int(rng.integers(h_lo, h_hi + 1))
+    w = int(rng.integers(w_lo, w_hi + 1))
