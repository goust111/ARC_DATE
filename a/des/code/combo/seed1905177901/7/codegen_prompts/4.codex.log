+        if built is None:
+            continue
+        inp, out = built
+        try:
+            if np.array_equal(main(inp), out):
+                return inp
+        except Exception:
+            continue
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

