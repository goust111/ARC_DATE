+
+def _sample_pair_dims(rng: np.random.Generator) -> tuple[int, int, int, int]:
+    src_h, src_w = _sample_dims(rng)
+    dst_h, dst_w = _sample_dims(rng)
+    while (src_h, src_w) == (dst_h, dst_w):
