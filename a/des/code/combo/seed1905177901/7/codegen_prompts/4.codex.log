+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    rel = coords - np.array([r0, c0], dtype=int)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "mask": mask,
+    }
+
+
