+    ids[1][2] = ids[0][2]  # horizontal branch: same as above
+    ids[2][1] = _pick_index(pool_size, {ids[1][1], ids[2][0]}, rng)  # rotate branch
+
+    for i in range(1, order):
+        for j in range(1, order):
