    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER


def _gen_place_marker(grid, side):
    if side == "top":
        grid[0, :] = GEN_MARKER_COLOR
    elif side == "right":
        grid[:, -1] = GEN_MARKER_COLOR
    elif side == "bottom":
        grid[-1, :] = GEN_MARKER_COLOR
    else:
