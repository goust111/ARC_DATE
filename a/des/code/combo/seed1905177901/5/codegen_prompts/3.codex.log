def _reflect_source(out, source, cr, cc):
    reflected = []
    for r, c in source:
        rr = 2 * cr - r
        rc = 2 * cc - c
        if out[rr, rc] != BG_COLOR:
            return None
        out[rr, rc] = out[r, c]
        reflected.append((rr, rc))
    return reflected


