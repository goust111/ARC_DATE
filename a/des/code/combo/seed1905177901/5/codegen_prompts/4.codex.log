+def _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:
+    h, w = out.shape
+    side = max(0, int(side))
+    if corner == "TL":
+        for dr in range(min(h, side)):
+            width = min(w, side - dr)
+            if width > 0:
+                out[dr, :width] = color
+    elif corner == "TR":
+        for dr in range(min(h, side)):
+            width = min(w, side - dr)
+            if width > 0:
+                out[dr, w - width : w] = color
+    elif corner == "BL":
+        for dr in range(min(h, side)):
+            width = min(w, side - dr)
+            if width > 0:
+                out[h - 1 - dr, :width] = color
+    else:
+        for dr in range(min(h, side)):
+            width = min(w, side - dr)
+            if width > 0:
+                out[h - 1 - dr, w - width : w] = color
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _background_color(g)
+    out = np.full_like(g, bg)
+    for obj in _extract_objects(g, bg):
+        _paint_corner_triangle(
+            out,
+            str(obj["corner"]),
+            int(obj["markers"]) + 2,
+            int(obj["color"]),
