+    "BL": ((0, 0), (0, 1), (1, 1)),
+    "BR": ((0, 0), (0, 1), (1, 0)),
+}
+MISSING_TO_CORNER = {
+    (0, 0): "TL",
+    (0, 1): "TR",
+    (1, 0): "BL",
+    (1, 1): "BR",
+}
