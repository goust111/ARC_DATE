+def _gen_attempt() -> np.ndarray | None:
+    kind = random.choices(["clear", "dense", "overlap"], weights=[4, 3, 3], k=1)[0]
+    if kind == "overlap":
+        layout = _build_overlap_layout()
+    else:
+        layout = _build_template_layout(kind)
