+    for step in range(1, int(hx) + 1):
+        if col - step >= 0:
+            cells.add((int(row), int(col - step)))
+        if col + step < width:
+            cells.add((int(row), int(col + step)))
+    for step in range(1, int(vy) + 1):
+        if row - step >= 0:
+            cells.add((int(row - step), int(col)))
+        if row + step < height:
+            cells.add((int(row + step), int(col)))
+    return cells
