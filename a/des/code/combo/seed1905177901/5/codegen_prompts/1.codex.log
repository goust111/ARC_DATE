+    coords = np.argwhere(mask)
+    pixels = {tuple(map(int, coord)) for coord in coords}
+    count = 0
+    for r, c in pixels:
+        degree = sum((nr, nc) in pixels for nr, nc in _neighbors4(r, c))
+        if degree == 1:
+            count += 1
+    return count
