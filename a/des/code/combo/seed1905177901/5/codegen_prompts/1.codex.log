+        window[patch == OBJECT] = OBJECT
+
+    if len(_components(grid == OBJECT)) != len(items):
+        return None
+
+    expected = _build_expected(grid, items, placements, legend_top, legend_colors)
+    if np.array_equal(main(grid), expected):
