+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(h, w, rr, cc):
+                    if seen[nr, nc] or int(grid[nr, nc]) != int(color):
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(comp)
+    return comps
