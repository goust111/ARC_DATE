+    pts = list(cells)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _infer_direction(cells: set[tuple[int, int]]) -> tuple[int, int]:
+    r0, c0, r1, c1 = _bbox(cells)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if w > h:
