  "transform": "replace each marker pixel by the matching pixel from its horizontal/vertical reflection orbit; use the transposed top/left-strip counterpart when that orbit is also hidden",
  "grid_shape": "crop to marker bbox"
}
</annotation>
</reference_puzzle>

