+
+def _base_arc_masks(size: int, radius: int) -> tuple[np.ndarray, np.ndarray]:
+    m = size // 2
+    outer = np.zeros((size, size), dtype=bool)
+    inner = np.zeros((size, size), dtype=bool)
+
+    r2_min = radius * radius
+    r2_max = (radius + 1) * (radius + 1)
