+    counts: dict[int, int] = {}
+    order: list[int] = []
+    for value in values:
+        if value not in counts:
+            order.append(value)
+            counts[value] = 0
+        counts[value] += 1
+    best = order[0]
+    best_count = counts[best]
+    tie = False
+    for value in order[1:]:
+        count = counts[value]
+        if count > best_count:
