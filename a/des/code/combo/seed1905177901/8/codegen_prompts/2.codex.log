+COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+TOP = "top"
+BOTTOM = "bottom"
+LEFT = "left"
+RIGHT = "right"
