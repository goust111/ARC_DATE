+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _strict_mode(values: list[int]) -> int | None:
+    if not values:
+        return None
+    counts: dict[int, int] = {}
+    order: list[int] = []
+    for value in values:
+        if value not in counts:
+            order.append(value)
+            counts[value] = 0
+        counts[value] += 1
+    best = order[0]
+    best_count = counts[best]
+    tie = False
+    for value in order[1:]:
+        count = counts[value]
+        if count > best_count:
+            best = value
+            best_count = count
+            tie = False
+        elif count == best_count:
+            tie = True
+    return None if tie else best
+
+
+def _window_votes(grid: np.ndarray, coords: list[tuple[int, int]], bg: int) -> list[int]:
+    h, w = grid.shape
+    r0, c0, r1, c1 = _bbox(coords)
+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    bg_mask = region == bg
+
+    votes: list[int] = []
+    for comp in _components_bool(bg_mask):
+        boundary_cells = [
+            (rr, cc)
+            for rr, cc in comp
+            if rr == 0 or rr == bg_mask.shape[0] - 1 or cc == 0 or cc == bg_mask.shape[1] - 1
