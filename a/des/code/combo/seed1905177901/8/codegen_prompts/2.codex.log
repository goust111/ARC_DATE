+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {GENERATION_ATTEMPTS} attempts")

