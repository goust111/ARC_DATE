+    col_hits = np.where(np.all(grid == MARKER, axis=0))[0]
+    if len(row_hits) == 1 and len(col_hits) == 0:
+        return "h", int(row_hits[0])
+    if len(col_hits) == 1 and len(row_hits) == 0:
+        return "v", int(col_hits[0])
