+def _place_below(
+    grid: np.ndarray,
+    input_reserved: np.ndarray,
+    line: int,
+    color: int,
+    must_survive: bool,
+) -> bool:
+    h, w = grid.shape
+    valid_distances = []
+    for d in range(1, 4):
+        max_h = min(6, h - line - d - 2)
