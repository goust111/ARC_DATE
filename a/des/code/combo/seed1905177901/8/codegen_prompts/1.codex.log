+    if pts.size == 0:
+        return out
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    for r in range(int(r0) + radius, int(r1) - radius + 1):
+        for c in range(int(c0) + radius, int(c1) - radius + 1):
+            if mask[r, c] and np.all(mask[r - radius : r + radius + 1, c - radius : c + radius + 1]):
+                out[r, c] = True
+    return out
