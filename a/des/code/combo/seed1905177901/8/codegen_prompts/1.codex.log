+
+def _make_shape(h: int, w: int) -> np.ndarray:
+    mask = np.ones((h, w), dtype=bool)
+    modes = ["rect", "rect", "rect", "corner"]
+    mode = random.choice(modes)
+    if mode == "corner" and h >= 3 and w >= 3:
