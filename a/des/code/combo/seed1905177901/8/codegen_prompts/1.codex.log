+    valid_distances = []
+    for d in range(1, 4):
+        max_h = min(6, h - line - d - 2)
+        max_w = min(6, w - 2)
+        if max_h < 2 or max_w < 2:
+            continue
+        if must_survive:
+            if max_h >= 2 * d + 1 and max_w >= 2 * d + 1:
+                valid_distances.append(d)
+        else:
+            if max_h >= 2:
+                valid_distances.append(d)
