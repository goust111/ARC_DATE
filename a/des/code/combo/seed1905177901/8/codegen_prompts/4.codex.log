+def _random_connected_mask(height: int, width: int, anchor: tuple[int, int]) -> np.ndarray:
+    area_lo = max(1, (height * width + 3) // 4)
+    area_hi = max(area_lo, height * width - random.randint(0, max(0, (height * width) // 3)))
