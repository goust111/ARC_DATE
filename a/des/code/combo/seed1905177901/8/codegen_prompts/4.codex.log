+
+
+def _object_patch(color: int, side: str) -> tuple[np.ndarray, tuple[int, int]]:
+    for _ in range(40):
+        height = random.randint(1, 5)
+        width = random.randint(1, 5)
+        if height == width == 1 and random.random() < 0.8:
+            continue
