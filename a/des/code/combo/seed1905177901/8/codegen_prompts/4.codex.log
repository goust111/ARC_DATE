+        target_shape = (r1 - r0 + 1, c1 - c0 + 1)
+        masks = [_component_mask(components[obj_id]) for obj_id in info["object_ids"]]
+        overlay = _resize_mask(masks[0], target_shape) | _resize_mask(masks[1], target_shape)
