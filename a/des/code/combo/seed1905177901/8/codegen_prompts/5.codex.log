+            for r in range(BLOCK_SIZE):
+                for c in range(BLOCK_SIZE):
+                    nr = int(br0 + r + dr * tail_len)
+                    nc = int(bc0 + c + dc * tail_len)
+                    if 0 <= nr < sub.shape[0] and 0 <= nc < sub.shape[1]:
