+
+def _paint_region(
+    region: np.ndarray,
+    move_dir: tuple[int, int],
+    clipped: bool,
+    block_color: int,
+    tail_color: int,
+    rng: random.Random,
+) -> dict[str, object]:
+    height, width = map(int, region.shape)
+    tail_len, block_top = _choose_placement(rng, height, width, move_dir, clipped)
+
+    br, bc = block_top
