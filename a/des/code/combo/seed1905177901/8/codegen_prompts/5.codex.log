+    col_bounds = []
+    cursor = 1
+    for size in col_sizes:
+        col_bounds.append((int(cursor), int(cursor + size - 1)))
+        cursor += size
+        grid[:, cursor] = SEPARATOR
+        cursor += 1
+
+    regions = [
