+TARGET_ROW_RANGE = (2, 4)
+TARGET_COL_RANGE = (2, 5)
+CELL_HEIGHT_RANGE = (6, 8)
+CELL_WIDTH_RANGE = (6, 8)
+SEPARATOR_THICKNESS_CHOICES = [1, 2]
