+    width = total_cols * cell_w + (total_cols - 1) * sep
+
+    inp = np.full((height, width), BACKGROUND, dtype=int)
+    for k in range(1, total_rows):
+        r0 = k * cell_h + (k - 1) * sep
+        inp[r0 : r0 + sep, :] = SEPARATOR
+    for k in range(1, total_cols):
+        c0 = k * cell_w + (k - 1) * sep
+        inp[:, c0 : c0 + sep] = SEPARATOR
