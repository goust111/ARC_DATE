+    colors = {int(x) for x in np.unique(cell)}
+    assert colors.issubset({bg, separator}), "column legend cell must use only background and separator colors"
+    mask = cell == separator
+    assert np.any(mask), "column legend cell must contain a shape"
+    return mask
