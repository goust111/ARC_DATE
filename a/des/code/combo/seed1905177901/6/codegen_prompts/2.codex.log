+            c1 = int(coords_arr[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[coords_arr[:, 0] - r0, coords_arr[:, 1] - c0] = True
+            uniq_colors = sorted(set(colors))
+            comps.append(
