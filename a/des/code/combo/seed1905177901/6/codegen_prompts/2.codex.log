+    out: list[list[tuple[int, int]]] = []
+
+    def rec(unmatched: tuple[int, ...], cur: list[tuple[int, int]]) -> None:
+        if len(out) >= limit:
+            return
+        if not unmatched:
+            out.append(cur.copy())
+            return
+        i = unmatched[0]
+        for j in unmatched[1:]:
+            key = (i, j)
