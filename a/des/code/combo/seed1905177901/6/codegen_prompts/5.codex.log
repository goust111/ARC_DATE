+    slender_count, compact_count = random.choice(((2, 2), (2, 3), (3, 2), (3, 3)))
+    total = slender_count + compact_count
+    colors = random.sample(INPUT_PALETTE, total)
+    objects: list[dict] = []
+
+    for idx in range(slender_count):
