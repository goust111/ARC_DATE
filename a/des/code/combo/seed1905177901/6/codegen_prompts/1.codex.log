+    grid[top + 1 : bottom, left] = YELLOW
+    grid[top + 1 : bottom, right] = BLUE
+
+
+def _draw_legend(grid: np.ndarray, row: int, frame_left: int, frame_w: int, colors: list[int]) -> None:
+    gaps = [random.randint(0, 2) for _ in range(3)]
