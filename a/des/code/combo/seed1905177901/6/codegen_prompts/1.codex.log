+
+
+def _sample_hole_counts(modes: list[str]) -> list[int]:
+    hole_counts = [random.randint(0, 3) for _ in modes]
+    touch_idx = [i for i, mode in enumerate(modes) if mode != "free"]
+    free_idx = [i for i, mode in enumerate(modes) if mode == "free"]
