+        grid_h = frame_top + frame_h + bottom_margin
+    else:
+        frame_top = top_margin
+        legend_row = frame_top + frame_h + legend_gap
+        grid_h = legend_row + 1 + bottom_margin
+
+    frame_left = left_margin
+    grid_w = frame_left + frame_w + right_margin
