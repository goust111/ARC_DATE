+    return counts
+
+
+def _sample_modes(n_objects: int) -> list[str]:
+    touch_count = random.randint(1, min(2, n_objects - 1))
+    touch_modes: list[str] = []
+    pool = ["top", "bottom", "left", "right", "top_left", "top_right", "bottom_left", "bottom_right"]
