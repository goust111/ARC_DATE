+    "top": RED,
+    "right": BLUE,
+    "bottom": GREEN,
+    "left": YELLOW,
+}
+SIDE_ORDER = ("top", "right", "bottom", "left")
+CORNER_SIDES = {
+    "top_left": ("top", "left"),
+    "top_right": ("top", "right"),
+    "bottom_left": ("bottom", "left"),
+    "bottom_right": ("bottom", "right"),
+}
+LEGEND_POOL = (6, 7, 8, 9)
