+    priority = {**{name: 0 for name in CORNER_SIDES}, "top": 1, "right": 1, "bottom": 1, "left": 1, "free": 2}
+    specs.sort(key=lambda spec: (priority[spec["mode"]], -int(spec["mask"].sum())))
