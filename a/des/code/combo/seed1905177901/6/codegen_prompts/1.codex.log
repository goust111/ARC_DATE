+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SIDE_COLORS = {
+    "top": RED,
+    "right": BLUE,
+    "bottom": GREEN,
+    "left": YELLOW,
+}
+SIDE_ORDER = ("top", "right", "bottom", "left")
+CORNER_SIDES = {
+    "top_left": ("top", "left"),
+    "top_right": ("top", "right"),
+    "bottom_left": ("bottom", "left"),
+    "bottom_right": ("bottom", "right"),
+}
+LEGEND_POOL = (6, 7, 8, 9)
