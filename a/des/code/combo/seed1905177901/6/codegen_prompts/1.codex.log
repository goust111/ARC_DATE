+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SIDE_COLORS = {
+    "top": RED,
+    "right": BLUE,
+    "bottom": GREEN,
+    "left": YELLOW,
