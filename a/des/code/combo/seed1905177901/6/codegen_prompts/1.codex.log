+
+
+def _dimension_choices(hole_count: int, mode: str) -> list[tuple[int, int]]:
+    choices: list[tuple[int, int]] = []
+    for h in range(3, 9):
+        for w in range(3, 9):
+            if hole_count == 2 and max(h, w) < 5:
