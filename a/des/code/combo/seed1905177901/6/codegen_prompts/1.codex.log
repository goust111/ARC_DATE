+    if not any(hole_counts[i] > 0 for i in touch_idx):
+        hole_counts[random.choice(touch_idx)] = random.randint(1, 3)
+    if len(touch_idx) > 1 and len({hole_counts[i] for i in touch_idx}) == 1:
