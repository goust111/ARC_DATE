+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _build_input()
+        if grid is not None:
+            return grid
