+        hole_counts[random.choice(free_idx)] = random.randint(1, 3)
+    return hole_counts
+
+
+def _draw_frame(grid: np.ndarray, top: int, left: int, inner_h: int, inner_w: int) -> None:
+    bottom = top + inner_h + 1
+    right = left + inner_w + 1
