+    right_rows = coords[cols == max_c, 0]
+    left_row = float(left_rows.mean())
+    right_row = float(right_rows.mean())
+    assert left_row != right_row, "stair direction must be unambiguous"
+    return -1 if right_row < left_row else 1
+
