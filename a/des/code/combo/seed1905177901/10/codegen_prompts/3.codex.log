+def _place_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = map(int, patch.shape)
+    sub = grid[top : top + h, left : left + w]
+    mask = patch != _BG
+    sub[mask] = patch[mask]
