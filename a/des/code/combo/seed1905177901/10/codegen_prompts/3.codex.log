+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        rmin, cmin = min(rows), min(cols)
+        norm = {(r - rmin, c - cmin) for r, c in cells}
+        h = 1 + max(r for r, _ in norm)
+        w = 1 + max(c for _, c in norm)
+        if max(h, w) > 7:
