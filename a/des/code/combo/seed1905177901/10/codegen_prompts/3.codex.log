        zone_h = int(_RNG.integers(total_h, total_h + 5))
        zone_w = int(_RNG.integers(max_w, max_w + 4))
    elif mode == "vclip":
        upper = max(max_h + 1, total_h)
        zone_h = int(_RNG.integers(max(2, max_h // 2 + 1), upper))
        zone_w = int(_RNG.integers(max_w, max_w + 4))
