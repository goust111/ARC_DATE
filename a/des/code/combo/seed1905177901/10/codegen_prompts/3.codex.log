+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in norm:
+            mask[r, c] = True
+
+        if bool(_RNG.integers(0, 2)):
+            mask = np.flipud(mask)
+        if bool(_RNG.integers(0, 2)):
+            mask = np.fliplr(mask)
+        if bool(_RNG.integers(0, 2)):
