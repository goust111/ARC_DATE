+def _can_place(occ: np.ndarray, top: int, left: int, h: int, w: int) -> bool:
+    hh, ww = map(int, occ.shape)
+    if top < 0 or left < 0 or top + h > hh or left + w > ww:
+        return False
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(hh, top + h + 1)
+    c1 = min(ww, left + w + 1)
+    return not bool(occ[r0:r1, c0:c1].any())
