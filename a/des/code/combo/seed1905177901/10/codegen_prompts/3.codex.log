    else:
        upper = max(max_h + 1, total_h)
        zone_h = int(_RNG.integers(max(2, max_h // 2 + 1), upper))
        zone_w = int(_RNG.integers(max(2, max_w // 2), max_w))

    return max(2, zone_h), max(2, zone_w)


