+    for i in range(len(objects)):
+        for j in range(i + 1, len(objects)):
+            a = objects[i]
+            b = objects[j]
+            ar0, ac0, ar1, ac1 = a["bbox"]
+            br0, bc0, br1, bc1 = b["bbox"]
+            col_overlap = _interval_overlap(ac0, ac1, bc0, bc1)
