+def _interval_overlap(a0: int, a1: int, b0: int, b1: int) -> tuple[int, int] | None:
+    lo = max(int(a0), int(b0))
+    hi = min(int(a1), int(b1))
+    if lo > hi:
+        return None
+    return int(lo), int(hi)
+
