+def _smaller_color(a: dict, b: dict) -> int:
+    if int(a["area"]) < int(b["area"]):
+        return int(a["color"])
+    if int(b["area"]) < int(a["area"]):
+        return int(b["color"])
+    return int(a["color"]) if tuple(a["bbox"]) <= tuple(b["bbox"]) else int(b["color"])
