def boundary(mask):
    h,w=mask.shape
    B=np.zeros_like(mask,bool)
    for r in range(h):
        for c in range(w):
            if not mask[r,c]: continue
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
