+def _edge_background_color(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    edge_vals = np.concatenate([grid[0], grid[h - 1], grid[1 : h - 1, 0], grid[1 : h - 1, w - 1]])
+    return int(Counter(map(int, edge_vals)).most_common(1)[0][0])
