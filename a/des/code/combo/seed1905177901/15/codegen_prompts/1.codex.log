+    grid = np.full((int(grid_h), int(grid_w)), BG_COLOR, dtype=int)
+    occupied_in = np.zeros((int(grid_h), int(grid_w)), dtype=bool)
+    occupied_out = np.zeros((int(grid_h), int(grid_w)), dtype=bool)
