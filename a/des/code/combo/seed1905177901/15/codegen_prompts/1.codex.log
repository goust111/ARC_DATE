+        "core": int(n_core),
+        "input_area": int(mask.sum()),
+        "scaled_area": int(scaled.sum()),
+    }
+
+
+def try_place_objects(
+    objects: list[dict],
+    grid_h: int,
+    grid_w: int,
+    rng: np.random.Generator,
