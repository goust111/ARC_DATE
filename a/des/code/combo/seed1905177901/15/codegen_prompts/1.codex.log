+    for r, c in coords:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                rr = int(r + dr)
+                cc = int(c + dc)
+                if 0 <= rr < height and 0 <= cc < width and occupied[rr, cc]:
