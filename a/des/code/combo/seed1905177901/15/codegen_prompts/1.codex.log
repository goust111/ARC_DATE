+
+def shrink_half(mask: np.ndarray) -> np.ndarray:
+    new_h = int(mask.shape[0] // 2)
+    new_w = int(mask.shape[1] // 2)
+    if new_h == 0 or new_w == 0:
+        return np.zeros((new_h, new_w), dtype=bool)
+    return mask[: new_h * 2 : 2, : new_w * 2 : 2].copy()
