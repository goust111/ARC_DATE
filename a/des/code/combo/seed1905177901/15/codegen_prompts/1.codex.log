+            and 0 < cc < mask.shape[1] - 1
+            and bool(mask[rr - 1, cc])
+            and bool(mask[rr + 1, cc])
+            and bool(mask[rr, cc - 1])
+            and bool(mask[rr, cc + 1])
+        ):
