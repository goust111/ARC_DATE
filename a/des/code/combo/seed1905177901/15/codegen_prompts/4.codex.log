+
+def _transform_patch(patch: np.ndarray, edge_count: int) -> np.ndarray | None:
+    if edge_count == 0:
+        return None
+    if edge_count == 1:
+        return np.fliplr(patch)
+    if edge_count == 2:
+        return np.rot90(patch, -1)
+    return patch.copy()
