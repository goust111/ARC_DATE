+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
