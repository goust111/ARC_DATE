+def _is_connected(mask: np.ndarray) -> bool:
+    points = np.argwhere(mask)
+    if len(points) == 0:
+        return False
+
+    stack = [tuple(map(int, points[0]))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
