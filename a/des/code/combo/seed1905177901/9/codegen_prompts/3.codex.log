    assert len(set(sizes)) == 1, "all cell intervals must have the same size"
    return intervals


def _separator_structure(grid: np.ndarray) -> tuple[int, list[tuple[int, int]], list[tuple[int, int]]]:
    g = np.asarray(grid, dtype=int)
