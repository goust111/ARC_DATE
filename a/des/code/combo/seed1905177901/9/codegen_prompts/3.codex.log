def _compress_runs(indices: list[int]) -> list[tuple[int, int]]:
    assert indices, "expected at least one separator index"
    runs: list[tuple[int, int]] = []
    start = end = int(indices[0])
    for idx in indices[1:]:
        idx = int(idx)
        if idx == end + 1:
            end = idx
        else:
            runs.append((start, end))
