+    if not _in_bounds(labels.shape, rr, cc):
+        return None
+    other = int(labels[rr, cc])
+    if other < 0 or other == obj_id:
+        return None
+
+    return {
+        "a": obj_id,
+        "b": other,
+        "start": (int(r), int(c)),
+        "end": (int(rr), int(cc)),
+        "path": gap_cells,
+        "gap": len(gap_cells),
