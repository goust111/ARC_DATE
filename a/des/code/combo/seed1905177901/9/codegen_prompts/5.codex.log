   177	def main(grid: np.ndarray) -> np.ndarray:
   178	    """
   179	    Transmit colored tokens along wire networks, converting each to its complementary 3×3 pattern.
   180	
   181	    Input structure:
   182	    - bg = background. Non-bg cells form wire networks and 3×3 tokens (solid blocks or X/diagonal patterns) near wire endpoints.
   183	
   184	    Rule:
   185	    - Every solid 3×3 token is replaced in-place by a diamond (center + 4 cardinal neighbors).
   186	    - Each token near a wire endpoint sends its complement to the opposite endpoint: solid emits X, X emits diamond.
   187	
   188	    Key insight: Token shape cycles solid → X → diamond; wires route each complement to the far end.
   189	    """
   190	    g = np.asarray(grid, dtype=int)
   191	    h, w = g.shape
   192	    bg = get_bg(g)
   193	
   194	    solids = _find_solid_3x3(g, bg)  # center -> (color, (r0,c0))
   195	    xs = _find_x_3x3(g, bg)  # center -> (color, (r0,c0))
   196	
   197	    # Build track mask: non-bg minus token cells.
   198	    track_mask = g != bg
   199	    for (cr, cc), (_, (r0, c0)) in solids.items():
   200	        track_mask[r0 : r0 + 3, c0 : c0 + 3] = False
   201	    for (cr, cc) in xs.keys():
   202	        for dr, dc in _X_OFF:
   203	            rr, cc2 = cr + dr, cc + dc
   204	            if 0 <= rr < h and 0 <= cc2 < w:
   205	                track_mask[rr, cc2] = False
   206	
   207	    comps = _components(track_mask)
   208	    rects_9 = _find_9rects(g)
   209	
   210	    out = g.copy()
   211	
   212	    # Solid tokens become diamonds in place.
   213	    for (cr, cc), (col, (r0, c0)) in solids.items():
   214	        out[r0 : r0 + 3, c0 : c0 + 3] = bg
   215	        for dr, dc in _DIAMOND_OFF:
   216	            rr, cc2 = cr + dr, cc + dc
   217	            if 0 <= rr < h and 0 <= cc2 < w:
