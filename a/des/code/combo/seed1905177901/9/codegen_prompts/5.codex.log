+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 8
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
