+    for degree, members in by_degree.items():
+        assert degree in (1, 2, 3)
+        values = list(range(len(members)))
+        random.shuffle(values)
+        order = members[:]
+        random.shuffle(order)
+        for slot, extra in zip(order, values):
+            extras[slot] = int(extra)
+    return extras
+
