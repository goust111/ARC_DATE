+            coords: list[tuple[int, int]] = []
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in N4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not _in_bounds(g.shape, nr, nc):
+                        continue
