+    r0, c0, r1, c1 = bbox
+    rect_h = int(r1 - r0 + 1)
+    rect_w = int(c1 - c0 + 1)
+
+    if mr == 0:
+        assert 0 < mc < w - 1
+        out[:rect_h, mc] = int(color)
+    elif mr == h - 1:
+        assert 0 < mc < w - 1
+        out[h - rect_h :, mc] = int(color)
+    elif mc == 0:
+        assert 0 < mr < h - 1
+        out[mr, :rect_w] = int(color)
+    else:
+        assert mc == w - 1
+        assert 0 < mr < h - 1
+        out[mr, w - rect_w :] = int(color)
+
