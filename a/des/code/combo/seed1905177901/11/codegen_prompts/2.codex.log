+def _place_marker_line(
+    occupied: np.ndarray, side: str, rect_h: int, rect_w: int
+) -> tuple[tuple[int, int], list[tuple[int, int]]] | None:
+    grid_h, grid_w = occupied.shape
+    for _ in range(MARKER_ATTEMPTS):
+        if side in ("top", "bottom"):
