+        assert int(r1 - r0 + 1) == shape_h and int(c1 - c0 + 1) == shape_w
+        rel = obj["rel"]
+        assert np.all(shape_mask[rel[:, 0], rel[:, 1]]), "visible cells must fit the template"
+        positions.append((int(r0), int(c0)))
