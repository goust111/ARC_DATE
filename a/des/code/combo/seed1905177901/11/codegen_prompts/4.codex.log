+def _layout_stats(thicknesses: list[int]) -> tuple[list[int], list[int], list[int]]:
+    starts: list[int] = []
+    top_indices: list[int] = []
+    bottom_indices: list[int] = []
+    row = 0
+    total_height = sum(thicknesses)
