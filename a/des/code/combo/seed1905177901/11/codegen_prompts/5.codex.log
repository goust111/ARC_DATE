+        receivers = _choose_receivers(candidates)
+        if receivers is None:
+            continue
+        grid = _render_input(height, width, towers, receivers)
+        if _receiver_mode_summary(grid) != {"none", "single", "multi"}:
+            continue
+        try:
+            main(grid)
+        except Exception:
