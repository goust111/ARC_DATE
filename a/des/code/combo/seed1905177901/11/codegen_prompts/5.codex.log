+RECEIVER = 5
+INTERFERENCE = 9
+
+TOWER_COLORS = tuple(color for color in range(10) if color not in {BG, RECEIVER, INTERFERENCE})
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+TOWER_COUNT_RANGE = (2, 4)
+RECEIVER_COUNT_RANGE = (3, 5)
