                cc = int(c)
                marker_r = marker_by_col[cc][0]
                assert rr != marker_r, "body pixel cannot occupy the marker row"
                shifted_r = rr - 1 if rr < marker_r else rr + 1
                _set_body(out, shifted_r, cc, body)

