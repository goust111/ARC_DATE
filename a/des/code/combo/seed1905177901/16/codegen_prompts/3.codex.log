+    grid[markers["down"]] = BLUE
+    grid[markers["left"]] = GREEN
+    grid[markers["right"]] = YELLOW
+    return markers
+
+
+def _gen_attempt(rng: random.Random, required_direction: str) -> np.ndarray | None:
+    h = rng.randint(*GRID_H_RANGE)
