+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+
+DIRECTIONS = ("up", "down", "left", "right")
+DIR_TO_COLOR = {
+    "up": RED,
+    "down": BLUE,
+    "left": GREEN,
+    "right": YELLOW,
+}
+
