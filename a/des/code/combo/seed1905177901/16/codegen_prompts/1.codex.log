+    r, c = pos
+    r0, c0, r1, c1 = envelope["bbox"]
+    a, b = envelope["gap_span"]
+    side = envelope["side"]
+    if side == "top":
+        return r < r0 and c in (a, b)
+    if side == "bottom":
+        return r > r1 and c in (a, b)
+    if side == "left":
+        return c < c0 and r in (a, b)
+    return c > c1 and r in (a, b)
