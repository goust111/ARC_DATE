+def _frame_patch(height: int, width: int, color: int, bg: int, side: str, gap_start: int) -> np.ndarray:
+    patch = np.full((height, width), bg, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
