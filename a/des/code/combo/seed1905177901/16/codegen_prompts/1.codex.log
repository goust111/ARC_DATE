+        return None
+
+    inp = np.full((height, width), BG_COLOR, dtype=int)
+    corridor_union: set[tuple[int, int]] = set()
+    bbox_union: set[tuple[int, int]] = set()
+    for record in records:
+        r0, c0, r1, c1 = record["bbox"]
+        patch = _frame_patch(
+            record["outer_h"],
+            record["outer_w"],
+            record["color"],
+            BG_COLOR,
+            record["side"],
+            record["gap_start"],
