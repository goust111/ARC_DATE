+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        rng = np.random.default_rng()
+        grid = _build_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {GEN_ATTEMPTS} attempts")

