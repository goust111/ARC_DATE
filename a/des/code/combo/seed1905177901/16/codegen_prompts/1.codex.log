+        patch[0, gap_start : gap_start + 2] = bg
+    elif side == "bottom":
+        patch[-1, gap_start : gap_start + 2] = bg
+    elif side == "left":
+        patch[gap_start : gap_start + 2, 0] = bg
+    else:
+        patch[gap_start : gap_start + 2, -1] = bg
+    return patch
