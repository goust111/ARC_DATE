+    if inferred_kind != axis_kind or inferred_axis != axis_index:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _attempt_grid()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid mirrored-pair grid")

