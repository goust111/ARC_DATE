+
+    max_width = min(5, axis_index, w - axis_index - 1)
+    if max_width < 1:
+        return False
+    for _ in range(PAIR_PLACEMENT_ATTEMPTS):
+        height = random.randint(2, min(6, h))
+        width = random.randint(1, max_width)
