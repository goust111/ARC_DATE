+        r1 = r0 + new_h - 1
+        if seq["align"] == "left":
+            c0 = int(ordered[0]["c0"])
+            c1 = c0 + new_w - 1
+        else:
+            c1 = int(ordered[0]["c1"])
+            c0 = c1 - new_w + 1
+
+    seq["next_bbox"] = (r0, c0, r1, c1)
+    return seq
