+    shifted_abs = shifted_local + np.array([fr, fc], dtype=int)
+    keep = (
+        (shifted_abs[:, 0] >= 0)
+        & (shifted_abs[:, 0] < height)
+        & (shifted_abs[:, 1] >= 0)
+        & (shifted_abs[:, 1] < width)
+    )
+    if not np.any(keep):
+        return None
+
+    shifted_mask = np.zeros((height, width), dtype=bool)
+    kept_shifted = shifted_abs[keep]
+    shifted_mask[kept_shifted[:, 0], kept_shifted[:, 1]] = True
+
