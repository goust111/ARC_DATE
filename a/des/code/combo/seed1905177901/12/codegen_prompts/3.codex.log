+    out[clear_mask] = BG
+    for shifted, color in moves:
+        keep = (
+            (shifted[:, 0] >= 0)
+            & (shifted[:, 0] < height)
+            & (shifted[:, 1] >= 0)
+            & (shifted[:, 1] < width)
+        )
+        for r, c in shifted[keep]:
+            if not frame_mask[int(r), int(c)]:
+                out[int(r), int(c)] = int(color)
+
+    return out
+
+
+def _dilate(mask: np.ndarray) -> np.ndarray:
+    height, width = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        r0 = max(0, int(r) - 1)
