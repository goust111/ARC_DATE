+        "side": side,
+        "want_clip": want_clip,
+        "frame_color": frame_color,
+        "object_color": object_color,
+        "frame_mask": frame_mask,
+        "object_mask": object_mask,
+        "shifted_mask": shifted_mask,
+    }
