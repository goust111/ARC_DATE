+    local[comp["coords"][:, 0] - r0, comp["coords"][:, 1] - c0] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(local & ~border):
