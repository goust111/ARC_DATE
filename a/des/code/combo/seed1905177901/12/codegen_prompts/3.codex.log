+    elif side == "down":
+        bottom_row = int(shifted_local[:, 0].max())
+        if want_clip:
+            fr_lo = max(fr_lo, height - bottom_row)
+        else:
+            fr_hi = min(fr_hi, height - bottom_row - 1)
+    elif side == "left":
+        left_col = int(shifted_local[:, 1].min())
