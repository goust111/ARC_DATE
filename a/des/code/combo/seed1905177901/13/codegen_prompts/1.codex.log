+    grid[r0 : r1 + 1, c1] = color
+    for dr, dc in missing_rel:
+        grid[r0 + dr, c0 + dc] = 0
+
+
+def _draw_key(grid: np.ndarray, r0: int, c0: int, mask: np.ndarray, color: int, marker, marker_color: int):
+    pts = np.argwhere(mask)
+    for dr, dc in pts:
