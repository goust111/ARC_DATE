import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
MAGENTA = 6
ORANGE = 7
AZURE = 8
MAROON = 9

WARM_START_COLORS = {RED, ORANGE, YELLOW, MAROON}
COLD_START_COLORS = {BLUE, GREEN, AZURE}
NEUTRAL_START_COLORS = {GREY, MAGENTA}
NON_BLACK_COLORS = tuple(range(1, 10))

GENERATION_RETRIES = 300
PLACEMENT_RETRIES = 160
