+        template_idx = query_templates[idx]
+        mask, color_a, color_b = templates[template_idx]
+        use_first = bool(half_choices[idx])
+        _place_block(grid, r0, c0, _build_query_block(mask, color_a, color_b, use_first))
+
+    try:
