+
+    if out.shape != grid.shape:
+        return None
+    if not np.array_equal(out[: sep_row + 1, :], grid[: sep_row + 1, :]):
+        return None
+    if not np.any(out[sep_row + 1 :, :] != grid[sep_row + 1 :, :]):
+        return None
+    return grid
