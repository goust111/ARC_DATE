+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SHAPES_BY_AREA = {
+    9: [(3, 3)],
+    15: [(3, 5), (5, 3)],
+    25: [(5, 5)],
+}
+SMALL_AREAS = (9, 15)
