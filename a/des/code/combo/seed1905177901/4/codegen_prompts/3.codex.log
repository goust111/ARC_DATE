+            cs = [cc for _, cc in coords]
+            bbox = (min(rs), min(cs), max(rs), max(cs))
+            center = ((bbox[0] + bbox[2]) // 2, (bbox[1] + bbox[3]) // 2)
+            comps.append(
+                {
+                    "coords": coords,
+                    "area": len(coords),
