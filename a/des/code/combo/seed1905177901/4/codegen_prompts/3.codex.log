+        assert len(comps) == 2, "each marker color must have exactly two objects"
+        comps.sort(
+            key=lambda comp: (
+                int(comp["area"]),
+                int(comp["bbox"][0]),
+                int(comp["bbox"][1]),
+                int(comp["center"][0]),
+                int(comp["center"][1]),
