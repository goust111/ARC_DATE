+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SHAPES_BY_AREA = {
+    9: [(3, 3)],
+    15: [(3, 5), (5, 3)],
+    25: [(5, 5)],
