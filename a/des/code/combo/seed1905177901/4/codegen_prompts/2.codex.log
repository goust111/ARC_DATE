+                continue
+            color = int(grid[r, c])
+            queue = [(r, c)]
+            visited[r, c] = True
+            coords = []
+
+            while queue:
+                cr, cc = queue.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
