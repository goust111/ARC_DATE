+def _neighbors_with_self(coords: list[tuple[int, int]] | set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for dr, dc in ((0, 0),) + DIR4:
