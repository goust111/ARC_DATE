+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+
+PRIMARY_COLORS = (RED, BLUE, YELLOW)
+VISIBLE_FOR_PRIMARY = {
+    RED: frozenset((RED, MAGENTA, ORANGE)),
+    BLUE: frozenset((BLUE, MAGENTA, GREEN)),
+    YELLOW: frozenset((YELLOW, ORANGE, GREEN)),
+}
