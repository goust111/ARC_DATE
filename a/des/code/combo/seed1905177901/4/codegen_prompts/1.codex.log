+    if direction == "up":
+        start = c0 + 1 + gap_start
+        canvas[r0, start : start + gap_width] = bg
+    elif direction == "down":
+        start = c0 + 1 + gap_start
+        canvas[r1, start : start + gap_width] = bg
+    elif direction == "left":
+        start = r0 + 1 + gap_start
+        canvas[start : start + gap_width, c0] = bg
+    elif direction == "right":
