+def _expected_output_signature(frames: list[FrameInfo]) -> set[tuple[str, tuple[int, int, int, int], int, int]]:
+    groups: dict[str, list[FrameInfo]] = defaultdict(list)
+    for frame in frames:
+        groups[frame.direction].append(frame)
