+            score = (max(total_h, total_w), total_h * total_w, total_w + total_h)
+            if best is not None and score >= best[0]:
+                continue
+
+            positions = [(-1, -1)] * len(groups)
+            x = 0
+            for idx in row0:
+                positions[idx] = (0, x)
+                x += groups[idx].width + GROUP_GAP
+            if row1:
+                x = 0
+                y = height0 + GROUP_GAP
+                for idx in row1:
+                    positions[idx] = (y, x)
+                    x += groups[idx].width + GROUP_GAP
+            best = (score, positions, total_h, total_w)
