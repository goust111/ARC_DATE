+) -> None:
+    r0, c0, r1, c1 = bbox
+    canvas[r0, c0 : c1 + 1] = color
+    canvas[r1, c0 : c1 + 1] = color
+    canvas[r0 : r1 + 1, c0] = color
+    canvas[r0 : r1 + 1, c1] = color
