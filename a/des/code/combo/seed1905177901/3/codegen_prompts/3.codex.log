+    elif direction == "L":
+        if w - ow < MIN_TRAVEL:
+            return None
+        r0 = int(rng.integers(0, h - oh + 1))
+        c0 = int(rng.integers(MIN_TRAVEL, w - ow + 1))
+    else:
+        if w - ow < MIN_TRAVEL:
+            return None
+        r0 = int(rng.integers(0, h - oh + 1))
+        c0 = int(rng.integers(0, w - ow - MIN_TRAVEL + 1))
+
+    r1 = r0 + oh - 1
+    c1 = c0 + ow - 1
+
+    arrow_r = int(rng.integers(1, oh - 2))
+    arrow_c = int(rng.integers(1, ow - 2))
