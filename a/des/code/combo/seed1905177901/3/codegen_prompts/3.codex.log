+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if not np.all((out == BG) | (out == GREY) | np.isin(out, FRAME_COLORS)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
