+
+    return {
+        "color": int(color),
+        "box": (r0, c0, r1, c1),
+        "direction": direction,
+        "arrow_rel": tuple(sorted(arrow_rel)),
+    }
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
