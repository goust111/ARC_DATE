+def _patch_from_component(points: list[tuple[int, int]]) -> tuple[np.ndarray, int, int]:
+    r0, c0, r1, c1 = _bbox(points)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
