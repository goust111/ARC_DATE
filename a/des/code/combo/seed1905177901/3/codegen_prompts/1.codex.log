+
+def _add_protrusions(mask: np.ndarray) -> np.ndarray:
+    pad = 6
+    h, w = mask.shape
+    canvas = np.zeros((h + 2 * pad, w + 2 * pad), dtype=bool)
+    canvas[pad : pad + h, pad : pad + w] = mask
