+def _build_sample() -> tuple[np.ndarray, np.ndarray]:
+    legend_len = random.randint(*LEGEND_LEN_RANGE)
+    legend_colors = random.sample(PALETTE_POOL, legend_len)
+    hole_counts = _sample_hole_counts(legend_len)
