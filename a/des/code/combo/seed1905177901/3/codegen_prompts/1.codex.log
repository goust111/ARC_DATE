+    cur_r = border
+    for row_h, row_w, sizes in zip(row_heights, row_widths, row_specs, strict=False):
+        cur_c = border + random.randint(0, inner_w - row_w)
+        for hh, ww in sizes:
+            top = cur_r + random.randint(0, row_h - hh)
+            patch[top : top + hh, cur_c : cur_c + ww] = False
+            cur_c += ww + col_gap
