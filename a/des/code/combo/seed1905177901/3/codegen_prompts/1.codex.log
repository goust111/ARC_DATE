+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = out.T
+    return np.array(out, dtype=bool)
+
+
+def _make_object(hole_count: int) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    for _ in range(OBJECT_SHAPE_ATTEMPTS):
