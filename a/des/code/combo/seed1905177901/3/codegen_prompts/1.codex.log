+    max_h = max(mask.shape[0] for mask, _, _ in objects)
+    max_w = max(mask.shape[1] for mask, _, _ in objects)
+    padded_area = sum(
+        (mask.shape[0] + 2 * OBJECT_PADDING) * (mask.shape[1] + 2 * OBJECT_PADDING)
+        for mask, _, _ in objects
