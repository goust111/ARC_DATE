+def _legend_layout(width: int, legend_len: int) -> tuple[list[int], int]:
+    step = random.choice([1, 2])
+    span = 1 + step * (legend_len - 1)
+    start = random.randint(1, width - span - 1)
+    cols = [start + i * step for i in range(legend_len)]
+    return cols, span
