+def _hole_regions(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    holes: list[list[tuple[int, int]]] = []
+    h, w = mask.shape
+    for region in _components(~mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in region):
