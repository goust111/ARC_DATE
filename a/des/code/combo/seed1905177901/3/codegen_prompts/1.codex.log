+
+    for idx in range(len(objects)):
+        placements.append(pos_by_index[idx])
+    return placements
+
+
+def _expected_output(
+    inp: np.ndarray,
+    objects: list[tuple[np.ndarray, list[list[tuple[int, int]]], int]],
+    placements: list[tuple[int, int]],
+    legend_colors: list[int],
+) -> np.ndarray:
+    out = inp.copy()
+    out[-1, :] = AZURE
