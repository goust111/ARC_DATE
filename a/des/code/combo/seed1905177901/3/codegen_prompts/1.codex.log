+def _split_positive(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    out: list[int] = []
+    prev = 0
+    for cut in cuts + [total]:
+        out.append(int(cut - prev))
+        prev = cut
+    return out
+
+
+def _base_object_mask(hole_count: int) -> np.ndarray:
+    if hole_count == 0:
+        return np.ones(
+            (
+                random.randint(3, 6),
+                random.randint(3, 6),
+            ),
+            dtype=bool,
