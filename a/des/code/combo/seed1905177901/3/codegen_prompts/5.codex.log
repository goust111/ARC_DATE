+    used: set[tuple[int, int]] = set()
+
+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        options = [0, 1]
+        random.shuffle(options)
+        for diag in options:
+            p0, p1 = _diag_endpoints(rects[idx], diag)
+            if p0 == p1 or p0 in used or p1 in used:
+                continue
+            used.add(p0)
+            used.add(p1)
+            diags[idx] = int(diag)
+            if dfs(pos + 1):
+                return True
+            used.remove(p0)
+            used.remove(p1)
+            diags[idx] = None
+        return False
+
+    if not dfs(0):
+        return None
+    return [int(diag) for diag in diags]
