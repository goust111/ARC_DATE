+    lo_h = 2 if max_h >= 2 else 1
+    lo_w = 2 if max_w >= 2 else 1
+    hh = random.randint(lo_h, max_h)
+    ww = random.randint(lo_w, max_w)
+    if hh == 1 and ww == 1:
