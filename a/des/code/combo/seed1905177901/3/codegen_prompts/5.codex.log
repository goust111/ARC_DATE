+        rects.append(rect)
+    return rects
+
+
+def _build_nested(h: int, w: int) -> list[Rect] | None:
+    if h < 6 or w < 6:
+        return None
+
+    outer_h_lo = max(4, h // 3)
+    outer_w_lo = max(4, w // 3)
+    outer_h = random.randint(outer_h_lo, max(outer_h_lo, h - 2))
+    outer_w = random.randint(outer_w_lo, max(outer_w_lo, w - 2))
