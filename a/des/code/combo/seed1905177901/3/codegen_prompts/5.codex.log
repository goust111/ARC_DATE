+
+def _random_small_dims(h: int, w: int) -> tuple[int, int]:
+    max_h = min(7, int(h))
+    max_w = min(7, int(w))
+    if max_h < 1 or max_w < 1:
+        raise ValueError("grid too small for rectangle placement")
