+
+    return specs
+
+
+def _foreground_mask(shape: tuple[int, int], specs) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for spec in specs:
+        r0, c0, r1, c1 = spec["box"]
