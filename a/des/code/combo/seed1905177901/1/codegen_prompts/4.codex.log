+
+def _neighbors4(r: int, c: int):
+    if r > 0:
+        yield r - 1, c
+    if c > 0:
+        yield r, c - 1
+    yield r + 1, c
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            seen[r0, c0] = True
+            stack = [(int(r0), int(c0))]
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r0 in range(h):
+        for c0 in range(w):
+            if not bg[r0, c0] or seen[r0, c0]:
+                continue
+            seen[r0, c0] = True
+            stack = [(int(r0), int(c0))]
+            touches_border = False
+            while stack:
+                r, c = stack.pop()
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _supports_period(tile: np.ndarray, ph: int, pw: int) -> bool:
+    h, w = tile.shape
+    for r in range(h):
+        for c in range(w):
+            if int(tile[r, c]) != int(tile[r % ph, c % pw]):
+                return False
+    return True
+
+
+def _minimal_period(tile: np.ndarray) -> tuple[int, int]:
+    h, w = tile.shape
+    best = None
+    for ph in range(1, h + 1):
+        if h % ph:
+            continue
+        for pw in range(1, w + 1):
+            if w % pw:
+                continue
+            if not _supports_period(tile, ph, pw):
+                continue
+            cand = (ph * pw, ph, pw)
+            if best is None or cand < best:
+                best = cand
+    assert best is not None
+    return best[1], best[2]
+
+
+def _repeat_tile(tile: np.ndarray, h: int, w: int) -> np.ndarray:
+    ph, pw = tile.shape
+    rows = np.arange(h) % int(ph)
+    cols = np.arange(w) % int(pw)
+    return tile[rows[:, None], cols[None, :]]
