+        for hr, hc, hh, ww in spec["holes"]:
+            mask[r0 + hr : r0 + hr + hh, c0 + hc : c0 + hc + ww] = False
+    return mask
+
+
+def _visible_residue_counts(mask: np.ndarray, ph: int, pw: int) -> bool:
+    h, w = mask.shape
+    for rr in range(ph):
+        for cc in range(pw):
+            visible = 0
+            for r in range(rr, h, ph):
+                for c in range(cc, w, pw):
+                    if c == 0 or mask[r, c]:
+                        continue
+                    visible += 1
+            if visible < 2:
