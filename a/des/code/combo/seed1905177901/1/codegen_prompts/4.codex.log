+BACKGROUND_COLOR_COUNT = (2, 3)
+OBJECT_COUNT_RANGE = (1, 3)
+MAX_HOLES = 3
+RECT_H_RANGE = (4, 8)
+RECT_W_RANGE = (4, 8)
+PLACEMENT_GAP = 1
+INSTANCE_RETRIES = 600
+HOLE_RETRIES = 120
+OBJECT_RETRIES = 160
