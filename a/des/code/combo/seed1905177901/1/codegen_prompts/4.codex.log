+    h, w = grid.shape
+    legend_blocked = np.zeros((h, w), dtype=bool)
+    legend_blocked[:, 0] = True
+    infer_blocked = legend_blocked.copy()
+    previous = None
+    recon = None
+    diff = None
+    boxes: list[tuple[int, int, int, int]] = []
