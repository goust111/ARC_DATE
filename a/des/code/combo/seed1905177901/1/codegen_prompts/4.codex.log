+            c0 = random.randint(2, grid_w - rect_w - 2)
+            box = (r0, c0, r0 + rect_h - 1, c0 + rect_w - 1)
+            if any(_expanded_overlap(box, old, PLACEMENT_GAP) for old in boxes):
+                continue
+            specs.append(
+                {
+                    "box": box,
+                    "color": int(color),
+                    "hole_count": int(hole_count),
+                    "holes": holes,
