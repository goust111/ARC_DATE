+def _supports_period(tile: np.ndarray, ph: int, pw: int) -> bool:
+    h, w = tile.shape
+    for r in range(h):
+        for c in range(w):
+            if int(tile[r, c]) != int(tile[r % ph, c % pw]):
+                return False
+    return True
