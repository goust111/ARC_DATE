+def _foreground_mask(shape: tuple[int, int], specs) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for spec in specs:
+        r0, c0, r1, c1 = spec["box"]
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+        for hr, hc, hh, ww in spec["holes"]:
+            mask[r0 + hr : r0 + hr + hh, c0 + hc : c0 + hc + ww] = False
+    return mask
+
