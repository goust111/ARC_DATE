+        for c0 in range(w):
+            if not bg[r0, c0] or seen[r0, c0]:
+                continue
+            seen[r0, c0] = True
+            stack = [(int(r0), int(c0))]
+            touches_border = False
+            while stack:
+                r, c = stack.pop()
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
