+    for _ in range(HOLE_RETRIES):
+        holes = []
+        blocked = np.zeros((rect_h, rect_w), dtype=bool)
+        blocked[0, :] = True
+        blocked[-1, :] = True
+        blocked[:, 0] = True
+        blocked[:, -1] = True
+        ok = True
+
+        for _idx in range(hole_count):
+            placed = False
+            for hh, ww in _hole_shapes():
+                candidates = []
+                for r in range(1, rect_h - hh):
+                    for c in range(1, rect_w - ww):
+                        if blocked[r - 1 : r + hh + 1, c - 1 : c + ww + 1].any():
+                            continue
+                        candidates.append((r, c, hh, ww))
+                if not candidates:
+                    continue
+                hole = random.choice(candidates)
+                r, c, hh, ww = hole
+                holes.append(hole)
+                blocked[r - 1 : r + hh + 1, c - 1 : c + ww + 1] = True
+                placed = True
+                break
