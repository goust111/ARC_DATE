+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG_COLOR = 0
+SEP_COLOR = 5
+OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+CATEGORY_ORDER = ("H", "V", "R")
+GEN_ATTEMPTS = 400
+PANEL_COUNT_RANGE = (3, 5)
+PANEL_SIDE_RANGE = (7, 11)
+SHAPE_ATTEMPTS = 200
