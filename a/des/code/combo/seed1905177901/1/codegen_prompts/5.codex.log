+def _gen_rot_mask(max_dim: int) -> np.ndarray | None:
+    odd_dims = [dim for dim in range(3, max_dim + 1) if dim % 2 == 1]
+    if not odd_dims:
+        return None
+    for _ in range(SHAPE_ATTEMPTS):
+        h = random.choice(odd_dims)
+        w = random.choice(odd_dims)
