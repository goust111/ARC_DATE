+        w = random.randint(3, max_dim)
+        top_h = (h + 1) // 2
+        seed = (top_h - 1, random.randrange(w))
+        size = random.randint(2, top_h * w)
+        top = _grow_connected_mask(top_h, w, size, seed)
+        if top is None:
