+        h = random.randint(3, max_dim)
+        w = random.randint(3, max_dim)
+        left_w = (w + 1) // 2
+        seed = (random.randrange(h), left_w - 1)
+        size = random.randint(2, h * left_w)
+        left = _grow_connected_mask(h, left_w, size, seed)
+        if left is None:
