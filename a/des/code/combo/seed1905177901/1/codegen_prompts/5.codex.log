+    tight = _tight_mask(mask)
+    h_sym = np.array_equal(tight, np.flipud(tight))
+    v_sym = np.array_equal(tight, np.fliplr(tight))
+    r_sym = np.array_equal(tight, np.rot90(tight, 2))
+
+    if h_sym and not v_sym:
+        return "H"
+    if v_sym and not h_sym:
