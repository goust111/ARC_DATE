+
+def _validate_shape_catalog() -> None:
+    for area, masks in _BASE_SHAPES.items():
+        seen = set()
+        for mask in masks:
+            assert int(mask.sum()) == int(area)
+            key = _canonical_shape_key(mask)
+            assert key not in seen
+            seen.add(key)
+
