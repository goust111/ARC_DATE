+        _ascii_mask(["###", "##."]),
+    ],
+    6: [
+        _ascii_mask(["######"]),
+        _ascii_mask(["###", "###"]),
+        _ascii_mask(["####", "##.."]),
+        _ascii_mask(["###", "##.", "#.."]),
+        _ascii_mask(["##.", "###", ".#."]),
