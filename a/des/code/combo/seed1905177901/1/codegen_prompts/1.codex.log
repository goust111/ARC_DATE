+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _bg_color(g: np.ndarray) -> int:
+    if bool(np.any(g == BG)):
+        return BG
+    vals, cnts = np.unique(g, return_counts=True)
+    return int(vals[int(cnts.argmax())])
