+
+def _ascii_mask(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "#" for ch in row] for row in rows], dtype=bool)
+
+
+_BASE_SHAPES = {
+    1: [_ascii_mask(["#"])],
+    2: [_ascii_mask(["##"])],
+    3: [_ascii_mask(["###"]), _ascii_mask(["##", "#."])],
+    4: [
