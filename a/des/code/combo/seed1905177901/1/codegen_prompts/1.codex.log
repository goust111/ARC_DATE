+            color = int(g[r, c])
+            if color == int(bg) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = int(rr + dr), int(cc + dc)
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not bool(seen[nr, nc])
