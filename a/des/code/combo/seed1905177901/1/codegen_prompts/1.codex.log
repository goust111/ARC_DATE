+    holes: list[dict] = []
+    for coords in _components_from_mask(sub == int(bg)):
+        if any(
+            rr == 0 or cc == 0 or rr == sub.shape[0] - 1 or cc == sub.shape[1] - 1
+            for rr, cc in coords
