+
+    typed: list[tuple[str, str, list[dict[str, object]]]] = []
+    for side, region in regions:
+        if sep_orient == "vertical":
+            mask = (region != bg) & (region != sep_color)
+            comps = _components(grid[:, :axis] if side == "left" else grid[:, axis + 1 :], mask)
+            if side == "right":
