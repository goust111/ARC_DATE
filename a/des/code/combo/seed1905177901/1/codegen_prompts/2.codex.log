+    for row, dist, color in zip(horiz_rows, trunc_dists, colors[: len(trunc_dists)]):
+        if horizontal_side == "left":
+            end = sep_col - dist - 1
+            start = random.randint(0, end - MIN_SEG_LEN + 1)
+        else:
