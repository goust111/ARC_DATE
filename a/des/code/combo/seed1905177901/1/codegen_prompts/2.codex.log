+                    comp["c1"] = int(comp["c1"]) + axis + 1
+            typed.append((side, _side_type(comps), comps))
+        else:
+            mask = (region != bg) & (region != sep_color)
+            comps = _components(grid[:axis, :] if side == "top" else grid[axis + 1 :, :], mask)
+            if side == "bottom":
+                for comp in comps:
