+
+def _distance_to_separator(comp: dict[str, object], sep_orient: str, axis: int, side: str) -> int:
+    if sep_orient == "vertical":
+        if side == "left":
+            return int(axis - int(comp["c1"]) - 1)
+        return int(int(comp["c0"]) - axis - 1)
+    if side == "top":
