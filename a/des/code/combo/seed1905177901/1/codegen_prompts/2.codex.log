+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": int(next(iter(colors))),
+                    "coords": coords,
+                    "r0": int(min(rows)),
+                    "r1": int(max(rows)),
+                    "c0": int(min(cols)),
+                    "c1": int(max(cols)),
