+    assert {kind for _side, kind, _comps in typed} == {"horizontal", "vertical"}
+
+    horizontal: dict[int, tuple[int, int]] = {}
+    vertical: dict[int, tuple[int, int]] = {}
+    for side, kind, comps in typed:
+        for comp in comps:
