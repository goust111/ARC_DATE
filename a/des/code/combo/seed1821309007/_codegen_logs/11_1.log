+        pat = np.fliplr(pat)
+    if random.random() < 0.5:
+        pat = np.flipud(pat)
+    return pat.astype(bool)
+
+
+def _place_object(
+    grid: np.ndarray,
+    region_top: int,
+    region_bottom: int,
+    region_left: int,
+    region_right: int,
