+    row_choices = [r for r in range(h) if _counts_for_color(h_coords, 0, r) == 0]
+    col_choices = [c for c in range(w) if _counts_for_color(v_coords, 1, c) == 0]
+    random.shuffle(row_choices)
+    random.shuffle(col_choices)
