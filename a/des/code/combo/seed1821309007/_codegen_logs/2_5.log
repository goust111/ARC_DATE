+        crowded.update(
+            (r, c)
+            for c, col_rows in cols.items()
+            if len(col_rows) > 2
+            for r in col_rows
+        )
+        crowded_survivors += sum(out[r, c] == color for r, c in crowded)
+    return crossing_count, crowded_survivors
