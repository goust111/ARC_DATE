+            left_cols = [x for x in range(0, c) if _counts_for_color(h_coords, 1, x) == 0 and (r, x) not in occupied]
+            right_cols = [x for x in range(c + 1, w) if _counts_for_color(h_coords, 1, x) == 0 and (r, x) not in occupied]
