+    target_origins = {
+        (0, 0): (0, 0),
+        (0, 1): (0, sep_c + 1),
+        (1, 0): (sep_r + 1, 0),
+        (1, 1): (sep_r + 1, sep_c + 1),
+    }
+    target_shapes = {addr: quadrants[addr].shape for addr in quadrants}
+
+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        patch = obj["patch"]
