    inp, expected = _gen_render_pair(
        tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions
    )
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


