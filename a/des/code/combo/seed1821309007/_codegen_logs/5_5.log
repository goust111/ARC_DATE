+    room_interiors = np.zeros(g.shape, dtype=bool)
+    room_markers = {tuple(room["marker"]) for room in rooms}
+    for room in rooms:
+        r0, c0, r1, c1 = room["bbox"]
+        room_interiors[r0 + 1 : r1, c0 + 1 : c1] = True
