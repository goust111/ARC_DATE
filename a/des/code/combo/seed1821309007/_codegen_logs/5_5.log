        base_shape = random.choice(SHAPES)
        shape = random.choice(_variants(base_shape))
        sh, sw = shape.shape
        inner_h = random.randint(max(4, sh + 1), max(4, sh + 4))
        inner_w = random.randint(max(4, sw + 1), max(4, sw + 4))
        room_h = inner_h + 2
        room_w = inner_w + 2
        spot = _place_room(occ, room_h, room_w)
        if spot is None:
            return None
        r0, c0 = spot

