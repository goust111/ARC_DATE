        random.choice(["top", "bottom", "left", "right"]) for _ in range(room_count)
    ]
    room_specs: list[dict] = []
    matched_blob_shapes: dict[int, np.ndarray] = {}
    blob_specs: dict[int, np.ndarray] = {}

    for i in range(room_count):
