+            c0 = int(rng.integers(min_c0, w - bw - 1))
+            r0 = int(rng.integers(1, h - bh))
+    else:
+        tail_offset = int(rng.integers(0, bw))
+        if direction == "down":
+            max_r0 = h - (2 * bh + tail_len)
+            if max_r0 < 1 or w - bw < 2:
+                return None
+            r0 = int(rng.integers(1, max_r0 + 1))
+            c0 = int(rng.integers(1, w - bw))
+        else:
