+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GEN_RETRIES = 400
+PLACE_RETRIES = 300
+
+
+def get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for dr, dc in DIRS.values():
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def is_connected(coords: np.ndarray) -> bool:
+    if len(coords) <= 1:
+        return True
+    pts = {tuple(map(int, p)) for p in coords}
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS.values():
+            q = (r + dr, c + dc)
+            if q in pts and q not in seen:
+                seen.add(q)
+                stack.append(q)
+    return len(seen) == len(pts)
+
+
+def trim_body(body: np.ndarray, direction: str, keep_len: int) -> np.ndarray:
+    r0, c0, r1, c1 = bbox(body)
+    rel = body - np.array([r0, c0], dtype=int)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if direction == "right":
+        keep = rel[:, 1] < keep_len
+    elif direction == "left":
+        keep = rel[:, 1] >= w - keep_len
+    elif direction == "down":
+        keep = rel[:, 0] < keep_len
+    else:
+        keep = rel[:, 0] >= h - keep_len
+    return body[keep]
+
+
