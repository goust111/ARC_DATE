+            if angle != 0 and input_cells != output_cells:
+                changed = True
+
+            for r, c in input_cells:
+                grid[r, c] = color
+            used_in |= _dilate(input_cells, h, w, radius=1)
+            used_out |= output_cells
+            placed = True
+            break
+        if not placed:
+            return None
+
+    if not changed:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    angles = ANGLES.copy()
+    rng.shuffle(angles)
