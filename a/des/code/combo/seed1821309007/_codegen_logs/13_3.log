+        cols = sw["cols"]
+        if r in rows or c in cols:
+            affecting.append(sw)
+    if not affecting:
+        return GREY
+
+    affecting.sort(key=lambda sw: (int(sw["top"]), int(sw["left"])))
+    best = affecting[0]
+    return int(best["color"])
