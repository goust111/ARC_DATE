+
+    if all(_target_box(kind, mask, pos, gh, gw) == (pos[0], pos[1], pos[0] + mask.shape[0] - 1, pos[1] + mask.shape[1] - 1) for kind, mask, pos in placed):
+        return None
+
+    for _, mask, (r0, c0) in placed:
