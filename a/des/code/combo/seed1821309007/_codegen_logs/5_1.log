0189:     panels, diff_colors = _split_panels(g)
0190:     template = panels[-1]
0191:     prior = panels[:-1]
0192:     next_time = len(prior)
0193: 
0194:     predictions: list[tuple[int, np.ndarray]] = []
0195:     for color in diff_colors:
0196:         times = [i for i, panel in enumerate(prior) if np.any(panel == color)]
0197:         assert len(times) >= 2
0198:         gaps = [b - a for a, b in zip(times, times[1:])]
0199:         assert len(set(gaps)) == 1
0200:         period = gaps[0]
0201:         if next_time - times[-1] != period:
0202:             continue
0203: 
0204:         previous = prior[times[-2]] == color
0205:         current = prior[times[-1]] == color
0206:         predictions.append((color, _extrapolate_mask(previous, current)))
0207: 
0208:     assert predictions
0209:     occupied = np.zeros_like(template, dtype=bool)
0210:     for _color, mask in predictions:
0211:         assert not np.any(occupied & mask)
0212:         occupied |= mask
0213: 
0214:     out = template.copy()
0215:     for color, mask in predictions:
0216:         out[mask] = color
