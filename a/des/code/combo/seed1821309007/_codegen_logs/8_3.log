+def _random_polyomino(size: int) -> list[tuple[int, int]]:
+    cells = {(0, 0)}
+    frontier = {(0, 0)}
+    while len(cells) < size:
+        r, c = random.choice(tuple(frontier))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
