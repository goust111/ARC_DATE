+
+
+def _safe_marker_positions(grid: np.ndarray, room_rects: list[tuple[int, int, int, int]]) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
