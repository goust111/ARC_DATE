+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            tr = min(th - 1, int(r * th / h))
+            tc = min(tw - 1, int(c * tw / w))
+            out[tr, tc] = True
+    assert np.any(out)
+    return out
