+    c0, c1 = min(cols), max(cols)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    hh, ww = sub.shape
+    perim = np.zeros_like(sub, dtype=bool)
+    perim[0, :] = True
+    perim[-1, :] = True
