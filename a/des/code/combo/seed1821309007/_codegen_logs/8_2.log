+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(comp)
+    return parts
+
+
+def _is_frame_component(grid: np.ndarray, comp: list[tuple[int, int]], color: int) -> tuple[int, int, int, int] | None:
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    hh, ww = sub.shape
+    perim = np.zeros_like(sub, dtype=bool)
+    perim[0, :] = True
+    perim[-1, :] = True
+    perim[:, 0] = True
+    perim[:, -1] = True
+    if not np.all(sub[perim] == color):
+        return None
+    if np.any(sub[1:-1, 1:-1] == color):
+        return None
+    if len(comp) != 2 * hh + 2 * ww - 4:
+        return None
+    return (r0, c0, r1, c1)
+
+
+def _find_rooms(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    rooms: list[dict] = []
+    wall_colors = set()
+    for color in map(int, np.unique(g)):
+        if color == BG:
+            continue
+        for comp in _components(g == color):
+            bbox = _is_frame_component(g, comp, color)
+            if bbox is None:
+                continue
