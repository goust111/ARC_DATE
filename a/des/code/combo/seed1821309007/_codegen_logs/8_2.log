+            thumb = color_to_thumb[color]
+            th, tw = thumb.shape
+            sr = r - th // 2
+            sc = c - tw // 2
+            for tr in range(th):
+                for tc in range(tw):
+                    rr, cc = sr + tr, sc + tc
+                    if 0 <= rr < h and 0 <= cc < w and thumb[tr, tc]:
+                        out[rr, cc] = color
+    return out
+
+
+def _sample_source_bbox(room_h: int, room_w: int, desired_h: int, desired_w: int, rng: random.Random) -> tuple[int, int]:
+    limit_h = max(1, room_h - 2)
