+        return None
+
+    grid = np.full((grid_h, grid_w), BG, dtype=int)
+    wall_color = rng.choice(WALL_COLOR_CHOICES)
+    room_rects = _choose_room_rects(grid_h, grid_w, room_count, rng)
+    room_colors = rng.sample(ROOM_COLOR_CHOICES, room_count)
+    desired_sizes = rng.sample(THUMBNAIL_SIZES, room_count) if room_count <= len(THUMBNAIL_SIZES) else [
