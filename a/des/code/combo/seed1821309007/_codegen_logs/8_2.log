+
+BG = 0
+GEN_RETRIES = 400
+ROOM_COUNT_RANGE = (3, 5)
+GRID_SIDE_RANGE = (24, 32)
+ROOM_INNER_SIDE_RANGE = (5, 10)
+ROOM_MARGIN = 2
+MARKER_GAP = 4
+WALL_COLOR_CHOICES = [5, 6]
+ROOM_COLOR_CHOICES = [1, 2, 3, 4, 7, 8, 9]
+THUMBNAIL_SIZES = [
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
