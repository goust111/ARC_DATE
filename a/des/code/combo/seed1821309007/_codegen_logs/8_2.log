+    rooms = _find_rooms(g)
+    color_to_thumb: dict[int, np.ndarray] = {}
+    room_coverage = np.zeros_like(g, dtype=bool)
+    wall_color = rooms[0]["wall_color"]
+    for room in rooms:
+        r0, c0, r1, c1 = room["room_bbox"]
+        room_coverage[r0 : r1 + 1, c0 : c1 + 1] = True
