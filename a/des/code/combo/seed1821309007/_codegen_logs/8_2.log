+            {
+                "color": color,
+                "thumb_shape": _make_thumbnail(mask).shape,
+                "rect": rect,
+            }
+        )
+
+    candidates = _safe_marker_positions(grid, room_rects)
+    rng.shuffle(candidates)
+    markers: list[tuple[int, int, int]] = []
+    used_centers: list[tuple[int, int]] = []
+    for spec in room_specs:
+        wanted = rng.randint(1, 3)
+        placed = 0
+        th, tw = spec["thumb_shape"]
+        for r, c in candidates:
+            if grid[r, c] != BG:
