+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 400
+ROOM_COUNT_RANGE = (3, 4)
+GRID_SIDE_RANGE = (26, 34)
+ROOM_INNER_SIDE_RANGE = (5, 10)
