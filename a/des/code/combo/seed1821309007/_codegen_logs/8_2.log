+def _random_pattern_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    fill_count = rng.randint(max(1, (h * w) // 5), max(2, (h * w * 2) // 3))
