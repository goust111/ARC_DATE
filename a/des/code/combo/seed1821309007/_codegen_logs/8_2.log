+
+    if len(markers) < room_count:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    if len({spec["thumb_shape"] for spec in room_specs}) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

