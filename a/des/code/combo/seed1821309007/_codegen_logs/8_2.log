+
+    perim = np.zeros((h, w), dtype=bool)
+    perim[0, :] = True
+    perim[-1, :] = True
+    perim[:, 0] = True
+    perim[:, -1] = True
+    if h >= 3 and w >= 3 and np.array_equal(mask, perim):
