+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(comp)
+    return parts
