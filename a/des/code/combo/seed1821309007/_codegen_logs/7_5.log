                assert len(fill_colors) == 1
                fill_color = fill_colors[0]
                for r0, r1, c0, c1 in SLOTS:
                    out[panel_r0 + r0 : panel_r0 + r1, panel_c0 + c0 : panel_c0 + c1] = fill_color

