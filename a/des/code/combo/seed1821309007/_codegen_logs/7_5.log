+def _overlay(base: np.ndarray, folded: np.ndarray) -> np.ndarray:
+    """Both arrays are indexed from the fold axis outward."""
+    out = base.copy()
+    depth = folded.shape[0]
+    window = out[:depth].copy()
+    mask = folded != BG
+    window[mask] = folded[mask]
+    out[:depth] = window
+    return out
