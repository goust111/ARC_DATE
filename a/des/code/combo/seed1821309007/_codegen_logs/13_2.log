        start: int,
        chosen: list[tuple[int, int, int, int]],
        edge_count: int,
    ) -> list[tuple[int, int, int, int]] | None:
        if len(chosen) == n:
            return chosen
        if len(candidates) - start < n - len(chosen):
            return None

