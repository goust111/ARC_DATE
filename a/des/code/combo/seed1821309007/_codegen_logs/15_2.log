+BOUNDARY_BY_NEIGHBORS = {
+    0: 2,  # red
+    1: 3,  # green
+    2: 1,  # blue
+}
+INTERIOR_BY_HOLES = {
+    0: 9,  # maroon
+    1: 7,  # orange
+}
