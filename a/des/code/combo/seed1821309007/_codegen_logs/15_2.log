+
+
+def _add_star_positions(sizes: dict[str, tuple[int, int]], top: int, left: int):
+    ah, aw = sizes["A"]
+    bh, bw = sizes["B"]
+    ch, cw = sizes["C"]
+    dh, dw = sizes["D"]
