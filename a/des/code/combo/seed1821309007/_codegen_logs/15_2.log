+
+def _add_chain_positions(sizes: dict[str, tuple[int, int]], top: int, left: int):
+    fh, fw = sizes["F"]
+    eh, ew = sizes["E"]
+    gh, gw = sizes["G"]
+    e_left = left + fw + 1
