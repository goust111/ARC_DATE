    H, W = g.shape

    hole_col = 0
    border_col = 7

    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.
    base = g.copy()
    for r in range(H):
        for c in range(W):
            if int(base[r, c]) != 1:
                continue
            nb = 0
            oob = 0
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                rr = int(r + dr)
                cc = int(c + dc)
                if not (0 <= rr < H and 0 <= cc < W):
