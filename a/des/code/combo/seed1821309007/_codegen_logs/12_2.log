                nb += int(oob)
            if nb >= 3:
                base[int(r), int(c)] = int(hole_col)

    # STEP 1/2) Collect target black pixels (they must remain black).
    preserve: set[tuple[int, int]] = set()
    comps = components_mask(base == int(hole_col), connectivity=4)
    for coords in comps:
