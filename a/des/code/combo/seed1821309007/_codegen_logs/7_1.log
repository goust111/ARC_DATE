+def _extract_template(grid: np.ndarray, color: int, blocked: set[tuple[int, int]]) -> np.ndarray:
+    mask = grid == color
+    for r, c in blocked:
+        if 0 <= r < mask.shape[0] and 0 <= c < mask.shape[1]:
+            mask[r, c] = False
