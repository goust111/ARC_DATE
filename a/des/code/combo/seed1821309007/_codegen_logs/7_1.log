+    label_colors = list(rng.choice(LABEL_COLORS, size=n, replace=False))
+    while set(frame_colors) & set(label_colors):
+        label_colors = list(rng.choice(LABEL_COLORS, size=n, replace=False))
+
+    scene = []
+    sides = ["top", "right", "bottom", "left"]
+    rng.shuffle(sides)
