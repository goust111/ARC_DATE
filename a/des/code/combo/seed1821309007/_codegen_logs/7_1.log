+def _random_connected_mask(rng: np.random.Generator, h: int, w: int) -> np.ndarray:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    while True:
+        target = int(rng.integers(max(3, (h * w) // 3), h * w + 1))
+        start = cells[int(rng.integers(len(cells)))]
+        chosen = {start}
