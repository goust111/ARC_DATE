+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            need = 2 * (h + w) - 4
+            if len(comp) != need:
+                continue
+            sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if not np.all(sub[~border] == bg):
+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "interior_shape": (h - 2, w - 2),
+                }
+            )
