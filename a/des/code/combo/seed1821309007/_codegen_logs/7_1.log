+            cc = min(c0, label_pos[1])
+            hh = max(r0 + fh - 1, label_pos[0]) - rr + 1
+            ww = max(c0 + fw - 1, label_pos[1]) - cc + 1
+            if _can_place(occ, rr, cc, hh, ww, margin=1):
+                frame_ok = True
