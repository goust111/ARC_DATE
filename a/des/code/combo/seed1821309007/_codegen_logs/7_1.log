+import numpy as np
+
+
+BG = 0
+FRAME_COLORS = [1, 2, 3, 4, 5, 6, 7, 8]
+LABEL_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+DIRS = {
+    "top": 0,
+    "right": 3,   # np.rot90 k=3 == 90 deg clockwise
+    "bottom": 2,
+    "left": 1,    # np.rot90 k=1 == 270 deg clockwise
