+    while len(chosen) < min(cells, height * width) and frontier:
+        frontier_list = list(frontier)
+        pick = frontier_list[int(RNG.integers(len(frontier_list)))]
+        frontier.remove(pick)
+        chosen.add(pick)
+        r, c = pick
+        for dr, dc in ORTHO_DIRS:
