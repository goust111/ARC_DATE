+    4: [(2, 2)],
+    6: [(2, 3), (3, 2)],
+    8: [(2, 4), (4, 2)],
+    9: [(3, 3)],
+    10: [(2, 5), (5, 2)],
+    12: [(3, 4), (4, 3)],
+    15: [(3, 5), (5, 3)],
+    16: [(4, 4)],
