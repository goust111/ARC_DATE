+def _component(mask: np.ndarray, start: tuple[int, int], seen: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    q = deque([start])
+    seen[start] = True
+    coords = []
+    while q:
+        r, c = q.popleft()
+        coords.append((r, c))
+        for dr, dc in ORTHO_DIRS:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return np.array(coords, dtype=int)
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            same = g == color
+            coords = _component(same, (r, c), seen)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
+                    "bbox_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                }
+            )
+    comps.sort(key=lambda comp: (comp["bbox"][0], comp["bbox"][1], comp["color"]))
+    return comps
+
+
+def _extract_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = comp["coords"] - np.array([r0, c0])
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
