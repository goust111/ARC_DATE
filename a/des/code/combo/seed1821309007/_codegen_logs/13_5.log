+def _closest_major_index(area: int, major_areas: list[int]) -> int | None:
+    diffs = [abs(area - value) for value in major_areas]
+    best = min(diffs)
+    winners = [i for i, diff in enumerate(diffs) if diff == best]
+    if len(winners) != 1:
