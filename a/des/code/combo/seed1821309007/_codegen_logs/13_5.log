+import numpy as np
+from collections import Counter, defaultdict, deque
+
+
+ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RNG = np.random.default_rng()
+
+# Generator configuration.
+GRID_H_RANGE = (20, 29)
+GRID_W_RANGE = (20, 29)
