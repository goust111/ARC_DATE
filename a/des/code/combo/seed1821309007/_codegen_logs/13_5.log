+def _mark_bbox(occupied: np.ndarray, top: int, left: int, height: int, width: int, pad: int = 1) -> None:
+    h, w = occupied.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + height + pad)
+    c1 = min(w, left + width + pad)
+    occupied[r0:r1, c0:c1] = True
