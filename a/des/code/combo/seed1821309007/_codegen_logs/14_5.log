+    for comp in _gray_components(g):
+        comp_set = set(comp)
+        source_colors: set[int] = set()
+        endpoints: list[tuple[int, int]] = []
+        for r, c in comp:
+            gray_degree = 0
+            for nr, nc in neighbors4(r, c):
+                if not in_bounds(g.shape, nr, nc):
+                    continue
+                value = int(g[nr, nc])
+                if value == GRAY:
+                    gray_degree += 1
+                elif value != BLACK:
+                    source_colors.add(value)
+            if gray_degree == 1:
+                endpoints.append((r, c))
