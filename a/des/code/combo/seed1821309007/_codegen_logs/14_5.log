+    return edges
+
+
+def _random_branch_tree(
+    rng: random.Random, min_leaves: int
+) -> tuple[set[tuple[int, int]], set[frozenset[tuple[int, int]]]]:
+    for _ in range(300):
+        h = rng.randint(5, 8)
+        w = rng.randint(5, 8)
