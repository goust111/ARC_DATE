+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != GRAY:
+                continue
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if not in_bounds(grid.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != GRAY:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            components.append(comp)
+    return components
