+    for r0, c0 in cells:
+        canvas[top + int(r0), left + int(c0)] = int(patch[int(r0), int(c0)])
+
+
+def _validate_input(grid: np.ndarray) -> None:
+    gray_components = _gray_components(grid)
+    assert gray_components
+    for comp in gray_components:
