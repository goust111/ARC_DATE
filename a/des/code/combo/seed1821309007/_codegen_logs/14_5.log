+    """
+    Propagate each colored source through its adjacent gray wire network and recolor only
+    the gray degree-1 endpoints. Conflicting source colors turn the endpoint maroon.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
