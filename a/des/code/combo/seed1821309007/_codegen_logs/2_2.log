+    margin = count + 1
+    if r1 - r0 + 1 < 2 * margin + 1 or c1 - c0 + 1 < 2 * margin + 1:
+        return None
+
+    cr = random.randint(r0 + margin, r1 - margin)
+    cc = random.randint(c0 + margin, c1 - margin)
+    pts = [(cr, cc)] if count % 2 == 1 else []
+
+    need_pairs = count // 2
+    offsets = _random_symmetric_offsets(
+        min(cr - r0, r1 - cr) - 1,
+        min(cc - c0, c1 - cc) - 1,
+    )
