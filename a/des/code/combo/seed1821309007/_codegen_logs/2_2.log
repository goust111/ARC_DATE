+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(16, 24)
+    w = random.randint(16, 24)
+
+    n_rows = random.randint(2, 4)
+    n_cols = random.randint(2, 4)
+    row_positions = _pick_positions(h, n_rows, 2, 3, 4)
+    col_positions = _pick_positions(w, n_cols, 2, 3, 4)
