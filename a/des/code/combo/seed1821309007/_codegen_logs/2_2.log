+    for c, color in zip(col_positions, col_colors):
+        g[:, c] = color
+    for _ri, _ci, pts, idx in groups:
+        mcolor = marker_colors[idx % len(marker_colors)]
+        for r, c in pts:
+            g[r, c] = mcolor
+    return g
+
