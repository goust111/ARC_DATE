+        a = (cr + dr, cc + dc)
+        b = (cr - dr, cc - dc)
+        if a in used or b in used:
+            continue
+        used.add(a)
+        used.add(b)
+        pts.extend([a, b])
+        if len(pts) == count:
+            break
+
+    if len(pts) != count:
+        return None
