+def _gen_attempt() -> np.ndarray | None:
+    bg = 0
+    colors = list(range(1, 10))
+    line_color = random.choice(colors)
+    colors.remove(line_color)
+    stripe_color = random.choice(colors)
+
+    n_rows = random.randint(2, 4)
