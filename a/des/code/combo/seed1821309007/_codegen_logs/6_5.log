+    ref_gap_size = random.randint(1, 3)
+    _draw_reference_pattern(grid, ref_box, stripe_color, ref_horizontal, ref_gap_size)
+
+    other_indices = [k for k, box in enumerate(boxes) if box != ref_box]
+    random.shuffle(other_indices)
