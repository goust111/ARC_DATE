+        for j in range(n_cols):
+            box = (row_lines[i], col_lines[j], row_lines[i + 1], col_lines[j + 1])
+            boxes.append(box)
+            _draw_frame(grid, box, line_color)
+
+    ref_r, ref_c = _corner_index(n_rows, n_cols, random.randrange(4))
+    ref_box = boxes[ref_r * n_cols + ref_c]
