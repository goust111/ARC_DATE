+        n = int(np.count_nonzero(side == bg))
+        if n > 0:
+            if bool(((side != bg) & (side != line_color)).any()):
+                return None
+            missing[side_name] = n
+        elif not bool((side == line_color).all()):
+            return None
+    if len(missing) != 1:
+        return None
+    side_name, gap_size = next(iter(missing.items()))
+    if gap_size not in (1, 2, 3):
+        return None
+    return side_name, gap_size
