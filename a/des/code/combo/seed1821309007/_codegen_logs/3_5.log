+        else:
+            n_rects = random.randint(2, 4)
+            heights = [random.randint(2, 4) for _ in range(n_rects)]
+            needed = sum(heights) + 2 + (n_rects - 2) * 3
+            if needed > h - 2:
+                return None
+            top = random.randint(1, max(1, h - needed - 1))
+            left = random.randint(0, w - 2)
