+    add_frontier(*start)
+    while len(cells) < target:
+        if not frontier:
+            return None
+        choices = sorted(
+            frontier,
+            key=lambda rc: sum((rr, cc) in cells for rr, cc in _neighbors4(*rc)),
+            reverse=True,
+        )
+        pick = random.choice(choices[: max(1, min(4, len(choices)))])
+        frontier.remove(pick)
+        cells.add(pick)
+        add_frontier(*pick)
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
