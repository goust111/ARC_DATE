+        a = (r0a, c0a, r0a + h1 - 1, c0a + w1 - 1)
+        b = (r0b, c0b, r0b + h2 - 1, c0b + w2 - 1)
+    else:
+        h1 = int(RNG.integers(1, 5))
+        w1 = int(RNG.integers(1, 5))
+        h2 = int(RNG.integers(1, 5))
+        w2 = int(RNG.integers(1, 5))
+        gap = int(RNG.integers(2, 7))
