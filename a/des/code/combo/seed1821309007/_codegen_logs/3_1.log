+def _can_place(reserved: np.ndarray, top: int, left: int, shape: np.ndarray) -> bool:
+    h, w = reserved.shape
+    sh, sw = shape.shape
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(h, top + sh + 1)
+    c1 = min(w, left + sw + 1)
+    return not reserved[r0:r1, c0:c1].any()
