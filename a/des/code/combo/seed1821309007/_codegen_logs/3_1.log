+        if not np.any(shape[h - 1]) and h > 1:
+            shape[h - 1, 0] = True
+        if not np.any(shape[:, 0]) and w > 1:
+            shape[0, 0] = True
+        if not np.any(shape[:, w - 1]) and w > 1:
+            shape[0, w - 1] = True
+    return shape
