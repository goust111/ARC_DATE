+
+def _holed_shape(hole_count: int) -> np.ndarray:
+    inner_h = int(RNG.integers(2, 5))
+    h = inner_h + 2
+    w = 2 * hole_count + 1
+    shape = np.zeros((h, w), dtype=bool)
