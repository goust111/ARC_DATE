+def _ray_steps_to_edge(shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    steps = 0
+    while 0 <= r < h and 0 <= c < w:
+        steps += 1
+        r += dr
+        c += dc
+    return steps
