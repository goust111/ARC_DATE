+            size = random.randint(3, 5) if kind == "frame" else random.randint(2, 4)
+            r0 = random.randint(0, h - size)
+            c0 = random.randint(0, w - size)
+            bbox = (r0, c0, r0 + size - 1, c0 + size - 1)
