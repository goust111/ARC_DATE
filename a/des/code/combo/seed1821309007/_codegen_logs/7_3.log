+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _classify_emitter(coords: list[tuple[int, int]]) -> tuple[int, int] | None:
+    if len(coords) != 3:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return None
+    cells = set(coords)
+    for dr in (0, 1):
+        for dc in (0, 1):
+            if (r0 + dr, c0 + dc) not in cells:
+                return (-1 if dr == 0 else 1, -1 if dc == 0 else 1)
+    return None
+
+
+def _classify_target(coords: list[tuple[int, int]]) -> tuple[str, tuple[int, int, int, int]] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    area = len(coords)
+    cells = set(coords)
+    if area == h * w:
+        return ("solid", (r0, c0, r1, c1))
+    if h >= 3 and w >= 3:
+        border = set()
+        for r in range(r0, r1 + 1):
+            border.add((r, c0))
+            border.add((r, c1))
+        for c in range(c0, c1 + 1):
+            border.add((r0, c))
+            border.add((r1, c))
+        if cells == border:
+            return ("frame", (r0, c0, r1, c1))
+    return None
+
