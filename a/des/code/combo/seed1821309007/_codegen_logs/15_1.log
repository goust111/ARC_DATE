+    x_markers = [c for c in range(grid.shape[1]) if c != axis_c and int(grid[axis_r, c]) != x_base]
+    y_markers = [r for r in range(grid.shape[0]) if r != axis_r and int(grid[r, axis_c]) != y_base]
