+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    if BG in vals:
+        bg_count = int(counts[np.where(vals == BG)[0][0]])
+        if bg_count == int(counts.max()):
+            return BG
+    return int(vals[counts.argmax()])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            rows = [r0 for r0, _ in coords]
+            cols = [c0 for _, c0 in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _touch_edges(coords: list[tuple[int, int]], h: int, w: int) -> list[str]:
+    edges = set()
+    for r, c in coords:
+        if r == 0:
+            edges.add("top")
+        if r == h - 1:
+            edges.add("bottom")
+        if c == 0:
+            edges.add("left")
+        if c == w - 1:
+            edges.add("right")
+    return sorted(edges)
+
+
+def _scale2_about_center(coords: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    cr = (min(rows) + max(rows)) / 2.0
+    cc = (min(cols) + max(cols)) / 2.0
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        br = int(round(cr + 2 * (r - cr)))
+        bc = int(round(cc + 2 * (c - cc)))
+        out.add((br, bc))
+        out.add((br + 1, bc))
+        out.add((br, bc + 1))
+        out.add((br + 1, bc + 1))
+    return out
+
+
+def _rotate180_about_touch_center(
+    coords: list[tuple[int, int]], edge: str, h: int, w: int
+) -> set[tuple[int, int]]:
+    if edge == "top":
+        cols = [c for r, c in coords if r == 0]
+        pr, pc = 0.0, (min(cols) + max(cols)) / 2.0
+    elif edge == "bottom":
+        cols = [c for r, c in coords if r == h - 1]
+        pr, pc = float(h - 1), (min(cols) + max(cols)) / 2.0
+    elif edge == "left":
+        rows = [r for r, c in coords if c == 0]
+        pr, pc = (min(rows) + max(rows)) / 2.0, 0.0
+    else:
+        rows = [r for r, c in coords if c == w - 1]
+        pr, pc = (min(rows) + max(rows)) / 2.0, float(w - 1)
+
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        nr = int(round(2 * pr - r))
+        nc = int(round(2 * pc - c))
+        out.add((nr, nc))
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    out = np.full_like(g, bg)
+
+    for comp in _find_components(g, bg):
+        color = int(comp["color"])
+        coords = comp["coords"]
+        edges = _touch_edges(coords, h, w)
+        touched = len(edges)
+
+        if touched == 0:
+            painted = _scale2_about_center(coords)
+            paint_color = color
+        elif touched == 1:
+            painted = _rotate180_about_touch_center(coords, edges[0], h, w)
+            paint_color = color
+        elif touched == 2:
+            painted = set(coords)
+            paint_color = MAROON
+        else:
+            painted = set()
+            paint_color = color
+
+        for r, c in painted:
+            if 0 <= r < h and 0 <= c < w:
+                out[r, c] = paint_color
+
+    return out
