+    cr = (min(rows) + max(rows)) / 2.0
+    cc = (min(cols) + max(cols)) / 2.0
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        br = int(round(cr + 2 * (r - cr)))
+        bc = int(round(cc + 2 * (c - cc)))
+        out.add((br, bc))
+        out.add((br + 1, bc))
