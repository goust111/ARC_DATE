+def _trim_shape(shape: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    min_r = min(r for r, _ in shape)
+    min_c = min(c for _, c in shape)
+    return {(r - min_r, c - min_c) for r, c in shape}
