+
+def _touch_edges(coords: list[tuple[int, int]], h: int, w: int) -> list[str]:
+    edges = set()
+    for r, c in coords:
+        if r == 0:
+            edges.add("top")
+        if r == h - 1:
+            edges.add("bottom")
+        if c == 0:
+            edges.add("left")
+        if c == w - 1:
+            edges.add("right")
