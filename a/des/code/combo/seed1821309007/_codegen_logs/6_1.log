+    ref_cell = g[tl_rs, tl_cs]
+    ref_mask = ref_cell != bg
+    assert np.any(ref_mask)
+
+    corner_expectations = {
+        (0, 0): 0,
+        (0, n - 1): 1,
+        (n - 1, n - 1): 2,
+        (n - 1, 0): 3,
+    }
+    for (i, j), rot in corner_expectations.items():
+        rs, cs = _cell_slices(rows, cols, i, j)
+        cell = g[rs, cs]
+        assert np.array_equal(cell != bg, _clockwise_rot(ref_mask, rot))
