        order = [color for _mean, color, _lo, _hi, _cnt in means]
        for i in range(len(means) - 1):
            left = means[i]
            right = means[i + 1]
            overlap = max(0, left[3] - right[2] + 1)
            penalties += overlap * 1000.0
            penalties += max(0.0, left[0] - right[0]) * 100.0
        span = max(int(proj.max()) - int(proj.min()), 1)
        color_span = sum(item[3] - item[2] + 1 for item in means)
        score = (penalties, -span, color_span, tuple(order))
        if best_score is None or score < best_score:
            best_score = score
            best_order = order
    assert best_order is not None
    return best_order


def main(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = BG if np.count_nonzero(g == BG) else int(Counter(map(int, g.ravel())).most_common(1)[0][0])
    comps = _components(g != bg)
    assert comps, "expected at least one foreground object"

    objects = []
    for comp in comps:
        colors = [int(g[r, c]) for r, c in comp]
        uniq = []
        for color in colors:
            if color not in uniq:
                uniq.append(color)
        assert 2 <= len(set(colors)) <= 4, "expected multi-color foreground objects"
        seq = _color_sequence(comp, np.array(colors, dtype=int))
        r0 = int(comp[:, 0].min())
        c0 = int(comp[:, 1].min())
        objects.append((c0, r0, seq))

    objects.sort(key=lambda item: (item[0], item[1]))
    bands = [seq for _c0, _r0, seq in objects]
    out_h = len(bands) * 2 - 1
    out_w = max(len(seq) for seq in bands)
    out = np.full((out_h, out_w), bg, dtype=int)
    for i, seq in enumerate(bands):
        out[2 * i, : len(seq)] = np.array(seq, dtype=int)
    return out


