from __future__ import annotations

import random
from collections import Counter

import numpy as np


BG = 8
PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
AXES = {
    \"h\": np.array([0, 1], dtype=int),
    \"v\": np.array([1, 0], dtype=int),
    \"d1\": np.array([1, 1], dtype=int),
    \"d2\": np.array([1, -1], dtype=int),
}
MAX_ATTEMPTS = 400


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            pts = []
            while stack:
                cr, cc = stack.pop()
                pts.append((cr, cc))
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        if dr == 0 and dc == 0:
                            continue
                        nr = cr + dr
                        nc = cc + dc
                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                            seen[nr, nc] = True
                            stack.append((nr, nc))
            comps.append(np.array(pts, dtype=int))
    return comps


def _color_sequence(coords: np.ndarray, values: np.ndarray) -> list[int]:
    best_score = None
    best_order = None
    for axis in AXES.values():
        proj = coords @ axis
        means = []
        penalties = 0.0
        for color in sorted(set(map(int, values.tolist()))):
            vals = proj[values == color]
            lo = int(vals.min())
            hi = int(vals.max())
            means.append((float(vals.mean()), color, lo, hi, len(vals)))
        means.sort()
        order = [color for _mean, color, _lo, _hi, _cnt in means]
        for i in range(len(means) - 1):
            left = means[i]
            right = means[i + 1]
            overlap = max(0, left[3] - right[2] + 1)
            penalties += overlap * 1000.0
            penalties += max(0.0, left[0] - right[0]) * 100.0
        span = max(int(proj.max()) - int(proj.min()), 1)
        color_span = sum(item[3] - item[2] + 1 for item in means)
        score = (penalties, -span, color_span, tuple(order))
        if best_score is None or score < best_score:
            best_score = score
            best_order = order
    assert best_order is not None
    return best_order


def main(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = BG if np.count_nonzero(g == BG) else int(Counter(map(int, g.ravel())).most_common(1)[0][0])
    comps = _components(g "'!= bg)
    assert comps, "expected at least one foreground object"

    objects = []
    for comp in comps:
        colors = [int(g[r, c]) for r, c in comp]
        uniq = []
        for color in colors:
            if color not in uniq:
                uniq.append(color)
        assert 2 <= len(set(colors)) <= 4, "expected multi-color foreground objects"
        seq = _color_sequence(comp, np.array(colors, dtype=int))
        r0 = int(comp[:, 0].min())
        c0 = int(comp[:, 1].min())
        objects.append((c0, r0, seq))

    objects.sort(key=lambda item: (item[0], item[1]))
    bands = [seq for _c0, _r0, seq in objects]
    out_h = len(bands) * 2 - 1
    out_w = max(len(seq) for seq in bands)
    out = np.full((out_h, out_w), bg, dtype=int)
    for i, seq in enumerate(bands):
        out[2 * i, : len(seq)] = np.array(seq, dtype=int)
    return out


# --------------- generator ---------------


def _banded_patch(height: int, width: int, colors: list[int], axis_name: str) -> np.ndarray:
    patch = np.full((height, width), BG, dtype=int)
    axis = AXES[axis_name]
    coords = np.array([(r, c) for r in range(height) for c in range(width)], dtype=int)
    proj = coords @ axis
    uniq = sorted(set(map(int, proj.tolist())))
    assert len(uniq) >= len(colors)

    cut_points = sorted(random.sample(range(1, len(uniq)), len(colors) - 1))
    bins = [0] + cut_points + [len(uniq)]
    level_to_band = {}
    for band_i in range(len(colors)):
        for idx in range(bins[band_i], bins[band_i + 1]):
            level_to_band[uniq[idx]] = band_i

    for r in range(height):
        for c in range(width):
            patch[r, c] = int(colors[level_to_band[int(r * axis[0] + c * axis[1])]])
    return patch


def _placeable(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
    h, w = patch.shape
    gh, gw = grid.shape
    if r0 < 0 or c0 < 0 or r0 + h > gh or c0 + w > gw:
        return False
    for rr in range(max(0, r0 - 1), min(gh, r0 + h + 1)):
        for cc in range(max(0, c0 - 1), min(gw, c0 + w + 1)):
            if grid[rr, cc] != BG:
                inside = r0 <= rr < r0 + h and c0 <= cc < c0 + w
                if inside:
                    return False
                if rr < r0 or rr >= r0 + h or cc < c0 or cc >= c0 + w:
                    return False
    return True


def _expected_from_specs(specs: list[tuple[int, int, list[int]]]) -> np.ndarray:
    specs = sorted(specs, key=lambda item: (item[1], item[0]))
    seqs = [seq for _r0, _c0, seq in specs]
    out = np.full((len(seqs) * 2 - 1, max(len(seq) for seq in seqs)), BG, dtype=int)
    for i, seq in enumerate(seqs):
        out[2 * i, : len(seq)] = seq
    return out


def _sample_object_count() -> int:
    return random.randint(2, 5)


def _sample_axis_counts(obj_count: int) -> list[str]:
    axis_names = list(AXES)
    random.shuffle(axis_names)
    picks = []
    while len(picks) < obj_count:
        picks.extend(axis_names)
        random.shuffle(axis_names)
    return picks[:obj_count]


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(14, 28)
    width = random.randint(14, 28)
    grid = np.full((height, width), BG, dtype=int)
    obj_count = _sample_object_count()
    axis_names = _sample_axis_counts(obj_count)

    specs: list[tuple[int, int, list[int]]] = []
    for axis_name in axis_names:
        color_count = random.randint(2, 4)
        colors = random.sample(PALETTE, color_count)
        if random.random() < 0.5:
            colors.reverse()

        if axis_name in ("h", "v"):
            ph = random.randint(3, 6)
            pw = random.randint(max(color_count, 4), 8)
            if axis_name == "v":
                ph = random.randint(max(color_count, 4), 8)
                pw = random.randint(3, 6)
        else:
            min_side = max(color_count + 1, 4)
            ph = random.randint(min_side, 8)
            pw = random.randint(min_side, 8)

        patch = _banded_patch(ph, pw, colors, axis_name)
        pos_choices = [(r0, c0) for r0 in range(1, height - ph - 1) for c0 in range(1, width - pw - 1)]
        random.shuffle(pos_choices)
        placed = False
        for r0, c0 in pos_choices:
            if not _placeable(grid, patch, r0, c0):
                continue
            grid[r0 : r0 + ph, c0 : c0 + pw] = patch
            specs.append((r0, c0, colors[:]))
            placed = True
            break
        if not placed:
            return None

    expected = _expected_from_specs(specs)
    actual = main(grid)
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("generate_input failed after repeated attempts")
