+
+def _components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(cells)
+    return comps
+
+
+def _normalize_cells(cells):
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    r0, c0 = min(rs), min(cs)
+    h = max(rs) - r0 + 1
+    w = max(cs) - c0 + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    cells = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    return _normalize_cells(cells)
+
+
+def _rotations(mask: np.ndarray):
+    variants = []
+    seen = set()
+    for k in range(4):
+        rot = _normalize_mask(np.rot90(mask, k))
+        key = rot.tobytes()
+        if key not in seen:
+            seen.add(key)
+            variants.append(rot)
+    return variants
+
+
+def _same_shape_under_rotation(a: np.ndarray, b: np.ndarray) -> bool:
+    for rot in _rotations(a):
+        if rot.shape == b.shape and np.array_equal(rot, b):
+            return True
+    return False
