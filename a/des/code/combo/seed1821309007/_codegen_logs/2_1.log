+                        continue
+                    if _touching(square_cells, occupied_input, margin=0):
+                        continue
+                    _paint_cells(grid, cells, GREY)
+                    _reserve_cells(occupied_input, cells)
+                    _reserve_cells(occupied_output, square_cells)
+                    placed = True
+                    break
+                if placed:
+                    break
+            if not placed:
+                ok = False
