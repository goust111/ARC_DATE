+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            color = int(colors[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
