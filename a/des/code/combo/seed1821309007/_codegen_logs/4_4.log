+        w = c1 - c0 + 1
+        if h > max_h or w > max_w:
+            continue
+        patch = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            patch[r - r0, c - c0] = True
+        return patch
+    return None
+
+
+def _sample_object_areas(inner_h: int, inner_w: int, n_obj: int) -> list[int] | None:
+    max_area = max(1, inner_h * inner_w // 3)
+    candidates = list(range(1, max_area + 1))
+    random.shuffle(candidates)
+    areas: list[int] = []
+    for area in candidates:
+        if len(areas) == n_obj:
+            break
+        if area not in areas:
+            areas.append(area)
+    if len(areas) != n_obj:
+        return None
+    areas.sort(reverse=True)
+    return areas
+
+
+def _place_objects(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    inner_h: int,
+    inner_w: int,
+    colors: list[int],
+    areas: list[int],
+) -> bool:
+    occupied: set[tuple[int, int]] = set()
+    blocked: set[tuple[int, int]] = set()
+
+    order = list(range(len(colors)))
+    random.shuffle(order)
+    for idx in order:
+        area = int(areas[idx])
+        shape = _random_connected_shape(area, inner_h, inner_w)
+        if shape is None:
+            return False
+        sh, sw = shape.shape
+
+        positions = [
+            (r, c)
+            for r in range(inner_h - sh + 1)
+            for c in range(inner_w - sw + 1)
+        ]
+        random.shuffle(positions)
+
+        placed = False
+        for r, c in positions:
+            coords = {
