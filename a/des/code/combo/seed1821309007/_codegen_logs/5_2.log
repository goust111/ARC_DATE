+import numpy as np
+
+
+BG = 8
+SEP = 5
+GEN_RETRIES = 300
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _panel_slices(grid: np.ndarray) -> list[tuple[int, int]]:
+    rows = []
+    start = 0
+    for r in range(grid.shape[0]):
+        if np.all(grid[r] == SEP):
+            if start < r:
+                rows.append((start, r))
+            start = r + 1
+    if start < grid.shape[0]:
+        rows.append((start, grid.shape[0]))
+    return rows
+
+
+def _panel_object_mask(panel: np.ndarray) -> np.ndarray:
+    mask = panel != BG
+    comps = _components(mask)
+    if not comps:
+        return np.zeros_like(mask, dtype=bool)
+    largest = max(comps, key=len)
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in largest:
+        out[r, c] = True
+    return out
+
+
+def _gap_direction(mask: np.ndarray) -> str:
+    h, w = mask.shape
+    touches = {
+        "up": bool(mask[0].any()),
+        "down": bool(mask[h - 1].any()),
+        "left": bool(mask[:, 0].any()),
+        "right": bool(mask[:, w - 1].any()),
+    }
+    missing = [name for name, hit in touches.items() if not hit]
+    if len(missing) != 1:
+        raise ValueError(f"expected exactly one gap side, got {touches}")
+    return missing[0]
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    bg_mask = ~mask
+    count = 0
+    h, w = mask.shape
+    for comp in _components(bg_mask):
+        if any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in comp):
+            continue
+        count += 1
+    return count
+
+
+def _extrude(mask: np.ndarray, direction: str, amount: int) -> np.ndarray:
+    out = mask.copy()
+    if amount <= 0:
+        return out
+
+    h, w = mask.shape
+    if direction == "up":
+        for c in range(w):
+            rows = np.where(mask[:, c])[0]
+            if rows.size == 0:
+                continue
+            top = int(rows.min())
+            out[max(0, top - amount) : top, c] = True
+    elif direction == "down":
+        for c in range(w):
+            rows = np.where(mask[:, c])[0]
+            if rows.size == 0:
+                continue
+            bottom = int(rows.max())
+            out[bottom + 1 : min(h, bottom + 1 + amount), c] = True
+    elif direction == "left":
+        for r in range(h):
+            cols = np.where(mask[r])[0]
+            if cols.size == 0:
+                continue
+            left = int(cols.min())
+            out[r, max(0, left - amount) : left] = True
+    elif direction == "right":
+        for r in range(h):
+            cols = np.where(mask[r])[0]
+            if cols.size == 0:
+                continue
+            right = int(cols.max())
+            out[r, right + 1 : min(w, right + 1 + amount)] = True
+    else:
+        raise ValueError(direction)
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    for r0, r1 in _panel_slices(g):
+        panel = g[r0:r1]
+        mask = _panel_object_mask(panel)
+        if not mask.any():
+            continue
+        direction = _gap_direction(mask)
+        holes = _hole_count(mask)
+        grown = _extrude(mask, direction, holes)
+        color = int(np.unique(panel[mask])[0])
+        out[r0:r1][grown] = color
+    return out
+
