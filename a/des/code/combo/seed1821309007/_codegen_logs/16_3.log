+def _path_clear(
+    path: list[tuple[int, int]],
+    own_cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    reserved_paths: list[set[tuple[int, int]]],
+) -> bool:
+    path_set = set(path)
+    if path_set & (occupied - own_cells):
