PANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)
COLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)

