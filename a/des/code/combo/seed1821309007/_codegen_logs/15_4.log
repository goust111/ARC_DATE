+                if not np.all((interior == bg) | (interior == marker)):
+                    continue
+                outside_left = c0 == 0 or int(grid[r, c0 - 1]) == bg
+                outside_right = c1 == w - 1 or int(grid[r, c1 + 1]) == bg
+                if outside_left and outside_right:
