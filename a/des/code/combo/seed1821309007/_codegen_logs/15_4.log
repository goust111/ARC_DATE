+def _find_gate_pairs(grid: np.ndarray, bg: int, marker: int) -> list[tuple[int, int, int, int]]:
+    h, w = grid.shape
+    pairs: list[tuple[int, int, int, int]] = []
+    for r in range(h):
+        non_bg_cols = [c for c in range(w) if int(grid[r, c]) != bg]
+        if len(non_bg_cols) < 2:
