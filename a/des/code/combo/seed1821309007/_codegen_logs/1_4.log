+        total_w = sum(child["w"] for child in children) + gap * (child_count - 1)
+        extra_h = rng.randint(0, 2)
+        h = content_h + 2 * (margin + 1) + extra_h
+        w = total_w + 2 * (margin + 1)
+        patch = np.zeros((h, w), dtype=int)
+        patch[0, :] = 1
+        patch[-1, :] = 1
+        patch[:, 0] = 1
+        patch[:, -1] = 1
+        cur_c = margin + 1
+        placements = []
+        for child in children:
