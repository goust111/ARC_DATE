+        elif parents[i] is not None:
+            new_color = original_colors[parents[i]]
+        else:
+            new_color = original_colors[i]
+        coords = comp["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(new_color)
+
+    return out
+
+
+def _make_leaf_patch(rng: random.Random) -> np.ndarray:
+    h = rng.randint(2, 4)
+    w = rng.randint(2, 4)
