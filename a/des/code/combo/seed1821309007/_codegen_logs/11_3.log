+import numpy as np
+from collections import deque
+
+
+BG = 0
+TRAIL = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
+
+
+def _components_by_color(grid: np.ndarray):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append((color, pts))
+    return comps
+
+
+def _bbox(points):
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _opening_direction(points):
+    r0, c0, r1, c1 = _bbox(points)
+    edge_hits = {"up": False, "down": False, "left": False, "right": False}
+    point_set = set(points)
+    for c in range(c0, c1 + 1):
+        if (r0, c) in point_set:
+            edge_hits["up"] = True
+        if (r1, c) in point_set:
+            edge_hits["down"] = True
+    for r in range(r0, r1 + 1):
+        if (r, c0) in point_set:
+            edge_hits["left"] = True
+        if (r, c1) in point_set:
+            edge_hits["right"] = True
+    missing = [name for name, hit in edge_hits.items() if not hit]
+    assert len(missing) == 1, f"expected exactly one open side, got {missing}"
+    return missing[0]
+
+
