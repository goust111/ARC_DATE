+def _grow_connected_shape(height: int, width: int, area: int) -> set[tuple[int, int]]:
+    start = (random.randrange(height), random.randrange(width))
+    cells = {start}
+    while len(cells) < area:
+        frontier = []
+        for r, c in cells:
+            for dr, dc in NEIGHBORS4:
