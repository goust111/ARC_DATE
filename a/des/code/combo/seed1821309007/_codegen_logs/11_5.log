+    mask[r0 : r0 + h, c0 : c0 + w] = True
+    mask[r0 + 1 : r0 + h - 1, c0 + 1 : c0 + w - 1] = False
+    return mask
+
+
+def _l_mask(size: int) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
