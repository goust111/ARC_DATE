+def _checker_rule(size: int, colors: list[int]) -> np.ndarray:
+    rr, cc = np.indices((size, size))
+    mode = random.choice((0, 1))
+    pat = np.where((rr + cc + mode) % 2 == 0, colors[0], colors[1]).astype(int)
