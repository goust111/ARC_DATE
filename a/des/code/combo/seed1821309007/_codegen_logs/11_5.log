+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+CELL_SIZE_RANGE = (4, 7)
+GRID_CELLS_RANGE = (2, 4)
+TARGET_COUNT_MIN = 2
+MAX_GENERATION_ATTEMPTS = 400
+
+RULE_TYPES = (
+    "horizontal",
+    "vertical",
+    "quadrants",
+    "diag_main",
+    "diag_anti",
+    "checker",
+)
