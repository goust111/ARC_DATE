+            r0 = ri * (cell_size + 1)
+            c0 = ci * (cell_size + 1)
+            cell = grid[r0 : r0 + cell_size, c0 : c0 + cell_size]
+            if (ri, ci) == ref_pos:
+                cell[:] = reference
+            else:
