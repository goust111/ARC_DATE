+    w = random.randint(2, size)
+    r0 = random.randint(0, size - h)
+    c0 = random.randint(0, size - w)
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    if corner == "tl":
+        mask[r0 : r0 + h, c0] = True
+        mask[r0 + h - 1, c0 : c0 + w] = True
+    elif corner == "tr":
+        mask[r0 : r0 + h, c0 + w - 1] = True
+        mask[r0 + h - 1, c0 : c0 + w] = True
+    elif corner == "bl":
+        mask[r0 : r0 + h, c0] = True
+        mask[r0, c0 : c0 + w] = True
+    else:
