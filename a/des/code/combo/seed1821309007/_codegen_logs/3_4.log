+    for i, j in enumerate(nearest):
+        if nearest[j] != i:
+            new_color = int(objects[j]["color"])
+            for r, c in objects[i]["cells"]:
+                out[r, c] = new_color
+
+    for i, j in enumerate(nearest):
+        if i < j and nearest[j] == i:
+            for r, c in _path_cells(objects[i]["center"], objects[j]["center"]):
+                if int(g[r, c]) == AZURE:
+                    out[r, c] = MAROON
+
+    return out
