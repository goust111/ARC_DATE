+    br, bc = b
+    cells = []
+    step_c = 1 if bc >= ac else -1
+    for c in range(ac, bc + step_c, step_c):
+        cells.append((ar, c))
+    step_r = 1 if br >= ar else -1
+    for r in range(ar + step_r, br + step_r, step_r):
+        cells.append((r, bc))
+    return cells
