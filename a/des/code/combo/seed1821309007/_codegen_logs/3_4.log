+def _valid_specs(h: int, w: int, specs: list[dict], desired: list[int]) -> bool:
+    for spec in specs:
+        for r, c in spec["cells"]:
+            if not (0 <= r < h and 0 <= c < w):
+                return False
+
+    for i in range(len(specs)):
