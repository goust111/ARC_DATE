+def _neighbors4(r: int, c: int, side: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < side and 0 <= cc < side:
+            out.append((rr, cc))
+    return out
