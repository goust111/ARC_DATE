+        ((center_r - 0.0) ** 2 + (center_c - (size - 1)) ** 2, "tr"),
+        ((center_r - (size - 1)) ** 2 + (center_c - 0.0) ** 2, "bl"),
+        ((center_r - (size - 1)) ** 2 + (center_c - (size - 1)) ** 2, "br"),
