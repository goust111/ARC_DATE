+        r0 = int(spec["top"])
+        c0 = int(spec["left"])
+        r1 = r0 + int(spec["height"]) - 1
+        c1 = c0 + int(spec["width"]) - 1
+        mid_r = (r0 + r1) // 2
+        mid_c = (c0 + c1) // 2
+        out[r0, mid_c] = color
+        out[r1, mid_c] = color
+        out[mid_r, c0] = color
+        out[mid_r, c1] = color
+    return out
+
