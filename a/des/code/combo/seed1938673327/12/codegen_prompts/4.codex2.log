+def _sample_specs(height: int, width: int) -> list[dict[str, int]] | None:
+    max_objects = min(
+        OBJECT_COUNT_RANGE[1],
+        len(FOREGROUND_COLORS),
+        max(OBJECT_COUNT_RANGE[0], (height * width) // 45 + 1),
+    )
+    if max_objects < OBJECT_COUNT_RANGE[0]:
