+        out[r1, mid_c] = color
+        out[mid_r, c0] = color
+        out[mid_r, c1] = color
+
+    return out
+
+
+# --------------- generator ---------------
+
+BACKGROUND = 0
+FOREGROUND_COLORS = tuple(range(1, 10))
+GRID_HEIGHT_RANGE = (10, 22)
+GRID_WIDTH_RANGE = (10, 22)
+OBJECT_COUNT_RANGE = (1, 5)
+RECT_SIDE_MIN = 3
+RECT_SIDE_MAX = 11
+GRID_BORDER = 1
+OBJECT_GAP = 1
+MIN_BACKGROUND_RATIO = 0.45
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _odd_sizes(limit: int) -> list[int]:
