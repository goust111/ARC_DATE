    outer_bbox = (outer_r0, outer_c0, outer_r0 + outer_h - 1, outer_c0 + outer_w - 1)
    bboxes = _build_bboxes(outer_bbox, gaps)

    total_colors = legend_len + frame_count
    assert total_colors <= 9
    palette = list(range(1, 10))

