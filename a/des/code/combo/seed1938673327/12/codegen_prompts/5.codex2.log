+def _frame_perimeter(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
