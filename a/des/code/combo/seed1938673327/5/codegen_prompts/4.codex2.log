+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+MOVE_LEN = 2
+BG_COLOR = 5
+FG_COLORS = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_H_BOUNDS = (12, 19)
+GRID_W_BOUNDS = (12, 19)
+PAIR_COUNT_BOUNDS = (1, 4)
+TARGET_AREA_BOUNDS = (1, 6)
+RAY_GAP_BOUNDS = (2, 6)
+
+GENERATION_ATTEMPTS = 400
+PAIR_PLACEMENT_ATTEMPTS = 250
+POLYOMINO_ATTEMPTS = 80
+
+DIR_CONFIGS = (
+    {"dir": (-1, -1), "missing": (0, 0)},
+    {"dir": (-1, 1), "missing": (0, 1)},
+    {"dir": (1, -1), "missing": (1, 0)},
+    {"dir": (1, 1), "missing": (1, 1)},
+)
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == int(bg):
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
+
+def _arrow_info(comp: dict[str, object]) -> dict[str, object] | None:
+    coords = np.asarray(comp["coords"], dtype=int)
+    if coords.shape[0] != 3:
+        return None
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return None
+
+    local = {(int(r - r0), int(c - c0)) for r, c in coords}
+    full = {(0, 0), (0, 1), (1, 0), (1, 1)}
+    missing = full - local
+    if len(missing) != 1:
+        return None
+
+    mr, mc = next(iter(missing))
+    dr = -1 if mr == 0 else 1
+    dc = -1 if mc == 0 else 1
+    return {
+        "dir": (dr, dc),
+        "missing_local": (mr, mc),
+        "missing_global": (int(r0 + mr), int(c0 + mc)),
+    }
+
+
+def _in_bounds(shape: tuple[int, int], coord: tuple[int, int]) -> bool:
+    r, c = coord
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _trace_target(
+    grid: np.ndarray,
+    bg: int,
+    cell_to_comp: np.ndarray,
+    arrow_ids: set[int],
+    comps: list[dict[str, object]],
+    arrow: dict[str, object],
+) -> int:
+    r, c = arrow["missing_global"]
+    dr, dc = arrow["dir"]
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(grid.shape, (r, c)):
+            break
+        if int(grid[r, c]) == int(bg):
+            continue
