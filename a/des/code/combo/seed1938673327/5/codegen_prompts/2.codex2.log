+def _random_frame_sides() -> dict[str, int]:
+    names = ("top", "bottom", "left", "right")
+    while True:
+        colors = {name: random.choice((RED, BLUE)) for name in names}
+        if len(set(colors.values())) == 2:
+            return colors
+
