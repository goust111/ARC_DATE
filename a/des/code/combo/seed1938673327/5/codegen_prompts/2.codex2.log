+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+OBJECT_COLORS = (3, 4, 5, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 300
