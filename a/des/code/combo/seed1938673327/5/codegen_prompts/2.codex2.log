+    for rr0, cc0, patch in placements:
+        view = out[r0 + 1 + rr0 : r0 + 1 + rr0 + patch.shape[0], c0 + 1 + cc0 : c0 + 1 + cc0 + patch.shape[1]]
+        mask = patch != bg
