+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _edge_color(values: np.ndarray, bg: int) -> int:
+    colors = [int(v) for v in np.ravel(values) if int(v) != bg]
+    assert colors, "frame edge must contain a non-background color"
+    return int(Counter(colors).most_common(1)[0][0])
+
+
+def _mode_for_colors(colors: set[int]) -> str:
+    if RED in colors and BLUE in colors:
+        return "rot180"
+    if RED in colors:
+        return "hflip"
+    if BLUE in colors:
+        return "vflip"
+    return "none"
+
+
+def _apply_mode(patch: np.ndarray, mode: str) -> np.ndarray:
+    if mode == "hflip":
+        return np.fliplr(patch)
+    if mode == "vflip":
+        return np.flipud(patch)
+    if mode == "rot180":
+        return np.rot90(patch, 2)
+    return patch.copy()
