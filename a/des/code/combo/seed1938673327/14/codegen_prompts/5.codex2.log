+def _mode_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for dr, dc in DIR4:
+                    nr = r + dr
+                    nc = c + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(cells, dtype=int))
+    return out
+
+
+def _extract_objects(grid: np.ndarray, bg: int) -> tuple[list[dict[str, object]], np.ndarray]:
+    h, w = grid.shape
+    labels = np.full((h, w), -1, dtype=int)
+    objects: list[dict[str, object]] = []
+
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != int(bg)):
+        for coords in _components(grid == color):
+            idx = len(objects)
+            labels[coords[:, 0], coords[:, 1]] = idx
+            anchor = min((int(r), int(c)) for r, c in coords)
+            objects.append(
