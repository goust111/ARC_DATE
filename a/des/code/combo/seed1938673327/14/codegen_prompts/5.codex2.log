+        a_cells, b_cells = _normalize_pair(a, b)
+        if rng.random() < 0.5:
+            a_cells, b_cells = _flip_pair(a_cells, b_cells, flip_r=True, flip_c=False)
+        if rng.random() < 0.5:
+            a_cells, b_cells = _flip_pair(a_cells, b_cells, flip_r=False, flip_c=True)
