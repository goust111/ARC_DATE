+
+def _paint(grid: np.ndarray, cells: list[tuple[int, int]], top: int, left: int, color: int) -> None:
+    for r, c in cells:
+        grid[top + r, left + c] = color
+
+
+def _place_cluster(
+    grid: np.ndarray,
