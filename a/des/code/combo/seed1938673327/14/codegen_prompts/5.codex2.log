+            h2 = rng.randint(2, 5)
+            offset = contact_len - w2 if rng.random() < 0.5 else w1 - contact_len
+            a = {(r, c) for r in range(h1) for c in range(w1)}
+            b = {(h1 + r, offset + c) for r in range(h2) for c in range(w2)}
+
+        a_cells = _normalize(a)
+        b_cells = _normalize(b)
+        if rng.random() < 0.5:
+            a_cells = _flip_cells(a_cells, flip_r=True, flip_c=False)
+            b_cells = _flip_cells(b_cells, flip_r=True, flip_c=False)
+        if rng.random() < 0.5:
+            a_cells = _flip_cells(a_cells, flip_r=False, flip_c=True)
+            b_cells = _flip_cells(b_cells, flip_r=False, flip_c=True)
