+                    key = (a, b) if a < b else (b, a)
+                    entry = info.setdefault(key, {"count": 0, "pixels": set()})
+                    entry["count"] = int(entry["count"]) + 1
+                    entry["pixels"].add((r, c))
+                    entry["pixels"].add((r + 1, c))
+    return info
