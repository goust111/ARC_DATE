+    min_c = min(min(c for _, c in a_cells), min(c for _, c in b_cells))
+    a_norm = sorted((r - min_r, c - min_c) for r, c in a_cells)
+    b_norm = sorted((r - min_r, c - min_c) for r, c in b_cells)
+    return a_norm, b_norm
