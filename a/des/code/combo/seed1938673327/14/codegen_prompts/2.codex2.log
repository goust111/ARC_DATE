+                continue
+            seen[r, c] = True
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(comp)
+    return components
