+    segments: list[list[tuple[int, int]]] = []
+    if direction[0] == 0:
+        for r in range(h):
+            for c0 in range(w - length + 1):
+                segments.append([(r, c0 + i) for i in range(length)])
+    else:
+        for r0 in range(h - length + 1):
