+        r = int(rows[0])
+        c0 = int(np.min(cols))
+        c1 = int(np.max(cols))
+        if c1 - c0 + 1 != len(coords):
+            return None
+        return [(r, c) for c in range(c0, c1 + 1)]
+    if np.all(cols == cols[0]):
