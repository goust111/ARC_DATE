+def _paint_pointer(
+    grid: np.ndarray,
+    source: list[tuple[int, int]],
+    direction: tuple[int, int],
+    body_color: int,
+    arrow_color: int,
+) -> None:
+    if direction == (0, 1) or direction == (1, 0):
+        arrow_cell = source[-1]
+    else:
+        arrow_cell = source[0]
+    for r, c in source:
+        grid[r, c] = arrow_color if (r, c) == arrow_cell else body_color
+
