+def _random_polyomino(rng: np.random.Generator) -> list[tuple[int, int]] | None:
+    for _ in range(SHAPE_RETRIES):
+        area = int(rng.integers(MIN_OBJECT_AREA, MAX_OBJECT_AREA + 1))
