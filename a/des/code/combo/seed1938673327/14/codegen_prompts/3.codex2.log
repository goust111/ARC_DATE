+
+def _sample_room_specs(total_rooms: int) -> list[dict]:
+    counts = list(ROOM_COUNTS)
+    counts.extend(random.choice(ROOM_COUNTS) for _ in range(total_rooms - len(ROOM_COUNTS)))
+    random.shuffle(counts)
