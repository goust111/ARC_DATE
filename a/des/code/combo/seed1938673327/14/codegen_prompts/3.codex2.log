+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if r == 0 or not mask[r - 1, c]:
+                edges.append(((r, c), (r, c + 1)))
+            if c == w - 1 or not mask[r, c + 1]:
+                edges.append(((r, c + 1), (r + 1, c + 1)))
+            if r == h - 1 or not mask[r + 1, c]:
