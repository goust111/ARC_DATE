+
+
+def _wall_patch(interior: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    region = np.pad(interior.astype(bool), 1)
+    wall = np.zeros_like(region, dtype=bool)
+    for r, c in np.argwhere(region):
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
