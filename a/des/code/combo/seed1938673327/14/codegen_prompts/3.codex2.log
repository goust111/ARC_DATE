+def _draw_cross(out: np.ndarray, coords: np.ndarray, color: int) -> None:
+    region = {tuple(map(int, cell)) for cell in coords.tolist()}
+    cr, cc = _choose_center(coords)
+    out[cr, cc] = int(color)
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        r, c = cr, cc
+        while True:
+            nr, nc = r + dr, c + dc
+            if (nr, nc) not in region:
+                break
+            out[nr, nc] = int(color)
+            r, c = nr, nc
