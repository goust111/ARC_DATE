+    target_r = (r0 + r1) / 2.0
+    target_c = (c0 + c1) / 2.0
+    best = min(
+        (tuple(map(int, cell)) for cell in coords.tolist()),
+        key=lambda rc: (
+            (rc[0] - target_r) ** 2 + (rc[1] - target_c) ** 2,
+            abs(rc[0] - target_r),
+            abs(rc[1] - target_c),
+            rc[0],
+            rc[1],
+        ),
+    )
+    return int(best[0]), int(best[1])
