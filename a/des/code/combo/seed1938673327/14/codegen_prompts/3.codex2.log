+    specs = []
+    for count in counts:
+        interior = _interior_shape(count)
+        region, wall = _wall_patch(interior)
+        specs.append(
+            {
+                "corners": count,
+                "region": region,
+                "wall": wall,
+                "footprint_h": int(region.shape[0]),
+                "footprint_w": int(region.shape[1]),
+                "area": int(region.size),
+            }
+        )
