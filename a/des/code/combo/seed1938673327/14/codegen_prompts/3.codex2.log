+    for a, b in zip(path, path[1:], strict=False):
+        dr = int(b[0] - a[0])
+        dc = int(b[1] - a[1])
+        dirs.append((0, 1) if dc > 0 else (0, -1) if dc < 0 else (1, 0) if dr > 0 else (-1, 0))
