+    radius = dist - 1
+    top = max(0, r - radius)
+    bottom = min(h - 1, r + radius)
+    left = max(0, c - radius)
+    right = min(w - 1, c + radius)
+
+    cells = {(r, c)}
+    for cc in range(left, right + 1):
+        cells.add((top, cc))
