+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MAX_ATTEMPTS = 300
+MAX_CANVAS = 30
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
