from collections import deque
import random


def bfs_path(h,w,start,goals,blocked,extra_allowed=()):
    goals=set(goals)
    blocked=set(blocked)-set(extra_allowed)-{start}
    q=deque([start])
    parent={start:None}
    while q:
        r,c=q.popleft()
        if (r,c) in goals:
            path=[]
            cur=(r,c)
            while cur is not None:
                path.append(cur)
                cur=parent[cur]
            return path[::-1]
        dirs=[(-1,0),(1,0),(0,-1),(0,1)]
        random.shuffle(dirs)
        for dr,dc in dirs:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in blocked and (nr,nc) not in parent:
                parent[(nr,nc)]=(r,c)
                q.append((nr,nc))
    return None


def build_region(h,w,terminals,blocked):
    order=list(terminals)
    random.shuffle(order)
    region={order[0]}
    for t in order[1:]:
        path=bfs_path(h,w,t,region,blocked,extra_allowed=region|{t})
        if path is None:
            return None
        region.update(path)
    return region


def gen_once():
    k=random.choice([2,3])
    h=random.randint(max(5,k+3),10)
    w=random.randint(max(5,k+3),10)
    top=random.sample(range(1,w-1),k)
    bot=random.sample(range(1,w-1),k)
    left=random.sample(range(1,h-1),k)
    right=random.sample(range(1,h-1),k)
