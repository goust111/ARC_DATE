from __future__ import annotations
import hashlib, time
from collections import deque
import numpy as np

BG=0
MAX_ATTEMPTS=300

def components8(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    comps=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            comp=[]
            while q:
                rr,cc=q.popleft(); comp.append((rr,cc))
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        if dr==0 and dc==0: continue
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=True
                            q.append((nr,nc))
            comps.append(comp)
    return comps

def bg_color(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])

def main(grid):
    g=np.asarray(grid,dtype=int)
    bg=bg_color(g)
    patches=[]
    for comp in components8(g"'!=bg):
        rs=[r for r,_ in comp]; cs=[c for _,c in comp]
        r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
        patches.append(((r0,c0), g[r0:r1+1,c0:c1+1]))
    patches.sort(key=lambda x:x[0])
    h,w=patches[0][1].shape
    out=np.full((h,w),bg,dtype=int)
    for _,patch in patches:
        mask=patch!=bg
        fill=(out==bg)&mask
        out[fill]=patch[fill]
    return out

def gen_disjoint_walks(k,w,h,rng):
    starts=tuple(sorted(rng.choice(w, size=k, replace=False).tolist()))
    init_left=sum((1<<i) for i,c in enumerate(starts) if c==0)
    init_right=sum((1<<i) for i,c in enumerate(starts) if c==w-1)
    path_cache={}
    memo={}
    def dfs(row, cols, left_mask, right_mask):
        key=(row, cols, left_mask, right_mask)
        if key in memo:
            return memo[key]
        if row==h-1:
            full=(1<<k)-1
            ok=left_mask==full and right_mask==full
            memo[key]=ok
            return ok
        remaining=h-1-row
        for i,c in enumerate(cols):
            if not (left_mask>>i)&1 and c>remaining:
                memo[key]=False
                return False
            if not (right_mask>>i)&1 and (w-1-c)>remaining:
                memo[key]=False
                return False
        cand_lists=[]
        for c in cols:
            vals=[nc for d in (-1,0,1) if 0<=(nc:=c+d)<w]
            rng.shuffle(vals)
            cand_lists.append(vals)
        order=sorted(range(k), key=lambda i: len(cand_lists[i]))
        next_cols=[None]*k
        used=set()
        def backtrack(idx):
            if idx==k:
                nxt=tuple(next_cols)
                lm,rm=left_mask,right_mask
                for i,x in enumerate(nxt):
                    if x==0: lm |= 1<<i
                    if x==w-1: rm |= 1<<i
                if dfs(row+1, nxt, lm, rm):
                    path_cache[key]=nxt
                    return True
                return False
            i=order[idx]
            vals=list(cand_lists[i])
            vals.sort(key=lambda x: (x != 0, x != w - 1, abs(2 * x - (w - 1))))
            for x in vals:
                if x in used:
                    continue
                next_cols[i]=x
                used.add(x)
                if backtrack(idx+1):
                    return True
                used.remove(x)
                next_cols[i]=None
            return False
        ok=backtrack(0)
        memo[key]=ok
        return ok
    if not dfs(0, starts, init_left, init_right):
        return None
    cols_per_row=[starts]
    cur=starts
    left_mask,right_mask=init_left,init_right
    for row in range(h-1):
        nxt=path_cache[(row, cur, left_mask, right_mask)]
        cols_per_row.append(nxt)
        for i,x in enumerate(nxt):
            if x==0: left_mask |= 1<<i
            if x==w-1: right_mask |= 1<<i
        cur=nxt
    return [[cols_per_row[r][i] for r in range(h)] for i in range(k)]

def build_patch(k,rng):
    width=int(rng.integers(max(5,k+2), 8))
    height=int(rng.integers(2*width, 2*width+4))
    walks=gen_disjoint_walks(k,width,height,rng)
