from __future__ import annotations
import hashlib
from collections import deque
import numpy as np

BG=0
MAX_ATTEMPTS=300


def bg_color(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])


def components8(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    comps=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            comp=[]
            while q:
                rr,cc=q.popleft(); comp.append((rr,cc))
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        if dr==0 and dc==0: continue
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=True
                            q.append((nr,nc))
            comps.append(comp)
    return comps


def main(grid):
    g=np.asarray(grid,dtype=int)
    bg=bg_color(g)
    comps=components8(g"'!=bg)
    assert comps
    patches=[]
    for comp in comps:
        rs=[r for r,_ in comp]; cs=[c for _,c in comp]
        r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
        patches.append(((r0,c0), g[r0:r1+1,c0:c1+1]))
    patches.sort(key=lambda item: item[0])
    h,w=patches[0][1].shape
    out=np.full((h,w),bg,dtype=int)
    for _,patch in patches:
        assert patch.shape==(h,w)
        mask=patch!=bg
        out[(out==bg)&mask]=patch[(out==bg)&mask]
    return out


def tri(t,w):
    period=2*(w-1)
    t%=period
    return t if t < w else period - t


def gen_disjoint_walks(k,w,h,rng):
    starts=tuple(sorted(rng.choice(w, size=k, replace=False).tolist()))
    init_left=sum((1<<i) for i,c in enumerate(starts) if c==0)
    init_right=sum((1<<i) for i,c in enumerate(starts) if c==w-1)
    path_cache={}
    memo={}

    def dfs(row, cols, left_mask, right_mask):
        key=(row, cols, left_mask, right_mask)
        if key in memo:
            return memo[key]
        if row==h-1:
            full=(1<<k)-1
            ok=left_mask==full and right_mask==full
            memo[key]=ok
            return ok
        remaining=h-1-row
        for i,c in enumerate(cols):
            if not (left_mask>>i)&1 and c>remaining:
                memo[key]=False
                return False
            if not (right_mask>>i)&1 and (w-1-c)>remaining:
                memo[key]=False
                return False
        cand_lists=[]
        for c in cols:
            vals=[nc for d in (-1,0,1) if 0<=(nc:=c+d)<w]
            rng.shuffle(vals)
            cand_lists.append(vals)
        order=sorted(range(k), key=lambda i: len(cand_lists[i]))
        next_cols=[None]*k
        used=set()

        def backtrack(idx):
            if idx==k:
                nxt=tuple(next_cols)
                lm,rm=left_mask,right_mask
                for i,x in enumerate(nxt):
                    if x==0: lm |= 1<<i
                    if x==w-1: rm |= 1<<i
                if dfs(row+1, nxt, lm, rm):
                    path_cache[key]=nxt
                    return True
                return False
            i=order[idx]
            vals=list(cand_lists[i])
            vals.sort(key=lambda x: (x != 0, x != w - 1, abs(2 * x - (w - 1))))
            for x in vals:
                if x in used:
                    continue
                next_cols[i]=x
                used.add(x)
                if backtrack(idx+1):
                    return True
                used.remove(x)
                next_cols[i]=None
            return False

        ok=backtrack(0)
        memo[key]=ok
        return ok

    if not dfs(0, starts, init_left, init_right):
        return None

    cols_per_row=[starts]
    cur=starts
    left_mask,right_mask=init_left,init_right
    for row in range(h-1):
        nxt=path_cache[(row, cur, left_mask, right_mask)]
        cols_per_row.append(nxt)
        for i,x in enumerate(nxt):
            if x==0: left_mask |= 1<<i
            if x==w-1: right_mask |= 1<<i
        cur=nxt

    return [[cols_per_row[r][i] for r in range(h)] for i in range(k)]


def build_patch(k, rng):
    width=int(rng.integers(max(5,k+2), 8))
    height=int(rng.integers(2*width, 2*width+5))
    walks=gen_disjoint_walks(k,width,height,rng)
    if walks is None:
        return None
    patch=np.zeros((height,width),dtype=int)
    palette=rng.choice(np.arange(1,10), size=int(rng.integers(3,7)), replace=False)
    all_colors=[]
    for cols in walks:
        seg_count=int(rng.integers(1, min(4, height)+1))
        split_points=sorted(rng.choice(np.arange(1,height), size=seg_count-1, replace=False).tolist()) if seg_count>1 else []
        segment_starts=[0]+split_points
        segment_ends=split_points+[height]
        seg_colors=rng.choice(palette, size=seg_count, replace=True)
        for color, a, b in zip(seg_colors, segment_starts, segment_ends):
            for r in range(a,b):
                patch[r, cols[r]] = int(color)
                all_colors.append(int(color))
    if len(set(all_colors)) < 2:
        return None
    if rng.random() < 0.5:
        patch=patch.T
    return patch


def place_patches(patches, rng):
    h,w=patches[0].shape
    k=len(patches)
    gap=2
    layouts=[]
    for rows in range(1,k+1):
        cols=(k+rows-1)//rows
        min_h=rows*h + (rows+1)*gap
        min_w=cols*w + (cols+1)*gap
        if min_h <= 30 and min_w <= 30:
            layouts.append((rows,cols,min_h,min_w))
    if not layouts:
        return None
    rows, cols, min_h, min_w = layouts[int(rng.integers(len(layouts)))]
    canvas_h=int(rng.integers(min_h, min(31, min_h+5)))
    canvas_w=int(rng.integers(min_w, min(31, min_w+5)))
    grid=np.zeros((canvas_h, canvas_w),dtype=int)
    slot_h=(canvas_h-gap)//rows
    slot_w=(canvas_w-gap)//cols
    positions=[]
    for idx in range(k):
        sr=idx//cols; sc=idx%cols
        top_min=gap + sr*slot_h
        left_min=gap + sc*slot_w
        top_max=min(canvas_h-gap-h, (sr+1)*slot_h - h)
        left_max=min(canvas_w-gap-w, (sc+1)*slot_w - w)
        if top_max < top_min or left_max < left_min:
            return None
        r0=int(rng.integers(top_min, top_max+1))
        c0=int(rng.integers(left_min, left_max+1))
        positions.append((r0,c0))
    order=rng.permutation(k)
    for patch_idx, slot_idx in enumerate(order):
        r0,c0=positions[slot_idx]
        patch=patches[patch_idx]
        grid[r0:r0+h, c0:c0+w] = np.where(patch!=0, patch, grid[r0:r0+h, c0:c0+w])
    return grid


def gen():
    rng=np.random.default_rng()
    for _ in range(MAX_ATTEMPTS):
        k=int(rng.integers(2,5))
        patches=[]
        ok=True
        for _ in range(k):
            p=build_patch(k,rng)
            if p is None:
                ok=False; break
            patches.append(p)
        if not ok:
            continue
        shapes={p.shape for p in patches}
        if len(shapes)!=1:
            continue
        grid=place_patches(patches, rng)
        if grid is None:
            continue
        comps=components8(grid!=0)
        if len(comps)!=k:
            continue
        bboxes=[]
        for comp in comps:
            rs=[r for r,_ in comp]; cs=[c for _,c in comp]
            bboxes.append((max(rs)-min(rs)+1,max(cs)-min(cs)+1))
        if len(set(bboxes))!=1:
            continue
        out=main(grid)
        if out.shape != patches[0].shape:
            continue
        return grid
    raise RuntimeError('"'failed')

s=set()
for i in range(100):
    inp=gen()
    out=main(inp)
    assert isinstance(inp,np.ndarray)
    assert isinstance(out,np.ndarray)
    s.add(hashlib.md5(inp.tobytes()+str(inp.shape).encode()).hexdigest())
print('variants',len(s))
