import random
from functools import lru_cache


def gen_paths(k,w,h):
    starts=tuple(sorted(random.sample(range(w),k)))
    init_left=sum((1<<i) for i,c in enumerate(starts) if c==0)
    init_right=sum((1<<i) for i,c in enumerate(starts) if c==w-1)
    path_cache={}

    @lru_cache(None)
    def dfs(row, cols, left_mask, right_mask):
        cols=list(cols)
        if row==h-1:
            full=(1<<k)-1
            return left_mask==full and right_mask==full
        remaining=h-1-row
        for i,c in enumerate(cols):
            if not (left_mask>>i)&1 and c>remaining:
                return False
            if not (right_mask>>i)&1 and (w-1-c)>remaining:
                return False
        cand_lists=[]
        for c in cols:
            vals=[nc for d in (-1,0,1) if 0<=(nc:=c+d)<w]
            random.shuffle(vals)
            cand_lists.append(vals)
        order=sorted(range(k), key=lambda i: len(cand_lists[i]))
        next_cols=[None]*k
        used=set()
        def backtrack(idx):
            if idx==k:
                nc=tuple(next_cols)
                lm=left_mask
                rm=right_mask
                for i,x in enumerate(nc):
                    if x==0: lm |= 1<<i
                    if x==w-1: rm |= 1<<i
                if dfs(row+1, nc, lm, rm):
                    path_cache[(row, tuple(cols), left_mask, right_mask)] = nc
                    return True
                return False
            i=order[idx]
            vals=cand_lists[i][:]
            vals.sort(key=lambda x: (x"'!=0, x!=w-1, abs(x-(w-1)/2)))
            for x in vals:
                if x in used:
                    continue
                next_cols[i]=x
                used.add(x)
                if backtrack(idx+1):
                    return True
                used.remove(x)
                next_cols[i]=None
            return False
        return backtrack(0)

    if not dfs(0, starts, init_left, init_right):
        return None
    cur=starts
    cols_per_row=[cur]
    lm,rm=init_left,init_right
    for row in range(h-1):
        nxt=path_cache[(row, cur, lm, rm)]
        cols_per_row.append(nxt)
        for i,x in enumerate(nxt):
            if x==0: lm |= 1<<i
            if x==w-1: rm |= 1<<i
        cur=nxt
    return [ [cols_per_row[r][i] for r in range(h)] for i in range(k)]

for k in [2,3,4]:
    succ=0
    for _ in range(100):
        w=random.randint(max(5,k+2),9)
        h=random.randint(max(2*w,10), max(2*w+4,12))
        p=gen_paths(k,w,h)
        succ += p is not None
    print('"'k',k,'succ',succ)
