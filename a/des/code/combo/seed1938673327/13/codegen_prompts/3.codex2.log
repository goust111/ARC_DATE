    for rows in range(1,k+1):
        cols=(k+rows-1)//rows
        min_h=rows*h + (rows+1)*gap
        min_w=cols*w + (cols+1)*gap
        if min_h <= 30 and min_w <= 30:
            layouts.append((rows,cols,min_h,min_w))
    rows,cols,min_h,min_w=layouts[int(rng.integers(len(layouts)))]
