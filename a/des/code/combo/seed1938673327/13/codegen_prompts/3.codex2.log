    canvas_w=int(rng.integers(min_w, min(31, min_w+5)))
    grid=np.zeros((canvas_h, canvas_w),dtype=int)
    slot_h=(canvas_h-gap)//rows
    slot_w=(canvas_w-gap)//cols
    slots=[]
    for idx in range(rows*cols):
        sr,sc=divmod(idx,cols)
        top_min=gap + sr*slot_h
        left_min=gap + sc*slot_w
        top_max=min(canvas_h-gap-h, (sr+1)*slot_h-h)
        left_max=min(canvas_w-gap-w, (sc+1)*slot_w-w)
        if top_max < top_min or left_max < left_min:
            continue
        slots.append((int(rng.integers(top_min, top_max+1)), int(rng.integers(left_min, left_max+1))))
    if len(slots) < k:
        return None
    chosen=rng.choice(len(slots), size=k, replace=False)
    order=rng.permutation(k)
    for patch_i, slot_i in zip(order, chosen):
        r0,c0=slots[slot_i]
        patch=patches[patch_i]
        grid[r0:r0+h,c0:c0+w]=np.where(patch!=0, patch, grid[r0:r0+h,c0:c0+w])
    return grid

def gen():
    rng=np.random.default_rng()
    for _ in range(MAX_ATTEMPTS):
        k=int(rng.integers(2,4))
        patches=[build_patch(k,rng) for _ in range(k)]
        if len({p.shape for p in patches}) != 1:
            continue
        grid=place(patches,rng)
        if grid is None:
            continue
        if len(components8(grid!=0)) != k:
            continue
        out=main(grid)
        if out.shape != patches[0].shape:
            continue
        return grid
    raise RuntimeError('"'failed')

st=time.time()
s=set()
for i in range(50):
    g=gen(); s.add(hashlib.md5(g.tobytes()+str(g.shape).encode()).hexdigest())
print('variants',len(s),'time',time.time()-st)
