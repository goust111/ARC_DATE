import random
from functools import lru_cache


def gen_paths(k,w,h,tries=200):
    starts=sorted(random.sample(range(w),k))
    targets=[set() for _ in range(k)]
    hitL=[c==0 for c in starts]
    hitR=[c==w-1 for c in starts]

    @lru_cache(None)
    def dfs(row, cols, left_mask, right_mask):
        cols=list(cols)
        if row==h-1:
            full=(1<<k)-1
            return left_mask==full and right_mask==full
        remaining=h-1-row
        unmet=[]
        for i,c in enumerate(cols):
            need=[]
            if not (left_mask>>i)&1:
                need.append(c)
            if not (right_mask>>i)&1:
                need.append(w-1-c)
            if any(d>remaining for d in need):
                return False
        moves=[-1,0,1]
        cand_lists=[]
        for c in cols:
            vals=[nc for d in moves if 0<=(nc:=c+d)<w]
            random.shuffle(vals)
            cand_lists.append(vals)
        order=sorted(range(k), key=lambda i: len(cand_lists[i]))
        next_cols=[None]*k
        used=set()
        def backtrack(idx):
            if idx==k:
                nc=tuple(next_cols)
                lm=left_mask
                rm=right_mask
                for i,x in enumerate(nc):
                    if x==0: lm |= 1<<i
                    if x==w-1: rm |= 1<<i
                if dfs(row+1, nc, lm, rm):
                    path_cache[(row, tuple(cols), left_mask, right_mask)] = nc
                    return True
                return False
            i=order[idx]
            vals=cand_lists[i][:]
            vals.sort(key=lambda x: abs(x-(w-1)/2))
            random.shuffle(vals)
            for x in vals:
                if x in used:
                    continue
                next_cols[i]=x
                used.add(x)
                if backtrack(idx+1):
                    return True
                used.remove(x)
                next_cols[i]=None
            return False
        return backtrack(0)

    path_cache={}
    if not dfs(0, tuple(starts), sum((1<<i) for i,c in enumerate(starts) if c==0), sum((1<<i) for i,c in enumerate(starts) if c==w-1)):
