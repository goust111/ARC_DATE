+    for spec in groups["up"]:
+        c0 = _place_fixed_row(occupied, spec, 1, rng)
+        if c0 is None:
+            return False
+        spec["final_r0"] = 1
+        spec["final_c0"] = c0
+        _occupy(occupied, spec["cells"], spec["final_r0"], spec["final_c0"])
