+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _u_template(height: int, width: int, direction: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if direction in ("up", "down"):
+        mask[:, 0] = True
+        mask[:, -1] = True
+        if direction == "up":
+            mask[-1, :] = True
+        else:
+            mask[0, :] = True
+    else:
+        mask[0, :] = True
+        mask[-1, :] = True
+        if direction == "left":
+            mask[:, -1] = True
+        else:
+            mask[:, 0] = True
+    return mask
+
+
+def _classify_u(mask: np.ndarray) -> str | None:
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return None
+    for direction in ("up", "down", "left", "right"):
+        if np.array_equal(mask, _u_template(h, w, direction)):
+            return direction
+    return None
+
+
+def _edge_name(r: int, c: int, h: int, w: int) -> str:
+    if r == 0:
+        return "top"
+    if r == h - 1:
+        return "bottom"
+    if c == 0:
+        return "left"
+    return "right"
+
+
+def _find_markers(grid: np.ndarray, bg: int) -> tuple[list[dict], str]:
+    h, w = grid.shape
+    markers = []
+    for coords in _components(grid != bg):
+        if coords.shape[0] != 1:
+            continue
+        r, c = map(int, coords[0])
+        if r not in (0, h - 1) and c not in (0, w - 1):
+            continue
+        markers.append(
+            {
+                "r": r,
+                "c": c,
+                "color": int(grid[r, c]),
+                "edge": _edge_name(r, c, h, w),
+            }
+        )
+
+    assert len(markers) == 2, "expected exactly two border marker pixels"
+    edges = {marker["edge"] for marker in markers}
+    if edges == {"top", "bottom"}:
+        axis = "vertical"
+    else:
+        assert edges == {"left", "right"}, "markers must sit on opposite edges"
+        axis = "horizontal"
+    return markers, axis
+
+
+def _find_u_objects(grid: np.ndarray, bg: int, marker_positions: set[tuple[int, int]]) -> list[dict]:
+    mask = grid != bg
+    for r, c in marker_positions:
+        mask[r, c] = False
+
+    objects = []
+    for coords in _components(mask):
+        colors = {int(grid[r, c]) for r, c in coords}
+        if len(colors) != 1:
+            continue
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+        submask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        submask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        direction = _classify_u(submask)
+        if direction is None:
+            continue
+        objects.append(
+            {
+                "color": next(iter(colors)),
+                "direction": direction,
+                "mask": submask,
+                "r0": r0,
+                "c0": c0,
+                "h": int(submask.shape[0]),
+                "w": int(submask.shape[1]),
+                "coords": coords,
+            }
+        )
+    return objects
+
+
+def _target_origin(obj: dict, axis: str, height: int, width: int) -> tuple[int, int]:
+    direction = obj["direction"]
+    r0 = int(obj["r0"])
+    c0 = int(obj["c0"])
+    h = int(obj["h"])
+    w = int(obj["w"])
+    if axis == "vertical":
+        if direction == "up":
+            return 1, c0
+        if direction == "down":
+            return height - h - 1, c0
+        return r0, c0
+    if direction == "left":
+        return r0, 1
+    if direction == "right":
+        return r0, width - w - 1
+    return r0, c0
+
