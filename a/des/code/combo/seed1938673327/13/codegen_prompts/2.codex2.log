+            axis == "horizontal" and spec["direction"] in ("left", "right")
+        )
+        if not movable:
+            spec["input_r0"] = spec["final_r0"]
+            spec["input_c0"] = spec["final_c0"]
+            if not _can_place(occupied, spec["input_r0"], spec["input_c0"], spec["h"], spec["w"]):
