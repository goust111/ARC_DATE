+        return [(0, top_c, marker_colors[0]), (height - 1, bottom_c, marker_colors[1])]
+    left_r, right_r = rng.sample(list(range(1, height - 1)), 2)
+    return [(left_r, 0, marker_colors[0]), (right_r, width - 1, marker_colors[1])]
