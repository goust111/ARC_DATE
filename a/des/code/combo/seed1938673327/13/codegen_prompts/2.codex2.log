+            col_max = width - spec["w"] - 3
+            candidates = _shuffle_copy(list(range(col_min, col_max + 1)), rng)
+            placed = False
+            for c0 in candidates:
+                if c0 == spec["final_c0"]:
+                    continue
+                r0 = spec["final_r0"]
+                if _can_place(occupied, r0, c0, spec["h"], spec["w"]):
+                    spec["input_r0"] = r0
+                    spec["input_c0"] = c0
+                    placed = True
