+    for spec in groups["down"]:
+        r0 = height - spec["h"] - 1
+        c0 = _place_fixed_row(occupied, spec, r0, rng)
+        if c0 is None:
+            return False
+        spec["final_r0"] = r0
+        spec["final_c0"] = c0
