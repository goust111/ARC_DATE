+
+    for frame in _find_frames(g, bg):
+        r0, c0, r1, c1 = frame["r0"], frame["c0"], frame["r1"], frame["c1"]
+        border_color = frame["border_color"]
+        marker_color = frame["marker_color"]
+        inner = out[r0 + 1 : r1 - 1, c0 + 1 : c1 - 1]
+
+        if marker_color == border_color:
+            inner[:] = border_color
