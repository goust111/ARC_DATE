+    non_bg = np.argwhere(interior != bg)
+    if len(non_bg) != 1:
+        return None
+
+    mr, mc = map(int, non_bg[0])
+    marker_color = int(interior[mr, mc])
+    return (r0, c0, r1, c1, border_color, marker_color, (r0 + 1 + mr) * grid.shape[1] + (c0 + 1 + mc))
