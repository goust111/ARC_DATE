+                    border_mask[rr0, cc0:cc1] = True
+                    border_mask[rr1 - 1, cc0:cc1] = True
+                    border_mask[rr0:rr1, cc0] = True
+                    border_mask[rr0:rr1, cc1 - 1] = True
+                    if np.any(occupied & border_mask):
+                        continue
+
+                    found = {
+                        "r0": rr0,
+                        "c0": cc0,
+                        "r1": rr1,
+                        "c1": cc1,
