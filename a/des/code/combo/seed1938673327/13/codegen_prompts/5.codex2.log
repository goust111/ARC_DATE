+        for i, ((height, width), color, left, right) in enumerate(zip(rect_sizes, colors, extra_a, extra_b)):
+            c0 = shared_left - left
+            c1 = shared_left + shared - 1 + right
+            rects.append({"bbox": (row, c0, row + height - 1, c1), "color": int(color)})
