+        grid_h = top_margin + sum(height for height, _width in rect_sizes) + sum(gaps) + bottom_margin
+        grid_w = shared_left + shared + max_right + right_margin
+        if grid_h > MAX_SIDE or grid_w > MAX_SIDE:
