+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return False
+
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.all(sub[border] == color):
+        return False
+    if np.any(sub[~border] == color):
+        return False
+    return True
