+def _direction_delta(direction: str, distance: int) -> tuple[int, int]:
+    if direction == "up":
+        return -distance, 0
+    if direction == "down":
+        return distance, 0
+    if direction == "left":
+        return 0, -distance
+    if direction == "right":
+        return 0, distance
+    raise AssertionError(f"unknown direction: {direction}")
