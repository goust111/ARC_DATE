def _bands(indices: np.ndarray) -> list[tuple[int, int]]:
    assert indices.size > 0, "expected at least one non-separator row/column"
    vals = [int(x) for x in indices]
    bands: list[tuple[int, int]] = []
    start = prev = vals[0]
    for x in vals[1:]:
