+    if c0 <= sc <= c1:
+        if sr < r0:
+            return "up"
+        if sr > r1:
+            return "down"
+    if r0 <= sr <= r1:
+        if sc < c0:
+            return "left"
+        if sc > c1:
+            return "right"
+
+    raise AssertionError("singleton must be cardinally aligned with its rectangle")
+
