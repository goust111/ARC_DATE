+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Move each solid rectangle toward its same-color singleton marker by its own short side length.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "grid must be 2D"
