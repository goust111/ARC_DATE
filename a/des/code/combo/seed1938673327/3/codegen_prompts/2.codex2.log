+            placed_spec = dict(proto)
+            placed_spec["r0"] = r0
+            placed_spec["c0"] = c0
+            placed_spec["marker_r"] = marker_r
+            placed_spec["marker_c"] = marker_c
+            placed.append(placed_spec)
