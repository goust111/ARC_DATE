+    return all(bg_count > count for color, count in count_by_color.items() if color != bg)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
+    w = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
