+def _is_solid_rectangle(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return int(coords.shape[0]) == (r1 - r0 + 1) * (c1 - c0 + 1)
