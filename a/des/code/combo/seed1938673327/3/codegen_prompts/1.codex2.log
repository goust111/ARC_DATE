# Blob motif and growth bounds.
BLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4
BLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2
BLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3
