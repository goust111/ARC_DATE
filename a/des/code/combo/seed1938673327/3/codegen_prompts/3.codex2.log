+        if separator_total < 2:
+            continue
+        for sep1_w in range(1, separator_total):
+            sep2_w = separator_total - sep1_w
+            sep1_c0 = panel_w
+            sep2_c0 = 2 * panel_w + sep1_w
+            sep1 = g[:, sep1_c0 : sep1_c0 + sep1_w]
