+            sep_color = int(sep1[0, 0])
+            if not np.all(sep1 == sep_color):
+                continue
+            if not np.all(sep2 == sep_color):
+                continue
+
+            panel1 = g[:, :panel_w]
+            panel2 = g[:, sep1_c0 + sep1_w : sep2_c0]
+            panel3 = g[:, sep2_c0 + sep2_w :]
+            if any(np.any(panel == sep_color) for panel in (panel1, panel2, panel3)):
