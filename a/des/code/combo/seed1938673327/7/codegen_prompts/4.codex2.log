+    return None
+
+
+def _render_scene(
+    rows: int, cols: int, placements: list[dict[str, object]]
+) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.full((rows, cols), BG, dtype=int)
+    out = inp.copy()
