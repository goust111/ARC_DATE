+def _runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    runs = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+            continue
+        runs.append((start, prev))
+        start = prev = idx
+    runs.append((start, prev))
+    return runs
