+def _spans_around_separator(length: int, separator_indices: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    cursor = 0
+    for start, end in _runs(separator_indices):
+        if cursor < start:
+            spans.append((cursor, start))
+        cursor = end + 1
+    if cursor < length:
+        spans.append((cursor, length))
+    return spans
+
