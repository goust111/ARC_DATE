+            ((0, 0), (0, x)),
+            ((0, x), (0, w - 1)),
+            ((0, w - 1), (y, w - 1)),
+            ((y, w - 1), (h - 1, w - 1)),
+            ((h - 1, w - 1), (h - 1, 0)),
+            ((h - 1, 0), (0, 0)),
+            ((0, x), (y, x)),
+            ((y, x), (y, w - 1)),
+        ]
