+            ((y, w - 1), (h - 1, w - 1)),
+            ((h - 1, w - 1), (h - 1, x)),
+            ((h - 1, x), (h - 1, 0)),
+            ((h - 1, 0), (y, 0)),
+            ((y, 0), (0, 0)),
+            ((0, x), (y, x)),
+            ((y, x), (h - 1, x)),
+            ((y, 0), (y, x)),
+            ((y, x), (y, w - 1)),
