+        color_counts = Counter(int(g[r, c]) for r, c in owner_boundary)
+        groups[owner].append(
+            {
+                "coords": coords,
+                "area": len(coords),
+                "anchor": _anchor(coords),
+                "boundary_scan": owner_boundary,
+                "boundary_color_counts": color_counts,
+            }
