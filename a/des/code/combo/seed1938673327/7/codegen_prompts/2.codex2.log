+            ((h - 1, x2), (h - 1, x1)),
+            ((h - 1, x1), (h - 1, 0)),
+            ((h - 1, 0), (0, 0)),
+            ((0, x1), (h - 1, x1)),
+            ((0, x2), (h - 1, x2)),
+        ]
+    raise RuntimeError("failed to build double template")
+
+
+def _build_cross(rng: random.Random) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    for _ in range(80):
+        h = rng.randint(8, 12)
+        w = rng.randint(8, 14)
+        x = rng.randint(2, w - 3)
