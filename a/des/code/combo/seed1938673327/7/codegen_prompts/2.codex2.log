+def _random_transform(grid: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    out = np.rot90(out, rng.randrange(4))
+    return np.array(out, copy=True)
