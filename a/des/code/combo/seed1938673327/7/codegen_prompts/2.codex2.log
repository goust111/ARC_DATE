+    for patch in sorted(objects, key=lambda arr: arr.shape[0] * arr.shape[1], reverse=True):
+        if not _place_patch(grid, blocked, patch, rng):
+            return None
+
+    if not _valid_global_instance(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
