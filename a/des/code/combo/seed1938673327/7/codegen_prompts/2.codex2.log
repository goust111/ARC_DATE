+    covered: set[tuple[int, int]] = set()
+    for idx in ranked:
+        if not seg_boundary[idx]:
+            continue
+        target_set.add(idx)
+        covered |= seg_boundary[idx]
+        if len(covered) * 2 > len(boundary_pixels):
