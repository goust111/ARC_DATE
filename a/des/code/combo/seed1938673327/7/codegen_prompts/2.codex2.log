+        areas = [
+            (y - 1) * (x - 1),
+            (y - 1) * (w - x - 2),
+            (h - y - 2) * (x - 1),
+            (h - y - 2) * (w - x - 2),
+        ]
+        if min(areas) < 1 or areas.count(min(areas)) != 1:
+            continue
+        return [
+            ((0, 0), (0, x)),
+            ((0, x), (0, w - 1)),
+            ((0, w - 1), (y, w - 1)),
+            ((y, w - 1), (h - 1, w - 1)),
+            ((h - 1, w - 1), (h - 1, x)),
+            ((h - 1, x), (h - 1, 0)),
+            ((h - 1, 0), (y, 0)),
+            ((y, 0), (0, 0)),
+            ((0, x), (y, x)),
+            ((y, x), (h - 1, x)),
+            ((y, 0), (y, x)),
+            ((y, x), (y, w - 1)),
+        ]
+    raise RuntimeError("failed to build cross template")
+
+
+def _build_elbow(rng: random.Random) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    for _ in range(80):
+        h = rng.randint(8, 12)
+        w = rng.randint(8, 14)
+        x = rng.randint(2, w - 3)
+        y = rng.randint(2, h - 3)
