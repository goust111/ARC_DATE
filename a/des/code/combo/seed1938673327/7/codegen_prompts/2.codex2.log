+    raise RuntimeError("failed to build split template")
+
+
+def _build_double(rng: random.Random) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    for _ in range(80):
+        h = rng.randint(6, 11)
+        w = rng.randint(9, 15)
+        x1 = rng.randint(2, w - 5)
+        x2 = rng.randint(x1 + 2, w - 3)
