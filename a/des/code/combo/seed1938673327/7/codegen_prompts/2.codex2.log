+
+
+def _build_elbow(rng: random.Random) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    for _ in range(80):
+        h = rng.randint(8, 12)
+        w = rng.randint(8, 14)
+        x = rng.randint(2, w - 3)
+        y = rng.randint(2, h - 3)
+        small = (y - 1) * (w - x - 2)
+        total = (h - 2) * (w - 2)
+        if small < 1 or small * 2 == total:
+            continue
+        return [
+            ((0, 0), (0, x)),
+            ((0, x), (0, w - 1)),
+            ((0, w - 1), (y, w - 1)),
+            ((y, w - 1), (h - 1, w - 1)),
+            ((h - 1, w - 1), (h - 1, 0)),
+            ((h - 1, 0), (0, 0)),
+            ((0, x), (y, x)),
+            ((y, x), (y, w - 1)),
+        ]
