+            else:
+                canvas[2 + h : 2 + h + arm_len, start : start + arm_w] = True
+        else:
+            arm_h = rng.randint(1, min(3, h))
+            start = 2 + rng.randint(0, h - arm_h)
+            if side == "left":
+                canvas[start : start + arm_h, 2 - arm_len : 2] = True
