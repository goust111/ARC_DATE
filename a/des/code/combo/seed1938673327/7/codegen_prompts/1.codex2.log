+
+    top_buffer = 2 if legend_on_top else 1
+    bottom_buffer = 1 if legend_on_top else 2
+    placements: dict[int, tuple[int, int]] = {}
+    order = sorted(
+        range(len(specs)),
+        key=lambda i: int(specs[i]["priority"]),  # type: ignore[index]
