+            hole_cols = (hole_count + hole_rows - 1) // hole_rows
+            pad_top = rng.randint(0, 2)
+            pad_bottom = rng.randint(0, 2)
+            pad_left = rng.randint(0, 2)
+            pad_right = rng.randint(0, 2)
+            mask = np.ones(
