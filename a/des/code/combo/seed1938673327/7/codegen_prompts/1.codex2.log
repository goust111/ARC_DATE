+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+MAX_GEN_ATTEMPTS = 400
