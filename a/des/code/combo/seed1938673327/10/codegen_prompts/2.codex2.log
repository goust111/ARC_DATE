+        h = int(obj["h"])
+        w = int(obj["w"])
+        grid[r0 : r0 + h, c0 : c0 + w] = int(obj["color"])
+    return grid
+
+
+def _render_output(grid_h: int, grid_w: int, objects: list[dict]) -> np.ndarray:
+    out = np.full((grid_h, grid_w), BG_COLOR, dtype=int)
