+BG_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+OBJECT_COUNT_MIN = 3
+OBJECT_COUNT_MAX = 6
+MIN_GRID_SIDE = 12
+MAX_GRID_SIDE = 26
