+    assert len(candidates) == 1, "background color must be uniquely dominant"
+    return int(candidates[0])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
