+    frame_r0, frame_c0 = obj["frame_local"]
+    abs_r0 = int(cluster_r0 + frame_r0)
+    abs_c0 = int(cluster_c0 + frame_c0)
+    return (
+        abs_r0,
+        abs_c0,
