+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "inner_bbox": (int(r0 + 1), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+        "frame_color": int(frame_color),
+        "marker_color": int(marker_color),
+        "marker_pos": marker_pos,
+    }
