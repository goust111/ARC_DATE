+    elif side == "left":
+        frame_local = (0, sw + gap)
+        sprite_local = (1 + random.randint(0, inner_h - sh), 0)
+        cluster_h, cluster_w = frame_h, sw + gap + frame_w
+    else:
+        frame_local = (0, 0)
+        sprite_local = (1 + random.randint(0, inner_h - sh), frame_w + gap)
