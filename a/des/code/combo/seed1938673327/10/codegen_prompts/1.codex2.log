+
+SIDES = ("top", "bottom", "left", "right")
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid), return_counts=True)
+    return int(vals[np.argmax(counts)])
