+        cells.add(random.choice(frontier))
+
+    norm = _normalize(cells)
+    hh = max(r for r, _ in norm) + 1
+    ww = max(c for _, c in norm) + 1
+    mask = np.zeros((hh, ww), dtype=bool)
+    for r, c in norm:
