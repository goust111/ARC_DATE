+    keep = (
+        (shifted[:, 0] >= ir0)
+        & (shifted[:, 0] <= ir1)
+        & (shifted[:, 1] >= ic0)
+        & (shifted[:, 1] <= ic1)
+    )
+    return shifted[keep]
