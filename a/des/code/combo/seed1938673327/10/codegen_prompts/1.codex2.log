+def _project_cells(coords: np.ndarray, frame: dict, side: str) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    ir0, ic0, ir1, ic1 = frame["inner_bbox"]
+    if side == "top":
+        dr, dc = int(ir1 - r1), 0
+    elif side == "bottom":
+        dr, dc = int(ir0 - r0), 0
+    elif side == "left":
+        dr, dc = 0, int(ic1 - c1)
