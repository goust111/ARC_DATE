+    return random.randint(1, frame_h - 2), frame_w - 1
+
+
+def _build_object(side: str, marker_side: str, marker_color: int, sprite_color: int) -> dict | None:
+    inner_h = random.randint(3, 5)
+    inner_w = random.randint(3, 5)
