+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+from numpy.random import default_rng
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+INPUT_COLORS = (1, 3, 5, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_MIN = 13
+GRID_MAX = 22
+HUB_SIZE_MIN = 4
+HUB_SIZE_MAX = 7
+BAR_LEN_MIN = 2
+BAR_LEN_MAX = 4
+PLACEMENT_ATTEMPTS = 120
+GEN_ATTEMPTS = 400
