+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0, c0 in np.argwhere(mask):
+        r0 = int(r0)
+        c0 = int(c0)
+        if seen[r0, c0]:
+            continue
+        seen[r0, c0] = True
+        comp: list[tuple[int, int]] = []
+        q = deque([(r0, c0)])
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for dr, dc in DIRS4:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _extract_objects(grid: np.ndarray) -> dict[int, frozenset[tuple[int, int]]]:
+    objects: dict[int, frozenset[tuple[int, int]]] = {}
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != BG):
+        comps = _components(grid == color)
+        assert len(comps) == 1, "each color must define exactly one 4-connected object"
+        objects[color] = frozenset(comps[0])
+    return objects
+
+
+def _build_adjacency(
+    grid: np.ndarray,
+) -> tuple[dict[int, frozenset[tuple[int, int]]], dict[int, set[int]]]:
+    g = np.asarray(grid, dtype=int)
+    objects = _extract_objects(g)
+    adj = {color: set() for color in objects}
+    h, w = g.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG:
+                continue
+            if r + 1 < h:
+                other = int(g[r + 1, c])
+                if other not in (BG, color):
+                    adj[color].add(other)
+                    adj[other].add(color)
+            if c + 1 < w:
+                other = int(g[r, c + 1])
+                if other not in (BG, color):
+                    adj[color].add(other)
+                    adj[other].add(color)
+    return objects, adj
