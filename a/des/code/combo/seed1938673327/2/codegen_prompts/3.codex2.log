+        right_obj = _extract_panel_object(panels[2 * idx + 1], BG)
+        pair_out = _render_pair(left_obj, right_obj, panel_h, panel_w, BG)
+        c0 = idx * (panel_w + 1)
+        out[:, c0 : c0 + panel_w] = pair_out
+    return out
