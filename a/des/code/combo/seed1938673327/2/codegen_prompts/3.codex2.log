ORTHOGONAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))
REQUIRED_PANEL_COMPONENTS = 2

# Sprite and distractor size bounds.
MIN_SPRITE_SIZE = 2
MAX_SPRITE_SIZE = 9
