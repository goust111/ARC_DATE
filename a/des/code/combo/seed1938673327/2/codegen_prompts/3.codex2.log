+    out_w = len(pair_panels) * panel_w + max(0, len(pair_panels) - 1)
+    out = np.full((panel_h, out_w), bg, dtype=int)
+    for idx, pair_panel in enumerate(pair_panels):
+        c0 = idx * (panel_w + 1)
+        out[:, c0 : c0 + panel_w] = pair_panel
+    return out
