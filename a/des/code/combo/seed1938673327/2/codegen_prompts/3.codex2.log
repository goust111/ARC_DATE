+    panel_w, slices = _panel_layout(g, bg)
+    objs = [_extract_panel_object(g[:, c0:c1], bg) for c0, c1 in slices]
+
+    pair_panels = [
+        _render_pair(objs[idx], objs[idx + 1], panel_h, panel_w, bg)
+        for idx in range(0, len(objs), 2)
