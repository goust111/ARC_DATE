+                    mask = np.zeros_like(allowed, dtype=bool)
+                    mask[r0 : r1 + 1, c0 : c1 + 1] = allowed[r0 : r1 + 1, c0 : c1 + 1]
+                    count = int(mask.sum())
+                    if 1 <= count <= max_size:
