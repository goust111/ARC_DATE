+
+        if mode == "rows":
+            row_colors = [random.choice(colors) for _ in range(size)]
+            for r in range(size):
+                grid[r, :] = row_colors[r]
+            accent_cols = random.sample(range(size), random.randint(1, min(2, size)))
+            for c in accent_cols:
