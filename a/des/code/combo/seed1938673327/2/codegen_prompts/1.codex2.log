+    panels: list[np.ndarray] = []
+    for r0, r1 in panel_rows:
+        for c0, c1 in col_intervals:
+            panel = g[r0:r1, c0:c1]
+            assert panel.shape == (panel_size, panel_size)
+            panels.append(panel.copy())
