+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 1
+PALETTE = tuple(range(2, 10))
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 400
+_GEN_COUNTER = 0
