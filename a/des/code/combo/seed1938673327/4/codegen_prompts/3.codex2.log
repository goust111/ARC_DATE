+def _sample_cell_pixels(cell_size: int) -> set[tuple[int, int]]:
+    all_pixels = [(r, c) for r in range(cell_size) for c in range(cell_size)]
+    mode = random.choices(
+        ["single", "scatter", "patch", "solid"],
+        weights=[1, 2, 3, 2],
+        k=1,
+    )[0]
