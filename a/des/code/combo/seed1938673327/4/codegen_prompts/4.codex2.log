+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+DIR_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+VEC_TO_DIR = {v: k for k, v in DIR_TO_VEC.items()}
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIRS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.asarray(pts, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _is_rect_frame(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    cropped = mask[r0 : r1 + 1, c0 : c1 + 1]
+    expected = np.zeros_like(cropped, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(cropped, expected))
+
+
+def _find_frames(grid: np.ndarray) -> list[tuple[int, int, int, int, int]]:
+    frames: list[tuple[int, int, int, int, int]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != BG):
+        for comp in _components(grid == color):
+            comp_mask = np.zeros_like(grid, dtype=bool)
+            comp_mask[comp[:, 0], comp[:, 1]] = True
+            if _is_rect_frame(comp_mask):
