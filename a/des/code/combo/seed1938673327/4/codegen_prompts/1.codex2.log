+        occupied.add((0, int(col)))
+
+    streams: deque[tuple[int, int, int, int]] = deque((0, int(col), int(color), 0) for col, color in zip(source_cols, source_colors))
+    platform_count = 0
+    deepest_platform = -1
+
+    while streams:
+        start_row, col, color, depth = streams.popleft()
+        remaining_streams = list(streams)
+
+        can_split = depth < max_depth and platform_count < target_platforms and random.random() < split_prob
+        placed = False
+        if can_split and start_row + 2 < height:
+            for _ in range(30):
+                shelf_row = random.randint(start_row + 2, min(height - 1, start_row + 7))
