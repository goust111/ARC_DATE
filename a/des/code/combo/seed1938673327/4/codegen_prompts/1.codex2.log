+                child_row = shelf_row - 1
+                child_left = left - 1
+                child_right = right + 1
+                reserved_clear.add((int(child_row), int(child_left)))
+                reserved_clear.add((int(child_row), int(child_right)))
+                streams.append((int(child_row), int(child_left), int(marker_color), int(depth + 1)))
+                streams.append((int(child_row), int(child_right), int(marker_color), int(depth + 1)))
