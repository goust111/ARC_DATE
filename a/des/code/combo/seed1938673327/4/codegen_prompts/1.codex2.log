+        for _attempt in range(25):
+            shelf_row = random.randint(2, height - 1)
+            length = random.randint(PLATFORM_LEN_MIN, min(PLATFORM_LEN_MAX, width - 2))
+            left = random.randint(1, width - length - 1)
+            right = left + length - 1
+            marker_side = random.choice(("left", "right"))
+            marker_col = left - 1 if marker_side == "left" else right + 1
+            cells = [(shelf_row, c) for c in range(left, right + 1)] + [(shelf_row, marker_col)]
+            if any(cell in occupied or cell in reserved_clear for cell in cells):
+                continue
+            if any((shelf_row - 1, c) in platform_cells or (shelf_row + 1, c) in platform_cells for c in range(left, right + 1)):
+                continue
+            if int(marker_col) in source_cols and shelf_row == 0:
+                continue
+            marker_color = random.choice(PALETTE)
+            for c in range(left, right + 1):
+                occupied.add((int(shelf_row), int(c)))
+                platform_cells.add((int(shelf_row), int(c)))
+            occupied.add((int(shelf_row), int(marker_col)))
+            platforms.append((int(shelf_row), int(left), int(right), int(marker_color), marker_side))
+            break
