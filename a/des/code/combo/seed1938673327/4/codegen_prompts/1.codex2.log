+
+    if np.array_equal(out, grid):
+        return None
+    if np.count_nonzero(out != grid) < height:
+        return None
+    if platform_count >= 3 and len({color for _r, _l, _rr, color, _side in platforms}) < 2:
+        return None
+
+    structural = grid != BG
+    if not np.array_equal(out[structural], grid[structural]):
+        return None
+    return grid
