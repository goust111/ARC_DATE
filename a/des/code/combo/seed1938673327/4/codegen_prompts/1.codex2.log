+                a_lo = max(1, col - length + 1)
+                a_hi = min(col, width - 2 - length + 1)
+                if a_lo > a_hi:
+                    continue
+                left = random.randint(a_lo, a_hi)
+                right = left + length - 1
+                marker_side = random.choice(("left", "right"))
+                marker_col = left - 1 if marker_side == "left" else right + 1
