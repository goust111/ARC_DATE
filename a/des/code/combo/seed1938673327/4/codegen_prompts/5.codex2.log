+        col += size
+        if i != len(shown_panels) - 1:
+            col += 1
+
+    return grid, target
+
+
+def _gen_attempt() -> np.ndarray | None:
+    size = random.randint(*PANEL_SIZE_RANGE)
+    panel_count = random.randint(*PANEL_COUNT_RANGE)
+
+    palette_size = random.randint(4, min(6, len(USABLE_COLORS)))
