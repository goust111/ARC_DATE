+def _column_spans_for_color(g: np.ndarray, color: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    full_cols = np.all(g == int(color), axis=0)
+    spans: list[tuple[int, int]] = []
+    c = 0
+    width = g.shape[1]
+    while c < width:
