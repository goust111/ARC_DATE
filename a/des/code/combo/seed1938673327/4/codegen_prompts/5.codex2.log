+
+    shown_panels = panels[:-1] + [masked_last]
+    size = shown_panels[0].shape[0]
+    width = len(shown_panels) * size + (len(shown_panels) - 1)
+    grid = np.full((size, width), SEPARATOR_COLOR, dtype=int)
+
+    col = 0
