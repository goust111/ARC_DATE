+        elif mode == 1:
+            nr, nc = r, -c
+        elif mode == 2:
+            nr, nc = -r, c
+        elif mode == 3:
+            nr, nc = -r, -c
+        elif mode == 4:
+            nr, nc = c, r
+        elif mode == 5:
+            nr, nc = c, -r
+        elif mode == 6:
