+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+BG_COLOR = 5
+PALETTE = (0, 1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 250
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
