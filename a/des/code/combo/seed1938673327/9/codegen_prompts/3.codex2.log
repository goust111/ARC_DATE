+    inner_r1 = max_r0 - 1 if max_r0 >= 2 else max_r0
+    inner_c0 = 1 if max_c0 >= 2 else 0
+    inner_c1 = max_c0 - 1 if max_c0 >= 2 else max_c0
+    r0 = rng.randint(inner_r0, inner_r1)
+    c0 = rng.randint(inner_c0, inner_c1)
+    return r0, c0
+
