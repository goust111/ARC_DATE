+    min_width = sum(areas) + MIN_GAP * (n_objects - 1) + 2 * SIDE_MARGIN
+    width = min_width + rng.randint(*EXTRA_WIDTH_RANGE)
+    height = rng.randint(*GRID_HEIGHT_RANGE)
