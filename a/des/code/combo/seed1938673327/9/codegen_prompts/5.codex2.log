+def _band_intervals(lengths: list[int], width: int, rng: random.Random) -> list[int]:
+    base = sum(lengths) + MIN_GAP * (len(lengths) - 1) + 2 * SIDE_MARGIN
+    extra = width - base
+    assert extra >= 0
+    slack = _distribute_extra(extra, len(lengths) + 1, rng)
