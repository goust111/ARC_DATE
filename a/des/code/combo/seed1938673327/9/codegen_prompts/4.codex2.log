+def _sample_target_foreground(n: int, rng: np.random.Generator) -> int:
+    max_k = min(n * (n - 1), int(np.floor(MAX_FILL_RATIO * n * n)))
+    assert max_k >= n
+    mode = int(rng.integers(3))
+    if mode == 0:
+        return n
+    if mode == 1:
+        lo = n + 1
+        hi = max(lo, (n + max_k) // 2)
+        return int(rng.integers(lo, hi + 1))
