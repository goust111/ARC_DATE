+
+# --------------- generator ---------------
+
+PANEL_SIDE_RANGE = (4, 6)
+PANEL_COUNT_OPTIONS = (3, 5, 7)
+COLOR_POOL = tuple(range(10))
+MAX_FILL_RATIO = 0.65
+MAX_GENERATION_ATTEMPTS = 400
+MASK_ATTEMPTS = 80
+PANEL_CORRUPT_ATTEMPTS = 120
