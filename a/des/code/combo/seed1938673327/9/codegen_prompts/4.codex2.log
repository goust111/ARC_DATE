+def _contiguous_bands(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+
+    bands: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+            continue
+        bands.append((start, prev + 1))
+        start = prev = idx
+    bands.append((start, prev + 1))
+    return bands
+
