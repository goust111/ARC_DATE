+from __future__ import annotations
+
+import numpy as np
+
+
+CORNER_TYPES = ("tl", "tr", "bl", "br")
+MISSING_TO_TARGET = {
+    "tl": (1, 1),
+    "tr": (1, -3),
+    "bl": (-3, 1),
+    "br": (-3, -3),
+}
+MISSING_CELLS = {
+    "tl": (0, 0),
+    "tr": (0, 2),
+    "bl": (2, 0),
+    "br": (2, 2),
+}
+
+# --------------- solver ---------------
+
+
+def _mode_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _components_by_color(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    comps: list[dict] = []
+
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        mask = grid == color
+        seen = np.zeros((h, w), dtype=bool)
+        starts = np.argwhere(mask)
+        for sr, sc in starts:
+            sr = int(sr)
+            sc = int(sc)
+            if seen[sr, sc]:
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _component_submask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    coords = comp["coords"]
+    sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return sub
+
+
+def _is_frame_component(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return False
+
+    sub = _component_submask(comp)
+    expected = np.zeros_like(sub, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(sub, expected))
+
+
+def _sprite_missing_corner(comp: dict) -> str | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    if (r1 - r0 + 1) != 3 or (c1 - c0 + 1) != 3:
+        return None
+    if int(comp["area"]) != 8:
+        return None
+
+    sub = _component_submask(comp)
+    missing = np.argwhere(~sub)
+    if missing.shape[0] != 1:
+        return None
+
+    mr, mc = map(int, missing[0])
+    for kind, cell in MISSING_CELLS.items():
+        if (mr, mc) == cell:
+            return kind
+    return None
+
+
+def _target_origin(frame_bbox: tuple[int, int, int, int], kind: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame_bbox
