+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
