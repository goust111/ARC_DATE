+def _extract_parts(grid: np.ndarray) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int], list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    comps = _components4(g != BACKGROUND)
