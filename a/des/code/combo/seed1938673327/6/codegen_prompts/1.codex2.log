+
+def _apply_rules_to_color(color: int, rules: list[tuple[int, int]]) -> tuple[int, int]:
+    current = color
+    changes = 0
+    for src, dst in rules:
+        if current == src:
+            current = dst
+            changes += 1
+    return current, changes
+
