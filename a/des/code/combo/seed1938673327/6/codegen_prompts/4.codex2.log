+    return not (ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0)
+
+
+def _choose_frame_templates(frame_colors: list[int], rng: np.random.Generator) -> dict[int, np.ndarray]:
+    n = len(frame_colors)
