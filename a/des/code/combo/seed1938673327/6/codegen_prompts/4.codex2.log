+        placed = False
+        for _ in range(PLACEMENT_ATTEMPTS):
+            fh = int(rng.integers(FRAME_SIZE_MIN, max_h + 1))
+            fw = int(rng.integers(FRAME_SIZE_MIN, max_w + 1))
