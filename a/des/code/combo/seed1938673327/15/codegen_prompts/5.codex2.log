+        for _ in range(FRAME_PLACEMENT_ATTEMPTS):
+            fh = random.randint(*FRAME_SIDE_RANGE)
+            fw = random.randint(*FRAME_SIDE_RANGE)
+            r0 = random.randint(1, h - fh - 1)
+            c0 = random.randint(1, w - fw - 1)
