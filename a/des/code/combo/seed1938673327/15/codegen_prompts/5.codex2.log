+def _carve_opening(
+    out: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    obj_bbox: tuple[int, int, int, int],
+    direction: str,
+    bg: int,
+) -> None:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    or0, oc0, or1, oc1 = obj_bbox
+    if direction == "up":
+        out[fr0, oc0 : oc1 + 1] = bg
+    elif direction == "down":
+        out[fr1, oc0 : oc1 + 1] = bg
+    elif direction == "left":
+        out[or0 : or1 + 1, fc0] = bg
+    else:
+        out[or0 : or1 + 1, fc1] = bg
