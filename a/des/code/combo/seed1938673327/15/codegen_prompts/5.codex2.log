+    if _dominant_color(inp) != BG_COLOR:
+        return None
+    frames_found = _frame_candidates(inp, BG_COLOR)
+    if len(frames_found) != frame_count:
+        return None
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp, expected
