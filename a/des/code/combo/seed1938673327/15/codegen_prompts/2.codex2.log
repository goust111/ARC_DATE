        dominant_cols = range(3, 6) if side == "top" else range(0, 3)
        dominant_values = [
            int(symbolic[r, c])
            for r in range(symbolic.shape[0])
            for c in dominant_cols
            if int(symbolic[r, c]) != bg
        ]
    else:
        dominant_rows = range(0, 3) if side == "left" else range(3, 6)
        dominant_values = [
