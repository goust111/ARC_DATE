def _coords_in_bounds(coords: np.ndarray, shape: tuple[int, int]) -> bool:
    return (
        int(coords[:, 0].min()) >= 0
        and int(coords[:, 1].min()) >= 0
        and int(coords[:, 0].max()) < shape[0]
        and int(coords[:, 1].max()) < shape[1]
