+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+OUTPUT_BG = 0
+SEPARATOR_COLOR = 5
+PANEL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+PANEL_COUNT_RANGE = (3, 7)
+PANEL_HEIGHT_RANGE = (3, 8)
