+    assert frame["direction"] == "right"
+    rows = slice(r0 + 1, r1)
+    col = bc1 + 1
+    while col < w:
+        if np.any(wall_mask[rows, col]):
+            return cells, "wall"
+        bg_rows = np.where(g[rows, col] == bg)[0]
+        cells.extend((r0 + 1 + int(offset), col) for offset in bg_rows)
+        col += 1
+    return cells, "edge"
