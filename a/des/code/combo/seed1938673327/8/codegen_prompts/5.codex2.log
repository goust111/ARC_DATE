+    return None
+
+
+def _place_blocked_pair(
+    H: int,
+    W: int,
+    direction: str,
+    color_a: int,
+    color_b: int,
+) -> list[dict] | None:
+    for _ in range(80):
+        if direction in ("up", "down"):
+            width = random.randint(5, min(9, W))
+            h_a = random.randint(4, 7)
+            h_b = random.randint(4, 7)
+            gap = random.randint(2, 5)
+            c_bbox = _random_bbox(H, W, 1, width, "left")
