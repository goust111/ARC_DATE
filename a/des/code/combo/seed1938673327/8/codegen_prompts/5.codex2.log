+    if direction == "up":
+        return {(r, c0) for r in rows} | {(r, c1) for r in rows} | {(r1, c) for c in cols}
+    if direction == "down":
+        return {(r, c0) for r in rows} | {(r, c1) for r in rows} | {(r0, c) for c in cols}
+    if direction == "left":
