def _gen_draw_diamond(grid: np.ndarray, radius: int) -> None:
    center = radius
    for rr in range(2 * radius + 1):
        dc = radius - abs(rr - center)
        grid[rr, center - dc] = FRAME_COLOR
        grid[rr, center + dc] = FRAME_COLOR


