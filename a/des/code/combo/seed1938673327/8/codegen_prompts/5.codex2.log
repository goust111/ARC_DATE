+
+
+def _scene_is_valid(grid: np.ndarray, mode: str, expected_count: int) -> bool:
+    g = np.asarray(grid, dtype=int)
+    if np.mean(g == 0) < 0.55:
+        return False
+
+    try:
+        bg, frames, wall_mask = _detect_scene(g)
+    except Exception:
