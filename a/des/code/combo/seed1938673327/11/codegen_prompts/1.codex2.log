+            return [(0, w - 1), (0, w - 2), (0, w - 3)]
+        return [(0, w - 1), (1, w - 1), (2, w - 1)]
+    if corner == "bl":
+        if orient == "h":
+            return [(h - 1, 0), (h - 1, 1), (h - 1, 2)]
+        return [(h - 1, 0), (h - 2, 0), (h - 3, 0)]
+    if orient == "h":
+        return [(h - 1, w - 1), (h - 1, w - 2), (h - 1, w - 3)]
+    return [(h - 1, w - 1), (h - 2, w - 1), (h - 3, w - 1)]
