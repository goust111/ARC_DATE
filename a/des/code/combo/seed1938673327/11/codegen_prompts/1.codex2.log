+        min_w = 3 if category != CATEGORY_LARGE else 4
+        max_h = 6 if category != CATEGORY_LARGE else 7
+        max_w = 7 if category != CATEGORY_LARGE else 8
+
+        candidates = [
+            (h, w)
+            for h in range(min_h, max_h + 1)
+            for w in range(min_w, max_w + 1)
+            if h * w >= missing + 6
+        ]
