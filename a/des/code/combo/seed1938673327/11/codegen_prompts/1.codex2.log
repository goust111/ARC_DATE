+def _pick_legend_cells(h: int, w: int) -> list[tuple[int, int]]:
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    orient = random.choice(("h", "v"))
+    if corner == "tl":
+        if orient == "h":
+            return [(0, 0), (0, 1), (0, 2)]
+        return [(0, 0), (1, 0), (2, 0)]
