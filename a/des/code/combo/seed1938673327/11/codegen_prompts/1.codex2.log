+        return False
+    rr0 = max(0, r0 - PAD)
+    cc0 = max(0, c0 - PAD)
+    rr1 = min(h - 1, r1 + PAD)
+    cc1 = min(w - 1, c1 + PAD)
+    return not occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any()
