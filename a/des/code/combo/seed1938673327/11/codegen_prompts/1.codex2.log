+    region = {random.choice(seeds)}
+    while len(region) < size:
+        frontier = []
+        for r, c in region:
+            for nr, nc in _neighbors4(r, c, h, w):
+                if (nr, nc) not in region:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        region.add(random.choice(frontier))
