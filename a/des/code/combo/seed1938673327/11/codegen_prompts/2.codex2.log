            h,w=m.shape
            sh,sw=h*n,w*n
            area=sh*sw
            if i==0:
                objs.append((n,m,sh,sw,area))
                largest=(sh,sw)
                prev=area
                break
            if sh<=largest[0] and sw<=largest[1] and area<prev and (largest[0]-sh)%2==0 and (largest[1]-sw)%2==0:
                objs.append((n,m,sh,sw,area))
                prev=area
                break
        else:
            ok=False
            break
    print('trial',k,'ok',ok,[(o[0],o[1].shape,o[2],o[3],o[4],o[1].sum()) for o in objs])
