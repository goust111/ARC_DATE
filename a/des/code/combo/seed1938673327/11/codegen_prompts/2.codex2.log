        rw = sum(ws) + sum(gaps)
        row_heights.append(rh)
        row_widths.append(rw)
        h_slacks.append([rh - objs[i]['h'] for i in g])
        x_gaps.append(gaps)
    H = top + sum(row_heights) + row_gap * (len(groups)-1) + bottom
    W = left + max(row_widths) + right
    grid = np.zeros((H, W), dtype=int)
    y = top
    used = []
