+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            components += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+
+            while queue:
+                x, y = queue.popleft()
+                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nx, ny = x + dx, y + dy
+                    if 0 <= nx < h and 0 <= ny < w and mask[nx, ny] and not seen[nx, ny]:
+                        seen[nx, ny] = True
+                        queue.append((nx, ny))
+
+    return components
