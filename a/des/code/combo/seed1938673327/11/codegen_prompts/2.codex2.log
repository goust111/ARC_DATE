+        scaled_h = int(obj["scaled_h"])
+        scaled_w = int(obj["scaled_w"])
+        r0 = (out_h - scaled_h) // 2
+        c0 = (out_w - scaled_w) // 2
+        out[r0 : r0 + scaled_h, c0 : c0 + scaled_w][scaled_mask] = int(obj["color"])
+
+    return out
