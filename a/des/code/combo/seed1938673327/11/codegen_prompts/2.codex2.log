+    left = int(_RNG.integers(1, 4))
+    right = int(_RNG.integers(1, 4))
+    top = int(_RNG.integers(1, 4))
+    bottom = int(_RNG.integers(1, 4))
+    row_gap = int(_RNG.integers(1, 4))
+
+    row_heights: list[int] = []
+    row_widths: list[int] = []
+    row_internal_gaps: list[list[int]] = []
+
+    for group in groups:
