+            if (max_scaled_h - scaled_h) % 2 != 0 or (max_scaled_w - scaled_w) % 2 != 0:
+                valid_chain = False
+                break
+            if idx > 0:
+                prev = objects[idx - 1]
+                if int(prev["scaled_h"]) < scaled_h or int(prev["scaled_w"]) < scaled_w:
+                    valid_chain = False
+                    break
