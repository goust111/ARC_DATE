+                "color": color,
+                "bbox_r0": r0,
+                "bbox_c0": c0,
+                "bbox_h": int(local_mask.shape[0]),
+                "bbox_w": int(local_mask.shape[1]),
+                "bbox_area": int(local_mask.shape[0] * local_mask.shape[1]),
