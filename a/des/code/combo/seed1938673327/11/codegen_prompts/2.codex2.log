+        row_internal_gaps.append(
+            [int(_RNG.integers(1, 4)) for _ in range(max(0, len(group) - 1))]
+        )
+        row_widths.append(
+            sum(int(objects[idx]["bbox_w"]) for idx in group) + sum(row_internal_gaps[-1])
+        )
