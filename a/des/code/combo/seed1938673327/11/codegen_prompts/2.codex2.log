        rr, cc = divmod(int(slot_idx), cols)
        mask = slot_masks[idx]
        h, w = mask.shape
        row_heights[rr] = max(row_heights[rr], h)
        col_widths[cc] = max(col_widths[cc], w)
        placements.append((mask, rr, cc))
    H = sum(row_heights) + GAP * (rows - 1)
    W = sum(col_widths) + GAP * (cols - 1)
    canvas = np.zeros((H, W), dtype=bool)
    row_starts = []
    col_starts = []
    acc = 0
    for h in row_heights:
        row_starts.append(acc)
        acc += h + GAP
    acc = 0
    for w in col_widths:
        col_starts.append(acc)
