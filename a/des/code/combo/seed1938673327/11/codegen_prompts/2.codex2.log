def count_components(mask):
    h,w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    n=0
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            n+=1
            q=deque([(r,c)])
            seen[r,c]=True
            while q:
                x,y=q.popleft()
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True
                        q.append((nx,ny))
    return n

def random_connected(box_h, box_w, area):
    cells=[(int(rng.integers(box_h)), int(rng.integers(box_w)))]
    used={cells[0]}
    frontier=list(cells)
    while len(used)<area:
        x,y=frontier[int(rng.integers(len(frontier)))]
        nbrs=[]
        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<box_h and 0<=ny<box_w and (nx,ny) not in used:
                nbrs.append((nx,ny))
        if not nbrs:
            frontier=[p for p in frontier if any(0<=p[0]+dx<box_h and 0<=p[1]+dy<box_w and (p[0]+dx,p[1]+dy) not in used for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)))]
            if not frontier:
                return None
            continue
        pick=nbrs[int(rng.integers(len(nbrs)))]
        used.add(pick)
        frontier.append(pick)
    m=np.zeros((box_h,box_w),dtype=bool)
    for x,y in used:
        m[x,y]=True
    return m

def random_object(n):
    for _ in range(200):
        comp_boxes=[]
        for _ in range(n):
            bh=int(rng.integers(1,4))
            bw=int(rng.integers(1,4))
            area=int(rng.integers(1,bh*bw+1))
            cm=None
            for _ in range(20):
                cm=random_connected(bh,bw,area)
                if cm is not None:
                    break
            if cm is None:
                break
            comp_boxes.append(cm)
        else:
            H=max(n*3, max(m.shape[0] for m in comp_boxes)+2)
            W=max(n*3, max(m.shape[1] for m in comp_boxes)+2)
            for _ in range(100):
                canvas=np.zeros((H,W),dtype=bool)
                placed=[]
                ok=True
                for cm in comp_boxes:
                    bh,bw=cm.shape
                    locs=[]
                    for r in range(H-bh+1):
                        for c in range(W-bw+1):
                            good=True
                            for pr,pc,ph,pw in placed:
                                if not (r+bh+1<=pr or pr+ph+1<=r or c+bw+1<=pc or pc+pw+1<=c):
                                    good=False
                                    break
                            if good:
                                locs.append((r,c))
                    if not locs:
                        ok=False
                        break
                    r,c=locs[int(rng.integers(len(locs)))]
                    canvas[r:r+bh,c:c+bw] |= cm
                    placed.append((r,c,bh,bw))
                if not ok:
                    continue
                rows,cols=np.where(canvas)
                canvas=canvas[rows.min():rows.max()+1, cols.min():cols.max()+1]
                if count_components(canvas)==n:
                    return canvas
    return None

for k in range(10):
    objs=[]
    largest=None
    prev=10**9
    ok=True
    for i in range(3):
        for _ in range(500):
