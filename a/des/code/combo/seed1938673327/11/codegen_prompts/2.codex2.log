+from __future__ import annotations
+
+import itertools
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+FOREGROUND_COLORS = tuple(range(1, 10))
+OBJECT_COUNT_CHOICES = (2, 3, 4)
+COMPONENT_COUNT_CHOICES = (1, 2, 3, 4)
+CANDIDATES_PER_COUNT = 5
+SLOT_SIZE_MIN = 1
+SLOT_SIZE_MAX = 4
+SLOT_GAP = 1
+MAX_SCALED_DIM = 28
