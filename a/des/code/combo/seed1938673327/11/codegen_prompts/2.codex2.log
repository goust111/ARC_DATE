+
+        valid_chain = True
+        for idx, obj in enumerate(objects):
+            scaled_h = int(obj["scaled_h"])
+            scaled_w = int(obj["scaled_w"])
+            if scaled_h > max_scaled_h or scaled_w > max_scaled_w:
+                valid_chain = False
