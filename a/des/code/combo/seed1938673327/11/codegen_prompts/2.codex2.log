    left = int(RNG.integers(1, 4))
    right = int(RNG.integers(1, 4))
    top = int(RNG.integers(1, 4))
    bottom = int(RNG.integers(1, 4))
    row_gap = int(RNG.integers(1, 4))
    row_heights = []
    row_widths = []
    h_slacks = []
    x_gaps = []
