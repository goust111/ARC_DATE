+    out_colors: list[int] = []
+    for key in ordered_keys:
+        colors = groups[key]
+        counts = Counter(colors)
+        max_count = max(counts.values())
+        winners = [color for color, count in counts.items() if count == max_count]
+        out_colors.append(int(colors[0] if len(winners) > 1 else winners[0]))
