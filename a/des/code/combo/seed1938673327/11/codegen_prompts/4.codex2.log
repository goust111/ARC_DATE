+    _RNG.shuffle(reps)
+    rotations = reps[: min(len(reps), count)]
+    while len(rotations) < count:
+        rotations.append(int(reps[int(_RNG.integers(len(reps)))]))
+    _RNG.shuffle(rotations)
+    return [int(rotation) for rotation in rotations]
