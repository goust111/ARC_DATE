+import numpy as np
+
+
+_RNG = np.random.default_rng()
+
+# Fixed visible roles.
+_BG = 0
+_SEP = 5
+_OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+# Generator bounds.
+_MAX_GRID_SIDE = 30
+_PANEL_SIZE_CHOICES = [5, 6, 7]
+_MAX_GENERATION_ATTEMPTS = 300
+_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
