            r1 = int(coords[:, 0].max())
            c0 = int(coords[:, 1].min())
            c1 = int(coords[:, 1].max())
            crop = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
            crop[coords[:, 0] - r0, coords[:, 1] - c0] = color
            objects.append(
