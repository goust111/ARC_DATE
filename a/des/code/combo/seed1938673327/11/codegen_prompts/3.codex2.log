+def _overlap_with_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ah, aw = a
+    br0, bc0, bh, bw = b
+    ar1 = ar0 + ah - 1
+    ac1 = ac0 + aw - 1
+    br1 = br0 + bh - 1
+    bc1 = bc0 + bw - 1
+    return not (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
