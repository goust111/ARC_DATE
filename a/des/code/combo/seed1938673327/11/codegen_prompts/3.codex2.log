+def _compose_layers(patches: list[np.ndarray]) -> np.ndarray:
+    assert patches
+    canvas_h, canvas_w = patches[-1].shape
+    out = np.zeros((canvas_h, canvas_w), dtype=int)
+    for patch in patches:
