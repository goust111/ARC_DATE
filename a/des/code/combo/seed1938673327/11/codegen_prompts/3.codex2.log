+        r0 = (canvas_h - ph) // 2
+        c0 = (canvas_w - pw) // 2
+        window = out[r0 : r0 + ph, c0 : c0 + pw]
+        mask = patch != 0
+        window[mask] = patch[mask]
+    return out
