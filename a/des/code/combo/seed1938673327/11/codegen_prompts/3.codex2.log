+    assert frames, "expected at least one complete frame"
+
+    patches = [np.asarray(frame["inner"], dtype=int) for frame in frames]
+    return _compose_layers(patches)
+
+
+COLOR_VALUES = tuple(range(1, 10))
+FRAME_COUNT_RANGE = (2, 5)
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+INNER_MIN = 3
+INNER_MAX = 8
+PLACEMENT_MARGIN = 1
+PLACEMENT_GAP = 1
+GEN_RETRIES = 300
+PATTERN_RETRIES = 120
