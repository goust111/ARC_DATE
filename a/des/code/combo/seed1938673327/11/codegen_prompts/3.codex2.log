+    grid_w: int,
+    rng: random.Random,
+) -> list[dict[str, object]] | None:
+    order = sorted(range(len(dims)), key=lambda i: (dims[i][0] + 2) * (dims[i][1] + 2), reverse=True)
+    placed_boxes: list[tuple[int, int, int, int]] = []
+    specs: list[dict[str, object] | None] = [None] * len(dims)
