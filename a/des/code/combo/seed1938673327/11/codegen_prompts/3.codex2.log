+    for color in sorted(int(v) for v in np.unique(g) if int(v) != bg):
+        for coords in components_mask(g == color):
+            if not _is_frame_component(g, coords, color):
+                continue
+            r0, c0, r1, c1 = bbox_coords(coords)
+            frames.append(
