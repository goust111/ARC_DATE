+        grid[r0 : r1 + 1, c0] = frame_color
+        grid[r0 : r1 + 1, c1] = frame_color
+        grid[r0 + 1 : r1, c0 + 1 : c1] = inner
+    return grid
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    frame_count = rng.randint(*FRAME_COUNT_RANGE)
