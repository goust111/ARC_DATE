+
+def _rotated_anchor(bbox: tuple[int, int, int, int], rotated_shape: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    new_h, new_w = rotated_shape
+
+    center_r = r0 + (h - 1) / 2.0
+    center_c = c0 + (w - 1) / 2.0
+    new_r0 = center_r - (new_h - 1) / 2.0
+    new_c0 = center_c - (new_w - 1) / 2.0
