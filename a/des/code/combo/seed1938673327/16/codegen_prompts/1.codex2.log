+def _path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    moves = []
+    moves.extend([(1 if er > r else -1, 0)] * abs(er - r))
+    moves.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
