+    coords = [tuple(map(int, rc)) for rc in legend["coords"]]  # type: ignore[index]
+    if r0 == r1:
+        coords.sort(key=lambda rc: rc[1])
+    else:
+        coords.sort(key=lambda rc: rc[0])
+    colors = [int(grid[r, c]) for r, c in coords]
