+        int(np.ceil(np.sqrt(padded_area))) + 2,
+    )
+    max_side = min(GRID_SIDE_MAX, min_side + GRID_EXTRA_SIDE)
+    if min_side > max_side:
+        return None
+    return min_side, max_side
