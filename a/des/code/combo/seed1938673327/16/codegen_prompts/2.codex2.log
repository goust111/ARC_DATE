+    h, w = occupied.shape
+    r0 = max(0, top - OBJECT_GAP)
+    r1 = min(h, top + height + OBJECT_GAP)
+    c0 = max(0, left - OBJECT_GAP)
+    c1 = min(w, left + width + OBJECT_GAP)
+    occupied[r0:r1, c0:c1] = True
+
