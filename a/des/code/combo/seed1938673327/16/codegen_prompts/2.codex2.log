+        r1 = min(h, r + height + OBJECT_GAP)
+        for c in range(w - width + 1):
+            c0 = max(0, c - OBJECT_GAP)
+            c1 = min(w, c + width + OBJECT_GAP)
+            if not occupied[r0:r1, c0:c1].any():
