+    areas = random.sample(area_pool, count)
+    specs = []
+    for area in areas:
+        height, width = random.choice(FEASIBLE_SPECS[orientation][area])
+        specs.append(
+            {
+                "orientation": orientation,
+                "area": int(area),
+                "height": int(height),
+                "width": int(width),
+                "mask": _make_connected_mask(height, width, int(area)),
