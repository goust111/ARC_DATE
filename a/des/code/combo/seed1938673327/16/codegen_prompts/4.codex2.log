+from __future__ import annotations
+
+import random
+from typing import Dict, List, Tuple
+
+import numpy as np
+
+
+BG_COLOR = 0
+FRAME_COLOR = 5
+PATH_COLOR = 8
+FILL_COLORS = [1, 2, 3, 4, 6, 7, 9]
