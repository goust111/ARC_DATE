+    th, tw, tfill = top_spec
+    bh, bw, bfill = bottom_spec
+    parity = rng.randint(0, 1)
+    for _ in range(80):
+        gap_top, gap_bottom = _sample_gap_pair(rng, parity)
+        top_offset = rng.randint(1, tw - 2)
+        bottom_offset = rng.randint(1, bw - 2)
