+
+
+def _frame_masks(grid: np.ndarray, frames: List[Frame]) -> Tuple[np.ndarray, Dict[Point, int], Dict[int, Frame]]:
+    covered = np.zeros(grid.shape, dtype=bool)
+    border_owner: Dict[Point, int] = {}
+    frame_lookup: Dict[int, Frame] = {}
+    for frame in frames:
