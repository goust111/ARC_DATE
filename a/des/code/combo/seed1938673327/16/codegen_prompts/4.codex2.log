+    next_id = 0
+    for idx, row in enumerate(rows):
+        center_col = rng.randint(7, w - 8)
+        pair = _build_horizontal_pair(next_id, row, center_col, specs[2 * idx], specs[2 * idx + 1], h, w, rng)
