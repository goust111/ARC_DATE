+    for c in range(w):
+        r = 0
+        while r < h:
+            if not path_mask[r, c]:
+                r += 1
+                continue
+            r0 = r
+            while r + 1 < h and path_mask[r + 1, c]:
+                r += 1
+            r1 = r
+            top_owner = border_owner.get((r0 - 1, c)) if r0 > 0 else None
+            bottom_owner = border_owner.get((r1 + 1, c)) if r1 + 1 < h else None
