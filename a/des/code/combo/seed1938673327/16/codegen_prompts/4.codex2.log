+def _extract_paths(grid: np.ndarray, frames: List[Frame]) -> List[PathSpec]:
+    covered, border_owner, _ = _frame_masks(grid, frames)
+    path_mask = (grid != BG_COLOR) & (~covered)
+    h, w = grid.shape
+    paths: List[PathSpec] = []
