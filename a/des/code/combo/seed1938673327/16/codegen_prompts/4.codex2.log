+
+def _components(mask: np.ndarray) -> List[List[Point]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: List[List[Point]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: List[Point] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: List[Point]) -> Tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_from_component(grid: np.ndarray, color: int, comp: List[Point], frame_id: int) -> Frame | None:
+    r0, c0, r1, c1 = _bbox(comp)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+    border: set[Point] = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+    comp_set = set(comp)
+    if comp_set != border:
+        return None
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if inner.size == 0:
+        return None
+    inner_colors = {int(v) for v in inner.ravel()}
+    if len(inner_colors) != 1:
+        return None
+    fill = next(iter(inner_colors))
+    if fill in (BG_COLOR, color):
+        return None
+    return {
+        "id": frame_id,
+        "top": r0,
+        "left": c0,
+        "bottom": r1,
+        "right": c1,
+        "height": h,
+        "width": w,
+        "area": h * w,
+        "border_color": color,
+        "fill_color": fill,
+    }
