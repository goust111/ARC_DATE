+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == BG:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _touching_edges(coords: np.ndarray, h: int, w: int) -> set[str]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    edges: set[str] = set()
+    if np.any(rows == 0):
+        edges.add("top")
+    if np.any(rows == h - 1):
+        edges.add("bottom")
+    if np.any(cols == 0):
+        edges.add("left")
+    if np.any(cols == w - 1):
+        edges.add("right")
+    return edges
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Mark each foreground object according to how many grid edges it touches.
+
+    0 touched edges: put one yellow pixel at the component bbox center.
+    1 touched edge: paint a 1-pixel yellow line on the touched side of the object.
+    2 touched edges: paint the four corners of the component bbox yellow.
+    """
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+
+    for coords in _components(g):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        min_r = int(rows.min())
+        max_r = int(rows.max())
+        min_c = int(cols.min())
+        max_c = int(cols.max())
+        touched = _touching_edges(coords, h, w)
