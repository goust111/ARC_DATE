+            continue
+
+        if touch_count == 1:
+            edge = next(iter(touched))
+            if edge == "top":
+                mask = rows == min_r
+            elif edge == "bottom":
+                mask = rows == max_r
+            elif edge == "left":
+                mask = cols == min_c
+            else:
+                mask = cols == max_c
+            line = coords[mask]
+            out[line[:, 0], line[:, 1]] = YELLOW
+            continue
+
+        for r, c in ((min_r, min_c), (min_r, max_c), (max_r, min_c), (max_r, max_c)):
+            out[r, c] = YELLOW
+
+    return out
+
+
+def _can_place(reserved: np.ndarray, top: int, left: int, height: int, width: int) -> bool:
+    h, w = reserved.shape
+    if top < 0 or left < 0 or top + height > h or left + width > w:
+        return False
+    r0 = max(0, top - 1)
+    r1 = min(h, top + height + 1)
+    c0 = max(0, left - 1)
+    c1 = min(w, left + width + 1)
+    return not bool(reserved[r0:r1, c0:c1].any())
+
+
+def _reserve(reserved: np.ndarray, top: int, left: int, height: int, width: int) -> None:
+    h, w = reserved.shape
+    r0 = max(0, top - 1)
+    r1 = min(h, top + height + 1)
+    c0 = max(0, left - 1)
+    c1 = min(w, left + width + 1)
+    reserved[r0:r1, c0:c1] = True
+
+
+def _randint(rng: random.Random, low: int, high: int) -> int | None:
+    if high < low:
+        return None
+    return rng.randint(low, high)
+
+
+def _place_corner(
+    rng: random.Random,
+    reserved: np.ndarray,
+    corner: str,
+) -> tuple[int, int, int, int] | None:
+    h, w = reserved.shape
+    for _ in range(40):
+        height = rng.randint(2, min(5, h - 2))
+        width = rng.randint(2, min(5, w - 2))
+        if corner == "tl":
+            top, left = 0, 0
+        elif corner == "tr":
+            top, left = 0, w - width
+        elif corner == "bl":
+            top, left = h - height, 0
+        else:
