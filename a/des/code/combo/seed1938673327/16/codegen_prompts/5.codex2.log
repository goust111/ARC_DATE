+def _build_expected_output(
+    panel_rows: int,
+    panel_cols: int,
+    panel_size: int,
+    border_rows: bool,
+    border_cols: bool,
+    separator: int,
+    bg: int,
+    colors: list[int],
+    counts: list[int],
+) -> np.ndarray:
+    panels = [
+        _render_panel(panel_size, bg, color, count)
+        for color, count in zip(colors, counts, strict=True)
+    ]
+    return _assemble_grid(
+        panels,
+        panel_rows,
+        panel_cols,
+        panel_size,
+        border_rows,
+        border_cols,
+        separator,
+    )
+
+
+def _gen_attempt() -> np.ndarray | None:
+    panel_rows = random.randint(2, 4)
