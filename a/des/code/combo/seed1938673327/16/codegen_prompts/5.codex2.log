+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+ARC_GRID_MAX = 30
+GENERATION_ATTEMPTS = 400
+PANEL_ATTEMPTS = 120
+SEPARATOR_COLOR = 5
