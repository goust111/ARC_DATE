+    deduped: list[tuple[int, list[slice], list[slice]]] = []
+    seen = set()
+    for color, row_slices, col_slices in matches:
+        key = (
+            color,
+            tuple((s.start, s.stop) for s in row_slices),
+            tuple((s.start, s.stop) for s in col_slices),
