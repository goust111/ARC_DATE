+
+    placed_rooms: list[dict] = []
+    for spec in room_specs:
+        pos = _sample_bbox(rng, reserved, spec["outer_h"], spec["outer_w"], ROOM_PLACEMENT_ATTEMPTS)
+        if pos is None:
