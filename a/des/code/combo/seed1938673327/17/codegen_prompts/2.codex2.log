+) -> tuple[int, int] | None:
+    h, w = reserved.shape
+    if box_h > h or box_w > w:
+        return None
+    for _ in range(attempts):
+        r0 = rng.randint(0, h - box_h)
+        c0 = rng.randint(0, w - box_w)
