        for dr, dc in DIRS4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h and 0 <= cc < w:
                blocked[rr, cc] = True
    return blocked


def _can_place(mask: np.ndarray, top: int, left: int, occupied: np.ndarray, blocked: np.ndarray) -> bool:
    h, w = occupied.shape
    mh, mw = mask.shape
    for r in range(mh):
        for c in range(mw):
            if not bool(mask[r, c]):
