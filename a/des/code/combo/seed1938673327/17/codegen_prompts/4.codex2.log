+HIGH_LIBRARY = _build_library(HIGH_BASES, "high")
+MEDIUM_LIBRARY = _build_library(MEDIUM_BASES, "medium")
+LOW_LIBRARY = _build_library(LOW_BASES, "low")
+CATEGORY_TO_COLOR = {"high": RED, "medium": GREEN, "low": BLUE}
+CORNERS = ("TL", "TR", "BL", "BR")
