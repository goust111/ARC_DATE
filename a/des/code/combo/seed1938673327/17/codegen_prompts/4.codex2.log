    _mask("#"),
    _mask("##"),
)

MEDIUM_BASES = (
    _mask("###"),
    _mask("##", "#."),
    _mask("##", "##"),
    _mask("####"),
    _mask("###", ".#."),
    _mask("##.", ".##"),
    _mask("###", "#.."),
    _mask("###", "##."),
)

LOW_BASES = (
