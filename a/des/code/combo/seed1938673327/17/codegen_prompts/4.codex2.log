            rr, cc = top + r, left + c
            if not (0 <= rr < h and 0 <= cc < w):
                return False
            if bool(blocked[rr, cc]) or bool(occupied[rr, cc]):
                return False
            for dr, dc in DIRS4:
                nr, nc = rr + dr, cc + dc
                if 0 <= nr < h and 0 <= nc < w and bool(occupied[nr, nc]):
                    return False
    return True


def _place_object(
    grid: np.ndarray,
    expected: np.ndarray,
    occupied: np.ndarray,
    blocked: np.ndarray,
    mask: np.ndarray,
    object_color: int,
    category: str,
) -> bool:
    h, w = grid.shape
    mh, mw = mask.shape

