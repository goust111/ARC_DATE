+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+LEGEND = (RED, GREEN, BLUE)
+OBJECT_COLORS = (4, 5, 6, 7, 8, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
