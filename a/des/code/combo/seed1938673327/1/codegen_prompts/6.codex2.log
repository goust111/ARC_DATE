LEFT_MARKER_COL = 1


def _glyph_cells(color: int, width: int) -> set[tuple[int, int]]:
    left = LEFT_MARKER_COL
    right = width - 2
    assert right - left + 1 == 18

    cells: set[tuple[int, int]] = set()

    if color == 1:
        cells.update((0, c) for c in range(left, right + 1))
        for dr in (-1, 1):
