  "type": "move_along_path",
  "src": "rectangular container with head that has same color as destination line",
  "path": "head forward",
  "dst": "reach the destination line or move_distance == s.inner_gey_pixels.num",
  "type2": "transform_in_place",
  "src2": "inner grey pixels whose num == move_distance",
  "transform": "change color to orange",
  "multi_step": "grey pixels change color in order"
}
</annotation>
</reference_puzzle>

