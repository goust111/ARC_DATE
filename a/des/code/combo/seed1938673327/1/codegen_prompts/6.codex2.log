+        coords = [(c, h - 1 - r) for r, c in coords]
+        h, w = w, h
+    return coords, h, w
+
+
+def _sample_path(parity: int) -> tuple[int, int, list[tuple[int, int]], int]:
+    turn_choices = [t for t in range(6) if t % 2 == parity]
+    for _ in range(MAX_PATH_ATTEMPTS):
