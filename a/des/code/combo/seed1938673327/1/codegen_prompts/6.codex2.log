+def _stitch_path(
+    start_row: int,
+    horizontal_parts: list[int],
+    vertical_parts: list[int],
+    vertical_step: int,
+) -> list[tuple[int, int]]:
+    r, c = int(start_row), 0
+    path = [(r, c)]
+    for i, hlen in enumerate(horizontal_parts):
+        for _ in range(hlen):
+            c += 1
+            path.append((r, c))
+        if i < len(vertical_parts):
