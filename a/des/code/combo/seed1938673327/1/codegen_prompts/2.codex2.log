+def _orbit_cells(kind: str, h: int, w: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    if kind == "horizontal":
+        cells = {(r, c), (h - 1 - r, c)}
+    elif kind == "vertical":
+        cells = {(r, c), (r, w - 1 - c)}
+    elif kind == "rotation":
+        cells = {(r, c), (h - 1 - r, w - 1 - c)}
+    else:
+        cells = {(r, c)}
+    return tuple(sorted(cells))
