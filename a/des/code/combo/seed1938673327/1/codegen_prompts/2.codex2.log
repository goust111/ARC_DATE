+    for kind, (slot_r, slot_c) in GROUP_SLOT.items():
+        items = groups[kind]
+        if not items:
+            continue
+        union = np.zeros((panel_size, panel_size), dtype=bool)
+        chosen = max(items, key=lambda item: int(item["area"]))
+        for item in items:
+            mask = np.asarray(item["mask"], dtype=bool)
+            h, w = mask.shape
+            union[:h, :w] |= mask
