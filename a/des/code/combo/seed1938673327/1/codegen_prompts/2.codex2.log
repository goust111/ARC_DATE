+        return [(r, c) for c in range(w)]
+    if kind == "vertical":
+        c = w // 2 if w % 2 == 1 else w // 2 - 1
+        return [(r, c) for r in range(h)]
+    if kind == "rotation":
+        return [(h // 2, w // 2)]
+    return [(h // 2, w // 2)]
