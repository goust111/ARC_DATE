+    if inferred_color != tile_color or inferred_h != TILE_HEIGHT or inferred_w != tile_w:
+        return None
+    if not np.array_equal(inferred_base, base):
+        return None
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
