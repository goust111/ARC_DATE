+def _cells_connected(cells: tuple[tuple[int, int], ...]) -> bool:
+    remaining = set(cells)
+    start = next(iter(remaining))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nb in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if nb in remaining and nb not in seen:
+                seen.add(nb)
+                stack.append(nb)
