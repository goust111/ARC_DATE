+    min_w = max(legend_w + 10, max(patch.shape[1] for patch in frame_patches) + legend_w + 6, 26 + 4 * (n_frames - 1))
+    height = rng.randint(min_h, min_h + 8)
+    width = rng.randint(min_w, min_w + 8)
