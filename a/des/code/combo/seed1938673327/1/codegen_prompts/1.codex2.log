+    return frames, frame_mask
+
+
+def _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return not (a1 < b0 or b1 < a0)
+
+
+def _find_legend(grid: np.ndarray, bg: int, frame_mask: np.ndarray) -> tuple[dict, np.ndarray]:
+    h, w = grid.shape
+    comps = []
