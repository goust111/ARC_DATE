+def _shape_key(coords: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    rel = sorted((int(r - r0), int(c - c0)) for r, c in coords)
+    height = rel[-1][0] + 1
+    width = max(c for _, c in rel) + 1
+    return height, width, tuple(rel)
