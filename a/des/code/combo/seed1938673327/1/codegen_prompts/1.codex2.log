+    if not np.all((crop == bg) | (crop == color)):
+        return []
+    if not np.all(crop[0, :] == color) or not np.all(crop[-1, :] == color):
+        return []
+    if not np.all(crop[:, 0] == color) or not np.all(crop[:, -1] == color):
+        return []
