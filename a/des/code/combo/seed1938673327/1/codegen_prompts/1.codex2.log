+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 0
+TEMPLATE_COLOR = 5
+SWATCH_SHAPE = (2, 2)
+GEN_RETRIES = 300
+
+# Irregular 4-connected templates. Orientation matters.
+SHAPE_LIBRARY = [
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=bool),
+    np.array([[1, 1], [0, 1], [0, 1]], dtype=bool),
+    np.array([[0, 1, 0], [1, 1, 1]], dtype=bool),
+]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _bbox_area(box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = box
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _touches_edge(box: tuple[int, int, int, int], h: int, w: int) -> bool:
+    r0, c0, r1, c1 = box
+    return r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1
