+    patch = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+    expected = np.zeros((height, width), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
