+            pad_r1 = min(h, r1 + FRAME_GAP + 1)
+            pad_c0 = max(0, c0 - FRAME_GAP)
+            pad_c1 = min(w, c1 + FRAME_GAP + 1)
+            if np.any(blocked[pad_r0:pad_r1, pad_c0:pad_c1]):
+                continue
