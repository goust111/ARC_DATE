+        if int(col[r]) == bg:
+            r += 1
+            continue
+        start = r
+        while r < len(col) and int(col[r]) != bg:
+            r += 1
+        if r - start == 2:
+            key = int(col[start])
+            value = int(col[start + 1])
+            if key in mapping:
+                assert mapping[key] == value, "legend key must map uniquely"
+            mapping[key] = value
