+def _is_rect_frame_component(
+    grid: np.ndarray, color: int, points: list[tuple[int, int]]
+) -> tuple[bool, tuple[int, int, int, int] | None]:
+    r0, c0, r1, c1 = _bbox(points)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return False, None
+    if len(points) != 2 * (height + width) - 4:
+        return False, None
