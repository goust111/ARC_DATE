+        nr, nc = int(ar + rr), int(ac + cc)
+        if 0 <= nr < h and 0 <= nc < w:
+            out[nr, nc] = int(color)
+    return out
+
+
+def _candidate_configs(grid: np.ndarray) -> list[dict]:
+    colors = list(map(int, np.unique(grid)))
+    candidates: list[dict] = []
+
+    for separator in colors:
