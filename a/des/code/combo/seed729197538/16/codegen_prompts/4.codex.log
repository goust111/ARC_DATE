+
+    sep_rows = _separator_indices(heights)
+    sep_cols = _separator_indices(widths)
+    inp[sep_rows, :] = int(separator)
+    inp[:, sep_cols] = int(separator)
+    out[sep_rows, :] = int(separator)
+    out[:, sep_cols] = int(separator)
+
+    row_starts = [0]
+    for h in heights[:-1]:
