+GRID_REGION_ROWS_RANGE = (2, 4)
+GRID_REGION_COLS_RANGE = (2, 4)
+REGION_SIDE_RANGE = (5, 9)
+SEPARATOR_WIDTH = 1
+MAX_SHAPE_AREA = 9
+MIN_SHAPE_AREA = 3
+CLIP_PROBABILITY = 0.45
+MARKER_COUNTS = (1, 2, 3)
+GENERATION_ATTEMPTS = 400
