+
+def _sample_spans(count: int) -> list[int]:
+    return [random.randint(*REGION_SIDE_RANGE) for _ in range(int(count))]
+
+
+def _separator_indices(lengths: list[int]) -> list[int]:
+    idxs = []
+    cursor = 0
+    for length in lengths[:-1]:
