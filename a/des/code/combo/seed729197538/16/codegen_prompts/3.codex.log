+    options = [count for count in ROOM_COUNT_OPTIONS if count <= capacity]
+    weights = [ROOM_COUNT_WEIGHTS[ROOM_COUNT_OPTIONS.index(count)] for count in options]
+    return random.choices(options, weights=weights, k=1)[0]
