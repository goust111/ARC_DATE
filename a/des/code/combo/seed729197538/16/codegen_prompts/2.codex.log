+    for pair in anchor_pairs.values():
+        for r, c in pair:
+            out[r, c] = bg
+
+    for color, touched_ids in hits_by_color.items():
+        for obj_id in touched_ids:
+            coords = np.asarray(objects[obj_id]["coords"], dtype=int)
+            out[coords[:, 0], coords[:, 1]] = color
+
+    return out
