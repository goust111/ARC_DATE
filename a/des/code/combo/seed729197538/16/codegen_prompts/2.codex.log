+def _normalize_coords(coords: set[Coord] | list[Coord] | tuple[Coord, ...]) -> tuple[Coord, ...]:
+    arr = np.asarray(list(coords), dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    arr = arr[order]
+    return tuple((int(r), int(c)) for r, c in arr)
