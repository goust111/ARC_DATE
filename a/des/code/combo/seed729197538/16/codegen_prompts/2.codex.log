+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (14, 20)
+LINE_MARGIN = 2
+LINE_GAP = 4
+OUTER_PADDING = 1
+MAX_PAIRS = 3
+MAX_EXTRA_OBJECTS = 2
+SHAPE_BOX_MAX = 4
+SHAPE_AREA_RANGE = (3, 6)
