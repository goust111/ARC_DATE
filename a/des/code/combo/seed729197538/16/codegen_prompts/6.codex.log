+    area_sum = 0
+
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            area = 0
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                area += 1
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
