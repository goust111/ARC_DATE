+
+
+def _make_object_mask(hole_count: int) -> tuple[np.ndarray, int]:
+    top = random.randint(1, 2)
+    mid_r = random.randint(1, 2)
+    bottom = random.randint(1, 2)
+    left = random.randint(1, 2)
