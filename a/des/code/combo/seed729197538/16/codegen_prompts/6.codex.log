+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIR_BY_HOLES = {
+    1: (0, -1),
+    2: (-1, 0),
+    3: (1, 0),
+    4: (0, 1),
+}
+
+AREA_SHAPES = {
+    1: [(1, 1)],
+    2: [(1, 2), (2, 1)],
+    3: [(1, 3), (3, 1)],
+    4: [(2, 2)],
+}
+
+ALL_COLORS = list(range(10))
+OBJECT_COUNT_OPTIONS = (2, 3, 4)
+INPUT_MARGIN = 2
+SLOT_SIZE = 3
+GEN_ATTEMPTS = 400
+GRID_RANGES_BY_COUNT = {
+    2: ((26, 33), (26, 33)),
+    3: ((30, 37), (30, 37)),
+    4: ((34, 41), (34, 41)),
+}
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _corner_markers(grid: np.ndarray) -> tuple[set[int], np.ndarray]:
+    h, w = grid.shape
+    assert h >= 4 and w >= 4
+
+    blocks = [
+        grid[:2, :2],
+        grid[:2, w - 2 : w],
+        grid[h - 2 : h, :2],
+        grid[h - 2 : h, w - 2 : w],
+    ]
+    colors: list[int] = []
+    marker_mask = np.zeros_like(grid, dtype=bool)
+    marker_mask[:2, :2] = True
+    marker_mask[:2, w - 2 : w] = True
+    marker_mask[h - 2 : h, :2] = True
+    marker_mask[h - 2 : h, w - 2 : w] = True
+    for block in blocks:
+        color = int(block[0, 0])
+        assert np.all(block == color), "corner markers must be solid 2x2 blocks"
+        colors.append(color)
+    assert len(set(colors)) == 4, "corner marker colors must be distinct"
+    return set(colors), marker_mask
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _find_objects(
+    grid: np.ndarray,
+    bg: int,
+    marker_colors: set[int],
+    marker_mask: np.ndarray,
+) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color == bg or marker_mask[r, c] or color in marker_colors:
+                seen[r, c] = True
+                continue
+
+            seen[r, c] = True
+            stack = [(r, c)]
+            coords = [(r, c)]
+            while stack:
+                rr, cc = stack.pop()
+                for nr, nc in _neighbors4(rr, cc):
