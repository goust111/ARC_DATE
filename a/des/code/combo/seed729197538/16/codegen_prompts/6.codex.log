+
+def _hole_summary_in_grid(grid: np.ndarray, coords: np.ndarray, bg: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    mask = np.zeros(sub.shape, dtype=bool)
