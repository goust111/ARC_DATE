+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc]:
+                        continue
+                    if marker_mask[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+                    coords.append((nr, nc))
