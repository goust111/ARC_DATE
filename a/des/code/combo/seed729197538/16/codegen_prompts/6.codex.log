+
+def _find_objects(
+    grid: np.ndarray,
+    bg: int,
+    marker_colors: set[int],
+    marker_mask: np.ndarray,
+) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict[str, object]] = []
