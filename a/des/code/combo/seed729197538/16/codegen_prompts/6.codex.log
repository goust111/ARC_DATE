+def _generate_attempt() -> np.ndarray | None:
+    object_count = random.choice(OBJECT_COUNT_OPTIONS)
+    (grid_h_lo, grid_h_hi), (grid_w_lo, grid_w_hi) = GRID_RANGES_BY_COUNT[object_count]
+    grid_h = random.randint(grid_h_lo, grid_h_hi)
