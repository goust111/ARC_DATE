+def _corner_markers(grid: np.ndarray) -> tuple[set[int], np.ndarray]:
+    h, w = grid.shape
+    assert h >= 4 and w >= 4
+
+    blocks = [
+        grid[:2, :2],
+        grid[:2, w - 2 : w],
+        grid[h - 2 : h, :2],
