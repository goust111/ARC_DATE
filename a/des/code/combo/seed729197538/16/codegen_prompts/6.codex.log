+
+def _hole_summary_from_bool(mask: np.ndarray) -> tuple[int, int]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    area_sum = 0
+
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            area = 0
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                area += 1
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if not touches_border:
+                holes += 1
+                area_sum += area
+
+    return holes, area_sum
+
+
+def _hole_summary_in_grid(grid: np.ndarray, coords: np.ndarray, bg: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    mask = np.zeros(sub.shape, dtype=bool)
+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    bg_mask = sub == bg
+
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    area_sum = 0
+
+    for r in range(h):
+        for c in range(w):
+            if not bg_mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            area = 0
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                area += 1
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg_mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
