+
+def _mark_blocked(blocked: np.ndarray, coords: np.ndarray) -> None:
+    h, w = blocked.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        r0 = max(0, rr - 1)
+        r1 = min(h, rr + 2)
+        c0 = max(0, cc - 1)
+        c1 = min(w, cc + 2)
+        blocked[r0:r1, c0:c1] = True
