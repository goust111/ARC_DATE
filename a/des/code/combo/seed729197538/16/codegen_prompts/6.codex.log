+            seen[r, c] = True
+            stack = [(r, c)]
+            coords = [(r, c)]
+            while stack:
+                rr, cc = stack.pop()
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc]:
+                        continue
+                    if marker_mask[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+                    coords.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            objects.append({"color": color, "coords": arr, "bbox": _bbox_from_coords(arr)})
