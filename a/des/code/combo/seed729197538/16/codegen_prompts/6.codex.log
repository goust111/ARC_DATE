+        for anchor_r, anchor_c in anchors:
+            coords = rel + np.array([anchor_r, anchor_c], dtype=int)
+            moved = coords + np.array([dr * shift, dc * shift], dtype=int)
+            if np.any(blocked_in[coords[:, 0], coords[:, 1]]):
