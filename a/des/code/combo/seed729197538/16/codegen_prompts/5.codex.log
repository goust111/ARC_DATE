+                c0 = 0
+            elif edge == "right":
+                r0 = random.randint(0, height - patch_h)
+                c0 = width - patch_w
+            else:
+                r0 = random.randint(0, height - patch_h)
+                c0 = random.randint(0, width - patch_w)
+            _add_rect(cells, r0, c0, patch_h, patch_w)
+
+    extra_points = random.randint(1, max(2, min(6, height * width // 2)))
+    for _ in range(extra_points):
