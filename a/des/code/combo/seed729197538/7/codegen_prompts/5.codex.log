+            for spec in specs
+        ]
+        grid = _scatter_patches(patches, rng)
+        if grid is None:
+            return None
+        expected = _expected_vertical(specs, width)
+
+    solved = main(grid)
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
