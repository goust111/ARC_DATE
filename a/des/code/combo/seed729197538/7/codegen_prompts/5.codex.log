+def _solve_horizontal(components: list[dict]) -> np.ndarray:
+    pieces = [_extract_horizontal_piece(comp["patch"]) for comp in components]
+    order = _match_chain(pieces, "left", "right")
+    return _assemble_horizontal(pieces, order)
