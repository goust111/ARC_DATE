+        "left": None if left is None else {"color": int(left["color"]), "pattern": tuple(int(v) for v in left["pattern"])},
+        "right": None if right is None else {"color": int(right["color"]), "pattern": tuple(int(v) for v in right["pattern"])},
+    }
