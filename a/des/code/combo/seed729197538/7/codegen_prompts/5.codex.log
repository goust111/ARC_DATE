+        "patch": patch,
+        "body_color": body,
+        "body_mask": body_mask,
+        "core_left": 0,
+        "core_right": w - 1,
+        "core_top": int(core_top),
+        "core_bottom": int(core_bottom),
+        "core_width": int(w),
+        "core_height": int(core_bottom - core_top + 1),
+        "top": None if top is None else {"color": int(top["color"]), "pattern": tuple(int(v) for v in top["pattern"])},
