+
+
+def _interval_within(start: int, end: int, lo: int, hi: int) -> bool:
+    return lo <= start <= end <= hi
+
+
+def _marker_matches(marker: dict, obj: dict) -> bool:
+    if marker["color"] == obj["color"]:
