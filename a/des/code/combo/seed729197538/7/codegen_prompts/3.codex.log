+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+COLOR_POOL = tuple(range(1, 10))
+MISSING_NAMES = ("TL", "TR", "BL", "BR")
+MARKER_SIDES = {
+    "TL": ("above", "left"),
+    "TR": ("above", "right"),
+    "BL": ("below", "left"),
+    "BR": ("below", "right"),
+}
+QUADRANT_OPTIONS = tuple(
+    (qh, qw)
+    for qh in range(2, 6)
+    for qw in range(2, 6)
+)
+WORK_SIZE = 30
+WORK_MARGIN = 1
+PLACEMENT_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 400
+OBJECT_COUNT_OPTIONS = (2, 3, 4)
+
+
+def _component_record(color: int, coords: list[tuple[int, int]]) -> dict:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return {
+        "color": int(color),
+        "coords": coords,
+        "bbox": (min(rows), min(cols), max(rows), max(cols)),
+        "area": len(coords),
+    }
+
+
+def _components_by_color(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    comps: list[dict] = []
+    for color in np.unique(g):
+        color = int(color)
+        if color == BACKGROUND:
+            continue
+        mask = g == color
+        visited = np.zeros((h, w), dtype=bool)
+        for r, c in np.argwhere(mask):
+            r = int(r)
+            c = int(c)
+            if visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(_component_record(color, coords))
+    return comps
+
+
+def _local_quadrant_slices(mask: np.ndarray) -> dict[str, np.ndarray] | None:
+    h, w = mask.shape
+    if h % 2 != 0 or w % 2 != 0:
+        return None
+    qh = h // 2
+    qw = w // 2
+    return {
+        "TL": mask[:qh, :qw],
+        "TR": mask[:qh, qw:],
+        "BL": mask[qh:, :qw],
+        "BR": mask[qh:, qw:],
+    }
+
+
+def _l_spec(comp: dict) -> dict | None:
