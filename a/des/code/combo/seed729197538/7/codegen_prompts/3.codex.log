+    return {
+        "color": comp["color"],
+        "bbox": comp["bbox"],
+        "h": h,
+        "w": w,
+        "qh": qh,
+        "qw": qw,
+        "missing": missing[0],
+    }
+
+
+def _marker_spec(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != w or h not in (1, 2):
