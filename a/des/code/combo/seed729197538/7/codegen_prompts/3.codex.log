+    if missing == "TL":
+        return (
+            mr1 == r0 - 1 and _interval_within(mc0, mc1, c0, c0 + qw - 1)
+        ) or (
+            mc1 == c0 - 1 and _interval_within(mr0, mr1, r0, r0 + qh - 1)
