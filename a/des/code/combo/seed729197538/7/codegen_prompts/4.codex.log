+def _dilate_cells(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr in range(max(0, r - 1), min(h, r + 2)):
+            for nc in range(max(0, c - 1), min(w, c + 2)):
+                out.add((nr, nc))
+    return out
+
