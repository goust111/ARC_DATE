+
+    for obj in objects:
+        for r, c in obj["coords"]:
+            out[r, c] = bg
+
+    for obj in objects:
+        body = int(obj["body"])
+        marker_r, marker_c = obj["marker"]
+        anchor_r, anchor_c = obj["anchor"]
+        dr = anchor_r - marker_r
+        dc = anchor_c - marker_c
+        for r, c in obj["coords"]:
