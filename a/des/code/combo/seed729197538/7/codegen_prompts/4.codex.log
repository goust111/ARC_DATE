+def _translated_visible(
+    cells: list[tuple[int, int]], shift: tuple[int, int], shape: tuple[int, int]
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = shift
+    out = []
+    for r, c in cells:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _render_input(shape: tuple[int, int], placements: list[dict[str, object]]) -> np.ndarray:
+    h, w = shape
