+        anchor_r, anchor_c = obj["anchor"]
+        dr = anchor_r - marker_r
+        dc = anchor_c - marker_c
+        for r, c in obj["coords"]:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
