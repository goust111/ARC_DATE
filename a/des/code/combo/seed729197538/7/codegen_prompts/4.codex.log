+                out.add((nr, nc))
+    return out
+
+
+def _translated_visible(
+    cells: list[tuple[int, int]], shift: tuple[int, int], shape: tuple[int, int]
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = shift
