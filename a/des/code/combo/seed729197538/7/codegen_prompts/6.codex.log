        if inside and outside and n>=2: targets=[inside,outside]
        while len(targets)<n: targets.append(inside if inside and (not outside or random.random()<0.5) else outside if outside else all_allowed)
        for pool in targets:
            pos=try_add(positions,pool,overlap_set,contain_set)
