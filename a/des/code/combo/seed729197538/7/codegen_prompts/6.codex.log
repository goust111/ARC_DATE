    pts = set(map(tuple, coords))
    for r,c in pts:
        if (r + dr, c + dc) in pts:
            return True
    return False


def order_positions(positions, interior):
    n = len(positions)
    above = {i:set() for i in range(n)}
    indeg = {i:0 for i in range(n)}
    for i in range(n):
        for j in range(i + 1, n):
            dr = positions[j][0] - positions[i][0]
            dc = positions[j][1] - positions[i][1]
            i_contains_j = contains_offset(interior, dr, dc)
            j_contains_i = contains_offset(interior, -dr, -dc)
            if i_contains_j and not j_contains_i:
                if j not in above[i]:
                    above[i].add(j); indeg[j] += 1
            elif j_contains_i and not i_contains_j:
                if i not in above[j]:
                    above[j].add(i); indeg[i] += 1
    order = []
    remain = set(range(n))
    while remain:
        ready = sorted([i for i in remain if indeg[i] == 0], key=lambda i: (positions[i][1], positions[i][0]))
        if not ready:
            return sorted(range(n), key=lambda i: (positions[i][1], positions[i][0]))
        cur = ready[0]
        remain.remove(cur)
        order.append(cur)
        for nxt in above[cur]:
            indeg[nxt] -= 1
    return order


def solve(grid):
    g = np.array(grid, dtype=int)
    tc, _anchor, small_fill, small_outline, small_interior = recover_small_masks(g)
    seeds = [(int(r), int(c), int(g[r,c])) for r,c in np.argwhere((g != 0) & (g != tc))]
    order = order_positions([(r,c) for r,c,_ in seeds], small_interior)
    out = g.copy()
    out[g == tc] = 0
    sh,sw = small_outline.shape
    cr,cc = sh // 2, sw // 2
    pts = np.argwhere(small_outline)
    for idx in order:
        r0,c0,col = seeds[idx]
        for rr,cc2 in pts:
            ar = r0 + int(rr) - cr
            ac = c0 + int(cc2) - cc
            if 0 <= ar < out.shape[0] and 0 <= ac < out.shape[1]:
                out[ar,ac] = col
    return out


def shape_rectangle():
    h = random.choice([5,7,9])
    w = random.choice([5,7,9])
    return np.ones((h,w), dtype=bool)


def shape_diamond():
    rad = random.choice([2,3,4])
    size = 2 * rad + 1
    c = rad
    yy,xx = np.indices((size,size))
    return np.abs(yy - c) + np.abs(xx - c) <= rad


def shape_plus():
    size = random.choice([7,9])
    c = size // 2
    fill = np.zeros((size,size), dtype=bool)
    fill[:, c-1:c+2] = True
    fill[c-1:c+2, :] = True
    return fill


def shape_corner_notch():
    h = random.choice([7,9])
    w = random.choice([7,9])
    fill = np.ones((h,w), dtype=bool)
    nh = random.choice([2,3])
    nw = random.choice([2,3])
    fill[:nh, w-nw:] = False
    k = random.randrange(8)
    if k & 1:
        fill = np.fliplr(fill)
    if k & 2:
        fill = np.flipud(fill)
    if k & 4:
        fill = np.rot90(fill)
    return np.ascontiguousarray(fill)


def shape_side_bite():
    h = random.choice([7,9])
    w = random.choice([9,11])
    fill = np.ones((h,w), dtype=bool)
    bite_h = 3 if h >= 7 else 2
    top = h // 2 - bite_h // 2
    left = w // 2 + 1
    fill[top:top+bite_h, left:] = False
    k = random.randrange(8)
    if k & 1:
        fill = np.fliplr(fill)
    if k & 2:
        fill = np.flipud(fill)
    if k & 4:
        fill = np.rot90(fill)
    return np.ascontiguousarray(fill)


def make_small_fill(scenario):
    if scenario == '"'containment':
        fn = random.choice([shape_corner_notch, shape_side_bite])
    else:
        fn = random.choice([shape_rectangle, shape_diamond, shape_plus, shape_corner_notch, shape_side_bite])
    return fn()


def compute_offset_sets(outline, interior):
    h,w = outline.shape
    overlap = set()
    contain = set()
    asym_overlap = []
