    return outline | ~outside


def downscale_to_third(mask):
    h,w = mask.shape
    h2,w2 = h // 3, w // 3
    rs = np.linspace(0, h, h2 + 1, dtype=int)
    cs = np.linspace(0, w, w2 + 1, dtype=int)
    out = np.zeros((h2,w2), dtype=bool)
    for i in range(h2):
        for j in range(w2):
            out[i,j] = mask[rs[i]:rs[i+1], cs[j]:cs[j+1]].any()
    return out


def template_color(grid):
    vals, counts = np.unique(grid[grid "'!= 0], return_counts=True)
    return int(vals[np.argmax(counts)])


def recover_small_masks(grid):
    tc = template_color(grid)
    mask = grid == tc
    r0,c0,r1,c1 = bbox(mask)
    outline = mask[r0:r1+1, c0:c1+1]
    large_fill = fill_from_outline(outline)
    small_fill = downscale_to_third(large_fill)
    small_outline = boundary(small_fill)
    small_interior = small_fill & ~small_outline
    return tc, (r0,c0), small_fill, small_outline, small_interior


def contains_offset(interior, dr, dc):
    h,w = interior.shape
    cr,cc = h//2, w//2
    rr,cc2 = cr + dr, cc + dc
    return 0 <= rr < h and 0 <= cc2 < w and bool(interior[rr,cc2])


def shift_overlap(outline, dr, dc):
