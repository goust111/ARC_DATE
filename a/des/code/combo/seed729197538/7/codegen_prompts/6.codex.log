+def _contains_center(interior: np.ndarray, dr: int, dc: int) -> bool:
+    h, w = interior.shape
+    center_r = h // 2
+    center_c = w // 2
+    rr = center_r + dr
+    cc = center_c + dc
+    return 0 <= rr < h and 0 <= cc < w and bool(interior[rr, cc])
