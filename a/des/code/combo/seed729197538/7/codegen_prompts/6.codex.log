    if scenario=='containment' and not (ov>=1 and edges and not has_cycle(len(positions), edges)): return None
    return positions

def generate_once():
    scenario=random.choices(['separate','overlap','containment'], weights=[1,1,2])[0]
    small_fill=make_small_fill(scenario); small_outline=boundary(small_fill); small_interior=small_fill & ~small_outline
    if small_interior.sum()==0: return None,scenario
    overlap_set,contain_set,asym,plain=compute_offset_sets(small_outline,small_interior)
    if scenario=='overlap' and not plain: return None,scenario
    if scenario=='containment' and not asym: return None,scenario
    large_fill=np.kron(small_fill, np.ones((3,3),dtype=bool)); large_outline=boundary(large_fill); sh,sw=small_outline.shape; ch,cw=sh//2,sw//2
    top=random.randint(ch+1,ch+5); bottom=random.randint(ch+1,ch+5); left=random.randint(cw+1,cw+5); right=random.randint(cw+1,cw+5)
    H=top+large_outline.shape[0]+bottom; W=left+large_outline.shape[1]+right
