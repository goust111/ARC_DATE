+        if color in (BG, MARKER):
+            continue
+        for comp in _components(grid == color):
+            objects.append(_object_descriptor(color, comp))
+    objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1], obj["color"]))  # type: ignore[index]
+    return objects
