+            grid,
+            int(spec["color"]),
+            spec["direction"],  # type: ignore[arg-type]
+            bool(spec["must_clip"]),
+            scene_cells,
+            output_reserved,
+        )
+        if not ok:
+            return None
+
+    if _validate_scene(grid):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
