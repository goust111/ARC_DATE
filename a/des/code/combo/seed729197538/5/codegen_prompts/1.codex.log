+    c0 = max(0, left - pad)
+    c1 = min(w, left + width + pad)
+    blocked[r0:r1, c0:c1] = True
+
+
+def _place_patch(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    patch: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[int, int] | None:
