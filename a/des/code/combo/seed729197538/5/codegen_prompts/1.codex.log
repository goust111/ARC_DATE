                    r1 = min(inner_h, r + size + 1)
                    c0 = max(0, c - 1)
                    c1 = min(inner_w, c + size + 1)
                    if holes[r0:r1, c0:c1].any():
                        continue
                    candidates.append((r, c, size))
            if not candidates:
                ok = False
                break
            r, c, size = candidates[int(rng.integers(len(candidates)))]
            holes[r : r + size, c : c + size] = True
        if ok:
            return holes.copy()
    return None


def _build_object(
