+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dirs = _neighbors4(0, 0) if connectivity == 4 else _neighbors8(0, 0)
