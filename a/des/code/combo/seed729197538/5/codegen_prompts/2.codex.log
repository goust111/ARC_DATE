+        elif c2 - delta2 >= 0:
+            c3 = c2 - delta2
+        else:
+            c3 = c2 + delta2
+        r3 = r2 + rng.randint(4, 6)
+        vertices = [(0, 0), (0, c1), (r1, c1), (r1, c2), (r2, c2), (r2, c3), (r3, c3)]
+    return _transform_vertices(vertices, rng)
