+
+def _translate(points: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
+    return {(r + dr, c + dc) for r, c in points}
+
+
+def _place_shape(
+    rng: random.Random,
+    grid_shape: tuple[int, int],
+    legend_side: str,
+    shape: dict,
+    blocked: np.ndarray,
+    occupied_output: np.ndarray,
