+def _rotation_orbits(size: int, quarter_turn: bool) -> list[tuple[tuple[int, int], ...]]:
+    cache = _ORBIT_CACHE_90 if quarter_turn else _ORBIT_CACHE_180
+    if size in cache:
+        return cache[size]
