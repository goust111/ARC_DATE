+    patch = g[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((size, size), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.all(patch[border] == GREY) and np.all(patch[~border] != GREY))
+
