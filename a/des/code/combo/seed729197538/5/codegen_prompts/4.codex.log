+SYMMETRY_ORDERS = (1, 2, 4)
+
+WINDOW_COUNT_RANGE = (3, 5)
+OUTER_SIZE_RANGE = (5, 7)
+GAP_RANGE = (1, 3)
+SIDE_MARGIN_RANGE = (0, 3)
+TOP_MARGIN_RANGE = (0, 3)
+ARROW_GAP_RANGE = (2, 4)
+BOTTOM_MARGIN_RANGE = (0, 2)
