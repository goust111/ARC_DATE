+
+def _is_square_frame(g: np.ndarray, coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    size = r1 - r0 + 1
+    if size != c1 - c0 + 1 or size < 3:
+        return False
+    if coords.shape[0] != 4 * size - 4:
+        return False
