+    width = room_cols * (inner_w + 1) + 1
+    row_lines = list(range(0, height, inner_h + 1))
+    col_lines = list(range(0, width, inner_w + 1))
+
+    grid = np.full((height, width), BG, dtype=int)
+    grid[row_lines, :] = WALL
+    grid[:, col_lines] = WALL
