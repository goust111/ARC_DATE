+    elif coin < 0.75:
+        gap_count = 1
+    else:
+        gap_count = random.randint(2, max_gaps) if max_gaps >= 2 else 1
+    gap_count = min(gap_count, max_gaps)
+
+    mask = np.zeros(length, dtype=bool)
+    if gap_count > 0:
+        idx = random.sample(range(length), gap_count)
+        mask[idx] = True
+    return mask
+
