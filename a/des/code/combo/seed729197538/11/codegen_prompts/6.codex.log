+        sample_h = max(r for r, _ in sample) + 1
+        sample_w = max(c for _, c in sample) + 1
+        top_pad = random.randint(0, row_height - sample_h)
+        left_pad = random.randint(0, 1)
+        gap = random.randint(1, 2)
+        block_col = left_pad + sample_w + gap
+        row_w = block_col + 2 + 1
