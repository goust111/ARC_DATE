+def _build_polyline(
+    start_dir_idx: int,
+    turns: list[str],
+    lengths: list[int],
+) -> list[tuple[int, int]] | None:
+    dirs = [start_dir_idx]
+    for turn in turns:
+        step = 1 if turn == "L" else -1
+        dirs.append((dirs[-1] + step) % 8)
+    assert len(dirs) == len(lengths)
