+    points = [(0, 0)]
+    occupied = {(0, 0)}
+    for dir_idx, seg_len in zip(dirs, lengths, strict=False):
+        dr, dc = DIRS8[dir_idx]
+        for _ in range(seg_len):
+            nr = points[-1][0] + dr
+            nc = points[-1][1] + dc
+            if (nr, nc) in occupied:
+                return None
+            for pr, pc in occupied:
+                if (pr, pc) == points[-1]:
+                    continue
+                if max(abs(nr - pr), abs(nc - pc)) <= 1:
+                    return None
+            points.append((nr, nc))
+            occupied.add((nr, nc))
+    return points
