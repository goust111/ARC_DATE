+
+
+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 400
+PAIR_COUNTS = (2, 3)
+PIECE_SIDE_MIN = 8
+PIECE_SIDE_MAX = 10
+PLACEMENT_ATTEMPTS = 180
+PIECE_BUILD_ATTEMPTS = 120
+COLOR_POOL = [c for c in range(10) if c != BG_COLOR]
+STATE_POOL = [-1, 0, 1]
+STATE_WEIGHTS = [3, 4, 3]
