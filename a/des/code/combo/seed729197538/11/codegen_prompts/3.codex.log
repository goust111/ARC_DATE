+            sig_a = _shape_code(mask_a)
+            sig_b = _shape_code(mask_b)
+            hole_a = _single_hole(mask_a)
+            hole_b = _single_hole(mask_b)
+        except AssertionError:
+            continue
+
+        if _partner_code(sig_a) != sig_b:
