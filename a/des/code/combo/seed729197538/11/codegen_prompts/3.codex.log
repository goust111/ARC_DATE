+
+
+def _random_hole_box(h: int, w: int) -> tuple[int, int, int, int]:
+    hole_h = random.randint(1, 2)
+    hole_w = random.randint(1, 2)
+    r0 = random.randint(3, h - hole_h - 3)
+    c0 = random.randint(3, w - hole_w - 3)
