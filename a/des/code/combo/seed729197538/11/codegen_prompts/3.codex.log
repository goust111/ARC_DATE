+        _profile_states(bottom),
+        _profile_states(left),
+    )
+
+
+def _extract_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    objects: list[dict] = []
+    for coords in _components_mask(grid != bg):
+        colors = {int(grid[r, c]) for r, c in coords}
