+        states.append(val - 1)
+    return tuple(states)
+
+
+def _shape_code(shape_mask: np.ndarray) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
+    h, w = shape_mask.shape
+    top = np.empty(w, dtype=int)
