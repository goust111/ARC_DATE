+        objects.append(
+            {
+                "color": color,
+                "bbox": bbox,
+                "code": _shape_code(shape_mask),
+                "hole": hole_global,
+            }
+        )
+    assert len(objects) % 2 == 0 and objects, "expected an even number of shapes"
+    return objects
