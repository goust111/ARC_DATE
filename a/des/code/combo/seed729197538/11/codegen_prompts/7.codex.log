+def _gen_attempt() -> np.ndarray | None:
+    mode = random.choice(["open_only", "reinforce_no_conflict", "conflict"])
+    orientation = random.choice(["H", "V"])
+    layout = _sample_layout()
+    placements: list[tuple[tuple[int, int], tuple[int, int]]] = []
