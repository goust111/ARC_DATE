+        if r1 == r2:
+            for pixel in _crossed_fence_pixels(g, (r1, c1), (r2, c2), fence):
+                reinforce_row.add(pixel)
+        elif c1 == c2:
+            for pixel in _crossed_fence_pixels(g, (r1, c1), (r2, c2), fence):
