+def _build_spans(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int], int]:
+    spans: list[tuple[int, int]] = []
+    fences: list[int] = []
+    cursor = 0
+    for i, size in enumerate(sizes):
+        start = cursor
+        end = start + size - 1
+        spans.append((start, end))
+        cursor = end + 1
+        if i < len(sizes) - 1:
+            fences.append(cursor)
+            cursor += 1
+    return spans, fences, cursor
