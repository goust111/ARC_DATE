+
+    if orientation == "H":
+        if len(safe_cols) < 3:
+            return None
+        middle_cols = [idx for idx, cols in enumerate(safe_cols) if len(cols) >= 2 and 0 < idx < len(safe_cols) - 1]
+        random.shuffle(middle_cols)
