+        mr, mc = map(int, marker_cells[0])
+        h, w = map(int, sub.shape)
+        corner_offsets = {
+            (0, 0): "tl",
+            (0, w - 1): "tr",
+            (h - 1, 0): "bl",
+            (h - 1, w - 1): "br",
+        }
+        assert (mr, mc) in corner_offsets, "slot marker must sit on a slot corner"
+        marker_color = int(sub[mr, mc])
