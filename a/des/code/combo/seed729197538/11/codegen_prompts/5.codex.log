+def _manhattan_path(a: tuple[int, int], b: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    path = {(r, c)}
+    if random.random() < 0.5:
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.add((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.add((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.add((r, c))
