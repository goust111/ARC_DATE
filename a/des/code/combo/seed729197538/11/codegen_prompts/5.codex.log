+    for comp in comps:
+        r0, c0, r1, c1 = _bbox_from_coords(comp)
+        sub = interior[r0 : r1 + 1, c0 : c1 + 1]
+        if len(comp) != sub.size:
+            continue
+        marker_cells = [(r, c) for r, c in np.argwhere(np.isin(sub, list(ROT_MARKER_TO_STEPS)))]
+        if len(marker_cells) != 1:
+            continue
