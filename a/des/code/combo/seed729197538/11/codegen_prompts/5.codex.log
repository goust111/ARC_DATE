+import numpy as np
+
+
+AZURE = 8
+GREY = 5
+
+ROT_MARKER_TO_STEPS = {
+    2: 0,  # red
+    3: 1,  # green: 90 clockwise
+    4: 2,  # yellow: 180
+    6: 3,  # magenta: 270 clockwise
+}
+STEPS_TO_ROT_MARKER = {v: k for k, v in ROT_MARKER_TO_STEPS.items()}
+
+PIECE_COLORS = [0, 1, 7, 9]
+
+GEN_ATTEMPTS = 300
+SLOT_COUNT_RANGE = (2, 4)
+PIECE_DIM_RANGE = (2, 6)
+BLUEPRINT_INNER_RANGE = (11, 18)
+CANVAS_H_RANGE = (16, 26)
+RIGHT_GAP_RANGE = (2, 4)
