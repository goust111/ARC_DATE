+
+AZURE = 8
+GREY = 5
+
+ROT_MARKER_TO_STEPS = {
+    2: 0,  # red
+    3: 1,  # green: 90 clockwise
+    4: 2,  # yellow: 180
+    6: 3,  # magenta: 270 clockwise
