+
+GEN_ATTEMPTS = 300
+SLOT_COUNT_RANGE = (2, 4)
+PIECE_DIM_RANGE = (2, 6)
+BLUEPRINT_INNER_RANGE = (11, 18)
+CANVAS_H_RANGE = (16, 26)
+RIGHT_GAP_RANGE = (2, 4)
+RIGHT_MARGIN_RANGE = (1, 3)
+TOP_MARGIN_RANGE = (0, 3)
