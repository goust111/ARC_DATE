+
+    assert slots, "expected at least one rectangular slot"
+    slots.sort(key=lambda s: (s["top"], s["left"]))
+    return slots
+
+
+def _extract_pieces(grid: np.ndarray, blueprint_bbox: tuple[int, int, int, int]) -> list[dict]:
+    r0, c0, r1, c1 = blueprint_bbox
