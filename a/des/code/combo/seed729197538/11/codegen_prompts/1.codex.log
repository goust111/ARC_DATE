+    h, w = legend.shape
+    used = np.zeros_like(legend, dtype=bool)
+    blocks: list[tuple[int, int, int]] = []
+
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if used[r : r + 2, c : c + 2].any():
+                continue
+            color = int(legend[r, c])
+            if color == AZURE:
