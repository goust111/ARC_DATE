+import numpy as np
+
+
+AZURE = 8
+GREY = 5
+MAROON = 9
+FAMILY_COLOR_POOL = (0, 1, 2, 3, 4, 6, 7)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
