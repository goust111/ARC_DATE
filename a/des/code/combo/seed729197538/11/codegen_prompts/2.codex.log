+
+
+def _family_layouts(length: int, seed_count: int) -> dict[tuple[int, int, int], list[tuple[int, ...]]]:
+    key = (length, seed_count)
+    if key in _LAYOUT_CACHE:
+        return _LAYOUT_CACHE[key]
+
+    mid = (length - 1) // 2
+    families: dict[tuple[int, int, int], list[tuple[int, ...]]] = {}
+
