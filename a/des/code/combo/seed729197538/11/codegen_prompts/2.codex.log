+    left_dist = seed_offset
+    right_dist = length - 1 - seed_offset
+    direction = 1 if left_dist <= right_dist else -1
+
+    offsets: list[int] = []
+    for step in range(1, seed_count + 1):
+        nxt = seed_offset + direction * step
+        if 0 <= nxt < length:
+            offsets.append(nxt)
+        else:
+            break
+    return offsets
