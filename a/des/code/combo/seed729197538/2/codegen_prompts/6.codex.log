+    assert goal_state is not None, "failed to reconstruct the missing arc"
+
+    path: list[tuple[int, int]] = []
+    cur = goal_state
+    while True:
+        path.append((cur[0], cur[1]))
+        if cur not in parent:
+            break
+        cur = parent[cur]
+    path.reverse()
