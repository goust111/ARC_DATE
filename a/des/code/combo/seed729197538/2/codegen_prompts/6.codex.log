+    assert path[0] == start and path[-1] == goal
+    prev = e1
+    seen: set[tuple[int, int]] = set()
+    for cell in path:
+        assert abs(cell[0] - prev[0]) + abs(cell[1] - prev[1]) == 1
+        assert cell not in seen and walkable[cell]
+        seen.add(cell)
+        prev = cell
+    assert abs(e2[0] - prev[0]) + abs(e2[1] - prev[1]) == 1
+    return path
