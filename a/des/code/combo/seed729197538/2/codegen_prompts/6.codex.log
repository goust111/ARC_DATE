+import heapq
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RING = 5
+SEP = 9
+USABLE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MAX_GRID_SIDE = 30
+MIN_PANEL_SIDE = 8
+MAX_PANEL_SIDE = 12
+GEN_ATTEMPTS = 400
+PICK_ATTEMPTS = 200
