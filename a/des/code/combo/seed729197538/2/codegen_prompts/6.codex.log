+def _bands(indices: np.ndarray) -> list[tuple[int, int]]:
+    if indices.size == 0:
+        return []
+    bands: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for value in indices[1:]:
+        value = int(value)
+        if value != prev + 1:
+            bands.append((start, prev))
+            start = value
+        prev = value
+    bands.append((start, prev))
+    return bands
