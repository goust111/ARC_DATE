+        steps, turns, stray, r, c, prev_dir = heapq.heappop(pq)
+        state = (r, c, prev_dir)
+        if best.get(state) != (steps, turns, stray):
+            continue
+        if (r, c) == goal:
+            goal_state = state
+            break
+
+        dir_order = sorted(
+            range(len(DIR4)),
+            key=lambda idx: abs(r + DIR4[idx][0] - goal[0]) + abs(c + DIR4[idx][1] - goal[1]),
+        )
+        for dir_idx in dir_order:
+            dr, dc = DIR4[dir_idx]
+            nr, nc = r + dr, c + dc
