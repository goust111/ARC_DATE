+def _make_panel(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    full_ring, bbox = _rectangle_ring(h, w)
+    missing = _gap_cells(bbox)
+    open_ring = full_ring.copy()
+    for r, c in missing:
