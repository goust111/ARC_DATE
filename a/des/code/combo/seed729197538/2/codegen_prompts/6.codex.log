+        c = int(c)
+        neighbors = [(rr, cc) for rr, cc in _neighbors4(r, c, h, w) if mask[rr, cc]]
+        if len(neighbors) == 1:
+            rr, cc = neighbors[0]
+            endpoints.append(((r, c), (r - rr, c - cc)))
