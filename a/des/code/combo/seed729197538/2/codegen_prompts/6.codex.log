+def _outside_mask(closed_ring: np.ndarray) -> np.ndarray:
+    h, w = closed_ring.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not closed_ring[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not closed_ring[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if closed_ring[rr, cc] or outside[rr, cc]:
+                continue
+            outside[rr, cc] = True
+            q.append((rr, cc))
+    return outside
+
+
+def _distance_from_ring(closed_ring: np.ndarray) -> np.ndarray:
+    h, w = closed_ring.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q = deque()
+    for r, c in np.argwhere(closed_ring):
+        r = int(r)
+        c = int(c)
+        dist[r, c] = 0
+        q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if dist[rr, cc] != -1:
+                continue
+            dist[rr, cc] = dist[r, c] + 1
+            q.append((rr, cc))
+    return dist
+
