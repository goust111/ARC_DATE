+
+def _gen_attempt() -> np.ndarray | None:
+    rows, cols = random.choice(_layout_options())
+    max_panel_h = min(MAX_PANEL_SIDE, (MAX_GRID_SIDE - (rows - 1)) // rows)
+    max_panel_w = min(MAX_PANEL_SIDE, (MAX_GRID_SIDE - (cols - 1)) // cols)
