+
+
+def _gap_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    gap_type = random.choice(("straight", "corner"))
