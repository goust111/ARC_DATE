+            c0 = pc * (panel_w + 1)
+            grid[r0 : r0 + panel_h, c0 : c0 + panel_w] = panel
+            expected[r0 : r0 + panel_h, c0 : c0 + panel_w] = solved
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
