+def _pair_endpoints(endpoint_count: int, rng: random.Random) -> list[tuple[int, int]]:
+    indices = list(range(endpoint_count))
+    rng.shuffle(indices)
+    return [(indices[i], indices[i + 1]) for i in range(0, endpoint_count, 2)]
