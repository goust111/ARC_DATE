+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    pair_count = rng.randint(*GEN_PAIR_RANGE)
+    endpoint_count = 2 * pair_count
+
+    base_side = 14 + 3 * pair_count
