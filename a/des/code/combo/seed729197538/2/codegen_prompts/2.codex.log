+DOMAIN_NEIGHBORS = {cell: _neighbors_in_domain(cell) for cell in CANONICAL_DOMAIN}
+SLOT_RELS = {dir_idx: _rotate_cells(RIGHT_SLOT, (dir_idx - RIGHT_DIR) % 4) for dir_idx in range(4)}
