+GEN_BG = 0
+GEN_OBJECT = 5
+GEN_PORTAL_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+GEN_PAIR_RANGE = (1, 4)
+GEN_AREA_RANGE = (2, 7)
+GEN_SPAN = 2
+GEN_DEPTH = 4
+
+CANONICAL_DOMAIN = tuple(
+    (dr, dc)
+    for dr in range(-GEN_SPAN, GEN_SPAN + 1)
+    for dc in range(-GEN_DEPTH, 0)
