+def main(grid: np.ndarray) -> np.ndarray:
+    """Teleport each gray object to its paired portal and rotate it by portal-orientation difference."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    height, width = g.shape
+    bg = _get_bg(g)
