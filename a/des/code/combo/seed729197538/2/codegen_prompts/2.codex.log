+CANONICAL_DOMAIN_SET = set(CANONICAL_DOMAIN)
+RIGHT_SLOT = CANONICAL_DOMAIN
+
+
+def _neighbors_in_domain(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = cell
+    result: list[tuple[int, int]] = []
+    for sdr, sdc in DIRS:
+        nxt = (dr + sdr, dc + sdc)
