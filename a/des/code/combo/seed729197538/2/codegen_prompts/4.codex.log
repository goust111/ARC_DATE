+    if slide == "up":
+        return 0, c0, r0 + sh - 1, c0 + sw - 1
+    if slide == "down":
+        return r0, c0, h - 1, c0 + sw - 1
+    if slide == "left":
+        return r0, 0, r0 + sh - 1, c0 + sw - 1
+    if slide == "right":
