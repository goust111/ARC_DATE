+        return mask
+    return None
+
+
+def _removable_positions(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out = []
+    if int(mask.sum()) <= 1:
+        return out
+    for r, c in np.argwhere(mask):
