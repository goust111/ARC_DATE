+def _reference_index(components: list[dict]) -> int:
+    masks = [comp["mask"] for comp in components]
+    scores = []
+    for i, mask_i in enumerate(masks):
+        total = 0
+        for mask_j in masks:
+            total += int(np.count_nonzero(mask_i != mask_j))
+        scores.append(total)
+    order = sorted(
+        range(len(components)),
+        key=lambda i: (
+            scores[i],
+            components[i]["bbox"][0],
+            components[i]["bbox"][1],
+            -components[i]["area"],
+        ),
+    )
+    return order[0]
