import random
from collections import Counter

import numpy as np


BG = 0
PATTERN = 1
SEED = 2
GREEN = 3
MAX_RETRIES = 400


def _get_bg(grid: np.ndarray) -> int:
    return Counter(map(int, grid.flat)).most_common(1)[0][0]


def _neighbors4(r: int, c: int, h: int, w: int):
    if r > 0:
        yield r - 1, c
    if r + 1 < h:
        yield r + 1, c
    if c > 0:
        yield r, c - 1
    if c + 1 < w:
        yield r, c + 1


def _mask_bbox(mask: np.ndarray):
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _is_connected(mask: np.ndarray) -> bool:
    coords = np.argwhere(mask)
    if coords.size == 0:
        return False
    h, w = mask.shape
    start = tuple(map(int, coords[0]))
    stack = [start]
    seen = {start}
    while stack:
        r, c = stack.pop()
        for nr, nc in _neighbors4(r, c, h, w):
            if mask[nr, nc] and (nr, nc) not in seen:
                seen.add((nr, nc))
                stack.append((nr, nc))
    return len(seen) == int(mask.sum())


def _find_components(grid: np.ndarray, color: int):
    mask = grid == color
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords = []
            while stack:
                cr, cc = stack.pop()
                coords.append((cr, cc))
                for nr, nc in _neighbors4(cr, cc, h, w):
                    if mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            rows = [p[0] for p in coords]
            cols = [p[1] for p in coords]
            r0, r1 = min(rows), max(rows)
            c0, c1 = min(cols), max(cols)
            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
            for rr, cc in coords:
                local[rr - r0, cc - c0] = True
            comps.append(
                {
                    "coords": coords,
                    "bbox": (r0, c0, r1, c1),
                    "mask": local,
                    "area": len(coords),
                }
            )
    return comps


def _touches_corner(comp: dict, shape: tuple[int, int]) -> bool:
    h, w = shape
    r0, c0, r1, c1 = comp["bbox"]
    return (
        (r0 == 0 and c0 == 0)
        or (r0 == 0 and c1 == w - 1)
        or (r1 == h - 1 and c0 == 0)
        or (r1 == h - 1 and c1 == w - 1)
    )


def _select_seed_component(components: list[dict], shape: tuple[int, int]) -> dict:
    ranked = sorted(
        components,
        key=lambda comp: (
            0 if _touches_corner(comp, shape) else 1,
            comp["area"],
            comp["bbox"][0],
            comp["bbox"][1],
        ),
    )
    return ranked[0]


def _choose_roles(grid: np.ndarray):
    bg = _get_bg(grid)
    colors = [int(color) for color in np.unique(grid) if int(color) != bg]
    by_color = {color: _find_components(grid, color) for color in colors}
    pattern_color = max(
        colors,
        key=lambda color: (
            len(by_color[color]),
            max((comp["area"] for comp in by_color[color]), default=0),
