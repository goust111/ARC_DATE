+    shape_counts = Counter(comp["mask"].shape for comp in components)
+    target_shape = max(
+        shape_counts,
+        key=lambda shape: (shape_counts[shape], shape[0] * shape[1]),
+    )
+    group = [comp for comp in components if comp["mask"].shape == target_shape]
+    assert len(group) >= 2
+    return group
