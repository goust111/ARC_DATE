+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+FORWARD_TRANSFORMS = ("rot90cw", "hflip", "vflip")
+INVERSE_TRANSFORM = {
+    "rot90cw": "rot90ccw",
+    "hflip": "hflip",
+    "vflip": "vflip",
+}
