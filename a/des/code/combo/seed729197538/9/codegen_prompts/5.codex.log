+
+
+def _shape_valid_for_transform(mask: np.ndarray, transform: str) -> bool:
+    if mask.shape[0] < 2 or mask.shape[1] < 2:
+        return False
+    if int(mask.sum()) < 3 or np.all(mask):
+        return False
+    if int(np.any(mask, axis=0).sum()) < 2 or int(np.any(mask, axis=1).sum()) < 2:
+        return False
