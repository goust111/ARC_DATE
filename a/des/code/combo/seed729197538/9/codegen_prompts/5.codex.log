+        return np.rot90(mask, -1)
+    if name == "rot90ccw":
+        return np.rot90(mask, 1)
+    if name == "hflip":
+        return np.fliplr(mask)
+    if name == "vflip":
+        return np.flipud(mask)
+    raise ValueError(f"unknown transform: {name}")
