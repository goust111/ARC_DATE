        return {r: BASE_WALL_OFFSET for r in wall_rows}
    peak = random.randint(PEAK_WALL_OFFSET_MIN, min(maximum, BASE_WALL_OFFSET + max_depth))
    offsets = {}
    for r in wall_rows:
