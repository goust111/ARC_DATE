+    out = g.copy()
+    for comp in _components4(g == PIPE):
+        _solve_component(g, out, comp)
+    return out
+
+
+# --------------- generator ---------------
+
+GRID_MIN = 18
+GRID_MAX = 30
+PIPE_SIDE_MIN = 6
+PIPE_SIDE_MAX = 11
+PIPE_COUNT_CHOICES = (1, 2, 2, 3, 3, 4)
+COUNT_MIN = 1
+COUNT_MAX = 4
+PLACEMENT_TRIES = 80
+GENERATION_TRIES = 400
+PADDING = 1
+EDGE_TOUCH_PROB = 0.4
+OFF_PATH_MARKER_PROB = 0.8
