+    regions, _counts = _grown_regions(grid)
+    boundary = _boundary_mask(regions)
+    boundary_cells = int(np.count_nonzero(boundary))
+    if boundary_cells < max(4, min(grid.shape) // 2):
+        return False
+    if boundary_cells > (grid.size * 2) // 5:
