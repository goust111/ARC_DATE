+    output = regions.copy()
+    output[boundary] = BOUNDARY_COLOR_BY_DIFF[diff]
+    return set(map(int, np.unique(output))) == {colors[0], colors[1], BOUNDARY_COLOR_BY_DIFF[diff]}
