+            best = _choose_defect_candidate(candidates)
+            if str(best["direction"]) != str(expected_direction):
+                continue
+            best_count = int(best["missing_count"])
+            if sum(int(cand["missing_count"]) == best_count for cand in candidates) != 1:
+                continue
