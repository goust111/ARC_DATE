+BG = 0
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SHIFT_BY_DIRECTION = {
+    "up": (-2, 0),
+    "down": (2, 0),
+    "left": (0, -2),
+    "right": (0, 2),
+}
+AXIS_ORDER = {"vertical": 0, "horizontal": 1}
+DIRECTION_ORDER = {"left": 0, "right": 1, "up": 2, "down": 3}
+
+GEN_GRID_MIN = 16
+GEN_GRID_MAX = 28
+GEN_OBJECT_MIN = 2
+GEN_OBJECT_MAX = 5
+GEN_OBJECT_RETRIES = 120
+GEN_PLACEMENT_RETRIES = 160
