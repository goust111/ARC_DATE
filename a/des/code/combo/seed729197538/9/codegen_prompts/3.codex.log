+def _mask_from_coords(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    bbox = _bbox_from_coords(coords)
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, bbox
