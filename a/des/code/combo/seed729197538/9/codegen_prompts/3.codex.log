+    edge_rows = []
+    for r in range(h):
+        cols = np.flatnonzero(work[r])
+        if cols.size <= 1:
+            continue
+        candidates.append(int(r))
+        if (side == "left" and int(cols[0]) == edge_col) or (
+            side == "right" and int(cols[-1]) == edge_col
