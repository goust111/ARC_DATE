+
+def _analyze_mask(mask: np.ndarray) -> dict:
+    horizontal_symmetric = bool(np.array_equal(mask, np.flipud(mask)))
+    vertical_symmetric = bool(np.array_equal(mask, np.fliplr(mask)))
