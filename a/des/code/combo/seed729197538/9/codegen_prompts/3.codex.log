+
+
+def _mask_is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+
+    start = tuple(map(int, pts[0]))
+    q = deque([start])
+    seen = {start}
