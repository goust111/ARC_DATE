+
+def _place_specs(specs: list[dict], h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    grid = np.zeros((h, w), dtype=int)
+    input_blocked: set[tuple[int, int]] = set()
+    output_blocked: set[tuple[int, int]] = set()
+
