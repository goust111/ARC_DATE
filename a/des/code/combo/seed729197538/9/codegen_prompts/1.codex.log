+        return None
+
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    if len(_find_frames(grid, BG)) != target_rects:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
