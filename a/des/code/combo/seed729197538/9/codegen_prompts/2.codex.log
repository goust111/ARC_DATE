+        coords |= {(0, shaft_len - 1), (2, shaft_len - 1), (1, shaft_len)}
+        return coords, (1, shaft_len)
+    if direction == "left":
+        coords = {(1, c) for c in range(1, shaft_len + 1)}
+        coords |= {(0, 1), (2, 1), (1, 0)}
+        return coords, (1, 0)
+    if direction == "down":
