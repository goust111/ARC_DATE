  71: def main(grid: np.ndarray) -> np.ndarray:
  72:     """
  73:     Mark each arrow-like sprite's pointed frame endpoint with its color and the opposite endpoint black.
  74: 
  75:     Input structure:
  76:     - The grid has a one-pixel solid rectangular frame around a dominant interior background.
  77:     - Inside the frame are monochrome six-pixel sprites shaped as asymmetric T arrows.
  78:     - Each sprite has a length-4 bar and a length-3 crossbar one cell closer to the pointed end.
  79: 
  80:     Rule:
  81:     - For each sprite, follow its bar axis from the shorter end to the frame.
  82:     - Paint that frame endpoint with the sprite color.
  83:     - Paint the opposite endpoint on the same row or column black.
  84:     - Leave the interior background, sprites, and all other frame pixels unchanged.
  85: 
  86:     Key insight:
  87:     - The direction is encoded by the crossbar's off-center position: the nearer end is the pointing end.
  88:     """
  89:     g = np.asarray(grid, dtype=int)
  90:     frame = _solid_frame_color(g)
  91:     bg = int(get_bg(g[1:-1, 1:-1]))
  92:     assert bg != frame, "interior background must differ from the frame"
  93: 
  94:     sprite_colors = colors_present(g, exclude={bg, frame})
  95:     assert sprite_colors, "expected at least one sprite"
  96:     assert Color.BLACK not in set(sprite_colors) | {bg, frame}, "black is reserved for opposite endpoints"
  97: 
  98:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=sprite_colors)
  99:     assert len(components) == len(sprite_colors), "expected one 4-connected object per sprite color"
 100: 
 101:     assignments: dict[tuple[int, int], int] = {}
 102:     for component in components:
 103:         assert int(component["area"]) == 6, "each sprite must have six pixels"
 104:         color = int(component["color"])
 105:         pointed, opposite = _sprite_endpoints(g, component["coords"])
 106: 
 107:         for coord, value in ((pointed, color), (opposite, Color.BLACK)):
 108:             assert int(g[coord]) == frame, "sprite endpoints must land on frame pixels"
 109:             assert coord not in assignments, "frame endpoint assignments must not overlap"
 110:             assignments[coord] = int(value)
 111: 
 112:     out = g.copy()
 113:     for (r, c), value in assignments.items():
 114:         out[r, c] = value
 115:     return out
