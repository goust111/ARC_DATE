  50:     stationary = [comp for comp in components if int(comp["area"]) <= SMALL_MARKER_MAX_AREA]
  51:     assert moving, "expected at least one moving sprite"
  52:     assert stationary, "expected at least one fixed marker"
  53: 
  54:     out = g.copy()
  55:     for comp in moving:
  56:         coords = comp["coords"]
  57:         out[coords[:, 0], coords[:, 1]] = bg
  58: 
  59:     occupied = np.zeros((H, W), dtype=bool)
  60:     for comp in moving:
