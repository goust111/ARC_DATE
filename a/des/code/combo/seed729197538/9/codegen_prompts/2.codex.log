  24: def main(grid: np.ndarray) -> np.ndarray:
  25:     """
  26:     Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.
  27: 
  28:     Input structure:
  29:     - Left of a full-height vertical divider: 3x3 colored glyphs on bg.
  30:     - Right of divider: a single gray (5) start pixel.
  31: 
  32:     Rule:
  33:     - Remove the divider; shift the gray start into the left canvas.
  34:     - Read glyphs in column-major order (left→right, top→bottom).
  35:     - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.
  36:     - Append segments sequentially, stepping down one cell between each.
  37: 
  38:     Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.
  39:     """
  40:     g = np.array(grid, dtype=int)
  41:     H, W = g.shape
  42:     bg = int(get_bg(g))
  43: 
  44:     # Divider is a full-height constant non-bg column.
  45:     div_c, div_color = find_full_height_constant_col(g, bg=bg)
  46:     assert div_c is not None
  47: 
  48:     out = np.zeros((H, int(div_c)), dtype=int)
  49: 
  50:     # Move gray start from right side into left canvas (remove divider col too).
  51:     gray = np.argwhere(g == 5)
  52:     if gray.size == 0:
  53:         return out
  54:     r_cur, c_cur = map(int, gray[0])
  55:     c_cur = int(c_cur - (int(div_c) + 1))
  56:     if not (0 <= c_cur < int(div_c)):
  57:         return out
  58:     out[int(r_cur), int(c_cur)] = 5
  59: 
  60:     # Collect 3x3 glyph components on the left.
  61:     left = g[:, : int(div_c)]
  62:     ignore = {int(bg), 5}
  63:     if div_color is not None:
  64:         ignore.add(int(div_color))
  65: 
  66:     glyphs: list[dict[str, int]] = []
  67:     for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format="dict"):
  68:         col = int(comp["color"])
  69:         if col in ignore:
  70:             continue
  71:         b = comp["bbox"]
  72:         if bbox_h(b) == 3 and bbox_w(b) == 3:
  73:             r0, c0, _r1, _c1 = map(int, b)
  74:             glyphs.append({"color": int(col), "r0": int(r0), "c0": int(c0), "area": int(comp["area"])})
  75: 
  76:     glyphs.sort(key=lambda d: (int(d["c0"]), int(d["r0"])))
  77: 
  78:     area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}
  79:     area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left
  80: 
  81:     for glyph in glyphs:
  82:         color = int(glyph["color"])
  83:         area = int(glyph["area"])
  84:         seg_len = int(area_to_len.get(area, 2))
  85: 
  86:         r_cur = int(r_cur + 1)
  87:         assert r_cur < H, f"segment exits bottom: r_cur={r_cur}, H={H}"
  88:         out[r_cur, int(c_cur)] = color
  89: 
  90:         if area == 4:  # vertical (down)
  91:             end_r = r_cur + (seg_len - 1)
  92:             assert end_r < H, f"vertical segment exits bottom: end_r={end_r}, H={H}"
  93:             for _ in range(seg_len - 1):
  94:                 r_cur = int(r_cur + 1)
  95:                 out[r_cur, int(c_cur)] = color
  96:         else:  # horizontal
