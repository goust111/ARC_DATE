+    out_w = max(int(item["width"]) for item in ordered)
+    out = np.full((out_h, out_w), BG, dtype=int)
+    row = 0
+    for item in ordered:
+        h = int(item["height"])
+        w = int(item["width"])
+        out[row : row + h, :w] = int(item["color"])
+        row += h
+    return out
