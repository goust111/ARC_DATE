+        row_lengths = [width] * top_full_rows
+        for length, band in zip(lengths, band_sizes):
+            row_lengths.extend([length] * band)
+
+        cut_rows = [length for length in row_lengths if length < width]
+        if len(cut_rows) < 2 or len(set(cut_rows)) < 2:
+            continue
+
