+                    "color": color,
+                    "height": height,
+                    "width": width,
+                    "area": area,
+                    "pieces": [
+                        _render_piece(top_mask, color),
+                        _render_piece(bottom_mask, color),
+                    ],
+                }
+            )
+            used_areas.add(area)
+            made = True
+            break
