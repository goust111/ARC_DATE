+def _build_pair_masks(height: int, width: int) -> tuple[np.ndarray, np.ndarray] | None:
+    max_levels = min(MAX_LEVELS, height - 1, width - 1)
+    if max_levels < 2:
+        return None
+
+    for _ in range(SHAPE_ATTEMPTS):
