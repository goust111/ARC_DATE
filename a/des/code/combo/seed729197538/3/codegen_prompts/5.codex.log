+
+    return out
+
+
+def _random_pattern(rng: random.Random) -> tuple[str, int]:
+    kind = rng.choice(PATTERN_KINDS)
+    if kind == "solid":
+        return ("solid", 0)
+    return (kind, rng.randrange(2))
+
+
+def _pair_pattern(
+    kind: str,
+    orientation: str,
+    side: str,
+    shape: tuple[int, int],
+    bridge_offset: int,
+) -> tuple[str, int]:
+    height, width = shape
+    if kind == "solid":
+        return ("solid", 0)
+    if orientation == "h":
+        if kind == "hstripe":
+            return (kind, bridge_offset % 2)
+        if side == "left":
+            return (kind, (width - 1) % 2)
+        return (kind, 0)
+    if kind == "vstripe":
+        return (kind, bridge_offset % 2)
+    if side == "top":
+        return (kind, (height - 1) % 2)
+    return (kind, 0)
+
+
+def _can_place(
+    reserved: np.ndarray, bbox: tuple[int, int, int, int], pad: int = PADDING
+) -> bool:
+    h, w = reserved.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return not bool(np.any(reserved[rr0 : rr1 + 1, cc0 : cc1 + 1]))
+
+
+def _reserve(reserved: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
