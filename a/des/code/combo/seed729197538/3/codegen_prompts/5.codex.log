+    for r in range(h):
+        c = 0
+        while c < w:
+            if int(grid[r, c]) != color:
+                c += 1
+                continue
+            c0 = c
+            while c + 1 < w and int(grid[r, c + 1]) == color:
+                c += 1
+            segments.append((r, c0, c))
+            c += 1
+    return segments
