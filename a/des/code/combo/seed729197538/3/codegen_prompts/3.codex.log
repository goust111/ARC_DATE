+
+        _draw_room(grid, bbox, wall, windows)
+        _mark_blocked(blocked, bbox)
+        return bbox
+    return None
+
+
+def _rotate_grid_from_top_source(grid: np.ndarray, k: int) -> np.ndarray:
+    return np.rot90(grid, k=k).copy()
