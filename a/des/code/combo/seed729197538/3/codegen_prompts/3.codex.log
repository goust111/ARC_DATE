+        cursor = 1
+        placed_here = 0
+        for idx in range(chain_len):
+            room = _place_chain_room(
+                rng,
+                grid,
+                blocked,
+                wall,
+                track_col,
+                cursor,
+                continue_down=idx < chain_len - 1,
