+                    break
+                if interior[r, c]:
+                    out[r, c] = source_color
+    elif source_side == "bottom":
+        for c in range(w):
+            for r in range(h - 2, -1, -1):
+                if int(g[r, c]) != bg:
+                    break
+                if interior[r, c]:
+                    out[r, c] = source_color
+    elif source_side == "left":
+        for r in range(h):
+            for c in range(1, w):
+                if int(g[r, c]) != bg:
