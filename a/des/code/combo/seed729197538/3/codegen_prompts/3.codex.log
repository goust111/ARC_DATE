+        r0 = int(rng.integers(2, h - room_h))
+        c0 = int(rng.integers(1, w - room_w))
+        r1 = r0 + room_h - 1
+        c1 = c0 + room_w - 1
+        bbox = (r0, c0, r1, c1)
