+def _extract_room_bboxes(grid: np.ndarray, bg: int, source_color: int) -> list[tuple[int, int, int, int]]:
+    wall_mask = (grid != bg) & (grid != source_color)
+    rooms: list[tuple[int, int, int, int]] = []
+    for comp in _components4(wall_mask):
