+        interior_cols = [c for c in range(c0 + 1, c1) if c != track_col]
+        if interior_cols and rng.random() < 0.45:
+            extra_col = int(rng.choice(interior_cols))
+            top_windows.add(extra_col)
+            if rng.random() < 0.6:
