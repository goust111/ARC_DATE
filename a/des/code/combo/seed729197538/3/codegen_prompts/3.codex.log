+        ("top", grid[0, :]),
+        ("bottom", grid[-1, :]),
+        ("left", grid[:, 0]),
+        ("right", grid[:, -1]),
+    )
+    candidates = [
+        (side, int(edge[0]))
+        for side, edge in edges
+        if edge.size > 0 and np.all(edge == edge[0]) and int(edge[0]) != bg
+    ]
+    assert len(candidates) == 1, "expected exactly one full non-background edge source"
+    return candidates[0]
+
