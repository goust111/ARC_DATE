+import numpy as np
+
+
+BG = 0
+LIGHT = 4
+WALL_CHOICES = (1, 2, 3, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+MIN_H = 12
+MAX_H = 22
+MIN_W = 12
+MAX_W = 22
+MIN_ROOM_H = 4
+MAX_ROOM_H = 7
+MIN_ROOM_W = 4
+MAX_ROOM_W = 8
+ROOM_PAD = 1
+MAX_TRACKS = 3
+MAX_CHAIN_LEN = 3
+MAX_DISTRACTORS = 4
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _find_source(grid: np.ndarray, bg: int) -> tuple[str, int]:
+    edges = (
+        ("top", grid[0, :]),
+        ("bottom", grid[-1, :]),
+        ("left", grid[:, 0]),
+        ("right", grid[:, -1]),
+    )
+    candidates = [
+        (side, int(edge[0]))
+        for side, edge in edges
+        if edge.size > 0 and np.all(edge == edge[0]) and int(edge[0]) != bg
+    ]
+    assert len(candidates) == 1, "expected exactly one full non-background edge source"
+    return candidates[0]
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _room_interior_mask(grid: np.ndarray, bg: int, source_color: int) -> np.ndarray:
+    wall_mask = (grid != bg) & (grid != source_color)
+    interior = np.zeros_like(grid, dtype=bool)
+    for comp in _components4(wall_mask):
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        # Rooms are thin rectangular frames with possible gaps only on the perimeter.
+        if any(r not in (r0, r1) and c not in (c0, c1) for r, c in comp):
+            continue
+        interior[r0 + 1 : r1, c0 + 1 : c1] = True
+    return interior
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg = _most_common_color(g)
+    source_side, source_color = _find_source(g, bg)
+    interior = _room_interior_mask(g, bg, source_color)
+    out = g.copy()
+    h, w = g.shape
+
+    if source_side == "top":
+        for c in range(w):
+            for r in range(1, h):
+                if int(g[r, c]) != bg:
+                    break
+                if interior[r, c]:
+                    out[r, c] = source_color
+    elif source_side == "bottom":
+        for c in range(w):
+            for r in range(h - 2, -1, -1):
+                if int(g[r, c]) != bg:
+                    break
+                if interior[r, c]:
+                    out[r, c] = source_color
+    elif source_side == "left":
+        for r in range(h):
+            for c in range(1, w):
+                if int(g[r, c]) != bg:
+                    break
+                if interior[r, c]:
+                    out[r, c] = source_color
+    else:
+        for r in range(h):
+            for c in range(w - 2, -1, -1):
+                if int(g[r, c]) != bg:
