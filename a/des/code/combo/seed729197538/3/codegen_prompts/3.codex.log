+def _find_source(grid: np.ndarray, bg: int) -> tuple[str, int]:
+    edges = (
+        ("top", grid[0, :]),
+        ("bottom", grid[-1, :]),
+        ("left", grid[:, 0]),
+        ("right", grid[:, -1]),
+    )
+    candidates = [
