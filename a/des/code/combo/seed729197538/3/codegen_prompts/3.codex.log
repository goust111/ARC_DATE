+import numpy as np
+
+
+BG = 0
+LIGHT = 4
+WALL_CHOICES = (1, 2, 3, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+MIN_H = 12
+MAX_H = 22
+MIN_W = 12
+MAX_W = 22
+MIN_ROOM_H = 4
+MAX_ROOM_H = 7
+MIN_ROOM_W = 4
+MAX_ROOM_W = 8
+ROOM_PAD = 1
+MAX_TRACKS = 3
+MAX_CHAIN_LEN = 3
+MAX_DISTRACTORS = 4
