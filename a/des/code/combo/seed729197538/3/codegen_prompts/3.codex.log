+        left_min = max(1, track_col - room_w + 2)
+        left_max = min(w - room_w - 1, track_col - 1)
+        if left_min > left_max:
+            continue
+        c0 = int(rng.integers(left_min, left_max + 1))
+        c1 = c0 + room_w - 1
+        bbox = (r0, c0, r1, c1)
