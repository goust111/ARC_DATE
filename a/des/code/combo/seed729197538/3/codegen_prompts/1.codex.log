+    out = [target for _, target in patches]
+    return _place_patches(inp, out)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        case = _generate_case()
+        if case is None:
+            continue
+        inp, out = case
+        try:
+            if np.array_equal(main(inp), out):
+                return inp
+        except Exception:
+            continue
+    raise RuntimeError("failed to generate a valid pipe-tree puzzle")

