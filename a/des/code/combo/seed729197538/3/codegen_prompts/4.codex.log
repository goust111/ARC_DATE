+    out = np.full((rows, cols), BG, dtype=int)
+
+    ttop, tleft = positions[0]
+    th, tw = template_patch.shape
+    inp[ttop : ttop + th, tleft : tleft + tw] = template_patch
+    out[ttop : ttop + th, tleft : tleft + tw] = template_patch
+
