+        assert len(matches) == 1
+        full = rotations[matches[0]]
+        rh, rw = full.shape
+        patch = out[r0 + 1 : r0 + 1 + rh, c0 + 1 : c0 + 1 + rw]
+        patch[full] = RED
+    return out
