+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            local = np.zeros((h, w), dtype=bool)
+            local[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            frame = np.zeros((h, w), dtype=bool)
+            frame[0, :] = True
+            frame[-1, :] = True
+            frame[:, 0] = True
+            frame[:, -1] = True
+            if np.array_equal(local, frame):
