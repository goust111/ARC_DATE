+
+def _make_envelope_patches(color: int, clue: np.ndarray, full: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    ih, iw = clue.shape
+    inp = np.full((ih + 2, iw + 2), BG, dtype=int)
