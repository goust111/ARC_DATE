+    if not (1 <= idx < n - 1):
+        return None
+
+    a = order[idx - 1]
+    b = order[idx]
+    c = order[idx + 1]
+    d1 = (b[0] - a[0], b[1] - a[1])
+    d2 = (c[0] - b[0], c[1] - b[1])
