+    start = min(pts)
+    nbrs = [p for p in _neighbors4(*start) if p in path_set]
+    assert len(nbrs) == 2, "start pixel must have degree 2"
+
+    inside_mask = _interior_mask(path_mask)
+    assert inside_mask.any(), "path must enclose a non-empty interior"
