+    cand0 = _trace_cycle(path_set, start, nbrs[0])
+    cand1 = _trace_cycle(path_set, start, nbrs[1])
+    score0 = _clockwise_score(cand0, inside_mask)
+    score1 = _clockwise_score(cand1, inside_mask)
+    if score1 > score0:
+        return cand1
+    return cand0
