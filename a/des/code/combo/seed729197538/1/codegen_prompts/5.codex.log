+    dr, dc = d1
+    offset = (-dc, dr) if side == "left" else (dc, -dr)
+    inserted = [
+        (a[0] + offset[0], a[1] + offset[1]),
+        (b[0] + offset[0], b[1] + offset[1]),
+        (c[0] + offset[0], c[1] + offset[1]),
+    ]
