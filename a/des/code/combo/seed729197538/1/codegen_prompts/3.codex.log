+
+    for _ in range(PLACE_ATTEMPTS):
+        outer_h = int(rng.integers(*FRAME_H_RANGE))
+        outer_w = int(rng.integers(*FRAME_W_RANGE))
+        side = str(rng.choice(SIDES))
+        inner_h = outer_h - 2
+        inner_w = outer_w - 2
+
+        if side == "up":
