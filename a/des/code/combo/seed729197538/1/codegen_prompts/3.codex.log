+        grid[r0, c0 + gap_start : c0 + gap_start + gap_len] = BG
+    elif side == "down":
+        grid[r1, c0 + gap_start : c0 + gap_start + gap_len] = BG
+    elif side == "left":
+        grid[r0 + gap_start : r0 + gap_start + gap_len, c0] = BG
+    else:
+        grid[r0 + gap_start : r0 + gap_start + gap_len, c1] = BG
+
