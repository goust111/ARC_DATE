+
+def _frame_info_for_color(grid: np.ndarray, color: int) -> dict[str, object] | None:
+    coords = np.argwhere(grid == color)
+    if coords.size == 0:
+        return None
+
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    r0 = int(r0)
+    c0 = int(c0)
+    r1 = int(r1)
+    c1 = int(c1)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
