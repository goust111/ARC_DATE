+PATTERN_COLOR = 5
+FRAME_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("up", "down", "left", "right")
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 120
+GRID_SIZE_RANGE = (18, 31)
+FRAME_H_RANGE = (5, 10)
+FRAME_W_RANGE = (5, 10)
+OBJECT_COUNT = (1, 2, 3, 4)
+OBJECT_WEIGHTS = np.array([1, 3, 3, 2], dtype=float)
+PAD = 1
