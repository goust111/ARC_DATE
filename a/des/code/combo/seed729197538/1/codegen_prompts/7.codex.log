+    r1, c1 = arr.max(axis=0)
+    if axis == 1:
+        reflected = np.column_stack((arr[:, 0] - r0, c1 - arr[:, 1]))
+    else:
+        reflected = np.column_stack((r1 - arr[:, 0], arr[:, 1] - c0))
+    return tuple(sorted(map(tuple, reflected.tolist())))
+
