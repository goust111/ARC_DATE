+def _detect_divider(grid: np.ndarray, bg: int) -> tuple[int, int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, int]] = []
+    for r in range(h):
+        color = int(grid[r, 0])
+        if color != bg and np.all(grid[r, :] == color) and r == h - 1 - r:
+            candidates.append((0, r, color))
+    for c in range(w):
+        color = int(grid[0, c])
