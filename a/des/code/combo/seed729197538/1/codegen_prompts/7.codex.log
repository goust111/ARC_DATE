+
+def _mirror_global(coords: np.ndarray, axis: int, div_idx: int) -> np.ndarray:
+    mirrored = coords.copy()
+    if axis == 1:
+        mirrored[:, 1] = 2 * div_idx - mirrored[:, 1]
+    else:
+        mirrored[:, 0] = 2 * div_idx - mirrored[:, 0]
+    return mirrored
