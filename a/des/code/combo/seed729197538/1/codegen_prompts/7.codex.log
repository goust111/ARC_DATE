+
+BG = 0
+DIVIDER = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 160
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
