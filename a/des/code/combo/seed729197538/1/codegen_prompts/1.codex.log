+def _mask_signature(mask: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
+    pts = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    assert pts, "shape mask must be non-empty"
+    return _normalize_points(pts)
