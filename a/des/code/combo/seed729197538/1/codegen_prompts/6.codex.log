+        if color == BG:
+            continue
+        mask = grid == color
+        r0, c0, r1, c1 = _bbox(mask)
+        sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+        sprite[mask[r0 : r1 + 1, c0 : c1 + 1]] = color
+        items.append(
