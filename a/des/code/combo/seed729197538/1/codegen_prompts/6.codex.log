+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _shape_l() -> np.ndarray:
+    h = int(_RNG.integers(2, 6))
+    w = int(_RNG.integers(2, 6))
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:, 0] = True
+    mask[-1, :] = True
+    return mask
