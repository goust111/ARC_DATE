+            right = 2 * c > w - 1
+            if rot_cw == 0 and upper and left:
+                cells.append((r, c))
+            elif rot_cw == 1 and upper and right:
+                cells.append((r, c))
+            elif rot_cw == 2 and lower and right:
+                cells.append((r, c))
+            elif rot_cw == 3 and lower and left:
