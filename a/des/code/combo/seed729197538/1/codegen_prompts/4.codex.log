+def _rotation_from_marker(marker: tuple[int, int], shape: tuple[int, int]) -> int:
+    mr, mc = marker
+    h, w = shape
+    upper = 2 * mr < h - 1
+    lower = 2 * mr > h - 1
+    left = 2 * mc < w - 1
+    right = 2 * mc > w - 1
+    assert upper != lower and left != right, "marker must lie in a proper quadrant"
+    if upper and left:
+        return 0
+    if upper and right:
+        return 1
+    if lower and right:
+        return 2
+    return 3
