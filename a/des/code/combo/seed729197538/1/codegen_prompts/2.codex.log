+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GRAY = 5
+
+ARROW_COLORS = (BLUE, RED)
+CARDINALS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 400
