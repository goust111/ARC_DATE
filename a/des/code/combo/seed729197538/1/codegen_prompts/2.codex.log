+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _dist2_to_center(shape: tuple[int, int], r: int, c: int) -> float:
+    cr = (shape[0] - 1) / 2.0
+    cc = (shape[1] - 1) / 2.0
+    return (r - cr) ** 2 + (c - cc) ** 2
