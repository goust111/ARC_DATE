+    shapes = [
+        [anchor],
+        [anchor, (anchor[0] + perp[0][0], anchor[1] + perp[0][1])],
+        [anchor, (anchor[0] + perp[1][0], anchor[1] + perp[1][1])],
+        [
+            anchor,
+            (anchor[0] + perp[0][0], anchor[1] + perp[0][1]),
+            (anchor[0] + perp[1][0], anchor[1] + perp[1][1]),
