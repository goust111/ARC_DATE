+    for spec in choices:
+        low = int(spec["min_n"])
+        if spec["must_truncate"]:
+            low = max(low, int(spec["outward_space"]) + 1)
+            high = int(spec["max_n"])
+        else:
+            high = min(int(spec["max_n"]), int(spec["outward_space"]))
+        if high < low:
+            return False
+        spec["n"] = random.randint(low, high)
+        dr, dc = spec["dir"]
+        spec["anchor"] = (
+            int(spec["head"][0] + dr * (spec["n"] + 1)),
+            int(spec["head"][1] + dc * (spec["n"] + 1)),
