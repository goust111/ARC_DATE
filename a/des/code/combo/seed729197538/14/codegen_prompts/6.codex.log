+def _place_centered(canvas_shape: tuple[int, int], stamp: np.ndarray) -> tuple[int, int]:
+    inner_h, inner_w = canvas_shape
+    stamp_h, stamp_w = stamp.shape
+    assert stamp_h <= inner_h and stamp_w <= inner_w
