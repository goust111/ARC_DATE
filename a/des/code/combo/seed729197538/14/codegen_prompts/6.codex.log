+                continue
+
+            allowed = np.zeros_like(interior, dtype=bool)
+            allowed[0, 0] = True
+            allowed[0, -1] = True
+            allowed[-1, 0] = True
+            allowed[-1, -1] = True
+            if np.any((interior != BG) & ~allowed):
+                continue
