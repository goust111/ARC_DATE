+
+def _find_canvas(grid: np.ndarray) -> tuple[tuple[int, int, int, int], int, frozenset[str]]:
+    g = np.asarray(grid, dtype=int)
+    candidates: list[tuple[tuple[int, int, int, int], int, frozenset[str]]] = []
+    for color in np.unique(g):
