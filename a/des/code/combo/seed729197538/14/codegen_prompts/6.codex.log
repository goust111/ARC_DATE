+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for start_r, start_c in np.argwhere(mask):
+        start_r = int(start_r)
+        start_c = int(start_c)
+        if seen[start_r, start_c]:
+            continue
+        seen[start_r, start_c] = True
+        q = deque([(start_r, start_c)])
+        coords: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+        comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    r0, c0, r1, c1 = _bbox(coords)
+    return np.array(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+
+
+def _mask_from_coords(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _apply_transform(mask: np.ndarray, name: str) -> np.ndarray:
+    if name == "identity":
+        out = np.array(mask, dtype=bool, copy=True)
+    elif name == "flip_lr":
+        out = np.fliplr(mask)
+    elif name == "flip_ud":
+        out = np.flipud(mask)
+    elif name == "rot180":
+        out = np.rot90(mask, 2)
+    elif name == "rot90_cw":
+        out = np.rot90(mask, -1)
+    elif name == "rot90_ccw":
+        out = np.rot90(mask, 1)
+    elif name == "transpose":
+        out = np.array(mask.T, dtype=bool, copy=True)
+    elif name == "anti_transpose":
