+def _find_stamp(grid: np.ndarray, color: int, frame_bbox: tuple[int, int, int, int]) -> tuple[np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    r0, c0, r1, c1 = frame_bbox
