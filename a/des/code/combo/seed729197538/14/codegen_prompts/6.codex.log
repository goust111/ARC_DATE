+def _is_strongly_asymmetric(mask: np.ndarray) -> bool:
+    signatures = {_mask_signature(_apply_transform(mask, name)) for name in RANDOM_TRANSFORMS}
+    return len(signatures) == len(RANDOM_TRANSFORMS)
