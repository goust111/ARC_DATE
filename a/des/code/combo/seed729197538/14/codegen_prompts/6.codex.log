+
+
+def _stamp_positions_for_side(
+    grid_shape: tuple[int, int],
+    stamp_shape: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+    side: str,
+) -> list[tuple[int, int]]:
+    h, w = grid_shape
+    sh, sw = stamp_shape
+    fr0, fc0, fr1, fc1 = frame_bbox
+
+    row_min = OUTER_MARGIN
