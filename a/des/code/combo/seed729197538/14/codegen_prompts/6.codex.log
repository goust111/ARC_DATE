+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 9
+STAMP_COLORS = (1, 2, 3, 4, 5, 6, 8)
+OUTER_MARGIN = 1
+STAMP_GAP = 2
+GEN_ATTEMPTS = 400
+
+CORNER_TO_TRANSFORM = {
+    frozenset(("tl", "tr")): "flip_lr",
+    frozenset(("bl", "br")): "identity",
+    frozenset(("tl", "bl")): "flip_ud",
+    frozenset(("tr", "br")): "rot180",
+    frozenset(("tl", "br")): "rot90_cw",
+    frozenset(("tr", "bl")): "rot90_ccw",
+}
+RANDOM_TRANSFORMS = (
+    "identity",
+    "rot90_cw",
+    "rot180",
+    "rot90_ccw",
+    "flip_lr",
+    "flip_ud",
+    "transpose",
+    "anti_transpose",
+)
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for start_r, start_c in np.argwhere(mask):
+        start_r = int(start_r)
+        start_c = int(start_c)
+        if seen[start_r, start_c]:
+            continue
+        seen[start_r, start_c] = True
+        q = deque([(start_r, start_c)])
+        coords: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+        comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    r0, c0, r1, c1 = _bbox(coords)
+    return np.array(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+
