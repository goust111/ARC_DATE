+def _cross_cells(h: int, w: int, center_r: int, center_c: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for dr, dc in ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = center_r + dr
+        cc = center_c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            cells.append((rr, cc))
+    return cells
