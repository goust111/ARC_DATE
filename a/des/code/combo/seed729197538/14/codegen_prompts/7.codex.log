+    for dr, dc in offsets:
+        cells.add((center_r + dr, center_c + dc))
+        mr, mc = _moved_offset(dr, dc)
+        cells.add((center_r + mr, center_c + mc))
+
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    bbox = (
+        max(0, min(rows) - 1),
+        max(0, min(cols) - 1),
+        min(h - 1, max(rows) + 1),
+        min(w - 1, max(cols) + 1),
+    )
+    return cells, bbox
