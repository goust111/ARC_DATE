+    low_r = max(1, -min_dr)
+    high_r = min(h - 2, h - 1 - max_dr)
+    low_c = max(1, -min_dc)
+    high_c = min(w - 2, w - 1 - max_dc)
+    if low_r > high_r or low_c > high_c:
