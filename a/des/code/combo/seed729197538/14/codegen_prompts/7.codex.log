+            positions = [(center_r + dr, center_c + dc) for dr, dc in offsets]
+            return {
+                "color": color,
+                "center": (center_r, center_c),
+                "offsets": offsets,
+                "positions": positions,
+                "footprint": footprint,
+                "bbox": bbox,
