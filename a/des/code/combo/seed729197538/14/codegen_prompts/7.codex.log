+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+
+GRID_H_RANGE = (10, 18)
+GRID_W_RANGE = (10, 18)
+STAR_SIZE_RANGE = (3, 6)
+MAX_OFFSET = 4
+
+GENERATE_ATTEMPTS = 400
+CENTER_ATTEMPTS = 120
+OFFSET_ATTEMPTS = 220
+EDGE_CENTER_PROB = 0.4
+
+
+def _sign(value: int) -> int:
+    return int((value > 0) - (value < 0))
+
+
+def _cross_cells(h: int, w: int, center_r: int, center_c: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for dr, dc in ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = center_r + dr
+        cc = center_c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            cells.append((rr, cc))
+    return cells
+
+
+def _shifted_cell(r: int, c: int, center_r: int, center_c: int) -> tuple[int, int]:
+    dr = center_r - r
+    dc = center_c - c
+    if max(abs(dr), abs(dc)) <= 1:
+        return r, c
+    return r + _sign(dr), c + _sign(dc)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Pull each color one step toward its centroid and draw a same-color cross there."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    h, w = g.shape
+    out = np.full((h, w), BG, dtype=int)
+
+    colors = sorted(int(color) for color in np.unique(g) if int(color) != BG)
+    for color in colors:
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            continue
+
+        center_r = int(coords[:, 0].sum() // len(coords))
+        center_c = int(coords[:, 1].sum() // len(coords))
+
+        for r, c in coords:
+            rr, cc = _shifted_cell(int(r), int(c), center_r, center_c)
+            out[rr, cc] = color
+
+        for rr, cc in _cross_cells(h, w, center_r, center_c):
+            out[rr, cc] = color
+
+    return out
+
+
+def _candidate_offsets(h: int, w: int, center_r: int, center_c: int) -> list[tuple[int, int]]:
+    up = min(MAX_OFFSET, center_r)
+    down = min(MAX_OFFSET, h - 1 - center_r)
+    left = min(MAX_OFFSET, center_c)
+    right = min(MAX_OFFSET, w - 1 - center_c)
+
+    offsets: list[tuple[int, int]] = []
+    for dr in range(-up, down + 1):
+        for dc in range(-left, right + 1):
+            if dr == 0 and dc == 0:
+                continue
+            if max(abs(dr), abs(dc)) > MAX_OFFSET:
+                continue
+            offsets.append((dr, dc))
+    return offsets
+
+
+def _offset_weight(
+    dr: int,
+    dc: int,
+    *,
+    prefer_adjacent: bool,
+    prefer_orth: bool,
+    edge_mode: str | None,
+) -> float:
+    dist = max(abs(dr), abs(dc))
+    weight = 8.0 / (dist + 1.5)
+
+    if prefer_adjacent:
+        weight *= 2.5 if dist == 1 else 0.8
+    else:
+        weight *= 1.3 if dist >= 2 else 0.9
+
+    if prefer_orth:
+        weight *= 1.9 if (dr == 0 or dc == 0) else 0.8
+    else:
+        weight *= 1.6 if (dr != 0 and dc != 0) else 1.0
+
+    if edge_mode == "top" and dr == 0:
+        weight *= 1.8
+    if edge_mode == "left" and dc == 0:
+        weight *= 1.8
+
+    return weight
+
+
+def _sample_distinct_offsets(
+    candidates: list[tuple[int, int]],
+    count: int,
+    *,
+    prefer_adjacent: bool,
+    prefer_orth: bool,
+    edge_mode: str | None,
+) -> list[tuple[int, int]]:
+    remaining = list(candidates)
+    chosen: list[tuple[int, int]] = []
+    for _ in range(count):
+        weights = [
+            _offset_weight(
+                dr,
+                dc,
+                prefer_adjacent=prefer_adjacent,
+                prefer_orth=prefer_orth,
+                edge_mode=edge_mode,
+            )
+            for dr, dc in remaining
+        ]
+        pick = random.choices(remaining, weights=weights, k=1)[0]
+        chosen.append(pick)
+        remaining.remove(pick)
+    return chosen
+
+
+def _moved_offset(dr: int, dc: int) -> tuple[int, int]:
+    if max(abs(dr), abs(dc)) <= 1:
+        return dr, dc
+    return dr - _sign(dr), dc - _sign(dc)
+
+
+def _offsets_ok(
+    offsets: list[tuple[int, int]],
+    *,
+    require_adjacent: bool,
+    require_all_far: bool,
+) -> bool:
+    count = len(offsets)
+    sum_r = sum(dr for dr, _ in offsets)
+    sum_c = sum(dc for _, dc in offsets)
+    if not (0 <= sum_r < count and 0 <= sum_c < count):
+        return False
+
+    dists = [max(abs(dr), abs(dc)) for dr, dc in offsets]
+    if max(dists) < 2:
+        return False
+    if require_adjacent and 1 not in dists:
+        return False
+    if require_all_far and any(dist == 1 for dist in dists):
+        return False
+
+    rows = {dr for dr, _ in offsets}
+    cols = {dc for _, dc in offsets}
+    if len(rows) + len(cols) < 3:
+        return False
+
+    row_span = max(dr for dr, _ in offsets) - min(dr for dr, _ in offsets)
+    col_span = max(dc for _, dc in offsets) - min(dc for _, dc in offsets)
+    if row_span + col_span < 3:
+        return False
+
+    moved = {_moved_offset(dr, dc) for dr, dc in offsets}
+    if len(moved) == 1:
+        return False
+
+    return True
+
+
+def _group_footprint(
+    h: int,
+    w: int,
+    center_r: int,
+    center_c: int,
+    offsets: list[tuple[int, int]],
+) -> tuple[set[tuple[int, int]], tuple[int, int, int, int]]:
+    cells: set[tuple[int, int]] = set(_cross_cells(h, w, center_r, center_c))
+    for dr, dc in offsets:
+        cells.add((center_r + dr, center_c + dc))
+        mr, mc = _moved_offset(dr, dc)
+        cells.add((center_r + mr, center_c + mc))
+
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    bbox = (
+        max(0, min(rows) - 1),
+        max(0, min(cols) - 1),
+        min(h - 1, max(rows) + 1),
+        min(w - 1, max(cols) + 1),
+    )
+    return cells, bbox
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _sample_center(h: int, w: int, edge_mode: str | None) -> tuple[int, int]:
+    if edge_mode == "top":
+        return 0, random.randint(1, w - 2)
+    if edge_mode == "left":
+        return random.randint(1, h - 2), 0
+    return random.randint(1, h - 2), random.randint(1, w - 2)
+
+
+def _build_group(
+    h: int,
+    w: int,
+    color: int,
+    reserved_boxes: list[tuple[int, int, int, int]],
+    *,
+    edge_mode: str | None,
+    require_adjacent: bool,
+    require_all_far: bool,
+    prefer_orth: bool,
+) -> dict[str, object] | None:
+    count = random.randint(*STAR_SIZE_RANGE)
+
+    for _ in range(CENTER_ATTEMPTS):
+        center_r, center_c = _sample_center(h, w, edge_mode)
+        candidates = _candidate_offsets(h, w, center_r, center_c)
+        if require_all_far:
+            candidates = [
+                offset for offset in candidates if max(abs(offset[0]), abs(offset[1])) >= 2
+            ]
+        if len(candidates) < count:
+            continue
+
+        for _ in range(OFFSET_ATTEMPTS):
+            offsets = _sample_distinct_offsets(
+                candidates,
+                count,
+                prefer_adjacent=require_adjacent,
+                prefer_orth=prefer_orth,
+                edge_mode=edge_mode,
+            )
+            if not _offsets_ok(
+                offsets,
+                require_adjacent=require_adjacent,
+                require_all_far=require_all_far,
+            ):
+                continue
+
+            footprint, bbox = _group_footprint(h, w, center_r, center_c, offsets)
+            if any(_boxes_overlap(bbox, other) for other in reserved_boxes):
+                continue
+
+            positions = [(center_r + dr, center_c + dc) for dr, dc in offsets]
+            return {
+                "color": color,
+                "center": (center_r, center_c),
+                "offsets": offsets,
+                "positions": positions,
+                "footprint": footprint,
+                "bbox": bbox,
+            }
+
+    return None
+
+
+def _group_features(groups: list[dict[str, object]]) -> dict[str, bool]:
+    has_adjacent = False
+    has_all_far = False
+    has_orth_move = False
+    has_diagonal_move = False
+    has_edge_center = False
+
+    for group in groups:
+        center_r, center_c = group["center"]  # type: ignore[misc]
+        offsets = group["offsets"]  # type: ignore[misc]
+        has_edge_center |= center_r == 0 or center_c == 0
+
+        dists = [max(abs(dr), abs(dc)) for dr, dc in offsets]
+        has_adjacent |= any(dist == 1 for dist in dists)
+        has_all_far |= all(dist >= 2 for dist in dists)
+
+        for dr, dc in offsets:
+            if max(abs(dr), abs(dc)) <= 1:
+                continue
+            has_orth_move |= (dr == 0 or dc == 0)
+            has_diagonal_move |= (dr != 0 and dc != 0)
+
+    return {
+        "has_adjacent": has_adjacent,
+        "has_all_far": has_all_far,
+        "has_orth_move": has_orth_move,
+        "has_diagonal_move": has_diagonal_move,
+        "has_edge_center": has_edge_center,
+    }
+
+
+def _group_count_for_size(h: int, w: int) -> int:
+    area = h * w
+    if area < 140:
+        return random.randint(2, 3)
+    if area < 220:
+        return random.randint(2, 4)
+    return random.randint(3, 4)
+
+
+def _attempt_generate() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    group_count = _group_count_for_size(h, w)
+
+    colors = random.sample(PALETTE, group_count)
+    adjacent_index, far_index = random.sample(range(group_count), 2)
+    edge_index = random.randrange(group_count) if random.random() < EDGE_CENTER_PROB else None
+
+    groups: list[dict[str, object]] = []
+    reserved_boxes: list[tuple[int, int, int, int]] = []
+
+    for idx, color in enumerate(colors):
+        edge_mode = None
+        if idx == edge_index:
+            edge_mode = random.choice(("top", "left"))
+
+        group = _build_group(
+            h,
+            w,
+            color,
+            reserved_boxes,
+            edge_mode=edge_mode,
+            require_adjacent=(idx == adjacent_index),
+            require_all_far=(idx == far_index),
+            prefer_orth=bool(random.getrandbits(1)),
+        )
+        if group is None:
+            return None
+
+        groups.append(group)
+        reserved_boxes.append(group["bbox"])  # type: ignore[arg-type]
+
+    features = _group_features(groups)
+    if not features["has_adjacent"]:
+        return None
+    if not features["has_all_far"]:
+        return None
+    if not features["has_orth_move"]:
+        return None
+    if not features["has_diagonal_move"]:
+        return None
+    if edge_index is not None and not features["has_edge_center"]:
+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    for group in groups:
+        center_r, center_c = group["center"]  # type: ignore[misc]
+        assert grid[center_r, center_c] == BG
+        color = int(group["color"])
+        for r, c in group["positions"]:  # type: ignore[misc]
+            if grid[r, c] != BG:
+                return None
+            grid[r, c] = color
+
+    out = main(grid)
+    if out.shape != grid.shape or not np.any(out != grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid constellation grid")

