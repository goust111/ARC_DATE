+    if edge_mode == "left":
+        if role == "adjacent":
+            return _transform_left(random.choice(EDGE_TOP_ADJACENT_TEMPLATES))
+        return _transform_left(random.choice(EDGE_TOP_FAR_TEMPLATES))
