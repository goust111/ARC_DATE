+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+
+GRID_H_RANGE = (10, 18)
+GRID_W_RANGE = (10, 18)
+STAR_SIZE_RANGE = (3, 6)
