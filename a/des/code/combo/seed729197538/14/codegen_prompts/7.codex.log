+    weight = 8.0 / (dist + 1.5)
+
+    if prefer_adjacent:
+        weight *= 2.5 if dist == 1 else 0.8
+    else:
+        weight *= 1.3 if dist >= 2 else 0.9
+
+    if prefer_orth:
+        weight *= 1.9 if (dr == 0 or dc == 0) else 0.8
+    else:
+        weight *= 1.6 if (dr != 0 and dc != 0) else 1.0
