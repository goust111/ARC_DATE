+    *,
+    prefer_adjacent: bool,
+    prefer_orth: bool,
+    edge_mode: str | None,
+) -> list[tuple[int, int]]:
+    remaining = list(candidates)
+    chosen: list[tuple[int, int]] = []
+    for _ in range(count):
+        weights = [
+            _offset_weight(
+                dr,
+                dc,
+                prefer_adjacent=prefer_adjacent,
+                prefer_orth=prefer_orth,
+                edge_mode=edge_mode,
+            )
+            for dr, dc in remaining
+        ]
+        pick = random.choices(remaining, weights=weights, k=1)[0]
+        chosen.append(pick)
+        remaining.remove(pick)
+    return chosen
