+
+def _transform_left(template: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    offsets = _transpose(tuple(_transform_top(template)))
+    if random.random() < 0.5:
+        offsets = _flip_rows(offsets)
