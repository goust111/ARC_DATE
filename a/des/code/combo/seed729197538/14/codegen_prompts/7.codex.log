+def _shifted_cell(r: int, c: int, center_r: int, center_c: int) -> tuple[int, int]:
+    dr = center_r - r
+    dc = center_c - c
+    if max(abs(dr), abs(dc)) <= 1:
+        return r, c
+    return r + _sign(dr), c + _sign(dc)
+
