+            r0, c0, r1, c1 = _bbox(comp)
+            submask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            submask[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            side = _frame_side(submask)
+            if side is None:
+                continue
