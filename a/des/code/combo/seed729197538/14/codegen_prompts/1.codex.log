+def _tiled_pattern(pattern: np.ndarray, shape: tuple[int, int], side: str) -> np.ndarray:
+    h, w = map(int, shape)
+    row_idx = np.arange(h, dtype=int) % PATTERN_SIZE
+    col_idx = np.arange(w, dtype=int) % PATTERN_SIZE
