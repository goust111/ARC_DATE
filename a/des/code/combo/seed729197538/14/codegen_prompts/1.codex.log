+            interior = g[r0 + 1 : r1, c0 + 1 : c1]
+            seed_pts = np.argwhere(interior != BG)
+            assert len(seed_pts) == 1, "frame interior must contain exactly one seed pixel"
+            seed_r, seed_c = map(int, seed_pts[0])
+            seed_color = int(interior[seed_r, seed_c])
