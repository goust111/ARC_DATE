+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    starts = np.argwhere(mask)
+    for start_r, start_c in starts:
+        start_r = int(start_r)
+        start_c = int(start_c)
+        if seen[start_r, start_c]:
