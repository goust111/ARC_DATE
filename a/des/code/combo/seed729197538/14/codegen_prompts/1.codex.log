+
+def _central_gap_start(length: int) -> int:
+    center = (length - 1) / 2.0
+    candidates = []
+    best = None
+    for start in range(1, length - 2):
+        midpoint = start + 0.5
+        score = abs(midpoint - center)
+        if best is None or score < best:
+            best = score
+            candidates = [start]
+        elif score == best:
