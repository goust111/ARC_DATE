+    pts: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        pts.append((r, c))
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
