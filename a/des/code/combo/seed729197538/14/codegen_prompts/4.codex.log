+def _direction_from_pointer(r: int, c: int, tile_h: int, tile_w: int) -> tuple[int, int]:
+    dr = _sign(2 * int(r) - (int(tile_h) - 1))
+    dc = _sign(2 * int(c) - (int(tile_w) - 1))
