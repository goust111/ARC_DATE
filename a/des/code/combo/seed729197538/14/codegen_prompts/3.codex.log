+
+BG = 0
+PATH = 5
+VOTE_COLORS = (1, 2, 3, 4, 6, 8, 9)
+
+GRID_H_RANGE = (17, 28)
+GRID_W_RANGE = (17, 28)
+HORIZONTAL_COUNT_RANGE = (2, 4)
+VERTICAL_COUNT_RANGE = (2, 4)
+AXIS_MARGIN = 2
