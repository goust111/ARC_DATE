+
+
+def _assignment_result(assignment: tuple[int | None, ...]) -> int | None:
+    ordered = [int(color) for color in assignment if color is not None]
+    return _majority_by_order(ordered)
+
+
+def _sample_assignment(target: int, palette: list[int], require_tie: bool) -> tuple[int | None, ...] | None:
+    options: list[tuple[int | None, ...]] = []
+    for assignment in product([None] + palette, repeat=4):
+        ordered = [int(color) for color in assignment if color is not None]
+        if not ordered:
+            continue
+        if _assignment_result(assignment) != int(target):
+            continue
+        if require_tie and not _has_top_tie(ordered):
+            continue
+        if not require_tie and _has_top_tie(ordered) and random.random() < 0.75:
+            continue
+        options.append(tuple(assignment))
+    if not options:
+        return None
+    return random.choice(options)
+
+
+def _build_input(
+    height: int,
+    width: int,
+    rows: list[int],
+    cols: list[int],
+    matrix: np.ndarray,
+    palette: list[int],
