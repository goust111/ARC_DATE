+            if assignment is None:
+                return None
+
+            for direction_index, color in enumerate(assignment):
+                if color is None:
+                    continue
+                dr, dc = DIRS[direction_index]
+                arm_r = r + dr
+                arm_c = c + dc
+                if not _in_bounds(grid.shape, arm_r, arm_c) or int(grid[arm_r, arm_c]) != PATH:
+                    return None
+
+                candidates = []
+                for sdr, sdc in PERP_DIRS[(dr, dc)]:
+                    rr = arm_r + sdr
+                    cc = arm_c + sdc
