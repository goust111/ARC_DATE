+
+    rows = _sample_positions(AXIS_MARGIN, height - AXIS_MARGIN - 1, nh, MIN_AXIS_SEPARATION)
+    cols = _sample_positions(AXIS_MARGIN, width - AXIS_MARGIN - 1, nv, MIN_AXIS_SEPARATION)
+    if rows is None or cols is None:
