+PALETTE_SIZE_CHOICES = (2, 3)
+GREY_PROB_CHOICES = (0.15, 0.25, 0.35)
+FORCE_NEUTRAL_PATH_PROB = 0.4
+FORCE_TIE_INTERSECTION_PROB = 0.5
+MAX_GENERATION_ATTEMPTS = 400
