+def _region_spans(lengths: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    cursor = 0
+    for index, length in enumerate(lengths):
+        spans.append((cursor, cursor + length))
+        cursor += length
+        if index + 1 < len(lengths):
+            cursor += 1
+    return spans
