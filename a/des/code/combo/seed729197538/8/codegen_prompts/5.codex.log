+            row_low = rng.randint(0, height - 1 - minor_span)
+            col_low = rng.randint(0, width - 1 - major_span)
+            cols = _sample_axis_positions(col_low, col_low + major_span, count, allow_overlap, rng)
+            if cols is None:
