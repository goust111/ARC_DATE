+        else:
+            return None
+
+    if placed != frame_count:
+        return None
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        case = _attempt_case()
+        if case is not None:
+            return case[0]
+    raise RuntimeError("failed to generate a valid input for puzzle 3")

