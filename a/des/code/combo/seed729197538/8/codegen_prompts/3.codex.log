+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+BLACK = 0
+ORANGE = 7
+PALETTE_POOL = [1, 2, 3, 4, 5, 6, 8, 9]
+
+GRID_H_RANGE = (16, 28)
+GRID_W_RANGE = (18, 32)
+FRAME_COUNT_RANGE = (2, 5)
+OUTER_H_RANGE = (5, 11)
+OUTER_W_RANGE = (5, 13)
+PLACEMENT_TRIES = 120
+GENERATION_RETRIES = 400
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _perimeter_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c1))
+    for c in range(c1, c0 - 1, -1):
+        coords.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        coords.append((r, c0))
+    return coords
+
+
+def _find_palette(grid: np.ndarray) -> tuple[int, list[int]]:
+    h, _w = grid.shape
+    col = grid[:, 0]
+    candidates: list[tuple[int, list[int]]] = []
+    r = 0
+    while r < h:
+        value = int(col[r])
+        if value not in (BLACK, ORANGE):
+            start = r
+            while r < h and int(col[r]) not in (BLACK, ORANGE):
+                r += 1
+            run = [int(v) for v in col[start:r]]
+            if len(run) == 6 and len(set(run)) == 6:
+                candidates.append((start, run))
+        else:
+            r += 1
+    assert len(candidates) == 1, "expected exactly one 6-color palette on the left edge"
+    return candidates[0]
+
+
+def _frame_from_component(grid: np.ndarray, comp: list[tuple[int, int]]) -> tuple[int, int, int, int, int] | None:
+    rows = [r for r, _c in comp]
+    cols = [c for _r, c in comp]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    perimeter = _perimeter_coords(r0, c0, r1, c1)
+    perimeter_set = set(perimeter)
+    if any(cell not in perimeter_set for cell in comp):
+        return None
+
+    if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] != BLACK):
+        return None
+
+    if any(int(grid[r, c]) not in (BLACK, ORANGE) for r, c in perimeter):
+        return None
+
+    side_counts = [
+        int(np.sum(grid[r0, c0 : c1 + 1] == ORANGE)),
+        int(np.sum(grid[r1, c0 : c1 + 1] == ORANGE)),
+        int(np.sum(grid[r0 : r1 + 1, c0] == ORANGE)),
+        int(np.sum(grid[r0 : r1 + 1, c1] == ORANGE)),
+    ]
+    if min(side_counts) == 0:
+        return None
+
+    holes = sum(int(grid[r, c]) != ORANGE for r, c in perimeter)
+    if holes > 5:
+        return None
+    return r0, c0, r1, c1, holes
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
