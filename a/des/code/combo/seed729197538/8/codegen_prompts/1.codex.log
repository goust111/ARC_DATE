+FRAME_TRANSFORM = {
+    1: "v",   # blue
+    2: "h",   # red
+    3: "id",  # green
+}
+
+FRAME_COLORS = [1, 2, 3]
+COLOR_POOL = list(range(10))
+GAP_SHAPES = ["line2", "line3", "corner3"]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _tight_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _shape_key(mask: np.ndarray) -> tuple:
+    variants = []
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        variants.append((int(rot.shape[0]), int(rot.shape[1]), rot.tobytes()))
+    return min(variants)
+
+
+def _unique_rotations(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (int(rot.shape[0]), int(rot.shape[1]), rot.tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(rot.copy())
+    return out
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
