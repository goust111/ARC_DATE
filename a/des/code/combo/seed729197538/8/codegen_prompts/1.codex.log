+def _cyclic_missing_run(present: list[bool]) -> list[int] | None:
+    n = len(present)
+    if n == 0 or all(present) or not any(present):
+        return None
+    starts = [i for i in range(n) if (not present[i]) and present[(i - 1) % n]]
