+    H, W = occupied.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return False
+
+    piece_box = (top, left, top + h - 1, left + w - 1)
+    for frame_box in frame_boxes:
+        if _boxes_intersect(piece_box, frame_box, pad=1):
+            return False
