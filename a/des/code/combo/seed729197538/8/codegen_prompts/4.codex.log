) -> list[tuple[int, int]]:
    total_area = len(shape_a) + len(shape_b)
    candidates: set[tuple[int, int]] = set()
    transforms_a = _all_transforms(shape_a)
    transforms_b = _all_transforms(shape_b)

    for h in range(1, total_area + 1):
        if total_area % h:
