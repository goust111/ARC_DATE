+    h, _ = grid.shape
+    for r in range(h - 1, -1, -1):
+        cols = np.flatnonzero(grid[r] != bg)
+        if len(cols) < 2:
+            continue
+        colors = [int(grid[r, c]) for c in cols]
+        if len(colors) != len(set(colors)):
+            continue
+        if bool((grid[r + 1 :] != bg).any()):
+            continue
+        return int(r), colors
+    raise AssertionError("control row not found")
