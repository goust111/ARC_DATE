+def _find_control_row(grid: np.ndarray, bg: int) -> tuple[int, list[int]]:
+    h, _ = grid.shape
+    for r in range(h - 1, -1, -1):
+        cols = np.flatnonzero(grid[r] != bg)
+        if len(cols) < 2:
+            continue
+        colors = [int(grid[r, c]) for c in cols]
+        if len(colors) != len(set(colors)):
+            continue
