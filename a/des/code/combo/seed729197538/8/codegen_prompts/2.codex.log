+        return None
+    body_color = int(body[0, 0])
+    if body_color in (bg, marker_color):
+        return None
+    if not bool((body == body_color).all()):
+        return None
+
+    return {
+        "marker_color": marker_color,
+        "body_color": body_color,
+        "body_height": int(body.shape[0]),
+    }
