+def _get_bg(grid: np.ndarray) -> int:
+    counts = Counter(map(int, grid.reshape(-1)))
+    bg, bg_count = counts.most_common(1)[0]
+    assert sum(1 for count in counts.values() if count == bg_count) == 1
+    return int(bg)
