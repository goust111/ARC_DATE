+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+INNER_SHAPES = tuple((h, w) for h in range(3, 8) for w in range(3, 8))
