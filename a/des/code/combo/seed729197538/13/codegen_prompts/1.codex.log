+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+
+    rr0 = max(0, r0 - 1)
+    rr1 = min(height, r0 + outer_h + 1)
+    cc0 = max(0, c0 - 1)
+    cc1 = min(width, c0 + outer_w + 1)
+    mask[rr0:rr1, cc0:cc1] = True
