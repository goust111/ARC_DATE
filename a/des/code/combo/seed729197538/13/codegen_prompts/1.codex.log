+    c1 = c0 + inner_w + 1
+
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+
+    marker_r, marker_c = _marker_cell(r0, c0, inner_h, inner_w, side, offset)
+    grid[marker_r, marker_c] = int(color)
+
