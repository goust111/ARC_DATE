+    grid: np.ndarray,
+    reserved: np.ndarray,
+    color: int,
+    side: str,
+    want_full: bool,
+    used_areas: set[int],
+) -> dict[str, object] | None:
+    height, width = grid.shape
+    shapes = [shape for shape in INNER_SHAPES if shape[0] * shape[1] not in used_areas]
+    rng.shuffle(shapes)
