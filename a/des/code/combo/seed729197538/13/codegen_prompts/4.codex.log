+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    gap = _gap_for_room(r0, c0, h, w, direction_name)
+    grid[gap] = BLACK
+    for r, c in dots:
+        grid[r, c] = color
