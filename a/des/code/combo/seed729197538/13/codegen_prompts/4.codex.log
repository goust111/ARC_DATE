+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        if np.any(interior != BLACK):
+            return False
+        if int(out[room["gap"]]) != BLACK:
+            return False
+        for cell in _arrow_cells(room["gap"], room["direction"], room["count"]):
+            if not _in_bounds(grid.shape, cell):
+                return False
