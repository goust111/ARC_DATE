+    occupied = np.zeros((h, w), dtype=bool)
+    placed = 0
+
+    while placed < room_count:
+        done = False
+        for _ in range(ROOM_PLACEMENT_TRIES):
+            room_h = rng.choice(ROOM_HEIGHTS)
