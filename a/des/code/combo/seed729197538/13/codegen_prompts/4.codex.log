+    tip = (gap[0] + dr * (length + 1), gap[1] + dc * (length + 1))
+    pdr, pdc = -dc, dr
+    wings = [
+        (shaft_end[0] + pdr, shaft_end[1] + pdc),
+        (shaft_end[0] - pdr, shaft_end[1] - pdc),
+    ]
+    return cells + [tip] + wings
