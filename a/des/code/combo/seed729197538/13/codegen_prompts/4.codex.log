+def _arrow_cells(gap: tuple[int, int], direction: tuple[int, int], length: int) -> list[tuple[int, int]]:
+    dr, dc = direction
+    cells = [(gap[0] + dr * step, gap[1] + dc * step) for step in range(1, length + 1)]
