+    rng.shuffle(cells)
+    chosen: list[tuple[int, int]] = []
+    for cell in cells:
+        if all(abs(cell[0] - rr) + abs(cell[1] - cc) != 1 for rr, cc in chosen):
+            chosen.append(cell)
+            if len(chosen) == count:
