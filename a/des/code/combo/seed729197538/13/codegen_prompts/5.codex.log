+        shape = _normalize(cells)
+        h, w = _shape_hw(shape)
+        if max(h, w) > MAX_SHAPE_DIM:
+            continue
+        if len({r for r, _ in shape}) == 1 and len({c for _, c in shape}) == 1:
+            continue
