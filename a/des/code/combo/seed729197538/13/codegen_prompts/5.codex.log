+    if flip_lr:
+        _h, w = _shape_hw(pts)
+        pts = tuple((r, w - 1 - c) for r, c in pts)
+        pts = _normalize(pts)
+    for _ in range(rot_k % 4):
+        h, _w = _shape_hw(pts)
+        pts = tuple((c, h - 1 - r) for r, c in pts)
+        pts = _normalize(pts)
+    return _normalize(pts)
+
+
+def _all_variants(shape: tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
+    seen = set()
