+    variants_b = _all_variants(shape_b)
+    for _ in range(MAX_PAIR_ATTEMPTS):
+        coords_a = _random_placement(
+            variants_a[int(_RNG.integers(len(variants_a)))], box_a
+        )
+        if coords_a is None:
+            continue
+        reflected_a = _reflect_coords(coords_a, center_r, center_c)
