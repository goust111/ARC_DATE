+            continue
+        return _all_variants(shape)[int(_RNG.integers(len(_all_variants(shape))))]
+    return None
+
+
+def _quadrant_boxes(h: int, w: int) -> dict[str, tuple[int, int, int, int]]:
+    cr, cc = h // 2, w // 2
