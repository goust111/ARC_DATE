+def _normalize(coords) -> tuple[tuple[int, int], ...]:
+    pts = np.array(list(coords), dtype=int)
+    r0, c0 = pts.min(axis=0)
+    pts[:, 0] -= r0
+    pts[:, 1] -= c0
+    return tuple(sorted((int(r), int(c)) for r, c in pts))
