+    if pair_a is None:
+        return None
+    pair_b = _place_pair(
+        shapes[1],
+        shapes[2],
+        boxes["TR"],
+        boxes["BL"],
+        center_r,
+        center_c,
+        want_overlap_b,
+    )
+    if pair_b is None:
+        return None
+
+    grid = np.full((h, w), BG_COLOR, dtype=int)
+    corner_values = list(_RNG.choice(CORNER_COLOR_POOL, size=4, replace=False))
+    corner_colors = {
+        "TL": int(corner_values[0]),
+        "TR": int(corner_values[1]),
+        "BL": int(corner_values[2]),
+        "BR": int(corner_values[3]),
