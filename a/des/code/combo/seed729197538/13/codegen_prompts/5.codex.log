+
+def _point_quadrant(r: int, c: int, center_r: int, center_c: int) -> str:
+    if r < center_r and c < center_c:
+        return "TL"
+    if r < center_r and c > center_c:
+        return "TR"
+    if r > center_r and c < center_c:
+        return "BL"
+    if r > center_r and c > center_c:
+        return "BR"
+    raise AssertionError("point lies on a center axis")
