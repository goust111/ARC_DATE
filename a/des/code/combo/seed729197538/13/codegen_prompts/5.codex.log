+        cells = {(0, 0)}
+        while len(cells) < target_area:
+            frontier = []
+            for r, c in cells:
+                for dr, dc in _DIRS4:
+                    nxt = (r + dr, c + dc)
+                    if nxt not in cells:
+                        frontier.append(nxt)
+            cells.add(frontier[int(_RNG.integers(len(frontier)))])
