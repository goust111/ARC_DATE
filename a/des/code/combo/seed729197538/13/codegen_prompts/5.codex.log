+
+    other_colors = set(map(int, np.unique(g[outside_center]))) - {bg}
+    assert len(other_colors) == 1
+    object_color = next(iter(other_colors))
+    assert np.all((g[outside_center] == bg) | (g[outside_center] == object_color))
