+    rmin, rmax, cmin, cmax = box
+    if rmax - rmin + 1 < h or cmax - cmin + 1 < w:
+        return None
+    top = int(_RNG.integers(rmin, rmax - h + 2))
+    left = int(_RNG.integers(cmin, cmax - w + 2))
