+        "TL": (1, cr - 3, 1, cc - 3),
+        "TR": (1, cr - 3, cc + 3, w - 2),
+        "BL": (cr + 3, h - 2, 1, cc - 3),
+        "BR": (cr + 3, h - 2, cc + 3, w - 2),
