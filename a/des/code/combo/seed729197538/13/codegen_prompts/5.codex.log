+    center_r, center_c = h // 2, w // 2
+    patch = g[center_r - 1 : center_r + 2, center_c - 1 : center_c + 2]
+    assert patch.shape == (3, 3)
+
+    guide = int(patch[1, 1])
+    for rr, cc in ((0, 1), (1, 0), (1, 2), (2, 1)):
+        assert int(patch[rr, cc]) == guide
