+
+
+def _extract_layout(
+    grid: np.ndarray,
+) -> tuple[int, int, int, dict[str, int], int, list[list[tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h % 2 == 1 and w % 2 == 1 and h >= 7 and w >= 7
