+def _place_pair(
+    shape_a: tuple[tuple[int, int], ...],
+    shape_b: tuple[tuple[int, int], ...],
+    box_a: tuple[int, int, int, int],
+    box_b: tuple[int, int, int, int],
+    center_r: int,
+    center_c: int,
+    want_overlap: bool,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
