+    for r, c in object_pixels:
+        rr = 2 * center_r - int(r)
+        cc = 2 * center_c - int(c)
+        quad = _point_quadrant(rr, cc, center_r, center_c)
+        out[rr, cc] = corner_colors[quad]
+    return out
+
