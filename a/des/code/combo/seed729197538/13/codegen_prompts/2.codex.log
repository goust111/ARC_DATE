+def _separator_row(g: np.ndarray) -> int:
+    h = g.shape[0]
+    candidates = []
+    for r in range(1, h - 1):
+        if int(g[r, 0]) == BG:
+            continue
+        if np.all(g[r] == g[r, 0]) and np.any(g[r - 1] != BG) and np.any(g[r + 1 :] != BG):
