+        rr1 = r1 - 1
+        cc0 = c0 + 1
+        cc1 = c1 - 1
+        if rr1 - rr0 >= 6 and cc1 - cc0 >= 6:
+            regions.append((rr0, rr1, cc0, cc1))
+        else:
+            regions.append((r0, r1, c0, c1))
