+def _piece_patch(piece: set[tuple[int, int]], color: int) -> np.ndarray:
+    rows = [r for r, _ in piece]
+    cols = [c for _, c in piece]
+    r0, c0 = min(rows), min(cols)
+    h = max(rows) - r0 + 1
+    w = max(cols) - c0 + 1
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in piece:
