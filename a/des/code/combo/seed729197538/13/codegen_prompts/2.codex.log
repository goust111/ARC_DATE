+def _component_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    stack = [next(iter(cells))]
+    seen = set(stack)
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(cells)
