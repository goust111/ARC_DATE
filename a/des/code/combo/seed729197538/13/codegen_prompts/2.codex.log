+def _can_place_patch(occupied: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    ph, pw = patch.shape
+    oh, ow = occupied.shape
+    if top < 0 or left < 0 or top + ph > oh or left + pw > ow:
+        return False
+    mask = _patch_mask(patch)
+    for r, c in np.argwhere(mask):
