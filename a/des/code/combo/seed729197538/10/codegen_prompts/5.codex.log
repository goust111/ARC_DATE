+def _render_expected(
+    inp: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    points: list[tuple[int, int]],
+    arms_by_point: list[dict[str, int]],
+) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
