+            if not mask[r, c]:
+                continue
+            if mask[r - 1, c] and mask[r + 1, c] and mask[r, c - 1] and mask[r, c + 1]:
+                inside.append((r, c))
+    return inside
+
+
+def _sample_template(min_interior: int) -> tuple[np.ndarray, list[tuple[int, int]]] | None:
+    for _ in range(TEMPLATE_ATTEMPTS):
