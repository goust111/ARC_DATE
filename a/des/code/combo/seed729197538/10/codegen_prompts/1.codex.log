+
+
+def _path_points(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc = start
+    tr, tc = end
+    points: list[tuple[int, int]] = []
+
+    if sc <= tc:
+        for c in range(sc, tc + 1):
+            points.append((sr, c))
+    else:
+        for c in range(sc, tc - 1, -1):
+            points.append((sr, c))
+
+    if sr < tr:
+        for r in range(sr + 1, tr + 1):
+            points.append((r, tc))
+    elif sr > tr:
+        for r in range(sr - 1, tr - 1, -1):
+            points.append((r, tc))
