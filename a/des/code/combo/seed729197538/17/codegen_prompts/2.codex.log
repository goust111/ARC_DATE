+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+GEN_ATTEMPTS = 400
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(points)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _size_from_bbox(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _is_full_rectangle(points: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(points)
+    return len(points) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _overlap_with_pad(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + pad < br0 - pad
+        or br1 + pad < ar0 - pad
+        or ac1 + pad < bc0 - pad
+        or bc1 + pad < ac0 - pad
+    )
+
+
+def _paint_ring(
+    grid: np.ndarray, bbox: tuple[int, int, int, int], color: int, black_only: bool = True
+) -> None:
+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox
+    for r in range(r0 - 1, r1 + 2):
+        for c in range(c0 - 1, c1 + 2):
+            if not (0 <= r < h and 0 <= c < w):
+                continue
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
+            if black_only and int(grid[r, c]) != BG:
+                continue
+            grid[r, c] = color
+
+
+def _infer_tile(region: np.ndarray) -> np.ndarray:
+    h, w = region.shape
+    visible = [
+        (r, c, int(region[r, c]))
+        for r in range(h)
+        for c in range(w)
+        if int(region[r, c]) != GREY
+    ]
+    best_key: tuple[int, int, int] | None = None
+    best_tile: np.ndarray | None = None
+    for ph in range(1, h + 1):
+        for pw in range(1, w + 1):
+            key = (ph * pw, ph, pw)
+            if best_key is not None and key >= best_key:
+                continue
+            tile = np.full((ph, pw), -1, dtype=int)
+            ok = True
+            for r, c, value in visible:
+                rr = r % ph
+                cc = c % pw
+                cur = int(tile[rr, cc])
+                if cur == -1:
