+
+def _axis_period(arr: np.ndarray, axis: int) -> int:
+    size = arr.shape[axis]
+    for period in range(1, size + 1):
+        if size % period != 0:
+            continue
+        if axis == 0:
+            base = arr[:period, :]
+            tiled = np.tile(base, (size // period, 1))
+        else:
+            base = arr[:, :period]
+            tiled = np.tile(base, (1, size // period))
+        if np.array_equal(arr, tiled):
+            return period
+    return size
+
