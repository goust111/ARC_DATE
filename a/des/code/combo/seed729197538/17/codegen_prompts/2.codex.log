+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Restore grey occlusions in a periodic texture and mark each restored block
+    with the color of the uniquely size-matched external fragment.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
