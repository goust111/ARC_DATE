+        lr0, lc0, lr1, lc1 = _bbox(occ)
+        h_occ, w_occ = _size_from_bbox((lr0, lc0, lr1, lc1))
+        key = (h_occ, w_occ)
+        assert key in fragments, "every occlusion must have a unique size-matched fragment"
+        color = int(fragments[key]["color"])
