+            used_sizes.add(size)
+            placed = True
+            break
+        if not placed:
+            return None
+    return occs
+
+
+def _place_fragment_bbox(
+    rng: random.Random,
+    canvas_shape: tuple[int, int],
+    texture_bbox: tuple[int, int, int, int],
+    occ: dict[str, object],
+    existing: list[tuple[int, int, int, int]],
+) -> tuple[int, int, int, int] | None:
+    h, w = canvas_shape
+    tr0, tc0, tr1, tc1 = texture_bbox
+    lr0, lc0, lr1, lc1 = occ["bbox"]
+    side = str(occ["side"])
+    fh, fw = occ["size"]
+    gr0, gc0 = tr0 + lr0, tc0 + lc0
+
+    for _ in range(200):
+        if side == "top":
+            max_r0 = tr0 - fh - 1
+            if max_r0 < 0:
+                return None
+            r0 = rng.randint(0, max_r0)
+            c0 = gc0
+        elif side == "bottom":
+            min_r0 = tr1 + 2
+            max_r0 = h - fh
+            if min_r0 > max_r0:
+                return None
+            r0 = rng.randint(min_r0, max_r0)
+            c0 = gc0
+        elif side == "left":
+            max_c0 = tc0 - fw - 1
+            if max_c0 < 0:
+                return None
+            r0 = gr0
+            c0 = rng.randint(0, max_c0)
+        else:
+            min_c0 = tc1 + 2
+            max_c0 = w - fw
+            if min_c0 > max_c0:
+                return None
+            r0 = gr0
+            c0 = rng.randint(min_c0, max_c0)
+
+        bbox = (r0, c0, r0 + fh - 1, c0 + fw - 1)
+        if _overlap_with_pad(bbox, texture_bbox, pad=1):
+            continue
+        if any(_overlap_with_pad(bbox, other, pad=1) for other in existing):
+            continue
+        return bbox
+    return None
+
