+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+WHITE = 8
+GATE_COLORS = (1, 2, 3, 4, 6, 7, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+START_PORTS = (
+    (-1, 0),
+    (-1, 1),
+    (2, 0),
+    (2, 1),
+    (0, -1),
+    (1, -1),
+    (0, 2),
+    (1, 2),
+)
+PAIR_OPTIONS = (
+    (1, 1),
+    (1, 2),
+    (1, 3),
+    (2, 1),
+    (2, 2),
+    (2, 3),
+    (3, 1),
+    (3, 2),
+    (3, 3),
+)
+GEN_RETRIES = 300
+ITEM_RETRIES = 200
+ROUTE_RETRIES = 80
