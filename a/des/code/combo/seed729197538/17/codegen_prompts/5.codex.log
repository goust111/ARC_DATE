+def _bfs_path(
+    free: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    if not free[start] or not free[goal]:
+        return None
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        nbrs = list(_neighbors(free.shape, cur[0], cur[1]))
+        rng.shuffle(nbrs)
+        nbrs.sort(key=lambda rc: abs(rc[0] - goal[0]) + abs(rc[1] - goal[1]))
+        for nb in nbrs:
+            if free[nb] and nb not in parent:
+                parent[nb] = cur
+                q.append(nb)
+    if goal not in parent:
+        return None
+    path = []
+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
