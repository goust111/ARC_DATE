+def _sample_spaced_indices(length: int, count: int, rng: random.Random) -> list[int] | None:
+    inner = list(range(1, length - 1))
+    for _ in range(30):
+        chosen = sorted(rng.sample(inner, count))
+        if all(b - a >= 2 for a, b in zip(chosen, chosen[1:])):
+            return chosen
+    return None
