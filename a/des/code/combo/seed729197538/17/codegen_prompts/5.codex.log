+
+def _reachable_without_edge(
+    adj: dict[tuple[int, int], list[tuple[int, int]]],
+    start: tuple[int, int],
+    edge: tuple[tuple[int, int], tuple[int, int]],
+) -> set[tuple[int, int]]:
+    u, v = edge
+    q = deque([start])
+    seen = {start}
+    while q:
+        cur = q.popleft()
+        for nb in adj[cur]:
+            if (cur == u and nb == v) or (cur == v and nb == u):
+                continue
+            if nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return seen
