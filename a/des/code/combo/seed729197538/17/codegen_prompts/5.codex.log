+def _adjacency(cells: set[tuple[int, int]]) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for cell in cells:
+        r, c = cell
+        adj[cell] = [nb for nb in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)) if nb in cells]
+    return adj
