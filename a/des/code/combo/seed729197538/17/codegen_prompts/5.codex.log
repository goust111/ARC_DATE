+def _neighbors(shape: tuple[int, int], r: int, c: int):
+    h, w = shape
+    for dr, dc in DIR4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
