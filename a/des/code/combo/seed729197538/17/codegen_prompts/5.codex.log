+    q = deque([start])
+    seen = {start}
+    while q:
+        cur = q.popleft()
+        for nb in adj[cur]:
+            if (cur == u and nb == v) or (cur == v and nb == u):
+                continue
+            if nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return seen
