+import numpy as np
+
+
+BLACK = 0
+DEPTH_COLORS = {1: 1, 2: 2, 3: 3, 4: 4}
+FRAME_COLOR_POOL = (5, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+@dataclass(frozen=True)
+class Frame:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    side: str
+    gap_cells: tuple[tuple[int, int], ...]
+    pixels: tuple[tuple[int, int], ...]
