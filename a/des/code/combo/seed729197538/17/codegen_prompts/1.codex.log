+def _boundary_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c1))
+    if r1 > r0:
+        for c in range(c1, c0 - 1, -1):
+            cells.append((r1, c))
+    if c1 > c0:
+        for r in range(r1 - 1, r0, -1):
+            cells.append((r, c0))
+    return cells
