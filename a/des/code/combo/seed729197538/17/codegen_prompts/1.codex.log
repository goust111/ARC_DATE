+    out = np.zeros_like(g)
+    for frame in frames:
+        color = DEPTH_COLORS[depths[frame]]
+        for r, c in frame.pixels:
+            out[r, c] = color
+
+    for frame in frames:
+        color = DEPTH_COLORS[depths[frame]]
+        for r, c in _trace_band(frame, occupied):
+            out[r, c] = color
+
+    return out
