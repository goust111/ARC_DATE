+def _frame_occupancy(shape: tuple[int, int], frames: list[Frame]) -> np.ndarray:
+    occ = np.zeros(shape, dtype=bool)
+    for frame in frames:
+        for r, c in frame.pixels:
+            occ[r, c] = True
+    return occ
+
