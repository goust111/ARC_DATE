+    current = outer_box
+    for level in range(2, depth + 1):
+        remaining_after = depth - level
+        min_h = _root_min_side(remaining_after + 1)
+        min_w = _root_min_side(remaining_after + 1)
+
+        r0, c0, r1, c1 = current
+        cur_h = r1 - r0 + 1
+        cur_w = c1 - c0 + 1
+
+        max_top = cur_h - min_h - 2
+        max_left = cur_w - min_w - 2
