+def _trace_band(frame: Frame, occupied: np.ndarray) -> list[tuple[int, int]]:
+    h, w = occupied.shape
+    dr, dc = SIDE_TO_DIR[frame.side]
+    cells: list[tuple[int, int]] = []
+    for r, c in frame.gap_cells:
+        rr, cc = r, c
+        while 0 <= rr < h and 0 <= cc < w and not occupied[rr, cc]:
+            cells.append((rr, cc))
+            rr += dr
+            cc += dc
+    return cells
