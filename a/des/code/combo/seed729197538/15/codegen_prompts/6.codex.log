+
+    pair_orbits = _colored_pair_orbits(output_inner, symmetry)
+    if len(pair_orbits) < 6:
+        return None
+
+    input_inner = output_inner.copy()
+    for a, b in random.sample(pair_orbits, random.randint(3, 6)):
+        r, c = random.choice((a, b))
