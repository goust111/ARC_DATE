+    tr = int(grid[0, -1])
+    bl = int(grid[-1, 0])
+    br = int(grid[-1, -1])
+
+    if tl == tr and bl == br and tl != bl:
+        return "horizontal"
+    if tl == bl and tr == br and tl != tr:
+        return "vertical"
+    if tl == br and tr == bl and tl != tr:
+        return "rotate180"
+    raise AssertionError("unrecognized corner code")
