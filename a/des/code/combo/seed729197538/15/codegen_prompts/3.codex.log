+def _translation_invariant(mask: np.ndarray) -> bool:
+    for dr in range(LEGEND_SIZE):
+        for dc in range(LEGEND_SIZE):
+            if dr == 0 and dc == 0:
+                continue
+            if np.array_equal(mask, np.roll(mask, shift=(dr, dc), axis=(0, 1))):
+                return True
+    return False
+
