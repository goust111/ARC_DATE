+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = int(r) + dr
+                nc = int(c) + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
+    return out
+
