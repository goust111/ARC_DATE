    pw = c1 - c0 + 1
    min_side = 4 * remaining_depth - 1
    child_h = rng.randint(min_side, ph - 4)
    child_w = rng.randint(min_side, pw - 4)

    shrink_h = ph - child_h
    shrink_w = pw - child_w

