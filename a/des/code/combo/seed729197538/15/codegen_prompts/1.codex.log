+            return None
+        placed.append((index, bbox))
+        occupied.append(bbox)
+
+    result = [None] * len(depths)
+    for index, bbox in placed:
+        result[index] = bbox
+    return result
+
+
+def _child_bbox(parent: tuple[int, int, int, int], remaining_depth: int, rng: random.Random) -> tuple[int, int, int, int]:
