ARM_LENGTH_RANGE = (1, 5)         # arm extension length (arms style)
FRAME_DIST_RANGE = (3, 4)        # outer frame distance from center
FRAME_CONNECT_PROB = 0.4          # chance of connecting inner ring to outer frame
