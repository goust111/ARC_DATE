    return hp, wp


def _has_overlap_width_budget(avail_w: int, plain_w: int) -> bool:
    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP
    max_overlap_w = remaining_w // OVERLAP_MARKED_COUNT
