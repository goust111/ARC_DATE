+# associated with the missing corner under this fixed cyclic mapping.
+KEY_PATTERNS = {
+    "up": ((0, 0), (1, 0), (1, 1)),
+    "right": ((0, 0), (0, 1), (1, 0)),
+    "down": ((0, 0), (0, 1), (1, 1)),
+    "left": ((0, 1), (1, 0), (1, 1)),
