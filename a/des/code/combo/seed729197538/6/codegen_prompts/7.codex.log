+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _line_status(line: np.ndarray, color: int) -> str:
+    missing = [idx for idx, value in enumerate(line) if int(value) == BG]
+    if not missing:
+        return "solid" if all(int(value) == color for value in line) else "bad"
+    if len(missing) != 2 or missing[1] != missing[0] + 1:
+        return "bad"
+    if missing[0] == 0 or missing[1] == len(line) - 1:
+        return "bad"
+    for idx, value in enumerate(line):
+        if idx in missing:
+            continue
+        if int(value) != color:
+            return "bad"
+    return "gap"
+
