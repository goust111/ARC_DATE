+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+
+    direction = _rng_choice(rng, ("up", "right", "down", "left"))
+    if active:
+        gap_side = direction
+    else:
+        gap_side = _rng_choice(rng, tuple(side for side in DIR_TO_DELTA if side != direction))
