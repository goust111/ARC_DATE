+        span = frame["inner_h"] if direction in ("up", "down") else frame["inner_w"]
+        dr, dc = DIR_TO_DELTA[direction]
+        shift_r = dr * span
+        shift_c = dc * span
+        contents = _interior_pixels(g, frame["bbox"])
