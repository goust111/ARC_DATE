+def _render_grid(h: int, w: int, specs: list[dict]) -> tuple[np.ndarray, list[dict]]:
+    grid = np.zeros((h, w), dtype=int)
+    meta: list[dict] = []
+    for spec in specs:
+        patch = spec["patch"]
+        top = int(spec["top"])
+        left = int(spec["left"])
+        ph, pw = patch.shape
+        region = grid[top : top + ph, left : left + pw]
+        mask = patch != BG
+        region[mask] = patch[mask]
