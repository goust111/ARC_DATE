+def _frame_from_component(grid: np.ndarray, coords: list[tuple[int, int]], color: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+    if len(coords) != 2 * (h + w) - 6:
+        return None
+    for r, c in coords:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return None
