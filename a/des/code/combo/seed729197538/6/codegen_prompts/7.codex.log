+        out[r0 + 1 : r1, c0 + 1 : c1] = BG
+        for r, c, color in contents:
+            nr = r + shift_r
+            nc = c + shift_c
+            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]:
