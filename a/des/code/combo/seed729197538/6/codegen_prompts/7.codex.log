+    return {
+        "frame_color": int(frame_color),
+        "direction": direction,
+        "gap_side": gap_side,
+        "active": bool(active),
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "patch": patch,
+        "reserve": reserve,
+        "contents_local": contents_local,
