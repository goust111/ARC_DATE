+    for border in draw_order:
+        rect = next(rect for rect in rects if rect.border == border)
+        _draw_rect(grid, rect)
+    for (r, c), color in zip(_legend_positions(h, w, len(legend_colors), corner, horizontal), legend_colors):
+        grid[r, c] = color
