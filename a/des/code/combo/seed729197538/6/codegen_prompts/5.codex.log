+        except AssertionError:
+            continue
+        if inferred_legend != legend_colors:
+            continue
+        if not _rects_match_by_border(rects, inferred):
+            continue
+        if not np.array_equal(main(inp), expected):
+            continue
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GENERATION_RETRIES):
