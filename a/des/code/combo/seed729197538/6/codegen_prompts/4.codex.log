+SIDES = ("top", "bottom", "left", "right")
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _neighbors4(r: int, c: int, height: int, width: int):
+    for dr, dc in DIR4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < height and 0 <= cc < width:
+            yield rr, cc
