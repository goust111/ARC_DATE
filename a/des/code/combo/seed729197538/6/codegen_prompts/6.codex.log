+        for _ in range(RECT_PLACEMENT_RETRIES):
+            if rect_h > height - 2 or rect_w > width - 2:
+                break
+            r0 = random.randint(1, height - rect_h - 1)
+            c0 = random.randint(1, width - rect_w - 1)
