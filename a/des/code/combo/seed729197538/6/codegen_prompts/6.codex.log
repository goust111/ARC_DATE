+        if orientation == "horizontal":
+            if sc < c0:
+                out[sr, sc + 1 : c0] = color
+            else:
+                out[sr, c1 + 1 : sc] = color
+            out[sr, c0 : c1 + 1] = color
+        else:
+            if sr < r0:
+                out[sr + 1 : r0, sc] = color
+            else:
+                out[r1 + 1 : sr, sc] = color
+            out[r0 : r1 + 1, sc] = color
