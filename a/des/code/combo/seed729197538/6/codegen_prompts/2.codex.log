+def _scan_left_bg(grid: np.ndarray, r: int, c: int) -> list[int]:
+    cols = []
+    cur = c
+    while cur >= 0 and int(grid[r, cur]) == BG:
+        cols.append(cur)
+        cur -= 1
+    return cols
+
+
+def _scan_right_bg(grid: np.ndarray, r: int, c: int) -> list[int]:
+    cols = []
+    cur = c
+    width = grid.shape[1]
+    while cur < width and int(grid[r, cur]) == BG:
+        cols.append(cur)
+        cur += 1
+    return cols
