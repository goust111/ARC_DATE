+
+    planned = _plan_pairs(base_grid, rects)
+    if planned is None:
+        return None
+    inp, pairs = planned
+    expected = _expected_output(inp, pairs)
+
+    if np.array_equal(inp, expected):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
