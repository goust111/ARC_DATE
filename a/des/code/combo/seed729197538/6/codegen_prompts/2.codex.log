+def _boxes_with_gap(a: Rectangle, b: Rectangle, gap: int) -> bool:
+    return (
+        a.r1 + gap < b.r0
+        or b.r1 + gap < a.r0
+        or a.c1 + gap < b.c0
+        or b.c1 + gap < a.c0
+    )
