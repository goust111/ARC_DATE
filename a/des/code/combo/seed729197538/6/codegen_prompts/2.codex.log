+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+RECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+
+@dataclass(frozen=True)
+class Rectangle:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    color: int
