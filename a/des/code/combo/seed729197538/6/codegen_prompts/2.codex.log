+    choices: list[str] = []
+    weights: list[int] = []
+    if h_cap > 0:
+        choices.append("h")
+        weights.append(3)
+    if v_cap > 0:
+        choices.append("v")
+        weights.append(3)
+    if h_cap > 0 and v_cap > 0:
+        choices.append("mixed")
+        weights.append(4)
+    if not choices:
+        return None
+    return random.choices(choices, weights=weights, k=1)[0]
