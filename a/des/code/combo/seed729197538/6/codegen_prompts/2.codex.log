+GRID_H_RANGE = (12, 23)
+GRID_W_RANGE = (12, 23)
+RECT_COUNT_CHOICES = (1, 2, 3, 4)
+RECT_COUNT_WEIGHTS = (2, 4, 4, 2)
+RECT_H_RANGE = (2, 5)
+RECT_W_RANGE = (2, 6)
