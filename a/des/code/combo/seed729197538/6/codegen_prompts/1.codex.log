+                min(frame_bbox[1], sprite_bbox[1], dest_bbox[1]),
+                max(frame_bbox[2], sprite_bbox[2], dest_bbox[2]),
+                max(frame_bbox[3], sprite_bbox[3], dest_bbox[3]),
+            )
+            padded = _padded_rect(union_bbox, 2, (h, w))
