SHORT_SIDE_MIN = 1
SHORT_SIDE_MAX = 3
SIDE_SUM_MAX = 10
LONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN

# Canvas and packing constraints.
ARC_GRID_MAX = 30
OUTPUT_HEIGHT = 10
GAP_WIDTH = 1

# Retry policy.
