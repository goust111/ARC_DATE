+def _gen_attempt() -> np.ndarray | None:
+    family = random.choice(("h_strip", "v_strip", "h_table", "v_table"))
+    if family == "h_strip":
+        row_heights = [random.choice((4, 6))]
+        col_widths = [random.randint(3, 5) for _ in range(random.randint(2, 4))]
+    elif family == "v_strip":
