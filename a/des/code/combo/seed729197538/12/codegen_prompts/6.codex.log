+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "windows": windows,
+                "pillars": pillars,
+            }
+        )
+
+    rooms.sort(key=lambda room: (room["r0"], room["c0"]))
+    return rooms
