+def _beam_distance(beam: dict, room: dict, r: int, c: int) -> int | None:
+    side = beam["side"]
+    if side == "top":
+        if r >= beam["limit"]:
+            return None
+        return int(r - (room["r0"] - 1))
+    if side == "bottom":
+        if r <= beam["limit"]:
+            return None
+        return int((room["r1"] + 1) - r)
+    if side == "left":
+        if c >= beam["limit"]:
+            return None
+        return int(c - (room["c0"] - 1))
+    if c <= beam["limit"]:
+        return None
+    return int((room["c1"] + 1) - c)
