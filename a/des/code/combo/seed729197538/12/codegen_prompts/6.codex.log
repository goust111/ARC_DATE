+        col_widths = [random.choice((4, 6))]
+    elif family == "h_table":
+        row_heights = [random.randint(3, 5) for _ in range(2)]
+        col_widths = [random.randint(3, 5) for _ in range(random.randint(2, 4))]
+    else:
