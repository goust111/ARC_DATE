    inner_h = 2 * int(max_regions) - 1
    inner_w = 2 * int(max_regions) + 2
    patch = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
    patch[0, :] = GRAY
    patch[-1, :] = GRAY
    patch[:, 0] = GRAY
    patch[:, -1] = GRAY

