+            else:
+                index = (r + c) % len(bg_colors)
+            grid[r, c] = int(bg_colors[index])
+    return grid
+
+
+def _transform_offsets(offsets: tuple[Coord, ...]) -> tuple[Coord, ...]:
+    pts = list(offsets)
+    if random.choice((False, True)):
