+        dcs = [dc for _dr, dc in offsets]
+        r_lo, r_hi = -min(drs), h - 1 - max(drs)
+        c_lo, c_hi = -min(dcs), w - 1 - max(dcs)
+        if r_lo > r_hi or c_lo > c_hi:
+            continue
+
