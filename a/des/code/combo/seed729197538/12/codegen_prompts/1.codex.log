+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+LOCK = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            parts.append(coords)
+    return parts
+
+
+def _bbox(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    r0, c0, _, _ = _bbox(cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
+
+
+def _border_coords(h: int, w: int) -> set[tuple[int, int]]:
+    border = set()
+    for c in range(w):
+        border.add((0, c))
+        border.add((h - 1, c))
+    for r in range(h):
+        border.add((r, 0))
+        border.add((r, w - 1))
+    return border
+
+
+def _enclosed_bg(local: np.ndarray) -> list[tuple[int, int]]:
+    h, w = local.shape
+    bg_mask = local == BG
+    seen = np.zeros((h, w), dtype=bool)
+    queue = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(bg_mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(bg_mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(bg_mask[nr, nc]) and not bool(seen[nr, nc]):
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+
+    cavity = [(r, c) for r in range(h) for c in range(w) if bool(bg_mask[r, c]) and not bool(seen[r, c])]
+    return cavity
+
+
