+    sig_to_lock: dict[tuple[tuple[int, int], ...], int] = {}
+    for i, lock in enumerate(locks):
+        sig = lock["sig"]
+        assert sig not in sig_to_lock, "lock notch shapes must be unique"
+        sig_to_lock[sig] = i
+
+    keys = _extract_keys(g, sig_to_lock)
+
+    out = np.array(g, copy=True)
