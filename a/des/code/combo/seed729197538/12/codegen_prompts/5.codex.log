+def _weighted_choice_index(weights: list[float], rng) -> int:
+    total = sum(weights)
+    pick = rng.random() * total
+    acc = 0.0
+    for idx, weight in enumerate(weights):
+        acc += weight
+        if pick <= acc:
+            return idx
+    return len(weights) - 1
