+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLOR = 5
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
