+    try:
+        solved = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    if np.array_equal(grid, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(random)
+        if grid is not None:
