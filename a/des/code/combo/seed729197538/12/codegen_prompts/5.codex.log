+                "anchor": anchor_id,
+                "major": major,
+                "minor": minor,
+                "adjacent": adjacent,
+            }
+        )
+        single_region_colors[anchor_id] = major
+        result_colors[region_id] = minor if adjacent else major
+        result_colors[anchor_id] = major
