+    anchors = rng.sample(remaining, dup_count)
+
+    colors = PIECE_COLORS[:]
+    rng.shuffle(colors)
+    single_region_colors: dict[int, int] = {}
+    result_colors: dict[int, int] = {}
+    pair_infos = []
