+            cursor = 1
+            for piece in pieces_sorted:
+                mask = piece["mask"]
+                ph, pw = mask.shape
+                assert ph <= channel_height
+                rr = start + (channel_height - ph) // 2
+                cc = cursor
+                assert cc + pw <= w - 1
+                target = out[rr : rr + ph, cc : cc + pw]
