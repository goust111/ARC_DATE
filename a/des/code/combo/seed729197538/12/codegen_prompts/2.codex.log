+    arr = [int(v) for v in line.tolist()]
+    runs: list[tuple[int, int, int]] = []
+    i = 0
+    while i < len(arr):
+        color = arr[i]
+        if color == BG:
+            i += 1
+            continue
+        j = i
+        while j + 1 < len(arr) and arr[j + 1] == color:
+            j += 1
+        runs.append((color, i, j))
+        i = j + 1
+    return runs
+
