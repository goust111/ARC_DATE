+    grid: np.ndarray,
+    occupied_boxes: list[tuple[int, int, int, int]],
+    color: int,
+    mask: np.ndarray,
+) -> bool:
+    h, w = grid.shape
+    sides = list(SIDES)
+    random.shuffle(sides)
