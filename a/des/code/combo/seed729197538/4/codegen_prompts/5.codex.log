+import random
+from collections import deque
+
+import numpy as np
+
+
+TOP_TEMPLATE_STRINGS = [
+    [
+        "101",
+        "111",
+    ],
+    [
+        "1001",
+        "1111",
+    ],
+    [
+        "101",
+        "111",
+        "011",
+    ],
+    [
+        "101",
+        "111",
+        "110",
+    ],
