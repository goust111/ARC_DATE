+def _is_rect_frame(coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if len(coords) != 2 * h + 2 * w - 4:
+        return False
+    coord_set = set(coords)
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
