+def _mapping_block_corner_score(h: int, w: int, r: int, c: int) -> int:
+    return min(
+        r + c,
+        r + (w - (c + 4)),
+        (h - (r + 3)) + c,
+        (h - (r + 3)) + (w - (c + 4)),
+    )
