+            frames.append({"r0": r0, "c0": c0, "r1": r1, "c1": c1})
+        score = (len(frames), sum((f["r1"] - f["r0"] + 1) * (f["c1"] - f["c0"] + 1) for f in frames))
+        if score > best_score:
+            best_score = score
