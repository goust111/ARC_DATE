+def _find_mapping_for_color(grid: np.ndarray, bg: int, frame_color: int, color: int) -> np.ndarray:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, np.ndarray]] = []
+    for r in range(h - 2):
