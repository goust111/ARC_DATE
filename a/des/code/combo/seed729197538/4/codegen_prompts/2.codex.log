+
+BG_COLOR = 0
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+GRID_SIDE_MIN = 16
+GRID_SIDE_MAX = 28
+PAIR_COUNT_RANGE = (1, 4)
+RECT_DIMS = tuple(
+    (rh, rw)
+    for rh in range(2, 6)
+    for rw in range(2, 6)
+    if 6 <= rh * rw <= 16 and max(rh, rw) >= 3
+)
+MIN_BORDER = 1
+PARTITION_RETRIES = 250
+GENERATION_RETRIES = 400
