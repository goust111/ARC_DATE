+
+BACKGROUND = 0
+LINE_COLOR = 5
+EVEN_LOCAL_COLORS = (1, 2)
+ODD_LOCAL_COLORS = (6, 7)
+SPY_COLORS = (3, 4, 8, 9)
+
+# --------------- generator config ---------------
+
+MIN_REGIONS_PER_AXIS = 2
+MAX_REGIONS_PER_AXIS = 4
+REGION_SIZE_MIN = 5
+REGION_SIZE_MAX = 8
+GRID_SIDE_MIN = 13
+GRID_SIDE_MAX = 32
+MAX_SPY_DEGREE = 2
+GENERATION_RETRIES = 400
