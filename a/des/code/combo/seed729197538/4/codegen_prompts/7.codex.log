+    runs: list[tuple[int, int]] = []
+    start = vals[0]
+    prev = vals[0]
+    for value in vals[1:]:
+        if value == prev + 1:
+            prev = value
+            continue
+        runs.append((start, prev))
+        start = value
+        prev = value
+    runs.append((start, prev))
+    return runs
