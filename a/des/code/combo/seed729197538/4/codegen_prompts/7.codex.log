+        out.append((r - 1, c))
+    if r + 1 < region_rows:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < region_cols:
+        out.append((r, c + 1))
+    return out
+
+
