+def _partition_total(total: int, parts: int, rng: random.Random) -> list[int]:
+    remaining = total
+    out: list[int] = []
+    for idx in range(parts - 1):
+        max_piece = remaining - 2 * (parts - idx - 1)
+        piece = rng.randint(2, max_piece)
+        out.append(piece)
+        remaining -= piece
