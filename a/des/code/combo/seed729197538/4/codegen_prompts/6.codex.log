+        fill_color = int(containers[dst]["inner_color"])
+        patch = out[r0 + 1 : r1, c0 + 1 : c1]
+        patch[src_mask] = fill_color
+
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(coords[0])}
+    stack = [tuple(coords[0])]
+    cells = {tuple(x) for x in coords.tolist()}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in _NEIGHBORS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(cells)
+
+
+def _looks_like_hollow_frame(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    want = np.zeros((h, w), dtype=bool)
+    want[0, :] = True
+    want[-1, :] = True
+    want[:, 0] = True
+    want[:, -1] = True
+    return np.array_equal(sub, want)
+
+
+def _grow_connected_mask(h: int, w: int, area: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    start = (rng.randrange(h), rng.randrange(w))
+    mask[start] = True
+    cells = {start}
+    frontier = set()
+    for dr, dc in _NEIGHBORS4:
+        nr, nc = start[0] + dr, start[1] + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            frontier.add((nr, nc))
+    while len(cells) < area and frontier:
+        cell = rng.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        mask[cell] = True
+        for dr, dc in _NEIGHBORS4:
+            nr, nc = cell[0] + dr, cell[1] + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                frontier.add((nr, nc))
+    return mask
+
+
+def _random_polyline_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    steps = rng.randint(2, max(2, min(h * w - 1, h + w + 1)))
+    r = rng.randrange(h)
+    c = rng.randrange(w)
+    mask[r, c] = True
+    for _ in range(steps - 1):
+        choices = []
+        for dr, dc in _NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
