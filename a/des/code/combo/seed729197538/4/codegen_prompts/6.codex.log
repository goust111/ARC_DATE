+def _random_polyline_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    steps = rng.randint(2, max(2, min(h * w - 1, h + w + 1)))
+    r = rng.randrange(h)
