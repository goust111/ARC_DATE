+        growth_mask = _orient_template(templates[seed_color], parsed["direction"])
+        top, left = _placement_for_growth(
+            bbox,
+            parsed["direction"],
+            parsed["gap_start"],
+            parsed["gap_end"],
+            growth_mask.shape,
+        )
+        _paste_mask(out, growth_mask, seed_color, int(top), int(left))
+
+    return out
+
