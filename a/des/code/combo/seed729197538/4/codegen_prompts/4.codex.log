+        return None
+    if missing[0] == 0 or missing[-1] == len(edge) - 1:
+        return None
+    if not np.all(np.diff(missing) == 1):
+        return None
+    if not np.all(edge[: missing[0]]) or not np.all(edge[missing[-1] + 1 :]):
+        return None
+    return int(missing[0]), int(missing[-1])
