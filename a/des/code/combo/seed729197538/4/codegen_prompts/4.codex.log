+def _draw_template(grid: np.ndarray, mask: np.ndarray, color: int, top: int, left: int) -> None:
+    patch = grid[top : top + mask.shape[0], left : left + mask.shape[1]]
+    assert np.all(patch[mask] == BG)
+    patch[mask] = color
+
+
+def _draw_fence(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    direction: str,
+    gap_start: int,
