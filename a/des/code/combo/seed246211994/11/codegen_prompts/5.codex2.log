def sample_row_starts(heights: list[int], total_h: int) -> list[int]:
    free = total_h - sum(heights) - MIN_ROW_GAP * (len(heights) - 1)
    if free < 0:
        raise ValueError("insufficient height")

    slack = [0] * (len(heights) + 1)
    for _ in range(free):
