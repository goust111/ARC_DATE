+            return True
+        if _bbox_intersects(expanded_out, other["expanded_out"]):
+            return True
+    return False
+
+
+def _choose_directions(count: int) -> list[tuple[int, int]]:
+    dirs = random.sample(SHIFT_DIRS, k=min(count, len(SHIFT_DIRS)))
+    while len(dirs) < count:
