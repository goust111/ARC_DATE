+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+TEAL = 8
+PALETTE = tuple(range(10))
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+# Generator settings.
+GRID_HEIGHT_RANGE = (8, 13)
+GRID_WIDTH_RANGE = (8, 13)
+RECT_COUNT_RANGE = (2, 5)
