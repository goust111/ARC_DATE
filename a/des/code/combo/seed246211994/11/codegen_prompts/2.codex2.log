+
+    bg = _background_color(g)
+    fg_colors = [int(color) for color in np.unique(g) if int(color) != bg]
+    assert len(fg_colors) == 1, "expected exactly one foreground color"
+    fg = fg_colors[0]
+
+    components = _connected_components(g == fg)
+    assert components, "expected at least one foreground object"
+
+    out = np.full_like(g, bg)
+    width = g.shape[1]
+    for comp in components:
+        bbox = tuple(int(v) for v in comp["bbox"])
+        r0, _c0, r1, _c1 = bbox
+        mask = _component_mask(comp["coords"], bbox)
+        obj_h, obj_w = mask.shape
+
+        goes_right = _has_flanked_boundary_gap(mask)
+        dst_c = width - obj_w if goes_right else 0
+        dst_color = GREEN if goes_right else RED
+
+        dst = out[r0 : r1 + 1, dst_c : dst_c + obj_w]
+        assert dst.shape == (obj_h, obj_w)
+        assert np.all(dst[mask] == bg), "moved objects must not overlap"
+        dst[mask] = dst_color
+
+    return out
+
+
+BG = YELLOW
+FG = BLUE
+GRID_W_RANGE = (18, 30)
+OBJECT_COUNT_RANGE = (3, 6)
+OBJECT_H_RANGE = (2, 6)
+OBJECT_W_MAX = 10
+MIN_ROW_GAP = 1
+EXTRA_HEIGHT_RANGE = (0, 6)
+MIN_FILL_RATIO = 0.6
+MAX_FOREGROUND_FRACTION = 0.45
+NOTCH_INTERIOR_CARVE_PROB = 0.45
+EXTRA_CARVE_PROB = 0.2
+CLOSED_CARVE_PROB = 0.75
+GENERATION_RETRIES = 400
+
+
+def _carve_interior_rect(mask: np.ndarray, max_remove: int, probability: float) -> int:
+    if max_remove <= 0 or random.random() > probability:
+        return 0
+    h, w = mask.shape
+    choices: list[tuple[int, int, int, int, int]] = []
+    for r0 in range(1, h - 1):
+        for c0 in range(1, w - 1):
+            for r1 in range(r0, h - 2 + 1):
+                for c1 in range(c0, w - 2 + 1):
+                    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+                    if area <= max_remove and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1])):
+                        choices.append((r0, c0, r1, c1, area))
+    if not choices:
+        return 0
+    r0, c0, r1, c1, area = random.choice(choices)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = False
+    return int(area)
+
+
+def _make_notch_mask(h: int, w: int) -> np.ndarray | None:
+    area = h * w
+    max_remove = area - math.ceil(area * MIN_FILL_RATIO)
+    if max_remove < 1:
+        return None
+
+    edges: list[str] = []
+    if w >= 3:
+        edges.extend(["top", "bottom"])
+    if h >= 3:
+        edges.extend(["left", "right"])
+    if not edges:
+        return None
+
+    mask = np.ones((h, w), dtype=bool)
+    edge = random.choice(edges)
+    edge_len = w if edge in {"top", "bottom"} else h
+    max_run = min(edge_len - 2, max_remove)
+    if max_run < 1:
+        return None
+
+    run = random.randint(1, max_run)
+    start = random.randint(1, edge_len - run - 1)
+    max_depth = min((h - 1) if edge in {"top", "bottom"} else (w - 1), max_remove // run)
+    if max_depth < 1:
+        return None
+    depth = random.randint(1, max_depth)
+
+    if edge == "top":
+        mask[:depth, start : start + run] = False
+    elif edge == "bottom":
+        mask[h - depth :, start : start + run] = False
+    elif edge == "left":
+        mask[start : start + run, :depth] = False
+    else:
+        mask[start : start + run, w - depth :] = False
+
+    removed = run * depth
+    removed += _carve_interior_rect(mask, max_remove - removed, NOTCH_INTERIOR_CARVE_PROB)
+    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
+
+    if not _has_flanked_boundary_gap(mask):
+        return None
+    if not _is_connected(mask):
+        return None
+    return mask
+
+
+def _make_closed_mask(h: int, w: int) -> np.ndarray | None:
+    mask = np.ones((h, w), dtype=bool)
+    area = h * w
+    max_remove = area - math.ceil(area * MIN_FILL_RATIO)
+    removed = _carve_interior_rect(mask, max_remove, CLOSED_CARVE_PROB)
+    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
+    if _has_flanked_boundary_gap(mask):
+        return None
+    if not _is_connected(mask):
+        return None
+    return mask
+
+
+def _sample_layout() -> tuple[int, int, list[str], list[int], list[int]] | None:
+    n = random.randint(*OBJECT_COUNT_RANGE)
+    heights = [random.randint(*OBJECT_H_RANGE) for _ in range(n)]
+    min_h = sum(heights) + MIN_ROW_GAP * (n - 1)
+    max_h = min(24, min_h + random.randint(*EXTRA_HEIGHT_RANGE))
+    if min_h > max_h:
+        return None
+
+    grid_h = random.randint(min_h, max_h)
+    grid_w = random.randint(*GRID_W_RANGE)
+
+    notch_count = random.choice([n // 2, (n + 1) // 2])
+    notch_count = min(max(1, notch_count), n - 1)
+    kinds = ["notch"] * notch_count + ["closed"] * (n - notch_count)
+    random.shuffle(kinds)
+
+    free_rows = grid_h - sum(heights) - MIN_ROW_GAP * (n - 1)
+    gaps = [0] * (n + 1)
+    for _ in range(free_rows):
+        gaps[random.randrange(n + 1)] += 1
+
+    starts = []
+    r = gaps[0]
+    for i, h in enumerate(heights):
+        starts.append(r)
+        r += h
+        if i + 1 < n:
+            r += MIN_ROW_GAP + gaps[i + 1]
+
+    return grid_h, grid_w, kinds, heights, starts
+
+
+def _sample_objects(grid_w: int, kinds: list[str], heights: list[int], starts: list[int]):
+    max_w = min(OBJECT_W_MAX, grid_w - 3)
+    if max_w < 2:
+        return None
+
+    objects = []
+    for kind, h, r0 in zip(kinds, heights, starts):
+        mask = None
+        width = None
+        for _ in range(80):
+            w = random.randint(2, max_w)
+            if kind == "notch" and h < 3 and w < 3:
+                continue
+            candidate = _make_notch_mask(h, w) if kind == "notch" else _make_closed_mask(h, w)
+            if candidate is None:
+                continue
+            mask = candidate
+            width = w
+            break
+        if mask is None or width is None:
+            return None
+        objects.append(
+            {
+                "kind": kind,
+                "mask": mask,
+                "r0": r0,
+                "w": width,
+                "dst_c": grid_w - width if kind == "notch" else 0,
+                "out_color": GREEN if kind == "notch" else RED,
+            }
+        )
+    return objects
+
+
+def _render_pair(grid_h: int, grid_w: int, objects) -> tuple[np.ndarray, np.ndarray] | None:
+    inp = np.full((grid_h, grid_w), BG, dtype=int)
+    out = np.full((grid_h, grid_w), BG, dtype=int)
+
+    total_fg = sum(int(obj["mask"].sum()) for obj in objects)
+    if total_fg >= int(grid_h * grid_w * MAX_FOREGROUND_FRACTION):
+        return None
+
+    for obj in objects:
+        _paint_mask(out, obj["mask"], obj["r0"], obj["dst_c"], obj["out_color"])
+
+    for obj in objects:
+        w = int(obj["w"])
+        c0 = random.randint(1, grid_w - w - 2)
+        obj["src_c"] = c0
+        _paint_mask(inp, obj["mask"], obj["r0"], c0, FG)
+
+    return inp, out
+
+
+def _valid_input_structure(grid: np.ndarray) -> bool:
+    bg = _background_color(grid)
+    if bg != BG:
+        return False
+    colors = set(int(v) for v in np.unique(grid))
+    if colors - {BG, FG}:
+        return False
+    comps = _connected_components(grid == FG)
+    if len(comps) < 2:
+        return False
+    decisions = []
+    for comp in comps:
+        mask = _component_mask(comp["coords"], tuple(int(v) for v in comp["bbox"]))
+        decisions.append(_has_flanked_boundary_gap(mask))
+    return any(decisions) and not all(decisions)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    layout = _sample_layout()
+    if layout is None:
+        return None
+    grid_h, grid_w, kinds, heights, starts = layout
+    objects = _sample_objects(grid_w, kinds, heights, starts)
+    if objects is None:
+        return None
+    rendered = _render_pair(grid_h, grid_w, objects)
+    if rendered is None:
+        return None
+
+    inp, expected = rendered
+    if not _valid_input_structure(inp):
+        return None
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

