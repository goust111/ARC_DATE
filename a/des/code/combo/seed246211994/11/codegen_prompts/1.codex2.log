+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIRS4: tuple[tuple[int, int], ...] = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((int(rr), int(cc)))
+                for dr, dc in DIRS4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            comps.append(np.array(cells, dtype=int))
+
+    return comps
+
+
+def _monochrome_components(grid: np.ndarray, bg: int) -> list[tuple[int, np.ndarray]]:
+    parts: list[tuple[int, np.ndarray]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == int(bg):
+            continue
+        for coords in _components(grid == color):
+            parts.append((color, coords))
+    return parts
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Clear the canvas, then move each monochrome 4-connected object downward by
+    its own area. Pixels that move below the bottom edge are cropped away.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    h, w = g.shape
+    bg = _background_color(g)
+    out = np.full((h, w), bg, dtype=int)
+
+    for color, coords in _monochrome_components(g, bg):
+        shift = int(coords.shape[0])
+        moved = coords.copy()
+        moved[:, 0] += shift
+        keep = moved[:, 0] < h
+        if np.any(keep):
+            out[moved[keep, 0], moved[keep, 1]] = int(color)
+
+    return out
+
+
+# --------------- generator ---------------
+
+_COLORS = tuple(range(10))
+_MIN_H, _MAX_H = 10, 18
+_MIN_W, _MAX_W = 12, 20
+_MIN_OBJECTS, _MAX_OBJECTS = 2, 4
+_MAX_AREA = 8
+_MAX_BOX_SIDE = 4
+_GEN_ATTEMPTS = 400
+
+
+def _random_composition(total: int, parts: int) -> list[int]:
+    bins = [0] * parts
+    for _ in range(int(total)):
+        bins[random.randrange(parts)] += 1
+    return bins
+
+
+def _lane_starts(widths: list[int], total_width: int) -> list[int]:
+    used = sum(widths) + max(0, len(widths) - 1)
+    extra = int(total_width - used)
+    assert extra >= 0
+
+    gaps = _random_composition(extra, len(widths) + 1)
+    starts: list[int] = []
+    c = int(gaps[0])
+    for i, width in enumerate(widths):
+        starts.append(int(c))
+        c += int(width)
+        if i < len(widths) - 1:
+            c += 1 + int(gaps[i + 1])
+    return starts
+
+
+def _shape_from_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    coords = coords - coords.min(axis=0)
+    return coords.astype(int)
+
+
+def _random_connected_shape(
+    area: int,
+    *,
+    min_box_h: int,
+    max_box_h: int,
+    max_box_w: int,
+    min_span_h: int = 1,
+) -> np.ndarray | None:
