+def _random_composition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))
+    out: list[int] = []
+    prev = 0
+    for cut in cuts + [int(total)]:
+        out.append(int(cut - prev))
+        prev = int(cut)
+    return out
+
+
+def _make_frame(size: int, hole_count: int, color: int) -> np.ndarray | None:
+    inner = int(size) - 2
+    if inner < 1 or int(hole_count) < 1 or int(hole_count) > (inner + 1) // 2:
+        return None
+
+    patch = np.full((size, size), BG, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+
+    orientation = random.choice(("vertical", "horizontal"))
+    segments = _random_composition(inner - (int(hole_count) - 1), int(hole_count))
+    cursor = 1
+    if orientation == "vertical":
+        for seg in segments[:-1]:
+            cursor += int(seg)
+            patch[1:-1, cursor] = color
+            cursor += 1
+    else:
+        for seg in segments[:-1]:
+            cursor += int(seg)
+            patch[cursor, 1:-1] = color
+            cursor += 1
+
+    if _count_enclosed_noncolor_regions(patch, color) != int(hole_count):
+        return None
+    return patch
+
+
+def _isolated_seeds(size: int, count: int) -> list[tuple[int, int]] | None:
+    cells = [(r, c) for r in range(1, size - 1) for c in range(1, size - 1)]
+    for _ in range(80):
+        random.shuffle(cells)
