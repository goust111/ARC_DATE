+                            break
+                    if ok:
+                        frontier.append((int(nr), int(nc)))
+            if not frontier:
+                break
+            cell = random.choice(frontier)
+            group.add(cell)
+            occupied.add(cell)
+            patch[cell[0], cell[1]] = BG
+
+    if _count_enclosed_noncolor_regions(patch, color) != int(hole_count):
+        return None
+    return patch
+
+
+def _factor_layouts(n: int) -> list[tuple[int, int]]:
+    return [(int(r), int(n // r)) for r in range(1, n + 1) if n % r == 0]
+
+
+def _find_free_bbox(blocked: np.ndarray, h: int, w: int, padding: int) -> tuple[int, int] | None:
+    H, W = blocked.shape
+    choices: list[tuple[int, int]] = []
+    for r in range(H - h + 1):
+        r0 = max(0, r - padding)
+        r1 = min(H, r + h + padding)
+        for c in range(W - w + 1):
+            c0 = max(0, c - padding)
+            c1 = min(W, c + w + padding)
