+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Match sprites to frames by 4-connected hole count, then place each sprite inside its matching frame.
+
+    Input structure:
+    - Background is azure (8).
+    - Large square frames form a regular grid.
+    - Smaller square sprites appear elsewhere.
+    - Both frames and sprites may contain enclosed background holes.
+
+    Rule:
+    - Count the number of enclosed 4-connected non-self-color regions for each frame and sprite.
+    - Match frames and sprites with the same count.
+    - Place the matched sprite inside the frame.
+    - Recolor the sprite's holes to the frame color.
+    """
+    g = np.asarray(grid, dtype=int)
+    comps = _find_mono_components(g, BG)
+    squares = _square_candidates(comps)
+
+    sizes = sorted({int(comp["h"]) for comp in squares}, reverse=True)
+    assert len(sizes) >= 2
+    frame_size = int(sizes[0])
+    sprite_size = int(sizes[1])
+
+    frames = [comp for comp in squares if int(comp["h"]) == int(frame_size)]
+    sprites_raw = [comp for comp in squares if int(comp["h"]) == int(sprite_size)]
+    assert frames and sprites_raw
+
+    row_starts = sorted({int(comp["bbox"][0]) for comp in frames})
+    col_starts = sorted({int(comp["bbox"][1]) for comp in frames})
+
+    frame_slots: list[dict] = []
+    for ri, r0 in enumerate(row_starts):
+        for ci, c0 in enumerate(col_starts):
+            region = g[r0 : r0 + frame_size, c0 : c0 + frame_size]
+            assert region.shape == (frame_size, frame_size)
+            border = np.concatenate([region[0], region[-1], region[1:-1, 0], region[1:-1, -1]])
+            frame_color = int(Counter(map(int, border.tolist())).most_common(1)[0][0])
+            frame_slots.append(
+                {
+                    "ri": int(ri),
+                    "ci": int(ci),
+                    "color": int(frame_color),
+                    "holes": int(_count_enclosed_noncolor_regions(region, frame_color)),
+                }
+            )
+
+    sprites_by_holes: dict[int, list[dict]] = {}
+    for comp in sprites_raw:
+        r0, c0, r1, c1 = comp["bbox"]
+        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        sprite = {
+            "color": int(comp["color"]),
+            "holes": int(_count_enclosed_noncolor_regions(patch, int(comp["color"]))),
+            "patch": patch,
+            "pos": (int(r0), int(c0)),
+        }
+        sprites_by_holes.setdefault(int(sprite["holes"]), []).append(sprite)
+
+    for sprites in sprites_by_holes.values():
+        sprites.sort(key=lambda item: item["pos"])
+
+    out = np.full((len(row_starts) * frame_size, len(col_starts) * frame_size), BG, dtype=int)
+    for slot in frame_slots:
+        rr = int(slot["ri"]) * frame_size
+        cc = int(slot["ci"]) * frame_size
+        frame_color = int(slot["color"])
+        out[rr : rr + frame_size, cc : cc + frame_size] = frame_color
+
+        matches = sprites_by_holes.get(int(slot["holes"]), [])
+        if not matches:
+            continue
+        sprite = matches.pop(0)
+        content = np.array(sprite["patch"], dtype=int).copy()
+        content[content != int(sprite["color"])] = frame_color
+        sh, sw = content.shape
+        out[rr + 1 : rr + 1 + sh, cc + 1 : cc + 1 + sw] = content
+
+    return out
