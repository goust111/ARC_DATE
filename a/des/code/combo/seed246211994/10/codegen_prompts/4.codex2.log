+        return patch
+
+    seeds = _isolated_seeds(size, int(hole_count))
+    if seeds is None:
+        return None
+
+    groups: list[set[tuple[int, int]]] = [{seed} for seed in seeds]
+    occupied = set(seeds)
+    for r, c in occupied:
+        patch[r, c] = BG
+
+    inner_area = max(1, (size - 2) * (size - 2))
+    max_target = max(1, inner_area // max(1, hole_count))
+    for gi, group in enumerate(groups):
+        target = random.randint(1, max_target)
+        while len(group) < target:
+            frontier: list[tuple[int, int]] = []
+            for r, c in group:
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if not (1 <= nr < size - 1 and 1 <= nc < size - 1):
+                        continue
+                    if (nr, nc) in occupied:
+                        continue
+                    ok = True
+                    for oj, other in enumerate(groups):
+                        if oj == gi:
+                            continue
+                        if (nr, nc) in other:
+                            ok = False
+                            break
+                        for dr2, dc2 in DIR4:
+                            if (nr + dr2, nc + dc2) in other:
+                                ok = False
+                                break
