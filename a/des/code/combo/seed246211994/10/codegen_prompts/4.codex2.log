+        for r, c in cells:
+            if all(abs(r - rr) + abs(c - cc) > 1 for rr, cc in seeds):
+                seeds.append((int(r), int(c)))
+                if len(seeds) == int(count):
+                    return seeds
+    return None
+
+
+def _make_sprite(size: int, hole_count: int, color: int) -> np.ndarray | None:
+    patch = np.full((size, size), color, dtype=int)
