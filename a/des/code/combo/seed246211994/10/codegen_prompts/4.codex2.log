+        blocked[rr : rr + sprite_size, cc : cc + sprite_size] = True
+
+    expected = _build_expected(frames, {int(s["holes"]): s for s in sprites}, rows, cols, frame_size)
+    try:
+        actual = main(canvas)
+    except Exception:
+        return None
+    if actual.shape != expected.shape or not np.array_equal(actual, expected):
+        return None
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
