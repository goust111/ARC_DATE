+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal cell-grid overlay guided by the minority cell's internal blueprint.
+
+    The grid is partitioned by separator lines into equal square cells. Most cells share a
+    common interior pattern; a few cells use a second pattern. The minority pattern is a
+    cell-scale blueprint: positions where it differs from the majority pattern mark the
+    cell-grid locations that should be minority cells after completion.
+    """
+    g = np.asarray(grid, dtype=int)
