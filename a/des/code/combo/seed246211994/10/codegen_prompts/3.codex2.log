+    out = g.copy()
+    inner = step - 1
+    for i in range(active_mask.shape[0]):
+        for j in range(active_mask.shape[1]):
+            target = minority if bool(active_mask[i, j]) else majority
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target
+    return out
+
+
+# --------------- generator ---------------
+
+_MAX_RETRIES = 400
+_COLORS = list(range(10))
+_GRID_N_RANGE = (4, 8)
+_INNER_RANGE = (2, 4)
+_MAJORITY_DENSITY = (0.2, 0.55)
+_ACTIVE_CAP = 8
+
+
+def _random_majority_pattern(inner: int, paper: int, ink: int) -> np.ndarray:
+    """Build a non-uniform base texture whose dominant color stays visually obvious."""
+    total = inner * inner
+    low = max(1, int(np.floor(total * _MAJORITY_DENSITY[0])))
+    high = min(total - 1, int(np.ceil(total * _MAJORITY_DENSITY[1])))
+    ink_count = random.randint(low, high)
+    arr = np.full((inner, inner), paper, dtype=int)
+    indices = random.sample(range(total), ink_count)
+    for idx in indices:
+        arr[idx // inner, idx % inner] = ink
+    return arr
+
+
+def _random_active_mask(inner: int, n: int) -> np.ndarray:
+    """Choose a sparse blueprint with at least one active and one inactive location."""
+    total = inner * inner
+    max_active = min(total - 1, _ACTIVE_CAP, max(2, (n * n) // 3))
+    min_active = 2 if total >= 4 else 1
+    min_active = min(min_active, max_active)
+
+    for _ in range(200):
+        active_count = random.randint(min_active, max_active)
+        cells = random.sample(range(total), active_count)
+        mask = np.zeros((inner, inner), dtype=bool)
+        for idx in cells:
+            mask[idx // inner, idx % inner] = True
+        rows, cols = np.where(mask)
+        if len(set(map(int, rows))) >= min(2, inner) and len(set(map(int, cols))) >= min(2, inner):
+            return mask
