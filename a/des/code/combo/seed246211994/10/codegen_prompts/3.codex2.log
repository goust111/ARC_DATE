+    counts = Counter(pattern for row in cell_patterns for pattern in row)
+    assert len(counts) == 2, "expected exactly two cell interior patterns"
+
+    majority_key = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_key = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority = pattern_arrays[majority_key]
+    minority = pattern_arrays[minority_key]
+
+    active_mask = minority != majority
+    assert bool(active_mask.any()), "minority pattern must differ from majority pattern"
+    assert not bool(active_mask.all()), "blueprint cannot mark every position active"
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_patterns[i][j] == minority_key
+    assert bool(existing.any()), "input must expose at least one minority cell"
+
+    candidates = _candidate_offsets(existing, active_mask)
+    assert len(candidates) == 1, "minority cells must determine a unique blueprint placement"
+    top, left = candidates[0]
