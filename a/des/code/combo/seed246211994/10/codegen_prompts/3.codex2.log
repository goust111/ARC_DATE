+            block = np.zeros_like(existing, dtype=bool)
+            block[top : top + mh, left : left + mw] = True
+            if bool(np.any(existing & ~block)):
+                continue
+            local_existing = existing[top : top + mh, left : left + mw]
+            if bool(np.any(local_existing & ~mask)):
+                continue
+            candidates.append((top, left))
