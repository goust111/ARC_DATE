+    """Enumerate proper active subsets that already force the correct placement."""
+    active_rel = [tuple(map(int, coord)) for coord in np.argwhere(mask)]
+    all_valid: list[tuple[tuple[int, int], ...]] = []
+
+    size_order = list(range(1, len(active_rel)))
+    random.shuffle(size_order)
+    for subset_size in size_order:
