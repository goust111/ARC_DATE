+def _gen_attempt() -> np.ndarray | None:
+    inner = random.randint(*_INNER_RANGE)
+    min_n = max(inner + 1, _GRID_N_RANGE[0])
+    max_n = max(min_n, _GRID_N_RANGE[1])
+    n = random.randint(min_n, max_n)
+    step = inner + 1
+
+    separator, paper, majority_ink, minority_ink = random.sample(_COLORS, 4)
+    majority = _random_majority_pattern(inner, paper, majority_ink)
+    active_mask = _random_active_mask(inner, n)
+    minority = majority.copy()
+    minority[active_mask] = minority_ink
+
+    top = random.randint(0, n - inner)
+    left = random.randint(0, n - inner)
+    full_active = {(top + r, left + c) for r, c in map(tuple, np.argwhere(active_mask))}
+
+    valid_subsets = _subset_candidates(active_mask, top, left, n)
+    if not valid_subsets:
+        return None
+
+    shown_subset = set((top + r, left + c) for r, c in random.choice(valid_subsets))
+    if shown_subset == full_active:
+        return None
+
+    inp = _build_grid(n, step, separator, majority, minority, shown_subset)
+    expected = _build_grid(n, step, separator, majority, minority, full_active)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(inp, solved):
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

