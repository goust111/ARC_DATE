+def _infer_grid(g: np.ndarray) -> tuple[int, int, list[int], list[int], int]:
+    """Infer the regular cell grid separated by full rows/cols of one color."""
+    h, w = g.shape
+    candidates: list[tuple[int, int, list[int], list[int], int]] = []
+
+    for color in map(int, np.unique(g)):
+        row_divs = [r for r in range(h) if bool(np.all(g[r, :] == color))]
+        col_divs = [c for c in range(w) if bool(np.all(g[:, c] == color))]
+        if len(row_divs) < 2 or len(col_divs) < 2:
+            continue
+        if row_divs[0] != 0 or row_divs[-1] != h - 1:
+            continue
+        if col_divs[0] != 0 or col_divs[-1] != w - 1:
+            continue
+
+        row_steps = {row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1)}
+        col_steps = {col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1)}
+        if len(row_steps) != 1 or len(col_steps) != 1:
+            continue
+
+        step_r = row_steps.pop()
+        step_c = col_steps.pop()
+        if step_r != step_c or step_r <= 1:
+            continue
+
+        n_r = len(row_divs) - 1
+        n_c = len(col_divs) - 1
+        if n_r != n_c or n_r < 2:
+            continue
+
+        candidates.append((n_r, step_r, row_divs, col_divs, color))
+
+    assert len(candidates) == 1, "expected a unique regular separator grid"
+    return candidates[0]
+
+
+def _extract_cell_patterns(g: np.ndarray, n: int, step: int) -> tuple[list[list[tuple[int, ...]]], dict[tuple[int, ...], np.ndarray]]:
+    """Read each cell interior as a hashable pattern and keep one array copy per pattern."""
+    inner = step - 1
+    cell_patterns: list[list[tuple[int, ...]]] = []
+    pattern_arrays: dict[tuple[int, ...], np.ndarray] = {}
+
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            key = tuple(map(int, arr.ravel()))
+            row.append(key)
+            pattern_arrays.setdefault(key, arr)
+        cell_patterns.append(row)
+    return cell_patterns, pattern_arrays
+
+
+def _candidate_offsets(existing: np.ndarray, mask: np.ndarray) -> list[tuple[int, int]]:
+    """All placements where existing minority cells are a subset of the active mask."""
+    n_r, n_c = existing.shape
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
