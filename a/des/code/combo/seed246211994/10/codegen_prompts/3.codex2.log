+
+
+def _build_grid(n: int, step: int, separator: int, majority: np.ndarray, minority: np.ndarray, minority_cells: set[tuple[int, int]]) -> np.ndarray:
+    inner = step - 1
+    size = n * step + 1
+    grid = np.full((size, size), separator, dtype=int)
+    for i in range(n):
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
