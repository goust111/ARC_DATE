+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+# --------------- solver ---------------
+
+
+def _background_color(grid: np.ndarray) -> int:
+    counts = np.bincount(np.asarray(grid, dtype=int).ravel(), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _contiguous_bands(mask: np.ndarray) -> list[tuple[int, int]]:
+    indices = np.flatnonzero(mask)
+    assert indices.size > 0, "expected at least one non-background row/column"
+
+    bands: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx != prev + 1:
+            bands.append((start, prev))
+            start = idx
+        prev = idx
+    bands.append((start, prev))
+    return bands
+
+
+def _cell_color(region: np.ndarray, bg: int) -> int:
+    colors = np.unique(region[region != bg])
+    assert colors.size == 1, "each coarse cell must contain a single foreground color"
+    return int(colors[0])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Extract the foreground color of each background-separated panel and mirror the coarse grid horizontally.
+
+    Input structure
+    - The dominant color is the background.
+    - Background-only rows and columns split the foreground into rectangular row-bands and column-bands.
+    - Each row-band / column-band intersection contains one foreground color, with optional background holes.
+
+    Rule
+    - Group non-background rows and columns into contiguous bands.
+    - Read the unique non-background color from each band intersection.
+    - Return the resulting coarse color grid with its column order reversed.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    bg = _background_color(g)
+    row_bands = _contiguous_bands(np.any(g != bg, axis=1))
+    col_bands = _contiguous_bands(np.any(g != bg, axis=0))
+
+    out = np.empty((len(row_bands), len(col_bands)), dtype=int)
+    for r_idx, (r0, r1) in enumerate(row_bands):
+        for c_idx, (c0, c1) in enumerate(reversed(col_bands)):
+            out[r_idx, c_idx] = _cell_color(g[r0 : r1 + 1, c0 : c1 + 1], bg)
+    return out
+
+
+# --------------- generator ---------------
+
+# Coarse grid dimensions.
+ROW_BAND_RANGE = (2, 4)
+COL_BAND_RANGE = (2, 4)
+
+# Expanded cell and separator geometry.
+BAND_HEIGHT_RANGE = (2, 5)
+BAND_WIDTH_RANGE = (2, 5)
+ROW_GAP_RANGE = (1, 3)
+COL_GAP_RANGE = (1, 3)
+PADDING_RANGE = (1, 3)
+MAX_GRID_DIM = 30
+
+# Palette and holes.
+COLOR_VALUES = tuple(range(10))
+MIN_PALETTE_SIZE = 3
+MAX_PALETTE_SIZE = 7
+NO_HOLE_PROB = 0.30
+FORCE_HOLE_CASE_PROB = 0.60
+
+# Retry limit.
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _strict_bg_is_dominant(grid: np.ndarray, bg: int) -> bool:
+    counts = np.bincount(grid.ravel(), minlength=10)
+    other_counts = np.delete(counts, bg)
+    return int(counts[bg]) > int(other_counts.max()) and _background_color(grid) == int(bg)
+
+
+def _make_coarse_output(rows: int, cols: int, bg: int) -> np.ndarray:
+    n_cells = rows * cols
+    max_palette = min(MAX_PALETTE_SIZE, n_cells, len(COLOR_VALUES) - 1)
+    palette_size = random.randint(MIN_PALETTE_SIZE, max_palette)
+    palette = random.sample([color for color in COLOR_VALUES if color != bg], palette_size)
+
+    counts = {color: 0 for color in palette}
+    out = np.empty((rows, cols), dtype=int)
+    for r in range(rows):
+        for c in range(cols):
+            forbidden = set()
+            if r > 0:
+                forbidden.add(int(out[r - 1, c]))
+            if c > 0:
+                forbidden.add(int(out[r, c - 1]))
+
+            choices = [color for color in palette if color not in forbidden]
+            min_count = min(counts[color] for color in choices)
+            balanced = [color for color in choices if counts[color] == min_count]
+            color = random.choice(balanced)
+            out[r, c] = int(color)
+            counts[color] += 1
+
+    return out
+
+
+def _rect_hole_mask(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if height < 4 or width < 4:
+        return mask
+
+    hole_h = random.randint(1, height - 2)
+    hole_w = random.randint(1, width - 2)
+    r0 = random.randint(1, height - hole_h - 1)
+    c0 = random.randint(1, width - hole_w - 1)
+    mask[r0 : r0 + hole_h, c0 : c0 + hole_w] = True
+    return mask
+
+
+def _sparse_hole_mask(height: int, width: int) -> np.ndarray:
+    area = height * width
+    max_holes = min(area // 4, area - max(height, width))
+    if max_holes <= 0:
+        return np.zeros((height, width), dtype=bool)
+
+    target = random.randint(1, max_holes)
+    for _ in range(12):
+        mask = np.zeros((height, width), dtype=bool)
+        row_left = [width] * height
+        col_left = [height] * width
+        coords = [(r, c) for r in range(height) for c in range(width)]
+        random.shuffle(coords)
+
+        holes = 0
+        for r, c in coords:
