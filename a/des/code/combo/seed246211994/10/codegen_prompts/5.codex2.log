+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts")
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    height = int(rng.integers(12, 23))
+    width = int(rng.integers(12, 23))
+    bg = int(rng.choice(NON_PALETTE_COLORS))
+    counts = _sample_counts(rng, height, width)
+    if counts is None:
+        return None
+
+    grid = np.full((height, width), bg, dtype=int)
+    blocked = np.zeros((height, width), dtype=bool)
+
+    objects = []
+    for color, count in zip(PALETTE_ORDER, counts):
+        for _ in range(count):
+            mask = _random_shape(rng)
+            bbox_area = mask.shape[0] * mask.shape[1]
+            objects.append((bbox_area, int(mask.sum()), float(rng.random()), color, mask))
+    objects.sort(key=lambda item: (-item[0], -item[1], item[2]))
+
+    for _, _, _, color, mask in objects:
+        if not _place_mask(grid, blocked, mask, color, rng):
+            return None
+
+    if np.count_nonzero(grid != bg) >= grid.size // 2:
+        return None
+
+    expected = _histogram_from_counts(counts, bg)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def _sample_counts(rng: np.random.Generator, height: int, width: int) -> list[int] | None:
+    capacity = max(4, min(16, (height * width) // 14))
+    n_active = int(rng.integers(1, len(PALETTE_ORDER) + 1))
+    active = list(map(int, rng.choice(len(PALETTE_ORDER), size=n_active, replace=False)))
+
+    max_count_cap = min(6, capacity)
+    max_count = int(rng.integers(1, max_count_cap + 1))
+    counts = [0] * len(PALETTE_ORDER)
+    max_idx = int(rng.choice(active))
+    counts[max_idx] = max_count
+
+    for idx in active:
+        if idx == max_idx:
+            continue
+        counts[idx] = int(rng.integers(1, max_count + 1))
+
+    total_objects = sum(counts)
+    if total_objects > capacity:
+        return None
+    return counts
+
+
+def _place_mask(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    rng: np.random.Generator,
+) -> bool:
+    h, w = grid.shape
+    mh, mw = mask.shape
+    coords = np.argwhere(mask)
+
+    for _ in range(MAX_PLACEMENT_ATTEMPTS):
+        r0 = int(rng.integers(0, h - mh + 1))
+        c0 = int(rng.integers(0, w - mw + 1))
+        cells = [(int(r0 + r), int(c0 + c)) for r, c in coords]
+        if any(blocked[r, c] for r, c in cells):
+            continue
+        for r, c in cells:
+            grid[r, c] = color
+        _mark_blocked(blocked, cells)
+        return True
+    return False
+
+
+def _mark_blocked(blocked: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _random_shape(rng: np.random.Generator) -> np.ndarray:
+    if float(rng.random()) < 0.35:
+        mask = _random_grown_blob(rng)
+    else:
+        mask = BASE_SHAPES[int(rng.integers(0, len(BASE_SHAPES)))]
+    return _random_transform(mask, rng)
+
+
+def _random_grown_blob(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(2, 5))
+    w = int(rng.integers(2, 5))
+    mask = np.zeros((h, w), dtype=bool)
+    start = (int(rng.integers(0, h)), int(rng.integers(0, w)))
+    mask[start] = True
+    cells = [start]
+    target = int(rng.integers(2, min(6, h * w) + 1))
+
+    for _ in range(target - 1):
+        frontier = set()
+        for r, c in cells:
+            for dr, dc in EIGHT_DIRS:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                    frontier.add((nr, nc))
+        if not frontier:
+            break
+        pick = list(frontier)[int(rng.integers(0, len(frontier)))]
+        mask[pick] = True
+        cells.append(pick)
+    return _trim_mask(mask)
+
+
+def _random_transform(mask: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = mask.copy()
+    if bool(rng.integers(0, 2)):
+        out = np.fliplr(out)
+    out = np.rot90(out, int(rng.integers(0, 4)))
+    return out.copy()
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
+
+
+def _histogram_from_counts(counts: list[int], bg: int) -> np.ndarray:
+    height = max(counts)
+    out = np.full((height, len(PALETTE_ORDER)), bg, dtype=int)
+    for col, (color, count) in enumerate(zip(PALETTE_ORDER, counts)):
+        if count > 0:
+            out[height - count :, col] = color
+    return out
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    return int(np.bincount(grid.ravel(), minlength=10).argmax())
+
+
+def _count_components(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                cr, cc = stack.pop()
+                for dr, dc in EIGHT_DIRS:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return count

