+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    tight = _tight_mask(mask)
+    return tuple(map(int, tight.shape)), np.ascontiguousarray(tight.astype(np.uint8)).tobytes()
+
