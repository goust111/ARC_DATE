+    *,
+    padding: int = 2,
+) -> tuple[int, int] | None:
+    ph, pw = patch.shape
+    h, w = canvas.shape
+    candidates: list[tuple[float, int, int]] = []
+    for top in range(h - ph + 1):
+        for left in range(w - pw + 1):
+            bbox = (top, left, top + ph - 1, left + pw - 1)
+            if not all(_boxes_are_separate(bbox, other, padding) for other in boxes):
