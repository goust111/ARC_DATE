+            m = patch != bg
+            if np.any(sub[m] != bg):
+                continue
+            center_bias = abs((top + (ph - 1) / 2) - (h - 1) / 2) + abs((left + (pw - 1) / 2) - (w - 1) / 2)
+            candidates.append((center_bias, top, left))
