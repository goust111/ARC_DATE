 206: from scipy.ndimage import label as _label
 207: 
 208: def _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:
 209:     """
 210:     Constructively build a sprite mask in the attached orientation for `side`.
 211:     The mask is bool, 8-connected, has the correct symmetry and contact-edge length,
 212:     and exactly 1 rotation (out of 4) is a valid attachment for any hub side.
 213: 
 214:     Strategy: build in canonical "left-attach" frame (flipud symmetric, contact on right col),
 215:     then rotate to the target side.
 216:     """
 217:     # Build in "left-attach" frame: h rows, w cols.
 218:     # Right column = contact edge with exactly `edge_len` contiguous filled cells.
 219:     # flipud symmetric (rows mirror top-to-bottom).
 220:     # h > w ensures not square, breaking 90-degree rotation ambiguity.
 221:     # Also ensure NOT fliplr symmetric to prevent the complementary side matching.
 222:     e = edge_len  # = 2 for N=4
 223:     h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)
 224:     w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)
 225: 
 226:     half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)
 227: 
 228:     for _attempt in range(100):
 229:         grid = np.zeros((h, w), dtype=bool)
 230: 
 231:         # Contact edge: rightmost column, middle `e` rows filled, rest empty.
 232:         # For flipud symmetry with h=3 or h=4 and e=2:
 233:         #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.
 234:         #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]
 235:         #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.
 236:         #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.
 237:         #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.
 238:         # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells
 239:         # with flipud symmetry. Let me think differently.
 240: 
 241:         # The contact edge doesn't have to span the full height. It's the N-2 contiguous
 242:         # cells on the attachment side. For "left-attach", the solver checks the RIGHT edge
 243:         # of the cropped sprite: exactly e contiguous filled cells.
 244: 
 245:         # Build each row from right to left. Rightmost col is the contact column.
