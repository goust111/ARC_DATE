+    inp = np.full((h, w), bg, dtype=int)
+    _build_hub(inp, hub_r, hub_c, n, side_colors)
+    canvas = inp.copy()
+    placed_boxes = [(hub_r, hub_c, hub_r + n - 1, hub_c + n - 1)]
+
+    order = list(sprite_sides)
+    rng.shuffle(order)
+    for side in order:
