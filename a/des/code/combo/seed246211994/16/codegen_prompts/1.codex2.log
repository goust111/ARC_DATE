+        return None
+    candidates.sort(reverse=True)
+    best_band = candidates[: max(1, min(len(candidates), 24))]
+    _score, top, left = rng.choice(best_band)
+    return int(top), int(left)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
