+def _rotate_mask_cw(mask: np.ndarray, quarter_turns: int) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    k = int(quarter_turns) % 4
+    if k == 0:
+        return mask.copy()
