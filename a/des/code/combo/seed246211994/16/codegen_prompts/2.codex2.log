+    side = max(h, w)
+    pad = np.zeros((side, side), dtype=bool)
+    r0 = (side - h) // 2
+    c0 = (side - w) // 2
+    pad[r0 : r0 + h, c0 : c0 + w] = mask
+    rot = np.rot90(pad, -k)
+    return rot[r0 : r0 + h, c0 : c0 + w].copy()
