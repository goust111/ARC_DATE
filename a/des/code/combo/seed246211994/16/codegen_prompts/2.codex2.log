+def _rotation_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:
+    pts = set()
+    rr = int(r)
+    cc = int(c)
+    for _ in range(4):
+        pts.add((rr, cc))
+        rr, cc = int(cc), int(n - 1 - rr)
+    return pts
