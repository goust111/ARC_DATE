+    board = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    rel = board_coords - np.array([r0, c0], dtype=int)
+    board[rel[:, 0], rel[:, 1]] = g[board_coords[:, 0], board_coords[:, 1]]
