+    visited = {start}
+    frontier = [(start, neigh) for neigh in _coarse_neighbors(start[0], start[1], rows, cols)]
+    edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+
+    while frontier:
+        idx = random.randrange(len(frontier))
+        a, b = frontier.pop(idx)
+        if b in visited:
+            continue
+        edges.append((a, b))
+        visited.add(b)
