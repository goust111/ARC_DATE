+def _adjacency_edges(rows: int, cols: int) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r in range(rows):
+        for c in range(cols):
+            if r + 1 < rows:
