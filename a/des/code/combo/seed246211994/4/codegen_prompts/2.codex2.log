+    return candidates[0]
+
+
+def _apply_palette(
+    lower: np.ndarray,
+    palette: np.ndarray,
+    mask_bbox: tuple[int, int, int, int],
+    gray: int,
+) -> np.ndarray:
+    out = lower.copy()
+    r0, c0, r1, c1 = mask_bbox
+    region = out[r0 : r1 + 1, c0 : c1 + 1]
+    ph, pw = palette.shape
+    bh = region.shape[0] // ph
+    bw = region.shape[1] // pw
+
+    for pr in range(ph):
+        for pc in range(pw):
+            block = region[pr * bh : (pr + 1) * bh, pc * bw : (pc + 1) * bw]
+            block[block == gray] = int(palette[pr, pc])
