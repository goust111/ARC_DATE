+    for sep_row in range(grid.shape[0]):
+        row = grid[sep_row, :]
+        if row[0] == bg or not np.all(row == row[0]):
+            continue
+        parsed = _try_parse_separator(grid, bg, sep_row)
+        if parsed is not None:
