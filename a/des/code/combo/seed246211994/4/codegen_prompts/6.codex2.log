+    for idx in range(parts):
+        labels[bounds[idx] : bounds[idx + 1]] = idx
+    return labels
+
+
+def _build_matrix(rng: np.random.Generator, n: int, palette: np.ndarray) -> np.ndarray:
+    k = int(len(palette))
