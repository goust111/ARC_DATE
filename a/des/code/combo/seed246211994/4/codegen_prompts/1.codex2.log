+    (h, w)
+    for h in range(GRID_MIN, GRID_MAX + 1)
+    for w in range(GRID_MIN, GRID_MAX + 1)
+    if abs(h - w) <= 1
+)
+
+
+def _neighbors4(r: int, c: int) -> tuple[Cell, Cell, Cell, Cell]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _ordered_colors(g: np.ndarray) -> list[int]:
+    seen: set[int] = set()
+    colors: list[int] = []
+    for value in g.flat:
+        color = int(value)
+        if color not in seen:
+            seen.add(color)
+            colors.append(color)
+    return colors
+
+
+def _components(mask: np.ndarray) -> list[list[Cell]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[Cell]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[Cell] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[Cell] = []
+
+            while q:
+                x, y = q.popleft()
+                pts.append((x, y))
+                for nx, ny in _neighbors4(x, y):
+                    if 0 <= nx < h and 0 <= ny < w and mask[nx, ny] and not seen[nx, ny]:
+                        seen[nx, ny] = True
+                        q.append((nx, ny))
+
+            comps.append(pts)
+
+    return comps
+
+
+def _majority_winners(values: list[int]) -> list[int]:
+    counts: dict[int, int] = {}
+    order: list[int] = []
+    for value in values:
+        if value not in counts:
+            counts[value] = 0
+            order.append(value)
+        counts[value] += 1
+
+    if not order:
+        return []
+
+    best = max(counts[value] for value in order)
+    return [value for value in order if counts[value] == best]
+
+
+def _dominant_value(values: list[int]) -> int:
+    winners = _majority_winners(values)
+    assert winners, "expected at least one value"
+    return int(winners[0])
+
+
+def _touch_sides(pts: list[Cell], h: int, w: int) -> set[str]:
+    sides: set[str] = set()
+    for r, c in pts:
+        if r == 0:
+            sides.add("top")
+        if r == h - 1:
+            sides.add("bottom")
+        if c == 0:
+            sides.add("left")
+        if c == w - 1:
+            sides.add("right")
+    return sides
+
+
+def _is_simple_path(pts: list[Cell]) -> bool:
+    pset = set(pts)
+    endpoints = 0
+    for r, c in pts:
+        degree = sum((nr, nc) in pset for nr, nc in _neighbors4(r, c))
+        if degree > 2:
+            return False
+        if degree == 1:
+            endpoints += 1
+        elif degree == 0:
+            return False
+    return endpoints == 2
