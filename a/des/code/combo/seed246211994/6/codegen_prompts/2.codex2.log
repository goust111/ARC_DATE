        for area in range(1, _GEN_MAX_AREA + 1)
        if height <= area
        and area + height <= _GEN_GRID_SIZE - 1
        and area <= height * span_width
    ]
    areas = sorted({area for area, _ in pairs})
    if span_width >= 6 and random.random() < _GEN_SPAN6_AREA6_PROB:
