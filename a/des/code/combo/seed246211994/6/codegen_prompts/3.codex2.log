+    for depth, color in zip(marker_depths, marker_colors):
+        cells = _ring_cells(r0, c0, r1, c1, depth)
+        rng.shuffle(cells)
+        grid[cells[0]] = color
+        if len(cells) > 1 and rng.random() < 0.35:
+            grid[cells[1]] = color
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
