+import random
+from collections import Counter
+
+import numpy as np
+
+
+# --------------- helpers ---------------
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_H_RANGE = (16, 28)
+GRID_W_RANGE = (16, 28)
+REGION_COUNT_RANGE = (1, 4)
+INTERIOR_H_RANGE = (3, 10)
+INTERIOR_W_RANGE = (3, 11)
+MAX_PALETTE_SIZE = 4
+PLACEMENT_RETRIES = 120
+CLEARANCE = 1
