+
+def _place_region(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    rng: random.Random,
+    outer_h: int,
+    outer_w: int,
+) -> tuple[int, int, int, int] | None:
+    h, w = grid.shape
+    if outer_h + 2 >= h or outer_w + 2 >= w:
+        return None
+    for _ in range(PLACEMENT_RETRIES):
+        r0 = rng.randint(1, h - outer_h - 1)
+        c0 = rng.randint(1, w - outer_w - 1)
+        r1 = r0 + outer_h - 1
+        c1 = c0 + outer_w - 1
+        er0 = max(0, r0 - CLEARANCE)
+        ec0 = max(0, c0 - CLEARANCE)
