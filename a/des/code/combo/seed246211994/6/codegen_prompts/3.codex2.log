+        return main_color, [main_color]
+
+    depth_colors = []
+    for depth in sorted(votes):
+        counter = votes[depth]
+        chosen = max(counter, key=lambda color: (counter[color], -first_seen[(depth, color)]))
+        depth_colors.append(chosen)
