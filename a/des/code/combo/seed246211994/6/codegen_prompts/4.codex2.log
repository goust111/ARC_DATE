+    w_max = min(MAX_GRID, frame_w + 10)
+    if h_min > h_max or w_min > w_max:
+        return None
+    grid_h = rng.randint(h_min, h_max)
+    grid_w = rng.randint(w_min, w_max)
+
+    frame_r0 = rng.randint(1, grid_h - frame_h - 1)
