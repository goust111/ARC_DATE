+    edges = {color: set() for color in colors}
+    incoming = {color: set() for color in colors}
+
+    for i, lower in enumerate(colors):
+        for upper in colors[i + 1 :]:
+            overlap = _intersect(rects[lower], rects[upper])
+            if overlap is None:
