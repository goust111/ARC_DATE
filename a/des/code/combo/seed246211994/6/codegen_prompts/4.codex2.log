+def _translate_rects(rects: list[Rect], dr: int, dc: int) -> list[Rect]:
+    return [
+        (int(r0 + dr), int(c0 + dc), int(r1 + dr), int(c1 + dc))
+        for r0, c0, r1, c1 in rects
+    ]
+
