8: def _hole_count(mask: np.ndarray) -> int:
9:     """
10:     Count holes in a binary mask using 4-connectivity.
11:     A hole is a background component that does not touch the mask's bounding box border.
12:     """
13:     h, w = mask.shape
14:     bg = ~mask
15:     vis = np.zeros((h, w), dtype=bool)
16:     holes = 0
17:     for r0 in range(h):
18:         for c0 in range(w):
19:             if not bg[r0, c0] or vis[r0, c0]:
20:                 continue
21:             st = [(r0, c0)]
22:             vis[r0, c0] = True
23:             touches = False
24:             while st:
25:                 r, c = st.pop()
26:                 if r == 0 or c == 0 or r == h - 1 or c == w - 1:
27:                     touches = True
28:                 for rr, cc in neighbors4(r, c):
29:                     if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:
30:                         vis[rr, cc] = True
31:                         st.append((rr, cc))
32:             if not touches:
33:                 holes += 1
34:     return holes
