+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+TRANSFORM_MODES = ("lr", "ud", "rot180")
+PALETTE = tuple(range(10))
+MIN_REGION_ROWS = 2
+MAX_REGION_ROWS = 3
+MIN_REGION_COLS = 2
+MAX_REGION_COLS = 4
+MIN_REGION_HEIGHT = 5
+MAX_CANVAS_SIZE = 30
+GENERATION_ATTEMPTS = 300
+REGION_ATTEMPTS = 120
