+                for color, count in zip(values.tolist(), counts.tolist())
+                if int(color) != bg
+            }
+            marker_candidates = [color for color, count in count_map.items() if count == 2]
+            assert len(marker_candidates) == 1, "each region must expose exactly one marker color"
