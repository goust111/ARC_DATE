+            marker_points = np.argwhere(region == marker_color)
+            assert marker_points.shape == (2, 2)
+
+            payload = region.copy()
+            payload[payload == marker_color] = bg
+            out[r0:r1, c0:c1] = _apply_transform(payload, _mode_from_markers(marker_points))
+
+    return out
+
