  "type": "transform_in_place",
  "src": "vertical frame containing one complete color glyph and one or more same-row two-pixel endpoint markers of other colors",
  "transform": "erase the complete glyph; expand each endpoint marker pair into that marker color's learned glyph template anchored on the marker row"
}
