+import random
+from collections import deque
+from math import gcd
+
+import numpy as np
+
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SHAPE_LIBRARY = [
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[1, 0], [1, 0], [1, 1]], dtype=bool),
