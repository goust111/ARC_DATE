+    for rot in range(4):
+        turned = np.rot90(base, rot)
+        for variant in [turned, np.fliplr(turned)]:
+            key = (
+                int(variant.shape[0]),
+                int(variant.shape[1]),
+                variant.astype(np.uint8).tobytes(),
