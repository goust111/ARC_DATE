+def compress_blocks(mask: np.ndarray, block: int) -> np.ndarray | None:
+    h, w = mask.shape
+    if block <= 1 or h % block != 0 or w % block != 0:
+        return None
+    tiles = mask.reshape(h // block, block, w // block, block)
+    coarse = tiles[:, 0, :, 0]
+    if np.all(tiles == coarse[:, None, :, None]):
+        return coarse.copy()
+    return None
+
