+def normalize_shape(mask: np.ndarray) -> np.ndarray:
+    cur = mask.astype(bool)
+    while True:
+        block = run_length_gcd(cur)
+        nxt = compress_blocks(cur, block)
+        if nxt is None or nxt.shape == cur.shape:
