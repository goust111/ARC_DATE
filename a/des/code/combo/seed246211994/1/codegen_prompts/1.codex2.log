+def run_length_gcd(mask: np.ndarray) -> int:
+    arr = mask.astype(np.uint8)
+    g = 0
+    for axis in [arr, arr.T]:
+        for line in axis:
+            run = 1
+            for idx in range(1, len(line)):
+                if line[idx] == line[idx - 1]:
+                    run += 1
+                else:
+                    g = gcd(g, int(run))
+                    run = 1
+            g = gcd(g, int(run))
+    return max(1, int(g))
