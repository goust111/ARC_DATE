+def fill_hole_rings(out: np.ndarray, hole: dict, color: int, layers: int, bg: int) -> None:
+    r0, c0, r1, c1 = hole["bbox"]
+    for r, c in hole["coords"]:
+        layer = min(r - r0, r1 - r, c - c0, c1 - c)
+        out[r, c] = int(color) if layer < int(layers) else int(bg)
