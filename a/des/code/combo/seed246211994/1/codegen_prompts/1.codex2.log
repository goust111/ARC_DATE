+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return {
+        "coords": [(int(r), int(c)) for r, c in coords],
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "mask": mask,
+        "size": int(len(coords)),
+        "color": None if color is None else int(color),
