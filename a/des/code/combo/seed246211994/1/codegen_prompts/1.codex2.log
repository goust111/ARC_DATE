+
+
+def extract_frame_holes(grid: np.ndarray, frame: dict, bg: int) -> list[dict]:
+    r0, c0, r1, c1 = frame["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    holes = []
+    for comp in find_bool_components(sub == bg):
