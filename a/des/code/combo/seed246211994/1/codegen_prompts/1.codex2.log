+HOLE_COUNT_CHOICES = [1, 2]
+FRAME_BORDER_CHOICES = [2, 3]
+GEN_RETRIES = 400
+PACK_RETRIES = 120
+SPRITE_PLACE_RETRIES = 160
+GRID_MAX_SIDE = 30
+GRID_MIN_SIDE = 22
