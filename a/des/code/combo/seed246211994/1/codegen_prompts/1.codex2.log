+    inp = np.full((h, w), bg, dtype=int)
+    out = np.full((h, w), bg, dtype=int)
+
+    fr0, fc0, fr1, fc1 = spec["frame_bbox"]
+    inp[fr0 : fr1 + 1, fc0 : fc1 + 1] = frame_color
