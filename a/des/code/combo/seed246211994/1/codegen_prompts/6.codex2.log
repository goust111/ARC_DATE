+def _components(mask):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
