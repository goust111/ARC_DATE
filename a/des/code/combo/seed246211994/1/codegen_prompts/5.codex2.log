+    num_colors = len(colors)
+    max_shape = min(MAX_SHAPE_SIZE, max(2, (height * width) // num_colors))
+    min_total = max(height + width - 1, num_colors + 2)
+    max_total = min((height * width) // 2, num_colors * max_shape)
+    if min_total > max_total:
