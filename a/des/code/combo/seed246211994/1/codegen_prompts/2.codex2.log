+def _paint_scene(
+    bg: int,
+    ordering: list[int],
+    height: int,
+    width: int,
+    bboxes: list[tuple[int, int, int, int]],
+) -> tuple[np.ndarray, dict[int, tuple[int, int, int, int]]]:
