+
+PALETTE = tuple(range(10))
+MIN_RECT_COUNT = 3
+MAX_RECT_COUNT = 5
+MIN_SIDE = 5
+MAX_SIDE = 10
+MAX_SHIFT = 3
+GRID_MIN = 14
+GRID_MAX = 32
+MARGIN_MIN = 1
+MARGIN_MAX = 6
