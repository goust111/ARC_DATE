+    if not _passes_oracle(grid, ordering):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
