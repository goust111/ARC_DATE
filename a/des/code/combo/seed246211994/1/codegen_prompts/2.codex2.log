+
+
+def _randint(rng: np.random.Generator, lo: int, hi: int) -> int:
+    return int(rng.integers(int(lo), int(hi) + 1))
+
+
+def _sample_colors(rng: np.random.Generator) -> tuple[int, list[int]]:
+    bg = _randint(rng, 0, 9)
