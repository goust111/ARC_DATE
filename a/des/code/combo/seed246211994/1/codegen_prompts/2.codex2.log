+    bboxes = []
+    for r, c, h, w in rects:
+        bbox = (top + r, left + c, top + r + h - 1, left + c + w - 1)
+        bboxes.append(_transform_bbox(bbox, height, width, flip_v, flip_h))
+    return height, width, bboxes
