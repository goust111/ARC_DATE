  90:         assert local_c0 == template_left
  91:         assert sprite_mask.shape == template_mask.shape
  92:         assert np.array_equal(sprite_mask, template_mask)
  93:         assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])
