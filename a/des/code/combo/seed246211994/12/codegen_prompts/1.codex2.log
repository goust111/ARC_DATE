+    return [int(seq[int(i)]) for i in idx]
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q = deque([start])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr, cc = r + dr, c + dc
