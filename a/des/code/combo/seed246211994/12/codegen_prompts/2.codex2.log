+    legend_mask = _make_legend(grid, bg, rules, side, legend_r0)
+
+    occ = np.zeros((h, w), dtype=bool)
+    occ[:, :2] = side == "right"
+    occ[:, -2:] = side == "left"
+    if side == "left":
+        occ[legend_r0:legend_r1, :3] = True
+    else:
+        occ[legend_r0:legend_r1, -3:] = True
+
+    col_lo, col_hi = _field_bounds(side, w)
