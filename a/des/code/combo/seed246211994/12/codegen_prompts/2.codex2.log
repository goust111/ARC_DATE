+
+def _transform_color(color: int, rules: list[tuple[int, int]]) -> tuple[int, int]:
+    current = int(color)
+    steps = 0
+    for src, dst in rules:
+        if current == src:
+            current = dst
+            steps += 1
+    return current, steps
