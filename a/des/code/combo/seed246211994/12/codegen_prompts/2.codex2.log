+MAX_GENERATION_ATTEMPTS = 400
+GRID_H_RANGE = (9, 15)
+GRID_W_RANGE = (13, 20)
+RULE_COUNT_RANGE = (3, 5)
+EXTRA_OBJECTS_RANGE = (1, 3)
+PALETTE = tuple(range(10))
