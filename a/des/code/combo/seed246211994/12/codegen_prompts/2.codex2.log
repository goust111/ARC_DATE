+        return None
+
+    if not _background_is_dominant(grid, bg):
+        return None
+
+    out = _apply_rules(grid, rules, legend_mask, bg)
+    changed = ((grid != out) & ~legend_mask).sum()
+    unchanged_fg = ((grid == out) & (grid != bg) & ~legend_mask).sum()
+    if changed == 0 or unchanged_fg == 0:
