+            dtype=bool,
+        )
+    elif kind == "tee":
+        mask = np.array(
+            [
+                [1, 1, 1],
+                [0, 1, 0],
+                [0, 1, 0],
+            ],
+            dtype=bool,
+        )
+    else:
+        steps = rng.randint(2, 4)
+        mask = np.zeros((steps, steps + 1), dtype=bool)
+        for i in range(steps):
+            mask[i, i : i + 2] = True
