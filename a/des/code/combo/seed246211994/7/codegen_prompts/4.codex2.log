+
+def _extract_edges(grid: np.ndarray, frames: list[dict[str, object]], red_lookup: dict[tuple[int, int], int]) -> set[tuple[int, int]]:
+    blue_components = _components(grid == BLUE)
+    edges: set[tuple[int, int]] = set()
+
+    for comp in blue_components:
+        touched: set[int] = set()
+        for rr, cc in comp:
+            r = int(rr)
+            c = int(cc)
+            for dr, dc in ORTHO:
+                frame_id = red_lookup.get((r + dr, c + dc))
+                if frame_id is not None:
+                    touched.add(int(frame_id))
+        assert len(touched) == 2
+        a, b = sorted(touched)
+        edges.add((int(a), int(b)))
+
+    n = len(frames)
+    assert len(blue_components) == n
+    assert len(edges) == n
+
+    degree = [0] * n
+    graph = {i: set() for i in range(n)}
+    for a, b in edges:
+        degree[a] += 1
+        degree[b] += 1
+        graph[a].add(b)
+        graph[b].add(a)
+    assert all(d == 2 for d in degree)
+
+    seen = set()
+    stack = [0]
+    while stack:
+        node = stack.pop()
+        if node in seen:
+            continue
+        seen.add(node)
+        stack.extend(graph[node] - seen)
+    assert len(seen) == n
+    return edges
