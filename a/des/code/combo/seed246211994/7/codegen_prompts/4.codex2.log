+RED = 2
+BLUE = 1
+MASK_COLORS = (3, 4, 5, 6, 7, 8, 9)
+ORTHO = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG8 = ORTHO + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
