+def _frame_touch_halo(frame: dict[str, object], h: int, w: int) -> set[tuple[int, int]]:
+    border_cells = frame["border_cells"]
+    halo: set[tuple[int, int]] = set()
+    for r, c in border_cells:
+        for dr, dc in ORTHO:
+            nr = r + dr
+            nc = c + dc
