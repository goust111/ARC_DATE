+def _gen_paint_ring(grid: np.ndarray, center: tuple[int, int], parity: int, color: int, bg: int) -> None:
+    rr, cc = _gen_actual(center, parity)
+    grid[rr - 1 : rr + 2, cc - 1 : cc + 2] = color
