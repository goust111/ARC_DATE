+    assert valid
+    return valid
+
+
+def _pick_heights(num_rods: int) -> list[int]:
+    max_start = MAX_HEIGHT_IN_CHAIN - 2 * (num_rods - 1)
+    starts = list(range(2, max_start + 1, 2))
