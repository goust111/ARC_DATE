+    mask[axis_row, :] = True
+    mask[:, arm_col] = True
+    steps = random.randint(0, max(1, (h * w) // 8))
+    mask = _expand_symmetric(mask, "H", steps)
+    assert _symmetry_kind(mask) == "H"
+    return mask
