        mask[axis_rows, :] = True
        choices = [c for c in range(w) if c != w - 1 - c]
        arm_col = random.choice(choices)
        mask[:, arm_col] = True
        mirror_col = w - 1 - arm_col
        forbidden.update(_gen_orbit("H", mask.shape, 0, mirror_col))
    elif kind == "V":
