+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+RED = 2
+BLUE = 1
+GREEN = 3
+MAGENTA = 6
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[np.argmax(counts)])
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(cells, dtype=int))
+
+    return components
+
+
+def _component_mask(coords: np.ndarray) -> np.ndarray:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _symmetry_kind(mask: np.ndarray) -> str | None:
+    horizontal = bool(np.array_equal(mask, mask[::-1, :]))
+    vertical = bool(np.array_equal(mask, mask[:, ::-1]))
+    diagonal = bool(
+        mask.shape[0] == mask.shape[1]
+        and (np.array_equal(mask, mask.T) or np.array_equal(mask, np.fliplr(mask).T))
+    )
+
+    if sum((horizontal, vertical, diagonal)) != 1:
+        return None
+    if horizontal:
+        return "H"
+    if vertical:
+        return "V"
+    return "D"
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor red objects by reflection-symmetry type and erase singleton noise.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+
+    bg = _dominant_color(g)
+    extra_colors = set(map(int, np.unique(g))) - {bg}
+    assert extra_colors == {RED}, "expected red to be the only foreground color"
+
