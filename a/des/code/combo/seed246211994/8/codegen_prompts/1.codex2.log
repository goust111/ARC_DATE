+                if mask[r, c]:
+                    continue
+                orbit = _orbit(kind, mask.shape, r, c)
+                if orbit in seen or not _touches(mask, orbit):
+                    continue
+                seen.add(orbit)
+                trial = mask.copy()
+                for rr, cc in orbit:
+                    trial[rr, cc] = True
+                if _symmetry_kind(trial) == kind:
+                    choices.append(orbit)
