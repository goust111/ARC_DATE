+        max(sprite.shape[1] for sprite in sprites.values()) + 2,
+        int(np.ceil(np.sqrt(approx_area))),
+    )
+    inner_h = rng.randint(side_min, min(14, side_min + 3))
+    inner_w = rng.randint(side_min, min(14, side_min + 4))
