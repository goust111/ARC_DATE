+def _can_place(occ: np.ndarray, r: int, c: int, h: int, w: int, pad: int) -> bool:
+    rr0 = r - pad
+    cc0 = c - pad
+    rr1 = r + h + pad - 1
+    cc1 = c + w + pad - 1
