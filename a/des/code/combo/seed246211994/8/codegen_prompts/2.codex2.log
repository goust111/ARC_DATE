+    out = np.full(g.shape, bg, dtype=int)
+    out[fr0 : fr1 + 1, fc0 : fc1 + 1] = bg
+    out[fr0, fc0 : fc1 + 1] = frame_color
+    out[fr1, fc0 : fc1 + 1] = frame_color
+    out[fr0 : fr1 + 1, fc0] = frame_color
+    out[fr0 : fr1 + 1, fc1] = frame_color
+
