+def _random_connected_sprite(rng: random.Random) -> np.ndarray:
+    box_h = rng.randint(2, 5)
+    box_w = rng.randint(2, 5)
+    max_area = min(box_h * box_w, 7)
+    area = rng.randint(3, max_area)
+    cells = {(0, 0)}
+    frontier = set()
+    for dr, dc in DIR4:
+        nr, nc = dr, dc
+        if 0 <= nr < box_h and 0 <= nc < box_w:
+            frontier.add((nr, nc))
+    while len(cells) < area:
+        if not frontier:
+            return _random_connected_sprite(rng)
+        cell = rng.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        for dr, dc in DIR4:
+            nr, nc = cell[0] + dr, cell[1] + dc
+            if 0 <= nr < box_h and 0 <= nc < box_w and (nr, nc) not in cells:
+                frontier.add((nr, nc))
