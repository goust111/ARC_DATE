+    rng.shuffle(rows)
+    patch = np.zeros((len(rows), 2), dtype=int)
+    for i, idx in enumerate(rows):
+        patch[i, 0] = placeholder_colors[idx]
+        patch[i, 1] = output_colors[idx]
+    return patch
+
