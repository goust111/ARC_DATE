+    for r, c in cells:
+        arr[r, c] = True
+    coords = np.argwhere(arr)
+    r0, c0, r1, c1 = _bbox(coords)
+    arr = arr[r0 : r1 + 1, c0 : c1 + 1]
+    if not arr[0, 0]:
