+
+    if canvas_h - frame_h < 4 or canvas_w - frame_w < 4:
+        return None
+    fr0 = rng.randint(2, canvas_h - frame_h - 2)
+    fc0 = rng.randint(2, canvas_w - frame_w - 2)
+    fr1 = fr0 + frame_h - 1
+    fc1 = fc0 + frame_w - 1
+
