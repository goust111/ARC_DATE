+    for _ in range(OUTSIDE_PLACE_RETRIES):
+        r = rng.randint(1, grid.shape[0] - h - 2)
+        c = rng.randint(1, grid.shape[1] - w - 2)
+        if not _can_place(occ, r, c, h, w, pad=1):
+            continue
+        sub = grid[r : r + h, c : c + w]
