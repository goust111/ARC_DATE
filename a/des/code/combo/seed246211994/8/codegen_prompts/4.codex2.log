+    tr, tc = end
+    path = [(r, c)]
+    axes = ((tr - r, 0), (0, tc - c))
+    if not vertical_first:
+        axes = axes[::-1]
+    for dr_total, dc_total in axes:
+        if dr_total:
+            step = 1 if dr_total > 0 else -1
+            for _ in range(abs(dr_total)):
