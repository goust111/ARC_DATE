+    if not np.array_equal(actual, expected):
+        return None
+
+    detected_bbox = _legend_bbox(grid, bg)
+    if detected_bbox != legend_bbox:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
