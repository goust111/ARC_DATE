+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in neighbors:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
