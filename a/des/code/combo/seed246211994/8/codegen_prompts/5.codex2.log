+def _parse_sprite(grid: np.ndarray, coords: np.ndarray) -> Sprite | None:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3 or h % 2 == 0 or w % 2 == 0:
+        return None
