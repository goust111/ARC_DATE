+GRID_H_RANGE = (18, 25)
+GRID_W_RANGE = (18, 25)
+TOTAL_SPRITES_CHOICES = (4, 5, 6)
+SPRITE_SHAPES = ((3, 3), (3, 5), (5, 3), (5, 5))
