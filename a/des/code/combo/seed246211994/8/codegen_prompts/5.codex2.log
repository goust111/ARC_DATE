+def _can_place_bbox(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, gap: int) -> bool:
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
