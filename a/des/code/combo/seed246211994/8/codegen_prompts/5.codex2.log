+def _endpoint_options(spec: dict[str, int], H: int, W: int) -> list[tuple[str, tuple[int, int]]]:
+    r0, c0, h, w = spec["r0"], spec["c0"], spec["h"], spec["w"]
+    rm = r0 + h // 2
+    cm = c0 + w // 2
