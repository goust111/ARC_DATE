+    elif style == "diagonal":
+        k = rng.randint(2, min(4, len(colors)))
+        palette = rng.sample(colors, k)
+        for r in range(side):
+            for c in range(side):
+                tile[r, c] = palette[(r - c) % k]
+
+    else:
