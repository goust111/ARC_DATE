+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+GEN_ATTEMPTS = 400
+MASK_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 120
+MASK_H_RANGE = (3, 7)
+MASK_W_RANGE = (3, 7)
+TILE_SIDE_RANGE = (2, 5)
