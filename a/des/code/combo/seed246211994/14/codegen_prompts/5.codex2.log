+def _generate_mask(rng: random.Random) -> np.ndarray:
+    for _ in range(MASK_ATTEMPTS):
+        h = rng.randint(*MASK_H_RANGE)
+        w = rng.randint(*MASK_W_RANGE)
+        mask = np.ones((h, w), dtype=bool)
