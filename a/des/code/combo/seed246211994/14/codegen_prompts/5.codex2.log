+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((int(cr), int(cc)))
+                for dr, dc in dirs:
+                    nr = int(cr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bool(mask[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _analyze_objects(grid: np.ndarray) -> tuple[int, dict, dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    comps = _components(g != bg, conn8=True)
+    assert len(comps) == 2, "input must contain exactly two 8-connected foreground objects"
+
+    infos = []
+    for coords in comps:
+        box = _bbox(coords)
+        patch = _crop_bbox(g, box)
+        fg_colors = sorted(set(map(int, patch[patch != bg].ravel())))
+        infos.append(
+            {
+                "coords": coords,
+                "bbox": box,
+                "patch": patch,
+                "fg_colors": fg_colors,
+                "area": len(coords),
+                "shape": patch.shape,
+            }
+        )
+
+    mask_candidates = [info for info in infos if len(info["fg_colors"]) == 1]
+    tile_candidates = [
+        info
+        for info in infos
+        if len(info["fg_colors"]) >= 2 and info["shape"][0] == info["shape"][1]
+    ]
