+    near_col = sep + source_sign
+    far_col = 0 if source_sign < 0 else w - 1
+    moves = []
+    for r, (c, color) in source_by_row.items():
+        dst_c = near_col if color == ref_by_row[r] else far_col
+        moves.append((r, c, r, int(dst_c), color))
