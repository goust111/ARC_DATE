+            before = int(np.sum(grid[:r, :] == color))
+            after = int(np.sum(grid[r + 1 :, :] == color))
+            if (before > 0) ^ (after > 0):
+                ref_sign = -1 if before > 0 else 1
+                candidates.append(("h", int(r), color, ref_sign))
