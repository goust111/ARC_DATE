+# --------------- generator ---------------
+
+ALL_COLORS = tuple(range(10))
+ORIENTATIONS = ("h", "v")
+REF_SIGNS = (-1, 1)
+
+GRID_MIN = 8
+GRID_MAX = 18
+REF_DEPTH_MIN = 2
+REF_DEPTH_MAX = 8
+SOURCE_DEPTH_MIN = 3
+SOURCE_DEPTH_MAX = 13
