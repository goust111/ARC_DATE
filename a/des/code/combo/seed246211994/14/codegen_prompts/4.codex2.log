+def _invert_moves(out: np.ndarray, moves: list[Move], source_bg: int) -> np.ndarray:
+    inp = out.copy()
+    for sr, sc, dr, dc, _ in moves:
+        if (sr, sc) != (dr, dc):
+            inp[dr, dc] = source_bg
+    for sr, sc, _, _, color in moves:
+        inp[sr, sc] = color
+    return inp
