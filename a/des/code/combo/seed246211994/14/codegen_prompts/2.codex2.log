    variants = []
    shape = np.asarray(mask, dtype=bool)
    for k in range(4):
        rotated = np.rot90(shape, k)
        for variant in (rotated, np.fliplr(rotated)):
            arr = np.ascontiguousarray(variant)
            variants.append((tuple(map(int, arr.shape)), arr.tobytes()))
    return min(variants)


