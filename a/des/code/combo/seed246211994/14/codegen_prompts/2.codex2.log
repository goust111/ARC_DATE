+def find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
