+AREA_MAX = 10
+MIN_FILL_X10 = 4
+MIN_COL_GAP = 1
+MIN_TOP_BOTTOM_GAP = 4
+MAX_GENERATION_ATTEMPTS = 400
+DUPLICATE_LAYOUTS = [(2,), (3,), (2, 2)]
