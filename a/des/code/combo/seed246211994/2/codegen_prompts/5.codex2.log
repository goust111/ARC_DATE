+        rows_out.append(panels_out[idx])
+        if idx != total_panels - 1:
+            rows_in.append(np.full((1, panel_w), sep_color, dtype=int))
+            rows_out.append(np.full((1, panel_w), sep_color, dtype=int))
+    return np.vstack(rows_in), np.vstack(rows_out)
+
