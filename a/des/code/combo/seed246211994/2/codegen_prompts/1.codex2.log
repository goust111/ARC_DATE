+
+    expected = _expected_from_records(grid, placed_records)
+    actual = main(grid)
+    if not bool(np.array_equal(actual, expected)):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

