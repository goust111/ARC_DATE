+    outline_colors = np.unique(patch[outline])
+    fill_colors = np.unique(patch[interior])
+    if len(outline_colors) != 1 or len(fill_colors) != 1:
+        return None
+
+    outline_color = int(outline_colors[0])
+    fill_color = int(fill_colors[0])
+    if outline_color == fill_color:
