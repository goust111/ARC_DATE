+GRID_MIN_SIDE = 22
+GRID_MAX_SIDE = 30
+PAIR_COUNT_MIN = 1
+PAIR_COUNT_MAX = 3
+UNPAIRED_PRESENT_PROB = 0.5
+MAX_UNPAIRED = 2
+SHAPE_ATTEMPTS = 120
