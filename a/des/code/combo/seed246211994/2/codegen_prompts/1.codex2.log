+
+    return {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "outline_color": outline_color,
+        "fill_color": fill_color,
+        "shape_key": _canonical_mask(outline),
+        "outline_mask": outline,
+        "interior_mask": interior,
