+    interior = np.zeros((h, w), dtype=bool)
+    for r, c in np.argwhere(component_mask):
+        rr, cc = int(r), int(c)
+        if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+            continue
+        if bool(component_mask[rr - 1 : rr + 2, cc - 1 : cc + 2].all()):
+            interior[rr, cc] = True
