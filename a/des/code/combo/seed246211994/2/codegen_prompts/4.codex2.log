+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in _DIRS4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
