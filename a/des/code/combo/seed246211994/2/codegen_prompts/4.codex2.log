+    expected = np.full((grid_h, grid_w), int(bg), dtype=int)
+    reserved = np.zeros((grid_h, grid_w), dtype=bool)
+
+    rng.shuffle(objects)
+    for obj in objects:
+        mask = obj["mask"]
+        patch_h, patch_w = mask.shape
+        positions = _valid_positions(reserved, int(patch_h), int(patch_w))
+        if not positions:
