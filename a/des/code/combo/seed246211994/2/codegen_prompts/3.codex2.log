import random
import numpy as np

RING = (
    (0, 2), (0, 3), (0, 4),
    (1, 1), (1, 5),
    (2, 0), (2, 6),
    (3, 0), (3, 6),
    (4, 0), (4, 6),
    (5, 1), (5, 5),
    (6, 2), (6, 3), (6, 4),
)
SIZE = 7
VISIBLE_RANGE = (6, 13)
GRID_H_RANGE = (12, 18)
GRID_W_RANGE = (12, 20)
RING_COUNT_RANGE = (2, 4)
COLOR_VALUES = tuple(range(10))
MAX_ATTEMPTS = 500


def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[counts.argmax()])


def matching_offsets(coords):
    counts = {}
    for r, c in coords:
        for dr, dc in RING:
            off = (r - dr, c - dc)
            counts[off] = counts.get(off, 0) + 1
    return [off for off, n in counts.items() if n == len(coords)]


def expected_cells(offset):
    r0, c0 = offset
    return {(r0 + dr, c0 + dc) for dr, dc in RING}


def ring_cells(offset, h, w):
    return {(r, c) for r, c in expected_cells(offset) if 0 <= r < h and 0 <= c < w}


def is_clipped(offset, h, w):
    return len(ring_cells(offset, h, w)) < len(RING)


def find_fragments(g, bg):
    frags = {}
    for color in np.unique(g):
        color = int(color)
        if color == bg:
            continue
        coords = [tuple(map(int, xy)) for xy in np.argwhere(g == color)]
        offs = matching_offsets(coords)
        assert len(offs) == 1, (color, offs, len(coords))
        frags[color] = (offs[0], set(coords))
    assert len(frags) >= 2
    return frags


def order_bottom_to_top(g, frags):
    h, w = g.shape
    colors = set(frags)
    below_to_above = {c: set() for c in colors}
    indeg = {c: 0 for c in colors}
    for color, (offset, visible) in frags.items():
        for r, c in expected_cells(offset) - visible:
            if not (0 <= r < h and 0 <= c < w):
                continue
            cover = int(g[r, c])
            assert cover in colors
            if cover not in below_to_above[color]:
                below_to_above[color].add(cover)
                indeg[cover] += 1
    order = []
    remaining = set(colors)
    while remaining:
        bottoms = [c for c in remaining if indeg[c] == 0]
        assert len(bottoms) == 1, (indeg, remaining)
        color = bottoms[0]
        order.append(color)
        remaining.remove(color)
        for above in below_to_above[color]:
            indeg[above] -= 1
    return order


def main(grid):
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    frags = find_fragments(g, bg)
    order = order_bottom_to_top(g, frags)
    out = np.full((SIZE * len(order), SIZE), bg, dtype=int)
    for i, color in enumerate(order):
        for dr, dc in RING:
            out[i * SIZE + dr, dc] = color
    return out


def render_scene(h, w, bg, colors_top_to_bottom, offsets_top_to_bottom):
    g = np.full((h, w), bg, dtype=int)
    for color, offset in reversed(list(zip(colors_top_to_bottom, offsets_top_to_bottom))):
        for r, c in ring_cells(offset, h, w):
            g[r, c] = color
    return g


def has_unique_offset(cells, offset):
    return matching_offsets(list(cells)) == [offset]


def offset_positions(h, w, allow_clipped):
    if allow_clipped:
        rows = range(-(SIZE - 1), h)
        cols = range(-(SIZE - 1), w)
    else:
        rows = range(0, h - SIZE + 1)
        cols = range(0, w - SIZE + 1)
    return rows, cols


def initial_offsets(h, w, allow_clipped):
    rows, cols = offset_positions(h, w, allow_clipped)
    out = []
    for r0 in rows:
        for c0 in cols:
            off = (r0, c0)
            cells = ring_cells(off, h, w)
            if not VISIBLE_RANGE[0] <= len(cells) <= len(RING):
                continue
            if not has_unique_offset(cells, off):
                continue
            out.append(off)
    return out


def candidate_offsets(h, w, allow_clipped, offsets, higher_cells):
    rows, cols = offset_positions(h, w, allow_clipped)
    covered = set().union(*higher_cells)
    covered_before_prev = set().union(*higher_cells[:-1]) if len(higher_cells) > 1 else set()
    visible_prev = higher_cells[-1] - covered_before_prev
    out = []
    for r0 in rows:
        for c0 in cols:
            off = (r0, c0)
            if off in offsets:
                continue
            cells = ring_cells(off, h, w)
            visible = cells - covered
            if not VISIBLE_RANGE[0] <= len(visible) <= VISIBLE_RANGE[1]:
                continue
            if not (cells & visible_prev):
                continue
            if not has_unique_offset(visible, off):
                continue
            out.append(off)
    return out


def build_offsets(h, w, ring_count, want_clipped):
    candidates = initial_offsets(h, w, allow_clipped=want_clipped)
    if not candidates:
        return None
    top = random.choice(candidates)
    offsets = [top]
    higher_cells = [ring_cells(top, h, w)]
    for _ in range(1, ring_count):
        cands = candidate_offsets(h, w, allow_clipped=want_clipped, offsets=offsets, higher_cells=higher_cells)
        if not cands:
            return None
        off = random.choice(cands)
        offsets.append(off)
        higher_cells.append(ring_cells(off, h, w))
    if want_clipped and not any(is_clipped(off, h, w) for off in offsets):
        return None
    if not want_clipped and any(is_clipped(off, h, w) for off in offsets):
        return None
    return offsets


def attempt():
    h = random.randint(*GRID_H_RANGE)
    w = random.randint(*GRID_W_RANGE)
    ring_count = random.randint(*RING_COUNT_RANGE)
    want_clipped = random.choice([False, True])
    bg = random.choice(COLOR_VALUES)
    colors_top_to_bottom = random.sample([c for c in COLOR_VALUES if c "'!= bg], ring_count)
    offsets = build_offsets(h, w, ring_count, want_clipped)
    if offsets is None:
        return None
    g = render_scene(h, w, bg, colors_top_to_bottom, offsets)
    vals, counts = np.unique(g, return_counts=True)
    if int(vals[counts.argmax()]) != bg:
        return None
    expected = np.full((SIZE * ring_count, SIZE), bg, dtype=int)
    for i, color in enumerate(reversed(colors_top_to_bottom)):
        for dr, dc in RING:
            expected[i * SIZE + dr, dc] = color
    actual = main(g)
    if not np.array_equal(actual, expected):
        print('"'mismatch')
        print(h, w, ring_count, want_clipped, bg, colors_top_to_bottom, offsets)
        print(g)
        print(actual)
        print(expected)
        return None
    return g

success = 0
for i in range(500):
    grid = attempt()
    if grid is not None:
        success += 1
print('success', success)
