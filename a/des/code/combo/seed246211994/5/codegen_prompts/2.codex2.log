+    fg = g != int(bg)
+    fg_components = _components(fg, connectivity=4)
+
+    fixed_mask = np.zeros((h, w), dtype=bool)
+    fixed_components: list[dict] = []
+    movable_components: list[dict] = []
+
+    for coords in fg_components:
