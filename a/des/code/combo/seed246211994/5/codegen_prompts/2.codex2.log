+            vis[r0, c0] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                pts.append((int(r), int(c)))
+                for dr, dc in neigh:
+                    rr = int(r + dr)
+                    cc = int(c + dc)
