+        bg=bg,
+        frame_color=frame_color,
+        plug_color=plug_color,
+        handle_color=handle_color,
+        frame_w=int(spec["frame_w"]),
+        top_h=int(spec["top_h"]),
+        bot_h=int(spec["bot_h"]),
+        notch_n=int(spec["notch_n"]),
+        handle_area=int(spec["handle_area"]),
