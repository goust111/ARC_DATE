+
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+ASYMMETRIC = 0
+SINGLE_AXIS = 1
+DUAL_AXIS = 2
+
+OUTLINE_COLORS = {
+    ASYMMETRIC: RED,
+    SINGLE_AXIS: YELLOW,
+    DUAL_AXIS: GREEN,
+}
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# --------------- solver ---------------
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(counts.argmax())])
+
+
+def _color_components(grid: np.ndarray, bg: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+
+    return comps
+
+
+def _coords_to_mask(coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    rows = np.array([r for r, _ in coords], dtype=int)
+    cols = np.array([c for _, c in coords], dtype=int)
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    r1 = int(rows.max())
+    c1 = int(cols.max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[rows - r0, cols - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _classify_mask(mask: np.ndarray) -> int:
+    horizontal = bool(np.array_equal(mask, np.flipud(mask)))
+    vertical = bool(np.array_equal(mask, np.fliplr(mask)))
+    if horizontal and vertical:
+        return DUAL_AXIS
+    if horizontal or vertical:
+        return SINGLE_AXIS
+    return ASYMMETRIC
+
+
+def _paint_outline(
+    out: np.ndarray,
+    inp: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    color: int,
+    bg: int,
+) -> None:
+    h, w = inp.shape
