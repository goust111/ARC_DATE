+def _mask_is_filled_rectangle(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(mask.sum()) == int(r1 - r0 + 1) * int(c1 - c0 + 1)
+
