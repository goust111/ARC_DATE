+        col += side
+        if idx != len(ordered) - 1:
+            col += 1
+
+    return out
+
+
+def _is_valid_scene(grid: np.ndarray, bg: int, color_to_side: dict[int, int]) -> bool:
+    values, counts = np.unique(grid, return_counts=True)
