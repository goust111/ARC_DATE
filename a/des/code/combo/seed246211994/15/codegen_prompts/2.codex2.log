+    occupied: np.ndarray, r0: int, c0: int, rh: int, rw: int, gap: int
+) -> bool:
+    h, w = occupied.shape
+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(h, r0 + rh + gap)
+    cc1 = min(w, c0 + rw + gap)
+    return not occupied[rr0:rr1, cc0:cc1].any()
+
