+import numpy as np
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_filled_rectangles(grid: np.ndarray) -> list[dict[str, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    rects: list[dict[str, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            if len(coords) < 4:
+                continue
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            hh = r1 - r0 + 1
+            ww = c1 - c0 + 1
+            area = hh * ww
+            if hh > 1 and ww > 1 and len(coords) == area:
+                rects.append(
+                    {
+                        "r0": r0,
+                        "c0": c0,
+                        "r1": r1,
+                        "c1": c1,
+                        "h": hh,
+                        "w": ww,
+                        "area": area,
+                        "color": color,
+                    }
+                )
+
+    rects.sort(key=lambda item: (-item["area"], item["r0"], item["c0"], item["color"]))
+    return rects
+
+
+def _rect_mask(shape: tuple[int, int], rects: list[dict[str, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for rect in rects:
+        mask[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = True
+    return mask
