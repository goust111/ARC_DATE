                    continue
            else:
                assert largest_area is not None
                if area >= largest_area or area < 4:
                    continue

            r0 = int(rng.integers(0, h - rh + 1))
            c0 = int(rng.integers(0, w - rw + 1))
            if not _can_place_rect(occupied, r0, c0, rh, rw, RECT_GAP):
                continue

            rect = {
                "r0": r0,
                "c0": c0,
                "r1": r0 + rh - 1,
                "c1": c0 + rw - 1,
                "h": rh,
                "w": rw,
                "area": area,
                "color": int(rect_colors[idx]),
