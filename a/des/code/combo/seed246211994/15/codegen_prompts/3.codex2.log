def _place_bbox(used: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
    ph, pw = used.shape
    rr0 = max(0, r0 - 1)
    cc0 = max(0, c0 - 1)
    rr1 = min(ph, r0 + h + 1)
    cc1 = min(pw, c0 + w + 1)
    used[rr0:rr1, cc0:cc1] = True


def _can_place_bbox(used: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
    ph, pw = used.shape
    if r0 < 0 or c0 < 0 or r0 + h > ph or c0 + w > pw:
        return False
    rr0 = max(0, r0 - 1)
    cc0 = max(0, c0 - 1)
    rr1 = min(ph, r0 + h + 1)
    cc1 = min(pw, c0 + w + 1)
    return not used[rr0:rr1, cc0:cc1].any()


def _add_target_object(
    panel: np.ndarray,
    used: np.ndarray,
    side: str,
    rng: random.Random,
    colors_in_use: set[int],
) -> bool:
    ph, pw = panel.shape
    want_hole = rng.random() < 0.65

    if side in ("top", "bottom"):
        min_h = 5 if want_hole else 3
        min_w = 5 if want_hole else 3
        max_h = min(ph - 2, 8)
        max_w = min(pw - 2, 9)
    else:
        min_h = 5 if want_hole else 3
        min_w = 5 if want_hole else 3
        max_h = min(ph - 2, 9)
        max_w = min(pw - 2, 8)

    if max_h < min_h or max_w < min_w:
        want_hole = False
        min_h = min_w = 3
        max_h = min(ph - 2, 8)
        max_w = min(pw - 2, 8)
    if max_h < min_h or max_w < min_w:
        return False

    panel_color = int(panel[0, 0])

    for _ in range(120):
        h = rng.randint(min_h, max_h)
        w = rng.randint(min_w, max_w)
        if side == "top":
            r0 = 0
            c0 = rng.randint(1, pw - w - 1)
        elif side == "bottom":
            r0 = ph - h
            c0 = rng.randint(1, pw - w - 1)
        elif side == "left":
            r0 = rng.randint(1, ph - h - 1)
            c0 = 0
        else:
            r0 = rng.randint(1, ph - h - 1)
            c0 = pw - w

        if not _can_place_bbox(used, r0, c0, h, w):
            continue

        mask = _make_target_mask(h, w, side, want_hole, rng)
        if mask is None:
            continue

        body_color = _rand_color(rng, colors_in_use | {panel_color})
        marker_color = _rand_color(rng, colors_in_use | {panel_color, body_color})
        colors_in_use.update({body_color, marker_color})

        local = panel[r0 : r0 + h, c0 : c0 + w]
        local[mask] = body_color
        _mark_contact_side(local, mask, side, marker_color)
        _place_bbox(used, r0, c0, h, w)
        return True
    return False


def _add_distractor(panel: np.ndarray, used: np.ndarray, rng: random.Random, colors_in_use: set[int]) -> bool:
    ph, pw = panel.shape
    if ph < 7 or pw < 7:
        return False
    panel_color = int(panel[0, 0])

    for _ in range(80):
        h = rng.randint(3, min(5, ph - 2))
        w = rng.randint(3, min(5, pw - 2))
        r0 = rng.randint(1, ph - h - 1)
        c0 = rng.randint(1, pw - w - 1)
        if not _can_place_bbox(used, r0, c0, h, w):
            continue

        mask = np.ones((h, w), dtype=bool)
        if h >= 4 and w >= 4 and rng.random() < 0.5:
            mask[1:-1, 1:-1] = False
            mask[1, 1] = True
        accent_side = rng.choice(SIDES)
        body_color = _rand_color(rng, colors_in_use | {panel_color})
        accent_color = _rand_color(rng, colors_in_use | {panel_color, body_color})
        colors_in_use.update({body_color, accent_color})

        local = panel[r0 : r0 + h, c0 : c0 + w]
        local[mask] = body_color
        if accent_side == "top":
            local[0, mask[0, :]] = accent_color
        elif accent_side == "bottom":
            local[-1, mask[-1, :]] = accent_color
        elif accent_side == "left":
            local[mask[:, 0], 0] = accent_color
        else:
            local[mask[:, -1], -1] = accent_color

        _place_bbox(used, r0, c0, h, w)
        return True
    return False


def _paint_panel(
    grid: np.ndarray,
    top: int,
    left: int,
    height: int,
    width: int,
    panel_color: int,
    rng: random.Random,
) -> bool:
    panel = grid[top : top + height, left : left + width]
    panel[:, :] = panel_color
    used = np.zeros((height, width), dtype=bool)
    colors_in_use: set[int] = set()

    target_count = rng.choices([1, 2, 3], weights=[3, 4, 2])[0]
    if min(height, width) < 9:
        target_count = min(target_count, 2)
    if min(height, width) < 7:
        target_count = 1

    sides = [rng.choice(SIDES) for _ in range(target_count)]
    hole_hits = 0
    for idx, side in enumerate(sides):
        if not _add_target_object(panel, used, side, rng, colors_in_use):
            return False
        before = panel.copy()
        # track visible hole branch from the just-placed object by comparing panel color count.
        if np.count_nonzero(before == panel_color) != np.count_nonzero(panel == panel_color):
            hole_hits += 1

    distractor_count = rng.choices([0, 1, 2], weights=[3, 3, 1])[0]
    for _ in range(distractor_count):
        _add_distractor(panel, used, rng, colors_in_use)

    return hole_hits >= 0


def _panel_slots(h: int, w: int, rng: random.Random) -> list[tuple[int, int, int, int]]:
    slots: list[tuple[int, int, int, int]] = []
    used = np.zeros((h, w), dtype=bool)
    panel_count = rng.choices([1, 2, 3], weights=[3, 4, 2])[0]

    for _ in range(panel_count):
        placed = False
        for _ in range(120):
            ph = rng.randint(7, min(13, h - 2))
            pw = rng.randint(7, min(13, w - 2))
            if ph >= h or pw >= w:
                continue
            r0 = rng.randint(1, h - ph - 1)
            c0 = rng.randint(1, w - pw - 1)
            rr0 = max(0, r0 - 2)
            cc0 = max(0, c0 - 2)
            rr1 = min(h, r0 + ph + 2)
            cc1 = min(w, c0 + pw + 2)
            if used[rr0:rr1, cc0:cc1].any():
                continue
            used[rr0:rr1, cc0:cc1] = True
            slots.append((r0, c0, ph, pw))
            placed = True
            break
        if not placed and not slots:
            return []
    return slots


def _valid_background_mode(grid: np.ndarray, bg: int) -> bool:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)]) == bg


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    h = rng.randint(18, 31)
    w = rng.randint(18, 31)
    bg = rng.randrange(10)
    grid = np.full((h, w), bg, dtype=int)

    slots = _panel_slots(h, w, rng)
    if not slots:
        return None

    panel_colors = rng.sample([color for color in range(10) if color != bg], k=len(slots))
    for (r0, c0, ph, pw), panel_color in zip(slots, panel_colors):
        if not _paint_panel(grid, r0, c0, ph, pw, panel_color, rng):
            return None

    if not _valid_background_mode(grid, bg):
        return None

    out = main(grid)
    if np.array_equal(out, grid):
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError(f"failed to generate valid input after {GEN_ATTEMPTS} attempts")

