+        out[r, c] = marker
+    return out
+
+
+def _component_count(mask: np.ndarray) -> int:
+    return len(_components(mask))
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    holes = 0
+    empty = ~mask
+    for comp in _components(empty):
+        if not _touches_boundary(comp, mask.shape):
+            holes += 1
+    return holes
+
