+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each side-marked object inside a monochrome panel to its boundary marker color.
+    """
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
