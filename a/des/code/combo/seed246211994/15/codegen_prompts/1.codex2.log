+    area = height * width
+    min_fg = max(len(colors), int(np.ceil(area * FOREGROUND_FRACTION_RANGE[0])))
+    max_fg = min(area - 1, int(np.floor(area * FOREGROUND_FRACTION_RANGE[1])))
+    if min_fg > max_fg:
+        return None
