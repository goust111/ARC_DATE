+MOTIF_COLOR_COUNT_RANGE = (1, 3)
+FOREGROUND_FRACTION_RANGE = (0.18, 0.42)
+DAMAGE_COUNT_CAP = 5
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _unique_mode(values: np.ndarray) -> int:
