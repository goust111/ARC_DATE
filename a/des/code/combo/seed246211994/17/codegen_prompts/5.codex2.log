    elif mode == 1:
        pixels = _layout_on_order(colors, counts, _snake_cell_order(height, width), rng)
    else:
        pixels = _layout_on_order(colors, counts, _column_cell_order(height, width), rng)

    assert pixels.shape == (area,)
    return pixels


