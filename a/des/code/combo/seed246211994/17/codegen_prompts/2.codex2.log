+    shapes = _sample_unique_shapes(rng, n_groups)
+    if shapes is None:
+        return None
+
+    grid = np.full((rows, cols), bg, dtype=int)
+    if not _place_objects(grid, shapes, counts, placeholder, rng):
+        return None
+    if not _validate_instance(grid):
+        return None
+    return grid
+
