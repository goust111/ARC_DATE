+
+def _polyomino_shape(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(2, MAX_SHAPE_SIZE + 1))
+    w = int(rng.integers(2, MAX_SHAPE_SIZE + 1))
