+    mask = np.zeros((h, w), dtype=bool)
+    mask[:, 0] = True
+    mask[-1, :] = True
+    return mask
+
+
+def _t_shape(rng: np.random.Generator) -> np.ndarray:
+    stem = int(rng.integers(2, MAX_SHAPE_SIZE))
+    bar = int(rng.choice([3, 5]))
+    mask = np.zeros((stem + 1, bar), dtype=bool)
