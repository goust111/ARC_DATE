+    return _tight_crop(mask)
+
+
+def _random_shape(rng: np.random.Generator) -> np.ndarray:
+    family = int(rng.integers(0, 6))
+    if family == 0:
+        base = np.array([[True]], dtype=bool)
+    elif family == 1:
+        base = _line_shape(rng)
+    elif family == 2:
