+        if color == bg:
+            return False
+        sig = rec["signature"]
+        if sig in color_by_sig and color_by_sig[sig] != color:
+            return False
+        if color in sig_by_color and sig_by_color[color] != sig:
+            return False
+        color_by_sig[sig] = color
+        sig_by_color[color] = sig
+
+    return len(color_by_sig) == len(sig_counts)
