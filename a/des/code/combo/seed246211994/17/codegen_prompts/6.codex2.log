+    sprites: list[dict] = []
+    controls: dict[int, tuple[int, int]] = {}
+    for comp in _find_components(g != bg):
+        if len(comp) == 1:
+            r, c = comp[0]
+            color = int(g[r, c])
+            assert color not in controls, "control colors must be unique"
