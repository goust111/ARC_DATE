+def _mark_reserved(reserved: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    h, w = reserved.shape
+    for r, c in coords:
+        r0 = max(0, r - PADDING)
+        r1 = min(h, r + PADDING + 1)
+        c0 = max(0, c - PADDING)
+        c1 = min(w, c + PADDING + 1)
+        reserved[r0:r1, c0:c1] = True
