+        candidates: list[tuple[int, int]] = []
+        for top in range(rows - sprite["height"] + 1):
+            for left in range(cols - sprite["width"] + 1):
+                coords = _sprite_coords(sprite, top, left)
+                if not _can_place(coords, reserved):
+                    continue
+                if matched[idx]:
