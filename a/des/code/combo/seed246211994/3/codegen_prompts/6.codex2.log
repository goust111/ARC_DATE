+    if int(np.count_nonzero(inp == bg)) <= max(int(np.count_nonzero(inp == color)) for color in colors):
+        return None
+
+    expected = _expected_grid(inp.shape, bg, colors, windows, template)
+    try:
+        if not np.array_equal(main(inp), expected):
+            return None
+    except Exception:
+        return None
+    return inp
