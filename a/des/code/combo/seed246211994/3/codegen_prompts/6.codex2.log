+
+    expected = _expected_grid(inp.shape, bg, colors, windows, template)
+    try:
+        if not np.array_equal(main(inp), expected):
+            return None
+    except Exception:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GRID_RETRY_LIMIT):
+        grid = _attempt()
+        if grid is not None:
