+def _separated(a: tuple[int, int], b: tuple[int, int], height: int, width: int, gap: int) -> bool:
+    ar, ac = a
+    br, bc = b
+    return (
+        ar + height + gap <= br
+        or br + height + gap <= ar
+        or ac + width + gap <= bc
+        or bc + width + gap <= ac
+    )
