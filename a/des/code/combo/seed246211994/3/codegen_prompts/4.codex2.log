+        return None
+    if split_count >= 3 and len(used_orientations) == 1 and random.random() < 0.7:
+        return None
+
+    bg_pixels = int(np.count_nonzero(grid == bg))
+    wall_pixels = int(grid.size - bg_pixels)
+    if bg_pixels <= wall_pixels:
