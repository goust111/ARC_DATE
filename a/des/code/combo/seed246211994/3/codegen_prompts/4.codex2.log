+        assert analyzed_bg == bg
+        assert int(labels[-1, 0]) >= 0
+        assert len(adjacency) == split_count + 1
+        assert _is_connected_graph(adjacency)
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if not np.any(out == GREY) or not np.any(out == GREEN):
