+                continue
+        except Exception:
+            continue
+        return inp, out
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        sample = _generate_case()
+        if sample is not None:
+            inp, _ = sample
+            return inp
+    raise RuntimeError("failed to generate a valid sample")

