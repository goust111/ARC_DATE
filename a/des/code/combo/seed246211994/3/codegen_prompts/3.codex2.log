+
+def _feature_summary(logical: np.ndarray, bg: int) -> tuple[int, int, int]:
+    h_conn, v_conn, used_h = _connection_masks(logical, bg)
+    h_count = int(h_conn.sum())
+    v_count = int(v_conn.sum())
