+    sprite_items = sorted(sprite_patches.items(), key=lambda item: item[1].size, reverse=True)
+    for _src, patch in sprite_items:
+        pos = _choose_bbox(reserve, patch.shape[0], patch.shape[1], forbidden, rng)
+        if pos is None:
