+    counts_arr = np.bincount(grid.ravel(), minlength=10)
+    if counts_arr[bg] <= max(counts_arr[c] for c in range(10) if c != bg):
+        return None
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
