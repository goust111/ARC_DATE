+    return candidates[0]
+
+
+def _extract_placeholders(crop: np.ndarray, bg: int, frame_color: int) -> dict[int, list[tuple[int, int]]]:
+    h, w = crop.shape
+    inner = np.zeros((h, w), dtype=bool)
+    inner[1:-1, 1:-1] = True
+    mask = inner & (crop != bg) & (crop != frame_color)
