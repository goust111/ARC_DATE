+                c += 1 if tc > c else -1
+                mask[r, c] = True
+            while r != tr:
+                r += 1 if tr > r else -1
+                mask[r, c] = True
+        else:
+            while r != tr:
+                r += 1 if tr > r else -1
+                mask[r, c] = True
+            while c != tc:
+                c += 1 if tc > c else -1
+                mask[r, c] = True
+
+    target = rng.randint(max(int(mask.sum()) + 1, size + 2), size * size - 1)
+    while int(mask.sum()) < target:
+        frontier = []
+        for r in range(size):
+            for c in range(size):
+                if mask[r, c]:
