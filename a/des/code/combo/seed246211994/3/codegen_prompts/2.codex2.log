+    forbidden = np.zeros((grid_h, grid_w), dtype=bool)
+    forbidden[fr0 : fr0 + frame_h, fc0 : fc0 + frame_w] = True
+
+    pos = _choose_bbox(reserve, legend.shape[0], legend.shape[1], forbidden, rng)
+    if pos is None:
