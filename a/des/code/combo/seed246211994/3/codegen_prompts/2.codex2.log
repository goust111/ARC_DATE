+        (r, c)
+        for r in range(h - patch_h + 1)
+        for c in range(w - patch_w + 1)
+        if (forbidden is None or not np.any(forbidden[r : r + patch_h, c : c + patch_w]))
+    ]
+    rng.shuffle(positions)
+    for r, c in positions:
