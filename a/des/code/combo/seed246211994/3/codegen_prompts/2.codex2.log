+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    counts = np.bincount(values, minlength=10)
+    return int(np.argmax(counts))
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(pts)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _border_mask(shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        for pts in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(pts)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = _border_mask(sub.shape)
+            if not np.all(sub[border] == color):
