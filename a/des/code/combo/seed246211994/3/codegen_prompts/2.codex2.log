+
+
+def _place_placeholders(
+    frame_h: int,
+    frame_w: int,
+    jobs: list[tuple[int, int, int]],
+    rng: random.Random,
+) -> dict[int, list[tuple[int, int]]]:
+    reserve = np.zeros((frame_h, frame_w), dtype=bool)
+    reserve[0, :] = True
+    reserve[-1, :] = True
+    reserve[:, 0] = True
+    reserve[:, -1] = True
