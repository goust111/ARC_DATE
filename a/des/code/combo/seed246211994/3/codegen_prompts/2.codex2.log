+def _build_expected_output(
+    frame_h: int,
+    frame_w: int,
+    bg: int,
+    frame_color: int,
+    placeholders: dict[int, list[tuple[int, int]]],
+    sprites: dict[int, np.ndarray],
+    color_map: dict[int, int],
+) -> np.ndarray:
