+        r, c = center, center
+        mask[r, c] = True
+        if rng.random() < 0.5:
+            while c != tc:
+                c += 1 if tc > c else -1
+                mask[r, c] = True
+            while r != tr:
+                r += 1 if tr > r else -1
+                mask[r, c] = True
+        else:
+            while r != tr:
+                r += 1 if tr > r else -1
+                mask[r, c] = True
+            while c != tc:
+                c += 1 if tc > c else -1
+                mask[r, c] = True
+
+    low = max(int(mask.sum()), size + 2)
+    high = size * size - 1
+    target = low if low >= high else rng.randint(low, high)
+    while int(mask.sum()) < target:
+        frontier = []
+        for r in range(size):
+            for c in range(size):
+                if mask[r, c]:
+                    continue
