+        best_color = None
+        best_count = -1
+        best_rank = len(order)
+        for color, count in border_counts.items():
+            rank = priority.get(color, len(order))
+            if count > best_count or (count == best_count and rank < best_rank):
+                best_color = color
+                best_count = count
+                best_rank = rank
+
+        fill_color = mapping[int(best_color)]
+        for r, c in comp:
+            out[r, c] = fill_color
