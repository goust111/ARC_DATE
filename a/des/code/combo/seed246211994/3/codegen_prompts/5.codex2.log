   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Highlight black defects in blue foreground by surrounding them with orange.
   9: 
  10:     Input structure:
  11:     - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.
  12: 
  13:     Rule:
  14:     - Thin blue pixels mostly surrounded by black are absorbed into the background.
  15:     - Small black components (≤3 cells) and leaf pixels of larger black components are "defects."
  16:     - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.
  17: 
  18:     Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.
  19:     """
  20:     g = np.array(grid, dtype=int)
  21:     H, W = g.shape
  22: 
  23:     hole_col = 0
  24:     border_col = 7
  25: 
  26:     # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.
  27:     base = g.copy()
  28:     for r in range(H):
  29:         for c in range(W):
  30:             if int(base[r, c]) != 1:
  31:                 continue
  32:             nb = 0
  33:             oob = 0
  34:             for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
  35:                 rr = int(r + dr)
  36:                 cc = int(c + dc)
  37:                 if not (0 <= rr < H and 0 <= cc < W):
  38:                     oob += 1
  39:                     continue
  40:                 if int(base[rr, cc]) == int(hole_col):
  41:                     nb += 1
  42:             # only count outside-as-black for corners (two out-of-bounds sides)
  43:             if oob >= 2:
  44:                 nb += int(oob)
  45:             if nb >= 3:
  46:                 base[int(r), int(c)] = int(hole_col)
  47: 
  48:     # STEP 1/2) Collect target black pixels (they must remain black).
  49:     preserve: set[tuple[int, int]] = set()
  50:     comps = components_mask(base == int(hole_col), connectivity=4)
  51:     for coords in comps:
  52:         pts_list = [(int(r), int(c)) for r, c in coords]
  53:         if len(pts_list) <= 3:
  54:             preserve.update(pts_list)
  55:             continue
  56:         for r, c in pts_list:
  57:             nb = 0
  58:             for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
  59:                 rr = int(r + dr)
  60:                 cc = int(c + dc)
  61:                 if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):
  62:                     nb += 1
  63:             if nb <= 1:
  64:                 preserve.add((int(r), int(c)))
  65: 
  66:     # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.
  67:     out = base.copy()
  68:     for coords in comps:
  69:         pts_list = [(int(r), int(c)) for r, c in coords]
  70:         targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]
  71:         for r, c in targets:
  72:             for dr in (-1, 0, 1):
  73:                 for dc in (-1, 0, 1):
  74:                     rr = int(r + dr)
  75:                     cc = int(c + dc)
  76:                     if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:
  77:                         out[rr, cc] = int(border_col)
  78: 
  79:     # Ensure target black pixels remain black.
  80:     for r, c in preserve:
  81:         out[int(r), int(c)] = int(hole_col)
  82: 
  83:     return out
