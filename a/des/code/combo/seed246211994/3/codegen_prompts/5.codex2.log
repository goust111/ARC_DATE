+def _palette_mapping(grid: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray, list[int]]:
+    h, w = grid.shape
+    side, start, end = _best_palette(grid, bg)
+    pal_mask = np.zeros((h, w), dtype=bool)
