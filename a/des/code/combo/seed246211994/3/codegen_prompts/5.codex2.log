+        for r, c in comp:
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]):
+                    continue
+                if (nr, nc) in comp_set or pal_mask[nr, nc]:
+                    continue
