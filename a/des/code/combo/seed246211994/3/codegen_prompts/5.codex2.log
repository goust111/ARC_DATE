  70: def main(grid: np.ndarray) -> np.ndarray:
  71:     """
  72:     Recolor the row-wise passage indicated by wall pixels with the singleton marker color.
  73: 
  74:     Input structure:
  75:     - A dominant background contains one singleton marker pixel and one wall color.
  76:     - Wall pixels lie on several rows and form left/right limits around the marker column.
  77:     - Empty rows between the top and bottom wall rows are open horizontal passages.
  78: 
  79:     Rule:
  80:     - On a wall row, paint background pixels between the nearest wall strictly
  81:       left of the marker column and the nearest wall at or right of it; if only
  82:       one side is present, paint from that wall to the opposite grid edge.
  83:     - On empty rows between the top and bottom wall rows, paint the whole row.
  84:     - On empty rows outside the wall-row band, reuse the nearest end wall-row interval.
  85:     - Preserve wall pixels and the original marker pixel.
  86: 
  87:     Key insight:
  88:     - The wall color defines scanline limits relative to the marker column; the
  89:       marker color fills those implied horizontal spans rather than flood-filling
  90:       through connected background.
  91:     """
  92:     g = np.asarray(grid, dtype=int)
  93:     assert g.ndim == 2, "expected a 2D grid"
  94:     height, width = g.shape
  95: 
  96:     bg = get_bg(g)
  97:     fg_colors = colors_present(g, exclude={bg})
  98:     assert len(fg_colors) == 2, "expected exactly a marker color and a wall color"
  99: 
 100:     marker_colors = [color for color in fg_colors if int(np.count_nonzero(g == color)) == 1]
 101:     assert len(marker_colors) == 1, "expected a unique singleton marker color"
 102:     marker_color = int(marker_colors[0])
 103:     wall_colors = [color for color in fg_colors if int(color) != marker_color]
 104:     assert len(wall_colors) == 1, "expected one wall color"
 105:     wall_color = int(wall_colors[0])
 106: 
 107:     marker_coords = np.argwhere(g == marker_color)
 108:     assert marker_coords.shape == (1, 2), "expected exactly one marker pixel"
 109:     marker_row, marker_col = map(int, marker_coords[0])
 110:     _assert_wall_connectivity(g, wall_color, marker_col)
 111: 
 112:     row_intervals: dict[int, tuple[int, int]] = {}
 113:     for r in range(height):
 114:         wall_cols = np.flatnonzero(g[r] == wall_color)
 115:         if wall_cols.size:
 116:             row_intervals[int(r)] = _wall_row_interval(wall_cols, marker_col, width)
 117: 
 118:     assert row_intervals, "expected at least one wall row"
 119:     top_wall_row = min(row_intervals)
 120:     bottom_wall_row = max(row_intervals)
 121:     assert top_wall_row <= marker_row <= bottom_wall_row, "marker must lie within the wall-row band"
 122: 
 123:     out = g.copy()
 124:     for r in range(height):
 125:         if r in row_intervals:
 126:             start, stop = row_intervals[r]
 127:         elif top_wall_row < r < bottom_wall_row:
 128:             start, stop = 0, int(width) - 1
 129:         elif r < top_wall_row:
 130:             start, stop = row_intervals[top_wall_row]
 131:         else:
 132:             start, stop = row_intervals[bottom_wall_row]
