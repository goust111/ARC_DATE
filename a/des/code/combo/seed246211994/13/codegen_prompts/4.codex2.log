+    if not _valid_grid(
+        grid,
+        separator,
+        bg,
+        row_spans,
+        col_spans,
+        row_separators,
+        col_separators,
+        block,
+        out,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
