+                nr, nc = r + dr, c + dc
+                if 0 <= nr < side and 0 <= nc < side and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        if not frontier:
+            break
+        cells.add(rng.choice(tuple(frontier)))
