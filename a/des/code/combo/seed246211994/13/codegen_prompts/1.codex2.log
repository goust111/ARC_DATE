+
+def _find_sprites(grid: np.ndarray, bg: int) -> list[tuple[BBox, np.ndarray, int]]:
+    sprites: list[tuple[BBox, np.ndarray, int]] = []
+    for coords in _components(grid != bg):
+        box = _bbox(coords)
+        r0, c0, r1, c1 = box
+        if (r1 - r0 + 1, c1 - c0 + 1) != (3, 3) or len(coords) != 9:
+            continue
