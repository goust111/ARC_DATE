+            mask = _add_protrusion(mask)
+
+        cropped = _crop_mask(mask)
+        if cropped is None:
+            continue
+        if len(_interior_holes_in_mask(cropped)) == 0:
+            continue
+        return cropped
+    return None
+
+
+def _place_shape(grid: np.ndarray, reserved: np.ndarray, mask: np.ndarray, color: int) -> bool:
+    h, w = grid.shape
+    mh, mw = mask.shape
+    reserve = _reserve_mask(mask)
