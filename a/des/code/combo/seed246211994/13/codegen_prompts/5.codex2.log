+            if not np.all(out[rows, cols] == TEAL):
+                return False
+            solid = mask.copy()
+            for hole in holes:
+                if not np.all(out[hole[:, 0], hole[:, 1]] == MAGENTA):
+                    return False
+                solid[hole[:, 0], hole[:, 1]] = True
+        else:
