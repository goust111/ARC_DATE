+                break
+
+        cropped = _crop_mask(mask)
+        if cropped is None:
+            continue
+        if int(cropped.sum()) < SOLID_MIN_AREA:
+            continue
+        if min(cropped.shape) < 2:
+            continue
+        if _interior_holes_in_mask(cropped):
