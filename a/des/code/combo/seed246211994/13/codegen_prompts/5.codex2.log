+def _outline_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    outline = np.zeros((h, w), dtype=bool)
+    rows, cols = np.where(mask)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
