  62:         if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:
  63:             divider_mask[:, int(c)] = True
  64: 
  65:     left_cols = (np.arange(W)[None, :] < int(fc0))
  66: 
  67:     # --- sprites: per-color 8-connected components in left area (excluding divider) ---
  68:     sprites = []
  69:     for col in sorted(set(map(int, g.flatten())) - {int(bg)}):
  70:         mask = (g == int(col)) & left_cols & (~divider_mask)
  71:         if not bool(mask.any()):
  72:             continue
  73:         slab, sn = label_mask(mask, connectivity=8)
  74:         for sid in range(1, int(sn) + 1):
  75:             pts = np.argwhere(slab == int(sid))
  76:             r0, c0 = pts.min(axis=0)
  77:             r1, c1 = pts.max(axis=0)
  78:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
  79:             m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)
  80:             sprites.append({"color": int(col), "r0": int(r0), "c0": int(c0), "r1": int(r1), "c1": int(c1), "mask": m})
  81: 
  82:     move_colors = {int(s["color"]) for s in sprites}
  83: 
  84:     # --- marker-derived targets (restricted to colors that actually appear as sprites) ---
  85:     row_marks: dict[int, list[int]] = defaultdict(list)
  86:     col_marks: dict[int, list[int]] = defaultdict(list)
  87:     for r in range(int(ir0), int(ir1) + 1):
  88:         cl = int(g[int(r), int(fc0)])
  89:         cr = int(g[int(r), int(fc1)])
  90:         if cl == cr and cl != int(bg) and cl in move_colors:
  91:             row_marks[int(cl)].append(int(r))
  92:     for c in range(int(ic0), int(ic1) + 1):
  93:         ct = int(g[int(fr0), int(c)])
  94:         cb = int(g[int(fr1), int(c)])
  95:         if ct == cb and ct != int(bg) and ct in move_colors:
  96:             col_marks[int(ct)].append(int(c))
  97: 
  98:     targets: dict[int, list[tuple[int, int]]] = {}
  99:     for col in set(row_marks.keys()) & set(col_marks.keys()):
 100:         pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}
 101:         targets[int(col)] = sorted(pts)
 102: 
 103:     out = g.copy()
 104:     movers = [s for s in sprites if int(s["color"]) in targets]
 105: 
 106:     # Erase originals of moved sprites.
 107:     for s in movers:
 108:         r0, c0 = int(s["r0"]), int(s["c0"])
 109:         for rr, cc in np.argwhere(s["mask"]):
 110:             out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)
 111: 
 112:     # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).
 113:     movers.sort(key=lambda s: (-((int(s["r0"]) + int(s["r1"])) / 2.0), int(s["c0"])))
 114: 
 115:     for s in movers:
 116:         col = int(s["color"])
 117:         cr = (int(s["r0"]) + int(s["r1"])) // 2
 118:         cc = (int(s["c0"]) + int(s["c1"])) // 2
 119:         pix = [(int(s["r0"]) + int(rr), int(s["c0"]) + int(cc2)) for rr, cc2 in np.argwhere(s["mask"])]
 120: 
 121:         for tr, tc in targets[int(col)]:
 122:             dr = int(tr - cr)
 123:             dc = int(tc - cc)
 124:             for r, c in pix:
 125:                 rr = int(r + dr)
 126:                 cc3 = int(c + dc)
 127:                 if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):
 128:                     out[rr, cc3] = int(col)
 129: 
 130:     return out
 131: 
