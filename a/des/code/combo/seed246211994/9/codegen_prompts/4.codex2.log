  94: def main(grid: np.ndarray) -> np.ndarray:
  95:     """
  96:     Replace the active black cutout's tail with background and mark the cutout side facing a colored source region.
  97: 
  98:     Input structure:
  99:     - The dominant color is background, with black rectangle-plus-tail cutouts, one gray source region, and colored distractors.
 100:     - Non-gray colored regions and single pixels are distractors/blockers, even when they are multi-pixel staircase shapes.
 101: 
 102:     Rule:
 103:     - Find each black cutout whose largest solid rectangle leaves exactly a two-pixel tail.
 104:     - The active gray source region is visible only by horizontal rays through background from a cutout's left or right side.
 105:     - Select the unique cutout side with the most same-source visible rows, erase that cutout's tail to background, and recolor the full selected vertical side pink (6).
 106: 
 107:     Key insight:
 108:     - The colored regions do not move; their horizontal line-of-sight identifies which rectangular cutout is being opened and which side receives the pink mark.
 109:     """
 110:     g = np.asarray(grid, dtype=int)
 111:     bg = int(get_bg(g))
 112:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
 113:     _distractor_source_components(bg, comps)
 114:     sources = _source_components(bg, comps)
 115: 
 116:     source_ids: dict[tuple[int, int], int] = {}
 117:     for source_id, source in enumerate(sources):
 118:         for r, c in source["coords"]:
 119:             source_ids[(int(r), int(c))] = int(source_id)
 120: 
 121:     candidates: list[tuple[int, tuple[int, int, int, int, list[tuple[int, int]]], str]] = []
 122:     for comp in comps:
 123:         if int(comp["color"]) != CUTOUT_COLOR:
 124:             continue
 125:         core_tail = _core_and_tail(g, comp)
 126:         if core_tail is None:
 127:             continue
 128: 
 129:         r0, c0, r1, c1, _tail = core_tail
 130:         side_hits: list[tuple[int, str]] = []
 131:         for side, side_col, dc in (("left", c0, -1), ("right", c1, 1)):
 132:             hits = _visible_source_ids(g, bg, source_ids, range(r0, r1 + 1), side_col, dc)
 133:             if hits:
 134:                 assert len(set(hits)) == 1, "one side must see at most one source region"
 135:                 side_hits.append((len(hits), side))
 136: 
 137:         if side_hits:
 138:             max_hits = max(hit_count for hit_count, _side in side_hits)
 139:             winning_sides = [side for hit_count, side in side_hits if hit_count == max_hits]
 140:             assert len(winning_sides) == 1, "active cutout side must be unique"
 141:             candidates.append((max_hits, core_tail, winning_sides[0]))
 142: 
 143:     assert candidates, "one black cutout must be horizontally visible from a source"
 144:     max_hits = max(hit_count for hit_count, _core_tail, _side in candidates)
 145:     winners = [candidate for candidate in candidates if candidate[0] == max_hits]
 146:     assert len(winners) == 1, "active cutout must be unique"
 147: 
 148:     _hit_count, core_tail, side = winners[0]
 149:     r0, c0, r1, c1, tail = core_tail
