+        _h_end,
+        _v_start,
+        _v_end,
+    ) = layout
+    h_base, h_marker, v_base, v_marker, cross_color = colors
+
+    out = np.full((height, width), BG_COLOR, dtype=int)
+    for step in range(far_step + 1):
