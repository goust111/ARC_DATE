+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+# Local attachment shapes are expressed in (depth_from_plus, lateral_offset)
+# coordinates, with the anchor cell adjacent to the plus at (0, 0).
+LOCAL_SHAPES = (
+    frozenset({(0, 0)}),
+    frozenset({(0, 0), (1, 0)}),
+    frozenset({(0, 0), (0, -1)}),
+    frozenset({(0, 0), (0, 1)}),
+    frozenset({(0, 0), (1, 0), (2, 0)}),
