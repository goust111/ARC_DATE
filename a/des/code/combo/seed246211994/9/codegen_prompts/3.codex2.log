+    frozenset({(0, 0), (1, 0), (1, 1)}),
+)
+
+GRID_MIN = 12
+GRID_MAX = 21
+PLUS_COUNT_MIN = 1
+PLUS_COUNT_MAX = 3
+ARM_LEN_MIN = 1
+ARM_LEN_MAX = 3
