+        return None
+
+    ends = {
+        "top": (center_r - arms["top"], center_c),
+        "bottom": (center_r + arms["bottom"], center_c),
+        "left": (center_r, center_c - arms["left"]),
+        "right": (center_r, center_c + arms["right"]),
+    }
+    return {
+        "color": int(component["color"]),
+        "coords": coords,
+        "area": int(component["area"]),
