+    for side, (dr, dc) in SIDES.items():
+        steps = 0
+        rr, cc = center_r + dr, center_c + dc
+        while (rr, cc) in coords:
+            steps += 1
+            rr += dr
+            cc += dc
+        if steps == 0:
