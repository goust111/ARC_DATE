  "type": "transform_in_place",
  "src": "8-connected monochromatic non-black foreground objects on a black background",
  "transform": "recolor to bg each object whose bbox is contained in the bbox of a larger object of another color; preserve all other pixels"
}
</annotation>
</reference_puzzle>

