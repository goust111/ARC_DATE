_BBox = tuple[int, int, int, int]


def _bbox_intersects(a: _BBox, b: _BBox) -> bool:
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _expand_bbox(b: _BBox, n: int) -> _BBox:
