+    for comp in components:
+        comp_set = set(comp)
+        comp_edges = [(a, b, axis) for a, b, axis in edges if a in comp_set]
+
+        horizontal_total = 0
+        vertical_total = 0
+        for a, b, axis in comp_edges:
+            r0, c0 = points[a]
+            r1, c1 = points[b]
+            if axis == "H":
+                horizontal_total += abs(c1 - c0) - 1
+            else:
