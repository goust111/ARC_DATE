    sr0 = r0 + shift_r
    sc0 = c0 + shift_c
    shadow = (sr0, sc0, sr0 + obj_h - 1, sc0 + obj_w - 1)
    union = (
        min(bbox[0], shadow[0]),
        min(bbox[1], shadow[1]),
        max(bbox[2], shadow[2]),
