    placed: list[dict[str, int | _BBox] | None] = [None] * len(rects)
    order = sorted(range(len(rects)), key=lambda i: rects[i]["h"] * rects[i]["w"], reverse=True)
    node_budget = _PLACEMENT_NODE_BUDGET

