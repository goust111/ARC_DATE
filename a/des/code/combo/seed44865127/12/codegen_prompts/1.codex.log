+            shadow_patch = out[sr0 : sr0 + obj_h, sc0 : sc0 + obj_w].copy()
+            shadow_patch[missing] = color
+            out[sr0 : sr0 + obj_h, sc0 : sc0 + obj_w] = shadow_patch
