+    assert box is not None, "each panel must contain a foreground pattern"
+    r0, c0, r1, c1 = box
+    return box, mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
