+        else:
+            r_min, r_max = 1 - dr * step_count, panel_h - h - 1
+        if dc >= 0:
+            c_min, c_max = 1, panel_w - w - 1 - dc * step_count
+        else:
+            c_min, c_max = 1 - dc * step_count, panel_w - w - 1
+        if r_min > r_max or c_min > c_max:
