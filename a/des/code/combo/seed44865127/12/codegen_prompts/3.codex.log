+def _gen_attempt(branch: str) -> tuple[np.ndarray, np.ndarray] | None:
+    n_panels = random.choice(PANEL_COUNT_OPTIONS)
+    panel_h = random.randint(*PANEL_HEIGHT_RANGE)
+    panel_w = random.randint(*PANEL_WIDTH_RANGE)
