+    max_w: int,
+    min_cells: int,
+    max_cells: int,
+    require_unique_rotations: bool = False,
+) -> np.ndarray | None:
+    max_cells = min(max_cells, max_h * max_w)
+    if min_cells > max_cells:
+        return None
