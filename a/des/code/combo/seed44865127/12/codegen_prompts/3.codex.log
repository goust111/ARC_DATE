+    for _ in range(120):
+        dr, dc = random.choice(delta_choices)
+        max_h = panel_h - 2 - abs(dr) * step_count
+        max_w = panel_w - 2 - abs(dc) * step_count
+        if max_h < 2 or max_w < 2:
