+def _render_input(panels: list[np.ndarray], sep: int) -> np.ndarray:
+    h, w = panels[0].shape
+    out_w = len(panels) * w + (len(panels) - 1)
+    grid = np.full((h, out_w), sep, dtype=int)
+    for i, panel in enumerate(panels):
+        c0 = i * (w + 1)
+        grid[:, c0 : c0 + w] = panel
+    return grid
