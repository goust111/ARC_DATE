+    assert len(candidates) == 1, "expected one regular separator pattern"
+    sep_color, sep_cols = candidates[0]
+
+    panels = []
+    start = 0
+    for c in sep_cols:
+        panels.append(g[:, start:c].copy())
+        start = c + 1
+    panels.append(g[:, start:w].copy())
