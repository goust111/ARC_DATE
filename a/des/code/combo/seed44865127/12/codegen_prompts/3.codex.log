+def _infer_bg(panels: list[np.ndarray]) -> int:
+    corners = {
+        int(panel[0, 0])
+        for panel in panels
+    }
+    corners |= {
+        int(panel[0, -1])
+        for panel in panels
+    }
+    corners |= {
+        int(panel[-1, 0])
+        for panel in panels
+    }
+    corners |= {
+        int(panel[-1, -1])
+        for panel in panels
+    }
+    assert len(corners) == 1, "all panel corners should share the background color"
+    return corners.pop()
