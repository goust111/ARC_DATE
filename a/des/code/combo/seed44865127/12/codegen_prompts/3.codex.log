+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BRANCHES = ("translate", "rotate", "dilate")
+PANEL_COUNT_OPTIONS = (3, 4)
+PANEL_HEIGHT_RANGE = (8, 13)
+PANEL_WIDTH_RANGE = (8, 13)
+MAX_GENERATION_ATTEMPTS = 500
