+def _cells_to_mask(cells: set[tuple[int, int]]) -> np.ndarray:
+    max_r = max(r for r, _ in cells)
+    max_c = max(c for _, c in cells)
+    mask = np.zeros((max_r + 1, max_c + 1), dtype=bool)
+    for r, c in cells:
