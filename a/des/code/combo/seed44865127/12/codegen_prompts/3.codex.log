+) -> np.ndarray | None:
+    max_cells = min(max_cells, max_h * max_w)
+    if min_cells > max_cells:
+        return None
+
+    for _ in range(120):
+        target = random.randint(min_cells, max_cells)
+        cells: set[tuple[int, int]] = {(0, 0)}
+
+        while len(cells) < target:
