+    corners |= {
+        int(panel[0, -1])
+        for panel in panels
+    }
+    corners |= {
+        int(panel[-1, 0])
+        for panel in panels
+    }
+    corners |= {
+        int(panel[-1, -1])
+        for panel in panels
