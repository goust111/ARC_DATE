+    for _ in range(80):
+        in_h = random.randint(base_h, base_h + 4)
+        in_w = random.randint(base_w, base_w + 5)
+        grid = np.full((in_h, in_w), bg, dtype=int)
+        reserved = np.zeros((in_h, in_w), dtype=bool)
+        order = list(range(n))
+        random.shuffle(order)
+        ok = True
+        for idx in order:
