+
+def _candidate_dims(total_area: int, box_h: int, box_w: int) -> list[tuple[int, int]]:
+    dims: set[tuple[int, int]] = set()
+    for h in range(1, int(math.isqrt(total_area)) + 1):
+        if total_area % h != 0:
