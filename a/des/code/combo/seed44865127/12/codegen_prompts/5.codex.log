+    covered = np.zeros(out_h * out_w, dtype=bool)
+    chosen: list[int] = []
+
+    def rec(covered_count: int) -> bool:
+        if covered_count == out_h * out_w:
+            return True
+
+        best_options: list[int] | None = None
+        for cell in np.flatnonzero(~covered):
+            options: list[int] = []
+            for placement_idx in cell_to_placements[int(cell)]:
+                cells = placements[placement_idx][3]
+                if any(covered[idx] for idx in cells):
+                    continue
+                options.append(placement_idx)
+            if not options:
+                return False
+            if best_options is None or len(options) < len(best_options):
+                best_options = options
+                if len(best_options) == 1:
+                    break
+
+        assert best_options is not None
+        random.shuffle(best_options)
+        for placement_idx in best_options:
+            cells = placements[placement_idx][3]
+            for idx in cells:
+                covered[idx] = True
+            chosen.append(placement_idx)
+            if rec(covered_count + len(cells)):
+                return True
