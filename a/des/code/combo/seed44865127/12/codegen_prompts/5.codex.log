+    "corner": {
+        "box": (2, 2),
+        "masks": CORNER_MASKS,
+        "dims": [(3, 4), (4, 3), (3, 6), (6, 3)],
+        "min_variants": {4: 2, 6: 3},
+    },
+    "edge_h": {
+        "box": (2, 3),
+        "masks": EDGE_H_MASKS,
+        "dims": [(4, 4), (4, 6), (6, 4)],
