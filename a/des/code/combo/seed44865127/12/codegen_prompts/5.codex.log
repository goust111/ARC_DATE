+                cc0 = max(0, c0 - 1)
+                cc1 = min(in_w, c0 + box_w + 1)
+                if reserved[rr0:rr1, cc0:cc1].any():
+                    continue
+                mask = patch != bg
+                grid[r0 : r0 + box_h, c0 : c0 + box_w][mask] = patch[mask]
+                reserved[r0 : r0 + box_h, c0 : c0 + box_w] = True
+                placed = True
+                break
+            if not placed:
+                ok = False
+                break
+        if ok and Counter(grid.ravel()).most_common(1)[0][0] == bg:
+            return grid
+    return None
+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    family = _random_family()
+    out_h, out_w = random.choice(family["dims"])
+    tiling = _random_tiling(family, out_h, out_w)
+    if not tiling:
+        return None
+
+    variant_count = len({mask_idx for mask_idx, _, _ in tiling})
+    min_variants = family["min_variants"][len(tiling)]
+    if variant_count < min_variants:
+        return None
+
+    box_h, box_w = family["box"]
+    color_pool = list(range(10))
+    needed_colors = len(tiling) + 1
+    if needed_colors > len(color_pool):
+        return None
+    chosen_colors = random.sample(color_pool, needed_colors)
+    bg = chosen_colors[0]
+    piece_colors = chosen_colors[1:]
+    random.shuffle(piece_colors)
+
+    out = np.full((out_h, out_w), -1, dtype=int)
+    patches: list[np.ndarray] = []
+    masks = family["masks"]
+
+    for color, (mask_idx, r0, c0) in zip(piece_colors, tiling):
+        mask = masks[mask_idx]
+        patch = np.full((box_h, box_w), bg, dtype=int)
+        patch[mask] = color
+        patches.append(patch)
+        for r, c in _mask_coords(mask):
+            assert out[r0 + r, c0 + c] == -1
+            out[r0 + r, c0 + c] = color
+
+    if np.any(out == -1):
+        return None
+
+    random.shuffle(patches)
+    inp = _scatter_patches(patches, bg, out_h, out_w)
+    if inp is None:
+        return None
+
+    pieces, box_h2, box_w2 = _extract_pieces(inp)
+    outputs = _solve_outputs_from_pieces(pieces, box_h2, box_w2, limit=2)
+    if len(outputs) != 1 or not np.array_equal(outputs[0], out):
+        return None
+
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        result = _build_instance()
+        if result is not None:
+            return result[0]
+    raise RuntimeError(f"generate_input: failed after {GEN_RETRIES} attempts")

