+) -> np.ndarray | None:
+    n = len(patches)
+    box_h, box_w = patches[0].shape
+    base_h = max(out_h + 4, (box_h + 2) * max(2, math.ceil(n / 3)))
+    base_w = max(out_w + 6, (box_w + 2) * max(3, math.ceil(n / 2)))
