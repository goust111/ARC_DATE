+    np.array([[0, 0, 1], [1, 1, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 0, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=bool),
+]
+
+EDGE_V_MASKS = [mask.T.copy() for mask in EDGE_H_MASKS]
+
+FAMILIES = {
+    "corner": {
+        "box": (2, 2),
+        "masks": CORNER_MASKS,
+        "dims": [(3, 4), (4, 3), (3, 6), (6, 3)],
+        "min_variants": {4: 2, 6: 3},
+    },
+    "edge_h": {
+        "box": (2, 3),
+        "masks": EDGE_H_MASKS,
+        "dims": [(4, 4), (4, 6), (6, 4)],
+        "min_variants": {4: 2, 6: 3},
+    },
+    "edge_v": {
+        "box": (3, 2),
+        "masks": EDGE_V_MASKS,
+        "dims": [(4, 4), (4, 6), (6, 4)],
+        "min_variants": {4: 2, 6: 3},
