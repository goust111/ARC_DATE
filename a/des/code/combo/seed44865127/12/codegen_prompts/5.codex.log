+
+    box_h, box_w = family["box"]
+    color_pool = list(range(10))
+    needed_colors = len(tiling) + 1
+    if needed_colors > len(color_pool):
+        return None
+    chosen_colors = random.sample(color_pool, needed_colors)
+    bg = chosen_colors[0]
+    piece_colors = chosen_colors[1:]
+    random.shuffle(piece_colors)
+
+    out = np.full((out_h, out_w), -1, dtype=int)
+    patches: list[np.ndarray] = []
+    masks = family["masks"]
+
+    for color, (mask_idx, r0, c0) in zip(piece_colors, tiling):
+        mask = masks[mask_idx]
+        patch = np.full((box_h, box_w), bg, dtype=int)
