+    seen: set[tuple[tuple[int, int], bytes]] = set()
+
+    def rec(covered_count: int) -> None:
+        if len(solutions) >= limit:
+            return
+        if covered_count == out_h * out_w:
+            key = ((out_h, out_w), painted.tobytes())
+            if key not in seen:
+                seen.add(key)
+                solutions.append(painted.reshape(out_h, out_w).copy())
+            return
