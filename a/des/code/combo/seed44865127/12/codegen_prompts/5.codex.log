+import math
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
+
+
+CORNER_MASKS = [
+    np.array([[0, 1], [1, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 1], [0, 1]], dtype=bool),
+    np.array([[1, 1], [1, 0]], dtype=bool),
+]
+
