from itertools import combinations
import numpy as np
import random, math

DIRS4=[(-1,0),(1,0),(0,-1),(0,1)]

def connected(mask):
    coords=[(r,c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r,c]]
    if not coords: return False
    seen={coords[0]}; stack=[coords[0]]
    while stack:
        r,c=stack.pop()
        for dr,dc in DIRS4:
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(coords)

def bbox_full(mask):
    rows, cols = np.where(mask)
    return rows.min()==0 and rows.max()==mask.shape[0]-1 and cols.min()==0 and cols.max()==mask.shape[1]-1

def cluster_ok(holes, h, w):
    holes=set(holes)
    edges=[{(0,c) for c in range(w)}, {(h-1,c) for c in range(w)}, {(r,0) for r in range(h)}, {(r,w-1) for r in range(h)}]
    corners=[]
    for rr in (0,h-2):
        for cc in (0,w-2):
            corners.append({(rr+r,cc+c) for r in range(2) for c in range(2)})
    return any(holes <= s for s in edges+corners)

def masks(h,w):
    out=[]
    cells=[(r,c) for r in range(h) for c in range(w)]
    for k in (1,2):
        for holes in combinations(cells,k):
