+    pieces, box_h2, box_w2 = _extract_pieces(inp)
+    outputs = _solve_outputs_from_pieces(pieces, box_h2, box_w2, limit=2)
+    if len(outputs) != 1 or not np.array_equal(outputs[0], out):
+        return None
+
+    return inp, out
