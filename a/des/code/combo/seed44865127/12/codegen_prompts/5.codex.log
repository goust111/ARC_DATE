+        local = _solve_fixed_dims(pieces, box_h, box_w, out_h, out_w, limit=max(1, limit - len(outputs)))
+        for arr in local:
+            key = (arr.shape, arr.tobytes())
+            if key not in seen:
+                seen.add(key)
+                outputs.append(arr)
+                if len(outputs) >= limit:
