from itertools import combinations
import numpy as np
import random

DIRS4=[(-1,0),(1,0),(0,-1),(0,1)]

def connected(mask):
    coords=[(r,c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r,c]]
    if not coords: return False
    seen={coords[0]}; stack=[coords[0]]
    while stack:
        r,c=stack.pop()
        for dr,dc in DIRS4:
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(coords)

def bbox_full(mask):
    rows, cols = np.where(mask)
    return rows.min()==0 and rows.max()==mask.shape[0]-1 and cols.min()==0 and cols.max()==mask.shape[1]-1

def cluster_ok(holes, h, w):
    holes=set(holes)
    edges=[{(0,c) for c in range(w)}, {(h-1,c) for c in range(w)}, {(r,0) for r in range(h)}, {(r,w-1) for r in range(h)}]
    corners=[]
    for rr in (0,h-2):
        for cc in (0,w-2):
            corners.append({(rr+r,cc+c) for r in range(2) for c in range(2)})
    return any(holes <= s for s in edges+corners)

def masks(h,w):
    out=[]
    cells=[(r,c) for r in range(h) for c in range(w)]
    for k in (1,2):
        for holes in combinations(cells,k):
            if any(r not in (0,h-1) and c not in (0,w-1) for r,c in holes):
                continue
            if not cluster_ok(holes,h,w):
                continue
            mask=np.ones((h,w),dtype=bool)
            for r,c in holes:
                mask[r,c]=False
            if connected(mask) and bbox_full(mask):
                out.append(mask)
    return out

cats=masks(3,3)
coords=[tuple(map(tuple,np.argwhere(m))) for m in cats]
areas=[int(m.sum()) for m in cats]

def candidate_dims(total):
    out=[]
    for H in range(4, 11):
        if total % H == 0:
            W = total // H
            if 4 <= W <= 11:
                out.append((H,W))
                if H "'!= W:
                    out.append((W,H))
    return sorted(set(out))

def solve(piece_ids, dims, limit=2):
    H,W=dims
    pieces=[coords[i] for i in piece_ids]
    cell_to=[[] for _ in range(H*W)]
    placements=[]
    for pi, pc in enumerate(pieces):
        plist=[]
        for r0 in range(H-3+1):
            for c0 in range(W-3+1):
                cells=tuple((r0+r)*W + (c0+c) for r,c in pc)
                idx=len(plist)
                plist.append(cells)
                for cell in cells:
                    cell_to[cell].append((pi, idx))
        placements.append(plist)
    covered=[False]*(H*W)
    used=[False]*len(pieces)
    sols=0
    def rec(cnt):
        nonlocal sols
        if sols>=limit: return
        if cnt==H*W:
            sols += 1
            return
        bestopts=None
        for cell in range(H*W):
            if covered[cell]: continue
            opts=[]
            for pi, idx in cell_to[cell]:
                if used[pi]: continue
                cs=placements[pi][idx]
                if any(covered[x] for x in cs): continue
                opts.append((pi, idx))
            if not opts:
                return
            if bestopts is None or len(opts)<len(bestopts):
                bestopts=opts
                if len(bestopts)==1: break
        for pi, idx in bestopts:
            used[pi]=True
            for x in placements[pi][idx]:
                covered[x]=True
            rec(cnt+len(placements[pi][idx]))
            for x in placements[pi][idx]:
                covered[x]=False
            used[pi]=False
    rec(0)
    return sols

seen = {((13, 15, 16, 8, 2), (6,6))}
found = 0
for n in (5,6):
    for trial in range(8000):
        piece_ids=tuple(random.sample(list(range(len(cats))), n))
        total=sum(areas[i] for i in piece_ids)
        dims=candidate_dims(total)
        random.shuffle(dims)
        for dim in dims[:12]:
            sols=solve(piece_ids, dim, limit=2)
            if sols==1 and (piece_ids, dim) not in seen:
                print('"'FOUND', n, piece_ids, [areas[i] for i in piece_ids], dim)
                for i in piece_ids:
                    print('id', i)
                    print(cats[i].astype(int))
                found += 1
                seen.add((piece_ids, dim))
                if found >= 3:
                    raise SystemExit
                break
