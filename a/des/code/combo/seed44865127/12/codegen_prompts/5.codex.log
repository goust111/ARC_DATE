+    for h in range(1, int(math.isqrt(total_area)) + 1):
+        if total_area % h != 0:
+            continue
+        w = total_area // h
+        if h >= box_h and w >= box_w:
+            dims.add((h, w))
+        if w >= box_h and h >= box_w:
