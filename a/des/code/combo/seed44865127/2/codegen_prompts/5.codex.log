+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _is_connected(coords: np.ndarray) -> bool:
+    if len(coords) == 0:
+        return False
+    pts = {tuple(map(int, rc)) for rc in coords}
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nxt = (r + dr, c + dc)
+            if nxt in pts and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(pts)
+
+
+def _is_straight_contiguous(coords: np.ndarray) -> bool:
+    if len(coords) == 1:
+        return True
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    if len(set(map(int, rows))) == 1:
+        vals = sorted(map(int, cols))
+        return vals == list(range(vals[0], vals[-1] + 1))
+    if len(set(map(int, cols))) == 1:
+        vals = sorted(map(int, rows))
+        return vals == list(range(vals[0], vals[-1] + 1))
+    return False
+
+
+def _tail_side(tail: np.ndarray, body: np.ndarray) -> str | None:
+    if not (1 <= len(tail) <= 4):
+        return None
+    if len(body) < 4 or not _is_connected(body):
+        return None
+    br0, bc0, br1, bc1 = _bbox(body)
+    if br0 == br1 or bc0 == bc1:
+        return None
+    if not _is_straight_contiguous(tail):
+        return None
+
+    left = bool(np.all(tail[:, 1] < bc0))
+    right = bool(np.all(tail[:, 1] > bc1))
+    up = bool(np.all(tail[:, 0] < br0))
+    down = bool(np.all(tail[:, 0] > br1))
+    if sum((left, right, up, down)) != 1:
+        return None
+
+    if left:
+        if len(set(map(int, tail[:, 0]))) != 1:
+            return None
+        row = int(tail[0, 0])
+        if not (br0 <= row <= br1):
+            return None
+        if int(tail[:, 1].max()) != bc0 - 1:
+            return None
+        side = "left"
+    elif right:
+        if len(set(map(int, tail[:, 0]))) != 1:
+            return None
+        row = int(tail[0, 0])
+        if not (br0 <= row <= br1):
+            return None
+        if int(tail[:, 1].min()) != bc1 + 1:
+            return None
+        side = "right"
+    elif up:
+        if len(set(map(int, tail[:, 1]))) != 1:
+            return None
+        col = int(tail[0, 1])
+        if not (bc0 <= col <= bc1):
+            return None
+        if int(tail[:, 0].max()) != br0 - 1:
+            return None
+        side = "up"
+    else:
+        if len(set(map(int, tail[:, 1]))) != 1:
+            return None
+        col = int(tail[0, 1])
+        if not (bc0 <= col <= bc1):
+            return None
+        if int(tail[:, 0].min()) != br1 + 1:
+            return None
+        side = "down"
