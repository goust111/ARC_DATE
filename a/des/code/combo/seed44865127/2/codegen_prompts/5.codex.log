+    non_bg = np.count_nonzero(inp != bg)
+    if non_bg == 0:
+        return None
+    if non_bg >= (h * w) // 2:
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is None:
+            continue
+        inp, expected = result
+        if np.array_equal(main(inp), expected):
