+import numpy as np
+
+
+ORANGE = 7
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("left", "right", "up", "down")
+MAX_GENERATION_ATTEMPTS = 400
+MAX_OBJECT_PLACEMENT_ATTEMPTS = 200
