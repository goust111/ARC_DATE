+def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    h = random.randint(12, 18)
+    w = random.randint(12, 18)
+    bg = random.choice([c for c in range(10) if c != ORANGE])
+    inp = np.full((h, w), bg, dtype=int)
+    out = np.full((h, w), bg, dtype=int)
