+        if not placed:
+            return None
+
+    return [frame for frame in frames if frame is not None], blocked
+
+
+def _place_markers(
+    rng: np.random.Generator,
+    height: int,
+    width: int,
+    frames: list[dict[str, int]],
+    layer_counts: list[int],
