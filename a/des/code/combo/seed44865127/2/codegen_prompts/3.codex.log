+    cols = [c for _, c in coords]
+    return int(min(rows)), int(min(cols)), int(max(rows)), int(max(cols))
+
+
+def _is_hollow_frame(coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height < 3 or width < 3:
+        return False
+    if len(coords) != 2 * (height + width) - 4:
+        return False
+
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in coords:
+        mask[int(r - r0), int(c - c0)] = True
+
+    border = np.zeros((height, width), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
+
+
+def _point_to_rect_distance(point: tuple[int, int], bbox: tuple[int, int, int, int]) -> int:
+    r, c = point
+    r0, c0, r1, c1 = bbox
+
+    if r < r0:
+        dr = int(r0 - r)
+    elif r > r1:
+        dr = int(r - r1)
+    else:
+        dr = 0
+
+    if c < c0:
+        dc = int(c0 - c)
+    elif c > c1:
+        dc = int(c - c1)
+    else:
+        dc = 0
+
+    return int(dr + dc)
