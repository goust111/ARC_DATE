        if hs == 0:  # top: dest above head above container
            total_h = 1 + gap + 1 + oh  # dest + gap + head + container
            total_w = ow
            cont_r = gap + 2  # container top row within assembly
            cont_c = 0
        elif hs == 1:  # bottom: container above head above dest
            total_h = oh + 1 + gap + 1
            total_w = ow
            cont_r = 0
