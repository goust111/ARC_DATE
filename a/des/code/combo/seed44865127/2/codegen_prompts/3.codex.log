+        color = int(frame["color"])
+        r0, c0, r1, c1 = frame["bbox"]
+        layers = min(int(count), _max_ring_layers(frame["bbox"]))
+        for offset in range(layers):
+            inner_box = (int(r0 + 1 + offset), int(c0 + 1 + offset), int(r1 - 1 - offset), int(c1 - 1 - offset))
