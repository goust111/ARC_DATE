SPRITE_TYPE_CHOICES = (1, 2)      # number of distinct sprite types
MARKER_COUNT_RANGE = (2, 3)       # markers in dest rect
SOURCE_SPRITE_RANGE = (2, 4)      # total sprites in source rect
