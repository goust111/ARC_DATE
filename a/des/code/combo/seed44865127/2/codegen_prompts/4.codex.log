+    infos = []
+    for axis in _axis_candidates(*grid.shape):
+        info = _evaluate_axis(coord_set, axis, grid, bg, forbid_top_row)
+        if info is not None:
+            infos.append(info)
+    infos.sort(
+        key=lambda info: (
+            int(info["add_count"]),
+            int(info["bbox_area"]),
