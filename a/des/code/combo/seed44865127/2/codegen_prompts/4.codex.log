+            h = w = random.randint(4, 7)
+
+        domain = [(r, c) for r in range(h) for c in range(w) if _in_domain(r, c, kind, h, w)]
+        seed = random.choice(_seed_choices(kind, h, w))
+        cells = {seed}
+        target = random.randint(4, min(11, len(domain)))
