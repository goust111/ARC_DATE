+import random
+from collections import deque
+
+import numpy as np
+
+
+_AXIS_ORDER = {"v": 0, "h": 1, "d": 2, "a": 3}
+_AXIS_KINDS = ("v", "h", "d", "a")
+_GEN_RETRIES = 400
+_LOCAL_RETRIES = 200
+_GRID_H_RANGE = (12, 18)
+_GRID_W_RANGE = (17, 26)
