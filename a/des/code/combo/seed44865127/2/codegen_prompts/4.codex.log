+def _legend_positions(width: int, count: int) -> list[int] | None:
+    gaps = [random.randint(0, 1) for _ in range(max(0, count - 1))]
+    need = 2 * count + sum(gaps)
+    if need > width:
+        return None
+    start = random.randint(0, width - need)
+    out = []
+    c = start
+    for i in range(count):
+        out.append(c)
+        c += 2
+        if i < count - 1:
+            c += gaps[i]
+    return out
+
