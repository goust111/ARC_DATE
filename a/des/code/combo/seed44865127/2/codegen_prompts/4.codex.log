+        seen.add((int(r), int(c)))
+        seen.add((int(rr), int(cc)))
+        if (int(r), int(c)) != (int(rr), int(cc)):
+            orbits.append(((int(r), int(c)), (int(rr), int(cc))))
+    return orbits
