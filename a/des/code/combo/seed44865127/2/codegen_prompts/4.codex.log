        corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
        miss = [p for p in corners if p not in set(pts)]
        if len(miss) != 1:
            return None
        mr, mc = miss[0]
        # direction away from missing corner
        dr = 1 if mr == r0 else -1
        dc = 1 if mc == c0 else -1

        pts_set = set(pts)
