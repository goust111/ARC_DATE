+        rr, cc = pad + int(r), pad + int(c)
+        grid[rr, cc] = 1
+        coords.append((rr, cc))
+    zeros = [info for info in _rank_axes(coords, grid, 0, forbid_top_row=False) if int(info["add_count"]) == 0]
+    return len(zeros) == 1 and zeros[0]["axis"][0] == kind
