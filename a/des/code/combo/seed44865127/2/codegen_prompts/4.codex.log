+        while len(cells) < target:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and _in_domain(nr, nc, kind, h, w) and (nr, nc) not in cells:
