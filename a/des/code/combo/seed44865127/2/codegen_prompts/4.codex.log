+
+def _pair_orbits(mask: np.ndarray, kind: str) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    h, w = mask.shape
+    seen: set[tuple[int, int]] = set()
+    orbits: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r, c in map(tuple, np.argwhere(mask)):
+        if (r, c) in seen:
