+import random
+from collections import deque
+
+import numpy as np
+
+
+_AXIS_ORDER = {"v": 0, "h": 1, "d": 2, "a": 3}
+_AXIS_KINDS = ("v", "h", "d", "a")
+_GEN_RETRIES = 400
+_LOCAL_RETRIES = 200
+_GRID_H_RANGE = (12, 18)
+_GRID_W_RANGE = (17, 26)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: set[tuple[int, int]] | list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), max(rs), min(cs), max(cs)
+
+
+def _parse_legend(row: np.ndarray, bg: int) -> dict[int, int]:
+    mapping: dict[int, int] = {}
+    c = 0
+    w = len(row)
+    while c < w - 1:
+        if int(row[c]) != bg and int(row[c + 1]) != bg:
+            mapping[int(row[c])] = int(row[c + 1])
+            c += 2
+        else:
+            c += 1
+    return mapping
+
+
+def _reflect_point(r: int, c: int, kind: str, param: int) -> tuple[int, int]:
+    if kind == "v":
+        return int(r), int(param - c)
+    if kind == "h":
+        return int(param - r), int(c)
+    if kind == "d":
+        return int(c + param), int(r - param)
+    return int(param - c), int(param - r)
+
+
+def _axis_candidates(h: int, w: int):
+    for param in range(2 * w - 1):
+        yield "v", int(param)
+    for param in range(2 * h - 1):
+        yield "h", int(param)
+    for param in range(-(w - 1), h):
+        yield "d", int(param)
+    for param in range(h + w - 1):
+        yield "a", int(param)
+
+
+def _evaluate_axis(
+    coords: set[tuple[int, int]],
+    axis: tuple[str, int],
+    grid: np.ndarray,
+    bg: int,
+    forbid_top_row: bool,
+):
+    h, w = grid.shape
+    kind, param = axis
+    reflected: set[tuple[int, int]] = set()
+    for r, c in coords:
