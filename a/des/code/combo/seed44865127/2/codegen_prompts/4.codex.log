+    return positions
+
+
+def _build_case():
+    object_count = random.randint(2, 4)
+    kinds = list(_AXIS_KINDS)
+    random.shuffle(kinds)
+    kinds = kinds[:object_count]
+
+    objects = []
+    for kind in kinds:
+        obj = _make_object(kind)
+        if obj is None:
