+    x = left_margin
+    placements: list[dict[str, int]] = []
+    for idx, spec in enumerate(placed):
+        max_top = height - spec["h"] - _TOP_MARGIN
+        if max_top < _TOP_MARGIN:
+            return None
+        top = rng.randint(_TOP_MARGIN, max_top)
+        grid[top : top + spec["h"], x : x + spec["w"]] = int(spec["color"])
+        placement = dict(spec)
+        placement["top"] = top
