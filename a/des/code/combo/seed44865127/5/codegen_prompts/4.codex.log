+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CANVAS_SIZE = 80
+CANVAS_CENTER = 40
+GENERATION_ATTEMPTS = 500
