+        _mark_blocked(blocked, r0, c0, int(spec["height"]), int(spec["width"]), pad=1)
+        placed_specs.append({**spec, "top": int(r0), "left": int(c0)})
+
+    inp = expected.copy()
+    stamp_specs: list[dict] = []
+
+    for spec in placed_specs:
