+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        try:
+            inp, expected = _build_example()
+            if np.array_equal(main(inp), expected):
+                return inp
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid sample")

