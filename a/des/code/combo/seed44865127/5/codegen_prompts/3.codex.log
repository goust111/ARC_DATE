+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _foreground_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not bool(seen[nr, nc]) and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+
+            arr = np.asarray(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "area": int(len(coords)),
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    return comps
+
+
+def _normalize_coords(coords: np.ndarray | list[tuple[int, int]]) -> tuple[tuple[tuple[int, int], ...], int, int]:
+    arr = np.asarray(coords, dtype=int)
+    r0 = int(arr[:, 0].min())
+    c0 = int(arr[:, 1].min())
+    norm = tuple(sorted((int(r - r0), int(c - c0)) for r, c in arr))
+    h = max(r for r, _ in norm) + 1
+    w = max(c for _, c in norm) + 1
+    return norm, int(h), int(w)
+
