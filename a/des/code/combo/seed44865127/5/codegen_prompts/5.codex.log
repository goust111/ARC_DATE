+def _expand_8(cells: set[tuple[int, int]], height: int, width: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < height and 0 <= nc < width:
+                    out.add((nr, nc))
+    return out
+
