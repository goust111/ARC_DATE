+    pts = np.argwhere(mask)
+    mean_r = float(pts[:, 0].mean())
+    mean_c = float(pts[:, 1].mean())
+    center_r = (mask.shape[0] - 1) / 2.0
+    center_c = (mask.shape[1] - 1) / 2.0
+    diff_r = mean_r - center_r
+    diff_c = mean_c - center_c
+
+    if direction == "up":
+        return diff_r < -0.12
+    if direction == "down":
+        return diff_r > 0.12
+    if direction == "left":
