 282: def main(grid: np.ndarray) -> np.ndarray:
 283:     """
 284:     Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.
 285: 
 286:     Input structure:
 287:     - The grid is a mosaic of monochrome regions.
 288:     - Color 1 forms T-shaped control markers on region boundaries.
 289:     - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.
 290:     - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.
 291: 
 292:     Rule:
 293:     - For a color-1 T marker, the single stem points at the destination region to repaint.
 294:     - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.
 295:     - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.
 296:     - All marker cells are filled with the final color of the source-side region.
 297:     - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.
 298: 
 299:     Key insight:
 300:     - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.
 301:     """
 302:     g = np.asarray(grid, dtype=int)
 303:     out = _solve_unrotated(g)
 304:     l9 = _find_l9_orientation(g)
 305:     if l9 == 'top_right':
 306:         return np.rot90(out, 1)
 307:     if l9 == 'top_left':
 308:         return np.rot90(out, 3)
 309:     return out
 310: 
 311: # --------------- generator (l9rot) ---------------
 312: 
 313: # ── Tunable constants ──────────────────────────────────────────────────
 314: # Canvas / region sizing
 315: GRID_SIZE_MAX = 30                          # max rows or cols
 316: MIN_REGION_CELLS = 6                        # per-spec minimum
 317: REGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)
 318: REGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts
 319: REGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS
 320: 
 321: # Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)
 322: MARKER_MIN = 4
 323: MARKER_MAX = 8
 324: NORMAL_MAX = 6
 325: COLORED_MAX = 2
 326: 
 327: # Color pool (all ARC colors except 1, which is reserved for T-marker cells)
 328: COLOR_POOL = [c for c in range(10) if c != 1]
 329: 
 330: # L9 rotation marker
 331: L9_PROBABILITY = 0.5                        # chance of placing a rotation marker
 332: L9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation
 333:     'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],
 334:     'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],
 335: }
 336: 
 337: # Generation retry budget
 338: SEED_ATTEMPTS = 200                         # tries to place n distinct region seeds
 339: GEN_RETRIES = 300                           # outer generate_input retry budget
 340: 
 341: _DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
 342: 
 343: 
 344: # ── Small geometry helpers ─────────────────────────────────────────────
 345: 
 346: def _get_bar(stem):
 347:     """Return the two bar directions perpendicular to *stem*."""
 348:     if stem[0] == 0:
 349:         return [(-1, 0), (1, 0)]
 350:     return [(0, -1), (0, 1)]
 351: 
 352: 
 353: def _t_cells(center, stem):
 354:     """Return the 4 cells of a T marker: center + stem tip + 2 bar cells."""
 355:     r, c = center
 356:     bar = _get_bar(stem)
 357:     return {(r, c), (r + stem[0], c + stem[1]),
 358:             (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}
 359: 
 360: 
 361: def _t_branch_cells(center, stem):
 362:     """Return the 3 branch cells (stem tip + 2 bar), excluding the center."""
 363:     r, c = center
 364:     bar = _get_bar(stem)
 365:     return {(r + stem[0], c + stem[1]),
 366:             (r + bar[0][0], c + bar[0][1]),
 367:             (r + bar[1][0], c + bar[1][1])}
 368: 
 369: 
 370: def _t_neighborhood(center, stem):
 371:     """Return cells adjacent to any T cell but not part of the T itself."""
 372:     cells = _t_cells(center, stem)
 373:     neighborhood = set()
 374:     for r, c in cells:
 375:         for dr, dc in _DIRS:
 376:             nb = (r + dr, c + dc)
 377:             if nb not in cells:
 378:                 neighborhood.add(nb)
 379:     return neighborhood
 380: 
 381: 
 382: # ── Region partitioning ────────────────────────────────────────────────
 383: 
 384: def _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:
 385:     """Grow n_regions from random seeds via randomized BFS; returns region-id array or None."""
 386:     region = np.full((H, W), -1, dtype=int)
 387:     seeds = set()
 388:     for _ in range(SEED_ATTEMPTS):
 389:         if len(seeds) >= n_regions:
 390:             break
 391:         seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))
 392:     if len(seeds) < n_regions:
 393:         return None
 394: 
 395:     frontier = []
 396:     for i, (r, c) in enumerate(list(seeds)):
 397:         region[r, c] = i
 398:         for dr, dc in _DIRS:
 399:             nr, nc = r + dr, c + dc
 400:             if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:
 401:                 frontier.append((nr, nc, i))
 402:     random.shuffle(frontier)
