+
+def _embed_centered(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    side = max(h, w)
+    canvas = np.zeros((side, side), dtype=bool)
+    top = (side - h) // 2
+    left = (side - w) // 2
