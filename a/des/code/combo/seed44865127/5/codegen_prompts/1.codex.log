+        return None
+
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    if min(rows) != 0 or max(rows) != h - 1 or min(cols) != 0 or max(cols) != w - 1:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
