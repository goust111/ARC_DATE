+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    order = np.argsort(-counts)
+    values = values[order]
+    counts = counts[order]
+    assert len(counts) >= 1
+    if len(counts) > 1:
+        assert counts[0] > counts[1], "background color must be uniquely dominant"
+    return int(values[0])
