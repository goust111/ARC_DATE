+    canvas_h = outer_h + margin_top + margin_bottom + extra_h
+    canvas_w = outer_w + margin_left + margin_right + extra_w
+    if canvas_h > _MAX_CANVAS_SIZE or canvas_w > _MAX_CANVAS_SIZE:
