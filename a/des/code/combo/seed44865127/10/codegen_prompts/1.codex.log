+BLOCK_COLS_RANGE = (2, 4)
+BLOCK_H_RANGE = (3, 7)
+BLOCK_W_RANGE = (3, 7)
+NON_BG_COLOR_RANGE = (2, 4)
+EXTRA_SHAPE_RANGE = (1, 3)
+DAMAGE_COUNT_MAX = 3
+GENERATION_ATTEMPTS = 400
+MOTIF_ATTEMPTS = 80
