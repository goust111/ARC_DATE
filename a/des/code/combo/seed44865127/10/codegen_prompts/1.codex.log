PADDING_MAX_EXCLUSIVE = 6
INPUT_SIDE_MIN = 19
INPUT_SIDE_MAX = 28

# Hidden foreground shape density and pattern mix.
FG_DENSITY_MIN = 0.14
FG_DENSITY_MAX = 0.22
RECT_LOOP_PROB = 0.25
BRANCH_TRANSPOSE_PROB = 0.5
MIN_BRANCH_ROW_GAP = 1

# Color and retry settings.
COLOR_COUNT_OPTIONS = (4, 5)
COLOR_POOL = range(10)
GENERATION_RETRIES = 300

