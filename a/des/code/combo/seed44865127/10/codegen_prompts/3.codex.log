    divider_color = all_colors[idx]; idx += 1
    frame_base = all_colors[idx]; idx += 1
    mover_colors = all_colors[idx:idx + n_movers]; idx += n_movers
    distractor_colors = all_colors[idx:idx + n_distractors]; idx += n_distractors

    # Generate mover sprites
    sprites: list[np.ndarray] = []
    for mc in mover_colors:
        s = _make_sprite(mc, 5, sprite_area_w)
        if s is None:
