+            max_w = axis_cap
+        mask = _random_shape(max_h, max_w)
+        if mask is None:
+            return False
+        patch_h, patch_w = mask.shape
+        ranges = _placement_ranges(direction, patch_h, patch_w, h, w, center_r, center_c)
+        if ranges is None:
+            return False
+        (row_lo, row_hi), (col_lo, col_hi) = ranges
+
+        placed = False
+        for _ in range(200):
