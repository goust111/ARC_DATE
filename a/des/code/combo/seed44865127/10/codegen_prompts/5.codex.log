+
+
+def _extract_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    height, width = map(int, g.shape)
+    seen = np.zeros((height, width), dtype=bool)
+    components: list[dict[str, object]] = []
