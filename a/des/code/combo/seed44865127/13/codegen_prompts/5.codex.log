+    hidden_objects = []
+    for color in hidden_colors:
+        kind = random.choice(AXIS_KINDS)
+        obj = _make_object(kind)
+        if obj is None:
+            return None
+        placement = _place_object(reserved, obj)
+        if placement is None:
+            return None
