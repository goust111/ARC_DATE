+    proposals: dict[tuple[int, int], list[tuple[tuple[int, int, int, int], int]]] = {}
+
+    for color in colors:
+        best = _best_axis(g, color, bg)
+        if best is None:
+            continue
+        for pt in best["claims"]:
+            proposals.setdefault(pt, []).append((best["score"], color))
+
+    out = g.copy()
+    for pt, options in proposals.items():
+        if len(options) == 1:
+            out[pt] = options[0][1]
+            continue
