+    cols = [c for _r, c in union]
+    extent = (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)
+    score = (same_pairs, axis_cells, -extent, -len(claims))
+    return {"kind": kind, "axis_sum": axis_sum, "claims": claims, "score": score}
