+# --------------- generator ---------------
+
+GRID_HEIGHT_RANGE = (12, 18)
+GRID_WIDTH_RANGE = (12, 18)
+PALETTE = list(range(10))
+MAX_ATTEMPTS = 400
+
+HIDDEN_COUNT_CHOICES = (1, 2)
+EXTRA_VISIBLE_PROB = 0.5
+AXIS_KINDS = ("vertical", "horizontal")
+ODD_SPANS = (5, 7, 9)
