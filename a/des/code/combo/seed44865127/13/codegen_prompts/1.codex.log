+        "up": mr,
+        "right": box.shape[1] - 1 - mc,
+        "down": box.shape[0] - 1 - mr,
+        "left": mc,
+    }
+    best = min(dists.values())
+    matches = [name for name, dist in dists.items() if dist == best]
+    if len(matches) != 1:
