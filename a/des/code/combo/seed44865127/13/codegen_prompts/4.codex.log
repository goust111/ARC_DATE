+    if positive_sides == 3:
+        assert {h_sides, v_sides} == {1, 2}
+        if h_sides == 1:
+            assert up == down and up > 0
+            trunk_len = left + right + 1
+            branch_len = up + down + 1
+            assert trunk_len > branch_len
+            return _extend_horizontal(jr, jc, left, right, branch_len - 1)
