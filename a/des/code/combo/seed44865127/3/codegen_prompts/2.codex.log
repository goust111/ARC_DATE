+        _draw_region(
+            inp,
+            spec["r0"],
+            spec["c0"],
+            spec["size"],
+            frame_color,
+            spec["inner"],
+            spec["gaps"],
+        )
+
+    expected = inp.copy()
+    for spec in specs:
+        r0 = int(spec["r0"])
+        c0 = int(spec["c0"])
+        size = int(spec["size"])
+        expected[r0 + 1 : r0 + size - 1, c0 + 1 : c0 + size - 1] = _rotate_cw(
+            spec["inner"], spec["gap_count"]
+        )
+
+    if _get_bg(inp) != bg:
+        return None
+    if len(_find_regions(inp, bg)) != n_regions:
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
