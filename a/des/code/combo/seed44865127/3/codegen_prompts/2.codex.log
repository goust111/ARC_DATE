+    coords = [(0, c) for c in range(size)]
+    coords.extend((r, size - 1) for r in range(1, size - 1))
+    coords.extend((size - 1, c) for c in range(size - 1, -1, -1))
+    coords.extend((r, 0) for r in range(size - 2, 0, -1))
+    return coords
