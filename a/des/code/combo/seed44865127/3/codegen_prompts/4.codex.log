+        rect_a = (ra0, ca0, ra0 + h1 - 1, ca0 + w1 - 1)
+        rect_b = (rb0, cb0, rb0 + h2 - 1, cb0 + w2 - 1)
+        return rect_a, rect_b
+    return None
+
+
+def _sample_diagonal_pair(zone: Rect, rng: np.random.Generator) -> tuple[Rect, Rect] | None:
+    r0, c0, r1, c1 = zone
+    zone_h = r1 - r0 + 1
+    zone_w = c1 - c0 + 1
