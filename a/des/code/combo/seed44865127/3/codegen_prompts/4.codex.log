+        gap = _randint(rng, MIN_GAP, zone_h - h1 - h2)
+        total_h = h1 + gap + h2
+        top_pad = _randint(rng, 0, zone_h - total_h)
+        ra0 = r0 + top_pad
+        rb0 = ra0 + h1 + gap
+
+        ca0 = _randint(rng, c0, c1 - w1 + 1)
+        cb0 = _randint(rng, c0, c1 - w2 + 1)
+        if not _intervals_overlap(ca0, ca0 + w1 - 1, cb0, cb0 + w2 - 1):
