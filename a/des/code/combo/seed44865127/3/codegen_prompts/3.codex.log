+def _random_connected_mask(rng: np.random.Generator, h: int, w: int, size: int):
+    for _ in range(100):
+        start = (int(rng.integers(1, h - 1)), int(rng.integers(1, w - 1)))
+        cells = {start}
+        while len(cells) < size:
+            frontier = []
+            for r, c in cells:
+                for dr, dc in ORTHO_STEPS:
+                    nr, nc = r + dr, c + dc
+                    if 1 <= nr < h - 1 and 1 <= nc < w - 1 and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(frontier[int(rng.integers(len(frontier)))])
+        if len(cells) != size:
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        box = _bbox(mask)
+        assert box is not None
+        r0, c0, r1, c1 = box
+        if r1 == r0 or c1 == c0:
+            continue
+        return mask
+    return None
+
+
+def _pattern_size(pattern) -> int:
+    return len(pattern)
+
+
+def _place_extra(
