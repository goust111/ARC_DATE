+    return None
+
+
+def _build_panel(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
+    panel = np.full(mask.shape, bg, dtype=int)
+    panel[mask] = color
+    return panel
+
+
+def _gen_attempt(rng: np.random.Generator):
