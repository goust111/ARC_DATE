    return random.randint(EDGE_MARGIN, max_top)


def _marker_shapes() -> list[np.ndarray]:
    return [np.array(x, dtype=bool) for x in MARKER_SHAPE_TEMPLATES]


def _touches_existing(coords: np.ndarray, occupied: np.ndarray) -> bool:
    n = occupied.shape[0]
    for r, c in coords:
        r = int(r)
        c = int(c)
        if occupied[r, c]:
