    return cols


def _input_top(n: int, h: int) -> int | None:
    frac_top = (INPUT_TOP_FRACTION[0] * int(n)) // INPUT_TOP_FRACTION[1] - int(h)
    max_top = min(int(n) - int(h) - EDGE_MARGIN, max(EDGE_MARGIN, frac_top))
