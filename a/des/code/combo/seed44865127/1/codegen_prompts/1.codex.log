+    grid = np.full((grid_h, grid_w), bg, dtype=int)
+    grid[frame_r0 : frame_r0 + frame_h, frame_c0 : frame_c0 + frame_w] = frame_patch
+
+    legend_col = 0 if legend_side == "left" else grid_w - 1
