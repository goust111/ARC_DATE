+def _shape_variants(mask: np.ndarray) -> list[np.ndarray]:
+    base = _trim(mask.astype(bool))
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], tuple[int, ...]]] = set()
+    for k in range(4):
