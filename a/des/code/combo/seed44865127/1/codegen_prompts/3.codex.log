+
+def _build_loop_shape(rng: random.Random) -> dict[str, object] | None:
+    inner = _random_inner_shape(rng)
+    region = _dilate4_coords(inner)
+    outline = _boundary_coords(region)
+    interior = region - outline
+    outer = set()
+    for r, c in region:
