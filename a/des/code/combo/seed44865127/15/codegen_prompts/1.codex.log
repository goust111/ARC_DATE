+    return None
+
+
+def _slot_positions(
+    slots: int, cell_size: int, total_size: int, rng: np.random.Generator
+) -> list[int] | None:
+    minimum = slots * cell_size + (slots + 1) * MIN_GAP
+    extra = total_size - minimum
+    if extra < 0:
+        return None
+
+    slack = _random_composition(extra, slots + 1, rng)
