+
+            if not found:
+                break
+
+        if len(masks) != count:
+            continue
+        if len(set(hole_sets)) != count:
+            continue
+
+        common_missing = set(hole_sets[0])
+        for hole_set in hole_sets[1:]:
+            common_missing &= set(hole_set)
+        if common_missing:
+            continue
+
+        consensus = np.zeros_like(base_mask, dtype=bool)
+        for mask in masks:
+            consensus |= mask
