+
+
+def _sample_layout(
+    sprite_count: int, bbox_h: int, bbox_w: int, rng: np.random.Generator
+) -> tuple[int, int, list[tuple[int, int]]] | None:
+    options = []
+    for row_slots in range(1, sprite_count + 1):
