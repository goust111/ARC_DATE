+
+def _trim_pair(inp_patch: np.ndarray, out_patch: np.ndarray, bg: int) -> tuple[np.ndarray, np.ndarray]:
+    mask = (inp_patch != bg) | (out_patch != bg)
+    coords = np.argwhere(mask)
