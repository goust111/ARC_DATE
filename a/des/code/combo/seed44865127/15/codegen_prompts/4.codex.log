+        c0 = int(spec["region_c0"])
+        h = int(spec["region_h"])
+        w = int(spec["region_w"])
+        out[r0 + 1 : r0 + h - 1, c0 + 1 : c0 + w - 1] = fill_color
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    height = rng.randint(18, 26)
+    width = rng.randint(18, 26)
+    inp = np.full((height, width), BG, dtype=int)
