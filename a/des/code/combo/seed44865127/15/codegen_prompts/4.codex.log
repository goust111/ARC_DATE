+    for _ in range(max_tries):
+        clock_r0 = rng.randint(0, h - 3)
+        clock_c0 = rng.randint(0, w - 3)
+        region_r0, region_c0 = _pair_region_origin(clock_r0, clock_c0, region_h, region_w, region_side, gap)
