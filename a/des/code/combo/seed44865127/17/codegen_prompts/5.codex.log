+from __future__ import annotations
+
+import numpy as np
+
+
+SCALE_COLOR = 5
+BEAM_LENGTHS = (5, 7)
+PAN_WIDTHS_BY_BEAM = {5: (3,), 7: (3, 5)}
+PAN_HEIGHTS = (3, 4, 5)
+HANGER_HEIGHTS = (1, 2)
+PILLAR_HEIGHTS = (2, 3)
+
+N_SCALES_RANGE = (2, 4)  # inclusive
+GRID_BASE_MIN = 18
+GRID_GROWTH_PER_EXTRA_SCALE = 3
+GRID_EXTRA_RANGE = 8
+PLACEMENT_PADDING = 2
+GEN_RETRIES = 400
