+# --------------- generator ---------------
+
+COLOR_VALUES = tuple(range(10))
+GEN_RETRIES = 400
+
+GROUP_COUNT_RANGE = (1, 2)
+OBJECT_AREA_RANGE = (3, 7)
+OBJECT_BOX_MIN = 2
+OBJECT_BOX_MAX = 4
+
+MOTIF_CANVAS = 6
+SLOT_H = 9
+SLOT_W = 9
+OUTER_BORDER_RANGE = (0, 1)
