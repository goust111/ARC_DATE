+def _random_object_patch(color: int, bg: int) -> np.ndarray:
+    for _ in range(200):
+        box_h = random.randint(OBJECT_BOX_MIN, OBJECT_BOX_MAX)
+        box_w = random.randint(OBJECT_BOX_MIN, OBJECT_BOX_MAX)
