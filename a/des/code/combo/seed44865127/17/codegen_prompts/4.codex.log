+
+def _corners(shape: tuple[int, int]) -> dict[str, tuple[int, int]]:
+    h, w = shape
+    return {
+        "TL": (0, 0),
+        "TR": (0, w - 1),
+        "BL": (h - 1, 0),
+        "BR": (h - 1, w - 1),
