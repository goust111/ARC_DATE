+    full_shadow: bool,
+) -> tuple[int, int, int, int] | None:
+    h, w = grid_shape
+    mh, mw = mask_shape
+    row_lo = 0
+    row_hi = h - mh
+    col_lo = 0
+    col_hi = w - mw
+
+    if full_shadow:
