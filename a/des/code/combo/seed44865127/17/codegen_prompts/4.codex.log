+YELLOW = 4
+GREY = 5
+DIR_BY_CORNER = {
+    "TL": (1, 1),
+    "TR": (1, -1),
+    "BL": (-1, 1),
+    "BR": (-1, -1),
+}
+_CORNER_BAG: list[str] = []
