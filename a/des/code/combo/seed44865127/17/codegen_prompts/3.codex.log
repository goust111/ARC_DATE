+import random
+from collections import deque
+
+import numpy as np
+
+
+MAX_GEN_ATTEMPTS = 400
+PAD = 1
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(cnts)])
+
+
+def _scale_index(idx: int, src_len: int, dst_len: int) -> int:
+    if src_len <= 1 or dst_len <= 1:
+        return 0
+    return idx * (dst_len - 1) // (src_len - 1)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(grid[r0, c0]) == bg:
+                continue
+            color = int(grid[r0, c0])
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _is_window_frame(grid: np.ndarray, bg: int, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 5:
+        return False
+    coords = comp["coords"]
+    if len(coords) != 2 * (h + w) - 4:
+        return False
+    for r, c in coords:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return False
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if np.any(sub[1:-1, 1:-1] != bg):
+        return False
+    return True
+
+
+def _find_windows(grid: np.ndarray, bg: int) -> list[dict]:
+    frames = [comp for comp in _find_components(grid, bg) if _is_window_frame(grid, bg, comp)]
+    frames.sort(key=lambda item: item["bbox"])
+    return frames
+
+
+def _project_pixels(
+    out: np.ndarray,
+    pixels: list[tuple[int, int]],
+    landscape_h: int,
+    window: dict,
+) -> None:
