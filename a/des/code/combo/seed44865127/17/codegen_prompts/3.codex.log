+
+
+def _sample_object_positions(
+    occupied: np.ndarray,
+    mask: np.ndarray,
+    row_limit: int,
+    overlap: tuple[int, int] | None,
+    require_cross: bool | None,
+) -> list[tuple[int, int]]:
+    h, w = occupied.shape
+    ph, pw = mask.shape
+    positions: list[tuple[int, int]] = []
+    cols_local = np.where(mask)[1]
+    for r0 in range(0, row_limit - ph + 1):
