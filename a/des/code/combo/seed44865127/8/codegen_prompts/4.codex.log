+        seen = np.zeros((h, w), dtype=bool)
+        for r0, c0 in np.argwhere(mask):
+            r = int(r0)
+            c = int(c0)
+            if seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
