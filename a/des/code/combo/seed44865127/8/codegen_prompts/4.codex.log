    if area <= _GEN_SMALL_FULL_AREA_MAX and random.random() < _GEN_SMALL_FULL_PROB:
        target = area
    else:
        target = random.randint(min_pixels, max_pixels)

    return mask if _gen_grow_mask(mask, target) else None


