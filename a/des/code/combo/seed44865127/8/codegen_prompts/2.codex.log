+        for c in range(w):
+            if blocked[r, c]:
+                continue
+            dists = [_distance_to_bbox((r, c), anchor["bbox"]) for anchor in anchors]
+            best = min(dists)
+            winners = [idx for idx, dist in enumerate(dists) if dist == best]
+            if len(winners) == 1:
