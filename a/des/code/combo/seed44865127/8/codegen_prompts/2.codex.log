+
+def _outer_ring(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    assert 0 < r0 <= r1 < h - 1
+    assert 0 < c0 <= c1 < w - 1
+
+    ring: list[tuple[int, int]] = []
+    for c in range(c0 - 1, c1 + 2):
+        ring.append((r0 - 1, c))
+    for r in range(r0, r1 + 2):
+        ring.append((r, c1 + 1))
+    for c in range(c1, c0 - 2, -1):
+        ring.append((r1 + 1, c))
+    for r in range(r1, r0 - 1, -1):
+        ring.append((r, c0 - 1))
+    return ring
