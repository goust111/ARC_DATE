+    dr = 0
+    if r < r0:
+        dr = r0 - r
+    elif r > r1:
+        dr = r - r1
+    dc = 0
+    if c < c0:
+        dc = c0 - c
+    elif c > c1:
+        dc = c - c1
+    return int(dr + dc)
