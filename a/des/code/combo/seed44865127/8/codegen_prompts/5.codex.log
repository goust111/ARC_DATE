+
+def _normalized(coords: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    min_r = min(r for r, _c in coords)
+    min_c = min(c for _r, c in coords)
+    return {(r - min_r, c - min_c) for r, c in coords}
