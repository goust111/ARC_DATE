+    joints = {pixel for pixel in coords if _is_joint_pixel(coords, pixel)}
+    if not joints:
+        return 1
+    remainder = coords - joints
+    assert remainder, "removing joints must leave at least one branch pixel"
+    return len(_connected_components(remainder))
