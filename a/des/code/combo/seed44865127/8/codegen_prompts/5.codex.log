+# --------------- generator (att1) ---------------
+
+GRID_MIN = 14
+GRID_MAX = 22
+COPIES_PER_BRANCH_CHOICES = (1, 2)
+LINE_LEN_RANGE = (2, 6)
+L_ARM_RANGE = (2, 5)
+T_ARM_RANGE = (2, 4)
+CROSS_ARM_RANGE = (2, 4)
+PLACEMENT_PADDING = 1
