+                if len(adj) != 1:
+                    valid = False
+                    break
+                endpoint_to_obj[endpoint] = next(iter(adj))
+            if not valid or len(set(endpoint_to_obj.values())) != 2:
+                continue
+
+            sample_pairs.append(
