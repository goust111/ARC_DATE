+def _path_endpoints(coords: np.ndarray) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    cells = {tuple(map(int, cell)) for cell in coords}
+    degrees = {}
+    for r, c in cells:
+        deg = 0
+        for dr, dc in DIR4:
+            if (r + dr, c + dc) in cells:
+                deg += 1
