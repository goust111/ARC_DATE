+def _mask_signature(mask: np.ndarray) -> tuple[int, int, tuple[int, ...]]:
+    trimmed = _trim_mask(mask)
+    return (
+        int(trimmed.shape[0]),
+        int(trimmed.shape[1]),
+        tuple(int(x) for x in trimmed.astype(int).ravel()),
+    )
