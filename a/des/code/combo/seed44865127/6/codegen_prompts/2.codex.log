+    bg: int,
+    line_color: int,
+    cell_to_comp: np.ndarray,
+) -> set[int]:
+    h, w = grid.shape
+    touched = set()
+    for r, c in coords:
+        for dr, dc in DIR4:
+            nr, nc = int(r + dr), int(c + dc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            color = int(grid[nr, nc])
+            if color in (bg, line_color):
+                continue
+            touched.add(int(cell_to_comp[nr, nc]))
+    return touched
+
+
+def _adjacent_component_ids_for_cell(
