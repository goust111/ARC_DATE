+        int(trimmed.shape[0]),
+        int(trimmed.shape[1]),
+        tuple(int(x) for x in trimmed.astype(int).ravel()),
+    )
+
+
+def _all_transforms(mask: np.ndarray) -> list[np.ndarray]:
+    out = []
+    for k in range(4):
