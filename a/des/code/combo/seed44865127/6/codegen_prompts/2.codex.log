+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
