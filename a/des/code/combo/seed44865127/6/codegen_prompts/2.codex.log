+def _unique_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants = []
+    seen = set()
+    for variant in _all_transforms(mask):
+        sig = _mask_signature(variant)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        variants.append(variant)
+    return variants
