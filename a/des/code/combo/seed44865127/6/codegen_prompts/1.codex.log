+        small_side = 0
+        diff = 0
+    elif side_counts[-1] < side_counts[1]:
+        small_side = -1
+        diff = side_counts[1] - side_counts[-1]
+    else:
+        small_side = 1
+        diff = side_counts[-1] - side_counts[1]
