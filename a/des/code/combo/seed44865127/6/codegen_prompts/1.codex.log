+        output_pixels = _translate_pixels(obj["output"], dr, dc)
+
+        input_coords = {(r, c) for r, c, _color in input_pixels}
+        output_coords = {(r, c) for r, c, _color in output_pixels}
+        if any(coord in input_blocked for coord in input_coords):
