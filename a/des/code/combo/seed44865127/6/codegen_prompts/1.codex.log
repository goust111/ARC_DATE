+    body: list[tuple[int, int, int, int]] = []
+    side_counts = Counter()
+    for r, c in coords:
+        color = int(grid[r, c])
+        if orient == "vertical":
+            if c == line_idx:
+                continue
+            side = -1 if c < line_idx else 1
+        else:
+            if r == line_idx:
+                continue
+            side = -1 if r < line_idx else 1
