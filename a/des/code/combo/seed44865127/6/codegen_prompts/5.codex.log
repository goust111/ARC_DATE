    for blob in existing_blobs:
        for r1, c1 in new_coords:
            for r2, c2 in blob:
                if max(abs(r1 - r2), abs(c1 - c2)) < SAME_COLOR_MIN_CHEBYSHEV:
                    return False
    return True


