+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+RED = 2
+BLUE = 1
+GREEN = 3
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+TURN_PRIORITY = {1: 0, 0: 1, 3: 2, 2: 3}
+
+GEN_COLOR_POOL = [0, 4, 5, 6, 7, 8, 9]
