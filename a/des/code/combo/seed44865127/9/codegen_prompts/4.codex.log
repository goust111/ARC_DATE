+def _sample_specs() -> tuple[str, dict[str, int], list[tuple[str, np.ndarray]]]:
+    winner, counts = _vote_profile()
+    specs: list[tuple[str, np.ndarray]] = []
+    for kind in TYPE_ORDER:
