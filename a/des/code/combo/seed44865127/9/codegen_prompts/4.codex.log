+    loser_idx = 0
+    for kind in TYPE_ORDER:
+        if kind == winner:
+            counts[kind] = int(profile[0])
+        else:
+            counts[kind] = int(losers[loser_idx])
+            loser_idx += 1
+    return winner, counts
+
