+
+
+def _make_h_only(n: int) -> np.ndarray:
+    mid_r = _center_slice(n)
+    mid_cols = range(mid_r.start, mid_r.stop)
+    left_pool = [c for c in range(n) if c < mid_r.start]
+    right_pool = [c for c in range(n) if c >= mid_r.stop]
+
+    for _ in range(60):
