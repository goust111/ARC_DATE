+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+TYPE_ORDER = ("both", "h_only", "v_only", "none")
+LEGEND_SIZE = 2
+PALETTE = tuple(range(10))
+
+_RNG = np.random.default_rng()
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _mask_from_component(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    mask = np.zeros((h, w), dtype=bool)
+    rel = coords - np.array([[r0, c0]], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _classify_mask(mask: np.ndarray) -> str:
+    mask = np.asarray(mask, dtype=bool)
+    h_sym = bool(np.array_equal(mask, np.flipud(mask)))
+    v_sym = bool(np.array_equal(mask, np.fliplr(mask)))
+    if h_sym and v_sym:
+        return "both"
+    if h_sym:
+        return "h_only"
+    if v_sym:
+        return "v_only"
+    return "none"
+
+
+def _legend_colors(grid: np.ndarray) -> dict[str, int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    assert h >= 2 * LEGEND_SIZE and w >= 2 * LEGEND_SIZE
+
