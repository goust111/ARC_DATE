+        mask = mask.astype(bool)
+    if mask.shape[0] != mask.shape[1]:
+        return False
+    if not bool(mask.any()):
+        return False
+    if not _touches_all_sides(mask):
+        return False
+    comps = _components4(mask)
+    if len(comps) != 1:
+        return False
+    return _classify_mask(mask) == kind
