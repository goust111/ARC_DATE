+def _vote_profile() -> tuple[str, dict[str, int]]:
+    winner = TYPE_ORDER[int(_RNG.integers(0, len(TYPE_ORDER)))]
+    profile = list(PROFILES[int(_RNG.integers(0, len(PROFILES)))])
+    losers = profile[1:]
