    """Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10."""
    dims = []
    for h in range(1, BBOX_MAX + 1):
        for w in range(1, BBOX_MAX + 1):
            if area > h * w:
                continue
            if area * 10 < MIN_FILL_RATIO_X10 * h * w:
                continue
            if h == 1 and area != w:
                continue
            if w == 1 and area != h:
                continue
            if h > 1 and w > 1 and area < max(h, w):
                continue
            dims.append((h, w))
    return dims


