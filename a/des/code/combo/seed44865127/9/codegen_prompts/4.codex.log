+        (0, min(h, LEGEND_SIZE + 1), max(0, w - LEGEND_SIZE - 1), w),
+        (max(0, h - LEGEND_SIZE - 1), h, 0, min(w, LEGEND_SIZE + 1)),
+        (max(0, h - LEGEND_SIZE - 1), h, max(0, w - LEGEND_SIZE - 1), w),
