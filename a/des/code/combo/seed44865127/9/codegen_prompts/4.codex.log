+        if n >= 5 and int(_RNG.integers(0, 2)) == 1:
+            bump_col = int(_RNG.choice(pool))
+            offset = int(_RNG.integers(1, mid_r.start + 1))
+            top = mid_r.start - offset
+            bottom = mid_r.stop - 1 + offset
