+            src_c0 = max(0, -dc)
+            src_c1 = min(w, w - dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = min(h, h + dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = min(w, w + dc)
