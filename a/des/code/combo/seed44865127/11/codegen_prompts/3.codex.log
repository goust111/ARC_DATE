+    patch = np.full((height, width), bg, dtype=int)
+    if direction == "up":
+        patch[:, 0] = fg
+        patch[:, -1] = fg
+        patch[-1, :] = fg
+    elif direction == "down":
+        patch[:, 0] = fg
+        patch[:, -1] = fg
+        patch[0, :] = fg
+    elif direction == "left":
+        patch[0, :] = fg
+        patch[-1, :] = fg
+        patch[:, -1] = fg
+    else:
+        assert direction == "right"
+        patch[0, :] = fg
+        patch[-1, :] = fg
+        patch[:, 0] = fg
+    return patch
+
