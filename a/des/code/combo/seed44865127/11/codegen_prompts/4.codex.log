+    start = next(iter(coords))
+    stack = [start]
+    seen = {start}
+    while stack:
+        cur = stack.pop()
+        for nxt in _neighbors4(cur):
+            if nxt in coords and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(coords)
