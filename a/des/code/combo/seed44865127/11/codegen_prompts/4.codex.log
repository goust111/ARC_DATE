+    fg_colors = set(map(int, np.unique(grid))) - {BG}
+    if len(fg_colors) not in {2, 3}:
+        return None
+
+    bg, objects, best_mask, indices, metadata = _analyze_group(grid)
+    selected_sets = {objects[idx]["coord_set"] for idx in indices}
+    max_count = max(
+        len(indices2)
+        for indices2 in {
+            mask: tuple(sorted(ids))
+            for mask, ids in {
+                mask: [obj_idx for obj_idx in range(len(objects)) if mask in objects[obj_idx]["variants"]]
+                for mask in {m for obj in objects for m in obj["variants"]}
+            }.items()
+            if len(ids) >= 2
+        }.values()
+    )
+    num_max = sum(
+        len(tuple(sorted(ids))) == max_count
+        for ids in {
+            mask: [obj_idx for obj_idx in range(len(objects)) if mask in objects[obj_idx]["variants"]]
+            for mask in {m for obj in objects for m in obj["variants"]}
+        }.values()
+        if len(ids) >= 2
+    )
+    if best_mask != skeleton or tuple(indices) != tuple(sorted(indices)):
+        pass
+    if selected_sets != target_sets:
+        return None
+    if best_mask != skeleton:
+        return None
+    if len(indices) != len(target_shapes):
+        return None
+    if max_count != len(target_shapes) or num_max != 1:
+        return None
+
+    out = main(grid)
+    if BLUE not in out or RED not in out:
+        return None
+    if bg != BG or not metadata[best_mask]:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input failed after {GEN_ATTEMPTS} attempts")

