+        if not bool(np.all(grid[:, l0 : l1 + 1] == sep_color)):
+            continue
+        if not bool(np.all(grid[:, r0 : r1 + 1] == sep_color)):
+            continue
+        if int(grid[0, r0]) != sep_color:
+            continue
+
+        src = grid[:, :l0]
+        legend = grid[:, l1 + 1]
+        tgt = grid[:, r1 + 1 :]
+        if src.shape[1] < 2 or tgt.shape[1] < 2:
+            continue
