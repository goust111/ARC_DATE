from __future__ import annotations

import random

import numpy as np


BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
ORANGE = 7

DIR_BY_COLOR = {
    RED: (0, 1),
    BLUE: (1, 0),
    GREEN: (0, -1),
    YELLOW: (-1, 0),
}

BG_CHOICES = (0, 6, 8, 9)
