+    distractor_target = random.randint(1, min(3, len(colors) - 1))
+    placed = 0
+    for color in colors[1:]:
+        pair_order = smaller_pairs[:]
+        random.shuffle(pair_order)
+        success = False
+        for h, w in pair_order:
+            mask = _closed_mask(h, w)
+            if int(mask.sum()) >= largest_area:
