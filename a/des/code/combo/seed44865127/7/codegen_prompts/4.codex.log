+    left, largest_mask = left_pack
+    right = _pattern_panel(panel_h, panel_w, bg, pattern_colors)
+    sep_block = np.full((panel_h, sep_w), sep, dtype=int)
+    grid = np.hstack([left, sep_block, right])
