+
+    smaller_pairs = [
+        (h, w)
+        for h in _divisors(panel_h, proper_only=False)
+        for w in _divisors(panel_w, proper_only=False)
+        if h * w < largest_mask.shape[0] * largest_mask.shape[1]
+    ]
+    if not smaller_pairs:
