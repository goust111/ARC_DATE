+import random
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GRID_HEIGHT_RANGE = (18, 28)
+GRID_WIDTH_RANGE = (18, 28)
