+    min_h = max(GRID_HEIGHT_RANGE[0], max(int(obj["dims"][0]) for obj in objects) + 2)
+    min_w = max(GRID_WIDTH_RANGE[0], max(int(obj["dims"][1]) for obj in objects) + 2)
