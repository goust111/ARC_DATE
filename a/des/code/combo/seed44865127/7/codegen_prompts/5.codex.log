from __future__ import annotations

import random
import numpy as np


LEGEND_LENGTHS = (3, 4)
LEGEND_CORNERS = ("tl", "tr", "bl", "br")
GRID_HEIGHT_RANGE = (14, 20)
GRID_WIDTH_RANGE = (14, 20)
