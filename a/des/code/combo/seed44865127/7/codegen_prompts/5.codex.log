            c0, c1, colors = run
            cells = [(row_idx, c) for c in range(c0, c1 + 1)]
            if _legend_is_isolated(grid, bg, cells):
                candidates.append((cells, colors))
    assert len(candidates) == 1, "expected exactly one isolated corner legend"
    return candidates[0]


