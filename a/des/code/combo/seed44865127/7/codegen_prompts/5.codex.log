    return True


def _find_legend(grid: np.ndarray, bg: int) -> tuple[list[tuple[int, int]], list[int]]:
    height, width = grid.shape
    candidates: list[tuple[list[tuple[int, int]], list[int]]] = []
    for row_idx in (0, height - 1):
        for from_left in (True, False):
