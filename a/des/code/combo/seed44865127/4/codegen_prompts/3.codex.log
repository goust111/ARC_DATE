+    div_r = 0
+    for height in row_heights[:-1]:
+        div_r += height
+        grid[div_r, :] = divider
+        div_r += 1
+
+    div_c = 0
+    for width in col_widths[:-1]:
+        div_c += width
+        grid[:, div_c] = divider
+        div_c += 1
+
+    in_r = 0
+    out_r = 0
+    for row_idx, region_h in enumerate(row_heights):
+        in_c = 0
+        out_c = 0
+        for col_idx, region_w in enumerate(col_widths):
