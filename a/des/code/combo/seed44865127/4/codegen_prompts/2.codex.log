+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    gaps = [rows[i + 1] - rows[i] - 1 for i in range(len(rows) - 1)]
+    if len(set(gaps)) != len(gaps):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _attempt()
+        if grid is not None:
