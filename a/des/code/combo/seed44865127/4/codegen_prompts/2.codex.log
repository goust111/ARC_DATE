+def _marker_rows(grid: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    rows: list[tuple[int, int]] = []
+    for r in range(grid.shape[0]):
+        row = grid[r]
+        color = int(row[0])
+        if np.all(row == color):
