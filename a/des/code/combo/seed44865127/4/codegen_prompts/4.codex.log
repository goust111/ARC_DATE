+    if style == "line":
+        length = int(rng.integers(2, 6))
+        if rng.random() < 0.5:
+            mask = np.ones((1, length), dtype=bool)
+        else:
+            mask = np.ones((length, 1), dtype=bool)
+        return _reorient(mask, rng)
