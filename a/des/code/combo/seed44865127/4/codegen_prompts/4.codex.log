+def _random_shape(rng: np.random.Generator) -> np.ndarray:
+    style = str(rng.choice(["rect", "line", "ell", "tee", "poly"]))
+
+    if style == "rect":
+        h = int(rng.integers(1, 4))
+        w = int(rng.integers(1, 5))
+        mask = np.ones((h, w), dtype=bool)
+        return _reorient(mask, rng)
