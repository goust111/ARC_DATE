  42:                     ok = False
  43:                     break
  44:             if ok and v not in anchors_by_color:
  45:                 anchors_by_color[int(v)] = (int(r), int(c))
  46: 
  47:     assert not (not anchors_by_color)
  48: 
  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}
  50: 
  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---
  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
  53: 
  54:     def component_marker_color(coords: np.ndarray) -> int | None:
  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.
  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]
  57:         cnt = Counter(vals)
  58:         if len(cnt) <= 1:
  59:             return None
  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
