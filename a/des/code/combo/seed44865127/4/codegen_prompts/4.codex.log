+    if corner == "top_right":
+        return [(r, w - 1) for r in range(4)]
+    if corner == "bottom_left":
+        return [(h - 4 + i, 0) for i in range(4)]
+    if corner == "bottom_right":
+        return [(h - 4 + i, w - 1) for i in range(4)]
+    raise ValueError(f"unknown corner {corner}")
+
