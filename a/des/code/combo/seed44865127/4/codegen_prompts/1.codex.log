+def _paint_frame(grid: np.ndarray, r0: int, c0: int, border: int, center: int) -> None:
+    grid[r0 : r0 + 3, c0 : c0 + 3] = int(border)
+    grid[r0 + 1, c0 + 1] = int(center)
