    h, w = shape
    if kind == "H":
        cells = {(r, c), (h - 1 - r, c)}
    elif kind == "V":
        cells = {(r, c), (r, w - 1 - c)}
    else:
        cells = {(r, c), (c, r)}
    return tuple(sorted(cells))


