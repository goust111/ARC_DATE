            orbit = _gen_orbit(kind, mask.shape, r, c)
            if orbit in seen or any(cell in forbidden for cell in orbit):
                continue
            seen.add(orbit)
            new_cells = [cell for cell in orbit if not mask[cell]]
            if not new_cells or len(new_cells) > limit:
