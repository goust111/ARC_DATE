+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+ARC_COLORS = tuple(range(10))
+MIN_SEGMENTS = 2
+MAX_SEGMENTS = 5
+MIN_TOTAL_LENGTH = 7
+MAX_TOTAL_LENGTH = 18
+MIN_SIDE = 5
+MAX_SIDE = 22
+MAX_WALK_ATTEMPTS = 80
+MAX_GENERATION_ATTEMPTS = 400
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
