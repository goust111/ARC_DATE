+def _place_objects(grid: np.ndarray, objects: list[dict]) -> bool:
+    h, w = grid.shape
+    reserved = np.zeros((h, w), dtype=bool)
+
+    for obj in sorted(objects, key=lambda item: item["mask"].size, reverse=True):
+        mask = obj["mask"]
+        oh, ow = mask.shape
+        coords = np.argwhere(mask)
