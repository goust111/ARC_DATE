+    horiz = num_objects // 2
+    vert = num_objects // 2
+    if num_objects % 2 == 1:
+        if RNG.random() < 0.5:
+            horiz += 1
+        else:
+            vert += 1
+    orientations = ["h"] * horiz + ["v"] * vert
+    RNG.shuffle(orientations)
+    return orientations
+
