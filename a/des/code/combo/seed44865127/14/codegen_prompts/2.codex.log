+SHORT_AXIS_CHOICES = (3, 5, 7)
+LONG_EXTRA_MIN = 2
+LONG_EXTRA_MAX = 7
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _component_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            arr = np.asarray(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return components
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Compress every foreground object onto the center line of its longest bbox axis.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    bg = get_bg(g)
+    out = np.full_like(g, bg)
+
+    for comp in find_components(g, bg):
+        r0, c0, r1, c1 = comp["bbox"]
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        color = int(comp["color"])
+
+        if width > height:
+            row = (r0 + r1) // 2
+            out[row, c0 : c1 + 1] = color
+        else:
+            col = (c0 + c1) // 2
+            out[r0 : r1 + 1, col] = color
+
+    return out
+
