+GENERATION_RETRIES = 400
+PLACEMENT_RETRIES = 160
+SHAPE_RETRIES = 80
+
+MIN_OBJECTS = 2
+MAX_OBJECTS = 4
+MIN_GRID_SIDE = 14
+MAX_GRID_SIDE = 28
