    h, w = g.shape
    assert h == w and h >= 2, "input must be a square grid with a 2x2 top crop"

    side = _side_from_top_repetition(g)
    if side is None:
        side = _side_from_rarer_top_corner(g)

    c0 = 0 if side == "left" else w - 2
    return g[:2, c0 : c0 + 2].copy()

