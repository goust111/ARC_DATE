+def _sample_rectangle(height: int, width: int, touch_count: int) -> tuple[int, int, int, int] | None:
+    max_area = max(12, int(height * width * MAX_RECT_FRACTION))
+
+    for _ in range(RECT_SAMPLE_LIMIT):
