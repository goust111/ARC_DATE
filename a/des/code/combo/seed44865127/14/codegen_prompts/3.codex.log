+    while int(mask.sum()) > target and stale < MASK_REMOVAL_ATTEMPTS:
+        cells = np.argwhere(mask)
+        rr, cc = map(int, cells[int(rng.integers(len(cells)))])
+        trial = mask.copy()
+        trial[rr, cc] = False
+        if not _touches_all_sides(trial) or not _mask_connected(trial):
+            stale += 1
