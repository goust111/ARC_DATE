+    for _ in range(PLACEMENT_ATTEMPTS):
+        grid_h = int(rng.integers(max(GRID_MIN, max_h + 4), GRID_MAX + 1))
+        grid_w = int(rng.integers(max(GRID_MIN, max_w + 4), GRID_MAX + 1))
