+def _valid_scene(grid: np.ndarray, bg: int) -> bool:
+    if _get_bg(grid) != bg:
+        return False
+
+    objects = _find_objects(grid, bg)
+    if len(objects) < 4:
+        return False
+
+    shape = objects[0]["patch"].shape
