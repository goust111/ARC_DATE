+
+def _choose_directions(n_arrows: int) -> list[str]:
+    directions = [random.choice(tuple(DIRS))]
+    for _ in range(1, n_arrows):
+        directions.append(random.choice(PERP[directions[-1]]))
+    return directions
+
+
+def _build_nodes(
