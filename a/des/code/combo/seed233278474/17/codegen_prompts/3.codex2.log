+def _touches_4(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r, c in a:
+        if (r - 1, c) in b or (r + 1, c) in b or (r, c - 1) in b or (r, c + 1) in b:
+            return True
+    return False
