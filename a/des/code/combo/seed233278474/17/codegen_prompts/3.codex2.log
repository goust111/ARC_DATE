+    elif direction == "D":
+        near_r = r
+        if side == "L":
+            cells = {(near_r, c - 1), (near_r, c - 2), (near_r + 1, c - 2)}
+        else:
+            cells = {(near_r, c + 2), (near_r, c + 3), (near_r + 1, c + 3)}
+    else:
