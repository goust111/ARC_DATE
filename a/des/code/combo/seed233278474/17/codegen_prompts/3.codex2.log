+
+def _render_output(shape: tuple[int, int], chains: list[dict[str, object]]) -> np.ndarray:
+    grid = np.full(shape, BG_COLOR, dtype=int)
+    for chain in chains:
+        for arrow in chain["arrows"]:  # type: ignore[index]
+            for r, c in arrow:
