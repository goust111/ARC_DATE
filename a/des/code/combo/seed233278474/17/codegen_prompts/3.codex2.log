            cnt = Counter()
            for r, c in interior:
                if not (0 <= r < H and 0 <= c < W):
                    cnt.clear()
                    break
                v = int(g[r, c])
                if v != bg and v != int(border_col):
                    cnt[v] += 1
            if not cnt:
                continue

            top = cnt.most_common(2)
            if len(top) > 1 and top[0][1] == top[1][1]:
                continue
            content_col = int(top[0][0])
            content_cells = [p for p in interior if int(g[p[0], p[1]]) == content_col]
