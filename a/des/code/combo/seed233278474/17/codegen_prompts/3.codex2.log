+        if len(blocks) != n_chains:
+            continue
+
+        planned = {int(chain["color"]): chain["final"] for chain in chains}
+        if finals != planned:
+            continue
+
+        try:
+            out = main(inp)
+        except AssertionError:
+            continue
+        if not np.array_equal(out, expected):
+            continue
+
+        if require_multi and not any(len(chain["nodes"]) >= 2 for chain in chains):
+            continue
+        return inp
+
