    if ac1 < c0 and c0 - ac1 == 2 and _overlap_len(ar0, ar1, r0, r1) >= 1:
        return "L"
    if ac0 > c1 and ac0 - c1 == 2 and _overlap_len(ar0, ar1, r0, r1) >= 1:
        return "R"
    return None


