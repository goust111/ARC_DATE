+        require_multi = random.random() < 0.7
+
+        chains: list[dict[str, object]] = []
+        forbidden: set[tuple[int, int]] = set()
+        ok = True
+        for idx, color in enumerate(colors):
+            chain = _build_chain(shape, forbidden, color, require_multi and idx == 0)
