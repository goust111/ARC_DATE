+
+        reserve = _dilate(path_cells, shape, 2) | _dilate(arrow_cells, shape, 1)
+        chain: dict[str, object] = {
+            "color": color,
+            "nodes": nodes,
+            "directions": directions,
+            "positions": positions,
+            "final": final_pos,
+            "arrows": arrows,
+            "reserve": reserve,
+        }
