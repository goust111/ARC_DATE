+        for c in range(1, width - 1)
+        if _far_from_all((r, c), legend_cells)
+    ]
+    random.shuffle(candidates)
+
+    chosen: list[tuple[int, int]] = []
+    chosen_set: set[tuple[int, int]] = set()
+    for cell in candidates:
+        if _far_from_all(cell, chosen_set):
+            chosen.append(cell)
+            chosen_set.add(cell)
+            if len(chosen) == total:
+                return chosen
+    return None
