+def _rect_border_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _frame_bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    if len(coords) < 8:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    expected = 2 * (h + w) - 4
+    if len(coords) != expected:
+        return None
+
+    coord_set = set(coords)
+    for r, c in coord_set:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return None
+    for cell in _rect_border_cells(r0, c0, r1, c1):
+        if cell not in coord_set:
+            return None
+    return r0, c0, r1, c1
+
