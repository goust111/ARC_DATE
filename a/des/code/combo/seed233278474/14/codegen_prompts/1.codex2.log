+        )
+        if pos is None:
+            return None
+        top, left = pos
+        patch = grid[top : top + mask.shape[0], left : left + mask.shape[1]]
+        patch[mask] = PIECE_COLOR
+
+    if np.array_equal(grid, expected) or not np.any(grid == PIECE_COLOR):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
