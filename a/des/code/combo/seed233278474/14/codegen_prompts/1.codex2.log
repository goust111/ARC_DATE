+            hr0, hc0, hr1, hc1 = _bbox(hole_coords)
+            hole_mask = np.zeros((hr1 - hr0 + 1, hc1 - hc0 + 1), dtype=bool)
+            hole_mask[hole_coords[:, 0] - hr0, hole_coords[:, 1] - hc0] = True
+            holes.append(
