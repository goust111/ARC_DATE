+def _rotation_variants(mask: np.ndarray) -> list[np.ndarray]:
+    base = _trim(np.asarray(mask, dtype=bool))
+    seen = set()
+    variants = []
+    for k in range(4):
+        rot = _trim(np.rot90(base, k))
+        key = (rot.shape, np.ascontiguousarray(rot.astype(np.uint8)).tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        variants.append(rot)
+    return variants
