+def _trim(mask: np.ndarray) -> np.ndarray:
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    r_idx = np.flatnonzero(rows)
+    c_idx = np.flatnonzero(cols)
+    return mask[r_idx[0] : r_idx[-1] + 1, c_idx[0] : c_idx[-1] + 1]
