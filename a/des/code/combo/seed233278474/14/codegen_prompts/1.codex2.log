+            occupied, int(patch.shape[0]), int(patch.shape[1]), pad=2, tries=GLOBAL_FRAME_PLACE_TRIES
+        )
+        if pos is None:
+            return None
+        top, left = pos
+        grid[top : top + patch.shape[0], left : left + patch.shape[1]] = patch
+        expected[top : top + patch.shape[0], left : left + patch.shape[1]] = patch
