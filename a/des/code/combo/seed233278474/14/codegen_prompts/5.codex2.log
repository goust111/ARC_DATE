+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    arr = np.array(list(coords), dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _extract_objects(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    mask = (grid != BG) & (grid != MAROON)
+    comps = _components_mask(mask)
+    comp_index = np.full(grid.shape, -1, dtype=int)
+    objects: list[dict] = []
+    for idx, pts in enumerate(comps):
+        for r, c in pts:
+            comp_index[r, c] = idx
+        r0, c0, r1, c1 = _bbox(pts)
+        color = int(grid[pts[0][0], pts[0][1]])
+        objects.append(
+            {
+                "id": idx,
+                "coords": pts,
+                "bbox": (r0, c0, r1, c1),
+                "area": len(pts),
