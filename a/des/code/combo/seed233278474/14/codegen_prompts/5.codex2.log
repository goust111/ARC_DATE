+    # All non-marker objects must be solid rectangles.
+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        color = int(obj["color"])
+        if int(obj["area"]) != (r1 - r0 + 1) * (c1 - c0 + 1):
+            return False
+        if not bool(np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color)):
+            return False
