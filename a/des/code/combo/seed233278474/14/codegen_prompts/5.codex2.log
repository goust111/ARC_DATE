+
+def _scan_object(
+    grid: np.ndarray,
+    comp_index: np.ndarray,
+    start: tuple[int, int],
+    dr: int,
+    dc: int,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    r, c = start
+    gap = 0
+    r += dr
+    c += dc
+    while 0 <= r < h and 0 <= c < w:
+        value = int(grid[r, c])
+        if value == BG:
+            gap += 1
+            r += dr
+            c += dc
