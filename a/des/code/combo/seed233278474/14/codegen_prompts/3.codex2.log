+    best_dir = None
+    best_dist = -1
+    tie = False
+    open_dists: list[int | None] = []
+
+    for direction in range(4):
+        dist = _open_distance(grid, r, c, bg, direction)
+        open_dists.append(dist)
+        if dist is None:
+            continue
+        if dist > best_dist:
+            best_dist = dist
+            best_dir = direction
+            tie = False
+        elif dist == best_dist:
+            tie = True
+
+    if best_dir is None:
+        return None
+
+    blocked = any(
+        open_dists[direction] is None and _distance_to_edge(r, c, h, w, direction) > best_dist
+        for direction in range(4)
+    )
+    return {
