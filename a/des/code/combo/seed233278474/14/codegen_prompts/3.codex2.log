+    h, w = grid.shape
+    dr, dc = DIRS_URDL[direction]
+    steps = _distance_to_edge(r, c, h, w, direction)
+    rr, cc = r + dr, c + dc
+    for _ in range(steps):
+        if int(grid[rr, cc]) != bg:
+            return None
+        rr += dr
+        cc += dc
+    return steps
