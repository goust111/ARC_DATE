+
+    if need_tie:
+        tie_pool = [cand for cand in pool if bool(cand["tie"])]
+        if tie_pool:
+            pool = tie_pool
+    if need_trunc:
+        trunc_pool = [cand for cand in pool if bool(cand["truncated"])]
+        if trunc_pool:
