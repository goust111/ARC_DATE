+    candidates = []
+
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != bg:
+                continue
+            if (r, c) in occupied_output or (r, c) in reserved_corridors:
+                continue
+            if _has_adjacent_seed(grid, r, c, bg):
+                continue
+
+            info = _direction_info(grid, r, c, bg)
+            if info is None:
+                continue
+
