+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GEN_RETRIES = 500
+
