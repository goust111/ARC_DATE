+    candidates = [c for c in range(1, w - 1) if np.all(grid[:, c] == GREY)]
+    assert candidates, "expected at least one full grey separator column"
+    assert len(candidates) == 1, "separator column must be unique"
+    return int(candidates[0])
+
+
