+) -> None:
+    if orientation == "tl":
+        canvas[r0 : r0 + h, c0 : c0 + thickness] = color
+        canvas[r0 : r0 + thickness, c0 : c0 + w] = color
+    elif orientation == "tr":
+        canvas[r0 : r0 + h, c0 + w - thickness : c0 + w] = color
+        canvas[r0 : r0 + thickness, c0 : c0 + w] = color
+    elif orientation == "bl":
+        canvas[r0 : r0 + h, c0 : c0 + thickness] = color
+        canvas[r0 + h - thickness : r0 + h, c0 : c0 + w] = color
+    else:
