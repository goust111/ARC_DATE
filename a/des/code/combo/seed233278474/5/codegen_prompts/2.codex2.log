+    for nxt, segment in _next_candidates(current, shape, occupied_boxes, occupied_paths):
+        new_boxes = occupied_boxes | set(nxt["box_cells"])
+        new_paths = occupied_paths | set(segment)
+        result = _extend_chain(
+            arrows + [nxt],
+            segments + [segment],
