+def _render_grid(chains: list[list[dict[str, object]]]) -> np.ndarray:
+    h = max(max(r for r, _ in arrow["box_cells"]) for chain in chains for arrow in chain) + 1
+    w = max(max(c for _, c in arrow["box_cells"]) for chain in chains for arrow in chain) + 1
