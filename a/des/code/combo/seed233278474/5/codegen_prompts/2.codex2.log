+    traces: list[dict[str, object]] = []
+    for idx, arrow in enumerate(arrows):
+        dr, dc = DIR_VECS[arrow["direction"]]
+        r, c = arrow["tip"]
+        r += dr
+        c += dc
+        cells: list[tuple[int, int]] = []
+        hit = None
+        while _in_bounds(shape, r, c):
