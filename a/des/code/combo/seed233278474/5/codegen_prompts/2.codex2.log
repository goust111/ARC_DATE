+import numpy as np
+
+
+DIR_VECS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+
+ARROW_MASKS = {
+    "U": frozenset({(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)}),
+    "D": frozenset({(0, 1), (1, 1), (2, 0), (2, 1), (2, 2)}),
+    "L": frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)}),
+    "R": frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)}),
+}
+
+TIP_OFFSETS = {
+    "U": (0, 1),
+    "D": (2, 1),
+    "L": (1, 0),
+    "R": (1, 2),
+}
+
+NEXT_DIR_OPTIONS = {
+    "U": ("L", "U", "R"),
+    "D": ("L", "D", "R"),
+    "L": ("U", "L", "D"),
+    "R": ("U", "R", "D"),
+}
