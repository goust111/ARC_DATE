+            indegree[int(trace["hit"])] += 1
+    roots = [idx for idx, deg in enumerate(indegree) if deg == 0]
+    lengths = []
+    for root in roots:
+        length = 0
+        cur = root
+        seen = set()
+        while cur is not None and cur not in seen:
+            seen.add(cur)
+            length += 1
+            cur = traces[cur]["hit"]
+        lengths.append(length)
