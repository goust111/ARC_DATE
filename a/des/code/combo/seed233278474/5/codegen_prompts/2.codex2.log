+def _path_to_boundary(
+    arrow: dict[str, object],
+    shape: tuple[int, int],
+    occupied_boxes: set[tuple[int, int]],
+    occupied_paths: set[tuple[int, int]],
+) -> tuple[tuple[int, int], ...] | None:
+    dr, dc = DIR_VECS[arrow["direction"]]
