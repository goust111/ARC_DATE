+def _build_chain(
+    chain_len: int,
+    shape: tuple[int, int],
+    occupied_boxes: set[tuple[int, int]],
+    occupied_paths: set[tuple[int, int]],
+) -> tuple[list[dict[str, object]], list[tuple[tuple[int, int], ...]]] | None:
