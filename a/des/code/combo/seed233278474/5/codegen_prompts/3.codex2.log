+        if r0 < 0 or r1 >= grid_h:
+            return None
+        return {"r0": int(r0), "c0": int(c0), "r1": int(r1), "c1": int(c1)}
+
+    r0 = fixed_start
+    r1 = r0 + rect_h - 1
+    if r0 < 0 or r1 >= grid_h:
+        return None
+    conflicts = [p for p in placed if _intervals_overlap(r0, r1, p["r0"], p["r1"])]
+    if edge == "left":
