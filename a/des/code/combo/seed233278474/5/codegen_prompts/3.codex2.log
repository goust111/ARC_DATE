+        for other in sorted(conflicts, key=lambda p: (p["c0"], p["r0"], p["c1"], p["r1"])):
+            if _intervals_overlap(c0, c0 + rect_w - 1, other["c0"], other["c1"]):
+                c0 = other["c1"] + 1
+    else:
+        c0 = grid_w - rect_w
+        for other in sorted(conflicts, key=lambda p: (-p["c1"], p["r0"], p["c0"], p["r1"])):
