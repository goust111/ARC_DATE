+
+def _transform_rectangles(rects: list[dict[str, int]], grid_h: int, grid_w: int) -> list[dict[str, int]]:
+    movers: list[dict[str, int]] = []
+    for rect in rects:
+        if rect["h"] % 2 != rect["w"] % 2:
