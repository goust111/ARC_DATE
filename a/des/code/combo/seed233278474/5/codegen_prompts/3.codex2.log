+    grid_w: int,
+) -> tuple[list[dict[str, int]], np.ndarray] | None:
+    occupied = np.zeros((grid_h, grid_w), dtype=bool)
+    input_records: list[dict[str, int]] = []
+    prev_dist2 = -1
