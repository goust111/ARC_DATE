+    if edge in ("top", "bottom"):
+        ov0, ov1 = overlap_range
+        lo = max(lo, ov0 - rect_w + 1)
+        hi = min(hi, ov1)
+    else:
+        ov0, ov1 = overlap_range
+        lo = max(lo, ov0 - rect_h + 1)
