+def _shift_from_output(record: dict[str, int], offset: int) -> tuple[int, int, int, int]:
+    edge = record["edge"]
+    if edge == "top":
+        return (
+            record["r0"] + offset,
+            record["c0"],
+            record["r1"] + offset,
+            record["c1"],
+        )
+    if edge == "bottom":
+        return (
+            record["r0"] - offset,
+            record["c0"],
+            record["r1"] - offset,
+            record["c1"],
+        )
+    if edge == "left":
+        return (
+            record["r0"],
+            record["c0"] + offset,
+            record["r1"],
+            record["c1"] + offset,
+        )
+    return (
+        record["r0"],
+        record["c0"] - offset,
+        record["r1"],
+        record["c1"] - offset,
+    )
+
+
+def _max_inward_offset(record: dict[str, int], grid_h: int, grid_w: int) -> int:
+    edge = record["edge"]
+    if edge == "top":
+        return grid_h - 2 - record["r1"]
+    if edge == "bottom":
+        return record["r0"] - 1
+    if edge == "left":
+        return grid_w - 2 - record["c1"]
