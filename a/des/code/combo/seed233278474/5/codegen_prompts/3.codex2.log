+    movers.sort(
+        key=lambda rect: (
+            rect["dist2"],
+            EDGE_ORDER[rect["edge"]],
+            rect["r0"],
+            rect["c0"],
+            rect["color"],
+        )
+    )
+
+    placed: list[dict[str, int]] = []
+    for rect in movers:
