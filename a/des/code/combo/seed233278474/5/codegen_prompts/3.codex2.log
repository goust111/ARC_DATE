+        settled = _settle_rect(rect["edge"], rect["h"], rect["w"], fixed_start, placed, grid_h, grid_w)
+        if settled is None:
+            continue
+        settled["color"] = rect["color"]
+        settled["h"] = rect["h"]
+        settled["w"] = rect["w"]
+        settled["edge"] = rect["edge"]
