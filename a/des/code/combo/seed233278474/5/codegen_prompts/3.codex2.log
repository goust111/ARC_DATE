+
+def _build_output_records(
+    rng: np.random.Generator,
+    grid_h: int,
+    grid_w: int,
+    keep_count: int,
+) -> list[dict[str, int]] | None:
+    placed: list[dict[str, int]] = []
+    records: list[dict[str, int]] = []
+
+    cluster_count = 0
+    if keep_count >= 2 and rng.random() < CLUSTER_PROB:
