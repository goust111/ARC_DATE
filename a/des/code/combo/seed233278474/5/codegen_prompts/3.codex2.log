+def _assign_colors(
+    rng: np.random.Generator,
+    kept_input: list[dict[str, int]],
+    kept_output: list[dict[str, int]],
+    removed: list[dict[str, int]],
+) -> None:
+    total = len(kept_input) + len(removed)
