+            if not _expanded_clear(bbox, occupied):
+                continue
+            edge, dist2, unique = _nearest_edge(bbox[0], bbox[1], bbox[2], bbox[3], grid_h, grid_w)
+            if edge != record["edge"] or not unique or dist2 <= prev_dist2:
