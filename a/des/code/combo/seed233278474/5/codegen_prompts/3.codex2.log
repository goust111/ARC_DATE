+
+def _paint_rectangles(shape: tuple[int, int], rects: list[dict[str, int]]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for rect in rects:
+        out[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = rect["color"]
+    return out
