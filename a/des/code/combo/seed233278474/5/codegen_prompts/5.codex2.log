+    input_grid = np.zeros((h, w), dtype=int)
+    output_grid = np.zeros((h, w), dtype=int)
+
+    for spec in specs:
+        color = int(spec["color"])
+        top = int(spec["top"])
+        left = int(spec["left"])
+        qh = int(spec["qh"])
+        qw = int(spec["qw"])
+        quadrant = str(spec["quadrant"])
+        diagonal = str(spec["diagonal"])
+        source_mask = np.asarray(spec["source_mask"], dtype=bool)
+
+        bottom = top + qh * 2 + 1
+        right = left + qw * 2 + 1
+        if diagonal == "tlbr":
