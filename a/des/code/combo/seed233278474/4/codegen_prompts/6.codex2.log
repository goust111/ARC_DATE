+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
