+                c0 = random.randint(0, w - pw)
+                rr0 = max(0, r0 - 1)
+                cc0 = max(0, c0 - 1)
+                rr1 = min(h, r0 + ph + 1)
+                cc1 = min(w, c0 + pw + 1)
+                if np.any(occupied[rr0:rr1, cc0:cc1]):
