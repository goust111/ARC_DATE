+
+def _hole_mask(local_mask: np.ndarray) -> np.ndarray:
+    h, w = local_mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = np.zeros((h, w), dtype=bool)
+
+    for r in range(h):
+        for c in range(w):
+            if local_mask[r, c] or seen[r, c]:
+                continue
