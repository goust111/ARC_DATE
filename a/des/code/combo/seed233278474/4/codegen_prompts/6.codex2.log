+        depth = random.randint(1, c0)
+        span = random.randint(2, h)
+        start = r0 + random.randint(0, h - span)
+        mask[start : start + span, c0 - depth : c0] = True
+    else:
+        depth = random.randint(1, mask.shape[1] - (c0 + w))
+        span = random.randint(2, h)
+        start = r0 + random.randint(0, h - span)
