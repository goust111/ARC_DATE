+def _can_place(
+    coords: list[tuple[int, int]],
+    top: int,
+    left: int,
+    blocked: np.ndarray,
+    pad: int,
+) -> bool:
+    h, w = blocked.shape
+    sh, sw = _shape_dims(coords)
+    if top < 0 or left < 0 or top + sh > h or left + sw > w:
+        return False
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + sh + pad)
+    c1 = min(w, left + sw + pad)
+    return not bool(blocked[r0:r1, c0:c1].any())
+
+
+def _place(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    coords: list[tuple[int, int]],
+    top: int,
+    left: int,
+    color: int,
+    pad: int,
+) -> None:
+    sh, sw = _shape_dims(coords)
+    for r, c in coords:
+        grid[top + r, left + c] = color
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(grid.shape[0], top + sh + pad)
+    c1 = min(grid.shape[1], left + sw + pad)
+    blocked[r0:r1, c0:c1] = True
+
+
+def _try_place_shape(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    coords: list[tuple[int, int]],
+    color: int,
+    pad: int,
+    rng: np.random.Generator,
+    tries: int = 80,
+) -> bool:
