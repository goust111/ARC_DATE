+    seen = {coords[0]}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nxt = (r + dr, c + dc)
+            if nxt in pts and nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
+    return len(seen) == len(pts)
+
+
+def _shape_hole_areas(coords: list[tuple[int, int]]) -> list[int]:
+    sh, sw = _shape_dims(coords)
+    grid = np.zeros((sh + 2, sw + 2), dtype=int)
+    for r, c in coords:
+        grid[r + 1, c + 1] = 1
