+
+def _l_shape(rng: np.random.Generator) -> list[tuple[int, int]]:
+    arm_h = int(rng.integers(2, 6))
+    arm_w = int(rng.integers(2, 6))
+    coords = {(r, 0) for r in range(arm_h)} | {(0, c) for c in range(arm_w)}
