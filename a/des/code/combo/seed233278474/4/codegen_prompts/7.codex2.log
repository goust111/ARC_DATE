+    outer_h = inner_h + top + bottom
+    outer_w = inner_w + left + right
+    coords = {
+        (r, c)
+        for r in range(outer_h)
+        for c in range(outer_w)
+        if not (top <= r < top + inner_h and left <= c < left + inner_w)
+    }
+
+    if rng.random() < 0.45:
