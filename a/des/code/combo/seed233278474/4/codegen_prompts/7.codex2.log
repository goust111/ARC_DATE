+    c0 = max(0, left - pad)
+    r1 = min(h, top + sh + pad)
+    c1 = min(w, left + sw + pad)
+    return not bool(blocked[r0:r1, c0:c1].any())
+
+
+def _place(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    coords: list[tuple[int, int]],
+    top: int,
+    left: int,
