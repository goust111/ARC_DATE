+
+def _rect_area(rect: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _split_options(rect: tuple[int, int, int, int], min_side: int) -> list[str]:
+    r0, c0, r1, c1 = rect
+    options = []
+    if r1 - r0 + 1 >= 2 * min_side + 1:
+        options.append("h")
+    if c1 - c0 + 1 >= 2 * min_side + 1:
+        options.append("v")
