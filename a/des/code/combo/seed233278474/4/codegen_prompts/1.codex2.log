+    seed_by_rect: dict[tuple[int, int, int, int], tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full((h, w), BLACK, dtype=int)
+    grid[0, :] = GREY
+    grid[h - 1, :] = GREY
+    grid[:, 0] = GREY
+    grid[:, w - 1] = GREY
+    for orientation, cut, a0, a1 in lines:
+        if orientation == "h":
+            grid[cut, a0 : a1 + 1] = GREY
+        else:
+            grid[a0 : a1 + 1, cut] = GREY
