+
+def _partition_rectangles(
+    h: int, w: int, n_regions: int, min_side: int, rng: random.Random
+) -> tuple[list[tuple[int, int, int, int]], list[tuple[str, int, int, int]]] | None:
+    rects = [(1, 1, h - 2, w - 2)]
