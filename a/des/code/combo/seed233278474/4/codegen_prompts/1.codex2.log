+
+def _render_grid(
+    h: int,
+    w: int,
+    rects: list[tuple[int, int, int, int]],
+    lines: list[tuple[str, int, int, int]],
+    color_by_rect: dict[tuple[int, int, int, int], int],
+    seed_by_rect: dict[tuple[int, int, int, int], tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full((h, w), BLACK, dtype=int)
+    grid[0, :] = GREY
+    grid[h - 1, :] = GREY
+    grid[:, 0] = GREY
