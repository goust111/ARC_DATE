+RING_NEXT = {RING[i]: RING[(i + 1) % len(RING)] for i in range(len(RING))}
+RING_PREV = {RING[(i + 1) % len(RING)]: RING[i] for i in range(len(RING))}
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
