+
+
+def _forward_room(rect: tuple[int, int, int, int], seed: tuple[int, int], direction: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = rect
+    r, c = seed
+    dr, dc = direction
+    if dr == 1:
+        return r1 - r
+    if dr == -1:
