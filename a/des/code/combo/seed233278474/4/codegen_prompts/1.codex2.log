+        return rng.choice(all_cells)
+
+    branches: list[list[tuple[int, int]]] = []
+    if full:
+        branches.extend([full, full])
+    if tight:
+        branches.extend([tight, tight])
+    branches.append(all_cells)
+    branch = rng.choice(branches)
