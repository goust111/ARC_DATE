+RED = 2
+GREEN = 3
+GREY = 5
+PATH_COLORS = (1, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+DIR_INDEX = {d: i for i, d in enumerate(DIRS4)}
+START_SIDES = ("left", "right", "top", "bottom")
+MAX_GENERATION_ATTEMPTS = 400
