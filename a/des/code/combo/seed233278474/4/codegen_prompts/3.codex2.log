+def _turn_sequence(ordered: list[tuple[int, int]]) -> list[str]:
+    steps = []
+    for (r0, c0), (r1, c1) in zip(ordered, ordered[1:]):
+        step = (int(r1 - r0), int(c1 - c0))
+        assert step in DIR_INDEX, "path must move orthogonally"
+        steps.append(step)
