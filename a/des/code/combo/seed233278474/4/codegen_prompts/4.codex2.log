+        direction = directions[idx]
+        frame = _render_frame(size, frame_colors[idx], direction)
+        template = _render_template(patches[idx])
+
+        frame_pos = _place_box(occupied, frame.shape[0], frame.shape[1], pad=1)
+        if frame_pos is None:
