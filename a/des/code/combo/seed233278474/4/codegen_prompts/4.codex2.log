+
+
+def _render_frame(size: int, color: int, direction: str) -> np.ndarray:
+    arr = np.full((size + 2, size + 2), BG, dtype=int)
+    arr[0, :] = color
+    arr[-1, :] = color
+    arr[:, 0] = color
+    arr[:, -1] = color
