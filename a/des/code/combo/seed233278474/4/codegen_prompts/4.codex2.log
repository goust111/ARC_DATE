+
+
+def _detect_templates(grid: np.ndarray, bg: int) -> list[dict]:
+    non_bg = grid != bg
+    templates: list[dict] = []
+    used_grey: set[tuple[int, int]] = set()
+    for gr, gc in map(tuple, np.argwhere(grid == GREY)):
+        gr = int(gr)
