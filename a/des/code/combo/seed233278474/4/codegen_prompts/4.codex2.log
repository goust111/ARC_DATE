+
+        fr, fc = frame_pos
+        tr, tc = template_pos
+        grid[fr : fr + frame.shape[0], fc : fc + frame.shape[1]] = frame
+        grid[tr : tr + template.shape[0], tc : tc + template.shape[1]] = template
