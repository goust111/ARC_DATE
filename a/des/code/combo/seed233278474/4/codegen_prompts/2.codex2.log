+                "color": int(color),
+                "area": int(area),
+                "cells": rel_cells,
+                "h": int(ph),
+                "w": int(pw),
+                "src_top": int(src_r),
+                "src_left": int(src_c),
+                "target_top": int(target_r),
+                "target_left": int(target_c),
+                "abs_cells": abs_cells,
+            }
