+import numpy as np
+
+
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+PIECE_COUNT_RANGE = (3, 5)
+AREA_POOL = (2, 3, 4, 5, 6)
+MAX_GENERATION_ATTEMPTS = 400
+TARGET_LAYOUT_ATTEMPTS = 160
+SOURCE_LAYOUT_ATTEMPTS = 160
