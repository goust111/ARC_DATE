+            patch = np.where(cell_masks[i][j], cell_colors[i][j], BLACK)
+            r0 = row_lines[i] + 1
+            c0 = col_lines[j] + 1
+            grid[r0 : r0 + cell_size, c0 : c0 + cell_size] = patch
