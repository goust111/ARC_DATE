+
+
+def _expected_output(
+    grid: np.ndarray,
+    cell_colors: list[list[int]],
+    side_maps: list[list[dict[str, set[int]]]],
+    row_lines: list[int],
+    col_lines: list[int],
+) -> np.ndarray:
+    out = grid.copy()
+    cell_rows = len(cell_colors)
+    cell_cols = len(cell_colors[0])
+
+    for i in range(cell_rows):
