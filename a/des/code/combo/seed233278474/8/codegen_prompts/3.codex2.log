+    for depth in range(1, MAX_OUTLINE_LAYERS + 1):
+        claims_by_cell: dict[tuple[int, int], list[int]] = {}
+        new_layers = [set() for _ in objects]
+        for idx, layers in enumerate(all_layers):
+            if len(layers) > depth:
+                continue
+            frontier = layers[depth - 1]
