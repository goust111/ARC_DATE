+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                comp.add((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
