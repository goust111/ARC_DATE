+            return False
+    return True
+
+
+def _sample_case() -> tuple[np.ndarray, np.ndarray] | None:
+    ring_len = random.randint(4, 6)
+    ring = random.sample(PALETTE, ring_len)
+    want_overlap = random.random() < 0.4
+
