+    want_boundary = random.random() < FORCE_BOUNDARY_PROB
+    want_shared_axis = n_pairs >= 3 and random.random() < FORCE_SHARED_AXIS_PROB
+    want_both_orientations = n_pairs >= 2 and random.random() < FORCE_BOTH_ORIENTATIONS_PROB
