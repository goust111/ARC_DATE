+GRID_H_RANGE = (10, 18)
+GRID_W_RANGE = (10, 18)
+PAIR_COUNT_CHOICES = (2, 3, 4)
+PAIR_COUNT_WEIGHTS = (2, 3, 2)
+MAX_D_CAP = 4
+GEN_RETRIES = 400
+
+FORCE_COLLISION_PROB = 0.6
+FORCE_BOUNDARY_PROB = 0.6
+FORCE_SHARED_AXIS_PROB = 0.4
+FORCE_BOTH_ORIENTATIONS_PROB = 0.7
