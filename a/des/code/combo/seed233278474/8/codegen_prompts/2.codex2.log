+                        "color": int(color),
+                        "orientation": "v",
+                        "fixed": int(fixed),
+                        "a0": int(a0),
+                        "a1": int(a1),
+                        "d": int(d),
+                    }
+                    temp = base.copy()
+                    temp[a0, fixed] = color
+                    temp[a1, fixed] = color
+                    _out, details, valid = _apply_pairs_to_grid(temp, placed_pairs + [pair], validate_core=True)
+                    if not valid:
