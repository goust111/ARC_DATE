+    mask = _component_mask(comp)
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(mask & ~border):
+        return None
+    missing = np.argwhere(border & ~mask)
+    if missing.shape[0] != 1:
+        return None
+    if int(mask.sum()) != int(border.sum()) - 1:
