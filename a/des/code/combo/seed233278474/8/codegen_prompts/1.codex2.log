+    assert arrows
+
+    arrows_by_dir: dict[str, list[dict]] = defaultdict(list)
+    for arrow in arrows:
+        arrows_by_dir[str(arrow["direction"])].append(arrow)
+
+    out = g.copy()
+    for direction in DIRECTIONS:
+        dir_frames = [frame for frame in frames if frame["direction"] == direction]
+        if not dir_frames:
