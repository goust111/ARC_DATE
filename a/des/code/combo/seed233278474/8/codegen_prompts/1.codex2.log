+    }
+
+
+def _classify_arrow(comp: dict) -> dict | None:
+    mask = _component_mask(comp)
+    h, w = mask.shape
+    area = int(mask.sum())
+
+    if w == 3 and h >= 4 and bool(mask[:, 1].all()):
