+
+    for i in range(1, m + 1):
+        for j in range(1, n + 1):
+            best = dp[i][j - 1]
+            use_arrow = False
+            cand = dp[i - 1][j - 1]
+            if cand < inf:
+                cand += abs(int(frames_sorted[i - 1]["cavity_area"]) - int(arrows_sorted[j - 1]["area"]))
+                if cand < best:
