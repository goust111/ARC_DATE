+    mask = np.zeros((h, w), dtype=bool)
+    coords = comp["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _classify_frame(comp: dict) -> dict | None:
