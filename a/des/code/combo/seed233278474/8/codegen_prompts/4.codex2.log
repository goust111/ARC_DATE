    return m


def _rect_mask(n: int, half_h: int, half_w: int) -> np.ndarray:
    m = np.zeros((n, n), dtype=bool)
    c = n // 2
    m[c - half_h : c + half_h + 1, c - half_w : c + half_w + 1] = True
    return m


def _barbell_mask(n: int, arm: int, slope: int) -> np.ndarray:
