+def _sample_layout(cols: int) -> list[list[int]] | None:
+    labels = [4] * cols + [2] * cols + [1] * cols
+    target = [[4] * cols, [2] * cols, [1] * cols]
+    for _ in range(300):
+        perm = list(_RNG.permutation(labels))
+        rows = [perm[i * cols : (i + 1) * cols] for i in range(3)]
