+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+ORDERS = (4, 2, 1)
+ORDER_TO_ROW = {4: 0, 2: 1, 1: 2}
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+VALID_LAYOUTS = [(5, 3), (5, 4), (5, 5), (7, 3), (9, 3)]
+MAX_GENERATION_ATTEMPTS = 400
+_RNG = np.random.default_rng()
