+    return edges
+
+
+def _node_degrees(edges: list[tuple[Cell, Cell]]) -> dict[Cell, int]:
+    deg: dict[Cell, int] = {}
+    for a, b in edges:
+        deg[a] = deg.get(a, 0) + 1
+        deg[b] = deg.get(b, 0) + 1
