    if len(nbrs) != 2:
        return None
    (r1, c1), (r2, c2) = nbrs
    if r1 == r == r2:
        return "h"
    if c1 == c == c2:
        return "v"
    return None


def _analyze_grid(
    grid: np.ndarray,
) -> tuple[np.ndarray, dict[int, list[Cell]], set[Cell], set[Cell]]:
    mask = _pipe_mask(grid)
    h, w = grid.shape
    sources: dict[int, list[Cell]] = {}
    open_valves: set[Cell] = set()
    closed_valves: set[Cell] = set()

