+def _neighbors4(shape: tuple[int, int], r: int, c: int) -> list[Cell]:
+    h, w = shape
+    out: list[Cell] = []
+    for dr, dc in DIRS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
