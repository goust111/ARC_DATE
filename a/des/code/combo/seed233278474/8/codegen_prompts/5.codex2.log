+def _random_spanning_tree(nodes: set[Cell], lh: int, lw: int) -> list[tuple[Cell, Cell]] | None:
+    root = random.choice(tuple(nodes))
+    tree_nodes = {root}
+    remaining = set(nodes)
+    remaining.remove(root)
+    edges: list[tuple[Cell, Cell]] = []
+
+    while remaining:
+        frontier = [
+            (u, v)
+            for u in tree_nodes
+            for v in _lattice_neighbors(u, lh, lw)
+            if v in remaining
