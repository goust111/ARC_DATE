+    deg = _node_degrees(edges)
+    leaf_nodes = [node for node, d in deg.items() if d == 1]
+    if not (2 <= len(leaf_nodes) <= len(SOURCE_COLORS)):
+        return None
+
+    spacing = random.choice(SPACING_CHOICES)
+    pads = (
+        random.choice(PAD_CHOICES),
+        random.choice(PAD_CHOICES),
