+SOURCE_COLORS = (1, 2, 3, 6, 7, 8)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SPECIAL_NON_SOURCE = {BLACK, YELLOW, GREY, MAROON}
