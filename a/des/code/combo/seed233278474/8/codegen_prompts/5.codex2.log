+
+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 500
+LATTICE_H_RANGE = (3, 5)
+LATTICE_W_RANGE = (3, 5)
+SPACING_CHOICES = (3, 4)
+PAD_CHOICES = (1, 2)
+PATH_NODE_RANGE = (4, 7)
+TREE_NODE_RANGE = (5, 8)
+MAX_VALVES = 4
