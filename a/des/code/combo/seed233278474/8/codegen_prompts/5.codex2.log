+def _straight_axis(mask: np.ndarray, r: int, c: int) -> str | None:
+    nbrs = _pipe_neighbors(mask, r, c)
+    if len(nbrs) != 2:
+        return None
+    (r1, c1), (r2, c2) = nbrs
+    if r1 == r == r2:
+        return "h"
+    if c1 == c == c2:
+        return "v"
+    return None
+
