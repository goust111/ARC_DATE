from __future__ import annotations

from collections import deque
import random

import numpy as np


BLACK = 0
YELLOW = 4
GREY = 5
MAROON = 9

SOURCE_COLORS = (1, 2, 3, 6, 7, 8)
DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
SPECIAL_NON_SOURCE = {BLACK, YELLOW, GREY, MAROON}

# --------------- solver ---------------


Cell = tuple[int, int]
