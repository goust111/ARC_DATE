+def _bfs_distances(traversable: np.ndarray, starts: list[Cell]) -> np.ndarray:
+    dist = np.full(traversable.shape, -1, dtype=int)
+    q: deque[Cell] = deque()
+
+    for r, c in starts:
+        if bool(traversable[r, c]) and int(dist[r, c]) == -1:
+            dist[r, c] = 0
+            q.append((r, c))
