+    return True
+
+
+def _build_topology() -> tuple[np.ndarray, list[Cell]] | None:
+    lh = random.randint(*LATTICE_H_RANGE)
+    lw = random.randint(*LATTICE_W_RANGE)
+    mode = random.choice(("path", "tree"))
+
+    if mode == "path":
