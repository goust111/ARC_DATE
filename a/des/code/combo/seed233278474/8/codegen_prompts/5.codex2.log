+            assert axis is not None, "valve must sit on a straight degree-2 pipe cell"
+            if axis == "h":
+                closed = (
+                    (r > 0 and int(grid[r - 1, c]) == YELLOW)
+                    or (r + 1 < h and int(grid[r + 1, c]) == YELLOW)
