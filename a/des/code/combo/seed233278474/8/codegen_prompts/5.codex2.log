+    sources: dict[int, list[Cell]] = {}
+    open_valves: set[Cell] = set()
+    closed_valves: set[Cell] = set()
+
+    for r0, c0 in np.argwhere(mask):
+        r = int(r0)
+        c = int(c0)
+        color = int(grid[r, c])
+        if color == MAROON:
