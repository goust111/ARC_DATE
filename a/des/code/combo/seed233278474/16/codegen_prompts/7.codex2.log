  76:     bg = get_bg(g)
  77:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
  78:     assert len(objects) == 4, "expected four colored objects around the center"
  79: 
  80:     center_r, center_c = _central_background_cell(g, bg, objects)
