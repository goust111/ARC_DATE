@@ 8: def main(grid: np.ndarray) -> np.ndarray:
   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Stamp translated copies of a monochrome template guided by a singleton pixel layout.
  11: 
  12:     Input structure:
  13:     - bg = background. A large monochrome shape (template, color T).
  14:     - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).
  15:     - Singletons sit on a uniform-spacing lattice.
  16: 
  17:     Rule:
  18:     - Convert each singleton's offset from the origin into coarse lattice units.
  19:     - Place a template copy at each offset, scaled by template height/width.
  20:     - The origin's copy is painted O instead of T.
  21:     - Any pixel covered by two or more copies is also recolored to O.
  22: 
  23:     Key insight: The single T-colored singleton identifies both the origin position and the "self" copy, which is uniquely recolored.
  24:     """
  25:     g = np.array(grid, dtype=int)
  26:     bg = int(get_bg(g))
  27:     H, W = g.shape
  28: 
  29:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
  30:     assert not (not comps)
  31: 
  32:     template = max(comps, key=lambda d: int(d["area"]))
  33:     templ_coords = template["coords"]
  34:     templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])
  35:     r0, c0, r1, c1 = map(int, template["bbox"])
  36:     h = int(bbox_h((r0, c0, r1, c1)))
  37:     w = int(bbox_w((r0, c0, r1, c1)))
  38: 
  39:     templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]
  40: 
  41:     # Singleton layout points (excluding the template component).
  42:     singletons: list[tuple[int, int, int]] = []
  43:     for comp in comps:
  44:         if comp is template:
  45:             continue
  46:         if int(comp["area"]) != 1:
  47:             continue
  48:         rr, cc = map(int, comp["coords"][0])
  49:         singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))
  50: 
  51:     origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]
  52:     assert not (len(origin) != 1)
  53:     orr, orc = origin[0]
  54: 
  55:     other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]
  56:     assert not (not other_cols)
  57:     overlap_col = int(Counter(other_cols).most_common(1)[0][0])
  58: 
  59:     deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]
  60:     gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]
  61:     assert gcd_vals
  62:     gunit = int(math.gcd(*gcd_vals))
  63:     gunit = max(1, int(gunit))
  64:     deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]
  65: 
  66:     total = np.zeros((H, W), dtype=int)
  67:     center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton
  68: 
  69:     for dr, dc, col in deltas:
  70:         off_r = int(dr * h)
  71:         off_c = int(dc * w)
  72:         is_origin = int(col) == int(templ_col)
  73:         for rr, cc in templ_rel:
  74:             R = int(r0 + off_r + rr)
  75:             C = int(c0 + off_c + cc)
  76:             if 0 <= R < H and 0 <= C < W:
  77:                 total[R, C] += 1
  78:                 if is_origin:
  79:                     center[R, C] += 1
  80: 
  81:     out = np.full((H, W), int(bg), dtype=int)
  82:     out[total > 0] = int(templ_col)
  83:     out[(total == 1) & (center > 0)] = int(overlap_col)
  84:     out[total >= 2] = int(overlap_col)
