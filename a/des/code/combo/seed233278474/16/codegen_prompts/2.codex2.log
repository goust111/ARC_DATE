+def _parse_legend(row: np.ndarray) -> dict[frozenset[int], int]:
+    mapping: dict[frozenset[int], int] = {}
+    w = len(row)
+    i = 0
+    while i < w:
+        if int(row[i]) == BG:
+            i += 1
+            continue
+
+        if (
+            i + 4 < w
+            and int(row[i]) not in (BG, SEP)
+            and int(row[i + 1]) == SEP
+            and int(row[i + 2]) not in (BG, SEP)
+            and int(row[i + 3]) == SEP
+            and int(row[i + 4]) not in (BG, SEP)
