+        mask_a = _tight_mask(full_a)
+        mask_b = _tight_mask(full_b)
+        if int(mask_a.sum()) < 3 or int(mask_b.sum()) < 3:
+            continue
+        if not (_is_irregular(mask_a) and _is_irregular(mask_b)):
