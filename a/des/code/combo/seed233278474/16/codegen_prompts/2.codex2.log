+            b = int(row[i + 2])
+            result = int(row[i + 4])
+            mapping[frozenset((a, b))] = result
+            i += 5
+            continue
+
+        if (
+            i + 3 < w
+            and int(row[i]) not in (BG, SEP)
+            and int(row[i + 1]) == SEP
+            and int(row[i + 2]) not in (BG, SEP)
+            and int(row[i + 3]) not in (BG, SEP)
+        ):
+            a = int(row[i])
+            b = int(row[i + 2])
+            result = int(row[i + 3])
+            mapping[frozenset((a, b))] = result
+            i += 4
+            continue
+
+        if (
+            i + 2 < w
+            and int(row[i]) not in (BG, SEP)
+            and int(row[i + 1]) not in (BG, SEP)
