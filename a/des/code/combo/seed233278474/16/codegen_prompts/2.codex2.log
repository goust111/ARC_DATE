+def _random_connected_mask(height: int, width: int, n_cells: int, rng: np.random.Generator) -> np.ndarray | None:
+    if not (1 <= n_cells <= height * width):
+        return None
+    start = (int(rng.integers(height)), int(rng.integers(width)))
+    cells = {start}
