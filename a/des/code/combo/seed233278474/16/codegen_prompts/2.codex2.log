+
+def _find_legend_row(grid: np.ndarray) -> int:
+    for r in range(grid.shape[0] - 1, -1, -1):
+        row = grid[r]
+        if np.count_nonzero(row == SEP) >= 2 and np.count_nonzero((row != BG) & (row != SEP)) >= 3:
