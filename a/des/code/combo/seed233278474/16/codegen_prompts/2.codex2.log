+            anchor_left = int(rng.integers(0, grid_w - out_w + 1))
+            if not _can_place(blocked, anchor_top, anchor_left, out_h, out_w, pad=1):
+                continue
+
+            trial = blocked.copy()
+            _mark(trial, anchor_top, anchor_left, out_h, out_w, pad=1)
+            for _ in range(250):
