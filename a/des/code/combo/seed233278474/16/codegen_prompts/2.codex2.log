+        for r, c in cells:
+            for dr, dc in NEIGHBORS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        if not frontier:
+            return None
+        cell = list(frontier)[int(rng.integers(len(frontier)))]
+        cells.add(cell)
