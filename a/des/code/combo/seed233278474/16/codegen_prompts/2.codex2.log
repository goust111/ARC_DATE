+    for _ in range(pair_count):
+        partition = _make_partition(rng)
+        if partition is None:
+            return None
+        mask_a, mask_b = partition
+        color_a = int(fragment_colors[color_idx])
+        color_b = int(fragment_colors[color_idx + 1])
