+import numpy as np
+from collections import deque
+
+
+BG = 0
+SEP = 5
+FRAGMENT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
+_RNG = np.random.default_rng()
