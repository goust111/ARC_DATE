+    c1 = int(c0 + outer_w - 1)
+    mask = _group_output_mask(height, width, r0, c0, spec)
+    if not mask.any() or _bbox_blocked(occupied_in, r0, c0, r1, c1, halo=1) or bool((mask & occupied_out).any()):
+        return False
