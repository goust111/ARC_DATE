+            continue
+        if clip_target and not clipped and random.random() < 0.7:
+            if fallback is None:
+                fallback = (int(r0), int(c0))
+            continue
+
+        _render_group_input(inp, r0, c0, spec)
+        _render_expected_output(out, r0, c0, spec)
+        occupied_in[r0 : r1 + 1, c0 : c1 + 1] = True
+        occupied_out |= mask
+        return True
+
+    if fallback is None:
+        return False
+
+    r0, c0 = fallback
