+def _point_in_polygon(point: tuple[float, float], vertices: list[tuple[int, int]]) -> bool:
+    py, px = point
+    inside = False
+    for i in range(len(vertices)):
+        y1, x1 = vertices[i]
+        y2, x2 = vertices[(i + 1) % len(vertices)]
+        if (y1 > py) == (y2 > py):
+            continue
+        xin = x1 + (py - y1) * (x2 - x1) / (y2 - y1)
+        if px < xin:
+            inside = not inside
+    return inside
