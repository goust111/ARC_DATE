+    rays = _endpoint_rays(g, segments)
+    body_cells = {cell for seg in segments for cell in seg["cell_set"]}
+    body_limits = {
+        ray["id"]: _nearest_body_block(ray["start"], ray["dir"], body_cells, h, w)
+        for ray in rays
