+                    raise AssertionError("horizontal endpoints must point vertically")
+                axis = "v"
+            else:
+                if dr != 0 or dc == 0:
+                    raise AssertionError("vertical endpoints must point horizontally")
+                axis = "h"
+            rays.append(
+                {
+                    "id": next_id,
+                    "segment_id": seg["id"],
+                    "color": seg["color"],
+                    "start": endpoint,
+                    "dir": (dr, dc),
+                    "axis": axis,
+                }
+            )
+            next_id += 1
