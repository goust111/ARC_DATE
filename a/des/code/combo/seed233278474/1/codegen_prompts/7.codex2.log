+                if val not in RESERVED:
+                    boundary[val].add((nr, nc))
+    if not boundary:
+        return None
+    ranked = sorted(boundary.items(), key=lambda kv: (-len(kv[1]), kv[0]))
+    if len(ranked) > 1 and len(ranked[0][1]) == len(ranked[1][1]):
+        return None
+    return ranked[0][0]
