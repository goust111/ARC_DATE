+def _resolve_pairs(
+    rays: list[dict],
+    candidates: dict[int, list[dict]],
+) -> list[dict]:
+    unresolved = {ray["id"] for ray in rays}
+    resolved: list[dict] = []
+    while True:
+        pref: dict[int, dict] = {}
+        for rid in unresolved:
+            for cand in candidates[rid]:
+                if cand["partner"] in unresolved:
+                    pref[rid] = cand
+                    break
+        new_pairs: list[dict] = []
+        used: set[int] = set()
+        for rid, cand in pref.items():
+            if rid in used or cand["partner"] in used:
+                continue
+            other = pref.get(cand["partner"])
+            if other is None:
+                continue
+            if other["partner"] != rid or other["pos"] != cand["pos"]:
+                continue
+            new_pairs.append(
+                {
+                    "a": rid,
+                    "b": cand["partner"],
+                    "pos": cand["pos"],
+                    "da": cand["self_dist"],
+                    "db": other["self_dist"],
+                }
