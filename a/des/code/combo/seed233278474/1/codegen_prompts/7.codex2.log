+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+GREY = 5
+SEGMENT_COLORS = (1, 2, 6, 7, 8, 9)
