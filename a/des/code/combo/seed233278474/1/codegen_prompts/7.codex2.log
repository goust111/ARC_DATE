+
+def _canonical_notch(rng: random.Random) -> list[tuple[int, int]]:
+    for _ in range(100):
+        a = rng.randint(2, 5)
+        b = rng.randint(2, 5)
+        u = rng.randint(2, 5)
+        v = rng.randint(2, 5)
