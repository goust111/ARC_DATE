+def _nearest_body_block(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    body_cells: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> int:
+    r, c = start
+    dr, dc = direction
+    step = 1
+    while True:
+        rr = r + dr * step
+        cc = c + dc * step
