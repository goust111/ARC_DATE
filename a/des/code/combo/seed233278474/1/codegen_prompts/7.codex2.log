+    midr = (p0[0] + p1[0]) / 2.0
+    right = _point_in_polygon((midr, c + 0.5), vertices)
+    left = _point_in_polygon((midr, c - 0.5), vertices)
+    if right == left:
+        raise AssertionError("cannot determine inward side of vertical edge")
+    return (0, 1) if right else (0, -1)
