+        r = p0[0]
+        midc = (p0[1] + p1[1]) / 2.0
+        down = _point_in_polygon((r + 0.5, midc), vertices)
+        up = _point_in_polygon((r - 0.5, midc), vertices)
+        if down == up:
+            raise AssertionError("cannot determine inward side of horizontal edge")
