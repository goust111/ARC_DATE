+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+GREY = 5
+SEGMENT_COLORS = (1, 2, 6, 7, 8, 9)
+RESERVED = {BLACK, GREEN, YELLOW, GREY}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
