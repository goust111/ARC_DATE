+        edge["body"] = [(r + shift[0], c + shift[1]) for r, c in edge["body"]]
+        edge["endpoints"] = [(r + shift[0], c + shift[1]) for r, c in edge["endpoints"]]
+        edge["vertices"] = tuple((r + shift[0], c + shift[1]) for r, c in edge["vertices"])
