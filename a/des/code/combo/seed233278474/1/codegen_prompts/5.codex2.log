+def _draw_clock(grid: np.ndarray, center: tuple[int, int], direction: str) -> None:
+    r, c = center
+    for dr, dc in GREY_OFFSETS:
+        grid[r + dr, c + dc] = GREY
+    dr, dc = POINTER_OFFSETS[direction]
+    grid[r + dr, c + dc] = RED
