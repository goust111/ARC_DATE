+ARROW_OFFSETS = {
+    "right": ((0, 0), (1, 1), (2, 0)),
+    "left": ((0, 1), (1, 0), (2, 1)),
+    "up": ((0, 1), (1, 0), (1, 2)),
+    "down": ((0, 0), (0, 2), (1, 1)),
+}
+ARROW_PATTERNS = {
+    frozenset(offsets): direction for direction, offsets in ARROW_OFFSETS.items()
+}
