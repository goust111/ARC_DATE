+    g = np.asarray(grid, dtype=int)
+    height, width = g.shape
+    candidates: list[tuple[int, int]] = []
+
+    for r_raw, c_raw in np.argwhere((g != BLACK) & (g != GREY)):
+        r = int(r_raw)
+        c = int(c_raw)
+        if not (0 < r < height - 1 and 0 < c < width - 1):
