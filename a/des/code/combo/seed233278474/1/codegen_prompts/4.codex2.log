+        dr, dc = DIR_STEP[direction]
+        for step in range(1, seed_count):
+            rr = seed_r + dr * step
+            cc = seed_c + dc * step
+            if int(out[rr, cc]) != seed_color:
+                return False
+        end_r = seed_r + dr * seed_count
+        end_c = seed_c + dc * seed_count
