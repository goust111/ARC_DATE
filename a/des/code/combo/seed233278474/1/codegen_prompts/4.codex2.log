+            for cc in range(max(0, c - radius), min(width - 1, c + radius) + 1):
+                expanded.add((rr, cc))
+    return expanded
+
+
+def _pick_free_cell(
+    rng: random.Random, height: int, width: int, blocked: set[tuple[int, int]]
+) -> tuple[int, int] | None:
