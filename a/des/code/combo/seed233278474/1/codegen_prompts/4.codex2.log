+    "left": (0, -1),
+}
+SIDE_CELLS = {
+    "up": ((-1, -1), (-1, 0), (-1, 1)),
+    "right": ((-1, 1), (0, 1), (1, 1)),
+    "down": ((1, -1), (1, 0), (1, 1)),
+    "left": ((-1, -1), (0, -1), (1, -1)),
