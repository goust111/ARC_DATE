+        return None
+
+    positions: list[tuple[int, int]] = []
+    for _ in range(count):
+        for _ in range(200):
+            r = rng.randint(top_row, height - RING)
+            c = rng.randint(0, width - RING)
+            if any(_boxes_conflict((r, c), prev) for prev in positions):
