+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 9)
+SIDES = ("top", "bottom", "left", "right")
+
+GEN_RETRIES = 400
+COMPONENT_RETRIES = 200
