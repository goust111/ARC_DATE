+                side = "top"
+            elif r == r1 and c0 < c < c1:
+                side = "bottom"
+            elif c == c0 and r0 < r < r1:
+                side = "left"
+            elif c == c1 and r0 < r < r1:
+                side = "right"
+            else:
+                valid_markers = False
+                break
+            if side in sides:
+                valid_markers = False
+                break
