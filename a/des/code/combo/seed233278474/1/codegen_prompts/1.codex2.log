+    missing = {
+        "top": int(np.sum(grid[fr0, fc0 : fc1 + 1] != FRAME_COLOR)),
+        "bottom": int(np.sum(grid[fr1, fc0 : fc1 + 1] != FRAME_COLOR)),
+        "left": int(np.sum(grid[fr0 : fr1 + 1, fc0] != FRAME_COLOR)),
+        "right": int(np.sum(grid[fr0 : fr1 + 1, fc1] != FRAME_COLOR)),
