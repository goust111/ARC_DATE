+def _random_parts(total: int, count: int, min_part: int) -> list[int] | None:
+    rest = int(total - count * min_part)
+    if rest < 0:
+        return None
+    parts = [int(min_part)] * count
+    for _ in range(rest):
+        parts[random.randrange(count)] += 1
+    random.shuffle(parts)
+    return parts
