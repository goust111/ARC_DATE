+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+FRAME_COLOR = GREY
+MARKER_COLOR = YELLOW
+INPUT_COLORS = (BLUE, RED, GREEN, MAGENTA, ORANGE)
+RANK_RECOLORS = (AZURE, MAROON, YELLOW)
