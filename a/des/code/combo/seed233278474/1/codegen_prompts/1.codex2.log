+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+
+    order = sorted(
+        range(len(projected)),
+        key=lambda i: (
+            -int(projected[i]["length"]),
+            int(projected[i]["distance"]),
+            tuple(map(int, projected[i]["bbox"])),
