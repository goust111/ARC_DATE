+def _can_place(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int, margin: int = 1) -> bool:
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(blocked.shape[0] - 1, r1 + margin)
+    cc1 = min(blocked.shape[1] - 1, c1 + margin)
+    return not bool(blocked[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
