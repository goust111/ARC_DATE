+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+TEMPLATE_COLOR_POOL = (1, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
