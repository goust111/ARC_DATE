+def _template_masks(size: int) -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for seq in _style_sequences(size):
+        mask = np.zeros((size, size), dtype=bool)
+        mask[0, :] = seq
+        mask[-1, :] = seq
+        mask[:, 0] = seq
+        mask[:, -1] = seq
+        masks.append(mask)
+    return masks
