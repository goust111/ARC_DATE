+        border = _border_mask(rect_h, rect_w)
+        tile = grid[r0 : r1 + 1, c0 : c1 + 1]
+        tile[border] = GREY
+        interior_cells = [(rr, cc) for rr in range(r0 + 1, r1) for cc in range(c0 + 1, c1)]
+        for rr, cc in random.sample(interior_cells, count):
