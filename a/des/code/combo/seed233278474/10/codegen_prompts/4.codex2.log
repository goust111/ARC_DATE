+def _extract_templates(grid: np.ndarray) -> list[tuple[int, np.ndarray]]:
+    legend_mask = (grid != BG) & (grid != RED) & (grid != GREY)
+    points = np.argwhere(legend_mask)
+    assert len(points) > 0, "expected colored legend templates"
