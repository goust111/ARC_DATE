+    band = grid[r0 : r1 + 1, c0 : c1 + 1]
+    band_h, band_w = band.shape
+    candidates: list[tuple[int, int, list[tuple[int, np.ndarray]]]] = []
+
+    for gap in range(1, band_w):
+        span = band_w - 3 * gap
+        if span <= 0 or span % 4 != 0:
+            continue
+        tile_w = span // 4
