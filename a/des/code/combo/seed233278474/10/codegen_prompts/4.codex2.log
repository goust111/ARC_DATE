+        r0 = random.randint(top_min, h - rect_h - 2)
+        c0 = random.randint(1, w - rect_w - 2)
+        r1 = r0 + rect_h - 1
+        c1 = c0 + rect_w - 1
+        if not _can_place(blocked, r0, c0, r1, c1, margin=1):
