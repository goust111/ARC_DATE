+def _branch_counts(n_rects: int) -> list[int]:
+    counts: list[int] = []
+    while len(counts) < n_rects:
+        batch = [1, 2, 3, 4]
+        random.shuffle(batch)
+        counts.extend(batch)
+    counts = counts[:n_rects]
+    random.shuffle(counts)
+    return counts
