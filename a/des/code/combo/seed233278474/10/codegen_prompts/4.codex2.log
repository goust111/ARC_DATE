+def _style_sequences(size: int) -> list[np.ndarray]:
+    center = size // 2
+    full = np.ones(size, dtype=bool)
+
+    notch = np.ones(size, dtype=bool)
+    notch[center] = False
+
+    corners = np.zeros(size, dtype=bool)
+    corners[0] = True
+    corners[-1] = True
+
+    mids = np.zeros(size, dtype=bool)
+    mids[center] = True
+
