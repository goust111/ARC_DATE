+def _find_marker(grid: np.ndarray, color: int) -> tuple[int, int]:
+    h, w = grid.shape
+    matches: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if bool(np.all(grid[r : r + 2, c : c + 2] == color)):
+                matches.append((r, c))
+    assert len(matches) == 1, f"expected exactly one {color} 2x2 marker"
+    return matches[0]
