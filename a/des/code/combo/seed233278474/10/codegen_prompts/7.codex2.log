+def _adjacent_path_pixels(path_mask: np.ndarray, marker_mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = path_mask.shape
+    out: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(path_mask):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc, h, w):
+            if bool(marker_mask[nr, nc]):
+                out.add((rr, cc))
+                break
+    return sorted(out)
+
+
+def _follow_branchless(
+    path_mask: np.ndarray,
+    start: tuple[int, int],
+    ends: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    h, w = path_mask.shape
+    path = [start]
+    seen = {start}
+    prev: tuple[int, int] | None = None
+    cur = start
+
+    while True:
+        if cur in ends:
+            return path
+
+        choices: list[tuple[int, int]] = []
+        for nr, nc in _neighbors4(cur[0], cur[1], h, w):
+            nxt = (nr, nc)
+            if not bool(path_mask[nr, nc]):
+                continue
+            if nxt == prev:
+                continue
+            if nxt in seen:
+                return None
+            choices.append(nxt)
+
+        if len(choices) != 1:
+            return None
+
+        prev = cur
+        cur = choices[0]
+        path.append(cur)
+        seen.add(cur)
+
