+def _follow_branchless(
+    path_mask: np.ndarray,
+    start: tuple[int, int],
+    ends: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    h, w = path_mask.shape
+    path = [start]
+    seen = {start}
+    prev: tuple[int, int] | None = None
+    cur = start
+
+    while True:
+        if cur in ends:
+            return path
+
+        choices: list[tuple[int, int]] = []
+        for nr, nc in _neighbors4(cur[0], cur[1], h, w):
+            nxt = (nr, nc)
+            if not bool(path_mask[nr, nc]):
+                continue
+            if nxt == prev:
+                continue
+            if nxt in seen:
+                return None
+            choices.append(nxt)
+
+        if len(choices) != 1:
+            return None
+
+        prev = cur
+        cur = choices[0]
+        path.append(cur)
+        seen.add(cur)
