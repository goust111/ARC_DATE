+        occupied.update(cells)
+        placed += 1
+
+
+def _paint_marker(grid: np.ndarray, marker: dict, color: int) -> None:
+    r0, c0 = marker["top_left"]
+    grid[r0 : r0 + 2, c0 : c0 + 2] = color
+
+
+def _gen_attempt() -> np.ndarray:
