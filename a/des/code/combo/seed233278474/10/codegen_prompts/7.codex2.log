+def _marker_mask(shape: tuple[int, int], top_left: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0 = top_left
+    mask[r0 : r0 + 2, c0 : c0 + 2] = True
+    return mask
