+    return rooms
+
+
+def _make_horizontal(room: tuple[int, int, int, int], row: int, sign: int, color: int) -> dict[str, object]:
+    r0, r1, c0, c1 = room
+    assert r0 <= row <= r1
+    assert sign in (-1, 1)
