+    else:
+        cols = random.sample(list(range(c0, c1 + 1)), count)
+        for col, color in zip(sorted(cols), colors, strict=False):
+            sign = random.choice((-1, 1))
+            arrows.append(_make_vertical(room, col, sign, color))
