+            out[r, c] = mix_map[frozenset(colors)]
+    return out
+
+
+def _pick_spaced_positions(start: int, end: int, max_count: int) -> list[int]:
+    if start > end or max_count <= 0:
+        return []
+    target = random.randint(0, max_count)
+    pool = list(range(start, end + 1))
+    random.shuffle(pool)
