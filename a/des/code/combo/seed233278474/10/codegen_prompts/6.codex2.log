+def _exterior_background(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    ext = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not ext[r, c]:
+                ext[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not ext[r, c]:
+                ext[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not ext[nr, nc]:
+                ext[nr, nc] = True
+                q.append((nr, nc))
+    return ext
