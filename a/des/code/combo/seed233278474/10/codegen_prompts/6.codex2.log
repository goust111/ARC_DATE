+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return np.array(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool, copy=True)
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    holes = 0
