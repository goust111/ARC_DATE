+def _make_zero_hole_mask() -> np.ndarray:
+    for _ in range(OBJECT_RETRIES):
+        target = random.randint(5, 16)
+        cells: set[tuple[int, int]] = {(0, 0)}
+        while len(cells) < target:
+            candidates: dict[tuple[int, int], float] = {}
+            for r, c in cells:
