+    h, w = blocked.shape
+    for dr, dc in np.argwhere(mask):
+        rr = top + int(dr)
+        cc = left + int(dc)
+        for adr in (-1, 0, 1):
+            for adc in (-1, 0, 1):
+                nr, nc = rr + adr, cc + adc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _place_objects(specs: list[dict], height: int, width: int) -> np.ndarray | None:
+    grid = np.zeros((height, width), dtype=int)
+    blocked = np.zeros((height, width), dtype=bool)
+    order = sorted(
