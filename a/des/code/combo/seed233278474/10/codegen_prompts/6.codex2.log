+                    neighbors = []
+                    for sdr, sdc in DIR4:
+                        nr, nc = rr + sdr, cc + sdc
+                        if 0 <= nr < work.shape[0] and 0 <= nc < work.shape[1] and work[nr, nc]:
+                            neighbors.append((nr, nc))
+                    allowed = {(ar, ac)} if step == 1 else {pts[-1]}
+                    if any(p not in allowed for p in neighbors):
