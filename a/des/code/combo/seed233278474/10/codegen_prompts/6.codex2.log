+            r0, c0, r1, c1 = _bbox_from_cells(cells)
+            sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+            for cr, cc in cells:
+                sprite[cr - r0, cc - c0] = color
+            objects.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "sprite": sprite,
