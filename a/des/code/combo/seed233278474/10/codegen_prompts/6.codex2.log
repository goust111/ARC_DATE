+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 300
+OBJECT_RETRIES = 120
+PLACEMENT_RETRIES = 180
+GRID_MIN = 16
+GRID_MAX = 30
+MAX_OUTPUT_SIDE = 30
+
+
+def _background_color(grid: np.ndarray) -> int:
