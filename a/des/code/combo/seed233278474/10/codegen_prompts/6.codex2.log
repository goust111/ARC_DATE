+def _build_output(objects: list[dict], bg: int) -> np.ndarray:
+    if not objects:
+        return np.zeros((0, 0), dtype=int)
+    groups: dict[int, list[dict]] = defaultdict(list)
+    for obj in objects:
+        groups[int(obj["holes"])].append(obj)
