+        sh, sw = mask.shape
+        if sh > height - 2 or sw > width - 2:
+            return None
+        row_lo = 1
+        row_hi = height - sh - 1
+        col_lo = 1
+        col_hi = width - sw - 1
+        if row_lo > row_hi or col_lo > col_hi:
