            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if not (0<=nr<h and 0<=nc<w and mask[nr,nc]):
                    out[r,c]=True
                    break
    return out

def enclosed(comp_pts):
    r0,c0,r1,c1=bbox(comp_pts)
    h,w=r1-r0+1,c1-c0+1
    wall=np.zeros((h+2,w+2),dtype=bool)
    for r,c in comp_pts: wall[r-r0+1,c-c0+1]=True
    seen=np.zeros_like(wall,dtype=bool)
    q=deque([(0,0)])
    seen[0,0]=True
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<h+2 and 0<=nc<w+2 and not wall[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=True; q.append((nr,nc))
    fill=(~wall)&(~seen)
    locs=[]
    for rr,cc in np.argwhere(fill[1:-1,1:-1]):
        locs.append((r0+int(rr),c0+int(cc)))
    return locs

