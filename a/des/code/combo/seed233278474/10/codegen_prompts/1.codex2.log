import random
from collections import deque
import numpy as np

BLACK=0
GREY=5
PALETTE=[1,2,3,4,6,7,8,9]

def components(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            pts=[]
            while q:
                rr,cc=q.popleft(); pts.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(pts)
    return out

def bbox(pts):
    rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
    return min(rs), min(cs), max(rs), max(cs)

def signature(pts):
    r0,c0,r1,c1=bbox(pts)
    arr=np.zeros((r1-r0+1,c1-c0+1),dtype=np.uint8)
    for r,c in pts: arr[r-r0,c-c0]=1
    return tuple(arr.ravel().tolist()), arr.shape

def boundary(mask):
    h,w=mask.shape
    out=np.zeros_like(mask,dtype=bool)
    for r in range(h):
        for c in range(w):
