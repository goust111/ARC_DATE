    for bpts in blocks:
        vals={int(g[r,c]) for r,c in bpts}
        color=vals.pop()
        br0,bc0,br1,bc1=bbox(bpts)
        cand=[]
        for i,(gr0,gc0,gr1,gc1) in enumerate(grey_boxes):
