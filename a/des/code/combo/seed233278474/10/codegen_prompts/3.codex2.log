import random
from collections import deque


def neigh(cell,h,w):
    r,c=cell
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc


def connected(cells,h,w):
    cells=set(cells)
    if not cells:
        return False
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        x=q.popleft()
        for y in neigh(x,h,w):
            if y in cells and y not in seen:
                seen.add(y); q.append(y)
    return len(seen)==len(cells)


