+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+
+PAIR_COUNT_RANGE = (2, 4)
+HEIGHT_CHOICES = tuple(range(3, 8))
+WIDTH_CHOICES = tuple(range(3, 9))
+GRID_MIN_SIZE = 16
+GRID_MAX_SIZE = 30
+PLACEMENT_PADDING = 1
+PLACEMENT_TRIES = 1000
+MASK_TRIES = 200
+GENERATION_TRIES = 400
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _component_coords(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(coords)
+
+    return components
+
+
+def _normalized_mask(coords: list[tuple[int, int]]) -> np.ndarray:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        out[r - r0, c - c0] = True
+    return out
+
+
+def _bbox_shape(mask: np.ndarray) -> tuple[int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
