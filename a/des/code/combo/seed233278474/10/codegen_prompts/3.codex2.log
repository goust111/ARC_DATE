import random

def cycle(h,w):
    if h % 2 == 0:
        path=[]
        path.extend((0,c) for c in range(w))
        for r in range(1,h):
            if r % 2 == 1:
                path.extend((r,c) for c in range(w-1,0,-1))
            else:
                path.extend((r,c) for c in range(1,w))
        path.extend((r,0) for r in range(h-1,0,-1))
        assert len(path)==h*w
        for a,b in zip(path,path[1:]+path[:1]):
            assert abs(a[0]-b[0])+abs(a[1]-b[1])==1
        return path
    if w % 2 == 0:
        t=cycle(w,h)
        return [(c,r) for r,c in t]
    raise ValueError

def full_bbox(coords,h,w):
    rows=[r for r,c in coords]
    cols=[c for r,c in coords]
    return min(rows)==0 and max(rows)==h-1 and min(cols)==0 and max(cols)==w-1

def find(h,w):
    cyc=cycle(h,w)
    n=len(cyc)
    min_len=max(h+w-1, n//3)
    max_len=n-min_len
    ok=0
    for _ in range(5000):
        off=random.randrange(n)
        L=random.randint(min_len,max_len)
        seq=cyc[off:]+cyc[:off]
        a=seq[:L]
        b=seq[L:]
        if full_bbox(a,h,w) and full_bbox(b,h,w):
            ok+=1
    return ok

