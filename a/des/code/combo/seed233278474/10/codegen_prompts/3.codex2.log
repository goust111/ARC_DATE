import random, hashlib
from collections import deque
import numpy as np


def components(mask):
    H,W=mask.shape
    vis=np.zeros((H,W),dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or vis[r,c]:
                continue
            q=deque([(r,c)])
            vis[r,c]=True
            cells=[]
            while q:
                x,y=q.popleft(); cells.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    xx,yy=x+dx,y+dy
                    if 0<=xx<H and 0<=yy<W and mask[xx,yy] and not vis[xx,yy]:
                        vis[xx,yy]=True; q.append((xx,yy))
            out.append(cells)
    return out


def norm(cells):
    rows=[r for r,c in cells]; cols=[c for r,c in cells]
    r0,r1=min(rows),max(rows); c0,c1=min(cols),max(cols)
    m=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)
    for r,c in cells:
        m[r-r0,c-c0]=True
    return m


def main(grid):
    g=np.asarray(grid,dtype=int)
    rects=[]
    for color in sorted(set(map(int,g.ravel()))-{0}):
        comps=components(g==color)
        assert len(comps)==2
        a,b=comps
        ma,mb=norm(a),norm(b)
        assert ma.shape==mb.shape
        merged=ma|mb
        assert merged.all()
        h,w=merged.shape
        rects.append((h*w,h,w,color))
    areas=[a for a,_,_,_ in rects]
    assert len(set(areas))==len(areas)
    out=np.zeros((max(h for _,h,_,_ in rects), max(w for _,_,w,_ in rects)),dtype=int)
    for _area,h,w,color in sorted(rects, reverse=True):
        out[:h,:w]=color
    return out


def boundary_masks(h,w):
    if random.random()<0.5:
        b=[random.randrange(w) for _ in range(h)]
        i,j=random.sample(range(h),2)
        b[i]=0; b[j]=w-1
        if all(v in (0,w-1) for v in b):
            b[random.randrange(h)] = random.randrange(1,w-1) if w>2 else 0
        a=np.zeros((h,w),dtype=bool); c=np.zeros((h,w),dtype=bool)
        for r,v in enumerate(b):
            a[r,:v+1]=True
            c[r,v:]=True
        return a,c
    else:
        b=[random.randrange(h) for _ in range(w)]
        i,j=random.sample(range(w),2)
        b[i]=0; b[j]=h-1
        if all(v in (0,h-1) for v in b):
            b[random.randrange(w)] = random.randrange(1,h-1) if h>2 else 0
        a=np.zeros((h,w),dtype=bool); c=np.zeros((h,w),dtype=bool)
        for col,v in enumerate(b):
            a[:v+1,col]=True
            c[v:,col]=True
        return a,c


def sample_dims(n):
    for _ in range(1000):
        hs=sorted(random.sample(range(3,8), n))
        ws=sorted(random.sample(range(3,9), n))
        dims=list(zip(hs,ws))
        areas=[h*w for h,w in dims]
        if len(set(areas))"'!=n:
            continue
        return dims
    raise RuntimeError


def can_place(occ,H,W,h,w,r0,c0):
    rr0=max(0,r0-1); rr1=min(H,r0+h+1); cc0=max(0,c0-1); cc1=min(W,c0+w+1)
    return not occ[rr0:rr1,cc0:cc1].any()


def place(grid,occ,mask,color):
    H,W=grid.shape; h,w=mask.shape
    for _ in range(500):
        r0=random.randrange(H-h+1); c0=random.randrange(W-w+1)
        if can_place(occ,H,W,h,w,r0,c0):
            grid[r0:r0+h,c0:c0+w][mask]=color
            rr0=max(0,r0-1); rr1=min(H,r0+h+1); cc0=max(0,c0-1); cc1=min(W,c0+w+1)
            occ[rr0:rr1,cc0:cc1]=True
            return True
    return False


def gen():
    for _ in range(200):
        n=random.randint(2,4)
        dims=sample_dims(n)
        total=2*sum(h*w for h,w in dims)
        base=max(max(h for h,_ in dims)+4, max(w for _,w in dims)+4, int((total*2.5)**0.5)+1, 16)
        if base>30: continue
        H=random.randint(base,30); W=random.randint(base,30)
        colors=random.sample(range(1,10), n)
        grid=np.zeros((H,W),dtype=int)
        occ=np.zeros((H,W),dtype=bool)
        ok=True
        rects=[]
        items=[]
        for (h,w),color in zip(dims,colors):
            m1,m2=boundary_masks(h,w)
            items.extend([(h*w,h,w,color,m1),(h*w,h,w,color,m2)])
            rects.append((h*w,h,w,color))
        random.shuffle(items)
        for _a,h,w,color,mask in sorted(items, key=lambda x: (x[1]*x[2], random.random()), reverse=True):
            if not place(grid,occ,mask,color):
                ok=False; break
        if not ok:
            continue
        exp=np.zeros((max(h for _,h,_,_ in rects), max(w for _,_,w,_ in rects)),dtype=int)
        for _area,h,w,color in sorted(rects, reverse=True):
            exp[:h,:w]=color
        if np.array_equal(main(grid), exp):
            return grid
    raise RuntimeError

sigs=set()
for i in range(100):
    inp=gen()
    out=main(inp)
    sigs.add(hashlib.md5(inp.tobytes()+str(inp.shape).encode()).hexdigest())
print('"'variants', len(sigs), 'outshapes', sorted({out.shape for _ in range(1)}))
assert len(sigs)>=20
