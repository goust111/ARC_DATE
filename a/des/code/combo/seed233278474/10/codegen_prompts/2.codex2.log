+def _neighbors(size: int, cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    out = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < size and 0 <= nc < size and (nr, nc) != (0, 0):
