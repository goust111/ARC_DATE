+    palette = random.sample(seed_colors, len(seed_colors))
+    panel_seeds = random.sample(seed_colors, len(seed_colors))
+    grid = _render_grid(panel_rows, panel_cols, panel_size, pattern_mask, pattern_color, panel_seeds, palette)
+
+    try:
+        out = main(grid)
+    except Exception:
