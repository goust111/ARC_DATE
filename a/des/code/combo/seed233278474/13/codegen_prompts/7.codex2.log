+def _expected_from_specs(grid: np.ndarray, specs: list[dict[str, object]]) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
+        row = int(spec["row"])
+        c0 = int(spec["c0"])
+        length = int(spec["length"])
+        left_color = int(spec["left"])
+        right_color = int(spec["right"])
+        cargo_cells = list(spec["cargo"])
