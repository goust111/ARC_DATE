+    out = g[:legend_top, :].copy()
+    for r0, c0, r1, c1, seed in regions:
+        pattern = legend[seed]
+        inner_h = r1 - r0 - 1
+        inner_w = c1 - c0 - 1
+        row = _tile_pattern(pattern, inner_w)
+        out[r0 + 1 : r1, c0 + 1 : c1] = np.tile(row, (inner_h, 1))
+    return out
+
+
+def _random_pattern() -> np.ndarray:
+    length = random.randint(2, 5)
