        for r in range(row, row + group_heights[idx]):
            if pattern == "LEFT":
                out[r, left_slot] = colors[0]
                out[r, target_start : target_start + RUN_WIDTH] = colors[0]
            elif pattern == "RIGHT":
                out[r, right_slot] = colors[0]
