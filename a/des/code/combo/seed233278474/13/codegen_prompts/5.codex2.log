  85:     def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
  86:         src_h, src_w = img.shape
  87:         if new_h <= 0 or new_w <= 0:
  88:             return img.copy()
  89:         rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)
  90:         cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)
  91:         rr = np.clip(rr, 0, src_h - 1)
  92:         cc = np.clip(cc, 0, src_w - 1)
  93:         return img[rr[:, None], cc[None, :]]
