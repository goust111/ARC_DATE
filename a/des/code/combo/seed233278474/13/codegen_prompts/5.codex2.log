  23: def main(grid: np.ndarray) -> np.ndarray:
  24:     """
  25:     Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.
  26: 
  27:     Input structure:
  28:     - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.
  29:     - Each quadrant contains a red (2) square anchor block of varying size.
  30:     - The top-left quadrant also has a colored motif attached to its red anchor.
  31: 
  32:     Rule:
  33:     - Use the top-left quadrant's motif as the source pattern.
  34:     - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.
  35:     - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).
  36:     - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.
  37: 
  38:     Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.
  39:     """
  40:     g = np.asarray(grid, dtype=int)
  41:     h, w = g.shape
  42:     out = g.copy()
  43: 
  44:     bg = get_bg(g)
  45:     mid_r, mid_c = _find_dividers(g, bg)
  46: 
  47:     # Find red anchor blocks (color 2) in each quadrant.
  48:     red = components_mask(g == 2, connectivity=4)
  49:     assert red, "grid must contain red (color 2) anchor blocks"
  50: 
  51:     # Quadrant key: (top/bottom, left/right)
  52:     anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
  53:     # value: (r0,c0,size)
  54:     for pts in red:
  55:         r0, c0, r1, c1 = bbox_coords(pts)
  56:         rr = (r0 + r1) // 2
  57:         cc = (c0 + c1) // 2
  58:         qb = 0 if rr < mid_r else 1
  59:         qr = 0 if cc < mid_c else 1
  60:         size = max(r1 - r0 + 1, c1 - c0 + 1)
  61:         key = (qb, qr)
  62:         assert key not in anchors, "each quadrant must contain exactly one red anchor block"
  63:         anchors[key] = (int(r0), int(c0), int(size))
  64: 
  65:     assert (0, 0) in anchors, "top-left quadrant must contain a red anchor block"
  66:     sr0, sc0, sL = anchors[(0, 0)]
  67:     assert sL > 0, "top-left red anchor must have positive size"
  68: 
  69:     # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)
  70:     # in the TL quadrant that contains the TL red anchor.
