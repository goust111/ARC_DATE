+def _find_objects(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == 0:
+                continue
+
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS8:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) == 0:
+                        continue
+                    assert int(grid[nr, nc]) == color, "each object must be monochrome"
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            pts = np.asarray(coords, dtype=int)
+            r0 = int(np.min(pts[:, 0]))
+            c0 = int(np.min(pts[:, 1]))
+            r1 = int(np.max(pts[:, 0]))
+            c1 = int(np.max(pts[:, 1]))
+            objects.append(
