+    buckets = {direction: [] for direction in DIRECTIONS}
+    for spec in specs:
+        direction = str(spec["direction"])
+        assert direction in buckets
+        buckets[direction].append(int(spec["color"]))
+
+    origins = {
+        (0, 0): (0, 0),
+        (0, 1): (0, qw + 1),
+        (1, 0): (qh + 1, 0),
+        (1, 1): (qh + 1, qw + 1),
