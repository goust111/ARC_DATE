+import numpy as np
+
+
+YELLOW = 4
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _majority_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
