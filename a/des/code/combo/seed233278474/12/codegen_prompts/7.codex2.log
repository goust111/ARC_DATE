+def _find_hole(component: dict, grid: np.ndarray) -> tuple[int, int]:
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    color = int(component["color"])
+    patch = np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+    obj_mask = patch == color
