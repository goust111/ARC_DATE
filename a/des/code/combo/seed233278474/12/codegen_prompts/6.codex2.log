+        r, c, dr, dc, color = queue.popleft()
+        if not _in_bounds(g.shape, r, c):
+            continue
+
+        state = (r, c, dr, dc, color)
+        if state in seen:
+            continue
+        seen.add(state)
+
+        cell = int(g[r, c])
+        if cell == MAROON:
+            wall_hits += 1
+            continue
+        if cell == GREY:
+            prism_hits += 1
+            for ndr, ndc in _perpendiculars(dr, dc):
+                split_count += 1
+                queue.append((r + ndr, c + ndc, ndr, ndc, color))
+            continue
