def _exact_parallel_line_fill(a: np.ndarray) -> np.ndarray:
    out = a.copy()
    h, w = out.shape

    changed = True
    while changed:
        changed = False
        for axis in (0, 1):
            n_lines = h if axis == 0 else w
            lines = [
                out[i, :].copy() if axis == 0 else out[:, i].copy()
                for i in range(n_lines)
