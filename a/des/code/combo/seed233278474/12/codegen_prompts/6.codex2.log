+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+TOWER_COLORS = (BLUE, RED, YELLOW)
+INPUT_COLORS = {BLACK, BLUE, RED, YELLOW, GREY, MAROON}
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
