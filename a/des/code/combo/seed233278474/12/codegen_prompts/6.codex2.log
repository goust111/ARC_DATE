+        if cell == BLACK:
+            masks[color][r, c] = True
+        queue.append((r + dr, c + dc, dr, dc, color))
+
+    return masks, {
+        "prism_hits": prism_hits,
+        "wall_hits": wall_hits,
+        "split_count": split_count,
+    }
