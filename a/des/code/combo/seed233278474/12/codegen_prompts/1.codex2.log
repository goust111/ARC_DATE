+def _make_frame_patch(border_color: int, fingerprint: np.ndarray, inner_h: int, inner_w: int) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    patch[0, :] = border_color
+    patch[-1, :] = border_color
+    patch[:, 0] = border_color
+    patch[:, -1] = border_color
