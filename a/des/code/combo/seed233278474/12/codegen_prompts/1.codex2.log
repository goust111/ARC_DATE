+        )
+    return frames
+
+
+def _quadrant_of_point(rel_r: int, rel_c: int, h: int, w: int) -> int:
+    top = (2 * rel_r) < h
+    left = (2 * rel_c) < w
+    if top and left:
+        return 0
+    if top and not left:
+        return 1
+    if not top and left:
+        return 2
+    return 3
+
+
+def _anchor_for_quadrant(
+    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int], quadrant: int
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame_bbox
+    ph, pw = patch_shape
+    inner_r0 = r0 + 1
+    inner_c0 = c0 + 1
+    inner_r1 = r1 - 1
+    inner_c1 = c1 - 1
+    if quadrant == 0:
+        return inner_r0, inner_c0
+    if quadrant == 1:
+        return inner_r0, inner_c1 - pw + 1
+    if quadrant == 2:
