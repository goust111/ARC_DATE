+    frame_by_color: dict[int, dict] = {}
+    frame_bboxes = set()
+    for frame in frames:
+        color = int(frame["color"])
+        assert color not in frame_by_color, "frame colors must be unique"
+        frame_by_color[color] = frame
+        frame_bboxes.add(tuple(frame["bbox"]))
