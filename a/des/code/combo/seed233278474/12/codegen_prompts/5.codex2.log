from collections import defaultdict, deque
import random

import numpy as np


BG = 8  # azure
PALETTE = (1, 2, 3, 4, 5, 6, 7, 9)

PAIR_COUNT_RANGE = (2, 3)
INPUT_HEIGHT_RANGE = (18, 26)
INPUT_WIDTH_RANGE = (20, 30)
