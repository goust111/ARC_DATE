+def _is_gear_center(g: np.ndarray, r: int, c: int) -> bool:
+    if g[r, c] == BG:
+        return False
+    patch = g[r - 1 : r + 2, c - 1 : c + 2]
+    return np.array_equal(patch != BG, GEAR_MASK)
