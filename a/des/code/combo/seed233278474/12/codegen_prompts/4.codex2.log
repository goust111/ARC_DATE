+def _driver_distances(gears: list[dict], adj: list[set[int]]) -> dict[int, int]:
+    driver_ids = [i for i, gear in enumerate(gears) if gear["body"] == DRIVER_COLOR]
+    assert len(driver_ids) == 1, "expected exactly one red driving gear"
