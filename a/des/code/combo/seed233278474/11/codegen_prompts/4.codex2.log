+def _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    h, w = mask.shape
+    patch = grid[r0 : r0 + h, c0 : c0 + w]
+    patch[mask] = int(color)
