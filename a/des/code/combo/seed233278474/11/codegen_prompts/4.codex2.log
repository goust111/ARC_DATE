+BG = 0
+BLUE = 1
+RED = 2
+STRIPE_COLORS = (3, 4, 5, 6, 7, 8, 9)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PERP = {
+    "up": (0, 1),
+    "down": (0, 1),
+    "left": (1, 0),
+    "right": (1, 0),
+}
+GENERATION_ATTEMPTS = 400
+OBJECT_PLACEMENT_ATTEMPTS = 120
