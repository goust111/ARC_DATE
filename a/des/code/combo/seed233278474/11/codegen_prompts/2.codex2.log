+        a, b = _split_rectangle(h, w)
+        if _assembled_dims(a, b) != (h, w):
+            return None
+        specs.append((color, h, w))
+        patches.append((color, _cells_to_patch(a, color)))
+        patches.append((color, _cells_to_patch(b, color)))
