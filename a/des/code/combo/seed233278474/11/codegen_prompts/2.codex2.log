+            rows_b = [r for r, _ in shifted]
+            cols_b = [c for _, c in shifted]
+            min_r = min(min_ra, min(rows_b))
+            max_r = max(max_ra, max(rows_b))
+            min_c = min(min_ca, min(cols_b))
+            max_c = max(max_ca, max(cols_b))
+            h = max_r - min_r + 1
+            w = max_c - min_c + 1
+            if h * w == area:
