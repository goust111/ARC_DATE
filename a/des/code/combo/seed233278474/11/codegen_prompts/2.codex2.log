+
+def _cells_to_patch(cells: frozenset[tuple[int, int]], color: int) -> np.ndarray:
+    h = max(r for r, _ in cells) + 1
+    w = max(c for _, c in cells) + 1
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in cells:
