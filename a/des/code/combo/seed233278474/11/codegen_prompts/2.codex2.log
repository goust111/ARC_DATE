+    limit = area
+    dims: set[tuple[int, int]] = set()
+    rows_a = [r for r, _ in a]
+    cols_a = [c for _, c in a]
+    min_ra = min(rows_a)
+    max_ra = max(rows_a)
+    min_ca = min(cols_a)
+    max_ca = max(cols_a)
+
+    list_b = list(b)
+    for dr in range(-limit, limit + 1):
+        for dc in range(-limit, limit + 1):
