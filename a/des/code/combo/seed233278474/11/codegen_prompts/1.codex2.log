+    raise RuntimeError("failed to sample diverse corner templates")
+
+
+def _expanded_slice(bbox: tuple[int, int, int, int], shape: tuple[int, int], pad: int) -> tuple[slice, slice]:
+    r0, c0, r1, c1 = bbox
