+
+def _stamp_template(out: np.ndarray, bbox: tuple[int, int, int, int], mask: np.ndarray, color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    th, tw = mask.shape
+    assert th <= inner_h and tw <= inner_w, "template must fit inside shell cavity"
