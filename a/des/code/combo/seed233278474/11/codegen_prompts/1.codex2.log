+    shell_count = 0
+    for color in colors:
+        for comp in _components_of_color(grid, color):
+            if _parse_shell(grid, color, comp["bbox"]) is not None:
+                shell_count += 1
+    if shell_count != n_shells:
+        return None
+
+    return grid
