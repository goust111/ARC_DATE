+        min_inner_h, min_inner_w = templates[side].shape
+        for _ in range(200):
+            outer_h = int(rng.integers(max(5, min_inner_h + 2), 11))
+            outer_w = int(rng.integers(max(5, min_inner_w + 2), 11))
