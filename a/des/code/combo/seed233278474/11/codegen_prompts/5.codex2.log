+    top = random.randint(*row_range)
+    left = random.randint(*col_range)
+    grid = np.full((grid_h, grid_w), BG, dtype=int)
+
+    for color, region, offset in zip(LAYER_COLORS[:depth], outer_to_inner, offsets):
+        boundary = _solid_boundary(region)
