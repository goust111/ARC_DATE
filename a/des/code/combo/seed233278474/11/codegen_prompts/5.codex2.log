+    out = g.copy()
+    odd_fill = bg_cells & (depth > 0) & ((depth % 2) == 1)
+    even_fill = bg_cells & ((depth % 2) == 0) & (depth > 0)
+    out[odd_fill] = GRAY
+    out[even_fill] = ORANGE
