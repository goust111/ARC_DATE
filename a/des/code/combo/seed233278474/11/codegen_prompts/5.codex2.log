+        return None
+    if np.any(grid[np.ix_(cross_rows, [anchor_c])] != BG):
+        return None
+    if np.any(grid[np.ix_([anchor_r], cross_cols)] != BG):
+        return None
+    _draw_cross(grid, anchor_r, anchor_c)
+
+    try:
+        out = _solve(grid)
+    except AssertionError:
+        return None
+
+    if np.any(out == YELLOW):
+        return None
+    if not np.any(out == MAGENTA):
