+    grid_h: int,
+    grid_w: int,
+    outer_h: int,
+    outer_w: int,
+    stamp_h: int,
+    stamp_w: int,
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    if corner == "tl":
