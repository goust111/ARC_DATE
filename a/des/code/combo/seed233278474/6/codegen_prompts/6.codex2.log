+
+def _dilate(cells: set[tuple[int, int]], pad: int) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                out.add((r + dr, c + dc))
+    return out
