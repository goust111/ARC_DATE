+ROOM_OUTER_MAX = 10
+ROOM_PIXELS_MIN = 1
+ROOM_PIXELS_MAX = 6
+SPEC_TRIES = 100
+PLACEMENT_TRIES = 160
+MAX_GENERATION_ATTEMPTS = 300
