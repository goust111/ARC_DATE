+    if side == "top":
+        outside = (-1, gap_rel[1])
+    elif side == "bottom":
+        outside = (height, gap_rel[1])
+    elif side == "left":
+        outside = (gap_rel[0], -1)
+    else:
+        outside = (gap_rel[0], width)
+
