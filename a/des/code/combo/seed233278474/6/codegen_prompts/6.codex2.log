+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_VECTOR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SIDES = tuple(SIDE_TO_VECTOR)
+
+
+# Generator configuration.
+BG = 0
+WALL = 5
+ROOM_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
