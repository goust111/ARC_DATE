+                continue
+            color = int(g[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in _NEIGHBORS4:
+                    nr = cr + dr
+                    nc = cc + dc
