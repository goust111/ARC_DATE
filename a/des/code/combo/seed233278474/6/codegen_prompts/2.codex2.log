+def _cells_to_mask(cells: tuple[tuple[int, int], ...]) -> np.ndarray:
+    height = max(r for r, _c in cells) + 1
+    width = max(c for _r, c in cells) + 1
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
