+_RNG = np.random.default_rng()
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    m = np.asarray(mask, dtype=bool)
+    return tuple(map(int, m.shape)), m.tobytes()
