+    reserved: set[tuple[int, int]] = set()
+    fences: list[dict[str, object]] = []
+    for seed_color in seed_colors:
+        placed = _place_one_fence(rng, h, w, reserved, seed_color)
+        if placed is None:
+            return None
+        reserved |= placed["reserve"]
+        fences.append(placed)
