+            dr, dc = info["direction"]
+            seed_color = int(info["seed_color"])
+            seed_count = int(info["seed_count"])
+            for step in range(1, seed_count + 1):
+                rr = gr + dr * step
+                cc = gc + dc * step
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = seed_color
