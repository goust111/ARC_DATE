+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+PALETTE = tuple(range(10))
+
