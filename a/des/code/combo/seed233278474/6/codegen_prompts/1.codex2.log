+            out[r, c] = fence_color
+        for r, c in item["seed_cells"]:
+            inp[r, c] = seed_color
+            out[r, c] = seed_color
+        for r, c in item["ray_cells"]:
+            out[r, c] = seed_color
+    return inp, out
