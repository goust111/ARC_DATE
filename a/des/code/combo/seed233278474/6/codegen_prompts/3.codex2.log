+    if quadrant == "lu":
+        return np.flipud(mask).copy()
+    if quadrant == "ld":
+        return np.rot90(mask, 2).copy()
+    assert quadrant == "rd"
+    return mask.copy()
+
+
+def _quadrant_from_marker(marker: tuple[int, int], center_r: float, center_c: float) -> str:
+    mr, mc = marker
+    if mr < center_r and mc > center_c:
