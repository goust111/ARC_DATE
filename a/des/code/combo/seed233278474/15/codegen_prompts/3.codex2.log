+def _random_shape() -> np.ndarray:
+    kind = random.choice(("rect", "line", "l", "blob"))
+    if kind == "rect":
+        return np.ones((random.randint(1, 3), random.randint(1, 4)), dtype=bool)
+    if kind == "line":
