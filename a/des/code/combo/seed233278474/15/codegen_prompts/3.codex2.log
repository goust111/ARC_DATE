+        left = random.randint(0, width - sw)
+        if not _can_place(shape, occupied, top, left):
+            continue
+
+        color = random.choice(palette)
+        region = pattern[top : top + sh, left : left + sw]
+        region[shape] = color
+        occupied[top : top + sh, left : left + sw] |= shape
+        placed += 1
+
