+
+BACKGROUND = 0
+BLUE = 1
+GREEN = 3
+MARKER_COLORS = (BLUE, GREEN)
+PATTERN_COLORS = (2, 4, 5, 6, 7, 8, 9)
+
+# Generator configuration.
+PATTERN_HEIGHT_RANGE = (7, 15)
+PATTERN_WIDTH_RANGE = (7, 15)
