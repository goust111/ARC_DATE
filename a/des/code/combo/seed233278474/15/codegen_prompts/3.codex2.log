+def _merge_source_onto_target(target: np.ndarray, source: np.ndarray) -> int:
+    fill_mask = (target == BACKGROUND) & (source != BACKGROUND)
+    target[fill_mask] = source[fill_mask]
+    return int(fill_mask.sum())
+
