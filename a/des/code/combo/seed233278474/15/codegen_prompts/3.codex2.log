+            frontier.remove((r, c))
+            if not frontier:
+                break
+            continue
+        choice = random.choice(neighbors)
+        cells.add(choice)
+        frontier.add(choice)
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
