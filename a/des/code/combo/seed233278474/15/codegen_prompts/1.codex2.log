+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(coords)
+    return components
+
+
+def _single_gap(edge: np.ndarray) -> tuple[int, int] | None | bool:
+    inner = ~edge[1:-1]
+    gap_idx = np.flatnonzero(inner)
+    if gap_idx.size == 0:
+        return None
+    if int(gap_idx[-1]) - int(gap_idx[0]) + 1 != int(gap_idx.size):
+        return False
+    return int(gap_idx[0]) + 1, int(gap_idx.size)
+
+
+def _enclosed_mask(component_mask: np.ndarray) -> np.ndarray:
+    h, w = component_mask.shape
+    open_cells = ~component_mask
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if open_cells[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if open_cells[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if open_cells[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    return open_cells & ~outside
