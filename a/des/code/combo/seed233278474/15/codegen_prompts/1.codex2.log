+
+def _bar_candidates(inside: np.ndarray) -> tuple[list[tuple[int, int, int]], list[tuple[int, int, int]]]:
+    h, w = inside.shape
+    horizontal: list[tuple[int, int, int]] = []
+    vertical: list[tuple[int, int, int]] = []
