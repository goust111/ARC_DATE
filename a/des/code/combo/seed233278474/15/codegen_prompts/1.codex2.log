+        if not np.all(component_mask[start - 1 : start + length + 1, 1]):
+            return None
+    else:
+        if w < 3 or start < 2 or start + length > h - 3:
+            return None
+        if not np.all(component_mask[start - 1 : start + length + 1, -2]):
+            return None
