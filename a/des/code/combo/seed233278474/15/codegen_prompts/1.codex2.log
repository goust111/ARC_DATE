+def _make_key_patch(
+    h: int, w: int, signature: tuple[str, int, int], key_color: int, rng: random.Random
+) -> tuple[np.ndarray, np.ndarray]:
+    mask = _frame_mask(h, w, signature)
+    inside = _enclosed_mask(mask)
