+def _notch_signature(component_mask: np.ndarray) -> tuple[str, int, int] | None:
+    h, w = component_mask.shape
+    if h < 4 or w < 4:
+        return None
+    if not (
+        component_mask[0, 0]
+        and component_mask[0, -1]
+        and component_mask[-1, 0]
+        and component_mask[-1, -1]
