+    ph, pw = patch_shape
+    locations: list[tuple[int, int]] = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            rs = max(0, r0 - padding)
+            re = min(h, r0 + ph + padding)
+            cs = max(0, c0 - padding)
+            ce = min(w, c0 + pw + padding)
+            if not occupied[rs:re, cs:ce].any():
