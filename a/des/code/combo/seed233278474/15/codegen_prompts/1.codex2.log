+def _is_bar(coords: np.ndarray) -> bool:
+    if coords.shape[0] < 2:
+        return False
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    if np.all(rows == rows[0]):
+        ordered = np.sort(cols)
+        return int(ordered[-1]) - int(ordered[0]) + 1 == int(coords.shape[0])
+    if np.all(cols == cols[0]):
+        ordered = np.sort(rows)
+        return int(ordered[-1]) - int(ordered[0]) + 1 == int(coords.shape[0])
+    return False
