+                r += 1
+            start = r
+            while r < h and inside[r, c]:
+                r += 1
+            run_len = r - start
+            if run_len >= 2:
+                max_len = min(run_len, 4)
+                for length in range(2, max_len + 1):
+                    for seg_start in range(start, r - length + 1):
+                        vertical.append((seg_start, c, length))
+
+    return horizontal, vertical
+
