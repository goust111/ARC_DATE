+        "bottom": component_mask[-1, :],
+        "left": component_mask[:, 0],
+        "right": component_mask[:, -1],
+    }
+    candidates: list[tuple[str, int, int]] = []
+    for side, edge in edges.items():
+        gap = _single_gap(edge)
+        if gap is False:
+            return None
+        if gap is not None:
+            candidates.append((side, gap[0], gap[1]))
+    if len(candidates) != 1:
