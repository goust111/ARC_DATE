+
+    key_by_signature: dict[tuple[str, int, int], int] = {}
+    locks: list[dict[str, object]] = []
+    for info in frames:
+        signature = info["signature"]
+        payload_color = info["payload_color"]
+        if payload_color is None:
+            locks.append(info)
+        else:
