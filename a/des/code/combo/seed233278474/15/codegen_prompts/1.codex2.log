+def _frame_mask(h: int, w: int, signature: tuple[str, int, int]) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
