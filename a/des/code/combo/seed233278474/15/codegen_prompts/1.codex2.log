+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    pair_count = rng.randint(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1])
+    (h_range, w_range) = GRID_RANGES[pair_count]
