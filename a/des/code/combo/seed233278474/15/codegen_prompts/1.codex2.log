+
+# --------------- generator ---------------
+
+BG_COLOR = 0
+FRAME_COLOR = 5
+GRID_RANGES = {
+    2: ((18, 24), (20, 28)),
+    3: ((22, 28), (24, 32)),
+    4: ((26, 32), (28, 36)),
+}
+PAIR_COUNT_RANGE = (2, 4)
+FRAME_H_RANGE = (6, 9)
+FRAME_W_RANGE = (7, 11)
