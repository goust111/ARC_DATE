+    for r in range(h):
+        for c in (0, w - 1):
+            if open_cells[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if open_cells[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
