+def _lock_patches(
+    h: int, w: int, signature: tuple[str, int, int], key_color: int
+) -> tuple[np.ndarray, np.ndarray]:
+    mask = _frame_mask(h, w, signature)
+    inside = _enclosed_mask(mask)
+    inp = np.full((h, w), BG_COLOR, dtype=int)
+    inp[mask] = FRAME_COLOR
