+        if direction in ("left", "right") and h % 2 == 0:
+            continue
+        if np.array_equal(local, _stamp_mask(h, w, direction)):
+            candidates.append(direction)
+
+    assert len(candidates) == 1
+    direction = candidates[0]
+    return {
+        "color": color,
+        "h": h,
+        "w": w,
+        "area": h * w,
+        "direction": direction,
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+    }
+
