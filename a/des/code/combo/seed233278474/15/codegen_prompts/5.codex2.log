+def _extract_stamps(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    comps = _components(g != BG)
+    stamps = [_parse_stamp(g, comp) for comp in comps]
+    assert stamps
+    return stamps
+
+
+def _sort_group(group: list[dict]) -> list[dict]:
+    return sorted(
