+    if sum(room["seed"] is not None for room in found) != len(plans):
+        return None
+
+    expected = _expected_output(grid, plans)
+    actual = main(grid)
+    if np.array_equal(actual, grid):
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
