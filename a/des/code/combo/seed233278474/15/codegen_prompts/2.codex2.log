+
+def _search_rectangle(first: Piece, second: Piece, axis: str) -> np.ndarray | None:
+    if axis == "H":
+        limit = first.shape[1] + second.shape[1] + 2
+        for dc in range(1, limit + 1):
+            rect = _render_rectangle_if_valid(first, second, 0, dc)
+            if rect is not None:
