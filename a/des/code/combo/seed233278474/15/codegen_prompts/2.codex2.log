+def _match_one_side(left: list[Piece], right: list[Piece]) -> list[tuple[Piece, Piece, np.ndarray]]:
+    assert len(left) == len(right)
+    if not left:
+        return []
+
+    left = sorted(left, key=lambda p: p.pos_key)
+    right = sorted(right, key=lambda p: p.pos_key)
