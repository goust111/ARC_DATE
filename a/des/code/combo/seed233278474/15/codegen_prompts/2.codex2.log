+        left[split:, :cut] = True
+        right[:split, w - cut :] = True
+        right[split:, :] = True
+
+        assembled[:split, :w] = 0
+        assembled[split:, :cut] = 0
+        assembled[:split, w:] = 1
+        assembled[split:, cut:] = 1
