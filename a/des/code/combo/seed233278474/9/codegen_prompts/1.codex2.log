 231: def _gen_attempt():
 232:     sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
 233:     colors = list(AVAILABLE_COLORS)
 234:     random.shuffle(colors)
 235:     src1, halo1, src2, halo2 = colors[:4]
