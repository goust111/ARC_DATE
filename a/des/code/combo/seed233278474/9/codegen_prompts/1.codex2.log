 143: def _neighbors4(r: int, c: int, h: int, w: int):
 144:     if r > 0:
 145:         yield r - 1, c
 146:     if r + 1 < h:
 147:         yield r + 1, c
 148:     if c > 0:
 149:         yield r, c - 1
 150:     if c + 1 < w:
 151:         yield r, c + 1
