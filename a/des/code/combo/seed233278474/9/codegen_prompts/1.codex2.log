 242:     n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)
 243:     n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)
 244:     tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2
 245:     random.shuffle(tasks)
 246: 
 247:     grid = np.zeros((sz, sz), dtype=int)
 248:     legend_box = _draw_legend(grid, src1, halo1, src2, halo2)
