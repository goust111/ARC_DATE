 101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:
 102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)
 103:     return [
 104:         tuple(int(x) for x in lengths)
 105:         for lengths in product(length_range, repeat=int(n_runs))
 106:         if sum(lengths) == int(width)
 107:     ]
