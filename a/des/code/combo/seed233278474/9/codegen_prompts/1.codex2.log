 206: def _gen_render_pair(tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions):
 207:     expected = _gen_base_grid(tile_rows, tile_cols, tile_size, bg, separator)
 208:     for pos in [source_pos, *marked_positions]:
 209:         _gen_paste_tile(expected, pos, sprite_tile, tile_size)
 210: 
 211:     inp = expected.copy()
 212:     marker_tile = np.full((tile_size, tile_size), bg, dtype=int)
 213:     marker_tile[tile_size // 2, tile_size // 2] = separator
 214:     for pos in marked_positions:
 215:         _gen_paste_tile(inp, pos, marker_tile, tile_size)
