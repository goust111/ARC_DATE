 121: def main(grid: np.ndarray) -> np.ndarray:
 122:     """
 123:     Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.
 124: 
 125:     Input structure:
 126:     - A dominant background contains one full-width or full-height one-pixel
 127:       separator line in a non-background color.
 128:     - One other foreground color forms solid rectangular objects, all strictly on the same side of that separator.
 129:     - Remaining non-background pixels are scattered distractors.
 130: 
 131:     Rule:
 132:     - Keep the input grid shape and unchanged pixels outside each affected corridor.
 133:     - Mirror each source object across the separator line.
 134:     - For every source object, recolor the rectangular strip between the
 135:       original object and its reflection to the separator color, then paint the
 136:       reflected object in the source color.
 137: 
 138:     Key insight:
 139:     - The full straight line is a mirror axis; the real objects are identified
 140:       structurally as the only solid rectangles confined to one side, while
 141:       scattered pixels are noise that may be overwritten inside the corridor.
 142:     """
 143:     g = np.asarray(grid, dtype=int)
 144:     bg = get_bg(g)
 145:     orient, axis, axis_color = _find_separator(g, bg)
 146:     source_color, components = _find_source(g, bg, orient, axis, axis_color)
 147: 
 148:     out = g.copy()
 149:     for component in components:
 150:         _mirror_and_connect(out, component, orient, axis, axis_color, source_color)
 151:     return out
 152: 
 153: # --------------- generator (att2, o5x) ---------------
 154: 
 155: # Canvas and palette.
 156: GRID_SIZE_RANGE = (18, 23)
 157: COLOR_COUNT = 10
 158: PALETTE_SIZE = 4
 159: ORIENTATIONS = ("vertical", "horizontal")
 160: AXIS_RATIO_RANGE = (0.35, 0.50)
 161: SIDES = (-1, 1)
 162: 
 163: # Source rectangles and reflected corridors.
 164: SOURCE_RECT_COUNT_RANGE = (2, 3)
 165: RECT_HEIGHT_RANGE = (2, 5)
 166: RECT_WIDTH_RANGE = (2, 4)
 167: SOURCE_GAP_TO_AXIS_RANGE = (2, 5)
 168: MIN_RECT_INTERVAL_GAP = 1
 169: 
 170: # Distractor scatter.
 171: DISTRACTOR_DENSITY_RANGE = (0.03, 0.10)
 172: MAX_DISTRACTOR_CLUSTERS = 4
 173: DISTRACTOR_CLUSTER_TARGET_DIVISOR = 12
 174: FORCE_CLUSTER_PROB = 0.70
 175: DISTRACTOR_CLUSTER_SHAPES = (
 176:     ((0, 0), (0, 1)),
 177:     ((0, 0), (1, 0)),
 178:     ((0, 0), (0, 1), (0, 2)),
 179:     ((0, 0), (1, 0), (2, 0)),
 180:     ((0, 0), (1, 0), (0, 1)),
 181:     ((0, 0), (1, 0), (1, 1)),
 182:     ((0, 0), (0, 1), (1, 1)),
 183:     ((1, 0), (0, 1), (1, 1)),
 184: )
 185: 
 186: # Retry budget.
 187: GENERATION_ATTEMPTS = 300
 188: 
 189: 
 190: def _composition(total: int, parts: int) -> list[int]:
 191:     if total <= 0:
 192:         return [0] * parts
 193:     return list(np.random.multinomial(int(total), [1.0 / parts] * parts))
 194: 
 195: 
 196: def _pack_intervals(length: int, sizes: list[int], *, min_gap: int) -> list[tuple[int, int]] | None:
 197:     extra = int(length) - sum(sizes) - int(min_gap) * (len(sizes) - 1)
 198:     if extra < 0:
 199:         return None
 200:     gaps = _composition(extra, len(sizes) + 1)
 201:     intervals: list[tuple[int, int]] = []
 202:     pos = gaps[0]
 203:     for i, size in enumerate(sizes):
 204:         intervals.append((pos, pos + int(size) - 1))
 205:         pos += int(size)
 206:         if i + 1 < len(sizes):
 207:             pos += int(min_gap) + gaps[i + 1]
 208:     return intervals
 209: 
 210: 
 211: def _axis_candidates(length: int) -> list[int]:
 212:     min_ratio, max_ratio = AXIS_RATIO_RANGE
 213:     return [
 214:         i
 215:         for i in range(1, int(length) - 1)
 216:         if min_ratio <= min(i, int(length) - 1 - i) / float(length) <= max_ratio
 217:     ]
 218: 
 219: 
 220: def _size_gap_pairs(size_range: tuple[int, int], min_space: int) -> list[tuple[int, int]]:
 221:     return [
 222:         (size, gap)
 223:         for size in range(size_range[0], size_range[1] + 1)
 224:         for gap in range(SOURCE_GAP_TO_AXIS_RANGE[0], SOURCE_GAP_TO_AXIS_RANGE[1] + 1)
 225:         if size + gap <= min_space
 226:     ]
 227: 
 228: 
 229: def _side_span(axis: int, length: int, size: int, gap: int, side: int) -> tuple[int, int] | None:
 230:     if side < 0:
 231:         end = int(axis) - int(gap) - 1
 232:         start = end - int(size) + 1
 233:     else:
 234:         start = int(axis) + int(gap) + 1
 235:         end = start + int(size) - 1
 236:     if 0 <= start <= end < int(length):
 237:         return start, end
 238:     return None
 239: 
 240: 
 241: def _mirror_span(axis: int, start: int, end: int) -> tuple[int, int]:
 242:     a = int(axis)
 243:     return tuple(sorted((2 * a - int(start), 2 * a - int(end))))
 244: 
 245: 
 246: def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
 247:     return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
 248: 
 249: 
 250: def _paint_reflected_pair(
 251:     out: np.ndarray,
 252:     affected: np.ndarray,
 253:     source_mask: np.ndarray,
 254:     *,
 255:     src: int,
 256:     sep: int,
 257:     rect: tuple[int, int, int, int],
 258:     mirror: tuple[int, int, int, int],
 259:     corridor: tuple[int, int, int, int],
 260: ) -> None:
 261:     """Paint one source rectangle, its mirror, and the separator-colored corridor."""
 262:     r0, r1, c0, c1 = rect
 263:     mr0, mr1, mc0, mc1 = mirror
 264:     fr0, fr1, fc0, fc1 = corridor
 265:     patch = np.full((r1 - r0 + 1, c1 - c0 + 1), src, dtype=int)
 266:     out[fr0 : fr1 + 1, fc0 : fc1 + 1] = sep
 267:     paste(out, patch, r0, c0)
 268:     paste(out, patch, mr0, mc0)
 269:     affected[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
 270:     affected[mr0 : mr1 + 1, mc0 : mc1 + 1] = True
 271:     source_mask[r0 : r1 + 1, c0 : c1 + 1] = True
 272: 
 273: 
 274: def _place_rectangles(
 275:     out: np.ndarray, affected: np.ndarray, source_mask: np.ndarray, *, orient: str, axis: int, side: int, count: int, src: int, sep: int
 276: ) -> bool:
 277:     """Choose source rectangles and paint their output-side reflections."""
 278:     H, W = out.shape
 279:     if orient == "vertical":
 280:         cross_len, axis_len = H, W
 281:         cross_sizes = [random.randint(*RECT_HEIGHT_RANGE) for _ in range(count)]
 282:         axis_size_range = RECT_WIDTH_RANGE
 283:     else:
 284:         cross_len, axis_len = W, H
 285:         cross_sizes = [random.randint(*RECT_WIDTH_RANGE) for _ in range(count)]
 286:         axis_size_range = RECT_HEIGHT_RANGE
 287: 
 288:     intervals = _pack_intervals(cross_len, cross_sizes, min_gap=MIN_RECT_INTERVAL_GAP)
 289:     pairs = _size_gap_pairs(axis_size_range, min(axis, axis_len - 1 - axis))
 290:     if intervals is None or not pairs:
 291:         return False
 292: 
 293:     for p0, p1 in intervals:
 294:         size, gap = random.choice(pairs)
 295:         span = _side_span(axis, axis_len, size, gap, side)
 296:         if span is None:
 297:             return False
 298:         s0, s1 = span
 299:         ms0, ms1 = _mirror_span(axis, s0, s1)
 300:         if not (0 <= ms0 <= ms1 < axis_len):
 301:             return False
 302:         fill0, fill1 = (s1 + 1, ms0 - 1) if s1 < ms0 else (ms1 + 1, s0 - 1)
 303:         if orient == "vertical":
 304:             rect = (p0, p1, s0, s1)
 305:             mirror = (p0, p1, ms0, ms1)
 306:             corridor = (p0, p1, fill0, fill1)
 307:         else:
 308:             rect = (s0, s1, p0, p1)
 309:             mirror = (ms0, ms1, p0, p1)
 310:             corridor = (fill0, fill1, p0, p1)
 311:         _paint_reflected_pair(
 312:             out, affected, source_mask, src=src, sep=sep, rect=rect, mirror=mirror, corridor=corridor
 313:         )
 314:     return True
 315: 
 316: def _sample_scene_config() -> tuple[int, int, int, int, int, int, str, int, int, int] | None:
 317:     """Sample high-level scene choices before any geometry-specific drawing."""
 318:     H = random.randint(*GRID_SIZE_RANGE)
 319:     W = random.randint(*GRID_SIZE_RANGE)
 320:     bg, sep, src, dist = random.sample(range(COLOR_COUNT), PALETTE_SIZE)
 321:     orient = random.choice(ORIENTATIONS)
 322:     axis_len = W if orient == "vertical" else H
 323:     axes = _axis_candidates(axis_len)
 324:     if not axes:
 325:         return None
 326:     axis = random.choice(axes)
 327:     side = random.choice(SIDES)
 328:     count = random.randint(*SOURCE_RECT_COUNT_RANGE)
 329:     return H, W, bg, sep, src, dist, orient, axis, side, count
 330: 
 331: 
 332: def _can_add_cells(cells: tuple[tuple[int, int], ...], allowed: np.ndarray, occupied: set[tuple[int, int]]) -> bool:
 333:     H, W = allowed.shape
 334:     cell_set = set(cells)
 335:     for r, c in cells:
 336:         if not (0 <= r < H and 0 <= c < W and allowed[r, c]) or (r, c) in occupied:
 337:             return False
 338:         for nr, nc in _neighbors4(r, c):
 339:             if (nr, nc) in occupied and (nr, nc) not in cell_set:
 340:                 return False
 341:     return True
