 182:             pbox = _padded_bbox(visible_box, size)
 183:             if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or
 184:                     any(_boxes_overlap(pbox, eb) for eb in placed)):
 185:                 continue
 186: 
 187:             placed.append(pbox)
 188:             placements.append((sprite, sc, hc, r0, c0))
 189:             break
 190:         else:
 191:             return None
 192:     return placements
