 280: def _compute_offsets(G, n, num_coarse):
 281:     if num_coarse == 1:
 282:         return [1]
 283:     first = 1
 284:     last = G - n - 1
 285:     if last < first:
 286:         return None
 287:     step = (last - first) / (num_coarse - 1)
 288:     return [int(round(first + i * step)) for i in range(num_coarse)]
 289: 
