 195: def _render_output(grid, placements):
 196:     """Render the paired output and return the generated input with halo-fill cells removed."""
 197:     size = grid.shape[0]
 198:     output = grid.copy()
 199:     halo_mask = np.zeros((size, size), dtype=bool)
 200: 
 201:     for sprite, sc, hc, r0, c0 in placements:
 202:         visible_box, visible = _visible_window(sprite, size, r0, c0)
 203:         vr0, vc0, vr1, vc1 = visible_box
 204:         output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]
 205:         output_region[visible != BACKGROUND] = sc
 206: 
 207:         pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)
 208:         patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)
 209:         patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]
 210:         patch_region[visible != BACKGROUND] = sc
 211: 
 212:         enclosed = object_interior(patch, background=BACKGROUND)
 213:         fill = (patch == BACKGROUND) & ~enclosed
 214:         output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]
 215:         output_region[fill] = hc
 216:         halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]
 217:         halo_region[fill] = True
 218: 
 219:     inp = output.copy()
 220:     inp[halo_mask] = BACKGROUND
 221:     return inp, output
