 291: def _gen_attempt():
 292:     reached = random.random() < 0.5
 293:     n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])
 294: 
 295:     min_size = max(10, 5 * n)
 296:     if min_size > 20:
 297:         return None
 298:     G = random.randint(min_size, 20)
 299:     H = W = G
 300: 
 301:     min_spacing = n + 1
 302:     max_coarse = max(3, (G - 2) // min_spacing)
 303:     coarse_dim = random.randint(3, min(6, max_coarse))
 304:     coarse_rows = coarse_cols = coarse_dim
 305: 
 306:     offsets_r = _compute_offsets(G, n, coarse_rows)
 307:     offsets_c = _compute_offsets(G, n, coarse_cols)
 308:     if offsets_r is None or offsets_c is None:
 309:         return None
 310:     for i in range(len(offsets_r) - 1):
 311:         if offsets_r[i + 1] - offsets_r[i] < n:
 312:             return None
 313:     for i in range(len(offsets_c) - 1):
 314:         if offsets_c[i + 1] - offsets_c[i] < n:
 315:             return None
 316: 
 317:     edge_cells = set()
 318:     for c in range(coarse_cols):
 319:         edge_cells.add((0, c))
 320:         edge_cells.add((coarse_rows - 1, c))
 321:     for r in range(1, coarse_rows - 1):
 322:         edge_cells.add((r, 0))
 323:         edge_cells.add((r, coarse_cols - 1))
 324:     edge_cells = list(edge_cells)
 325:     random.shuffle(edge_cells)
 326:     start_coarse = edge_cells[0]
 327:     far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
 328:     end_coarse = far[0] if far[0] != start_coarse else far[1]
 329: 
 330:     walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
 331:     if walk is None or len(walk) < 4:
 332:         return None
 333:     if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:
 334:         return None
 335: 
 336:     grid = np.full((H, W), _BG, dtype=int)
 337:     pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
 338: 
 339:     mask = (grid != _BG)
 340:     if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
 341:         return None
 342: 
 343:     mover_r, mover_c = pixel_pos[0]
 344:     dest_r, dest_c = pixel_pos[-1]
 345: 
 346:     # Extend dest to touch grid edge
 347:     def _extend_to_edge(pr, pc):
 348:         candidates = []
 349:         for direction in ['top', 'bottom', 'left', 'right']:
 350:             if direction == 'top':
 351:                 dist = pr
 352:                 if dist == 0:
 353:                     candidates.append((0, pc, 0))
 354:                     continue
 355:                 if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
 356:                     candidates.append((0, pc, dist))
 357:             elif direction == 'bottom':
 358:                 dist = H - (pr + n)
 359:                 if dist == 0:
 360:                     candidates.append((pr, pc, 0))
 361:                     continue
 362:                 if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):
 363:                     candidates.append((H - n, pc, dist))
 364:             elif direction == 'left':
 365:                 dist = pc
 366:                 if dist == 0:
 367:                     candidates.append((pr, 0, 0))
 368:                     continue
 369:                 if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
 370:                     candidates.append((pr, 0, dist))
 371:             elif direction == 'right':
 372:                 dist = W - (pc + n)
 373:                 if dist == 0:
 374:                     candidates.append((pr, pc, 0))
 375:                     continue
 376:                 if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):
 377:                     candidates.append((pr, W - n, dist))
 378:         if not candidates:
 379:             return None
 380:         candidates.sort(key=lambda x: x[2])
 381:         return candidates[0][:2]
 382: 
 383:     result = _extend_to_edge(dest_r, dest_c)
 384:     if result is None:
 385:         return None
 386:     new_dest_r, new_dest_c = result
 387:     if new_dest_r != dest_r:
 388:         r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
 389:         grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER
 390:     if new_dest_c != dest_c:
 391:         c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
 392:         grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER
 393:     dest_r, dest_c = new_dest_r, new_dest_c
 394:     if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
 395:         return None
 396: 
 397:     # Mover: near edge but not touching
 398:     touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)
 399:     if touching:
 400:         if mover_r == 0:
 401:             grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1
 402:         elif mover_r + n == H:
 403:             grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1
 404:         elif mover_c == 0:
 405:             grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1
 406:         elif mover_c + n == W:
 407:             grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1
 408:     if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
 409:         return None
 410:     if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
 411:         return None
 412: 
 413:     grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER
 414:     grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER
 415: 
 416:     # Chokepoints for stuck case
 417:     if not reached and n >= 2:
 418:         num_choke = random.randint(1, min(3, len(walk) - 2))
 419:         min_seg = max(1, len(walk) // 4)
 420:         available = list(range(min_seg, len(walk) - 1))
 421:         random.shuffle(available)
 422:         for seg_idx in available[:num_choke]:
 423:             pr1, pc1 = pixel_pos[seg_idx]
 424:             pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
 425:             direction = 'h' if pr1 == pr2 else 'v'
 426:             _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
 427:         if not _river_connected(grid):
 428:             return None
 429: 
 430:     grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER
 431:     grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST
 432: 
 433:     trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
 434:     h2, w2 = H - n + 1, W - n + 1
 435:     feasible = np.zeros((h2, w2), dtype=bool)
 436:     for r in range(h2):
 437:         for c in range(w2):
 438:             if trav[r:r + n, c:c + n].all():
 439:                 feasible[r, c] = True
 440:     if not feasible[mover_r, mover_c]:
 441:         return None
 442: 
 443:     dist = _bfs_placement(feasible, mover_r, mover_c)
 444:     dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and
 445:                feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)
 446:     if reached and not dest_ok:
 447:         return None
 448:     if not reached and dest_ok:
 449:         return None
 450: 
 451:     if dest_ok:
 452:         tr, tc = dest_r, dest_c
 453:     else:
 454:         best_d = -1
 455:         tr, tc = mover_r, mover_c
 456:         for r in range(h2):
 457:             for c in range(w2):
 458:                 if dist[r, c] > best_d:
 459:                     best_d = dist[r, c]
 460:                     tr, tc = r, c
 461: 
 462:     output = grid.copy()
 463:     output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER
 464:     output[tr:tr + n, tc:tc + n] = _MOVER
 465: 
 466:     if not np.array_equal(main(grid), output):
 467:         return None
 468:     return grid
 469: 
