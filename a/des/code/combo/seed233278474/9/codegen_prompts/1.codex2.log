 231:     tile_positions = [(r, c) for r in range(tile_rows) for c in range(tile_cols)]
 232:     source_pos = random.choice(tile_positions)
 233:     marker_count = random.randint(*MARKER_COUNT_RANGE)
 234:     marked_positions = random.sample([pos for pos in tile_positions if pos != source_pos], marker_count)
 235:     inp, expected = _gen_render_pair(
 236:         tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions
