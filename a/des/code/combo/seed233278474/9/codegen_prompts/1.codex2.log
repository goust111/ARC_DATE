 272: def _river_connected(grid):
 273:     mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
 274:     if not mask.any():
 275:         return False
 276:     labeled, num = scipy_label(mask.astype(int))
 277:     return num == 1
