 149: def _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:
 150:     pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])
 151:     component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))
 152:     labels = np.zeros((size, size), dtype=int)
 153:     for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):
 154:         seed_candidates = [
 155:             (r, c)
 156:             for r in range(size)
 157:             for c in range(size)
 158:             if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)
 159:         ]
 160:         if not seed_candidates:
 161:             return None
 162: 
 163:         seed = random.choice(seed_candidates)
 164:         labels[seed] = label
 165:         cells = [seed]
 166:         while len(cells) < component_size:
 167:             growth = []
 168:             for r, c in cells:
 169:                 for rr, cc in _gen_neighbors4(r, c, size):
 170:                     if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):
 171:                         growth.append((rr, cc))
 172:             if not growth:
 173:                 return None
 174:             cell = random.choice(growth)
 175:             labels[cell] = label
 176:             cells.append(cell)
 177: 
 178:     tile = np.full((size, size), bg, dtype=int)
 179:     tile[labels > 0] = sprite_color
 180:     tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))
 181:     if random.random() < FLIP_PROBABILITY:
 182:         tile = np.fliplr(tile)
 183:     if random.random() < FLIP_PROBABILITY:
 184:         tile = np.flipud(tile)
 185:     return tile.copy()
