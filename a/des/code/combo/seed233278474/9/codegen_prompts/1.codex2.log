 212: def _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):
 213:     H, W = grid.shape
 214:     pr1, pc1 = pixel_pos_i
 215:     pr2, pc2 = pixel_pos_j
 216:     narrow_w = random.randint(1, n - 1)
 217:     remove = n - narrow_w
 218:     side = random.randint(0, 1)
 219: 
 220:     if direction == 'h':
 221:         c_lo = min(pc1, pc2) + n
 222:         c_hi = max(pc1, pc2)
 223:         if c_hi <= c_lo:
 224:             c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
 225:         hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
 226:         if hold_len < 1:
 227:             hold_len = 1
 228:         total_len = 2 * remove + hold_len
 229:         c_mid = (c_lo + c_hi) // 2
 230:         c_start = max(c_lo, c_mid - total_len // 2)
 231:         for step in range(total_len):
 232:             c = c_start + step
 233:             if c < 0 or c >= W:
 234:                 continue
 235:             if step < remove:
 236:                 depth = step + 1
 237:             elif step >= total_len - remove:
 238:                 depth = total_len - step
 239:             else:
 240:                 depth = remove
 241:             for k in range(depth):
 242:                 rr = pr1 + k if side == 0 else pr1 + n - 1 - k
 243:                 if 0 <= rr < H and 0 <= c < W:
 244:                     grid[rr, c] = _BG
 245:     else:
 246:         r_lo = min(pr1, pr2) + n
 247:         r_hi = max(pr1, pr2)
 248:         if r_hi <= r_lo:
 249:             r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
 250:         hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
 251:         if hold_len < 1:
 252:             hold_len = 1
 253:         total_len = 2 * remove + hold_len
 254:         r_mid = (r_lo + r_hi) // 2
 255:         r_start = max(r_lo, r_mid - total_len // 2)
 256:         for step in range(total_len):
 257:             r = r_start + step
 258:             if r < 0 or r >= H:
 259:                 continue
 260:             if step < remove:
 261:                 depth = step + 1
 262:             elif step >= total_len - remove:
 263:                 depth = total_len - step
 264:             else:
 265:                 depth = remove
 266:             for k in range(depth):
 267:                 cc = pc1 + k if side == 0 else pc1 + n - 1 - k
 268:                 if 0 <= r < H and 0 <= cc < W:
 269:                     grid[r, cc] = _BG
