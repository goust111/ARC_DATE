 139: def _hamiltonian_walk(rows, cols, start, end):
 140:     total = rows * cols
 141:     best_path = None
 142:     best_len = 0
 143:     for _attempt in range(80):
 144:         visited = {start}
 145:         path = [start]
 146:         cur = start
 147:         while True:
 148:             if cur == end and len(path) >= total * 0.7:
 149:                 if len(path) > best_len:
 150:                     best_path = list(path)
 151:                     best_len = len(path)
 152:                 break
 153:             neighbors = []
 154:             for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
 155:                 nr, nc = cur[0] + dr, cur[1] + dc
 156:                 if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
 157:                     neighbors.append((nr, nc))
 158:             if not neighbors:
 159:                 break
 160:             valid = []
 161:             for nb in neighbors:
 162:                 if nb == end:
 163:                     valid.append(nb)
 164:                     continue
 165:                 test_visited = visited | {nb}
 166:                 seen = {end}
 167:                 q = deque([end])
 168:                 while q:
 169:                     cr, cc = q.popleft()
 170:                     for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
 171:                         nr2, nc2 = cr + dr2, cc + dc2
 172:                         if (0 <= nr2 < rows and 0 <= nc2 < cols and
 173:                                 (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):
 174:                             seen.add((nr2, nc2))
 175:                             q.append((nr2, nc2))
 176:                 for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
 177:                     ar, ac = nb[0] + dr2, nb[1] + dc2
 178:                     if (0 <= ar < rows and 0 <= ac < cols and
 179:                             (ar, ac) not in test_visited and (ar, ac) in seen):
 180:                         valid.append(nb)
 181:                         break
 182:             if not valid:
 183:                 break
 184:             random.shuffle(valid)
 185:             nxt = valid[0]
 186:             visited.add(nxt)
 187:             path.append(nxt)
 188:             cur = nxt
 189:         if best_path and best_len >= total * 0.85:
 190:             break
 191:     return best_path
 192: 
