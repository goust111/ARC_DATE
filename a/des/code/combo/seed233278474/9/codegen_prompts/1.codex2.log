 188: def _gen_tile_origin(tile_r: int, tile_c: int, tile_size: int) -> tuple[int, int]:
 189:     return tile_r * (tile_size + SEPARATOR_WIDTH), tile_c * (tile_size + SEPARATOR_WIDTH)
