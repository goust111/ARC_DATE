 201: def _gen_paste_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_size: int) -> None:
 202:     r0, c0 = _gen_tile_origin(pos[0], pos[1], tile_size)
 203:     paste(grid, tile, r0, c0)
