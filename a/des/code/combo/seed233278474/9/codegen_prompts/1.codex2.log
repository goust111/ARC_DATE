   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Slide a solid square through a winding channel to reach a same-sized target square.
  11: 
  12:     Input structure:
  13:     - bg (most common color). A river color forms a winding corridor.
  14:     - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.
  15: 
  16:     Rule:
  17:     - The mover square travels along the river toward the destination.
  18:     - It can only pass through positions where the full NxN area is river.
  19:     - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.
  20:     - The mover's original position is filled with the river color.
  21: 
  22:     Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.
  23:     """
  24:     g = np.array(grid, dtype=int)
  25:     H, W = g.shape
  26: 
  27:     # Corner-majority background (more stable than global mode here).
  28:     bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
  29: 
  30:     # Detect solid square components (excluding bg).
  31:     squares: list[dict] = []
  32:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
  33:         col = int(comp["color"])
  34:         b = comp["bbox"]
  35:         if bbox_h(b) != bbox_w(b):
  36:             continue
  37:         patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
  38:         if not bool((patch == int(col)).all()):
  39:             continue
  40:         squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
  41: 
  42:     assert not (len(squares) < 2)
  43: 
  44:     # Choose the size that appears at least twice (most common size).
  45:     by_n: dict[int, list[dict]] = defaultdict(list)
  46:     for s in squares:
  47:         by_n[int(s["n"])].append(s)
  48:     nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
  49:     cand = by_n[int(nside)]
  50:     assert not (len(cand) < 2)
  51: 
  52:     cand.sort(key=lambda s: int(s["col"]))
  53:     mover = cand[0]
  54:     dest = cand[1]
  55: 
  56:     n = int(mover["n"])
  57:     sr, sc = int(mover["r0"]), int(mover["c0"])
  58:     dr, dc = int(dest["r0"]), int(dest["c0"])
  59: 
  60:     # River = most common remaining color (excluding bg and the two square colors).
  61:     counts = Counter(map(int, g.flatten()))
  62:     river = None
  63:     for col, _ct in counts.most_common():
  64:         if int(col) == int(bg):
  65:             continue
  66:         if int(col) in (int(mover["col"]), int(dest["col"])):
  67:             continue
  68:         river = int(col)
  69:         break
  70:     assert not (river is None)
  71: 
  72:     trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))
  73: 
  74:     # Feasible top-left placements: NxN window fully inside trav.
  75:     h2 = int(H - n + 1)
  76:     w2 = int(W - n + 1)
  77:     assert not (h2 <= 0 or w2 <= 0)
  78:     assert not (not (0 <= sr < h2 and 0 <= sc < w2))
  79: 
  80:     feasible = np.zeros((h2, w2), dtype=bool)
  81:     for r in range(h2):
  82:         for c in range(w2):
  83:             if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
  84:                 feasible[int(r), int(c)] = True
  85:     assert not (not bool(feasible[int(sr), int(sc)]))
  86: 
  87:     # BFS on placement grid.
  88:     dist = -np.ones((h2, w2), dtype=int)
  89:     q = deque([(int(sr), int(sc))])
  90:     dist[int(sr), int(sc)] = 0
  91:     DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
  92:     while q:
  93:         r, c = q.popleft()
  94:         for dr2, dc2 in DIR4:
  95:             rr = int(r + dr2)
  96:             cc = int(c + dc2)
  97:             if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
  98:                 dist[rr, cc] = int(dist[int(r), int(c)] + 1)
  99:                 q.append((int(rr), int(cc)))
 100: 
 101:     # Pick target.
 102:     if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:
 103:         tr, tc = int(dr), int(dc)
 104:     else:
 105:         best = -1
 106:         tr, tc = int(sr), int(sc)
 107:         for r in range(h2):
 108:             for c in range(w2):
 109:                 if int(dist[int(r), int(c)]) > best:
 110:                     best = int(dist[int(r), int(c)])
 111:                     tr, tc = int(r), int(c)
 112: 
 113:     out = g.copy()
 114:     out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
 115:     out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
 116:     return out
