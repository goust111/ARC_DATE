 192: def _gen_base_grid(tile_rows: int, tile_cols: int, tile_size: int, bg: int, separator: int) -> np.ndarray:
 193:     height = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH
 194:     width = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH
 195:     grid = np.full((height, width), bg, dtype=int)
 196:     grid[tile_size :: tile_size + SEPARATOR_WIDTH, :] = separator
 197:     grid[:, tile_size :: tile_size + SEPARATOR_WIDTH] = separator
 198:     return grid
 199: 
