    pts=np.argwhere(m)
    r0,c0=pts.min(0); r1,c1=pts.max(0)
    return m[r0:r1+1,c0:c1+1]

def variants(m):
    out=[]
    for k in range(4):
        a=crop(np.rot90(m,k))
        out.append(a)
        out.append(crop(np.fliplr(a)))
    uniq=[]; seen=set()
    for a in out:
        key=tuple(map(tuple,a.tolist()))
        if key not in seen:
            seen.add(key); uniq.append(a)
    return uniq

def open_side(m):
    h,w=m.shape
    rows=m.sum(1); cols=m.sum(0)
    prof={
      'up':tuple(rows[i]/w for i in range(h)),
      'down':tuple(rows[::-1][i]/w for i in range(h)),
      'left':tuple(cols[i]/h for i in range(w)),
      'right':tuple(cols[::-1][i]/h for i in range(w)),
    }
    best=min(prof,key=lambda s:prof[s])
    ties=[s for s,v in prof.items() if v==prof[best]]
    return best,ties,prof

