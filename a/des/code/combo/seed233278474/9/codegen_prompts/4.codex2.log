+    best_key = None
+    best_perm = None
+    for perm in itertools.permutations(range(n)):
+        costs = tuple(int(distances[int(perm[fi]), fi]) for fi in range(n))
+        key = (sum(costs), costs)
+        if best_key is None or key < best_key:
