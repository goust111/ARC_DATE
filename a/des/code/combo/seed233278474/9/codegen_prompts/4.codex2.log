+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    frame_count = int(rng.integers(2, 5))
+    size_ranges = {2: (18, 25), 3: (21, 28), 4: (24, 31)}
+    low, high = size_ranges[frame_count]
