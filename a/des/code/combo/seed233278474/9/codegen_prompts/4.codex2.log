+def _distance_between_sets(a: np.ndarray, b: np.ndarray) -> int:
+    best = 10**9
+    for r, c in a:
+        d = np.abs(b[:, 0] - int(r)) + np.abs(b[:, 1] - int(c))
+        cur = int(d.min())
+        if cur < best:
+            best = cur
+            if best == 0:
+                return 0
+    return int(best)
