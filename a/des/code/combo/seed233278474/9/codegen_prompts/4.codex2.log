+def _placement_for_frame(frame: dict, mask: np.ndarray) -> tuple[int, int]:
+    ir0, ic0, ir1, ic1 = frame["inner"]
+    inner_h = int(ir1 - ir0 + 1)
+    inner_w = int(ic1 - ic0 + 1)
