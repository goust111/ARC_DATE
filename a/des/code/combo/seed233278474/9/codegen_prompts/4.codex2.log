+            c0 = int(rng.integers(1, w - outer_w))
+            bbox = (int(r0), int(c0), int(r0 + outer_h - 1), int(c0 + outer_w - 1))
+            grown = _expand_box(bbox, 3)
+            if any(_boxes_overlap(grown, _expand_box(frame["bbox"], 3)) for frame in frames):
