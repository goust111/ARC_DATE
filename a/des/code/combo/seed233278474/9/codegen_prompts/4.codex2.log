+            center_c = left + (pw - 1) / 2.0
+            spread = abs(center_r - frame["center"][0]) + abs(center_c - frame["center"][1])
+            candidates.append((d0, spread, int(top), int(left)))
+    candidates.sort()
+    return candidates
