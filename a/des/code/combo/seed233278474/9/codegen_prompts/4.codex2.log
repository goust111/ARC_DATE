+        choices = option_map[idx][: min(12, len(option_map[idx]))]
+        choice = choices[int(rng.integers(len(choices)))]
+        _, _, top, left = choice
+        _paint_mask(input_grid, specs[idx]["input_mask"], top, left, specs[idx]["color"])
+        remaining.remove(idx)
+        placed_any = True
