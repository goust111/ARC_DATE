+    if frame["gap_side"] == "down":
+        return int(ir0), int(ic0 + (inner_w - w) // 2)
+    if frame["gap_side"] == "left":
+        return int(ir0 + (inner_h - h) // 2), int(ic1 - w + 1)
+    return int(ir0 + (inner_h - h) // 2), int(ic0)
