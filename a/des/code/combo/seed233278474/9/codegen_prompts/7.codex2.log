+def _fill_holes(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    def add(r: int, c: int) -> None:
+        if 0 <= r < h and 0 <= c < w and not mask[r, c] and not outside[r, c]:
+            outside[r, c] = True
+            q.append((r, c))
+
+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in N4:
+            add(r + dr, c + dc)
+
+    return mask | (~mask & ~outside)
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    sr, sc = map(int, pts[0])
+    q: deque[tuple[int, int]] = deque([(sr, sc)])
+    seen[sr, sc] = True
+    count = 0
+    while q:
+        r, c = q.popleft()
+        count += 1
+        for dr, dc in N4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return count == int(mask.sum())
+
+
+def _paste(out: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    h, w = mask.shape
+    out[r0 : r0 + h, c0 : c0 + w][mask] = int(color)
