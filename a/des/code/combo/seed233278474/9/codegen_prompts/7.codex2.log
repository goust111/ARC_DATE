+BG = 4  # yellow
+COLORS = [0, 1, 2, 3, 5, 6, 7, 8, 9]
+RNG = np.random.default_rng()
+
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+NUM_PAIRS_CHOICES = [1, 2, 3, 4]
+SOURCE_PAD = 1
+OUTPUT_PAD = 1
+PAIR_RETRIES = 300
+GEN_RETRIES = 400
