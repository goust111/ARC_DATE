+    )
+    if frozenset(pair) not in SPECIAL_MIX
+)
+
+PAIR_COUNT_CHOICES = (1, 2, 3)
+PAIR_COUNT_WEIGHTS = (3, 4, 3)
+MIN_SIDE = 16
+MAX_SIDE = 26
+MIN_HALF_DISTANCE = 3
+MAX_HALF_DISTANCE = 6
