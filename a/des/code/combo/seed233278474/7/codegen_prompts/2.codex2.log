+    pair_count = random.choices(PAIR_COUNT_CHOICES, weights=PAIR_COUNT_WEIGHTS, k=1)[0]
+    min_side = max(MIN_SIDE, 14 + 2 * pair_count)
+    h = random.randint(min_side, MAX_SIDE)
+    w = random.randint(min_side, MAX_SIDE)
