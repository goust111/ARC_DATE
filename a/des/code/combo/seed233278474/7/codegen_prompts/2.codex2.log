+        candidates = _candidate_geometries((h, w), orientation, blocked, used_horizontal_rows, used_vertical_cols)
+        if not candidates:
+            orientation = "V" if orientation == "H" else "H"
+            candidates = _candidate_geometries((h, w), orientation, blocked, used_horizontal_rows, used_vertical_cols)
+        if not candidates:
