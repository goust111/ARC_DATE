+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+CORE = 5
+RING_COLORS = (1, 2, 3, 4, 7)  # blue, red, green, yellow, orange
+DIR_TO_INDEX = {"up": 1, "right": 2, "down": 3, "left": 4}
+GEN_ATTEMPTS = 400
