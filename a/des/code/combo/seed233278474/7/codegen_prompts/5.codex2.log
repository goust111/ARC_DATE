+    max_w = max(block.shape[1] for block in blocks)
+    area = sum((mask.shape[0] + 2) * (mask.shape[1] + 2) for mask in block_masks)
+    side = max(max_h + 2, max_w + 2, int(np.ceil(np.sqrt(area * 1.6))))
