from __future__ import annotations

from collections import deque
import random

import numpy as np


BG = 0
GREEN = 3
GREY = 5
ORANGE = 7
PAYLOAD_COLORS = (1, 2, 4, 6, 8, 9)
DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
MAX_GEN_ATTEMPTS = 400


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts: list[tuple[int, int]] = []
            while q:
                cr, cc = q.popleft()
                pts.append((cr, cc))
                for dr, dc in DIRS:
                    nr, nc = cr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(pts)
    return comps


def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _frame_from_component(
    grid: np.ndarray, coords: list[tuple[int, int]], color: int
) -> dict[str, object] | None:
    r0, c0, r1, c1 = _bbox(coords)
    h, w = r1 - r0 + 1, c1 - c0 + 1
    if h < 5 or w < 5:
        return None
    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
    border = np.zeros((h, w), dtype=bool)
    border[0, :] = True
    border[-1, :] = True
    border[:, 0] = True
    border[:, -1] = True
    if len(coords) != int(border.sum()):
        return None
    if not np.all(patch[border] == color):
        return None
    if np.any(patch[~border] == color):
        return None
    return {"bbox": (r0, c0, r1, c1)}


def _find_frames(grid: np.ndarray, color: int) -> list[dict[str, object]]:
    frames = []
    for comp in _components(grid == color):
        frame = _frame_from_component(grid, comp, color)
        if frame is not None:
