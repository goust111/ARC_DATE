+        dep = next(iter(source_dirs[source_id]))
+        arr = next(iter(mold_dirs[mold_id]))
+        pairs.append({"source": source_id, "mold": mold_id, "rotation": (arr - dep) % 4})
+        used_sources.add(source_id)
+        used_molds.add(mold_id)
