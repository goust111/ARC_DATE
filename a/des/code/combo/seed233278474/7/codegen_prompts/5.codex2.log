+            patch[mask] = block[mask]
+            occupied[r0 : r0 + bh, c0 : c0 + bw] |= mask
+
+        if placed:
+            return grid
+    return None
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    pair_count = rng.randint(1, 3)
+    blocks = [_build_pair_block(rng) for _ in range(pair_count)]
+    rng.shuffle(blocks)
