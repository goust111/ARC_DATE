+        if rotation == 0 and rng.random() < 0.5:
+            dirs = [dep]
+            lengths = [rng.randint(3, 7)]
+        elif rotation == 0:
+            mid = rng.choice([(dep + 1) % 4, (dep + 3) % 4])
+            dirs = [dep, mid, dep]
+            lengths = [rng.randint(2, 5), rng.randint(3, 7), rng.randint(2, 5)]
+        elif rotation in (1, 3):
