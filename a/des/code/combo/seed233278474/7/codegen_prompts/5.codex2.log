        owners[r0, c0 : c1 + 1] = idx
        owners[r1, c0 : c1 + 1] = idx
        owners[r0 : r1 + 1, c0] = idx
        owners[r0 : r1 + 1, c1] = idx
    return owners


def _pairings(
