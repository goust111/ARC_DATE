+    for pair in pairs:
+        sr0, sc0, sr1, sc1 = sources[pair["source"]]["bbox"]  # type: ignore[index]
+        mr0, mc0, mr1, mc1 = molds[pair["mold"]]["bbox"]  # type: ignore[index]
+        payload = g[sr0 + 1 : sr1, sc0 + 1 : sc1]
