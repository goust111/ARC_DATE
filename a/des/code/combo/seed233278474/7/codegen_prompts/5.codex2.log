+        mold_contacts: dict[int, set[tuple[int, int]]] = {}
+        for r, c in comp:
+            for d, (dr, dc) in enumerate(DIRS):
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w):
