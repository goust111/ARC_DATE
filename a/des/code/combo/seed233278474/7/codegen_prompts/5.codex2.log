+        h = max([shifted_source[2], shifted_mold[2], *[r for r, _ in shifted_path]]) + 1
+        w = max([shifted_source[3], shifted_mold[3], *[c for _, c in shifted_path]]) + 1
+        grid = np.zeros((h, w), dtype=int)
+
