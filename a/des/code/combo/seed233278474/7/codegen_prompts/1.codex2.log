+    else:
+        start_r = random.randint(0, h - library_span)
+        col0 = w - 3
+        for slot, idx in enumerate(library_order):
+            r0 = start_r + 4 * slot
+            patch = np.full((3, 3), placements[idx]["fill"], dtype=int)
+            patch[placements[idx]["library_mask"]] = MAROON
+            grid[r0 : r0 + 3, col0 : col0 + 3] = patch
