+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(g[r, c])
+            if color in ignored_colors:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
