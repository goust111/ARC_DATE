+            mask[arr[:, 0] - r0, arr[:, 1] - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": mask,
+                    "area": int(arr.shape[0]),
