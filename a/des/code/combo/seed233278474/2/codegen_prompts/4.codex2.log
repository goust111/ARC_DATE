+
+def _tile_pattern(tile_patch: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    th, tw = tile_patch.shape
+    hh, ww = shape
+    rows = np.arange(hh)[:, None] % th
+    cols = np.arange(ww)[None, :] % tw
