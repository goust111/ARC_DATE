+    if side == "top":
+        top = r0 - thickness
+        for idx, val in enumerate(code):
+            col = c0 + start + idx
+            bottom = r0 + val
+            coords.extend((row, col) for row in range(top, bottom + 1))
+    elif side == "bottom":
+        bottom = r1 + thickness
+        for idx, val in enumerate(code):
+            col = c0 + start + idx
+            top = r1 - val
+            coords.extend((row, col) for row in range(top, bottom + 1))
+    elif side == "left":
+        left = c0 - thickness
+        for idx, val in enumerate(code):
+            row = r0 + start + idx
+            right = c0 + val
+            coords.extend((row, col) for col in range(left, right + 1))
+    else:
+        right = c1 + thickness
+        for idx, val in enumerate(code):
+            row = r0 + start + idx
+            left = c1 - val
+            coords.extend((row, col) for col in range(left, right + 1))
