+    base_r0 = random.randint(margin, grid_h - base_h - margin)
+    base_c0 = random.randint(margin, grid_w - base_w - margin)
+    base_bbox = (base_r0, base_c0, base_r0 + base_h - 1, base_c0 + base_w - 1)
