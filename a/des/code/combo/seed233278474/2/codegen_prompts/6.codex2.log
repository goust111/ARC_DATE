+                if val == -1:
+                    mask[r0 - 1, col] = True
+                elif val == 1:
+                    mask[r0, col] = False
+        elif side == "bottom":
+            for idx, val in enumerate(code):
+                col = c0 + start + idx
+                if val == -1:
+                    mask[r1 + 1, col] = True
+                elif val == 1:
+                    mask[r1, col] = False
+        elif side == "left":
+            for idx, val in enumerate(code):
+                row = r0 + start + idx
+                if val == -1:
+                    mask[row, c0 - 1] = True
+                elif val == 1:
+                    mask[row, c0] = False
+        else:
+            for idx, val in enumerate(code):
+                row = r0 + start + idx
+                if val == -1:
+                    mask[row, c1 + 1] = True
+                elif val == 1:
