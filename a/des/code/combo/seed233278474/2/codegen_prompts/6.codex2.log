+
+
+def _final_piece_coords(spec: dict, base_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = base_bbox
+    side = spec["side"]
+    start = spec["start"]
+    code = spec["code"]
+    thickness = spec["thickness"]
+    coords: list[tuple[int, int]] = []
