+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
