+def _scatter_piece(
+    side: str,
+    rel_coords: list[tuple[int, int]],
+    shape_h: int,
+    shape_w: int,
+    grid_h: int,
+    grid_w: int,
+    obstacle_bbox: tuple[int, int, int, int],
