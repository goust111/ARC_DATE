+
+def _extract_patch(grid: np.ndarray, coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
