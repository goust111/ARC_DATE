+    if not _assign_anchors(objects, h, w):
+        return None
+    if not _assign_input_positions(objects, h, w):
+        return None
+
+    inp = _build_input(objects, h, w)
+    expected = _build_expected(inp, objects)
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
