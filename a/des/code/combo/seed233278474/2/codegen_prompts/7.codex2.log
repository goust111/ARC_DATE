+def _corner_origin(anchor: tuple[int, int], corner: str, shape: tuple[int, int]) -> tuple[int, int]:
+    r, c = anchor
+    hh, ww = shape
+    if corner == "tl":
+        return r, c
+    if corner == "tr":
+        return r, c - ww + 1
+    if corner == "bl":
+        return r - hh + 1, c
+    if corner == "br":
+        return r - hh + 1, c - ww + 1
