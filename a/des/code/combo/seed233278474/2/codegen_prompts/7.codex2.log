+    return coords
+
+
+def _make_object_patch(hole_count: int, body_color: int, marker_color: int) -> dict | None:
+    for _ in range(300):
+        h, w = _sample_dims(hole_count)
+        mask = _make_object_mask(h, w, hole_count)
+        if mask is None:
