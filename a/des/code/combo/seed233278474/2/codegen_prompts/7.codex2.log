+def _build_expected(inp: np.ndarray, objects: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for obj in objects:
+        r0, c0 = obj["input_pos"]
+        hh, ww = obj["patch"].shape
+        mask = obj["patch"] != 0
