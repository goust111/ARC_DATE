+    )
+    placed_rects: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        patch = objects[idx]["patch"]
+        hh, ww = patch.shape
+        candidates = [
+            (r, c)
+            for r in range(_INPUT_MARGIN, h - hh - _INPUT_MARGIN + 1)
+            for c in range(_INPUT_MARGIN, w - ww - _INPUT_MARGIN + 1)
