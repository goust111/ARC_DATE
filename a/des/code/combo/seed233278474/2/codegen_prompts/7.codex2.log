+        holes = _count_holes_in_patch(patch)
+        transformed = _transform_by_holes(patch, holes)
+        anchor = anchors[marker_color]
+        corner = _nearest_corner(anchor, h, w)
+        r0, c0 = _corner_origin(anchor, corner, transformed.shape)
