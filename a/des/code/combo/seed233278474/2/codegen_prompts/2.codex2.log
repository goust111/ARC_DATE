+        top = center_r - size // 2 + 1
+        left = center_c - size // 2 + 1
+    return top, left, top + size, left + size
+
+
+def _square_extents(size: int) -> tuple[int, int]:
+    if size % 2 == 1:
+        return size // 2, size // 2
+    return size // 2 - 1, size // 2
+
