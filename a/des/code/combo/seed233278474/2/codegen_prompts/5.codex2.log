+            if not np.all((patch == BG) | (patch == color)):
+                continue
+            gap_idx = int(missing[0])
+            pixels = [
+                (r + dr, c + dc)
+                for idx, (dr, dc) in enumerate(RING_OFFSETS)
+                if idx != gap_idx
