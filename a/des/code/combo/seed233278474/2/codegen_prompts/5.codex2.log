+        if motif == "inert" and not _place_inert(spec, rows, cols):
+            return None
+
+    max_rings = min(9, rows * cols, RING_COUNT_RANGE[1])
+    min_rings = min(max_rings, max(len(spec), RING_COUNT_RANGE[0]))
+    if min_rings > max_rings:
