+BG = 0
+WALL = 3
+PALETTE = (1, 2, 4, 5, 6, 7, 8, 9)
+DIRECTIONS = ("up", "right", "down", "left")
+STEP = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+ROTATION_K = {
+    "up": 0,
+    "right": 3,
+    "down": 2,
+    "left": 1,
+}
+
+GRID_MIN = 18
+GRID_MAX = 30
