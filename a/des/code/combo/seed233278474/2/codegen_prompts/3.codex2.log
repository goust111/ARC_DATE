    bg = int(get_bg(g))

    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:
        H, W = arr.shape
        sides = {
            "top": arr[0, 1:-1],
            "bottom": arr[-1, 1:-1],
            "left": arr[1:-1, 0],
            "right": arr[1:-1, -1],
        }
        cand: list[tuple[str, int, int, int]] = []
