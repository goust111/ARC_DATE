+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(int(r), int(c))])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _coords_to_mask(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _all_inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    return bool(
+        np.all(coords[:, 0] >= r0)
+        and np.all(coords[:, 0] <= r1)
+        and np.all(coords[:, 1] >= c0)
+        and np.all(coords[:, 1] <= c1)
+    )
+
+
+def _intersects_any_box(coords: np.ndarray, boxes: list[tuple[int, int, int, int]]) -> bool:
+    for box in boxes:
+        if _all_inside_box(coords, box):
+            return True
+        r0, c0, r1, c1 = box
+        inside = (
+            (coords[:, 0] >= r0)
+            & (coords[:, 0] <= r1)
+            & (coords[:, 1] >= c0)
+            & (coords[:, 1] <= c1)
+        )
+        if bool(np.any(inside)):
+            return True
+    return False
