+    out = g.copy()
+    for color in frame_colors:
+        for sprite in sprites_by_color.get(int(color), []):
+            out[sprite["coords"][:, 0], sprite["coords"][:, 1]] = int(bg)
+
+    for frame in frames:
+        _stack_into_frame(out, frame, sprites_by_color.get(frame["color"], []), bg)
