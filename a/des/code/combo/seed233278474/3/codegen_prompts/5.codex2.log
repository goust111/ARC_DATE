  31:     H, W = g.shape
  32:     corners = [(0, 0), (0, W - 1), (H - 1, 0), (H - 1, W - 1)]
  33:     distances = [abs(r - corner_r) + abs(c - corner_c) for corner_r, corner_c in corners]
  34:     nearest = min(distances)
  35:     assert distances.count(nearest) == 1, "expected a unique nearest corner"
  36: 
  37:     corner_r, corner_c = corners[distances.index(nearest)]
  38:     r0, r1 = sorted((r, corner_r))
  39:     c0, c1 = sorted((c, corner_c))
  40: 
  41:     out = g.copy()
  42:     out[r0 : r1 + 1, c0 : c1 + 1] = color
