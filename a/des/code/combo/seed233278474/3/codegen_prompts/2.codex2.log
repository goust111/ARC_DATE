+def _can_place_cells(occupied: np.ndarray, cells: list[tuple[int, int]], pad: int) -> bool:
+    h, w = occupied.shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if occupied[r, c]:
