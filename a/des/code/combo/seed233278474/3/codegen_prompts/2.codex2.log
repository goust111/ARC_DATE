+        if height > HOLE_BBOX_MAX or width > HOLE_BBOX_MAX:
+            continue
+        if height * width == len(shape):
+            continue
+        if _rotation_count(shape) < 4:
+            continue
+        shape, _, _ = _rotate_coords(shape, random.randrange(4))
+        return shape
+    return None
+
