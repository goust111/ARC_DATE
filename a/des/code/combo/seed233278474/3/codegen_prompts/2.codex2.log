+# --------------- generator ---------------
+
+GEN_RETRIES = 500
+GRID_MARGIN = 3
+GRID_EXTRA_MIN = 8
+GRID_EXTRA_MAX = 14
+TEMPLATE_SIDE_MIN = 8
+TEMPLATE_SIDE_MAX = 13
+HOLE_COUNT_MIN = 2
+HOLE_COUNT_MAX = 4
+HOLE_AREA_MIN = 3
+HOLE_AREA_MAX = 6
+HOLE_BBOX_MAX = 4
+PLACEMENT_PAD = 1
+SHAPE_RETRIES = 300
+PLACEMENT_RETRIES = 300
+
