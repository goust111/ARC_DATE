+def _random_shape() -> tuple[tuple[int, int], ...] | None:
+    for _ in range(SHAPE_RETRIES):
+        target_area = random.randint(HOLE_AREA_MIN, HOLE_AREA_MAX)
+        cells = {(0, 0)}
+        while len(cells) < target_area:
