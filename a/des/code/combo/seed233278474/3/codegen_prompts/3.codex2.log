+def _current_region_color(g: np.ndarray, bounds: tuple[int, int, int, int]) -> int:
+    r0, r1, c0, c1 = bounds
+    sub = g[r0:r1, c0:c1]
+    colors = np.unique(sub[sub != MAROON])
+    assert len(colors) == 1
+    return int(colors[0])
+
