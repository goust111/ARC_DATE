+    local = np.zeros((3, 3), dtype=bool)
+    for r, c in maroon:
+        local[int(r - r0), int(c - c0)] = True
+    direction = _match_arrow_pattern(local)
+    top = abs_r0 + int(r0)
+    left = abs_c0 + int(c0)
+    return fill_color, Arrow(region_id, top, left, direction, _arrow_cells(top, left, direction))
