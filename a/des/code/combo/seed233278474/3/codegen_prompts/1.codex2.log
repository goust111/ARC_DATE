+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_monochrome(g: np.ndarray, pts: list[tuple[int, int]]) -> bool:
+    vals = {int(g[r, c]) for r, c in pts}
+    return len(vals) == 1
+
+
