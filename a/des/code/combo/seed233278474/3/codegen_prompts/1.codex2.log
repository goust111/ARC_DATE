+BLACK = 0
+GREY = 5
+MAROON = 9
+
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+GEN_RETRIES = 300
+LEGEND_COUNT_RANGE = (3, 6)
+LEGEND_SIZE_CHOICES = [2, 3]
+LEGEND_GAP_CHOICES = [1, 2]
+TOP_MARGIN_CHOICES = [0, 1]
+LEGEND_TO_FENCE_GAP = (2, 4)
+GRID_H_MAX = 28
+GRID_W_MAX = 30
+FRAME_RETRIES = 120
