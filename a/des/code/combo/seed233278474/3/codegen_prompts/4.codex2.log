+    if not np.array_equal(out[grid == BLUE], grid[grid == BLUE]):
+        return None
+    if int(out[grid_h - 2, grid_w - 1]) != RED or int(out[grid_h - 1, grid_w - 1]) != GREEN:
+        return None
+    return grid
