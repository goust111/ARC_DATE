+                return False
+    return True
+
+
+def _candidate_crossing_segments(
+    shape: tuple[int, int],
+    kind: str,
+    anchor_r: int,
+    anchor_c: int,
+) -> list[list[tuple[int, int]]]:
+    h, w = shape
+    candidates: list[list[tuple[int, int]]] = []
+    lengths = [2, 3, 4, 5]
+    _RNG.shuffle(lengths)
