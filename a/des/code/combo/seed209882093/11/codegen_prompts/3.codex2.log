+def _build_pair_specs(h: int, w: int, pair_count: int) -> list[dict] | None:
+    colors = list(_RNG.choice(np.array(PAIR_COLORS), size=pair_count, replace=False))
+    parities = [0, 1]
+    while len(parities) < pair_count:
