+            cells = _segment_cells("h", row, start, start + length - 1)
+        else:
+            col = int(_RNG.integers(0, w))
+            length = int(_RNG.integers(2, min(7, h) + 1))
+            start = int(_RNG.integers(0, h - length + 1))
+            cells = _segment_cells("v", col, start, start + length - 1)
