+                    "orient": "h",
+                    "row": row,
+                    "c0": c0,
+                    "c1": c1,
+                    "target_count": count,
+                }
+            else:
+                gap_min = max(3, 2 * count)
+                if h - 1 < gap_min:
+                    continue
+                col = int(_RNG.integers(1, w - 1))
+                if any(abs(col - prev) < 3 for prev in used_v_cols):
+                    continue
+                gap = int(_RNG.integers(gap_min, min(h - 1, gap_min + 6) + 1))
+                r0 = int(_RNG.integers(0, h - gap))
+                r1 = r0 + gap
+                spec = {
+                    "color": int(color),
+                    "orient": "v",
+                    "col": col,
+                    "r0": r0,
+                    "r1": r1,
+                    "target_count": count,
+                }
