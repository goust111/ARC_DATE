+        if pair is None:
+            return None
+        seeds.extend(pair)
+
+    max_seeds = min(6, ((h - 2) * (w - 2)) // 18 + 2)
+    min_seeds = 1 if scenario == "scatter" else 2
+    target_seeds = rng.randint(min_seeds, max_seeds)
