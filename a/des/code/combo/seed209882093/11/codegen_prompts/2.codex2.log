+        frame["bbox"] = bbox
+
+    # Place longer segments first to reduce rejection rate.
+    frame_specs.sort(key=lambda item: item["length"], reverse=True)
+    for frame in frame_specs:
+        placed = _place_segment(
+            grid,
+            blocked,
+            frame["orientation"],
+            frame["length"],
+            frame["color"],
+            rng,
