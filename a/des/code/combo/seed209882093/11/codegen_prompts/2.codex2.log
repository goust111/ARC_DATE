+def _bbox_is_free(blocked: np.ndarray, bbox: tuple[int, int, int, int], pad: int) -> bool:
+    er0, ec0, er1, ec1 = _expanded_bbox(bbox, pad, blocked.shape)
+    return not blocked[er0 : er1 + 1, ec0 : ec1 + 1].any()
