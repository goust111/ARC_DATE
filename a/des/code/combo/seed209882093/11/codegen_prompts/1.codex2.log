+        if not placed:
+            return None
+
+    expected = grid.copy()
+    for r0, c0, r1, c1, island_count in frame_records:
+        patch = expected[r0 + 1 : r1, c0 + 1 : c1]
+        src = grid[r0 + 1 : r1, c0 + 1 : c1]
+        patch[src == BG] = int(legend[island_count])
