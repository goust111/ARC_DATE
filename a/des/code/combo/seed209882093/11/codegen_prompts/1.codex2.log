+# --------------- generator ---------------
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (18, 27)
+GRID_W_RANGE = (18, 31)
+LEGEND_N_RANGE = (2, 5)
+FRAME_COUNT_RANGE = (1, 4)
+FRAME_H_RANGE = (5, 10)
