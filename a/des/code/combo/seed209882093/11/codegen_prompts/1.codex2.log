+
+        mapping: dict[int, int] = {}
+        seen_colors: set[int] = set()
+        for comp in rows:
+            _r0, c0, _r1, c1 = map(int, comp["bbox"])
+            length = c1 - c0 + 1
+            color = int(comp["color"])
+            if length in mapping or color in seen_colors:
+                return None
