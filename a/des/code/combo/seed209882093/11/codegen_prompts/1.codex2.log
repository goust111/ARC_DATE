+            grid[r0 : r1 + 1, c0] = border_color
+            grid[r0 : r1 + 1, c1] = border_color
+            grid[r0 + 1 : r1, c0 + 1 : c1] = interior
+
+            _mark_blocked(blocked, r0, c0, r1, c1, pad=FRAME_PADDING)
