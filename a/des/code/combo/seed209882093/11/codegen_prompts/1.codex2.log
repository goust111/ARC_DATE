+) -> tuple[dict[int, int], tuple[int, int, int, int]]:
+    h, w = grid.shape
+    n = len(legend_colors)
+    lengths = list(range(1, n + 1))
+    if rng.random() < 0.5:
+        lengths.reverse()
+
+    if corner[0] == "t":
+        rows = list(range(n))
+    else:
+        rows = list(range(h - n, h))
