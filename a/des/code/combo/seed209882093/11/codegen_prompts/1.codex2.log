+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
