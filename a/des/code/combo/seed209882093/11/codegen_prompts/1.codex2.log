+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _binary_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _monochrome_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _is_rectangular_frame(grid: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["area"]) != 2 * h + 2 * w - 4:
+        return False
+
+    sub = np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return np.array_equal(sub == int(comp["color"]), border)
+
+
+def _find_legend_mapping(grid: np.ndarray) -> dict[int, int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    comps = _monochrome_components(g, bg=BG)
+
+    bars = []
+    for comp in comps:
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        if r0 == r1 and int(comp["area"]) == c1 - c0 + 1:
+            bars.append(comp)
+
+    def collect(top: bool, left: bool) -> dict[int, int] | None:
+        row_to_comp: dict[int, dict] = {}
+        for comp in bars:
+            r0, c0, _r1, c1 = map(int, comp["bbox"])
+            if left and c0 != 0:
+                continue
+            if not left and c1 != w - 1:
+                continue
