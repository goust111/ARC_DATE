+            c_lo = 1
+            r_hi = h - fh - 1
+            c_hi = w - fw - 1
+            if r_hi < r_lo or c_hi < c_lo:
+                continue
+
+            r0 = _randint(rng, r_lo, r_hi)
+            c0 = _randint(rng, c_lo, c_hi)
