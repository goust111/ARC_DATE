+    def collect(top: bool, left: bool) -> dict[int, int] | None:
+        row_to_comp: dict[int, dict] = {}
+        for comp in bars:
+            r0, c0, _r1, c1 = map(int, comp["bbox"])
+            if left and c0 != 0:
+                continue
+            if not left and c1 != w - 1:
