from __future__ import annotations
import random
import numpy as np


def _get_bg(g):
    vals, cnts = np.unique(g, return_counts=True)
    return int(vals[cnts.argmax()])


def _find_components(mask):
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
