                continue
            cols = list(range(1, mw - 1))
            rng.shuffle(cols)
            take = rng.randint(1, len(cols))
            for cc in cols[:take]:
                transparent[axis_local, cc] = True
        extra_cells = [(rr, cc) for rr in range(1, mh - 1) for cc in range(1, mw - 1) if not transparent[rr, cc]]
        rng.shuffle(extra_cells)
        extra_n = rng.randint(0, min(len(extra_cells), max(1, (mh * mw) // 6)))
        for rr, cc in extra_cells[:extra_n]:
            transparent[rr, cc] = True
        opaque[transparent] = False
        if not transparent.any() or not _mask_connected(opaque):
            continue
        ok = True
        for rr in range(mh):
            for cc in range(mw):
                if not opaque[rr, cc]:
                    continue
                gr = r0 + rr
                gc = c0 + cc
                if axis == 'v':
                    mr, mc = gr, pw - 1 - gc
                else:
                    mr, mc = ph - 1 - gr, gc
                if (mr, mc) == (gr, gc):
                    ok = False
