                if r0 <= mr < r0 + mh and c0 <= mc < c0 + mw and opaque[mr - r0, mc - c0]:
                    ok = False
                    break
            if not ok:
                break
        if not ok:
            continue
        return (r0, c0), opaque, transparent, center_branch
    return None


def _boxes_far(a, b, gap=1):
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0


def _place_case(rng):
    axis = rng.choice(['v', 'h'])
    if axis == 'v':
