+    if grey_rows:
+        start = grey_rows[0]
+        end = start
+        while end + 1 < h and np.all(g[end + 1] == GREY):
+            end += 1
+        legend = g[:start, :]
+        main = g[end + 1 :, :]
+        assert legend.size > 0 and main.size > 0
+        return legend, main
