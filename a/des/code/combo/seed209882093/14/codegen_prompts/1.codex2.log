+        gap = 2
+        pad = 2
+        needed_w = pad + legend_count * swatch_size + (legend_count - 1) * gap + pad
+        main_h = _randint(rng, 10, 20)
+        main_w = _randint(rng, max(needed_w, 14), max(needed_w, 30))
+    else:
