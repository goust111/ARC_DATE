+    grid[:legend_h] = legend
+    grid[legend_h, :] = GREY
+    grid[legend_h + 1 :] = main
+    return grid
+
+
+def _build_left_layout(
+    rng: np.random.Generator, swatches: list[np.ndarray], main: np.ndarray
