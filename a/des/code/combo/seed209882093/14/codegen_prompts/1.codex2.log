+        pattern = np.zeros((2, 2), dtype=int)
+        by_parity: dict[tuple[int, int], list[int]] = {(0, 0): [], (0, 1): [], (1, 0): [], (1, 1): []}
+        for r, c in comp:
+            by_parity[((r - r0) % 2, (c - c0) % 2)].append(int(legend[r, c]))
