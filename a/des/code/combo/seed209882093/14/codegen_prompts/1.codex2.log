+                cut_h = _randint(rng, 1, h - 1)
+                cut_w = _randint(rng, 1, w - 1)
+                corner = _randint(rng, 0, 3)
+                if corner == 0:
+                    mask[:cut_h, :cut_w] = False
+                elif corner == 1:
+                    mask[:cut_h, w - cut_w :] = False
+                elif corner == 2:
