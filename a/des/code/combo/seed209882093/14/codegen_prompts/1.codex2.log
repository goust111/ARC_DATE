+def _split_input(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    grey_rows = [r for r in range(h) if np.all(g[r] == GREY)]
+    grey_cols = [c for c in range(w) if np.all(g[:, c] == GREY)]
