+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        steps = DIRS4
+    else:
+        steps = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((int(rr), int(cc)))
+                for dr, dc in steps:
+                    nr, nc = int(rr + dr), int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _paste_patch(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = out.shape
+    ph, pw = patch.shape
+    for r in range(ph):
+        for c in range(pw):
+            value = int(patch[r, c])
+            if value == 0:
+                continue
+            rr = int(top + r)
+            cc = int(left + c)
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr, cc] = value
+
+
+def _find_objects(grid: np.ndarray) -> list[dict]:
+    objs: list[dict] = []
+    for coords in _components((grid != BG) & (grid != ARROW), connectivity=4):
+        colors = {int(grid[r, c]) for r, c in coords}
+        if len(colors) != 1:
+            continue
+        color = next(iter(colors))
+        r0, c0, r1, c1 = _bbox(coords)
+        patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+        for r, c in coords:
+            patch[int(r - r0), int(c - c0)] = int(color)
+        objs.append(
+            {
+                "color": int(color),
+                "r0": int(r0),
+                "c0": int(c0),
+                "r1": int(r1),
+                "c1": int(c1),
+                "h": int(r1 - r0 + 1),
+                "w": int(c1 - c0 + 1),
+                "patch": patch,
+            }
+        )
+    return objs
