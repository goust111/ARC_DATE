+import numpy as np
+
+
+BG = 0
+ARROW = 8
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_VECS = {
+    "L": (0, -1),
+    "R": (0, 1),
+    "U": (-1, 0),
+    "D": (1, 0),
+}
+ARROW_PATTERNS = {
+    "R": {(0, 0), (-1, -1), (1, -1)},
+    "L": {(0, 0), (-1, 1), (1, 1)},
+    "U": {(0, 0), (1, -1), (1, 1)},
+    "D": {(0, 0), (-1, -1), (-1, 1)},
+}
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+OBJECT_COUNT_CHOICES = [1, 2, 2, 3, 3, 4]
+SHAPE_RETRIES = 120
+PLACEMENT_RETRIES = 180
+GEN_RETRIES = 300
