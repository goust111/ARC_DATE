+        obj = objects[int(oi)]
+        direction = arrows[int(ai)]["direction"]
+        step = int(obj["w"] if direction in ("L", "R") else obj["h"])
+        vr, vc = DIR_VECS[direction]
+        dr = int(vr * gap * step)
+        dc = int(vc * gap * step)
+        if direction in ("L", "R"):
+            stamp = np.fliplr(obj["patch"])
+        else:
