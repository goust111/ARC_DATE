+def _arrow_cells(direction: str, h: int, w: int, gap: int) -> set[tuple[int, int]]:
+    mid_r = h // 2
+    mid_c = w // 2
+    if direction == "R":
+        tip = (mid_r, w - 1 + gap)
+    elif direction == "L":
+        tip = (mid_r, -gap)
+    elif direction == "D":
+        tip = (h - 1 + gap, mid_c)
