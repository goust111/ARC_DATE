+def _find_arrows(grid: np.ndarray) -> list[dict]:
+    arrows: list[dict] = []
+    for coords in _components(grid == ARROW, connectivity=8):
+        arrow = _parse_arrow(coords)
+        if arrow is not None:
+            arrows.append(arrow)
+    return arrows
+
