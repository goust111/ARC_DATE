+        if len(cells) != target:
+            continue
+
+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 2 or w < 2:
+            continue
+
+        patch = np.zeros((h, w), dtype=int)
+        for r, c in cells:
+            patch[int(r - r0), int(c - c0)] = 1
