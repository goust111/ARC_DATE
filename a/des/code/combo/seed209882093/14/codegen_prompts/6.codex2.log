+def _paste_patch(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = out.shape
+    ph, pw = patch.shape
+    for r in range(ph):
+        for c in range(pw):
+            value = int(patch[r, c])
+            if value == 0:
+                continue
+            rr = int(top + r)
+            cc = int(left + c)
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr, cc] = value
+
