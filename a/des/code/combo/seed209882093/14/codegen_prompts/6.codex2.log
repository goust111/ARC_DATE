+    if direction == "L":
+        if obj["r0"] <= tr <= obj["r1"] and tc < obj["c0"]:
+            return int(obj["c0"] - tc)
+        return None
+    if direction == "D":
+        if obj["c0"] <= tc <= obj["c1"] and tr > obj["r1"]:
+            return int(tr - obj["r1"])
