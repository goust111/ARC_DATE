+        pairs.append((int(oi), int(ai), int(gap)))
+        used_objects.add(int(oi))
+        used_arrows.add(int(ai))
+
+    for gap, oi, ai in sorted(edges):
+        if int(oi) in used_objects or int(ai) in used_arrows:
