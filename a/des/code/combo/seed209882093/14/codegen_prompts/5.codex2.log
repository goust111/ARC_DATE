+
+    areas = [spec["outer_h"] * spec["outer_w"] for spec in specs]
+    order = sorted(range(len(specs)), key=lambda idx: (-areas[idx], idx))
+    if designated is not None:
+        first = designated[0]
+        order = [first] + [idx for idx in order if idx != first]
