+    placed_by_idx: dict[int, dict] = {}
+    placed_bboxes: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        spec = specs[idx]
+        outer_h = int(spec["outer_h"])
+        outer_w = int(spec["outer_w"])
