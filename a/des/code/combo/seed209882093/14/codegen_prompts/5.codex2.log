+                    "nominal": nominal,
+                    "actual": len(cells),
+                    "color": color,
+                    "side": window[2],
+                    "room_bbox": room["bbox"],
+                }
+            )
+
+    if with_meta:
+        return out, beam_infos, palette_row, rooms, palette
+    return out
