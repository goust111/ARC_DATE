+                "inner_h": outer_h - 2,
+                "inner_w": outer_w - 2,
+                "windows": sorted(windows),
+                "window_count": len(windows),
+            }
+        )
+    rooms.sort(key=lambda room: (room["bbox"][0], room["bbox"][1]))
+    return rooms
+
