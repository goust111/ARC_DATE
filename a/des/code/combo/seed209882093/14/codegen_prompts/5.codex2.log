+def _beam_cells(grid: np.ndarray, room: dict, window: tuple[int, int, str]) -> tuple[list[tuple[int, int]], int]:
+    h, w = grid.shape
+    r, c, side = window
+    if side == "top":
+        dr, dc = -1, 0
+        nominal = int(room["inner_h"])
+    elif side == "bottom":
+        dr, dc = 1, 0
+        nominal = int(room["inner_h"])
+    elif side == "left":
+        dr, dc = 0, -1
+        nominal = int(room["inner_w"])
+    else:
+        dr, dc = 0, 1
+        nominal = int(room["inner_w"])
