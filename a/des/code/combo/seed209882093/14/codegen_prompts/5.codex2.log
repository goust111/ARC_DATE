+    cells: list[tuple[int, int]] = []
+    for step in range(1, nominal + 1):
+        nr = r + dr * step
+        nc = c + dc * step
+        if not (0 <= nr < h and 0 <= nc < w):
+            break
+        if int(grid[nr, nc]) != BLACK:
