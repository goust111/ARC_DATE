+
+
+def _valid_generated_grid(grid: np.ndarray, expected_rooms: int, want_truncation: bool) -> bool:
+    try:
+        _, beam_infos, palette_row, rooms, _ = _apply_rule(grid, with_meta=True)
+    except AssertionError:
