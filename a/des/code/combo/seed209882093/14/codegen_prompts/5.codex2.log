+    if not used_cells or not has_full:
+        return False
+    if want_truncation and not has_truncated:
+        return False
+    return True
+
+
+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(*GRID_H_RANGE)
+    w = rng.randint(*GRID_W_RANGE)
