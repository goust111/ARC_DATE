+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+GEN_RETRIES = 400
+
+
+PATTERN_POOL = [
+    np.array([[1, 0, 0], [0, 0, 0]], dtype=bool),
+    np.array([[0, 1, 0], [0, 0, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 0, 0]], dtype=bool),
+    np.array([[1, 0, 1], [0, 0, 0]], dtype=bool),
+]
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _monochrome_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _find_slots(grid: np.ndarray, frame: dict) -> list[dict]:
+    r0, c0, r1, c1 = frame["bbox"]
+    slots: list[dict] = []
+
+    top_band = grid[r0 : r0 + 2, c0 : c1 + 1]
+    top_cols = np.where(np.any(top_band == BG, axis=0))[0]
+    assert top_cols.size > 0
+    tc0 = int(top_cols.min())
+    assert int(top_cols.max()) - tc0 + 1 == 3
+    slots.append(
+        {
+            "side": "top",
+            "r0": int(r0),
+            "c0": int(c0 + tc0),
+            "fill_mask": top_band[:, tc0 : tc0 + 3] == BG,
+        }
+    )
+
+    bottom_band = grid[r1 - 1 : r1 + 1, c0 : c1 + 1]
+    bottom_cols = np.where(np.any(bottom_band == BG, axis=0))[0]
+    assert bottom_cols.size > 0
+    bc0 = int(bottom_cols.min())
+    assert int(bottom_cols.max()) - bc0 + 1 == 3
+    slots.append(
+        {
+            "side": "bottom",
+            "r0": int(r1 - 1),
+            "c0": int(c0 + bc0),
