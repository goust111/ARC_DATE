+            "side": "top",
+            "r0": int(r0),
+            "c0": int(c0 + tc0),
+            "fill_mask": top_band[:, tc0 : tc0 + 3] == BG,
+        }
+    )
+
+    bottom_band = grid[r1 - 1 : r1 + 1, c0 : c1 + 1]
+    bottom_cols = np.where(np.any(bottom_band == BG, axis=0))[0]
+    assert bottom_cols.size > 0
+    bc0 = int(bottom_cols.min())
+    assert int(bottom_cols.max()) - bc0 + 1 == 3
+    slots.append(
+        {
+            "side": "bottom",
+            "r0": int(r1 - 1),
+            "c0": int(c0 + bc0),
