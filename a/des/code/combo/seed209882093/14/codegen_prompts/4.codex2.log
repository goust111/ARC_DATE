+            "side": "left",
+            "r0": int(r0 + lr0),
+            "c0": int(c0),
+            "fill_mask": left_band[lr0 : lr0 + 3, :] == BG,
+        }
+    )
+
+    right_band = grid[r0 : r1 + 1, c1 - 1 : c1 + 1]
+    right_rows = np.where(np.any(right_band == BG, axis=1))[0]
+    assert right_rows.size > 0
+    rr0 = int(right_rows.min())
+    assert int(right_rows.max()) - rr0 + 1 == 3
+    slots.append(
