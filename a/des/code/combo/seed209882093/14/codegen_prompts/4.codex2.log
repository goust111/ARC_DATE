+            for dc in range(sw - pw + 1):
+                canvas = np.zeros_like(slot_mask, dtype=bool)
+                canvas[dr : dr + ph, dc : dc + pw] = rotated
+                if np.array_equal(canvas, slot_mask):
+                    out.append({"rotation": k, "dr": dr, "dc": dc, "canvas": canvas})
+    return out
