+        cur = start
+
+        for _step in range(MAX_WALK_STEPS):
+            if cur == target and len(walk) >= desired_len and _count_bends(walk) >= 1:
+                return walk
+
+            neighbors = _coarse_neighbors(cur, rows, cols)
+            weights: list[float] = []
+            for nbr in neighbors:
