+
+def _find_task_path(grid: np.ndarray) -> dict:
+    mask = np.isin(grid, tuple(PATH_COLORS))
+    candidates = []
+    for coords in _mask_components(mask):
+        info = _path_candidate_info(grid, coords)
+        if info is not None:
