+# --------------- generator ---------------
+
+
+MIN_COARSE_SIDE = 4
+MAX_COARSE_SIDE = 7
+MIN_COARSE_PATH_LEN = 6
+MAX_WALK_STEPS = 5000
+MAX_GENERATION_ATTEMPTS = 400
+MAX_PATH_ATTEMPTS = 200
