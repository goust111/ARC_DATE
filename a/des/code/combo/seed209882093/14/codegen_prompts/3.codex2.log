+    return best
+
+
+def _complement_patch(patch: np.ndarray) -> np.ndarray:
+    out = patch.copy()
+    colors = set(map(int, np.unique(patch)))
+    assert colors <= ({BLACK} | set(COMPLEMENT)), "unexpected pattern color"
+    for src, dst in COMPLEMENT.items():
