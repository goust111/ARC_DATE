+
+    expected = _expected_output(grid, source_slice, target_slice, relay_count)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
