+
+
+def _coarse_to_fine(cell: tuple[int, int]) -> tuple[int, int]:
+    return 2 * cell[0] + 4, 2 * cell[1] + 4
+
+
+def _fine_block_slice(
+    endpoint: tuple[int, int],
+    side: str,
+    shape: tuple[int, int],
+) -> tuple[slice, slice] | None:
