+    BLUE: YELLOW,
+    YELLOW: BLUE,
+    RED: GREEN,
+    GREEN: RED,
+    ORANGE: AZURE,
+    AZURE: ORANGE,
+    MAGENTA: MAROON,
+    MAROON: MAGENTA,
+}
