+    expected = _expected_from_generated(objects)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+
+    extracted = _extract_objects(grid)
+    if len(extracted) != count:
+        return None
+    if int(np.sum(grid == GREY)) != count:
+        return None
+    return grid
