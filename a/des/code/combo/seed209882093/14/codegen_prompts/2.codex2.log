+def _is_connected(mask: np.ndarray) -> bool:
+    cells = [tuple(x) for x in np.argwhere(mask)]
+    if not cells:
+        return False
+    seen = {cells[0]}
+    queue = deque([cells[0]])
+    h, w = mask.shape
