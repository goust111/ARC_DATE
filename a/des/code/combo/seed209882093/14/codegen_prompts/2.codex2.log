+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    return mask[np.ix_(rows, cols)]
+
+
+def _rotation_order(patch: np.ndarray) -> int:
+    count = 0
+    for k in range(4):
+        if np.array_equal(np.rot90(patch, k), patch):
+            count += 1
+    return count
+
