 113: def _build_core(h: int, w: int, fill: int, pattern_colors: list[int]) -> np.ndarray:
 114:     core = np.full((h, w), int(fill), dtype=int)
 115:     area = h * w
 116:     max_nonfill = max(len(pattern_colors), int(area * 0.35))
 117:     target_nonfill = random.randint(max(len(pattern_colors), area // 10), max_nonfill)
