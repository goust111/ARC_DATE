 119: 
 120:     for color in pattern_colors:
 121:         r = random.randrange(h)
 122:         c = random.randrange(w)
 123:         core[r, c] = int(color)
 124:         painted += 1
 125: 
 126:     while painted < target_nonfill:
 127:         color = random.choice(pattern_colors)
 128:         shape_kind = random.choice(["dot", "line", "rect"])
 129:         if shape_kind == "dot":
 130:             cells = [(random.randrange(h), random.randrange(w))]
 131:         elif shape_kind == "line":
 132:             line_len = random.randint(2, min(5, max(h, w)))
 133:             if random.random() < 0.5:
 134:                 rr = random.randrange(h)
 135:                 c0 = random.randrange(max(1, w - line_len + 1))
 136:                 cells = [(rr, c0 + dc) for dc in range(line_len)]
 137:             else:
 138:                 r0 = random.randrange(max(1, h - line_len + 1))
 139:                 cc = random.randrange(w)
 140:                 cells = [(r0 + dr, cc) for dr in range(line_len)]
 141:         else:
 142:             mh = random.randint(1, min(3, h))
 143:             mw = random.randint(1, min(3, w))
 144:             r0 = random.randrange(h - mh + 1)
 145:             c0 = random.randrange(w - mw + 1)
 146:             cells = [(r0 + dr, c0 + dc) for dr in range(mh) for dc in range(mw)]
 147: 
 148:         remaining = target_nonfill - painted
 149:         if remaining <= 0:
