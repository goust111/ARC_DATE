+    row = 0
+    for obj in ordered:
+        patch = obj["patch"]
+        ph, pw = patch.shape
+        col = (out_w - pw) // 2
+        mask = patch != BLACK
+        out[row : row + ph, col : col + pw][mask] = patch[mask]
+        row += ph + 1
