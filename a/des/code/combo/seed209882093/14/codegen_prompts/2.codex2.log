 286:         cav_bbox = grp["cavity_bbox"]
 287:         odr, odc = grp["open_dir"]
 288:         # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a
 289:         # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color
 290:         # tools: swapping is ambiguous and not needed.)
 291:         comp_vals = [int(x) for x in comp["patch"][comp["mask"]].flatten() if int(x) != 0]
 292:         comp_counts = Counter(comp_vals)
 293: 
 294:         best_state = None
 295:         # Score prioritizes *filling the cavity* with exactly one tool color region.
 296:         # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)
 297:         best_score = None
 298:         cav_sz = int(grp["cavity_size"])
 299:         for p, m, is_flip in gen_variants(comp["patch"], comp["mask"]):
 300:             h, w = m.shape
 301:             coords = np.argwhere(m)
 302:             cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})
 303:             plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]
 304:             assert plug_colors
 305:             for r0 in range(0, H - h + 1):
 306:                 for c0 in range(0, W - w + 1):
 307:                     ok = True
 308:                     for rr, cc in coords:
 309:                         r = int(r0 + rr)
 310:                         c = int(c0 + cc)
 311:                         if placed_global[r, c]:
 312:                             ok = False
 313:                             break
 314:                     if not ok:
 315:                         continue
 316:                     adj = 0
 317:                     for rr, cc in coords:
 318:                         r = int(r0 + rr)
 319:                         c = int(c0 + cc)
 320:                         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
 321:                             r2, c2 = r + dr, c + dc
 322:                             if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:
 323:                                 adj += 1
 324:                     if adj == 0:
 325:                         continue
 326:                     socket_hits = 0
 327:                     cavity_hits = 0
 328:                     outside = 0
 329:                     # Best plug-match for this placement among candidate plug colors.
 330:                     plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)
 331:                     for rr, cc in coords:
 332:                         r = int(r0 + rr)
 333:                         c = int(c0 + cc)
 334:                         if sock[r, c]:
 335:                             socket_hits += 1
 336:                         if cav[r, c]:
 337:                             cavity_hits += 1
 338:                         # Count pixels placed outside the anchor bbox in the dominant open direction.
 339:                         br0, bc0, br1, bc1 = grp["bbox"]
 340:                         if odc == -1 and c < bc0:
 341:                             outside += 1
 342:                         elif odc == 1 and c > bc1:
 343:                             outside += 1
 344:                         elif odr == -1 and r < br0:
 345:                             outside += 1
 346:                         elif odr == 1 and r > br1:
 347:                             outside += 1
 348: 
 349:                     for plug_col in plug_colors:
 350:                         if plug_col is None:
 351:                             plug_score = (0, 0, 0, 0)
 352:                         else:
 353:                             plug_hits = 0
 354:                             plug_outside = 0
 355:                             nonplug_in_cav = 0
 356:                             for rr, cc in coords:
 357:                                 r = int(r0 + rr)
 358:                                 c = int(c0 + cc)
 359:                                 in_cav = bool(cav[r, c])
 360:                                 col = int(p[rr, cc])
 361:                                 if col == int(plug_col):
 362:                                     if in_cav:
 363:                                         plug_hits += 1
 364:                                     else:
 365:                                         plug_outside += 1
 366:                                 else:
 367:                                     if in_cav:
 368:                                         nonplug_in_cav += 1
 369:                             plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)
 370:                             plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))
 371:                         if plug_best is None or plug_score > plug_best:
 372:                             plug_best = plug_score
 373:                     dist = bbox_gap(grp["bbox"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))
 374:                     score = tuple(plug_best) + (
 375:                         int(cavity_hits),
 376:                         int(adj),
 377:                         int(outside),
 378:                         int(socket_hits),
 379:                         -int(dist),
 380:                         -int(r0),
 381:                         -int(c0),
 382:                     )
 383:                     if best_score is None or score > best_score:
 384:                         best_score = score
 385:                         best_state = (p, m, int(r0), int(c0), bool(is_flip))
 386: 
 387:         assert best_state is not None, 'must find a valid placement for every movable tool'
 388:         p, m, r0, c0, is_flip = best_state
 389:         if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:
 390:             a, b = sorted(comp_counts.keys())
 391:             q = p.copy()
 392:             q[(p == a) & m] = b
 393:             q[(p == b) & m] = a
 394:             p = q
 395:         for rr, cc in np.argwhere(m):
 396:             r = int(r0 + rr)
 397:             c = int(c0 + cc)
 398:             out[r, c] = int(p[rr, cc])
 399:             placed_global[r, c] = True
 400:             placed_grp[r, c] = True
 401: 
 402:     return out
 403: 
 404: # --------------- generator (O4) ---------------
 405: 
 406: from arc_utils import bbox as _bbox
 407: 
 408: # ── CFG: canvas ──
 409: GRID_H_RANGE = (18, 30)          # output grid height
 410: GRID_W_RANGE = (25, 30)          # output grid width
 411: NUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs
 412: 
 413: # ── CFG: frame geometry ──
 414: FRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)
 415: NOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)
 416: TOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)
 417: BOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)
 418: PLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n
 419: 
 420: # ── CFG: tool sizing ──
 421: HANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)
 422: TOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels
 423: HANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)
 424: 
 425: # ── CFG: placement ──
 426: UNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes
 427: FRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes
 428: TOOL_BORDER = 1                  # border margin for free tool placement
 429: TOOL_PADDING = 3                 # padding around existing content
 430: TOOL_PADDING_CONN = 4            # connectivity for padding check
 431: 
 432: # ── CFG: retry limits ──
 433: PAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs
 434: HANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite
 435: GEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()
 436: 
 437: 
 438: def _bbox_gap(a, b) -> int:
 439:     """Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1)."""
 440:     (ar0, ac0, ar1, ac1) = a
 441:     (br0, bc0, br1, bc1) = b
 442: 
 443:     def _gap1(x0, x1, y0, y1):
 444:         if y1 < x0:
 445:             return x0 - y1
 446:         if x1 < y0:
 447:             return y0 - x1
 448:         return 0
 449: 
 450:     return _gap1(ar0, ar1, br0, br1) + _gap1(ac0, ac1, bc0, bc1)
 451: 
 452: 
 453: def _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:
 454:     """Apply rot90(k) then optional horizontal flip."""
 455:     out = np.rot90(arr, k)
 456:     if flip:
 457:         out = np.fliplr(out)
 458:     return out
 459: 
 460: 
 461: def _orient_left_to_side(arr: np.ndarray, side: str) -> np.ndarray:
 462:     """Rotate/flip an array built for the left border to target the given side."""
 463:     if side == "left":
 464:         return arr.copy()
 465:     if side == "right":
 466:         return np.fliplr(arr)
 467:     if side == "top":
 468:         return np.rot90(arr, 3)
 469:     if side == "bottom":
 470:         return np.rot90(arr, 1)
 471:     raise ValueError(side)
 472: 
 473: 
 474: def _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:
 475:     """Swap two colors in a patch, returning a new array."""
 476:     out = patch.copy()
 477:     ma, mb = out == a, out == b
 478:     out[ma] = b
 479:     out[mb] = a
 480:     return out
 481: 
 482: 
 483: def _notch_offsets(notch_n: int, fw: int, bot_h: int) -> list[tuple[int, int]]:
 484:     """Return (row, col) offsets within the bottom bar to carve out a staircase notch."""
 485:     if notch_n == 1:
 486:         return [(0, fw - 1)]
 487:     if notch_n == 2:
 488:         return [(0, fw - 2), (0, fw - 1)]
 489:     if notch_n == 3:
 490:         if bot_h >= 2:
 491:             return [(0, fw - 2), (0, fw - 1), (1, fw - 1)]
 492:         return [(0, fw - 3), (0, fw - 2), (0, fw - 1)]
 493:     raise ValueError(notch_n)
 494: 
 495: 
 496: def _make_handle_sprite(handle_area: int, bg: int, handle_color: int) -> np.ndarray | None:
 497:     """Generate a random 4-connected handle sprite with exactly handle_area pixels."""
 498:     lo, hi = HANDLE_SPRITE_DIM
 499:     dims = [(h, w) for h in range(lo, hi) for w in range(lo, hi)
 500:             if handle_area <= h * w <= handle_area * 2]
 501:     if not dims:
 502:         return None
 503:     for _ in range(HANDLE_SPRITE_RETRIES):
 504:         h, w = random.choice(dims)
 505:         sprite = random_sprite(
 506:             h, w, density=handle_area / (h * w),
 507:             color_palette=[handle_color], connectivity=4, background=bg,
 508:         )
 509:         if int(np.sum(sprite != bg)) == handle_area:
 510:             return sprite
 511:     return None
 512: 
 513: 
 514: def _build_left_pair(
 515:     *, bg: int, frame_color: int, plug_color: int, handle_color: int,
 516:     fw: int, top_h: int, bot_h: int, notch_n: int, handle_area: int,
 517: ) -> tuple[np.ndarray, np.ndarray] | None:
 518:     """Build a frame + docked tool pair oriented for the left border.
 519: 
 520:     Returns (frame_array, tool_array) on the same canvas, or None on failure.
 521:     """
 522:     fh = top_h + 1 + bot_h
 523:     frame = np.full((fh, fw), bg, dtype=int)
 524:     frame[:top_h, :] = frame_color
 525:     frame[top_h + 1:, :] = frame_color
 526:     for dr, dc in _notch_offsets(notch_n, fw, bot_h):
 527:         frame[top_h + 1 + dr, dc] = bg
 528: 
 529:     cavity = frame == bg
 530:     attach_rows = {r for r in range(fh) if cavity[r, fw - 1]}
 531: 
 532:     handle_sprite = _make_handle_sprite(handle_area, bg, handle_color)
 533:     if handle_sprite is None:
 534:         return None
 535: 
 536:     hs_h, hs_w = handle_sprite.shape
 537:     sprite_left_rows = {r for r in range(hs_h) if handle_sprite[r, 0] != bg}
 538: 
 539:     valid_offsets = [
 540:         voff for voff in range(fh)
 541:         if any((voff + sr) in attach_rows for sr in sprite_left_rows)
 542:     ]
 543:     if not valid_offsets:
 544:         return None
 545: 
 546:     voff = random.choice(valid_offsets)
 547:     total_h = max(fh, voff + hs_h)
 548:     total_w = fw + hs_w
 549: 
 550:     frame_full = np.full((total_h, total_w), bg, dtype=int)
 551:     frame_full[:fh, :fw] = frame
 552: 
 553:     tool = np.full((total_h, total_w), bg, dtype=int)
 554:     tool[:fh, :fw][cavity] = plug_color
 555:     handle_mask = handle_sprite != bg
 556:     tool[voff:voff + hs_h, fw:fw + hs_w][handle_mask] = handle_color
 557: 
 558:     return frame_full, tool
 559: 
 560: 
 561: def _build_param_options() -> list[tuple[int, int, int, int]]:
 562:     """Enumerate all valid (fw, top_h, bot_h, notch_n) combinations."""
 563:     fw_lo, fw_hi = FRAME_W_RANGE
 564:     nn_lo, nn_hi = NOTCH_N_RANGE
 565:     th_lo, th_hi = TOP_H_RANGE
 566:     bh_lo, bh_hi = BOT_H_RANGE
 567:     pa_lo, pa_hi = PLUG_AREA_BOUNDS
 568:     return [
 569:         (fw, top_h, bot_h, notch_n)
 570:         for fw in range(fw_lo, fw_hi)
 571:         for notch_n in range(nn_lo, nn_hi)
 572:         if pa_lo <= fw + notch_n <= pa_hi
 573:         for top_h in range(th_lo, th_hi)
 574:         for bot_h in range(bh_lo, bh_hi)
 575:     ]
 576: 
 577: 
 578: PARAM_OPTIONS = _build_param_options()
 579: 
 580: 
 581: def _pick_pair_specs(num_pairs: int) -> list[dict]:
 582:     """Pick frame geometry specs for each pair, ensuring distinct plug areas."""
 583:     ha_lo, ha_hi = HANDLE_AREA_RANGE
 584:     tt_lo, tt_hi = TOOL_TOTAL_BOUNDS
 585:     specs: list[dict] = []
 586:     for _ in range(PAIR_SPEC_RETRIES):
 587:         specs.clear()
 588:         used_plug_areas: set[int] = set()
 589:         for _ in range(num_pairs):
 590:             candidates = [x for x in PARAM_OPTIONS if x[0] + x[3] not in used_plug_areas]
 591:             if not candidates:
 592:                 specs = []
 593:                 break
 594:             fw, top_h, bot_h, notch_n = random.choice(candidates)
 595:             plug_area = fw + notch_n
 596:             specs.append({"fw": fw, "top_h": top_h, "bot_h": bot_h,
 597:                           "notch_n": notch_n, "plug_area": plug_area})
 598:             used_plug_areas.add(plug_area)
 599:         if len(specs) != num_pairs:
 600:             continue
 601:         all_plug_areas = {s["plug_area"] for s in specs}
 602:         ok = True
 603:         for spec in specs:
 604:             pa = spec["plug_area"]
 605:             handle_choices = [
 606:                 h for h in range(ha_lo, ha_hi)
 607:                 if tt_lo <= pa + h <= tt_hi and h != pa and h not in all_plug_areas
 608:             ]
 609:             if not handle_choices:
 610:                 ok = False
 611:                 break
 612:             spec["handle_area"] = random.choice(handle_choices)
 613:         if ok:
 614:             return [dict(s) for s in specs]
 615:     return []
 616: 
 617: 
 618: def _candidate_origins(side: str, ph: int, pw: int, H: int, W: int) -> list[tuple[int, int]]:
 619:     """Return shuffled candidate (r0, c0) origins for placing a patch on the given border side."""
 620:     if side == "left":
 621:         origins = [(r0, 0) for r0 in range(H - ph + 1)]
 622:     elif side == "right":
 623:         origins = [(r0, W - pw) for r0 in range(H - ph + 1)]
 624:     elif side == "top":
 625:         origins = [(0, c0) for c0 in range(W - pw + 1)]
 626:     elif side == "bottom":
 627:         origins = [(H - ph, c0) for c0 in range(W - pw + 1)]
 628:     else:
 629:         raise ValueError(side)
 630:     random.shuffle(origins)
 631:     return origins
 632: 
 633: 
 634: def _variant_choices(patch: np.ndarray) -> list[tuple[np.ndarray, bool]]:
 635:     """Return shuffled list of unique D4 variants of patch, each with its flip flag."""
 636:     seen = set()
 637:     out: list[tuple[np.ndarray, bool]] = []
 638:     mask = patch != 0
 639:     for k in range(4):
 640:         for flip in (False, True):
 641:             q = _transform(patch, k, flip)
 642:             m = _transform(mask.astype(np.uint8), k, flip).astype(bool)
 643:             key = (m.tobytes(), q[m].tobytes())
 644:             if key in seen:
 645:                 continue
 646:             seen.add(key)
 647:             out.append((q, flip))
 648:     random.shuffle(out)
 649:     return out
 650: 
 651: 
 652: def _place_docked_pair(
 653:     i: int, spec: dict, colors: list[int], side: str, bg: int,
 654:     H: int, W: int, output: np.ndarray, input_grid: np.ndarray,
 655:     union_bboxes: list, frame_bboxes: list,
 656: ) -> dict | None:
 657:     """Build one frame-tool pair, dock it onto the output, and record frame on input_grid.
 658: 
 659:     Returns tool info dict for later undocking, or None on failure.
 660:     """
 661:     frame_color = colors[3 * i]
 662:     plug_color = colors[3 * i + 1]
 663:     handle_color = colors[3 * i + 2]
 664: 
 665:     result = _build_left_pair(
 666:         bg=bg, frame_color=frame_color, plug_color=plug_color,
 667:         handle_color=handle_color, fw=spec["fw"], top_h=spec["top_h"],
 668:         bot_h=spec["bot_h"], notch_n=spec["notch_n"],
 669:         handle_area=spec["handle_area"],
 670:     )
 671:     if result is None:
 672:         return None
 673:     frame_left, tool_left = result
 674: 
 675:     # Combine frame + tool into a single docked scene
 676:     scene_left = np.where(tool_left != bg, tool_left, frame_left)
 677: 
 678:     frame_scene = _orient_left_to_side(frame_left, side)
 679:     tool = _orient_left_to_side(tool_left, side)
 680:     scene = _orient_left_to_side(scene_left, side)
 681:     ph, pw = scene.shape
 682:     fr0, fc0, fr1, fc1 = _bbox(frame_scene != bg)
 683: 
 684:     origin = None
 685:     for r0, c0 in _candidate_origins(side, ph, pw, H, W):
 686:         union_bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)
 687:         frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)
 688:         if side in ("left", "right") and (frame_bbox[0] == 0 or frame_bbox[2] == H - 1):
 689:             continue
 690:         if side in ("top", "bottom") and (frame_bbox[1] == 0 or frame_bbox[3] == W - 1):
 691:             continue
 692:         if any(_bbox_gap(union_bbox, prev) <= UNION_BBOX_GAP_MIN - 1 for prev in union_bboxes):
 693:             continue
 694:         if any(_bbox_gap(frame_bbox, prev) <= FRAME_BBOX_GAP_MIN - 1 for prev in frame_bboxes):
 695:             continue
 696:         if np.any((output[r0:r0 + ph, c0:c0 + pw] != bg) & (scene != bg)):
 697:             continue
 698:         origin = (r0, c0)
 699:         break
 700:     if origin is None:
 701:         return None
 702: 
 703:     r0, c0 = origin
 704:     paste(output, scene, r0, c0, transparent=bg)
 705:     paste(input_grid, frame_scene, r0, c0, transparent=bg)
 706: 
 707:     union_bboxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))
 708:     frame_bboxes.append((r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1))
 709:     return {
 710:         "tool": tool, "plug_color": plug_color, "handle_color": handle_color,
 711:         "plug_area": spec["plug_area"], "handle_area": spec["handle_area"],
 712:     }
 713: 
 714: 
 715: def _undock_tool(info: dict, bg: int, input_grid: np.ndarray,
 716:                  placement_canvas: np.ndarray) -> bool:
 717:     """Pick a random D4 variant of the tool and place it at a free location on the grid.
 718: 
 719:     Returns True on success, False if no placement found.
 720:     """
 721:     for patch, is_flip in _variant_choices(info["tool"]):
 722:         if is_flip and info["plug_area"] != info["handle_area"]:
 723:             patch = _swap_colors(patch, info["plug_color"], info["handle_color"])
 724:         try:
 725:             r0, c0 = random_free_location(
 726:                 placement_canvas, patch, transparent=bg,
 727:                 border=TOOL_BORDER, padding=TOOL_PADDING,
 728:                 padding_connectivity=TOOL_PADDING_CONN,
 729:             )
 730:         except ValueError:
 731:             continue
 732:         paste(input_grid, patch, r0, c0, transparent=bg)
 733:         paste(placement_canvas, patch, r0, c0, transparent=bg)
 734:         return True
 735:     return False
 736: 
 737: 
 738: def _gen_attempt() -> np.ndarray | None:
 739:     """Single attempt to generate a valid input grid."""
 740:     H = random.randint(*GRID_H_RANGE)
 741:     W = random.randint(*GRID_W_RANGE)
 742:     bg = random.choice(list(range(10)))
 743:     num_pairs = random.choice(NUM_PAIRS_CHOICES)
 744: 
 745:     pair_specs = _pick_pair_specs(num_pairs)
 746:     if len(pair_specs) != num_pairs:
 747:         return None
 748: 
 749:     colors = [c for c in range(1, 10) if c != bg]
 750:     random.shuffle(colors)
 751:     need = 1 + (3 * num_pairs)
 752:     if len(colors) < need:
 753:         return None
 754: 
 755:     sides = random.sample(["left", "right", "top", "bottom"], k=num_pairs)
 756:     output = np.full((H, W), bg, dtype=int)
 757:     input_grid = np.full((H, W), bg, dtype=int)
 758:     union_bboxes: list[tuple[int, int, int, int]] = []
 759:     frame_bboxes: list[tuple[int, int, int, int]] = []
 760:     placed_tools: list[dict] = []
 761: 
 762:     for i, spec in enumerate(pair_specs):
 763:         info = _place_docked_pair(
 764:             i, spec, colors, sides[i], bg, H, W,
 765:             output, input_grid, union_bboxes, frame_bboxes,
 766:         )
 767:         if info is None:
 768:             return None
 769:         placed_tools.append(info)
 770: 
 771:     placement_canvas = output.copy()
 772:     for info in placed_tools:
 773:         if not _undock_tool(info, bg, input_grid, placement_canvas):
 774:             return None
 775: 
 776:     if np.array_equal(main(input_grid), output):
 777:         return input_grid
 778:     return None
 779: 
 780: 

 781: def generate_input() -> np.ndarray:
 782:     for _ in range(GEN_ATTEMPT_RETRIES):
 783:         grid = _gen_attempt()
 784:         if grid is not None:
 785:             return grid
 786:     raise RuntimeError("failed to generate valid input after %d attempts" % GEN_ATTEMPT_RETRIES)


