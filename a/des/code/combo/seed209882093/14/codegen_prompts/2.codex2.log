+            return False
+    return True
+
+
+def _expected_from_generated(objects: list[dict]) -> np.ndarray:
+    packed = []
+    for obj in objects:
+        packed.append(
+            {
+                "patch": obj["patch"],
+                "order": _rotation_order(obj["patch"]),
+                "first": obj["first"],
+            }
+        )
+    return _stack_objects(packed)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    count = random.randint(*OBJECT_COUNT_RANGE)
