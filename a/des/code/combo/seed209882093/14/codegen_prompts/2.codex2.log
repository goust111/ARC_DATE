+def _random_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    path = [(r, c)]
+    while (r, c) != (er, ec):
+        moves = []
+        if r < er:
+            moves.append((r + 1, c))
+        elif r > er:
+            moves.append((r - 1, c))
+        if c < ec:
+            moves.append((r, c + 1))
+        elif c > ec:
+            moves.append((r, c - 1))
+        r, c = random.choice(moves)
+        path.append((r, c))
+    return path
