  58:     bg, objects = _infer_background_and_objects(g)
  59:     assert bg != Color.BLUE
  60:     assert Color.BLUE not in set(map(int, g.ravel()))
  61: 
  62:     copies = len(objects)
  63: 
  64:     tile = np.rot90(g, 1)
  65:     tile_h, tile_w = map(int, tile.shape)
  66: 
  67:     out_h = copies * tile_h + copies + 1
  68:     out_w = tile_w + 2
