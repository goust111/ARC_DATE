+        for _ in range(random.randint(0, n)):
+            candidates = set()
+            for r, c in base:
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < n and 0 <= nc < n and nr <= center and nc >= center and (nr, nc) not in base:
+                        candidates.add((nr, nc))
+            if not candidates:
+                break
+            base.add(random.choice(tuple(candidates)))
