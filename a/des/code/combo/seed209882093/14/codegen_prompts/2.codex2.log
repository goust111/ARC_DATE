  35:     coords = np.argwhere(g == color)
  36:     assert coords.size, "expected a foreground bar"
  37:     assert np.all(coords[:, 0] == 0), "foreground bar must be in the top row"
  38:     cols = np.sort(coords[:, 1])
  39:     n = int(len(cols))
  40:     assert np.array_equal(cols, np.arange(n)), "foreground bar must start at the left edge and be contiguous"
  41: 
  42:     run_lengths = list(range(1, n + 1)) + list(range(n - 1, 0, -1))
  43:     seq: list[int] = []
  44:     for i, run_len in enumerate(run_lengths):
