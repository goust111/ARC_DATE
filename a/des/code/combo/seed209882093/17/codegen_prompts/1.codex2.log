+
+def _scene_parts(grid: np.ndarray):
+    h, w = grid.shape
+    bg = _dominant_color(grid)
+    frames = []
+    templates = {}
+    for value in np.unique(grid):
+        color = int(value)
+        if color == bg:
+            continue
