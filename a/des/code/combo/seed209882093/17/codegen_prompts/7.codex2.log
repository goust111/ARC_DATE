+        patch, _bbox = _crop_patch(g, cells)
+        mirrored = np.fliplr(patch)
+        row0, col0 = _placement_origin(exit_portal, mirrored.shape, exit_portal["direction"])
+        moves.append((mirrored, row0, col0))
