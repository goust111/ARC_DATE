+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors(cr, cc, mask.shape, connectivity=connectivity):
+                    if bool(mask[nr, nc]) and not seen[nr, nc]:
