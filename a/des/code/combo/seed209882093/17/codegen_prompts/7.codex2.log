+                static_cells.add((r, col))
+
+            arrow = _arrow_patch(direction)
+            ar0, ac0 = _arrow_origin(portal)
+            _stamp_patch(static, arrow, ar0, ac0)
+            for r, c in _rect_cells(ar0, ac0, arrow.shape):
