def _border(shape: tuple[int, int]) -> frozenset[tuple[int, int]]:
    h, w = shape
    return frozenset(
        (r, c)
        for r in range(h)
        for c in range(w)
        if r == 0 or r == h - 1 or c == 0 or c == w - 1
    )


def _candidate_outputs(
    bg: int, objects: list[dict], total_area: int
) -> list[np.ndarray]:
    outputs: list[tuple[int, np.ndarray]] = []

