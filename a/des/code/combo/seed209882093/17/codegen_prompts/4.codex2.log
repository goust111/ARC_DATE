+    if all(
+        int(spec["rot"]) == sample_rots[int(spec["box_idx"])] for spec in fragment_specs
+    ):
+        chosen = int(rng.integers(0, len(fragment_specs)))
+        fragment_specs[chosen]["rot"] = (int(fragment_specs[chosen]["rot"]) + 1) % 4
