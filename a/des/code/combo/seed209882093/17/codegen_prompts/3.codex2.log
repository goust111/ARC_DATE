+def _rectangle_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    if area != int(coords.shape[0]):
+        return None
+    return r0, c0, r1, c1
