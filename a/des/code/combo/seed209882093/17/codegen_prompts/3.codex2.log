+def _reflect_mask(mask: np.ndarray, axis: int) -> np.ndarray:
+    h, w = mask.shape
+    cols = np.arange(w)
+    mirror = 2 * axis - cols
+    valid = (mirror >= 0) & (mirror < w)
+    out = np.zeros((h, w), dtype=bool)
+    out[:, valid] = mask[:, mirror[valid]]
+    return out
