+        col_widths = [0] * cols
+        for slot, idx in enumerate(indices):
+            sr = slot // cols
+            sc = slot % cols
+            row_heights[sr] = max(row_heights[sr], int(sprites[idx].shape[0]))
+            col_widths[sc] = max(col_widths[sc], int(sprites[idx].shape[1]))
