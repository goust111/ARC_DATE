+def _place_content_rectangles(hole_h: int, hole_w: int, count: int, rng: random.Random) -> list[tuple[int, int, int, int]] | None:
+    if count == 0:
+        return []
+    blocked = np.zeros((hole_h, hole_w), dtype=bool)
+    blocked[0, :] = True
+    blocked[-1, :] = True
