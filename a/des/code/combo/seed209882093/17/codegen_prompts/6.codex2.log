+
+
+def _render_input_ring(spec: dict, rng: random.Random) -> np.ndarray | None:
+    sprite = np.full((int(spec["outer_h"]), int(spec["outer_w"])), BG, dtype=int)
+    sprite[spec["mask"]] = int(spec["color"])
