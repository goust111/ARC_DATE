+        "bbox": (r0, c0, r1, c1),
+        "outer_h": outer_h,
+        "outer_w": outer_w,
+        "top": top,
+        "left": left,
+        "hole_h": hole_h,
+        "hole_w": hole_w,
+        "mask": expected,
