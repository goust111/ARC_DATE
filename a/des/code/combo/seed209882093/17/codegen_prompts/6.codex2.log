+    inner_count = content_counts[-1]
+    hole_lo, hole_hi = HOLE_SIZE_BY_CONTENT[inner_count]
+    inner_hole_caps = {2: 6, 3: 4, 4: 2}
+    hole_hi = min(hole_hi, inner_hole_caps[ring_count])
