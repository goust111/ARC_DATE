+        height = top_margin + bottom_margin + sum(row_heights) + sum(row_gaps)
+        width = left_margin + right_margin + sum(col_widths) + sum(col_gaps)
+        if height > GRID_SIDE_MAX or width > GRID_SIDE_MAX:
