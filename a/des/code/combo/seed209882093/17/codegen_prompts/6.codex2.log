+        right_margin = rng.randint(*OUTER_MARGIN_RANGE)
+        row_gaps = [rng.randint(*SLOT_GAP_RANGE) for _ in range(max(0, rows - 1))]
+        col_gaps = [rng.randint(*SLOT_GAP_RANGE) for _ in range(max(0, cols - 1))]
+
+        height = top_margin + bottom_margin + sum(row_heights) + sum(row_gaps)
