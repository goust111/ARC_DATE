+            col_widths[sc] = max(col_widths[sc], int(sprites[idx].shape[1]))
+
+        if n == 4:
+            margin_range = (0, 2)
+            gap_range = (1, 2)
+        elif n == 3:
+            margin_range = (1, 3)
+            gap_range = (1, 3)
+        else:
+            margin_range = OUTER_MARGIN_RANGE
+            gap_range = SLOT_GAP_RANGE
