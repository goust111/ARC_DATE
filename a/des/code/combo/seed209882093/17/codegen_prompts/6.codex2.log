+    top = _leading_full_rows(mask)
+    bottom = _leading_full_rows(mask[::-1])
+    left = _leading_full_cols(mask)
+    right = _leading_full_cols(mask[:, ::-1])
+    if min(top, bottom, left, right) <= 0:
+        return None
+    if top != bottom or left != right:
