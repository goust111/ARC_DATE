+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+
+# Generator configuration.
+GEN_RETRIES = 400
+RING_COUNT_RANGE = (2, 4)
+THICKNESS_RANGE = (1, 2)
+HOLE_SIZE_BY_CONTENT = {
+    0: (1, 3),
+    1: (3, 5),
+    2: (5, 7),
+    3: (6, 8),
+}
+MAX_OUTER_SIDE = 26
+GRID_SIDE_MAX = 32
+SLOT_GAP_RANGE = (2, 5)
+OUTER_MARGIN_RANGE = (1, 4)
