+# Generator configuration.
+GEN_RETRIES = 400
+RING_COUNT_RANGE = (2, 4)
+THICKNESS_RANGE = (1, 2)
+HOLE_SIZE_BY_CONTENT = {
+    0: (1, 3),
+    1: (3, 5),
+    2: (5, 7),
+    3: (6, 8),
+}
+MAX_OUTER_SIDE = 26
+GRID_SIDE_MAX = 32
+SLOT_GAP_RANGE = (2, 5)
+OUTER_MARGIN_RANGE = (1, 4)
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _monochromatic_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            components.append({"color": color, "coords": coords})
+    return components
+
+
+def _count_non_bg_components(window: np.ndarray, bg: int) -> int:
+    h, w = window.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(window[r, c]) == bg:
+                continue
+            count += 1
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(window[nr, nc]) == bg:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+    return count
+
