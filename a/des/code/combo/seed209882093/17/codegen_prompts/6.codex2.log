+def _ring_mask(outer_h: int, outer_w: int, top: int, left: int, hole_h: int, hole_w: int) -> np.ndarray:
+    mask = np.ones((outer_h, outer_w), dtype=bool)
+    mask[top : top + hole_h, left : left + hole_w] = False
