+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(window[r, c]) == bg:
+                continue
+            count += 1
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(window[nr, nc]) == bg:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
