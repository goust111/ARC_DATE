+def _leading_full_rows(mask: np.ndarray) -> int:
+    rows = 0
+    while rows < mask.shape[0] and bool(mask[rows].all()):
+        rows += 1
+    return rows
+
+
+def _leading_full_cols(mask: np.ndarray) -> int:
+    cols = 0
+    while cols < mask.shape[1] and bool(mask[:, cols].all()):
