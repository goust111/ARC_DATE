+
+    rings.sort(
+        key=lambda ring: (
+            -int(ring["content_count"]),
+            -(int(ring["outer_h"]) * int(ring["outer_w"])),
+            -(int(ring["hole_h"]) * int(ring["hole_w"])),
+            int(ring["bbox"][0]),
+            int(ring["bbox"][1]),
