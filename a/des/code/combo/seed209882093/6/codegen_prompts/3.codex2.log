+def _component_center(coords: list[tuple[int, int]]) -> tuple[int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return _round_half_up(float(np.mean(rows))), _round_half_up(float(np.mean(cols)))
