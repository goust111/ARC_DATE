+def _rotate_offset(dr: int, dc: int, rot: int) -> tuple[int, int]:
+    rot %= 4
+    if rot == 0:
+        return dr, dc
+    if rot == 1:
+        return dc, -dr
+    if rot == 2:
+        return -dr, -dc
+    return -dc, dr
+
+
+def _rotation_for_marker(marker: tuple[int, int], center: tuple[int, int]) -> int:
+    dr = marker[0] - center[0]
+    dc = marker[1] - center[1]
+    if dr < 0 and dc >= 0:
+        return 1
+    if dr < 0 and dc < 0:
+        return 2
+    if dr >= 0 and dc < 0:
+        return 3
+    return 0
