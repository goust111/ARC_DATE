+        stamp = stamp_comps[0]
+        center = _component_center(stamp)
+        offsets = [(r - center[0], c - center[1]) for r, c in stamp]
+
+        for comp in marker_comps:
+            marker = comp[0]
+            rot = _rotation_for_marker(marker, center)
+            for dr, dc in offsets:
+                rr_off, cc_off = _rotate_offset(dr, dc, rot)
+                rr = marker[0] + rr_off
+                cc = marker[1] + cc_off
