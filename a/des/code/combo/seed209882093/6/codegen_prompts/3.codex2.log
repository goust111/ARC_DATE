+    seen: set[tuple[tuple[int, int], ...]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for transformed in (rot, np.fliplr(rot)):
+            coords = _coords_from_mask(transformed)
+            if coords not in seen:
+                seen.add(coords)
+                orbit.append(coords)
+    return orbit
