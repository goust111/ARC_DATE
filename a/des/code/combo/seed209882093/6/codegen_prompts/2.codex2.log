+def _sample_canvas_size(template: np.ndarray, piece_count: int, piece_h: int, piece_w: int) -> tuple[int, int]:
+    occupied = template.size + piece_count * piece_h * piece_w
+    min_side = max(
+        template.shape[0] + 2,
+        template.shape[1] + 2,
