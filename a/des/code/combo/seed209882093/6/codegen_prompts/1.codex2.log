+            seen[r, c] = True
+            q: deque[Point] = deque([(r, c)])
+            comp: List[Point] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
