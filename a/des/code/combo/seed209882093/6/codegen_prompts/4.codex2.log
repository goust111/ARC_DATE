+
+    grid, wall_rows, wall_cols = _build_input(heights, widths, h_doors, v_doors)
+    if _find_wall_lines(grid) != (wall_rows, wall_cols):
+        return None
+
+    expected = _expected_output(grid, wall_rows, wall_cols, totals)
+    try:
