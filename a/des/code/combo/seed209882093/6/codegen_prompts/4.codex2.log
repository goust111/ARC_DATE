+            out[r0 + 1 : r1, c0 + 1 : c1] = _color_for_doors(int(totals[i, j]))
+    return out
+
+
+def _good_variation(totals: np.ndarray, mode: str) -> bool:
+    colors = {_color_for_doors(int(v)) for v in totals.ravel().tolist()}
+    if int(totals.max()) == 0:
+        return False
+    if len(colors) < 2:
