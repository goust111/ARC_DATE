+
+        candidates: list[tuple[int, str, int, int, int]] = []
+        for idx, (kind, i, j, length) in enumerate(segments):
+            existing = h_doors[i][j] if kind == "h" else v_doors[i][j]
+            if _available_positions(existing, length):
