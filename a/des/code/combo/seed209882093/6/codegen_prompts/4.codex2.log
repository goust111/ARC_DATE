+def _room_door_totals(grid: np.ndarray, wall_rows: list[int], wall_cols: list[int]) -> np.ndarray:
+    room_rows = len(wall_rows) - 1
+    room_cols = len(wall_cols) - 1
+    totals = np.zeros((room_rows, room_cols), dtype=int)
