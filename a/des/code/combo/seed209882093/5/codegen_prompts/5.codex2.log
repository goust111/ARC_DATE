+def _overlay(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    window = dst[top : top + h, left : left + w]
+    mask = patch != BLACK
+    window[mask] = patch[mask]
