+        stamp = g[sr0 : sr1 + 1, sc0 : sc1 + 1]
+        _, target_side, body = _parse_stamp(stamp)
+        pr, pc = _placement(canvas_bbox, body.shape, target_side)
+        _overlay(out, body, pr, pc)
+
+    return out
+
