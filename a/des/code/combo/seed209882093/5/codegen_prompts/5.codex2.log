+def _mark_padded(occupied: np.ndarray, top: int, left: int, h: int, w: int, pad: int = 1) -> None:
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(occupied.shape[0], top + h + pad)
+    c1 = min(occupied.shape[1], left + w + pad)
+    occupied[r0:r1, c0:c1] = True
+
+
+def _zone_candidates(
