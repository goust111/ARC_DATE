+    nearest_right: list[int | None] = [None] * len(path)
+
+    last = None
+    for idx in range(len(path)):
+        if idx in stations:
+            last = idx
+        nearest_left[idx] = last
+
+    last = None
+    for idx in range(len(path) - 1, -1, -1):
+        if idx in stations:
+            last = idx
+        nearest_right[idx] = last
+
+    for idx in range(1, len(path) - 1):
+        r, c = path[idx]
