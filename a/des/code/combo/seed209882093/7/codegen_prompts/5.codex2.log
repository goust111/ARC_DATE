+
+def _component(start: tuple[int, int], mask: np.ndarray, seen: np.ndarray) -> set[tuple[int, int]]:
+    q = deque([start])
+    seen[start] = True
+    coords: set[tuple[int, int]] = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, mask.shape):
+            if mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                coords.add((nr, nc))
+                q.append((nr, nc))
