+        odd_choices = [v for v in range(1, remaining + 1, 2)]
+        forced = rng.choice(odd_choices)
+        gaps[gap_idx] = forced
+        remaining -= forced
+
+    for _ in range(remaining):
+        gaps[rng.randrange(len(gaps))] += 1
+
