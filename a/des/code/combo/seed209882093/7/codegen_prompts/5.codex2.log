+        starts = [(r, c) for r in range(box_h) for c in range(box_w)]
+        rng.shuffle(starts)
+
+        def search(
+            seg_idx: int,
+            prev_dir: tuple[int, int] | None,
+            path: list[tuple[int, int]],
+            used: set[tuple[int, int]],
