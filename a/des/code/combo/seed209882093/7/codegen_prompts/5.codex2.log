+    parts: list[int] = []
+    remaining = total
+    for idx in range(count):
+        slots = count - idx - 1
+        lo = max(lower, remaining - upper * slots)
+        hi = min(upper, remaining - lower * slots)
+        if lo > hi:
+            return None
+        value = rng.randint(lo, hi)
+        parts.append(value)
+        remaining -= value
+    return parts
+
