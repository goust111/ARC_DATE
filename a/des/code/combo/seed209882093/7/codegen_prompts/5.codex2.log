+        total_steps = rng.randint(PATH_LEN_MIN - 1, PATH_LEN_MAX - 1)
+        segment_count = rng.randint(1, min(6, total_steps))
+        run_lengths = _sample_composition(total_steps, segment_count, 1, max_run, rng)
+        if run_lengths is None:
