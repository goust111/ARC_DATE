+def _neighbors4(r: int, c: int, shape: tuple[int, int]):
+    h, w = shape
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _neighbors8(r: int, c: int, shape: tuple[int, int]):
+    h, w = shape
+    for dr, dc in DIRS8:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
