+    target = {tuple(map(int, coord)) for coord in coords}
+    stack = [next(iter(target))]
+    seen = set()
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in target and (nr, nc) not in seen:
+                stack.append((nr, nc))
