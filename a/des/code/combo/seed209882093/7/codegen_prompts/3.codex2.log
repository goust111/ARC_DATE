    anchor_idx = next((i for i, p in enumerate(pieces) if p["name"] == "anchor"), None)
    if anchor_idx is not None:
        remaining.remove(anchor_idx)
        marker_col = pieces[anchor_idx]["marker_color"]
        anchor_solutions = []
