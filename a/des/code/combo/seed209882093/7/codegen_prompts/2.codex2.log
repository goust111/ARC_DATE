+GEN_ATTEMPTS = 400
+
+
+def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _tight_mask_from_coords(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, (r0, c0)
+
+
+def _touches_subgrid_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = map(int, shape)
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 0] == h - 1)
+        or np.any(coords[:, 1] == 0)
+        or np.any(coords[:, 1] == w - 1)
+    )
+
+
+def _boundary_is_color(sub: np.ndarray, color: int) -> bool:
+    return bool(
+        np.all(sub[0, :] == color)
+        and np.all(sub[-1, :] == color)
+        and np.all(sub[:, 0] == color)
+        and np.all(sub[:, -1] == color)
