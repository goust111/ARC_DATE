+
+def _unique_rotations(mask: np.ndarray) -> list[tuple[int, np.ndarray]]:
+    out: list[tuple[int, np.ndarray]] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (tuple(map(int, rot.shape)), rot.astype(np.uint8).tobytes())
+        if key in seen:
