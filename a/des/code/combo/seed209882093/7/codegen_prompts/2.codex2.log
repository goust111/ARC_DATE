+def _unique_assignment(options: list[list[tuple[int, int]]]) -> tuple[list[tuple[int, int]] | None, int]:
+    n = len(options)
+    order = sorted(range(n), key=lambda i: len(options[i]))
+    chosen: list[tuple[int, int] | None] = [None] * n
+    used_frames: set[int] = set()
