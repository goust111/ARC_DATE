+def _build_fragment_patch(shape: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    rot_k = int(rng.integers(0, 4))
+    rot = np.rot90(shape, rot_k)
+    patch = np.zeros(rot.shape, dtype=int)
+    patch[rot] = GREY
