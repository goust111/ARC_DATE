+    order = list(rng.permutation(len(sizes)))
+    x = int(rng.integers(1, 3))
+    positions: list[tuple[int, int] | None] = [None] * len(sizes)
+    for idx_pos, idx in enumerate(order):
+        h, w = sizes[idx]
+        y = int(rng.integers(1, zone_h - h))
+        positions[idx] = (y, x)
+        x += w
