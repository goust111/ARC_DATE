+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, (r0, c0)
+
+
+def _touches_subgrid_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = map(int, shape)
