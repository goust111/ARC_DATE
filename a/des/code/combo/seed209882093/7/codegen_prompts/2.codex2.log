+    chosen: list[tuple[int, int] | None] = [None] * n
+    used_frames: set[int] = set()
+    solution: list[tuple[int, int]] | None = None
+    count = 0
+
+    def dfs(depth: int) -> None:
+        nonlocal solution, count
+        if count > 1:
+            return
+        if depth == n:
