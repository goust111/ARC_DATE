+
+    if grid_h < height or grid_w < width:
+        return None
+    col_lo, col_hi = 0, grid_w - width
+    if clip:
+        row_lo = max(0, grid_h - total_h + 1)
+        row_hi = grid_h - height
+    else:
+        row_lo = 0
+        row_hi = grid_h - total_h
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
