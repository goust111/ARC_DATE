+
+def _bbox_is_free(reserved: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    height, width = reserved.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(height - 1, r1 + 1)
