+
+def _build_specs() -> list[dict] | None:
+    n_objects = random.randint(*OBJECT_COUNT_RANGE)
+    hole_counts = _sample_hole_counts(n_objects)
+    orientations = _sample_orientations(n_objects)
+    colors = random.sample(COLORS, n_objects)
