+        if mask is None:
+            return None
+        axis = "h" if mask.shape[1] >= mask.shape[0] else "v"
+        specs.append(
+            {
+                "color": int(colors[i]),
+                "mask": mask,
+                "holes": int(hole_counts[i]),
+                "copies": int(hole_counts[i] + 1),
+                "axis": axis,
