+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+ORANGE = 7
+YELLOW = 4
+MAGENTA = 6
+
+LABEL_COLORS = (MAROON, ORANGE, YELLOW, MAGENTA)
+BODY_COLORS = (1, 2, 3, 8)
+QUADRANTS = ("tl", "tr", "bl", "br")
+CORNER_LABELS = {
+    "tl": MAROON,
+    "tr": ORANGE,
+    "bl": YELLOW,
+    "br": MAGENTA,
+}
+OUTER_SIDES = {
+    "tl": ("top", "left"),
+    "tr": ("top", "right"),
+    "bl": ("bottom", "left"),
+    "br": ("bottom", "right"),
