+def _can_place(canvas: np.ndarray, obj: np.ndarray, top: int, left: int, gap: int = 1) -> bool:
+    h, w = obj.shape
+    H, W = canvas.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return False
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(H, top + h + gap)
+    c1 = min(W, left + w + gap)
+    return bool(np.all(canvas[r0:r1, c0:c1] == BLACK))
