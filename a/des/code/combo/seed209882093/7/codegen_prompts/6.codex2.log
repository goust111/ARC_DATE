+    frame[:, 0] = GREY
+    frame[:, -1] = GREY
+    frame[0, 0] = MAROON
+    frame[0, -1] = ORANGE
+    frame[-1, 0] = YELLOW
+    frame[-1, -1] = MAGENTA
