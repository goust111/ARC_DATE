+
+def _boundary_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    boundary = np.zeros((h, w), dtype=bool)
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        for dr, dc in DIR4:
+            nr, nc = int(r + dr), int(c + dc)
+            if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                boundary[r, c] = True
+                break
