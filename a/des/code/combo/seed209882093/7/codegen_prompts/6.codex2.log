+    return _assemble_from_pieces(pieces, (int(r1 - r0 + 1), int(c1 - c0 + 1)))
+
+
+def _boundary_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    boundary = np.zeros((h, w), dtype=bool)
+    coords = np.argwhere(mask)
