+        piece = _orient_piece(pieces[quadrant], quadrant)
+        ph, pw = piece.shape
+        r0 = 0 if quadrant in ("tl", "tr") else h - ph
+        c0 = 0 if quadrant in ("tl", "bl") else w - pw
+        mask = piece != BLACK
