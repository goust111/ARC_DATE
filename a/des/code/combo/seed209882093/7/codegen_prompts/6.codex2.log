+    frame = np.zeros((h, w), dtype=int)
+    frame[0, :] = GREY
+    frame[-1, :] = GREY
+    frame[:, 0] = GREY
+    frame[:, -1] = GREY
+    frame[0, 0] = MAROON
+    frame[0, -1] = ORANGE
+    frame[-1, 0] = YELLOW
+    frame[-1, -1] = MAGENTA
+    return frame
+
+
+def _placement_bounds(canvas_shape, top: int, left: int, obj_shape, gap: int):
+    h, w = obj_shape
+    H, W = canvas_shape
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(H, top + h + gap)
+    c1 = min(W, left + w + gap)
+    return r0, c0, r1, c1
+
+
+def _can_place(
+    canvas: np.ndarray,
+    obj: np.ndarray,
+    top: int,
+    left: int,
+    gap: int = 1,
+    blocked: np.ndarray | None = None,
+) -> bool:
+    h, w = obj.shape
+    H, W = canvas.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return False
+    r0, c0, r1, c1 = _placement_bounds(canvas.shape, top, left, obj.shape, gap)
+    if blocked is not None and np.any(blocked[r0:r1, c0:c1]):
+        return False
+    return bool(np.all(canvas[r0:r1, c0:c1] == BLACK))
+
+
+def _place(
+    canvas: np.ndarray,
+    obj: np.ndarray,
+    rng: np.random.Generator,
+    gap: int = 1,
+    blocked: np.ndarray | None = None,
+) -> bool:
+    h, w = obj.shape
+    H, W = canvas.shape
+    for _ in range(400):
+        top = int(rng.integers(1, H - h))
+        left = int(rng.integers(1, W - w))
+        if not _can_place(canvas, obj, top, left, gap=gap, blocked=blocked):
+            continue
+        mask = obj != BLACK
+        canvas[top : top + h, left : left + w][mask] = obj[mask]
+        if blocked is not None:
+            r0, c0, r1, c1 = _placement_bounds(canvas.shape, top, left, obj.shape, gap)
+            blocked[r0:r1, c0:c1] = True
+        return True
+    return False
