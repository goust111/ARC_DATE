+    return {
+        int(grid[r0, c0]): "tl",
+        int(grid[r0, c1]): "tr",
+        int(grid[r1, c0]): "bl",
+        int(grid[r1, c1]): "br",
+    }
+
+
+def _piece_body_color(arr: np.ndarray, label_color: int) -> int:
+    colors = set(map(int, arr[arr != BLACK].flatten()))
+    colors.discard(GREY)
+    colors.discard(int(label_color))
+    assert len(colors) == 1
+    return next(iter(colors))
+
+
+def _extract_pieces(grid: np.ndarray, frame_bbox):
