+def _random_profile(rng: np.random.Generator, length: int, base: int) -> np.ndarray:
+    while True:
+        offsets = rng.integers(-1, 2, size=length)
+        profile = base + offsets
+        if len(set(map(int, profile.tolist()))) >= 2:
+            return profile.astype(int)
