+def _random_edge_pair(
+    rng: np.random.Generator,
+    length: int,
+    both_true_positions=(),
+):
+    forced = set(int(i) for i in both_true_positions)
+    while True:
+        a = np.ones(length, dtype=bool)
+        b = np.ones(length, dtype=bool)
+        for i in range(length):
+            if i in forced:
+                continue
+            state = int(rng.integers(0, 3))
+            if state == 0:
+                a[i], b[i] = True, False
+            elif state == 1:
+                a[i], b[i] = False, True
+            else:
