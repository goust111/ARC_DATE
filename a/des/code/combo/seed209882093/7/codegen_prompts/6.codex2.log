+    canvas_w = int(max(24, solution.shape[1] + 2 * max_w + 10 + rng.integers(0, 5)))
+    canvas = np.zeros((canvas_h, canvas_w), dtype=int)
+
+    objects = [frame] + piece_arrays
+    order = list(rng.permutation(len(objects)))
+    placed = [None] * len(objects)
+    for idx in order:
