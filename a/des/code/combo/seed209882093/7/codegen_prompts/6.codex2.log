+def _owner_grid(height: int, width: int, hsplit: np.ndarray, vsplit: np.ndarray) -> np.ndarray:
+    owner = np.empty((height, width), dtype="<U2")
+    for r in range(height):
+        for c in range(width):
+            top = r < int(hsplit[c])
+            left = c < int(vsplit[r])
+            if top and left:
+                owner[r, c] = "tl"
+            elif top:
+                owner[r, c] = "tr"
+            elif left:
+                owner[r, c] = "bl"
+            else:
+                owner[r, c] = "br"
