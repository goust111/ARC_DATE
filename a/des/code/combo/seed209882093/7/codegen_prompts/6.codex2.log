+    for r, c in coords:
+        for dr, dc in DIR4:
+            nr, nc = int(r + dr), int(c + dc)
+            if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                boundary[r, c] = True
+                break
