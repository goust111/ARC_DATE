+    H, W = canvas.shape
+    for _ in range(400):
+        top = int(rng.integers(1, H - h))
+        left = int(rng.integers(1, W - w))
+        if not _can_place(canvas, obj, top, left, gap=gap):
+            continue
+        mask = obj != BLACK
+        canvas[top : top + h, left : left + w][mask] = obj[mask]
+        return True
