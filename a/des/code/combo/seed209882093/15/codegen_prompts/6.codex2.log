+
+GEN_ATTEMPTS = 500
+PAIR_PLACEMENT_ATTEMPTS = 80
+
+INTERIOR_H_MIN, INTERIOR_H_MAX = 8, 16
+INTERIOR_W_MIN, INTERIOR_W_MAX = 8, 18
+EXTRA_MARGIN_MIN, EXTRA_MARGIN_MAX = 2, 6
