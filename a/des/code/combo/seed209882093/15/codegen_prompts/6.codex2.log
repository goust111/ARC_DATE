+    passable: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = passable.shape
+    q = deque([start])
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+
+    while q:
+        r, c = q.popleft()
+        if (r, c) == goal:
+            break
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
