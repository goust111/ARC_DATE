+    fg_mask = g != BLACK
+    if not np.any(fg_mask):
+        return g.copy()
+
+    frame_bbox = _bbox(fg_mask)
+    r0, c0, r1, c1 = frame_bbox
+    bg = BLACK
+    wall = _wall_color(g, frame_bbox, bg)
+    ports = _ports(g, frame_bbox, bg, wall)
