+
+
+def _reserve_path(blocked: np.ndarray, path: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in path:
+        blocked[r, c] = True
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
