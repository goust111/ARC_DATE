+
+
+def _port_global(
+    side: str,
+    entry: tuple[int, int],
+    frame_top: int,
+    frame_left: int,
+    interior_h: int,
+    interior_w: int,
+) -> tuple[int, int]:
+    r, c = entry
+    if side == "top":
+        return frame_top, frame_left + 1 + c
+    if side == "bottom":
