+
+def _ports(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    bg: int,
+    wall: int,
+) -> dict[int, list[tuple[int, int]]]:
+    r0, c0, r1, c1 = frame_bbox
+    by_color: dict[int, list[tuple[int, int]]] = {}
+    for r, c in _border_coords(r0, c0, r1, c1):
+        value = int(grid[r, c])
+        if value in (bg, wall):
