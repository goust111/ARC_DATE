+    return candidates
+
+
+def _path_via_waypoints(
+    free: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    waypoints: list[tuple[int, int]],
+    rng: np.random.Generator,
+) -> list[tuple[int, int]] | None:
+    path: list[tuple[int, int]] = []
+    current = start
+    working = free.copy()
+    checkpoints = waypoints + [goal]
+
+    for checkpoint in checkpoints:
+        working[current] = True
