+def _jittered_split(total: int, rng: np.random.Generator) -> tuple[int, int]:
+    base = total // 2
+    lo = max(1, base - 1)
+    hi = min(total - 1, base + 1)
+    first = int(rng.integers(lo, hi + 1))
+    return first, total - first
