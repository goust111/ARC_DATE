+    grid = np.full((grid_h, grid_w), BLACK, dtype=int)
+    grid[frame_top : frame_top + frame_h, frame_left : frame_left + frame_w] = GREY
+
+    for color, side_a, entry_a, side_b, entry_b, path in pair_specs:
