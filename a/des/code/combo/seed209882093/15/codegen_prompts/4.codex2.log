+
+def _free_cells(
+    shape: tuple[int, int],
+    occupied_input: set[tuple[int, int]],
+    occupied_output: set[tuple[int, int]],
+    blocked_input: set[tuple[int, int]],
+    blocked_output: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
