+
+def _halo(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    h, w = map(int, shape)
+    for r, c in cells:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if 0 <= rr < h and 0 <= cc < w:
