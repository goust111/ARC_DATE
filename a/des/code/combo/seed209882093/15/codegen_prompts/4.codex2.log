+
+def _translate(coords: np.ndarray, dr: int, dc: int) -> np.ndarray:
+    return np.asarray(coords, dtype=int) + np.array([int(dr), int(dc)], dtype=int)
+
+
+def _coords_set(coords: np.ndarray) -> set[tuple[int, int]]:
