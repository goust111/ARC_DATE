+def _normalize_coords(coords: np.ndarray) -> np.ndarray:
+    arr = _sorted_coords(coords)
+    arr = arr - np.array([int(arr[:, 0].min()), int(arr[:, 1].min())], dtype=int)
+    return _sorted_coords(arr)
