+def _validate_instance(grid: np.ndarray, expected_regions: int, colors: set[int]) -> bool:
+    present = {int(v) for v in np.unique(grid)} - {BG, BORDER}
+    if present != colors:
+        return False
+
+    stripes = _stripe_map(grid)
+    if set(stripes) != colors:
