+        if len(seen_colors) != 1:
+            return False
+
+    out = main(grid)
+    return bool(np.any(out != grid))
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(*GRID_H_RANGE)
+    w = rng.randint(*GRID_W_RANGE)
+    n_regions = rng.choice(REGION_COUNT_CHOICES)
