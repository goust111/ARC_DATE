+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    shape = grid.shape
+    step = DIR_TO_STEP[direction]
+    offsets = _pattern_offsets_for_direction(direction)
+
+    mids = [(r, c) for r in range(1, shape[0] - 1) for c in range(1, shape[1] - 1)]
+    rng.shuffle(mids)
