+            return chosen
+    return None
+
+
+def _weighted_choice(items: list[tuple[int, object]]) -> object:
+    total = sum(weight for weight, _ in items)
+    pick = random.randint(1, total)
+    acc = 0
+    for weight, value in items:
+        acc += weight
+        if pick <= acc:
+            return value
+    return items[-1][1]
