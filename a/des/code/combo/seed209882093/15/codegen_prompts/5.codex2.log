+
+def _free_run(
+    shape: tuple[int, int],
+    origin: tuple[int, int],
+    direction: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    r, c = origin
+    dr, dc = direction
+    cells = []
+    while True:
+        r += dr
+        c += dc
+        if not in_bounds(shape, r, c):
+            break
+        if (r, c) in blocked:
+            break
+        cells.append((r, c))
+    return cells
+
+
+def _emitter_candidates(shape: tuple[int, int]) -> list[dict[str, object]]:
+    h, w = shape
