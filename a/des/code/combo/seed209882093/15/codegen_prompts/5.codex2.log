+    grid = np.full(shape, BG, dtype=int)
+    for emitter, color in zip(emitters, emitter_colors):
+        for r, c in emitter["cells"]:
+            grid[r, c] = color
+    for spot, color in zip(prism_spots, prism_colors):
+        grid[spot] = color
+    for r, c in walls:
+        grid[r, c] = GREY
