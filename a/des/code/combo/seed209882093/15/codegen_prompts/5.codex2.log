+    for comp in _components(grid):
+        color = int(comp["color"])
+        coords = list(comp["coords"])
+        if color == GREY:
+            assert all(
+                r in {0, grid.shape[0] - 1} or c in {0, grid.shape[1] - 1} for r, c in coords
