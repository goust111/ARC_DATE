+
+def _cast_rays(
+    out: np.ndarray,
+    emitters: list[dict[str, object]],
+    prisms: dict[tuple[int, int], int],
+    walls: set[tuple[int, int]],
+    emitter_cells: set[tuple[int, int]],
+) -> np.ndarray:
+    pending = [
+        (tuple(emitter["origin"]), tuple(emitter["direction"]), int(emitter["color"]))
+        for emitter in emitters
