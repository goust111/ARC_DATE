+def _coords_to_mask(coords: set[tuple[int, int]]) -> np.ndarray:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, c0 = min(rows), min(cols)
+    h = max(rows) - r0 + 1
+    w = max(cols) - c0 + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
