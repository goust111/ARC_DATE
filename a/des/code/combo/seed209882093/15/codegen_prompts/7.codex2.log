+
+def _make_both(rng: random.Random) -> np.ndarray:
+    mask = BOTH_PATTERNS[rng.randrange(len(BOTH_PATTERNS))].copy()
+    mask = _random_dihedral(mask, rng)
+    assert _symmetry_category(mask) == "both"
+    return mask
