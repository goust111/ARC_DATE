+                if not _is_connected(mask):
+                    continue
+                cat = _symmetry_category(mask)
+                if cat == "both":
+                    both.append(mask)
+                elif cat == "lr":
+                    lr.append(mask)
+
+    rectangles = [(1, 4), (4, 1), (2, 2), (2, 3), (3, 2), (2, 4), (4, 2)]
+    both.extend(np.ones((h, w), dtype=bool) for h, w in rectangles)
+
+    both = _dedupe_masks(both)
+    lr = _dedupe_masks(lr)
+    assert both and lr
+    return both, lr
