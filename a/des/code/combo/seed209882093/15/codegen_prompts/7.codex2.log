+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    start = tuple(int(x) for x in pts[0])
+    seen = {start}
+    queue = deque([start])
+    h, w = mask.shape
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if not mask[nr, nc] or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            queue.append((nr, nc))
+    return len(seen) == len(pts)
