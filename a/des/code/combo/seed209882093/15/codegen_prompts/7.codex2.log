+    gh, gw = grid.shape
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for r in range(gh - mh + 1):
+        rr0 = max(0, r - 1)
+        rr1 = min(gh, r + mh + 1)
+        for c in range(gw - mw + 1):
+            cc0 = max(0, c - 1)
+            cc1 = min(gw, c + mw + 1)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+            candidates.append((r, c))
+    if not candidates:
+        return False
