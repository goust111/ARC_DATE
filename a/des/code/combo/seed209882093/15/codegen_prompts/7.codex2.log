+    r, c = rng.choice(candidates)
+    grid[r : r + mh, c : c + mw][mask] = color
+    occupied[max(0, r - 1) : min(gh, r + mh + 1), max(0, c - 1) : min(gw, c + mw + 1)] = True
+    return True
