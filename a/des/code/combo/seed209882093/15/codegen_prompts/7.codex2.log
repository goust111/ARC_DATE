+    lr_sym = np.array_equal(mask, np.fliplr(mask))
+    ud_sym = np.array_equal(mask, np.flipud(mask))
+    if lr_sym and ud_sym:
+        return "both"
+    if lr_sym:
+        return "lr"
+    if ud_sym:
+        return "ud"
+    return "asym"
