+def _count_objects(grid: np.ndarray) -> int:
+    work = grid.copy()
+    work[grid.shape[0] - 6 :, grid.shape[1] - 6 :] = BG
+    count = 0
+    for color in np.unique(work):
+        if int(color) == BG:
+            continue
+        count += len(_connected_components_of_color(work, int(color)))
+    return count
