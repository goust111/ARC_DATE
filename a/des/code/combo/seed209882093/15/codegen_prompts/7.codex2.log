45:     expected_divider[cr, cc] = False
46:     assert np.array_equal(g == divider_color, expected_divider)
47: 
48:     source_mask = (g != bg) & (g != marker_color) & (g != divider_color)
49:     source_coords = np.argwhere(source_mask)
