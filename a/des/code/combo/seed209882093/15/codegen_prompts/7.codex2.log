+
+def _make_ud(rng: random.Random) -> np.ndarray:
+    mask = LR_PATTERNS[rng.randrange(len(LR_PATTERNS))].T.copy()
+    if rng.random() < 0.5:
+        mask = np.fliplr(mask)
+    mask = _trim_mask(mask)
+    assert _symmetry_category(mask) == "ud"
