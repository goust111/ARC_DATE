7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Complete the scene by adding the point-reflected copy of the colored object across the central marker.
10: 
11:     Input structure
12:     - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.
13:     - A single divider color fills the center column except for the center marker.
14:     - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.
15:     Rule
16:     - Keep the input unchanged.
17:     - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.
18:     Key insight
19:     - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.
20:     """
21:     g = np.asarray(grid, dtype=int)
22:     assert g.ndim == 2
23:     h, w = g.shape
24:     assert h % 2 == 1 and w % 2 == 1
25: 
26:     cr, cc = h // 2, w // 2
27:     bg = int(get_bg(g))
28: 
29:     marker_color = int(g[cr, cc])
30:     assert marker_color != bg
31:     marker_mask = g == marker_color
