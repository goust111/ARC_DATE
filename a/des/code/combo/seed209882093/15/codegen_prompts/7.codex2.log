43: def main(grid: np.ndarray) -> np.ndarray:
44:     """
45:     Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.
46: 
47:     Input structure
48:     - Full same-color separator rows and columns partition the grid into equal rectangular tiles.
49:     - One tile contains the only non-background, non-separator colored sprite.
50:     - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.
51: 
52:     Rule
53:     - Keep the separator lines and the source sprite tile unchanged.
54:     - Replace each marked target tile with an exact copy of the source tile.
55:     - Unmarked background-only tiles remain unchanged.
56: 
57:     Key insight
58:     - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.
59:     """
60:     g = np.asarray(grid, dtype=int)
61:     assert g.ndim == 2 and g.size > 0, "expected a nonempty 2D grid"
62: 
63:     separator, sep_rows, sep_cols = _separator_lines(g)
64:     row_spans = _spans(g.shape[0], sep_rows)
65:     col_spans = _spans(g.shape[1], sep_cols)
66: 
67:     tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}
68:     tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}
69:     assert len(tile_heights) == 1 and len(tile_widths) == 1, "expected equal-sized tile rows and columns"
70:     tile_h = tile_heights.pop()
71:     tile_w = tile_widths.pop()
72: 
73:     bg = _unique_mode(g[g != separator])
74:     assert bg != separator, "background and separator colors must differ"
75:     sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]
76:     assert len(sprite_colors) == 1, "expected one sprite color"
77:     sprite_color = sprite_colors[0]
78: 
79:     source_tiles = []
80:     marked_origins = []
81:     for r0, r1 in row_spans:
82:         for c0, c1 in col_spans:
83:             tile = g[r0 : r1 + 1, c0 : c1 + 1]
84:             assert tile.shape == (tile_h, tile_w)
85:             has_sprite = np.any(tile == sprite_color)
86:             has_marker = np.any(tile == separator)
87:             if has_sprite:
88:                 assert not has_marker, "source tile should contain only sprite and background"
89:                 assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})
90:                 source_tiles.append(tile.copy())
91:             elif has_marker:
92:                 assert set(map(int, np.unique(tile))).issubset({bg, separator})
93:                 marked_origins.append((r0, c0))
94:             else:
95:                 assert np.all(tile == bg), "unmarked non-source tiles should be plain background"
96: 
97:     assert len(source_tiles) == 1, "expected exactly one source sprite tile"
98:     source_tile = source_tiles[0]
99: 
100:     out = g.copy()
101:     for r0, c0 in marked_origins:
102:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile
103:     return out
