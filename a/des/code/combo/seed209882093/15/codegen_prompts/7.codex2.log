+
+def _random_dihedral(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = np.rot90(mask, rng.randrange(4))
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    return _trim_mask(out)
