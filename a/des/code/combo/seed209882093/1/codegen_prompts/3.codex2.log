+            c = random.randint(c0 + 1, c1 - 1)
+            grid[r0, c] = BG
+        elif side == "bottom":
+            c = random.randint(c0 + 1, c1 - 1)
+            grid[r1, c] = BG
+        elif side == "left":
+            r = random.randint(r0 + 1, r1 - 1)
+            grid[r, c0] = BG
+        else:
+            r = random.randint(r0 + 1, r1 - 1)
+            grid[r, c1] = BG
+
