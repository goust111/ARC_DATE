+
+    for box, count in zip(ring_boxes, gap_counts):
+        _carve_gaps(grid, box, count)
+
+    if not np.all(grid[0, PALETTE_LEN:] == BG):
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape:
