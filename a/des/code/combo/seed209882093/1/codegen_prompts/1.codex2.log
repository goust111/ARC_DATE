+    grid[r1, c : c1 + 1] = color
+    grid[r : r1 + 1, c] = color
+    grid[r : r1 + 1, c1] = color
+
+
+def _attempt_generate() -> tuple[np.ndarray, np.ndarray] | None:
+    legend_count = random.randint(*LEGEND_COUNT_RANGE)
