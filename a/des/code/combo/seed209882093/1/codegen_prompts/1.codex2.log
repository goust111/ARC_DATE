+    patch[:, 0] = border_color
+    patch[:, -1] = border_color
+    patch[1:4, 1:4] = pattern
+    return patch
+
+
+def _draw_hollow_rectangle(grid: np.ndarray, r: int, c: int, inner_h: int, inner_w: int, color: int) -> None:
+    r1 = r + inner_h + 1
+    c1 = c + inner_w + 1
