+# --------------- generator ---------------
+
+BG = 0
+ALL_COLORS = list(range(1, 10))
+GRID_H_RANGE = (25, 34)
+GRID_W_RANGE = (26, 34)
+SEP_ROW_RANGE = (7, 13)
+LEGEND_COUNT_RANGE = (2, 4)
+RECT_COUNT_RANGE = (3, 6)
+INNER_H_RANGE = (3, 9)
+INNER_W_RANGE = (3, 10)
+PADDING = 1
+MARGIN = 1
+GEN_RETRIES = 400
