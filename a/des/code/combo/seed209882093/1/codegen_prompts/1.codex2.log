+def _is_exact_frame(pts: list[tuple[int, int]], bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 2 or w < 2:
+        return False
+    if len(pts) != 2 * h + 2 * w - 4:
+        return False
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in pts:
+        mask[r - r0, c - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(mask, expected))
