+                continue
+            patch = grid[r : r + 5, c : c + 5]
+            if not _is_legend_block(patch, bg):
+                continue
+            border_color = int(patch[0, 0])
+            blocks.append((border_color, (r, c, r + 4, c + 4), patch[1:4, 1:4].copy()))
+            used[r : r + 5, c : c + 5] = True
+    return blocks
