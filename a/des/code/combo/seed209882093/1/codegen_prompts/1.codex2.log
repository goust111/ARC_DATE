+
+def _tile(pattern: np.ndarray, height: int, width: int) -> np.ndarray:
+    reps_r = (height + pattern.shape[0] - 1) // pattern.shape[0]
+    reps_c = (width + pattern.shape[1] - 1) // pattern.shape[1]
