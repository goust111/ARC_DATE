+    specs: list[tuple[int, int, int]] = []
+    for color in rect_colors:
+        inner_h = random.randint(*INNER_H_RANGE)
+        inner_w = random.randint(*INNER_W_RANGE)
+        specs.append((color, inner_h, inner_w))
