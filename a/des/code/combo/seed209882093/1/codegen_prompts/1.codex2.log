+            rects.append((color, (sep_row + 1 + r0, c0, sep_row + 1 + r1, c1)))
+    rects.sort(key=lambda item: item[1])
+    return rects
+
+
+def _find_separator_row(grid: np.ndarray, bg: int) -> int:
+    h = grid.shape[0]
+    candidates = [
