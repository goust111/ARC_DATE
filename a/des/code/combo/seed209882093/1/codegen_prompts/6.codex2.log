+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in _NEIGHBORS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _rect_contains(box: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    ir0, ic0, ir1, ic1 = inner
+    return r0 <= ir0 and c0 <= ic0 and r1 >= ir1 and c1 >= ic1
+
+
+def _frame_candidate(coords: np.ndarray, color: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    side_h = r1 - r0 + 1
+    side_w = c1 - c0 + 1
+    if side_h != side_w or side_h < 4:
+        return None
+
+    mask = np.zeros((side_h, side_w), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros_like(mask)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(mask, border):
+        return None
+
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "side": int(side_h),
+    }
+
+
+def _scan_frame_candidates(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    found: list[dict] = []
+    seen = set()
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(grid[r0, c0])
+            if color == 0:
+                continue
+            max_side = min(h - r0, w - c0)
+            for side in range(4, max_side + 1):
+                r1 = r0 + side - 1
+                c1 = c0 + side - 1
+                if not (
+                    np.all(grid[r0, c0 : c1 + 1] == color)
+                    and np.all(grid[r1, c0 : c1 + 1] == color)
+                    and np.all(grid[r0 : r1 + 1, c0] == color)
+                    and np.all(grid[r0 : r1 + 1, c1] == color)
+                ):
