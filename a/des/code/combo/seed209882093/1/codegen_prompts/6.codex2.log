+
+_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_INSTRUCTION_ROTATIONS = {
+    ((0, 0), (1, 0), (1, 1)): 3,  # opening right -> clockwise 90
+    ((0, 1), (1, 0), (1, 1)): 2,  # opening up -> 180
