+    order = sorted(range(len(shapes)), key=lambda i: shapes[i][0] * shapes[i][1], reverse=True)
+
+    for idx in order:
+        h, w = shapes[idx]
+        choices = [
+            (r, c)
+            for r in range(1, height - h)
+            for c in range(1, width - w)
