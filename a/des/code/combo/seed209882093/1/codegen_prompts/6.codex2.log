+        if inst is None:
+            continue
+        r0, c0, r1, c1 = frame["bbox"]
+        inner = g[r0 + 1 : r1, c0 + 1 : c1]
+        out[r0 + 1 : r1, c0 + 1 : c1] = np.rot90(inner, inst["rotation"])
+
+    return out
