+import random
+from collections.abc import Iterable
+
+import numpy as np
+
+
+BG = 0
+PATH = 5
+WALL = 9
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8]
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+ROOM_H_RANGE = (7, 11)
+ROOM_W_RANGE = (7, 11)
+GEN_RETRIES = 400
+ROOM_PLACEMENT_TRIES = 80
+ROOM_CONTENT_TRIES = 80
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(np.min(coords[:, 0])),
+        int(np.min(coords[:, 1])),
+        int(np.max(coords[:, 0])),
+        int(np.max(coords[:, 1])),
+    )
+
+
+def _is_rectangular_room(grid: np.ndarray, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    if r1 - r0 < 4 or c1 - c0 < 4:
+        return False
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not bool(np.all(patch[0, :] == WALL)):
+        return False
+    if not bool(np.all(patch[-1, :] == WALL)):
+        return False
+    if not bool(np.all(patch[:, 0] == WALL)):
+        return False
+    if not bool(np.all(patch[:, -1] == WALL)):
+        return False
+    if bool(np.any(patch[1:-1, 1:-1] == WALL)):
+        return False
+    return True
+
