+def _gen_attempt(rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    coarse_h = rng.randint(4, 5)
+    coarse_w = rng.randint(4, 5)
+    scale_r = rng.randint(2, 3)
+    scale_c = rng.randint(2, 3)
