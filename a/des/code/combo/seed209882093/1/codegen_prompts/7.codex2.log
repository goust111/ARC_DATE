+            if br1 - br0 != 1 or bc1 - bc0 != 1:
+                continue
+            if np.all(outside[br0 : br1 + 1, bc0 : bc1 + 1] == color):
+                by_color.setdefault(color, set()).add("expand")
+                used[coords[:, 0], coords[:, 1]] = True
+
+    for r in range(h - 2):
+        for c in range(w - 2):
+            patch = outside[r : r + 3, c : c + 3]
+            color = int(patch[0, 0])
+            if color == 0:
+                continue
