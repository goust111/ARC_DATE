+            min_size = min(sizes[idx] for idx, _ in expandable)
+            pool = [(idx, frontier) for idx, frontier in expandable if sizes[idx] <= min_size + 1]
+            idx, frontier = rng.choice(pool)
+            nr, nc = rng.choice(frontier)
