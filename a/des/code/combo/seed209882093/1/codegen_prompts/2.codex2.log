+            if len(forward) < 1:
+                continue
+            if any(occupied[r, c] or reserved_rays[r, c] for r, c in forward):
+                continue
+
+            _paint_cells(grid, body, body_color)
+            _paint_cells(grid, [tip], tip_color)
+            _mark(occupied, arrow_cells)
+            _mark(reserved_rays, forward)
