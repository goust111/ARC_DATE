+def _arrow_body_cells(
+    tip: tuple[int, int],
+    direction: tuple[int, int],
+    body_len: int,
+) -> list[tuple[int, int]]:
+    tr, tc = map(int, tip)
+    dr, dc = map(int, direction)
+    return [(tr - dr * k, tc - dc * k) for k in range(1, body_len + 1)]
+
