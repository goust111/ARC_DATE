+
+            return [(r, c) for r in range(top, top + rect_h) for c in range(left, left + rect_w)]
+
+        rect_w = random.randint(1, min(3, width))
+        left_lo = max(0, bc - rect_w + 1)
+        left_hi = min(bc, width - rect_w)
