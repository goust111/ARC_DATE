+        queue = deque([(r, c)])
+        seen[r, c] = True
+        pts: list[tuple[int, int]] = []
+        while queue:
+            cr, cc = queue.popleft()
+            pts.append((cr, cc))
+            for dr, dc in DIRS4:
+                nr = cr + dr
+                nc = cc + dc
+                if _in_bounds(height, width, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
