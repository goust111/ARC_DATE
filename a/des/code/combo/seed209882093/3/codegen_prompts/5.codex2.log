+BG = 0
+GRID_COLOR = 3
+OBJECT_COLORS = [1, 2, 4, 5, 6, 7, 8, 9]
+
+CELL_ROW_RANGE = (2, 5)
+CELL_COL_RANGE = (2, 5)
