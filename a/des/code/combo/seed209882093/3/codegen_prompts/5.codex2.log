+CELL_COL_RANGE = (2, 5)
+CELL_H_RANGE = (4, 9)
+CELL_W_RANGE = (4, 9)
+MAX_TOTAL_CELLS = 9
+MAX_GENERATION_ATTEMPTS = 400
