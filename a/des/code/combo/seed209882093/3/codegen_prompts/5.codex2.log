+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+GRID_COLOR = 3
+OBJECT_COLORS = [1, 2, 4, 5, 6, 7, 8, 9]
+
+CELL_ROW_RANGE = (2, 5)
+CELL_COL_RANGE = (2, 5)
+CELL_H_RANGE = (4, 9)
+CELL_W_RANGE = (4, 9)
+MAX_TOTAL_CELLS = 9
+MAX_GENERATION_ATTEMPTS = 400
