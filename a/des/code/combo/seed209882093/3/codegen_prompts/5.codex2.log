+        for j in range(len(line_cols) - 1):
+            r0 = int(line_rows[i]) + 1
+            r1 = int(line_rows[i + 1])
+            c0 = int(line_cols[j]) + 1
+            c1 = int(line_cols[j + 1])
+            spans.append((r0, r1, c0, c1))
+    return spans
