+        elif rect_h >= 4:
+            rr = int(rng.integers(r0 + 1, r1 - 1))
+            mask[rr, c0:c1] = True
+    return mask
+
+
+def _make_shape(rng: np.random.Generator, h: int, w: int) -> np.ndarray | None:
