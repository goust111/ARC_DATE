+        clip_satisfied = clip_satisfied or bool(first["clipped"])
+
+        next_index = 1
+        if need_overlap:
+            second = _choose_object(
+                colors[1],
+                grid_h,
+                grid_w,
+                existing,
+                require_clip=False,
