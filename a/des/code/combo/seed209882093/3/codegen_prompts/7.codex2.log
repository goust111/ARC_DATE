+    a: tuple[int, int, int, int] | None, b: tuple[int, int, int, int] | None
+) -> bool:
+    if a is None or b is None:
+        return False
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
