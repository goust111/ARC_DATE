+def _normalize(points: list[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    min_r = min(r for r, _ in points)
+    min_c = min(c for _, c in points)
+    return frozenset((r - min_r, c - min_c) for r, c in points)
