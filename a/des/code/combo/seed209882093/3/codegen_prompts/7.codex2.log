+    box: tuple[int, int, int, int], grid_h: int, grid_w: int
+) -> tuple[int, int, int, int] | None:
+    r0 = max(0, int(box[0]))
+    c0 = max(0, int(box[1]))
+    r1 = min(grid_h - 1, int(box[2]))
+    c1 = min(grid_w - 1, int(box[3]))
