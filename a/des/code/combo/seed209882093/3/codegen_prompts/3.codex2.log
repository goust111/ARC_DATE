+        "down": sub[-1, 1:-1],
+        "left": sub[1:-1, 0],
+        "right": sub[1:-1, -1],
+    }
+
+    missing: list[str] = []
+    for name, strip in sides.items():
+        if np.all(~strip):
+            missing.append(name)
+        elif not np.all(strip):
+            return None
