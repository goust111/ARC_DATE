+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((int(rr), int(cc)))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            out.append(pts)
+    return out
+
+
+def _bbox(pts: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _component_mask(pts: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(pts)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in pts:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _rotate_mask(mask: np.ndarray, cw_steps: int) -> np.ndarray:
+    return np.rot90(mask.astype(bool), -int(cw_steps))
+
+
+def _u_frame_info(pts: list[tuple[int, int]]) -> dict[str, object] | None:
+    r0, c0, r1, c1 = _bbox(pts)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    sub = np.zeros((h, w), dtype=bool)
+    for r, c in pts:
+        sub[r - r0, c - c0] = True
+
+    if np.any(sub[1:-1, 1:-1]):
+        return None
+    if not (sub[0, 0] and sub[0, -1] and sub[-1, 0] and sub[-1, -1]):
+        return None
+
+    sides = {
+        "up": sub[0, 1:-1],
+        "down": sub[-1, 1:-1],
+        "left": sub[1:-1, 0],
+        "right": sub[1:-1, -1],
+    }
+
+    missing: list[str] = []
+    for name, strip in sides.items():
+        if np.all(~strip):
+            missing.append(name)
+        elif not np.all(strip):
+            return None
+
+    if len(missing) != 1:
+        return None
+
+    return {
+        "opening": missing[0],
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "interior_bbox": (int(r0 + 1), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+    }
