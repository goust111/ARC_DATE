+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+COLOR_ORDER = (MAROON, BLUE, GREEN, RED, MAGENTA, ORANGE, GREY)
+ORDER_INDEX = {color: i for i, color in enumerate(COLOR_ORDER)}
