+    pref_upper = pref_fit if is_last else pref_fit - 1
+    rev_upper = rev_fit if is_last else rev_fit - 1
+
+    pref: list[tuple[tuple[int, int], int]] = []
+    rev: list[tuple[tuple[int, int], int]] = []
