+    rows = sorted({r for r, _ in cells})
+    cols = sorted({c for _, c in cells})
+    if len(rows) == 1:
+        row = rows[0]
+        assert cols == list(range(cols[0], cols[-1] + 1))
+        assert len(cols) == len(cells) >= 2
+        orientation = "h"
+    elif len(cols) == 1:
+        col = cols[0]
+        assert rows == list(range(rows[0], rows[-1] + 1))
+        assert len(rows) == len(cells) >= 2
+        orientation = "v"
+    else:
