+            (origin[0] + direction[0] * k, origin[1] + direction[1] * k)
+            for k in range(length)
+        ]
+        assert all(_in_bounds(shape, cell) for cell in cells)
+
+        traced.append(
+            {
+                "color": color,
+                "orientation": orientation,
+                "length": length,
+                "dir": direction,
+                "cells": cells,
+                "origin": origin,
+                "end": cells[-1],
+            }
+        )
+        prev_end = cells[-1]
+        prev_dir = direction
+        prev_orientation = orientation
