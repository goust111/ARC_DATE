+
+def _span_from(origin: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = origin
+    dr, dc = direction
+    if dr == 1:
+        return h - r
+    if dr == -1:
+        return r + 1
+    if dc == 1:
+        return w - c
+    return c + 1
