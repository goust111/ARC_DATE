+def _trace_segments(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    segments: list[dict[str, int | str]],
+) -> list[dict[str, object]]:
+    traced: list[dict[str, object]] = []
+    prev_end: tuple[int, int] | None = None
+    prev_dir: tuple[int, int] | None = None
+    prev_orientation: str | None = None
