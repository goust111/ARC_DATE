+        traced.append(
+            {
+                "color": color,
+                "orientation": orientation,
+                "length": length,
+                "dir": direction,
+                "cells": cells,
+                "origin": origin,
+                "end": cells[-1],
+            }
+        )
+        prev_end = cells[-1]
+        prev_dir = direction
+        prev_orientation = orientation
+
+    return traced
+
+
+def _render_output(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    traced: list[dict[str, object]],
+) -> np.ndarray:
+    out = np.full(shape, BLACK, dtype=int)
+    out[start] = YELLOW
+    for seg in traced:
+        color = int(seg["color"])
+        for r, c in seg["cells"]:
+            assert int(out[r, c]) == BLACK
+            out[r, c] = color
+    return out
+
