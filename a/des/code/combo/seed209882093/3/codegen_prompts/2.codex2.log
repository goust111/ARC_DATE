+def _sample_portal_columns(width: int, count: int, min_gap: int) -> list[int] | None:
+    for _ in range(200):
+        cols = sorted(random.sample(range(width), count))
+        if all(b - a >= min_gap for a, b in zip(cols, cols[1:])):
