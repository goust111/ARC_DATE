+                min(sc0, anchor_c),
+                max(sr0 + sh - 1, anchor_r),
+                max(sc0 + sw - 1, anchor_c),
+            )
+            if _boxes_separated(expanded, canvas_bbox, gap=1):
+                out.append((sr0, sc0))
+    return out
+
