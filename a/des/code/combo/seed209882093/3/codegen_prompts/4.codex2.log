+def _frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = int(r) + dr
+            nc = int(c) + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
