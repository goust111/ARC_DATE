+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+STAMP_COLORS = (1, 3, 4, 6, 7, 8, 9)
+
+QUADRANTS = ("TL", "TR", "BL", "BR")
+QUADRANT_FLIPS = {
+    "TL": (False, False),
+    "TR": (True, False),
+    "BL": (False, True),
+    "BR": (True, True),
