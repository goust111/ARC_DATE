+
+
+_COLOR_KEYS = (
+    lambda cell: (cell[0], cell[1]),
+    lambda cell: (cell[1], cell[0]),
+    lambda cell: (cell[0] + cell[1], cell[0], cell[1]),
+    lambda cell: (cell[0] - cell[1], cell[0], cell[1]),
+)
+
+
+def _colorize_stamp(mask: np.ndarray) -> np.ndarray:
