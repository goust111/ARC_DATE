+    canvas_bbox = (canvas_r0, canvas_c0, canvas_r0 + canvas_h - 1, canvas_c0 + canvas_w - 1)
+
+    positions = _stamp_positions(height, width, canvas_bbox, (stamp_h, stamp_w), anchor)
