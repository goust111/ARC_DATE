+            return {"color": color, "cells": arrow_cells, "center": origin, "dir": direction}
+    return None
+
+
+def _place_boundary_arrow(
+    rng: random.Random,
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+    color: int,
+) -> dict | None:
