+        reserved.update(_expand_cells(rect_cells, h, w))
+        return True
+    return False
+
+
+def _validate_generated(grid: np.ndarray, expected_arrows: int) -> bool:
+    arrows = _collect_arrows(grid)
+    if len(arrows) != expected_arrows:
+        return False
+    if not np.any(grid == TARGET_COLOR):
+        return False
