+            _paint(grid, rect_cells, TARGET_COLOR)
+            _paint(grid, arrow_cells, color)
+            occupied.update(rect_cells)
+            occupied.update(arrow_cells)
+            reserved.update(_expand_cells(rect_cells, h, w))
