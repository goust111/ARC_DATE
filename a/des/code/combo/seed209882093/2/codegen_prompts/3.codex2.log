+    return h - 2 - r
+
+
+def _rect_cells(top: int, left: int, height: int, width: int) -> list[tuple[int, int]]:
+    return [(r, c) for r in range(top, top + height) for c in range(left, left + width)]
+
+
+def _choose_target_layout(
+    rng: random.Random,
+    h: int,
+    w: int,
+    direction: tuple[int, int],
+    rect_h: int,
+    rect_w: int,
