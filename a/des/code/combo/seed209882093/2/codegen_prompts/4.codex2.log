DISTRACTOR_DENSITY_RANGE = (0.03, 0.10)
MAX_DISTRACTOR_CLUSTERS = 4
DISTRACTOR_CLUSTER_TARGET_DIVISOR = 12
FORCE_CLUSTER_PROB = 0.70
