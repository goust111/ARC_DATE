+) -> Optional[Dict[int, int]]:
+    colors = sorted(left_options, key=lambda color: len(left_options[color]))
+    assigned: Dict[int, int] = {}
+
+    def backtrack(i: int) -> bool:
+        if i == len(colors):
+            return True
+        color = colors[i]
+        for left in left_options[color]:
