+    for top in range(top_lo, top_hi + 1):
+        for left in range(left_lo, left_hi + 1):
+            window = upper[top : top + size, left : left + size]
+            if window.shape != (size, size):
+                continue
+            if int(np.count_nonzero(window == color)) != total:
+                continue
