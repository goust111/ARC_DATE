+            cut = (c0 + c1) // 2
+            if not (left_min <= cut <= left_max):
+                raise ValueError("center split is not feasible")
+        else:
+            cut = rng.randint(left_min, left_max)
+        return (r0, c0, r1, cut), (r0, cut, r1, c1)
