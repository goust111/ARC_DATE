+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_sample(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: exhausted attempts")

