+    for room_id, (rect, color) in enumerate(zip(rects, colors)):
+        r0, c0, r1, c1 = rect
+        local[r0 : r1 + 1, c0] = AZURE
+        local[r0 : r1 + 1, c1] = AZURE
+        local[r0, c0 : c1 + 1] = AZURE
+        local[r1, c0 : c1 + 1] = AZURE
+        local[r0 + 1 : r1, c0 + 1 : c1] = color
+        room_ids[r0 + 1 : r1, c0 + 1 : c1] = room_id
