+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+# The task's "mix" rule is an explicit visible color precedence, not a numeric comparison.
+COLOR_PRIORITY = {
+    BLUE: 0,
+    RED: 1,
+    GREEN: 2,
+    YELLOW: 3,
+    GREY: 4,
+    MAGENTA: 5,
+    ORANGE: 6,
+    AZURE: 7,
+    MAROON: 8,
