+        r0, r1, c0, c1 = box
+        region_map[r0:r1 + 1, c0:c1 + 1] = region_id
+        seed_r = random.randint(r0, r1)
+        seed_c = random.randint(c0, c1)
+        grid[seed_r, seed_c] = color
