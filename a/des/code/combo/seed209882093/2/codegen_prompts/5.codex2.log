+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = a
+    r1, c1 = b
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        return [(r0, c) for c in range(c0, c1 + step, step)]
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        return [(r, c0) for r in range(r0, r1 + step, step)]
+    raise AssertionError("segment must be axis-aligned")
+
+
+def _path_cells(
+    start: tuple[int, int],
+    end: tuple[int, int],
+    mode: str,
+) -> list[tuple[int, int]]:
+    if mode == "hv":
+        corner = (start[0], end[1])
+    elif mode == "vh":
+        corner = (end[0], start[1])
+    else:
+        raise AssertionError(f"unknown mode {mode}")
+    first = _segment_cells(start, corner)
+    second = _segment_cells(corner, end)
+    return first + second[1:]
+
+
+def _box_footprint(center: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = center
+    return {(r + dr, c + dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)}
+
+
+def _expanded_box_footprint(
+    center: tuple[int, int],
+    height: int,
+    width: int,
+) -> set[tuple[int, int]]:
+    r, c = center
+    cells = set()
+    for rr in range(r - 2, r + 3):
+        for cc in range(c - 2, c + 3):
+            if 0 <= rr < height and 0 <= cc < width:
+                cells.add((rr, cc))
+    return cells
+
+
+def _box_patch(color: int, hole: bool) -> np.ndarray:
+    patch = np.full((3, 3), color, dtype=int)
+    if hole:
+        patch[1, 1] = BG
+    return patch
+
+
+def _find_components(g: np.ndarray) -> list[dict]:
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            r1 = int(arr[:, 0].max())
+            c0 = int(arr[:, 1].min())
+            c1 = int(arr[:, 1].max())
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
