+def _route_for_pair(boxes: list[dict]) -> tuple[tuple[int, int], tuple[int, int], str]:
+    a, b = boxes
+    if a["hole"] and b["hole"]:
+        start, end = sorted((a["center"], b["center"]))
+        return start, end, "hv"
+    if (not a["hole"]) and (not b["hole"]):
+        start, end = sorted((a["center"], b["center"]))
+        return start, end, "vh"
