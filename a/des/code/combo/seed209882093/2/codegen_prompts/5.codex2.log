    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
    if _has_flanked_boundary_gap(mask):
        return None
    if not is_contiguous(mask.astype(int), background=0, connectivity=4):
        return None
    return mask


