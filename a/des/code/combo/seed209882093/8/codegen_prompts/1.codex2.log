+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _rect_border_mask(h: int, w: int) -> np.ndarray:
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return border
+
+
+def _find_frame(
+    grid: np.ndarray,
+) -> tuple[int, int, tuple[int, int, int, int]]:
+    bg = _most_common_color(grid)
+    candidates: list[tuple[int, int, int, tuple[int, int, int, int]]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            local = np.zeros((h, w), dtype=bool)
+            local[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            if not np.array_equal(local, _rect_border_mask(h, w)):
+                continue
+            inside = grid[r0 + 1 : r1, c0 + 1 : c1]
+            if not np.any(inside != bg):
+                continue
+            candidates.append((h * w, len(comp), color, (r0, c0, r1, c1)))
+    assert candidates, "expected one rectangular frame"
+    candidates.sort(key=lambda item: (item[0], item[1]))
+    _, _, frame_color, frame_bbox = candidates[-1]
+    return bg, int(frame_color), frame_bbox
+
+
+def _extract_template_mask(
+    grid: np.ndarray,
