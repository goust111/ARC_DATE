+def _random_shortest_path(
+    start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]]:
+    r, c = start
+    path: list[tuple[int, int]] = []
+    while (r, c) != end:
+        options = []
+        if r < end[0]:
+            options.append((r + 1, c))
+        elif r > end[0]:
+            options.append((r - 1, c))
+        if c < end[1]:
+            options.append((r, c + 1))
+        elif c > end[1]:
+            options.append((r, c - 1))
+        r, c = random.choice(options)
+        path.append((r, c))
