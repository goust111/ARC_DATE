+def _draw_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    sub = grid[top : top + h, left : left + w]
+    mask = patch != bg
+    sub[mask] = patch[mask]
