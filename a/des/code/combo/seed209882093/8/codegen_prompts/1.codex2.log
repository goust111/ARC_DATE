    for comp in _components(grid == color):
        inside_frame = np.all(
            (comp[:, 0] > fr0)
            & (comp[:, 0] < fr1)
            & (comp[:, 1] > fc0)
            & (comp[:, 1] < fc1)
        )
        if inside_frame:
