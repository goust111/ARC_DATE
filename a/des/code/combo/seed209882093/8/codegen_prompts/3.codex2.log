+def _irregular_bbox_candidates(target_h: int, target_w: int) -> list[tuple[int, int]]:
+    area = target_h * target_w
+    candidates: list[tuple[int, int]] = []
+    for extra_h in range(MAX_BBOX_EXTENSION + 1):
