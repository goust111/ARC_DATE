+
+
+def _extract_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    height, width = g.shape
+    seen = np.zeros((height, width), dtype=bool)
+    components: list[dict] = []
+
