T2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range
ORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling
PATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call
