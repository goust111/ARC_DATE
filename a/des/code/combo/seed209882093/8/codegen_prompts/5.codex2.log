+def _allowed_sides(row: int, col: int, n_rows: int, n_cols: int) -> list[str]:
+    sides: list[str] = []
+    if row == 0:
+        sides.append("top")
+    if row == n_rows - 1:
+        sides.append("bottom")
+    if col == 0:
+        sides.append("left")
+    if col == n_cols - 1:
+        sides.append("right")
+    return sides
