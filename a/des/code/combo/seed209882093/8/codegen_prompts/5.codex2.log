+
+def _partition_positive(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    prev = 0
+    lengths: list[int] = []
+    for cut in cuts + [total]:
