+        "top": [(r0, c) for c in range(c0 + 1, c1)],
+        "bottom": [(r1, c) for c in range(c0 + 1, c1)],
+        "left": [(r, c0) for r in range(r0 + 1, r1)],
+        "right": [(r, c1) for r in range(r0 + 1, r1)],
+    }
+
+    found: list[tuple[str, tuple[int, int]]] = []
