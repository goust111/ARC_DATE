+    for box in _room_boxes(grid):
+        r0, r1, c0, c1 = box
+        side, gap = _find_gap(grid, box)
+        rows, cols, colors = _pattern_pixels(grid, box)
+        color_count = len(set(colors))
+        assert 1 <= color_count <= 3
