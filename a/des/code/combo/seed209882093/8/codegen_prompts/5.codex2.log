+    elif key_mode == "col":
+        ordered = sorted(cells, key=lambda rc: (rc[1], rc[0]))
+    elif key_mode == "diag":
+        ordered = sorted(cells, key=lambda rc: (rc[0] + rc[1], rc[0], rc[1]))
+    else:
