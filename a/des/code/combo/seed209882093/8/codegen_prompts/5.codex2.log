+        if side == "top":
+            dr = int((r1 - 1) - rows.max())
+            dc = 0
+        elif side == "bottom":
+            dr = int((r0 + 1) - rows.min())
+            dc = 0
+        elif side == "left":
+            dr = 0
+            dc = int((c1 - 1) - cols.max())
+        else:
+            dr = 0
+            dc = int((c0 + 1) - cols.min())
