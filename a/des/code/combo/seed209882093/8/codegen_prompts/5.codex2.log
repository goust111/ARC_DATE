+        actual_w = max(c for _r, c in cells) + 1
+        if actual_h < 2 or actual_w < 2:
+            continue
+        if actual_h > room_h - 2 or actual_w > room_w - 2:
+            continue
+        if axis_vertical and actual_h > room_h - n_colors:
+            continue
