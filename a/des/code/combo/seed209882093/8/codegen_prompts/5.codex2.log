+    while len(cells) < area:
+        frontier: set[tuple[int, int]] = set()
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c, height, width):
+                if (nr, nc) not in cells:
+                    frontier.add((int(nr), int(nc)))
+        if not frontier:
+            return None
+        cells.add(random.choice(tuple(frontier)))
