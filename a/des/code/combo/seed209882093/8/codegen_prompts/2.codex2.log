+        if not _growth_is_clean(full_path, extension, arrow):
+            continue
+
+        output_cells = full_path | set(extension) | set(arrow)
+        return {
+            "segments": [tuple(seg) for seg in segments],
+            "path": full_path,
+            "extension": extension,
+            "arrow": arrow,
+            "output_cells": output_cells,
+        }
+
+    return None
+
