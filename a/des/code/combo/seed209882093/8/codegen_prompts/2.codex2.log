+        direction = random.choice(DIRS4)
+        first = _line_cells(start, direction, lengths[0])
+        if not _in_bounds(first, h, w):
+            continue
+
+        segments = [first]
+        full_path = set(first)
+        current_end = first[-1]
+        current_dir = direction
+        turn_count = 0
+        ok = True
+
