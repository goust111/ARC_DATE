+from __future__ import annotations
+
+from itertools import permutations, product
+import random
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 0
+
+
+def _add(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    return (a[0] + b[0], a[1] + b[1])
+
+
+def _scale(d: tuple[int, int], k: int) -> tuple[int, int]:
+    return (d[0] * k, d[1] * k)
+
+
+def _left(d: tuple[int, int]) -> tuple[int, int]:
+    return (-d[1], d[0])
+
+
+def _right(d: tuple[int, int]) -> tuple[int, int]:
+    return (d[1], -d[0])
+
+
+def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    if np.any(grid == 0):
+        return 0
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(counts.argmax())])
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4((cr, cc)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append({"color": color, "cells": tuple(sorted(cells))})
+    return comps
+
+
+def _segment_info(comp: dict) -> dict:
+    cells = list(comp["cells"])
+    rows = sorted({r for r, _ in cells})
+    cols = sorted({c for _, c in cells})
+    color = int(comp["color"])
+    if len(cells) == 1:
+        cell = cells[0]
+        return {
+            "color": color,
+            "cells": tuple(cells),
+            "endpoints": (cell, cell),
+        }
+    if len(rows) == 1:
+        row = rows[0]
+        c0, c1 = cols[0], cols[-1]
+        assert len(cells) == c1 - c0 + 1
+        ordered = tuple((row, c) for c in range(c0, c1 + 1))
+        return {
+            "color": color,
+            "cells": ordered,
+            "endpoints": (ordered[0], ordered[-1]),
+        }
+    if len(cols) == 1:
+        col = cols[0]
+        r0, r1 = rows[0], rows[-1]
+        assert len(cells) == r1 - r0 + 1
+        ordered = tuple((r, col) for r in range(r0, r1 + 1))
+        return {
+            "color": color,
+            "cells": ordered,
+            "endpoints": (ordered[0], ordered[-1]),
+        }
+    raise AssertionError("foreground components must be 1-pixel-wide axis-aligned segments")
