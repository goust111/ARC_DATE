+        for oriented in product(*orientation_sets):
+            full = set(base_cells)
+            ok = True
+            for i in range(len(perm) - 1):
+                end_a = oriented[i][1]
+                start_b = oriented[i + 1][0]
+                gap = _gap_cells(end_a, start_b)
+                if gap is None:
+                    ok = False
+                    break
