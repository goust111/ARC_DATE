+    if len(candidates) == 1:
+        return next(iter(candidates.values()))
+    # Valid tasks should be unique. If multiple survive, use a stable geometric tie-break.
+    ordered = sorted(
+        candidates.values(),
+        key=lambda cells: (len(cells), tuple(sorted(cells))),
+    )
+    return ordered[-1]
