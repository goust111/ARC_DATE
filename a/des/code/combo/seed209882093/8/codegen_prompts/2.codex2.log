+def _growth_cells(end: tuple[int, int], direction: tuple[int, int], seg_count: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    extension = [_add(end, _scale(direction, step)) for step in range(1, seg_count + 1)]
