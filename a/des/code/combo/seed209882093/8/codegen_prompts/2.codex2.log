+        occupied: set[tuple[int, int]] = set()
+        occupied_halo: set[tuple[int, int]] = set()
+
+        ok = True
+        for color in colors:
+            placed = False
+            for _ in range(COLOR_PLACE_ATTEMPTS):
+                shape = _generate_color_shape(h, w)
