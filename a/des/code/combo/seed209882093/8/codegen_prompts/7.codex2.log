+def _is_irregular_source(cells: set[tuple[int, int]]) -> bool:
+    if not (3 <= len(cells) <= 8):
+        return False
+    rows = {r for r, _c in cells}
+    cols = {c for _r, c in cells}
+    if len(rows) == 1 or len(cols) == 1:
+        return False
+    r0 = min(rows)
+    r1 = max(rows)
+    c0 = min(cols)
+    c1 = max(cols)
+    return (r1 - r0 + 1) * (c1 - c0 + 1) > len(cells)
