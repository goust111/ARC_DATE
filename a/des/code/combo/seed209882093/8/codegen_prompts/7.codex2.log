+
+    arrow = set(shaft)
+    arrow.add(head)
+    arrow.add(wing1)
+    arrow.add(wing2)
+    source = cells - arrow
+    if not _is_irregular_source(source) or not _is_connected(source):
+        return None
+
+    root = shaft[-1]
+    root_contacts = [nbr for nbr in _neighbors4(root) if nbr in source]
+    if not root_contacts:
