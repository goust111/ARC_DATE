+                "color": int(bp["color"]),
+                "direction": bp["direction"],
+                "length": int(bp["length"]),
+                "component": component,
+                "source": source,
+                "arrow": arrow,
+                "copy": copy,
+                "offset": offset,
+                "makes_overlap": makes_source_overlap,
