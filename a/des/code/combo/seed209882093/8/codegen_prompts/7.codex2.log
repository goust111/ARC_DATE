from __future__ import annotations

from collections import deque
import random

import numpy as np


BG = 8
DIR_ORDER = ("up", "right", "down", "left")
DIRECTIONS = {
    "up": (-1, 0),
    "right": (0, 1),
    "down": (1, 0),
    "left": (0, -1),
}


def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = cell
    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]


def _perpendiculars(dr: int, dc: int) -> tuple[tuple[int, int], tuple[int, int]]:
    return (dc, -dr), (-dc, dr)


def _background_color(grid: np.ndarray) -> int:
    if np.any(grid == BG):
        return BG
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[int(np.argmax(counts))])


def _connected_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[dict[str, object]] = []

    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(grid[r, c]) == int(bg):
                continue
            color = int(grid[r, c])
            queue = deque([(r, c)])
            seen[r, c] = True
            cells: list[tuple[int, int]] = []
            while queue:
                rr, cc = queue.popleft()
                cells.append((int(rr), int(cc)))
                for nr, nc in _neighbors4((int(rr), int(cc))):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        queue.append((nr, nc))
            comps.append({"color": color, "cells": tuple(sorted(cells))})

    comps.sort(key=lambda comp: tuple(comp["cells"]))
    return comps


def _is_connected(cells: set[tuple[int, int]]) -> bool:
    if not cells:
        return False
    start = next(iter(cells))
    queue = deque([start])
    seen = {start}
    while queue:
        cell = queue.popleft()
        for nbr in _neighbors4(cell):
            if nbr in cells and nbr not in seen:
                seen.add(nbr)
                queue.append(nbr)
    return len(seen) == len(cells)


def _is_irregular_source(cells: set[tuple[int, int]]) -> bool:
    if not (3 <= len(cells) <= 8):
        return False
    rows = {r for r, _c in cells}
    cols = {c for _r, c in cells}
    if len(rows) == 1 or len(cols) == 1:
        return False
    r0 = min(rows)
    r1 = max(rows)
    c0 = min(cols)
    c1 = max(cols)
    return (r1 - r0 + 1) * (c1 - c0 + 1) > len(cells)


