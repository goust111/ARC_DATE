+    wing2 = (head[0] + pr2, head[1] + pc2)
+    front = (head[0] + dr, head[1] + dc)
+    if wing1 not in cells or wing2 not in cells or front in cells:
+        return None
+
+    shaft: list[tuple[int, int]] = []
+    for step in range(1, 5):
+        pos = (head[0] - step * dr, head[1] - step * dc)
+        if pos in cells:
+            shaft.append(pos)
+        else:
