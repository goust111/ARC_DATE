+        col_range = range(oc1 + 2, w - mw - 1)
+    elif corner == "bl":
+        row_range = range(or1 + 2, h - mh - 1)
+        col_range = range(1, oc0 - mw)
+    else:
+        row_range = range(or1 + 2, h - mh - 1)
+        col_range = range(oc1 + 2, w - mw - 1)
+
+    starts = [(r, c) for r in row_range for c in col_range]
+    random.shuffle(starts)
+    for sr, sc in starts:
+        cells = [(sr + r, sc + c) for r, c in zip(*np.where(mask))]
