+def _line_points(a: tuple[float, float], b: tuple[float, float]) -> list[tuple[int, int]]:
+    ar, ac = a
+    br, bc = b
+    steps = int(max(abs(br - ar), abs(bc - ac)) * 6) + 2
+    pts: list[tuple[int, int]] = []
