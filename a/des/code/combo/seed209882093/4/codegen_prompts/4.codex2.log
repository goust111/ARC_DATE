import random
from collections import deque

import numpy as np


BG = 0
TRACK = 5
OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
GENERATE_ATTEMPTS = 400
MAX_HOLES = 3
TRACK_COUNT = 3


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    components: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            seen[r, c] = True
            queue = deque([(r, c)])
            coords: list[tuple[int, int]] = []
            while queue:
                cr, cc = queue.popleft()
                coords.append((cr, cc))
                for nr, nc in _neighbors4(cr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        queue.append((nr, nc))
            components.append(coords)
    return components


def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _trim_mask(mask: np.ndarray) -> np.ndarray:
    rows = np.where(mask.any(axis=1))[0]
    cols = np.where(mask.any(axis=0))[0]
    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]


def _is_connected(mask: np.ndarray) -> bool:
    coords = np.argwhere(mask)
    if coords.size == 0:
        return False
    return len(_components_mask(mask)) == 1


def _count_holes(mask: np.ndarray) -> int:
    h, w = mask.shape
    bg_mask = ~mask
    holes = 0
    for comp in _components_mask(bg_mask):
        if all(0 < r < h - 1 and 0 < c < w - 1 for r, c in comp):
            holes += 1
    return holes


def _is_boundary_pixel(mask: np.ndarray, r: int, c: int) -> bool:
    h, w = mask.shape
    if not mask[r, c]:
        return False
    for nr, nc in _neighbors4(r, c):
        if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
            return True
    return False


def _random_blob_mask() -> np.ndarray:
    for _ in range(200):
        h = random.randint(3, 6)
        w = random.randint(3, 6)
        target = random.randint(max(5, (h * w) // 2), h * w)
        cells = {(random.randrange(h), random.randrange(w))}
        while len(cells) < target:
            frontier = []
            for r, c in cells:
                for nr, nc in _neighbors4(r, c):
                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
                        frontier.append((nr, nc))
            if not frontier:
                break
            cells.add(random.choice(frontier))
