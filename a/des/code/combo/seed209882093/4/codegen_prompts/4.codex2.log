+    singletons = [comp for comp in comps if len(comp) == 1]
+    nonsingle = [comp for comp in comps if len(comp) > 1]
+    if len(singletons) == 1 and len(nonsingle) == 1:
+        return singletons[0][0], nonsingle[0]
