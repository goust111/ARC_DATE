+    if len(comps) == 1:
+        coords = comps[0]
+        ordered = sorted(
+            coords,
+            key=lambda p: (p[0] - center[0]) ** 2 + (p[1] - center[1]) ** 2,
+        )
+        for marker in ordered:
+            trial = mask.copy()
+            trial[marker] = False
+            if not trial.any():
+                continue
+            if len(_components_mask(trial)) == 1:
+                obj_coords = [(r, c) for r, c in coords if (r, c) != marker]
