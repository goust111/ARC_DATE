+def _equally_spaced_positions(
+    perimeter: list[tuple[int, int]],
+    start: tuple[int, int],
+    count: int,
+) -> list[tuple[int, int]]:
+    length = len(perimeter)
+    start_idx = perimeter.index(start)
+    if count == 1:
+        return [start]
+    if length % count == 0:
+        step = length // count
+        return [perimeter[(start_idx + i * step) % length] for i in range(count)]
