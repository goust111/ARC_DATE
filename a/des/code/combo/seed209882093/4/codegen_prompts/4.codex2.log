+        assert 1 <= track_index <= len(track_bboxes)
+        start = _ray_start_pixel(track_bboxes[track_index - 1], center, marker)
+        positions = _equally_spaced_positions(perimeters[track_index - 1], start, holes + 1)
+        for pr, pc in positions:
+            out[pr, pc] = color
+    return out
+
