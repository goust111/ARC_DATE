+            grid[r, c] = color
+            occupied.add((r, c))
+        grid[marker] = color
+        occupied.add(marker)
+        return marker, cells
+    return None
+
+
+def _track_positions_for_validation(grid: np.ndarray) -> dict[int, list[tuple[int, int]]]:
+    out = _solve(grid)
