+    for i in range(TRACK_COUNT):
+        bbox = (r0 + 2 * (TRACK_COUNT - 1 - i), c0 + 2 * (TRACK_COUNT - 1 - i), r1 - 2 * (TRACK_COUNT - 1 - i), c1 - 2 * (TRACK_COUNT - 1 - i))
