+def _perimeter_clockwise(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        pts.append((r, c1))
+    for c in range(c1 - 1, c0 - 1, -1):
+        pts.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        pts.append((r, c0))
+    return pts
