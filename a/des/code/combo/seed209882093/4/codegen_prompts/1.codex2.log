+    out = g.copy()
+    for r0, c0, r1, c1 in frames:
+        seed = _seed_color(g, (r0, c0, r1, c1))
+        pattern = legends[seed]
+        fill = _tile_pattern(r1 - r0 - 1, c1 - c0 - 1, pattern)
+        patch = out[r0 + 1:r1, c0 + 1:c1]
+        patch[:] = BLACK
+        patch[fill] = seed
