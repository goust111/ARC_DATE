+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+
+GEN_RETRIES = 400
+LEGEND_SIZES = (3, 4)
+REGION_COUNT_RANGE = (2, 4)
+INNER_H_RANGE = (4, 7)
+INNER_W_RANGE = (4, 8)
+GRID_MIN = 24
+GRID_MAX = 30
