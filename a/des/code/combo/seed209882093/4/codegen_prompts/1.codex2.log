+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    region_count = rng.randint(*REGION_COUNT_RANGE)
+    legend_size = rng.choice(LEGEND_SIZES)
+    orientation = rng.choice(("top", "left"))
