+def _tile_pattern(height: int, width: int, pattern: np.ndarray) -> np.ndarray:
+    ph, pw = pattern.shape
+    out = np.zeros((height, width), dtype=bool)
+    for r in range(height):
+        for c in range(width):
+            out[r, c] = bool(pattern[r % ph, c % pw])
+    return out
