+        if np.any(grid[r0:r1 + 1, c0] != GREY) or np.any(grid[r0:r1 + 1, c1] != GREY):
+            continue
+        if hh > 2 and ww > 2 and np.any(grid[r0 + 1:r1, c0 + 1:c1] == GREY):
+            continue
+        frames.append((r0, c0, r1, c1))
