+        if int(grid[r, 0]) not in (BLACK, GREY):
+            for n in (4, 3):
+                if n > w or r + n > h:
+                    continue
+                patch = grid[r:r + n, :n]
+                if not _legend_candidate(patch):
+                    continue
+                if r > 0 and np.any(grid[r - 1, :n] != BLACK):
+                    continue
+                if r + n < h and np.any(grid[r + n, :n] != BLACK):
+                    continue
