# --- Configuration constants ---
GRID_H = 30                   # canvas height
GRID_W = 24                   # canvas width
BAR_COUNT_RANGE = (2, 3)      # number of horizontal bars
SPRITE_COUNT_RANGE = (2, 3)   # number of sprites above bars
