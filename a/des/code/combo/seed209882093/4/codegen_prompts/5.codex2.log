+def _random_shape(rng: np.random.Generator) -> np.ndarray:
+    patch = np.array(BASE_SHAPES[int(rng.integers(0, len(BASE_SHAPES)))], copy=True)
+    patch = np.rot90(patch, int(rng.integers(0, 4)))
