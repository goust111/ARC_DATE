+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        if not np.all((border_coords[:, 0] == r0) | (border_coords[:, 0] == r1) | (border_coords[:, 1] == c0) | (border_coords[:, 1] == c1)):
