+            anchor = _sample_notch_anchor(side, h, w, grid_h, grid_w, rng)
+            if anchor is None:
+                continue
+            r0, c0 = anchor
+            if not _rect_clear(occupied, r0, c0, h, w, pad=1):
+                continue
+            coords = np.argwhere(mask) + np.array([r0, c0], dtype=int)
+            placed[idx] = {
