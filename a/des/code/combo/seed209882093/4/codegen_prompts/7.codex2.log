+    seen = set()
+    for k in range(4):
+        rot = np.rot90(base, int(k))
+        for var in (rot, np.fliplr(rot)):
+            key = (int(var.shape[0]), int(var.shape[1]), var.astype(np.uint8).tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(np.array(var, copy=True))
+    return out
