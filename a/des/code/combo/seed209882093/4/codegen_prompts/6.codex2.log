+
+        best_overlap = max(overlap for overlap, _ in candidates)
+        best = [j for overlap, j in candidates if overlap == best_overlap]
+        if len(best) != 1:
+            ambiguous = True
+            continue
+
+        parent = best[0]
+        parents[i] = parent
+        depths[i] = depths[parent] + 1
+        changed += 1
+
+    return {
+        "changed": changed,
+        "multi": multi,
+        "max_depth": max(depths, default=0),
+        "ambiguous": ambiguous,
+    }
+
