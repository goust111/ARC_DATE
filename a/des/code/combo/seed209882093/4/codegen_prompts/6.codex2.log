+BLACK = 0
+GREY = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+@dataclass
+class ObjectInfo:
+    color: int
+    coords: np.ndarray
+    top: int
+    bottom: int
+    left: int
+    right: int
+
+
+def _find_objects(grid: np.ndarray) -> list[ObjectInfo]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[ObjectInfo] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in (BLACK, GREY):
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            coords = np.asarray(pts, dtype=int)
+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            objects.append(
+                ObjectInfo(
+                    color=color,
+                    coords=coords,
+                    top=int(rows.min()),
+                    bottom=int(rows.max()),
+                    left=int(cols.min()),
+                    right=int(cols.max()),
+                )
+            )
+
+    objects.sort(key=lambda obj: (-obj.bottom, obj.top, obj.left))
+    return objects
+
+
+def _interval_overlap(a: tuple[int, int], b: tuple[int, int]) -> int:
+    left = max(a[0], b[0])
+    right = min(a[1], b[1])
+    return max(0, right - left + 1)
+
+
+def _resolve_colors(objects: list[ObjectInfo]) -> list[int]:
+    resolved = [obj.color for obj in objects]
+
+    for i, obj in enumerate(objects):
+        candidates: list[tuple[int, int, int]] = []
+        for j in range(i):
+            lower = objects[j]
+            if lower.bottom <= obj.bottom:
+                continue
+            overlap = _interval_overlap((obj.left, obj.right), (lower.left, lower.right))
+            if overlap <= 0:
+                continue
+            candidates.append((overlap, lower.bottom, j))
+
+        if not candidates:
+            continue
+
+        candidates.sort(key=lambda item: (-item[0], -item[1], item[2]))
+        resolved[i] = resolved[candidates[0][2]]
+
+    return resolved
+
