+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            coords = np.asarray(pts, dtype=int)
+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            objects.append(
+                ObjectInfo(
+                    color=color,
+                    coords=coords,
+                    top=int(rows.min()),
+                    bottom=int(rows.max()),
+                    left=int(cols.min()),
+                    right=int(cols.max()),
+                )
+            )
