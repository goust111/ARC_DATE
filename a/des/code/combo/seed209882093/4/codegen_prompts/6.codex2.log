+def _relation_summary(objects: list[ObjectInfo]) -> dict[str, int | bool]:
+    parents = [None] * len(objects)
+    depths = [0] * len(objects)
+    changed = 0
+    multi = 0
+    ambiguous = False
+
+    for i, obj in enumerate(objects):
+        candidates: list[tuple[int, int]] = []
+        for j in range(i):
