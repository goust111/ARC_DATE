+                        frontier.add(pt)
+            if not frontier:
+                break
+
+            candidates = sorted(frontier)
+            weights = [
+                1 + sum((pt[0] + dr, pt[1] + dc) in cells for dr, dc in DIR4)
+                for pt in candidates
+            ]
+            cells.add(rng.choices(candidates, weights=weights, k=1)[0])
