+    assert g.shape[0] >= 5 and g.shape[1] >= 6, "grid is too small"
+    assert np.all(g[-1, :] == GREY), "expected a grey horizon on the bottom row"
+    assert not np.any(g[:-1, :] == GREY), "grey is reserved for the horizon"
