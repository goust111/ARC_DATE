+GEN_MIN_OBJECTS = 3
+GEN_MAX_OBJECTS = 6
+GEN_MIN_GRID_W = 12
+GEN_MAX_GRID_W = 20
+GEN_MAX_GRID_H = 18
+GEN_ATTEMPTS = 300
+PLACEMENT_ATTEMPTS = 100
+POLYOMINO_ATTEMPTS = 80
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+SCENARIOS = ("simple", "chain", "multi", "mixed")
+SCENARIO_WEIGHTS = (4, 3, 2, 1)
