+    c0, c1 = min(cols), max(cols)
+    if (r0 + r1) % 2 != 0 or (c0 + c1) % 2 != 0:
+        return None
+    center = ((r0 + r1) // 2, (c0 + c1) // 2)
+    return center if center in body else None
