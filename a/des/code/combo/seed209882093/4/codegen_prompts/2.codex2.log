+            grid[tip_r - step, tip_c] = int(color)
+    elif tail_dir == DOWN:
+        tip_r, tip_c = body_top + h - 1, cc
+        for step in range(1, tail_len + 1):
+            grid[tip_r + step, tip_c] = int(color)
