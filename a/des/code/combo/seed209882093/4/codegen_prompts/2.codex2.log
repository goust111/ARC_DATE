+        obj = _extract_object(cells)
+        obj["color"] = color
+        obj["index"] = len(objects)
+        for cell in cells:
+            assert cell not in cell_to_object, "objects must not overlap"
+            cell_to_object[cell] = obj["index"]
+        objects.append(obj)
