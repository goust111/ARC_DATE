+BODY_SHAPES = ((3, 3), (3, 5), (5, 3), (5, 5))
+TAIL_LEN_RANGE = (1, 2)
+GAP_RANGE = (1, 3)
+LANE_GAP_RANGE = (2, 4)
+MARGIN_RANGE = (1, 3)
+CONTENT_EXTRA_RANGE = (0, 3)
+MAX_SIZE = 30
+GEN_RETRIES = 400
+LANE_PATTERNS = (
+    (2,),
+    (3,),
+    (1, 2),
+    (1, 3),
