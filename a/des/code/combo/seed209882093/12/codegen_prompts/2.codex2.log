+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    border = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    return set(points) == border
+
+
+def _find_frames(grid: np.ndarray) -> dict[int, dict[str, object]]:
