+def generate_input() -> np.ndarray:
+    """Randomly generate a valid puzzle instance for the anchor-alignment fragment task."""
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
