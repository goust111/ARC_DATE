+import numpy as np
+
+
+BG = 0
+MARKER = 9
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 400
+PLACEMENT_ATTEMPTS = 120
+FRAME_COUNT_RANGE = (2, 4)
