+            if idx == 0 or degree >= 3:
+                continue
+
+            used_dirs = set()
+            if parents[idx] is not None:
+                used_dirs.add(_direction((r, c), positions[parents[idx]]))
+            for child in children[idx]:
+                used_dirs.add(_direction((r, c), positions[child]))
