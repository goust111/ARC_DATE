+def _direction(a: tuple[int, int], b: tuple[int, int]) -> str:
+    dr = b[0] - a[0]
+    dc = b[1] - a[1]
+    if dr == -1 and dc == 0:
+        return "up"
+    if dr == 1 and dc == 0:
+        return "down"
+    if dr == 0 and dc == -1:
+        return "left"
+    if dr == 0 and dc == 1:
+        return "right"
+    raise ValueError("positions must be grid-adjacent")
+
+
+def _grow_tree(
+    rng: np.random.Generator,
+    lattice_h: int,
+    lattice_w: int,
+    target_nodes: int,
