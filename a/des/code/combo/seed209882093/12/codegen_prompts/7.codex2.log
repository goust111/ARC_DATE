+        require_branch=require_branch,
+        require_wrap_depth=require_wrap_depth,
+    )
+    if grown is None:
+        return None
+
+    positions, parents, children = grown
+    palette = rng.choice(np.array(NODE_COLORS, dtype=int), size=palette_len, replace=False)
