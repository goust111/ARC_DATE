+        node = queue.popleft()
+        for nxt in graph[node]:
+            if nxt in depths:
+                continue
+            depths[nxt] = depths[node] + 1
+            queue.append(nxt)
+    assert len(depths) == len(graph), "tree must be connected"
+    return depths
+
