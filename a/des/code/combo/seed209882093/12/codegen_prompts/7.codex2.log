  54:     assert len(sep_rows) >= 2, "expected two full-width separator rows"
  55:     top_sep = sep_rows[0]
  56:     bottom_sep = sep_rows[-1]
  57: 
  58:     table_region = g[top_sep + 1 : bottom_sep, :]
  59:     table_fg = np.argwhere(table_region != bg)
  60:     assert table_fg.size, "reference table must contain glyphs"
  61: 
  62:     first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())
  63:     first_glyph_c = int(table_fg[:, 1].min())
  64:     row0 = first_glyph_r - 1
  65:     col0 = first_glyph_c - 1
  66: 
  67:     row_starts = list(range(row0, bottom_sep, cell_size))
  68:     row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]
  69:     col_starts = list(range(col0, w, cell_size))
  70:     col_starts = [c for c in col_starts if c + cell_size <= w]
  71:     assert row_starts and col_starts, "could not infer table cell grid"
  72: 
  73:     query_sigs = [
  74:         sig
  75:         for c in col_starts
  76:         if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None
