+    palette_len = int(rng.integers(3, 6))
+
+    if mode == "branch":
+        target_nodes = int(rng.integers(5, 8))
+    elif mode == "wrap":
+        target_nodes = int(rng.integers(max(5, palette_len + 1), 8))
+    else:
+        target_nodes = int(rng.integers(3, 8))
