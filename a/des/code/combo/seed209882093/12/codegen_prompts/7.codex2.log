+    max_r = max(r for r, _ in positions)
+    max_c = max(c for _, c in positions)
+    top_pad = int(rng.integers(0, 3))
+    left_pad = int(rng.integers(0, 4))
+    bottom_pad = int(rng.integers(0, 3))
+    right_pad = int(rng.integers(0, 4))
+
