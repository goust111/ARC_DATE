+                if not (0 <= nxt[0] < lattice_h and 0 <= nxt[1] < lattice_w):
+                    continue
+                if nxt in used:
+                    continue
+                weight = 4 if name == "down" else 3
+                candidates.extend([(idx, name)] * weight)
+
+        if not candidates:
+            return None
