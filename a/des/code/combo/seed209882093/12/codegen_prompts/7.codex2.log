+    if lattice_h < 2 or lattice_w < 3 or target_nodes < 2:
+        return None
+
+    root_c = int(rng.integers(1, lattice_w - 1))
+    positions = [(0, root_c), (1, root_c)]
+    parents: list[int | None] = [None, 0]
