+        r1, c1 = centers[idx]
+        if r0 == r1:
+            lo, hi = sorted((c0, c1))
+            grid[r0, lo + 2 : hi - 1] = MAROON
+        else:
+            lo, hi = sorted((r0, r1))
+            grid[lo + 2 : hi - 1, c0] = MAROON
