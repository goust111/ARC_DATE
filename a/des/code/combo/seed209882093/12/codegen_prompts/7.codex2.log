   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Sort vertical bars by height and redistribute them across fixed colored slots.
   9: 
  10:     Input structure:
  11:     - bg background; a horizontal base line of a single color spans the full grid width.
  12:     - Several monochrome vertical bars of distinct colors rise upward from the base line.
  13: 
  14:     Rule:
  15:     - Rank bar shapes by height (shortest to tallest).
  16:     - Rank original x-positions (slots) left to right.
  17:     - Place the i-th shortest shape into the i-th leftmost slot, recoloring it to that slot's original color.
  18:     - The base line is preserved unchanged.
  19: 
  20:     Key insight: Each slot keeps its x-position and color identity; only the bar silhouettes are redistributed among slots by height order.
  21:     """
  22:     g = np.array(grid, dtype=int)
  23:     H, W = g.shape
  24:     bg = int(get_bg(g))
  25: 
  26:     # Base row/color = (row,color) with maximal count on that row (excluding bg).
  27:     best = None  # (count, row, color)
  28:     for r in range(H):
  29:         vals, counts = np.unique(g[r, :], return_counts=True)
  30:         for v, cnt in zip(vals, counts):
  31:             v = int(v)
  32:             cnt = int(cnt)
  33:             if v == bg:
  34:                 continue
  35:             if best is None or cnt > best[0]:
  36:                 best = (cnt, int(r), int(v))
  37:     assert not (best is None)
  38:     _cnt, base_r, base_col = best
  39: 
  40:     objects: list[dict[str, object]] = []
  41:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
  42:         col = int(comp["color"])
  43:         if col in {int(bg), int(base_col)}:
  44:             continue
  45: 
  46:         pts = comp["coords"]
  47:         b = comp["bbox"]
  48:         height = int(bbox_h(b))
  49: 
  50:         base_cols = sorted(int(c) for r, c in pts if int(r) == int(base_r))
  51:         if base_cols:
  52:             anchor = int(base_cols[len(base_cols) // 2])
  53:         else:
  54:             cols_sorted = sorted(int(c) for _r, c in pts)
  55:             anchor = int(cols_sorted[len(cols_sorted) // 2])
  56: 
  57:         rel = [(int(r) - int(base_r), int(c) - int(anchor)) for r, c in pts]
  58:         objects.append(
  59:             {
  60:                 "color": int(col),
  61:                 "anchor": int(anchor),
  62:                 "height": int(height),
  63:                 "size": int(len(rel)),
  64:                 "rel": rel,
  65:             }
  66:         )
  67: 
  68:     # Slots are determined by original x-positions; slot colors must be preserved.
  69:     slots = sorted(objects, key=lambda o: (int(o["anchor"]), int(o["color"])))
  70:     # Shapes are ordered by height (shortest -> tallest).
  71:     shapes = sorted(objects, key=lambda o: (int(o["height"]), int(o["size"]), int(o["anchor"]), int(o["color"])))
  72: 
  73:     out = np.full_like(g, bg)
  74:     out[int(base_r), :] = int(base_col)
  75: 
  76:     for slot, shape in zip(slots, shapes):
  77:         slot_col = int(slot["color"])
  78:         slot_anchor = int(slot["anchor"])
  79:         for dr, dc in shape["rel"]:
  80:             rr = int(base_r) + int(dr)
  81:             cc = int(slot_anchor) + int(dc)
  82:             if 0 <= rr < H and 0 <= cc < W:
  83:                 out[rr, cc] = int(slot_col)
  84: 
  85:     return out

