+    main_h = last_center_r + 2 + bottom_pad
+    main_w = last_center_c + 2 + right_pad
+    palette_span = 2 * len(palette) - 1
+    main_w = max(main_w, palette_span + int(rng.integers(0, 4)))
+    grid = np.full((main_h + 2, main_w), BLACK, dtype=int)
+    sep_row = main_h
