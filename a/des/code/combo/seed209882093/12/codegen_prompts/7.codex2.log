+    except AssertionError:
+        return None
+    if not np.any(out != grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
