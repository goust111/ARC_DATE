+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(sorted(coords), dtype=int))
+    out.sort(key=lambda comp: (int(comp[:, 0].min()), int(comp[:, 1].min())))
