+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GEN_GREY = 5
+DIR_ORDER = ("up", "down", "left", "right")
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
