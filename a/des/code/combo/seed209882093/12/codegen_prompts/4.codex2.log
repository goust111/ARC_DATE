+    sep = max(
+        candidates,
+        key=lambda color: (
+            len(row_hits[color]) + len(col_hits[color]),
+            len(row_hits[color]) * len(col_hits[color]),
+        ),
+    )
+    return int(sep), sorted(row_hits[sep]), sorted(col_hits[sep])
+
