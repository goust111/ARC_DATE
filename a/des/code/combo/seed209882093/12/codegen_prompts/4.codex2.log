+def _band_intervals(size: int, separators: list[int]) -> list[tuple[int, int]]:
+    bounds = [-1] + sorted(separators) + [size]
+    out = []
+    for a, b in zip(bounds, bounds[1:]):
+        start = a + 1
+        end = b - 1
+        if start <= end:
