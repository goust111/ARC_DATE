+def _connected(coords: list[tuple[int, int]]) -> bool:
+    cells = set(coords)
+    stack = [next(iter(cells))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
