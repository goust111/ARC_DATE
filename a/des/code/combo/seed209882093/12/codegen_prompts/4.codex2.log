+GRID_LIMIT = 30
+ROW_COUNT_RANGE = (2, 4)
+COL_COUNT_RANGE = (2, 4)
+ROW_SIZE_RANGE = (5, 7)
+COL_SIZE_RANGE = (5, 8)
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
