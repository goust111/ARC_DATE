+
+def _band_index(size: int, intervals: list[tuple[int, int]]) -> np.ndarray:
+    out = np.full(size, -1, dtype=int)
+    for i, (a, b) in enumerate(intervals):
+        out[a : b + 1] = i
+    return out
+
