+                wall, _interior, seeds, seed_depths = room
+                bh, bw = wall.shape
+                if bh >= h - 1 or bw >= w - 1:
+                    continue
+                r0 = rng.randint(1, h - bh - 1)
+                c0 = rng.randint(1, w - bw - 1)
+                if not _placeable(used, r0, c0, wall):
+                    continue
+
+                grid[r0 : r0 + bh, c0 : c0 + bw][wall] = GREY
