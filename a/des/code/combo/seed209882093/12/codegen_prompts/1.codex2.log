+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and interior[nr, nc] and depth[nr, nc] < 0:
+                depth[nr, nc] = depth[r, c] + 1
+                queue.append((nr, nc))
+    return depth
