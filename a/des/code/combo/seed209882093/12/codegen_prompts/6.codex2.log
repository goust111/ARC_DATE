+    frames.sort(key=lambda item: (-int(item["area"]), tuple(item["bbox"])))
+    return frames
+
+
+def _find_structure(grid: np.ndarray) -> tuple[dict[str, object], list[dict[str, object]]] | None:
+    frames = _detect_frames(grid)
+    if len(frames) < 3:
+        return None
+    large = frames[0]
+    stamps = sorted(
+        frames[1:],
