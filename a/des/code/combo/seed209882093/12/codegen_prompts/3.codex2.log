+def _render_template(
+    grid: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+    top: int,
+    left: int,
+    yellow_cells: set[tuple[int, int]],
+) -> None:
+    for r, c in shape:
+        grid[top + r, left + c] = YELLOW if (r, c) in yellow_cells else GRAY
+
