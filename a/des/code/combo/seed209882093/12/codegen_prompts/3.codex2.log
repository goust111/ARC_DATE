+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+
+TEST_COLORS = (BLUE, RED, GREEN, ORANGE, MAGENTA)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GEN_BAND_COUNT_RANGE = (2, 4)
+GEN_BAND_HEIGHT_RANGE = (6, 10)
+GEN_TEST_COUNT_RANGE = (2, 4)
+GEN_MARGIN_RANGE = (1, 3)
+GEN_GAP_RANGE = (2, 5)
