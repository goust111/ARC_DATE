+        if _has_hole(shape):
+            continue
+
+        rotations = _rotation_signatures(shape)
+        if len(rotations) < 2:
+            continue
+        chiral = _reflect_shape(shape) not in rotations
+        if require_chiral is True and not chiral:
+            continue
+        return shape
+    return None
