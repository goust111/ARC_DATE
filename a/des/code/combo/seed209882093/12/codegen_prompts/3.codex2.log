+def _rotation_signatures(shape: tuple[tuple[int, int], ...]) -> set[tuple[tuple[int, int], ...]]:
+    cur = _normalize_shape(shape)
+    variants: set[tuple[tuple[int, int], ...]] = set()
+    for _ in range(4):
+        variants.add(cur)
+        cur = _rotate_shape(cur)
+    return variants
