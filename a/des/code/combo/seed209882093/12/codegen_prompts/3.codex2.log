+def _has_hole(shape: tuple[tuple[int, int], ...]) -> bool:
+    mask = _shape_mask(shape)
+    bg = ~mask
+    if not bool(bg.any()):
+        return False
+
+    h, w = mask.shape
+    seen = np.zeros_like(bg, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
