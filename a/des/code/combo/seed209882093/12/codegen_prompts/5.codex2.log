+    for info in _analyze_pairs(g):
+        color = int(info["color"])
+        same_orientation = bool(info["same_orientation"])
+        path = list(info["path"])
+        for idx, (r, c) in enumerate(path):
+            if same_orientation or idx % 2 == 0:
+                out[r, c] = color
