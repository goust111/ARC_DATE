+    exp_right = np.full(r1 - r0 + 1, color, dtype=int)
+    exp_top[top_gap - c0] = bg
+    exp_bottom[bottom_gap - c0] = bg
+    exp_left[left_gap - r0] = bg
+    exp_right[right_gap - r0] = bg
