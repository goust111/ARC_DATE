+def _find_frames(grid: np.ndarray, bg: int | None = None) -> list[dict[str, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg_color = _dominant_bg(g) if bg is None else int(bg)
+    colors = [int(c) for c in np.unique(g) if int(c) != bg_color]
