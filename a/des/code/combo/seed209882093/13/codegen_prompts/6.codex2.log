+        bottoms_by_span: dict[tuple[int, int, int], list[dict[str, int]]] = {}
+        lefts_by_span: dict[tuple[int, int, int], list[dict[str, int]]] = {}
+        rights_by_span: dict[tuple[int, int, int], list[dict[str, int]]] = {}
