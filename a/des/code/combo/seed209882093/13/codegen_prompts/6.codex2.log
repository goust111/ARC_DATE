+        for (s1, e1), (s2, e2) in zip(segs, segs[1:]):
+            if s2 != e1 + 2:
+                continue
+            c0, c1 = s1, e2
+            if c1 - c0 < 2:
+                continue
+            if want_top:
+                if r > 0 and np.any(grid[r - 1, c0 : c1 + 1] == color):
+                    continue
+                if r + 1 < h and np.any(grid[r + 1, c0 + 1 : c1] == color):
+                    continue
+                orientation = "top"
+            else:
+                if r + 1 < h and np.any(grid[r + 1, c0 : c1 + 1] == color):
+                    continue
+                if r > 0 and np.any(grid[r - 1, c0 + 1 : c1] == color):
+                    continue
+                orientation = "bottom"
+            sides.append(
+                {
+                    "kind": orientation,
+                    "color": int(color),
+                    "r": int(r),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "gap": int(e1 + 1),
+                }
+            )
+    return sides
