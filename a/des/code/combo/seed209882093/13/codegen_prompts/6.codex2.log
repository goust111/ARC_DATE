+def _segments_1d(mask: np.ndarray) -> list[tuple[int, int]]:
+    segs: list[tuple[int, int]] = []
+    n = int(mask.size)
+    i = 0
+    while i < n:
+        if not bool(mask[i]):
+            i += 1
+            continue
+        j = i
+        while j + 1 < n and bool(mask[j + 1]):
+            j += 1
+        segs.append((i, j))
+        i = j + 1
+    return segs
