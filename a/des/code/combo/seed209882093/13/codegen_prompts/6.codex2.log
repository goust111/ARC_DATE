+        for side in bottoms:
+            bottoms_by_span.setdefault((side["color"], side["c0"], side["c1"]), []).append(side)
+        for side in lefts:
+            lefts_by_span.setdefault((side["color"], side["r0"], side["r1"]), []).append(side)
+        for side in rights:
+            rights_by_span.setdefault((side["color"], side["r0"], side["r1"]), []).append(side)
