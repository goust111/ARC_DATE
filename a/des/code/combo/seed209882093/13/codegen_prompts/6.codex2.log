+                            "color": int(color),
+                            "r0": int(top["r"]),
+                            "c0": int(top["c0"]),
+                            "r1": int(bottom["r"]),
+                            "c1": int(top["c1"]),
+                            "top_gap": int(top["gap"]),
+                            "bottom_gap": int(bottom["gap"]),
+                            "left_gap": int(left["gap"]),
+                            "right_gap": int(right["gap"]),
