+            return False
+    for r in range(r0, r1 + 1):
+        if r == left_gap:
+            continue
+        if c0 > 0 and int(grid[r, c0 - 1]) == color:
+            return False
+        if c1 + 1 < w and int(grid[r, c1 + 1]) == color:
+            return False
