+        vertical = np.zeros_like(g, dtype=bool)
+        horizontal = np.zeros_like(g, dtype=bool)
+        vertical[r0 + 1 : r1, top_gap] = True
+        vertical[r0 + 1 : r1, bottom_gap] = True
+        horizontal[left_gap, c0 + 1 : c1] = True
+        horizontal[right_gap, c0 + 1 : c1] = True
