+        for top in tops:
+            span_key = (top["color"], top["c0"], top["c1"])
+            for bottom in bottoms_by_span.get(span_key, []):
+                if bottom["r"] <= top["r"]:
+                    continue
+                side_span = (color, top["r"], bottom["r"])
+                for left in lefts_by_span.get(side_span, []):
+                    if left["c"] != top["c0"]:
