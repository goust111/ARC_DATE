+        for r, c in candidates:
+            rect = (r, c, r + h - 1, c + w - 1)
+            ok = True
+            for other in rects:
+                if other is not None and not _rects_separated(rect, other, gap=1):
+                    ok = False
+                    break
+            if ok:
+                placements[idx] = (r, c)
+                rects[idx] = rect
+                placed = True
+                break
+        if not placed:
+            return None
+
+    return [(int(r), int(c)) for r, c in placements]
