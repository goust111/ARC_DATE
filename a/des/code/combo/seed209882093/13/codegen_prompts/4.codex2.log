+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SCALES = (2, 3)
+COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 500
+PAIR_COUNT_CHOICES = (1, 2, 3)
+GRID_MIN_SIDE = 18
+GRID_MAX_SIDE = 32
