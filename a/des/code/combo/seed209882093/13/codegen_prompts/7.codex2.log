    return min(_mask_key(t) for t in _dihedral_transforms(mask))


def _recover_filled_from_outline(outline: np.ndarray) -> np.ndarray:
    outline = _trim_mask(outline)
    h, w = outline.shape
    exterior = np.zeros((h, w), dtype=bool)
