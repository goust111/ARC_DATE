+def _seed_position(region: dict) -> tuple[int, int]:
+    preferred = []
+    for r, c in region["cells"]:
+        exposed = 0
+        for dr, dc in DIR4:
+            if (r + dr, c + dc) not in region["cell_set"]:
+                exposed += 1
+        if exposed <= 2:
+            preferred.append((r, c))
