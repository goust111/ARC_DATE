+def _make_case(case_kind: str) -> np.ndarray | None:
+    if case_kind == "tie":
+        base_grid = _tie_partition()
+    else:
+        base_grid = _random_partition()
+        if base_grid is None:
+            return None
+
+    regions, _ = _analyze_regions(base_grid)
