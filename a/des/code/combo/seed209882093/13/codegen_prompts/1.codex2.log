+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_RETRIES = 400
+TIE_MODE_WEIGHT = 2
+GENERIC_MODE_WEIGHT = 6
+ALL_SEEDED_WEIGHT = 1
