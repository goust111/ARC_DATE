+def _vertical_ordered_pair(a: dict, b: dict) -> tuple[int, int] | None:
+    a_min_r, _, a_max_r, _ = a["bbox"]
+    b_min_r, _, b_max_r, _ = b["bbox"]
+    if a_max_r < b_min_r:
+        return (0, 1)
+    if b_max_r < a_min_r:
+        return (1, 0)
+    return None
