+    dsu = _DSU(rows * cols)
+    edges = _partition_edges(rows, cols)
+    random.shuffle(edges)
+
+    min_regions = 4 if rows * cols >= 4 else 3
+    target_regions = random.randint(min_regions, min(rows * cols, 8))
+    max_cells_per_region = random.randint(2, min(5, rows * cols))
