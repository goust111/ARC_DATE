+def _tie_partition() -> np.ndarray:
+    rows = random.randint(3, 5)
+    height = random.randint(2, 4)
+    width = random.randint(3, 6)
+    heights = [height] * rows
+    widths = [width]
+    return _render_partition(heights, widths, [])
