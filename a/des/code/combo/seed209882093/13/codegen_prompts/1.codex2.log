+            c0 = col_starts[c]
+            grid[r0 : r0 + height, c0 : c0 + width] = BG
+
+    for (r1, c1), (r2, c2) in opened_edges:
+        if r1 == r2:
+            r = r1
+            c = min(c1, c2)
+            wall_col = col_starts[c] + widths[c]
+            r0 = row_starts[r]
+            grid[r0 : r0 + heights[r], wall_col] = BG
+        else:
+            r = min(r1, r2)
+            c = c1
+            wall_row = row_starts[r] + heights[r]
+            c0 = col_starts[c]
+            grid[wall_row, c0 : c0 + widths[c]] = BG
+
+    return grid
+
