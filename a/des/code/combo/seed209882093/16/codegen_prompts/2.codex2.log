+            if not _can_place(occupied, top, left, sh, sw, pad=1):
+                continue
+            _paint_object(grid, expected, sprite, top, left, palette_colors[holes])
+            _reserve(occupied, top, left, sh, sw, pad=1)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    out = main(grid)
+    if not np.array_equal(out, expected):
+        return None
