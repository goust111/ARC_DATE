def _nearby(r: int, c: int, dist: int, ref: set) -> bool:
    """Return True if any pixel in `ref` is within Chebyshev distance `dist`."""
    for dr in range(-dist, dist + 1):
        for dc in range(-dist, dist + 1):
            if (r + dr, c + dc) in ref:
                return True
    return False


