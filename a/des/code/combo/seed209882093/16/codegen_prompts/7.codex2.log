+            out[cell] = next(iter(colors))
+
+    return out
+
+
+def _bbox_gap(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]) -> int:
+    ar, ac, ah, aw = box_a
+    br, bc, bh, bw = box_b
+    a_r0, a_r1 = ar, ar + ah - 1
+    a_c0, a_c1 = ac, ac + aw - 1
+    b_r0, b_r1 = br, br + bh - 1
+    b_c0, b_c1 = bc, bc + bw - 1
