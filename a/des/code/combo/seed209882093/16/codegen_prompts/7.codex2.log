+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 400
+GRID_MAX_SIDE = 30
+ISLAND_COUNT_RANGE = (3, 5)
+OUTER_MARGIN_RANGE = (1, 4)
+SIZE_RANGE = (3, 5)
+COLORS = tuple(range(1, 10))
