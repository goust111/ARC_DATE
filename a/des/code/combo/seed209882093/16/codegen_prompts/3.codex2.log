+def _render_grid(
+    row_count: int,
+    col_count: int,
+    cell_h: int,
+    cell_w: int,
+    row_separator_colors: list[int],
+    col_separator_colors: list[int],
+    source_region: tuple[int, int],
+    source_coords: list[tuple[int, int]],
+    *,
+    vertical_overrides: bool,
