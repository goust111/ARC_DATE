+def _is_connected(coords: list[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    coord_set = set(coords)
+    seen = {coords[0]}
+    queue: deque[tuple[int, int]] = deque([coords[0]])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in coord_set and (nr, nc) not in seen:
+                seen.add((nr, nc))
