from __future__ import annotations

import random

import numpy as np


BLACK = 0
GREY = 5
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
SIDE_TO_CW_TURNS = {
    "up": 0,
    "right": 1,
    "down": 2,
    "left": 3,
}
COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(int(r), int(c))]
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                comp.append((rr, cc))
                for dr, dc in DIR4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(comp)
    return comps


def _bbox(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in cells]
    cols = [c for _, c in cells]
    return min(rows), min(cols), max(rows), max(cols)


def _cells_to_mask(
    cells: list[tuple[int, int]] | set[tuple[int, int]]
) -> tuple[np.ndarray, tuple[int, int, int, int]]:
    r0, c0, r1, c1 = _bbox(cells)
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    for r, c in cells:
        mask[r - r0, c - c0] = True
    return mask, (r0, c0, r1, c1)


def _full_border(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
    border = set()
    for r in range(r0, r1 + 1):
        border.add((r, c0))
        border.add((r, c1))
    for c in range(c0, c1 + 1):
        border.add((r0, c))
        border.add((r1, c))
    return border


def _contiguous(values: list[int]) -> bool:
    if not values:
        return False
    return values == list(range(values[0], values[-1] + 1))


def _marker_side(marker: tuple[int, int], gap_cells: list[tuple[int, int]]) -> str:
    gr0, gc0, gr1, gc1 = _bbox(gap_cells)
    mr, mc = marker
    if mr < gr0:
        return "up"
    if mr > gr1:
        return "down"
    if mc < gc0:
        return "left"
    if mc > gc1:
        return "right"
    raise AssertionError("marker must be adjacent to, not inside, the gap")


def _parse_frame(g: np.ndarray, comp: list[tuple[int, int]]) -> dict:
    cells = set(comp)
    r0, c0, r1, c1 = _bbox(comp)
    assert r1 - r0 + 1 >= 5 and c1 - c0 + 1 >= 5

