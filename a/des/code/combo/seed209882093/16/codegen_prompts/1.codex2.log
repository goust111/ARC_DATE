+    if mr < gr0:
+        return "up"
+    if mr > gr1:
+        return "down"
+    if mc < gc0:
+        return "left"
+    if mc > gc1:
+        return "right"
+    raise AssertionError("marker must be adjacent to, not inside, the gap")
