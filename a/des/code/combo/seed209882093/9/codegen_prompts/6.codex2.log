+
+
+def _touches_walls(coords: np.ndarray, h: int, w: int) -> dict[str, bool]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return {
+        "top": bool(np.any(rows == 1)),
+        "right": bool(np.any(cols == w - 2)),
+        "bottom": bool(np.any(rows == h - 2)),
+        "left": bool(np.any(cols == 1)),
