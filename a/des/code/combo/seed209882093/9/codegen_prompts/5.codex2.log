+
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+SIDE_ORDER = ("U", "R", "D", "L")
+OPPOSITE = {"U": "D", "R": "L", "D": "U", "L": "R"}
+LEFT_OF = {"U": "L", "R": "U", "D": "R", "L": "D"}
+RIGHT_OF = {v: k for k, v in LEFT_OF.items()}
+
+GREY = 5
+GEN_RETRIES = 400
