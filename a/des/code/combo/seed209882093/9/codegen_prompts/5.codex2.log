+def _step(point: tuple[int, int], side: str, scale: int = 1) -> tuple[int, int]:
+    dr, dc = DIRS[side]
+    return point[0] + dr * scale, point[1] + dc * scale
+
+
+def _neg(vec: tuple[int, int]) -> tuple[int, int]:
