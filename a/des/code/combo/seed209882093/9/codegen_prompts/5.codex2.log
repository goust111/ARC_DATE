   5: def main(grid: np.ndarray) -> np.ndarray:
   6:     """
   7:     Sort scattered 4×4 squares into two columns by type: frames left, solids right.
   8: 
   9:     Input structure:
  10:     - bg = most common color. Multiple 4×4 objects on bg.
  11:     - Frames: colored 1px border, bg-filled 2×2 interior.
  12:     - Solids: entirely filled with one non-bg color.
  13: 
  14:     Rule:
  15:     - Classify each 4×4 object as frame or solid by its interior.
  16:     - Sort each group top-to-bottom by input row.
  17:     - Stack frames in left column (cols 0–3), solids in right (cols 4–7).
  18:     - Output is 8 wide; height = 4 × max(#frames, #solids), bg-padded.
  19: 
  20:     Key insight: Frame vs solid is determined solely by whether the 2×2 interior matches bg.
  21:     """
  22:     g = np.array(grid, dtype=int)
  23:     bg = int(get_bg(g))
  24: 
  25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
  26:     frames: list[tuple[int, int, np.ndarray]] = []
  27:     solids: list[tuple[int, int, np.ndarray]] = []
  28: 
  29:     for comp in comps:
  30:         b = comp["bbox"]
  31:         if bbox_h(b) != 4 or bbox_w(b) != 4:
  32:             continue
  33:         r0, c0, _r1, _c1 = b
  34:         sub = crop_bbox(g, b)
  35: 
  36:         border = np.concatenate([sub[0, :], sub[-1, :], sub[1:-1, 0], sub[1:-1, -1]])
  37:         bcols = set(map(int, border.flatten()))
  38: 
  39:         if len(bcols) == 1 and bool((sub[1:3, 1:3] == int(bg)).all()):
  40:             frames.append((int(r0), int(c0), sub))
  41:         else:
  42:             solids.append((int(r0), int(c0), sub))
  43: 
  44:     frames.sort(key=lambda t: (int(t[0]), int(t[1])))
  45:     solids.sort(key=lambda t: (int(t[0]), int(t[1])))
  46: 
  47:     outH = 4 * max(int(len(frames)), int(len(solids)))
  48:     outW = 8
  49:     out = np.full((outH, outW), int(bg), dtype=int)
  50: 
  51:     for i, (_r0, _c0, sub) in enumerate(frames):
  52:         paste(out, sub, int(i * 4), 0)
  53:     for i, (_r0, _c0, sub) in enumerate(solids):
  54:         paste(out, sub, int(i * 4), 4)
  55: 
  56:     return out
