+            return None
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return None
+    for r, c in pts:
+        if r0 < r < r1 and c0 < c < c1:
+            return None
+    return int(r0), int(c0), int(r1), int(c1)
