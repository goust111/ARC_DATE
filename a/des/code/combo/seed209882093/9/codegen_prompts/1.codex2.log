+def _parse_legend_entries(strip: np.ndarray, bg: int, tile_size: int) -> list[tuple[int, np.ndarray]] | None:
+    h, w = strip.shape
+    if h != tile_size:
+        return None
+    entries: list[tuple[int, np.ndarray]] = []
+    consumed = np.zeros_like(strip, dtype=bool)
+    c = 0
+    while c < w:
+        if np.all(strip[:, c] == bg):
+            c += 1
