+def _draw_frame(grid: np.ndarray, r: int, c: int, outer_h: int, outer_w: int, color: int) -> None:
+    r1 = r + outer_h - 1
+    c1 = c + outer_w - 1
+    grid[r : r1 + 1, c] = color
+    grid[r : r1 + 1, c1] = color
+    grid[r, c : c1 + 1] = color
+    grid[r1, c : c1 + 1] = color
