+_TEMPLATES_3 = [
+    np.array([[0, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),
+    np.array([[0, 0, 1], [0, 1, 1], [1, 1, 0]], dtype=int),
+    np.array([[0, 1, 2], [2, 0, 1], [1, 2, 0]], dtype=int),
+    np.array([[0, 0, 1], [2, 1, 2], [1, 0, 0]], dtype=int),
+    np.array([[0, 1, 0], [2, 2, 1], [0, 1, 2]], dtype=int),
+]
