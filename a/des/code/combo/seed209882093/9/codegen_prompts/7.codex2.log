+
+
+def _draw_separators(grid: np.ndarray, row_sep: int | None, col_sep: int | None) -> None:
+    if row_sep is not None:
+        grid[row_sep, :] = HORIZONTAL_SEPARATOR_COLOR
+    if col_sep is not None:
+        grid[:, col_sep] = VERTICAL_SEPARATOR_COLOR
