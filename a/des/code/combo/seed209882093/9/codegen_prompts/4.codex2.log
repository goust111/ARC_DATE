+    max_inner_h = int(MAX_STRUCTURE_SIDE - 2 * total_thickness)
+    max_inner_w = int(MAX_STRUCTURE_SIDE - 2 * total_thickness)
+    if max_inner_h < 1 or max_inner_w < 1:
+        return None
