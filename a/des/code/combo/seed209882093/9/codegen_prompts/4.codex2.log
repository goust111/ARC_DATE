+
+import numpy as np
+
+
+COLOR_VALUES = tuple(range(10))
+MAX_STRUCTURE_SIDE = 15
+MAX_CANVAS_SIDE = 30
+RING_COUNT_RANGE = (2, 5)
+THICKNESS_OPTIONS = (1, 2, 3)
+CANVAS_EXTRA_RANGE = (2, 12)
+CENTER_JITTER = 2
+GEN_RETRY_LIMIT = 400
+
+
