+                        continue
+                    trial = cells | {(nr, nc)}
+                    rows = [p[0] for p in trial]
+                    cols = [p[1] for p in trial]
+                    if max(rows) - min(rows) + 1 <= max_h and max(cols) - min(cols) + 1 <= max_w:
