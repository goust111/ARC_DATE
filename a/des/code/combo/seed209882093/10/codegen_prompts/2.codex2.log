+    except RuntimeError:
+        return None
+
+    n_rows = int(rng.integers(max(3, math.ceil(math.sqrt(n_fragments))), 7))
+    n_cols = int(rng.integers(max(3, math.ceil(math.sqrt(n_fragments))), 7))
