+        ok = True
+
+        for color in colors:
+            placed = False
+            for _ in range(200):
+                area = int(rng.integers(2, 7))
+                max_h = min(pr, int(rng.integers(2, min(pr, 4) + 1)))
+                max_w = min(pc, int(rng.integers(2, min(pc, 4) + 1)))
