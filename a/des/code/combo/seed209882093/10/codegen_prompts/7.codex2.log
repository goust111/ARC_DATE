+GEN_OBJECT_COUNT_RANGE = (3, 6)
+GEN_SHAPE_HEIGHT_RANGE = (1, 5)
+GEN_SHAPE_WIDTH_RANGE = (1, 6)
+GEN_SHAPE_CELLS_RANGE = (3, 9)
