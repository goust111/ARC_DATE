+            if color == 0 or visited[r, c]:
+                continue
+
+            stack = [(r, c)]
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
