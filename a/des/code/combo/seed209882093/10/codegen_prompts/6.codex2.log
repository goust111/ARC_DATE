+    rr0 = max(0, r0 - OBJECT_GAP)
+    cc0 = max(0, c0 - OBJECT_GAP)
+    rr1 = min(H, r0 + height + OBJECT_GAP)
+    cc1 = min(W, c0 + width + OBJECT_GAP)
