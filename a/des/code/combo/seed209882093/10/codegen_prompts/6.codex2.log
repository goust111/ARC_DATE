+        chosen = _choose_cross_candidate(candidates, require_overlap=require_overlap, require_arm_hit=require_arm_hit)
+        if chosen is None:
+            return None
+
+        cross = {
+            "center": chosen["center"],
+            "color": int(color),
+            "length": int(length),
+            "pixels": chosen["pixels"],
+            "pixel_set": chosen["pixel_set"],
+            "square": chosen["square"],
