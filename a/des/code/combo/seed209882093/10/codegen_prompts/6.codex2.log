+        if len(set(lengths)) != 1:
+            continue
+
+        length = int(lengths[0])
+        if not 2 <= length <= 4:
+            continue
+
+        exact = True
+        for dr, dc in DIR4:
+            rr = r + dr * (length + 1)
+            cc = c + dc * (length + 1)
+            if _in_bounds(g, rr, cc) and int(g[rr, cc]) == color:
+                exact = False
+                break
