+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 17
+GRID_MAX = 30
+OUTER_SIZE_MIN = 6
+OUTER_SIZE_MAX = 8
+FRAME_COUNT_MIN = 1
+FRAME_COUNT_MAX = 4
+GENERATION_ATTEMPTS = 400
