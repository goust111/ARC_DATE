+
+
+def _build_pattern(inner_h: int, inner_w: int, gap_side: str, fill_color: int, rng: random.Random) -> np.ndarray | None:
+    if inner_h < 4 or inner_w < 4:
+        return None
+
+    core_h, core_w = inner_h - 2, inner_w - 2
+    for _ in range(60):
