    rng: random.Random,
    direction: tuple[int, int],
) -> tuple[np.ndarray, tuple[int, int]]:
    for _ in range(SHAPE_ATTEMPTS):
        box_h = rng.randint(*SHAPE_BBOX_H_RANGE)
        box_w = rng.randint(*SHAPE_BBOX_W_RANGE)
        max_area = min(SHAPE_AREA_RANGE[1], box_h * box_w)
