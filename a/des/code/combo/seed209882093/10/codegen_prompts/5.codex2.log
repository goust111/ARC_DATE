+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _rounded_mean(values: np.ndarray) -> int:
+    return int(np.floor(float(values.mean()) + 0.5))
+
+
+def _closest_direction(delta_r: int, delta_c: int) -> tuple[int, int] | None:
+    if delta_r == 0 and delta_c == 0:
+        return None
+
+    best_dir: tuple[int, int] | None = None
+    best_score = float("-inf")
+    second_score = float("-inf")
+    for dr, dc in DIRS8:
+        score = (delta_r * dr + delta_c * dc) / ((dr * dr + dc * dc) ** 0.5)
+        if score > best_score + 1e-9:
+            second_score = best_score
+            best_score = score
+            best_dir = (dr, dc)
+        elif score > second_score:
+            second_score = score
+    if best_score - second_score <= 1e-9:
+        return None
+    return best_dir
+
+
+def _copy_positions(
+    top: int,
+    left: int,
+    stamp_h: int,
+    stamp_w: int,
+    direction: tuple[int, int],
+    grid_h: int,
+    grid_w: int,
