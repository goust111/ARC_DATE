+import numpy as np
+
+
+BG = 7
+PALETTE = tuple(range(10))
+ORTHO_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator bounds.
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
