+    cr, cc = center
+    return [(cr + dr, cc + dc) for dr, dc in shape]
+
+
+def _expanded(cells: list[tuple[int, int]], h: int, w: int, radius: int = 1) -> set[tuple[int, int]]:
+    out = set()
