+def _place_rect(
+    occupied: np.ndarray,
+    height: int,
+    width: int,
+    tries: int = 200,
+) -> tuple[int, int] | None:
+    h, w = occupied.shape
+    if height > h or width > w:
+        return None
+    for _ in range(tries):
+        r0 = random.randint(0, h - height)
+        c0 = random.randint(0, w - width)
+        rect = (r0, c0, r0 + height - 1, c0 + width - 1)
+        if _can_place(rect, occupied, pad=1):
