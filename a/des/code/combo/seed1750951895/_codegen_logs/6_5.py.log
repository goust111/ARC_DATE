+    h, w = occupied.shape
+    r0, c0, r1, c1 = rect
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return not occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any()
+
+
+def _mark(rect: tuple[int, int, int, int], occupied: np.ndarray) -> None:
+    r0, c0, r1, c1 = rect
+    occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+
