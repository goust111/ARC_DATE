+        return
+    if sym_type == "v_only":
+        out[r0 : r1 + 1, cc] = color
+        return
+    if sym_type == "rot_only":
+        out[cr, cc] = color
+        return
+    if sym_type == "full":
+        for rr, cc2 in ((cr, cc), (cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+            if 0 <= rr < out.shape[0] and 0 <= cc2 < out.shape[1]:
+                out[rr, cc2] = color
+        return
+    raise AssertionError("unknown symmetry type")
