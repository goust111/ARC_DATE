+import numpy as np
+
+
+AZURE = 8
+_RNG = np.random.default_rng()
+_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+_FG_COLORS = tuple(c for c in range(10) if c != AZURE)
+_MAX_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in _DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
+            )
+    return comps
+
+
+def _symmetry_type(mask: np.ndarray) -> str:
+    horiz = bool(np.array_equal(mask, np.flipud(mask)))
+    vert = bool(np.array_equal(mask, np.fliplr(mask)))
+    rot = bool(np.array_equal(mask, np.flipud(np.fliplr(mask))))
+    if horiz and vert:
+        return "full"
+    if horiz:
