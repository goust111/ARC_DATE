+        nr0 = r0 + dr
+        nc0 = c0 + dc
+        nr1 = nr0 + h - 1
+        nc1 = nc0 + w - 1
+        assert 0 <= nr0 <= nr1 < g.shape[0]
+        assert 0 <= nc0 <= nc1 < g.shape[1]
+        out[nr0 : nr1 + 1, nc0 : nc1 + 1] = color
+
+    return out
+
+
+def _corner_vectors() -> list[tuple[str, tuple[int, int], callable]]:
+    return [
