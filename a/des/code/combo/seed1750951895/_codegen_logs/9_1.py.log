+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+GREY = 5
+
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+
