+) -> np.ndarray:
+    h, w = mask.shape
+    template = np.zeros((h, w), dtype=int)
+    mode = int(rng.integers(0, 3))
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if len(colors) == 1:
+                val = colors[0]
+            elif mode == 0:
+                val = colors[(r + c) % len(colors)]
+            elif mode == 1:
+                val = colors[r % len(colors)]
+            else:
+                band = 0 if c < w // 2 else 1
+                val = colors[(band + r) % len(colors)]
+            template[r, c] = int(val)
