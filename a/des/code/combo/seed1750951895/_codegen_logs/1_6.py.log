+                if val != BLACK:
+                    counts[val] = counts.get(val, 0) + 1
+            if not counts:
+                continue
+            best = max(counts.values())
+            winners = [color for color, count in counts.items() if count == best]
+            assert len(winners) == 1, "template vote must be unambiguous"
+            template[r, c] = int(winners[0])
+    return template
