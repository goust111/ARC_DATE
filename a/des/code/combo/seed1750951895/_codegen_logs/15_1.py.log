+        placed += 1
+
+    if placed != cols:
+        return None
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if not isinstance(out, np.ndarray) or out.shape != grid.shape:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(300):
