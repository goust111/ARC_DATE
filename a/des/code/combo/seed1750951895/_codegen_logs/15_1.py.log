+                    _stamp(grid, patch, r0, c0, int(color))
+                    success = True
+                    break
+            if not success:
+                return None
+        placed += 1
+
+    if placed != cols:
+        return None
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if not isinstance(out, np.ndarray) or out.shape != grid.shape:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(300):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after 300 attempts")

