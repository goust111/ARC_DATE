+def _paste_centered(out: np.ndarray, patch: np.ndarray, slot: tuple[int, int, int, int], color: int, bg: int = BG) -> None:
+    sr0, sc0, sr1, sc1 = slot
+    ph, pw = patch.shape
+    sh = sr1 - sr0 + 1
+    sw = sc1 - sc0 + 1
+    dr = sr0 + (sh - ph) // 2
