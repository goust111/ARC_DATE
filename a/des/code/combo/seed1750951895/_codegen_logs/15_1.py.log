+            ph, pw = patch.shape
+            for _ in range(150):
+                r0 = rng.randint(0, H - ph)
+                c0 = rng.randint(0, max(0, fc0 - pw - 1))
+                if _can_place(grid, patch, r0, c0, pad=1):
+                    _stamp(grid, patch, r0, c0, int(color))
+                    success = True
