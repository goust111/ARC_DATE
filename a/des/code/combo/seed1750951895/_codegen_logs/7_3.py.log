+def _decode_layers(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert w == 4 and h >= 2 and h % 2 == 0
+
+    layers: list[tuple[int, int, int, int]] = []
+    for r in range(h - 2, -1, -2):
