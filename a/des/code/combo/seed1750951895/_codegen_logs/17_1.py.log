+                rr = int(r)
+                cc = int(c)
+                crack_c = marker_by_row[rr]
+                assert cc != crack_c, "body cannot occupy crack"
+                _paint(out, rr, cc - 1 if cc < crack_c else cc + 1, body)
+        else:
+            marker_by_col: dict[int, int] = {}
+            for r, c in marker_coords:
+                rr = int(r)
+                cc = int(c)
