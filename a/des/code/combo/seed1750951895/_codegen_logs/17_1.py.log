+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _paint(out: np.ndarray, r: int, c: int, color: int) -> None:
+    h, w = out.shape
+    assert 0 <= r < h and 0 <= c < w, "shifted pixel left the grid"
+    assert int(out[r, c]) == _get_bg(out), "shifted pixels collided"
+    out[r, c] = int(color)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected 2D grid"
+    bg = _get_bg(g)
+    out = np.full_like(g, bg)
+
+    for coords in _find_components(g, bg):
+        vals = g[coords[:, 0], coords[:, 1]]
+        counts = Counter(map(int, vals))
