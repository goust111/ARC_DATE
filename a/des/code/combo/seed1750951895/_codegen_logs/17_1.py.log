+            for r, c in marker_coords:
+                rr = int(r)
+                cc = int(c)
+                assert rr not in marker_by_row, "wide object must have one marker per row"
+                marker_by_row[rr] = cc
+            assert set(marker_by_row) == set(range(int(r0), int(r1) + 1)), "marker line must span object height"
