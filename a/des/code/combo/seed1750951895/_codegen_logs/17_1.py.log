        col_range = range(0, n - w + 1)

    locs: list[Location] = []
    for r in row_range:
        for c in col_range:
            orig = (r, c, r + h - 1, c + w - 1)
            exp = _expanded_bbox(r, c, h, w)
            if any(not _cheb_gap_at_least_2(orig, old) for old in originals):
                continue
            if any(_overlap(exp, old) for old in expanded):
