+        if np.all(grid[r] == color) and color != BLACK:
+            candidates.append(("h", r, color))
+    for c in range(w):
+        color = int(grid[0, c])
+        if np.all(grid[:, c] == color) and color != BLACK:
+            candidates.append(("v", c, color))
+
+    assert len(candidates) == 1, "expected exactly one full separator line"
+    return candidates[0]
