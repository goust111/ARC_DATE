+
+def _pick_partitions(total: int, n_cells: int, min_size: int) -> list[int] | None:
+    free = total - (n_cells - 1) - n_cells * min_size
+    if free < 0:
+        return None
+    sizes = [min_size] * n_cells
+    for _ in range(free):
+        sizes[random.randrange(n_cells)] += 1
+    random.shuffle(sizes)
