+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG_COLOR = 7
+SIDE_CYCLE = {1: 9, 3: 1, 5: 3, 7: 5, 9: 7}
+SIDE_CHOICES = [1, 3, 5, 7, 9]
