+    if first:
+        r0 = r - rect_h + 1 if row_sign == 1 else r
+        c0 = c - rect_w + 1 if col_sign == 1 else c
+    else:
+        r0 = r if row_sign == 1 else r - rect_h + 1
+        c0 = c if col_sign == 1 else c - rect_w + 1
