+def _draw_diagonal(out: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int, bg: int) -> None:
+    dr = end[0] - start[0]
+    dc = end[1] - start[1]
+    step_r = 1 if dr > 0 else -1
+    step_c = 1 if dc > 0 else -1
+    steps = min(abs(dr), abs(dc))
+    for k in range(steps + 1):
+        r = start[0] + k * step_r
+        c = start[1] + k * step_c
+        if int(out[r, c]) == bg:
+            out[r, c] = color
