+
+    for _ in range(extra_count):
+        if not _try_place_extra(grid, specs):
+            return None
+
+    if not _good_scene(grid):
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
