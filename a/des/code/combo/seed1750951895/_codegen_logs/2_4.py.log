+
+def _target_hit_cell(top: int, left: int, direction: tuple[int, int]) -> tuple[int, int]:
+    if direction == RIGHT:
+        return (top + 1, left)
+    if direction == LEFT:
+        return (top + 1, left + 2)
+    if direction == DOWN:
+        return (top, left + 1)
+    return (top + 2, left + 1)
+
+
+def _try_place_pair(
+    grid: np.ndarray,
+    specs: list[tuple[int, int, tuple[int, int]]],
+    direction: tuple[int, int],
+) -> bool:
+    shape = grid.shape
+    for _ in range(PLACE_ATTEMPTS):
