        path = _ray_path_cells(st, sl, direction, shape)
        target_cells = {(tt + r, tl + c) for r, c in SPRITE_PATTERNS[random.choice(DIRS)]}
        hit_pos = next((cell for cell in path if cell in target_cells), None)
        if hit_pos is None:
