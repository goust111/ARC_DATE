+MAX_RETRIES = 300
+RNG = np.random.default_rng()
+
+
+def _split_quadrants(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h == w and h % 2 == 0
+    n = h // 2
+    return g[:n, :n], g[:n, n:], g[n:, :n], g[n:, n:]
+
+
