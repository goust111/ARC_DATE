+            oper = _perimeter_cells(other["box"])
+            if cells & oper:
+                hits_border = True
+                break
+        if not hits_border:
+            return corner
+    return None
+
+
+def _visible_side_counts(grid, rect):
+    color = rect["color"]
+    r0, c0, r1, c1 = rect["box"]
+    return [
