+            seen = {int(grid[r, c]) for r, c in inter if int(grid[r, c]) in (a["color"], b["color"])}
+            if len(seen) != 1:
+                continue
+            top = next(iter(seen))
+            bot = b["color"] if top == a["color"] else a["color"]
+            if top not in edges[bot]:
+                edges[bot].add(top)
+                indeg[top] += 1
