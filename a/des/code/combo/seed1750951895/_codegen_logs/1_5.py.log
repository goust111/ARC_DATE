+
+def _bbox_from_mask(mask: np.ndarray):
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return None
+    r0 = int(pts[:, 0].min())
+    c0 = int(pts[:, 1].min())
+    r1 = int(pts[:, 0].max())
+    c1 = int(pts[:, 1].max())
+    return (r0, c0, r1, c1)
+
+
+def _perimeter_cells(box):
+    r0, c0, r1, c1 = box
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _corner_window(box, corner: str):
+    r0, c0, r1, c1 = box
+    if corner == "tl":
+        return (r0 + 1, c0 + 1)
+    if corner == "tr":
+        return (r0 + 1, c1 - 3)
+    if corner == "bl":
+        return (r1 - 3, c0 + 1)
+    return (r1 - 3, c1 - 3)
+
+
+def _component_masks(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comp = np.zeros_like(mask, dtype=bool)
+            for rr, cc in coords:
