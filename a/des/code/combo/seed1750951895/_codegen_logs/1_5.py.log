+        int((grid[r1, c0 : c1 + 1] == color).sum()),
+        int((grid[r0 : r1 + 1, c0] == color).sum()),
+        int((grid[r0 : r1 + 1, c1] == color).sum()),
+    ]
+
+
+def _build_instance(rng: random.Random):
+    h = rng.randint(22, 31)
+    w = rng.randint(22, 31)
+    n = rng.randint(3, 6)
