+    # Require each adjacent pair to expose a witness overlap cell of the upper color.
+    for low, high in zip(order, order[1:]):
+        inter = _perimeter_cells(frames_by_color[low]["box"]) & _perimeter_cells(frames_by_color[high]["box"])
+        if not inter:
