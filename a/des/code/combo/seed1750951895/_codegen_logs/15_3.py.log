+                    bottom = _uniform_non_bg(g[r1, c0 + 1 : c1])
+                    left = _uniform_non_bg(g[r0 + 1 : r1, c0])
+                    right = _uniform_non_bg(g[r0 + 1 : r1, c1])
+                    if None in (top, bottom, left, right):
