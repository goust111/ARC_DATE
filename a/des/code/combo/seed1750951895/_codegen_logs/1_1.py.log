+
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _normalize(coords):
+    pts = np.array(coords, dtype=int)
+    pts[:, 0] -= int(pts[:, 0].min())
+    pts[:, 1] -= int(pts[:, 1].min())
+    pts = pts[np.lexsort((pts[:, 1], pts[:, 0]))]
+    return tuple((int(r), int(c)) for r, c in pts)
+
+
+def _shape_variants(coords):
+    pts = np.array(coords, dtype=int)
+    out = []
+    seen = set()
+    for flip in (False, True):
+        cur = pts.copy()
+        if flip:
+            cur[:, 1] *= -1
+        for k in range(4):
+            rot = cur.copy()
+            for _ in range(k):
+                rot = np.stack([-rot[:, 1], rot[:, 0]], axis=1)
+            key = _normalize(rot)
+            if key not in seen:
+                seen.add(key)
+                out.append(key)
+    return out
+
+
+def _canonical_shape(coords):
+    return min(_shape_variants(coords))
+
+
+def _components(mask):
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in N4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords):
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _legend_order(grid):
+    row = np.asarray(grid[-1], dtype=int)
+    order = []
+    prev = None
+    for val in row:
+        val = int(val)
+        if val != BLACK and val != prev:
+            order.append(val)
+        prev = val
+    assert len(order) >= 2
+    return order
+
+
+def _find_frame(grid, color):
+    pts = [(int(r), int(c)) for r, c in np.argwhere(grid[:-1] == color)]
+    assert pts
+    r0, c0, r1, c1 = _bbox(pts)
+    assert r1 - r0 >= 2 and c1 - c0 >= 2
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    assert set(pts) == expected
+    return r0, c0, r1, c1
+
+
+def _frame_holes(grid, frame_bbox):
+    r0, c0, r1, c1 = frame_bbox
+    inside = grid[r0 + 1 : r1, c0 + 1 : c1] == BLACK
+    holes = []
+    for comp in _components(inside):
+        rel = _normalize(comp)
+        abs_comp = [(r0 + 1 + r, c0 + 1 + c) for r, c in comp]
+        holes.append({"coords": abs_comp, "shape": _canonical_shape(rel)})
+    assert holes
+    return holes
+
+
+def _sprite_map(grid, frame_boxes):
+    h, w = grid.shape
+    blocked = np.zeros((h, w), dtype=bool)
+    blocked[-1, :] = True
+    for r0, c0, r1, c1 in frame_boxes:
