FG_DENSITY_MIN = 0.14
FG_DENSITY_MAX = 0.22
RECT_LOOP_PROB = 0.25
BRANCH_TRANSPOSE_PROB = 0.5
MIN_BRANCH_ROW_GAP = 1

# Color and retry settings.
