+    sep_rows = _find_separator_lines(g, axis=0, bg=bg)
+    sep_cols = _find_separator_lines(g, axis=1, bg=bg)
+    assert len(sep_rows) == PANEL_ROWS - 1
+    assert len(sep_cols) == PANEL_COLS - 1
