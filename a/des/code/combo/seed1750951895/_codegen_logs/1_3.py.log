+    for r0, r1 in row_spans:
+        row = []
+        for c0, c1 in col_spans:
+            row.append(g[r0:r1, c0:c1])
+        panels.append(row)
+    return panels, ph, pw
+
+
+def _panel_info(panel: np.ndarray, bg: int) -> dict:
+    comps = _components_by_color(panel, bg)
+    assert len(comps) == 2
+    odd_color = None
+    odd_comp = None
+    major_color = None
+    major_comps = None
+    for color, parts in comps.items():
+        if len(parts) == 1:
