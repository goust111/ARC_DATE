+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 + 1 != SQUARE_SIZE or c1 - c0 + 1 != SQUARE_SIZE:
+        return False
+    return bool(np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color))
