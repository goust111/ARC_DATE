+def _sprite_cells(direction: str, top: int, left: int) -> tuple[list[tuple[int, int]], int]:
+    if direction == "up":
+        cells = [(top + r, left + 1) for r in range(4)] + [(top, left + c) for c in range(3)]
+        return cells, left + 1
+    if direction == "down":
