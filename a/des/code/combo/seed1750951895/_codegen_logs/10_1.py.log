+    v_lines = [j for j in range(patch.shape[1]) if bool((patch[:, j] == frame_color).all())]
+    if len(h_lines) < 2 or len(v_lines) < 2:
+        return None
+    if h_lines[0] != 0 or h_lines[-1] != patch.shape[0] - 1:
+        return None
+    if v_lines[0] != 0 or v_lines[-1] != patch.shape[1] - 1:
+        return None
