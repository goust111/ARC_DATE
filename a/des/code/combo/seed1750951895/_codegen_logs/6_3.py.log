+
+def _has_cross_center(mask: np.ndarray, r: int, c: int) -> bool:
+    return bool(
+        mask[r, c]
+        and 0 < r < mask.shape[0] - 1
+        and 0 < c < mask.shape[1] - 1
+        and mask[r - 1, c]
+        and mask[r + 1, c]
+        and mask[r, c - 1]
+        and mask[r, c + 1]
+    )
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor every foreground pixel whose 4-neighbors are all foreground, and
+    also recolor its four orthogonal neighbors, to azure.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    fg = g != BACKGROUND
+    mark = np.zeros_like(fg, dtype=bool)
+    H, W = g.shape
+
+    for r in range(1, H - 1):
+        for c in range(1, W - 1):
+            if _has_cross_center(fg, r, c):
+                mark[r, c] = True
+                mark[r - 1, c] = True
+                mark[r + 1, c] = True
+                mark[r, c - 1] = True
+                mark[r, c + 1] = True
+
+    out = g.copy()
+    out[mark] = AZURE
+    return out
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    H, W = mask.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            src_r0 = max(0, -dr)
+            src_r1 = min(H, H - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(W, W - dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = min(H, H + dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = min(W, W + dc)
+            out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[src_r0:src_r1, src_c0:src_c1]
+    return out
+
+
+def _can_place(shape: np.ndarray, occupied: np.ndarray) -> bool:
+    if shape.shape != occupied.shape:
+        return False
+    return not bool((_dilate8(shape) & occupied).any())
