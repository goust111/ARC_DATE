+    grid_w = max(max(w for _, w in dims) + 2 * MARGIN, random.randint(*GRID_WIDTH_RANGE))
+
+    extra_h = sum(h for h, _ in dims) + (frame_count - 1) * random.randint(*GAP_RANGE) + 2 * MARGIN
