+    extra_w = sum(w for _, w in dims) + (frame_count - 1) * random.randint(*GAP_RANGE) + 2 * MARGIN
+    grid_h = max(grid_h, min(max(GRID_HEIGHT_RANGE[1], extra_h), 40))
