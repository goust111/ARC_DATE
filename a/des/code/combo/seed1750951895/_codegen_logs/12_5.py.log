+        if b - a > 1:
+            spans.append((a + 1, b - 1))
+    assert spans
+    return spans
+
+
+def _parse_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], frame_color: int) -> dict:
+    r0, r1, c0, c1 = bbox
