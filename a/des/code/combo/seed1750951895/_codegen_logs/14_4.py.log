+        return None
+    if not np.any(out == unaffected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

