+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(occ.shape[0], r0 + h + margin)
+    cc1 = min(occ.shape[1], c0 + w + margin)
+    return not bool(occ[rr0:rr1, cc0:cc1].any())
+
+
+def _place_rect(
+    canvas: np.ndarray,
+    occ: np.ndarray,
