+def _place_blocked_marker(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    object_cells: set[tuple[int, int]],
+    color: int,
+) -> bool:
+    h, w = grid.shape
+    dr, dc = DIRS[color]
+    targets = list(object_cells)
+    rng.shuffle(targets)
+    for tr, tc in targets:
+        sr, sc = tr - dr, tc - dc
+        if not (0 <= sr < h and 0 <= sc < w):
+            continue
+        if grid[sr, sc] != BG:
+            continue
+        grid[sr, sc] = color
+        return True
+    return False
+
+
