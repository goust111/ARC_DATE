+                    "side": side,
+                    "frame_patch": frame_patch,
+                    "sprite_out": sprite_out,
+                    "sprite_in": sprite_in,
+                }
+            )
+        if not ok:
+            continue
+
+        used_spans = {"left": [], "right": [], "top": [], "bottom": []}
+        placed_frames = []
+        for spec in pair_specs:
+            fh, fw = spec["frame_patch"].shape
+            side = spec["side"]
+            placed = False
+            for _try in range(80):
+                if side == "left":
+                    top = random.randint(1, h - fh - 1)
+                    left = 0
+                    span = (top - 1, top + fh)
+                elif side == "right":
+                    top = random.randint(1, h - fh - 1)
+                    left = w - fw
+                    span = (top - 1, top + fh)
+                elif side == "top":
+                    top = 0
+                    left = random.randint(1, w - fw - 1)
+                    span = (left - 1, left + fw)
+                else:
+                    top = h - fh
+                    left = random.randint(1, w - fw - 1)
+                    span = (left - 1, left + fw)
