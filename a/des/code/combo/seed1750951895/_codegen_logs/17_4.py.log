+            elif spec["side"] == "right":
+                out_top = top + random.randint(0, max(0, fh - sh))
+                out_left = left - sw + 1
+            elif spec["side"] == "top":
+                out_top = top + fh - 1
+                out_left = left + random.randint(0, max(0, fw - sw))
+            else:
+                out_top = top - sh + 1
+                out_left = left + random.randint(0, max(0, fw - sw))
+            if not place_patch(expected, spec["sprite_out"], out_top, out_left, 0):
+                ok = False
+                break
+        if not ok:
+            continue
+
+        for spec in pair_specs:
+            placed = False
+            ih, iw = spec["sprite_in"].shape
+            for _try in range(120):
+                top = random.randint(2, h - ih - 3)
+                left = random.randint(2, w - iw - 3)
