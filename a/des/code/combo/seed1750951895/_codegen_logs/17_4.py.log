+    for flip in (False, True):
+        p0 = np.fliplr(patch) if flip else patch
+        m0 = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            p = np.rot90(p0, k)
+            m = np.rot90(m0, k)
+            key = (p.tobytes(), m.tobytes(), p.shape)
+            if key in seen:
+                continue
+            seen.add(key)
+            yield p.copy(), m.copy(), bool(flip)
