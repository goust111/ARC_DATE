+def pair_bbox_for_side(frame_shape: tuple[int, int], sprite_shape: tuple[int, int], side: str) -> tuple[int, int]:
+    fh, fw = frame_shape
+    sh, sw = sprite_shape
+    if side in ("left", "right"):
+        return max(fh, sh), fw + sw
+    return fh + sh, max(fw, sw)
