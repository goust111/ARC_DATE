+                    left = w - fw
+                    span = (top - 1, top + fh)
+                elif side == "top":
+                    top = 0
+                    left = random.randint(1, w - fw - 1)
+                    span = (left - 1, left + fw)
+                else:
+                    top = h - fh
+                    left = random.randint(1, w - fw - 1)
+                    span = (left - 1, left + fw)
