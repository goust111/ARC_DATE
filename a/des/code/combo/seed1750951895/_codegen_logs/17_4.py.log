+        frame = np.full((hole_h + 2, hole_w + 1), int(frame_color), dtype=int)
+        frame[1 : 1 + hole_h, 1 : 1 + hole_w][hole] = 0
+
+        sprite = np.zeros((hole_h, hole_w + 3), dtype=int)
+        sprite[:, :hole_w][hole] = int(plug_color)
+        sprite[outside] = int(outside_color)
