+                        ok = False
+                        break
+                translated.append((ar, ac, int(patch_v[rr, cc]), is_plug))
+            if not ok:
+                continue
+
+            plug_set = {(ar, ac) for ar, ac, _col, is_plug in translated if is_plug}
+            if plug_set != cavity_abs:
