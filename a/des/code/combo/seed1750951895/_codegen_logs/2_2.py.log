+def _random_mask(h: int, w: int) -> np.ndarray:
+    target = random.randint(max(2, (h * w) // 4), max(2, (3 * h * w) // 5))
+    seed_r = random.randrange(h)
+    seed_c = random.randrange(w)
+    cells = {(seed_r, seed_c)}
+    frontier = [(seed_r, seed_c)]
