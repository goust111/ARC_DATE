+_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _build_expected(labels: list[int], swatch_rows: list[int], swatches: list[int], masks: list[np.ndarray], bg: int) -> np.ndarray:
