+def _boxes_far_apart(boxes: list[tuple[int, int, int, int]], gap: int) -> bool:
+    for i, a in enumerate(boxes):
+        for b in boxes[i + 1 :]:
+            if not (
+                a[2] + gap < b[0]
+                or b[2] + gap < a[0]
+                or a[3] + gap < b[1]
+                or b[3] + gap < a[1]
+            ):
