+    if child_bbox is None:
+        return [(ir0, ic0, ir1, ic1)]
+    cr0, cc0, cr1, cc1 = child_bbox
+    bands: list[tuple[int, int, int, int]] = []
+    if ir0 <= cr0 - 1:
+        bands.append((ir0, ic0, cr0 - 1, ic1))
+    if cr1 + 1 <= ir1:
+        bands.append((cr1 + 1, ic0, ir1, ic1))
+    if ic0 <= cc0 - 1:
