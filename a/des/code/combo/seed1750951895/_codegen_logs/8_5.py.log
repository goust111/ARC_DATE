        c0 = rng.randint(0, width - pw)
        mask[r0 : r0 + ph, c0] = True
        mask[r0 + ph - 1, c0 : c0 + pw] = True
    return mask


def _stamp_pattern(
    grid: np.ndarray,
    frame_bbox: tuple[int, int, int, int],
