+INNER_HEIGHT_RANGE = (5, 9)
+INNER_WIDTH_RANGE = (5, 9)
+INSET_RANGE = (3, 5)
+OUTER_MARGIN_RANGE = (1, 4)
+MAX_GENERATION_ATTEMPTS = 300
