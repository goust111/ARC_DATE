+    depths: list[int] = []
+    descendants: list[list[tuple[int, int, int, int]]] = []
+    for i, frame in enumerate(frames):
+        bbox = frame["bbox"]
+        container_count = 0
+        smaller: list[tuple[int, int, int, int]] = []
+        for j, other in enumerate(frames):
