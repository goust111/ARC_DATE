+        for coords in _components_of_color(grid == color):
+            bbox = _bbox_from_coords(coords)
+            r0, c0, r1, c1 = bbox
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            comp_mask = np.zeros_like(grid, dtype=bool)
+            for r, c in coords:
