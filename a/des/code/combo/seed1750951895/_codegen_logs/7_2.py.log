+            c0 = SEP + c * (BLOCK + SEP)
+            grid[r0 : r0 + BLOCK, c0 : c0 + BLOCK] = block
+            idx += 1
+    return grid
+
+
+def _expected_output(blocks: list[np.ndarray], orientation: str) -> np.ndarray:
