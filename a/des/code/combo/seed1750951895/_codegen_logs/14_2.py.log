+SINGLETON_COUNT_RANGE = (3, 9)
+MIN_OBJECT_L1 = 4
+MIN_SINGLE_L1_TO_OBJECT = 3
+MIN_SINGLE_L1_TO_SINGLE = 2
+GEN_RETRIES = 400
