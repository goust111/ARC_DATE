def _gen_scatter_singletons(inp, multi_coords, count):
    rows, cols = inp.shape
    singles = []
    for _ in range(count):
        single_arr = np.array(singles, dtype=int) if singles else np.empty((0, 2), dtype=int)
        choices = []
        for r in range(rows):
            for c in range(cols):
