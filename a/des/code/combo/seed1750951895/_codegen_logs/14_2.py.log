        return 999
    return int(np.abs(a[:, None, :] - b[None, :, :]).sum(axis=2).min())


def _gen_valid_positions(shape, mask, placed):
    rows, cols = shape
    h, w = mask.shape
    local = np.argwhere(mask)
    positions = []
