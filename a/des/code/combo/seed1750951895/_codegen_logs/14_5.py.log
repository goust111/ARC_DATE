+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+            rs = [r0 for r0, _ in coords]
+            cs = [c0 for _, c0 in coords]
+            comps.append(
+                {
