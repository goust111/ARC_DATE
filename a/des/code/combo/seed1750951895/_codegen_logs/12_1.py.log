+def _render_object_patch(h: int, w: int, side: str, color: int) -> np.ndarray:
+    patch = np.full((h, w), BLUE, dtype=int)
+    if side == "top":
+        patch[0, :] = color
+    elif side == "bottom":
+        patch[-1, :] = color
+    elif side == "left":
+        patch[:, 0] = color
+    else:
+        patch[:, -1] = color
+    return patch
