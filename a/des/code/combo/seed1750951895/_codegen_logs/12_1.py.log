+def _sample_case() -> tuple[np.ndarray, np.ndarray] | None:
+    grid_h = random.randint(18, 28)
+    grid_w = random.randint(18, 28)
+    n_objects = random.randint(1, 3)
+
+    lengths = [1, 2, 3]
