+        _draw_patch(inp, spec["sprite_patch"], spec["sprite_box"])
+        _draw_patch(out, spec["sprite_patch"], spec["sprite_box"])
+        moved = _render_object_patch(spec["obj_h"], spec["obj_w"], spec["side"], spec["color"])
