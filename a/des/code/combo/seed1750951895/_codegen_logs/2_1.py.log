+    r0, c0 = random.choice(candidates)
+    grid[r0 : r0 + h0, c0 : c0 + w0] = color
+    return True
+
+
+def _build_parent_list(n: int) -> list[int | None]:
+    mode = random.choice(["chain", "star", "forest"])
+    parents: list[int | None] = [None]
+    if mode == "chain":
