+    degrees = _degree_profile(parents)
+
+    gh = random.randint(*GRID_SIZE_RANGE)
+    gw = random.randint(*GRID_SIZE_RANGE)
+    grid = np.zeros((gh, gw), dtype=int)
+
+    if not _place_rect(grid, colors[0], shapes[0], set()):
+        return None
+
+    for idx in range(1, n):
+        parent = parents[idx]
