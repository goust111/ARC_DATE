+    return [int(c) for c in range(mask.shape[1]) if bool(np.all(mask[:, c]))]
+
+
+def _parse_control(grid: np.ndarray) -> tuple[str, int, int]:
+    colors = [int(c) for c in np.unique(grid) if int(c) != BG]
