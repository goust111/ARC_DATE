        cc = (min(cs) + max(cs)) // 2
        bars.append(
            {
                "hbar": {(cr, cc - 1), (cr, cc), (cr, cc + 1)},
                "vbar": {(cr - 1, cc), (cr, cc), (cr + 1, cc)},
