+        assert dst >= 0
+        fill = (out[:, dst] == BG) & (content[:, src] != BG)
+        out[fill, dst] = content[:, src][fill]
+    return out
+
+
+def _fold_horizontal(content: np.ndarray, axis: int, fold_side: int) -> np.ndarray:
+    h, w = content.shape
+    if fold_side < 0:
+        out = content[axis + 1 :, :].copy()
