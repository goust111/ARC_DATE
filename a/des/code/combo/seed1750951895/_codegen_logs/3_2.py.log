+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+MAX_RETRIES = 400
+
+
+def _full_rows(mask: np.ndarray) -> list[int]:
+    return [int(r) for r in range(mask.shape[0]) if bool(np.all(mask[r, :]))]
+
+
