+    center_r = (h - 1) / 2.0
+    center_c = (w - 1) / 2.0
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        y = float(r) - center_r
+        x = float(c) - center_c
+        if k == 1:
+            ny, nx = -x, y
+        elif k == 2:
+            ny, nx = -y, -x
+        else:
+            ny, nx = x, -y
+        nr = center_r + ny
+        nc = center_c + nx
+        ir, ic = int(round(nr)), int(round(nc))
+        if abs(nr - ir) < 1e-6 and abs(nc - ic) < 1e-6 and 0 <= ir < h and 0 <= ic < w:
