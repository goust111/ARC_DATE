+def rotate_mask(mask: np.ndarray, steps_cw: int) -> np.ndarray:
+    k = int(steps_cw) % 4
+    if k == 0:
+        return mask.copy()
+    h, w = mask.shape
+    if h == w:
+        return np.rot90(mask, -k)
