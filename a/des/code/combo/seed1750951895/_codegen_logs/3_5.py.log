+
+def _far_from_stamp(cells: list[tuple[int, int]], stamp: np.ndarray, top: int, left: int) -> bool:
+    stamp_cells = {(top + r, left + c) for r, c in np.argwhere(stamp != BACKGROUND)}
+    for r, c in cells:
