+
+
+def _place_panel(panel_h: int, panel_w: int, sep: int, color: int, quadrants: list[str]):
+    stamp = _expand_template(np.rot90(random.choice(STAMP_TEMPLATES), random.randrange(4)), color)
+    sh, sw = stamp.shape
