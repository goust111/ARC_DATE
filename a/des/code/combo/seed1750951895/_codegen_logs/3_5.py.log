+
+
+def _panels_non_overlapping(markers: list[tuple[int, int]], stamp_h: int, stamp_w: int) -> bool:
+    boxes = []
+    for r, c in markers:
+        r0 = r - stamp_h // 2
+        c0 = c - stamp_w // 2
+        boxes.append((r0, c0, r0 + stamp_h - 1, c0 + stamp_w - 1))
