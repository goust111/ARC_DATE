+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] == BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
