        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        return_format="dict",
    ):
        h = bbox_h(comp["bbox"])
        w = bbox_w(comp["bbox"])
        if int(comp["area"]) > 1 and int(comp["area"]) == h * w:
            rectangles.append(comp)
    return rectangles


