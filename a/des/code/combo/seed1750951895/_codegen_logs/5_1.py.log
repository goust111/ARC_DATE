            expected[cr+oh, cc:cc+ow] = BG
        elif hs == 2:
            expected[cr:cr+oh, cc-1] = BG
        else:
            expected[cr:cr+oh, cc+ow] = BG

        # New position
        nr = cr + dr * steps
        nc = cc + dc * steps

        # Build moved container patch with converted cells
