+def _find_windows(g: np.ndarray, mask: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    hits = []
+    for r in range(g.shape[0] - 2):
+        for c in range(g.shape[1] - 2):
+            if _is_object_window(g, r, c, mask, bg):
