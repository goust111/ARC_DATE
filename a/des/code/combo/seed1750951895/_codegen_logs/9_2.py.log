+    _add_noise_segments(grid, bg, occupied, halo_taken, count=random.randint(0, 3))
+
+    expected = grid[chain[-1][0] : chain[-1][0] + 3, chain[-1][1] : chain[-1][1] + 3].copy()
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
