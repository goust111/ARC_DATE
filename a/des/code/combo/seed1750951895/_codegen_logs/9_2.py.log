+                "turn": [d for d in dirs if d not in (incoming, OPPOSITE[incoming])],
+            }
+            preferred = "straight" if idx % 2 == 0 else "turn"
+            dirs = rel_groups[preferred] + [d for d in dirs if d not in rel_groups[preferred]]
+
