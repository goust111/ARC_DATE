+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    frame_color, (fr0, fc0, fr1, fc1) = find_frame(g, bg)
+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1].copy()
+    interior = crop[1:-1, 1:-1]
+
+    placeholder_colors = {
