+        candidates = []
+        for pts in comps:
+            r0, c0, r1, c1 = bbox(pts)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if len(pts) <= 1:
+                continue
+            if h % 2 == 0 or w % 2 == 0:
+                continue
+            local = {(r - r0, c - c0) for r, c in pts}
+            center = (h // 2, w // 2)
+            if center not in local:
+                continue
+            candidates.append((len(pts), sorted(local), (h, w)))
+        assert len(candidates) == 1, f"sprite for color {color} must be unique"
