+def _random_symmetry(mask: np.ndarray) -> np.ndarray:
+    out = np.rot90(mask, random.randrange(4))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    return np.asarray(_crop_mask(out), dtype=bool)
