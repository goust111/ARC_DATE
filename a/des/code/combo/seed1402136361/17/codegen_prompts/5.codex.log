+    horiz_w = random.randint(6, 10)
+    vert_w = random.randint(2, 4)
+    horiz_h = random.randint(2, 4)
+
+    mask = np.zeros((vert_h, horiz_w), dtype=bool)
+    mask[:, :vert_w] = True
+    mask[vert_h - horiz_h :, :] = True
+    return _random_symmetry(mask)
