def _chain_coords(row: int, gap_start: int, gap_size: int, anchor: str) -> list[tuple[int, int]]:
    """Diagonal chain coordinates for a horizontal gap of size `gap_size`."""
    chain_len = int(gap_size - 1)
    if anchor == "left":
        return [(row + i, gap_start - 1 + i) for i in range(1, chain_len + 1)]
    return [(row + i, gap_start + gap_size - i) for i in range(1, chain_len + 1)]


def _v_chain_coords(col: int, gap_start: int, gap_size: int, anchor: str, dc: int) -> list[tuple[int, int]]:
    """Diagonal chain coordinates for a vertical gap of size `gap_size`."""
    chain_len = int(gap_size - 1)
    if anchor == "top":
        return [(gap_start + i, col + dc * (i + 1)) for i in range(chain_len)]
    return [(gap_start + gap_size - 1 - i, col + dc * (i + 1)) for i in range(chain_len)]


def _cells_are_color(grid: np.ndarray, coords: list[tuple[int, int]], color: int) -> bool:
    h, w = grid.shape
    for r, c in coords:
        if not (0 <= r < h and 0 <= c < w) or int(grid[r, c]) != int(color):
            return False
    return True


def _coords_all_true(mask: np.ndarray, coords: list[tuple[int, int]]) -> bool:
    h, w = mask.shape
    for r, c in coords:
        if not (0 <= r < h and 0 <= c < w) or not bool(mask[r, c]):
            return False
    return True


def _validate_chain(grid: np.ndarray, coords: list[tuple[int, int]], fg: int, occupied: set[tuple[int, int]]) -> bool:
    """Check that chain coords sit on bg, have no ortho fg neighbor, and have diagonal fg."""
    h, w = grid.shape
    coord_set = set(coords)
    if any(cell in occupied for cell in coords):
        return False
    for r, c in coords:
        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if (rr, cc) in coord_set:
                return False
            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == int(fg):
