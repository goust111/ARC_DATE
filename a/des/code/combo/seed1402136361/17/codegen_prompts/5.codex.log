+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            count += 1
+            seen[r, c] = True
+            queue: deque[tuple[int, int]] = deque([(int(r), int(c))])
+            while queue:
