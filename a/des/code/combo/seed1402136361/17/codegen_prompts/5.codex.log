+    mh, mw = mask.shape
+    if h < mh + 2 * BORDER_MARGIN or w < mw + 2 * BORDER_MARGIN:
+        return False
+
+    for _ in range(PLACEMENT_ATTEMPTS):
+        r0 = random.randint(BORDER_MARGIN, h - mh - BORDER_MARGIN)
+        c0 = random.randint(BORDER_MARGIN, w - mw - BORDER_MARGIN)
