+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+
+    if _component_count_by_color(grid, bg) != _component_count_by_color(out, bg):
+        return None
+
+    if not bool(np.any((grid != bg) & (out == bg))):
+        return None
+
+    return grid
