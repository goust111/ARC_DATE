            if (rr, cc) in coord_set or (0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == int(fg)):
                has_diag = True
                break
        if not has_diag:
            return False
    return True


def _reserve_neighborhood(cells: set[tuple[int, int]], coords) -> None:
    """Add Chebyshev-1 neighborhood of all coords to the set."""
    for r, c in coords:
