+    for lr, lc in zip(rows.tolist(), cols.tolist(), strict=False):
+        gr = r0 + int(lr)
+        gc = c0 + int(lc)
+        r1 = max(0, gr - OBJECT_CLEARANCE)
+        r2 = min(h, gr + OBJECT_CLEARANCE + 1)
+        c1 = max(0, gc - OBJECT_CLEARANCE)
+        c2 = min(w, gc + OBJECT_CLEARANCE + 1)
