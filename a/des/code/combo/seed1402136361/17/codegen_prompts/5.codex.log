+            keep = r == 0 or c == 0 or r == h - 1 or c == w - 1
+            if not keep:
+                for dr, dc in DIR4:
+                    nr = r + dr
+                    nc = c + dc
+                    if int(g[nr, nc]) == int(bg) and outside[nr, nc]:
