+    length = end - start + 1
+    if length < count * min_size + (count - 1) * gap:
+        return None
+
+    for _ in range(200):
+        widths = [random.randint(min_size, max_size) for _ in range(count)]
+        total = sum(widths) + (count - 1) * gap
+        if total > length:
+            continue
+
+        slack = length - total
+        spaces = [0] * (count + 1)
+        for _ in range(slack):
+            spaces[random.randrange(count + 1)] += 1
