+        extra_mask = _random_isolated_mask(rng)
+        placed = _place_mask(rng, grid.shape, extra_mask, occupied, bboxes, forbid_bbox_overlap=True)
+        if placed is None:
+            return None
+        coords, bbox = placed
+        _paint_coords(grid, coords, _EXTRA_COLOR)
+        occupied.update(coords)
+        bboxes.append(bbox)
+
