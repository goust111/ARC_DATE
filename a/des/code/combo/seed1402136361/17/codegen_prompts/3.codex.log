+    thickness = rng.choice(_THICKNESS_OPTIONS)
+    height = rng.randint(thickness + 2, thickness + 5)
+    width = rng.randint(thickness + 2, thickness + 5)
+    return _corner_mask(height, width, rng.choice(("TL", "TR", "BL", "BR")), thickness)
+
