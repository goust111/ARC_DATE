+def _touches_existing(coords: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    coord_set = set(coords)
+    if coord_set & occupied:
+        return True
+    for r, c in coords:
+        for nr, nc in _neighbors4(int(r), int(c)):
