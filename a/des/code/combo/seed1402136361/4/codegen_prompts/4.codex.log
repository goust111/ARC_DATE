+from __future__ import annotations
+
+import math
+import random
+from collections import defaultdict
+from functools import lru_cache
+
+import numpy as np
+
+
+CORNERS = ("TL", "TR", "BL", "BR")
+GEN_RETRIES = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def find_components(grid: np.ndarray, bg: int):
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def nearest_corner_from_bbox(bbox: tuple[int, int, int, int], h: int, w: int) -> str:
+    r0, c0, r1, c1 = bbox
+    center_r2 = int(r0 + r1)
+    center_c2 = int(c0 + c1)
+    bottom_r2 = int(2 * (h - 1))
+    right_c2 = int(2 * (w - 1))
+
+    dists = {
+        "TL": center_r2 * center_r2 + center_c2 * center_c2,
+        "TR": center_r2 * center_r2 + (center_c2 - right_c2) ** 2,
+        "BL": (center_r2 - bottom_r2) ** 2 + center_c2 * center_c2,
+        "BR": (center_r2 - bottom_r2) ** 2 + (center_c2 - right_c2) ** 2,
+    }
+    ordered = sorted(dists.items(), key=lambda item: item[1])
+    assert ordered[0][1] < ordered[1][1], "bbox center must have a unique nearest corner"
+    return ordered[0][0]
