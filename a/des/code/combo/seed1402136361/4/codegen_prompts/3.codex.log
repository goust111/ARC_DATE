+    top = int(center_r) - radius
+    bottom = int(center_r) + radius
+    left = int(center_c) - radius
+    right = int(center_c) + radius
+
+    cells: set[Coord] = set()
+    for c in range(left, right + 1):
+        cells.add((top, c))
+        cells.add((bottom, c))
