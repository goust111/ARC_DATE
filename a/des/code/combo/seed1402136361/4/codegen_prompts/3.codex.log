+def _mode_preserve_order(values: np.ndarray) -> int:
+    flat = [int(v) for v in np.asarray(values).ravel()]
+    counts: dict[int, int] = {}
+    order: list[int] = []
+    for value in flat:
+        if value not in counts:
+            counts[value] = 1
+            order.append(value)
+        else:
+            counts[value] += 1
+    best = max(counts.values())
