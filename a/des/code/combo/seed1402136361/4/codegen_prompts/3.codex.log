+def _pair_params(a: Coord, b: Coord) -> tuple[int, int, int]:
+    r0, c0 = a
+    r1, c1 = b
+    mid_r = (int(r0) + int(r1)) // 2
+    mid_c = (int(c0) + int(c1)) // 2
