+def _pair_cells_by_color(grid: np.ndarray, bg: int) -> dict[int, tuple[Coord, Coord]]:
+    pairs: dict[int, list[Coord]] = {}
+    for r, c in np.argwhere(grid != bg):
+        color = int(grid[r, c])
+        pairs.setdefault(color, []).append((int(r), int(c)))
