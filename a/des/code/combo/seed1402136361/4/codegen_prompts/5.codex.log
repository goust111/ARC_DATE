+
+
+def _analyze_grid(grid: np.ndarray) -> Tuple[int, int, List[Tuple[int, int]], List[Tuple[int, int]], Dict[Tuple[int, int], Dict[str, object]], Dict[Tuple[int, int], int], List[Tuple[Tuple[int, int], int, Tuple[int, int]]]]:
