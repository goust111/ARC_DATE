+    panel_h: int,
+    panel_w: int,
+    forbidden: Sequence[Tuple[Tuple[int, int], ...]],
+) -> np.ndarray:
+    max_h = min(5, panel_h - 2)
+    max_w = min(5, panel_w - 2)
+    assert max_h >= 1 and max_w >= 1
+    for _ in range(200):
+        shape = _rand_polyomino(rng, max_h=max_h, max_w=max_w)
+        sig = _shape_signature(shape)
