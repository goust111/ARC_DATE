+def _mask_has_hole(mask: np.ndarray) -> bool:
+    inv = ~mask
+    for comp in _components4(inv):
+        if any(r == 0 or c == 0 or r == mask.shape[0] - 1 or c == mask.shape[1] - 1 for r, c in comp):
+            continue
+        return True
+    return False
