+    h, w = g.shape
+    bg = _mode_color(g)
+
+    candidates = []
+    for sep in [int(c) for c in np.unique(g) if int(c) != bg]:
+        sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]
+        sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]
+        if not sep_rows and not sep_cols:
+            continue
