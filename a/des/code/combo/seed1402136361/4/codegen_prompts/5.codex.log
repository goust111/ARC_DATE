+                match((pr, pc), (pr, pc + 1))
+                match((pr, pc + 1), (pr, pc))
+            if pr + 1 < row_count:
+                match((pr, pc), (pr + 1, pc))
+                match((pr + 1, pc), (pr, pc))
+
