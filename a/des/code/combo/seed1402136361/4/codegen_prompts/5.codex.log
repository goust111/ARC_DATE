+            r0, c0 = recv["offset"]
+            for hr, hc in hole["coords"]:
+                key = (int(r0 + hr), int(c0 + hc))
+                color = int(donor["color"])
+                existing = actions.get(key)
+                assert existing in (None, color), "conflicting donors matched the same hole pixel"
+                actions[key] = color
