+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray:
+    layout = rng.choice([(1, 2), (2, 1), (2, 2)])
+    rows, cols = layout
+    panel_h = rng.randint(7, 10)
+    panel_w = rng.randint(7, 10)
