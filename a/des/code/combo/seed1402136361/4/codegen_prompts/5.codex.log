+                    frontier.add((nr, nc))
+
+        add_frontier(start)
+        while len(cells) < target and frontier:
+            pick = rng.choice(tuple(frontier))
+            frontier.remove(pick)
+            cells.add(pick)
+            add_frontier(pick)
+        if len(cells) != target:
+            continue
+
+        mask = np.zeros((box_h, box_w), dtype=bool)
