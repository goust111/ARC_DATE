+    out = inp.copy()
+    mid = inp.shape[1] // 2
+    left_out = out[:, :mid]
+    right_out = out[:, mid + 1 :]
+    left_out[overlap] = RIGHT_COLOR
+    right_out[overlap] = LEFT_COLOR
+    return out
+
