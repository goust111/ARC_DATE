+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    height, width = g.shape
+    assert width >= 3 and width % 2 == 1, "grid must contain two equal-width panels and one separator column"
+    mid = width // 2
