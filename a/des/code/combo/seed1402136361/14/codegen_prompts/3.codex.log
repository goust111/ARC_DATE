+def _unique_non_bg_color(panel: np.ndarray, bg: int) -> int:
+    colors = [int(color) for color in np.unique(panel) if int(color) != bg]
+    assert len(colors) == 1, "each panel must contain exactly one foreground color"
+    return colors[0]
