+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+RECOLOR_PATTERNS = (
+    ("W", "B", "B", "B"),
+    ("W", "W", "B", "B"),
+    ("W", "W", "W", "B"),
+    ("W", "W", "W", "W"),
+    ("W", "W", "O", "B"),
+    ("W", "W", "W", "O"),
+    ("W", "W", "O", "P"),
+)
+
+# Generator configuration.
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (14, 20)
+OBJECT_COUNT_RANGE = (2, 4)
