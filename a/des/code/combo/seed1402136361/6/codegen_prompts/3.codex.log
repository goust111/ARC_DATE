+    colors = [int(c) for c in np.unique(sprite) if int(c) != bg]
+    assert len(colors) == 2
+    a, b = colors
+    out = sprite.copy()
+    out[sprite == a] = b
+    out[sprite == b] = a
+    return out
+
+
+def _apply_rule(sprite: np.ndarray, bg: int, geometry: str, swap: bool) -> np.ndarray:
+    out = _apply_geometry(sprite, geometry)
+    if swap:
+        out = _swap_two_foreground_colors(out, bg)
+    return out
+
