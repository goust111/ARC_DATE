+    if geometry == "flip_ud":
+        return np.flipud(sprite).copy()
+    if geometry == "rot90":
+        return np.rot90(sprite, -1).copy()
+    if geometry == "rot180":
+        return np.rot90(sprite, 2).copy()
+    if geometry == "rot270":
+        return np.rot90(sprite, 1).copy()
+    if geometry == "transpose":
+        return sprite.T.copy()
+    if geometry == "anti_transpose":
+        return np.fliplr(np.flipud(sprite)).T.copy()
