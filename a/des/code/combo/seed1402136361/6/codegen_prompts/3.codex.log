+    for geometry, swap in RULES:
+        ok = True
+        for inp, out in train_pairs:
+            try:
+                pred = _apply_rule(inp, bg, geometry, swap)
+            except AssertionError:
+                ok = False
+                break
+            if pred.shape != out.shape or not np.array_equal(pred, out):
