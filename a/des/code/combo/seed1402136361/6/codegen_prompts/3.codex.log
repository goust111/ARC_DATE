+        random.shuffle(coords)
+        split = random.randint(1, len(coords) - 1)
+        color_b_cells = set(coords[:split])
+
+        sprite = np.full((h, w), bg, dtype=int)
+        for r, c in coords:
+            sprite[r, c] = color_b if (r, c) in color_b_cells else color_a
+        return sprite
