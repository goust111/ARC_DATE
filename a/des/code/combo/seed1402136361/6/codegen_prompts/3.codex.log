+    grid = _build_input_grid(train_inputs, train_outputs, test_input, bg, sep)
+    if _dominant_color(grid) != bg:
+        return None
+
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid, expected
