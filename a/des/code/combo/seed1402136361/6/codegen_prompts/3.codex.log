+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+        else:
+            runs.append((start, prev))
+            start = prev = idx
+    runs.append((start, prev))
+    return runs
+
+
+def _find_separator_span(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    candidates: list[int] = []
+    h, w = grid.shape
+    for c in range(w):
+        col = grid[:, c]
+        color = int(col[0])
+        if color == bg or not np.all(col == color):
