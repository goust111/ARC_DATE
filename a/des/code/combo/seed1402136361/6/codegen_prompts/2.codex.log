                    "dist": int(dist),
                    "box_h": int(box_h),
                    "box_w": int(box_w),
                    "shape": shape,
                    "area": int(area),
                    "origins": origins,
                }
            )
            used_areas.add(int(area))
            break
        else:
            return None

    same_dist_exists = len({int(spec["dist"]) for spec in specs}) < len(specs)
