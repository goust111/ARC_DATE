+    expected: np.ndarray,
+    input_occupied: np.ndarray,
+    output_occupied: np.ndarray,
+    patch: np.ndarray,
+    marker_color: int,
+    bg: int,
+) -> bool:
+    h, w = patch.shape
+    marker_r, marker_c = tuple(np.argwhere(patch == marker_color)[0])
+    for top, left in _candidate_positions(inp.shape[0], inp.shape[1], h, w):
