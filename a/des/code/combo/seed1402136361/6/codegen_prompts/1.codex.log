+def _stamp(out: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    assert 0 <= top and 0 <= left
+    assert top + h <= out.shape[0] and left + w <= out.shape[1]
+    region = out[top : top + h, left : left + w]
