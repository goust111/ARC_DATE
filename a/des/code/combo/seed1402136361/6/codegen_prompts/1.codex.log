+
+def _direction_from_marker(marker_r: int, marker_c: int, bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    cr = (r0 + r1) / 2.0
+    cc = (c0 + c1) / 2.0
+    dr = marker_r - cr
+    dc = marker_c - cc
+    assert abs(dr) != abs(dc), "marker direction must be unambiguous"
+    if abs(dr) > abs(dc):
+        return "down" if dr > 0 else "up"
+    return "right" if dc > 0 else "left"
