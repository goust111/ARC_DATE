+                continue
+            rel = pts - np.array([[r0, c0]])
+            comp_mask = np.zeros((h, w), dtype=bool)
+            comp_mask[rel[:, 0], rel[:, 1]] = True
+            if not np.array_equal(comp_mask, _border_coords(h, w)):
+                continue
+            inner = g[r0 + 1 : r1, c0 + 1 : c1]
+            if not np.any(inner == bg):
