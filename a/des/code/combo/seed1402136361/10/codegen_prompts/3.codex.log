 141: def _gen_template(h: int, w: int) -> list[tuple[int, int]] | None:
 142:     """4-connected template shape in h x w, spanning bbox, within area/fill bounds."""
 143:     total = h * w
 144:     lo = max(TEMPLATE_AREA_RANGE[0], int(np.ceil(total * TEMPLATE_FILL_RANGE[0])))
 145:     hi = min(TEMPLATE_AREA_RANGE[1], int(np.floor(total * TEMPLATE_FILL_RANGE[1])))
 146:     if lo > hi:
 147:         return None
 148:     for _ in range(TEMPLATE_RETRIES):
 149:         area = random.randint(lo, hi)
 150:         cells = _spanning_polyomino(area, h, w)
 151:         if cells is not None:
 152:             return cells
 153:     return None
 154: 
 155: 
 156: def _gen_lattice(n: int) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:
 157:     """Lattice polyomino of *n* cells with strictly interior origin."""
 158:     ext_r = random.randint(*LATTICE_EXTENT_RANGE)
 159:     ext_c = random.randint(*LATTICE_EXTENT_RANGE)
 160:     cells = _spanning_polyomino(n, ext_r, ext_c)
 161:     if cells is None:
 162:         return None
 163:     interior = [(r, c) for r, c in cells if 0 < r < ext_r - 1 and 0 < c < ext_c - 1]
 164:     if not interior:
 165:         return None
 166:     return cells, random.choice(interior)
