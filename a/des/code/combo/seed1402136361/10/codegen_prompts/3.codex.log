+        grid[row, 0] = int(color)
+        grid[row, 1 : 1 + weight] = int(bar)
+
+    if np.count_nonzero(grid == bg) <= np.count_nonzero(grid == wall):
+        return None
+    solved = main(grid)
+    if solved.shape != expected.shape or not np.array_equal(solved, expected):
+        return None
+    return grid
