 106: def _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
 107:     """Grow a random 4-connected polyomino of *n* cells in a rows x cols grid."""
 108:     start = (random.randint(0, rows - 1), random.randint(0, cols - 1))
 109:     cells = {start}
 110:     frontier = []
 111:     for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
 112:         nr, nc = start[0] + dr, start[1] + dc
 113:         if 0 <= nr < rows and 0 <= nc < cols:
 114:             frontier.append((nr, nc))
 115:     while len(cells) < n and frontier:
 116:         cell = random.choice(frontier)
 117:         frontier.remove(cell)
 118:         if cell in cells:
 119:             continue
 120:         cells.add(cell)
 121:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
 122:             nr, nc = cell[0] + dr, cell[1] + dc
 123:             if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:
 124:                 frontier.append((nr, nc))
 125:     return list(cells) if len(cells) == n else None
 126: 
 127: 
 128: def _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
 129:     """Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges)."""
 130:     for _ in range(SPANNING_RETRIES):
 131:         cells = _random_polyomino(n, rows, cols)
 132:         if cells is None:
 133:             continue
 134:         rs = [r for r, c in cells]
 135:         cs = [c for r, c in cells]
 136:         if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:
 137:             return cells
 138:     return None
 139: 
