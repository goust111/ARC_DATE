+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
+LEGEND_MAX_WEIGHT = 5
+LEGEND_WIDTH = 1 + LEGEND_MAX_WEIGHT
+SEPARATOR_WIDTH = 1
+ROOM_GAP = 1
+INNER_H_RANGE = (4, 8)
+INNER_W_RANGE = (5, 10)
