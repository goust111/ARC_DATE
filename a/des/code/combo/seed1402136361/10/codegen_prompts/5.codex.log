135:         return None
136:     if len(present_sides) == 2 and set(present_sides) in ({"top", "bottom"}, {"left", "right"}):
137:         return None
138: 
139:     expected = _mask_from_present_sides(h, w, present_sides)
140:     if not np.array_equal(mask, expected):
