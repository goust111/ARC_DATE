158: def _directional_distance(open_bbox: tuple[int, int, int, int], closed_bbox: tuple[int, int, int, int], side: str) -> int | None:
159:     or0, oc0, or1, oc1 = open_bbox
160:     cr0, cc0, cr1, cc1 = closed_bbox
161:     if side == "top":
162:         if not _intervals_overlap(oc0, oc1, cc0, cc1) or cr1 >= or0:
163:             return None
164:         return or0 - cr1 - 1
165:     if side == "bottom":
166:         if not _intervals_overlap(oc0, oc1, cc0, cc1) or cr0 <= or1:
167:             return None
168:         return cr0 - or1 - 1
169:     if side == "left":
170:         if not _intervals_overlap(or0, or1, cr0, cr1) or cc1 >= oc0:
171:             return None
172:         return oc0 - cc1 - 1
173:     if side == "right":
174:         if not _intervals_overlap(or0, or1, cr0, cr1) or cc0 <= oc1:
175:             return None
176:         return cc0 - oc1 - 1
177:     raise ValueError(f"unknown side: {side}")
178: 
179: 
180: def _provider_for_open(open_obj: dict[str, object], closed_objs: list[dict[str, object]]) -> dict[str, object]:
181:     options: list[tuple[int, str, dict[str, object]]] = []
182:     open_bbox = tuple(map(int, open_obj["bbox"]))
183:     for side in open_obj["missing_sides"]:
184:         side_hits: list[tuple[int, dict[str, object]]] = []
185:         for closed in closed_objs:
186:             dist = _directional_distance(open_bbox, tuple(map(int, closed["bbox"])), side)
187:             if dist is not None:
188:                 side_hits.append((dist, closed))
189:         if not side_hits:
190:             continue
191:         best_dist = min(dist for dist, _closed in side_hits)
192:         best_hits = [(dist, closed) for dist, closed in side_hits if dist == best_dist]
193:         assert len(best_hits) == 1, "nearest aligned closed shape should be unique in its direction"
194:         options.append((best_dist, side, best_hits[0][1]))
195: 
196:     assert options, "every open shape must point toward at least one closed shape"
197:     best_dist = min(dist for dist, _side, _closed in options)
198:     best = [item for item in options if item[0] == best_dist]
199:     assert len(best) == 1, "open shape gap direction must be unambiguous"
200:     return best[0][2]
