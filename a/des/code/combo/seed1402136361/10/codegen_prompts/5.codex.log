+def _side_mask(h: int, w: int, side: str) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    if side == "top":
+        mask[0, :] = True
+    elif side == "bottom":
+        mask[-1, :] = True
+    elif side == "left":
+        mask[:, 0] = True
+    else:
