+
+    base_h = sum(int(spec["cluster_h"]) for spec in specs) + sum(row_gaps)
+    base_w = sum(int(spec["cluster_w"]) for spec in specs) + sum(col_gaps)
+    if base_h > GRID_MAX or base_w > GRID_MAX:
