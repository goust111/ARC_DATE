242: def _choose_missing_sides(direction: str) -> tuple[str, ...]:
243:     if random.random() < 0.5:
244:         return (direction,)
245:     extra = random.choice(ADJACENT_MISSING[direction])
246:     return tuple(side for side in SIDES if side not in {side for side in SIDES if side not in {direction, extra}})
247: 
248: 
249: def _open_shape_mask(h: int, w: int, missing_sides: tuple[str, ...]) -> np.ndarray:
250:     present_sides = tuple(side for side in SIDES if side not in missing_sides)
251:     return _mask_from_present_sides(h, w, present_sides)
252: 
253: 
254: def _sample_pair(open_color: int, provider_color: int) -> dict[str, object]:
255:     direction = random.choice(SIDES)
256:     missing_sides = _choose_missing_sides(direction)
257:     open_h = random.randint(*OPEN_SIDE_RANGE)
258:     open_w = random.randint(*OPEN_SIDE_RANGE)
259:     open_mask = _open_shape_mask(open_h, open_w, missing_sides)
260: 
261:     provider_kind = random.choice(("solid", "frame"))
262:     provider_axial = random.randint(*PROVIDER_AXIAL_RANGE)
263:     gap = random.randint(*GAP_RANGE)
264: 
265:     if direction in ("top", "bottom"):
266:         provider_h = provider_axial
267:         provider_w = open_w
268:         cluster_h = provider_h + gap + open_h
269:         cluster_w = open_w
270:         if direction == "top":
271:             provider_origin = (0, 0)
272:             open_origin = (provider_h + gap, 0)
273:         else:
274:             open_origin = (0, 0)
275:             provider_origin = (open_h + gap, 0)
276:     else:
277:         provider_h = open_h
278:         provider_w = provider_axial
279:         cluster_h = open_h
280:         cluster_w = provider_w + gap + open_w
281:         if direction == "left":
282:             provider_origin = (0, 0)
283:             open_origin = (0, provider_w + gap)
284:         else:
285:             open_origin = (0, 0)
286:             provider_origin = (0, open_w + gap)
287: 
288:     if provider_kind == "solid":
289:         provider_mask = np.ones((provider_h, provider_w), dtype=bool)
290:     else:
291:         provider_mask = _frame_mask(provider_h, provider_w)
292: 
293:     return {
294:         "direction": direction,
295:         "missing_sides": missing_sides,
296:         "open_mask": open_mask,
297:         "open_color": open_color,
298:         "provider_mask": provider_mask,
299:         "provider_color": provider_color,
300:         "cluster_h": cluster_h,
301:         "cluster_w": cluster_w,
302:         "open_origin": open_origin,
303:         "provider_origin": provider_origin,
304:     }
305: 
306: 
307: def _layout_pairs(specs: list[dict[str, object]]) -> tuple[int, int, dict[int, tuple[int, int]]] | None:
308:     count = len(specs)
309:     row_gaps = [random.randint(*OUTER_PAD_RANGE) for _ in range(count + 1)]
310:     col_gaps = [random.randint(*OUTER_PAD_RANGE) for _ in range(count + 1)]
311: 
312:     base_h = sum(int(spec["cluster_h"]) for spec in specs) + sum(row_gaps)
313:     base_w = sum(int(spec["cluster_w"]) for spec in specs) + sum(col_gaps)
314:     if base_h > GRID_MAX or base_w > GRID_MAX:
315:         return None
316: 
317:     final_h = random.randint(max(GRID_MIN, base_h), GRID_MAX)
318:     final_w = random.randint(max(GRID_MIN, base_w), GRID_MAX)
319:     row_gaps[-1] += final_h - base_h
320:     col_gaps[-1] += final_w - base_w
321: 
322:     row_order = random.sample(range(count), count)
323:     col_order = random.sample(range(count), count)
324:     row_tops = [0] * count
325:     col_lefts = [0] * count
326: 
327:     cursor = row_gaps[0]
328:     for gap_idx, spec_idx in enumerate(row_order, start=1):
329:         row_tops[spec_idx] = cursor
330:         cursor += int(specs[spec_idx]["cluster_h"]) + row_gaps[gap_idx]
331: 
332:     cursor = col_gaps[0]
333:     for gap_idx, spec_idx in enumerate(col_order, start=1):
334:         col_lefts[spec_idx] = cursor
335:         cursor += int(specs[spec_idx]["cluster_w"]) + col_gaps[gap_idx]
336: 
337:     positions = {idx: (row_tops[idx], col_lefts[idx]) for idx in range(count)}
338:     return final_h, final_w, positions
339: 
340: 
341: def _paint_mask(grid: np.ndarray, origin: tuple[int, int], mask: np.ndarray, color: int, bg: int) -> None:
342:     r0, c0 = origin
343:     h, w = mask.shape
344:     patch = grid[r0 : r0 + h, c0 : c0 + w]
345:     assert np.all(patch[mask] == bg), "objects must not overlap"
346:     patch[mask] = color
347: 
348: 
349: def _build_example() -> tuple[np.ndarray, np.ndarray] | None:
350:     pair_count = random.choice(PAIR_COUNT_CHOICES)
351:     bg = random.randrange(10)
352:     colors = random.sample([c for c in range(10) if c != bg], 2 * pair_count)
353:     specs = [_sample_pair(colors[2 * i], colors[2 * i + 1]) for i in range(pair_count)]
354: 
355:     laid_out = _layout_pairs(specs)
356:     if laid_out is None:
357:         return None
358:     height, width, positions = laid_out
359: 
360:     inp = np.full((height, width), bg, dtype=int)
361:     expected = inp.copy()
362: 
363:     for idx, spec in enumerate(specs):
364:         cluster_r, cluster_c = positions[idx]
365:         open_r, open_c = spec["open_origin"]
366:         provider_r, provider_c = spec["provider_origin"]
367: 
368:         open_origin = (cluster_r + int(open_r), cluster_c + int(open_c))
369:         provider_origin = (cluster_r + int(provider_r), cluster_c + int(provider_c))
370: 
371:         _paint_mask(inp, provider_origin, np.asarray(spec["provider_mask"], dtype=bool), int(spec["provider_color"]), bg)
372:         _paint_mask(inp, open_origin, np.asarray(spec["open_mask"], dtype=bool), int(spec["open_color"]), bg)
373: 
374:         _paint_mask(expected, provider_origin, np.asarray(spec["provider_mask"], dtype=bool), int(spec["provider_color"]), bg)
375:         _paint_mask(expected, open_origin, np.asarray(spec["open_mask"], dtype=bool), int(spec["open_color"]), bg)
376: 
377:         open_mask = np.asarray(spec["open_mask"], dtype=bool)
378:         fill = np.zeros_like(open_mask)
379:         for side in spec["missing_sides"]:
380:             fill |= _side_mask(*open_mask.shape, side) & ~open_mask
381:         patch = expected[open_origin[0] : open_origin[0] + open_mask.shape[0], open_origin[1] : open_origin[1] + open_mask.shape[1]]
382:         assert np.all(patch[fill] == bg)
383:         patch[fill] = int(spec["provider_color"])
384: 
385:     if np.count_nonzero(inp != bg) * 2 >= inp.size:
386:         return None
387:     if not np.array_equal(main(inp), expected):
388:         return None
389:     return inp, expected
390: 
391: 
392: def generate_input() -> np.ndarray:
393:     for _ in range(GEN_RETRIES):
394:         built = _build_example()
395:         if built is not None:
396:             return built[0]
397:     raise RuntimeError("failed to generate a valid input")

