203: def _paint_closure(out: np.ndarray, grid: np.ndarray, bg: int, open_obj: dict[str, object], color: int) -> None:
204:     r0, c0, r1, c1 = map(int, open_obj["bbox"])
205:     mask = np.asarray(open_obj["mask"], dtype=bool)
206:     h, w = mask.shape
207:     patch_in = grid[r0 : r1 + 1, c0 : c1 + 1]
208:     patch_out = out[r0 : r1 + 1, c0 : c1 + 1]
209:     fill = np.zeros((h, w), dtype=bool)
210:     for side in open_obj["missing_sides"]:
211:         fill |= _side_mask(h, w, side) & ~mask
212:     assert np.all(patch_in[fill] == bg), "closure cells must be background in the input"
213:     patch_out[fill] = color
214: 
215: 
216: def main(grid: np.ndarray) -> np.ndarray:
217:     """
218:     Identify open rectangular-border objects, follow each gap toward the nearest aligned
219:     closed rectangle or frame, and close the missing side(s) using that provider's color.
220:     """
221:     g = np.asarray(grid, dtype=int)
222:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
223: 
224:     bg = _background_color(g)
225:     classified: list[dict[str, object]] = []
226:     for comp in _components_by_color(g, bg):
227:         info = _classify_component(comp)
228:         assert info is not None, "all foreground objects must be valid open or closed rectangles"
229:         classified.append(info)
230: 
231:     open_objs = [obj for obj in classified if obj["kind"] == "open"]
232:     closed_objs = [obj for obj in classified if obj["kind"] == "closed"]
233:     assert open_objs and closed_objs, "expected both open and closed objects"
234: 
235:     out = g.copy()
236:     for open_obj in open_objs:
237:         provider = _provider_for_open(open_obj, closed_objs)
238:         _paint_closure(out, g, bg, open_obj, int(provider["color"]))
239:     return out
