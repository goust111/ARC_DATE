+                    continue
+                if len(_interior_cells(trial)) < marker_count:
+                    continue
+                if trial.sum() <= marker_count + 2:
+                    continue
+                mask = trial
+                removed = True
+                break
+            if not removed:
+                break
+
+        interior = _interior_cells(mask)
+        if len(interior) < marker_count:
+            continue
+
