+        c_cur += pw + 1
+
+    return out
+
+
+# --------------- generator ---------------
+
+COLOR_POOL = tuple(range(10))
+OBJECT_COUNT_RANGE = (2, 5)
+GRID_HEIGHT_RANGE = (12, 24)
+GRID_WIDTH_RANGE = (12, 24)
+OBJECT_HEIGHT_RANGE = (3, 6)
+OBJECT_WIDTH_RANGE = (3, 7)
+MAX_NOTCHES = 4
+MAX_SHAPE_ATTEMPTS = 80
+MAX_PLACEMENT_ATTEMPTS = 80
