+
+
+def _sample_marker_counts(n_objects: int) -> list[int]:
+    if n_objects == 2:
+        counts = random.sample([1, 2, 3], 2)
+    elif random.random() < 0.5:
+        counts = [1, 2, 3] + [random.randint(1, 3) for _ in range(n_objects - 3)]
