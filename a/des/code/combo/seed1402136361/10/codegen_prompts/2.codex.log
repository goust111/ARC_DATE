+# Generator configuration.
+_GRID_H_RANGE = (14, 28)
+_GRID_W_RANGE = (14, 26)
+_OBJECT_COUNT_RANGE = (2, 5)
+_SHAPE_RETRIES = 100
+_GEN_RETRIES = 300
