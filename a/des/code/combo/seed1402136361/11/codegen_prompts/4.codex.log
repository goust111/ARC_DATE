+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[np.argmax(counts)])
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == int(bg):
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            comps.append({"color": color, "coords": coords})
+    return comps
+
+
+def _leaf_neighbors(coord_set: set[tuple[int, int]], r: int, c: int) -> list[tuple[int, int]]:
+    neighbors = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nb = (int(r + dr), int(c + dc))
+        if nb in coord_set:
+            neighbors.append(nb)
+    return neighbors
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Count edge leaf pixels on each side of every object and extend a centered bar outward by that count.
+    """
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    out = g.copy()
+
+    for comp in _components(g, bg):
+        color = int(comp["color"])
+        coords = [(int(r), int(c)) for r, c in comp["coords"]]
+        coord_set = set(coords)
+
+        core: list[tuple[int, int]] = []
+        leaves: list[tuple[int, int, tuple[int, int]]] = []
+        for r, c in coords:
+            neighbors = _leaf_neighbors(coord_set, r, c)
+            if len(neighbors) == 1:
+                leaves.append((int(r), int(c), neighbors[0]))
+            else:
+                core.append((int(r), int(c)))
+
+        if not core:
+            continue
+
+        rows = [r for r, _ in core]
+        cols = [c for _, c in core]
+        r0 = int(min(rows))
+        r1 = int(max(rows))
+        c0 = int(min(cols))
+        c1 = int(max(cols))
+        mid_r = (r0 + r1) // 2
+        mid_c = (c0 + c1) // 2
