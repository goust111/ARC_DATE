+def _bboxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    if ar1 + gap < br0 or br1 + gap < ar0:
+        return False
+    if ac1 + gap < bc0 or bc1 + gap < ac0:
+        return False
+    return True
+
