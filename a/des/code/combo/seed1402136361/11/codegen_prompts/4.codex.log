+
+def _paint_object(grid: np.ndarray, spec: dict, r0: int, c0: int) -> None:
+    color = int(spec["color"])
+    h = int(spec["h"])
+    w = int(spec["w"])
+    grid[r0 : r0 + h, c0 : c0 + w] = color
+
+    for offset in spec["sides"]["top"]:
+        grid[r0 - 1, c0 + int(offset)] = color
+    for offset in spec["sides"]["bottom"]:
