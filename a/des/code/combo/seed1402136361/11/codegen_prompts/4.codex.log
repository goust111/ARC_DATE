            widths[int(rng.choice(choices))] += 1
        else:
            choices = []
            for i, w in enumerate(widths):
                if w <= min_w:
                    continue
                if has_clamp.sum() == 1 and has_clamp[i] and w - 1 <= anchor + 1:
                    continue
                choices.append(i)
            if not choices:
