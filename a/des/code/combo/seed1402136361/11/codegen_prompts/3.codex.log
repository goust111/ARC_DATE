+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator configuration.
+_COLORS = tuple(range(10))
+_GRID_HEIGHT_RANGE = (10, 24)
+_GRID_WIDTH_RANGE = (10, 24)
