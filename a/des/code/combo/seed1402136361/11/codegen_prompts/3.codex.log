+        return None
+    return random.randint(2, min(per_row, max_objects))
+
+
+def _make_expected_output(
+    input_width: int,
+    bg: int,
+    color: int,
+    sprite_cells: set[tuple[int, int]],
+    sprite_shape: tuple[int, int],
+    count: int,
+) -> np.ndarray:
+    return _pack_identical_sprites(
+        count=int(count),
+        input_width=int(input_width),
