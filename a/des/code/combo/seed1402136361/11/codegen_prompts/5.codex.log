    out = np.full(case_map.shape, int(bg), dtype=int)
    out[case_map == 1] = int(top_color)
    out[case_map == 2] = int(bottom_color)
    return out


def _grid_is_valid(grid: np.ndarray, expected: np.ndarray) -> bool:
    try:
        solved = main(grid)
    except Exception:
