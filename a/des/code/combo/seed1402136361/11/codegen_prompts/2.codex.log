 232: DEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate
 233: GAP_VERT = (6, 7)             # endpoint gap for vertical radiate
 234: GAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate
 235: TIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)
 236: 
