 242: SEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end
 243: 
 244: # Obstacles
 245: MAX_OBSTACLES = 5             # maximum obstacle pixel count
 246: OBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone
 247: OBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)
 248: 
 249: # Validation
 250: MIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output
