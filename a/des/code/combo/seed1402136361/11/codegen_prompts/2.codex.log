 373: def _place_anchor(rad, h, w, depth, gap):
 374:     """Choose anchor so the wall fits within margins."""
 375:     if rad == (-1, 0):
 376:         return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
 377:     if rad == (1, 0):
 378:         return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
 379:     if rad == (0, -1):
 380:         return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
 381:     return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
