 255: def _degree1_pixels(points):
 256:     """Return degree-1 pixels (exactly one 8-neighbor in the set)."""
 257:     pts = set(points)
 258:     return [(r, c) for r, c in pts
 259:             if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
 260: 
 261: 
 262: def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
 263:     """Build one zigzag arm from (0, start_v) toward (depth, target_v)."""
 264:     sign = 1 if target_v > start_v else -1
 265:     n_side_steps = abs(target_v - start_v)
 266:     chosen_rows = []
 267:     if n_side_steps:
 268:         if tip_12:
 269:             chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
 270:             extra_steps = 0
 271:         else:
 272:             chosen_rows = [1]
 273:             if n_side_steps > 1:
 274:                 chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
 275:             chosen_rows.sort()
 276: 
 277:     first_row = chosen_rows[0] if chosen_rows else 1
 278:     extra_rows = [r for r in chosen_rows if r != first_row]
 279:     random.shuffle(extra_rows)
 280:     orthogonal_rows = set(extra_rows[:extra_steps])
 281: 
 282:     pts = [(0, start_v)]
 283:     u, v = 0, start_v
 284:     for row in range(1, depth + 1):
 285:         u += 1
 286:         if row in orthogonal_rows:
 287:             pts.append((u, v))
 288:             v += sign
 289:         elif row in chosen_rows:
 290:             v += sign
 291:         pts.append((u, v))
 292:     return pts
 293: 
