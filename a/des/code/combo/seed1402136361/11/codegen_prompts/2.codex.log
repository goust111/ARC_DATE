 400: def _grow_seed_blob(seed, interior_set):
 401:     """Grow a small 4-connected blob from seed within interior cells."""
 402:     blob = {seed}
 403:     target_size = random.choice(SEED_SIZE_WEIGHTS)
 404:     frontier = [seed]
 405:     while len(blob) < target_size and frontier:
 406:         p = frontier.pop(random.randrange(len(frontier)))
 407:         u, v = p
 408:         for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
 409:             if q in interior_set and q not in blob:
 410:                 blob.add(q)
 411:                 frontier.append(q)
 412:                 if len(blob) >= target_size:
 413:                     break
 414:     return blob
