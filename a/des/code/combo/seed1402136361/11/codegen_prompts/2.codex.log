  60: def _sample_sprite(color: int) -> np.ndarray | None:
  61:     """Return one connected sprite that lands inside the configured pixel-count range."""
  62:     bw = random.randint(*SPRITE_WIDTH_RANGE)
  63:     bh = random.randint(*SPRITE_HEIGHT_RANGE)
  64:     max_px = bw * bh
  65:     min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)
  66:     max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)
  67:     if min_px > max_target_px:
  68:         return None
  69:     target_px = random.randint(min_px, max_target_px)
  70:     density = target_px / max_px
  71:     for _ in range(SPRITE_RETRIES):
  72:         try:
  73:             sprite = random_sprite(bh, bw, density=density, color_palette=[color],
  74:                                    connectivity=SPRITE_CONNECTIVITY, background=BG,
  75:                                    symmetry=SPRITE_SYMMETRY)
  76:         except Exception:
  77:             continue
  78:         px = int(np.sum(sprite != BG))
  79:         if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:
  80:             return sprite
  81:     return None
  82: 
  83: def _place_sprite(grid: np.ndarray, sprite: np.ndarray) -> bool:
  84:     """Paste sprite with the required Chebyshev gap; return False if no slot exists."""
  85:     try:
  86:         r, c = random_free_location(grid, sprite, transparent=BG,
  87:                                     padding=PLACEMENT_PADDING,
  88:                                     padding_connectivity=PLACEMENT_CONNECTIVITY)
  89:     except ValueError:
  90:         return False
  91:     paste(grid, sprite, r, c, transparent=BG)
  92:     return True
  93: 
  94: def _solver_accepts(grid: np.ndarray) -> bool:
  95:     """Return whether the solver accepts the sampled task instance."""
  96:     try:
  97:         out = main(grid)
  98:     except Exception:
  99:         return False
 100:     return out is not None
 101: 
 102: def _gen_attempt() -> np.ndarray | None:
 103:     H = random.randint(*GRID_SIZE_RANGE)
 104:     W = random.randint(*GRID_SIZE_RANGE)
 105:     grid = np.full((H, W), BG, dtype=int)
 106:     for color in random.sample(FOREGROUND_COLORS, OBJECT_COUNT):
 107:         sprite = _sample_sprite(color)
 108:         if sprite is None or not _place_sprite(grid, sprite):
 109:             return None
 110:     if np.sum(grid == BG) / grid.size < MIN_BACKGROUND_FRACTION:
 111:         return None
 112:     return grid if _solver_accepts(grid) else None
