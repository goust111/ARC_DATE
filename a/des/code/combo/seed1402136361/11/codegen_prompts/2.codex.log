+    grid = _place_objects(rng, h, w, shapes, fg, bg)
+    if grid is None:
+        return None
+    if float(np.mean(grid == bg)) < MIN_BACKGROUND_FRACTION:
+        return None
+    if np.any(grid == ORANGE):
