 417: def _obstacle_fits(pos, placed):
 418:     """Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles."""
 419:     r, c = pos
 420:     return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
 421: 
