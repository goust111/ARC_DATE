 295: def _build_local_wall(rad, h, w):
 296:     """Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None."""
 297:     if rad[0]:
 298:         max_depth = min(DEPTH_VERT[1], h - 6)
 299:         if max_depth < DEPTH_VERT[0]:
 300:             return None
 301:         depth = random.randint(DEPTH_VERT[0], max_depth)
 302:         gap = random.randint(*GAP_VERT)
 303:     else:
 304:         depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
 305:         gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
 306: 
 307:     if gap == 5:
 308:         left_bottom, right_bottom = 2, 3
 309:     elif gap == 6:
 310:         left_bottom, right_bottom = 2, 4
 311:     else:
 312:         left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
 313: 
 314:     bridge_extra = max(0, right_bottom - left_bottom - 1)
 315:     base_count = 2 * (depth + 1) + bridge_extra
 316:     max_extra_l = max(0, left_bottom - 1)
 317:     max_extra_r = max(0, gap - right_bottom - 1)
 318:     min_extra = max(0, WALL_PIXELS_MIN - base_count)
 319:     max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
 320:     if min_extra > max_extra:
 321:         return None
 322: 
 323:     extra = random.randint(min_extra, max_extra)
 324:     extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
 325:     extra_r = extra - extra_l
 326: 
 327:     max_n_side = max(left_bottom, gap - right_bottom)
 328:     tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
 329:     left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
 330:     right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
 331:     pts = set(left) | set(right)
 332:     for v in range(left_bottom, right_bottom + 1):
 333:         pts.add((depth, v))
 334: 
 335:     # Pad wall to minimum size by adding 8-connected pixels that preserve 2 endpoints
 336:     while len(pts) < WALL_PIXELS_MIN:
 337:         candidates = [
 338:             (u, v) for u in range(max(0, depth - 3), depth + 1)
 339:             for v in range(gap + 1) if (u, v) not in pts
 340:             and sum((uu, vv) in pts
 341:                     for uu in range(u - 1, u + 2)
 342:                     for vv in range(v - 1, v + 2)
 343:                     if (uu, vv) != (u, v)) >= 2
 344:         ]
 345:         random.shuffle(candidates)
 346:         added = False
 347:         for p in candidates:
 348:             trial = pts | {p}
 349:             if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
 350:                 pts = trial
 351:                 added = True
 352:                 break
 353:         if not added:
 354:             return None
 355: 
 356:     if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
 357:         return None
 358:     return pts, depth, gap
