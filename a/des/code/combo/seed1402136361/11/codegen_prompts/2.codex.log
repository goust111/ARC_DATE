 361: def _map_local(u, v, rad, anchor):
 362:     """Map local (u, v) to grid (r, c) given radiate direction and anchor."""
 363:     r0, c0 = anchor
 364:     if rad == (-1, 0):
 365:         return r0 + u, c0 + v
 366:     if rad == (1, 0):
 367:         return r0 - u, c0 + v
 368:     if rad == (0, -1):
 369:         return r0 + v, c0 + u
 370:     return r0 + v, c0 - u
