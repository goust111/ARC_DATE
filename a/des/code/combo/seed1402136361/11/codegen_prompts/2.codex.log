 423: def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):
 424:     """Find bg cells far enough from wall for obstacle placement, using distance transform."""
 425:     wall_mask = grid == wall_color
 426:     # distance_transform_cdt with chessboard metric gives Chebyshev distance to wall
 427:     dist = distance_transform_cdt(~wall_mask, metric='taxicab')
 428:     far_from_wall = dist > 1
 429:     eligible = (grid == bg) & far_from_wall
 430:     all_coords = list(zip(*np.where(eligible)))
 431:     fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
 432:     random.shuffle(all_coords)
 433:     random.shuffle(fill_coords)
 434:     return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
 435: 
 436: 
 437: def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
 438:     """Place up to n_obstacles on the grid, preferring some in the fill zone."""
 439:     placed = []
 440:     n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
 441:     if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
 442:         n_fill = max(1, n_fill)
 443:     for p in fill_candidates:
 444:         if len(placed) >= n_fill:
 445:             break
 446:         if _obstacle_fits(p, placed):
 447:             placed.append(p)
 448:     placed_set = set(placed)
 449:     for p in candidates:
 450:         if len(placed) >= n_obstacles:
 451:             break
 452:         if p not in placed_set and _obstacle_fits(p, placed):
 453:             placed.append(p)
 454:             placed_set.add(p)
 455:     for i, (r, c) in enumerate(placed):
 456:         grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
 457: 
 458: 
 459: def _touches_border(mask):
 460:     """Check if any True cell in mask lies on the grid border."""
 461:     return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
 462: 
 463: 
 464: def _gen_attempt():
 465:     """Single attempt to generate a valid input grid."""
 466:     rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
 467:     h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
 468:     w = random.randint(*GRID_W)
 469: 
 470:     built = _build_local_wall(rad, h, w)
 471:     if built is None:
 472:         return None
 473:     local_wall, depth, gap = built
 474:     anchor = _place_anchor(rad, h, w, depth, gap)
 475: 
 476:     # Choose palette
 477:     palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
 478:     bg, wall_color, fill_color = palette[:3]
 479:     obstacle_colors = palette[3:]
 480: 
 481:     # Render wall onto grid
 482:     grid = np.full((h, w), bg, dtype=int)
 483:     for u, v in local_wall:
 484:         r, c = _map_local(u, v, rad, anchor)
 485:         grid[r, c] = wall_color
 486: 
 487:     # Place fill seed near the closed end
 488:     interior = _local_interior(local_wall, depth, gap)
 489:     wall_set = set(local_wall)
 490:     adjacent = [
 491:         p for p in interior
 492:         if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
 493:     ]
 494:     seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
 495:     if not seed_pool:
 496:         return None
 497: 
 498:     blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
 499:     for u, v in blob:
 500:         r, c = _map_local(u, v, rad, anchor)
 501:         if grid[r, c] != bg:
 502:             return None
 503:         grid[r, c] = fill_color
 504: 
 505:     # Run solver to find nominal fill zone (used for obstacle placement)
 506:     try:
 507:         nominal_out = main(grid)
 508:     except Exception:
 509:         return None
 510:     nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
 511: 
 512:     # Place obstacles
 513:     n_obstacles = random.randint(0, MAX_OBSTACLES)
 514:     if n_obstacles and not obstacle_colors:
 515:         available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
 516:         obstacle_colors = random.sample(available, random.randint(1, 2))
 517:     if n_obstacles:
 518:         candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)
 519:         _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
 520: 
 521:     # Validate: solver must produce enough fill that reaches a border
 522:     try:
 523:         out = main(grid)
 524:     except Exception:
 525:         return None
 526:     new_fill = (out == fill_color) & (grid == bg)
 527:     if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
 528:         return None
 529:     return grid
