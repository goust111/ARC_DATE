 384: def _local_interior(wall, depth, gap):
 385:     """Return bg cells strictly between the two wall arms in local coords."""
 386:     by_row = {}
 387:     for u, v in wall:
 388:         by_row.setdefault(u, []).append(v)
 389:     interior = []
 390:     for u in range(1, depth):
 391:         if u not in by_row or len(by_row[u]) < 2:
 392:             continue
 393:         lo, hi = min(by_row[u]), max(by_row[u])
 394:         for v in range(lo + 1, hi):
 395:             if (u, v) not in wall:
 396:                 interior.append((u, v))
 397:     return interior
