+
+
+def _ray_cells(
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    direction: str,
+    gap_index: int,
+    length: int,
+) -> tuple[tuple[int, int], list[tuple[int, int]]]:
+    if direction == "up":
+        gap = (r0, c0 + gap_index)
+        cells = [(r0 - step, gap[1]) for step in range(length)]
+    elif direction == "down":
+        gap = (r1, c0 + gap_index)
+        cells = [(r1 + step, gap[1]) for step in range(length)]
+    elif direction == "left":
+        gap = (r0 + gap_index, c0)
+        cells = [(gap[0], c0 - step) for step in range(length)]
+    else:
+        gap = (r0 + gap_index, c1)
+        cells = [(gap[0], c1 + step) for step in range(length)]
+    return gap, cells
