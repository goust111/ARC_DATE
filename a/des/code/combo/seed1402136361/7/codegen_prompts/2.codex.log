+
+
+def _place_frame(
+    rng: random.Random,
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    bg: int,
+    frame_color: int,
+    direction: str,
+) -> bool:
+    h, w = grid.shape
+    for _ in range(PLACEMENT_ATTEMPTS):
