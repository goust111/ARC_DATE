+
+def _random_composition(rng: random.Random, total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.sample(range(1, total), parts - 1))
+    values = []
+    prev = 0
+    for cut in cuts + [total]:
+        values.append(cut - prev)
+        prev = cut
+    return values
