+        if any(not (0 <= rr < h and 0 <= cc < w) for rr, cc in ray_cells):
+            continue
+
+        footprint = _footprint_cells(box_h, box_w, r0, c0, ray_cells)
+        padded = _padded_cells(footprint, h, w, PADDING)
