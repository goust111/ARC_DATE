+
+QUADRANTS = ("ul", "ur", "br", "bl")
+ROT_K = {"ul": 0, "ur": 3, "br": 2, "bl": 1}
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_H_RANGE = (14, 23)
+GRID_W_RANGE = (14, 23)
+EXTRA_OBJECT_CHOICES = (0, 1, 2)
+AREA_CHOICES = (3, 4, 5, 6, 7)
+PALETTE = tuple(range(10))
