+        quadrant = _quadrant_from_bbox(r0, c0, r1, c1, h, w)
+        rotated = np.rot90(mask, k=int(ROT_K[quadrant]))
+        dest_r0, dest_c0 = _corner_top_left(quadrant, rotated, h, w)
+        objects.append(
+            {
+                "quadrant": quadrant,
+                "color": color,
+                "area": int(mask.sum()),
+                "r0": r0,
+                "c0": c0,
+                "rotated": rotated,
+                "dest": (int(dest_r0), int(dest_c0)),
