+    right = g[:, sep_col + 1 :]
+
+    assert left.shape == right.shape and left.size > 0, "panels must be equal and non-empty"
+    assert np.any(left != bg) and np.any(right != bg), "both panels must contain foreground"
+
+    out = right.copy()
+    out[0::2] = left[0::2]
+    out[1::2] = right[1::2]
+    return out
+
+
+# --------------- generator ---------------
