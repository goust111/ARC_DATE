+    grid_h = random.randint(min_h, max_h)
+
+    placements = _place_objects(grid_h, grid_w, object_top, object_sprites)
+    if placements is None:
+        return None
+
+    grid = np.full((grid_h, grid_w), int(bg), dtype=int)
