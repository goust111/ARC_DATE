+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                pts.append((r, c))
+                for rr, cc in _neighbors4(r, c, h, w):
+                    if mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((int(rr), int(cc)))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_component_mask(points: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(points)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        out[r - r0, c - c0] = True
+    return out
+
+
+def _shape_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    arr = np.asarray(mask, dtype=np.uint8)
+    return int(arr.shape[0]), int(arr.shape[1]), arr.tobytes()
+
+
+def _background_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[counts.argmax()])
