+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                pts.append((r, c))
+                for rr, cc in _neighbors4(r, c, h, w):
+                    if mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((int(rr), int(cc)))
+            comps.append(pts)
+    return comps
