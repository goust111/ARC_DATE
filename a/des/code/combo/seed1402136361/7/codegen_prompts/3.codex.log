+RED = 2
+GREEN = 3
+GREY = 5
+BG_CHOICES = (0, 1, 4, 6, 7, 8, 9)
+
+OBJECT_SIZES = (2, 3, 4, 5, 6)
+OBJECT_COUNT_RANGE = (2, 5)
+GRID_SIDE_MIN = 12
+GRID_SIDE_MAX = 24
+PLACEMENT_PAD = 1
+GENERATION_RETRIES = 400
+
+FOUR_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))
