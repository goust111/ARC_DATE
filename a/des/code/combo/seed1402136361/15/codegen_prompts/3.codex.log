+        r0, c0, r1, c1 = comp["bbox"]
+        edge, _distances = _nearest_edge(comp["bbox"], height, width)
+
+        if edge == "top":
+            out[0, c0 : c1 + 1] = color
+        elif edge == "bottom":
+            out[height - 1, c0 : c1 + 1] = color
+        elif edge == "left":
+            out[r0 : r1 + 1, 0] = color
+        else:
+            out[r0 : r1 + 1, width - 1] = color
+
+    return out
+
+
+def _make_shape(height: int, width: int) -> np.ndarray:
+    mode = random.choice(("frame", "ell", "tee", "plus", "u", "h", "rect"))
+    mask = np.zeros((height, width), dtype=bool)
+
+    if mode == "frame":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+    elif mode == "ell":
+        mask[random.choice((0, height - 1)), :] = True
+        mask[:, random.choice((0, width - 1))] = True
+    elif mode == "tee":
+        mask[random.choice((0, height - 1)), :] = True
+        mask[:, width // 2] = True
+    elif mode == "plus":
+        mask[height // 2, :] = True
+        mask[:, width // 2] = True
+    elif mode == "u":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[random.choice((0, height - 1)), :] = True
+    elif mode == "h":
+        mask[:, 0] = True
+        mask[:, -1] = True
