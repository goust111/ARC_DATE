+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_TRIES):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {GENERATION_TRIES} attempts")

