+            base_left = arm_len if side == "left" else 0
+            mask[:, base_left : base_left + base_w] = True
+            arm_cols = slice(0, arm_len) if side == "left" else slice(base_w, base_w + arm_len)
+            mask[start : start + span, arm_cols] = True
