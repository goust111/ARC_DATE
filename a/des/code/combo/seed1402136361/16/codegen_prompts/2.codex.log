+            span = random.randint(1, h - 2)
+            start = random.randint(1, h - span - 1)
+            cols = slice(0, depth) if side == "left" else slice(w - depth, w)
+            mask[start : start + span, cols] = False
+
+        if {0, 1, 2}.issubset(_local_branch_categories(mask)):
