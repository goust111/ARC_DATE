                    if ok and not _nearby(nr, nc, DEFECT_CLEARANCE, defect_pixels):
                        defect.append((nr, nc))
                        if len(defect) >= defect_size:
                            break

            # Validate: every non-defect 4-neighbor of every defect pixel must be blue
            defect_set = set(defect)

