+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+
+_RNG = np.random.default_rng()
+_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+_QUADRANTS = ("tl", "tr", "br", "bl")
+_SIDE_CHOICES = (2, 3, 4, 5)
+_MAX_GENERATION_ATTEMPTS = 300
