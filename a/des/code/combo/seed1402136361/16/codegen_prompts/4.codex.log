+def _local_quadrant(r: int, c: int, h: int, w: int) -> str:
+    top = 2 * int(r) < int(h)
+    left = 2 * int(c) < int(w)
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and not left:
+        return "br"
+    return "bl"
+
+
+def _marker_info(grid: np.ndarray, coords: list[tuple[int, int]]) -> tuple[tuple[int, int], int]:
