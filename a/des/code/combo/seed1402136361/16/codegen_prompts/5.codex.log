+
+# Canonical translucent color system used by this task family:
+# blue + red -> magenta, blue + green -> cyan, red + green -> yellow.
+PRIMARY_COLORS = (1, 2, 3)
+PRIMARY_BITS = {1: 1, 2: 2, 3: 4}
+VISIBLE_FROM_BITS = {
+    1: 1,
+    2: 2,
+    4: 3,
+    3: 6,
+    5: 8,
+    6: 4,
+}
+RELATED_VISIBLE = {
+    1: (1, 6, 8),
+    2: (2, 6, 4),
+    3: (3, 8, 4),
+}
+BACKGROUND_OPTIONS = (0, 5, 7, 9)
+
