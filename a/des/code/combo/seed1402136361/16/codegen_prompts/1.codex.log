+    height, width = shape
+    groups: list[list[tuple[int, int]]] = []
+
+    for c in range(c0 + 1, c1):
+        top_options = []
+        for rr in (r0 - 1, r0 + 1):
+            cell = (int(rr), int(c))
+            if 0 <= rr < height and cell not in clean_pixels:
+                top_options.append(cell)
+        if top_options:
+            groups.append(top_options)
+
+        bottom_options = []
+        for rr in (r1 + 1, r1 - 1):
+            cell = (int(rr), int(c))
+            if 0 <= rr < height and cell not in clean_pixels:
+                bottom_options.append(cell)
+        if bottom_options:
+            groups.append(bottom_options)
+
+    for r in range(r0 + 1, r1):
+        left_options = []
+        for cc in (c0 - 1, c0 + 1):
+            cell = (int(r), int(cc))
+            if 0 <= cc < width and cell not in clean_pixels:
+                left_options.append(cell)
+        if left_options:
+            groups.append(left_options)
+
+        right_options = []
+        for cc in (c1 + 1, c1 - 1):
+            cell = (int(r), int(cc))
+            if 0 <= cc < width and cell not in clean_pixels:
+                right_options.append(cell)
+        if right_options:
+            groups.append(right_options)
+
+    return groups
+
+
+def _render_input(
+    shape: tuple[int, int],
+    bg: int,
+    frame_colors: list[int],
+    bboxes: list[tuple[int, int, int, int]],
+    markers: list[list[tuple[int, int]]],
+) -> np.ndarray:
