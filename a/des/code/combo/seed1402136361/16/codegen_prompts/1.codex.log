+
+                    frame_h = int(r1 - r0 + 1)
+                    frame_w = int(c1 - c0 + 1)
+                    border_area = int(2 * (frame_h + frame_w) - 4)
+                    marker_count = int(total_area - border_area)
+                    if marker_count <= 0:
