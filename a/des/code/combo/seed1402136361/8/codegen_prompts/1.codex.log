+    tile_h, tile_w = motif.shape
+    if outer_border:
+        height = block_rows * tile_h + (block_rows + 1) * sep_h
+        width = block_cols * tile_w + (block_cols + 1) * sep_w
+        row_base = sep_h
+        col_base = sep_w
+    else:
