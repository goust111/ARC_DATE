+def _content_bands(separator_mask: np.ndarray) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start: int | None = None
+    for idx, is_separator in enumerate(separator_mask.tolist()):
+        if is_separator:
+            if start is not None:
