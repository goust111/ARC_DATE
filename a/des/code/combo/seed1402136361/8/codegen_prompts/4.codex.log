+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
