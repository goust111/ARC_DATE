+
+def _window_mask(n_holes: int) -> np.ndarray:
+    assert n_holes >= 1
+    for _ in range(80):
+        orientation = random.choice(["vertical", "horizontal"])
+        if orientation == "vertical":
+            chamber_widths = [random.randint(1, 3) for _ in range(n_holes)]
