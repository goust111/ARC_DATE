+    specs: list[dict[str, object]] = []
+    for color, holes in zip(colors, hole_counts, strict=False):
+        mask = _solid_mask() if holes == 0 else _window_mask(holes)
+        specs.append({"color": color, "holes": holes, "mask": mask})
+    return specs
