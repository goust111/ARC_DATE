GRID_H_RANGE = (16, 19)           # canvas height bounds
GRID_W_RANGE = (16, 19)           # canvas width bounds
MIN_BLUE_REGION = 30              # minimum blue region size (cells)
MIN_BLACK_REGION = 20             # minimum black region size (cells)
