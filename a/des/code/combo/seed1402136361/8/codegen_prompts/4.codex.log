+    return _crop_mask(canvas)
+
+
+def _solid_mask() -> np.ndarray:
+    for _ in range(80):
+        h = random.randint(4, 8)
+        w = random.randint(4, 8)
+        mask = np.zeros((h, w), dtype=bool)
+
+        seed_h = random.randint(2, min(3, h))
+        seed_w = random.randint(2, min(3, w))
