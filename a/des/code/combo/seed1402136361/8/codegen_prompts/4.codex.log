from __future__ import annotations

from collections import deque
import random

import numpy as np


MAROON = 9
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def _most_common_color(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    parts: list[list[tuple[int, int]]] = []

    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            seen[r, c] = True
            queue = deque([(r, c)])
            coords: list[tuple[int, int]] = []
            while queue:
                rr, cc = queue.popleft()
                coords.append((int(rr), int(cc)))
                for dr, dc in DIR4:
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        queue.append((nr, nc))
            parts.append(coords)
    return parts


def _foreground_components(
    grid: np.ndarray, bg: int
) -> tuple[list[dict[str, object]], np.ndarray]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comp_index = np.full((h, w), -1, dtype=int)
    objects: list[dict[str, object]] = []

    for r in range(h):
        for c in range(w):
            color = int(grid[r, c])
            if color == bg or seen[r, c]:
                continue
            seen[r, c] = True
            queue = deque([(r, c)])
            coords: list[tuple[int, int]] = []
            while queue:
                rr, cc = queue.popleft()
                coords.append((int(rr), int(cc)))
                comp_index[rr, cc] = len(objects)
                for dr, dc in DIR4:
                    nr = rr + dr
                    nc = cc + dc
                    if (
                        0 <= nr < h
                        and 0 <= nc < w
                        and not seen[nr, nc]
                        and int(grid[nr, nc]) == color
                    ):
                        seen[nr, nc] = True
                        queue.append((nr, nc))
            objects.append({"color": color, "coords": coords})
    return objects, comp_index


def _analyze_objects(
    grid: np.ndarray, bg: int
) -> tuple[list[dict[str, object]], list[int], np.ndarray]:
    h, w = grid.shape
    objects, comp_index = _foreground_components(grid, bg)
    hole_counts = [0 for _ in objects]
    outside_bg = np.zeros((h, w), dtype=bool)
    seen_bg = np.zeros((h, w), dtype=bool)

    for r in range(h):
        for c in range(w):
            if int(grid[r, c]) != bg or seen_bg[r, c]:
                continue
            seen_bg[r, c] = True
            queue = deque([(r, c)])
            region: list[tuple[int, int]] = []
            touches_border = False
            adjacent_objects: set[int] = set()

            while queue:
                rr, cc = queue.popleft()
                region.append((int(rr), int(cc)))
                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
                    touches_border = True
                for dr, dc in DIR4:
                    nr = rr + dr
                    nc = cc + dc
                    if not (0 <= nr < h and 0 <= nc < w):
                        continue
                    if int(grid[nr, nc]) == bg:
                        if not seen_bg[nr, nc]:
                            seen_bg[nr, nc] = True
                            queue.append((nr, nc))
                    else:
                        comp_id = int(comp_index[nr, nc])
                        if comp_id >= 0:
                            adjacent_objects.add(comp_id)

            if touches_border:
                for rr, cc in region:
                    outside_bg[rr, cc] = True
            elif len(adjacent_objects) == 1:
                hole_counts[next(iter(adjacent_objects))] += 1

