+                cell = (int(nr), int(nc))
+                if (
+                    0 <= nr < h
+                    and 0 <= nc < w
+                    and outside_bg[nr, nc]
+                    and int(grid[nr, nc]) == bg
+                    and cell not in visited
+                ):
+                    visited.add(cell)
+                    next_frontier.add(cell)
+        current = next_frontier
+
+    return result
+
+
