            if area * 10 < MIN_FILL_RATIO_X10 * h * w:
                continue
            if h == 1 and area != w:
                continue
            if w == 1 and area != h:
                continue
            if h > 1 and w > 1 and area < max(h, w):
                continue
            dims.append((h, w))
    return dims


