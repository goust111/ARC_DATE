+def _dimension_candidates(fingerprint: int, max_h: int, max_w: int, small_limit: int) -> list[tuple[int, int]]:
+    candidates = []
+    for small in range(2, small_limit + 1):
+        long_side = small if fingerprint == 1 else small * fingerprint
