+_COLORS = tuple(range(10))
+_GRID_H_RANGE = (8, 15)
+_MAIN_W_RANGE = (10, 21)
+_PALETTE_LEN_RANGE = (3, 5)
+_OBJECT_COUNT_RANGE = (2, 4)
+_OBJECT_H_RANGE = (2, 5)
+_OBJECT_W_RANGE = (3, 7)
