+def _place_objects(
+    main_h: int,
+    main_w: int,
+    objects: list[dict[str, np.ndarray]],
+) -> list[tuple[int, int]] | None:
+    placements: list[tuple[int, int] | None] = [None] * len(objects)
+    placed_boxes: list[tuple[int, int, int, int]] = []
+    order = sorted(
+        range(len(objects)),
+        key=lambda idx: int(objects[idx]["mask"].sum()),
