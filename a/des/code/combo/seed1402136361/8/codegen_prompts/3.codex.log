+
+def _boxes_too_close(
+    box_a: tuple[int, int, int, int],
+    box_b: tuple[int, int, int, int],
+    margin: int,
+) -> bool:
+    ar0, ac0, ar1, ac1 = box_a
+    br0, bc0, br1, bc1 = box_b
+    return not (
+        ar1 + margin < br0
+        or br1 + margin < ar0
+        or ac1 + margin < bc0
+        or bc1 + margin < ac0
+    )
