+        bounds = _stripe_bounds(out[r], bg)
+        if bounds is None:
+            continue
+        if int(g[r, 0]) != bg and r % 2 == 0:
+            c0, c1 = bounds
+            out[r, c0 : c1 + 1] = out[r, c0 : c1 + 1][::-1]
+
+    return out
+
+
