+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(random.sample(range(1, int(total)), parts - 1))
+    prev = 0
+    out: list[int] = []
+    for cut in cuts + [int(total)]:
+        out.append(cut - prev)
+        prev = cut
+    return out
+
+
+def _sample_sequence(length: int, colors: list[int]) -> np.ndarray:
+    max_runs = min(MAX_RUNS, length)
+    for _ in range(80):
