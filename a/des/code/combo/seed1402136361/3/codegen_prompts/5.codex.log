+        if not isinstance(out, np.ndarray) or out.shape != grid.shape:
+            return None
+        if np.array_equal(out, grid):
+            return None
+    except Exception:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
