+            cells = {(int(r), int(c)) for r, c in comp}
+            rows = {r for r, _ in cells}
+            cols = {c for _, c in cells}
+            by_color[color].append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "rows": rows,
+                    "cols": cols,
+                }
