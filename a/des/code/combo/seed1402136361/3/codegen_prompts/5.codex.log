+# --------------- generator ---------------
+
+GRID_H_RANGE = (15, 24)
+GRID_W_RANGE = (15, 24)
+PAIR_COUNT_RANGE = (2, 5)
+ARROW_LENGTH_RANGE = (3, 5)
+GAP_RANGE = (1, 3)
+TARGET_AREA_RANGE = (2, 6)
+TARGET_MAX_SPAN = 4
+CLIP_PROB = 0.4
+PAIR_TRIES = 80
+SHAPE_TRIES = 80
+GENERATION_ATTEMPTS = 400
