+    assignment: list[dict[str, object] | None] = [None] * len(arrow_options)
+    used_targets: set[int] = set()
+    solutions: list[list[dict[str, object]]] = []
+
+    def dfs(idx: int) -> None:
+        if len(solutions) > 1:
+            return
