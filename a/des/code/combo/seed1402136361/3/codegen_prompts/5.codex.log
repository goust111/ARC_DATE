+    """
+    g = np.asarray(grid, dtype=int)
+    parsed = _parse_scene(g)
+    bg = int(parsed["bg"])
+    arrow_color = int(parsed["arrow_color"])
+    targets = list(parsed["targets"])
+    arrows = list(parsed["arrows"])
