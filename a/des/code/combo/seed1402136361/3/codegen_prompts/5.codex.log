+    shape_h = max(dr for dr, _ in shape) + 1
+    shape_w = max(dc for _, dc in shape) + 1
+
+    if direction in {"U", "D"}:
+        shaft_row = top + align
+        if side == "left":
+            c0 = left - gap - length
+        else:
