+
+def _stack_panel(panel: np.ndarray, bg: int) -> np.ndarray:
+    objects = _find_components(panel != bg)
+    assert objects, "selected panel must contain objects"
+    objects.sort(key=lambda obj: (-obj["area"], obj["bbox"][0], obj["bbox"][1]))
