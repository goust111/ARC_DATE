+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+COLORS = tuple(range(10))
+
+
+def get_bg(grid: np.ndarray) -> int:
