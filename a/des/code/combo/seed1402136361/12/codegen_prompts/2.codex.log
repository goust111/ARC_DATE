+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+
+            color = int(g[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
