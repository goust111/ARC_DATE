+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+
+            while queue:
+                cr, cc = queue.popleft()
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
