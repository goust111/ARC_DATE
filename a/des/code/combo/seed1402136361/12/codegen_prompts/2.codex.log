+def _paint_object(out: np.ndarray, obj: dict, top: int, left: int, bg: int) -> None:
+    h, w = out.shape
+    for rr, cc in obj["rel_coords"]:
+        r = int(top + rr)
+        c = int(left + cc)
+        assert 0 <= r < h and 0 <= c < w
+        assert int(out[r, c]) == bg, "rearranged objects must not overlap"
+        out[r, c] = int(obj["color"])
