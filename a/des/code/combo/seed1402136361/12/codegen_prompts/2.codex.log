+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.flatnonzero(mask.any(axis=1))
+    cols = np.flatnonzero(mask.any(axis=0))
+    assert rows.size and cols.size
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1].copy()
