+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            arr = np.asarray(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            r1 = int(arr[:, 0].max())
+            c0 = int(arr[:, 1].min())
+            c1 = int(arr[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            rel = arr - np.array([r0, c0], dtype=int)
+            mask[rel[:, 0], rel[:, 1]] = True
