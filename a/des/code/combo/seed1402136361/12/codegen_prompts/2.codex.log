+def _trim_corners(mask: np.ndarray, base_r0: int, base_c0: int, base_h: int, base_w: int) -> None:
+    corners = [
+        (base_r0, base_c0),
+        (base_r0, base_c0 + base_w - 1),
+        (base_r0 + base_h - 1, base_c0),
+        (base_r0 + base_h - 1, base_c0 + base_w - 1),
