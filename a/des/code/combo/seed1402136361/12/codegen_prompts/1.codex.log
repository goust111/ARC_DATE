+    grid[r1, c0 : c1 + 1] = wall_color
+    grid[r0 : r1 + 1, c0] = wall_color
+    grid[r0 : r1 + 1, c1] = wall_color
+
+
+def _place_markers(
+    rng: random.Random,
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    wall_color: int,
+    marker_palette: list[int],
