def _has_hole(mask: np.ndarray) -> bool:
    bg = ~mask.astype(bool)
    if not bool(bg.any()):
        return False

    H, W = bg.shape
    seen = np.zeros_like(bg, dtype=bool)
    stack: list[tuple[int, int]] = []
    for r in range(H):
        for c in (0, W - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))
    for c in range(W):
