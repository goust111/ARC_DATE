+        for r, c in np.argwhere(mask):
+            rr = int(r)
+            cc = int(c)
+            for dr, dc in NEIGHBORS4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < box_h and 0 <= nc < box_w and not mask[nr, nc]:
+                    frontier.add((nr, nc))
