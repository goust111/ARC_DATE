+    input_occ = np.zeros((H, W), dtype=bool)
+    output_occ = np.zeros((H, W), dtype=bool)
+    placed: list[dict[str, object]] = []
+
+    order = sorted(
+        specs,
+        key=lambda spec: max(int(np.asarray(spec["mask"]).sum()), int(np.asarray(spec["rotated_mask"]).sum())),
+        reverse=True,
+    )
+
