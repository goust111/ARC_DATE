+def _rotation_visible(mask: np.ndarray, turns: int) -> bool:
+    turns %= 4
+    if turns == 0:
+        return True
+    rotated = np.rot90(mask, -turns)
+    return mask.shape != rotated.shape or not np.array_equal(mask, rotated)
