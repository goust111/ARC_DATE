+    r_max = min(H - h, H - rh - dr0)
+    c_min = max(0, -dc0)
+    c_max = min(W - w, W - rw - dc0)
+    assert r_min <= r_max and c_min <= c_max
+    return range(r_min, r_max + 1), range(c_min, c_max + 1)
