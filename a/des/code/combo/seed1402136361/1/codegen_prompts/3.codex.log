+
+
+def _candidate_ranges(
+    canvas_shape: tuple[int, int],
+    mask_shape: tuple[int, int],
+    turns: int,
+) -> tuple[range, range]:
+    H, W = canvas_shape
+    h, w = mask_shape
+    rotated = np.rot90(np.zeros((h, w), dtype=bool), -turns)
+    rh, rw = rotated.shape
+    dr0, dc0 = _rotation_offset(h, w, turns)
+
+    r_min = max(0, -dr0)
+    r_max = min(H - h, H - rh - dr0)
+    c_min = max(0, -dc0)
+    c_max = min(W - w, W - rw - dc0)
