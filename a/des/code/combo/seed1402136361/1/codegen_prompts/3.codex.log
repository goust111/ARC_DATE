                    frontier.add((nr, nc))
        if not frontier:
            break
        mask[random.choice(tuple(frontier))] = True

    return _crop_mask(mask)


def _random_object_mask(turns: int) -> np.ndarray:
    for _ in range(GEN_SHAPE_ATTEMPTS):
