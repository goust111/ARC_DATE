+            rot_abs = np.zeros((H, W), dtype=bool)
+            orig_abs[r0 : r0 + h, c0 : c0 + w] = mask
+            rr0 = r0 + dr0
+            cc0 = c0 + dc0
+            rot_abs[rr0 : rr0 + rh, cc0 : cc0 + rw] = rotated_mask
