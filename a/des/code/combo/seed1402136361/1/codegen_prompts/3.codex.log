+def _components(canvas: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = canvas.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(canvas[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
