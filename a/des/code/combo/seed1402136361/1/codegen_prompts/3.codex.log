+
+
+def _object_specs(target_to_turns: dict[int, int]) -> list[dict[str, object]]:
+    specs: list[dict[str, object]] = []
+    for color, turns in target_to_turns.items():
+        count = 2 if random.random() < GEN_DUPLICATE_COLOR_PROB else 1
