+    chosen = random.sample(usable, 2 * GEN_TARGET_PAIR_COUNT)
+    target_colors = chosen[:GEN_TARGET_PAIR_COUNT]
+    code_colors = chosen[GEN_TARGET_PAIR_COUNT:]
+    random.shuffle(target_colors)
