+    mask[:, 0] = True
+    mask[:, -1] = True
+
+    if missing == "top":
+        mask[0, :] = False
+    elif missing == "bottom":
+        mask[-1, :] = False
+    elif missing == "left":
+        mask[:, 0] = False
+    elif missing == "right":
