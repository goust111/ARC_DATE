+def _classify_frame(coords: list[tuple[int, int]]) -> dict[str, int | str] | None:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
