+    c0 = int(frame["c0"])
+    r1 = int(frame["r1"])
+    c1 = int(frame["c1"])
+    missing = str(frame["missing"])
+
+    if missing == "top" and c0 <= col <= c1 and row < r0:
+        return r0 - row
+    if missing == "bottom" and c0 <= col <= c1 and row > r1:
+        return row - r1
+    if missing == "left" and r0 <= row <= r1 and col < c0:
+        return c0 - col
+    if missing == "right" and r0 <= row <= r1 and col > c1:
+        return col - c1
