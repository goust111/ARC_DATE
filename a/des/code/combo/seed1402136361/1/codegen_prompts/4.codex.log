+        elif missing == "bottom":
+            full_r0, full_c0, full_r1, full_c1 = r0, c0, r1 + 1, c1
+        elif missing == "left":
+            full_r0, full_c0, full_r1, full_c1 = r0, c0 - 1, r1, c1
+        elif missing == "right":
