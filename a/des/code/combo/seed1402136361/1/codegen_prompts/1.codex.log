 172: def main(grid: np.ndarray) -> np.ndarray:
 173:     """Predict the next panel in a framed sequence by continuing each scheduled colored interval.
 174: 
 175:     Input structure
 176:     - The grid is made from three or more equal panels in one row or one column.
 177:     - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.
 178:     - Each dynamic color appears in a regular temporal schedule across the earlier panels.
 179: 
 180:     Rule
 181:     - Keep the final template panel as the output canvas.
 182:     - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.
 183:     - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.
 184: 
 185:     Key insight
 186:     - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.
 187:     """
 188:     g = np.asarray(grid, dtype=int)
 189:     panels, diff_colors = _split_panels(g)
 190:     template = panels[-1]
 191:     prior = panels[:-1]
 192:     next_time = len(prior)
 193: 
 194:     predictions: list[tuple[int, np.ndarray]] = []
 195:     for color in diff_colors:
 196:         times = [i for i, panel in enumerate(prior) if np.any(panel == color)]
 197:         assert len(times) >= 2
 198:         gaps = [b - a for a, b in zip(times, times[1:])]
 199:         assert len(set(gaps)) == 1
 200:         period = gaps[0]
 201:         if next_time - times[-1] != period:
 202:             continue
 203: 
 204:         previous = prior[times[-2]] == color
 205:         current = prior[times[-1]] == color
 206:         predictions.append((color, _extrapolate_mask(previous, current)))
 207: 
 208:     assert predictions
 209:     occupied = np.zeros_like(template, dtype=bool)
 210:     for _color, mask in predictions:
 211:         assert not np.any(occupied & mask)
 212:         occupied |= mask
 213: 
 214:     out = template.copy()
 215:     for color, mask in predictions:
 216:         out[mask] = color
 217:     return out
 218: 
 219: # --------------- generator (o5x) ---------------
 220: 
 221: # Canvas, orientation, and color sampling.
 222: PANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11
 223: PANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)
 224: COLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)
 225: 
 226: # Template decoration density and symmetry.
 227: TEMPLATE_MIN_DECO_CELLS = 4
 228: TEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30
 229: 
 230: # Blob motif and growth bounds.
 231: BLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4
 232: BLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2
 233: BLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3
 234: BLOB_DIRECTIONS = (-1, 1)
 235: 
 236: # Dynamic-color schedules.
 237: SHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3
 238: SCHEDULE_ALWAYS_2 = {"period": 1, "times": [0, 1], "scheduled": True}
 239: SCHEDULE_ALWAYS_4 = {"period": 1, "times": [0, 1, 2, 3], "scheduled": True}
 240: SCHEDULE_EVEN_4 = {"period": 2, "times": [0, 2], "scheduled": True}
 241: SCHEDULE_FIRST3_4 = {"period": 1, "times": [0, 1, 2], "scheduled": False}
 242: SCHEDULE_ODD_4 = {"period": 2, "times": [1, 3], "scheduled": False}
 243: SCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)
 244: SCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)
