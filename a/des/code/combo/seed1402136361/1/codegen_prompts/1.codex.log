+            mask = spec["mask"]
+            hh, hw = mask.shape
+            top = 1 + rng.randint(0, inner_h - hh)
+            left = cursor
+            window = patch[top : top + hh, left : left + hw]
+            window[mask] = bg
+            placed_holes.append({"top": top, "left": left, "mask": mask, "sprite_color": spec["sprite_color"]})
+            cursor += hw + gap
+    else:
