+            continue
+
+        target_area = rng.randint(TEMPLATE_AREA_RANGE[0], max_area)
+        cells = {(rng.randrange(raw_h), rng.randrange(raw_w))}
+        while len(cells) < target_area:
+            frontier = []
+            seen = set()
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < raw_h and 0 <= nc < raw_w and (nr, nc) not in cells and (nr, nc) not in seen:
