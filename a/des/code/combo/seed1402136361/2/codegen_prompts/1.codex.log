+    legend_top = min(r for comp in comps for r, _ in comp)
+    entries = []
+    for comp in comps:
+        colors = {int(grid[r, c]) for r, c in comp}
+        assert len(colors) == 1, "each legend template must be monochrome"
+        key, height, width = _shape_key_from_coords(comp)
+        entries.append(
