+def _non_separator_spans(length: int, groups: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    cursor = 0
+    for start, end in groups:
+        if cursor < start:
+            spans.append((cursor, start - 1))
+        cursor = end + 1
+    if cursor < length:
+        spans.append((cursor, length - 1))
+    return spans
