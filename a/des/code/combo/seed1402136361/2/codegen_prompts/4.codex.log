+def _border_set(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    return set(_border_cells(bbox))
+
+
+def _corners(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
