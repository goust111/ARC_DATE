+    return frames
+
+
+def _occlusion_graph(
+    grid: np.ndarray,
+    frames: dict[int, dict[str, int | tuple[int, int, int, int]]],
+    bg: int,
+) -> dict[int, set[int]]:
+    graph = {color: set() for color in frames}
+    for color, info in frames.items():
+        bbox = info["bbox"]
+        assert isinstance(bbox, tuple)
+        for r, c in _border_cells(bbox):
