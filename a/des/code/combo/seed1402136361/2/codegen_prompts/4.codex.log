def _sample_dims(rng: random.Random, orientation: str, grid_h: int, grid_w: int) -> tuple[int, int] | None:
    max_h = min(FRAME_MAX_HEIGHT, grid_h - 2)
    max_w = min(FRAME_MAX_WIDTH, grid_w - 2)
    if max_h < FRAME_MIN_SIZE or max_w < FRAME_MIN_SIZE:
        return None

    for _ in range(50):
        if orientation == "wide":
            h = rng.randint(FRAME_MIN_SIZE, max_h)
            lo_w = max(FRAME_MIN_SIZE, h)
