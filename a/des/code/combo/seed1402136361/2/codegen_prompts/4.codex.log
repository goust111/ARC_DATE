+def _infer_frames(grid: np.ndarray, bg: int) -> dict[int, dict[str, int | tuple[int, int, int, int]]]:
+    frames: dict[int, dict[str, int | tuple[int, int, int, int]]] = {}
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
