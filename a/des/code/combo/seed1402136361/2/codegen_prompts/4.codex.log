+    for r, frame in enumerate(frames):
+        color = int(frame["color"])
+        height = int(frame["bbox"][2] - frame["bbox"][0] + 1)  # type: ignore[index]
+        width = int(frame["bbox"][3] - frame["bbox"][1] + 1)   # type: ignore[index]
+        if width >= height:
+            out[r, :] = color
+        else:
+            out[r, 1] = color
