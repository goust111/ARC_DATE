+        orientations[flip_idx] = "tall" if orientations[flip_idx] == "wide" else "wide"
+
+    first_bbox = _sample_initial_bbox(rng, grid_h, grid_w, orientations[0])
+    if first_bbox is None:
+        return None
+
+    frames: list[dict[str, int | tuple[int, int, int, int]]] = [
