+            options.append(("down_right", FRAME_MIN_SIZE, c1 - ac + 2, grid_h - ar, grid_w - ac))
+        elif side == "left":
+            options.append(("up_left", ar - r0 + 2, FRAME_MIN_SIZE, ar + 1, ac + 1))
+            options.append(("down_left", r1 - ar + 2, FRAME_MIN_SIZE, grid_h - ar, ac + 1))
+        else:
