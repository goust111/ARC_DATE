+            options.append(("down_left", r1 - ar + 2, FRAME_MIN_SIZE, grid_h - ar, ac + 1))
+        else:
+            options.append(("up_right", ar - r0 + 2, FRAME_MIN_SIZE, ar + 1, grid_w - ac))
+            options.append(("down_right", r1 - ar + 2, FRAME_MIN_SIZE, grid_h - ar, grid_w - ac))
