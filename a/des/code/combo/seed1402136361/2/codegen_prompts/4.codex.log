+    for _ in range(50):
+        if orientation == "wide":
+            h = rng.randint(FRAME_MIN_SIZE, max_h)
+            lo_w = max(FRAME_MIN_SIZE, h)
+            if lo_w > max_w:
+                continue
+            w = rng.randint(lo_w, max_w)
+            return h, w
+
+        w = rng.randint(FRAME_MIN_SIZE, max_w)
+        lo_h = max(FRAME_MIN_SIZE, w + 1)
+        if lo_h > max_h:
+            continue
+        h = rng.randint(lo_h, max_h)
+        return h, w
+
+    return None
+
+
+def _sample_initial_bbox(
+    rng: random.Random, grid_h: int, grid_w: int, orientation: str
+) -> tuple[int, int, int, int] | None:
+    dims = _sample_dims(rng, orientation, grid_h, grid_w)
+    if dims is None:
+        return None
+    h, w = dims
+
+    top_margin = 2 if grid_h - h >= 5 else 0
+    left_margin = 2 if grid_w - w >= 5 else 0
+    r0 = rng.randint(top_margin, grid_h - h - top_margin)
+    c0 = rng.randint(left_margin, grid_w - w - left_margin)
+    return (r0, c0, r0 + h - 1, c0 + w - 1)
+
+
+def _anchor_candidates(
+    bbox: tuple[int, int, int, int], protected: set[tuple[int, int]]
+) -> list[tuple[tuple[int, int], str]]:
+    r0, c0, r1, c1 = bbox
+    candidates: list[tuple[tuple[int, int], str]] = []
+    for c in range(c0 + 1, c1):
+        if (r0, c) not in protected:
+            candidates.append(((r0, c), "horizontal"))
+        if (r1, c) not in protected:
+            candidates.append(((r1, c), "horizontal"))
+    for r in range(r0 + 1, r1):
