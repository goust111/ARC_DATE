+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+FRAME_COUNT_RANGE = (3, 5)
+FRAME_MIN_SIZE = 3
+FRAME_MAX_HEIGHT = 10
+FRAME_MAX_WIDTH = 12
+FRAME_TRIES = 200
+SCENE_TRIES = 400
+
+
+def _sample_dims(
+    rng: random.Random,
+    orientation: str,
+    max_h: int,
+    max_w: int,
+    min_h: int = FRAME_MIN_SIZE,
+    min_w: int = FRAME_MIN_SIZE,
+) -> tuple[int, int] | None:
+    max_h = min(FRAME_MAX_HEIGHT, max_h)
+    max_w = min(FRAME_MAX_WIDTH, max_w)
+    if max_h < min_h or max_w < min_w:
+        return None
+
+    for _ in range(50):
+        if orientation == "wide":
+            h = rng.randint(min_h, max_h)
+            lo_w = max(min_w, h)
+            if lo_w > max_w:
+                continue
+            w = rng.randint(lo_w, max_w)
+            return h, w
