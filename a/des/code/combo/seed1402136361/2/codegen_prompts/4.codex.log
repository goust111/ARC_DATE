+        if width >= height:
+            out[r, :] = color
+        else:
+            out[r, 1] = color
+    return out
+
+
+def _render_scene(
+    grid_h: int, grid_w: int, bg: int, frames: list[dict[str, int | tuple[int, int, int, int]]]
+) -> np.ndarray:
