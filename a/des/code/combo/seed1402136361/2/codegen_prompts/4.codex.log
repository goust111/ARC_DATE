+        template, min_h, min_w, max_h, max_w = rng.choice(options)
+        dims = _sample_dims(
+            rng,
+            orientation,
+            max_h=max_h,
+            max_w=max_w,
+            min_h=min_h,
+            min_w=min_w,
+        )
