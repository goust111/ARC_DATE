+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Detect overlapping rectangular frames, recover their bottom-to-top order,
+    and summarize each frame as one row in a 3-column output.
+    """
+    return _solve(grid)
+
+
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+FRAME_COUNT_RANGE = (3, 5)
+FRAME_MIN_SIZE = 3
+FRAME_MAX_HEIGHT = 10
+FRAME_MAX_WIDTH = 12
+FRAME_TRIES = 200
+SCENE_TRIES = 400
+
+
+def _sample_dims(rng: random.Random, orientation: str, grid_h: int, grid_w: int) -> tuple[int, int] | None:
+    max_h = min(FRAME_MAX_HEIGHT, grid_h - 2)
+    max_w = min(FRAME_MAX_WIDTH, grid_w - 2)
+    if max_h < FRAME_MIN_SIZE or max_w < FRAME_MIN_SIZE:
+        return None
