+    ]
+    protected = set(_corners(first_bbox))
+    witnesses: list[tuple[int, int]] = []
+
+    for idx in range(1, frame_count):
+        built = _make_frame(
+            rng=rng,
+            grid_h=grid_h,
+            grid_w=grid_w,
+            orientation=orientations[idx],
+            prev_frame=frames[-1],
+            older_frames=frames[:-1],
+            protected=protected,
+        )
+        if built is None:
+            return None
+        frame_stub, anchor = built
+        frame_stub["color"] = int(frame_colors[idx])
+        frames.append(frame_stub)
+        protected.update(_corners(frame_stub["bbox"]))  # type: ignore[arg-type]
+        protected.add(anchor)
+        witnesses.append(anchor)
+
+    grid = _render_scene(grid_h, grid_w, bg, frames)
+    if not _scene_is_valid(grid, bg, frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(SCENE_TRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {SCENE_TRIES} attempts")

