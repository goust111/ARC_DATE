+    candidates: list[tuple[tuple[int, int], str]] = []
+    for c in range(c0 + 1, c1):
+        if (r0, c) not in protected:
+            candidates.append(((r0, c), "top"))
+        if (r1, c) not in protected:
+            candidates.append(((r1, c), "bottom"))
