+    out = np.full((len(order), 3), bg, dtype=int)
+    for r, color in enumerate(order):
+        width = int(frames[color]["width"])
+        height = int(frames[color]["height"])
+        if width >= height:
+            out[r, :] = color
+        else:
+            out[r, 1] = color
