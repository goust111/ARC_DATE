+        pts = np.argwhere(grid == color)
+        assert pts.size > 0, "each frame color must be visible"
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
