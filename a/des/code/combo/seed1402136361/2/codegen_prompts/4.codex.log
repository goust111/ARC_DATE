+            options.append(("down_left", FRAME_MIN_SIZE, ac - c0 + 2, grid_h - ar, ac + 1))
+            options.append(("down_right", FRAME_MIN_SIZE, c1 - ac + 2, grid_h - ar, grid_w - ac))
+        elif side == "left":
