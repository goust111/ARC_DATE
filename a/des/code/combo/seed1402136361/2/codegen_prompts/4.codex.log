+def _border_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells = [(r0, c) for c in range(c0, c1 + 1)]
+    if r1 != r0:
+        cells.extend((r1, c) for c in range(c0, c1 + 1))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
