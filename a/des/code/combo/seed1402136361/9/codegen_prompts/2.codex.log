+def _ordered_path(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    assert coords, "expected a non-empty foreground path"
+    coord_set = set(coords)
