+        expected = 1 if idx in (0, len(path) - 1) else 2
+        if len(nbrs) != expected:
+            return False
+        if idx > 0 and path[idx - 1] not in nbrs:
+            return False
+        if idx + 1 < len(path) and path[idx + 1] not in nbrs:
