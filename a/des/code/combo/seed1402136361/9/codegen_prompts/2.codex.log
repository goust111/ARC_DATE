+    end = segment[-1]
+    dr = end[0] - start[0]
+    dc = end[1] - start[1]
+    if abs(dr) > abs(dc):
+        return (1 if dr > 0 else -1, 0)
+    if abs(dc) > abs(dr):
+        return (0, 1 if dc > 0 else -1)
