+
+
+def _pick_segment_colors(bg: int, num_segments: int) -> list[int]:
+    palette_size = random.randint(FG_COLOR_COUNT_RANGE[0], min(FG_COLOR_COUNT_RANGE[1], 9))
+    palette = random.sample([c for c in range(10) if c != bg], palette_size)
