+    assert len(endpoints) == 2, "path must have exactly two endpoints"
+    start = min(endpoints)
+    ordered = [start]
+    prev = None
+    cur = start
+    while len(ordered) < len(coords):
+        nxts = [nb for nb in nbrs[cur] if nb != prev]
+        assert len(nxts) == 1, "path traversal must be unambiguous"
+        nxt = nxts[0]
+        ordered.append(nxt)
+        prev, cur = cur, nxt
