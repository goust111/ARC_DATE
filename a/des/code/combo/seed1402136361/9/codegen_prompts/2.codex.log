+
+    if require_both_axes and len(_segment_motion_axes(grid)) < 2:
+        return None
+
+    overlap = _overlap_count(transformed)
+    if want_overlap and overlap == 0:
+        return None
+    if (not want_overlap) and overlap != 0:
+        return None
