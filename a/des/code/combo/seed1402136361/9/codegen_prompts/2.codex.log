+    nbrs: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    endpoints = []
+    for pt in coords:
+        local = [nb for nb in _neighbors4(pt[0], pt[1], h, w) if nb in coord_set]
+        assert 1 <= len(local) <= 2, "foreground must be a simple path"
+        nbrs[pt] = local
+        if len(local) == 1:
+            endpoints.append(pt)
