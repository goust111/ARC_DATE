+            q.append((nr, nc))
+    return size
+
+
+def _fill_color(len_a: int, color_a: int, len_b: int, color_b: int) -> int:
+    if len_a > len_b:
+        return color_a
+    if len_b > len_a:
+        return color_b
+    if color_a == color_b:
+        return color_a
+    return color_a
+
+
+def _triangle_cells(r: int, c: int, direction: str, size: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
