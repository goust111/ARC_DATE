+        row_counts = Counter(int(color) for color in g[r] if int(color) != bg)
+        write_col = 0
+        for color in order:
+            count = row_counts.get(color, 0)
+            if count == 0:
+                continue
+            out[r, write_col : write_col + count] = color
+            write_col += count
+
+    return out
