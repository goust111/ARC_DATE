+
+    if _most_common_color(grid) != bg:
+        return None
+
+    objects = _extract_objects(grid[:-1], bg)
+    if len(objects) != object_count:
+        return None
+
+    expected = _build_expected(top_h, w, bg, placed_specs, active_colors)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+
+    return grid
