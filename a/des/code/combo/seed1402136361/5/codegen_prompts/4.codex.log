+
+def _random_connected_mask() -> np.ndarray:
+    for _ in range(SHAPE_RETRIES):
+        h = int(RNG.choice([1, 3, 5]))
+        w = int(RNG.choice([1, 3, 5]))
+        if h * w < 3:
+            continue
+
+        min_area = 3
+        area = int(RNG.integers(min_area, h * w + 1))
