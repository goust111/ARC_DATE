+def _bresenham(p0: tuple[int, int], p1: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = p0
+    r1, c1 = p1
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
