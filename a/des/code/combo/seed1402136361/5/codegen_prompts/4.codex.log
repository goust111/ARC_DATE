+GRID_MIN = 23
+GRID_MAX = 29
+ANCHOR_STEP = 6
+SHAPE_RETRIES = 200
+GENERATION_RETRIES = 400
+PAIR_COUNT_RANGE = (1, 3)  # sampled with integers(low, high)
+UNIQUE_COUNT_RANGE = (1, 3)
+ORIENTATIONS = ("horizontal", "vertical", "diag_down", "diag_up")
