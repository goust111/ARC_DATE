+        scores.append(("diagonal", (abs(dr) + abs(dc)) / np.sqrt(2.0)))
+    kind = max(scores, key=lambda item: item[1])[0]
+
+    if kind == "horizontal" and p0[0] == p1[0]:
+        row = p0[0]
+        c0, c1 = sorted((p0[1], p1[1]))
+        return [(row, c) for c in range(c0, c1 + 1)]
