+def _frame_sizes(inner_h: int, inner_w: int, expansions: list[int]) -> list[tuple[int, int]]:
+    sizes = [(int(inner_h), int(inner_w))]
+    h = int(inner_h)
+    w = int(inner_w)
+    for step in expansions:
+        h += 2 * int(step)
+        w += 2 * int(step)
