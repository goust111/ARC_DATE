ROOM_SIZE_RANGE = range(3, 6)
ROOM_GRID_RANGE = range(1, 8)
BLOCK_ROOM_MIN = 3
BLOCK_ROOM_MAX = 14
TOTAL_ROOM_MIN = 7
TOTAL_ROOM_MAX = 22
GAP_RANGE = range(3, 8)

