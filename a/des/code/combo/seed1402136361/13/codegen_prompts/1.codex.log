+    interior = mask.copy()
+    interior &= pad[:-2, 1:-1]
+    interior &= pad[2:, 1:-1]
+    interior &= pad[1:-1, :-2]
+    interior &= pad[1:-1, 2:]
+    return interior
+
+
+def _skeleton_mask(mask: np.ndarray) -> np.ndarray:
+    current = np.asarray(mask, dtype=bool).copy()
+    while True:
+        nxt = _erode_once(current)
+        if not bool(nxt.any()):
+            return current
+        if not _is_connected(nxt):
+            return current
+        current = nxt
