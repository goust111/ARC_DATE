+def _gen_attempt() -> np.ndarray | None:
+    bg = int(RNG.integers(0, 10))
+    object_count = int(RNG.integers(MIN_OBJECTS, MAX_OBJECTS + 1))
+    palette = [color for color in range(10) if color != bg]
