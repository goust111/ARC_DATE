+    objects: list[dict] = []
+    used_areas: set[int] = set()
+    for orientation, color in zip(_sample_orientations(object_count), colors):
+        obj = _make_object(orientation, color, used_areas)
+        if obj is None:
+            return None
+        used_areas.add(int(obj["area"]))
+        objects.append(obj)
