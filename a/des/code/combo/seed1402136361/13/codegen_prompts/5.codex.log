+        mask = np.asarray(comp["mask"], dtype=bool)
+        if mask.shape[1] > mask.shape[0]:
+            flipped = np.fliplr(mask)
+        else:
+            flipped = np.flipud(mask)
+        patch = out[r0 : r1 + 1, c0 : c1 + 1]
+        patch[flipped] = int(RANK_COLORS[rank])
