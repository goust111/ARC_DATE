+                {
+                    "r0": top + 1,
+                    "r1": bottom - 1,
+                    "c0": left + 1,
+                    "c1": right - 1,
+                    "top_sep": top,
+                    "bottom_sep": bottom,
+                    "left_sep": left,
+                    "right_sep": right,
