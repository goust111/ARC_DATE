+        elif marker["direction"] == "up":
+            out[reg["top_sep"], marker["start"] : marker["start"] + 2] = marker["stem_color"]
+        elif marker["direction"] == "right":
+            out[marker["start"] : marker["start"] + 2, reg["right_sep"]] = marker["stem_color"]
+        else:
