+
+def _build_grid(row_heights: list[int], col_widths: list[int], sep: int) -> tuple[np.ndarray, list[dict]]:
+    h = sum(row_heights) + len(row_heights) + 1
+    w = sum(col_widths) + len(col_widths) + 1
+    grid = np.full((h, w), BLACK, dtype=int)
