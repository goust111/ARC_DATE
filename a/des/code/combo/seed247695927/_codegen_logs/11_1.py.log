+
+
+_COLORS = tuple(range(10))
+_BAR_COUNT_RANGE = (3, 7)
+_GRID_HEIGHT_RANGE = (7, 18)
+_GRID_WIDTH_RANGE = (7, 20)
+_MAX_ATTEMPTS = 400
