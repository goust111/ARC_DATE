+                ac = c0 + pc
+                if max(abs(ar - fr), abs(ac - fc)) < FRAME_CLEARANCE:
+                    ok = False
+                    break
+            if ok:
+                starts.append((r0, c0))
+    random.shuffle(starts)
+    return starts
