+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != control:
+                continue
+            patch = grid[r - 1 : r + 2, c - 1 : c + 2]
+            if patch.shape != (3, 3):
+                continue
+            if int(patch[1, 1]) != control:
+                continue
+            border_ok = True
+            for rr in range(3):
+                for cc in range(3):
+                    if (rr, cc) == (1, 1):
+                        continue
+                    if int(patch[rr, cc]) != YELLOW:
+                        border_ok = False
+                        break
+                if not border_ok:
+                    break
+            if border_ok:
+                centers.append((r, c))
+    assert len(centers) == 1
+    return centers[0]
+
+
+def _gray_path_connects(grid: np.ndarray, start: Coord, end: Coord) -> bool:
+    h, w = grid.shape
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            nxt = (nr, nc)
+            if nxt in seen:
+                continue
+            if nxt == end or int(grid[nr, nc]) == GREY:
+                seen.add(nxt)
+                stack.append(nxt)
