+
+def _draw_ray(grid: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> None:
+    h, w = grid.shape
+    rr, cc = r, c
+    while 0 <= rr < h and 0 <= cc < w:
+        grid[rr, cc] = color
+        rr += dr
+        cc += dc
