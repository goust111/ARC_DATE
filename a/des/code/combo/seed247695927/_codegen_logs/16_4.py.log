    touched = 0

    if obj_mask[0, :].any():
        touched += 1
        side_values.extend(map(int, region[0, obj_mask[0, :]]))
    if obj_mask[-1, :].any():
        touched += 1
        side_values.extend(map(int, region[-1, obj_mask[-1, :]]))
    if obj_mask[:, 0].any():
        touched += 1
        side_values.extend(map(int, region[obj_mask[:, 0], 0]))
    if obj_mask[:, -1].any():
        touched += 1
        side_values.extend(map(int, region[obj_mask[:, -1], -1]))

