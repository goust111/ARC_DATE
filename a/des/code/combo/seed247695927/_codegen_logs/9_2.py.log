+        return None
+    color = int(grid[coords[0]])
+    if any(int(grid[r, c]) != color for r, c in coords):
+        return None
+
+    mask = np.zeros((3, 3), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+
+    for name, shape_mask in SHAPE_MASKS.items():
+        if np.array_equal(mask, shape_mask):
+            return {
+                "shape": name,
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "coords": coords,
