def _gen_same_color_touch(
    canvas: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int, color: int
) -> bool:
    h, w = canvas.shape
    for pr, pc in np.argwhere(patch_mask):
        r = int(r0 + pr)
        c = int(c0 + pc)
