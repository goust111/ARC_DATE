+GRID_MIN = 18
+GRID_MAX = 26
+WIRE_COUNT_RANGE = (1, 4)
+PATH_MIN_LEN = 6
+MAX_PATH_ATTEMPTS = 120
+MAX_GENERATION_ATTEMPTS = 300
