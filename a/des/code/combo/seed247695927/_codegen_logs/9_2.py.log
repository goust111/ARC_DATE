+def _classify_token(grid: np.ndarray, coords: list[tuple[int, int]]) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    if (r1 - r0 + 1, c1 - c0 + 1) != (3, 3):
+        return None
