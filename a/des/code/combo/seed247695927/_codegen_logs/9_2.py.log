+    nr, nc = neighbor
+    dr, dc = er - nr, ec - nc
+    center_r = er + 2 * dr
+    center_c = ec + 2 * dc
+    r0, c0 = center_r - 1, center_c - 1
+    r1, c1 = center_r + 1, center_c + 1
