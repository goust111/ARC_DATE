+PREV_SHAPE = {"solid": "diamond", "x": "solid", "diamond": "x"}
+SHAPE_MASKS = {"solid": SOLID_MASK, "x": X_MASK, "diamond": DIAMOND_MASK}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
