+                "dst_box": dst_box,
+                "token_shape": token_shape,
+                "token_color": token_color,
+            }
+        )
+
+    if not wires:
+        return None
+
+    expected = _manual_output(inp, wires, bg)
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
