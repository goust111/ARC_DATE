+        comps.append(comp)
+
+    layers = list(range(2, 2 + n))
+    rng.shuffle(layers)
+    occupied = np.zeros_like(grid, dtype=bool)
+
+    palette = [c for c in range(10) if c not in (bg, frame_color, fill_color)]
+    for comp, layer in zip(comps, layers):
+        t1, t2 = comp["touches"]
+        s1, s2 = comp["sides"]
