+        for c in range(c0, c1 + 1):
+            ok &= grid[r0, c] == color and grid[r1, c] == color
+        for r in range(r0, r1 + 1):
+            ok &= grid[r, c0] == color and grid[r, c1] == color
+        if not ok:
