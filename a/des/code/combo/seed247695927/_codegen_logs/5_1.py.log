+                    touches.add((nr, nc))
+        if len(touches) != 2:
+            return None
+
+    out = main(grid)
+    if out.shape != (inner_h, inner_w):
+        return None
+    if not np.any(out != fill_color):
+        return None
+    if len(np.unique(out)) < 3:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

