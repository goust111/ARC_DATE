+                return None
+        if comp["kind"] == "mono":
+            color = rng.choice(palette)
+            colors = [color]
+        else:
+            a, b = rng.sample(palette, 2)
+            colors = [a, b]
+        _color_path(grid, path, colors)
+        for r, c in path:
