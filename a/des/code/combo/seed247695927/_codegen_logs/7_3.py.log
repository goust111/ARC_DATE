+    if recolored.get(bg, 0) == 0:
+        return None
+    if len(_components(grid == GREY)) != len(sprite_holes):
+        return None
+    if len({(_component_hole_count(c), int(grid[c[0, 0], c[0, 1]])) for color in legend_colors for c in _components(grid == color)}) < legend_count:
+        return None
+    return grid
