+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = r == 0 or r == h - 1 or c == 0 or c == w - 1
+            while q:
+                cr, cc = q.popleft()
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if mask[nr, nc] or seen[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    if nr == 0 or nr == h - 1 or nc == 0 or nc == w - 1:
+                        touches_border = True
+                    q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return int(holes)
+
+
+def _component_hole_count(coords: np.ndarray) -> int:
+    r0, c0, r1, c1 = _bbox(coords)
+    sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        sub[r - r0, c - c0] = True
+    return _hole_count(sub)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+
+    legend = {}
+    for color in np.unique(g):
+        color = int(color)
+        if color in (bg, GREY):
+            continue
+        for coords in _components(g == color):
+            legend[_component_hole_count(coords)] = color
+
+    out = g.copy()
+    for coords in _components(g == GREY):
+        holes = _component_hole_count(coords)
+        new_color = legend.get(holes, bg)
+        for r, c in coords:
+            out[r, c] = int(new_color)
+    return out
+
+
+def _rand_blob(rng: random.Random, min_h: int = 3, max_h: int = 7, min_w: int = 3, max_w: int = 7) -> np.ndarray:
+    for _ in range(200):
+        h = rng.randint(min_h, max_h)
+        w = rng.randint(min_w, max_w)
+        target = rng.randint(max(4, (h * w) // 3), max(4, (2 * h * w) // 3))
+        pts = {(rng.randrange(h), rng.randrange(w))}
+        frontier = list(pts)
+        while len(pts) < target and frontier:
+            br, bc = rng.choice(frontier)
+            cand = []
+            for dr, dc in DIR4:
+                nr, nc = br + dr, bc + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in pts:
+                    cand.append((nr, nc))
+            if not cand:
+                frontier.remove((br, bc))
