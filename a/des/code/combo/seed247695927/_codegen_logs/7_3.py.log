+    gh, gw = grid_shape
+    h, w = mask.shape
+    if h >= gh or w >= gw:
+        return None
+    for _ in range(200):
+        if edge_mode == "top":
+            top = 0
+            left = rng.randint(0, gw - w)
+        elif edge_mode == "bottom":
+            top = gh - h
+            left = rng.randint(0, gw - w)
+        elif edge_mode == "left":
+            top = rng.randint(0, gh - h)
+            left = 0
+        elif edge_mode == "right":
+            top = rng.randint(0, gh - h)
+            left = gw - w
+        else:
+            top = rng.randint(2, gh - h - 3)
+            left = rng.randint(2, gw - w - 3)
+        bbox = (top, left, top + h - 1, left + w - 1)
+        grown = _dilate_bbox(bbox, 1, gh, gw)
