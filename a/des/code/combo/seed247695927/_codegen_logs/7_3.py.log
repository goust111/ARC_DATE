+            npix = rng.choice(cand)
+            pts.add(npix)
+            frontier.append(npix)
+        rs = [r for r, _ in pts]
+        cs = [c for _, c in pts]
+        mask = np.zeros((max(rs) - min(rs) + 1, max(cs) - min(cs) + 1), dtype=bool)
+        for r, c in pts:
+            mask[r - min(rs), c - min(cs)] = True
+        if _hole_count(mask) != 0:
+            continue
+        if mask.shape[0] < 2 or mask.shape[1] < 2:
