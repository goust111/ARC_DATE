                if other is not sprite and bool(other.body_mask[mr, mc])
            ]
            if overlaps:
                assert len(overlaps) == 1, "side marker overlap must identify one visible body color"
                replacement = overlaps[0]
        patch[mr, mc] = replacement

    for r, c in _corners(h, w):
