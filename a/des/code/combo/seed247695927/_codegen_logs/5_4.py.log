+    out = g.copy()
+    fill_colors = [bands[(i + 1) % len(bands)][2] for i in range(len(bands))]
+    for (left, right, _color), fill_color in zip(bands, fill_colors):
+        mask = out[:, left : right + 1] == bg
+        out[:, left : right + 1][mask] = fill_color
+
+    return out
