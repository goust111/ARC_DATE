+    col_lines = [c for c in range(box.shape[1]) if np.all(box_mask[:, c])]
+    assert len(row_lines) >= 3 and len(col_lines) >= 3, "grid must have outer border plus internal lines"
+
+    row_bands = []
+    for a, b in zip(row_lines, row_lines[1:]):
+        if b - a > 1:
