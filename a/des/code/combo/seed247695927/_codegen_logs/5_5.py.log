+    grid[grid == -1] = bg
+    if _background_color(grid) != bg:
+        return None
+    if np.count_nonzero(grid == ctrl) >= np.count_nonzero(grid == obj):
+        return None
+
+    solved = main(grid)
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
