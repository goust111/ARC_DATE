+        best_idx = None
+        best_dist = None
+        second = None
+        for idx, conn in enumerate(conn_sets):
+            dist = min(abs(r1 - r2) + abs(c1 - c2) for r1, c1 in pts for r2, c2 in conn)
+            if best_dist is None or dist < best_dist:
