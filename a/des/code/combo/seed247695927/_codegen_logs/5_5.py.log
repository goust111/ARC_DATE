+    bg, obj, ctrl = _infer_colors(g)
+    groups = _sprite_groups(g, obj, ctrl)
+    groups.sort(key=lambda group: (_bbox(group["all"])[0] + _bbox(group["all"])[1], _bbox(group["all"])[0], _bbox(group["all"])[1]))
+    base, plug = groups
