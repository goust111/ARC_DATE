+        return body
+    body = set(body)
+    body.add(candidates[rng.randrange(len(candidates))])
+    return body
+
+
+def _place_sprite(
+    grid: np.ndarray,
+    body: set[tuple[int, int]],
+    conn: set[tuple[int, int]],
+    top: int,
+    left: int,
+    obj: int,
+    ctrl: int,
