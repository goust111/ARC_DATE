+        target = rng.randint(conn_len + 3, min(plug_h * plug_w - conn_len, 18))
+        while int(mask.sum()) < target and frontier:
+            r, c = frontier[rng.randrange(len(frontier))]
+            moves = []
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                if not (1 <= nr < plug_h and 0 <= nc < plug_w):
+                    continue
+                if mask[nr, nc]:
+                    continue
+                ar = base_conn_r - 1 + nr
+                ac = abs_left + nc
+                if (ar, ac) in base_obj:
