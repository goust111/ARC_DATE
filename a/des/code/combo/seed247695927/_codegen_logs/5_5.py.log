+    pts = np.argwhere(out != bg)
+    rr0, cc0 = pts.min(axis=0)
+    rr1, cc1 = pts.max(axis=0)
+    return out[int(rr0) : int(rr1) + 1, int(cc0) : int(cc1) + 1]
