+    base_conn = base["conn"]
+    plug_conn = plug["conn"]
+    assert _normalize(base_conn) == _normalize(plug_conn), "connector shapes must match"
+
+    br0, bc0, _, _ = _bbox(base_conn)
+    pr0, pc0, _, _ = _bbox(plug_conn)
+    dr = br0 - 1 - pr0
+    dc = bc0 - pc0
