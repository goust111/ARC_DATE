+def _choose_grid_size(rng: np.random.Generator, n: int) -> int:
+    min_size = max(MIN_GRID_SIZE, n * GRID_SIZE_PER_FRAME + GRID_SIZE_PADDING)
+    return int(rng.integers(min_size, MAX_GRID_SIZE_EXCLUSIVE))
