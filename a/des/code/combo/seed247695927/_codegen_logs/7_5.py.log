+def _choose_ordering(rng: np.random.Generator) -> list[int]:
+    n = int(rng.integers(MIN_FRAME_COUNT, MAX_FRAME_COUNT_EXCLUSIVE))
+    colors = list(AVAILABLE_COLORS)
