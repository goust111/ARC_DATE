        used_areas.add(h * w)

    if n_frames == 2:
        dims = _choose_dims(
            h + FRAME_MIN_GROWTH,
            min(INNER_FRAME_MAX_HEIGHT, h + INNER_FRAME_MAX_GROWTH),
            w + FRAME_MIN_GROWTH,
