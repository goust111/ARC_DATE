+        if not (0 <= rr < SPRITE_SIZE and 0 <= cc < SPRITE_SIZE):
+            return None
+    if not req:
+        req.add((rng.randrange(SPRITE_SIZE), rng.randrange(SPRITE_SIZE)))
+    req_list = list(req)
+    rng.shuffle(req_list)
+    cells = {req_list[0]}
+    for target_r, target_c in req_list[1:]:
