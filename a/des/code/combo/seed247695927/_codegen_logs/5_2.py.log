+            marker_b = tuple(map(int, rng.choice(other_cells_b)))
+            sprites[a_idx] = {"mask": mask_a, "marker_pos": marker_a, "group": gid}
+            sprites[b_idx] = {"mask": mask_b, "marker_pos": marker_b, "group": gid}
+            used_marker_positions.add(marker_a)
