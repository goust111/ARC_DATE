+
+def _grow_connected_mask(
+    rng: random.Random,
+    required: set[tuple[int, int]],
+    min_area: int,
+    max_area: int,
+) -> np.ndarray | None:
+    cells = set(required)
+    for cell in list(cells):
+        rr, cc = cell
