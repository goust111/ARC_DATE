+        cells.add((rng.randrange(SPRITE_SIZE), rng.randrange(SPRITE_SIZE)))
+    target = rng.randint(max(len(cells), min_area), max_area)
+    all_cells = {(r, c) for r in range(SPRITE_SIZE) for c in range(SPRITE_SIZE)}
+
