+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors(cr, cc, mask.shape, conn8):
+                    if mask[nr, nc] and not seen[nr, nc]:
