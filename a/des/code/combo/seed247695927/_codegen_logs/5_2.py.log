+
+def _facing_corner(local: tuple[int, int], corner_name: str) -> bool:
+    r, c = local
+    if corner_name == "tl":
+        return r == 0 or c == 0
+    if corner_name == "tr":
+        return r == 0 or c == SPRITE_SIZE - 1
+    if corner_name == "bl":
+        return r == SPRITE_SIZE - 1 or c == 0
+    if corner_name == "br":
+        return r == SPRITE_SIZE - 1 or c == SPRITE_SIZE - 1
+    raise AssertionError("unknown corner")
