+def _neighbors(r: int, c: int, shape: tuple[int, int], conn8: bool) -> list[tuple[int, int]]:
+    out = []
+    dirs = DIR8 if conn8 else DIR4
+    h, w = shape
+    for dr, dc in dirs:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
