+def _make_closed_mask(h: int, w: int) -> np.ndarray | None:
+    for _ in range(80):
+        mask = np.ones((h, w), dtype=bool)
+        style = random.choice(["solid", "hole", "barbell"])
+        if style == "hole" and h >= 5 and w >= 5:
+            ih = random.randint(1, h - 4)
+            iw = random.randint(1, w - 4)
