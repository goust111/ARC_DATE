+    marker = random.choice(remaining)
+    content_colors = [c for c in remaining if c != marker]
+    random.shuffle(content_colors)
+
+    if axis == 1:
+        h = random.randint(5, 12)
+        half_w = random.randint(4, 10)
+        half_shape = (h, half_w)
