+_RETRY_LIMIT = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in _DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [r0 for r0, _ in coords]
+            cols = [c0 for _, c0 in coords]
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return components
+
+
+def _bbox_corner(bbox: tuple[int, int, int, int], height: int, width: int) -> Corner | None:
+    r0, c0, r1, c1 = bbox
+    if r0 == 0 and c0 == 0:
+        return "TL"
+    if r0 == 0 and c1 == width - 1:
+        return "TR"
+    if r1 == height - 1 and c1 == width - 1:
+        return "BR"
+    if r1 == height - 1 and c0 == 0:
+        return "BL"
+    return None
+
+
+def _corner_anchor(corner: Corner, height: int, width: int, obj_h: int, obj_w: int) -> tuple[int, int]:
+    if corner == "TL":
+        return 0, 0
+    if corner == "TR":
+        return 0, width - obj_w
+    if corner == "BR":
