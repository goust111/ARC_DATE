+        else:
+            top_ok = bool(mask[h - 1, :].any())
+        if corner in ("TL", "BL"):
+            side_ok = bool(mask[:, 0].any())
+        else:
+            side_ok = bool(mask[:, w - 1].any())
+        if top_ok and side_ok:
