+
+_RNG = random.Random()
+_NEXT_CORNER: dict[Corner, Corner] = {
+    "TL": "TR",
+    "TR": "BR",
+    "BR": "BL",
+    "BL": "TL",
+}
+_DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
