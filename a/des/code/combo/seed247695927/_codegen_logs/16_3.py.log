+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
+
+
+def _anchored_corner_mask(corner: Corner, max_h: int, max_w: int) -> np.ndarray:
+    while True:
+        mask = _random_connected_mask(max_h, max_w)
+        h, w = mask.shape
+        if corner in ("TL", "TR"):
