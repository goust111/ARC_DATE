+    right = w - 1 - random.randint(*BODY_MARGIN_RANGE)
+    if bottom - top < 9:
+        bottom = top + 9
+    if right - left < 9:
+        right = left + 9
+    grid[top : bottom + 1, left : right + 1] = BLUE
