+
+def _leaf_pixels(comp: list[tuple[int, int]], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    comp_set = set(comp)
+    leaves: list[tuple[int, int]] = []
+    for r, c in comp:
+        degree = 0
+        for dr, dc in NEIGHBORS8:
+            if (r + dr, c + dc) in comp_set:
+                degree += 1
+        if degree <= 1:
+            leaves.append((r, c))
+    return leaves
