+            cells = [(r + dr + rr, c + dc + cc) for rr in (0, 1) for cc in (0, 1)]
+            if all(_in_bounds(mask.shape, rr, cc) and mask[rr, cc] for rr, cc in cells):
+                return True
+    return False
