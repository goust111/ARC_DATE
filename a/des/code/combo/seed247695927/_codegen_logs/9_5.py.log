+def _absorb_blue_spikes(grid: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    while True:
+        blue = out == BLUE
+        remove: list[tuple[int, int]] = []
+        for r, c in np.argwhere(blue):
+            rr = int(r)
+            cc = int(c)
+            if _has_blue_2x2(blue, rr, cc):
+                continue
+            if _blue_count_8(blue, rr, cc) <= 2:
+                remove.append((rr, cc))
+        if not remove:
+            return out
+        for r, c in remove:
+            out[r, c] = BLACK
