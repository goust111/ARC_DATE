+        pts = [(base_r + dr, base_c + dc) for dr, dc in shape]
+        halo = [(r + dr, c + dc) for r, c in pts for dr, dc in NEIGHBORS8 + [(0, 0)]]
+        if any(not _in_bounds(grid.shape, r, c) or grid[r, c] != BLUE for r, c in pts):
