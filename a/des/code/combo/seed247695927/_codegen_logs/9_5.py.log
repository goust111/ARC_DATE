from __future__ import annotations

import math
import random
from collections import Counter, deque

import numpy as np


NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
GENERATION_ATTEMPTS = 400
GRID_SIDE_RANGE = (18, 30)
TEMPLATE_SIDE_RANGE = (3, 6)
