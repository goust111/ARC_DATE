+
+
+def _place_rectangles(
+    box: tuple[int, int, int, int],
+    occupied: np.ndarray,
+) -> list[tuple[str, int, int, int, int]] | None:
+    count = random.choice(RECT_COUNT_CHOICES)
+    edges = random.sample(EDGES, count)
+    rects: list[tuple[str, int, int, int, int]] = []
