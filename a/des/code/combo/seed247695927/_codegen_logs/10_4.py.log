+
+GRID_H_RANGE = (10, 18)
+GRID_W_RANGE = (12, 18)
+CONTENT_H_RANGE = (7, 14)
+CONTENT_W_RANGE = (8, 15)
+BORDER_RANGE = (0, 3)
+
+RECT_COUNT_CHOICES = (1, 2, 3, 4)
+RECT_H_RANGE = (2, 5)
+RECT_W_RANGE = (2, 6)
+RECT_AREA_RANGE = (4, 18)
+PLACE_RETRIES = 80
+
