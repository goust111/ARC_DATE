+            continue
+        if sig in out_map:
+            return None
+        out_map[sig] = idx
+
+    successor = [None] * len(blocks)
+    predecessor = [None] * len(blocks)
+    for i, sig in enumerate(outgoing):
+        if not sig:
+            continue
+        j = inc_map.get(sig)
+        if j is None:
+            continue
+        if i == j:
+            return None
+        if predecessor[j] is not None:
+            return None
+        successor[i] = j
+        predecessor[j] = i
+
+    starts = [i for i, p in enumerate(predecessor) if p is None]
+    ends = [i for i, s in enumerate(successor) if s is None]
+    if len(starts) != 1 or len(ends) != 1:
+        return None
+
+    path = []
+    seen = set()
+    cur = starts[0]
+    while cur is not None and cur not in seen:
+        path.append(cur)
+        seen.add(cur)
