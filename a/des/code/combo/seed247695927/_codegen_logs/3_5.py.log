+def _non_separator_segments(length: int, separator_indices: list[int]) -> list[list[int]]:
+    separators = set(separator_indices)
+    segments: list[list[int]] = []
+    current: list[int] = []
+    for idx in range(length):
+        if idx in separators:
+            if current:
+                segments.append(current)
+                current = []
+        else:
