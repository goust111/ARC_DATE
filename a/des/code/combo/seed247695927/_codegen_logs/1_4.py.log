+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
