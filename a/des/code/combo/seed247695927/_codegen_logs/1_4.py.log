+    for _ in range(cols - 1):
+        patch[:, cursor] = color
+        cursor += 1 + chamber_w
+
+    cursor = 1 + chamber_h
+    for _ in range(rows - 1):
+        patch[cursor, :] = color
+        cursor += 1 + chamber_h
+
+    if random.random() < 0.5:
+        patch = patch.T
+    return patch
