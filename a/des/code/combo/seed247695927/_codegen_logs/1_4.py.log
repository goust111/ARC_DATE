+    rows, cols = random.choice(HOLE_FACTORS[holes])
+    chamber_h = random.randint(*chamber_span_range)
+    chamber_w = random.randint(*chamber_span_range)
+    height = 2 + rows * chamber_h + (rows - 1)
+    width = 2 + cols * chamber_w + (cols - 1)
