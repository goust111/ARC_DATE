+            seen[r0, c0] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.asarray(cells, dtype=int)
+            rmin = int(coords[:, 0].min())
+            rmax = int(coords[:, 0].max())
+            cmin = int(coords[:, 1].min())
+            cmax = int(coords[:, 1].max())
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (rmin, cmin, rmax, cmax),
+                }
+            )
+    return components
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg = _background_color(g)
+    out = g.copy()
+    for component in _find_components(g, bg):
+        cmin = component["bbox"][1]
+        erase = component["coords"][component["coords"][:, 1] < cmin + 2]
+        out[erase[:, 0], erase[:, 1]] = bg
+    return out
+
+
+def _shape_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if len(cells) == 0:
+        return False
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    stack = [tuple(map(int, cells[0]))]
+    seen[stack[0]] = True
+    count = 0
+    while stack:
+        r, c = stack.pop()
+        count += 1
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return count == int(mask.sum())
+
+
+def _random_shape() -> np.ndarray | None:
+    for _ in range(SHAPE_RETRIES):
+        height = random.randint(1, 5)
+        width = random.randint(2, 6)
+        area = height * width
+        target = random.randint(max(2, area // 2), area)
+
+        mask = np.zeros((height, width), dtype=bool)
+        start = (random.randrange(height), random.randrange(width))
+        mask[start] = True
+        frontier = [start]
+        while int(mask.sum()) < target:
+            r, c = random.choice(frontier)
+            neighbors = [
+                (nr, nc)
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+                if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]
+            ]
+            if not neighbors:
+                frontier = [tuple(x) for x in np.argwhere(mask)]
+                continue
+            nr, nc = random.choice(neighbors)
+            mask[nr, nc] = True
+            frontier.append((nr, nc))
+
+        if mask[:, 0].any() and mask[:, -1].any() and _shape_connected(mask):
+            return mask
+    return None
