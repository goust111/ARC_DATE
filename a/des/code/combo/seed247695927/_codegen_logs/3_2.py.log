    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h > 0 and w > 0

    out = np.zeros((h, w + h - 1), dtype=int)
    for r in range(h):
        start = h - 1 - r
        out[r, start : start + w] = g[r]
    return out

