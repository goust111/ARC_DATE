+    parts = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
+    assert all(end > start for start, end in parts), "separator lines must leave non-empty cells"
+    return [(int(start), int(end)) for start, end in parts]
