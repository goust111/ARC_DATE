+    color_count = int(_RNG.integers(1, min(4, len(colors)) + 1))
+    chosen = list(_RNG.choice(colors, size=color_count, replace=False))
+    patch = np.full(mask.shape, bg, dtype=int)
+    coords = np.argwhere(mask)
