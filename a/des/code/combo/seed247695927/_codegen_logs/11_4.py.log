+    mask[start] = True
+    cells = {start}
+    frontier = set()
+    for dr, dc in _NEIGHBORS8:
+        nr, nc = start[0] + dr, start[1] + dc
+        if 0 <= nr < height and 0 <= nc < width:
+            frontier.add((nr, nc))
+
