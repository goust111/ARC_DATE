                    for dr, dc in DIRS4)
                assert adj_other, f"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing"

    # Assert: every line color crosses at least one other color
    color_cells = {c: set() for c in line_colors}
    for r in range(H):
        for c in range(W):
            v = int(out[r, c])
            if v in line_colors:
