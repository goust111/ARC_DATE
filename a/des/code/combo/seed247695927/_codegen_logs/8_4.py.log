+
+    for idx, comp in enumerate(comps):
+        vertex, direction = _sprite_info(comp["cells"])
+        vr, vc = vertex
+        dr, dc = direction
+        target = (vr + 5 * dr, vc + 5 * dc)
+        hit = cell_to_comp.get(target)
+        if hit is not None:
+            hit_components.add(hit)
+        else:
+            impacts_on_empty[target] += 1
