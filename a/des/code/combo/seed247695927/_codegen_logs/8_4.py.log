+            continue
+        if scene_kind == "double_empty" and not (hit_count == 0 and blue_empty >= 1):
+            continue
+        if scene_kind == "hit_sprite" and not (hit_count >= 1 and blue_empty == 0):
+            continue
+
+        grid = _render(shape, bg, sprites)
