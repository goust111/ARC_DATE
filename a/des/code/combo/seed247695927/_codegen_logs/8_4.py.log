+    cells = _sprite_cells(vertex, direction)
+    if not _in_bounds(cells, shape):
+        return False
+    if not (0 <= _impact(vertex, direction)[0] < shape[0] and 0 <= _impact(vertex, direction)[1] < shape[1]):
