+
+
+def _random_vertex_for_direction(shape: tuple[int, int], direction: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    offsets = SPRITE_OFFSETS[direction]
+    min_r = max(-dr for dr, _ in offsets)
+    max_r = min(h - 1 - dr for dr, _ in offsets)
