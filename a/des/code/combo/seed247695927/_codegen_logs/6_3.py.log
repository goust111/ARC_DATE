+            out[r, dc0 : right_border + 1] = below_colors[0]
+        elif (offset - below_offsets[1]) % period == 0:
+            out[r, sc0 : sc1 + 1] = below_colors[1]
+            out[r, dc0 : dc1 + 1] = below_colors[1]
+
+    return out
