+    first_r = sr1 + below_offsets[0]
+    last_r = dr0 - 1
+    left_border = sc0 - 1
+    right_border = dc1 + 1
+    for r in range(first_r, last_r + 1):
+        out[r, left_border] = below_colors[0]
+        out[r, right_border] = below_colors[0]
+        offset = r - sr1
+        if (offset - below_offsets[0]) % period == 0:
