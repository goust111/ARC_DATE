+def _variants(patch: np.ndarray, mask: np.ndarray) -> list[tuple[np.ndarray, np.ndarray, bool]]:
+    out: list[tuple[np.ndarray, np.ndarray, bool]] = []
+    seen = set()
+    for k in range(4):
+        p = np.rot90(patch, k)
+        m = np.rot90(mask, k)
+        for flip in (False, True):
