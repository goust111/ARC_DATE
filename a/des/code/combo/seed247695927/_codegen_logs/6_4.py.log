+            mm = np.fliplr(m) if flip else m.copy()
+            key = (mm.tobytes(), tuple(sorted(int(x) for x in pp[mm])))
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append((pp, mm, flip))
