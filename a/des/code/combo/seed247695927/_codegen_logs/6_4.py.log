+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(cnts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_patch(grid: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray, tuple[int, int]]:
+    pts = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(pts)
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    submask = mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+    patch[~submask] = 0
+    return patch, submask, (r0, c0)
+
+
+def _normalize(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    if len(coords) == 0:
+        return ()
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+
+
+def _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:
+    out = np.rot90(arr, k)
+    if flip:
+        out = np.fliplr(out)
+    return out
+
+
+def _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:
+    out = patch.copy()
+    ma = out == int(a)
+    mb = out == int(b)
+    out[ma] = int(b)
+    out[mb] = int(a)
+    return out
+
