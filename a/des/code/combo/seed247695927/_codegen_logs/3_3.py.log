+def _try_pack_layout(masks):
+    layout_h = random.randint(7, 10)
+    layout_w = random.randint(7, 10)
+    layout = np.zeros((layout_h, layout_w), dtype=bool)
+    placements = []
+    ordered = sorted(masks, key=lambda m: -int(m.sum()))
+    for mask in ordered:
