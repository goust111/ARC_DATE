+    frame_patch = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    hole_mask = frame_patch == bg
+    hole_box = _bbox_from_coords(np.argwhere(hole_mask))
+    hr0, hc0, hr1, hc1 = hole_box
