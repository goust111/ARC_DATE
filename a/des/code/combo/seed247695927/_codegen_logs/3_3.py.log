+import random
+from collections import Counter
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _bbox_from_coords(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    if len(rows) == 0 or len(cols) == 0:
+        return np.zeros((0, 0), dtype=bool)
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
+
+
+def _mask_components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _foreground_components(grid: np.ndarray, bg: int):
+    h, w = grid.shape
+    mask = grid != bg
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0, r1, c1 = _bbox_from_coords(coords)
+            comps.append({"coords": arr, "bbox": (r0, c0, r1, c1), "area": len(coords)})
+    return comps
+
+
+def _paste(dst: np.ndarray, src: np.ndarray, top: int, left: int, mask: np.ndarray | None = None):
+    h, w = src.shape
+    if mask is None:
+        dst[top : top + h, left : left + w] = src
+        return
+    view = dst[top : top + h, left : left + w]
+    view[mask] = src[mask]
+
+
+def _dihedral_masks(mask: np.ndarray):
+    variants = []
+    seen = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for cand in (rot, np.fliplr(rot)):
+            key = (cand.shape, cand.tobytes())
+            if key not in seen:
+                seen.add(key)
+                variants.append(cand.copy())
+    return variants
+
+
+def _canonical_key(mask: np.ndarray):
+    keys = []
+    for cand in _dihedral_masks(_trim_mask(mask)):
+        keys.append((cand.shape, cand.tobytes()))
+    return min(keys)
+
+
+def _downsample_blocks(mask: np.ndarray, k: int):
+    h, w = mask.shape
+    if h % k != 0 or w % k != 0:
+        return None
+    out = np.zeros((h // k, w // k), dtype=bool)
+    for r in range(out.shape[0]):
+        for c in range(out.shape[1]):
+            block = mask[r * k : (r + 1) * k, c * k : (c + 1) * k]
+            if block.all():
+                out[r, c] = True
+            elif block.any():
+                return None
+    return out
+
