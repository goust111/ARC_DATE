+    cols = np.where(mask.any(axis=0))[0]
+    if len(rows) == 0 or len(cols) == 0:
+        return np.zeros((0, 0), dtype=bool)
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
