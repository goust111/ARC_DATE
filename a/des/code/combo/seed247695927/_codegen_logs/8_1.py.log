+    assert 0 < total <= height, "result height must fit in the grid"
+
+    out = g.copy()
+    out[height - total :, result_col] = GREY
+    return out
+
+
+GEN_RETRIES = 500
+HEIGHT_RANGE = (6, 13)
+WIDTH_RANGE = (7, 17)
+BAR_COUNT_RANGE = (2, 6)
+
+
+def _bounded_composition(total: int, parts: int, upper: int) -> list[int] | None:
+    if parts == 0:
+        return [] if total == 0 else None
