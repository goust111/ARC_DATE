+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    height, width = map(int, g.shape)
+    assert width >= 3
+
+    bg = _background_color(g)
+    result_col = width - 2
+    assert np.all(g[:, result_col] == bg), "penultimate column must be the empty result slot"
+
+    total = 0
+    teal_seen = False
+    for col in range(width):
+        if col == result_col:
