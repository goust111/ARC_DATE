+def _color_sprite(rng: random.Random, mask: np.ndarray, palette: list[int]) -> np.ndarray:
+    n = mask.shape[0]
+    sprite = np.zeros((n, n), dtype=int)
+    cells = list(map(tuple, np.argwhere(mask)))
