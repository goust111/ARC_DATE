+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+TRANSFORMS = (
+    "identity",
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_h",
+    "flip_v",
+    "transpose",
+    "anti_transpose",
+)
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _apply_transform(arr: np.ndarray, name: str) -> np.ndarray:
+    if name == "identity":
+        return arr.copy()
+    if name == "rot90":
+        return np.rot90(arr, 1)
+    if name == "rot180":
+        return np.rot90(arr, 2)
+    if name == "rot270":
+        return np.rot90(arr, 3)
+    if name == "flip_h":
+        return np.fliplr(arr)
+    if name == "flip_v":
+        return np.flipud(arr)
+    if name == "transpose":
+        return arr.T.copy()
+    if name == "anti_transpose":
+        return np.fliplr(np.flipud(arr)).T.copy()
+    raise ValueError(name)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_of_color(grid: np.ndarray, color: int):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _extract_frames(grid: np.ndarray):
+    frames = []
+    for color in sorted(set(map(int, grid.flat)) - {BG}):
+        for pts in _components_of_color(grid, color):
+            rows = [r for r, _ in pts]
+            cols = [c for _, c in pts]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            side_h = r1 - r0 + 1
+            side_w = c1 - c0 + 1
+            if side_h != side_w or side_h < 5:
+                continue
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros_like(patch, dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(patch[border] == color):
+                continue
+            if np.any(patch[~border] == color):
+                continue
+            if len(pts) != int(border.sum()):
+                continue
