+    remaining = total
+    parts: list[int] = []
+    for idx in range(num_parts - 1):
+        min_rest = 2 * (num_parts - idx - 1)
+        high = remaining - min_rest
+        part = int(rng.integers(2, high + 1))
+        parts.append(part)
+        remaining -= part
