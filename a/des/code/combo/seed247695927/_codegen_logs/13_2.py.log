+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    lab, n = _label_mask(mask)
+    comps = []
+    for i in range(1, n + 1):
+        pts = np.argwhere(lab == i)
+        comps.append([(int(r), int(c)) for r, c in pts])
+    return comps
