+def _label_mask(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    h, w = mask.shape
+    lab = np.zeros((h, w), dtype=int)
+    cur = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or lab[r, c] != 0:
+                continue
+            cur += 1
+            q = deque([(r, c)])
+            lab[r, c] = cur
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and lab[nr, nc] == 0:
+                        lab[nr, nc] = cur
+                        q.append((nr, nc))
+    return lab, cur
