+def _largest_solid_square(mask: np.ndarray) -> tuple[int, int, int]:
+    h, w = mask.shape
+    ps = mask.astype(int).cumsum(axis=0).cumsum(axis=1)
+
+    def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:
+        s = int(ps[r1, c1])
+        if r0 > 0:
+            s -= int(ps[r0 - 1, c1])
+        if c0 > 0:
+            s -= int(ps[r1, c0 - 1])
+        if r0 > 0 and c0 > 0:
+            s += int(ps[r0 - 1, c0 - 1])
+        return s
