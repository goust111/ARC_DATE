+        ph = int(pts[:, 0].max() + 1)
+        pw = int(pts[:, 1].max() + 1)
+        placed = False
+        for _ in range(200):
+            r0 = random.randint(1, in_h - ph - 2)
+            c0 = random.randint(1, in_w - pw - 2)
+            if blocked[r0 - 1 : r0 + ph + 1, c0 - 1 : c0 + pw + 1].any():
+                continue
+            for dr, dc in pts:
+                grid[r0 + dr, c0 + dc] = color
+            blocked[r0 - 1 : r0 + ph + 1, c0 - 1 : c0 + pw + 1] = True
+            placed = True
