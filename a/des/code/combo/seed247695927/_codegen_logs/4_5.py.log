+def piece_sig(coords: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    norm = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in coords))
+    return int(r1 - r0 + 1), int(c1 - c0 + 1), norm
+
