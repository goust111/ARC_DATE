+
+
+def _choose_marker_plan(r0: int, c0: int, h: int, w: int, shape: tuple[int, int]) -> list[tuple[str, int, int]]:
+    H, W = shape
+    options = []
+    if r0 >= 3:
+        options.append(("top", w, r0 - 1))
+    if H - (r0 + h) >= 2:
+        options.append(("bottom", w, H - (r0 + h)))
