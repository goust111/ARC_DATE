+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = tuple(range(10))
+GRID_ROWS = (12, 24)
+GRID_COLS = (12, 24)
+COLOR_COUNT = (1, 3)
+RECT_SIDE = (2, 6)
+GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 80
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return components
+
+
+def _claim(grid: np.ndarray, claims: dict[tuple[int, int], int], coord: tuple[int, int], color: int, bg: int) -> None:
+    r, c = coord
+    assert 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]
+    base = int(grid[r, c])
+    assert base == bg or base == color
+    prior = claims.get(coord)
+    if prior is not None:
+        assert prior == color
+    claims[coord] = color
+
+
+def _claim_range(
+    grid: np.ndarray,
+    claims: dict[tuple[int, int], int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    step: tuple[int, int],
+    skip: tuple[int, int],
+    color: int,
+    bg: int,
+) -> None:
+    r, c = start
+    while True:
+        if (r, c) != skip:
+            _claim(grid, claims, (r, c), color, bg)
+        if (r, c) == end:
+            break
+        r += step[0]
+        c += step[1]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _background_color(g)
+    components = _find_components(g, bg)
+    assert components
+
+    by_color: dict[int, list[dict]] = {}
+    for comp in components:
+        by_color.setdefault(int(comp["color"]), []).append(comp)
+
+    claims: dict[tuple[int, int], int] = {}
+    clears: set[tuple[int, int]] = set()
+
+    for color, comps in by_color.items():
+        rectangles = []
+        markers = []
+        for comp in comps:
+            r0, c0, r1, c1 = comp["bbox"]
+            if comp["area"] > 1 and comp["area"] == (r1 - r0 + 1) * (c1 - c0 + 1):
