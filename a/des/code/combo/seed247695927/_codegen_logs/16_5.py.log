+            in_bbox = (out_r0 - dr, out_c0 - dc, out_r0 - dr + rh - 1, out_c0 - dc + rw - 1)
+            boxes.append((out_bbox, in_bbox))
+    random.shuffle(boxes)
+    return boxes
