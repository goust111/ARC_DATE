+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    out = []
+    for coords in comps:
+        arr = np.asarray(coords, dtype=int)
+        out.append(arr)
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _symmetry_type(mask: np.ndarray) -> str:
+    horizontal = bool(np.array_equal(mask, mask[::-1, :]))
+    vertical = bool(np.array_equal(mask, mask[:, ::-1]))
+    if horizontal and vertical:
+        return "both"
+    if horizontal:
+        return "horizontal"
+    if vertical:
+        return "vertical"
+    raise AssertionError("object must match one of the three supported symmetry classes")
+
+
+def _outline_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                    out[r, c] = True
+                    break
+    return out
