+
+BG = 0
+OBJ = 5
+LEGEND_COLORS = (2, 1, 3)  # left-to-right: horizontal only, vertical only, both
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_ATTEMPTS = 400
