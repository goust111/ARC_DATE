103:     """Sample shuffled operand specs and the matching grey result height."""
104:     result_height = random.randint(RESULT_HEIGHT_MIN, max_bar_height)
105:     feasible_teal_counts = []
106:     for teal_count in range(1, n + 1):
107:         red_count = n - teal_count
108:         red_sum_lo = max(red_count, teal_count - result_height)
109:         red_sum_hi = min(red_count * max_bar_height, teal_count * max_bar_height - result_height)
110:         if red_sum_lo <= red_sum_hi:
111:             feasible_teal_counts.append((teal_count, red_sum_lo, red_sum_hi))
