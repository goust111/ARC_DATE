69: def _infer_native_color(row: np.ndarray) -> int:
70:     counts = Counter(int(v) for v in row if int(v) != Color.BLACK)
71:     if not counts:
72:         raise ValueError("row has no foreground color")
73: 
74:     max_count = max(counts.values())
75:     candidates = [color for color, count in counts.items() if count == max_count]
76:     if len(candidates) > 1:
77:         first_col = {color: int(np.flatnonzero(row == color)[0]) for color in candidates}
78:         leftmost = min(first_col.values())
79:         candidates = [color for color in candidates if first_col[color] == leftmost]
80: 
81:     if len(candidates) != 1:
82:         raise ValueError("row native color is ambiguous")
83:     return candidates[0]
