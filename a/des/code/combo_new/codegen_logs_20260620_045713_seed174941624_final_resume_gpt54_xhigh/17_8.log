    left_rule = _read_rule(g[:split_r, :split_c])
    right_rule = _read_rule(g[:split_r, split_c + 1 :])

    seeds: list[tuple[int, int, int]] = []
    for r, c in np.argwhere(g[split_r + 1 :, :] != BG):
