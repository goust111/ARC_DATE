def _contains(bounds: tuple[int, int], value: int) -> bool:
    lo, hi = bounds
    return lo <= int(value) <= hi


def _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
    for r, c in cells:
        if grid[r, c] != BACKGROUND_COLOR:
            return False
