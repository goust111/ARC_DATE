+def _decode_arrow(coords: list[tuple[int, int]]) -> tuple[str, tuple[int, int]]:
+    ptset = set(coords)
+    matches: list[tuple[str, tuple[int, int]]] = []
+    for orientation, offsets in ARROW_OFFSETS.items():
+        for head in coords:
