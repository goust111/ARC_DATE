+                stop_reason = "wall"
+                break
+            if (rr, cc) in arrow_owner:
+                stop_reason = "arrow"
+                break
+            path.append((int(rr), int(cc)))
+            rr += dr
+            cc += dc
+        endpoint = path[-1] if path else None
+        ray = Ray(
+            source_index=int(idx),
+            color=int(arrow.color),
+            cells=tuple(path),
+            endpoint=endpoint,
+            stop_reason=stop_reason,
