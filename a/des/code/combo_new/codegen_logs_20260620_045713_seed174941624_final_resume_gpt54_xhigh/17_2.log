+    received: list[list[int]] = [[] for _ in arrows]
+    for ray in rays:
+        if ray.endpoint is None:
+            continue
+        for idx, arrow in enumerate(arrows):
+            if idx == ray.source_index:
+                continue
+            if _adjacent_to_arrow(ray.endpoint, arrow):
+                received[idx].append(int(ray.color))
+
