+
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(gh, top + ph + 1)
+    c1 = min(gw, left + pw + 1)
+    reserved[r0:r1, c0:c1] = True
+    return True
