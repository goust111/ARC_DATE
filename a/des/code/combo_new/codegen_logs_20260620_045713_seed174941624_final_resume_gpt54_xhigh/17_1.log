+    steps = [b1 - b0 for b0, b1 in zip(boundaries, boundaries[1:], strict=False)]
+    if not steps or len(set(steps)) != 1 or steps[0] < 3:
+        return None
+    cell_w = steps[0] - 1
+    if cell_w < 2:
