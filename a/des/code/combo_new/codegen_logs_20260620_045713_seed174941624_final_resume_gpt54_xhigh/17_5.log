+    if stop_direction == (1, 0) and stop_row == wall4 - 2:
+        stop_row -= 1
+        stop_start = (stop_row, stop_col)
+    if not _place_mover(grid, stop_start, stop_direction):
+        return None
+    expected[stop_start] = {"teleports": 0, "blocked": False}
+
+    if random.random() < 0.7:
