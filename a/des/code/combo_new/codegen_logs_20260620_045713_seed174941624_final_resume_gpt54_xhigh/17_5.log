+    for start in candidates:
+        if all(abs(start - other) >= 3 for other in chosen):
+            chosen.append(start)
+            if len(chosen) == 2:
+                return sorted(chosen)
+    return None
+
+
+def _sample_horizontal_bands() -> tuple[int, int, int, int, int, int]:
