+        return False
+
+    finals = [trace["end"] for trace in traces]
+    if len(set(finals)) != len(finals):
+        return False
+    if max(out.shape) > 30:
+        return False
+
+    for start, need in expected.items():
+        trace = trace_map[start]
+        if len(trace["teleports"]) != need["teleports"]:
+            return False
+        if trace["blocked_by_used"] != need["blocked"]:
+            return False
