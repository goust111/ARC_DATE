+    grid[wall1, p1_top : p1_top + 2] = colors[0]
+    grid[wall2, p1_mid : p1_mid + 2] = colors[0]
+    grid[wall3, p1_mid : p1_mid + 2] = colors[1]
+    grid[wall4, p2_bottom : p2_bottom + 2] = colors[1]
