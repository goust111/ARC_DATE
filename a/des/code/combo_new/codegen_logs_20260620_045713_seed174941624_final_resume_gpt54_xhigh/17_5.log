+        block_start = (block_row, p2_bottom + block_offset)
+        if not _place_mover(grid, block_start, (-1, 0)):
+            return None
+        expected[block_start] = {"teleports": 0, "blocked": True}
+
+    if not _validate_case(grid, expected):
