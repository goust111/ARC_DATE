+        in_left = c0 < split_c
+
+        cells = {(r0, c0)}
+        for _ in range(steps):
+            grown = set(cells)
+            for r, c in cells:
+                for dr, dc in directions:
+                    nr = r + dr
+                    nc = c + dc
+                    if not (split_r < nr < h):
+                        continue
+                    if in_left:
