+    placed: dict[int, BBox] = {}
+    accepted: List[BBox] = []
+    for idx, (box_h, box_w) in ordered:
+        found = None
+        for _ in range(PLACEMENT_RETRIES):
+            r0 = random.randint(0, height - box_h)
+            c0 = random.randint(1, width - box_w)
