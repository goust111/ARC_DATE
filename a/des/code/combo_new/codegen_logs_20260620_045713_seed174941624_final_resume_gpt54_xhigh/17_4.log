+def _sample_stack_depths(rect_count: int) -> List[int]:
+    stack_count = random.randint(1, min(MAX_STACKS, rect_count - 1))
+    depths = [1] * stack_count
+    remaining = rect_count - stack_count
+    while remaining > 0:
