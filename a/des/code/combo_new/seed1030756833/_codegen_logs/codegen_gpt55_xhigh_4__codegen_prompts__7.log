    r0 = random.randint(INTERIOR_ROW_BOUNDS[0], INTERIOR_ROW_BOUNDS[1] - height + 1)
    c0 = random.randint(INTERIOR_COL_BOUNDS[0], INTERIOR_COL_BOUNDS[1] - width + 1)
    r1 = r0 + height - 1
    c1 = c0 + width - 1

    out = _gen_blank_grid(winner_color)
