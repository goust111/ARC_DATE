+    colors_large_to_small = list(reversed(colors_small_to_large))
+    for (r0, c0, height, width), color in zip(bboxes_large_to_small, colors_large_to_small):
+        grid[r0 : r0 + height, c0 : c0 + width] = color
+
+    return grid
+
