+        endpoints = _endpoint_axis_positions(dividers, h, rng, full_span=(i == 0))
+        if endpoints is None:
+            return None
+        r0, r1 = endpoints
+        grid[r0, col] = int(color)
+        grid[r1, col] = int(color)
+    return grid
