def _split_positive(total: int, parts: int) -> list[int]:
    if parts == 1:
        return [int(total)]
    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))
    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]


