+    pair_colors = [int(c) for c in colors[divider_count : divider_count + pair_count]]
+    orientation = rng.choice(["vertical", "horizontal"])
+
+    grid = _render_parallel_case(h, w, bg, divider_colors, pair_colors, orientation, rng)
+    if grid is None:
+        return None
+
+    try:
