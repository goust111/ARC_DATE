+            grid[mr, mc] = GREY
+            blocked.update(_chebyshev_ring(package, h, w))
+            placed = True
+            break
+
+        if not placed:
+            return False
+
+    return True
+
+
+def _expected_output(shape: tuple[int, int], specs: list[dict]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
