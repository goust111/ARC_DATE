+                    frontier.append((nr, nc))
+        if not frontier:
+            break
+        nr, nc = random.choice(frontier)
+        cells.add((nr, nc))
+        mask[nr, nc] = True
+    return mask
+
+
+def _make_seed_mask(side: int) -> np.ndarray | None:
+    max_box = min(4, side - 1)
+    for _ in range(100):
+        h = random.randint(2, max_box)
