+
+def _intervals_from_lines(lines: list[int], limit: int) -> list[tuple[int, int]]:
+    bounds = sorted(int(x) for x in lines)
+    if not bounds or bounds[0] != 0:
+        bounds = [-1] + bounds
+    if bounds[-1] != limit - 1:
+        bounds = bounds + [limit]
+
+    intervals = []
+    for a, b in zip(bounds, bounds[1:]):
+        start, stop = a + 1, b
+        if start < stop:
+            intervals.append((start, stop))
+    return intervals
+
