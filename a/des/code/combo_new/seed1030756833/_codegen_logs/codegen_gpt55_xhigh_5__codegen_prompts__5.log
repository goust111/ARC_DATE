    # Left edge
    for ri in range(1, N - 1):
        out[hub_r + ri, hub_c] = left_col
    # Right edge
    for ri in range(1, N - 1):
        out[hub_r + ri, hub_c + N - 1] = right_col

    # Attach sprites to hub in output
    attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords
    for side in sprite_sides:
