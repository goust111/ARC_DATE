+BLACK = 0
+GREY = 5
+COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ["top", "right", "bottom", "left"]
+ROT_K = {"top": 0, "right": 3, "bottom": 2, "left": 1}
