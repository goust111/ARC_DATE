+            if not mask[sr, sc] or seen[sr, sc]:
+                continue
+            q: deque[tuple[int, int]] = deque([(sr, sc)])
+            seen[sr, sc] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                comp.append((int(r), int(c)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
