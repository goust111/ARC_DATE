+
+def _shape_mask(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = max(r for r, _c in shape) + 1
+    w = max(c for _r, c in shape) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in shape:
+        mask[r, c] = True
+    return mask
+
