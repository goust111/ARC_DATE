+
+
+def _shape_variants(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
+    base = _shape_mask(_shape_key(cells))
+    variants: list[tuple[tuple[int, int], ...]] = []
+    seen: set[tuple[tuple[int, int], ...]] = set()
