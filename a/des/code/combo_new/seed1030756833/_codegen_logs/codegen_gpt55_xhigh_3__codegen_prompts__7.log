+
+def _patch_from_shape(shape: tuple[tuple[int, int], ...], color: int) -> np.ndarray:
+    h = max(r for r, _c in shape) + 1
+    w = max(c for _r, c in shape) + 1
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in shape:
