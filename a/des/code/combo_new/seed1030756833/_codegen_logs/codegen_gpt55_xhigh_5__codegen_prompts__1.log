+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(12, 30)
+    w = random.randint(12, 30)
+    grid = np.full((h, w), BLACK, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
