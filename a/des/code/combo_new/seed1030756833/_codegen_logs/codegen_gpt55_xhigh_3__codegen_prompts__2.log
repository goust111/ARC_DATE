+    for r in rows:
+        key = int(g[r, 0])
+        val = int(g[r, 1])
+        mapping[key] = val
+        legend_mask[r, 0:2] = True
+
+    return mapping, legend_mask
+
+
+def _path_sequence(g, legend_mask):
+    h, w = g.shape
+    path_mask = (g != BLACK) & (~legend_mask)
