+    rows = []
+    r = h - 1
+    while r >= 0:
+        key = int(g[r, 0])
+        val = int(g[r, 1])
+        if key == BLACK or key in (GREY, MAROON) or val not in TURN_CODES:
+            break
+        rows.append(r)
+        r -= 1
