+    starts = [(int(r), int(c)) for r, c in np.argwhere((g == GREY) & (~legend_mask))]
+    ends = [(int(r), int(c)) for r, c in np.argwhere((g == MAROON) & (~legend_mask))]
+    assert len(starts) == 1 and len(ends) == 1
