+                    if rr1 - rr0 + 1 > 3 or rc1 - rc0 + 1 > 3:
+                        continue
+                    crop = rem[rr0 : rr1 + 1, rc0 : rc1 + 1]
+                    if bool(np.all(crop)):
+                        continue
