+    edge_row = ph - 1 if side == "bottom" else 0
+    touch_cols = [int(c) for c in np.where(pat[edge_row, :])[0]]
+    touch_col = rng.choice(touch_cols)
+    width = max(pw, k)
+    lo = max(0, touch_col - k + 1)
+    hi = min(width - k, touch_col)
