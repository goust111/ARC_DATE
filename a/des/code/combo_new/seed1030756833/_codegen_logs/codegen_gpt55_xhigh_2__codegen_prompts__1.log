+        "bottom": h - 1 - r1,
+        "left": c0,
+        "right": w - 1 - c1,
+    }
+    best_distance = min(distances.values())
+    winners = [side for side, dist in distances.items() if dist == best_distance]
+    assert len(winners) == 1, "legend must be nearest to one grid edge"
+    return winners[0]
