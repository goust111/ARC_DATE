+def _square_is_outer(
+    side: str,
+    sr0: int,
+    sc0: int,
+    sr1: int,
+    sc1: int,
+    rr0: int,
+    rc0: int,
+    rr1: int,
+    rc1: int,
+) -> bool:
+    if side == "right":
+        return sc0 > rc1
+    if side == "left":
+        return sc1 < rc0
+    if side == "bottom":
+        return sr0 > rr1
+    if side == "top":
+        return sr1 < rr0
+    return False
+
+
+def _outer_score(side: str, sr0: int, sc0: int, sr1: int, sc1: int) -> int:
+    if side == "right":
+        return sc1
+    if side == "left":
+        return -sc0
+    if side == "bottom":
+        return sr1
+    if side == "top":
+        return -sr0
+    return 0
