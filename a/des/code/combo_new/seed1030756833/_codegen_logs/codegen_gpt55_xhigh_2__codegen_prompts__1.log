+def _legend_side(legend_mask: np.ndarray) -> str:
+    h, w = legend_mask.shape
+    edge_counts = {
+        "top": int(legend_mask[0, :].sum()),
+        "bottom": int(legend_mask[-1, :].sum()),
+        "left": int(legend_mask[:, 0].sum()),
+        "right": int(legend_mask[:, -1].sum()),
