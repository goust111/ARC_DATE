+
+def _legend_shape_from_local(local: np.ndarray, side: str) -> np.ndarray:
+    candidates: list[tuple[int, int, int, np.ndarray]] = []
+    h, w = local.shape
+    for strict_side in (True, False):
+        candidates.clear()
+        for k in (2, 1):
