+    bg: int,
+    rng: random.Random,
+) -> bool:
+    h, w = grid.shape
+    gap = 1
+    if side in ("right", "left"):
+        total_h = sum(p.shape[0] for p in patches) + gap * (len(patches) - 1)
+        if total_h > h:
+            return False
+        margin = h - total_h
+        start = rng.randint(1, margin - 1) if margin >= 2 else rng.randint(0, margin)
