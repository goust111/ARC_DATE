+
+def _square_is_outer(
+    side: str,
+    sr0: int,
+    sc0: int,
+    sr1: int,
+    sc1: int,
+    rr0: int,
+    rc0: int,
+    rr1: int,
+    rc1: int,
+) -> bool:
+    if side == "right":
