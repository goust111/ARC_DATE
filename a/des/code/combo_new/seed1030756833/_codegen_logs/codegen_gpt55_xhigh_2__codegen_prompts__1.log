+    return False
+
+
+def _outer_score(side: str, sr0: int, sc0: int, sr1: int, sc1: int) -> int:
+    if side == "right":
+        return sc1
+    if side == "left":
+        return -sc0
+    if side == "bottom":
+        return sr1
+    if side == "top":
