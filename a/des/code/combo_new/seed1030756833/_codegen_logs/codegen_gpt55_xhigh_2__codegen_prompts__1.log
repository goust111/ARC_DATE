+def _can_place_square(occupied: np.ndarray, r0: int, c0: int, size: int) -> bool:
+    h, w = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + size > h or c0 + size > w:
+        return False
+    return not bool(
+        occupied[max(0, r0 - 1) : min(h, r0 + size + 1),
+                 max(0, c0 - 1) : min(w, c0 + size + 1)].any()
