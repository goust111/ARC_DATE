+        touch_rows = [int(r) for r in np.where(pat[:, edge_col])[0]]
+        touch_row = rng.choice(touch_rows)
+        height = max(ph, k)
+        lo = max(0, touch_row - k + 1)
+        hi = min(height - k, touch_row)
