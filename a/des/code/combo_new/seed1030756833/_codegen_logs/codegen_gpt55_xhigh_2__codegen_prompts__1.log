+def _frame_area_mask(shape: tuple[int, int], frames: list[dict]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for frame in frames:
+        mask[frame["r0"] : frame["r1"] + 1, frame["c0"] : frame["c1"] + 1] = True
