+        positions = [
+            (r, c)
+            for r in range(h - size + 1)
+            for c in range(w - size + 1)
+            if _can_place_square(occupied, r, c, size)
+        ]
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
