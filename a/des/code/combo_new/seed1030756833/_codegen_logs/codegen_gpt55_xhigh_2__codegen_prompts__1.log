+    fill_colors = sorted({int(frame["fill"]) for frame in frames})
+    shapes = {
+        color: _legend_shape_for_color(g, color, frame_mask, side)
+        for color in fill_colors
+    }
+
+    out = g.copy()
+    out[(~frame_mask) & (out != bg)] = bg
+    for frame in frames:
