+
+def _paste_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    mask = patch != bg
+    region = grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+    region[mask] = patch[mask]
