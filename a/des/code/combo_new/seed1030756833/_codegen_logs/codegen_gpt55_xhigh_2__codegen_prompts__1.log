+def _touches(square: set[tuple[int, int]], rem: np.ndarray) -> bool:
+    rem_pts = set(map(tuple, np.argwhere(rem)))
+    for r, c in square:
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in rem_pts:
