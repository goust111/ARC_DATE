+    num_colors = rng.randint(2, 4)
+    fill_colors = rng.sample(usable, num_colors)
+    patterns = [_trim_mask(p.copy()) for p in rng.sample(_PATTERNS, num_colors)]
+    swatches = [rng.choice([1, 2]) for _ in range(num_colors)]
+
