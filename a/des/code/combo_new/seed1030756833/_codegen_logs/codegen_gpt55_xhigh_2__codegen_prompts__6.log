+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
+            return result[0]
+    raise RuntimeError(f"generate_input failed after {_GEN_ATTEMPTS} attempts")

