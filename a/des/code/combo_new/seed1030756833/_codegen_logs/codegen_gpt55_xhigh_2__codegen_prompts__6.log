+def _normalize_cells(cells: set[tuple[int, int]]) -> np.ndarray:
+    r0 = min(r for r, _c in cells)
+    c0 = min(c for _r, c in cells)
+    rel = {(r - r0, c - c0) for r, c in cells}
+    h = max(r for r, _c in rel) + 1
+    w = max(c for _r, c in rel) + 1
