+    if int(Counter(map(int, inp.ravel())).most_common(1)[0][0]) != bg:
+        return None
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return inp, expected
