+        tip_rows = [r for r, cols in row_cols.items() if len(cols) == 1]
+        if len(shaft_rows) == 1 and len(tip_rows) == 1:
+            shaft_r = shaft_rows[0]
+            tip_r = tip_rows[0]
+            tip_c = row_cols[tip_r][0]
+            if tip_c in (c0, c1) and (shaft_r, tip_c) in pts:
+                infos.append(
