+# -------------------------- generator --------------------------
+
+_PALETTE = tuple(range(10))
+_GEN_ATTEMPTS = 500
+_PAIR_ATTEMPTS = 500
+
+
+def _mask_cells(mask: np.ndarray, top: int, left: int) -> set[tuple[int, int]]:
+    return {
