+        target = random.randint(2, min(7, h * w))
+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        while len(cells) < target:
+            frontier = []
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    nr, nc = r + dr, c + dc
