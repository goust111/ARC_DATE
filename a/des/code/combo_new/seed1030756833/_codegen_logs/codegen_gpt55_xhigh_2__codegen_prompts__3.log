+    end_square = _marker_square_cells(end, outward, g.shape)
+    assert all(int(g[r, c]) == bg for r, c in end_square), "endpoint marker area must be empty background"
+
+    out = g.copy()
+    for r, c in end_square:
+        out[r, c] = signal
