+    cells = [(rr, cc) for rr in range(r0, r0 + 3) for cc in range(c0, c0 + 3)]
+    h, w = shape
+    assert all(0 <= rr < h and 0 <= cc < w for rr, cc in cells), "3x3 marker must fit in the grid"
+    return cells
