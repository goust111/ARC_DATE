+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+GREY = 5
+DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _background(g: np.ndarray) -> int:
+    values, counts = np.unique(g, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(cell: tuple[int, int], shape: tuple[int, int]):
+    r, c = cell
+    h, w = shape
+    for dr, dc in DIRS:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cur = stack.pop()
+                comp.append(cur)
+                for nr, nc in _neighbors4(cur, mask.shape):
+                    if not seen[nr, nc] and mask[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _monochrome_components(g: np.ndarray, colors: set[int]) -> list[dict]:
+    comps = []
+    for color in colors:
+        for coords in _components(g == color):
+            rows = [r for r, _c in coords]
+            cols = [c for _r, c in coords]
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _is_solid_3x3(comp: dict) -> bool:
