+# --------------- generator ---------------
+
+GRID_H_RANGE = (12, 30)
+GRID_W_RANGE = (12, 30)
+PATH_LEN_RANGE = (9, 34)
+SIDE_MARKER_RANGE = (2, 6)
+MAX_GENERATION_ATTEMPTS = 500
+PATH_ATTEMPTS = 220
+WALK_ATTEMPTS = 80
