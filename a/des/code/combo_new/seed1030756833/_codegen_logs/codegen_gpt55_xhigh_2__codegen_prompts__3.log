+            if nb in path_cells and nb != prev
+        ]
+        if prev is not None and len(next_cells) == 0:
+            break
+        assert len(next_cells) == 1, "path order must be unambiguous"
+        nxt = next_cells[0]
+        order.append(nxt)
+        prev, cur = cur, nxt
+
+    assert len(order) == len(path_cells), "path trace did not visit every grey cell"
+    return order
+
