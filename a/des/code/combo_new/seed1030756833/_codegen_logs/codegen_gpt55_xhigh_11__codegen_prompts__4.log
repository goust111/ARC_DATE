+        interior = work[r0 + 1 : r1, c0 + 1 : c1]
+        assert np.any(interior != BLACK), "every frame must contain the next nested layer"
+        search = (r0 + 1, c0 + 1, r1 - 1, c1 - 1)
+        assert len(colors) <= len(COLOR_POOL), "too many nested layers"
+
+    return colors
