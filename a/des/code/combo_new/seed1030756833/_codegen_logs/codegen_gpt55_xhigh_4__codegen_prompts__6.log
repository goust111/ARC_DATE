+        return None
+    if any(r == 0 for r, _c in visited):
+        return None
+    if len(set(visited)) < 5:
+        return None
+    if not np.array_equal(out[0, :], grid[0, :]):
+        return None
+    if not all(color in sequence for color in INSTRUCTION_COLORS):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
