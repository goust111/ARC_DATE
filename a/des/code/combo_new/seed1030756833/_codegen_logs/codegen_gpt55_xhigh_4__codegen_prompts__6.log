+
+def _turn_color(current: tuple[int, int], target: tuple[int, int]) -> int:
+    delta = (DIRS.index(target) - DIRS.index(current)) % len(DIRS)
+    if delta == 0:
+        return GREEN
+    if delta == 1:
+        return RED
+    if delta == 2:
+        return YELLOW
+    assert delta == 3
+    return BLUE
