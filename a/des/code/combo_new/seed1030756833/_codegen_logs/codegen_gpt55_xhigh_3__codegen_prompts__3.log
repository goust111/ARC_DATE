+BG = 0
+SIDES = ("top", "right", "bottom", "left")
+SIDE_CENTER = {
+    "top": (0, 2),
+    "right": (2, 4),
+    "bottom": (4, 2),
+    "left": (2, 0),
+}
+SIDE_TO_CORNER = {
+    "top": (0, 0),
+    "right": (0, 2),
+    "bottom": (2, 2),
+    "left": (2, 0),
+}
+CORNER_TO_INDEX = {
+    (0, 0): 0,
+    (0, 2): 1,
+    (2, 2): 2,
+    (2, 0): 3,
