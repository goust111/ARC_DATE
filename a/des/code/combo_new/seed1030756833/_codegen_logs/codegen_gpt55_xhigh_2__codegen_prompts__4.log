+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+
+
+def _mode(values: np.ndarray) -> int:
+    vals, counts = np.unique(values.astype(int), return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _background_color(g: np.ndarray) -> int:
+    h, w = g.shape
+    if h == 1 or w == 1:
+        return _mode(g.ravel())
+    border = np.concatenate((g[0], g[-1], g[1:-1, 0], g[1:-1, -1]))
+    return _mode(border)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _closed_background_regions(g: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = g.shape
+    regions: list[dict[str, object]] = []
+    for pts in _components(g == bg):
+        touches_edge = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_edge:
+            continue
+        rows = [r for r, _c in pts]
+        cols = [c for _r, c in pts]
+        regions.append(
