+    expected = _expected_from_plan(grid.shape, bg, palette, objects)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if max(grid.shape) > 30 or max(actual.shape) > 30:
+        return None
+    return grid
+
