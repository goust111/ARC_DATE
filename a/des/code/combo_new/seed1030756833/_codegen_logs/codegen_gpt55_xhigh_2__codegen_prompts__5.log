+            start = c
+            while c < w and int(grid[r, c]) != bg:
+                c += 1
+            end = c
+            if end - start == 5:
+                colors = [int(grid[r, cc]) for cc in range(start, end)]
+                if len(set(colors)) == 5:
+                    mask = np.zeros((h, w), dtype=bool)
+                    mask[r, start:end] = True
+                    return colors, mask
+    raise ValueError("expected one bottom horizontal 5-color scale")
