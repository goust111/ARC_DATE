+def _internal_hole_count(grid: np.ndarray, coords: np.ndarray, bg: int) -> int:
+    r0, c0, r1, c1 = _bbox(coords)
+    crop = grid[r0 : r1 + 1, c0 : c1 + 1]
+    object_mask = np.zeros_like(crop, dtype=bool)
+    for r, c in coords:
+        object_mask[int(r) - r0, int(c) - c0] = True
