+            int(r) == 0
+            or int(c) == 0
+            or int(r) == crop.shape[0] - 1
+            or int(c) == crop.shape[1] - 1
+            for r, c in pts
+        ):
+            continue
+        enclosed_by_this_object = True
+        for r, c in pts:
+            rr, cc = int(r), int(c)
+            for dr, dc in NEIGHBORS4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < crop.shape[0] and 0 <= nc < crop.shape[1]:
