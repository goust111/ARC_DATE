+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
