+    for obj in objects:
+        mask = obj["mask"]
+        top, left, holes = int(obj["top"]), int(obj["left"]), int(obj["holes"])
+        color = int(palette[holes])
+        rel = np.argwhere(mask)
+        for k in range(holes + 1):
+            rr0 = top - k * int(mask.shape[0])
+            for rr, cc in rel:
