+            c0 = int(_RNG.integers(0, w - pw + 1))
+            if bool(occupied[r0 : r0 + ph, c0 : c0 + pw].any()):
+                continue
+            if not (r0 + ph - 1 < fr0 or r0 > fr1 or c0 + pw - 1 < fc0 or c0 > fc1):
