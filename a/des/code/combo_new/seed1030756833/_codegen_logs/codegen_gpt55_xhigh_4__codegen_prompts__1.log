+
+
+def _gen_attempt() -> np.ndarray | None:
+    configs = (
+        (2, 2, (3, 4, 5, 6)),
+        (2, 3, (3, 4, 5)),
+        (3, 2, (3, 4, 5)),
+        (2, 4, (3, 4)),
+        (4, 2, (3, 4)),
