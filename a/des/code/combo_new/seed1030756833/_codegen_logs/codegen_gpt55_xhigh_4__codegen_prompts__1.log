+            if patch[rr, cc] == BLACK:
+                nbrs.append((rr, cc))
+        if nbrs:
+            rr, cc = nbrs[int(_RNG.integers(0, len(nbrs)))]
+            patch[rr, cc] = int(_choice(content_colors))
