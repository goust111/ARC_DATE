+        for r in range(frame_gray.shape[0])
+        if bool(np.all(frame_gray[r, :]))
+    ]
+    v_lines = [
+        int(fc0 + c)
+        for c in range(frame_gray.shape[1])
+        if bool(np.all(frame_gray[:, c]))
