DEFECT_COUNT_MAX = 3
DEFECT_SIDES = ("top", "bottom", "left", "right")
DEFECT_TYPES = ("missing", "protrusion")
PANEL_MARGIN = 1
OBJECT_GAP = 2
MAX_PLACE_TRIES = 30

