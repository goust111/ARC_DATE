+def _parse_frame_component(grid: np.ndarray, bg: int, frame_color: int, comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    if r1 - r0 + 1 < 5 or c1 - c0 + 1 < 5:
+        return None
