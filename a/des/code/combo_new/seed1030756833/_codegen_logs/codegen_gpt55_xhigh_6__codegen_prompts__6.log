+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+CORNERS = ("TL", "TR", "BL", "BR")
+CORNER_DIR = {
+    "TL": (-1, -1),
+    "TR": (-1, 1),
+    "BL": (1, -1),
+    "BR": (1, 1),
+}
