        rows,
        cols,
        bg,
        anchor_color,
        right1,
        right2,
        below1,
        sr0,
        sc0,
        s,
        nh,
        nv,
    )
    inp = _derive_input(out, bg, *box)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


