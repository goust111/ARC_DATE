+def _runs_of_value(line: np.ndarray, value: int) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    n = int(line.shape[0])
+    while i < n:
+        if int(line[i]) != int(value):
+            i += 1
+            continue
+        start = i
+        while i + 1 < n and int(line[i + 1]) == int(value):
+            i += 1
+        runs.append((start, i))
+        i += 1
+    return runs
