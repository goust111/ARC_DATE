+            return mask
+
+        if kind == "tee" and max_h >= 3 and max_w >= 3:
+            h = random.randint(3, min(5, max_h))
+            w = random.randint(3, min(5, max_w))
+            mask = np.zeros((h, w), dtype=bool)
+            mid_r = h // 2
+            mid_c = w // 2
+            orient = random.choice(["up", "down", "left", "right"])
