+                mask[mid_r, :] = True
+            else:
+                mask[:, -1] = True
+                mask[mid_r, :] = True
+            return mask
+
+        if kind == "frame" and max_h >= 3 and max_w >= 3:
+            h = random.randint(3, min(5, max_h))
+            w = random.randint(3, min(5, max_w))
+            mask = np.zeros((h, w), dtype=bool)
+            mask[0, :] = True
+            mask[-1, :] = True
+            mask[:, 0] = True
+            mask[:, -1] = True
+            return mask
