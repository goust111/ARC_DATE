+    groups: list[list[np.ndarray]] = [[] for _ in col_runs]
+    for row_color, rs, re in row_runs:
+        assert int(row_color) != BACKGROUND
+        for col_i, (col_color, cs, ce) in enumerate(col_runs):
+            assert int(col_color) != BACKGROUND
