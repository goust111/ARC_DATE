  "dst": "bottom row for one-column sprites; row just above the divider for each wider sprite's unique widest horizontal row",
  "trajectory": "drop each sprite to dst; one-column sprites punch out the divider pixel in their column",
  "transform": "clear original sprite pixels; moved wider sprites keep shape and may overwrite divider pixels"
}
</annotation>
