+def _bands(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    bands = []
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+        else:
+            bands.append((start, prev))
+            start = prev = idx
+    bands.append((start, prev))
+    return bands
