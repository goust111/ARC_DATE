+        {"r": r0, "c": c0 + lw + gap, "h": fh, "w": rw, "side": "left", "color": colors[1]},
+    ]
+
+
+def _extra_horizontal_against(target: dict, color: int, grid_w: int) -> dict | None:
+    eh = random.randint(4, min(7, int(target["h"])))
