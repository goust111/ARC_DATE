+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if np.any(sub == BACKGROUND):
+            continue
+
+        mapping: dict[frozenset[int], int] = {}
+        ok = True
+        for row in sub:
+            a, mix, b = map(int, row)
+            if a == b:
+                ok = False
+                break
+            key = frozenset((a, b))
+            if key in mapping and mapping[key] != mix:
+                ok = False
+                break
+            mapping[key] = mix
+        if not ok or not mapping:
