{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py | sed -n '1,240p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py | sed -n '1,240p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n        paste(grid, sprite, sr, sc, transparent=bg)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py | sed -n '1,260p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py | sed -n '1,260p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n\n    Input structure:\n    - bg = most common color.\n    - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.\n    - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.\n\n    Rule:\n    - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.\n    - The legend's k×k color patch defines a spatial color map over the rectangle.\n    - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.\n\n    Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=4)\n    assert comps, 'grid must contain at least one non-background component'\n\n    # Identify legend component (most distinct colors) and infer k from number of pieces.\n    k = int(round(len(comps) ** 0.5))\n    assert k * k == len(comps), 'piece count must be a perfect square to determine k'\n\n    comp_colors = []\n    for pts in comps:\n        cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)\n        comp_colors.append(cols)\n\n    max_distinct = max(len(cols) for cols in comp_colors)\n    legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]\n    assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'\n    legend_idx = legend_candidates[0]\n    legend_map = _extract_legend_map(g, comps[legend_idx], k)\n\n    # Build piece masks (coords in bbox space), including filled holes.\n    pieces: list[dict] = []\n    for pts in comps:\n        filled_abs, _ = _fill_holes_in_component(g, pts, bg)\n        r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))\n        rel = tuple((r - r0, c - c0) for r, c in filled_abs)\n        rel_norm, _, _ = _normalize_coords(rel)\n        oris = _dihedral_orientations(rel_norm)\n        pieces.append({\"oris\": oris, \"area\": len(filled_abs)})\n\n    return _assemble_exact_cover(pieces, legend_idx, legend_map, k)\n\n# --------------- generator (o5x) ---------------\n\n# === CFG ===\nSIDE_CHOICES = [8, 10, 12]                     # output square side lengths\nK = 2                                          # k*k quadrant grid (2*2 = 4 pieces)\nNUM_PIECES = K * K                             # total jigsaw pieces\nNUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg\nAREA_FRAC_LO = 0.08                           # min piece area as fraction of total\nAREA_FRAC_HI = 0.43                           # max piece area as fraction of total\nAREA_ABS_LO = 11                              # absolute min piece area (cells)\nAREA_ABS_HI = 62                              # absolute max piece area (cells)\nLEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape\nLEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block\nLEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction\nPARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition\nPARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers\nPARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells\nINPUT_SIZE_LO = 20                             # min input grid side\nINPUT_SIZE_HI = 26                             # max input grid side\nDENSITY_LO = 0.15                              # min non-bg density target\nDENSITY_HI = 0.25                              # max non-bg density target\nSCATTER_BORDER = 1                             # border margin when placing pieces\nSCATTER_PADDING = 1                            # gap between piece bounding boxes\nGEN_RETRIES = 300                              # max attempts in generate_input()\n\n\ndef _area_bounds(side):\n    \"\"\"Min/max piece area for a given output side length.\"\"\"\n    total = side * side\n    return max(AREA_ABS_LO, math.ceil(AREA_FRAC_LO * total)), min(AREA_ABS_HI, math.floor(AREA_FRAC_HI * total))\n\n\ndef _has_hole(mask):\n    \"\"\"Return True if the mask contains an interior hole (bg region not touching the bbox edge).\"\"\"\n    pts = np.argwhere(mask)\n    if len(pts) == 0:\n        return True\n    r0, c0, r1, c1 = bbox_coords(pts)\n    sub = mask[r0 : r1 + 1, c0 : c1 + 1]\n    empty = ~sub\n    if not empty.any():\n        return False\n    for comp in components_mask(empty, connectivity=4):\n        if not (np.any(comp[:, 0] == 0) or np.any(comp[:, 0] == sub.shape[0] - 1)\n                or np.any(comp[:, 1] == 0) or np.any(comp[:, 1] == sub.shape[1] - 1)):\n            return True\n    return False\n\n\ndef _forces_unique_square(masks, side):\n    \"\"\"Check that piece bbox dims force a unique S*S factorization of total area.\"\"\"\n    bbs = [bbox_coords(np.argwhere(m)) for m in masks]\n    max_h = max(r1 - r0 + 1 for r0, _, r1, _ in bbs)\n    max_w = max(c1 - c0 + 1 for _, c0, _, c1 in bbs)\n    dims = [(h, w) for h, w in _factor_pairs(side * side) if h >= max_h and w >= max_w]\n    return dims == [(side, side)]\n\n\ndef _make_legend_mask(side, min_area, max_area):\n    \"\"\"Build an L-shaped legend piece mask anchored at (0,0) of the side*side grid.\"\"\"\n    threshold = LEGEND_THRESHOLD[side]\n    opts = []\n    for h0 in range(threshold + 1, side + 1):\n        for w0 in range(threshold + 1, side + 1):\n            for arm_w in LEGEND_ARM_RANGE:\n                for arm_h in LEGEND_ARM_RANGE:\n                    mask = np.zeros((side, side), dtype=bool)\n                    mask[:LEGEND_CORE_SIZE, :LEGEND_CORE_SIZE] = True\n                    mask[:arm_h, :w0] = True\n                    mask[:h0, :arm_w] = True\n                    area = int(mask.sum())\n                    if min_area <= area <= max_area:\n                        opts.append(mask)\n    return random.choice(opts).copy()\n\n\ndef _partition_rest(rest):\n    \"\"\"Flood-fill partition the complement of the legend into 3 connected regions.\"\"\"\n    side = rest.shape[0]\n    labels = np.full((side, side), -1, dtype=int)\n    available = set(map(tuple, np.argwhere(rest)))\n    anchors = [\n        (random.randint(0, side // 3), side - 1),\n        (side - 1, random.randint(0, side // 3)),\n        (side - 1, side - 1),\n    ]\n\n    seeds = []\n    for ar, ac in anchors:\n        seed = min(available, key=lambda p: abs(p[0] - ar) + abs(p[1] - ac) + random.random() * PARTITION_SEED_JITTER)\n        seeds.append(seed)\n        available.remove(seed)\n\n    areas = [0, 0, 0]\n    frontiers = [set() for _ in range(3)]\n\n    def add_frontier(i, r, c):\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < side and 0 <= cc < side and rest[rr, cc] and labels[rr, cc] < 0:\n                frontiers[i].add((rr, cc))\n\n    for i, seed in enumerate(seeds):\n        labels[seed] = i\n        areas[i] = 1\n        add_frontier(i, seed[0], seed[1])\n\n    unassigned = int(rest.sum()) - len(seeds)\n    while unassigned:\n        candidates = []\n        for i in range(3):\n            frontiers[i] = {p for p in frontiers[i] if labels[p] < 0}\n            if frontiers[i]:\n                candidates.append(i)\n        if not candidates:\n            return None\n\n        weights = [(1.0 / (areas[i] ** PARTITION_GROWTH_EXP)) * (len(frontiers[i]) ** PARTITION_FRONTIER_EXP)\n                    for i in candidates]\n        i = random.choices(candidates, weights=weights, k=1)[0]\n        cell = random.choice(tuple(frontiers[i]))\n        frontiers[i].discard(cell)\n        labels[cell] = i\n        areas[i] += 1\n        unassigned -= 1\n        add_frontier(i, cell[0], cell[1])\n\n    return labels\n\n\ndef _crop_mask(mask):\n    \"\"\"Crop a boolean mask to its bounding box.\"\"\"\n    r0, c0, r1, c1 = bbox_coords(np.argwhere(mask))\n    return mask[r0 : r1 + 1, c0 : c1 + 1]\n\n\ndef _random_orientation(mask):\n    \"\"\"Return a random D4 orientation of the cropped mask (unique shapes only).\"\"\"\n    arr = mask.astype(int)\n    opts = []\n    seen = set()\n    for k in range(4):\n        rot = np.rot90(arr, k)\n        for oriented in (rot, np.fliplr(rot)):\n            r0, c0, r1, c1 = bbox_coords(np.argwhere(oriented > 0))\n            crop = oriented[r0 : r1 + 1, c0 : c1 + 1].astype(bool)\n            key = (crop.shape, tuple(crop.ravel()))\n            if key not in seen:\n                seen.add(key)\n                opts.append(crop)\n    return random.choice(opts)\n\n\ndef _palette_spots(mask):\n    \"\"\"Find valid 2x2 palette embedding positions (fully surrounded by piece cells).\"\"\"\n    spots = []\n    h, w = mask.shape\n    for r in range(1, h - K):\n        for c in range(1, w - K):\n            if mask[r : r + K, c : c + K].all() and mask[r - 1 : r + K + 1, c - 1 : c + K + 1].all():\n                spots.append((r, c))\n    return spots\n\n\ndef _scatter_pieces(masks, body_colors, legend_map, side):\n    \"\"\"Place all pieces on a random-sized input grid with separation.\"\"\"\n    total = side * side\n    nlo = max(INPUT_SIZE_LO, math.ceil(math.sqrt(total / DENSITY_HI)))\n    nhi = min(INPUT_SIZE_HI, math.floor(math.sqrt(total / DENSITY_LO)))\n    grid_size = random.randint(nlo, nhi)\n    grid = np.zeros((grid_size, grid_size), dtype=int)\n    occupied = np.zeros_like(grid)\n\n    for pi in random.sample(range(NUM_PIECES), NUM_PIECES):\n        oriented = _crop_mask(masks[pi]) if pi == 0 else _random_orientation(_crop_mask(masks[pi]))\n        patch = np.zeros(oriented.shape, dtype=int)\n        patch[oriented] = body_colors[pi]\n        if pi == 0:\n            spots = _palette_spots(oriented)\n            if not spots:\n                return None\n            r, c = random.choice(spots)\n            patch[r : r + K, c : c + K] = legend_map\n        try:\n            box = np.ones(oriented.shape, dtype=int)\n            r0, c0 = random_free_location(occupied, box, transparent=0,\n                                           border=SCATTER_BORDER, padding=SCATTER_PADDING, padding_connectivity=8)\n        except ValueError:\n            return None\n        occupied[r0 : r0 + oriented.shape[0], c0 : c0 + oriented.shape[1]] = 1\n        paste(grid, patch, r0, c0, transparent=0)\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build tiling, validate, scatter pieces.\"\"\"\n    side = random.choice(SIDE_CHOICES)\n    min_area, max_area = _area_bounds(side)\n    legend = _make_legend_mask(side, min_area, max_area)\n    labels = _partition_rest(~legend)\n    if labels is None:\n        return None\n\n    masks = [legend] + [labels == i for i in range(3)]\n    areas = [int(m.sum()) for m in masks]\n    if any(a < min_area or a > max_area for a in areas):\n        return None\n    if any(len(components_mask(m, connectivity=4)) != 1 or _has_hole(m) for m in masks):\n        return None\n    if not _forces_unique_square(masks, side):\n        return None\n\n","exit_code":0,"status":"completed"}}
