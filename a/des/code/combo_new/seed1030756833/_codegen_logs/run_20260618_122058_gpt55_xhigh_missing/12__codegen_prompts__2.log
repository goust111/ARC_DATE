{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py | sed -n '1,280p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered rectangular pieces into a rectangle at an L-marker corner.\n\n    Input structure:\n    - bg = most common color. Non-bg rectangular pieces scattered on the grid.\n    - 3-pixel L-marker (2x2 minus one cell) tags the corner; the gap is the corner cell.\n\n    Rule:\n    - rect_col = most common color across all piece pixels; all outer rectangle edges must be rect_col.\n    - Translate pieces (no rotation) to tile the rectangle; touching edges must match, with rect_col as wildcard.\n\n    Key insight: rect_col acts as wildcard during edge matching — only non-rect_col pixels at shared boundaries must agree.\n    \"\"\"\n    inp = grid\n    g = np.array(inp, dtype=int)\n    GH, GW = g.shape\n\n    bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])\n\n    # Find marker: a color appearing exactly 3 times forming an L in a 2x2 bbox.\n    cnt = Counter(map(int, g.flatten()))\n    mark = None\n    missing = None\n    mb = None  # marker bbox\n    for col in sorted([c for c, n in cnt.items() if int(c) != int(bg) and int(n) == 3]):\n        pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]\n        rs = [r for r, _ in pts]\n        cs = [c for _, c in pts]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        if (r1 - r0) == 1 and (c1 - c0) == 1:\n            all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n            miss = list(all4 - set(pts))\n            if len(miss) == 1:\n                mark = int(col)\n                missing = miss[0]\n                mb = (r0, c0, r1, c1)\n                break\n\n    assert not (mark is None or missing is None or mb is None)\n\n    r0, c0, r1, c1 = mb\n    # Rectangle corner is opposite the marker bulk.\n    if missing == (r0, c0):\n        corner = \"BR\"\n    elif missing == (r0, c1):\n        corner = \"BL\"\n    elif missing == (r1, c0):\n        corner = \"TR\"\n    else:\n        corner = \"TL\"\n\n    # Decompose occupied mask (non-bg and non-marker) into rectangles.\n    occ = (g != int(bg)) & (g != int(mark))\n    used = np.zeros_like(occ, dtype=bool)\n    rects = []  # (r, c, h, w, arr)\n    while True:\n        idx = np.argwhere(occ & (~used))\n        if idx.size == 0:\n            break\n        rr, cc = map(int, idx[0])\n        w = 0\n        while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):\n            w += 1\n        h = 0\n        while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):\n            h += 1\n        used[rr : rr + h, cc : cc + w] = True\n        rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))\n\n    total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))\n\n    # The final rectangle's border/background color.\n    allpix = []\n    for _r, _c, _h, _w, a in rects:\n        allpix.extend(map(int, a.flatten()))\n    rect_col = int(Counter(allpix).most_common(1)[0][0])\n\n    mr, mc = map(int, missing)\n\n    # Anchor piece: the rectangle containing the corner cell.\n    anchor_idx = None\n    for i, (rr, cc, h, w, _a) in enumerate(rects):\n        if rr <= mr < rr + h and cc <= mc < cc + w:\n            anchor_idx = i\n            break\n\n    pieces = [a for _r, _c, _h, _w, a in rects]\n    ph = [int(p.shape[0]) for p in pieces]\n    pw = [int(p.shape[1]) for p in pieces]\n\n    # Candidate rectangle dimensions are factor pairs of total_area that fit in the grid\n    # when anchored at (mr, mc) as the specified corner.\n    dims = []\n    for hh in range(1, int(total_area**0.5) + 1):\n        if total_area % hh == 0:\n            dims.append((hh, total_area // hh))\n            if hh * hh != total_area:\n                dims.append((total_area // hh, hh))\n\n    def fits(H, W):\n        if corner == \"TL\":\n            tr, tc = mr, mc\n        elif corner == \"TR\":\n            tr, tc = mr, mc - W + 1\n        elif corner == \"BL\":\n            tr, tc = mr - H + 1, mc\n        else:  # \"BR\"\n            tr, tc = mr - H + 1, mc - W + 1\n        return 0 <= tr and 0 <= tc and (tr + H) <= GH and (tc + W) <= GW\n\n    dims = [(int(H), int(W)) for H, W in dims if fits(int(H), int(W))]\n    dims = sorted(dims, key=lambda t: (-t[0] * t[1], -t[0], -t[1]))\n\n    def compat(v1, v2):\n        v1 = np.array(v1, dtype=int)\n        v2 = np.array(v2, dtype=int)\n        m = (v1 != int(rect_col)) & (v2 != int(rect_col))\n        return bool((v1[m] == v2[m]).all())\n\n    def assemble(H, W):\n        occ2 = np.full((H, W), -1, dtype=int)\n        usedp = [False] * len(pieces)\n\n        def boundary_ok(a, r, c):\n            h, w = a.shape\n            if r == 0 and not np.all(a[0, :] == int(rect_col)):\n                return False\n            if (r + h) == H and not np.all(a[-1, :] == int(rect_col)):\n                return False\n            if c == 0 and not np.all(a[:, 0] == int(rect_col)):\n                return False\n            if (c + w) == W and not np.all(a[:, -1] == int(rect_col)):\n                return False\n            return True\n\n        def neighbor_ok(a, r, c):\n            h, w = a.shape\n            if c > 0:\n                left = occ2[r : r + h, c - 1]\n                m = left != -1\n                if m.any() and (not compat(left[m], a[:, 0][m])):\n                    return False\n            if (c + w) < W:\n                right = occ2[r : r + h, c + w]\n                m = right != -1\n                if m.any() and (not compat(right[m], a[:, -1][m])):\n                    return False\n            if r > 0:\n                up = occ2[r - 1, c : c + w]\n                m = up != -1\n                if m.any() and (not compat(up[m], a[0, :][m])):\n                    return False\n            if (r + h) < H:\n                down = occ2[r + h, c : c + w]\n                m = down != -1\n                if m.any() and (not compat(down[m], a[-1, :][m])):\n                    return False\n            return True\n\n        def can_place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            if (r + h) > H or (c + w) > W:\n                return False\n            if (occ2[r : r + h, c : c + w] != -1).any():\n                return False\n            if not boundary_ok(a, r, c):\n                return False\n            if not neighbor_ok(a, r, c):\n                return False\n            return True\n\n        def place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = a\n            usedp[i] = True\n\n        def unplace(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = -1\n            usedp[i] = False\n\n        # Pre-place anchor piece if the corner cell is exactly a corner of that piece.\n        if anchor_idx is not None:\n            rr, cc, h0, w0, _ = rects[anchor_idx]\n            corners = {\n                (rr, cc): \"TL\",\n                (rr, cc + w0 - 1): \"TR\",\n                (rr + h0 - 1, cc): \"BL\",\n                (rr + h0 - 1, cc + w0 - 1): \"BR\",\n            }\n            if (mr, mc) in corners and corners[(mr, mc)] == corner:\n                ah, aw = ph[anchor_idx], pw[anchor_idx]\n                if corner == \"TL\":\n                    ar0, ac0 = 0, 0\n                elif corner == \"TR\":\n                    ar0, ac0 = 0, W - aw\n                elif corner == \"BL\":\n                    ar0, ac0 = H - ah, 0\n                else:  # \"BR\"\n                    ar0, ac0 = H - ah, W - aw\n                if can_place(anchor_idx, ar0, ac0):\n                    place(anchor_idx, ar0, ac0)\n\n        order = sorted(range(len(pieces)), key=lambda i: (-ph[i] * pw[i], -ph[i], -pw[i], i))\n\n        def next_empty():\n            idx = np.argwhere(occ2 == -1)\n            if idx.size == 0:\n                return None\n            return tuple(map(int, idx[0]))\n\n        solved = False\n\n        def bt():\n            nonlocal solved\n            nxt = next_empty()\n            if nxt is None:\n                solved = True\n                return\n            r, c = nxt\n            for i in order:\n                if usedp[i]:\n                    continue\n                if can_place(i, r, c):\n                    place(i, r, c)\n                    bt()\n                    if solved:\n                        return\n                    unplace(i, r, c)\n\n        bt()\n        return occ2 if solved else None\n\n    ass = None\n    used_dim = None\n    for H, W in dims:\n        ass = assemble(H, W)\n        if ass is not None:\n            used_dim = (H, W)\n            break\n\n    assert not (ass is None or used_dim is None)\n\n    H, W = used_dim\n    if corner == \"TL\":\n        top_left = (mr, mc)\n    elif corner == \"TR\":\n        top_left = (mr, mc - W + 1)\n    elif corner == \"BL\":\n        top_left = (mr - H + 1, mc)\n    else:  # \"BR\"\n        top_left = (mr - H + 1, mc - W + 1)\n\n    out = np.full((GH, GW), int(bg), dtype=int)\n    tr, tc = map(int, top_left)\n    out[tr : tr + H, tc : tc + W] = ass\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    import random as _r\n\n    # --- grid size ---\n    GH = _r.randint(10, 26)\n    GW = _r.randint(10, 26)\n\n    # --- colors ---\n    palette = list(range(10))\n    _r.shuffle(palette)\n    bg = palette[0]\n    rect_col = palette[1]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py | sed -n '1,260p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py | sed -n '1,260p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n            below = _exits_below(grid, r, seg)\n            if len(above) > 1 or len(below) > 1:\n                issues.append((r, seg, above, below))\n    return issues\n\n\ndef _separator_column(grid: np.ndarray, r: int, left: int, right: int) -> int | None:\n    choices = [c for c in range(left + 1, right) if grid[r, c] == BG]\n","exit_code":0,"status":"completed"}}
