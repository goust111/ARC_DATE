train/f0f8a26d.py:150:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:93:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:94:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:117:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/34cfa167.py:336:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:31:    \"\"\"Map actual offset <-> canonical (TL-orientation) offset; self-inverse.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:39:    \"\"\"Walk from (r,c) along (dr,dc) until bg/boundary. Return (non_bg_count, saw_zero).\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:98:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:99:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:118:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:241:    \"\"\"Partition `total` non-negative units into `parts` bins uniformly at random.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:253:    \"\"\"Return (pattern cells, k_max = deepest inward-diagonal offset).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:260:    \"\"\"Draw a size x size hollow frame of 0 with TL at (r, c).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:275:    \"\"\"Pick two frame sizes and their origins along one axis of length `span`.\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:278:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:294:    \"\"\"Place two frames either side-by-side (shared row) or stacked (shared col).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:308:    \"\"\"Place three frames in three of the four corner slots (TL/TR/BL/BR), one missing.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:354:    \"\"\"Give every corner of every frame an independently sampled non-bg color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:361:    \"\"\"Choose 1..N_SOURCES_MAX source corners from frames larger than the minimum size.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:372:    \"\"\"Paint the canonical pattern at every corner using that corner's color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:384:    \"\"\"Erase every non-source corner's pattern back to base, keeping only the (k_max,k_max) marker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/4c416de3.py:429:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:12:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:13:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:29:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:343:    \"\"\"Connect background-region labels separated by each wall component.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:389:    \"\"\"Validate task constraints and return the solver-expected output grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/3bd292e8.py:452:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/e729b7be.py:7:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/e729b7be.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/e729b7be.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/e729b7be.py:215:def generate_input():\n","exit_code":0,"status":"completed"}}
