{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\nCoordSet = set[tuple[int, int]]\n\n\ndef _active_row_spans(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    active = np.any(g != bg, axis=1)\n    spans: list[tuple[int, int]] = []\n    r = 0\n    h = g.shape[0]\n    while r < h:\n        if not active[r]:\n            r += 1\n            continue\n        r0 = r\n        while r < h and active[r]:\n            r += 1\n        spans.append((r0, r - 1))\n    return spans\n\n\ndef _coords(mask: np.ndarray) -> CoordSet:\n    return {(int(r), int(c)) for r, c in np.argwhere(mask)}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each right-side colored shape into the left slot whose template color is its exact complement.\n\n    Input structure:\n    - The grid has two equal-width slots separated by one background column.\n    - Non-background rows form horizontal bands separated by all-background rows.\n    - Each band has a shared template color in the left slot and one colored source shape in the right slot.\n\n    Rule:\n    - For each band, define its destination shape as the cells in the left slot not occupied by the template color.\n    - Normalize every right-side source shape to right-slot coordinates and match it to the unique equal destination shape.\n    - Clear the original right-side source pixels and paint the matched left-slot complement with the source color.\n\n    Key insight:\n    The right-side objects are not placed by row order; each one completes the unique left template whose missing cells have the same shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    assert w % 2 == 1, \"canvas must contain two equal slots plus one separator column\"\n    slot_w = w // 2\n    sep_c = slot_w\n\n    bands = _active_row_spans(g, bg)\n    assert bands, \"grid must contain at least one active band\"\n\n    band_color_sets: list[set[int]] = []\n    for r0, r1 in bands:\n        colors = set(map(int, g[r0 : r1 + 1].ravel())) - {bg}\n        assert colors, \"each active band must contain foreground colors\"\n        band_color_sets.append(colors)\n\n    shared_colors = set.intersection(*band_color_sets)\n    assert len(shared_colors) == 1, \"template color must be the only color shared by all bands\"\n    template_color = next(iter(shared_colors))\n\n    dest_shapes: list[CoordSet] = []\n    sources: list[tuple[int, CoordSet]] = []\n    for band_i, (r0, r1) in enumerate(bands):\n        block = g[r0 : r1 + 1]\n        assert np.all(block[:, sep_c] == bg), \"slot separator column must be background\"\n\n        left = block[:, :slot_w]\n        right = block[:, sep_c + 1 :]\n        assert np.all((left == bg) | (left == template_color)), \"left slot must contain only template and background\"\n\n        template_mask = left == template_color\n        for row in template_mask:\n            cols = np.flatnonzero(row)\n            assert cols.size > 0, \"each template row must contain at least one pixel\"\n            expected = np.arange(int(cols[-1]) + 1)\n            assert np.array_equal(cols, expected), \"template pixels must be a left-anchored row prefix\"\n\n        dest_shapes.append(_coords(~template_mask))\n\n        source_mask = right != bg\n        assert np.any(source_mask), f\"band {band_i} source shape must be non-empty\"\n        source_colors = set(map(int, right[source_mask].ravel()))\n        assert len(source_colors) == 1, \"each right slot must contain exactly one source color\"\n        source_color = next(iter(source_colors))\n        assert source_color != template_color, \"source color must differ from template color\"\n        source_shape = _coords(source_mask)\n        sources.append((source_color, source_shape))\n\n    out = g.copy()\n    for r0, r1 in bands:\n        right = out[r0 : r1 + 1, sep_c + 1 :]\n        right[right != bg] = bg\n\n    used_destinations: set[int] = set()\n    for source_color, source_shape in sources:\n        matches = [i for i, dest_shape in enumerate(dest_shapes) if dest_shape == source_shape]\n        assert len(matches) == 1, \"each source shape must match exactly one left-slot complement\"\n        dest_i = matches[0]\n        assert dest_i not in used_destinations, \"each destination complement must be filled once\"\n        used_destinations.add(dest_i)\n\n        dest_r0, _ = bands[dest_i]\n        for dr, dc in source_shape:\n            rr = dest_r0 + dr\n            assert out[rr, dc] == bg, \"matched complement cells must be empty before painting\"\n            out[rr, dc] = source_color\n\n    assert len(used_destinations) == len(bands), \"all destination complements must be filled\"\n    assert out.shape == (h, w)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG = 7\nTEMPLATE = 8\n\n# Canvas and band geometry.\nSLOT_W = 5\nBAND_H = 3\nBAND_GAP = 1\nOUTER_MARGIN_ROWS = 1\nSEPARATOR_W = 1\nWIDTH = SLOT_W * 2 + SEPARATOR_W\nRIGHT_SLOT_C0 = SLOT_W + SEPARATOR_W\n\n# Sampling ranges and palette.\nMIN_BANDS, MAX_BANDS = 2, 4\nMIN_SUFFIX_LEN, MAX_SUFFIX_LEN = 1, SLOT_W - 1\nSUFFIX_LENGTHS = range(MIN_SUFFIX_LEN, MAX_SUFFIX_LEN + 1)\nSOURCE_COLORS = [1, 2, 3, 4, 5, 6, 9]\nCOMPLEMENTS = [(a, b, c) for a in SUFFIX_LENGTHS for b in SUFFIX_LENGTHS for c in SUFFIX_LENGTHS]\nMAX_ATTEMPTS = 300\n\n\ndef _band_top(i: int) -> int:\n    return OUTER_MARGIN_ROWS + i * (BAND_H + BAND_GAP)\n\n\ndef _sample_layout() -> tuple[int, list[tuple[int, int, int]], list[int], list[int]]:\n    \"\"\"Sample distinct band complements, source colors, and source-to-destination mapping.\"\"\"\n    num_bands = random.randint(MIN_BANDS, MAX_BANDS)\n    comps = random.sample(COMPLEMENTS, num_bands)\n    source_colors = random.sample(SOURCE_COLORS, num_bands)\n    perm = list(range(num_bands))\n    random.shuffle(perm)\n    return num_bands, comps, source_colors, perm\n\n\ndef _paint_template(grid: np.ndarray, r0: int, comp: tuple[int, int, int]) -> None:\n    for dr, suffix_len in enumerate(comp):\n        grid[r0 + dr, : SLOT_W - suffix_len] = TEMPLATE\n\n\ndef _paint_suffix(grid: np.ndarray, r0: int, c0: int, comp: tuple[int, int, int], color: int) -> None:\n    for dr, suffix_len in enumerate(comp):\n        grid[r0 + dr, c0 + SLOT_W - suffix_len : c0 + SLOT_W] = color\n\n\ndef _build_output(rows: int, comps: list[tuple[int, int, int]], source_colors: list[int], perm: list[int]) -> np.ndarray:\n    \"\"\"Render the solved grid: templates plus matched left complements.\"\"\"\n    out = np.full((rows, WIDTH), BG, dtype=int)\n    for dest_i, comp in enumerate(comps):\n        _paint_template(out, _band_top(dest_i), comp)\n    for src_i, dest_i in enumerate(perm):\n        _paint_suffix(out, _band_top(dest_i), 0, comps[dest_i], source_colors[src_i])\n    return out\n\n\ndef _build_input(out: np.ndarray, comps: list[tuple[int, int, int]], source_colors: list[int], perm: list[int]) -> np.ndarray:\n    \"\"\"Invert the solver transform by clearing left complements and placing right sources.\"\"\"\n    inp = out.copy()\n    for dest_i, comp in enumerate(comps):\n        _paint_suffix(inp, _band_top(dest_i), 0, comp, BG)\n    for src_i, dest_i in enumerate(perm):\n        _paint_suffix(inp, _band_top(src_i), RIGHT_SLOT_C0, comps[dest_i], source_colors[src_i])\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    num_bands, comps, source_colors, perm = _sample_layout()\n    rows = 2 * OUTER_MARGIN_ROWS + num_bands * BAND_H + (num_bands - 1) * BAND_GAP\n    out = _build_output(rows, comps, source_colors, perm)\n    inp = _build_input(out, comps, source_colors, perm)\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef _solid_separator_cross(g: np.ndarray, bg: int) -> tuple[int, int]:\n    height, width = g.shape\n    solid_rows = [r for r in range(height) if np.all(g[r, :] == bg)]\n    solid_cols = [c for c in range(width) if np.all(g[:, c] == bg)]\n    assert len(solid_rows) == 1, \"expected exactly one solid background separator row\"\n    assert len(solid_cols) == 1, \"expected exactly one solid background separator column\"\n    return solid_rows[0], solid_cols[0]\n\n\ndef _quadrants(cross_row: int, cross_col: int, height: int, width: int) -> list[tuple[slice, slice]]:\n    top_h = cross_row\n    bottom_h = height - cross_row - 1\n    left_w = cross_col\n    right_w = width - cross_col - 1\n    assert top_h > 0 and left_w > 0, \"separator must leave nonempty corner regions\"\n    assert top_h == bottom_h, \"separator row must split equal-height regions\"\n    assert left_w == right_w, \"separator column must split equal-width regions\"\n\n    return [\n        (slice(0, cross_row), slice(0, cross_col)),\n        (slice(0, cross_row), slice(cross_col + 1, width)),\n        (slice(cross_row + 1, height), slice(0, cross_col)),\n        (slice(cross_row + 1, height), slice(cross_col + 1, width)),\n    ]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n","exit_code":0,"status":"completed"}}
