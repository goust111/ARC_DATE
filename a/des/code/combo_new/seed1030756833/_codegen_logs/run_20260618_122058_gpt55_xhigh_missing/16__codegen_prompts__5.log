{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py\"","aggregated_output":"from __future__ import annotations\nimport math\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n\n    Input structure:\n    - bg = background. A large monochrome shape (template, color T).\n    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n    - Singletons sit on a uniform-spacing lattice.\n\n    Rule:\n    - Convert each singleton's offset from the origin into coarse lattice units.\n    - Place a template copy at each offset, scaled by template height/width.\n    - The origin's copy is painted O instead of T.\n    - Any pixel covered by two or more copies is also recolored to O.\n\n    Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    template = max(comps, key=lambda d: int(d[\"area\"]))\n    templ_coords = template[\"coords\"]\n    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n    r0, c0, r1, c1 = map(int, template[\"bbox\"])\n    h = int(bbox_h((r0, c0, r1, c1)))\n    w = int(bbox_w((r0, c0, r1, c1)))\n\n    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n\n    # Singleton layout points (excluding the template component).\n    singletons: list[tuple[int, int, int]] = []\n    for comp in comps:\n        if comp is template:\n            continue\n        if int(comp[\"area\"]) != 1:\n            continue\n        rr, cc = map(int, comp[\"coords\"][0])\n        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n\n    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n    assert not (len(origin) != 1)\n    orr, orc = origin[0]\n\n    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n    assert not (not other_cols)\n    overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n\n    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n    assert gcd_vals\n    gunit = int(math.gcd(*gcd_vals))\n    gunit = max(1, int(gunit))\n    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n\n    total = np.zeros((H, W), dtype=int)\n    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n\n    for dr, dc, col in deltas:\n        off_r = int(dr * h)\n        off_c = int(dc * w)\n        is_origin = int(col) == int(templ_col)\n        for rr, cc in templ_rel:\n            R = int(r0 + off_r + rr)\n            C = int(c0 + off_c + cc)\n            if 0 <= R < H and 0 <= C < W:\n                total[R, C] += 1\n                if is_origin:\n                    center[R, C] += 1\n\n    out = np.full((H, W), int(bg), dtype=int)\n    out[total > 0] = int(templ_col)\n    out[(total == 1) & (center > 0)] = int(overlap_col)\n    out[total >= 2] = int(overlap_col)\n    return out\n\n# --------------- generator (a1) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────\nGRID_SIZE = 22\nTEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\nTEMPLATE_W = 3                    # template bbox width (fixed)\nTEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\nTEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\nSINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\nLATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\nGUNIT = 2                         # singleton spacing in pixels\n\n# Retry budgets\nSPANNING_RETRIES = 40             # attempts per spanning polyomino\nTEMPLATE_RETRIES = 60             # attempts to build a valid template\nSINGLETON_RETRIES = 50            # attempts to place singleton cluster\nGENERATE_RETRIES = 300            # outer retry loop\n\n\ndef _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n    \"\"\"Grow a random 4-connected polyomino of *n* cells in a rows x cols grid.\"\"\"\n    start = (random.randint(0, rows - 1), random.randint(0, cols - 1))\n    cells = {start}\n    frontier = []\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nr, nc = start[0] + dr, start[1] + dc\n        if 0 <= nr < rows and 0 <= nc < cols:\n            frontier.append((nr, nc))\n    while len(cells) < n and frontier:\n        cell = random.choice(frontier)\n        frontier.remove(cell)\n        if cell in cells:\n            continue\n        cells.add(cell)\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr, nc = cell[0] + dr, cell[1] + dc\n            if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:\n                frontier.append((nr, nc))\n    return list(cells) if len(cells) == n else None\n\n\ndef _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n    \"\"\"Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges).\"\"\"\n    for _ in range(SPANNING_RETRIES):\n        cells = _random_polyomino(n, rows, cols)\n        if cells is None:\n            continue\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:\n            return cells\n    return None\n\n\ndef _gen_template(h: int, w: int) -> list[tuple[int, int]] | None:\n    \"\"\"4-connected template shape in h x w, spanning bbox, within area/fill bounds.\"\"\"\n    total = h * w\n    lo = max(TEMPLATE_AREA_RANGE[0], int(np.ceil(total * TEMPLATE_FILL_RANGE[0])))\n    hi = min(TEMPLATE_AREA_RANGE[1], int(np.floor(total * TEMPLATE_FILL_RANGE[1])))\n    if lo > hi:\n        return None\n    for _ in range(TEMPLATE_RETRIES):\n        area = random.randint(lo, hi)\n        cells = _spanning_polyomino(area, h, w)\n        if cells is not None:\n            return cells\n    return None\n\n\ndef _gen_lattice(n: int) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:\n    \"\"\"Lattice polyomino of *n* cells with strictly interior origin.\"\"\"\n    ext_r = random.randint(*LATTICE_EXTENT_RANGE)\n    ext_c = random.randint(*LATTICE_EXTENT_RANGE)\n    cells = _spanning_polyomino(n, ext_r, ext_c)\n    if cells is None:\n        return None\n    interior = [(r, c) for r, c in cells if 0 < r < ext_r - 1 and 0 < c < ext_c - 1]\n    if not interior:\n        return None\n    return cells, random.choice(interior)\n\n\ndef _delta_bounds(deltas: list[tuple[int, int]]):\n    \"\"\"Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets.\"\"\"\n    min_dr = min(dr for dr, dc in deltas)\n    max_dr = max(dr for dr, dc in deltas)\n    min_dc = min(dc for dr, dc in deltas)\n    max_dc = max(dc for dr, dc in deltas)\n    return min_dr, max_dr, min_dc, max_dc\n\n\ndef _place_singletons(\n    deltas, min_dr, max_dr, min_dc, max_dc,\n    templ_cells, r0, c0, h, w, bg, T, O, occupied,\n) -> np.ndarray | None:\n    \"\"\"Try to find a valid singleton cluster position and build the input grid.\"\"\"\n    orr_lo, orr_hi = -min_dr * GUNIT, GRID_SIZE - 1 - max_dr * GUNIT\n    orc_lo, orc_hi = -min_dc * GUNIT, GRID_SIZE - 1 - max_dc * GUNIT\n    if orr_lo > orr_hi or orc_lo > orc_hi:\n        return None\n\n    # Template bbox edges\n    tr0, tr1 = r0, r0 + h - 1\n    tc0, tc1 = c0, c0 + w - 1\n\n    for _ in range(SINGLETON_RETRIES):\n        orr = random.randint(orr_lo, orr_hi)\n        orc = random.randint(orc_lo, orc_hi)\n\n        # Singleton cluster bbox -- must be disjoint from template with >=1 bg cell gap\n        sr0 = orr + min_dr * GUNIT\n        sr1 = orr + max_dr * GUNIT\n        sc0 = orc + min_dc * GUNIT\n        sc1 = orc + max_dc * GUNIT\n        if not (sr1 + 1 < tr0 or tr1 + 1 < sr0 or sc1 + 1 < tc0 or tc1 + 1 < sc0):\n            continue\n\n        # Singletons must not land on stamp pixels\n        if any((orr + dr * GUNIT, orc + dc * GUNIT) in occupied for dr, dc in deltas):\n            continue\n\n        # Build input grid\n        grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)\n        for tr, tc in templ_cells:\n            grid[r0 + tr, c0 + tc] = T\n        for dr, dc in deltas:\n            grid[orr + dr * GUNIT, orc + dc * GUNIT] = T if (dr == 0 and dc == 0) else O\n\n        try:\n            main(grid)\n        except Exception:\n            return None\n        return grid\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt: pick colors, build template + lattice, place stamps + singletons.\"\"\"\n    bg, T, O = random.sample(range(10), 3)\n\n    h = random.choice(TEMPLATE_H_CHOICES)\n    w = TEMPLATE_W\n    templ_cells = _gen_template(h, w)\n    if templ_cells is None:\n        return None\n\n    n_sing = random.randint(*SINGLETON_COUNT_RANGE)\n    lat = _gen_lattice(n_sing)\n    if lat is None:\n        return None\n    lattice_cells, origin = lat\n    deltas = [(r - origin[0], c - origin[1]) for r, c in lattice_cells]\n    min_dr, max_dr, min_dc, max_dc = _delta_bounds(deltas)\n\n    # Compute valid placement window for the template origin\n    r0_lo, r0_hi = -min_dr * h, GRID_SIZE - max_dr * h - h\n    c0_lo, c0_hi = -min_dc * w, GRID_SIZE - max_dc * w - w\n    if r0_lo > r0_hi or c0_lo > c0_hi:\n        return None\n\n    r0 = random.randint(r0_lo, r0_hi)\n    c0 = random.randint(c0_lo, c0_hi)\n\n    # Verify no pixel overlap between stamps\n    occupied = set()\n    for dr, dc in deltas:\n        for tr, tc in templ_cells:\n            pt = (r0 + dr * h + tr, c0 + dc * w + tc)\n            if pt in occupied:\n                return None\n            occupied.add(pt)\n\n    return _place_singletons(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n","exit_code":0,"status":"completed"}}
