{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/ {show=1} show {print} show && /\"'^def generate_input'\"\\\\(/ {in_gen=1} show && in_gen && /\"'^def [A-Za-z_].*'\"\\\\(/ && \"'!/''^def generate_input'\"\\\\(/ {exit}' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n\nBG = 6\nBORDER = 0\nGREY = 5\nORANGE = 7\nHEAD_COLOR = 9\n\n# Direction mapping: head_side -> (dr, dc) movement direction\n# head on top -> container moves up; head on bottom -> moves down, etc.\nSIDE_TO_DIR = {0: (-1, 0), 1: (1, 0), 2: (0, -1), 3: (0, 1)}\n\n\ndef _interior_fill_order(inner_h: int, inner_w: int, head_side: int) -> list[tuple[int, int]]:\n    \"\"\"Return interior cell coords (local to inner rect) in fill order from head-facing side inward.\n    Matches the solver's grey sort keys exactly.\"\"\"\n    cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]\n    if head_side == 3:    # right, direction (0,1): key (-col, row)\n        cells.sort(key=lambda p: (-p[1], p[0]))\n    elif head_side == 2:  # left, direction (0,-1): key (col, -row)\n        cells.sort(key=lambda p: (p[1], -p[0]))\n    elif head_side == 1:  # bottom, direction (1,0): key (-row, -col)\n        cells.sort(key=lambda p: (-p[0], -p[1]))\n    else:                 # top, direction (-1,0): key (row, col)\n        cells.sort(key=lambda p: (p[0], p[1]))\n    return cells\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_containers = random.randint(2, 4)\n    n_decoys = random.choice([0, 0, 1])  # 0 or 1, slight bias toward 0\n    n_movers = n_containers - n_decoys\n    if n_movers < 1:\n        n_movers = 1\n        n_decoys = n_containers - 1\n\n    # Build container specs\n    specs = []\n    for i in range(n_containers):\n        is_decoy = (i >= n_movers)\n        inner_h = random.randint(1, 8)\n        inner_w = random.randint(1, 5)\n        inner_area = inner_h * inner_w\n        head_side = random.randint(0, 3)\n        outer_h = inner_h + 2\n        outer_w = inner_w + 2\n\n        if is_decoy:\n            initial_orange = inner_area\n            grey = 0\n            gap = random.randint(0, 6)\n            steps = 0\n        else:\n            grey = random.randint(1, inner_area)\n            initial_orange = inner_area - grey\n            gap = random.randint(0, 10)\n            h2d = gap + 1\n            steps = min(grey, h2d)\n\n        # Head length = container edge length along head direction\n        if head_side in (0, 1):\n            head_len = outer_w\n        else:\n            head_len = outer_h\n\n        specs.append({\n            'inner_h': inner_h, 'inner_w': inner_w,\n            'outer_h': outer_h, 'outer_w': outer_w,\n            'head_side': head_side, 'gap': gap, 'steps': steps,\n            'initial_orange': initial_orange, 'grey': grey,\n            'head_len': head_len, 'is_decoy': is_decoy,\n        })\n\n    # Compute assembly bounding boxes (in input position)\n    # Assembly = dest_line + gap + head_line + container\n    assemblies = []\n    for s in specs:\n        oh, ow = s['outer_h'], s['outer_w']\n        hs = s['head_side']\n        gap = s['gap']\n\n        if hs == 0:  # top: dest above head above container\n            total_h = 1 + gap + 1 + oh  # dest + gap + head + container\n            total_w = ow\n            cont_r = gap + 2  # container top row within assembly\n            cont_c = 0\n        elif hs == 1:  # bottom: container above head above dest\n            total_h = oh + 1 + gap + 1\n            total_w = ow\n            cont_r = 0\n            cont_c = 0\n        elif hs == 2:  # left: dest left of head left of container\n            total_h = oh\n            total_w = 1 + gap + 1 + ow\n            cont_r = 0\n            cont_c = gap + 2\n        else:  # right: container left of head left of dest\n            total_h = oh\n            total_w = ow + 1 + gap + 1\n            cont_r = 0\n            cont_c = 0\n\n        assemblies.append({**s, 'total_h': total_h, 'total_w': total_w,\n                           'cont_r': cont_r, 'cont_c': cont_c})\n\n    # Determine grid size\n    total_area = sum(a['total_h'] * a['total_w'] for a in assemblies)\n    min_side = max(8, int(total_area ** 0.5) + 2)\n    max_side = min(26, min_side + 8)\n    max_asm_h = max(a['total_h'] for a in assemblies)\n    max_asm_w = max(a['total_w'] for a in assemblies)\n\n    lo_h = max(8, max_asm_h + 2)\n    hi_h = max(lo_h, min(26, max_side + 4))\n    lo_w = max(8, max_asm_w + 2)\n    hi_w = max(lo_w, min(26, max_side + 4))\n\n    if lo_h > 26 or lo_w > 26:\n        return None\n\n    grid_h = random.randint(lo_h, min(26, hi_h))\n    grid_w = random.randint(lo_w, min(26, hi_w))\n\n    # Place assemblies with 1-cell bg gap between them\n    occupied = np.zeros((grid_h, grid_w), dtype=bool)\n    placements = []\n\n    for a in assemblies:\n        th, tw = a['total_h'], a['total_w']\n        if th > grid_h or tw > grid_w:\n            return None\n        placed = False\n        for _ in range(300):\n            r0 = random.randint(0, grid_h - th)\n            c0 = random.randint(0, grid_w - tw)\n            cr0 = max(0, r0 - 1)\n            cc0 = max(0, c0 - 1)\n            cr1 = min(grid_h, r0 + th + 1)\n            cc1 = min(grid_w, c0 + tw + 1)\n            if not occupied[cr0:cr1, cc0:cc1].any():\n                occupied[r0:r0+th, c0:c0+tw] = True\n                placements.append((r0, c0))\n                placed = True\n                break\n        if not placed:\n            return None\n\n    # Build input grid\n    grid = np.full((grid_h, grid_w), BG, dtype=int)\n\n    for a, (pr, pc) in zip(assemblies, placements):\n        oh, ow = a['outer_h'], a['outer_w']\n        hs = a['head_side']\n        gap = a['gap']\n        steps = a['steps']\n        inner_h, inner_w = a['inner_h'], a['inner_w']\n        initial_orange = a['initial_orange']\n\n        # Container top-left in grid coords\n        cr = pr + a['cont_r']\n        cc = pc + a['cont_c']\n\n        # Draw container border\n        grid[cr, cc:cc+ow] = BORDER\n        grid[cr+oh-1, cc:cc+ow] = BORDER\n        grid[cr:cr+oh, cc] = BORDER\n        grid[cr:cr+oh, cc+ow-1] = BORDER\n\n        # Fill interior\n        fill_order = _interior_fill_order(inner_h, inner_w, hs)\n        interior = np.full((inner_h, inner_w), GREY, dtype=int)\n        for idx_cell in range(initial_orange):\n            r, c = fill_order[idx_cell]\n            interior[r, c] = ORANGE\n        grid[cr+1:cr+1+inner_h, cc+1:cc+1+inner_w] = interior\n\n        # Draw head line\n        if hs == 0:\n            grid[cr-1, cc:cc+ow] = HEAD_COLOR\n        elif hs == 1:\n            grid[cr+oh, cc:cc+ow] = HEAD_COLOR\n        elif hs == 2:\n            grid[cr:cr+oh, cc-1] = HEAD_COLOR\n        else:\n            grid[cr:cr+oh, cc+ow] = HEAD_COLOR\n\n        # Draw dest line\n        if hs == 0:\n            grid[cr-2-gap, cc:cc+ow] = HEAD_COLOR\n        elif hs == 1:\n            grid[cr+oh+1+gap, cc:cc+ow] = HEAD_COLOR\n        elif hs == 2:\n            grid[cr:cr+oh, cc-2-gap] = HEAD_COLOR\n        else:\n            grid[cr:cr+oh, cc+ow+1+gap] = HEAD_COLOR\n\n    # Validate with solver\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output manually and compare\n    expected = grid.copy()\n    for a, (pr, pc) in zip(assemblies, placements):\n        oh, ow = a['outer_h'], a['outer_w']\n        hs = a['head_side']\n        steps = a['steps']\n        inner_h, inner_w = a['inner_h'], a['inner_w']\n        initial_orange = a['initial_orange']\n        dr, dc = SIDE_TO_DIR[hs]\n\n        cr = pr + a['cont_r']\n        cc = pc + a['cont_c']\n\n        if steps == 0:\n            continue\n\n        # Erase original container + head\n        expected[cr:cr+oh, cc:cc+ow] = BG\n        if hs == 0:\n            expected[cr-1, cc:cc+ow] = BG\n        elif hs == 1:\n            expected[cr+oh, cc:cc+ow] = BG\n        elif hs == 2:\n            expected[cr:cr+oh, cc-1] = BG\n        else:\n            expected[cr:cr+oh, cc+ow] = BG\n\n        # New position\n        nr = cr + dr * steps\n        nc = cc + dc * steps\n\n        # Build moved container patch with converted cells\n        fill_order = _interior_fill_order(inner_h, inner_w, hs)\n        interior = np.full((inner_h, inner_w), GREY, dtype=int)\n        for idx_cell in range(initial_orange + steps):\n            r, c = fill_order[idx_cell]\n            interior[r, c] = ORANGE\n        patch = np.full((oh, ow), BORDER, dtype=int)\n        patch[1:-1, 1:-1] = interior\n        expected[nr:nr+oh, nc:nc+ow] = patch\n\n        # Move head\n        if hs == 0:\n            expected[nr-1, nc:nc+ow] = HEAD_COLOR\n        elif hs == 1:\n            expected[nr+oh, nc:nc+ow] = HEAD_COLOR\n        elif hs == 2:\n            expected[nr:nr+oh, nc-1] = HEAD_COLOR\n        else:\n            expected[nr:nr+oh, nc+ow] = HEAD_COLOR\n\n    if not np.array_equal(output, expected):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"awk '/\"'^def main'\"\\\\(/ {show=1} show {print} show && /\"'^def generate_input'\"\\\\(/ {in_gen=1} show && in_gen && /\"'^def [A-Za-z_].*'\"\\\\(/ && \"'!/''^def generate_input'\"\\\\(/ {exit}' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n                c0 = random.randint(0, hi)\n            else:\n                lo = paths[-1][r] + SHORT_FRAGMENT_PATH_PADDING\n                if lo + size > W:\n                    continue\n                c0 = random.randint(lo, W - size)\n            coords = [(r, c0 + i) for i in range(size)]\n            if any(grid[rr, cc] != grid[0, 0] for rr, cc in coords):\n                continue\n            if _touches_mask(contour_mask, coords, 8):\n                continue\n            patch = np.full((1, size), contour, dtype=int)\n            paste(grid, patch, r, c0)\n            for rr, cc in coords:\n                contour_mask[rr, cc] = True\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _add_contour_extras(grid: np.ndarray, long_mask: np.ndarray, paths: list[list[int]], contour: int, needed: int) -> bool:\n    if needed < 0:\n        return False\n    candidates: list[tuple[int, int]] = []\n    for side, path_i in [(-1, 0), (1, len(paths) - 1)]:\n        for r, c in enumerate(paths[path_i]):\n            cc = c + side\n            if 0 <= cc < W and grid[r, cc] == grid[0, 0]:\n                candidates.append((r, cc))\n    if needed > len(candidates):\n        return False\n    random.shuffle(candidates)\n    for r, c in candidates[:needed]:\n        grid[r, c] = contour\n        long_mask[r, c] = True\n    return True\n\n\ndef _segments_for_bars(n_bars: int, max_segment: int = BAR_SEGMENT_MAX) -> list[int] | None:\n    segments = [1] * (n_bars + 1)\n    remaining = H - n_bars - len(segments)\n    if remaining < 0:\n        return None\n    while remaining:\n        choices = [i for i, value in enumerate(segments) if value < max_segment]\n        if not choices:\n            return None\n        i = random.choice(choices)\n        add = random.randint(1, min(max_segment - segments[i], remaining))\n        segments[i] += add\n        remaining -= add\n    random.shuffle(segments)\n    return segments\n\n\ndef _bar_rows(n_bars: int) -> list[int] | None:\n    segments = _segments_for_bars(n_bars)\n    if segments is None:\n        return None\n    rows: list[int] = []\n    r = segments[0]\n    for i in range(n_bars):\n        rows.append(r)\n        r += 1 + segments[i + 1]\n    return rows\n\n\ndef _add_obstacle_bars(grid: np.ndarray, paths: list[list[int]], obstacle: int) -> bool:\n    channel_count = len(paths) - 1\n    if channel_count == 1:\n        bars_per_channel = [random.randint(SINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX)]\n    else:\n        total = random.randint(MULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX)\n        bars_per_channel = [MULTI_CHANNEL_INITIAL_BARS, MULTI_CHANNEL_INITIAL_BARS]\n        for _ in range(total - MULTI_CHANNEL_TOTAL_BARS_MIN):\n            choices = [i for i, value in enumerate(bars_per_channel) if value < MULTI_CHANNEL_MAX_BARS]\n            if not choices:\n                break\n            bars_per_channel[random.choice(choices)] += 1\n\n    for channel_i, n_bars in enumerate(bars_per_channel):\n        rows = _bar_rows(n_bars)\n        if rows is None:\n            return False\n        for r in rows:\n            c0 = paths[channel_i][r] + 1\n            c1 = paths[channel_i + 1][r]\n            if c1 - c0 < BAR_WIDTH_MIN or c1 - c0 > BAR_WIDTH_MAX:\n                return False\n            if np.any(grid[r, c0:c1] != grid[0, 0]):\n                return False\n            grid[r, c0:c1] = obstacle\n    return True\n\n\ndef _random_cluster(seed: tuple[int, int], size: int) -> list[tuple[int, int]]:\n    coords = [seed]\n    while len(coords) < size:\n        r, c = random.choice(coords)\n        dr, dc = random.choice(NEIGHBOR_DELTAS_4)\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in coords:\n            coords.append((rr, cc))\n    return coords\n\n\ndef _can_place_obstacle(\n    grid: np.ndarray, obstacle_mask: np.ndarray, contour_mask: np.ndarray, coords: list[tuple[int, int]],\n    bg: int, paths: list[list[int]], zone: str\n) -> bool:\n    if zone == \"outside\" and not all(_outside_enclosure(paths, r, c, OUTSIDE_MARGIN) for r, c in coords):\n        return False\n    if zone == \"inside\" and not all(_inside_channel(paths, r, c) for r, c in coords):\n        return False\n    if any(grid[r, c] != bg for r, c in coords):\n        return False\n    if _touches_mask(obstacle_mask, coords, 4):\n        return False\n    if _touches_mask(contour_mask, coords, 4):\n        return False\n    return True\n\n\ndef _scatter_obstacles(\n    grid: np.ndarray, obstacle_mask: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], bg: int, obstacle: int\n) -> bool:\n    bar_pixels = int(obstacle_mask.sum())\n    low = max(OBSTACLE_PIXELS_MIN, bar_pixels + OBSTACLE_EXTRA_PIXELS_MIN)\n    if low > OBSTACLE_PIXELS_MAX:\n        return False\n    target = random.randint(low, OBSTACLE_PIXELS_MAX)\n    outside_quota = min(target - bar_pixels, random.randint(OBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX))\n\n    while int(obstacle_mask.sum()) < target:\n        remaining = target - int(obstacle_mask.sum())\n        zone = \"outside\" if outside_quota > 0 else random.choice(OBSTACLE_ZONE_OPTIONS)\n        quota_limit = outside_quota if outside_quota > 0 else OBSTACLE_CLUSTER_SIZE_MAX\n        size = random.randint(OBSTACLE_CLUSTER_SIZE_MIN, min(OBSTACLE_CLUSTER_SIZE_MAX, remaining, quota_limit))\n        placed = False\n        for _attempt in range(OBSTACLE_ATTEMPTS):\n            seed = (random.randrange(H), random.randrange(W))\n            coords = _random_cluster(seed, size)\n            if _can_place_obstacle(grid, obstacle_mask, contour_mask, coords, bg, paths, zone):\n                for r, c in coords:\n                    grid[r, c] = obstacle\n                    obstacle_mask[r, c] = True\n                if zone == \"outside\":\n                    outside_quota -= size\n                placed = True\n                break\n        if not placed:\n            return False\n    return True\n\n\ndef _gen_long_component_ids(fill_lab: np.ndarray, n: int) -> set[int]:\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(fill_lab == comp_id)\n        if coords.size == 0:\n            continue\n        if int(coords[:, 0].max()) - int(coords[:, 0].min()) + 1 >= LONG_COMPONENT_MIN_SPAN:\n            ids.add(int(comp_id))\n    return ids\n\n\ndef _fillable_mask(grid: np.ndarray, bg: int, contour: int) -> tuple[np.ndarray, int, set[int], int] | None:\n    fill_lab, n_fill = label_mask(grid == contour, connectivity=8)\n    long_ids = _gen_long_component_ids(fill_lab, n_fill)\n    if len(long_ids) not in LONG_COMPONENT_COUNT_OPTIONS:\n        return None\n\n    bg_lab, n_bg = label_mask(grid == bg, connectivity=4)\n    if n_bg < BG_REGIONS_MIN or n_bg > BG_REGIONS_MAX:\n        return None\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    ranked = sorted(sizes, key=sizes.get, reverse=True)\n    if len(ranked) < 3 or sizes[ranked[1]] <= sizes[ranked[2]]:\n        return None\n    exterior = {int(ranked[0]), int(ranked[1])}\n    interior_count = n_bg - EXTERIOR_REGION_COUNT\n    if not INTERIOR_REGIONS_MIN <= interior_count <= INTERIOR_REGIONS_MAX:\n        return None\n    if any(sizes[comp_id] > INTERIOR_REGION_AREA_MAX for comp_id in range(1, n_bg + 1) if comp_id not in exterior):\n        return None\n\n    fillable = np.zeros_like(grid, dtype=bool)\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        touches = False\n        for r, c in coords:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(fill_lab[rr, cc]) in long_ids:\n                    touches = True\n                    break\n            if touches:\n                break\n        if not touches:\n            return None\n        fillable[bg_lab == comp_id] = True\n    return fillable, n_bg, exterior, len(long_ids)\n\n\ndef _validate(inp: np.ndarray, out: np.ndarray, paths: list[list[int]], bg: int, contour: int, obstacle: int, n_bg: int, long_count: int) -> bool:\n    if not np.array_equal(main(inp), out):\n        return False\n    values = set(int(v) for v in np.unique(inp))\n    if values != {bg, contour, obstacle}:\n        return False\n    contour_count = int((inp == contour).sum())\n    obstacle_count = int((inp == obstacle).sum())\n    if not (CONTOUR_PIXELS_MIN <= contour_count <= CONTOUR_PIXELS_MAX and OBSTACLE_PIXELS_MIN <= obstacle_count <= OBSTACLE_PIXELS_MAX):\n        return False\n    if contour_count <= obstacle_count:\n        return False\n    interior_count = n_bg - EXTERIOR_REGION_COUNT\n    if not (BG_REGIONS_MIN <= n_bg <= BG_REGIONS_MAX and INTERIOR_REGIONS_MIN <= interior_count <= INTERIOR_REGIONS_MAX and long_count in LONG_COMPONENT_COUNT_OPTIONS):\n        return False\n\n    contour_lab, n_contour = label_mask(inp == contour, connectivity=8)\n    short = 0\n    for comp_id in range(1, n_contour + 1):\n        coords = np.argwhere(contour_lab == comp_id)\n        span = int(coords[:, 0].max()) - int(coords[:, 0].min()) + 1\n        area = int(coords.shape[0])\n        if span >= LONG_COMPONENT_MIN_SPAN:\n            continue\n        short += 1\n        if area < SHORT_FRAGMENT_SIZE_MIN or area > SHORT_FRAGMENT_SIZE_MAX:\n            return False\n    if not SHORT_FRAGMENT_COUNT_MIN <= short <= SHORT_FRAGMENT_COUNT_MAX:\n        return False\n\n    obs_lab, n_obs = label_mask(inp == obstacle, connectivity=4)\n    if n_obs == 0:\n        return False\n    if any(int((obs_lab == comp_id).sum()) > OBSTACLE_CLUSTER_SIZE_MAX for comp_id in range(1, n_obs + 1)):\n        return False\n    inside_obs = any(inp[r, c] == obstacle and _inside_channel(paths, r, c) for r in range(H) for c in range(W))\n    outside_obs = any(\n        inp[r, c] == obstacle and _outside_enclosure(paths, r, c, OUTSIDE_MARGIN) for r in range(H) for c in range(W)\n    )\n    return bool(inside_obs and outside_obs)\n\n\ndef _draw_long_contours(bg: int, contour: int, paths: list[list[int]]) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Render the primary path columns and return the grid plus long-contour mask.\"\"\"\n    grid = np.full(GRID_SHAPE, bg, dtype=int)\n    long_mask = np.zeros(GRID_SHAPE, dtype=bool)\n    for path in paths:\n        for r, c in enumerate(path):\n            grid[r, c] = contour\n            long_mask[r, c] = True\n    return grid, long_mask\n\n\ndef _finish_contours(grid: np.ndarray, long_mask: np.ndarray, paths: list[list[int]], contour: int) -> bool:\n    \"\"\"Add short distractors, then pad long contours to the sampled pixel target.\"\"\"\n    contour_mask = grid == contour\n    frag_count = random.randint(SHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX)\n    if not _place_short_fragments(grid, contour_mask, paths, contour, frag_count):\n        return False\n\n    current_contour = int((grid == contour).sum())\n    if current_contour > CONTOUR_PIXELS_MAX:\n        return False\n    target_contour = random.randint(max(CONTOUR_PIXELS_MIN, current_contour), CONTOUR_PIXELS_MAX)\n    return _add_contour_extras(grid, long_mask, paths, contour, target_contour - current_contour)\n\n\ndef _place_obstacles(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], bg: int, obstacle: int\n) -> bool:\n    \"\"\"Place channel bars first, then scatter isolated obstacle clusters.\"\"\"\n    obstacle_mask = np.zeros(GRID_SHAPE, dtype=bool)\n    if not _add_obstacle_bars(grid, paths, obstacle):\n        return False\n    obstacle_mask = grid == obstacle\n    return _scatter_obstacles(grid, obstacle_mask, contour_mask, paths, bg, obstacle)\n\n\ndef _make_input_output(grid: np.ndarray, bg: int, contour: int) -> tuple[np.ndarray, np.ndarray, int, int] | None:\n    \"\"\"Build the output-first pair and carry validation metadata.\"\"\"\n    fill_info = _fillable_mask(grid, bg, contour)\n    if fill_info is None:\n        return None\n    fillable, n_bg, _exterior, long_count = fill_info\n    out = grid.copy()\n    out[fillable] = contour\n    inp = out.copy()\n    inp[fillable] = bg\n    return inp, out, n_bg, long_count\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg, contour, obstacle = _color_choices()\n    path_count = random.choice(PATH_COUNT_OPTIONS)\n    paths = _path_columns(path_count)\n    if paths is None:\n        return None\n\n    grid, long_mask = _draw_long_contours(bg, contour, paths)\n    if not _finish_contours(grid, long_mask, paths, contour):\n        return None\n\n    contour_mask = grid == contour\n    if not _place_obstacles(grid, contour_mask, paths, bg, obstacle):\n        return None\n\n    pair = _make_input_output(grid, bg, contour)\n    if pair is None:\n        return None\n    inp, out, n_bg, long_count = pair\n\n    if not _validate(inp, out, paths, bg, contour, obstacle, n_bg, long_count):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 753ea09b input\")\n","exit_code":0,"status":"completed"}}
