{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\npaths = [\n'/home/lixinyu/snap/new/ARC_code/eval/7c66cb00.py',\n'/home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py',\n'/home/lixinyu/snap/new/ARC_code/eval/31f7f899.py',\n'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py',\n'/home/lixinyu/snap/new/ARC_code/train/18447a8d.py',\n'/home/lixinyu/snap/new/ARC_code/train/2601afb7.py',\n'/home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py',\n'/home/lixinyu/snap/new/ARC_code/train/17829a00.py',\n]\nfor p in paths:\n    text = Path(p).read_text()\n    tree = ast.parse(text)\n    print(f'\\\\n===== {p} =====')\n    for node in tree.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main', 'generate_input'}:\n            seg = ast.get_source_segment(text, node)\n            print(f'\\\\n--- def {node.name} ---')\n            print(seg)\nPY\"","aggregated_output":"\n===== /home/lixinyu/snap/new/ARC_code/eval/7c66cb00.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock two-tone sprites into color-matched horizontal bars with a color swap.\n\n    Input structure:\n    - bg = most common color.\n    - Top area: small two-tone sprites (outer color + inner color).\n    - Below: horizontal bars spanning most of the row, each with a fill color and border color on edges.\n\n    Rule:\n    - Match each sprite to the bar whose fill color equals the sprite's outer color.\n    - Place the sprite at its original x-position, aligned to the bar's bottom.\n    - Recolor: sprite outer → bar border, sprite inner → bar fill.\n    - Erase original sprites from the top area.\n\n    Key insight: Color matching is inverted — the sprite's dominant color identifies its target bar, then gets swapped to the bar's accent color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    out = g.copy()\n    bg = int(Counter(g.flatten()).most_common(1)[0][0])\n\n    # Find bars.\n    bars = []\n    current_bar = None\n    for r in range(H):\n        row = g[int(r), :]\n        non_bg = [int(v) for v in row if int(v) != int(bg)]\n        if non_bg:\n            c = Counter(non_bg)\n            fill_color, count = c.most_common(1)[0]\n            if int(count) > int(W * 0.7):\n                border = int(row[0]) if int(row[0]) != int(fill_color) else int(row[-1])\n                if current_bar and int(current_bar[\"fill\"]) == int(fill_color):\n                    current_bar[\"r_max\"] = int(r)\n                else:\n                    if current_bar:\n                        bars.append(current_bar)\n                    current_bar = {\"fill\": int(fill_color), \"border\": int(border), \"r_min\": int(r), \"r_max\": int(r)}\n            else:\n                if current_bar:\n                    bars.append(current_bar)\n                    current_bar = None\n        else:\n            if current_bar:\n                bars.append(current_bar)\n                current_bar = None\n    if current_bar:\n        bars.append(current_bar)\n\n    assert bars, \"No bars found — grid must contain at least one horizontal bar\"\n\n    pattern_area_end = int(min(int(b[\"r_min\"]) for b in bars))\n\n    # Find patterns in top area: monochrome components by color, but we need full bbox content.\n    patterns = []\n    top = g[:pattern_area_end, :]\n    for col in sorted(set(map(int, top.flatten())) - {int(bg)}):\n        mask = top == int(col)\n        if not bool(mask.any()):\n            continue\n        lab, n = label_mask(mask, connectivity=4)\n        for region_id in range(1, int(n) + 1):\n            coords = np.argwhere(lab == int(region_id))\n            if coords.size == 0:\n                continue\n            b = bbox_coords(coords)\n            r0, c0, r1, c1 = map(int, b)\n            bbox = crop_bbox(g, (r0, c0, r1, c1))\n\n            colors_in_bbox = Counter(map(int, bbox.flatten()))\n            colors_in_bbox.pop(int(bg), None)\n            if not colors_in_bbox:\n                continue\n            outer_color = int(colors_in_bbox.most_common(1)[0][0])\n            inner_colors = [int(c) for c in colors_in_bbox.keys() if int(c) != int(outer_color)]\n            inner_color = int(inner_colors[0]) if inner_colors else None\n\n            patterns.append(\n                {\n                    \"outer_color\": int(outer_color),\n                    \"inner_color\": inner_color,\n                    \"r0\": int(r0),\n                    \"c0\": int(c0),\n                    \"h\": int(bbox.shape[0]),\n                    \"w\": int(bbox.shape[1]),\n                    \"content\": bbox,\n                }\n            )\n\n    # Clear patterns from output.\n    out[:pattern_area_end, :] = np.where(out[:pattern_area_end, :] != int(bg), int(bg), out[:pattern_area_end, :])\n\n    # Match and place patterns.\n    for bar in bars:\n        matching = [p for p in patterns if int(p[\"outer_color\"]) == int(bar[\"fill\"])]\n        for pat in matching:\n            transformed = np.array(pat[\"content\"], dtype=int).copy()\n            for rr in range(int(pat[\"h\"])):\n                for cc in range(int(pat[\"w\"])):\n                    v = int(transformed[int(rr), int(cc)])\n                    if v == int(pat[\"outer_color\"]):\n                        transformed[int(rr), int(cc)] = int(bar[\"border\"])\n                    elif pat[\"inner_color\"] is not None and v == int(pat[\"inner_color\"]):\n                        transformed[int(rr), int(cc)] = int(bar[\"fill\"])\n\n            place_r = int(bar[\"r_max\"] - pat[\"h\"] + 1)\n            place_c = int(pat[\"c0\"])\n            paste(out, transformed, place_r, place_c, transparent=int(bg))\n\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n\n    Input structure\n    The grid has a dominant background color and foreground objects in the task\n    palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n    8-connected components; some palette colors may be absent.\n\n    Rule\n    For each palette color in order grey, red, teal, maroon, pink, count its\n    8-connected objects. Create a background grid with five columns and height\n    equal to the largest count, then fill each column upward from the bottom\n    with its palette color for that count.\n\n    Key insight\n    The output does not preserve object shapes or positions; it is a histogram\n    of per-color 8-connected object counts, using the learned palette order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    palette_set = set(PALETTE_ORDER)\n    assert bg not in palette_set, \"background must not be a histogram color\"\n    assert set(map(int, g.ravel())) <= palette_set | {bg}\n\n    object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n    max_count = max(object_counts)\n    assert max_count > 0, \"expected at least one foreground object\"\n\n    out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n    for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n        if count:\n            out[-count:, c] = color\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_TRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_TRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/31f7f899.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort vertical bars by height and redistribute them across fixed colored slots.\n\n    Input structure:\n    - bg background; a horizontal base line of a single color spans the full grid width.\n    - Several monochrome vertical bars of distinct colors rise upward from the base line.\n\n    Rule:\n    - Rank bar shapes by height (shortest to tallest).\n    - Rank original x-positions (slots) left to right.\n    - Place the i-th shortest shape into the i-th leftmost slot, recoloring it to that slot's original color.\n    - The base line is preserved unchanged.\n\n    Key insight: Each slot keeps its x-position and color identity; only the bar silhouettes are redistributed among slots by height order.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Base row/color = (row,color) with maximal count on that row (excluding bg).\n    best = None  # (count, row, color)\n    for r in range(H):\n        vals, counts = np.unique(g[r, :], return_counts=True)\n        for v, cnt in zip(vals, counts):\n            v = int(v)\n            cnt = int(cnt)\n            if v == bg:\n                continue\n            if best is None or cnt > best[0]:\n                best = (cnt, int(r), int(v))\n    assert not (best is None)\n    _cnt, base_r, base_col = best\n\n    objects: list[dict[str, object]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in {int(bg), int(base_col)}:\n            continue\n\n        pts = comp[\"coords\"]\n        b = comp[\"bbox\"]\n        height = int(bbox_h(b))\n\n        base_cols = sorted(int(c) for r, c in pts if int(r) == int(base_r))\n        if base_cols:\n            anchor = int(base_cols[len(base_cols) // 2])\n        else:\n            cols_sorted = sorted(int(c) for _r, c in pts)\n            anchor = int(cols_sorted[len(cols_sorted) // 2])\n\n        rel = [(int(r) - int(base_r), int(c) - int(anchor)) for r, c in pts]\n        objects.append(\n            {\n                \"color\": int(col),\n                \"anchor\": int(anchor),\n                \"height\": int(height),\n                \"size\": int(len(rel)),\n                \"rel\": rel,\n            }\n        )\n\n    # Slots are determined by original x-positions; slot colors must be preserved.\n    slots = sorted(objects, key=lambda o: (int(o[\"anchor\"]), int(o[\"color\"])))\n    # Shapes are ordered by height (shortest -> tallest).\n    shapes = sorted(objects, key=lambda o: (int(o[\"height\"]), int(o[\"size\"]), int(o[\"anchor\"]), int(o[\"color\"])))\n\n    out = np.full_like(g, bg)\n    out[int(base_r), :] = int(base_col)\n\n    for slot, shape in zip(slots, shapes):\n        slot_col = int(slot[\"color\"])\n        slot_anchor = int(slot[\"anchor\"])\n        for dr, dc in shape[\"rel\"]:\n            rr = int(base_r) + int(dr)\n            cc = int(slot_anchor) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W:\n                out[rr, cc] = int(slot_col)\n\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input failed after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n\n    Input structure:\n    - bg = most common color.\n    - Several multicolor connected components (8-connected) scattered across the grid.\n\n    Rule:\n    - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n    - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n    - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n    - Horizontal position (left column) is preserved; only vertical translation changes.\n\n    Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    extracted = []\n    for comp in comps:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (r0, c0, r1, c1))\n\n        # Isolate this component exactly (bbox rectangle may include background).\n        rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n        m = mask_from_coords(rel_coords, patch.shape)\n        pat = np.full_like(patch, bg)\n        pat[m] = patch[m]\n\n        extracted.append(\n            {\n                \"c0\": int(c0),\n                \"pat\": pat,\n                \"shape_key\": canonical_shape_key(m),\n            }\n        )\n\n    freq = Counter(d[\"shape_key\"] for d in extracted)\n    out = np.full((H, W), int(bg), dtype=int)\n\n    for d in extracted:\n        pat = d[\"pat\"]\n        h, w = map(int, pat.shape)\n        dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n        dest_c0 = int(d[\"c0\"])\n        paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/18447a8d.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each right-side colored shape into the left slot whose template color is its exact complement.\n\n    Input structure:\n    - The grid has two equal-width slots separated by one background column.\n    - Non-background rows form horizontal bands separated by all-background rows.\n    - Each band has a shared template color in the left slot and one colored source shape in the right slot.\n\n    Rule:\n    - For each band, define its destination shape as the cells in the left slot not occupied by the template color.\n    - Normalize every right-side source shape to right-slot coordinates and match it to the unique equal destination shape.\n    - Clear the original right-side source pixels and paint the matched left-slot complement with the source color.\n\n    Key insight:\n    The right-side objects are not placed by row order; each one completes the unique left template whose missing cells have the same shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    assert w % 2 == 1, \"canvas must contain two equal slots plus one separator column\"\n    slot_w = w // 2\n    sep_c = slot_w\n\n    bands = _active_row_spans(g, bg)\n    assert bands, \"grid must contain at least one active band\"\n\n    band_color_sets: list[set[int]] = []\n    for r0, r1 in bands:\n        colors = set(map(int, g[r0 : r1 + 1].ravel())) - {bg}\n        assert colors, \"each active band must contain foreground colors\"\n        band_color_sets.append(colors)\n\n    shared_colors = set.intersection(*band_color_sets)\n    assert len(shared_colors) == 1, \"template color must be the only color shared by all bands\"\n    template_color = next(iter(shared_colors))\n\n    dest_shapes: list[CoordSet] = []\n    sources: list[tuple[int, CoordSet]] = []\n    for band_i, (r0, r1) in enumerate(bands):\n        block = g[r0 : r1 + 1]\n        assert np.all(block[:, sep_c] == bg), \"slot separator column must be background\"\n\n        left = block[:, :slot_w]\n        right = block[:, sep_c + 1 :]\n        assert np.all((left == bg) | (left == template_color)), \"left slot must contain only template and background\"\n\n        template_mask = left == template_color\n        for row in template_mask:\n            cols = np.flatnonzero(row)\n            assert cols.size > 0, \"each template row must contain at least one pixel\"\n            expected = np.arange(int(cols[-1]) + 1)\n            assert np.array_equal(cols, expected), \"template pixels must be a left-anchored row prefix\"\n\n        dest_shapes.append(_coords(~template_mask))\n\n        source_mask = right != bg\n        assert np.any(source_mask), f\"band {band_i} source shape must be non-empty\"\n        source_colors = set(map(int, right[source_mask].ravel()))\n        assert len(source_colors) == 1, \"each right slot must contain exactly one source color\"\n        source_color = next(iter(source_colors))\n        assert source_color != template_color, \"source color must differ from template color\"\n        source_shape = _coords(source_mask)\n        sources.append((source_color, source_shape))\n\n    out = g.copy()\n    for r0, r1 in bands:\n        right = out[r0 : r1 + 1, sep_c + 1 :]\n        right[right != bg] = bg\n\n    used_destinations: set[int] = set()\n    for source_color, source_shape in sources:\n        matches = [i for i, dest_shape in enumerate(dest_shapes) if dest_shape == source_shape]\n        assert len(matches) == 1, \"each source shape must match exactly one left-slot complement\"\n        dest_i = matches[0]\n        assert dest_i not in used_destinations, \"each destination complement must be filled once\"\n        used_destinations.add(dest_i)\n\n        dest_r0, _ = bands[dest_i]\n        for dr, dc in source_shape:\n            rr = dest_r0 + dr\n            assert out[rr, dc] == bg, \"matched complement cells must be empty before painting\"\n            out[rr, dc] = source_color\n\n    assert len(used_destinations) == len(bands), \"all destination complements must be filled\"\n    assert out.shape == (h, w)\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/2601afb7.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap every sprite to the opposite prototype while preserving scale and position.\n\n    Input structure:\n    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n\n    Rule:\n    - Identify the two prototype patterns from the smallest-area sprites.\n    - For each sprite, determine which prototype it matches and its integer scale factor.\n    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n\n    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=8)\n    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n\n    # Extract sprite records.\n    sprites = []\n    for pts in comps:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n\n    # Determine two base prototypes from the smallest bbox area sprites.\n    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    min_area = min(areas)\n    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    for s in base:\n        key = tuple(s[\"arr\"].ravel().tolist())\n        if key not in uniq:\n            uniq[key] = s[\"arr\"]\n    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n\n    proto_keys = list(uniq.keys())[:2]\n    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n\n    anc0 = _pick_anchor_bbox(protos[0], bg)\n    anc1 = _pick_anchor_bbox(protos[1], bg)\n    a0r0, a0c0, a0r1, a0c1 = anc0\n    base_anc_h = a0r1 - a0r0 + 1\n    base_anc_w = a0c1 - a0c0 + 1\n\n    out = g.copy()\n\n    for s in sprites:\n        r0, c0, r1, c1 = s[\"bbox\"]\n        arr = s[\"arr\"]\n        anc = _pick_anchor_bbox(arr, bg)\n        ar0, ac0, ar1, ac1 = anc\n        inst_anc_h = ar1 - ar0 + 1\n        inst_anc_w = ac1 - ac0 + 1\n        # infer integer scale\n        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n        scale = int(max(scale_h, scale_w))\n\n        # score which prototype matches this sprite when aligned by core bbox\n        best_idx = 0\n        best_score = -1\n        for idx, p in enumerate(protos):\n            sp = _scale_nn(p, scale)\n            panc = _pick_anchor_bbox(p, bg)\n            pr0, pc0, pr1, pc1 = panc\n            pr0 *= scale\n            pc0 *= scale\n            # align anchor top-left to instance anchor top-left (global coords)\n            top = (r0 + ar0) - pr0\n            left = (c0 + ac0) - pc0\n\n            # overlap score: count matching non-bg pixels where prototype expects non-bg\n            score = 0\n            ph, pw = sp.shape\n            rr0 = max(0, top)\n            cc0 = max(0, left)\n            rr1 = min(h, top + ph)\n            cc1 = min(w, left + pw)\n            if rr0 >= rr1 or cc0 >= cc1:\n                continue\n            sub_g = g[rr0:rr1, cc0:cc1]\n            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n            m = sub_p != bg\n            if np.any(m):\n                score = int(np.sum(sub_g[m] == sub_p[m]))\n            if score > best_score:\n                best_score = score\n                best_idx = idx\n\n        repl_idx = 1 - best_idx\n\n        # Clear current sprite pixels.\n        for rr, cc in s[\"pts\"]:\n            out[rr, cc] = bg\n\n        # Place replacement.\n        p = protos[repl_idx]\n        sp = _scale_nn(p, scale)\n        panc = _pick_anchor_bbox(p, bg)\n        pr0, pc0, pr1, pc1 = panc\n        pr0 *= scale\n        pc0 *= scale\n        top = (r0 + ar0) - pr0\n        left = (c0 + ac0) - pc0\n\n        ph, pw = sp.shape\n        rr0 = max(0, top)\n        cc0 = max(0, left)\n        rr1 = min(h, top + ph)\n        cc1 = min(w, left + pw)\n        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n        m = sub_p != bg\n        out_slice = out[rr0:rr1, cc0:cc1]\n        out_slice[m] = sub_p[m]\n        out[rr0:rr1, cc0:cc1] = out_slice\n\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid c7f57c3e input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/17829a00.py =====\n\n--- def main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each colored object vertically until it touches the matching top or bottom border bar.\n\n    Input structure:\n    - The background is the dominant color.\n    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n\n    Rule:\n    - Top-bar-colored objects move upward so their bbox top is row 1.\n    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n\n    Key insight:\n    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 1\n\n    bg = int(get_bg(g))\n    top_color = int(g[0, 0])\n    bottom_color = int(g[h - 1, 0])\n\n    assert top_color != bg\n    assert bottom_color != bg\n    assert top_color != bottom_color\n    assert bool(np.all(g[0, :] == top_color))\n    assert bool(np.all(g[h - 1, :] == bottom_color))\n    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}\n\n    for c in range(w):\n        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]\n        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]\n        if top_rows and bot_rows:\n            assert max(top_rows) < min(bot_rows), \"top-color objects must be above bottom-color objects in every column\"\n\n    out = np.full_like(g, bg)\n    out[0, :] = top_color\n    out[h - 1, :] = bottom_color\n\n    for color, target_side in ((top_color, \"top\"), (bottom_color, \"bottom\")):\n        components = find_components(\n            g,\n            bg=bg,\n            connectivity=8,\n            monochromatic=True,\n            colors=[color],\n            return_format=\"dict\",\n        )\n        for comp in components:\n            if _is_full_width_border(comp, h, w):\n                continue\n\n            coords = np.asarray(comp[\"coords\"], dtype=int)\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            assert 0 < r0 <= r1 < h - 1\n\n            if target_side == \"top\":\n                dr = 1 - r0\n                assert dr <= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n            else:\n                dr = (h - 2) - r1\n                assert dr >= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n                if dr > 0 and r0 + dr <= r1:\n                    assert c0 == c1\n                    rows = np.arange(r0, r1 + dr + 1, dtype=int)\n                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n\n            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n            out[paint[:, 0], paint[:, 1]] = color\n\n    return out\n\n--- def generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 17829a00 input\")\n","exit_code":0,"status":"completed"}}
