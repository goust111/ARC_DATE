{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/78e78cff.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the row-wise passage indicated by wall pixels with the singleton marker color.\n\n    Input structure:\n    - A dominant background contains one singleton marker pixel and one wall color.\n    - Wall pixels lie on several rows and form left/right limits around the marker column.\n    - Empty rows between the top and bottom wall rows are open horizontal passages.\n\n    Rule:\n    - On a wall row, paint background pixels between the nearest wall strictly\n      left of the marker column and the nearest wall at or right of it; if only\n      one side is present, paint from that wall to the opposite grid edge.\n    - On empty rows between the top and bottom wall rows, paint the whole row.\n    - On empty rows outside the wall-row band, reuse the nearest end wall-row interval.\n    - Preserve wall pixels and the original marker pixel.\n\n    Key insight:\n    - The wall color defines scanline limits relative to the marker column; the\n      marker color fills those implied horizontal spans rather than flood-filling\n      through connected background.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 2, \"expected exactly a marker color and a wall color\"\n\n    marker_colors = [color for color in fg_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(marker_colors) == 1, \"expected a unique singleton marker color\"\n    marker_color = int(marker_colors[0])\n    wall_colors = [color for color in fg_colors if int(color) != marker_color]\n    assert len(wall_colors) == 1, \"expected one wall color\"\n    wall_color = int(wall_colors[0])\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2), \"expected exactly one marker pixel\"\n    marker_row, marker_col = map(int, marker_coords[0])\n    _assert_wall_connectivity(g, wall_color, marker_col)\n\n    row_intervals: dict[int, tuple[int, int]] = {}\n    for r in range(height):\n        wall_cols = np.flatnonzero(g[r] == wall_color)\n        if wall_cols.size:\n            row_intervals[int(r)] = _wall_row_interval(wall_cols, marker_col, width)\n\n    assert row_intervals, \"expected at least one wall row\"\n    top_wall_row = min(row_intervals)\n    bottom_wall_row = max(row_intervals)\n    assert top_wall_row <= marker_row <= bottom_wall_row, \"marker must lie within the wall-row band\"\n\n    out = g.copy()\n    for r in range(height):\n        if r in row_intervals:\n            start, stop = row_intervals[r]\n        elif top_wall_row < r < bottom_wall_row:\n            start, stop = 0, int(width) - 1\n        elif r < top_wall_row:\n            start, stop = row_intervals[top_wall_row]\n        else:\n            start, stop = row_intervals[bottom_wall_row]\n\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nfrom arc_utils import components_mask\n\n# Canvas and band choices.\nHEIGHT_BAND_EMPTY_OPTIONS = ((11, 5, 1), (11, 6, 1), (11, 6, 2), (12, 6, 1), (12, 6, 2), (12, 7, 1), (12, 7, 2))\nGRID_WIDTH_RANGE = (11, 12)\nBAND_TOP_ROW = 2\n\n# Palette and marker placement.\nCOLOR_IDS = range(10)\nCOLOR_COUNT = 3\nMARKER_COL_RANGE = (3, 8)\n\n# Wall shape and pixel-count controls.\nWALL_PIXEL_RANGE = (8, 14)\nBASE_WALL_OFFSET = 1\nPEAK_WALL_OFFSET_MIN = 2\nSIDE_BLOCK_MAX_LEN = 2\nEXPECTED_WALL_COMPONENTS = 4\nONE_SIDED_ROW_PROB = 0.25\nONE_SIDED_OPTIONS = (\"left\", \"right\")\n\nGENERATION_RETRIES = 300\n\n\ndef _wall_interval(wall_cols: list[int], marker_col: int, width: int) -> tuple[int, int]:\n    left = [c for c in wall_cols if c < marker_col]\n    right = [c for c in wall_cols if c > marker_col]\n    if left and right:\n        return max(left) + 1, min(right) - 1\n    if left:\n        return max(left) + 1, width - 1\n    return 0, min(right) - 1\n\n\ndef _expected_output(grid, bg, marker, intervals, top, bottom):\n    \"\"\"Return the solver output implied by the generated wall intervals.\"\"\"\n    height, width = grid.shape\n    out = grid.copy()\n    for r in range(height):\n        if r in intervals:\n            start, stop = intervals[r]\n        elif top < r < bottom:\n            start, stop = 0, width - 1\n        elif r < top:\n            start, stop = intervals[top]\n        else:\n            start, stop = intervals[bottom]\n        span = out[r, start : stop + 1]\n        span[span == bg] = marker\n    return out\n\n\ndef _center_empty_rows(top: int, band_len: int, empty_count: int) -> set[int]:\n    bottom = top + band_len - 1\n    if empty_count == 1:\n        if band_len % 2:\n            return {(top + bottom) // 2}\n        return {random.choice([(top + bottom) // 2, (top + bottom) // 2 + 1])}\n    if band_len % 2:\n        mid = (top + bottom) // 2\n        return set(random.choice([(mid - 1, mid), (mid, mid + 1)]))\n    mid = (top + bottom) // 2\n    return {mid, mid + 1}\n\n\ndef _peak_offsets(wall_rows: list[int], top: int, bottom: int, maximum: int) -> dict[int, int]:\n    max_depth = max(min(r - top, bottom - r) for r in wall_rows)\n    if max_depth == 0:\n        return {r: BASE_WALL_OFFSET for r in wall_rows}\n    peak = random.randint(PEAK_WALL_OFFSET_MIN, min(maximum, BASE_WALL_OFFSET + max_depth))\n    offsets = {}\n    for r in wall_rows:\n        depth = min(r - top, bottom - r)\n        offsets[r] = BASE_WALL_OFFSET + round((peak - BASE_WALL_OFFSET) * depth / max_depth)\n    return offsets\n\n\ndef _wall_component_count(wall_cols_by_row: dict[int, list[int]]) -> int:\n    max_row = max(wall_cols_by_row)\n    max_col = max(c for cols in wall_cols_by_row.values() for c in cols)\n    mask = np.zeros((max_row + 1, max_col + 1), dtype=bool)\n    for r, cols in wall_cols_by_row.items():\n        mask[r, cols] = True\n    return len(components_mask(mask, connectivity=8))\n\n\ndef _cols_on_side(cols: list[int], marker_col: int, side: str) -> list[int]:\n    if side == \"left\":\n        return [c for c in cols if c < marker_col]\n    return [c for c in cols if c > marker_col]\n\n\ndef _wall_has_intended_connectivity(wall_cols_by_row: dict[int, list[int]], marker_col: int) -> bool:\n    if _wall_component_count(wall_cols_by_row) != EXPECTED_WALL_COMPONENTS:\n        return False\n\n    for r in sorted(wall_cols_by_row):\n        if r - 1 not in wall_cols_by_row:\n            continue\n        prev_cols = wall_cols_by_row[r - 1]\n        cols = wall_cols_by_row[r]\n        for side in ONE_SIDED_OPTIONS:\n            prev_side = _cols_on_side(prev_cols, marker_col, side)\n            curr_side = _cols_on_side(cols, marker_col, side)\n            if prev_side and curr_side and min(abs(a - b) for a in prev_side for b in curr_side) > 1:\n                return False\n    return True\n\n\ndef _sample_scene() -> tuple[int, int, int, int, int, int, int, int, int, list[int]]:\n    height, band_len, empty_count = random.choice(HEIGHT_BAND_EMPTY_OPTIONS)\n    width = random.randint(*GRID_WIDTH_RANGE)\n    top = BAND_TOP_ROW\n    bottom = top + band_len - 1\n\n    bg, wall, marker = random.sample(COLOR_IDS, COLOR_COUNT)\n    marker_col = random.randint(*MARKER_COL_RANGE)\n    marker_row = random.randint(top, bottom)\n\n    empty_rows = _center_empty_rows(top, band_len, empty_count)\n    wall_rows = [r for r in range(top, bottom + 1) if r not in empty_rows]\n    return height, width, top, bottom, bg, wall, marker, marker_row, marker_col, wall_rows\n\n\ndef _wall_side_specs(wall_rows, top, bottom, marker_col, width):\n    \"\"\"Choose side presence and wall boundaries for each non-empty band row.\"\"\"\n    side_mode = {r: \"both\" for r in wall_rows}\n    inner_wall_rows = [r for r in wall_rows if r not in (top, bottom)]\n    if inner_wall_rows and random.random() < ONE_SIDED_ROW_PROB:\n        side_mode[random.choice(inner_wall_rows)] = random.choice(ONE_SIDED_OPTIONS)\n    left_offsets = _peak_offsets(wall_rows, top, bottom, marker_col)\n    right_offsets = _peak_offsets(wall_rows, top, bottom, width - marker_col - 1)\n\n    sides: list[tuple[int, str, int, int]] = []\n    for r in wall_rows:\n        if side_mode[r] in (\"both\", \"left\"):\n            boundary = marker_col - left_offsets[r]\n            sides.append((r, \"left\", boundary, min(SIDE_BLOCK_MAX_LEN, boundary + 1)))\n        if side_mode[r] in (\"both\", \"right\"):\n            boundary = marker_col + right_offsets[r]\n            sides.append((r, \"right\", boundary, min(SIDE_BLOCK_MAX_LEN, width - boundary)))\n    return sides\n\n\ndef _choose_extra_side_pixels(sides: list[tuple[int, str, int, int]]) -> set[tuple[int, str, int]] | None:\n    base_pixels = len(sides)\n    extra_slots = [(r, side, boundary) for r, side, boundary, capacity in sides if capacity >= SIDE_BLOCK_MAX_LEN]\n    min_total = max(WALL_PIXEL_RANGE[0], base_pixels)\n    max_total = min(WALL_PIXEL_RANGE[1], base_pixels + len(extra_slots))\n    if min_total > max_total:\n        return None\n    target_pixels = random.randint(min_total, max_total)\n    extra_count = target_pixels - base_pixels\n    return set(random.sample(extra_slots, extra_count))\n\n\ndef _design_wall_columns(wall_rows, top, bottom, marker_col, width):\n    \"\"\"Assign one or two wall pixels to each selected side boundary.\"\"\"\n    sides = _wall_side_specs(wall_rows, top, bottom, marker_col, width)\n    extra_set = _choose_extra_side_pixels(sides)\n    if extra_set is None:\n        return None\n\n    wall_cols_by_row: dict[int, list[int]] = {r: [] for r in wall_rows}\n    for r, side, boundary, _capacity in sides:\n        length = SIDE_BLOCK_MAX_LEN if (r, side, boundary) in extra_set else 1\n        if side == \"left\":\n            wall_cols_by_row[r].extend(range(boundary - length + 1, boundary + 1))\n        else:\n            wall_cols_by_row[r].extend(range(boundary, boundary + length))\n    return wall_cols_by_row\n\n\ndef _render_grid(height, width, bg, wall, marker, marker_row, marker_col, wall_rows, wall_cols_by_row):\n    \"\"\"Paint wall pixels and return row intervals used by the oracle check.\"\"\"\n    grid = np.full((height, width), bg, dtype=int)\n    intervals: dict[int, tuple[int, int]] = {}\n    for r in wall_rows:\n        cols = sorted(wall_cols_by_row[r])\n        grid[r, cols] = wall\n        intervals[r] = _wall_interval(cols, marker_col, width)\n    grid[marker_row, marker_col] = marker\n    return grid, intervals\n\n\ndef _passes_oracle_check(grid, bg, marker, intervals, top, bottom):\n    expected = _expected_output(grid, bg, marker, intervals, top, bottom)\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, expected))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    height, width, top, bottom, bg, wall, marker, marker_row, marker_col, wall_rows = _sample_scene()\n\n    wall_cols_by_row = _design_wall_columns(wall_rows, top, bottom, marker_col, width)\n    if wall_cols_by_row is None or not _wall_has_intended_connectivity(wall_cols_by_row, marker_col):\n        return None\n\n    grid, intervals = _render_grid(height, width, bg, wall, marker, marker_row, marker_col, wall_rows, wall_cols_by_row)\n    if not _passes_oracle_check(grid, bg, marker, intervals, top, bottom):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 78e78cff input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py && sed -n '/def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n        lo_b1 = max(min_len, total_gray - max_len)\n        hi_b1 = min(total_gray - min_len, max_len)\n        if lo_b1 > hi_b1:\n            return None\n        b1 = random.randint(lo_b1, hi_b1)\n        return [b1, total_gray - b1]\n    if total_gray > max_len:\n        return None\n    return [total_gray]\n\n\ndef _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n    placed_bars = []\n    for bl in bar_lengths:\n        sides = []\n        if span0 - lo_bound >= bl:\n            sides.append(0)\n        if hi_bound - span1 >= bl:\n            sides.append(1)\n        random.shuffle(sides)\n        placed = False\n        for s in sides:\n            b0 = (span0 - bl) if s == 0 else (span1 + 1)\n            b1 = b0 + bl - 1\n            cells = occupied[fixed, b0:b1+1] if axis == 'h' else occupied[b0:b1+1, fixed]\n            if b0 < lo_bound or b1 > hi_bound or cells.any():\n                continue\n            if axis == 'h':\n                occupied[fixed, b0:b1+1] = True\n                placed_bars.append(('h', fixed, b0, b1))\n            else:\n                occupied[b0:b1+1, fixed] = True\n                placed_bars.append(('v', b0, b1, fixed))\n            placed = True\n            break\n        if not placed:\n            return None\n    return placed_bars\n\n\ndef _plan_bars(orange_rects, touched_list, bpo, content_box, occupied):\n    \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n    cr0, cc0, cr1, cc1 = content_box\n    bars_info = []\n    for idx, oi in enumerate(touched_list):\n        edge, or0, oc0, or1, oc1 = orange_rects[oi]\n        oh, ow = or1 - or0 + 1, oc1 - oc0 + 1\n        n_bars = bpo[idx]\n\n        if edge in HORIZONTAL_EDGES:\n            max_stripes, divisor = oh, ow\n        else:\n            max_stripes, divisor = ow, oh\n\n        stripe_count = random.randint(1, max_stripes)\n        total_gray = stripe_count * divisor\n        bar_lengths = _split_bar_lengths(total_gray, n_bars)\n        if bar_lengths is None:\n            return None\n\n        if edge == 'top':\n            bar_rc = or0\n        elif edge == 'bottom':\n            bar_rc = or1\n        elif edge == 'left':\n            bar_rc = oc0\n        else:\n            bar_rc = oc1\n        if edge in HORIZONTAL_EDGES:\n            placed_bars = _place_bars('h', bar_rc, oc0, oc1, cc0, cc1, bar_lengths, occupied)\n        else:\n            placed_bars = _place_bars('v', bar_rc, or0, or1, cr0, cr1, bar_lengths, occupied)\n        if placed_bars is None:\n            return None\n\n        bars_info.append((oi, placed_bars, edge, stripe_count))\n    return bars_info\n\n\ndef _render_input_grid(grid, orange_rects, bars_info):\n    for _, or0, oc0, or1, oc1 in orange_rects:\n        grid[or0:or1+1, oc0:oc1+1] = Color.ORANGE\n    for _, bars, _, _ in bars_info:\n        for bar in bars:\n            if bar[0] == 'h':\n                grid[bar[1], bar[2]:bar[3]+1] = Color.GRAY\n            else:\n                grid[bar[1]:bar[2]+1, bar[3]] = Color.GRAY\n\n\ndef _expected_output(grid, orange_rects, bars_info):\n    expected = grid.copy()\n    expected[grid == Color.GRAY] = Color.YELLOW\n    for oi, _, contact_side, stripe_count in bars_info:\n        _, or0, oc0, or1, oc1 = orange_rects[oi]\n        if contact_side == 'top':\n            expected[or0:or0+stripe_count, oc0:oc1+1] = Color.GRAY\n        elif contact_side == 'bottom':\n            expected[or1-stripe_count+1:or1+1, oc0:oc1+1] = Color.GRAY\n        elif contact_side == 'left':\n            expected[or0:or1+1, oc0:oc0+stripe_count] = Color.GRAY\n        else:\n            expected[or0:or1+1, oc1-stripe_count+1:oc1+1] = Color.GRAY\n    return expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    canvas = _make_canvas()\n    if canvas is None:\n        return None\n    grid, content_box = canvas\n    occupied = np.zeros(grid.shape, dtype=bool)\n\n    orange_rects = _place_oranges(content_box, occupied)\n    if orange_rects is None:\n        return None\n\n    touched_list = _choose_touched_oranges(len(orange_rects))\n    bpo = _choose_bars_per_orange(touched_list)\n    if bpo is None:\n        return None\n\n    bars_info = _plan_bars(orange_rects, touched_list, bpo, content_box, occupied)\n    if bars_info is None:\n        return None\n\n    _render_input_grid(grid, orange_rects, bars_info)\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(output, _expected_output(grid, orange_rects, bars_info)):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
