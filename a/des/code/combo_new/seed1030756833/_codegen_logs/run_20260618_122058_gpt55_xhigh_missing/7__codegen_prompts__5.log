{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/a2d730bd.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend each solid foreground rectangle toward its same-color isolated pixels with capped one-cell paths, clearing each original marker pixel.\n\n    Input structure\n    - The background is the dominant color.\n    - Each foreground color has exactly one solid rectangular object and one or more isolated same-color marker pixels.\n    - Every marker is horizontally or vertically aligned with the rectangle bbox and lies outside it.\n    Rule\n    - For each marker, draw a one-cell-wide straight path from the adjacent side of the rectangle through one cell beyond the marker.\n    - Add a three-pixel perpendicular cap at the rectangle end and around the marker endpoint.\n    - Recolor the original marker pixel to background.\n    Key insight\n    - The isolated pixels are not copied; they mark the hollow endpoints of capped protrusions grown from their matching rectangle.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components\n\n    by_color: dict[int, list[dict]] = {}\n    for comp in components:\n        by_color.setdefault(int(comp[\"color\"]), []).append(comp)\n\n    claims: dict[Coord, int] = {}\n    clears: set[Coord] = set()\n\n    for color, comps in by_color.items():\n        rectangles = [comp for comp in comps if int(comp[\"area\"]) > 1]\n        markers = [comp for comp in comps if int(comp[\"area\"]) == 1]\n        assert len(rectangles) == 1, (color, [(comp[\"area\"], comp[\"bbox\"]) for comp in comps])\n        assert markers and len(rectangles) + len(markers) == len(comps)\n\n        rect = rectangles[0]\n        r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(rect[\"area\"]) == rect_h * rect_w\n        assert min(rect_h, rect_w) >= 2\n\n        for marker in markers:\n            mr, mc = map(int, marker[\"coords\"][0])\n            horizontal = r0 <= mr <= r1 and (mc < c0 or mc > c1)\n            vertical = c0 <= mc <= c1 and (mr < r0 or mr > r1)\n            assert horizontal ^ vertical, (color, (mr, mc), rect[\"bbox\"])\n\n            if horizontal:\n                dc = -1 if mc < c0 else 1\n                side_c = c0 - 1 if dc < 0 else c1 + 1\n                for rr in (mr - 1, mr, mr + 1):\n                    _claim(g, claims, (rr, side_c), color, bg)\n                for rr in (mr - 1, mr + 1):\n                    _claim(g, claims, (rr, mc), color, bg)\n                _claim_range(\n                    g,\n                    claims,\n                    (mr, side_c),\n                    (mr, mc + dc),\n                    (0, dc),\n                    (mr, mc),\n                    color,\n                    bg,\n                )\n            else:\n                dr = -1 if mr < r0 else 1\n                side_r = r0 - 1 if dr < 0 else r1 + 1\n                for cc in (mc - 1, mc, mc + 1):\n                    _claim(g, claims, (side_r, cc), color, bg)\n                for cc in (mc - 1, mc + 1):\n                    _claim(g, claims, (mr, cc), color, bg)\n                _claim_range(\n                    g,\n                    claims,\n                    (side_r, mc),\n                    (mr + dr, mc),\n                    (dr, 0),\n                    (mr, mc),\n                    color,\n                    bg,\n                )\n\n            clears.add((mr, mc))\n\n    assert not (set(claims) & clears)\n\n    out = g.copy()\n    for (r, c), color in claims.items():\n        out[r, c] = color\n    for r, c in clears:\n        out[r, c] = bg\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_ROWS = (13, 30)\nGRID_COLS = (16, 30)\nPALETTE = tuple(range(10))\nFOREGROUND_COLOR_COUNT = (1, 3)\nRECT_SIZE = (2, 11)\nMARKER_COUNT = (1, 3)\nMARKER_DISTANCE = (3, 10)\nSAME_SIDE_MARKER_GAP = 3\nSIDES = (\"top\", \"bottom\", \"left\", \"right\")\nPATCH_ATTEMPTS = 80\nPLACEMENT_ATTEMPTS = 30\nGENERATE_ATTEMPTS = 300\n\ndef _gen_marker_cells(rect_h: int, rect_w: int, side: str, offset: int, dist: int):\n    cells: set[tuple[int, int]] = set()\n    if side == \"top\":\n        marker = (-dist, offset)\n        for cc in range(offset - 1, offset + 2):\n            cells.add((-1, cc))\n        for rr in range(-1, -dist - 2, -1):\n            if rr != marker[0]:\n                cells.add((rr, offset))\n        cells.add((marker[0], offset - 1))\n        cells.add((marker[0], offset + 1))\n    elif side == \"bottom\":\n        marker = (rect_h - 1 + dist, offset)\n        for cc in range(offset - 1, offset + 2):\n            cells.add((rect_h, cc))\n        for rr in range(rect_h, marker[0] + 2):\n            if rr != marker[0]:\n                cells.add((rr, offset))\n        cells.add((marker[0], offset - 1))\n        cells.add((marker[0], offset + 1))\n    elif side == \"left\":\n        marker = (offset, -dist)\n        for rr in range(offset - 1, offset + 2):\n            cells.add((rr, -1))\n        for cc in range(-1, -dist - 2, -1):\n            if cc != marker[1]:\n                cells.add((offset, cc))\n        cells.add((offset - 1, marker[1]))\n        cells.add((offset + 1, marker[1]))\n    else:\n        marker = (offset, rect_w - 1 + dist)\n        for rr in range(offset - 1, offset + 2):\n            cells.add((rr, rect_w))\n        for cc in range(rect_w, marker[1] + 2):\n            if cc != marker[1]:\n                cells.add((offset, cc))\n        cells.add((offset - 1, marker[1]))\n        cells.add((offset + 1, marker[1]))\n    return marker, cells\n\n\ndef _updated_margins(\n    margins: tuple[int, int, int, int],\n    side: str,\n    dist: int,\n) -> tuple[int, int, int, int]:\n    top_extra, bottom_extra, left_extra, right_extra = margins\n    if side == \"top\":\n        top_extra = max(top_extra, dist + 1)\n    elif side == \"bottom\":\n        bottom_extra = max(bottom_extra, dist + 1)\n    elif side == \"left\":\n        left_extra = max(left_extra, dist + 1)\n    else:\n        right_extra = max(right_extra, dist + 1)\n    return top_extra, bottom_extra, left_extra, right_extra\n\n\ndef _gen_marker_options(grid_h, grid_w, rect_h, rect_w, side_offsets, margins, markers, protrusions):\n    options = []\n    for side in SIDES:\n        offsets = range(1, rect_w - 1) if side in (\"top\", \"bottom\") else range(1, rect_h - 1)\n        for offset in offsets:\n            if any(abs(offset - old) < SAME_SIDE_MARKER_GAP for old in side_offsets[side]):\n                continue\n            for dist in range(MARKER_DISTANCE[0], MARKER_DISTANCE[1] + 1):\n                next_margins = _updated_margins(margins, side, dist)\n                ntop, nbottom, nleft, nright = next_margins\n                if ntop + rect_h + nbottom > grid_h:\n                    continue\n                if nleft + rect_w + nright > grid_w:\n                    continue\n                marker, cells = _gen_marker_cells(rect_h, rect_w, side, offset, dist)\n                if marker in protrusions:\n                    continue\n                if any(cell in markers for cell in cells):\n                    continue\n                if protrusions & cells:\n                    continue\n                options.append((side, offset, dist, marker, cells, next_margins))\n    return options\n\n\ndef _gen_make_patch(grid_h: int, grid_w: int, color: int, bg: int):\n    for _ in range(PATCH_ATTEMPTS):\n        rect_h = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_h))\n        rect_w = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_w))\n        if rect_h == 2 and rect_w == 2:\n            continue\n\n        marker_n = random.randint(MARKER_COUNT[0], MARKER_COUNT[1])\n        side_offsets: dict[str, list[int]] = {side: [] for side in SIDES}\n        margins = (0, 0, 0, 0)\n        markers: list[tuple[int, int]] = []\n        protrusions: set[tuple[int, int]] = set()\n\n        for _marker_i in range(marker_n):\n            options = _gen_marker_options(\n                grid_h,\n                grid_w,\n                rect_h,\n                rect_w,\n                side_offsets,\n                margins,\n                markers,\n                protrusions,\n            )\n\n            if not options:\n                break\n            side, offset, _dist, marker, cells, margins = random.choice(options)\n            side_offsets[side].append(offset)\n            markers.append(marker)\n            protrusions.update(cells)\n        else:\n            rect_cells = {(r, c) for r in range(rect_h) for c in range(rect_w)}\n            marker_cells = set(markers)\n            if protrusions & rect_cells or protrusions & marker_cells:\n                continue\n\n            reserved_cells = rect_cells | marker_cells | protrusions\n            rows = [r for r, _c in reserved_cells]\n            cols = [c for _r, c in reserved_cells]\n            min_r, max_r = min(rows), max(rows)\n            min_c, max_c = min(cols), max(cols)\n            patch_h = max_r - min_r + 1\n            patch_w = max_c - min_c + 1\n            if patch_h > grid_h or patch_w > grid_w:\n                continue\n\n            out_patch = np.full((patch_h, patch_w), bg, dtype=int)\n            inp_patch = np.full((patch_h, patch_w), bg, dtype=int)\n            reserve_patch = np.full((patch_h, patch_w), bg, dtype=int)\n            for r, c in rect_cells | protrusions:\n                out_patch[r - min_r, c - min_c] = color\n            for r, c in rect_cells | marker_cells:\n                inp_patch[r - min_r, c - min_c] = color\n            for r, c in reserved_cells:\n                reserve_patch[r - min_r, c - min_c] = color\n            return out_patch, inp_patch, reserve_patch\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(GRID_ROWS[0], GRID_ROWS[1])\n    w = random.randint(GRID_COLS[0], GRID_COLS[1])\n    bg = random.choice(PALETTE)\n    colors = random.sample(\n        [c for c in PALETTE if c != bg],\n        random.randint(FOREGROUND_COLOR_COUNT[0], FOREGROUND_COLOR_COUNT[1]),\n    )\n\n    out = np.full((h, w), bg, dtype=int)\n    inp = np.full((h, w), bg, dtype=int)\n    reserved = np.full((h, w), bg, dtype=int)\n\n    for color in colors:\n        for _ in range(PLACEMENT_ATTEMPTS):\n            patches = _gen_make_patch(h, w, color, bg)\n            if patches is None:\n                continue\n            out_patch, inp_patch, reserve_patch = patches\n            try:\n                r0, c0 = random_free_location(reserved, reserve_patch, transparent=bg)\n            except ValueError:\n                continue\n            paste(out, out_patch, r0, c0, transparent=bg)\n            paste(inp, inp_patch, r0, c0, transparent=bg)\n            paste(reserved, reserve_patch, r0, c0, transparent=bg)\n            break\n        else:\n            return None\n\n    counts = np.bincount(inp.ravel(), minlength=10)\n    if counts[bg] <= max(counts[c] for c in range(10) if c != bg):\n        return None\n\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n\ndef _gen_anchor(corner: str, n: int, h: int, w: int) -> tuple[int, int]:\n    if corner == \"TL\":\n        return 0, 0\n    if corner == \"TR\":\n        return 0, n - w\n    if corner == \"BR\":\n        return n - h, n - w\n    if corner == \"BL\":\n        return n - h, 0\n    raise AssertionError(corner)\n\n\ndef _gen_source_local_corner(corner: str, h: int, w: int) -> tuple[int, int]:\n    r = 0 if corner in (\"TL\", \"TR\") else h - 1\n    c = 0 if corner in (\"TL\", \"BL\") else w - 1\n    return r, c\n\n\ndef _gen_step_range(a: int, b: int) -> range:\n    step = 1 if b >= a else -1\n    return range(a, b + step, step)\n\n\ndef _gen_frontier(mask: np.ndarray) -> set[tuple[int, int]]:\n    h, w = mask.shape\n    frontier: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(mask):\n        for dr, dc in _GEN_NEIGHBORS_4:\n            nr, nc = int(r) + dr, int(c) + dc\n            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                frontier.add((nr, nc))\n    return frontier\n\n\ndef _gen_grow_mask(mask: np.ndarray, target: int) -> bool:\n    while int(mask.sum()) < target:\n        frontier = _gen_frontier(mask)\n        if not frontier:\n            return False\n        r, c = random.choice(tuple(frontier))\n        mask[r, c] = True\n    return True\n\n\ndef _gen_connected_corner_mask(corner: str, h: int, w: int) -> np.ndarray | None:\n    sr, sc = _gen_source_local_corner(corner, h, w)\n    er, ec = h - 1 - sr, w - 1 - sc\n    mask = np.zeros((h, w), dtype=bool)\n\n    if random.random() < 0.5:\n        for r in _gen_step_range(sr, er):\n            mask[r, sc] = True\n        for c in _gen_step_range(sc, ec):\n            mask[er, c] = True\n    else:\n        for c in _gen_step_range(sc, ec):\n            mask[sr, c] = True\n        for r in _gen_step_range(sr, er):\n            mask[r, ec] = True\n\n    area = h * w\n    min_pixels = max(\n        _GEN_CORNER_MIN_PIXELS,\n        int(np.ceil(area * _GEN_CORNER_MIN_DENSITY)),\n        int(mask.sum()),\n    )\n    max_pixels = min(_GEN_CORNER_MAX_PIXELS, area)\n    if min_pixels > max_pixels:\n        return None\n\n    if area <= _GEN_SMALL_FULL_AREA_MAX and random.random() < _GEN_SMALL_FULL_PROB:\n        target = area\n    else:\n        target = random.randint(min_pixels, max_pixels)\n\n    return mask if _gen_grow_mask(mask, target) else None\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int) -> np.ndarray:\n    patch = np.full(mask.shape, _GEN_BG, dtype=int)\n    patch[mask] = color\n    return patch\n\n\ndef _gen_stamp_cells(\n    corner: str, mask: np.ndarray, color: int, n: int\n) -> dict[tuple[int, int], int]:\n    h, w = mask.shape\n    r0, c0 = _gen_anchor(_GEN_NEXT[corner], n, h, w)\n    cells = {}\n    for rr, cc in np.argwhere(mask):\n        cells[(r0 + int(rr), c0 + int(cc))] = color\n    return cells\n\n\ndef _gen_touches_true_corner(r0: int, c0: int, h: int, w: int, n: int) -> bool:\n    top = r0 == 0\n    bottom = r0 + h - 1 == n - 1\n    left = c0 == 0\n    right = c0 + w - 1 == n - 1\n    return (top and left) or (top and right) or (bottom and right) or (bottom and left)\n\n\ndef _gen_blob_patch(color: int) -> np.ndarray:\n    pixels = random.randint(_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX)\n    dims = [\n        (h, w)\n        for h in range(_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX + 1)\n        for w in range(_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX + 1)\n        if h * w >= pixels\n    ]\n    h, w = random.choice(dims)\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = random.randrange(h), random.randrange(w)\n    mask[r, c] = True\n    assert _gen_grow_mask(mask, pixels)\n\n    bb = bbox(mask)\n    assert bb is not None\n    r0, c0, r1, c1 = bb\n    return _gen_colored_patch(mask[r0 : r1 + 1, c0 : c1 + 1], color)\n\n\ndef _gen_adjacent_existing(\n    grid_a: np.ndarray,\n    grid_b: np.ndarray,\n    cells: list[tuple[int, int]],\n    cell_set: set[tuple[int, int]],\n) -> bool:\n    n = grid_a.shape[0]\n    for r, c in cells:\n        for dr, dc in _GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < n and 0 <= nc < n) or (nr, nc) in cell_set:\n                continue\n            if grid_a[nr, nc] != _GEN_BG or grid_b[nr, nc] != _GEN_BG:\n                return True\n    return False\n\n\ndef _gen_place_distractor(inp: np.ndarray, out: np.ndarray) -> bool:\n    n = inp.shape[0]\n    color = random.choice(_GEN_COLORS)\n    patch = _gen_blob_patch(color)\n    h, w = patch.shape\n    local_cells = [(int(r), int(c)) for r, c in np.argwhere(patch != _GEN_BG)]\n    occupied = (inp != _GEN_BG) | (out != _GEN_BG)\n    choices = []\n\n    for r0 in range(n - h + 1):\n        for c0 in range(n - w + 1):\n            if _gen_touches_true_corner(r0, c0, h, w, n):\n                continue\n            cells = [(r0 + rr, c0 + cc) for rr, cc in local_cells]\n            if any(occupied[r, c] for r, c in cells):\n                continue\n            cell_set = set(cells)\n            if _gen_adjacent_existing(inp, out, cells, cell_set):\n                continue\n            choices.append((r0, c0))\n\n    if not choices:\n        return False\n\n    r0, c0 = random.choice(choices)\n    paste(inp, patch, r0, c0, transparent=_GEN_BG)\n    paste(out, patch, r0, c0, transparent=_GEN_BG)\n    return True\n\n\ndef _gen_bg_is_most_frequent(grid: np.ndarray) -> bool:\n    values, counts = np.unique(grid, return_counts=True)\n    freq = {int(v): int(c) for v, c in zip(values, counts)}\n    bg_count = freq.get(_GEN_BG, 0)\n    return all(bg_count > count for value, count in freq.items() if value != _GEN_BG)\n\n\ndef _gen_distractor_count(n: int) -> int:\n    max_count = _GEN_DISTRACTOR_BASE_COUNT + round(\n        (n - _GEN_MIN_SIZE) * _GEN_DISTRACTOR_EXTRA_MAX / _GEN_DISTRACTOR_SIZE_SPAN\n    )\n    min_count = max(_GEN_DISTRACTOR_BASE_COUNT, max_count - _GEN_DISTRACTOR_MIN_GAP)\n    return random.randint(min_count, max_count)\n\n\ndef _gen_place_corner_sources(\n    source_grid: np.ndarray, out: np.ndarray, occupied_corners: list[str]\n) -> dict[str, tuple[np.ndarray, int]] | None:\n    n = source_grid.shape[0]\n    corner_objects: dict[str, tuple[np.ndarray, int]] = {}\n    for corner in occupied_corners:\n        h, w = random.choice(_GEN_CORNER_DIMS)\n        mask = _gen_connected_corner_mask(corner, h, w)\n        if mask is None:\n            return None\n        color = random.choice(_GEN_COLORS)\n        corner_objects[corner] = (mask, color)\n        patch = _gen_colored_patch(mask, color)\n        r0, c0 = _gen_anchor(corner, n, h, w)\n        if np.any(source_grid[r0 : r0 + h, c0 : c0 + w][mask] != _GEN_BG):\n            return None\n        paste(source_grid, patch, r0, c0, transparent=_GEN_BG)\n        paste(out, patch, r0, c0, transparent=_GEN_BG)\n    return corner_objects\n\n\ndef _gen_planned_stamps(\n    corner_objects: dict[str, tuple[np.ndarray, int]], n: int\n) -> dict[tuple[int, int], int] | None:\n    planned: dict[tuple[int, int], int] = {}\n    for corner, (mask, color) in corner_objects.items():\n        for cell, stamp_color in _gen_stamp_cells(corner, mask, color, n).items():\n            if cell in planned:\n                return None\n            planned[cell] = stamp_color\n    return planned\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(_GEN_MIN_SIZE, _GEN_MAX_SIZE)\n    source_grid = np.full((n, n), _GEN_BG, dtype=int)\n    out = source_grid.copy()\n\n    corner_count = random.randint(_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX)\n    occupied_corners = random.sample(_GEN_CORNERS, corner_count)\n    corner_objects = _gen_place_corner_sources(source_grid, out, occupied_corners)\n    if corner_objects is None:\n        return None\n\n    planned = _gen_planned_stamps(corner_objects, n)\n    if planned is None:\n        return None\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    inp = out.copy()\n    for r, c in planned:\n        inp[r, c] = source_grid[r, c]\n\n    for _ in range(_gen_distractor_count(n)):\n        if not _gen_place_distractor(inp, out):\n            return None\n\n    if not _gen_bg_is_most_frequent(inp):\n        return None\n\n    try:\n        if not np.array_equal(main(inp), out):\n            return None\n    except AssertionError:\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
