{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n        dr, dc = color_dir[rc]\n        target_size = rng.randint(size_min, size_max)\n\n        # Build canvas: interior cells (not border) that are unoccupied.\n        canvas = np.ones((h, w), dtype=bool)\n        canvas[0, :] = False; canvas[-1, :] = False\n        canvas[:, 0] = False; canvas[:, -1] = False\n        canvas &= ~occupied\n        if not canvas.any():\n            continue\n\n        blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)\n        if blob is None:\n            continue\n\n        walls = _blob_wall_cells(blob, h, w)\n        regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})\n\n        # Reserve blob + walls + 1-cell buffer around walls.\n        reserve = blob | walls\n        extra = set()\n        for r, c in walls:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:\n                    extra.add((nr, nc))\n        for r, c in reserve | extra:\n            occupied[r, c] = True\n\n    if not regions:\n        return None\n    # Every legend color must have at least one region.\n    if {reg['color'] for reg in regions} != set(all_colors):\n        return None\n    return regions\n\n\ndef _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,\n                         occupied: np.ndarray, target_size: int,\n                         h: int, w: int) -> set[tuple[int,int]] | None:\n    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n    for _ in range(BLOB_GROW_RETRIES):\n        free = np.argwhere(canvas)\n        if len(free) == 0:\n            break\n        sr, sc = free[rng.randrange(len(free))]\n        cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)\n        if cand is None:\n            continue\n        # Fill interior holes until stable.\n        while True:\n            filled = _fill_holes(cand, h, w)\n            if filled == cand:\n                break\n            cand = filled\n        # Absorbed cells must stay within canvas.\n        if any(not canvas[r, c] for r, c in cand):\n            continue\n        walls = _blob_wall_cells(cand, h, w)\n        # Walls must not overlap occupied cells or the grid border.\n        if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)\n               for wr, wc in walls):\n            continue\n        return cand\n    return None\n\n\ndef _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n    h, w = grid.shape\n    labeled, n_comp = label_mask(grid == 0, connectivity=4)\n    bounded = []\n    for comp_id in range(1, n_comp + 1):\n        coords = np.argwhere(labeled == comp_id)\n        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):\n            continue\n        bounded.append({(int(r), int(c)) for r, c in coords})\n    region_sets = [reg['interior'] for reg in regions]\n    if len(bounded) != len(region_sets):\n        return False\n    return all(comp in region_sets for comp in bounded)\n\n\ndef _place_yellows(rng: random.Random, regions: list[dict],\n                   grid: np.ndarray) -> bool:\n    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n\n    Modifies grid in-place by painting yellow(4) at input positions.\n    Returns True on success.\n    \"\"\"\n    for reg in regions:\n        blob = reg['interior']\n        dr, dc = reg['dir']\n        n_yellows = rng.choice(YELLOWS_PER_REGION)\n\n        # Cells sorted by projection onto slide direction (farthest first).\n        cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]\n        tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]\n\n        # Pick output positions: first at the farthest tier, second one step behind or at tier1.\n        first = tier1[rng.randrange(len(tier1))]\n        output_positions = [first]\n\n        if n_yellows == 2:\n            pr, pc = first[0] - dr, first[1] - dc\n            cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]\n            if cands:\n                second = cands[rng.randrange(len(cands))]\n                if second != first:\n                    output_positions.append(second)\n\n        # Reverse-slide: process in solver order (far-to-near).\n        out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)\n        already_stopped = set()\n        yellows_input = []\n\n        for out_pos in out_sorted:\n            candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,\n                                            yellows_input, rng)\n            if candidate is None:\n                return False\n            yellows_input.append(candidate)\n            already_stopped.add(out_pos)\n\n        for r, c in yellows_input:\n            grid[r, c] = 4\n    return True\n\n\ndef _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,\n                        already_stopped: set, existing_inputs: list,\n                        rng: random.Random) -> tuple[int,int] | None:\n    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n    target_steps = rng.randint(1, MAX_SLIDE_STEPS)\n    for steps in range(target_steps, 0, -1):\n        r, c = out_pos\n        path_ok = True\n        for _ in range(steps):\n            pr, pc = r - dr, c - dc\n            if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:\n                path_ok = False\n                break\n            if dr != 0 and dc != 0:\n                if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:\n                    path_ok = False\n                    break\n            r, c = pr, pc\n        if not path_ok:\n            continue\n        if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:\n            return (r, c)\n    return None\n\n\ndef _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:\n    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n    h, w = input_grid.shape\n    try:\n        solver_out = main(input_grid)\n    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n        cells = {(c, r) for r, c in cells}\n    return _flip(cells)\n\n\ndef _wide_body(area):\n    width = random.randint(_BODY_WIDTH_RANGE[0], min(_BODY_WIDTH_RANGE[1], area - 1))\n    height = random.choice([h for h in _inclusive_range(_BODY_HEIGHT_RANGE) if h * width >= area])\n    cells = {(0, c) for c in range(width)}\n    cells.add((1, random.randrange(width)))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, height, width)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _frame_body(area):\n    choices = []\n    for h in _inclusive_range(_FRAME_HEIGHT_RANGE):\n        for w in _inclusive_range(_FRAME_WIDTH_RANGE):\n            perim = 2 * h + 2 * w - 4\n            removable = 2 * max(0, h - 2) + 2 * max(0, w - 2)\n            if perim >= area and perim - area <= min(_FRAME_MAX_GAP, removable):\n                choices.append((h, w))\n    if not choices:\n        return _grow_body(area)\n\n    h, w = random.choice(choices)\n    cells = {\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    }\n    gap = len(cells) - area\n    if gap:\n        removable = [\n            (r, c)\n            for r, c in cells\n            if not (r in (0, h - 1) and c in (0, w - 1))\n        ]\n        for cell in random.sample(removable, gap):\n            cells.remove(cell)\n    return _flip(cells)\n\n\ndef _make_body(area):\n    x = random.random()\n    if area >= _FRAME_MIN_AREA and x < _FRAME_BODY_THRESHOLD:\n        return _frame_body(area)\n    if x < _WIDE_BODY_THRESHOLD:\n        return _wide_body(area)\n    if x < _SYMMETRIC_BODY_THRESHOLD:\n        return _symmetric_body(area)\n    return _grow_body(area)\n\n\ndef _marker_cell(body):\n    r0, c0, r1, c1 = _bbox(body)\n    interior, exterior = set(), set()\n    for r, c in body:\n        for dr, dc in _NEIGHBORS4:\n            p = (r + dr, c + dc)\n            if p in body:\n                continue\n            if r0 <= p[0] <= r1 and c0 <= p[1] <= c1:\n                interior.add(p)\n            else:\n                exterior.add(p)\n    pool = list(interior if interior and random.random() < _MARKER_INTERIOR_PROB else (exterior | interior))\n    return random.choice(pool)\n\n\ndef _make_sprite(area, body_color, marker_color, bg):\n    body = _make_body(area)\n    marker = _marker_cell(body)\n    all_cells = set(body) | {marker}\n    r0, c0, r1, c1 = _bbox(all_cells)\n    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n    for r, c in body:\n        patch[r - r0, c - c0] = int(body_color)\n    patch[marker[0] - r0, marker[1] - c0] = int(marker_color)\n    return {\"patch\": patch, \"offset\": (marker[0] - r0, marker[1] - c0)}\n\n\ndef _top_left(sprite, marker_r, marker_c):\n    off_r, off_c = sprite[\"offset\"]\n    return int(marker_r) - int(off_r), int(marker_c) - int(off_c)\n\n\ndef _can_place(canvas, sprite, marker_r, marker_c, bg):\n    patch = sprite[\"patch\"]\n    top, left = _top_left(sprite, marker_r, marker_c)\n    h, w = patch.shape\n    H, W = canvas.shape\n    if top < _INNER_BORDER_GAP or left < _INNER_BORDER_GAP:\n        return False\n    if top + h > H - _INNER_BORDER_GAP or left + w > W - _INNER_BORDER_GAP:\n        return False\n    mask = patch != int(bg)\n    view = canvas[top : top + h, left : left + w]\n    if bool((view[mask] != int(bg)).any()):\n        return False\n    return not _touches_foreground(canvas, mask, top, left, bg)\n\n\ndef _touches_foreground(canvas, mask, top, left, bg):\n    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n    h, w = mask.shape\n    radius = _ISOLATION_RADIUS\n    occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)\n    touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)\n    span = 2 * radius + 1\n    for dr in range(span):\n        for dc in range(span):\n            touch_zone[dr : dr + h, dc : dc + w] |= mask\n    return bool((occupied & touch_zone).any())\n\n\ndef _place(canvas, sprite, marker_r, marker_c, bg):\n    top, left = _top_left(sprite, marker_r, marker_c)\n    paste(canvas, sprite[\"patch\"], top, left, transparent=int(bg))\n\n\ndef _anchor_ok(canvas, r, c, bg):\n    H, W = canvas.shape\n    if not (r in (0, H - 1) or c in (0, W - 1)):\n        return False\n    if r in (0, H - 1) and c in (0, W - 1):\n        return False\n    return _isolated_bg_cell(canvas, r, c, bg)\n\n\ndef _isolated_bg_cell(canvas, r, c, bg):\n    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n    H, W = canvas.shape\n    radius = _ISOLATION_RADIUS\n    r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n    c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n    return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n\n\ndef _anchor_candidates(canvas, bg):\n    H, W = canvas.shape\n    rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n    rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n    cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n    cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n    out = []\n    for c in cols:\n        out.append((\"h\", 0, c))\n        out.append((\"h\", H - 1, c))\n    for r in rows:\n        out.append((\"v\", r, 0))\n        out.append((\"v\", r, W - 1))\n    random.shuffle(out)\n    return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n\n\ndef _put_anchor(canvas, r, c, color):\n    paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n\n\ndef _aligned_positions(canvas, sprite, anchor, bg):\n    H, W = canvas.shape\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (r, anchor[\"c\"])\n            for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n            if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n        ]\n    return [\n        (anchor[\"r\"], c)\n        for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n        if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n    ]\n\n\ndef _scatter_positions(canvas, sprite, anchor, marker, bg):\n    H, W = canvas.shape\n    mr, mc = marker\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (mr, c)\n            for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n            if c != mc and _can_place(canvas, sprite, mr, c, bg)\n        ]\n    return [\n        (r, mc)\n        for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n        if r != mr and _can_place(canvas, sprite, r, mc, bg)\n    ]\n\n\ndef _body_color(bg, marker, used):\n    pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]\n    if not pool:\n        pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]\n    return random.choice(pool)\n\n\ndef _bg_is_mode(grid, bg):\n    counts = Counter(map(int, grid.ravel()))\n    return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)\n\n\ndef _add_distractors(out, inp, anchors, bg):\n    vertical = [a for a in anchors if a[\"axis\"] == \"v\"]\n    if not vertical or random.random() >= _DISTRACTOR_PROB:\n        return\n    anchor = random.choice(vertical)\n    sprite = {\"patch\": np.array([[anchor[\"color\"]]], dtype=int), \"offset\": (0, 0)}\n    for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n        pairs = []\n        for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):\n            if not _can_place(out, sprite, anchor[\"r\"], c, bg):\n                continue\n            for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):\n                if r != anchor[\"r\"] and _can_place(inp, sprite, r, c, bg):\n                    pairs.append((r, c))\n        if not pairs:\n            return\n        in_r, col = random.choice(pairs)\n        _place(out, sprite, anchor[\"r\"], col, bg)\n        _place(inp, sprite, in_r, col, bg)\n\n\ndef _gen_attempt():\n    bg, out, inp = _new_canvas_pair()\n    placed = _place_anchors(out, inp, bg)\n    if placed is None:\n        return None\n    anchor_colors, anchors = placed\n\n    marker_colors = _marker_color_sequence(anchor_colors)\n    sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n    if sprites is None:\n        return None\n\n    if not _scatter_sprites(inp, sprites, bg):\n        return None\n\n    _add_distractors(out, inp, anchors, bg)\n    if not _generated_grid_is_valid(inp, out, bg):\n        return None\n    return inp\n\n\ndef _new_canvas_pair():\n    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n    H = random.randint(*_GRID_HEIGHT_RANGE)\n    W = random.randint(*_GRID_WIDTH_RANGE)\n    bg = random.randint(*_BG_COLOR_RANGE)\n    out = np.full((H, W), int(bg), dtype=int)\n    inp = np.full((H, W), int(bg), dtype=int)\n    return bg, out, inp\n\n\ndef _place_anchors(out, inp, bg):\n    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n    anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n    anchors = []\n    for color in anchor_colors:\n        candidates = _anchor_candidates(out, bg)\n        if not candidates:\n            return None\n        axis, r, c = random.choice(candidates)\n        anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n        anchors.append(anchor)\n        _put_anchor(out, r, c, color)\n        _put_anchor(inp, r, c, color)\n    return anchor_colors, anchors\n\n\ndef _marker_color_sequence(anchor_colors):\n    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n    n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n    marker_colors = anchor_colors[:]\n    while len(marker_colors) < n_sprites:\n        marker_colors.append(random.choice(anchor_colors))\n    random.shuffle(marker_colors)\n    return marker_colors\n\n\ndef _place_aligned_sprites(out, anchors, marker_colors, bg):\n    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n    by_color = {a[\"color\"]: a for a in anchors}\n    used_body = set()\n    sprites = []\n    for marker in marker_colors:\n        anchor = by_color[int(marker)]\n        body = _body_color(bg, marker, used_body)\n        used_body.add(body)\n        sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n        positions = _aligned_positions(out, sprite, anchor, bg)\n        if not positions:\n            return None\n        marker_pos = random.choice(positions)\n        _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n        sprites.append((sprite, anchor, marker_pos))\n    return sprites\n\n\ndef _scatter_sprites(inp, sprites, bg):\n    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n    random.shuffle(sprites)\n    for sprite, anchor, marker_pos in sprites:\n        positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n        if not positions:\n            return False\n        in_pos = random.choice(positions)\n        _place(inp, sprite, in_pos[0], in_pos[1], bg)\n    return True\n\n\ndef _generated_grid_is_valid(inp, out, bg):\n    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n    if not _bg_is_mode(inp, bg):\n        return False\n    return bool(np.array_equal(main(inp), out))\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
