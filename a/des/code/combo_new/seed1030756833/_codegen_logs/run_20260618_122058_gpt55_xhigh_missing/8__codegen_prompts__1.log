t_v).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:296:    \"\"\"Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:362:    \"\"\"Map local (u, v) to grid (r, c) given radiate direction and anchor.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:374:    \"\"\"Choose anchor so the wall fits within margins.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:385:    \"\"\"Return bg cells strictly between the two wall arms in local coords.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:401:    \"\"\"Grow a small 4-connected blob from seed within interior cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:418:    \"\"\"Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:424:    \"\"\"Find bg cells far enough from wall for obstacle placement, using distance transform.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:438:    \"\"\"Place up to n_obstacles on the grid, preferring some in the fill zone.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:460:    \"\"\"Check if any True cell in mask lies on the grid border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:465:    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py:532:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:17:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:18:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:40:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py:259:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:70:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:71:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:91:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:176:    \"\"\"Return the solver output implied by the generated wall intervals.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:266:    \"\"\"Choose side presence and wall boundaries for each non-empty band row.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:298:    \"\"\"Assign one or two wall pixels to each selected side boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:315:    \"\"\"Paint wall pixels and return row intervals used by the oracle check.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/78e78cff.py:348:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/6ca952ad.py:14:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/6ca952ad.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/6ca952ad.py:30:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/6ca952ad.py:324:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:41:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:42:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:184:    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:188:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:202:    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:207:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:245:    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:296:    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:302:    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:305:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:330:    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:357:    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:388:    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:407:    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:508:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
