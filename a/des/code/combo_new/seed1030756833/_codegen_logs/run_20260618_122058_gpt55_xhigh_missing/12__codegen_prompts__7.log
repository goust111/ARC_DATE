y:113:    \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:132:    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:153:    \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:169:    \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:176:    \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:189:    \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:197:    \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:206:    \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:224:    \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:238:    \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:244:    \"\"\"Paint all components at their output positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:252:    \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:284:    \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:321:    \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:361:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
