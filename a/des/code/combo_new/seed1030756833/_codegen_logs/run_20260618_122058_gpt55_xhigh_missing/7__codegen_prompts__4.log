{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n            below = _exits_below(grid, r, seg)\n            if len(above) > 1 or len(below) > 1:\n                issues.append((r, seg, above, below))\n    return issues\n\n\ndef _separator_column(grid: np.ndarray, r: int, left: int, right: int) -> int | None:\n    choices = [c for c in range(left + 1, right) if grid[r, c] == BG]\n    if not choices:\n        return None\n    return int(choices[len(choices) // 2])\n\n\ndef _repair_holes(\n    gates: list[list[int]], holes: list[list[int]], width: int\n) -> list[list[int]] | None:\n    hole_sets = [set(row) for row in holes]\n\n    while True:\n        grid = _build_opened_grid(gates, [sorted(row) for row in hole_sets], width)\n        issues = _find_issues(grid)\n        if not issues:\n            return [sorted(row) for row in hole_sets]\n\n        r, _seg, above, below = issues[0]\n        pipe_idx = r // 2\n        if len(hole_sets[pipe_idx]) >= 2:\n            return None\n\n        events = sorted([(c, \"up\") for c in above] + [(c, \"down\") for c in below])\n        seen_up = False\n        seen_down = False\n        prev_col: int | None = None\n        new_cols: list[int] = []\n\n        for col, kind in events:\n            duplicate = (kind == \"up\" and seen_up) or (kind == \"down\" and seen_down)\n            if duplicate:\n                assert prev_col is not None\n                sep = _separator_column(grid, r, prev_col, col)\n                if sep is None:\n                    return None\n                new_cols.append(sep)\n                seen_up = False\n                seen_down = False\n\n            if kind == \"up\":\n                seen_up = True\n            else:\n                seen_down = True\n            prev_col = col\n\n        if not new_cols:\n            return None\n\n        for c in new_cols:\n            hole_sets[pipe_idx].add(c)\n            if len(hole_sets[pipe_idx]) > 2:\n                return None\n\n        if sum(len(row) for row in hole_sets) > 4:\n            return None\n\n\ndef _candidate_centers(gates: list[list[int]], row: int, width: int) -> list[int]:\n    candidates: list[int] = []\n    for c in range(2, width - 2):\n        if c in gates[row]:\n            continue\n        if any(abs(c - other) < 5 for other in gates[row]):\n            continue\n\n        ok = True\n        for adj in (row - 1, row + 1):\n            if 0 <= adj < len(gates) and any(abs(c - other) < 2 for other in gates[adj]):\n                ok = False\n                break\n        if ok:\n            candidates.append(c)\n    return candidates\n\n\ndef _simulate_output(opened: np.ndarray) -> tuple[np.ndarray, list[int]]:\n    height, width = opened.shape\n    n_walls = (height - 1) // 2\n\n    finals: list[tuple[int, int]] = []\n    drop_counts: list[int] = []\n\n    for pipe_idx in range(n_walls):\n        for start_c in (0, width - 1):\n            r = 2 * pipe_idx\n            c = start_c\n            drops = 0\n            while True:\n                seg = _find_segment(opened, r, c)\n                if seg is None:\n                    break\n                exits = _exits_below(opened, r, seg)\n                if len(exits) != 1:\n                    break\n                r += 2\n                c = exits[0]\n                drops += 1\n            finals.append((r, c))\n            drop_counts.append(drops)\n\n    out = opened.copy()\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n\n    for r, c in finals:\n        seg = _find_segment(opened, r, c)\n        if seg is None:\n            continue\n        a, b = seg\n        entries = _entries_above(opened, r, seg)\n        if len(entries) == 1:\n            entry = entries[0]\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), count in buckets.items():\n        if pack_end == a:\n            for i in range(count):\n                if a + i <= b:\n                    out[r, a + i] = TOKEN\n        else:\n            for i in range(count):\n                if b - i >= a:\n                    out[r, b - i] = TOKEN\n\n    return out, drop_counts\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    n_walls = int(rng.integers(5, 10))\n    width = int(rng.integers(16, 20))\n\n    gates: list[list[int]] = [[] for _ in range(n_walls)]\n    holes: list[list[int]] = [[] for _ in range(n_walls + 1)]\n\n    spine_len = int(rng.integers(3, min(6, n_walls) + 1))\n    spine_start = int(rng.integers(0, n_walls - spine_len + 1))\n\n    prev_center: int | None = None\n    go_left = bool(rng.integers(2))  # alternate direction each step\n    for row in range(spine_start, spine_start + spine_len):\n        if prev_center is None:\n            options = list(range(3, width - 3))\n        elif go_left:\n            options = [c for c in range(3, prev_center - 1)]  # c <= prev - 2\n        else:\n            options = [c for c in range(prev_center + 2, width - 2)]  # c >= prev + 2\n        if not options:\n            return None\n        center = int(rng.choice(options))\n        gates[row] = [center]\n        prev_center = center\n        go_left = not go_left\n\n    holes = _repair_holes(gates, holes, width)\n    if holes is None:\n        return None\n\n    total_gates = sum(len(row) for row in gates)\n    target_total = int(rng.integers(max(6, total_gates), 13))\n\n    while total_gates < target_total:\n        candidates: list[tuple[int, int]] = []\n        for row in range(n_walls):\n            if len(gates[row]) >= 3:\n                continue\n            for center in _candidate_centers(gates, row, width):\n                candidates.append((row, center))\n\n        if not candidates:\n            break\n\n        order = rng.permutation(len(candidates))\n        added = False\n        for idx in order:\n            row, center = candidates[int(idx)]\n            new_gates = [list(cols) for cols in gates]\n            new_gates[row] = sorted(new_gates[row] + [center])\n            new_holes = _repair_holes(new_gates, holes, width)\n            if new_holes is None:\n                continue\n            gates = new_gates\n            holes = new_holes\n            total_gates += 1\n            added = True\n            break\n\n        if not added:\n            break\n\n    if not (6 <= total_gates <= 12):\n        return None\n\n    opened = _build_opened_grid(gates, holes, width)\n    if _find_issues(opened):\n        return None\n\n    output, drop_counts = _simulate_output(opened)\n    if max(drop_counts, default=0) < 3:\n        return None\n\n    inp = _build_input(gates, holes, width)\n    if not np.array_equal(main(inp), output):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for task 2b83f449\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n    inp = _gen_transform(inp, orientation)\n    out = _gen_transform(out, orientation)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n","exit_code":0,"status":"completed"}}
