{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,560p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                cc = pc1 + k if side == 0 else pc1 + n - 1 - k\n                if 0 <= r < H and 0 <= cc < W:\n                    grid[r, cc] = _BG\n\n\ndef _river_connected(grid):\n    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    if not mask.any():\n        return False\n    labeled, num = scipy_label(mask.astype(int))\n    return num == 1\n\n\ndef _compute_offsets(G, n, num_coarse):\n    if num_coarse == 1:\n        return [1]\n    first = 1\n    last = G - n - 1\n    if last < first:\n        return None\n    step = (last - first) / (num_coarse - 1)\n    return [int(round(first + i * step)) for i in range(num_coarse)]\n\n\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,380p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,380p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _dominant_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size > 0, \"expected foreground pixels\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"expected one largest foreground color for lattice frames\"\n    return int(winners[0])\n\n\ndef _parse_frames(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[list[int], list[int]]]:\n    frames: list[tuple[list[int], list[int]]] = []\n    components = find_components(\n        g,\n        bg=int(bg),\n        colors=[int(frame_color)],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert components, \"expected at least one lattice frame\"\n\n    for comp in components:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        sub = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(frame_color)\n\n        row_idx = [r for r in range(sub.shape[0]) if bool(sub[r, :].all())]\n        col_idx = [c for c in range(sub.shape[1]) if bool(sub[:, c].all())]\n        assert len(row_idx) >= 2 and len(col_idx) >= 2, \"frame must divide slots\"\n        assert row_idx[0] == 0 and row_idx[-1] == sub.shape[0] - 1\n        assert col_idx[0] == 0 and col_idx[-1] == sub.shape[1] - 1\n        assert all(a + 1 < b for a, b in zip(row_idx, row_idx[1:]))\n        assert all(a + 1 < b for a, b in zip(col_idx, col_idx[1:]))\n\n        expected = np.zeros_like(sub, dtype=bool)\n        expected[row_idx, :] = True\n        expected[:, col_idx] = True\n        assert np.array_equal(sub, expected), \"frame must be a complete rectangular lattice\"\n\n        rows = [int(r0) + r for r in row_idx]\n        cols = [int(c0) + c for c in col_idx]\n        frames.append((rows, cols))\n\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    for rows, cols in frames:\n        assert len(rows) - 1 == slot_rows\n        assert len(cols) - 1 == slot_cols\n    return frames\n\n\ndef _infer_slot_colors(\n    g: np.ndarray,\n    bg: int,\n    frame_color: int,\n    frames: list[tuple[list[int], list[int]]],\n) -> dict[tuple[int, int], int]:\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    colors: dict[tuple[int, int], int] = {}\n\n    for rows, cols in frames:\n        for sr in range(slot_rows):\n            for sc in range(slot_cols):\n                region = g[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]]\n                marker = region[(region != int(bg)) & (region != int(frame_color))]\n                if marker.size == 0:\n                    continue\n                vals = np.unique(marker)\n                assert vals.size == 1, \"each colored slot must contain one color\"\n                color = int(vals[0])\n                key = (sr, sc)\n                assert key not in colors or colors[key] == color\n                colors[key] = color\n\n    expected = {(sr, sc) for sr in range(slot_rows) for sc in range(slot_cols)}\n    assert set(colors) == expected, \"colored slots must identify every logical slot\"\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill every lattice slot from the color assigned to that slot position by the other lattices.\n\n    Input structure:\n    - The background is the dominant color.\n    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.\n    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.\n\n    Rule:\n    - Infer a color for each logical slot position from the colored slots across all lattice frames.\n    - Repaint every slot interior in every lattice with the inferred color for its row/column position.\n    - Keep the frame lines and all background outside frames unchanged.\n\n    Key insight:\n    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color = _dominant_foreground_color(g, bg)\n    frames = _parse_frames(g, bg, frame_color)\n    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)\n\n    out = g.copy()\n    for rows, cols in frames:\n        for sr in range(len(rows) - 1):\n            for sc in range(len(cols) - 1):\n                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[\n                    (sr, sc)\n                ]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette choices.\nBG = 0\nGRID_SIZE_RANGE = (22, 28)\nNEAR_SQUARE_PROB = 0.65\nNEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]\nFOREGROUND_COLORS = range(1, 10)\nPALETTE_SIZE = 5\n\n# Lattice geometry.\nSLOT_SIZE_RANGE = (1, 8)\nFRAME_HEIGHT_RANGE = (5, 18)\nFRAME_WIDTH_RANGE = (5, 14)\nLATTICE_LINE_COUNT = 3\nSLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# Frame count and area allocation.\nFRAME_COUNT_RANGE = (4, 6)\nMIN_FRAME_AREA = 25\nAREA_BUDGET_RANGE = (0.55, 0.88)\nAREA_WEIGHT_SCALE = 35.0\n\n# Placement and retry limits.\nEDGE_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\nFrameSpec = tuple[tuple[int, int], tuple[int, int]]\nPlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]\nSlotColors = dict[tuple[int, int], int]\n\n\ndef _line_indices(lengths: tuple[int, int]) -> list[int]:\n    return [0, int(lengths[0]) + 1, int(lengths[0]) + int(lengths[1]) + 2]\n\n\ndef _slot_options() -> dict[tuple[int, int], list[FrameSpec]]:\n    options: dict[tuple[int, int], list[FrameSpec]] = {}\n    slot_min, slot_max = SLOT_SIZE_RANGE\n    height_min, height_max = FRAME_HEIGHT_RANGE\n    width_min, width_max = FRAME_WIDTH_RANGE\n    for h0 in range(slot_min, slot_max + 1):\n        for h1 in range(slot_min, slot_max + 1):\n            height = h0 + h1 + LATTICE_LINE_COUNT\n            if not height_min <= height <= height_max:\n                continue\n            for w0 in range(slot_min, slot_max + 1):\n                for w1 in range(slot_min, slot_max + 1):\n                    width = w0 + w1 + LATTICE_LINE_COUNT\n                    if not width_min <= width <= width_max:\n                        continue\n                    options.setdefault((height, width), []).append(((h0, h1), (w0, w1)))\n    return options\n\n\n_SIZE_OPTIONS = _slot_options()\n\n\ndef _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:\n    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]\n    random.shuffle(keys)\n\n    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)\n    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))\n    chosen_sizes: list[tuple[int, int]] = []\n    remaining = budget\n\n    for i in range(n_frames):\n        slots_left = n_frames - i - 1\n        candidates = [\n            size\n            for size in keys\n            if size not in chosen_sizes\n            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA\n        ]\n        if not candidates:\n            return None\n        weights = []\n        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))\n        for height, width in candidates:\n            area = height * width\n            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))\n        size = random.choices(candidates, weights=weights, k=1)[0]\n        chosen_sizes.append(size)\n        remaining -= size[0] * size[1]\n\n    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]\n    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)\n    return specs\n\n\ndef _choose_canvas_shape() -> tuple[int, int]:\n    grid_min, grid_max = GRID_SIZE_RANGE\n    rows = random.randint(grid_min, grid_max)\n    cols = random.randint(grid_min, grid_max)\n    if random.random() < NEAR_SQUARE_PROB:\n        delta = random.choice(NEAR_SQUARE_DELTAS)\n        cols = min(grid_max, max(grid_min, rows + delta))\n    return rows, cols\n\n\ndef _choose_palette() -> tuple[int, SlotColors]:\n    colors = random.sample(FOREGROUND_COLORS, PALETTE_SIZE)\n    frame_color = colors[0]\n    color_values = colors[1:]\n    random.shuffle(color_values)\n    slot_colors = {pos: color_values[i] for i, pos in enumerate(SLOT_POSITIONS)}\n    return frame_color, slot_colors\n\n\ndef _make_output_patch(heights: tuple[int, int], widths: tuple[int, int], frame_color: int, slot_colors: SlotColors) -> tuple[np.ndarray, list[int], list[int]]:\n    row_lines = _line_indices(heights)\n    col_lines = _line_indices(widths)\n    patch = np.zeros((row_lines[-1] + 1, col_lines[-1] + 1), dtype=int)\n    patch[row_lines, :] = int(frame_color)\n    patch[:, col_lines] = int(frame_color)\n\n    for sr, sc in SLOT_POSITIONS:\n        patch[row_lines[sr] + 1 : row_lines[sr + 1], col_lines[sc] + 1 : col_lines[sc + 1]] = slot_colors[(sr, sc)]\n    return patch, row_lines, col_lines\n\n\ndef _hint_providers(n_frames: int) -> dict[tuple[int, int], int]:\n    providers = [random.randrange(n_frames) for _ in SLOT_POSITIONS]\n    if len(set(providers)) == 1:\n        providers[random.randrange(len(providers))] = random.choice(\n            [idx for idx in range(n_frames) if idx != providers[0]]\n        )\n    return {pos: providers[i] for i, pos in enumerate(SLOT_POSITIONS)}\n\n\ndef _place_frames(rows: int, cols: int, specs: list[FrameSpec]) -> list[PlacedFrame] | None:\n    occ = np.zeros((rows, cols), dtype=int)\n    placed: list[PlacedFrame] = []\n    for heights, widths in specs:\n        height = sum(heights) + LATTICE_LINE_COUNT\n        width = sum(widths) + LATTICE_LINE_COUNT\n        block = np.ones((height, width), dtype=int)\n        try:\n            r0, c0 = random_free_location(occ, block, transparent=BG, border=EDGE_BORDER, padding=PLACEMENT_PADDING, padding_connectivity=PLACEMENT_CONNECTIVITY)\n        except ValueError:\n            return None\n        paste(occ, block, r0, c0)\n        placed.append((r0, c0, heights, widths))\n    return placed\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows, cols = _choose_canvas_shape()\n    n_frames = random.randint(*FRAME_COUNT_RANGE)\n    frame_color, slot_colors = _choose_palette()\n\n    specs = _choose_frame_specs(n_frames, rows, cols)\n    if specs is None:\n        return None\n\n    placed = _place_frames(rows, cols, specs)\n    if placed is None:\n        return None\n\n    out = np.full((rows, cols), BG, dtype=int)\n    line_data: list[tuple[int, int, list[int], list[int]]] = []\n    for r0, c0, heights, widths in placed:\n        patch, row_lines, col_lines = _make_output_patch(heights, widths, frame_color, slot_colors)\n        paste(out, patch, r0, c0)\n        line_data.append((r0, c0, row_lines, col_lines))\n\n    inp = out.copy()\n    providers = _hint_providers(n_frames)\n    for frame_idx, (r0, c0, row_lines, col_lines) in enumerate(line_data):\n        for sr, sc in SLOT_POSITIONS:\n            if providers[(sr, sc)] == frame_idx:\n                continue\n            rr0 = r0 + row_lines[sr] + 1\n            rr1 = r0 + row_lines[sr + 1]\n            cc0 = c0 + col_lines[sc] + 1\n            cc1 = c0 + col_lines[sc + 1]\n            inp[rr0:rr1, cc0:cc1] = BG\n\n    try:\n        if int(get_bg(inp)) != BG:\n            return None\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2e65ae53 input\")\n","exit_code":0,"status":"completed"}}
