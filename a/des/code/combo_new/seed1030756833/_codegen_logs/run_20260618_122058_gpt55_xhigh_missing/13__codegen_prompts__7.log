{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/7e2bad24.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend the diagonal blue ray through the grid, reflecting it off red line-segment mirrors.\n\n    Input structure\n    - Black-background grid with one diagonal 8-connected blue ray seed.\n    - Red foreground objects, when present, are straight horizontal or vertical mirror segments.\n    - Other foreground bars are transparent to the ray and may be overwritten where the ray crosses them.\n\n    Rule\n    - Start from the ray seed endpoint whose outward diagonal extension remains inside the grid.\n    - Paint the ray continuously in that diagonal direction until it leaves the grid.\n    - If the next cell is a red mirror, do not paint it; reflect by flipping the row direction on a horizontal mirror or the column direction on a vertical mirror.\n\n    Key insight\n    - The non-red bars are decoys: only red bars reflect the diagonal path, while all other crossed cells become blue.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    ray_color, seed = _ray_seed(g, bg)\n    r, c, dr, dc = _initial_state(g.shape, seed)\n    mirrors = _mirror_orientations(g, bg)\n\n    out = g.copy()\n    seen: set[tuple[int, int, int, int]] = set()\n    while True:\n        state = (r, c, dr, dc)\n        assert state not in seen, \"ray path must not loop\"\n        seen.add(state)\n\n        nr, nc = r + dr, c + dc\n        if not in_bounds(g.shape, nr, nc):\n            break\n\n        if int(g[nr, nc]) == Color.RED:\n            orientation = mirrors.get((nr, nc))\n            assert orientation is not None, \"red cell must belong to a mirror segment\"\n            if orientation == \"horizontal\":\n                dr = -dr\n            else:\n                assert orientation == \"vertical\"\n                dc = -dc\n            continue\n\n        out[nr, nc] = ray_color\n        r, c = nr, nc\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color layout.\nGRID_HEIGHT = 16\nGRID_WIDTH = 16\nBACKGROUND_COLOR = 0\n\n# Ray and seed sampling ranges.\nREFLECTION_COUNT_RANGE = (0, 4)\nSEED_LENGTH_RANGE = (3, 6)\nTOTAL_PATH_LENGTH_RANGE = (15, 16)\nNEW_CELLS_RANGE = (9, 13)\nDIAGONAL_CHOICES = (-1, 1)\nSTART_EDGES = (\"top\", \"bottom\", \"left\", \"right\")\n\n# Bar structure ranges and orientations.\nBAR_LENGTH_RANGE = (4, 14)\nMIRROR_ORIENTATIONS = [\"horizontal\", \"vertical\"]\nDECOY_COUNT_RANGE = (0, 3)\nDECOY_PLACEMENT_ATTEMPTS = 30\n\n# Rejection sampling budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _inside(r: int, c: int) -> bool:\n    return 0 <= r < GRID_HEIGHT and 0 <= c < GRID_WIDTH\n\n\ndef _random_start_state() -> tuple[int, int, int, int]:\n    \"\"\"Choose a boundary cell with a diagonal direction whose backward extension is OOB.\"\"\"\n    edge = random.choice(START_EDGES)\n    if edge == \"top\":\n        return 0, random.randint(0, GRID_WIDTH - 1), 1, random.choice(DIAGONAL_CHOICES)\n    if edge == \"bottom\":\n        return (\n            GRID_HEIGHT - 1,\n            random.randint(0, GRID_WIDTH - 1),\n            -1,\n            random.choice(DIAGONAL_CHOICES),\n        )\n    if edge == \"left\":\n        return random.randint(0, GRID_HEIGHT - 1), 0, random.choice(DIAGONAL_CHOICES), 1\n    return (\n        random.randint(0, GRID_HEIGHT - 1),\n        GRID_WIDTH - 1,\n        random.choice(DIAGONAL_CHOICES),\n        -1,\n    )\n\n\ndef _build_seed_cells(\n    r0: int,\n    c0: int,\n    dr: int,\n    dc: int,\n    seed_len: int,\n) -> list[tuple[int, int]] | None:\n    cells = []\n    for i in range(seed_len):\n        sr, sc = r0 + i * dr, c0 + i * dc\n        if not _inside(sr, sc):\n            return None\n        cells.append((sr, sc))\n    return cells\n\n\ndef _split_path_segments(new_cells_needed: int, n_reflections: int) -> list[int] | None:\n    \"\"\"Partition painted cells across straight ray segments before each reflection.\"\"\"\n    if n_reflections == 0:\n        return [new_cells_needed]\n    if new_cells_needed < n_reflections + 1:\n        return None\n\n    cuts = sorted(random.sample(range(1, new_cells_needed), n_reflections))\n    segments = []\n    prev = 0\n    for cut in cuts:\n        segments.append(cut - prev)\n        prev = cut\n    segments.append(new_cells_needed - prev)\n    return segments\n\n\ndef _walk_segment(\n    r: int,\n    c: int,\n    dr: int,\n    dc: int,\n    seg_len: int,\n    occupied: set[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> tuple[int, int] | None:\n    \"\"\"Append seg_len new ray cells and return the segment endpoint.\"\"\"\n    for _ in range(seg_len):\n        nr, nc = r + dr, c + dc\n        if not _inside(nr, nc) or (nr, nc) in occupied:\n            return None\n        path_cells.append((nr, nc))\n        occupied.add((nr, nc))\n        r, c = nr, nc\n    return r, c\n\n\ndef _reflected_direction(orientation: str, dr: int, dc: int) -> tuple[int, int]:\n    if orientation == \"horizontal\":\n        return -dr, dc\n    return dr, -dc\n\n\ndef _segment_start_bounds(anchor: int, length: int, limit: int) -> tuple[int, int] | None:\n    start_min = max(0, anchor - length + 1)\n    start_max = min(anchor, limit - length)\n    if start_min > start_max:\n        return None\n\n    interior_min = max(start_min, 1)\n    interior_max = min(start_max, limit - length - 1) if length < limit else start_max\n    if interior_min <= interior_max:\n        return interior_min, interior_max\n    return start_min, start_max\n\n\ndef _bar_cells_through(\n    orientation: str,\n    r: int,\n    c: int,\n    length: int,\n) -> list[tuple[int, int]] | None:\n    if orientation == \"horizontal\":\n        bounds = _segment_start_bounds(c, length, GRID_WIDTH)\n        if bounds is None:\n            return None\n        start = random.randint(*bounds)\n        return [(r, start + j) for j in range(length)]\n\n    bounds = _segment_start_bounds(r, length, GRID_HEIGHT)\n    if bounds is None:\n        return None\n    start = random.randint(*bounds)\n    return [(start + j, c) for j in range(length)]\n\n\ndef _try_place_mirror(\n    r: int,\n    c: int,\n    dr: int,\n    dc: int,\n    occupied: set[tuple[int, int]],\n) -> tuple[str, list[tuple[int, int]], int, int] | None:\n    \"\"\"Try both mirror orientations at the next ray cell and return the reflected direction.\"\"\"\n    mr, mc = r + dr, c + dc\n    if not _inside(mr, mc) or (mr, mc) in occupied:\n        return None\n\n    orientations = MIRROR_ORIENTATIONS.copy()\n    random.shuffle(orientations)\n    for orientation in orientations:\n        new_dr, new_dc = _reflected_direction(orientation, dr, dc)\n        next_r, next_c = r + new_dr, c + new_dc\n        if not _inside(next_r, next_c) or (next_r, next_c) in occupied:\n            continue\n\n        bar_len = random.randint(*BAR_LENGTH_RANGE)\n        bar_cells = _bar_cells_through(orientation, mr, mc, bar_len)\n        if bar_cells is None:\n            continue\n\n        bar_set = set(bar_cells)\n        if bar_set & occupied:\n            continue\n\n        occupied |= bar_set\n        return orientation, bar_cells, new_dr, new_dc\n    return None\n\n\ndef _random_decoy_cells(orientation: str, length: int) -> list[tuple[int, int]] | None:\n    if orientation == \"horizontal\":\n        row = random.randint(0, GRID_HEIGHT - 1)\n        start = random.randint(0, max(0, GRID_WIDTH - length))\n        start = max(1, min(start, GRID_WIDTH - length - 1))\n        if start < 0 or start + length > GRID_WIDTH:\n            return None\n        return [(row, start + j) for j in range(length)]\n\n    col = random.randint(0, GRID_WIDTH - 1)\n    start = random.randint(0, max(0, GRID_HEIGHT - length))\n    start = max(1, min(start, GRID_HEIGHT - length - 1))\n    if start < 0 or start + length > GRID_HEIGHT:\n        return None\n    return [(start + j, col) for j in range(length)]\n\n\ndef _place_decoys(\n    occupied: set[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> list[list[tuple[int, int]]]:\n    decoy_bars = []\n    path_set = set(path_cells)\n    for _ in range(random.randint(*DECOY_COUNT_RANGE)):\n        orientation = random.choice(MIRROR_ORIENTATIONS)\n        length = random.randint(*BAR_LENGTH_RANGE)\n\n        for _ in range(DECOY_PLACEMENT_ATTEMPTS):\n            cells = _random_decoy_cells(orientation, length)\n            if cells is None:\n                continue\n\n            cell_set = set(cells)\n            if cell_set & occupied:\n                continue\n            if len(cell_set & path_set) > 2:\n                continue\n\n            decoy_bars.append(cells)\n            occupied |= cell_set\n            break\n    return decoy_bars\n\n\ndef _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:\n    for r, c in cells:\n        grid[r, c] = color\n\n\ndef _render_input(\n    seed_cells: list[tuple[int, int]],\n    mirror_bars: list[tuple[str, list[tuple[int, int]]]],\n    decoy_bars: list[list[tuple[int, int]]],\n) -> np.ndarray:\n    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)\n    _paint_cells(grid, seed_cells, Color.BLUE)\n    for _orientation, bar_cells in mirror_bars:\n        _paint_cells(grid, bar_cells, Color.RED)\n    for cells in decoy_bars:\n        _paint_cells(grid, cells, Color.GREEN)\n    return grid\n\n\ndef _matches_solver_oracle(\n    grid: np.ndarray,\n    seed_cells: list[tuple[int, int]],\n    path_cells: list[tuple[int, int]],\n) -> bool:\n    try:\n        output = main(grid)\n    except Exception:\n        return False\n\n    expected = grid.copy()\n    _paint_cells(expected, path_cells, Color.BLUE)\n    if not np.array_equal(output, expected):\n        return False\n\n    new_count = len(path_cells)\n    total_path = len(seed_cells) + new_count\n    return (\n        NEW_CELLS_RANGE[0] <= new_count <= NEW_CELLS_RANGE[1]\n        and TOTAL_PATH_LENGTH_RANGE[0] <= total_path <= TOTAL_PATH_LENGTH_RANGE[1]\n    )\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_reflections = random.randint(*REFLECTION_COUNT_RANGE)\n    r0, c0, dr, dc = _random_start_state()\n    br, bc = r0 - dr, c0 - dc\n    if _inside(br, bc):\n        return None\n\n    seed_len = random.randint(*SEED_LENGTH_RANGE)\n    seed_cells = _build_seed_cells(r0, c0, dr, dc, seed_len)\n    if seed_cells is None:\n        return None\n\n    total_target = random.randint(*TOTAL_PATH_LENGTH_RANGE)\n    new_cells_needed = total_target - seed_len\n    segments = _split_path_segments(new_cells_needed, n_reflections)\n    if segments is None:\n        return None\n\n    r, c = seed_cells[-1]\n    cur_dr, cur_dc = dr, dc\n    occupied = set(seed_cells)\n    path_cells: list[tuple[int, int]] = []\n    mirror_bars: list[tuple[str, list[tuple[int, int]]]] = []\n\n    for seg_idx, seg_len in enumerate(segments):\n        endpoint = _walk_segment(r, c, cur_dr, cur_dc, seg_len, occupied, path_cells)\n        if endpoint is None:\n            return None\n        r, c = endpoint\n\n        if seg_idx < n_reflections:\n            placed_mirror = _try_place_mirror(r, c, cur_dr, cur_dc, occupied)\n            if placed_mirror is None:\n                return None\n            orientation, bar_cells, cur_dr, cur_dc = placed_mirror\n            mirror_bars.append((orientation, bar_cells))\n\n    final_nr, final_nc = r + cur_dr, c + cur_dc\n    if _inside(final_nr, final_nc):\n        return None\n\n    decoy_bars = _place_decoys(occupied, path_cells)\n    grid = _render_input(seed_cells, mirror_bars, decoy_bars)\n    if not _matches_solver_oracle(grid, seed_cells, path_cells):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/bae5c565.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/bae5c565.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.\n\n    Input structure\n    - The top row is a palette row with exactly one background gap.\n    - Below it, the only foreground is one vertical marker bar of a single color.\n    - The marker bar is either in the gap column or immediately beside it.\n\n    Rule\n    - Clear the grid to background.\n    - Starting at the top of the marker bar, each next row copies one more\n      column of the top-row palette on both sides of the gap.\n    - Fill the gap column with the marker color, and keep the vertical marker bar.\n\n    Key insight\n    - The lone background cell in the top row is the center of the expanding\n      copy; the lower vertical bar provides the center color and the row where\n      the expansion begins.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    height, width = g.shape\n\n    bg = get_bg(g)\n    top = g[0, :]\n    gap_cols = np.flatnonzero(top == bg)\n    assert gap_cols.size == 1, \"expected exactly one background gap in the top row\"\n    gap_col = int(gap_cols[0])\n\n    lower_coords = np.argwhere(g[1:, :] != bg)\n    assert lower_coords.size > 0, \"expected a lower marker bar\"\n    lower_coords[:, 0] += 1\n\n    marker_colors = {int(g[r, c]) for r, c in lower_coords}\n    marker_cols = {int(c) for _r, c in lower_coords}\n    assert len(marker_colors) == 1, \"expected one lower marker color\"\n    assert len(marker_cols) == 1, \"expected one lower marker column\"\n    marker = marker_colors.pop()\n    line_col = marker_cols.pop()\n    line_start = int(lower_coords[:, 0].min())\n\n    assert np.all(g[1:line_start, :] == bg), \"rows before the marker bar must be background\"\n    assert np.all(g[line_start:, line_col] == marker), \"marker bar must be solid\"\n    assert lower_coords.shape[0] == height - line_start, \"marker bar must be the only lower foreground\"\n    assert line_col == gap_col or abs(line_col - gap_col) == 1\n    if line_col != gap_col:\n        assert top[line_col] == marker\n    assert np.all(top[np.arange(width) != gap_col] != bg), \"only the gap may be background in the palette row\"\n\n    out = np.full_like(g, bg)\n    out[line_start:, line_col] = marker\n\n    for r in range(line_start, height):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(width - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            if radius == 0 and c == gap_col and line_col != gap_col:\n                continue\n            out[r, c] = marker if c == gap_col else int(top[c])\n        out[r, line_col] = marker\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas, structure, and retries.\n_CANVAS_SIZES = (9, 11, 13)\n_LINE_START_MIN = 2\n_MAX_ATTEMPTS = 300\n# Color roles.\n_BACKGROUND, _MARKER = 5, 8\n_PALETTE_COLORS = (0, 1, 2, 3, 4, 6, 7, 8, 9)\n\n\ndef _gen_expected_output(inp: np.ndarray, line_start: int) -> np.ndarray:\n    n = inp.shape[0]\n    gap_col = n // 2\n    out = np.full_like(inp, _BACKGROUND)\n    top = inp[0]\n\n    for r in range(line_start, n):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(n - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            out[r, c] = _MARKER if c == gap_col else int(top[c])\n\n    return out\n\n\ndef _make_input_grid(n: int, line_start: int) -> np.ndarray:\n    gap_col = n // 2\n    inp = np.full((n, n), _BACKGROUND, dtype=int)\n    for c in range(n):\n        if c != gap_col:\n            inp[0, c] = random.choice(_PALETTE_COLORS)\n    inp[line_start:, gap_col] = _MARKER\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.choice(_CANVAS_SIZES)\n    line_start = random.randint(_LINE_START_MIN, n // 2 - 1)\n    inp = _make_input_grid(n, line_start)\n    expected = _gen_expected_output(inp, line_start)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid bae5c565 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/e39e9282.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p; /''^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/e39e9282.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n\n    Input structure\n    The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\n    Rule\n    Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\n    Key insight\n    The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g)))\n    assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}\n    assert Color.MAROON in colors\n\n    squares = _squares(g, bg)\n    out = g.copy()\n    out[g == Color.GREY] = bg\n\n    paint: set[tuple[int, int]] = set()\n    remove_sources: list[tuple[int, int]] = []\n    pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}\n    for r, c in np.argwhere(g == Color.MAROON):\n        hits = []\n        for idx, square in enumerate(squares):\n            side = _touch_side(int(r), int(c), square)\n            if side is not None:\n                hits.append((side, idx, square))\n        assert len(hits) == 1\n\n        side, idx, square = hits[0]\n        if square[4] == Color.PINK:\n            pink_markers_by_square.setdefault(idx, []).append((int(r), int(c), side))\n            remove_sources.append((int(r), int(c)))\n        else:\n            target = _target_for_marker(int(r), int(c), side, square)\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for idx, markers in pink_markers_by_square.items():\n        square = squares[idx]\n        for target in _pink_targets_for_markers(markers, square):\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for r, c in remove_sources:\n        out[r, c] = bg\n    for r, c in paint:\n        out[r, c] = Color.MAROON\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste\n\n\n# Colors.\n_GEN_BG = 8\n_GEN_GREY = 5\n_GEN_PINK = 6\n_GEN_MAROON = 9\n\n# Canvas and square geometry.\n_GEN_CANVAS_MIN = 9\n_GEN_CANVAS_MAX = 15\n_GEN_CANVAS_MAX_DELTA = 2\n_GEN_SQUARE_SIZE = 3\n_GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1\n_GEN_SQUARE_GAP = 1\n\n# Square count bounds.\n_GEN_TOTAL_SQUARE_MIN = 1\n_GEN_TOTAL_SQUARE_MAX = 7\n_GEN_GREY_SQUARE_MAX = 3\n_GEN_PINK_SQUARE_MAX = 4\n\n# Marker side and count bounds.\n_GEN_SIDES = (\"left\", \"right\", \"above\", \"below\")\n_GEN_MARKER_SIDE_MIN = 1\n_GEN_MARKER_SIDE_MAX = 3\n_GEN_MARKER_PER_SIDE_MAX = 3\n_GEN_MARKER_TOTAL_MAX = 5\n\n# Rejection sampling budget.\n_GEN_MAX_ATTEMPTS = 300\n_GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}\n\n_GenSquare = tuple[int, int, int]\n_GenMarker = tuple[int, int, str]\n\n\ndef _gen_square_gap_ok(r0: int, c0: int, squares: list[_GenSquare]) -> bool:\n    last = _GEN_SQUARE_LAST\n    gap = _GEN_SQUARE_GAP\n    r1, c1 = r0 + last, c0 + last\n    for sr0, sc0, _color in squares:\n        sr1, sc1 = sr0 + last, sc0 + last\n        if not (\n            r1 < sr0 - gap\n            or sr1 < r0 - gap\n            or c1 < sc0 - gap\n            or sc1 < c0 - gap\n        ):\n            return False\n    return True\n\n\ndef _gen_place_square(grid: np.ndarray, r0: int, c0: int, color: int) -> None:\n    paste(grid, _GEN_SQUARE_PATCHES[int(color)], r0, c0)\n\n\ndef _gen_side_for_cell(r: int, c: int, square: _GenSquare) -> str | None:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _gen_inside_square(r: int, c: int, square: _GenSquare) -> bool:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    return r0 <= r <= r1 and c0 <= c <= c1\n\n\ndef _gen_valid_marker_slot(r: int, c: int, squares: list[_GenSquare]) -> bool:\n    if any(_gen_inside_square(r, c, square) for square in squares):\n        return False\n    hits = sum(\n        _gen_side_for_cell(r, c, square) is not None for square in squares\n    )\n    return hits == 1\n\n\ndef _gen_side_slots(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> dict[str, list[tuple[int, int]]]:\n    r0, c0, _color = square\n    edge = _GEN_SQUARE_SIZE\n    raw = {\n        \"left\": [(r, c0 - 1) for r in range(r0, r0 + edge)] if c0 > 0 else [],\n        \"right\": [(r, c0 + edge) for r in range(r0, r0 + edge)] if c0 + edge < W else [],\n        \"above\": [(r0 - 1, c) for c in range(c0, c0 + edge)] if r0 > 0 else [],\n        \"below\": [(r0 + edge, c) for c in range(c0, c0 + edge)] if r0 + edge < H else [],\n    }\n    return {\n        side: [\n            (r, c)\n            for r, c in slots\n            if _gen_valid_marker_slot(r, c, squares)\n        ]\n        for side, slots in raw.items()\n    }\n\n\ndef _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:\n    counts: list[int] = []\n    remaining = int(total)\n    for i, cap in enumerate(caps):\n        rest = caps[i + 1 :]\n        lo = max(1, remaining - sum(rest))\n        hi = min(int(cap), remaining - len(rest))\n        if lo > hi:\n            return None\n        count = random.randint(lo, hi)\n        counts.append(count)\n        remaining -= count\n    return counts if remaining == 0 else None\n\n\ndef _gen_choose_square_markers(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> list[_GenMarker] | None:\n    slots_by_side = _gen_side_slots(H, W, square, squares)\n    options = [\n        (side, slots_by_side[side])\n        for side in _GEN_SIDES\n        if slots_by_side[side]\n    ]\n    if not options:\n        return None\n\n    possible_side_counts = [\n        k\n        for k in range(_GEN_MARKER_SIDE_MIN, min(_GEN_MARKER_SIDE_MAX, len(options)) + 1)\n        if any(\n            sum(min(_GEN_MARKER_PER_SIDE_MAX, len(slots)) for _side, slots in combo) >= k\n            for combo in itertools.combinations(options, k)\n        )\n    ]\n    if not possible_side_counts:\n        return None\n\n    side_count = random.choice(possible_side_counts)\n    combos = [\n        combo\n        for combo in itertools.combinations(options, side_count)\n        if sum(min(_GEN_MARKER_PER_SIDE_MAX, len(slots)) for _side, slots in combo) >= side_count\n    ]\n    combo = list(random.choice(combos))\n    random.shuffle(combo)\n    caps = [min(_GEN_MARKER_PER_SIDE_MAX, len(slots)) for _side, slots in combo]\n    marker_total = random.randint(side_count, min(_GEN_MARKER_TOTAL_MAX, sum(caps)))\n    counts = _gen_split_marker_total(marker_total, caps)\n    if counts is None:\n        return None\n\n    markers: list[_GenMarker] = []\n    for (side, slots), count in zip(combo, counts):\n        for r, c in random.sample(slots, count):\n            markers.append((r, c, side))\n    return markers\n\n\ndef _gen_target_for_marker(r: int, c: int, side: str, square: _GenSquare) -> tuple[int, int]:\n    r0, c0, color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    if color == _GEN_PINK:\n        if side in {\"left\", \"right\"}:\n            return r, (c0 + c1) // 2\n        return (r0 + r1) // 2, c\n    if side == \"left\":\n        return r, c0\n    if side == \"right\":\n        return r, c1\n    if side == \"above\":\n        return r0, c\n    return r1, c\n\n\ndef _gen_pink_targets_for_markers(markers: list[_GenMarker], square: _GenSquare) -> set[tuple[int, int]]:\n    _r0, _c0, color = square\n    assert color == _GEN_PINK\n    return {_gen_target_for_marker(r, c, side, square) for r, c, side in markers}\n\n\ndef _gen_choose_square_colors() -> list[int]:\n    total = random.randint(_GEN_TOTAL_SQUARE_MIN, _GEN_TOTAL_SQUARE_MAX)\n    grey_min = max(0, total - _GEN_PINK_SQUARE_MAX)\n    grey_max = min(_GEN_GREY_SQUARE_MAX, total)\n    grey_count = random.randint(grey_min, grey_max)\n    colors = [_GEN_GREY] * grey_count + [_GEN_PINK] * (total - grey_count)\n    random.shuffle(colors)\n    return colors\n\n\ndef _gen_choose_canvas_shape() -> tuple[int, int]:\n    H = random.randint(_GEN_CANVAS_MIN, _GEN_CANVAS_MAX)\n    W = random.randint(\n        max(_GEN_CANVAS_MIN, H - _GEN_CANVAS_MAX_DELTA),\n        min(_GEN_CANVAS_MAX, H + _GEN_CANVAS_MAX_DELTA),\n    )\n    return H, W\n\n\ndef _gen_place_squares(H: int, W: int, colors: list[int]) -> list[_GenSquare] | None:\n    squares: list[_GenSquare] = []\n    for color in colors:\n        candidates = [\n            (r0, c0)\n            for r0 in range(H - _GEN_SQUARE_SIZE + 1)\n            for c0 in range(W - _GEN_SQUARE_SIZE + 1)\n            if _gen_square_gap_ok(r0, c0, squares)\n        ]\n        if not candidates:\n            return None\n        r0, c0 = random.choice(candidates)\n        squares.append((r0, c0, int(color)))\n    return squares\n\n\ndef _gen_choose_all_markers(H: int, W: int, squares: list[_GenSquare]) -> list[list[_GenMarker]] | None:\n    markers_by_square: list[list[_GenMarker]] = []\n    for square in squares:\n        markers = _gen_choose_square_markers(H, W, square, squares)\n        if markers is None:\n            return None\n        markers_by_square.append(markers)\n    return markers_by_square\n\n\ndef _gen_render_output(H: int, W: int, squares: list[_GenSquare], markers_by_square: list[list[_GenMarker]]) -> np.ndarray:\n    out = np.full((H, W), _GEN_BG, dtype=int)\n    for r0, c0, color in squares:\n        if color == _GEN_PINK:\n            _gen_place_square(out, r0, c0, color)\n\n    for square, markers in zip(squares, markers_by_square):\n        color = square[2]\n        if color == _GEN_PINK:\n            for tr, tc in _gen_pink_targets_for_markers(markers, square):\n                out[tr, tc] = _GEN_MAROON\n        else:\n            for r, c, side in markers:\n                tr, tc = _gen_target_for_marker(r, c, side, square)\n                out[r, c] = _GEN_MAROON\n                out[tr, tc] = _GEN_MAROON\n    return out\n\n\ndef _gen_build_input(out: np.ndarray, squares: list[_GenSquare], markers_by_square: list[list[_GenMarker]]) -> np.ndarray:\n    inp = out.copy()\n    for (r0, c0, color), markers in zip(squares, markers_by_square):\n        _gen_place_square(inp, r0, c0, color)\n        if color == _GEN_PINK:\n            for r, c, _side in markers:\n                inp[r, c] = _GEN_MAROON\n    return inp\n\n\ndef _gen_background_dominates(grid: np.ndarray) -> bool:\n    counts = {int(v): int((grid == v).sum()) for v in np.unique(grid)}\n    return counts.get(_GEN_BG, 0) > max(\n        counts.get(_GEN_GREY, 0),\n        counts.get(_GEN_PINK, 0),\n        counts.get(_GEN_MAROON, 0),\n    )\n\n\ndef _gen_oracle_accepts(inp: np.ndarray, expected: np.ndarray) -> bool:\n    try:\n        solved = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(solved, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H, W = _gen_choose_canvas_shape()\n    colors = _gen_choose_square_colors()\n\n    squares = _gen_place_squares(H, W, colors)\n    if squares is None:\n        return None\n\n    markers_by_square = _gen_choose_all_markers(H, W, squares)\n    if markers_by_square is None:\n        return None\n\n    out = _gen_render_output(H, W, squares, markers_by_square)\n    inp = _gen_build_input(out, squares, markers_by_square)\n    if not _gen_background_dominates(inp):\n        return None\n    if not _gen_oracle_accepts(inp, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e39e9282 input\")\n","exit_code":0,"status":"completed"}}
