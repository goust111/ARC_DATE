{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p' /home/lixinyu/snap/new/ARC_code/train/412b6263.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n\n    Input structure:\n    - Blue is absent from the input.\n    - One rare marker color appears in exactly two pixels.\n    - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n    - The whole grid, including background and foreground objects, is the sprite to transform.\n\n    Rule:\n    - Rotate the entire input grid 90 degrees counterclockwise.\n    - Create a blue one-pixel frame around two vertical copies of the rotated grid.\n    - Use the input background color for the two endpoints of every horizontal frame/separator row.\n\n    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg, objects = _infer_background_and_objects(g)\n    assert bg != Color.BLUE\n    assert Color.BLUE not in set(map(int, g.ravel()))\n\n    copies = len(objects)\n\n    tile = np.rot90(g, 1)\n    tile_h, tile_w = map(int, tile.shape)\n\n    out_h = copies * tile_h + copies + 1\n    out_w = tile_w + 2\n    out = np.full((out_h, out_w), Color.BLUE, dtype=int)\n\n    for i in range(copies):\n        row = i * (tile_h + 1)\n        out[row, 0] = bg\n        out[row, -1] = bg\n        paste(out, tile, row + 1, 1)\n\n    out[-1, 0] = bg\n    out[-1, -1] = bg\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n# CFG: ranges use numpy's high-exclusive convention where applicable.\nCANVAS_SHAPE_RANGES = ((5, 10), (5, 11))\nOBJECT_SHAPE_RANGES = ((2, 5), (2, 5))\nMIN_SEPARATION_GAP = 1\nMAX_OUTPUT_SIZE = 30\nINPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]\nPALETTE_SIZE = 3\nFRAME_COLOR = Color.BLUE\nOUTPUT_TILE_COPIES = 2\nFRAME_THICKNESS = 1\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _edge_cells(h: int, w: int) -> list[tuple[int, int]]:\n    return [\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    ]\n\ndef _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:\n    tile = np.rot90(inp, 1)\n    tile_h, tile_w = tile.shape\n    out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS\n    out_w = tile_w + 2 * FRAME_THICKNESS\n    out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)\n    out[0, 0] = out[0, -1] = bg\n    out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg\n    out[-1, 0] = out[-1, -1] = bg\n    out[FRAME_THICKNESS : FRAME_THICKNESS + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    second_top = tile_h + 2 * FRAME_THICKNESS\n    out[second_top : second_top + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    return out\n\ndef _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:\n    feasible_dims = [\n        (oh, ow)\n        for oh in range(*OBJECT_SHAPE_RANGES[0])\n        for ow in range(*OBJECT_SHAPE_RANGES[1])\n        if oh <= canvas_h and ow <= canvas_w and (\n            canvas_h - 2 * oh >= MIN_SEPARATION_GAP\n            or canvas_w - 2 * ow >= MIN_SEPARATION_GAP\n        )\n    ]\n    if not feasible_dims:\n        return None\n    return feasible_dims[int(np.random.randint(len(feasible_dims)))]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))\n    W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))\n\n    dims = _sample_object_dims(H, W)\n    if dims is None:\n        return None\n    oh, ow = dims\n\n    bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))\n    inp = np.full((H, W), bg, dtype=int)\n    inp[:oh, :ow] = body\n    inp[H - oh : H, W - ow : W] = body\n    mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]\n    inp[mr, mc] = marker\n    inp[H - oh + mr, W - ow + mc] = marker\n\n    expected = _expected_output(inp, bg)\n    if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:\n        return None\n\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"我已经看了前几份参考，重点是它们都用 oracle 自检来过滤生成样例。接下来补读剩余参考的入口和生成器收尾，然后会按同样模式实现：先构造满足规则的输入，再让 `main()` 反验。"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p; /def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p; /def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n        cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n        import itertools\n\n        best_perm = None\n        best_score = None\n        for perm in itertools.permutations(range(len(anchor_groups))):\n            ok = True\n            hits = 0\n            dist_sum = 0\n            for ci, gi in enumerate(perm):\n                if not compatible(ci, gi):\n                    ok = False\n                    break\n                hits += 1\n                dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n            if not ok:\n                continue\n            score = (int(hits), -int(dist_sum))\n            if best_score is None or score > best_score:\n                best_score = score\n                best_perm = perm\n        assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n        group_for_comp = [int(x) for x in best_perm]\n    else:\n        group_for_comp = []\n        for ci, comp in enumerate(mov_comps):\n            best_g = None\n            best_d = None\n            for gi, grp in enumerate(anchor_groups):\n                if not compatible(ci, gi):\n                    continue\n                d = bbox_gap(comp[\"bbox\"], grp[\"bbox\"])\n                if best_d is None or d < best_d:\n                    best_d = d\n                    best_g = gi\n            group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\"bbox\"])))\n\n    for comp, gi in zip(mov_comps, group_for_comp):\n        grp = anchor_groups[gi]\n        placed_grp = placed_groups[gi]\n        sock = grp[\"socket_mask\"]\n        cav = grp[\"cavity_mask\"]\n        cav_bbox = grp[\"cavity_bbox\"]\n        odr, odc = grp[\"open_dir\"]\n        # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\n        # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\n        # tools: swapping is ambiguous and not needed.)\n        comp_vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_counts = Counter(comp_vals)\n\n        best_state = None\n        # Score prioritizes *filling the cavity* with exactly one tool color region.\n        # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\n        best_score = None\n        cav_sz = int(grp[\"cavity_size\"])\n        for p, m, is_flip in gen_variants(comp[\"patch\"], comp[\"mask\"]):\n            h, w = m.shape\n            coords = np.argwhere(m)\n            cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\n            plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\n            assert plug_colors\n            for r0 in range(0, H - h + 1):\n                for c0 in range(0, W - w + 1):\n                    ok = True\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if placed_global[r, c]:\n                            ok = False\n                            break\n                    if not ok:\n                        continue\n                    adj = 0\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            r2, c2 = r + dr, c + dc\n                            if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\n                                adj += 1\n                    if adj == 0:\n                        continue\n                    socket_hits = 0\n                    cavity_hits = 0\n                    outside = 0\n                    # Best plug-match for this placement among candidate plug colors.\n                    plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if sock[r, c]:\n                            socket_hits += 1\n                        if cav[r, c]:\n                            cavity_hits += 1\n                        # Count pixels placed outside the anchor bbox in the dominant open direction.\n                        br0, bc0, br1, bc1 = grp[\"bbox\"]\n                        if odc == -1 and c < bc0:\n                            outside += 1\n                        elif odc == 1 and c > bc1:\n                            outside += 1\n                        elif odr == -1 and r < br0:\n                            outside += 1\n                        elif odr == 1 and r > br1:\n                            outside += 1\n\n                    for plug_col in plug_colors:\n                        if plug_col is None:\n                            plug_score = (0, 0, 0, 0)\n                        else:\n                            plug_hits = 0\n                            plug_outside = 0\n                            nonplug_in_cav = 0\n                            for rr, cc in coords:\n                                r = int(r0 + rr)\n                                c = int(c0 + cc)\n                                in_cav = bool(cav[r, c])\n                                col = int(p[rr, cc])\n                                if col == int(plug_col):\n                                    if in_cav:\n                                        plug_hits += 1\n                                    else:\n                                        plug_outside += 1\n                                else:\n                                    if in_cav:\n                                        nonplug_in_cav += 1\n                            plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\n                            plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\n                        if plug_best is None or plug_score > plug_best:\n                            plug_best = plug_score\n                    dist = bbox_gap(grp[\"bbox\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\n                    score = tuple(plug_best) + (\n                        int(cavity_hits),\n                        int(adj),\n                        int(outside),\n                        int(socket_hits),\n                        -int(dist),\n                        -int(r0),\n                        -int(c0),\n                    )\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best_state = (p, m, int(r0), int(c0), bool(is_flip))\n\n        assert best_state is not None, 'must find a valid placement for every movable tool'\n        p, m, r0, c0, is_flip = best_state\n        if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\n            a, b = sorted(comp_counts.keys())\n            q = p.copy()\n            q[(p == a) & m] = b\n            q[(p == b) & m] = a\n            p = q\n        for rr, cc in np.argwhere(m):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            out[r, c] = int(p[rr, cc])\n            placed_global[r, c] = True\n            placed_grp[r, c] = True\n\n    return out\n\n# --------------- generator (O4) ---------------\n\nfrom arc_utils import bbox as _bbox\n\n# ── CFG: canvas ──\nGRID_H_RANGE = (18, 30)          # output grid height\nGRID_W_RANGE = (25, 30)          # output grid width\nNUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs\n\n# ── CFG: frame geometry ──\nFRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)\nNOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)\nTOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)\nBOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)\nPLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n\n\n# ── CFG: tool sizing ──\nHANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)\nTOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels\nHANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)\n\n# ── CFG: placement ──\nUNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes\nFRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes\nTOOL_BORDER = 1                  # border margin for free tool placement\nTOOL_PADDING = 3                 # padding around existing content\nTOOL_PADDING_CONN = 4            # connectivity for padding check\n\n# ── CFG: retry limits ──\nPAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs\nHANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite\nGEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()\n\n\ndef _bbox_gap(a, b) -> int:\n    \"\"\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\"\"\"\n    (ar0, ac0, ar1, ac1) = a\n    (br0, bc0, br1, bc1) = b\n\n    def _gap1(x0, x1, y0, y1):\n        if y1 < x0:\n            return x0 - y1\n        if x1 < y0:\n            return y0 - x1\n        return 0\n\n    return _gap1(ar0, ar1, br0, br1) + _gap1(ac0, ac1, bc0, bc1)\n\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    \"\"\"Apply rot90(k) then optional horizontal flip.\"\"\"\n    out = np.rot90(arr, k)\n    if flip:\n        out = np.fliplr(out)\n    return out\n\n\ndef _orient_left_to_side(arr: np.ndarray, side: str) -> np.ndarray:\n    \"\"\"Rotate/flip an array built for the left border to target the given side.\"\"\"\n    if side == \"left\":\n        return arr.copy()\n    if side == \"right\":\n        return np.fliplr(arr)\n    if side == \"top\":\n        return np.rot90(arr, 3)\n    if side == \"bottom\":\n        return np.rot90(arr, 1)\n    raise ValueError(side)\n\n\ndef _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:\n    \"\"\"Swap two colors in a patch, returning a new array.\"\"\"\n    out = patch.copy()\n    ma, mb = out == a, out == b\n    out[ma] = b\n    out[mb] = a\n    return out\n\n\ndef _notch_offsets(notch_n: int, fw: int, bot_h: int) -> list[tuple[int, int]]:\n    \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n    if notch_n == 1:\n        return [(0, fw - 1)]\n    if notch_n == 2:\n        return [(0, fw - 2), (0, fw - 1)]\n    if notch_n == 3:\n        if bot_h >= 2:\n            return [(0, fw - 2), (0, fw - 1), (1, fw - 1)]\n        return [(0, fw - 3), (0, fw - 2), (0, fw - 1)]\n    raise ValueError(notch_n)\n\n\ndef _make_handle_sprite(handle_area: int, bg: int, handle_color: int) -> np.ndarray | None:\n    \"\"\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\"\"\"\n    lo, hi = HANDLE_SPRITE_DIM\n    dims = [(h, w) for h in range(lo, hi) for w in range(lo, hi)\n            if handle_area <= h * w <= handle_area * 2]\n    if not dims:\n        return None\n    for _ in range(HANDLE_SPRITE_RETRIES):\n        h, w = random.choice(dims)\n        sprite = random_sprite(\n            h, w, density=handle_area / (h * w),\n            color_palette=[handle_color], connectivity=4, background=bg,\n        )\n        if int(np.sum(sprite != bg)) == handle_area:\n            return sprite\n    return None\n\n\ndef _build_left_pair(\n    *, bg: int, frame_color: int, plug_color: int, handle_color: int,\n    fw: int, top_h: int, bot_h: int, notch_n: int, handle_area: int,\n) -> tuple[np.ndarray, np.ndarray] | None:\n    \"\"\"Build a frame + docked tool pair oriented for the left border.\n\n    Returns (frame_array, tool_array) on the same canvas, or None on failure.\n    \"\"\"\n    fh = top_h + 1 + bot_h\n    frame = np.full((fh, fw), bg, dtype=int)\n    frame[:top_h, :] = frame_color\n    frame[top_h + 1:, :] = frame_color\n    for dr, dc in _notch_offsets(notch_n, fw, bot_h):\n        frame[top_h + 1 + dr, dc] = bg\n\n    cavity = frame == bg\n    attach_rows = {r for r in range(fh) if cavity[r, fw - 1]}\n\n    handle_sprite = _make_handle_sprite(handle_area, bg, handle_color)\n    if handle_sprite is None:\n        return None\n\n    hs_h, hs_w = handle_sprite.shape\n    sprite_left_rows = {r for r in range(hs_h) if handle_sprite[r, 0] != bg}\n\n    valid_offsets = [\n        voff for voff in range(fh)\n        if any((voff + sr) in attach_rows for sr in sprite_left_rows)\n    ]\n    if not valid_offsets:\n        return None\n\n    voff = random.choice(valid_offsets)\n    total_h = max(fh, voff + hs_h)\n    total_w = fw + hs_w\n\n    frame_full = np.full((total_h, total_w), bg, dtype=int)\n    frame_full[:fh, :fw] = frame\n\n    tool = np.full((total_h, total_w), bg, dtype=int)\n    tool[:fh, :fw][cavity] = plug_color\n    handle_mask = handle_sprite != bg\n    tool[voff:voff + hs_h, fw:fw + hs_w][handle_mask] = handle_color\n\n    return frame_full, tool\n\n\ndef _build_param_options() -> list[tuple[int, int, int, int]]:\n    \"\"\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\"\"\"\n    fw_lo, fw_hi = FRAME_W_RANGE\n    nn_lo, nn_hi = NOTCH_N_RANGE\n    th_lo, th_hi = TOP_H_RANGE\n    bh_lo, bh_hi = BOT_H_RANGE\n    pa_lo, pa_hi = PLUG_AREA_BOUNDS\n    return [\n        (fw, top_h, bot_h, notch_n)\n        for fw in range(fw_lo, fw_hi)\n        for notch_n in range(nn_lo, nn_hi)\n        if pa_lo <= fw + notch_n <= pa_hi\n        for top_h in range(th_lo, th_hi)\n        for bot_h in range(bh_lo, bh_hi)\n    ]\n\n\nPARAM_OPTIONS = _build_param_options()\n\n\ndef _pick_pair_specs(num_pairs: int) -> list[dict]:\n    \"\"\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\"\"\"\n    ha_lo, ha_hi = HANDLE_AREA_RANGE\n    tt_lo, tt_hi = TOOL_TOTAL_BOUNDS\n    specs: list[dict] = []\n    for _ in range(PAIR_SPEC_RETRIES):\n        specs.clear()\n        used_plug_areas: set[int] = set()\n        for _ in range(num_pairs):\n            candidates = [x for x in PARAM_OPTIONS if x[0] + x[3] not in used_plug_areas]\n            if not candidates:\n                specs = []\n                break\n            fw, top_h, bot_h, notch_n = random.choice(candidates)\n            plug_area = fw + notch_n\n            specs.append({\"fw\": fw, \"top_h\": top_h, \"bot_h\": bot_h,\n                          \"notch_n\": notch_n, \"plug_area\": plug_area})\n            used_plug_areas.add(plug_area)\n        if len(specs) != num_pairs:\n            continue\n        all_plug_areas = {s[\"plug_area\"] for s in specs}\n        ok = True\n        for spec in specs:\n            pa = spec[\"plug_area\"]\n            handle_choices = [\n                h for h in range(ha_lo, ha_hi)\n                if tt_lo <= pa + h <= tt_hi and h != pa and h not in all_plug_areas\n            ]\n            if not handle_choices:\n                ok = False\n                break\n            spec[\"handle_area\"] = random.choice(handle_choices)\n        if ok:\n            return [dict(s) for s in specs]\n    return []\n\n\ndef _candidate_origins(side: str, ph: int, pw: int, H: int, W: int) -> list[tuple[int, int]]:\n    \"\"\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\"\"\"\n    if side == \"left\":\n        origins = [(r0, 0) for r0 in range(H - ph + 1)]\n    elif side == \"right\":\n        origins = [(r0, W - pw) for r0 in range(H - ph + 1)]\n    elif side == \"top\":\n        origins = [(0, c0) for c0 in range(W - pw + 1)]\n    elif side == \"bottom\":\n        origins = [(H - ph, c0) for c0 in range(W - pw + 1)]\n    else:\n        raise ValueError(side)\n    random.shuffle(origins)\n    return origins\n\n\ndef _variant_choices(patch: np.ndarray) -> list[tuple[np.ndarray, bool]]:\n    \"\"\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\"\"\"\n    seen = set()\n    out: list[tuple[np.ndarray, bool]] = []\n    mask = patch != 0\n    for k in range(4):\n        for flip in (False, True):\n            q = _transform(patch, k, flip)\n            m = _transform(mask.astype(np.uint8), k, flip).astype(bool)\n            key = (m.tobytes(), q[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            out.append((q, flip))\n    random.shuffle(out)\n    return out\n\n\ndef _place_docked_pair(\n    i: int, spec: dict, colors: list[int], side: str, bg: int,\n    H: int, W: int, output: np.ndarray, input_grid: np.ndarray,\n    union_bboxes: list, frame_bboxes: list,\n) -> dict | None:\n    \"\"\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\n\n    Returns tool info dict for later undocking, or None on failure.\n    \"\"\"\n    frame_color = colors[3 * i]\n    plug_color = colors[3 * i + 1]\n    handle_color = colors[3 * i + 2]\n\n    result = _build_left_pair(\n        bg=bg, frame_color=frame_color, plug_color=plug_color,\n        handle_color=handle_color, fw=spec[\"fw\"], top_h=spec[\"top_h\"],\n        bot_h=spec[\"bot_h\"], notch_n=spec[\"notch_n\"],\n        handle_area=spec[\"handle_area\"],\n    )\n    if result is None:\n        return None\n    frame_left, tool_left = result\n\n    # Combine frame + tool into a single docked scene\n    scene_left = np.where(tool_left != bg, tool_left, frame_left)\n\n    frame_scene = _orient_left_to_side(frame_left, side)\n    tool = _orient_left_to_side(tool_left, side)\n    scene = _orient_left_to_side(scene_left, side)\n    ph, pw = scene.shape\n    fr0, fc0, fr1, fc1 = _bbox(frame_scene != bg)\n\n    origin = None\n    for r0, c0 in _candidate_origins(side, ph, pw, H, W):\n        union_bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)\n        frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)\n        if side in (\"left\", \"right\") and (frame_bbox[0] == 0 or frame_bbox[2] == H - 1):\n            continue\n        if side in (\"top\", \"bottom\") and (frame_bbox[1] == 0 or frame_bbox[3] == W - 1):\n            continue\n        if any(_bbox_gap(union_bbox, prev) <= UNION_BBOX_GAP_MIN - 1 for prev in union_bboxes):\n            continue\n        if any(_bbox_gap(frame_bbox, prev) <= FRAME_BBOX_GAP_MIN - 1 for prev in frame_bboxes):\n            continue\n        if np.any((output[r0:r0 + ph, c0:c0 + pw] != bg) & (scene != bg)):\n            continue\n        origin = (r0, c0)\n        break\n    if origin is None:\n        return None\n\n    r0, c0 = origin\n    paste(output, scene, r0, c0, transparent=bg)\n    paste(input_grid, frame_scene, r0, c0, transparent=bg)\n\n    union_bboxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))\n    frame_bboxes.append((r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1))\n    return {\n        \"tool\": tool, \"plug_color\": plug_color, \"handle_color\": handle_color,\n        \"plug_area\": spec[\"plug_area\"], \"handle_area\": spec[\"handle_area\"],\n    }\n\n\ndef _undock_tool(info: dict, bg: int, input_grid: np.ndarray,\n                 placement_canvas: np.ndarray) -> bool:\n    \"\"\"Pick a random D4 variant of the tool and place it at a free location on the grid.\n\n    Returns True on success, False if no placement found.\n    \"\"\"\n    for patch, is_flip in _variant_choices(info[\"tool\"]):\n        if is_flip and info[\"plug_area\"] != info[\"handle_area\"]:\n            patch = _swap_colors(patch, info[\"plug_color\"], info[\"handle_color\"])\n        try:\n            r0, c0 = random_free_location(\n                placement_canvas, patch, transparent=bg,\n                border=TOOL_BORDER, padding=TOOL_PADDING,\n                padding_connectivity=TOOL_PADDING_CONN,\n            )\n        except ValueError:\n            continue\n        paste(input_grid, patch, r0, c0, transparent=bg)\n        paste(placement_canvas, patch, r0, c0, transparent=bg)\n        return True\n    return False\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.choice(list(range(10)))\n    num_pairs = random.choice(NUM_PAIRS_CHOICES)\n\n    pair_specs = _pick_pair_specs(num_pairs)\n    if len(pair_specs) != num_pairs:\n        return None\n\n    colors = [c for c in range(1, 10) if c != bg]\n    random.shuffle(colors)\n    need = 1 + (3 * num_pairs)\n    if len(colors) < need:\n        return None\n\n    sides = random.sample([\"left\", \"right\", \"top\", \"bottom\"], k=num_pairs)\n    output = np.full((H, W), bg, dtype=int)\n    input_grid = np.full((H, W), bg, dtype=int)\n    union_bboxes: list[tuple[int, int, int, int]] = []\n    frame_bboxes: list[tuple[int, int, int, int]] = []\n    placed_tools: list[dict] = []\n\n    for i, spec in enumerate(pair_specs):\n        info = _place_docked_pair(\n            i, spec, colors, sides[i], bg, H, W,\n            output, input_grid, union_bboxes, frame_bboxes,\n        )\n        if info is None:\n            return None\n        placed_tools.append(info)\n\n    placement_canvas = output.copy()\n    for info in placed_tools:\n        if not _undock_tool(info, bg, input_grid, placement_canvas):\n            return None\n\n    if np.array_equal(main(input_grid), output):\n        return input_grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPT_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p; /def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p; /def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock train sprites onto station groups by matching coupler count, then orient via divider-color markers.\n\n    Input structure:\n    - bg; colored stripes (edge + internal) partition grid into rectangular regions.\n    - Color 8 forms train bodies; color 9 marks both isolated stations and train-attached couplers.\n    - Stripe-colored pixels on trains are orientation markers.\n\n    Rule:\n    - Stations = 8-connected 9-clusters not adjacent to any 8. Trains = components containing 8.\n    - Match train to station group where |couplers| == |station size|.\n    - Rotate/flip train so marker pixels face the same-color boundary stripe of the target region.\n    - Translate so couplers align exactly onto station cells; erase original position.\n\n    Key insight: Coupler count selects the docking target; marker color encodes which boundary stripe to face, fixing the unique orientation.\n    \"\"\"\n    inp = grid\n    grid = inp.copy()\n    H, W = grid.shape\n    bg = get_bg(grid)\n\n    # This puzzle's code is long because it reconstructs several \"structures\"\n    # that are implicit in the grid:\n    # - divider stripes (edge + internal) that partition the canvas into regions\n    # - station groups = 9-clusters not adjacent to any 8\n    # - train sprites = components containing 8 (with attached 9 \"couplers\")\n    # Then, for each train:\n    # - match target region by COUPLER COUNT (|couplers| == |station group|)\n    # - choose orientation by divider-color markers (face region boundary stripes)\n    # - translate so couplers land exactly onto the station group cells\n\n    def find_edge_stripes():\n        # Detect thick constant-color border stripes.\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Top edge\n        top_h = 0\n        for r in range(H):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                top_h += 1\n            else:\n                break\n        if top_h:\n            stripe[:top_h, :] = True\n            colors.add(int(grid[0, 0]))\n        # Bottom edge\n        bot_h = 0\n        for r in range(H - 1, -1, -1):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                bot_h += 1\n            else:\n                break\n        if bot_h:\n            stripe[H - bot_h :, :] = True\n            colors.add(int(grid[H - 1, 0]))\n        inner_r0, inner_r1 = top_h, H - bot_h\n        # Left edge (in inner rows)\n        left_w = 0\n        for c in range(W):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                left_w += 1\n            else:\n                break\n        if left_w:\n            stripe[inner_r0:inner_r1, :left_w] = True\n            colors.add(int(grid[inner_r0, 0]))\n        # Right edge\n        right_w = 0\n        for c in range(W - 1, -1, -1):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                right_w += 1\n            else:\n                break\n        if right_w:\n            stripe[inner_r0:inner_r1, W - right_w :] = True\n            colors.add(int(grid[inner_r0, W - 1]))\n        return stripe, colors, (top_h, bot_h, left_w, right_w)\n\n    def find_internal_stripes(edge_info):\n        # Detect internal constant-color stripes in the inner rectangle.\n        top_h, bot_h, left_w, right_w = edge_info\n        r0, r1, c0, c1 = top_h, H - bot_h, left_w, W - right_w\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Vertical internal stripes\n        c = c0\n        while c < c1:\n            col = grid[r0:r1, c]\n            if col.size and (col == col[0]).all() and col[0] != bg:\n                color = int(col[0])\n                c2 = c\n                while c2 + 1 < c1:\n                    col2 = grid[r0:r1, c2 + 1]\n                    if col2.size and (col2 == col2[0]).all() and int(col2[0]) == color:\n                        c2 += 1\n                    else:\n                        break\n                stripe[r0:r1, c : c2 + 1] = True\n                colors.add(color)\n                c = c2 + 1\n            else:\n                c += 1\n        # Horizontal internal stripes\n        r = r0\n        while r < r1:\n            row = grid[r, c0:c1]\n            if row.size and (row == row[0]).all() and row[0] != bg:\n                color = int(row[0])\n                r2 = r\n                while r2 + 1 < r1:\n                    row2 = grid[r2 + 1, c0:c1]\n                    if row2.size and (row2 == row2[0]).all() and int(row2[0]) == color:\n                        r2 += 1\n                    else:\n                        break\n                stripe[r : r2 + 1, c0:c1] = True\n                colors.add(color)\n                r = r2 + 1\n            else:\n                r += 1\n        return stripe, colors\n\n    def station_groups():\n        # Stations are 9 pixels with no adjacent 8 in the 8-neighborhood.\n        # Station groups are 8-connected components of those station pixels.\n        # Station 9s have no adjacent 8 in 8-neighborhood\n        sm = np.zeros((H, W), dtype=bool)\n        for r in range(H):\n            for c in range(W):\n                if grid[r, c] != 9:\n                    continue\n                ok = all(grid[r+dr, c+dc] != 8\n                        for dr in (-1, 0, 1) for dc in (-1, 0, 1)\n                        if (dr != 0 or dc != 0) and 0 <= r+dr < H and 0 <= c+dc < W)\n                if ok:\n                    sm[r, c] = True\n        # 8-connected clustering\n        struct = np.ones((3, 3), dtype=int)\n        lab, n = label(sm, structure=struct)\n        groups = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            groups.append([(int(r), int(c)) for r, c in coords])\n        return groups\n\n    def regions_from_stripes(stripe_mask):\n        # Regions are connected components of all non-stripe cells.\n        non = ~stripe_mask\n        lab, n = label(non)\n        regs = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if (r1 - r0 + 1) >= 5 and (c1 - c0 + 1) >= 5:\n                regs.append({\"r0\": int(r0), \"r1\": int(r1), \"c0\": int(c0), \"c1\": int(c1)})\n        return regs\n\n    def boundary_dirs_for_region(reg, stripe_colors):\n        # For a region bbox, infer which stripe color borders each side.\n        # Returns map: stripe_color -> direction (0=up,1=right,2=down,3=left)\n        # Map stripe color -> direction (0=up, 1=right, 2=down, 3=left)\n        dirs = {}\n        r0, r1, c0, c1 = reg[\"r0\"], reg[\"r1\"], reg[\"c0\"], reg[\"c1\"]\n        if r0 - 1 >= 0:\n            mc = Counter(grid[r0 - 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 0\n        if r1 + 1 < H:\n            mc = Counter(grid[r1 + 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 2\n        if c0 - 1 >= 0:\n            mc = Counter(grid[r0:r1 + 1, c0 - 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 3\n        if c1 + 1 < W:\n            mc = Counter(grid[r0:r1 + 1, c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 1\n        return dirs\n\n    def xform_coords(coords, shape, flip_ud, rot_k):\n        \"\"\"Transform coords, return (list, new_shape).\"\"\"\n        result = transform_coords(coords, shape, flip_ud, rot_k)\n        new_shape = apply_transform(np.zeros(shape), flip_ud, rot_k).shape\n        return list(result), new_shape\n\n    def choose_best_op(train, divider_dirs):\n        # Pick orientation (flip/rot) that makes divider-color marker pixels\n        # \"face\" the region boundary stripe of the same color.\n        bbox0 = train[\"bbox\"]\n        H0, W0 = bbox0.shape\n        markers_by_color = defaultdict(list)\n        for v, r, c in train[\"marker_pixels\"]:\n            if v in divider_dirs:\n                markers_by_color[v].append((r, c))\n        assert markers_by_color, \"Each train must expose divider-colored markers\"\n        assert train[\"body9\"], \"Each train must carry at least one coupler\"\n        ref_r = sum(r for r, _ in train[\"body9\"]) / len(train[\"body9\"])\n        ref_c = sum(c for _, c in train[\"body9\"]) / len(train[\"body9\"])\n        best, best_score = (False, 0), -1\n        for flip_ud in (False, True):\n            for k in range(4):\n                ref_t = list(transform_coords([(int(round(ref_r)), int(round(ref_c)))], (H0, W0), flip_ud, k))\n                rr_ref, cc_ref = ref_t[0]\n                score = 0\n                for color, pts in markers_by_color.items():\n                    mr, mc = sum(r for r, _ in pts) / len(pts), sum(c for _, c in pts) / len(pts)\n                    m_t = list(transform_coords([(int(round(mr)), int(round(mc)))], (H0, W0), flip_ud, k))\n                    rr_m, cc_m = m_t[0]\n                    dr, dc = rr_m - rr_ref, cc_m - cc_ref\n                    dirc = (0 if dr < 0 else 2) if abs(dr) >= abs(dc) else (3 if dc < 0 else 1)\n                    if dirc == divider_dirs[color]:\n                        score += 1\n                if score > best_score:\n                    best_score, best = score, (flip_ud, k)\n        return best\n\n    # 1) Detect stripes and partition into regions\n    edge_mask, edge_colors, edge_info = find_edge_stripes()\n    internal_mask, internal_colors = find_internal_stripes(edge_info)\n    stripe_mask = edge_mask | internal_mask\n    stripe_colors = edge_colors | internal_colors\n    regions = regions_from_stripes(stripe_mask)\n\n    # 2) Station groups (targets)\n    groups = station_groups()\n    groups_by_size = defaultdict(list)\n    for g in groups:\n        groups_by_size[len(g)].append(g)\n    station_set = set(pt for g in groups for pt in g)\n\n    # 3) Trains (sources): CCs (excluding stripes) that contain 8.\n    #    Also record train-attached 9 couplers (9s NOT part of stations).\n    comp_mask = (grid != bg) & (~stripe_mask)\n    lab, n = label(comp_mask)\n    trains = []\n    for k in range(1, n + 1):\n        coords = np.argwhere(lab == k)\n        vals = [int(grid[r, c]) for r, c in coords]\n        if 8 not in vals:\n            continue\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        bbox = grid[r0:r1 + 1, c0:c1 + 1].copy()\n        abs_coords = [(int(r), int(c)) for r, c in coords]\n        body9, marker_pixels = [], []\n        for r, c in abs_coords:\n            v = int(grid[r, c])\n            if v == 9 and (r, c) not in station_set:\n                body9.append((int(r - r0), int(c - c0)))\n            if v in stripe_colors:\n                marker_pixels.append((v, int(r - r0), int(c - c0)))\n        trains.append({\n            \"abs_coords\": abs_coords,\n            \"bbox\": bbox,\n            \"body9\": body9,\n            \"marker_pixels\": marker_pixels,\n        })\n\n    out = grid.copy()\n    # 4) Clear trains from original positions (we'll redraw them docked).\n    for t in trains:\n        for r, c in t[\"abs_coords\"]:\n            out[r, c] = bg\n\n    # 5) Place each train by:\n    # - matching station group size by coupler count\n    # - choosing orientation by marker-vs-stripe rule\n    # - translating so couplers coincide exactly with station pixels\n    for t in trains:\n        n9 = len(t[\"body9\"])\n        assert n9 > 0, \"Each train must carry at least one coupler\"\n        candidate_groups = groups_by_size.get(n9)\n        assert candidate_groups is not None and len(candidate_groups) == 1, (\n            f\"Expected one station group for coupler count {n9}\"\n        )\n        g = candidate_groups[0]\n        gset = set(g)\n        matching_regions = [\n            rr\n            for rr in regions\n            if all(rr[\"r0\"] <= r <= rr[\"r1\"] and rr[\"c0\"] <= c <= rr[\"c1\"] for r, c in g)\n        ]\n        assert len(matching_regions) == 1, \"Each station group must belong to exactly one region\"\n        reg = matching_regions[0]\n        divider_dirs = boundary_dirs_for_region(reg, stripe_colors)\n        op = choose_best_op(t, divider_dirs)\n        tbbox = apply_transform(t[\"bbox\"], *op)\n        t_body9, (H1, W1) = xform_coords(t[\"body9\"], t[\"bbox\"].shape, *op)\n        body9_set = set(t_body9)\n        matching_offsets = {\n            (sr - br, sc - bc)\n            for br, bc in body9_set\n            for sr, sc in gset\n            if all((r + sr - br, c + sc - bc) in gset for r, c in body9_set)\n        }\n        assert len(matching_offsets) == 1, \"Couplers must align to a unique station-group offset\"\n        off_r, off_c = next(iter(matching_offsets))\n        # Validate and place (skip 9s - stations already exist)\n        ok = True\n        for r in range(H1):\n            for c in range(W1):\n                v = int(tbbox[r, c])\n                if v == bg or v == 9:\n                    continue\n                rr, cc = r + off_r, c + off_c\n                if not (reg[\"r0\"] <= rr <= reg[\"r1\"] and reg[\"c0\"] <= cc <= reg[\"c1\"]):\n                    ok = False\n                    break\n                if stripe_mask[rr, cc] or (out[rr, cc] != bg and out[rr, cc] != 9):\n                    ok = False\n                    break\n            if not ok:\n                break\n        assert ok, \"Docked train must fit entirely within its target region\"\n        for r in range(H1):\n            for c in range(W1):\n                v = int(tbbox[r, c])\n                if v != bg and v != 9:\n                    out[r + off_r, c + off_c] = v\n    return out\n\n# --------------- generator (att2) ---------------\n\n# ── Tunable constants ────────────────────────────────────────────────\n# Canvas / grid sizing\nGRID_H_RANGE = (13, 31)          # min/max+1 grid height\nGRID_W_RANGE = (16, 29)          # min/max+1 grid width\nGRID_MIN_AREA = 300              # minimum total cells\nMIN_REGION_DIM = 10              # each region >=10 in both dims\nMIN_REGION_DIRS = 3              # minimum boundary-stripe count per region\nINTERNAL_STRIPE_THICK = 2        # thickness of the internal divider\n\n# Edge stripes\nSTRIPE_THICK_RANGE = (2, 4)      # each edge stripe thickness\n\n# Internal-stripe probability\nINTERNAL_PROB = 0.62\n\n# Train / station counts\nTRAIN_COUNTS = [2, 3]            # possible number of trains per grid\nSTATION_SIZES = [1, 2, 4]        # possible station sizes (1x1, 1x2, 2x2)\n\n# Docked-patch body constraints\nBODY_MIN = 5                     # minimum 8-cells in train body\nBODY_MAX = 20                    # maximum 8-cells in train body\nPATCH_H_RANGE = (4, 9)           # docked patch bbox height limits\nPATCH_W_RANGE = (3, 8)           # docked patch bbox width limits\n\n# Marker placement\nMARKER_DIST_RANGE = (2, 3)       # distance from coupler bbox to marker cell\nMARKER_JITTER = [-1, 0, 1]       # lateral jitter for marker position\nTHREE_MARKER_PROB = 0.65          # probability of using 3 markers (vs 2)\n\n# Growth / pathfinding\nBODY_GROWTH_ITERS = 160          # max iterations for body cell growth\nPATH_BOUNDS_PAD = 4              # padding around seed bbox for BFS bounds\n\n# Retry budgets\nLAYOUT_RETRIES = 200             # attempts to find a valid layout\nDOCK_RETRIES = 20                # attempts per train to build+place a docked patch\nGENERATE_RETRIES = 300           # outer generate_input loop budget\n\n# Color pool (excludes 8=train body, 9=coupler/station)\nCOLOR_POOL = list(range(8))\n\n# ── Constants ────────────────────────────────────────────────────────\nOPS = [(False, 0), (False, 1), (False, 2), (False, 3),\n       (True, 0), (True, 1), (True, 2), (True, 3)]\nDIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n\n# ── Primitives ───────────────────────────────────────────────────────\n\ndef _apply_transform(arr, flip_ud=False, rot_k=0):\n    out = np.flipud(arr) if flip_ud else arr\n    return np.rot90(out, int(rot_k))\n\n\ndef _inverse_patch(patch, op):\n    \"\"\"Find the pre-image of *patch* under *op* (brute-force over 8 ops).\"\"\"\n    for inv in OPS:\n        cand = _apply_transform(patch, *inv)\n        if np.array_equal(_apply_transform(cand, *op), patch):\n            return cand\n    raise ValueError(\"no inverse transform\")\n\n\ndef _valid_ops_for_patch(patch):\n    \"\"\"Return ops whose inverse keeps patch within bbox size limits.\"\"\"\n    hlo, hhi = PATCH_H_RANGE\n    wlo, whi = PATCH_W_RANGE\n    valid = []\n    for op in OPS:\n        h, w = _inverse_patch(patch, op).shape\n        if hlo <= h <= hhi and wlo <= w <= whi:\n            valid.append(op)\n    return valid\n\n\ndef _bbox(coords):\n    rs = [r for r, _ in coords]\n    cs = [c for _, c in coords]\n    return min(rs), min(cs), max(rs), max(cs)\n\n\ndef _dims(coords):\n    r0, c0, r1, c1 = _bbox(coords)\n    return r1 - r0 + 1, c1 - c0 + 1\n\n\ndef _adjacent8(p, cells):\n    r, c = p\n    return any(abs(r - rr) <= 1 and abs(c - cc) <= 1 for rr, cc in cells)\n\n\ndef _dilate(mask):\n    \"\"\"8-connected dilation via numpy shifts.\"\"\"\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _path_to(body, goal, blocked, bounds):\n    \"\"\"BFS from *body* to *goal*, adding the path into *body* (mutates).\"\"\"\n    if goal in body:\n        return True\n    r0, r1, c0, c1 = bounds\n    q = deque(body)\n    prev = {p: None for p in body}\n    dirs = DIRS4[:]\n    random.shuffle(dirs)\n    while q:\n        r, c = q.popleft()\n        for dr, dc in dirs:\n            p = (r + dr, c + dc)\n            if p in prev or p in blocked:\n                continue\n            if not (r0 <= p[0] <= r1 and c0 <= p[1] <= c1):\n                continue\n            prev[p] = (r, c)\n            if p == goal:\n                cur = p\n                while cur is not None:\n                    body.add(cur)\n                    cur = prev[cur]\n                return True\n            q.append(p)\n    return False\n\n\n# ── Layout construction ──────────────────────────────────────────────\n\ndef _assign_region_dirs(regions, edge_col, top, bottom, left, right, H, W, internal):\n    \"\"\"Populate each region's 'dirs' mapping (stripe_color -> direction).\"\"\"\n    for reg in regions:\n        dirs = {}\n        if top and reg[\"r0\"] == top:\n            dirs[edge_col[\"top\"]] = 0\n        if bottom and reg[\"r1\"] == H - bottom - 1:\n            dirs[edge_col[\"bottom\"]] = 2\n        if left and reg[\"c0\"] == left:\n            dirs[edge_col[\"left\"]] = 3\n        if right and reg[\"c1\"] == W - right - 1:\n            dirs[edge_col[\"right\"]] = 1\n        if internal:\n            kind, pos, col = internal\n            if kind == \"v\":\n                dirs[col] = 1 if reg[\"c1\"] == pos - 1 else 3\n            else:\n                dirs[col] = 2 if reg[\"r1\"] == pos - 1 else 0\n        reg[\"dirs\"] = dirs\n        rh = reg[\"r1\"] - reg[\"r0\"] + 1\n        rw = reg[\"c1\"] - reg[\"c0\"] + 1\n        if rh < MIN_REGION_DIM or rw < MIN_REGION_DIM or len(dirs) < MIN_REGION_DIRS:\n            return False\n    return True\n\n\ndef _layout():\n    \"\"\"Build the background grid with edge/internal stripes and rectangular regions.\"\"\"\n    for _ in range(LAYOUT_RETRIES):\n        use_internal = random.random() < INTERNAL_PROB\n        if use_internal:\n            orient = random.choice([\"v\", \"h\"])\n            if orient == \"v\":\n                edges = [\"left\", \"right\", random.choice([\"top\", \"bottom\"])]\n            else:\n                edges = [\"top\", \"bottom\", random.choice([\"left\", \"right\"])]\n        else:\n            orient = None\n            edges = random.sample([\"top\", \"bottom\", \"left\", \"right\"], random.choice([3, 4]))\n\n        thick = {e: random.randint(*STRIPE_THICK_RANGE) for e in edges}\n        top, bottom = thick.get(\"top\", 0), thick.get(\"bottom\", 0)\n        left, right = thick.get(\"left\", 0), thick.get(\"right\", 0)\n\n        # Min inner dimension needed for internal stripes (2 regions of >=10 + 2-thick divider)\n        min_inner_for_split = MIN_REGION_DIM * 2 + INTERNAL_STRIPE_THICK\n        candidates = []\n        for H in range(*GRID_H_RANGE):\n            for W in range(*GRID_W_RANGE):\n                if H * W < GRID_MIN_AREA:\n                    continue\n                ih, iw = H - top - bottom, W - left - right\n                if ih < MIN_REGION_DIM or iw < MIN_REGION_DIM:\n                    continue\n                if orient == \"v\" and iw < min_inner_for_split:\n                    continue\n                if orient == \"h\" and ih < min_inner_for_split:\n                    continue\n                candidates.append((H, W))\n        if not candidates:\n            continue\n\n        H, W = random.choice(candidates)\n        pool = COLOR_POOL[:]\n        bg = random.choice(pool)\n        pool.remove(bg)\n        stripe_cols = random.sample(pool, len(edges) + int(use_internal))\n        edge_col = dict(zip(edges, stripe_cols[:len(edges)]))\n        internal_col = stripe_cols[-1] if use_internal else None\n        grid = np.full((H, W), bg, dtype=int)\n\n        if top:    grid[:top, :] = edge_col[\"top\"]\n        if bottom: grid[H - bottom:, :] = edge_col[\"bottom\"]\n        if left:   grid[top:H - bottom, :left] = edge_col[\"left\"]\n        if right:  grid[top:H - bottom, W - right:] = edge_col[\"right\"]\n\n        inner = {\"r0\": top, \"r1\": H - bottom - 1, \"c0\": left, \"c1\": W - right - 1}\n        regions, internal = [], None\n        if orient == \"v\":\n            lo, hi = left + MIN_REGION_DIM, W - right - MIN_REGION_DIM - INTERNAL_STRIPE_THICK\n            if lo > hi:\n                continue\n            c = random.randint(lo, hi)\n            grid[top:H - bottom, c:c + INTERNAL_STRIPE_THICK] = internal_col\n            internal = (\"v\", c, internal_col)\n            regions = [\n                {\"r0\": top, \"r1\": H - bottom - 1, \"c0\": left, \"c1\": c - 1},\n                {\"r0\": top, \"r1\": H - bottom - 1, \"c0\": c + INTERNAL_STRIPE_THICK, \"c1\": W - right - 1},\n            ]\n        elif orient == \"h\":\n            lo, hi = top + MIN_REGION_DIM, H - bottom - MIN_REGION_DIM - INTERNAL_STRIPE_THICK\n            if lo > hi:\n                continue\n            r = random.randint(lo, hi)\n            grid[r:r + INTERNAL_STRIPE_THICK, left:W - right] = internal_col\n            internal = (\"h\", r, internal_col)\n            regions = [\n                {\"r0\": top, \"r1\": r - 1, \"c0\": left, \"c1\": W - right - 1},\n                {\"r0\": r + INTERNAL_STRIPE_THICK, \"r1\": H - bottom - 1, \"c0\": left, \"c1\": W - right - 1},\n            ]\n        else:\n            regions = [inner]\n\n        if _assign_region_dirs(regions, edge_col, top, bottom, left, right, H, W, internal):\n            return grid, bg, regions\n    return None\n\n\n# ── Station / coupler shapes ─────────────────────────────────────────\n\ndef _station_shape(size):\n    if size == 1:\n        return {(0, 0)}\n    if size == 2:\n        return {(0, 0), (0, 1)} if random.random() < 0.5 else {(0, 0), (1, 0)}\n    return {(0, 0), (0, 1), (1, 0), (1, 1)}\n\n\n# ── Marker selection and placement ───────────────────────────────────\n\ndef _marker_specs(dirs):\n    \"\"\"Choose 2-3 (color, direction) marker specs from region boundary dirs.\"\"\"\n    items = list(dirs.items())\n    if len(items) >= 3 and random.random() < THREE_MARKER_PROB:\n        return random.sample(items, 3)\n    pairs = []\n    for i, a in enumerate(items):\n        for b in items[i + 1:]:\n            if (a[1] - b[1]) % 4 in (1, 3):\n                pairs.append((a, b))\n    return list(random.choice(pairs)) if pairs else random.sample(items, 2)\n\n\ndef _marker_cell(couplers, direction):\n    \"\"\"Pick a marker cell position at a random offset from the coupler bbox in *direction*.\"\"\"\n    r0, c0, r1, c1 = _bbox(couplers)\n    d = random.randint(*MARKER_DIST_RANGE)\n    jitter = random.choice(MARKER_JITTER)\n    if direction == 0:\n        return (r0 - d, random.randint(c0, c1) + jitter)\n    if direction == 2:\n        return (r1 + d, random.randint(c0, c1) + jitter)\n    if direction == 3:\n        return (random.randint(r0, r1) + jitter, c0 - d)\n    return (random.randint(r0, r1) + jitter, c1 + d)\n\n\ndef _inward_cell(marker, direction):\n    \"\"\"Return the cell one step inward from *marker* (toward coupler center).\"\"\"\n    dr, dc = DIRS4[(direction + 2) % 4]\n    return marker[0] + dr, marker[1] + dc\n\n\n# ── Docked-patch construction ────────────────────────────────────────\n\ndef _connect_couplers_to_body(couplers, body, blocked, bounds):\n    \"\"\"Ensure every coupler is 8-adjacent to the body via BFS paths.\"\"\"\n    for cp in couplers:\n        if _adjacent8(cp, body):\n            continue\n        cr, cc = cp\n        choices = [(cr + dr, cc + dc)\n                   for dr in (-1, 0, 1) for dc in (-1, 0, 1)\n                   if (dr or dc) and (cr + dr, cc + dc) not in blocked]\n        random.shuffle(choices)\n        for q in choices:\n            if _path_to(body, q, blocked, bounds):\n                break\n        else:\n            return False\n    return True\n\n\ndef _grow_body(body, blocked, target):\n    \"\"\"Grow *body* toward *target* cells while respecting bbox limits.\"\"\"\n    for _ in range(BODY_GROWTH_ITERS):\n        all_cells = body | blocked\n        h, w = _dims(all_cells)\n        if len(body) >= target and h >= PATCH_H_RANGE[0] and w >= PATCH_W_RANGE[0]:\n            break\n        cands = []\n        for r, c in body:\n            for dr, dc in DIRS4:\n                q = (r + dr, c + dc)\n                if q in body or q in blocked:\n                    continue\n                nh, nw = _dims(all_cells | {q})\n                if nh <= PATCH_H_RANGE[1] and nw <= PATCH_W_RANGE[1]:\n                    cands.append(q)\n        if not cands or len(body) >= BODY_MAX:\n            break\n        # Prefer expansion toward undersized dimension\n        h, w = _dims(all_cells)\n        if h < PATCH_H_RANGE[0]:\n            r0, _, r1, _ = _bbox(all_cells)\n            exp = [q for q in cands if q[0] < r0 or q[0] > r1]\n            cands = exp or cands\n        elif w < PATCH_W_RANGE[0]:\n            _, c0, _, c1 = _bbox(all_cells)\n            exp = [q for q in cands if q[1] < c0 or q[1] > c1]\n            cands = exp or cands\n        body.add(random.choice(cands))\n\n\ndef _build_docked_patch(bg, dirs, size):\n    \"\"\"Build a docked train patch: 8-body + 9-couplers + colored markers.\"\"\"\n    couplers = _station_shape(size)\n    specs = _marker_specs(dirs)\n    markers, marker_cells = [], set()\n    for color, direction in specs:\n        p = _marker_cell(couplers, direction)\n        if p in couplers or p in marker_cells:\n            return None\n        markers.append((p, color, direction))\n        marker_cells.add(p)\n\n    blocked = set(couplers) | marker_cells\n    contacts = [q for r, c in couplers for dr, dc in DIRS4\n                if (q := (r + dr, c + dc)) not in blocked]\n    if not contacts:\n        return None\n\n    body = {random.choice(contacts)}\n    all_seed = set(couplers) | marker_cells | body\n    sr0, sc0, sr1, sc1 = _bbox(all_seed)\n    bounds = (sr0 - PATH_BOUNDS_PAD, sr1 + PATH_BOUNDS_PAD,\n              sc0 - PATH_BOUNDS_PAD, sc1 + PATH_BOUNDS_PAD)\n\n    # Connect markers inward to body\n    for p, _, direction in markers:\n        goal = _inward_cell(p, direction)\n        if goal in blocked:\n            return None\n        if not _path_to(body, goal, blocked, bounds):\n            return None\n\n    # Ensure all couplers are 8-adjacent to the body\n    if not _connect_couplers_to_body(couplers, body, blocked, bounds):\n        return None\n\n    if len(body) > BODY_MAX:\n        return None\n    target = random.randint(max(BODY_MIN, len(body)), BODY_MAX)\n    _grow_body(body, blocked, target)\n\n    all_cells = body | set(couplers) | marker_cells\n    h, w = _dims(all_cells)\n    if not (BODY_MIN <= len(body) <= BODY_MAX\n            and PATCH_H_RANGE[0] <= h <= PATCH_H_RANGE[1]\n            and PATCH_W_RANGE[0] <= w <= PATCH_W_RANGE[1]):\n        return None\n\n    # Render patch array\n    r0, c0, _, _ = _bbox(all_cells)\n    patch = np.full((h, w), bg, dtype=int)\n    for r, c in body:\n        patch[r - r0, c - c0] = 8\n    for (r, c), color, _ in markers:\n        patch[r - r0, c - c0] = color\n    rel_couplers = []\n    for r, c in couplers:\n        patch[r - r0, c - c0] = 9\n        rel_couplers.append((r - r0, c - c0))\n    return patch, rel_couplers\n\n\n# ── Placement search ─────────────────────────────────────────────────\n\ndef _patch_locations(region, patch, bg, occupied, coupler_rel=None, station_clearance=False, margin=0):\n    \"\"\"Find all valid (r, c) placements for *patch* within *region*.\"\"\"\n    H, W = occupied.shape\n    ph, pw = patch.shape\n    coords = [(int(r), int(c)) for r, c in np.argwhere(patch != bg)]\n    locs = []\n    r_start = max(region[\"r0\"] + margin, 0)\n    r_stop = min(region[\"r1\"] - margin - ph + 2, H - ph + 1)\n    c_start = max(region[\"c0\"] + margin, 0)\n    c_stop = min(region[\"c1\"] - margin - pw + 2, W - pw + 1)\n    for rr in range(r_start, r_stop):\n        for cc in range(c_start, c_stop):\n            ok = True\n            for pr, pc in coords:\n                if occupied[rr + pr, cc + pc]:\n                    ok = False\n                    break\n            if not ok:\n                continue\n            if station_clearance and coupler_rel:\n                for pr, pc in coupler_rel:\n                    ar, ac = rr + pr, cc + pc\n                    if not (region[\"r0\"] + 2 <= ar <= region[\"r1\"] - 2 and\n                            region[\"c0\"] + 2 <= ac <= region[\"c1\"] - 2):\n                        ok = False\n                        break\n            if ok:\n                locs.append((rr, cc))\n    return locs\n\n\n# ── Top-level generation attempt ─────────────────────────────────────\n\ndef _place_docked_trains(base, bg, regions):\n    \"\"\"Place N docked trains on the output grid; return (output, trains) or None.\"\"\"\n    H, W = base.shape\n    output = base.copy()\n    occupied = output != bg\n\n    n_trains = random.choice(TRAIN_COUNTS)\n    sizes = random.sample(STATION_SIZES, n_trains)\n    trains = []\n    for size in sizes:\n        for _ in range(DOCK_RETRIES):\n            reg = random.choice(regions)\n            result = _build_docked_patch(bg, reg[\"dirs\"], size)\n            if result is None:\n                continue\n            patch, coupler_rel = result\n            locs = _patch_locations(reg, patch, bg, _dilate(occupied), coupler_rel, True, 0)\n            if not locs:\n                continue\n            r0, c0 = random.choice(locs)\n            paste(output, patch, r0, c0, transparent=bg)\n            occupied |= _dilate((output != bg) & ~occupied) | (output != bg)\n            station_abs = [(r0 + r, c0 + c) for r, c in coupler_rel]\n            trains.append({\"patch\": patch, \"station\": station_abs})\n            break\n        else:\n            return None\n    return output, trains\n\n\ndef _scatter_trains(base, bg, regions, trains):\n    \"\"\"Apply random transforms and scatter trains onto the input grid.\"\"\"\n    H, W = base.shape\n    input_grid = base.copy()\n    station_mask = np.zeros((H, W), dtype=bool)\n    for t in trains:\n        for r, c in t[\"station\"]:\n            input_grid[r, c] = 9\n            station_mask[r, c] = True\n\n    # Choose a non-trivial set of transforms\n    valid_ops = []\n    for t in trains:\n        valid = _valid_ops_for_patch(t[\"patch\"])\n        if not valid:\n            return None\n        valid_ops.append(valid)\n    ops = [random.choice(valid) for valid in valid_ops]\n    if all(op == (False, 0) for op in ops):\n        non_id = [op for op in valid_ops[0] if op != (False, 0)]\n        if not non_id:\n            return None\n        ops[0] = random.choice(non_id)\n\n    # Place inverse-transformed patches\n    forbidden = _dilate(base != bg) | _dilate(station_mask)\n    for t, op in zip(trains, ops):\n        in_patch = _inverse_patch(t[\"patch\"], op)\n        regs = regions[:]\n        random.shuffle(regs)\n        all_locs = []\n        for reg in regs:\n            locs = _patch_locations(reg, in_patch, bg, forbidden, None, False, 1)\n            all_locs.extend((reg, p) for p in locs)\n        if not all_locs:\n            return None\n        _, (r0, c0) = random.choice(all_locs)\n        paste(input_grid, in_patch, r0, c0, transparent=bg)\n        ph, pw = in_patch.shape\n        patch_mask = np.zeros((H, W), dtype=bool)\n        patch_mask[r0:r0 + ph, c0:c0 + pw] = (in_patch != bg)\n        forbidden |= _dilate(patch_mask)\n\n    return input_grid\n\n\ndef _gen_attempt():\n    layout = _layout()\n    if layout is None:\n        return None\n    base, bg, regions = layout\n\n    placed = _place_docked_trains(base, bg, regions)\n    if placed is None:\n        return None\n    output, trains = placed\n\n    input_grid = _scatter_trains(base, bg, regions, trains)\n    if input_grid is None:\n        return None\n\n    counts = Counter(map(int, input_grid.flatten()))\n    if counts[bg] != max(counts.values()):\n        return None\n    try:\n        if np.array_equal(main(input_grid), output):\n            return input_grid\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 6e4f6532 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p; /def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/fc7cae8d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main/,/def generate_input/p; /def generate_input/,\"'$p'\"' /home/lixinyu/snap/new/ARC_code/eval/fc7cae8d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align a central rectangle to two colored frame-edge controls via rotation/reflection.\n\n    Input structure:\n    - bg grid with two solid-colored border edges (distinct non-bg colors).\n    - A central filled rectangle with 1px colored guide edges on two sides, colors matching the frame controls.\n\n    Rule:\n    - Rotate/mirror the object so its guide edges face the same sides as the matching frame controls.\n    - Crop off the 1px guide edges from aligned sides.\n\n    Key insight: Guide-edge colors encode target frame sides; the correct dihedral transform matches both simultaneously.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:\n        H, W = arr.shape\n        sides = {\n            \"top\": arr[0, 1:-1],\n            \"bottom\": arr[-1, 1:-1],\n            \"left\": arr[1:-1, 0],\n            \"right\": arr[1:-1, -1],\n        }\n        cand: list[tuple[str, int, int, int]] = []\n        for side, v in sides.items():\n            v = list(map(int, v))\n            v_nb = [x for x in v if x != int(bg)]\n            if not v_nb:\n                continue\n            col, count = Counter(v_nb).most_common(1)[0]\n            # allow up to 1 mismatch (overlap near corners with the other control color)\n            if int(count) >= len(v) - 1:\n                cand.append((side, int(col), int(count), int(len(v))))\n        cand.sort(key=lambda t: (t[2] / t[3], t[2]), reverse=True)\n        return [(s, c) for s, c, _cnt, _L in cand[:2]]\n\n    def extract_center_object(arr: np.ndarray) -> np.ndarray:\n        H, W = arr.shape\n        comps = find_components(arr, bg=int(bg), connectivity=4, monochromatic=False, return_format=\"dict\")\n        best = None  # (area, bbox)\n        for comp in comps:\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            if bool(r0 == 0 or c0 == 0 or r1 == H - 1 or c1 == W - 1):\n                continue\n            area = int(comp[\"area\"])\n            if best is None or area > best[0]:\n                best = (area, (r0, c0, r1, c1))\n        if best is None:\n            return arr.copy()\n        _area, b = best\n        return crop_bbox(arr, b)\n\n    def guide_edges(arr: np.ndarray) -> dict[str, int]:\n        fill = int(Counter(map(int, arr.flatten())).most_common(1)[0][0])\n        edges = {\n            \"top\": arr[0, :],\n            \"bottom\": arr[-1, :],\n            \"left\": arr[:, 0],\n            \"right\": arr[:, -1],\n        }\n        out: dict[str, int] = {}\n        for side, v in edges.items():\n            v = list(map(int, v))\n            v_nf = [x for x in v if x != int(fill)]\n            if not v_nf:\n                continue\n            col, count = Counter(v_nf).most_common(1)[0]\n            if int(count) >= len(v) - 1:\n                out[side] = int(col)\n        return out\n\n    ctrls = detect_controls_frame(g)\n    desired = {side: col for side, col in ctrls}\n    obj = extract_center_object(g)\n\n    # Try all dihedral transforms: rotations + optional horizontal flip.\n    for k in range(4):\n        base = np.rot90(obj, int(k))\n        for flip in [False, True]:\n            t = np.fliplr(base) if flip else base\n            gedges = guide_edges(t)\n            if all(side in gedges and int(gedges[side]) == int(col) for side, col in desired.items()):\n                top = 1 if \"top\" in desired else 0\n                bottom = int(t.shape[0]) - (1 if \"bottom\" in desired else 0)\n                left = 1 if \"left\" in desired else 0\n                right = int(t.shape[1]) - (1 if \"right\" in desired else 0)\n                return t[int(top) : int(bottom), int(left) : int(right)]\n\n    # Fallback: should not happen on this puzzle.\n    return obj\n\n# --------------- generator (Codex#2) ---------------\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.rot90(arr, int(k))\n    return np.fliplr(out) if flip else out\n\n\ndef _inverse_transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.fliplr(arr) if flip else arr\n    return np.rot90(out, -int(k))\n\n\ndef _build_core(h: int, w: int, fill: int, pattern_colors: list[int]) -> np.ndarray:\n    core = np.full((h, w), int(fill), dtype=int)\n    area = h * w\n    max_nonfill = max(len(pattern_colors), int(area * 0.35))\n    target_nonfill = random.randint(max(len(pattern_colors), area // 10), max_nonfill)\n    painted = 0\n\n    for color in pattern_colors:\n        r = random.randrange(h)\n        c = random.randrange(w)\n        core[r, c] = int(color)\n        painted += 1\n\n    while painted < target_nonfill:\n        color = random.choice(pattern_colors)\n        shape_kind = random.choice([\"dot\", \"line\", \"rect\"])\n        if shape_kind == \"dot\":\n            cells = [(random.randrange(h), random.randrange(w))]\n        elif shape_kind == \"line\":\n            line_len = random.randint(2, min(5, max(h, w)))\n            if random.random() < 0.5:\n                rr = random.randrange(h)\n                c0 = random.randrange(max(1, w - line_len + 1))\n                cells = [(rr, c0 + dc) for dc in range(line_len)]\n            else:\n                r0 = random.randrange(max(1, h - line_len + 1))\n                cc = random.randrange(w)\n                cells = [(r0 + dr, cc) for dr in range(line_len)]\n        else:\n            mh = random.randint(1, min(3, h))\n            mw = random.randint(1, min(3, w))\n            r0 = random.randrange(h - mh + 1)\n            c0 = random.randrange(w - mw + 1)\n            cells = [(r0 + dr, c0 + dc) for dr in range(mh) for dc in range(mw)]\n\n        remaining = target_nonfill - painted\n        if remaining <= 0:\n            break\n        fill_cells = [(r, c) for r, c in cells if core[r, c] == fill]\n        if len(fill_cells) > remaining:\n            fill_cells = random.sample(fill_cells, remaining)\n        for r, c in fill_cells:\n            core[r, c] = int(color)\n        painted += len(fill_cells)\n        for r, c in cells:\n            if core[r, c] != fill:\n                continue\n            if painted >= target_nonfill:\n                break\n            core[r, c] = int(color)\n            painted += 1\n\n    return core\n\n\ndef _attach_guides(core: np.ndarray, guide_sides: tuple[str, str], guide_colors: dict[str, int]) -> np.ndarray:\n    h, w = core.shape\n    has_top = \"top\" in guide_sides\n    has_bottom = \"bottom\" in guide_sides\n    has_left = \"left\" in guide_sides\n    has_right = \"right\" in guide_sides\n    out = np.zeros((h + has_top + has_bottom, w + has_left + has_right), dtype=int)\n    r0 = 1 if has_top else 0\n    c0 = 1 if has_left else 0\n    paste(out, core, r0, c0)\n\n    if has_top:\n        out[0, c0 : c0 + w] = int(guide_colors[\"top\"])\n    if has_bottom:\n        out[-1, c0 : c0 + w] = int(guide_colors[\"bottom\"])\n    if has_left:\n        out[r0 : r0 + h, 0] = int(guide_colors[\"left\"])\n    if has_right:\n        out[r0 : r0 + h, -1] = int(guide_colors[\"right\"])\n\n    if has_top and has_left:\n        out[0, 0] = 0\n    if has_top and has_right:\n        out[0, -1] = 0\n    if has_bottom and has_left:\n        out[-1, 0] = 0\n    if has_bottom and has_right:\n        out[-1, -1] = 0\n    return out\n\n\ndef _paint_frame(grid: np.ndarray, horiz_side: str, vert_side: str, ctrl_h: int, ctrl_v: int) -> None:\n    n = grid.shape[0]\n    if horiz_side == \"top\":\n        grid[0, :] = int(ctrl_h)\n    else:\n        grid[-1, :] = int(ctrl_h)\n    if vert_side == \"left\":\n        grid[:, 0] = int(ctrl_v)\n    else:\n        grid[:, -1] = int(ctrl_v)\n\n    for side in (\"top\", \"bottom\", \"left\", \"right\"):\n        if side in (horiz_side, vert_side):\n            continue\n        if side in (\"top\", \"bottom\"):\n            r = 0 if side == \"top\" else n - 1\n            coords = [(r, c) for c in range(1, n - 1)]\n        else:\n            c = 0 if side == \"left\" else n - 1\n            coords = [(r, c) for r in range(1, n - 1)]\n        min_count = int(np.ceil(0.35 * len(coords)))\n        max_count = int(np.floor(0.60 * len(coords)))\n        noise_count = random.randint(min_count, max_count)\n        for r, c in random.sample(coords, noise_count):\n            grid[r, c] = 5\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(22, 29)\n    horiz_side, vert_side = random.choice(\n        [(\"top\", \"left\"), (\"top\", \"right\"), (\"bottom\", \"left\"), (\"bottom\", \"right\")]\n    )\n\n    all_colors = list(range(1, 10))\n    ctrl_h, ctrl_v = random.sample([c for c in all_colors if c != 5], 2)\n    remaining = [c for c in all_colors if c not in {5, ctrl_h, ctrl_v}]\n    fill = random.choice(remaining)\n    remaining = [c for c in remaining if c != fill]\n    n_pattern_colors = random.randint(2, min(4, len(remaining)))\n    pattern_colors = random.sample(remaining, n_pattern_colors)\n\n    max_core_h = min(20, n - 3)\n    max_core_w = min(20, n - 3)\n    if max_core_h < 5 or max_core_w < 5:\n        return None\n    core_h = random.randint(5, max_core_h)\n    core_w = random.randint(5, max_core_w)\n    core = _build_core(core_h, core_w, fill, pattern_colors)\n\n    guide_colors = {horiz_side: ctrl_h, vert_side: ctrl_v}\n    aligned_object = _attach_guides(core, (horiz_side, vert_side), guide_colors)\n\n    k = random.randrange(4)\n    flip = bool(random.randrange(2))\n    input_object = _inverse_transform(aligned_object, k, flip)\n\n    grid = np.zeros((n, n), dtype=int)\n    _paint_frame(grid, horiz_side, vert_side, ctrl_h, ctrl_v)\n\n    try:\n        r0, c0 = random_free_location(grid, input_object, transparent=0, border=1)\n    except ValueError:\n        return None\n    paste(grid, input_object, r0, c0, transparent=0)\n\n    if not np.array_equal(main(grid), core):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for fc7cae8d\")\n","exit_code":0,"status":"completed"}}
