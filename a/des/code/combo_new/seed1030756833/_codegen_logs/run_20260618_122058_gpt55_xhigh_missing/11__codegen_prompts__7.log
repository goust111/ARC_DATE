{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n\n    Input structure:\n    - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n    - Several smaller colored sprites scattered around the bar.\n\n    Rule:\n    - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n    - The root defines a strip (column-span or row-span) for its chain.\n    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n    - Multiple chains grow independently from different bar notches.\n\n    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    bg = get_bg(g)\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    comps.sort(key=lambda d: -d[\"area\"])\n    assert comps\n\n    bar = comps[0]\n    pieces_raw = comps[1:]\n\n    out = np.full((H, W), int(bg), dtype=int)\n    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_color = int(bar[\"color\"])\n    bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_occ:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for r, c in bar_occ:\n        out[r, c] = bar_color\n\n    def shape_from_coords(coords: np.ndarray, bbox):\n        r0, c0, r1, c1 = map(int, bbox)\n        h, w = r1 - r0 + 1, c1 - c0 + 1\n        rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n        rel_set = set(rel)\n        return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n\n    pieces = []\n    for p in pieces_raw:\n        # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n        r0, c0 = map(int, p[\"bbox\"][:2])\n        pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n\n    def bar_notches(bar_mask, bar_r0, bar_c0):\n        empty = ~bar_mask\n        h, w = map(int, empty.shape)\n        notches = []\n        for pts in components_mask(empty, connectivity=4):\n            r = pts[:, 0]\n            c = pts[:, 1]\n            top = int((r == 0).sum())\n            bottom = int((r == h - 1).sum())\n            left = int((c == 0).sum())\n            right = int((c == w - 1).sum())\n\n            # Keep only holes that open to the bar bbox boundary.\n            if top + bottom + left + right == 0:\n                continue\n\n            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n\n            # Axis is determined by which bbox side has the widest mouth.\n            side, mouth_n = max(\n                [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n                key=lambda x: x[1],\n            )\n            axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n            notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n        return notches\n\n    notches = bar_notches(bar_mask, bar_r0, bar_c0)\n\n    def pixels(v, top, left):\n        return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n\n    def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n        if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n            return None\n        if strip is not None:\n            axis, A, B = strip\n            if axis == \"cols\":\n                if left != A or v[\"w\"] != B - A + 1:\n                    return None\n            else:\n                if top != A or v[\"h\"] != B - A + 1:\n                    return None\n        pts = pixels(v, top, left)\n        if pts & occ:\n            return None\n        if must_cover is not None and not (must_cover <= pts):\n            return None\n        return pts\n\n    def aligned_positions(axis, A, cover, v):\n        if axis == \"cols\":\n            left = A\n            tops = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if cN == left + lc:\n                        tops.add(rN - lr)\n            for top in tops:\n                yield top, left\n        else:\n            top = A\n            lefts = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if rN == top + lr:\n                        lefts.add(cN - lc)\n            for left in lefts:\n                yield top, left\n\n    def touches(pts, other):\n        for r, c in pts:\n            for dr, dc in DIR4:\n                if (r + dr, c + dc) in other:\n                    return True\n        return False\n\n    def hole_positions(hole, v):\n        pos = set()\n        for rH, cH in hole:\n            for lr, lc in v[\"rel\"]:\n                pos.add((rH - lr, cH - lc))\n        return pos\n\n    # Root candidates: fill the bar hole (no strip constraint yet).\n    root_cands = []\n    for ni, n in enumerate(notches):\n        axis = n[\"axis\"]\n\n        for pi, p in enumerate(pieces):\n            v = p[\"shape\"]\n            for top, left in hole_positions(n[\"hole\"], v):\n                pts = placement_pts(v, top, left, bar_occ, must_cover=n[\"hole\"])\n                if pts is None:\n                    continue\n                if axis == \"cols\":\n                    A, B = int(left), int(left + v[\"w\"] - 1)\n                else:\n                    A, B = int(top), int(top + v[\"h\"] - 1)\n                mv = abs(int(top) - int(p[\"orig\"][0])) + abs(int(left) - int(p[\"orig\"][1]))\n                root_cands.append(\n                    (\n                        (int(mv), -int(n[\"mouth_n\"])),\n                        {\"ni\": ni, \"pi\": pi, \"top\": int(top), \"left\": int(left), \"axis\": axis, \"A\": A, \"B\": B, \"shape\": v},\n                    )\n                )\n\n    root_cands.sort(key=lambda x: x[0])\n    cand_roots = [pair[1] for pair in root_cands[:20]]\n\n    best_out = out.copy()\n    best_key = None\n\n    def search(out_grid, occ_set, chains, remaining):\n        nonlocal best_out, best_key\n        placed_cnt = len(pieces) - len(remaining)\n        key = (placed_cnt, -len(remaining), -len(occ_set))\n        if best_key is None or key > best_key:\n            best_key = key\n            best_out = out_grid.copy()\n        if not remaining:\n            return True\n\n        def gen_extend_moves(chain, remaining_set):\n            axis = chain[\"axis\"]\n            A, B = int(chain[\"A\"]), int(chain[\"B\"])\n            head = chain[\"head\"]\n            head_pts = pixels(head[\"shape\"], head[\"top\"], head[\"left\"])\n            head_top, head_left = int(head[\"top\"]), int(head[\"left\"])\n            head_h, head_w = int(head[\"shape\"][\"h\"]), int(head[\"shape\"][\"w\"])\n\n            cavity = {\n                (r, c)\n                for r in range(head_top, head_top + head_h)\n                for c in range(head_left, head_left + head_w)\n                if out_grid[r, c] == bg\n            }\n            if not cavity:\n                return []\n\n            moves = []\n            for pi in remaining_set:\n                v = pieces[pi][\"shape\"]\n                for top, left in aligned_positions(axis, A, cavity, v):\n                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))\n                    if pts is None:\n                        continue\n                    if not touches(pts, head_pts):\n                        continue\n                    moves.append((pi, top, left, pts, v))\n            return moves\n\n        # Try extending any chain.\n        for ch in chains:\n            moves = gen_extend_moves(ch, remaining)\n            if not moves:\n                continue\n            # small branching factor is enough for this puzzle\n            for pi, top, left, pts, v in moves[:8]:\n                # apply\n                for r, c in pts:\n                    out_grid[r, c] = int(pieces[pi][\"color\"])\n                old_head = ch[\"head\"]\n                ch[\"head\"] = {\"top\": int(top), \"left\": int(left), \"shape\": v}\n                occ2 = set(occ_set) | set(pts)\n                rem2 = set(remaining)\n                rem2.remove(pi)\n                if search(out_grid, occ2, chains, rem2):\n                    return True\n                # undo\n                ch[\"head\"] = old_head\n                for r, c in pts:\n                    out_grid[r, c] = int(bg)\n                # restore bar pixels (roots are always non-overlapping)\n                for r, c in bar_occ:\n                    out_grid[r, c] = bar_color\n        return False\n\n    # Try small root subsets (1..3) from top candidates.\n    from itertools import combinations\n\n    for k in range(1, min(3, len(cand_roots)) + 1):\n        for roots_sel in combinations(range(len(cand_roots)), k):\n            used_p = set()\n            used_n = set()\n            occ0 = set(bar_occ)\n            out0 = np.full((H, W), int(bg), dtype=int)\n            for r, c in bar_occ:\n                out0[r, c] = bar_color\n\n            chains = []\n            ok = True\n            for idx in roots_sel:\n                root = cand_roots[idx]\n                if root[\"pi\"] in used_p or root[\"ni\"] in used_n:\n                    ok = False\n                    break\n                pts = pixels(root[\"shape\"], root[\"top\"], root[\"left\"])\n                if pts & occ0:\n                    ok = False\n                    break\n                used_p.add(root[\"pi\"])\n                used_n.add(root[\"ni\"])\n                for r, c in pts:\n                    out0[r, c] = int(pieces[root[\"pi\"]][\"color\"])\n                occ0 |= pts\n                chains.append({\"axis\": root[\"axis\"], \"A\": root[\"A\"], \"B\": root[\"B\"], \"head\": {\"top\": root[\"top\"], \"left\": root[\"left\"], \"shape\": root[\"shape\"]}})\n\n            if not ok:\n                continue\n            remaining = set(range(len(pieces))) - used_p\n            search(out0, occ0, chains, remaining)\n\n    return best_out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\ndef _connected(cells):\n    \"\"\"Check 4-connectivity of a cell set.\"\"\"\n    if len(cells) <= 1:\n        return True\n    cells_set = set(cells)\n    start = next(iter(cells_set))\n    visited = {start}\n    stack = [start]\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nb = (r + dr, c + dc)\n            if nb in cells_set and nb not in visited:\n                visited.add(nb)\n                stack.append(nb)\n    return len(visited) == len(cells_set)\n\n\ndef _grow_connected(rng, available, target, seeds, must_span_axis=None, span_range=None, retries=3):\n    \"\"\"Grow a 4-connected shape of exactly *target* cells within *available*, starting from *seeds*.\n\n    *must_span_axis* (\"cols\"/\"rows\") + *span_range* (A, B) enforce that the\n    resulting shape spans from A to B along that axis.\n    \"\"\"\n    _D4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    for _ in range(retries):\n        cells = set(seeds)\n        if not cells.issubset(available):\n            return None\n        for __ in range(target * 20):\n            if len(cells) >= target:\n                break\n            frontier = [nb for r, c in cells for dr, dc in _D4\n                        if (nb := (r + dr, c + dc)) in available and nb not in cells]\n            if not frontier:\n                break\n            # Prioritise filling span gaps\n            if must_span_axis and span_range:\n                A, B = span_range\n                if must_span_axis == \"cols\":\n                    cm, cx = min((c for _, c in cells), default=B), max((c for _, c in cells), default=A)\n                    if cm > A:\n                        p = [nb for nb in frontier if nb[1] < cm]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n                    if cx < B:\n                        p = [nb for nb in frontier if nb[1] > cx]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n                else:\n                    cm, cx = min((r for r, _ in cells), default=B), max((r for r, _ in cells), default=A)\n                    if cm > A:\n                        p = [nb for nb in frontier if nb[0] < cm]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n                    if cx < B:\n                        p = [nb for nb in frontier if nb[0] > cx]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n            cells.add(rng.choice(frontier))\n        if len(cells) < target:\n            continue\n        # Trim to target while preserving seeds, span, and connectivity\n        while len(cells) > target:\n            removable = []\n            for rc in cells:\n                if rc in seeds:\n                    continue\n                if must_span_axis and span_range:\n                    A, B = span_range\n                    if must_span_axis == \"cols\":\n                        if rc[1] == A and sum(1 for _, c2 in cells if c2 == A) <= 1:\n                            continue\n                        if rc[1] == B and sum(1 for _, c2 in cells if c2 == B) <= 1:\n                            continue\n                    else:\n                        if rc[0] == A and sum(1 for r2, _ in cells if r2 == A) <= 1:\n                            continue\n                        if rc[0] == B and sum(1 for r2, _ in cells if r2 == B) <= 1:\n                            continue\n                if _connected(cells - {rc}):\n                    removable.append(rc)\n            if not removable:\n                break\n            cells.remove(rng.choice(removable))\n        if len(cells) != target:\n            continue\n        if must_span_axis and span_range:\n            A, B = span_range\n            if must_span_axis == \"cols\":\n                if min(c for _, c in cells) != A or max(c for _, c in cells) != B:\n                    continue\n            else:\n                if min(r for r, _ in cells) != A or max(r for r, _ in cells) != B:\n                    continue\n        if _connected(cells):\n            return cells\n    return None\n\n\ndef _gen_attempt():\n    \"\"\"Build one (input, output) pair; returns (input, output) or None.\"\"\"\n    import random as _random\n    rng = _random.Random()\n    H, W = 30, 30\n    bg = 0\n\n    # ---- bar ----------------------------------------------------------\n    orientation = rng.choice([\"horizontal\", \"vertical\"])\n    bar_color = rng.randint(1, 9)\n    thickness = rng.randint(5, 7)\n\n    if orientation == \"horizontal\":\n        center = int(rng.uniform(0.35, 0.53) * H)\n        bar_r0 = max(0, center - thickness // 2)\n        bar_r1 = bar_r0 + thickness - 1\n        if bar_r1 >= H:\n            bar_r1 = H - 1; bar_r0 = bar_r1 - thickness + 1\n        bar_c0, bar_c1 = 0, W - 1\n        space_before, space_after = bar_r0, H - 1 - bar_r1\n    else:\n        center = int(rng.uniform(0.35, 0.53) * W)\n        bar_c0 = max(0, center - thickness // 2)\n        bar_c1 = bar_c0 + thickness - 1\n        if bar_c1 >= W:\n            bar_c1 = W - 1; bar_c0 = bar_c1 - thickness + 1\n        bar_r0, bar_r1 = 0, H - 1\n        space_before, space_after = bar_c0, W - 1 - bar_c1\n\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_cells = set((r, c) for r in range(bar_r0, bar_r1 + 1)\n                    for c in range(bar_c0, bar_c1 + 1))\n\n    # ---- plan chains --------------------------------------------------\n    num_chains = rng.randint(1, 2)\n    chain_lens = [3] if num_chains == 1 else [rng.randint(2, 3) for _ in range(2)]\n    if num_chains == 2:\n        while not (3 <= sum(chain_lens) <= 6):\n            chain_lens = [rng.randint(2, 3) for _ in range(2)]\n\n    avail_colors = [c for c in range(1, 10) if c != bar_color]\n    rng.shuffle(avail_colors)\n    color_idx = 0\n\n    all_chain_pieces = []\n    notch_holes: list[set] = []\n    occ_set = set(bar_cells)\n\n    for chain_idx in range(num_chains):\n        chain_len = chain_lens[chain_idx]\n        strip_width = rng.randint(4, 5)\n\n        # pick side with enough room\n        if orientation == \"horizontal\":\n            sides = [\"top\", \"bottom\"]; rng.shuffle(sides)\n            side = next((s for s in sides\n                         if (space_before if s == \"top\" else space_after) >= chain_len * 2 + 3), None)\n            if side is None:\n                return None\n            sc0 = rng.randint(1, W - strip_width - 1); sc1 = sc0 + strip_width - 1\n            sA, sB = sc0, sc1\n        else:\n            sides = [\"left\", \"right\"]; rng.shuffle(sides)\n            side = next((s for s in sides\n                         if (space_before if s == \"left\" else space_after) >= chain_len * 2 + 3), None)\n            if side is None:\n                return None\n            sr0 = rng.randint(1, H - strip_width - 1); sr1 = sr0 + strip_width - 1\n            sA, sB = sr0, sr1\n\n        # ---- notch (hole carved in bar) ----\n        notch_depth = rng.randint(1, 2)\n        notch_area = rng.randint(1, min(4, notch_depth * strip_width))\n\n        if orientation == \"horizontal\":\n            nr0 = bar_r0 if side == \"top\" else bar_r1 - notch_depth + 1\n            nr1 = bar_r0 + notch_depth - 1 if side == \"top\" else bar_r1\n            n_avail = {(r, c) for r in range(nr0, nr1 + 1)\n                       for c in range(sc0, sc1 + 1) if (r, c) in bar_cells}\n        else:\n            nc0 = bar_c0 if side == \"left\" else bar_c1 - notch_depth + 1\n            nc1 = bar_c0 + notch_depth - 1 if side == \"left\" else bar_c1\n            n_avail = {(r, c) for r in range(sA, sB + 1)\n                       for c in range(nc0, nc1 + 1) if (r, c) in bar_cells}\n\n        # keep away from existing notch holes\n        all_holes = set().union(*notch_holes) if notch_holes else set()\n        n_avail -= all_holes | {(r + dr, c + dc)\n                                for r, c in all_holes for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}\n        if len(n_avail) < notch_area:\n            return None\n\n        notch = _grow_connected(rng, n_avail, notch_area, {rng.choice(list(n_avail))})\n        if notch is None:\n            return None\n        bar_cells -= notch\n        notch_holes.append(notch)\n\n        # ---- chain pieces ----\n        chain_pieces = []\n        for piece_idx in range(chain_len):\n            if color_idx >= len(avail_colors):\n                return None\n            piece_color = avail_colors[color_idx]; color_idx += 1\n            piece_area = rng.randint(8, 13)\n            chain_dim = rng.randint(2, 3)\n\n            if piece_idx == 0:\n                # ROOT: fill notch + extend outside bar\n                if orientation == \"horizontal\":\n                    if side == \"top\":\n                        pr0, pr1 = max(0, bar_r0 - chain_dim), max(r for r, _ in notch)\n                    else:\n                        pr0, pr1 = min(r for r, _ in notch), min(H - 1, bar_r1 + chain_dim)\n                    pc0, pc1 = sc0, sc1\n                else:\n                    if side == \"left\":\n                        pc0, pc1 = max(0, bar_c0 - chain_dim), max(c for _, c in notch)\n                    else:\n                        pc0, pc1 = min(c for _, c in notch), min(W - 1, bar_c1 + chain_dim)\n                    pr0, pr1 = sA, sB\n\n                bbox_area = (pr1 - pr0 + 1) * (pc1 - pc0 + 1)\n                target = max(max(8, int(bbox_area * 0.54)),\n                             min(piece_area, int(bbox_area * 0.80)))\n                if target > bbox_area or target < 8:\n                    return None\n\n                avail = {(r, c) for r in range(pr0, pr1 + 1) for c in range(pc0, pc1 + 1)\n                         if (r, c) in notch or (r, c) not in occ_set}\n                root = _grow_connected(rng, avail, target, notch,\n                                       must_span_axis=\"cols\" if orientation == \"horizontal\" else \"rows\",\n                                       span_range=(sA, sB), retries=5)\n                if root is None:\n                    return None\n                if not any(not (bar_r0 <= r <= bar_r1 and bar_c0 <= c <= bar_c1) for r, c in root):\n                    return None\n                piece_cells = root\n            else:\n                # CONTINUATION: fill cavity in prev bbox + extend further from bar\n                prev_coords = chain_pieces[-1][\"coords\"]\n                prs = [r for r, _ in prev_coords]; pcs = [c for _, c in prev_coords]\n                prev_r0, prev_r1 = min(prs), max(prs)\n                prev_c0, prev_c1 = min(pcs), max(pcs)\n\n                if orientation == \"horizontal\":\n                    cavity = {(r, c) for r in range(prev_r0, prev_r1 + 1)\n                              for c in range(sc0, sc1 + 1)\n                              if (r, c) not in occ_set and (r, c) not in prev_coords}\n                else:\n                    cavity = {(r, c) for r in range(sA, sB + 1)\n                              for c in range(prev_c0, prev_c1 + 1)\n                              if (r, c) not in occ_set and (r, c) not in prev_coords}\n                if not cavity:\n                    return None\n\n                if orientation == \"horizontal\":\n                    es = (max(0, prev_r0 - chain_dim), prev_r0 - 1) if side == \"top\" \\\n                        else (prev_r1 + 1, min(H - 1, prev_r1 + chain_dim))\n                    ext = {(r, c) for r in range(es[0], es[1] + 1)\n                           for c in range(sc0, sc1 + 1)\n                           if (r, c) not in occ_set} if es[0] <= es[1] else set()\n                else:\n                    es = (max(0, prev_c0 - chain_dim), prev_c0 - 1) if side == \"left\" \\\n                        else (prev_c1 + 1, min(W - 1, prev_c1 + chain_dim))\n                    ext = {(r, c) for r in range(sA, sB + 1)\n                           for c in range(es[0], es[1] + 1)\n                           if (r, c) not in occ_set} if es[0] <= es[1] else set()\n\n                all_avail = cavity | ext\n                target = min(13, max(len(cavity), min(piece_area, len(all_avail))))\n                if len(cavity) > 13 or target < 8:\n                    return None\n\n                # Tail piece must leave zero cavity in its bbox within strip\n                is_tail = (piece_idx == chain_len - 1)\n                if is_tail:\n                    target = min(13, len(all_avail))\n\n                piece_cells = _grow_connected(rng, all_avail, target, cavity,\n                                              must_span_axis=\"cols\" if orientation == \"horizontal\" else \"rows\",\n                                              span_range=(sA, sB), retries=5)\n                if piece_cells is None or not cavity.issubset(piece_cells):\n                    return None\n\n                if is_tail:\n                    prs2 = [r for r, _ in piece_cells]; pcs2 = [c for _, c in piece_cells]\n                    t_r0, t_r1 = min(prs2), max(prs2)\n                    t_c0, t_c1 = min(pcs2), max(pcs2)\n                    if orientation == \"horizontal\":\n                        remaining = {(r, c) for r in range(t_r0, t_r1 + 1) for c in range(sc0, sc1 + 1)\n                                     if (r, c) not in occ_set and (r, c) not in piece_cells}\n                    else:\n                        remaining = {(r, c) for r in range(sA, sB + 1) for c in range(t_c0, t_c1 + 1)\n                                     if (r, c) not in occ_set and (r, c) not in piece_cells}\n                    if remaining:\n                        return None\n\n            if not (8 <= len(piece_cells) <= 13):\n                return None\n            chain_pieces.append({\"color\": piece_color, \"coords\": piece_cells})\n            occ_set |= piece_cells\n\n        if len(chain_pieces) < chain_len:\n            return None\n        all_chain_pieces.extend(chain_pieces)\n\n    if not (3 <= len(all_chain_pieces) <= 6):\n        return None\n\n    # ---- decoy notches (4-7) ------------------------------------------\n    num_decoys = rng.randint(4, 7)\n    decoys = 0\n    for _ in range(500):\n        if decoys >= num_decoys:\n            break\n        depth = rng.randint(1, 2)\n        area = rng.randint(1, min(6, depth * 5))\n        if orientation == \"horizontal\":\n            ds = rng.choice([\"top\", \"bottom\"])\n            dr0 = bar_r0 if ds == \"top\" else bar_r1 - depth + 1\n            dr1 = bar_r0 + depth - 1 if ds == \"top\" else bar_r1\n            dc0 = rng.randint(bar_c0, bar_c1)\n            dc1 = min(bar_c1, dc0 + rng.randint(0, 4))\n        else:\n            ds = rng.choice([\"left\", \"right\"])\n            dc0 = bar_c0 if ds == \"left\" else bar_c1 - depth + 1\n            dc1 = bar_c0 + depth - 1 if ds == \"left\" else bar_c1\n            dr0 = rng.randint(bar_r0, bar_r1)\n            dr1 = min(bar_r1, dr0 + rng.randint(0, 4))\n\n        d_avail = {(r, c) for r in range(dr0, dr1 + 1) for c in range(dc0, dc1 + 1)\n                   if (r, c) in bar_cells}\n        all_h = set().union(*notch_holes) if notch_holes else set()\n        d_avail -= all_h | {(r + dr, c + dc) for r, c in all_h for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}\n        if len(d_avail) < 1:\n            continue\n        area = min(area, len(d_avail))\n        dn = _grow_connected(rng, d_avail, area, {rng.choice(list(d_avail))})\n        if dn is None:\n            continue\n        if not _connected(bar_cells - dn):\n            continue\n        bar_cells -= dn\n        notch_holes.append(dn)\n        decoys += 1\n    if decoys < 4:\n        return None\n\n    # verify no internal holes in bar bbox\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_cells:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for pts in components_mask(~bar_mask, connectivity=4):\n        rr, cc = pts[:, 0], pts[:, 1]\n        if not ((rr == 0).any() or (rr == bar_h - 1).any()\n                or (cc == 0).any() or (cc == bar_w - 1).any()):\n            return None\n\n    # ---- assemble output ----------------------------------------------\n    output = np.full((H, W), bg, dtype=int)\n    for r, c in bar_cells:\n        output[r, c] = bar_color\n    for p in all_chain_pieces:\n        for r, c in p[\"coords\"]:\n            output[r, c] = p[\"color\"]\n\n    # ---- scatter pieces for input -------------------------------------\n    input_grid = np.full((H, W), bg, dtype=int)\n    for r, c in bar_cells:\n        input_grid[r, c] = bar_color\n\n    placed_occ = set(bar_cells)\n    pieces_order = list(all_chain_pieces)\n    rng.shuffle(pieces_order)\n\n    for p in pieces_order:\n        coords = p[\"coords\"]; color = p[\"color\"]\n        rs = [r for r, _ in coords]; cs = [c for _, c in coords]\n        p_r0, p_c0 = min(rs), min(cs)\n        rel = [(r - p_r0, c - p_c0) for r, c in coords]\n        p_h, p_w = max(rs) - p_r0 + 1, max(cs) - p_c0 + 1\n\n        placed = False\n        for _ in range(500):\n            gap = rng.randint(2, 7)\n            if orientation == \"horizontal\":\n                top = (bar_r0 - gap - p_h) if rng.random() < 0.5 else (bar_r1 + gap + 1)\n                left = rng.randint(0, max(0, W - p_w))\n            else:\n                left = (bar_c0 - gap - p_w) if rng.random() < 0.5 else (bar_c1 + gap + 1)\n                top = rng.randint(0, max(0, H - p_h))\n            if top < 0 or top + p_h > H or left < 0 or left + p_w > W:\n                continue\n            pts = {(top + dr, left + dc) for dr, dc in rel}\n            if pts & placed_occ:\n                continue\n            if any((r + dr, c + dc) in placed_occ\n                   for r, c in pts for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]):\n                continue\n            for r, c in pts:\n                input_grid[r, c] = color\n            placed_occ |= pts\n            placed = True\n            break\n        if not placed:\n            return None\n\n    return input_grid, output\n\n\ndef generate_input():\ndef generate_input():\n    \"\"\"Generate a valid input grid for task 16b78196 (max 300 retries).\"\"\"\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is None:\n            continue\n        inp, out = result\n        if np.array_equal(main(inp), out):\n            return inp\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
