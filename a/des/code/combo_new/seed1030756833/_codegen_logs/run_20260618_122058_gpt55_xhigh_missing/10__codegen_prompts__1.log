id: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:42:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:184:    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:188:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:202:    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:207:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:245:    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:296:    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:302:    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:305:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:330:    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:357:    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:388:    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:407:    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py:508:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:8:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:11:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:34:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:35:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:46:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:140:    \"\"\"Pick up to n values from candidates with at least min_spacing between any two.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:156:    \"\"\"Generate a single-color 8-connected sprite cropped to its bounding box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/247ef758.py:306:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/8a6d367c.py:51:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/8a6d367c.py:52:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/8a6d367c.py:67:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/8a6d367c.py:251:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
