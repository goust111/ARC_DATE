   \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/db7260a4.py:219:    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/db7260a4.py:258:    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/db7260a4.py:301:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:12:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:38:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:43:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:68:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:69:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:83:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:154:    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:159:    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:173:    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:178:    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:193:    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:207:    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:228:    \"\"\"Place a full-column vertical divider with legend panel left or right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:250:    \"\"\"Compute divider pivot and legend placement bounds for an L-corner.\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:254:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:280:    \"\"\"Place an L-shaped divider with legend panel in one corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:329:    \"\"\"Randomly choose and apply a divider layout (horizontal/vertical/L).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:341:    \"\"\"Sample a random sprite area based on hole count.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:351:    \"\"\"Find well-separated seed positions for holes inside the canvas.\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:354:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:372:    \"\"\"Grow irregular blob regions around each hole seed. Returns the full forbidden set.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:402:    \"\"\"Find the nearest non-forbidden cell to the canvas center.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:416:    \"\"\"Grow a random connected blob of target area, avoiding forbidden cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:437:    \"\"\"Seal gaps around forbidden cells and keep only the largest connected component.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:458:    \"\"\"Crop mask to tight bbox (including forbidden cells), validate shape and holes.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:477:    \"\"\"Generate a random amorphous grey sprite with the specified number of holes.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:503:    \"\"\"Build a shuffled list of (hole_count, color_or_None) for all sprites to generate.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:529:    \"\"\"8-connectivity dilation of a boolean mask (1-cell padding in all directions).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:536:    \"\"\"Find a random valid placement for sprite, avoiding blocked and occupied areas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:557:    \"\"\"Generate and place all sprites (matches + distractors) onto the grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:583:    \"\"\"Single attempt: build layout, place sprites, validate via oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:600:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
