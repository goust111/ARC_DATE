new/ARC_code/eval/64efde09.py:273:    \"\"\"Try to place all chosen variants on the grid without overlap (with padding).\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:276:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:298:    \"\"\"Compute the boundary cell that direction (dr, dc) points toward from (r, c).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:311:    \"\"\"Choose and place 3 markers on boundary cells. Mutates *grid* in place.\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:314:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/64efde09.py:394:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:45:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:51:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:72:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:75:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:96:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:99:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:136:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:139:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:258:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:259:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:273:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:334:    \"\"\"Min/max piece area for a given output side length.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:340:    \"\"\"Return True if the mask contains an interior hole (bg region not touching the bbox edge).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:357:    \"\"\"Check that piece bbox dims force a unique S*S factorization of total area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:366:    \"\"\"Build an L-shaped legend piece mask anchored at (0,0) of the side*side grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/f560132c.py:384:    \"\"\"