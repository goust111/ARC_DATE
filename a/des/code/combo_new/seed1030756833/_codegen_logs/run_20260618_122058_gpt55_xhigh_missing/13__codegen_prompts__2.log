{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, random, sys\nDIRS=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef comps(cells):\n    cells=set(cells); out=[]\n    while cells:\n        s=cells.pop(); st=[s]; comp={s}\n        while st:\n            r,c=st.pop()\n            for dr,dc in DIRS:\n                nb=(r+dr,c+dc)\n                if nb in cells:\n                    cells.remove(nb); comp.add(nb); st.append(nb)\n        out.append(comp)\n    return out\n\ndef norm(cells):\n    r0=min(r for r,c in cells); c0=min(c for r,c in cells)\n    return frozenset((r-r0,c-c0) for r,c in cells)\n\ndef rot_norm(cells):\n    n=norm(cells); h=max(r for r,c in n)+1; w=max(c for r,c in n)+1\n    return frozenset((h-1-r,w-1-c) for r,c in n)\n\ndef is_rect(cells):\n    r0=min(r for r,c in cells); r1=max(r for r,c in cells); c0=min(c for r,c in cells); c1=max(c for r,c in cells)\n    return len(cells)==(r1-r0+1)*(c1-c0+1), (r0,c0,r1,c1)\n\ndef rand_connected(H,W,area):\n    s={(random.randrange(H),random.randrange(W))}\n    while len(s)<area:\n        fr=[]\n        for r,c in s:\n            for dr,dc in DIRS:\n                nb=(r+dr,c+dc)\n                if 0<=nb[0]<H and 0<=nb[1]<W and nb not in s:\n                    fr.append(nb)\n        if not fr: return None\n        s.add(random.choice(fr))\n    return s\n\nfor H,W in [(5,5),(5,6),(6,6),(6,7),(7,7),(8,8)]:\n  for area in range(2,11):\n    seen=[]\n    for _ in range(3000):\n      A=rand_connected(H,W,area); B=rand_connected(H,W,area)\n      if not A or not B or A&B: continue\n      if any(abs(r-r2)+abs(c-c2)==1 for r,c in A for r2,c2 in B): continue\n      if norm(B)\"'!=rot_norm(A): continue\n      r0=min(r for r,c in A|B); r1=max(r for r,c in A|B); c0=min(c for r,c in A|B); c1=max(c for r,c in A|B)\n      for which in [0,1]:\n        X=A if which==0 else B; Y=B if which==0 else A\n        TX={(r0+r1-r,c0+c1-c) for r,c in X}\n        if TX & Y: continue\n        ok,bb=is_rect(TX|Y)\n        if ok:\n          print('\"'FOUND',H,W,'area',area,'rotate',which,'bb',bb)\n          for r in range(H):\n            s=''\n            for c in range(W):\n              p=(r,c)\n              if p in X: s+='A'\n              elif p in Y: s+='B'\n              elif p in TX: s+='x'\n              else: s+='.'\n            print(s)\n          sys.exit()\n    print('tried',H,W,area)\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
