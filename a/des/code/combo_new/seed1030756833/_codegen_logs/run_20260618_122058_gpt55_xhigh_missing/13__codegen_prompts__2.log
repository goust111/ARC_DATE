{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/320afe60.py | sed -n '1,260p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each foreground object horizontally to the edge indicated by whether its shape has an open notch.\n\n    Input structure:\n    - Yellow is the background and there is one blue foreground color.\n    - The foreground is split into separated 4-connected objects.\n    - Each object keeps its row span and shape in the output.\n\n    Rule:\n    - If an object's bbox border contains a background gap flanked by object pixels along that same border, slide it to the right edge and recolor it green.\n    - Otherwise slide the object to the left edge and recolor it red.\n    - Start from a blank background canvas; no moved objects overlap.\n\n    Key insight:\n    - The target side is encoded by the object's shape, not by its original position: open notches go right, while closed or solid shapes go left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n    fg = int(fg_colors[0])\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])\n    assert components, \"expected at least one foreground object\"\n\n    out = np.full_like(g, bg)\n    W = g.shape[1]\n    for component in components:\n        bbox = tuple(map(int, component[\"bbox\"]))\n        r0, _c0, r1, _c1 = bbox\n        mask = _component_mask(component[\"coords\"], bbox)\n        h, w = mask.shape\n\n        has_open_notch = _has_flanked_boundary_gap(mask)\n        dst_c = W - w if has_open_notch else 0\n        color = GREEN if has_open_notch else RED\n        assert 0 <= dst_c and dst_c + w <= W, \"moved object must fit within the grid\"\n\n        dst = out[r0 : r1 + 1, dst_c : dst_c + w]\n        assert dst.shape == (h, w), \"destination slice must match object bbox\"\n        assert np.all(dst[mask] == bg), \"moved objects must not overlap\"\n        dst[mask] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and colors.\nBG, BLUE, RED, GREEN = Color.YELLOW, Color.BLUE, Color.RED, Color.GREEN\nGRID_H, GRID_W_MIN, GRID_W_MAX = 22, 19, 26\n\n# Object counts, dimensions, and row separation.\nOBJECT_COUNT_MIN, OBJECT_COUNT_MAX, NOTCH_OBJECT_COUNT = 3, 5, 2\nOBJECT_H_MIN, OBJECT_H_MAX, OBJECT_W_MIN, OBJECT_W_MAX = 2, 6, 2, 9\nMIN_ROW_GAP = 1\n\n# Shape density and carving probabilities.\nMIN_FILL_RATIO, CLOSED_LARGE_AREA_MIN = 0.64, 12\nNOTCH_INTERIOR_CARVE_PROB, EXTRA_CARVE_PROB = 0.45, 0.20\nCLOSED_CARVE_PROB_SMALL, CLOSED_CARVE_PROB_LARGE = 0.45, 0.88\n\n# Placement and retry limits.\nINTERIOR_COL_PAD, MAX_FOREGROUND_FRACTION = 1, 0.5\nGENERATION_RETRIES = 300\n\n\ndef _has_flanked_boundary_gap(mask: np.ndarray) -> bool:\n    h, w = mask.shape\n    for c in range(w):\n        if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():\n            return True\n        if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():\n            return True\n    for r in range(h):\n        if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():\n            return True\n        if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():\n            return True\n    return False\n\n\ndef _patch(mask: np.ndarray, color: int) -> np.ndarray:\n    out = np.full(mask.shape, BG, dtype=int)\n    out[mask] = int(color)\n    return out\n\n\ndef _random_heights(n: int) -> list[int]:\n    usable = GRID_H - MIN_ROW_GAP * (n - 1)\n    choices = [\n        hs\n        for hs in itertools.product(range(OBJECT_H_MIN, OBJECT_H_MAX + 1), repeat=n)\n        if sum(hs) <= usable\n    ]\n    return list(random.choice(choices))\n\n\ndef _row_starts(heights: list[int]) -> list[int]:\n    free = GRID_H - sum(heights) - MIN_ROW_GAP * (len(heights) - 1)\n    gaps = [0] * (len(heights) + 1)\n    for _ in range(free):\n        gaps[random.randrange(len(gaps))] += 1\n\n    starts = []\n    r = gaps[0]\n    for i, h in enumerate(heights):\n        starts.append(r)\n        r += h\n        if i + 1 < len(heights):\n            r += MIN_ROW_GAP + gaps[i + 1]\n    return starts\n\n\ndef _carve_interior_rect(mask: np.ndarray, max_remove: int, probability: float) -> int:\n    if max_remove <= 0 or random.random() > probability:\n        return 0\n\n    h, w = mask.shape\n    choices = []\n    for r0 in range(1, h - 1):\n        for c0 in range(1, w - 1):\n            for r1 in range(r0, h - 1):\n                for c1 in range(c0, w - 1):\n                    area = (r1 - r0 + 1) * (c1 - c0 + 1)\n                    if area <= max_remove and np.all(mask[r0 : r1 + 1, c0 : c1 + 1]):\n                        choices.append((r0, c0, r1, c1, area))\n    if not choices:\n        return 0\n\n    r0, c0, r1, c1, area = random.choice(choices)\n    mask[r0 : r1 + 1, c0 : c1 + 1] = False\n    return int(area)\n\n\ndef _make_notch_mask(h: int, w: int) -> np.ndarray | None:\n    area = h * w\n    max_remove = area - math.ceil(area * MIN_FILL_RATIO)\n    edges = []\n    if w >= OBJECT_W_MIN + 1:\n        edges.extend([\"top\", \"bottom\"])\n    if h >= OBJECT_H_MIN + 1:\n        edges.extend([\"left\", \"right\"])\n    if not edges or max_remove < 1:\n        return None\n\n    mask = np.ones((h, w), dtype=bool)\n    edge = random.choice(edges)\n    edge_len = w if edge in {\"top\", \"bottom\"} else h\n    run = random.randint(1, min(edge_len - 2, max_remove))\n    start = random.randint(1, edge_len - run - 1)\n\n    if edge in {\"top\", \"bottom\"}:\n        depth = random.randint(1, min(h - 1, max_remove // run))\n        if edge == \"top\":\n            mask[:depth, start : start + run] = False\n        else:\n            mask[h - depth :, start : start + run] = False\n    elif edge == \"left\":\n        depth = random.randint(1, min(w - 1, max_remove // run))\n        mask[start : start + run, :depth] = False\n    else:\n        depth = random.randint(1, min(w - 1, max_remove // run))\n        mask[start : start + run, w - depth :] = False\n\n    removed = run * depth\n    removed += _carve_interior_rect(mask, max_remove - removed, NOTCH_INTERIOR_CARVE_PROB)\n    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)\n    if not _has_flanked_boundary_gap(mask):\n        return None\n    if not is_contiguous(mask.astype(int), background=0, connectivity=4):\n        return None\n    return mask\n\n\ndef _make_closed_mask(h: int, w: int) -> np.ndarray | None:\n    area = h * w\n    mask = np.ones((h, w), dtype=bool)\n    max_remove = area - math.ceil(area * MIN_FILL_RATIO)\n    probability = CLOSED_CARVE_PROB_LARGE if area >= CLOSED_LARGE_AREA_MIN else CLOSED_CARVE_PROB_SMALL\n    removed = _carve_interior_rect(mask, max_remove, probability)\n    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)\n    if _has_flanked_boundary_gap(mask):\n        return None\n    if not is_contiguous(mask.astype(int), background=0, connectivity=4):\n        return None\n    return mask\n\n\ndef _sample_layout() -> tuple[int, list[str], list[int], list[int]]:\n    W = random.randint(GRID_W_MIN, GRID_W_MAX)\n    n = random.randint(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX)\n    kinds = [\"notch\"] * NOTCH_OBJECT_COUNT + [\"closed\"] * (n - NOTCH_OBJECT_COUNT)\n    random.shuffle(kinds)\n\n    heights = _random_heights(n)\n    starts = _row_starts(heights)\n    return W, kinds, heights, starts\n\n\ndef _sample_objects(grid_w: int, kinds: list[str], starts: list[int], heights: list[int]):\n    max_w = min(OBJECT_W_MAX, (grid_w - 1) // 2)\n\n    objects = []\n    for kind, r0, h in zip(kinds, starts, heights):\n        if kind == \"notch\":\n            widths = [w for w in range(OBJECT_W_MIN, max_w + 1) if w >= 3 or h >= 3]\n            w = random.choice(widths)\n            mask = _make_notch_mask(h, w)\n            color, edge_c = GREEN, grid_w - w\n        else:\n            w = random.randint(OBJECT_W_MIN, max_w)\n            mask = _make_closed_mask(h, w)\n            color, edge_c = RED, 0\n        if mask is None:\n            return None\n        objects.append((mask, r0, w, color, edge_c))\n    return objects\n\n\ndef _render_pair(objects, grid_w: int) -> tuple[np.ndarray, np.ndarray] | None:\n    inp = np.full((GRID_H, grid_w), BG, dtype=int)\n    out = np.full((GRID_H, grid_w), BG, dtype=int)\n    for mask, r0, w, color, edge_c in objects:\n        paste(out, _patch(mask, color), r0, edge_c, transparent=BG)\n\n    if sum(int(mask.sum()) for mask, *_ in objects) >= (GRID_H * grid_w) * MAX_FOREGROUND_FRACTION:\n        return None\n\n    for mask, r0, w, _color, _edge_c in objects:\n        c0 = random.randint(INTERIOR_COL_PAD, grid_w - w - INTERIOR_COL_PAD)\n        paste(inp, _patch(mask, BLUE), r0, c0, transparent=BG)\n    return inp, out\n\n\ndef _oracle_accepts(inp: np.ndarray, out: np.ndarray) -> bool:\n    try:\n        solved = main(inp)\n    except AssertionError:\n        return False\n    return bool(np.array_equal(solved, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    W, kinds, heights, starts = _sample_layout()\n    objects = _sample_objects(W, kinds, starts, heights)\n    if objects is None:\n        return None\n\n    rendered = _render_pair(objects, W)\n    if rendered is None:\n        return None\n\n    inp, out = rendered\n    return inp if _oracle_accepts(inp, out) else None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py | sed -n '1,300p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py | sed -n '1,300p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\n        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n    if len(seeds) < n_regions:\n        return None\n\n    frontier = []\n    for i, (r, c) in enumerate(list(seeds)):\n        region[r, c] = i\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, i))\n    random.shuffle(frontier)\n\n    while frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        r, c, rid = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if region[r, c] != -1:\n            continue\n        region[r, c] = rid\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, rid))\n\n    # Validate: each region must be 4-connected and have enough cells\n    for rid in range(n_regions):\n        mask = region == rid\n        if mask.sum() < MIN_REGION_CELLS:\n            return None\n        _, n = label_mask(mask, connectivity=4)\n        if n != 1:\n            return None\n    return region\n\n\n# ── Adjacency discovery ───────────────────────────────────────────────\n\ndef _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n    H, W = region.shape\n    # Detect boundaries via horizontal and vertical neighbor differences\n    undirected = set()\n    for r in range(H):\n        for c in range(W):\n            for dr, dc in _DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    a, b = int(region[r, c]), int(region[nr, nc])\n                    if a != b:\n                        undirected.add((min(a, b), max(a, b)))\n    directed = []\n    for a, b in undirected:\n        directed.append((a, b))\n        directed.append((b, a))\n    return directed\n\n\n# ── Marker count selection ─────────────────────────────────────────────\n\ndef _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:\n    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n    max_possible = min(MARKER_MAX, n_regions)\n    if max_possible < MARKER_MIN:\n        return None\n    n_markers = random.randint(MARKER_MIN, max_possible)\n    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))\n    n_normal = n_markers - n_colored\n    if n_normal > NORMAL_MAX:\n        n_colored = n_markers - NORMAL_MAX\n        n_normal = NORMAL_MAX\n        if n_colored > COLORED_MAX:\n            n_markers = NORMAL_MAX + COLORED_MAX\n            n_colored = COLORED_MAX\n            n_normal = NORMAL_MAX\n    return n_markers, n_normal, n_colored\n\n\n# ── Marker placement search ───────────────────────────────────────────\n\ndef _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):\n    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n    candidates = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            for stem in _DIRS:\n                bar = _get_bar(stem)\n                cells = _t_cells((r, c), stem)\n                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                    continue\n                if cells & occupied_cells:\n                    continue\n                if _t_neighborhood((r, c), stem) & occupied_cells:\n                    continue\n                if cells & occupied_neighbors:\n                    continue\n                # Diagonal cells (stem + each bar dir) must lie in source region\n                if not all(\n                    0 <= r + stem[0] + bd[0] < H and\n                    0 <= c + stem[1] + bd[1] < W and\n                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src\n                    for bd in bar\n                ):\n                    continue\n                # Walk along stem from step=2 until we hit dst or leave bounds\n                step = 2\n                found = False\n                while True:\n                    nr, nc = r + stem[0] * step, c + stem[1] * step\n                    if not (0 <= nr < H and 0 <= nc < W):\n                        break\n                    if (nr, nc) in occupied_cells or (nr, nc) in cells:\n                        step += 1\n                        continue\n                    found = int(region[nr, nc]) == dst\n                    break\n                if found:\n                    candidates.append(((r, c), stem))\n    return candidates\n\n\ndef _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):\n    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n    cells = _t_cells(center, stem)\n    if kind == 'normal':\n        occupied_cells |= cells\n        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)\n    else:\n        branch = _t_branch_cells(center, stem)\n        occupied_cells |= branch\n        occupied_cells.add(center)\n        # Each branch cell must remain a singleton: buffer all non-marker neighbors\n        for br, bc in branch:\n            for dr, dc in _DIRS:\n                nb = (br + dr, bc + dc)\n                if nb != center and nb not in branch:\n                    occupied_neighbors.add(nb)\n        for dr, dc in _DIRS:\n            nb = (center[0] + dr, center[1] + dc)\n            if nb not in branch:\n                occupied_neighbors.add(nb)\n\n\n# ── Grid construction ─────────────────────────────────────────────────\n\ndef _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:\n    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n    lut = np.array(colors, dtype=int)\n    return lut[region]\n\n\ndef _stamp_markers_input(grid, placed_markers):\n    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n    for kind, center, stem, _src, _dst, tc in placed_markers:\n        if kind == 'normal':\n            for cr, cc in _t_cells(center, stem):\n                grid[cr, cc] = 1\n        else:\n            grid[center[0], center[1]] = tc\n            for cr, cc in _t_branch_cells(center, stem):\n                grid[cr, cc] = 1\n\n\ndef _stamp_markers_output(grid, placed_markers, out_colors):\n    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n    for kind, center, stem, src, _dst, _tc in placed_markers:\n        color = out_colors[src]\n        for cr, cc in _t_cells(center, stem):\n            grid[cr, cc] = color\n\n\n# ── L9 rotation marker ────────────────────────────────────────────────\n\ndef _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):\n    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n    if random.random() >= L9_PROBABILITY:\n        return None\n    orient = random.choice(list(L9_OFFSETS))\n    offsets = L9_OFFSETS[orient]\n    H, W = region.shape\n\n    all_marker_cells = set()\n    for kind, center, stem, *_ in placed_markers:\n        all_marker_cells |= _t_cells(center, stem)\n\n    candidates = []\n    for r in range(H):\n        for c in range(W):\n            cells = [(r + dr, c + dc) for dr, dc in offsets]\n            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n","exit_code":0,"status":"completed"}}
