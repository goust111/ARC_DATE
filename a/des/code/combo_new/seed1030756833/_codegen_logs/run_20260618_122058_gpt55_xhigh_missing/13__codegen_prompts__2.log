{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, numpy as np, random\nDIRS=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef comps(cells):\n    cells=set(cells); out=[]\n    while cells:\n        s=cells.pop(); st=[s]; comp={s}\n        while st:\n            r,c=st.pop()\n            for dr,dc in DIRS:\n                nb=(r+dr,c+dc)\n                if nb in cells:\n                    cells.remove(nb); comp.add(nb); st.append(nb)\n        out.append(comp)\n    return out\n\ndef norm(cells):\n    r0=min(r for r,c in cells); c0=min(c for r,c in cells)\n    return frozenset((r-r0,c-c0) for r,c in cells)\n\ndef rot_norm(cells):\n    # rotate normalized mask 180 around its bbox\n    n=norm(cells)\n    h=max(r for r,c in n)+1; w=max(c for r,c in n)+1\n    return frozenset((h-1-r,w-1-c) for r,c in n)\n\ndef is_rect(cells):\n    r0=min(r for r,c in cells); r1=max(r for r,c in cells); c0=min(c for r,c in cells); c1=max(c for r,c in cells)\n    return len(cells)==(r1-r0+1)*(c1-c0+1), (r0,c0,r1,c1)\n\nfor H,W in [(4,4),(4,5),(5,5),(5,6),(6,6)]:\n  allcells=[(r,c) for r in range(H) for c in range(W)]\n  # sample connected A, B of equal area 2..6\n  masks=[]\n  for bits in itertools.combinations(allcells, 4): # area 4 first\n    if len(comps(bits))==1:\n      masks.append(set(bits))\n  random.shuffle(masks)\n  print('grid',H,W,'masks',len(masks))\n  for A in masks[:5000]:\n    if len(A)\"'!=4: continue\n    for B in masks[:5000]:\n      if A & B: continue\n      # separated as same color components no 4 adjacency\n      if any(abs(r-r2)+abs(c-c2)==1 for r,c in A for r2,c2 in B): continue\n      if norm(B)!=rot_norm(A): continue\n      r0=min([r for r,c in A|B]); r1=max([r for r,c in A|B]); c0=min([c for r,c in A|B]); c1=max([c for r,c in A|B])\n      TA={(r0+r1-r,c0+c1-c) for r,c in A}\n      if TA & B: continue\n      ok,bb=is_rect(TA|B)\n      if ok:\n        print('\"'FOUND',H,W,'A',sorted(A),'B',sorted(B),'TA',sorted(TA),'bb',bb)\n        # print grid: A=a B=b T=x\n        for r in range(H):\n          s=''\n          for c in range(W):\n            if (r,c) in A: s+='A'\n            elif (r,c) in B: s+='B'\n            elif (r,c) in TA: s+='x'\n            else: s+='.'\n          print(s)\n        raise SystemExit\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
