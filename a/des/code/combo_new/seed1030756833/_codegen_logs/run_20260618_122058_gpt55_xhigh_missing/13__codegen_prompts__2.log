{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/a09f6c25.py | sed -n '1,260p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor each non-singleton red object by its symmetry axis and erase isolated red pixels.\n\n    Input structure:\n    - The grid has one dominant background color and red 4-connected foreground objects.\n    - Every non-singleton red object has exactly one reflection symmetry category:\n      horizontal, vertical, or diagonal.\n    - Single red pixels are noise.\n\n    Rule:\n    - Start from an all-background output of the same shape.\n    - Recolor horizontally symmetric red objects blue, vertically symmetric objects\n      green, and diagonally symmetric objects pink.\n    - Leave isolated red pixels as background.\n\n    Key insight: The target color is not tied to object position or size; it is a\n    label for the object's reflection symmetry.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g)))\n    assert colors - {int(bg)} == {2}, \"expected red as the only foreground color\"\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[2])\n    assert objects, \"expected at least one red object\"\n    assert sum(int(obj[\"area\"]) for obj in objects) == int((g == 2).sum())\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        assert int(obj[\"color\"]) == 2\n        if int(obj[\"area\"]) == 1:\n            continue\n\n        color = _symmetry_color(_component_mask(coords, obj[\"bbox\"]))\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nGRID_ROWS = (17, 28)\nGRID_COLS = (19, 27)\nBACKGROUND_COLORS = [0, 4, 5, 7, 8, 9]\nFOREGROUND_COLOR = 2\nOUTPUT_COLOR_BY_KIND = {\"H\": 1, \"V\": 3, \"D\": 6}\n\n# Object count and size constraints.\nOBJECT_COUNT_RANGE = (3, 7)\nH_COUNT_OPTIONS = (2, 3)\nV_COUNT_OPTIONS = (1, 2)\nD_COUNT_OPTIONS = (0, 1, 2)\nAREA_MIN = 6\nAREA_MAX = 28\nAREA_MIN_NUM = 2\nAREA_MIN_DEN = 5\nAREA_MAX_PERCENT = 73\nAREA_PERCENT_DEN = 100\n\n# Symmetric mask dimensions and growth retries.\nHV_HEIGHT_RANGE = range(3, 11)\nHV_WIDTH_RANGE = range(3, 12)\nD_SIZE_RANGE = range(4, 9)\nMASK_RETRIES = 30\n\n# Placement, noise, and generator retries.\nMULTI_MIN_L1 = 4\nSINGLETON_COUNT_RANGE = (3, 9)\nSINGLETON_MIN_L1_TO_MULTI = 3\nSINGLETON_MIN_L1_TO_SINGLETON = 2\nGENERATION_RETRIES = 300\n\n\ndef _gen_area_bounds(h, w):\n    cells = h * w\n    lower = (AREA_MIN_NUM * cells + AREA_MIN_DEN - 1) // AREA_MIN_DEN\n    upper = (AREA_MAX_PERCENT * cells) // AREA_PERCENT_DEN\n    return max(AREA_MIN, lower), min(AREA_MAX, upper)\n\n\ndef _gen_orbit(kind, shape, r, c):\n    h, w = shape\n    if kind == \"H\":\n        cells = {(r, c), (h - 1 - r, c)}\n    elif kind == \"V\":\n        cells = {(r, c), (r, w - 1 - c)}\n    else:\n        cells = {(r, c), (c, r)}\n    return tuple(sorted(cells))\n\n\ndef _gen_symmetry_label(mask):\n    horizontal = bool(np.array_equal(mask, mask[::-1, :]))\n    vertical = bool(np.array_equal(mask, mask[:, ::-1]))\n    diagonal = bool(\n        mask.shape[0] == mask.shape[1]\n        and (np.array_equal(mask, mask.T) or np.array_equal(mask, np.fliplr(mask).T))\n    )\n    if sum((horizontal, vertical, diagonal)) != 1:\n        return None\n    if horizontal:\n        return \"H\"\n    if vertical:\n        return \"V\"\n    return \"D\"\n\n\ndef _gen_initial_mask(kind, h, w):\n    mask = np.zeros((h, w), dtype=bool)\n    forbidden = set()\n\n    if kind == \"H\":\n        axis_rows = [h // 2] if h % 2 else [h // 2 - 1, h // 2]\n        mask[axis_rows, :] = True\n        choices = [c for c in range(w) if c != w - 1 - c]\n        arm_col = random.choice(choices)\n        mask[:, arm_col] = True\n        mirror_col = w - 1 - arm_col\n        forbidden.update(_gen_orbit(\"H\", mask.shape, 0, mirror_col))\n    elif kind == \"V\":\n        axis_cols = [w // 2] if w % 2 else [w // 2 - 1, w // 2]\n        mask[:, axis_cols] = True\n        choices = [r for r in range(h) if r != h - 1 - r]\n        arm_row = random.choice(choices)\n        mask[arm_row, :] = True\n        mirror_row = h - 1 - arm_row\n        forbidden.update(_gen_orbit(\"V\", mask.shape, mirror_row, 0))\n    else:\n        for i in range(h):\n            mask[i, i] = True\n        for i in range(h - 1):\n            mask[i, i + 1] = True\n            mask[i + 1, i] = True\n\n    return mask, forbidden\n\n\ndef _gen_base_area(kind, h, w):\n    if kind == \"H\":\n        return (1 if h % 2 else 2) * w + h - (1 if h % 2 else 2)\n    if kind == \"V\":\n        return (1 if w % 2 else 2) * h + w - (1 if w % 2 else 2)\n    return 3 * h - 2\n\n\ndef _gen_dim_options(kind):\n    if kind == \"D\":\n        candidates = [(n, n) for n in D_SIZE_RANGE]\n    else:\n        candidates = [(h, w) for h in HV_HEIGHT_RANGE for w in HV_WIDTH_RANGE]\n\n    options = []\n    for h, w in candidates:\n        lower, upper = _gen_area_bounds(h, w)\n        if _gen_base_area(kind, h, w) <= upper and lower <= upper:\n            options.append((h, w))\n    return options\n\n\ndef _gen_frontier_orbits(mask, kind, forbidden, limit):\n    h, w = mask.shape\n    seen = set()\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            orbit = _gen_orbit(kind, mask.shape, r, c)\n            if orbit in seen or any(cell in forbidden for cell in orbit):\n                continue\n            seen.add(orbit)\n            new_cells = [cell for cell in orbit if not mask[cell]]\n            if not new_cells or len(new_cells) > limit:\n                continue\n            touches = False\n            for rr, cc in new_cells:\n                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:\n                        touches = True\n                        break\n                if touches:\n                    break\n            if touches:\n                choices.append(orbit)\n    return choices\n\n\ndef _gen_add_orbit(mask, orbit):\n    for r, c in orbit:\n        mask[r, c] = True\n\n\ndef _gen_grow_mask(mask, kind, lower, target, upper, forbidden):\n    while int(mask.sum()) < target:\n        area = int(mask.sum())\n        choices = _gen_frontier_orbits(mask, kind, forbidden, target - area)\n        if not choices:\n            break\n        _gen_add_orbit(mask, random.choice(choices))\n\n    while int(mask.sum()) < lower:\n        area = int(mask.sum())\n        choices = _gen_frontier_orbits(mask, kind, forbidden, upper - area)\n        if not choices:\n            return False\n        _gen_add_orbit(mask, random.choice(choices))\n\n    return lower <= int(mask.sum()) <= upper\n\n\ndef _gen_mask(kind):\n    options = _gen_dim_options(kind)\n    for _ in range(MASK_RETRIES):\n        h, w = random.choice(options)\n        mask, forbidden = _gen_initial_mask(kind, h, w)\n        lower, upper = _gen_area_bounds(h, w)\n        lower = max(lower, int(mask.sum()))\n        if lower > upper:\n            continue\n        target = random.randint(lower, upper)\n        if not _gen_grow_mask(mask, kind, lower, target, upper, forbidden):\n            continue\n        if _gen_symmetry_label(mask) == kind:\n            return mask\n    return None\n\n\ndef _gen_counts():\n    combos = [\n        (h, v, d)\n        for h in H_COUNT_OPTIONS\n        for v in V_COUNT_OPTIONS\n        for d in D_COUNT_OPTIONS\n        if OBJECT_COUNT_RANGE[0] <= h + v + d <= OBJECT_COUNT_RANGE[1]\n    ]\n    total = random.randint(*OBJECT_COUNT_RANGE)\n    return random.choice([combo for combo in combos if sum(combo) == total])\n\n\ndef _gen_min_l1(a, b):\n    if len(a) == 0 or len(b) == 0:\n        return 999\n    return int(np.abs(a[:, None, :] - b[None, :, :]).sum(axis=2).min())\n\n\ndef _gen_valid_positions(shape, mask, placed):\n    rows, cols = shape\n    h, w = mask.shape\n    local = np.argwhere(mask)\n    positions = []\n    for r0 in range(rows - h + 1):\n        for c0 in range(cols - w + 1):\n            coords = local + np.array([r0, c0])\n            if placed is not None and _gen_min_l1(coords, placed) < MULTI_MIN_L1:\n                continue\n            positions.append((r0, c0))\n    return positions\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py | sed -n '1,300p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py | sed -n '1,300p'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n    return blob\n\n\ndef _blob_wall_cells(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n    wall = set()\n    for r, c in blob:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in blob:\n                wall.add((nr, nc))\n    return wall\n\n\ndef _fill_holes(blob: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:\n    \"\"\"Return blob with interior holes absorbed.\n\n    Barrier = blob union its wall ring. Any non-barrier cell unreachable from the grid\n    border through non-barrier cells is trapped and gets absorbed into the blob.\n    \"\"\"\n    walls = _blob_wall_cells(blob, h, w)\n    barrier = np.zeros((h, w), dtype=bool)\n    for r, c in blob:\n        barrier[r, c] = True\n    for r, c in walls:\n        barrier[r, c] = True\n\n    # Flood-fill from border through non-barrier cells.\n    reachable = np.zeros((h, w), dtype=bool)\n    stack = []\n    for r in range(h):\n        for c in (0, w - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if not barrier[r, c]:\n                stack.append((r, c))\n    while stack:\n        r, c = stack.pop()\n        if reachable[r, c] or barrier[r, c]:\n            continue\n        reachable[r, c] = True\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reachable[nr, nc] and not barrier[nr, nc]:\n                stack.append((nr, nc))\n\n    trapped = (~reachable) & (~barrier)\n    if not trapped.any():\n        return blob\n    filled = set(blob)\n    for r, c in np.argwhere(trapped):\n        filled.add((int(r), int(c)))\n    return filled\n\n\n# ── Slide helpers ─────────────────────────────────────────────────\n\ndef _slide_step_valid(region_set: set, r: int, c: int, dr: int, dc: int) -> bool:\n    nr, nc = r + dr, c + dc\n    if (nr, nc) not in region_set:\n        return False\n    if dr != 0 and dc != 0:\n        if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n            return False\n    return True\n\n\ndef _forward_slide(region_set: set, start: tuple[int, int], dr: int, dc: int,\n                   blocked: set) -> tuple[int, int]:\n    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n    r, c = start\n    while True:\n        if not _slide_step_valid(region_set, r, c, dr, dc):\n            break\n        nr, nc = r + dr, c + dc\n        if (nr, nc) in blocked:\n            break\n        r, c = nr, nc\n    return (r, c)\n\n\n# ── Generator phases ─────────────────────────────────────────────\n\ndef _place_legends(rng: random.Random, grid: np.ndarray,\n                   ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:\n    \"\"\"Place 1-2 legend patches at grid corners.\n\n    Returns (legend_occupied mask, list of (wall_color, direction) pairs).\n    \"\"\"\n    h, w = grid.shape\n    n_legends = rng.choice([1, 2])\n    corners = rng.sample(CORNERS, n_legends)\n    wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)\n\n    legend_occupied = np.zeros((h, w), dtype=bool)\n    legends = []\n\n    for corner, wc in zip(corners, wall_colors):\n        if rng.random() < CARDINAL_PROB:\n            dr, dc = rng.choice(CARDINAL_DIRS)\n            patch = _legend_5x5(wc, dr, dc)\n        else:\n            dr, dc = rng.choice(DIAGONAL_DIRS)\n            patch = _legend_6x7(wc, dr, dc)\n        ph, pw = patch.shape\n        r0, c0 = _corner_origin(corner, h, w, ph, pw)\n        paste(grid, patch, r0, c0)\n        # Reserve legend cells + buffer.\n        r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)\n        c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)\n        legend_occupied[r_lo:r_hi, c_lo:c_hi] = True\n        legends.append((wc, (dr, dc)))\n\n    return legend_occupied, legends\n\n\ndef _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],\n                  legend_occupied: np.ndarray,\n                  ) -> list[dict] | None:\n    \"\"\"Grow irregular closed regions, one per assigned wall color.\n\n    Returns list of region dicts or None on failure.\n    \"\"\"\n    h, w = legend_occupied.shape\n    color_dir = {wc: d for wc, d in legends}\n    all_colors = [wc for wc, _ in legends]\n\n    # Assign 1-3 regions per wall color, cap total.\n    region_colors = []\n    for c in all_colors:\n        region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))\n    if len(region_colors) > MAX_TOTAL_REGIONS:\n        region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)\n    rng.shuffle(region_colors)\n\n    size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]\n    occupied = legend_occupied.copy()\n    regions = []\n\n    for rc in region_colors:\n","exit_code":0,"status":"completed"}}
