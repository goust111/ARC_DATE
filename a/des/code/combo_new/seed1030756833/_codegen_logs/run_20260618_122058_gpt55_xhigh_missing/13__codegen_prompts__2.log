{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, sys\nDIRS=[(1,0),(-1,0),(0,1),(0,-1)]\n\ndef comp_count(cells):\n    cells=set(cells); n=0\n    while cells:\n        n+=1; s=cells.pop(); st=[s]\n        while st:\n            r,c=st.pop()\n            for dr,dc in DIRS:\n                nb=(r+dr,c+dc)\n                if nb in cells:\n                    cells.remove(nb); st.append(nb)\n    return n\n\ndef norm(cells):\n    r0=min(r for r,c in cells); c0=min(c for r,c in cells)\n    return frozenset((r-r0,c-c0) for r,c in cells)\n\ndef rot_norm(cells):\n    n=norm(cells); h=max(r for r,c in n)+1; w=max(c for r,c in n)+1\n    return frozenset((h-1-r,w-1-c) for r,c in n)\n\ndef bbox(cells):\n    return min(r for r,c in cells),min(c for r,c in cells),max(r for r,c in cells),max(c for r,c in cells)\n\ndef adj(A,B):\n    return any(abs(r-r2)+abs(c-c2)==1 for r,c in A for r2,c2 in B)\n\nfor UH,UW in [(5,6),(6,6),(6,7),(7,7),(7,8),(8,8),(8,9)]:\n  Ucells={(r,c) for r in range(UH) for c in range(UW)}\n  for rh in range(2, min(6,UH)+1):\n    for rw in range(2, min(6,UW)+1):\n      area=rh*rw\n      if area%2: continue\n      # rectangle final F inside U\n      for fr in range(UH-rh+1):\n        for fc in range(UW-rw+1):\n          R={(r,c) for r in range(fr,fr+rh) for c in range(fc,fc+rw)}\n          cells=list(R)\n          # enumerate splits for area up to maybe 12 cells\n          if area>16: continue\n          for comb in itertools.combinations(cells, area//2):\n            S=set(comb); B=R-S\n            if comp_count(S)\"'!=1 or comp_count(B)!=1: continue\n            # B and S should be no-overlap and combine rect; same shape via 180\n            if norm(B)!=rot_norm(S): continue\n            # original A is S reflected over U bbox (0..UH-1,0..UW-1)\n            A={(UH-1-r, UW-1-c) for r,c in S}\n            if A & B: continue\n            if adj(A,B): continue\n            if comp_count(A)!=1: continue\n            # union bbox of original A and B must equal U, otherwise T center differs\n            if bbox(A|B)!=(0,0,UH-1,UW-1): continue\n            # Input shapes A and B are 180 relationship?\n            if norm(B)!=rot_norm(A): continue\n            print('\"'FOUND U',UH,UW,'R',fr,fc,rh,rw)\n            for r in range(UH):\n              s=''\n              for c in range(UW):\n                p=(r,c)\n                if p in A: s+='A'\n                elif p in B: s+='B'\n                elif p in S: s+='x'\n                else: s+='.'\n              print(s)\n            sys.exit()\n  print('tried U',UH,UW)\nprint('none')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
