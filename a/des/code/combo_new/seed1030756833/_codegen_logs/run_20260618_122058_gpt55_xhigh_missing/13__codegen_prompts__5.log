code/eval/9385bd28.py:55:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:58:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:70:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:71:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:74:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:79:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:86:    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:87:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:202:    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:215:    \"\"\"True if (h, w) avoids an L-anchor score tie.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:218:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:229:    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:256:    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:259:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:276:    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:309:    \"\"\"Build the forbidden-placement mask that protects legend scan integrity.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:313:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:401:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:172:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:173:    \"\"\"Predict the next panel in a framed sequence by continuing e