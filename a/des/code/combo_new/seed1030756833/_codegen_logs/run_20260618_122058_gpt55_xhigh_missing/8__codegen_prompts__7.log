{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/cbebaa4b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw sprites around a central yellow anchor by pairing red connector pixels.\n\n    Input structure:\n    - bg = black (0). Several colored sprites scattered on the grid.\n    - One anchor sprite contains a 3×3 yellow (4) block.\n    - Each sprite has red (2) connector pixels along its edges.\n\n    Rule:\n    - The anchor stays in place; remaining sprites attach one at a time.\n    - Each sprite is translated so that one of its red pixels overlaps an unpaired red pixel on the growing assembly.\n    - Every red connector must pair with exactly one other, forming a complete joined structure.\n\n    Key insight: Red pixels act as jigsaw pegs — each must match exactly one counterpart, and the assembly order is determined by which unpaired connectors remain.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = 0\n\n    pieces = _extract_pieces(g, bg)\n    assert pieces, \"input must have at least one colored piece\"\n\n    # Anchor is the unique piece containing the 3x3 yellow (color 4) block.\n    anchors = [p for p in pieces if np.any(p[\"arr\"] == 4)]\n    assert len(anchors) == 1, \"input must have exactly one yellow (4) anchor piece\"\n    anchor = anchors[0]\n    rest = [p for p in pieces if p is not anchor]\n\n    canvas = np.full((h, w), bg, dtype=int)\n    ar0, ac0, _, _ = anchor[\"bbox\"]\n    placed = _try_place(canvas, anchor[\"arr\"], ar0, ac0, bg)\n    assert placed is not None, \"anchor piece must fit on canvas at its original position\"\n\n    total_ports = int(sum(len(p[\"reds\"]) for p in pieces))\n    assert total_ports % 2 == 0, \"total red connector ports must be even for complete pairing\"\n    target_unique_red = total_ports // 2\n\n    # Track how many original red pixels map to each assembled red coordinate.\n    red_counts: dict[tuple[int, int], int] = {}\n    for rr, cc in anchor[\"reds\"]:\n        red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1\n\n    # Backtracking assembly by pairing up red connector pixels.\n    solutions: list[np.ndarray] = []\n\n    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:\n        if len(solutions) >= 2:\n            return\n\n        if not remaining:\n            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):\n                solutions.append(cur)\n            return\n\n        if len(rc) > target_unique_red:\n            return\n\n        # Unpaired reds are exactly those with count==1; always pair one of them next.\n        unpaired = [k for k, v in rc.items() if v == 1]\n        if not unpaired:\n            return\n\n        rc1 = {k for k, v in rc.items() if v == 1}\n\n        # Pick the most constrained unpaired red coordinate: fewest ways to cover it.\n        best_moves = None\n        for t in unpaired:\n            moves = []\n            tr, tc = t\n            for idx, p in enumerate(remaining):\n                ph, pw = p[\"shape\"]\n                for pr, pc in p[\"reds\"]:\n                    top = tr - pr\n                    left = tc - pc\n                    if top < 0 or left < 0 or top + ph > h or left + pw > w:\n                        continue\n                    # quick red-count feasibility\n                    bad = False\n                    overlap = 0\n                    for rr, cc in p[\"reds\"]:\n                        gr, gc = top + rr, left + cc\n                        prev = rc.get((gr, gc), 0)\n                        if prev >= 2:\n                            bad = True\n                            break\n                        if (gr, gc) in rc1:\n                            overlap += 1\n                    if bad:\n                        continue\n                    # must overlap at least the target (guaranteed), but keep for scoring\n                    moves.append((idx, top, left, overlap))\n            if not moves:\n                return\n            if best_moves is None or len(moves) < len(best_moves):\n                best_moves = moves\n                if len(best_moves) == 1:\n                    break\n\n        assert best_moves is not None, \"there must be at least one feasible connector move\"\n\n        # Deduplicate moves by (piece, top, left) keeping max overlap score.\n        dedup: dict[tuple[int, int, int], int] = {}\n        for idx, top, left, ov in best_moves:\n            k = (idx, top, left)\n            dedup[k] = max(dedup.get(k, 0), ov)\n        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]\n        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]][\"area\"], x[1], x[2], x[0]))\n\n        for idx, top, left, _ov in moves2:\n            p = remaining[idx]\n            next_remaining = remaining[:idx] + remaining[idx + 1 :]\n\n            next_rc = dict(rc)\n            for rr, cc in p[\"reds\"]:\n                gr, gc = top + rr, left + cc\n                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1\n\n            nxt = _try_place(cur, p[\"arr\"], top, left, bg)\n            if nxt is None:\n                continue\n            dfs(nxt, next_remaining, next_rc)\n            if len(solutions) >= 2:\n                return\n\n    dfs(placed, rest, red_counts)\n    assert len(solutions) == 1, \"jigsaw assembly must have exactly one valid solution\"\n    return solutions[0]\n\n# --------------- generator (o5x) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────────\n# Canvas\nGRID_H_RANGE = (22, 26)               # output grid height bounds\nGRID_W_RANGE = (22, 26)               # output grid width bounds\nMAX_ASSEMBLY_DIM = 24                  # assembled jigsaw must fit inside this\n\n# Pieces\nPIECE_COUNT_RANGE = (4, 6)            # non-anchor sprite count\nPIECE_H_RANGE = (4, 7)               # piece bbox height bounds\nPIECE_W_RANGE = (4, 8)               # piece bbox width bounds\nPIECE_DIM_CANDIDATES = 12            # random (h,w) trials per piece placement\nPIECE_COLORS = [1, 3, 5, 6, 7, 8, 9] # available non-red, non-yellow colors\nPIECE_CAP = 2                         # max connections per piece node\nBAR_SKIP_PROB = 0.35                  # probability of dropping one decorative bar\n\n# Anchor\nANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]  # yellow block (h, w) options\nANCHOR_CAP_CHOICES = [1, 2]              # max connections for anchor node\n\n# Scatter\nSCATTER_PADDING = 2                   # Chebyshev gap between scattered sprites\n\n# Generation\nGEN_RETRY_LIMIT = 300                 # max attempts before raising RuntimeError\n\n# ── Side geometry lookups ──────────────────────────────────────────────\nSIDES = (\"top\", \"right\", \"bottom\", \"left\")\nOPPOSITE = {\"top\": \"bottom\", \"bottom\": \"top\", \"left\": \"right\", \"right\": \"left\"}\nINWARD = {\"top\": (1, 0), \"bottom\": (-1, 0), \"left\": (0, 1), \"right\": (0, -1)}\n\n\ndef _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP):\n    return {\n        \"kind\": kind, \"shape\": (int(h), int(w)), \"color\": int(color),\n        \"top\": int(top), \"left\": int(left), \"cap\": int(cap),\n        \"sides\": set(), \"ports\": {},\n    }\n\n\ndef _ensure_port(node, side):\n    \"\"\"Lazily assign a random port offset for *side* if not already set.\"\"\"\n    if side in node[\"ports\"]:\n        return\n    h, w = node[\"shape\"]\n    span = h if side in (\"left\", \"right\") else w\n    node[\"ports\"][side] = random.randint(1, span - 3)\n\n\ndef _port_cells(node, side):\n    \"\"\"Return the two local (r, c) cells that form the red connector on *side*.\"\"\"\n    h, w = node[\"shape\"]\n    k = node[\"ports\"][side]\n    if side == \"top\":\n        return [(0, k), (0, k + 1)]\n    if side == \"bottom\":\n        return [(h - 1, k), (h - 1, k + 1)]\n    if side == \"left\":\n        return [(k, 0), (k + 1, 0)]\n    return [(k, w - 1), (k + 1, w - 1)]\n\n\ndef _global_port(node, side):\n    tr, tc = node[\"top\"], node[\"left\"]\n    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]\n\n\ndef _bbox_of(node):\n    h, w = node[\"shape\"]\n    return (node[\"top\"], node[\"left\"], node[\"top\"] + h - 1, node[\"left\"] + w - 1)\n\n\ndef _rects_overlap(a, b):\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _union_bbox(nodes):\n    boxes = [_bbox_of(n) for n in nodes]\n    return (\n        min(b[0] for b in boxes), min(b[1] for b in boxes),\n        max(b[2] for b in boxes), max(b[3] for b in boxes),\n    )\n\n\ndef _draw_path(arr, start, end, color, order):\n    \"\"\"Draw an L-shaped path from *start* to *end*, preserving red (2) pixels.\"\"\"\n    r, c = start\n    er, ec = end\n    # order 0: row-first then col; order 1: col-first then row\n    axes = [(r, er, c, True), (c, ec, er, False)] if order == 0 else \\\n           [(c, ec, r, False), (r, er, ec, True)]\n    for a_start, a_end, fixed, is_row in axes:\n        step = 1 if a_end >= a_start else -1\n        for v in range(a_start, a_end + step, step):\n            rr, cc = (v, fixed) if is_row else (fixed, v)\n            if arr[rr, cc] != 2:\n                arr[rr, cc] = color\n\n\ndef _paint_bar(arr, side, color, used):\n    \"\"\"Paint a decorative bar along *side*, skipping corners claimed by *used* sides.\"\"\"\n    h, w = arr.shape\n    is_horizontal = side in (\"top\", \"bottom\")\n    fixed = 0 if side in (\"top\", \"left\") else (h - 1 if side == \"bottom\" else w - 1)\n    span = w if is_horizontal else h\n    # corner neighbors: (index, conflicting side) pairs\n    lo_conflict = \"left\" if is_horizontal else \"top\"\n    hi_conflict = \"right\" if is_horizontal else \"bottom\"\n    for i in range(span):\n        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):\n            continue\n        if is_horizontal:\n            arr[fixed, i] = color\n        else:\n            arr[i, fixed] = color\n\n\ndef _bar_endpoint(shape, side, hub):\n    h, w = shape\n    hr, hc = hub\n    if side in (\"top\", \"bottom\"):\n        row = 0 if side == \"top\" else h - 1\n        return (row, min(max(hc, 1), w - 2))\n    col = 0 if side == \"left\" else w - 1\n    return (min(max(hr, 1), h - 2), col)\n\n\ndef _make_piece(node):\n    \"\"\"Render a piece sprite array with red connectors and decorative bars.\"\"\"\n    h, w = node[\"shape\"]\n    color = node[\"color\"]\n    used = set(node[\"sides\"])\n    arr = np.zeros((h, w), dtype=int)\n    hub = (random.randint(1, h - 2), random.randint(1, w - 2))\n\n    bar_sides = [s for s in SIDES if s not in used]\n    if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:\n        bar_sides.remove(random.choice(bar_sides))\n    for side in bar_sides:\n        _paint_bar(arr, side, color, used)\n\n    terminals = []\n    for side in used:\n        dr, dc = INWARD[side]\n        for r, c in _port_cells(node, side):\n            arr[r, c] = 2\n            rr, cc = r + dr, c + dc\n            arr[rr, cc] = color\n            terminals.append((rr, cc))\n\n    arr[hub] = color\n    order = random.randint(0, 1)\n    for t in terminals:\n        _draw_path(arr, t, hub, color, order)\n    for side in bar_sides:\n        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)\n\n    if len(components_mask(arr != 0, connectivity=4)) != 1:\n        return None\n    if int(np.sum(arr == 2)) != 2 * len(used):\n        return None\n    return arr\n\n\ndef _make_anchor(node):\n    bh, bw = node[\"block\"]\n    h, w = node[\"shape\"]\n    arr = np.zeros((h, w), dtype=int)\n    arr[1 : 1 + bh, 1 : 1 + bw] = 4\n    for side in node[\"sides\"]:\n        for r, c in _port_cells(node, side):\n            arr[r, c] = 2\n    return arr\n\n\ndef _candidate_fits(nodes, parent_i, child):\n    \"\"\"Check child overlaps only its parent and total assembly stays within bounds.\"\"\"\n    cb = _bbox_of(child)\n    if not _rects_overlap(cb, _bbox_of(nodes[parent_i])):\n        return False\n    for i, other in enumerate(nodes):\n        if i == parent_i:\n            continue\n        if _rects_overlap(cb, _bbox_of(other)):\n            return False\n    r0, c0, r1, c1 = _union_bbox(nodes + [child])\n    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM\n\n\ndef _grow_tree():\n    \"\"\"Build a tree of connected nodes (1 anchor + N pieces) in local coordinates.\"\"\"\n    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)\n    anchor = _new_node(\"anchor\", bh + 2, bw + 2, 4, cap=random.choice(ANCHOR_CAP_CHOICES))\n    anchor[\"block\"] = (bh, bw)\n    nodes = [anchor]\n    n_pieces = random.randint(*PIECE_COUNT_RANGE)\n    colors = random.sample(PIECE_COLORS, n_pieces)\n\n    for i in range(n_pieces):\n        placed = False\n        dims = [(random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))\n                for _ in range(PIECE_DIM_CANDIDATES)]\n        random.shuffle(dims)\n        for ph, pw in dims:\n            parents = [j for j, n in enumerate(nodes) if len(n[\"sides\"]) < n[\"cap\"]]\n            random.shuffle(parents)\n            for parent_i in parents:\n                parent = nodes[parent_i]\n                sides = [s for s in SIDES if s not in parent[\"sides\"]]\n                random.shuffle(sides)\n                for side in sides:\n                    child = _new_node(\"piece\", ph, pw, colors[i])\n                    incoming = OPPOSITE[side]\n                    _ensure_port(parent, side)\n                    _ensure_port(child, incoming)\n                    pr, pc = _global_port(parent, side)[0]\n                    cr, cc = _port_cells(child, incoming)[0]\n                    child[\"top\"] = pr - cr\n                    child[\"left\"] = pc - cc\n                    child[\"sides\"].add(incoming)\n                    if not _candidate_fits(nodes, parent_i, child):\n                        continue\n                    parent[\"sides\"].add(side)\n                    nodes.append(child)\n                    placed = True\n                    break\n                if placed:\n                    break\n            if placed:\n                break\n        if not placed:\n            return None\n    return nodes\n\n\ndef _place_node_on_canvas(out, node, sr, sc):\n    \"\"\"Stamp a single node's sprite onto *out*, tracking red overlaps.\n\n    Returns red_counts dict on success, or None on conflict.\n    \"\"\"\n    arr = node[\"arr\"]\n    top, left = node[\"top\"] + sr, node[\"left\"] + sc\n    node[\"pos\"] = (top, left)\n    red_counts = {}\n    mask = arr != 0\n    rows, cols = np.nonzero(mask)\n    g_rows, g_cols = rows + top, cols + left\n    vals = arr[rows, cols]\n    cur_vals = out[g_rows, g_cols]\n    # Conflict: non-bg destination that isn't a red-on-red overlap\n    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))\n    if np.any(conflicts):\n        return None\n    # Track red overlap counts\n    red_mask = vals == 2\n    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):\n        key = (int(gr), int(gc))\n        red_counts[key] = red_counts.get(key, 0) + 1\n    # Paint non-overlapping pixels\n    paint_mask = cur_vals == 0\n    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]\n    return red_counts\n\n\ndef _assemble(nodes, h, w):\n    \"\"\"Render all nodes, shift into grid, and validate the assembled output.\"\"\"\n    for node in nodes:\n        node[\"arr\"] = _make_anchor(node) if node[\"kind\"] == \"anchor\" else _make_piece(node)\n        if node[\"arr\"] is None:\n            return None\n\n    r0, c0, r1, c1 = _union_bbox(nodes)\n    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:\n        return None\n    sr = random.randint(-r0, h - 1 - r1)\n    sc = random.randint(-c0, w - 1 - c1)\n\n    out = np.zeros((h, w), dtype=int)\n    all_red_counts = {}\n    for node in nodes:\n        rc = _place_node_on_canvas(out, node, sr, sc)\n        if rc is None:\n            return None\n        for k, v in rc.items():\n            all_red_counts[k] = all_red_counts.get(k, 0) + v\n\n    total_ports = sum(int(np.sum(n[\"arr\"] == 2)) for n in nodes)\n    if len(all_red_counts) * 2 != total_ports:\n        return None\n    if any(v != 2 for v in all_red_counts.values()):\n        return None\n    if len(components_mask(out != 0, connectivity=4)) != 1:\n        return None\n    return out\n\n\ndef _scatter(nodes, h, w):\n    \"\"\"Place anchor at its assembled position, then scatter remaining pieces.\"\"\"\n    inp = np.zeros((h, w), dtype=int)\n    anchor = nodes[0]\n    paste(inp, anchor[\"arr\"], *anchor[\"pos\"], transparent=0)\n    rest = nodes[1:]\n    random.shuffle(rest)\n    for node in rest:\n        try:\n            r, c = random_free_location(\n                inp, node[\"arr\"], transparent=0,\n                padding=SCATTER_PADDING, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(inp, node[\"arr\"], r, c, transparent=0)\n    return inp\n\n\ndef _gen_attempt():\n    h = random.randint(*GRID_H_RANGE)\n    w = random.randint(*GRID_W_RANGE)\n    nodes = _grow_tree()\n    if nodes is None:\n        return None\n    out = _assemble(nodes, h, w)\n    if out is None:\n        return None\n    inp = _scatter(nodes, h, w)\n    if inp is None:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if np.array_equal(solved, out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid cbebaa4b input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n                # Orientation must be perpendicular to the edge it touches.\n                rs = [r for r, _ in comp]\n                cs = [c for _, c in comp]\n                vertical = len(set(cs)) == 1\n                border_ep = e0 if touch0 else e1\n                if vertical:\n                    if border_ep[0] not in (0, h - 1):\n                        continue\n                else:\n                    if border_ep[1] not in (0, w - 1):\n                        continue\n                terminal_ep = e1 if touch0 else e0\n                # Must have an attached non-bg neighbor at terminal.\n                tr, tc = terminal_ep\n                if not any(\n                    0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n                    for nr, nc in neighbors4(tr, tc)\n                ):\n                    continue\n                yield col, comp, terminal_ep\n\n    # Process all valid bars; compute moves based on the original grid.\n    moves = []  # list of (seg_comp_pts, seg_color, new_pts)\n    for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n        # Segment neighbor candidates at terminal.\n        neigh = []\n        for nr, nc in neighbors4(terminal[0], terminal[1]):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg and v != bar_col:\n                    neigh.append((v, (nr, nc)))\n        assert neigh, f\"bar terminal {terminal} must have a non-bg/non-bar neighbor\"\n\n        # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.\n        best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)\n        for cand_col, cand_start in neigh:\n            for comp in _components(g, cand_col, conn8=True):\n                if cand_start in comp:\n                    if len(comp) < 2:\n                        break\n                    deg = _segment_degrees(comp)\n                    if deg.get(cand_start, 0) != 1:\n                        break\n                    path = _segment_main_path(comp, cand_start)\n                    L = len(path)\n                    key = (L, len(comp), cand_col, cand_start[0], cand_start[1])\n                    if best_seg is None or key > best_seg[0]:\n                        best_seg = (key, cand_col, cand_start, comp)\n                    break\n        assert best_seg is not None, f\"no valid segment for bar at {terminal}\"\n        (L, _, _, _, _), seg_col, seg_start, seg_comp = best_seg\n\n        # Nearest obstacle component (any other non-bg color) to the terminal.\n        obstacle_candidates = [c for c in colors if c not in (bar_col, seg_col)]\n        assert obstacle_candidates, \"must have at least one obstacle color distinct from bar and segment\"\n\n        best = None  # (dist, min_r, min_c)\n        obstacle_set = None\n        for col in obstacle_candidates:\n            for comp in _components(g, col, conn8=True):\n                d = min(abs(r - terminal[0]) + abs(c - terminal[1]) for r, c in comp)\n                mr = min(r for r, _ in comp)\n                mc = min(c for _, c in comp)\n                key = (d, mr, mc)\n                if best is None or key < best:\n                    best = key\n                    obstacle_set = set(comp)\n        assert obstacle_set is not None, \"must find at least one obstacle component\"\n\n        off_r = seg_start[0] - terminal[0]\n        off_c = seg_start[1] - terminal[1]\n\n        # Path from terminal to obstacle (prefer monotone manhattan decrease).\n        walkable = (g == bg) | (g == seg_col)\n        walkable[terminal] = True\n        # Choose an obstacle pixel so that the translated endpoint (p_near + offset) lies OUTSIDE the obstacle,\n        # i.e. the segment connects to the obstacle \"skin\" rather than landing inside the obstacle and wasting length.\n        def pick_p_near() -> tuple[int, int]:\n            good = []\n            for pr, pc in obstacle_set:\n                er, ec = pr + off_r, pc + off_c\n                if not (0 <= er < h and 0 <= ec < w):\n                    continue\n                if (er, ec) in obstacle_set:\n                    continue\n                if int(g[er, ec]) not in (bg, seg_col):\n                    continue\n                d = abs(pr - terminal[0]) + abs(pc - terminal[1])\n                good.append((d, pr, pc))\n            assert good, \"no obstacle pixel has a valid translated endpoint outside obstacle\"\n            _, pr, pc = min(good)\n            return (pr, pc)\n\n        p_near = pick_p_near()\n        walkable[p_near] = True\n        path_t_to_obs = _greedy_manhattan_path(terminal, p_near, walkable) or _bfs_path(terminal, p_near, walkable)\n        assert path_t_to_obs is not None, f\"no path from terminal {terminal} to obstacle {p_near}\"\n        shifted = [(r + off_r, c + off_c) for r, c in path_t_to_obs]\n        assert all(0 <= r < h and 0 <= c < w for r, c in shifted), \\\n            \"shifted segment path must stay within grid\"\n        assert shifted and shifted[0] == seg_start, \\\n            \"shifted path must start at seg_start\"\n        entry = shifted[-1]\n\n        # Obstacle-adjacent skin.\n        skin = set()\n        for r, c in obstacle_set:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in obstacle_set:\n                    skin.add((nr, nc))\n\n        # Pick exit as the farthest walkable skin cell from the terminal (ties resolved by projecting away).\n        # Use obstacle centroid direction as an 'away' vector.\n        cr = sum(r for r, _ in obstacle_set) / len(obstacle_set)\n        cc = sum(c for _, c in obstacle_set) / len(obstacle_set)\n        away = (cr - terminal[0], cc - terminal[1])\n\n        def skin_ok(p):\n            r, c = p\n            return int(g[r, c]) == bg or int(g[r, c]) == seg_col\n\n        skin_candidates = [p for p in skin if skin_ok(p)] + [entry]\n        def exit_key(p):\n            r, c = p\n            md = abs(r - terminal[0]) + abs(c - terminal[1])\n            dot = (r - terminal[0]) * away[0] + (c - terminal[1]) * away[1]\n            return (md, dot, -r, -c)\n\n        exit_cell = max(skin_candidates, key=exit_key)\n\n        # BFS along skin (8-neigh) from entry to exit.\n        skin_walkable = np.zeros((h, w), dtype=bool)\n        for r, c in skin:\n            if skin_ok((r, c)):\n                skin_walkable[r, c] = True\n        skin_walkable[entry] = True\n        skin_walkable[exit_cell] = True\n        boundary_path = _bfs_path_with_diag_filter(entry, exit_cell, skin_walkable) or [entry]\n\n        # Extension direction is the last step used to reach the exit on the skin path.\n        assert len(boundary_path) >= 2, \"boundary path must have at least 2 cells to derive extension direction\"\n        dr_ext = boundary_path[-1][0] - boundary_path[-2][0]\n        dc_ext = boundary_path[-1][1] - boundary_path[-2][1]\n\n        route = list(shifted)\n        if boundary_path and boundary_path[0] == entry:\n            route.extend(boundary_path[1:])\n\n        cur = route[-1]\n        while len(route) < L:\n            nr, nc = cur[0] + dr_ext, cur[1] + dc_ext\n            if not (0 <= nr < h and 0 <= nc < w):\n                break\n            if int(g[nr, nc]) != bg and int(g[nr, nc]) != seg_col:\n                break\n            route.append((nr, nc))\n            cur = (nr, nc)\n\n        new_pts = route[:L]\n\n        # Assert: output segment must not overlap obstacle\n        assert not any(p in obstacle_set for p in new_pts), \"output segment passes through obstacle\"\n\n        # Assert: output segment has monotone wrapping shape (FL*F*FR* or FR*F*FL*)\n        rs_bar = [r for r, _ in bar_comp]\n        cs_bar = [c for _, c in bar_comp]\n        if len(set(cs_bar)) == 1:\n            fwd = (1, 0) if min(rs_bar) == 0 else (-1, 0)\n        else:\n            fwd = (0, 1) if min(cs_bar) == 0 else (0, -1)\n        step_classes = []\n        for j in range(len(new_pts) - 1):\n            dr = new_pts[j + 1][0] - new_pts[j][0]\n            dc = new_pts[j + 1][1] - new_pts[j][1]\n            fwd_comp = dr * fwd[0] + dc * fwd[1]\n            perp_comp = dr * fwd[1] + dc * (-fwd[0])\n            if abs(dr) + abs(dc) == 1:\n                step_classes.append('F' if fwd_comp > 0 else 'X')\n            elif fwd_comp > 0 and perp_comp > 0:\n                step_classes.append('FR')\n            elif fwd_comp > 0 and perp_comp < 0:\n                step_classes.append('FL')\n            else:\n                step_classes.append('X')\n        s = ''.join(step_classes)\n        import re\n        assert re.fullmatch(r'(FL)*(F)*(FR)*', s) or re.fullmatch(r'(FR)*(F)*(FL)*', s), \\\n            f\"output segment not monotone wrap: {' '.join(step_classes)}\"\n\n        # Assert: when approach diagonal exists (p1>=1), obstacle must be 4-adj to V apex inner side\n        first_step = step_classes[0] if step_classes else ''\n        if first_step in ('FL', 'FR'):\n            p1_end = 0\n            for j2, sc in enumerate(step_classes):\n                if sc == first_step:\n                    p1_end = j2 + 1\n                else:\n                    break\n            apex = new_pts[p1_end]\n            perp_dir = (seg_start[0] - terminal[0], seg_start[1] - terminal[1])\n            inner = (-perp_dir[0], -perp_dir[1])\n            apex_inner = (apex[0] + inner[0], apex[1] + inner[1])\n            assert apex_inner in obstacle_set, \\\n                f\"obstacle not tight at V apex: apex={apex}, inner={apex_inner}\"\n\n        moves.append((seg_comp, seg_col, new_pts))\n\n    # Clear segments first, then repaint.\n    for seg_comp, seg_col, _ in moves:\n        for r, c in seg_comp:\n            out[r, c] = bg\n\n    for _, seg_col, new_pts in moves:\n        for r, c in new_pts:\n            if int(out[r, c]) == bg:\n                out[r, c] = seg_col\n    return out\n\n# --------------- generator (attempt_2) ---------------\n\nfrom arc_utils import paint_coords\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\nGRID_SIZE_MIN, GRID_SIZE_MAX = 7, 27       # square grid side length\nBAR_LEN_MIN, BAR_LEN_MAX = 3, 7           # bar length (px)\nBAR_CLEARANCE = 4                           # n must exceed bar_len by this much\nSEG_LEN_MIN, SEG_LEN_MAX = 5, 9           # segment pixel count\nPHASE_MAX = 3                               # max length for p1 and p2 individually\nOBS_SIZE_MIN, OBS_SIZE_MAX = 1, 9          # obstacle sprite pixel count\nOBS_MD_MIN, OBS_MD_MAX = 2, 6             # obstacle manhattan distance from terminal\nINPUT_TURN_MIN, INPUT_TURN_MAX = 2, 5     # turns in the input irregular stroke\nDIAG_CONTINUE_PROB = 0.35                  # probability of continuing a diagonal run\nDIAG_START_PROB = 0.5                       # probability of starting/switching to diagonal\nMAX_RETRIES = 300                           # generate_input retry budget\nPLACEMENT_PAD = 1                           # padding around placed triples\n\nEDGE_DATA = {\n    \"top\": {\"fwd\": (1, 0), \"side\": (0, 1)},\n    \"bottom\": {\"fwd\": (-1, 0), \"side\": (0, -1)},\n    \"left\": {\"fwd\": (0, 1), \"side\": (-1, 0)},\n    \"right\": {\"fwd\": (0, -1), \"side\": (1, 0)},\n}\n\n\ndef _terminal_for(edge: str, n: int, bar_len: int, pos: int) -> tuple[int, int]:\n    \"\"\"Return the interior endpoint of a bar placed along *edge*.\"\"\"\n    if edge == \"top\":\n        return (bar_len - 1, pos)\n    if edge == \"bottom\":\n        return (n - bar_len, pos)\n    if edge == \"left\":\n        return (pos, bar_len - 1)\n    return (pos, n - bar_len)\n\n\ndef _transform(\n    locals_: list[tuple[int, int]], edge: str, n: int, bar_len: int, pos: int\n) -> list[tuple[int, int]]:\n    \"\"\"Map local (fwd, side) coords to global (row, col) for a given edge/pos.\"\"\"\n    tr, tc = _terminal_for(edge, n, bar_len, pos)\n    fr, fc = EDGE_DATA[edge][\"fwd\"]\n    sr, sc = EDGE_DATA[edge][\"side\"]\n    return [(tr + lr * fr + lc * sr, tc + lr * fc + lc * sc) for lr, lc in locals_]\n\n\ndef _grow_obstacle(\n    start: tuple[int, int], max_size: int, forbidden: set[tuple[int, int]]\n) -> list[tuple[int, int]]:\n    \"\"\"Grow a 4-connected sprite from *start*, avoiding *forbidden* cells.\"\"\"\n    obstacle = {start}\n    for _ in range(max_size - 1):\n        cands = [\n            (nr, nc)\n            for r, c in obstacle\n            for nr, nc in neighbors4(r, c)\n            if (nr, nc) not in obstacle and (nr, nc) not in forbidden\n        ]\n        if not cands:\n            break\n        obstacle.add(random.choice(cands))\n    return list(obstacle)\n\n\ndef _build_input_path(seg_len: int, turns: int, side: int) -> list[tuple[int, int]]:\n    \"\"\"Build an irregular 8-connected stroke going backward (away from border).\"\"\"\n    remaining = seg_len - 1\n    coords = [(0, side)]\n    diag_step = (-1, side)\n    orth_step = (-1, 0)\n    last_was_diag = None\n    turns_left = turns\n    while remaining > 0:\n        if turns_left <= 0:\n            step = diag_step if last_was_diag else orth_step\n            if last_was_diag is None:\n                step = random.choice([diag_step, orth_step])\n            run = remaining\n        else:\n            if last_was_diag is None:\n                is_diag = random.random() < DIAG_START_PROB\n            elif last_was_diag:\n                is_diag = random.random() < DIAG_CONTINUE_PROB\n            else:\n                is_diag = random.random() < DIAG_START_PROB\n            step = diag_step if is_diag else orth_step\n            if last_was_diag is not None and is_diag != last_was_diag:\n                turns_left -= 1\n            max_run = remaining - turns_left\n            run = random.randint(1, max(1, min(max_run, remaining)))\n        last_was_diag = (step == diag_step)\n        for _ in range(run):\n            pr, pc = coords[-1]\n            coords.append((pr + step[0], pc + step[1]))\n        remaining -= run\n    return coords\n\n\ndef _build_output_path(\n    seg_len: int, side: int, p1: int, p2: int, p3: int\n) -> list[tuple[int, int]]:\n    \"\"\"Build the 3-phase monotone output segment in local coords.\"\"\"\n    coords = [(0, side)]\n    # (fwd_dr, lateral_dc) for each phase: approach, alongside, exit\n    phase_steps = [(1, side), (1, 0), (1, -side)]\n    for phase_len, (dr, dc) in zip([p1, p2, p3], phase_steps):\n        for _ in range(phase_len):\n            pr, pc = coords[-1]\n            coords.append((pr + dr, pc + dc))\n    return coords\n\n\ndef _is_4adj(coords_a: list[tuple[int, int]], coords_b: list[tuple[int, int]]) -> bool:\n    \"\"\"Return True if any cell in *coords_a* overlaps or is 4-adjacent to *coords_b*.\"\"\"\n    bset = set(coords_b)\n    for r, c in coords_a:\n        if (r, c) in bset:\n            return True\n        for nr, nc in neighbors4(r, c):\n            if (nr, nc) in bset:\n                return True\n    return False\n\n\ndef _make_triple(n: int) -> dict | None:\n    \"\"\"Generate one bar+segment+obstacle triple in local coordinates (origin at terminal).\"\"\"\n    max_bar = min(BAR_LEN_MAX, n - BAR_CLEARANCE)\n    if max_bar < BAR_LEN_MIN:\n        return None\n\n    bar_len = random.randint(BAR_LEN_MIN, max_bar)\n    max_seg = min(SEG_LEN_MAX, n - bar_len + 1)\n    if max_seg < SEG_LEN_MIN:\n        return None\n    seg_len = random.randint(SEG_LEN_MIN, max_seg)\n    side = random.choice((-1, 1))\n    bar = [(-k, 0) for k in range(bar_len)]\n    bar_set = set(bar)\n\n    # Phase lengths: p1 >= 1, p2 >= 0, p3 >= 0, p1+p2+p3 = seg_len-1\n    remaining = seg_len - 1\n    p1 = random.randint(1, min(remaining - 1, PHASE_MAX))\n    remaining -= p1\n    p2 = random.randint(0, min(remaining, PHASE_MAX))\n    p3 = remaining - p2\n\n    output_seg = _build_output_path(seg_len, side, p1, p2, p3)\n    seg_set = set(output_seg)\n\n    # V apex inner: grow obstacle from here\n    apex = output_seg[p1]\n    apex_inner = (apex[0], apex[1] - side)\n    if apex_inner in seg_set or apex_inner in bar_set:\n        return None\n\n    obs_size = random.randint(OBS_SIZE_MIN, OBS_SIZE_MAX)\n    obstacle = _grow_obstacle(apex_inner, obs_size, seg_set | bar_set)\n\n    # Manhattan distance from terminal check\n    nearest_md = min(abs(r) + abs(c) for r, c in obstacle)\n    if not (OBS_MD_MIN <= nearest_md <= OBS_MD_MAX):\n        return None\n\n    # Input segment\n    max_turns = min(INPUT_TURN_MAX, seg_len - 2)\n    turns = random.randint(INPUT_TURN_MIN, max_turns)\n    input_seg = _build_input_path(seg_len, turns, side)\n\n    if _is_4adj(input_seg, obstacle):\n        return None\n\n    union = bar + obstacle + input_seg + output_seg\n    rs = [r for r, _ in union]\n    cs = [c for _, c in union]\n\n    return {\n        \"bar_len\": bar_len,\n        \"bar\": bar,\n        \"obstacle\": obstacle,\n        \"input_seg\": input_seg,\n        \"output_seg\": output_seg,\n        \"bbox\": (min(rs), min(cs), max(rs), max(cs)),\n    }\n\n\ndef _expanded_bbox(coords: list[tuple[int, int]], n: int) -> tuple[int, int, int, int]:\n    \"\"\"Compute bounding box of *coords* expanded by PLACEMENT_PAD, clamped to [0, n-1].\"\"\"\n    rs = [r for r, _ in coords]\n    cs = [c for _, c in coords]\n    return (\n        max(0, min(rs) - PLACEMENT_PAD),\n        max(0, min(cs) - PLACEMENT_PAD),\n        min(n - 1, max(rs) + PLACEMENT_PAD),\n        min(n - 1, max(cs) + PLACEMENT_PAD),\n    )\n\n\ndef _place_triple(\n    triple: dict, edge: str, n: int, reserved: np.ndarray\n) -> dict | None:\n    \"\"\"Try to place a triple on *edge*, returning global coords or None.\"\"\"\n    positions = list(range(n))\n    random.shuffle(positions)\n    union = triple[\"bar\"] + triple[\"obstacle\"] + triple[\"input_seg\"] + triple[\"output_seg\"]\n    bar_len = triple[\"bar_len\"]\n\n    for pos in positions:\n        union_g = _transform(union, edge, n, bar_len, pos)\n        if any(r < 0 or c < 0 or r >= n or c >= n for r, c in union_g):\n            continue\n        r0, c0, r1, c1 = _expanded_bbox(union_g, n)\n        if reserved[r0 : r1 + 1, c0 : c1 + 1].any():\n            continue\n        placed = {\n            \"bar\": _transform(triple[\"bar\"], edge, n, bar_len, pos),\n            \"obstacle\": _transform(triple[\"obstacle\"], edge, n, bar_len, pos),\n            \"input_seg\": _transform(triple[\"input_seg\"], edge, n, bar_len, pos),\n            \"output_seg\": _transform(triple[\"output_seg\"], edge, n, bar_len, pos),\n            \"terminal\": _transform([(0, 0)], edge, n, bar_len, pos)[0],\n            \"reserve\": (r0, c0, r1, c1),\n        }\n        return placed\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt: build grid with 1-3 triples, validate via oracle.\"\"\"\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    if n < 11:\n        max_triples = 1\n    elif n < 15:\n        max_triples = 2\n    else:\n        max_triples = 3\n    triple_count = random.randint(1, max_triples)\n\n    bg, bar_color, seg_color, obstacle_color = random.sample(range(10), 4)\n    inp = np.full((n, n), bg, dtype=int)\n    out = np.full((n, n), bg, dtype=int)\n    reserved = np.zeros((n, n), dtype=bool)\n    placed_triples = []\n\n    for edge in random.sample(list(EDGE_DATA), triple_count):\n        triple = _make_triple(n)\n        if triple is None:\n            return None\n        placed = _place_triple(triple, edge, n, reserved)\n        if placed is None:\n            return None\n\n        paint_coords(inp, placed[\"bar\"], bar_color)\n        paint_coords(inp, placed[\"obstacle\"], obstacle_color)\n        paint_coords(inp, placed[\"input_seg\"], seg_color)\n\n        paint_coords(out, placed[\"bar\"], bar_color)\n        paint_coords(out, placed[\"obstacle\"], obstacle_color)\n        paint_coords(out, placed[\"output_seg\"], seg_color)\n\n        r0, c0, r1, c1 = placed[\"reserve\"]\n        reserved[r0 : r1 + 1, c0 : c1 + 1] = True\n        placed_triples.append(placed)\n\n    if len(placed_triples) > 1:\n        for i, placed in enumerate(placed_triples):\n            tr, tc = placed[\"terminal\"]\n            own = min(abs(r - tr) + abs(c - tc) for r, c in placed[\"obstacle\"])\n            other = min(\n                abs(r - tr) + abs(c - tc)\n                for j, other_placed in enumerate(placed_triples)\n                if j != i\n                for r, c in other_placed[\"obstacle\"]\n            )\n            if own >= other:\n                return None\n\n    try:\n        if not np.array_equal(main(inp), out):\n            return None\n    except Exception:\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"前四个参考题看完了，风格上都是自包含的确定性解析器加带 oracle 校验的随机生成器。接下来读取剩余参考题，并同时检查目标目录状态。"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p; /''^def generate_input(/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n        size = _pick_bbox_size(H, W)\n        if size is None:\n            continue\n        bh, bw = size\n        rmin = random.randint(0, H - bh)\n        cmin = random.randint(0, W - bw)\n        diag = \"TLBR\" if random.random() < TLBR_PROB else \"TRBL\"\n        cells = _l_pair_cells(rmin, cmin, rmin + bh - 1, cmin + bw - 1, diag)\n        if can_place(cells):\n            do_place(cells, color)\n            return True\n    return False\n\n\ndef _build_legend(H, W, bg):\n    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n\n    Returns (grid, legend_rows, legend_mask, legend_c, legend_bot) or None on failure.\n    \"\"\"\n    legend_c = random.randint(*LEGEND_COL_RANGE)\n    legend_bot = random.choice([H - 1, H - 2])\n    n_entries = random.randint(*LEGEND_ENTRY_RANGE)\n    if legend_bot - n_entries + 1 < 0:\n        return None\n\n    pool = [c for c in range(10) if c != bg]\n    if len(pool) < n_entries:\n        return None\n    marker_colors = random.sample(pool, n_entries)\n\n    grid = np.full((H, W), bg, dtype=int)\n    legend_rows: list[tuple[int, int, int]] = []\n    legend_mask = np.zeros((H, W), dtype=bool)\n    for i in range(n_entries):\n        r = legend_bot - i\n        m = marker_colors[i]\n        fill = random.randint(0, 9)\n        legend_rows.append((r, m, fill))\n        grid[r, legend_c] = m\n        legend_mask[r, legend_c] = True\n        if legend_c + 1 < W:\n            grid[r, legend_c + 1] = fill\n            legend_mask[r, legend_c + 1] = True\n\n    return grid, legend_rows, legend_mask, legend_c, legend_bot, marker_colors\n\n\ndef _build_forbidden(H, W, legend_c, legend_bot, legend_rows):\n    \"\"\"Build the forbidden-placement mask that protects legend scan integrity.\n\n    Forbids non-bg placement in rows below legend_bot and in columns <= legend_c\n    above the legend (except legend marker cells themselves).\n    \"\"\"\n    forbidden = np.zeros((H, W), dtype=bool)\n    if legend_bot + 1 < H:\n        forbidden[legend_bot + 1:, :] = True\n    forbidden[:legend_bot + 1, :legend_c + 1] = True\n    for r, _, _ in legend_rows:\n        forbidden[r, legend_c] = False\n    return forbidden\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.randint(0, 9)\n\n    legend_result = _build_legend(H, W, bg)\n    if legend_result is None:\n        return None\n    grid, legend_rows, legend_mask, legend_c, legend_bot, marker_colors = legend_result\n\n    forbidden = _build_forbidden(H, W, legend_c, legend_bot, legend_rows)\n    occupied = legend_mask.copy()\n\n    # Assign a marker type per legend entry.\n    n_entries = len(legend_rows)\n    types = [\"L\"] * n_entries\n    idx_pool = list(range(n_entries))\n    random.shuffle(idx_pool)\n    if random.random() < NOOP_PROB and len(idx_pool) > 1:\n        types[idx_pool.pop()] = \"noop\"\n    if random.random() < BLOCK_PROB and idx_pool:\n        types[idx_pool.pop()] = \"block\"\n\n    def can_place(cells):\n        for r, c in cells:\n            if not (0 <= r < H and 0 <= c < W):\n                return False\n            if occupied[r, c] or forbidden[r, c]:\n                return False\n        return True\n\n    def do_place(cells, color):\n        for r, c in cells:\n            grid[r, c] = color\n            occupied[r, c] = True\n\n    # Place markers for each legend entry.\n    for i, (_, m, _) in enumerate(legend_rows):\n        t = types[i]\n        if t == \"noop\":\n            continue\n        if t == \"block\":\n            placed = False\n            for _ in range(BLOCK_RETRIES):\n                r0 = random.randint(0, H - 2)\n                c0 = random.randint(0, W - 2)\n                cells = [(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)]\n                if can_place(cells):\n                    do_place(cells, m)\n                    placed = True\n                    break\n            if not placed:\n                return None\n        else:\n            if not _try_place_l_pair(H, W, m, LPAIR_RETRIES, can_place, do_place):\n                return None\n\n    # Optional distractor L-pair in a non-legend color.\n    if random.random() < DISTRACTOR_PROB:\n        avail = [c for c in range(10) if c != bg and c not in marker_colors]\n        if avail:\n            _try_place_l_pair(H, W, random.choice(avail),\n                              DISTRACTOR_RETRIES, can_place, do_place)\n\n    # Ensure bg remains the most common color (so get_bg picks it).\n    counts = Counter(grid.flatten().tolist())\n    if counts.most_common(1)[0][0] != bg:\n        return None\n\n    # Oracle check: solver must run without errors.\n    try:\n        _ = main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt()\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: failed to generate a valid input after %d attempts\" % GEN_RETRIES)\n","exit_code":0,"status":"completed"}}
