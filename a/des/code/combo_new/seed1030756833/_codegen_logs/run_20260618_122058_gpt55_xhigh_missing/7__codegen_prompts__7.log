{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/dce56571.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Straighten the single foreground mask into a centered horizontal segment of the same color and length.\n\n    Input structure:\n    - The grid has one dominant background color.\n    - All non-background pixels share one foreground color.\n    - The number of foreground pixels fits in one centered row of the grid.\n\n    Rule:\n    - Erase the original foreground mask.\n    - Count its pixels, keep its color, and paint that many pixels as a horizontal segment.\n    - Place the segment on the middle row with equal background margin on the left and right.\n\n    Key insight:\n    - The original foreground shape is irrelevant except for its color and area; the output is the area normalized into the grid's central horizontal line.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n\n    color = fg_colors[0]\n    count = int(np.count_nonzero(g == color))\n    assert 0 < count <= width, \"foreground pixels must fit in one row\"\n    assert height % 2 == 1, \"expected a unique middle row\"\n    assert (width - count) % 2 == 0, \"foreground segment must center with equal side margins\"\n\n    out = np.full(g.shape, bg, dtype=int)\n    row = height // 2\n    start = (width - count) // 2\n    out[row, start : start + count] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas, palette, and foreground-count controls.\nHEIGHT_MIN, HEIGHT_MAX, HEIGHT_STEP = 5, 11, 2\nWIDTH_MIN, WIDTH_MAX = 10, 28\nBACKGROUND_COLOR = 8\nFOREGROUND_COLORS = tuple(c for c in range(10) if c != BACKGROUND_COLOR)\nCOUNT_MIN, COUNT_MAX = 6, 15\n# Sparse bbox shape, blob growth, and retry controls.\nBBOX_SPAN_MIN, BBOX_SPAN_MAX = 3, 8\nBBOX_FILL_MIN, BBOX_FILL_MAX = 0.29, 0.67\nCOVER_PATTERN_COUNT = 3\nADJACENT_GROW_PROB = 0.85\nGENERATION_ATTEMPTS = 300\n\n\ndef _gen_covering_cells(box_h, box_w):\n    cells = set()\n    mode = random.randrange(COVER_PATTERN_COUNT)\n\n    if mode == 0:\n        length = max(box_h, box_w)\n        flip_r = random.choice([False, True])\n        flip_c = random.choice([False, True])\n        for i in range(length):\n            r = round(i * (box_h - 1) / (length - 1))\n            c = round(i * (box_w - 1) / (length - 1))\n            if flip_r:\n                r = box_h - 1 - r\n            if flip_c:\n                c = box_w - 1 - c\n            cells.add((r, c))\n    elif box_h >= box_w:\n        cols = list(range(box_w)) + [random.randrange(box_w) for _ in range(box_h - box_w)]\n        random.shuffle(cols)\n        cells.update((r, cols[r]) for r in range(box_h))\n    else:\n        rows = list(range(box_h)) + [random.randrange(box_h) for _ in range(box_w - box_h)]\n        random.shuffle(rows)\n        cells.update((rows[c], c) for c in range(box_w))\n\n    return cells\n\n\ndef _gen_adjacent_empty(cells, all_cells):\n    out = []\n    for r, c in all_cells:\n        if (r, c) in cells:\n            continue\n        for rr, cc in cells:\n            if max(abs(r - rr), abs(c - cc)) == 1:\n                out.append((r, c))\n                break\n    return out\n\n\ndef _gen_blob_cells(box_h, box_w, count):\n    cells = _gen_covering_cells(box_h, box_w)\n    all_cells = [(r, c) for r in range(box_h) for c in range(box_w)]\n\n    while len(cells) < count:\n        empty = [p for p in all_cells if p not in cells]\n        frontier = _gen_adjacent_empty(cells, all_cells)\n        pool = frontier if frontier and random.random() < ADJACENT_GROW_PROB else empty\n        cells.add(random.choice(pool))\n\n    return cells\n\n\ndef _gen_bbox_shape(height, width, count):\n    max_h = min(BBOX_SPAN_MAX, height)\n    max_w = min(BBOX_SPAN_MAX, width)\n    shapes = []\n    for box_h in range(BBOX_SPAN_MIN, max_h + 1):\n        for box_w in range(BBOX_SPAN_MIN, max_w + 1):\n            area = box_h * box_w\n            fill = count / area\n            if max(box_h, box_w) < count and BBOX_FILL_MIN <= fill <= BBOX_FILL_MAX:\n                shapes.append((box_h, box_w))\n    if not shapes:\n        for box_h in range(BBOX_SPAN_MIN, max_h + 1):\n            for box_w in range(BBOX_SPAN_MIN, max_w + 1):\n                if max(box_h, box_w) < count and box_h * box_w > count:\n                    shapes.append((box_h, box_w))\n    return random.choice(shapes)\n\n\ndef _draw_centered_segment(height, width, count, bg, color):\n    grid = np.full((height, width), bg, dtype=int)\n    row = height // 2\n    start = (width - count) // 2\n    grid[row, start : start + count] = color\n    return grid\n\n\ndef _draw_scattered_blob(height, width, count, bg, color):\n    grid = np.full((height, width), bg, dtype=int)\n    box_h, box_w = _gen_bbox_shape(height, width, count)\n    r0 = random.randint(0, height - box_h)\n    c0 = random.randint(0, width - box_w)\n    for rr, cc in _gen_blob_cells(box_h, box_w, count):\n        grid[r0 + rr, c0 + cc] = color\n    return grid\n\n\ndef _gen_attempt():\n    height = random.randrange(HEIGHT_MIN, HEIGHT_MAX + 1, HEIGHT_STEP)\n    width = random.randint(WIDTH_MIN, WIDTH_MAX)\n    count_max = min(COUNT_MAX, width)\n    counts = [n for n in range(COUNT_MIN, count_max + 1) if (width - n) % 2 == 0]\n    if not counts:\n        return None\n\n    count = random.choice(counts)\n    bg = BACKGROUND_COLOR\n    color = random.choice(FOREGROUND_COLORS)\n\n    output = _draw_centered_segment(height, width, count, bg, color)\n    inp = _draw_scattered_blob(height, width, count, bg, color)\n    if np.array_equal(main(inp), output):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid dce56571 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,300p' /home/lixinyu/snap/new/ARC_code/eval/135a2760.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair noisy periodic patterns inside frame-delimited grid regions.\n\n    Input structure:\n    - Frame color (most common) forms full rows/cols, dividing the grid into rectangular regions.\n    - bg (second most common) fills empty space; each region contains a small colored tile repeated periodically with a few corrupted pixels.\n\n    Rule:\n    - For each region, find the bounding box of non-bg content.\n    - Infer the smallest repeating tile that explains the pattern (majority vote per residue position), requiring it repeat at least 2x per axis.\n    - Replace the region with the clean tiled version.\n\n    Key insight: Tile dimensions are unknown and must be inferred; prefer the smallest tile with genuine repetition over one that memorizes the entire region.\n    \"\"\"\n    g = np.array(grid, dtype=int).copy()\n    H, W = g.shape\n\n    cnt = Counter(map(int, g.flatten()))\n    frame = int(cnt.most_common(1)[0][0])\n    bg = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(frame):\n            bg = int(col)\n            break\n    assert not (bg is None)\n\n    fr = [int(r) for r in range(H) if bool((g[int(r), :] == int(frame)).all())]\n    fc = [int(c) for c in range(W) if bool((g[:, int(c)] == int(frame)).all())]\n    fr = sorted(set(fr))\n    fc = sorted(set(fc))\n\n    assert fr\n    assert fc\n\n    if fr[0] != 0:\n        fr = [-1] + fr\n    if fr[-1] != (H - 1):\n        fr = fr + [H]\n    else:\n        fr = fr + [H]\n\n    if fc[0] != 0:\n        fc = [-1] + fc\n    if fc[-1] != (W - 1):\n        fc = fc + [W]\n    else:\n        fc = fc + [W]\n\n    def reconstruct(core: np.ndarray, maxp: int = 12) -> np.ndarray:\n        h, w = core.shape\n        best_all = None  # ((mism, area), B)\n        best_ok = None\n\n        for ph in range(1, min(int(maxp), int(h)) + 1):\n            for pw in range(1, min(int(maxp), int(w)) + 1):\n                tile = np.zeros((int(ph), int(pw)), dtype=int)\n                for i in range(int(ph)):\n                    for j in range(int(pw)):\n                        vals = core[int(i) :: int(ph), int(j) :: int(pw)].flatten()\n                        tile[int(i), int(j)] = int(Counter(map(int, vals)).most_common(1)[0][0])\n\n                B = np.tile(tile, ((h + ph - 1) // ph, (w + pw - 1) // pw))[:h, :w]\n                mism = int(np.sum(B != core))\n                area = int(ph * pw)\n                key = (mism, area)\n\n                if best_all is None or key < best_all[0]:\n                    best_all = (key, B)\n\n                # Require some repetition (avoid memorizing the entire core).\n                ok = True\n                if int(ph) == int(h) and int(pw) == int(w):\n                    ok = False\n                if int(ph) < int(h) and (int(h) // int(ph)) < 2:\n                    ok = False\n                if int(pw) < int(w) and (int(w) // int(pw)) < 2:\n                    ok = False\n                if ok and (best_ok is None or key < best_ok[0]):\n                    best_ok = (key, B)\n\n        return (best_ok or best_all)[1]\n\n    out = g.copy()\n    for i in range(len(fr) - 1):\n        r0, r1 = int(fr[i]), int(fr[i + 1])\n        if int(r1 - r0) <= 1:\n            continue\n        rr0, rr1 = int(r0 + 1), int(r1 - 1)\n\n        for j in range(len(fc) - 1):\n            c0, c1 = int(fc[j]), int(fc[j + 1])\n            if int(c1 - c0) <= 1:\n                continue\n            cc0, cc1 = int(c0 + 1), int(c1 - 1)\n\n            A = g[rr0 : rr1 + 1, cc0 : cc1 + 1]\n            m = A != int(bg)\n            if not bool(m.any()):\n                continue\n\n            rs = np.where(m.any(axis=1))[0]\n            cs = np.where(m.any(axis=0))[0]\n            rmin, rmax = int(rs.min()), int(rs.max())\n            cmin, cmax = int(cs.min()), int(cs.max())\n\n            core = A[rmin : rmax + 1, cmin : cmax + 1]\n            rec = reconstruct(core)\n\n            A2 = A.copy()\n            A2[rmin : rmax + 1, cmin : cmax + 1] = rec\n            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = A2\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    bg = 0\n    frame = 5\n\n    # Region grid (2x2 or 3x2) with 1px frame separators.\n    n_r = int(np.random.randint(2, 4))\n    n_c = int(np.random.randint(2, 3))\n\n    r_sizes = [int(np.random.randint(6, 11)) for _ in range(n_r)]\n    c_sizes = [int(np.random.randint(6, 11)) for _ in range(n_c)]\n\n    H = int(sum(r_sizes) + (n_r + 1))\n    W = int(sum(c_sizes) + (n_c + 1))\n\n    g = np.full((H, W), int(frame), dtype=int)\n\n    # Fill each region with bg and optionally a repeating tile with noise.\n    any_pattern = False\n    r0 = 1\n    for i, rh in enumerate(r_sizes):\n        c0 = 1\n        for j, cw in enumerate(c_sizes):\n            region = np.full((int(rh), int(cw)), int(bg), dtype=int)\n\n            if bool(np.random.rand() < 0.85) or not any_pattern:\n                any_pattern = True\n                ph = int(np.random.randint(1, min(4, rh) + 1))\n                pw = int(np.random.randint(1, min(4, cw) + 1))\n\n                pal = [int(c) for c in np.random.choice(range(1, 10), size=int(np.random.randint(2, 5)), replace=False)]\n                pal = [c for c in pal if int(c) != int(frame)]\n                if not pal:\n                    pal = [2, 3]\n\n                tile = np.full((ph, pw), int(bg), dtype=int)\n                # Ensure at least one non-bg in the tile.\n                tile[int(np.random.randint(0, ph)), int(np.random.randint(0, pw))] = int(pal[0])\n                # Add a few more colored cells.\n                k = int(np.random.randint(0, ph * pw))\n                idx = np.random.choice(ph * pw, size=int(k), replace=False)\n                for t in idx:\n                    tile.flat[int(t)] = int(pal[int(np.random.randint(0, len(pal)))])\n\n                tiled = np.tile(tile, ((rh + ph - 1) // ph, (cw + pw - 1) // pw))[:rh, :cw]\n                region[:, :] = tiled\n\n                # Add small noise (flip a few cells) so reconstruction does real work.\n                n_noise = int(np.random.randint(0, max(1, (rh * cw) // 20)))\n                for _ in range(n_noise):\n                    rr = int(np.random.randint(0, rh))\n                    cc = int(np.random.randint(0, cw))\n                    if int(region[rr, cc]) != int(bg):\n                        region[rr, cc] = int(pal[int(np.random.randint(0, len(pal)))])\n\n            g[int(r0) : int(r0 + rh), int(c0) : int(c0 + cw)] = region\n            c0 += int(cw) + 1\n        r0 += int(rh) + 1\n\n    return g\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/37ce87bb.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport random\n\n\ndef _operand_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        color = int(comp[\"color\"])\n        assert color in (Color.TEAL, Color.RED)\n\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        area = int(comp[\"area\"])\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    assert any(bar[\"color\"] == Color.TEAL for bar in bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Compute a grey result bar by adding teal bar heights and subtracting red bar heights.\n\n    Input structure\n    - The grid has a dominant background and several bottom-aligned one-cell-wide vertical bars.\n    - Teal bars are positive operands; red bars are negative operands.\n    - The penultimate column is an empty result slot.\n\n    Rule\n    - Keep every input bar unchanged.\n    - Compute result height = total teal bar height - total red bar height.\n    - Paint that many bottom cells of the penultimate column grey.\n\n    Key insight\n    - The bars encode arithmetic by height, with color providing the sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n    bars = _operand_bars(g, bg)\n\n    result_height = 0\n    for bar in bars:\n        if bar[\"color\"] == Color.TEAL:\n            result_height += bar[\"height\"]\n        else:\n            assert bar[\"color\"] == Color.RED\n            result_height -= bar[\"height\"]\n\n    assert 0 < result_height <= height\n    assert width >= 2\n    result_col = width - 2\n    assert bool(np.all(g[:, result_col] == bg))\n\n    out = g.copy()\n    out[height - result_height : height, result_col] = Color.GREY\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas, object, and result-size bounds.\nBAR_COUNT_RANGE = (2, 6)\nGRID_HEIGHT_RANGE = (6, 12)\nTOP_MARGIN_ROWS, RESULT_HEIGHT_MIN = 1, 1\n# Column layout.\nBAR_COL_START, BAR_COL_STRIDE, WIDTH_EXTRA_COLS, RESULT_COL_FROM_RIGHT = 1, 2, 3, 2\n# Color palette and retry budget.\nBG_COLOR, RESULT_COLOR, POSITIVE_COLOR, NEGATIVE_COLOR = Color.ORANGE, Color.GREY, Color.TEAL, Color.RED\nGEN_RETRY_LIMIT = 300\n\n\ndef _bounded_composition(total: int, parts: int, *, upper: int) -> list[int] | None:\n    \"\"\"Sample positive bounded parts summing to total, or None if impossible.\"\"\"\n    if parts == 0:\n        return [] if total == 0 else None\n    if not (parts <= total <= parts * upper):\n        return None\n    values = []\n    remaining = total\n    for i in range(parts):\n        slots = parts - i - 1\n        lo = max(1, remaining - slots * upper)\n        hi = min(upper, remaining - slots)\n        value = random.randint(lo, hi)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _sample_bar_specs(n: int, max_bar_height: int) -> tuple[list[tuple[int, int]], int] | None:\n    \"\"\"Sample shuffled operand specs and the matching grey result height.\"\"\"\n    result_height = random.randint(RESULT_HEIGHT_MIN, max_bar_height)\n    feasible_teal_counts = []\n    for teal_count in range(1, n + 1):\n        red_count = n - teal_count\n        red_sum_lo = max(red_count, teal_count - result_height)\n        red_sum_hi = min(red_count * max_bar_height, teal_count * max_bar_height - result_height)\n        if red_sum_lo <= red_sum_hi:\n            feasible_teal_counts.append((teal_count, red_sum_lo, red_sum_hi))\n    if not feasible_teal_counts:\n        return None\n\n    teal_count, red_sum_lo, red_sum_hi = random.choice(feasible_teal_counts)\n    red_count = n - teal_count\n    red_sum = random.randint(red_sum_lo, red_sum_hi)\n    teal_sum = red_sum + result_height\n    teal_heights = _bounded_composition(teal_sum, teal_count, upper=max_bar_height)\n    red_heights = _bounded_composition(red_sum, red_count, upper=max_bar_height)\n    if teal_heights is None or red_heights is None:\n        return None\n\n    bar_specs = [(POSITIVE_COLOR, h) for h in teal_heights] + [(NEGATIVE_COLOR, h) for h in red_heights]\n    random.shuffle(bar_specs)\n    return bar_specs, result_height\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*BAR_COUNT_RANGE)\n    height = random.randint(*GRID_HEIGHT_RANGE)\n    max_bar_height = height - TOP_MARGIN_ROWS\n    width = BAR_COL_STRIDE * n + WIDTH_EXTRA_COLS\n    if (sampled := _sample_bar_specs(n, max_bar_height)) is None:\n        return None\n    bar_specs, result_height = sampled\n    out = np.full((height, width), BG_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(bar_specs):\n        col = BAR_COL_START + BAR_COL_STRIDE * i\n        out[height - bar_height : height, col] = color\n    out[height - result_height : height, width - RESULT_COL_FROM_RIGHT] = RESULT_COLOR\n\n    inp = out.copy()\n    inp[:, width - RESULT_COL_FROM_RIGHT] = BG_COLOR\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, label_mask, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _unique_largest_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = Counter(int(v) for v in g.ravel())\n    ranked = sorted(colors, key=lambda color: counts[int(color)], reverse=True)\n    assert len(ranked) >= 2, \"expected at least two candidate colors\"\n    assert counts[ranked[0]] > counts[ranked[1]], \"foreground majority must be unique\"\n    return int(ranked[0])\n\n\ndef _long_component_ids(lab: np.ndarray, n: int) -> set[int]:\n    h = int(lab.shape[0])\n    min_row_span = max(1, h // 3)\n    ids: set[int] = set()\n    for comp_id in range(1, n + 1):\n        coords = np.argwhere(lab == comp_id)\n        assert coords.size > 0, \"component labels must be nonempty\"\n        r0 = int(coords[:, 0].min())\n        r1 = int(coords[:, 0].max())\n        if r1 - r0 + 1 >= min_row_span:\n            ids.add(int(comp_id))\n    assert len(ids) >= 2, \"expected at least two long contour components\"\n    return ids\n\n\ndef _two_exterior_bg_ids(bg_lab: np.ndarray, n_bg: int) -> set[int]:\n    assert n_bg >= 3, \"expected interior and exterior background regions\"\n    sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n    size_values = sorted(sizes.values(), reverse=True)\n    assert size_values[1] > size_values[2], \"two exterior regions must be separated by size\"\n    cutoff = size_values[1]\n    exterior = {comp_id for comp_id, size in sizes.items() if size >= cutoff}\n    assert len(exterior) == 2, \"expected exactly two exterior background regions\"\n    return exterior\n\n\ndef _touches_long_contour(\n    coords: np.ndarray,\n    fill_lab: np.ndarray,\n    long_ids: set[int],\n) -> bool:\n    for r, c in coords:\n        for rr, cc in neighbors4(int(r), int(c)):\n            if 0 <= rr < fill_lab.shape[0] and 0 <= cc < fill_lab.shape[1]:\n                if int(fill_lab[rr, cc]) in long_ids:\n                    return True\n    return False\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the small background compartments bounded by the long contour color.\n\n    Input structure:\n    - The grid has one dominant background color and two foreground colors.\n    - The more frequent foreground color forms long 8-connected contour fragments.\n    - The other foreground color is a fixed distractor/obstacle color that partitions\n      the background but is never recolored.\n\n    Rule:\n    - Split the background into 4-connected regions using all foreground pixels as\n      barriers.\n    - Keep the two largest background regions as the outside of the contour drawing.\n    - Recolor every other background region that touches a long contour component\n      to the contour color; leave all foreground pixels unchanged.\n\n    Key insight:\n    The apparent area fill is exactly a component-level fill of bounded background\n    compartments, not a row-wise interpolation between individual contour pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 2, \"expected exactly two foreground colors\"\n\n    fill_color = _unique_largest_color(g, foreground)\n    fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n    long_ids = _long_component_ids(fill_lab, _n_fill)\n\n    bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n    exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n    out = g.copy()\n    for comp_id in range(1, n_bg + 1):\n        if comp_id in exterior_ids:\n            continue\n        coords = np.argwhere(bg_lab == comp_id)\n        if _touches_long_contour(coords, fill_lab, long_ids):\n            out[bg_lab == comp_id] = fill_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\nH, W = 30, 30\nGRID_SHAPE = (H, W)\nARC_COLOR_COUNT = 10\n\n# Long contour path layout.\nPATH_COUNT_OPTIONS = (2, 3)\nPATH_STEP_OPTIONS = (-1, 0, 1)\nPATH_GAP_MIN, PATH_GAP_MAX = 2, 5\nPATH_LEFT_MIN_COL, PATH_RIGHT_MARGIN = 2, 3\nPATH_START_MIN_COL = 3\nPATH_START_RIGHT_MARGIN = 4\nPATH_FAR_END_MIN_CHOICES, PATH_FAR_END_PROB, PATH_FAR_END_DELTA = 8, 0.7, 5\nPATH_SCORING_CANDIDATES = 5\nPATH_MIN_MOVES = 12\n\n# Contour distractors and extra contour pixels.\nOUTSIDE_MARGIN = 2\nOUTSIDE_SIDE_OPTIONS = (-1, 1)\nSHORT_FRAGMENT_COUNT_MIN, SHORT_FRAGMENT_COUNT_MAX = 3, 5\nSHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX = 1, 4\nSHORT_FRAGMENT_ATTEMPTS = 200\nSHORT_FRAGMENT_PATH_PADDING = 3\nCONTOUR_PIXELS_MIN, CONTOUR_PIXELS_MAX = 81, 108\n\n# Obstacle bars and scattered clusters.\nBAR_SEGMENT_MAX = 11\nSINGLE_CHANNEL_BARS_MIN, SINGLE_CHANNEL_BARS_MAX = 5, 11\nMULTI_CHANNEL_TOTAL_BARS_MIN, MULTI_CHANNEL_TOTAL_BARS_MAX = 4, 10\nMULTI_CHANNEL_INITIAL_BARS = 2\nMULTI_CHANNEL_MAX_BARS = 5\nBAR_WIDTH_MIN, BAR_WIDTH_MAX = 1, 5\nOBSTACLE_PIXELS_MIN, OBSTACLE_PIXELS_MAX = 36, 63\nOBSTACLE_EXTRA_PIXELS_MIN = 8\nOBSTACLE_OUTSIDE_QUOTA_MIN, OBSTACLE_OUTSIDE_QUOTA_MAX = 8, 16\nOBSTACLE_CLUSTER_SIZE_MIN, OBSTACLE_CLUSTER_SIZE_MAX = 1, 5\nOBSTACLE_ATTEMPTS = 300\nOBSTACLE_ZONE_OPTIONS = (\"outside\", \"inside\", \"any\")\n\n# Component validation.\nBG_REGIONS_MIN, BG_REGIONS_MAX = 8, 14\nEXTERIOR_REGION_COUNT = 2\nINTERIOR_REGIONS_MIN, INTERIOR_REGIONS_MAX = 6, 12\nINTERIOR_REGION_AREA_MAX = 57\nLONG_COMPONENT_MIN_SPAN = H // 3\nLONG_COMPONENT_COUNT_OPTIONS = (2, 3)\n\n# Retry limits and local neighborhoods.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nNEIGHBOR_DELTAS_8 = NEIGHBOR_DELTAS_4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))\n\n\ndef _color_choices() -> tuple[int, int, int]:\n    colors = list(range(ARC_COLOR_COUNT))\n    random.shuffle(colors)\n    return int(colors[0]), int(colors[1]), int(colors[2])\n\n\ndef _path_columns(path_count: int) -> list[list[int]] | None:\n    gaps = [random.randint(PATH_GAP_MIN, PATH_GAP_MAX) for _ in range(path_count - 1)]\n    total_width = sum(gap + 1 for gap in gaps)\n    start_hi = W - PATH_START_RIGHT_MARGIN - total_width\n    if start_hi < PATH_START_MIN_COL:\n        return None\n\n    start = random.randint(PATH_START_MIN_COL, start_hi)\n    end_choices = list(range(PATH_START_MIN_COL, start_hi + 1))\n    if len(end_choices) > PATH_FAR_END_MIN_CHOICES and random.random() < PATH_FAR_END_PROB:\n        far = [c for c in end_choices if abs(c - start) >= PATH_FAR_END_DELTA]\n        if far:\n            end_choices = far\n    end = random.choice(end_choices)\n\n    cols = [start]\n    for gap in gaps:\n        cols.append(cols[-1] + gap + 1)\n    targets = [c + (end - start) for c in cols]\n\n    paths = [[int(c)] for c in cols]\n    for r in range(1, H):\n        valid: list[list[int]] = []\n        for steps in itertools.product(PATH_STEP_OPTIONS, repeat=path_count):\n            nxt = [cols[i] + steps[i] for i in range(path_count)]\n            if nxt[0] < PATH_LEFT_MIN_COL or nxt[-1] > W - PATH_RIGHT_MARGIN:\n                continue\n            if all(PATH_GAP_MIN <= nxt[i + 1] - nxt[i] - 1 <= PATH_GAP_MAX for i in range(path_count - 1)):\n                valid.append(nxt)\n        if not valid:\n            return None\n        ideal = [paths[i][0] + (targets[i] - paths[i][0]) * r / (H - 1) for i in range(path_count)]\n        scored = sorted(\n            valid,\n            key=lambda nxt: sum(abs(nxt[i] - ideal[i]) for i in range(path_count)) + random.random(),\n        )\n        cols = random.choice(scored[: max(1, min(PATH_SCORING_CANDIDATES, len(scored)))])\n        for i, c in enumerate(cols):\n            paths[i].append(int(c))\n\n    moves = sum(paths[i][r] != paths[i][r - 1] for i in range(path_count) for r in range(1, H))\n    if moves < PATH_MIN_MOVES:\n        return None\n    return paths\n\n\ndef _outside_enclosure(paths: list[list[int]], r: int, c: int, margin: int = OUTSIDE_MARGIN) -> bool:\n    return c <= paths[0][r] - margin or c >= paths[-1][r] + margin\n\n\ndef _inside_channel(paths: list[list[int]], r: int, c: int) -> bool:\n    return any(paths[i][r] < c < paths[i + 1][r] for i in range(len(paths) - 1))\n\n\ndef _touches_mask(mask: np.ndarray, coords: list[tuple[int, int]], connectivity: int) -> bool:\n    seen = set(coords)\n    deltas = NEIGHBOR_DELTAS_8 if connectivity == 8 else NEIGHBOR_DELTAS_4\n    for r, c in coords:\n        for dr, dc in deltas:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in seen and mask[rr, cc]:\n                return True\n    return False\n\n\ndef _place_short_fragments(\n    grid: np.ndarray, contour_mask: np.ndarray, paths: list[list[int]], contour: int, count: int\n) -> bool:\n    for _ in range(count):\n        size = random.randint(SHORT_FRAGMENT_SIZE_MIN, SHORT_FRAGMENT_SIZE_MAX)\n        placed = False\n        for _attempt in range(SHORT_FRAGMENT_ATTEMPTS):\n            r = random.randrange(H)\n            side = random.choice(OUTSIDE_SIDE_OPTIONS)\n            if side < 0:\n                hi = paths[0][r] - SHORT_FRAGMENT_PATH_PADDING - size + 1\n                if hi < 0:\n                    continue\n                c0 = random.randint(0, hi)\n            else:\n                lo = paths[-1][r] + SHORT_FRAGMENT_PATH_PADDING\n                if lo + size > W:\n                    continue\n                c0 = random.randint(lo, W - size)\n            coords = [(r, c0 + i) for i in range(size)]\n            if any(grid[rr, cc] != grid[0, 0] for rr, cc in coords):\n                continue\n            if _touches_mask(contour_mask, coords, 8):\n                continue\n            patch = np.full((1, size), contour, dtype=int)\n            paste(grid, patch, r, c0)\n            for rr, cc in coords:\n                contour_mask[rr, cc] = True\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _add_contour_extras(grid: np.ndarray, long_mask: np.ndarray, paths: list[list[int]], contour: int, needed: int) -> bool:\n    if needed < 0:\n        return False\n    candidates: list[tuple[int, int]] = []\n    for side, path_i in [(-1, 0), (1, len(paths) - 1)]:\n        for r, c in enumerate(paths[path_i]):\n            cc = c + side\n            if 0 <= cc < W and grid[r, cc] == grid[0, 0]:\n                candidates.append((r, cc))\n    if needed > len(candidates):\n        return False\n    random.shuffle(candidates)\n    for r, c in candidates[:needed]:\n        grid[r, c] = contour\n        long_mask[r, c] = True\n    return True\n\n\n","exit_code":0,"status":"completed"}}
