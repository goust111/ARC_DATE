13e47133.py:206:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/13e47133.py:231:    \"\"\"Pick bg, wall, and the remaining 8-color marker pool (all distinct).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/13e47133.py:241:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/13e47133.py:244:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/13e47133.py:258:    \"\"\"Confirm bg is mode and wall is second mode of the assembled grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/13e47133.py:298:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:8:    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:252:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:253:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:266:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:297:    \"\"\"Build 2Nx2N quadrant-ownership grid with tab intrusions.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:302:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:350:    \"\"\"Extract cells for quadrant *q* in local (0-based) coordinates.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:353:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:365:    \"\"\"Render cell list into a tight numpy patch (bg=0).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:375:    \"\"\"Sample random tab specs for all four boundaries.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:378:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:394:    \"\"\"Place patches on a canvas in random order with padding.\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:397:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py:459:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:21:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:188:    \"\"\"Isoceles diamond attached to left edge.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:204:    \"\"\"Right triangle on top edge, widest at top.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:217:    \"\"\"Right triangle on right edge, widest at bottom.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:245:    \"\"\"BFS from `start` on the ~blocked bool grid; return reach as (h,w) bool array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:263:    \"\"\"4-connected dilation by 1 via boolean slicing.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:273:    \"\"\"8-connected dilation by 1 via 4-conn dilation of a 4-conn dilation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:288:    \"\"\"Place 1..NUM_STRUCTS_RANGE non-overlapping shapes; skip any that cover marker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:307:    \"\"\"Every 4-conn structural component must touch a border AND be 4-adj to reach;\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:321:    \"\"\"Build solver-style output: BG / WALL / MARKER / FILL.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:347:    \"\"\"Place `count` decoration patches in `allowed_mask` cells.\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:351:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py:441:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:14:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:38:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:39:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:53:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:238:    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:246:    \"\"\"Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX].\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:280:    \"\"\"Render a binary mask as a colored sprite on bg.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:287:    \"\"\"Content area needed for grid_rows x grid_cols of NxN blocks with 1-cell gaps.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:292:    \"\"\"Pick (n, rows, cols, empty_count, total) satisfying frame size constraints.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:311:    \"\"\"Choose which grid slots are empty, ensuring every row and column has at least one filled slot.\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:314:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:329:    \"\"\"Create an h x w frame filled with bg and a 1-cell FRAME_COL border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:340:    \"\"\"Find a free location for patch and paste it onto grid/reserve. Returns success.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py:439:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
