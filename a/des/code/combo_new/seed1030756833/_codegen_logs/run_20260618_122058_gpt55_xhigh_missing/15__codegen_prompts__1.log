{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nshapes = [\n['###','#M#','###'],\n['###','#M.','#..'],\n['####','#M..','###.'],\n['###.','#M##','..#.'],\n['##.','#M#','###'],\n]\n\ndef mask(lines):\n    return np.array([[ch=='#' for ch in row] for row in lines])\n\ndef trim(m):\n    pts=np.argwhere(m)\n    r0,c0=pts.min(0); r1,c1=pts.max(0)\n    return m[r0:r1+1,c0:c1+1]\n\ndef key(m):\n    return (m.shape,m.tobytes())\n\ndef canon(m):\n    ks=[]\n    for k in range(4):\n        x=trim(np.rot90(m,k))\n        ks.append(str(x.shape)+x.tobytes().hex())\n    return min(ks)\nfor i,s in enumerate(shapes):\n    m=mask(s)\n    # 4-connected count\n    pts=set(map(tuple,np.argwhere(m)))\n    stack=[next(iter(pts))]; seen={stack[0]}\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            p=(r+dr,c+dc)\n            if p in pts and p not in seen:\n                seen.add(p); stack.append(p)\n    print(i, m.shape, m.sum(), len(seen)==len(pts), canon(m))\nprint('unique canon', len({canon(mask(s)) for s in shapes}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
