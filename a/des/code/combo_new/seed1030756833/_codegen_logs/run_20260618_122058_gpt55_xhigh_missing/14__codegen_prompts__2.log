{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,175p' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py && sed -n '573,620p' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport random\n\nCoord = tuple[int, int]\n\n\ndef _path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:\n    r0, c0 = start\n    r1, c1 = stop\n    pts: list[Coord] = []\n\n    if first_axis == \"h\":\n        c_step = 1 if c1 >= c0 else -1\n        for c in range(c0, c1 + c_step, c_step):\n            pts.append((r0, c))\n        r_step = 1 if r1 >= r0 else -1\n        for r in range(r0 + r_step, r1 + r_step, r_step):\n            pts.append((r, c1))\n        return pts\n\n    assert first_axis == \"v\", \"path axis must be horizontal or vertical\"\n    r_step = 1 if r1 >= r0 else -1\n    for r in range(r0, r1 + r_step, r_step):\n        pts.append((r, c0))\n    c_step = 1 if c1 >= c0 else -1\n    for c in range(c0 + c_step, c1 + c_step, c_step):\n        pts.append((r1, c))\n    return pts\n\n\ndef _last_axis(start: Coord, stop: Coord, first_axis: str) -> str:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    if first_axis == \"h\":\n        return \"v\" if dr else \"h\"\n    assert first_axis == \"v\", \"path axis must be horizontal or vertical\"\n    return \"h\" if dc else \"v\"\n\n\ndef _axis_priority(start: Coord, stop: Coord, previous_axis: str | None) -> list[str]:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    assert dr + dc > 0, \"components must be distinct\"\n\n    orders: list[str] = []\n    if previous_axis == \"h\" and dc:\n        orders.append(\"h\")\n    if previous_axis == \"v\" and dr:\n        orders.append(\"v\")\n\n    preferred = \"h\" if dc >= dr else \"v\"\n    if preferred not in orders:\n        orders.append(preferred)\n    other = \"v\" if preferred == \"h\" else \"h\"\n    if other not in orders:\n        orders.append(other)\n    return orders\n\n\ndef _clear(path: list[Coord], canvas: np.ndarray, bg: int, color: int) -> bool:\n    return all(int(canvas[r, c]) in (bg, color) for r, c in path)\n\n\ndef _connector_path(\n    comp_a: np.ndarray,\n    comp_b: np.ndarray,\n    canvas: np.ndarray,\n    bg: int,\n    color: int,\n    previous_axis: str | None,\n) -> tuple[list[Coord], str]:\n    pairs: list[tuple[int, int, int, int, int]] = []\n    for a_raw in comp_a:\n        ar, ac = map(int, a_raw)\n        for b_raw in comp_b:\n            br, bc = map(int, b_raw)\n            pairs.append((abs(ar - br) + abs(ac - bc), ar, ac, br, bc))\n\n    pairs.sort()\n    for _dist, ar, ac, br, bc in pairs:\n        start = (ar, ac)\n        stop = (br, bc)\n        for first_axis in _axis_priority(start, stop, previous_axis):\n            path = _path_cells(start, stop, first_axis)\n            if _clear(path, canvas, bg, color):\n                return path, _last_axis(start, stop, first_axis)\n\n    raise AssertionError(f\"expected an unobstructed one-bend connector for color {color}\")\n\n\ndef _source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:\n    colors: list[int] = []\n    seen = {int(bg), int(wall)}\n    for raw in g.ravel():\n        color = int(raw)\n        if color not in seen:\n            seen.add(color)\n            colors.append(color)\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect same-colored foreground components with one-cell-wide orthogonal paths around teal wall segments.\n\n    Input structure\n    - The dominant color is the background.\n    - Teal cells are fixed wall segments and are never source connectors.\n    - Other foreground colors appear as one or more 4-connected components; colors with a single component stay unchanged.\n\n    Rule\n    - For each non-background, non-teal color, read its 4-connected components in row-major order.\n    - Connect each consecutive pair by the shortest clear L-shaped path between the two components.\n    - Clear paths may pass only through background or the same color, and they preserve the previous travel axis when both bends are possible.\n\n    Key insight\n    - The output is not a global recolor: each color traces a routed chain through its own components while teal cells and other colors act as blockers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    wall = Color.TEAL\n    assert np.any(g == wall), \"expected teal wall cells\"\n\n    out = g.copy()\n    connected_color_count = 0\n    for color in _source_colors(g, bg, wall):\n        comps = [\n            comp[\"coords\"]\n            for comp in find_components(\n                g,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(comps) < 2:\n            continue\n        if len(comps) == 2 and len(comps[0]) == 1 and len(comps[1]) == 1:\n            a = tuple(map(int, comps[0][0]))\n            b = tuple(map(int, comps[1][0]))\n            if a[0] != b[0] and a[1] != b[1]:\n                h_clear = _clear(_path_cells(a, b, \"h\"), g, bg, color)\n                v_clear = _clear(_path_cells(a, b, \"v\"), g, bg, color)\n                assert not (h_clear and v_clear), \"two diagonal singleton components need a blocking obstacle\"\n\n        connected_color_count += 1\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(comps, comps[1:]):\n            path, previous_axis = _connector_path(comp_a, comp_b, out, bg, color, previous_axis)\n            for r, c in path:\n                assert int(out[r, c]) in (bg, color), \"connector collision with another color\"\n                out[r, c] = color\n\n    assert connected_color_count > 0, \"expected at least one color with multiple components\"\n    return out\n\n# --------------- generator (c) ---------------\n\nBG = Color.BLUE\nWALL = Color.TEAL\n\n# Palette.\nN_COLORS = 10\nALL_COLORS = [c for c in range(N_COLORS) if c not in (BG, WALL)]\n\n# Canvas sizing.\nMIN_ROWS = 8\nMAX_ROWS = 12\nMIN_COLS = 10\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    n_connectable = random.randint(MIN_CONNECTABLE_COLORS, MAX_CONNECTABLE_COLORS)\n    H, W = _choose_grid_shape(n_connectable)\n    output = np.full((H, W), BG, dtype=int)\n\n    _place_walls(output)\n    connectable_colors, distractor_colors = _choose_palette(n_connectable)\n\n    all_path_cells = _place_connectable_chains(output, connectable_colors)\n    if all_path_cells is None or len(all_path_cells) > MAX_PATH_CELLS:\n        return None\n\n    if not _place_distractors(output, distractor_colors):\n        return None\n\n    inp = _erase_paths(output, all_path_cells)\n    if not (MIN_BG_PCT <= _input_bg_pct(inp) <= MAX_BG_PCT):\n        return None\n    if _gen_input_has_ambiguous_connector(inp):\n        return None\n    if _solver_matches_output(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    \"\"\"Generate a valid input grid for task f8f52ecc.\"\"\"\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '31,80p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py && sed -n '201,240p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '31,80p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py && sed -n '201,240p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '274,310p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && sed -n '449,560p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '274,310p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && sed -n '449,560p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '14,160p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py && sed -n '233,260p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '14,160p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py && sed -n '233,260p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    heights, colors, colored_counts = _sample_params(rng)\n    grid = _build_grid(heights, colors, colored_counts, BAR_INPUT_C0, output_mode=False)\n    expected = _build_grid(heights, colors, colored_counts, BAR_OUTPUT_C0, output_mode=True)\n\n    if get_bg(grid) != BG:\n        return None\n    if sorted(colors_present(grid, exclude=[BG, GREY])) != sorted(colors):\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input failed after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
