array | None:\n    try:\n        result = main(grid)\n        if np.array_equal(result, output):\n            return grid\n    except Exception:\n        pass\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    pairs, near_rows, near_cols = _choose_marker_pattern()\n\n    n_rects = random.randint(*RECT_COUNT_RANGE)\n    n_marked = n_rects - 1\n    palette = _choose_palette(n_rects)\n    if palette is None:\n        return None\n    plain_base, marker_color, marked_bases = palette\n\n    target_h = random.randint(*GRID_H_RANGE)\n    target_w = random.randint(*GRID_W_RANGE)\n    avail_h = target_h - 2 * BORDER_GAP\n    avail_w = target_w - 2 * BORDER_GAP\n\n    plain_shape = _choose_plain_shape(near_rows, near_cols, avail_h, avail_w)\n    if plain_shape is None:\n        return None\n    plain_h, plain_w = plain_shape\n    output = _make_marked_rect(plain_h, plain_w, plain_base, marker_color, pairs)\n\n    overlap_rects = _build_overlap_rects(\n        avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs\n    )\n    if overlap_rects is None:\n        return None\n    overlap_band_h = max(plain_h, *(rect.shape[0] for rect in overlap_rects))\n\n    non_overlap_rects = _build_non_overlap_rects(\n        n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs\n    )\n    if non_overlap_rects is None:\n        return None\n    non_overlap_bands = _pack_non_overlap_bands(non_overlap_rects, avail_w)\n\n    layout_shape = _choose_layout_shape(\n        target_h, target_w, plain_w, overlap_rects, overlap_band_h, non_overlap_bands\n    )\n    if layout_shape is None:\n        return None\n    actual_h, actual_w = layout_shape\n\n    overlap_items = _make_overlap_items(plain_h, plain_w, plain_base, overlap_rects, overlap_band_h)\n    if overlap_items is None:\n        return None\n    all_bands = [overlap_items] + _make_non_overlap_items(non_overlap_bands)\n\n    grid = _render_bands(actual_h, actual_w, all_bands)\n    if grid is None:\n        return None\n    return _accept_if_solver_matches(grid, output)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\nfrom collections import deque\n\ndef comps(mask):\n    H,W=mask.shape; seen=np.zeros_like(mask,bool); out=[]\n    for r,c in zip(*np.where(mask)):\n        if seen[r,c]: continue\n        q=[(r,c)]; seen[r,c]=1; cells=[]\n        for rr,cc in q:\n            cells.append((rr,cc))\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=rr+dr,cc+dc\n                if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:\n                    seen[nr,nc]=1; q.append((nr,nc))\n        out.append(cells)\n    return out\n\ndef conn(m): return len(comps(m))==1\n\ndef span(m): return m[0].any() and m[-1].any() and m[:,0].any() and m[:,-1].any()\n\ndef valid(m):\n    return m.any() and (~m).any() and conn(m) and conn(~m) and span(m) and span(~m)\n\ndef grow(h,w,area):\n    m=np.zeros((h,w),bool)\n    # start from random border anchors connected by manhattan paths\n    anchors=[(0,random.randrange(w)),(h-1,random.randrange(w)),(random.randrange(h),0),(random.randrange(h),w-1)]\n    r,c=anchors[0]; m[r,c]=1\n    for tr,tc in anchors[1:]:\n        while r\"'!=tr or c!=tc:\n            if r!=tr and (c==tc or random.random()<0.5): r += 1 if tr>r else -1\n            elif c!=tc: c += 1 if tc>c else -1\n            m[r,c]=1\n    while m.sum()<area:\n        front=[]\n        for r,c in zip(*np.where(m)):\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w and not m[nr,nc]: front.append((nr,nc))\n        if not front: break\n        r,c=random.choice(front); m[r,c]=1\n    return m\n\nfor dims in [(3,4),(4,4),(4,5),(5,5),(5,6),(6,6),(3,5),(4,6)]:\n    h,w=dims; ok=0\n    for _ in range(2000):\n        area=random.randint(max(2,h+w-2), h*w-max(2,h+w-2)) if h*w>=2*max(2,h+w-2) else random.randint(1,h*w-1)\n        m=grow(h,w,area)\n        if valid(m): ok+=1\n    print(dims, ok)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
