{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\ndef cycle_even_w(h,w):\n    coords=[]\n    for r in range(h): coords.append((r,0))\n    for c in range(1,w):\n        rows = range(h-1,0,-1) if c%2==1 else range(1,h)\n        for r in rows: coords.append((r,c))\n    for c in range(w-1,0,-1): coords.append((0,c))\n    # check\n    assert len(coords)==h*w and len(set(coords))==h*w\n    for (r,c),(rr,cc) in zip(coords, coords[1:]+coords[:1]):\n        assert abs(r-rr)+abs(c-cc)==1, ((r,c),(rr,cc),h,w)\n    return coords\n\ndef cycle(h,w):\n    if w%2==0:\n        return cycle_even_w(h,w)\n    assert h%2==0\n    return [(c,r) for r,c in cycle_even_w(w,h)]\n\ndef span(m): return m[0].any() and m[-1].any() and m[:,0].any() and m[:,-1].any()\nfor dims in [(3,4),(4,4),(4,5),(5,6),(6,6),(4,7),(7,4),(5,4)]:\n    h,w=dims; coords=cycle(h,w); n=h*w; ok=0\n    ex=None\n    for start in range(n):\n        for length in range(2,n-1):\n            m=np.zeros((h,w),bool)\n            for k in range(length):\n                r,c=coords[(start+k)%n]; m[r,c]=1\n            if span(m) and span(~m):\n                ok+=1; ex=m\n    print(dims, ok)\n    if ex is not None:\n        print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in ex), '\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
