{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, numpy as np\n\ndef conn(mask):\n    H,W=mask.shape\n    pts=list(zip(*np.where(mask)))\n    if not pts: return False\n    seen={pts[0]}; stack=[pts[0]]\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            p=(r+dr,c+dc)\n            if 0<=p[0]<H and 0<=p[1]<W and mask[p] and p not in seen:\n                seen.add(p); stack.append(p)\n    return len(seen)==len(pts)\n\ndef span(m): return m[0].any() and m[-1].any() and m[:,0].any() and m[:,-1].any()\ndef valid(m): return m.any() and (~m).any() and conn(m) and conn(~m) and span(m) and span(~m)\nfor h,w in [(3,3),(3,4),(4,4),(3,5)]:\n    found=0\n    for bits in range(1,1<<(h*w)-1):\n        m=np.array([(bits>>i)&1 for i in range(h*w)],bool).reshape(h,w)\n        if valid(m):\n            found+=1\n            if found<=3:\n                print('dims',h,w,'area',m.sum())\n                print('\\\\n'.join(''.join('#' if x else '.' for x in row) for row in m))\n                print()\n    print('total',h,w,found)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
