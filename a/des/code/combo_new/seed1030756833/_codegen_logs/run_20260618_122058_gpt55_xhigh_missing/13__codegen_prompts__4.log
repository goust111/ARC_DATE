{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint an inner border around the region reachable from a corner marker pixel.\n\n    Input structure:\n    - bg = most common color; wall color (blue) forms barriers dividing the grid.\n    - A unique single pixel (magenta) sits on one corner — the start marker.\n    - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.\n\n    Rule:\n    - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.\n    - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).\n    - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.\n\n    Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Marker pixel is a unique (count==1) non-bg pixel on a corner.\n    counts = Counter(int(v) for v in g.ravel())\n    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    marker = None\n    for r, c in corners:\n        v = int(g[r, c])\n        if v != bg and counts.get(v, 0) == 1:\n            marker = (r, c, v)\n            break\n    assert marker is not None, \"no unique single-pixel corner marker found\"\n\n    mr, mc, marker_col = marker\n\n    # Wall color: most frequent non-bg, non-marker color.\n    other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]\n    assert other_cols, \"no non-bg non-marker colors found; cannot determine wall color\"\n    wall_col = max(other_cols, key=lambda c: counts[c])\n\n    # First reach: treat all wall pixels as obstacles.\n    reach0 = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col),\n        h,\n        w,\n    )\n\n    # Structural walls are wall-color components that touch the border AND are adjacent to reach0.\n    walls: set[tuple[int, int]] = set()\n    for comp_arr in components_mask(g == wall_col, connectivity=4):\n        comp = [(int(r), int(c)) for r, c in comp_arr]\n        touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)\n        if not touches_border:\n            continue\n        adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)\n        if adjacent_to_reach0:\n            walls |= set(comp)\n\n    # Second reach: allow passing through non-wall wall-color pixels (decorations) so they don't create borders.\n    reach = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col) or (int(g[r, c]) == wall_col and (r, c) not in walls),\n        h,\n        w,\n    )\n\n    # Remove wall-colored decorations that are not reachable (they lie behind structural walls).\n    for r in range(h):\n        for c in range(w):\n            if int(out[r, c]) == wall_col and (r, c) not in walls and (r, c) not in reach:\n                out[r, c] = bg\n\n    fill_col = 7\n    # Paint a 1-cell-thick inner border of the reachable region (on background cells only).\n    for r, c in reach:\n        if int(out[r, c]) != bg:\n            continue\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) in walls for nr, nc in neighbors8(r, c)):\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) not in reach for nr, nc in neighbors4(r, c)):\n            out[r, c] = fill_col\n\n    return out\n\n# --------------- generator (merged (attempts 1+2 hybrid)) ---------------\n\n# ---- Palette (task colors) ----\nBG = 8\nWALL = 1\nMARKER = 6\nFILL = 7\n\n# ---- Canvas size ----\nGRID_H_RANGE = (10, 20)\nGRID_W_RANGE = (10, 20)\n\n# ---- Structural walls ----\nNUM_STRUCTS_RANGE = (1, 4)\nSTRUCT_SHAPE_RETRIES = 8             # per-shape placement retries\nRECT_MAX_DIM_DIV = 3                 # rect max side ~ dim // 3\nTRI_MAX_SIZE = 6                     # diamond/triangle cap on size\nTRI_MIN_DIM_DIV = 3                  # diamond/top-tri need dim // 3\n\n# ---- Reachable region gate ----\nREACH_RATIO_RANGE = (0.38, 0.87)\n\n# ---- Decorations ----\nNUM_DECOR_RANGE = (0, 3)\nDECOR_AREA_RANGE = (1, 4)            # max pixel-extent of a single decor patch\nDECOR_BORDER = 1                     # stay >= N cells from grid edge\nDECOR_PADDING = 1                    # 8-conn separation from other occupancy\n\n# ---- Outer retry budget ----\nGEN_ATTEMPTS = 300\n\n\n# =============================================================================\n# Shape factories (each returns list[(r,c)] or None for a 4-contiguous shape\n# that touches at least one grid edge).\n# =============================================================================\n\ndef _shape_vertical_line(h, w, rng):\n    c = rng.randint(2, w - 2)\n    mode = rng.choice(['top', 'bottom', 'full'])\n    if mode == 'full':\n        r0, r1 = 0, h - 1\n    elif mode == 'top':\n        r0, r1 = 0, rng.randint(max(1, h // 3), h - 2)\n    else:\n        r0, r1 = rng.randint(1, h - max(2, h // 3)), h - 1\n    return [(r, c) for r in range(r0, r1 + 1)]\n\n\ndef _shape_horizontal_line(h, w, rng):\n    r = rng.randint(1, h - 2)\n    if rng.choice(['left', 'right']) == 'left':\n        c0, c1 = 0, rng.randint(max(1, w // 3), w - 2)\n    else:\n        c0, c1 = rng.randint(1, w - max(2, w // 3)), w - 1\n    return [(r, c) for c in range(c0, c1 + 1)]\n\n\ndef _shape_rectangle(h, w, rng):\n    rh = rng.randint(2, max(2, h // RECT_MAX_DIM_DIV))\n    rw = rng.randint(2, max(2, w // RECT_MAX_DIM_DIV))\n    anchor = rng.choice(['top', 'right', 'tr', 'top_mid', 'right_mid', 'bottom_right'])\n    if anchor == 'top':\n        r0, c0 = 0, rng.randint(1, max(1, w - rw - 1))\n    elif anchor == 'right':\n        r0, c0 = rng.randint(1, max(1, h - rh - 1)), w - rw\n    elif anchor == 'tr':\n        r0, c0 = 0, w - rw\n    elif anchor == 'top_mid':\n        r0, c0 = 0, rng.randint(2, max(2, w - rw - 2))\n    elif anchor == 'right_mid':\n        r0, c0 = rng.randint(2, max(2, h - rh - 2)), w - rw\n    else:\n        r0, c0 = h - rh, w - rw\n    return [(r, c) for r in range(r0, r0 + rh) for c in range(c0, c0 + rw)]\n\n\ndef _shape_left_diamond(h, w, rng):\n    \"\"\"Isoceles diamond attached to left edge.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 3:\n        return None\n    size = rng.randint(3, max_size)\n    r_center = rng.randint(size, h - size - 1)\n    top = r_center - (size - 1)\n    cells = []\n    for i in range(size):\n        cells.extend((top + i, c) for c in range(i + 1))\n    for i in range(size - 1):\n        cells.extend((top + size + i, c) for c in range(size - 1 - i))\n    return cells\n\n\ndef _shape_top_triangle(h, w, rng):\n    \"\"\"Right triangle on top edge, widest at top.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    c_start = rng.randint(1, max(1, w - 2 * size))\n    cells = []\n    for i in range(size):\n        cells.extend((i, c) for c in range(c_start, c_start + size - i))\n    return cells\n\n\ndef _shape_right_triangle(h, w, rng):\n    \"\"\"Right triangle on right edge, widest at bottom.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // 2, w // 2)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    r_start = rng.randint(0, max(0, h - size - 1))\n    cells = []\n    for i in range(size):\n        length = i + 1\n        cells.extend((r_start + i, c) for c in range(w - length, w))\n    return cells\n\n\nSHAPE_FACTORIES = [\n    _shape_vertical_line,\n    _shape_horizontal_line,\n    _shape_rectangle,\n    _shape_left_diamond,\n    _shape_top_triangle,\n    _shape_right_triangle,\n]\n\n\n# =============================================================================\n# Primitives\n# =============================================================================\n\ndef _flood_mask(start, blocked, h, w):\n    \"\"\"BFS from `start` on the ~blocked bool grid; return reach as (h,w) bool array.\"\"\"\n    reach = np.zeros((h, w), dtype=bool)\n    reach[start] = True\n    q = deque([start])\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and not reach[nr, nc] and not blocked[nr, nc]:\n                reach[nr, nc] = True\n                q.append((nr, nc))\n    return reach\n\n\ndef _touches_border(mask):\n    return mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any()\n\n\ndef _dilate4(mask):\n    \"\"\"4-connected dilation by 1 via boolean slicing.\"\"\"\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    return out\n\n\ndef _dilate8(mask):\n    \"\"\"8-connected dilation by 1 via 4-conn dilation of a 4-conn dilation.\"\"\"\n    m = _dilate4(mask)\n    # add diagonals\n    m[1:, 1:] |= mask[:-1, :-1]\n    m[1:, :-1] |= mask[:-1, 1:]\n    m[:-1, 1:] |= mask[1:, :-1]\n    m[:-1, :-1] |= mask[1:, 1:]\n    return m\n\n\n# =============================================================================\n# Layout construction\n# =============================================================================\n\ndef _place_structural_walls(h, w, marker_rc, rng):\n    \"\"\"Place 1..NUM_STRUCTS_RANGE non-overlapping shapes; skip any that cover marker.\"\"\"\n    num = rng.randint(*NUM_STRUCTS_RANGE)\n    structural = np.zeros((h, w), dtype=bool)\n    placed = 0\n    for _ in range(num):\n        for _try in range(STRUCT_SHAPE_RETRIES):\n            cells = rng.choice(SHAPE_FACTORIES)(h, w, rng)\n            if not cells:\n                continue\n            if marker_rc in cells or any(structural[r, c] for r, c in cells):\n                continue\n            for r, c in cells:\n                structural[r, c] = True\n            placed += 1\n            break\n    return structural if placed > 0 else None\n\n\ndef _validate_structural(structural, reach, h, w):\n    \"\"\"Every 4-conn structural component must touch a border AND be 4-adj to reach;\n    this mirrors how the solver re-identifies structural walls.\"\"\"\n    reach_nbr = _dilate4(reach)\n    for comp_arr in components_mask(structural, connectivity=4):\n        cmask = np.zeros((h, w), dtype=bool)\n        cmask[comp_arr[:, 0], comp_arr[:, 1]] = True\n        if not _touches_border(cmask):\n            return False\n        if not (cmask & reach_nbr).any():\n            return False\n    return True\n\n\ndef _paint_output(structural, reach, marker_rc):\n    \"\"\"Build solver-style output: BG / WALL / MARKER / FILL.\"\"\"\n    h, w = structural.shape\n    out = np.full((h, w), BG, dtype=int)\n    out[structural] = WALL\n    out[marker_rc] = MARKER\n\n    # Cells eligible to become FILL: reachable BG interior.\n    candidate = reach & (out == BG)\n\n    # On grid edge.\n    edge = np.zeros_like(candidate)\n    edge[0, :] = edge[-1, :] = True\n    edge[:, 0] = edge[:, -1] = True\n\n    # 8-adjacent to a structural wall.\n    near_struct = _dilate8(structural)\n\n    # 4-adjacent to an unreachable cell.\n    near_unreach = _dilate4(~reach)\n\n    fill = candidate & (edge | near_struct | near_unreach)\n    out[fill] = FILL\n    return out\n\n\ndef _place_decor(allowed_mask, count, rng):\n    \"\"\"Place `count` decoration patches in `allowed_mask` cells.\n\n    Enforces border>=DECOR_BORDER and padding=DECOR_PADDING (8-conn) so each\n    patch stays isolated. Returns a bool mask, or None if any patch fails.\n    \"\"\"\n    h, w = allowed_mask.shape\n    placed = np.zeros((h, w), dtype=bool)\n    if count == 0:\n        return placed\n    for _ in range(count):\n        area = rng.randint(*DECOR_AREA_RANGE)\n        shapes = [(1, area), (area, 1)]\n        if area >= 3:\n            shapes.append((2, 2))\n        rng.shuffle(shapes)\n        for ph, pw in shapes:\n            if ph > h or pw > w:\n                continue\n            patch = np.ones((ph, pw), dtype=int)\n            canvas = np.where(allowed_mask & ~placed, 0, 9)\n            try:\n                r0, c0 = random_free_location(\n                    canvas, patch, transparent=0,\n                    border=DECOR_BORDER, padding=DECOR_PADDING, padding_connectivity=8,\n                )\n            except ValueError:\n                continue\n            placed[r0:r0 + ph, c0:c0 + pw] = True\n            break\n        else:\n            return None\n    return placed\n\n\n# =============================================================================\n# Main attempt\n# =============================================================================\n\ndef _gen_attempt():\n    rng = random\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    marker_rc = (h - 1, 0)\n\n    structural = _place_structural_walls(h, w, marker_rc, rng)\n    if structural is None or structural[marker_rc]:\n        return None\n\n    reach = _flood_mask(marker_rc, structural, h, w)\n    reach_frac = reach.mean()\n    if not (REACH_RATIO_RANGE[0] <= reach_frac <= REACH_RATIO_RANGE[1]):\n        return None\n\n    if not _validate_structural(structural, reach, h, w):\n        return None\n\n    out = _paint_output(structural, reach, marker_rc)\n\n    # FILL must form a single 4-connected ring (task-semantic invariant).\n    fill_mask = (out == FILL)\n    if not fill_mask.any() or len(components_mask(fill_mask, connectivity=4)) != 1:\n        return None\n\n    # Decorations: visible (inside reach, kept as WALL in output) vs hidden\n    # (outside reach, erased to BG in output — input-only).\n    n_decor = rng.randint(*NUM_DECOR_RANGE)\n    n_visible = rng.randint(0, n_decor)\n    n_hidden = n_decor - n_visible\n\n    visible_allowed = reach & (out == BG)\n    hidden_allowed = (~reach) & (~structural)\n    # Border-touching decor would be misread as structural by solver.\n    hidden_allowed[0, :] = hidden_allowed[-1, :] = False\n    hidden_allowed[:, 0] = hidden_allowed[:, -1] = False\n\n    visible_placed = _place_decor(visible_allowed, n_visible, rng)\n    if visible_placed is None:\n        return None\n    hidden_placed = _place_decor(hidden_allowed, n_hidden, rng)\n    if hidden_placed is None:\n        return None\n\n    out_final = out.copy()\n    out_final[visible_placed] = WALL\n\n    inp = out_final.copy()\n    inp[inp == FILL] = BG\n    inp[hidden_placed] = WALL\n\n    if not np.array_equal(main(inp), out_final):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        try:\n            g = _gen_attempt()\n        except Exception:\n            g = None\n        if g is not None:\n            return g\n    raise RuntimeError(\"failed to generate valid input for 8f3a5a89\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"前四个参考题主要用了“先构造再用 main 反验”的生成器模式，也会在生成阶段显式避免对象粘连和角色歧义。我接着读剩余参考文件，重点看矩形框、方向和外部标记的处理。"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n        cells = {(c, r) for r, c in cells}\n    return _flip(cells)\n\n\ndef _wide_body(area):\n    width = random.randint(_BODY_WIDTH_RANGE[0], min(_BODY_WIDTH_RANGE[1], area - 1))\n    height = random.choice([h for h in _inclusive_range(_BODY_HEIGHT_RANGE) if h * width >= area])\n    cells = {(0, c) for c in range(width)}\n    cells.add((1, random.randrange(width)))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, height, width)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _frame_body(area):\n    choices = []\n    for h in _inclusive_range(_FRAME_HEIGHT_RANGE):\n        for w in _inclusive_range(_FRAME_WIDTH_RANGE):\n            perim = 2 * h + 2 * w - 4\n            removable = 2 * max(0, h - 2) + 2 * max(0, w - 2)\n            if perim >= area and perim - area <= min(_FRAME_MAX_GAP, removable):\n                choices.append((h, w))\n    if not choices:\n        return _grow_body(area)\n\n    h, w = random.choice(choices)\n    cells = {\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    }\n    gap = len(cells) - area\n    if gap:\n        removable = [\n            (r, c)\n            for r, c in cells\n            if not (r in (0, h - 1) and c in (0, w - 1))\n        ]\n        for cell in random.sample(removable, gap):\n            cells.remove(cell)\n    return _flip(cells)\n\n\ndef _make_body(area):\n    x = random.random()\n    if area >= _FRAME_MIN_AREA and x < _FRAME_BODY_THRESHOLD:\n        return _frame_body(area)\n    if x < _WIDE_BODY_THRESHOLD:\n        return _wide_body(area)\n    if x < _SYMMETRIC_BODY_THRESHOLD:\n        return _symmetric_body(area)\n    return _grow_body(area)\n\n\ndef _marker_cell(body):\n    r0, c0, r1, c1 = _bbox(body)\n    interior, exterior = set(), set()\n    for r, c in body:\n        for dr, dc in _NEIGHBORS4:\n            p = (r + dr, c + dc)\n            if p in body:\n                continue\n            if r0 <= p[0] <= r1 and c0 <= p[1] <= c1:\n                interior.add(p)\n            else:\n                exterior.add(p)\n    pool = list(interior if interior and random.random() < _MARKER_INTERIOR_PROB else (exterior | interior))\n    return random.choice(pool)\n\n\ndef _make_sprite(area, body_color, marker_color, bg):\n    body = _make_body(area)\n    marker = _marker_cell(body)\n    all_cells = set(body) | {marker}\n    r0, c0, r1, c1 = _bbox(all_cells)\n    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n    for r, c in body:\n        patch[r - r0, c - c0] = int(body_color)\n    patch[marker[0] - r0, marker[1] - c0] = int(marker_color)\n    return {\"patch\": patch, \"offset\": (marker[0] - r0, marker[1] - c0)}\n\n\ndef _top_left(sprite, marker_r, marker_c):\n    off_r, off_c = sprite[\"offset\"]\n    return int(marker_r) - int(off_r), int(marker_c) - int(off_c)\n\n\ndef _can_place(canvas, sprite, marker_r, marker_c, bg):\n    patch = sprite[\"patch\"]\n    top, left = _top_left(sprite, marker_r, marker_c)\n    h, w = patch.shape\n    H, W = canvas.shape\n    if top < _INNER_BORDER_GAP or left < _INNER_BORDER_GAP:\n        return False\n    if top + h > H - _INNER_BORDER_GAP or left + w > W - _INNER_BORDER_GAP:\n        return False\n    mask = patch != int(bg)\n    view = canvas[top : top + h, left : left + w]\n    if bool((view[mask] != int(bg)).any()):\n        return False\n    return not _touches_foreground(canvas, mask, top, left, bg)\n\n\ndef _touches_foreground(canvas, mask, top, left, bg):\n    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n    h, w = mask.shape\n    radius = _ISOLATION_RADIUS\n    occupied = canvas[top - radius : top + h + radius, left - radius : left + w + radius] != int(bg)\n    touch_zone = np.zeros((h + 2 * radius, w + 2 * radius), dtype=bool)\n    span = 2 * radius + 1\n    for dr in range(span):\n        for dc in range(span):\n            touch_zone[dr : dr + h, dc : dc + w] |= mask\n    return bool((occupied & touch_zone).any())\n\n\ndef _place(canvas, sprite, marker_r, marker_c, bg):\n    top, left = _top_left(sprite, marker_r, marker_c)\n    paste(canvas, sprite[\"patch\"], top, left, transparent=int(bg))\n\n\ndef _anchor_ok(canvas, r, c, bg):\n    H, W = canvas.shape\n    if not (r in (0, H - 1) or c in (0, W - 1)):\n        return False\n    if r in (0, H - 1) and c in (0, W - 1):\n        return False\n    return _isolated_bg_cell(canvas, r, c, bg)\n\n\ndef _isolated_bg_cell(canvas, r, c, bg):\n    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n    H, W = canvas.shape\n    radius = _ISOLATION_RADIUS\n    r0, r1 = max(0, r - radius), min(H, r + radius + 1)\n    c0, c1 = max(0, c - radius), min(W, c + radius + 1)\n    return not bool((canvas[r0:r1, c0:c1] != int(bg)).any())\n\n\ndef _anchor_candidates(canvas, bg):\n    H, W = canvas.shape\n    rows = list(range(_ANCHOR_EDGE_MARGIN, H - _ANCHOR_EDGE_MARGIN))\n    rows = rows or list(range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP))\n    cols = list(range(_ANCHOR_EDGE_MARGIN, W - _ANCHOR_EDGE_MARGIN))\n    cols = cols or list(range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP))\n    out = []\n    for c in cols:\n        out.append((\"h\", 0, c))\n        out.append((\"h\", H - 1, c))\n    for r in rows:\n        out.append((\"v\", r, 0))\n        out.append((\"v\", r, W - 1))\n    random.shuffle(out)\n    return [(axis, r, c) for axis, r, c in out if _anchor_ok(canvas, r, c, bg)]\n\n\ndef _put_anchor(canvas, r, c, color):\n    paste(canvas, np.array([[int(color)]], dtype=int), int(r), int(c))\n\n\ndef _aligned_positions(canvas, sprite, anchor, bg):\n    H, W = canvas.shape\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (r, anchor[\"c\"])\n            for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n            if _can_place(canvas, sprite, r, anchor[\"c\"], bg)\n        ]\n    return [\n        (anchor[\"r\"], c)\n        for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n        if _can_place(canvas, sprite, anchor[\"r\"], c, bg)\n    ]\n\n\ndef _scatter_positions(canvas, sprite, anchor, marker, bg):\n    H, W = canvas.shape\n    mr, mc = marker\n    if anchor[\"axis\"] == \"h\":\n        return [\n            (mr, c)\n            for c in range(_INNER_BORDER_GAP, W - _INNER_BORDER_GAP)\n            if c != mc and _can_place(canvas, sprite, mr, c, bg)\n        ]\n    return [\n        (r, mc)\n        for r in range(_INNER_BORDER_GAP, H - _INNER_BORDER_GAP)\n        if r != mr and _can_place(canvas, sprite, r, mc, bg)\n    ]\n\n\ndef _body_color(bg, marker, used):\n    pool = [c for c in _COLORS if c not in {int(bg), int(marker)} and c not in used]\n    if not pool:\n        pool = [c for c in _COLORS if c not in {int(bg), int(marker)}]\n    return random.choice(pool)\n\n\ndef _bg_is_mode(grid, bg):\n    counts = Counter(map(int, grid.ravel()))\n    return counts[int(bg)] > max((n for c, n in counts.items() if c != int(bg)), default=0)\n\n\ndef _add_distractors(out, inp, anchors, bg):\n    vertical = [a for a in anchors if a[\"axis\"] == \"v\"]\n    if not vertical or random.random() >= _DISTRACTOR_PROB:\n        return\n    anchor = random.choice(vertical)\n    sprite = {\"patch\": np.array([[anchor[\"color\"]]], dtype=int), \"offset\": (0, 0)}\n    for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n        pairs = []\n        for c in range(_INNER_BORDER_GAP, out.shape[1] - _INNER_BORDER_GAP):\n            if not _can_place(out, sprite, anchor[\"r\"], c, bg):\n                continue\n            for r in range(_INNER_BORDER_GAP, out.shape[0] - _INNER_BORDER_GAP):\n                if r != anchor[\"r\"] and _can_place(inp, sprite, r, c, bg):\n                    pairs.append((r, c))\n        if not pairs:\n            return\n        in_r, col = random.choice(pairs)\n        _place(out, sprite, anchor[\"r\"], col, bg)\n        _place(inp, sprite, in_r, col, bg)\n\n\ndef _gen_attempt():\n    bg, out, inp = _new_canvas_pair()\n    placed = _place_anchors(out, inp, bg)\n    if placed is None:\n        return None\n    anchor_colors, anchors = placed\n\n    marker_colors = _marker_color_sequence(anchor_colors)\n    sprites = _place_aligned_sprites(out, anchors, marker_colors, bg)\n    if sprites is None:\n        return None\n\n    if not _scatter_sprites(inp, sprites, bg):\n        return None\n\n    _add_distractors(out, inp, anchors, bg)\n    if not _generated_grid_is_valid(inp, out, bg):\n        return None\n    return inp\n\n\ndef _new_canvas_pair():\n    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n    H = random.randint(*_GRID_HEIGHT_RANGE)\n    W = random.randint(*_GRID_WIDTH_RANGE)\n    bg = random.randint(*_BG_COLOR_RANGE)\n    out = np.full((H, W), int(bg), dtype=int)\n    inp = np.full((H, W), int(bg), dtype=int)\n    return bg, out, inp\n\n\ndef _place_anchors(out, inp, bg):\n    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n    anchor_colors = random.sample([c for c in _COLORS if c != bg], random.randint(*_ANCHOR_COUNT_RANGE))\n    anchors = []\n    for color in anchor_colors:\n        candidates = _anchor_candidates(out, bg)\n        if not candidates:\n            return None\n        axis, r, c = random.choice(candidates)\n        anchor = {\"color\": int(color), \"r\": int(r), \"c\": int(c), \"axis\": axis}\n        anchors.append(anchor)\n        _put_anchor(out, r, c, color)\n        _put_anchor(inp, r, c, color)\n    return anchor_colors, anchors\n\n\ndef _marker_color_sequence(anchor_colors):\n    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n    n_sprites = random.randint(*_SPRITE_COUNT_RANGE)\n    marker_colors = anchor_colors[:]\n    while len(marker_colors) < n_sprites:\n        marker_colors.append(random.choice(anchor_colors))\n    random.shuffle(marker_colors)\n    return marker_colors\n\n\ndef _place_aligned_sprites(out, anchors, marker_colors, bg):\n    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n    by_color = {a[\"color\"]: a for a in anchors}\n    used_body = set()\n    sprites = []\n    for marker in marker_colors:\n        anchor = by_color[int(marker)]\n        body = _body_color(bg, marker, used_body)\n        used_body.add(body)\n        sprite = _make_sprite(random.randint(*_BODY_AREA_RANGE), body, marker, bg)\n        positions = _aligned_positions(out, sprite, anchor, bg)\n        if not positions:\n            return None\n        marker_pos = random.choice(positions)\n        _place(out, sprite, marker_pos[0], marker_pos[1], bg)\n        sprites.append((sprite, anchor, marker_pos))\n    return sprites\n\n\ndef _scatter_sprites(inp, sprites, bg):\n    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n    random.shuffle(sprites)\n    for sprite, anchor, marker_pos in sprites:\n        positions = _scatter_positions(inp, sprite, anchor, marker_pos, bg)\n        if not positions:\n            return False\n        in_pos = random.choice(positions)\n        _place(inp, sprite, in_pos[0], in_pos[1], bg)\n    return True\n\n\ndef _generated_grid_is_valid(inp, out, bg):\n    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n    if not _bg_is_mode(inp, bg):\n        return False\n    return bool(np.array_equal(main(inp), out))\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/eval/a6f40cea.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete partial paths inside a framed rectangle by projecting external color traces inward.\n\n    Input structure:\n    - bg, a 1px rectangular frame (border color) with uniform interior fill.\n    - Colored components outside the frame touching its edges.\n\n    Rule:\n    - Output = the frame's interior, filled with the fill color.\n    - Map each outside component's frame-touch points into interior coordinates.\n    - Monochrome components become solid Manhattan stripes between mapped endpoints.\n    - Two-color components become alternating-color Manhattan paths.\n\n    Key insight: Endpoint colors of two-color traces anchor the alternating phase deterministically.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    found = _find_framed_rect_uniform_fill(g, bg=int(bg))\n    assert not (found is None)\n    r0, c0, r1, c1, bc, fill = found\n    outH = int(r1 - r0 - 1)\n    outW = int(c1 - c0 - 1)\n    out = np.full((outH, outW), int(fill), dtype=int)\n    r_int0 = int(r0 + 1)\n    c_int0 = int(c0 + 1)\n\n    def map_to_out(rr: int, cc: int) -> tuple[int, int]:\n        r = max(0, min(outH - 1, int(rr - r_int0)))\n        c = max(0, min(outW - 1, int(cc - c_int0)))\n        return int(r), int(c)\n\n    def build_manhattan(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> list[tuple[int, int]]:\n        (ra, ca), (rb, cb) = p1, p2\n        if ra == rb:\n            step = 1 if cb >= ca else -1\n            return [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n        if ca == cb:\n            step = 1 if rb >= ra else -1\n            return [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n        if cornerA:\n            step = 1 if rb >= ra else -1\n            path = [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]\n            step = 1 if cb >= ca else -1\n            path += [(int(rb), int(c)) for c in range(int(ca) + step, int(cb) + step, step)]\n            return path\n        step = 1 if cb >= ca else -1\n        path = [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]\n        step = 1 if rb >= ra else -1\n        path += [(int(r), int(cb)) for r in range(int(ra) + step, int(rb) + step, step)]\n        return path\n\n    def inside_corner(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> bool:\n        (ra, ca), (rb, cb) = p1, p2\n        if ra == rb or ca == cb:\n            return True\n        corner = (rb, ca) if cornerA else (ra, cb)\n        rr, cc = corner\n        return (0 < rr < outH - 1) and (0 < cc < outW - 1)\n\n    # --- ring components (outside the frame) ---\n    comp_mask = (g != int(bg)) & (g != int(fill)) & (g != int(bc))\n    clab, cn = label(comp_mask, structure=STRUCT4)\n\n    ring = set()\n    for cc in range(c0, c1 + 1):\n        for rr in (r0 - 1, r1 + 1):\n            if 0 <= rr < H:\n                ring.add((int(rr), int(cc)))\n    for rr in range(r0, r1 + 1):\n        for cc in (c0 - 1, c1 + 1):\n            if 0 <= cc < W:\n                ring.add((int(rr), int(cc)))\n\n    # cid -> list of (mapped_r, mapped_c, color)\n    comp_pts: dict[int, list[tuple[int, int, int]]] = defaultdict(list)\n    for rr, cc in ring:\n        cid = int(clab[rr, cc])\n        if cid == 0:\n            continue\n        col = int(g[rr, cc])\n        mr, mc = map_to_out(rr, cc)\n        comp_pts[cid].append((mr, mc, col))\n\n    # per-component color sets\n    comp_cols: dict[int, list[int]] = {}\n    for cid in range(1, int(cn) + 1):\n        comp_cols[cid] = sorted(set(map(int, g[clab == int(cid)].flatten())))\n\n    deferred: dict[int, set[tuple[int, int]]] = defaultdict(set)\n\n    for cid, pts in comp_pts.items():\n        if len(pts) < 2:\n            continue\n        cols = comp_cols.get(cid, [])\n        if not cols:\n            continue\n\n        # build per-coordinate color histogram (clamp can merge multiple ring pixels)\n        hist: dict[tuple[int, int], Counter] = defaultdict(Counter)\n        for r, c, col in pts:\n            hist[(int(r), int(c))][int(col)] += 1\n\n        coords = list(hist.keys())\n\n        if len(cols) == 1:\n            colv = int(cols[0])\n            uniq = coords\n            rows = {r for r, _c in uniq}\n            cols2 = {c for _r, c in uniq}\n            if len(rows) == 1 or len(cols2) == 1:\n                for p in uniq:\n                    deferred[colv].add((int(p[0]), int(p[1])))\n                continue\n\n            # Connect farthest pair by a Manhattan path.\n            best = None\n            for i in range(len(uniq)):\n                for j in range(i + 1, len(uniq)):\n                    d = abs(uniq[i][0] - uniq[j][0]) + abs(uniq[i][1] - uniq[j][1])\n                    if best is None or d > best[0]:\n                        best = (d, uniq[i], uniq[j])\n            if best is None:\n                continue\n            _d, p1, p2 = best\n            pathA = build_manhattan(p1, p2, True)\n            pathB = build_manhattan(p1, p2, False)\n            chosen = pathB if (inside_corner(p1, p2, False) and not inside_corner(p1, p2, True)) else pathA\n            for rr, cc in chosen:\n                out[int(rr), int(cc)] = int(colv)\n            continue\n\n        if len(cols) == 2:\n            # Choose farthest pair in mapped space.\n            best = None\n            for i in range(len(coords)):\n                for j in range(i + 1, len(coords)):\n                    d = abs(coords[i][0] - coords[j][0]) + abs(coords[i][1] - coords[j][1])\n                    if best is None or d > best[0]:\n                        best = (d, coords[i], coords[j])\n            if best is None:\n                continue\n            _d, a, b = best\n            # Component's two colors (alternation palette).\n            ca, cb = map(int, cols)\n            # Endpoint color hints from ring-touch pixels (can be same on both ends).\n            ha = int(hist[a].most_common(1)[0][0])\n            hb = int(hist[b].most_common(1)[0][0])\n\n            # Pick a Manhattan path (prefer elbow inside the interior).\n            pathA = build_manhattan(a, b, True)\n            pathB = build_manhattan(a, b, False)\n            path = pathB if (inside_corner(a, b, False) and not inside_corner(a, b, True)) else pathA\n\n            def paint_alt(path_pts: list[tuple[int, int]], start_color: int):\n                cur = int(start_color)\n                for rr, cc in path_pts:\n                    out[int(rr), int(cc)] = int(cur)\n                    cur = int(cb) if cur == int(ca) else int(ca)\n\n            # Determine phase by constraining endpoint colors (from ring-touch hints).\n            chosen = None  # (path_pts, start_color)\n            for path_pts in (path, list(reversed(path))):\n                for start_color in (ca, cb):\n                    end_color = start_color if ((len(path_pts) - 1) % 2 == 0) else (cb if start_color == ca else ca)\n                    if int(start_color) != int(ha):\n                        continue\n                    if int(end_color) != int(hb):\n                        continue\n                    chosen = (path_pts, int(start_color))\n                    break\n                if chosen is not None:\n                    break\n\n            assert chosen is not None\n\n            path_pts, start_color = chosen\n            paint_alt(path_pts, start_color)\n            continue\n\n    # Aggregate deferred monochrome points by color into stripes/segments.\n    for col, pts in deferred.items():\n        pts = list(pts)\n        if not pts:\n            continue\n        tops = [p for p in pts if p[0] == 0]\n        bots = [p for p in pts if p[0] == outH - 1]\n        if tops and bots:\n            for cc in sorted({c for _r, c in pts}):\n                rs = [r for r, c in pts if c == cc]\n                for rr in range(min(rs), max(rs) + 1):\n                    out[int(rr), int(cc)] = int(col)\n            continue\n        lefts = [p for p in pts if p[1] == 0]\n        rights = [p for p in pts if p[1] == outW - 1]\n        if lefts and rights:\n            for rr in sorted({r for r, _c in pts}):\n                cs = [c for r, c in pts if r == rr]\n                for cc in range(min(cs), max(cs) + 1):\n                    out[int(rr), int(cc)] = int(col)\n            continue\n        if len(pts) == 1:\n            rr, cc = pts[0]\n            out[int(rr), int(cc)] = int(col)\n            continue\n        best = None\n        for i in range(len(pts)):\n            for j in range(i + 1, len(pts)):\n                d = abs(pts[i][0] - pts[j][0]) + abs(pts[i][1] - pts[j][1])\n                if best is None or d > best[0]:\n                    best = (d, pts[i], pts[j])\n        if best is None:\n            continue\n        _d, p1, p2 = best\n        pathA = build_manhattan(p1, p2, True)\n        pathB = build_manhattan(p1, p2, False)\n        chosen = pathB if (inside_corner(p1, p2, False) and not inside_corner(p1, p2, True)) else pathA\n        for rr, cc in chosen:\n            out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (a6) ---------------\nfrom arc_utils import neighbors4\n\n# --- CFG: tunable generation parameters ---\n_BORDER_COLOR = 3                       # frame border color (always green)\n_BG_CHOICES = [0, 1, 2, 4, 5, 6, 7, 8, 9]  # candidate background colors (excludes bc)\n_FILL_EQ_BG_PROB = 0.6                  # probability that interior fill == bg\n_INTERIOR_H_RANGE = (4, 13)             # interior height bounds\n_INTERIOR_W_RANGE = (7, 14)             # interior width bounds\n_GRID_SIZE_RANGE = (20, 30)             # overall grid dimension bounds\n_GRID_INTERIOR_PAD = 10                 # min excess of grid dim over interior dim\n_FRAME_MARGIN = 4                       # min cells from frame edge to grid edge\n_FRAME_MARGIN_FAR = 6                   # min cells from far frame edge to grid edge\n_OUTER_OFFSET_RANGE = (2, 3)            # how far the open-rect corner extends from frame\n_N_COMPONENTS_RANGE = (2, 3)            # number of ring-touching components\n_U_PAIR_PROB = 0.25                     # probability of generating a U-pair (uses 2 slots)\n_DUAL_COLOR_PROB = 0.45                 # probability that an L-component is 2-color alternating\n_DISTRACTOR_COUNT_RANGE = (0, 2)        # range for number of distractors\n_DISTRACTOR_SIZE_RANGE = (1, 4)         # per-distractor cell count range\n_DISTRACTOR_TRIES = 40                  # placement attempts per distractor\n_DISTRACTOR_CLEARANCE = 2              # min gap between distractor and frame\n_GEN_RETRIES = 300                      # max attempts in generate_input()\n\n\ndef _line(a: int, b: int) -> range:\n    \"\"\"Inclusive range from a to b.\"\"\"\n    step = 1 if b >= a else -1\n    return range(a, b + step, step)\n\n\ndef _vpath(r0: int, r1: int, c: int) -> list[tuple[int, int]]:\n    \"\"\"Vertical segment from (r0, c) to (r1, c) inclusive.\"\"\"\n    return [(r, c) for r in _line(r0, r1)]\n\n\ndef _hpath(r: int, c0: int, c1: int) -> list[tuple[int, int]]:\n    \"\"\"Horizontal segment from (r, c0) to (r, c1) inclusive.\"\"\"\n    return [(r, c) for c in _line(c0, c1)]\n\n\ndef _join(*parts: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"Concatenate path segments, deduplicating shared endpoints.\"\"\"\n    out: list[tuple[int, int]] = []\n    for part in parts:\n        for p in part:\n            if not out or out[-1] != p:\n                out.append(p)\n    return out\n\n\ndef _paint_path(grid: np.ndarray, path: list[tuple[int, int]], colors: tuple[int, ...]) -> None:\n    \"\"\"Paint a path with solid or alternating colors.\"\"\"\n    if not path:\n        return\n    rs, cs = zip(*path)\n    if len(colors) == 1:\n        grid[rs, cs] = colors[0]\n    else:\n        a, b = colors\n        vals = [a if i % 2 == 0 else b for i in range(len(path))]\n        grid[rs, cs] = vals\n\n\ndef _can_place(grid: np.ndarray, coords: list[tuple[int, int]], bg: int, comp_mask: np.ndarray) -> bool:\n    \"\"\"Check that all coords are in-bounds, on bg, and not 4-adjacent to existing components.\"\"\"\n    H, W = grid.shape\n    s = set(coords)\n    for r, c in s:\n        if not (0 <= r < H and 0 <= c < W):\n            return False\n        if grid[r, c] != bg:\n            return False\n        for nr, nc in neighbors4(r, c):\n            if (nr, nc) not in s and 0 <= nr < H and 0 <= nc < W and comp_mask[nr, nc]:\n                return False\n    return True\n\n\ndef _place_component(\n    grid: np.ndarray, comp_mask: np.ndarray,\n    path: list[tuple[int, int]], colors: tuple[int, ...], bg: int,\n) -> bool:\n    \"\"\"Validate, paint, and register a component. Returns True on success.\"\"\"\n    if len(set(path)) != len(path):\n        return False\n    if not _can_place(grid, path, bg, comp_mask):\n        return False\n    _paint_path(grid, path, colors)\n    rs, cs = zip(*path)\n    comp_mask[rs, cs] = True\n    return True\n\n\ndef _l_specs(kind: str, H: int, W: int, r0: int, c0: int, r1: int, c1: int):\n    \"\"\"Build inner (interior L-path) and outer (open-rect) coords for one L-component.\n\n    kind: \"tl\"/\"tr\"/\"bl\"/\"br\" -- which corner of the interior the elbow is near.\n    H, W: interior dimensions.  r0,c0,r1,c1: frame border coords.\n    \"\"\"\n    is_top = kind[0] == \"t\"\n    is_left = kind[1] == \"l\"\n\n    # Elbow position in interior coords\n    r = random.randint(1, max(1, H // 2)) if is_top else random.randint(max(1, H // 2), H - 2)\n    c = random.randint(1, max(1, W // 2)) if is_left else random.randint(max(1, W // 2), W - 2)\n\n    # Outer corner offset from frame\n    lo, hi = _OUTER_OFFSET_RANGE\n    R = (r0 - random.randint(lo, hi)) if is_top else (r1 + random.randint(lo, hi))\n    C = (c0 - random.randint(lo, hi)) if is_left else (c1 + random.randint(lo, hi))\n\n    # Ring touch points (where the open-rect meets the frame border)\n    ring_a = (r0 - 1 if is_top else r1 + 1, c0 + 1 + c)\n    ring_b = (r0 + 1 + r, c0 - 1 if is_left else c1 + 1)\n\n    # Inner L-path: from edge to elbow along one axis, then along the other\n    edge_r = 0 if is_top else H - 1\n    edge_c = 0 if is_left else W - 1\n    inner = _join(_vpath(edge_r, r, c), _hpath(r, c, edge_c))\n\n    # Outer open-rect: ring_a -> corner (R,C) -> ring_b\n    outer = _join(\n        _vpath(ring_a[0], R, ring_a[1]),\n        _hpath(R, ring_a[1], C),\n        _vpath(R, ring_b[0], C),\n        _hpath(ring_b[0], C, ring_b[1]),\n    )\n    return inner, outer\n\n\ndef _u_pair_specs(orientation: str, H: int, W: int, r0: int, c0: int, r1: int, c1: int):\n    \"\"\"Build inner (two full-span stripes) and two outer U-shaped open-rects.\"\"\"\n    lo, hi = _OUTER_OFFSET_RANGE\n    if orientation == \"vertical\":\n        c_a, c_b = sorted(random.sample(range(1, W - 1), 2))\n        if c_b - c_a < 2:\n            c_b = min(W - 2, c_a + 2)\n        top_r = r0 - random.randint(lo, hi)\n        bot_r = r1 + random.randint(lo, hi)\n        a_top, b_top = (r0 - 1, c0 + 1 + c_a), (r0 - 1, c0 + 1 + c_b)\n        a_bot, b_bot = (r1 + 1, c0 + 1 + c_a), (r1 + 1, c0 + 1 + c_b)\n        outer_a = _join(\n            _vpath(a_top[0], top_r, a_top[1]),\n            _hpath(top_r, a_top[1], b_top[1]),\n            _vpath(top_r, b_top[0], b_top[1]))\n        outer_b = _join(\n            _vpath(a_bot[0], bot_r, a_bot[1]),\n            _hpath(bot_r, a_bot[1], b_bot[1]),\n            _vpath(bot_r, b_bot[0], b_bot[1]))\n        inner = [[(r, c_a) for r in range(H)], [(r, c_b) for r in range(H)]]\n    else:\n        r_a, r_b = sorted(random.sample(range(1, H - 1), 2))\n        if r_b - r_a < 2:\n            r_b = min(H - 2, r_a + 2)\n        left_c = c0 - random.randint(lo, hi)\n        right_c = c1 + random.randint(lo, hi)\n        a_left, b_left = (r0 + 1 + r_a, c0 - 1), (r0 + 1 + r_b, c0 - 1)\n        a_right, b_right = (r0 + 1 + r_a, c1 + 1), (r0 + 1 + r_b, c1 + 1)\n        outer_a = _join(\n            _hpath(a_left[0], a_left[1], left_c),\n            _vpath(a_left[0], b_left[0], left_c),\n            _hpath(b_left[0], left_c, b_left[1]))\n        outer_b = _join(\n            _hpath(a_right[0], a_right[1], right_c),\n            _vpath(a_right[0], b_right[0], right_c),\n            _hpath(b_right[0], right_c, b_right[1]))\n        inner = [[(r_a, c) for c in range(W)], [(r_b, c) for c in range(W)]]\n    return inner, outer_a, outer_b\n\n\ndef _add_distractor(grid: np.ndarray, comp_mask: np.ndarray, bg: int,\n                    frame: tuple[int, int, int, int], color: int) -> None:\n    \"\"\"Try to place a small random blob away from the frame.\"\"\"\n    H, W = grid.shape\n    r0, c0, r1, c1 = frame\n    gap = _DISTRACTOR_CLEARANCE\n    sz_lo, sz_hi = _DISTRACTOR_SIZE_RANGE\n    for _ in range(_DISTRACTOR_TRIES):\n        size = random.randint(sz_lo, sz_hi)\n        r, c = random.randint(1, H - 2), random.randint(1, W - 2)\n        coords = [(r, c)]\n        used = {(r, c)}\n        for _ in range(size - 1):\n            base = random.choice(coords)\n            opts = [(nr, nc) for nr, nc in neighbors4(*base)\n                    if 1 <= nr < H - 1 and 1 <= nc < W - 1 and (nr, nc) not in used]\n            if not opts:\n                break\n            p = random.choice(opts)\n            used.add(p)\n            coords.append(p)\n        if any(r0 - gap <= rr <= r1 + gap and c0 - gap <= cc <= c1 + gap for rr, cc in coords):\n            continue\n        if _place_component(grid, comp_mask, coords, (color,), bg):\n            return\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid. Returns None on failure.\"\"\"\n    bg = random.choice(_BG_CHOICES)\n    bc = _BORDER_COLOR\n    fill = bg if random.random() < _FILL_EQ_BG_PROB else random.choice([x for x in range(10) if x not in (bg, bc)])\n    H = random.randint(*_INTERIOR_H_RANGE)\n    W = random.randint(*_INTERIOR_W_RANGE)\n    rows = random.randint(max(_GRID_SIZE_RANGE[0], H + _GRID_INTERIOR_PAD), _GRID_SIZE_RANGE[1])\n    cols = random.randint(max(_GRID_SIZE_RANGE[0], W + _GRID_INTERIOR_PAD), _GRID_SIZE_RANGE[1])\n    r0 = random.randint(_FRAME_MARGIN, rows - H - _FRAME_MARGIN_FAR)\n    c0 = random.randint(_FRAME_MARGIN, cols - W - _FRAME_MARGIN_FAR)\n    r1, c1 = r0 + H + 1, c0 + W + 1\n\n    # Draw frame and fill interior\n    grid = np.full((rows, cols), bg, dtype=int)\n    grid[r0, c0 : c1 + 1] = bc\n    grid[r1, c0 : c1 + 1] = bc\n    grid[r0 : r1 + 1, c0] = bc\n    grid[r0 : r1 + 1, c1] = bc\n    grid[r0 + 1 : r1, c0 + 1 : c1] = fill\n\n    expected = np.full((H, W), fill, dtype=int)\n    comp_mask = np.zeros_like(grid, dtype=bool)\n    palette = [x for x in range(10) if x not in (bg, bc, fill)]\n    random.shuffle(palette)\n    used_inner = np.zeros((H, W), dtype=bool)\n\n    n_components = random.randint(*_N_COMPONENTS_RANGE)\n    remaining = n_components\n    color_i = 0\n\n    # Optionally place a U-pair (two matching U-shaped open-rects on opposite sides)\n    if remaining >= 2 and random.random() < _U_PAIR_PROB:\n        orientation = random.choice([\"vertical\", \"horizontal\"])\n        if orientation == \"horizontal\" and H < 5:\n            orientation = \"vertical\"\n        color = palette[color_i]\n        color_i += 1\n        inner_lines, outer_a, outer_b = _u_pair_specs(orientation, H, W, r0, c0, r1, c1)\n        all_inner = [p for line in inner_lines for p in line]\n        irs, ics = zip(*all_inner)\n        if used_inner[irs, ics].any():\n            return None\n        if not _place_component(grid, comp_mask, outer_a, (color,), bg):\n            return None\n        if not _place_component(grid, comp_mask, outer_b, (color,), bg):\n            return None\n        expected[irs, ics] = color\n        used_inner[irs, ics] = True\n        remaining -= 2\n\n    # Place L-shaped components in random corners\n    corners = random.sample([\"tl\", \"tr\", \"bl\", \"br\"], k=remaining)\n    for kind in corners:\n        if color_i >= len(palette) - 1:\n            return None\n        inner, outer = _l_specs(kind, H, W, r0, c0, r1, c1)\n        irs, ics = zip(*inner)\n        if used_inner[irs, ics].any():\n            return None\n        if random.random() < _DUAL_COLOR_PROB:\n            colors = (palette[color_i], palette[color_i + 1])\n            color_i += 2\n        else:\n            colors = (palette[color_i],)\n            color_i += 1\n        if not _place_component(grid, comp_mask, outer, colors, bg):\n            return None\n        _paint_path(expected, inner, colors)\n        used_inner[irs, ics] = True\n\n    # Optionally add small distractor blobs\n    for _ in range(random.randint(*_DISTRACTOR_COUNT_RANGE)):\n        if color_i >= len(palette):\n            break\n        _add_distractor(grid, comp_mask, bg, (r0, c0, r1, c1), palette[color_i])\n        color_i += 1\n\n    # Oracle check: solver must reproduce expected output\n    try:\n        actual = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid a6f40cea input\")\n","exit_code":0,"status":"completed"}}
