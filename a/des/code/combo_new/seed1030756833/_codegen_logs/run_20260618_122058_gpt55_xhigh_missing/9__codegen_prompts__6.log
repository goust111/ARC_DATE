{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/20fb2937.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each marker below the separator with the mapped top legend square centered on that marker.\n\n    Input structure:\n    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.\n    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.\n    - The lower field contains only background and marker colors from the legend.\n\n    Rule:\n    - Pair legend markers to legend sprites by left-to-right position.\n    - Discard the legend and separator; keep the grid width and the rows below the separator.\n    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.\n\n    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    sep = _solid_separator_row(g, bg)\n    mapping, size = _legend_mapping(g, sep, bg)\n\n    lower = g[sep + 1 :]\n    out = np.full_like(lower, bg)\n    radius = size // 2\n\n    for r, c in np.argwhere(lower != bg):\n        key = int(lower[r, c])\n        assert key in mapping, \"lower field marker must appear in the legend\"\n        r0 = int(r) - radius\n        c0 = int(c) - radius\n        r1 = r0 + size\n        c1 = c0 + size\n        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], \"expanded square must fit in output\"\n        assert np.all(out[r0:r1, c0:c1] == bg), \"expanded squares must not overlap\"\n        out[r0:r1, c0:c1] = mapping[key]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6\nFIELD_SHAPE = (13, 11)\nFIELD_WIDTH = FIELD_SHAPE[1]\nSQUARE_SIZE = 3\nSQUARE_RADIUS = SQUARE_SIZE // 2\nLEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4\n\n# Palette and object counts.\nPALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nNUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]\n\nEMPTY, MAX_GENERATION_ATTEMPTS = 0, 300\n\n\ndef _color_pairs() -> tuple[list[int], list[int]]:\n    \"\"\"Return disjoint sprite and marker palettes in legend order.\"\"\"\n    picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)\n    return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]\n\n\ndef _place_centers(n: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place non-overlapping 3x3 squares and return their centers.\"\"\"\n    occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)\n    patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)\n    centers: list[tuple[int, int]] = []\n    for _ in range(n):\n        try:\n            r0, c0 = random_free_location(occ, patch, transparent=EMPTY)\n        except ValueError:\n            return None\n        paste(occ, patch, r0, c0)\n        centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))\n    return centers\n\n\ndef _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:\n    \"\"\"Connect square indices whose rendered 3x3 blocks share an edge.\"\"\"\n    neighbors = [set() for _ in centers]\n    for i, (r1, c1) in enumerate(centers):\n        for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):\n            dr = abs(r1 - r2)\n            dc = abs(c1 - c2)\n            if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):\n                neighbors[i].add(j)\n                neighbors[j].add(i)\n    return neighbors\n\n\ndef _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:\n    \"\"\"Assign all color ids while preventing same-color touching squares.\"\"\"\n    neighbors = _touch_graph(centers)\n    order = list(range(len(centers)))\n    random.shuffle(order)\n    order.sort(key=lambda i: len(neighbors[i]), reverse=True)\n    ids: list[int | None] = [None] * len(centers)\n    required = set(range(NUM_COLOR_PAIRS))\n\n    def backtrack(pos: int, used: set[int]) -> bool:\n        if pos == len(order):\n            return used == required\n        if len(required - used) > len(order) - pos:\n            return False\n        i = order[pos]\n        choices = list(range(NUM_COLOR_PAIRS))\n        random.shuffle(choices)\n        for color_id in choices:\n            if any(ids[j] == color_id for j in neighbors[i]):\n                continue\n            ids[i] = color_id\n            if backtrack(pos + 1, used | {color_id}):\n                return True\n            ids[i] = None\n        return False\n\n    if not backtrack(0, set()):\n        return None\n    return [int(x) for x in ids]\n\n\ndef _build_grids(\n    centers: list[tuple[int, int]],\n    square_ids: list[int],\n    sprite_colors: list[int],\n    marker_colors: list[int],\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an assembled input grid and the matching oracle output.\"\"\"\n    out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    for (r, c), idx in zip(centers, square_ids):\n        patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)\n        paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)\n        lower[r, c] = marker_colors[idx]\n\n    legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):\n        c0 = i * LEGEND_COLUMN_STRIDE\n        legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite\n        legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker\n\n    sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)\n    return np.vstack([legend, sep, lower]), out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_colors, marker_colors = _color_pairs()\n    n_squares = random.choice(SQUARE_COUNT_CHOICES)\n    centers = _place_centers(n_squares)\n    if centers is None:\n        return None\n    square_ids = _assign_square_ids(centers)\n    if square_ids is None:\n        return None\n\n    inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt():\n    sampled = _sample_groups()\n    if sampled is None:\n        return None\n    rows, max_height, groups = sampled\n\n    layout = _sample_layout(max_height, groups)\n    if layout is None:\n        return None\n    bars, width = layout\n\n    inp, expected = _render_pair(rows, width, bars)\n    if not _passes_oracle(inp, expected):\n        return None\n    return inp\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
