{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,25p' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\nimport itertools\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    \"\"\"\n    Find a rectangular border component:\n      - all bbox-border cells are this color,\n      - bbox-interior is not entirely this color.\n    Return (frame_color, (r0,c0,r1,c1)).\n    \"\"\"\n    candidates = []\n    colors = [int(c) for c in np.unique(g) if int(c) != bg]\n    for col in colors:\n        for pts in components_mask(g == col, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r1 - r0 < 2 or c1 - c0 < 2:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            border = np.zeros(sub.shape, dtype=bool)\n            border[0, :] = True\n            border[-1, :] = True\n","exit_code":0,"status":"completed"}}
