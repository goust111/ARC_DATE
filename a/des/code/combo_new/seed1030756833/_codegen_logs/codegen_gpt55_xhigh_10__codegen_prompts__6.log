import random, numpy as np

def neigh(r,c,h,w):
    if r: yield r-1,c
    if r<h-1: yield r+1,c
    if c: yield r,c-1
    if c<w-1: yield r,c+1

def is_conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    start=tuple(pts[0]); seen={start}; stack=[start]
    h,w=mask.shape
    while stack:
        r,c=stack.pop()
        for p in neigh(r,c,h,w):
            if mask[p] and p not in seen:
                seen.add(p); stack.append(p)
    return len(seen)==len(pts)

def full(m): return m[0].any() and m[-1].any() and m[:,0].any() and m[:,-1].any()

def grow(h,w,target):
    mask=np.zeros((h,w),bool)
    p=(random.randrange(h),random.randrange(w)); mask[p]=1
    frontier=set(neigh(*p,h,w))
    count=1
    while count<target and frontier:
        p=random.choice(list(frontier)); frontier.remove(p)
        if mask[p]: continue
        mask[p]=1; count+=1
        for q in neigh(*p,h,w):
            if not mask[q]: frontier.add(q)
    return mask

def sample(h,w,tries=10000):
    area=h*w
    lo=max(2,area//4); hi=min(area-2,3*area//4)
    for i in range(tries):
        m=grow(h,w,random.randint(lo,hi))
        if full(m) and full(~m) and is_conn(~m): return i+1,int(m.sum())
    return None
for h in range(5,9):
  for w in range(5,10):
    vals=[]; fail=0
    for _ in range(20):
      res=sample(h,w,2000)
      if res is None: fail+=1
      else: vals.append(res[0])
    print((h,w),'fail',fail,'avg',round(sum(vals)/len(vals),1) if vals else None)
