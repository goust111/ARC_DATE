import random, numpy as np

def neigh(r,c,h,w):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w: yield rr,cc

def is_conn(mask):
    pts=list(zip(*np.where(mask)))
    if not pts: return False
    seen={pts[0]}; stack=[pts[0]]
    while stack:
        r,c=stack.pop()
        for p in neigh(r,c,*mask.shape):
            if mask[p] and p not in seen:
                seen.add(p); stack.append(p)
    return len(seen)==len(pts)

def full(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def grow(h,w,target):
    mask=np.zeros((h,w),bool)
    r=random.randrange(h); c=random.randrange(w); mask[r,c]=1
    frontier=set(neigh(r,c,h,w))
    while mask.sum()<target and frontier:
        p=random.choice(tuple(frontier)); frontier.remove(p); mask[p]=1
        for q in neigh(*p,h,w):
            if not mask[q]: frontier.add(q)
    return mask

def sample(h,w,tries=5000):
    area=h*w
    lo=max(h+w-1, area//3, 2)
    hi=min(area-(h+w-1), (2*area)//3, area-2)
    # this lo/hi may be wrong because complement needs at least h+w-1 too
    if lo>hi:
