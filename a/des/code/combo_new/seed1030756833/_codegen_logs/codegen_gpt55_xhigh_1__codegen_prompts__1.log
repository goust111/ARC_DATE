+    dr = dc = 0
+    if frame.direction == "up":
+        dr = -(max_r - frame.r0 + 1)
+    elif frame.direction == "down":
+        dr = frame.r1 - min_r + 1
+    elif frame.direction == "left":
+        dc = -(max_c - frame.c0 + 1)
+    else:
