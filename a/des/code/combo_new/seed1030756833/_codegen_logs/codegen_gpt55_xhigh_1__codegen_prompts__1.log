+def _moved_sprite_cells(g: np.ndarray, frame: _Frame, bg: int = BG) -> list[tuple[int, int, int]]:
+    interior = g[frame.r0 + 1 : frame.r1, frame.c0 + 1 : frame.c1]
+    mask = (interior != bg) & (interior != frame.color)
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return []
