+    sh = max(r for r, _ in cells) + 1
+    sw = max(c for _, c in cells) + 1
+    mask = np.zeros((sh, sw), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _expand_cells(cells: set[tuple[int, int]], h: int, w: int, radius: int = 1) -> set[tuple[int, int]]:
