+        return None
+
+    frames = _find_frames(grid, BG)
+    if len(frames) != placed:
+        return None
+    out = main(grid)
+    if out.shape != grid.shape or max(out.shape) > 30:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
