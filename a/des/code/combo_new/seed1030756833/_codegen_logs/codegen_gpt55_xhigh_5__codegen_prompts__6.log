    if _body_thickness(inp_mask) != intended_thickness:
        return None

    if not _gen_source_sets_match(inp_mask, chosen):
        return None

    inp = _gen_to_grid(inp_mask)
    expected = _gen_to_grid(out_mask)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


