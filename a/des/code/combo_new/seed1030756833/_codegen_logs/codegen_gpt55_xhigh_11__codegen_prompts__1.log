            bbox = _exact_rect_ring_bbox(pts)
            if bbox is None:
                continue
            r0, c0, r1, c1 = bbox
            interior = g[r0 + 1 : r1, c0 + 1 : c1]
            if interior.size == 0:
                continue
            pattern = interior != BLACK
            if not bool(pattern.any()):
                continue
            if color not in templates or pattern.size > templates[color].size:
                templates[color] = pattern.copy()
