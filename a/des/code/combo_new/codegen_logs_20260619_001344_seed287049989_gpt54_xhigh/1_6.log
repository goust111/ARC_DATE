+def _rotation_signature(mask: np.ndarray) -> tuple[tuple[int, int, bytes], ...]:
+    norm = _crop_mask(mask)
+    rots = []
+    for k in range(4):
+        rot = np.rot90(norm, k)
+        rots.append((int(rot.shape[0]), int(rot.shape[1]), rot.astype(np.uint8).tobytes()))
+    return tuple(sorted(set(rots)))
