+
+def _sample_layout() -> tuple[int, int, int, int, bool] | None:
+    rows = random.randint(2, 4)
+    cols = random.randint(3, 5)
+    cell_h = random.randint(5, 7)
+    cell_w = random.randint(5, 7)
