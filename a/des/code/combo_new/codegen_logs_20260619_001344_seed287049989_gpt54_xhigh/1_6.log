+def _embed_shape(shape: np.ndarray, cell_h: int, cell_w: int, rotation: int) -> np.ndarray:
+    inner = min(cell_h, cell_w) - 2
+    square = np.zeros((inner, inner), dtype=bool)
+    h, w = shape.shape
+    r0 = (inner - h) // 2
+    c0 = (inner - w) // 2
+    square[r0 : r0 + h, c0 : c0 + w] = shape
