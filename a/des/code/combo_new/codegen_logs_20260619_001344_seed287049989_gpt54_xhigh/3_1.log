+    if any(color in {bg, wall} for color in side_colors.values()):
+        return None
+    if len(set(side_colors.values())) != 4:
+        return None
+
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if interior.size == 0 or np.any(interior == wall):
+        return None
+
+    side_palette = set(side_colors.values())
+    marker_hits = [
