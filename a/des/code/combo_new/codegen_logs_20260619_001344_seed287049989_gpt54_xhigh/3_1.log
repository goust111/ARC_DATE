+
+    top = _uniform_color(grid[r0, c0 + 1 : c1])
+    bottom = _uniform_color(grid[r1, c0 + 1 : c1])
+    left = _uniform_color(grid[r0 + 1 : r1, c0])
+    right = _uniform_color(grid[r0 + 1 : r1, c1])
+    if None in (top, bottom, left, right):
