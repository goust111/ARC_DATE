+    elif door_side == "bottom":
+        expected[r1, c0 + 1 : c1] = bg
+    elif door_side == "left":
+        expected[r0 + 1 : r1, c0] = bg
+    else:
+        expected[r0 + 1 : r1, c1] = bg
+
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
