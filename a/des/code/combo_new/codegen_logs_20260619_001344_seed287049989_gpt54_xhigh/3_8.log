+
+
+def _build_expected_output(bg: int, consensus: np.ndarray, objects: list[dict]) -> np.ndarray:
+    h, w = consensus.shape
+    out = np.full((h, (len(objects) + 1) * w + len(objects)), bg, dtype=int)
+    _paint_mask(out, consensus, 0, 0, GREEN)
