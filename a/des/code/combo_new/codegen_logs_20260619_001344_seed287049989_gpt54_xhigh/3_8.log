+import itertools
+import math
+import random
+
+import numpy as np
+
+
+GREEN = 3
+PALETTE = tuple(range(10))
+INPUT_COLORS = tuple(color for color in PALETTE if color != GREEN)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 400
