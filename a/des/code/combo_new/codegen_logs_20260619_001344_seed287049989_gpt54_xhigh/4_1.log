+        r0, c0, r1, c1 = _bbox(comp)
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 3 or width < 3:
+            continue
+        if len(comp) != 2 * (height + width) - 4:
+            continue
