+            r0 = 1
+            c0 = rng.randint(2, grid_w - outer - 2)
+        elif side == "bottom":
+            r0 = grid_h - outer - 1
+            cmax = rc0 - outer - 1
+            if cmax < 2:
+                return None
+            c0 = rng.randint(2, cmax)
+        elif side == "left":
