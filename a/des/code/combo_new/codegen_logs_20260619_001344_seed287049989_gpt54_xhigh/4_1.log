+            hits.append(("top", color))
+        elif mr == h - 1 and r1 == h - 2 and c0 < mc < c1:
+            hits.append(("bottom", color))
+        elif mc == 0 and c0 == 1 and r0 < mr < r1:
+            hits.append(("left", color))
+        elif mc == w - 1 and c1 == w - 2 and r0 < mr < r1:
