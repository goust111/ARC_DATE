+    if side == "top":
+        return 0, rng.randint(c0 + 1, c1 - 1)
+    if side == "bottom":
+        return r1 + 1, rng.randint(c0 + 1, c1 - 1)
+    if side == "left":
+        return rng.randint(r0 + 1, r1 - 1), 0
+    return rng.randint(r0 + 1, r1 - 1), c1 + 1
+
+
+def _render_expected(
+    grid: np.ndarray,
+    rooms: list[dict],
+    templates: dict[int, np.ndarray],
