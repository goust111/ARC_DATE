+        inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+        marker_pts = np.argwhere(inner != bg)
+        if len(marker_pts) != 1:
+            return False
+        mr, mc = map(int, marker_pts[0])
+        marker_color = int(inner[mr, mc])
+        if marker_color in marker_colors:
+            return False
+        marker_colors.add(marker_color)
+
+        fill = _quadrant_fill(
+            {
+                "top_left": seeds[0],
+                "top_right": seeds[1],
+                "bottom_left": seeds[2],
+                "bottom_right": seeds[3],
+            },
+            inner.shape[0],
+            inner.shape[1],
+            mr,
+            mc,
+        )
