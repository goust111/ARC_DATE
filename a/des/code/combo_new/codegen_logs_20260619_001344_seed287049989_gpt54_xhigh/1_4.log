+            c1 = c0 + outer_w - 1
+            grid[r0, c0 : c1 + 1] = frame_color
+            grid[r1, c0 : c1 + 1] = frame_color
+            grid[r0 : r1 + 1, c0] = frame_color
+            grid[r0 : r1 + 1, c1] = frame_color
+
+            inner_h = outer_h - 2
+            inner_w = outer_w - 2
+            mr, mc = _marker_position(inner_h, inner_w, quadrant)
+            grid[r0 + 1 + mr, c0 + 1 + mc] = marker_color
