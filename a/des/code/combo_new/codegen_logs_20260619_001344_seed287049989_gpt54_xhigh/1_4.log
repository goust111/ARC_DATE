+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+COLORS = tuple(range(10))
+QUADRANTS = ("tl", "tr", "bl", "br")
+MAX_GEN_ATTEMPTS = 500
+SIZE_POOL = (5, 5, 5, 7, 7, 9, 11)
+
+
+def _mode_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in points]
+    cols = [c for _r, c in points]
+    return int(min(rows)), int(min(cols)), int(max(rows)), int(max(cols))
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int]]:
+    frames: list[tuple[int, int, int, int, int]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 5 or w < 5:
+                continue
+            patch = np.zeros((h, w), dtype=bool)
+            for r, c in comp:
+                patch[r - r0, c - c0] = True
+            ring = np.zeros((h, w), dtype=bool)
+            ring[0, :] = True
+            ring[-1, :] = True
+            ring[:, 0] = True
+            ring[:, -1] = True
+            if np.array_equal(patch, ring):
+                frames.append((color, r0, c0, r1, c1))
