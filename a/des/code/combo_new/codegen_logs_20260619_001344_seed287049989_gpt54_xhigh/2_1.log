+BG = 0
+WALL = 5
+MARKER = 9
+ANCHOR_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+GEN_RETRIES = 300
+REGION_COUNT_CHOICES = (2, 3, 4)
