+_GEN_ATTEMPTS = 400
+_GEN_SIZE_MIN = 12
+_GEN_SIZE_MAX = 20
+_GEN_EXTRA_SEGMENT_MAX = 2
+_GEN_GAP = 1
+_GEN_BRANCHES = ("vertical", "horizontal", "tie")
