+
+def _spec_conflicts(
+    spec: dict,
+    object_buffer: set[tuple[int, int]],
+    object_cells: set[tuple[int, int]],
+    used_rays: set[tuple[int, int]],
+    allowed_overlaps: set[tuple[int, int]] | None = None,
