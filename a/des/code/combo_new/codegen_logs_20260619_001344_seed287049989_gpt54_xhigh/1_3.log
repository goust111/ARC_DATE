+
+    colors = list(range(10))
+    random.shuffle(colors)
+    bg = int(colors[0])
+    left_marker_color = int(colors[1])
+    cross_color = int(colors[2])
+    arrow_colors = [int(c) for c in colors[3 : 3 + arrow_count]]
