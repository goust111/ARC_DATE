+    object_cells: set[tuple[int, int]],
+    used_rays: set[tuple[int, int]],
+) -> dict | None:
+    for _ in range(LOCAL_ATTEMPTS):
+        direction = random.choice(tuple(DIRS))
+        length = random.choice(ARROW_LENGTHS)
+        specs = cache[(direction, length)]
