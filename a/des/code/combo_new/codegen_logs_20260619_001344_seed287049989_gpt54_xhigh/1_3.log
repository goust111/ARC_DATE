+def _infer_tips_by_color(grid: np.ndarray) -> dict[int, tuple[int, int]]:
+    bg, _cross_color, _marker_cells, arrows = _extract_scene(grid)
+    bits = _choose_assignment(np.asarray(grid, dtype=int), bg, arrows)
