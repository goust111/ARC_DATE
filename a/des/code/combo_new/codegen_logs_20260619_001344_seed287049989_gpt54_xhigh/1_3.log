+
+def _pick_cross_pair(h: int, w: int, cache: dict[tuple[str, int], list[dict]]) -> tuple[dict, dict] | None:
+    for _ in range(LOCAL_ATTEMPTS):
+        cross = (random.randint(2, h - 3), random.randint(2, w - 3))
+        h_dir = random.choice(("left", "right"))
