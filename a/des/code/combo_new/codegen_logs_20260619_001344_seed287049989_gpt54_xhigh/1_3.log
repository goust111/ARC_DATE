+) -> bool:
+    allowed = allowed_overlaps or set()
+    if spec["cells_set"] & object_buffer:
+        return True
+    if spec["cells_set"] & used_rays:
+        return True
+    if spec["ray_set"] & object_cells:
+        return True
+    if (spec["ray_set"] & used_rays) - allowed:
