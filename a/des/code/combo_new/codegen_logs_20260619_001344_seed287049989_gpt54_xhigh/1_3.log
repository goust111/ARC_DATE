+    random.shuffle(rows)
+    edge_rows = [0, h - 1] if h > 1 else [0]
+    rows = edge_rows + [r for r in rows if r not in edge_rows]
+    for r in rows:
+        cols = list(range(w - 1))
+        random.shuffle(cols)
+        for c in cols:
+            left = (int(r), int(c))
+            right = (int(r), int(c + 1))
+            if {left, right} & object_buffer:
+                continue
+            if left in used_rays or right in used_rays:
+                continue
+            return left, right
+    return None
+
+
+def _draw_scene(
+    h: int,
+    w: int,
+    bg: int,
+    marker_colors: tuple[int, int],
+    arrows: list[dict],
+) -> np.ndarray:
