+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+# Generator bounds.
+GRID_MIN_SIZE = 10
+GRID_MAX_SIZE = 20
+PATH_LEN_MIN = 10
+PATH_LEN_MAX = 24
+SEGMENT_COUNT_MIN = 3
+SEGMENT_COUNT_MAX = 7
+SEGMENT_STEPS_MIN = 1
+SEGMENT_STEPS_MAX = 6
+CHECKPOINT_COUNT_MIN = 2
+CHECKPOINT_COUNT_MAX = 5
+CHECKPOINT_INDEX_GAP = 2
+CHECKPOINT_SELECTION_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 400
