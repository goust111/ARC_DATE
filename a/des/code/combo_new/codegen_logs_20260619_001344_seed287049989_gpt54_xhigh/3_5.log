+    bg: int,
+    path_color: int,
+    path: list[Coord],
+) -> list[tuple[int, int]]:
+    path_index = {cell: idx for idx, cell in enumerate(path)}
+    hits: list[tuple[int, int]] = []
+    seen_colors: set[int] = set()
+    seen_indices: set[int] = set()
