+def _extend_segment(
+    path: list[Coord],
+    used: set[Coord],
+    direction: Coord,
+    steps: int,
+    h: int,
+    w: int,
+) -> tuple[list[Coord], set[Coord]] | None:
+    dr, dc = direction
+    new_path = list(path)
+    new_used = set(used)
+    r, c = new_path[-1]
+
+    for _ in range(steps):
+        nr, nc = r + dr, c + dc
+        if not (1 <= nr < h - 1 and 1 <= nc < w - 1):
+            return None
+        if (nr, nc) in new_used:
+            return None
+        if any((ar, ac) in new_used and (ar, ac) != (r, c) for ar, ac in _neighbors4(nr, nc)):
