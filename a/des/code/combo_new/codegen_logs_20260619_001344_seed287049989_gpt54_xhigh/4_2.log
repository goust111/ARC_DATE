+def _layer_areas_for_shape(height: int, width: int, n_layers: int) -> list[int]:
+    areas: list[int] = []
+    for depth in range(n_layers - 1):
+        outer_h = height - 2 * depth
+        outer_w = width - 2 * depth
+        inner_h = outer_h - 2
+        inner_w = outer_w - 2
