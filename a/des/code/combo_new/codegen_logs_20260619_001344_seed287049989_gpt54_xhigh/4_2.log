+        outer_w = width - 2 * depth
+        inner_h = outer_h - 2
+        inner_w = outer_w - 2
+        assert outer_h >= 3 and outer_w >= 3
+        areas.append(outer_h * outer_w - inner_h * inner_w)
+    core_h = height - 2 * (n_layers - 1)
+    core_w = width - 2 * (n_layers - 1)
+    assert core_h >= 1 and core_w >= 1
