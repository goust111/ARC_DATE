+    for layer, color in enumerate(colors[:-1]):
+        r0 = c0 = layer
+        r1 = height - 1 - layer
+        c1 = width - 1 - layer
+        out[r0, c0 : c1 + 1] = color
+        out[r1, c0 : c1 + 1] = color
+        out[r0 : r1 + 1, c0] = color
+        out[r0 : r1 + 1, c1] = color
