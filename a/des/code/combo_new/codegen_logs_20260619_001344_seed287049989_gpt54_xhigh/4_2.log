+        off_r = random.randint(0, cell_h - patch.shape[0])
+        off_c = random.randint(0, cell_w - patch.shape[1])
+        rr = r0 + off_r
+        cc = c0 + off_c
+        mask = patch.astype(bool)
+        grid[rr : rr + patch.shape[0], cc : cc + patch.shape[1]][mask] = color
