+        side = ("top", "bottom", "left", "right")[int(rng.integers(0, 4))]
+        if side in ("top", "bottom"):
+            width = int(rng.integers(2, w + 1))
+            thickness = int(rng.integers(1, 3))
+            start = int(rng.integers(0, w - width + 1))
+            if side == "top":
