+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
+
+
+def _random_transform(mask: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = mask.copy()
+    if bool(rng.integers(0, 2)):
+        out = np.fliplr(out)
+    if bool(rng.integers(0, 2)):
+        out = np.flipud(out)
+    out = np.rot90(out, k=int(rng.integers(0, 4)))
+    return _crop_mask(out)
+
+
+def _hole_regions(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            region: list[tuple[int, int]] = []
+            touches_border = False
+            while q:
+                cr, cc = q.popleft()
+                region.append((cr, cc))
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes.append(region)
+    return holes
+
+
+def _erode_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask)
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        keep = True
+        for dr, dc in DIRS4:
+            nr, nc = rr + dr, cc + dc
+            if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                keep = False
+                break
+        out[rr, cc] = keep
+    return out
+
+
+def _foreground_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "bbox": _bbox(coords)})
+    return comps
