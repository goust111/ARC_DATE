+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAROON = 9
+
+GEN_ROWS_RANGE = (16, 25)
+GEN_COLS_RANGE = (16, 25)
