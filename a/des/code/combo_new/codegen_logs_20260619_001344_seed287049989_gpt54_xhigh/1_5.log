+def _validate_grid(
+    grid: np.ndarray,
+    bg: int,
+    expected_hollow: int,
+    expected_solid: int,
+    need_conflict: bool,
+) -> bool:
+    counts = Counter(map(int, grid.flat))
+    fg_counts = [count for color, count in counts.items() if color != bg]
+    if not fg_counts:
+        return False
+    if counts[bg] <= max(fg_counts):
+        return False
