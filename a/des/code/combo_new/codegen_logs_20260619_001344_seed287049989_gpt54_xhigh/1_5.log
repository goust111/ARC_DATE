+
+def _add_protrusions(mask: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    pad = 2
+    canvas = np.pad(mask, pad_width=pad, mode="constant", constant_values=False)
+    base_r0 = pad
+    base_c0 = pad
+    h, w = mask.shape
