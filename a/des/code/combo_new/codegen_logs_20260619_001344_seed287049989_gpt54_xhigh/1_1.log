+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _background_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _legend_info(grid: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    h, w = grid.shape
+    best = None  # (score, side, start, end)
+
+    for side, col in (("left", 0), ("right", w - 1)):
+        start = None
+        for r in range(h + 1):
+            filled = r < h and int(grid[r, col]) != bg
+            if filled and start is None:
+                start = r
+            elif not filled and start is not None:
+                end = r
+                colors = [int(v) for v in grid[start:end, col]]
+                score = (end - start, len(set(colors)) == len(colors), -start)
+                cand = (score, side, start, end)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+                start = None
+
+    assert best is not None, "expected a vertical legend on the left or right edge"
+    _, side, start, end = best
+    col = 0 if side == "left" else w - 1
+
+    mapping: dict[int, int] = {}
+    legend_mask = np.zeros_like(grid, dtype=bool)
+    for idx, r in enumerate(range(start, end), start=1):
+        mapping[idx] = int(grid[r, col])
+        legend_mask[r, col] = True
+    return mapping, legend_mask
+
+
+def _count_adjacent_components(grid: np.ndarray, color: int, seeds: set[tuple[int, int]]) -> int:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    total = 0
+    for sr, sc in seeds:
+        if seen[sr, sc]:
+            continue
+        total += 1
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in _neighbors4(r, c):
+                if (
+                    0 <= nr < h
+                    and 0 <= nc < w
+                    and int(grid[nr, nc]) == color
+                    and not seen[nr, nc]
+                ):
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+    return total
+
