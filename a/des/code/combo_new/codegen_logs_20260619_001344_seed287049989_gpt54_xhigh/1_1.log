+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _background_color(g)
+    legend, legend_mask = _legend_info(g, bg)
+
+    out = g.copy()
+    bg_comps = _components((g == bg) & (~legend_mask))
+    for comp in bg_comps:
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+
+        comp_set = set(comp)
+        border_counts: dict[int, int] = {}
+        border_cells: dict[int, set[tuple[int, int]]] = {}
+        for r, c in comp:
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if (nr, nc) in comp_set or legend_mask[nr, nc]:
+                    continue
+                color = int(g[nr, nc])
+                if color == bg:
+                    continue
+                border_counts[color] = border_counts.get(color, 0) + 1
+                border_cells.setdefault(color, set()).add((nr, nc))
