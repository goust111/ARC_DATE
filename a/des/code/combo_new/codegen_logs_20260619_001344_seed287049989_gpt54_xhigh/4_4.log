+        return h_segments, v_segments
+
+    return None
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_rows = rng.randint(*CELL_COUNT_RANGE)
+    n_cols = rng.randint(*CELL_COUNT_RANGE)
+    max_size = min(
+        CELL_SIZE_MAX,
+        (30 - (n_rows + 1)) // n_rows,
+        (30 - (n_cols + 1)) // n_cols,
+    )
+    if max_size < CELL_SIZE_MIN:
