+    h_segments, v_segments = segment_layout
+
+    need_ud = (h_segments[:-1, :] == RED) | (h_segments[1:, :] == RED)
+    need_lr = (v_segments[:, :-1] == RED) | (v_segments[:, 1:] == RED)
