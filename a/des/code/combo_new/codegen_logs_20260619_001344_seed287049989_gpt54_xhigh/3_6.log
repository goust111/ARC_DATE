+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                pts.append((cr, cc))
+                for dr, dc in _NEIGHBORS4:
+                    nr = cr + dr
+                    nc = cc + dc
