+    claims = [[] for _ in range(length)]
+    overlap = False
+    end_trunc = False
+    seed_block = False
+    for idx, pos in enumerate(seed_positions, start=1):
+        for direction in (-1, 1):
+            for step in range(1, idx + 1):
+                q = pos + direction * step
+                if q < 0 or q >= length:
+                    end_trunc = True
+                    break
+                if q in seeds:
+                    seed_block = True
