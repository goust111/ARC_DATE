+        pair = ((int(pts[0, 0]), int(pts[0, 1])), (int(pts[1, 0]), int(pts[1, 1])))
+        assert int(deg[pair[0]]) == 1 and int(deg[pair[1]]) == 1, "colored endpoints must be leaves"
