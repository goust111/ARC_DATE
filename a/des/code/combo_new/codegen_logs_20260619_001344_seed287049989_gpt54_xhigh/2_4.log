+    above_rows = [backbone_row - 4 * i for i in range(1, n_above + 1)]
+    below_rows = [backbone_row + 4 * i for i in range(1, n_below + 1)]
+    random.shuffle(above_rows)
+    random.shuffle(below_rows)
