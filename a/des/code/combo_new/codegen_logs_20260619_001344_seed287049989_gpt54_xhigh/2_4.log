+    used: dict[tuple[int, int], int] = {}
+    for color, (start, goal) in endpoints.items():
+        for cell in _path_between(active, start, goal):
+            if int(grid[cell]) != network_color:
+                continue
+            prev = used.get(cell)
+            if prev is not None and prev != int(color):
+                return False
+            used[cell] = int(color)
+    return True
