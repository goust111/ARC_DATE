+def _arrow_candidates(cells: set[tuple[int, int]]) -> list[tuple[tuple[int, int], str, set[tuple[int, int]]]]:
+    candidates: list[tuple[tuple[int, int], str, set[tuple[int, int]]]] = []
+    for head in sorted(cells):
