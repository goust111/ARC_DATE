+BG = 0
+YELLOW = 4
+BODY_COLORS = tuple(c for c in range(10) if c not in (BG, YELLOW))
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PERP_DIRS = {
+    "up": ((0, -1), (0, 1)),
+    "down": ((0, -1), (0, 1)),
+    "left": ((-1, 0), (1, 0)),
+    "right": ((-1, 0), (1, 0)),
+}
+VEC_TO_NAME = {vec: name for name, vec in DIRS.items()}
+MAX_RETRIES = 400
