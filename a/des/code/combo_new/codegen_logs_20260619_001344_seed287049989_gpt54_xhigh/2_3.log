+            continue
+        body, arrow = _trim_cells(body, arrow)
+        all_cells = body | arrow
+        h2 = max(r for r, _ in all_cells) + 1
+        w2 = max(c for _, c in all_cells) + 1
+        if len(_components_from_mask(_cells_to_mask(body, (h2, w2)))) != 1:
