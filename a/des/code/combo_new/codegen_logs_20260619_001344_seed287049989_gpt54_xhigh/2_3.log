+        tip = (center[0] + d[0], center[1] + d[1])
+        shaft_cell = (center[0] + shaft[0], center[1] + shaft[1])
+        shaft_support = (center[0] + 2 * shaft[0], center[1] + 2 * shaft[1])
+        tip_notch = (center[0] + 2 * d[0], center[1] + 2 * d[1])
+        arrow = {center, tip, shaft_cell}
