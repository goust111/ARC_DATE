+    return {
+        **obj,
+        "top": top,
+        "left": left,
+        "copies": int(cand["copies"]),
+        "body_global": body_global,
+        "arrow_global": arrow_global,
+        "projected": projected,
+        "reserve_global": cand["reserve"],
