+            center_col = 2
+            row_options = [r for r in range(height) if _in_bounds((height, width), r + shaft[0], center_col + shaft[1])
+                           and _in_bounds((height, width), r + 2 * shaft[0], center_col + 2 * shaft[1])]
+            if not row_options:
+                continue
+            center = (int(rng.choice(row_options)), center_col)
+        elif direction == "down":
