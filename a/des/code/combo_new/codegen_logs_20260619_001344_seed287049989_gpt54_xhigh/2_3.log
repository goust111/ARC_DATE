+    def support_score(vec: tuple[int, int]) -> int:
+        arm = (center[0] + vec[0], center[1] + vec[1])
+        score = 4 if forward_body(vec) else 0
+        for nr, nc in _neighbors4(*arm):
+            if (nr, nc) == center or (nr, nc) in yellow:
+                continue
+            if (nr, nc) in body:
