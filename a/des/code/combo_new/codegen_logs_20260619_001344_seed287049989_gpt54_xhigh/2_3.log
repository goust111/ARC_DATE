+    for comp in _components_from_mask(g != bg):
+        yellow = [(r, c) for r, c in comp if int(g[r, c]) == YELLOW]
+        body = {(r, c) for r, c in comp if int(g[r, c]) != YELLOW}
+        if len(yellow) != 3 or not body:
