+                continue
+            center = (center_row, int(rng.choice(col_options)))
+        else:
+            center_row = 2
+            col_options = [c for c in range(width) if _in_bounds((height, width), center_row + shaft[0], c + shaft[1])
+                           and _in_bounds((height, width), center_row + 2 * shaft[0], c + 2 * shaft[1])]
+            if not col_options:
+                continue
+            center = (center_row, int(rng.choice(col_options)))
