def _extract_specs(grid: np.ndarray) -> list[dict]:
    g = np.asarray(grid, dtype=int)
    bg = _background_color(g)
    specs: list[dict] = []
    for color in sorted(int(v) for v in np.unique(g) if int(v) not in (bg, GREY)):
