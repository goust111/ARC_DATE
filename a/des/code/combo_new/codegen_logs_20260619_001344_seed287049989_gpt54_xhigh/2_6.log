+
+
+def _build_stamp_patch(color: int, pattern: np.ndarray) -> np.ndarray:
+    ph, pw = pattern.shape
+    patch = np.full((ph + 2, pw + 2), BG, dtype=int)
+    patch[_frame_mask(ph + 2, pw + 2)] = color
