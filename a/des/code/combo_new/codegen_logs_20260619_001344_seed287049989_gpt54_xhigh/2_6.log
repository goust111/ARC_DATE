    return out


def _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:
    grid = np.full((rows, cols), bg, dtype=int)
    for r0, c0 in positions:
        paste(grid, _make_ring(bg), r0, c0)
    return grid


