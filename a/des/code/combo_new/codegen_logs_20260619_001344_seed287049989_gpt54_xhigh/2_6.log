+            inner_left = int(left + 1 + (inner_w - rw) // 2)
+            out_slice = out[inner_top : inner_top + rh, inner_left : inner_left + rw]
+            out_slice[rotated == ORANGE] = ORANGE
+
+        return inp, out
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        case = _make_case()
+        if case is None:
+            continue
+        inp, expected = case
