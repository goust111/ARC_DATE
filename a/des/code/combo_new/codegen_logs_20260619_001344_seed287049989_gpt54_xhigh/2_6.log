+def _random_connected_mask(h: int, w: int, area: int) -> np.ndarray | None:
+    for _ in range(40):
+        start = (random.randrange(h), random.randrange(w))
+        chosen = {start}
+        frontier = {start}
+        while len(chosen) < area and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.discard(cell)
