+
+
+def _build_container_patch(color: int, side: str, inner_h: int, inner_w: int) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    patch[_container_mask(inner_h + 2, inner_w + 2, side)] = color
