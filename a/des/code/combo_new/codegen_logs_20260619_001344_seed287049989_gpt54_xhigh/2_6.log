+from __future__ import annotations
+
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+ORANGE = 7
+BORDER_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)
+DIRECTIONS = ("up", "right", "down", "left")
+ROTATIONS = {"up": 0, "right": 3, "down": 2, "left": 1}
+
+PAIR_COUNT_RANGE = (1, 3)
+SHAPE_SIDE_RANGE = (2, 4)
+CONTAINER_EXTRA_RANGE = (0, 2)
