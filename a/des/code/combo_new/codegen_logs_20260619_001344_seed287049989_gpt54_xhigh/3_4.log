+    core_w: int,
+    rng: random.Random,
+) -> None:
+    for _ in range(rng.randint(0, 3)):
+        side = rng.choice(("top", "bottom", "left", "right"))
+        depth = rng.randint(1, 2)
+
+        if side in ("top", "bottom"):
+            max_span = max(1, core_w - 1)
+            span = rng.randint(1, max_span)
+            start = rng.randint(0, core_w - span)
+            c0 = core_left + start
+            c1 = c0 + span
+            if side == "top":
