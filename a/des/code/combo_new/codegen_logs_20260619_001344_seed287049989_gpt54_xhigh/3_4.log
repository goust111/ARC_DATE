+        core[top : top + hole_h, left : left + hole_w] = False
+        reserved[top - 1 : top + hole_h + 1, left - 1 : left + hole_w + 1] = True
+        placed += 1
+
+    return placed == hole_count
+
+
+def _add_protrusions(
+    canvas: np.ndarray,
+    core_top: int,
+    core_left: int,
+    core_h: int,
+    core_w: int,
