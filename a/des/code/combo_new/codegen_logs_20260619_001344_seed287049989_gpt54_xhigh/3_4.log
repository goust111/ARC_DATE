+
+def _choose_hole_counts(object_count: int, rng: random.Random) -> list[int]:
+    positive_pool = [1, 2, 3]
+    counts = [0, rng.choice(positive_pool)]
+    while len(counts) < object_count:
+        counts.append(rng.choice([0, 1, 2, 3]))
+    rng.shuffle(counts)
