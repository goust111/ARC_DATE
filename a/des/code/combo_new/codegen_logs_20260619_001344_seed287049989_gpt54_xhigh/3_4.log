+) -> None:
+    for _ in range(rng.randint(0, 4)):
+        side = rng.choice(("top", "bottom", "left", "right"))
+        depth = rng.randint(1, 2)
+
+        if side in ("top", "bottom"):
+            max_span = max(1, core_w - 1)
+            span = rng.randint(1, max_span)
+            start = rng.randint(0, core_w - span)
+            c0 = core_left + start
+            c1 = c0 + span
+            if side == "top":
+                r0 = core_top - depth
+                r1 = core_top
+            else:
+                r0 = core_top + core_h
+                r1 = r0 + depth
+        else:
+            max_span = max(1, core_h - 1)
+            span = rng.randint(1, max_span)
+            start = rng.randint(0, core_h - span)
+            r0 = core_top + start
+            r1 = r0 + span
+            if side == "left":
+                c0 = core_left - depth
+                c1 = core_left
+            else:
+                c0 = core_left + core_w
+                c1 = c0 + depth
+
+        canvas[r0:r1, c0:c1] = True
+
+
+def _make_object_spec(hole_count: int, rng: random.Random) -> dict[str, object] | None:
+    for _ in range(OBJECT_RETRIES):
+        core_min = max(4, 3 + 2 * hole_count)
+        core_h = rng.randint(core_min, min(10, core_min + 3))
+        core_w = rng.randint(core_min, min(10, core_min + 4))
