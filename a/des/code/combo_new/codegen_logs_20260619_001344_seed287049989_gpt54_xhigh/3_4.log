+
+        grid = _place_objects(specs, rng)
+        if grid is None:
+            continue
+
+        actual_counts = _hole_counts_in_grid(grid)
+        if actual_counts != sorted(hole_counts):
+            continue
+        if not any(count == 0 for count in actual_counts):
+            continue
+        if not any(count > 0 for count in actual_counts):
+            continue
+
+        return grid
