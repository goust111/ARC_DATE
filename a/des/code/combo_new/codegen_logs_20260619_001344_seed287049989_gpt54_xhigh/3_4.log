        output_mask = spec["output_mask"]  # type: ignore[assignment]
        oh, ow = map(int, output_mask.shape)
        ih, iw = map(int, input_mask.shape)
        assert (ih, iw) == (oh, ow)
        if h - oh < 2 or w - ow < 2:
            return None

