+def _components_mask(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    assert connectivity in (4, 8)
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        dirs = DIRS4
+    else:
+        dirs = DIRS4 + ((1, 1), (1, -1), (-1, 1), (-1, -1))
