+    - Inside each size group, pair the two sprites whose masks become perfect complements after horizontally flipping one of them.
+    - Turn each recovered pair into a solid rectangle of that bbox size, colored by the smaller sprite in the pair.
+    - Sort the recovered rectangles by area from smallest to largest and stack them top-to-bottom with no gaps, left-aligned on a background canvas as wide as the widest rectangle.
+
+    Key insight:
+    - The scattered fragments are not output objects by themselves; each same-sized complementary pair encodes one full rectangle, and the smaller fragment decides that rectangle's final color.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    components = _find_components(g, bg)
+    assert components and len(components) % 2 == 0
+
+    groups: dict[tuple[int, int], list[dict]] = defaultdict(list)
+    for comp in components:
+        groups[tuple(map(int, comp["mask"].shape))].append(comp)
+
+    rectangles: list[tuple[int, int, int, int]] = []
+    for dims, group in groups.items():
+        pending = list(group)
+        while pending:
+            comp = pending.pop()
+            expected = np.logical_not(comp["mask"])
+            matches = [other for other in pending if np.array_equal(np.fliplr(other["mask"]), expected)]
+            assert len(matches) == 1
+            other = matches[0]
+            pending.remove(other)
+
+            h, w = dims
+            rect_area = h * w
+            assert comp["area"] + other["area"] == rect_area
+            assert comp["area"] != other["area"]
+            fill = int(comp["color"] if comp["area"] < other["area"] else other["color"])
+            rectangles.append((rect_area, h, w, fill))
+
+    rectangles.sort(key=lambda item: (item[0], item[1], item[2]))
+    out_h = sum(h for _, h, _, _ in rectangles)
+    out_w = max(w for _, _, w, _ in rectangles)
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    r = 0
+    for _, h, w, color in rectangles:
+        out[r : r + h, :w] = color
+        r += h
+    return out
+
+
+def _random_path_segment(
+    start: tuple[int, int],
+    target: tuple[int, int],
+    h: int,
+    w: int,
+    blocked: np.ndarray,
+    forbidden: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == target:
+            break
+        nbrs = list(_neighbors4(cell[0], cell[1], h, w))
+        random.shuffle(nbrs)
+        for nr, nc in nbrs:
+            nxt = (nr, nc)
+            if nxt in prev:
+                continue
+            if nxt != target and (blocked[nr, nc] or forbidden[nr, nc]):
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if target not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur = target
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _anchor_sequence(h: int, w: int) -> list[tuple[int, int]]:
+    interior_rows = list(range(1, h - 1))
+    interior_cols = list(range(1, w - 1))
+    endpoint_side = random.choice(("top", "bottom", "left", "right"))
+    reverse = random.choice((False, True))
+
+    if endpoint_side == "top":
+        c1, c2 = random.sample(interior_cols, 2)
+        top1 = (0, c1)
+        top2 = (0, c2)
+        left = (random.choice(interior_rows), 0)
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [top1, right, bottom, left, top2] if reverse else [top1, left, bottom, right, top2]
+
+    if endpoint_side == "bottom":
+        c1, c2 = random.sample(interior_cols, 2)
+        bottom1 = (h - 1, c1)
+        bottom2 = (h - 1, c2)
+        left = (random.choice(interior_rows), 0)
+        top = (0, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [bottom1, right, top, left, bottom2] if reverse else [bottom1, left, top, right, bottom2]
+
+    if endpoint_side == "left":
+        r1, r2 = random.sample(interior_rows, 2)
+        left1 = (r1, 0)
+        left2 = (r2, 0)
+        top = (0, random.choice(interior_cols))
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [left1, bottom, right, top, left2] if reverse else [left1, top, right, bottom, left2]
+
+    r1, r2 = random.sample(interior_rows, 2)
+    right1 = (r1, w - 1)
+    right2 = (r2, w - 1)
+    top = (0, random.choice(interior_cols))
+    bottom = (h - 1, random.choice(interior_cols))
+    left = (random.choice(interior_rows), 0)
+    return [right1, bottom, left, top, right2] if reverse else [right1, top, left, bottom, right2]
+
+
+def _random_pair_mask(h: int, w: int) -> np.ndarray | None:
+    for _ in range(PATH_ATTEMPTS):
+        anchors = _anchor_sequence(h, w)
+        mask = np.zeros((h, w), dtype=bool)
+        mask[anchors[0]] = True
+        path = [anchors[0]]
+        ok = True
+        for idx in range(1, len(anchors)):
+            forbidden = np.zeros((h, w), dtype=bool)
+            for fr, fc in anchors[idx + 1 :]:
+                forbidden[fr, fc] = True
+            segment = _random_path_segment(path[-1], anchors[idx], h, w, mask, forbidden)
+            if segment is None:
+                ok = False
+                break
+            for cell in segment[1:]:
+                mask[cell] = True
+                path.append(cell)
+        if not ok:
+            continue
