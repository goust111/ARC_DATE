+        if pair is None:
+            return None
+        region_a, region_b = pair
+        variants = [
+            (region_a, np.fliplr(region_b)),
+            (region_b, np.fliplr(region_a)),
+            (np.fliplr(region_a), region_b),
+            (np.fliplr(region_b), region_a),
