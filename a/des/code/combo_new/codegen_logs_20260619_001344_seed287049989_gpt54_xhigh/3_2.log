+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q = deque([start])
+    stepper = _neighbors4 if connectivity == 4 else _neighbors8
+    while q:
+        r, c = q.popleft()
+        for nr, nc in stepper(r, c, h, w):
+            if not mask[nr, nc] or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
+    return len(seen) == int(mask.sum())
