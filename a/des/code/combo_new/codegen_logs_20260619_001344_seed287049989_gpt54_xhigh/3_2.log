+        if current and (used + need > limit or random.random() < 0.18):
+            rows.append(current)
+            current = [obj]
+            used = w
+        else:
+            current.append(obj)
+            used += need
+    if current:
+        rows.append(current)
+    return rows
+
+
+def _layout_objects(objects: list[dict]) -> tuple[int, int, list[tuple[dict, int, int]]] | None:
