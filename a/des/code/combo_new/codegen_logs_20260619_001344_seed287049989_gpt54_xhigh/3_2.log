+            rs = slice(max(0, r0 - 1), min(h, r0 + obj_h + 1))
+            cs = slice(max(0, c0 - 1), min(w, c0 + obj_w + 1))
+            if occupied[rs, cs].any():
+                ok = False
+                break
+            occupied[rs, cs] = True
+        if ok:
