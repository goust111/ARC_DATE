+
+    r1, r2 = random.sample(interior_rows, 2)
+    right1 = (r1, w - 1)
+    right2 = (r2, w - 1)
+    top = (0, random.choice(interior_cols))
+    bottom = (h - 1, random.choice(interior_cols))
