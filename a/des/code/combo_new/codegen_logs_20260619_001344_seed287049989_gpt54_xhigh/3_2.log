+            h, w = dims
+            rect_area = h * w
+            assert comp["area"] + other["area"] == rect_area
+            assert comp["area"] != other["area"]
+            fill = int(comp["color"] if comp["area"] < other["area"] else other["color"])
+            rectangles.append((rect_area, h, w, fill))
