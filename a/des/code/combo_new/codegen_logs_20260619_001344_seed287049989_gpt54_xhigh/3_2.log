+import random
+from collections import Counter, deque, defaultdict
+
+import numpy as np
+
+
+ARC_MAX = 30
+PAIR_COUNT_RANGE = (2, 4)
+PAIR_HEIGHT_RANGE = (4, 7)
+PAIR_WIDTH_RANGE = (4, 7)
+MAX_GENERATION_ATTEMPTS = 300
+PAIR_MASK_ATTEMPTS = 120
+PATH_ATTEMPTS = 80
+LAYOUT_ATTEMPTS = 80
