+import random
+from collections import Counter, deque, defaultdict
+
+import numpy as np
+
+
+ARC_MAX = 30
+PAIR_COUNT_RANGE = (2, 4)
+PAIR_HEIGHT_RANGE = (4, 7)
+PAIR_WIDTH_RANGE = (4, 7)
+MAX_GENERATION_ATTEMPTS = 300
+PAIR_MASK_ATTEMPTS = 120
+PATH_ATTEMPTS = 80
+LAYOUT_ATTEMPTS = 80
+
+
+def get_bg(grid: np.ndarray) -> int:
+    counts = Counter(map(int, np.asarray(grid).ravel()))
+    return int(counts.most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not mask[nr, nc] or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _touches_all_borders(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    components: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(grid) if int(c) != bg):
+        seen = np.zeros((h, w), dtype=bool)
+        for r, c in np.argwhere(grid == color):
+            r = int(r)
+            c = int(c)
+            if seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            rows = [pt[0] for pt in cells]
+            cols = [pt[1] for pt in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                sprite[rr - r0, cc - c0] = True
+            components.append(
+                {
+                    "color": color,
+                    "area": len(cells),
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": sprite,
+                }
+            )
+    return components
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reassemble complementary sprite pairs into solid rectangles and stack them by area.
+
+    Input structure:
+    - A dominant background surrounds several monochrome 4-connected sprites, each in a unique color.
+    - The sprites come in pairs with identical bounding-box sizes.
+    - Within a pair, horizontally flipping one sprite makes its occupied cells exactly fill the other sprite's empty cells inside that shared bbox.
+
+    Rule:
+    - Find every monochrome sprite, record its bounding box, and group sprites by bbox size.
+    - Inside each size group, pair the two sprites whose masks become perfect complements after horizontally flipping one of them.
+    - Turn each recovered pair into a solid rectangle of that bbox size, colored by the smaller sprite in the pair.
+    - Sort the recovered rectangles by area from smallest to largest and stack them top-to-bottom with no gaps, left-aligned on a background canvas as wide as the widest rectangle.
+
+    Key insight:
+    - The scattered fragments are not output objects by themselves; each same-sized complementary pair encodes one full rectangle, and the smaller fragment decides that rectangle's final color.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    components = _find_components(g, bg)
+    assert components and len(components) % 2 == 0
+
+    groups: dict[tuple[int, int], list[dict]] = defaultdict(list)
+    for comp in components:
+        groups[tuple(map(int, comp["mask"].shape))].append(comp)
+
+    rectangles: list[tuple[int, int, int, int]] = []
+    for dims, group in groups.items():
+        pending = list(group)
+        while pending:
+            comp = pending.pop()
+            expected = np.logical_not(comp["mask"])
+            matches = [other for other in pending if np.array_equal(np.fliplr(other["mask"]), expected)]
+            assert len(matches) == 1
+            other = matches[0]
+            pending.remove(other)
+
+            h, w = dims
+            rect_area = h * w
+            assert comp["area"] + other["area"] == rect_area
+            assert comp["area"] != other["area"]
+            fill = int(comp["color"] if comp["area"] < other["area"] else other["color"])
+            rectangles.append((rect_area, h, w, fill))
+
+    rectangles.sort(key=lambda item: (item[0], item[1], item[2]))
+    out_h = sum(h for _, h, _, _ in rectangles)
+    out_w = max(w for _, _, w, _ in rectangles)
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    r = 0
+    for _, h, w, color in rectangles:
+        out[r : r + h, :w] = color
+        r += h
+    return out
+
+
+def _random_path_segment(
+    start: tuple[int, int],
+    target: tuple[int, int],
+    h: int,
+    w: int,
+    blocked: np.ndarray,
+    forbidden: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == target:
+            break
+        nbrs = list(_neighbors4(cell[0], cell[1], h, w))
+        random.shuffle(nbrs)
+        for nr, nc in nbrs:
+            nxt = (nr, nc)
+            if nxt in prev:
+                continue
+            if nxt != target and (blocked[nr, nc] or forbidden[nr, nc]):
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if target not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur = target
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _anchor_sequence(h: int, w: int) -> list[tuple[int, int]]:
+    interior_rows = list(range(1, h - 1))
+    interior_cols = list(range(1, w - 1))
+    endpoint_side = random.choice(("top", "bottom", "left", "right"))
+    reverse = random.choice((False, True))
+
+    if endpoint_side == "top":
+        c1, c2 = random.sample(interior_cols, 2)
+        top1 = (0, c1)
+        top2 = (0, c2)
+        left = (random.choice(interior_rows), 0)
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [top1, right, bottom, left, top2] if reverse else [top1, left, bottom, right, top2]
+
+    if endpoint_side == "bottom":
+        c1, c2 = random.sample(interior_cols, 2)
+        bottom1 = (h - 1, c1)
+        bottom2 = (h - 1, c2)
+        left = (random.choice(interior_rows), 0)
+        top = (0, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [bottom1, right, top, left, bottom2] if reverse else [bottom1, left, top, right, bottom2]
+
+    if endpoint_side == "left":
+        r1, r2 = random.sample(interior_rows, 2)
+        left1 = (r1, 0)
+        left2 = (r2, 0)
+        top = (0, random.choice(interior_cols))
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [left1, bottom, right, top, left2] if reverse else [left1, top, right, bottom, left2]
+
+    r1, r2 = random.sample(interior_rows, 2)
+    right1 = (r1, w - 1)
+    right2 = (r2, w - 1)
+    top = (0, random.choice(interior_cols))
+    bottom = (h - 1, random.choice(interior_cols))
+    left = (random.choice(interior_rows), 0)
+    return [right1, bottom, left, top, right2] if reverse else [right1, top, left, bottom, right2]
+
+
+def _random_pair_mask(h: int, w: int) -> np.ndarray | None:
+    for _ in range(PATH_ATTEMPTS):
+        anchors = _anchor_sequence(h, w)
+        mask = np.zeros((h, w), dtype=bool)
+        mask[anchors[0]] = True
+        path = [anchors[0]]
+        ok = True
+        for idx in range(1, len(anchors)):
+            forbidden = np.zeros((h, w), dtype=bool)
+            for fr, fc in anchors[idx + 1 :]:
+                forbidden[fr, fc] = True
+            segment = _random_path_segment(path[-1], anchors[idx], h, w, mask, forbidden)
+            if segment is None:
+                ok = False
+                break
+            for cell in segment[1:]:
+                mask[cell] = True
+                path.append(cell)
+        if not ok:
+            continue
+        if _pair_mask_valid(mask):
+            return mask
+    return None
+
+
+def _pair_mask_valid(mask: np.ndarray) -> bool:
+    comp = np.logical_not(mask)
+    return bool(
+        mask.any()
+        and comp.any()
+        and _touches_all_borders(mask)
+        and _touches_all_borders(comp)
+        and _is_connected(mask)
+        and _is_connected(comp)
+    )
+
+
+def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    candidates: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
