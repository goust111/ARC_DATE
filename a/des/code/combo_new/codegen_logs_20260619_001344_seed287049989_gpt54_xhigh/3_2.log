+    interior_cols = list(range(1, w - 1))
+    endpoint_side = random.choice(("top", "bottom", "left", "right"))
+    reverse = random.choice((False, True))
+
+    if endpoint_side == "top":
+        c1, c2 = random.sample(interior_cols, 2)
+        top1 = (0, c1)
+        top2 = (0, c2)
+        left = (random.choice(interior_rows), 0)
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [top1, right, bottom, left, top2] if reverse else [top1, left, bottom, right, top2]
+
+    if endpoint_side == "bottom":
+        c1, c2 = random.sample(interior_cols, 2)
+        bottom1 = (h - 1, c1)
+        bottom2 = (h - 1, c2)
+        left = (random.choice(interior_rows), 0)
+        top = (0, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [bottom1, right, top, left, bottom2] if reverse else [bottom1, left, top, right, bottom2]
