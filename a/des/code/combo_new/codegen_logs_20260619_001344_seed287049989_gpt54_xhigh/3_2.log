+        seen = np.zeros((h, w), dtype=bool)
+        for r, c in np.argwhere(grid == color):
+            r = int(r)
+            c = int(c)
+            if seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
