+        for r, c in np.argwhere(grid == color):
+            r = int(r)
+            c = int(c)
+            if seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in stepper(cr, cc, h, w):
