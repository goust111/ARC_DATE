+def _random_path_segment(
+    start: tuple[int, int],
+    target: tuple[int, int],
+    h: int,
+    w: int,
+    blocked: np.ndarray,
+    forbidden: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == target:
+            break
+        nbrs = list(_neighbors4(cell[0], cell[1], h, w))
+        random.shuffle(nbrs)
+        for nr, nc in nbrs:
+            nxt = (nr, nc)
+            if nxt in prev:
+                continue
+            if nxt != target and (blocked[nr, nc] or forbidden[nr, nc]):
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if target not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur = target
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
