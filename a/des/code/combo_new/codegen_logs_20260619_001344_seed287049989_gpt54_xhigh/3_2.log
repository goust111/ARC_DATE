+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if not mask[nr, nc] or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _touches_all_borders(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    components: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(grid) if int(c) != bg):
+        seen = np.zeros((h, w), dtype=bool)
+        for r, c in np.argwhere(grid == color):
+            r = int(r)
+            c = int(c)
+            if seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            rows = [pt[0] for pt in cells]
+            cols = [pt[1] for pt in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                sprite[rr - r0, cc - c0] = True
