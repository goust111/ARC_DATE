+            rows = [pt[0] for pt in cells]
+            cols = [pt[1] for pt in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                sprite[rr - r0, cc - c0] = True
+            components.append(
