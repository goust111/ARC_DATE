+    while q:
+        cell = q.popleft()
+        if cell == target:
+            break
+        nbrs = list(_neighbors4(cell[0], cell[1], h, w))
+        random.shuffle(nbrs)
+        for nr, nc in nbrs:
+            nxt = (nr, nc)
+            if nxt in prev:
+                continue
+            if nxt != target and (blocked[nr, nc] or forbidden[nr, nc]):
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if target not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur = target
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _anchor_sequence(h: int, w: int) -> list[tuple[int, int]]:
+    interior_rows = list(range(1, h - 1))
+    interior_cols = list(range(1, w - 1))
+    endpoint_side = random.choice(("top", "bottom", "left", "right"))
+    reverse = random.choice((False, True))
+
+    if endpoint_side == "top":
+        c1, c2 = random.sample(interior_cols, 2)
+        top1 = (0, c1)
+        top2 = (0, c2)
+        left = (random.choice(interior_rows), 0)
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [top1, right, bottom, left, top2] if reverse else [top1, left, bottom, right, top2]
+
+    if endpoint_side == "bottom":
+        c1, c2 = random.sample(interior_cols, 2)
+        bottom1 = (h - 1, c1)
+        bottom2 = (h - 1, c2)
+        left = (random.choice(interior_rows), 0)
+        top = (0, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [bottom1, right, top, left, bottom2] if reverse else [bottom1, left, top, right, bottom2]
+
+    if endpoint_side == "left":
+        r1, r2 = random.sample(interior_rows, 2)
+        left1 = (r1, 0)
+        left2 = (r2, 0)
+        top = (0, random.choice(interior_cols))
+        bottom = (h - 1, random.choice(interior_cols))
+        right = (random.choice(interior_rows), w - 1)
+        return [left1, bottom, right, top, left2] if reverse else [left1, top, right, bottom, left2]
+
+    r1, r2 = random.sample(interior_rows, 2)
+    right1 = (r1, w - 1)
+    right2 = (r2, w - 1)
+    top = (0, random.choice(interior_cols))
+    bottom = (h - 1, random.choice(interior_cols))
+    left = (random.choice(interior_rows), 0)
+    return [right1, bottom, left, top, right2] if reverse else [right1, top, left, bottom, right2]
+
+
+def _random_pair_mask(h: int, w: int) -> np.ndarray | None:
+    for _ in range(PATH_ATTEMPTS):
+        anchors = _anchor_sequence(h, w)
+        mask = np.zeros((h, w), dtype=bool)
+        mask[anchors[0]] = True
+        path = [anchors[0]]
+        ok = True
+        for idx in range(1, len(anchors)):
+            forbidden = np.zeros((h, w), dtype=bool)
+            for fr, fc in anchors[idx + 1 :]:
+                forbidden[fr, fc] = True
+            segment = _random_path_segment(path[-1], anchors[idx], h, w, mask, forbidden)
+            if segment is None:
+                ok = False
+                break
+            for cell in segment[1:]:
+                mask[cell] = True
+                path.append(cell)
+        if not ok:
+            continue
+        if _pair_mask_valid(mask):
+            return mask
+    return None
+
+
+def _pair_mask_valid(mask: np.ndarray) -> bool:
+    comp = np.logical_not(mask)
+    return bool(
+        mask.any()
+        and comp.any()
+        and _touches_all_borders(mask)
+        and _touches_all_borders(comp)
+        and _is_connected(mask)
+        and _is_connected(comp)
+    )
+
+
+def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    candidates: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
+        for nr, nc in _neighbors4(int(r), int(c), h, w):
+            if not mask[nr, nc]:
+                candidates.add((nr, nc))
+    valid: list[tuple[int, int]] = []
+    for r, c in candidates:
+        trial = mask.copy()
+        trial[r, c] = True
+        if _pair_mask_valid(trial):
+            valid.append((r, c))
+    return valid
+
+
+def _make_region_pair(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    area = h * w
+    for _ in range(PAIR_MASK_ATTEMPTS):
+        mask = _random_pair_mask(h, w)
+        if mask is None:
+            continue
+
+        target = random.randint(int(mask.sum()), area - 1)
+        while int(mask.sum()) < target:
+            candidates = _growth_candidates(mask)
+            if not candidates:
+                break
+            r, c = random.choice(candidates)
+            mask[r, c] = True
+
+        if int(mask.sum()) * 2 == area:
+            candidates = [cell for cell in _growth_candidates(mask) if (int(mask.sum()) + 1) * 2 != area]
+            if candidates:
+                r, c = random.choice(candidates)
+                mask[r, c] = True
+
+        if not _pair_mask_valid(mask):
+            continue
+        if int(mask.sum()) * 2 == area:
+            continue
+        return mask, np.logical_not(mask)
+    return None
+
+
+def _sample_pair_shapes(pair_count: int) -> list[tuple[int, int]] | None:
+    candidates = [(h, w) for h in range(PAIR_HEIGHT_RANGE[0], PAIR_HEIGHT_RANGE[1] + 1)
+                  for w in range(PAIR_WIDTH_RANGE[0], PAIR_WIDTH_RANGE[1] + 1)]
+    random.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    used_areas: set[int] = set()
+    height_sum = 0
+    for h, w in candidates:
+        area = h * w
+        if area in used_areas or height_sum + h > ARC_MAX:
+            continue
+        chosen.append((h, w))
+        used_areas.add(area)
+        height_sum += h
+        if len(chosen) == pair_count:
+            return chosen
+    return None
+
+
+def _random_composition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
+    bins: list[int] = []
+    prev = -1
+    limit = total + parts - 1
+    for cut in cuts + [limit]:
+        bins.append(cut - prev - 1)
+        prev = cut
+    return bins
+
+
+def _split_rows(objects: list[dict], limit: int) -> list[list[dict]]:
+    rows: list[list[dict]] = []
+    current: list[dict] = []
+    used = 0
+    for obj in objects:
+        h, w = obj["mask"].shape
+        need = w if not current else w + 1
+        if current and (used + need > limit or random.random() < 0.18):
+            rows.append(current)
+            current = [obj]
+            used = w
+        else:
+            current.append(obj)
+            used += need
+    if current:
+        rows.append(current)
+    return rows
+
+
+def _layout_objects(objects: list[dict]) -> tuple[int, int, list[tuple[dict, int, int]]] | None:
+    max_w = max(obj["mask"].shape[1] for obj in objects)
+    total_w = sum(obj["mask"].shape[1] for obj in objects) + len(objects) - 1
+    for _ in range(LAYOUT_ATTEMPTS):
+        order = objects[:]
+        random.shuffle(order)
+        low = max(max_w + 2, min(total_w, max_w + 2))
+        high = min(28, max(total_w, low))
+        if low > high:
+            return None
+        row_limit = random.randint(low, high)
+        rows = _split_rows(order, row_limit)
+
+        row_heights = [max(obj["mask"].shape[0] for obj in row) for row in rows]
+        row_gaps = [random.randint(1, 2) for _ in range(max(0, len(rows) - 1))]
+        pack_h = sum(row_heights) + sum(row_gaps)
+        if pack_h > 26:
+            continue
+
+        extra_h = random.randint(2, ARC_MAX - pack_h)
+        extra_w = random.randint(2, ARC_MAX - row_limit)
+        top_margin = random.randint(1, extra_h - 1)
+        left_margin = random.randint(1, extra_w - 1)
+        h = pack_h + extra_h
+        w = row_limit + extra_w
+
+        placements: list[tuple[dict, int, int]] = []
+        y = top_margin
+        ok = True
+        for row_idx, row in enumerate(rows):
+            row_h = row_heights[row_idx]
+            base_w = sum(obj["mask"].shape[1] for obj in row) + len(row) - 1
+            slack = row_limit - base_w
+            extras = _random_composition(slack, len(row) + 1)
+            x = left_margin + extras[0]
+            for item_idx, obj in enumerate(row):
+                obj_h, obj_w = obj["mask"].shape
+                y0 = y + random.randint(0, row_h - obj_h)
+                placements.append((obj, y0, x))
+                x += obj_w + 1 + extras[item_idx + 1]
+            y += row_h
+            if row_idx < len(row_gaps):
+                y += row_gaps[row_idx]
+
+        occupied = np.zeros((h, w), dtype=bool)
+        for obj, r0, c0 in placements:
+            obj_h, obj_w = obj["mask"].shape
+            rs = slice(max(0, r0 - 1), min(h, r0 + obj_h + 1))
+            cs = slice(max(0, c0 - 1), min(w, c0 + obj_w + 1))
+            if occupied[rs, cs].any():
+                ok = False
+                break
+            occupied[rs, cs] = True
+        if ok:
+            return h, w, placements
+    return None
+
+
+def _build_expected_output(bg: int, pair_meta: list[dict]) -> np.ndarray:
+    ordered = sorted(pair_meta, key=lambda item: (item["area"], item["h"], item["w"]))
+    out_h = sum(item["h"] for item in ordered)
+    out_w = max(item["w"] for item in ordered)
+    out = np.full((out_h, out_w), bg, dtype=int)
+    r = 0
+    for item in ordered:
+        out[r : r + item["h"], : item["w"]] = int(item["fill"])
+        r += item["h"]
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = random.randint(0, 9)
+    pair_count = random.randint(*PAIR_COUNT_RANGE)
+    shapes = _sample_pair_shapes(pair_count)
+    if shapes is None:
+        return None
+
+    colors = [c for c in range(10) if c != bg]
+    random.shuffle(colors)
+    if len(colors) < 2 * pair_count:
+        return None
+
+    objects: list[dict] = []
+    pair_meta: list[dict] = []
+    color_idx = 0
+    for h, w in shapes:
+        pair = _make_region_pair(h, w)
+        if pair is None:
+            return None
+        region_a, region_b = pair
+        variants = [
+            (region_a, np.fliplr(region_b)),
+            (region_b, np.fliplr(region_a)),
+            (np.fliplr(region_a), region_b),
+            (np.fliplr(region_b), region_a),
+        ]
+        mask1, mask2 = random.choice(variants)
+        color1 = colors[color_idx]
+        color2 = colors[color_idx + 1]
+        color_idx += 2
+
+        area1 = int(mask1.sum())
+        area2 = int(mask2.sum())
+        fill = color1 if area1 < area2 else color2
+        pair_meta.append({"area": h * w, "h": h, "w": w, "fill": fill})
+        objects.append({"mask": mask1, "color": color1})
+        objects.append({"mask": mask2, "color": color2})
+
+    layout = _layout_objects(objects)
+    if layout is None:
+        return None
+    h, w, placements = layout
+    grid = np.full((h, w), bg, dtype=int)
+    for obj, r0, c0 in placements:
+        mask = obj["mask"]
+        obj_h, obj_w = mask.shape
+        patch = grid[r0 : r0 + obj_h, c0 : c0 + obj_w]
+        patch[mask] = int(obj["color"])
+
+    counts = Counter(map(int, grid.ravel()))
+    if counts.most_common(1)[0][0] != bg:
+        return None
+
+    expected = _build_expected_output(bg, pair_meta)
+    try:
+        if np.array_equal(main(grid), expected):
+            return grid
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid complementary-pair input")

