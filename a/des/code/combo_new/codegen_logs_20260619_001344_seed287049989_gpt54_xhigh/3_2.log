+            return mask
+    return None
+
+
+def _pair_mask_valid(mask: np.ndarray) -> bool:
+    comp = np.logical_not(mask)
+    return bool(
+        mask.any()
+        and comp.any()
+        and _touches_all_borders(mask)
+        and _touches_all_borders(comp)
+        and _is_connected(mask)
+        and _is_connected(comp)
+    )
+
+
+def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    candidates: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
+        for nr, nc in _neighbors4(int(r), int(c), h, w):
+            if not mask[nr, nc]:
+                candidates.add((nr, nc))
+    valid: list[tuple[int, int]] = []
+    for r, c in candidates:
+        trial = mask.copy()
+        trial[r, c] = True
+        if _pair_mask_valid(trial):
+            valid.append((r, c))
+    return valid
+
+
+def _make_region_pair(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    area = h * w
+    for _ in range(PAIR_MASK_ATTEMPTS):
+        mask = _random_pair_mask(h, w)
+        if mask is None:
+            continue
+
+        target = random.randint(int(mask.sum()), area - 1)
+        while int(mask.sum()) < target:
+            candidates = _growth_candidates(mask)
+            if not candidates:
+                break
+            r, c = random.choice(candidates)
+            mask[r, c] = True
+
+        if int(mask.sum()) * 2 == area:
+            candidates = [cell for cell in _growth_candidates(mask) if (int(mask.sum()) + 1) * 2 != area]
+            if candidates:
+                r, c = random.choice(candidates)
+                mask[r, c] = True
+
+        if not _pair_mask_valid(mask):
+            continue
+        if int(mask.sum()) * 2 == area:
+            continue
+        return mask, np.logical_not(mask)
+    return None
+
+
+def _sample_pair_shapes(pair_count: int) -> list[tuple[int, int]] | None:
+    candidates = [(h, w) for h in range(PAIR_HEIGHT_RANGE[0], PAIR_HEIGHT_RANGE[1] + 1)
+                  for w in range(PAIR_WIDTH_RANGE[0], PAIR_WIDTH_RANGE[1] + 1)]
