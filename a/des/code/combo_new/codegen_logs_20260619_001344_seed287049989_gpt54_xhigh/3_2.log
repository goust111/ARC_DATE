+        mask1, mask2 = random.choice(variants)
+        color1 = colors[color_idx]
+        color2 = colors[color_idx + 1]
+        color_idx += 2
+
+        area1 = int(mask1.sum())
+        area2 = int(mask2.sum())
+        fill = color1 if area1 < area2 else color2
