+        rr1 = min(H, r0 + h + 1)
+        cc1 = min(W, c0 + w + 1)
+        blocked[rr0:rr1, cc0:cc1] = True
+        return int(r0), int(c0)
+
+    return None
+
+
+def _expected_branches(count: int) -> list[str]:
