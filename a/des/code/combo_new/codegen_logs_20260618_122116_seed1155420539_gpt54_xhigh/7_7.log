    return out, left_placements + right_placements


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(*GRID_HEIGHT_BOUNDS)
    w = random.randint(*GRID_WIDTH_BOUNDS)
    bg = BACKGROUND_COLOR
