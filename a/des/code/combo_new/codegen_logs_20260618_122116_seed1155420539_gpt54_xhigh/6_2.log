+    feasible: list[tuple[list[list[int]], list[int], list[int], int, int]] = []
+    count = len(boxes)
+
+    for pattern in _row_patterns(count):
+        for order in __import__("itertools").permutations(range(count)):
+            rows: list[list[int]] = []
+            idx = 0
+            for size in pattern:
+                rows.append(list(order[idx : idx + size]))
+                idx += size
