+    raise AssertionError("failed to build a valid local box")
+
+
+def _pack_boxes(boxes: list[tuple[np.ndarray, np.ndarray]]) -> tuple[np.ndarray, np.ndarray]:
+    shapes = [(box_in.shape[0], box_in.shape[1]) for box_in, _box_out in boxes]
+    max_h = max(h for h, _w in shapes)
+    max_w = max(w for _h, w in shapes)
+    total_area = sum((h + 1) * (w + 1) for h, w in shapes)
+
+    for _ in range(PACK_RETRIES):
+        h = random.randint(max_h, MAX_GRID)
+        w = random.randint(max_w, MAX_GRID)
+        if h * w < total_area:
+            continue
+
+        occupied = np.zeros((h, w), dtype=bool)
+        positions: list[tuple[int, int] | None] = [None] * len(boxes)
+        order = list(range(len(boxes)))
+        random.shuffle(order)
+        order.sort(key=lambda idx: boxes[idx][0].shape[0] * boxes[idx][0].shape[1], reverse=True)
+
+        ok = True
+        for idx in order:
+            box_h, box_w = boxes[idx][0].shape
+            choices: list[tuple[int, int]] = []
+            for r0 in range(h - box_h + 1):
+                for c0 in range(w - box_w + 1):
+                    r1 = r0 + box_h
+                    c1 = c0 + box_w
+                    rr0 = max(0, r0 - 1)
+                    cc0 = max(0, c0 - 1)
+                    rr1 = min(h, r1 + 1)
+                    cc1 = min(w, c1 + 1)
+                    if not occupied[rr0:rr1, cc0:cc1].any():
+                        choices.append((r0, c0))
+            if not choices:
+                ok = False
+                break
+            positions[idx] = random.choice(choices)
+            r0, c0 = positions[idx]
+            occupied[r0 : r0 + box_h, c0 : c0 + box_w] = True
+
+        if not ok:
+            continue
+
+        full_in = np.full((h, w), BLACK, dtype=int)
+        full_out = np.full((h, w), BLACK, dtype=int)
+        for idx, (box_in, box_out) in enumerate(boxes):
+            r0, c0 = positions[idx]
+            hh, ww = box_in.shape
+            in_mask = box_in != BLACK
+            out_mask = box_out != BLACK
+            full_in[r0 : r0 + hh, c0 : c0 + ww][in_mask] = box_in[in_mask]
+            full_out[r0 : r0 + hh, c0 : c0 + ww][out_mask] = box_out[out_mask]
+
+        if np.array_equal(main(full_in), full_out):
+            return full_in, full_out
+
+    raise AssertionError("failed to pack local boxes into a global grid")
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        color_count = random.randint(2, 4)
+        colors = random.sample(PALETTE, color_count)
+        boxes = [_build_local_box(color) for color in colors]
+        grid_in, grid_out = _pack_boxes(boxes)
+        assert grid_in.ndim == 2 and max(grid_in.shape) <= MAX_GRID
+        assert grid_out.ndim == 2 and max(grid_out.shape) <= MAX_GRID
+        assert np.array_equal(main(grid_in), grid_out)
+        return grid_in
+    raise AssertionError("failed to generate a valid puzzle instance")

