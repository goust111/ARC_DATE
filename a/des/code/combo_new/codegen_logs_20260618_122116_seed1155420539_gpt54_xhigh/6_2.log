+
+    for lengths in _compositions(total, fragment_count):
+        for start in range(total):
+            parts: list[list[tuple[int, int]]] = []
+            idx = start
+            ok = True
+            for length in lengths:
+                frag = [cycle[(idx + step) % total] for step in range(length)]
+                if not _is_line_or_l(frag):
