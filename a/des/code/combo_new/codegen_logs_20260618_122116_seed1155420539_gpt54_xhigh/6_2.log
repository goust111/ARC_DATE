+    return matches[0]
+
+
+def _shift_limit(coords: list[tuple[int, int]], direction: tuple[int, int], h: int, w: int) -> int:
+    dr, dc = direction
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    if dr == 1:
