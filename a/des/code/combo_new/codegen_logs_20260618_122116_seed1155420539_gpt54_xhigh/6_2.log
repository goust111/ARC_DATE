+
+def _valid_partitions(height: int, width: int, fragment_count: int) -> list[list[list[tuple[int, int]]]]:
+    key = (height, width, fragment_count)
+    if key in _PARTITION_CACHE:
+        return _PARTITION_CACHE[key]
