+    rec(total, parts, [])
+    return out
+
+
+def _is_line_or_l(coords: list[tuple[int, int]]) -> bool:
+    turns: list[tuple[int, int]] = []
+    for a, b in zip(coords, coords[1:]):
+        step = (b[0] - a[0], b[1] - a[1])
+        if not turns or turns[-1] != step:
+            turns.append(step)
+    return len(turns) <= 2
