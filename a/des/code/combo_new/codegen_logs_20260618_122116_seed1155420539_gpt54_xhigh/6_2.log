BLACK=0
GREY=5
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]


def perimeter(h,w):
    pts=[]
    for c in range(w): pts.append((0,c))
    for r in range(1,h): pts.append((r,w-1))
    for c in range(w-2,-1,-1): pts.append((h-1,c))
    for r in range(h-2,0,-1): pts.append((r,0))
    return pts

def comps(total, parts, lo=3, hi=6):
    out=[]
    def rec(rem,k,cur):
        if k==0:
            if rem==0: out.append(cur[:])
            return
        for x in range(lo,hi+1):
            if rem-x < (k-1)*lo or rem-x > (k-1)*hi: continue
            cur.append(x); rec(rem-x,k-1,cur); cur.pop()
    rec(total,parts,[])
    return out

def line_or_l(seq):
    ds=[]
    for a,b in zip(seq,seq[1:]):
        d=(b[0]-a[0], b[1]-a[1])
        if not ds or ds[-1]"'!=d: ds.append(d)
    return len(ds)<=2

def valid_parts(h,w,m):
    cyc=perimeter(h,w); P=len(cyc); vals=[]
    for lens in comps(P,m):
        for s in range(P):
            arcs=[]; idx=s; ok=True
            for L in lens:
                arc=[cyc[(idx+t)%P] for t in range(L)]
                if not line_or_l(arc): ok=False; break
                arcs.append(arc); idx=(idx+L)%P
            if ok: vals.append(arcs)
    return vals

def neighbors(p):
    r,c=p
    for dr,dc in DIRS: yield (r+dr,c+dc)

def internal_deg(coords):
    s=set(coords)
    return {p:sum((q in s) for q in neighbors(p)) for p in s}

def solve(frags,H,W):
    cands=[]
    for coords,dir_,deg in frags:
        rs=[r for r,c in coords]; cs=[c for r,c in coords]
        dr,dc=dir_
        if dr==1: K=H-1-max(rs)
        elif dr==-1: K=min(rs)
        elif dc==1: K=W-1-max(cs)
        else: K=min(cs)
        opts=[]
        for k in range(K+1):
            pts=[(r+k*dr,c+k*dc) for r,c in coords]
            opts.append((k,pts,{(r+k*dr,c+k*dc):deg[(r,c)] for r,c in coords}))
        cands.append(opts)
    order=sorted(range(len(frags)), key=lambda i: len(cands[i]))
    occ={}; used={}; sols=[]; placed=[None]*len(frags)
    def dfs(ix):
        if len(sols)>1: return
        if ix==len(order):
            if any(used[p] != 2-occ[p] for p in occ): return
            pts=set(occ)
            q=deque([next(iter(pts))]); seen={q[0]}
            while q:
                p=q.popleft()
                for nb in neighbors(p):
                    if nb in pts and nb not in seen:
                        seen.add(nb); q.append(nb)
            if len(seen)==len(pts): sols.append(placed.copy())
            return
        fi=order[ix]
        for k,pts,degs in cands[fi]:
            s=set(pts)
            if any(p in occ for p in s):
                continue
            add_old=defaultdict(int); ext_new={p:0 for p in s}; bad=False
            for p in s:
                cap=2-degs[p]
                for nb in neighbors(p):
                    if nb in occ:
                        ext_new[p]+=1; add_old[nb]+=1
                if ext_new[p] > cap:
                    bad=True; break
            if bad: continue
            for nb,add in add_old.items():
                if used[nb]+add > 2-occ[nb]:
                    bad=True; break
            if bad: continue
            for p in s:
                occ[p]=degs[p]; used[p]=ext_new[p]
            for nb,add in add_old.items(): used[nb]+=add
            placed[fi]=k
            dfs(ix+1)
            placed[fi]=None
            for nb,add in add_old.items(): used[nb]-=add
            for p in s:
                del occ[p]; del used[p]
    dfs(0)
    return sols

success=0
trials=500
for _ in range(trials):
    ok=False
    for __ in range(100):
        h=random.randint(3,5); w=random.randint(3,5); m=random.randint(2,4)
        parts=valid_parts(h,w,m)
        if not parts: continue
        arcs=random.choice(parts)
        pad=4; H=h+2*pad; W=w+2*pad
        shifted=[]; occ=set(); greys=set(); fail=False
        final=[[(r+pad,c+pad) for r,c in arc] for arc in arcs]
        for i,arc in enumerate(final):
            mark_end=random.randint(0,1)
            if mark_end==0:
                ep=arc[0]; prev=final[i-1][-1]; d=(prev[0]-ep[0], prev[1]-ep[1])
            else:
                ep=arc[-1]; nxt=final[(i+1)%m][0]; d=(nxt[0]-ep[0], nxt[1]-ep[1])
            t=random.randint(1,3)
            moved=[(r-t*d[0], c-t*d[1]) for r,c in arc]
            grey=(moved[0][0]+d[0], moved[0][1]+d[1]) if mark_end==0 else (moved[-1][0]+d[0], moved[-1][1]+d[1])
            for p in moved:
                if not(0<=p[0]<H and 0<=p[1]<W) or p in occ:
                    fail=True
            if grey in occ or grey in greys or not(0<=grey[0]<H and 0<=grey[1]<W): fail=True
            occ.update(moved); greys.add(grey)
            shifted.append((moved,d,internal_deg(moved)))
        if fail: continue
        # fragments separate and grey unique neighbor
        occ_all=set().union(*[set(c) for c,_,_ in shifted])
        for coords,_,_ in shifted:
            s=set(coords)
            if any(nb in occ_all and nb not in s for p in s for nb in neighbors(p)):
                fail=True
                break
        if fail: continue
        sols=solve(shifted,H,W)
        if len(sols)==1:
            ok=True;break
    success += ok
print('"'success',success,'/',trials)
