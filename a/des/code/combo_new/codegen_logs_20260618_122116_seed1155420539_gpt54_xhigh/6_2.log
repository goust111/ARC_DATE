+def _pack_boxes(boxes: list[tuple[np.ndarray, np.ndarray]]) -> tuple[np.ndarray, np.ndarray]:
+    shapes = [(box_in.shape[0], box_in.shape[1]) for box_in, _box_out in boxes]
+    max_h = max(h for h, _w in shapes)
