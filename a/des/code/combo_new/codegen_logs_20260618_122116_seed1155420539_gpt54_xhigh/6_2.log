+    return comps
+
+
+def _component_degrees(coords: list[tuple[int, int]]) -> dict[tuple[int, int], int]:
+    cells = set(coords)
+    deg = {}
+    for r, c in coords:
+        deg[(r, c)] = sum((nr, nc) in cells for nr, nc in _neighbors4(r, c))
