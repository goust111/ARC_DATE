+        markers: list[tuple[int, int]] = []
+        colored_cells: set[tuple[int, int]] = set()
+        ok = True
+
+        for idx, arc in enumerate(final_arcs):
+            mark_last = bool(random.getrandbits(1))
+            if mark_last:
