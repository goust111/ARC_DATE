+            if len(neighbors) != 1:
+                ok = False
+                break
+            if any((nr, nc) in marker_set and (nr, nc) != grey for nr, nc in _neighbors4(grey[0], grey[1])):
+                ok = False
+                break
+        if not ok:
+            continue
+
+        local_in = np.full((box_h, box_w), BLACK, dtype=int)
+        local_out = np.full((box_h, box_w), BLACK, dtype=int)
