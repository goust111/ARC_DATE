+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _translate(coords: list[tuple[int, int]], dr: int, dc: int, k: int) -> list[tuple[int, int]]:
+    return [(r + dr * k, c + dc * k) for r, c in coords]
