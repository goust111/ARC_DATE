+    if side == "left":
+        rows = [r for r, c in shape if c == 0]
+        return int(r0 + random.choice(rows)), int(c0 - 1)
+    rows = [r for r, c in shape if c == w - 1]
+    return int(r0 + random.choice(rows)), int(c0 + w)
