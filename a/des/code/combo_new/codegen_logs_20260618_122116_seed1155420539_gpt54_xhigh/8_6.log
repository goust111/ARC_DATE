+        solved = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
