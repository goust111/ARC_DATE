+    if side == "R":
+        return 1, 1, grid_h - 2, grid_w - strip_w - 5
+    if side == "T":
+        return strip_h + 4, 1, grid_h - 2, grid_w - 2
+    return 1, 1, grid_h - strip_h - 5, grid_w - 2
+
+
+def _gen_attempt() -> np.ndarray | None:
