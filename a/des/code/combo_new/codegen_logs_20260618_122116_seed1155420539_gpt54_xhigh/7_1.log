+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return not np.any(occ[rr0 : rr1 + 1, cc0 : cc1 + 1])
+
+
+def _paste(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    mask = patch != BG
+    target = grid[top : top + h, left : left + w]
+    target[mask] = patch[mask]
