+
+
+def _reserve(occ: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    h, w = occ.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    occ[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _can_place(occ: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:
