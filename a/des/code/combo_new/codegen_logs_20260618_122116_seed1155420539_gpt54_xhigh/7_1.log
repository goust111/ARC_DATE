+
+
+def _draw_frame(h: int, w: int, pattern: tuple[tuple[str, int, int], ...], color: int = FRAME_COLOR) -> np.ndarray:
+    patch = np.full((h, w), BG, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    for side, num, den in pattern:
+        if side in ("T", "B"):
+            assert (w - 1) % den == 0
+            c = ((w - 1) // den) * num
+            r = 0 if side == "T" else h - 1
+        else:
+            assert (h - 1) % den == 0
+            r = ((h - 1) // den) * num
+            c = 0 if side == "L" else w - 1
