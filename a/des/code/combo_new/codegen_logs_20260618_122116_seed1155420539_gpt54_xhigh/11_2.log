+    for tile_r, (shape, color) in enumerate(zip(chosen_shapes, legend_colors)):
+        tile = _render_shape_tile(tile_h, tile_w, shape, BLUE, reserve_bottom_right=True)
+        if tile is None:
+            return None
+        tile[-1, -1] = color
+        _paste_tile(inp, tile, tile_r, 0, tile_h, tile_w)
