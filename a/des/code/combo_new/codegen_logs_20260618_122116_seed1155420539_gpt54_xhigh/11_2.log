    tile_rows: int,
    tile_cols: int,
    tile_h: int,
    tile_w: int,
    shape_to_color: dict[tuple[tuple[int, int], ...], int],
) -> np.ndarray:
    out = inp.copy()
    for tile_r in range(tile_rows):
        for tile_c in range(1, tile_cols):
