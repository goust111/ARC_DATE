+def _normalize_shape(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    rows = coords[:, 0].astype(int)
+    cols = coords[:, 1].astype(int)
+    return tuple(sorted((int(r - rows.min()), int(c - cols.min())) for r, c in zip(rows, cols)))
