+            if start is not None:
+                spans.append((start, idx - 1))
+                start = None
+            continue
+        if start is None:
+            start = idx
+    if start is not None:
+        spans.append((start, length - 1))
+    return spans
+
+
+def _separator_structure(grid: np.ndarray) -> tuple[int, list[tuple[int, int]], list[tuple[int, int]]]:
