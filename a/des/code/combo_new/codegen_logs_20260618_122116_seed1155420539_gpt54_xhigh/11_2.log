+        return None
+
+    offsets = []
+    for r0 in range(tile_h - shape_h + 1):
+        for c0 in range(tile_w - shape_w + 1):
+            cells = {(r0 + r, c0 + c) for r, c in shape}
+            if reserve_bottom_right and (tile_h - 1, tile_w - 1) in cells:
+                continue
