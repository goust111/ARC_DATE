+
+
+def _cells_clear(grid: np.ndarray, bg: int, cells: list[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    cell_set = set(cells)
+    for r, c in cell_set:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
