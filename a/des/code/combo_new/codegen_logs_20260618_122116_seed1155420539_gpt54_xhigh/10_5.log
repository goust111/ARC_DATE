+def _overlap_area(a: dict[str, int], b: dict[str, int]) -> int:
+    dh = max(0, min(int(a["top"] + a["h"]), int(b["top"] + b["h"])) - max(int(a["top"]), int(b["top"])))
+    dw = max(0, min(int(a["left"] + a["w"]), int(b["left"] + b["w"])) - max(int(a["left"]), int(b["left"])))
