+        cells = {(random.randrange(size), random.randrange(size))}
+        while len(cells) < target:
+            frontier = {
+                nbr
+                for r, c in cells
+                for nbr in _neighbors4(r, c, size)
+                if nbr not in cells
+            }
+            if not frontier:
+                break
+            cells.add(random.choice(tuple(frontier)))
+
+        if len(cells) != target:
+            continue
+
+        mask = np.zeros((size, size), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
