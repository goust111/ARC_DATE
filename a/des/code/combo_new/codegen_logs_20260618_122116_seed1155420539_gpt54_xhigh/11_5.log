+
+
+def _build_input(
+    row_sizes: list[int],
+    col_sizes: list[int],
+    tree_edges: list[tuple[int, int]],
+    pair_paths: list[list[int]],
+    pair_colors: list[int],
+) -> tuple[np.ndarray, dict[int, tuple[int, int, int, int]], dict[tuple[int, int], tuple[int, int]]] | None:
