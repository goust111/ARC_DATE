+
+def _sample_margins(bbox_size: int) -> tuple[int, int] | None:
+    slack = MAX_GRID_SIZE - bbox_size
+    if slack < 0:
+        return None
+    total = random.randint(0, min(MAX_MARGIN_TOTAL, slack))
+    lead = random.randint(0, total)
