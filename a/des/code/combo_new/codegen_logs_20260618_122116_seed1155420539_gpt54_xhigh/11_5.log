+
+
+def _bfs_path_allowed(
+    room_rows: int,
+    room_cols: int,
+    allowed: set[int],
+    start: int,
+    goal: int,
+) -> list[int] | None:
+    if start not in allowed or goal not in allowed:
+        return None
+    parent = {int(start): -1}
+    queue = deque([int(start)])
+    while queue and goal not in parent:
+        room_id = queue.popleft()
+        for neighbor in _room_neighbors(room_rows, room_cols, room_id):
+            if neighbor not in allowed or neighbor in parent:
+                continue
+            parent[neighbor] = room_id
+            queue.append(neighbor)
+    if goal not in parent:
+        return None
+    path = [int(goal)]
+    while path[-1] != start:
+        path.append(parent[path[-1]])
+    path.reverse()
+    return path
+
+
+def _available_adjacent_paths(
+    room_rows: int,
+    room_cols: int,
+    available: set[int],
+) -> list[list[int]]:
+    paths: list[list[int]] = []
+    for a, b in _grid_edges(room_rows, room_cols):
+        if a in available and b in available:
+            paths.append([a, b])
+    return paths
+
+
+def _candidate_long_paths(
+    room_rows: int,
+    room_cols: int,
+    available: set[int],
+    min_len: int,
+) -> list[list[int]]:
