+    paths: list[list[int]] = []
+    for idx, start in enumerate(rooms):
+        for goal in rooms[idx + 1 :]:
+            path = _bfs_path_allowed(room_rows, room_cols, available, start, goal)
+            if path is None or len(path) - 1 < min_len:
