+
+
+def _adjacency_from_edges(
+    room_rows: int,
+    room_cols: int,
+    edges: list[tuple[int, int]],
+) -> list[list[int]]:
+    adjacency = [set() for _ in range(room_rows * room_cols)]
+    for a, b in edges:
+        adjacency[a].add(b)
+        adjacency[b].add(a)
