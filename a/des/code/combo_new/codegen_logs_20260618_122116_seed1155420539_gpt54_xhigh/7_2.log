+def _row_interval(mask: np.ndarray, row: int) -> tuple[int, int]:
+    cols = np.flatnonzero(mask[row])
+    assert cols.size > 0, "each fragment row must contain foreground"
+    start = int(cols[0])
+    end = int(cols[-1])
