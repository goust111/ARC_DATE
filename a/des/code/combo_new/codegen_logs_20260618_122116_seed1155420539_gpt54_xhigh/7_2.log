+    return specs
+
+
+def _paste(sprite: np.ndarray, grid: np.ndarray, top: int, left: int) -> None:
+    h, w = sprite.shape
+    mask = sprite != BG
+    grid[top : top + h, left : left + w][mask] = sprite[mask]
