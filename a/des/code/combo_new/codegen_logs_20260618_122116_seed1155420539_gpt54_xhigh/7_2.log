+def _component_sprite(component: dict) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    color = int(component["color"])
+    sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    for r, c in component["coords"]:
+        sprite[int(r) - r0, int(c) - c0] = color
+    return sprite
+
