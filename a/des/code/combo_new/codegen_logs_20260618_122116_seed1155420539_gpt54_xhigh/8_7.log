+ARC_LIMIT = 30
+GRAY = 5
+MAX_GENERATION_ATTEMPTS = 400
+ROW_COUNT_RANGE = (2, 6)
+COL_COUNT_RANGE = (2, 6)
+LEFT_WIDTH_RANGE = (4, 10)
+RIGHT_EXTRA_WIDTH_RANGE = (2, 8)
