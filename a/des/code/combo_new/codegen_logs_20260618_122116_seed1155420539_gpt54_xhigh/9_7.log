+    ib = RING_INDEX[color_b]
+    delta = (ib - ia) % len(RING_COLORS)
+    if delta == 0:
+        return color_a
+    if delta == 2:
+        return RING_COLORS[(ia + 1) % len(RING_COLORS)]
+    if delta == 5:
+        return RING_COLORS[(ib + 1) % len(RING_COLORS)]
