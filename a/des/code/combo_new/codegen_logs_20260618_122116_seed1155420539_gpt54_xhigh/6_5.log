+        return [(r, c - 1) for r, c in shape_cells if c == edge]
+    edge = max(c for _, c in shape_cells)
+    return [(r, c + 1) for r, c in shape_cells if c == edge]
+
+
+def _fits_direction_zone(
+    top: int, left: int, height: int, width: int, h: int, w: int, shadow_dir: str
