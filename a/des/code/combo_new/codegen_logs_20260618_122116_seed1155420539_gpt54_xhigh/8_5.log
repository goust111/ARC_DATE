+    idx0, idx1 = sorted(rng.sample(range(color_count), 2))
+    reps = 2 if max_votes >= 4 and rng.random() < 0.6 else 1
+    votes = [source_colors[idx0]] * reps + [source_colors[idx1]] * reps
+    rng.shuffle(votes)
+    return votes
