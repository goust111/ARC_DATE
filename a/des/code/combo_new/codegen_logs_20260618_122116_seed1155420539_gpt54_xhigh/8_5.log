+    assert candidates, "failed to detect palette legend"
+    _, _, _, pairs = max(candidates, key=lambda item: (item[0], item[1], -item[2]))
+
+    mapping = {src: dst for src, dst in pairs}
+    tie_order: list[int] = []
+    for _, dst in pairs:
+        if dst not in tie_order:
+            tie_order.append(dst)
