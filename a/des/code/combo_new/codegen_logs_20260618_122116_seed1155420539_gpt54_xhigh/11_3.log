+            sub[local_input != BG] = local_input[local_input != BG]
+            total_red += int(np.sum(local_input == RED))
+
+        if not ok or total_red == 0:
+            continue
+
+        try:
+            out = main(grid)
+        except AssertionError:
+            continue
+        if max(grid.shape) > 30 or max(out.shape) > 30:
