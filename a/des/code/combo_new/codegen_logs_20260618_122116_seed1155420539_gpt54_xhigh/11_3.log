+                        prev = cell
+                    if not ok:
+                        continue
+
+                    for cell in new_cells:
+                        used.add(cell)
+                    seq.extend(new_cells)
+                    ends.append(len(seq) - 1)
+                    if rec(depth + 1, (dr, dc)):
+                        return True
+                    ends.pop()
+                    del seq[-len(new_cells) :]
+                    for cell in new_cells:
+                        used.remove(cell)
+
+            return False
+
+        if rec(0, None):
