+def _line_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]] | None:
+    if a[0] == b[0]:
+        step = 1 if b[1] >= a[1] else -1
+        return [(a[0], c) for c in range(a[1], b[1] + step, step)]
+    if a[1] == b[1]:
