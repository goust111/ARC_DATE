    cells=set(cells)
    rem=set(cells)
    comps=[]
    idx={}
    while rem:
        s=rem.pop(); q=[s]; comp=[s]; idx[s]=len(comps)
        while q:
            cur=q.pop()
            for nn in nbr4(cur):
                if nn in rem:
                    rem.remove(nn); q.append(nn); comp.append(nn); idx[nn]=len(comps)
        comps.append(comp)
    return comps, idx

def endpoints(cells):
    s=set(cells)
    out=[]
    for cell in s:
        deg=sum(nn in s for nn in nbr4(cell))
        if deg==1: out.append(cell)
