    if a[0]==b[0] or a[1]==b[1]:
        yield line(a,b)
        return
    for bend in [(a[0],b[1]), (b[0],a[1])]:
        p1=line(a,bend)
        p2=line(bend,b)
        if p1 is None or p2 is None:
