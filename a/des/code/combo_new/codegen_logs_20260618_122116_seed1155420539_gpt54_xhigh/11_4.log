+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _render_expected(grid: np.ndarray, roots: list[_Node], legend_colors: list[int]) -> np.ndarray:
