+    r0, c0, r1, c1 = _bbox(coords)
+    hh = r1 - r0 + 1
+    ww = c1 - c0 + 1
+    if hh < 3 or ww < 3:
+        return None
+
+    observed = np.zeros((hh, ww), dtype=bool)
+    observed[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    expected = np.zeros((hh, ww), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
