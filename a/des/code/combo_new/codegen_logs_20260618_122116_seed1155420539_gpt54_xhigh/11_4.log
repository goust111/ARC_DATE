+    observed = np.zeros((hh, ww), dtype=bool)
+    observed[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    expected = np.zeros((hh, ww), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+
+    if not np.array_equal(observed, expected):
+        return None
+    return _Rect(bbox=(r0, c0, r1, c1), color=int(colors[0]))
