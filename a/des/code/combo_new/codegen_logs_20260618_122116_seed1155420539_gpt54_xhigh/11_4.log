+
+def _build_tree(rng: random.Random) -> list[_Node]:
+    mode = rng.choice(("chain", "branch", "two_roots", "mixed"))
+
+    if mode == "chain":
+        return [_make_chain(rng.randint(2, 4))]
+
+    if mode == "branch":
+        root = _Node(children=[_Node() for _ in range(rng.randint(2, 3))])
