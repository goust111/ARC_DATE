+    root_sizes = [root.size for root in roots]
+    root_offsets, (content_h, content_w) = _arrange_boxes(root_sizes, rng)
+
+    max_depth = max(node.depth for node in nodes)
+    legend_colors = rng.sample(COLORS, max_depth + 1)
