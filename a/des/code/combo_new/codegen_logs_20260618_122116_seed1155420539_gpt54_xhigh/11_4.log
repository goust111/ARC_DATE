+    bottom = rng.randint(2, 3)
+    left = rng.randint(2, 3)
+    right = rng.randint(2, 3)
+    node.child_offsets = [(top + dr, left + dc) for dr, dc in child_offsets]
+    node.size = (top + content_h + bottom, left + content_w + right)
