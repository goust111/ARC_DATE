+    legend_start = height - len(legend_colors)
+    for idx, color in enumerate(legend_colors):
+        grid[legend_start + idx, width - 1] = color
+
+    expected = _render_expected(grid, roots, legend_colors)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
