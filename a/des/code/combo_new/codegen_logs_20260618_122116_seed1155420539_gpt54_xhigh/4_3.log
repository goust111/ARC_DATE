+
+            mask = np.zeros_like(visited)
+            rows, cols = zip(*coords)
+            mask[rows, cols] = True
+            dist = _layer_distances(mask, boundary)
+            layers = len(neighbor_colors)
+
+            for rr, cc in coords:
+                depth = int(dist[rr, cc])
+                if 0 <= depth < layers:
+                    out[rr, cc] = color if depth % 2 == 0 else GREY
+
+    return out
