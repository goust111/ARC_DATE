+        elif style == "stringy":
+            weight = (5 - same_adj) * (dist + 1) * (1.4 if other_adj == 0 else 1.0)
+        else:
+            weight = (same_adj + 1) * (dist + 2) * (1.25 if other_adj == 0 else 1.0)
+
+        weights.append(max(weight, 0.01))
+
+    return random.choices(options, weights=weights, k=1)[0]
