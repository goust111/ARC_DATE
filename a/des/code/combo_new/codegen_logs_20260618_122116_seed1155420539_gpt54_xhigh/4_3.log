+def _meets_branch_requirement(profiles: list[dict[str, int]], branch_mode: str) -> bool:
+    has_core = any(p["max_dist"] >= p["neighbor_count"] for p in profiles)
+    has_exhausted = any(p["max_dist"] < p["neighbor_count"] for p in profiles)
