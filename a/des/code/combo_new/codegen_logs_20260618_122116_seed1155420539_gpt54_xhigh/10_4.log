+            for r, c in np.argwhere(g == int(color))
+            if 0 < int(r) < h - 1 and 0 < int(c) < w - 1
+        ]
+        if not coords:
+            continue
+        if len(coords) != 8:
+            raise ValueError("each object color must occupy exactly eight interior cells")
+        r0, c0, r1, c1 = _bbox(coords)
