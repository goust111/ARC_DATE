+            spec["marker_pos"] = int(pos)
+            spec["marker_r"] = int(cell[0])
+            spec["marker_c"] = int(cell[1])
+            marker_cells.add(cell)
+            edge_positions[side].append(int(pos))
+            if dest_box is not None:
+                reserved_dest_boxes.append(dest_box)
+            placed = True
+            break
+
+        if not placed:
+            return False
