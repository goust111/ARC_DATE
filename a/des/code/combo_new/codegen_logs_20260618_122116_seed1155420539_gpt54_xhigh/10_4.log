+    return r0, c0, r0 + 2, w - 1
+
+
+def _target_top_left(
+    spec: dict[str, int], marker: dict[str, int], h: int, w: int
+) -> tuple[int, int] | None:
+    side = spec["gap_side"]
+    r0, c0 = spec["r0"], spec["c0"]
