+
+
+def _extract_problem(
+    grid: np.ndarray,
+) -> tuple[int, dict[int, dict[str, int]], list[dict[str, int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
