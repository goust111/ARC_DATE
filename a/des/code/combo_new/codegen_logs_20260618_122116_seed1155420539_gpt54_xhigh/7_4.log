+    for rr in range(interior.shape[0]):
+        for cc in range(interior.shape[1]):
+            if int(interior[rr, cc]) == NOISE_COLOR:
+                interior[rr, cc] = tile[(r0 + 1 + rr) % tile_h, (c0 + 1 + cc) % tile_w]
+
+    return interior
+
