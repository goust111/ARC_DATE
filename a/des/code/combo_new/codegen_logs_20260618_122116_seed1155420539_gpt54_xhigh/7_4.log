+def _minimal_period_shape(pattern: np.ndarray) -> tuple[int, int]:
+    empty = np.zeros_like(pattern, dtype=bool)
+    best_score = None
+    best_shape = None
+    h, w = pattern.shape
+
+    for tile_h in range(1, h + 1):
