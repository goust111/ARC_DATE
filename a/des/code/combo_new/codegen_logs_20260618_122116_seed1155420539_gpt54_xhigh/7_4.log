+
+BORDER_COLOR = 8
+NOISE_COLOR = 9
+
+TILE_COLOR_POOL = (1, 2, 3, 4, 5, 6, 7)
+TILE_HEIGHT_RANGE = (2, 5)
+TILE_WIDTH_RANGE = (2, 5)
+GRID_TILE_COUNT_RANGE = (4, 7)
