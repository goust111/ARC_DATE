+    r2, c2 = coords.max(axis=0)
+    patch = patch[int(r1) : int(r2) + 1, int(c1) : int(c2) + 1]
+
+    local_mask = patch != BLACK
+    if _object_hole_key_if_valid(local_mask) != base_key:
+        return None
+    if not (6 <= int(local_mask.sum()) <= 15):
