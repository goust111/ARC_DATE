+    cell[r0 : r0 + h, c0 : c0 + w][shape] = BLACK
+    return cell
+
+
+def _render_card(shape_infos: list[tuple[np.ndarray, int]], side: int) -> np.ndarray:
+    width = len(shape_infos) * side + (len(shape_infos) - 1)
+    card = np.zeros((side, width), dtype=int)
