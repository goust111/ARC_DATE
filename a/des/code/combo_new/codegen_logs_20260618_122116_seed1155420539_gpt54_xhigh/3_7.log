+    base_h = hole_h + 2
+    base_w = hole_w + 2
+    pad_top = random.randint(0, 2)
+    pad_bottom = random.randint(0, 2)
+    pad_left = random.randint(0, 2)
+    pad_right = random.randint(0, 2)
+
