+    if not (6 <= base_area <= 15):
+        return None
+
+    target_area = random.randint(base_area, min(15, base_area + 4))
+    base_key = _hole_key_from_shape(shape)
+    while int(obj.sum()) < target_area:
+        frontier = []
+        h, w = obj.shape
+        for rr in range(h):
+            for cc in range(w):
