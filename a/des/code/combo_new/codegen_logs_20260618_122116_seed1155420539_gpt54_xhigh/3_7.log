+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bands(indices: np.ndarray) -> list[tuple[int, int]]:
+    if indices.size == 0:
+        return []
+    vals = [int(x) for x in indices]
+    out: list[tuple[int, int]] = []
+    start = prev = vals[0]
+    for x in vals[1:]:
+        if x == prev + 1:
+            prev = x
+        else:
+            out.append((start, prev))
+            start = prev = x
+    out.append((start, prev))
+    return out
+
+
+def _shape_key(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+
+
+def _crop_true(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+
+
+def _enclosed_holes(object_mask: np.ndarray) -> list[np.ndarray]:
+    black = ~object_mask
+    h, w = black.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not black[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if black[nr, nc] and not seen[nr, nc]:
