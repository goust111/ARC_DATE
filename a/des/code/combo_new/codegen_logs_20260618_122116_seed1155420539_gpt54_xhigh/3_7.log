+    pad_left = random.randint(0, 2)
+    pad_right = random.randint(0, 2)
+
+    obj = np.zeros((base_h + pad_top + pad_bottom, base_w + pad_left + pad_right), dtype=bool)
+    fixed_hole = np.zeros_like(obj, dtype=bool)
