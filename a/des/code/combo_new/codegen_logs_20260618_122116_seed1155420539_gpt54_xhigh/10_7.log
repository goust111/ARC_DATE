+        _paste_crop(out, r0 + 1 + out_r0, c0 + 1 + out_c0, spec["out_crop"], bg)
+
+    if not _unique_bg_mode(inp, bg):
+        return None
+    if not _unique_bg_mode(out, bg):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        case = _build_case()
+        if case is None:
+            continue
+        inp, out = case
+        try:
+            if np.array_equal(main(inp), out):
+                return inp
+        except Exception:
+            continue
