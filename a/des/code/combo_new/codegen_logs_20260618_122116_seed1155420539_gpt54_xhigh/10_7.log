+    return None
+
+
+def _room_spec(total_rooms: int, side: str, bg: int, pattern_palette: list[int]) -> dict | None:
+    size_ranges = {
+        1: (5, 12),
+        2: (5, 10),
+        3: (5, 8),
+        4: (5, 7),
+    }
+    inner_lo, inner_hi = size_ranges[total_rooms]
+    for _ in range(120):
+        inner_h = random.randint(inner_lo, inner_hi)
