+    for piece in pieces:
+        anchor = next(pt for pt in cavity_coords if pt not in filled)
+        targets = {(anchor[0] + dr, anchor[1] + dc) for dr, dc in piece}
+        assert targets <= cavity_set
+        assert not (targets & filled)
