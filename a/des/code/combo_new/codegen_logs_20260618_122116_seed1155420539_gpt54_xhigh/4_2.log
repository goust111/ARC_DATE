+) -> list[list[tuple[int, int]]] | None:
+    current_blocked = blocked.copy()
+    placements: list[tuple[int, int]] = []
+    after = (-1, -1)
+    for idx, piece in enumerate(pieces):
+        valid = _candidate_positions(current_blocked, piece, after)
+        if not valid:
