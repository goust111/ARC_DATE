+    coords_by_piece: list[list[tuple[int, int]]] = []
+    for piece, (top, left) in zip(pieces, placements):
+        coords = [(top + r, left + c) for r, c in piece]
+        coords_by_piece.append(coords)
+        for r, c in coords:
+            grid[r, c] = color
