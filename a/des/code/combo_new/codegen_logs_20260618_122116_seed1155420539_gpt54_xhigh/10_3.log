+        bottom = random.randint(0, min(MAX_OUTER_MARGIN, extra_h - top))
+        left = random.randint(0, min(MAX_OUTER_MARGIN, extra_w))
+        right = random.randint(0, min(MAX_OUTER_MARGIN, extra_w - left))
