+def _downscale_mask(mask: np.ndarray, k: int) -> np.ndarray | None:
+    h, w = mask.shape
+    if k <= 0 or h % k or w % k:
+        return None
+    reduced_h = h // k
+    reduced_w = w // k
+    blocks = mask.reshape(reduced_h, k, reduced_w, k)
+    coarse = blocks[:, 0, :, 0]
+    if not bool(np.all(blocks == coarse[:, None, :, None])):
+        return None
+    return _trim_mask(coarse)
