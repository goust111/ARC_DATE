+import random
+
+import numpy as np
+
+
+BLACK = 0
+WORK_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+MAX_GRID_SIDE = 30
+GEN_ATTEMPTS = 500
+SHAPE_ATTEMPTS = 120
+LAYOUT_MARGIN = 1
+LAYOUT_GAP = 1
