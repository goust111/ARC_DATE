+def _transform(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    priority, legend_cells = _legend_info(g, bg)
+    seeds_by_color = _parse_seed_groups(g, priority, legend_cells, bg)
