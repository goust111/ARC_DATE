+COLOR_POOL = tuple(range(10))
+GRID_SIDE_RANGE = (21, 30)
+SEED_COUNT_RANGE = (4, 6)
+TEMPLATE_BBOX_OPTIONS = ((3, 3), (3, 5), (5, 3), (5, 5))
+TEMPLATE_ATTEMPTS = 200
+PLACEMENT_PADDING = 1
+MIN_DIRECTION_DISTANCE = 5
+GENERATION_ATTEMPTS = 400
