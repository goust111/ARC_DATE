    return None


def _direction_match(r: int, c: int, center_r: int, center_c: int, direction: str) -> bool:
    dr = r - center_r
    dc = c - center_c
    if max(abs(dr), abs(dc)) < MIN_DIRECTION_DISTANCE:
        return False
