                    ok = False
                    break
                cells.add((rr, cc))
            if not ok or cells & blocked:
                continue
            candidates.append(((r, c), cells))
    return candidates


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(*GRID_SIDE_RANGE)
    w = random.randint(*GRID_SIDE_RANGE)

