        return dr < 0 and -dr > abs(dc)
    if direction == "down":
        return dr > 0 and dr > abs(dc)
    if direction == "left":
        return dc < 0 and -dc > abs(dr)
    return dc > 0 and dc > abs(dr)


def _dilate_cells(cells: set[tuple[int, int]], h: int, w: int, radius: int) -> set[tuple[int, int]]:
    out: set[tuple[int, int]] = set()
    for r, c in cells:
