+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                stack.append((rr, cc))
+    return len(seen) == int(mask.sum())
