+    for comp in _components(g == AZURE):
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 3 or width < 5:
+            continue
+        touches_corner = (
+            (r0 == 0 and c0 == 0)
+            or (r0 == 0 and c1 == w - 1)
