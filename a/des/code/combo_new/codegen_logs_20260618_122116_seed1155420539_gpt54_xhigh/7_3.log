+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+AZURE = 8
+SEED_COLORS = (1, 3, 4, 6, 7, 9)
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
