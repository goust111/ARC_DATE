+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r, c + 1), (r + 1, c), (r, c - 1)]
+
+
+def _dir_index(src: tuple[int, int], dst: tuple[int, int]) -> int:
+    dr = dst[0] - src[0]
+    dc = dst[1] - src[1]
+    for idx, (rr, cc) in enumerate(DIRS):
+        if (dr, dc) == (rr, cc):
+            return idx
+    raise AssertionError("cells are not orthogonally adjacent")
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _component_from(mask: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    assert 0 <= sr < h and 0 <= sc < w and bool(mask[sr, sc])
+    comp = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in comp:
+                comp.add((nr, nc))
+                stack.append((nr, nc))
+    return comp
