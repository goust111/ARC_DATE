+    legend_mask, legend_seq = _find_legend(g, bg, neutral)
+    ring = {legend_seq[i]: legend_seq[(i + 1) % len(legend_seq)] for i in range(len(legend_seq))}
+
+    network_mask = (g != bg) & (~legend_mask)
