    tight = _tight_mask(mask)
    h, w = tight.shape
    if h > w:
        row_sums = tight.sum(axis=1)
        peak = int(np.argmax(row_sums))
        return "up" if peak < h // 2 else "down"
    col_sums = tight.sum(axis=0)
    peak = int(np.argmax(col_sums))
    return "left" if peak < w // 2 else "right"


