+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+
+PANEL_SIZE_RANGE = (4, 8)
+SPRITE_COUNT_CHOICES = (3, 4)
+MAX_EXTRA_CANVAS = 6
+PLACEMENT_RETRIES = 300
+MAX_GEN_ATTEMPTS = 400
+NON_SPECIAL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
