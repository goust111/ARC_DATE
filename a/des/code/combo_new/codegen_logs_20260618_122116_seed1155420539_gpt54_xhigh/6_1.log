+    occ = np.zeros((canvas_h, left_w), dtype=bool)
+    ordered_specs = sorted(sprite_specs, key=lambda d: (-(d["shape"][0] * d["shape"][1]), d["shape"]))
+    target_color = None
+    for spec in ordered_specs:
