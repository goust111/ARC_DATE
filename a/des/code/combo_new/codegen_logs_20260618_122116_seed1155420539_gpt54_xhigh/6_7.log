+    assert g.ndim == 2, "expected a 2D grid"
+
+    out = g.copy()
+    markers = [tuple(map(int, cell)) for cell in np.argwhere(g == GREY)]
+    assert markers, "expected at least one grey marker"
+    out[g == GREY] = BG
+
+    for marker in markers:
+        endpoint, color = _trace_endpoint(g, marker)
+        out[endpoint] = color
+
+    return out
