+
+
+def _path_neighbors(grid: np.ndarray, cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(nr, nc) for nr, nc in _neighbors4(grid.shape, r, c) if _occupied(grid, nr, nc)]
+
