+        ra0 = random.randint(2, max(2, h // 2 - 2))
+        ra2_low = max(ra0 + 3, h // 2)
+        ra2_high = h - 4
+        if ra2_low > ra2_high:
+            continue
+        ra2 = random.randint(ra2_low, ra2_high)
+        if ra2 - 2 < 2:
