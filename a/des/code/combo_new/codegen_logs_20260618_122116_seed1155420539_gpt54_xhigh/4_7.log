+def _paint_system(grid: np.ndarray, reserved: np.ndarray, spec: dict[str, object], color: int) -> None:
+    source = tuple(spec["source"])
+    path_cells = list(spec["path"])
+    target_cells = list(spec["target"])
+    mirrors = list(spec["mirrors"])
