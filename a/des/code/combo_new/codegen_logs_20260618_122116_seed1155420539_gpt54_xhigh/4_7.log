+
+def _place_mirror_segment(
+    height: int,
+    width: int,
+    turn_cell: tuple[int, int],
+    kind: str,
+    blocked: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    r, c = turn_cell
+    candidates: list[list[tuple[int, int]]] = []
+    for length in range(2, 5):
+        for idx in range(length):
+            if kind == "\\":
+                r0 = r - idx
+                c0 = c - idx
+                cells = [(r0 + step, c0 + step) for step in range(length)]
+            else:
