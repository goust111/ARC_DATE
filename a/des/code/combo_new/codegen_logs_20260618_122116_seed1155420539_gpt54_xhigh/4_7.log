+
+def _mark_cells(mask: np.ndarray, cells: list[tuple[int, int]], pad: int = 0) -> None:
+    height, width = mask.shape
+    for r, c in cells:
+        for rr in range(max(0, r - pad), min(height - 1, r + pad) + 1):
+            for cc in range(max(0, c - pad), min(width - 1, c + pad) + 1):
+                mask[rr, cc] = True
