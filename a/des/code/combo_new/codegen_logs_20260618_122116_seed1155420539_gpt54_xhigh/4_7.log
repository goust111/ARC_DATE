+def _target_components(grid: np.ndarray) -> tuple[list[list[tuple[int, int]]], dict[tuple[int, int], int]]:
+    g = np.asarray(grid, dtype=int)
+    targets: list[list[tuple[int, int]]] = []
+    cell_to_target: dict[tuple[int, int], int] = {}
