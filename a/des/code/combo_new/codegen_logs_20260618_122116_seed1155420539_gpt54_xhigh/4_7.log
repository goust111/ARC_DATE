+def _sources(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    height, width = g.shape
+    result: list[tuple[int, int, int]] = []
+    for r in range(height):
+        for c in range(width):
