+    seen: set[tuple[int, int, int, int]] = set()
+
+    while True:
+        state = (r, c, dr, dc)
+        if state in seen:
+            return None, reflections
+        seen.add(state)
+
+        nr = r + dr
+        nc = c + dc
+        if not _in_bounds(height, width, nr, nc):
+            return None, reflections
+        if (nr, nc) in target_of:
