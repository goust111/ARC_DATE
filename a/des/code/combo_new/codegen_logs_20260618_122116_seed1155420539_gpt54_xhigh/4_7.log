+                candidates.append(cells)
+    if not candidates:
+        return None
+    return random.choice(candidates)
+
+
+def _plan_system(
+    height: int,
+    width: int,
+    reserved: np.ndarray,
+    turns: int,
+    hit_target: bool,
+) -> dict[str, object] | None:
+    for _ in range(220):
