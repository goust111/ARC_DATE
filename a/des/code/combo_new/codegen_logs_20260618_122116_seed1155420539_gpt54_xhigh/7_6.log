+                    "order": order,
+                    "route_cells": set(route["cells"]),
+                    "route_dirs": route["dirs"],
+                    "cells": cells,
+                    "yellow_count": len(yellow_on_route),
+                    "endpoint_dist": abs(a[0] - b[0]) + abs(a[1] - b[1]),
+                    "route_len": len(route["cells"]),
