+
+
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+OPPOSITE = {
+    "up": "down",
+    "right": "left",
+    "down": "up",
+    "left": "right",
+}
+ARROW_OFFSETS = {
+    "up": [(0, 0), (-1, 0), (0, -1), (0, 1)],
+    "right": [(0, 0), (-1, 0), (1, 0), (0, 1)],
+    "down": [(0, 0), (1, 0), (0, -1), (0, 1)],
+    "left": [(0, 0), (-1, 0), (1, 0), (0, -1)],
+}
+
+PALETTE = tuple(range(10))
+RECT_DIMS = (
+    (1, 2),
+    (1, 3),
+    (2, 1),
+    (3, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+)
+PAIR_COUNT_OPTIONS = (1, 2, 3, 4)
+PAIR_COUNT_WEIGHTS = (2, 4, 4, 2)
+GRID_MIN = 12
+GRID_MAX = 28
+GAP_MIN = 2
+GAP_MAX = 8
