+
+
+def _sample_pair_placement(h: int, w: int, direction: str, rect_h: int, rect_w: int, gap: int):
+    if direction in ("left", "right"):
+        hit_index = random.randrange(rect_h)
+        row_lo = max(1, hit_index)
+        row_hi = min(h - 2, h - rect_h + hit_index)
+        if row_lo > row_hi:
