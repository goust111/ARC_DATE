+    dist = _layer_distances((h, w), best_cavity, boundary_mask)
+    out = g.copy()
+    for r, c in best_cavity:
+        d = int(dist[r, c])
+        if 1 <= d <= len(palette_levels):
+            out[r, c] = palette_levels[d - 1]
+        else:
+            out[r, c] = BG
+    return out
