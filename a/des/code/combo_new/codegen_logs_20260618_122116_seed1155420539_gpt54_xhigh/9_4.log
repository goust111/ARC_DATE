+def _place_cavity(
+    h: int,
+    w: int,
+    split: int,
+    max_height: int,
+    want_deep_center: bool,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], np.ndarray] | None:
+    chosen = _choose_core_dims(h, split, max_height, want_deep_center)
+    if chosen is None:
