+
+def _coords_to_shell(cavity_coords: list[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    cavity_set = set(cavity_coords)
+    shell: set[tuple[int, int]] = set()
+    for r, c in cavity_coords:
