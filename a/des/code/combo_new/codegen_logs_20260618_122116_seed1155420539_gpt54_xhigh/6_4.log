+    for child_list in children:
+        assert len(child_list) <= 1, "each frame should have at most one direct nested child"
+
+    roots = [idx for idx, parent in enumerate(parents) if parent is None]
+    chains: list[list[dict[str, object]]] = []
+    seen = 0
