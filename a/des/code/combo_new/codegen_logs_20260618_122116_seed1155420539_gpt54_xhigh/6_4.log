+MAX_GROUP_BUILD_ATTEMPTS = 100
+GROUP_COUNT_RANGE = (1, 4)
+INNER_SIZE_RANGE = (3, 9)
+GROUP_OUTER_MAX = {1: 23, 2: 18, 3: 15, 4: 13}
+SIDE_GAP_RANGE = (1, 2)
+GROUP_SPACING_RANGE = (2, 4)
+MARGIN_RANGE = (0, 3)
