+                "orient": "h",
+                "fixed": int(rows[0]),
+                "start": int(cols.min()),
+                "end": int(cols.max()),
+                "crosses": set(),
+            }
+        elif len(cols) == 1:
+            segments[color] = {
+                "orient": "v",
