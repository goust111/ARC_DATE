+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+# Generator configuration.
+COUNT_OPTIONS = ((1, 1), (1, 2), (2, 1), (2, 2), (2, 3), (3, 2), (3, 3))
+PRIORITY_MODES = ("horizontal_top", "vertical_top", "mixed")
+LINE_GAP = 4
