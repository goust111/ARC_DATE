+def _choose_grid(n_items: int, mode: str) -> tuple[int, int]:
+    choices: list[tuple[int, int]] = []
+    for rows in range(1, n_items + 1):
+        cols = (n_items + rows - 1) // rows
+        if mode == "vertical":
+            if cols <= 2:
