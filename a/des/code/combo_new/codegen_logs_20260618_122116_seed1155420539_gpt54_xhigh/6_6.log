+    g = np.asarray(grid, dtype=int)
+    orientation, index = _detect_divider(g)
+
+    if orientation == "vertical":
+        panel_a = g[:, :index]
+        panel_b = g[:, index + 1 :]
+    else:
+        panel_a = g[:index, :]
+        panel_b = g[index + 1 :, :]
