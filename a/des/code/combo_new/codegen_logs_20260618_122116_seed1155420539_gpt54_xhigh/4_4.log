+
+    if placed == 0:
+        return None
+
+    try:
+        if not np.array_equal(main(grid), expected):
+            return None
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
