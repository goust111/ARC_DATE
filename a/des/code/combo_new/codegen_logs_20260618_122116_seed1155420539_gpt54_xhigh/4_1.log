+            continue
+        if require_v_branch and "vh" not in branch_kinds:
+            continue
+        if not require_v_branch and "hv" not in branch_kinds:
+            continue
+        if not np.array_equal(main(grid), expected):
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid ARC input")

