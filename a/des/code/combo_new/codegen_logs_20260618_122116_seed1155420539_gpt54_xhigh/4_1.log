+GEN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+SLOTS = [(r, c) for r in range(3) for c in range(3)]
+MAX_LAYOUT_ATTEMPTS = 300
+MAX_COLOR_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 400
