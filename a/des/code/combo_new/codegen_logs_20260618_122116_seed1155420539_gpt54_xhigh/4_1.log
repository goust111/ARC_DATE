+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SHAPE_BANK = [
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1]], dtype=bool),
