+def _paint_frame(grid: np.ndarray, center: tuple[int, int], frame_size: int) -> tuple[int, int, int, int]:
+    radius = frame_size // 2
+    cr, cc = center
+    r0 = cr - radius
+    c0 = cc - radius
+    r1 = cr + radius
+    c1 = cc + radius
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
