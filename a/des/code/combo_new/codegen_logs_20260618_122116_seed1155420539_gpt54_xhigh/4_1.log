+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    mh, mw = mask.shape
+    off_r = random.randint(0, inner_h - mh)
+    off_c = random.randint(0, inner_w - mw)
+    target = grid[r0 + 1 + off_r : r0 + 1 + off_r + mh, c0 + 1 + off_c : c0 + 1 + off_c + mw]
