+        occupied = set(chosen)
+        infos: list[dict] = []
+        has_h = False
+        has_v = False
+        ok = True
+        for pair in pairing:
+            hv_blocked = _path_blocked_on_slots(pair, occupied, "hv")
+            vh_blocked = _path_blocked_on_slots(pair, occupied, "vh")
+            if hv_blocked and vh_blocked:
