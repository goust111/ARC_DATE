+
+
+def _make_sprite_mask(size: int, direction: str, rng: random.Random) -> np.ndarray:
+    for _ in range(100):
+        mask = np.zeros((size, size), dtype=bool)
+        if direction == "up":
+            span = rng.randint(1, size - 2)
+            start = rng.randint(1, size - span - 1)
+            mask[1:, :] = True
+            mask[0, start : start + span] = True
