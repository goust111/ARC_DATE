+    side_order = list(DIRS)
+    rng.shuffle(side_order)
+    side_for_dir = dict(zip(DIRS, side_order))
+
+    side_boxes: dict[str, tuple[int, int, int, int]] = {}
+    top_c = rng.randint(size + 1, w - 2 * size - 1)
