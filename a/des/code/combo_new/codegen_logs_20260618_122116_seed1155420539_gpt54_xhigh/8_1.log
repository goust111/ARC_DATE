+
+def _make_frame_patch(size: int, gap_dir: str) -> np.ndarray:
+    outer = size + 2
+    patch = np.zeros((outer, outer), dtype=bool)
+    patch[0, :] = True
+    patch[-1, :] = True
+    patch[:, 0] = True
+    patch[:, -1] = True
