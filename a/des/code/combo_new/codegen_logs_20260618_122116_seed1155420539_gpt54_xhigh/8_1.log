+        visited = np.zeros((h, w), dtype=bool)
+        cells = np.argwhere(grid == color)
+        for sr, sc in cells:
+            sr = int(sr)
+            sc = int(sc)
+            if visited[sr, sc]:
+                continue
+            q = deque([(sr, sc)])
+            visited[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = r + dr
+                    nc = c + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and grid[nr, nc] == color:
