+    top_max = min(max_rel, int(np.ceil(interior_size / 2.0)) - 1)
+    bottom_min = int(np.ceil(interior_size / 2.0))
+    left_max = min(max_rel, int(np.ceil(interior_size / 2.0)) - 1)
+    right_min = int(np.ceil(interior_size / 2.0))
