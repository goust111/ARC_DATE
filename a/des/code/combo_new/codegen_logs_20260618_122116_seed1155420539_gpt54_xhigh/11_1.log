def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int) -> None:
    r1 = r0 + size - 1
    c1 = c0 + size - 1
    grid[r0, c0 : c1 + 1] = FRAME_COLOR
    grid[r1, c0 : c1 + 1] = FRAME_COLOR
    grid[r0 : r1 + 1, c0] = FRAME_COLOR
    grid[r0 : r1 + 1, c1] = FRAME_COLOR


def _paste_expected(
    out: np.ndarray,
    patch: np.ndarray,
    frame_r0: int,
    frame_c0: int,
    anchor_r: int,
    anchor_c: int,
) -> None:
