+    rel_r = int(frame["anchor_r"]) - int(frame["r0"]) - 1
+    rel_c = int(frame["anchor_c"]) - int(frame["c0"]) - 1
+    top = rel_r < size / 2.0
+    left = rel_c < size / 2.0
