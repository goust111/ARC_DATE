+        ("111", "110", "101"),
+        ("111", "010", "101"),
+        ("111", "101", "110"),
+    ),
+    4: (
+        ("1111", "1000", "1110", "1001"),
+        ("1111", "1010", "1011", "1001"),
+        ("1111", "1100", "1010", "1001"),
+        ("1111", "1001", "1110", "1101"),
+    ),
