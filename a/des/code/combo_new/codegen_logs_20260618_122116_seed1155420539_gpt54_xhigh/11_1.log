+    if quadrant == "tl":
+        rel_r = rng.randint(0, top_max)
+        rel_c = rng.randint(0, left_max)
+    elif quadrant == "tr":
+        rel_r = rng.randint(0, top_max)
+        rel_c = rng.randint(right_min, max_rel)
+    elif quadrant == "br":
+        rel_r = rng.randint(bottom_min, max_rel)
+        rel_c = rng.randint(right_min, max_rel)
+    else:
+        rel_r = rng.randint(bottom_min, max_rel)
+        rel_c = rng.randint(0, left_max)
