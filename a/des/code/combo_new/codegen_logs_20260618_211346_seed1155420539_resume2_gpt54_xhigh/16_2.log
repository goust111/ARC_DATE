+                    "b": other,
+                    "sig_a": sig_a,
+                    "sig_b": sig_b,
+                }
+            )
+
+    templates.sort(key=lambda item: (item["h"] * item["w"], len(item["a"]), item["sig_a"], item["sig_b"]))
