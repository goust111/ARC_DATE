+        by_shape_sig.setdefault(shape_sig, []).append(idx)
+
+    partners: dict[int, int] = {}
+    for idx, record in enumerate(records):
+        candidates = [j for j in by_shape_sig.get(record["comp_sig"], []) if j != idx]
+        assert len(candidates) == 1
+        partner = candidates[0]
+        assert records[partner]["comp_sig"] == record["shape_sig"]
+        partners[idx] = partner
