+    h, w = grid.shape
+    del h
+    by_color: dict[int, list[int]] = {}
+    for c in range(w):
+        if np.all(grid[:, c] == grid[0, c]):
+            by_color.setdefault(int(grid[0, c]), []).append(c)
+
