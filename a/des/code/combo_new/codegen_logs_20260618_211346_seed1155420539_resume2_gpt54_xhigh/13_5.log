+    out = np.array(inp, dtype=int, copy=True)
+    for idx, (r0, c0, r1, c1) in enumerate(rooms):
+        fill = MAROON if idx in green_rooms else (BLUE if depths[idx] % 2 == 0 else YELLOW)
+        for r in range(r0, r1 + 1):
