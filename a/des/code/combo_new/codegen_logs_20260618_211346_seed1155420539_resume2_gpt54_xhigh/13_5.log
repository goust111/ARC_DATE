+                continue
+            seen[r, c] = True
+            comp = [(r, c)]
+            q = deque([(r, c)])
+            while q:
+                cr, cc = q.popleft()
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
