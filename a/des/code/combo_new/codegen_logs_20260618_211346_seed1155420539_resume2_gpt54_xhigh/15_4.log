+        return None
+    total = rng.randint(parts * min_size, min(parts * max_size, total_cap))
+    sizes = [min_size] * parts
+    slack = [max_size - min_size] * parts
+    extra = total - parts * min_size
+    while extra > 0:
+        choices = [i for i, rem in enumerate(slack) if rem > 0]
+        if not choices:
