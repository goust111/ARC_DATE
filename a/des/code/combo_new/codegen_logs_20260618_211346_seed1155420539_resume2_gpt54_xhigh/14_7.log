+        return None
+
+    inp = np.full((h, w), bg, dtype=int)
+    expected = np.full((h, w), bg, dtype=int)
+
+    for pair, (top, left) in zip(pairs, placements):
+        for coords, color in (
+            (pair["source_coords"], pair["source_color"]),
+            (pair["arrow_coords"], pair["arrow_color"]),
