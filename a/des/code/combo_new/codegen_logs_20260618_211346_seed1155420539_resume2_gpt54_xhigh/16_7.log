+def _vertical_side_runs(r0: int, r1: int, major: int, minor: int, pattern: str) -> list[tuple[int, int, int]]:
+    if pattern == "full":
+        return [(r0, r1, major)]
+    if pattern == "split":
+        return [(r0, r0 + 1, major), (r1 - 1, r1, major)]
+    if pattern == "minor":
+        height = r1 - r0 + 1
+        assert height >= 8
+        mid_start = r0 + 3 + (height - 8) // 2
