+    raise AssertionError(f"unknown vertical pattern: {pattern}")
+
+
+def _horizontal_side_runs(c0: int, c1: int, major: int, minor: int, pattern: str) -> list[tuple[int, int, int]]:
+    if pattern == "full":
+        return [(c0, c1, major)]
