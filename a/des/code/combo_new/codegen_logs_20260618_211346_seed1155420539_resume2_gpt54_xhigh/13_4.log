+    rng.shuffle(shuffled)
+
+    for color, mask in shuffled:
+        h, w = mask.shape
+        placed = False
+        for _ in range(300):
+            r0 = rng.randint(0, CANVAS_SIZE - h)
+            c0 = rng.randint(0, CANVAS_SIZE - w)
+            rr0 = max(0, r0 - 1)
+            rr1 = min(CANVAS_SIZE, r0 + h + 1)
