+        while queue:
+            r, c = queue.popleft()
+            pts.append((r, c))
+            for nr, nc in _neighbors4(r, c, h, w):
+                if not visited[nr, nc] and int(grid[nr, nc]) == color:
+                    visited[nr, nc] = True
