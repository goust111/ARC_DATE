+        box_a = comps[0]["bbox"]
+        box_b = comps[1]["bbox"]
+        assert isinstance(box_a, tuple) and isinstance(box_b, tuple)
+        rep = min((int(box_a[0]), int(box_a[1])), (int(box_b[0]), int(box_b[1])))
