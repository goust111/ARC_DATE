+    rng: random.Random,
+) -> bool:
+    h, w = grid.shape
+    gaps = [rng.choice(LEGEND_GAP_CHOICES) for _ in range(max(0, len(marker_order) - 1))]
+    total_h = 2 * len(marker_order) + sum(gaps)
+    if total_h > h:
+        return False
