+                r += 2
+                while r < h and np.all(strip[r] == bg):
+                    r += 1
+                continue
+            r += 1
+
+        if not entries:
+            continue
+
+        covered = np.zeros(h, dtype=bool)
+        mapping: dict[int, np.ndarray] = {}
+        ok = True
+        for r0, marker, tile in entries:
+            if marker in mapping:
+                ok = False
+                break
+            mapping[marker] = np.asarray(tile, dtype=int)
+            covered[r0 : r0 + 2] = True
+
+        if not ok:
+            continue
