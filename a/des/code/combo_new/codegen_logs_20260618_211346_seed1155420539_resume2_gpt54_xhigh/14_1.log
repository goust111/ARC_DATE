+    min_h = max(HEIGHT_RANGE[0], 2 * region_count + 2)
+    h = rng.randint(min_h, HEIGHT_RANGE[1])
+    w = rng.randint(WIDTH_RANGE[0], WIDTH_RANGE[1])
