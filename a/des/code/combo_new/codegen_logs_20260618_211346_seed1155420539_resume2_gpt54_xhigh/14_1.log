            continue

        marker_colors = {int(board[r, c]) for r, c in comp if int(board[r, c]) != bg}
        if len(marker_colors) != 1:
            continue
        marker = next(iter(marker_colors))
        regions.append((r0, c0, r1, c1, marker))

