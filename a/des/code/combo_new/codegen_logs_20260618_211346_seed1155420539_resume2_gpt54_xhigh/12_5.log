+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+GEN_RETRIES = 400
+PATTERN_RETRIES = 200
+TEMPLATE_COUNT_RANGE = (2, 6)
+INSTRUCTION_COUNT_RANGE = (1, 5)
+TEMPLATE_WIDTH_MIN = 4
+TEMPLATE_WIDTH_CAP = 10
+MARGIN_MAX = 2
+ROW_GAP_MAX = 2
+PART_GAP_RANGE = (1, 3)
+COLUMN_GAP_RANGE = (1, 3)
