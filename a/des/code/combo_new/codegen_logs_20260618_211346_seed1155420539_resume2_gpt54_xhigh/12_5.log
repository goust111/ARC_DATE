+    out_w = len(blocks) * width + len(blocks) - 1
+    out = np.full((out_h, out_w), BG, dtype=int)
+
+    col = 0
+    for block in blocks:
+        block_h, block_w = block.shape
+        out[:block_h, col : col + block_w] = block
+        col += block_w + 1
+    return out
+
+
