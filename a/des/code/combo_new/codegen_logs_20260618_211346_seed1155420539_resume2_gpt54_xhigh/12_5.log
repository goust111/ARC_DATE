+            left_start = rng.randint(0, left_space - left_len)
+            right_start = rng.randint(gap_col + 1, width - right_len)
+            mask[left_start : left_start + left_len] = True
+            mask[right_start : right_start + right_len] = True
+        elif kind == "alternating":
