+            mask[cols] = True
+
+        if bool(mask.any()):
+            return mask
+
+
+def _generate_patterns(count: int, width: int, rng: random.Random) -> list[np.ndarray] | None:
+    patterns: list[np.ndarray] = []
+    seen: set[tuple[int, ...]] = set()
