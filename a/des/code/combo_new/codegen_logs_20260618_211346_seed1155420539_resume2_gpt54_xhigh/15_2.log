+def _classify_arrow(comp: dict[str, object]) -> dict[str, object] | None:
+    if int(comp["area"]) != 5:
+        return None
+    r0, c0, r1, c1 = comp["bbox"]
+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return None
