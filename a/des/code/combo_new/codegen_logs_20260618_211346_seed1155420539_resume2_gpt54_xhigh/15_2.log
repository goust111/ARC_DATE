+        return {
+            "color": color,
+            "direction": direction,
+            "arrow_cells": arrow_cells,
+            "target_cells": target_cells,
+            "copy_cells": copy_cells,
+            "trail_cells": trail_cells,
+        }
+
+    return None
+
+
+def _generate_attempt() -> np.ndarray | None:
+    pair_count = random.randint(1, 4)
