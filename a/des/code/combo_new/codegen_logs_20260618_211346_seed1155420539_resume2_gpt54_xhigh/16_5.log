+        r0, c0, r1, c1 = node.bbox
+        if depth % 2 == 0 and not np.array_equal(inp[r0 : r1 + 1, c0 : c1 + 1], out[r0 : r1 + 1, c0 : c1 + 1]):
+            changed = True
+        for child in node.children:
+            visit(child, depth + 1)
+
+    for root in roots:
+        visit(root, 1)
+    return changed
