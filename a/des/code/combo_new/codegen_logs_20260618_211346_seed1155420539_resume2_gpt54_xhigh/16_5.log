136:     area = int(rng.integers(*SPRITE_AREA_RANGE))
137:     dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)
138:             for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]
139:     h, w = dims[int(rng.integers(0, len(dims)))]
140:     cells = _grow_sprite(rng, h, w, area)
141:     rs, cs = zip(*cells)
