+    rows = [pt[0] for pt in coords]
+    cols = [pt[1] for pt in coords]
+    r0, c0, r1, c1 = min(rows), min(cols), max(rows), max(cols)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
