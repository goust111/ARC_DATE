127:                 nb = (r + dr, c + dc)
128:                 if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:
129:                     frontier.append(nb)
130:         cells.add(frontier[int(rng.integers(0, len(frontier)))])
131:     return list(cells)
