+
+    def visit(node: FrameNode, depth: int) -> None:
+        nonlocal found
+        if depth % 2 == 1:
+            r0, c0, r1, c1 = node.bbox
+            inner_in = inp[r0 + 1 : r1, c0 + 1 : c1]
+            inner_out = out[r0 + 1 : r1, c0 + 1 : c1]
+            if np.any((inner_in == BLACK) & (inner_out == node.color)):
+                found = True
+        for child in node.children:
+            visit(child, depth + 1)
