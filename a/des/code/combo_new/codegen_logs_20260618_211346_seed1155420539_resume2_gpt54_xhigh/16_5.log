+    if not _has_even_rotation_effect(inp, expected, roots):
+        return None
+    if not _has_odd_fill_effect(inp, expected, roots):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
