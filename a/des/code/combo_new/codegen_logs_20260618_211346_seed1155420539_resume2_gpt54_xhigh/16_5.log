+def _embed_object(
+    rng: random.Random, local: np.ndarray, root: FrameNode
+) -> tuple[np.ndarray, list[FrameNode], np.ndarray]:
+    obj_h, obj_w = local.shape
+    grid_h = rng.randint(obj_h + 2, MAX_DIM)
+    grid_w = rng.randint(obj_w + 2, MAX_DIM)
