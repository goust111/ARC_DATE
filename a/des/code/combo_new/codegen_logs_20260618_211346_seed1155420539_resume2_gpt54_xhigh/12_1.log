+    candidates = _gap_candidates(h, w, max_len)
+    if len(candidates) < count:
+        return None
+    want_bent = bool(random.getrandbits(1)) and any(cand["bent"] for cand in candidates)
+    perimeter = len(_border_cycle(h, w))
+    for _ in range(250):
