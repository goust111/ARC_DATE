+def _side_id(r: int, c: int, h: int, w: int) -> int:
+    if r == 0:
+        return 0
+    if c == w - 1:
+        return 1
+    if r == h - 1:
+        return 2
+    return 3
+
+
+def _gap_candidates(h: int, w: int, max_len: int) -> list[dict]:
+    border = _border_cycle(h, w)
+    perimeter = len(border)
