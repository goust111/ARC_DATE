+        random.shuffle(order)
+        chosen = []
+        used_shapes = set()
+        forbidden = {0}
+        bent_count = 0
+        for cand in order:
+            if cand["shape_key"] in used_shapes:
+                continue
+            if cand["index_set"] & forbidden:
