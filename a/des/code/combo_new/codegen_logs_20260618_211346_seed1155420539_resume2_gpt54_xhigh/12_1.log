+        return None
+    frame_r0 = random.randint(margin, grid_h - frame_h - margin)
+    frame_c0 = random.randint(margin, grid_w - frame_w - margin)
+    frame_r1 = frame_r0 + frame_h - 1
+    frame_c1 = frame_c0 + frame_w - 1
