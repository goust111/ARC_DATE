+    for start in range(1, perimeter):
+        for length in range(1, max_len + 1):
+            end = start + length
+            if end > perimeter:
+                break
+            coords = border[start:end]
+            side_changes = sum(
+                _side_id(*coords[i], h, w) != _side_id(*coords[i + 1], h, w)
