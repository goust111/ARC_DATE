+        if not _place_patch(grid, blocked, patch):
+            return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
