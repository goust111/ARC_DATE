  "type": "move_in_order",
  "src": "non-background color groups with perfect-square pixel counts",
  "dst": "bottom-aligned solid color squares packed left-to-right",
  "transform": "replace each color group by a filled square of the same color and area, with one background column between neighboring squares",
  "multi_step": "order the squares by increasing side length; side lengths are unique",
  "grid_shape": "height is the largest square side; width is the sum of square sides plus one gap between each pair"
}
