+    for color, segment in segments.items():
+        dr, dc = positions[color]
+        cells = segment["cells"]
+        assert isinstance(cells, list)
+        for r, c in cells:
+            pos = (r + dr, c + dc)
+            assert pos not in painted, "translated segments may not overlap"
+            painted[pos] = color
