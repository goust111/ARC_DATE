+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_RETRIES = 400
+PATH_RETRIES = 300
+PLACE_RETRIES = 300
+PADDING = 1
