+        while len(path) < length:
+            r, c = path[-1]
+            options = []
+            dirs = DIRS4[:]
+            random.shuffle(dirs)
+            for dr, dc in dirs:
+                nr = r + dr
+                nc = c + dc
+                nxt = (nr, nc)
