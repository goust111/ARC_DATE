+def _simulate_growth(grid: np.ndarray, *, return_meta: bool = False):
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _most_common_color(g)
+    order = _priority_order(g, bg)
+    seeds = _extract_seeds(g, bg)
+
+    out = g.copy()
+    meta = {"collision": False, "merge": False}
