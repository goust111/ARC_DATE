+    seen: set[int] = set()
+    for r, c in _corner_positions(h, w):
+        color = int(grid[r, c])
+        if color == bg or color in seen:
+            continue
+        seen.add(color)
+        order.append(color)
+
+    for r, c in np.argwhere(grid != bg):
+        rr, cc = int(r), int(c)
+        if (rr, cc) in set(_corner_positions(h, w)):
+            continue
+        color = int(grid[rr, cc])
+        if color not in seen:
+            seen.add(color)
+            order.append(color)
+    return order
