+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _extract_layers(grid: np.ndarray) -> list[dict[str, int | bool]]:
+    bbox = _bbox(grid != 0)
+    if bbox is None:
