+                "filled": filled,
+            }
+        )
+
+        if filled:
+            break
+
+        top += 1
+        left += 1
+        bottom -= 1
+        right -= 1
+
+    colors = [int(layer["color"]) for layer in layers]
+    if len(colors) != len(set(colors)):
+        raise ValueError("layer colors must be distinct")
+    return layers
