+            out,
+            placement["cavity_mask"],
+            placement["seed_rc"],
+            placement["direction"],
+            placement["origin"][0],
+            placement["origin"][1],
+            placement["seed_color"],
+            BG_COLOR,
+            WALL_COLOR,
+        )
+    return inp, out
+
+
+def _expanded_bbox(cells: set[tuple[int, int]], grid_shape: tuple[int, int]) -> tuple[int, int, int, int]:
