+
+def _reflect_coords(
+    coords: set[tuple[int, int]],
+    orientation: str,
+    axis2: int,
+) -> set[tuple[int, int]]:
+    if orientation == "vertical":
+        return {(int(r), int(axis2 - c)) for r, c in coords}
