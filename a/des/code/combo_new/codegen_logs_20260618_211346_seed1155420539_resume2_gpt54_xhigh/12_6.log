+    score = side_score(original_only)
+    if score == 0:
+        score = -side_score(reflected_only)
+    assert score != 0, "defect side must be identifiable"
+
+    if orientation == "vertical":
+        return "right" if score > 0 else "left"
+    return "down" if score > 0 else "up"
