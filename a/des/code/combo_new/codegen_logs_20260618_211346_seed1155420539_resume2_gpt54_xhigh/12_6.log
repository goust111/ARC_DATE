+def _direction_from_diff(
+    coords: set[tuple[int, int]],
+    reflected: set[tuple[int, int]],
+    orientation: str,
+    axis2: int,
+) -> str:
+    original_only = coords - reflected
+    reflected_only = reflected - coords
+
