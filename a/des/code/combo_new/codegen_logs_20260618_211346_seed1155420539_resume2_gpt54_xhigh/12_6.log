+def _paint_coords(grid: np.ndarray, coords: list[tuple[int, int]] | tuple[tuple[int, int], ...], color: int) -> None:
+    h, w = grid.shape
+    for r, c in coords:
+        if 0 <= int(r) < h and 0 <= int(c) < w:
+            grid[int(r), int(c)] = int(color)
