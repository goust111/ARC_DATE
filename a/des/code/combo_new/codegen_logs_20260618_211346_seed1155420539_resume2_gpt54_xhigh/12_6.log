+
+    return {
+        "orientation": str(best["orientation"]),
+        "axis2": int(best["axis2"]),
+        "direction": direction,
+        "mismatch": int(best["mismatch"]),
+        "other_mismatch": int(other["mismatch"]),
+        "center_gap": int(best["center_gap"]),
+        "area": int(mask.sum()),
