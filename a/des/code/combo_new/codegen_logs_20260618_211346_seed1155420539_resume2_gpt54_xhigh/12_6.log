+def generate_input() -> np.ndarray:
+    for attempt in range(GEN_RETRIES):
+        rng = random.Random(random.randrange(1 << 30) + attempt * 1009)
+        built = _build_case(rng)
+        if built is None:
+            continue
+        inp, expected = built
