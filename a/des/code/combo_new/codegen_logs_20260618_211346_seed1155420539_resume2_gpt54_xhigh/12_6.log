+    else:
+        width = 2 * max(spans) + 1
+    mask = np.zeros((height, width), dtype=bool)
+    for r, span in enumerate(spans):
+        if even_axis:
+            row_width = 2 * int(span)
+            left = (width - row_width) // 2
+        else:
