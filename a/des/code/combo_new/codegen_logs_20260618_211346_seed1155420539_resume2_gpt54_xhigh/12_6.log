+    norm, h, w = _normalize_coords(coords)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in norm:
+        mask[r, c] = True
+    return mask
+
+
+def _mask_coords(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    return tuple((int(r), int(c)) for r, c in np.argwhere(mask))
