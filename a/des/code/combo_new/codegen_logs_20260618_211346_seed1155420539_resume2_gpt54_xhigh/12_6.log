+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GEN_RETRIES = 500
+OBJECT_RETRIES = 300
+PLACEMENT_RETRIES = 120
+GRID_H_RANGE = (15, 30)
+GRID_W_RANGE = (15, 30)
+OBJECT_COUNT_RANGE = (2, 4)
+PROFILE_HEIGHT_RANGE = (2, 6)
+PROFILE_SPAN_RANGE = (1, 3)
