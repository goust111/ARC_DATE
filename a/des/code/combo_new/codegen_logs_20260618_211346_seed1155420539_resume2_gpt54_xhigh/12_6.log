+        score = 0
+        if orientation == "vertical":
+            for _r, c in points:
+                delta = 2 * int(c) - int(axis2)
+                score += (delta > 0) - (delta < 0)
+        else:
+            for r, _c in points:
+                delta = 2 * int(r) - int(axis2)
+                score += (delta > 0) - (delta < 0)
