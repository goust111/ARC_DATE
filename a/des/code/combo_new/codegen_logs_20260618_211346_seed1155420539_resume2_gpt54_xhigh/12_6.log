+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GEN_RETRIES = 500
+OBJECT_RETRIES = 300
+PLACEMENT_RETRIES = 120
