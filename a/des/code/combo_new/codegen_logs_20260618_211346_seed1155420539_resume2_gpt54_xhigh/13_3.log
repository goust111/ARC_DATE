+# --------------- generator (o5x) ---------------
+
+GRID_HEIGHT_RANGE = (16, 30)
+GRID_WIDTH_RANGE = (16, 30)
+PATH_COUNT_RANGE = (1, 4)
+SEGMENT_COUNT_RANGE = (2, 5)
+SEGMENT_LENGTH_RANGE = (1, 4)
