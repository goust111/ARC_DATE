+def _ordered_path(path_cells: list[tuple[int, int]], source_touch: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    path_set = set(path_cells)
+    neigh = {
+        p: [q for q in ((p[0] - 1, p[1]), (p[0] + 1, p[1]), (p[0], p[1] - 1), (p[0], p[1] + 1)) if q in path_set]
+        for p in path_cells
