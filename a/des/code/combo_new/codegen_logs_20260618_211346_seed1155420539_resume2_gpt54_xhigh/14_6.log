+from collections import Counter, deque
+
+import numpy as np
+
+
+BG_COLOR = 0
+PATH_COLOR = 5
+FRAME_COLOR = 9
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TEMP_SIZE = 24
+GEN_ATTEMPTS = 300
+
+_GEN_RNG = np.random.default_rng()
+_GEN_COUNTER = 0
