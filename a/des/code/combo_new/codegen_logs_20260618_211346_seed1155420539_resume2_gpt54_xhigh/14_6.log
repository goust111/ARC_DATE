+            frame_left = x_end + 1
+            points = [(y0, x0), (y0, x1), (y1, x1), (y1, x_end)]
+        elif turns == 1:
+            below = bool(int(rng.integers(0, 2)))
+            if below:
+                top_lo = y0 + 3
+                top_hi = TEMP_SIZE - fh
+                if top_lo > top_hi:
+                    continue
+                frame_top = int(rng.integers(top_lo, top_hi + 1))
