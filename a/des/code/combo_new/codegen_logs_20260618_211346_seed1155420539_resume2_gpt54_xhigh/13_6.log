+def _global_coords(mask: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for r, c in np.argwhere(mask):
+        coords.append((top + int(r), left + int(c)))
+    return coords
