+        mask[:t, :] = True
+        mask[:, stem : stem + t] = True
+    elif kind == "plus":
+        h = rng.choice([7, 9])
+        w = rng.choice([7, 9])
+        t = 3
+        vr = (w - t) // 2
+        hr = (h - t) // 2
