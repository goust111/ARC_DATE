+    tie = False
+    for entries in by_pixel.values():
+        if len(entries) < 2:
+            continue
+        min_layer = min(layer for layer, _ in entries)
+        if sum(layer == min_layer for layer, _ in entries) >= 2:
+            tie = True
+        else:
