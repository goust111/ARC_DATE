+    modes = ("none", "early", "tie")
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng, rng.choice(modes))
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid halo puzzle input")
