+def _reach_layers(
+    grid: np.ndarray, start_cells: set[tuple[int, int]], max_layers: int
+) -> dict[tuple[int, int], int]:
+    if max_layers <= 0:
+        return {}
+
+    h, w = grid.shape
+    visited = set(start_cells)
+    frontier = set(start_cells)
