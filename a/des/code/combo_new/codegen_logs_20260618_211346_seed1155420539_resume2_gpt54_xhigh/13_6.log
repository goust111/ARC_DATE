+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            ok = True
+            for dr, dc in DIR8:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                    ok = False
+                    break
