+        left = rng.randint(1, w - total_w - 1)
+        return [(top, left), (top, left + ow + gap)]
+    total_h = 2 * oh + gap
+    if total_h > h - 2 or ow > w - 2:
+        return None
+    top = rng.randint(1, h - total_h - 1)
+    left = rng.randint(1, w - ow - 1)
+    return [(top, left), (top + oh + gap, left)]
