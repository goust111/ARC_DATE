+def _neighbors4(r: int, c: int, h: int, w: int) -> Iterable[tuple[int, int]]:
+    for dr, dc in DIR4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
