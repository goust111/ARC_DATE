+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r
+            min_c = max_c = c
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                min_r = min(min_r, cr)
+                max_r = max(max_r, cr)
+                min_c = min(min_c, cc)
+                max_c = max(max_c, cc)
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min_r, min_c, max_r, max_c),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _classify_fence(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
