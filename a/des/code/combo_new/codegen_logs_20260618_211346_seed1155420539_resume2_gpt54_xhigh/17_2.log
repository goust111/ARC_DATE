+
+def _find_fences(grid: np.ndarray, bg: int) -> list[dict]:
+    fences = []
+    for comp in _components_monochrome(grid, bg):
+        info = _classify_fence(comp)
+        if info is not None:
+            fences.append(info)
+    fences.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return fences
