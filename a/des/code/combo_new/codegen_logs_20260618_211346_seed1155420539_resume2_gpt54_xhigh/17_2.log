+        if direction == "right":
+            if oc0 <= c1 or not _intervals_overlap(or0, or1, g0, g1):
+                continue
+            key = (oc0 - c1, or0, oc0)
+        elif direction == "left":
+            if oc1 >= c0 or not _intervals_overlap(or0, or1, g0, g1):
