+    else:
+        gap_range = (c0 + start, c0 + end)
+        axis = "col"
+
+    return {
+        "color": int(comp["color"]),
+        "bbox": (r0, c0, r1, c1),
+        "direction": direction,
+        "gap_range": gap_range,
+        "gap_axis": axis,
+    }
