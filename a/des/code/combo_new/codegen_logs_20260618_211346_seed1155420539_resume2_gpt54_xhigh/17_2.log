+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return max(a0, b0) <= min(a1, b1)
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components_monochrome(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r
+            min_c = max_c = c
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                min_r = min(min_r, cr)
+                max_r = max(max_r, cr)
+                min_c = min(min_c, cc)
+                max_c = max(max_c, cc)
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min_r, min_c, max_r, max_c),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _classify_fence(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[r - r0, c - c0] = True
+
+    if np.any(mask[1:-1, 1:-1]):
+        return None
+    if not (mask[0, 0] and mask[0, -1] and mask[-1, 0] and mask[-1, -1]):
+        return None
+
+    perimeter = 2 * h + 2 * w - 4
+    missing = perimeter - int(mask.sum())
+    if missing not in (2, 3):
+        return None
+
+    side_gaps: dict[str, tuple[int, int]] = {}
+    for side, arr in (
+        ("top", mask[0, 1:-1]),
+        ("bottom", mask[-1, 1:-1]),
+        ("left", mask[1:-1, 0]),
+        ("right", mask[1:-1, -1]),
+    ):
+        zeros = np.flatnonzero(~arr)
+        if len(zeros) == 0:
+            continue
+        if len(zeros) not in (2, 3):
+            return None
+        if int(zeros[-1]) - int(zeros[0]) + 1 != len(zeros):
+            return None
+        side_gaps[side] = (int(zeros[0]) + 1, int(zeros[-1]) + 1)
+
+    if len(side_gaps) != 1:
+        return None
+
+    direction = next(iter(side_gaps))
+    start, end = side_gaps[direction]
+    if direction in ("left", "right"):
+        gap_range = (r0 + start, r0 + end)
+        axis = "row"
+    else:
+        gap_range = (c0 + start, c0 + end)
+        axis = "col"
+
+    return {
+        "color": int(comp["color"]),
+        "bbox": (r0, c0, r1, c1),
+        "direction": direction,
+        "gap_range": gap_range,
+        "gap_axis": axis,
