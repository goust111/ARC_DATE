+    grid[0:h_top, w_left + gap_x : total_w] = patches[1]
+    grid[h_top + gap_y : total_h, w_left + gap_x : total_w] = patches[2]
+    grid[h_top + gap_y : total_h, 0:w_left] = patches[3]
+    return grid
