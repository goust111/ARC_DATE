+                break
+            cells.add(random.choice(frontier))
+
+        if len(cells) != area:
+            continue
+
+        rows = [r for r, _c in cells]
+        cols = [c for _r, c in cells]
+        min_r, max_r = min(rows), max(rows)
+        min_c, max_c = min(cols), max(cols)
