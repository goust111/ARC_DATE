+def _build_local_scene() -> tuple[np.ndarray, int] | None:
+    template = random.choices(["pair", "triple", "square"], weights=TEMPLATE_WEIGHTS, k=1)[0]
+    if template == "pair":
+        local = _build_row_scene(["right", "left"])
+        count = 2
+    elif template == "triple":
