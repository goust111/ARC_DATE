+
+def _translation_delta(direction: str, target_bbox: tuple[int, int, int, int], obj_pixels: list[tuple[int, int]]) -> tuple[int, int]:
+    rows = [r for r, _c in obj_pixels]
+    cols = [c for _r, c in obj_pixels]
