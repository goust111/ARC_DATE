+                continue
+            count += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                cr, cc = queue.popleft()
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+    return count
