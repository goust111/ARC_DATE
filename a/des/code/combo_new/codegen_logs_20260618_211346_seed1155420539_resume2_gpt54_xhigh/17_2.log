+    for side, arr in (
+        ("top", mask[0, 1:-1]),
+        ("bottom", mask[-1, 1:-1]),
+        ("left", mask[1:-1, 0]),
+        ("right", mask[1:-1, -1]),
+    ):
+        zeros = np.flatnonzero(~arr)
+        if len(zeros) == 0:
+            continue
+        if len(zeros) not in (2, 3):
+            return None
+        if int(zeros[-1]) - int(zeros[0]) + 1 != len(zeros):
+            return None
