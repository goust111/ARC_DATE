+        if built is None:
+            return None
+        patch, info = built
+        patches.append(patch)
+        infos.append(info)
+
+    gap_x = max(infos[0]["span"], infos[2]["span"]) + 1
+    gap_y = max(infos[1]["span"], infos[3]["span"]) + 1
+    total_h = h_top + gap_y + h_bottom
+    total_w = w_left + gap_x + w_right
+    if max(total_h, total_w) > 30:
