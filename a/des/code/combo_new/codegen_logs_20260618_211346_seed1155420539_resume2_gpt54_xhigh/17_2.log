+        min_r, max_r = min(rows), max(rows)
+        min_c, max_c = min(cols), max(cols)
+        coords = sorted((r - min_r, c - min_c) for r, c in cells)
+        shape_h = max_r - min_r + 1
+        shape_w = max_c - min_c + 1
+        return coords, shape_h, shape_w
+    return None
