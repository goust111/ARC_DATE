+def _find_target_fence(source: dict, fences: list[dict]) -> dict:
+    r0, c0, r1, c1 = source["bbox"]
+    g0, g1 = source["gap_range"]
+    direction = source["direction"]
+    candidates: list[tuple[tuple[int, int, int], dict]] = []
