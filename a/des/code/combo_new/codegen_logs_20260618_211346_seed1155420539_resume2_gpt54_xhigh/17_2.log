+    if direction in ("left", "right"):
+        max_shape_h = min(gap_len, inner_h)
+        max_shape_w = min(3, inner_w)
+    else:
+        max_shape_h = min(3, inner_h)
+        max_shape_w = min(gap_len, inner_w)
