+def _covering_segment(occupied: list[int], gap_len: int, side_len: int) -> int:
+    low = max(1, max(occupied) - gap_len + 1)
+    high = min(min(occupied), side_len - gap_len - 1)
+    assert low <= high
+    return random.randint(low, high)
