+        for r, c in obj_pixels:
+            out[r + dr, c + dc] = int(fence["color"])
+    return out
+
+
+# --------------- generator (codex) ---------------
+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+TEMPLATE_WEIGHTS = (3, 3, 4)  # pair, triple, square
+SIDE_CHOICES = (5, 6)
