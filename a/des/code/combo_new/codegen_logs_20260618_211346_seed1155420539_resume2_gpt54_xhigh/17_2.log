+            if oc0 <= c1 or not _intervals_overlap(or0, or1, g0, g1):
+                continue
+            key = (oc0 - c1, or0, oc0)
+        elif direction == "left":
+            if oc1 >= c0 or not _intervals_overlap(or0, or1, g0, g1):
+                continue
+            key = (c0 - oc1, or0, oc0)
+        elif direction == "bottom":
+            if or0 <= r1 or not _intervals_overlap(oc0, oc1, g0, g1):
+                continue
+            key = (or0 - r1, or0, oc0)
