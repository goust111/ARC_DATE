+def _count_binary_components(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            count += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                cr, cc = queue.popleft()
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
