+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+TEMPLATE_WEIGHTS = (3, 3, 4)  # pair, triple, square
+SIDE_CHOICES = (5, 6)
+GAP_CHOICES = (2, 3)
