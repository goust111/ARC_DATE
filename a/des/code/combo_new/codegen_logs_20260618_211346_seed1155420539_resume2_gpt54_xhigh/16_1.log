+    if len(abs_pts) != 2:
+        return None
+    (ar, ac), (br, bc) = abs_pts
+    if abs(ar - br) + abs(ac - bc) != 1:
+        return None
+    if ar == br:
+        first, second = sorted(abs_pts, key=lambda p: (p[1], p[0]))
+    elif ac == bc:
+        first, second = sorted(abs_pts, key=lambda p: (p[0], p[1]))
