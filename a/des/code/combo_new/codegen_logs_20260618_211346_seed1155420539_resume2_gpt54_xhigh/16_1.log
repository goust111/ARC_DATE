+def _extract_outer_sprites(grid: np.ndarray, frames: list[dict]) -> dict[int, np.ndarray]:
+    inside = np.zeros_like(grid, dtype=bool)
+    for frame in frames:
+        r0, c0, r1, c1 = frame["interior"]
+        inside[r0 : r1 + 1, c0 : c1 + 1] = True
