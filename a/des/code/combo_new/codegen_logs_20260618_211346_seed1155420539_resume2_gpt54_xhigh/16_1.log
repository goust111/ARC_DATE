+            np.all(grid[r0, c0 : c1 + 1] == GRAY)
+            and np.all(grid[r1, c0 : c1 + 1] == GRAY)
+            and np.all(grid[r0 : r1 + 1, c0] == GRAY)
+            and np.all(grid[r0 : r1 + 1, c1] == GRAY)
