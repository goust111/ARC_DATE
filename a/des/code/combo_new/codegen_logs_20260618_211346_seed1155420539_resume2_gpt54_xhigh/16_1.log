+        specs.append(
+            {
+                "sprite_color": sprite_colors[idx],
+                "command": commands[idx],
+                "sprite_shape": sprite_shape,
+                "final_shape": final_shape,
+                "room_h": room_h,
+                "room_w": room_w,
+                "anchors": anchors,
+                "should_fit": should_fit,
