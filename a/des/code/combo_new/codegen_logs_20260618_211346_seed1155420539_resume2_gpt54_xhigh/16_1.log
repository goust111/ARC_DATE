        rng.shuffle(remaining)
        chosen: list[int] = []
        ok = True
        for command in commands:
            options = [color for color in remaining if color != command]
            if not options:
                ok = False
                break
            color = rng.choice(options)
            remaining.remove(color)
            chosen.append(color)
        if ok:
            return chosen
    return None


