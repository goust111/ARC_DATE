+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r1 + pad + 1)
+    cc1 = min(ww, c1 + pad + 1)
+    if occupied[rr0:rr1, cc0:cc1].any():
+        return False
+    occupied[rr0:rr1, cc0:cc1] = True
+    return True
+
+
+def _place_rect(occupied: np.ndarray, h: int, w: int, rng: random.Random) -> Optional[tuple[int, int]]:
