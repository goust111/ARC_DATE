        room_w = sw + rng.randint(0, 3)
        return room_h, room_w
    fail_axes = []
    if sh > 2:
        fail_axes.append("h")
    if sw > 2:
        fail_axes.append("w")
    if not fail_axes:
        return None
    axis = rng.choice(fail_axes)

