ROTATION_COLORS = [RED, GREEN, YELLOW, BLUE]
CANVAS_LIMIT = 30
GEN_RETRIES = 300

SHAPE_LIBRARY = [
    np.array([[1, 0], [1, 0], [1, 1]], dtype=bool),
    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
    np.array([[1, 1, 1], [1, 0, 0], [1, 0, 0]], dtype=bool),
