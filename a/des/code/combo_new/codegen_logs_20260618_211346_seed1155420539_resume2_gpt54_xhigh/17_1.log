+def _bbox_from_coords(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return (min(rows), min(cols), max(rows), max(cols))
+
+
+def _bbox_hw(bbox):
+    r0, c0, r1, c1 = bbox
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _bbox_gap_distance(a, b):
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    if ar1 < br0:
+        row_gap = br0 - ar1 - 1
+    elif br1 < ar0:
+        row_gap = ar0 - br1 - 1
+    else:
+        row_gap = 0
+    if ac1 < bc0:
+        col_gap = bc0 - ac1 - 1
+    elif bc1 < ac0:
+        col_gap = ac0 - bc1 - 1
+    else:
+        col_gap = 0
+    return row_gap + col_gap
+
+
+def _bbox_center_distance(a, b):
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    ac_r = ar0 + ar1
+    ac_c = ac0 + ac1
+    bc_r = br0 + br1
+    bc_c = bc0 + bc1
+    return abs(ac_r - bc_r) + abs(ac_c - bc_c)
+
+
+def _components_by_color(grid):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "bbox": _bbox_from_coords(coords)})
+    return comps
