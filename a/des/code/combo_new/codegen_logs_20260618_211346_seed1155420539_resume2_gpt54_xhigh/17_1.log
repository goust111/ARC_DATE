+    if not np.all(patch[:, -1] == GREY):
+        return None
+    if not np.all(patch[1:-1, 1:-1] == BG):
+        return None
+    return {
+        "bbox": comp["bbox"],
+        "bbox_h": h,
+        "bbox_w": w,
+        "inner_h": h - 2,
+        "inner_w": w - 2,
+    }
