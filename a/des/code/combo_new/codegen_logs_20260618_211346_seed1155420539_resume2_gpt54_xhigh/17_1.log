+    if int(grid[0, 0]) != BG:
+        end = 0
+        while end < h and int(grid[end, 0]) != BG:
+            end += 1
+        add_candidate(list(range(end)), 0, "top_left")
+    if int(grid[0, w - 1]) != BG:
+        end = 0
+        while end < h and int(grid[end, w - 1]) != BG:
+            end += 1
+        add_candidate(list(range(end)), w - 1, "top_right")
