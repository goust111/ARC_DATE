+
+def _select_frames_and_outlines(grid, palette):
+    comps = _components_by_color(grid)
+    palette_cells = palette["coords"]
+    palette_len = len(palette["colors"])
+
+    frame_candidates = []
+    outline_candidates = []
+    for comp in comps:
