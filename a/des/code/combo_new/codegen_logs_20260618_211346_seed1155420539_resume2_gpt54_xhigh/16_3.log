+def _monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if visited[r, c] or color == bg:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+            comp_coords = np.array(coords, dtype=int)
+            components.append({"color": color, "coords": comp_coords, "bbox": _bbox(comp_coords)})
