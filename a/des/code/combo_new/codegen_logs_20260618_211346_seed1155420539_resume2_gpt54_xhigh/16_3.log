+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+GEN_BG = 0
+GEN_SEPARATOR = 9
+GEN_COLORS = tuple(color for color in range(10) if color not in {GEN_BG, GEN_SEPARATOR})
+GEN_RETRY_LIMIT = 400
+GEN_LAYOUT_ATTEMPTS = 80
