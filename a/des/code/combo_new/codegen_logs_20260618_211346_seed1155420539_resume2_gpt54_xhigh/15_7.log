+
+def _transform_mask(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = mask.copy()
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    turns = rng.randrange(4)
+    out = np.rot90(out, turns)
