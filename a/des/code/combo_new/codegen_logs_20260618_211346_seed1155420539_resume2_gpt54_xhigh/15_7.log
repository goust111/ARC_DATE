+def _downsample_if_uniform(mask: np.ndarray, factor: int) -> np.ndarray | None:
+    h, w = mask.shape
+    if h % factor != 0 or w % factor != 0:
+        return None
+    blocks = mask.reshape(h // factor, factor, w // factor, factor)
+    reduced = blocks[:, 0, :, 0]
+    if np.all(blocks == reduced[:, None, :, None]):
+        return reduced.copy()
+    return None
