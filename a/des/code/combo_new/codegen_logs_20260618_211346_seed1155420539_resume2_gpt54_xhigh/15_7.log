+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+_RNG = random.Random()
+_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+_CANVAS_SIDE = 30
+_GEN_RETRIES = 400
