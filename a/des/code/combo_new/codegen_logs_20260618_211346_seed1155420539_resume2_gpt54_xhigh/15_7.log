+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in _DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
