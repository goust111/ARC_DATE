+    for _ in range(rng.randint(2, 4)):
+        side = rng.choice(SIDES)
+        if side in ("top", "bottom"):
+            if bw < 3:
+                continue
+            c = rng.randint(c0 + 1, c0 + bw - 2)
+            if rng.random() < 0.5:
