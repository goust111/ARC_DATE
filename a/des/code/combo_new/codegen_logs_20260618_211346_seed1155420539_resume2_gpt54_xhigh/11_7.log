+    if len(positions) < SPAN_MIN:
+        return spans
+
+    for length in range(SPAN_MIN, min(SPAN_MAX, len(positions)) + 1):
+        starts = range(0, len(positions) - length + 1)
+        if len(positions) - length >= 2:
+            starts = range(1, len(positions) - length)
