+    overlap = mask & occ
+    if int(overlap.sum()) != len(positions):
+        return None
+    if not _is_connected(mask):
+        return None
+    r0, c0, r1, c1 = _bbox_from_mask(mask)
+    if int(mask.sum()) == (r1 - r0 + 1) * (c1 - c0 + 1):
+        return None
+    return mask
+
+
+def _sample_piece(
+    occ: np.ndarray,
+    color: int,
+    prev_area: int,
+    rng: random.Random,
