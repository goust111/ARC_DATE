+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BOARD_COLOR = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 22
+GRID_MAX = 30
+BASE_H_RANGE = (5, 7)
+BASE_W_RANGE = (5, 7)
+PIECE_COUNT_CHOICES = (3, 4)
+SPAN_MIN = 3
+SPAN_MAX = 6
+THICKNESS_MIN = 2
+THICKNESS_MAX = 3
+EXTRA_MAX = 2
+MIN_PIECE_AREA = 5
+MAX_GEN_ATTEMPTS = 400
