+        for rot in rotations:
+            ph, pw = rot.shape
+            if ph > h or pw > w:
+                continue
+            padded = _dilate8(used)
+            for _ in range(200):
+                r0 = rng.randint(0, h - ph)
+                c0 = rng.randint(0, w - pw)
+                mask = rot != BG
+                if bool((padded[r0 : r0 + ph, c0 : c0 + pw] & mask).any()):
+                    continue
+                _paste(inp, rot, r0, c0)
+                used[r0 : r0 + ph, c0 : c0 + pw] |= mask
+                placed = True
+                break
+            if placed:
