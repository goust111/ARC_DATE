+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = np.asarray(mask, dtype=bool).copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
