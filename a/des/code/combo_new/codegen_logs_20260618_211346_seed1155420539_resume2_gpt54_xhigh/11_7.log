+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BOARD_COLOR = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 22
+GRID_MAX = 30
+BASE_H_RANGE = (5, 7)
+BASE_W_RANGE = (5, 7)
+PIECE_COUNT_CHOICES = (3, 4, 5)
+SPAN_MIN = 3
+SPAN_MAX = 6
+THICKNESS_MIN = 2
+THICKNESS_MAX = 3
+EXTRA_MAX = 2
+MIN_PIECE_AREA = 7
+MAX_GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _component_dicts(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(mask)
+    assert pts.size > 0
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask_to_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_from_mask(mask)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    patch[sub] = int(color)
+    return patch
+
+
+def _crop_component_patch(grid: np.ndarray, comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    color = int(comp["color"])
+    for r, c in comp["coords"]:
+        patch[int(r) - r0, int(c) - c0] = color
+    return patch
+
+
+def _rotation_variants(patch: np.ndarray) -> list[np.ndarray]:
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    out: list[np.ndarray] = []
+    for k in range(4):
+        rot = np.rot90(patch, k)
+        mask = rot != BG
+        key = (tuple(map(int, rot.shape)), mask.tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(rot.copy())
+    return out
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    sub = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BG
+    sub[mask] = patch[mask]
+
+
+def _frontier_mask(mask: np.ndarray, side: str) -> np.ndarray:
+    m = np.asarray(mask, dtype=bool)
+    f = np.zeros_like(m, dtype=bool)
+    if side == "top":
+        f[:-1, :] = m[:-1, :] & ~m[1:, :]
+        f[-1, :] = m[-1, :]
+    elif side == "bottom":
+        f[1:, :] = m[1:, :] & ~m[:-1, :]
+        f[0, :] = m[0, :]
+    elif side == "left":
+        f[:, :-1] = m[:, :-1] & ~m[:, 1:]
+        f[:, -1] = m[:, -1]
+    else:
+        f[:, 1:] = m[:, 1:] & ~m[:, :-1]
+        f[:, 0] = m[:, 0]
+    return f
+
+
+def _envelopes(mask: np.ndarray) -> dict[str, np.ndarray]:
+    occ = np.asarray(mask, dtype=bool)
+    h, w = occ.shape
+    top = np.full(w, h, dtype=int)
+    bottom = np.full(w, -1, dtype=int)
+    left = np.full(h, w, dtype=int)
+    right = np.full(h, -1, dtype=int)
+    for c in range(w):
+        rows = np.where(occ[:, c])[0]
+        if rows.size:
+            top[c] = int(rows[0])
+            bottom[c] = int(rows[-1])
+    for r in range(h):
+        cols = np.where(occ[r])[0]
+        if cols.size:
+            left[r] = int(cols[0])
+            right[r] = int(cols[-1])
+    return {"top": top, "bottom": bottom, "left": left, "right": right}
+
+
+def _choose_board_component(comps: list[dict], h: int, w: int) -> int:
+    cr = (h - 1) / 2.0
+    cc = (w - 1) / 2.0
+    ranked = []
+    for i, comp in enumerate(comps):
+        r0, c0, r1, c1 = comp["bbox"]
+        contains_center = r0 <= cr <= r1 and c0 <= cc <= c1
+        mean_r = sum(r for r, _ in comp["coords"]) / float(comp["area"])
+        mean_c = sum(c for _, c in comp["coords"]) / float(comp["area"])
+        dist = (mean_r - cr) ** 2 + (mean_c - cc) ** 2
+        ranked.append((0 if contains_center else 1, dist, -comp["area"], i))
+    ranked.sort()
+    return int(ranked[0][-1])
+
+
+def _placement_fits(
+    occ: np.ndarray,
+    envelopes: dict[str, np.ndarray],
+    bbox: tuple[int, int, int, int],
+    mask: np.ndarray,
+    frontier: np.ndarray,
+    side: str,
+    r0: int,
+    c0: int,
+) -> bool:
+    fr = np.argwhere(frontier)
+    body = np.argwhere(mask & ~frontier)
+    if fr.size == 0 or body.size == 0:
+        return False
+    h, w = occ.shape
+    ph, pw = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+        return False
+    if side == "top":
+        for rr, cc in fr:
