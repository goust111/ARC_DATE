+                break
+        if not placed:
+            return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(GRID_MIN, GRID_MAX)
+    w = rng.randint(GRID_MIN, GRID_MAX)
+    board_mask = _make_initial_board(h, w, rng)
+    if board_mask is None:
+        return None
+
+    final = np.full((h, w), BG, dtype=int)
+    final[board_mask] = BOARD_COLOR
+    occ = board_mask.copy()
+
+    piece_count = rng.choice(PIECE_COUNT_CHOICES)
+    colors = rng.sample(PIECE_COLORS, piece_count)
+    pieces: list[dict] = []
+    prev_area = h * w + 1
+    for color in colors:
+        piece = None
+        for _ in range(120):
+            piece = _sample_piece(occ, color, prev_area, rng)
+            if piece is not None:
+                break
+        if piece is None:
+            return None
+        pieces.append(piece)
+        prev_area = int(piece["area"])
+        occ |= piece["mask"]
+        final[piece["mask"]] = int(color)
+
+    inp = np.full((h, w), BG, dtype=int)
+    inp[board_mask] = BOARD_COLOR
+    if not _scatter_pieces(inp, board_mask, pieces, rng):
+        return None
+
+    comps = _component_dicts(inp, bg=BG)
+    if len(comps) != piece_count + 1:
+        return None
+    if int(np.sum(inp == BG)) <= int(np.sum(inp != BG)):
+        return None
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, final):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample for puzzle 7")

