+        idx = rng.randrange(length)
+        vals[idx] = 1
+        for i in range(idx - 1, -1, -1):
+            vals[i] = max(0, min(vals[i], vals[i + 1] + 1))
+        for i in range(idx + 1, length):
+            vals[i] = max(0, min(vals[i], vals[i - 1] + 1))
+    return vals
