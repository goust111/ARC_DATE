+        f[-1, :] = m[-1, :]
+    elif side == "bottom":
+        f[1:, :] = m[1:, :] & ~m[:-1, :]
+        f[0, :] = m[0, :]
+    elif side == "left":
+        f[:, :-1] = m[:, :-1] & ~m[:, 1:]
+        f[:, -1] = m[:, -1]
+    else:
