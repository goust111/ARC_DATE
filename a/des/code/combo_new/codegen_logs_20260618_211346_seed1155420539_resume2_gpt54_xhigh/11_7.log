+def _random_walk_profile(length: int, rng: random.Random) -> list[int]:
+    vals = [rng.randint(0, min(1, EXTRA_MAX))]
+    for _ in range(length - 1):
+        prev = vals[-1]
+        opts = [v for v in (prev - 1, prev, prev + 1) if 0 <= v <= EXTRA_MAX]
+        vals.append(rng.choice(opts))
