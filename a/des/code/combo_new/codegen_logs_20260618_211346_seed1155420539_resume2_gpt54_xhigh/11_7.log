+                return False
+        for rr, cc in body:
+            gr, gc = int(rr + r0), int(cc + c0)
+            if bool(occ[gr, gc]):
+                return False
+        return int(body[:, 1].min()) + c0 < int(bbox[1])
+    for rr, cc in fr:
+        gr, gc = int(rr + r0), int(cc + c0)
