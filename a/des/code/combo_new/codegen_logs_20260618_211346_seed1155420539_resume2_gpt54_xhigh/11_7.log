+                    changed = True
+            else:
+                rr = r0 if side == "top" else r0 + bh - 1
+                inner = rr + 1 if side == "top" else rr - 1
+                if 0 <= inner < h and bool(mask[rr, c]) and bool(mask[inner, c]):
