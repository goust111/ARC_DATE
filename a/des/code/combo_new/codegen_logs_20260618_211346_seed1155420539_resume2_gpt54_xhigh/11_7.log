+        return int(body[:, 0].min()) + r0 < int(bbox[0])
+    if side == "bottom":
+        for rr, cc in fr:
+            gr, gc = int(rr + r0), int(cc + c0)
+            if not bool(occ[gr, gc]) or int(envelopes["bottom"][gc]) != gr:
+                return False
+        for rr, cc in body:
