+def _scatter_pieces(inp: np.ndarray, board_mask: np.ndarray, pieces: list[dict], rng: random.Random) -> bool:
+    h, w = inp.shape
+    used = board_mask.copy()
+    order = list(range(len(pieces)))
+    order.sort(key=lambda i: -pieces[i]["area"])
+    for idx in order:
