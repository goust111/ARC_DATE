+def _frontier_mask(mask: np.ndarray, side: str) -> np.ndarray:
+    m = np.asarray(mask, dtype=bool)
+    f = np.zeros_like(m, dtype=bool)
+    if side == "top":
+        f[:-1, :] = m[:-1, :] & ~m[1:, :]
+        f[-1, :] = m[-1, :]
+    elif side == "bottom":
+        f[1:, :] = m[1:, :] & ~m[:-1, :]
+        f[0, :] = m[0, :]
+    elif side == "left":
+        f[:, :-1] = m[:, :-1] & ~m[:, 1:]
+        f[:, -1] = m[:, -1]
+    else:
+        f[:, 1:] = m[:, 1:] & ~m[:, :-1]
+        f[:, 0] = m[:, 0]
+    return f
