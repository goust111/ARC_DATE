+            outer = inner - thickness - add
+            if outer < 0:
+                return None
+            mask[r, outer : inner + 1] = True
+    else:
+        for r, inner, add in zip(positions, inner_profile, extra):
+            outer = inner + thickness + add
+            if outer >= w:
