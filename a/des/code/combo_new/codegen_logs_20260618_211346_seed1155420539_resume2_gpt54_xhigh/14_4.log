+ARC_COLORS = tuple(range(10))
+LEGEND_SIZE = 5
+GRID_SIDE_MIN, GRID_SIDE_MAX = 16, 30
+OBJECT_COUNT_RANGE = (2, 5)
+OBJECT_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 400
+GENERATION_ATTEMPTS = 400
+SIDE_MARGIN = 1
+TOP_MARGIN = 2
+MAX_OBJECT_SIDE = 12
+LAYOUTS = {
+    0: [(1, 1), (1, 2), (2, 1), (2, 2)],
+    1: [(1, 1), (1, 2), (2, 1), (2, 2)],
+    2: [(1, 2), (2, 1), (2, 2), (1, 3), (3, 1)],
+    3: [(2, 2), (1, 3), (3, 1)],
+    4: [(2, 2)],
