+    out = g.copy()
+    out[0, :] = bg
+
+    for coords in _components(body == object_color):
+        hole_count = _component_hole_count(coords)
+        new_color = int(legend[hole_count])
+        out[coords[:, 0] + 1, coords[:, 1]] = new_color
+
+    return out
