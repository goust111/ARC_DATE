+            weights.append(1 + 3 * support)
+        chosen = rng.choices(choices, weights=weights, k=1)[0]
+        cells.add(chosen)
+        frontier = {
+            (nr, nc)
+            for r, c in cells
+            for nr, nc in _neighbors4(r, c)
