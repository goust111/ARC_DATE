+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(_GEN_COUNTER)
+        _GEN_COUNTER += 1
+        if grid is not None:
+            return grid
