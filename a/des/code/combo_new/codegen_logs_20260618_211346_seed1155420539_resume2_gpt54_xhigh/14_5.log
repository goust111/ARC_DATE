+    jagged_sides = [
+        side
+        for side, line in border_lines.items()
+        if line.any() and (~line).any() and _transitions(line) >= 2
+    ]
+    assert len(jagged_sides) == 1, f"expected exactly one jagged side, got {jagged_sides}"
+    side = jagged_sides[0]
+
+    if side in ("left", "right"):
+        for r in range(h):
