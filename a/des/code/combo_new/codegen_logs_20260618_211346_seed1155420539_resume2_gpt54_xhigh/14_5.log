+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _paste(canvas: np.ndarray, sprite: np.ndarray, top: int, left: int, bg: int) -> None:
+    mask = sprite != bg
+    canvas[top : top + sprite.shape[0], left : left + sprite.shape[1]][mask] = sprite[mask]
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+            for rr, cc in coords:
+                sprite[rr - r0, cc - c0] = color
+            components.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "sprite": sprite,
+                }
+            )
+    return components
+
+
+def _first_true_positions(mask: np.ndarray, axis: int) -> np.ndarray:
+    positions = []
+    if axis == 0:
