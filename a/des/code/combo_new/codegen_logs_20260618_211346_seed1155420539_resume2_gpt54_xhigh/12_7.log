+import random
+
+import numpy as np
+
+
+BLACK = 0
+FRAME_COLOR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+GENERATION_RETRIES = 400
+WINDOW_COUNT_CHOICES = (2, 3, 4)
+REFERENCE_H_RANGE = (8, 14)
+REFERENCE_W_RANGE = (8, 14)
