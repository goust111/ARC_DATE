+            r1 = rng.randint(r0 + 1, height - 1)
+            c0 = rng.randint(0, width - 2)
+            c1 = rng.randint(c0 + 1, width - 1)
+            ref[r0 : r1 + 1, c0 : c1 + 1] = color
+        elif kind == "rows":
