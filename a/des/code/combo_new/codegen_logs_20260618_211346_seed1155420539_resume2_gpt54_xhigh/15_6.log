+def _classify_ring(patch: np.ndarray) -> Optional[dict]:
+    cell_size = patch.shape[0]
+    if np.any(patch[1:-1, 1:-1] != BG):
+        return None
+
+    border = np.zeros_like(patch, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    non_bg = patch[border][patch[border] != BG]
+    if non_bg.size == 0:
