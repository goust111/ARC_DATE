+
+    gap_cells = np.argwhere(border & (patch == BG))
+    if gap_cells.shape[0] != 1:
+        return None
+    gap = tuple(map(int, gap_cells[0]))
+
+    direction = None
+    for name in DIRS:
+        if gap == _gap_position(cell_size, name):
+            direction = name
