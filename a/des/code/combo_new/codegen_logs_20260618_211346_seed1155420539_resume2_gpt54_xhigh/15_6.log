+def _gap_position(cell_size: int, direction: str) -> tuple[int, int]:
+    mid = cell_size // 2
+    if direction == "up":
+        return 0, mid
+    if direction == "down":
+        return cell_size - 1, mid
+    if direction == "left":
+        return mid, 0
+    if direction == "right":
+        return mid, cell_size - 1
+    raise ValueError(f"unknown direction: {direction}")
+
