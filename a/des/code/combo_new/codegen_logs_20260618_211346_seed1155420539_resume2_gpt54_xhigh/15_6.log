+    start = _target_start(cell_size)
+    mask = np.zeros_like(patch, dtype=bool)
+    mask[start : start + 3, start : start + 3] = True
+
+    block = patch[mask]
+    if np.any(block == BG):
+        return None
+    color = int(block[0])
+    if not np.all(block == color):
+        return None
+    if np.any(patch[~mask] != BG):
+        return None
+    return {"kind": "target", "color": color}
+
