+            "min_dc": int(min_dc),
+            "max_dc": int(max_dc),
+            "bbox_h": int(bbox_h),
+            "bbox_w": int(bbox_w),
+            "anchor_in_bbox": (-int(min_dr), -int(min_dc)),
+            "area": int(len(offsets)),
