+    return None
+
+
+def _place_in_template(
+    rng: random.Random, template_h: int, template_w: int, specs: list[dict[str, object]]
+) -> tuple[list[tuple[int, int]], set[tuple[int, int]]] | None:
+    order = list(range(len(specs)))
