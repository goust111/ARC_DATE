+    for color in colors:
+        placed = _place_object(grid, reserved, color)
+        if placed is None:
+            return None
+        line_specs.append(placed)
+
+    expected = grid.copy()
+    for color, line_coords in line_specs:
+        _paint_line(expected, 0, 0, line_coords, color)
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
