+def _paint_ring(grid: np.ndarray, r0: int, c0: int, ring: np.ndarray, color: int) -> None:
+    view = grid[r0 : r0 + ring.shape[0], c0 : c0 + ring.shape[1]]
+    view[ring] = int(color)
