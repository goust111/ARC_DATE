+def _used_bbox(height: int, width: int, line: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [0, height - 1] + [r for r, _c in line]
+    cols = [0, width - 1] + [c for _r, c in line]
+    return min(rows), min(cols), max(rows), max(cols)
