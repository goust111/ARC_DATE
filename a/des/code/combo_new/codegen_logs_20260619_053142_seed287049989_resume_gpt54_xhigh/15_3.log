+    specs: list[dict[str, object]] = []
+    for r0, r1 in _intervals(h, list(row_colors)):
+        for c0, c1 in _intervals(w, list(col_colors)):
+            region_h = r1 - r0 + 1
+            region_w = c1 - c0 + 1
+            placed = _place_region_objects(region_h, region_w)
