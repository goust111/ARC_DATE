+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+DIVIDER_PALETTE = (1, 2, 3, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+REGION_ATTEMPTS = 160
