+def _place_region_objects(region_h: int, region_w: int) -> tuple[
+    set[tuple[int, int]],
+    tuple[tuple[int, int], ...],
+    list[tuple[int, int]],
+] | None:
+    for _ in range(REGION_ATTEMPTS):
+        shape = _transform_shape(random.choice(BASE_SHAPES))
+        shape_h, shape_w = _shape_dims(shape)
