+def _intervals(size: int, lines: list[int]) -> list[tuple[int, int]]:
+    cuts = [-1] + sorted(lines) + [size]
+    spans: list[tuple[int, int]] = []
+    for left, right in zip(cuts, cuts[1:]):
+        start = left + 1
+        end = right - 1
+        if start <= end:
+            spans.append((start, end))
+    return spans
