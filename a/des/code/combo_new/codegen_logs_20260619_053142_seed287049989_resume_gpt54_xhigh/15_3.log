+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+DIVIDER_PALETTE = (1, 2, 3, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+REGION_ATTEMPTS = 160
+
+BASE_SHAPES = (
+    ((0, 0), (0, 1), (0, 2)),
+    ((0, 0), (1, 0), (1, 1)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 1), (1, 0), (1, 1), (1, 2)),
+    ((0, 1), (0, 2), (1, 0), (1, 1)),
