+
+def _transform_shape(shape: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    cells = set(shape)
+    for _ in range(random.randint(0, 3)):
+        cells = {(c, -r) for r, c in cells}
+    if random.random() < 0.5:
+        cells = {(r, -c) for r, c in cells}
+    return _normalize(cells)
