+def _enumerate_connected_shapes(max_area: int = 7) -> dict[int, set[tuple[tuple[int, int], ...]]]:
+    shapes: dict[int, set[tuple[tuple[int, int], ...]]] = {1: {((0, 0),)}}
+    for area in range(1, max_area):
