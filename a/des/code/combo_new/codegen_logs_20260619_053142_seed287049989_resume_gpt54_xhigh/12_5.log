+import random
+
+import numpy as np
+
+
+BACKGROUND = 8
+PALETTE = (0, 1, 2, 3, 4, 5, 6, 7, 9)
+GEN_ATTEMPTS = 400
+SCENARIOS = ("single", "tie", "cross", "mixed")
