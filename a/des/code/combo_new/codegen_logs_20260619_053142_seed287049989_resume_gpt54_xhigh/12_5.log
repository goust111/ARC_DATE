+
+    return {
+        "line_count": len(lines),
+        "both_orientations": len({line["orientation"] for line in lines}) > 1,
+        "idle_line": any(hit == 0 for hit in line_hits),
+        "has_tie": has_tie,
+        "has_multi_cut": has_multi_cut,
+        "affected_rects": affected_rects,
+    }
+
