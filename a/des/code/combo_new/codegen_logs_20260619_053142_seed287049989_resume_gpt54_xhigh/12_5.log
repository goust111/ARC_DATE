+    seen_lines = set()
+    for line in lines:
+        key = (line["orientation"], line["index"])
+        assert key not in seen_lines, "marker pairs must define distinct cut lines"
+        seen_lines.add(key)
+
+    assert rectangles, "expected at least one rectangle"
+    return bg, lines, rectangles
