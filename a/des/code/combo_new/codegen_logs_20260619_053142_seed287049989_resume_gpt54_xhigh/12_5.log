+        r0 = int(coords[:, 0].min())
+        r1 = int(coords[:, 0].max())
+        c0 = int(coords[:, 1].min())
+        c1 = int(coords[:, 1].max())
+        expected_area = (r1 - r0 + 1) * (c1 - c0 + 1)
+        assert int(coords.shape[0]) == expected_area, "foreground objects must be solid rectangles"
+        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "rectangle bbox must be monochrome"
