+            return None
+        rec["key_pos"] = pos
+        _paste(grid, rec["key_patch"], pos[0], pos[1])
+        _reserve(occupied, pos[0], pos[1], rec["key_shape"])
+
+    expected = _expected_output(grid, records)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
