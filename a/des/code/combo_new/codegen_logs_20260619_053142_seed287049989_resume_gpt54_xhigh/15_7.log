+    }
+
+
+def _sample_canvas(shapes: list[tuple[int, int]]) -> tuple[int, int]:
+    need = sum((h + 2 * (OBJECT_MARGIN + OUTER_PAD)) * (w + 2 * (OBJECT_MARGIN + OUTER_PAD)) for h, w in shapes)
