+BG = 0
+COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 500
+OUTER_PAD = 1
+OBJECT_MARGIN = 1
+
+
+def _background_color(grid: np.ndarray) -> int:
