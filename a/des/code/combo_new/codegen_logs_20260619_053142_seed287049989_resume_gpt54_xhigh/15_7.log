+
+
+def _corner_notch(h: int, w: int) -> tuple[tuple[Coord, ...], int]:
+    size = random.randint(3, 5)
+    splits = []
+    for arm_h in range(2, size):
+        arm_w = size + 1 - arm_h
+        if arm_h >= 2 and arm_w >= 2 and arm_h <= h and arm_w <= w:
+            splits.append((arm_h, arm_w))
