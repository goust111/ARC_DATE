+    max_w_allowed = min(30, side + 6)
+    return random.randint(min_h, max_h_allowed), random.randint(min_w, max_w_allowed)
+
+
+def _find_position(
+    occupied: np.ndarray, patch_shape: tuple[int, int], margin: int = OBJECT_MARGIN, pad: int = OUTER_PAD
+) -> tuple[int, int] | None:
+    h, w = occupied.shape
