+    else:  # bottom-left
+        coords = {(h - 1 - r, 0) for r in range(arm_h)} | {(h - 1, c) for c in range(arm_w)}
+    return tuple(sorted(coords)), corner
+
+
+def _frame_patch(h: int, w: int, color: int, missing: Iterable[Coord]) -> np.ndarray:
+    patch = np.zeros((h, w), dtype=int)
+    patch[0, :] = color
+    patch[h - 1, :] = color
+    patch[:, 0] = color
+    patch[:, w - 1] = color
+    for r, c in missing:
