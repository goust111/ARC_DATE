+                for direction in legend_lengths
+            }
+            panel = _build_panel(
+                size=size,
+                bg=bg,
+                lengths=lengths,
+                marker_count=rng.randint(*MARKER_COUNT_RANGE),
+                rng=rng,
+            )
+            r0 = _panel_origin(i, size)
+            c0 = _panel_origin(j, size)
+            grid[r0 : r0 + size, c0 : c0 + size] = panel
