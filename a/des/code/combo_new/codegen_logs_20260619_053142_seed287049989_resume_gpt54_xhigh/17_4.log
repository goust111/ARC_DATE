+    for j in range(1, panel_cols):
+        grid[:, _panel_origin(j, size) - 1] = GREY
+
+    legend_panel = _build_panel(
+        size=size,
+        bg=bg,
+        lengths=legend_lengths,
+        marker_count=0,
+        rng=rng,
+        tip_colors=legend_tip_colors,
