+
+
+def _rotation_schedule(count: int, rng: random.Random) -> list[int]:
+    if count >= 4 and rng.random() < 0.5:
+        rotations = [0, 1, 2, 3]
+    else:
+        rotations = [rng.choice((0, 2)), rng.choice((1, 3))]
+    while len(rotations) < count:
+        rotations.append(rng.randrange(4))
