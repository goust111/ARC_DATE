+            rotation = rotations[idx]
+            idx += 1
+            lengths = {
+                _rotate_dir(direction, rotation): arm_len
+                for direction in legend_lengths
+            }
+            panel = _build_panel(
+                size=size,
+                bg=bg,
+                lengths=lengths,
+                marker_count=rng.randint(*MARKER_COUNT_RANGE),
