+        {0: 3, 1: 3, 2: 2},
+        {0: 3, 1: 2, 2: 3},
+        {0: 2, 1: 3, 2: 3},
+        {0: 4, 1: 2, 2: 2},
+        {0: 2, 1: 4, 2: 2},
+        {0: 2, 1: 2, 2: 4},
