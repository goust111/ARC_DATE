+
+def _sample_group_counts(rng: random.Random) -> dict[int, int]:
+    counts = {0: 2, 1: 2, 2: 2}
+    for _ in range(rng.randint(0, 3)):
+        hole_count = rng.choice([0, 1, 2])
+        counts[hole_count] += 1
