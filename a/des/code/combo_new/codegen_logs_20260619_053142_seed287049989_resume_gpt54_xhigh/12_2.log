+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    group_counts = _sample_group_counts(rng)
+    total_objects = sum(group_counts.values())
+    compact = total_objects >= 8
+    colors = rng.sample(list(range(1, 10)), total_objects)
