+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _components_of_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _analyze_regions(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comp_id = np.full((h, w), -1, dtype=int)
+    regions: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+
+            coords = np.array(pts, dtype=int)
+            rid = len(regions)
+            comp_id[coords[:, 0], coords[:, 1]] = rid
+            regions.append(
+                {
+                    "id": rid,
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                    "hole_count": 0,
+                }
+            )
+
+    for coords in _components_of_mask(g == bg):
+        if np.any(coords[:, 0] == 0) or np.any(coords[:, 0] == h - 1) or np.any(coords[:, 1] == 0) or np.any(coords[:, 1] == w - 1):
+            continue
+        owners = set()
+        for r, c in coords:
+            for dr, dc in DIR4:
+                nr, nc = int(r + dr), int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w and comp_id[nr, nc] != -1:
+                    owners.add(int(comp_id[nr, nc]))
+        if len(owners) == 1:
+            regions[next(iter(owners))]["hole_count"] += 1
+
+    return regions
