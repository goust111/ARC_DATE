+    side_lengths = [2 * len(groups[k]) - 1 for k in hole_keys]
+    out_h = max(side_lengths)
+    out_w = sum(side_lengths) + max(0, len(side_lengths) - 1)
+    out = np.full((out_h, out_w), bg, dtype=int)
