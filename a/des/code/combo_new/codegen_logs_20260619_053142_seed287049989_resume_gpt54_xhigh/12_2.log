+def _draw_square_ring(out: np.ndarray, r0: int, c0: int, size: int, layer: int, color: int) -> None:
+    a = layer
+    b = size - 1 - layer
+    rr0 = r0 + a
+    rr1 = r0 + b
+    cc0 = c0 + a
+    cc1 = c0 + b
+    out[rr0, cc0 : cc1 + 1] = color
+    out[rr1, cc0 : cc1 + 1] = color
+    out[rr0 : rr1 + 1, cc0] = color
+    out[rr0 : rr1 + 1, cc1] = color
+
