+    rr1 = r0 + b
+    cc0 = c0 + a
+    cc1 = c0 + b
+    out[rr0, cc0 : cc1 + 1] = color
+    out[rr1, cc0 : cc1 + 1] = color
+    out[rr0 : rr1 + 1, cc0] = color
+    out[rr0 : rr1 + 1, cc1] = color
