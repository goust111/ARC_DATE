+    placed_grid = np.zeros((height, width), dtype=int)
+    by_signature: dict[tuple[int, int, int], list[dict]] = defaultdict(list)
+    for spec in specs:
+        key = (spec["mask"].shape[0], spec["mask"].shape[1], spec["area"])
+        by_signature[key].append(spec)
