+    for mask in sorted(masks, key=lambda arr: (-(arr.shape[0] * arr.shape[1]), -int(arr.sum()))):
+        mh, mw = mask.shape
+        candidates: list[tuple[int, int]] = []
+        for r0 in range(1, height - mh):
