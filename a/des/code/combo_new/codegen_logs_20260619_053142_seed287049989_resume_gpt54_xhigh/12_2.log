+    regions: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
