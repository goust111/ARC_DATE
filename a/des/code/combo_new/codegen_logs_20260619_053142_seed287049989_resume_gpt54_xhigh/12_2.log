+            core_w = rng.randint(5, 7)
+        else:
+            core_h = rng.randint(6, 8)
+            core_w = rng.randint(6, 8)
+
+        top = rng.randint(0, 2)
+        bottom = rng.randint(0, 2)
+        left = rng.randint(0, 2)
+        right = rng.randint(0, 2)
