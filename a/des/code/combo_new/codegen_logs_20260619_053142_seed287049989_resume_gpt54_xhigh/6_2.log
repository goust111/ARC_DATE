+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    keys = []
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        keys.append((tuple(map(int, rot.shape)), rot.tobytes()))
