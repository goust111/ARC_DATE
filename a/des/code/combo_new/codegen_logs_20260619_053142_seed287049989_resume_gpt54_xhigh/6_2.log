+            for rr, cc in cells:
+                r = int(top + rr)
+                c = int(left + cc)
+                reserved[max(0, r - 1) : min(template_h, r + 2), max(0, c - 1) : min(template_w, c + 2)] = True
+            break
+        if placements[idx] is None:
