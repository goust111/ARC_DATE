+    base_side = int(np.ceil(np.sqrt(padded_area * 1.15)))
+    max_h = max(int(shape.shape[0]) for shape in shapes)
+    max_w = max(int(shape.shape[1]) for shape in shapes)
+
+    hole_positions = None
+    template_h = template_w = 0
+    for _ in range(80):
