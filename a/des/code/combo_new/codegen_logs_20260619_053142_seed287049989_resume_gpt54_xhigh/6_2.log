+    for idx in order:
+        mask = shapes[idx]
+        cells = np.argwhere(mask)
+        h, w = mask.shape
+        positions = [(r, c) for r in range(1, template_h - h) for c in range(1, template_w - w)]
+        RNG.shuffle(positions)
+        for top, left in positions:
+            if any(reserved[top + rr, left + cc] for rr, cc in cells):
+                continue
