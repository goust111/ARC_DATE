+    side = ring["side"]  # type: ignore[index]
+    gap_start = ring["gap_start"]  # type: ignore[index]
+    cells: List[Tuple[int, int]] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if r not in (r0, r1) and c not in (c0, c1):
