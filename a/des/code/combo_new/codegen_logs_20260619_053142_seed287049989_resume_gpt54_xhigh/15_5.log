+        if side == "top":
+            if sr1 >= r0 or not _intervals_overlap(ray0, ray1, sc0, sc1):
+                continue
+            dist = r0 - sr1 - 1
+        elif side == "bottom":
+            if sr0 <= r1 or not _intervals_overlap(ray0, ray1, sc0, sc1):
