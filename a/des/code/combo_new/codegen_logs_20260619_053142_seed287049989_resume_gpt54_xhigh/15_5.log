+def _place_miss_rings(
+    rng: random.Random,
+    squares: Sequence[Dict[str, object]],
+    occupied: List[Tuple[int, int, int, int]],
+    colors: Sequence[int],
+    grid_shape: Tuple[int, int],
+) -> Optional[List[Dict[str, object]]]:
+    h, w = grid_shape
