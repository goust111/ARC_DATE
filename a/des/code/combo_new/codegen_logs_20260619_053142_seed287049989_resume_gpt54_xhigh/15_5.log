+        by_target[target_idx].append((distance, ring))
+
+    for target_idx, assigned in by_target.items():
+        assigned.sort(
+            key=lambda item: (
+                item[0],
+                item[1]["bbox"][0],  # type: ignore[index]
+                item[1]["bbox"][1],  # type: ignore[index]
+                SIDE_ORDER[item[1]["side"]],  # type: ignore[index]
+            )
+        )
