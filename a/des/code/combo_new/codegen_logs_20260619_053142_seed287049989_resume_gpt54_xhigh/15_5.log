+def _ring_gap_interval(ring: Dict[str, object]) -> Tuple[int, int]:
+    r0, c0, _r1, _c1 = ring["bbox"]  # type: ignore[index]
+    gap_start = ring["gap_start"]  # type: ignore[index]
+    if ring["side"] in ("top", "bottom"):  # type: ignore[index]
