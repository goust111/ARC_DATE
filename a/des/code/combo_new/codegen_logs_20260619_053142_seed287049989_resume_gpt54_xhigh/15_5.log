+                        for distance in distances:
+                            if distance in used:
+                                continue
+                            if side == "top":
+                                r0 = sr1 + 1 + distance
+                                bbox = (r0, c0, r0 + ring_h - 1, c0 + ring_w - 1)
+                            elif side == "bottom":
+                                r0 = sr0 - distance - ring_h
+                                bbox = (r0, c0, r0 + ring_h - 1, c0 + ring_w - 1)
+                            elif side == "left":
+                                c0 = sc1 + 1 + distance
+                                bbox = (r0, c0, r0 + ring_h - 1, c0 + ring_w - 1)
+                            else:
+                                c0 = sc0 - distance - ring_w
+                                bbox = (r0, c0, r0 + ring_h - 1, c0 + ring_w - 1)
