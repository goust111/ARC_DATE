+def _target_ring_candidates(
+    square_idx: int,
+    squares: Sequence[Dict[str, object]],
+    occupied: Sequence[Tuple[int, int, int, int]],
+    grid_shape: Tuple[int, int],
+    used_distances: Sequence[int],
+    color: int,
+) -> List[Dict[str, object]]:
+    h, w = grid_shape
