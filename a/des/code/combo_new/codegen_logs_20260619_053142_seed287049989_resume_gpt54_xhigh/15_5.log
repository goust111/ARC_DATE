+    miss = np.argwhere(missing)
+    rows = miss[:, 0]
+    cols = miss[:, 1]
+    if np.all(rows == 0):
+        side = "top"
+        values = sorted(int(c) for c in cols)
+    elif np.all(rows == h - 1):
+        side = "bottom"
+        values = sorted(int(c) for c in cols)
+    elif np.all(cols == 0):
+        side = "left"
+        values = sorted(int(r) for r in rows)
+    elif np.all(cols == w - 1):
+        side = "right"
+        values = sorted(int(r) for r in rows)
+    else:
+        return None
