+    if has_multi:
+        multi_idx = rng.choice(active)
+        cap = _layer_capacity(squares[multi_idx]["size"])  # type: ignore[index]
+        if has_overflow:
+            target_count = cap + 1
+        else:
+            target_count = rng.randint(2, cap)
+        counts[multi_idx] = max(counts[multi_idx], target_count)
