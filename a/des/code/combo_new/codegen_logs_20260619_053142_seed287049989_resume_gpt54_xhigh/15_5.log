+            r0 = rng.randint(0, h - size)
+            c0 = rng.randint(0, w - size)
+            bbox = (r0, c0, r0 + size - 1, c0 + size - 1)
+            if any(_bboxes_too_close(bbox, sq["bbox"]) for sq in squares):  # type: ignore[index]
