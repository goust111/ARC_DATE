+    miss = np.argwhere(missing)
+    rows = miss[:, 0]
+    cols = miss[:, 1]
+    if np.all(rows == 0):
+        side = "top"
+        values = sorted(int(c) for c in cols)
+    elif np.all(rows == h - 1):
