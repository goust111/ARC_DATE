+
+    occupied = [sq["bbox"] for sq in squares] + [ring["bbox"] for ring in target_rings]  # type: ignore[index]
+    miss_rings = _place_miss_rings(rng, squares, occupied, miss_colors, (grid_h, grid_w))
+    if miss_rings is None:
