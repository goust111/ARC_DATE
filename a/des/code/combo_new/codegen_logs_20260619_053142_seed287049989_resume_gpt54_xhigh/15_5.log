+                                bbox = (r0, c0, r0 + ring_h - 1, c0 + ring_w - 1)
+                            elif side == "left":
+                                c0 = sc1 + 1 + distance
+                                bbox = (r0, c0, r0 + ring_h - 1, c0 + ring_w - 1)
+                            else:
