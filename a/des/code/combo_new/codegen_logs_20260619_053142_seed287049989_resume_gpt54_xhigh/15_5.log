+
+def _bboxes_too_close(
+    a: Tuple[int, int, int, int], b: Tuple[int, int, int, int], margin: int = 1
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 < br0 - margin
+        or br1 < ar0 - margin
+        or ac1 < bc0 - margin
+        or bc1 < ac0 - margin
+    )
+
