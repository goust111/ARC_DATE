+    colors: Sequence[int],
+    grid_shape: Tuple[int, int],
+) -> Optional[List[Dict[str, object]]]:
+    occupied = [sq["bbox"] for sq in squares]  # type: ignore[index]
+    rings: List[Dict[str, object]] = []
