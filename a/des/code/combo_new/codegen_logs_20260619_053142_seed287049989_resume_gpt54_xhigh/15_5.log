+def _identify_ring(submask: np.ndarray) -> Optional[Tuple[str, int]]:
+    h, w = submask.shape
+    if not (5 <= h <= 7 and 5 <= w <= 7):
+        return None
+    border = _full_ring_border(h, w)
+    if np.any(submask & ~border):
