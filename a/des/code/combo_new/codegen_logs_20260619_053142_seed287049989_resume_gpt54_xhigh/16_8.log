+        "inner_bbox": (int(r0 + 1), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+        "color": int(next(iter(values))),
+        "inner_h": int(r1 - r0 - 1),
+        "inner_w": int(c1 - c0 - 1),
+    }
