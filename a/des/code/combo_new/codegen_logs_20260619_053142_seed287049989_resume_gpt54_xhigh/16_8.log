+import random
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in points]
+    cols = [c for _r, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _parse_filled_rect(g: np.ndarray, points: list[tuple[int, int]]) -> dict | None:
+    r0, c0, r1, c1 = _bbox(points)
+    patch = g[r0 : r1 + 1, c0 : c1 + 1]
+    if np.any(patch == BG):
+        return None
+    if len(points) != patch.size:
+        return None
+    colors = np.unique(patch)
+    if colors.size < 2:
+        return None
+    return {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "area": int(patch.size),
+    }
+
+
+def _parse_hollow_frame(g: np.ndarray, points: list[tuple[int, int]]) -> dict | None:
+    values = {int(g[r, c]) for r, c in points}
+    if len(values) != 1:
+        return None
+
+    r0, c0, r1, c1 = _bbox(points)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        local[r - r0, c - c0] = True
+
+    border = np.zeros_like(local, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(local, border):
+        return None
