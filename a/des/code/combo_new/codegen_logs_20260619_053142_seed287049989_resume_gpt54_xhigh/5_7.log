+
+def _bbox(coords: np.ndarray) -> Rect:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _inside(box: Rect, row: int, col: int) -> bool:
+    r0, c0, r1, c1 = box
+    return r0 <= row <= r1 and c0 <= col <= c1
