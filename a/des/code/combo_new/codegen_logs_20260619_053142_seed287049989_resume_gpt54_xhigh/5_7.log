+    bottom_margin = random.randint(MARGIN_MIN, MARGIN_MAX)
+    left_margin = random.randint(MARGIN_MIN, MARGIN_MAX)
+    right_margin = random.randint(MARGIN_MIN, MARGIN_MAX)
