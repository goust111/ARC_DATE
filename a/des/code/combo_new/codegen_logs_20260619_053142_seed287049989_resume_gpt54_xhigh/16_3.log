+import numpy as np
+
+
+BLACK = 0
+AZURE = 8
+MARKER_COLORS = np.array([1, 2, 3, 4, 6, 7, 9], dtype=int)
+CARDINALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
