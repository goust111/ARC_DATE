+        if mode == "stripe":
+            if random.random() < 0.5:
+                rr = random.randint(1, h - 2)
+                for c in range(1, w - 1):
+                    cell = (rr, c)
+                    if cell not in must_solid:
+                        holes.add(cell)
+            else:
