+                rh = random.randint(1, max(1, h - 3))
+                rw = random.randint(1, max(1, w - 3))
+                rr = random.randint(1, h - 1 - rh)
+                cc = random.randint(1, w - 1 - rw)
+                for cell in _rect_cells(rr, cc, rr + rh - 1, cc + rw - 1):
+                    if cell not in must_solid:
+                        holes.add(cell)
