+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[list[tuple[int, int]], bool]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_border = False
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append((coords, touches_border))
+    return comps
+
+
+def _peel_layers(mask: np.ndarray) -> list[np.ndarray]:
+    current = mask.astype(bool).copy()
+    layers: list[np.ndarray] = []
+    while np.any(current):
+        padded = np.pad(current, 1, constant_values=False)
+        interior = (
+            current
+            & padded[:-2, 1:-1]
+            & padded[2:, 1:-1]
+            & padded[1:-1, :-2]
+            & padded[1:-1, 2:]
+        )
+        boundary = current & ~interior
+        layers.append(boundary)
+        current = interior
+    return layers
+
+
+def _layer_count(mask: np.ndarray) -> int:
+    return len(_peel_layers(mask))
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    if not np.any(mask):
+        return False
+    comps = _components(mask)
+    return len(comps) == 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
