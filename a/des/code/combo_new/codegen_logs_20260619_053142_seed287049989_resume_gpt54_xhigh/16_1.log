+            return mask
+        depth = int(rng.integers(1, min(h - 1, max(2, h // 2 + 1))))
+        span = int(rng.integers(1, w))
+        start = int(rng.integers(0, w - span + 1))
+        rows = slice(0, depth) if side == "top" else slice(h - depth, h)
+        trial[rows, start : start + span] = False
+    else:
