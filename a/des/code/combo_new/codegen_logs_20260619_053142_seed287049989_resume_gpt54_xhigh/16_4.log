+            continue
+        if np.any(coords[:, 1] == 0) or np.any(coords[:, 1] == inv.shape[1] - 1):
+            continue
+        return False
+    return True
+
+
+def _polyomino_masks(max_area: int = 8, max_side: int = 4) -> list[np.ndarray]:
