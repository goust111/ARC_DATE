+        for r0 in range(inner_h - h + 1):
+            for c0 in range(inner_w - w + 1):
+                if not np.any(blocked[r0 : r0 + h, c0 : c0 + w] & slot_mask):
+                    candidates.append((r0, c0))
+        if not candidates:
+            return None
+        r0, c0 = random.choice(candidates)
