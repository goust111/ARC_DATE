CANVAS_SIZE_RANGE = (22, 30)           # canvas H/W range
OBJECT_H_RANGE = (7, 17)               # src/dst object height bounds
OBJECT_W_RANGE = (7, 13)               # src/dst object width bounds

# Cavity structure
