+
+def _draw_frame(grid: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    grid[r0 : r0 + h, c0 : c0 + w] = FRAME_COLOR
+
+    sides = []
+    if c0 >= 2:
