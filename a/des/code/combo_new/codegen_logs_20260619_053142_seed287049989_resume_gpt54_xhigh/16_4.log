+    piece_by_key: dict[tuple[int, int, bytes], dict] = {}
+    for piece in pieces:
+        key = _canonical_rot_key(piece["mask"])
+        assert key not in piece_by_key, "piece shapes must be unique up to rotation"
+        piece_by_key[key] = piece
