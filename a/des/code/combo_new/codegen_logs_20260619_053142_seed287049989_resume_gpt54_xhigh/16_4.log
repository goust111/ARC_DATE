+def _rotate_coords(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    h = max(r for r, _ in coords) + 1
+    w = max(c for _, c in coords) + 1
+    return tuple((w - 1 - c, r) for r, c in coords)
