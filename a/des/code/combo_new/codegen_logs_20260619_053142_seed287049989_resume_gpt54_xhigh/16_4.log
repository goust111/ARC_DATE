+            grid[tab_r : tab_r + tab_h, c0 - tab_w : c0] = FRAME_COLOR
+        elif side == "right":
+            tab_h = random.randint(2, max(2, h - 2))
+            tab_w = random.randint(1, 2)
+            tab_r = random.randint(r0 + 1, r0 + h - tab_h - 1)
+            grid[tab_r : tab_r + tab_h, c0 + w : c0 + w + tab_w] = FRAME_COLOR
+        else:
