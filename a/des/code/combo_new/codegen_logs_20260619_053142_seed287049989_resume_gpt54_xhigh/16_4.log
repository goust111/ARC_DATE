+    min_r0 = max(6, height // 2 - 1)
+    max_r0 = height - mold_h - 2
+    if min_r0 > max_r0:
+        return None
+    mold_r0 = random.randint(min_r0, max_r0)
+    center_c0 = (width - mold_w) // 2
+    mold_c0 = max(1, min(width - mold_w - 1, center_c0 + random.randint(-2, 2)))
+
