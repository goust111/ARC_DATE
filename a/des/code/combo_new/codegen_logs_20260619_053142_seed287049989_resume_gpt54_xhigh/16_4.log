+    return True
+
+
+def _generate_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    height = random.randint(18, 28)
+    width = random.randint(18, 29)
+    dims = _random_frame_dims(height, width)
+    if dims is None:
+        return None
+    mold_h, mold_w = dims
