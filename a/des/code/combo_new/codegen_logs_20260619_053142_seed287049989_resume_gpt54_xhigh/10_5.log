+                "r0": int(rect["r0"]),
+                "c0": int(rect["c0"]),
+                "r1": int(rect["r1"]),
+                "c1": int(rect["c1"]),
+                "direction": str(rect["direction"]),
+                "amount": int(rect["amount"]),
+                "color": int(color),
+            }
+        )
+
+    return grid, arrows
+
