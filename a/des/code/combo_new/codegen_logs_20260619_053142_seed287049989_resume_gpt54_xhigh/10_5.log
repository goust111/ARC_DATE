+    rectangles: list[dict[str, object]] = []
+    arrows: list[dict[str, object]] = []
+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]  # type: ignore[index]
+        area = int(obj["area"])
+        height = int(r1 - r0 + 1)
+        width = int(c1 - c0 + 1)
+        if area == height * width and height >= 2 and width >= 2:
