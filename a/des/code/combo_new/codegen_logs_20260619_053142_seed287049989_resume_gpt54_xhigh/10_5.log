+    grid, arrows = _render_input(h, w, rects, arrow_colors)
+    expected = _expected_output(h, w, rects, arrows)
+    if expected is None:
+        return None
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
