+    }
+    for rect in rects:
+        box = (int(rect["r0"]), int(rect["c0"]), int(rect["r1"]), int(rect["c1"]))
+        if box not in targeted_boxes:
+            out[box[0] : box[2] + 1, box[1] : box[3] + 1] = GRAY
