+def _line_length(g: np.ndarray, start: tuple[int, int], step: tuple[int, int], color: int) -> int:
+    h, w = map(int, g.shape)
+    r, c = start
+    dr, dc = step
+    length = 0
+    while 0 <= r < h and 0 <= c < w and int(g[r, c]) == int(color):
+        length += 1
+        r += dr
+        c += dc
+    return length
