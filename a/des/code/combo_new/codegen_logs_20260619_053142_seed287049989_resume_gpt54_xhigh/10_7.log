+def _gate_options(path: list[tuple[int, int]], idx: int, shape: tuple[int, int]) -> list[int]:
+    h, w = shape
+    path_set = set(path)
+    options: list[int] = []
+    for length in (2, 3):
+        cells = _gate_cells(path, idx, length)
+        if cells is None:
+            continue
+        ok = True
+        for r, c in cells:
+            if not (0 <= r < h and 0 <= c < w):
+                ok = False
+                break
+            if (r, c) in path_set:
+                ok = False
+                break
+        if ok:
+            options.append(length)
+    return options
+
