+def _edge_key(point: tuple[int, int], h: int, w: int) -> tuple[int, int]:
+    r, c = point
+    if r == 0:
+        return (0, c)
+    if c == 0:
+        return (1, r)
+    if r == h - 1:
+        return (2, c)
+    if c == w - 1:
+        return (3, r)
+    return (4, r + c)
