+    ordered = [start]
+    visited = {start}
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
+        next_steps = []
+        for nxt in _orth_neighbors(cur[0], cur[1], h, w):
+            if not bool(mask[nxt[0], nxt[1]]):
+                continue
+            if nxt == prev:
