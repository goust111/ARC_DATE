+    if pc == c == nc:
+        if c == 0 or c == g.shape[1] - 1:
+            return None
+        left = int(g[r, c - 1])
+        right = int(g[r, c + 1])
+        if left != right or left in (BG, PATH_COLOR):
+            return None
+        left_len = _line_length(g, (r, c - 1), (0, -1), left)
+        right_len = _line_length(g, (r, c + 1), (0, 1), left)
+        if left_len in (2, 3) and right_len in (2, 3):
