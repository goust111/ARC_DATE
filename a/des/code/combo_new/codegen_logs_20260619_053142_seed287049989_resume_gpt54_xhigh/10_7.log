+            return None
+        up_len = _line_length(g, (r - 1, c), (-1, 0), up)
+        down_len = _line_length(g, (r + 1, c), (1, 0), up)
+        if up_len in (2, 3) and down_len in (2, 3):
+            return up
+        return None
