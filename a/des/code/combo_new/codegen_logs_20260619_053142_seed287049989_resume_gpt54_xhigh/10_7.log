+
+    endpoints: list[tuple[int, int]] = []
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        nbrs = [(rr, cc) for rr, cc in _orth_neighbors(r, c, h, w) if bool(mask[rr, cc])]
+        assert len(nbrs) in (1, 2), "path must be a simple 4-connected chain"
