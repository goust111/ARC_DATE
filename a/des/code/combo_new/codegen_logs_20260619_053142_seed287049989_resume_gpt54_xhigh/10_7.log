+    south_total_lo = max(south_runs * MIN_SEG_LEN, 8)
+    east_total_lo = max(east_runs * MIN_SEG_LEN, 12)
+    start_row = int(rng.integers(MARGIN, 7))
+    south_total_hi = 26 - start_row
+    if south_total_lo > south_total_hi:
