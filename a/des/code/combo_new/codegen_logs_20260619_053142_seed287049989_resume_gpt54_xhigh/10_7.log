+    if max(h, w) > 30:
+        return None
+    if len(path) < 12:
+        return None
+
+    candidates = []
+    for idx in range(1, len(path) - 1):
+        options = _gate_options(path, idx, shape)
+        if options:
+            candidates.append((idx, options))
+    if len(candidates) < 2:
+        return None
