+def _gate_color_at(g: np.ndarray, path: list[tuple[int, int]], idx: int) -> int | None:
+    if idx <= 0 or idx >= len(path) - 1:
+        return None
+
+    pr, pc = path[idx - 1]
+    r, c = path[idx]
+    nr, nc = path[idx + 1]
+
+    if pr == r == nr:
+        if r == 0 or r == g.shape[0] - 1:
+            return None
+        up = int(g[r - 1, c])
+        down = int(g[r + 1, c])
+        if up != down or up in (BG, PATH_COLOR):
+            return None
+        up_len = _line_length(g, (r - 1, c), (-1, 0), up)
