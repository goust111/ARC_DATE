+            r_a = random.randint(0, max_r0)
+            c_a = random.randint(min_c0, grid_w - w_a)
+            lo = max(0, r_a - h_b + 1)
+            hi = min(grid_h - h_b, r_a + h_a - 1)
+            if lo > hi:
+                continue
+            r_b = random.randint(lo, hi)
+            c_b = c_a - block_step - w_b + 1
+        elif direction == "down":
+            max_r0 = grid_h - (h_a + block_step + h_b)
+            max_c0 = grid_w - w_a
+            if max_r0 < 0:
+                continue
+            r_a = random.randint(0, max_r0)
+            c_a = random.randint(0, max_c0)
