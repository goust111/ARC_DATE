+    r, c = root
+    if direction == "right":
+        return any(cells == {root, (r, c + 1), (r + bend, c + 1)} for bend in (-1, 1))
+    if direction == "left":
+        return any(cells == {root, (r, c - 1), (r + bend, c - 1)} for bend in (-1, 1))
+    if direction == "down":
+        return any(cells == {root, (r + 1, c), (r + 1, c + bend)} for bend in (-1, 1))
+    if direction == "up":
+        return any(cells == {root, (r - 1, c), (r - 1, c + bend)} for bend in (-1, 1))
+    return False
