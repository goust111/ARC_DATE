+            hi = min(grid_w - w_b, c_a + w_a - 1)
+            if lo > hi:
+                continue
+            c_b = random.randint(lo, hi)
+            r_b = r_a + h_a + block_step - 1
+        else:
+            min_r0 = block_step + h_b
+            max_c0 = grid_w - w_a
+            if min_r0 > grid_h - h_a:
