+def _shadow_length(grid: np.ndarray, obj: dict) -> int:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    r0, c0, r1, c1 = obj["r0"], obj["c0"], obj["r1"], obj["c1"]
