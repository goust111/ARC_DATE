+            return False
+
+    grey_components = _components4(grid == GREY)
+    if not grey_components:
+        return False
+    if any(not (2 <= len(comp) <= 6) for comp in grey_components):
+        return False
+
+    union_mask = np.zeros_like(grid, dtype=bool)
+    for rect in rects:
+        union_mask |= _rect_mask(rect, *grid.shape)
+    if not any(any(union_mask[r, c] for r, c in comp) for comp in grey_components):
+        return False
+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return False
+    if not np.any(out != grid):
+        return False
+    return True
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _rect_mask(rect: tuple[int, int, int, int], height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    r0, c0, r1, c1 = rect
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _intersection_mask(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    height: int,
+    width: int,
+) -> np.ndarray | None:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return None
+    return _rect_mask((r0, c0, r1, c1), height, width)
+
+
+def _rect_area(rect: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _rect_overlap_area(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return 0
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _rects_conflict(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0
+) -> bool:
+    return not (
+        a[2] + pad < b[0]
+        or b[2] + pad < a[0]
+        or a[3] + pad < b[1]
+        or b[3] + pad < a[1]
+    )

