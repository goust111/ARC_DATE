+    for area, color, r0, c0, r1, c1 in _pair_rectangles(g):
+        del area
+        region = out[r0 : r1 + 1, c0 : c1 + 1]
+        region_grey = grey_mask[r0 : r1 + 1, c0 : c1 + 1]
+        region[~region_grey] = color
+
+    return out
+
