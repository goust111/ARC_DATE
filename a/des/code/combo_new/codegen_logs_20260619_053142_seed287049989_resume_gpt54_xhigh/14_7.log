+def _random_polyomino(area: int, rng: random.Random) -> tuple[tuple[int, int], ...]:
+    cells = {(0, 0)}
+    while len(cells) < area:
+        frontier = set()
+        for r, c in cells:
+            frontier.update({(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)})
+        frontier.difference_update(cells)
+        cells.add(rng.choice(tuple(frontier)))
