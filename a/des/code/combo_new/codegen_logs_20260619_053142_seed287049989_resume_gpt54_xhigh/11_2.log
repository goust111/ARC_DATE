+        if len(endpoint_colors) != 2 or len(set(endpoint_colors)) != 2 or int(color) in endpoint_colors:
+            return None
+
+        ordered = _order_path(component)
+        start = ordered[0]
+        end = ordered[-1]
+        start_endpoint = [
+            nbr
+            for nbr in _neighbors4(start)
