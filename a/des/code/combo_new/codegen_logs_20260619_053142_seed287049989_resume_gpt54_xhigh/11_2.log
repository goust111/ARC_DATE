+        next_cells = [nbr for nbr in _neighbors4(cur) if nbr in comp_set and nbr != prev]
+        assert len(next_cells) == 1, "path chain must be unambiguous"
+        prev, cur = cur, next_cells[0]
+        ordered.append(cur)
