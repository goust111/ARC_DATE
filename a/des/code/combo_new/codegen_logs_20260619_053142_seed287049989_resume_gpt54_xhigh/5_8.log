+
+
+def _choose_internal_anchors(mask: np.ndarray, anchor_count: int) -> list[tuple[int, int]]:
+    empties = [tuple(map(int, rc)) for rc in np.argwhere(~mask)]
+    assert len(empties) >= anchor_count
