+    return candidates
+
+
+def _l_offsets(turns: int) -> list[tuple[int, int]]:
+    missing = _TURN_TO_MISSING_CORNER[turns % 4]
+    return [
+        (r, c)
+        for r in range(2)
+        for c in range(2)
+        if (r, c) != missing
+    ]
+
+
+def _place_l_marker(
