            rr_off, cc_off = _rotate_offset((dr, dc), turns)
            rr, cc = tr + rr_off, tc + cc_off
            assert 0 <= rr < h and 0 <= cc < w
            if not protected[rr, cc]:
                out[rr, cc] = sprite_color
    return out


