+
+def _has_nontrivial_symmetry(mask: np.ndarray) -> bool:
+    variants = []
+    for rot in range(4):
+        arr = np.rot90(mask, rot)
+        variants.append(arr)
+        variants.append(np.fliplr(arr))
+    original = mask
+    for variant in variants[1:]:
+        if variant.shape == original.shape and np.array_equal(variant, original):
