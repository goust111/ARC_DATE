+
+
+def _feasible_external_anchors(
+    grid_shape: tuple[int, int],
+    offsets: list[tuple[int, int]],
+    forbidden_region: np.ndarray,
+    protected: np.ndarray,
+    occupied_copy: np.ndarray,
+) -> list[tuple[tuple[int, int], list[tuple[int, int]]]]:
