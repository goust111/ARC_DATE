    if max_frame_h < 5 or max_frame_w < 5:
        return None
    frame_h = random.randint(5, max_frame_h)
    frame_w = random.randint(5, max_frame_w)

    frame_r0 = random.randint(4, height - frame_h - 4)
    frame_c0 = random.randint(4, width - frame_w - 4)
