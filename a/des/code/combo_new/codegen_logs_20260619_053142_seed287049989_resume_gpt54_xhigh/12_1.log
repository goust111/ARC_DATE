    frame_color, frame_bbox, gap_side = _find_frame(g, bg)
    arrows = _find_arrows(g, bg, frame_color, frame_bbox)

    out = g.copy()
    for _direction, (_color, pts) in arrows.items():
        out[pts[:, 0], pts[:, 1]] = bg
    _paint_edge(out, frame_bbox, gap_side, arrows[gap_side][0])
