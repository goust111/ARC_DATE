+def _read_legend(top_row: np.ndarray) -> list[int]:
+    colors: list[int] = []
+    in_run = False
+    for value in top_row:
+        color = int(value)
+        if color != BG and not in_run:
+            colors.append(color)
+            in_run = True
+        elif color == BG:
