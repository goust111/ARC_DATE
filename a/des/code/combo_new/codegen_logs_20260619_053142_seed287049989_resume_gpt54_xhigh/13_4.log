+        shape = spec["shape"] + np.array([spec["top"], spec["left"]], dtype=int)
+        grid[shape[:, 0], shape[:, 1]] = color
+
+    if not validate_input(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
