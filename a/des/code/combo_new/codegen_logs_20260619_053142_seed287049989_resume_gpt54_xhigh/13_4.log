+                family = CASE_NAMES[rng.randrange(len(CASE_NAMES) - 1)]
+                walls = WALL_CASES[family][rng.randrange(len(WALL_CASES[family]))]
+                chosen_specs.append({"walls": tuple(walls), "shape": choose_shape(rng)})
+                wall_counts.append(len(walls))
