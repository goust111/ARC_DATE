    out_h = max(h for _, h, _, _ in rects)
    out_w = sum(w for _, _, w, _ in rects) + len(rects) - 1
    out = np.full((out_h, out_w), BG_COLOR, dtype=int)

    c = 0
    for _, h, w, color in rects:
        out[out_h - h :, c : c + w] = color
        c += w + 1

    return out


