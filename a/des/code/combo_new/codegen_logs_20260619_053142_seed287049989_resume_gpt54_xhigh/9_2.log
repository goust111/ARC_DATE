def lmask(h,w,mh,mw,corner):
    m=np.ones((h,w),dtype=np.uint8)
    if corner==0: m[:mh,:mw]=0
    elif corner==1: m[:mh,w-mw:]=0
    elif corner==2: m[h-mh:,:mw]=0
    else: m[h-mh:,w-mw:]=0
    return m

def rot180(m): return m[::-1, ::-1]

def search(a,b):
    out=[]
    for fixed,other in [(a,rot180(b)),(b,rot180(a))]:
      ah,aw=fixed.shape; bh,bw=other.shape
      apts={(int(r),int(c)) for r,c in zip(*np.where(fixed))}
      bpts0=[(int(r),int(c)) for r,c in zip(*np.where(other))]
      for dr in range(-bh-1, ah+2):
        for dc in range(-bw-1, aw+2):
          bpts={(r+dr,c+dc) for r,c in bpts0}
          if apts & bpts: continue
          allpts=list(apts|bpts)
          rs=[r for r,c in allpts]; cs=[c for r,c in allpts]
          h=max(rs)-min(rs)+1; w=max(cs)-min(cs)+1
          if h*w==len(allpts): out.append((h,w,dr,dc))
    return out

