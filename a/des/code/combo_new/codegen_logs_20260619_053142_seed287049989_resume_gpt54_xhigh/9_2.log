    max_common = {2: 8, 3: 7, 4: 6}[pair_count]
    max_outer = {2: 7, 3: 6, 4: 5}[pair_count]

    for _ in range(PAIR_BUILD_ATTEMPTS):
        family = random.choice(("vertical", "horizontal"))
        corner = random.randrange(4)

        if family == "vertical":
            full_w = random.randint(3, max_common)
