        mask_a, mask_b, out_shape = sampled
        area = out_shape[0] * out_shape[1]
        if area in used_areas:
            return None
        used_areas.add(area)
        output_rects.append(out_shape)
        pieces.append((mask_a, color))
        pieces.append((mask_b, color))

