    keep_left = random.randint(0, min(PAD_KEEP_MAX, c0))
    keep_right = random.randint(0, min(PAD_KEEP_MAX, TEMP_CANVAS - 1 - c1))

    return grid[r0 - keep_top : r1 + keep_bottom + 1, c0 - keep_left : c1 + keep_right + 1]


