+        r0, c0, r1, c1 = obj["bbox"]
+        height = int(r1 - r0 + 1)
+        width = int(c1 - c0 + 1)
+        horizontal = width >= height
+
+        for r, c in obj["coords"]:
+            offset = int(r - r0) if horizontal else int(c - c0)
+            if (offset // length) % 2 == 1:
+                out[r, c] = GREY
+
+    return out
+
