+    assert len(adj_dirs) == 1, "strip-object adjacency must indicate a unique side"
+    dr, dc = next(iter(adj_dirs))
+    proj = (-dr, -dc)
+    direction = next(name for name, vec in VECTORS.items() if vec == proj)
+    return obj_color, direction
