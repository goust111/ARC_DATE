+def _erode4(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    result = set()
+    for r, c in cells:
+        if all((r + dr, c + dc) in cells for dr, dc in DIR4):
+            result.add((r, c))
+    return result
