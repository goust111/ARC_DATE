+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    h, w = g.shape
+
+    bg = _background_color(g)
+    shadow = _find_shadow_color(g, bg)
+    object_by_color = _object_components(g, bg, shadow)
