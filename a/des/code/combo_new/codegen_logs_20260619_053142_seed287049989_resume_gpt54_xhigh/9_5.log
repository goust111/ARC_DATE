+
+def _dilate_square(cells: set[tuple[int, int]], radius: int) -> set[tuple[int, int]]:
+    if radius <= 0:
+        return set(cells)
+    out = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                out.add((r + dr, c + dc))
+    return out
