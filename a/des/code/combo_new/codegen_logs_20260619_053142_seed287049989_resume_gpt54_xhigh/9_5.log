+    h, w = grid.shape
+    for r, c in comp:
+        for dr, dc in DIR4:
+            rr = int(r + dr)
+            cc = int(c + dc)
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            color = int(grid[rr, cc])
+            if color in (bg, shadow):
