+    (".##", "###", "##."),
+    ("####", "####", "###.", "##.."),
+    (".###", "####", "###.", "##.."),
+    ("####", "###.", "####", "..##"),
+    ("#####", "#####", "####.", "###..", "..##."),
+    (".####", "#####", "####.", "###..", ".##.."),
+    ("####.", "#####", ".####", ".###.", "..##."),
