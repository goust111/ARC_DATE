+
+        seed_colors = [int(g[r, c]) for r, c in seeds]
+        if len(set(seed_colors)) != len(seed_colors):
+            return False
+
+        counts = {quad: 0 for quad in QUADRANT_RULES}
+        for r, c in seeds:
