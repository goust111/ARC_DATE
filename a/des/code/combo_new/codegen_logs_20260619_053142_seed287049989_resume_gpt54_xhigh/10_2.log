def _find_cross(grid: np.ndarray) -> tuple[int, int, int]:
    h, w = grid.shape
    row_candidates: list[tuple[int, int]] = []
    col_candidates: list[tuple[int, int]] = []

    for r in range(h):
        color = int(grid[r, 0])
