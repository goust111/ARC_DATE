+        if not np.array_equal(main(g), out):
+            return False
+        return True
+    except Exception:
+        return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randrange(12, 31, 2)
+    w = random.randrange(12, 31, 2)
+    grid = np.full((h, w), BG, dtype=int)
+
+    mid_r = h // 2
+    mid_c = w // 2
+    grid[mid_r, :] = GREEN
+    grid[:, mid_c] = GREEN
+
+    quadrants = ["ul", "ur", "ll", "lr"]
