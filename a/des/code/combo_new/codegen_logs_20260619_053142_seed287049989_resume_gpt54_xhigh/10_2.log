+    assert g.ndim == 2, "expected a 2D grid"
+    green, mid_r, mid_c = _find_cross(g)
+
+    out = g.copy()
+    h, w = out.shape
+    seeds = sorted(
+        [
+            (int(r), int(c))
+            for r, c in np.argwhere((out != BG) & (out != green))
+        ]
+    )
+
