        if any(count not in (1, 2) for count in counts.values()):
            return False
        if sum(count == 2 for count in counts.values()) < 1:
            return False

        out, bends = _simulate(g, return_bends=True)
        if bends < 1:
            return False
        if np.array_equal(out, g):
            return False
        if not np.array_equal(main(g), out):
            return False
        return True
    except Exception:
