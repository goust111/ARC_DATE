+    return None
+
+
+def _letter_margin_ok(letter_bbox: BBox, env_bbox: BBox, direction: Direction) -> bool:
+    lr0, lc0, lr1, lc1 = letter_bbox
+    er0, ec0, er1, ec1 = env_bbox
