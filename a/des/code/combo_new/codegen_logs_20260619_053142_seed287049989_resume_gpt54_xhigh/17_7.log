+
+
+def _translated_coords(coords: np.ndarray, bbox: BBox, direction: Direction, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    if direction == "up":
+        dr, dc = -r0, 0
+    elif direction == "down":
+        dr, dc = h - 1 - r1, 0
+    elif direction == "left":
+        dr, dc = 0, -c0
+    elif direction == "right":
+        dr, dc = 0, w - 1 - c1
+    else:
+        raise ValueError(direction)
+    return coords + np.array([dr, dc], dtype=int)
+
