+
+
+def _is_solid_rectangle(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    return int(component["area"]) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _expected_u_cells(bbox: BBox, direction: Direction) -> set[tuple[int, int]]:
