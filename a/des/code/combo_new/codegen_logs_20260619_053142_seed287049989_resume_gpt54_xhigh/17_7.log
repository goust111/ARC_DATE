+
+def _build_u_patch(height: int, width: int, direction: Direction, color: int, bg: int) -> np.ndarray:
+    patch = np.full((height, width), bg, dtype=int)
+    if direction == "up":
+        patch[-1, :] = color
+        patch[1:, 0] = color
+        patch[1:, -1] = color
+    elif direction == "down":
+        patch[0, :] = color
+        patch[:-1, 0] = color
+        patch[:-1, -1] = color
+    elif direction == "left":
+        patch[:, -1] = color
+        patch[0, 1:] = color
+        patch[-1, 1:] = color
+    elif direction == "right":
