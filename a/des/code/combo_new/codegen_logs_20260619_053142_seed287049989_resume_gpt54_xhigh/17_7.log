+
+def _expand_rect(r0: int, c0: int, r1: int, c1: int, pad: int, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
