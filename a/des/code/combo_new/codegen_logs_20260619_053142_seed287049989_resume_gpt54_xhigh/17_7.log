+    er0, ec0, er1, ec1 = env_bbox
+
+    if not (er0 < lr0 and lr1 < er1 and ec0 < lc0 and lc1 < ec1):
+        return False
+    if direction != "up" and lr0 < er0 + 2:
+        return False
+    if direction != "down" and lr1 > er1 - 2:
+        return False
+    if direction != "left" and lc0 < ec0 + 2:
+        return False
+    if direction != "right" and lc1 > ec1 - 2:
+        return False
