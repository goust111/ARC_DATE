+_GEN_MAX_ATTEMPTS = 400
+_GEN_DIRECTIONS = ("up", "down", "left", "right")
+_GEN_BG_CHOICES = tuple(range(10))
+_GEN_MIN_SIZE = 20
+_GEN_MAX_SIZE = 30
+_GEN_ENV_COUNT_RANGE = (1, 4)
+_GEN_OUTER_SIDE_RANGE = (5, 11)
+_GEN_LETTER_SIDE_MAX = 4
+_GEN_NOISE_MAX = 3
