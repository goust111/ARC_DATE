+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+
+    return components
+
+
+def _component_cells(component: dict) -> set[tuple[int, int]]:
+    return set(map(tuple, component["coords"]))
+
+
+def _is_solid_rectangle(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    return int(component["area"]) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _expected_u_cells(bbox: BBox, direction: Direction) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
