+        )
+
+        mask = block == GREY
+        # The keyed pixel names the border color and also occupies one tile cell.
+        mask[0, 1] = True
+        mapping[key] = mask
+        r += 4
+
+    assert mapping, "right legend must contain at least one pattern"
+    return mapping
+
