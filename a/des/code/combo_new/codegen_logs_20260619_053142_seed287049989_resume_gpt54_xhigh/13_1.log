+        else:
+            return None
+
+    rng.shuffle(placed)
+    return placed
+
+
+def _sample_frame_sizes(rng: random.Random, num_frames: int) -> list[tuple[int, int]]:
+    sizes = [(rng.randint(5, 8), rng.randint(5, 9)) for _ in range(num_frames)]
