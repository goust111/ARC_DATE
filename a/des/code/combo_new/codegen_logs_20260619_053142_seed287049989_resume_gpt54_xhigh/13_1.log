+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+
+    patch = area[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if not np.all(patch[border] == color):
+        return None
+    if np.any(patch[~border] == color):
+        return None
+    if int(coords.shape[0]) != int(border.sum()):
+        return None
+    return r0, c0, r1, c1
