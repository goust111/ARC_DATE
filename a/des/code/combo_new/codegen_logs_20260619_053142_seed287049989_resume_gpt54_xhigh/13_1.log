+def _draw_pattern_legend(grid: np.ndarray, top: int, left: int, border_color: int, mask: np.ndarray) -> None:
+    block = np.full((3, 3), BG, dtype=int)
+    block[mask] = GREY
+    block[0, 1] = border_color
+    grid[top : top + 3, left : left + 3] = block
+
+
