+    pattern_masks = rng.sample(list(PATTERN_LIBRARY), num_frames)
+
+    grid = np.full((main_h + 2, main_w + 3), BG, dtype=int)
+
+    for (top, left, height, width), border_color, marker_color in zip(
+        placements, border_colors, marker_assignment
+    ):
