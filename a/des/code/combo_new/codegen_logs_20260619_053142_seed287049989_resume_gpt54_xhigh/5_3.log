+ARROW_NEIGHBORS = {
+    "U": {(-1, 0), (0, -1), (0, 1)},
+    "R": {(0, 1), (-1, 0), (1, 0)},
+    "D": {(1, 0), (0, -1), (0, 1)},
+    "L": {(0, -1), (-1, 0), (1, 0)},
