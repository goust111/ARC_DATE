+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIRS = ("U", "R", "D", "L")
+STEP = {"U": (-1, 0), "R": (0, 1), "D": (1, 0), "L": (0, -1)}
+ROT_K = {"U": 0, "R": 3, "D": 2, "L": 1}  # np.rot90 k-values (counter-clockwise)
+ARROW_NEIGHBORS = {
+    "U": {(-1, 0), (0, -1), (0, 1)},
+    "R": {(0, 1), (-1, 0), (1, 0)},
+    "D": {(1, 0), (0, -1), (0, 1)},
+    "L": {(0, -1), (-1, 0), (1, 0)},
+}
+PATTERN_SHAPES = ((3, 3), (3, 5), (5, 3), (5, 5))
+SIDES = ("L", "R", "U", "D")
+MAX_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = np.min(coords, axis=0)
+    r1, c1 = np.max(coords, axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": _bbox(arr),
+                }
+            )
+    return components
+
+
+def _arrow_from_component(comp: dict) -> dict | None:
+    if int(comp["area"]) != 4:
+        return None
+    cells = {tuple(map(int, rc)) for rc in comp["coords"]}
+    degrees = {}
+    for cell in cells:
+        r, c = cell
+        deg = 0
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            if (r + dr, c + dc) in cells:
+                deg += 1
+        degrees[cell] = deg
+    centers = [cell for cell, deg in degrees.items() if deg == 3]
+    if len(centers) != 1:
+        return None
+    center = centers[0]
+    cr, cc = center
+    nbrs = {(r - cr, c - cc) for r, c in cells if (r, c) != center}
+    for direction, offsets in ARROW_NEIGHBORS.items():
+        if nbrs == offsets:
+            return {"color": int(comp["color"]), "center": center, "dir": direction}
+    return None
+
+
+def _crop_component(grid: np.ndarray, comp: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    color = int(comp["color"])
+    for r, c in comp["coords"]:
