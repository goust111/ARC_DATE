+    used_rows = {r for r, _ in centers}
+    used_cols = {c for _, c in centers}
+    cr, cc = current
+    min_sep = 2 * radius + 3
+    candidates = []
+
+    if direction == "U":
+        positions = [(r, cc) for r in range(cr - min_sep, radius - 1, -1)]
+    elif direction == "D":
+        positions = [(r, cc) for r in range(cr + min_sep, height - radius)]
+    elif direction == "L":
