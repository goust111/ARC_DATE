+        patches.append(patch)
+
+    boxes = []
+    for patch in patches:
+        ph, pw = patch.shape
+        placed = False
+        for _ in range(200):
+            r0 = int(RNG.integers(0, canvas_h - ph + 1))
+            c0 = int(RNG.integers(0, canvas_w - pw + 1))
+            box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if any(_boxes_overlap(box, other, pad=2) for other in boxes):
