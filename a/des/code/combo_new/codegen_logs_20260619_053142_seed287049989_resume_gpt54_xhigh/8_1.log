+
+def _normalize(coords) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    arr = arr - arr.min(axis=0)
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
