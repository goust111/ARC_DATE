+    for flip in (False, True):
+        arr = base_arr.copy()
+        if flip:
+            arr[:, 1] *= -1
+        for _ in range(4):
+            arr = np.stack([arr[:, 1], -arr[:, 0]], axis=1)
+            norm = _normalize(arr)
+            variants[tuple(map(tuple, norm.tolist()))] = norm
+    return list(variants.values())
