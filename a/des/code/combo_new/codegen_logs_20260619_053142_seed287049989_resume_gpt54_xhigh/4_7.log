+from __future__ import annotations
+
+from collections import deque
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+OBJECT_COLORS = (3, 4, 5, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+TEMP_SIDE = 30
+GENERATION_ATTEMPTS = 500
+PLACEMENT_ATTEMPTS = 250
+PADDING = 1
+RNG = np.random.default_rng()
