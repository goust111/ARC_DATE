+    coords = [
+        (0, 0),
+        (final_h - 1, final_w - 1),
+        (original_bbox[0], original_bbox[1]),
+        (original_bbox[2], original_bbox[3]),
+        (bar_bbox[0], bar_bbox[1]),
+        (bar_bbox[2], bar_bbox[3]),
