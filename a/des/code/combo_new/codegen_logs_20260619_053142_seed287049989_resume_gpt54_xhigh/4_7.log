            candidates.append(("bottom", idx))
    if c0 > 0:
        for idx in sorted(set(map(int, labels[r0 : r1 + 1, c0 - 1])) - {0}):
            candidates.append(("left", idx))
    if c1 + 1 < labels.shape[1]:
