+    _RNG.shuffle(kinds)
+    return kinds
+
+
+def _sample_rect_dims(kind: str, stripe_width: int, height: int, width: int) -> tuple[int, int] | None:
+    if kind == "wide":
+        rect_h_lo = int(stripe_width + 1)
