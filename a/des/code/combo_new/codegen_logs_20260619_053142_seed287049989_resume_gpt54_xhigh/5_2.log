+
+
+# --------------- generator ---------------
+
+COLOR_VALUES = tuple(range(10))
+ARC_MAX = 30
+RECT_COUNT_RANGE = (2, 4)
+RECT_H_RANGE = (2, 5)
+RECT_W_RANGE = (3, 7)
+RECT_AREA_MIN = 8
+RECT_AREA_MAX = 20
+OUTPUT_GAP = 1
+INPUT_H_RANGE = (14, 24)
+INPUT_W_RANGE = (16, 30)
+PARTITION_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 80
+GENERATION_ATTEMPTS = 300
