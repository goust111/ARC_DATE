+
+def _grow_connected_mask(h: int, w: int, area: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    seed = (random.randrange(h), random.randrange(w))
+    mask[seed] = True
+    while int(mask.sum()) < area:
