+
+def _compose_scene(specs: list[dict[str, object]], bg: int) -> tuple[np.ndarray, np.ndarray] | None:
+    grid_h = random.randint(*GRID_SIDE_RANGE)
+    grid_w = random.randint(*GRID_SIDE_RANGE)
