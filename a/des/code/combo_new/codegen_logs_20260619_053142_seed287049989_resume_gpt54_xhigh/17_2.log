+            template_pixels[coords[:, 0], coords[:, 1]] = True
+            templates.append(
+                {
+                    "color": int(color),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "hole_mask": hole_mask,
+                    "area": int(hole.sum()),
+                }
+            )
+    return templates, template_pixels
