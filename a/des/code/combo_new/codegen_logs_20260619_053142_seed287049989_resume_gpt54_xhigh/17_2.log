+def _mask_to_patch(mask: np.ndarray, fg: int, bg: int) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    patch[coords[:, 0] - r0, coords[:, 1] - c0] = int(fg)
+    return patch
