+def _has_interior_void(mask: np.ndarray) -> bool:
+    bg = ~mask
+    height, width = map(int, mask.shape)
+    for comp in _components(bg):
+        rs = comp[:, 0]
+        cs = comp[:, 1]
+        touches_edge = (
+            int(rs.min()) == 0
+            or int(rs.max()) == height - 1
+            or int(cs.min()) == 0
+            or int(cs.max()) == width - 1
+        )
+        if not touches_edge:
+            return True
+    return False
