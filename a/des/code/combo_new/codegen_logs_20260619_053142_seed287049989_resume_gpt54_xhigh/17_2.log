+# --------------- generator helpers ---------------
+
+
+GENERATION_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 120
+LAYOUT_ATTEMPTS = 120
+GRID_SIDE_RANGE = (20, 30)
+TEMPLATE_COUNT_OPTIONS = (2, 3)
+HOLE_H_RANGE = (3, 5)
+HOLE_W_RANGE = (3, 6)
+HOLE_AREA_RANGE = (5, 12)
+TEMPLATE_MARGIN_OPTIONS = (1, 2)
+PIECE_COUNT_OPTIONS = (2, 3, 4)
+PLACE_GAP = 1
