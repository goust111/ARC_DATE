+    max_outer_h = max(int(spec["outer_h"]) for spec in specs)
+    max_outer_w = max(int(spec["outer_w"]) for spec in specs)
+    min_h = max(GRID_MIN, max_outer_h + 2)
+    min_w = max(GRID_MIN, max_outer_w + 2)
+    if min_h > GRID_MAX or min_w > GRID_MAX:
