+
+
+def _place_rooms(specs: list[dict[str, object]], h: int, w: int) -> bool:
+    occupied = np.zeros((h, w), dtype=bool)
+    order = sorted(range(len(specs)), key=lambda i: int(specs[i]["outer_h"]) * int(specs[i]["outer_w"]), reverse=True)
+
+    for idx in order:
