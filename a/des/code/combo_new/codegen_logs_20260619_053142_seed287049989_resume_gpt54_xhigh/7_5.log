        if col_inside and not row_inside:
            col_rows = np.where(pattern_mask[:, int(mc)])[0]
            out[col_rows, int(mc)] = marker_color
        elif row_inside and not col_inside:
            row_cols = np.where(pattern_mask[int(mr), :])[0]
