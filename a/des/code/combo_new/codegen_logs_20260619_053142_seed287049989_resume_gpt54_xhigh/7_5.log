+    row = random.randint(0, r0 - 1) if vertical_side == "above" else random.randint(r1 + 1, panel_h - 1)
+    col = random.randint(0, c0 - 1) if horizontal_side == "left" else random.randint(c1 + 1, panel_w - 1)
