+SHAPE_RETRIES = 200
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PAIR_MARKER_CHOICES = (("V", "H"), ("V", "D"), ("H", "D"))
+
+
+def _mode(values: np.ndarray) -> int:
+    counts = Counter(map(int, np.asarray(values).ravel()))
+    assert counts, "expected at least one value"
