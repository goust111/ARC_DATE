+    r0, c0, r1, c1 = bbox_rc
+
+    for mr, mc in markers:
+        row_inside = r0 <= mr <= r1
+        col_inside = c0 <= mc <= c1
+        if col_inside and not row_inside:
+            rows = np.where(pattern_mask[:, mc])[0]
+            expected[rows, mc] = marker_color
+        elif row_inside and not col_inside:
+            cols = np.where(pattern_mask[mr, :])[0]
