+    for color in np.unique(g):
+        full_rows = np.where(np.all(g == int(color), axis=1))[0]
+        full_cols = np.where(np.all(g == int(color), axis=0))[0]
+        if full_rows.size != 1 or full_cols.size != 1:
+            continue
