+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+SHAPE_SIZE_MIN = 3
+SHAPE_SIZE_MAX = 5
+PANEL_SIZE_MIN = 8
+PANEL_SIZE_MAX = 14
