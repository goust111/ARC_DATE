+
+def _random_template(rng: np.random.Generator, h: int, w: int) -> np.ndarray:
+    palette = list(map(int, rng.choice(STAMP_COLORS, size=int(rng.integers(1, 4)), replace=False)))
+    for _ in range(120):
+        patch = np.zeros((h, w), dtype=int)
