+FRAME_COLOR = 3
+SEED_COLOR = 2
+STAMP_COLORS = (1, 4, 5, 6, 7, 8, 9)
+
+TEMPLATE_COUNT_RANGE = (3, 6)
+TEMPLATE_H_RANGE = (3, 7)
+TEMPLATE_W_RANGE = (3, 6)
