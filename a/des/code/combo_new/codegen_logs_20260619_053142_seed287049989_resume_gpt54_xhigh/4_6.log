+    for frame_bbox in frames:
+        r0, c0, r1, c1 = frame_bbox
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        anchor_r, anchor_c, count = _seed_anchor(interior, seed_color)
+        _ = (anchor_r, anchor_c)
