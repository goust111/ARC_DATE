+
+def _region_spec(
+    rng: np.random.Generator,
+    template: np.ndarray,
+    count: int,
+    want_clipped: bool,
+) -> dict[str, object]:
+    th, tw = map(int, template.shape)
+    for _ in range(160):
+        inner_h = int(rng.integers(*FRAME_INNER_H_RANGE))
+        inner_w = int(rng.integers(*FRAME_INNER_W_RANGE))
+        if inner_h * inner_w < count:
