+    local = np.zeros((h, w), dtype=bool)
+    shifted = coords - np.array([r0, c0], dtype=int)
+    local[shifted[:, 0], shifted[:, 1]] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if np.array_equal(local, border):
+        return (r0, c0, r1, c1)
+    return None
