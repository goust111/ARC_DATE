+        rr = anchor_r + int(tr) - center_r
+        cc = anchor_c + int(tc) - center_c
+        if 0 <= rr < interior.shape[0] and 0 <= cc < interior.shape[1]:
+            interior[rr, cc] = int(template[int(tr), int(tc)])
