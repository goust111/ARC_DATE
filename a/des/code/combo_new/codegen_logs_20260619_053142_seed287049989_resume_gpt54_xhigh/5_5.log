+def _count_components(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
