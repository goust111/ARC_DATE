+def _orbits_for_type(size: int, sym_type: str) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    orbits: list[list[tuple[int, int]]] = []
+    for r in range(size):
+        for c in range(size):
+            if sym_type == "both":
+                pts = {
+                    (r, c),
+                    (size - 1 - r, c),
+                    (r, size - 1 - c),
+                    (size - 1 - r, size - 1 - c),
+                }
+            elif sym_type == "h":
+                pts = {(r, c), (size - 1 - r, c)}
+            elif sym_type == "v":
+                pts = {(r, c), (r, size - 1 - c)}
+            else:
+                pts = {(r, c)}
+            key = tuple(sorted(pts))
+            if key not in seen:
+                seen.add(key)
+                orbits.append(list(key))
+    return orbits
+
