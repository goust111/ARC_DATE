    """Paint the same full edge bar in the input and expected output grids."""
    h, w = g.shape
    edge_index = {
        "top": (0, slice(None)),
        "bottom": (h - 1, slice(None)),
        "left": (slice(None), 0),
        "right": (slice(None), w - 1),
