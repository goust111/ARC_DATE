+    grid, placed = placed_scene
+
+    reserved = np.zeros_like(grid, dtype=bool)
+    for idx, obj in enumerate(placed):
+        candidates = _arrow_candidates(grid, obj["bbox"], obj["holes"], reserved)
+        if not candidates:
+            return None
+        arrow = rng.choice(candidates)
