+                    r = rng.randint(min(height - 3, (height + 1) // 2), height - 3)
+                    cells = {(rr, c) for rr in range(r + 1, height - 1)} | {(r, c - 1), (r, c + 1), (r - 1, c)}
+                elif side == "W":
+                    r = rng.randint(2, height - 3)
+                    c = rng.randint(2, max(2, width // 2 - 1))
+                    cells = {(r, cc) for cc in range(1, c)} | {(r - 1, c), (r + 1, c), (r, c + 1)}
