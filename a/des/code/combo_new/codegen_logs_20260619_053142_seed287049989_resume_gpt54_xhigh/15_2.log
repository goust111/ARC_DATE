+    for c in range(max(1, c0), min(w - 2, c1) + 1):
+        upper = min(h - 2, h - 1 - line_len)
+        for tip_r in range(r1 + 1, upper + 1):
+            tip = (tip_r, c)
+            pixels = {(tip_r, c), (tip_r + 1, c - 1), (tip_r + 1, c + 1)}
