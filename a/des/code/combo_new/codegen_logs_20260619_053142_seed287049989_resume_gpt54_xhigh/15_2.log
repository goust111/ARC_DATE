+            pixels = {(tip_r, c), (tip_r - 1, c - 1), (tip_r - 1, c + 1)}
+            tail = {(tip_r - step, c) for step in range(1, line_len + 1)}
+            reserve = pixels | tail | {(rr, c) for rr in range(tip_r + 1, r0)}
