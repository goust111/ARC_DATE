+def _color_component_count(patch: np.ndarray, color: int) -> int:
+    comps = _find_components(patch, connectivity=4, bg=BG)
+    return sum(1 for comp in comps if int(comp["color"]) == color)
+
+
+def _build_object_patch(height: int, width: int, color: int, hole_count: int, rng: random.Random) -> np.ndarray | None:
+    assert height >= 7 and width >= 7
+    for _ in range(OBJECT_BUILD_RETRIES):
+        patch = np.zeros((height, width), dtype=int)
+        patch[0, :] = color
+        patch[-1, :] = color
+        patch[:, 0] = color
+        patch[:, -1] = color
+
+        ok = True
+        for _hole_idx in range(hole_count):
+            candidates: list[set[tuple[int, int]]] = []
+            for r in range(2, height - 2):
+                for c in range(2, width - 2):
+                    if int(patch[r, c]) != BG:
+                        continue
+                    templates = {
+                        "N": {(rr, c) for rr in range(1, r)} | {(r, c - 1), (r, c + 1), (r + 1, c)},
+                        "S": {(rr, c) for rr in range(r + 1, height - 1)} | {(r, c - 1), (r, c + 1), (r - 1, c)},
+                        "W": {(r, cc) for cc in range(1, c)} | {(r - 1, c), (r + 1, c), (r, c + 1)},
+                        "E": {(r, cc) for cc in range(c + 1, width - 1)} | {(r - 1, c), (r + 1, c), (r, c - 1)},
+                    }
+                    for cells in templates.values():
+                        if not cells:
+                            continue
+                        if any(int(patch[rr, cc]) != BG for rr, cc in cells):
+                            continue
