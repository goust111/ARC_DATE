+    frozenset({(0, 1), (1, 0), (2, 1)}): ((1, 0), (0, -1)),  # <
+    frozenset({(0, 1), (1, 0), (1, 2)}): ((0, 1), (-1, 0)),  # ^
+    frozenset({(0, 0), (0, 2), (1, 1)}): ((1, 1), (1, 0)),   # v
