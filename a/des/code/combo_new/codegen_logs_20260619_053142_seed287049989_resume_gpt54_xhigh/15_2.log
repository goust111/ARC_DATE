+                    c = rng.randint(3, max(3, width // 2 - 1))
+                    cells = {
+                        (rr, cc)
+                        for rr in range(r - 1, r + 2)
+                        for cc in range(c - 1, c + 2)
+                        if not (rr == r and cc == c)
+                    } | {(r, cc) for cc in range(1, c - 1)}
+                else:
