+    grid_h = rng.randint(max(GRID_MIN, 6 + 5 * num_objects), GRID_MAX)
+    grid_w = rng.randint(max(GRID_MIN, 6 + 5 * num_objects), GRID_MAX)
+    placed_scene = _place_objects(grid_h, grid_w, specs, rng)
