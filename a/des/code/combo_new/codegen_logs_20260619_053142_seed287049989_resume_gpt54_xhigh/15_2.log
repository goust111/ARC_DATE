+        min_size = max(OBJECT_SIZE_RANGE[0], 7 + holes // 2)
+        height = rng.randint(min_size, OBJECT_SIZE_RANGE[1])
+        width = rng.randint(min_size, OBJECT_SIZE_RANGE[1])
