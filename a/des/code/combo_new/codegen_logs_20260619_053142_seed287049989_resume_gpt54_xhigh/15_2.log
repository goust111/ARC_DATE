+    elif (dr, dc) == (0, -1):
+        wings = [(tip_r - 1, tip_c + 1), (tip_r + 1, tip_c + 1)]
+    elif (dr, dc) == (1, 0):
+        wings = [(tip_r - 1, tip_c - 1), (tip_r - 1, tip_c + 1)]
+    else:
+        wings = [(tip_r + 1, tip_c - 1), (tip_r + 1, tip_c + 1)]
+    for wr, wc in wings:
+        grid[wr, wc] = color
