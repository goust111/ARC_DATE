+def _find_target_object(
+    grid: np.ndarray,
+    tip: tuple[int, int],
+    forward: tuple[int, int],
+    cell_to_object: dict[tuple[int, int], int],
+) -> int:
+    h, w = grid.shape
+    r, c = tip
+    dr, dc = forward
