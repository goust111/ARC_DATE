+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for attempt in range(GEN_ATTEMPTS):
+        rng = random.Random(random.randrange(1 << 30) ^ attempt)
+        grid = _generate_attempt(rng)
+        if grid is None:
+            continue
+        try:
