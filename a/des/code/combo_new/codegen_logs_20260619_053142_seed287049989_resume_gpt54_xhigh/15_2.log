+    rng.shuffle(palette)
+    if num_objects >= 3 and rng.random() < 0.4:
+        base = palette[: num_objects - 1]
+        colors = [rng.choice(base) for _ in range(num_objects)]
+        if len(set(colors)) == num_objects:
+            colors[-1] = colors[0]
+        return colors
+    return palette[:num_objects]
