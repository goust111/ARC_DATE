+    elif (dr, dc) == (0, -1):
+        wings = [(tip_r - 1, tip_c + 1), (tip_r + 1, tip_c + 1)]
+    elif (dr, dc) == (1, 0):
+        wings = [(tip_r - 1, tip_c - 1), (tip_r - 1, tip_c + 1)]
+    else:
+        wings = [(tip_r + 1, tip_c - 1), (tip_r + 1, tip_c + 1)]
+    for wr, wc in wings:
+        grid[wr, wc] = color
+
+
+def _choose_object_colors(num_objects: int, rng: random.Random) -> list[int]:
+    palette = list(range(1, 10))
+    rng.shuffle(palette)
+    if num_objects >= 3 and rng.random() < 0.4:
