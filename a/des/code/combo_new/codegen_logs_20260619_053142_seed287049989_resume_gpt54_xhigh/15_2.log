+            continue
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        if out.shape != grid.shape:
+            continue
+        arrows, objects, _mapping, hole_counts = _extract_scene(grid)
+        if len(arrows) != len(objects) or not arrows:
+            continue
+        if any(not (0 <= count <= 4) for count in hole_counts):
