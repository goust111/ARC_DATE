+                        "S": {(rr, c) for rr in range(r + 1, height - 1)} | {(r, c - 1), (r, c + 1), (r - 1, c)},
+                        "W": {(r, cc) for cc in range(1, c)} | {(r - 1, c), (r + 1, c), (r, c + 1)},
+                        "E": {(r, cc) for cc in range(c + 1, width - 1)} | {(r - 1, c), (r + 1, c), (r, c - 1)},
