+    rel = frozenset((r - r0, c - c0) for r, c in coords)
+    pattern = ARROW_PATTERNS.get(rel)
+    if pattern is None:
+        return None
+    tip_rel, forward = pattern
+    return (r0 + tip_rel[0], c0 + tip_rel[1]), forward
