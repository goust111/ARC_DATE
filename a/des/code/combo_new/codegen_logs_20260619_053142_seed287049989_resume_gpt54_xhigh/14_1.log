+        grey_coords = []
+        hole_coords = []
+        ph, pw = patch.shape
+        for rr in range(ph):
+            for cc in range(pw):
+                if patch[rr, cc] == GREY:
+                    grey_coords.append((r0 + rr, c0 + cc))
+                elif hole_mask[rr, cc]:
