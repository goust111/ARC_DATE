0087:     target_hi = [tr1, tc1]
0088: 
0089:     source_perp_len = source_hi[perp] - source_lo[perp] + 1
0090:     assert source_perp_len == 2, "moving object path must be two cells wide"
0091:     assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]
0092:     assert (
0093:         source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]
0094:     ), "moving object must be centered across the target"
0095: 
0096:     out = g.copy()
