+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    if len(_components(grid[:, :body_w] == GREY)) != region_count:
+        return None
+    if not np.array_equal(actual[:, body_w + 1 :], grid[:, body_w + 1 :]):
