+
+
+def _place_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray) -> tuple[int, int] | None:
+    h, w = patch.shape
+    gh, gw = grid.shape
+    positions = [(r, c) for r in range(gh - h + 1) for c in range(gw - w + 1)]
+    random.shuffle(positions)
+    for r, c in positions:
+        r0 = max(0, r - 1)
+        c0 = max(0, c - 1)
