0025: def main(grid: np.ndarray) -> np.ndarray:
0026:     """
0027:     Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.
0028: 
0029:     Input structure
0030:     - The background is the dominant color.
0031:     - There are exactly three monochrome foreground objects arranged on one
0032:       horizontal or vertical axis.
0033:     - The middle object on that axis is a solid rectangular moving object.
0034:     - One end object is a solid rectangle or bar whose long side is perpendicular
0035:       to the movement axis; this is the target to split.
0036: 
0037:     Rule
0038:     - Move the middle rectangle along the axis toward the target until it is
0039:       flush with the grid edge in that direction.
0040:     - Clear the original middle rectangle and the original target.
0041:     - Split the target through the moving rectangle's two-cell-wide path and
0042:       shift the two halves one cell outward perpendicular to the movement.
0043:     - Keep the other end object unchanged.
0044: 
0045:     Key insight
0046:     - The non-target end object acts as a pusher; the central rectangle travels
0047:       away from it through the perpendicular target, opening a matching gap.
0048:     """
0049:     g = np.asarray(grid, dtype=int)
0050:     bg = get_bg(g)
0051:     H, W = g.shape
0052: 
0053:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0054:     assert len(objects) == 3, "expected exactly three foreground objects"
0055: 
0056:     row_centers = [_center(obj, 0) for obj in objects]
0057:     col_centers = [_center(obj, 1) for obj in objects]
0058:     row_spread = max(row_centers) - min(row_centers)
0059:     col_spread = max(col_centers) - min(col_centers)
0060:     assert min(row_spread, col_spread) <= 0.5, "objects must share a row or column axis"
0061:     axis = 0 if col_spread <= 0.5 else 1
0062:     perp = 1 - axis
0063: 
0064:     ordered = sorted(objects, key=lambda obj: _center(obj, axis))
0065:     axis_centers = [_center(obj, axis) for obj in ordered]
0066:     assert axis_centers[0] < axis_centers[1] < axis_centers[2], "expected a unique middle object"
0067: 
0068:     source = ordered[1]
0069:     end_objects = [ordered[0], ordered[2]]
0070:     assert _is_solid_rectangle(g, source), "moving object must be a solid rectangle"
0071: 
0072:     target_candidates = [
0073:         obj
0074:         for obj in end_objects
0075:         if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)
0076:     ]
0077:     assert len(target_candidates) == 1, "expected one perpendicular solid target"
0078:     target = target_candidates[0]
0079: 
0080:     direction = -1 if _center(target, axis) < _center(source, axis) else 1
0081: 
0082:     sr0, sc0, sr1, sc1 = source["bbox"]
0083:     tr0, tc0, tr1, tc1 = target["bbox"]
0084:     source_lo = [sr0, sc0]
0085:     source_hi = [sr1, sc1]
