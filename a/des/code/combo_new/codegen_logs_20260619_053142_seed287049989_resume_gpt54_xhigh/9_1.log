+    outer_w = c1 - c0 + 1
+    inner_h = max(1, outer_h - 2 * shrink)
+    inner_w = max(1, outer_w - 2 * shrink)
+    nr0 = (r0 + r1 - inner_h + 1) // 2
+    nc0 = (c0 + c1 - inner_w + 1) // 2
+    nr1 = nr0 + inner_h - 1
+    nc1 = nc0 + inner_w - 1
