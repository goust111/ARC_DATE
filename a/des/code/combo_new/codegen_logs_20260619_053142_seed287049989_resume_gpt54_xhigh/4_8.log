+
+def _random_polyomino(area: int, rng: random.Random) -> list[tuple[int, int]] | None:
+    cells: set[tuple[int, int]] = {(0, 0)}
+
+    while len(cells) < area:
+        frontier: list[tuple[int, int]] = []
+        weights: list[int] = []
