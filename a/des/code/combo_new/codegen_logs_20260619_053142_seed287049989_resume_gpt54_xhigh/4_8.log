+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = int(rr + dr), int(cc + dc)
+                    if not (0 <= nr < height and 0 <= nc < width):
+                        continue
+                    if not mask[nr, nc] or visited[nr, nc]:
+                        continue
+                    visited[nr, nc] = True
+                    queue.append((nr, nc))
+
+            components.append(coords)
