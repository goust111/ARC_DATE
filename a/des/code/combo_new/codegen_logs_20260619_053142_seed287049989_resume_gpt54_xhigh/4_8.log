    bg = get_bg(g)
    edge_color, dr, dc = _signal_direction(g, bg)
    main_color, marker_color = _role_colors(g, bg, edge_color)

    out = g.copy()
    marker_cells = np.argwhere(g == marker_color)
    assert marker_cells.size > 0, "expected at least one marker"

