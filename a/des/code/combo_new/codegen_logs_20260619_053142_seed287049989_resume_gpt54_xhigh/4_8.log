+
+    if not {RED, ORANGE, YELLOW}.issubset(set(int(v) for v in np.unique(out))):
+        return None
+
+    if len(_components_of_color(grid, BLUE)) != object_count:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
