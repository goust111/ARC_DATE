    _hit_count, core_tail, side = winners[0]
    r0, c0, r1, c1, tail = core_tail

    out = g.copy()
    for r, c in tail:
        out[r, c] = bg

    mark_col = c0 if side == "left" else c1
    out[r0 : r1 + 1, mark_col] = MARK_COLOR
    return out

