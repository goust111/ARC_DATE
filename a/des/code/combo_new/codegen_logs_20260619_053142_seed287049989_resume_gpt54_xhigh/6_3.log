+def _make_solid_object(rng: random.Random) -> np.ndarray:
+    for _ in range(120):
+        h = rng.randint(2, 5)
+        w = rng.randint(2, 6)
+        target = rng.randint(max(3, (h * w) // 3), max(4, h * w - 1))
+        mask = _solid_growth_mask(h, w, target, rng)
+        if min(mask.shape) < 2:
+            continue
+        if _count_holes(mask) != 0:
