+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDE_TO_ARROW_DIR = {
+    "left": (0, 1),
+    "right": (0, -1),
+    "top": (1, 0),
+    "bottom": (-1, 0),
+}
+SIDE_TO_DELTA = {
+    "left": (0, -1),
+    "right": (0, 1),
+    "top": (-1, 0),
+    "bottom": (1, 0),
+}
+GEN_ATTEMPTS = 400
+MODULE_ATTEMPTS = 120
+SIDE_ATTEMPTS = 100
+CANVAS_ATTEMPTS = 120
