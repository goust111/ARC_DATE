+    tail = tails[0]
+    tail_r, tail_c = tail
+    neighbor_offsets = {
+        (nr - tail_r, nc - tail_c)
+        for nr, nc in _neighbors4(tail_r, tail_c)
+        if (nr, nc) in cells
