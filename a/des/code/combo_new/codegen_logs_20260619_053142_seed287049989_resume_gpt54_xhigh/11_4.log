+            expected.add((tail_r + k * dr, tail_c + k * dc))
+        if expected != cells:
+            continue
+
+        return {
+            "cells": cells,
+            "tail": tail,
+            "tip": shaft[-1],
+            "dir": direction,
+            "shaft_len": shaft_len,
+        }
+    return None
