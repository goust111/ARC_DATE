+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.reshape(-1))).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append({"color": color, "coords": coords})
+    return comps
+
+
+def _classify_strip(coords: list[tuple[int, int]]) -> dict | None:
+    rows = sorted({r for r, _ in coords})
+    cols = sorted({c for _, c in coords})
+    if len(rows) == 1:
+        r = rows[0]
+        ordered = sorted(c for _, c in coords)
+        if ordered == list(range(ordered[0], ordered[-1] + 1)):
+            cells = {(r, c) for c in ordered}
+            return {
+                "orientation": "h",
+                "cells": cells,
+                "row": r,
+                "start": ordered[0],
+                "end": ordered[-1],
+            }
+    if len(cols) == 1:
+        c = cols[0]
+        ordered = sorted(r for r, _ in coords)
+        if ordered == list(range(ordered[0], ordered[-1] + 1)):
+            cells = {(r, c) for r in ordered}
+            return {
+                "orientation": "v",
+                "cells": cells,
+                "col": c,
+                "start": ordered[0],
+                "end": ordered[-1],
+            }
+    return None
+
+
+def _perp_deltas(direction: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    dr, dc = direction
+    if dr == 0:
+        return (-1, 0), (1, 0)
+    return (0, -1), (0, 1)
+
+
+def _classify_arrow(coords: list[tuple[int, int]]) -> dict | None:
+    cells = set(coords)
+    if not (4 <= len(cells) <= 6):
+        return None
