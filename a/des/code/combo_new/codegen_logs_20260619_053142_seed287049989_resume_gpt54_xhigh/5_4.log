+def _edge_candidates(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    cells: list[tuple[int, int]] = []
+    for c in range(1, w - 1):
+        cells.append((0, c))
+        cells.append((h - 1, c))
+    for r in range(1, h - 1):
+        cells.append((r, 0))
+        cells.append((r, w - 1))
+    random.shuffle(cells)
+    return cells
