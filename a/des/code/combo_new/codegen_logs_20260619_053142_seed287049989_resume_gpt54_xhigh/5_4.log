+def _add_structure(
+    cells: set[tuple[int, int]],
+    structure_cells: set[tuple[int, int]],
+    structure_guard: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> bool:
+    if any(cell in structure_guard for cell in cells):
+        return False
+    structure_cells.update(cells)
+    structure_guard.update(_guard_cells(cells, shape))
+    return True
