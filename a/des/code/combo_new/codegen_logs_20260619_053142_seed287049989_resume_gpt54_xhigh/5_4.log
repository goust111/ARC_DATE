+                wall_blockers = set(wall_cells)
+                if not _straight_finish_is_clear(turn_cell, outgoing, shape, blocked_paths | local_path, blockers | wall_blockers):
+                    continue
+
+                candidates.append(
+                    {
+                        "run_cells": run_cells,
+                        "turn_cell": turn_cell,
+                        "outgoing": outgoing,
+                        "wall_cells": wall_cells,
+                        "marker": marker,
+                    }
+                )
+    return candidates
+
