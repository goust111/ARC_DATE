+                    sources.append(top)
+                    _paint_path_cells(path_cells, path_orients, path, DIR_DOWN)
+                    return True
+            bottom = (h - 1, c)
+            path = [(rr, c) for rr in range(h - 2, -1, -1)]
+            if bottom not in guard and bottom not in path_cells and not any(p in occupied for p in path):
+                if _reserve_structure({bottom}, occupied, guard, shape):
+                    sources.append(bottom)
+                    _paint_path_cells(path_cells, path_orients, path, DIR_UP)
+                    return True
+
+        if "v" in orients:
+            left = (r, 0)
+            path = [(r, cc) for cc in range(1, w)]
+            if left not in guard and left not in path_cells and not any(p in occupied for p in path):
+                if _reserve_structure({left}, occupied, guard, shape):
+                    sources.append(left)
+                    _paint_path_cells(path_cells, path_orients, path, DIR_RIGHT)
+                    return True
+            right = (r, w - 1)
+            path = [(r, cc) for cc in range(w - 2, -1, -1)]
+            if right not in guard and right not in path_cells and not any(p in occupied for p in path):
