+        wall_cells = choice["wall_cells"]  # type: ignore[index]
+        marker = choice["marker"]  # type: ignore[index]
+        outgoing = choice["outgoing"]  # type: ignore[index]
+        turn_cell = choice["turn_cell"]  # type: ignore[index]
