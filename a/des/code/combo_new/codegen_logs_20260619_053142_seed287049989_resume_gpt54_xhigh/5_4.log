+    candidates: list[dict[str, object]] = []
+    for outgoing in (_turn_left(direction), _turn_right(direction)):
+        for run_len in range(1, max_run + 1):
+            run_cells = [
+                (pos[0] + direction[0] * step, pos[1] + direction[1] * step)
+                for step in range(1, run_len + 1)
