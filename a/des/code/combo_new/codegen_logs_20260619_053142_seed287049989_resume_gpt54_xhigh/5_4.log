+    wall_mask = grid == WALL
+    keep_wall = np.zeros_like(wall_mask, dtype=bool)
+    marker_cells: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(wall_mask):
+        rr, cc = int(r), int(c)
+        neighbors = sum(
+            1
+            for dr, dc in (DIR_UP, DIR_DOWN, DIR_LEFT, DIR_RIGHT)
