        if not _add_structure({source}, structure_cells, structure_guard, shape):
            continue
        obj_cells: set[tuple[int, int]] = set()
        for wall_cells, marker in planned["segments"]:  # type: ignore[index]
            obj_cells.update(wall_cells)
