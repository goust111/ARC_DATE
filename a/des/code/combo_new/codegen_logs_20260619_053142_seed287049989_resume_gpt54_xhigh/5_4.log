+                    continue
+
+                candidates.append(
+                    {
+                        "run_cells": run_cells,
+                        "turn_cell": turn_cell,
+                        "outgoing": outgoing,
+                        "wall_cells": wall_cells,
+                        "marker": marker,
+                    }
+                )
