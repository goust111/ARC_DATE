+def _initial_dir(shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:
+    h, w = shape
+    assert not _is_corner(shape, r, c), "corner light sources are ambiguous"
+    if r == 0:
+        return DIR_DOWN
+    if r == h - 1:
