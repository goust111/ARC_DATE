+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in (DIR_UP, DIR_DOWN, DIR_LEFT, DIR_RIGHT):
+                    nr, nc = cr + dr, cc + dc
