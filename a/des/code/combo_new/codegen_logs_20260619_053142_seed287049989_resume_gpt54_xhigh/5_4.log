+def _add_mirror_source(
+    turns: int,
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    guard: set[tuple[int, int]],
+    path_cells: set[tuple[int, int]],
+    path_orients: dict[tuple[int, int], set[str]],
