+
+def _straight_finish_is_clear(
+    pos: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+    blocked_paths: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+) -> bool:
