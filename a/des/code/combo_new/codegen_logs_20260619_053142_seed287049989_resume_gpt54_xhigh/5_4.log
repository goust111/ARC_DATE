+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+MARKER = 9
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+MAX_ATTEMPTS = 500
+
+DIR_UP = (-1, 0)
+DIR_DOWN = (1, 0)
+DIR_LEFT = (0, -1)
+DIR_RIGHT = (0, 1)
