+        expected = (-int(mr), 0)
+        assert direction == expected, "horizontal wall hit from the wrong side"
+        return (0, int(mc))
+    assert orientation == "vertical"
+    expected = (0, -int(mc))
+    assert direction == expected, "vertical wall hit from the wrong side"
+    return (int(mr), 0)
