+        return wall, marker
+
+    if outgoing == DIR_UP:
+        wall = [(wall_hit[0] + i, wall_hit[1]) for i in range(length)]
+    else:
+        assert outgoing == DIR_DOWN
+        wall = [(wall_hit[0] - i, wall_hit[1]) for i in range(length)]
+    marker = (wall_hit[0] + outgoing[0], wall_hit[1] - dc)
+    return wall, marker
