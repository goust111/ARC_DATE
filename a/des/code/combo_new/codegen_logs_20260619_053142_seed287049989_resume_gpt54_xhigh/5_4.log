+
+    for r in range(1, h - 1):
+        left = (r, 0)
+        right = (r, w - 1)
+        corridor = [(r, c) for c in range(1, w - 1)]
+        if (
+            left not in guard
+            and right not in guard
+            and not any(cell in occupied or cell in path_cells for cell in corridor)
+        ):
+            options.append((left, right, corridor, DIR_RIGHT))
