+        assert len(hits) == 1, "each wall must have exactly one diagonal maroon marker"
+        endpoint, offset, marker = hits[0]
+        wall = {
+            "cells": tuple(ordered),
+            "orientation": orientation,
+            "endpoint": endpoint,
+            "marker_offset": offset,
+            "marker": marker,
+        }
+        walls.append(wall)
+        for cell in ordered:
+            wall_lookup[cell] = wall
