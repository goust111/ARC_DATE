+    for c in range(1, w - 1):
+        top = (0, c)
+        bottom = (h - 1, c)
+        corridor = [(r, c) for r in range(1, h - 1)]
+        if (
+            top not in guard
+            and bottom not in guard
+            and not any(cell in occupied or cell in path_cells for cell in corridor)
+        ):
+            options.append((top, bottom, corridor, DIR_DOWN))
