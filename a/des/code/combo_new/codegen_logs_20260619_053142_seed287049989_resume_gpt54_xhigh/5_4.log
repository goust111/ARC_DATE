+                    sources.append(bottom)
+                    _paint_path_cells(path_cells, path_orients, path, DIR_UP)
+                    return True
+
+        if "v" in orients:
+            left = (r, 0)
+            path = [(r, cc) for cc in range(1, w)]
+            if left not in guard and left not in path_cells and not any(p in occupied for p in path):
