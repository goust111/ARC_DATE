+    path_cells: set[tuple[int, int]] = set()
+    path_orients: dict[tuple[int, int], set[str]] = {}
+    sources: list[tuple[int, int]] = []
+    walls: list[list[tuple[int, int]]] = []
+    markers: list[tuple[int, int]] = []
+
+    if random.random() < 0.5:
