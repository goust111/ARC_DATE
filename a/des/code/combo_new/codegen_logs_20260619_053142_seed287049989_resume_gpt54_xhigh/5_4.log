+            return None
+
+    if random.random() < 0.45:
+        _add_crossing_source(shape, occupied, guard, path_cells, path_orients, sources)
+
+    if len(sources) > len(SOURCE_COLORS):
+        return None
+
+    if len(walls) != len(markers):
+        return None
+
+    grid = _render_grid(shape, sources, walls, markers)
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    if len(np.unique(grid)) < 4:
+        return None
+    if not walls:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid mirror-light input")

