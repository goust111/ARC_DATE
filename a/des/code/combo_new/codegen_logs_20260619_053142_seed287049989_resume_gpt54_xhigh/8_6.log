+BG = 0
+CENTER_COLOR = 5
+RING_COUNT = 3
+OFFSET_OPTIONS = (-1, 0, 1)
+SIDES = ("top", "bottom", "left", "right")
+VERTICAL_SIDES = {"top", "bottom"}
+HORIZONTAL_SIDES = {"left", "right"}
+PALETTE = tuple(range(10))
+MAX_GEN_ATTEMPTS = 400
