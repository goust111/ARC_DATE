+    frame_bbox = (frame_top, frame_left, frame_top + outer_h - 1, frame_left + outer_w - 1)
+    meta = {
+        "bbox": frame_bbox,
+        "direction": direction,
+        "arrow_cells": arrow_cells,
+        "stripes": stripes,
+    }
+    return obj, meta
