+                out[r0 + 1 + i, c0 + 1 : c0 + 1 + fill] = int(stripe["color"])
+        elif direction == "up":
+            for i, stripe in enumerate(frame["stripes"][:inner_h]):
+                fill = min(int(stripe["length"]), inner_w)
+                out[r1 - 1 - i, c0 + 1 : c0 + 1 + fill] = int(stripe["color"])
+        elif direction == "right":
