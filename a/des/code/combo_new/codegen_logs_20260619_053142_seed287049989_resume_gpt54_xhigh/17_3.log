+def _shift_meta(meta: dict[str, Any], dr: int, dc: int) -> dict[str, Any]:
+    r0, c0, r1, c1 = meta["bbox"]
+    shifted = {
+        "bbox": (r0 + dr, c0 + dc, r1 + dr, c1 + dc),
