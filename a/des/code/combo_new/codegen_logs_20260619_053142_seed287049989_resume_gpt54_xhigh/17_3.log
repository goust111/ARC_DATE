+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                on_border = r in (r0, r1) or c in (c0, c1)
+                if on_border:
+                    if int(grid[r, c]) != FRAME_COLOR:
+                        ok = False
+                        break
+                elif int(grid[r, c]) != bg:
+                    ok = False
