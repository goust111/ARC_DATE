+        for r in range(r0 + 2, r1 - 1):
+            cells = [(r, c0 - 1), (r - 1, c0 - 2), (r + 1, c0 - 2)]
+            if all(0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == ARROW_COLOR for rr, cc in cells):
