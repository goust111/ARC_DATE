+    h = _random_int(rng, side_min, 30)
+    w = _random_int(rng, side_min, 30)
+    return h, w
+
+
+def _paint_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    mask = patch != BG
+    window = grid[top : top + h, left : left + w]
+    window[mask] = patch[mask]
