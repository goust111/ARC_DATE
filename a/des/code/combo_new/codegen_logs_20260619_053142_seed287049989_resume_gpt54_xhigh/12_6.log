+def _make_patch_from_hole(hole: np.ndarray, color: int, bg: int = BG) -> np.ndarray:
+    ih, iw = hole.shape
+    patch = np.full((ih + 2, iw + 2), bg, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    patch[1:-1, 1:-1][~hole] = color
+    return patch
