+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+GEN_RETRIES = 400
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+EDGE_BAND = 2
+FENCE_MARGIN = 2
+KEY_MARGIN = 1
+FENCE_KEY_MARGIN = 4
+
