+        child_h, child_w = child_dims
+        if child_h > ih or child_w > iw:
+            return None
+        pr0 = (ih - child_h) // 2
+        pc0 = (iw - child_w) // 2
+        protect[pr0 : pr0 + child_h, pc0 : pc0 + child_w] = True
