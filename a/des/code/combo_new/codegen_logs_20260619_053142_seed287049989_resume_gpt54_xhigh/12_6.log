+            if not frontier:
+                break
+            frontier = sorted(set(frontier), key=lambda cell: (cell[0], cell[1]))
+            blocker.add(rng.choice(frontier))
+
+        hole = np.ones((ih, iw), dtype=bool)
+        for r, c in blocker:
+            hole[r, c] = False
+        if child_dims is not None and not np.all(hole[protect]):
