+def _looks_like_fence(patch: np.ndarray, color: int, bg: int) -> bool:
+    h, w = patch.shape
+    if h < 4 or w < 4:
+        return False
+    if not np.all(patch[0, :] == color) or not np.all(patch[-1, :] == color):
+        return False
+    if not np.all(patch[:, 0] == color) or not np.all(patch[:, -1] == color):
+        return False
+    return bool(np.any(patch[1:-1, 1:-1] == bg))
