+    edge_like = [
+        cell
+        for cell in candidates
+        if min(cell[0], cell[1], ih - 1 - cell[0], iw - 1 - cell[1]) == 1
+    ]
+    starts = edge_like or candidates
+
+    for _ in range(120):
+        target = _random_int(rng, 1, min(5, len(candidates)))
