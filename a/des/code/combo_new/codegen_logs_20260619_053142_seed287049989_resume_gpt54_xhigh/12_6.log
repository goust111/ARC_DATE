+                {
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "color": color,
+                    "patch": patch,
+                    "hole": hole,
+                    "area": int(patch.shape[0] * patch.shape[1]),
+                }
+            )
+        else:
+            comps = _component_masks(mask)
+            assert len(comps) == 1
+            keys.append(
+                {
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "color": color,
+                    "mask": _crop_mask(mask[r0 : r1 + 1, c0 : c1 + 1]),
+                }
