+def _apply_operation(segment: np.ndarray, op: int) -> np.ndarray:
+    if op == RED:
+        return segment[::-1].copy()
+    if op == BLUE:
+        return segment.copy()
+    if op == GREEN:
+        return np.roll(segment, 2)
+    raise AssertionError(f"unknown operation marker: {op}")
+
