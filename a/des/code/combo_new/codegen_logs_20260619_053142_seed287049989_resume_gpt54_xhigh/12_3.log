+    for r in range(h):
+        for c in range(max(0, min_col), w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
