+def _components_of_color(grid: np.ndarray, color: int, min_col: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros_like(grid, dtype=bool)
+    components: list[list[tuple[int, int]]] = []
