+        prev_start = start
+        prev_height = height
+    return intervals
+
+
+def _mode_depths(rng: random.Random) -> list[int]:
+    mode = rng.choice(("nested", "disjoint", "mixed"))
+    if mode == "nested":
+        return [rng.randint(2, 4)]
+    if mode == "disjoint":
+        return [1] * rng.randint(3, 4)
