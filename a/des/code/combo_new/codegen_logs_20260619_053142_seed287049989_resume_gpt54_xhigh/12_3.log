+    end_rows = {int(r) for r in np.flatnonzero(grid[:, left_right_marker_col] == MARKER)}
+    assert start_rows and len(start_rows) == len(end_rows)
+
+    bars: list[dict[str, int]] = []
+    stack: list[tuple[int, int]] = []
+    for row in range(h):
