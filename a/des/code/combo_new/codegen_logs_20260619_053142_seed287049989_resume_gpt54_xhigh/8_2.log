+
+def _choose_seed_cell(region_mask: np.ndarray, rng: random.Random) -> tuple[int, int]:
+    boundary_dist = _distance_from_boundary(region_mask)
+    region_coords = np.argwhere(region_mask)
+    values = boundary_dist[region_mask]
