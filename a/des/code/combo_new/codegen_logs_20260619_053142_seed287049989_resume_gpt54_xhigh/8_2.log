+    except AssertionError:
+        return None
+    if len(parsed) != region_count:
+        return None
+
+    parsed_steps = [_count_boundary_sides(region_mask) // 2 for region_mask, _seed, _color in parsed]
+    if len(set(parsed_steps)) < 2:
