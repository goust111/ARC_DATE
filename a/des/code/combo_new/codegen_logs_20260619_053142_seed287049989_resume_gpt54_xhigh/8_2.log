+    max_cell_w = min(CELL_SIZE_RANGE[1], (30 - (coarse_w - 1)) // coarse_w)
+    if max_cell_h < CELL_SIZE_RANGE[0] or max_cell_w < CELL_SIZE_RANGE[0]:
+        return None
+
