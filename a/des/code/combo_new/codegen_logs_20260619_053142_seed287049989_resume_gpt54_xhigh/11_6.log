+
+    try:
+        _validate_instance(grid, bboxes, colors, counts_by_container, scatter_by_container)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(_RNG)
+        if grid is not None:
