+                    best_candidates = candidates
+
+            assert best_candidates is not None
+            quadrant, axis = pending.pop(best_index)
+            _ = quadrant, axis
+            r, c = rng.choice(best_candidates)
+            grid[r, c] = colors[idx]
+            scatter_by_container[idx].append((r, c))
