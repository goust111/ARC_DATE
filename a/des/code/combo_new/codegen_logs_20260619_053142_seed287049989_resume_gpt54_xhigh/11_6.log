+        candidates = [(r0, c0) for r0 in range(1, row_hi + 1) for c0 in range(1, col_hi + 1)]
+        rng.shuffle(candidates)
+
+        placed = False
+        for r0, c0 in candidates:
+            r1 = r0 + box_h - 1
+            c1 = c0 + box_w - 1
+            if blocked[r0 : r1 + 1, c0 : c1 + 1].any():
+                continue
