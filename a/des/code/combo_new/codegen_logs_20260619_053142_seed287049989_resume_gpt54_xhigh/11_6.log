+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 4 or width < 4:
+        return False
+    if len(coord_set) != 2 * height + 2 * width - 4:
+        return False
+    for rr in range(r0, r1 + 1):
+        for cc in range(c0, c1 + 1):
+            on_border = rr in (r0, r1) or cc in (c0, c1)
+            if ((rr, cc) in coord_set) != on_border:
