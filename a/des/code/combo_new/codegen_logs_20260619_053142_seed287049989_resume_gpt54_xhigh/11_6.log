+        for cc in range(max(0, c - radius), min(w, c + radius + 1)):
+            mask[rr, cc] = True
+
+
+def _mark_box(mask: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 0) -> None:
+    h, w = mask.shape
+    r0, c0, r1, c1 = bbox
