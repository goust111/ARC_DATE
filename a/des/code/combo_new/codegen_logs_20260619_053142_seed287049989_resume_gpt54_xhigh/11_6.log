+    for bbox in bboxes:
+        _mark_box(blocked, bbox, pad=1)
+
+    scatter_by_container: list[list[tuple[int, int]]] = [[] for _ in range(n_containers)]
+    order = sorted(range(n_containers), key=lambda idx: len(requests_by_container[idx]), reverse=True)
+    for idx in order:
