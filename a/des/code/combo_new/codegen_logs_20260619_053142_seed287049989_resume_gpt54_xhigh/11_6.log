+    counts_by_container: list[list[int]] = []
+    for idx, capacity in enumerate(capacities):
+        if idx == overflow_idx:
+            extra = rng.randint(1, min(4, capacity))
+            total = capacity + extra
+        else:
+            total = rng.randint(1, min(capacity, 7))
