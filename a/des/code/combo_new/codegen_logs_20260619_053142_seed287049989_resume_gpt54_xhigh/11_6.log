+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+
+LEGEND_COLORS = (GREEN, YELLOW, ORANGE, MAGENTA)
+CONTAINER_COLOR_POOL = (1, 2, 5, 8, 9)
+
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+INTERIOR_H_RANGE = (2, 4)
+INTERIOR_W_RANGE = (2, 4)
+GEN_ATTEMPTS = 400
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIRS8 = DIRS4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))
+
+_RNG = random.Random()
