+        scatter = container["scatter"]
+        counts = [0, 0, 0, 0]
+        for r, c in scatter:
+            counts[_quadrant_index(int(r), int(c), bbox)] += 1
+            out[int(r), int(c)] = bg
+
+        fill_values: list[int] = []
+        for idx, count in enumerate(counts):
