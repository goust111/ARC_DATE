+def _special_request(
+    rng: random.Random, bbox: tuple[int, int, int, int], counts: list[int]
+) -> tuple[int, str] | None:
+    r0, c0, r1, c1 = bbox
+    options: list[tuple[int, str]] = []
+    if (r0 + r1) % 2 == 0:
+        if counts[0] > 0:
+            options.append((0, "row"))
+        if counts[1] > 0:
+            options.append((1, "row"))
+    if (c0 + c1) % 2 == 0:
