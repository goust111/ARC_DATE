+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+INTERIOR_H_RANGE = (2, 4)
+INTERIOR_W_RANGE = (2, 4)
+GEN_ATTEMPTS = 400
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIRS8 = DIRS4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))
