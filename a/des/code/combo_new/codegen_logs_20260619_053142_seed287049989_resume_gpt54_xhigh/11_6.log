+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    visited = np.zeros_like(mask, dtype=bool)
+    dirs = DIRS8 if connectivity == 8 else DIRS4
+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
