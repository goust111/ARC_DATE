+        comps.sort(key=len, reverse=True)
+        border = comps[0]
+        assert _is_hollow_rectangle(border), f"color {color} must contain one hollow rectangle"
+        scatter: list[tuple[int, int]] = []
+        for comp in comps[1:]:
