+    if total >= 4 and rng.random() < 0.4:
+        seeds = [0, 1, 2, 3]
+    elif total >= 3 and rng.random() < 0.7:
+        seeds = rng.sample(range(4), 3)
+    elif total >= 2:
+        seeds = rng.sample(range(4), 2)
+    else:
+        seeds = [rng.randrange(4)]
+
+    for quadrant in seeds:
