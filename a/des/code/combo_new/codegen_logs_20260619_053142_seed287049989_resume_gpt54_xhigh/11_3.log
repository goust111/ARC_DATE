+def _background_partition(mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    bg = ~mask
+    exterior = np.zeros((h, w), dtype=bool)
