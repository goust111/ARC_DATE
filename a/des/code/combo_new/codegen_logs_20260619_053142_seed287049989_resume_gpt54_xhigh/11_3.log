+def _layout_objects(masks: list[np.ndarray], rng: random.Random) -> tuple[int, int, list[tuple[int, int]]] | None:
+    n = len(masks)
+    row_options = [r for r in (1, 2, 3) if r <= n]
+    if n >= 5:
+        row_options = [r for r in row_options if r >= 2]
