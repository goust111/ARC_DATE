+def _arrow_cells_from_tip(tip: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    tr, tc = tip
+    return [(tr + dr, tc + dc) for dr, dc in ARROW_RELS[direction]]
