+    if on_top:
+        step = SIDE_TO_STEP["top"]
+    elif on_bottom:
+        step = SIDE_TO_STEP["bottom"]
+    elif on_left:
+        step = SIDE_TO_STEP["left"]
+    else:
+        step = SIDE_TO_STEP["right"]
+
