+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GRID_H_RANGE = (12, 30)
+GRID_W_RANGE = (12, 30)
+RECT_COUNT_OPTIONS = (1, 2, 3, 4)
+RECT_COUNT_WEIGHTS = (2, 4, 3, 1)
+RECT_H_RANGE = (2, 7)
+RECT_W_RANGE = (2, 7)
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 250
