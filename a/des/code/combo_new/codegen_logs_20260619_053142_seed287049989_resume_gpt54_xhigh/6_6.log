+    on_bottom = gap_r_rel == box_h - 1
+    on_left = gap_c_rel == 0
+    on_right = gap_c_rel == box_w - 1
+    assert sum((on_top, on_bottom, on_left, on_right)) == 1, "gap must lie on exactly one side, not a corner"
