/bin/bash -lc "python - <<'PY'
from itertools import product
from collections import deque

BG=0
WALL=5

def comps(grid):
    h=len(grid); w=len(grid[0])
    seen=set(); out=[]
    for r in range(h):
        for c in range(w):
            if grid[r][c]"'!=BG or (r,c) in seen: continue
            q=[(r,c)]; seen.add((r,c)); comp=[]; touch=False
            while q:
                x,y=q.pop(); comp.append((x,y))
                if x in (0,h-1) or y in (0,w-1): touch=True
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and grid[nx][ny]==BG and (nx,ny) not in seen:
                        seen.add((nx,ny)); q.append((nx,ny))
            out.append((comp,touch))
    return out

def test(inner_h, inner_w, seed_len, sr, sc0, orient, gaps, active_thick=2, inactive_thick=2):
    h=inner_h+2; w=inner_w+2
    g=[[BG]*w for _ in range(h)]
    # draw full frame
    for c in range(w):
        g[0][c]=WALL; g[h-1][c]=WALL
    for r in range(h):
        g[r][0]=WALL; g[r][w-1]=WALL
    # carve gaps: top,bot,left,right=(start,len)
    top,bottom,left,right=gaps
