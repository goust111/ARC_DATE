+        if direction == "right":
+            dy, dx = 0, zc1 - c1
+        elif direction == "left":
+            dy, dx = 0, zc0 - c0
+        elif direction == "down":
+            dy, dx = zr1 - r1, 0
+        else:
+            assert direction == "up"
+            dy, dx = zr0 - r0, 0
+
+        _paint_rect(out, (r0 + dy, c0 + dx, r1 + dy, c1 + dx), int(color))
+
+    return out

