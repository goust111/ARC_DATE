+) -> tuple[int, int, int, int]:
+    r0 = max(0, int(top) - 1)
+    c0 = max(0, int(left) - 1)
+    r1 = min(grid_shape[0] - 1, int(top + height))
+    c1 = min(grid_shape[1] - 1, int(left + width))
+    return r0, c0, r1, c1
+
+
+def _rect_free(occupied: np.ndarray, rect: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = rect
