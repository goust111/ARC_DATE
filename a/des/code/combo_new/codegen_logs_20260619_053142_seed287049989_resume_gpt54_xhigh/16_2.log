+        return "horizontal", comp_b.copy(), comp_a.copy(), center_b, center_a
+    if center_a[0] < center_b[0]:
+        return "vertical", comp_a.copy(), comp_b.copy(), center_a, center_b
+    return "vertical", comp_b.copy(), comp_a.copy(), center_b, center_a
