+
+BG_COLOR = 0
+GRID_HEIGHT_RANGE = (12, 24)
+GRID_WIDTH_RANGE = (12, 24)
+PAIR_COUNT_RANGE = (1, 3)
+FRAGMENT_SIZE_RANGE = (2, 5)
+GAP_RANGE = (1, 4)
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+PLACEMENT_RETRIES = 150
+GENERATION_RETRIES = 400
