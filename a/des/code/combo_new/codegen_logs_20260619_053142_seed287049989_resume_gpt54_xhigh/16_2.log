+    if center_a[0] == center_b[0] and center_a[1] != center_b[1]:
+        if center_a[1] < center_b[1]:
+            return "horizontal", comp_a.copy(), comp_b.copy(), center_a, center_b
+        return "horizontal", comp_b.copy(), comp_a.copy(), center_b, center_a
