+    palette_size = rng.randint(*PALETTE_SIZE_RANGE)
+    max_sources = min(SOURCE_COUNT_RANGE[1], 2 * palette_size)
+    source_count = rng.randint(SOURCE_COUNT_RANGE[0], max_sources)
+
+    min_h = max(7, 2 * source_count + 1)
