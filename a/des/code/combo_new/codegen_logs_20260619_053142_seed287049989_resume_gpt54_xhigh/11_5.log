+    assert g.ndim == 2 and g.size > 0
+    h, w = g.shape
+    assert w % 2 == 1
+
+    bg = _most_common_color(g)
+    sep = w // 2
+    sep_color = int(g[0, sep])
+    assert sep_color != bg and bool(np.all(g[:, sep] == sep_color))
+
+    left = g[:, :sep]
+    right = g[:, sep + 1 :]
