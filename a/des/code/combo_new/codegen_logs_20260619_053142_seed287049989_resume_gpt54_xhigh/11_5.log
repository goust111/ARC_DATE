+    coords = np.argwhere(panel == color)
+    assert coords.size > 0, f"missing color {color}"
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return panel[r0 : r1 + 1, c0 : c1 + 1] == color
