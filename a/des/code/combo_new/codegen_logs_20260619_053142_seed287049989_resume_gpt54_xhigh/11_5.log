+        for r, c in _mask_cells(full):
+            rr = top + r
+            cc = left_col + c
+            assert 0 <= rr < right.shape[0] and 0 <= cc < right.shape[1], "completed pattern must fit the panel"
+            assert int(out[rr, cc]) in (bg, color), "completed patterns must not overlap"
+            out[rr, cc] = color
