+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+PALETTE = tuple(range(10))
+SEPARATOR_COLOR = 5
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 240
+RIGHT_PANEL_WIDTH_RANGE = (10, 14)
+GRID_HEIGHT_RANGE = (10, 16)
