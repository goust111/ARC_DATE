+BG_CHOICES = [0, 1, 2, 3, 4, 6, 7, 8]
+PATTERN_MASKS = [
+    np.array(
+        [
+            [int((mask >> 0) & 1), int((mask >> 1) & 1)],
+            [int((mask >> 2) & 1), int((mask >> 3) & 1)],
