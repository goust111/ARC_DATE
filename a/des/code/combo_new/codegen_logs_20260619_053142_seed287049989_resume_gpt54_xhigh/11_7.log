+    cur = bottom
+    for off in sorted(offsets["left"], reverse=True):
+        row = top + off
+        _append_part(seq, [(r, left) for r in range(cur, row + 2, -1)])
+        part = [
+            (row + 3, left),
+            (row + 3, left + 1),
+            (row + 3, left + 2),
+            (row + 2, left + 2),
+            (row + 1, left + 2),
+            (row, left + 2),
+            (row, left + 1),
