+        stations.append({"kind": "right", "top_left": (row + 1, right - 1), "seq": part})
+        cur = row + 3
+    _append_part(seq, [(r, right) for r in range(cur, bottom + 1)])
+
+    cur = right
+    for off in sorted(offsets["bottom"], reverse=True):
