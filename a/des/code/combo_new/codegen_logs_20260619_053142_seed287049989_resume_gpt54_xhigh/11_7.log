  26:     grid = np.asarray(grid, dtype=int)
  27:     h, w = grid.shape
  28:     out = grid.copy()
  29: 
  30:     # Cross "center hole": row/col with maximum 8s.
  31:     row_counts = np.sum(grid == 8, axis=1)
  32:     col_counts = np.sum(grid == 8, axis=0)
  33:     cr = int(np.argmax(row_counts))
  34:     cc = int(np.argmax(col_counts))
  35: 
  36:     def inb(r: int, c: int) -> bool:
  37:         return 0 <= r < h and 0 <= c < w
  38: 
  39:     def is_border(r: int, c: int) -> bool:
  40:         return r == 0 or r == h - 1 or c == 0 or c == w - 1
