+            for kind, tpl in STATION_TEMPLATES.items():
+                seq = [(r + dr, c + dc) for dr, dc in tpl["seq"]]
+                if not all(_in_bounds(h, w, rr, cc) and path_mask[rr, cc] for rr, cc in seq):
