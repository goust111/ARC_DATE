  45:     def right(d):
  46:         return _DIRS_URDL[(_DIRS_URDL.index(d) + 1) % 4]
  47: 
  48:     def left(d):
  49:         return _DIRS_URDL[(_DIRS_URDL.index(d) + 3) % 4]
  50: 
  51:     def spacing_ok(cell, prev, start) -> bool:
  52:         r, c = cell
  53:         for nr, nc in neighbors4(r, c):
  54:             if inb(nr, nc) and out[nr, nc] != 0 and (nr, nc) != prev and (nr, nc) != start:
  55:                 return False
  56:         return True
  57: 
  58:     def can_move(cur, d, length: int) -> bool:
  59:         prev = cur
  60:         for t in range(1, length + 1):
