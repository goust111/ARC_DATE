        'open': [(0,-1),(1,-1)],
    },
}

def get_bg(g):
    vals, cnts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(cnts)])

def ordered_cycle(path_mask, forbidden):
    pts={tuple(map(int,p)) for p in np.argwhere(path_mask)}
    def nbrs(p):
        r,c=p
        return [(r+dr,c+dc) for dr,dc in DIR4 if (r+dr,c+dc) in pts]
    for p in pts:
        assert len(nbrs(p))==2, (p, nbrs(p))
    choices=sorted(p for p in pts if p not in forbidden)
    start=choices[0]
    first=sorted(nbrs(start))[0]
    seq=[start, first]
    prev,cur=start,first
    while True:
        nxts=[p for p in nbrs(cur) if p"'!=prev]
        assert len(nxts)==1
        nxt=nxts[0]
        if nxt==start:
            break
        seq.append(nxt)
        prev,cur=cur,nxt
        assert len(seq)<=len(pts)
    assert len(seq)==len(pts)
    area=sum(c1*r2 - c2*r1 for (r1,c1),(r2,c2) in zip(seq, seq[1:]+seq[:1]))
    if area < 0:
        seq=[seq[0]]+list(reversed(seq[1:]))
    return seq

def analyze(g):
    g=np.asarray(g,int)
    h,w=g.shape
    bg=get_bg(g)
    path_mask=(g==GREY)|(g==MAROON)
    assert path_mask.any()
    candidates=[c for c in np.unique(g) if int(c) not in (bg,GREY,MAROON)]
    assert len(candidates)==1
    obj=int(candidates[0])
    stations=[]
    occupied=set()
    def inb(r,c): return 0<=r<h and 0<=c<w
    for r in range(h-1):
        for c in range(w-1):
            if any((r+dr,c+dc) in occupied for dr in (0,1) for dc in (0,1)):
                continue
            block=g[r:r+2,c:c+2]
            if np.any((block==GREY)|(block==MAROON)):
                continue
            if np.any((block!=bg)&(block!=obj)):
                continue
            matches=[]
            for name,tpl in TEMPLATES.items():
                seq=[(r+dr,c+dc) for dr,dc in tpl['"'seq']]
                if not all(inb(rr,cc) and path_mask[rr,cc] for rr,cc in seq):
                    continue
                opens=[(r+dr,c+dc) for dr,dc in tpl['open']]
                if not all((not inb(rr,cc)) or (not path_mask[rr,cc]) for rr,cc in opens):
                    continue
                matches.append((name,seq))
            if len(matches)==1:
                name,seq=matches[0]
                stations.append({'top_left':(r,c),'kind':name,'seq':seq,'pattern':(block==obj).astype(int)})
                occupied.update((r+dr,c+dc) for dr in (0,1) for dc in (0,1))
    assert len(stations) >= 3, len(stations)
    forbidden={cell for st in stations for cell in st['seq']}
    cycle=ordered_cycle(path_mask, forbidden)
    idx={p:i for i,p in enumerate(cycle)}
    n=len(cycle)
    for st in stations:
        inds=[idx[p] for p in st['seq']]
        ok=all(inds[i+1]==inds[i]+1 for i in range(len(inds)-1))
        assert ok, (st['kind'], st['top_left'], inds)
        st['start']=inds[0]
        st['end']=inds[-1]
    stations.sort(key=lambda st: st['start'])
    marks=[]
    for i,st in enumerate(stations):
        nxt=stations[(i+1)%len(stations)]
        cells=[]
        cur=(st['end']+1)%n
        while cur "'!= nxt['"'start']:
            cells.append(cycle[cur])
            cur=(cur+1)%n
        marks.append(any(g[r,c]==MAROON for r,c in cells))
    return stations, marks

# build one grid
