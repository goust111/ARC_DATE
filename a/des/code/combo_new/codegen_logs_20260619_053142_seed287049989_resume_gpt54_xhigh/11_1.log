+def _position_bounds(
+    h: int,
+    w: int,
+    box_h: int,
+    box_w: int,
+    area: int,
+    direction_name: str,
+    truncated: bool,
+) -> tuple[int, int, int, int] | None:
+    row_lo, row_hi = 1, h - box_h - 1
+    col_lo, col_hi = 1, w - box_w - 1
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+
+    if direction_name == "up":
+        if truncated:
+            row_hi = min(row_hi, area - 1)
+        else:
