+        gap = rect["gap"]  # type: ignore[assignment]
+        direction = rect["direction"]  # type: ignore[assignment]
+        length = int(rect["area"])
+        color = int(rect["seed_color"])
+        for r, c in _ray_cells(gap, direction, length, h, w):
+            out[r, c] = color
