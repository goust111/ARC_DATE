+    if _most_common_color(grid) != bg:
+        return None
+    detected = _detect_rectangles(grid)
+    if len(detected) != len(placed):
+        return None
+
+    expected = grid.copy()
+    for spec in placed:
+        color = int(spec["seed_color"])
+        for r, c in spec["ray"]:  # type: ignore[index]
+            expected[r, c] = color
