+def _fill_votes(
+    board: list[list[int | None]], tiles: dict[int, dict[str, Any]]
+) -> tuple[dict[tuple[int, int], int], list[dict[str, Any]], bool]:
+    n = len(board)
+    fills: dict[tuple[int, int], int] = {}
+    details: list[dict[str, Any]] = []
+    saw_tie = False
+    for r in range(n):
