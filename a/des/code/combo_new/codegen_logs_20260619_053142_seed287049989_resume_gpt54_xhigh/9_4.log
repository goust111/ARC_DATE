+    right = int(grid[r, c + 1]) == grey
+    key = (up, down, left, right)
+    mapping = {
+        (False, True, False, True): "TL",
+        (False, True, True, False): "TR",
+        (True, False, False, True): "BL",
+        (True, False, True, False): "BR",
