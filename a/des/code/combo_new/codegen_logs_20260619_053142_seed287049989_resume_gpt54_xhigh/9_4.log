+    if on_top and on_right:
+        return "top"
+    if on_bottom and on_left:
+        return "bottom"
+    if on_bottom and on_right:
+        return "bottom"
+    if on_top:
+        return "top"
+    if on_bottom:
+        return "bottom"
+    if on_left:
+        return "left"
+    if on_right:
+        return "right"
