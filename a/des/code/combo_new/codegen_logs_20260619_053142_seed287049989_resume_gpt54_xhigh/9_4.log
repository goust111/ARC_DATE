+    anchors = _anchor_map(g)
+    grey = _infer_grey(g, set(anchors))
+    out = np.full_like(g, BLACK)
+
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            color = int(g[r, c])
+            if color == BLACK or color == grey or color not in anchors:
