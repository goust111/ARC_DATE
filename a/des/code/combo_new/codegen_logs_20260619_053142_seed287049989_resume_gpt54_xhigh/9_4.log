+
+def _anchor_map(grid: np.ndarray) -> dict[int, tuple[int, int]]:
+    h, w = grid.shape
+    anchors: dict[int, tuple[int, int]] = {}
+    border_points = []
+    for c in range(w):
+        border_points.append((0, c))
+        border_points.append((h - 1, c))
