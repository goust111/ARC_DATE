+    h, w = shape
+    on_top = r == 0
+    on_bottom = r == h - 1
+    on_left = c == 0
+    on_right = c == w - 1
+    if on_top and on_left:
+        return "top"
+    if on_top and on_right:
+        return "top"
+    if on_bottom and on_left:
+        return "bottom"
+    if on_bottom and on_right:
+        return "bottom"
+    if on_top:
+        return "top"
+    if on_bottom:
+        return "bottom"
+    if on_left:
+        return "left"
+    if on_right:
+        return "right"
+    raise ValueError(f"anchor is not on the border: {anchor}")
+
