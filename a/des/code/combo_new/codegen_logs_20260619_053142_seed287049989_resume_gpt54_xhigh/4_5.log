+    for step in col_steps:
+        cols.append(cols[-1] + step)
+
+    mask = np.zeros((rows[-1] + 1, cols[-1] + 1), dtype=bool)
+    for (r0, c0), (r1, c1) in edges:
+        rr0 = rows[r0]
+        rr1 = rows[r1]
+        cc0 = cols[c0]
+        cc1 = cols[c1]
+        if rr0 == rr1:
