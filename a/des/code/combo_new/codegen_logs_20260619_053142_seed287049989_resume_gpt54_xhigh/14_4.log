+    for idx in picks:
+        variants = _all_dihedral(SHAPE_LIBRARY[int(idx)])
+        rng.shuffle(variants)
+        chosen = None
+        for variant in variants:
+            key = _exact_key(variant)
+            if key not in used:
+                chosen = variant
+                used.add(key)
+                break
+        assert chosen is not None
+        shapes.append(chosen)
+    return shapes
