+        )
+        base_inner_w = max(base_inner_w, row_width)
+        base_inner_h += row_height
+
+    for _ in range(max(0, len(rows) - 1)):
+        gap = rng.randint(1, 2)
+        row_gaps.append(gap)
+        base_inner_h += gap
+
+    inner_w = base_inner_w + rng.randint(0, 2)
+    inner_h = base_inner_h + rng.randint(0, 2)
