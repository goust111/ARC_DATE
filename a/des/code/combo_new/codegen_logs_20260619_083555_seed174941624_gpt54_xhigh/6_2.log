+
+def _build_instances(rng: random.Random, count: int) -> list[dict[str, object]] | None:
+    signatures: set[tuple[str, ...]] = set()
+    colors = rng.sample(PIECE_COLORS, count)
+    instances: list[dict[str, object]] = []
+
+    for color in colors:
