+    row = top_pad
+    for idx, band_h in enumerate(band_heights):
+        band_specs.append((row, band_h))
+        row += band_h
+        if idx < len(gaps):
+            row += gaps[idx]
+    assert row + bottom_pad == height
+    return height, band_specs
