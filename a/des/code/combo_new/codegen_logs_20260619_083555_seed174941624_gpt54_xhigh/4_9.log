+BG = 0
+YELLOW = 4
+GREY = 5
+PALETTE = (1, 2, 3, 6, 7, 8, 9)
+
+BRANCHES = ("direct", "up", "down")
+GENERATION_ATTEMPTS = 400
+PAIR_COUNT_CHOICES = (2, 3)
+WIDTH_RANGE = (18, 31)
+BAND_HEIGHT_RANGE = (7, 10)
+BAND_GAP_RANGE = (1, 4)
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
