+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _build_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid signal-routing puzzle")

