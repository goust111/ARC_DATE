+    minimum_height = sum(band_heights) + sum(base_gaps)
+    if minimum_height > 30:
+        return None
+
+    extra = int(rng.integers(0, 31 - minimum_height))
+    slot_count = pair_count + 1
+    slot_extras = rng.multinomial(extra, [1.0 / slot_count] * slot_count)
