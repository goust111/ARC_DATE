+
+def _neighbors4(shape: tuple[int, int], cell: Coord) -> list[Coord]:
+    h, w = shape
+    r, c = cell
+    out: list[Coord] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
