+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def _neighbors4(shape: tuple[int, int], cell: Coord) -> list[Coord]:
+    h, w = shape
+    r, c = cell
+    out: list[Coord] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _collect_component(mask: np.ndarray, start: Coord, seen: np.ndarray) -> list[Coord]:
+    q: deque[Coord] = deque([start])
+    seen[start] = True
+    coords: list[Coord] = []
+    while q:
+        cell = q.popleft()
+        coords.append(cell)
+        for nbr in _neighbors4(mask.shape, cell):
+            if seen[nbr] or not bool(mask[nbr]):
+                continue
+            seen[nbr] = True
+            q.append(nbr)
+    return coords
+
