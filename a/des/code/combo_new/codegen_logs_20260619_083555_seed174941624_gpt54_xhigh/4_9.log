+def _build_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    pair_count = int(rng.choice(PAIR_COUNT_CHOICES))
+    width = int(rng.integers(*WIDTH_RANGE))
+    layout = _sample_layout(pair_count, rng)
+    if layout is None:
+        return None
+    height, band_specs = layout
