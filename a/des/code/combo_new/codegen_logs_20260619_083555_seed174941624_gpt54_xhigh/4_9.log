+    colors = [int(v) for v in rng.choice(np.array(PALETTE, dtype=int), size=pair_count, replace=False)]
+    branches = _choose_branches(pair_count, rng)
+    directions = [1 if rng.random() < 0.5 else -1 for _ in range(pair_count)]
