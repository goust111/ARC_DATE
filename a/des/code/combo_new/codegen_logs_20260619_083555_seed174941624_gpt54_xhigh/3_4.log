+    ordered = sorted(
+        windows,
+        key=lambda window: (window["h_anchor"][1], window["h_anchor"][0]),
+    )
+
+    crops = []
+    max_width = 0
+    total_height = 0
+    for window in ordered:
+        r0, r1, c0, c1 = window["rect"]
+        crop = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        for ar, ac in anchor_cells:
