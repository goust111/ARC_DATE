+                crop[ar - r0, ac - c0] = BLACK
+        assert crop.shape[0] >= 2 and crop.shape[1] >= 2
+        crops.append(crop)
+        max_width = max(max_width, int(crop.shape[1]))
+        total_height += int(crop.shape[0])
