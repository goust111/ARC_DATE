+
+    windows = []
+    used_positions = 0
+    for color, positions in border_positions.items():
+        assert len(positions) == 2, f"anchor color {color} must appear exactly twice on the border"
+        horizontal = [
+            (r, c)
+            for r, c in positions
+            if r in (0, h - 1) and c not in (0, w - 1)
+        ]
+        vertical = [
