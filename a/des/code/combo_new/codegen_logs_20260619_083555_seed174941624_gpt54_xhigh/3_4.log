+                "color": int(color),
+                "h_anchor": (int(hr), int(hc)),
+                "v_anchor": (int(vr), int(vc)),
+                "rect": (int(r0), int(r1), int(c0), int(c1)),
+            }
+        )
+        used_positions += 2
+
+    assert used_positions == sum(len(v) for v in border_positions.values())
+    return windows
