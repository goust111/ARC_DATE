+            inferred.append(ca)
+        elif counts[cb] < counts[ca]:
+            inferred.append(cb)
+        elif ca != bg and cb == bg:
+            inferred.append(ca)
+        elif cb != bg and ca == bg:
+            inferred.append(cb)
