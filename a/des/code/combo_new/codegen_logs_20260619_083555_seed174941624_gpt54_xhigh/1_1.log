+    "up": (0, 2),
+    "down": (4, 2),
+    "left": (2, 0),
+    "right": (2, 4),
+}
+
+VERTICAL_ORBITS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+HORIZONTAL_ORBITS = [
+    ((0, 0), (2, 0)),
+    ((0, 1), (2, 1)),
+    ((0, 2), (2, 2)),
+    ((1, 0),),
+    ((1, 1),),
+    ((1, 2),),
+]
+
+
+def _make_frame_template(gap_dir: str) -> np.ndarray:
+    template = np.zeros((FRAME_SIZE, FRAME_SIZE), dtype=bool)
+    template[0, :] = True
+    template[-1, :] = True
+    template[:, 0] = True
+    template[:, -1] = True
+    gr, gc = GAP_OFFSETS[gap_dir]
+    template[gr, gc] = False
+    return template
+
+
+FRAME_TEMPLATES = {gap_dir: _make_frame_template(gap_dir) for gap_dir in DIRS}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _match_frame_component(coords: list[tuple[int, int]]) -> str | None:
+    if len(coords) != 15:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 + 1 != FRAME_SIZE or c1 - c0 + 1 != FRAME_SIZE:
+        return None
+    local = np.zeros((FRAME_SIZE, FRAME_SIZE), dtype=bool)
+    for r, c in coords:
+        local[r - r0, c - c0] = True
