+        if not filled_pairs or filled_cells < 4 or filled_cells > 8:
+            continue
+        if axis == "vertical" and np.array_equal(pattern[0, :], pattern[2, :]):
+            continue
+        if axis == "horizontal" and np.array_equal(pattern[:, 0], pattern[:, 2]):
+            continue
