+def _make_frame_template(gap_dir: str) -> np.ndarray:
+    template = np.zeros((FRAME_SIZE, FRAME_SIZE), dtype=bool)
+    template[0, :] = True
+    template[-1, :] = True
+    template[:, 0] = True
+    template[:, -1] = True
+    gr, gc = GAP_OFFSETS[gap_dir]
+    template[gr, gc] = False
+    return template
