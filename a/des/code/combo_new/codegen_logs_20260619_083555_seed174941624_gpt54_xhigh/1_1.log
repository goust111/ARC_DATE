+BOX_PAD = 1
+PATTERN_RETRIES = 200
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GAP_OFFSETS = {
+    "up": (0, 2),
+    "down": (4, 2),
+    "left": (2, 0),
+    "right": (2, 4),
+}
+
+VERTICAL_ORBITS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+HORIZONTAL_ORBITS = [
+    ((0, 0), (2, 0)),
+    ((0, 1), (2, 1)),
+    ((0, 2), (2, 2)),
+    ((1, 0),),
+    ((1, 1),),
+    ((1, 2),),
+]
