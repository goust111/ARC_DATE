+
+        pattern = np.full((INNER_SIZE, INNER_SIZE), BG_COLOR, dtype=int)
+        filled_pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+        filled_cells = 0
+
+        for orbit in orbits:
+            if random.random() < 0.58:
+                for r, c in orbit:
+                    pattern[r, c] = major_color
+                    filled_cells += 1
+                if len(orbit) == 2:
+                    filled_pairs.append(orbit)  # type: ignore[arg-type]
