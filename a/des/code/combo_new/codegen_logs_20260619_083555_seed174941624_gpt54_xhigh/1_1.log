+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG_COLOR = 0
+FRAME_COLOR = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 18
+GRID_MAX = 30
+FRAME_COUNT_MIN = 2
+MAX_FRAME_COUNT_SMALL = 3
+MAX_FRAME_COUNT_LARGE = 4
+MAX_RETRIES = 500
+
+FRAME_SIZE = 5
+INNER_SIZE = 3
