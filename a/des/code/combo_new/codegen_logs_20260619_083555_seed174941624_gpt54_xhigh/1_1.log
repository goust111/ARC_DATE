+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG_COLOR = 0
+FRAME_COLOR = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 18
+GRID_MAX = 30
+FRAME_COUNT_MIN = 2
+MAX_FRAME_COUNT_SMALL = 3
+MAX_FRAME_COUNT_LARGE = 4
+MAX_RETRIES = 500
+
+FRAME_SIZE = 5
+INNER_SIZE = 3
+MIN_RAY_LEN = 2
+BOX_PAD = 1
+PATTERN_RETRIES = 200
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GAP_OFFSETS = {
+    "up": (0, 2),
+    "down": (4, 2),
+    "left": (2, 0),
+    "right": (2, 4),
+}
+
+VERTICAL_ORBITS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+HORIZONTAL_ORBITS = [
+    ((0, 0), (2, 0)),
+    ((0, 1), (2, 1)),
+    ((0, 2), (2, 2)),
+    ((1, 0),),
+    ((1, 1),),
+    ((1, 2),),
+]
