+        if np.array_equal(local, template):
+            return gap_dir
+    return None
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
