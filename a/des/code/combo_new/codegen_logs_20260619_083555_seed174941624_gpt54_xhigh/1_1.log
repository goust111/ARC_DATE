+    if random.random() < 0.5:
+        source = {"r": r_start, "c": c, "gap_dir": "down"}
+        target = {
+            "r": r_start + FRAME_SIZE + gap,
+            "c": c,
+            "gap_dir": random.choice(["left", "right", "down"]),
+        }
+    else:
+        target = {"r": r_start, "c": c, "gap_dir": random.choice(["left", "right", "up"])}
+        source = {
+            "r": r_start + FRAME_SIZE + gap,
+            "c": c,
+            "gap_dir": "up",
+        }
+    return [source, target]
