+        gr, gc = GAP_OFFSETS[frame["gap_dir"]]
+        dr, dc = DIRS[frame["gap_dir"]]
+        r = r0 + gr
+        c = c0 + gc
+
+        while 0 <= r < g.shape[0] and 0 <= c < g.shape[1] and not frame_mask[r, c]:
