+    for r in (0, h - 1):
+        row_vals = [int(v) for v in grid[r]]
+        for start, end in _edge_line_runs(row_vals, single_colors):
+            colors = row_vals[start : end + 1]
+            if 3 <= len(colors) <= 5 and len(set(colors)) == len(colors):
+                cells = {(r, c) for c in range(start, end + 1)}
