+def _trace_path(comp: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    if len(comp) == 1:
+        return comp[:]
+    pts = set(comp)
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in comp:
+        nbrs = []
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in pts:
+                nbrs.append((nr, nc))
+        assert len(nbrs) <= 2, "path cannot branch"
+        adj[(r, c)] = nbrs
