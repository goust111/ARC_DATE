+def _transform_box(box: np.ndarray, op: int) -> np.ndarray:
+    out = np.array(box, copy=True)
+    if op >= 4:
+        out = np.fliplr(out)
+        op -= 4
+    out = np.rot90(out, k=op)
+    return out
