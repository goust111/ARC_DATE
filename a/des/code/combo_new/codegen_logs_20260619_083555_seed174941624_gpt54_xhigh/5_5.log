+def _edge_line_runs(values: list[int], valid_colors: set[int]) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    while i < len(values):
+        if values[i] not in valid_colors:
+            i += 1
+            continue
+        start = i
+        while i + 1 < len(values) and values[i + 1] in valid_colors:
+            i += 1
+        runs.append((start, i))
+        i += 1
+    return runs
