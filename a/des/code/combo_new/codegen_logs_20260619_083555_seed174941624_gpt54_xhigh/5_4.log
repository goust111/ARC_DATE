+
+
+def _find_wall_and_rooms(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int, int]]]:
+    choices: list[tuple[tuple[int, int, int], int, list[tuple[int, int, int, int]]]] = []
