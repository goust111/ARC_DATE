+        vals = {int(v) for v in np.unique(g[r0 : r1 + 1, c0 : c1 + 1])}
+        if wall in vals or len(vals - {bg}) != 1:
+            return None
+        rooms.append(box)
+    if not rooms or not touched_boundary:
