AXIS_RATIO_RANGE = (0.35, 0.50)
SIDES = (-1, 1)

# Source rectangles and reflected corridors.
SOURCE_RECT_COUNT_RANGE = (2, 3)
RECT_HEIGHT_RANGE = (2, 5)
RECT_WIDTH_RANGE = (2, 4)
SOURCE_GAP_TO_AXIS_RANGE = (2, 5)
MIN_RECT_INTERVAL_GAP = 1

