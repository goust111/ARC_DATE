+            trial_blocked[r0 - 1 : r0 + spec["h"] + 1, c0 - 1 : c0 + spec["w"] + 1] = True
+            placed.append({"bbox": (r0, c0, r0 + spec["h"] - 1, c0 + spec["w"] - 1), "doors": spec["doors"]})
+
+        if ok:
+            grid[:, :] = trial_grid
+            blocked[:, :] = trial_blocked
+            return placed
+
+    return None
