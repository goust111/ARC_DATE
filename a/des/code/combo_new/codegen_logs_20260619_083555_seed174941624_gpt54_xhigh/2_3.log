+from __future__ import annotations
+
+import random
+from typing import List, Sequence, Tuple
+
+import numpy as np
+
+
+DIR4: tuple[tuple[int, int], ...] = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GRID_MIN = 22
+GRID_MAX = 30
+TEMPLATE_COUNT_RANGE = (2, 4)
+ROOM_OUTER_MIN = 5
