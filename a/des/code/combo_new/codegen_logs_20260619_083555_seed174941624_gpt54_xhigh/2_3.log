+    for spec in sorted(room_specs, key=lambda item: item["h"] * item["w"], reverse=True):
+        positions = _room_positions(blocked, spec["h"], spec["w"])
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        doors = _door_cells(spec["h"], spec["w"], spec["doors"], rng)
