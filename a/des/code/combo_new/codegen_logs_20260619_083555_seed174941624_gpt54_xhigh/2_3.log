+def _paint_rooms(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    wall: int,
+    room_specs: Sequence[dict],
+    rng: random.Random,
+) -> list[dict] | None:
+    ordered = sorted(room_specs, key=lambda item: item["h"] * item["w"], reverse=True)
+
+    for _ in range(80):
+        trial_grid = grid.copy()
+        trial_blocked = blocked.copy()
+        placed: list[dict] = []
+        ok = True
+
+        for spec in ordered:
+            positions = _room_positions(trial_blocked, spec["h"], spec["w"])
+            if not positions:
