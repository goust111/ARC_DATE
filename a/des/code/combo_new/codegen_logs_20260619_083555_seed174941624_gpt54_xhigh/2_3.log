+) -> list[dict] | None:
+    h, w = grid.shape
+    gap = rng.choice((1, 2))
+    outer_sizes = [(pat.shape[0] + 2, pat.shape[1] + 2) for pat in patterns]
+    total_w = sum(ow for _, ow in outer_sizes) + gap * (len(patterns) - 1)
+    max_h = max(oh for oh, _ in outer_sizes)
+    if total_w > w - 2 or max_h > h - 4:
+        return None
