+GRID_MIN = 22
+GRID_MAX = 30
+TEMPLATE_COUNT_RANGE = (2, 4)
+ROOM_OUTER_MIN = 5
+ROOM_OUTER_MAX = 7
+GEN_RETRIES = 300
