+        for dr, dc in doors:
+            grid[r0 + dr, c0 + dc] = spec["bg"]
+        blocked[r0 - 1 : r0 + spec["h"] + 1, c0 - 1 : c0 + spec["w"] + 1] = True
+        placed.append({"bbox": (r0, c0, r0 + spec["h"] - 1, c0 + spec["w"] - 1), "doors": spec["doors"]})
+    return placed
+
+
+def _expected_output(
+    inp: np.ndarray, patterns: Sequence[np.ndarray], rooms: Sequence[dict]
+) -> np.ndarray:
+    out = inp.copy()
+    for room in rooms:
+        doors = int(room["doors"])
+        if doors == 0:
+            continue
+        r0, c0, r1, c1 = room["bbox"]
