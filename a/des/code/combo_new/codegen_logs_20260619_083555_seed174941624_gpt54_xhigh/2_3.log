+    templates.sort(key=lambda item: (item["bbox"][1], item["bbox"][0]))
+    return templates
+
+
+def _count_side_doors(side: np.ndarray, wall: int, bg: int) -> int | None:
+    if side.size == 0:
+        return None
+    if not np.all((side == wall) | (side == bg)):
+        return None
+    gaps = side == bg
+    if gaps.size > 1 and np.any(gaps[:-1] & gaps[1:]):
+        return None
