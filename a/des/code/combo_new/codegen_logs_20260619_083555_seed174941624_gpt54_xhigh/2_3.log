+        grid[r0 + 1 : r0 + oh - 1, c0 + 1 : c0 + ow - 1] = pattern
+        rr0 = max(0, r0 - 1)
+        rr1 = min(h, r0 + oh + 1)
+        cc0 = max(0, c0 - 1)
+        cc1 = min(w, c0 + ow + 1)
+        blocked[rr0:rr1, cc0:cc1] = True
+        placed.append({"bbox": (r0, c0, r0 + oh - 1, c0 + ow - 1), "pattern": pattern.copy()})
+        cur_c += ow + gap
