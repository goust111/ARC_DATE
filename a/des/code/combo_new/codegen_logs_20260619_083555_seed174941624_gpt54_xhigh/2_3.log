+    bg = _mode_color(g)
+    non_bg = g[g != bg]
+    assert non_bg.size > 0, "expected walls and templates"
+    vals, cnts = np.unique(non_bg, return_counts=True)
+    wall = int(vals[np.argmax(cnts)])
