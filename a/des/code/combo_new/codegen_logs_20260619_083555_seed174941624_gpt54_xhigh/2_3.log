+    if kind == "solid":
+        return np.full((h, w), c1, dtype=int)
+    if kind == "checker":
+        return np.where((rr + cc) % 2 == 0, c1, bg).astype(int)
+    if kind == "vstripe":
+        return np.where(cc % 2 == 0, c1, bg).astype(int)
+    if kind == "hstripe":
+        return np.where(rr % 2 == 0, c1, bg).astype(int)
+    if kind == "diag":
+        return np.where((rr + cc) % 3 == 0, c1, bg).astype(int)
+    if kind == "two_color":
