+            placed.append({"bbox": (r0, c0, r0 + spec["h"] - 1, c0 + spec["w"] - 1), "doors": spec["doors"]})
+
+        if ok:
+            grid[:, :] = trial_grid
+            blocked[:, :] = trial_blocked
+            return placed
+
+    return None
+
+
+def _expected_output(
+    inp: np.ndarray, patterns: Sequence[np.ndarray], rooms: Sequence[dict]
+) -> np.ndarray:
+    out = inp.copy()
