+def _find_templates(grid: np.ndarray, bg: int, wall: int) -> list[dict]:
+    wall_mask = grid == wall
+    templates: list[dict] = []
+    for coords in _components(wall_mask):
+        if not _component_is_full_frame(wall_mask, coords):
+            continue
+        r0, c0, r1, c1 = _bbox(coords)
+        inner = grid[r0 + 1 : r1, c0 + 1 : c1]
