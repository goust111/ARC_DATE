+    wall_count = int(cnts[vals == wall][0]) if np.any(vals == wall) else -1
+    if wall_count < 0:
+        return False
+    other_counts = [int(cnt) for val, cnt in zip(vals, cnts) if int(val) != wall]
+    return all(wall_count > cnt for cnt in other_counts)
