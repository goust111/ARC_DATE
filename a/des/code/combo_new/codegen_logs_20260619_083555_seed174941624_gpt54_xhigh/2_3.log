+    return out
+
+
+def _wall_is_unique_non_bg_mode(grid: np.ndarray, bg: int, wall: int) -> bool:
+    vals, cnts = np.unique(grid[grid != bg], return_counts=True)
+    if vals.size == 0:
+        return False
+    wall_count = int(cnts[vals == wall][0]) if np.any(vals == wall) else -1
+    if wall_count < 0:
