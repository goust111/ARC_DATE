+def _draw_box_border(grid: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> None:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _paint_templates(
+    grid: np.ndarray,
