+    return int(ps[r1 + 1, c1 + 1] - ps[r0, c1 + 1] - ps[r1 + 1, c0] + ps[r0, c0])
+
+
+def _component_is_full_frame(wall_mask: np.ndarray, coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
