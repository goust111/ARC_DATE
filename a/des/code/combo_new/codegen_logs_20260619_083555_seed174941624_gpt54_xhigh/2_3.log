+
+
+def _door_cells(room_h: int, room_w: int, door_count: int, rng: random.Random) -> list[tuple[int, int]] | None:
+    candidates = []
+    for c in range(1, room_w - 1):
+        candidates.append(("top", c, (0, c)))
+        candidates.append(("bottom", c, (room_h - 1, c)))
