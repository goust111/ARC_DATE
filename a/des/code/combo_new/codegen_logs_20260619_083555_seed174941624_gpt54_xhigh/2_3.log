+
+def _find_rooms(grid: np.ndarray, bg: int, wall: int) -> list[tuple[int, int, int, int, int]]:
+    h, w = grid.shape
+    non_bg_ps = _prefix(grid != bg)
+    rooms: list[tuple[int, int, int, int, int]] = []
