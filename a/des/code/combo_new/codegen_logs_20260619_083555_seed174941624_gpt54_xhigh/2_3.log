+def _tile_pattern(pattern: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    ph, pw = pattern.shape
+    h, w = shape
+    reps = ((h + ph - 1) // ph, (w + pw - 1) // pw)
