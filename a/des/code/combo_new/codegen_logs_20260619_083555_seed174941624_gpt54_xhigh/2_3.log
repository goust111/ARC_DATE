+    return placed
+
+
+def _room_positions(blocked: np.ndarray, room_h: int, room_w: int) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    positions: list[tuple[int, int]] = []
+    for r0 in range(1, h - room_h):
+        for c0 in range(1, w - room_w):
