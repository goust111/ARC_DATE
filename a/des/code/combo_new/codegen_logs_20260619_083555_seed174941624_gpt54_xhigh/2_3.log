+        return False
+    sub = wall_mask[r0 : r1 + 1, c0 : c1 + 1]
+    expect = np.zeros_like(sub, dtype=bool)
+    expect[0, :] = True
+    expect[-1, :] = True
+    expect[:, 0] = True
+    expect[:, -1] = True
