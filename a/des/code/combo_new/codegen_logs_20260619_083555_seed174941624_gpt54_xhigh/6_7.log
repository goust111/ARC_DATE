+def _bands(lines: list[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    for a, b in zip(lines, lines[1:]):
+        assert b - a >= 2, "wall lines must leave a non-empty room band"
+        bands.append((int(a + 1), int(b - 1)))
+    return bands
