+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+VERTICAL_DOOR_COLORS = (2, 3)
+HORIZONTAL_DOOR_COLORS = (4, 6)
+GENERATION_RETRIES = 400
+SHAPE_RETRIES = 40
+PLACEMENT_RETRIES = 60
