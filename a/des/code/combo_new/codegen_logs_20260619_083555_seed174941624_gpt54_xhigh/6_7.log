+        color = int(HORIZONTAL_DOOR_COLORS[(wall_idx - 1) % len(HORIZONTAL_DOOR_COLORS)])
+        for c0, c1 in col_bands:
+            gap_c = int(rng.randint(c0 + 1, c1 - 1))
