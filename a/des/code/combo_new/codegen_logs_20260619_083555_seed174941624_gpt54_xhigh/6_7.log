+        right_room_col = int(wall_idx)
+        for room_row, (r0, r1) in enumerate(row_bands):
+            matches: list[tuple[int, int]] = []
+            for r in range(r0 + 1, r1):
+                if int(grid[r, c]) != BLACK:
