+    grid = _place_objects(base_grid, rooms, selections, rng)
+    if grid is None:
+        return None
+
+    out = main(grid)
+    if np.array_equal(grid, out):
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
