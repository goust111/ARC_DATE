+    row_bands: list[tuple[int, int]],
+    col_bands: list[tuple[int, int]],
+) -> tuple[list[dict], dict[tuple[int, int], list[dict]]]:
+    room_doors = {room_id: [] for room_id in rooms}
+    doors: list[dict] = []
