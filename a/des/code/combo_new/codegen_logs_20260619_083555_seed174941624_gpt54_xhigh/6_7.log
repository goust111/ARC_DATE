+def _find_wall_lines(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    h, w = grid.shape
+    row_counts = np.count_nonzero(grid != BLACK, axis=1)
+    col_counts = np.count_nonzero(grid != BLACK, axis=0)
+
+    wall_rows = [
+        int(r)
+        for r in range(h)
+        if int(grid[r, 0]) == BLUE and int(grid[r, w - 1]) == BLUE and int(row_counts[r]) > w // 2
