        patch_out[shell] = seed_color

        seed_cells = np.argwhere(inner_patch)
        seed_r, seed_c = map(int, seed_cells[rng.randrange(len(seed_cells))])
        patch_in[seed_r, seed_c] = seed_color
        patch_out[seed_r, seed_c] = GREY
