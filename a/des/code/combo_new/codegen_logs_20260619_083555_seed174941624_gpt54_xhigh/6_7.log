+        start = (int(rng.randrange(box_h)), int(rng.randrange(box_w)))
+        cells = {start}
+        while len(cells) < target:
+            frontier: list[tuple[int, int]] = []
+            for r, c in cells:
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
