+def _select_sources(
+    rng: random.Random,
+    doors: list[dict],
+    room_count: int,
+    kind: str,
+) -> list[tuple[tuple[int, int], dict]] | None:
+    door_by_id = {int(door["id"]): door for door in doors}
+    oriented = []
+    for door in doors:
