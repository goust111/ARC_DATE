+        assert b - a >= 2, "wall lines must leave a non-empty room band"
+        bands.append((int(a + 1), int(b - 1)))
+    return bands
+
+
+def _find_wall_lines(grid: np.ndarray) -> tuple[list[int], list[int]]:
