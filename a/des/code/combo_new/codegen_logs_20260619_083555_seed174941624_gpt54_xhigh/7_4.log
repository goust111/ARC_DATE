+            grid[marker_a] = marker_color_a
+            grid[marker_b] = marker_color_b
+
+            return {
+                "forbidden": forbidden | _inflate(placed_reserved, h, w),
+                "gap_cells": placed_gap,
+                "fill_color": fill_color,
+            }
+    return None
+
