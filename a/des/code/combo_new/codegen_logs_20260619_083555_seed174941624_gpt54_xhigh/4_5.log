+        local_r1, local_r2 = 0, h1 - overlap_h
+    else:
+        local_r1, local_r2 = h2 - overlap_h, 0
+
+    if col_sign == 1:
+        local_c1, local_c2 = 0, w1 - overlap_w
+    else:
+        local_c1, local_c2 = w2 - overlap_w, 0
