+    h1: int,
+    w1: int,
+    h2: int,
+    w2: int,
+    overlap_h: int,
+    overlap_w: int,
+    row_sign: int,
+    col_sign: int,
+    top: int,
+    left: int,
+) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]]:
