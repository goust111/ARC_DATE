+
+BACKGROUND = 0
+YELLOW = 4
+OVERLAP = 5
+BASE_COLORS = (1, 2, 3, 6, 7, 8, 9)
+MAX_PERIOD = 3
+GENERATION_RETRIES = 400
+
+PATTERN_LIBRARY = (
+    np.array([[1, 0], [0, 1]], dtype=int),
+    np.array([[0, 1], [1, 0]], dtype=int),
