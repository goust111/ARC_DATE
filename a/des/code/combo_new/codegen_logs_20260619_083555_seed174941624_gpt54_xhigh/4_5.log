+    box1 = (top + local_r1, left + local_c1, top + local_r1 + h1 - 1, left + local_c1 + w1 - 1)
+    box2 = (top + local_r2, left + local_c2, top + local_r2 + h2 - 1, left + local_c2 + w2 - 1)
+    return box1, box2
