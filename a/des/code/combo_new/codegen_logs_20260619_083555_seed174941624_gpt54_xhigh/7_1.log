+            int(obj["reserve_bbox"][2]) - int(obj["reserve_bbox"][0]) + 1,
+            int(obj["reserve_bbox"][3]) - int(obj["reserve_bbox"][1]) + 1,
+        )
+        for obj in objects
+    ]
