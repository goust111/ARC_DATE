+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDES = ("top", "bottom", "left", "right")
+
+# Generator tuning.
+GEN_RETRIES = 300
+OBJECT_RETRIES = 60
+PACK_RETRIES = 80
+PLACE_RETRIES = 200
+OBJECT_COUNT_CHOICES = (1, 2, 3, 4)
+INNER_MIN = 4
+RESERVE_GAP = 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    """Return 4-connected components from a boolean mask."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        seen[rr, cc] = True
+        queue = deque([(rr, cc)])
+        pts: list[tuple[int, int]] = []
+        while queue:
+            cr, cc = queue.popleft()
+            pts.append((cr, cc))
+            for dr, dc in DIR4:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_points(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0, r1 + 1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
+
+
+def _touching_sides(shape_mask: np.ndarray) -> list[str]:
+    sides: list[str] = []
+    if shape_mask[0, :].any():
+        sides.append("top")
+    if shape_mask[-1, :].any():
+        sides.append("bottom")
+    if shape_mask[:, 0].any():
+        sides.append("left")
+    if shape_mask[:, -1].any():
+        sides.append("right")
+    return sides
+
+
+def _project_cell(
+    r: int,
+    c: int,
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    side: str,
+) -> tuple[int, int]:
+    if side == "top":
+        return 2 * r0 - r, c
+    if side == "bottom":
+        return 2 * r1 - r, c
+    if side == "left":
+        return r, 2 * c0 - c
+    if side == "right":
+        return r, 2 * c1 - c
+    raise ValueError(f"unknown side: {side}")
+
+
+def _try_parse_fence(
+    grid: np.ndarray, points: list[tuple[int, int]], fence_color: int
+) -> dict[str, object] | None:
+    r0, c0, r1, c1 = _bbox(points)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    border = _perimeter_points(r0, c0, r1, c1)
+    if len(points) != len(border) or set(points) != border:
+        return None
+
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if inner.size == 0 or not np.any(inner == BACKGROUND):
+        return None
+
+    shape_colors = set(map(int, np.unique(inner))) - {BACKGROUND}
+    if len(shape_colors) != 1:
+        return None
+
+    shape_color = int(next(iter(shape_colors)))
+    shape_mask = inner == shape_color
+    comps = _components(shape_mask)
+    if len(comps) != 1:
+        return None
+
+    sides = _touching_sides(shape_mask)
+    if len(sides) != 1:
+        return None
+
+    shape_abs = [(r0 + 1 + r, c0 + 1 + c) for r, c in comps[0]]
+    return {
+        "fence_color": fence_color,
+        "shape_color": shape_color,
+        "bbox": (r0, c0, r1, c1),
+        "side": sides[0],
+        "shape_abs": shape_abs,
+        "covered": border | set(shape_abs),
+    }
+
+
+def _find_fences(grid: np.ndarray) -> list[dict[str, object]]:
+    infos: list[dict[str, object]] = []
+    covered: set[tuple[int, int]] = set()
+    for color in sorted(set(map(int, grid.flat)) - {BACKGROUND}):
+        for points in _components(grid == color):
+            info = _try_parse_fence(grid, points, int(color))
+            if info is None:
