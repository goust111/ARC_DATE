+        canvas_w = max(bw, ww) + margin_c + margin_d + extra
+        if canvas_h > 30 or canvas_w > 30:
+            return None
+        board_y = margin_a if not swapped else margin_a + wh + gap
+        window_y = margin_a + bh + gap if not swapped else margin_a
