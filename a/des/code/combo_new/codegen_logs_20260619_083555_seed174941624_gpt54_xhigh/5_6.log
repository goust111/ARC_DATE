+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _gap_side(border_mask: np.ndarray) -> str | None:
+    h, w = border_mask.shape
+    if h < 3 or w < 3:
+        return None
+    if np.any(border_mask[1:-1, 1:-1]):
+        return None
+    if not (
+        border_mask[0, 0]
+        and border_mask[0, -1]
+        and border_mask[-1, 0]
+        and border_mask[-1, -1]
+    ):
+        return None
+
+    sides = {
+        "up": border_mask[0, 1:-1],
+        "down": border_mask[-1, 1:-1],
+        "left": border_mask[1:-1, 0],
+        "right": border_mask[1:-1, -1],
+    }
+    missing_side: str | None = None
+    for name, arr in sides.items():
+        missing = np.flatnonzero(~arr)
+        if missing.size == 0:
+            continue
+        if missing.size not in (2, 3):
+            return None
+        if int(missing[-1] - missing[0] + 1) != int(missing.size):
+            return None
+        if missing_side is not None:
+            return None
+        missing_side = name
+    if missing_side is None:
+        return None
+    for name, arr in sides.items():
+        if name == missing_side:
+            continue
+        if not np.all(arr):
+            return None
+    return missing_side
+
