+    for label, (r, c) in enumerate(seeds):
+        labels[r, c] = label
+
+    frontier = []
+    for label, (r, c) in enumerate(seeds):
+        for nr, nc in _neighbors4(r, c, h, w):
+            if labels[nr, nc] == -1:
+                frontier.append((label, nr, nc))
+
+    while (labels == -1).any():
+        frontier = [(label, r, c) for label, r, c in frontier if labels[r, c] == -1]
+        if not frontier:
+            return None
+        label, r, c = random.choice(frontier)
+        labels[r, c] = label
+        for nr, nc in _neighbors4(r, c, h, w):
+            if labels[nr, nc] == -1:
+                frontier.append((label, nr, nc))
