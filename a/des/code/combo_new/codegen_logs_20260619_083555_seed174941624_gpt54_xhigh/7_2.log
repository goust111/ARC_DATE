+    sh, sw = sprite.shape
+    positions = []
+    for r in range(h - sh + 1):
+        for c in range(w - sw + 1):
+            r0 = max(0, r - 1)
+            r1 = min(h, r + sh + 1)
+            c0 = max(0, c - 1)
+            c1 = min(w, c + sw + 1)
+            if not blocked[r0:r1, c0:c1].any():
