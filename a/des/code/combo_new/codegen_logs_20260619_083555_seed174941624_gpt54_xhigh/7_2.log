+FRAGMENT_COUNT_MAX = 4
+INPUT_MIN_SIZE = 14
+INPUT_MAX_SIZE = 28
+PARTITION_TRIES = 80
+PLACEMENT_TRIES = 120
+GENERATION_TRIES = 400
