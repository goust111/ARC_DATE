+            return None
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        sprite[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        if int(sprite.sum()) != sprite.shape[0] * sprite.shape[1]:
+            irregular = True
+        pieces.append(sprite)
