+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MIN_GAP = 4
+MAX_GENERATE_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Segment:
+    color: int
+    axis: str
+    fixed: int
+    start: int
+    end: int
+
+
