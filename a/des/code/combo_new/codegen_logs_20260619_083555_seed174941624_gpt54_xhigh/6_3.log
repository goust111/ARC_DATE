    id2pts: dict[int, set[tuple[int, int]]] = {}
    for nd in nodes:
        nid = int(nd["id"])
        pts = set(nd["pts"])
        id2pts[nid] = pts
        for p in pts:
            pix2node[p] = nid

    # --- build edges from track components that touch exactly 2 nodes (8-adjacency) ---
    track_comps = components_mask(g == int(track_color), connectivity=8)
