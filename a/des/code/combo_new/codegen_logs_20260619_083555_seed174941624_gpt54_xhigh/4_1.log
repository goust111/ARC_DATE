+    max_template_h = max(t.shape[0] for t in legend_templates)
+    total_h = main_h + 4 + max_template_h
+    if total_h > 30:
+        return None
+
+    grid = np.zeros((total_h, grid_w), dtype=int)
+    if not _place_frames(grid, main_h, frame_specs, rng):
+        return None
+
+    sep = main_h
+    grid[sep, :] = SEP_COLOR
