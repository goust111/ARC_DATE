+    used_boxes: list[tuple[int, int, int, int]] = []
+    force_edge_first = bool(edge_candidates) and rng.random() < 0.5
+
+    for idx in range(want):
+        if idx == 0 and force_edge_first:
+            pools = [edge_candidates, interior_candidates]
+        else:
