+def _bbox_with_margin(points: set[tuple[int, int]], margin: int) -> tuple[int, int, int, int]:
+    rows, cols = zip(*points)
+    return min(rows) - margin, min(cols) - margin, max(rows) + margin, max(cols) + margin
