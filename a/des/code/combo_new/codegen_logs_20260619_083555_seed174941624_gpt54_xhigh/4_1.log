+    legend_gaps = [rng.randint(1, 3) for _ in range(len(legend_order) + 1)]
+    need_w = max(sum(legend_gaps) + sum(t.shape[1] for t in legend_templates), max(spec["w"] for spec in frame_specs) + 2, 18)
