+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    num_colors = rng.randint(2, 4)
+    legend_colors = rng.sample(FRAME_COLOR_POOL, num_colors)
+    frame_color_set = set(legend_colors)
