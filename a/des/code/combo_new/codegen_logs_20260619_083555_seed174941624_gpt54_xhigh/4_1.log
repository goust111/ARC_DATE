+    for color in sorted(set(map(int, np.unique(grid))) - {BG}):
+        mask = grid == color
+        for pts in _components(mask):
+            r0, c0, r1, c1 = _bbox(pts)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
