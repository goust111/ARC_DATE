+    frame_specs: list[dict],
+    rng: random.Random,
+) -> bool:
+    occupied: list[tuple[int, int, int, int]] = []
+    order = sorted(range(len(frame_specs)), key=lambda i: frame_specs[i]["h"] * frame_specs[i]["w"], reverse=True)
+    for idx in order:
+        spec = frame_specs[idx]
+        h = spec["h"]
+        w = spec["w"]
+        placed = False
+        for _ in range(250):
