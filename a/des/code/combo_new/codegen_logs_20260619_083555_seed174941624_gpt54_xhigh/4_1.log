+    out = np.zeros(mask.shape, dtype=int)
+    cells = list(map(tuple, np.argwhere(mask)))
+    rng.shuffle(cells)
+    for idx, (r, c) in enumerate(cells):
+        if idx < len(palette):
+            out[r, c] = palette[idx]
+        else:
+            out[r, c] = rng.choice(palette)
+    return out
+
