+        first_cell = (uncovered & -uncovered).bit_length() - 1
+        moves: list[tuple[int, int]] = []
+        for i in range(n):
+            if not ((unused_mask >> i) & 1):
+                continue
+            for cover in piece_opts[i].get(first_cell, ()):
+                if cover & ~uncovered:
+                    continue
+                moves.append((i, int(cover)))
+        if not moves:
+            return
