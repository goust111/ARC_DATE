+        pieces.append(_crop_component([tuple(map(int, pt)) for pt in np.argwhere(mask)]))
+    return pieces
+
+
+def _generate_piece_masks(n_pieces: int) -> tuple[list[np.ndarray], int, int] | None:
+    for _ in range(200):
