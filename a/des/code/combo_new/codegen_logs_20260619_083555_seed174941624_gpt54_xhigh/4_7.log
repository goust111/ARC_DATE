+
+BG = 0
+MARKER_COLOR = 9
+PIECE_COLORS = (1, 2, 3, 4, 5, 6, 7, 8)
+MARKER_BASE = np.array(
+    [
+        [0, 0, 0],
+        [1, 0, 0],
+        [1, 1, 0],
+    ],
+    dtype=int,
+)
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
