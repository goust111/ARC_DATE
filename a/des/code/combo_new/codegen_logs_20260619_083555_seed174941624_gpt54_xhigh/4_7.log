+                else:
+                    out[r, c] = int(seg["b"])
+        else:
+            r = int(seg["line"])
+            for c in picks:
+                if push_forward:
+                    out[r + 1, c] = int(seg["a"])
+                else:
+                    out[r, c] = int(seg["b"])
