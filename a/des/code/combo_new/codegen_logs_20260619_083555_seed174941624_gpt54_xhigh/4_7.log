+
+def _solve_rectangle_dims(piece_masks: list[np.ndarray]) -> tuple[int, int]:
+    pieces = sorted((_piece_data(mask) for mask in piece_masks), key=lambda d: (-d["area"], -d["h"], -d["w"]))
