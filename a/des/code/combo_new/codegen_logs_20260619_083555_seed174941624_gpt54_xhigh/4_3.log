+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _bbox_height(bbox: tuple[int, int, int, int]) -> int:
+    return bbox[2] - bbox[0] + 1
+
