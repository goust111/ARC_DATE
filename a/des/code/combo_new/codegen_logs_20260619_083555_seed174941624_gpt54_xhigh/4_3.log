+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
+    )
+
+
+def _find_components(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
