+    rectangles: list[np.ndarray] = []
+    pieces: list[dict] = []
+    areas: set[int] = set()
+    total_piece_area = 0
+
+    for i in range(pair_count):
+        pair = _build_pair(color_pool[2 * i], color_pool[2 * i + 1])
+        if pair is None:
