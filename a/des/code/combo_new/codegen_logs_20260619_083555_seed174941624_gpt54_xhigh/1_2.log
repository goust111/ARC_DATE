+        grid_h = GRID_SIDE_RANGE[0]
+    if grid_w < GRID_SIDE_RANGE[0]:
+        grid_w = GRID_SIDE_RANGE[0]
+    grid_h = min(grid_h, ARC_MAX)
+    grid_w = min(grid_w, ARC_MAX)
+
+    grid = _scatter_pieces(pieces, grid_h, grid_w)
