+
+
+def _build_pair(color_a: int, color_b: int) -> tuple[dict, dict, np.ndarray] | None:
+    rect_h = _RNG.randint(*RECT_SIDE_RANGE)
+    rect_w = _RNG.randint(*RECT_SIDE_RANGE)
