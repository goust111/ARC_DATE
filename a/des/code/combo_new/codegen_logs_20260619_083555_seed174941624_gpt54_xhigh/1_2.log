+    merged = list(options.values())
+    merged.sort(key=_rectangle_order_key)
+    return merged
+
+
+def _enumerate_pairings(fragments: list[dict], limit: int | None = None) -> list[list[np.ndarray]]:
+    n = len(fragments)
