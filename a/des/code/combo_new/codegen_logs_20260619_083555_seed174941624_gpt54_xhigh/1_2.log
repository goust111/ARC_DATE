参考题里生成器普遍是“先构造合法输出/约束，再反推输入并用 oracle 验证”，我现在把这几份 `main` 和 `generate_input` 的具体实现片段读完，避免新题生成器出现退化样例或隐式假设漏检。
exec
/bin/bash -c "python - <<'PY'
import ast, pathlib
paths = [
'/home/lixinyu/snap/new/ARC_code/train/d749d46f.py',
'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py',
'/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py',
'/home/lixinyu/snap/new/ARC_code/train/2601afb7.py',
'/home/lixinyu/snap/new/ARC_code/train/57edb29d.py',
'/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py',
'/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py',
'/home/lixinyu/snap/new/ARC_code/train/a1aa0c1e.py',
]
for path in paths:
    src = pathlib.Path(path).read_text()
    tree = ast.parse(src)
    print('\\n###', path)
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name in ('main','generate_input'):
            end = getattr(node, 'end_lineno', None)
            print(node.name, node.lineno, end)
