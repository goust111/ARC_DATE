    assert b is not None
    r0, c0, r1, c1 = b
    height = int(r1 - r0 + 1)
    width = int(c1 - c0 + 1)
    assert height > 1 and width > 1
    assert int(mask.sum()) == height * width
    assert bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1]))
