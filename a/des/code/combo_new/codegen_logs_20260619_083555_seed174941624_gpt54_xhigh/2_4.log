    r: int,
    c: int,
    dr: int,
    dc: int,
    fillable: set[int],
) -> None:
    H, W = map(int, g.shape)
    while 0 <= r < H and 0 <= c < W:
        value = int(g[r, c])
        if value == _BLOCK_COLOR:
            break
        assert value == _SOURCE_COLOR or value in fillable
        if value != _SOURCE_COLOR:
