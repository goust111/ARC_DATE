+
+    return grid
+
+
+def _valid_growth_profile(grid: np.ndarray) -> bool:
+    root, seeds, adj = _track_graph(grid)
+    order = _leaf_order(root, seeds, adj)
+    lengths = [len(_leaf_branch_cells(seed, root, adj)) for seed in order]
+    if not lengths:
