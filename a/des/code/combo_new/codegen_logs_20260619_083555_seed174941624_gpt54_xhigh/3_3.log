+    for k in choices:
+        inc = k - 1
+        score = 1.0
+        if inc > 0:
+            score += 2.0
+        if inc == desired_inc:
+            score += 2.0
+        if k == 3:
+            score += 0.5
+        if need > 0 and inc == 0:
+            score *= 0.25
+        scores.append(score)
+    return _weighted_choice(choices, scores)
