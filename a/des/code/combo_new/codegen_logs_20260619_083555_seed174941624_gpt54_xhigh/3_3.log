+def _extension_options(adj: dict[Cell, set[Cell]], occupied: set[Cell], leaf: Cell, h: int, w: int) -> list[tuple[Cell, int]]:
+    parent = _leaf_parent(adj, leaf)
+    blocked = None
+    if parent is not None:
+        blocked = (parent[0] - leaf[0], parent[1] - leaf[1])
