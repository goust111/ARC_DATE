+    return (random.randint(1, h - 2), w - 1), (0, -1)
+
+
+def _max_straight_len(start: Cell, direction: Cell, h: int, w: int, occupied: set[Cell]) -> int:
+    steps = 0
+    r, c = start
+    dr, dc = direction
+    while True:
