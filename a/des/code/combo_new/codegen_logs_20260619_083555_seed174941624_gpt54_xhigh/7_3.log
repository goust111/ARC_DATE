+    for _ in range(SHAPE_RETRIES):
+        if len(shapes) == count:
+            areas = [int(shape.sum()) for shape in shapes]
+            if require_shared_area and len(set(areas)) == len(areas):
+                shapes = []
+                seen.clear()
+                continue
+            return shapes
+        shape = _generate_base_shape()
+        if shape is None:
+            continue
+        key = _canonical_shape_key(shape)
+        if key in seen:
