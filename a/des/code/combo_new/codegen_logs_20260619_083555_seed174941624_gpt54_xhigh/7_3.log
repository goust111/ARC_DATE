0096: def main(grid: np.ndarray) -> np.ndarray:
0097:     """Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.
0098: 
0099:     Input structure
0100:     - The grid contains hollow red square frames connected pairwise by blue line components.
0101:     - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.
0102:     - Each frame interior contains background plus exactly one non-background color mask.
0103: 
0104:     Rule
0105:     - Sort the red frames clockwise by their centers around the cycle.
0106:     - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.
0107:     - Leave the red frames, blue connectors, background, and interior background holes unchanged.
0108: 
0109:     Key insight
0110:     - The colored masks do not move; the blue cycle gives the order in which their colors rotate.
0111:     """
0112:     g = np.asarray(grid, dtype=int)
0113:     bg = get_bg(g)
0114:     frames, red_components = _extract_frames(g, bg)
0115:     edges = _blue_cycle_edges(g, red_components)
0116:     order = _clockwise_order(frames, edges)
0117: 
0118:     out = g.copy()
0119:     for k, frame_id in enumerate(order):
0120:         next_id = order[(k + 1) % len(order)]
0121:         r0, c0, r1, c1 = frames[frame_id]["bbox"]
0122:         interior = out[r0 + 1 : r1, c0 + 1 : c1]
0123:         interior[frames[frame_id]["mask"]] = frames[next_id]["color"]
0124:     return out
