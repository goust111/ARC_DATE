+        positions = _place_patches(patches, H, W, LOCK_GAP)
+        if positions is None:
+            continue
+        grid = _paint_scene(patches, positions, H, W)
+        try:
+            out = _solve(grid)
+        except Exception:
+            continue
+        if np.array_equal(out, grid):
