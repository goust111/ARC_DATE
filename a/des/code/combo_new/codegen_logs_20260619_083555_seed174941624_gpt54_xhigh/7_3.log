+    assert locks, "expected at least one lock"
+    assert len(keys) == len(locks), "keys and locks must be paired one-to-one"
+
+    assignment = _match_locks_to_keys(locks, keys)
+
+    out = g.copy()
+    for key in keys:
+        for r, c in key["coords"]:
+            out[r, c] = bg
+
+    for li, ki in assignment.items():
+        lock = locks[li]
