+            continue
+        hole = np.zeros_like(mask, dtype=bool)
+        for hr, hc in pts:
+            hole[hr, hc] = True
+        holes.append(hole)
+    return holes
+
+
+def _scene_objects(grid: np.ndarray, bg: int) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
+    keys: list[dict[str, object]] = []
+    locks: list[dict[str, object]] = []
