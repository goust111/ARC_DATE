0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Expand each input pixel into a miniature same-color mask of the whole grid.
0009: 
0010:     Input structure
0011:     - The input is a non-empty two-dimensional grid of foreground colors.
0012:     - Black is reserved for the empty/background pixels introduced in the expanded output.
0013:     - The output has one input-shaped block for each input pixel.
0014: 
0015:     Rule
0016:     - For every input pixel with color c, replace that pixel by a block the same shape as the input.
0017:     - Inside the block, write c exactly where the original input also has color c.
0018:     - Write black everywhere else in the block.
0019: 
0020:     Key insight
0021:     Each pixel selects the global mask of its own color; the result is the blockwise self-mask of the grid.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0025:     assert np.all(g != 0), "input uses foreground colors; black is output background"
0026: 
0027:     h, w = g.shape
0028:     masks = {int(color): np.where(g == int(color), int(color), 0) for color in np.unique(g)}
0029: 
0030:     out = np.zeros((h * h, w * w), dtype=int)
0031:     for r in range(h):
0032:         for c in range(w):
0033:             out[r * h : (r + 1) * h, c * w : (c + 1) * w] = masks[int(g[r, c])]
0034:     return out
