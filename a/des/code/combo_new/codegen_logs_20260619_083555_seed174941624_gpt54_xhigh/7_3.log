+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        seen[rr, cc] = True
+        queue = deque([(rr, cc)])
+        pts: list[tuple[int, int]] = []
+        while queue:
+            cr, cc = queue.popleft()
+            pts.append((cr, cc))
+            for dr, dc in dirs:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
