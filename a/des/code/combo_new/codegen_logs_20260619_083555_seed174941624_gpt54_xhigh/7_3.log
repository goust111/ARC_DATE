+def _make_lock_patch(cavity_mask: np.ndarray, lock_color: int) -> np.ndarray | None:
+    h, w = cavity_mask.shape
+    cavity = np.zeros((h + 2, w + 2), dtype=bool)
+    cavity[1 : h + 1, 1 : w + 1] = cavity_mask
