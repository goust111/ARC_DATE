+                anchors = [pt for pt in coords if pt[1] == anchor_col and pt[0] % 2 == parity]
+                if len(anchors) != 1:
+                    ok = False
+                    break
+                anchor = anchors[0]
+                other = coords[0] if coords[1] == anchor else coords[1]
+                dr = other[0] - anchor[0]
+                dc = other[1] - anchor[1]
+                if abs(dr) + abs(dc) != 1:
+                    ok = False
+                    break
+                mapping[color] = (int(dr), int(dc))
+            if ok:
+                candidates.append(mapping)
