+        length = int(np.count_nonzero(interior == bg))
+        dr, dc = direction_by_color[color]
+        for step in range(1, length + 1):
+            nr = seed_r + dr * step
+            nc = seed_c + dc * step
+            if not (0 <= nr < h and 0 <= nc < w):
+                break
+            out[nr, nc] = color
+
