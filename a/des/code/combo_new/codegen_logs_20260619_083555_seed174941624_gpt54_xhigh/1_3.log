+import random
+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ((0, 1), (1, 0), (0, -1), (-1, 0))
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+LEGEND_COLOR_COUNT_RANGE = (2, 4)
+REGION_EXTRA_RANGE = (0, 2)
+REGION_INTERIOR_H_RANGE = (2, 5)
+REGION_INTERIOR_W_RANGE = (2, 5)
+GEN_RETRIES = 400
+PLACE_RETRIES = 250
