+    cc1 = min(mask.shape[1] - 1, c1 + pad)
+    mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _box_is_clear(mask: np.ndarray, bbox: tuple[int, int, int, int], pad: int) -> bool:
