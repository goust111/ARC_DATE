+    return c
+
+
+def _path_cells(seed: tuple[int, int], direction: tuple[int, int], length: int, h: int, w: int) -> list[tuple[int, int]]:
+    r, c = seed
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    for step in range(1, length + 1):
+        nr = r + dr * step
+        nc = c + dc * step
+        if not (0 <= nr < h and 0 <= nc < w):
+            break
+        cells.append((nr, nc))
