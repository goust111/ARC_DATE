+from __future__ import annotations
+
+import random
+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ((0, 1), (1, 0), (0, -1), (-1, 0))
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+LEGEND_COLOR_COUNT_RANGE = (2, 4)
+REGION_EXTRA_RANGE = (0, 2)
