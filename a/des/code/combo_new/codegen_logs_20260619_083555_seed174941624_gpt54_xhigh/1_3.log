+    assert len(legend_candidates) == 1, "expected exactly one legend ring"
+    legend_bbox, direction_by_color = legend_candidates[0]
+
+    out = g.copy()
+    for bbox in rings:
+        if bbox == legend_bbox:
+            continue
+        r0, c0, r1, c1 = bbox
