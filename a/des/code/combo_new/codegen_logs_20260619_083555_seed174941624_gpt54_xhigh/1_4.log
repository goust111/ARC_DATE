+    bg = _get_bg(g)
+    components = _monochrome_components(g, bg)
+    rings = _extract_rings(components)
+    patterns = _extract_patterns(components, set(rings), bg)
+    assert len(patterns) == len(rings), "number of rings and patterns must match"
