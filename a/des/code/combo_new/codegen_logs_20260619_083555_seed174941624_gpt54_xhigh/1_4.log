+def _extract_patterns(components: list[dict], ring_colors: set[int], bg: int) -> dict[int, dict]:
+    patterns: dict[int, dict] = {}
+    for comp in components:
+        if comp["color"] in ring_colors:
+            continue
+        if comp["mask"].shape != (PATTERN_SIZE, PATTERN_SIZE):
