+    for comp in components:
+        if comp["area"] != 15 or comp["mask"].shape != (RING_SIZE, RING_SIZE):
+            continue
+        matched_dir = None
+        for gap_dir, template in RING_TEMPLATES.items():
+            if np.array_equal(comp["mask"], template):
+                matched_dir = gap_dir
+                break
+        if matched_dir is None:
+            continue
