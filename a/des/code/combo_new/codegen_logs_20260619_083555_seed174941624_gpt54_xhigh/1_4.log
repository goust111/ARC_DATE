+
+
+BG = 0
+RING_SIZE = 5
+PATTERN_SIZE = 3
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 500
+_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GAP_CELLS = {
+    "up": (0, 2),
+    "right": (2, 4),
+    "down": (4, 2),
+    "left": (2, 0),
+}
+GAP_TO_CW_TURNS = {"up": 0, "right": 1, "down": 2, "left": 3}
+
+_RNG = random.Random()
