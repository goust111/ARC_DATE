+    blocked = np.zeros((H, W), dtype=bool)
+    placed: list[dict] = []
+    for spec in specs:
+        pos = _pick_position(blocked, int(spec["h"]), int(spec["w"]))
+        if pos is None:
+            return None
+        obj = dict(spec)
+        obj["r"], obj["c"] = pos
