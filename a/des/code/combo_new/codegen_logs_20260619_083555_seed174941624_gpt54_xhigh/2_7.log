+def _has_symmetry(pattern: np.ndarray) -> bool:
+    return (
+        np.array_equal(pattern, np.fliplr(pattern))
+        or np.array_equal(pattern, np.flipud(pattern))
+        or np.array_equal(pattern, np.rot90(pattern, 2))
+    )
