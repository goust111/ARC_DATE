+        for rr in range(h):
+            r0 = r - rr
+            if r0 < 0 or r0 + h > grid_h:
+                continue
+            for cc in range(w):
+                c0 = c - cc
+                if c0 < 0 or c0 + w > grid_w:
+                    continue
+                top_lefts.add((r0, c0))
