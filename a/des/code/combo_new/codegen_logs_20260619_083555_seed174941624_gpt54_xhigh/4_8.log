+    spans = _nonempty_spans(legend)
+    assert len(spans) == 6, f"expected 6 legend spans, got {spans}"
+    assert all(c1 - c0 == 2 for c0, c1 in spans), "legend blocks must be 3 columns wide"
+
+    mapping: dict[str, np.ndarray] = {}
+    for i in range(0, 6, 2):
+        ex0, ex1 = spans[i]
+        pat0, pat1 = spans[i + 1]
+        example = legend[:, ex0 : ex1 + 1]
+        pattern = legend[:, pat0 : pat1 + 1]
+        grey_coords = np.argwhere(example == GREY)
+        assert grey_coords.shape == (1, 2), "legend example must have one grey center"
+        assert tuple(map(int, grey_coords[0])) == (1, 1), "legend example must be centered"
