+
+DIR_VECS = {
+    "H": (0, 1),
+    "V": (1, 0),
+    "D1": (1, 1),
+    "D2": (1, -1),
+}
+
+PATTERN_MASKS = {
+    "plus": np.array(
+        [
+            [1, 0, 1],
+            [0, 0, 0],
+            [1, 0, 1],
+        ],
+        dtype=bool,
+    ),
+    "x": np.array(
+        [
+            [0, 1, 0],
+            [1, 0, 1],
+            [0, 1, 0],
+        ],
+        dtype=bool,
+    ),
+    "mixed": np.array(
