+            if min(max_neg, max_pos) < 2:
+                line_specs = []
+                break
+            neg_len = int(rng.integers(2, max_neg + 1))
+            pos_len = int(rng.integers(2, max_pos + 1))
+            cells = _line_cells(center, direction, neg_len, pos_len)
+            endpoints = (cells[0], cells[-1])
+            line_specs.append(
