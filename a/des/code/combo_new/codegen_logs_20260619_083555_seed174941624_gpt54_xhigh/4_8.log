+
+        out[int(r), int(c)] = int(lower["color"])
+        _stamp_pattern(out, (int(r), int(c)), pattern_map[cross_type], int(upper["color"]))
+
+    return out
+
+
+def _line_cells(center: tuple[int, int], direction: str, neg_len: int, pos_len: int) -> list[tuple[int, int]]:
+    r0, c0 = center
