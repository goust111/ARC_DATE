+import random
+
+import numpy as np
+
+
+ARC_COLORS = tuple(range(10))
+GENERATION_RETRIES = 400
+BAND_COUNT_RANGE = (1, 4)
+PAIR_COUNT_RANGE = (2, 5)
+MIN_REGION_THICKNESS = 2
+GRID_MAX_SIDE = 24
