+            color_a = frag_colors[color_idx]
+            color_b = frag_colors[color_idx + 1]
+            color_idx += 2
+            rooms.append(
+                {
+                    "bbox": room_box,
+                    "shape": shape,
+                    "color_a": int(color_a),
+                    "color_b": int(color_b),
+                }
+            )
+            cc += cw + 1
+        rr += rh + 1
