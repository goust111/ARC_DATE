+        if cols == 1:
+            col_sizes = [random.randint(ROOM_SIZE_MIN, ROOM_SIZE_MAX)]
+        else:
+            col_sizes = random.sample(range(ROOM_SIZE_MIN, ROOM_SIZE_MAX + 1), cols)
