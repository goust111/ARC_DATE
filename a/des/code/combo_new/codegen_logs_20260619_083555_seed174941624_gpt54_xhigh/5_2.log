+    candidates: dict[int, list[dict]] = defaultdict(list)
+    for coords in bg_comps:
+        if _touches_border(coords, grid.shape):
+            continue
+        neigh = set()
+        for r, c in coords:
+            for dr, dc in DIR4:
+                nr, nc = int(r) + dr, int(c) + dc
+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
+                    val = int(grid[nr, nc])
+                    if val != int(bg):
+                        neigh.add(val)
