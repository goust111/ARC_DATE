+
+def _mask_from_coords(coords: np.ndarray, box: tuple[int, int, int, int] | None = None) -> np.ndarray:
+    if box is None:
+        box = _bbox(coords)
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[int(r) - r0, int(c) - c0] = True
