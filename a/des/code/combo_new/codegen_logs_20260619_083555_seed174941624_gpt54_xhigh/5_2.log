+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ROOM_COUNTS = [2, 3, 4]
+ROOM_LAYOUTS = {
+    2: [(1, 2), (2, 1)],
+    3: [(1, 3), (3, 1)],
+    4: [(2, 2)],
+}
+ROOM_SIZE_MIN = 4
+ROOM_SIZE_MAX = 6
