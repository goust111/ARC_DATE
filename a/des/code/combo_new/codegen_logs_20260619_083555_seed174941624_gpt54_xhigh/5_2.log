+
+    inp = np.full((grid_h, grid_w), int(bg), dtype=int)
+    inp[top : top + container_h, left : left + container_w] = int(guide)
+    container_mask = np.zeros((grid_h, grid_w), dtype=bool)
+    container_mask[top : top + container_h, left : left + container_w] = True
+
+    rooms = []
+    rr = top + 1
+    color_idx = 0
+    for rh in row_sizes:
+        cc = left + 1
+        for cw in col_sizes:
+            room_box = (rr, cc, rr + rh - 1, cc + cw - 1)
+            inp[rr : rr + rh, cc : cc + cw] = int(bg)
+            shape = _generate_cover_shape(rh, cw)
+            if shape is None:
+                return None
+            color_a = frag_colors[color_idx]
+            color_b = frag_colors[color_idx + 1]
+            color_idx += 2
+            rooms.append(
+                {
+                    "bbox": room_box,
+                    "shape": shape,
+                    "color_a": int(color_a),
+                    "color_b": int(color_b),
+                }
+            )
+            cc += cw + 1
+        rr += rh + 1
+
+    expected = inp.copy()
+    occupied = container_mask.copy()
+
+    fragments = []
+    for room in rooms:
+        r0, c0, r1, c1 = room["bbox"]
+        shape = room["shape"]
+        cover_a = shape
+        cover_b = np.rot90(shape, 2)
+        patch = expected[r0 : r1 + 1, c0 : c1 + 1]
+        only_a = cover_a & ~cover_b
+        only_b = cover_b & ~cover_a
+        overlap = cover_a & cover_b
+        patch[only_a] = int(room["color_a"])
+        patch[only_b] = int(room["color_b"])
+        patch[overlap] = int(guide)
+
+        fragments.append((np.rot90(shape, random.randrange(4)), int(room["color_a"])))
+        fragments.append((np.rot90(shape, random.randrange(4)), int(room["color_b"])))
+
+    random.shuffle(fragments)
+    fragments.sort(key=lambda item: -int(item[0].sum()))
+    for frag_mask, color in fragments:
+        if not _place_patch(inp, occupied, frag_mask, color):
+            return None
+
+    if _most_common_color(inp) != int(bg):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        case = _build_case()
+        if case is not None:
+            return case[0]
