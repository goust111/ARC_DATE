+
+def _most_common_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = map(int, shape)
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 1] == 0)
+        or np.any(coords[:, 0] == h - 1)
+        or np.any(coords[:, 1] == w - 1)
+    )
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _mask_from_coords(coords: np.ndarray, box: tuple[int, int, int, int] | None = None) -> np.ndarray:
+    if box is None:
+        box = _bbox(coords)
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask
+
+
+def _rotation_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    best: tuple[tuple[int, int], bytes] | None = None
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
+        if best is None or key < best:
+            best = key
+    assert best is not None
+    return best
+
+
+def _unique_rotations(mask: np.ndarray) -> list[tuple[int, np.ndarray]]:
+    seen = set()
+    out: list[tuple[int, np.ndarray]] = []
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append((k, rot))
+    return out
+
