+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
