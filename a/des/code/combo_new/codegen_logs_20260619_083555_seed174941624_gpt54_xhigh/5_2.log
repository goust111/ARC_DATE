+            row_sizes = [random.randint(ROOM_SIZE_MIN, ROOM_SIZE_MAX)]
+        else:
+            row_sizes = random.sample(range(ROOM_SIZE_MIN, ROOM_SIZE_MAX + 1), rows)
+        if cols == 1:
