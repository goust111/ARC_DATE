+def _generate_cover_shape(h: int, w: int) -> np.ndarray | None:
+    area = h * w
+    for _ in range(SHAPE_ATTEMPTS):
+        mask = np.ones((h, w), dtype=bool)
+        target = random.randint(max(1, area // 5), max(2, area // 3))
+        removed = 0
+        steps = 0
+        while removed < target and steps < area * 30:
+            steps += 1
+            candidates = []
+            for r in range(h):
+                for c in range(w):
+                    if not mask[r, c]:
+                        continue
+                    pr, pc = h - 1 - r, w - 1 - c
+                    if (r, c) == (pr, pc):
+                        continue
+                    if not mask[pr, pc]:
