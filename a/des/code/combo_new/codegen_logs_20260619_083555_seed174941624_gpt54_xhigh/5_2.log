            break
    if best is None:
        best = (0, False)
    k, flip = best

    # Build ordered lists and pair them deterministically.
    dest_list = []
    for h in dest_holes:
        key = (int(d_rr[int(h["cent"][0])]), int(d_cc[int(h["cent"][1])]))
