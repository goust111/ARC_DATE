+
+def _valid_placements(container: np.ndarray, piece: np.ndarray) -> list[tuple[int, int, np.ndarray]]:
+    ch, cw = map(int, container.shape)
+    ph, pw = map(int, piece.shape)
+    if ph > ch or pw > cw:
+        return []
+    placements = []
+    for r0 in range(ch - ph + 1):
