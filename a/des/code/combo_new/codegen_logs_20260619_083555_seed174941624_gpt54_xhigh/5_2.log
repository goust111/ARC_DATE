+                    candidates.append((r, c))
+            if not candidates:
+                break
+            r, c = random.choice(candidates)
+            mask[r, c] = False
+            if (
+                not _touches_all_sides(mask)
+                or not _is_connected(mask)
+                or _has_hole(mask)
