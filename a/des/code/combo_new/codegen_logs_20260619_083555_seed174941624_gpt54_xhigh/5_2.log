+                            "top_a": int(top_a),
+                            "left_a": int(left_a),
+                            "placed_a": placed_a,
+                            "k_b": int(k_b),
+                            "top_b": int(top_b),
+                            "left_b": int(left_b),
+                            "placed_b": placed_b,
+                        }
+    return None
