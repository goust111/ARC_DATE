                    rr, cc = r + odr, c + odc
                    if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == 0:
                        ok = False; break
                if not ok: continue
                corners.append((r, c, kind))
                break  # one kind per cell
    return corners


def _colored_around(g, r, c, kind, bg):
