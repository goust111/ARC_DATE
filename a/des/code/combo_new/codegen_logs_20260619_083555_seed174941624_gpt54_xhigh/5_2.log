+    def get_placements(mask: np.ndarray) -> list[tuple[int, int, np.ndarray]]:
+        key = (mask.shape[0], mask.shape[1], mask.tobytes())
+        if key not in placements_cache:
+            placements_cache[key] = _valid_placements(cavity_mask, mask)
