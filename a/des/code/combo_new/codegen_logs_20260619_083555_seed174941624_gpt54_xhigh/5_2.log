+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ROOM_COUNTS = [2, 3, 4]
+ROOM_LAYOUTS = {
+    2: [(1, 2), (2, 1)],
+    3: [(1, 3), (3, 1)],
+    4: [(2, 2)],
+}
+ROOM_SIZE_MIN = 4
+ROOM_SIZE_MAX = 6
+GRID_PAD_MIN = 9
+GRID_PAD_MAX = 13
