+
+def _rotation_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    best: tuple[tuple[int, int], bytes] | None = None
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
+        if best is None or key < best:
