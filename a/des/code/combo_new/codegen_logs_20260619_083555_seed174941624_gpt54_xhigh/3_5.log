+    turns = _balanced_turns(len(row_spans) * len(col_spans))
+    turn_index = 0
+    for r0, r1 in row_spans:
+        for c0, c1 in col_spans:
+            patch = _make_region(r1 - r0 + 1, c1 - c0 + 1, turns[turn_index])
+            turn_index += 1
+            if patch is None:
+                return None
+            grid[r0 : r1 + 1, c0 : c1 + 1] = patch
