        elif direction == "right":
            _paint_rect(out, r0, c1 + 1, r1, c1 + depth, color)
        elif direction == "down":
            _paint_rect(out, r1 + 1, c0, r1 + depth, c1, color)
        else:
            _paint_rect(out, r0, c0 - depth, r1, c0 - 1, color)

    out[:, -1] = g[:, -1]
    return out


