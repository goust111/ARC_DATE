+def _pattern(direction: str, arm_len: int) -> np.ndarray:
+    pat = np.zeros((arm_len, arm_len), dtype=bool)
+    if direction == "up":
+        pat[-1, :] = True
+        pat[:, -1] = True
+    elif direction == "right":
+        pat[-1, :] = True
+        pat[:, 0] = True
+    elif direction == "down":
+        pat[0, :] = True
+        pat[:, 0] = True
+    elif direction == "left":
