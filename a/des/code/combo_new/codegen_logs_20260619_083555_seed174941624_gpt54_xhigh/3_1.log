+
+def _occupy(occupied: np.ndarray, top: int, left: int, height: int, width: int, pad: int = 1) -> None:
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(occupied.shape[0], top + height + pad)
+    c1 = min(occupied.shape[1], left + width + pad)
+    occupied[r0:r1, c0:c1] = True
