+
+def _legend_origin(corner: str, grid_h: int, grid_w: int, legend_h: int, legend_w: int) -> tuple[int, int]:
+    top = 0 if "T" in corner else grid_h - legend_h
+    left = 0 if "L" in corner else grid_w - legend_w
