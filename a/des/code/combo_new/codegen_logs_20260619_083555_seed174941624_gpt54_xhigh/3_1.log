+    if all(value == color for value in ring):
+        return color
+    return None
+
+
+def _decode_legend(grid: np.ndarray) -> tuple[dict[int, np.ndarray], set[tuple[int, int]]]:
+    h, w = grid.shape
+    mapping: dict[int, np.ndarray] = {}
+    legend_cells: set[tuple[int, int]] = set()
