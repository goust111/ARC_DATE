+    for index, (color, mask) in enumerate(ordered_pairs):
+        block_row = index // legend_cols
+        block_col = index % legend_cols
+        top = base_r + block_row * (6 + LEGEND_GAP)
+        left = base_c + block_col * (3 + LEGEND_GAP)
