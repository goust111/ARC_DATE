from __future__ import annotations
from collections import deque
import hashlib
import random
import numpy as np

NEIGHBORS8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) "'!= (0, 0))
NEIGHBORS4 = ((1,0),(-1,0),(0,1),(0,-1))
PALETTE = tuple(range(1,10))


def _connected(mask: np.ndarray, connectivity: int = 8) -> bool:
    mask = np.asarray(mask, dtype=bool)
    coords = np.argwhere(mask)
    if coords.size == 0:
        return False
    neighbors = NEIGHBORS8 if connectivity == 8 else NEIGHBORS4
    start = tuple(map(int, coords[0]))
    seen = {start}
    q = deque([start])
    h, w = mask.shape
    while q:
        r, c = q.popleft()
        for dr, dc in neighbors:
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
                seen.add((nr, nc))
                q.append((nr, nc))
    return len(seen) == int(mask.sum())


def _touches_all_sides(mask: np.ndarray) -> bool:
    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())


def _orth_edge_count(mask: np.ndarray) -> int:
    return int(np.sum(mask[1:, :] & mask[:-1, :]) + np.sum(mask[:, 1:] & mask[:, :-1]))


def _random_valid_mask(h: int, w: int) -> np.ndarray:
    area = h * w
    for _ in range(4000):
        p = random.uniform(0.35, 0.65)
        mask = np.random.random((h, w)) < p
        filled = int(mask.sum())
        if filled < max(4, area // 4) or filled > area - max(4, area // 4):
            continue
        comp = ~mask
        if not _touches_all_sides(mask) or not _touches_all_sides(comp):
            continue
        if not _connected(mask, 8) or not _connected(comp, 8):
            continue
        if _orth_edge_count(mask) < 2 or _orth_edge_count(comp) < 2:
            continue
        return mask
    raise RuntimeError('"'mask gen failed')


def _extract_components(grid: np.ndarray, bg: int = 0, connectivity: int = 8):
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    neighbors = NEIGHBORS8 if connectivity == 8 else NEIGHBORS4
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(g[r, c]) == bg:
                continue
            color = int(g[r, c])
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                cr, cc = q.popleft()
                coords.append((cr, cc))
                for dr, dc in neighbors:
                    nr, nc = cr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            rs = [rr for rr, _ in coords]
            cs = [cc for _, cc in coords]
            r0, r1 = min(rs), max(rs)
            c0, c1 = min(cs), max(cs)
            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
            for rr, cc in coords:
                mask[rr - r0, cc - c0] = True
            comps.append({'color': color, 'bbox': (r0,c0,r1,c1), 'anchor': (r0,c0), 'mask': mask})
    return comps


def main(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    comps = _extract_components(g, 0, 8)
    assert comps and len(comps) % 2 == 0
    dims = {comp['mask'].shape for comp in comps}
    assert len(dims) == 1
    rh, rw = next(iter(dims))
    mask_to_idx = {}
    for idx, comp in enumerate(comps):
        key = comp['mask'].tobytes()
        assert key not in mask_to_idx
        mask_to_idx[key] = idx
    partner = {}
    for idx, comp in enumerate(comps):
        key = (~comp['mask']).tobytes()
        assert key in mask_to_idx
        partner[idx] = mask_to_idx[key]
        assert partner[idx] "'!= idx
    seen = set()
    pairs = []
    for idx in range(len(comps)):
        if idx in seen:
            continue
        j = partner[idx]
        assert partner[j] == idx
        seen.add(idx); seen.add(j)
        key = tuple(sorted((comps[idx]['"'anchor'], comps[j]['anchor'])))
        pairs.append((key, idx, j))
    assert len(seen) == len(comps)
    pairs.sort(key=lambda item: item[0])
    out = np.zeros((rh, len(pairs)*rw + max(0, len(pairs)-1)), dtype=int)
    for pi, (_, i, j) in enumerate(pairs):
        c0 = pi * (rw + 1)
        out[:, c0:c0+rw][comps[i]['mask']] = comps[i]['color']
        out[:, c0:c0+rw][comps[j]['mask']] = comps[j]['color']
    return out


def expected_from_records(h,w,pairs,objs):
