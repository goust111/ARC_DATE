from collections import deque
import random
import numpy as np

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:
        return False
    q=deque([tuple(pts[0])]); seen={tuple(pts[0])}; H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def sides(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def gen(H,W):
    area=H*W
    target=random.randint(max(4,area//3), min(area-4, area*2//3))
    mask=np.zeros((H,W),dtype=bool)
    seed=(random.randrange(H), random.randrange(W))
    mask[seed]=1
    while mask.sum()<target:
        frontier=[]
        for r,c in zip(*np.where(mask)):
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if 0<=nr<H and 0<=nc<W and not mask[nr,nc]:
                    frontier.append((nr,nc))
        if not frontier: break
        nr,nc=random.choice(frontier)
        mask[nr,nc]=1
    return mask

ok=0
trials=5000
for _ in range(trials):
    H=random.randint(4,6); W=random.randint(4,6)
    m=gen(H,W)
    cm=~m
    if conn(m) and conn(cm) and sides(m) and sides(cm):
        ok+=1
print('ok',ok,'/',trials,'rate',ok/trials)
