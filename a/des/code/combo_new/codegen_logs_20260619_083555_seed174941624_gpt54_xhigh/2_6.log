+
+def _rect_conflicts(
+    rect: tuple[int, int, int, int], others: list[tuple[int, int, int, int]], gap: int = 1
+) -> bool:
+    r0, c0, r1, c1 = rect
+    for or0, oc0, or1, oc1 in others:
+        separated = r1 + gap < or0 or or1 + gap < r0 or c1 + gap < oc0 or oc1 + gap < c0
+        if not separated:
+            return True
+    return False
