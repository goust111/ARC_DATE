+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    if not bool(np.all((rows == r0) | (rows == r1) | (cols == c0) | (cols == c1))):
+        return None
+    return r0, c0, r1, c1
