+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                if rr > 0 and mask[rr - 1, cc] and not seen[rr - 1, cc]:
+                    seen[rr - 1, cc] = True
+                    stack.append((rr - 1, cc))
+                if rr + 1 < h and mask[rr + 1, cc] and not seen[rr + 1, cc]:
+                    seen[rr + 1, cc] = True
+                    stack.append((rr + 1, cc))
+                if cc > 0 and mask[rr, cc - 1] and not seen[rr, cc - 1]:
