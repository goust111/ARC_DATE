+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_boundary(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _detect_wall(grid: np.ndarray, coords: list[tuple[int, int]]):
+    comp = set(coords)
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 4 or c1 - c0 < 4:
+        return None
+
+    boundary = _frame_boundary(r0, c0, r1, c1)
+    if any(cell not in boundary for cell in comp):
+        return None
+
+    missing = sorted(boundary - comp)
+    if len(missing) not in (1, 2):
+        return None
+
+    rows = {r for r, _ in missing}
+    cols = {c for _, c in missing}
+    side = None
