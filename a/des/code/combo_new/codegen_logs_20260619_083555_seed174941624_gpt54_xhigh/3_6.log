+) -> bool:
+    count = rng.randint(1, 4)
+    gate_len = rng.randint(1, 2)
+    min_inner = max(count, gate_len, INNER_SIZE_RANGE[0])
+    inner_h = rng.randint(min_inner, INNER_SIZE_RANGE[1])
+    inner_w = rng.randint(min_inner, INNER_SIZE_RANGE[1])
