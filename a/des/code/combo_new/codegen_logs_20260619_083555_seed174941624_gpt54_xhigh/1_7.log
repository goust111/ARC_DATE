+    frozenset({(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)}): ("left", (1, 0)),
+    frozenset({(0, 1), (1, 1), (2, 1), (0, 0), (0, 2)}): ("up", (0, 1)),
