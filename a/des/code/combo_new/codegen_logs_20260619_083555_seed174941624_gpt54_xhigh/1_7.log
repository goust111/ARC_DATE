+    frozenset({(0, 1), (1, 1), (2, 1), (0, 0), (0, 2)}): ("up", (0, 1)),
+    frozenset({(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)}): ("down", (2, 1)),
