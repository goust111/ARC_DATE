+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    order = np.argsort(-counts)
+    assert len(order) > 0
+    bg = int(values[int(order[0])])
+    if len(order) > 1:
+        assert int(counts[int(order[0])]) > int(counts[int(order[1])])
+    return bg
