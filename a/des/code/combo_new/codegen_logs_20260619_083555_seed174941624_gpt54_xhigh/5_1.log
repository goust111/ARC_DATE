+def _find_frame_and_gap(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int], str]:
+    candidates: list[tuple[int, int, tuple[int, int, int, int], str]] = []
+    for color in np.unique(grid):
