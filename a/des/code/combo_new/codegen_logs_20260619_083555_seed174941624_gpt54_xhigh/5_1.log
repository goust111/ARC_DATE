+        r0, c0 = map(int, coords.min(axis=0))
+        r1, c1 = map(int, coords.max(axis=0))
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        mask = sub == color
+        border = np.zeros_like(mask, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+
+        if bool(np.any(mask & ~border)):
+            continue
