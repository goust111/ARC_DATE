+def _normalize_direction_order(count: int) -> list[tuple[int, int]]:
+    if count <= len(DIRECTIONS):
+        dirs = list(DIRECTIONS)
+        random.shuffle(dirs)
+        return dirs[:count]
+    dirs = list(DIRECTIONS)
+    while len(dirs) < count:
