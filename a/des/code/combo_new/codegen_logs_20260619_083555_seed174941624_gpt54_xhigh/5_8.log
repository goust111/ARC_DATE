+        if nxt in reserved_paths or nxt in local_paths:
+            return None
+        if nxt in occupied_static:
+            return (cells, "tower") if cells and nxt in blocker_towers else None
+        cells.append(nxt)
+        step += 1
+
+
+def _plan_path_from(
+    shape: tuple[int, int],
+    cur: tuple[int, int],
+    direction: tuple[int, int],
+    turns_left: int,
+    occupied_static_base: set[tuple[int, int]],
