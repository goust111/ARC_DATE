+    return components
+
+
+def _tower_signature(coords: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    if len(coords) != 4:
+        return None
+    coord_set = set(coords)
+    degrees = {
+        cell: sum(neighbor in coord_set for neighbor in _neighbors4(cell))
+        for cell in coords
