+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRECTIONS = (UP, DOWN, LEFT, RIGHT)
+PERPENDICULARS = {
+    UP: (LEFT, RIGHT),
+    DOWN: (LEFT, RIGHT),
+    LEFT: (UP, DOWN),
+    RIGHT: (UP, DOWN),
+}
+BACKSLASH_REFLECT = {
+    RIGHT: DOWN,
+    DOWN: RIGHT,
+    LEFT: UP,
+    UP: LEFT,
+}
+SLASH_REFLECT = {
+    RIGHT: UP,
+    UP: RIGHT,
+    LEFT: DOWN,
+    DOWN: LEFT,
+}
+
+MIRROR_COLOR = 5
+ALL_COLORS = tuple(range(10))
+NON_MIRROR_COLORS = tuple(color for color in ALL_COLORS if color != MIRROR_COLOR)
+TOWER_COLORS = tuple(color for color in ALL_COLORS if color != MIRROR_COLOR)
