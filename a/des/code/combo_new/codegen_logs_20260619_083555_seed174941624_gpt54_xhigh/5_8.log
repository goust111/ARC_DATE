+    prefix: list[tuple[int, int]] = []
+    candidates: list[tuple[list[tuple[int, int]], tuple[int, int], tuple[int, int], tuple[int, int], tuple[int, int]]] = []
+    max_probe = max(shape)
+    for steps in range(1, max_probe + 1):
+        turn_cell = _add(cur, direction, steps)
