+MIRROR_COLOR = 5
+ALL_COLORS = tuple(range(10))
+NON_MIRROR_COLORS = tuple(color for color in ALL_COLORS if color != MIRROR_COLOR)
+TOWER_COLORS = tuple(color for color in ALL_COLORS if color != MIRROR_COLOR)
