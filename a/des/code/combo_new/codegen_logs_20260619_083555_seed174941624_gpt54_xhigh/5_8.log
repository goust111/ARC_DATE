+        if (cell[0] - 1, cell[1] - 1) in mirror_cells or (cell[0] + 1, cell[1] + 1) in mirror_cells:
+            options.append("\\")
+        if (cell[0] - 1, cell[1] + 1) in mirror_cells or (cell[0] + 1, cell[1] - 1) in mirror_cells:
