MARKER_COLOR = 9
DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _outward_direction(g: np.ndarray, coords: np.ndarray) -> tuple[int, int]:
    H, W = g.shape
    directions: set[tuple[int, int]] = set()
    for r, c in coords:
        rr = int(r)
        cc = int(c)
        for dr, dc in DIRECTIONS:
            nr = rr + dr
            nc = cc + dc
