+    towers.sort(key=lambda tower: (tower["tip"][0], tower["tip"][1], tower["color"]))
+    for tower in towers:
+        color = int(tower["color"])
+        cur = tuple(tower["tip"])
+        direction = tuple(tower["direction"])
+        seen_states: set[tuple[tuple[int, int], tuple[int, int]]] = set()
