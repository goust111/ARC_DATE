+def _tower_cells_from_tip(tip: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:
+    center = _add(tip, (-direction[0], -direction[1]))
+    arm_a, arm_b = PERPENDICULARS[direction]
+    return {
+        tip,
+        center,
+        _add(center, arm_a),
+        _add(center, arm_b),
