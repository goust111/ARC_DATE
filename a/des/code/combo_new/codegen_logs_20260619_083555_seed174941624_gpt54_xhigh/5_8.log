+    diag_a = (head[0] + incoming[0] + outgoing[0], head[1] + incoming[1] + outgoing[1])
+    diag_b = (head[0] - incoming[0] - outgoing[0], head[1] - incoming[1] - outgoing[1])
+    return [diag_a, diag_b]
