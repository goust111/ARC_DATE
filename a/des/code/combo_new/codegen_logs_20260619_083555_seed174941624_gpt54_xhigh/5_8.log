+
+def _finish_segment(
+    shape: tuple[int, int],
+    cur: tuple[int, int],
+    direction: tuple[int, int],
+    occupied_static: set[tuple[int, int]],
+    blocker_towers: set[tuple[int, int]],
+    reserved_paths: set[tuple[int, int]],
+    local_paths: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], str] | None:
