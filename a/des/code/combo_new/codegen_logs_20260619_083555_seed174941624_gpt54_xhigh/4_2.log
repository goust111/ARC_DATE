+def _neighbors4(row: int, col: int, height: int, width: int):
+    if row > 0:
+        yield row - 1, col
+    if row + 1 < height:
+        yield row + 1, col
+    if col > 0:
+        yield row, col - 1
+    if col + 1 < width:
+        yield row, col + 1
