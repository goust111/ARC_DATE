+    H, W = grid.shape
+    queue = deque([(int(start_r), int(start_c))])
+    visited[start_r, start_c] = True
+    coords: list[tuple[int, int]] = []
+
+    while queue:
+        r, c = queue.popleft()
+        coords.append((r, c))
+        for dr, dc in _DIR4:
+            nr = r + dr
+            nc = c + dc
