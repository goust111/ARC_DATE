+                    "color": int(g[r, c]),
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": local_mask,
+                    "area": int(local_mask.sum()),
+                    "holes": _count_holes(local_mask),
+                    "filled_key": (_fill_holes(local_mask).tobytes(), local_mask.shape),
+                }
+            )
