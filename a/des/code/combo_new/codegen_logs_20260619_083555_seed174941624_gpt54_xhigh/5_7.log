+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    order = np.argsort(-counts)
+    if len(order) > 1:
+        assert int(counts[order[0]]) > int(counts[order[1]])
+    return int(values[order[0]])
+
+
+def _same_color_component(
+    grid: np.ndarray,
+    start_r: int,
+    start_c: int,
+    visited: np.ndarray,
+) -> np.ndarray:
+    color = int(grid[start_r, start_c])
+    H, W = grid.shape
+    queue = deque([(int(start_r), int(start_c))])
+    visited[start_r, start_c] = True
+    coords: list[tuple[int, int]] = []
+
+    while queue:
+        r, c = queue.popleft()
+        coords.append((r, c))
+        for dr, dc in _DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < H and 0 <= nc < W and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                visited[nr, nc] = True
+                queue.append((nr, nc))
+
+    return np.asarray(coords, dtype=int)
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = r == 0 or r == h - 1 or c == 0 or c == w - 1
+
+            while queue:
+                cr, cc = queue.popleft()
+                for dr, dc in _DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if mask[nr, nc] or seen[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    if nr == 0 or nr == h - 1 or nc == 0 or nc == w - 1:
+                        touches_border = True
+                    queue.append((nr, nc))
+
+            if not touches_border:
+                holes += 1
+
+    return int(holes)
+
+
+def _fill_holes(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if not mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in _DIR4:
+            nr = r + dr
+            nc = c + dc
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if mask[nr, nc] or outside[nr, nc]:
+                continue
+            outside[nr, nc] = True
+            queue.append((nr, nc))
+
+    return mask | (~mask & ~outside)
