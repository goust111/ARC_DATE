+            coords = _same_color_component(g, r, c, visited)
+            rr = coords[:, 0]
+            cc = coords[:, 1]
+            r0 = int(rr.min())
+            r1 = int(rr.max())
+            c0 = int(cc.min())
+            c1 = int(cc.max())
+
+            local_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            local_mask[rr - r0, cc - c0] = True
