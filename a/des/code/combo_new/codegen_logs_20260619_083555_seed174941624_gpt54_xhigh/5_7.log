+def _analyze_regions(grid: np.ndarray) -> tuple[int, list[dict[str, object]]]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    bg = _most_common_color(g)
+    visited = np.zeros((H, W), dtype=bool)
+    regions: list[dict[str, object]] = []
