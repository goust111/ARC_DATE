+    dr, dc = shift
+    cells = set()
+    for r, c in np.argwhere(mask):
+        rr = top + int(r) + dr
+        cc = left + int(c) + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            cells.add((rr, cc))
