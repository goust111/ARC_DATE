+def _count_holes(mask: np.ndarray) -> int:
+    bg = ~mask
+    h, w = bg.shape
+    holes = 0
+    for comp in _components(bg):
+        if any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in comp):
