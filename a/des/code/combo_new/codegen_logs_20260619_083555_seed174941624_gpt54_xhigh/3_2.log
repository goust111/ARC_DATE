+            cc = int(c) + dc * shift
+            if 0 <= rr < h and 0 <= cc < w:
+                copies[rr, cc] = color
+    out = copies
+    out[g != BLACK] = g[g != BLACK]
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_components(mask)) == 1
+
+
+def _arrow_bbox(direction: str) -> tuple[int, int]:
+    if direction in ("up", "down"):
