+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+AZURE = 8
+PALETTE = [1, 2, 3, 4, 6, 7, 9]
+
+IDENTITY = "identity"
+HFLIP = "hflip"
+VFLIP = "vflip"
+ROT180 = "rot180"
+
+ICON_MASKS = {
+    IDENTITY: np.array(
+        [
+            [1, 1, 1],
+            [1, 1, 1],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    ),
+    HFLIP: np.array(
+        [
+            [1, 0, 0],
+            [1, 1, 0],
+            [1, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    VFLIP: np.array(
+        [
+            [1, 1, 1],
+            [0, 1, 0],
+            [0, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    ROT180: np.array(
+        [
+            [1, 0, 0],
+            [0, 1, 0],
+            [0, 0, 1],
+        ],
+        dtype=bool,
+    ),
+}
+
+QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
+MAX_GENERATION_ATTEMPTS = 400
+OBJECT_PLACEMENT_ATTEMPTS = 200
+SHAPE_ATTEMPTS = 200
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _find_cross(g: np.ndarray) -> tuple[int, int]:
+    rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == GREY)]
+    cols = [c for c in range(g.shape[1]) if np.all(g[:, c] == GREY)]
+    assert len(rows) == 1 and len(cols) == 1
+    return rows[0], cols[0]
+
+
+def _transform_mask(mask: np.ndarray, op: str) -> np.ndarray:
+    if op == IDENTITY:
+        return mask.copy()
