+def _stamp_shape(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    patch = grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]
+    patch[mask] = color
