+import random
+from typing import Optional
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+OBJECT = 7
+MARKER = 9
+CONTROL_COLORS = (1, 2, 3, 4)
+SIDES = ("top", "right", "bottom", "left")
+MARKER_MODES = (None, "up", "down", "left", "right")
+LAYOUTS = ((2, 3), (3, 2), (3, 3))
+GEN_RETRIES = 400
+_GEN_COUNTER = 0
