  49:             continue
  50:         slot_bboxes.append(bbox_coords(coords))
  51: 
  52:     assert slot_bboxes, "expected enclosed background slots"
  53:     row_starts = sorted({b[0] for b in slot_bboxes})
  54:     col_starts = sorted({b[1] for b in slot_bboxes})
  55:     assert len(slot_bboxes) == len(row_starts) * len(col_starts), (
  56:         "expected a complete rectangular array of slots"
  57:     )
  58: 
  59:     slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}
  60:     assert len(slot_by_anchor) == len(slot_bboxes), "slot anchors must be unique"
  61: 
  62:     out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)
  63:     for out_r, r0 in enumerate(row_starts):
  64:         for out_c, c0 in enumerate(col_starts):
  65:             assert (r0, c0) in slot_by_anchor, "missing slot in rectangular array"
