+        left = int(room["left"])
+        wall_mask = room["wall"]
+        for r, c in np.argwhere(wall_mask):
+            grid[top + int(r), left + int(c)] = WALL
+
+    for room, count in zip(rooms, counts):
+        slots = list(room["slots"])
+        rng.shuffle(slots)
+        if len(slots) < count:
+            return None
+        fill = palette_colors[count - 1]
+        for r, c in slots[:count]:
