+    counts = _choose_counts(rng, capacities, palette_len)
+    if counts is None:
+        return None
+
+    palette_colors = rng.sample(COLOR_POOL, palette_len)
+    for (r, c), color in zip(palette_cells, palette_colors):
+        grid[r, c] = color
+
+    for room in rooms:
