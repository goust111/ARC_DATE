+    expected = grid.copy()
+    for room in rooms:
+        top = int(room["top"])
+        left = int(room["left"])
+        room_mask = room["room"]
+        fill = int(room["fill"])
+        expected[top : top + room_mask.shape[0], left : left + room_mask.shape[1]][room_mask] = fill
