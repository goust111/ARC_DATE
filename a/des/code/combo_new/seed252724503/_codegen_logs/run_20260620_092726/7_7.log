+        idx = rng.choice(choices)
+        options = [v for v in range(1, limits[idx] + 1) if v != counts[idx]]
+        counts[idx] = rng.choice(options)
+
+    if len(counts) > 1 and len(set(counts)) == 1:
+        return None
+    return counts
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
