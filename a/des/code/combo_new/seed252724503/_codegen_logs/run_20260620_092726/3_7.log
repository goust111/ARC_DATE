+
+        if [rect.color for rect in order] != [rect.color for rect in rects]:
+            continue
+
+        visible_depths = 0
+        for depth, rect in enumerate(rects, start=1):
+            if depth >= 2 and _visible_fill_exists(out, rect):
+                visible_depths += 1
+        if visible_depths < min(len(rects) - 1, 2):
+            continue
+
+        return inp
