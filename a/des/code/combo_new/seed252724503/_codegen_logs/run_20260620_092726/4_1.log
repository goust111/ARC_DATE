+            color = sequence[idx % len(sequence)]
+            out[gap_r0 : gap_r1 + 1, col] = color
+    else:
+        gap_c0 = c0 + 1 + gap_start
+        gap_c1 = c0 + 1 + gap_end
+        rows = range(r1, height) if side == "bottom" else range(r0, -1, -1)
