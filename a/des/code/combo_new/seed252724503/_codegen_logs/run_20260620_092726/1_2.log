+
+def _place_holes(main_h: int, main_w: int, masks: list[np.ndarray]) -> list[tuple[int, int]] | None:
+    occupied = np.zeros((main_h, main_w), dtype=bool)
+    placements = []
+    for mask in masks:
+        ph, pw = mask.shape
+        candidates = []
