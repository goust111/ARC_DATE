+# --------------- generator ---------------
+
+GRID_MIN = 22
+GRID_MAX = 30
+MAIN_H_RANGE = (10, 16)
+MAIN_W_RANGE = (10, 16)
+HOLE_COUNT_RANGE = (2, 4)
+HOLE_SIZE_RANGE = (2, 5)
+HOLE_AREA_RANGE = (4, 8)
+GEN_RETRIES = 500
+FILL_MODES = ("rows", "cols", "checker", "diagonal")
