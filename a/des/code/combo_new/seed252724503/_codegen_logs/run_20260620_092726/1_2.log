+
+
+def _scatter_fragments(
+    shape: tuple[int, int],
+    main_bbox: tuple[int, int, int, int],
+    legend_bbox: tuple[int, int, int, int],
+    fragments: list[np.ndarray],
+) -> list[tuple[int, int]] | None:
