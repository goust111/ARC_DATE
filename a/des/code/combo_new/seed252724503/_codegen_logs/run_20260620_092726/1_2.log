+    return patch
+
+
+def _can_place_patch(occupied: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    if r0 <= 0 or c0 <= 0 or r0 + ph >= h or c0 + pw >= w:
+        return False
+    rr0 = max(0, r0 - 1)
+    rr1 = min(h, r0 + ph + 1)
