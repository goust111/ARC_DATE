+                    candidates.append((r0, c0))
+        if not candidates:
+            return None
+        r0, c0 = random.choice(candidates)
+        positions.append((r0, c0))
+        occupied[max(0, r0 - 1) : min(h, r0 + ph + 1), max(0, c0 - 1) : min(w, c0 + pw + 1)] = True
+    return positions
+
+
+def _gen_attempt() -> np.ndarray | None:
