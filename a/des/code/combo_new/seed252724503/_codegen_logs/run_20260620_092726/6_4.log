+    if sign == 1:
+        extent_bottom = sum(sizes) - len(sizes)
+        min_t0 = band_top + (0 if head_down else 1)
+        max_t0 = band_bottom - extent_bottom
+        if head_down:
+            max_t0 = min(max_t0, band_bottom - 1)
