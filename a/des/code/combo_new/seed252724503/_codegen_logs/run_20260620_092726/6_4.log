+def _parse_arrow(coords: list[tuple[int, int]]) -> dict:
+    assert len(coords) == 4, "arrow must have exactly four red cells"
+    cells = set(coords)
+
+    by_row: dict[int, list[int]] = {}
+    by_col: dict[int, list[int]] = {}
+    for r, c in coords:
