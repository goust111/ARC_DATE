+    color: int,
+    spec: dict[str, object],
+) -> bool:
+    left_mask = np.asarray(spec["a"], dtype=bool)
+    right_mask = np.asarray(spec["b"], dtype=bool)
+    offset = int(spec["offset"])
+    final_h = int(spec["final_h"])
+    final_w = int(spec["final_w"])
