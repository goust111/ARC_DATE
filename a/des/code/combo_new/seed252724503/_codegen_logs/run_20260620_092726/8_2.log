+            return int(spec["final_h"]) * (int(spec["final_w"]) + 2 * d_min)
+        d_min = max(1, (mask_a.shape[0] - offset + 2) // 2)
+        return (int(spec["final_h"]) + 2 * d_min) * int(spec["final_w"])
+
+    specs.sort(key=footprint_key, reverse=True)
+    return specs
