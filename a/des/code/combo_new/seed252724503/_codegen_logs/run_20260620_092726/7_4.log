+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+MAX_GRID_SIDE = 30
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 250
+LEGEND_SEARCH_ROWS = 4
+SIDES = ("top", "bottom", "left", "right")
