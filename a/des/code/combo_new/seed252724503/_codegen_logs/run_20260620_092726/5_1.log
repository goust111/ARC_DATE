+
+    grid = np.full((height, width), bg, dtype=int)
+    grid[-1, :] = _palette_row(width, bg, palette_colors)
+
+    dot_pool = [color for color in range(COLOR_COUNT) if color not in {bg, FRAME_COLOR}]
+    for bbox, count in zip(bboxes, counts):
+        r0, c0, r1, c1 = bbox
