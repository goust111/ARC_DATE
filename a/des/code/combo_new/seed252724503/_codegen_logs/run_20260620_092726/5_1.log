+    assert len(colors) == len(set(colors)), "palette colors must be distinct"
+    return colors
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[tuple[int, tuple[int, int, int, int]]]:
+    search = grid[:-1, :]
