+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PATTERN_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+ROW_COUNT_RANGE = (2, 4)
+COL_COUNT_RANGE = (2, 4)
+MIN_CELL_SIZE = 4
+MAX_CELL_SIZE = 6
+PATTERN_SIZE_CHOICES = (2, 3)
+GEN_ATTEMPTS = 400
