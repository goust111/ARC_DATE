+        "tr": int(region[0, -1]) == MAROON,
+        "bl": int(region[-1, 0]) == MAROON,
+        "br": int(region[-1, -1]) == MAROON,
+    }
+    matches = [name for name, ok in corners.items() if ok]
+    assert len(matches) == 1
+    return matches[0]
