+def _room_bounds(start: int, sizes: list[int]) -> list[int]:
+    bounds = [start]
+    pos = start
+    for size in sizes:
+        pos += size + 1
+        bounds.append(pos)
+    return bounds
+
+
+def _build_scene() -> tuple[np.ndarray, np.ndarray] | None:
+    _, rows, cols, directions = _mode_spec()
