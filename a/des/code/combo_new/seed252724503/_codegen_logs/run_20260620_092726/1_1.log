+    rooms: list[dict] = []
+    for rr in range(rows):
+        for cc in range(cols):
+            idx = rr * cols + cc
+            ir0 = row_bounds[rr] + 1
+            ir1 = row_bounds[rr + 1] - 1
+            ic0 = col_bounds[cc] + 1
+            ic1 = col_bounds[cc + 1] - 1
+            seed_r = random.randint(ir0, ir1)
