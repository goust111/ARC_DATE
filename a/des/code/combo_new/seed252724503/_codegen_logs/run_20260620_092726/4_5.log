+def _split_positive(total: int, parts: int) -> list[int]:
+    if parts <= 0:
+        return []
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(RNG.choice(np.arange(1, total), size=parts - 1, replace=False).tolist())
+    prev = 0
+    values: list[int] = []
+    for cut in cuts + [int(total)]:
+        values.append(int(cut - prev))
+        prev = int(cut)
+    return values
+
