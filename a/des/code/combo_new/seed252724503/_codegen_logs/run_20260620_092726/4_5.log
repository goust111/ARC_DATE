+from __future__ import annotations
+
+import numpy as np
+
+
+RNG = np.random.default_rng()
+PALETTE = tuple(range(1, 10))
+MODES = ("free", "boundary", "block", "overlap")
+GEN_RETRY_LIMIT = 400
