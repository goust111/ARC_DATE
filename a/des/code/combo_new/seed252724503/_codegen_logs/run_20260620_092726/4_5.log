    if parts == 1:
        return [int(total)]
    cuts = sorted(RNG.choice(np.arange(1, total), size=parts - 1, replace=False).tolist())
    prev = 0
    values: list[int] = []
    for cut in cuts + [int(total)]:
        values.append(int(cut - prev))
        prev = int(cut)
    return values


def _segment_heights(total_height: int, top_height: int) -> list[int]:
