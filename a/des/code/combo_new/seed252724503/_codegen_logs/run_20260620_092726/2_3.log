+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc, h, w):
