+    h, w = map(int, bg_mask.shape)
+    outside = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    def seed(rr: int, cc: int) -> None:
+        if bg_mask[rr, cc] and not outside[rr, cc]:
+            outside[rr, cc] = True
+            queue.append((int(rr), int(cc)))
+
+    for r in range(h):
+        seed(r, 0)
+        seed(r, w - 1)
+    for c in range(w):
