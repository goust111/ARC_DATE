  "dst": "background gap masks d inside the same vertical band spans, ordered left-to-right",
  "match_cond": "d_i receives color s_{i+1}; the rightmost d receives s_0",
  "transform": "paint only the matched background gaps; preserve existing foreground pixels and background separator columns"
}
</annotation>
</reference_puzzle>

