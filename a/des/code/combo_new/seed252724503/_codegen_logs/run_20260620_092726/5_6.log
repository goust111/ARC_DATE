+# --------------- generator ---------------
+
+MAX_RETRIES = 400
+HEIGHT_RANGE = (6, 10)
+SCENE_WIDTH_K2 = (4, 10)
+SCENE_WIDTH_K3 = (5, 5)
+EXTRA_PER_COLOR = 1
