+
+def _gen_attempt() -> np.ndarray | None:
+    k = random.choice((2, 3))
+    h_color_count, v_color_count = random.choice(((1, 1),)) if k == 2 else random.choice(((1, 2), (2, 1)))
+
+    scene_low, scene_high = SCENE_WIDTH_K2 if k == 2 else SCENE_WIDTH_K3
+    max_input_w = (30 - (k - 1)) // k
