+    h, w = shape
+    reserve = np.zeros((h, w), dtype=bool)
+    positions: list[tuple[int, int] | None] = [None] * len(patches)
+
+    order = sorted(
+        range(len(patches)),
+        key=lambda idx: patches[idx][0].shape[0] * patches[idx][0].shape[1],
+        reverse=True,
