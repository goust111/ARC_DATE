+                    candidates.append((r0, c0))
+        if not candidates:
+            return None
+        choice = candidates[int(rng.integers(len(candidates)))]
+        positions[idx] = choice
+        r0, c0 = choice
+        reserve[r0 - 1 : r0 + ph + 1, c0 - 1 : c0 + pw + 1] = True
