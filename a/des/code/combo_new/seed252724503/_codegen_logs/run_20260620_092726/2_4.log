+            return None
+
+    expected = _expected_output(grid, rooms)
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if len(_find_rooms(grid)) != room_count:
+        return None
+    return grid
