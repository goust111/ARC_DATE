+
+BG = 0
+WALL = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ROOM_RETRY_LIMIT = 300
+FURNITURE_RETRY_LIMIT = 200
+GENERATE_RETRY_LIMIT = 400
