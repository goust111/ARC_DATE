+
+def _find_rooms(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    wall_ps = _prefix_sum(g == WALL)
+    furniture_ps = _prefix_sum((g != BG) & (g != WALL))
