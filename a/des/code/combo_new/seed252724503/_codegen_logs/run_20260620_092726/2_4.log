+def _door_side(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> str | None:
+    if (
+        int(grid[r0, c0]) != WALL
+        or int(grid[r0, c1]) != WALL
+        or int(grid[r1, c0]) != WALL
+        or int(grid[r1, c1]) != WALL
