+def _prefix_sum(mask: np.ndarray) -> np.ndarray:
+    return np.pad(mask.astype(int), ((1, 0), (1, 0)), mode="constant").cumsum(axis=0).cumsum(axis=1)
+
+
+def _rect_sum(ps: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
+    if r0 > r1 or c0 > c1:
