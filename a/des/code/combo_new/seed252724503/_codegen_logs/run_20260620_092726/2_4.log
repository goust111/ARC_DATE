+    if not inner_choices:
+        return None
+
+    room_specs = []
+    for door_side, patch in zip(base_orientations, patches):
+        inner_h = random.choice(inner_choices)
+        inner_w = random.choice(inner_choices)
+        room_specs.append(
+            {
+                "door_side": door_side,
+                "inner_h": inner_h,
+                "inner_w": inner_w,
+                "room_h": inner_h + 2,
+                "room_w": inner_w + 2,
+                "patch": patch,
+            }
+        )
+
+    H = random.randint(20, 30)
+    W = random.randint(20, 30)
