+                    side = _door_side(g, r0, c0, r1, c1)
+                    if side is None:
+                        continue
+
+                    inner = g[r0 + 1 : r1, c0 + 1 : c1]
+                    try:
+                        patch, color = _extract_furniture(inner)
+                    except AssertionError:
