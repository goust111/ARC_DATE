+                door_offset = random.randint(1, spec["room_w"] - 2)
+            else:
+                door_offset = random.randint(1, spec["room_h"] - 2)
+            rooms.append(
+                _paint_room(
+                    grid,
+                    r0=r0,
+                    c0=c0,
+                    inner_h=spec["inner_h"],
+                    inner_w=spec["inner_w"],
+                    door_side=spec["door_side"],
+                    door_offset=door_offset,
+                    patch=spec["patch"],
