+def _is_single_component(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+
+    start = tuple(map(int, cells[0]))
+    stack = [start]
+    seen = {start}
+    h, w = mask.shape
