+    return H - h, W - w
+
+
+def _expected_output(inp: np.ndarray, rooms: list[dict]) -> np.ndarray:
+    return _apply_room_rotation(inp, rooms)
+
+
+def _gen_attempt() -> np.ndarray | None:
