+                        continue
+                    if _rect_sum(furniture_ps, r0 + 1, c0 + 1, r1 - 1, c1 - 1) == 0:
+                        continue
+
+                    room_h = r1 - r0 + 1
+                    room_w = c1 - c0 + 1
