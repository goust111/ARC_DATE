+        return None
+
+    sides = {
+        "top": grid[r0, c0 + 1 : c1],
+        "right": grid[r0 + 1 : r1, c1],
+        "bottom": grid[r1, c0 + 1 : c1],
+        "left": grid[r0 + 1 : r1, c0],
+    }
