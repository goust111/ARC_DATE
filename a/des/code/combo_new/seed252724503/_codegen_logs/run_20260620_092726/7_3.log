+                            "object_cells": object_cells,
+                            "arrow_cells": arrow_cells,
+                            "moved_cells": moved_cells,
+                        }
+                    )
+                    input_blocked |= _buffered(union_cells, h, w)
+                    output_blocked |= _buffered(moved_cells, h, w)
+                    for r, c in object_cells:
+                        grid[r, c] = color
+                    for r, c in arrow_cells:
+                        grid[r, c] = ARROW
+                    placed = True
+                    break
