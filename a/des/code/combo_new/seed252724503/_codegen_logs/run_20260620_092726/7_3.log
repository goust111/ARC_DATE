+                    for r, c in arrow_cells:
+                        grid[r, c] = ARROW
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
+                break
+        if not placed:
+            return None
+
+    for idx in range(static_count):
+        color = colors[movable_count + idx]
+        placed = False
+        for _ in range(180):
+            rel_obj = _build_static_shape()
+            if rel_obj is None:
