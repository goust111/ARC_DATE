+            continue
+        if not np.all(grid[r0 : r1 + 1, c0] == FRAME):
+            continue
+        if not np.all(grid[r0 : r1 + 1, c1] == FRAME):
+            continue
+        if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == FRAME):
