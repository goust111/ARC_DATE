        nr, nc = r + dr, c + dc
        if 0 <= nr < rows and 0 <= nc < cols:
            result.append((nr, nc))
    return result


def _grow_tree(size: int, rows: int, cols: int, rng: random.Random) -> set[tuple[int, int]] | None:
    start = (rng.randrange(rows), rng.randrange(cols))
