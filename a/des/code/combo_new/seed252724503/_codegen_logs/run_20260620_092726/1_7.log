+            center,
+            gear_to_color[cell],
+            gear_to_marker[cell],
+            driver=(cell == driver_cell),
+        )
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        rng = random.Random()
+        grid = _build_attempt(rng)
+        if grid is None:
