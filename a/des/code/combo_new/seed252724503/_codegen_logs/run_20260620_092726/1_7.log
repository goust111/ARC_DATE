+GEAR_OFFSETS = {
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+} | set(TOOTH_OFFSETS.values())
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LATTICE_SHAPES = ((3, 3), (3, 4), (4, 3), (4, 4))
