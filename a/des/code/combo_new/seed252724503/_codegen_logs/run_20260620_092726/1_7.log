+    for dr, dc in GEAR_OFFSETS:
+        grid[cr + dr, cc + dc] = color
+    tooth_dr, tooth_dc = TOOTH_OFFSETS[marked_dir]
+    grid[cr + tooth_dr, cc + tooth_dc] = MARK_COLOR
+    if driver:
+        grid[cr, cc] = DRIVER_COLOR
