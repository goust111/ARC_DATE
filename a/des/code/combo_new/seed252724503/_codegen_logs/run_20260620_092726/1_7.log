        for r in range(rows)
        for c in range(cols)
        if (r, c) not in blocked and (r, c) not in blocked_neighbors
    ]
    rng.shuffle(candidates)
    for cell in candidates:
        if any(neighbor in chosen for neighbor in _lattice_neighbors(cell, rows, cols)):
            continue
        chosen.append(cell)

