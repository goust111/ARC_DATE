+def _scale_nearest(template: np.ndarray, out_height: int, out_width: int) -> np.ndarray:
+    src_rows = (np.arange(out_height) * template.shape[0]) // out_height
+    src_cols = (np.arange(out_width) * template.shape[1]) // out_width
