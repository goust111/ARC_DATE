+    for room in rooms:
+        r0, c0, r1, c1 = map(int, room["bbox"])
+        template = templates[int(room["doors"]) - 1]
+        scaled = _scale_nearest(template, int(r1 - r0 - 1), int(c1 - c0 - 1))
