+        for r in range(r0, r0 + size)
+        for c in range(c0, c0 + size)
+    }
+
+
+def _expanded_cells(cells: set[tuple[int, int]], shape: tuple[int, int], pad: int) -> set[tuple[int, int]]:
+    h, w = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
