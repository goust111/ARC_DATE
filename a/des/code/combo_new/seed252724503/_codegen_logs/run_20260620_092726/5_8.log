+            row = row2 // 2
+            for col in range(span_start, span_start + width):
+                cells.add((int(row), int(col)))
+        elif direction == "left":
+            col2 = center2_c - 2 * offset
+            col = (col2 + 1) // 2
+            for row in range(span_top, span_top + width):
+                cells.add((int(row), int(col)))
+        else:
+            assert direction == "right"
+            col2 = center2_c + 2 * offset
+            col = col2 // 2
+            for row in range(span_top, span_top + width):
