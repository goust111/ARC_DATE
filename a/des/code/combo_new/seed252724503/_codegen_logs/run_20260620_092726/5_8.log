    H, W = g.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            r, c = marker_r + dr, marker_c + dc
            if 0 <= r < H and 0 <= c < W and r != base_r and int(g[r, c]) != bg:
