+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(GRID_HEIGHT_RANGE[0], GRID_HEIGHT_RANGE[1])
+    w = rng.randint(GRID_WIDTH_RANGE[0], GRID_WIDTH_RANGE[1])
