+        span_start = (center2_c - (width - 1)) // 2
+        span_top = (center2_r - (width - 1)) // 2
+
+        if direction == "up":
+            row2 = center2_r - 2 * offset
+            row = (row2 + 1) // 2
+            for col in range(span_start, span_start + width):
+                cells.add((int(row), int(col)))
+        elif direction == "down":
