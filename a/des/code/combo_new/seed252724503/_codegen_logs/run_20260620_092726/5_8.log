+        return None
+
+    expected = _build_expected((h, w), bg, placed)
+    if not np.array_equal(main(grid), expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
