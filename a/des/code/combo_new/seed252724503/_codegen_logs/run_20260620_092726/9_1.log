0121: def _gen_attempt() -> np.ndarray | None:
0122:     alignment, rect_perp, rect_axial, gap = _choose_layout()
0123:     bg, color_a, color_b = _choose_colors()
0124:     inp, out = _render_horizontal(rect_perp, rect_axial, gap, bg, color_a, color_b)
0125:     if alignment == "V":
0126:         inp = inp.T.copy()
0127:         out = out.T.copy()
0128: 
0129:     if np.array_equal(main(inp), out):
0130:         return inp
0131:     return None
