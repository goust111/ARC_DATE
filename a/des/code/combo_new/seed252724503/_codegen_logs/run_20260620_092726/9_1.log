+        elif direction == "down":
+            exit_r, exit_c = r1, seed_c
+        elif direction == "left":
+            exit_r, exit_c = seed_r, c0
+        else:
+            exit_r, exit_c = seed_r, c1
+
+        out[exit_r, exit_c] = bg
+        r, c = seed_r, seed_c
+        while 0 <= r < h and 0 <= c < w:
