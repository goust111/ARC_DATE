0097: def _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:
0098:     """Build the horizontal input/output pair; vertical cases are its transpose."""
0099:     perp = rect_perp + 2 * MARGIN
0100:     axial = 2 * rect_axial + gap + 2 * MARGIN
0101:     left_c0 = MARGIN
0102:     left_c1 = left_c0 + rect_axial - 1
0103:     right_c1 = axial - MARGIN - 1
0104:     right_c0 = right_c1 - rect_axial + 1
0105:     row0 = MARGIN
0106:     row1 = row0 + rect_perp - 1
0107: 
0108:     out = np.full((perp, axial), bg, dtype=int)
0109:     out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a
0110:     out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b
0111: 
0112:     span = gap // 2
0113:     out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a
0114:     out[:, right_c0 - span : right_c0] = color_b
0115: 
0116:     inp = out.copy()
0117:     inp[:, left_c1 + 1 : right_c0] = bg
0118:     return inp, out
0119: 
