0114:         for r in range(SPRITE_SIZE):
0115:             for c in range(SPRITE_MIRROR_COLS):
0116:                 if random.random() < fill_p:
0117:                     sprite[r, c] = color
0118:                     sprite[r, SPRITE_SIZE - 1 - c] = color
0119:         area = int(np.count_nonzero(sprite))
0120:         if area != target_area:
