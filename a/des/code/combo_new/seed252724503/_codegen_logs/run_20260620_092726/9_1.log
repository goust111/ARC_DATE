0108: def _make_sprite(color):
0109:     """Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds."""
0110:     target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)
0111:     for _ in range(SPRITE_RETRIES):
0112:         fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)
