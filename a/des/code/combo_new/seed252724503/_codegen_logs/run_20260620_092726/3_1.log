    r0, c0, r1, c1 = bbox
    top = grid[r0, c0 : c1 + 1]
    right = grid[r0 : r1 + 1, c1]
    bottom = grid[r1, c0 : c1 + 1]
    left = grid[r0 : r1 + 1, c0]

