+
+BLACK = 0
+GREY = 5
+TOWER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MIN_GRID_SIZE = 18
+MAX_GRID_SIZE = 28
+MIN_FENCE_SIZE = 4
+MAX_FENCE_SIZE = 8
+MAX_FENCES = 5
