+from __future__ import annotations
+
+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+TOWER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MIN_GRID_SIZE = 18
+MAX_GRID_SIZE = 28
+MIN_FENCE_SIZE = 4
+MAX_FENCE_SIZE = 8
+MAX_FENCES = 5
+
+SCENARIO_RETRIES = 120
+GENERATION_RETRIES = 300
+EXTRA_PLACEMENT_RETRIES = 160
+
+
+@dataclass(frozen=True)
+class Fence:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    tower_r: int
+    tower_c: int
+    color: int
+
+    @property
+    def height(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def width(self) -> int:
+        return self.c1 - self.c0 + 1
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _frame_mask(height: int, width: int) -> np.ndarray:
+    frame = np.zeros((height, width), dtype=bool)
+    frame[0, :] = True
+    frame[-1, :] = True
+    frame[:, 0] = True
+    frame[:, -1] = True
+    return frame
+
+
+def _parse_fences(grid: np.ndarray) -> list[Fence]:
+    g = np.asarray(grid, dtype=int)
