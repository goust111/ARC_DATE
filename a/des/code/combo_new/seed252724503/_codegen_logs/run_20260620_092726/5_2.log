    assert r != axis_r and c != axis_c, "seed cannot lie on the cross"
    if r < axis_r and c < axis_c:
        return "nw"
    if r < axis_r and c > axis_c:
        return "ne"
    if r > axis_r and c < axis_c:
        return "sw"
    return "se"


def _branch_cells(
    shape: tuple[int, int], r: int, c: int, dr: int, dc: int, length: int
) -> set[tuple[int, int]]:
    h, w = shape
    end_c = c + dc * (length - 1)
    cells: set[tuple[int, int]] = set()
    for step in range(length):
        cc = c + dc * step
        if 0 <= cc < w:
            cells.add((r, cc))
    for step in range(length):
