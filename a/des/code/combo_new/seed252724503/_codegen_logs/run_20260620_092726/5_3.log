+        pts = np.asarray(sorted(cells), dtype=int)
+        pts -= pts.min(axis=0)
+        h = int(pts[:, 0].max()) + 1
+        w = int(pts[:, 1].max()) + 1
+        mask = np.zeros((h, w), dtype=bool)
+        mask[pts[:, 0], pts[:, 1]] = True
