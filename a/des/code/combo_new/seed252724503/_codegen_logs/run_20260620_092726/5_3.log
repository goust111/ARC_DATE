+POLY_AREA_RANGE = (4, 6)
+POLY_ATTEMPTS = 80
+LARGE_ATTEMPTS = 60
+PLACEMENT_ATTEMPTS = 350
+GEN_ATTEMPTS = 400
+
+BORDER = 1
+PAD = 1
+MARGIN_RANGE = (1, 2)
+TAB_EXT_RANGE = (1, 2)
