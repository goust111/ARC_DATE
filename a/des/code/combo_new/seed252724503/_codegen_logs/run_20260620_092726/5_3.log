+        small, _large, holes = _pair_roles(comps)
+        small_mask, _ = _tight_mask(small)
+
+        for hole in holes:
+            hole_mask, _ = _tight_mask(hole)
+            if _matches_rotation(small_mask, hole_mask):
+                out[hole[:, 0], hole[:, 1]] = FILL_COLOR
+                out[small[:, 0], small[:, 1]] = bg
+                break
+
+    return out
+
+
