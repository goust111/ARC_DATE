+        else:
+            hole_coords = placed["hole_coords"] + np.asarray(placed["origin"])
+            expected[hole_coords[:, 0], hole_coords[:, 1]] = FILL_COLOR
+
+    if not _validate_instance(grid, bg, pair_colors):
