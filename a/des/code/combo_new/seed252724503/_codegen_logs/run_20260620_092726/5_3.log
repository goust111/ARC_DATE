+        shifted[:, 0] += r0
+        shifted[:, 1] += c0
+        holes.append(shifted)
+
+    return holes
+
+
+def _pair_roles(comps: list[np.ndarray]) -> tuple[np.ndarray, np.ndarray, list[np.ndarray]]:
+    infos = []
