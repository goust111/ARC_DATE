+def _matches_rotation(a: np.ndarray, b: np.ndarray) -> bool:
+    cur = a
+    for _ in range(4):
+        if cur.shape == b.shape and np.array_equal(cur, b):
+            return True
+        cur = np.rot90(cur)
+    return False
