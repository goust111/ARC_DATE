+def _starts_with(full: tuple[str, ...], prefix: tuple[str, ...]) -> bool:
+    return len(full) >= len(prefix) and full[: len(prefix)] == prefix
+
+
+def _separator_row(grid: np.ndarray, bg: int) -> int:
+    h, _w = grid.shape
