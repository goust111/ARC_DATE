+    - Geometry and location are distractions; the only matching key is the sequence of left/right turns made by the path.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    sep = _separator_row(g, bg)
+    grey = int(g[sep, 0])
+
+    bottom = g[sep + 1 :]
+    bh, bw = bottom.shape
+    label_cells = {
+        (r, c): int(bottom[r, c])
+        for r in range(bh)
+        for c in range(bw)
+        if bottom[r, c] not in (bg, grey)
+    }
