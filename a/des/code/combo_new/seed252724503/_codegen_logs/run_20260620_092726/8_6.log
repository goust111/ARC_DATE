+def _trace_path(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    cells = set(coords)
+    nbrs = {
+        cell: [n for n in _neighbors4(cell[0], cell[1], 10**9, 10**9) if n in cells]
