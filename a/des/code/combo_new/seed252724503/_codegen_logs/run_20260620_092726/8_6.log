+    grid[sep, :] = GREY
+
+    top_occ = np.zeros((top_h, width), dtype=bool)
+    placed_main = []
+    for obj in long_paths:
+        pos = _place_object(top_occ, obj["full"], 1, max(2, top_h - 1), 1, max(2, width - 1))
