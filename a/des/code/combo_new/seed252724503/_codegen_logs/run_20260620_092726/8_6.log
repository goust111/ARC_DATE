+
+    bottom_occ = np.zeros((bottom_h, width), dtype=bool)
+    for entry in entries:
+        pos = _place_object(
+            bottom_occ,
+            entry["full"],
+            1,
+            max(2, bottom_h - 1),
+            1,
+            max(2, width - 1),
+        )
+        if pos is None:
+            return None
+        dr, dc = pos
+        for r, c in _translate(entry["path"], dr + sep + 1, dc):
