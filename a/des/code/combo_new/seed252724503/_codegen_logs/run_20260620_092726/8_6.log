+
+BG = 0
+GREY = 5
+LABEL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+DIRS = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # E, S, W, N in clockwise order
+TURN_INV = {"L": "R", "R": "L"}
