+
+
+def _seed_band_from_spec(seed: Tuple[int, int, str, int], mapping: Dict[int, int], shape: Tuple[int, int]) -> List[Tuple[int, int]]:
+    r, c, edge, color = seed
+    h, w = shape
+    if edge == "top":
+        dr, dc = 1, 0
