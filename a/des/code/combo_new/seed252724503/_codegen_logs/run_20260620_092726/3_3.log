+
+
+def _band_cells(r: int, c: int, dr: int, dc: int, length: int, h: int, w: int) -> List[Tuple[int, int]]:
+    cells: List[Tuple[int, int]] = []
+    for step in range(length):
+        rr = int(r + dr * step)
+        cc = int(c + dc * step)
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        cells.append((rr, cc))
+    return cells
