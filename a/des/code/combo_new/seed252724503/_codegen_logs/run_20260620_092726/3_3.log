+def _draw_legend(grid: np.ndarray, r0: int, c0: int, colors: Sequence[int], lengths: Sequence[int]) -> Tuple[int, int, int, int]:
+    inner_h = int(sum(lengths))
+    r1 = int(r0 + inner_h + 1)
