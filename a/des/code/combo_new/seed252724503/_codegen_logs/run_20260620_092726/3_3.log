+        "bottom": [c for c in range(1, w - 1) if c not in legend_cols],
+        "left": [r for r in range(1, h - 1) if r not in legend_rows],
+        "right": [r for r in range(1, h - 1) if r not in legend_rows],
+    }
+
+
+def _place_seed(
+    grid: np.ndarray,
+    used: set[Tuple[int, int]],
+    edge: str,
+    idx: int,
+    color: int,
