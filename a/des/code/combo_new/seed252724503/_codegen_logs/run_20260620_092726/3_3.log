+    (r0, c0, r1, c1), mapping = _find_legend(g, bg)
+    out = np.full_like(g, bg)
+
+    seeds: List[Tuple[int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
