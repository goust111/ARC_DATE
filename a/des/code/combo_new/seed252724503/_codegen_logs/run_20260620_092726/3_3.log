+
+def _has_truncation(seeds: Sequence[Tuple[int, int, str, int]], mapping: Dict[int, int], shape: Tuple[int, int]) -> bool:
+    for seed in seeds:
+        cells = _seed_band_from_spec(seed, mapping, shape)
+        if len(cells) < mapping[seed[3]]:
