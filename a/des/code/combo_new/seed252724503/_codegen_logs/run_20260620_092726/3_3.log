+    row = r0 + 1
+    for color, length in zip(colors, lengths, strict=True):
+        grid[row, c0 + 1] = int(color)
+        grid[row : row + length, c0 + 2] = int(color)
+        row += int(length)
+    return r0, c0, r1, c1
