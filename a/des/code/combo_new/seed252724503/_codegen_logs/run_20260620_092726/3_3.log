+    elif edge == "bottom":
+        dr, dc = -1, 0
+    elif edge == "left":
+        dr, dc = 0, 1
+    else:
+        dr, dc = 0, -1
+    return _band_cells(r, c, dr, dc, mapping[color], h, w)
+
+
+def _has_overlap(
+    seeds: Sequence[Tuple[int, int, str, int]],
+    mapping: Dict[int, int],
+    shape: Tuple[int, int],
+    legend_bbox: Tuple[int, int, int, int],
+) -> bool:
+    r0, c0, r1, c1 = legend_bbox
