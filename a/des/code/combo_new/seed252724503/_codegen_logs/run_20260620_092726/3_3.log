+def _seed_direction(r: int, c: int, h: int, w: int) -> Tuple[int, int]:
+    if r == 0:
+        return 1, 0
+    if c == 0:
+        return 0, 1
+    if c == w - 1:
+        return 0, -1
+    if r == h - 1:
+        return -1, 0
