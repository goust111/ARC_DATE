+def _greedy_rooms(candidates: list[Room]) -> list[Room]:
+    rooms: list[Room] = []
+    occupied = 0
+    for room in sorted(
+        candidates,
+        key=lambda r: (r.interior_area, r.bbox[0], r.bbox[1], r.bbox[2], r.bbox[3]),
+    ):
+        if room.interior_bits & occupied:
+            continue
+        rooms.append(room)
+        occupied |= room.interior_bits
+    return rooms
+
