+    inp = canvas[r0 : r1 + 1, c0 : c1 + 1]
+    out = expected[r0 : r1 + 1, c0 : c1 + 1]
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        built = _build_scene()
+        if built is None:
+            continue
+        inp, out = built
+        if inp.ndim != 2 or out.ndim != 2:
+            continue
+        if max(inp.shape) > GRID_LIMIT or max(out.shape) > GRID_LIMIT:
