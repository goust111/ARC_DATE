+GRID_LIMIT = 30
+CANVAS_SIZE = 30
+CHAIN_COUNT_OPTIONS = (1, 1, 2)
+CASE_TYPES = ("one_end", "both_ends_no_tie", "both_ends_tie")
+ORIENTATIONS = ("horizontal", "vertical")
+MARGIN_RANGE = (1, 8)
+CHAIN_GAP = 2
+GEN_RETRIES = 400
