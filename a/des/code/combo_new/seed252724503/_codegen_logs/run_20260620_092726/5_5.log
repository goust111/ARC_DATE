+def _detect_rooms(grid: np.ndarray, bg: int) -> list[Room]:
+    candidates = _find_candidates(grid, bg)
+    greedy = _greedy_rooms(candidates)
+    if _selected_rooms_valid(greedy, bg):
+        return greedy
+    return _search_rooms(candidates, bg)
