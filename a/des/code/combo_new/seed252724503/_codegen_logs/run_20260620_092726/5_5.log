+    bboxes: list[tuple[int, int, int, int]] = []
+    order = list(range(len(specs)))
+    random.shuffle(order)
+
+    for idx in order:
+        h, w = specs[idx]["shape"]
+        positions = [
+            (r, c)
+            for r in range(CANVAS_SIZE - h + 1)
+            for c in range(CANVAS_SIZE - w + 1)
