+
+def _components(adjacency: dict[int, list[int]]) -> list[list[int]]:
+    seen: set[int] = set()
+    components: list[list[int]] = []
+    for start in adjacency:
+        if start in seen:
+            continue
+        comp: list[int] = []
+        queue = deque([start])
+        seen.add(start)
+        while queue:
+            cur = queue.popleft()
+            comp.append(cur)
+            for nxt in adjacency[cur]:
+                if nxt not in seen:
+                    seen.add(nxt)
+                    queue.append(nxt)
+        components.append(comp)
+    return components
+
+
+def _ordered_chain(room_ids: list[int], adjacency: dict[int, list[int]], rooms: list[Room]) -> list[int]:
+    if len(room_ids) == 1:
+        return room_ids
+    endpoints = [idx for idx in room_ids if len(adjacency[idx]) == 1]
+    assert len(endpoints) == 2
+    start = min(endpoints, key=lambda idx: (rooms[idx].bbox[1], rooms[idx].bbox[0]))
+    ordered = [start]
+    prev = -1
+    cur = start
+    while True:
+        next_nodes = [idx for idx in adjacency[cur] if idx != prev]
+        if not next_nodes:
+            break
+        nxt = next_nodes[0]
+        ordered.append(nxt)
+        prev, cur = cur, nxt
+    return ordered
