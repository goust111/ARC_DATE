+    if not changed:
+        return None
+
+    r0, c0, r1, c1 = _crop_bounds(canvas)
+    inp = canvas[r0 : r1 + 1, c0 : c1 + 1]
+    out = expected[r0 : r1 + 1, c0 : c1 + 1]
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
