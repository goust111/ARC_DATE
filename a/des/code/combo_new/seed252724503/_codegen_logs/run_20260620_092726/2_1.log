+    border = colors[0]
+    keys = colors[1 : 1 + n_keys]
+    texture_pool = colors[1 + n_keys :]
+    return border, keys, texture_pool
+
+
+def _make_mapping(rng: random.Random, keys: list[int], seg_len: int, texture_pool: list[int]) -> dict[int, tuple[int, ...]]:
