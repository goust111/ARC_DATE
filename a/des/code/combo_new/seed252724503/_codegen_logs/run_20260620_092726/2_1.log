+        end = start + seg_len
+        grid[start:end, -2] = key
+        grid[start:end, -1] = np.array(mapping[key], dtype=int)
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    orientation = rng.choice(ORIENTATIONS)
