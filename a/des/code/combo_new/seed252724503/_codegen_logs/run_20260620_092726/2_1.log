+
+            core[r0, c0 : c1 + 1] = border
+            core[r1, c0 : c1 + 1] = border
+            core[r0 : r1 + 1, c0] = border
+            core[r0 : r1 + 1, c1] = border
+
+            mr = rng.randint(r0 + 1, r1 - 1)
+            mc = rng.randint(c0 + 1, c1 - 1)
+            core[mr, mc] = key
+
+            occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True
+            frames.append((r0, c0, r1, c1, key))
+            placed = True
+            break
+
+        if not placed:
