+def _is_alternating(segment: np.ndarray) -> bool:
+    vals = [int(v) for v in segment.tolist()]
+    if len(vals) < 2 or vals[0] == vals[1]:
+        return False
+    for idx, val in enumerate(vals):
+        if val != vals[idx % 2]:
