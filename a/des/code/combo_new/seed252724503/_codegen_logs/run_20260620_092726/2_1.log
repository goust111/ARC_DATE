+        grid[-1, start:end] = np.array(mapping[key], dtype=int)
+    return grid
+
+
+def _render_with_right_legend(
+    rng: random.Random,
+    core: np.ndarray,
+    keys: list[int],
+    mapping: dict[int, tuple[int, ...]],
