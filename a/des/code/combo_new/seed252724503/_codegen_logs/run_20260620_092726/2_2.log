+
+
+def _paint_seeds(base: np.ndarray, seeds: dict[tuple[int, int], int]) -> np.ndarray:
+    grid = base.copy()
+    for (r, c), color in seeds.items():
+        grid[r, c] = int(color)
+    return grid
+
+
+def _build_base_grid(
+    h: int,
