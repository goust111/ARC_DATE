MAX_OBJECT_COUNT = 7
SHORT_SIDE_SIZES = (2, 3, 4, 5, 6)
LONG_SIDE_FACTOR = 2
WIDE = "wide"
TALL = "tall"
ORIENTATIONS = [WIDE, TALL]

