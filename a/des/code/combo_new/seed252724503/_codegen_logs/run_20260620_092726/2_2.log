+    bg: int,
+    divider_color: int,
+    ruler_mask: np.ndarray,
+    size_by_color: dict[int, int],
+    collect_stats: bool = False,
+) -> tuple[np.ndarray, int, int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+    seed_coords = np.argwhere((g != bg) & (g != divider_color) & (~ruler_mask))
