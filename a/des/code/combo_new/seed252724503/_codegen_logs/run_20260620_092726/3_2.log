+    blocked[marker_row, marker_cols] = True
+    visited = np.zeros((h, w), dtype=bool)
+    fragments: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or blocked[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
