+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+BACKGROUND = 0
+MARKER_COLOR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+PAIR_COUNT_CHOICES = (2, 3, 4)
+ALLOWED_RECTANGLES = ((2, 3), (3, 3), (4, 3), (2, 5))
