+    sh, sw = stamp.shape
+    oh, ow = sh + 2, sw + 2
+    bottom = top + oh - 1
+    right = left + ow - 1
+    grid[top : bottom + 1, left] = FRAME
+    grid[top : bottom + 1, right] = FRAME
+    grid[top, left : right + 1] = FRAME
+    grid[bottom, left : right + 1] = FRAME
+    grid[top + 1 : top + 1 + sh, left + 1 : left + 1 + sw] = stamp
