+def _stamp(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    ph, pw = patch.shape
+    r0 = max(0, int(top))
+    c0 = max(0, int(left))
+    r1 = min(out.shape[0], int(top) + ph)
+    c1 = min(out.shape[1], int(left) + pw)
+    if r0 >= r1 or c0 >= c1:
+        return
+    out[r0:r1, c0:c1] = patch[r0 - top : r1 - top, c0 - left : c1 - left]
