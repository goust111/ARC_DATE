+    first_pos: dict[int, tuple[int, int]] = {}
+    color_order: list[int] = []
+    for r, c in ordered_path:
+        color = int(g[r, c])
+        if color not in first_pos:
+            first_pos[color] = (int(r), int(c))
+            color_order.append(color)
