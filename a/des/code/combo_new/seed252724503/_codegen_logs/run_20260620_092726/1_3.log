+        marker_cells: set[tuple[int, int]] = set()
+        for c in range(c0, c1 + 1):
+            if r0 > 0:
+                marker_cells.add((r0 - 1, c))
+            if r1 + 1 < h:
+                marker_cells.add((r1 + 1, c))
+        for r in range(r0, r1 + 1):
