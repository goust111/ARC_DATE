+        return False
+    pts = set(points)
+    expected = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
+    if len(pts) != expected:
+        return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pts or (r, c1) not in pts:
+            return False
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return False
+    return True
