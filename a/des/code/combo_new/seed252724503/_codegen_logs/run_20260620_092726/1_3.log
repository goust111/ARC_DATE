+
+BG = 0
+FRAME = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
+MIN_ZONE_H = 6
+MIN_ZONE_W = 6
