+        for r, c in marker_choices
+        if 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1] and grid[r, c] == BG
+    ]
+    mr, mc = rng.choice(valid)
+    grid[mr, mc] = int(marker_color)
