+        degrees = []
+        for r, c in pts:
+            deg = sum((nr, nc) in pset for nr, nc in _neighbors4(r, c))
+            degrees.append(deg)
+        if degrees.count(1) == 2 and all(deg <= 2 for deg in degrees):
