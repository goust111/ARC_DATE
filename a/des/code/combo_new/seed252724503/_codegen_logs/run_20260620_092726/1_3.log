+def _assign_path_colors(
+    rng: random.Random,
+    intro_order: list[int],
+    intro_positions: list[int],
+    length: int,
+) -> list[int] | None:
+    pos_to_color = {int(pos): int(color) for pos, color in zip(intro_positions, intro_order, strict=False)}
+    sequence: list[int] = []
+    introduced: list[int] = []
+    prev: int | None = None
+
+    for idx in range(length):
