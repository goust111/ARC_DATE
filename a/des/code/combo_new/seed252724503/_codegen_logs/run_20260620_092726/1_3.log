+    base = colors[0]
+    patch = np.full((h, w), base, dtype=int)
+    mode = rng.choice(["stripes", "checker", "scatter"])
+
+    if mode == "stripes":
+        if h >= w:
+            cut = rng.randint(1, h - 1)
+            patch[cut:, :] = colors[1]
+        else:
