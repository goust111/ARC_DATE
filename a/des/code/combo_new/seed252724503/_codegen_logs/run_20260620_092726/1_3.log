+def _layout_frames(
+    rng: random.Random,
+    stamps: list[np.ndarray],
+    side: str,
+) -> tuple[tuple[int, int], list[tuple[int, int]], tuple[int, int, int, int]] | None:
+    outer_shapes = [(stamp.shape[0] + 2, stamp.shape[1] + 2) for stamp in stamps]
