+def _path_component(grid: np.ndarray, frames: list[dict], bg: int) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    mask = grid != bg
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        mask[r0 : r1 + 1, c0 : c1 + 1] = False
