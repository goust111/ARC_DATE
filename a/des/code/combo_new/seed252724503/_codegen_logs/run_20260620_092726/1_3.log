+    strip = max(w for _h, w in outer_shapes) + 2
+    span = sum(h for h, _w in outer_shapes) + gap * (n - 1)
+    min_h = max(span + 2, max_sh + MIN_ZONE_H + 1)
+    min_w = strip + max_sw + MIN_ZONE_W + 1
+    if min_h > 30 or min_w > 30:
+        return None
