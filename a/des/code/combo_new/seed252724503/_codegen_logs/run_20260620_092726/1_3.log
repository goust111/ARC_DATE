+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
+MIN_ZONE_H = 6
+MIN_ZONE_W = 6
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in points]
+    cols = [c for _r, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_rect_frame(points: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(points)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    pts = set(points)
+    expected = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
+    if len(pts) != expected:
+        return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pts or (r, c1) not in pts:
+            return False
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return False
+    return True
+
+
