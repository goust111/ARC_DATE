+        dr, dc = -1 - max(rows), 0
+    elif opening == "down":
+        dr, dc = height - min(rows), 0
+    elif opening == "left":
+        dr, dc = 0, -1 - max(cols)
+    else:
+        dr, dc = 0, width - min(cols)
