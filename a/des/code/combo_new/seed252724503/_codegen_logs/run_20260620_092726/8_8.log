+def _final_bbox(bbox: tuple[int, int, int, int], shape: tuple[int, int], direction: str) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    h, w = shape
+    bh = r1 - r0 + 1
+    bw = c1 - c0 + 1
+    if direction == "up":
+        return 0, c0, bh - 1, c1
+    if direction == "down":
+        return h - bh, c0, h - 1, c1
+    if direction == "left":
+        return r0, 0, r1, bw - 1
+    if direction == "right":
+        return r0, w - bw, r1, w - 1
+    raise ValueError(f"unknown direction: {direction}")
