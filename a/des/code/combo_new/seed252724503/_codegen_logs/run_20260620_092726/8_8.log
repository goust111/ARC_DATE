+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+TRAIL = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
+GEN_RETRIES = 500
+PLACE_RETRIES = 200
