+    elif direction == "left":
+        out[r0 : r1 + 1, 0 : c1 + 1] = TRAIL
+    elif direction == "right":
+        out[r0 : r1 + 1, c0:w] = TRAIL
+    else:
+        raise ValueError(f"unknown direction: {direction}")
