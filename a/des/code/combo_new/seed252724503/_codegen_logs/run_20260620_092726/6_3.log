        target = rng.randint(max(7, (h * w) // 3), max(8, (2 * h * w) // 3))
        while int(mask.sum()) < target:
            frontier = []
            for r, c in np.argwhere(mask):
                for nr, nc in _neighbors4(int(r), int(c)):
                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
                        frontier.append((nr, nc))
