+        r0, c0, r1, c1 = _bbox(comp)
+        if r0 == 0 or c0 == 0 or r1 == mask.shape[0] - 1 or c1 == mask.shape[1] - 1:
+            continue
+        holes += 1
+    return holes
+
+
+def _is_rect_frame(coords: np.ndarray) -> bool:
