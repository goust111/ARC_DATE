+        for obj, slot in zip(objs, slots):
+            thumb = _fit_thumbnail(np.asarray(obj["mask"], dtype=bool), slot["r1"] - slot["r0"] - 1, slot["c1"] - slot["c0"] - 1)
+            rr0 = slot["r0"] + 1
+            cc0 = slot["c0"] + 1
+            out[rr0 : rr0 + thumb.shape[0], cc0 : cc0 + thumb.shape[1]][thumb] = int(obj["color"])
