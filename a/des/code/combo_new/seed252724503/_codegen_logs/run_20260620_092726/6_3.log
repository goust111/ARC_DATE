+    y_positions = [rng.randint(0, upper_h - obj_h) for obj_h in obj_heights]
+
+    grid = np.full((total_h, width), BG, dtype=int)
+    sep_r = upper_h
+    grid[sep_r, :] = GRAY
+
+    for mask, color, top, left in zip(scaled_masks, colors, y_positions, x_positions):
