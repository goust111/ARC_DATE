+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return mask[:0, :0]
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    bg_mask = ~mask
+    holes = 0
+    for comp in _components(bg_mask):
+        r0, c0, r1, c1 = _bbox(comp)
+        if r0 == 0 or c0 == 0 or r1 == mask.shape[0] - 1 or c1 == mask.shape[1] - 1:
+            continue
+        holes += 1
+    return holes
+
+
+def _is_rect_frame(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0 + 1, r1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    actual = {(int(r), int(c)) for r, c in coords}
+    return actual == expected
+
+
+def _resize_mask(mask: np.ndarray, out_h: int, out_w: int) -> np.ndarray:
+    if mask.shape == (out_h, out_w):
+        return mask.copy()
+    src_h, src_w = mask.shape
+    row_idx = np.clip(
+        np.round((np.arange(out_h) + 0.5) * src_h / out_h - 0.5).astype(int),
+        0,
+        src_h - 1,
+    )
+    col_idx = np.clip(
+        np.round((np.arange(out_w) + 0.5) * src_w / out_w - 0.5).astype(int),
+        0,
+        src_w - 1,
+    )
