+            length = rng.randint(1, min(3, c1 - c0 + 1))
+            start = rng.randint(c0, c1 - length + 1)
+            row = r0 - 1 if side == "top" else r1 + 1
+            canvas[row, start : start + length] = True
+        else:
+            length = rng.randint(1, min(3, r1 - r0 + 1))
