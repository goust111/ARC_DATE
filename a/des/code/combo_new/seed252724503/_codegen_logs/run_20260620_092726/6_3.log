+BG = 0
+GRAY = 5
+OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 300
+SLOT_COUNT = 3
+SLOT_OUTER = 9
+SLOT_INNER = SLOT_OUTER - 2
+SLOT_STEP = SLOT_OUTER + 1
+LOWER_HEIGHT = SLOT_OUTER + 2
