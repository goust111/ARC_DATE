+        mask[comp[:, 0] - r0, comp[:, 1] - c0] = True
+        holes = _count_holes(mask)
+        center_x = float(comp[:, 1].mean())
+        objects_by_holes[holes].append({"color": color, "mask": mask, "x": center_x})
