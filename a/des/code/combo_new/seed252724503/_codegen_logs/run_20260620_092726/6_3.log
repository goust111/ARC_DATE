            nr, nc = rng.choice(frontier)
            mask[nr, nc] = True
            if rng.random() < 0.2:
                extra_frontier = [
                    (er, ec)
                    for er, ec in _neighbors4(nr, nc)
                    if 0 <= er < h and 0 <= ec < w and not mask[er, ec]
                ]
                if extra_frontier:
                    er, ec = rng.choice(extra_frontier)
                    mask[er, ec] = True
