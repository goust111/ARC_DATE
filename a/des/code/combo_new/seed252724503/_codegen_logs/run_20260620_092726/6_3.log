+
+def _fit_thumbnail(mask: np.ndarray, target_h: int, target_w: int) -> np.ndarray:
+    src_h, src_w = mask.shape
+    scale = min(target_h / src_h, target_w / src_w)
+    out_h = max(1, min(target_h, int(round(src_h * scale))))
