+    for _ in range(80):
+        random.shuffle(cells)
+        chosen: list[tuple[int, int]] = []
+        for r, c in cells:
+            if all(max(abs(r - rr), abs(c - cc)) > 1 for rr, cc in chosen):
+                chosen.append((int(r), int(c)))
+                if len(chosen) == hole_count:
+                    return chosen
