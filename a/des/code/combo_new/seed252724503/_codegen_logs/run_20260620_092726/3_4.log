            r1 = r0 + obj_h
            c1 = c0 + obj_w
            rr0 = max(0, r0 - margin)
            cc0 = max(0, c0 - margin)
            rr1 = min(h, r1 + margin)
            cc1 = min(w, c1 + margin)
