+    comps: list[tuple[int, list[tuple[int, int]]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
