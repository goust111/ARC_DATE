+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _hole_count(grid: np.ndarray, box: tuple[int, int, int, int], bg: int = BG) -> int:
+    r0, c0, r1, c1 = box
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if inner.size == 0:
