+def _trace_line(line: np.ndarray, gate_positions: list[int], start_color: int) -> tuple[list[tuple[int, int]], list[int]]:
+    line = np.asarray(line, dtype=int)
+    n = len(line)
+    assert n > 0 and int(line[0]) == int(start_color)
