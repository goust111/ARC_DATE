+        if (
+            bool(np.all(line[pos:gate] == int(start_color)))
+            and gate + 1 < n
+            and int(line[gate]) == GATE
+            and int(line[gate + 1]) == int(start_color)
+        ):
+            segments.append((int(pos), int(gate - 1)))
+            crossings.append(int(gate))
+            pos = int(gate + 1)
