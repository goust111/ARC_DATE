+import numpy as np
+
+BG = 0
+YELLOW = 4
+GRAY = 5
+TOWER_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+
+MIRROR_PARTNERS = {
+    "slash": ((-1, 1), (1, -1)),
+    "backslash": ((-1, -1), (1, 1)),
+}
+
+GENERATE_ATTEMPTS = 300
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _reflect(direction: tuple[int, int], mirror_kind: str) -> tuple[int, int]:
+    dr, dc = direction
+    if mirror_kind == "backslash":
+        return (dc, dr)
+    assert mirror_kind == "slash"
+    return (-dc, -dr)
+
+
+def _components8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        nr = cr + dr
+                        nc = cc + dc
+                        if not _in_bounds(mask.shape, nr, nc):
+                            continue
+                        if not bool(mask[nr, nc]) or bool(seen[nr, nc]):
+                            continue
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _detect_towers(grid: np.ndarray) -> list[dict[str, object]]:
+    towers: list[dict[str, object]] = []
+    for r in range(grid.shape[0]):
