+def _enumerate_blocker_pair_placements(
+    box: tuple[int, int, int, int],
+    shape: tuple[int, int],
+) -> list[dict[str, object]]:
+    r0, c0, r1, c1 = box
+    vdir, _hdir = _outer_dirs(box, shape)
+    placements: list[dict[str, object]] = []
