+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        nr = cr + dr
+                        nc = cc + dc
+                        if not _in_bounds(mask.shape, nr, nc):
+                            continue
+                        if not bool(mask[nr, nc]) or bool(seen[nr, nc]):
+                            continue
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _detect_towers(grid: np.ndarray) -> list[dict[str, object]]:
