+def _choose_fold_spec(mask: np.ndarray) -> dict:
+    candidates = _fold_candidates(mask)
+    assert candidates, "object has no valid fold axis"
+
+    best = candidates[0]
+    best_key = (
+        best["score"],
+        best["axis_preference"],
+        best["donor_count"],
+        best["keep_count"],
+    )
+    ties = [
+        item
+        for item in candidates
+        if (
+            item["score"],
+            item["axis_preference"],
+            item["donor_count"],
+            item["keep_count"],
+        )
+        == best_key
