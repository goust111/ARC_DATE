+            donor_present = False
+            mirror = _mirror_coord(r, c, spec["orientation"], spec["axis"])
+            if mirror is not None:
+                rr, cc = mirror
+                if 0 <= rr < h and 0 <= cc < w:
+                    donor_present = bool(mask[rr, cc])
