+def _is_exact_symmetry(mask: np.ndarray, orientation: str, axis: float) -> bool:
+    h, w = mask.shape
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+
+    for r, c in coords:
+        mirror = _mirror_coord(int(r), int(c), orientation, axis)
+        if mirror is None:
+            return False
+        rr, cc = mirror
+        if not (0 <= rr < h and 0 <= cc < w and mask[rr, cc]):
+            return False
