+                    frontier.add((nr, nc))
+
+        if not frontier:
+            break
+
+        choices = list(frontier)
+        weights = [3 if c > 0 else 1 for _, c in choices]
+        rr, cc = random.choices(choices, weights=weights, k=1)[0]
+        half[rr, cc] = True
+
