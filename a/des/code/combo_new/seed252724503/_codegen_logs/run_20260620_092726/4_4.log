+    out = np.zeros((h, w), dtype=int)
+
+    for r in range(h):
+        for c in range(w):
+            idx = c if spec["orientation"] == "v" else r
+            side = _side_name(idx, spec["orientation"], spec["axis"])
+            if side not in {"axis", spec["keep_side"]}:
+                continue
+
+            keep_present = bool(mask[r, c])
+            if side == "axis":
+                if keep_present:
+                    out[r, c] = color
+                continue
