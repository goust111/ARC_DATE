+        return None
+
+    if out.ndim != 2 or max(out.shape) > 30:
+        return None
+    if not np.any(out == OVERLAP_COLOR):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_TRIES):
+        grid = _gen_attempt()
+        if grid is not None:
