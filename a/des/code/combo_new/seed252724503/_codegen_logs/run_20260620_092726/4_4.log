+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+OVERLAP_COLOR = 2
+OBJECT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+MAX_GENERATION_TRIES = 300
+OBJECT_SHAPE_TRIES = 200
+MISSING_SIDE_TRIES = 200
+PACKING_TRIES = 100
