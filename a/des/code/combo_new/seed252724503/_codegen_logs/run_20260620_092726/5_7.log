+def _stamp_pattern(
+    out: np.ndarray,
+    pattern: np.ndarray,
+    anchor: tuple[int, int],
+    inner_bbox: tuple[int, int, int, int],
+    marker: tuple[int, int],
+    bg: int,
+) -> None:
+    ir0, ic0, ir1, ic1 = inner_bbox
+    ar, ac = anchor
+    mr, mc = marker
+    top = ir0 + mr - ar
+    left = ic0 + mc - ac
+    ph, pw = pattern.shape
+    for pr in range(ph):
+        tr = top + pr
+        if tr < ir0 or tr > ir1:
+            continue
+        for pc in range(pw):
+            tc = left + pc
+            if tc < ic0 or tc > ic1:
+                continue
+            color = int(pattern[pr, pc])
+            if color == bg:
+                continue
+            out[tr, tc] = color
