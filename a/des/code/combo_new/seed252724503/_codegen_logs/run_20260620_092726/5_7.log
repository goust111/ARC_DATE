+
+def _can_place_shape(canvas: np.ndarray, shape: np.ndarray, top: int, left: int, bg: int) -> bool:
+    h, w = shape.shape
+    if top < 0 or left < 0 or top + h > canvas.shape[0] or left + w > canvas.shape[1]:
