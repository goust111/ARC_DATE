+    extension_options = []
+    if ar - 2 >= 0:
+        extension_options.append((ar - 2, ac))
+    if ar + 2 < h:
+        extension_options.append((ar + 2, ac))
+    if ac - 2 >= 0:
+        extension_options.append((ar, ac - 2))
+    if ac + 2 < w:
+        extension_options.append((ar, ac + 2))
