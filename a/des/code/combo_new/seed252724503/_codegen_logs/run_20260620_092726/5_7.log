+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+ORANGE = 7
+BLUE = 1
+RED = 2
+
+ALL_COLORS = tuple(range(10))
+GEN_BG_CHOICES = (0, 3, 4, 5, 6, 8, 9)
+GEN_TEMPLATE_INNER_RANGE = (5, 7)
+GEN_TEMPLATE_EXTRA_SHAPES = (2, 4)
