+    template_inner = g[tr0 + 1 : tr1, tc0 + 1 : tc1]
+    pattern, anchor = _recover_template(template_inner, bg)
+    ar, ac = anchor
+    out[tr0 + 1 + ar, tc0 + 1 + ac] = pattern[ar, ac]
+
