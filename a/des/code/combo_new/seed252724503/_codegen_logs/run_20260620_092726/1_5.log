+    if not np.all(grid[-2] == BG):
+        return None
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if out.ndim != 2 or max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
