+
+def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            colors = set()
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                colors.add(int(grid[rr, cc]))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(
+                {
+                    "coords": np.array(coords, dtype=int),
+                    "bbox": (r0, c0, r1, c1),
+                    "colors": colors,
+                }
+            )
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == int(mask.sum())
