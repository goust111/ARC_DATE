+    for r in range(h):
+        for c in (0, w - 1):
+            if not boundary_mask[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not boundary_mask[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if boundary_mask[nr, nc] or reachable[nr, nc]:
+                continue
+            reachable[nr, nc] = True
+            q.append((nr, nc))
