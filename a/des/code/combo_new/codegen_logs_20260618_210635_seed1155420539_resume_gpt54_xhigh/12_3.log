+    specs.sort(key=lambda spec: spec["boundary"].shape[0] * spec["boundary"].shape[1], reverse=True)
+
+    grid = np.full((grid_h, grid_w), BG, dtype=int)
+    expected = grid.copy()
+    occ = np.zeros((grid_h, grid_w), dtype=bool)
+
+    for spec in specs:
+        placed = _place_spec(grid, occ, spec, rng)
+        if placed is None:
