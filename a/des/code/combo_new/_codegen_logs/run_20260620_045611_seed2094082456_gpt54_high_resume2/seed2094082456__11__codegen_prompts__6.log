{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pprint import pprint\nimport numpy as np\n\np = '/home/lixinyu/snap/a/des/code/combo_new/seed2094082456/11/6.py'\nmod = SourceFileLoader('arc6_dbg', p).load_module()\nrng = np.random.default_rng()\nfor attempt in range(1000):\n    obj_count = int(rng.integers(*mod.OBJECT_COUNT_RANGE))\n    h = int(rng.integers(*mod.GRID_HEIGHT_RANGE))\n    w = int(rng.integers(*mod.GRID_WIDTH_RANGE))\n    bg = int(rng.integers(0, len(mod.PALETTE)))\n    colors = [color for color in mod.PALETTE if color \"'!= bg]\n    rng.shuffle(colors)\n    colors = colors[:obj_count]\n    moves = mod._direction_sequence(rng, obj_count)\n\n    occupied_input = set()\n    reserved_input = set()\n    occupied_output = set()\n    reserved_output = set()\n    specs = []\n    ok = True\n    for color, move in zip(colors, moves):\n        spec = mod._try_place_scenario(rng, (h, w), move, occupied_input, reserved_input, occupied_output, reserved_output)\n        if spec is None:\n            ok = False\n            break\n        spec['\"'color'] = color\n        specs.append(spec)\n        input_cells = set(spec['input_cells'])\n        output_cells = set(spec['output_cells'])\n        beacon = spec['beacon']\n        gap_cells = set(spec['gap_cells'])\n        input_colored = input_cells | {beacon}\n        output_colored = output_cells | {beacon}\n        occupied_input |= input_colored\n        reserved_input |= mod._expand_cells(input_colored, (h, w))\n        reserved_input |= gap_cells\n        occupied_output |= output_colored\n        reserved_output |= mod._expand_cells(output_colored, (h, w))\n    if not ok:\n        continue\n\n    grid = np.full((h, w), bg, dtype=int)\n    for spec in specs:\n        color = int(spec['color'])\n        br, bc = spec['beacon']\n        grid[br, bc] = color\n        for r, c in spec['input_cells']:\n            grid[r, c] = color\n\n    try:\n        out = mod.main(grid)\n    except AssertionError as exc:\n        print('attempt', attempt, 'failed:', exc)\n        print('shape', grid.shape, 'bg', bg)\n        print(grid)\n        for color in [int(v) for v in np.unique(grid) if int(v) \"'!= bg]:\n            comps = mod._components_of_color(grid, color)\n            print('\"'color', color, 'component sizes', [len(c) for c in comps])\n            for comp in comps:\n                print(sorted(comp))\n            obj = [comp for comp in comps if len(comp) > 1][0]\n            beacon = [comp[0] for comp in comps if len(comp) == 1][0]\n            print('pair', color, 'beacon', beacon)\n            try:\n                print('translation', mod._translation_for_pair(grid, bg, obj, beacon))\n            except AssertionError as exc2:\n                print('translation failed', exc2)\n        break\nelse:\n    print('no failures found')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
