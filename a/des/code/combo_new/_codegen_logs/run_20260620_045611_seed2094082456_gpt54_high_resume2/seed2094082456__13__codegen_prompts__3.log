{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n    '/home/lixinyu/snap/new/ARC_code/train/9473c6fb.py',\n    '/home/lixinyu/snap/new/ARC_code/train/57edb29d.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n    '/home/lixinyu/snap/new/ARC_code/train/d749d46f.py',\n    '/home/lixinyu/snap/new/ARC_code/train/d6e50e54.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/31f7f899.py',\n    '/home/lixinyu/snap/new/ARC_code/eval/f560132c.py',\n]\nfor path in paths:\n    print(f'=== {path} ===')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for i, line in enumerate(lines):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            print(f'-- {i+1}: {line}')\n            j = i\n            while j < len(lines):\n                if j > i and lines[j].startswith('def ') and not lines[j].startswith('def main(') and not lines[j].startswith('def generate_input('):\n                    break\n                if j > i and (lines[j].startswith('class ') or lines[j].startswith('if __name__')):\n                    break\n                print(lines[j])\n                j += 1\n            print()\nPY\"","aggregated_output":"=== /home/lixinyu/snap/new/ARC_code/train/9473c6fb.py ===\n-- 9: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the sparse foreground pixels in scan order along their longer spread, cycling red, teal, and grey.\n\n    Input structure:\n    - The dominant color is the background.\n    - Every foreground object is a single isolated 4-connected pixel.\n    - The foreground pixel set has a rectangular bbox whose row or column extent defines the scan direction.\n\n    Rule:\n    - Keep the background unchanged.\n    - If the foreground bbox is at least as tall as it is wide, order foreground pixels row-major; otherwise order them column-major.\n    - Recolor the ordered pixels by repeating red, teal, grey from the first pixel onward.\n\n    Key insight:\n    - The original foreground colors are only markers; the output color depends on each marker's ordinal position in the dominant scan direction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg not in _CYCLE, \"background must be distinct from the output color cycle\"\n\n    fg = g != bg\n    coords = coords_where(fg)\n    assert len(coords) > 0, \"expected at least one foreground marker\"\n\n    coords_list = [(int(r), int(c)) for r, c in coords]\n    for r, c in coords_list:\n        assert all(\n            not in_bounds(g.shape, nr, nc) or int(g[nr, nc]) == bg\n            for nr, nc in neighbors4(r, c)\n        ), \"foreground markers must be isolated 4-connected pixels\"\n\n    r0, c0, r1, c1 = bbox_coords(coords)\n    row_extent = int(r1 - r0 + 1)\n    col_extent = int(c1 - c0 + 1)\n    if row_extent >= col_extent:\n        ordered = sorted(coords_list)\n    else:\n        ordered = sorted(coords_list, key=lambda rc: (rc[1], rc[0]))\n\n    out = g.copy()\n    for i, (r, c) in enumerate(ordered):\n        out[r, c] = _CYCLE[i % len(_CYCLE)]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nimport random\n\n# Canvas and marker density bounds.\nHEIGHT_RANGE = range(6, 10)\nWIDTH_RANGE = range(8, 13)\nMARKER_COUNT_RANGE = (6, 10)\nDENSITY_RANGE = (0.09, 0.15)\n# Bbox span and palette constraints.\nMIN_CROSS_SPAN = 3\nPALETTE_SIZE_RANGE = (3, 4)\nBACKGROUND_COLORS = [0, 1, 3, 4, 6, 7, 9]\nPREFERRED_BACKGROUND = 7\nPREFERRED_BACKGROUND_RATE = 0.6\nOUTPUT_CYCLE = (2, 8, 5)\n# Generation retry limit.\nMAX_ATTEMPTS = 300\n\n\n\n-- 195: def generate_input():\ndef generate_input():\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 9473c6fb input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/57edb29d.py ===\n-- 87: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\n\n\n-- 450: def generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py ===\n-- 101: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\n\n-- 604: def generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py ===\n-- 31: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\n\n-- 226: def generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/d6e50e54.py ===\n-- 7: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move each maroon marker toward the blue rectangle and recolor the rectangle red.\n\n    Input structure\n    A background canvas contains one solid blue rectangular object and several isolated\n    maroon marker pixels. Each marker is horizontally or vertically aligned with the\n    rectangle and lies outside it.\n\n    Rule\n    Start with a background canvas, repaint the blue rectangle red, and move each\n    maroon marker straight toward the rectangle along its row or column. Exactly one\n    marker is strictly closer to the rectangle than all others and enters the\n    rectangle boundary; every other marker lands in the adjacent exterior cell just\n    outside its aligned side.\n\n    Key insight\n    The single entering marker is the unique global nearest marker to the rectangle,\n    not the nearest marker on each of the four sides.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    rectangles = []\n    markers = []\n    for comp in components:\n        h = bbox_h(comp[\"bbox\"])\n        w = bbox_w(comp[\"bbox\"])\n        if comp[\"area\"] == h * w and comp[\"area\"] > 1:\n            rectangles.append(comp)\n        elif comp[\"area\"] == 1:\n            markers.append(comp)\n\n    assert len(rectangles) == 1\n    assert markers\n    rect = rectangles[0]\n    rect_color = int(rect[\"color\"])\n    marker_colors = {int(comp[\"color\"]) for comp in markers}\n    assert marker_colors == {Color.MAROON}\n    marker_color = Color.MAROON\n    assert rect_color == Color.BLUE\n    assert set(map(int, g.flat)) == {bg, rect_color, marker_color}\n\n    r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n    h = bbox_h(rect[\"bbox\"])\n    w = bbox_w(rect[\"bbox\"])\n\n    out = np.full_like(g, bg)\n    out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED\n\n    destinations = []\n    marker_entries: list[tuple[int, tuple[int, int], bool]] = []\n    for comp in markers:\n        r, c = map(int, comp[\"coords\"][0])\n        candidates = []\n        if c0 <= c <= c1 and r < r0:\n            d = r0 - r\n            enters = d < h\n            candidates.append((r0 if enters else r0 - 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if c0 <= c <= c1 and r > r1:\n            d = r - r1\n            enters = d < h\n            candidates.append((r1 if enters else r1 + 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c < c0:\n            d = c0 - c\n            enters = d < w\n            candidates.append((r, c0 if enters else c0 - 1))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c > c1:\n            d = c - c1\n            enters = d < w\n            candidates.append((r, c1 if enters else c1 + 1))\n            marker_entries.append((d, (r, c), enters))\n\n        assert len(candidates) == 1\n        dr, dc = candidates[0]\n        assert in_bounds(g.shape, dr, dc)\n        assert (dr, dc) not in destinations\n        destinations.append((dr, dc))\n\n    min_dist = min(dist for dist, _pos, _enters in marker_entries)\n    nearest = [pos for dist, pos, _enters in marker_entries if dist == min_dist]\n    entering = [pos for _dist, pos, enters in marker_entries if enters]\n    assert len(nearest) == 1, \"the nearest marker to the rectangle must be unique\"\n    assert len(entering) == 1, \"exactly one marker may enter the rectangle\"\n    assert entering[0] == nearest[0], \"the entering marker must be the global nearest\"\n\n    for r, c in destinations:\n        out[r, c] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nRECT_SIDE_MIN, RECT_SIDE_MAX = 3, 5\nGRID_TO_RECT_RATIO_MIN, GRID_TO_RECT_RATIO_MAX = 2, 4\nMARKER_COUNT_MAX = 7\nSIDE_COUNT_MIN, SIDE_COUNT_MAX = 2, 4\nMIN_POSITION_SIDES_WITH_MARGIN, MIN_POSITION_MARGIN = 2, 2\nCLOSE_DIST_MIN, DIST_MAX = 2, 7\nKIND_CLOSE, KIND_FAR = \"close\", \"far\"\nBG_COLOR, RECT_INPUT_COLOR, RECT_OUTPUT_COLOR, MARKER_COLOR = 7, 1, 2, 9\nGEN_RETRIES = 300\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = \"top\", \"bottom\", \"left\", \"right\"\nHORIZONTAL_SIDES = (SIDE_TOP, SIDE_BOTTOM)\n\n\n-- 336: def generate_input():\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate d6e50e54 input\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py ===\n-- 228: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n                # Orientation must be perpendicular to the edge it touches.\n                rs = [r for r, _ in comp]\n                cs = [c for _, c in comp]\n                vertical = len(set(cs)) == 1\n                border_ep = e0 if touch0 else e1\n                if vertical:\n                    if border_ep[0] not in (0, h - 1):\n                        continue\n                else:\n                    if border_ep[1] not in (0, w - 1):\n                        continue\n                terminal_ep = e1 if touch0 else e0\n                # Must have an attached non-bg neighbor at terminal.\n                tr, tc = terminal_ep\n                if not any(\n                    0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n                    for nr, nc in neighbors4(tr, tc)\n                ):\n                    continue\n                yield col, comp, terminal_ep\n\n    # Process all valid bars; compute moves based on the original grid.\n    moves = []  # list of (seg_comp_pts, seg_color, new_pts)\n    for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n        # Segment neighbor candidates at terminal.\n        neigh = []\n        for nr, nc in neighbors4(terminal[0], terminal[1]):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg and v != bar_col:\n                    neigh.append((v, (nr, nc)))\n        assert neigh, f\"bar terminal {terminal} must have a non-bg/non-bar neighbor\"\n\n        # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.\n        best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)\n        for cand_col, cand_start in neigh:\n            for comp in _components(g, cand_col, conn8=True):\n                if cand_start in comp:\n                    if len(comp) < 2:\n                        break\n                    deg = _segment_degrees(comp)\n                    if deg.get(cand_start, 0) != 1:\n                        break\n                    path = _segment_main_path(comp, cand_start)\n                    L = len(path)\n                    key = (L, len(comp), cand_col, cand_start[0], cand_start[1])\n                    if best_seg is None or key > best_seg[0]:\n                        best_seg = (key, cand_col, cand_start, comp)\n                    break\n        assert best_seg is not None, f\"no valid segment for bar at {terminal}\"\n        (L, _, _, _, _), seg_col, seg_start, seg_comp = best_seg\n\n        # Nearest obstacle component (any other non-bg color) to the terminal.\n        obstacle_candidates = [c for c in colors if c not in (bar_col, seg_col)]\n        assert obstacle_candidates, \"must have at least one obstacle color distinct from bar and segment\"\n\n        best = None  # (dist, min_r, min_c)\n        obstacle_set = None\n        for col in obstacle_candidates:\n            for comp in _components(g, col, conn8=True):\n                d = min(abs(r - terminal[0]) + abs(c - terminal[1]) for r, c in comp)\n                mr = min(r for r, _ in comp)\n                mc = min(c for _, c in comp)\n                key = (d, mr, mc)\n                if best is None or key < best:\n                    best = key\n                    obstacle_set = set(comp)\n        assert obstacle_set is not None, \"must find at least one obstacle component\"\n\n        off_r = seg_start[0] - terminal[0]\n        off_c = seg_start[1] - terminal[1]\n\n        # Path from terminal to obstacle (prefer monotone manhattan decrease).\n        walkable = (g == bg) | (g == seg_col)\n        walkable[terminal] = True\n        # Choose an obstacle pixel so that the translated endpoint (p_near + offset) lies OUTSIDE the obstacle,\n        # i.e. the segment connects to the obstacle \"skin\" rather than landing inside the obstacle and wasting length.\n        def pick_p_near() -> tuple[int, int]:\n            good = []\n            for pr, pc in obstacle_set:\n                er, ec = pr + off_r, pc + off_c\n                if not (0 <= er < h and 0 <= ec < w):\n                    continue\n                if (er, ec) in obstacle_set:\n                    continue\n                if int(g[er, ec]) not in (bg, seg_col):\n                    continue\n                d = abs(pr - terminal[0]) + abs(pc - terminal[1])\n                good.append((d, pr, pc))\n            assert good, \"no obstacle pixel has a valid translated endpoint outside obstacle\"\n            _, pr, pc = min(good)\n            return (pr, pc)\n\n        p_near = pick_p_near()\n        walkable[p_near] = True\n        path_t_to_obs = _greedy_manhattan_path(terminal, p_near, walkable) or _bfs_path(terminal, p_near, walkable)\n        assert path_t_to_obs is not None, f\"no path from terminal {terminal} to obstacle {p_near}\"\n        shifted = [(r + off_r, c + off_c) for r, c in path_t_to_obs]\n        assert all(0 <= r < h and 0 <= c < w for r, c in shifted), \\\n            \"shifted segment path must stay within grid\"\n        assert shifted and shifted[0] == seg_start, \\\n            \"shifted path must start at seg_start\"\n        entry = shifted[-1]\n\n        # Obstacle-adjacent skin.\n        skin = set()\n        for r, c in obstacle_set:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in obstacle_set:\n                    skin.add((nr, nc))\n\n        # Pick exit as the farthest walkable skin cell from the terminal (ties resolved by projecting away).\n        # Use obstacle centroid direction as an 'away' vector.\n        cr = sum(r for r, _ in obstacle_set) / len(obstacle_set)\n        cc = sum(c for _, c in obstacle_set) / len(obstacle_set)\n        away = (cr - terminal[0], cc - terminal[1])\n\n        def skin_ok(p):\n            r, c = p\n            return int(g[r, c]) == bg or int(g[r, c]) == seg_col\n\n        skin_candidates = [p for p in skin if skin_ok(p)] + [entry]\n        def exit_key(p):\n            r, c = p\n            md = abs(r - terminal[0]) + abs(c - terminal[1])\n            dot = (r - terminal[0]) * away[0] + (c - terminal[1]) * away[1]\n            return (md, dot, -r, -c)\n\n        exit_cell = max(skin_candidates, key=exit_key)\n\n        # BFS along skin (8-neigh) from entry to exit.\n        skin_walkable = np.zeros((h, w), dtype=bool)\n        for r, c in skin:\n            if skin_ok((r, c)):\n                skin_walkable[r, c] = True\n        skin_walkable[entry] = True\n        skin_walkable[exit_cell] = True\n        boundary_path = _bfs_path_with_diag_filter(entry, exit_cell, skin_walkable) or [entry]\n\n        # Extension direction is the last step used to reach the exit on the skin path.\n        assert len(boundary_path) >= 2, \"boundary path must have at least 2 cells to derive extension direction\"\n        dr_ext = boundary_path[-1][0] - boundary_path[-2][0]\n        dc_ext = boundary_path[-1][1] - boundary_path[-2][1]\n\n        route = list(shifted)\n        if boundary_path and boundary_path[0] == entry:\n            route.extend(boundary_path[1:])\n\n        cur = route[-1]\n        while len(route) < L:\n            nr, nc = cur[0] + dr_ext, cur[1] + dc_ext\n            if not (0 <= nr < h and 0 <= nc < w):\n                break\n            if int(g[nr, nc]) != bg and int(g[nr, nc]) != seg_col:\n                break\n            route.append((nr, nc))\n            cur = (nr, nc)\n\n        new_pts = route[:L]\n\n        # Assert: output segment must not overlap obstacle\n        assert not any(p in obstacle_set for p in new_pts), \"output segment passes through obstacle\"\n\n        # Assert: output segment has monotone wrapping shape (FL*F*FR* or FR*F*FL*)\n        rs_bar = [r for r, _ in bar_comp]\n        cs_bar = [c for _, c in bar_comp]\n        if len(set(cs_bar)) == 1:\n            fwd = (1, 0) if min(rs_bar) == 0 else (-1, 0)\n        else:\n            fwd = (0, 1) if min(cs_bar) == 0 else (0, -1)\n        step_classes = []\n        for j in range(len(new_pts) - 1):\n            dr = new_pts[j + 1][0] - new_pts[j][0]\n            dc = new_pts[j + 1][1] - new_pts[j][1]\n            fwd_comp = dr * fwd[0] + dc * fwd[1]\n            perp_comp = dr * fwd[1] + dc * (-fwd[0])\n            if abs(dr) + abs(dc) == 1:\n                step_classes.append('F' if fwd_comp > 0 else 'X')\n            elif fwd_comp > 0 and perp_comp > 0:\n                step_classes.append('FR')\n            elif fwd_comp > 0 and perp_comp < 0:\n                step_classes.append('FL')\n            else:\n                step_classes.append('X')\n        s = ''.join(step_classes)\n        import re\n        assert re.fullmatch(r'(FL)*(F)*(FR)*', s) or re.fullmatch(r'(FR)*(F)*(FL)*', s), \\\n            f\"output segment not monotone wrap: {' '.join(step_classes)}\"\n\n        # Assert: when approach diagonal exists (p1>=1), obstacle must be 4-adj to V apex inner side\n        first_step = step_classes[0] if step_classes else ''\n        if first_step in ('FL', 'FR'):\n            p1_end = 0\n            for j2, sc in enumerate(step_classes):\n                if sc == first_step:\n                    p1_end = j2 + 1\n                else:\n                    break\n            apex = new_pts[p1_end]\n            perp_dir = (seg_start[0] - terminal[0], seg_start[1] - terminal[1])\n            inner = (-perp_dir[0], -perp_dir[1])\n            apex_inner = (apex[0] + inner[0], apex[1] + inner[1])\n            assert apex_inner in obstacle_set, \\\n                f\"obstacle not tight at V apex: apex={apex}, inner={apex_inner}\"\n\n        moves.append((seg_comp, seg_col, new_pts))\n\n    # Clear segments first, then repaint.\n    for seg_comp, seg_col, _ in moves:\n        for r, c in seg_comp:\n            out[r, c] = bg\n\n    for _, seg_col, new_pts in moves:\n        for r, c in new_pts:\n            if int(out[r, c]) == bg:\n                out[r, c] = seg_col\n    return out\n\n# --------------- generator (attempt_2) ---------------\n\nfrom arc_utils import paint_coords\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\nGRID_SIZE_MIN, GRID_SIZE_MAX = 7, 27       # square grid side length\nBAR_LEN_MIN, BAR_LEN_MAX = 3, 7           # bar length (px)\nBAR_CLEARANCE = 4                           # n must exceed bar_len by this much\nSEG_LEN_MIN, SEG_LEN_MAX = 5, 9           # segment pixel count\nPHASE_MAX = 3                               # max length for p1 and p2 individually\nOBS_SIZE_MIN, OBS_SIZE_MAX = 1, 9          # obstacle sprite pixel count\nOBS_MD_MIN, OBS_MD_MAX = 2, 6             # obstacle manhattan distance from terminal\nINPUT_TURN_MIN, INPUT_TURN_MAX = 2, 5     # turns in the input irregular stroke\nDIAG_CONTINUE_PROB = 0.35                  # probability of continuing a diagonal run\nDIAG_START_PROB = 0.5                       # probability of starting/switching to diagonal\nMAX_RETRIES = 300                           # generate_input retry budget\nPLACEMENT_PAD = 1                           # padding around placed triples\n\nEDGE_DATA = {\n    \"top\": {\"fwd\": (1, 0), \"side\": (0, 1)},\n    \"bottom\": {\"fwd\": (-1, 0), \"side\": (0, -1)},\n    \"left\": {\"fwd\": (0, 1), \"side\": (-1, 0)},\n    \"right\": {\"fwd\": (0, -1), \"side\": (1, 0)},\n}\n\n\n\n-- 763: def generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_RETRIES} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/31f7f899.py ===\n-- 6: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort vertical bars by height and redistribute them across fixed colored slots.\n\n    Input structure:\n    - bg background; a horizontal base line of a single color spans the full grid width.\n    - Several monochrome vertical bars of distinct colors rise upward from the base line.\n\n    Rule:\n    - Rank bar shapes by height (shortest to tallest).\n    - Rank original x-positions (slots) left to right.\n    - Place the i-th shortest shape into the i-th leftmost slot, recoloring it to that slot's original color.\n    - The base line is preserved unchanged.\n\n    Key insight: Each slot keeps its x-position and color identity; only the bar silhouettes are redistributed among slots by height order.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Base row/color = (row,color) with maximal count on that row (excluding bg).\n    best = None  # (count, row, color)\n    for r in range(H):\n        vals, counts = np.unique(g[r, :], return_counts=True)\n        for v, cnt in zip(vals, counts):\n            v = int(v)\n            cnt = int(cnt)\n            if v == bg:\n                continue\n            if best is None or cnt > best[0]:\n                best = (cnt, int(r), int(v))\n    assert not (best is None)\n    _cnt, base_r, base_col = best\n\n    objects: list[dict[str, object]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in {int(bg), int(base_col)}:\n            continue\n\n        pts = comp[\"coords\"]\n        b = comp[\"bbox\"]\n        height = int(bbox_h(b))\n\n        base_cols = sorted(int(c) for r, c in pts if int(r) == int(base_r))\n        if base_cols:\n            anchor = int(base_cols[len(base_cols) // 2])\n        else:\n            cols_sorted = sorted(int(c) for _r, c in pts)\n            anchor = int(cols_sorted[len(cols_sorted) // 2])\n\n        rel = [(int(r) - int(base_r), int(c) - int(anchor)) for r, c in pts]\n        objects.append(\n            {\n                \"color\": int(col),\n                \"anchor\": int(anchor),\n                \"height\": int(height),\n                \"size\": int(len(rel)),\n                \"rel\": rel,\n            }\n        )\n\n    # Slots are determined by original x-positions; slot colors must be preserved.\n    slots = sorted(objects, key=lambda o: (int(o[\"anchor\"]), int(o[\"color\"])))\n    # Shapes are ordered by height (shortest -> tallest).\n    shapes = sorted(objects, key=lambda o: (int(o[\"height\"]), int(o[\"size\"]), int(o[\"anchor\"]), int(o[\"color\"])))\n\n    out = np.full_like(g, bg)\n    out[int(base_r), :] = int(base_col)\n\n    for slot, shape in zip(slots, shapes):\n        slot_col = int(slot[\"color\"])\n        slot_anchor = int(slot[\"anchor\"])\n        for dr, dc in shape[\"rel\"]:\n            rr = int(base_r) + int(dr)\n            cc = int(slot_anchor) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W:\n                out[rr, cc] = int(slot_col)\n\n    return out\n\n# --------------- generator (Codex#3) ---------------\n\n\n-- 155: def generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input failed after 300 attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/f560132c.py ===\n-- 258: def main(grid: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n\n    Input structure:\n    - bg = most common color.\n    - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.\n    - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.\n\n    Rule:\n    - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.\n    - The legend's k×k color patch defines a spatial color map over the rectangle.\n    - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.\n\n    Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=4)\n    assert comps, 'grid must contain at least one non-background component'\n\n    # Identify legend component (most distinct colors) and infer k from number of pieces.\n    k = int(round(len(comps) ** 0.5))\n    assert k * k == len(comps), 'piece count must be a perfect square to determine k'\n\n    comp_colors = []\n    for pts in comps:\n        cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)\n        comp_colors.append(cols)\n\n    max_distinct = max(len(cols) for cols in comp_colors)\n    legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]\n    assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'\n    legend_idx = legend_candidates[0]\n    legend_map = _extract_legend_map(g, comps[legend_idx], k)\n\n    # Build piece masks (coords in bbox space), including filled holes.\n    pieces: list[dict] = []\n    for pts in comps:\n        filled_abs, _ = _fill_holes_in_component(g, pts, bg)\n        r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))\n        rel = tuple((r - r0, c - c0) for r, c in filled_abs)\n        rel_norm, _, _ = _normalize_coords(rel)\n        oris = _dihedral_orientations(rel_norm)\n        pieces.append({\"oris\": oris, \"area\": len(filled_abs)})\n\n    return _assemble_exact_cover(pieces, legend_idx, legend_map, k)\n\n# --------------- generator (o5x) ---------------\n\n# === CFG ===\nSIDE_CHOICES = [8, 10, 12]                     # output square side lengths\nK = 2                                          # k*k quadrant grid (2*2 = 4 pieces)\nNUM_PIECES = K * K                             # total jigsaw pieces\nNUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg\nAREA_FRAC_LO = 0.08                           # min piece area as fraction of total\nAREA_FRAC_HI = 0.43                           # max piece area as fraction of total\nAREA_ABS_LO = 11                              # absolute min piece area (cells)\nAREA_ABS_HI = 62                              # absolute max piece area (cells)\nLEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape\nLEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block\nLEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction\nPARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition\nPARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers\nPARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells\nINPUT_SIZE_LO = 20                             # min input grid side\nINPUT_SIZE_HI = 26                             # max input grid side\nDENSITY_LO = 0.15                              # min non-bg density target\nDENSITY_HI = 0.25                              # max non-bg density target\nSCATTER_BORDER = 1                             # border margin when placing pieces\nSCATTER_PADDING = 1                            # gap between piece bounding boxes\nGEN_RETRIES = 300                              # max attempts in generate_input()\n\n\n\n-- 545: def generate_input():\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError('failed to generate f560132c input')\n\n","exit_code":0,"status":"completed"}}
