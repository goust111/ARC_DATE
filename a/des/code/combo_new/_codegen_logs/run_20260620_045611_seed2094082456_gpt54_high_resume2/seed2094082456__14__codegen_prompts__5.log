{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e729b7be.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Colors and canvas bounds.\nBG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8\nGRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1\n\n# Convex source shape bounds.\nSOURCE_SPAN_RANGE = (10, 15)\nSOURCE_MAX_WIDTH_RANGE = (5, 7)\nSOURCE_EDGE_WIDTH_RANGE = (1, 3)\nWIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)\n\n# Color palette, band orders, and retry budget.\nSOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)\nSOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300\nCOLORING_KEYS = (\n    lambda item: (item[2], item[3], item[1]),\n    lambda item: (item[3], item[2], item[1]),\n    lambda item: (item[2] + item[3], item[2], item[1]),\n    lambda item: (item[2] - item[3], item[2], item[1]),\n)\n\n\ndef _gen_bounded_steps(total, slots, cap):\n    steps = []\n    remaining = total\n    for i in range(slots):\n        left = slots - i - 1\n        lo = max(0, remaining - cap * left)\n        hi = min(cap, remaining)\n        step = random.randint(lo, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_width_profile(span, max_width):\n    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)\n    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)\n    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP\n    if min_up + min_down + 1 > span:\n        return None\n\n    peak_start = random.randint(min_up, span - 1 - min_down)\n    peak_end = random.randint(peak_start, span - 1 - min_down)\n\n    widths = [start_width]\n    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):\n        widths.append(widths[-1] + step)\n\n    widths.extend([max_width] * (peak_end - peak_start))\n\n    current = max_width\n    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):\n        current -= step\n        widths.append(current)\n\n    area = sum(widths)\n    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:\n        return None\n    return widths\n\n\ndef _choose_source_extent(n, cr):\n    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]\n    span = random.choice(valid_spans)\n    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)\n    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)\n    r0 = random.randint(r0_min, r0_max)\n    return span, r0, cr - r0\n\n\ndef _paint_source_cells(out, r0, widths, outer, cc):\n    interior = []\n    source = []\n    for i, width in enumerate(widths):\n        r = r0 + i\n        c0 = cc - width\n        for j in range(width):\n            c = c0 + j\n            source.append((r, c))\n            if j == 0:\n                out[r, c] = outer\n            else:\n                interior.append((r, c, i, j))\n    return source, interior\n\n\ndef _gen_color_source(out, r0, widths, colors, cc):\n    outer = colors[0]\n    inner = colors[1:]\n    source, interior = _paint_source_cells(out, r0, widths, outer, cc)\n    if len(interior) < len(inner):\n        return None\n\n    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]\n    interior.sort(key=key)\n    band_count = len(inner)\n    for rank, (r, c, _, _) in enumerate(interior):\n        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]\n\n    return source\n\n\ndef _reflect_source(out, source, cr, cc):\n    reflected = []\n    for r, c in source:\n        rr = 2 * cr - r\n        rc = 2 * cc - c\n        if out[rr, rc] != BG_COLOR:\n            return None\n        out[rr, rc] = out[r, c]\n        reflected.append((rr, rc))\n    return reflected\n\n\ndef _gen_attempt():\n    n = random.choice(GRID_SIZES)\n    cr = cc = n // 2\n    out = np.full((n, n), BG_COLOR, dtype=int)\n    out[:, cc] = DIVIDER_COLOR\n    out[cr, [0, cc, n - 1]] = MARKER_COLOR\n\n    span, r0, center_i = _choose_source_extent(n, cr)\n    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)\n    widths = _gen_width_profile(span, max_width)\n    if widths is None:\n        return None\n    if widths[center_i] >= cc:\n        return None\n\n    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)\n    colors = random.sample(SOURCE_COLORS, color_count)\n    source = _gen_color_source(out, r0, widths, colors, cc)\n    if source is None:\n        return None\n\n    reflected = _reflect_source(out, source, cr, cc)\n    if reflected is None:\n        return None\n\n    inp = out.copy()\n    for r, c in reflected:\n        inp[r, c] = BG_COLOR\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask\nimport random\n\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n\ndef _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:\n    \"\"\"\n    Legend is a top region with a background color (typically 5) and 4 vertical bars.\n    Each bar's horizontal position inside its cell encodes turn direction:\n      - bar on left  -> 'L' (turn counterclockwise)\n      - bar on right -> 'R' (turn clockwise)\n    \"\"\"\n    legend = grid[:legend_h, :]\n    assert legend.size, \"legend must be non-empty\"\n    _vals, _cnts = np.unique(legend, return_counts=True); bg = int(_vals[_cnts.argmax()])\n\n    # Separator columns are solid bg throughout the legend.\n    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]\n    assert len(sep_cols) >= 2, \"legend separator columns must exist\"\n\n    turn: dict[int, str] = {}\n    for a, b in zip(sep_cols, sep_cols[1:], strict=False):\n        if b - a <= 2:\n            continue\n        interior = legend[1 : legend_h - 1, a + 1 : b]\n        colors = set(map(int, np.unique(interior)))\n        colors.discard(bg)\n        colors.discard(0)\n        assert len(colors) == 1, \"each legend cell must encode exactly one color\"\n        col = int(next(iter(colors)))\n        xs = np.where(interior == col)[1]\n        x = int(xs[0])  # relative to interior\n        # Decide left/right by proximity to borders (interior is typically 4 cells wide).\n        turn[col] = \"L\" if x <= (interior.shape[1] - 1) // 2 else \"R\"\n    assert len(turn) == 4, \"legend must encode four turn colors\"\n    return turn\n\n\ndef _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:\n    \"\"\"Return (r0,c0,size) for a solid square teal component.\"\"\"\n    candidates: list[tuple[int, int, int]] = []\n    for cells in components_mask(g == teal, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(cells)\n        hh = r1 - r0 + 1\n        ww = c1 - c0 + 1\n        if hh != ww:\n            continue\n        size = hh\n        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:\n            continue\n        candidates.append((int(r0), int(c0), int(size)))\n    assert len(candidates) == 1, \"main grid must contain exactly one solid teal square\"\n    return candidates[0]\n\n\ndef _rot_ccw(d: int) -> int:\n    return (d - 1) % 4\n\n\ndef _rot_cw(d: int) -> int:\n    return (d + 1) % 4\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Emit four teal beams from a square, turning at colored obstacles per a legend.\n\n    Input structure:\n    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n\n    Rule:\n    - Remove the legend from the output.\n    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    - Each beam paints teal over bg cells as it moves.\n    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    - Beams stop at grid edges.\n\n    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n\n    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    legend_bg = 5\n    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    assert rows_with_legend.size, \"legend rows must be present\"\n    legend_h = int(rows_with_legend.max() + 1)\n    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n\n    legend_turn = _parse_legend(g, legend_h)\n\n    base = g[legend_h:, :].copy()\n    assert base.size, \"main grid must remain after legend crop\"\n\n    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    teal = 8\n    src = _find_teal_square(base, teal=teal)\n    sr, sc, sz = src\n\n    out = base.copy()\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n\n    def paint_block(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = teal\n        out[r : r + sz, c : c + sz] = blk\n\n    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n        blk = out[nr : nr + sz, nc : nc + sz]\n        cols = set(map(int, np.unique(blk)))\n        cols.discard(bg)\n        cols.discard(teal)\n        if not cols:\n            return None\n        assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n        return int(next(iter(cols)))\n\n    # Four beams, each is a moving copy of the teal square.\n    for d0 in range(4):\n        r, c, d = sr, sc, d0\n        seen: set[tuple[int, int, int]] = set()\n        while True:\n            state = (r, c, d)\n            assert state not in seen, \"beam path must not cycle\"\n            seen.add(state)\n\n            dr, dc = _DIRS[d]\n            nr, nc = r + dr, c + dc\n            if not in_bounds(nr, nc):\n                break\n\n            oc = obstacle_color_at_next(nr, nc)\n            if oc is None:\n                r, c = nr, nc\n                paint_block(r, c)\n                continue\n\n            assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n            turn = legend_turn[oc]\n            d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n_N, _E, _S, _W = range(4)\n\n# Color palettes\nLEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\nBG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\nLEGEND_BG = 5                                  # legend background color\nTEAL = 8                                       # beam / square color\n\n# Canvas dimensions\nGRID_H_RANGE = (19, 24)                        # main-grid height (rows)\nGRID_W = 24                                    # main-grid width (fixed)\nLEGEND_H = 6                                   # legend height (rows)\nLEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells\n\n# Teal square\nTEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3\nSQUARE_EDGE_GAP = 5                            # min gap from square to grid edges\n\n# Obstacles\nOBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3\nOBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds\nOBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present\nOBS_BOTH_GAP = 2                               # gap subtracted when both sides present\n\n# Span selection\nSPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz\nSPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz\nSPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)\n\n# Retry budget\nMAX_RETRIES = 300\n\n\ndef _rot(d: int, turn: str) -> int:\n    \"\"\"Rotate direction d by turn ('L' = CCW, 'R' = CW).\"\"\"\n    return (d - 1) % 4 if turn == \"L\" else (d + 1) % 4\n\n\n# ── Obstacle span selection ───────────────────────────────────────────\n\ndef _choose_span(\n    axis_len: int,\n    required: list[tuple[int, int]],\n    excluded: list[tuple[int, int]],\n    min_len: int,\n    max_len: int,\n) -> tuple[int, int] | None:\n    \"\"\"Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*.\"\"\"\n    req0 = min(a for a, _ in required)\n    req1 = max(b for _, b in required)\n    lo = max(min_len, req1 - req0 + 1)\n    hi = min(max_len, axis_len)\n    choices: list[tuple[int, int, int]] = []\n    for length in range(lo, hi + 1):\n        start0 = max(0, req1 - length + 1)\n        start1 = min(req0, axis_len - length)\n        for start in range(start0, start1 + 1):\n            end = start + length - 1\n            if all(end < a or start > b for a, b in excluded):\n                choices.append((length, start, end))\n    if not choices:\n        return None\n\n    # Bias mildly toward compact side bars while still covering long-span cases.\n    lengths = sorted({length for length, _, _ in choices})\n    if random.random() < SPAN_COMPACT_PROB:\n        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]\n        pool = [(start, end) for length, start, end in choices if length <= cutoff]\n    else:\n        pool = [(start, end) for _, start, end in choices]\n    return random.choice(pool)\n\n\n# ── Beam simulation (oracle) ──────────────────────────────────────────\n\ndef _simulate_paths(\n    base: np.ndarray, turns: dict[int, str], bg: int\n) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:\n    \"\"\"Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists.\"\"\"\n    vals, counts = np.unique(base, return_counts=True)\n    assert int(vals[counts.argmax()]) == bg\n\n    teal_locs = np.argwhere(base == TEAL)\n    assert teal_locs.size\n    sr, sc = teal_locs.min(axis=0)\n    r1, c1 = teal_locs.max(axis=0)\n    sz = int(r1 - sr + 1)\n    assert sz == int(c1 - sc + 1)\n\n    out = base.copy()\n    H, W = out.shape\n    hits: list[list[tuple[int, int, int, int]]] = []\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W\n\n    def paint(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = TEAL\n\n    def obstacle_at(r: int, c: int) -> int | None:\n        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))\n        colors.discard(bg)\n        colors.discard(TEAL)\n        if not colors:\n            return None\n        assert len(colors) == 1\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\nimport itertools\nfrom arc_utils import paste\nfrom collections import defaultdict\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n","exit_code":0,"status":"completed"}}
