{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed2094082456/10/8.py | sed -n '1,260p'\"","aggregated_output":"     1\timport random\n     2\tfrom collections import Counter\n     3\t\n     4\timport numpy as np\n     5\t\n     6\t\n     7\tBG = 0\n     8\tGRAY = 5\n     9\tPALETTE = tuple(color for color in range(10) if color not in (BG, GRAY))\n    10\t\n    11\tGRID_HEIGHT_RANGE = (6, 16)\n    12\tGRID_WIDTH_RANGE = (6, 16)\n    13\tMARKED_ROW_COUNT_RANGE = (1, 6)\n    14\tMAX_GENERATION_ATTEMPTS = 300\n    15\t\n    16\t\n    17\tdef _find_control_column(grid: np.ndarray) -> int:\n    18\t    gray_pixels = np.argwhere(grid == GRAY)\n    19\t    assert len(gray_pixels) > 0, \"expected at least one gray control pixel\"\n    20\t    control_cols = np.unique(gray_pixels[:, 1])\n    21\t    assert len(control_cols) == 1, \"gray pixels must lie in a single control column\"\n    22\t    return int(control_cols[0])\n    23\t\n    24\t\n    25\tdef _find_template_row(grid: np.ndarray, control_col: int) -> tuple[int, np.ndarray, np.ndarray]:\n    26\t    full_rows = np.flatnonzero((grid != BG).all(axis=1))\n    27\t    if len(full_rows) == 1:\n    28\t        row = int(full_rows[0])\n    29\t        cols = np.arange(grid.shape[1], dtype=int)\n    30\t        return row, cols, grid[row, cols].copy()\n    31\t\n    32\t    partial_rows: list[int] = []\n    33\t    for r in range(grid.shape[0]):\n    34\t        zeros = np.flatnonzero(grid[r] == BG)\n    35\t        if len(zeros) == 1 and int(zeros[0]) == control_col:\n    36\t            mask = np.ones(grid.shape[1], dtype=bool)\n    37\t            mask[control_col] = False\n    38\t            if np.all(grid[r, mask] != BG):\n    39\t                partial_rows.append(int(r))\n    40\t\n    41\t    assert len(partial_rows) == 1, \"expected a unique template row\"\n    42\t    row = partial_rows[0]\n    43\t    cols = np.flatnonzero(np.arange(grid.shape[1]) != control_col)\n    44\t    return row, cols, grid[row, cols].copy()\n    45\t\n    46\t\n    47\tdef _first_occurrence_map(sequence: np.ndarray) -> dict[int, int]:\n    48\t    first: dict[int, int] = {}\n    49\t    for idx, value in enumerate(sequence.tolist()):\n    50\t        value = int(value)\n    51\t        if value not in first:\n    52\t            first[value] = idx\n    53\t    return first\n    54\t\n    55\t\n    56\tdef _nearest_shift_color(grid: np.ndarray, row: int, control_col: int) -> int:\n    57\t    candidates = []\n    58\t    for col, value in enumerate(grid[row].tolist()):\n    59\t        value = int(value)\n    60\t        if value not in (BG, GRAY):\n    61\t            candidates.append((abs(col - control_col), col, value))\n    62\t\n    63\t    assert candidates, f\"row {row} must contain a shift marker\"\n    64\t    best_distance = min(distance for distance, _col, _value in candidates)\n    65\t    nearest = [(col, value) for distance, col, value in candidates if distance == best_distance]\n    66\t    assert len(nearest) == 1, f\"row {row} has ambiguous nearest shift markers\"\n    67\t    return int(nearest[0][1])\n    68\t\n    69\t\n    70\tdef main(grid: np.ndarray) -> np.ndarray:\n    71\t    \"\"\"\n    72\t    Rotate the template-row color sequence by marker-indicated offsets and copy it onto selected rows.\n    73\t\n    74\t    Input structure:\n    75\t    - The background is black.\n    76\t    - One unique template row is filled by a non-black color sequence; some inputs may leave only the control-column crossing black while keeping the rest of that row filled.\n    77\t    - One unique control column contains gray pixels that mark which rows should be rewritten.\n    78\t    - Each marked row contains at least one non-black, non-gray shift marker, and the nearest such marker to the control column uses a color that also appears in the template row.\n    79\t\n    80\t    Rule:\n    81\t    - Find the control column from the gray pixels and find the unique template row.\n    82\t    - Read the template row left-to-right as the source sequence, ignoring only a possible black control-column hole.\n    83\t    - For each gray-marked row, read the nearest shift-marker color and locate that color's first occurrence index in the template sequence.\n    84\t    - Left-rotate the template sequence by that index and write the rotated sequence onto the marked row.\n    85\t    - Start the output from an all-black grid and keep only the template row plus the rewritten marked rows.\n    86\t\n    87\t    Key insight:\n    88\t    - The row marker color is an indirect pointer into the template row: its first position in the template determines the rotation amount.\n    89\t    \"\"\"\n    90\t    g = np.asarray(grid, dtype=int)\n    91\t    assert g.ndim == 2, \"expected a 2D grid\"\n    92\t\n    93\t    control_col = _find_control_column(g)\n    94\t    template_row, template_cols, template_seq = _find_template_row(g, control_col)\n    95\t    first_occurrence = _first_occurrence_map(template_seq)\n    96\t\n    97\t    out = np.full_like(g, BG)\n    98\t    out[template_row, template_cols] = template_seq\n    99\t\n   100\t    marked_rows = [int(r) for r in np.flatnonzero(g[:, control_col] == GRAY) if int(r) != template_row]\n   101\t    for row in marked_rows:\n   102\t        shift_color = _nearest_shift_color(g, row, control_col)\n   103\t        assert shift_color in first_occurrence, \"shift marker color must appear in the template row\"\n   104\t        shift = first_occurrence[shift_color]\n   105\t        out[row, template_cols] = np.roll(template_seq, -shift)\n   106\t\n   107\t    return out\n   108\t\n   109\t\n   110\tdef _build_template_sequence(width: int) -> np.ndarray:\n   111\t    if random.random() < 0.5:\n   112\t        motif_len = random.randint(2, min(5, width - 1))\n   113\t        color_count = random.randint(2, min(motif_len, 5, len(PALETTE)))\n   114\t        colors = random.sample(PALETTE, color_count)\n   115\t        motif = colors.copy()\n   116\t        while len(motif) < motif_len:\n   117\t            motif.append(random.choice(colors))\n   118\t        random.shuffle(motif)\n   119\t        sequence = (motif * ((width + motif_len - 1) // motif_len))[:width]\n   120\t        for _ in range(random.randint(0, max(1, width // 4))):\n   121\t            idx = random.randrange(width)\n   122\t            sequence[idx] = random.choice(colors)\n   123\t        return np.array(sequence, dtype=int)\n   124\t\n   125\t    color_count = random.randint(2, min(width, len(PALETTE)))\n   126\t    colors = random.sample(PALETTE, color_count)\n   127\t    random.shuffle(colors)\n   128\t    sequence = colors[:]\n   129\t    while len(sequence) < width:\n   130\t        options = colors if len(colors) == 1 else [color for color in colors if color != sequence[-1]]\n   131\t        sequence.append(random.choice(options))\n   132\t    return np.array(sequence[:width], dtype=int)\n   133\t\n   134\t\n   135\tdef _side_choices(control_col: int, width: int, count: int) -> list[str]:\n   136\t    available = []\n   137\t    if control_col > 0:\n   138\t        available.append(\"left\")\n   139\t    if control_col < width - 1:\n   140\t        available.append(\"right\")\n   141\t    assert available\n   142\t\n   143\t    if len(available) == 2 and count >= 2 and random.random() < 0.7:\n   144\t        sides = [\"left\", \"right\"]\n   145\t        while len(sides) < count:\n   146\t            sides.append(random.choice(available))\n   147\t        random.shuffle(sides)\n   148\t        return sides\n   149\t\n   150\t    return [random.choice(available) for _ in range(count)]\n   151\t\n   152\t\n   153\tdef _gen_attempt() -> np.ndarray | None:\n   154\t    height = random.randint(*GRID_HEIGHT_RANGE)\n   155\t    width = random.randint(*GRID_WIDTH_RANGE)\n   156\t    if width < 3 or height < 2:\n   157\t        return None\n   158\t\n   159\t    grid = np.full((height, width), BG, dtype=int)\n   160\t    template_row = random.randrange(height)\n   161\t    control_col = random.randint(1, width - 2)\n   162\t\n   163\t    template_seq = _build_template_sequence(width)\n   164\t    grid[template_row] = template_seq\n   165\t\n   166\t    available_rows = [row for row in range(height) if row != template_row]\n   167\t    marked_count = random.randint(MARKED_ROW_COUNT_RANGE[0], min(MARKED_ROW_COUNT_RANGE[1], len(available_rows)))\n   168\t    marked_rows = random.sample(available_rows, marked_count)\n   169\t\n   170\t    repeated_colors = [color for color, count in Counter(template_seq.tolist()).items() if count > 1]\n   171\t    forced_duplicate_row = random.choice(marked_rows) if repeated_colors and random.random() < 0.7 else None\n   172\t\n   173\t    sides = _side_choices(control_col, width, marked_count)\n   174\t    for row, side in zip(marked_rows, sides):\n   175\t        grid[row, control_col] = GRAY\n   176\t\n   177\t        if side == \"left\":\n   178\t            marker_col = random.randint(0, control_col - 1)\n   179\t        else:\n   180\t            marker_col = random.randint(control_col + 1, width - 1)\n   181\t\n   182\t        if row == forced_duplicate_row:\n   183\t            marker_color = int(random.choice(repeated_colors))\n   184\t        else:\n   185\t            marker_color = int(random.choice(template_seq.tolist()))\n   186\t        grid[row, marker_col] = marker_color\n   187\t\n   188\t    return grid if _is_valid_input(grid) else None\n   189\t\n   190\t\n   191\tdef _is_valid_input(grid: np.ndarray) -> bool:\n   192\t    if not isinstance(grid, np.ndarray) or grid.ndim != 2:\n   193\t        return False\n   194\t    if max(grid.shape) > 30 or min(grid.shape) <= 0:\n   195\t        return False\n   196\t\n   197\t    gray_pixels = np.argwhere(grid == GRAY)\n   198\t    if len(gray_pixels) == 0:\n   199\t        return False\n   200\t    if len(np.unique(gray_pixels[:, 1])) != 1:\n   201\t        return False\n   202\t    control_col = int(gray_pixels[0, 1])\n   203\t\n   204\t    full_rows = np.flatnonzero((grid != BG).all(axis=1))\n   205\t    if len(full_rows) != 1:\n   206\t        return False\n   207\t    template_row = int(full_rows[0])\n   208\t\n   209\t    if np.any(grid[template_row] == GRAY):\n   210\t        return False\n   211\t\n   212\t    template_colors = set(int(value) for value in grid[template_row].tolist())\n   213\t    if BG in template_colors or GRAY in template_colors:\n   214\t        return False\n   215\t\n   216\t    marked_rows = [int(r) for r in np.flatnonzero(grid[:, control_col] == GRAY)]\n   217\t    if template_row in marked_rows:\n   218\t        return False\n   219\t    if not marked_rows:\n   220\t        return False\n   221\t\n   222\t    for row in range(grid.shape[0]):\n   223\t        non_bg = np.flatnonzero((grid[row] != BG) & (grid[row] != GRAY))\n   224\t        if row == template_row:\n   225\t            if len(non_bg) != grid.shape[1]:\n   226\t                return False\n   227\t            continue\n   228\t\n   229\t        if row in marked_rows:\n   230\t            if len(non_bg) != 1:\n   231\t                return False\n   232\t            if int(grid[row, int(non_bg[0])]) not in template_colors:\n   233\t                return False\n   234\t        elif len(non_bg) != 0:\n   235\t            return False\n   236\t\n   237\t    try:\n   238\t        out = main(grid)\n   239\t    except AssertionError:\n   240\t        return False\n   241\t    except Exception:\n   242\t        return False\n   243\t\n   244\t    return isinstance(out, np.ndarray) and out.shape == grid.shape\n   245\t\n   246\t\n   247\tdef generate_input() -> np.ndarray:\n   248\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   249\t        grid = _gen_attempt()\n   250\t        if grid is not None:\n   251\t            return grid\n   252\t    raise RuntimeEr