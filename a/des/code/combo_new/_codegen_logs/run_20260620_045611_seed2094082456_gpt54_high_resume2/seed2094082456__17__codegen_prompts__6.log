 | None:\n   306\t    options: list[tuple[tuple[int, int], tuple[int, int], int]] = []\n   307\t    for direction in DIRS4:\n   308\t        for perp in PERPS[direction]:\n   309\t            for length in range(2, 7):\n   310\t                options.append((direction, perp, length))\n   311\t    random.shuffle(options)\n   312\t\n   313\t    for direction, perp, length in options[:BLOCKER_ATTEMPTS]:\n   314\t        tower = _build_tower(shape, blocked_antenna, direction, perp, length, color)\n   315\t        if tower is None:\n   316\t            continue\n   317\t        if _tower_fits(tower, occupied, reserved_paths, allow_antenna_on_reserved=True):\n   318\t            return tower\n   319\t    return None\n   320\t\n   321\t\n   322\tdef _reachable_steps(grid: np.ndarray, tower: dict) -> list[tuple[int, tuple[int, int]]]:\n   323\t    return [(i + 1, cell) for i, cell in enumerate(_visible_ray_cells(grid, tower))]\n   324\t\n   325\t\n   326\tdef _receiver_ok(\n   327\t    cell: tuple[int, int],\n   328\t    tower_cells: set[tuple[int, int]],\n   329\t    receivers: set[tuple[int, int]],\n   330\t) -> bool:\n   331\t    if cell in tower_cells or cell in receivers:\n   332\t        return False\n   333\t    if any(_chebyshev_close(cell, other) for other in tower_cells):\n   334\t        return False\n   335\t    if any(_chebyshev_close(cell, other) for other in receivers):\n   336\t        return False\n   337\t    return True\n   338\t\n   339\t\n   340\tdef _choose_showcase_tower(\n   341\t    reachable: list[list[tuple[int, tuple[int, int]]]],\n   342\t    tower_cells: set[tuple[int, int]],\n   343\t    receivers: set[tuple[int, int]],\n   344\t) -> tuple[int, tuple[int, int], tuple[int, int]] | None:\n   345\t    candidates = []\n   346\t    for idx, steps in enumerate(reachable):\n   347\t        if len(steps) < 4:\n   348\t            continue\n   349\t        endpoint = steps[-1][1]\n   350\t        mids = [cell for step, cell in steps[1:-1] if step <= len(steps) - 2]\n   351\t        mids = [cell for cell in mids if _receiver_ok(cell, tower_cells, receivers)]\n   352\t        if not mids or not _receiver_ok(endpoint, tower_cells, receivers):\n   353\t            continue\n   354\t        candidates.append((idx, mids, endpoint))\n   355\t\n   356\t    if not candidates:\n   357\t        return None\n   358\t\n   359\t    idx, mids, endpoint = random.choice(candidates)\n   360\t    return idx, random.choice(mids), endpoint\n   361\t\n   362\t\n   363\tdef _place_required_receivers(\n   364\t    grid: np.ndarray,\n   365\t    towers: list[dict],\n   366\t    need_pass_hit: bool,\n   367\t    need_endpoint_hit: bool,\n   368\t) -> set[tuple[int, int]] | None:\n   369\t    reachable = [_reachable_steps(grid, tower) for tower in towers]\n   370\t    tower_cells = set().union(*(_tower_cells(tower) for tower in towers))\n   371\t    receivers: set[tuple[int, int]] = set()\n   372\t\n   373\t    if need_pass_hit and need_endpoint_hit:\n   374\t        showcase = _choose_showcase_tower(reachable, tower_cells, receivers)\n   375\t        if showcase is not None:\n   376\t            _idx, middle, endpoint = showcase\n   377\t            receivers.add(middle)\n   378\t            receivers.add(endpoint)\n   379\t            return receivers\n   380\t\n   381\t    if need_pass_hit:\n   382\t        pass_candidates = []\n   383\t        for idx, steps in enumerate(reachable):\n   384\t            for step, cell in steps[1:-1]:\n   385\t                if step >= 2 and _receiver_ok(cell, tower_cells, receivers):\n   386\t                    pass_candidates.append((idx, step, cell))\n   387\t        if not pass_candidates:\n   388\t            return None\n   389\t        _idx, _step, cell = random.choice(pass_candidates)\n   390\t        receivers.add(cell)\n   391\t\n   392\t    if need_endpoint_hit:\n   393\t        end_candidates = []\n   394\t        for idx, steps in enumerate(reachable):\n   395\t            if len(steps) 