{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/abbfd121.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, paste, random_free_location\nimport random\n\n\nRect = tuple[int, int, int, int, int, int]  # (area, color, r0, c0, r1, c1)\n\n\ndef _solid_rectangles(g: np.ndarray) -> list[Rect]:\n    rects: list[Rect] = []\n    for color in np.unique(g):\n        for coords in components_mask(g == int(color), connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(coords)\n            h = r1 - r0 + 1\n            w = c1 - c0 + 1\n            area = int(coords.shape[0])\n            if h > 1 and w > 1 and area == h * w:\n                rects.append((area, int(color), r0, c0, r1, c1))\n    return rects\n\n\ndef _period_values(\n    g: np.ndarray, blocked: np.ndarray, row_period: int, col_period: int\n) -> dict[tuple[int, int], int] | None:\n    values: dict[tuple[int, int], int] = {}\n    h, w = g.shape\n    for r in range(h):\n        for c in range(w):\n            if blocked[r, c]:\n                continue\n            key = (r % row_period, c % col_period)\n            value = int(g[r, c])\n            if key in values and values[key] != value:\n                return None\n            values[key] = value\n    return values\n\n\ndef _reconstruct_rect(\n    values: dict[tuple[int, int], int], row_period: int, col_period: int, rect: Rect\n) -> np.ndarray:\n    _, _, r0, c0, r1, c1 = rect\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for rr, r in enumerate(range(r0, r1 + 1)):\n        for cc, c in enumerate(range(c0, c1 + 1)):\n            key = (r % row_period, c % col_period)\n            assert key in values, \"period residue must be visible outside the rectangles\"\n            out[rr, cc] = values[key]\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recover the repeating background pattern hidden under the largest solid rectangle.\n\n    Input structure:\n    - The grid is covered by a small row/column periodic pattern.\n    - Several non-pattern colors form solid rectangular foreground objects that\n      overwrite the pattern.\n    - The requested output region is the largest of those solid rectangles.\n\n    Rule:\n    - Find every 4-connected monochromatic object whose bounding box is a filled\n      rectangle with both dimensions greater than one.\n    - Treat those rectangles as masks, infer the smallest repeating tile that is\n      consistent with all remaining visible pixels, and repaint the largest\n      rectangle's coordinates with that tile.\n\n    Key insight: The rectangle colors are occluders; the visible pixels outside\n    them are enough to reconstruct the original periodic background underneath.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    rects = _solid_rectangles(g)\n    assert rects, \"expected at least one solid rectangular occluder\"\n\n    max_area = max(area for area, *_ in rects)\n    targets = [rect for rect in rects if rect[0] == max_area]\n    assert len(targets) == 1, \"largest rectangle must be unique\"\n    target = targets[0]\n\n    blocked = np.zeros(g.shape, dtype=bool)\n    for _, _, r0, c0, r1, c1 in rects:\n        blocked[r0 : r1 + 1, c0 : c1 + 1] = True\n\n    h, w = g.shape\n    period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []\n    for row_period in range(1, h + 1):\n        for col_period in range(1, w + 1):\n            values = _period_values(g, blocked, row_period, col_period)\n            if values is not None:\n                period_candidates.append((row_period, col_period, values))\n    assert period_candidates, \"visible pixels must define a periodic pattern\"\n\n    min_period_area = min(rp * cp for rp, cp, _ in period_candidates)\n    outputs = [\n        _reconstruct_rect(values, row_period, col_period, target)\n        for row_period, col_period, values in period_candidates\n        if row_period * col_period == min_period_area\n    ]\n    assert outputs, \"expected at least one minimal period\"\n    first = outputs[0]\n    assert all(np.array_equal(first, out) for out in outputs), \"minimal periods must agree\"\n    return first\n\n# --------------- generator (att2) ---------------\n\n# Tile palette and period choices.\n_GEN_COLOR_RANGE = range(10)\n_GEN_TILE_SIZES = [3, 4]\n_GEN_TILE_COLOR_COUNTS = [3, 4]\n_GEN_STEP_CHOICES = {3: [1, 2], 4: [1, 3]}\n# Canvas dimensions from the observed task family.\n_GEN_HEIGHT_RANGE = (19, 23)\n_GEN_WIDTH_RANGE = (19, 22)\n# Occluder rectangle count, size, and coverage constraints.\n_GEN_RECT_COUNTS = [2, 3]\n_GEN_RECT_SIDE_RANGE = range(3, 13)\n_GEN_AREA_RANGE = (9, 100)\n_GEN_TARGET_AREA_RANGE = (36, 100)\n_GEN_COVERAGE_RANGE = (0.18, 0.33)\n# Rejection sampling budget.\n_GEN_ATTEMPT_LIMIT = 300\n\n_GEN_DIMS_BY_AREA = {\n    h * w: [(hh, ww) for hh in _GEN_RECT_SIDE_RANGE for ww in _GEN_RECT_SIDE_RANGE if hh * ww == h * w]\n    for h in _GEN_RECT_SIDE_RANGE\n    for w in _GEN_RECT_SIDE_RANGE\n}\n\n\ndef _gen_tile() -> np.ndarray:\n    size = random.choice(_GEN_TILE_SIZES)\n    n_colors = random.choice(_GEN_TILE_COLOR_COUNTS) if size == 3 else 4\n    colors = random.sample(_GEN_COLOR_RANGE, n_colors)\n    step_choices = _GEN_STEP_CHOICES[n_colors]\n    row_step = random.choice(step_choices)\n    col_step = random.choice(step_choices)\n    offset = random.randrange(n_colors)\n    tile = np.empty((size, size), dtype=int)\n    for r in range(size):\n        for c in range(size):\n            tile[r, c] = colors[(offset + row_step * r + col_step * c) % n_colors]\n    return tile\n\n\ndef _gen_periodic_grid(tile: np.ndarray, height: int, width: int) -> np.ndarray:\n    rows = np.arange(height)[:, None] % tile.shape[0]\n    cols = np.arange(width)[None, :] % tile.shape[1]\n    return tile[rows, cols].astype(int, copy=True)\n\n\ndef _gen_choose_areas(height: int, width: int, count: int) -> tuple[int, ...] | None:\n    min_total = int(np.ceil(_GEN_COVERAGE_RANGE[0] * height * width))\n    max_total = int(np.floor(_GEN_COVERAGE_RANGE[1] * height * width))\n    area_min, area_max = _GEN_AREA_RANGE\n    target_min, target_max = _GEN_TARGET_AREA_RANGE\n    small_areas = sorted(a for a in _GEN_DIMS_BY_AREA if area_min <= a <= area_max)\n    target_areas = [a for a in small_areas if target_min <= a <= target_max]\n    possible: dict[int, list[tuple[int, ...]]] = {}\n    for total in range(min_total, max_total + 1):\n        tuples: list[tuple[int, ...]] = []\n        for target in target_areas:\n            if count == 2:\n                small = total - target\n                if small in _GEN_DIMS_BY_AREA and area_min <= small < target:\n                    tuples.append((target, small))\n            else:\n                rem = total - target\n                for small1 in small_areas:\n                    small2 = rem - small1\n                    if (\n                        area_min <= small1 < target\n                        and area_min <= small2 < target\n                        and small2 in _GEN_DIMS_BY_AREA\n                    ):\n                        tuples.append((target, small1, small2))\n        if tuples:\n            possible[total] = tuples\n    if not possible:\n        return None\n    total = random.choice(list(possible))\n    return random.choice(possible[total])\n\n\ndef _gen_place_rectangles(shape: tuple[int, int], dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:\n    occupied = np.zeros(shape, dtype=int)\n    placed: list[tuple[int, int, int, int]] = []\n    for rect_h, rect_w in dims:\n        patch = np.ones((rect_h, rect_w), dtype=int)\n        try:\n            row, col = random_free_location(occupied, patch, transparent=0)\n        except ValueError:\n            return None\n        paste(occupied, patch, row, col)\n        placed.append((row, col, rect_h, rect_w))\n    return placed\n\n\ndef _gen_all_residues_visible(occupied: np.ndarray, row_period: int, col_period: int) -> bool:\n    seen = np.zeros((row_period, col_period), dtype=bool)\n    for residue_r in range(row_period):\n        for residue_c in range(col_period):\n            seen[residue_r, residue_c] = np.any(\n                occupied[residue_r::row_period, residue_c::col_period] == 0\n            )\n    return bool(seen.all())\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    tile = _gen_tile()\n    height = random.randint(*_GEN_HEIGHT_RANGE)\n    width = random.randint(*_GEN_WIDTH_RANGE)\n    base = _gen_periodic_grid(tile, height, width)\n\n    count = random.choice(_GEN_RECT_COUNTS)\n    areas = _gen_choose_areas(height, width, count)\n    if areas is None:\n        return None\n\n    dims = [random.choice(_GEN_DIMS_BY_AREA[area]) for area in areas]\n    placed = _gen_place_rectangles((height, width), dims)\n    if placed is None:\n        return None\n\n    occupied = np.zeros((height, width), dtype=int)\n    for row, col, rect_h, rect_w in placed:\n        occupied[row : row + rect_h, col : col + rect_w] = 1\n    if not _gen_all_residues_visible(occupied, tile.shape[0], tile.shape[1]):\n        return None\n\n    target_row, target_col, target_h, target_w = placed[0]\n    expected = base[target_row : target_row + target_h, target_col : target_col + target_w].copy()\n    tile_colors = set(map(int, tile.ravel()))\n    occluder_colors = random.sample([c for c in _GEN_COLOR_RANGE if c not in tile_colors], count)\n\n    grid = base.copy()\n    for color, (row, col, rect_h, rect_w) in zip(occluder_colors, placed):\n        patch = np.full((rect_h, rect_w), color, dtype=int)\n        paste(grid, patch, row, col)\n\n    try:\n        actual = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_ATTEMPT_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input: failed after {_GEN_ATTEMPT_LIMIT} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f0100645.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, paste\nimport random\n\n\ndef _component_order(coords: np.ndarray, direction: int) -> tuple[int, int, int, int]:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    if direction == -1:\n        return (int(cols.min()), int(rows.min()), int(cols.max()), int(rows.max()))\n    assert direction == 1, \"horizontal slide direction must be left or right\"\n    return (-int(cols.max()), int(rows.min()), -int(cols.min()), int(rows.max()))\n\n\ndef _settled_components(g: np.ndarray, color: int, side_col: int, direction: int) -> list[np.ndarray]:\n    h, w = g.shape\n    movable = (g == color)\n    movable[:, side_col] = False\n\n    comps = components_mask(movable, connectivity=8)\n    assert comps, \"expected at least one object away from the matching wall\"\n    comps.sort(key=lambda coords: _component_order(coords, direction))\n\n    settled = np.zeros((h, w), dtype=bool)\n    settled[:, side_col] = True\n    out_coords = []\n\n    for coords in comps:\n        shift = 0\n        while True:\n            candidate = coords + np.array([0, shift + direction])\n            cols = candidate[:, 1]\n            if int(cols.min()) < 0 or int(cols.max()) >= w:\n                break\n            if np.any(settled[candidate[:, 0], candidate[:, 1]]):\n                break\n            shift += direction\n\n        placed = coords + np.array([0, shift])\n        assert not np.any(settled[placed[:, 0], placed[:, 1]]), \"settled objects may touch but not overlap\"\n        settled[placed[:, 0], placed[:, 1]] = True\n        out_coords.append(placed)\n\n    return out_coords\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground colors are two non-background colors.\n    - One foreground color fills the left column and the other fills the right column.\n    - Extra 8-connected objects of each wall color appear away from that color's wall.\n\n    Rule\n    - Clear the extra objects from their original positions.\n    - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n    - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n    - Keep the two vertical wall columns fixed.\n\n    Key insight\n    - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n\n    bg = get_bg(g)\n    w = g.shape[1]\n    left_color = int(g[0, 0])\n    right_color = int(g[0, w - 1])\n\n    assert left_color != right_color, \"left and right walls must have different colors\"\n    assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n    assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n    assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n    assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n\n    out = np.full_like(g, int(bg))\n    out[:, 0] = left_color\n    out[:, w - 1] = right_color\n\n    placements: list[tuple[int, np.ndarray]] = []\n    for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n        for coords in _settled_components(g, color, side_col, direction):\n            placements.append((color, coords))\n\n    occupied = (out != bg)\n    for color, coords in placements:\n        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n        out[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n\n    assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n    assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (9, 10)\nGRID_WIDTH_BOUNDS = (9, 10)\nBACKGROUND_COLOR = 7\nWALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n# Object counts and pixel budgets.\nCOMPONENT_COUNT_BOUNDS = (2, 3)\nINNER_FOREGROUND_BOUNDS = (15, 23)\nSPRITE_PIXEL_BOUNDS = (1, 7)\n# Sprite geometry limits.\nSPRITE_HEIGHT_BOUNDS = (1, 5)\nSPRITE_WIDTH_BOUNDS = (1, 3)\nMIN_SPRITE_DENSITY = 0.56\n# Input scatter and retry limits.\nSCATTER_OFFSET_BOUNDS = (1, 5)\nGENERATION_ATTEMPTS = 300\n\nPlacement = tuple[int, np.ndarray, int, int, bool]\n\n\ndef _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n    values = []\n    remaining = int(total)\n    for i in range(int(parts)):\n        slots = int(parts) - i - 1\n        low = max(int(lo), remaining - int(hi) * slots)\n        high = min(int(hi), remaining - int(lo) * slots)\n        value = random.randint(low, high)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _gen_sprite_mask(size: int) -> np.ndarray:\n    size = int(size)\n    dims = [\n        (h, w)\n        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n    ]\n    h, w = random.choice(dims)\n\n    coords: set[tuple[int, int]] = set()\n    length = max(h, w)\n    if length == 1:\n        coords.add((0, 0))\n    else:\n        for i in range(length):\n            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n            coords.add((int(r), int(c)))\n\n    while len(coords) < size:\n        frontier = []\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n                        frontier.append((nr, nc))\n        coords.add(random.choice(frontier))\n\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in coords:\n        mask[r, c] = True\n    if random.choice([False, True]):\n        mask = np.flipud(mask)\n    if random.choice([False, True]):\n        mask = np.fliplr(mask)\n    return mask.copy()\n\n\ndef _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    return np.argwhere(mask) + np.array([int(r0), int(c0)])\n\n\ndef _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:\n    grid = np.full(shape, int(bg), dtype=int)\n    grid[:, 0] = int(left_color)\n    grid[:, shape[1] - 1] = int(right_color)\n    return grid\n\n\ndef _gen_place_output_side(\n    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int\n) -> list[Placement]:\n    h, w = out.shape\n    placements = []\n    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):\n        mh, mw = mask.shape\n        c0 = 1 if left_side else w - 1 - mw\n        rows = list(range(0, h - mh + 1))\n        random.shuffle(rows)\n        for r0 in rows:\n            coords = _gen_mask_coords(mask, r0, c0)\n            if np.any(out[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(out, patch, r0, c0, transparent=bg)\n            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))\n            break\n        else:\n            return []\n    return placements\n\n\ndef _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:\n    for other in existing:\n        dr = np.abs(coords[:, None, 0] - other[None, :, 0])\n        dc = np.abs(coords[:, None, 1] - other[None, :, 1])\n        if bool(np.any((dr <= 1) & (dc <= 1))):\n            return True\n    return False\n\n\ndef _gen_scatter_input(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]\n) -> np.ndarray | None:\n    h, w = shape\n    inp = _gen_base_grid((h, w), bg, left_color, right_color)\n    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}\n\n    shuffled = list(placements)\n    random.shuffle(shuffled)\n    for color, mask, r0, c_out, left_side in shuffled:\n        mh, mw = mask.shape\n        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)\n        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))\n        random.shuffle(offsets)\n        for offset in offsets:\n            c_in = c_out + offset if left_side else c_out - offset\n            coords = _gen_mask_coords(mask, r0, c_in)\n            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            if _gen_touches_existing(coords, by_color[int(color)]):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(inp, patch, r0, c_in, transparent=bg)\n            by_color[int(color)].append(coords)\n            break\n        else:\n            return None\n    return inp\n\n\ndef _gen_output_layout(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int,\n    left_masks: list[np.ndarray], right_masks: list[np.ndarray],\n) -> tuple[np.ndarray, list[Placement]] | None:\n    out = _gen_base_grid(shape, bg, left_color, right_color)\n    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)\n    if len(left_placements) != len(left_masks):\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2faf500b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, in_bounds\nimport random\n\n\ndef _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:\n    fg = colors_present(g, exclude={bg})\n    assert len(fg) == 2, \"expected exactly two foreground colors\"\n\n    counts = {color: int(np.count_nonzero(g == color)) for color in fg}\n    marker_count = min(counts.values())\n    body_count = max(counts.values())\n    markers = [color for color, count in counts.items() if count == marker_count]\n    bodies = [color for color, count in counts.items() if count == body_count]\n    assert marker_count < body_count, \"fracture marker color must be the minority foreground color\"\n    assert len(markers) == 1 and len(bodies) == 1, \"foreground roles must be unique\"\n    return markers[0], bodies[0]\n\n\ndef _set_body(out: np.ndarray, r: int, c: int, color: int) -> None:\n    assert in_bounds(out.shape, r, c), \"shifted object pixel must stay in bounds\"\n    assert int(out[r, c]) != int(color), \"shifted object pixels must not collide\"\n    out[r, c] = int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Remove each fracture marker line and push the surrounding object pixels one cell away from it.\n\n    Input structure\n    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.\n    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.\n\n    Rule\n    - Erase all marker pixels.\n    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.\n    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.\n\n    Key insight\n    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    marker, body = _role_colors(g, bg)\n    out = np.full_like(g, bg)\n\n    objects = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=False,\n        colors=[marker, body],\n    )\n    assert objects, \"expected at least one fractured object\"\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert height != width, \"fractured object bbox must determine an orientation\"\n\n        vals = g[coords[:, 0], coords[:, 1]]\n        assert bool(np.any(vals == marker)), \"each object must contain marker pixels\"\n        assert bool(np.any(vals == body)), \"each object must contain body pixels\"\n\n        marker_coords = coords[vals == marker]\n        if width > height:\n            marker_by_row: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_row.setdefault(int(r), []).append(int(c))\n            assert set(marker_by_row) == set(range(r0, r1 + 1)), \"wide object needs one marker in each row\"\n            assert all(len(cols) == 1 for cols in marker_by_row.values()), \"wide object marker row must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_c = marker_by_row[rr][0]\n                assert cc != marker_c, \"body pixel cannot occupy the marker column\"\n                shifted_c = cc - 1 if cc < marker_c else cc + 1\n                _set_body(out, rr, shifted_c, body)\n        else:\n            marker_by_col: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_col.setdefault(int(c), []).append(int(r))\n            assert set(marker_by_col) == set(range(c0, c1 + 1)), \"tall object needs one marker in each column\"\n            assert all(len(rows) == 1 for rows in marker_by_col.values()), \"tall object marker column must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_r = marker_by_col[cc][0]\n                assert rr != marker_r, \"body pixel cannot occupy the marker row\"\n                shifted_r = rr - 1 if rr < marker_r else rr + 1\n                _set_body(out, shifted_r, cc, body)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, palette, and retry budget.\nBACKGROUND_COLOR = 0\nFOREGROUND_COLORS = tuple(range(1, 10))\nMAX_GRID_SIZE = 19\nMIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)\nGENERATION_RETRIES = 300\n\n# Object counts, dimensions, and orientations.\nMIN_OBJECT_COUNT = 1\nMAX_OBJECT_COUNT = 7\nSHORT_SIDE_SIZES = (2, 3, 4, 5, 6)\nLONG_SIDE_FACTOR = 2\nWIDE = \"wide\"\nTALL = \"tall\"\nORIENTATIONS = [WIDE, TALL]\n\n# Dense layouts try smaller rectangles first while preserving random tie order.\nDENSE_COUNT_THRESHOLD = 6\nDENSE_PREFERRED_MAX_SHORT_SIDE = 3\nPACKED_COUNT_THRESHOLD = 4\nPACKED_PREFERRED_MAX_SHORT_SIDE = 4\n\n# Placement and retry constraints.\nSHIFT_PADDING = 1\nMIN_CHEB_GAP = 2\n\nBBox = tuple[int, int, int, int]\nLocation = tuple[int, int]\nObjectSpec = tuple[int, int, int, str]\n\n\ndef _interval_sep(a0: int, a1: int, b0: int, b1: int) -> int:\n    if a1 < b0:\n        return b0 - a1\n    if b1 < a0:\n        return a0 - b1\n    return 0\n\n\ndef _cheb_gap_at_least_2(a: BBox, b: BBox) -> bool:\n    dr = _interval_sep(a[0], a[2], b[0], b[2])\n    dc = _interval_sep(a[1], a[3], b[1], b[3])\n    return max(dr, dc) >= MIN_CHEB_GAP\n\n\ndef _overlap(a: BBox, b: BBox) -> bool:\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _expanded_bbox(r: int, c: int, h: int, w: int) -> BBox:\n    if w > h:\n        return r, c - SHIFT_PADDING, r + h - 1, c + w - 1 + SHIFT_PADDING\n    return r - SHIFT_PADDING, c, r + h - 1 + SHIFT_PADDING, c + w - 1\n\n\ndef _object_dims(short_side: int, orient: str) -> tuple[int, int]:\n    if orient == WIDE:\n        return short_side, LONG_SIDE_FACTOR * short_side\n    return LONG_SIDE_FACTOR * short_side, short_side\n\n\ndef _locations(n: int, h: int, w: int, originals: list[BBox], expanded: list[BBox]) -> list[Location]:\n    if w > h:\n        row_range = range(0, n - h + 1)\n        col_range = range(SHIFT_PADDING, n - w - SHIFT_PADDING + 1)\n    else:\n        row_range = range(SHIFT_PADDING, n - h - SHIFT_PADDING + 1)\n        col_range = range(0, n - w + 1)\n\n    locs: list[Location] = []\n    for r in row_range:\n        for c in col_range:\n            orig = (r, c, r + h - 1, c + w - 1)\n            exp = _expanded_bbox(r, c, h, w)\n            if any(not _cheb_gap_at_least_2(orig, old) for old in originals):\n                continue\n            if any(_overlap(exp, old) for old in expanded):\n                continue\n            locs.append((r, c))\n    random.shuffle(locs)\n    return locs\n\n\ndef _draw_object(grid: np.ndarray, expected: np.ndarray, r: int, c: int, s: int, orient: str, body: int, marker: int) -> None:\n    h, w = _object_dims(s, orient)\n    grid[r : r + h, c : c + w] = body\n    bits = [0, 1] + [random.randrange(2) for _ in range(s - 2)]\n    random.shuffle(bits)\n\n    if orient == WIDE:\n        rows = r + np.arange(s)\n        marker_cols = c + s - 1 + np.asarray(bits)\n        grid[rows, marker_cols] = marker\n        for row, marker_c in zip(rows, marker_cols):\n            expected[row, c - SHIFT_PADDING : marker_c - SHIFT_PADDING] = body\n            expected[row, marker_c + SHIFT_PADDING + 1 : c + w + SHIFT_PADDING] = body\n    else:\n        cols = c + np.arange(s)\n        marker_rows = r + s - 1 + np.asarray(bits)\n        grid[marker_rows, cols] = marker\n        for col, marker_r in zip(cols, marker_rows):\n            expected[r - SHIFT_PADDING : marker_r - SHIFT_PADDING, col] = body\n            expected[marker_r + SHIFT_PADDING + 1 : r + h + SHIFT_PADDING, col] = body\n\n\ndef _size_order(count: int) -> list[int]:\n    sizes = list(SHORT_SIDE_SIZES)\n    random.shuffle(sizes)\n    if count >= DENSE_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > DENSE_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    if count >= PACKED_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > PACKED_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    return sizes\n\n\ndef _place_objects(n: int, count: int) -> list[ObjectSpec] | None:\n    \"\"\"Pick non-overlapping object specs; return None if this attempt cannot fit them.\"\"\"\n    originals: list[BBox] = []\n    expanded: list[BBox] = []\n    placed: list[ObjectSpec] = []\n\n    for _ in range(count):\n        choices: list[tuple[int, str, list[Location]]] = []\n        for s in _size_order(count):\n            for orient in random.sample(ORIENTATIONS, 2):\n                h, w = _object_dims(s, orient)\n                locs = _locations(n, h, w, originals, expanded)\n                if locs:\n                    choices.append((s, orient, locs))\n        if not choices:\n            return None\n\n        s, orient, locs = random.choice(choices)\n        r, c = random.choice(locs)\n        h, w = _object_dims(s, orient)\n        originals.append((r, c, r + h - 1, c + w - 1))\n        expanded.append(_expanded_bbox(r, c, h, w))\n        placed.append((r, c, s, orient))\n\n    return placed\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    count = random.randint(MIN_OBJECT_COUNT, MAX_OBJECT_COUNT)\n    n = random.randint(MIN_GRID_SIZE_BY_COUNT[count], MAX_GRID_SIZE)\n\n    colors = list(FOREGROUND_COLORS)\n    body = random.choice(colors)\n    colors.remove(body)\n    marker = random.choice(colors)\n\n    placed = _place_objects(n, count)\n    if placed is None:\n        return None\n\n","exit_code":0,"status":"completed"}}
