"\n   194\t    return assignment\n   195\t\n   196\t\n   197\tdef main(grid: np.ndarray) -> np.ndarray:\n   198\t    \"\"\"Match each small key shape to the uniquely compatible 5x5 lock cavity and slide it in to repair the block.\n   199\t\n   200\t    Input structure:\n   201\t    - The background is black.\n   202\t    - Each lock is a monochrome 5x5 block whose color is unique among locks, with one connected black cavity of 2-4 cells cut out from exactly one side.\n   203\t    - Each key is a separate connected 2-4 cell object in another color, positioned outside its lock on the cavity-opening side.\n   204\t\n   205\t    Rule:\n   206\t    - Detect every lock by its 5x5 bounding box and extract the black cavity cells inside it.\n   207\t    - Detect every key as a small connected component, then pair keys to locks by exact shape equality under translation while respecting the lock's opening direction.\n   208\t    - Clear each key from its starting location and fill its matched cavity with the lock color, producing a solid 5x5 square for every lock.\n   209\t\n   210\t    Key insight:\n   211\t    - Colors are distractors: the real correspondence is between the cavity shape inside a lock and the separate key shape that can reach it by a straight translation along the opening axis.\n   212\t    \"\"\"\n   213\t    g = np.asarray(grid, dtype=int)\n   214\t    assert g.ndim == 2, \"expected a 2D grid\"\n   215\t\n   216\t    components = _find_components(g, bg=BG)\n   217\t    assert components, \"expected at least one foreground object\"\n   218\t\n   219\t    locks: list[dict] = []\n   220\t    keys: list[dict] = []\n   221\t    for comp in components:\n   222\t        lock = _lock_from_component(comp, g)\n   223\t        if lock is not None:\n   224\t            locks.append(lock)\n   225\t            continue\n   226\t        key = _key_from_component(comp)\n   227\t        assert key is not None, \"foreground objects must be either locks or keys\"\n   228\t        keys.append(key)\n   229\t\n   230\t    assert locks and len(locks) == len(keys), \"expected one key for each lock\"\n   231\t\n   232\t    matching = _solve_matching(locks, keys)\n   233\t    out = g.copy()\n   234\t\n   235\t    for key in keys:\n   236\t        for r, c in key[\"coords\"]:\n   237\t            out[r, c] = BG\n   238\t\n   239\t    for lock in locks:\n   240\t        r0, c0, r1, c1 = lock[\"bbox\"]\n   241\t        out[r0 : r1 + 1, c0 : c1 + 1] = int(lock[\"color\"])\n   242\t\n   243\t    return out\n   244\t\n   245\t\n   246\tdef _enumerate_cavities() -> dict[str, dict[int, list[dict]]]:\n   247\t    by_side = {side: {size: [] for size in KEY_AREAS} for side in SIDES}\n   248\t    all_cells = [(r, c) for r in range(LOCK_SIZE) for c in range(LOCK_SIZE)]\n   249\t    for size in sorted(KEY_AREAS):\n   250\t        for cells in itertools.combinations(all_cells, size):\n   251\t            mask = np.zeros((LOCK_SIZE, LOCK_SIZE), dtype=bool)\n   252\t            for r, c in cells:\n   253\t                mask[r, c] = True\n   254\t            if not _mask_connected(mask):\n   255\t                continue\n   256\t            if not _mask_connected(~mask):\n   257\t                continue\n   258\t\n   259\t            touched = []\n   260\t            if any(r == 0 for r, _ in cells):\n","exit_code":0,"status":"completed"}}
