{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools\n\nSIDES=['top','bottom','left','right']\n\ndef connected(cells):\n    cells=set(cells)\n    stack=[next(iter(cells))]\n    seen={stack[0]}\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nb=(r+dr,c+dc)\n            if nb in cells and nb not in seen:\n                seen.add(nb)\n                stack.append(nb)\n    return len(seen)==len(cells)\n\ndef comp_connected(cells):\n    rem={(r,c) for r in range(5) for c in range(5)}-set(cells)\n    stack=[next(iter(rem))]\n    seen={stack[0]}\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nb=(r+dr,c+dc)\n            if nb in rem and nb not in seen:\n                seen.add(nb)\n                stack.append(nb)\n    return len(seen)==len(rem)\n\nby_side={s:[] for s in SIDES}\nfor k in range(2,5):\n    for cells in itertools.combinations([(r,c) for r in range(5) for c in range(5)], k):\n        cells=set(cells)\n        if not connected(cells):\n            continue\n        touched=[]\n        if any(r==0 for r,c in cells): touched.append('top')\n        if any(r==4 for r,c in cells): touched.append('bottom')\n        if any(c==0 for r,c in cells): touched.append('left')\n        if any(c==4 for r,c in cells): touched.append('right')\n        if len(touched)\"'!=1:\n            continue\n        if not comp_connected(cells):\n            continue\n        side=touched[0]\n        arr=sorted(cells)\n        by_side[side].append(arr)\n\nfor side,v in by_side.items():\n    sigs=set()\n    for arr in v:\n        rs=[r for r,c in arr]; cs=[c for r,c in arr]\n        sig=tuple(sorted((r-min(rs),c-min(cs)) for r,c in arr))\n        sigs.add(sig)\n    print(side, len(v), len(sigs))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
