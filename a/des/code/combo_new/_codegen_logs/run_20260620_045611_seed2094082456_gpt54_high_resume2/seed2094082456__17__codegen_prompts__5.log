{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r: int, c: int, size: int):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n\n    Input structure:\n    - bg = most common color.\n    - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.\n    - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.\n\n    Rule:\n    - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.\n    - The legend's k×k color patch defines a spatial color map over the rectangle.\n    - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.\n\n    Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=4)\n    assert comps, 'grid must contain at least one non-background component'\n\n    # Identify legend component (most distinct colors) and infer k from number of pieces.\n    k = int(round(len(comps) ** 0.5))\n    assert k * k == len(comps), 'piece count must be a perfect square to determine k'\n\n    comp_colors = []\n    for pts in comps:\n        cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)\n        comp_colors.append(cols)\n\n    max_distinct = max(len(cols) for cols in comp_colors)\n    legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]\n    assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'\n    legend_idx = legend_candidates[0]\n    legend_map = _extract_legend_map(g, comps[legend_idx], k)\n\n    # Build piece masks (coords in bbox space), including filled holes.\n    pieces: list[dict] = []\n    for pts in comps:\n        filled_abs, _ = _fill_holes_in_component(g, pts, bg)\n        r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))\n        rel = tuple((r - r0, c - c0) for r, c in filled_abs)\n        rel_norm, _, _ = _normalize_coords(rel)\n        oris = _dihedral_orientations(rel_norm)\n        pieces.append({\"oris\": oris, \"area\": len(filled_abs)})\n\n    return _assemble_exact_cover(pieces, legend_idx, legend_map, k)\n\n# --------------- generator (o5x) ---------------\n\n# === CFG ===\nSIDE_CHOICES = [8, 10, 12]                     # output square side lengths\nK = 2                                          # k*k quadrant grid (2*2 = 4 pieces)\nNUM_PIECES = K * K                             # total jigsaw pieces\nNUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg\nAREA_FRAC_LO = 0.08                           # min piece area as fraction of total\nAREA_FRAC_HI = 0.43                           # max piece area as fraction of total\nAREA_ABS_LO = 11                              # absolute min piece area (cells)\nAREA_ABS_HI = 62                              # absolute max piece area (cells)\nLEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape\nLEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block\nLEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction\nPARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition\nPARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers\nPARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells\nINPUT_SIZE_LO = 20                             # min input grid side\nINPUT_SIZE_HI = 26                             # max input grid side\nDENSITY_LO = 0.15                              # min non-bg density target\nDENSITY_HI = 0.25                              # max non-bg density target\nSCATTER_BORDER = 1                             # border margin when placing pieces\nSCATTER_PADDING = 1                            # gap between piece bounding boxes\nGEN_RETRIES = 300                              # max attempts in generate_input()\n\n\ndef _area_bounds(side):\n","exit_code":0,"status":"completed"}}
