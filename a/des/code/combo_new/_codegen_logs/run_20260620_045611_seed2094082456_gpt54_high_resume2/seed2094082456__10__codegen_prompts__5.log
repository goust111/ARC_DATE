{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBG = 0\nSEP = 5\nPALETTE = [1,2,3,4,6,7,8,9]\nMAX_GEN = 500\nPLACE_RETRIES = 200\n\n_rng = random.Random()\n\ndef neighbors4(r,c,shape):\n    h,w=shape\n    if r>0: yield r-1,c\n    if r+1<h: yield r+1,c\n    if c>0: yield r,c-1\n    if c+1<w: yield r,c+1\n\n\ndef components(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            stack=[(r,c)]\n            seen[r,c]=True\n            comp=[]\n            while stack:\n                rr,cc=stack.pop()\n                comp.append((rr,cc))\n                for nr,nc in neighbors4(rr,cc,mask.shape):\n                    if mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        stack.append((nr,nc))\n            out.append(comp)\n    return out\n\n\ndef is_line(comp):\n    rows={r for r,_ in comp}\n    cols={c for _,c in comp}\n    n=len(comp)\n    if len(rows)==1:\n        vals=sorted(cols)\n        return vals[-1]-vals[0]+1==n\n    if len(cols)==1:\n        vals=sorted(rows)\n        return vals[-1]-vals[0]+1==n\n    return False\n\n\ndef extract(g):\n    g=np.asarray(g,dtype=int)\n    infos={}\n    colors=[int(c) for c in np.unique(g) if int(c)\"'!=BG]\n    for color in colors:\n        comps=components(g==color)\n        line_comps=[comp for comp in comps if is_line(comp)]\n        assert line_comps, ('\"'no line', color)\n        max_len=max(len(comp) for comp in line_comps)\n        cand=[comp for comp in line_comps if len(comp)==max_len]\n        assert max_len>=2 and len(cand)==1, ('bad line candidates', color, [len(x) for x in comps])\n        seg=cand[0]\n        others=[comp for comp in comps if comp is not seg]\n        assert all(len(comp)==1 for comp in others), ('non-singleton aux', color, [len(x) for x in others])\n        rows=sorted({r for r,_ in seg})\n        cols=sorted({c for _,c in seg})\n        if len(rows)==1:\n            orient='H'\n            r=rows[0]\n            c0=min(c for _,c in seg)\n            c1=max(c for _,c in seg)\n            endpoints=[(r,c0),(r,c1)]\n            probes=[(-1,0),(1,0)]\n        else:\n            orient='V'\n            c=cols[0]\n            r0=min(r for r,_ in seg)\n            r1=max(r for r,_ in seg)\n            endpoints=[(r0,c),(r1,c)]\n            probes=[(0,-1),(0,1)]\n        gate_colors=[]\n        for er,ec in endpoints:\n            found=[]\n            for dr,dc in probes:\n                rr,cc=er+dr,ec+dc\n                if 0<=rr<g.shape[0] and 0<=cc<g.shape[1] and g[rr,cc]\"'!=BG:\n                    found.append(int(g[rr,cc]))\n            assert len(found)<=1, ('\"'multi gate', color, endpoints, found)\n            if found:\n                assert found[0]\"'!=color\n                gate_colors.append(found[0])\n            else:\n                gate_colors.append(None)\n        infos[color]={\n            '\"'color':color,\n            'length':len(seg),\n            'orient':orient,\n            'endpoints':endpoints,\n            'gate_colors':gate_colors,\n            'key':min(seg),\n        }\n    adj={c:set() for c in infos}\n    for color,info in infos.items():\n        for gate_color in info['gate_colors']:\n            if gate_color is None:\n                continue\n            assert gate_color in infos and gate_color\"'!=color\n            adj[color].add(gate_color)\n            adj[gate_color].add(color)\n    for color,neigh in adj.items():\n        deg=len(neigh)\n        assert deg in (1,2), ('\"'bad deg', color, deg, adj)\n    endpoints=[c for c,neigh in adj.items() if len(neigh)==1]\n    assert len(endpoints)==2, ('bad endpoints', endpoints, adj)\n    start=min(endpoints,key=lambda c: infos[c]['key'])\n    order=[]\n    prev=None\n    cur=start\n    seen=set()\n    while True:\n        assert cur not in seen, ('loop', order, adj)\n        order.append(cur)\n        seen.add(cur)\n        nxt=[n for n in adj[cur] if n\"'!=prev]\n        if not nxt:\n            break\n        assert len(nxt)==1, ('\"'branch', cur, adj)\n        prev,cur=cur,nxt[0]\n    assert len(order)==len(infos), ('disconnected', order, adj)\n    width=sum(infos[c]['length'] for c in order)+len(order)-1\n    out=np.full((1,width), SEP, dtype=int)\n    x=0\n    for i,color in enumerate(order):\n        out[0,x:x+infos[color]['length']]=color\n        x += infos[color]['length']\n        if i+1 < len(order):\n            x += 1\n    return order, out\n\n\ndef build_specs(n):\n    colors=_rng.sample(PALETTE, n)\n    while True:\n        lengths=[_rng.randint(2,6) for _ in range(n)]\n        if sum(lengths)+n-1 <= 30:\n            break\n    specs=[]\n    for i in range(n):\n        ends=[None,None]\n        if i==0:\n            ends[_rng.randrange(2)] = i+1\n        elif i==n-1:\n            ends[_rng.randrange(2)] = i-1\n        else:\n            perm=[0,1]\n            _rng.shuffle(perm)\n            ends[perm[0]] = i-1\n            ends[perm[1]] = i+1\n        gate_sides=[None,None]\n        for end,nei in enumerate(ends):\n            if nei is not None:\n                gate_sides[end] = _rng.choice([-1,1])\n        specs.append({\n            'idx':i,\n            'color':colors[i],\n            'length':lengths[i],\n            'orient':_rng.choice(['H','V']),\n            'neighbors':ends,\n            'gate_sides':gate_sides,\n        })\n    if n >= 2 and all(spec['orient']==specs[0]['orient'] for spec in specs):\n        specs[_rng.randrange(n)]['orient'] = 'V' if specs[0]['orient']=='H' else 'H'\n    return specs\n\n\ndef footprint(spec, anchor):\n    r,c=anchor\n    cells=[]\n    gate_cells=[]\n    if spec['orient']=='H':\n        cells=[(r,c+i) for i in range(spec['length'])]\n        ends=[cells[0], cells[-1]]\n        for end_idx, end_cell in enumerate(ends):\n            side=spec['gate_sides'][end_idx]\n            if side is not None:\n                gate_cells.append((end_cell[0]+side, end_cell[1], spec['neighbors'][end_idx]))\n    else:\n        cells=[(r+i,c) for i in range(spec['length'])]\n        ends=[cells[0], cells[-1]]\n        for end_idx, end_cell in enumerate(ends):\n            side=spec['gate_sides'][end_idx]\n            if side is not None:\n                gate_cells.append((end_cell[0], end_cell[1]+side, spec['neighbors'][end_idx]))\n    all_cells=[(rr,cc) for rr,cc in cells] + [(rr,cc) for rr,cc,_ in gate_cells]\n    return cells, gate_cells, all_cells\n\n\ndef bounds_for(spec, H, W):\n    if spec['orient']=='H':\n        min_r=0 + (1 if any(side==-1 for side in spec['gate_sides'] if side is not None) else 0)\n        max_r=H-1 - (1 if any(side==1 for side in spec['gate_sides'] if side is not None) else 0)\n        min_c=0\n        max_c=W-spec['length']\n    else:\n        min_r=0\n        max_r=H-spec['length']\n        min_c=0 + (1 if any(side==-1 for side in spec['gate_sides'] if side is not None) else 0)\n        max_c=W-1 - (1 if any(side==1 for side in spec['gate_sides'] if side is not None) else 0)\n    return min_r, max_r, min_c, max_c\n\n\ndef can_place(all_cells, occ):\n    H,W=occ.shape\n    s=set(all_cells)\n    if len(s)\"'!=len(all_cells):\n        return False\n    for r,c in all_cells:\n        if not (0<=r<H and 0<=c<W):\n            return False\n        if occ[r,c]:\n            return False\n        for rr in range(max(0,r-1), min(H, r+2)):\n            for cc in range(max(0,c-1), min(W, c+2)):\n                if occ[rr,cc] and (rr,cc) not in s:\n                    return False\n    return True\n\n\ndef gen():\n    for _ in range(MAX_GEN):\n        n=_rng.randint(2,6)\n        specs=build_specs(n)\n        base=max(12, 2*n + max(spec['\"'length'] for spec in specs) + 2)\n        H=_rng.randint(base, 30)\n        W=_rng.randint(base, 30)\n        occ=np.zeros((H,W),dtype=bool)\n        placed=[]\n        order=sorted(specs, key=lambda s: -(s['length'] + sum(nei is not None for nei in s['neighbors'])))\n        ok=True\n        for spec in order:\n            min_r,max_r,min_c,max_c = bounds_for(spec,H,W)\n            if min_r>max_r or min_c>max_c:\n                ok=False\n                break\n            placed_one=None\n            for _attempt in range(PLACE_RETRIES):\n                r=_rng.randint(min_r, max_r)\n                c=_rng.randint(min_c, max_c)\n                cells, gate_cells, all_cells = footprint(spec,(r,c))\n                if can_place(all_cells, occ):\n                    for rr,cc in all_cells:\n                        occ[rr,cc]=True\n                    placed_one=(cells,gate_cells)\n                    break\n            if placed_one is None:\n                ok=False\n                break\n            placed.append((spec, *placed_one))\n        if not ok:\n            continue\n        g=np.zeros((H,W),dtype=int)\n        for spec,cells,gate_cells in placed:\n            for r,c in cells:\n                g[r,c]=spec['color']\n            for r,c,nei in gate_cells:\n                g[r,c]=specs[nei]['color']\n        try:\n            order,out=extract(g)\n        except AssertionError:\n            continue\n        if out.shape[1] > 30:\n            continue\n        return g, order, out\n    raise RuntimeError('fail')\n\nsigs=set()\nfor i in range(200):\n    g, order, out = gen()\n    sigs.add((g.shape, g.tobytes()))\n    if i<5:\n        print(i, g.shape, order, out.shape)\nprint('variants', len(sigs))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\n\nBG = 0\nSEP = 5\nPALETTE = [1,2,3,4,6,7,8,9]\nMAX_GEN = 500\nPLACE_RETRIES = 200\n\n_rng = random.Random()\n\ndef neighbors4(r,c,shape):\n    h,w=shape\n    if r>0: yield r-1,c\n    if r+1<h: yield r+1,c\n    if c>0: yield r,c-1\n    if c+1<w: yield r,c+1\n\n\ndef components(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            stack=[(r,c)]\n            seen[r,c]=True\n            comp=[]\n            while stack:\n                rr,cc=stack.pop()\n                comp.append((rr,cc))\n                for nr,nc in neighbors4(rr,cc,mask.shape):\n                    if mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        stack.append((nr,nc))\n            out.append(comp)\n    return out\n\n\ndef is_line(comp):\n    rows={r for r,_ in comp}\n    cols={c for _,c in comp}\n    n=len(comp)\n    if len(rows)==1:\n        vals=sorted(cols)\n        return vals[-1]-vals[0]+1==n\n    if len(cols)==1:\n        vals=sorted(rows)\n        return vals[-1]-vals[0]+1==n\n    return False\n\n\ndef extract(g):\n    g=np.asarray(g,dtype=int)\n    infos={}\n    colors=[int(c) for c in np.unique(g) if int(c)\"'!=BG]\n    for color in colors:\n        comps=components(g==color)\n        line_comps=[comp for comp in comps if is_line(comp)]\n        assert line_comps, ('\"'no line', color)\n        max_len=max(len(comp) for comp in line_comps)\n        cand=[comp for comp in line_comps if len(comp)==max_len]\n        assert max_len>=2 and len(cand)==1, ('bad line candidates', color, [len(x) for x in comps])\n        seg=cand[0]\n        others=[comp for comp in comps if comp is not seg]\n        assert all(len(comp)==1 for comp in others), ('non-singleton aux', color, [len(x) for x in others])\n        rows=sorted({r for r,_ in seg})\n        cols=sorted({c for _,c in seg})\n        if len(rows)==1:\n            orient='H'\n            r=rows[0]\n            c0=min(c for _,c in seg)\n            c1=max(c for _,c in seg)\n            endpoints=[(r,c0),(r,c1)]\n            probes=[(-1,0),(1,0)]\n        else:\n            orient='V'\n            c=cols[0]\n            r0=min(r for r,_ in seg)\n            r1=max(r for r,_ in seg)\n            endpoints=[(r0,c),(r1,c)]\n            probes=[(0,-1),(0,1)]\n        gate_colors=[]\n        for er,ec in endpoints:\n            found=[]\n            for dr,dc in probes:\n                rr,cc=er+dr,ec+dc\n                if 0<=rr<g.shape[0] and 0<=cc<g.shape[1] and g[rr,cc]\"'!=BG:\n                    found.append(int(g[rr,cc]))\n            assert len(found)<=1, ('\"'multi gate', color, endpoints, found)\n            if found:\n                assert found[0]\"'!=color\n                gate_colors.append(found[0])\n            else:\n                gate_colors.append(None)\n        infos[color]={\n            '\"'color':color,\n            'length':len(seg),\n            'orient':orient,\n            'endpoints':endpoints,\n            'gate_colors':gate_colors,\n            'key':min(seg),\n        }\n    adj={c:set() for c in infos}\n    for color,info in infos.items():\n        for gate_color in info['gate_colors']:\n            if gate_color is None:\n                continue\n            assert gate_color in infos and gate_color\"'!=color\n            adj[color].add(gate_color)\n            adj[gate_color].add(color)\n    for color,neigh in adj.items():\n        deg=len(neigh)\n        assert deg in (1,2), ('\"'bad deg', color, deg, adj)\n    endpoints=[c for c,neigh in adj.items() if len(neigh)==1]\n    assert len(endpoints)==2, ('bad endpoints', endpoints, adj)\n    start=min(endpoints,key=lambda c: infos[c]['key'])\n    order=[]\n    prev=None\n    cur=start\n    seen=set()\n    while True:\n        assert cur not in seen, ('loop', order, adj)\n        order.append(cur)\n        seen.add(cur)\n        nxt=[n for n in adj[cur] if n\"'!=prev]\n        if not nxt:\n            break\n        assert len(nxt)==1, ('\"'branch', cur, adj)\n        prev,cur=cur,nxt[0]\n    assert len(order)==len(infos), ('disconnected', order, adj)\n    width=sum(infos[c]['length'] for c in order)+len(order)-1\n    out=np.full((1,width), SEP, dtype=int)\n    x=0\n    for i,color in enumerate(order):\n        out[0,x:x+infos[color]['length']]=color\n        x += infos[color]['length']\n        if i+1 < len(order):\n            x += 1\n    return order, out\n\n\ndef build_specs(n):\n    colors=_rng.sample(PALETTE, n)\n    while True:\n        lengths=[_rng.randint(2,6) for _ in range(n)]\n        if sum(lengths)+n-1 <= 30:\n            break\n    specs=[]\n    for i in range(n):\n        ends=[None,None]\n        if i==0:\n            ends[_rng.randrange(2)] = i+1\n        elif i==n-1:\n            ends[_rng.randrange(2)] = i-1\n        else:\n            perm=[0,1]\n            _rng.shuffle(perm)\n            ends[perm[0]] = i-1\n            ends[perm[1]] = i+1\n        gate_sides=[None,None]\n        for end,nei in enumerate(ends):\n            if nei is not None:\n                gate_sides[end] = _rng.choice([-1,1])\n        specs.append({\n            'idx':i,\n            'color':colors[i],\n            'length':lengths[i],\n            'orient':_rng.choice(['H','V']),\n            'neighbors':ends,\n            'gate_sides':gate_sides,\n        })\n    if n >= 2 and all(spec['orient']==specs[0]['orient'] for spec in specs):\n        specs[_rng.randrange(n)]['orient'] = 'V' if specs[0]['orient']=='H' else 'H'\n    return specs\n\n\ndef footprint(spec, anchor):\n    r,c=anchor\n    cells=[]\n    gate_cells=[]\n    if spec['orient']=='H':\n        cells=[(r,c+i) for i in range(spec['length'])]\n        ends=[cells[0], cells[-1]]\n        for end_idx, end_cell in enumerate(ends):\n            side=spec['gate_sides'][end_idx]\n            if side is not None:\n                gate_cells.append((end_cell[0]+side, end_cell[1], spec['neighbors'][end_idx]))\n    else:\n        cells=[(r+i,c) for i in range(spec['length'])]\n        ends=[cells[0], cells[-1]]\n        for end_idx, end_cell in enumerate(ends):\n            side=spec['gate_sides'][end_idx]\n            if side is not None:\n                gate_cells.append((end_cell[0], end_cell[1]+side, spec['neighbors'][end_idx]))\n    all_cells=[(rr,cc) for rr,cc in cells] + [(rr,cc) for rr,cc,_ in gate_cells]\n    return cells, gate_cells, all_cells\n\n\ndef bounds_for(spec, H, W):\n    if spec['orient']=='H':\n        min_r=0 + (1 if any(side==-1 for side in spec['gate_sides'] if side is not None) else 0)\n        max_r=H-1 - (1 if any(side==1 for side in spec['gate_sides'] if side is not None) else 0)\n        min_c=0\n        max_c=W-spec['length']\n    else:\n        min_r=0\n        max_r=H-spec['length']\n        min_c=0 + (1 if any(side==-1 for side in spec['gate_sides'] if side is not None) else 0)\n        max_c=W-1 - (1 if any(side==1 for side in spec['gate_sides'] if side is not None) else 0)\n    return min_r, max_r, min_c, max_c\n\n\ndef can_place(all_cells, occ):\n    H,W=occ.shape\n    s=set(all_cells)\n    if len(s)\"'!=len(all_cells):\n        return False\n    for r,c in all_cells:\n        if not (0<=r<H and 0<=c<W):\n            return False\n        if occ[r,c]:\n            return False\n        for rr in range(max(0,r-1), min(H, r+2)):\n            for cc in range(max(0,c-1), min(W, c+2)):\n                if occ[rr,cc] and (rr,cc) not in s:\n                    return False\n    return True\n\n\ndef gen():\n    for _ in range(MAX_GEN):\n        n=_rng.randint(2,6)\n        specs=build_specs(n)\n        base=max(12, 2*n + max(spec['\"'length'] for spec in specs) + 2)\n        H=_rng.randint(base, 30)\n        W=_rng.randint(base, 30)\n        occ=np.zeros((H,W),dtype=bool)\n        placed=[]\n        order=sorted(specs, key=lambda s: -(s['length'] + sum(nei is not None for nei in s['neighbors'])))\n        ok=True\n        for spec in order:\n            min_r,max_r,min_c,max_c = bounds_for(spec,H,W)\n            if min_r>max_r or min_c>max_c:\n                ok=False\n                break\n            placed_one=None\n            for _attempt in range(PLACE_RETRIES):\n                r=_rng.randint(min_r, max_r)\n                c=_rng.randint(min_c, max_c)\n                cells, gate_cells, all_cells = footprint(spec,(r,c))\n                if can_place(all_cells, occ):\n                    for rr,cc in all_cells:\n                        occ[rr,cc]=True\n                    placed_one=(cells,gate_cells)\n                    break\n            if placed_one is None:\n                ok=False\n                break\n            placed.append((spec, *placed_one))\n        if not ok:\n            continue\n        g=np.zeros((H,W),dtype=int)\n        for spec,cells,gate_cells in placed:\n            for r,c in cells:\n                g[r,c]=spec['color']\n            for r,c,nei in gate_cells:\n                g[r,c]=specs[nei]['color']\n        try:\n            order,out=extract(g)\n        except AssertionError:\n            continue\n        if out.shape[1] > 30:\n            continue\n        return g, order, out\n    raise RuntimeError('fail')\n\nsigs=set()\nfor i in range(200):\n    g, order, out = gen()\n    sigs.add((g.shape, g.tobytes()))\n    if i<5:\n        print(i, g.shape, order, out.shape)\nprint('variants', len(sigs))\nPY\"","aggregated_output":"0 (27, 27) [7, 4, 2, 3, 6, 9] (1, 26)\n1 (30, 20) [4, 1, 9, 2, 6] (1, 18)\n2 (29, 23) [7, 9, 2, 6, 1, 8] (1, 28)\n3 (17, 16) [1, 3, 4] (1, 12)\n4 (30, 27) [3, 8, 7, 2, 6] (1, 21)\nvariants 200\n","exit_code":0,"status":"completed"}}
