{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ba1aa698.py\"","aggregated_output":"import math\nfrom collections import Counter\nfrom fractions import Fraction, Fraction as _gen_Fraction\n\nimport numpy as np\n\nfrom arc_utils import bbox, is_contiguous, paste\nimport itertools as _gen_itertools\nimport math as _gen_math\nimport random as _gen_random\n\n\ndef _unique_most_common(values) -> int:\n    counts = Counter(map(int, values))\n    ranked = counts.most_common()\n    assert ranked and (len(ranked) == 1 or ranked[0][1] > ranked[1][1])\n    return int(ranked[0][0])\n\n\ndef _round_half_up(value: Fraction) -> int:\n    return math.floor(value + Fraction(1, 2))\n\n\ndef _extract_sprite(panel: np.ndarray, fill: int) -> tuple[np.ndarray, np.ndarray, int, int]:\n    interior_mask = panel[1:-1, 1:-1] != fill\n    box = bbox(interior_mask)\n    assert box is not None\n    r0, local_c0, r1, local_c1 = box\n    r0 += 1\n    r1 += 1\n    local_c0 += 1\n    local_c1 += 1\n\n    sprite = panel[r0 : r1 + 1, local_c0 : local_c1 + 1].copy()\n    sprite_mask = sprite != fill\n    assert np.count_nonzero(sprite_mask) == np.count_nonzero(interior_mask)\n    return sprite, sprite_mask, int(r0), int(local_c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.\n\n    Input structure\n    - The grid is a row of equal-width framed panels sharing their vertical border columns.\n    - Each panel has the same fill color and one identical interior sprite at the same local columns.\n    - The sprite's top row changes by a constant amount from panel to panel.\n\n    Rule\n    - Build one output panel with the same height, frame color, fill color, and sprite.\n    - Continue the sprite's diagonal motion one more panel to the right.\n    - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.\n\n    Key insight\n    - The panels are consecutive frames of motion; the output is the next frame after the sequence.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    frame = int(g[0, 0])\n    assert h >= 3 and w >= 3\n    assert np.all(g[0, :] == frame)\n    assert np.all(g[-1, :] == frame)\n\n    separators = [c for c in range(w) if np.all(g[:, c] == frame)]\n    assert len(separators) >= 3\n    assert separators[0] == 0 and separators[-1] == w - 1\n    strides = [b - a for a, b in zip(separators, separators[1:])]\n    assert len(set(strides)) == 1\n    stride = strides[0]\n    panel_w = stride + 1\n\n    interior_values = []\n    for c0, c1 in zip(separators, separators[1:]):\n        interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())\n    fill = _unique_most_common(interior_values)\n\n    panels = []\n    for c0, c1 in zip(separators, separators[1:]):\n        panel = g[:, c0 : c1 + 1]\n        assert panel.shape == (h, panel_w)\n        assert np.all(panel[0, :] == frame)\n        assert np.all(panel[-1, :] == frame)\n        assert np.all(panel[:, 0] == frame)\n        assert np.all(panel[:, -1] == frame)\n        panels.append(panel)\n\n    template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)\n    top_rows = [first_top]\n    for panel in panels[1:]:\n        sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)\n        assert local_c0 == template_left\n        assert sprite_mask.shape == template_mask.shape\n        assert np.array_equal(sprite_mask, template_mask)\n        assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])\n        top_rows.append(top)\n\n    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]\n    assert len(deltas) >= 1 and len(set(deltas)) == 1\n    next_top = _round_half_up(\n        Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)\n    )\n\n    sprite_h, sprite_w = template_sprite.shape\n    assert 1 <= next_top and next_top + sprite_h <= h - 1\n    assert 1 <= template_left and template_left + sprite_w <= panel_w - 1\n\n    out = np.full((h, panel_w), fill, dtype=int)\n    out[0, :] = frame\n    out[-1, :] = frame\n    out[:, 0] = frame\n    out[:, -1] = frame\n\n    target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]\n    target[template_mask] = template_sprite[template_mask]\n    return out\n\n# --------------- generator (att2) ---------------\n_GEN_HEIGHT, _GEN_LOCAL_LEFT = 16, 2\n_GEN_INTERIOR_WIDTHS, _GEN_PANEL_COUNTS = (4, 5), (3, 4)\n_GEN_COLORS = tuple(range(10))\n_GEN_SPRITE_USES_FRAME_PROB = 0.3\n_GEN_SPRITE_HEIGHTS, _GEN_SPRITE_WIDTHS = (1, 2), (2, 3)\n_GEN_MIN_SPRITE_PIXELS, _GEN_MAX_SPRITE_PIXELS = 2, 5\n_GEN_DELTAS = (-3, -2, -1, 1, 2, 3)\n_GEN_MAX_ATTEMPTS = 300\n_GEN_MASK_CACHE = {}\n\ndef _gen_round_half_up(value):\n    return _gen_math.floor(value + _gen_Fraction(1, 2))\n\ndef _gen_contiguous_masks(sprite_h, sprite_w):\n    key = (sprite_h, sprite_w)\n    if key in _GEN_MASK_CACHE:\n        return _GEN_MASK_CACHE[key]\n    cells = [(r, c) for r in range(sprite_h) for c in range(sprite_w)]\n    masks_by_count = {}\n    max_pixels = min(_GEN_MAX_SPRITE_PIXELS, sprite_h * sprite_w)\n    for pixel_count in range(_GEN_MIN_SPRITE_PIXELS, max_pixels + 1):\n        masks = []\n        for combo in _gen_itertools.combinations(cells, pixel_count):\n            rows = {r for r, _ in combo}\n            cols = {c for _, c in combo}\n            if len(rows) != sprite_h or len(cols) != sprite_w:\n                continue\n            mask = np.zeros((sprite_h, sprite_w), dtype=bool)\n            for r, c in combo:\n                mask[r, c] = True\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n        if masks:\n            masks_by_count[pixel_count] = masks\n    _GEN_MASK_CACHE[key] = masks_by_count\n    return masks_by_count\n\ndef _gen_sprite(fill, sprite_color):\n    sprite_h = _gen_random.choice(_GEN_SPRITE_HEIGHTS)\n    sprite_w = _gen_random.choice(_GEN_SPRITE_WIDTHS)\n    masks_by_count = _gen_contiguous_masks(sprite_h, sprite_w)\n\n    pixel_count = _gen_random.choice(sorted(masks_by_count))\n    mask = _gen_random.choice(masks_by_count[pixel_count])\n    sprite = np.full((sprite_h, sprite_w), fill, dtype=int)\n    sprite[mask] = sprite_color\n    return sprite, mask\n\ndef _gen_make_panel(height, panel_w, frame, fill, sprite, top_row, local_left):\n    panel = np.full((height, panel_w), fill, dtype=int)\n    panel[0, :] = frame\n    panel[-1, :] = frame\n    panel[:, 0] = frame\n    panel[:, -1] = frame\n    paste(panel, sprite, top_row, local_left, transparent=fill)\n    return panel\n\ndef _gen_choose_palette():\n    frame, fill = _gen_random.sample(_GEN_COLORS, 2)\n    if _gen_random.random() < _GEN_SPRITE_USES_FRAME_PROB:\n        sprite_color = frame\n    else:\n        sprite_color = _gen_random.choice(\n            [color for color in _GEN_COLORS if color not in (frame, fill)]\n        )\n    return frame, fill, sprite_color\n\ndef _gen_motion_choices(sprite_h, panel_w, num_panels):\n    max_top = _GEN_HEIGHT - 1 - sprite_h\n    stride = panel_w - 1\n    choices = []\n    for delta in _GEN_DELTAS:\n        for start in range(1, max_top + 1):\n            top_rows = [start + i * delta for i in range(num_panels)]\n            if not all(1 <= top <= max_top for top in top_rows):\n                continue\n            next_top = _gen_round_half_up(\n                _gen_Fraction(top_rows[-1], 1)\n                + _gen_Fraction(delta * panel_w, stride)\n            )\n            if 1 <= next_top <= max_top:\n                choices.append((delta, start, next_top))\n    return choices\n\ndef _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta):\n    width = num_panels * stride + 1\n    inp = np.full((_GEN_HEIGHT, width), fill, dtype=int)\n    inp[0, :] = frame\n    inp[-1, :] = frame\n    for panel_i in range(num_panels + 1):\n        inp[:, panel_i * stride] = frame\n    for panel_i in range(num_panels):\n        top = start_top + panel_i * delta\n        paste(inp, sprite, top, panel_i * stride + _GEN_LOCAL_LEFT, transparent=fill)\n    return inp\n\ndef _gen_attempt():\n    interior_w = _gen_random.choice(_GEN_INTERIOR_WIDTHS)\n    num_panels = _gen_random.choice(_GEN_PANEL_COUNTS)\n    panel_w = interior_w + 2\n    stride = panel_w - 1\n    frame, fill, sprite_color = _gen_choose_palette()\n\n    sprite, _ = _gen_sprite(fill, sprite_color)\n    sprite_h, sprite_w = sprite.shape\n    if _GEN_LOCAL_LEFT + sprite_w > panel_w - 1:\n        return None\n\n    choices = _gen_motion_choices(sprite_h, panel_w, num_panels)\n    if not choices:\n        return None\n    delta, start_top, next_top = _gen_random.choice(choices)\n\n    expected = _gen_make_panel(\n        _GEN_HEIGHT, panel_w, frame, fill, sprite, next_top, _GEN_LOCAL_LEFT\n    )\n    inp = _gen_make_input(num_panels, stride, frame, fill, sprite, start_top, delta)\n    if np.array_equal(main(inp), expected):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid ba1aa698 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f41bd9c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the side-attached foreground object to the opposite wall, shear its lower rows inward, and paint the crossed floor cells.\n\n    Input structure:\n    - The top row is the upper background color and the bottom row is the\n      floor color.\n    - A single non-background, non-floor object touches exactly one vertical\n      grid edge and rests immediately above the first solid floor row.\n\n    Rule:\n    - Clear the source object to the upper background color.\n    - Repaint each object row on the opposite side: the first three relative\n      rows keep the edge alignment, and each lower row shifts one more pixel\n      inward from that side.\n    - On the first floor row, repaint the traversed side-to-object segment\n      maroon, stopping just before the final outer bottom support pixel.\n\n    Key insight:\n    - The side of the source object gives the horizontal direction, while the\n      row index inside the object gives the one-cell-per-row diagonal shear.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be two-dimensional\"\n    height, width = g.shape\n\n    top_colors = np.unique(g[0])\n    bottom_colors = np.unique(g[-1])\n    assert len(top_colors) == 1, \"top row must be a uniform background\"\n    assert len(bottom_colors) == 1, \"bottom row must be a uniform floor\"\n    bg = int(top_colors[0])\n    floor = int(bottom_colors[0])\n    assert bg != floor, \"background and floor colors must differ\"\n\n    colors = set(map(int, np.unique(g)))\n    assert len(colors) == 3, \"expected exactly background, floor, and one object color\"\n    object_colors = colors - {bg, floor}\n    assert len(object_colors) == 1, \"expected one moving object color\"\n    obj = object_colors.pop()\n\n    full_floor_rows = np.where(np.all(g == floor, axis=1))[0]\n    assert len(full_floor_rows) > 0, \"expected a solid floor row\"\n    floor_row = int(full_floor_rows[0])\n    assert 0 < floor_row < height, \"floor row must be inside the grid\"\n    assert np.all(g[floor_row:] == floor), \"floor must be a solid bottom band\"\n\n    obj_coords = np.argwhere(g == obj)\n    assert len(obj_coords) > 0, \"expected a moving object\"\n    r0, c0, r1, c1 = bbox_coords(obj_coords)\n    object_width = c1 - c0 + 1\n    assert r1 == floor_row - 1, \"object must rest directly above the floor\"\n    assert (c0 == 0) ^ (c1 == width - 1), \"object must touch exactly one side edge\"\n    assert np.all(g[:floor_row][g[:floor_row] != obj] == bg), \"upper region must contain only bg and object\"\n\n    moving_right = c0 == 0\n    out = g.copy()\n    out[g == obj] = bg\n\n    for r in range(r0, r1 + 1):\n        rel_r = r - r0\n        rel_cols = np.where(g[r, c0 : c1 + 1] == obj)[0]\n        assert len(rel_cols) > 0, \"every object bbox row must contain object pixels\"\n\n        inward_shift = max(0, rel_r - 2)\n        if moving_right:\n            start_col = width - object_width - inward_shift\n        else:\n            start_col = inward_shift\n        dst_cols = start_col + rel_cols\n        assert int(dst_cols.min()) >= 0 and int(dst_cols.max()) < width, \"moved object must fit in the grid\"\n        out[r, dst_cols] = obj\n\n    bottom_rel_cols = np.where(g[r1, c0 : c1 + 1] == obj)[0]\n    bottom_shift = max(0, r1 - r0 - 2)\n    bottom_start = width - object_width - bottom_shift if moving_right else bottom_shift\n    final_bottom_cols = bottom_start + bottom_rel_cols\n    trail_color = Color.MAROON\n    assert int(trail_color) not in colors, \"trail color must be new\"\n    if moving_right:\n        trail_end = int(final_bottom_cols.max()) - 1\n        assert trail_end >= 0, \"trail must cover at least one floor pixel\"\n        out[floor_row, : trail_end + 1] = int(trail_color)\n    else:\n        trail_start = int(final_bottom_cols.min()) + 1\n        assert trail_start < width, \"trail must cover at least one floor pixel\"\n        out[floor_row, trail_start:] = int(trail_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and band bounds.\nGRID_ROWS = range(16, 19)\nGRID_COLS = (16, 18)\nFLOOR_THICKNESS = range(4, 7)\nEMPTY_ROWS = range(3, 7)\n# Object shape and fit constraints.\nOBJECT_WIDTH = 5\nOBJECT_HEIGHT = (5, 11)\nSOLID_TOP_ROWS = 2\nSHEAR_LOCK_ROWS = 3\nCHECKER_COLS = (0, 2, 4)\n# Colors and retry budget.\nTRAIL_COLOR = int(Color.MAROON)\nAVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]\nMAX_GENERATION_ATTEMPTS = 300\nSIDES = (\"left\", \"right\")\n\nROW_LAYOUTS = [\n    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)\n    for rows in GRID_ROWS\n    for floor_thick in FLOOR_THICKNESS\n    for empty_rows in EMPTY_ROWS\n    if OBJECT_HEIGHT[0] <= rows - floor_thick - empty_rows <= OBJECT_HEIGHT[1]\n]\n\n\ndef _gen_object_mask(height: int) -> np.ndarray:\n    mask = np.zeros((height, OBJECT_WIDTH), dtype=bool)\n    mask[:SOLID_TOP_ROWS, :] = True\n    mask[SOLID_TOP_ROWS:, CHECKER_COLS] = True\n    return mask\n\n\ndef _gen_place_original(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> None:\n    c0 = 0 if side == \"left\" else grid.shape[1] - mask.shape[1]\n    region = grid[top : top + mask.shape[0], c0 : c0 + mask.shape[1]]\n    region[mask] = color\n\n\ndef _gen_place_sheared(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> np.ndarray:\n    width = grid.shape[1]\n    bottom_cols = []\n    for rel_r in range(mask.shape[0]):\n        rel_cols = np.flatnonzero(mask[rel_r])\n        inward_shift = max(0, rel_r - SHEAR_LOCK_ROWS + 1)\n        c0 = width - mask.shape[1] - inward_shift if side == \"right\" else inward_shift\n        dst_cols = c0 + rel_cols\n        grid[top + rel_r, dst_cols] = color\n        bottom_cols = dst_cols\n    return bottom_cols\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    height, floor_thick, empty_rows, obj_h = random.choice(ROW_LAYOUTS)\n    width = random.randint(*GRID_COLS)\n    if OBJECT_WIDTH + max(0, obj_h - SHEAR_LOCK_ROWS) > width:\n        return None\n\n    bg, floor, obj = random.sample(AVAILABLE_COLORS, 3)\n    floor_row = height - floor_thick\n    obj_mask = _gen_object_mask(obj_h)\n    dst_side = random.choice(SIDES)\n    src_side = \"right\" if dst_side == \"left\" else \"left\"\n\n    out = np.full((height, width), bg, dtype=int)\n    out[floor_row:, :] = floor\n    bottom_cols = _gen_place_sheared(out, empty_rows, dst_side, obj, obj_mask)\n    if dst_side == \"right\":\n        out[floor_row, : int(bottom_cols.max())] = TRAIL_COLOR\n    else:\n        out[floor_row, int(bottom_cols.min()) + 1 :] = TRAIL_COLOR\n\n    inp = out.copy()\n    inp[inp == obj] = bg\n    inp[floor_row, inp[floor_row] == TRAIL_COLOR] = floor\n    _gen_place_original(inp, empty_rows, src_side, obj, obj_mask)\n\n    return inp if np.array_equal(main(inp), out) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
