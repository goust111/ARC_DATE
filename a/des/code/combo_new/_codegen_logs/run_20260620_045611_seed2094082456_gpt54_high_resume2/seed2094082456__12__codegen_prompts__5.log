{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed2094082456/12/5.py | sed -n '1,220p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport random\n     4\t\n     5\timport numpy as np\n     6\t\n     7\t\n     8\tBACKGROUND = 0\n     9\t\n    10\t# Generation bounds.\n    11\tGRID_MIN = 16\n    12\tGRID_MAX = 28\n    13\tSEED_COUNT_MIN = 4\n    14\tSEED_COUNT_MAX = 9\n    15\tTEMPLATE_RETRIES = 200\n    16\tLAYOUT_RETRIES = 250\n    17\tGEN_RETRIES = 300\n    18\t\n    19\t# Keep seeds comfortably away from the corner legends.\n    20\tSEED_MARGIN = 4\n    21\t\n    22\t\n    23\tFILLED_BASES = (\n    24\t    np.array(\n    25\t        [\n    26\t            [1, 1, 1],\n    27\t            [0, 1, 0],\n    28\t            [0, 1, 0],\n    29\t        ],\n    30\t        dtype=int,\n    31\t    ),\n    32\t    np.array(\n    33\t        [\n    34\t            [1, 0, 0],\n    35\t            [0, 1, 0],\n    36\t            [0, 0, 1],\n    37\t        ],\n    38\t        dtype=int,\n    39\t    ),\n    40\t    np.array(\n    41\t        [\n    42\t            [1, 1, 0],\n    43\t            [0, 1, 1],\n    44\t            [0, 0, 1],\n    45\t        ],\n    46\t        dtype=int,\n    47\t    ),\n    48\t    np.array(\n    49\t        [\n    50\t            [0, 1, 0],\n    51\t            [1, 1, 1],\n    52\t            [0, 0, 1],\n    53\t        ],\n    54\t        dtype=int,\n    55\t    ),\n    56\t)\n    57\t\n    58\tEMPTY_BASES = (\n    59\t    np.array(\n    60\t        [\n    61\t            [1, 1, 1],\n    62\t            [0, 0, 0],\n    63\t            [0, 0, 0],\n    64\t        ],\n    65\t        dtype=int,\n    66\t    ),\n    67\t    np.array(\n    68\t        [\n    69\t            [1, 0, 0],\n    70\t            [1, 0, 0],\n    71\t            [1, 1, 0],\n    72\t        ],\n    73\t        dtype=int,\n    74\t    ),\n    75\t    np.array(\n    76\t        [\n    77\t            [1, 0, 0],\n    78\t            [1, 0, 0],\n    79\t            [1, 1, 1],\n    80\t        ],\n    81\t        dtype=int,\n    82\t    ),\n    83\t    np.array(\n    84\t        [\n    85\t            [0, 1, 0],\n    86\t            [0, 0, 0],\n    87\t            [1, 0, 1],\n    88\t        ],\n    89\t        dtype=int,\n    90\t    ),\n    91\t)\n    92\t\n    93\t\n    94\tdef _corner_origins(height: int, width: int) -> list[tuple[int, int]]:\n    95\t    return [(0, 0), (0, width - 3), (height - 3, 0), (height - 3, width - 3)]\n    96\t\n    97\t\n    98\tdef _reserved_corners(height: int, width: int) -> np.ndarray:\n    99\t    mask = np.zeros((height, width), dtype=bool)\n   100\t    for r0, c0 in _corner_origins(height, width):\n   101\t        mask[r0 : r0 + 3, c0 : c0 + 3] = True\n   102\t    return mask\n   103\t\n   104\t\n   105\tdef _mask_key(mask: np.ndarray) -> tuple[int, ...]:\n   106\t    return tuple(int(v) for v in mask.flatten())\n   107\t\n   108\t\n   109\tdef _transform_mask(mask: np.ndarray, rot_k: int, flip_lr: bool) -> np.ndarray:\n   110\t    out = np.rot90(mask, k=rot_k)\n   111\t    if flip_lr:\n   112\t        out = np.fliplr(out)\n   113\t    return out.copy()\n   114\t\n   115\t\n   116\tdef _template_anchor(mask: np.ndarray) -> tuple[int, int]:\n   117\t    coords = np.argwhere(mask != 0)\n   118\t    assert len(coords) > 0, \"template must contain at least one colored pixel\"\n   119\t    if bool(mask[1, 1]):\n   120\t        return (1, 1)\n   121\t\n   122\t    center = np.array([1, 1], dtype=int)\n   123\t    dist2 = np.sum((coords - center) ** 2, axis=1)\n   124\t    nearest = coords[dist2 == dist2.min()]\n   125\t    assert len(nearest) == 1, \"center-empty template must have a unique nearest anchor\"\n   126\t    return tuple(int(v) for v in nearest[0])\n   127\t\n   128\t\n   129\tdef _template_offsets(mask: np.ndarray) -> list[tuple[int, int]]:\n   130\t    ar, ac = _template_anchor(mask)\n   131\t    coords = np.argwhere(mask != 0)\n   132\t    return [(int(r) - ar, int(c) - ac) for r, c in coords]\n   133\t\n   134\t\n   135\tdef _seed_footprint(seed: tuple[int, int], offsets: list[tuple[int, int]]) -> set[tuple[int, int]]:\n   136\t    sr, sc = seed\n   137\t    return {(sr + dr, sc + dc) for dr, dc in offsets}\n   138\t\n   139\t\n   140\tdef main(grid: np.ndarray) -> np.ndarray:\n   141\t    \"\"\"\n   142\t    Grow each central seed by stamping the same-colored 3x3 corner template onto the grid.\n   143\t\n   144\t    Input structure:\n   145\t    - Background is black.\n   146\t    - Each corner contains a 3x3 monochrome template on black, and the four template colors are all different.\n   147\t    - Away from the corner legends, the grid contains isolated single-pixel seeds whose colors match one of the corner templates.\n   148\t\n   149\t    Rule:\n   150\t    - Read the 3x3 template in each corner and map its shape by color.\n   151\t    - For each seed, stamp the same-colored template so that the template center aligns to the seed.\n   152\t    - If that template has a black center, instead align the unique colored template cell nearest to the center to the seed.\n   153\t    - Paint only translated template pixels that stay inside the grid and do not land on an input foreground pixel or on any corner 3x3 legend cell.\n   154\t    - Keep the original corner templates and seed pixels unchanged.\n   155\t\n   156\t    Key insight:\n   157\t    - The corner miniatures are a color-keyed legend: each seed grows by printing the exact shape shown in the same-colored corner.\n   158\t    \"\"\"\n   159\t    g = np.asarray(grid, dtype=int)\n   160\t    assert g.ndim == 2 and min(g.shape) >= 6, \"expected a 2D grid large enough for four 3x3 corners\"\n   161\t    height, width = g.shape\n   162\t\n   163\t    reserved = _reserved_corners(height, width)\n   164\t    templates: dict[int, list[tuple[int, int]]] = {}\n   165\t    for r0, c0 in _corner_origins(height, width):\n   166\t        patch = g[r0 : r0 + 3, c0 : c0 + 3]\n   167\t        assert patch.shape == (3, 3), \"each corner legend must be exactly 3x3\"\n   168\t        colors = [int(color) for color in np.unique(patch) if int(color) != BACKGROUND]\n   169\t        assert len(colors) == 1, \"each corner legend must be monochrome\"\n   170\t        color = colors[0]\n   171\t        assert color not in templates, \"corner legend colors must be distinct\"\n   172\t        templates[color] = _template_offsets(patch == color)\n   173\t\n   174\t    assert len(templates) == 4, \"expected four distinct corner legends\"\n   175\t\n   176\t    blockers = reserved | (g != BACKGROUND)\n   177\t    out = g.copy()\n   178\t    for r, c in np.argwhere((g != BACKGROUND) & ~reserved):\n   179\t        color = int(g[r, c])\n   180\t        assert color in templates, \"every seed color must match a corner legend\"\n   181\t        for dr, dc in templates[color]:\n   182\t            rr = int(r) + dr\n   183\t            cc = int(c) + dc\n   184\t            if 0 <= rr < height and 0 <= cc < width and not blockers[rr, cc]:\n   185\t                out[rr, cc] = color\n   186\t    return out\n   187\t\n   188\t\n   189\tdef _sample_templates(rng: random.Random) -> list[np.ndarray]:\n   190\t    for _ in range(TEMPLATE_RETRIES):\n   191\t        chosen: list[np.ndarray] = []\n   192\t        for pool in (FILLED_BASES, EMPTY_BASES):\n   193\t            for base in rng.sample(pool, 2):\n   194\t                mask = _transform_mask(base, rng.randrange(4), rng.random() < 0.5)\n   195\t                try:\n   196\t                    _template_anchor(mask)\n   197\t                except AssertionError:\n   198\t                    break\n   199\t                chosen.append(mask)\n   200\t            else:\n   201\t                continue\n   202\t            break\n   203\t        if len(chosen) != 4:\n   204\t            continue\n   205\t        if len({_mask_key(mask) for mask in chosen}) != 4:\n   206\t            continue\n   207\t        rng.shuffle(chosen)\n   208\t        return chosen\n   209\t    raise RuntimeError(\"failed to sample four distinct corner templates\")\n   210\t\n   211\t\n   212\tdef _sample_seed_positions(\n   213\t    rng: random.Random, height: int, width: int, count: int\n   214\t) -> list[tuple[int, int]] | None:\n   215\t    available = {\n   216\t        (r, c)\n   217\t        for r in range(SEED_MARGIN, height - SEED_MARGIN)\n   218\t        for c in range(SEED_MARGIN, width - SEED_MARGIN)\n   219\t    }\n   220\t    chosen: list[tuple[int, int]] = []\n","exit_code":0,"status":"completed"}}
