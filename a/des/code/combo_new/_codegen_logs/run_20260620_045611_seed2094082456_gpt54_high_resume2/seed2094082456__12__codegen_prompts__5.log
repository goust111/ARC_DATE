    reserved = _reserved_corners(height, width)\n   263\t\n   264\t    colors = rng.sample(range(1, 10), 4)\n   265\t    masks = _sample_templates(rng)\n   266\t    template_map: dict[int, list[tuple[int, int]]] = {}\n   267\t    for color, mask, (r0, c0) in zip(colors, masks, _corner_origins(height, width)):\n   268\t        patch = grid[r0 : r0 + 3, c0 : c0 + 3]\n   269\t        patch[mask != 0] = color\n   270\t        template_map[color] = _template_offsets(mask)\n   271\t\n   272\t    inner_rows = height - 2 * SEED_MARGIN\n   273\t    inner_cols = width - 2 * SEED_MARGIN\n   274\t    max_by_area = max(SEED_COUNT_MIN, min(SEED_COUNT_MAX, (inner_rows * inner_cols) // 7))\n   275\t    count = rng.randint(SEED_COUNT_MIN, max_by_area)\n   276\t\n   277\t    base_colors = colors.copy()\n   278\t    extra_colors = [rng.choice(colors) for _ in range(count - len(colors))]\n   279\t    seed_colors = base_colors + extra_colors\n   280\t    rng.shuffle(seed_colors)\n   281\t\n   282\t    for _ in range(LAYOUT_RETRIES):\n   283\t        positions = _sample_seed_positions(rng, height, width, count)\n   284\t        if positions is None:\n   285\t            return None\n   286\t        seeds = [(r, c, color) for (r, c), color in zip(positions, seed_colors)]\n   287\t        if not _valid_layout(seeds, template_map, reserved):\n   288\t            continue\n   289\t\n   290\t        for r, c, color in seeds:\n   291\t            grid[r, c] = color\n   292\t        return grid\n   293\t    return None\n   294\t\n   295\t\n   296\tdef generate_input() -> np.ndarray:\n   297\t    rng = random.Random()\n   298\t    for _ in range(GEN_RETRIES):\n   299\t        grid = _gen_attempt(rng)\n   300\t        if grid is not None:\n   301\t            return grid\n   302\t    raise RuntimeError(\"failed to generate a valid input\")\n","exit_code":0,"status":"completed"}}
