{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/58f5dbd5.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Carve color-matched motifs into solid blocks and pack them into a compact grid.\n\n    Input structure:\n    - bg = most common color.\n    - Several solid 5×5 monochrome blocks, each a distinct non-bg color.\n    - For each block color, a small same-colored motif sprite elsewhere on the grid.\n\n    Rule:\n    - Match each motif to its same-colored 5×5 block.\n    - Center the motif within the block and recolor those cells to bg (punching holes).\n    - Pack all carved blocks into an output grid preserving their original row/column order, separated by 1-cell gaps and a 1-cell outer border.\n\n    Key insight: The motif acts as a stencil — it's not stamped onto the block but carved out of it as background holes.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    # STEP 1) Identify destination blocks: solid 5x5 monochrome squares.\n    blocks: list[dict[str, int]] = []\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n    for comp in comps:\n        b = comp[\"bbox\"]\n        if bbox_h(b) != 5 or bbox_w(b) != 5:\n            continue\n        col = int(comp[\"color\"])\n        patch = crop_bbox(g, b)\n        if bool((patch == int(col)).all()):\n            r0, c0, _r1, _c1 = map(int, b)\n            blocks.append({\"col\": int(col), \"r0\": int(r0), \"c0\": int(c0)})\n\n    assert not (not blocks)\n\n    # STEP 2) For each block color, identify its motif:\n    # the smallest same-colored component that is NOT one of the 5x5 blocks.\n    motifs: dict[int, np.ndarray] = {}\n    block_colors = {int(b[\"col\"]) for b in blocks}\n    for bcol in block_colors:\n        candidates: list[tuple[int, int, int, int, np.ndarray]] = []  # (area, bbox_area, r0, c0, mask)\n\n        comps_col = find_components(g, bg=bg, connectivity=8, monochromatic=True, colors=[int(bcol)], return_format=\"dict\")\n        for comp in comps_col:\n            b = comp[\"bbox\"]\n            if bbox_h(b) == 5 and bbox_w(b) == 5:\n                patch = crop_bbox(g, b)\n                if bool((patch == int(bcol)).all()):\n                    continue  # skip the big 5x5 blocks\n\n            r0, c0, r1, c1 = map(int, b)\n            h = int(r1 - r0 + 1)\n            w = int(c1 - c0 + 1)\n\n            rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n            m = mask_from_coords(rel_coords, (h, w))\n            candidates.append((int(comp[\"area\"]), int(h * w), int(r0), int(c0), m))\n\n        if candidates:\n            candidates.sort(key=lambda t: (t[0], t[1], t[2], t[3]))\n            motifs[int(bcol)] = candidates[0][4]\n\n    # STEP 3) Carve each 5x5 tile:\n    # center the motif mask within the 5x5 and repaint those mask cells to bg.\n    carved: dict[tuple[int, int], np.ndarray] = {}\n    for b in blocks:\n        col = int(b[\"col\"])\n        tile = np.full((5, 5), int(col), dtype=int)\n        mm = motifs.get(int(col))\n        if mm is not None:\n            mh, mw = map(int, mm.shape)\n            off_r = (5 - mh) // 2\n            off_c = (5 - mw) // 2\n            for rr, cc in np.argwhere(mm):\n                tr = int(off_r + int(rr))\n                tc = int(off_c + int(cc))\n                if 0 <= tr < 5 and 0 <= tc < 5:\n                    tile[tr, tc] = int(bg)\n        carved[(int(b[\"r0\"]), int(b[\"c0\"]))] = tile\n\n    # STEP 4) Pack carved 5x5 tiles into a compact grid.\n    rs = sorted({int(b[\"r0\"]) for b in blocks})\n    cs = sorted({int(b[\"c0\"]) for b in blocks})\n    r_index = {int(r): int(i) for i, r in enumerate(rs)}\n    c_index = {int(c): int(j) for j, c in enumerate(cs)}\n\n    out_h = int(1 + len(rs) * 5 + (len(rs) - 1) * 1 + 1)\n    out_w = int(1 + len(cs) * 5 + (len(cs) - 1) * 1 + 1)\n    out = np.full((out_h, out_w), int(bg), dtype=int)\n\n    step = 6  # 5 block + 1 gap\n    for b in blocks:\n        r0 = int(b[\"r0\"])\n        c0 = int(b[\"c0\"])\n        i = int(r_index[int(r0)])\n        j = int(c_index[int(c0)])\n        rr = int(1 + i * step)\n        cc = int(1 + j * step)\n        out[rr : rr + 5, cc : cc + 5] = carved[(int(r0), int(c0))]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nCANVAS_HEIGHT_RANGE = (18, 22)\nCANVAS_WIDTH_RANGE = (18, 24)\nCOLOR_COUNT = 10\n\n# Destination block geometry.\nDST_BLOCK_SIZE = 5\nDST_BLOCK_STEP = 6\nDST_LAYOUTS = {\n    3: [(1, 3), (3, 1)],\n    4: [(2, 2)],\n    6: [(2, 3), (3, 2)],\n}\n\n# Motif slot geometry and shape constraints.\nMOTIF_SIZE = 3\nMOTIF_STEP = 4\nMOTIF_AREA_RANGE = (4, 8)\nMOTIF_LAYOUTS = {\n    6: [(2, 3), (3, 2)],\n    8: [(2, 4), (4, 2)],\n}\nFILLED_SLOT_RANGE = (6, 8)\nMAX_EMPTY_SLOTS = 2\n\n# Region placement and packed output geometry.\nOUTER_MARGIN = 1\nREGION_GAP = 1\nOUTPUT_BORDER = 1\nMOTIF_OFFSET_IN_BLOCK = 1\n\n# Generation retry budget.\nGENERATION_RETRIES = 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\n","exit_code":0,"status":"completed"}}
