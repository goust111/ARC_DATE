{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random, numpy as np\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed2094082456/15/6.py')\nmod = SourceFileLoader('arc6_diag6', str(p)).load_module()\n\ndef cond(stage, rects, colors):\n    occluded = 0\n    fragmented = False\n    for color in colors:\n        visible = stage == int(color)\n        if int(visible.sum()) < mod.MIN_VISIBLE_CELLS:\n            return False\n        if int(visible.sum()) < mod._rect_area(rects[color]):\n            occluded += 1\n            if mod._count_components(visible) >= 2:\n                fragmented = True\n    return occluded >= 1 and fragmented\n\nreasons = {}\nfor trial in range(300):\n    layer_count = random.choice(mod.LAYER_COUNT_OPTIONS)\n    colors = random.sample(mod.PALETTE, layer_count)\n    dims = mod._sample_dimensions(colors)\n    if dims is None:\n        continue\n    sorted_colors = sorted(colors, key=lambda color: dims[color][0] * dims[color][1])\n    row_data = mod._sample_output_rows(sorted_colors, dims)\n    if row_data is None:\n        continue\n    height, marker_rows = row_data\n    max_width = max(width for _height, width in dims.values())\n    min_stage_width = max(mod.STAGE_WIDTH_RANGE[0], max_width + 5)\n    max_stage_width = min(mod.STAGE_WIDTH_RANGE[1], 29)\n    if min_stage_width > max_stage_width:\n        continue\n    stage_width = random.randint(min_stage_width, max_stage_width)\n    rects = mod._place_rectangles(colors, dims, height, stage_width)\n    if rects is None:\n        continue\n    bottom_to_top = colors[:]\n    random.shuffle(bottom_to_top)\n    stage = mod._render_stage(height, stage_width, rects, bottom_to_top)\n    if not cond(stage, rects, colors):\n        reasons['cond'] = reasons.get('cond',0)+1\n        continue\n    marker_colors = sorted_colors[:]\n    grid = mod._grid_with_markers(stage, marker_rows, marker_colors)\n    marker_rank = {color: idx for idx, color in enumerate(marker_colors)}\n    recovered = mod._recover_solutions(stage, marker_colors, mod.BG, marker_rank, limit=2)\n    reasons[f'recover_{len(recovered)}'] = reasons.get(f'recover_{len(recovered)}',0)+1\n    expected = mod._render_output(grid.shape, stage_width, marker_rows, marker_colors, rects, mod.BG)\n    try:\n        actual = mod.main(grid)\n    except Exception:\n        reasons['main_exc'] = reasons.get('main_exc',0)+1\n        continue\n    if np.array_equal(actual, expected):\n        reasons['success'] = reasons.get('success',0)+1\nprint(reasons)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
