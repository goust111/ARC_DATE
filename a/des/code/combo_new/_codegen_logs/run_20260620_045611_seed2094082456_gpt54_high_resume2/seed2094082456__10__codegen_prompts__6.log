val/58490d8a.py:159:    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:164:    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:171:    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:176:    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:189:    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:197:    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:219:    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:232:    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:245:    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/58490d8a.py:265:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:8:    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:15:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:27:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:31:        \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:22:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:23:    \"\"\"Recolor each placeholder object according to its normalized shape while leaving the background fixed.\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:84:    \"\"\"Return all six shape ids plus 0-2 duplicate ids, then shuffle them.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad38a9d0.py:113:    \"\"\"Place one shape at the first free candidate in a randomized sc