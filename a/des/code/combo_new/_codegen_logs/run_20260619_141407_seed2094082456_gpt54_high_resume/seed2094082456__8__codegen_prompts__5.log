{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/14b8e18c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds\nimport random\n\n\ndef _has_complete_square_border(g: np.ndarray, obj: dict) -> bool:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    h = bbox_h(obj[\"bbox\"])\n    w = bbox_w(obj[\"bbox\"])\n    if h != w or h < 2:\n        return False\n\n    color = int(obj[\"color\"])\n    return bool(\n        np.all(g[r0, c0 : c1 + 1] == color)\n        and np.all(g[r1, c0 : c1 + 1] == color)\n        and np.all(g[r0 : r1 + 1, c0] == color)\n        and np.all(g[r0 : r1 + 1, c1] == color)\n    )\n\n\ndef _corner_marker_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = bbox\n    return [\n        (r0 - 1, c0),\n        (r0, c0 - 1),\n        (r0 - 1, c1),\n        (r0, c1 + 1),\n        (r1 + 1, c0),\n        (r1, c0 - 1),\n        (r1 + 1, c1),\n        (r1, c1 + 1),\n    ]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark every complete square object with red pixels just outside its corners.\n\n    Input structure:\n    - A uniform background contains one or more monochrome 4-connected foreground objects.\n    - The relevant objects are square frames or filled squares: their bbox is square\n      and all cells on the bbox border have the object's color.\n    - Non-square bars and incomplete fragments may also appear and are ignored.\n\n    Rule:\n    - Keep the input unchanged.\n    - For each complete square object, paint red on the two outside background\n      pixels orthogonally adjacent to each of the square's four corners.\n\n    Key insight: The transformation is not based on size or color; it selects\n    objects whose bounding box is a complete square border and labels only their\n    exposed outer corner-adjacent cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    square_objects = [\n        obj\n        for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True)\n        if _has_complete_square_border(g, obj)\n    ]\n    assert square_objects, \"expected at least one complete square object\"\n\n    for obj in square_objects:\n        coords = _corner_marker_coords(obj[\"bbox\"])\n        for r, c in coords:\n            assert in_bounds(g.shape, r, c), \"square object should have one-cell outside margin\"\n            assert int(g[r, c]) == int(bg), \"corner marker positions should be background\"\n            out[r, c] = Color.RED\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# ---- Configuration ----\nGRID_H, GRID_W = 10, 10\nBG_COLOR = Color.ORANGE                       # background color (7)\nFG_COLORS = [Color.PINK, Color.TEAL]          # foreground color choices\nSQUARE_COUNT_RANGE = [1, 2, 3, 4]             # number of squares to attempt\nSQUARE_SIZE_MIN = 2                            # minimum square side length\nMAX_SZ_BY_COUNT = {1: 8, 2: 6, 3: 5, 4: 4}   # max square size per count\nEDGE_MARGIN = 1                                # min gap from grid edge for squares\nDISTRACTOR_COUNT_MAX = 5                       # max distractor objects\nDISTRACTOR_TYPES = ['pixel', 'hbar', 'vbar', 'rect']\nDISTRACTOR_BAR_RANGE = (2, 4)                  # bar/rect dimension range\nDISTRACTOR_PLACE_RETRIES = 80                  # retries per distractor placement\nGEN_MAX_RETRIES = 300                          # outer generate_input retry limit\n\n\ndef _marker_coords(r0, c0, sz):\n    \"\"\"Return the 8 corner-adjacent cells outside a square at (r0,c0) with side `sz`.\"\"\"\n    r1, c1 = r0 + sz - 1, c0 + sz - 1\n    return [\n        (r0 - 1, c0), (r0, c0 - 1),\n        (r0 - 1, c1), (r0, c1 + 1),\n        (r1 + 1, c0), (r1, c0 - 1),\n        (r1 + 1, c1), (r1, c1 + 1),\n    ]\n\n\ndef _border_mask(r0, c0, sz, shape):\n    \"\"\"Return a boolean mask with True on the border cells of a square.\"\"\"\n    mask = np.zeros(shape, dtype=bool)\n    r1, c1 = r0 + sz - 1, c0 + sz - 1\n    mask[r0, c0:c1+1] = True\n    mask[r1, c0:c1+1] = True\n    mask[r0:r1+1, c0] = True\n    mask[r0:r1+1, c1] = True\n    return mask\n\n\ndef _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg):\n    \"\"\"Draw a square frame (or filled 2x2) onto the grid and update tracking masks.\"\"\"\n    r1, c1 = r0 + sz - 1, c0 + sz - 1\n    if sz == 2:\n        grid[r0:r1+1, c0:c1+1] = fg\n    else:\n        grid[r0, c0:c1+1] = fg\n        grid[r1, c0:c1+1] = fg\n        grid[r0:r1+1, c0] = fg\n        grid[r0:r1+1, c1] = fg\n    occupied |= _border_mask(r0, c0, sz, grid.shape)\n    for mr, mc in _marker_coords(r0, c0, sz):\n        marker_reserved[mr, mc] = True\n\n\ndef _distractor_dims(dtype):\n    \"\"\"Return (height, width) for a distractor of the given type.\"\"\"\n    lo, hi = DISTRACTOR_BAR_RANGE\n    if dtype == 'pixel':\n        return 1, 1\n    elif dtype == 'hbar':\n        return 1, random.randint(lo, hi)\n    elif dtype == 'vbar':\n        return random.randint(lo, hi), 1\n    else:\n        dh = random.randint(lo, hi)\n        dw = random.randint(lo, hi)\n        if dh == dw:\n            dw = dh + 1 if dh < hi else dh - 1\n        return dh, dw\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    fg = random.choice(FG_COLORS)\n    grid = np.full((GRID_H, GRID_W), BG_COLOR, dtype=int)\n    occupied = np.zeros((GRID_H, GRID_W), dtype=bool)\n    marker_reserved = np.zeros((GRID_H, GRID_W), dtype=bool)\n\n    num_squares = random.choice(SQUARE_COUNT_RANGE)\n    max_sz = MAX_SZ_BY_COUNT[num_squares]\n    sizes = sorted([random.randint(SQUARE_SIZE_MIN, max_sz)\n                     for _ in range(num_squares)], reverse=True)\n\n    placed_squares = []\n\n    def can_place(r0, c0, sz):\n        r1, c1 = r0 + sz - 1, c0 + sz - 1\n        if r0 < EDGE_MARGIN or c0 < EDGE_MARGIN or r1 > GRID_H - EDGE_MARGIN - 1 or c1 > GRID_W - EDGE_MARGIN - 1:\n            return False\n        for mr, mc in _marker_coords(r0, c0, sz):\n            if mr < 0 or mr >= GRID_H or mc < 0 or mc >= GRID_W:\n                return False\n            if occupied[mr, mc] or marker_reserved[mr, mc]:\n                return False\n        # Border cells must not overlap existing occupied cells\n        if (np.any(occupied[r0, c0:c1+1]) or np.any(occupied[r1, c0:c1+1]) or\n                np.any(occupied[r0:r1+1, c0]) or np.any(occupied[r0:r1+1, c1])):\n            return False\n        return True\n\n    for sz in sizes:\n        positions = [(r0, c0)\n                     for r0 in range(EDGE_MARGIN, GRID_H - sz)\n                     for c0 in range(EDGE_MARGIN, GRID_W - sz)\n                     if can_place(r0, c0, sz)]\n        if not positions:\n            continue\n        r0, c0 = random.choice(positions)\n        _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg)\n        placed_squares.append((r0, c0, sz))\n\n    if not placed_squares:\n        return None\n\n    # Place distractors\n    num_distractors = random.randint(0, DISTRACTOR_COUNT_MAX)\n    for _ in range(num_distractors):\n        dtype = random.choice(DISTRACTOR_TYPES)\n        for _try in range(DISTRACTOR_PLACE_RETRIES):\n            dh, dw = _distractor_dims(dtype)\n            r0 = random.randint(0, GRID_H - dh)\n            c0 = random.randint(0, GRID_W - dw)\n            region = grid[r0:r0+dh, c0:c0+dw]\n            reserved = marker_reserved[r0:r0+dh, c0:c0+dw]\n            if np.all(region == BG_COLOR) and not np.any(reserved):\n                grid[r0:r0+dh, c0:c0+dw] = fg\n                occupied[r0:r0+dh, c0:c0+dw] = True\n                break\n\n    # Validate with solver\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n\n    expected = grid.copy()\n    for r0, c0, sz in placed_squares:\n        for mr, mc in _marker_coords(r0, c0, sz):\n            expected[mr, mc] = Color.RED\n    if not np.array_equal(out, expected):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_MAX_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate input after %d attempts\" % GEN_MAX_RETRIES)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _marker_side(g: np.ndarray, bg: int) -> tuple[str, int]:\n    sides: list[tuple[str, int]] = []\n    for color in set(map(int, g.ravel())) - {bg}:\n        if np.all(g[0, :] == color):\n            sides.append((\"top\", color))\n        if np.all(g[:, -1] == color):\n            sides.append((\"right\", color))\n        if np.all(g[-1, :] == color):\n            sides.append((\"bottom\", color))\n        if np.all(g[:, 0] == color):\n            sides.append((\"left\", color))\n\n    assert len(sides) == 1, sides\n    return sides[0]\n\n\ndef _symbolic_grid(g: np.ndarray) -> tuple[np.ndarray, str, int]:\n    bg = get_bg(g)\n    side, marker = _marker_side(g, bg)\n    assert marker == 1, marker\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    objects: list[tuple[int, int, int]] = []\n    for component in components:\n        color = component[\"color\"]\n        if color == marker:\n            continue\n\n        b = component[\"bbox\"]\n        assert component[\"area\"] == 8, component\n        assert bbox_h(b) == 3 and bbox_w(b) == 3, component\n\n        r0, c0, r1, c1 = b\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        expected = np.full((3, 3), color, dtype=int)\n        expected[1, 1] = bg\n        assert np.array_equal(patch, expected), patch\n        objects.append((r0, c0, color))\n\n    assert objects\n    rows = sorted({r for r, _c, _color in objects})\n    cols = sorted({c for _r, c, _color in objects})\n    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)\n    row_index = {r: i for i, r in enumerate(rows)}\n    col_index = {c: i for i, c in enumerate(cols)}\n\n    for r, c, color in objects:\n        rr = row_index[r]\n        cc = col_index[c]\n        assert symbolic[rr, cc] == bg\n        symbolic[rr, cc] = color\n\n    if side in (\"top\", \"bottom\"):\n        dominant_cols = range(3, 6) if side == \"top\" else range(0, 3)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in range(symbolic.shape[0])\n            for c in dominant_cols\n            if int(symbolic[r, c]) != bg\n        ]\n    else:\n        dominant_rows = range(0, 3) if side == \"left\" else range(3, 6)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in dominant_rows\n            for c in range(symbolic.shape[1])\n            if int(symbolic[r, c]) != bg\n        ]\n    assert dominant_values and set(dominant_values) == {8}, dominant_values\n\n    return symbolic, side, bg\n\n\ndef _compact(symbolic: np.ndarray, side: str, bg: int) -> np.ndarray:\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5ecac7f7.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef _ordered_objects(panel: np.ndarray, bg: int) -> list[dict]:\n    objects = find_components(panel, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"each panel must contain exactly three monochrome objects\"\n\n    objects = sorted(objects, key=lambda obj: obj[\"bbox\"][1])\n    previous_right = -1\n    for obj in objects:\n        _r0, c0, _r1, c1 = obj[\"bbox\"]\n        assert c0 > previous_right, \"panel objects must be strictly ordered left to right\"\n        previous_right = c1\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Combine the left, middle, and right ordered objects from three separated panels.\n\n    Input structure\n    - The grid is three HxH panels separated by one-cell vertical separator bars.\n    - The background is the dominant color, and each panel contains exactly three same-color 4-connected foreground objects.\n\n    Rule\n    - Build a new HxH background canvas.\n    - From the left panel copy its leftmost object, from the middle panel copy its middle object, and from the right panel copy its rightmost object.\n\n    Key insight\n    - The separator bars create three aligned layers, and the panel's own left-to-right object order selects which object survives in the merged output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert W == 3 * H + 2, \"expected three square panels separated by two columns\"\n\n    bg = get_bg(g)\n    sep_a = int(g[0, H])\n    sep_b = int(g[0, 2 * H + 1])\n    assert sep_a == sep_b and sep_a != bg, \"separator bars must use the same non-bg color\"\n    assert bool(np.all(g[:, H] == sep_a)), \"first separator column must be solid\"\n    assert bool(np.all(g[:, 2 * H + 1] == sep_a)), \"second separator column must be solid\"\n\n    panels = [\n        g[:, :H],\n        g[:, H + 1 : 2 * H + 1],\n        g[:, 2 * H + 2 :],\n    ]\n    assert all(panel.shape == (H, H) for panel in panels), \"panels must be HxH\"\n\n    out = np.full((H, H), bg, dtype=int)\n    for panel_index, panel in enumerate(panels):\n        obj = _ordered_objects(panel, bg)[panel_index]\n        color = int(obj[\"color\"])\n        for r, c in obj[\"coords\"]:\n            rr, cc = int(r), int(c)\n            assert out[rr, cc] == bg, \"selected objects must not overlap\"\n            out[rr, cc] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette values observed in the task.\n_BG = 7\n_SEP = 6\n_COLORS = [0, 1, 2, 3, 4, 5, 8, 9]\n\n# Panel geometry and object ordering.\n_GRID_SIZES = [5, 6]\n_N_PANELS = 3\n_OBJECTS_PER_PANEL = 3\n_DISTRACTOR_KEYS = [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)]\n\n# Object-size, density, and color-reuse controls.\n_MAX_OBJECT_AREA = 8\n_AREA_BUDGET_BY_SIZE = {5: 56, 6: 72}\n_MAX_COLOR_REUSES = 2\n\n# Random-growth shape controls.\n_FRONTIER_COMPACT_BIAS = 0.35\n_FRONTIER_COMPACT_TOP_K = 3\n_NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Retry limit for rejecting failed growth or oracle mismatches.\n_MAX_ATTEMPTS = 300\n\n\ndef _segments(H: int) -> list[tuple[int, int]]:\n    a, b = sorted(random.sample(range(1, H), 2))\n    return [(0, a - 1), (a, b - 1), (b, H - 1)]\n\n\ndef _object_patch(H: int, cols: tuple[int, int], color: int, area: int) -> np.ndarray | None:\n    c0, c1 = cols\n    W = c1 - c0 + 1\n    target = int(area)\n    if target < 1 or target > H * W:\n        return None\n\n    start = (random.randrange(H), random.randrange(W))\n    cells = {start}\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _NEIGHBOR_DELTAS:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in cells:\n                frontier.add((rr, cc))\n\n    add_frontier(*start)\n    while len(cells) < target:\n        if not frontier:\n            return None\n        if random.random() < _FRONTIER_COMPACT_BIAS:\n            options = sorted(\n                frontier,\n                key=lambda rc: sum(\n                    (rc[0] + dr, rc[1] + dc) in cells for dr, dc in _NEIGHBOR_DELTAS\n                ),\n                reverse=True,\n            )\n            top_k = max(1, min(_FRONTIER_COMPACT_TOP_K, len(options)))\n            cell = random.choice(options[:top_k])\n        else:\n            cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        cells.add(cell)\n        add_frontier(*cell)\n\n    patch = np.full((H, H), _BG, dtype=int)\n    for r, c in cells:\n        patch[r, c0 + c] = int(color)\n    return patch\n\n\ndef _choose_area(H: int, cols: tuple[int, int], budget: int, remaining_slots: int) -> int | None:\n    width = cols[1] - cols[0] + 1\n    high = min(_MAX_OBJECT_AREA, H * width, budget - (remaining_slots - 1))\n    if high < 1:\n        return None\n    return random.randint(1, high)\n\n\ndef _assign_colors(selected: list[int]) -> dict[tuple[int, int], int] | None:\n    colors = {(i, i): int(selected[i]) for i in range(_OBJECTS_PER_PANEL)}\n    used_by_panel = [set() for _ in range(_N_PANELS)]\n    counts = {c: 0 for c in _COLORS}\n    for i, color in enumerate(selected):\n        used_by_panel[i].add(int(color))\n        counts[int(color)] += 1\n\n    distractors = list(_DISTRACTOR_KEYS)\n    random.shuffle(distractors)\n    for panel_i, obj_i in distractors:\n        options = [\n            color\n            for color in _COLORS\n            if counts[color] < _MAX_COLOR_REUSES and color not in used_by_panel[panel_i]\n        ]\n        if not options:\n            return None\n        color = random.choice(options)\n        colors[(panel_i, obj_i)] = color\n        used_by_panel[panel_i].add(color)\n        counts[color] += 1\n    return colors\n\n\ndef _sample_patch(H: int, segs: list[tuple[int, int]], obj_i: int, color: int, budget: int, remaining: int):\n    area = _choose_area(H, segs[obj_i], budget, remaining)\n    if area is None:\n        return None\n    patch = _object_patch(H, segs[obj_i], color, area)\n    if patch is None:\n        return None\n    return patch, budget - area, remaining - 1\n\n\ndef _sample_objects(H: int, segs: list[tuple[int, int]], selected_colors: list[int], colors):\n    \"\"\"Return all panel objects plus the expected merged output.\"\"\"\n    budget = _AREA_BUDGET_BY_SIZE[H]\n    remaining = _N_PANELS * _OBJECTS_PER_PANEL\n    objects: dict[tuple[int, int], np.ndarray] = {}\n    out = np.full((H, H), _BG, dtype=int)\n\n    for i in range(_OBJECTS_PER_PANEL):\n        sampled = _sample_patch(H, segs, i, selected_colors[i], budget, remaining)\n        if sampled is None:\n            return None\n        patch, budget, remaining = sampled\n        objects[(i, i)] = patch\n        paste(out, patch, 0, 0, transparent=_BG)\n\n    for panel_i, obj_i in _DISTRACTOR_KEYS:\n        sampled = _sample_patch(H, segs, obj_i, colors[(panel_i, obj_i)], budget, remaining)\n        if sampled is None:\n            return None\n        patch, budget, remaining = sampled\n        objects[(panel_i, obj_i)] = patch\n    return objects, out\n\n\ndef _render_input(H: int, objects: dict[tuple[int, int], np.ndarray]) -> np.ndarray:\n    \"\"\"Render all objects into three panels separated by solid bars.\"\"\"\n    inp = np.full((H, _N_PANELS * H + (_N_PANELS - 1)), _BG, dtype=int)\n    for sep_i in range(1, _N_PANELS):\n        inp[:, sep_i * H + (sep_i - 1)] = _SEP\n    for panel_i in range(_N_PANELS):\n        panel = np.full((H, H), _BG, dtype=int)\n        for obj_i in range(_OBJECTS_PER_PANEL):\n            paste(panel, objects[(panel_i, obj_i)], 0, 0, transparent=_BG)\n        paste(inp, panel, 0, panel_i * (H + 1))\n    return inp\n\n\ndef _passes_oracle(inp: np.ndarray, expected: np.ndarray) -> bool:\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return False\n    return bool(np.array_equal(actual, expected))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.choice(_GRID_SIZES)\n    segs = _segments(H)\n    selected_colors = random.sample(_COLORS, _OBJECTS_PER_PANEL)\n    colors = _assign_colors(selected_colors)\n    if colors is None:\n        return None\n\n    sampled = _sample_objects(H, segs, selected_colors, colors)\n    if sampled is None:\n        return None\n","exit_code":0,"status":"completed"}}
