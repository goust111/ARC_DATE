{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, get_bg, paste\nimport random\nfrom itertools import product\n\n\ndef _unique_largest_non_bg_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(map(int, g.flatten()))\n    non_bg_counts = [(color, count) for color, count in counts.items() if color != int(bg)]\n    assert non_bg_counts\n\n    largest_count = max(count for _color, count in non_bg_counts)\n    candidates = [color for color, count in non_bg_counts if count == largest_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _mask_bbox(g: np.ndarray, mask_color: int) -> tuple[int, int, int, int]:\n    mask = g == int(mask_color)\n    comps = components_mask(mask, connectivity=4)\n    assert len(comps) == 1\n\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _palette(g: np.ndarray, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n    palette_mask = (g != int(bg)) & (g != int(mask_color))\n    b = bbox(palette_mask)\n    assert b is not None\n\n    palette = crop_bbox(g, b)\n    assert palette.shape == (3, int(width))\n    assert bool(np.all(palette != int(bg)))\n    assert bool(np.all(palette != int(mask_color)))\n    assert bool(np.array_equal(palette[0], palette[1]))\n    assert len(set(map(int, palette[2]))) == 1\n\n    column_colors = palette[0].copy()\n    hole_color = int(palette[2, 0])\n    return column_colors, hole_color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n    else:\n        mask_r = top\n        palette_r = top + int(mask_h) + int(gap)\n    mask_c = random.randint(0, int(grid_w) - int(mask_w))\n    palette_c = random.randint(0, int(grid_w) - int(mask_w))\n    paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)\n    paste(grid, palette, palette_r, palette_c, transparent=None)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    dims = _sample_dimensions()\n    if dims is None:\n        return None\n    mask_h, mask_w, gap, grid_h, grid_w = dims\n\n    column_colors, hole_color = _sample_palette(mask_w)\n    area = int(mask_h) * int(mask_w)\n    min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n    max_area = int(np.floor(MASK_DENSITY_MAX * area))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, paste\n\n\ndef _rect_item(g: np.ndarray, color: int) -> dict:\n    coords = np.argwhere(g == int(color))\n    assert coords.size, \"expected a present color\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    area = h * w\n\n    rel = coords - np.array([r0, c0])\n    on_border = (\n        (rel[:, 0] == 0)\n        | (rel[:, 0] == h - 1)\n        | (rel[:, 1] == 0)\n        | (rel[:, 1] == w - 1)\n    )\n    if int(coords.shape[0]) == area:\n        kind = \"solid\"\n    else:\n        assert bool(np.all(on_border)), \"foreground colors must form rectangles or rectangular frames\"\n        kind = \"frame\"\n\n    return {\n        \"color\": int(color),\n        \"kind\": kind,\n        \"height\": h,\n        \"width\": w,\n        \"area\": area,\n    }\n\n\ndef _foreground_rectangles(g: np.ndarray) -> list[dict]:\n    items = []\n    for color in np.unique(g):\n        comps = components_mask(g == int(color), connectivity=4)\n        sizes = [int(comp.shape[0]) for comp in comps]\n        assert sizes, \"unique colors must have at least one component\"\n\n        # Wallpaper colors appear as many tiny disconnected islands; overlaid\n        # rectangle colors have one large component, sometimes split by occlusion.\n        if max(sizes) <= 3:\n            continue\n        assert len(comps) <= 4, \"foreground rectangle colors have only a few visible components\"\n        items.append(_rect_item(g, int(color)))\n\n    assert len(items) >= 2, \"expected at least two nested foreground rectangles\"\n    areas = [item[\"area\"] for item in items]\n    assert len(areas) == len(set(areas)), \"rectangle areas must define a unique nesting order\"\n    items.sort(key=lambda item: int(item[\"area\"]), reverse=True)\n    return items\n\n\ndef _paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    color = int(item[\"color\"])\n    h = int(item[\"height\"])\n    w = int(item[\"width\"])\n    assert 0 <= r and 0 <= c and r + h <= out.shape[0] and c + w <= out.shape[1]\n\n    if item[\"kind\"] == \"solid\":\n        out[r : r + h, c : c + w] = color\n        return r, c, h, w\n\n    assert item[\"kind\"] == \"frame\"\n    assert h >= 3 and w >= 3, \"frames must have an interior\"\n    out[r, c : c + w] = color\n    out[r + h - 1, c : c + w] = color\n    out[r : r + h, c] = color\n    out[r : r + h, c + w - 1] = color\n    return r + 1, c + 1, h - 2, w - 2\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n\n\ndef _randint(lo: int, hi: int) -> int:\n    return int(_RNG.integers(int(lo), int(hi) + 1))\n\n\ndef _choice(seq):\n    return seq[_randint(0, len(seq) - 1)]\n\n\ndef _sample(seq, k: int) -> list[int]:\n    idx = _RNG.choice(len(seq), size=int(k), replace=False)\n    return [int(seq[int(i)]) for i in idx]\n\n\ndef _shuffled(seq) -> list[int]:\n    vals = list(seq)\n    _RNG.shuffle(vals)\n    return [int(v) for v in vals]\n\n\ndef _choose_dims(\n    h_min: int,\n    h_max: int,\n    w_min: int,\n    w_max: int,\n    used_areas: set[int],\n    *,\n    min_area: int = 0,\n) -> tuple[int, int] | None:\n    pairs = [\n        (h, w)\n        for h in range(int(h_min), int(h_max) + 1)\n        for w in range(int(w_min), int(w_max) + 1)\n        if h * w > int(min_area) and h * w not in used_areas\n    ]\n    return _choice(pairs) if pairs else None\n\n\ndef _build_items() -> list[dict]:\n    \"\"\"Build a largest-to-smallest rectangle chain with unique bbox areas.\"\"\"\n    n_items = _randint(*ITEM_COUNT_RANGE)\n    if n_items == ITEM_COUNT_RANGE[1]:\n        n_frames = FOUR_ITEM_FRAME_COUNT\n    else:\n        n_frames = _choice(THREE_ITEM_FRAME_OPTIONS)\n    n_solids = n_items - n_frames\n\n    colors = _sample(FOREGROUND_COLORS, n_items)\n    chain = []\n    used_areas: set[int] = set()\n\n    h = _randint(*INNER_SOLID_HEIGHT_RANGE)\n    w = _randint(*INNER_SOLID_WIDTH_RANGE)\n    chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n    used_areas.add(h * w)\n\n    if n_solids == 2:\n        dims = _choose_dims(h, SECOND_SOLID_MAX_HEIGHT, w, SECOND_SOLID_MAX_WIDTH, used_areas, min_area=h * w)\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"solid\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    if n_frames == 2:\n        dims = _choose_dims(\n            h + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_HEIGHT, h + INNER_FRAME_MAX_GROWTH),\n            w + FRAME_MIN_GROWTH,\n            min(INNER_FRAME_MAX_WIDTH, w + INNER_FRAME_MAX_GROWTH),\n            used_areas,\n        )\n        if dims is None:\n            return []\n        h, w = dims\n        chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n        used_areas.add(h * w)\n\n    dims = _choose_dims(\n        max(OUTER_FRAME_MIN_HEIGHT, h + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_HEIGHT,\n        max(OUTER_FRAME_MIN_WIDTH, w + FRAME_MIN_GROWTH),\n        OUTER_FRAME_MAX_WIDTH,\n        used_areas,\n    )\n    if dims is None:\n        return []\n    h, w = dims\n    chain.append({\"kind\": \"frame\", \"height\": h, \"width\": w})\n\n    items = list(reversed(chain))\n    for item, color in zip(items, colors):\n        item[\"color\"] = int(color)\n        item[\"area\"] = int(item[\"height\"] * item[\"width\"])\n    return items\n\n\ndef _item_size(item: dict) -> tuple[int, int]:\n    return int(item[\"height\"]), int(item[\"width\"])\n\n\ndef _paint_item_view(view: np.ndarray, item: dict) -> None:\n    color = int(item[\"color\"])\n    if item[\"kind\"] == \"solid\":\n        view[:, :] = color\n    else:\n        view[0, :] = color\n        view[-1, :] = color\n        view[:, 0] = color\n        view[:, -1] = color\n\n\ndef _gen_paint_item(out: np.ndarray, item: dict, r: int, c: int) -> tuple[int, int, int, int]:\n    h, w = _item_size(item)\n    _paint_item_view(out[r : r + h, c : c + w], item)\n    if item[\"kind\"] == \"solid\":\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/db615bd4.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, get_bg, paste\nimport random\n\n\ndef _bbox_area(b: tuple[int, int, int, int]) -> int:\n    r0, c0, r1, c1 = b\n    return (r1 - r0 + 1) * (c1 - c0 + 1)\n\n\ndef _bboxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    ar0, ac0, ar1, ac1 = a\n    br0, bc0, br1, bc1 = b\n    return ar0 <= br1 and br0 <= ar1 and ac0 <= bc1 and bc0 <= ac1\n\n\ndef _is_sparse_rect_perimeter(coords: np.ndarray) -> bool:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    rel = coords - np.array([r0, c0])\n    if np.any(rel % 2 != 0):\n        return False\n\n    h = (r1 - r0) // 2 + 1\n    w = (c1 - c0) // 2 + 1\n    expected = h * w if h == 1 or w == 1 else 2 * h + 2 * w - 4\n    if coords.shape[0] != expected:\n        return False\n\n    points = {tuple(map(int, p)) for p in coords}\n    for r in range(r0, r1 + 1, 2):\n        for c in range(c0, c1 + 1, 2):\n            on_border = h == 1 or w == 1 or r in (r0, r1) or c in (c0, c1)\n            if ((r, c) in points) != on_border:\n                return False\n    return True\n\n\ndef _solidified_mask(coords: np.ndarray) -> np.ndarray:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    rel = coords - np.array([r0, c0])\n    assert np.all(rel % 2 == 0), \"sprite pixels must sit on a two-step lattice\"\n\n    h = (r1 - r0) // 2 + 1\n    w = (c1 - c0) // 2 + 1\n    logical = np.zeros((h, w), dtype=bool)\n    for dr, dc in rel:\n        logical[int(dr) // 2, int(dc) // 2] = True\n\n    return np.kron(logical, np.ones((2, 2), dtype=bool))[: 2 * h - 1, : 2 * w - 1]\n\n\ndef _place_sprites_in_order(\n    out: np.ndarray,\n    sprites: list[dict],\n    frame_bbox: tuple[int, int, int, int],\n    horizontal: bool,\n) -> None:\n    r0, c0, r1, c1 = frame_bbox\n    interior_h = r1 - r0 - 1\n    interior_w = c1 - c0 - 1\n    assert interior_h > 0 and interior_w > 0, \"frame needs an interior\"\n\n    if horizontal:\n        order_keys = [(sp[\"bbox\"][1], sp[\"bbox\"][0]) for sp in sprites]\n        assert len(set(order_keys)) == len(order_keys), \"source x-order must be unique\"\n        sprites.sort(key=lambda sp: (sp[\"bbox\"][1], sp[\"bbox\"][0]))\n\n        total_w = sum(sp[\"mask\"].shape[1] for sp in sprites)\n        slack = interior_w - total_w\n        assert slack > 0 and slack % (len(sprites) + 1) == 0, \"sprites must leave equal horizontal gaps\"\n        gap = slack // (len(sprites) + 1)\n        cursor = c0 + 1 + gap\n\n        for sp in sprites:\n            mask = sp[\"mask\"]\n            ph, pw = mask.shape\n            cross_slack = interior_h - ph\n            assert cross_slack >= 0 and cross_slack % 2 == 0, \"sprite must center vertically\"\n            rr = r0 + 1 + cross_slack // 2\n            patch = np.full(mask.shape, int(sp[\"color\"]), dtype=int)\n            paste(out, patch, rr, cursor, mask=mask)\n            cursor += pw + gap\n    else:\n        order_keys = [(sp[\"bbox\"][0], sp[\"bbox\"][1]) for sp in sprites]\n        assert len(set(order_keys)) == len(order_keys), \"source y-order must be unique\"\n        sprites.sort(key=lambda sp: (sp[\"bbox\"][0], sp[\"bbox\"][1]))\n\n        total_h = sum(sp[\"mask\"].shape[0] for sp in sprites)\n        slack = interior_h - total_h\n        assert slack > 0 and slack % (len(sprites) + 1) == 0, \"sprites must leave equal vertical gaps\"\n        gap = slack // (len(sprites) + 1)\n        cursor = r0 + 1 + gap\n\n        for sp in sprites:\n            mask = sp[\"mask\"]\n            ph, pw = mask.shape\n            cross_slack = interior_w - pw\n            assert cross_slack >= 0 and cross_slack % 2 == 0, \"sprite must center horizontally\"\n            cc = c0 + 1 + cross_slack // 2\n            patch = np.full(mask.shape, int(sp[\"color\"]), dtype=int)\n            paste(out, patch, cursor, cc, mask=mask)\n            cursor += ph + gap\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Thicken the sparse frame and stamp the external sparse sprites into it in positional order.\n\n    Input structure\n    The grid has a dominant background color, a regular lattice color, one large\n    sparse rectangular frame, and one or more external monochrome sprites whose\n    pixels also sit on a two-step lattice.\n\n    Rule\n    Use the largest sparse rectangular perimeter as the frame. Clear that frame\n    region and the external sprite pixels to background, draw a solid one-pixel\n    border in the frame color, solidify each sparse sprite into its contiguous\n    two-step mask, and place the sprites inside the frame with equal gaps.\n    Wide frames receive sprites left-to-right by source position; tall frames\n    receive them top-to-bottom by source position.\n\n    Key insight\n    The frame supplies ordered slots: the sprite-to-slot assignment is by visible\n    source order, not by numeric color or by matching individual cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.ravel()))\n    non_bg = colors_present(g, exclude={bg})\n    assert non_bg, \"expected foreground colors\"\n\n    max_non_bg_count = max(counts[c] for c in non_bg)\n    lattice_candidates = [c for c in non_bg if counts[c] == max_non_bg_count]\n    assert len(lattice_candidates) == 1, \"lattice color must be uniquely most frequent\"\n    lattice_color = lattice_candidates[0]\n\n    special_colors = [c for c in non_bg if c != lattice_color]\n    assert len(special_colors) >= 2, \"expected one frame and at least one sprite\"\n\n    coords_by_color = {c: np.argwhere(g == c) for c in special_colors}\n    frame_candidates = []\n    for color, coords in coords_by_color.items():\n        if _is_sparse_rect_perimeter(coords):\n            frame_candidates.append((color, bbox_coords(coords)))\n    assert frame_candidates, \"expected a sparse rectangular frame\"\n\n    max_area = max(_bbox_area(b) for _color, b in frame_candidates)\n    largest_frames = [(color, b) for color, b in frame_candidates if _bbox_area(b) == max_area]\n    assert len(largest_frames) == 1, \"frame must be the unique largest sparse perimeter\"\n    frame_color, frame_bbox = largest_frames[0]\n\n    source_colors = [c for c in special_colors if c != frame_color]\n    r0, c0, r1, c1 = frame_bbox\n    interior_h = r1 - r0 - 1\n    interior_w = c1 - c0 - 1\n    assert interior_h != interior_w, \"frame must have a unique long axis\"\n\n    sprites = []\n    for color in source_colors:\n        coords = coords_by_color[color]\n        b = bbox_coords(coords)\n        assert not _bboxes_overlap(b, frame_bbox), \"sprites must be outside the frame\"\n        mask = _solidified_mask(coords)\n        assert mask.any(), \"sprite mask must be nonempty\"\n        sprites.append({\"color\": color, \"bbox\": b, \"mask\": mask})\n\n    out = g.copy()\n    for color in source_colors:\n        coords = coords_by_color[color]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    out[r0, c0 : c1 + 1] = frame_color\n    out[r1, c0 : c1 + 1] = frame_color\n    out[r0 : r1 + 1, c0] = frame_color\n    out[r0 : r1 + 1, c1] = frame_color\n\n    _place_sprites_in_order(out, sprites, frame_bbox, horizontal=interior_w > interior_h)\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and lattice geometry.\nGRID_SIZE, LATTICE_STEP = 25, 2\nODD_ANCHOR_START, EVEN_ANCHOR_START = 1, 0\n\n# Palette roles.\nCOLOR_RANGE, BASE_COLOR_COUNT = range(10), 3\n\n# Sprite and frame logical dimensions.\nSPRITE_COUNTS = [2, 3]\nSPRITE_DIM_MIN, SPRITE_DIM_MAX = 1, 3\nALONG_SUM_MIN, ALONG_SUM_MAX = 3, 7\nFRAME_DIM_MIN, FRAME_DIM_MAX = 5, 9\nFRAME_MARGIN_DIMS = 2\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _choose_along_dims(n_sprites: int) -> list[int] | None:\n    along_dims = []\n    for i in range(n_sprites):\n        remaining = n_sprites - i - 1\n        current_sum = sum(along_dims)\n        lo = max(SPRITE_DIM_MIN, ALONG_SUM_MIN - current_sum - SPRITE_DIM_MAX * remaining)\n        hi = min(SPRITE_DIM_MAX, ALONG_SUM_MAX - current_sum - SPRITE_DIM_MIN * remaining)\n        if lo > hi:\n            return None\n        along_dims.append(random.randint(lo, hi))\n    return along_dims\n\n\ndef _choose_frame_shape(horizontal: bool, n_sprites: int) -> tuple[int, int, list[tuple[int, int]]] | None:\n    cross_dim = random.randint(SPRITE_DIM_MIN, SPRITE_DIM_MAX)\n    along_dims = _choose_along_dims(n_sprites)\n    if along_dims is None:\n        return None\n\n    frame_along = sum(along_dims) + FRAME_MARGIN_DIMS\n    min_cross = max(FRAME_DIM_MIN, cross_dim + 1)\n    possible_cross = [v for v in range(min_cross, FRAME_DIM_MAX + 1) if v != frame_along]\n    if not possible_cross:\n        return None\n\n    frame_cross = random.choice(possible_cross)\n    if horizontal:\n        return frame_cross, frame_along, [(cross_dim, w_l) for w_l in along_dims]\n    return frame_along, frame_cross, [(h_l, cross_dim) for h_l in along_dims]\n\n\ndef _pixel_bbox(sr: int, sc: int, h_l: int, w_l: int) -> tuple[int, int, int, int]:\n    return (sr, sc, sr + LATTICE_STEP * (h_l - 1), sc + LATTICE_STEP * (w_l - 1))\n\n\ndef _overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]\n\n\ndef _choose_odd_bbox(h_l: int, w_l: int) -> tuple[int, int, int, int] | None:\n    max_r = GRID_SIZE - 1 - LATTICE_STEP * (h_l - 1)\n    max_c = GRID_SIZE - 1 - LATTICE_STEP * (w_l - 1)\n    valid_r = list(range(ODD_ANCHOR_START, max_r + 1, LATTICE_STEP))\n    valid_c = list(range(ODD_ANCHOR_START, max_c + 1, LATTICE_STEP))\n    if not valid_r or not valid_c:\n        return None\n\n    r0 = random.choice(valid_r)\n    c0 = random.choice(valid_c)\n    return _pixel_bbox(r0, c0, h_l, w_l)\n\n\ndef _stamp_sparse_frame(grid: np.ndarray, frame_bbox: tuple[int, int, int, int], frame_color: int) -> None:\n    r0, c0, r1, c1 = frame_bbox\n    grid[r0 : r1 + 1 : LATTICE_STEP, c0] = frame_color\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"from __future__ import annotations\n\nimport math\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, crop_bbox, get_bg, label_mask\nimport random\n\n\ndef _count_enclosed_regions(walls: np.ndarray) -> int:\n    labels, n_labels = label_mask(~walls, connectivity=4)\n    h, w = walls.shape\n    count = 0\n    for k in range(1, n_labels + 1):\n        coords = np.argwhere(labels == k)\n        assert coords.size > 0\n        touches_edge = (\n            np.any(coords[:, 0] == 0)\n            or np.any(coords[:, 0] == h - 1)\n            or np.any(coords[:, 1] == 0)\n            or np.any(coords[:, 1] == w - 1)\n        )\n        if not touches_edge:\n            count += 1\n    return int(count)\n\n\ndef _reconstruct_walls(mask: np.ndarray) -> np.ndarray:\n    h, _w = mask.shape\n    col_counts = mask.sum(axis=0)\n    v_threshold = max(3, math.ceil(0.45 * h))\n    vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]\n    if len(vcols) < 2:\n        return mask.copy()\n\n    row_counts = mask.sum(axis=1)\n    h_threshold = max(3, len(vcols) + 1)\n    hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]\n    assert len(hrows) >= 2\n\n    walls = np.zeros_like(mask, dtype=bool)\n\n    for r in hrows:\n        for c0, c1 in zip(vcols, vcols[1:]):\n            segment = mask[r, c0 : c1 + 1]\n            length = int(c1 - c0 + 1)\n            hits = int(segment.sum())\n            dense = hits >= max(2, math.ceil(0.45 * length))\n            interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())\n            if dense or interior_evidence:\n                walls[r, c0 : c1 + 1] = True\n\n    for c in vcols:\n        for r0, r1 in zip(hrows, hrows[1:]):\n            segment = mask[r0 : r1 + 1, c]\n            length = int(r1 - r0 + 1)\n            hits = int(segment.sum())\n            if hits >= max(2, math.ceil(0.45 * length)):\n                walls[r0 : r1 + 1, c] = True\n\n    return walls\n\n\ndef _room_count_for_color(g: np.ndarray, color: int) -> int:\n    b = bbox(g == int(color))\n    assert b is not None\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    return _count_enclosed_regions(walls)\n\n\ndef _walls_for_color(g: np.ndarray, color: int) -> np.ndarray:\n    b = bbox(g == int(color))\n    assert b is not None\n    r0, c0, r1, c1 = b\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    out = np.zeros_like(g, dtype=bool)\n    out[r0 : r1 + 1, c0 : c1 + 1] = walls\n    return out\n\n\ndef _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:\n    if len(group) == 1:\n        return group\n\n    by_color = {int(item[0]): item for item in group}\n    above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}\n    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}\n\n    for i, (ca, _ra, wa) in enumerate(group):\n        for cb, _rb, wb in group[i + 1 :]:\n            overlap = wa & wb\n            if not bool(overlap.any()):\n                continue\n            visible = set(int(v) for v in np.unique(g[overlap]))\n            top_colors = visible & {int(ca), int(cb)}\n            assert len(top_colors) == 1\n            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\"","aggregated_output":"import numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _bands(size: int, separators: list[int]) -> list[tuple[int, int]]:\n    bands = []\n    start = 0\n    for cut in separators:\n        if start < cut:\n            bands.append((start, cut - 1))\n        start = cut + 1\n    if start < size:\n        bands.append((start, size - 1))\n    return bands\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the compact table of solid cells hidden inside a separator lattice.\n\n    Input structure\n    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.\n    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.\n\n    Rule\n    - Split the input into lattice cells using the full separator rows and columns.\n    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.\n\n    Key insight\n    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}\n    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}\n    sep_colors = row_colors & col_colors\n    assert len(sep_colors) == 1, \"there must be exactly one row/column separator color\"\n    sep = next(iter(sep_colors))\n    assert row_colors == {sep}, \"all full rows must be separator rows\"\n    assert col_colors == {sep}, \"all full columns must be separator columns\"\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]\n    assert sep_rows and sep_cols, \"separator lattice must have rows and columns\"\n\n    row_bands = _bands(h, sep_rows)\n    col_bands = _bands(w, sep_cols)\n\n    solid_cells = {}\n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            cell = g[r0 : r1 + 1, c0 : c1 + 1]\n            if np.all(cell == cell[0, 0]):\n                solid_cells[(ri, ci)] = int(cell[0, 0])\n    assert solid_cells, \"must contain at least one solid lattice cell\"\n\n    solid_rows = [ri for ri, _ in solid_cells]\n    solid_cols = [ci for _, ci in solid_cells]\n    r0, r1 = min(solid_rows), max(solid_rows)\n    c0, c1 = min(solid_cols), max(solid_cols)\n\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for ri in range(r0, r1 + 1):\n        for ci in range(c0, c1 + 1):\n            assert (ri, ci) in solid_cells, \"solid lattice cells must form a rectangle\"\n            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.\nVALID_LC = [(4, 6), (5, 5), (6, 4)]\nCOLOR_COUNT = 10\nSEPARATOR_WIDTH = 1\n# Solid rectangle: output block size in lattice coordinates.\nSOLID_SIZE_RANGE = (2, 3)\n# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.\nPATTERN_TILE_MIN_COLORS = 5\nPATTERN_CELL_MIN_COLORS = 2\nDIAGONAL_ID_BITS = 4\n# Retry budget: regenerate on rare validation failures.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:\n    \"\"\"Build one structured tile per lattice diagonal, or {} if validation fails.\"\"\"\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    random.shuffle(colors)\n    palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]\n    palette_arr = np.asarray(palette, dtype=int)\n    k = len(palette)\n\n    rr, cc = np.indices((csize, csize))\n    base = (rr + cc + random.randrange(k)) % k\n    if random.choice([False, True]):\n        base = base.T\n    if random.choice([False, True]):\n        base = np.fliplr(base)\n    if random.choice([False, True]):\n        base = np.flipud(base)\n    tiles = {}\n    for diag in range(2 * lattice - 1):\n        tile_idx = (base + random.randrange(k)) % k\n        tile = palette_arr[tile_idx]\n        # Encode the diagonal id in four cells so variants are guaranteed distinct.\n        for bit in range(DIAGONAL_ID_BITS):\n            tile.flat[bit] = palette[(diag >> bit) & 1]\n        if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:\n            return {}\n        tiles[diag] = tile\n    return tiles\n\n\ndef _sample_solid_block(lattice, colors):\n    \"\"\"Return ((row, col, height, width), output colors) for the solid block.\"\"\"\n    solid_h = random.randint(*SOLID_SIZE_RANGE)\n    solid_w = random.randint(*SOLID_SIZE_RANGE)\n    solid_r0 = random.randint(0, lattice - solid_h)\n    solid_c0 = random.randint(0, lattice - solid_w)\n    flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)\n    if len(set(map(int, flat))) == 1:\n        change_at = random.randrange(len(flat))\n        flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])\n    return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))\n\n\ndef _render_grid(lattice, csize, sep, block, out, tiles):\n    \"\"\"Assemble the separator lattice from solid cells and pattern tiles.\"\"\"\n    n = lattice * csize + (lattice - 1)\n    grid = np.full((n, n), sep, dtype=int)\n    solid_r0, solid_c0, solid_h, solid_w = block\n    stride = csize + SEPARATOR_WIDTH\n    for ri in range(lattice):\n        for ci in range(lattice):\n            r0, c0 = ri * stride, ci * stride\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)\n            else:\n                cell = tiles[(ri - ci) % (2 * lattice - 1)]\n            paste(grid, cell, r0, c0)\n    return grid\n\n\ndef _valid_generated_grid(grid, lattice, csize, sep, block):\n    \"\"\"Check separator lines and non-solid cells before the solver oracle.\"\"\"\n    stride = csize + SEPARATOR_WIDTH\n    sep_lines = [csize + i * stride for i in range(lattice - 1)]\n    if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):\n        return False\n    solid_r0, solid_c0, solid_h, solid_w = block\n    for ri in range(lattice):\n        for ci in range(lattice):\n            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:\n                continue\n            r0, c0 = ri * stride, ci * stride\n            if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    lattice, csize = random.choice(VALID_LC)\n    sep = random.randrange(COLOR_COUNT)\n    colors = [c for c in range(COLOR_COUNT) if c != sep]\n    block, out = _sample_solid_block(lattice, colors)\n    tiles = _pattern_tiles(csize, lattice, sep)\n    if not tiles:\n        return None\n    grid = _render_grid(lattice, csize, sep, block, out, tiles)\n    if not _valid_generated_grid(grid, lattice, csize, sep, block):\n        return None\n    try:\n        if not np.array_equal(main(grid), out):\n            return None\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n","exit_code":0,"status":"completed"}}
