{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed2094082456/6/1.py | sed -n '1,260p'\"","aggregated_output":"     1\timport random\n     2\t\n     3\timport numpy as np\n     4\t\n     5\t\n     6\tORTH_DIRS = {\n     7\t    \"up\": (-1, 0),\n     8\t    \"down\": (1, 0),\n     9\t    \"left\": (0, -1),\n    10\t    \"right\": (0, 1),\n    11\t}\n    12\tHORIZONTAL_DIRS = {\"left\", \"right\"}\n    13\tVERTICAL_DIRS = {\"up\", \"down\"}\n    14\tARROW_MASKS = {\n    15\t    \"up\": np.array(\n    16\t        [\n    17\t            [0, 1, 0],\n    18\t            [1, 1, 1],\n    19\t            [0, 0, 0],\n    20\t        ],\n    21\t        dtype=bool,\n    22\t    ),\n    23\t    \"down\": np.array(\n    24\t        [\n    25\t            [0, 0, 0],\n    26\t            [1, 1, 1],\n    27\t            [0, 1, 0],\n    28\t        ],\n    29\t        dtype=bool,\n    30\t    ),\n    31\t    \"left\": np.array(\n    32\t        [\n    33\t            [0, 1, 0],\n    34\t            [1, 1, 0],\n    35\t            [0, 1, 0],\n    36\t        ],\n    37\t        dtype=bool,\n    38\t    ),\n    39\t    \"right\": np.array(\n    40\t        [\n    41\t            [0, 1, 0],\n    42\t            [0, 1, 1],\n    43\t            [0, 1, 0],\n    44\t        ],\n    45\t        dtype=bool,\n    46\t    ),\n    47\t}\n    48\tGEN_RETRIES = 400\n    49\tPLACEMENT_PADDING = 1\n    50\t\n    51\t\n    52\tdef _get_bg(grid: np.ndarray) -> int:\n    53\t    values, counts = np.unique(grid, return_counts=True)\n    54\t    return int(values[np.argmax(counts)])\n    55\t\n    56\t\n    57\tdef _color_components(grid: np.ndarray, bg: int) -> list[dict]:\n    58\t    h, w = grid.shape\n    59\t    visited = np.zeros((h, w), dtype=bool)\n    60\t    comps: list[dict] = []\n    61\t    for r in range(h):\n    62\t        for c in range(w):\n    63\t            if visited[r, c] or int(grid[r, c]) == bg:\n    64\t                continue\n    65\t            color = int(grid[r, c])\n    66\t            stack = [(r, c)]\n    67\t            visited[r, c] = True\n    68\t            coords: list[tuple[int, int]] = []\n    69\t            while stack:\n    70\t                cr, cc = stack.pop()\n    71\t                coords.append((cr, cc))\n    72\t                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    73\t                    nr, nc = cr + dr, cc + dc\n    74\t                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:\n    75\t                        visited[nr, nc] = True\n    76\t                        stack.append((nr, nc))\n    77\t            rows = [p[0] for p in coords]\n    78\t            cols = [p[1] for p in coords]\n    79\t            r0, r1 = min(rows), max(rows)\n    80\t            c0, c1 = min(cols), max(cols)\n    81\t            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    82\t            for rr, cc in coords:\n    83\t                mask[rr - r0, cc - c0] = True\n    84\t            comps.append(\n    85\t                {\n    86\t                    \"color\": color,\n    87\t                    \"coords\": coords,\n    88\t                    \"bbox\": (r0, c0, r1, c1),\n    89\t                    \"mask\": mask,\n    90\t                }\n    91\t            )\n    92\t    return comps\n    93\t\n    94\t\n    95\tdef _is_frame(mask: np.ndarray) -> bool:\n    96\t    h, w = mask.shape\n    97\t    if h < 5 or w < 5:\n    98\t        return False\n    99\t    return bool(\n   100\t        np.all(mask[0, :])\n   101\t        and np.all(mask[-1, :])\n   102\t        and np.all(mask[:, 0])\n   103\t        and np.all(mask[:, -1])\n   104\t        and not np.any(mask[1:-1, 1:-1])\n   105\t    )\n   106\t\n   107\t\n   108\tdef _arrow_direction(mask: np.ndarray) -> str | None:\n   109\t    if mask.shape != (3, 3) or int(mask.sum()) != 4:\n   110\t        return None\n   111\t    for name, pattern in ARROW_MASKS.items():\n   112\t        if np.array_equal(mask, pattern):\n   113\t            return name\n   114\t    return None\n   115\t\n   116\t\n   117\tdef _choose_direction_from_clue(coords: np.ndarray, ih: int, iw: int) -> str:\n   118\t    rows = coords[:, 0]\n   119\t    cols = coords[:, 1]\n   120\t    if int(rows.min()) == int(rows.max()):\n   121\t        left_margin = int(cols.min())\n   122\t        right_margin = int(iw - 1 - cols.max())\n   123\t        if left_margin == right_margin:\n   124\t            center = (iw - 1) / 2.0\n   125\t            return \"left\" if float(cols.mean()) < center else \"right\"\n   126\t        return \"left\" if left_margin < right_margin else \"right\"\n   127\t    if int(cols.min()) == int(cols.max()):\n   128\t        top_margin = int(rows.min())\n   129\t        bottom_margin = int(ih - 1 - rows.max())\n   130\t        if top_margin == bottom_margin:\n   131\t            center = (ih - 1) / 2.0\n   132\t            return \"up\" if float(rows.mean()) < center else \"down\"\n   133\t        return \"up\" if top_margin < bottom_margin else \"down\"\n   134\t    raise AssertionError(\"expected a one-cell-thick horizontal or vertical clue line\")\n   135\t\n   136\t\n   137\tdef _scale_mask(mask: np.ndarray, out_shape: tuple[int, int]) -> np.ndarray:\n   138\t    out_h, out_w = out_shape\n   139\t    scaled = np.zeros(out_shape, dtype=bool)\n   140\t    src_h, src_w = mask.shape\n   141\t    for r in range(src_h):\n   142\t        rr0 = r * out_h // src_h\n   143\t        rr1 = (r + 1) * out_h // src_h\n   144\t        for c in range(src_w):\n   145\t            if not mask[r, c]:\n   146\t                continue\n   147\t            cc0 = c * out_w // src_w\n   148\t            cc1 = (c + 1) * out_w // src_w\n   149\t            scaled[rr0:rr1, cc0:cc1] = True\n   150\t    return scaled\n   151\t\n   152\t\n   153\tdef main(grid: np.ndarray) -> np.ndarray:\n   154\t    \"\"\"\n   155\t    Replace each framed clue line with the matching scaled arrow chosen from same-color external arrows.\n   156\t\n   157\t    Input structure:\n   158\t    - The background is the dominant color.\n   159\t    - Several one-pixel-thick rectangular hollow frames of different colors are scattered on the grid.\n   160\t    - Inside each frame is a detached same-color clue made of a short horizontal row or vertical column.\n   161\t    - Outside the frames are detached 3x3 same-color T-shaped arrows pointing up, down, left, or right.\n   162\t\n   163\t    Rule:\n   164\t    - For each frame, read the clue orientation: a horizontal clue chooses between left/right arrows, and a vertical clue chooses between up/down arrows.\n   165\t    - Break that tie using the clue offset inside the frame: clues closer to the left, right, top, or bottom select the arrow pointing toward that side.\n   166\t    - Scale the chosen 3x3 arrow to the frame interior and repaint that interior with the frame color, replacing the old clue and blank cells.\n   167\t    - Keep the frames themselves and every external arrow unchanged.\n   168\t\n   169\t    Key insight:\n   170\t    - Color links arrows to frames, while the clue uses two visible signals at once: its row/column orientation picks the axis and its off-center position picks the final direction.\n   171\t    \"\"\"\n   172\t    g = np.asarray(grid, dtype=int)\n   173\t    bg = _get_bg(g)\n   174\t    comps = _color_components(g, bg)\n   175\t\n   176\t    frames: list[dict] = []\n   177\t    arrows_by_color: dict[int, set[str]] = {}\n   178\t    for comp in comps:\n   179\t        if _is_frame(comp[\"mask\"]):\n   180\t            frames.append(comp)\n   181\t            continue\n   182\t        direction = _arrow_direction(comp[\"mask\"])\n   183\t        if direction is not None:\n   184\t            arrows_by_color.setdefault(int(comp[\"color\"]), set()).add(direction)\n   185\t\n   186\t    out = g.copy()\n   187\t    for frame in frames:\n   188\t        color = int(frame[\"color\"])\n   189\t        r0, c0, r1, c1 = frame[\"bbox\"]\n   190\t        interior = g[r0 + 1 : r1, c0 + 1 : c1]\n   191\t        clue_coords = np.argwhere(interior == color)\n   192\t        assert len(clue_coords) >= 2, \"each frame needs an internal clue line\"\n   193\t        ih, iw = interior.shape\n   194\t        direction = _choose_direction_from_clue(clue_coords, ih, iw)\n   195\t        assert color in arrows_by_color and direction in arrows_by_color[color], \"missing matching external arrow\"\n   196\t\n   197\t        fill = out[r0 + 1 : r1, c0 + 1 : c1]\n   198\t        fill[:] = bg\n   199\t        scaled = _scale_mask(ARROW_MASKS[direction], (ih, iw))\n   200\t        fill[scaled] = color\n   201\t\n   202\t    return out\n   203\t\n   204\t\n   205\tdef _draw_frame_border(patch: np.ndarray, color: int) -> None:\n   206\t    patch[0, :] = color\n   207\t    patch[-1, :] = color\n   208\t    patch[:, 0] = color\n   209\t    patch[:, -1] = color\n   210\t\n   211\t\n   212\tdef _sample_canvas_shape(n_frames: int) -> tuple[int, int]:\n   213\t    low = 22 if n_frames == 2 else 24\n   214\t    rows = random.randint(low, 30)\n   215\t    cols = random.randint(low, 30)\n   216\t    if random.random() < 0.65:\n   217\t        cols = min(30, max(low, rows + random.choice([-3, -2, -1, 0, 1, 2, 3])))\n   218\t    return rows, cols\n   219\t\n   220\t\n   221\tdef _target_directions(n_frames: int) -> list[str]:\n   222\t    dirs = [random.choice([\"left\", \"right\"]), random.choice([\"up\", \"down\"])]\n   223\t    if n_frames == 3:\n   224\t        dirs.append(random.choice(list(ORTH_DIRS)))\n   225\t    random.shuffle(dirs)\n   226\t    return dirs\n   227\t\n   228\t\n   229\tdef _sample_horizontal_clue(iw: int, direction: str) -> tuple[int, int]:\n   230\t    choices: list[tuple[int, int]] = []\n   231\t    for length in range(2, min(4, iw - 2) + 1):\n   232\t        for start in range(1, iw - length):\n   233\t            left = start\n   234\t            right = iw - length - start\n   235\t            if right < 1:\n   236\t                continue\n   237\t            if direction == \"left\" and left < right:\n   238\t                choices.append((length, start))\n   239\t            if direction == \"right\" and right < left:\n   240\t                choices.append((length, start))\n   241\t    if not choices:\n   242\t        raise AssertionError(\"no valid horizontal clue placement\")\n   243\t    return random.choice(choices)\n   244\t\n   245\t\n   246\tdef _sample_vertical_clue(ih: int, direction: str) -> tuple[int, int]:\n   247\t    choices: list[tuple[int, int]] = []\n   248\t    for length in range(2, min(4, ih - 2) + 1):\n   249\t        for start in range(1, ih - length):\n   250\t            top = start\n   251\t            bottom = ih - length - start\n   252\t            if bottom < 1:\n   253\t                continue\n   254\t            if direction == \"up\" and top < bottom:\n   255\t                choices.append((length, start))\n   256\t            if direction == \"down\" and bottom < top:\n   257\t                choices.append((length, start))\n   258\t    if not choices:\n   259\t        raise AssertionError(\"no valid vertical clue placement\")\n   260\t    return random.choice(choices)\n","exit_code":0,"status":"completed"}}
