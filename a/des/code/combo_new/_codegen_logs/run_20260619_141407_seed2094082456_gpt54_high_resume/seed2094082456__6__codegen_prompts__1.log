objects(rows: int, cols: int, objects: list[dict]) -> list[tuple[int, int]] | None:\n   306\t    order = sorted(range(len(objects)), key=lambda idx: objects[idx][\"input\"].shape[0] * objects[idx][\"input\"].shape[1], reverse=True)\n   307\t    placements: list[tuple[int, int] | None] = [None] * len(objects)\n   308\t    boxes: list[tuple[int, int, int, int]] = []\n   309\t\n   310\t    for idx in order:\n   311\t        patch = objects[idx][\"input\"]\n   312\t        ph, pw = patch.shape\n   313\t        candidates = [(r, c) for r in range(rows - ph + 1) for c in range(cols - pw + 1)]\n   314\t        random.shuffle(candidates)\n   315\t        chosen = None\n   316\t        for r, c in candidates:\n   317\t            box = (r, c, r + ph - 1, c + pw - 1)\n   318\t            if any(_boxes_overlap(box, other, PLACEMENT_PADDING) for other in boxes):\n   319\t                continue\n   320\t            chosen = (r, c)\n   321\t            boxes.append(box)\n   322\t            break\n   323\t        if chosen is None:\n   324\t            return None\n   325\t        placements[idx] = chosen\n   326\t\n   327\t    return [p for p in placements if p is not None]\n   328\t\n   329\t\n   330\tdef _paint_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:\n   331\t    region = grid[top : top + patch.shape[0], left : left + patch.shape[1]]\n   332\t    mask = patch != bg\n   333\t    region[mask] = patch[mask]\n   334\t\n   335\t\n   336\tdef _gen_attempt() -> np.ndarray | None:\n   337\t    n_frames = random.choice([2, 3])\n   338\t    rows, cols = _sample_canvas_shape(n_frames)\n   339\t    bg = random.randint(0, 9)\n   340\t    palette = [color for color in range(10) if color != bg]\n   341\t    frame_colors = random.sample(palette, n_frames)\n   342\t    directions = _target_directions(n_frames)\n   343\t\n   344\t    objects: list[dict] = []\n   345\t    for color, direction in zip(frame_colors, directions):\n   346\t        frame_inp, frame_out = _make_frame_patches(bg, color, direction)\n   347\t        objects.append({\"input\": frame_inp, \"output\": frame_out})\n   348\t        for arrow_direction in (\"up\", \"down\", \"left\", \"right\"):\n   349\t            arrow = _make_arrow_patch(bg, color, arrow_direction)\n   350\t            objects.append({\"input\": arrow, \"output\": arrow})\n   351\t\n   352\t    placements = _place_objects(rows, cols, objects)\n   353\t    if placements is None:\n   354\t        return None\n   355\t\n   356\t    inp = np.full((rows, cols), bg, dtype=int)\n   357\t    out = np.full((rows, cols), bg, dtype=int)\n   358\t    for obj, (r, c) in zip(objects, placements):\n   359\t        _paint_patch(inp, obj[\"input\"], r, c, bg)\n   360\t        _paint_patch(out, obj[\"output\"], r, c, bg)\n   361\t\n   362\t    if _get_bg(inp) != bg:\n   363\t        return None\n   364\t    try:\n   365\t        solved = main(inp)\n   366\t    except Exception:\n   367\t        return None\n   368\t    if np.array_equal(inp, out):\n   369\t        return None\n   370\t    if not np.array_equal(solved, out):\n   371\t        return None\n   372\t    return inp\n   373\t\n   374\t\n   375\tdef generate_input() -> np.ndarray:\n   376\t    for _ in range(GEN_RETRIES):\n   377\t        grid = _gen_attempt()\n   378\t        if grid is not None:\n   379\t            return grid\n   380\t    raise RuntimeError(\"failed to generate a valid input grid\")\n","exit_code":0,"status":"completed"}}
