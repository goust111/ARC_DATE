      \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:1:import numpy as np\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:3:from arc_utils import get_bg\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:4:import random\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:5:from collections import Counter\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:13:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:39:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:48:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:55:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:58:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:70:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:71:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:87:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:202:    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:215:    \"\"\"True if (h, w) avoids an L-anchor score tie.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:218:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:229:    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:256:    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:259:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:276:    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:309:    \"\"\"Build the forbidden-placement mask that protects legend scan integrity.\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:313:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/9385bd28.py:401:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
