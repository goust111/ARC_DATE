{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, neighbors4, random_sprite\nfrom scipy.ndimage import label as _scipy_label\nimport random\n\n\ndef _find_border6_square_start(legend: np.ndarray) -> tuple[int, int] | None:\n    h, w = legend.shape\n    if h < 5 or w < 5:\n        return None\n    for r0 in range(h - 4):\n        for c0 in range(w - 4):\n            sub = legend[r0 : r0 + 5, c0 : c0 + 5]\n            if np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6):\n                return int(r0), int(c0)\n    return None\n\n\ndef _find_marker_panel_square(g: np.ndarray, sep_c1: int) -> tuple[int, int] | None:\n    \"\"\"\n    Find the 5x5 border-6 position-marker square that belongs to the 8x5 marker panel.\n\n    In some instances the marker panel can appear inside the main canvas as well as in the\n    left legend region. Prefer a candidate that lies in the main canvas (col > sep_c1) if any.\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            # Must contain a position marker inside (non-{0,6}) and a rotation mark below.\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    main_cands = [rc for rc in candidates if rc[1] > sep_c1]\n    return min(main_cands) if main_cands else min(candidates)\n\n\ndef _separator_runs(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return contiguous runs of full-height columns that are all color 6.\"\"\"\n    h, w = g.shape\n    cols6 = [c for c in range(w) if np.all(g[:, c] == 6)]\n    if not cols6:\n        return []\n    cols6.sort()\n    runs: list[tuple[int, int]] = []\n    s = e = cols6[0]\n    for c in cols6[1:]:\n        if c == e + 1:\n            e = c\n        else:\n            runs.append((s, e))\n            s = e = c\n    runs.append((s, e))\n    return runs\n\n\ndef _split_canvas(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int] | None]:\n    \"\"\"\n    Identify a left separator run (between left legend and canvas), and optionally a\n    right separator run (between canvas and a right-side legend panel).\n    \"\"\"\n    h, w = g.shape\n    runs = _separator_runs(g)\n    assert runs, \"must have at least one color-6 separator run\"\n    left = runs[0]\n    # Prefer a right separator run very near the right edge (a right legend panel).\n    right: tuple[int, int] | None = None\n    for s, e in reversed(runs[1:]):\n        if s >= w - 10 and s > left[1] + 1:\n            right = (s, e)\n            break\n    return left, right\n\n\ndef _find_marker_square_with_preferences(\n    g: np.ndarray, left_sep: tuple[int, int], right_sep: tuple[int, int] | None\n) -> tuple[int, int] | None:\n    \"\"\"\n    Find the marker panel's 5x5 border-6 square.\n\n    Preference order:\n      1) left legend region (at/before left separator)\n      2) right legend region (at/after right separator), if present\n      3) anywhere (including inside the output canvas)\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    left_end = left_sep[1]\n    left_cands = [rc for rc in candidates if rc[1] + 2 <= left_end]\n    if left_cands:\n        return min(left_cands)\n    if right_sep is not None:\n        right_start = right_sep[0]\n        right_cands = [rc for rc in candidates if rc[1] + 2 >= right_start]\n        if right_cands:\n            return min(right_cands)\n    return min(candidates)\n\n\ndef _all_marker_panel_squares(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"List all 5x5 border-6 squares that look like the top of an 8x5 marker panel.\"\"\"\n    h, w = g.shape\n    out: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            out.append((int(r0), int(c0)))\n    out.sort()\n    return out\n\n\ndef _extract_unit_sprite(legend: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    # Unit sprite is the top-most 4-connected component of pixels not in {0,6}.\n    mask = (legend != 0) & (legend != 6)\n    pts_all = np.argwhere(mask)\n    if pts_all.size == 0:\n        return None\n    rmin = int(pts_all[:, 0].min())\n    # choose left-most on that row to seed\n    cseed = int(np.argwhere(mask[rmin, :])[0, 0])\n    # BFS from seed to get component\n    h, w = legend.shape\n    vis = np.zeros((h, w), dtype=bool)\n    st = [(rmin, cseed)]\n    vis[rmin, cseed] = True\n    pts: list[tuple[int, int]] = []\n    while st:\n        r, c = st.pop()\n        pts.append((r, c))\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not vis[rr, cc]:\n                vis[rr, cc] = True\n                st.append((rr, cc))\n    r0, c0, r1, c1 = bbox_coords(np.asarray(pts))\n    spr = legend[r0 : r1 + 1, c0 : c1 + 1].copy()\n    # Unit sprite uses two colors; the rendered sprite is the color-swapped version.\n    cols = sorted({int(x) for x in np.unique(spr) if int(x) not in (0, 6)})\n    if len(cols) == 2:\n        a, b = cols\n        spr2 = spr.copy()\n        spr2[spr == a] = -1\n        spr2[spr == b] = a\n        spr2[spr2 == -1] = b\n        spr = spr2\n    return spr, (r0, c0, r1, c1)\n\n\ndef _extract_frame_bbox(legend: np.ndarray, unit_bb: tuple[int, int, int, int], border6_r0: int) -> tuple[int, int, int, int] | None:\n    # Frame pixels live between the unit sprite and the border6 square.\n    r_start = unit_bb[2] + 1\n    r_end = border6_r0 - 1\n    if r_start > r_end:\n        return None\n    sub = legend[r_start : r_end + 1, :]\n    mask = (sub != 0) & (sub != 6)\n    pts = np.argwhere(mask)\n    if pts.size == 0:\n        return None\n    pts[:, 0] += r_start\n    r0 = int(pts[:, 0].min())\n    r1 = int(pts[:, 0].max())\n    c0 = int(pts[:, 1].min())\n    c1 = int(pts[:, 1].max())\n    return (r0, c0, r1, c1)\n\n\ndef _position_indices_from_border_square(legend: np.ndarray, border6_r0: int, border6_c0: int) -> tuple[int, int] | None:\n    sq = legend[border6_r0 : border6_r0 + 5, border6_c0 : border6_c0 + 5]\n    inner = sq[1:4, 1:4]\n    pts = np.argwhere((inner != 0) & (inner != 6))\n    if pts.size == 0:\n        return None\n    # If multiple, take the first (should be unique)\n    r, c = int(pts[0, 0]), int(pts[0, 1])\n    return r, c  # 0..2\n\n\ndef _rotation_from_clockhand(legend: np.ndarray, border6_r0: int, border6_c0: int) -> int:\n    \"\"\"\n    Rotation marker is in the bottom 3x3 at rows (border6_r0+5 .. border6_r0+7) and cols (1..3),\n    drawn with non-{0,6} pixels (typically 7). Use the furthest pixel from the center (1,1)\n    to determine direction:\n      up -> 0, right -> 1, down -> 2, left -> 3.\n    \"\"\"\n    h, w = legend.shape\n    r0 = border6_r0 + 5\n    c0 = border6_c0 + 1\n    assert r0 + 2 < h and c0 + 2 < w, \"rotation marker patch out of bounds\"\n    sub = legend[r0 : r0 + 3, c0 : c0 + 3]\n    pts = np.argwhere((sub != 0) & (sub != 6))\n    assert pts.size > 0, \"no rotation marker pixel found\"\n    center = np.array([1, 1], dtype=int)\n    # pick furthest (Manhattan) from center\n    dists = np.abs(pts - center).sum(axis=1)\n    p = pts[int(dists.argmax())]\n    dr, dc = int(p[0] - center[0]), int(p[1] - center[1])\n    if abs(dr) >= abs(dc):\n        if dr < 0:\n            return 0\n        if dr > 0:\n            return 2\n    else:\n        if dc > 0:\n            return 1\n        if dc < 0:\n            return 3\n    raise AssertionError(\"rotation marker pixel at center, direction ambiguous\")\n\n\ndef _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:\n    \"\"\"\n    anchor_idx in {0,1,2} selects position on a length:\n      0 -> start, 1 -> middle, 2 -> end\n    Returns the top-left coordinate so that the corresponding point of the placed object\n    aligns with that point on the canvas.\n    \"\"\"\n    if anchor_idx <= 0:\n        canvas_anchor = 0\n        obj_anchor = 0\n    elif anchor_idx >= 2:\n        canvas_anchor = max(0, size - 1)\n        obj_anchor = max(0, place_size - 1)\n    else:\n        canvas_anchor = (size - 1) // 2 if size > 1 else 0\n        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0\n    return canvas_anchor - obj_anchor\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n","exit_code":0,"status":"completed"}}
