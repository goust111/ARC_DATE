{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\nCoordSet = set[tuple[int, int]]\n\n\ndef _active_row_spans(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    active = np.any(g != bg, axis=1)\n    spans: list[tuple[int, int]] = []\n    r = 0\n    h = g.shape[0]\n    while r < h:\n        if not active[r]:\n            r += 1\n            continue\n        r0 = r\n        while r < h and active[r]:\n            r += 1\n        spans.append((r0, r - 1))\n    return spans\n\n\ndef _coords(mask: np.ndarray) -> CoordSet:\n    return {(int(r), int(c)) for r, c in np.argwhere(mask)}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each right-side colored shape into the left slot whose template color is its exact complement.\n\n    Input structure:\n    - The grid has two equal-width slots separated by one background column.\n    - Non-background rows form horizontal bands separated by all-background rows.\n    - Each band has a shared template color in the left slot and one colored source shape in the right slot.\n\n    Rule:\n    - For each band, define its destination shape as the cells in the left slot not occupied by the template color.\n    - Normalize every right-side source shape to right-slot coordinates and match it to the unique equal destination shape.\n    - Clear the original right-side source pixels and paint the matched left-slot complement with the source color.\n\n    Key insight:\n    The right-side objects are not placed by row order; each one completes the unique left template whose missing cells have the same shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    assert w % 2 == 1, \"canvas must contain two equal slots plus one separator column\"\n    slot_w = w // 2\n    sep_c = slot_w\n\n    bands = _active_row_spans(g, bg)\n    assert bands, \"grid must contain at least one active band\"\n\n    band_color_sets: list[set[int]] = []\n    for r0, r1 in bands:\n        colors = set(map(int, g[r0 : r1 + 1].ravel())) - {bg}\n        assert colors, \"each active band must contain foreground colors\"\n        band_color_sets.append(colors)\n\n    shared_colors = set.intersection(*band_color_sets)\n    assert len(shared_colors) == 1, \"template color must be the only color shared by all bands\"\n    template_color = next(iter(shared_colors))\n\n    dest_shapes: list[CoordSet] = []\n    sources: list[tuple[int, CoordSet]] = []\n    for band_i, (r0, r1) in enumerate(bands):\n        block = g[r0 : r1 + 1]\n        assert np.all(block[:, sep_c] == bg), \"slot separator column must be background\"\n\n        left = block[:, :slot_w]\n        right = block[:, sep_c + 1 :]\n        assert np.all((left == bg) | (left == template_color)), \"left slot must contain only template and background\"\n\n        template_mask = left == template_color\n        for row in template_mask:\n            cols = np.flatnonzero(row)\n            assert cols.size > 0, \"each template row must contain at least one pixel\"\n            expected = np.arange(int(cols[-1]) + 1)\n            assert np.array_equal(cols, expected), \"template pixels must be a left-anchored row prefix\"\n\n        dest_shapes.append(_coords(~template_mask))\n\n        source_mask = right != bg\n        assert np.any(source_mask), f\"band {band_i} source shape must be non-empty\"\n        source_colors = set(map(int, right[source_mask].ravel()))\n        assert len(source_colors) == 1, \"each right slot must contain exactly one source color\"\n        source_color = next(iter(source_colors))\n        assert source_color != template_color, \"source color must differ from template color\"\n        source_shape = _coords(source_mask)\n        sources.append((source_color, source_shape))\n\n    out = g.copy()\n    for r0, r1 in bands:\n        right = out[r0 : r1 + 1, sep_c + 1 :]\n        right[right != bg] = bg\n\n    used_destinations: set[int] = set()\n    for source_color, source_shape in sources:\n        matches = [i for i, dest_shape in enumerate(dest_shapes) if dest_shape == source_shape]\n        assert len(matches) == 1, \"each source shape must match exactly one left-slot complement\"\n        dest_i = matches[0]\n        assert dest_i not in used_destinations, \"each destination complement must be filled once\"\n        used_destinations.add(dest_i)\n\n        dest_r0, _ = bands[dest_i]\n        for dr, dc in source_shape:\n            rr = dest_r0 + dr\n            assert out[rr, dc] == bg, \"matched complement cells must be empty before painting\"\n            out[rr, dc] = source_color\n\n    assert len(used_destinations) == len(bands), \"all destination complements must be filled\"\n    assert out.shape == (h, w)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG = 7\nTEMPLATE = 8\n\n# Canvas and band geometry.\nSLOT_W = 5\nBAND_H = 3\nBAND_GAP = 1\nOUTER_MARGIN_ROWS = 1\nSEPARATOR_W = 1\nWIDTH = SLOT_W * 2 + SEPARATOR_W\nRIGHT_SLOT_C0 = SLOT_W + SEPARATOR_W\n\n# Sampling ranges and palette.\nMIN_BANDS, MAX_BANDS = 2, 4\nMIN_SUFFIX_LEN, MAX_SUFFIX_LEN = 1, SLOT_W - 1\nSUFFIX_LENGTHS = range(MIN_SUFFIX_LEN, MAX_SUFFIX_LEN + 1)\nSOURCE_COLORS = [1, 2, 3, 4, 5, 6, 9]\nCOMPLEMENTS = [(a, b, c) for a in SUFFIX_LENGTHS for b in SUFFIX_LENGTHS for c in SUFFIX_LENGTHS]\nMAX_ATTEMPTS = 300\n\n\ndef _band_top(i: int) -> int:\n    return OUTER_MARGIN_ROWS + i * (BAND_H + BAND_GAP)\n\n\ndef _sample_layout() -> tuple[int, list[tuple[int, int, int]], list[int], list[int]]:\n    \"\"\"Sample distinct band complements, source colors, and source-to-destination mapping.\"\"\"\n    num_bands = random.randint(MIN_BANDS, MAX_BANDS)\n    comps = random.sample(COMPLEMENTS, num_bands)\n    source_colors = random.sample(SOURCE_COLORS, num_bands)\n    perm = list(range(num_bands))\n    random.shuffle(perm)\n    return num_bands, comps, source_colors, perm\n\n\ndef _paint_template(grid: np.ndarray, r0: int, comp: tuple[int, int, int]) -> None:\n    for dr, suffix_len in enumerate(comp):\n        grid[r0 + dr, : SLOT_W - suffix_len] = TEMPLATE\n\n\ndef _paint_suffix(grid: np.ndarray, r0: int, c0: int, comp: tuple[int, int, int], color: int) -> None:\n    for dr, suffix_len in enumerate(comp):\n        grid[r0 + dr, c0 + SLOT_W - suffix_len : c0 + SLOT_W] = color\n\n\ndef _build_output(rows: int, comps: list[tuple[int, int, int]], source_colors: list[int], perm: list[int]) -> np.ndarray:\n    \"\"\"Render the solved grid: templates plus matched left complements.\"\"\"\n    out = np.full((rows, WIDTH), BG, dtype=int)\n    for dest_i, comp in enumerate(comps):\n        _paint_template(out, _band_top(dest_i), comp)\n    for src_i, dest_i in enumerate(perm):\n        _paint_suffix(out, _band_top(dest_i), 0, comps[dest_i], source_colors[src_i])\n    return out\n\n\ndef _build_input(out: np.ndarray, comps: list[tuple[int, int, int]], source_colors: list[int], perm: list[int]) -> np.ndarray:\n    \"\"\"Invert the solver transform by clearing left complements and placing right sources.\"\"\"\n    inp = out.copy()\n    for dest_i, comp in enumerate(comps):\n        _paint_suffix(inp, _band_top(dest_i), 0, comp, BG)\n    for src_i, dest_i in enumerate(perm):\n        _paint_suffix(inp, _band_top(src_i), RIGHT_SLOT_C0, comps[dest_i], source_colors[src_i])\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    num_bands, comps, source_colors, perm = _sample_layout()\n    rows = 2 * OUTER_MARGIN_ROWS + num_bands * BAND_H + (num_bands - 1) * BAND_GAP\n    out = _build_output(rows, comps, source_colors, perm)\n    inp = _build_input(out, comps, source_colors, perm)\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'rg -n \"''^def main|''^def generate_input|''^'\"\\\\s*\\\\\\\"\\\\\\\"\\\\\\\"|\"'^from|''^import\" /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py /home/lixinyu/snap/new/ARC_code/eval/581f7754.py /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py /home/lixinyu/snap/new/ARC_code/train/18447a8d.py /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n","exit_code":0,"status":"completed"}}
