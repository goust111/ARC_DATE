{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location\nimport random\n\n\ndef _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:\n    b = bbox(mask)\n    if b is None:\n        return None\n    r0, c0, r1, c1 = b\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    if h < 3 or w < 3:\n        return None\n\n    expected = np.zeros_like(mask, dtype=bool)\n    expected[r0 : r1 + 1, c0] = True\n    expected[r0 : r1 + 1, c1] = True\n    expected[r0, c0 : c1 + 1] = True\n    expected[r1, c0 : c1 + 1] = True\n    if not np.array_equal(mask, expected):\n        return None\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef _scaled_index(i: int, src_len: int, dst_len: int) -> int:\n    assert src_len >= 1 and dst_len >= 1, \"axis lengths must be positive\"\n    if src_len == 1:\n        assert dst_len == 1, \"a one-pixel motif axis maps to a one-pixel interior axis\"\n        return 0\n    assert dst_len >= 2, \"multi-pixel motif axis needs a multi-pixel interior axis\"\n    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))\n\n\ndef _fill_enclosed(stroke: np.ndarray) -> np.ndarray:\n    h, w = stroke.shape\n    open_space = ~stroke.astype(bool)\n    padded = np.pad(open_space, 1, constant_values=True)\n    seen = np.zeros_like(padded, dtype=bool)\n    q: deque[tuple[int, int]] = deque()\n    ph, pw = padded.shape\n\n    for r in range(ph):\n        for c in (0, pw - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n    for c in range(pw):\n        for r in (0, ph - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((int(nr), int(nc)))\n\n    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]\n    return stroke.astype(bool) | holes\n\n\ndef _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = sprite.shape\n    dst_h, dst_w = target_shape\n    assert sprite.any(), \"expected a nonempty sprite\"\n\n    stroke = np.zeros((dst_h, dst_w), dtype=int)\n    coords = np.argwhere(sprite)\n    mapped: dict[tuple[int, int], tuple[int, int]] = {}\n    for sr, sc in coords:\n        tr = _scaled_index(int(sr), src_h, dst_h)\n        tc = _scaled_index(int(sc), src_w, dst_w)\n        mapped[(int(sr), int(sc))] = (tr, tc)\n        stroke[tr, tc] = 1\n\n    for sr, sc in coords:\n        sr = int(sr)\n        sc = int(sc)\n        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):\n            if (nr, nc) in mapped:\n                r0, c0 = mapped[(sr, sc)]\n                r1, c1 = mapped[(nr, nc)]\n                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)\n\n    return _fill_enclosed(stroke.astype(bool))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, paste, random_free_location\nimport random\n\n\ndef _split_panels(g: np.ndarray) -> tuple[list[np.ndarray], set[int]]:\n    h, w = g.shape\n    candidates: list[tuple[list[np.ndarray], set[int]]] = []\n\n    for horizontal in (False, True):\n        dim = w if horizontal else h\n        for n in range(3, dim + 1):\n            if dim % n:\n                continue\n            ph, pw = (h, w // n) if horizontal else (h // n, w)\n            if ph < 2 or pw < 2:\n                continue\n            if horizontal:\n                panels = [g[:, i * pw : (i + 1) * pw] for i in range(n)]\n            else:\n                panels = [g[i * ph : (i + 1) * ph, :] for i in range(n)]\n\n            template = panels[-1]\n            template_colors = set(map(int, template.ravel()))\n            diff_colors: set[int] = set()\n            diff_counts = []\n            for panel in panels[:-1]:\n                diff = panel != template\n                diff_counts.append(int(diff.sum()))\n                diff_colors.update(map(int, panel[diff].ravel()))\n\n            if not diff_colors or not all(diff_counts):\n                continue\n            if diff_colors & template_colors:\n                continue\n            occurrences = {\n                color: sum(bool(np.any(panel == color)) for panel in panels[:-1])\n                for color in diff_colors\n            }\n            if not all(count >= 2 for count in occurrences.values()):\n                continue\n            candidates.append((panels, diff_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _intervals(line: np.ndarray) -> list[tuple[int, int]]:\n    out: list[tuple[int, int]] = []\n    i = 0\n    while i < len(line):\n        if not line[i]:\n            i += 1\n            continue\n        j = i\n        while j + 1 < len(line) and line[j + 1]:\n            j += 1\n        out.append((i, j))\n        i = j + 1\n    return out\n\n\ndef _shift_intervals(\n    intervals: list[tuple[int, int]], step: int, length: int\n) -> list[tuple[int, int]]:\n    shifted = []\n    for start, end in intervals:\n        new_start = start + step\n        new_end = end + step\n        assert 0 <= new_start <= new_end < length\n        shifted.append((new_start, new_end))\n    return shifted\n\n\ndef _is_prefix(shorter: list[tuple[int, int]], longer: list[tuple[int, int]]) -> bool:\n    return len(shorter) <= len(longer) and all(a == b for a, b in zip(shorter, longer))\n\n\ndef _required_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _motion_axis(a: np.ndarray, b: np.ndarray) -> tuple[int, int]:\n    ar0, ac0, ar1, ac1 = _required_bbox(a)\n    br0, bc0, br1, bc1 = _required_bbox(b)\n    row_motion = abs(br0 - ar0) + abs(br1 - ar1)\n    col_motion = abs(bc0 - ac0) + abs(bc1 - ac1)\n    assert row_motion != col_motion\n\n    if row_motion > col_motion:\n        deltas = [br0 - ar0, br1 - ar1]\n        axis = 0\n    else:\n        deltas = [bc0 - ac0, bc1 - ac1]\n        axis = 1\n    nonzero = [delta for delta in deltas if delta]\n    assert nonzero and all((delta > 0) == (nonzero[0] > 0) for delta in nonzero)\n    direction = 1 if nonzero[0] > 0 else -1\n    return axis, direction\n\n\ndef _draw_intervals(mask: np.ndarray, axis: int, line: int, intervals: list[tuple[int, int]]) -> None:\n    for start, end in intervals:\n        if axis == 0:\n            mask[start : end + 1, line] = True\n        else:\n            mask[line, start : end + 1] = True\n\n\ndef _extrapolate_mask(a: np.ndarray, b: np.ndarray) -> np.ndarray:\n    assert a.any() and b.any()\n    assert not np.array_equal(a, b)\n\n    axis, direction = _motion_axis(a, b)\n    added = b & ~a\n    assert added.any()\n    added_coords = np.argwhere(added)\n    extent = int(added_coords[:, axis].max() - added_coords[:, axis].min() + 1)\n    global_step = direction * extent\n\n    out = np.zeros_like(b, dtype=bool)\n    line_count = b.shape[1 - axis]\n    length = b.shape[axis]\n    for line in range(line_count):\n        if axis == 0:\n            a_intervals = _intervals(a[:, line])\n            b_intervals = _intervals(b[:, line])\n        else:\n            a_intervals = _intervals(a[line, :])\n            b_intervals = _intervals(b[line, :])\n\n        if not a_intervals and not b_intervals:\n            next_intervals: list[tuple[int, int]] = []\n        elif a_intervals and len(a_intervals) == len(b_intervals):\n            next_intervals = []\n            for (a0, a1), (b0, b1) in zip(a_intervals, b_intervals):\n                new_start = b0 + (b0 - a0)\n                new_end = b1 + (b1 - a1)\n                assert 0 <= new_start <= new_end < length\n                next_intervals.append((new_start, new_end))\n        elif a_intervals and _is_prefix(a_intervals, b_intervals):\n            extra_count = len(b_intervals) - len(a_intervals)\n            assert 0 < extra_count <= len(a_intervals)\n            previous = a_intervals[-extra_count:]\n            extra = b_intervals[-extra_count:]\n            steps = {\n                end_new - end_old\n                for old, new in zip(previous, extra)\n                for end_old, end_new in zip(old, new)\n            }\n            assert len(steps) == 1\n            step = steps.pop()\n            assert step\n            next_intervals = list(b_intervals) + _shift_intervals(extra, step, length)\n        elif not a_intervals and b_intervals:\n            next_intervals = list(b_intervals) + _shift_intervals(\n                b_intervals, global_step, length\n            )\n        else:\n            raise AssertionError\n\n        _draw_intervals(out, axis, line, next_intervals)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\n","exit_code":0,"status":"completed"}}
