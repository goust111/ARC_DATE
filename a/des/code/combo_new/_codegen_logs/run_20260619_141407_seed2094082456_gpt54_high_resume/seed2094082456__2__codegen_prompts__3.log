357:     return {(r, c), (r + stem[0], c + stem[1]),\n 358:             (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n 359: \n 360: \n 361: def _t_branch_cells(center, stem):\n 362:     \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n 363:     r, c = center\n 364:     bar = _get_bar(stem)\n 365:     return {(r + stem[0], c + stem[1]),\n 366:             (r + bar[0][0], c + bar[0][1]),\n 367:             (r + bar[1][0], c + bar[1][1])}\n 368: \n 369: \n 370: def _t_neighborhood(center, stem):\n 371:     \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n 372:     cells = _t_cells(center, stem)\n 373:     neighborhood = set()\n 374:     for r, c in cells:\n 375:         for dr, dc in _DIRS:\n 376:             nb = (r + dr, c + dc)\n 377:             if nb not in cells:\n 378:                 neighborhood.add(nb)\n 379:     return neighborhood\n 380: \n==================== /home/lixinyu/snap/new/ARC_code/eval/21897d95.py GEN\n 700: def generate_input() -> np.ndarray:\n 701:     for _ in range(GEN_RETRIES):\n 702:         result = _gen_attempt()\n 703:         if result is not None:\n 704:             return result\n 705:     raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
