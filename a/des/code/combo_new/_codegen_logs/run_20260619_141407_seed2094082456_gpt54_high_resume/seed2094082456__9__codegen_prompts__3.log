{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef neighbors4(r, c):\n    for dr, dc in DIRS:\n        yield r + dr, c + dc\n\n\nclass DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(n))\n\n    def find(self, x: int) -> int:\n        while self.parent[x] \"'!= x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return x\n\n    def union(self, a: int, b: int) -> bool:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra == rb:\n            return False\n        self.parent[rb] = ra\n        return True\n\n\ndef infer(g):\n    counts = Counter(map(int, g.flat))\n    border = list(map(int, g[0, :])) + list(map(int, g[-1, :]))\n    if g.shape[0] > 2:\n        border += list(map(int, g[1:-1, 0])) + list(map(int, g[1:-1, -1]))\n    border_counts = Counter(border)\n    wall, border_freq = max(border_counts.items(), key=lambda item: item[1])\n    total_border = len(border)\n    if border_freq == total_border:\n        others = [c for c in counts if c != wall]\n        bg = max(others, key=lambda c: counts[c])\n        return bg, wall\n    bg = max(counts, key=lambda c: counts[c])\n    wall = max((c for c in counts if c != bg), key=lambda c: counts[c])\n    return bg, wall\n\n\ndef components(mask):\n    h, w = mask.shape\n    seen = np.zeros((h, w), dtype=bool)\n    out = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q = deque([(r, c)])\n            seen[r, c] = True\n            coords = []\n            touches = False\n            while q:\n                rr, cc = q.popleft()\n                coords.append((rr, cc))\n                if rr in {0, h - 1} or cc in {0, w - 1}:\n                    touches = True\n                for nr, nc in neighbors4(rr, cc):\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            out.append((coords, touches))\n    return out\n\n\ndef main(grid):\n    g = np.asarray(grid, dtype=int)\n    bg, wall = infer(g)\n    out = g.copy()\n    out[(g != bg) & (g != wall)] = bg\n    wall_regions = defaultdict(set)\n    region_colors = {}\n    rid = 0\n    for coords, touches in components(g != wall):\n        if touches:\n            continue\n        colors = {int(g[r, c]) for r, c in coords}\n        marker_colors = colors - {bg}\n        assert len(marker_colors) <= 1\n        if not marker_colors:\n            continue\n        marker_color = next(iter(marker_colors))\n        region_colors[rid] = marker_color\n        for r, c in coords:\n            if int(g[r, c]) != bg:\n                continue\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and int(g[nr, nc]) == wall:\n                    wall_regions[(nr, nc)].add(rid)\n        rid += 1\n    for coord, ids in wall_regions.items():\n        if len(ids) == 1:\n            out[coord] = region_colors[next(iter(ids))]\n    return out\n\n\ndef cell_offsets(sizes):\n    offs = []\n    cursor = 1\n    for size in sizes:\n        offs.append(cursor)\n        cursor += size + 1\n    return offs\n\n\ndef partition():\n    R = random.randint(3,4)\n    C = random.randint(3,4)\n    hs=[random.randint(4,6) for _ in range(R)]\n    ws=[random.randint(4,6) for _ in range(C)]\n    n=R*C\n    target=random.randint(3,min(7,n-1))\n    d=DSU(n)\n    edges=[]\n    for r in range(R):\n        for c in range(C):\n            i=r*C+c\n            if r+1<R: edges.append((i,(r+1)*C+c))\n            if c+1<C: edges.append((i,r*C+c+1))\n    random.shuffle(edges)\n    comps=n\n    for a,b in edges:\n        if comps<=target: break\n        if d.union(a,b): comps-=1\n    roots=sorted({d.find(i) for i in range(n)})\n    remap={root:i for i,root in enumerate(roots)}\n    labels=np.array([[remap[d.find(r*C+c)] for c in range(C)] for r in range(R)], dtype=int)\n    H=sum(hs)+R+1\n    W=sum(ws)+C+1\n    region=np.full((H,W),-1,dtype=int)\n    top=cell_offsets(hs)\n    left=cell_offsets(ws)\n    for r in range(R):\n        for c in range(C):\n            region[top[r]:top[r]+hs[r], left[c]:left[c]+ws[c]] = labels[r,c]\n    for r in range(R):\n        for c in range(C-1):\n            if labels[r,c] == labels[r,c+1]:\n                wc = left[c] + ws[c]\n                region[top[r]:top[r]+hs[r], wc] = labels[r,c]\n    for r in range(R-1):\n        for c in range(C):\n            if labels[r,c] == labels[r+1,c]:\n                wr = top[r] + hs[r]\n                region[wr, left[c]:left[c]+ws[c]] = labels[r,c]\n    for r in range(R-1):\n        for c in range(C-1):\n            block = {int(labels[r,c]), int(labels[r,c+1]), int(labels[r+1,c]), int(labels[r+1,c+1])}\n            if len(block) == 1:\n                region[top[r]+hs[r], left[c]+ws[c]] = next(iter(block))\n    adj=defaultdict(set)\n    frame=set()\n    for r in range(R):\n        for c in range(C):\n            rid=int(labels[r,c])\n            if r in {0,R-1} or c in {0,C-1}: frame.add(rid)\n            if r+1<R and labels[r,c] != labels[r+1,c]:\n                a,b=int(labels[r,c]),int(labels[r+1,c]); adj[a].add(b); adj[b].add(a)\n            if c+1<C and labels[r,c] != labels[r,c+1]:\n                a,b=int(labels[r,c]),int(labels[r,c+1]); adj[a].add(b); adj[b].add(a)\n    return region, labels, adj, frame\n\n\ndef marker_candidates(region):\n    cand=defaultdict(list)\n    h,w=region.shape\n    for r in range(1,h-1):\n        for c in range(1,w-1):\n            rid=int(region[r,c])\n            if rid < 0:\n                continue\n            if all(int(region[r+dr, c+dc]) == rid for dr,dc in DIRS):\n                cand[rid].append((r,c))\n    return cand\n\n\ndef expected(grid, region, region_markers, bg, wall):\n    out = grid.copy()\n    out[(grid != bg) & (grid != wall)] = bg\n    wall_regions = defaultdict(set)\n    for r in range(grid.shape[0]):\n        for c in range(grid.shape[1]):\n            rid = int(region[r, c])\n            if rid < 0 or rid not in region_markers or int(grid[r, c]) != bg:\n                continue\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and int(region[nr, nc]) < 0:\n                    wall_regions[(nr, nc)].add(rid)\n    for coord, ids in wall_regions.items():\n        if len(ids) == 1:\n            out[coord] = region_markers[next(iter(ids))]\n    return out, wall_regions\n\n\ndef gen_once():\n    for _ in range(500):\n        region, labels, adj, frame = partition()\n        regions = sorted(set(map(int, labels.flat)))\n        if len(regions) < 3:\n            continue\n        cand = marker_candidates(region)\n        pair_options = [(a, b) for a in frame for b in adj[a] if cand[a] and cand[b]]\n        if not pair_options:\n            continue\n        a, b = random.choice(pair_options)\n        marked = [a, b]\n        extras = [rid for rid in regions if rid not in {a, b} and cand[rid]]\n        random.shuffle(extras)\n        extra_max = min(2, len(extras), len(regions) - 3)\n        extra_count = 0 if extra_max <= 0 else random.randint(0, extra_max)\n        marked.extend(extras[:extra_count])\n        marked_set = set(marked)\n        if len(marked_set) < 2 or len(marked_set) >= len(regions):\n            continue\n        palette = list(range(10))\n        bg, wall = random.sample(palette, 2)\n        marker_palette = [c for c in palette if c not in {bg, wall}]\n        random.shuffle(marker_palette)\n        region_markers = {rid: marker_palette[i] for i, rid in enumerate(marked)}\n        grid = np.full(region.shape, wall, dtype=int)\n        grid[region >= 0] = bg\n        used = set()\n        for rid in marked:\n            choices = [pos for pos in cand[rid] if pos not in used]\n            if not choices:\n                break\n            pos = random.choice(choices)\n            used.add(pos)\n            grid[pos] = region_markers[rid]\n        else:\n            exp, wall_regions = expected(grid, region, region_markers, bg, wall)\n            counts = Counter(map(int, grid.flat))\n            if counts[bg] <= counts[wall]:\n                continue\n            if sum(len(ids) == 1 for ids in wall_regions.values()) == 0:\n                continue\n            if sum(len(ids) >= 2 for ids in wall_regions.values()) == 0:\n                continue\n            if not np.array_equal(main(grid), exp):\n                continue\n            return grid, exp\n    raise RuntimeError\n\nfor i in range(20):\n    g,o=gen_once()\n    print(i, g.shape, infer(g), np.unique(g), np.sum(g!=o))\nprint('\"'ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
