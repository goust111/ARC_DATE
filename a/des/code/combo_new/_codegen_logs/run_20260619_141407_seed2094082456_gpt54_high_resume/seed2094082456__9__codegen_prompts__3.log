{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\n\nDIRS = [(-1,0),(1,0),(0,-1),(0,1)]\n\nclass DSU:\n    def __init__(self,n):\n        self.p=list(range(n))\n    def find(self,x):\n        while self.p[x]\"'!=x:\n            self.p[x]=self.p[self.p[x]]\n            x=self.p[x]\n        return x\n    def union(self,a,b):\n        ra,rb=self.find(a),self.find(b)\n        if ra!=rb:\n            self.p[rb]=ra\n            return True\n        return False\n\ndef make():\n    R=random.randint(3,4)\n    C=random.randint(3,4)\n    hs=[random.randint(4,6) for _ in range(R)]\n    ws=[random.randint(4,6) for _ in range(C)]\n    H=sum(hs)+R+1\n    W=sum(ws)+C+1\n    n=R*C\n    target=random.randint(3,min(7,n-1))\n    d=DSU(n)\n    edges=[]\n    for r in range(R):\n        for c in range(C):\n            i=r*C+c\n            if r+1<R: edges.append((i,(r+1)*C+c))\n            if c+1<C: edges.append((i,r*C+c+1))\n    random.shuffle(edges)\n    comps=n\n    for a,b in edges:\n        if comps<=target: break\n        if d.union(a,b): comps-=1\n    roots={d.find(i):k for k,i in enumerate(sorted({d.find(i) for i in range(n)}))}\n    lab=np.array([[roots[d.find(r*C+c)] for c in range(C)] for r in range(R)])\n    top=[1]\n    for h in hs[:-1]: top.append(top[-1]+h+1)\n    left=[1]\n    for w in ws[:-1]: left.append(left[-1]+w+1)\n    region=np.full((H,W),-1,int)\n    for r in range(R):\n        for c in range(C):\n            region[top[r]:top[r]+hs[r], left[c]:left[c]+ws[c]] = lab[r,c]\n    for r in range(R):\n        for c in range(C-1):\n            if lab[r,c]==lab[r,c+1]:\n                wc=left[c]+ws[c]\n                region[top[r]:top[r]+hs[r], wc]=lab[r,c]\n    for r in range(R-1):\n        for c in range(C):\n            if lab[r,c]==lab[r+1,c]:\n                wr=top[r]+hs[r]\n                region[wr, left[c]:left[c]+ws[c]] = lab[r,c]\n    for r in range(R-1):\n        for c in range(C-1):\n            vals={lab[r,c],lab[r,c+1],lab[r+1,c],lab[r+1,c+1]}\n            if len(vals)==1:\n                region[top[r]+hs[r], left[c]+ws[c]] = vals.pop()\n    return region, lab\n\nregion,lab=make()\nprint(region.shape, lab)\nprint('\"'bg', np.sum(region>=0), 'wall', np.sum(region<0))\n# component count\nseen=np.zeros(region.shape,bool)\ncount=0\nfor r in range(region.shape[0]):\n  for c in range(region.shape[1]):\n    if region[r,c]<0 or seen[r,c]: continue\n    count+=1\n    q=deque([(r,c)]); seen[r,c]=1\n    vals={region[r,c]}\n    while q:\n      rr,cc=q.popleft()\n      for dr,dc in DIRS:\n        nr,nc=rr+dr,cc+dc\n        if 0<=nr<region.shape[0] and 0<=nc<region.shape[1] and region[nr,nc]>=0 and not seen[nr,nc]:\n          seen[nr,nc]=1; q.append((nr,nc)); vals.add(region[nr,nc])\n    print('comp',count,'labels',vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
