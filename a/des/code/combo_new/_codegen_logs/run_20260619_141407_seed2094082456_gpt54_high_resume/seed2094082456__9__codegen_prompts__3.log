{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\nimport random\n\n\ndef _orientation(\n    coords: np.ndarray,\n    contacts: list[tuple[int, int, int, int]],\n) -> str:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n\n    if h == 1 and w > 1:\n        return \"horizontal\"\n    if w == 1 and h > 1:\n        return \"vertical\"\n\n    implied: set[str] = set()\n    for tr, tc, sr, sc in contacts:\n        if tr == sr:\n            implied.add(\"horizontal\")\n        elif tc == sc:\n            implied.add(\"vertical\")\n        else:\n            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    return implied.pop()\n\n\ndef _fill_rows(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_rows: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % width == 0, \"gray count must make complete orange rows\"\n    stripe_count = int(count // width)\n    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n\n    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    if contact_rows == {r0}:\n        rows = list(range(r0, r0 + stripe_count))\n    else:\n        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n\n    out[rows, c0 : c1 + 1] = Color.GRAY\n\n\ndef _fill_cols(\n    out: np.ndarray,\n    r0: int,\n    c0: int,\n    r1: int,\n    c1: int,\n    count: int,\n    contact_cols: set[int],\n) -> None:\n    width = int(c1 - c0 + 1)\n    height = int(r1 - r0 + 1)\n    assert count % height == 0, \"gray count must make complete orange columns\"\n    stripe_count = int(count // height)\n    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n\n    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    if contact_cols == {c0}:\n        cols = list(range(c0, c0 + stripe_count))\n    else:\n        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n\n    out[r0 : r1 + 1, cols] = Color.GRAY\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/9f41bd9c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the side-attached foreground object to the opposite wall, shear its lower rows inward, and paint the crossed floor cells.\n\n    Input structure:\n    - The top row is the upper background color and the bottom row is the\n      floor color.\n    - A single non-background, non-floor object touches exactly one vertical\n      grid edge and rests immediately above the first solid floor row.\n\n    Rule:\n    - Clear the source object to the upper background color.\n    - Repaint each object row on the opposite side: the first three relative\n      rows keep the edge alignment, and each lower row shifts one more pixel\n      inward from that side.\n    - On the first floor row, repaint the traversed side-to-object segment\n      maroon, stopping just before the final outer bottom support pixel.\n\n    Key insight:\n    - The side of the source object gives the horizontal direction, while the\n      row index inside the object gives the one-cell-per-row diagonal shear.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be two-dimensional\"\n    height, width = g.shape\n\n    top_colors = np.unique(g[0])\n    bottom_colors = np.unique(g[-1])\n    assert len(top_colors) == 1, \"top row must be a uniform background\"\n    assert len(bottom_colors) == 1, \"bottom row must be a uniform floor\"\n    bg = int(top_colors[0])\n    floor = int(bottom_colors[0])\n    assert bg != floor, \"background and floor colors must differ\"\n\n    colors = set(map(int, np.unique(g)))\n    assert len(colors) == 3, \"expected exactly background, floor, and one object color\"\n    object_colors = colors - {bg, floor}\n    assert len(object_colors) == 1, \"expected one moving object color\"\n    obj = object_colors.pop()\n\n    full_floor_rows = np.where(np.all(g == floor, axis=1))[0]\n    assert len(full_floor_rows) > 0, \"expected a solid floor row\"\n    floor_row = int(full_floor_rows[0])\n    assert 0 < floor_row < height, \"floor row must be inside the grid\"\n    assert np.all(g[floor_row:] == floor), \"floor must be a solid bottom band\"\n\n    obj_coords = np.argwhere(g == obj)\n    assert len(obj_coords) > 0, \"expected a moving object\"\n    r0, c0, r1, c1 = bbox_coords(obj_coords)\n    object_width = c1 - c0 + 1\n    assert r1 == floor_row - 1, \"object must rest directly above the floor\"\n    assert (c0 == 0) ^ (c1 == width - 1), \"object must touch exactly one side edge\"\n    assert np.all(g[:floor_row][g[:floor_row] != obj] == bg), \"upper region must contain only bg and object\"\n\n    moving_right = c0 == 0\n    out = g.copy()\n    out[g == obj] = bg\n\n    for r in range(r0, r1 + 1):\n        rel_r = r - r0\n        rel_cols = np.where(g[r, c0 : c1 + 1] == obj)[0]\n        assert len(rel_cols) > 0, \"every object bbox row must contain object pixels\"\n\n        inward_shift = max(0, rel_r - 2)\n        if moving_right:\n            start_col = width - object_width - inward_shift\n        else:\n            start_col = inward_shift\n        dst_cols = start_col + rel_cols\n        assert int(dst_cols.min()) >= 0 and int(dst_cols.max()) < width, \"moved object must fit in the grid\"\n        out[r, dst_cols] = obj\n\n    bottom_rel_cols = np.where(g[r1, c0 : c1 + 1] == obj)[0]\n    bottom_shift = max(0, r1 - r0 - 2)\n    bottom_start = width - object_width - bottom_shift if moving_right else bottom_shift\n    final_bottom_cols = bottom_start + bottom_rel_cols\n    trail_color = Color.MAROON\n    assert int(trail_color) not in colors, \"trail color must be new\"\n    if moving_right:\n        trail_end = int(final_bottom_cols.max()) - 1\n        assert trail_end >= 0, \"trail must cover at least one floor pixel\"\n        out[floor_row, : trail_end + 1] = int(trail_color)\n    else:\n        trail_start = int(final_bottom_cols.min()) + 1\n        assert trail_start < width, \"trail must cover at least one floor pixel\"\n        out[floor_row, trail_start:] = int(trail_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and band bounds.\nGRID_ROWS = range(16, 19)\nGRID_COLS = (16, 18)\nFLOOR_THICKNESS = range(4, 7)\nEMPTY_ROWS = range(3, 7)\n# Object shape and fit constraints.\nOBJECT_WIDTH = 5\nOBJECT_HEIGHT = (5, 11)\nSOLID_TOP_ROWS = 2\nSHEAR_LOCK_ROWS = 3\nCHECKER_COLS = (0, 2, 4)\n# Colors and retry budget.\nTRAIL_COLOR = int(Color.MAROON)\nAVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]\nMAX_GENERATION_ATTEMPTS = 300\nSIDES = (\"left\", \"right\")\n\nROW_LAYOUTS = [\n    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)\n    for rows in GRID_ROWS\n    for floor_thick in FLOOR_THICKNESS\n    for empty_rows in EMPTY_ROWS\n    if OBJECT_HEIGHT[0] <= rows - floor_thick - empty_rows <= OBJECT_HEIGHT[1]\n]\n\n\ndef _gen_object_mask(height: int) -> np.ndarray:\n    mask = np.zeros((height, OBJECT_WIDTH), dtype=bool)\n    mask[:SOLID_TOP_ROWS, :] = True\n    mask[SOLID_TOP_ROWS:, CHECKER_COLS] = True\n    return mask\n\n\ndef _gen_place_original(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> None:\n    c0 = 0 if side == \"left\" else grid.shape[1] - mask.shape[1]\n    region = grid[top : top + mask.shape[0], c0 : c0 + mask.shape[1]]\n    region[mask] = color\n\n\ndef _gen_place_sheared(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> np.ndarray:\n    width = grid.shape[1]\n    bottom_cols = []\n    for rel_r in range(mask.shape[0]):\n        rel_cols = np.flatnonzero(mask[rel_r])\n        inward_shift = max(0, rel_r - SHEAR_LOCK_ROWS + 1)\n        c0 = width - mask.shape[1] - inward_shift if side == \"right\" else inward_shift\n        dst_cols = c0 + rel_cols\n        grid[top + rel_r, dst_cols] = color\n        bottom_cols = dst_cols\n    return bottom_cols\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    height, floor_thick, empty_rows, obj_h = random.choice(ROW_LAYOUTS)\n    width = random.randint(*GRID_COLS)\n    if OBJECT_WIDTH + max(0, obj_h - SHEAR_LOCK_ROWS) > width:\n        return None\n\n    bg, floor, obj = random.sample(AVAILABLE_COLORS, 3)\n    floor_row = height - floor_thick\n    obj_mask = _gen_object_mask(obj_h)\n    dst_side = random.choice(SIDES)\n    src_side = \"right\" if dst_side == \"left\" else \"left\"\n\n    out = np.full((height, width), bg, dtype=int)\n    out[floor_row:, :] = floor\n    bottom_cols = _gen_place_sheared(out, empty_rows, dst_side, obj, obj_mask)\n    if dst_side == \"right\":\n        out[floor_row, : int(bottom_cols.max())] = TRAIL_COLOR\n    else:\n        out[floor_row, int(bottom_cols.min()) + 1 :] = TRAIL_COLOR\n\n    inp = out.copy()\n    inp[inp == obj] = bg\n    inp[floor_row, inp[floor_row] == TRAIL_COLOR] = floor\n    _gen_place_original(inp, empty_rows, src_side, obj, obj_mask)\n\n    return inp if np.array_equal(main(inp), out) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, neighbors4\nimport random\n\n\ndef _unique_color_with_count(counts: Counter[int], colors: list[int], target_count: int) -> int:\n    matches = [color for color in colors if counts[color] == target_count]\n    assert len(matches) == 1, \"expected a unique structural color by area\"\n    return int(matches[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\n\ndef _gen_grow_parts(total, n):\n    n_twos = total - n\n    parts = [2] * n_twos + [1] * (n - n_twos)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_drop_parts(total, n):\n    if n == 0:\n        return []\n    n_twos = random.randint(max(0, total - n), min(total // 2, n))\n    n_ones = total - 2 * n_twos\n    parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n    random.shuffle(parts)\n    return parts\n\ndef _gen_widths(height, max_width):\n    start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n    diff = max_width - start\n    grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n    widths = [start]\n    for inc in _gen_grow_parts(diff, grow_steps):\n        widths.append(widths[-1] + inc)\n\n    remaining = height - len(widths)\n    min_end = max(1, max_width - 2 * remaining)\n    end_width = random.randint(min_end, max_width)\n    for dec in _gen_drop_parts(max_width - end_width, remaining):\n        widths.append(widths[-1] - dec)\n    return widths\n\ndef _gen_intervals(widths):\n    left, right = 0, widths[0] - 1\n    intervals = [(left, right)]\n    for prev_width, width in zip(widths, widths[1:]):\n        delta = width - prev_width\n        if delta == 2:\n            left -= 1\n            right += 1\n        elif delta == 1:\n            if random.choice([False, True]):\n                left -= 1\n            else:\n                right += 1\n        elif delta == 0:\n            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n            left += shift\n            right += shift\n        elif delta == -1:\n            if random.choice([False, True]):\n                left += 1\n            else:\n                right -= 1\n        elif delta == -2:\n            left += 1\n            right -= 1\n        intervals.append((left, right))\n\n    min_left = min(l for l, _ in intervals)\n    intervals = [(l - min_left, r - min_left) for l, r in intervals]\n    if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n        return None\n    return intervals\n\ndef _gen_local_mask(intervals):\n    height = len(intervals)\n    width = max(r for _, r in intervals) + 1\n    mask = np.zeros((height, width), dtype=bool)\n    for r, (c0, c1) in enumerate(intervals):\n        mask[r, c0 : c1 + 1] = True\n    return mask\n\ndef _gen_place_shape(grid_shape, local_mask, edge_pair):\n    rows, cols = grid_shape\n    height, width = local_mask.shape\n    if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n        if height != rows or width > cols - 2:\n            return None\n        return 0, random.randint(1, cols - width - 1)\n    if height >= rows or width >= cols:\n        return None\n    if edge_pair == \"TL\":\n        return 0, 0\n    if edge_pair == \"TR\":\n        return 0, cols - width\n    if edge_pair == \"BL\":\n        return rows - height, 0\n    return rows - height, cols - width\n\ndef _gen_full_mask(rows, cols, local_mask, r0, c0):\n    mask = np.zeros((rows, cols), dtype=bool)\n    height, width = local_mask.shape\n    mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n    return mask\n\ndef _gen_layers(mask):\n    remaining = mask.copy()\n    layers = []\n    rows, cols = mask.shape\n    while np.any(remaining):\n        layer = np.zeros_like(mask)\n        for r, c in np.argwhere(remaining):\n            for nr, nc in neighbors4(int(r), int(c)):\n                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n                    layer[r, c] = True\n                    break\n        layers.append(layer)\n        remaining[layer] = False\n    return layers\n\ndef _gen_contour(outline, shape):\n    rows, cols = shape.shape\n    contour = np.zeros_like(shape)\n    for r, c in np.argwhere(outline):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n                contour[nr, nc] = True\n    return contour\n\ndef _choose_canvas_and_shape_profile():\n    rows = random.randint(GRID_MIN, GRID_MAX)\n    cols = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(N_COLORS)\n\n    edge_options = []\n    if rows <= SHAPE_MAX_HEIGHT:\n        edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n    if rows >= SHAPE_MIN_HEIGHT + 1:\n        edge_options.extend(CORNER_EDGE_PAIRS)\n    if not edge_options:\n        return None\n\n    edge_pair = random.choice(edge_options)\n    height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n        SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n    )\n    max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n    if max_width_limit < SHAPE_MIN_WIDTH:\n        return None\n    max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n\n    intervals = _gen_intervals(_gen_widths(height, max_width))\n    if intervals is None:\n        return None\n    return rows, cols, bg, edge_pair, intervals\n\ndef _build_shape(rows, cols, edge_pair, intervals):\n    local_mask = _gen_local_mask(intervals)\n    placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n    if placement is None:\n        return None\n\n    shape = _gen_full_mask(rows, cols, local_mask, *placement)\n    shape_area = int(np.sum(shape))\n    if rows * cols - shape_area <= shape_area:\n        return None\n    return shape\n\ndef _split_valid_layers(shape):\n    layers = _gen_layers(shape)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n","exit_code":0,"status":"completed"}}
