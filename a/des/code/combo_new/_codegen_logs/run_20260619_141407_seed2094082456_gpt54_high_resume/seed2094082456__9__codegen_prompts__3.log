.full(region.shape, wall, dtype=int)\n        grid[region >= 0] = bg\n        used = set()\n        for rid in marked:\n            choices = [pos for pos in cand[rid] if pos not in used]\n            if not choices:\n                break\n            pos = random.choice(choices)\n            used.add(pos)\n            grid[pos] = region_markers[rid]\n        else:\n            exp, wall_regions = expected(grid, region, region_markers, bg, wall)\n            counts = Counter(map(int, grid.flat))\n            if counts[bg] <= counts[wall]:\n                continue\n            if sum(len(ids) == 1 for ids in wall_regions.values()) == 0:\n                continue\n            if sum(len(ids) >= 2 for ids in wall_regions.values()) == 0:\n                continue\n            if not np.array_equal(main(grid), exp):\n                continue\n            return grid, exp\n    raise RuntimeError\n\nfor i in range(20):\n    g,o=gen_once()\n    print(i, g.shape, infer(g), np.unique(g), np.sum(g!=o))\nprint('\"'ok')\nPY\"","aggregated_output":"0 (27, 23) (0, 8) [0 5 7 8 9] 98\n1 (26, 24) (6, 1) [1 3 6 7 9] 65\n2 (19, 25) (7, 0) [0 1 7 8] 56\n3 (17, 26) (7, 9) [3 7 8 9] 77\n4 (23, 24) (6, 7) [1 3 5 6 7 8] 64\n5 (21, 21) (2, 0) [0 1 2 5] 76\n6 (25, 24) (6, 8) [4 6 7 8] 104\n7 (19, 23) (0, 1) [0 1 6 8] 76\n8 (26, 19) (2, 0) [0 2 3 4 6 7] 105\n9 (26, 19) (6, 5) [4 5 6 8] 57\n10 (18, 16) (3, 2) [2 3 4 6 7] 47\n11 (17, 16) (5, 7) [2 3 5 7 9] 45\n12 (26, 26) (2, 0) [0 1 2 6 7 8] 118\n13 (24, 18) (7, 5) [2 3 5 7 9] 85\n14 (20, 19) (6, 7) [1 3 6 7 8] 69\n15 (18, 19) (7, 8) [3 5 6 7 8 9] 72\n16 (20, 23) (2, 3) [1 2 3 5 7] 54\n17 (22, 27) (9, 8) [1 2 4 6 8 9] 89\n18 (20, 21) (9, 2) [2 4 7 9] 74\n19 (19, 20) (8, 9) [1 2 7 8 9] 71\nok\n","exit_code":0,"status":"completed"}}
