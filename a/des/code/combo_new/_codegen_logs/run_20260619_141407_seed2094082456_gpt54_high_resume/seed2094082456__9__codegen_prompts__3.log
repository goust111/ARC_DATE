t[c]+ws[c]] = lab[r,c]\n    for r in range(R-1):\n        for c in range(C-1):\n            vals={lab[r,c],lab[r,c+1],lab[r+1,c],lab[r+1,c+1]}\n            if len(vals)==1:\n                region[top[r]+hs[r], left[c]+ws[c]] = vals.pop()\n    return region, lab\n\nregion,lab=make()\nprint(region.shape, lab)\nprint('\"'bg', np.sum(region>=0), 'wall', np.sum(region<0))\n# component count\nseen=np.zeros(region.shape,bool)\ncount=0\nfor r in range(region.shape[0]):\n  for c in range(region.shape[1]):\n    if region[r,c]<0 or seen[r,c]: continue\n    count+=1\n    q=deque([(r,c)]); seen[r,c]=1\n    vals={region[r,c]}\n    while q:\n      rr,cc=q.popleft()\n      for dr,dc in DIRS:\n        nr,nc=rr+dr,cc+dc\n        if 0<=nr<region.shape[0] and 0<=nc<region.shape[1] and region[nr,nc]>=0 and not seen[nr,nc]:\n          seen[nr,nc]=1; q.append((nr,nc)); vals.add(region[nr,nc])\n    print('comp',count,'labels',vals)\nPY\"","aggregated_output":"(18, 19) [[0 0 0]\n [0 0 0]\n [0 1 2]]\nbg 251 wall 91\ncomp 1 labels {0}\ncomp 2 labels {1}\ncomp 3 labels {2}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import defaultdict, deque\nimport random, numpy as np\nDIRS=[(-1,0),(1,0),(0,-1),(0,1)]\nclass DSU:\n    def __init__(self,n): self.p=list(range(n))\n    def find(self,x):\n        while self.p[x]\"'!=x:\n            self.p[x]=self.p[self.p[x]]; x=self.p[x]\n        return x\n    def union(self,a,b):\n        a,b=self.find(a),self.find(b)\n        if a!=b: self.p[b]=a; return True\n        return False\n\ndef gen():\n    for attempt in range(1000):\n        R=random.randint(3,4); C=random.randint(3,4)\n        hs=[random.randint(4,6) for _ in range(R)]\n        ws=[random.randint(4,6) for _ in range(C)]\n        H=sum(hs)+R+1; W=sum(ws)+C+1\n        n=R*C; target=random.randint(3,min(7,n-1))\n        d=DSU(n); edges=[]\n        for r in range(R):\n            for c in range(C):\n                i=r*C+c\n                if r+1<R: edges.append((i,(r+1)*C+c))\n                if c+1<C: edges.append((i,r*C+c+1))\n        random.shuffle(edges)\n        comps=n\n        for a,b in edges:\n            if comps<=target: break\n            if d.union(a,b): comps-=1\n        roots={root:i for i,root in enumerate(sorted({d.find(i) for i in range(n)}))}\n        lab=np.array([[roots[d.find(r*C+c)] for c in range(C)] for r in range(R)])\n        # adjacency and frame-touch\n        adj=defaultdict(set); frame=set()\n        for r in range(R):\n            for c in range(C):\n                rid=int(lab[r,c])\n                if r in {0,R-1} or c in {0,C-1}: frame.add(rid)\n                if r+1<R and lab[r,c]!=lab[r+1,c]:\n                    a,b=int(lab[r,c]),int(lab[r+1,c]); adj[a].add(b); adj[b].add(a)\n                if c+1<C and lab[r,c]!=lab[r,c+1]:\n                    a,b=int(lab[r,c]),int(lab[r,c+1]); adj[a].add(b); adj[b].add(a)\n        pair=None\n        for a in sorted(frame):\n            for b in sorted(adj[a]):\n                pair=(a,b); break\n            if pair: break\n        if pair is None: continue\n        marked={pair[0],pair[1]}\n        others=[x for x in sorted(set(lab.flat)) if x not in marked]\n        if not others: continue\n        # need marked region with unshared boundary: frame region gives that\n        print('\"'success',attempt,'shape',lab.shape,'regions',sorted(set(lab.flat)),'pair',pair,'others',others[:3])\n        print(lab)\n        return\n    print('fail')\n\ngen()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
