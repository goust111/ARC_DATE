{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2c181942.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py',\n]\nfor path in files:\n    print(f'FILE: {path}')\n    lines = Path(path).read_text().splitlines()\n    capture = False\n    indent = None\n    for i, line in enumerate(lines, 1):\n        if line.startswith('def main(') or line.startswith('def generate_input('):\n            capture = True\n            indent = len(line) - len(line.lstrip())\n        if capture:\n            print(f'{i:4}: {line}')\n            if i < len(lines):\n                nxt = lines[i]\n                if nxt.startswith('def ') and not nxt.startswith('def main(') and not nxt.startswith('def generate_input('):\n                    capture = False\n        \n    print('END_FILE')\nPY\"","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\n 101: def main(grid: np.ndarray) -> np.ndarray:\n 102:     \"\"\"\n 103:     Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n 104: \n 105:     Input structure:\n 106:     - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n 107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n 108: \n 109:     Rule:\n 110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.\n 111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.\n 112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.\n 113: \n 114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n 115:     \"\"\"\n 116:     g = np.asarray(grid, dtype=int)\n 117:     h, w = g.shape\n 118:     bg = get_bg(g)\n 119: \n 120:     mover = 4  # yellow in ARC\n 121:     dirs = _legend_directions(g, bg)\n 122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n 123: \n 124:     passable = (g == bg) | (g == mover)\n 125:     out = g.copy()\n 126: \n 127:     # Find enclosed passable regions (not connected to the outer border).\n 128:     for pts in components_mask(passable, connectivity=4):\n 129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n 130:             continue  # outside background\n 131: \n 132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n 133:         if not movers:\n 134:             continue\n 135: \n 136:         # Determine this region's border color by counting adjacent wall colors.\n 137:         border_counts: dict[int, int] = {}\n 138:         pset = {(int(r), int(c)) for r, c in pts}\n 139:         for r, c in pts:\n 140:             for nr, nc in neighbors4(r, c):\n 141:                 if not (0 <= nr < h and 0 <= nc < w):\n 142:                     continue\n 143:                 if (nr, nc) in pset:\n 144:                     continue\n 145:                 v = int(g[nr, nc])\n 146:                 if v == bg or v == mover:\n 147:                     continue\n 148:                 border_counts[v] = border_counts.get(v, 0) + 1\n 149:         if not border_counts:\n 150:             continue\n 151:         border_col = max(border_counts, key=border_counts.get)\n 152:         if border_col not in dirs:\n 153:             continue\n 154:         dr, dc = dirs[border_col]\n 155: \n 156:         # Clear old movers.\n 157:         for r, c in movers:\n 158:             out[r, c] = bg\n 159: \n 160:         # Slide and repaint.\n 161:         new_pts = _slide_points(pset, movers, dr, dc)\n 162:         for r, c in new_pts:\n 163:             out[r, c] = mover\n 164: \n 165:     return out\n 166: \n 167: # --------------- generator (claude-att1) ---------------\n 168: \n 169: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n 170: import random\n 171: import numpy as np\n 172: \n 173: from arc_utils import label_mask, neighbors4, paste\n 174: \n 175: # ── Configuration ─────────────────────────────────────────────────\n 176: GRID_H, GRID_W = 20, 20\n 177: \n 178: # Legend\n 179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n 180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n 181: CORNERS = ['TL', 'TR', 'BL', 'BR']\n 182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n 183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n 184: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n 185: \n 186: # Regions\n 187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n 188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n 189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n 190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n 191: }\n 192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n 193: \n 194: # Yellows\n 195: YELLOWS_PER_REGION = [1, 2]                # choices per region\n 196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n 197: \n 198: # Outer loop\n 199: GEN_RETRIES = 300                          # max attempts in generate_input()\n 200: \n 201: \n 202: # ── Legend patches ────────────────────────────────────────────────\n 203: \n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 611:         if g is not None:\n 612:             return g\n 613:     raise RuntimeError(\"generate_input: exceeded retries\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\n   6: def main(grid: np.ndarray) -> np.ndarray:\n   7:     \"\"\"\n   8:     Attach monochrome sprites to the matching sides of a central hollow square.\n   9: \n  10:     Input structure:\n  11:     - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n  12:     - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n  13: \n  14:     Rule:\n  15:     - For each hub edge color, find the matching sprite outside the hub.\n  16:     - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n  17:     - Translate it to adjoin that hub side. \n  18:     - Clear everything else to bg; output is hub + attached sprites only.\n  19: \n  20:     Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     H, W = g.shape\n  24:     bg = int(get_bg(g))\n  25: \n  26:     def _find_hub():\n  27:         best = None  # (score, (r,c,n), (top,bot,left,right))\n  28:         for n in range(3, 7):\n  29:             for r in range(0, int(H - n + 1)):\n  30:                 for c in range(0, int(W - n + 1)):\n  31:                     # corners must be bg\n  32:                     if (\n  33:                         int(g[int(r), int(c)]) != int(bg)\n  34:                         or int(g[int(r), int(c + n - 1)]) != int(bg)\n  35:                         or int(g[int(r + n - 1), int(c)]) != int(bg)\n  36:                         or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n  37:                     ):\n  38:                         continue\n  39:                     inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n  40:                     if not bool((inner == int(bg)).all()):\n  41:                         continue\n  42: \n  43:                     top = g[int(r), int(c + 1) : int(c + n - 1)]\n  44:                     bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n  45:                     left = g[int(r + 1) : int(r + n - 1), int(c)]\n  46:                     right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n  47: \n  48:                     if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n  49:                         continue\n  50:                     if (\n  51:                         len(set(map(int, top))) != 1\n  52:                         or len(set(map(int, bot))) != 1\n  53:                         or len(set(map(int, left))) != 1\n  54:                         or len(set(map(int, right))) != 1\n  55:                     ):\n  56:                         continue\n  57: \n  58:                     cr = float(r + (n - 1) / 2)\n  59:                     cc = float(c + (n - 1) / 2)\n  60:                     score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n  61:                     cand = (\n  62:                         float(score),\n  63:                         (int(r), int(c), int(n)),\n  64:                         (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n  65:                     )\n  66:                     if best is None or float(cand[0]) < float(best[0]):\n  67:                         best = cand\n  68:         return best\n  69: \n  70:     hub = _find_hub()\n  71:     assert not (hub is None)\n  72: \n  73:     _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n  74:     hub_mask = np.zeros((H, W), dtype=bool)\n  75:     hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n  76: \n  77:     out = np.full_like(g, int(bg))\n  78:     out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n  79: \n  80:     target = int(n - 2)  # length of the hub edge segment (excluding corners)\n  81: \n  82:     def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n  83:         pts = np.argwhere(mask)\n  84:         r0, c0, r1, c1 = bbox_coords(pts)\n  85:         return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n  86: \n  87:     def _edge_segment(mask: np.ndarray, side: str):\n  88:         pts = np.argwhere(mask)\n  89:         if pts.size == 0:\n  90:             return None\n  91:         if side == \"top\":\n  92:             rr = int(pts[:, 0].min())\n  93:             cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n  94:             return (\"h\", int(rr), cols)\n  95:         if side == \"bot\":\n  96:             rr = int(pts[:, 0].max())\n  97:             cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n  98:             return (\"h\", int(rr), cols)\n  99:         if side == \"left\":\n 100:             cc = int(pts[:, 1].min())\n 101:             rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n 102:             return (\"v\", int(cc), rows)\n 103:         if side == \"right\":\n 104:             cc = int(pts[:, 1].max())\n 105:             rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n 106:             return (\"v\", int(cc), rows)\n 107:         return None\n 108: \n 109:     def _is_contig(seq: list[int]) -> bool:\n 110:         return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n 111: \n 112:     # desired attachment geometry: adjacent (touching) the hub side segment\n 113:     segs = {\n 114:         \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n 115:         \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n 116:         \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n 117:         \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n 118:     }\n 119: \n 120:     for _side, (col, (need_edge, fixed, span)) in segs.items():\n 121:         col = int(col)\n 122:         m = (g == int(col)) & (~hub_mask)\n 123:         if not bool(m.any()):\n 124:             continue\n 125: \n 126:         # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n 127:         labc, nc = label_mask(m, connectivity=8)\n 128:         best_id = None\n 129:         best_sz = -1\n 130:         for cid in range(1, int(nc) + 1):\n 131:             sz = int((labc == int(cid)).sum())\n 132:             if sz > best_sz:\n 133:                 best_sz = sz\n 134:                 best_id = int(cid)\n 135:         if best_id is None or best_sz <= 0:\n 136:             continue\n 137: \n 138:         spr_mask = labc == int(best_id)\n 139:         spr_arr = g.copy()\n 140:         spr_arr[~spr_mask] = int(bg)\n 141:         spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n 142: \n 143:         found = None  # (a, msk, dr, dc)\n 144:         for krot in range(4):\n 145:             a = np.rot90(spr_arr, int(krot))\n 146:             msk = np.rot90(spr_mask, int(krot))\n 147:             a, msk = _crop_to_mask(a, msk)\n 148: \n 149:             # Attached sprite must be mirror-symmetric along the contact edge axis\n 150:             if need_edge in (\"left\", \"right\"):\n 151:                 if not bool(np.array_equal(msk, np.flipud(msk))):\n 152:                     continue\n 153:             else:\n 154:                 if not bool(np.array_equal(msk, np.fliplr(msk))):\n 155:                     continue\n 156: \n 157:             seg = _edge_segment(msk, need_edge)\n 158:             if seg is None:\n 159:                 continue\n 160: \n 161:             if need_edge in (\"left\", \"right\"):\n 162:                 _typ, edge_c, rows = seg\n 163:                 if len(rows) != int(target) or not _is_contig(rows):\n 164:                     continue\n 165:                 dr = int(span[0] - rows[0])\n 166:                 dc = int(fixed - edge_c)\n 167:             else:\n 168:                 _typ, edge_r, cols = seg\n 169:                 if len(cols) != int(target) or not _is_contig(cols):\n 170:                     continue\n 171:                 dr = int(fixed - edge_r)\n 172:                 dc = int(span[0] - cols[0])\n 173: \n 174:             placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n 175:             if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n 176:                 continue\n 177: \n 178:             # ensure no conflicts with already-drawn hub (or previously placed sprites)\n 179:             ok = True\n 180:             for R, C in placed:\n 181:                 val = int(a[int(R - dr), int(C - dc)])\n 182:                 if val == int(bg):\n 183:                     continue\n 184:                 if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n 185:                     ok = False\n 186:                     break\n 187:             if not ok:\n 188:                 continue\n 189: \n 190:             found = (a, msk, int(dr), int(dc))\n 191:             break\n 192: \n 193:         if found is None:\n 194:             continue\n 195: \n 196:         a, msk, dr, dc = found\n 197:         paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n 198: \n 199:     return out\n 200: \n 201: \n 202: # ---------------------------------------------------------------------------\n 203: # Generator\n 204: # ---------------------------------------------------------------------------\n 205: \n 206: from scipy.ndimage import label as _label\n 207: \n 535: def generate_input() -> np.ndarray:\n 536:     for _ in range(300):\n 537:         result = _gen_attempt()\n 538:         if result is not None:\n 539:             return result\n 540:     raise RuntimeError(\"generate_input: failed after 300 attempts\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n  10: \n  11:     Input structure:\n  12:     - bg = most common color.\n  13:     - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n  14:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n  15: \n  16:     Rule:\n  17:     - Match each sprite to the border anchor sharing its marker color.\n  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n  20: \n  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     H, W = g.shape\n  25:     bg = int(get_bg(g))\n  26: \n  27:     def is_border(r: int, c: int) -> bool:\n  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n  29: \n  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n  31:     anchors_by_color: dict[int, tuple[int, int]] = {}\n  32:     for r in range(H):\n  33:         for c in range(W):\n  34:             if not is_border(r, c):\n  35:                 continue\n  36:             v = int(g[r, c])\n  37:             if v == int(bg):\n  38:                 continue\n  39:             ok = True\n  40:             for rr, cc in neighbors4(int(r), int(c)):\n  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n  42:                     ok = False\n  43:                     break\n  44:             if ok and v not in anchors_by_color:\n  45:                 anchors_by_color[int(v)] = (int(r), int(c))\n  46: \n  47:     assert not (not anchors_by_color)\n  48: \n  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n  50: \n  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  53: \n  54:     def component_marker_color(coords: np.ndarray) -> int | None:\n  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n  57:         cnt = Counter(vals)\n  58:         if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n  88:                 continue\n  89:             r, c = map(int, coords[0])\n  90:             v = int(g[r, c])\n  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n  92:                 continue\n  93:             marker_col = int(v)\n  94: \n  95:         if int(marker_col) not in anchors_by_color:\n  96:             continue\n  97: \n  98:         mp = marker_pixel(coords, int(marker_col))\n  99:         if mp is None:\n 100:             continue\n 101: \n 102:         ar, ac = anchors_by_color[int(marker_col)]\n 103: \n 104:         # --- STEP 4) Compute translation (dr,dc). ---\n 105:         on_top_bottom = int(ar) in (0, int(H - 1))\n 106:         on_left_right = int(ac) in (0, int(W - 1))\n 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n 108: \n 109:         dr = 0\n 110:         dc = 0\n 111:         if horizontal:\n 112:             dc = int(ac - mp[1])\n 113:         else:\n 114:             dr = int(ar - mp[0])\n 115: \n 116:         moves.append((coords, int(dr), int(dc)))\n 117: \n 118:     out = g.copy()\n 119: \n 120:     # --- STEP 5) Apply all moves. ---\n 121:     # Clear moved components first (prevents collisions with their original locations).\n 122:     for coords, _dr, _dc in moves:\n 123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n 124: \n 125:     # Paste moved components:\n 126:     # - clip out-of-bounds pixels\n 127:     # - do not overwrite existing non-bg pixels\n 128:     for coords, dr, dc in moves:\n 129:         for r, c in coords:\n 130:             rr = int(r) + int(dr)\n 131:             cc = int(c) + int(dc)\n 132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n 133:                 out[rr, cc] = int(g[int(r), int(c)])\n 134: \n 135:     return out\n 136: \n 137: # --------------- generator (o5x) ---------------\n 138: \n 139: # CFG: palette and canvas bounds.\n 140: _COLORS = tuple(range(10))\n 141: _BG_COLOR_RANGE = (1, 8)\n 142: _GRID_HEIGHT_RANGE = (10, 22)\n 143: _GRID_WIDTH_RANGE = (8, 22)\n 144: \n 145: # CFG: placement isolation and anchor location.\n 146: _NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n 147: _INNER_BORDER_GAP = 1\n 148: _ANCHOR_EDGE_MARGIN = 2\n 149: _ISOLATION_RADIUS = 1\n 150: \n 151: # CFG: anchor, sprite, and retry counts.\n 152: _ANCHOR_COUNT_RANGE = (1, 3)\n 153: _SPRITE_COUNT_RANGE = (3, 5)\n 154: _BODY_AREA_RANGE = (4, 13)\n 155: _GEN_RETRY_LIMIT = 300\n 156: \n 157: # CFG: body geometry and shape mix.\n 158: _BODY_HEIGHT_RANGE = (2, 5)\n 159: _BODY_WIDTH_RANGE = (3, 7)\n 160: _FRAME_HEIGHT_RANGE = (3, 5)\n 161: _FRAME_WIDTH_RANGE = (3, 7)\n 162: _FRAME_MIN_AREA = 8\n 163: _FRAME_MAX_GAP = 3\n 164: _FRAME_BODY_THRESHOLD = 0.28\n 165: _WIDE_BODY_THRESHOLD = 0.55\n 166: _SYMMETRIC_BODY_THRESHOLD = 0.82\n 167: _SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n 168: _SYMMETRIC_TRANSPOSE_PROB = 0.45\n 169: _MARKER_INTERIOR_PROB = 0.65\n 170: _FLIP_PROB = 0.5\n 171: \n 172: # CFG: optional singleton distractors.\n 173: _DISTRACTOR_PROB = 0.15\n 174: _DISTRACTOR_COUNT_RANGE = (1, 4)\n 175: \n 176: _GROW_BODY_SEEDS = [\n 177:     {(0, 0), (0, 1), (0, 2), (1, 0)},\n 178:     {(0, 0), (0, 1), (0, 2), (1, 2)},\n 179:     {(0, 0), (1, 0), (1, 1), (1, 2)},\n 180:     {(0, 2), (1, 0), (1, 1), (1, 2)},\n 181:     {(0, 1), (1, 0), (1, 1), (1, 2)},\n 182: ]\n 183: \n 184: \n 582: def generate_input() -> np.ndarray:\n 583:     for _ in range(_GEN_RETRY_LIMIT):\n 584:         grid = _gen_attempt()\n 585:         if grid is not None:\n 586:             return grid\n 587:     raise RuntimeError(\"failed to generate a valid 581f7754 input\")\nEND_FILE\nFILE: /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\n 261: def main(grid: np.ndarray) -> np.ndarray:\n 262:     \"\"\"\n 263:     Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n 264: \n 265:     Input structure:\n 266:     - Color-6 separators divide the grid into a left legend column and a main canvas.\n 267:     - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n 268: \n 269:     Rule:\n 270:     - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n 271:     - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n 272:     - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n 273: \n 274:     Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n 275:     \"\"\"\n 276:     g = np.asarray(grid, dtype=int)\n 277:     h, w = g.shape\n 278:     assert w >= 2, \"grid width must be >= 2\"\n 279: \n 280:     # Output canvas is the region between the left separator run and (optionally) a\n 281:     # right-side separator run near the far edge (right legend panel).\n 282:     left_sep, right_sep = _split_canvas(g)\n 283:     left_sep_c1 = left_sep[1]\n 284:     canvas_c0 = left_sep_c1 + 1\n 285:     canvas_c1 = right_sep[0] if right_sep is not None else w\n 286:     main = g[:, canvas_c0:canvas_c1].copy()\n 287: \n 288:     # Paint one constructed sprite per marker panel that lies outside the output canvas.\n 289:     marker_squares = _all_marker_panel_squares(g)\n 290:     assert marker_squares, \"no marker panel found\"\n 291: \n 292:     # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n 293:     eff_h, eff_w = main.shape\n 294:     full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n 295:     if full6_cols:\n 296:         eff_w = min(full6_cols)\n 297:     full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n 298:     if full6_rows:\n 299:         eff_h = min(full6_rows)\n 300: \n 301:     out = main.copy()\n 302:     composite_written = np.zeros(out.shape, dtype=bool)\n 303: \n 304:     for marker_r0, marker_c0 in marker_squares:\n 305:         # Ignore marker panels inside the output canvas; only legends should drive drawing.\n 306:         if canvas_c0 <= marker_c0 < canvas_c1:\n 307:             continue\n 308: \n 309:         if marker_c0 + 5 > w:\n 310:             continue\n 311:         panel = g[:, marker_c0 : marker_c0 + 5]\n 312: \n 313:         unit = _extract_unit_sprite(panel)\n 314:         if unit is None:\n 315:             continue\n 316:         unit_sprite, unit_bb = unit\n 317: \n 318:         frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n 319:         if frame_bb is None:\n 320:             continue\n 321:         fr0, fc0, fr1, fc1 = frame_bb\n 322:         frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n 323:         frame_mask0 = (frame != 0) & (frame != 6)\n 324:         _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n 325:         assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n 326: \n 327:         # Rotate layout according to clockhand.\n 328:         dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n 329:         frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n 330: \n 331:         # Build composite by tiling the unit sprite into active frame cells.\n 332:         m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n 333:         uh, uw = unit_sprite.shape\n 334:         fh, fw = frame_mask.shape\n 335:         comp = np.zeros((fh * uh, fw * uw), dtype=int)\n 336:         for i in range(fh):\n 337:             for j in range(fw):\n 338:                 if not frame_mask[i, j]:\n 339:                     continue\n 340:                 rr0 = i * uh\n 341:                 cc0 = j * uw\n 342:                 comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n 343: \n 344:         pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n 345:         if pos is None:\n 346:             continue\n 347:         pr, pc = pos\n 348: \n 349:         top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n 350:         left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n 351: \n 352:         ch, cw = comp.shape\n 353:         for r in range(ch):\n 354:             rr = top + r\n 355:             assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n 356:             for c in range(cw):\n 357:                 cc = left + c\n 358:                 assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n 359:                 if out[rr, cc] == 6:\n 360:                     continue\n 361:                 val = int(comp[r, c])\n 362:                 if val != 0 and val != 6:\n 363:                     assert not composite_written[rr, cc], \"composites must not overlap\"\n 364:                     composite_written[rr, cc] = True\n 365:                     out[rr, cc] = val\n 366:     return out\n 367: \n 368: # --------------- generator (refine_8conn_fill_overlap) ---------------\n 369: \n 370: # ── CFG: tunable generation parameters ──────────────────────────────\n 371: GRID_H_RANGE = (20, 30)         # output grid height\n 372: GRID_W = 30                     # output grid width (fixed)\n 373: LEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\n 374: UNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\n 375: MIN_CANVAS_W = 8                # reject if canvas narrower than this\n 376: FRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\n 377: FRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\n 378: FRAME_DENSITY = 0.5             # density for random_sprite frame generation\n 379: BAND_WIDTH_MIN = 4              # minimum band width for canvas background\n 380: MARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\n 381: USABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\n 382: ROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\n 383: GEN_RETRIES = 300               # max attempts in generate_input\n 384: \n 385: \n 650: def generate_input() -> np.ndarray:\n 651:     for _ in range(GEN_RETRIES):\n 652:         result = _gen_attempt()\n 653:         if result is not None:\n 654:             return result\n 655:     raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\nEND_FILE\n","exit_code":0,"status":"completed"}}
