tor color.\n  51: \n  52:     Rule\n  53:     - Keep the separator lines and the source sprite tile unchanged.\n  54:     - Replace each marked target tile with an exact copy of the source tile.\n  55:     - Unmarked background-only tiles remain unchanged.\n  56: \n  57:     Key insight\n  58:     - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n  59:     \"\"\"\n  60:     g = np.asarray(grid, dtype=int)\n  61:     assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n  62: \n  63:     separator, sep_rows, sep_cols = _separator_lines(g)\n  64:     row_spans = _spans(g.shape[0], sep_rows)\n  65:     col_spans = _spans(g.shape[1], sep_cols)\n  66: \n  67:     tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n  68:     tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n  69:     assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n  70:     tile_h = tile_heights.pop()\n  71:     tile_w = tile_widths.pop()\n  72: \n  73:     bg = _unique_mode(g[g != separator])\n  74:     assert bg != separator, \"background and separator colors must differ\"\n  75:     sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n  76:     assert len(sprite_colors) == 1, \"expected one sprite color\"\n  77:     sprite_color = sprite_colors[0]\n  78: \n  79:     source_tiles = []\n  80:     marked_origins = []\n  81:     for r0, r1 in row_spans:\n  82:         for c0, c1 in col_spans:\n  83:             tile = g[r0 : r1 + 1, c0 : c1 + 1]\n  84:             assert tile.shape == (tile_h, tile_w)\n  85:             has_sprite = np.any(tile == sprite_color)\n  86:             has_marker = np.any(tile == separator)\n  87:             if has_sprite:\n  88:                 assert not has_marker, \"source tile should contain only sprite and background\"\n  89:                 assert set(map(int, np.unique(