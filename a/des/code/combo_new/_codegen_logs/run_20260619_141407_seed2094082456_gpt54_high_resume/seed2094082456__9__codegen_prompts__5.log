{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/52364a65.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.\n\n    Input structure:\n    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.\n    - Each foreground object spans at least two columns in its bounding box.\n\n    Rule:\n    - Find each same-color 4-connected foreground object.\n    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components, \"expected at least one foreground object\"\n\n    out = g.copy()\n    for component in components:\n        coords = component[\"coords\"]\n        _r0, c0, _r1, c1 = map(int, component[\"bbox\"])\n        assert c1 - c0 + 1 >= 2, \"each object must span at least two columns\"\n\n        erase = coords[coords[:, 1] < c0 + 2]\n        out[erase[:, 0], erase[:, 1]] = bg\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n# Canvas constraints.\nBG = 8\nGRID_SIZE_RANGE = (8, 11)\nMIN_BACKGROUND_FRACTION = 0.50\n# Object sampling constraints.\nOBJECT_COUNT = 4\nFOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]\nSPRITE_WIDTH_RANGE = (2, 6)\nSPRITE_HEIGHT_RANGE = (2, 5)\nSPRITE_PIXEL_RANGE = (4, 14)\nSPRITE_RETRIES = 30\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = \"not_symmetric\"\n# Placement and global retry policy.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nGENERATION_RETRIES = 300\n\ndef _sample_sprite(color: int) -> np.ndarray | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/b2bc3ffd.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move every object above the solid bottom stripe upward by its own pixel count.\n\n    Input structure\n    The grid has a dominant background, exactly one full-width non-background row\n    that acts as a fixed stripe, and one or more 4-connected monochrome objects\n    above that stripe.\n\n    Rule\n    Clear each object from its original cells, then translate it straight upward\n    by the number of pixels in that object, preserving its shape and color. Leave\n    the full-width stripe unchanged.\n\n    Key insight\n    Each object's area is also its vertical displacement; the full-width row is a\n    fixed baseline, not a moving object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    stripe_rows = [\n        r\n        for r in range(h)\n        if np.unique(g[r]).size == 1 and int(g[r, 0]) != bg\n    ]\n    assert len(stripe_rows) == 1\n    stripe_row = stripe_rows[0]\n    assert stripe_row == h - 1\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    stripe_components = []\n    moving_objects = []\n    for component in components:\n        coords = component[\"coords\"]\n        is_stripe = int(component[\"area\"]) == w and np.all(coords[:, 0] == stripe_row)\n        if is_stripe:\n            stripe_components.append(component)\n        else:\n            assert np.all(coords[:, 0] < stripe_row)\n            moving_objects.append(component)\n\n    assert len(stripe_components) == 1\n    assert moving_objects\n\n    out = g.copy()\n    for component in moving_objects:\n        coords = component[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    occupied = np.zeros(g.shape, dtype=bool)\n    occupied[stripe_row, :] = True\n\n    for component in moving_objects:\n        coords = component[\"coords\"]\n        target = coords.copy()\n        target[:, 0] -= int(component[\"area\"])\n\n        assert np.all(target[:, 0] >= 0)\n        assert not np.any(occupied[target[:, 0], target[:, 1]])\n\n        occupied[target[:, 0], target[:, 1]] = True\n        out[target[:, 0], target[:, 1]] = int(component[\"color\"])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# CFG: canvas/colors, counts/spacing, shape/motion, biased sampling, retries.\n_GEN_GRID_SIZE = 8\n_GEN_BG = 7\n_GEN_STRIPE = 8\n_GEN_COLORS = [1, 2, 3, 4, 5, 6, 9]\n\n_GEN_OBJECT_COUNTS = [2, 3, 4]\n_GEN_MIN_INTER_OBJECT_GAP = 1\n\n_GEN_MAX_HEIGHT = 3\n_GEN_MAX_AREA = 6\n_GEN_SUPPORT_ROW_OFFSET = 2\n\n_GEN_TWO_OBJECT_WIDE_SPAN_PROB = 0.7\n_GEN_WIDE_WIDTH_CHOICES = (6, 5)\n_GEN_WIDEST_WIDTH_PROB = 0.55\n_GEN_SPAN6_AREA6_PROB = 0.75\n_GEN_SPAN5_AREA5_PROB = 0.65\n\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_partition_spans(n):\n","exit_code":0,"status":"completed"}}
