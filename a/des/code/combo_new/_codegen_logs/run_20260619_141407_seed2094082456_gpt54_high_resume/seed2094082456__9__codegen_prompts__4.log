<= cc3 <= int(ic1):\n                    out[rr, cc3] = int(col)\n\n    return out\n\n--- generate_input lines 306-311 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py =====\n--- main lines 35-273 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair a one-cell-thick colored line network by replacing singleton markers, filling short orthogonal gaps, and redirecting yellow-marked arms to the edge.\n\n    Input structure:\n    - A rectangular grid with a dominant background.\n    - Line colors form one-cell-thick horizontal/vertical stroke fragments.\n    - Marker colors are exactly those whose 4-connected components are all singleton pixels.\n    - Red singleton markers are missing line cells; yellow singleton markers are directional controls next to a line endpoint.\n\n    Rule:\n    - Assign every marker to the nearest visible line color in row/column line-of-sight, preferring an endpoint supported along that same axis.\n    - For each line color, fill the gap between consecutive facing endpoints in a row or column.\n    - A yellow control erases the old straight arm on the far side of its endpoint and paints the same color from that endpoint through the control pixel to the grid edge.\n    - At crossings, yellow-control rays win; otherwise an original-vs-filled crossing uses the more fragmented pre-repair line color, while pure filled crossings use the lower color id.\n\n    Key insight: The singleton markers identify which sparse stroke fragments belong together; after they are colored, the intended lines are the axis-aligned gaps between facing endpoints, with yellow controls flipping one arm to the marked side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = set(map(int, g.ravel())) - {bg}\n    assert colors, \"expected foreground line and marker colors\"\n\n    marker_colors: set[int] = set()\n    for color in colors:\n        comps = components_mask(g == color, connectivity=4)\n        assert comps, \"foreground color must have at least one component\"\n        if max(len(comp) for comp in comps) == 1:\n            marker_colors.add(int(color))\n\n    line_colors = colors - marker_colors\n    assert line_colors, \"expected at least one non-marker line color\"\n    assert marker_colors, \"expected singleton marker colors\"\n\n    original = {color: _pts(g == color) for color in line_colors}\n    assignment: dict[tuple[int, int], int] = {}\n    assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n\n    marker_mask = np.isin(g, list(marker_colors))\n    for r0, c0 in _pts(marker_mask):\n        candidates: list[tuple[int, int, int, int, int]] = []\n        for dr, dc in DIRS4:\n            r, c = r0 + dr, c0 + dc\n            dist = 1\n            while 0 <= r < H and 0 <= c < W:\n                value = int(g[r, c])\n                if value in line_colors:\n                    axis = 0 if dr == 0 else 1\n                    supported = _axis_support(original[value], r, c, axis)\n                    candidates.append((dist, 0 if supported else 1, value, dr, dc))\n                    break\n                if value == bg or value in marker_colors:\n                    r += dr\n                    c += dc\n                    dist += 1\n                    continue\n                break\n\n        assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n        candidates.sort()\n        _dist, _unsupported, color, dr, dc = candidates[0]\n        assignment[(r0, c0)] = int(color)\n        assign_dir[(r0, c0)] = (int(dr), int(dc))\n\n    masks = {color: set(pts) for color, pts in original.items()}\n    marker_pts = {color: set() for color in line_colors}\n    for pt, color in assignment.items():\n        masks[color].add(pt)\n        marker_pts[color].add(pt)\n\n    comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n\n    def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n        return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n\n    def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n        r1, c1 = a\n        r2, c2 = b\n        gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n        if gap <= 0:\n            return False\n\n        a_axis = has_axis_support(color, r1, c1, axis)\n        b_axis = has_axis_support(color, r2, c2, axis)\n        if gap == 1:\n            if a_axis or b_axis:\n                return True\n            a_perp = _perp_support(masks[color], r1, c1, axis)\n            b_perp = _perp_support(masks[color], r2, c2, axis)\n            return not (a_perp and b_perp)\n\n        if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n            return False\n        return a_axis and b_axis\n\n    for color in sorted(line_colors):\n        additions: set[tuple[int, int]] = set()\n        for r in range(H):\n            cols = sorted(c for rr, c in masks[color] if rr == r)\n            for c1, c2 in zip(cols, cols[1:]):\n                if should_fill(color, (r, c1), (r, c2), axis=0):\n                    additions.update((r, c) for c in range(c1 + 1, c2))\n\n        for c in range(W):\n            rows = sorted(r for r, cc in masks[color] if cc == c)\n            for r1, r2 in zip(rows, rows[1:]):\n                if should_fill(color, (r1, c), (r2, c), axis=1):\n                    additions.update((r, c) for r in range(r1 + 1, r2))\n\n        masks[color].update(additions)\n\n    control_ray = {color: set() for color in line_colors}\n    if 4 in marker_colors:\n        for control in _pts(g == 4):\n            color = assignment[control]\n            dr, dc = assign_dir[control]\n\n            r, c = control[0] + dr, control[1] + dc\n# ... truncated ...\n                        assert perp, f\"boundary endpoint ({r},{c}) color {color} not perpendicular\"\n                    continue\n                adj_other = any(\n                    0 <= r+dr < H and 0 <= c+dc < W\n                    and int(out[r+dr, c+dc]) not in (bg, color)\n                    for dr, dc in DIRS4)\n                assert adj_other, f\"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing\"\n\n    # Assert: every line color crosses at least one other color\n    color_cells = {c: set() for c in line_colors}\n    for r in range(H):\n        for c in range(W):\n            v = int(out[r, c])\n            if v in line_colors:\n                color_cells[v].add((r, c))\n    crossing_colors = set()\n    for r in range(H):\n        for c in range(W):\n            a = int(out[r, c])\n            if a not in line_colors:\n                continue\n            for b in line_colors - {a}:\n                if (((r, c-1) in color_cells[b] and (r, c+1) in color_cells[b])\n                        or ((r-1, c) in color_cells[b] and (r+1, c) in color_cells[b])):\n                    crossing_colors.add(a)\n                    crossing_colors.add(b)\n    for color in line_colors:\n        assert color in crossing_colors, f\"color {color} has no crossing with any other color\"\n\n    return out\n\n--- generate_input lines 891-896 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"failed to generate a valid faa9f03d input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/9344f635.py =====\n--- main lines 14-58 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend each colored domino marker into a full row or column bar, with horizontal bars covering vertical bars at crossings.\n\n    Input structure:\n    - The background is the dominant color.\n    - Every foreground object is a 4-connected same-color domino of exactly two pixels.\n    - A horizontal domino marks a row to paint; a vertical domino marks a column to paint.\n\n    Rule:\n    - Paint each marked column entirely with the color of its vertical domino marker.\n    - Paint each marked row entirely with the color of its horizontal domino marker.\n    - Rows are painted after columns, so row bars overwrite column bars at intersections.\n\n    Key insight:\n    - The two-pixel orientation is the instruction: horizontal markers emit row bars, vertical markers emit column bars, and the only layering cue is row-over-column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    bg = get_bg(g)\n\n    row_colors: dict[int, int] = {}\n    col_colors: dict[int, int] = {}\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    assert components, \"expected at least one foreground domino\"\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        coords = comp[\"coords\"]\n        assert len(coords) == 2, \"each foreground object must be a two-pixel domino\"\n        r0, c0, r1, c1 = comp[\"bbox\"]\n\n        if r0 == r1 and c1 == c0 + 1:\n            _add_bar(row_colors, r0, color)\n        elif c0 == c1 and r1 == r0 + 1:\n            _add_bar(col_colors, c0, color)\n        else:\n            raise AssertionError(\"domino marker must be horizontal or vertical\")\n\n    out = np.full_like(g, int(bg))\n    for c, color in col_colors.items():\n        out[:, c] = int(color)\n    for r, color in row_colors.items():\n        out[r, :] = int(color)\n    return out\n\n--- generate_input lines 172-177 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 9344f635 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/52364a65.py =====\n--- main lines 9-39 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.\n\n    Input structure:\n    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.\n    - Each foreground object spans at least two columns in its bounding box.\n\n    Rule:\n    - Find each same-color 4-connected foreground object.\n    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components, \"expected at least one foreground object\"\n\n    out = g.copy()\n    for component in components:\n        coords = component[\"coords\"]\n        _r0, c0, _r1, c1 = map(int, component[\"bbox\"])\n        assert c1 - c0 + 1 >= 2, \"each object must span at least two columns\"\n\n        erase = coords[coords[:, 1] < c0 + 2]\n        out[erase[:, 0], erase[:, 1]] = bg\n\n    return out\n\n--- generate_input lines 114-119 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {GENERATION_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py =====\n--- main lines 105-122 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n--- generate_input lines 275-280 ---\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"failed to generate afe3afe9 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dfadab01.py =====\n--- main lines 78-111 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand each colored control pixel into its corresponding fixed 4x4 glyph.\n\n    Input structure:\n    - Black background with single-pixel markers in colors 2, 3, 5, and/or 8.\n    - Some inputs also show a sample 4x4 glyph in the output color, with a same-rule marker just below-right of the sample.\n\n    Rule:\n    - Replace each marker color by its learned 4x4 glyph: 2->yellow frame, 3->blue ring, 5->pink diagonal blocks, 8->orange X.\n    - Paint each glyph with its top-left corner at the marker pixel, clipping at the grid boundary.\n    - Remove the sample glyphs and skip their below-right label markers.\n\n    Key insight:\n    - The colored pixels are control pixels for a fixed glyph alphabet; non-control sample glyphs are only legend entries, not preserved scene objects.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    assert set(np.unique(g)).issubset({0, *GLYPHS.keys(), 1, 4, 6, 7})\n\n    out = np.zeros_like(g)\n    seen_marker = False\n    for marker_color, (glyph_color, mask) in GLYPHS.items():\n        coords = np.argwhere(g == marker_color)\n        if coords.size:\n            seen_marker = True\n        for r, c in coords:\n            # Legend labels appear one cell below-right of the sample glyph bbox.\n            if _has_source_glyph(g, int(r) - 4, int(c) - 4, glyph_color, mask):\n                continue\n            _paint_clipped(out, int(r), int(c), glyph_color, mask)\n\n    assert seen_marker\n    return out\n\n===== /home/lixinyu/snap/new/ARC_code/train/e729b7be.py =====\n--- main lines 7-61 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\n    Input structure\n    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n    - A single divider color fills the center column except for the center marker.\n    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\n    Rule\n    - Keep the input unchanged.\n    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\n    Key insight\n    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h % 2 == 1 and w % 2 == 1\n\n    cr, cc = h // 2, w // 2\n    bg = int(get_bg(g))\n\n    marker_color = int(g[cr, cc])\n    assert marker_color != bg\n    marker_mask = g == marker_color\n    expected_markers = np.zeros(g.shape, dtype=bool)\n    expected_markers[cr, 0] = True\n    expected_markers[cr, cc] = True\n    expected_markers[cr, w - 1] = True\n    assert np.array_equal(marker_mask, expected_markers)\n\n    center_col = g[:, cc]\n    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}\n    assert len(divider_colors) == 1\n    divider_color = next(iter(divider_colors))\n    assert divider_color != bg\n    expected_divider = np.zeros(g.shape, dtype=bool)\n    expected_divider[:, cc] = True\n    expected_divider[cr, cc] = False\n    assert np.array_equal(g == divider_color, expected_divider)\n\n    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)\n    source_coords = np.argwhere(source_mask)\n    assert source_coords.size > 0\n    assert np.all(source_coords[:, 1] < cc)\n\n    out = g.copy()\n    for r, c in source_coords:\n        rr = 2 * cr - int(r)\n        rc = 2 * cc - int(c)\n        assert 0 <= rr < h and 0 <= rc < w\n        assert out[rr, rc] == bg\n        out[rr, rc] = g[r, c]\n\n    return out\n\n--- generate_input lines 215-220 ---\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid e729b7be input\")\n\n","exit_code":0,"status":"completed"}}
