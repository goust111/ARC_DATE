{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"import numpy as np\nfrom collections import deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\nfrom arc_utils import neighbors4\n\n\ndef _components(g: np.ndarray, col: int, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(g == col, connectivity=8 if conn8 else 4)]\n\n\ndef _is_straight_line(comp: list[tuple[int, int]]) -> bool:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(rs)) == 1:\n        row = rs[0]\n        cols = sorted(set(cs))\n        return cols == list(range(min(cols), max(cols) + 1))\n    if len(set(cs)) == 1:\n        col = cs[0]\n        rows = sorted(set(rs))\n        return rows == list(range(min(rows), max(rows) + 1))\n    return False\n\n\ndef _bar_endpoints(comp: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(cs)) == 1:\n        c = cs[0]\n        return (min(rs), c), (max(rs), c)\n    r = rs[0]\n    return (r, min(cs)), (r, max(cs))\n\n\ndef _touches_border(p: tuple[int, int], h: int, w: int) -> bool:\n    r, c = p\n    return r == 0 or c == 0 or r == h - 1 or c == w - 1\n\n\ndef _bfs_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    if goal not in prev:\n        return None\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _bfs_path_with_diag_filter(\n    start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray\n) -> list[tuple[int, int]] | None:\n    # Like _bfs_path but disallows diagonal steps when either orthogonal intermediate cell is also walkable.\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n\n    def can_step(r: int, c: int, nr: int, nc: int) -> bool:\n        dr = nr - r\n        dc = nc - c\n        if dr == 0 or dc == 0:\n            return True\n        # diagonal: skip if either intermediate orth cell is in the walkable set\n        mid1 = (r, c + dc)\n        mid2 = (r + dr, c)\n        if 0 <= mid1[0] < h and 0 <= mid1[1] < w and bool(walkable[mid1]):\n            return False\n        if 0 <= mid2[0] < h and 0 <= mid2[1] < w and bool(walkable[mid2]):\n            return False\n        return True\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            if not can_step(r, c, nr, nc):\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    assert goal in prev, \"BFS-with-diag-filter must reach goal\"\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _greedy_manhattan_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n\n    def md(p):\n        return abs(p[0] - goal[0]) + abs(p[1] - goal[1])\n\n    cur = start\n    path = [cur]\n    seen = {cur}\n    while cur != goal:\n        cur_md = md(cur)\n        best = None  # (md, is_diag, nr, nc)\n        for nr, nc in neighbors8(cur[0], cur[1]):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in seen:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            nmd = md(nxt)\n            if nmd >= cur_md:\n                continue\n            is_diag = 1 if (nr != cur[0] and nc != cur[1]) else 0\n            key = (nmd, is_diag, nr, nc)\n            if best is None or key < best:\n                best = key\n        if best is None:\n            return None\n        _, _, nr, nc = best\n        cur = (nr, nc)\n        path.append(cur)\n        seen.add(cur)\n    return path\n\n\ndef _segment_main_path(seg_pts: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:\n    # Extract the \"main stroke\" of the segment as a simple path.\n    #\n    # Use 4-neigh edges always. Allow diagonal edges only when they represent a true diagonal stroke,\n    # i.e. the diagonal pixels touch only at the corner (no orthogonal intermediate segment pixel),\n    # which prevents diagonal shortcuts across bends.\n    sset = set(seg_pts)\n\n    def neighbors(p: tuple[int, int]):\n        r, c = p\n        for q in neighbors4(r, c):\n            if q in sset:\n                yield q\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            # If either orthogonal intermediate cell is occupied, treat this as a bend shortcut and skip.\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            yield q\n\n    q = deque([start])\n    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}\n    dist: dict[tuple[int, int], int] = {start: 0}\n    while q:\n        cur = q.popleft()\n        for nxt in neighbors(cur):\n            if nxt in prev:\n                continue\n            prev[nxt] = cur\n            dist[nxt] = dist[cur] + 1\n            q.append(nxt)\n\n    far = max(dist.keys(), key=lambda p: (dist[p], p[0], p[1]))\n    path = []\n    cur = far\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _segment_degrees(seg_pts: list[tuple[int, int]]) -> dict[tuple[int, int], int]:\n    sset = set(seg_pts)\n    deg = {p: 0 for p in sset}\n    for r, c in sset:\n        # 4-neigh\n        for q in neighbors4(r, c):\n            if q in sset:\n                deg[(r, c)] += 1\n        # diagonals only if no orth intermediate is present\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            deg[(r, c)] += 1\n    return deg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/31f7f899.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, find_components, get_bg, randomly_spaced_indices\nfrom arc_utils import paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort vertical bars by height and redistribute them across fixed colored slots.\n\n    Input structure:\n    - bg background; a horizontal base line of a single color spans the full grid width.\n    - Several monochrome vertical bars of distinct colors rise upward from the base line.\n\n    Rule:\n    - Rank bar shapes by height (shortest to tallest).\n    - Rank original x-positions (slots) left to right.\n    - Place the i-th shortest shape into the i-th leftmost slot, recoloring it to that slot's original color.\n    - The base line is preserved unchanged.\n\n    Key insight: Each slot keeps its x-position and color identity; only the bar silhouettes are redistributed among slots by height order.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Base row/color = (row,color) with maximal count on that row (excluding bg).\n    best = None  # (count, row, color)\n    for r in range(H):\n        vals, counts = np.unique(g[r, :], return_counts=True)\n        for v, cnt in zip(vals, counts):\n            v = int(v)\n            cnt = int(cnt)\n            if v == bg:\n                continue\n            if best is None or cnt > best[0]:\n                best = (cnt, int(r), int(v))\n    assert not (best is None)\n    _cnt, base_r, base_col = best\n\n    objects: list[dict[str, object]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in {int(bg), int(base_col)}:\n            continue\n\n        pts = comp[\"coords\"]\n        b = comp[\"bbox\"]\n        height = int(bbox_h(b))\n\n        base_cols = sorted(int(c) for r, c in pts if int(r) == int(base_r))\n        if base_cols:\n            anchor = int(base_cols[len(base_cols) // 2])\n        else:\n            cols_sorted = sorted(int(c) for _r, c in pts)\n            anchor = int(cols_sorted[len(cols_sorted) // 2])\n\n        rel = [(int(r) - int(base_r), int(c) - int(anchor)) for r, c in pts]\n        objects.append(\n            {\n                \"color\": int(col),\n                \"anchor\": int(anchor),\n                \"height\": int(height),\n                \"size\": int(len(rel)),\n                \"rel\": rel,\n            }\n        )\n\n    # Slots are determined by original x-positions; slot colors must be preserved.\n    slots = sorted(objects, key=lambda o: (int(o[\"anchor\"]), int(o[\"color\"])))\n    # Shapes are ordered by height (shortest -> tallest).\n    shapes = sorted(objects, key=lambda o: (int(o[\"height\"]), int(o[\"size\"]), int(o[\"anchor\"]), int(o[\"color\"])))\n\n    out = np.full_like(g, bg)\n    out[int(base_r), :] = int(base_col)\n\n    for slot, shape in zip(slots, shapes):\n        slot_col = int(slot[\"color\"])\n        slot_anchor = int(slot[\"anchor\"])\n        for dr, dc in shape[\"rel\"]:\n            rr = int(base_r) + int(dr)\n            cc = int(slot_anchor) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W:\n                out[rr, cc] = int(slot_col)\n\n    return out\n\n# --------------- generator (Codex#3) ---------------\n\ndef _rand_composition(total: int, parts: int) -> list[int]:\n    return [int(x) for x in np.random.multinomial(int(total), np.full(int(parts), 1.0 / int(parts)))]\n\n\ndef _slot_lefts(n: int, k: int, width: int) -> list[int]:\n    used = int(k * width + (k - 1))\n    extra = int(n - used)\n    if extra < 0:\n        raise ValueError(\"bars do not fit\")\n    gaps = _rand_composition(extra, k + 1)\n    lefts: list[int] = []\n    c = int(gaps[0])\n    for i in range(k):\n        lefts.append(int(c))\n        c += int(width)\n        if i < k - 1:\n            c += 1 + int(gaps[i + 1])\n    return lefts\n\n\ndef _draw_scene(n: int, base_r: int, base_color: int, bg: int, lefts: list[int], width: int, colors: list[int], heights: list[int]) -> np.ndarray:\n    grid = np.full((n, n), int(bg), dtype=int)\n    grid[base_r, :] = int(base_color)\n    for left, color, height in zip(lefts, colors, heights):\n        patch = np.full((int(height), int(width)), int(color), dtype=int)\n        paste(grid, patch, int(base_r - height // 2), int(left))\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(np.random.choice(np.arange(7, 18, 2)))\n    base_r = n // 2\n    bg = 8\n    base_color = 6\n\n    height_choices = list(range(1, min(n, 11) + 1, 2))\n    max_count = min(5, len(height_choices), (n + 1) // 2)\n    if max_count < 3:\n        return None\n    k = int(np.random.randint(3, max_count + 1))\n\n    feasible_widths = [1]\n    if n - 3 * k > 3 and n >= 4 * k - 1:\n        feasible_widths.append(3)\n    width = int(np.random.choice(feasible_widths))\n\n    lefts = _slot_lefts(n, k, width)\n    colors = [int(c) for c in np.random.choice([1, 2, 3, 4, 5, 7, 9], size=k, replace=False)]\n\n    sorted_heights = sorted(int(h) for h in np.random.choice(height_choices, size=k, replace=False))\n    out = _draw_scene(n, base_r, base_color, bg, lefts, width, colors, sorted_heights)\n\n    perm = np.random.permutation(k)\n    if np.array_equal(perm, np.arange(k)):\n        a, b = np.random.choice(k, size=2, replace=False)\n        perm[a], perm[b] = perm[b], perm[a]\n    in_heights = [int(sorted_heights[i]) for i in perm]\n    inp = _draw_scene(n, base_r, base_color, bg, lefts, width, colors, in_heights)\n\n    if np.array_equal(inp, out):\n        return None\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        row_colors = set(map(int, g[r]))\n        if len(row_colors) == 1:\n            color = next(iter(row_colors))\n            if int(color) != int(bg):\n                rows.append((int(r), int(color)))\n    assert len(rows) == 1, \"expected exactly one solid non-background divider row\"\n    return rows[0]\n\n\ndef _unique_widest_row(coords: np.ndarray) -> int:\n    row_counts: list[tuple[int, int]] = []\n    for r in sorted(set(map(int, coords[:, 0]))):\n        row_cols = np.sort(coords[coords[:, 0] == r, 1])\n        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))\n        row_counts.append((int(row_cols.size), int(r)))\n\n    max_count = max(count for count, _r in row_counts)\n    widest = [r for count, r in row_counts if count == max_count]\n    assert max_count > 1, \"multi-column sprites must have a horizontal span\"\n    assert len(widest) == 1, \"expected a unique widest horizontal row\"\n    return int(widest[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    inp[divider_r, :] = divider_color\n    out[divider_r, :] = divider_color\n\n    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET\n    for desc, left in zip(descriptors, starts):\n        height = int(desc[\"height\"])\n        width = int(desc[\"width\"])\n        if desc[\"kind\"] == \"single\":\n            col = left\n            out[divider_r, col] = bg\n            out[H - height : H, col] = sprite_color\n\n            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)\n            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color\n            continue\n\n        bar_row = int(desc[\"bar_row\"])\n        spine_col = int(desc[\"spine_col\"])\n        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row\n        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)\n        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):\n            return None\n        out[landed[:, 0], landed[:, 1]] = sprite_color\n\n        landed_bottom = int(landed[:, 0].max())\n        min_shift = landed_bottom - input_max_bottom\n        max_shift = landed_top\n        if min_shift > max_shift:\n            return None\n        shift = random.randint(min_shift, max_shift)\n        original = landed.copy()\n        original[:, 0] -= shift\n        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):\n            return None\n        inp[original[:, 0], original[:, 1]] = sprite_color\n\n    bg_count = int(np.count_nonzero(inp == bg))\n    if bg_count <= int(np.count_nonzero(inp == divider_color)):\n        return None\n","exit_code":0,"status":"completed"}}
