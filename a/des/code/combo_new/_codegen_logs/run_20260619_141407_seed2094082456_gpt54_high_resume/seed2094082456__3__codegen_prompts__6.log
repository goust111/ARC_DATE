{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom itertools import product\nX,Y=0,1\nfor rr in range(2,7):\n  for cc in range(2,7):\n    ok=[]\n    for rows in product([X,Y], repeat=rr-1):\n      for cols in product([X,Y], repeat=cc-1):\n        winners=set()\n        valid=True\n        for i in range(rr):\n          for j in range(cc):\n            sides=[]\n            if i>0: sides.append(rows[i-1])\n            if i<rr-1: sides.append(rows[i])\n            if j>0: sides.append(cols[j-1])\n            if j<cc-1: sides.append(cols[j])\n            sx=sum(1 if x==X else -1 for x in sides)\n            if sx==0:\n              valid=False\n              break\n            winners.add(X if sx>0 else Y)\n          if not valid: break\n        if valid and len(winners)==2:\n          ok.append((rows,cols))\n          break\n      if ok: break\n    if ok:\n      print('rr,cc',rr,cc,'example',ok[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
