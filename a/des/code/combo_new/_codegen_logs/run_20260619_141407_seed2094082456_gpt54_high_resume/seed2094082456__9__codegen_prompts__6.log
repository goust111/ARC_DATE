{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e4888269.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor every target pixel by following the ordered two-column substitution legend.\n\n    Input structure\n    - A dominant background surrounds one multicolor vertical legend: a connected,\n      fully filled two-column block with one color pair per row.\n    - Other non-background pixels or objects are the targets; divider or frame\n      pixels are ordinary target-side structure that remain unchanged unless their\n      color is rewritten by the legend.\n\n    Rule\n    - Read the legend rows from top to bottom as substitutions from the left\n      column color to the right column color.\n    - For each non-background pixel outside the legend, scan those rows in order;\n      whenever the current color equals the row's left color, replace it with the\n      row's right color and keep scanning lower rows.\n    - Leave the legend itself and background pixels unchanged.\n\n    Key insight\n    - The same color may be rewritten multiple times, but only by substitutions\n      that appear later in the vertical legend, so the row order is part of the\n      symbol instruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    r0, c0, r1, c1 = _legend_bbox(g, bg)\n    separator_lines = _full_separator_lines(g, bg, (r0, c0, r1, c1))\n    assert len(separator_lines) <= 1, \"expected at most one full separator line\"\n    assert all(_line_separates_targets(g, bg, (r0, c0, r1, c1), line) for line in separator_lines)\n    pairs = [(int(g[r, c0]), int(g[r, c1])) for r in range(r0, r1 + 1)]\n\n    legend_mask = np.zeros(g.shape, dtype=bool)\n    legend_mask[r0 : r1 + 1, c0 : c1 + 1] = True\n\n    out = g.copy()\n    targets = np.argwhere((g != bg) & (~legend_mask))\n    for r, c in targets:\n        color = int(g[r, c])\n        for src, dst in pairs:\n            if color == src:\n                color = dst\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (10, 30)\nGRID_WIDTH_BOUNDS = (13, 30)\nCOLOR_VALUES = tuple(range(10))\nPALETTE_SIZE_BOUNDS = (5, 8)\n\n# Legend construction and chain constraints.\nLEGEND_WIDTH = 2\nLEGEND_ROW_CHOICES = (3, 4, 5, 6, 7)\nLEGEND_ROW_WEIGHTS = (1, 2, 2, 3, 4)\nMIN_LEGEND_COLORS = 3\nPAIR_BUILD_RETRIES = 100\nCHAIN_THREE_MIN_ROWS = 4\nCHAIN_THREE_PROB = 0.75\nMIN_CHAIN_STEPS = 2\n\n# Blob shape sampling.\nSINGLE_PIXEL_PROB = 0.45\nBLOB_HEIGHT_BOUNDS = (1, 3)\nBLOB_WIDTH_BOUNDS = (1, 4)\nBLOB_DENSITY = 0.7\n\n# Layout and placement controls.\nLEGEND_BORDER = 1\nLEGEND_PADDING = 1\nDIVIDER_PROB = 0.85\nDIVIDER_TARGET_MIN_SPAN = 3\nTARGET_COUNT_BOUNDS = (5, 14)\nTARGET_MULTI_STEP_PROB = 0.65\nTARGET_ONE_STEP_PROB = 0.85\nMIN_PLACED_TARGETS = 3\n\n# Retry limits.\nGEN_ATTEMPTS = 300\n\n\ndef _gen_apply_chain(color: int, pairs: list[tuple[int, int]]) -> int:\n","exit_code":0,"status":"completed"}}
