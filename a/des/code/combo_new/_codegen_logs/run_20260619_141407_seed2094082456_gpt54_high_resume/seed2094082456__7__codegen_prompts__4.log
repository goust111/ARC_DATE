"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:372:    \"\"\"Grow irregular blob regions around each hole seed. Returns the full forbidden set.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:402:    \"\"\"Find the nearest non-forbidden cell to the canvas center.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:416:    \"\"\"Grow a random connected blob of target area, avoiding forbidden cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:437:    \"\"\"Seal gaps around forbidden cells and keep only the largest connected component.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:458:    \"\"\"Crop mask to tight bbox (including forbidden cells), validate shape and holes.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:477:    \"\"\"Generate a random amorphous grey sprite with the specified number of holes.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:503:    \"\"\"Build a shuffled list of (hole_count, color_or_None) for all sprites to generate.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:529:    \"\"\"8-connectivity dilation of a boolean mask (1-cell padding in all directions).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:536:    \"\"\"Find a random valid placement for sprite, avoiding blocked and occupied areas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:557:    \"\"\"Generate and place all sprites (matches + distractors) onto the grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:583:    \"\"\"Single attempt: build layout, place sprites, validate via oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/e3721c99.py:600:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/6e453dd6.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n\n\ndef _symmetric_body(area):\n    choices = []\n    for height in _inclusive_range(_BODY_HEIGHT_RANGE):\n        extra = area - height\n        if extra >= 2 and extra % 2 == 0 and extra // 2 <= height:\n            choices.append((height, extra // 2))\n    if not choices:\n        return _grow_body(area)\n\n    height, pair_count = random.choice(choices)\n    cells = {(r, 1) for r in range(height)}\n    rows = list(range(height))\n    random.shuffle(rows)\n    for r in rows[:pair_count]:\n        cells.add((r, 0))\n        cells.add((r, 2))\n\n    if height >= _SYMMETRIC_TRANSPOSE_MIN_HEIGHT and random.random() < _SYMMETRIC_TRANSPOSE_PROB:\n\n=====NEXT=====\nimport numpy as np\n\nfrom arc_utils import components_mask, paste\nimport random\n\n\ndef _components4(mask):\n    return components_mask(mask, connectivity=4)\n\n\ndef _find_separator_col(g: np.ndarray, sep_color: int = 5) -> int:\n    _, w = g.shape\n    cols = [c for c in range(w) if np.all(g[:, c] == sep_color)]\n    assert len(cols) == 1, f\"expected a unique full separator column, got {cols}\"\n    return int(cols[0])\n\n\ndef _background_color(g: np.ndarray, sep_col: int, sep_color: int = 5) -> int:\n    h, w = g.shape\n    border = []\n    for c in range(w):\n        if c != sep_col and g[0, c] != sep_color:\n            border.append(int(g[0, c]))\n        if c != sep_col and g[h - 1, c] != sep_color:\n            border.append(int(g[h - 1, c]))\n    for r in range(h):\n        if g[r, 0] != sep_color:\n            border.append(int(g[r, 0]))\n        if g[r, w - 1] != sep_color:\n            border.append(int(g[r, w - 1]))\n    assert border, \"expected non-separator border pixels to infer the background\"\n    vals, counts = np.unique(np.array(border, dtype=int), return_counts=True)\n    winners = vals[counts == counts.max()]\n    assert len(winners) == 1, f\"background color must be unique on the border, got {winners.tolist()}\"\n    return int(winners[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.\n\n    Input structure:\n    - A vertical grey (5) separator column divides the grid into left and right halves.\n    - Black shapes sit on the left side against a background color (bg).\n\n    Rule:\n    - Translate each black connected component rightward until its right edge is flush with the separator.\n    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.\n    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.\n\n    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as \"nozzles\" projecting rightward.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    sep_color = 5\n    black = 0\n    red = 2\n\n    sep = _find_separator_col(g, sep_color=sep_color)\n    bg = _background_color(g, sep_col=sep, sep_color=sep_color)\n\n    out = g.copy()\n\n    # Step 1: move black components on the left so that their right edge touches the separator.\n    left = out[:, :sep].copy()\n    left_mask = left == black\n    comps = _components4(left_mask)\n\n    # Clear old black pixels (leave other colors intact).\n    left[left == black] = bg\n\n    target_right = sep - 1  # last column in left side, adjacent to separator\n    for comp in comps:\n        max_c = max(c for _, c in comp)\n        delta = target_right - max_c\n        assert delta >= 0, \"left-side components must stay left of the separator\"\n        for r, c in comp:\n            nc = c + delta\n            assert 0 <= nc < sep, f\"shifted pixel {(r, c)} left the pane\"\n            left[r, nc] = black\n\n    out[:, :sep] = left\n\n    # Step 2: find enclosed background regions (holes) on the left.\n    # A hole is a bg component not touching the left subgrid boundary.\n    holes = []\n    for pts in _components4(left == bg):\n        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):\n            continue\n        holes.append(pts)\n\n    # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),\n    # emit a red ray on the right side for each row containing hole pixels.\n    trigger_col = sep - 2\n    trigger_rows = []\n    for pts in holes:\n        if not any(c == trigger_col for _, c in pts):\n            continue\n        trigger_rows.extend(sorted(set(r for r, _ in pts)))\n    assert len(trigger_rows) == len(set(trigger_rows)), f\"trigger rows must be unique, got {trigger_rows}\"\n    for r in trigger_rows:\n        assert np.all(out[r, sep + 1 :] == bg), f\"right half of row {r} must be background before ray emission\"\n        out[r, sep + 1 :] = red\n\n    return out\n\n# --------------- generator (att4) ---------------\n\n# ── Colors ──\nBG = 6       # magenta background\nBLACK = 0    # sprite color\nRED = 2      # ray color\nSEP_COLOR = 5  # grey separator\n\n# ── Grid dimensions ──\nH_MIN, H_MAX = 16, 25\nW_MIN, W_MAX = 10, 16\nSEP_MIN, SEP_MAX = 5, 11       # separator column range\nRIGHT_W_MIN, RIGHT_W_MAX = 2, 4  # right-side width range\n\n# ── Sprite constraints ──\nN_SPRITES_MIN, N_SPRITES_MAX = 2, 5\nSPRITE_H_MAX = 8               # max sprite bbox height\nSPRITE_W_MAX = 6               # max sprite bbox width\nMIN_BAND_GAP = 1               # min bg rows between sprite bands\n\n# ── Probabilities ──\nSPLIT_PROB = 0.4                # emitter: probability of split (mini+main) layout\nEXTRA_EMITTERS_PROB = 0.25      # chance to add more emitters beyond the minimum\nFLUSH_PROB = 0.35               # chance one input sprite stays flush with separator\n\n# ── Retry budget ──\nMAX_RETRIES = 300\n\n\ndef _scatter(total, slots):\n    \"\"\"Distribute *total* units randomly into *slots* bins.\"\"\"\n    vals = [0] * slots\n    for _ in range(total):\n        vals[random.randrange(slots)] += 1\n    return vals\n\n\ndef _min_emitters_for(n):\n    \"\"\"Minimum emitter count to satisfy >=60% emitter fraction for *n* sprites.\"\"\"\n    return (3 * n + 4) // 5\n\n\ndef _min_rows_needed(n_emitters, n_total):\n    \"\"\"Minimum grid rows to fit *n_total* sprites with *n_emitters* emitters.\"\"\"\n    return n_emitters * 3 + (n_total - n_emitters) * 2 + (n_total - 1) + 2\n\n\ndef _sprite_bands(h, is_emitter):\n    \"\"\"Partition grid rows into disjoint vertical bands for each sprite.\n\n    Returns list of (row_start, height) or None if they don't fit.\n    \"\"\"\n    n = len(is_emitter)\n    min_heights = [3 if e else 2 for e in is_emitter]\n    base_gaps = [MIN_BAND_GAP] * (n + 1)\n    height_cap = h - sum(base_gaps)\n    if sum(min_heights) > height_cap:\n        return None\n\n    heights = min_heights[:]\n    extra_cap = sum(SPRITE_H_MAX - x for x in heights)\n    extra = random.randint(0, min(extra_cap, height_cap - sum(heights)))\n    for _ in range(extra):\n        choices = [i for i, x in enumerate(heights) if x < SPRITE_H_MAX]\n        i = random.choice(choices)\n        heights[i] += 1\n\n    gaps = [a + b for a, b in zip(base_gaps, _scatter(h - sum(heights) - sum(base_gaps), n + 1))]\n    bands = []\n    r = gaps[0]\n    for i, sh in enumerate(heights):\n        bands.append((r, sh))\n        r += sh + gaps[i + 1]\n    return bands\n\n\ndef _emitter_patch(sh, max_sw):\n    \"\"\"Build an emitter sprite patch: a closed shell with an interior hole at the right edge.\"\"\"\n    hole_w = random.choice([1, 2]) if max_sw >= 4 else 1\n    sw = random.randint(hole_w + 2, max_sw)\n    patch = np.full((sh, sw), BG, dtype=int)\n\n    right_wall = sw - 1\n    left_wall = sw - hole_w - 2\n\n    # Optionally split into a narrower mini section + main section,\n    # creating a non-triggering hole in the mini part.\n    right_shift = random.randint(1, max(1, sw - 3))\n    mini_w = sw - right_shift\n    can_split = sh >= 5 and mini_w >= 3 and right_shift >= 1\n    if can_split and random.random() < SPLIT_PROB:\n        _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w)\n    else:\n        patch[0, :] = BLACK\n        patch[-1, :] = BLACK\n        patch[1:-1, left_wall] = BLACK\n        patch[1:-1, right_wall] = BLACK\n    return patch\n\n\ndef _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w):\n    \"\"\"Fill *patch* in-place with a split emitter (mini section + main section).\"\"\"\n    place_top = random.random() < 0.5\n    mini_h = random.randint(3, min(4, sh - 2))\n    main_h = sh - mini_h + 1  # +1 for shared connection row\n    if place_top:\n        # Top = mini (narrower), bottom = main (full width)\n        patch[0, :mini_w] = BLACK\n        for r in range(mini_h):\n            patch[r, 0] = BLACK\n            patch[r, mini_w - 1] = BLACK\n        patch[mini_h - 1, :] = BLACK  # connection row\n        patch[-1, :] = BLACK\n        for r in range(mini_h, sh):\n            patch[r, left_wall] = BLACK\n            patch[r, right_wall] = BLACK\n    else:\n        # Top = main (full width), bottom = mini (narrower)\n        patch[0, :] = BLACK\n        for r in range(main_h - 1):\n            patch[r, left_wall] = BLACK\n            patch[r, right_wall] = BLACK\n        patch[main_h - 1, :] = BLACK  # connection row\n        patch[-1, :mini_w] = BLACK\n        for r in range(main_h, sh):\n            patch[r, 0] = BLACK\n            patch[r, mini_w - 1] = BLACK\n\n\ndef _distractor_patch(sh, max_sw):\n    \"\"\"Build a non-emitter distractor sprite (C-shape, L-shape, or solid block).\"\"\"\n    choices = [\"l_shape\"]\n    if sh >= 3 and max_sw >= 3:\n        choices.extend([\"c_left\", \"c_right\"])\n    if sh <= 3:\n        choices.append(\"solid\")\n    kind = random.choice(choices)\n\n    if kind == \"solid\":\n        sw = random.randint(2, min(3, max_sw))\n        return np.full((sh, sw), BLACK, dtype=int)\n\n    min_sw = 3 if kind.startswith(\"c_\") or sh == 2 else 2\n    sw = random.randint(min_sw, max_sw)\n    patch = np.full((sh, sw), BG, dtype=int)\n    if kind == \"c_left\":\n        patch[0, :] = BLACK\n        patch[-1, :] = BLACK\n        patch[:, -1] = BLACK\n    elif kind == \"c_right\":\n        patch[0, :] = BLACK\n        patch[-1, :] = BLACK\n        patch[:, 0] = BLACK\n    else:\n\n=====NEXT=====\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _hole_count(mask: np.ndarray) -> int:\n    \"\"\"\n    Count holes in a binary mask using 4-connectivity.\n    A hole is a background component that does not touch the mask's bounding box border.\n    \"\"\"\n    h, w = mask.shape\n    bg = ~mask\n    vis = np.zeros((h, w), dtype=bool)\n    holes = 0\n    for r0 in range(h):\n        for c0 in range(w):\n            if not bg[r0, c0] or vis[r0, c0]:\n                continue\n            st = [(r0, c0)]\n            vis[r0, c0] = True\n            touches = False\n            while st:\n                r, c = st.pop()\n                if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n                    touches = True\n                for rr, cc in neighbors4(r, c):\n                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:\n                        vis[rr, cc] = True\n                        st.append((rr, cc))\n            if not touches:\n                holes += 1\n    return holes\n\n\ndef _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:\n    \"\"\"\n    Pick one 'legend' component per non-(bg,grey) color:\n      - component is at least 2x2,\n      - component does not touch the outer grid border (filters dividers).\n    Map hole_count -> legend_color.\n    \"\"\"\n    h, w = g.shape\n    mapping: dict[int, int] = {}\n    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]\n    for c in colors:\n        comps = components_mask(g == c, connectivity=4)\n        candidates = []\n        for pts in comps:\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n                continue\n            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:\n                continue\n            candidates.append((r0, c0, r1, c1))\n        if not candidates:\n            continue\n        assert len(candidates) == 1, f\"color {c} must have exactly one legend component\"\n        r0, c0, r1, c1 = candidates[0]\n        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)\n        hc = _hole_count(sub)\n        assert hc not in mapping, f\"legend hole count {hc} must map to exactly one color\"\n        mapping[hc] = c\n    return mapping\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor grey shapes by matching their hole count to a color legend.\n\n    Input structure:\n    - bg = most common color; grey (5) sprites scattered across the grid.\n    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n      each with a distinct number of enclosed holes.\n\n    Rule:\n    - Each colored legend shape defines a mapping: hole count → color.\n    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n\n    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    grey = 5\n\n    legend = _legend_mapping(g, bg, grey)\n    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n\n    out = g.copy()\n    for pts in components_mask(g == grey, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts)\n        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n        for r, c in pts:\n            sub[r - r0, c - c0] = True\n        hc = _hole_count(sub)\n        newc = int(legend[hc]) if hc in legend else bg\n        for r, c in pts:\n            out[r, c] = newc\n\n    return out\n\n# --------------- generator (holes-first organic blob) ---------------\n\nfrom arc_utils import label_mask\nfrom scipy.ndimage import binary_dilation, generate_binary_structure\n\n# -- palette & grid --\nBG = 0\nDIV = 1\nGREY = 5\nGRID_SIZE = 30\nLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n\n# -- legend panel --\nLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\nMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\nPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\nFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\nL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\nL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n\n# -- sprites --\nTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\nMAX_DISTRACTORS = 7                 # max distractor sprites\nMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\nSPRITE_RETRIES = 30                 # retries per sprite generation attempt\nSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\nSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n# 3+ hole sprites: min = 10+2*h, max = 20+4*h\nCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\nCANVAS_MIN = 5                      # minimum canvas dimension\nCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\nHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\nHOLE_SEED_MIN_RADIUS = 2\nHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\nHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\nSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\nSPRITE_MAX_H = 12                   # max sprite bbox height\nSPRITE_MAX_W = 18                   # max sprite bbox width\nSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n\n# -- generation --\nGEN_RETRIES = 300                   # outer retries for generate_input()\n\n# 8-connectivity structuring element for dilation\n_STRUCT8 = generate_binary_structure(2, 2)\n\n\n# ---------- legend helpers ----------\n\ndef _legend_span(hole_count: int) -> int:\n    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n    return 3 if hole_count == 0 else 2 * hole_count + 1\n\n\ndef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n    span = _legend_span(hole_count)\n    if arrangement == \"horizontal\":\n        patch = np.full((3, span), int(color), dtype=int)\n        if hole_count:\n            patch[1, 1::2] = BG\n    else:\n        patch = np.full((span, 3), int(color), dtype=int)\n        if hole_count:\n            patch[1::2, 1] = BG\n    return patch\n\n\ndef _line_span(legends: list[tuple[int, int]]) -> int:\n    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n\n\ndef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n    count = random.randint(*LEGEND_COUNT_RANGE)\n    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n    if not combos:\n        return _choose_legends(arrangement, max_span + 2)\n    holes = list(random.choice(combos))\n    random.shuffle(holes)\n    colors = random.sample(LEGEND_COLORS, count)\n    return list(zip(holes, colors))\n\n\ndef _place_legend_line(\n    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n) -> None:\n    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n    rr, cc = int(r), int(c)\n    for hole_count, color in legends:\n        patch = _legend_patch(hole_count, color, arrangement)\n        paste(grid, patch, rr, cc)\n        if arrangement == \"horizontal\":\n            cc += patch.shape[1] + 1\n        else:\n            rr += patch.shape[0] + 1\n\n\n# ---------- layout helpers ----------\n\ndef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_h = random.randint(*PANEL_SIZE_RANGE)\n    top = random.choice([True, False])\n    c0 = random.randint(1, GRID_SIZE - 1 - total)\n    if top:\n        div_r = panel_h\n        grid[div_r, :] = DIV\n        blocked[: div_r + 1, :] = 9\n        r0 = random.randint(1, panel_h - 4)\n    else:\n        div_r = GRID_SIZE - 1 - panel_h\n        grid[div_r, :] = DIV\n        blocked[div_r:, :] = 9\n        r0 = random.randint(div_r + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"horizontal\", r0, c0)\n    return legends\n\n\ndef _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-column vertical divider with legend panel left or right.\"\"\"\n    legends = _choose_legends(\"vertical\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_w = random.randint(*PANEL_SIZE_RANGE)\n    left = random.choice([True, False])\n    r0 = random.randint(1, GRID_SIZE - 1 - total)\n    if left:\n        div_c = panel_w\n        grid[:, div_c] = DIV\n        blocked[:, : div_c + 1] = 9\n        c0 = random.randint(1, panel_w - 4)\n    else:\n        div_c = GRID_SIZE - 1 - panel_w\n        grid[:, div_c] = DIV\n        blocked[:, div_c:] = 9\n        c0 = random.randint(div_c + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"vertical\", r0, c0)\n    return legends\n\n\ndef _l_corner_geometry(corner: str, panel_h: int, panel_w: int,\n                       arrangement: str, total: int) -> tuple:\n    \"\"\"Compute divider pivot and legend placement bounds for an L-corner.\n\n    Returns (dr, dc, r_min, r_max, c_min, c_max) where (dr, dc) is the corner\n    pivot of the L-divider and the remaining values bound the legend origin.\n    \"\"\"\n    N = GRID_SIZE\n    cross_dim = 3 if arrangement == \"horizontal\" else total\n    along_dim = total if arrangement == \"horizontal\" else 3\n\n    if corner == \"tl\":\n        dr, dc = panel_h, panel_w\n\n=====NEXT=====\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n\n    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n    random.shuffle(tasks)\n\n    grid = np.zeros((sz, sz), dtype=int)\n    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n\n    placements = _place_objects(sz, tasks, legend_box)\n    if placements is None:\n        return None\n\n    inp, output = _render_output(grid, placements)\n    if _matches_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py && printf '\\\\n=====NEXT=====\\\\n' && sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n\n=====NEXT=====\nfrom __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, get_bg, paste\nimport random\nfrom itertools import product\n\n\ndef _unique_largest_non_bg_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(map(int, g.flatten()))\n    non_bg_counts = [(color, count) for color, count in counts.items() if color != int(bg)]\n    assert non_bg_counts\n\n    largest_count = max(count for _color, count in non_bg_counts)\n    candidates = [color for color, count in non_bg_counts if count == largest_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _mask_bbox(g: np.ndarray, mask_color: int) -> tuple[int, int, int, int]:\n    mask = g == int(mask_color)\n    comps = components_mask(mask, connectivity=4)\n    assert len(comps) == 1\n\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _palette(g: np.ndarray, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n    palette_mask = (g != int(bg)) & (g != int(mask_color))\n    b = bbox(palette_mask)\n    assert b is not None\n\n    palette = crop_bbox(g, b)\n    assert palette.shape == (3, int(width))\n    assert bool(np.all(palette != int(bg)))\n    assert bool(np.all(palette != int(mask_color)))\n    assert bool(np.array_equal(palette[0], palette[1]))\n    assert len(set(map(int, palette[2]))) == 1\n\n    column_colors = palette[0].copy()\n    hole_color = int(palette[2, 0])\n    return column_colors, hole_color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n    else:\n        mask_r = top\n        palette_r = top + int(mask_h) + int(gap)\n    mask_c = random.randint(0, int(grid_w) - int(mask_w))\n    palette_c = random.randint(0, int(grid_w) - int(mask_w))\n    paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)\n    paste(grid, palette, palette_r, palette_c, transparent=None)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    dims = _sample_dimensions()\n    if dims is None:\n        return None\n    mask_h, mask_w, gap, grid_h, grid_w = dims\n\n    column_colors, hole_color = _sample_palette(mask_w)\n    area = int(mask_h) * int(mask_w)\n    min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n    max_area = int(np.floor(MASK_DENSITY_MAX * area))\n\n=====NEXT=====\nfrom __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Highlight black defects in blue foreground by surrounding them with orange.\n\n    Input structure:\n    - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.\n\n    Rule:\n    - Thin blue pixels mostly surrounded by black are absorbed into the background.\n    - Small black components (≤3 cells) and leaf pixels of larger black components are \"defects.\"\n    - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.\n\n    Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    hole_col = 0\n    border_col = 7\n\n    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.\n    base = g.copy()\n    for r in range(H):\n        for c in range(W):\n            if int(base[r, c]) != 1:\n                continue\n            nb = 0\n            oob = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if not (0 <= rr < H and 0 <= cc < W):\n                    oob += 1\n                    continue\n                if int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            # only count outside-as-black for corners (two out-of-bounds sides)\n            if oob >= 2:\n                nb += int(oob)\n            if nb >= 3:\n                base[int(r), int(c)] = int(hole_col)\n\n    # STEP 1/2) Collect target black pixels (they must remain black).\n    preserve: set[tuple[int, int]] = set()\n    comps = components_mask(base == int(hole_col), connectivity=4)\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        if len(pts_list) <= 3:\n            preserve.update(pts_list)\n            continue\n        for r, c in pts_list:\n            nb = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            if nb <= 1:\n                preserve.add((int(r), int(c)))\n\n    # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.\n    out = base.copy()\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]\n        for r, c in targets:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    rr = int(r + dr)\n                    cc = int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:\n                        out[rr, cc] = int(border_col)\n\n    # Ensure target black pixels remain black.\n    for r, c in preserve:\n        out[int(r), int(c)] = int(hole_col)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (16, 19)           # canvas height bounds\nGRID_W_RANGE = (16, 19)           # canvas width bounds\nMIN_BLUE_REGION = 30              # minimum blue region size (cells)\nMIN_BLACK_REGION = 20             # minimum black region size (cells)\nPARTITION_STYLES = ['h_stripes', 'rect_inset', 'l_shape']\nSTRIPE_CUTS_RANGE = (1, 3)       # number of horizontal cuts for h_stripes\nCUT_MARGIN = 3                   # min distance from grid edge for cuts\nINSET_MARGIN = 2                 # padding from edge for rect_inset\nINNER_INSET_MIN_GAP = 6          # min dimension for nested inset\nINNER_INSET_PROB = 0.5           # probability of nested inset\nDEFECT_COUNT_RANGE = (2, 9)      # number of defect holes to place\nDEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]\nDEFECT_CLEARANCE = 2             # min Chebyshev distance between defects\nDEFECT_PLACE_TRIES = 50          # retries per defect placement\nLEAF_COUNT_RANGE = (0, 4)        # number of leaf protrusions\nSPUR_COUNT_RANGE = (2, 6)        # number of blue spurs in black regions\nMIN_DEFECTS = 2                  # reject grid if fewer defects placed\nMIN_SPURS = 2                    # reject grid if fewer spurs placed\nMAX_GEN_ATTEMPTS = 300           # outer retry limit\n\n\ndef _nearby(r: int, c: int, dist: int, ref: set) -> bool:\n    \"\"\"Return True if any pixel in `ref` is within Chebyshev distance `dist`.\"\"\"\n    for dr in range(-dist, dist + 1):\n        for dc in range(-dist, dist + 1):\n            if (r + dr, c + dc) in ref:\n                return True\n    return False\n\n\ndef _exclusion_zone(pixels, dist: int) -> set:\n    \"\"\"Return the set of all coords within Chebyshev `dist` of any pixel.\"\"\"\n    zone = set()\n    for r, c in pixels:\n        for dr in range(-dist, dist + 1):\n            for dc in range(-dist, dist + 1):\n                zone.add((r + dr, c + dc))\n    return zone\n\n\ndef _build_partition(H: int, W: int) -> np.ndarray:\n    \"\"\"Create an H x W grid partitioned into blue (1) and black (0) regions.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    style = random.choice(PARTITION_STYLES)\n\n    if style == 'h_stripes':\n        n_cuts = random.randint(*STRIPE_CUTS_RANGE)\n        cuts = sorted(random.sample(\n            range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))\n        boundaries = [0] + cuts + [H]\n        first_color = random.randint(0, 1)\n        for i in range(len(boundaries) - 1):\n            grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2\n\n    elif style == 'rect_inset':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        r0 = random.randint(INSET_MARGIN, H // 3)\n        r1 = random.randint(2 * H // 3, H - CUT_MARGIN)\n        c0 = random.randint(INSET_MARGIN, W // 3)\n        c1 = random.randint(2 * W // 3, W - CUT_MARGIN)\n        grid[r0:r1 + 1, c0:c1 + 1] = 1 - bg\n        if (r1 - r0 > INNER_INSET_MIN_GAP and c1 - c0 > INNER_INSET_MIN_GAP\n                and random.random() < INNER_INSET_PROB):\n            ir0 = random.randint(r0 + 2, r0 + (r1 - r0) // 3)\n            ir1 = random.randint(r0 + 2 * (r1 - r0) // 3, r1 - 2)\n            ic0 = random.randint(c0 + 2, c0 + (c1 - c0) // 3)\n            ic1 = random.randint(c0 + 2 * (c1 - c0) // 3, c1 - 2)\n            grid[ir0:ir1 + 1, ic0:ic1 + 1] = bg\n\n    elif style == 'l_shape':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        vc = random.randint(W // 3, 2 * W // 3)\n        if random.random() < 0.5:\n            grid[:, :vc] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[:hc, vc:] = 1 - bg\n        else:\n            grid[:, vc:] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[hc:, :vc] = 1 - bg\n\n    return grid\n\n\ndef _find_interior_blue(grid: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return blue pixels whose 4-neighbors are all blue or out-of-bounds.\"\"\"\n    H, W = grid.shape\n    blue = grid == 1\n    # A blue pixel is interior if no in-bounds 4-neighbor is non-blue.\n    eroded = blue.copy()\n    eroded[:-1, :] &= blue[1:, :]   # neighbor below\n    eroded[1:, :]  &= blue[:-1, :]  # neighbor above\n    eroded[:, :-1] &= blue[:, 1:]   # neighbor right\n    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left\n    rs, cs = np.where(eroded)\n    coords = list(zip(rs.tolist(), cs.tolist()))\n    random.shuffle(coords)\n    return coords\n\n\ndef _place_defects(grid: np.ndarray, interior_blue: list) -> tuple[set, int]:\n    \"\"\"Place 2-9 small black defects in blue-region interiors.\n\n    Returns (defect_pixels, defects_placed). Modifies `interior_blue` in place.\n    \"\"\"\n    H, W = grid.shape\n    n_defects = random.randint(*DEFECT_COUNT_RANGE)\n    defect_pixels: set[tuple[int, int]] = set()\n    interior_set = set(interior_blue)\n    defects_placed = 0\n\n    for _ in range(n_defects):\n        if not interior_blue:\n            break\n        defect_size = random.choices([1, 2, 3], weights=DEFECT_SIZE_WEIGHTS)[0]\n\n        placed = False\n        for _try in range(DEFECT_PLACE_TRIES):\n            if not interior_blue:\n                break\n            seed_r, seed_c = interior_blue[random.randint(0, len(interior_blue) - 1)]\n\n            if _nearby(seed_r, seed_c, DEFECT_CLEARANCE, defect_pixels):\n                continue\n\n            # Grow defect from seed\n            defect = [(seed_r, seed_c)]\n            if defect_size > 1:\n                dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n                random.shuffle(dirs)\n                for dr, dc in dirs:\n                    nr, nc = seed_r + dr, seed_c + dc\n                    if (nr, nc) not in interior_set or (nr, nc) in defect_pixels:\n                        continue\n                    # Check neighbor is surrounded by blue (except the seed)\n                    ok = True\n                    for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        rr, cc = nr + dr2, nc + dc2\n                        if (rr, cc) == (seed_r, seed_c):\n                            continue\n                        if 0 <= rr < H and 0 <= cc < W:\n                            if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:\n                                ok = False\n                                break\n                    if ok and not _nearby(nr, nc, DEFECT_CLEARANCE, defect_pixels):\n                        defect.append((nr, nc))\n                        if len(defect) >= defect_size:\n                            break\n\n            # Validate: every non-defect 4-neighbor of every defect pixel must be blue\n            defect_set = set(defect)\n            valid = True\n            for r, c in defect:\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if (rr, cc) in defect_set:\n                        continue\n                    if 0 <= rr < H and 0 <= cc < W:\n                        if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:\n                            valid = False\n                            break\n                if not valid:\n                    break\n\n            if valid:\n                defect_pixels.update(defect)\n                defects_placed += 1\n                placed = True\n                remove = _exclusion_zone(defect, DEFECT_CLEARANCE)\n                interior_blue[:] = [p for p in interior_blue if p not in remove]\n                interior_set -= remove\n\n=====NEXT=====\nfrom __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask, find_components, get_bg\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n\n    Input structure:\n    - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n    - Several smaller colored sprites scattered around the bar.\n\n    Rule:\n    - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n    - The root defines a strip (column-span or row-span) for its chain.\n    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n    - Multiple chains grow independently from different bar notches.\n\n    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    bg = get_bg(g)\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    comps.sort(key=lambda d: -d[\"area\"])\n    assert comps\n\n    bar = comps[0]\n    pieces_raw = comps[1:]\n\n    out = np.full((H, W), int(bg), dtype=int)\n    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_color = int(bar[\"color\"])\n    bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_occ:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for r, c in bar_occ:\n        out[r, c] = bar_color\n\n    def shape_from_coords(coords: np.ndarray, bbox):\n        r0, c0, r1, c1 = map(int, bbox)\n        h, w = r1 - r0 + 1, c1 - c0 + 1\n        rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n        rel_set = set(rel)\n        return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n\n    pieces = []\n    for p in pieces_raw:\n        # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n        r0, c0 = map(int, p[\"bbox\"][:2])\n        pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n\n    def bar_notches(bar_mask, bar_r0, bar_c0):\n        empty = ~bar_mask\n        h, w = map(int, empty.shape)\n        notches = []\n        for pts in components_mask(empty, connectivity=4):\n            r = pts[:, 0]\n            c = pts[:, 1]\n            top = int((r == 0).sum())\n            bottom = int((r == h - 1).sum())\n            left = int((c == 0).sum())\n            right = int((c == w - 1).sum())\n\n            # Keep only holes that open to the bar bbox boundary.\n            if top + bottom + left + right == 0:\n                continue\n\n            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n\n            # Axis is determined by which bbox side has the widest mouth.\n            side, mouth_n = max(\n                [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n                key=lambda x: x[1],\n            )\n            axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n            notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n        return notches\n\n    notches = bar_notches(bar_mask, bar_r0, bar_c0)\n\n    def pixels(v, top, left):\n        return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n\n    def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n        if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n            return None\n        if strip is not None:\n            axis, A, B = strip\n            if axis == \"cols\":\n                if left != A or v[\"w\"] != B - A + 1:\n                    return None\n            else:\n                if top != A or v[\"h\"] != B - A + 1:\n                    return None\n        pts = pixels(v, top, left)\n        if pts & occ:\n            return None\n        if must_cover is not None and not (must_cover <= pts):\n            return None\n        return pts\n\n    def aligned_positions(axis, A, cover, v):\n        if axis == \"cols\":\n            left = A\n            tops = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if cN == left + lc:\n                        tops.add(rN - lr)\n            for top in tops:\n                yield top, left\n        else:\n            top = A\n            lefts = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if rN == top + lr:\n                        lefts.add(cN - lc)\n            for left in lefts:\n                yield top, left\n\n    def touches(pts, other):\n        for r, c in pts:\n            for dr, dc in DIR4:\n                if (r + dr, c + dc) in other:\n                    return True\n        return False\n\n    def hole_positions(hole, v):\n        pos = set()\n        for rH, cH in hole:\n            for lr, lc in v[\"rel\"]:\n                pos.add((rH - lr, cH - lc))\n        return pos\n\n    # Root candidates: fill the bar hole (no strip constraint yet).\n    root_cands = []\n    for ni, n in enumerate(notches):\n        axis = n[\"axis\"]\n\n        for pi, p in enumerate(pieces):\n            v = p[\"shape\"]\n            for top, left in hole_positions(n[\"hole\"], v):\n                pts = placement_pts(v, top, left, bar_occ, must_cover=n[\"hole\"])\n                if pts is None:\n                    continue\n                if axis == \"cols\":\n                    A, B = int(left), int(left + v[\"w\"] - 1)\n                else:\n                    A, B = int(top), int(top + v[\"h\"] - 1)\n                mv = abs(int(top) - int(p[\"orig\"][0])) + abs(int(left) - int(p[\"orig\"][1]))\n                root_cands.append(\n                    (\n                        (int(mv), -int(n[\"mouth_n\"])),\n                        {\"ni\": ni, \"pi\": pi, \"top\": int(top), \"left\": int(left), \"axis\": axis, \"A\": A, \"B\": B, \"shape\": v},\n                    )\n                )\n\n    root_cands.sort(key=lambda x: x[0])\n    cand_roots = [pair[1] for pair in root_cands[:20]]\n\n    best_out = out.copy()\n    best_key = None\n\n    def search(out_grid, occ_set, chains, remaining):\n        nonlocal best_out, best_key\n        placed_cnt = len(pieces) - len(remaining)\n        key = (placed_cnt, -len(remaining), -len(occ_set))\n        if best_key is None or key > best_key:\n            best_key = key\n            best_out = out_grid.copy()\n        if not remaining:\n            return True\n\n        def gen_extend_moves(chain, remaining_set):\n            axis = chain[\"axis\"]\n            A, B = int(chain[\"A\"]), int(chain[\"B\"])\n            head = chain[\"head\"]\n            head_pts = pixels(head[\"shape\"], head[\"top\"], head[\"left\"])\n            head_top, head_left = int(head[\"top\"]), int(head[\"left\"])\n            head_h, head_w = int(head[\"shape\"][\"h\"]), int(head[\"shape\"][\"w\"])\n\n            cavity = {\n                (r, c)\n                for r in range(head_top, head_top + head_h)\n                for c in range(head_left, head_left + head_w)\n                if out_grid[r, c] == bg\n            }\n            if not cavity:\n                return []\n\n            moves = []\n            for pi in remaining_set:\n                v = pieces[pi][\"shape\"]\n                for top, left in aligned_positions(axis, A, cavity, v):\n                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))\n                    if pts is None:\n                        continue\n                    if not touches(pts, head_pts):\n                        continue\n                    moves.append((pi, top, left, pts, v))\n            return moves\n\n        # Try extending any chain.\n        for ch in chains:\n            moves = gen_extend_moves(ch, remaining)\n            if not moves:\n                continue\n            # small branching factor is enough for this puzzle\n            for pi, top, left, pts, v in moves[:8]:\n                # apply\n                for r, c in pts:\n                    out_grid[r, c] = int(pieces[pi][\"color\"])\n                old_head = ch[\"head\"]\n                ch[\"head\"] = {\"top\": int(top), \"left\": int(left), \"shape\": v}\n                occ2 = set(occ_set) | set(pts)\n                rem2 = set(remaining)\n                rem2.remove(pi)\n                if search(out_grid, occ2, chains, rem2):\n                    return True\n                # undo\n                ch[\"head\"] = old_head\n                for r, c in pts:\n                    out_grid[r, c] = int(bg)\n                # restore bar pixels (roots are always non-overlapping)\n                for r, c in bar_occ:\n                    out_grid[r, c] = bar_color\n        return False\n\n    # Try small root subsets (1..3) from top candidates.\n    from itertools import combinations\n\n    for k in range(1, min(3, len(cand_roots)) + 1):\n        for roots_sel in combinations(range(len(cand_roots)), k):\n            used_p = set()\n            used_n = set()\n            occ0 = set(bar_occ)\n            out0 = np.full((H, W), int(bg), dtype=int)\n            for r, c in bar_occ:\n                out0[r, c] = bar_color\n\n            chains = []\n            ok = True\n            for idx in roots_sel:\n                root = cand_roots[idx]\n                if root[\"pi\"] in used_p or root[\"ni\"] in used_n:\n                    ok = False\n                    break\n                pts = pixels(root[\"shape\"], root[\"top\"], root[\"left\"])\n                if pts & occ0:\n                    ok = False\n                    break\n                used_p.add(root[\"pi\"])\n                used_n.add(root[\"ni\"])\n","exit_code":0,"status":"completed"}}
