{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"import numpy as np\nfrom collections import deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\nfrom arc_utils import neighbors4\n\n\ndef _components(g: np.ndarray, col: int, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(g == col, connectivity=8 if conn8 else 4)]\n\n\ndef _is_straight_line(comp: list[tuple[int, int]]) -> bool:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(rs)) == 1:\n        row = rs[0]\n        cols = sorted(set(cs))\n        return cols == list(range(min(cols), max(cols) + 1))\n    if len(set(cs)) == 1:\n        col = cs[0]\n        rows = sorted(set(rs))\n        return rows == list(range(min(rows), max(rows) + 1))\n    return False\n\n\ndef _bar_endpoints(comp: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(cs)) == 1:\n        c = cs[0]\n        return (min(rs), c), (max(rs), c)\n    r = rs[0]\n    return (r, min(cs)), (r, max(cs))\n\n\ndef _touches_border(p: tuple[int, int], h: int, w: int) -> bool:\n    r, c = p\n    return r == 0 or c == 0 or r == h - 1 or c == w - 1\n\n\ndef _bfs_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    if goal not in prev:\n        return None\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _bfs_path_with_diag_filter(\n    start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray\n) -> list[tuple[int, int]] | None:\n    # Like _bfs_path but disallows diagonal steps when either orthogonal intermediate cell is also walkable.\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n\n    def can_step(r: int, c: int, nr: int, nc: int) -> bool:\n        dr = nr - r\n        dc = nc - c\n        if dr == 0 or dc == 0:\n            return True\n        # diagonal: skip if either intermediate orth cell is in the walkable set\n        mid1 = (r, c + dc)\n        mid2 = (r + dr, c)\n        if 0 <= mid1[0] < h and 0 <= mid1[1] < w and bool(walkable[mid1]):\n            return False\n        if 0 <= mid2[0] < h and 0 <= mid2[1] < w and bool(walkable[mid2]):\n            return False\n        return True\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            if not can_step(r, c, nr, nc):\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    assert goal in prev, \"BFS-with-diag-filter must reach goal\"\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _greedy_manhattan_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n\n    def md(p):\n        return abs(p[0] - goal[0]) + abs(p[1] - goal[1])\n\n    cur = start\n    path = [cur]\n    seen = {cur}\n    while cur != goal:\n        cur_md = md(cur)\n        best = None  # (md, is_diag, nr, nc)\n        for nr, nc in neighbors8(cur[0], cur[1]):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in seen:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            nmd = md(nxt)\n            if nmd >= cur_md:\n                continue\n            is_diag = 1 if (nr != cur[0] and nc != cur[1]) else 0\n            key = (nmd, is_diag, nr, nc)\n            if best is None or key < best:\n                best = key\n        if best is None:\n            return None\n        _, _, nr, nc = best\n        cur = (nr, nc)\n        path.append(cur)\n        seen.add(cur)\n    return path\n\n\ndef _segment_main_path(seg_pts: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:\n    # Extract the \"main stroke\" of the segment as a simple path.\n    #\n    # Use 4-neigh edges always. Allow diagonal edges only when they represent a true diagonal stroke,\n    # i.e. the diagonal pixels touch only at the corner (no orthogonal intermediate segment pixel),\n    # which prevents diagonal shortcuts across bends.\n    sset = set(seg_pts)\n\n    def neighbors(p: tuple[int, int]):\n        r, c = p\n        for q in neighbors4(r, c):\n            if q in sset:\n                yield q\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            # If either orthogonal intermediate cell is occupied, treat this as a bend shortcut and skip.\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            yield q\n\n    q = deque([start])\n    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}\n    dist: dict[tuple[int, int], int] = {start: 0}\n    while q:\n        cur = q.popleft()\n        for nxt in neighbors(cur):\n            if nxt in prev:\n                continue\n            prev[nxt] = cur\n            dist[nxt] = dist[cur] + 1\n            q.append(nxt)\n\n    far = max(dist.keys(), key=lambda p: (dist[p], p[0], p[1]))\n    path = []\n    cur = far\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _segment_degrees(seg_pts: list[tuple[int, int]]) -> dict[tuple[int, int], int]:\n    sset = set(seg_pts)\n    deg = {p: 0 for p in sset}\n    for r, c in sset:\n        # 4-neigh\n        for q in neighbors4(r, c):\n            if q in sset:\n                deg[(r, c)] += 1\n        # diagonals only if no orth intermediate is present\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            deg[(r, c)] += 1\n    return deg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e048c9ed.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e048c9ed.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, get_bg\nimport random\n\n\n_QUANTITY_TO_COLOR = {2: Color.BLUE, 3: Color.YELLOW, 4: Color.MAROON, 5: Color.PINK}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Add a quantity-color label in the top marker column for each horizontal bar.\n\n    Input structure\n    - The grid has a black background and one non-background marker pixel in the top row.\n    - Below the marker row, every non-empty source row contains one solid monochrome horizontal bar to the left of the marker column.\n    - Source rows are staggered every other row.\n\n    Rule\n    - Copy the input grid.\n    - For each source bar, read its quantity as the bar length.\n    - Paint the quantity color in the marker column on the same row as the bar:\n      2->1, 3->4, 4->9, 5->6.\n\n    Key insight\n    - The grey marker supplies the result column, while each bar supplies a small quantity with a fixed color code.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    assert bg == 0, \"expected black background for square-digit labels\"\n\n    marker_cols = np.flatnonzero(g[0] != bg)\n    assert len(marker_cols) == 1, \"expected exactly one top-row marker\"\n    marker_c = int(marker_cols[0])\n    assert g[0, marker_c] == Color.GREY, \"top-row marker must be grey\"\n\n    source_rows = [r for r in range(1, g.shape[0]) if np.any(g[r] != bg)]\n    assert source_rows, \"expected at least one source bar\"\n    first_source_row = source_rows[0]\n\n    out = g.copy()\n    for bar_order, r in enumerate(source_rows):\n        assert (r - first_source_row) % 2 == 0, \"source bars must follow the staggered row spacing\"\n        cols = np.flatnonzero(g[r] != bg)\n        c0, c1 = int(cols[0]), int(cols[-1])\n        expected_cols = np.arange(c0, c1 + 1)\n        assert np.array_equal(cols, expected_cols), \"source row must contain one contiguous bar\"\n        assert np.unique(g[r, c0 : c1 + 1]).size == 1, \"source bar must be monochrome\"\n        assert c1 < marker_c, \"source bar must lie to the left of the marker column\"\n        assert g[r, marker_c] == bg, \"marker-column output cell must be empty\"\n\n        bar_length = c1 - c0 + 1\n        assert 2 <= bar_length <= 5, \"bar length quantity must be 2-5\"\n        assert bar_length in _QUANTITY_TO_COLOR, \"quantity must be one of 2, 3, 4, or 5\"\n        out[r, marker_c] = _QUANTITY_TO_COLOR[bar_length]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Row/bar structure.\nBAR_COUNT_RANGE, FIRST_ROWS_SINGLE, FIRST_ROWS_MULTI = (1, 4), (2,), (1, 2)\nROW_STRIDE, BAR_LENGTHS, START_COL_RANGE = 2, (2, 3, 4, 5), (0, 2)\n# Marker/canvas placement.\nMARKER_COL_RANGE, MARKER_WEIGHTS = (2, 9), (8, 1)\nWIDTH_EXTRA_RANGE, MAX_WIDTH = (1, 8), 12\n# Colors and retry budget.\nCOLOR_RANGE, MARKER_COLOR, BG_COLOR = (1, 9), Color.GREY, 0\nMAX_ATTEMPTS = 300\n\ndef _gen_attempt() -> np.ndarray | None:\n    num_bars = random.randint(*BAR_COUNT_RANGE)\n    first_rows = FIRST_ROWS_SINGLE if num_bars == 1 else FIRST_ROWS_MULTI\n    first_src_row = random.choice(first_rows)\n    height = ROW_STRIDE * (first_src_row + num_bars - 1)\n\n    bar_lengths = random.sample(BAR_LENGTHS, k=num_bars)\n    start_cols = [random.randint(*START_COL_RANGE) for _ in range(num_bars)]\n    max_bar_end = max(c + length - 1 for c, length in zip(start_cols, bar_lengths))\n\n    marker_min = max(MARKER_COL_RANGE[0], max_bar_end + 1)\n    if marker_min > MARKER_COL_RANGE[1]:\n        return None\n    marker_choices = list(range(marker_min, MARKER_COL_RANGE[1] + 1))\n    marker_weights = [MARKER_WEIGHTS[0]] + [MARKER_WEIGHTS[1]] * (len(marker_choices) - 1)\n    marker_col = random.choices(marker_choices, weights=marker_weights, k=1)[0]\n    width = random.randint(marker_col + WIDTH_EXTRA_RANGE[0], min(MAX_WIDTH, marker_col + WIDTH_EXTRA_RANGE[1]))\n\n    grid = np.zeros((height, width), dtype=int)\n    grid[0, marker_col] = MARKER_COLOR\n\n    for i, (start_col, bar_length) in enumerate(zip(start_cols, bar_lengths)):\n        row = first_src_row + ROW_STRIDE * i\n        grid[row, start_col : start_col + bar_length] = random.randint(*COLOR_RANGE)\n\n    try:\n        main(grid)\n    except AssertionError:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
