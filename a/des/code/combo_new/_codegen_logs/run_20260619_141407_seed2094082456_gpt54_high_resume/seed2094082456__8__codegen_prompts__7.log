{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\nfrom collections import Counter\n\n\ndef _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:\n    \"\"\"\n    Legend is a vertical stack of pairs at bottom-left.\n    Each legend row: (marker_color at col c, fill_color at col c+1).\n    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).\n    \"\"\"\n    h, w = g.shape\n    start_r = None\n    start_c = None\n    for r in range(h - 1, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size:\n            start_r = r\n            start_c = int(nz[0])\n            break\n    assert start_r is not None and start_c is not None and start_c < w - 1, \\\n        \"legend must exist at bottom-left with at least 2 columns\"\n\n    entries: list[tuple[int, int, int]] = []\n    c = start_c\n    for r in range(start_r, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:\n            break\n        marker = int(g[r, c])\n        fill = int(g[r, c + 1]) if c + 1 < w else bg\n        entries.append((r, marker, fill))\n    return c, entries\n\n\ndef _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:\n    \"\"\"\n    Marker corners are L-shapes:\n      TL: (r,c), (r,c+1), (r+1,c)\n      TR: (r,c), (r,c-1), (r+1,c)\n      BL: (r,c), (r,c+1), (r-1,c)\n      BR: (r,c), (r,c-1), (r-1,c)\n\n    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall\n    where L arms can overlap other bbox corners.\n    \"\"\"\n    (dr1, dc1) = arm1\n    (dr2, dc2) = arm2\n    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts\n\n\ndef _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:\n    \"\"\"\n    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:\n      dist(a,p) + dist(p,b) == dist(a,b)\n    \"\"\"\n    ar, ac = a\n    br, bc = b\n    dab = abs(ar - br) + abs(ac - bc)\n    m = np.zeros((h, w), dtype=bool)\n    for r in range(r0, r1 + 1):\n        for c in range(c0, c1 + 1):\n            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:\n                m[r, c] = True\n    return m\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, label_mask, paste\nimport random\n\n\nclass _Node:\n    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):\n        self.coords = coords\n        self.bbox = bbox\n        self.center = center\n        self.is_frame = False\n        self.parent: _Node | None = None\n        self.children: list[_Node] = []\n        self.mask: np.ndarray | None = None\n        self.anchor: tuple[int, int] | None = None\n        self.axis_map: dict[str, list[tuple[float, int]]] = {\"row\": [], \"col\": []}\n\n\ndef _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:\n    mask = np.zeros(shape, dtype=bool)\n    mask[tuple(coords.T)] = True\n    lab, n = label_mask(~mask, connectivity=4)\n    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])\n    return [(lab == k) for k in range(1, n + 1) if k not in boundary]\n\n\ndef _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:\n    return max(a[0], b[0]) <= min(a[1], b[1])\n\n\ndef _build_layout(node: _Node) -> None:\n    if node.mask is not None:\n        return\n\n    if not node.is_frame:\n        node.mask = np.ones((1, 1), dtype=bool)\n        node.anchor = (0, 0)\n        node.axis_map = {\n            \"row\": [(float(node.center[0]), 0)],\n            \"col\": [(float(node.center[1]), 0)],\n        }\n        return\n\n    assert node.children\n    child_mask, _placements, axis_map = _layout_group(node.children)\n    h, w = child_mask.shape\n    out = np.zeros((h + 4, w + 4), dtype=bool)\n    out[0, :] = True\n    out[-1, :] = True\n    out[:, 0] = True\n    out[:, -1] = True\n    out[2 : 2 + h, 2 : 2 + w] |= child_mask\n\n    node.mask = out\n    node.anchor = (out.shape[0] // 2, out.shape[1] // 2)\n    node.axis_map = {\n        \"row\": [(orig, pos + 2) for orig, pos in axis_map[\"row\"]],\n        \"col\": [(orig, pos + 2) for orig, pos in axis_map[\"col\"]],\n    }\n\n\ndef _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:\n    items = []\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r0, c0, r1, c1 = node.bbox\n        interval = (r0, r1) if axis == 0 else (c0, c1)\n        mid = (interval[0] + interval[1]) / 2\n        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))\n\n    bands: list[dict] = []\n    for item in sorted(items, key=lambda x: x[2]):\n        interval = item[1]\n        for band in bands:\n            if any(_intervals_overlap(interval, other[1]) for other in band[\"items\"]):\n                band[\"items\"].append(item)\n                band[\"interval\"] = (\n                    min(band[\"interval\"][0], interval[0]),\n                    max(band[\"interval\"][1], interval[1]),\n                )\n                break\n        else:\n            bands.append({\"items\": [item], \"interval\": interval})\n\n    coord_by_node: dict[_Node, int] = {}\n    coord = 0\n    for i, band in enumerate(bands):\n        if i:\n            prev = bands[i - 1]\n            prev_down = max(item[4] - 1 - item[3] for item in prev[\"items\"])\n            curr_up = max(item[3] for item in band[\"items\"])\n            coord += prev_down + 2 + curr_up\n        for item in band[\"items\"]:\n            coord_by_node[item[0]] = int(coord)\n\n    return coord_by_node\n\n\ndef _layout_group(nodes: list[_Node]) -> tuple[np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    row_coord = _axis_coordinates(nodes, axis=0)\n    col_coord = _axis_coordinates(nodes, axis=1)\n\n    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)\n    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)\n    max_r = max(\n        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n    max_c = max(\n        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n\n    out = np.zeros((max_r, max_c), dtype=bool)\n    placements: dict[_Node, tuple[int, int]] = {}\n    axis_map = {\"row\": [], \"col\": []}\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r = row_coord[node] - node.anchor[0] - min_r\n        c = col_coord[node] - node.anchor[1] - min_c\n        placements[node] = (int(r), int(c))\n        out[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask\n        axis_map[\"row\"].append((float(node.center[0]), int(r + node.anchor[0])))\n        axis_map[\"col\"].append((float(node.center[1]), int(c + node.anchor[1])))\n\n    return out, placements, axis_map\n\n\ndef _outside_side(dot: _Node, frame: _Node) -> str:\n    r0, c0, r1, c1 = dot.bbox\n    fr0, fc0, fr1, fc1 = frame.bbox\n    if c0 > fc1:\n        return \"right\"\n    if c1 < fc0:\n        return \"left\"\n    if r0 > fr1:\n        return \"bottom\"\n    if r1 < fr0:\n        return \"top\"\n\n    dr = float(dot.center[0] - (fr0 + fr1) / 2)\n    dc = float(dot.center[1] - (fc0 + fc1) / 2)\n    if abs(dc) >= abs(dr):\n        return \"right\" if dc > 0 else \"left\"\n    return \"bottom\" if dr > 0 else \"top\"\n\n\ndef _map_frame_axis(frame: _Node, axis: int, value: float) -> int:\n    assert frame.anchor is not None\n    key = \"row\" if axis == 0 else \"col\"\n    candidates = frame.axis_map[key]\n    if not candidates:\n        return int(frame.anchor[axis])\n    return int(min(candidates, key=lambda item: abs(item[0] - value))[1])\n\n\ndef _layout_root(nodes: list[_Node]) -> np.ndarray:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    frames = [node for node in nodes if node.is_frame]\n    dots = [node for node in nodes if not node.is_frame]\n    if len(frames) == 1 and dots:\n        frame = frames[0]\n        assert frame.mask is not None\n        placements: dict[_Node, tuple[int, int]] = {frame: (0, 0)}\n        extents = [(0, 0, frame.mask.shape[0], frame.mask.shape[1])]\n\n        for dot in dots:\n            side = _outside_side(dot, frame)\n            if side in {\"right\", \"left\"}:\n                r = _map_frame_axis(frame, 0, float(dot.center[0]))\n                c = frame.mask.shape[1] + 1 if side == \"right\" else -2\n            else:\n                r = frame.mask.shape[0] + 1 if side == \"bottom\" else -2\n                c = _map_frame_axis(frame, 1, float(dot.center[1]))\n            placements[dot] = (int(r), int(c))\n            extents.append((r - 1, c - 1, r + 2, c + 2))\n\n        min_r = min(e[0] for e in extents)\n        min_c = min(e[1] for e in extents)\n        max_r = max(e[2] for e in extents)\n        max_c = max(e[3] for e in extents)\n        out = np.zeros((max_r - min_r, max_c - min_c), dtype=bool)\n        for node, (r, c) in placements.items():\n            rr = r - min_r\n            cc = c - min_c\n            if node is frame:\n                out[rr : rr + frame.mask.shape[0], cc : cc + frame.mask.shape[1]] |= frame.mask\n            else:\n                out[rr, cc] = True\n        return out\n\n    mask, _placements, _axis_map = _layout_group(nodes)\n    return mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/c3fa4749.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nfrom scipy.ndimage import binary_fill_holes\n\nfrom arc_utils import bbox_coords, colors_present, components_mask\nimport random\n\n\ndef _mask_from_coords(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:\n    mask = np.zeros(shape, dtype=bool)\n    mask[coords[:, 0], coords[:, 1]] = True\n    return mask\n\n\ndef _single_side_marker(region: np.ndarray, obj_mask: np.ndarray) -> int | None:\n    side_values: list[int] = []\n    touched = 0\n\n    if obj_mask[0, :].any():\n        touched += 1\n        side_values.extend(map(int, region[0, obj_mask[0, :]]))\n    if obj_mask[-1, :].any():\n        touched += 1\n        side_values.extend(map(int, region[-1, obj_mask[-1, :]]))\n    if obj_mask[:, 0].any():\n        touched += 1\n        side_values.extend(map(int, region[obj_mask[:, 0], 0]))\n    if obj_mask[:, -1].any():\n        touched += 1\n        side_values.extend(map(int, region[obj_mask[:, -1], -1]))\n\n    if touched != 1:\n        return None\n    if len(side_values) != 1:\n        return None\n\n    assert side_values, \"a side-touching object must contribute at least one marker cell\"\n    marker = side_values[0]\n    if any(value != marker for value in side_values):\n        return None\n    return marker\n\n\ndef _looks_like_panel(coords: np.ndarray) -> bool:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    area = len(coords)\n    return height >= 5 and width >= 5 and area >= 20 and area / (height * width) >= 0.35\n\n\ndef _has_multicolor_object(region: np.ndarray, panel_color: int) -> bool:\n    for obj_coords in components_mask(region != panel_color, connectivity=4):\n        obj_colors = {int(region[r, c]) for r, c in obj_coords}\n        if len(obj_colors) >= 2:\n            return True\n    return False\n\n\ndef _assert_each_panel_has_multicolor_object(g: np.ndarray) -> None:\n    panels = 0\n    for panel_color in colors_present(g):\n        for panel_coords in components_mask(g == panel_color, connectivity=4):\n            if not _looks_like_panel(panel_coords):\n                continue\n\n            panels += 1\n            r0, c0, r1, c1 = bbox_coords(panel_coords)\n            region = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert _has_multicolor_object(region, int(panel_color)), (\n                \"each monochrome panel must contain a 4-connected multicolor object\"\n            )\n\n    assert panels > 0, \"expected at least one monochrome panel\"\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor each side-marked multicolor object embedded in a monochrome panel to its marker color.\n\n    Input structure:\n    - Same-color 4-connected components form monochrome panel regions.\n    - The bounding box of a panel may contain 4-connected non-panel-color objects.\n    - A target object touches exactly one side of its panel bbox, and all of its\n      pixels on that side have one marker color.\n\n    Rule:\n    - For every target object, fill any panel-colored holes enclosed by the object.\n    - Recolor the object and filled holes to the side marker color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - A multicolor object's single contact side identifies both which object should\n      be normalized and which color should replace it.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    _assert_each_panel_has_multicolor_object(g)\n\n    planned: dict[tuple[int, int], int] = {}\n    selected_objects = 0\n\n    for panel_color in colors_present(g):\n        for panel_coords in components_mask(g == panel_color, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(panel_coords)\n            region = g[r0 : r1 + 1, c0 : c1 + 1]\n\n            for obj_coords in components_mask(region != panel_color, connectivity=4):\n                obj_mask = _mask_from_coords(region.shape, obj_coords)\n                marker = _single_side_marker(region, obj_mask)\n                if marker is None:\n                    continue\n\n                selected_objects += 1\n                paint_mask = binary_fill_holes(obj_mask).astype(bool)\n                for rr, cc in np.argwhere(paint_mask):\n                    coord = (int(r0 + rr), int(c0 + cc))\n                    previous = planned.get(coord)\n                    assert previous is None or previous == marker, \"conflicting side-marker recolors\"\n                    planned[coord] = int(marker)\n\n    assert selected_objects > 0, \"expected at least one side-marked object\"\n    assert any(int(g[r, c]) != color for (r, c), color in planned.items()), \"expected at least one visible recolor\"\n\n    out = g.copy()\n    for (r, c), color in planned.items():\n        out[r, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\nCOLOR_COUNT = 10\nGRID_HEIGHT_RANGE = (20, 30)\nGRID_WIDTH_RANGE = (20, 30)\nPANEL_COUNT_RANGE = (2, 4)\nPANEL_HEIGHT_RANGE = (5, 12)\nPANEL_WIDTH_RANGE = (5, 10)\nPANEL_PLACEMENT_TRIES = 50\nTARGET_COUNT_CHOICES = [1, 2, 3, 4]\nTARGET_COUNT_WEIGHTS = [2, 3, 3, 2]\nMAX_TARGETS_PER_PANEL = 2\nDOUBLE_TARGET_PROB = 0.25\nTARGET_SIZE_RANGE = (3, 13)\nGENERATION_ATTEMPTS = 300\nNEIGHBORS_4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = range(4)\n\n\ndef _on_side(r, c, ph, pw, side):\n    if side == SIDE_TOP:\n        return r == 0\n    if side == SIDE_BOTTOM:\n        return r == ph - 1\n    if side == SIDE_LEFT:\n        return c == 0\n    return c == pw - 1\n\n\ndef _on_other_side(r, c, ph, pw, side):\n    return (\n        (side != SIDE_TOP and r == 0)\n        or (side != SIDE_BOTTOM and r == ph - 1)\n        or (side != SIDE_LEFT and c == 0)\n        or (side != SIDE_RIGHT and c == pw - 1)\n    )\n\n\ndef _can_grow_into(r, c, ph, pw, side, blob, available_mask):\n    return (\n        0 <= r < ph\n        and 0 <= c < pw\n        and (r, c) not in blob\n        and not _on_other_side(r, c, ph, pw, side)\n        and not _on_side(r, c, ph, pw, side)\n        and available_mask[r, c]\n    )\n\n\ndef _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask):\n    for dr, dc in NEIGHBORS_4:\n        nr, nc = r + dr, c + dc\n        if _can_grow_into(nr, nc, ph, pw, side, blob, available_mask):\n            frontier.append((nr, nc))\n\n\ndef _grow_blob_constrained(ph, pw, contact_cells, target_size, side, available_mask):\n    \"\"\"Grow a 4-connected blob from contact_cells avoiding other sides.\"\"\"\n    blob = set(tuple(x) for x in contact_cells)\n    frontier = []\n    for r, c in blob:\n        _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask)\n\n    while len(blob) < target_size and frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        cell = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if cell in blob:\n            continue\n        blob.add(cell)\n        r, c = cell\n        _extend_frontier(frontier, r, c, ph, pw, side, blob, available_mask)\n\n    if len(blob) < 2:\n        return None\n    return blob\n\n\ndef _make_noise_grid(H, W, avoid_colors_at=None):\n    \"\"\"Create random noise where no two 4-adjacent cells share a color.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    if avoid_colors_at is None:\n        avoid_colors_at = {}\n    for r in range(H):\n        for c in range(W):\n            neighbors = set()\n            if r > 0: neighbors.add(int(grid[r-1, c]))\n            if c > 0: neighbors.add(int(grid[r, c-1]))\n            extra = avoid_colors_at.get((r, c), set())\n            forbidden = neighbors | extra\n            available = [x for x in range(COLOR_COUNT) if x not in forbidden]\n            if not available:\n                available = [x for x in range(COLOR_COUNT) if x not in neighbors]\n            grid[r, c] = random.choice(available)\n    return grid\n\n\ndef _panel_has_multicolor_object(grid, panel_color, r0, c0, ph, pw):\n    region = grid[r0:r0+ph, c0:c0+pw]\n    for obj_coords in components_mask(region != panel_color, connectivity=4):\n        obj_colors = {int(region[r, c]) for r, c in obj_coords}\n        if len(obj_colors) >= 2:\n            return True\n    return False\n\n\ndef _place_multicolor_corner_distractor(grid, output_grid, panel_color, r0, c0, ph, pw, available):\n    color_choices = [c for c in range(COLOR_COUNT) if c != panel_color]\n    if len(color_choices) < 2:\n        return False\n","exit_code":0,"status":"completed"}}
