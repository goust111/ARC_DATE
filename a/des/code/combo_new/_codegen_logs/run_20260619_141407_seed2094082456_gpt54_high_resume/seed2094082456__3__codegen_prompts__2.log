{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/20fb2937.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _solid_separator_row(g: np.ndarray, bg: int) -> int:\n    rows = [\n        r\n        for r in range(g.shape[0])\n        if np.all(g[r] == int(g[r, 0])) and int(g[r, 0]) != int(bg)\n    ]\n    assert len(rows) == 1, \"expected one solid non-background separator row\"\n    return int(rows[0])\n\n\ndef _legend_mapping(g: np.ndarray, sep: int, bg: int) -> tuple[dict[int, int], int]:\n    top = g[:sep]\n    comps = find_components(top, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    sprites = []\n    markers = []\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        area = int(comp[\"area\"])\n        if area == 1:\n            markers.append(comp)\n        else:\n            assert h == w and area == h * w, \"legend sprites must be filled squares\"\n            sprites.append(comp)\n\n    assert len(sprites) == len(markers) and len(sprites) > 0, \"legend must pair each sprite with one marker\"\n\n    sizes = {int(s[\"bbox\"][2] - s[\"bbox\"][0] + 1) for s in sprites}\n    assert len(sizes) == 1, \"all legend sprites must have the same size\"\n    size = sizes.pop()\n    assert size % 2 == 1, \"legend sprite size must have a center pixel\"\n\n    marker_rows = {int(m[\"coords\"][0][0]) for m in markers}\n    assert len(marker_rows) == 1, \"legend markers must lie on one row\"\n    marker_colors = [int(m[\"color\"]) for m in markers]\n    assert len(set(marker_colors)) == len(marker_colors), \"legend marker colors must be unique\"\n\n    sprites.sort(key=lambda s: (int(s[\"bbox\"][1] + s[\"bbox\"][3]), int(s[\"bbox\"][0])))\n    markers.sort(key=lambda m: (int(m[\"coords\"][0][1]), int(m[\"coords\"][0][0])))\n\n    mapping: dict[int, int] = {}\n    for sprite, marker in zip(sprites, markers):\n        _sr0, sc0, _sr1, sc1 = sprite[\"bbox\"]\n        mr, mc = map(int, marker[\"coords\"][0])\n        assert mc == (int(sc0) + int(sc1)) // 2, \"marker must align with its sprite center column\"\n        assert mr > int(sprite[\"bbox\"][2]), \"marker must sit below its sprite\"\n        mapping[int(marker[\"color\"])] = int(sprite[\"color\"])\n\n    return mapping, int(size)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each marker below the separator with the mapped top legend square centered on that marker.\n\n    Input structure:\n    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.\n    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.\n    - The lower field contains only background and marker colors from the legend.\n\n    Rule:\n    - Pair legend markers to legend sprites by left-to-right position.\n    - Discard the legend and separator; keep the grid width and the rows below the separator.\n    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.\n\n    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    sep = _solid_separator_row(g, bg)\n    mapping, size = _legend_mapping(g, sep, bg)\n\n    lower = g[sep + 1 :]\n    out = np.full_like(lower, bg)\n    radius = size // 2\n\n    for r, c in np.argwhere(lower != bg):\n        key = int(lower[r, c])\n        assert key in mapping, \"lower field marker must appear in the legend\"\n        r0 = int(r) - radius\n        c0 = int(c) - radius\n        r1 = r0 + size\n        c1 = c0 + size\n        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], \"expanded square must fit in output\"\n        assert np.all(out[r0:r1, c0:c1] == bg), \"expanded squares must not overlap\"\n        out[r0:r1, c0:c1] = mapping[key]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6\nFIELD_SHAPE = (13, 11)\nFIELD_WIDTH = FIELD_SHAPE[1]\nSQUARE_SIZE = 3\nSQUARE_RADIUS = SQUARE_SIZE // 2\nLEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4\n\n# Palette and object counts.\nPALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nNUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]\n\nEMPTY, MAX_GENERATION_ATTEMPTS = 0, 300\n\n\ndef _color_pairs() -> tuple[list[int], list[int]]:\n    \"\"\"Return disjoint sprite and marker palettes in legend order.\"\"\"\n    picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)\n    return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]\n\n\ndef _place_centers(n: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place non-overlapping 3x3 squares and return their centers.\"\"\"\n    occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)\n    patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)\n    centers: list[tuple[int, int]] = []\n    for _ in range(n):\n        try:\n            r0, c0 = random_free_location(occ, patch, transparent=EMPTY)\n        except ValueError:\n            return None\n        paste(occ, patch, r0, c0)\n        centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))\n    return centers\n\n\ndef _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:\n    \"\"\"Connect square indices whose rendered 3x3 blocks share an edge.\"\"\"\n    neighbors = [set() for _ in centers]\n    for i, (r1, c1) in enumerate(centers):\n        for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):\n            dr = abs(r1 - r2)\n            dc = abs(c1 - c2)\n            if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):\n                neighbors[i].add(j)\n                neighbors[j].add(i)\n    return neighbors\n\n\ndef _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:\n    \"\"\"Assign all color ids while preventing same-color touching squares.\"\"\"\n    neighbors = _touch_graph(centers)\n    order = list(range(len(centers)))\n    random.shuffle(order)\n    order.sort(key=lambda i: len(neighbors[i]), reverse=True)\n    ids: list[int | None] = [None] * len(centers)\n    required = set(range(NUM_COLOR_PAIRS))\n\n    def backtrack(pos: int, used: set[int]) -> bool:\n        if pos == len(order):\n            return used == required\n        if len(required - used) > len(order) - pos:\n            return False\n        i = order[pos]\n        choices = list(range(NUM_COLOR_PAIRS))\n        random.shuffle(choices)\n        for color_id in choices:\n            if any(ids[j] == color_id for j in neighbors[i]):\n                continue\n            ids[i] = color_id\n            if backtrack(pos + 1, used | {color_id}):\n                return True\n            ids[i] = None\n        return False\n\n    if not backtrack(0, set()):\n        return None\n    return [int(x) for x in ids]\n\n\ndef _build_grids(\n    centers: list[tuple[int, int]],\n    square_ids: list[int],\n    sprite_colors: list[int],\n    marker_colors: list[int],\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an assembled input grid and the matching oracle output.\"\"\"\n    out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    for (r, c), idx in zip(centers, square_ids):\n        patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)\n        paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)\n        lower[r, c] = marker_colors[idx]\n\n    legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):\n        c0 = i * LEGEND_COLUMN_STRIDE\n        legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite\n        legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker\n\n    sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)\n    return np.vstack([legend, sep, lower]), out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_colors, marker_colors = _color_pairs()\n    n_squares = random.choice(SQUARE_COUNT_CHOICES)\n    centers = _place_centers(n_squares)\n    if centers is None:\n        return None\n    square_ids = _assign_square_ids(centers)\n    if square_ids is None:\n        return None\n\n    inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 20fb2937 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py\"","aggregated_output":"from __future__ import annotations\nimport math\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n\n    Input structure:\n    - bg = background. A large monochrome shape (template, color T).\n    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n    - Singletons sit on a uniform-spacing lattice.\n\n    Rule:\n    - Convert each singleton's offset from the origin into coarse lattice units.\n    - Place a template copy at each offset, scaled by template height/width.\n    - The origin's copy is painted O instead of T.\n    - Any pixel covered by two or more copies is also recolored to O.\n\n    Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    template = max(comps, key=lambda d: int(d[\"area\"]))\n    templ_coords = template[\"coords\"]\n    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n    r0, c0, r1, c1 = map(int, template[\"bbox\"])\n    h = int(bbox_h((r0, c0, r1, c1)))\n    w = int(bbox_w((r0, c0, r1, c1)))\n\n    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n\n    # Singleton layout points (excluding the template component).\n    singletons: list[tuple[int, int, int]] = []\n    for comp in comps:\n        if comp is template:\n            continue\n        if int(comp[\"area\"]) != 1:\n            continue\n        rr, cc = map(int, comp[\"coords\"][0])\n        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n\n    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n    assert not (len(origin) != 1)\n    orr, orc = origin[0]\n\n    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n    assert not (not other_cols)\n    overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n\n    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n    assert gcd_vals\n    gunit = int(math.gcd(*gcd_vals))\n    gunit = max(1, int(gunit))\n    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n\n    total = np.zeros((H, W), dtype=int)\n    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n\n    for dr, dc, col in deltas:\n        off_r = int(dr * h)\n        off_c = int(dc * w)\n        is_origin = int(col) == int(templ_col)\n        for rr, cc in templ_rel:\n            R = int(r0 + off_r + rr)\n            C = int(c0 + off_c + cc)\n            if 0 <= R < H and 0 <= C < W:\n                total[R, C] += 1\n                if is_origin:\n                    center[R, C] += 1\n\n    out = np.full((H, W), int(bg), dtype=int)\n    out[total > 0] = int(templ_col)\n    out[(total == 1) & (center > 0)] = int(overlap_col)\n    out[total >= 2] = int(overlap_col)\n    return out\n\n# --------------- generator (a1) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────\nGRID_SIZE = 22\nTEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\nTEMPLATE_W = 3                    # template bbox width (fixed)\nTEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\nTEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\nSINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\nLATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\nGUNIT = 2                         # singleton spacing in pixels\n\n# Retry budgets\nSPANNING_RETRIES = 40             # attempts per spanning polyomino\nTEMPLATE_RETRIES = 60             # attempts to build a valid template\nSINGLETON_RETRIES = 50            # attempts to place singleton cluster\nGENERATE_RETRIES = 300            # outer retry loop\n\n\ndef _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n    \"\"\"Grow a random 4-connected polyomino of *n* cells in a rows x cols grid.\"\"\"\n    start = (random.randint(0, rows - 1), random.randint(0, cols - 1))\n    cells = {start}\n    frontier = []\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nr, nc = start[0] + dr, start[1] + dc\n        if 0 <= nr < rows and 0 <= nc < cols:\n            frontier.append((nr, nc))\n    while len(cells) < n and frontier:\n        cell = random.choice(frontier)\n        frontier.remove(cell)\n        if cell in cells:\n            continue\n        cells.add(cell)\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr, nc = cell[0] + dr, cell[1] + dc\n            if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:\n                frontier.append((nr, nc))\n    return list(cells) if len(cells) == n else None\n\n\ndef _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n    \"\"\"Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges).\"\"\"\n    for _ in range(SPANNING_RETRIES):\n        cells = _random_polyomino(n, rows, cols)\n        if cells is None:\n            continue\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:\n            return cells\n    return None\n\n\ndef _gen_template(h: int, w: int) -> list[tuple[int, int]] | None:\n    \"\"\"4-connected template shape in h x w, spanning bbox, within area/fill bounds.\"\"\"\n    total = h * w\n    lo = max(TEMPLATE_AREA_RANGE[0], int(np.ceil(total * TEMPLATE_FILL_RANGE[0])))\n    hi = min(TEMPLATE_AREA_RANGE[1], int(np.floor(total * TEMPLATE_FILL_RANGE[1])))\n    if lo > hi:\n        return None\n    for _ in range(TEMPLATE_RETRIES):\n        area = random.randint(lo, hi)\n        cells = _spanning_polyomino(area, h, w)\n        if cells is not None:\n            return cells\n    return None\n\n\ndef _gen_lattice(n: int) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:\n    \"\"\"Lattice polyomino of *n* cells with strictly interior origin.\"\"\"\n    ext_r = random.randint(*LATTICE_EXTENT_RANGE)\n    ext_c = random.randint(*LATTICE_EXTENT_RANGE)\n    cells = _spanning_polyomino(n, ext_r, ext_c)\n    if cells is None:\n        return None\n    interior = [(r, c) for r, c in cells if 0 < r < ext_r - 1 and 0 < c < ext_c - 1]\n    if not interior:\n        return None\n    return cells, random.choice(interior)\n\n\ndef _delta_bounds(deltas: list[tuple[int, int]]):\n    \"\"\"Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets.\"\"\"\n    min_dr = min(dr for dr, dc in deltas)\n    max_dr = max(dr for dr, dc in deltas)\n    min_dc = min(dc for dr, dc in deltas)\n    max_dc = max(dc for dr, dc in deltas)\n    return min_dr, max_dr, min_dc, max_dc\n\n\ndef _place_singletons(\n    deltas, min_dr, max_dr, min_dc, max_dc,\n    templ_cells, r0, c0, h, w, bg, T, O, occupied,\n) -> np.ndarray | None:\n    \"\"\"Try to find a valid singleton cluster position and build the input grid.\"\"\"\n    orr_lo, orr_hi = -min_dr * GUNIT, GRID_SIZE - 1 - max_dr * GUNIT\n    orc_lo, orc_hi = -min_dc * GUNIT, GRID_SIZE - 1 - max_dc * GUNIT\n    if orr_lo > orr_hi or orc_lo > orc_hi:\n        return None\n\n    # Template bbox edges\n    tr0, tr1 = r0, r0 + h - 1\n    tc0, tc1 = c0, c0 + w - 1\n\n    for _ in range(SINGLETON_RETRIES):\n        orr = random.randint(orr_lo, orr_hi)\n        orc = random.randint(orc_lo, orc_hi)\n\n        # Singleton cluster bbox -- must be disjoint from template with >=1 bg cell gap\n        sr0 = orr + min_dr * GUNIT\n        sr1 = orr + max_dr * GUNIT\n        sc0 = orc + min_dc * GUNIT\n        sc1 = orc + max_dc * GUNIT\n        if not (sr1 + 1 < tr0 or tr1 + 1 < sr0 or sc1 + 1 < tc0 or tc1 + 1 < sc0):\n            continue\n\n        # Singletons must not land on stamp pixels\n        if any((orr + dr * GUNIT, orc + dc * GUNIT) in occupied for dr, dc in deltas):\n            continue\n\n        # Build input grid\n        grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)\n        for tr, tc in templ_cells:\n            grid[r0 + tr, c0 + tc] = T\n        for dr, dc in deltas:\n            grid[orr + dr * GUNIT, orc + dc * GUNIT] = T if (dr == 0 and dc == 0) else O\n\n        try:\n            main(grid)\n        except Exception:\n            return None\n        return grid\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt: pick colors, build template + lattice, place stamps + singletons.\"\"\"\n    bg, T, O = random.sample(range(10), 3)\n\n    h = random.choice(TEMPLATE_H_CHOICES)\n    w = TEMPLATE_W\n    templ_cells = _gen_template(h, w)\n    if templ_cells is None:\n        return None\n\n    n_sing = random.randint(*SINGLETON_COUNT_RANGE)\n    lat = _gen_lattice(n_sing)\n    if lat is None:\n        return None\n    lattice_cells, origin = lat\n    deltas = [(r - origin[0], c - origin[1]) for r, c in lattice_cells]\n    min_dr, max_dr, min_dc, max_dc = _delta_bounds(deltas)\n\n    # Compute valid placement window for the template origin\n    r0_lo, r0_hi = -min_dr * h, GRID_SIZE - max_dr * h - h\n    c0_lo, c0_hi = -min_dc * w, GRID_SIZE - max_dc * w - w\n    if r0_lo > r0_hi or c0_lo > c0_hi:\n        return None\n\n    r0 = random.randint(r0_lo, r0_hi)\n    c0 = random.randint(c0_lo, c0_hi)\n\n    # Verify no pixel overlap between stamps\n    occupied = set()\n    for dr, dc in deltas:\n        for tr, tc in templ_cells:\n            pt = (r0 + dr * h + tr, c0 + dc * w + tc)\n            if pt in occupied:\n                return None\n            occupied.add(pt)\n\n    return _place_singletons(\n","exit_code":0,"status":"completed"}}
