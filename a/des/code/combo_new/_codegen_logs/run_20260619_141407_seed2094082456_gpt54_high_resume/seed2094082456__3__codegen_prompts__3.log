{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/67e490f4.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill holes inside a large template frame using shape-matched outside sprites.\n\n    Input structure:\n    - bg = most common color. One large monochrome frame object (template).\n    - Inside the frame: holes of various shapes (non-frame-color regions).\n    - Outside the frame: small monochrome sprites scattered on bg.\n\n    Rule:\n    - Crop to the frame's bounding box; fill entirely with frame color.\n    - For each hole, find an outside sprite whose shape matches (rotation/flip allowed).\n    - Fill the hole with the matched sprite's color. If multiple sprites match, use the most frequent color.\n\n    Key insight: Sprites act as shape-coded color keys — their shape identifies which hole they fill, their color determines the fill color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # STEP 1) Find the template frame: largest connected component of any non-bg color (8-connected).\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n    assert comps\n    frame_area = max(int(comp[\"area\"]) for comp in comps)\n    frame_candidates = [comp for comp in comps if int(comp[\"area\"]) == frame_area]\n    assert len(frame_candidates) == 1\n    frame = frame_candidates[0]\n    frame_col = int(frame[\"color\"])\n    fb = frame[\"bbox\"]\n    r0, c0, r1, c1 = map(int, fb)\n\n    sub = crop_bbox(g, fb)\n    th, tw = sub.shape\n\n    # STEP 2) Extract hole components inside the bbox (anything not equal to frame color), 4-connected.\n    hole_mask = (sub != int(frame_col))\n    holes: list[tuple[tuple[tuple[int, int], bytes], tuple[int, int], np.ndarray]] = []  # (key, (r0,c0), mask)\n    for coords in components_mask(hole_mask, connectivity=4):\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        hh = int(hr1 - hr0 + 1)\n        ww = int(hc1 - hc0 + 1)\n        rel = coords - np.array([hr0, hc0])\n        m = np.zeros((hh, ww), dtype=bool)\n        m[rel[:, 0], rel[:, 1]] = True\n        key = (m.shape, m.tobytes())\n        holes.append((key, (int(hr0), int(hc0)), m))\n\n    # STEP 3) Extract sprites outside the bbox.\n    outside = g.copy()\n    outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n    spr_comps = find_components(outside, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    # key -> color -> count\n    sprites_by_key: dict[tuple[tuple[int, int], bytes], dict[int, int]] = {}\n\n    def _all_mask_keys(mask: np.ndarray):\n        \"\"\"Generate keys for all rotations (and optional vertical flip) of a boolean mask.\"\"\"\n        m0 = mask.astype(bool)\n        for flip in (False, True):\n            m1 = np.flipud(m0) if flip else m0\n            for k in range(4):\n                m2 = np.rot90(m1, k)\n                yield (m2.shape, m2.tobytes())\n\n    for comp in spr_comps:\n        coords = comp[\"coords\"]\n        bb = comp[\"bbox\"]\n        sr0, sc0, sr1, sc1 = map(int, bb)\n        hh = int(sr1 - sr0 + 1)\n        ww = int(sc1 - sc0 + 1)\n\n        vals = [int(v) for v in g[coords[:, 0], coords[:, 1]]]\n        scol = int(Counter(vals).most_common(1)[0][0])\n\n        rel = coords - np.array([sr0, sc0])\n        m = np.zeros((hh, ww), dtype=bool)\n        m[rel[:, 0], rel[:, 1]] = True\n\n        for key in _all_mask_keys(m):\n            bucket = sprites_by_key.setdefault(key, {})\n            bucket[scol] = int(bucket.get(scol, 0)) + 1\n\n    # STEP 4) Render output: start from solid frame color, then fill each hole by shape match.\n    out = np.full((th, tw), int(frame_col), dtype=int)\n    for key, (hr0, hc0), hmask in holes:\n        cmap = sprites_by_key.get(key)\n        assert cmap is not None\n        # choose the most frequent sprite color for this shape; break ties by preferring smaller color id\n        scol = max(cmap.items(), key=lambda kv: (kv[1], -kv[0]))[0]\n        patch = np.full(hmask.shape, int(scol), dtype=int)\n        paste(out, patch, int(hr0), int(hc0), mask=hmask)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\nNUM_COLORS = 10\nGRID_SIZE = 30\n\n# Frame bbox dimensions\nFRAME_H_RANGE = (7, 13)\nFRAME_W_RANGE = (7, 20)\n\n# Hole layout\nSHAPE_COUNT_RANGE = (3, 6)          # distinct canonical hole shapes\nMIN_SHAPES = 3                       # minimum to accept a layout\nSHAPE_MAX_AREA = 8                   # max cells per hole shape\nFRAME_DENSITY_RANGE = (0.55, 0.92)   # fraction of frame_col in frame bbox\nMIN_TOTAL_HOLES = 5                  # minimum hole instances\nPLACEMENT_RETRIES = 80               # retries per symmetric placement attempt\nMULT_EVEN_WEIGHTS = ([1, 2], [4, 1])       # (values, weights) for even-dim frames\nMULT_ODD_WEIGHTS = ([1, 2, 3], [3, 2, 1])  # (values, weights) for odd-dim frames\n\n# Sprite scattering\nWINNING_SPRITE_RANGE = (2, 5)        # winning-color sprites per hole shape\nOTHER_COLOR_MAX = 2                  # max distinct losing colors per shape\nSPRITE_PADDING = 1                   # Chebyshev separation (bg cells)\n\n# Generation retry budget\nMAX_GEN_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\n","exit_code":0,"status":"completed"}}
