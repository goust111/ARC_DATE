{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n\n    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n    random.shuffle(tasks)\n\n    grid = np.zeros((sz, sz), dtype=int)\n    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n\n    placements = _place_objects(sz, tasks, legend_box)\n    if placements is None:\n        return None\n\n    inp, output = _render_output(grid, placements)\n    if _matches_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
