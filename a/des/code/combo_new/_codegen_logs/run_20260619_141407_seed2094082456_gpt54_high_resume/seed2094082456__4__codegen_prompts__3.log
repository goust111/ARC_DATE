{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,90p;471,520p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p;361,420p' /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import crop_bbox, find_components, get_bg, paste\n\n\ndef mask_from_coords(coords, shape: tuple[int, int]) -> np.ndarray:\n    \"\"\"Local helper: build a boolean mask from bbox-relative component coordinates.\"\"\"\n    m = np.zeros(shape, dtype=bool)\n    H, W = shape\n    for r, c in coords:\n        rr = int(r)\n        cc = int(c)\n        assert 0 <= rr < H and 0 <= cc < W\n        m[rr, cc] = True\n    return m\n\n\ndef canonical_shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:\n    \"\"\"Canonicalize a boolean mask up to rotation and horizontal reflection.\"\"\"\n    canon = np.asarray(mask, dtype=bool)\n    best = (canon.tobytes(), tuple(map(int, canon.shape)))\n    for _ in range(4):\n        canon = np.rot90(canon)\n        for v in (canon, np.fliplr(canon)):\n            key = (v.tobytes(), tuple(map(int, v.shape)))\n            if key < best:\n                best = key\n    return best\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n\n    Input structure:\n    - bg = most common color.\n    - Several multicolor connected components (8-connected) scattered across the grid.\n\n    Rule:\n    - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n    - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n    - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n    - Horizontal position (left column) is preserved; only vertical translation changes.\n\n    Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    extracted = []\n    for comp in comps:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (r0, c0, r1, c1))\n\n        # Isolate this component exactly (bbox rectangle may include background).\n        rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n        m = mask_from_coords(rel_coords, patch.shape)\n        pat = np.full_like(patch, bg)\n        pat[m] = patch[m]\n\n        extracted.append(\n            {\n                \"c0\": int(c0),\n                \"pat\": pat,\n                \"shape_key\": canonical_shape_key(m),\n            }\n        )\n\n    freq = Counter(d[\"shape_key\"] for d in extracted)\n    out = np.full((H, W), int(bg), dtype=int)\n\n    for d in extracted:\n        pat = d[\"pat\"]\n        h, w = map(int, pat.shape)\n        dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n        dest_c0 = int(d[\"c0\"])\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\n","exit_code":0,"status":"completed"}}
