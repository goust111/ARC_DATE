E = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"failed to generate afe3afe9 input\")\n","exit_code":0,"status":"completed"}}
