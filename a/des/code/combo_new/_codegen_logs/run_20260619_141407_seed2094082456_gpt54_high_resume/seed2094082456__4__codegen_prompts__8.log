{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/8f3a5a89.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, is_contiguous, neighbors4, neighbors8, random_free_location\nimport random\n\n\ndef _flood(start: tuple[int, int], passable, h: int, w: int) -> set[tuple[int, int]]:\n    q = deque([start])\n    vis = {start}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and passable(nr, nc):\n                vis.add((nr, nc))\n                q.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint an inner border around the region reachable from a corner marker pixel.\n\n    Input structure:\n    - bg = most common color; wall color (blue) forms barriers dividing the grid.\n    - A unique single pixel (magenta) sits on one corner — the start marker.\n    - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.\n\n    Rule:\n    - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.\n    - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).\n    - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.\n\n    Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Marker pixel is a unique (count==1) non-bg pixel on a corner.\n    counts = Counter(int(v) for v in g.ravel())\n    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    marker = None\n    for r, c in corners:\n        v = int(g[r, c])\n        if v != bg and counts.get(v, 0) == 1:\n            marker = (r, c, v)\n            break\n    assert marker is not None, \"no unique single-pixel corner marker found\"\n\n    mr, mc, marker_col = marker\n\n    # Wall color: most frequent non-bg, non-marker color.\n    other_cols = [c for c in counts.keys() if c not in (bg, marker_col)]\n    assert other_cols, \"no non-bg non-marker colors found; cannot determine wall color\"\n    wall_col = max(other_cols, key=lambda c: counts[c])\n\n    # First reach: treat all wall pixels as obstacles.\n    reach0 = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col),\n        h,\n        w,\n    )\n\n    # Structural walls are wall-color components that touch the border AND are adjacent to reach0.\n    walls: set[tuple[int, int]] = set()\n    for comp_arr in components_mask(g == wall_col, connectivity=4):\n        comp = [(int(r), int(c)) for r, c in comp_arr]\n        touches_border = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp)\n        if not touches_border:\n            continue\n        adjacent_to_reach0 = any(any((nr, nc) in reach0 for nr, nc in neighbors4(r, c)) for r, c in comp)\n        if adjacent_to_reach0:\n            walls |= set(comp)\n\n    # Second reach: allow passing through non-wall wall-color pixels (decorations) so they don't create borders.\n    reach = _flood(\n        (mr, mc),\n        lambda r, c: int(g[r, c]) in (bg, marker_col) or (int(g[r, c]) == wall_col and (r, c) not in walls),\n        h,\n        w,\n    )\n\n    # Remove wall-colored decorations that are not reachable (they lie behind structural walls).\n    for r in range(h):\n        for c in range(w):\n            if int(out[r, c]) == wall_col and (r, c) not in walls and (r, c) not in reach:\n                out[r, c] = bg\n\n    fill_col = 7\n    # Paint a 1-cell-thick inner border of the reachable region (on background cells only).\n    for r, c in reach:\n        if int(out[r, c]) != bg:\n            continue\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) in walls for nr, nc in neighbors8(r, c)):\n            out[r, c] = fill_col\n            continue\n        if any((nr, nc) not in reach for nr, nc in neighbors4(r, c)):\n            out[r, c] = fill_col\n\n    return out\n\n# --------------- generator (merged (attempts 1+2 hybrid)) ---------------\n\n# ---- Palette (task colors) ----\nBG = 8\nWALL = 1\nMARKER = 6\nFILL = 7\n\n# ---- Canvas size ----\nGRID_H_RANGE = (10, 20)\nGRID_W_RANGE = (10, 20)\n\n# ---- Structural walls ----\nNUM_STRUCTS_RANGE = (1, 4)\nSTRUCT_SHAPE_RETRIES = 8             # per-shape placement retries\nRECT_MAX_DIM_DIV = 3                 # rect max side ~ dim // 3\nTRI_MAX_SIZE = 6                     # diamond/triangle cap on size\nTRI_MIN_DIM_DIV = 3                  # diamond/top-tri need dim // 3\n\n# ---- Reachable region gate ----\nREACH_RATIO_RANGE = (0.38, 0.87)\n\n# ---- Decorations ----\nNUM_DECOR_RANGE = (0, 3)\nDECOR_AREA_RANGE = (1, 4)            # max pixel-extent of a single decor patch\nDECOR_BORDER = 1                     # stay >= N cells from grid edge\nDECOR_PADDING = 1                    # 8-conn separation from other occupancy\n\n# ---- Outer retry budget ----\nGEN_ATTEMPTS = 300\n\n\n# =============================================================================\n# Shape factories (each returns list[(r,c)] or None for a 4-contiguous shape\n# that touches at least one grid edge).\n# =============================================================================\n\ndef _shape_vertical_line(h, w, rng):\n    c = rng.randint(2, w - 2)\n    mode = rng.choice(['top', 'bottom', 'full'])\n    if mode == 'full':\n        r0, r1 = 0, h - 1\n    elif mode == 'top':\n        r0, r1 = 0, rng.randint(max(1, h // 3), h - 2)\n    else:\n        r0, r1 = rng.randint(1, h - max(2, h // 3)), h - 1\n    return [(r, c) for r in range(r0, r1 + 1)]\n\n\ndef _shape_horizontal_line(h, w, rng):\n    r = rng.randint(1, h - 2)\n    if rng.choice(['left', 'right']) == 'left':\n        c0, c1 = 0, rng.randint(max(1, w // 3), w - 2)\n    else:\n        c0, c1 = rng.randint(1, w - max(2, w // 3)), w - 1\n    return [(r, c) for c in range(c0, c1 + 1)]\n\n\ndef _shape_rectangle(h, w, rng):\n    rh = rng.randint(2, max(2, h // RECT_MAX_DIM_DIV))\n    rw = rng.randint(2, max(2, w // RECT_MAX_DIM_DIV))\n    anchor = rng.choice(['top', 'right', 'tr', 'top_mid', 'right_mid', 'bottom_right'])\n    if anchor == 'top':\n        r0, c0 = 0, rng.randint(1, max(1, w - rw - 1))\n    elif anchor == 'right':\n        r0, c0 = rng.randint(1, max(1, h - rh - 1)), w - rw\n    elif anchor == 'tr':\n        r0, c0 = 0, w - rw\n    elif anchor == 'top_mid':\n        r0, c0 = 0, rng.randint(2, max(2, w - rw - 2))\n    elif anchor == 'right_mid':\n        r0, c0 = rng.randint(2, max(2, h - rh - 2)), w - rw\n    else:\n        r0, c0 = h - rh, w - rw\n    return [(r, c) for r in range(r0, r0 + rh) for c in range(c0, c0 + rw)]\n\n\ndef _shape_left_diamond(h, w, rng):\n    \"\"\"Isoceles diamond attached to left edge.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 3:\n        return None\n    size = rng.randint(3, max_size)\n    r_center = rng.randint(size, h - size - 1)\n    top = r_center - (size - 1)\n    cells = []\n    for i in range(size):\n        cells.extend((top + i, c) for c in range(i + 1))\n    for i in range(size - 1):\n        cells.extend((top + size + i, c) for c in range(size - 1 - i))\n    return cells\n\n\ndef _shape_top_triangle(h, w, rng):\n    \"\"\"Right triangle on top edge, widest at top.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // TRI_MIN_DIM_DIV, w // TRI_MIN_DIM_DIV)\n    if max_size < 2:\n        return None\n    size = rng.randint(2, max_size)\n    c_start = rng.randint(1, max(1, w - 2 * size))\n    cells = []\n    for i in range(size):\n        cells.extend((i, c) for c in range(c_start, c_start + size - i))\n    return cells\n\n\ndef _shape_right_triangle(h, w, rng):\n    \"\"\"Right triangle on right edge, widest at bottom.\"\"\"\n    max_size = min(TRI_MAX_SIZE, h // 2, w // 2)\n    if max_size < 2:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _marker_side(g: np.ndarray, bg: int) -> tuple[str, int]:\n    sides: list[tuple[str, int]] = []\n    for color in set(map(int, g.ravel())) - {bg}:\n        if np.all(g[0, :] == color):\n            sides.append((\"top\", color))\n        if np.all(g[:, -1] == color):\n            sides.append((\"right\", color))\n        if np.all(g[-1, :] == color):\n            sides.append((\"bottom\", color))\n        if np.all(g[:, 0] == color):\n            sides.append((\"left\", color))\n\n    assert len(sides) == 1, sides\n    return sides[0]\n\n\ndef _symbolic_grid(g: np.ndarray) -> tuple[np.ndarray, str, int]:\n    bg = get_bg(g)\n    side, marker = _marker_side(g, bg)\n    assert marker == 1, marker\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    objects: list[tuple[int, int, int]] = []\n    for component in components:\n        color = component[\"color\"]\n        if color == marker:\n            continue\n\n        b = component[\"bbox\"]\n        assert component[\"area\"] == 8, component\n        assert bbox_h(b) == 3 and bbox_w(b) == 3, component\n\n        r0, c0, r1, c1 = b\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        expected = np.full((3, 3), color, dtype=int)\n        expected[1, 1] = bg\n        assert np.array_equal(patch, expected), patch\n        objects.append((r0, c0, color))\n\n    assert objects\n    rows = sorted({r for r, _c, _color in objects})\n    cols = sorted({c for _r, c, _color in objects})\n    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)\n    row_index = {r: i for i, r in enumerate(rows)}\n    col_index = {c: i for i, c in enumerate(cols)}\n\n    for r, c, color in objects:\n        rr = row_index[r]\n        cc = col_index[c]\n        assert symbolic[rr, cc] == bg\n        symbolic[rr, cc] = color\n\n    if side in (\"top\", \"bottom\"):\n        dominant_cols = range(3, 6) if side == \"top\" else range(0, 3)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in range(symbolic.shape[0])\n            for c in dominant_cols\n            if int(symbolic[r, c]) != bg\n        ]\n    else:\n        dominant_rows = range(0, 3) if side == \"left\" else range(3, 6)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in dominant_rows\n            for c in range(symbolic.shape[1])\n            if int(symbolic[r, c]) != bg\n        ]\n    assert dominant_values and set(dominant_values) == {8}, dominant_values\n\n    return symbolic, side, bg\n\n\ndef _compact(symbolic: np.ndarray, side: str, bg: int) -> np.ndarray:\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\n","exit_code":0,"status":"completed"}}
