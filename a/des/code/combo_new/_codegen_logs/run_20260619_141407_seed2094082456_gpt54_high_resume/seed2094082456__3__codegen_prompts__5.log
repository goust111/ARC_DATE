{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n","exit_code":0,"status":"completed"}}
