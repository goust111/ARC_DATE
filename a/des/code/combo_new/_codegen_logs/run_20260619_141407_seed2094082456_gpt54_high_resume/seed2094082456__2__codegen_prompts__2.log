{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import defaultdict, deque\n\ndef trim(mask):\n    rows = np.any(mask, axis=1)\n    cols = np.any(mask, axis=0)\n    return mask[rows][:, cols]\n\ndef conn(mask):\n    coords = np.argwhere(mask)\n    if len(coords)==0:\n        return False\n    H,W=mask.shape\n    seen={tuple(coords[0])}\n    q=deque([tuple(coords[0])])\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc))\n                q.append((nr,nc))\n    return len(seen)==len(coords)\n\ncounts=defaultdict(int)\nseen=defaultdict(set)\nfor h in range(2,6):\n  for w in range(2,6):\n    if h*w>16: continue\n    for code in range(1<<(h*w)):\n      k=code.bit_count()\n      if not (4<=k<=8):\n        continue\n      arr=np.array([(code>>i)&1 for i in range(h*w)],dtype=bool).reshape(h,w)\n      if not np.any(arr[0]) or not np.any(arr[-1]) or not np.any(arr[:,0]) or not np.any(arr[:,-1]):\n        continue\n      if not conn(arr):\n        continue\n      hs=np.array_equal(arr,np.flipud(arr))\n      vs=np.array_equal(arr,np.fliplr(arr))\n      rs=np.array_equal(arr,np.rot90(arr,2))\n      cat=None\n      if hs and not vs and not rs: cat='H'\n      elif vs and not hs and not rs: cat='V'\n      elif rs and not hs and not vs: cat='R'\n      else: continue\n      key=(arr.shape,arr.tobytes())\n      if key not in seen[cat]:\n        seen[cat].add(key)\n        counts[cat]+=1\nprint(counts)\nfor cat in 'HVR':\n  areas=defaultdict(int)\n  for shape,buf in seen[cat]:\n    arr=np.frombuffer(buf,dtype=bool).reshape(shape)\n    areas[int(arr.sum())]+=1\n  print(cat, dict(sorted(areas.items())))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
