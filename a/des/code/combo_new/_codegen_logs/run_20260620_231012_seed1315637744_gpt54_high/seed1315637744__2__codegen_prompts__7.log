{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/825aa9e9.py\"","aggregated_output":"import math\nimport random\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, paste\n\n\ndef _blocked_mask(g: np.ndarray, obstacle: int) -> np.ndarray:\n    obstacle_mask = g == int(obstacle)\n    cushion = np.zeros_like(obstacle_mask, dtype=bool)\n    cushion[:-1, :] = obstacle_mask[1:, :]\n    bottom_edge = np.zeros_like(obstacle_mask, dtype=bool)\n    bottom_edge[-1, :] = True\n    return obstacle_mask | cushion | bottom_edge\n\n\ndef _assert_output_separated(out: np.ndarray, obstacle: int, moving: int) -> None:\n    obstacle_mask = out == int(obstacle)\n    near_obstacle = np.zeros_like(obstacle_mask, dtype=bool)\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n\n            src_r0 = max(0, -dr)\n            src_r1 = out.shape[0] - max(0, dr)\n            src_c0 = max(0, -dc)\n            src_c1 = out.shape[1] - max(0, dc)\n            dst_r0 = max(0, dr)\n            dst_r1 = out.shape[0] - max(0, -dr)\n            dst_c0 = max(0, dc)\n            dst_c1 = out.shape[1] - max(0, -dc)\n            near_obstacle[dst_r0:dst_r1, dst_c0:dst_c1] |= obstacle_mask[\n                src_r0:src_r1, src_c0:src_c1\n            ]\n\n    assert not np.any((out == int(moving)) & near_obstacle), (\n        \"settled moving objects must not be 8-connected to obstacles\"\n    )\n\n\ndef _obstacle_column_heights(g: np.ndarray, obstacle: int) -> list[int]:\n    heights = []\n    obstacle_mask = g == int(obstacle)\n    H, W = map(int, g.shape)\n    for c in range(W):\n        rows = np.flatnonzero(obstacle_mask[:, c])\n        heights.append(0 if len(rows) == 0 else H - int(rows[0]))\n    return heights\n\n\ndef _assert_obstacle_profile(g: np.ndarray, obstacle: int) -> None:\n    heights = _obstacle_column_heights(g, obstacle)\n    occupied = [h for h in heights if h > 0]\n    assert occupied, \"obstacle must occupy at least one bottom-supported column\"\n\n    H, W = map(int, g.shape)\n    obstacle_mask = g == int(obstacle)\n    total = int(obstacle_mask.sum())\n    bottom3 = int(obstacle_mask[max(0, H - 3) :, :].sum())\n\n    assert len(occupied) * 3 >= W, \"obstacle must cover a substantial part of the bottom\"\n    assert sum(occupied) * 4 <= len(occupied) * 13, (\n        \"obstacle columns must be low on average\"\n    )\n    assert bottom3 * 5 >= total * 3, \"obstacle pixels must be mostly near the bottom\"\n\n\ndef _infer_roles(g: np.ndarray) -> tuple[int, int, int]:\n    colors = colors_present(g)\n    assert len(colors) == 3, \"expected background, obstacle, and moving colors\"\n\n    candidates = []\n    for bg in colors:\n        for obstacle in colors:\n            if obstacle == bg or not np.any(g[-1, :] == obstacle):\n                continue\n            for moving in colors:\n                if moving in (bg, obstacle) or np.any(g[-1, :] == moving):\n                    continue\n                blocked = _blocked_mask(g, obstacle)\n                if np.any(blocked & (g == moving)):\n                    continue\n                candidates.append((int(bg), int(obstacle), int(moving)))\n\n    assert len(candidates) == 1, \"roles must be uniquely determined\"\n    return candidates[0]\n\n\ndef _movable_components(out: np.ndarray, bg: int, moving: int, blocked: np.ndarray) -> list[tuple[np.ndarray, np.ndarray]]:\n    moving_mask = out == int(moving)\n    moves = []\n    for comp in find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[moving]):\n        coords = comp[\"coords\"]\n        shifted = coords + np.array([1, 0])\n        if int(shifted[:, 0].max()) >= int(out.shape[0]):\n            continue\n        if np.any(blocked[shifted[:, 0], shifted[:, 1]]):\n            continue\n\n        other_moving = moving_mask.copy()\n        other_moving[coords[:, 0], coords[:, 1]] = False\n        if np.any(other_moving[shifted[:, 0], shifted[:, 1]]):\n            continue\n        moves.append((coords, shifted))\n    return moves\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.\n\n    Input structure:\n    - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.\n    - The obstacle color is the unique non-background role that touches the bottom edge.\n    - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.\n\n    Rule:\n    - Keep the background and obstacle pixels fixed.\n    - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.\n    - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.\n\n    Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, obstacle, moving = _infer_roles(g)\n    _assert_obstacle_profile(g, obstacle)\n    blocked = _blocked_mask(g, obstacle)\n    assert not np.any(blocked & (g == moving)), \"moving pixels must start in free cells\"\n\n    out = g.copy()\n    while True:\n        moves = _movable_components(out, bg, moving, blocked)\n        if not moves:\n            break\n        for coords, _ in moves:\n            out[coords[:, 0], coords[:, 1]] = bg\n        for _, shifted in moves:\n            out[shifted[:, 0], shifted[:, 1]] = moving\n\n    _assert_output_separated(out, obstacle, moving)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nGRID_H_RANGE = (4, 10)\nGRID_W_RANGE = (7, 20)\n\n# Obstacle profile constraints.\nOBSTACLE_COVERAGE_RANGE = (0.08, 0.52)\nPOCKET_COUNT_RANGE = (1, 5)\nDISTINCT_HEIGHT_COUNT_RANGE = (2, 4)\nOBSTACLE_COMPONENT_RANGE = (1, 3)\nBOTTOM_BAND_ROWS = 3\nBOTTOM_COLS_MIN_MULTIPLIER = 3\nCOLUMN_AVG_MAX_NUM = 13\nCOLUMN_AVG_MAX_DEN = 4\nBOTTOM3_MIN_NUM = 3\nBOTTOM3_MIN_DEN = 5\n\n# Bottom-heavy profile sampling.\nPROFILE_RETRIES = 120\nBOTTOM_HEAVY_WEIGHT = 5\nLOW_COLUMN_EXTRA_PROB = 0.35\nLOW_COLUMN_HEIGHT2_PROB = 0.25\nTALL_RUN_COUNT_MAX = 3\nTALL_RUN_WIDTH2_MIN_W = 10\nTALL_RUN_WIDTH2_PROB = 0.25\nMEDIUM_RUN_PROB = 0.45\nMEDIUM_RUN_WIDTH_MAX = 4\nSHORT_OBSTACLE_MAX_H = 4\nMEDIUM_RUN_HEIGHT_MIN = 2\n\n# Sparse post profile sampling.\nWIDTH_PLACEMENT_RETRIES = 80\nSPARSE_POST_MIN_BOTTOM_FRAC = 3\nSPARSE_POST_MAX_BOTTOM_FRAC = 0.45\nSPARSE_POST_RUN_COUNT_MAX = 3\nSPARSE_POST_HEIGHT1_PROB = 0.8\n\n# Moving object sampling and validation.\nPALETTE_SIZE = 10\nOBJECT_COUNT_RANGE = (1, 3)\nOBJECT_AREA_RANGE = (1, 21)\nOBJECT_BBOX_MAX_H = 6\nOBJECT_BBOX_MAX_W = 7\nMIN_LIFT_ROWS = 1\nMAX_LIFT_ROWS = 4\n\n# Whole-input retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _spread_extra(widths, extra):\n    widths = list(widths)\n    for _ in range(int(extra)):\n        widths[random.randrange(len(widths))] += 1\n    return widths\n\n\ndef _blocked_from_heights(heights, H):\n    first = []\n    for h in heights:\n        first.append(H - 1 if h == H else max(0, h - 1))\n    return np.array(first, dtype=int)\n\n\ndef _pocket_count(heights):\n    min_h = min(heights)\n    count = 0\n    in_run = False\n    for h in heights:\n        if h > min_h:\n            if not in_run:\n                count += 1\n                in_run = True\n        else:\n            in_run = False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport itertools\nimport random\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return max(int(a0), int(b0)) <= min(int(a1), int(b1))\n\n\ndef _is_solid_2x2(comp: dict, g: np.ndarray) -> bool:\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == 4\n        and int(r1 - r0 + 1) == 2\n        and int(c1 - c0 + 1) == 2\n        and bool((g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])).all())\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nfrom scipy.ndimage import binary_dilation\n\nimport random\n\nfrom arc_utils import (\n    Color,\n    STRUCT8,\n    colors_present,\n    components_mask,\n    get_bg,\n    in_bounds,\n    label_mask,\n    neighbors4,\n)\n\n\ndef _path_color(g: np.ndarray, bg: int) -> int:\n    candidates = []\n    for color in colors_present(g, exclude={bg}):\n        comps = components_mask(g == color, connectivity=4)\n        if len(comps) == 2:\n            candidates.append(int(color))\n\n    assert len(candidates) == 1, \"expected exactly one color forming two path components\"\n    return candidates[0]\n\n\ndef _adjacent_path_labels(labels: np.ndarray, r: int, c: int) -> set[int]:\n    adjacent = set()\n    for rr, cc in neighbors4(r, c):\n        if in_bounds(labels.shape, rr, cc) and labels[rr, cc] > 0:\n            adjacent.add(int(labels[rr, cc]))\n    return adjacent\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the top-connected middle channel between two orange path components teal.\n\n    Input structure\n    - The background is black.\n    - One foreground color forms exactly two 4-connected one-pixel-wide path components.\n    - Optional non-background control pixels may sit in the channel between the two paths.\n\n    Rule\n    - Dilate each path component by one cell in the 8-neighborhood and intersect the two dilations; this gives the one-cell-wide middle channel.\n    - A control pixel in that channel is a blocker only when its 4-neighbors touch fewer than both path components; otherwise it is part of the channel and is repainted.\n    - After removing blockers, paint the channel component connected to the top edge teal and keep all other pixels unchanged.\n\n    Key insight\n    - The desired pixels are not found by region filling; they are the geometric overlap of the two paths' one-cell halos, with weakly attached control pixels splitting the channel.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = get_bg(g)\n    assert bg == Color.BLACK, \"expected black background\"\n\n    path_color = _path_color(g, bg)\n    path_labels, n_paths = label_mask(g == path_color, connectivity=4)\n    assert n_paths == 2, \"expected two path components\"\n\n    channel = g != path_color\n    for label_id in range(1, n_paths + 1):\n        channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)\n    assert np.any(channel), \"expected a middle channel between the paths\"\n\n    blocked = []\n    for r_raw, c_raw in np.argwhere(channel & (g != bg)):\n        r = int(r_raw)\n        c = int(c_raw)\n        adjacent = _adjacent_path_labels(path_labels, r, c)\n        assert adjacent, \"control pixel in channel must touch a path component\"\n        if len(adjacent) < n_paths:\n            blocked.append((r, c))\n        else:\n            assert len(adjacent) == n_paths, \"channel control pixel cannot touch extra path labels\"\n\n    passable = channel.copy()\n    for r, c in blocked:\n        passable[r, c] = False\n\n    channel_labels, n_channels = label_mask(passable, connectivity=4)\n    assert n_channels >= 1, \"expected at least one passable channel component\"\n    top_components = [\n        label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)\n    ]\n    assert len(top_components) == 1, \"expected exactly one channel component connected to the top edge\"\n\n    paint = channel_labels == top_components[0]\n    assert np.any(paint), \"expected cells to paint\"\n    out = g.copy()\n    out[paint] = Color.TEAL\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and channel bounds.\nGEN_GRID_SHAPE = (10, 10)\nGEN_TOP_ROW = 0\nGEN_BOTTOM_ROW = 9\nGEN_LEFT_COL = 0\nGEN_RIGHT_COL = 9\nGEN_MIN_CHANNEL_COL = 1\nGEN_MAX_CHANNEL_COL = 8\n\n# Segment and turn sampling.\nGEN_MIN_TURNS = 2\nGEN_MAX_TURNS = 4\nGEN_VERTICAL_MIN = 2\nGEN_VERTICAL_MAX = 7\nGEN_VERTICAL_TOTAL_MIN = 6\nGEN_VERTICAL_TOTAL_MAX = 9\nGEN_FULL_HEIGHT_TOTAL = 9\nGEN_FULL_HEIGHT_PROB = 0.8\nGEN_HORIZONTAL_MIN = 2\nGEN_HORIZONTAL_MAX = 4\nGEN_HORIZONTAL_BUDGET = 7\n\n# Optional blocker placement.\nGEN_BLOCKER_PROB = 0.6\nGEN_BLOCKING_BLOCKER_PROB = 0.55\n\n# Retry budget for rejected geometry.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_walk_segment(path, dr, dc, steps):\n    r, c = path[-1]\n    for _ in range(steps):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _gen_directions(hdir, turns):\n    directions = [(1, 0)]\n    for i in range(turns):\n        directions.append((0, hdir) if i % 2 == 0 else (1, 0))\n    return directions\n\n\ndef _gen_partition_total(total, count, minimum, maximum):\n    \"\"\"Randomly split total into count bounded positive steps.\"\"\"\n    steps = []\n    remaining = total\n    for i in range(count - 1):\n        rest = count - i - 1\n        hi = min(maximum, remaining - minimum * rest)\n        lo = max(minimum, remaining - maximum * rest)\n        val = random.randint(lo, hi)\n        steps.append(val)\n        remaining -= val\n    steps.append(remaining)\n    return steps\n\n\ndef _gen_vertical_steps(directions):\n    v_count = sum(1 for d in directions if d == (1, 0))\n    if directions[-1] == (1, 0) and random.random() < GEN_FULL_HEIGHT_PROB:\n        total = GEN_FULL_HEIGHT_TOTAL\n    else:\n        total = random.randint(GEN_VERTICAL_TOTAL_MIN, GEN_VERTICAL_TOTAL_MAX)\n    return _gen_partition_total(total, v_count, GEN_VERTICAL_MIN, GEN_VERTICAL_MAX)\n\n\ndef _gen_horizontal_steps(h_count):\n    steps = []\n    remaining = GEN_HORIZONTAL_BUDGET\n    for i in range(h_count):\n        hi = min(GEN_HORIZONTAL_MAX, remaining - GEN_HORIZONTAL_MIN * (h_count - i - 1))\n        step = random.randint(GEN_HORIZONTAL_MIN, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_start_col(hdir, h_steps):\n    total_h = sum(h_steps)\n    if hdir == 1:\n        return random.randint(GEN_MIN_CHANNEL_COL, GEN_MAX_CHANNEL_COL - total_h)\n    return random.randint(GEN_MIN_CHANNEL_COL + total_h, GEN_MAX_CHANNEL_COL)\n\n\ndef _gen_channel_path():\n    hdir = random.choice([-1, 1])\n    turns = random.randint(GEN_MIN_TURNS, GEN_MAX_TURNS)\n    directions = _gen_directions(hdir, turns)\n    v_steps = _gen_vertical_steps(directions)\n    h_steps = _gen_horizontal_steps(sum(1 for d in directions if d[0] == 0))\n    start_c = _gen_start_col(hdir, h_steps)\n\n    path = [(GEN_TOP_ROW, start_c)]\n    vi = 0\n    hi = 0\n    for dr, dc in directions:\n        if dr:\n            steps = v_steps[vi]\n            vi += 1\n        else:\n            steps = h_steps[hi]\n            hi += 1\n        _gen_walk_segment(path, dr, dc, steps)\n\n    if any(\n        r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_MIN_CHANNEL_COL or c > GEN_MAX_CHANNEL_COL\n        for r, c in path\n    ):\n        return None\n    return path\n\n\ndef _gen_left_normal(dr, dc):\n    return -dc, dr\n\n\ndef _gen_wall_sets(path):\n    left = set()\n","exit_code":0,"status":"completed"}}
