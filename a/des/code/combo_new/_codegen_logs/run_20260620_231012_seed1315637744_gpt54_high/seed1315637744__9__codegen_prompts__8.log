{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, label_mask, paste\nimport random\n\n\nclass _Node:\n    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):\n        self.coords = coords\n        self.bbox = bbox\n        self.center = center\n        self.is_frame = False\n        self.parent: _Node | None = None\n        self.children: list[_Node] = []\n        self.mask: np.ndarray | None = None\n        self.anchor: tuple[int, int] | None = None\n        self.axis_map: dict[str, list[tuple[float, int]]] = {\"row\": [], \"col\": []}\n\n\ndef _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:\n    mask = np.zeros(shape, dtype=bool)\n    mask[tuple(coords.T)] = True\n    lab, n = label_mask(~mask, connectivity=4)\n    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])\n    return [(lab == k) for k in range(1, n + 1) if k not in boundary]\n\n\ndef _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:\n    return max(a[0], b[0]) <= min(a[1], b[1])\n\n\ndef _build_layout(node: _Node) -> None:\n    if node.mask is not None:\n        return\n\n    if not node.is_frame:\n        node.mask = np.ones((1, 1), dtype=bool)\n        node.anchor = (0, 0)\n        node.axis_map = {\n            \"row\": [(float(node.center[0]), 0)],\n            \"col\": [(float(node.center[1]), 0)],\n        }\n        return\n\n    assert node.children\n    child_mask, _placements, axis_map = _layout_group(node.children)\n    h, w = child_mask.shape\n    out = np.zeros((h + 4, w + 4), dtype=bool)\n    out[0, :] = True\n    out[-1, :] = True\n    out[:, 0] = True\n    out[:, -1] = True\n    out[2 : 2 + h, 2 : 2 + w] |= child_mask\n\n    node.mask = out\n    node.anchor = (out.shape[0] // 2, out.shape[1] // 2)\n    node.axis_map = {\n        \"row\": [(orig, pos + 2) for orig, pos in axis_map[\"row\"]],\n        \"col\": [(orig, pos + 2) for orig, pos in axis_map[\"col\"]],\n    }\n\n\ndef _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:\n    items = []\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r0, c0, r1, c1 = node.bbox\n        interval = (r0, r1) if axis == 0 else (c0, c1)\n        mid = (interval[0] + interval[1]) / 2\n        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))\n\n    bands: list[dict] = []\n    for item in sorted(items, key=lambda x: x[2]):\n        interval = item[1]\n        for band in bands:\n            if any(_intervals_overlap(interval, other[1]) for other in band[\"items\"]):\n                band[\"items\"].append(item)\n                band[\"interval\"] = (\n                    min(band[\"interval\"][0], interval[0]),\n                    max(band[\"interval\"][1], interval[1]),\n                )\n                break\n        else:\n            bands.append({\"items\": [item], \"interval\": interval})\n\n    coord_by_node: dict[_Node, int] = {}\n    coord = 0\n    for i, band in enumerate(bands):\n        if i:\n            prev = bands[i - 1]\n            prev_down = max(item[4] - 1 - item[3] for item in prev[\"items\"])\n            curr_up = max(item[3] for item in band[\"items\"])\n            coord += prev_down + 2 + curr_up\n        for item in band[\"items\"]:\n            coord_by_node[item[0]] = int(coord)\n\n    return coord_by_node\n\n\ndef _layout_group(nodes: list[_Node]) -> tuple[np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    row_coord = _axis_coordinates(nodes, axis=0)\n    col_coord = _axis_coordinates(nodes, axis=1)\n\n    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)\n    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)\n    max_r = max(\n        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n    max_c = max(\n        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n\n    out = np.zeros((max_r, max_c), dtype=bool)\n    placements: dict[_Node, tuple[int, int]] = {}\n    axis_map = {\"row\": [], \"col\": []}\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r = row_coord[node] - node.anchor[0] - min_r\n        c = col_coord[node] - node.anchor[1] - min_c\n        placements[node] = (int(r), int(c))\n        out[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask\n        axis_map[\"row\"].append((float(node.center[0]), int(r + node.anchor[0])))\n        axis_map[\"col\"].append((float(node.center[1]), int(c + node.anchor[1])))\n\n    return out, placements, axis_map\n\n\ndef _outside_side(dot: _Node, frame: _Node) -> str:\n    r0, c0, r1, c1 = dot.bbox\n    fr0, fc0, fr1, fc1 = frame.bbox\n    if c0 > fc1:\n        return \"right\"\n    if c1 < fc0:\n        return \"left\"\n    if r0 > fr1:\n        return \"bottom\"\n    if r1 < fr0:\n        return \"top\"\n\n    dr = float(dot.center[0] - (fr0 + fr1) / 2)\n    dc = float(dot.center[1] - (fc0 + fc1) / 2)\n    if abs(dc) >= abs(dr):\n        return \"right\" if dc > 0 else \"left\"\n    return \"bottom\" if dr > 0 else \"top\"\n\n\ndef _map_frame_axis(frame: _Node, axis: int, value: float) -> int:\n    assert frame.anchor is not None\n    key = \"row\" if axis == 0 else \"col\"\n    candidates = frame.axis_map[key]\n    if not candidates:\n        return int(frame.anchor[axis])\n    return int(min(candidates, key=lambda item: abs(item[0] - value))[1])\n\n\ndef _layout_root(nodes: list[_Node]) -> np.ndarray:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    frames = [node for node in nodes if node.is_frame]\n    dots = [node for node in nodes if not node.is_frame]\n    if len(frames) == 1 and dots:\n        frame = frames[0]\n        assert frame.mask is not None\n        placements: dict[_Node, tuple[int, int]] = {frame: (0, 0)}\n        extents = [(0, 0, frame.mask.shape[0], frame.mask.shape[1])]\n\n        for dot in dots:\n            side = _outside_side(dot, frame)\n            if side in {\"right\", \"left\"}:\n                r = _map_frame_axis(frame, 0, float(dot.center[0]))\n                c = frame.mask.shape[1] + 1 if side == \"right\" else -2\n            else:\n                r = frame.mask.shape[0] + 1 if side == \"bottom\" else -2\n                c = _map_frame_axis(frame, 1, float(dot.center[1]))\n            placements[dot] = (int(r), int(c))\n            extents.append((r - 1, c - 1, r + 2, c + 2))\n\n        min_r = min(e[0] for e in extents)\n        min_c = min(e[1] for e in extents)\n        max_r = max(e[2] for e in extents)\n        max_c = max(e[3] for e in extents)\n        out = np.zeros((max_r - min_r, max_c - min_c), dtype=bool)\n        for node, (r, c) in placements.items():\n            rr = r - min_r\n            cc = c - min_c\n            if node is frame:\n                out[rr : rr + frame.mask.shape[0], cc : cc + frame.mask.shape[1]] |= frame.mask\n            else:\n                out[rr, cc] = True\n        return out\n\n    mask, _placements, _axis_map = _layout_group(nodes)\n    return mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, paste, random_free_location\nimport random\n\n\ndef _split_panels(g: np.ndarray) -> tuple[list[np.ndarray], set[int]]:\n    h, w = g.shape\n    candidates: list[tuple[list[np.ndarray], set[int]]] = []\n\n    for horizontal in (False, True):\n        dim = w if horizontal else h\n        for n in range(3, dim + 1):\n            if dim % n:\n                continue\n            ph, pw = (h, w // n) if horizontal else (h // n, w)\n            if ph < 2 or pw < 2:\n                continue\n            if horizontal:\n                panels = [g[:, i * pw : (i + 1) * pw] for i in range(n)]\n            else:\n                panels = [g[i * ph : (i + 1) * ph, :] for i in range(n)]\n\n            template = panels[-1]\n            template_colors = set(map(int, template.ravel()))\n            diff_colors: set[int] = set()\n            diff_counts = []\n            for panel in panels[:-1]:\n                diff = panel != template\n                diff_counts.append(int(diff.sum()))\n                diff_colors.update(map(int, panel[diff].ravel()))\n\n            if not diff_colors or not all(diff_counts):\n                continue\n            if diff_colors & template_colors:\n                continue\n            occurrences = {\n                color: sum(bool(np.any(panel == color)) for panel in panels[:-1])\n                for color in diff_colors\n            }\n            if not all(count >= 2 for count in occurrences.values()):\n                continue\n            candidates.append((panels, diff_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _intervals(line: np.ndarray) -> list[tuple[int, int]]:\n    out: list[tuple[int, int]] = []\n    i = 0\n    while i < len(line):\n        if not line[i]:\n            i += 1\n            continue\n        j = i\n        while j + 1 < len(line) and line[j + 1]:\n            j += 1\n        out.append((i, j))\n        i = j + 1\n    return out\n\n\ndef _shift_intervals(\n    intervals: list[tuple[int, int]], step: int, length: int\n) -> list[tuple[int, int]]:\n    shifted = []\n    for start, end in intervals:\n        new_start = start + step\n        new_end = end + step\n        assert 0 <= new_start <= new_end < length\n        shifted.append((new_start, new_end))\n    return shifted\n\n\ndef _is_prefix(shorter: list[tuple[int, int]], longer: list[tuple[int, int]]) -> bool:\n    return len(shorter) <= len(longer) and all(a == b for a, b in zip(shorter, longer))\n\n\ndef _required_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _motion_axis(a: np.ndarray, b: np.ndarray) -> tuple[int, int]:\n    ar0, ac0, ar1, ac1 = _required_bbox(a)\n    br0, bc0, br1, bc1 = _required_bbox(b)\n    row_motion = abs(br0 - ar0) + abs(br1 - ar1)\n    col_motion = abs(bc0 - ac0) + abs(bc1 - ac1)\n    assert row_motion != col_motion\n\n    if row_motion > col_motion:\n        deltas = [br0 - ar0, br1 - ar1]\n        axis = 0\n    else:\n        deltas = [bc0 - ac0, bc1 - ac1]\n        axis = 1\n    nonzero = [delta for delta in deltas if delta]\n    assert nonzero and all((delta > 0) == (nonzero[0] > 0) for delta in nonzero)\n    direction = 1 if nonzero[0] > 0 else -1\n    return axis, direction\n\n\ndef _draw_intervals(mask: np.ndarray, axis: int, line: int, intervals: list[tuple[int, int]]) -> None:\n    for start, end in intervals:\n        if axis == 0:\n            mask[start : end + 1, line] = True\n        else:\n            mask[line, start : end + 1] = True\n\n\ndef _extrapolate_mask(a: np.ndarray, b: np.ndarray) -> np.ndarray:\n    assert a.any() and b.any()\n    assert not np.array_equal(a, b)\n\n    axis, direction = _motion_axis(a, b)\n    added = b & ~a\n    assert added.any()\n    added_coords = np.argwhere(added)\n    extent = int(added_coords[:, axis].max() - added_coords[:, axis].min() + 1)\n    global_step = direction * extent\n\n    out = np.zeros_like(b, dtype=bool)\n    line_count = b.shape[1 - axis]\n    length = b.shape[axis]\n    for line in range(line_count):\n        if axis == 0:\n            a_intervals = _intervals(a[:, line])\n            b_intervals = _intervals(b[:, line])\n        else:\n            a_intervals = _intervals(a[line, :])\n            b_intervals = _intervals(b[line, :])\n\n        if not a_intervals and not b_intervals:\n            next_intervals: list[tuple[int, int]] = []\n        elif a_intervals and len(a_intervals) == len(b_intervals):\n            next_intervals = []\n            for (a0, a1), (b0, b1) in zip(a_intervals, b_intervals):\n                new_start = b0 + (b0 - a0)\n                new_end = b1 + (b1 - a1)\n                assert 0 <= new_start <= new_end < length\n                next_intervals.append((new_start, new_end))\n        elif a_intervals and _is_prefix(a_intervals, b_intervals):\n            extra_count = len(b_intervals) - len(a_intervals)\n            assert 0 < extra_count <= len(a_intervals)\n            previous = a_intervals[-extra_count:]\n            extra = b_intervals[-extra_count:]\n            steps = {\n                end_new - end_old\n                for old, new in zip(previous, extra)\n                for end_old, end_new in zip(old, new)\n            }\n            assert len(steps) == 1\n            step = steps.pop()\n            assert step\n            next_intervals = list(b_intervals) + _shift_intervals(extra, step, length)\n        elif not a_intervals and b_intervals:\n            next_intervals = list(b_intervals) + _shift_intervals(\n                b_intervals, global_step, length\n            )\n        else:\n            raise AssertionError\n\n        _draw_intervals(out, axis, line, next_intervals)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef _sym_orbits(h: int, w: int) -> list[list[tuple[int, int]]]:\n    seen: set[tuple[int, int]] = set()\n    orbits: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if r not in (0, h - 1) and c not in (0, w - 1):\n                continue\n            if (r, c) in seen:\n                continue\n            orbit = sorted({(r, c), (r, w - 1 - c), (h - 1 - r, c), (h - 1 - r, w - 1 - c)})\n            seen.update(orbit)\n","exit_code":0,"status":"completed"}}
