{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo_new/seed1315637744/11/3.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\n\nBG = 0\nBLUE = 1\nRED = 2\nGREEN = 3\nYELLOW = 4\nGREY = 5\nMAGENTA = 6\n\n_RING_COLORS = (BLUE, YELLOW, GREEN, MAGENTA)\n\n_LEGEND_SAMPLE_SIZE = 7\n_LEGEND_CELL_HEIGHT = 1 + _LEGEND_SAMPLE_SIZE\n_LEGEND_COL_GAP = 1\n_LEGEND_ROW_GAP = 0\n_LEGEND_HEIGHT = 2 * _LEGEND_CELL_HEIGHT + _LEGEND_ROW_GAP\n_LEGEND_WIDTH = 2 * _LEGEND_SAMPLE_SIZE + _LEGEND_COL_GAP\n\n_GRID_MIN = 26\n_GRID_MAX = 30\n_GEN_RETRIES = 400\n\n\ndef _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:\n    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))\n\n\ndef _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    h, w = mask.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps: list[list[tuple[int, int]]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q = deque([(r, c)])\n            seen[r, c] = True\n            comp: list[tuple[int, int]] = []\n            while q:\n                cr, cc = q.popleft()\n                comp.append((cr, cc))\n                for nr, nc in _neighbors4(cr, cc):\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            comps.append(comp)\n    return comps\n\n\ndef _ring_template(level: int) -> np.ndarray:\n    size = 2 * level - 1\n    patch = np.full((size, size), BG, dtype=int)\n    for inset in range(level):\n        color = _RING_COLORS[inset]\n        lo = inset\n        hi = size - 1 - inset\n        patch[lo, lo : hi + 1] = color\n        patch[hi, lo : hi + 1] = color\n        patch[lo : hi + 1, lo] = color\n        patch[lo : hi + 1, hi] = color\n    return patch\n\n\ndef _find_rect_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:\n    rects: list[tuple[int, int, int, int]] = []\n    for comp in _components_mask(grid == GREY):\n        pts = set(comp)\n        rows = [r for r, _ in comp]\n        cols = [c for _, c in comp]\n        r0, r1 = min(rows), max(rows)\n        c0, c1 = min(cols), max(cols)\n        if r1 - r0 < 2 or c1 - c0 < 2:\n            continue\n        border = set()\n        for c in range(c0, c1 + 1):\n            border.add((r0, c))\n            border.add((r1, c))\n        for r in range(r0 + 1, r1):\n            border.add((r, c0))\n            border.add((r, c1))\n        if pts == border:\n            rects.append((r0, c0, r1, c1))\n    rects.sort()\n    return rects\n\n\ndef _paint_centered_ring(out: np.ndarray, r0: int, c0: int, r1: int, c1: int, level: int) -> None:\n    interior = out[r0 + 1 : r1, c0 + 1 : c1]\n    template = _ring_template(level)\n    ih, iw = interior.shape\n    th, tw = template.shape\n    assert ih >= th and iw >= tw\n    interior[:, :] = BG\n    sr = (ih - th) // 2\n    sc = (iw - tw) // 2\n    view = interior[sr : sr + th, sc : sc + tw]\n    mask = template != BG\n    view[mask] = template[mask]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each seed-filled grey enclosure with the concentric-ring template indicated by its seed count.\n\n    Input structure:\n    - Black background with several one-pixel-thick grey rectangular fences.\n    - Each task fence encloses only black cells plus 1 to 4 red seed pixels.\n    - A teaching area sits near the lower-right corner and shows the four ring templates for counts 1..4.\n\n    Rule:\n    - Find every grey hollow rectangle whose interior contains only black and red.\n    - Count the red seeds inside that rectangle, clear those seeds, and choose the matching 1..4 layer ring template.\n    - Center the chosen template inside the rectangle's interior, leaving any extra interior padding black.\n    - Keep the grey fences and the teaching area unchanged.\n\n    Key insight:\n    The bottom-right teaching examples define a fixed count-to-template mapping, so each fenced region is solved independently by counting its red seeds and stamping the corresponding centered ring.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n    for r0, c0, r1, c1 in _find_rect_frames(g):\n        interior = g[r0 + 1 : r1, c0 + 1 : c1]\n        colors = set(map(int, np.unique(interior)))\n        if not colors.issubset({BG, RED}):\n            continue\n        seed_count = int(np.count_nonzero(interior == RED))\n        if 1 <= seed_count <= 4:\n            _paint_centered_ring(out, r0, c0, r1, c1, seed_count)\n    return out\n\n\ndef _draw_task_frame(\n    grid: np.ndarray,\n    expected: np.ndarray,\n    top: int,\n    left: int,\n    inner_h: int,\n    inner_w: int,\n    seed_count: int,\n    rng: np.random.Generator,\n) -> None:\n    bottom = top + inner_h + 1\n    right = left + inner_w + 1\n    grid[top, left : right + 1] = GREY\n    grid[bottom, left : right + 1] = GREY\n    grid[top : bottom + 1, left] = GREY\n    grid[top : bottom + 1, right] = GREY\n\n    expected[top, left : right + 1] = GREY\n    expected[bottom, left : right + 1] = GREY\n    expected[top : bottom + 1, left] = GREY\n    expected[top : bottom + 1, right] = GREY\n\n    cell_ids = rng.choice(inner_h * inner_w, size=seed_count, replace=False)\n    for cell_id in cell_ids:\n        rr = int(cell_id // inner_w)\n        cc = int(cell_id % inner_w)\n        grid[top + 1 + rr, left + 1 + cc] = RED\n\n    _paint_centered_ring(expected, top, left, bottom, right, seed_count)\n\n\ndef _draw_legend(grid: np.ndarray, top: int, left: int) -> None:\n    for level in range(1, 5):\n        cell_row = (level - 1) // 2\n        cell_col = (level - 1) % 2\n        cell_top = top + cell_row * (_LEGEND_CELL_HEIGHT + _LEGEND_ROW_GAP)\n        cell_left = left + cell_col * (_LEGEND_SAMPLE_SIZE + _LEGEND_COL_GAP)\n\n        seed_start = cell_left + (_LEGEND_SAMPLE_SIZE - level) // 2\n        grid[cell_top, seed_start : seed_start + level] = RED\n\n        template = _ring_template(level)\n        th, tw = template.shape\n        patch_top = cell_top + 1 + (_LEGEND_SAMPLE_SIZE - th) // 2\n        patch_left = cell_left + (_LEGEND_SAMPLE_SIZE - tw) // 2\n        patch = grid[patch_top : patch_top + th, patch_left : patch_left + tw]\n        mask = template != BG\n        patch[mask] = template[mask]\n\n\ndef _choose_inner_size(level: int, rng: np.random.Generator) -> int:\n    base = 2 * level - 1\n    if level == 4:\n        extra = int(rng.choice([0, 2]))\n    else:\n        extra = int(rng.choice([0, 2, 4]))\n    return base + extra\n\n\ndef _find_positions(occ: np.ndarray, obj_h: int, obj_w: int) -> list[tuple[int, int]]:\n    h, w = occ.shape\n    positions: list[tuple[int, int]] = []\n    for top in range(1, h - obj_h):\n        for left in range(1, w - obj_w):\n            if occ[top - 1 : top + obj_h + 1, left - 1 : left + obj_w + 1].any():\n                continue\n            positions.append((top, left))\n    return positions\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    height = int(rng.integers(_GRID_MIN, _GRID_MAX + 1))\n    width = int(rng.integers(_GRID_MIN, _GRID_MAX + 1))\n\n    grid = np.full((height, width), BG, dtype=int)\n    expected = np.full((height, width), BG, dtype=int)\n    occ = np.zeros((height, width), dtype=bool)\n\n    legend_top = height - _LEGEND_HEIGHT - 1\n    legend_left = width - _LEGEND_WIDTH - 1\n    if legend_top < 1 or legend_left < 1:\n        return None\n    occ[legend_top - 1 : height, legend_left - 1 : width] = True\n    _draw_legend(grid, legend_top, legend_left)\n    _draw_legend(expected, legend_top, legend_left)\n\n    counts = [1, 2, 3, 4]\n    extra_count = int(rng.integers(0, 3))\n    if extra_count:\n        extras = rng.integers(1, 5, size=extra_count)\n        counts.extend(int(x) for x in extras)\n    rng.shuffle(counts)\n\n    frame_specs = []\n    for count in counts:\n        inner_h = _choose_inner_size(count, rng)\n        inner_w = _choose_inner_size(count, rng)\n        frame_specs.append(\n            {\n                \"count\": count,\n                \"inner_h\": inner_h,\n                \"inner_w\": inner_w,\n                \"outer_h\": inner_h + 2,\n                \"outer_w\": inner_w + 2,\n            }\n        )\n    frame_specs.sort(key=lambda spec: (spec[\"outer_h\"] * spec[\"outer_w\"]), reverse=True)\n\n    for spec in frame_specs:\n        positions = _find_positions(occ, int(spec[\"outer_h\"]), int(spec[\"outer_w\"]))\n        if not positions:\n            return None\n        top, left = positions[int(rng.integers(len(positions)))]\n        _draw_task_frame(\n            grid,\n            expected,\n            top,\n            left,\n            int(spec[\"inner_h\"]),\n            int(spec[\"inner_w\"]),\n            int(spec[\"count\"]),\n            rng,\n        )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\nqueries = {\n'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py': ['_gen_attempt'],\n'/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py': ['_gen_attempt'],\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py': ['_gen_attempt'],\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py': ['_gen_attempt'],\n}\nfor fp, names in queries.items():\n    src = Path(fp).read_text()\n    mod = ast.parse(src)\n    print(f'===== {fp} =====')\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in names:\n            print(ast.get_source_segment(src, node))\n            print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\nqueries = {\n'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py': ['_gen_attempt'],\n'/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py': ['_gen_attempt'],\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py': ['_gen_attempt'],\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py': ['_gen_attempt'],\n}\nfor fp, names in queries.items():\n    src = Path(fp).read_text()\n    mod = ast.parse(src)\n    print(f'===== {fp} =====')\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in names:\n            print(ast.get_source_segment(src, node))\n            print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py =====\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n    H = int(_RNG.integers(*GRID_H_RANGE))\n    W = int(_RNG.integers(*GRID_W_RANGE))\n    bg = int(_RNG.integers(0, NUM_COLORS))\n\n    top, bottom = _build_groups(bg)\n    _RNG.shuffle(top)\n    _RNG.shuffle(bottom)\n\n    if H - max(c[\"h\"] for c in top) - max(c[\"h\"] for c in bottom) < MIN_VERTICAL_GAP:\n        return None\n\n    top_cols = _assign_columns([c[\"w\"] for c in top], W)\n    bottom_cols = _assign_columns([c[\"w\"] for c in bottom], W)\n    if top_cols is None or bottom_cols is None:\n        return None\n\n    for comp, c0 in zip(top, top_cols):\n        comp[\"c0\"], comp[\"out_r0\"] = c0, 0\n    for comp, c0 in zip(bottom, bottom_cols):\n        comp[\"c0\"], comp[\"out_r0\"] = c0, H - comp[\"h\"]\n\n    comps = top + bottom\n    expected = _build_output(comps, H, W, bg)\n    inp = _derive_input(comps, H, W, bg)\n    if inp is None:\n        return None\n    if int(get_bg(inp)) != bg:\n        return None\n\n    found = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n    if len(found) != len(comps):\n        return None\n    if Counter(len(c[\"coords\"]) for c in found) != Counter(c[\"area\"] for c in comps):\n        return None\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n===== /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py =====\ndef _gen_attempt() -> np.ndarray | None:\n    import random as _r\n\n    # --- grid size ---\n    GH = _r.randint(10, 26)\n    GW = _r.randint(10, 26)\n\n    # --- colors ---\n    palette = list(range(10))\n    _r.shuffle(palette)\n    bg = palette[0]\n    rect_col = palette[1]\n    marker_col = palette[2]\n    n_interior = _r.randint(1, 3)\n    interior_cols = palette[3 : 3 + n_interior]\n\n    # --- corner type and marker position ---\n    corner = _r.choice([\"TL\", \"TR\", \"BL\", \"BR\"])\n\n    # --- assembled rectangle dimensions ---\n    # We'll build the rectangle first, then partition\n    min_side, max_side = 5, min(22, min(GH, GW) - 3)\n    if max_side < min_side:\n        return None\n    # Bias toward larger rectangles to match eval distribution\n    RH = _r.randint(min_side, max_side)\n    RW = _r.randint(min_side, max_side)\n    if _r.random() < 0.5 and max_side >= 8:\n        RH = _r.randint(max(6, min_side), max_side)\n        RW = _r.randint(max(6, min_side), max_side)\n\n    # --- marker placement ---\n    # (mr, mc) = missing cell of the 2x2 L-marker = corner of the assembled rectangle.\n    # Solver corner mapping: TL->missing at (r1,c1), TR->(r1,c0), BL->(r0,c1), BR->(r0,c0).\n    # Valid ranges ensure rect fits in grid and marker bbox not on grid edge.\n    if corner == \"TL\":\n        mr_min, mr_max = 2, GH - RH\n        mc_min, mc_max = 2, GW - RW\n    elif corner == \"TR\":\n        mr_min, mr_max = 2, GH - RH\n        mc_min, mc_max = RW - 1, GW - 3\n    elif corner == \"BL\":\n        mr_min, mr_max = RH - 1, GH - 3\n        mc_min, mc_max = 2, GW - RW\n    else:  # BR\n        mr_min, mr_max = RH - 1, GH - 3\n        mc_min, mc_max = RW - 1, GW - 3\n\n    if mr_min > mr_max or mc_min > mc_max:\n        return None\n    mr = _r.randint(mr_min, mr_max)\n    mc = _r.randint(mc_min, mc_max)\n\n    # --- build assembled rectangle ---\n    rect = np.full((RH, RW), rect_col, dtype=int)\n\n    # Fill interior (inside 1-pixel border) with patterns\n    iH, iW = RH - 2, RW - 2\n    if iH < 1 or iW < 1:\n        return None\n\n    interior = np.full((iH, iW), rect_col, dtype=int)\n\n    # Generate 1-3 irregular connected blobs of interior_cols\n    # Each blob: random walk / flood fill from a seed point\n    # Ensure blobs are 8-disconnected from each other (separated by rect_col)\n    target_fill = _r.uniform(0.35, 0.85)\n    target_pixels = max(1, int(target_fill * iH * iW))\n\n    blob_occupied = np.zeros((iH, iW), dtype=bool)  # any interior_col pixel\n\n    for ci, ic in enumerate(interior_cols):\n        if ci == len(interior_cols) - 1:\n            # last blob gets remaining budget\n            budget = target_pixels - int(blob_occupied.sum())\n        else:\n            budget = max(1, target_pixels // len(interior_cols))\n        if budget <= 0:\n            budget = 1\n\n        # Find a seed that is 8-disconnected from existing blobs\n        attempts = 0\n        seed = None\n        while attempts < 200:\n            sr, sc = _r.randint(0, iH - 1), _r.randint(0, iW - 1)\n            if blob_occupied[sr, sc]:\n                attempts += 1\n                continue\n            # Check 8-neighbors are also free\n            ok = True\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    nr, nc = sr + dr, sc + dc\n                    if 0 <= nr < iH and 0 <= nc < iW and blob_occupied[nr, nc]:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                seed = (sr, sc)\n                break\n            attempts += 1\n\n        if seed is None:\n            continue\n\n        # Grow blob via random BFS from seed\n        blob = set()\n        blob.add(seed)\n        frontier = [seed]\n        while len(blob) < budget and frontier:\n            _r.shuffle(frontier)\n            nf = []\n            for fr, fc in frontier:\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    nr, nc = fr + dr, fc + dc\n                    if (nr, nc) in blob:\n                        continue\n                    if nr < 0 or nr >= iH or nc < 0 or nc >= iW:\n                        continue\n                    if blob_occupied[nr, nc]:\n                        continue\n                    # 8-disconnect check: no 8-neighbor of (nr,nc) should be a different blob\n                    conflict = False\n                    for dr2 in (-1, 0, 1):\n                        for dc2 in (-1, 0, 1):\n                            if dr2 == 0 and dc2 == 0:\n                                continue\n                            ar, ac = nr + dr2, nc + dc2\n                            if 0 <= ar < iH and 0 <= ac < iW:\n                                if blob_occupied[ar, ac] and (ar, ac) not in blob:\n                                    conflict = True\n                                    break\n                        if conflict:\n                            break\n                    if conflict:\n                        continue\n                    blob.add((nr, nc))\n                    nf.append((nr, nc))\n                    if len(blob) >= budget:\n                        break\n                if len(blob) >= budget:\n                    break\n            frontier = nf\n\n        for br, bc in blob:\n            interior[br, bc] = ic\n            blob_occupied[br, bc] = True\n\n    # Check interior fill\n    non_rc_count = int(np.sum(interior != rect_col))\n    fill_ratio = non_rc_count / (iH * iW) if iH * iW > 0 else 0\n    if fill_ratio < 0.30 or fill_ratio > 0.90:\n        return None\n\n    rect[1:-1, 1:-1] = interior\n\n    # --- partition rectangle into rectangular pieces ---\n    # Grid-based: choose row/col split points, then randomly merge adjacent cells\n    def _rand_splits(total, min_s=2, max_s=7):\n        \"\"\"Split `total` into segments each in [min_s, max_s].\"\"\"\n        # For larger totals, prefer smaller max to create more segments\n        eff_max = min(max_s, max(min_s, _r.randint(min_s, max_s)))\n        segs = []\n        rem = total\n        while rem > 0:\n            if rem <= eff_max:\n                if rem < min_s:\n                    return None\n                segs.append(rem)\n                rem = 0\n            else:\n                hi = min(eff_max, rem - min_s)\n                if min_s > hi:\n                    return None\n                s = _r.randint(min_s, hi)\n                segs.append(s)\n                rem -= s\n        return segs\n\n    row_segs = _rand_splits(RH)\n    col_segs = _rand_splits(RW)\n    if row_segs is None or col_segs is None:\n        return None\n\n    # Build grid cells: (r0, c0, h, w) for each grid cell\n    row_starts = []\n    s = 0\n    for rs in row_segs:\n        row_starts.append(s)\n        s += rs\n    col_starts = []\n    s = 0\n    for cs in col_segs:\n        col_starts.append(s)\n        s += cs\n\n    nr, nc_grid = len(row_segs), len(col_segs)\n    # Start with grid cells as pieces\n    # cell_id[i][j] = piece index\n    cell_id = [[i * nc_grid + j for j in range(nc_grid)] for i in range(nr)]\n    n_cells = nr * nc_grid\n\n    # Randomly merge adjacent cells to reduce piece count, keeping pieces rectangular\n    # Try merging horizontally (merge cell (i,j) with (i,j+1)) or vertically (with (i+1,j))\n    # A merge is valid if the resulting merged region is still a rectangle with sides <= 7\n    def _get_piece_bbox(pid):\n        \"\"\"Get (min_ri, min_ci, max_ri, max_ci) in grid cell coords for piece pid.\"\"\"\n        cells = [(i, j) for i in range(nr) for j in range(nc_grid) if cell_id[i][j] == pid]\n        if not cells:\n            return None\n        ri = [c[0] for c in cells]\n        ci = [c[1] for c in cells]\n        return min(ri), min(ci), max(ri), max(ci)\n\n    def _pixel_size(r0i, c0i, r1i, c1i):\n        \"\"\"Get pixel dimensions of a grid cell range.\"\"\"\n        h = sum(row_segs[i] for i in range(r0i, r1i + 1))\n        w = sum(col_segs[j] for j in range(c0i, c1i + 1))\n        return h, w\n\n    # Target: 4-12 pieces. Current: nr * nc_grid cells.\n    if n_cells < 4:\n        return None\n    target_pieces = _r.randint(4, min(12, n_cells))\n    merges = []\n    for i in range(nr):\n        for j in range(nc_grid):\n            if j + 1 < nc_grid:\n                merges.append(('h', i, j))\n            if i + 1 < nr:\n                merges.append(('v', i, j))\n    _r.shuffle(merges)\n\n    def _count_pieces():\n        return len(set(cell_id[i][j] for i in range(nr) for j in range(nc_grid)))\n\n    for direction, mi, mj in merges:\n        if _count_pieces() <= target_pieces:\n            break\n        if direction == 'h':\n            pid1 = cell_id[mi][mj]\n            pid2 = cell_id[mi][mj + 1]\n        else:\n            pid1 = cell_id[mi][mj]\n            pid2 = cell_id[mi + 1][mj]\n        if pid1 == pid2:\n            continue\n        # Try merge: all cells of pid2 become pid1\n        bb1 = _get_piece_bbox(pid1)\n        bb2 = _get_piece_bbox(pid2)\n        if bb1 is None or bb2 is None:\n            continue\n        # Merged bbox\n        mr0 = min(bb1[0], bb2[0])\n        mc0 = min(bb1[1], bb2[1])\n        mr1 = max(bb1[2], bb2[2])\n        mc1 = max(bb1[3], bb2[3])\n        # Check pixel size\n        ph, pw = _pixel_size(mr0, mc0, mr1, mc1)\n        if ph > 7 or pw > 7:\n            continue\n        # Check that merged region would be a rectangle (all cells in bbox are pid1 or pid2)\n        ok = True\n        for ii in range(mr0, mr1 + 1):\n            for jj in range(mc0, mc1 + 1):\n                if cell_id[ii][jj] != pid1 and cell_id[ii][jj] != pid2:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        # Do merge\n        for ii in range(nr):\n            for jj in range(nc_grid):\n                if cell_id[ii][jj] == pid2:\n                    cell_id[ii][jj] = pid1\n\n    # Extract pieces\n    pieces = []\n    seen = set()\n    for i in range(nr):\n        for j in range(nc_grid):\n            pid = cell_id[i][j]\n            if pid in seen:\n                continue\n            seen.add(pid)\n            bb = _get_piece_bbox(pid)\n            r0i, c0i, r1i, c1i = bb\n            pr = row_starts[r0i]\n            pc = col_starts[c0i]\n            ph = sum(row_segs[ii] for ii in range(r0i, r1i + 1))\n            pw = sum(col_segs[jj] for jj in range(c0i, c1i + 1))\n            pieces.append((pr, pc, ph, pw))\n\n    if len(pieces) < 4 or len(pieces) > 12:\n        return None\n\n    # Validate each piece\n    for pr, pc, ph, pw in pieces:\n        if ph < 2 or pw < 2 or ph > 7 or pw > 7:\n            return None\n        piece = rect[pr:pr + ph, pc:pc + pw]\n        # piece_fill: 15-55% non-rect_col\n        nrc = int(np.sum(piece != rect_col))\n        fill = nrc / (ph * pw)\n        if fill < 0.10 or fill > 0.60:\n            return None\n        # non_rect_col_edges: at least one edge has non-rect_col pixels\n        has_non_rc_edge = False\n        for edge in [piece[0, :], piece[-1, :], piece[:, 0], piece[:, -1]]:\n            if np.any(edge != rect_col):\n                has_non_rc_edge = True\n                break\n        if not has_non_rc_edge:\n            return None\n        # rect_col_edges: edges on the rectangle border must be all rect_col\n        if pr == 0 and not np.all(piece[0, :] == rect_col):\n            return None\n        if pr + ph == RH and not np.all(piece[-1, :] == rect_col):\n            return None\n        if pc == 0 and not np.all(piece[:, 0] == rect_col):\n            return None\n        if pc + pw == RW and not np.all(piece[:, -1] == rect_col):\n            return None\n\n    # --- find anchor piece (contains the corner cell) ---\n    if corner == \"TL\":\n        anchor_r, anchor_c = 0, 0\n    elif corner == \"TR\":\n        anchor_r, anchor_c = 0, RW - 1\n    elif corner == \"BL\":\n        anchor_r, anchor_c = RH - 1, 0\n    else:\n        anchor_r, anchor_c = RH - 1, RW - 1\n\n    anchor_idx = None\n    for i, (pr, pc, ph, pw) in enumerate(pieces):\n        if pr <= anchor_r < pr + ph and pc <= anchor_c < pc + pw:\n            anchor_idx = i\n            break\n    if anchor_idx is None:\n        return None\n\n    # Verify anchor piece actually has the corner cell at its matching corner\n    apr, apc, aph, apw = pieces[anchor_idx]\n    if corner == \"TL\" and not (apr == 0 and apc == 0):\n        return None\n    if corner == \"TR\" and not (apr == 0 and apc + apw == RW):\n        return None\n    if corner == \"BL\" and not (apr + aph == RH and apc == 0):\n        return None\n    if corner == \"BR\" and not (apr + aph == RH and apc + apw == RW):\n        return None\n\n    # --- place marker ---\n    # Compute marker L cells (3 cells of 2x2 around missing cell)\n    if corner == \"TL\":\n        # missing = (mr, mc), marker bbox = (mr-1, mc-1)-(mr, mc)\n        marker_cells = [(mr - 1, mc - 1), (mr - 1, mc), (mr, mc - 1)]\n    elif corner == \"TR\":\n        marker_cells = [(mr - 1, mc), (mr - 1, mc + 1), (mr, mc + 1)]\n    elif corner == \"BL\":\n        marker_cells = [(mr, mc - 1), (mr + 1, mc - 1), (mr + 1, mc)]\n    else:  # BR\n        marker_cells = [(mr, mc + 1), (mr + 1, mc), (mr + 1, mc + 1)]\n\n    # Check marker cells are in bounds\n    for cr, cc in marker_cells:\n        if cr < 0 or cr >= GH or cc < 0 or cc >= GW:\n            return None\n\n    # --- scatter pieces on grid ---\n    canvas = np.full((GH, GW), bg, dtype=int)\n\n    # Place marker first\n    for cr, cc in marker_cells:\n        canvas[cr, cc] = marker_col\n\n    # Extract piece arrays\n    piece_arrays = []\n    for pr, pc, ph, pw in pieces:\n        piece_arrays.append(rect[pr:pr + ph, pc:pc + pw].copy())\n\n    # Scatter in random order\n    order = list(range(len(piece_arrays)))\n    _r.shuffle(order)\n    for idx in order:\n        pa = piece_arrays[idx]\n        try:\n            r0, c0 = random_free_location(canvas, pa, transparent=bg, padding=1)\n            paste(canvas, pa, r0, c0)\n        except ValueError:\n            return None\n\n    # --- build expected output ---\n    if corner == \"TL\":\n        tr, tc = mr, mc\n    elif corner == \"TR\":\n        tr, tc = mr, mc - RW + 1\n    elif corner == \"BL\":\n        tr, tc = mr - RH + 1, mc\n    else:\n        tr, tc = mr - RH + 1, mc - RW + 1\n\n    expected_out = np.full((GH, GW), bg, dtype=int)\n    expected_out[tr:tr + RH, tc:tc + RW] = rect\n\n    # --- validate with solver ---\n    try:\n        actual_out = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(actual_out, expected_out):\n        return None\n\n    return canvas\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py =====\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.choice(list(range(10)))\n    num_pairs = random.choice(NUM_PAIRS_CHOICES)\n\n    pair_specs = _pick_pair_specs(num_pairs)\n    if len(pair_specs) != num_pairs:\n        return None\n\n    colors = [c for c in range(1, 10) if c != bg]\n    random.shuffle(colors)\n    need = 1 + (3 * num_pairs)\n    if len(colors) < need:\n        return None\n\n    sides = random.sample([\"left\", \"right\", \"top\", \"bottom\"], k=num_pairs)\n    output = np.full((H, W), bg, dtype=int)\n    input_grid = np.full((H, W), bg, dtype=int)\n    union_bboxes: list[tuple[int, int, int, int]] = []\n    frame_bboxes: list[tuple[int, int, int, int]] = []\n    placed_tools: list[dict] = []\n\n    for i, spec in enumerate(pair_specs):\n        info = _place_docked_pair(\n            i, spec, colors, sides[i], bg, H, W,\n            output, input_grid, union_bboxes, frame_bboxes,\n        )\n        if info is None:\n            return None\n        placed_tools.append(info)\n\n    placement_canvas = output.copy()\n    for info in placed_tools:\n        if not _undock_tool(info, bg, input_grid, placement_canvas):\n            return None\n\n    if np.array_equal(main(input_grid), output):\n        return input_grid\n    return None\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py =====\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n","exit_code":0,"status":"completed"}}
