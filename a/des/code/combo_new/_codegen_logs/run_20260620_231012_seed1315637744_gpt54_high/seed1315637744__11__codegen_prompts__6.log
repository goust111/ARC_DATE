{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n]\nfor fp in files:\n    src = Path(fp).read_text()\n    mod = ast.parse(src)\n    print(f'===== {fp} =====')\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main','generate_input'}:\n            seg = ast.get_source_segment(src, node)\n            print(seg)\n            print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nimport ast\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py',\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py',\n'/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n]\nfor fp in files:\n    src = Path(fp).read_text()\n    mod = ast.parse(src)\n    print(f'===== {fp} =====')\n    for node in mod.body:\n        if isinstance(node, ast.FunctionDef) and node.name in {'main','generate_input'}:\n            seg = ast.get_source_segment(src, node)\n            print(seg)\n            print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n\n    Input structure:\n    - bg = most common color.\n    - Several multicolor connected components (8-connected) scattered across the grid.\n\n    Rule:\n    - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n    - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n    - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n    - Horizontal position (left column) is preserved; only vertical translation changes.\n\n    Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    extracted = []\n    for comp in comps:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (r0, c0, r1, c1))\n\n        # Isolate this component exactly (bbox rectangle may include background).\n        rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n        m = mask_from_coords(rel_coords, patch.shape)\n        pat = np.full_like(patch, bg)\n        pat[m] = patch[m]\n\n        extracted.append(\n            {\n                \"c0\": int(c0),\n                \"pat\": pat,\n                \"shape_key\": canonical_shape_key(m),\n            }\n        )\n\n    freq = Counter(d[\"shape_key\"] for d in extracted)\n    out = np.full((H, W), int(bg), dtype=int)\n\n    for d in extracted:\n        pat = d[\"pat\"]\n        h, w = map(int, pat.shape)\n        dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n        dest_c0 = int(d[\"c0\"])\n        paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n\n    return out\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/278e5215.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered rectangular pieces into a rectangle at an L-marker corner.\n\n    Input structure:\n    - bg = most common color. Non-bg rectangular pieces scattered on the grid.\n    - 3-pixel L-marker (2x2 minus one cell) tags the corner; the gap is the corner cell.\n\n    Rule:\n    - rect_col = most common color across all piece pixels; all outer rectangle edges must be rect_col.\n    - Translate pieces (no rotation) to tile the rectangle; touching edges must match, with rect_col as wildcard.\n\n    Key insight: rect_col acts as wildcard during edge matching — only non-rect_col pixels at shared boundaries must agree.\n    \"\"\"\n    inp = grid\n    g = np.array(inp, dtype=int)\n    GH, GW = g.shape\n\n    bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])\n\n    # Find marker: a color appearing exactly 3 times forming an L in a 2x2 bbox.\n    cnt = Counter(map(int, g.flatten()))\n    mark = None\n    missing = None\n    mb = None  # marker bbox\n    for col in sorted([c for c, n in cnt.items() if int(c) != int(bg) and int(n) == 3]):\n        pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]\n        rs = [r for r, _ in pts]\n        cs = [c for _, c in pts]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        if (r1 - r0) == 1 and (c1 - c0) == 1:\n            all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n            miss = list(all4 - set(pts))\n            if len(miss) == 1:\n                mark = int(col)\n                missing = miss[0]\n                mb = (r0, c0, r1, c1)\n                break\n\n    assert not (mark is None or missing is None or mb is None)\n\n    r0, c0, r1, c1 = mb\n    # Rectangle corner is opposite the marker bulk.\n    if missing == (r0, c0):\n        corner = \"BR\"\n    elif missing == (r0, c1):\n        corner = \"BL\"\n    elif missing == (r1, c0):\n        corner = \"TR\"\n    else:\n        corner = \"TL\"\n\n    # Decompose occupied mask (non-bg and non-marker) into rectangles.\n    occ = (g != int(bg)) & (g != int(mark))\n    used = np.zeros_like(occ, dtype=bool)\n    rects = []  # (r, c, h, w, arr)\n    while True:\n        idx = np.argwhere(occ & (~used))\n        if idx.size == 0:\n            break\n        rr, cc = map(int, idx[0])\n        w = 0\n        while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):\n            w += 1\n        h = 0\n        while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):\n            h += 1\n        used[rr : rr + h, cc : cc + w] = True\n        rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))\n\n    total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))\n\n    # The final rectangle's border/background color.\n    allpix = []\n    for _r, _c, _h, _w, a in rects:\n        allpix.extend(map(int, a.flatten()))\n    rect_col = int(Counter(allpix).most_common(1)[0][0])\n\n    mr, mc = map(int, missing)\n\n    # Anchor piece: the rectangle containing the corner cell.\n    anchor_idx = None\n    for i, (rr, cc, h, w, _a) in enumerate(rects):\n        if rr <= mr < rr + h and cc <= mc < cc + w:\n            anchor_idx = i\n            break\n\n    pieces = [a for _r, _c, _h, _w, a in rects]\n    ph = [int(p.shape[0]) for p in pieces]\n    pw = [int(p.shape[1]) for p in pieces]\n\n    # Candidate rectangle dimensions are factor pairs of total_area that fit in the grid\n    # when anchored at (mr, mc) as the specified corner.\n    dims = []\n    for hh in range(1, int(total_area**0.5) + 1):\n        if total_area % hh == 0:\n            dims.append((hh, total_area // hh))\n            if hh * hh != total_area:\n                dims.append((total_area // hh, hh))\n\n    def fits(H, W):\n        if corner == \"TL\":\n            tr, tc = mr, mc\n        elif corner == \"TR\":\n            tr, tc = mr, mc - W + 1\n        elif corner == \"BL\":\n            tr, tc = mr - H + 1, mc\n        else:  # \"BR\"\n            tr, tc = mr - H + 1, mc - W + 1\n        return 0 <= tr and 0 <= tc and (tr + H) <= GH and (tc + W) <= GW\n\n    dims = [(int(H), int(W)) for H, W in dims if fits(int(H), int(W))]\n    dims = sorted(dims, key=lambda t: (-t[0] * t[1], -t[0], -t[1]))\n\n    def compat(v1, v2):\n        v1 = np.array(v1, dtype=int)\n        v2 = np.array(v2, dtype=int)\n        m = (v1 != int(rect_col)) & (v2 != int(rect_col))\n        return bool((v1[m] == v2[m]).all())\n\n    def assemble(H, W):\n        occ2 = np.full((H, W), -1, dtype=int)\n        usedp = [False] * len(pieces)\n\n        def boundary_ok(a, r, c):\n            h, w = a.shape\n            if r == 0 and not np.all(a[0, :] == int(rect_col)):\n                return False\n            if (r + h) == H and not np.all(a[-1, :] == int(rect_col)):\n                return False\n            if c == 0 and not np.all(a[:, 0] == int(rect_col)):\n                return False\n            if (c + w) == W and not np.all(a[:, -1] == int(rect_col)):\n                return False\n            return True\n\n        def neighbor_ok(a, r, c):\n            h, w = a.shape\n            if c > 0:\n                left = occ2[r : r + h, c - 1]\n                m = left != -1\n                if m.any() and (not compat(left[m], a[:, 0][m])):\n                    return False\n            if (c + w) < W:\n                right = occ2[r : r + h, c + w]\n                m = right != -1\n                if m.any() and (not compat(right[m], a[:, -1][m])):\n                    return False\n            if r > 0:\n                up = occ2[r - 1, c : c + w]\n                m = up != -1\n                if m.any() and (not compat(up[m], a[0, :][m])):\n                    return False\n            if (r + h) < H:\n                down = occ2[r + h, c : c + w]\n                m = down != -1\n                if m.any() and (not compat(down[m], a[-1, :][m])):\n                    return False\n            return True\n\n        def can_place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            if (r + h) > H or (c + w) > W:\n                return False\n            if (occ2[r : r + h, c : c + w] != -1).any():\n                return False\n            if not boundary_ok(a, r, c):\n                return False\n            if not neighbor_ok(a, r, c):\n                return False\n            return True\n\n        def place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = a\n            usedp[i] = True\n\n        def unplace(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = -1\n            usedp[i] = False\n\n        # Pre-place anchor piece if the corner cell is exactly a corner of that piece.\n        if anchor_idx is not None:\n            rr, cc, h0, w0, _ = rects[anchor_idx]\n            corners = {\n                (rr, cc): \"TL\",\n                (rr, cc + w0 - 1): \"TR\",\n                (rr + h0 - 1, cc): \"BL\",\n                (rr + h0 - 1, cc + w0 - 1): \"BR\",\n            }\n            if (mr, mc) in corners and corners[(mr, mc)] == corner:\n                ah, aw = ph[anchor_idx], pw[anchor_idx]\n                if corner == \"TL\":\n                    ar0, ac0 = 0, 0\n                elif corner == \"TR\":\n                    ar0, ac0 = 0, W - aw\n                elif corner == \"BL\":\n                    ar0, ac0 = H - ah, 0\n                else:  # \"BR\"\n                    ar0, ac0 = H - ah, W - aw\n                if can_place(anchor_idx, ar0, ac0):\n                    place(anchor_idx, ar0, ac0)\n\n        order = sorted(range(len(pieces)), key=lambda i: (-ph[i] * pw[i], -ph[i], -pw[i], i))\n\n        def next_empty():\n            idx = np.argwhere(occ2 == -1)\n            if idx.size == 0:\n                return None\n            return tuple(map(int, idx[0]))\n\n        solved = False\n\n        def bt():\n            nonlocal solved\n            nxt = next_empty()\n            if nxt is None:\n                solved = True\n                return\n            r, c = nxt\n            for i in order:\n                if usedp[i]:\n                    continue\n                if can_place(i, r, c):\n                    place(i, r, c)\n                    bt()\n                    if solved:\n                        return\n                    unplace(i, r, c)\n\n        bt()\n        return occ2 if solved else None\n\n    ass = None\n    used_dim = None\n    for H, W in dims:\n        ass = assemble(H, W)\n        if ass is not None:\n            used_dim = (H, W)\n            break\n\n    assert not (ass is None or used_dim is None)\n\n    H, W = used_dim\n    if corner == \"TL\":\n        top_left = (mr, mc)\n    elif corner == \"TR\":\n        top_left = (mr, mc - W + 1)\n    elif corner == \"BL\":\n        top_left = (mr - H + 1, mc)\n    else:  # \"BR\"\n        top_left = (mr - H + 1, mc - W + 1)\n\n    out = np.full((GH, GW), int(bg), dtype=int)\n    tr, tc = map(int, top_left)\n    out[tr : tr + H, tc : tc + W] = ass\n    return out\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/a25697e4.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock movable tools into border-anchored frames by filling cavities.\n\n    Input structure:\n    - bg = most common color.\n    - Border-touching components cluster into anchor frames with interior bg cavities.\n    - Non-border 2-color components are movable tools.\n\n    Rule:\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\n    - If the docking orientation uses a reflection, swap the tool's two colors.\n\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\n    \"\"\"\n    inp = grid\n    g = inp.copy()\n    bg = get_bg(g)\n    H, W = g.shape\n\n    def bbox_gap(a, b) -> int:\n        (ar0, ac0, ar1, ac1) = a\n        (br0, bc0, br1, bc1) = b\n        def gap1(x0, x1, y0, y1):\n            if y1 < x0:\n                return int(x0 - y1)\n            if x1 < y0:\n                return int(y0 - x1)\n            return 0\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\n\n    fg = g != int(bg)\n    lab, n = label(fg, structure=STRUCT4)\n    fixed_mask = np.zeros((H, W), dtype=bool)\n    fixed_components = []\n    for cid in range(1, n + 1):\n        pts = np.argwhere(lab == cid)\n        pts_list = [(int(r), int(c)) for r, c in pts]\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\n        if not touches:\n            continue\n        fixed_components.append({\"pts\": pts_list, \"bbox\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\n        for r, c in pts_list:\n            fixed_mask[r, c] = True\n\n    assert not (not fixed_components)\n\n    # Cluster fixed components into anchor frames.\n    parent = list(range(len(fixed_components)))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra != rb:\n            parent[rb] = ra\n\n    for i in range(len(fixed_components)):\n        for j in range(i + 1, len(fixed_components)):\n            if bbox_gap(fixed_components[i][\"bbox\"], fixed_components[j][\"bbox\"]) <= 2:\n                union(i, j)\n\n    groups: dict[int, list[int]] = {}\n    for i in range(len(fixed_components)):\n        groups.setdefault(find(i), []).append(i)\n\n    anchor_groups = []\n    for idxs in groups.values():\n        pts = [p for i in idxs for p in fixed_components[i][\"pts\"]]\n        rs = [r for r, _c in pts]\n        cs = [c for _r, c in pts]\n        bbox = (min(rs), min(cs), max(rs), max(cs))\n        mask = np.zeros((H, W), dtype=bool)\n        for r, c in pts:\n            mask[r, c] = True\n        sock = np.zeros((H, W), dtype=bool)\n        for r in range(bbox[0], bbox[2] + 1):\n            for c in range(bbox[1], bbox[3] + 1):\n                if int(g[r, c]) != int(bg):\n                    continue\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    rr, cc = r + dr, c + dc\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\n                        sock[r, c] = True\n                        break\n\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\n        cavity = np.zeros((H, W), dtype=bool)\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\n        best_c = None  # (area, cid)\n        for cid in range(1, sub_n + 1):\n            ptsc = np.argwhere(sub_lab == cid)\n            area = int(len(ptsc))\n            # check adjacency to anchor within bbox\n            adj = False\n            for rr, cc in ptsc:\n                r = int(bbox[0] + rr)\n                c = int(bbox[1] + cc)\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    r2, c2 = r + dr, c + dc\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\n                        adj = True\n                        break\n                if adj:\n                    break\n            if not adj:\n                continue\n            cand = (area, -cid)\n            if best_c is None or cand > best_c:\n                best_c = cand\n                best_id = cid\n        if best_c is not None:\n            ptsc = np.argwhere(sub_lab == best_id)\n            for rr, cc in ptsc:\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\n        cav_bbox = None\n        if cavity.any():\n            ptsc2 = np.argwhere(cavity)\n            r0c, c0c = ptsc2.min(axis=0)\n            r1c, c1c = ptsc2.max(axis=0)\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\n\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\n        # (within the group) with different sizes and larger-above-smaller.\n        swap_needed = False\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\n            sub = (g == int(col)) & mask\n            labc, nc = label(sub, structure=STRUCT4)\n            if nc < 2:\n                continue\n            comps = []\n            for cid in range(1, nc + 1):\n                ptsc = np.argwhere(labc == cid)\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\n            comps.sort(reverse=True)\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\n            # Swap only when the larger component is vertically above the smaller one.\n            if s0 != s1 and r0 < r1:\n                swap_needed = True\n                break\n\n        # Dominant open direction: which side has the most bg neighbors.\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\n        dir_counts = [0, 0, 0, 0]\n        for r, c in pts:\n            for di, (dr, dc) in enumerate(dir_list):\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\n                    dir_counts[di] += 1\n        open_dir = dir_list[int(np.argmax(dir_counts))]\n        _labg, _ng = label(mask, structure=STRUCT4)\n        single_piece = int(_ng) == 1\n        cavity_size = int(cavity.sum())\n\n        anchor_groups.append(\n            {\n                \"mask\": mask,\n                \"bbox\": bbox,\n                \"socket_mask\": sock,\n                \"cavity_mask\": cavity,\n                \"cavity_bbox\": cav_bbox,\n                \"open_dir\": open_dir,\n                \"swap_needed\": swap_needed,\n                \"single_piece\": single_piece,\n                \"cavity_size\": cavity_size,\n                \"size\": int(mask.sum()),\n            }\n        )\n    anchor_groups.sort(key=lambda d: -d[\"size\"])\n\n    # Movable multi-color components are the remaining foreground pixels.\n    mov_mask = fg & (~fixed_mask)\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\n    mov_comps = []\n    for cid in range(1, mov_n + 1):\n        pts = np.argwhere(mov_lab == cid)\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        patch[~m] = 0\n        mov_comps.append({\"bbox\": (int(r0), int(c0), int(r1), int(c1)), \"mask\": m, \"patch\": patch, \"size\": int(len(pts))})\n    mov_comps.sort(key=lambda d: -d[\"size\"])\n\n    def choose_group(bbox) -> int:\n        best_i = 0\n        best_d = None\n        for i, grp in enumerate(anchor_groups):\n            d = bbox_gap(bbox, grp[\"bbox\"])\n            if best_d is None or d < best_d:\n                best_d = d\n                best_i = i\n        return int(best_i)\n\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\n        \"\"\"All unique dihedral variants, with a reflection flag.\"\"\"\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        for k in range(4):\n            p = np.rot90(patch, k)\n            m = np.rot90(mask, k)\n            base.append((p, m, False))\n            base.append((np.fliplr(p), np.fliplr(m), True))\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\n        seen = set()\n        for p, m, is_flip in base:\n            key = (m.tobytes(), p[m].tobytes())\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m, is_flip))\n        return uniq\n\n    out = np.full_like(g, int(bg))\n    out[fixed_mask] = g[fixed_mask]\n    placed_global = fixed_mask.copy()\n    placed_groups = [grp[\"mask\"].copy() for grp in anchor_groups]\n\n    group_for_comp: list[int]\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\n    # when counts match), falling back to distance only if no such match exists.\n    comp_color_counts: list[dict[int, int]] = []\n    for comp in mov_comps:\n        vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_color_counts.append(dict(Counter(vals)))\n\n    def compatible(ci: int, gi: int) -> bool:\n        cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n        import itertools\n\n        best_perm = None\n        best_score = None\n        for perm in itertools.permutations(range(len(anchor_groups))):\n            ok = True\n            hits = 0\n            dist_sum = 0\n            for ci, gi in enumerate(perm):\n                if not compatible(ci, gi):\n                    ok = False\n                    break\n                hits += 1\n                dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n            if not ok:\n                continue\n            score = (int(hits), -int(dist_sum))\n            if best_score is None or score > best_score:\n                best_score = score\n                best_perm = perm\n        assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n        group_for_comp = [int(x) for x in best_perm]\n    else:\n        group_for_comp = []\n        for ci, comp in enumerate(mov_comps):\n            best_g = None\n            best_d = None\n            for gi, grp in enumerate(anchor_groups):\n                if not compatible(ci, gi):\n                    continue\n                d = bbox_gap(comp[\"bbox\"], grp[\"bbox\"])\n                if best_d is None or d < best_d:\n                    best_d = d\n                    best_g = gi\n            group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\"bbox\"])))\n\n    for comp, gi in zip(mov_comps, group_for_comp):\n        grp = anchor_groups[gi]\n        placed_grp = placed_groups[gi]\n        sock = grp[\"socket_mask\"]\n        cav = grp[\"cavity_mask\"]\n        cav_bbox = grp[\"cavity_bbox\"]\n        odr, odc = grp[\"open_dir\"]\n        # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\n        # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\n        # tools: swapping is ambiguous and not needed.)\n        comp_vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n        comp_counts = Counter(comp_vals)\n\n        best_state = None\n        # Score prioritizes *filling the cavity* with exactly one tool color region.\n        # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\n        best_score = None\n        cav_sz = int(grp[\"cavity_size\"])\n        for p, m, is_flip in gen_variants(comp[\"patch\"], comp[\"mask\"]):\n            h, w = m.shape\n            coords = np.argwhere(m)\n            cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\n            plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\n            assert plug_colors\n            for r0 in range(0, H - h + 1):\n                for c0 in range(0, W - w + 1):\n                    ok = True\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if placed_global[r, c]:\n                            ok = False\n                            break\n                    if not ok:\n                        continue\n                    adj = 0\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            r2, c2 = r + dr, c + dc\n                            if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\n                                adj += 1\n                    if adj == 0:\n                        continue\n                    socket_hits = 0\n                    cavity_hits = 0\n                    outside = 0\n                    # Best plug-match for this placement among candidate plug colors.\n                    plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\n                    for rr, cc in coords:\n                        r = int(r0 + rr)\n                        c = int(c0 + cc)\n                        if sock[r, c]:\n                            socket_hits += 1\n                        if cav[r, c]:\n                            cavity_hits += 1\n                        # Count pixels placed outside the anchor bbox in the dominant open direction.\n                        br0, bc0, br1, bc1 = grp[\"bbox\"]\n                        if odc == -1 and c < bc0:\n                            outside += 1\n                        elif odc == 1 and c > bc1:\n                            outside += 1\n                        elif odr == -1 and r < br0:\n                            outside += 1\n                        elif odr == 1 and r > br1:\n                            outside += 1\n\n                    for plug_col in plug_colors:\n                        if plug_col is None:\n                            plug_score = (0, 0, 0, 0)\n                        else:\n                            plug_hits = 0\n                            plug_outside = 0\n                            nonplug_in_cav = 0\n                            for rr, cc in coords:\n                                r = int(r0 + rr)\n                                c = int(c0 + cc)\n                                in_cav = bool(cav[r, c])\n                                col = int(p[rr, cc])\n                                if col == int(plug_col):\n                                    if in_cav:\n                                        plug_hits += 1\n                                    else:\n                                        plug_outside += 1\n                                else:\n                                    if in_cav:\n                                        nonplug_in_cav += 1\n                            plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\n                            plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\n                        if plug_best is None or plug_score > plug_best:\n                            plug_best = plug_score\n                    dist = bbox_gap(grp[\"bbox\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\n                    score = tuple(plug_best) + (\n                        int(cavity_hits),\n                        int(adj),\n                        int(outside),\n                        int(socket_hits),\n                        -int(dist),\n                        -int(r0),\n                        -int(c0),\n                    )\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best_state = (p, m, int(r0), int(c0), bool(is_flip))\n\n        assert best_state is not None, 'must find a valid placement for every movable tool'\n        p, m, r0, c0, is_flip = best_state\n        if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\n            a, b = sorted(comp_counts.keys())\n            q = p.copy()\n            q[(p == a) & m] = b\n            q[(p == b) & m] = a\n            p = q\n        for rr, cc in np.argwhere(m):\n            r = int(r0 + rr)\n            c = int(c0 + cc)\n            out[r, c] = int(p[rr, cc])\n            placed_global[r, c] = True\n            placed_grp[r, c] = True\n\n    return out\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPT_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input after %d attempts\" % GEN_ATTEMPT_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n","exit_code":0,"status":"completed"}}
