{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n\n    return expected, fill_container, u_box, marker_c, distractor_count\n\n\ndef _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n    inp = expected.copy()\n    if fill_container:\n        assert u_box is not None\n        top, bottom, left, right = u_box\n        inp[top:bottom, left + 1 : right] = _GEN_BG\n    else:\n        inp[-1, :] = _GEN_BG\n    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n    return inp\n\n\ndef _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n        return False\n    if not np.all(inp[-1, :] == _GEN_BG):\n        return False\n\n    wall_coords = np.argwhere(inp == _GEN_WALL)\n    if wall_coords.size == 0 or int(wall_coords[:, 0].min()) < _GEN_MIN_WALL_ROW or int(wall_coords[:, 0].max()) > _GEN_LAST_WALL_ROW:\n        return False\n\n    component_count = len(find_components(inp, bg=_GEN_BG, colors=[_GEN_WALL], connectivity=4))\n    if not (1 <= component_count <= 3):\n        return False\n\n    containers = _closed_u_containers(inp, _GEN_WALL, _GEN_BG)\n    if len(containers) > 1:\n        return False\n    if any(marker_c in (left, right) for _top, _bottom, left, right in containers):\n        return False\n    if fill_container:\n        if len(containers) != 1 or containers[0] != u_box:\n            return False\n    elif containers and containers[0][2] <= marker_c <= containers[0][3]:\n        return False\n\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    expected, fill_container, u_box, marker_c, distractor_count = _gen_design_expected()\n    if not _gen_place_distractors(expected, distractor_count):\n        return None\n\n    inp = _gen_input_from_expected(expected, fill_container, u_box, marker_c)\n    if not _gen_valid_pair(inp, expected, fill_container, u_box, marker_c):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid db7260a4 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py && sed -n '/\"'^def generate_input/,$p'\"' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Complete each boundary tab or notch by adding the complementary feature on the opposite side of the foreground object.\n\n    Input structure\n    - The grid has exactly two colors: a dominant background and one foreground object.\n    - The foreground object is a thick rectilinear shape with one-pixel tabs and notches on its boundary.\n\n    Rule\n    - A foreground tab is a one-neighbor boundary pixel; project through its full row or column span and remove the opposite edge pixel to make a matching notch.\n    - A background notch is a one-pixel cut with three foreground 4-neighbors; project across the full row or column span and add a tab just outside the opposite edge.\n    - Notches immediately beside a tab source are not independent sources, because that gap belongs to the tab's local boundary shape.\n\n    Key insight\n    - The changed pixels are not color-specific noise; they are paired jigsaw-like boundary features on opposite sides of the same thick row or column cross-section.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g)\n    assert len(colors) == 2, \"task expects exactly one foreground color and one background\"\n    fg_colors = [color for color in colors if color != bg]\n    assert len(fg_colors) == 1, \"task expects a single foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    out = g.copy()\n\n    tabs = _tab_sources(mask)\n    tab_cells = {cell for cell, _direction, _target in tabs}\n    changes = 0\n\n    for _cell, _direction, target in tabs:\n        if out[target] != bg:\n            out[target] = bg\n            changes += 1\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in DIRS4:\n                rr, cc = r + dr, c + dc\n                if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            target = _outside_opposite_edge(mask, r, c, dr, dc)\n            if target is not None and not bool(mask[target]):\n                if out[target] != fg:\n                    out[target] = fg\n                    changes += 1\n\n    assert changes > 0, \"at least one complementary boundary feature must be produced\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 8\n_GEN_FG = 1\n_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Canvas and placement bounds.\n_GEN_ROWS_RANGE = (13, 16)\n_GEN_COLS_RANGE = (15, 17)\n_GEN_MARGIN = 1\n\n# Clean L-shape arm bounds.\n_GEN_H_THICK_RANGE = (3, 5)\n_GEN_V_WIDTH_RANGE = (3, 6)\n_GEN_V_EXTRA_RANGE = (4, 10)\n_GEN_H_WIDTH_RANGE = (11, 14)\n_GEN_MAX_BODY_HEIGHT = 14\n_GEN_MIN_MODE_GAP = 2\n_GEN_MISSING_CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n\n# Boundary source feature counts.\n_GEN_PAIR_COUNT_RANGE = (1, 3)\n_GEN_MAX_TABS = 4\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= r < shape[0] and 0 <= c < shape[1]\n\n\ndef _gen_has_tangent_support(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> bool:\n    if dr:\n        sides = ((r, c - 1), (r, c + 1))\n    else:\n        sides = ((r - 1, c), (r + 1, c))\n    return all(_gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]) for rr, cc in sides)\n\n\ndef _gen_line_edges(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[tuple[int, int], tuple[int, int]] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        if rows.size == 0:\n            return None\n        near_r = int(rows.min() if dr > 0 else rows.max())\n        far_r = int(rows.max() if dr > 0 else rows.min())\n        return (near_r, c), (far_r, c)\n\n    cols = np.flatnonzero(mask[r])\n    if cols.size == 0:\n        return None\n    near_c = int(cols.min() if dc > 0 else cols.max())\n    far_c = int(cols.max() if dc > 0 else cols.min())\n    return (r, near_c), (r, far_c)\n\n\ndef _gen_feature_slots(mask: np.ndarray) -> list[dict]:\n    slots: list[dict] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n            for dr, dc in _GEN_DIRS4:\n                outside_r, outside_c = r - dr, c - dc\n                if not _gen_in_bounds(mask.shape, outside_r, outside_c):\n                    continue\n                if bool(mask[outside_r, outside_c]):\n                    continue\n\n                edges = _gen_line_edges(mask, r, c, dr, dc)\n                if edges is None or edges[0] != (r, c):\n                    continue\n                near, far = edges\n                far_out = (far[0] + dr, far[1] + dc)\n                if not _gen_in_bounds(mask.shape, far_out[0], far_out[1]):\n                    continue\n                if bool(mask[far_out]):\n                    continue\n                near_margin = (outside_r - dr, outside_c - dc)\n                far_margin = (far_out[0] + dr, far_out[1] + dc)\n                if not _gen_in_bounds(mask.shape, near_margin[0], near_margin[1]):\n                    continue\n                if not _gen_in_bounds(mask.shape, far_margin[0], far_margin[1]):\n                    continue\n\n                inner_r, inner_c = r + dr, c + dc\n                if not _gen_in_bounds(mask.shape, inner_r, inner_c) or not bool(mask[inner_r, inner_c]):\n                    continue\n                if not _gen_has_tangent_support(mask, near[0], near[1], dr, dc):\n                    continue\n                if not _gen_has_tangent_support(mask, far[0], far[1], dr, dc):\n                    continue\n\n                slots.append(\n                    {\n                        \"near\": near,\n                        \"near_out\": (outside_r, outside_c),\n                        \"far\": far,\n                        \"far_out\": far_out,\n                        \"dir\": (dr, dc),\n                    }\n                )\n    return slots\n\n\ndef _gen_protected_cells(slot: dict) -> set[tuple[int, int]]:\n    return {slot[\"near\"], slot[\"near_out\"], slot[\"far\"], slot[\"far_out\"]}\n\n\ndef _gen_l_configs() -> list[tuple[int, int, int, int]]:\n    \"\"\"Return clean L dimensions whose solver thickness mode is unambiguous.\"\"\"\n    configs: list[tuple[int, int, int, int]] = []\n    for h_thick in range(_GEN_H_THICK_RANGE[0], _GEN_H_THICK_RANGE[1] + 1):\n        for v_width in range(_GEN_V_WIDTH_RANGE[0], _GEN_V_WIDTH_RANGE[1] + 1):\n            for v_extra in range(_GEN_V_EXTRA_RANGE[0], _GEN_V_EXTRA_RANGE[1] + 1):\n                height = h_thick + v_extra\n                if height > _GEN_MAX_BODY_HEIGHT:\n                    continue\n                for h_width in range(_GEN_H_WIDTH_RANGE[0], _GEN_H_WIDTH_RANGE[1] + 1):\n                    run_counts: dict[int, int] = {}\n                    for length, count in (\n                        (h_width, h_thick),\n                        (v_width, v_extra),\n                        (height, v_width),\n                        (h_thick, h_width - v_width),\n                    ):\n                        run_counts[length] = run_counts.get(length, 0) + count\n                    max_count = max(run_counts.values())\n                    mode = min(length for length, count in run_counts.items() if count == max_count)\n                    counts = sorted(run_counts.values(), reverse=True)\n                    if mode == min(h_thick, v_width) and counts[0] >= counts[1] + _GEN_MIN_MODE_GAP:\n                        configs.append((h_thick, v_width, v_extra, h_width))\n    return configs\n\n\ndef _gen_clean_l() -> tuple[np.ndarray, int, int, int, int, str] | None:\n    h_thick, v_width, v_extra, h_width = random.choice(_gen_l_configs())\n\n    height = h_thick + v_extra\n    rows = random.randint(max(_GEN_ROWS_RANGE[0], height + 2 * _GEN_MARGIN), _GEN_ROWS_RANGE[1])\n    cols = random.randint(max(_GEN_COLS_RANGE[0], h_width + 2 * _GEN_MARGIN), _GEN_COLS_RANGE[1])\n    r0 = random.randint(_GEN_MARGIN, rows - height - _GEN_MARGIN)\n    c0 = random.randint(_GEN_MARGIN, cols - h_width - _GEN_MARGIN)\n\n    missing_corner = random.choice(_GEN_MISSING_CORNERS)\n    h_on_top = missing_corner[0] == \"B\"\n    v_on_left = missing_corner[1] == \"R\"\n\n    mask = np.zeros((rows, cols), dtype=bool)\n    h_rows = slice(r0, r0 + h_thick) if h_on_top else slice(r0 + v_extra, r0 + height)\n    v_cols = slice(c0, c0 + v_width) if v_on_left else slice(c0 + h_width - v_width, c0 + h_width)\n    mask[h_rows, c0 : c0 + h_width] = True\n    mask[r0 : r0 + height, v_cols] = True\n    return mask, h_thick, v_width, v_extra, h_width, missing_corner\n\n\ndef _gen_notch_sources(mask: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int], tuple[int, int] | None]]:\n    tab_cells = {cell for cell, _direction, _target in _tab_sources(mask)}\n    notches: list[tuple[tuple[int, int], tuple[int, int], tuple[int, int] | None]] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in _GEN_DIRS4:\n                rr, cc = r + dr, c + dc\n                if _gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            if dr:\n                rows = np.flatnonzero(mask[:, c])\n                target = None if rows.size == 0 else (int(rows.max() + 1 if dr > 0 else rows.min() - 1), c)\n            else:\n                cols = np.flatnonzero(mask[r])\n                target = None if cols.size == 0 else (r, int(cols.max() + 1 if dc > 0 else cols.min() - 1))\n            if target is not None and not _gen_in_bounds(mask.shape, target[0], target[1]):\n                target = None\n            notches.append(((r, c), (dr, dc), target))\n    return notches\n\n\ndef _gen_apply_source_features(clean: np.ndarray, chosen: list[tuple[dict, str]]) -> np.ndarray:\n    mask = clean.copy()\n    for slot, source_type in chosen:\n        if source_type == \"tab\":\n            mask[slot[\"near_out\"]] = True\n        else:\n            mask[slot[\"near\"]] = False\n    return mask\n\n\ndef _gen_source_sets_match(mask: np.ndarray, chosen: list[tuple[dict, str]]) -> bool:\n    expected_tab_cells = {slot[\"near_out\"] for slot, source_type in chosen if source_type == \"tab\"}\n    found_tab_cells = {cell for cell, _direction, _target in _tab_sources(mask)}\n    if found_tab_cells != expected_tab_cells:\n        return False\n\n    expected_notch_cells = {slot[\"near\"] for slot, source_type in chosen if source_type == \"notch\"}\n    found_notch_cells = {\n        cell\n        for cell, _direction, target in _gen_notch_sources(mask)\n        if target is not None and not bool(mask[target])\n    }\n    return found_notch_cells == expected_notch_cells\n\n\ndef _gen_source_types() -> list[str]:\n    source_count = 2 * random.randint(_GEN_PAIR_COUNT_RANGE[0], _GEN_PAIR_COUNT_RANGE[1])\n    min_tabs = max(0, source_count - _GEN_MAX_TABS)\n    max_tabs = min(_GEN_MAX_TABS, source_count)\n    tab_count = random.randint(min_tabs, max_tabs)\n    source_types = [\"tab\"] * tab_count + [\"notch\"] * (source_count - tab_count)\n    random.shuffle(source_types)\n    return source_types\n\n\ndef _gen_choose_features(\n    clean: np.ndarray,\n    slots: list[dict],\n    source_types: list[str],\n    idx: int = 0,\n    chosen: list[tuple[dict, str]] | None = None,\n    blocked: set[tuple[int, int]] | None = None,\n) -> list[tuple[dict, str]] | None:\n    if chosen is None:\n        chosen = []\n    if blocked is None:\n        blocked = set()\n    if idx == len(source_types):\n        return chosen\n\n    candidates = slots[:]\n    random.shuffle(candidates)\n    source_type = source_types[idx]\n    for slot in candidates:\n        protected = _gen_protected_cells(slot)\n        if protected & blocked:\n            continue\n        trial = chosen + [(slot, source_type)]\n        source_mask = _gen_apply_source_features(clean, trial)\n        if not _gen_source_sets_match(source_mask, trial):\n            continue\n        result = _gen_choose_features(clean, slots, source_types, idx + 1, trial, blocked | protected)\n        if result is not None:\n            return result\n    return None\n\n\ndef _gen_render_pair(clean: np.ndarray, chosen: list[tuple[dict, str]]) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return input and expected-output masks for the selected source features.\"\"\"\n    out_mask = clean.copy()\n    for slot, source_type in chosen:\n        if source_type == \"tab\":\n            out_mask[slot[\"near_out\"]] = True\n            out_mask[slot[\"far\"]] = False\n        else:\n            out_mask[slot[\"near\"]] = False\n            out_mask[slot[\"far_out\"]] = True\n\n    inp_mask = out_mask.copy()\n    for slot, source_type in chosen:\n        if source_type == \"tab\":\n            inp_mask[slot[\"far\"]] = True\n        else:\n            inp_mask[slot[\"far_out\"]] = False\n    return inp_mask, out_mask\n\n\ndef _gen_to_grid(mask: np.ndarray) -> np.ndarray:\n    grid = np.full(mask.shape, _GEN_BG, dtype=int)\n    grid[mask] = _GEN_FG\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    clean_result = _gen_clean_l()\n    if clean_result is None:\n        return None\n    clean, h_thick, v_width, _v_extra, _h_width, _missing_corner = clean_result\n\n    slots = _gen_feature_slots(clean)\n    random.shuffle(slots)\n    chosen = _gen_choose_features(clean, slots, _gen_source_types())\n    if chosen is None:\n        return None\n\n    inp_mask, out_mask = _gen_render_pair(clean, chosen)\n\n    intended_thickness = min(h_thick, v_width)\n    if _body_thickness(inp_mask) != intended_thickness:\n        return None\n\n    if not _gen_source_sets_match(inp_mask, chosen):\n        return None\n\n    inp = _gen_to_grid(inp_mask)\n    expected = _gen_to_grid(out_mask)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 8dab14c2 input\")\n","exit_code":0,"status":"completed"}}
