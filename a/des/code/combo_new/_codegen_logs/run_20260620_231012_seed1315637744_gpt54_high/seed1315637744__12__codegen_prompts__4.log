{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/17b866bd.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marker from a lattice corner gap into the adjacent enclosed 12-pixel cavity.\n\n    Input structure:\n    - The grid is a repeated teal lattice around black 12-pixel cavities.\n    - A marker is a non-black pixel placed at the northwest corner gap of one\n      complete 5x5 lattice tile; the marker may itself be teal.\n\n    Rule:\n    - For every marked northwest corner gap, clear that marker to black.\n    - Fill the 12 black pixels in the tile immediately down-right of the marker\n      with the marker color.\n    - Leave the rest of the lattice unchanged.\n\n    Key insight:\n    - The apparent isolated markers are control pixels for the adjacent cavity;\n      teal markers are recognized as extra teal pixels occupying a gap that the\n      periodic lattice template says should be black.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    empty = Color.BACKGROUND\n    lattice = _lattice_color(g, empty)\n    h, w = g.shape\n\n    anchors: list[tuple[int, int, int]] = []\n    for r in range(h - 4):\n        for c in range(w - 4):\n            if _matches_anchor_template(g, r, c, empty, lattice) and int(g[r, c]) != empty:\n                anchors.append((r, c, int(g[r, c])))\n\n    assert anchors, \"expected at least one marked lattice anchor\"\n\n    out = g.copy()\n    for r, c, color in anchors:\n        out[r, c] = empty\n        for dr, dc in _INTERIOR_OFFSETS:\n            assert int(g[r + dr, c + dc]) == empty, \"anchor cavity must be empty before filling\"\n            out[r + dr, c + dc] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: tunable generation parameters ---\n_LATTICE = 8                       # lattice / frame color\n_EMPTY = 0                        # background / cavity color\n_TILE_RANGE = (3, 4)              # rows/cols of tiles (N, M each sampled from this)\n_MAX_MARKERS = 9                  # upper bound on marker count per grid\n_MAX_DISTINCT_NON_LATTICE = 3     # max distinct non-lattice marker colors\n_LATTICE_MARKER_PROB = 0.35       # probability of including lattice-color markers\n_NON_LATTICE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)\n_GEN_RETRIES = 300                # max attempts before giving up\n\n# Reuse cavity offsets from the solver section (identical to _INTERIOR_OFFSETS).\n_CAVITY_OFFSETS = _INTERIOR_OFFSETS\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
