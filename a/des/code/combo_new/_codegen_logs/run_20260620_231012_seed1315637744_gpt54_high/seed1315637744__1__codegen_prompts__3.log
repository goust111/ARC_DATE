{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/42f83767.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox, find_components, get_bg, paste\nimport math\nimport random\n\n\ndef _runs(values):\n    runs = []\n    start = None\n    for i, value in enumerate(values):\n        if value and start is None:\n            start = i\n        elif not value and start is not None:\n            runs.append((start, i - 1))\n            start = None\n    if start is not None:\n        runs.append((start, len(values) - 1))\n    return runs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the lower color grid by replacing each pixel with its matching top stencil.\n\n    Input structure\n    The input has a top legend and a lower dense color grid, separated by blank rows.\n    The legend contains left-to-right 2x2 color swatches and, to their right,\n    the same number of square neutral-color stencil masks.\n\n    Rule\n    Pair the swatches and stencil masks by left-to-right order. For every pixel in\n    the lower color grid, paste the paired stencil mask as one output block,\n    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.\n\n    Key insight\n    The lower grid is not copied directly; it is an index grid whose colors select\n    the stencil shape from the legend, so each input pixel becomes one square block.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_runs = _runs(np.any(g != bg, axis=1))\n    assert len(row_runs) == 2\n    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs\n    assert top_r0 == 0\n\n    stencil_size = top_r1 - top_r0 + 1\n    top = g[top_r0 : top_r1 + 1, :]\n    lower = g[pattern_r0 : pattern_r1 + 1, :]\n\n    pattern_box = bbox(lower != bg)\n    assert pattern_box is not None\n    pr0, pc0, pr1, pc1 = pattern_box\n    assert pr0 == 0 and pr1 == lower.shape[0] - 1\n    pattern = lower[:, pc0 : pc1 + 1]\n    assert np.all(pattern != bg)\n    pattern_colors = set(map(int, np.unique(pattern)))\n\n    top_colors = set(map(int, np.unique(top))) - {bg}\n    neutral_colors = top_colors - pattern_colors\n    assert len(neutral_colors) == 1\n    neutral = next(iter(neutral_colors))\n\n    swatches = []\n    for comp in find_components(top, bg=bg, colors=pattern_colors):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 4\n        assert r1 - r0 + 1 == 2\n        assert c1 - c0 + 1 == 2\n        swatches.append((c0, int(comp[\"color\"])))\n    assert len(swatches) == len(pattern_colors)\n    assert len({c0 for c0, _color in swatches}) == len(swatches)\n\n    swatch_colors = [color for _c0, color in sorted(swatches)]\n    assert set(swatch_colors) == pattern_colors\n\n    stencil_col_runs = _runs(np.any(top == neutral, axis=0))\n    assert len(stencil_col_runs) == len(swatch_colors)\n\n    stencils = {}\n    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):\n        assert c1 - c0 + 1 == stencil_size\n        mask = top[:, c0 : c1 + 1] == neutral\n        assert mask.shape == (stencil_size, stencil_size)\n        assert np.any(mask)\n        stencils[color] = mask\n\n    h, w = pattern.shape\n    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)\n    for r in range(h):\n        for c in range(w):\n            color = int(pattern[r, c])\n            assert color in stencils\n            block = out[\n                r * stencil_size : (r + 1) * stencil_size,\n                c * stencil_size : (c + 1) * stencil_size,\n            ]\n            block[stencils[color]] = color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15\nSWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1\n\n# Structural size and palette bounds.\nCOLOR_COUNT_RANGE = (2, 4)\nSTENCIL_SIZE_RANGE, PATTERN_SIDE_RANGE = range(3, 7), range(4, 8)\nMAX_OUTPUT_SIDE, AVAILABLE_COLORS = 30, [1, 2, 3, 4, 6, 7, 8, 9]\nVALID_SIZE_PAIRS = [(s, p) for s in STENCIL_SIZE_RANGE for p in PATTERN_SIDE_RANGE if s * p <= MAX_OUTPUT_SIDE]\n\n# Stencil, pattern, and retry sampling.\nSTENCIL_FILL_RANGE = (0.60, 0.89)\nUNIQUE_STENCIL_RETRIES, GENERATION_RETRIES = 80, 300\nGAP_ROWS_RANGE = (1, 3)\nPATTERN_MODES = [\"iid\", \"rows\", \"cols\", \"checker\", \"tile\"]\nTILE_SIDE_RANGE = (2, 3)\n\n\ndef _grow_stencil(size):\n    min_fill = max(2 * size - 1, math.ceil(STENCIL_FILL_RANGE[0] * size * size))\n    max_fill = math.floor(STENCIL_FILL_RANGE[1] * size * size)\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((size, size), dtype=bool)\n    mask[0, :] = True\n    mask[:, random.randrange(size)] = True\n\n    while int(mask.sum()) < target:\n        frontier = []\n        for r in range(size):\n            for c in range(size):\n                if mask[r, c]:\n                    continue\n                if (\n                    (r > 0 and mask[r - 1, c])\n                    or (r + 1 < size and mask[r + 1, c])\n                    or (c > 0 and mask[r, c - 1])\n                    or (c + 1 < size and mask[r, c + 1])\n                ):\n                    frontier.append((r, c))\n        r, c = random.choice(frontier)\n        mask[r, c] = True\n    return mask\n\n\ndef _make_stencils(count, size):\n    stencils = []\n    seen = set()\n    for _ in range(count):\n        for _retry in range(UNIQUE_STENCIL_RETRIES):\n            mask = _grow_stencil(size)\n            key = tuple(mask.ravel())\n            if key not in seen:\n                seen.add(key)\n                stencils.append(mask)\n                break\n        else:\n            return None\n    return stencils\n\n\ndef _make_pattern(colors, side):\n    mode = random.choice(PATTERN_MODES)\n    colors = list(colors)\n    if mode == \"rows\":\n        row_colors = [random.choice(colors) for _ in range(side)]\n        pattern = np.array([[row_colors[r]] * side for r in range(side)], dtype=int)\n    elif mode == \"cols\":\n        col_colors = [random.choice(colors) for _ in range(side)]\n        pattern = np.array([col_colors for _ in range(side)], dtype=int)\n    elif mode == \"checker\":\n        order = random.sample(colors, len(colors))\n        offset = random.randrange(len(order))\n        pattern = np.array(\n            [[order[(r + c + offset) % len(order)] for c in range(side)] for r in range(side)],\n            dtype=int,\n        )\n    elif mode == \"tile\":\n        tile_h = random.randint(TILE_SIDE_RANGE[0], min(TILE_SIDE_RANGE[1], side))\n        tile_w = random.randint(TILE_SIDE_RANGE[0], min(TILE_SIDE_RANGE[1], side))\n        tile = np.array(\n            [[random.choice(colors) for _c in range(tile_w)] for _r in range(tile_h)],\n            dtype=int,\n        )\n        pattern = np.tile(tile, (math.ceil(side / tile_h), math.ceil(side / tile_w)))[:side, :side]\n    else:\n        flat = [random.choice(colors) for _ in range(side * side)]\n        pattern = np.array(flat, dtype=int).reshape(side, side)\n\n    missing = [color for color in colors if color not in set(map(int, pattern.ravel()))]\n    if missing:\n        cells = random.sample(range(side * side), len(missing))\n        for idx, color in zip(cells, missing):\n            pattern[idx // side, idx % side] = color\n    return pattern\n\n\ndef _make_legend_grid(colors, stencils, size):\n    count = len(colors)\n    width = count * (size + SWATCH_STRIDE + STENCIL_GAP) - STENCIL_GAP\n    grid = np.zeros((INPUT_ROWS, width), dtype=int)\n    for i, color in enumerate(colors):\n        swatch = np.full((SWATCH_SIZE, SWATCH_SIZE), color, dtype=int)\n        paste(grid, swatch, 0, i * SWATCH_STRIDE)\n\n    stencil_start = count * SWATCH_STRIDE\n    for i, mask in enumerate(stencils):\n        patch = np.where(mask, NEUTRAL_COLOR, BACKGROUND)\n        paste(grid, patch, 0, stencil_start + i * (size + STENCIL_GAP))\n    return grid\n\n\ndef _expand(pattern, colors, stencils):\n    side = pattern.shape[0]\n    size = stencils[0].shape[0]\n    out = np.zeros((side * size, side * size), dtype=int)\n    stencil_by_color = dict(zip(colors, stencils))\n    for r in range(side):\n        for c in range(side):\n            color = int(pattern[r, c])\n            block = out[r * size : (r + 1) * size, c * size : (c + 1) * size]\n            block[stencil_by_color[color]] = color\n    return out\n\n\ndef _gen_attempt():\n    size, side = random.choice(VALID_SIZE_PAIRS)\n    count = random.randint(*COLOR_COUNT_RANGE)\n    colors = random.sample(AVAILABLE_COLORS, count)\n    stencils = _make_stencils(count, size)\n    if stencils is None:\n        return None\n\n    grid = _make_legend_grid(colors, stencils, size)\n    gap = random.randint(*GAP_ROWS_RANGE)\n    pattern = _make_pattern(colors, side)\n    pattern_col = random.randint(0, grid.shape[1] - side)\n    paste(grid, pattern, size + gap, pattern_col)\n\n    expected = _expand(pattern, colors, stencils)\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 42f83767 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/a834deea.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/a834deea.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_h, bbox_w, colors_present, crop_bbox, find_components, get_bg, paste\nimport random\n\n\nLEGEND = np.array(\n    [\n        [Color.BLUE, Color.ORANGE, Color.PINK],\n        [Color.YELLOW, Color.TEAL, Color.GREY],\n        [Color.RED, Color.MAROON, Color.GREEN],\n    ],\n    dtype=int,\n)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill each black 5x5 region's missing interior positions with a fixed 3x3 positional color legend.\n\n    Input structure\n    - The grid uses teal as the dominant background and black for one or more\n      5x5 regions.\n    - Each black region has a black one-pixel border and a 3x3 interior that\n      may already contain teal pixels.\n\n    Rule\n    - Overlay the legend 1 7 6 / 4 8 5 / 2 9 3 on the 3x3 interior of every\n      5x5 black region.\n    - Wherever an interior non-center legend position is still black, recolor it\n      to the corresponding legend color; leave existing teal pixels, the center,\n      and the black border unchanged.\n\n    Key insight\n    - The colored output pixels are not derived from the teal motif shape; they\n      are the fixed position labels for the missing cells of each 3x3 interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    assert bg == Color.TEAL\n    fg_colors = colors_present(g, exclude={bg})\n    assert fg_colors == [Color.BLACK]\n\n    out = g.copy()\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=True,\n        colors=[Color.BLACK],\n    )\n    assert components\n\n    for component in components:\n        b = component[\"bbox\"]\n        assert bbox_h(b) == 5 and bbox_w(b) == 5\n        r0, c0, _r1, _c1 = b\n        patch = crop_bbox(g, b)\n        assert np.all((patch == Color.BLACK) | (patch == bg))\n        assert np.all(patch[[0, -1], :] == Color.BLACK)\n        assert np.all(patch[:, [0, -1]] == Color.BLACK)\n        assert np.any(patch[1:4, 1:4] == bg)\n\n        for rr in range(3):\n            for cc in range(3):\n                color = int(LEGEND[rr, cc])\n                if color == bg:\n                    continue\n                grid_r = int(r0) + rr + 1\n                grid_c = int(c0) + cc + 1\n                if g[grid_r, grid_c] == Color.BLACK:\n                    out[grid_r, grid_c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and region geometry.\nMIN_GRID_SIZE, MAX_GRID_SIZE = 9, 16\nREGION_SIZE, INTERIOR_SIZE, REGION_GAP = 5, 3, 1\n\n# Region count and interior-hole sampling.\nMIN_REGIONS, MAX_REGIONS = 1, 4\nMIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR = 1, 6\nMAX_AREA_PER_REGION = 48\n\n# Generation retry limit and colors.\nMAX_GENERATION_ATTEMPTS = 300\nGEN_BG, GEN_FG = Color.TEAL, Color.BLACK\nGEN_PATCH = np.full((REGION_SIZE, REGION_SIZE), GEN_FG, dtype=int)\nGEN_INTERIOR = [\n    (rr, cc) for rr in range(INTERIOR_SIZE) for cc in range(INTERIOR_SIZE)\n]\n\n\ndef _gen_dim_slots(length):\n    return (int(length) + REGION_GAP) // (REGION_SIZE + REGION_GAP)\n\n\ndef _gen_shape_pairs(n_regions):\n    pairs = []\n    for height in range(MIN_GRID_SIZE, MAX_GRID_SIZE + 1):\n        for width in range(MIN_GRID_SIZE, MAX_GRID_SIZE + 1):\n            if _gen_dim_slots(height) * _gen_dim_slots(width) < n_regions:\n                continue\n            if height * width <= MAX_AREA_PER_REGION * n_regions:\n                continue\n            pairs.append((height, width))\n    return pairs\n\n\ndef _gen_separated(a, b):\n    ar, ac = a\n    br, bc = b\n    row_gap = ar + REGION_SIZE < br or br + REGION_SIZE < ar\n    col_gap = ac + REGION_SIZE < bc or bc + REGION_SIZE < ac\n    return row_gap or col_gap\n\n\ndef _gen_search_regions(candidates, need):\n    if need == 0:\n        return []\n    for i, pos in enumerate(candidates):\n        rest = [other for other in candidates[i + 1 :] if _gen_separated(pos, other)]\n        if len(rest) < need - 1:\n            continue\n        tail = _gen_search_regions(rest, need - 1)\n        if tail is not None:\n            return [pos] + tail\n    return None\n\n\ndef _gen_pick_regions(height, width, n_regions):\n    candidates = [\n        (r, c) for r in range(height - REGION_SIZE + 1) for c in range(width - REGION_SIZE + 1)\n    ]\n    random.shuffle(candidates)\n    return _gen_search_regions(candidates, n_regions)\n\n\ndef _gen_expected_output(grid, regions):\n    out = grid.copy()\n    for r0, c0 in regions:\n        for rr in range(INTERIOR_SIZE):\n            for cc in range(INTERIOR_SIZE):\n                color = int(LEGEND[rr, cc])\n                if color != GEN_BG and grid[r0 + rr + 1, c0 + cc + 1] == GEN_FG:\n                    out[r0 + rr + 1, c0 + cc + 1] = color\n    return out\n\n\ndef _gen_stamp_region(grid, r0, c0):\n    paste(grid, GEN_PATCH, r0, c0)\n    teal_count = random.randint(MIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR)\n    for rr, cc in random.sample(GEN_INTERIOR, teal_count):\n        grid[r0 + rr + 1, c0 + cc + 1] = GEN_BG\n\n\ndef _gen_attempt():\n    n_regions = random.randint(MIN_REGIONS, MAX_REGIONS)\n    height, width = random.choice(_gen_shape_pairs(n_regions))\n    regions = _gen_pick_regions(height, width, n_regions)\n    if regions is None:\n        return None\n\n    grid = np.full((height, width), GEN_BG, dtype=int)\n    for r0, c0 in regions:\n        _gen_stamp_region(grid, r0, c0)\n\n    expected = _gen_expected_output(grid, regions)\n    try:\n        actual = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid a834deea input\")\n","exit_code":0,"status":"completed"}}
