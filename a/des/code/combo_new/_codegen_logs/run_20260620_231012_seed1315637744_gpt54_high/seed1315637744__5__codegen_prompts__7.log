{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c61be7dc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, components_mask, get_bg\nimport random\n\n\ndef _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected exactly two non-background colors\"\n\n    boundary = set(map(int, np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))))\n    guide_colors = [color for color in colors if color in boundary]\n    object_colors = [color for color in colors if color not in boundary]\n    assert len(guide_colors) == 1, \"expected one non-background guide color touching the boundary\"\n    assert len(object_colors) == 1, \"expected one interior object color\"\n    return int(guide_colors[0]), int(object_colors[0])\n\n\ndef _midpoint(pair: list[int], axis_name: str) -> int:\n    assert len(pair) == 2, f\"expected exactly two full {axis_name} guide bars\"\n    a, b = pair\n    assert (a + b) % 2 == 0, f\"expected full {axis_name} guide bars to have a middle cell\"\n    return (a + b) // 2\n\n\ndef _unique_max_index(counts: np.ndarray, axis_name: str) -> int:\n    max_count = int(counts.max())\n    indices = np.flatnonzero(counts == max_count)\n    assert len(indices) == 1, f\"expected a unique perpendicular {axis_name} guide bar\"\n    return int(indices[0])\n\n\ndef _centered_span(center: int, length: int, limit: int) -> tuple[int, int]:\n    assert length % 2 == 1, \"expected the interior object area to be odd\"\n    start = center - length // 2\n    stop = center + length // 2\n    assert 0 <= start <= stop < limit, \"flattened object line must fit inside the grid\"\n    return start, stop\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Flatten the interior object into a centered line and move the guide bars inward to bracket it.\n\n    Input structure:\n    - The dominant color is the background.\n    - One non-background guide color touches the boundary and forms exactly two full parallel bars plus a split perpendicular center bar.\n    - The other non-background color is a single 8-connected interior object whose area determines the flattened line length.\n\n    Rule:\n    - If the guide pair is vertical, make a vertical object-colored line centered between those bars; otherwise use the analogous horizontal line.\n    - The line length equals the number of interior object pixels and is centered on the split perpendicular guide bar.\n    - Rebuild the guide color as the perpendicular center bar plus two full bars immediately beside the flattened object line.\n\n    Key insight:\n    - The guide bars supply only the orientation and center; the interior object's pixel count supplies the length of the final one-cell-thick line.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    guide_color, object_color = _role_colors(g, bg)\n    object_mask = g == object_color\n    object_components = components_mask(object_mask, connectivity=8)\n    assert len(object_components) == 1, \"expected one 8-connected interior object\"\n    object_area = int(object_components[0].shape[0])\n    assert object_area > 0, \"expected a nonempty interior object\"\n\n    guide_mask = g == guide_color\n    row_counts = np.count_nonzero(guide_mask, axis=1)\n    col_counts = np.count_nonzero(guide_mask, axis=0)\n    full_rows = np.flatnonzero(row_counts == width).tolist()\n    full_cols = np.flatnonzero(col_counts == height).tolist()\n    has_horizontal_pair = len(full_rows) == 2\n    has_vertical_pair = len(full_cols) == 2\n    assert has_horizontal_pair ^ has_vertical_pair, \"expected exactly one pair of full parallel guide bars\"\n\n    out = np.full_like(g, int(bg))\n    if has_vertical_pair:\n        center_col = _midpoint(full_cols, \"vertical\")\n        center_row = _unique_max_index(row_counts, \"row\")\n        start_row, stop_row = _centered_span(center_row, object_area, height)\n        assert 0 < center_col < width - 1, \"vertical flattened line must have guide bars on both sides\"\n\n        out[:, center_col - 1] = guide_color\n        out[:, center_col + 1] = guide_color\n        out[center_row, :] = guide_color\n        out[start_row : stop_row + 1, center_col] = object_color\n    else:\n        center_row = _midpoint(full_rows, \"horizontal\")\n        center_col = _unique_max_index(col_counts, \"column\")\n        start_col, stop_col = _centered_span(center_col, object_area, width)\n        assert 0 < center_row < height - 1, \"horizontal flattened line must have guide bars above and below\"\n\n        out[center_row - 1, :] = guide_color\n        out[center_row + 1, :] = guide_color\n        out[:, center_col] = guide_color\n        out[center_row, start_col : stop_col + 1] = object_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 7\nGEN_GUIDE = 0\nGEN_OBJECT = 5\n\n# Canvas, object, guide gap, and retry sampling bounds.\nGEN_GRID_SIZES = [11, 13, 15, 17, 19]\nGEN_ORIENTATIONS = [\"V\", \"H\"]\nGEN_AREA_MIN = 5\nGEN_AREA_MAX = 13\nGEN_AREA_STEP = 2\nGEN_GAPS = (4, 6, 8)\nGEN_MIN_GAP_EXTRA = 2\nGEN_BOUNDARY_MARGIN = 1\nGEN_MAX_ATTEMPTS = 300\n\nGEN_NEIGHBOR_STEPS = [\n    (dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc\n]\n\n\ndef _gen_expected_output(n: int, orientation: str, area: int) -> np.ndarray:\n    center = n // 2\n    out = np.full((n, n), GEN_BG, dtype=int)\n    start, stop = center - area // 2, center + area // 2\n\n    if orientation == \"V\":\n        out[:, center - 1] = GEN_GUIDE\n        out[:, center + 1] = GEN_GUIDE\n        out[center, :] = GEN_GUIDE\n        out[start : stop + 1, center] = GEN_OBJECT\n    else:\n        out[center - 1, :] = GEN_GUIDE\n        out[center + 1, :] = GEN_GUIDE\n        out[:, center] = GEN_GUIDE\n        out[center, start : stop + 1] = GEN_OBJECT\n\n    return out\n\n\ndef _gen_sample_layout() -> tuple[int, int, str, int]:\n    n = random.choice(GEN_GRID_SIZES)\n    center = n // 2\n    orientation = random.choice(GEN_ORIENTATIONS)\n    area = random.choice(range(GEN_AREA_MIN, min(GEN_AREA_MAX, n) + 1, GEN_AREA_STEP))\n    return n, center, orientation, area\n\n\ndef _gen_gap_options(n: int, area: int) -> list[int]:\n    min_gap = int(np.ceil(np.sqrt(area))) + GEN_MIN_GAP_EXTRA\n    return [g for g in GEN_GAPS if g <= n - 4 and g >= min_gap]\n\n\ndef _gen_draw_input_guides(\n    grid: np.ndarray, orientation: str, center: int, lo: int, hi: int\n) -> tuple[int, int, int, int]:\n    if orientation == \"V\":\n        grid[:, lo] = GEN_GUIDE\n        grid[:, hi] = GEN_GUIDE\n        grid[center, : lo + 1] = GEN_GUIDE\n        grid[center, hi:] = GEN_GUIDE\n        return GEN_BOUNDARY_MARGIN, grid.shape[0] - 1 - GEN_BOUNDARY_MARGIN, lo + 1, hi - 1\n    else:\n        grid[lo, :] = GEN_GUIDE\n        grid[hi, :] = GEN_GUIDE\n        grid[: lo + 1, center] = GEN_GUIDE\n        grid[hi:, center] = GEN_GUIDE\n        return lo + 1, hi - 1, GEN_BOUNDARY_MARGIN, grid.shape[1] - 1 - GEN_BOUNDARY_MARGIN\n\n\ndef _gen_blob_coords(\n    area: int,\n    row_min: int,\n    row_max: int,\n    col_min: int,\n    col_max: int,\n    seed_r: int,\n    seed_c: int,\n) -> set[tuple[int, int]]:\n    start = (\n        min(max(seed_r, row_min), row_max),\n        min(max(seed_c, col_min), col_max),\n    )\n    coords = {start}\n    frontier = {\n        (start[0] + dr, start[1] + dc)\n        for dr, dc in GEN_NEIGHBOR_STEPS\n        if row_min <= start[0] + dr <= row_max\n        and col_min <= start[1] + dc <= col_max\n    }\n\n    while len(coords) < area:\n        options = tuple(frontier)\n        weights = []\n        for r, c in options:\n            neighbors = sum(\n                (r + dr, c + dc) in coords\n                for dr, dc in GEN_NEIGHBOR_STEPS\n            )\n            dist = abs(r - seed_r) + abs(c - seed_c)\n            weights.append((neighbors + 1) ** 2 / (dist + 1))\n        cell = random.choices(options, weights=weights, k=1)[0]\n        frontier.remove(cell)\n        coords.add(cell)\n        r, c = cell\n        for dr, dc in GEN_NEIGHBOR_STEPS:\n            nxt = (r + dr, c + dc)\n            if (\n                row_min <= nxt[0] <= row_max\n                and col_min <= nxt[1] <= col_max\n                and nxt not in coords\n            ):\n                frontier.add(nxt)\n\n    return coords\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n, center, orientation, area = _gen_sample_layout()\n    expected = _gen_expected_output(n, orientation, area)\n\n    gaps = _gen_gap_options(n, area)\n    if not gaps:\n        return None\n    gap = random.choice(gaps)\n    lo = center - gap // 2\n    hi = center + gap // 2\n\n    grid = np.full((n, n), GEN_BG, dtype=int)\n    row_min, row_max, col_min, col_max = _gen_draw_input_guides(\n        grid, orientation, center, lo, hi\n    )\n    coords = _gen_blob_coords(area, row_min, row_max, col_min, col_max, center, center)\n    rows, cols = zip(*coords)\n    grid[rows, cols] = GEN_OBJECT\n\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid c61be7dc input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n","exit_code":0,"status":"completed"}}
