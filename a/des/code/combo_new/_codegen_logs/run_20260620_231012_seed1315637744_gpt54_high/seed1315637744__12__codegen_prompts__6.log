{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _dominant_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size > 0, \"expected foreground pixels\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"expected one largest foreground color for lattice frames\"\n    return int(winners[0])\n\n\ndef _parse_frames(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[list[int], list[int]]]:\n    frames: list[tuple[list[int], list[int]]] = []\n    components = find_components(\n        g,\n        bg=int(bg),\n        colors=[int(frame_color)],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert components, \"expected at least one lattice frame\"\n\n    for comp in components:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        sub = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(frame_color)\n\n        row_idx = [r for r in range(sub.shape[0]) if bool(sub[r, :].all())]\n        col_idx = [c for c in range(sub.shape[1]) if bool(sub[:, c].all())]\n        assert len(row_idx) >= 2 and len(col_idx) >= 2, \"frame must divide slots\"\n        assert row_idx[0] == 0 and row_idx[-1] == sub.shape[0] - 1\n        assert col_idx[0] == 0 and col_idx[-1] == sub.shape[1] - 1\n        assert all(a + 1 < b for a, b in zip(row_idx, row_idx[1:]))\n        assert all(a + 1 < b for a, b in zip(col_idx, col_idx[1:]))\n\n        expected = np.zeros_like(sub, dtype=bool)\n        expected[row_idx, :] = True\n        expected[:, col_idx] = True\n        assert np.array_equal(sub, expected), \"frame must be a complete rectangular lattice\"\n\n        rows = [int(r0) + r for r in row_idx]\n        cols = [int(c0) + c for c in col_idx]\n        frames.append((rows, cols))\n\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    for rows, cols in frames:\n        assert len(rows) - 1 == slot_rows\n        assert len(cols) - 1 == slot_cols\n    return frames\n\n\ndef _infer_slot_colors(\n    g: np.ndarray,\n    bg: int,\n    frame_color: int,\n    frames: list[tuple[list[int], list[int]]],\n) -> dict[tuple[int, int], int]:\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    colors: dict[tuple[int, int], int] = {}\n\n    for rows, cols in frames:\n        for sr in range(slot_rows):\n            for sc in range(slot_cols):\n                region = g[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]]\n                marker = region[(region != int(bg)) & (region != int(frame_color))]\n                if marker.size == 0:\n                    continue\n                vals = np.unique(marker)\n                assert vals.size == 1, \"each colored slot must contain one color\"\n                color = int(vals[0])\n                key = (sr, sc)\n                assert key not in colors or colors[key] == color\n                colors[key] = color\n\n    expected = {(sr, sc) for sr in range(slot_rows) for sc in range(slot_cols)}\n    assert set(colors) == expected, \"colored slots must identify every logical slot\"\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill every lattice slot from the color assigned to that slot position by the other lattices.\n\n    Input structure:\n    - The background is the dominant color.\n    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.\n    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.\n\n    Rule:\n    - Infer a color for each logical slot position from the colored slots across all lattice frames.\n    - Repaint every slot interior in every lattice with the inferred color for its row/column position.\n    - Keep the frame lines and all background outside frames unchanged.\n\n    Key insight:\n    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color = _dominant_foreground_color(g, bg)\n    frames = _parse_frames(g, bg, frame_color)\n    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)\n\n    out = g.copy()\n    for rows, cols in frames:\n        for sr in range(len(rows) - 1):\n            for sc in range(len(cols) - 1):\n                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[\n                    (sr, sc)\n                ]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette choices.\nBG = 0\nGRID_SIZE_RANGE = (22, 28)\nNEAR_SQUARE_PROB = 0.65\nNEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]\nFOREGROUND_COLORS = range(1, 10)\nPALETTE_SIZE = 5\n\n# Lattice geometry.\nSLOT_SIZE_RANGE = (1, 8)\nFRAME_HEIGHT_RANGE = (5, 18)\nFRAME_WIDTH_RANGE = (5, 14)\nLATTICE_LINE_COUNT = 3\nSLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# Frame count and area allocation.\nFRAME_COUNT_RANGE = (4, 6)\nMIN_FRAME_AREA = 25\nAREA_BUDGET_RANGE = (0.55, 0.88)\nAREA_WEIGHT_SCALE = 35.0\n\n# Placement and retry limits.\nEDGE_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\nFrameSpec = tuple[tuple[int, int], tuple[int, int]]\nPlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]\nSlotColors = dict[tuple[int, int], int]\n\n\ndef _line_indices(lengths: tuple[int, int]) -> list[int]:\n    return [0, int(lengths[0]) + 1, int(lengths[0]) + int(lengths[1]) + 2]\n\n\ndef _slot_options() -> dict[tuple[int, int], list[FrameSpec]]:\n    options: dict[tuple[int, int], list[FrameSpec]] = {}\n    slot_min, slot_max = SLOT_SIZE_RANGE\n    height_min, height_max = FRAME_HEIGHT_RANGE\n    width_min, width_max = FRAME_WIDTH_RANGE\n    for h0 in range(slot_min, slot_max + 1):\n        for h1 in range(slot_min, slot_max + 1):\n            height = h0 + h1 + LATTICE_LINE_COUNT\n            if not height_min <= height <= height_max:\n                continue\n            for w0 in range(slot_min, slot_max + 1):\n                for w1 in range(slot_min, slot_max + 1):\n                    width = w0 + w1 + LATTICE_LINE_COUNT\n                    if not width_min <= width <= width_max:\n                        continue\n                    options.setdefault((height, width), []).append(((h0, h1), (w0, w1)))\n    return options\n\n\n_SIZE_OPTIONS = _slot_options()\n\n\ndef _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:\n    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]\n    random.shuffle(keys)\n\n    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)\n    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))\n    chosen_sizes: list[tuple[int, int]] = []\n    remaining = budget\n\n    for i in range(n_frames):\n        slots_left = n_frames - i - 1\n        candidates = [\n            size\n            for size in keys\n            if size not in chosen_sizes\n            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA\n        ]\n        if not candidates:\n            return None\n        weights = []\n        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))\n        for height, width in candidates:\n            area = height * width\n            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))\n        size = random.choices(candidates, weights=weights, k=1)[0]\n        chosen_sizes.append(size)\n        remaining -= size[0] * size[1]\n\n    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]\n    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)\n    return specs\n\n\ndef _choose_canvas_shape() -> tuple[int, int]:\n    grid_min, grid_max = GRID_SIZE_RANGE\n    rows = random.randint(grid_min, grid_max)\n    cols = random.randint(grid_min, grid_max)\n    if random.random() < NEAR_SQUARE_PROB:\n        delta = random.choice(NEAR_SQUARE_DELTAS)\n        cols = min(grid_max, max(grid_min, rows + delta))\n    return rows, cols\n\n\ndef _choose_palette() -> tuple[int, SlotColors]:\n    colors = random.sample(FOREGROUND_COLORS, PALETTE_SIZE)\n    frame_color = colors[0]\n    color_values = colors[1:]\n    random.shuffle(color_values)\n    slot_colors = {pos: color_values[i] for i, pos in enumerate(SLOT_POSITIONS)}\n    return frame_color, slot_colors\n\n\ndef _make_output_patch(heights: tuple[int, int], widths: tuple[int, int], frame_color: int, slot_colors: SlotColors) -> tuple[np.ndarray, list[int], list[int]]:\n    row_lines = _line_indices(heights)\n    col_lines = _line_indices(widths)\n    patch = np.zeros((row_lines[-1] + 1, col_lines[-1] + 1), dtype=int)\n    patch[row_lines, :] = int(frame_color)\n    patch[:, col_lines] = int(frame_color)\n\n    for sr, sc in SLOT_POSITIONS:\n        patch[row_lines[sr] + 1 : row_lines[sr + 1], col_lines[sc] + 1 : col_lines[sc + 1]] = slot_colors[(sr, sc)]\n    return patch, row_lines, col_lines\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, paste\n\n\ndef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n    h, w = g.shape\n    containers = []\n\n    for bottom in range(1, h):\n        for left in range(w - 2):\n            if int(g[bottom, left]) != wall_color:\n                continue\n            for right in range(left + 2, w):\n                if int(g[bottom, right]) != wall_color:\n                    continue\n                if not np.all(g[bottom, left : right + 1] == wall_color):\n                    continue\n\n                top = bottom\n                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n                    top -= 1\n                if top == bottom:\n                    continue\n\n                interior = g[top:bottom, left + 1 : right]\n                if interior.size == 0 or not np.all(interior == bg):\n                    continue\n                containers.append((top, bottom, left, right))\n\n    return containers\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n","exit_code":0,"status":"completed"}}
