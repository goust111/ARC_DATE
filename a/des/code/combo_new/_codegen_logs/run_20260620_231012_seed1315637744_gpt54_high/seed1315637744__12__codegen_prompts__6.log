{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, components_mask\nimport random\n\nBBox = tuple[int, int, int, int]\n\n\ndef _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:\n    r0, c0, r1, c1 = bbox\n    h, w = shape\n    sides = []\n    if r0 == 0:\n        sides.append(\"top\")\n    if r1 == h - 1:\n        sides.append(\"bottom\")\n    if c0 == 0:\n        sides.append(\"left\")\n    if c1 == w - 1:\n        sides.append(\"right\")\n    assert len(sides) == 1, \"each black rectangle must touch exactly one grid edge\"\n    return sides[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n    total: int, n: int, min_size: int, max_size: int, min_gap: int = 0\n) -> list[tuple[int, int]] | None:\n    \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n    if n == 0:\n        return []\n\n    needed = n * min_size + (n - 1) * min_gap\n    if needed > total:\n        return None\n\n    effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))\n    if effective_max < min_size:\n        return None\n\n    widths = [random.randint(min_size, effective_max) for _ in range(n)]\n    total_used = sum(widths) + (n - 1) * min_gap\n    if total_used > total:\n        excess = total_used - total\n        indices = list(range(n))\n        random.shuffle(indices)\n        for i in indices:\n            shrink = min(widths[i] - min_size, excess)\n            widths[i] -= shrink\n            excess -= shrink\n            if excess == 0:\n                break\n        if excess > 0:\n            return None\n\n    remaining = total - sum(widths) - (n - 1) * min_gap\n    extra_gaps = [0] * (n + 1)\n    for _ in range(remaining):\n        extra_gaps[random.randint(0, n)] += 1\n\n    bands = []\n    pos = 0\n    for i in range(n):\n        pos += extra_gaps[i]\n        if i > 0:\n            pos += min_gap\n        bands.append((pos, pos + widths[i] - 1))\n        pos += widths[i]\n    return bands\n\n\ndef _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:\n    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)\n    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)\n    feasible = [(v, n_rects - v) for v in range(n_rects + 1)\n                if v <= max_vert and (n_rects - v) <= max_horiz]\n    if not feasible:\n        return None\n    return random.choice(feasible)\n\n\ndef _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:\n    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H\n    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W\n    if min_h > MAX_H or min_w > MAX_W:\n        return None\n    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)\n\n\ndef _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:\n    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)\n    if raw is None:\n        return None\n    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]\n\n\ndef _rect_span_for_band(band_size: int, travel: int) -> int | None:\n    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)\n    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))\n    if min_len > max_len:\n        return None\n    return random.randint(min_len, max_len)\n\n\ndef _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:\n    \"\"\"Return destination rectangles plus their original source edge.\"\"\"\n    vert_edges = [random.choice([\"top\", \"bottom\"]) for _ in range(n_vert)]\n    horiz_edges = [random.choice([\"left\", \"right\"]) for _ in range(n_horiz)]\n\n    col_bands = _interior_bands(W, n_vert)\n    if col_bands is None:\n        return None\n    row_bands = _interior_bands(H, n_horiz)\n    if row_bands is None:\n        return None\n\n    rects = []\n    for i, (c0, c1) in enumerate(col_bands):\n        rect_w = c1 - c0 + 1\n        rect_h = _rect_span_for_band(rect_w, H)\n        if rect_h is None:\n            return None\n        se = vert_edges[i]\n        if se == \"top\":\n            dr0, dr1 = H - rect_h, H - 1\n        else:\n            dr0, dr1 = 0, rect_h - 1\n        rects.append((dr0, c0, dr1, c1, se))\n\n    for i, (r0, r1) in enumerate(row_bands):\n        rect_h = r1 - r0 + 1\n        rect_w = _rect_span_for_band(rect_h, W)\n        if rect_w is None:\n            return None\n        se = horiz_edges[i]\n        if se == \"left\":\n            dc0, dc1 = W - rect_w, W - 1\n        else:\n            dc0, dc1 = 0, rect_w - 1\n        rects.append((r0, dc0, r1, dc1, se))\n\n    return rects\n\n\ndef _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:\n    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)\n\n\ndef _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:\n    output = _random_background((H, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            output[:, dc0:dc1 + 1] = BG_ORANGE\n        else:\n            output[dr0:dr1 + 1, :] = BG_ORANGE\n\n    for (dr0, dc0, dr1, dc1, _) in rects:\n        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0\n    return output\n\n\ndef _invert_output_to_input(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_w, colors_present, crop_bbox, find_components, get_bg, is_contiguous, paste\nimport itertools\nimport random\n\n\ndef _cells(component):\n    return set(map(tuple, component[\"coords\"]))\n\n\ndef _is_top_bracket(component) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r0 != 0 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r0, c) for c in range(c0, c1 + 1)}\n    expected |= {(r1, c0), (r1, c1)}\n    return _cells(component) == expected\n\n\ndef _is_bottom_bracket(component, height: int) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r1 != height - 1 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r1, c) for c in range(c0, c1 + 1)}\n    expected |= {(r0, c0), (r0, c1)}\n    return _cells(component) == expected\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_half_starts(grid_width, bracket_width, left_side):\n    if left_side:\n        return list(range(0, grid_width // 2 - bracket_width + 1))\n    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n\ndef _gen_bracket_columns(grid_width, bracket_width):\n    \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n    top_left = random.choice(TOP_LEFT_OPTIONS)\n    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n    if not top_starts or not bottom_starts:\n        return None\n    return random.choice(top_starts), random.choice(bottom_starts)\n\ndef _gen_add_bracket(grid, c0, width, top_edge):\n    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n    grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n    grid[arm_row, c0] = BRACKET_COLOR\n    grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n\ndef _gen_sprite_masks(height, width):\n    area = height * width\n    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n    max_cells = min(MOVER_MAX_CELLS, area)\n    masks = []\n    for cell_count in range(min_cells, max_cells + 1):\n        for cells in itertools.combinations(range(area), cell_count):\n            mask = np.zeros((height, width), dtype=bool)\n            mask[np.unravel_index(cells, (height, width))] = True\n            if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n                continue\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n    return masks\n\ndef _gen_mover_sprite(height, width, color, bg):\n    masks = _gen_sprite_masks(height, width)\n    if not masks:\n        return None\n    mask = random.choice(masks)\n    sprite = np.full((height, width), bg, dtype=int)\n    sprite[mask] = color\n    return sprite\n\ndef _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n    \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n    if not np.all(target[sprite_mask] == BG_COLOR):\n        return False\n    paste(grid, sprite, row, col, transparent=BG_COLOR)\n    return True\n\ndef _gen_attempt():\n    height = random.randint(*GRID_SIZE_RANGE)\n    grid_width = random.randint(*GRID_SIZE_RANGE)\n    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n    interior_width = bracket_width - 2\n\n    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n    if bracket_columns is None:\n        return None\n    top_c0, bottom_c0 = bracket_columns\n\n    mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n    mover_color = random.choice(MOVER_COLORS)\n    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n    if sprite is None:\n        return None\n\n    out = np.full((height, grid_width), BG_COLOR, dtype=int)\n    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n\n    dest_r = height - mover_height\n    dest_c = top_c0 + 1\n    sprite_mask = sprite != BG_COLOR\n    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n        return None\n\n    inp = out.copy()\n    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n    target[sprite_mask] = BG_COLOR\n\n    source_c = bottom_c0 + 1\n    max_source_r = height - 2 - mover_height\n    if max_source_r < 1:\n        return None\n    source_r = random.randint(1, max_source_r)\n    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n        return None\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n","exit_code":0,"status":"completed"}}
