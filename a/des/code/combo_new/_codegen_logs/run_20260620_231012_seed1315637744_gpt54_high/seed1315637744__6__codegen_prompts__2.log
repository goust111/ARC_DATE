{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/83b6b474.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nfrom functools import lru_cache\nimport random\n\n\ndef _border(shape: tuple[int, int]) -> frozenset[tuple[int, int]]:\n    h, w = shape\n    return frozenset(\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r == 0 or r == h - 1 or c == 0 or c == w - 1\n    )\n\n\ndef _candidate_outputs(\n    bg: int, objects: list[dict], total_area: int\n) -> list[np.ndarray]:\n    outputs: list[tuple[int, np.ndarray]] = []\n\n    for h in range(2, total_area + 1):\n        for w in range(2, total_area + 1):\n            if 2 * h + 2 * w - 4 != total_area:\n                continue\n\n            border = _border((h, w))\n            placements_by_object: list[list[frozenset[tuple[int, int]]]] = []\n            for obj in objects:\n                placements: list[frozenset[tuple[int, int]]] = []\n                for r0 in range(h - obj[\"h\"] + 1):\n                    for c0 in range(w - obj[\"w\"] + 1):\n                        cells = frozenset(\n                            (r0 + r, c0 + c) for r, c in obj[\"rel\"]\n                        )\n                        if cells <= border:\n                            placements.append(cells)\n                if not placements:\n                    break\n                placements_by_object.append(placements)\n            else:\n                order = sorted(\n                    range(len(objects)),\n                    key=lambda i: (\n                        len(placements_by_object[i]),\n                        -objects[i][\"area\"],\n                        objects[i][\"bbox\"][0],\n                        objects[i][\"bbox\"][1],\n                    ),\n                )\n                solved: list[np.ndarray] = []\n\n                def search(\n                    k: int,\n                    used: frozenset[tuple[int, int]],\n                    chosen: list[tuple[int, frozenset[tuple[int, int]]]],\n                ) -> None:\n                    if k == len(order):\n                        if used == border:\n                            out = np.full((h, w), bg, dtype=int)\n                            for obj_idx, cells in chosen:\n                                for r, c in cells:\n                                    out[r, c] = objects[obj_idx][\"color\"]\n                            solved.append(out)\n                        return\n\n                    obj_idx = order[k]\n                    for cells in placements_by_object[obj_idx]:\n                        if cells & used:\n                            continue\n                        search(k + 1, used | cells, chosen + [(obj_idx, cells)])\n\n                search(0, frozenset(), [])\n\n                seen: set[tuple[int, ...]] = set()\n                for out in solved:\n                    key = tuple(map(int, out.ravel()))\n                    if key in seen:\n                        continue\n                    seen.add(key)\n                    outputs.append((abs(h - w), out))\n\n    assert outputs, \"the objects must assemble into at least one rectangular frame\"\n    best_balance = min(balance for balance, _out in outputs)\n    best = [out for balance, out in outputs if balance == best_balance]\n    unique = {(out.shape, tuple(map(int, out.ravel()))) for out in best}\n    assert len(unique) == 1, \"the most balanced frame assembly must be unique\"\n    return best\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Translate the colored objects into the most balanced complete rectangular frame.\n\n    Input structure\n    A grid with one dominant background color and several monochromatic\n    4-connected foreground objects that are straight bars or corner-like line\n    sprites.\n\n    Rule\n    Preserve every foreground object exactly, allowing translation only, and\n    place the objects so they cover every pixel of a one-cell-thick rectangular\n    frame exactly once; the frame interior is the background color.\n\n    Key insight\n    The output shape is not copied from the input: the foreground pixel count\n    determines possible frame sizes, and the intended output is the valid frame\n    assembly with the least difference between height and width.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(\n        g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"\n    )\n    assert components, \"at least one foreground object is required\"\n\n    objects: list[dict] = []\n    for comp in components:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        rel = tuple(\n            sorted((int(r - r0), int(c - c0)) for r, c in comp[\"coords\"])\n        )\n        objects.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"rel\": rel,\n                \"h\": int(r1 - r0 + 1),\n                \"w\": int(c1 - c0 + 1),\n                \"area\": int(comp[\"area\"]),\n            }\n        )\n\n    objects.sort(key=lambda obj: (obj[\"bbox\"][0], obj[\"bbox\"][1], -obj[\"area\"]))\n    total_area = sum(obj[\"area\"] for obj in objects)\n    best = _candidate_outputs(bg, objects, total_area)\n    return best[0]\n\n# --------------- generator (att2) ---------------\n\n# Palette and object mix.\nCOLOR_COUNT = 10\nOBJECT_COUNT_CHOICES = (4, 5)\nL_COUNTS_BY_OBJECT_COUNT = {4: (2, 3), 5: (3,)}\n\n# Border arc and sprite shape bounds.\nARC_MIN_LEN, ARC_MAX_LEN = 1, 7\nBAR_MIN_AREA, BAR_MAX_AREA = 1, 7\nL_MIN_AREA, L_MAX_AREA = 3, 7\nL_MIN_HEIGHT, L_MAX_HEIGHT = 2, 6\nL_MIN_WIDTH, L_MAX_WIDTH = 2, 5\nMIN_LENGTH_VARIETY_BY_COUNT = {4: 2, 5: 3}\n\n# Frame, input canvas, and placement bounds.\nFRAME_MIN_SIDE, FRAME_MAX_SIDE = 4, 8\nFRAME_SIZE_OFFSETS = ((0, 0), (0, 1), (1, 0))\nINPUT_MIN_SIDE, INPUT_MAX_SIDE, INPUT_FRAME_MARGIN = 6, 16, 2\nPLACEMENT_BORDER, PLACEMENT_PADDING = 0, 0\nGENERATION_ATTEMPTS = 300\n\n\ndef _border_coords(h: int, w: int) -> tuple[tuple[int, int], ...]:\n    coords = [(0, c) for c in range(w)]\n    coords += [(r, w - 1) for r in range(1, h)]\n    coords += [(h - 1, c) for c in range(w - 2, -1, -1)]\n    coords += [(r, 0) for r in range(h - 2, 0, -1)]\n    return tuple(coords)\n\n\ndef _compositions(total: int, parts: int) -> list[tuple[int, ...]]:\n    out: list[tuple[int, ...]] = []\n\n    def rec(remaining: int, n: int, prefix: list[int]) -> None:\n        if n == 1:\n            if ARC_MIN_LEN <= remaining <= ARC_MAX_LEN:\n                out.append(tuple(prefix + [remaining]))\n            return\n        lo = max(ARC_MIN_LEN, remaining - ARC_MAX_LEN * (n - 1))\n        hi = min(ARC_MAX_LEN, remaining - ARC_MIN_LEN * (n - 1))\n        for x in range(lo, hi + 1):\n            rec(remaining - x, n - 1, prefix + [x])\n\n    rec(total, parts, [])\n    return out\n\n\ndef _coord_bounds(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:\n    rows, cols = zip(*coords)\n    return min(rows), min(cols), max(rows), max(cols)\n\n\ndef _arc_kind(coords: tuple[tuple[int, int], ...]) -> str | None:\n    r0, c0, r1, c1 = _coord_bounds(coords)\n    h, w = r1 - r0 + 1, c1 - c0 + 1\n    area = len(coords)\n\n    if h == 1 or w == 1:\n        return \"bar\" if BAR_MIN_AREA <= area <= BAR_MAX_AREA else None\n\n    if not (\n        L_MIN_AREA <= area <= L_MAX_AREA\n        and L_MIN_HEIGHT <= h <= L_MAX_HEIGHT\n        and L_MIN_WIDTH <= w <= L_MAX_WIDTH\n    ):\n        return None\n    if area != h + w - 1:\n        return None\n\n    actual = {(r - r0, c - c0) for r, c in coords}\n    for elbow_r, elbow_c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)):\n        expected = {\n            (r, c)\n            for r in range(h)\n            for c in range(w)\n            if r == elbow_r or c == elbow_c\n        }\n        if actual == expected:\n            return \"L\"\n    return None\n\n\n@lru_cache(maxsize=None)\ndef _valid_plans(h: int, w: int, count: int, l_count: int):\n    border = _border_coords(h, w)\n    perimeter = len(border)\n    plans: list[tuple[tuple[tuple[int, int], ...], ...]] = []\n\n    for start in range(perimeter):\n        for lengths in _compositions(perimeter, count):\n            pos = start\n            arcs: list[tuple[tuple[int, int], ...]] = []\n            kinds: list[str] = []\n            for length in lengths:\n                coords = tuple(border[(pos + i) % perimeter] for i in range(length))\n                kind = _arc_kind(coords)\n                if kind is None:\n                    break\n                arcs.append(coords)\n                kinds.append(kind)\n                pos = (pos + length) % perimeter\n            else:\n                if pos != start:\n                    continue\n                if kinds.count(\"L\") != l_count or kinds.count(\"bar\") != count - l_count:\n                    continue\n                if len(set(lengths)) < MIN_LENGTH_VARIETY_BY_COUNT[count]:\n                    continue\n                plans.append(tuple(arcs))\n\n    return tuple(plans)\n\n\ndef _patch_from_arc(coords: tuple[tuple[int, int], ...], bg: int, color: int) -> np.ndarray:\n    r0, c0, r1, c1 = _coord_bounds(coords)\n    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)\n    for r, c in coords:\n        patch[r - r0, c - c0] = color\n    return patch\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _hole_count(mask: np.ndarray) -> int:\n    \"\"\"\n    Count holes in a binary mask using 4-connectivity.\n    A hole is a background component that does not touch the mask's bounding box border.\n    \"\"\"\n    h, w = mask.shape\n    bg = ~mask\n    vis = np.zeros((h, w), dtype=bool)\n    holes = 0\n    for r0 in range(h):\n        for c0 in range(w):\n            if not bg[r0, c0] or vis[r0, c0]:\n                continue\n            st = [(r0, c0)]\n            vis[r0, c0] = True\n            touches = False\n            while st:\n                r, c = st.pop()\n                if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n                    touches = True\n                for rr, cc in neighbors4(r, c):\n                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:\n                        vis[rr, cc] = True\n                        st.append((rr, cc))\n            if not touches:\n                holes += 1\n    return holes\n\n\ndef _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:\n    \"\"\"\n    Pick one 'legend' component per non-(bg,grey) color:\n      - component is at least 2x2,\n      - component does not touch the outer grid border (filters dividers).\n    Map hole_count -> legend_color.\n    \"\"\"\n    h, w = g.shape\n    mapping: dict[int, int] = {}\n    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]\n    for c in colors:\n        comps = components_mask(g == c, connectivity=4)\n        candidates = []\n        for pts in comps:\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n                continue\n            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:\n                continue\n            candidates.append((r0, c0, r1, c1))\n        if not candidates:\n            continue\n        assert len(candidates) == 1, f\"color {c} must have exactly one legend component\"\n        r0, c0, r1, c1 = candidates[0]\n        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)\n        hc = _hole_count(sub)\n        assert hc not in mapping, f\"legend hole count {hc} must map to exactly one color\"\n        mapping[hc] = c\n    return mapping\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor grey shapes by matching their hole count to a color legend.\n\n    Input structure:\n    - bg = most common color; grey (5) sprites scattered across the grid.\n    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n      each with a distinct number of enclosed holes.\n\n    Rule:\n    - Each colored legend shape defines a mapping: hole count → color.\n    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n\n    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    grey = 5\n\n    legend = _legend_mapping(g, bg, grey)\n    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n\n    out = g.copy()\n    for pts in components_mask(g == grey, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts)\n        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n        for r, c in pts:\n            sub[r - r0, c - c0] = True\n        hc = _hole_count(sub)\n        newc = int(legend[hc]) if hc in legend else bg\n        for r, c in pts:\n            out[r, c] = newc\n\n    return out\n\n# --------------- generator (holes-first organic blob) ---------------\n\nfrom arc_utils import label_mask\nfrom scipy.ndimage import binary_dilation, generate_binary_structure\n\n# -- palette & grid --\nBG = 0\nDIV = 1\nGREY = 5\nGRID_SIZE = 30\nLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n\n# -- legend panel --\nLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\nMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\nPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\nFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\nL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\nL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n\n# -- sprites --\nTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\nMAX_DISTRACTORS = 7                 # max distractor sprites\nMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\nSPRITE_RETRIES = 30                 # retries per sprite generation attempt\nSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\nSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n# 3+ hole sprites: min = 10+2*h, max = 20+4*h\nCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\nCANVAS_MIN = 5                      # minimum canvas dimension\nCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\nHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\nHOLE_SEED_MIN_RADIUS = 2\nHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\nHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\nSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\nSPRITE_MAX_H = 12                   # max sprite bbox height\nSPRITE_MAX_W = 18                   # max sprite bbox width\nSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n\n# -- generation --\nGEN_RETRIES = 300                   # outer retries for generate_input()\n\n# 8-connectivity structuring element for dilation\n_STRUCT8 = generate_binary_structure(2, 2)\n\n\n# ---------- legend helpers ----------\n\ndef _legend_span(hole_count: int) -> int:\n    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n    return 3 if hole_count == 0 else 2 * hole_count + 1\n\n\ndef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n    span = _legend_span(hole_count)\n    if arrangement == \"horizontal\":\n        patch = np.full((3, span), int(color), dtype=int)\n        if hole_count:\n            patch[1, 1::2] = BG\n    else:\n        patch = np.full((span, 3), int(color), dtype=int)\n        if hole_count:\n            patch[1::2, 1] = BG\n    return patch\n\n\ndef _line_span(legends: list[tuple[int, int]]) -> int:\n    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n\n\ndef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n    count = random.randint(*LEGEND_COUNT_RANGE)\n    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n    if not combos:\n        return _choose_legends(arrangement, max_span + 2)\n    holes = list(random.choice(combos))\n    random.shuffle(holes)\n    colors = random.sample(LEGEND_COLORS, count)\n    return list(zip(holes, colors))\n\n\ndef _place_legend_line(\n    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n) -> None:\n    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n    rr, cc = int(r), int(c)\n    for hole_count, color in legends:\n        patch = _legend_patch(hole_count, color, arrangement)\n        paste(grid, patch, rr, cc)\n        if arrangement == \"horizontal\":\n            cc += patch.shape[1] + 1\n        else:\n            rr += patch.shape[0] + 1\n\n\n# ---------- layout helpers ----------\n\ndef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_h = random.randint(*PANEL_SIZE_RANGE)\n    top = random.choice([True, False])\n    c0 = random.randint(1, GRID_SIZE - 1 - total)\n    if top:\n        div_r = panel_h\n        grid[div_r, :] = DIV\n        blocked[: div_r + 1, :] = 9\n        r0 = random.randint(1, panel_h - 4)\n    else:\n        div_r = GRID_SIZE - 1 - panel_h\n        grid[div_r, :] = DIV\n        blocked[div_r:, :] = 9\n        r0 = random.randint(div_r + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"horizontal\", r0, c0)\n    return legends\n\n\ndef _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-column vertical divider with legend panel left or right.\"\"\"\n    legends = _choose_legends(\"vertical\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_w = random.randint(*PANEL_SIZE_RANGE)\n    left = random.choice([True, False])\n    r0 = random.randint(1, GRID_SIZE - 1 - total)\n    if left:\n        div_c = panel_w\n        grid[:, div_c] = DIV\n        blocked[:, : div_c + 1] = 9\n        c0 = random.randint(1, panel_w - 4)\n    else:\n        div_c = GRID_SIZE - 1 - panel_w\n        grid[:, div_c] = DIV\n        blocked[:, div_c:] = 9\n        c0 = random.randint(div_c + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"vertical\", r0, c0)\n    return legends\n\n\ndef _l_corner_geometry(corner: str, panel_h: int, panel_w: int,\n                       arrangement: str, total: int) -> tuple:\n    \"\"\"Compute divider pivot and legend placement bounds for an L-corner.\n\n    Returns (dr, dc, r_min, r_max, c_min, c_max) where (dr, dc) is the corner\n    pivot of the L-divider and the remaining values bound the legend origin.\n    \"\"\"\n    N = GRID_SIZE\n    cross_dim = 3 if arrangement == \"horizontal\" else total\n    along_dim = total if arrangement == \"horizontal\" else 3\n\n    if corner == \"tl\":\n        dr, dc = panel_h, panel_w\n","exit_code":0,"status":"completed"}}
