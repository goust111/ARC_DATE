{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c6141b15.py\"","aggregated_output":"from itertools import combinations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, random_sprite\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _sgn(x: int) -> int:\n    return (x > 0) - (x < 0)\n\n\ndef _straight_line_cells(a: Coord, b: Coord) -> set[Coord] | None:\n    r0, c0 = a\n    r1, c1 = b\n    dr = r1 - r0\n    dc = c1 - c0\n    if not (dr == 0 or dc == 0 or abs(dr) == abs(dc)):\n        return None\n    sr = _sgn(dr)\n    sc = _sgn(dc)\n    return {(r0 + i * sr, c0 + i * sc) for i in range(max(abs(dr), abs(dc)) + 1)}\n\n\ndef _segment_endpoints(coords: np.ndarray) -> tuple[Coord, Coord] | None:\n    cells = {tuple(map(int, rc)) for rc in coords}\n    if len(cells) < 2:\n        return None\n\n    endpoints: list[Coord] = []\n    for r, c in cells:\n        degree = sum(\n            (r + dr, c + dc) in cells\n            for dr in (-1, 0, 1)\n            for dc in (-1, 0, 1)\n            if (dr, dc) != (0, 0)\n        )\n        if degree == 1:\n            endpoints.append((r, c))\n        elif degree != 2:\n            return None\n\n    if len(endpoints) != 2:\n        return None\n    line = _straight_line_cells(endpoints[0], endpoints[1])\n    if line != cells:\n        return None\n    return endpoints[0], endpoints[1]\n\n\ndef _normalized_shape(coords: np.ndarray) -> frozenset[Coord]:\n    r0, c0, _r1, _c1 = bbox_coords(coords)\n    return frozenset((int(r - r0), int(c - c0)) for r, c in coords)\n\n\ndef _center_anchor(coords: np.ndarray) -> Coord | None:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    if (r0 + r1) % 2 or (c0 + c1) % 2:\n        return None\n    anchor = ((r0 + r1) // 2, (c0 + c1) // 2)\n    if anchor not in {tuple(map(int, rc)) for rc in coords}:\n        return None\n    return anchor\n\n\ndef _are_repeated_centered_sprites(components: list[np.ndarray]) -> bool:\n    if len(components) < 2:\n        return False\n    shapes = {_normalized_shape(coords) for coords in components}\n    return len(shapes) == 1 and all(_center_anchor(coords) is not None for coords in components)\n\n\ndef _non_collinear_three(points: list[Coord]) -> bool:\n    if len(points) != 3:\n        return True\n    (r0, c0), (r1, c1), (r2, c2) = points\n    return (r1 - r0) * (c2 - c0) != (r2 - r0) * (c1 - c0)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\n    Input structure\n    The grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\n    Rule\n    Build a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\n    Key insight\n    The original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2\n\n    components_by_color = {\n        color: [\n            component[\"coords\"]\n            for component in find_components(g, bg=bg, colors=[color], connectivity=8)\n        ]\n        for color in colors\n    }\n\n    connector_colors = [\n        color\n        for color, components in components_by_color.items()\n        if len(components) == 1 and _segment_endpoints(components[0]) is not None\n    ]\n    sprite_colors = [\n        color\n        for color, components in components_by_color.items()\n        if _are_repeated_centered_sprites(components)\n    ]\n    assert len(connector_colors) == 1\n    assert len(sprite_colors) == 1\n\n    connector_color = connector_colors[0]\n    sprite_color = sprite_colors[0]\n    assert connector_color != sprite_color\n\n    endpoint_pair = _segment_endpoints(components_by_color[connector_color][0])\n    assert endpoint_pair is not None\n\n    sprite_components = components_by_color[sprite_color]\n    anchors: list[Coord] = []\n    for coords in sprite_components:\n        anchor = _center_anchor(coords)\n        assert anchor is not None\n        anchors.append(anchor)\n    assert _non_collinear_three(anchors), \"three repeated sprites must form a non-collinear triangle\"\n\n    reference_anchor = _center_anchor(sprite_components[0])\n    assert reference_anchor is not None\n    sprite_offsets = [\n        (int(r - reference_anchor[0]), int(c - reference_anchor[1]))\n        for r, c in sprite_components[0]\n    ]\n\n    out = np.full_like(g, bg)\n    for a, b in combinations(anchors, 2):\n        assert _straight_line_cells(a, b) is not None\n        draw_line(out, a[0], a[1], end_r=b[0], end_c=b[1], color=connector_color)\n\n    height, width = out.shape\n    for endpoint_r, endpoint_c in endpoint_pair:\n        for dr, dc in sprite_offsets:\n            r = endpoint_r + dr\n            c = endpoint_c + dc\n            assert 0 <= r < height and 0 <= c < width\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and colors.\nGRID_SIZE_MIN = 11\nGRID_SIZE_MAX = 16\nBACKGROUND_COLOR = 7\nFOREGROUND_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Symmetric sprite shape.\nSPRITE_HEIGHT_CHOICES = [1, 3, 3, 5, 5]\nSPRITE_WIDTH_CHOICES = [1, 3, 3, 5]\nSPRITE_DIM_SWAP_PROB = 0.5\nSPRITE_QUADRANT_FILL_PROB = 0.5\nSPRITE_BUILD_RETRIES = 50\n\n# Anchor layout.\nTHREE_SPRITE_PROB = 0.85\nANCHOR_LAYOUT_RETRIES = 100\nANCHOR_DIRECTIONS = ['h', 'v', 'd1', 'd2']\nTWO_ANCHOR_DIST_MIN = 3\nTWO_ANCHOR_DIST_MAX = 8\nTRIANGLE_DELTA_MIN = 3\nTRIANGLE_DELTA_MAX = 7\nTRIANGLE_ROTATIONS = [0, 1, 2, 3]\n\n# Connector segment.\nSEGMENT_RETRIES = 100\nSEGMENT_LENGTH_MIN = 6\nSEGMENT_LENGTH_MAX = 10\n\n# Overall retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _gen2_symmetric_sprite(color):\n    \"\"\"Generate one connected LR+UD symmetric sprite with a filled center.\"\"\"\n    h = random.choice(SPRITE_HEIGHT_CHOICES)\n    w = random.choice(SPRITE_WIDTH_CHOICES)\n    if random.random() < SPRITE_DIM_SWAP_PROB:\n        h, w = w, h\n\n    if h == 1 and w == 1:\n        return np.array([[color]])\n\n    half_h = h // 2 + 1\n    half_w = w // 2 + 1\n    sprite = np.zeros((h, w), dtype=int)\n    cr, cc = h // 2, w // 2\n    sprite[cr, cc] = color\n\n    for r in range(half_h):\n        for c in range(half_w):\n            if random.random() < SPRITE_QUADRANT_FILL_PROB:\n                sprite[r, c] = color\n                sprite[r, w - 1 - c] = color\n                sprite[h - 1 - r, c] = color\n                sprite[h - 1 - r, w - 1 - c] = color\n\n    sprite[cr, cc] = color\n\n    from arc_utils import is_contiguous\n    mask = (sprite != 0)\n    if not mask.any():\n        sprite[cr, cc] = color\n        mask = (sprite != 0)\n    if not is_contiguous(mask, background=0, connectivity=8):\n        return None\n\n    if not np.any(sprite[0, :]) or not np.any(sprite[-1, :]):\n        return None\n    if not np.any(sprite[:, 0]) or not np.any(sprite[:, -1]):\n        return None\n\n    return sprite\n\n\ndef _gen_sprite_offsets(sprite):\n    h, w = sprite.shape\n    cr, cc = h // 2, w // 2\n    offsets = []\n    for r in range(h):\n        for c in range(w):\n            if sprite[r, c] != 0:\n                offsets.append((r - cr, c - cc))\n    return offsets\n\n\ndef _gen_sprite_cells_at(offsets, anchor_r, anchor_c):\n    return {(anchor_r + dr, anchor_c + dc) for dr, dc in offsets}\n\n\ndef _fits_in_grid(offsets, anchor_r, anchor_c, h, w):\n    for dr, dc in offsets:\n        r, c = anchor_r + dr, anchor_c + dc\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n    return True\n\n\ndef _choose_sprite(sprite_color):\n    for _ in range(SPRITE_BUILD_RETRIES):\n        sprite = _gen2_symmetric_sprite(sprite_color)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f1bcbc2c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\nfrom scipy.ndimage import binary_dilation\n\nimport random\n\nfrom arc_utils import (\n    Color,\n    STRUCT8,\n    colors_present,\n    components_mask,\n    get_bg,\n    in_bounds,\n    label_mask,\n    neighbors4,\n)\n\n\ndef _path_color(g: np.ndarray, bg: int) -> int:\n    candidates = []\n    for color in colors_present(g, exclude={bg}):\n        comps = components_mask(g == color, connectivity=4)\n        if len(comps) == 2:\n            candidates.append(int(color))\n\n    assert len(candidates) == 1, \"expected exactly one color forming two path components\"\n    return candidates[0]\n\n\ndef _adjacent_path_labels(labels: np.ndarray, r: int, c: int) -> set[int]:\n    adjacent = set()\n    for rr, cc in neighbors4(r, c):\n        if in_bounds(labels.shape, rr, cc) and labels[rr, cc] > 0:\n            adjacent.add(int(labels[rr, cc]))\n    return adjacent\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the top-connected middle channel between two orange path components teal.\n\n    Input structure\n    - The background is black.\n    - One foreground color forms exactly two 4-connected one-pixel-wide path components.\n    - Optional non-background control pixels may sit in the channel between the two paths.\n\n    Rule\n    - Dilate each path component by one cell in the 8-neighborhood and intersect the two dilations; this gives the one-cell-wide middle channel.\n    - A control pixel in that channel is a blocker only when its 4-neighbors touch fewer than both path components; otherwise it is part of the channel and is repainted.\n    - After removing blockers, paint the channel component connected to the top edge teal and keep all other pixels unchanged.\n\n    Key insight\n    - The desired pixels are not found by region filling; they are the geometric overlap of the two paths' one-cell halos, with weakly attached control pixels splitting the channel.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = get_bg(g)\n    assert bg == Color.BLACK, \"expected black background\"\n\n    path_color = _path_color(g, bg)\n    path_labels, n_paths = label_mask(g == path_color, connectivity=4)\n    assert n_paths == 2, \"expected two path components\"\n\n    channel = g != path_color\n    for label_id in range(1, n_paths + 1):\n        channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)\n    assert np.any(channel), \"expected a middle channel between the paths\"\n\n    blocked = []\n    for r_raw, c_raw in np.argwhere(channel & (g != bg)):\n        r = int(r_raw)\n        c = int(c_raw)\n        adjacent = _adjacent_path_labels(path_labels, r, c)\n        assert adjacent, \"control pixel in channel must touch a path component\"\n        if len(adjacent) < n_paths:\n            blocked.append((r, c))\n        else:\n            assert len(adjacent) == n_paths, \"channel control pixel cannot touch extra path labels\"\n\n    passable = channel.copy()\n    for r, c in blocked:\n        passable[r, c] = False\n\n    channel_labels, n_channels = label_mask(passable, connectivity=4)\n    assert n_channels >= 1, \"expected at least one passable channel component\"\n    top_components = [\n        label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)\n    ]\n    assert len(top_components) == 1, \"expected exactly one channel component connected to the top edge\"\n\n    paint = channel_labels == top_components[0]\n    assert np.any(paint), \"expected cells to paint\"\n    out = g.copy()\n    out[paint] = Color.TEAL\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and channel bounds.\nGEN_GRID_SHAPE = (10, 10)\nGEN_TOP_ROW = 0\nGEN_BOTTOM_ROW = 9\nGEN_LEFT_COL = 0\nGEN_RIGHT_COL = 9\nGEN_MIN_CHANNEL_COL = 1\nGEN_MAX_CHANNEL_COL = 8\n\n# Segment and turn sampling.\nGEN_MIN_TURNS = 2\nGEN_MAX_TURNS = 4\nGEN_VERTICAL_MIN = 2\nGEN_VERTICAL_MAX = 7\nGEN_VERTICAL_TOTAL_MIN = 6\nGEN_VERTICAL_TOTAL_MAX = 9\nGEN_FULL_HEIGHT_TOTAL = 9\nGEN_FULL_HEIGHT_PROB = 0.8\nGEN_HORIZONTAL_MIN = 2\nGEN_HORIZONTAL_MAX = 4\nGEN_HORIZONTAL_BUDGET = 7\n\n# Optional blocker placement.\nGEN_BLOCKER_PROB = 0.6\nGEN_BLOCKING_BLOCKER_PROB = 0.55\n\n# Retry budget for rejected geometry.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_walk_segment(path, dr, dc, steps):\n    r, c = path[-1]\n    for _ in range(steps):\n        r += dr\n        c += dc\n        path.append((r, c))\n\n\ndef _gen_directions(hdir, turns):\n    directions = [(1, 0)]\n    for i in range(turns):\n        directions.append((0, hdir) if i % 2 == 0 else (1, 0))\n    return directions\n\n\ndef _gen_partition_total(total, count, minimum, maximum):\n    \"\"\"Randomly split total into count bounded positive steps.\"\"\"\n    steps = []\n    remaining = total\n    for i in range(count - 1):\n        rest = count - i - 1\n        hi = min(maximum, remaining - minimum * rest)\n        lo = max(minimum, remaining - maximum * rest)\n        val = random.randint(lo, hi)\n        steps.append(val)\n        remaining -= val\n    steps.append(remaining)\n    return steps\n\n\ndef _gen_vertical_steps(directions):\n    v_count = sum(1 for d in directions if d == (1, 0))\n    if directions[-1] == (1, 0) and random.random() < GEN_FULL_HEIGHT_PROB:\n        total = GEN_FULL_HEIGHT_TOTAL\n    else:\n        total = random.randint(GEN_VERTICAL_TOTAL_MIN, GEN_VERTICAL_TOTAL_MAX)\n    return _gen_partition_total(total, v_count, GEN_VERTICAL_MIN, GEN_VERTICAL_MAX)\n\n\ndef _gen_horizontal_steps(h_count):\n    steps = []\n    remaining = GEN_HORIZONTAL_BUDGET\n    for i in range(h_count):\n        hi = min(GEN_HORIZONTAL_MAX, remaining - GEN_HORIZONTAL_MIN * (h_count - i - 1))\n        step = random.randint(GEN_HORIZONTAL_MIN, hi)\n        steps.append(step)\n        remaining -= step\n    return steps\n\n\ndef _gen_start_col(hdir, h_steps):\n    total_h = sum(h_steps)\n    if hdir == 1:\n        return random.randint(GEN_MIN_CHANNEL_COL, GEN_MAX_CHANNEL_COL - total_h)\n    return random.randint(GEN_MIN_CHANNEL_COL + total_h, GEN_MAX_CHANNEL_COL)\n\n\ndef _gen_channel_path():\n    hdir = random.choice([-1, 1])\n    turns = random.randint(GEN_MIN_TURNS, GEN_MAX_TURNS)\n    directions = _gen_directions(hdir, turns)\n    v_steps = _gen_vertical_steps(directions)\n    h_steps = _gen_horizontal_steps(sum(1 for d in directions if d[0] == 0))\n    start_c = _gen_start_col(hdir, h_steps)\n\n    path = [(GEN_TOP_ROW, start_c)]\n    vi = 0\n    hi = 0\n    for dr, dc in directions:\n        if dr:\n            steps = v_steps[vi]\n            vi += 1\n        else:\n            steps = h_steps[hi]\n            hi += 1\n        _gen_walk_segment(path, dr, dc, steps)\n\n    if any(\n        r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_MIN_CHANNEL_COL or c > GEN_MAX_CHANNEL_COL\n        for r, c in path\n    ):\n        return None\n    return path\n\n\ndef _gen_left_normal(dr, dc):\n    return -dc, dr\n\n\ndef _gen_wall_sets(path):\n    left = set()\n    right = set()\n    channel = set(path)\n    for i, (r, c) in enumerate(path):\n        dirs = []\n        if i > 0:\n            pr, pc = path[i - 1]\n            dirs.append((r - pr, c - pc))\n        if i + 1 < len(path):\n            nr, nc = path[i + 1]\n            dirs.append((nr - r, nc - c))\n        for dr, dc in dirs:\n            lr, lc = _gen_left_normal(dr, dc)\n            if (r + lr, c + lc) not in channel:\n                left.add((r + lr, c + lc))\n            if (r - lr, c - lc) not in channel:\n                right.add((r - lr, c - lc))\n        if len(dirs) == 2 and dirs[0] != dirs[1]:\n            for side in (1, -1):\n                offsets = []\n                for dr, dc in dirs:\n                    lr, lc = _gen_left_normal(dr, dc)\n                    offsets.append((side * lr, side * lc))\n                direct = [(r + dr, c + dc) for dr, dc in offsets]\n                if all(cell not in channel for cell in direct):\n                    er = r + offsets[0][0] + offsets[1][0]\n                    ec = c + offsets[0][1] + offsets[1][1]\n                    if side == 1:\n                        left.add((er, ec))\n                    else:\n                        right.add((er, ec))\n    return left, right\n\n\ndef _gen_mask_from_cells(cells):\n    mask = np.zeros(GEN_GRID_SHAPE, dtype=bool)\n    cells = list(cells)\n    if cells:\n        rows, cols = zip(*cells)\n        mask[rows, cols] = True\n    return mask\n","exit_code":0,"status":"completed"}}
