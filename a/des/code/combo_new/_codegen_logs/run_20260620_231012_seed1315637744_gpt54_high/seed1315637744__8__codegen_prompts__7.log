{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/def generate_input(/p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\ndef _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:\n    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n        # The contact edge doesn't have to span the full height. It's the N-2 contiguous\n        # cells on the attachment side. For \"left-attach\", the solver checks the RIGHT edge\n        # of the cropped sprite: exactly e contiguous filled cells.\n\n        # Build each row from right to left. Rightmost col is the contact column.\n        # For flipud symmetry, row[i] mirrors row[h-1-i].\n        # Decide top half, mirror to bottom.\n\n        for ri in range(half_h):\n            mirror_ri = h - 1 - ri\n            for ci in range(w):\n                if ci == w - 1:\n                    # Contact column: fill rows that form the contiguous e-block\n                    # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.\n                    # Instead: just decide freely and check later\n                    val = rng.random() < 0.5\n                else:\n                    val = rng.random() < 0.5\n                grid[ri, ci] = val\n                grid[mirror_ri, ci] = val\n\n        # Check: rightmost column has exactly e contiguous filled cells\n        right_col = grid[:, -1]\n        # Find contiguous runs\n        runs = []\n        count = 0\n        for v in right_col:\n            if v:\n                count += 1\n            else:\n                if count > 0:\n                    runs.append(count)\n                count = 0\n        if count > 0:\n            runs.append(count)\n        if len(runs) != 1 or runs[0] != e:\n            continue\n\n        # Trim empty rows/cols\n        rows_any = grid.any(axis=1)\n        cols_any = grid.any(axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        grid = grid[r0:r1+1, c0:c1+1]\n\n        if grid.shape[0] < 2 or grid.shape[1] < 2:\n            continue\n\n        # Check flipud symmetry\n        if not np.array_equal(grid, np.flipud(grid)):\n            continue\n\n        # Check 8-connectivity\n        labeled, num = _label(grid, structure=np.ones((3, 3), dtype=int))\n        if num != 1:\n            continue\n\n        # Must NOT be fliplr symmetric (to avoid the other side matching)\n        if np.array_equal(grid, np.fliplr(grid)):\n            continue\n\n        # Pixel count 4-12\n        px = int(grid.sum())\n        if px < 4 or px > 12:\n            continue\n\n        # Now verify exactly 1 valid attachment across all 4 rotations x 4 sides.\n        # The solver, for each side, tries rot90 x 0-3 and checks:\n        #   - correct symmetry (fliplr for top/bot, flipud for left/right)\n        #   - contact edge = e contiguous cells on the correct side\n        # We need exactly 1 such (rotation, side) pair across all possibilities.\n        # Actually, the solver matches by color, so each sprite is only tested against\n        # one side. But we need: for ANY side the solver might try, only 1 rotation works.\n        # Since the solver already picks the first valid rotation, we just need that\n        # for the intended side, exactly 1 rotation of the sprite is valid.\n\n        # Check: for the canonical \"left\" side, how many rotations are valid?\n        valid_for_left = 0\n        for k in range(4):\n            rot = np.rot90(grid, k)\n            # Trim\n            ra = rot.any(axis=1)\n            ca = rot.any(axis=0)\n            rr0, rr1 = np.where(ra)[0][[0, -1]]\n            cc0, cc1 = np.where(ca)[0][[0, -1]]\n            cr = rot[rr0:rr1+1, cc0:cc1+1]\n            # Left side needs flipud + right-edge = e contiguous\n            if not np.array_equal(cr, np.flipud(cr)):\n                continue\n            rc = cr[:, -1]\n            runs2 = []\n            cnt2 = 0\n            for v in rc:\n                if v: cnt2 += 1\n                else:\n                    if cnt2 > 0: runs2.append(cnt2)\n                    cnt2 = 0\n            if cnt2 > 0: runs2.append(cnt2)\n            if len(runs2) == 1 and runs2[0] == e:\n                valid_for_left += 1\n\n        if valid_for_left != 1:\n            continue\n\n        # Success! Now rotate to target side.\n        # grid is in \"left-attach\" frame (contact on right, flipud symmetric).\n        # left -> as-is\n        # right -> fliplr (contact moves to left side)\n        # top -> rot90 CW (contact moves to bottom)\n        # bot -> rot90 CCW (contact moves to top)\n        if side == \"left\":\n            mask = grid.copy()\n        elif side == \"right\":\n            mask = np.fliplr(grid)\n        elif side == \"top\":\n            mask = np.rot90(grid, -1)  # CW: right->bottom\n        else:  # bot\n            mask = np.rot90(grid, 1)   # CCW: right->top\n        return mask\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = random.Random()\n    bg = 8\n    N = 4\n    edge_len = N - 2  # = 2\n\n    H = rng.randint(18, 26)\n    W = rng.randint(20, 26)\n\n    # Choose 4 distinct non-bg colors for hub edges\n    all_colors = [c for c in range(10) if c != bg]\n    rng.shuffle(all_colors)\n    top_col, bot_col, left_col, right_col = all_colors[:4]\n\n    sides = [\"top\", \"bot\", \"left\", \"right\"]\n    side_colors = {\"top\": top_col, \"bot\": bot_col, \"left\": left_col, \"right\": right_col}\n\n    # Choose K sides (2-4) to get sprites\n    K = rng.randint(2, 4)\n    sprite_sides = rng.sample(sides, K)\n\n    # Generate sprite masks for each chosen side\n    sprite_masks = {}\n    for side in sprite_sides:\n        mask = _make_sprite_mask(edge_len, side, rng)\n        if mask is None:\n            return None\n        sprite_masks[side] = mask\n\n    # Compute max sprite extent to ensure enough margin for hub placement\n    max_sprite_h = max(m.shape[0] for m in sprite_masks.values())\n    max_sprite_w = max(m.shape[1] for m in sprite_masks.values())\n    max_extent = max(max_sprite_h, max_sprite_w)\n    margin = max_extent + 2\n\n    # Place hub near center with margin\n    hub_r_min = margin\n    hub_r_max = H - N - margin\n    hub_c_min = margin\n    hub_c_max = W - N - margin\n    if hub_r_min > hub_r_max or hub_c_min > hub_c_max:\n        return None\n\n    hub_r = rng.randint(hub_r_min, hub_r_max)\n    hub_c = rng.randint(hub_c_min, hub_c_max)\n\n    # Build output grid\n    out = np.full((H, W), bg, dtype=int)\n\n    # Place hub\n    # Top edge\n    for ci in range(1, N - 1):\n        out[hub_r, hub_c + ci] = top_col\n    # Bottom edge\n    for ci in range(1, N - 1):\n        out[hub_r + N - 1, hub_c + ci] = bot_col\n    # Left edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c] = left_col\n    # Right edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c + N - 1] = right_col\n\n    # Attach sprites to hub in output\n    attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords\n    for side in sprite_sides:\n        mask = sprite_masks[side]\n        sh, sw = mask.shape\n        color = side_colors[side]\n        arr = np.where(mask, color, bg).astype(int)\n\n        # Compute placement so sprite's contact edge is flush with hub side.\n        # The solver's segs dict defines: for each side, the contact position and span.\n        #   top -> sprite's bot row at hub_r-1, cols hub_c+1..hub_c+N-2\n        #   bot -> sprite's top row at hub_r+N, cols hub_c+1..hub_c+N-2\n        #   left -> sprite's right col at hub_c-1, rows hub_r+1..hub_r+N-2\n        #   right -> sprite's left col at hub_c+N, rows hub_r+1..hub_r+N-2\n        if side == \"top\":\n            # Find first filled col on bottom row of sprite\n            filled = np.where(mask[-1])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r - sh  # bottom row of sprite at row hub_r-1\n        elif side == \"bot\":\n            filled = np.where(mask[0])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r + N  # top row of sprite at row hub_r+N\n        elif side == \"left\":\n            filled = np.where(mask[:, -1])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c - sw  # right col of sprite at col hub_c-1\n        else:  # right\n            filled = np.where(mask[:, 0])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c + N  # left col of sprite at col hub_c+N\n\n        # Check bounds\n        if sr < 0 or sc < 0 or sr + sh > H or sc + sw > W:\n            return None\n\n        # Check no overlap with existing content\n        for r in range(sh):\n            for c in range(sw):\n                if mask[r, c] and out[sr + r, sc + c] != bg:\n                    return None\n\n        paste(out, arr, sr, sc, transparent=bg)\n        attached_sprites[side] = (arr, mask, sr, sc)\n\n    # Verify output is correct by running solver later (via oracle check)\n\n    # Build input: hub + scattered sprites in random rotations + optional distractor\n    inp = np.full((H, W), bg, dtype=int)\n    # Place hub on input\n    inp[hub_r:hub_r+N, hub_c:hub_c+N] = out[hub_r:hub_r+N, hub_c:hub_c+N]\n\n    # Canvas for placement tracking\n    canvas = inp.copy()\n\n    for side in sprite_sides:\n        arr, mask, sr, sc = attached_sprites[side]\n        # Apply a random non-identity rotation\n        # But we need to ensure the solver will find the right rotation\n        # The solver uses 8-connectivity labeling and picks the largest component of matching color\n        # Apply a random rotation (1-3 quarter turns, avoiding identity)\n        k = rng.choice([1, 2, 3])\n        rotated_arr = np.rot90(arr, k)\n        rotated_mask = np.rot90(mask, k)\n\n        # Crop to bounding box of the mask\n        rows_any = rotated_mask.any(axis=1)\n        cols_any = rotated_mask.any(axis=0)\n        r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]\n        c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]\n        cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        patch = np.where(cropped_mask, cropped_arr, bg).astype(int)\n\n        try:\n            pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(canvas, patch, pr, pc, transparent=bg)\n        paste(inp, patch, pr, pc, transparent=bg)\n\n    # Optionally add a distractor (0 or 1)\n    if rng.random() < 0.3:\n        used_colors = set(side_colors.values())\n        distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]\n        if distractor_colors:\n            dcol = rng.choice(distractor_colors)\n            # Make a small distractor sprite\n            dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)\n            if dist_mask is not None:\n                dist_arr = np.where(dist_mask, dcol, bg).astype(int)\n                try:\n                    pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)\n                    paste(canvas, dist_arr, pr, pc, transparent=bg)\n                    paste(inp, dist_arr, pr, pc, transparent=bg)\n                except ValueError:\n                    pass  # skip distractor if no room\n\n    # Oracle check\n    result = main(inp)\n    if not np.array_equal(result, out):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/def generate_input(/p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/def generate_input(/p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\n    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n    if stem[0] == 0:\n        return [(-1, 0), (1, 0)]\n    return [(0, -1), (0, 1)]\n\n\ndef _t_cells(center, stem):\n    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r, c), (r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_branch_cells(center, stem):\n    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n    r, c = center\n    bar = _get_bar(stem)\n    return {(r + stem[0], c + stem[1]),\n            (r + bar[0][0], c + bar[0][1]),\n            (r + bar[1][0], c + bar[1][1])}\n\n\ndef _t_neighborhood(center, stem):\n    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n    cells = _t_cells(center, stem)\n    neighborhood = set()\n    for r, c in cells:\n        for dr, dc in _DIRS:\n            nb = (r + dr, c + dc)\n            if nb not in cells:\n                neighborhood.add(nb)\n    return neighborhood\n\n\n# ── Region partitioning ────────────────────────────────────────────────\n\ndef _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:\n    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n    region = np.full((H, W), -1, dtype=int)\n    seeds = set()\n    for _ in range(SEED_ATTEMPTS):\n        if len(seeds) >= n_regions:\n            break\n        seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))\n    if len(seeds) < n_regions:\n        return None\n\n    frontier = []\n    for i, (r, c) in enumerate(list(seeds)):\n        region[r, c] = i\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, i))\n    random.shuffle(frontier)\n\n    while frontier:\n        idx = random.randint(0, len(frontier) - 1)\n        r, c, rid = frontier[idx]\n        frontier[idx] = frontier[-1]\n        frontier.pop()\n        if region[r, c] != -1:\n            continue\n        region[r, c] = rid\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:\n                frontier.append((nr, nc, rid))\n\n    # Validate: each region must be 4-connected and have enough cells\n    for rid in range(n_regions):\n        mask = region == rid\n        if mask.sum() < MIN_REGION_CELLS:\n            return None\n        _, n = label_mask(mask, connectivity=4)\n        if n != 1:\n            return None\n    return region\n\n\n# ── Adjacency discovery ───────────────────────────────────────────────\n\ndef _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n    H, W = region.shape\n    # Detect boundaries via horizontal and vertical neighbor differences\n    undirected = set()\n    for r in range(H):\n        for c in range(W):\n            for dr, dc in _DIRS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    a, b = int(region[r, c]), int(region[nr, nc])\n                    if a != b:\n                        undirected.add((min(a, b), max(a, b)))\n    directed = []\n    for a, b in undirected:\n        directed.append((a, b))\n        directed.append((b, a))\n    return directed\n\n\n# ── Marker count selection ─────────────────────────────────────────────\n\ndef _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:\n    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n    max_possible = min(MARKER_MAX, n_regions)\n    if max_possible < MARKER_MIN:\n        return None\n    n_markers = random.randint(MARKER_MIN, max_possible)\n    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))\n    n_normal = n_markers - n_colored\n    if n_normal > NORMAL_MAX:\n        n_colored = n_markers - NORMAL_MAX\n        n_normal = NORMAL_MAX\n        if n_colored > COLORED_MAX:\n            n_markers = NORMAL_MAX + COLORED_MAX\n            n_colored = COLORED_MAX\n            n_normal = NORMAL_MAX\n    return n_markers, n_normal, n_colored\n\n\n# ── Marker placement search ───────────────────────────────────────────\n\ndef _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):\n    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n    candidates = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            for stem in _DIRS:\n                bar = _get_bar(stem)\n                cells = _t_cells((r, c), stem)\n                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                    continue\n                if cells & occupied_cells:\n                    continue\n                if _t_neighborhood((r, c), stem) & occupied_cells:\n                    continue\n                if cells & occupied_neighbors:\n                    continue\n                # Diagonal cells (stem + each bar dir) must lie in source region\n                if not all(\n                    0 <= r + stem[0] + bd[0] < H and\n                    0 <= c + stem[1] + bd[1] < W and\n                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src\n                    for bd in bar\n                ):\n                    continue\n                # Walk along stem from step=2 until we hit dst or leave bounds\n                step = 2\n                found = False\n                while True:\n                    nr, nc = r + stem[0] * step, c + stem[1] * step\n                    if not (0 <= nr < H and 0 <= nc < W):\n                        break\n                    if (nr, nc) in occupied_cells or (nr, nc) in cells:\n                        step += 1\n                        continue\n                    found = int(region[nr, nc]) == dst\n                    break\n                if found:\n                    candidates.append(((r, c), stem))\n    return candidates\n\n\ndef _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):\n    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n    cells = _t_cells(center, stem)\n    if kind == 'normal':\n        occupied_cells |= cells\n        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)\n    else:\n        branch = _t_branch_cells(center, stem)\n        occupied_cells |= branch\n        occupied_cells.add(center)\n        # Each branch cell must remain a singleton: buffer all non-marker neighbors\n        for br, bc in branch:\n            for dr, dc in _DIRS:\n                nb = (br + dr, bc + dc)\n                if nb != center and nb not in branch:\n                    occupied_neighbors.add(nb)\n        for dr, dc in _DIRS:\n            nb = (center[0] + dr, center[1] + dc)\n            if nb not in branch:\n                occupied_neighbors.add(nb)\n\n\n# ── Grid construction ─────────────────────────────────────────────────\n\ndef _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:\n    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n    lut = np.array(colors, dtype=int)\n    return lut[region]\n\n\ndef _stamp_markers_input(grid, placed_markers):\n    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n    for kind, center, stem, _src, _dst, tc in placed_markers:\n        if kind == 'normal':\n            for cr, cc in _t_cells(center, stem):\n                grid[cr, cc] = 1\n        else:\n            grid[center[0], center[1]] = tc\n            for cr, cc in _t_branch_cells(center, stem):\n                grid[cr, cc] = 1\n\n\ndef _stamp_markers_output(grid, placed_markers, out_colors):\n    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n    for kind, center, stem, src, _dst, _tc in placed_markers:\n        color = out_colors[src]\n        for cr, cc in _t_cells(center, stem):\n            grid[cr, cc] = color\n\n\n# ── L9 rotation marker ────────────────────────────────────────────────\n\ndef _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):\n    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n    if random.random() >= L9_PROBABILITY:\n        return None\n    orient = random.choice(list(L9_OFFSETS))\n    offsets = L9_OFFSETS[orient]\n    H, W = region.shape\n\n    all_marker_cells = set()\n    for kind, center, stem, *_ in placed_markers:\n        all_marker_cells |= _t_cells(center, stem)\n\n    candidates = []\n    for r in range(H):\n        for c in range(W):\n            cells = [(r + dr, c + dc) for dr, dc in offsets]\n            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):\n                continue\n            rid = int(region[r, c])\n            if not all(int(region[cr, cc]) == rid for cr, cc in cells):\n                continue\n            if any((cr, cc) in all_marker_cells for cr, cc in cells):\n                continue\n            if any((cr, cc) in occupied_neighbors for cr, cc in cells):\n                continue\n            candidates.append((r, c, rid))\n\n    if not candidates:\n        return None\n    lr, lc, rid = random.choice(candidates)\n    for dr, dc in offsets:\n        input_grid[lr + dr, lc + dc] = 9\n        output_grid[lr + dr, lc + dc] = out_colors[rid]\n    return orient\n\n\n# ── Main generation attempt ───────────────────────────────────────────\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]\n    min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))\n    H = random.randint(min_size, GRID_SIZE_MAX)\n    W = random.randint(min_size, GRID_SIZE_MAX)\n\n    region = _grow_regions(H, W, n_regions)\n    if region is None:\n        return None\n\n    directed_pairs = _find_adjacent_pairs(region)\n\n    counts = _choose_marker_counts(n_regions)\n    if counts is None:\n        return None\n    n_markers, n_normal, n_colored = counts\n\n    # Select src->dst pairs with unique destinations\n    random.shuffle(directed_pairs)\n    dest_used = set()\n    marker_pairs = []\n    for src, dst in directed_pairs:\n        if dst not in dest_used:\n            marker_pairs.append((src, dst))\n            dest_used.add(dst)\n            if len(marker_pairs) >= n_markers:\n                break\n    if len(marker_pairs) < n_markers:\n        n_markers = len(marker_pairs)\n        if n_markers < MARKER_MIN:\n            return None\n        n_colored = min(n_colored, n_markers - 1)\n        n_normal = n_markers - n_colored\n    random.shuffle(marker_pairs)\n\n    # Assign input colors\n    pool = list(COLOR_POOL)\n    random.shuffle(pool)\n    if n_regions > len(pool):\n        return None\n    input_colors = pool[:n_regions]\n\n    # Compute output colors from recoloring rules\n    out_colors = list(input_colors)\n    normal_pairs = marker_pairs[:n_normal]\n    colored_pairs = marker_pairs[n_normal:]\n\n    colored_targets = []\n    for _src, dst in colored_pairs:\n        cands = [c for c in pool if c != input_colors[dst]]\n        if not cands:\n            return None\n        colored_targets.append(random.choice(cands))\n\n    for src, dst in normal_pairs:\n        out_colors[dst] = input_colors[src]\n    for (src, dst), tc in zip(colored_pairs, colored_targets):\n        out_colors[dst] = tc\n\n    # Build marker definitions and place them\n    all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \\\n               [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]\n    random.shuffle(all_defs)\n\n    occupied_cells: set[tuple[int, int]] = set()\n    occupied_neighbors: set[tuple[int, int]] = set()\n    placed_markers = []\n    for kind, src, dst, tc in all_defs:\n        cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)\n        if not cands:\n            return None\n        center, stem = random.choice(cands)\n        _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)\n        placed_markers.append((kind, center, stem, src, dst, tc))\n\n    # Build grids via vectorized lookup\n    input_grid = _build_color_map(region, input_colors)\n    output_grid = _build_color_map(region, out_colors)\n\n    _stamp_markers_input(input_grid, placed_markers)\n    _stamp_markers_output(output_grid, placed_markers, out_colors)\n\n    # Optional L9 rotation marker\n    l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,\n                              input_grid, output_grid, out_colors)\n    if l9_orient == 'top_right':\n        output_grid = np.rot90(output_grid, 1)\n    elif l9_orient == 'top_left':\n        output_grid = np.rot90(output_grid, 3)\n\n    try:\n        result = main(input_grid)\n    except Exception:\n        return None\n    return input_grid if np.array_equal(result, output_grid) else None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/def generate_input(/p' /home/lixinyu/snap/new/ARC_code/eval/6ffbe589.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/def generate_input(/p' /home/lixinyu/snap/new/ARC_code/eval/6ffbe589.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Crop a board cluster and rotate its color layers based on outside cue sprites.\n\n    Input structure:\n    - bg = most common color.\n    - A main multi-color board cluster (largest foreground region).\n    - Small monochrome cue sprites outside the board for the colors that rotate.\n\n    Rule:\n    - Tight-crop around the board cluster.\n    - For each color layer inside the crop, find its same-color cue outside.\n    - Rotate that layer clockwise by (cue pixel count mod 4) × 90°.\n    - No outside cue → no rotation.\n\n    Key insight: Cue sprite size mod 4 encodes rotation amount for its matching color layer.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Crop the \"board\" cluster (drop distant sample sprites) ---\n    crop, (r0, c0, r1, c1), bg = crop_components_near_largest(g, bg=bg, margin=3, connectivity=8)\n\n    # --- STEP 2) For each layer, rotate according to its unique outside cue size ---\n    colors = colors_present(crop, exclude={int(bg)})\n    assert colors, \"expected the cropped board to contain foreground colors\"\n    out = crop.copy()\n\n    outside_grid = g.copy()\n    outside_grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = int(bg)\n\n    for col in colors:\n        outside_comps = find_components(\n            outside_grid,\n            bg=int(bg),\n            connectivity=8,\n            monochromatic=True,\n            colors=[int(col)],\n            return_format=\"dict\",\n        )\n        assert len(outside_comps) <= 1, f\"expected at most one outside cue for color {col}\"\n        cue_size = int(outside_comps[0][\"area\"]) if outside_comps else 0\n        rot_k = (-cue_size) % 4\n        if rot_k:\n            out = rotate_color_layer(out, int(col), int(rot_k), bg=int(bg))\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# ---- Configuration constants ----\nCANVAS_SIZE = 20                  # overall grid dimensions\nBOARD_N_MIN, BOARD_N_MAX = 10, 13  # board side length range (inclusive)\nNUM_COLORS = 3                    # number of distinct non-bg colors (frame, mid, inner)\n\nOUTER_DENSITY_LO = 0.17          # outer layer min density fraction\nOUTER_DENSITY_HI = 0.32          # outer layer max density fraction\nMID_DENSITY_LO = 0.30            # middle layer min density fraction\nMID_DENSITY_HI = 0.50            # middle layer max density fraction\nMID_OUTER_CAP = 0.32             # middle layer upper cap as fraction of n^2\n\nLAYER_BAND_WIDTH = 2             # how many border rows/cols to fill from\nMIDDLE_INSET = 2                 # offset of middle layer within board\nASYM_MARKER = (1, 2)             # cell used to break rotational symmetry\nINNER_SPAN_MARGIN = 8            # inner span = n - this value (max)\n\nCUE_GRID = 3                     # cue blob growth grid size\nCUE_BOARD_DIST = 4               # min Chebyshev distance from cue bbox to board bbox\nCUE_INTER_DIST = 4               # min Chebyshev distance between cue bboxes\nOUTER_AREA_PAD = 4               # outer min_area = mid_area + this\n\nGEN_RETRIES = 300                 # max attempts in generate_input()\n\n\ndef _rot_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:\n    \"\"\"Return the 4 positions in the 90-degree rotation orbit of (r, c) in an n*n grid.\"\"\"\n    pts = set()\n    rr, cc = r, c\n    for _ in range(4):\n        pts.add((rr, cc))\n        rr, cc = n - 1 - cc, rr\n    return pts\n\n\ndef _is_rot_asym(mask: np.ndarray) -> bool:\n    \"\"\"True if mask is not invariant under any 90/180/270 rotation.\"\"\"\n    return all(not np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3))\n\n\ndef _checker_perimeter(n: int, phase: int) -> np.ndarray:\n    \"\"\"Checkerboard pattern restricted to the perimeter of an n*n grid.\"\"\"\n    rr, cc = np.indices((n, n))\n    perim = (rr == 0) | (rr == n - 1) | (cc == 0) | (cc == n - 1)\n    return perim & (((rr + cc + phase) % 2) == 0)\n\n\ndef _band_cells(n: int, width: int) -> list[tuple[int, int]]:\n    \"\"\"All (r, c) within `width` rows/cols of any edge in an n*n grid.\"\"\"\n    rr, cc = np.indices((n, n))\n    inside = np.minimum(np.minimum(rr, cc), np.minimum(n - 1 - rr, n - 1 - cc)) < width\n    coords = np.argwhere(inside)\n    return [(int(r), int(c)) for r, c in coords]\n\n\ndef _fill_to_count(mask: np.ndarray, candidates: list[tuple[int, int]], target: int) -> bool:\n    \"\"\"Randomly set cells in mask until it reaches target count. Returns success.\"\"\"\n    random.shuffle(candidates)\n    for r, c in candidates:\n        if mask.sum() >= target:\n            return True\n        mask[r, c] = True\n    return mask.sum() >= target\n\n\ndef _make_asym_layer(n: int, density_lo: float, density_hi: float,\n                     extra_lo_terms: list[int] = ()) -> np.ndarray | None:\n    \"\"\"Build an n*n boolean mask with checker-perimeter base, asymmetry marker, and random fill.\n\n    Returns None if density bounds are infeasible or the result is rotationally symmetric.\n    extra_lo_terms: additional lower-bound values (e.g. min_area for outer layer).\n    \"\"\"\n    mask = _checker_perimeter(n, random.randrange(2))\n\n    orbit = _rot_orbit(*ASYM_MARKER, n)\n    for p in orbit - {ASYM_MARKER}:\n        mask[p] = False\n    mask[ASYM_MARKER] = True\n\n    lo = max(int(np.ceil(density_lo * n * n)), int(mask.sum()), *extra_lo_terms)\n    hi = int(np.floor(density_hi * n * n))\n    if lo > hi:\n        return None\n    target = random.randint(lo, hi)\n\n    blocked = orbit - {ASYM_MARKER}\n    candidates = [(r, c) for r, c in _band_cells(n, LAYER_BAND_WIDTH)\n                  if (r, c) not in blocked and not mask[r, c]]\n    if not _fill_to_count(mask, candidates, target):\n        return None\n    if not _is_rot_asym(mask):\n        return None\n    return mask\n\n\ndef _make_middle_mask(n: int) -> np.ndarray | None:\n    \"\"\"Build the middle concentric layer, inset by MIDDLE_INSET from each edge.\"\"\"\n    m = n - 2 * MIDDLE_INSET\n    hi_cap = int(np.floor(MID_OUTER_CAP * n * n)) - 5\n    local = _make_asym_layer(m, MID_DENSITY_LO, min(MID_DENSITY_HI, hi_cap / (m * m)))\n    if local is None:\n        return None\n    mask = np.zeros((n, n), dtype=bool)\n    mask[MIDDLE_INSET:MIDDLE_INSET + m, MIDDLE_INSET:MIDDLE_INSET + m] = local\n    if not _is_rot_asym(mask):\n        return None\n    return mask\n\n\ndef _make_outer_mask(n: int, min_area: int) -> np.ndarray | None:\n    \"\"\"Build the outer frame layer spanning the full n*n grid.\"\"\"\n    return _make_asym_layer(n, OUTER_DENSITY_LO, OUTER_DENSITY_HI,\n                            extra_lo_terms=[min_area])\n\n\ndef _valid_inner_spans(n: int, require_asym: bool) -> list[int]:\n    \"\"\"Return valid inner-sprite span sizes for a board of side n.\"\"\"\n    max_span = n - INNER_SPAN_MARGIN\n    spans = [s for s in range(1, max_span + 1) if (s % 2) == (n % 2)]\n    if require_asym:\n        spans = [s for s in spans if s > 1]\n    return spans\n\n\ndef _make_inner_mask(n: int, *, require_asym: bool) -> np.ndarray:\n    \"\"\"Build the small central sprite layer.\"\"\"\n    mask = np.zeros((n, n), dtype=bool)\n    span = random.choice(_valid_inner_spans(n, require_asym))\n    top = (n - span) // 2\n\n    if span == 1:\n        local = np.ones((1, 1), dtype=bool)\n    elif span == 2:\n        local = np.ones((2, 2), dtype=bool)\n        local[random.randrange(2), random.randrange(2)] = False\n    elif span == 3:\n        variants = [\n            np.array([[1, 0, 0], [0, 1, 0], [1, 0, 1]], dtype=bool),\n            np.array([[0, 1, 1], [0, 1, 0], [1, 0, 0]], dtype=bool),\n            np.array([[1, 0, 1], [0, 1, 0], [0, 0, 1]], dtype=bool),\n        ]\n        local = random.choice(variants)\n        local = np.rot90(local, random.randrange(4))\n    else:\n        local = np.zeros((span, span), dtype=bool)\n        if span == 4:\n            pts = [(0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (2, 2), (2, 3), (3, 2)]\n        else:\n            pts = [(0, 2), (1, 1), (1, 2), (1, 3), (2, 0), (2, 1), (2, 2), (2, 3), (3, 3), (4, 4)]\n        for r, c in pts:\n            local[r, c] = True\n        if random.randrange(2):\n            local = np.fliplr(local)\n        local = np.rot90(local, random.randrange(4))\n    mask[top:top + local.shape[0], top:top + local.shape[1]] = local\n    return mask\n\n\ndef _pick_rotations() -> list[int]:\n    \"\"\"Pick rotation amounts for 3 color layers; at least one must be non-zero.\"\"\"\n    rot_ks = [random.randrange(4) for _ in range(3)]\n    if not any(rot_ks):\n        rot_ks[random.randrange(3)] = random.randint(1, 3)\n    return rot_ks\n\n\ndef _cue_patch(color: int, area: int) -> np.ndarray:\n    \"\"\"Grow an 8-connected monochromatic blob of given area in a CUE_GRID*CUE_GRID workspace, then crop.\"\"\"\n    center = CUE_GRID // 2\n    coords = {(center, center)}\n    while len(coords) < area:\n        frontier = set()\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < CUE_GRID and 0 <= nc < CUE_GRID and (nr, nc) not in coords:\n                        frontier.add((nr, nc))\n        coords.add(random.choice(sorted(frontier)))\n\n    arr = np.zeros((CUE_GRID, CUE_GRID), dtype=int)\n    for r, c in coords:\n        arr[r, c] = color\n    pos = np.argwhere(arr != 0)\n    r0, c0 = pos.min(axis=0)\n    r1, c1 = pos.max(axis=0)\n    return arr[r0:r1 + 1, c0:c1 + 1]\n\n\ndef _bbox_chebyshev(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:\n    \"\"\"Chebyshev (L-inf) gap distance between two axis-aligned bounding boxes.\"\"\"\n    ar0, ac0, ar1, ac1 = a\n    br0, bc0, br1, bc1 = b\n    dr = max(0, br0 - ar1) if ar1 < br0 else max(0, ar0 - br1)\n    dc = max(0, bc0 - ac1) if ac1 < bc0 else max(0, ac0 - bc1)\n    return max(dr, dc)\n\n\ndef _place_cue(canvas: np.ndarray, patch: np.ndarray,\n               board_bbox: tuple[int, int, int, int],\n               cue_bboxes: list[tuple[int, int, int, int]]) -> bool:\n    \"\"\"Place a cue patch on the canvas, respecting distance constraints. Returns success.\"\"\"\n    h, w = patch.shape\n    mask = patch != 0\n    candidates = []\n    for r in range(CANVAS_SIZE - h + 1):\n        for c in range(CANVAS_SIZE - w + 1):\n            if np.any((canvas[r:r + h, c:c + w] != 0) & mask):\n                continue\n            bb = (r, c, r + h - 1, c + w - 1)\n            if _bbox_chebyshev(bb, board_bbox) < CUE_BOARD_DIST:\n                continue\n            if any(_bbox_chebyshev(bb, prev) < CUE_INTER_DIST for prev in cue_bboxes):\n                continue\n            candidates.append((r, c, bb))\n    if not candidates:\n        return False\n    r, c, bb = random.choice(candidates)\n    paste(canvas, patch, r, c, transparent=0)\n    cue_bboxes.append(bb)\n    return True\n\n\ndef _board_anchor(n: int) -> tuple[int, int]:\n    \"\"\"Pick a random board top-left position, flush against one edge of the canvas.\"\"\"\n    spare = CANVAS_SIZE - n\n    side = random.randrange(4)\n    if side == 0:\n        return spare, random.randint(0, spare)\n    if side == 1:\n        return 0, random.randint(0, spare)\n    if side == 2:\n        return random.randint(0, spare), spare\n    return random.randint(0, spare), 0\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid. Returns None on failure.\"\"\"\n    colors = random.sample(range(1, 10), NUM_COLORS)\n    c_frame, c_mid, c_inner = colors\n    rot_ks = _pick_rotations()\n\n    valid_ns = [n for n in range(BOARD_N_MIN, BOARD_N_MAX + 1)\n                if _valid_inner_spans(n, rot_ks[2] > 0)]\n    n = random.choice(valid_ns)\n\n    # Build concentric layer masks\n    mid_mask = _make_middle_mask(n)\n    if mid_mask is None:\n        return None\n    inner_mask = _make_inner_mask(n, require_asym=rot_ks[2] > 0)\n    if rot_ks[2] > 0 and not _is_rot_asym(inner_mask):\n        return None\n    outer_mask = _make_outer_mask(n, int(mid_mask.sum()) + OUTER_AREA_PAD)\n    if outer_mask is None:\n        return None\n\n    if np.any(outer_mask & mid_mask) or np.any(outer_mask & inner_mask) or np.any(mid_mask & inner_mask):\n        return None\n\n    # Compose output board and invert rotations for input board\n    out_board = np.zeros((n, n), dtype=int)\n    out_board[outer_mask] = c_frame\n    out_board[mid_mask] = c_mid\n    out_board[inner_mask] = c_inner\n\n    in_board = np.zeros((n, n), dtype=int)\n    for col, k in zip(colors, rot_ks):\n        inv = np.rot90(out_board == col, (-k) % 4)\n        if np.any((in_board != 0) & inv):\n            return None\n        in_board[inv] = col\n\n    # Place board and cue sprites on canvas\n    r0, c0 = _board_anchor(n)\n    canvas = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=int)\n    paste(canvas, in_board, r0, c0, transparent=0)\n    board_bbox = (r0, c0, r0 + n - 1, c0 + n - 1)\n\n    cue_bboxes: list[tuple[int, int, int, int]] = []\n    cue_items = [(col, random.choice([1, 5]) if (-k) % 4 == 1 else (-k) % 4)\n                 for col, k in zip(colors, rot_ks) if k != 0]\n    random.shuffle(cue_items)\n    for col, area in cue_items:\n        if not _place_cue(canvas, _cue_patch(col, area), board_bbox, cue_bboxes):\n            return None\n\n    # Validate: board is unique largest component and oracle check passes\n    comps = find_components(canvas, bg=0, connectivity=8, monochromatic=False, return_format=\"dict\")\n    areas = [int(comp[\"area\"]) for comp in comps]\n    if areas.count(max(areas)) != 1:\n        return None\n    largest = comps[areas.index(max(areas))]\n    if tuple(map(int, largest[\"bbox\"])) != board_bbox:\n        return None\n    for bb in cue_bboxes:\n        if _bbox_chebyshev(bb, board_bbox) < CUE_BOARD_DIST:\n            return None\n\n    if not np.array_equal(main(canvas), out_board):\n        return None\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
