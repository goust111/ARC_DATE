        if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n-- end snippet --\n-- snippet 582 --\n 579:     return bool(np.array_equal(main(inp), out))\n 580: \n 581: \n 582: def generate_input() -> np.ndarray:\n 583:     for _ in range(_GEN_RETRY_LIMIT):\n 584:         grid = _gen_attempt()\n 585:         if grid is not None:\n 586:             return grid\n 587:     raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n-- end snippet --\nFILE /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\n-- snippet 119 --\n 116:     return ordered\n 117: \n 118: \n 119: def main(grid: np.ndarray) -> np.ndarray:\n 120:     \"\"\"\n 121:     Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n 122: \n 123:     Input structure:\n 124:     - Black background with several axis-aligned colored line drawings.\n 125:     - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n 126:     - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n 127: \n 128:     Rule:\n 129:     - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n 130:     - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n 131:     - The color with no enclosed region is the noise/pad color.\n 132:     - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n 133: \n 134:     Key insight:\n 135:     - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n 136:     \"\"\"\n 137:     g = np.asarray(grid, dtype=int)\n 138:     bg = int(get_bg(g))\n 139:     assert bg == 0\n 140: \n 141:     counts: list[tuple[int, int, np.ndarray]] = []\n 142:     for color in colors_present(g, exclude={bg}):\n 143:         rooms = _room_count_for_color(g, int(color))\n 144:         walls = _walls_for_color(g, int(color))\n 145:         counts.append((int(color), int(rooms), walls))\n 146: \n 147:     drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n 148:     pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n 149:     assert drawings\n 150:     assert len(pad_colors) == 1\n 151: \n 152:     pad = int(pad_colors[0])\n 153:     ordered: list[tuple[int, int, np.ndarray]] = []\n 154:     for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n 155:         group = [item for item in drawings if item[1] == rooms]\n 156:         ordered.extend(_cover_order(g, group))\n 157: \n 158:     width = max(rooms for _color, rooms, _walls in ordered)\n 159: \n 160:     out = np.full((len(ordered), width), pad, dtype=int)\n 161:     for r, (color, rooms, _walls) in enumerate(ordered):\n 162:         out[r, :rooms] = int(color)\n 163:     return out\n 164: \n 165: # --------------- generator (claude-opus-4-6) ---------------\n 166: \n 167: # ---- CFG: Tunable generation parameters ----\n 168: _FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n 169: _ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n 170: _TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n 171: _GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n 172:     5: (25, 30, 25, 30, 16, 18),\n 173:     4: (22, 30, 22, 30, 18, 22),\n 174:     3: (20, 30, 20, 30, 22, 25),\n 175: }\n 176: _CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n 177: _NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n 178: _WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n 179: _EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n 180: _OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n 181: _GEN_RETRIES = 300                   # outer retry limit\n 182: \n 183: \n 184: def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n 185:     \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n 186:     if n * min_gap > max_total:\n 187:         return None\n 188:     gaps = [min_gap] * n\n 189:     remaining = max_total - sum(gaps)\n 190:     for i in range(n):\n 191:         extra = min(max_gap - gaps[i], remaining)\n 192:         if extra > 0:\n 193:             add = random.randint(0, extra)\n 194:             gaps[i] += add\n 195:             remaining -= add\n 196:     random.shuffle(gaps)\n 197:     return gaps\n 198: \n 199: \n-- end snippet --\n-- snippet 475 --\n 472:     return grid if np.array_equal(output, expected) else None\n 473: \n 474: \n 475: def generate_input() -> np.ndarray:\n 476:     for _ in range(_GEN_RETRIES):\n 477:         result = _gen_attempt()\n 478:         if result is not None:\n 479:             return result\n 480:     raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n-- end snippet --\nFILE /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\n-- snippet 228 --\n 225:     return deg\n 226: \n 227: \n 228: def main(grid: np.ndarray) -> np.ndarray:\n 229:     \"\"\"\n 230:     Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n 231: \n 232:     Input structure:\n 233:     - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n 234: \n 235:     Rule:\n 236:     - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n 237:     - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n 238:     - Total painted pixels equal the original segment length.\n 239: \n 240:     Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n 241:     \"\"\"\n 242:     g = np.asarray(grid, dtype=int)\n 243:     h, w = g.shape\n 244:     bg = get_bg(g)\n 245: \n 246:     colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n 247: \n 248:     out = g.copy()\n 249: \n 250:     def bar_candidates():\n 251:         # Yield (bar_color, bar_component, terminal_endpoint).\n 252:         for col in colors:\n 253:             for comp in _components(g, col, conn8=False):\n 254:                 if len(comp) < 2 or not _is_straight_line(comp):\n 255:                     continue\n 256:                 e0, e1 = _bar_endpoints(comp)\n 257:                 touch0 = _touches_border(e0, h, w)\n 258:                 touch1 = _touches_border(e1, h, w)\n 259:                 if touch0 == touch1:\n 260:                     continue  # require exactly one endpoint on border\n 261:                 # Orientation must be perpendicular to the edge it touches.\n 262:                 rs = [r for r, _ in comp]\n 263:                 cs = [c for _, c in comp]\n 264:                 vertical = len(set(cs)) == 1\n 265:                 border_ep = e0 if touch0 else e1\n 266:                 if vertical:\n 267:                     if border_ep[0] not in (0, h - 1):\n 268:                         continue\n 269:                 else:\n 270:                     if border_ep[1] not in (0, w - 1):\n 271:                         continue\n 272:                 terminal_ep = e1 if touch0 else e0\n 273:                 # Must have an attached non-bg neighbor at terminal.\n 274:                 tr, tc = terminal_ep\n 275:                 if not any(\n 276:                     0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col\n 277:                     for nr, nc in neighbors4(tr, tc)\n 278:                 ):\n 279:                     continue\n 280:                 yield col, comp, terminal_ep\n 281: \n 282:     # Process all valid bars; compute moves based on the original grid.\n 283:     moves = []  # list of (seg_comp_pts, seg_color, new_pts)\n 284:     for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):\n 285:         # Segment neighbor candidates at terminal.\n 286:         neigh = []\n 287:         for nr, nc in neighbors4(terminal[0], terminal[1]):\n 288:       