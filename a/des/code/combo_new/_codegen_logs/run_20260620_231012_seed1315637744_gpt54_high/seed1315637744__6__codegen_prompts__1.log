{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\n\ndef comps(mask):\n    H,W=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(H):\n        for c in range(W):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)]);seen[r,c]=1;pts=[]\n            while q:\n                x,y=q.popleft();pts.append((x,y))\n                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:\n                        seen[nx,ny]=1;q.append((nx,ny))\n            out.append(pts)\n    return out\n\ndef degs(mask):\n    H,W=mask.shape\n    bad=[]\n    for r,c in np.argwhere(mask):\n        d=0\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W and mask[rr,cc]:\n                d+=1\n        bad.append(d)\n    return sorted(set(bad))\n\nshape=np.zeros((15,15),bool)\nshape[5:10,4:10]=1\nshape[3:5,6:8]=1\nshape[7:10,10:12]=1\n# shell by chebyshev-1 dilation minus shape\nH,W=shape.shape\ndil=np.zeros_like(shape)\nfor r,c in np.argwhere(shape):\n    for dr in (-1,0,1):\n        for dc in (-1,0,1):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W:\n                dil[rr,cc]=1\nwall=dil & ~shape\nprint('shape comps',len(comps(shape)),'wall comps',len(comps(wall)),'wall degs',degs(wall))\n# show ascii\nfor r in range(H):\n    s=''\n    for c in range(W):\n        if shape[r,c]:s+='I'\n        elif wall[r,c]:s+='#'\n        else:s+='.'\n    print(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\n\ndef comps(mask):\n    H,W=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(H):\n        for c in range(W):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)]);seen[r,c]=1;pts=[]\n            while q:\n                x,y=q.popleft();pts.append((x,y))\n                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nx,ny=x+dx,y+dy\n                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:\n                        seen[nx,ny]=1;q.append((nx,ny))\n            out.append(pts)\n    return out\n\ndef degs(mask):\n    H,W=mask.shape\n    bad=[]\n    for r,c in np.argwhere(mask):\n        d=0\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W and mask[rr,cc]:\n                d+=1\n        bad.append(d)\n    return sorted(set(bad))\n\nshape=np.zeros((15,15),bool)\nshape[5:10,4:10]=1\nshape[3:5,6:8]=1\nshape[7:10,10:12]=1\n# shell by chebyshev-1 dilation minus shape\nH,W=shape.shape\ndil=np.zeros_like(shape)\nfor r,c in np.argwhere(shape):\n    for dr in (-1,0,1):\n        for dc in (-1,0,1):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W:\n                dil[rr,cc]=1\nwall=dil & ~shape\nprint('shape comps',len(comps(shape)),'wall comps',len(comps(wall)),'wall degs',degs(wall))\n# show ascii\nfor r in range(H):\n    s=''\n    for c in range(W):\n        if shape[r,c]:s+='I'\n        elif wall[r,c]:s+='#'\n        else:s+='.'\n    print(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\nshape=np.zeros((15,15),bool)\nshape[5:10,4:10]=1\nshape[3:5,6:8]=1\nshape[7:10,10:12]=1\nH,W=shape.shape\ndil=np.zeros_like(shape)\nfor r,c in np.argwhere(shape):\n    for dr in (-1,0,1):\n        for dc in (-1,0,1):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W:\n                dil[rr,cc]=1\nwall=dil & ~shape\nband=np.zeros_like(shape)\nfor r,c in np.argwhere(shape):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        rr,cc=r+dr,c+dc\n        if 0<=rr<H and 0<=cc<W and wall[rr,cc]:\n            band[r,c]=1\n            break\nbad=[]\nfor r,c in np.argwhere(band):\n    d=0\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        rr,cc=r+dr,c+dc\n        if 0<=rr<H and 0<=cc<W and band[rr,cc]:\n            d+=1\n    bad.append(d)\nprint(sorted(set(bad)), band.sum())\nfor r in range(H):\n    s=''\n    for c in range(W):\n        if band[r,c]:s+='B'\n        elif shape[r,c]:s+='I'\n        elif wall[r,c]:s+='#'\n        else:s+='.'\n    print(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
