{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom collections import deque\nDIRS=[(-1,0),(0,1),(1,0),(0,-1)]\n\ndef fill_interior(wall):\n    H,W=wall.shape\n    seen=np.zeros_like(wall,dtype=bool)\n    q=deque()\n    for r in range(H):\n        for c in (0,W-1):\n            if not wall[r,c] and not seen[r,c]: seen[r,c]=1;q.append((r,c))\n    for c in range(W):\n        for r in (0,H-1):\n            if not wall[r,c] and not seen[r,c]: seen[r,c]=1;q.append((r,c))\n    while q:\n        r,c=q.popleft()\n        for dr,dc in DIRS:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W and not wall[rr,cc] and not seen[rr,cc]: seen[rr,cc]=1;q.append((rr,cc))\n    return (~wall)&(~seen)\n\ndef degrees(mask):\n    vals=[]\n    for r,c in np.argwhere(mask):\n        d=0\n        for dr,dc in DIRS:\n            rr,cc=r+dr,c+dc\n            if 0<=rr<mask.shape[0] and 0<=cc<mask.shape[1] and mask[rr,cc]: d+=1\n        vals.append(d)\n    return sorted(set(vals))\n\n# wall rectangle with top bump detour\nH,W=15,18\nwall=np.zeros((H,W),bool)\n# rectangle bbox rows 4..10 cols 4..12\nfor c in range(4,13): wall[4,c]=wall[10,c]=1\nfor r in range(4,11): wall[r,4]=wall[r,12]=1\n# remove top segment 7..9 and replace bump up to row2\nfor c in range(7,10): wall[4,c]=0\nwall[4,7]=1; wall[4,9]=1\nfor r in range(2,5): wall[r,7]=1; wall[r,9]=1\nfor c in range(7,10): wall[2,c]=1\ninterior=fill_interior(wall)\nprint('interior cells',interior.sum(),'wall deg',degrees(wall))\n# band adjacent to wall\nband=np.zeros_like(wall)\nfor r,c in np.argwhere(interior):\n    for dr,dc in DIRS:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<H and 0<=cc<W and wall[rr,cc]: band[r,c]=1; break\nprint('band deg',degrees(band))\nfor r in range(H):\n    s=''\n    for c in range(W):\n        if wall[r,c]: s+='#'\n        elif band[r,c]: s+='B'\n        elif interior[r,c]: s+='I'\n        else: s+='.'\n    print(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
