{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nDIRS=[(-1,0),(0,1),(1,0),(0,-1)]\n\ndef left(d):\n    return DIRS[(DIRS.index(d)-1)%4]\n\ndef right(d):\n    return DIRS[(DIRS.index(d)+1)%4]\n\ndef back(d):\n    return DIRS[(DIRS.index(d)+2)%4]\nshape=np.zeros((15,15),bool)\nshape[5:10,4:10]=1\nshape[3:5,6:8]=1\nshape[7:10,10:12]=1\nH,W=shape.shape\ndil=np.zeros_like(shape)\nfor r,c in np.argwhere(shape):\n    for dr in (-1,0,1):\n        for dc in (-1,0,1):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<H and 0<=cc<W:dil[rr,cc]=1\nwall=dil & ~shape\npts=set(map(tuple,np.argwhere(wall)))\nfor gap in sorted(pts):\n    n=[]\n    for d in DIRS:\n        rr,cc=gap[0]+d[0],gap[1]+d[1]\n        if (rr,cc) in pts:n.append(d)\n    if len(n)\"'!=2 or n[0][0]+n[1][0] or n[0][1]+n[1][1]:\n        continue\n    # start interior nbr\n    inns=[]\n    for d in DIRS:\n        rr,cc=gap[0]+d[0],gap[1]+d[1]\n        if 0<=rr<H and 0<=cc<W and shape[rr,cc]: inns.append((rr,cc,d))\n    if len(inns)!=1: continue\n    start_r,start_c,normal=inns[0]\n    face=(-normal[1],normal[0])\n    path=[(start_r,start_c)];cur=(start_r,start_c);d=face\n    ok=False\n    for step in range(500):\n        moved=False\n        for nd in (left(d), d, right(d), back(d)):\n            nr,nc=cur[0]+nd[0],cur[1]+nd[1]\n            if not (0<=nr<H and 0<=nc<W and shape[nr,nc]):continue\n            lr,lc=cur[0]+left(nd)[0],cur[1]+left(nd)[1]\n            if not (0<=lr<H and 0<=lc<W and wall[lr,lc]):continue\n            cur=(nr,nc);d=nd;path.append(cur);moved=True;break\n        if not moved: break\n        if cur==(start_r,start_c) and d==face:\n            ok=True;break\n    print('\"'gap',gap,'ok',ok,'steps',len(path))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
