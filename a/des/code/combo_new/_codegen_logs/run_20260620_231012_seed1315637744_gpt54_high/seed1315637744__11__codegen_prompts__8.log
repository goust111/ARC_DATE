((5, 5), bg, dtype=int)\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-43-    icon[0, 1:4] = frame_color\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-44-    icon[4, 1:4] = frame_color\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-45-    icon[1:4, 0] = frame_color\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-46-    icon[1:4, 4] = frame_color\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-47-\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-48-    interior = g[1 : h - 1, 1 : w - 1]\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-49-    motif_box = bbox(interior != bg)\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-50-    assert motif_box is not None\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-51-    r0, c0, r1, c1 = motif_box\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-52-    motif = interior[r0 : r1 + 1, c0 : c1 + 1]\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-53-    mh, mw = motif.shape\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-54-    assert mh <= 3 and mw <= 3\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-55-\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-56-    icon_r = 1 + (3 - mh) // 2\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-57-    icon_c = 1 + (3 - mw) // 2\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-58-    icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-59-\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-60-    out = np.full((15, 15), bg, dtype=int)\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-61-    out[2:7, 2:7] = icon\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-62-    out[8:13, 8:13] = icon\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-63-    return out\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-64-\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-65-# --------------- generator (att2) ---------------\n/home/lixinyu/snap/new/ARC_code/train/db118e2a.py-66-\n/home/lixinyu/snap/new/