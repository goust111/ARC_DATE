/136b0064.py-50-    # Move gray start from right side into left canvas (remove divider col too).\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-51-    gray = np.argwhere(g == 5)\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-52-    if gray.size == 0:\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-53-        return out\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-54-    r_cur, c_cur = map(int, gray[0])\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-55-    c_cur = int(c_cur - (int(div_c) + 1))\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-56-    if not (0 <= c_cur < int(div_c)):\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-57-        return out\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-58-    out[int(r_cur), int(c_cur)] = 5\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-59-\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-60-    # Collect 3x3 glyph components on the left.\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-61-    left = g[:, : int(div_c)]\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-62-    ignore = {int(bg), 5}\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-63-    if div_color is not None:\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-64-        ignore.add(int(div_color))\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-65-\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-66-    glyphs: list[dict[str, int]] = []\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-67-    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\\\\\\\\\\\\\\\"dict\\\\\\\\\\\\\\\"):\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-68-        col = int(comp[\\\\\\\\\\\\\\\"color\\\\\\\\\\\\\\\"])\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-69-        if col in ignore:\\\\\\\\n/home/lixinyu/snap/new/ARC_code/eval/136b0064.py-70-            continue\\\\\\