{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,380p' /home/lixinyu/snap/new/ARC_code/train/f0100645.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, paste\nimport random\n\n\ndef _component_order(coords: np.ndarray, direction: int) -> tuple[int, int, int, int]:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    if direction == -1:\n        return (int(cols.min()), int(rows.min()), int(cols.max()), int(rows.max()))\n    assert direction == 1, \"horizontal slide direction must be left or right\"\n    return (-int(cols.max()), int(rows.min()), -int(cols.min()), int(rows.max()))\n\n\ndef _settled_components(g: np.ndarray, color: int, side_col: int, direction: int) -> list[np.ndarray]:\n    h, w = g.shape\n    movable = (g == color)\n    movable[:, side_col] = False\n\n    comps = components_mask(movable, connectivity=8)\n    assert comps, \"expected at least one object away from the matching wall\"\n    comps.sort(key=lambda coords: _component_order(coords, direction))\n\n    settled = np.zeros((h, w), dtype=bool)\n    settled[:, side_col] = True\n    out_coords = []\n\n    for coords in comps:\n        shift = 0\n        while True:\n            candidate = coords + np.array([0, shift + direction])\n            cols = candidate[:, 1]\n            if int(cols.min()) < 0 or int(cols.max()) >= w:\n                break\n            if np.any(settled[candidate[:, 0], candidate[:, 1]]):\n                break\n            shift += direction\n\n        placed = coords + np.array([0, shift])\n        assert not np.any(settled[placed[:, 0], placed[:, 1]]), \"settled objects may touch but not overlap\"\n        settled[placed[:, 0], placed[:, 1]] = True\n        out_coords.append(placed)\n\n    return out_coords\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground colors are two non-background colors.\n    - One foreground color fills the left column and the other fills the right column.\n    - Extra 8-connected objects of each wall color appear away from that color's wall.\n\n    Rule\n    - Clear the extra objects from their original positions.\n    - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n    - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n    - Keep the two vertical wall columns fixed.\n\n    Key insight\n    - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n\n    bg = get_bg(g)\n    w = g.shape[1]\n    left_color = int(g[0, 0])\n    right_color = int(g[0, w - 1])\n\n    assert left_color != right_color, \"left and right walls must have different colors\"\n    assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n    assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n    assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n    assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n\n    out = np.full_like(g, int(bg))\n    out[:, 0] = left_color\n    out[:, w - 1] = right_color\n\n    placements: list[tuple[int, np.ndarray]] = []\n    for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n        for coords in _settled_components(g, color, side_col, direction):\n            placements.append((color, coords))\n\n    occupied = (out != bg)\n    for color, coords in placements:\n        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n        out[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n\n    assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n    assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (9, 10)\nGRID_WIDTH_BOUNDS = (9, 10)\nBACKGROUND_COLOR = 7\nWALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n# Object counts and pixel budgets.\nCOMPONENT_COUNT_BOUNDS = (2, 3)\nINNER_FOREGROUND_BOUNDS = (15, 23)\nSPRITE_PIXEL_BOUNDS = (1, 7)\n# Sprite geometry limits.\nSPRITE_HEIGHT_BOUNDS = (1, 5)\nSPRITE_WIDTH_BOUNDS = (1, 3)\nMIN_SPRITE_DENSITY = 0.56\n# Input scatter and retry limits.\nSCATTER_OFFSET_BOUNDS = (1, 5)\nGENERATION_ATTEMPTS = 300\n\nPlacement = tuple[int, np.ndarray, int, int, bool]\n\n\ndef _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n    values = []\n    remaining = int(total)\n    for i in range(int(parts)):\n        slots = int(parts) - i - 1\n        low = max(int(lo), remaining - int(hi) * slots)\n        high = min(int(hi), remaining - int(lo) * slots)\n        value = random.randint(low, high)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _gen_sprite_mask(size: int) -> np.ndarray:\n    size = int(size)\n    dims = [\n        (h, w)\n        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n    ]\n    h, w = random.choice(dims)\n\n    coords: set[tuple[int, int]] = set()\n    length = max(h, w)\n    if length == 1:\n        coords.add((0, 0))\n    else:\n        for i in range(length):\n            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n            coords.add((int(r), int(c)))\n\n    while len(coords) < size:\n        frontier = []\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n                        frontier.append((nr, nc))\n        coords.add(random.choice(frontier))\n\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in coords:\n        mask[r, c] = True\n    if random.choice([False, True]):\n        mask = np.flipud(mask)\n    if random.choice([False, True]):\n        mask = np.fliplr(mask)\n    return mask.copy()\n\n\ndef _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    return np.argwhere(mask) + np.array([int(r0), int(c0)])\n\n\ndef _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:\n    grid = np.full(shape, int(bg), dtype=int)\n    grid[:, 0] = int(left_color)\n    grid[:, shape[1] - 1] = int(right_color)\n    return grid\n\n\ndef _gen_place_output_side(\n    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int\n) -> list[Placement]:\n    h, w = out.shape\n    placements = []\n    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):\n        mh, mw = mask.shape\n        c0 = 1 if left_side else w - 1 - mw\n        rows = list(range(0, h - mh + 1))\n        random.shuffle(rows)\n        for r0 in rows:\n            coords = _gen_mask_coords(mask, r0, c0)\n            if np.any(out[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(out, patch, r0, c0, transparent=bg)\n            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))\n            break\n        else:\n            return []\n    return placements\n\n\ndef _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:\n    for other in existing:\n        dr = np.abs(coords[:, None, 0] - other[None, :, 0])\n        dc = np.abs(coords[:, None, 1] - other[None, :, 1])\n        if bool(np.any((dr <= 1) & (dc <= 1))):\n            return True\n    return False\n\n\ndef _gen_scatter_input(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]\n) -> np.ndarray | None:\n    h, w = shape\n    inp = _gen_base_grid((h, w), bg, left_color, right_color)\n    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}\n\n    shuffled = list(placements)\n    random.shuffle(shuffled)\n    for color, mask, r0, c_out, left_side in shuffled:\n        mh, mw = mask.shape\n        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)\n        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))\n        random.shuffle(offsets)\n        for offset in offsets:\n            c_in = c_out + offset if left_side else c_out - offset\n            coords = _gen_mask_coords(mask, r0, c_in)\n            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            if _gen_touches_existing(coords, by_color[int(color)]):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(inp, patch, r0, c_in, transparent=bg)\n            by_color[int(color)].append(coords)\n            break\n        else:\n            return None\n    return inp\n\n\ndef _gen_output_layout(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int,\n    left_masks: list[np.ndarray], right_masks: list[np.ndarray],\n) -> tuple[np.ndarray, list[Placement]] | None:\n    out = _gen_base_grid(shape, bg, left_color, right_color)\n    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)\n    if len(left_placements) != len(left_masks):\n        return None\n    right_placements = _gen_place_output_side(out, right_color, right_masks, left_side=False, bg=bg)\n    if len(right_placements) != len(right_masks):\n        return None\n    return out, left_placements + right_placements\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    h = random.randint(*GRID_HEIGHT_BOUNDS)\n    w = random.randint(*GRID_WIDTH_BOUNDS)\n    bg = BACKGROUND_COLOR\n    left_color, right_color = random.sample(WALL_COLORS, 2)\n\n    left_count = random.randint(*COMPONENT_COUNT_BOUNDS)\n    right_count = random.randint(*COMPONENT_COUNT_BOUNDS)\n    total_inner = random.randint(*INNER_FOREGROUND_BOUNDS)\n    sizes = _gen_bounded_composition(total_inner, left_count + right_count, *SPRITE_PIXEL_BOUNDS)\n    left_masks = [_gen_sprite_mask(size) for size in sizes[:left_count]]\n    right_masks = [_gen_sprite_mask(size) for size in sizes[left_count:]]\n\n    layout = _gen_output_layout((h, w), bg, left_color, right_color, left_masks, right_masks)\n    if layout is None:\n        return None\n    out, placements = layout\n\n    inp = _gen_scatter_input((h, w), bg, left_color, right_color, placements)\n    if inp is None:\n        return None\n    try:\n        solved = main(inp)\n    except AssertionError:\n        return None\n    if np.array_equal(solved, out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid f0100645 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,460p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n\n    return blob\n\n\ndef _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:\n    if target <= 0:\n        return np.zeros_like(allowed, dtype=bool)\n\n    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY\n    if want_two:\n        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):\n            first_size = random.randint(1, target - 1)\n            first = _grow_blob(allowed, first_size)\n            if first is None:\n                continue\n\n            blocked = set(first)\n            for r, c in tuple(first):\n                blocked.update(_neighbors4(r, c, *allowed.shape))\n\n            allowed_second = allowed.copy()\n            for r, c in blocked:\n                allowed_second[r, c] = False\n\n            second = _grow_blob(allowed_second, target - first_size)\n            if second is None:\n                continue\n\n            mask = np.zeros_like(allowed, dtype=bool)\n            for r, c in first | second:\n                mask[r, c] = True\n            return mask\n\n    one = _grow_blob(allowed, target)\n    if one is None:\n        return None\n\n    mask = np.zeros_like(allowed, dtype=bool)\n    for r, c in one:\n        mask[r, c] = True\n    return mask\n\n\ndef _sample_block_states(n: int) -> tuple[np.ndarray, int]:\n    block_count = n * n\n    max_blanks = max(MIN_BLANK_BLOCKS, block_count // MAX_BLANK_BLOCK_DENOMINATOR)\n    blank_blocks = random.randint(MIN_BLANK_BLOCKS, max_blanks)\n    state = np.ones((n, n), dtype=bool)\n    for idx in random.sample(range(block_count), blank_blocks):\n        state[idx // n, idx % n] = False\n    return state, blank_blocks\n\n\ndef _render_clean_grids(n, block_size, side, state, sprite, foreground, blank) -> tuple[np.ndarray, np.ndarray]:\n    out = np.full((side, side), GEN_SEPARATOR_COLOR, dtype=int)\n    inp = np.full((side, side), GEN_SEPARATOR_COLOR, dtype=int)\n    for br in range(n):\n        for bc in range(n):\n            r0, c0 = _block_origin(br, bc, block_size)\n            if state[br, bc]:\n                out[r0 : r0 + block_size, c0 : c0 + block_size] = foreground\n                inp[r0 : r0 + block_size, c0 : c0 + block_size] = sprite\n            else:\n                out[r0 : r0 + block_size, c0 : c0 + block_size] = sprite\n                inp[r0 : r0 + block_size, c0 : c0 + block_size] = blank\n    return inp, out\n\n\ndef _build_protected_mask(n, block_size, side, clean_block, sprite, foreground) -> np.ndarray:\n    \"\"\"Reserve enough evidence for the solver to infer every block and separator.\"\"\"\n    protected = np.zeros((side, side), dtype=bool)\n    r0, c0 = _block_origin(*clean_block, block_size)\n    protected[r0 : r0 + block_size, c0 : c0 + block_size] = True\n\n    fg_positions = list(zip(*np.nonzero(sprite == foreground)))\n    for br in range(n):\n        for bc in range(n):\n            rr, cc = random.choice(fg_positions)\n            r0, c0 = _block_origin(br, bc, block_size)\n            protected[r0 + rr, c0 + cc] = True\n\n    row_seps = _separator_indices(n, block_size)\n    col_seps = _separator_indices(n, block_size)\n    non_sep_rows = [r for r in range(side) if r not in row_seps]\n    non_sep_cols = [c for c in range(side) if c not in col_seps]\n    for r in non_sep_rows:\n        protected[r, random.choice(non_sep_cols)] = True\n    for c in non_sep_cols:\n        protected[random.choice(non_sep_rows), c] = True\n    return protected\n\n\ndef _add_grey_overlay(inp: np.ndarray, protected: np.ndarray) -> bool:\n    allowed = ~protected\n    side = inp.shape[0]\n    min_grey = max(1, math.ceil(side * side * GREY_MIN_FRACTION))\n    max_grey = max(min_grey, math.floor(side * side * GREY_MAX_FRACTION))\n    available_sizes = [len(comp) for comp in components_mask(allowed, connectivity=GREY_CONNECTIVITY)]\n    largest_available = max(available_sizes, default=0)\n    if largest_available < min_grey:\n        return False\n    target = random.randint(min_grey, min(max_grey, largest_available))\n    grey = _make_grey_mask(allowed, target)\n    if grey is None:\n        return False\n\n    inp[grey] = GEN_ERASED_COLOR\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*GRID_COUNT_RANGE)\n    block_size = random.randint(*BLOCK_SIZE_RANGE)\n    side = n * block_size + (n - 1)\n\n    foreground, blank = random.sample(PAYLOAD_COLORS, PAYLOAD_COLOR_COUNT)\n    sprite = _make_sprite(block_size, foreground, blank)\n    if sprite is None:\n        return None\n\n    state, blank_blocks = _sample_block_states(n)\n    clean_sprite_blocks = [(r, c) for r in range(n) for c in range(n) if state[r, c]]\n    if not clean_sprite_blocks or blank_blocks == 0:\n        return None\n    clean_block = random.choice(clean_sprite_blocks)\n\n    inp, out = _render_clean_grids(n, block_size, side, state, sprite, foreground, blank)\n    protected = _build_protected_mask(n, block_size, side, clean_block, sprite, foreground)\n    if not _add_grey_overlay(inp, protected):\n        return None\n    try:\n        solved = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
