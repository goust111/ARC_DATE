{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def generate_input(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py | sed '\"'$d'\"'\"","aggregated_output":"def generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def generate_input(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py | sed '\"'$d'\"'\"","aggregated_output":"def generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n\nBG = 6\nBORDER = 0\nGREY = 5\nORANGE = 7\nHEAD_COLOR = 9\n\n# Direction mapping: head_side -> (dr, dc) movement direction\n# head on top -> container moves up; head on bottom -> moves down, etc.\nSIDE_TO_DIR = {0: (-1, 0), 1: (1, 0), 2: (0, -1), 3: (0, 1)}\n\n\n","exit_code":0,"status":"completed"}}
