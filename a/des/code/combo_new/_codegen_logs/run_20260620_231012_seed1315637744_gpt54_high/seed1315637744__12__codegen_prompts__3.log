{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk 'NR>=57&&NR<170{print} NR>=397&&NR<530{print}' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\ndef generate_input():\n    for _ in range(_GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 902510d5 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"awk 'NR>=104&&NR<210{print} NR>=454&&NR<590{print}' /home/lixinyu/snap/new/ARC_code/eval/53fb4810.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend marker tiles outward from '+' shapes by repeating them to the grid edge.\n\n    Input structure:\n    - bg = most common color.\n    - A dominant non-bg color forms several '+'-shaped objects.\n    - Small colored patches (1–few cells) sit adjacent to each arm of a '+'.\n\n    Rule:\n    - For each marker tile touching a '+', determine which side of the '+' it sits on.\n    - Project the tile away from the '+' in that direction, repeating the tile pattern periodically until the grid boundary.\n    - '+' pixels are never overwritten.\n\n    Key insight: Each marker's attachment side determines its extension direction; the pattern repeats periodically, not as a single copy.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    H, W = g.shape\n\n    bg = int(get_bg(g))\n    plus_col = detect_dominant_big_component_color(g, bg=bg, min_h=3, min_w=3, connectivity=4)\n    if plus_col is None:\n        return out\n\n    plus_lab, pn = label_mask(g == int(plus_col), connectivity=4)\n    non_mask = (g != int(bg)) & (g != int(plus_col))\n    mark_lab, _mn = label_mask(non_mask, connectivity=4)\n\n    for pk in range(1, int(pn) + 1):\n        plus_mask = (plus_lab == int(pk))\n        plus_coords = np.argwhere(plus_mask)\n        if plus_coords.size == 0:\n            continue\n\n        adj_ids: set[int] = set()\n        for r, c in plus_coords:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = r + dr\n                cc = c + dc\n                if 0 <= rr < H and 0 <= cc < W and int(mark_lab[rr, cc]) > 0:\n                    adj_ids.add(int(mark_lab[rr, cc]))\n\n        for cid in sorted(adj_ids):\n            pts = np.argwhere(mark_lab == int(cid))\n            if pts.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(pts)\n            tile = crop_bbox(g, (int(r0), int(c0), int(r1), int(c1)))\n\n            # Direction from plus -> marker (must be unique).\n            dirs: set[tuple[int, int]] = set()\n            for pr, pc in pts:\n                pr = int(pr)\n                pc = int(pc)\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    rr = pr + dr\n                    cc = pc + dc\n                    if 0 <= rr < H and 0 <= cc < W and bool(plus_mask[rr, cc]):\n                        dirs.add((-int(dr), -int(dc)))\n            if len(dirs) != 1:\n                continue\n\n            dr, dc = next(iter(dirs))\n\n            # Alignment check: seed cross-axis span must match arm tip span.\n            pr0, pc0 = plus_coords.min(axis=0)\n            pr1, pc1 = plus_coords.max(axis=0)\n            if dc == 0:  # vertical ray\n                nozzle_row = int(pr1) if dr == 1 else int(pr0)\n                nozzle_cols = sorted(int(cc) for cc in range(int(pc0), int(pc1) + 1) if plus_mask[nozzle_row, cc])\n                seed_cols = list(range(int(c0), int(c1) + 1))\n                assert seed_cols == nozzle_cols\n            else:  # horizontal ray\n                nozzle_col = int(pc1) if dc == 1 else int(pc0)\n                nozzle_rows = sorted(int(rr) for rr in range(int(pr0), int(pr1) + 1) if plus_mask[rr, nozzle_col])\n                seed_rows = list(range(int(r0), int(r1) + 1))\n                assert seed_rows == nozzle_rows\n\n            extend_repeating_tile(\n                out,\n                tile,\n                int(r0),\n                int(c0),\n                (int(dr), int(dc)),\n                bg=int(bg),\n                protect={int(plus_col)},\n            )\n\n    return out\n\n# --------------- generator (attempt_1) ---------------\n\n# === CFG: Tunable generation parameters ===\n_H_RANGE = (13, 29)            # grid height [min, max)\n_W_RANGE = (13, 23)            # grid width [min, max)\n_N_PLUS_RANGE = (2, 4)         # number of plus sprites [min, max)\n_SEED_ALONG_CHOICES = [1, 2]   # along-axis dimension options for seed tile\n_SEED_MAX_COLORS = 4           # max distinct colors in a seed tile\n_SEED_MAX_CROSS = 2            # max nozzle cross-axis span for valid seed\n_MIN_RAY_UNITS = 2             # minimum tile repetitions along ray\n_PRE_EXT_IDEAL_UNITS = 10     # preferred minimum units for the pre-extended ray\n_PLACEMENT_TRIES = 100         # attempts per plus placement\n_GEN_RETRIES = 300             # outer retry limit in generate_input\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(_GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: failed after %d attempts\" % _GEN_RETRIES)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"awk 'NR>=7&&NR<120{print} NR>=565&&NR<700{print}' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a red ray network by activating blue blobs via directional green ports.\n\n    Input structure:\n    - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.\n    - Start marker: yellow pixel atop a short red segment at grid bottom.\n\n    Rule:\n    - Extend a ray upward from start; on hitting a blue blob, recolor it red.\n    - Activated blobs emit thick rays through green ports until boundary or another blob.\n    - Cascade until no new blobs are reached.\n\n    Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n    start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n\n    for col in colors_present(g, exclude={bg}):\n        for coords in components_mask(g == int(col), connectivity=8):\n            if coords.size == 0:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n\n            # thin vertical segment, height>=2, touches bottom\n            if c0 != c1 or (r1 - r0 + 1) < 2:\n                continue\n            if r1 != int(H - 1):\n                continue\n            # solid vertical segment\n            if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n                continue\n            if int(r0) - 1 < 0:\n                continue\n            cap = int(g[int(r0) - 1, int(c0)])\n            if cap == int(bg) or cap == int(col):\n                continue\n\n            start_candidates.append(\n                (\n                    int(col),\n                    int(cap),\n                    int(c0),\n                    [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n                )\n            )\n\n    assert len(start_candidates) == 1\n    red_col, yellow_col, start_col, start_seg = start_candidates[0]\n\n    # --- STEP 2) Identify blob colors ---\n    # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n    counts = Counter(map(int, g.flatten()))\n    other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]\n    assert other_cols\n    max_count = max(cnt for cnt, _col in other_cols)\n    blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]\n    assert len(blue_candidates) == 1\n    blue_col = int(blue_candidates[0])\n\n    # Green = the unique other color that is 4-adjacent to blue.\n    green_candidates: list[int] = []\n    for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):\n        pts = np.argwhere(g == int(col))\n        if pts.size == 0:\n            continue\n        ok = False\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):\n                    ok = True\n                    break\n            if ok:\n                break\n        if ok:\n            green_candidates.append(int(col))\n\n    assert len(green_candidates) == 1\n    green_col = int(green_candidates[0])\n\n    out = np.full_like(g, int(bg))\n\n    # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---\n    blob_id = np.full((H, W), -1, dtype=int)\n    blobs: list[dict] = []\n\n    for coords in components_mask(g == int(blue_col), connectivity=8):\n        pts = [(int(r), int(c)) for r, c in coords]\n        bi = int(len(blobs))\n        for r, c in pts:\n            blob_id[int(r), int(c)] = bi\n        blobs.append({\"pts\": pts, \"ports\": []})\n\n    # --- STEP 4) For each blob, find its ports from adjacent green markers ---\n    for blob in blobs:\n        pts = blob[\"pts\"]\n        seen_dirs: set[tuple[int, int]] = set()\n        for r, c in pts:\n            for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + ddr)\n                cc = int(c + ddc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):\n                    seen_dirs.add((int(ddr), int(ddc)))\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 5961cc34 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"awk 'NR>=24&&NR<110{print} NR>=190&&NR<320{print}' /home/lixinyu/snap/new/ARC_code/eval/136b0064.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.\n\n    Input structure:\n    - Left of a full-height vertical divider: 3x3 colored glyphs on bg.\n    - Right of divider: a single gray (5) start pixel.\n\n    Rule:\n    - Remove the divider; shift the gray start into the left canvas.\n    - Read glyphs in column-major order (left→right, top→bottom).\n    - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.\n    - Append segments sequentially, stepping down one cell between each.\n\n    Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # Divider is a full-height constant non-bg column.\n    div_c, div_color = find_full_height_constant_col(g, bg=bg)\n    assert div_c is not None\n\n    out = np.zeros((H, int(div_c)), dtype=int)\n\n    # Move gray start from right side into left canvas (remove divider col too).\n    gray = np.argwhere(g == 5)\n    if gray.size == 0:\n        return out\n    r_cur, c_cur = map(int, gray[0])\n    c_cur = int(c_cur - (int(div_c) + 1))\n    if not (0 <= c_cur < int(div_c)):\n        return out\n    out[int(r_cur), int(c_cur)] = 5\n\n    # Collect 3x3 glyph components on the left.\n    left = g[:, : int(div_c)]\n    ignore = {int(bg), 5}\n    if div_color is not None:\n        ignore.add(int(div_color))\n\n    glyphs: list[dict[str, int]] = []\n    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        if col in ignore:\n            continue\n        b = comp[\"bbox\"]\n        if bbox_h(b) == 3 and bbox_w(b) == 3:\n            r0, c0, _r1, _c1 = map(int, b)\n            glyphs.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"area\": int(comp[\"area\"])})\n\n    glyphs.sort(key=lambda d: (int(d[\"c0\"]), int(d[\"r0\"])))\n\n    area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}\n    area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left\n\n    for glyph in glyphs:\n        color = int(glyph[\"color\"])\n        area = int(glyph[\"area\"])\n        seg_len = int(area_to_len.get(area, 2))\n\n        r_cur = int(r_cur + 1)\n        assert r_cur < H, f\"segment exits bottom: r_cur={r_cur}, H={H}\"\n        out[r_cur, int(c_cur)] = color\n\n        if area == 4:  # vertical (down)\n            end_r = r_cur + (seg_len - 1)\n            assert end_r < H, f\"vertical segment exits bottom: end_r={end_r}, H={H}\"\n            for _ in range(seg_len - 1):\n                r_cur = int(r_cur + 1)\n                out[r_cur, int(c_cur)] = color\n        else:  # horizontal\n            dir_h = int(area_to_dir.get(area, 1))\n            end_c = int(c_cur) + dir_h * (seg_len - 1)\n            assert 0 <= end_c < int(div_c), (\n                f\"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, \"\n                f\"seg_len={seg_len}, div_c={div_c}\"\n            )\n            for _ in range(seg_len - 1):\n                c_cur = int(c_cur + dir_h)\n                out[r_cur, c_cur] = color\n\n    return out\n\n# --------------- generator (attempt 1 (Claude)) ---------------\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        try:\n            inp = _gen_attempt()\n            if inp is None:\n                continue\n            out = main(inp)  # oracle check\n            if out.shape != (inp.shape[0], LEFT_W):\n                continue\n            return inp\n        except Exception:\n            continue\n    