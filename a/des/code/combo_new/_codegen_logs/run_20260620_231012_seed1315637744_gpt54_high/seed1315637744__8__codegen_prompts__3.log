lixinyu/snap/new/ARC_code/eval/dbff022c.py\n-- snippet from line 274\n0274: def main(grid: np.ndarray) -> np.ndarray:\n0275:     \"\"\"\n0276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n0277: \n0278:     Input structure:\n0279:     - bg = most common color. Several hollow sprites with distinct border colors.\n0280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n0281: \n0282:     Rule:\n0283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n0284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n0285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n0286: \n0287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n0288:     \"\"\"\n0289:     g = np.asarray(grid, dtype=int)\n0290:     bg = _bg_boundary(g)\n0291: \n0292:     mapping, pal_mask = _palette_mapping(g, bg)\n0293:     assert mapping, \"main: palette mapping must be non-empty\"\n0294: \n0295:     out = g.copy()\n0296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n0297: \n0298:     return out\n0299: \n0300: # --------------- generator (c) ---------------\n0301: \n0302: # -- Configuration constants --------------------------------------------------\n0303: # Grid dimensions\n0304: _GRID_H_MIN, _GRID_H_MAX = 4, 13\n0305: _GRID_W_MIN, _GRID_W_MAX = 10, 15\n0306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n0307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n0308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n0309: \n0310: # Palette\n0311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n0312: \n0313: # Sprite geometry\n0314: _SPRITE_H_MAX = 7\n0315: _SPRITE_W_MAX = 6\n0316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n0317: _SPRITE_CELL_MAX = 16\n0318: _FILLED_SPRITE_MAX = 3\n0319: \n0320: # Sprite mutation probabilities\n0321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n0322: _P_VERT_WALL = 0.3            # add vertical internal wall\n0323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n0324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n0325: \n0326: # Generation\n0327: _MAX_RETRIES = 300\n0328: # -- End configuration --------------------------------------------------------\n0329: \n0330: \n0331: def _get_enclosed_holes(sprite):\n0332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n0333:     h, w = sprite.shape\n0334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n0335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n0336: \n0337: \n0338: def _make_diamond():\n0339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n0340:     s = np.zeros((3, 3), dtype=bool)\n0341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n0342:     return s\n0343: \n0344: \n0345: def _make_hollow_sprite(h, w, rng):\n0346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n0347:     sprite = np.ones((h, w), dtype=bool)\n0348:     if h >= 3 and w >= 3:\n0349:         sprite[1:-1, 1:-1] = False\n0350:     # Optionally add internal horizontal wall\n0351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n0352:         br = rng.randint(2, h - 2)\n0353:         n = rng.randint(1, w - 2)\n0354:         s = rng.randint(1, w - 1 - n + 1)\n0355:         sprite[br, s:s + n] = True\n0356:     # Optionally add internal vertical wall\n0357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n0358:         bc = rng.randint(2, w - 2)\n0359:         n = rng.