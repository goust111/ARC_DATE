 line 7\n0007: def main(grid: np.ndarray) -> np.ndarray:\n0008:     \"\"\"\n0009:     Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n0010: \n0011:     Input structure:\n0012:     - The grid has a dominant background color.\n0013:     - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n0014:     - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n0015: \n0016:     Rule:\n0017:     - Keep the input pixels unchanged.\n0018:     - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n0019:     - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n0020: \n0021:     Key insight:\n0022:     - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n0023:     \"\"\"\n0024:     g = np.asarray(grid, dtype=int)\n0025:     bg = int(get_bg(g))\n0026:     out = g.copy()\n0027:     h, w = g.shape\n0028: \n0029:     markers: dict[int, int] = {}\n0030:     marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n0031:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n0032:         r0, c0, r1, c1 = comp[\"bbox\"]\n0033:         height = int(r1 - r0 + 1)\n0034:         if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n0035:             continue\n0036: \n0037:         sub = g[r0 : r1 + 1, c0 : c1 + 1]\n0038:         assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n0039:         assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n0040:         assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n0041:         source = int(sub[0, 0])\n0042:         halo = int(sub[0, 1])\n0043:         assert source != halo, \"legend source and halo colors must differ\"\n0044:         assert source not in markers, \"each source color must have exactly one legend marker\"\n0045: \n0046:         markers[source] = halo\n0047:         marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n0048: \n0049:     assert markers, \"expected at least one left-edge legend marker\"\n0050: \n0051:     for source, halo in markers.items():\n0052:         objects = []\n0053:         for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n0054:             cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n0055:             if cells <= marker_source_cells[source]:\n0056:                 continue\n0057:             objects.append(comp)\n0058:         assert objects, \"each legend source color must label at least one non-marker object\"\n0059: \n0060:         for obj in objects:\n0061:             r0, c0, r1, c1 = obj[\"bbox\"]\n0062:             pr0 = max(0, int(r0) - 1)\n0063:             pc0 = max(0, int(c0) - 1)\n0064:             pr1 = min(h - 1, int(r1) + 1)\n0065:             pc1 = min(w - 1, int(c1) + 1)\n0066: \n0067:             patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n0068:             coords = obj[\"coords\"]\n0069:             patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n0070:             enclosed = object_interior(patch, background=bg)\n0071:             fill_mask = (patch == bg) & ~enclosed\n0072: \n0073:             input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n0074:             target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n0075:             assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n0076:             assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)),