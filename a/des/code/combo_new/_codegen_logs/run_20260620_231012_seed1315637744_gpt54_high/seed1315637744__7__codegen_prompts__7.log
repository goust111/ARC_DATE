{"type":"item.completed","item":{"id":"item_38","type":"agent_message","text":"我改成“先追踪土壤的外边界边段，再把每条边映射到它外侧的背景像素”。这样顺时针顺序是天然唯一的，也能把有凹口的形状统一起来。先用几种多米诺和 L/C 形做一次验证。"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import defaultdict, deque\nDIR4=[(-1,0),(1,0),(0,-1),(0,1)]\n\ndef exterior(cells):\n    cells=set(cells)\n    rs=[r for r,c in cells]; cs=[c for r,c in cells]\n    minr,maxr=min(rs),max(rs); minc,maxc=min(cs),max(cs)\n    H=maxr-minr+5; W=maxc-minc+5\n    offr=2-minr; offc=2-minc\n    cells={(r+offr,c+offc) for r,c in cells}\n    passable={(r,c) for r in range(H) for c in range(W) if (r,c) not in cells}\n    ext=set(); q=deque()\n    for r in range(H):\n      for c in range(W):\n        if r in (0,H-1) or c in (0,W-1):\n          if (r,c) in passable and (r,c) not in ext:\n            ext.add((r,c)); q.append((r,c))\n    while q:\n      r,c=q.popleft()\n      for dr,dc in DIR4:\n        rr,cc=r+dr,c+dc\n        if 0<=rr<H and 0<=cc<W and (rr,cc) in passable and (rr,cc) not in ext:\n          ext.add((rr,cc)); q.append((rr,cc))\n    return cells,ext,offr,offc\n\ndef boundary_seq(cells):\n    cells,ext,offr,offc=exterior(cells)\n    edges=[]\n    for r,c in cells:\n      if (r-1,c) in ext: edges.append(((r,c),(r,c+1),(r-1,c)))\n      if (r,c+1) in ext: edges.append(((r,c+1),(r+1,c+1),(r,c+1)))\n      if (r+1,c) in ext: edges.append(((r+1,c+1),(r+1,c),(r+1,c)))\n      if (r,c-1) in ext: edges.append(((r+1,c),(r,c),(r,c-1)))\n    nxt={a:(b,out) for a,b,out in edges}\n    # this assumption maybe unique outgoing per vertex on single cycle\n    start=min(nxt)\n    seq=[]\n    cur=start\n    while True:\n      b,out=nxt[cur]\n      seq.append(out)\n      cur=b\n      if cur==start:\n        break\n      if len(seq)>1000:\n        raise SystemExit('loop')\n    # shift back\n    seq=[(r-offr,c-offc) for r,c in seq]\n    return seq\n\nshapes={'single':[(0,0)],'domino':[(0,0),(0,1)],'block2':[(0,0),(0,1),(1,0),(1,1)],'L5':[(0,0),(1,0),(2,0),(2,1),(2,2)],'C':[(0,0),(0,1),(0,2),(1,0),(2,0),(2,1),(2,2)],'U':[(0,0),(0,1),(0,2),(1,0),(1,2),(2,0),(2,1),(2,2)],'plus5':[(0,1),(1,0),(1,1),(1,2),(2,1)]}\nfor name,c in shapes.items():\n  seq=boundary_seq(c)\n  print(name,len(seq),seq)\n  dups=[i for i in range(len(seq)) if seq.count(seq[i])>1]\n  print('unique',len(set(seq)),'dups',dups[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
