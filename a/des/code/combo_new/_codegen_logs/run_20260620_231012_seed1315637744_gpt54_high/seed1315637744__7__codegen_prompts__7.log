,1),(2,2)],'plus5':[(0,1),(1,0),(1,1),(1,2),(2,1)]}\nfor name,c in shapes.items():\n  seq=boundary_seq(c)\n  print(name,len(seq),seq)\n  dups=[i for i in range(len(seq)) if seq.count(seq[i])>1]\n  print('unique',len(set(seq)),'dups',dups[:10])\nPY\"","aggregated_output":"single 4 [(-1, 0), (0, 1), (1, 0), (0, -1)]\nunique 4 dups []\ndomino 6 [(-1, 0), (-1, 1), (0, 2), (1, 1), (1, 0), (0, -1)]\nunique 6 dups []\nblock2 8 [(-1, 0), (-1, 1), (0, 2), (1, 2), (2, 1), (2, 0), (1, -1), (0, -1)]\nunique 8 dups []\nL5 12 [(-1, 0), (0, 1), (1, 1), (1, 1), (1, 2), (2, 3), (3, 2), (3, 1), (3, 0), (2, -1), (1, -1), (0, -1)]\nunique 11 dups [2, 3]\nC 16 [(-1, 0), (-1, 1), (-1, 2), (0, 3), (1, 2), (1, 1), (1, 1), (1, 1), (1, 2), (2, 3), (3, 2), (3, 1), (3, 0), (2, -1), (1, -1), (0, -1)]\nunique 13 dups [4, 5, 6, 7, 8]\nU 12 [(-1, 0), (-1, 1), (-1, 2), (0, 3), (1, 3), (2, 3), (3, 2), (3, 1), (3, 0), (2, -1), (1, -1), (0, -1)]\nunique 12 dups []\nplus5 12 [(-1, 1), (0, 2), (0, 2), (1, 3), (2, 2), (2, 2), (3, 1), (2, 0), (2, 0), (1, -1), (0, 0), (0, 0)]\nunique 8 dups [1, 2, 4, 5, 7, 8, 10, 11]\n","exit_code":0,"status":"completed"}}
