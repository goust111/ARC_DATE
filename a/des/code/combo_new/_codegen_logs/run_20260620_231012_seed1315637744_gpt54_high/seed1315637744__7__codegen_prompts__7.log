 c2*r1\n    return s\n\ndef rand_shape(n=8):\n    cells={(0,0)}\n    while len(cells)<n:\n        r,c=random.choice(list(cells))\n        dr,dc=random.choice([(-1,0),(1,0),(0,-1),(0,1)])\n        cells.add((r+dr,c+dc))\n    return cells\n\ndef simple_seed(cells):\n    dirs4=[(-1,0),(1,0),(0,-1),(0,1)]\n    ring,_cells,_seed=ext_ring(cells)\n    cands=[]\n    for p in ring:\n        cnt=sum((p[0]+dr,p[1]+dc) in _cells for dr,dc in dirs4)\n        if cnt==1:\n            cands.append(p)\n    return cands\n\nfor n in range(1,13):\n    for _ in range(200):\n        cells=rand_shape(n)\n        cands=simple_seed(cells)\n        if not cands:\n            continue\n        seed=random.choice(cands)\n        # convert back to original coords from padded ring? not needed. use ring directly start=seed\n        ring,cells2,seed2=ext_ring(cells,seed=(seed[0]-2+min(r for r,c in cells),seed[1]-2+min(c for r,c in cells)))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
