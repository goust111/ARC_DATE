home/lixinyu/snap/a/des/code/combo_new/seed1315637744/7/similar_ids/8.txt\n/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/7/similar_ids/3.txt\n/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/7/similar_ids/4.txt\n/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/7/similar_ids/2.txt\n/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/7/similar_ids/1.txt\n","exit_code":0,"status":"completed"}}
