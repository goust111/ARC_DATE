{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/20fb2937.py /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py /home/lixinyu/snap/new/ARC_code/eval/b0039139.py /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py /home/lixinyu/snap/new/ARC_code/train/dce56571.py; do echo \"FILE:$f\"; sed -n '\"'/\"'^def main/,/''^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/20fb2937.py /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py /home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py /home/lixinyu/snap/new/ARC_code/train/b1986d4b.py /home/lixinyu/snap/new/ARC_code/eval/b0039139.py /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py /home/lixinyu/snap/new/ARC_code/train/dce56571.py; do echo \"FILE:$f\"; sed -n '\"'/\"'^def main/,/''^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^def /p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; done\"","aggregated_output":"FILE:/home/lixinyu/snap/new/ARC_code/train/20fb2937.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each marker below the separator with the mapped top legend square centered on that marker.\n\n    Input structure:\n    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.\n    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.\n    - The lower field contains only background and marker colors from the legend.\n\n    Rule:\n    - Pair legend markers to legend sprites by left-to-right position.\n    - Discard the legend and separator; keep the grid width and the rows below the separator.\n    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.\n\n    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    sep = _solid_separator_row(g, bg)\n    mapping, size = _legend_mapping(g, sep, bg)\n\n    lower = g[sep + 1 :]\n    out = np.full_like(lower, bg)\n    radius = size // 2\n\n    for r, c in np.argwhere(lower != bg):\n        key = int(lower[r, c])\n        assert key in mapping, \"lower field marker must appear in the legend\"\n        r0 = int(r) - radius\n        c0 = int(c) - radius\n        r1 = r0 + size\n        c1 = c0 + size\n        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], \"expanded square must fit in output\"\n        assert np.all(out[r0:r1, c0:c1] == bg), \"expanded squares must not overlap\"\n        out[r0:r1, c0:c1] = mapping[key]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6\nFIELD_SHAPE = (13, 11)\nFIELD_WIDTH = FIELD_SHAPE[1]\nSQUARE_SIZE = 3\nSQUARE_RADIUS = SQUARE_SIZE // 2\nLEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4\n\n# Palette and object counts.\nPALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nNUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]\n\nEMPTY, MAX_GENERATION_ATTEMPTS = 0, 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\nFILE:/home/lixinyu/snap/new/ARC_code/eval/a395ee82.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n\n    Input structure:\n    - bg = background. A large monochrome shape (template, color T).\n    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n    - Singletons sit on a uniform-spacing lattice.\n\n    Rule:\n    - Convert each singleton's offset from the origin into coarse lattice units.\n    - Place a template copy at each offset, scaled by template height/width.\n    - The origin's copy is painted O instead of T.\n    - Any pixel covered by two or more copies is also recolored to O.\n\n    Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    template = max(comps, key=lambda d: int(d[\"area\"]))\n    templ_coords = template[\"coords\"]\n    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n    r0, c0, r1, c1 = map(int, template[\"bbox\"])\n    h = int(bbox_h((r0, c0, r1, c1)))\n    w = int(bbox_w((r0, c0, r1, c1)))\n\n    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n\n    # Singleton layout points (excluding the template component).\n    singletons: list[tuple[int, int, int]] = []\n    for comp in comps:\n        if comp is template:\n            continue\n        if int(comp[\"area\"]) != 1:\n            continue\n        rr, cc = map(int, comp[\"coords\"][0])\n        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n\n    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n    assert not (len(origin) != 1)\n    orr, orc = origin[0]\n\n    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n    assert not (not other_cols)\n    overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n\n    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n    assert gcd_vals\n    gunit = int(math.gcd(*gcd_vals))\n    gunit = max(1, int(gunit))\n    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n\n    total = np.zeros((H, W), dtype=int)\n    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n\n    for dr, dc, col in deltas:\n        off_r = int(dr * h)\n        off_c = int(dc * w)\n        is_origin = int(col) == int(templ_col)\n        for rr, cc in templ_rel:\n            R = int(r0 + off_r + rr)\n            C = int(c0 + off_c + cc)\n            if 0 <= R < H and 0 <= C < W:\n                total[R, C] += 1\n                if is_origin:\n                    center[R, C] += 1\n\n    out = np.full((H, W), int(bg), dtype=int)\n    out[total > 0] = int(templ_col)\n    out[(total == 1) & (center > 0)] = int(overlap_col)\n    out[total >= 2] = int(overlap_col)\n    return out\n\n# --------------- generator (a1) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────\nGRID_SIZE = 22\nTEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\nTEMPLATE_W = 3                    # template bbox width (fixed)\nTEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\nTEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\nSINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\nLATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\nGUNIT = 2                         # singleton spacing in pixels\n\n# Retry budgets\nSPANNING_RETRIES = 40             # attempts per spanning polyomino\nTEMPLATE_RETRIES = 60             # attempts to build a valid template\nSINGLETON_RETRIES = 50            # attempts to place singleton cluster\nGENERATE_RETRIES = 300            # outer retry loop\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\nFILE:/home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\nFILE:/home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mirror the smallest non-axis foreground color across the full straight axis.\n\n    Input structure\n    - The background is the dominant color.\n    - One foreground color forms exactly one full row, column, main diagonal, or anti-diagonal reflection axis.\n    - The remaining foreground colors include a unique least-populated color to copy.\n\n    Rule\n    - Preserve the input grid.\n    - Select every pixel of the unique smallest non-axis foreground color.\n    - Reflect those pixels across the full straight axis and paint the reflected positions with the same color.\n\n    Key insight\n    - The axis color marks the mirror line, while the color population chooses which set of objects is duplicated.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    axis = _find_reflection_axis(g, bg)\n    axis_color = axis[0]\n    mirror_color = _smallest_non_axis_color(g, bg, axis_color)\n\n    out = g.copy()\n    h, w = g.shape\n    for r_raw, c_raw in np.argwhere(g == mirror_color):\n        r = int(r_raw)\n        c = int(c_raw)\n        rr, cc = _reflect(axis, g.shape, r, c)\n        assert 0 <= rr < h and 0 <= cc < w, \"reflected pixel must stay inside the grid\"\n        assert int(out[rr, cc]) in {bg, mirror_color}, \"reflection cannot overwrite another foreground object\"\n        out[rr, cc] = mirror_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and axis options.\n_GEN_GRID_SIZE_RANGE = (9, 17)\n_GEN_ODD_GRID_SIZES = [9, 11, 13, 15, 17]\n_GEN_AXIS_KINDS = [\"row\", \"col\", \"main_diag\", \"anti_diag\"]\n_GEN_CENTER_AXIS_KINDS = {\"row\", \"col\"}\n_GEN_SIDE_COUNT = 2\n# Foreground component size and count bounds.\n_GEN_COMPONENT_COUNT_RANGE = range(1, 4)\n_GEN_MIRROR_TOTAL_RANGE = (4, 12)\n_GEN_MIRROR_COMPONENT_SIZE_RANGE = (2, 7)\n_GEN_NONMIRROR_TOTAL_RANGE = (5, 17)\n_GEN_NONMIRROR_COMPONENT_SIZE_RANGE = (3, 9)\n_GEN_MIN_NONMIRROR_RATIO = (5, 4)\n_GEN_MAX_NONMIRROR_MULTIPLIER = 2\n# Search and geometry primitives.\n_GEN_RETRY_LIMIT = 300\n_GEN_COLORS = list(range(10))\n_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\nFILE:/home/lixinyu/snap/new/ARC_code/train/b1986d4b.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Render the filled-square object counts as compact nested stacks ordered by count rank.\n\n    Input structure\n    A large noisy grid has a dominant background, scattered non-square noise, and\n    filled monochrome square objects. Each square side length has exactly one\n    object color, and side lengths form consecutive sizes.\n\n    Rule\n    Ignore non-square components. If the lowest square in the scene is of the\n    smallest side length, treat that one smallest square as a distractor and do\n    not count it. For count rank k from left to right, create one block from all\n    square sizes with at least k remaining objects; draw larger squares first and\n    smaller squares over their upper-left corner, then append one background\n    separator column.\n\n    Key insight\n    The output is a count histogram of square side lengths, but each histogram\n    slot is rendered as nested upper-left square masks using the side colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    objects = _square_objects(g, bg)\n    assert objects, \"expected filled square objects\"\n\n    sides = sorted({obj[\"side\"] for obj in objects})\n    assert sides == list(range(sides[0], sides[-1] + 1)), \"expected consecutive square side lengths\"\n\n    by_side = {side: [obj for obj in objects if obj[\"side\"] == side] for side in sides}\n    colors = {}\n    for side, side_objects in by_side.items():\n        side_colors = {obj[\"color\"] for obj in side_objects}\n        assert len(side_colors) == 1, \"each side length should have one color\"\n        colors[side] = side_colors.pop()\n\n    smallest = sides[0]\n    lowest_row = max(obj[\"bbox\"][2] for obj in objects)\n    lowest_smallest = [obj for obj in by_side[smallest] if obj[\"bbox\"][2] == lowest_row]\n    if lowest_smallest:\n        assert len(lowest_smallest) == 1, \"expected at most one lowest smallest distractor\"\n        drop_bbox = lowest_smallest[0][\"bbox\"]\n        by_side[smallest] = [obj for obj in by_side[smallest] if obj[\"bbox\"] != drop_bbox]\n\n    counts = {side: len(side_objects) for side, side_objects in by_side.items()}\n    assert all(count > 0 for count in counts.values()), \"each square size should remain represented\"\n\n    out_h = sides[-1] + 1\n    groups = []\n    for rank in range(max(counts.values())):\n        present_sides = [side for side in sides if counts[side] > rank]\n        assert present_sides, \"rank should contain at least one square size\"\n\n        group_w = max(present_sides)\n        group = np.full((out_h, group_w), bg, dtype=int)\n        for side in sorted(present_sides, reverse=True):\n            group[:side, :side] = colors[side]\n        groups.append(group)\n\n    out_w = sum(group.shape[1] + 1 for group in groups)\n    out = np.full((out_h, out_w), bg, dtype=int)\n    c = 0\n    for group in groups:\n        w = group.shape[1]\n        out[:, c : c + w] = group\n        c += w + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nSIDES = [2, 3, 4]\nALL_COLORS = list(range(10))\n\n# Canvas and object bounds.\nGRID_SIZE_RANGE = (25, 28)\nCOUNT_RANGE = (2, 6)\nSQUARE_GAP = 1\n\n# Noise and distractor controls.\nDISTRACTOR_PROB = 0.5\nNOISE_COUNT_RANGE = (40, 70)\n\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\nFILE:/home/lixinyu/snap/new/ARC_code/eval/b0039139.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor a cropped template and repeat it according to a component-count stencil.\n\n    Input structure:\n    - Solid blue (1) separator rows or columns split the grid into four sections.\n    - Section 1 is a black-background shape template; section 2 is a component-count stencil.\n    - Sections 3 and 4 are solid color swatches for output foreground and background.\n\n    Rule:\n    - Crop section 1 to the bbox of its non-black pixels and recolor it with the two swatches.\n    - Count 4-connected non-black components in section 2.\n    - Repeat the recolored crop that many times, inserting one background-colored row/column between copies.\n\n    Key insight: The second section encodes only the repeat count; the output orientation\n    is inherited from whether the input separators are columns or rows.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    orientation, sections = _split_sections(g)\n    template, repetition_pattern, foreground_block, background_block = sections[:4]\n\n    template_mask = template != 0\n    template_bbox = bbox(template_mask)\n    if template_bbox is None:\n        return np.empty((0, 0), dtype=int)\n\n    foreground = _solid_color(foreground_block)\n    background = _solid_color(background_block)\n    tile_mask = crop_bbox(template_mask, template_bbox)\n    tile = np.where(tile_mask, foreground, background).astype(int)\n\n    n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))\n    if n_repeats <= 1:\n        return tile\n\n    if orientation == \"horizontal\":\n        sep = np.full((tile.shape[0], 1), background, dtype=int)\n        pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n        return np.hstack(pieces)\n\n    sep = np.full((1, tile.shape[1]), background, dtype=int)\n    pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n    return np.vstack(pieces)\n\n# --------------- generator (c) ---------------\n\n# --- CFG: tunable generation parameters ---\nREPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)\nCROP_SIZE_RANGE = (2, 5)             # crop height/width bounds\nDENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box\nCOLOR_POOL = list(range(2, 10))      # fg/bg color choices (2-9 inclusive)\nTEMPLATE_COLOR = 4                   # shape drawn in yellow inside template\nSTENCIL_COLOR = 3                    # blob color in stencil section\nSEPARATOR_COLOR = 1                  # blue separator rows/cols\nSWATCH_DIM_RANGE = (3, 8)           # varying-axis size for color swatches\nSTENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size\nBLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil\nGEN_RETRIES = 300                    # outer generate_input retry limit\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\nFILE:/home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\nFILE:/home/lixinyu/snap/new/ARC_code/train/dce56571.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Straighten the single foreground mask into a centered horizontal segment of the same color and length.\n\n    Input structure:\n    - The grid has one dominant background color.\n    - All non-background pixels share one foreground color.\n    - The number of foreground pixels fits in one centered row of the grid.\n\n    Rule:\n    - Erase the original foreground mask.\n    - Count its pixels, keep its color, and paint that many pixels as a horizontal segment.\n    - Place the segment on the middle row with equal background margin on the left and right.\n\n    Key insight:\n    - The original foreground shape is irrelevant except for its color and area; the output is the area normalized into the grid's central horizontal line.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n\n    color = fg_colors[0]\n    count = int(np.count_nonzero(g == color))\n    assert 0 < count <= width, \"foreground pixels must fit in one row\"\n    assert height % 2 == 1, \"expected a unique middle row\"\n    assert (width - count) % 2 == 0, \"foreground segment must center with equal side margins\"\n\n    out = np.full(g.shape, bg, dtype=int)\n    row = height // 2\n    start = (width - count) // 2\n    out[row, start : start + count] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas, palette, and foreground-count controls.\nHEIGHT_MIN, HEIGHT_MAX, HEIGHT_STEP = 5, 11, 2\nWIDTH_MIN, WIDTH_MAX = 10, 28\nBACKGROUND_COLOR = 8\nFOREGROUND_COLORS = tuple(c for c in range(10) if c != BACKGROUND_COLOR)\nCOUNT_MIN, COUNT_MAX = 6, 15\n# Sparse bbox shape, blob growth, and retry controls.\nBBOX_SPAN_MIN, BBOX_SPAN_MAX = 3, 8\nBBOX_FILL_MIN, BBOX_FILL_MAX = 0.29, 0.67\nCOVER_PATTERN_COUNT = 3\nADJACENT_GROW_PROB = 0.85\nGENERATION_ATTEMPTS = 300\n\n\ndef generate_input():\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n","exit_code":0,"status":"completed"}}
