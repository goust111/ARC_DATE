{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/8/2.py')\nmod = SourceFileLoader('new_arc_task_extra', str(p)).load_module()\n\ndef first_seen_colors(grid, excluded):\n    seen = set()\n    out = []\n    for v in grid.ravel():\n        v = int(v)\n        if v in (0, excluded) or v in seen:\n            continue\n        seen.add(v)\n        out.append(v)\n    return out\n\nhas_overlap = 0\nno_overlap = 0\nfor _ in range(100):\n    g = mod.generate_input()\n    body = g[:-1]\n    excluded = int(g[-1, 0])\n    rects = []\n    for color in first_seen_colors(body, excluded):\n        coords = np.argwhere(body == color)\n        r0 = int(coords[:, 0].min())\n        c0 = int(coords[:, 1].min())\n        r1 = int(coords[:, 0].max())\n        c1 = int(coords[:, 1].max())\n        rects.append((r0, c0, r1, c1))\n    overlap = False\n    for i in range(len(rects)):\n        a = mod._border_cells(rects[i])\n        for j in range(i + 1, len(rects)):\n            if a & mod._border_cells(rects[j]):\n                overlap = True\n                break\n        if overlap:\n            break\n    if overlap:\n        has_overlap += 1\n    else:\n        no_overlap += 1\nprint('overlap', has_overlap, 'no_overlap', no_overlap)\nassert has_overlap > 0 and no_overlap > 0\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/8/2.py')\nmod = SourceFileLoader('new_arc_task_extra', str(p)).load_module()\n\ndef first_seen_colors(grid, excluded):\n    seen = set()\n    out = []\n    for v in grid.ravel():\n        v = int(v)\n        if v in (0, excluded) or v in seen:\n            continue\n        seen.add(v)\n        out.append(v)\n    return out\n\nhas_overlap = 0\nno_overlap = 0\nfor _ in range(100):\n    g = mod.generate_input()\n    body = g[:-1]\n    excluded = int(g[-1, 0])\n    rects = []\n    for color in first_seen_colors(body, excluded):\n        coords = np.argwhere(body == color)\n        r0 = int(coords[:, 0].min())\n        c0 = int(coords[:, 1].min())\n        r1 = int(coords[:, 0].max())\n        c1 = int(coords[:, 1].max())\n        rects.append((r0, c0, r1, c1))\n    overlap = False\n    for i in range(len(rects)):\n        a = mod._border_cells(rects[i])\n        for j in range(i + 1, len(rects)):\n            if a & mod._border_cells(rects[j]):\n                overlap = True\n                break\n        if overlap:\n            break\n    if overlap:\n        has_overlap += 1\n    else:\n        no_overlap += 1\nprint('overlap', has_overlap, 'no_overlap', no_overlap)\nassert has_overlap > 0 and no_overlap > 0\nPY\"","aggregated_output":"overlap 45 no_overlap 55\n","exit_code":0,"status":"completed"}}
