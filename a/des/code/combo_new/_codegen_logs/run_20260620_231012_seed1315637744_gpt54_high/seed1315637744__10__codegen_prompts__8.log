{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/2e65ae53.py',\n'/home/lixinyu/snap/new/ARC_code/train/57edb29d.py',\n'/home/lixinyu/snap/new/ARC_code/train/84551f4c.py',\n]\nfor path in files:\n    print(f'=== {path} ===')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        snippet = text[idx:end].rstrip()\n        print(snippet)\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/2e65ae53.py',\n'/home/lixinyu/snap/new/ARC_code/train/57edb29d.py',\n'/home/lixinyu/snap/new/ARC_code/train/84551f4c.py',\n]\nfor path in files:\n    print(f'=== {path} ===')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        snippet = text[idx:end].rstrip()\n        print(snippet)\n        print()\nPY\"","aggregated_output":"=== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill every lattice slot from the color assigned to that slot position by the other lattices.\n\n    Input structure:\n    - The background is the dominant color.\n    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.\n    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.\n\n    Rule:\n    - Infer a color for each logical slot position from the colored slots across all lattice frames.\n    - Repaint every slot interior in every lattice with the inferred color for its row/column position.\n    - Keep the frame lines and all background outside frames unchanged.\n\n    Key insight:\n    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color = _dominant_foreground_color(g, bg)\n    frames = _parse_frames(g, bg, frame_color)\n    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)\n\n    out = g.copy()\n    for rows, cols in frames:\n        for sr in range(len(rows) - 1):\n            for sc in range(len(cols) - 1):\n                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[\n                    (sr, sc)\n                ]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette choices.\nBG = 0\nGRID_SIZE_RANGE = (22, 28)\nNEAR_SQUARE_PROB = 0.65\nNEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]\nFOREGROUND_COLORS = range(1, 10)\nPALETTE_SIZE = 5\n\n# Lattice geometry.\nSLOT_SIZE_RANGE = (1, 8)\nFRAME_HEIGHT_RANGE = (5, 18)\nFRAME_WIDTH_RANGE = (5, 14)\nLATTICE_LINE_COUNT = 3\nSLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# Frame count and area allocation.\nFRAME_COUNT_RANGE = (4, 6)\nMIN_FRAME_AREA = 25\nAREA_BUDGET_RANGE = (0.55, 0.88)\nAREA_WEIGHT_SCALE = 35.0\n\n# Placement and retry limits.\nEDGE_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\nFrameSpec = tuple[tuple[int, int], tuple[int, int]]\nPlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]\nSlotColors = dict[tuple[int, int], int]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2e65ae53 input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/57edb29d.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/84551f4c.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/9b5080bb.py',\n'/home/lixinyu/snap/new/ARC_code/train/bc93ec48.py',\n'/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py',\n'/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py',\n]\nfor path in files:\n    print(f'=== {path} ===')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        snippet = text[idx:end].rstrip()\n        print(snippet)\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/train/9b5080bb.py',\n'/home/lixinyu/snap/new/ARC_code/train/bc93ec48.py',\n'/home/lixinyu/snap/new/ARC_code/eval/edb79dae.py',\n'/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py',\n]\nfor path in files:\n    print(f'=== {path} ===')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        snippet = text[idx:end].rstrip()\n        print(snippet)\n        print()\nPY\"","aggregated_output":"=== /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATE_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid bc93ec48 input\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n    raise RuntimeError(\"failed to generate valid edb79dae input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py ===\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n\n    Input structure\n    - The grid is made from three or more equal panels in one row or one column.\n    - The final input panel is the static target template; every earlier panel differs from it only by dynamic colors absent from the template.\n    - Each dynamic color appears in a regular temporal schedule across the earlier panels.\n\n    Rule\n    - Keep the final template panel as the output canvas.\n    - For every dynamic color whose schedule reaches the next panel, compare its last two appearances.\n    - Extrapolate each one-dimensional interval along the color's changing row or column axis and paint that predicted mask.\n\n    Key insight\n    - The task is not asking for the last visible panel, but for the next frame after the blank/template slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    panels, diff_colors = _split_panels(g)\n    template = panels[-1]\n    prior = panels[:-1]\n    next_time = len(prior)\n\n    predictions: list[tuple[int, np.ndarray]] = []\n    for color in diff_colors:\n        times = [i for i, panel in enumerate(prior) if np.any(panel == color)]\n        assert len(times) >= 2\n        gaps = [b - a for a, b in zip(times, times[1:])]\n        assert len(set(gaps)) == 1\n        period = gaps[0]\n        if next_time - times[-1] != period:\n            continue\n\n        previous = prior[times[-2]] == color\n        current = prior[times[-1]] == color\n        predictions.append((color, _extrapolate_mask(previous, current)))\n\n    assert predictions\n    occupied = np.zeros_like(template, dtype=bool)\n    for _color, mask in predictions:\n        assert not np.any(occupied & mask)\n        occupied |= mask\n\n    out = template.copy()\n    for color, mask in predictions:\n        out[mask] = color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, orientation, and color sampling.\nPANEL_SIZE_MIN, PANEL_SIZE_MAX = 5, 11\nPANEL_COUNT_CHOICES, ORIENTATION_CHOICES = (3, 5), (False, True)\nCOLOR_POOL, TOTAL_COLOR_CHOICES, MOTION_AXIS_CHOICES = range(10), (4, 5), (0, 1)\n\n# Template decoration density and symmetry.\nTEMPLATE_MIN_DECO_CELLS = 4\nTEMPLATE_DECO_MIN_RATIO, TEMPLATE_DECO_MAX_RATIO = 0.10, 0.30\n\n# Blob motif and growth bounds.\nBLOB_GROWTH_MIN, BLOB_GROWTH_MAX = 1, 4\nBLOB_MAX_INITIAL_CELLS, BLOB_MAX_COMPONENTS = 7, 2\nBLOB_MAX_LINE_COUNT, BLOB_MAX_WIDTH = 3, 3\nBLOB_DIRECTIONS = (-1, 1)\n\n# Dynamic-color schedules.\nSHORT_PRIOR_COUNT, MAX_DYNAMIC_COLORS = 2, 3\nSCHEDULE_ALWAYS_2 = {\"period\": 1, \"times\": [0, 1], \"scheduled\": True}\nSCHEDULE_ALWAYS_4 = {\"period\": 1, \"times\": [0, 1, 2, 3], \"scheduled\": True}\nSCHEDULE_EVEN_4 = {\"period\": 2, \"times\": [0, 2], \"scheduled\": True}\nSCHEDULE_FIRST3_4 = {\"period\": 1, \"times\": [0, 1, 2], \"scheduled\": False}\nSCHEDULE_ODD_4 = {\"period\": 2, \"times\": [1, 3], \"scheduled\": False}\nSCHEDULE_SECOND_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4)\nSCHEDULE_THIRD_CHOICES = (SCHEDULE_ALWAYS_4, SCHEDULE_EVEN_4, SCHEDULE_FIRST3_4, SCHEDULE_ODD_4)\n\n# Placement and retry limits.\nMASK_TRANSPARENT, PLACEMENT_BORDER = 0, 1\nGENERATION_RETRIES = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n","exit_code":0,"status":"completed"}}
