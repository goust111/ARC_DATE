\n0184: def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n0185:     \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n0186:     if n * min_gap > max_total:\n0187:         return None\n0188:     gaps = [min_gap] * n\n0189:     remaining = max_total - sum(gaps)\n0190:     for i in range(n):\n0191:         extra = min(max_gap - gaps[i], remaining)\n0192:         if extra > 0:\n0193:             add = random.randint(0, extra)\n0194:             gaps[i] += add\n0195:             remaining -= add\n0196:     random.shuffle(gaps)\n0197:     return gaps\n0198: \n0199: \n0200: def _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n0201:     \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n0202:     if target_rooms == 1:\n0203:         gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n0204:         gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n0205:         h, w = gap_h + 2, gap_w + 2\n0206:         walls = np.zeros((h, w), dtype=bool)\n0207:         walls[0, :] = True\n0208:         walls[h - 1, :] = True\n0209:         walls[:, 0] = True\n0210:         walls[:, w - 1] = True\n0211:         return walls\n0212: \n0213:     # For target_rooms >= 2: grid of cells, then selectively merge\n0214:     possible_configs = []\n0215:     for nv in range(2, 6):\n0216:         for nh in range(2, 5):\n0217:             cells = (nv - 1) * (nh - 1)\n0218:             if target_rooms <= cells <= target_rooms + 4:\n0219:                 possible_configs.append((nv, nh, cells))\n0220:     if not possible_configs:\n0221:         for nv in range(2, 7):\n0222:             for nh in range(2, 6):\n0223:                 cells = (nv - 1) * (nh - 1)\n0224:                 if cells >= target_rooms:\n0225:                     possible_configs.append((nv, nh, cells))\n0226:     if not possible_configs:\n0227:         return None\n0228: \n0229:     n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n0230:     n_row_gaps = n_hrows - 1\n0231:     n_col_gaps = n_vcols - 1\n0232:     min_gap, max_gap = _CELL_GAP_RANGE\n0233: \n0234:     if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n0235:         return None\n0236: \n0237:     row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n0238:     col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n---\n0475: def generate_input() -> np.ndarray:\n0476:     for _ in range(_GEN_RETRIES):\n0477:         result = _gen_attempt()\n0478:         if result is not None:\n0479:             return result\n0480:     raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n---\n====\n","exit_code":0,"status":"completed"}}
