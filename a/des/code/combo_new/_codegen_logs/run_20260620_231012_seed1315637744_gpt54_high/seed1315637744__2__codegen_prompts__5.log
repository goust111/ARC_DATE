X = 6\n0103: COLOR_COUNT = 10\n0104: MIN_TARGET_COLORS = 3\n0105: MAX_NON_BG_COLORS = COLOR_COUNT - 1\n0106: # Layout probabilities and constraints.\n0107: PREFERRED_GRID_HALF = (2, 2)\n0108: PREFERRED_GRID_PROB = 0.65\n0109: QUADRANT_COUNT = 4\n0110: SEPARATOR_WIDTH = 1\n0111: BG_DOMINANCE_MARGIN = 1\n0112: # Retry limit.\n0113: MAX_GENERATION_ATTEMPTS = 300\n0114: \n0115: def _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n0116:     if parts <= 0 or total < parts or total > parts * max_each:\n0117:         return None\n0118: \n0119:     counts = []\n0120:     remaining = total\n0121:     for i in range(parts):\n0122:         slots_left = parts - i - 1\n0123:         lo = max(1, remaining - slots_left * max_each)\n0124:         hi = min(max_each, remaining - slots_left)\n0125:         counts.append(random.randint(lo, hi))\n0126:         remaining -= counts[-1]\n0127: \n0128:     random.shuffle(counts)\n0129:     return counts\n0130: \n0131: \n0132: def _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n0133:     options = []\n0134:     for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n0135:         for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n0136:             area = k * m\n0137:             bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n0138:             max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n0139:             max_colors = min(MAX_NON_BG_COLORS, area)\n0140:             valid_counts = [\n0141:                 c\n0142:                 for c in range(MIN_TARGET_COLORS, max_colors + 1)\n0143:                 if area <= c * max_target_count\n0144:             ]\n0145:             if valid_counts:\n0146:                 options.append((k, m, valid_counts, max_target_count))\n0147:     return options\n0148: \n0149: \n0150: def _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n0151:     options = _gen_grid_options()\n0152:     if random.random() < PREFERRED_G