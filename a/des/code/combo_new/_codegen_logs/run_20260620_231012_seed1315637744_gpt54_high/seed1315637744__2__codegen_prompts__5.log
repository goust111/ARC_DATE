{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/6a980be1.py',\n'/home/lixinyu/snap/new/ARC_code/train/db615bd4.py',\n]\nfor path in files:\n    text = Path(path).read_text().splitlines()\n    print(f'FILE {path}')\n    starts = []\n    for i,l in enumerate(text):\n        if l.startswith('def main(') or l.startswith('def generate_input('):\n            starts.append(i)\n    starts.append(len(text))\n    for j in range(len(starts)-1):\n        s,e = starts[j], starts[j+1]\n        if not (text[s].startswith('def main(') or text[s].startswith('def generate_input(')):\n            continue\n        end = min(e, s+120)\n        for k in range(s, end):\n            print(f'{k+1:04d}: {text[k]}')\n        print('---')\n    print('====')\nPY\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\n0007: def main(grid: np.ndarray) -> np.ndarray:\n0008:     \"\"\"\n0009:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n0010: \n0011:     Input structure:\n0012:     - bg = most common color.\n0013:     - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n0014:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n0015: \n0016:     Rule:\n0017:     - Match each sprite to the border anchor sharing its marker color.\n0018:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n0019:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n0020: \n0021:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n0022:     \"\"\"\n0023:     g = np.array(grid, dtype=int)\n0024:     H, W = g.shape\n0025:     bg = int(get_bg(g))\n0026: \n0027:     def is_border(r: int, c: int) -> bool:\n0028:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n0029: \n0030:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n0031:     anchors_by_color: dict[int, tuple[int, int]] = {}\n0032:     for r in range(H):\n0033:         for c in range(W):\n0034:             if not is_border(r, c):\n0035:                 continue\n0036:             v = int(g[r, c])\n0037:             if v == int(bg):\n0038:                 continue\n0039:             ok = True\n0040:             for rr, cc in neighbors4(int(r), int(c)):\n0041:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n0042:                     ok = False\n0043:                     break\n0044:             if ok and v not in anchors_by_color:\n0045:                 anchors_by_color[int(v)] = (int(r), int(c))\n0046: \n0047:     assert not (not anchors_by_color)\n0048: \n0049:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n0050: \n0051:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n0052:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n0053: \n0054:     def component_marker_color(coords: np.ndarray) -> int | None:\n0055:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n0056:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n0057:         cnt = Counter(vals)\n0058:         if len(cnt) <= 1:\n0059:             return None\n0060:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n0061: \n0062:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n0063:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n0064:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n0065:         if not pts:\n0066:             return None\n0067:         if len(pts) == 1:\n0068:             return pts[0]\n0069:         S = {(int(r), int(c)) for r, c in coords}\n0070:         for r, c in pts:\n0071:             for rr, cc in neighbors4(int(r), int(c)):\n0072:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n0073:                     return (int(r), int(c))\n0074:         return pts[0]\n0075: \n0076:     moves: list[tuple[np.ndarray, int, int]] = []\n0077: \n0078:     for comp in comps:\n0079:         coords = comp[\"coords\"]\n0080:         if coords.size == 0:\n0081:             continue\n0082: \n0083:         # --- STEP 3) Decide marker color for this component. ---\n0084:         marker_col = component_marker_color(coords)\n0085:         if marker_col is None:\n0086:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n0087:             if int(coords.shape[0]) != 1:\n0088:                 continue\n0089:             r, c = map(int, coords[0])\n0090:             v = int(g[r, c])\n0091:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n0092:                 continue\n0093:             marker_col = int(v)\n0094: \n0095:         if int(marker_col) not in anchors_by_color:\n0096:             continue\n0097: \n0098:         mp = marker_pixel(coords, int(marker_col))\n0099:         if mp is None:\n0100:             continue\n0101: \n0102:         ar, ac = anchors_by_color[int(marker_col)]\n0103: \n0104:         # --- STEP 4) Compute translation (dr,dc). ---\n0105:         on_top_bottom = int(ar) in (0, int(H - 1))\n0106:         on_left_right = int(ac) in (0, int(W - 1))\n0107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n0108: \n0109:         dr = 0\n0110:         dc = 0\n0111:         if horizontal:\n0112:             dc = int(ac - mp[1])\n0113:         else:\n0114:             dr = int(ar - mp[0])\n0115: \n0116:         moves.append((coords, int(dr), int(dc)))\n0117: \n0118:     out = g.copy()\n0119: \n0120:     # --- STEP 5) Apply all moves. ---\n0121:     # Clear moved components first (prevents collisions with their original locations).\n0122:     for coords, _dr, _dc in moves:\n0123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n0124: \n0125:     # Paste moved components:\n0126:     # - clip out-of-bounds pixels\n---\n0582: def generate_input() -> np.ndarray:\n0583:     for _ in range(_GEN_RETRY_LIMIT):\n0584:         grid = _gen_attempt()\n0585:         if grid is not None:\n0586:             return grid\n0587:     raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n---\n====\nFILE /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\n0101: def main(grid: np.ndarray) -> np.ndarray:\n0102:     \"\"\"\n0103:     Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n0104: \n0105:     Input structure:\n0106:     - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n0107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n0108: \n0109:     Rule:\n0110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.\n0111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.\n0112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.\n0113: \n0114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n0115:     \"\"\"\n0116:     g = np.asarray(grid, dtype=int)\n0117:     h, w = g.shape\n0118:     bg = get_bg(g)\n0119: \n0120:     mover = 4  # yellow in ARC\n0121:     dirs = _legend_directions(g, bg)\n0122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n0123: \n0124:     passable = (g == bg) | (g == mover)\n0125:     out = g.copy()\n0126: \n0127:     # Find enclosed passable regions (not connected to the outer border).\n0128:     for pts in components_mask(passable, connectivity=4):\n0129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n0130:             continue  # outside background\n0131: \n0132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n0133:         if not movers:\n0134:             continue\n0135: \n0136:         # Determine this region's border color by counting adjacent wall colors.\n0137:         border_counts: dict[int, int] = {}\n0138:         pset = {(int(r), int(c)) for r, c in pts}\n0139:         for r, c in pts:\n0140:             for nr, nc in neighbors4(r, c):\n0141:                 if not (0 <= nr < h and 0 <= nc < w):\n0142:                     continue\n0143:                 if (nr, nc) in pset:\n0144:                     continue\n0145:                 v = int(g[nr, nc])\n0146:                 if v == bg or v == mover:\n0147:                     continue\n0148:                 border_counts[v] = border_counts.get(v, 0) + 1\n0149:         if not border_counts:\n0150:             continue\n0151:         border_col = max(border_counts, key=border_counts.get)\n0152:         if border_col not in dirs:\n0153:             continue\n0154:         dr, dc = dirs[border_col]\n0155: \n0156:         # Clear old movers.\n0157:         for r, c in movers:\n0158:             out[r, c] = bg\n0159: \n0160:         # Slide and repaint.\n0161:         new_pts = _slide_points(pset, movers, dr, dc)\n0162:         for r, c in new_pts:\n0163:             out[r, c] = mover\n0164: \n0165:     return out\n0166: \n0167: # --------------- generator (claude-att1) ---------------\n0168: \n0169: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n0170: import random\n0171: import numpy as np\n0172: \n0173: from arc_utils import label_mask, neighbors4, paste\n0174: \n0175: # ── Configuration ─────────────────────────────────────────────────\n0176: GRID_H, GRID_W = 20, 20\n0177: \n0178: # Legend\n0179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n0180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n0181: CORNERS = ['TL', 'TR', 'BL', 'BR']\n0182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n0183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n0184: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n0185: \n0186: # Regions\n0187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n0188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n0189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n0190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n0191: }\n0192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n0193: \n0194: # Yellows\n0195: YELLOWS_PER_REGION = [1, 2]                # choices per region\n0196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n0197: \n0198: # Outer loop\n0199: GEN_RETRIES = 300                          # max attempts in generate_input()\n0200: \n0201: \n0202: # ── Legend patches ────────────────────────────────────────────────\n0203: \n0204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n0205:     \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n0206:     g = np.full((5, 5), fill, dtype=int)\n0207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n0208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n0209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n0210:     return np.rot90(g, rot[(dr, dc)])\n0211: \n0212: \n0213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n0214:     \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n0215:     g = np.full((6, 7), fill, dtype=int)\n0216:     g[1, 3] = 1\n0217:     g[2, 1] = 1; g[2, 4] = 1\n0218:     g[3, 2] = 1; g[3, 5] = 2\n0219:     g[4, 3] = 2\n0220:     if (dr, dc) == (1, 1): return g\n---\n0604: def generate_input() -> np.ndarray:\n0605:     rng = random.Random()\n0606:     for _ in range(GEN_RETRIES):\n0607:         try:\n0608:             g = _gen_attempt(rng)\n0609:         except Exception:\n0610:             continue\n0611:         if g is not None:\n0612:             return g\n0613:     raise RuntimeError(\"generate_input: exceeded retries\")\n---\n====\nFILE /home/lixinyu/snap/new/ARC_code/train/6a980be1.py\n0045: def main(grid: np.ndarray) -> np.ndarray:\n0046:     \"\"\"\n0047:     Project the framed periodic stripe pattern across the canvas and erase the unused frame cells.\n0048: \n0049:     Input structure\n0050:     - A bg canvas with a one-cell-thick rectangular frame of one color.\n0051:     - Inside the frame are two parallel full-interior marker bars of another color.\n0052:     - A third color fills the region between the marker bars on periodically spaced rows or columns.\n0053: \n0054:     Rule\n0055:     - Infer the periodic row or column mask from the third-color stripes inside the frame.\n0056:     - Paint the frame color along those full rows or columns, extended to the grid boundary.\n0057:     - Extend the marker bars across the full canvas and repaint the source-color stripe cells between them.\n0058: \n0059:     Key insight\n0060:     - The outer frame is not preserved as a border; it supplies the color for the periodic stripes selected by the inner source pattern.\n0061:     \"\"\"\n0062:     g = np.asarray(grid, dtype=int)\n0063:     assert g.ndim == 2, \"expected a 2D grid\"\n0064:     h, w = g.shape\n0065:     assert h > 2 and w > 2, \"grid must have an interior\"\n0066: \n0067:     bg = get_bg(g)\n0068:     boundary = _boundary_values(g)\n0069:     frame_color = int(boundary[0])\n0070:     assert frame_color != bg, \"frame color must differ from background\"\n0071:     assert np.all(boundary == frame_color), \"input must have a uniform one-color boundary frame\"\n0072: \n0073:     fg_colors = colors_present(g, exclude={bg})\n0074:     assert len(fg_colors) == 3, \"expected frame, marker-bar, and source-stripe colors\"\n0075:     assert frame_color in fg_colors, \"boundary frame color must be foreground\"\n0076:     inner_colors = [color for color in fg_colors if color != frame_color]\n0077: \n0078:     bar_candidates: list[tuple[int, list[int], list[int]]] = []\n0079:     for color in inner_colors:\n0080:         rows = _full_inner_rows(g, color)\n0081:         cols = _full_inner_cols(g, color)\n0082:         if bool(rows) ^ bool(cols):\n0083:             bar_candidates.append((color, rows, cols))\n0084:     assert len(bar_candidates) == 1, \"marker-bar color must be structurally unique\"\n0085: \n0086:     bar_color, bar_rows, bar_cols = bar_candidates[0]\n0087:     source_colors = [color for color in inner_colors if color != bar_color]\n0088:     assert len(source_colors) == 1, \"source-stripe color must be unique\"\n0089:     source_color = source_colors[0]\n0090:     source_coords = np.argwhere(g == source_color)\n0091:     assert source_coords.size > 0, \"source stripes must be present\"\n0092: \n0093:     out = np.full_like(g, bg)\n0094:     if bar_cols:\n0095:         assert not bar_rows, \"marker bars must have one orientation\"\n0096:         assert len(bar_cols) == 2, \"expected two vertical marker bars\"\n0097:         source_cols = sorted({int(c) for _, c in source_coords})\n0098:         left, right = sorted(bar_cols)\n0099:         assert source_cols == list(range(left + 1, right)), \"source stripes must fill between marker bars\"\n0100: \n0101:         observed_rows = np.arange(1, h - 1)\n0102:         row_has_source = np.any(g[1 : h - 1, 1 : w - 1] == source_color, axis=1)\n0103:         selected_rows = _periodic_axis_mask(h, observed_rows, row_has_source)\n0104: \n0105:         out[selected_rows, :] = frame_color\n0106:         out[:, bar_cols] = bar_color\n0107:         out[np.ix_(selected_rows, source_cols)] = source_color\n0108:     else:\n0109:         assert bar_rows, \"marker bars must be present\"\n0110:         assert len(bar_rows) == 2, \"expected two horizontal marker bars\"\n0111:         source_rows = sorted({int(r) for r, _ in source_coords})\n0112:         top, bottom = sorted(bar_rows)\n0113:         assert source_rows == list(range(top + 1, bottom)), \"source stripes must fill between marker bars\"\n0114: \n0115:         observed_cols = np.arange(1, w - 1)\n0116:         col_has_source = np.any(g[1 : h - 1, 1 : w - 1] == source_color, axis=0)\n0117:         selected_cols = _periodic_axis_mask(w, observed_cols, col_has_source)\n0118: \n0119:         out[:, selected_cols] = frame_color\n0120:         out[bar_rows, :] = bar_color\n0121:         out[np.ix_(source_rows, selected_cols)] = source_color\n0122: \n0123:     return out\n0124: \n0125: # --------------- generator (att2) ---------------\n0126: \n0127: # Canvas dimensions, palette, and retry limit.\n0128: CANVAS_ROW_RANGE, CANVAS_COL_RANGE = (14, 19), (15, 19)\n0129: BACKGROUND_COLOR, BAR_COLOR, SOURCE_COLOR = 0, 3, 2\n0130: FRAME_COLORS = (1, 4, 5, 6, 7, 8, 9)\n0131: MAX_GENERATION_ATTEMPTS = 300\n0132: \n0133: # Pattern and bar placement constraints.\n0134: ORIENTATION_CHOICES = (False, True)\n0135: ON_COUNT_RANGE, OFF_COUNT_RANGE = (1, 4), (2, 3)\n0136: MAX_PERIOD = 6\n0137: PATTERN_START_INDEX, FRAME_WIDTH, BAR_THICKNESS = 1, 1, 1\n0138: \n0139: \n0140: def _periodic_mask(length: int, on_count: int, off_count: int) -> np.ndarray:\n0141:     period = on_count + off_count\n0142:     return ((np.arange(length) - PATTERN_STAR