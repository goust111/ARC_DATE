nto its contiguous\n0123:     two-step mask, and place the sprites inside the frame with equal gaps.\n0124:     Wide frames receive sprites left-to-right by source position; tall frames\n0125:     receive them top-to-bottom by source position.\n0126: \n0127:     Key insight\n0128:     The frame supplies ordered slots: the sprite-to-slot assignment is by visible\n0129:     source order, not by numeric color or by matching individual cells.\n0130:     \"\"\"\n0131:     g = np.asarray(grid, dtype=int)\n0132:     assert g.ndim == 2\n0133: \n0134:     bg = get_bg(g)\n0135:     counts = Counter(map(int, g.ravel()))\n0136:     non_bg = colors_present(g, exclude={bg})\n0137:     assert non_bg, \"expected foreground colors\"\n0138: \n0139:     max_non_bg_count = max(counts[c] for c in non_bg)\n0140:     lattice_candidates = [c for c in non_bg if counts[c] == max_non_bg_count]\n0141:     assert len(lattice_candidates) == 1, \"lattice color must be uniquely most frequent\"\n0142:     lattice_color = lattice_candidates[0]\n0143: \n0144:     special_colors = [c for c in non_bg if c != lattice_color]\n0145:     assert len(special_colors) >= 2, \"expected one frame and at least one sprite\"\n0146: \n0147:     coords_by_color = {c: np.argwhere(g == c) for c in special_colors}\n0148:     frame_candidates = []\n0149:     for color, coords in coords_by_color.items():\n0150:         if _is_sparse_rect_perimeter(coords):\n0151:             frame_candidates.append((color, bbox_coords(coords)))\n0152:     assert frame_candidates, \"expected a sparse rectangular frame\"\n0153: \n0154:     max_area = max(_bbox_area(b) for _color, b in frame_candidates)\n0155:     largest_frames = [(color, b) for color, b in frame_candidates if _bbox_area(b) == max_area]\n0156:     assert len(largest_frames) == 1, \"frame must be the unique largest sparse perimeter\"\n0157:     frame_color, frame_bbox = largest_frames[0]\n0158: \n0159:     source_colors = [c for c in special_colors if c != frame_color]\n0160