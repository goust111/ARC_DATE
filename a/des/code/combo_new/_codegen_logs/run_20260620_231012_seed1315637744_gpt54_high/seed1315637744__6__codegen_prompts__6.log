{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, neighbors4, random_sprite\nfrom scipy.ndimage import label as _scipy_label\nimport random\n\n\ndef _find_border6_square_start(legend: np.ndarray) -> tuple[int, int] | None:\n    h, w = legend.shape\n    if h < 5 or w < 5:\n        return None\n    for r0 in range(h - 4):\n        for c0 in range(w - 4):\n            sub = legend[r0 : r0 + 5, c0 : c0 + 5]\n            if np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6):\n                return int(r0), int(c0)\n    return None\n\n\ndef _find_marker_panel_square(g: np.ndarray, sep_c1: int) -> tuple[int, int] | None:\n    \"\"\"\n    Find the 5x5 border-6 position-marker square that belongs to the 8x5 marker panel.\n\n    In some instances the marker panel can appear inside the main canvas as well as in the\n    left legend region. Prefer a candidate that lies in the main canvas (col > sep_c1) if any.\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            # Must contain a position marker inside (non-{0,6}) and a rotation mark below.\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    main_cands = [rc for rc in candidates if rc[1] > sep_c1]\n    return min(main_cands) if main_cands else min(candidates)\n\n\ndef _separator_runs(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return contiguous runs of full-height columns that are all color 6.\"\"\"\n    h, w = g.shape\n    cols6 = [c for c in range(w) if np.all(g[:, c] == 6)]\n    if not cols6:\n        return []\n    cols6.sort()\n    runs: list[tuple[int, int]] = []\n    s = e = cols6[0]\n    for c in cols6[1:]:\n        if c == e + 1:\n            e = c\n        else:\n            runs.append((s, e))\n            s = e = c\n    runs.append((s, e))\n    return runs\n\n\ndef _split_canvas(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int] | None]:\n    \"\"\"\n    Identify a left separator run (between left legend and canvas), and optionally a\n    right separator run (between canvas and a right-side legend panel).\n    \"\"\"\n    h, w = g.shape\n    runs = _separator_runs(g)\n    assert runs, \"must have at least one color-6 separator run\"\n    left = runs[0]\n    # Prefer a right separator run very near the right edge (a right legend panel).\n    right: tuple[int, int] | None = None\n    for s, e in reversed(runs[1:]):\n        if s >= w - 10 and s > left[1] + 1:\n            right = (s, e)\n            break\n    return left, right\n\n\ndef _find_marker_square_with_preferences(\n    g: np.ndarray, left_sep: tuple[int, int], right_sep: tuple[int, int] | None\n) -> tuple[int, int] | None:\n    \"\"\"\n    Find the marker panel's 5x5 border-6 square.\n\n    Preference order:\n      1) left legend region (at/before left separator)\n      2) right legend region (at/after right separator), if present\n      3) anywhere (including inside the output canvas)\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    left_end = left_sep[1]\n    left_cands = [rc for rc in candidates if rc[1] + 2 <= left_end]\n    if left_cands:\n        return min(left_cands)\n    if right_sep is not None:\n        right_start = right_sep[0]\n        right_cands = [rc for rc in candidates if rc[1] + 2 >= right_start]\n        if right_cands:\n            return min(right_cands)\n    return min(candidates)\n\n\ndef _all_marker_panel_squares(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"List all 5x5 border-6 squares that look like the top of an 8x5 marker panel.\"\"\"\n    h, w = g.shape\n    out: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            out.append((int(r0), int(c0)))\n    out.sort()\n    return out\n\n\ndef _extract_unit_sprite(legend: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    # Unit sprite is the top-most 4-connected component of pixels not in {0,6}.\n    mask = (legend != 0) & (legend != 6)\n    pts_all = np.argwhere(mask)\n    if pts_all.size == 0:\n        return None\n    rmin = int(pts_all[:, 0].min())\n    # choose left-most on that row to seed\n    cseed = int(np.argwhere(mask[rmin, :])[0, 0])\n    # BFS from seed to get component\n    h, w = legend.shape\n    vis = np.zeros((h, w), dtype=bool)\n    st = [(rmin, cseed)]\n    vis[rmin, cseed] = True\n    pts: list[tuple[int, int]] = []\n    while st:\n        r, c = st.pop()\n        pts.append((r, c))\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not vis[rr, cc]:\n                vis[rr, cc] = True\n                st.append((rr, cc))\n    r0, c0, r1, c1 = bbox_coords(np.asarray(pts))\n    spr = legend[r0 : r1 + 1, c0 : c1 + 1].copy()\n    # Unit sprite uses two colors; the rendered sprite is the color-swapped version.\n    cols = sorted({int(x) for x in np.unique(spr) if int(x) not in (0, 6)})\n    if len(cols) == 2:\n        a, b = cols\n        spr2 = spr.copy()\n        spr2[spr == a] = -1\n        spr2[spr == b] = a\n        spr2[spr2 == -1] = b\n        spr = spr2\n    return spr, (r0, c0, r1, c1)\n\n\ndef _extract_frame_bbox(legend: np.ndarray, unit_bb: tuple[int, int, int, int], border6_r0: int) -> tuple[int, int, int, int] | None:\n    # Frame pixels live between the unit sprite and the border6 square.\n    r_start = unit_bb[2] + 1\n    r_end = border6_r0 - 1\n    if r_start > r_end:\n        return None\n    sub = legend[r_start : r_end + 1, :]\n    mask = (sub != 0) & (sub != 6)\n    pts = np.argwhere(mask)\n    if pts.size == 0:\n        return None\n    pts[:, 0] += r_start\n    r0 = int(pts[:, 0].min())\n    r1 = int(pts[:, 0].max())\n    c0 = int(pts[:, 1].min())\n    c1 = int(pts[:, 1].max())\n    return (r0, c0, r1, c1)\n\n\ndef _position_indices_from_border_square(legend: np.ndarray, border6_r0: int, border6_c0: int) -> tuple[int, int] | None:\n    sq = legend[border6_r0 : border6_r0 + 5, border6_c0 : border6_c0 + 5]\n    inner = sq[1:4, 1:4]\n    pts = np.argwhere((inner != 0) & (inner != 6))\n    if pts.size == 0:\n        return None\n    # If multiple, take the first (should be unique)\n    r, c = int(pts[0, 0]), int(pts[0, 1])\n    return r, c  # 0..2\n\n\ndef _rotation_from_clockhand(legend: np.ndarray, border6_r0: int, border6_c0: int) -> int:\n    \"\"\"\n    Rotation marker is in the bottom 3x3 at rows (border6_r0+5 .. border6_r0+7) and cols (1..3),\n    drawn with non-{0,6} pixels (typically 7). Use the furthest pixel from the center (1,1)\n    to determine direction:\n      up -> 0, right -> 1, down -> 2, left -> 3.\n    \"\"\"\n    h, w = legend.shape\n    r0 = border6_r0 + 5\n    c0 = border6_c0 + 1\n    assert r0 + 2 < h and c0 + 2 < w, \"rotation marker patch out of bounds\"\n    sub = legend[r0 : r0 + 3, c0 : c0 + 3]\n    pts = np.argwhere((sub != 0) & (sub != 6))\n    assert pts.size > 0, \"no rotation marker pixel found\"\n    center = np.array([1, 1], dtype=int)\n    # pick furthest (Manhattan) from center\n    dists = np.abs(pts - center).sum(axis=1)\n    p = pts[int(dists.argmax())]\n    dr, dc = int(p[0] - center[0]), int(p[1] - center[1])\n    if abs(dr) >= abs(dc):\n        if dr < 0:\n            return 0\n        if dr > 0:\n            return 2\n    else:\n        if dc > 0:\n            return 1\n        if dc < 0:\n            return 3\n    raise AssertionError(\"rotation marker pixel at center, direction ambiguous\")\n\n\ndef _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:\n    \"\"\"\n    anchor_idx in {0,1,2} selects position on a length:\n      0 -> start, 1 -> middle, 2 -> end\n    Returns the top-left coordinate so that the corresponding point of the placed object\n    aligns with that point on the canvas.\n    \"\"\"\n    if anchor_idx <= 0:\n        canvas_anchor = 0\n        obj_anchor = 0\n    elif anchor_idx >= 2:\n        canvas_anchor = max(0, size - 1)\n        obj_anchor = max(0, place_size - 1)\n    else:\n        canvas_anchor = (size - 1) // 2 if size > 1 else 0\n        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0\n    return canvas_anchor - obj_anchor\n\n\n","exit_code":0,"status":"completed"}}
