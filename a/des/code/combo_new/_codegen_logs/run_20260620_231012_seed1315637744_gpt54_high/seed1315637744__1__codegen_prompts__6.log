{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed1315637744/1/6.py | sed -n '1,260p'\"","aggregated_output":"     1\timport random\n     2\tfrom collections import deque\n     3\tfrom dataclasses import dataclass\n     4\t\n     5\timport numpy as np\n     6\t\n     7\t\n     8\tBG = 0\n     9\tFRAME_COLOR = 5\n    10\tGEN_RETRIES = 500\n    11\tMIN_GAP = 1\n    12\tCORNER_ORDER = (\"tl\", \"tr\", \"br\", \"bl\")\n    13\tCW_ROTATIONS = {\"tl\": 0, \"tr\": 1, \"br\": 2, \"bl\": 3}\n    14\t\n    15\t\n    16\t@dataclass\n    17\tclass TemplateInfo:\n    18\t    bbox: tuple[int, int, int, int]\n    19\t    frame_color: int\n    20\t    pattern_color: int\n    21\t    mask: np.ndarray\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass EnvelopeInfo:\n    26\t    bbox: tuple[int, int, int, int]\n    27\t    fill_color: int\n    28\t    marker_color: int\n    29\t    corner: str\n    30\t\n    31\t\n    32\tdef _get_bg(grid: np.ndarray) -> int:\n    33\t    counts = np.bincount(grid.ravel(), minlength=10)\n    34\t    return int(np.argmax(counts))\n    35\t\n    36\t\n    37\tdef _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:\n    38\t    h, w = mask.shape\n    39\t    seen = np.zeros_like(mask, dtype=bool)\n    40\t    comps: list[list[tuple[int, int]]] = []\n    41\t    for r in range(h):\n    42\t        for c in range(w):\n    43\t            if not mask[r, c] or seen[r, c]:\n    44\t                continue\n    45\t            seen[r, c] = True\n    46\t            q = deque([(r, c)])\n    47\t            cells: list[tuple[int, int]] = []\n    48\t            while q:\n    49\t                cr, cc = q.popleft()\n    50\t                cells.append((cr, cc))\n    51\t                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    52\t                    nr, nc = cr + dr, cc + dc\n    53\t                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n    54\t                        seen[nr, nc] = True\n    55\t                        q.append((nr, nc))\n    56\t            comps.append(cells)\n    57\t    return comps\n    58\t\n    59\t\n    60\tdef _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:\n    61\t    rows = [r for r, _ in cells]\n    62\t    cols = [c for _, c in cells]\n    63\t    return min(rows), min(cols), max(rows), max(cols)\n    64\t\n    65\t\n    66\tdef _is_full_frame(subgrid: np.ndarray, color: int) -> bool:\n    67\t    h, w = subgrid.shape\n    68\t    if h != w or h < 4:\n    69\t        return False\n    70\t    if np.any(subgrid[0, :] != color) or np.any(subgrid[-1, :] != color):\n    71\t        return False\n    72\t    if np.any(subgrid[:, 0] != color) or np.any(subgrid[:, -1] != color):\n    73\t        return False\n    74\t    return True\n    75\t\n    76\t\n    77\tdef _find_template(grid: np.ndarray, bg: int) -> TemplateInfo:\n    78\t    candidates: list[TemplateInfo] = []\n    79\t    for color in map(int, np.unique(grid)):\n    80\t        if color == bg:\n    81\t            continue\n    82\t        for comp in _components(grid == color):\n    83\t            r0, c0, r1, c1 = _bbox(comp)\n    84\t            sub = grid[r0 : r1 + 1, c0 : c1 + 1]\n    85\t            side = sub.shape[0]\n    86\t            if not _is_full_frame(sub, color):\n    87\t                continue\n    88\t            if len(comp) != 4 * side - 4:\n    89\t                continue\n    90\t            interior = sub[1:-1, 1:-1]\n    91\t            inside_colors = [int(v) for v in np.unique(interior) if int(v) != bg]\n    92\t            if len(inside_colors) != 1:\n    93\t                continue\n    94\t            pattern_color = inside_colors[0]\n    95\t            if pattern_color == color:\n    96\t                continue\n    97\t            mask = interior == pattern_color\n    98\t            if mask.shape[0] < 2 or mask.sum() < 2:\n    99\t                continue\n   100\t            if not bool(mask[0, 0]):\n   101\t                continue\n   102\t            if any(np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3)):\n   103\t                continue\n   104\t            candidates.append(\n   105\t                TemplateInfo(\n   106\t                    bbox=(r0, c0, r1, c1),\n   107\t                    frame_color=color,\n   108\t                    pattern_color=pattern_color,\n   109\t                    mask=mask.copy(),\n   110\t                )\n   111\t            )\n   112\t    assert len(candidates) == 1, f\"expected exactly one template, found {len(candidates)}\"\n   113\t    return candidates[0]\n   114\t\n   115\t\n   116\tdef _corner_from_marker(subgrid: np.ndarray, marker_color: int) -> str | None:\n   117\t    pos = np.argwhere(subgrid == marker_color)\n   118\t    if pos.shape != (1, 2):\n   119\t        return None\n   120\t    r, c = map(int, pos[0])\n   121\t    h, w = subgrid.shape\n   122\t    if (r, c) == (0, 0):\n   123\t        return \"tl\"\n   124\t    if (r, c) == (0, w - 1):\n   125\t        return \"tr\"\n   126\t    if (r, c) == (h - 1, w - 1):\n   127\t        return \"br\"\n   128\t    if (r, c) == (h - 1, 0):\n   129\t        return \"bl\"\n   130\t    return None\n   131\t\n   132\t\n   133\tdef _find_envelopes(grid: np.ndarray, bg: int, template_bbox: tuple[int, int, int, int]) -> list[EnvelopeInfo]:\n   134\t    mask = grid != bg\n   135\t    r0, c0, r1, c1 = template_bbox\n   136\t    mask[r0 : r1 + 1, c0 : c1 + 1] = False\n   137\t    envelopes: list[EnvelopeInfo] = []\n   138\t    for comp in _components(mask):\n   139\t        br0, bc0, br1, bc1 = _bbox(comp)\n   140\t        area = (br1 - br0 + 1) * (bc1 - bc0 + 1)\n   141\t        if len(comp) != area:\n   142\t            continue\n   143\t        sub = grid[br0 : br1 + 1, bc0 : bc1 + 1]\n   144\t        if np.any(sub == bg):\n   145\t            continue\n   146\t        colors, counts = np.unique(sub, return_counts=True)\n   147\t        if len(colors) != 2:\n   148\t            continue\n   149\t        order = np.argsort(-counts)\n   150\t        colors = colors[order]\n   151\t        counts = counts[order]\n   152\t        if int(counts[0]) != area - 1 or int(counts[1]) != 1:\n   153\t            continue\n   154\t        fill_color = int(colors[0])\n   155\t        marker_color = int(colors[1])\n   156\t        corner = _corner_from_marker(sub, marker_color)\n   157\t        if corner is None:\n   158\t            continue\n   159\t        envelopes.append(\n   160\t            EnvelopeInfo(\n   161\t                bbox=(br0, bc0, br1, bc1),\n   162\t                fill_color=fill_color,\n   163\t                marker_color=marker_color,\n   164\t                corner=corner,\n   165\t            )\n   166\t        )\n   167\t    assert envelopes, \"expected at least one envelope\"\n   168\t    return envelopes\n   169\t\n   170\t\n   171\tdef _parse_input(grid: np.ndarray) -> tuple[int, TemplateInfo, list[EnvelopeInfo]]:\n   172\t    g = np.asarray(grid, dtype=int)\n   173\t    bg = _get_bg(g)\n   174\t    template = _find_template(g, bg)\n   175\t    envelopes = _find_envelopes(g, bg, template.bbox)\n   176\t    return bg, template, envelopes\n   177\t\n   178\t\n   179\tdef _stamp_origin(\n   180\t    bbox: tuple[int, int, int, int], corner: str, shape: tuple[int, int]\n   181\t) -> tuple[int, int]:\n   182\t    r0, c0, r1, c1 = bbox\n   183\t    h, w = shape\n   184\t    if corner == \"tl\":\n   185\t        return r0, c0\n   186\t    if corner == \"tr\":\n   187\t        return r0, c1 - w + 1\n   188\t    if corner == \"br\":\n   189\t        return r1 - h + 1, c1 - w + 1\n   190\t    if corner == \"bl\":\n   191\t        return r1 - h + 1, c0\n   192\t    raise ValueError(f\"unknown corner {corner}\")\n   193\t\n   194\t\n   195\tdef main(grid: np.ndarray) -> np.ndarray:\n   196\t    \"\"\"\n   197\t    Rotate the stamp template and print it into each envelope corner indicated by a marker.\n   198\t\n   199\t    Input structure:\n   200\t    - The background is black.\n   201\t    - One small square template is enclosed by a 1-cell gray frame; inside it, a single colored non-symmetric stamp pattern sits on black cells.\n   202\t    - Several larger solid rectangles act as envelopes; each is filled with one color except for exactly one corner marker pixel of another color.\n   203\t\n   204\t    Rule:\n   205\t    - Extract the stamp mask from inside the framed template, ignoring the gray border.\n   206\t    - For each envelope, detect which corner contains the marker: top-left means 0 degrees, top-right means 90 degrees clockwise, bottom-right means 180 degrees, bottom-left means 270 degrees clockwise.\n   207\t    - Paint the rotated stamp into that envelope corner using the marker's color, overwriting the marker cell and leaving the template unchanged.\n   208\t\n   209\t    Key insight:\n   210\t    - The marker location encodes rotation, while the marker color independently encodes the printed stamp color.\n   211\t    \"\"\"\n   212\t    g = np.asarray(grid, dtype=int)\n   213\t    _, template, envelopes = _parse_input(g)\n   214\t    out = g.copy()\n   215\t    base_mask = template.mask\n   216\t\n   217\t    for env in envelopes:\n   218\t        rotated = np.rot90(base_mask, -CW_ROTATIONS[env.corner])\n   219\t        eh = env.bbox[2] - env.bbox[0] + 1\n   220\t        ew = env.bbox[3] - env.bbox[1] + 1\n   221\t        ph, pw = rotated.shape\n   222\t        assert eh >= ph and ew >= pw, \"envelope is smaller than the stamp\"\n   223\t        sr, sc = _stamp_origin(env.bbox, env.corner, rotated.shape)\n   224\t        patch = out[sr : sr + ph, sc : sc + pw]\n   225\t        patch[rotated] = env.marker_color\n   226\t\n   227\t    return out\n   228\t\n   229\t\n   230\t# --------------- generator ---------------\n   231\t\n   232\t\n   233\tdef _pattern_is_valid(mask: np.ndarray) -> bool:\n   234\t    if mask.shape[0] < 3 or mask.shape[0] != mask.shape[1]:\n   235\t        return False\n   236\t    if not bool(mask[0, 0]):\n   237\t        return False\n   238\t    if int(mask.sum()) < 3:\n   239\t        return False\n   240\t    return not any(np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3))\n   241\t\n   242\t\n   243\tdef _random_stamp_mask(size: int, rng: random.Random) -> np.ndarray:\n   244\t    target = rng.randint(size + 1, size * size - 1)\n   245\t    for _ in range(200):\n   246\t        mask = np.zeros((size, size), dtype=bool)\n   247\t        cells = {(0, 0)}\n   248\t        frontier = {(0, 1), (1, 0)}\n   249\t        while len(cells) < target and frontier:\n   250\t            cell = rng.choice(tuple(frontier))\n   251\t            frontier.remove(cell)\n   252\t            cells.add(cell)\n   253\t            r, c = cell\n   254\t            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n   255\t                nr, nc = r + dr, c + dc\n   256\t                if 0 <= nr < size and 0 <= nc < size and (nr, nc) not in cells:\n   257\t                    frontier.add((nr, nc))\n   258\t        for r, c in cells:\n   259\t            mask[r, c] = True\n   260\t        if _pattern_is_valid(mask):\n","exit_code":0,"status":"completed"}}
