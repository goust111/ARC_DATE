t    pattern_color: int,\n   304\t) -> None:\n   305\t    r0, c0 = top_left\n   306\t    size = mask.shape[0] + 2\n   307\t    r1, c1 = r0 + size - 1, c0 + size - 1\n   308\t    grid[r0 : r1 + 1, c0] = FRAME_COLOR\n   309\t    grid[r0 : r1 + 1, c1] = FRAME_COLOR\n   310\t    grid[r0, c0 : c1 + 1] = FRAME_COLOR\n   311\t    grid[r1, c0 : c1 + 1] = FRAME_COLOR\n   312\t    interior = grid[r0 + 1 : r1, c0 + 1 : c1]\n   313\t    interior[mask] = pattern_color\n   314\t\n   315\t\n   316\tdef _draw_envelope(\n   317\t    grid: np.ndarray,\n   318\t    top_left: tuple[int, int],\n   319\t    shape: tuple[int, int],\n   320\t    fill_color: int,\n   321\t    marker_color: int,\n   322\t    corner: str,\n   323\t) -> None:\n   324\t    r0, c0 = top_left\n   325\t    h, w = shape\n   326\t    r1, c1 = r0 + h - 1, c0 + w - 1\n   327\t    grid[r0 : r1 + 1, c0 : c1 + 1] = fill_color\n   328\t    if corner == \"tl\":\n   329\t        grid[r0, c0] = marker_color\n   330\t    elif corner == \"tr\":\n   331\t        grid[r0, c1] = marker_color\n   332\t    elif corner == \"br\":\n   333\t        grid[r1, c1] = marker_color\n   334\t    elif corner == \"bl\":\n   335\t        grid[r1, c0] = marker_color\n   336\t    else:\n   337\t        raise ValueError(f\"unknown corner {corner}\")\n   338\t\n   339\t\n   340\tdef _validate_generated(\n   341\t    grid: np.ndarray,\n   342\t    expected_mask: np.ndarray,\n   343\t    expected_env_count: int,\n   344\t    expected_corners: set[str],\n   345\t) -> None:\n   346\t    bg, template, envelopes = _parse_input(grid)\n   347\t    assert bg == BG\n   348\t    assert np.array_equal(template.mask, expected_mask)\n   349\t    assert len(envelopes) == expected_env_count\n   350\t    assert {env.corner for env in envelopes} == expected_corners\n   351\t    out = main(grid)\n   352\t    assert out.shape == grid.shape\n   353\t    assert np.any(out != grid)\n   354\t    template_out = out[\n   355\t        template.bbox[0] : template.bbox[2] + 1, template.bbox[1] : template.bbox[3] + 1\n   356\t    ]\n   357\t    template_in = grid[\n   358\t        template.bbox[0] : template.bbox[2] + 1, template.bbox[1] : template.bbox[3] + 1\n   359\t    ]\n   360\t    assert np.array_equal(template_in, template_out)\n   361\t\n   362\t\n   363\tdef _gen_attempt(rng: random.Random) -> np.ndarray:\n   364\t    stamp_size = rng.randint(3, 5)\n   365\t    stamp_mask = _random_stamp_mask(stamp_size, rng)\n   366\t\n   367\t    n_env = rng.randint(1, 4)\n   368\t    corners = rng.sample(CORNER_ORDER, k=n_env)\n   369\t\n   370\t    palette = [1, 2, 3, 4, 6, 7, 8, 9]\n   371\t    envelope_color, stamp_color = rng.sample(palette, 2)\n   372\t    remaining = [c for c in palette if c not in (envelope_color, stamp_color)]\n   373\t    marker_colors = rng.sample(remaining, k=n_env)\n   374\t\n   375\t    env_shapes: list[tuple[int, int]] = []\n   376\t    for _ in range(n_env):\n   377\t        h = rng.randint(stamp_size + 1, min(9, stamp_size + 4))\n   378\t        w = rng.randint(stamp_size + 1, min(9, stamp_size + 4))\n   379\t        env_shapes.append((h, w))\n   380\t\n   381\t    template_outer = stamp_size + 2\n   382\t    total_area = template_outer * template_outer + sum(h * w for h, w in env_shapes)\n   383\t    max_dim = max([template_outer] + [max(h, w) for h, w in env_shapes])\n   384\t    min_side = max(max_dim + 2, int(np.ceil(np.sqrt(total_area * 2.4))))\n   385\t    if min_side > 30:\n   386\t        raise RuntimeError(\"object pack too large\")\n   387\t    H = rng.randint(min_side, 30)\n   388\t    W = rng.randint(min_side, 30)\n   389\t\n   390\t    shapes = {\"template\": (template_outer, template_outer)}\n   391\t    for idx, shape in enumerate(env_shapes):\n   392\t        shapes[f\"env{idx}\"] = shape\n   393\t    positions = _place_objects(shapes, H, W, rng)\n   394\t\n   395\t    grid = np.full((H, W), BG, dtype=int)\n   396\t    _draw_template(grid, positions[\"template\"], stamp_mask, stamp_color)\n   397\t    for idx, (shape, corner, marker_color) in enumerate(zip(env_shapes, corners, marker_colors)):\n   398\t        _draw_envelope(grid, positions[f\"env{idx}\"], shape, envelope_color, marker_color, corner)\n   399\t\n   400\t    _validate_generated(grid, stamp_mask, n_env, set(corners))\n   401\t    return grid\n   402\t\n   403\t\n   404\tdef generate_input() -> np.ndarray:\n   405\t    for _ in range(GEN_RETRIES):\n   406\t        try:\n   407\t            return _gen_attempt(random.Random())\n   408\t        except Exception:\n   409\t            continue\n   410\t    raise RuntimeError(f\"failed to generate a valid input after {GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
