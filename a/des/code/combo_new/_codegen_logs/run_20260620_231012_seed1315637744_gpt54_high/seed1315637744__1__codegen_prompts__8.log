{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random\nimport numpy as np\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed1315637744/1/8.py')\nmod = SourceFileLoader('arc8_dbg2', str(p)).load_module()\nfor seed in range(1000):\n    random.seed(seed)\n    try:\n        mod._build_structure(1, 1)\n    except Exception:\n        print('seed', seed)\n        random.seed(seed)\n        turn_up = random.random() < 0.5\n        mask_a = mod._generate_object_mask('right')\n        mask_b = mod._generate_object_mask('top' if turn_up else 'bottom')\n        ar, _ = mod._attachment(mask_a, 'right')\n        _, bc = mod._attachment(mask_b, 'top' if turn_up else 'bottom')\n        min_horiz = bc + 1\n        horiz = random.randint(min_horiz, min_horiz + 5)\n        vert = random.randint(mask_b.shape[0] + 1, mask_b.shape[0] + 6)\n        pos_a = (0, 0)\n        start = (pos_a[0] + ar, pos_a[1] + mask_a.shape[1])\n        elbow = (start[0], start[1] + horiz)\n        if turn_up:\n            end = (start[0] - vert, elbow[1])\n            pos_b = (end[0] + 1, end[1] - bc)\n        else:\n            end = (start[0] + vert, elbow[1])\n            pos_b = (end[0] - mask_b.shape[0], end[1] - bc)\n        line = mod._segment(start, elbow) + mod._segment(elbow, end)[1:]\n        print('turn_up', turn_up)\n        print('mask_a\\\\n', mask_a.astype(int))\n        print('mask_b\\\\n', mask_b.astype(int))\n        print('ar bc', ar, bc)\n        print('horiz vert', horiz, vert)\n        print('pos_a', pos_a, 'pos_b', pos_b)\n        print('start elbow end', start, elbow, end)\n        occ = {}\n        for r in range(mask_a.shape[0]):\n            for c in range(mask_a.shape[1]):\n                if mask_a[r,c]:\n                    occ.setdefault((pos_a[0]+r, pos_a[1]+c), []).append('A')\n        for r in range(mask_b.shape[0]):\n 