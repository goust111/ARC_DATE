{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"for f in /home/lixinyu/snap/new/ARC_code/eval/21897d95.py /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py /home/lixinyu/snap/new/ARC_code/train/2601afb7.py /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py /home/lixinyu/snap/new/ARC_code/train/a834deea.py /home/lixinyu/snap/new/ARC_code/eval/581f7754.py; do sed -n '/\"'^def main(/,/''^def /p'\"' \\\"\"'$f\"; done'","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef _get_bar(stem):\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n\ndef _gen_anchor(corner: str, n: int, h: int, w: int) -> tuple[int, int]:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n        fr0, fc0, fr1, fc1 = frame_bb\n        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n        frame_mask0 = (frame != 0) & (frame != 6)\n        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n\n        # Rotate layout according to clockhand.\n        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n\n        # Build composite by tiling the unit sprite into active frame cells.\n        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n        uh, uw = unit_sprite.shape\n        fh, fw = frame_mask.shape\n        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n        for i in range(fh):\n            for j in range(fw):\n                if not frame_mask[i, j]:\n                    continue\n                rr0 = i * uh\n                cc0 = j * uw\n                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n\n        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n        if pos is None:\n            continue\n        pr, pc = pos\n\n        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n\n        ch, cw = comp.shape\n        for r in range(ch):\n            rr = top + r\n            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n            for c in range(cw):\n                cc = left + c\n                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n                if out[rr, cc] == 6:\n                    continue\n                val = int(comp[r, c])\n                if val != 0 and val != 6:\n                    assert not composite_written[rr, cc], \"composites must not overlap\"\n                    composite_written[rr, cc] = True\n                    out[rr, cc] = val\n    return out\n\n# --------------- generator (refine_8conn_fill_overlap) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (20, 30)         # output grid height\nGRID_W = 30                     # output grid width (fixed)\nLEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\nUNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\nMIN_CANVAS_W = 8                # reject if canvas narrower than this\nFRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\nFRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\nFRAME_DENSITY = 0.5             # density for random_sprite frame generation\nBAND_WIDTH_MIN = 4              # minimum band width for canvas background\nMARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\nUSABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\nROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\nGEN_RETRIES = 300               # max attempts in generate_input\n\n\ndef _allocate_colors(num_legends):\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill each black 5x5 region's missing interior positions with a fixed 3x3 positional color legend.\n\n    Input structure\n    - The grid uses teal as the dominant background and black for one or more\n      5x5 regions.\n    - Each black region has a black one-pixel border and a 3x3 interior that\n      may already contain teal pixels.\n\n    Rule\n    - Overlay the legend 1 7 6 / 4 8 5 / 2 9 3 on the 3x3 interior of every\n      5x5 black region.\n    - Wherever an interior non-center legend position is still black, recolor it\n      to the corresponding legend color; leave existing teal pixels, the center,\n      and the black border unchanged.\n\n    Key insight\n    - The colored output pixels are not derived from the teal motif shape; they\n      are the fixed position labels for the missing cells of each 3x3 interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    assert bg == Color.TEAL\n    fg_colors = colors_present(g, exclude={bg})\n    assert fg_colors == [Color.BLACK]\n\n    out = g.copy()\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=True,\n        colors=[Color.BLACK],\n    )\n    assert components\n\n    for component in components:\n        b = component[\"bbox\"]\n        assert bbox_h(b) == 5 and bbox_w(b) == 5\n        r0, c0, _r1, _c1 = b\n        patch = crop_bbox(g, b)\n        assert np.all((patch == Color.BLACK) | (patch == bg))\n        assert np.all(patch[[0, -1], :] == Color.BLACK)\n        assert np.all(patch[:, [0, -1]] == Color.BLACK)\n        assert np.any(patch[1:4, 1:4] == bg)\n\n        for rr in range(3):\n            for cc in range(3):\n                color = int(LEGEND[rr, cc])\n                if color == bg:\n                    continue\n                grid_r = int(r0) + rr + 1\n                grid_c = int(c0) + cc + 1\n                if g[grid_r, grid_c] == Color.BLACK:\n                    out[grid_r, grid_c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and region geometry.\nMIN_GRID_SIZE, MAX_GRID_SIZE = 9, 16\nREGION_SIZE, INTERIOR_SIZE, REGION_GAP = 5, 3, 1\n\n# Region count and interior-hole sampling.\nMIN_REGIONS, MAX_REGIONS = 1, 4\nMIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR = 1, 6\nMAX_AREA_PER_REGION = 48\n\n# Generation retry limit and colors.\nMAX_GENERATION_ATTEMPTS = 300\nGEN_BG, GEN_FG = Color.TEAL, Color.BLACK\nGEN_PATCH = np.full((REGION_SIZE, REGION_SIZE), GEN_FG, dtype=int)\nGEN_INTERIOR = [\n    (rr, cc) for rr in range(INTERIOR_SIZE) for cc in range(INTERIOR_SIZE)\n]\n\n\ndef _gen_dim_slots(length):\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n","exit_code":0,"status":"completed"}}
