{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2b83f449.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, label_mask\nimport itertools\nfrom arc_utils import paste\nfrom collections import defaultdict\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate tokens falling through a pipe network after gates rotate open.\n\n    Input structure:\n    - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).\n\n    Rule:\n    - Rotate each gate into a vertical blocker; gate cells become bg.\n    - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).\n    - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.\n\n    Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    colors = set(map(int, g.flatten()))\n\n    # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---\n    gate = None\n    for col in sorted(colors):\n        if int(col) == 0:\n            continue\n        lab, n = label_mask(g == int(col), connectivity=4)\n        found = False\n        for k in range(1, int(n) + 1):\n            pts = np.argwhere(lab == int(k))\n            if int(pts.shape[0]) != 3:\n                continue\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:\n                found = True\n                break\n        if found:\n            gate = int(col)\n            break\n    assert not (gate is None)\n\n    # --- token/bg inference ---\n    cnt_all = Counter(map(int, g.flatten()))\n    cand_token = [c for c in colors if int(c) not in (0, int(gate))]\n    assert not (not cand_token)\n    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))\n    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]\n    assert cand_bg\n    bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))\n\n    # --- opened gate color (vertical post) ---\n    open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6\n\n    # --- rotate gates (gates open into bg, center becomes vertical open_col) ---\n    out = g.copy()\n    lab, n = label_mask(out == int(gate), connectivity=4)\n    for k in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(k))\n        if int(pts.shape[0]) != 3:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:\n            continue\n        r = int(r0)\n        c0 = int(c0)\n        center_c = int(c0 + 1)\n        out[int(r), int(c0) : int(c0) + 3] = int(bg)\n        for rr in (int(r - 1), int(r), int(r + 1)):\n            if 0 <= int(rr) < H:\n                out[int(rr), int(center_c)] = int(open_col)\n\n    # helpers\n    def segments_in_row(r: int) -> list[tuple[int, int]]:\n        segs: list[tuple[int, int]] = []\n        c = 0\n        while c < W:\n            if int(out[r, c]) != int(bg):\n                c += 1; continue\n            c0 = c\n            while c + 1 < W and int(out[r, c + 1]) == int(bg):\n                c += 1\n            segs.append((c0, c)); c += 1\n        return segs\n\n    def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:\n        for a, b in segs:\n            if a <= c <= b: return (a, b)\n        return None\n\n    def seg_exit(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single exit column, or None. Assert if >1 exit.\"\"\"\n        a, b = seg\n        if r + 2 >= H: return None\n        drops = [c for c in range(a, b + 1)\n                 if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]\n        assert len(drops) <= 1, f\"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}\"\n        return drops[0] if drops else None\n\n    def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:\n        \"\"\"Return the single entry column from the wall above, or None. Assert if >1.\"\"\"\n        a, b = seg\n        if r < 2: return None\n        entries = [c for c in range(a, b + 1)\n                   if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]\n        assert len(entries) <= 1, f\"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}\"\n        return entries[0] if entries else None\n\n    # Remove tokens; simulate; re-place.\n    token_pts = [(int(r), int(c)) for r, c in np.argwhere(out == int(token))]\n    out[out == int(token)] = int(bg)\n\n    # Phase 1: each token drops through single exits until stuck.\n    finals: list[tuple[int, int]] = []  # (row, col) of final position\n    for r, c in token_pts:\n        cur_r, cur_c = r, c\n        if int(out[cur_r, cur_c]) != int(bg):\n            finals.append((cur_r, cur_c)); continue\n        while True:\n            seg = find_seg(segments_in_row(cur_r), cur_c)\n            if seg is None: break\n            ex = seg_exit(cur_r, seg)\n            if ex is None: break\n            cur_r += 2; cur_c = ex\n            if cur_r >= H: break\n        finals.append((cur_r, cur_c))\n\n    # Phase 2: pack tokens at opposite end from entry.\n    buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)\n    for r, c in finals:\n        segs = segments_in_row(r)\n        seg = find_seg(segs, c)\n        if seg is None: continue\n        a, b = seg\n        entry = entry_from_above(r, seg)\n        if entry is not None:\n            # Pack to opposite end from entry\n            pack_end = b if (entry - a) <= (b - entry) else a\n        else:\n            # No entry from above: token at starting position (grid edge), stay put\n            pack_end = a if c <= a else b\n        buckets[(r, seg, pack_end)] += 1\n\n    for (r, (a, b), pack_end), k in buckets.items():\n        if pack_end == a:\n            for i in range(k):\n                if a + i <= b: out[r, a + i] = int(token)\n        else:\n            for i in range(k):\n                if b - i >= a: out[r, b - i] = int(token)\n\n    return out\n\n# --------------- generator (Codex, output-first with spine) ---------------\n\nWALL = 0\nTOKEN = 3\nOPEN = 6\nGATE = 7\nBG = 8\n\n\ndef _build_opened_grid(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            grid[r, c - 1] = BG\n            grid[r, c] = OPEN\n            grid[r, c + 1] = BG\n            grid[r - 1, c] = OPEN\n            grid[r + 1, c] = OPEN\n\n    return grid\n\n\ndef _build_input(gates: list[list[int]], holes: list[list[int]], width: int) -> np.ndarray:\n    n_walls = len(gates)\n    height = 2 * n_walls + 1\n    grid = np.full((height, width), WALL, dtype=int)\n    gate_patch = np.full((1, 3), GATE, dtype=int)\n\n    for pipe_idx in range(n_walls + 1):\n        r = 2 * pipe_idx\n        grid[r, :] = BG\n        for c in holes[pipe_idx]:\n            grid[r, c] = WALL\n\n    for wall_idx, centers in enumerate(gates):\n        r = 2 * wall_idx + 1\n        for c in centers:\n            paste(grid, gate_patch, r, c - 1)\n\n    for pipe_idx in range(n_walls):\n        r = 2 * pipe_idx\n        grid[r, 0] = TOKEN\n        grid[r, width - 1] = TOKEN\n\n    return grid\n\n\ndef _segments_in_row(grid: np.ndarray, r: int) -> list[tuple[int, int]]:\n    width = grid.shape[1]\n    segments: list[tuple[int, int]] = []\n    c = 0\n    while c < width:\n        if grid[r, c] != BG:\n            c += 1\n            continue\n        start = c\n        while c + 1 < width and grid[r, c + 1] == BG:\n            c += 1\n        segments.append((start, c))\n        c += 1\n    return segments\n\n\ndef _find_segment(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:\n    for seg in _segments_in_row(grid, r):\n        if seg[0] <= c <= seg[1]:\n            return seg\n    return None\n\n\ndef _exits_below(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    height = grid.shape[0]\n    if r + 2 >= height:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r + 1, c] == BG and grid[r + 2, c] == BG]\n\n\ndef _entries_above(grid: np.ndarray, r: int, seg: tuple[int, int]) -> list[int]:\n    if r < 2:\n        return []\n    a, b = seg\n    return [c for c in range(a, b + 1) if grid[r - 1, c] == BG and grid[r - 2, c] == BG]\n\n\ndef _find_issues(grid: np.ndarray) -> list[tuple[int, tuple[int, int], list[int], list[int]]]:\n    height = grid.shape[0]\n    issues: list[tuple[int, tuple[int, int], list[int], list[int]]] = []\n    for r in range(0, height, 2):\n        for seg in _segments_in_row(grid, r):\n            above = _entries_above(grid, r, seg)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"import math\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous\nimport random\n\n\nRED = 2\nBLUE = 1\n\n\ndef _extract_frames(g: np.ndarray, bg: int) -> tuple[list[dict], list[np.ndarray]]:\n    red_components = components_mask(g == RED, connectivity=4)\n    assert len(red_components) >= 3\n\n    frames = []\n    for coords in red_components:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert h == w and h >= 3\n\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        assert int(border.sum()) == int(coords.shape[0])\n        assert np.all(patch[border] == RED)\n        assert np.all(patch[~border] != RED)\n\n        interior = patch[1:-1, 1:-1]\n        interior_colors = set(map(int, np.unique(interior))) - {int(bg)}\n        assert len(interior_colors) == 1\n        color = interior_colors.pop()\n        mask = interior == color\n        assert mask.any()\n\n        frames.append(\n            {\n                \"bbox\": (r0, c0, r1, c1),\n                \"center\": ((r0 + r1) / 2, (c0 + c1) / 2),\n                \"color\": color,\n                \"mask\": mask,\n            }\n        )\n\n    return frames, red_components\n\n\ndef _blue_cycle_edges(g: np.ndarray, red_components: list[np.ndarray]) -> set[tuple[int, int]]:\n    red_id = {}\n    for i, coords in enumerate(red_components):\n        for r, c in coords:\n            red_id[(int(r), int(c))] = i\n\n    edges = set()\n    for coords in components_mask(g == BLUE, connectivity=4):\n        touched = set()\n        for r, c in coords:\n            rr = int(r)\n            cc = int(c)\n            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):\n                frame_id = red_id.get((nr, nc))\n                if frame_id is not None:\n                    touched.add(frame_id)\n        assert len(touched) == 2\n        a, b = touched\n        edges.add(tuple(sorted((a, b))))\n\n    n = len(red_components)\n    assert len(edges) == n\n    for i in range(n):\n        assert sum(i in edge for edge in edges) == 2\n    return edges\n\n\ndef _clockwise_order(frames: list[dict], edges: set[tuple[int, int]]) -> list[int]:\n    mean_r = sum(frame[\"center\"][0] for frame in frames) / len(frames)\n    mean_c = sum(frame[\"center\"][1] for frame in frames) / len(frames)\n    angles = [\n        math.atan2(frame[\"center\"][0] - mean_r, frame[\"center\"][1] - mean_c)\n        for frame in frames\n    ]\n    assert len({round(angle, 12) for angle in angles}) == len(angles)\n\n    order = sorted(range(len(frames)), key=lambda i: angles[i])\n    for a, b in zip(order, order[1:] + order[:1]):\n        assert tuple(sorted((a, b))) in edges\n    return order\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n\n    Input structure\n    - The grid contains hollow red square frames connected pairwise by blue line components.\n    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n    - Each frame interior contains background plus exactly one non-background color mask.\n\n    Rule\n    - Sort the red frames clockwise by their centers around the cycle.\n    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n\n    Key insight\n    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    frames, red_components = _extract_frames(g, bg)\n    edges = _blue_cycle_edges(g, red_components)\n    order = _clockwise_order(frames, edges)\n\n    out = g.copy()\n    for k, frame_id in enumerate(order):\n        next_id = order[(k + 1) % len(order)]\n        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette constants.\nBG = 0\nCONNECTOR_BLUE = 1\nFRAME_RED = 2\nINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n\n# Canvas and frame bounds.\nFRAME_COUNT_RANGE = (3, 5)\nFRAME_SIZE_CHOICES = [5, 7]\nSMALL_FRAME_GRID_H_RANGE = (20, 27)\nSMALL_FRAME_GRID_W_RANGE = (21, 27)\nLARGE_FRAME_GRID_H_RANGE = (22, 27)\nLARGE_FRAME_GRID_W_RANGE = (23, 27)\nFRAME_GAP = 1\n\n# Interior mask density.\nMIN_INTERIOR_FILL = 0.30\nMAX_INTERIOR_FILL = 0.56\nMIN_INTERIOR_CELLS = 3\n\n# Angular placement.\nANGLE_PERTURB_RANGE = (-0.3, 0.3)\nMIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\ndef _gen_mask(interior_size, color):\n    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n    n = interior_size\n    total = n * n\n    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((n, n), dtype=int)\n    start = (n // 2, n // 2)\n    mask[start] = color\n    filled = [start]\n    frontier = set()\n    _add_mask_frontier(frontier, mask, start)\n\n    while len(filled) < target and frontier:\n        cell = random.choice(list(frontier))\n        frontier.discard(cell)\n        mask[cell] = color\n        filled.append(cell)\n        _add_mask_frontier(frontier, mask, cell)\n\n    if len(filled) < min_fill:\n        return None\n    return mask\n\n\ndef _add_mask_frontier(frontier, mask, cell):\n    n = mask.shape[0]\n    for dr, dc in NEIGHBORS_8:\n        nr, nc = cell[0] + dr, cell[1] + dc\n        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n            frontier.add((nr, nc))\n\n\ndef _axis_path(start, end):\n    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n    if sr == er:\n        step = 1 if ec > sc else -1\n        return [(sr, c) for c in range(sc, ec + step, step)]\n    step = 1 if er > sr else -1\n    return [(r, sc) for r in range(sr, er + step, step)]\n\n\ndef _one_turn_path(start, corner, end):\n    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n\n\ndef _two_turn_vhv_path(start, mid_r, end):\n    _, sc = start\n    _, ec = end\n    corner1 = (mid_r, sc)\n    corner2 = (mid_r, ec)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _two_turn_hvh_path(start, mid_c, end):\n    sr, _ = start\n    er, _ = end\n    corner1 = (sr, mid_c)\n    corner2 = (er, mid_c)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _path_is_free(path, occupied):\n    return all(p not in occupied for p in path)\n\n\ndef _find_path(start, end, occupied):\n    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n\n    if sr == er or sc == ec:\n        path = _axis_path(start, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    corners = [(sr, ec), (er, sc)]\n    random.shuffle(corners)\n    for corner in corners:\n        path = _one_turn_path(start, corner, end)\n        if _path_is_free(path, occupied):\n            return path\n","exit_code":0,"status":"completed"}}
