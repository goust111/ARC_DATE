{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/38007db0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the unique cell from each lattice row into a single-column lattice.\n\n    Input structure:\n    - Grid divided into equal square cells by uniform gridlines of color L.\n    - Cell interiors filled with bg; each cell has an inner sprite pattern.\n    - Each row of cells has exactly one cell with a unique pattern; the rest are copies.\n\n    Rule:\n    - For each lattice row, find the cell whose inner pattern appears exactly once (the \"odd one out\").\n    - Construct a single-column lattice preserving the original row heights, containing only the unique cells.\n\n    Key insight: The task is per-row \"odd one out\" — every cell in a row is identical except one oddball, which must be extracted.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Gridlines appear as fully-uniform rows/cols.\n    row_lines = [r for r in range(H) if len(set(map(int, g[r, :]))) == 1]\n    col_lines = [c for c in range(W) if len(set(map(int, g[:, c]))) == 1]\n    assert not (not row_lines or not col_lines)\n\n    # Lattice color = most common value among uniform rows/cols.\n    vals = [int(g[r, 0]) for r in row_lines] + [int(g[0, c]) for c in col_lines]\n    L = int(Counter(vals).most_common(1)[0][0])\n    row_lines = sorted([r for r in row_lines if int(g[r, 0]) == int(L)])\n    col_lines = sorted([c for c in col_lines if int(g[0, c]) == int(L)])\n\n    # Cell slices are the gaps between consecutive grid lines.\n    r_slices = [(int(row_lines[i]) + 1, int(row_lines[i + 1])) for i in range(len(row_lines) - 1)]\n    c_slices = [(int(col_lines[j]) + 1, int(col_lines[j + 1])) for j in range(len(col_lines) - 1)]\n    r_slices = [(a, b) for a, b in r_slices if int(b) > int(a)]\n    c_slices = [(a, b) for a, b in c_slices if int(b) > int(a)]\n    assert not (not r_slices or not c_slices)\n\n    cell_w = int(c_slices[0][1] - c_slices[0][0])\n\n    # Background inside cells = most common non-lattice color.\n    bg_candidates = [int(x) for x in g.flatten() if int(x) != int(L)]\n    assert bg_candidates\n    bg = int(Counter(bg_candidates).most_common(1)[0][0])\n\n    chosen_cells: list[np.ndarray] = []\n    for (ra, rb) in r_slices:\n        cells = [g[int(ra) : int(rb), int(ca) : int(cb)] for (ca, cb) in c_slices]\n        sigs = [cell.tobytes() for cell in cells]\n        cnt = Counter(sigs)\n        uniq_idx = next((j for j, s in enumerate(sigs) if int(cnt[s]) == 1), None)\n        assert uniq_idx is not None\n        chosen_cells.append(cells[int(uniq_idx)])\n\n    # Output: same height, single lattice column => width = cell_w + 2 (outer gridlines).\n    outW = int(cell_w + 2)\n    out = np.full((H, outW), int(bg), dtype=int)\n    out[:, 0] = int(L)\n    out[:, -1] = int(L)\n    for r in row_lines:\n        out[int(r), :] = int(L)\n\n    for i, (ra, rb) in enumerate(r_slices):\n        out[int(ra) : int(rb), 1 : 1 + int(cell_w)] = chosen_cells[int(i)]\n\n    return out\n\n# --------------- generator (Codex#3) ---------------\n\ndef _make_cell(inner: np.ndarray, bg: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n","exit_code":0,"status":"completed"}}
