{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed807260302/12/6.py')\nmod = SourceFileLoader('new_arc_task_dbg2', str(p)).load_module()\n\nfor i in range(1000):\n    directions = tuple(mod._FAMILIES[int(mod._RNG.integers(0, len(mod._FAMILIES)))])\n    h, w = mod._sample_dims(directions)\n    pattern = mod._make_pattern(h, w, directions)\n    if pattern is None:\n        continue\n    placements = mod._place_stamps(h, w, directions)\n    if placements is None:\n        continue\n    grid = np.full((mod.TEMP_SIDE, mod.TEMP_SIDE), mod.BG_COLOR, dtype=int)\n    for item in placements:\n        r0 = int(item['r0'])\n        c0 = int(item['c0'])\n        grid[r0:r0+h, c0:c0+w][pattern] = mod.STAMP_COLOR\n        arrow = np.asarray(item['arrow'], dtype=int)\n        grid[arrow[:,0], arrow[:,1]] = mod.ARROW_COLOR\n    cropped = mod._crop_with_margin(grid)\n    bg = mod.BG_COLOR if np.any(cropped == mod.BG_COLOR) else mod.get_bg(cropped)\n    candidates = []\n    for color in sorted(int(x) for x in np.unique(cropped) if int(x) \"'!= bg):\n        infos = []\n        for comp in mod.components_mask(cropped == color):\n            info = mod._classify_arrow(comp)\n            if info is None:\n                infos = []\n                break\n            infos.append(info)\n        if infos:\n            candidates.append((color, infos))\n    if len(candidates) != 1:\n        print('\"'bad case', i, 'directions', directions, 'shape', (h, w), 'unique', np.unique(cropped))\n        print('bg', bg, 'candidates', [(c, len(info)) for c, info in candidates])\n        for color in sorted(int(x) for x in np.unique(cropped) if int(x) \"'!= bg):\n            comps = mod.components_mask(cropped == color)\n            print('\"'color', color, 'comp sizes', [len(x) for x in comps])\n            for comp in comps:\n                print(' bbox', mod.bbox_coords(comp), 'norm', tuple(sorted((int(r-comp[:,0].min()), int(c-comp[:,1].min())) for r,c in comp)))\n        print(cropped)\n        break\nelse:\n    print('no bad case found')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
