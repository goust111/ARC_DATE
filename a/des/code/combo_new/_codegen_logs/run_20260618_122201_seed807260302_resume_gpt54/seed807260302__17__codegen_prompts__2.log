  25:     A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives\n  26:     a source color in the left column and that source color's fill color in the right column.  Outside the\n  27:     legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.\n  28: \n  29:     Rule\n  30:     Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox\n  31:     by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired\n  32:     legend fill color while preserving every original non-legend dot.\n  33: \n  34:     Key insight\n  35:     The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted\n  36:     from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.\n  37:     \"\"\"\n  38:     g = np.asarray(grid, dtype=int)\n  39:     bg = get_bg(g)\n  40:     H, W = g.shape\n  41:     assert W >= 2, \"expected room for a two-column legend\"\n  42: \n  43:     pairs = _legend_pairs(g, bg)\n  44:     source_colors = {source for source, _fill in pairs}\n  45:     assert len(source_colors) == len(pairs), \"legend source colors must be unique\"\n  46: \n  47:     legend_mask = np.zeros(g.shape, dtype=bool)\n  48:     legend_mask[: len(pairs), :2] = True\n  49:     dot_mask = (g != bg) & ~legend_mask\n  50:     assert dot_mask.any(), \"expected source dots outside the legend\"\n  51:     assert set(map(int, g[dot_mask])).issubset(source_colors), \"outside dots must use legend source colors\"\n  52: \n  53:     dots_by_color: dict[int, np.ndarray] = {}\n  54:     all_dots = np.zeros(g.shape, dtype=bool)\n  55:     for source, _fill in pairs:\n  56:         coords = np.argwhere(dot_mask & (g == source))\n  57:         assert coords.size, \"each legend source color must appear outside the legend\"\n  58:         dots_by_color[source] = coords\n  59:         all_dots[coords[:, 0], coords[:, 1]] = True\n  60: \n  61:     out = np.full_like(g, bg)\n  62:     for source, fill in reversed(pairs):\n  63:         r0, c0, r1, c1 = bbox_coords(dots_by_color[source])\n  64:         r0 = max(0, r0 - 1)\n  65:         c0 = max(0, c0 - 1)\n  66:         r1 = min(H - 1, r1 + 1)\n  67:         c1 = min(W - 1, c1 + 1)\n  68: \n  69:         region = out[r0 : r1 + 1, c0 : c1 + 1]\n  70:         background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]\n  71:         region[background_inside_region] = fill\n  72: \n  73:     out[all_dots] = g[all_dots]\n  74:     return out\n  75: \n  76: # --------------- generator (o5x) ---------------\n  77: \n  78: # Canvas and legend geometry.\n  79: GRID_HEIGHT, GRID_WIDTH = 20, 20\n  80: BACKGROUND_COLOR = 0\n  81: LEGEND_COLS = 2\n  82: DOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1\n  83: \n  84: # Legend palette sampling.\n  85: COLORS = tuple(range(1, 10))\n  86: PAIR_COUNT_CHOICES = (2, 3)\n  87: ROTATED_SOURCE_FILL_PROB = 0.45\n  88: \n  89: # Dot-grid shape sampling.\n  90: DOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8\n  91: DOT_COLS_MIN, DOT_COLS_MAX = 2, 5\n  92: \n  93: # Layout search.\n  94: THREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)\n  95: MODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = \"overlap\", \"overlap_any\", \"separate\", \"any\"\n  96: POST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)\n  97: POST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)\n  98: \n  99: # Generation retry budget.\n 100: GENERATION_RETRIES = 300\n 101: \n 102: \n--- generate_input ---\n 348: def generate_input() -> np.ndarray:\n 349:     for _ in range(GENERATION_RETRIES):\n 350:         grid = _gen_attempt()\n 351:         if grid is not None:\n 352:             return grid\n 353:     raise RuntimeError(\"failed to generate a valid 305b1341 input\")\n===== e39e9282.py =====\n--- main ---\n  72: def main(grid: np.ndarray) -> np.ndarray:\n  73:     \"\"\"Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n  74: \n  75:     Input structure\n  76:     The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\n  77:     Rule\n  78:     Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\n  79:     Key insight\n  80:     The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.\n  81:     \"\"\"\n  82:     g = np.asarray(grid, dtype=int)\n  83:     bg = get_bg(g)\n  84:     colors = set(map(int, np.unique(g)))\n  85:     assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}\n  86:     assert Color.MAROON in colors\n  87: \n  88:     squares = _squares(g, bg)\n  89:     out = g.copy()\n  90:     out[g == Color.GREY] = bg\n  91: \n  92:     paint: set[tuple[int, int]] = set()\n  93:     remove_sources: list[tuple[int, int]] = []\n  94:     pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}\n  95:     for r, c in np.argwhere(g == Color.MAROON):\n  96:         hits = []\n  97:         for idx, square in enumerate(squares):\n  98:             side = _touch_side(int(r), int(c), square)\n  99:             if side is not None:\n 100:                 hits.append((side, idx, square))\n 101:         assert len(hits) == 1\n 102: \n 103:         side, idx, square = hits[0]\n 104:         if square[4] == Color.PINK:\n 105:             pink_markers_by_square.setdefault(idx, []).append((int(r), int(c), side))\n 106:             remove_sources.append((int(r), int(c)))\n 107:         else:\n 108:             target = _target_for_marker(int(r), int(c), side, square)\n 109:             tr, tc = target\n 110:             assert g[tr, tc] == square[4]\n 111:             paint.add(target)\n 112: \n 113:     for idx, markers in pink_markers_by_square.items():\n 114:         square = squares[idx]\n 115:         for target in _pink_targets_for_markers(markers, square):\n 116:             tr, tc = target\n 117:             assert g[tr, tc] == square[4]\n 118:             paint.add(target)\n 119: \n 120:     for r, c in remove_sources:\n 121:         out[r, c] = bg\n 122:     for r, c in paint:\n 123:         out[r, c] = Color.MAROON\n 124: \n 125:     return out\n 126: \n 127: # --------------- generator (o5x) ---------------\n 128: \n 129: from arc_utils import paste\n 130: \n 131: \n 132: # Colors.\n 133: _GEN_BG = 8\n 134: _GEN_GREY = 5\n 135: _GEN_PINK = 6\n 136: _GEN_MAROON = 9\n 137: \n 138: # Canvas and square geometry.\n 139: _GEN_CANVAS_MIN = 9\n 140: _GEN_CANVAS_MAX = 15\n 141: _GEN_CANVAS_MAX_DELTA = 2\n 142: _GEN_SQUARE_SIZE = 3\n 143: _GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1\n 144: _GEN_SQUARE_GAP = 1\n 145: \n 146: # Square count bounds.\n 147: _GEN_TOTAL_SQUARE_MIN = 1\n 148: _GEN_TOTAL_SQUARE_MAX = 7\n 149: _GEN_GREY_SQUARE_MAX = 3\n 150: _GEN_PINK_SQUARE_MAX = 4\n 151: \n 152: # Marker side and count bounds.\n 153: _GEN_SIDES = (\"left\", \"right\", \"above\", \"below\")\n 154: _GEN_MARKER_SIDE_MIN = 1\n 155: _GEN_MARKER_SIDE_MAX = 3\n 156: _GEN_MARKER_PER_SIDE_MAX = 3\n 157: _GEN_MARKER_TOTAL_MAX = 5\n 158: \n 159: # Rejection sampling budget.\n 160: _GEN_MAX_ATTEMPTS = 300\n 161: _GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}\n 162: \n 163: _GenSquare = tuple[int, int, int]\n 164: _GenMarker = tuple[int, int, str]\n 165: \n 166: \n--- generate_input ---\n 428: def generate_input() -> np.ndarray:\n 429:     for _ in range(_GEN_MAX_ATTEMPTS):\n 430:         grid = _gen_attempt()\n 431:         if grid is not None:\n 432:             return grid\n 433:     raise RuntimeError(\"failed to generate valid e39e9282 input\")\n","exit_code":0,"status":"completed"}}
