() if int(c) != int(bg) and int(n) == 3]):\n  33:         pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]\n  34:         rs = [r for r, _ in pts]\n  35:         cs = [c for _, c in pts]\n  36:         r0, r1 = min(rs), max(rs)\n  37:         c0, c1 = min(cs), max(cs)\n  38:         if (r1 - r0) == 1 and (c1 - c0) == 1:\n  39:             all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n  40:             miss = list(all4 - set(pts))\n  41:             if len(miss) == 1:\n  42:                 mark = int(col)\n  43:                 missing = miss[0]\n  44:                 mb = (r0, c0, r1, c1)\n  45:                 break\n  46: \n  47:     assert not (mark is None or missing is None or mb is None)\n  48: \n  49:     r0, c0, r1, c1 = mb\n  50:     # Rectangle corner is opposite the marker bulk.\n  51:     if missing == (r0, c0):\n  52:         corner = \"BR\"\n  53:     elif missing == (r0, c1):\n  54:         corner = \"BL\"\n  55:     elif missing == (r1, c0):\n  56:         corner = \"TR\"\n  57:     else:\n  58:         corner = \"TL\"\n  59: \n  60:     # Decompose occupied mask (non-bg and non-marker) into rectangles.\n  61:     occ = (g != int(bg)) & (g != int(mark))\n  62:     used = np.zeros_like(occ, dtype=bool)\n  63:     rects = []  # (r, c, h, w, arr)\n  64:     while True:\n  65:         idx = np.argwhere(occ & (~used))\n  66:         if idx.size == 0:\n  67:             break\n  68:         rr, cc = map(int, idx[0])\n  69:         w = 0\n  70:         while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):\n  71:             w += 1\n  72:         h = 0\n  73:         while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):\n  74:             h += 1\n  75:         used[rr : rr + h, cc : cc + w] = True\n  76:         rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))\n  77: \n  78:     total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))\n  79: \n  80: 