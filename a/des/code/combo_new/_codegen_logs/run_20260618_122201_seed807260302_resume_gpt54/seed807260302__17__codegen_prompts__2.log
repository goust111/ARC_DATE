ker sprite is a directional tail; the cross is the leading payload,\n  74:     and only that payload turns around during the slide to the edge.\n  75:     \"\"\"\n  76:     g = np.asarray(grid, dtype=int)\n  77:     H, W = g.shape\n  78:     bg = get_bg(g)\n  79:     marker = _marker_color(g, bg)\n  80: \n  81:     out = np.full_like(g, int(bg))\n  82:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n  83:     assert objects, \"expected at least one composite object\"\n  84: \n  85:     for obj in objects:\n  86:         assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n  87:         r0, c0, _r1, _c1 = obj[\"bbox\"]\n  88:         patch = crop_bbox(g, obj[\"bbox\"])\n  89:         h, w = patch.shape\n  90:         moved = patch.copy()\n  91: \n  92:         if (h, w) == (3, 6):\n  93:             left = patch[:, :3]\n  94:             right = patch[:, 3:]\n  95:             left_kind = _block_kind(left, bg, marker)\n  96:             right_kind = _block_kind(right, bg, marker)\n  97:             assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n  98: \n  99:             if left_kind == \"marker\":\n 100:                 moved[:, 3:] = np.rot90(right, 2)\n 101:                 target_r, target_c = int(r0), W - w\n 102:             else:\n 103:                 moved[:, :3] = np.rot90(left, 2)\n 104:                 target_r, target_c = int(r0), 0\n 105: \n 106:         elif (h, w) == (6, 3):\n 107:             top = patch[:3, :]\n 108:             bottom = patch[3:, :]\n 109:             top_kind = _block_kind(top, bg, marker)\n 110:             bottom_kind = _block_kind(bottom, bg, marker)\n 111:             assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n 112: \n 113:             if top_kind == \"marker\":\n 114:                 moved[3:, :] = np.rot90(bottom, 2)\n 115:                 target_r, target_c 