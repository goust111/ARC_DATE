ncodes turn direction.\n  73:     - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n  74: \n  75:     Rule:\n  76:     - Remove the legend from the output.\n  77:     - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n  78:     - Each beam paints teal over bg cells as it moves.\n  79:     - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n  80:     - Beams stop at grid edges.\n  81: \n  82:     Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n  83:     \"\"\"\n  84:     g = np.asarray(grid, dtype=int)\n  85: \n  86:     # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n  87:     # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n  88:     legend_bg = 5\n  89:     rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n  90:     assert rows_with_legend.size, \"legend rows must be present\"\n  91:     legend_h = int(rows_with_legend.max() + 1)\n  92:     assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n  93: \n  94:     legend_turn = _parse_legend(g, legend_h)\n  95: \n  96:     base = g[legend_h:, :].copy()\n  97:     assert base.size, \"main grid must remain after legend crop\"\n  98: \n  99:     _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n 100:     teal = 8\n 101:     src = _find_teal_square(base, teal=teal)\n 102:     sr, sc, sz = src\n 103: \n 104:     out = base.copy()\n 105: \n 106:     def in_bounds(r: int, c: int) -> bool:\n 107:         return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n 108: \n 109:     def paint_block(r: int, c: int) -> None:\n 110:         blk = out[r : r + sz, c : c + sz]\n 111:         blk[blk == bg] = teal\n 112:         out[r : r + sz, c : c + sz] = blk\n 113: \n 114:     def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n 115:         blk = out[nr : nr + sz, nc : nc + sz]\n 116:         cols = set(map(int, np.unique(blk)))\n 117:         cols.discard(bg)\n 118:         cols.discard(teal)\n 119:         if not cols:\n 120:             return None\n 121:         assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n 122:         return int(next(iter(cols)))\n 123: \n 124:     # Four beams, each is a moving copy of the teal square.\n 125:     for d0 in range(4):\n 126:         r, c, d = sr, sc, d0\n 127:         seen: set[tuple[int, int, int]] = set()\n 128:         while True:\n 129:             state = (r, c, d)\n 130:             assert state not in seen, \"beam path must not cycle\"\n 131:             seen.add(state)\n 132: \n 133:             dr, dc = _DIRS[d]\n 134:             nr, nc = r + dr, c + dc\n 135:             if not in_bounds(nr, nc):\n 136:                 break\n 137: \n 138:             oc = obstacle_color_at_next(nr, nc)\n 139:             if oc is None:\n 140:                 r, c = nr, nc\n 141:                 paint_block(r, c)\n 142:                 continue\n 143: \n 144:             assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n 145:             turn = legend_turn[oc]\n 146:             d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n 147: \n 148:     return out\n 149: \n 150: # --------------- generator (o5x) ---------------\n 151: \n 152: # ── Configuration ──────────────────────────────────────────────────────\n 153: _DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n 154: _N, _E, _S, _W = range(4)\n 155: \n 156: # Color palettes\n 157: LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\n 158: BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\n 159: