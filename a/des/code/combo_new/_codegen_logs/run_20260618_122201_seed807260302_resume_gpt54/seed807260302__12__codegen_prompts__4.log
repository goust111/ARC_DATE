{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\nimport random\nimport numpy as np\n\nWALL=2\nBG=0\nSEED_COLORS=[1,3,4,5,6,7,8,9]\n\ndef neighbors4(r,c):\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n        yield r+dr,c+dc\n\ndef component_regions(g):\n    H,W=g.shape\n    comp=np.full((H,W),-1,int)\n    regs=[]\n    cid=0\n    for r in range(H):\n        for c in range(W):\n            if g[r,c]==WALL or comp[r,c]\"'!=-1:\n                continue\n            q=deque([(r,c)])\n            comp[r,c]=cid\n            cells=[]\n            seeds=[]\n            while q:\n                x,y=q.popleft(); cells.append((x,y))\n                if g[x,y] not in (BG,WALL):\n                    seeds.append((x,y))\n                for nx,ny in neighbors4(x,y):\n                    if 0<=nx<H and 0<=ny<W and g[nx,ny]!=WALL and comp[nx,ny]==-1:\n                        comp[nx,ny]=cid; q.append((nx,ny))\n            regs.append((cells,seeds))\n            cid+=1\n    return comp,regs\n\ndef adjacency(g, valid):\n    H,W=g.shape\n    comp,regs=component_regions(g)\n    adj={cid:set() for cid in valid}\n    for r in range(H):\n        for c in range(W):\n            if g[r,c]!=WALL:\n                continue\n            lr=comp[r,c-1] if c-1>=0 and g[r,c-1]!=WALL else -1\n            rr=comp[r,c+1] if c+1<W and g[r,c+1]!=WALL else -1\n            ur=comp[r-1,c] if r-1>=0 and g[r-1,c]!=WALL else -1\n            dr=comp[r+1,c] if r+1<H and g[r+1,c]!=WALL else -1\n            for a,b in ((lr,rr),(ur,dr)):\n                if a in valid and b in valid and a!=b:\n                    adj[a].add(b); adj[b].add(a)\n    return comp,regs,adj\n\ndef distances(g,cells):\n    H,W=g.shape\n    reg=set(cells)\n    dist={}\n    q=deque()\n    for r,c in cells:\n        if any(0<=nr<H and 0<=nc<W and g[nr,nc]==WALL for nr,nc in neighbors4(r,c)):\n            dist[(r,c)]=0; q.append((r,c))\n    while q:\n        r,c=q.popleft()\n        for nr,nc in neighbors4(r,c):\n            if (nr,nc) in reg and (nr,nc) not in dist:\n                dist[(nr,nc)]=dist[(r,c)]+1; q.append((nr,nc))\n    return dist\n\ndef main(g):\n    g=np.array(g,dtype=int)\n    comp,regs=component_regions(g)\n    valid=[]\n    seed_color={}\n    cells_by={}\n    for cid,(cells,seeds) in enumerate(regs):\n        if len(seeds)==1:\n            valid.append(cid)\n            seed_color[cid]=int(g[seeds[0]])\n            cells_by[cid]=cells\n    valid=set(valid)\n    adj={cid:set() for cid in valid}\n    H,W=g.shape\n    for r in range(H):\n        for c in range(W):\n            if g[r,c]!=WALL:\n                continue\n            lr=comp[r,c-1] if c-1>=0 and g[r,c-1]!=WALL else -1\n            rr=comp[r,c+1] if c+1<W and g[r,c+1]!=WALL else -1\n            ur=comp[r-1,c] if r-1>=0 and g[r-1,c]!=WALL else -1\n            dr=comp[r+1,c] if r+1<H and g[r+1,c]!=WALL else -1\n            for a,b in ((lr,rr),(ur,dr)):\n                if a in valid and b in valid and a!=b:\n                    adj[a].add(b); adj[b].add(a)\n    out=g.copy()\n    for cid in valid:\n        for r,c in cells_by[cid]:\n            out[r,c]=BG\n        d=distances(g,cells_by[cid])\n        n=len(adj[cid])\n        for (r,c),x in d.items():\n            if x < n:\n                out[r,c]=seed_color[cid]\n    return out\n\ndef grow_partition(rows, cols, k):\n    cells=[(r,c) for r in range(rows) for c in range(cols)]\n    seeds=random.sample(cells,k)\n    assign={cell:i for i,cell in enumerate(seeds)}\n    front=[set() for _ in range(k)]\n    for i,cell in enumerate(seeds):\n        r,c=cell\n        for nr,nc in neighbors4(r,c):\n            if 0<=nr<rows and 0<=nc<cols and (nr,nc) not in assign:\n                front[i].add((nr,nc))\n    unassigned=set(cells)-set(seeds)\n    while unassigned:\n        cands=[i for i in range(k) if any(cell in unassigned for cell in front[i])]\n        if not cands:\n            return None\n        i=random.choice(cands)\n        options=[cell for cell in front[i] if cell in unassigned]\n        cell=random.choice(options)\n        assign[cell]=i\n        unassigned.remove(cell)\n        r,c=cell\n        for nr,nc in neighbors4(r,c):\n            if 0<=nr<rows and 0<=nc<cols and (nr,nc) in unassigned:\n                front[i].add((nr,nc))\n    arr=np.zeros((rows,cols),int)\n    for (r,c),i in assign.items(): arr[r,c]=i\n    return arr\n\ndef render(reg, s):\n    rows,cols=reg.shape\n    H=rows*s+(rows+1)\n    W=cols*s+(cols+1)\n    g=np.full((H,W),WALL,int)\n    for r in range(rows):\n        for c in range(cols):\n            r0=1+r*(s+1)\n            c0=1+c*(s+1)\n            g[r0:r0+s,c0:c0+s]=BG\n            if c+1<cols and reg[r,c]==reg[r,c+1]:\n                g[r0:r0+s,c0+s]=BG\n            if r+1<rows and reg[r,c]==reg[r+1,c]:\n                g[r0+s,c0:c0+s]=BG\n    return g\n\ndef region_stats(g):\n    comp,regs,adj=adjacency(g, set(range(len(component_regions(g)[1]))))\n\ndef make():\n    for _ in range(500):\n        s=random.choice([3,4])\n        max_dim=5 if s==4 else 6\n        rows=random.randint(3,max_dim)\n        cols=random.randint(3,max_dim)\n        k=random.randint(2,min(8, rows*cols-1))\n        reg=grow_partition(rows,cols,k)\n        if reg is None:\n            continue\n        # coarse adjacency counts\n        adj={i:set() for i in range(k)}\n        for r in range(rows):\n            for c in range(cols):\n                if r+1<rows and reg[r,c]!=reg[r+1,c]:\n                    a,b=int(reg[r,c]),int(reg[r+1,c]); adj[a].add(b); adj[b].add(a)\n                if c+1<cols and reg[r,c]!=reg[r,c+1]:\n                    a,b=int(reg[r,c]),int(reg[r,c+1]); adj[a].add(b); adj[b].add(a)\n        counts=[len(adj[i]) for i in range(k)]\n        if max(counts) < 2 or len(set(counts)) < 2:\n            continue\n        g=render(reg,s)\n        comp,regs=component_regions(g)\n        if len(regs)!=k:\n            continue\n        # place seeds near center\n        colors=random.sample(SEED_COLORS,k)\n        full=False; partial=False\n        for cid,(cells,seeds) in enumerate(regs):\n            d=distances(g,cells)\n            md=max(d.values())\n            if counts[cid] > md:\n                full=True\n            if counts[cid] <= md:\n                partial=True\n            best=max(d.values())\n            options=[p for p,v in d.items() if v==best]\n            r,c=random.choice(options)\n            g[r,c]=colors[cid]\n        if not (full and partial):\n            continue\n        out=main(g)\n        if out.shape != g.shape or np.array_equal(out,g):\n            continue\n        return g, out, counts\n    return None\n\nres=make()\nprint('\"'ok?', res is not None)\nif res:\n    g,o,counts=res\n    print(g.shape, counts)\n    print('colors', sorted(set(g.flatten())))\n    print('diff', np.count_nonzero(g\"'!=o))\n    for row in g: print('\"''.join(map(str,row)))\n    print('---')\n    for row in o: print(''.join(map(str,row)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
