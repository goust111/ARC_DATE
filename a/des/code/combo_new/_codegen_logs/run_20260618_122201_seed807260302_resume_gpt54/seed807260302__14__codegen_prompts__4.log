{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b10624e5.py',\n'/home/lixinyu/snap/new/ARC_code/train/bae5c565.py',\n]\nfor path in files:\n    print(f'===== {Path(path).name} =====')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        i = text.index(name)\n        j = text.find('\\\\ndef ', i + 1)\n        if j == -1:\n            j = len(text)\n        block = text[i:j].strip('\\\\n')\n        lines = block.splitlines()\n        if len(lines) > 140:\n            lines = lines[:140] + ['... [truncated]']\n        print('\\\\n'.join(lines))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b10624e5.py',\n'/home/lixinyu/snap/new/ARC_code/train/bae5c565.py',\n]\nfor path in files:\n    print(f'===== {Path(path).name} =====')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        i = text.index(name)\n        j = text.find('\\\\ndef ', i + 1)\n        if j == -1:\n            j = len(text)\n        block = text[i:j].strip('\\\\n')\n        lines = block.splitlines()\n        if len(lines) > 140:\n            lines = lines[:140] + ['... [truncated]']\n        print('\\\\n'.join(lines))\n        print()\nPY\"","aggregated_output":"===== 88e364bc.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n\n===== 3cd86f4f.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== b10624e5.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.\n\n    Input structure:\n    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.\n    - Each quadrant contains a red (2) square anchor block of varying size.\n    - The top-left quadrant also has a colored motif attached to its red anchor.\n\n    Rule:\n    - Use the top-left quadrant's motif as the source pattern.\n    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.\n    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).\n    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.\n\n    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    out = g.copy()\n\n    bg = get_bg(g)\n    mid_r, mid_c = _find_dividers(g, bg)\n\n    # Find red anchor blocks (color 2) in each quadrant.\n    red = components_mask(g == 2, connectivity=4)\n    assert red, \"grid must contain red (color 2) anchor blocks\"\n\n    # Quadrant key: (top/bottom, left/right)\n    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}\n    # value: (r0,c0,size)\n    for pts in red:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        rr = (r0 + r1) // 2\n        cc = (c0 + c1) // 2\n        qb = 0 if rr < mid_r else 1\n        qr = 0 if cc < mid_c else 1\n        size = max(r1 - r0 + 1, c1 - c0 + 1)\n        key = (qb, qr)\n        assert key not in anchors, \"each quadrant must contain exactly one red anchor block\"\n        anchors[key] = (int(r0), int(c0), int(size))\n\n    assert (0, 0) in anchors, \"top-left quadrant must contain a red anchor block\"\n    sr0, sc0, sL = anchors[(0, 0)]\n    assert sL > 0, \"top-left red anchor must have positive size\"\n\n    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)\n    # in the TL quadrant that contains the TL red anchor.\n    tl = g[0:mid_r, 0:mid_c]\n    comps = components_mask(tl != bg, connectivity=4)\n    patch_bb = None\n    for pts in comps:\n        # component contains any red pixel?\n        if any(tl[r, c] == 2 for r, c in pts):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            patch_bb = (int(r0), int(c0), int(r1), int(c1))\n            break\n    assert patch_bb is not None, \"top-left quadrant must contain a non-bg component with a red pixel\"\n\n    pr0, pc0, pr1, pc1 = patch_bb\n    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()\n\n    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n        src_h, src_w = img.shape\n        if new_h <= 0 or new_w <= 0:\n            return img.copy()\n        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)\n        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)\n        rr = np.clip(rr, 0, src_h - 1)\n        cc = np.clip(cc, 0, src_w - 1)\n        return img[rr[:, None], cc[None, :]]\n\n    # For each quadrant anchor, paste a scaled/reflected version of the patch.\n    for (qb, qr), (tr0, tc0, tL) in anchors.items():\n        if (qb, qr) == (0, 0):\n            continue\n        patch_t = patch\n        if qr == 1:\n            patch_t = np.fliplr(patch_t)\n        if qb == 1:\n            patch_t = np.flipud(patch_t)\n\n        ratio = float(tL) / float(sL)\n        new_h = int(round(patch_t.shape[0] * ratio))\n        new_w = int(round(patch_t.shape[1] * ratio))\n        new_h = max(1, new_h)\n        new_w = max(1, new_w)\n        patch_s = resize_nn(patch_t, new_h, new_w)\n        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])\n        assert np.array_equal(roundtrip, patch_t), \"scaling must preserve all motif information\"\n\n        # Align scaled red bbox in patch_s to the target red bbox.\n        rr_red, cc_red = np.where(patch_s == 2)\n        assert rr_red.size > 0, \"scaled source patch must contain red anchor pixels\"\n        ar0, ac0 = int(rr_red.min()), int(cc_red.min())\n        place_r0 = tr0 - ar0\n        place_c0 = tc0 - ac0\n\n        rr_p, cc_p = np.where(patch_s != bg)\n        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):\n            val = int(patch_s[rr0, cc0])\n            rr_t = place_r0 + rr0\n            cc_t = place_c0 + cc0\n            if not (0 <= rr_t < h and 0 <= cc_t < w):\n                continue\n            if rr_t == mid_r or cc_t == mid_c:\n                continue\n            if out[rr_t, cc_t] == 2:\n                continue\n            out[rr_t, cc_t] = val\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Grid constants ---\nBG = 4                  # background color\nDIV = 1                 # divider color\nRED = 2                 # anchor color\nGRID_SIZE = 27          # full grid dimension\nMID = 13                # divider row/col index\nQUADS = {               # (row_lo, row_hi, col_lo, col_hi) inclusive per quadrant\n    (0, 0): (0, 12, 0, 12),\n    (0, 1): (0, 12, 14, 26),\n    (1, 0): (14, 26, 0, 12),\n    (1, 1): (14, 26, 14, 26),\n}\n\n# --- Source motif parameters ---\nSOURCE_ANCHOR_SIZE = 2                  # TL anchor is always 2x2\nBLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]  # logical block sizes for block method\nBLOCK_PROB = 0.5                        # prob of block method when not forced\nFILL_RATIO_MIN = 0.5                    # minimum motif fill ratio\nFILL_RATIO_MAX = 0.8                    # maximum motif fill ratio\nFREEFORM_H_RANGE = (3, 6)              # freeform motif height range\nFREEFORM_W_RANGE = (3, 6)              # freeform motif width range\nMOTIF_COLORS_MIN = 3                    # min distinct non-bg colors (including red)\nMOTIF_COLORS_MAX = 5                    # max distinct non-bg colors\nCOLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors\n\n... [truncated]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid b10624e5 input\")\n\n===== bae5c565.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.\n\n    Input structure\n    - The top row is a palette row with exactly one background gap.\n    - Below it, the only foreground is one vertical marker bar of a single color.\n    - The marker bar is either in the gap column or immediately beside it.\n\n    Rule\n    - Clear the grid to background.\n    - Starting at the top of the marker bar, each next row copies one more\n      column of the top-row palette on both sides of the gap.\n    - Fill the gap column with the marker color, and keep the vertical marker bar.\n\n    Key insight\n    - The lone background cell in the top row is the center of the expanding\n      copy; the lower vertical bar provides the center color and the row where\n      the expansion begins.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    height, width = g.shape\n\n    bg = get_bg(g)\n    top = g[0, :]\n    gap_cols = np.flatnonzero(top == bg)\n    assert gap_cols.size == 1, \"expected exactly one background gap in the top row\"\n    gap_col = int(gap_cols[0])\n\n    lower_coords = np.argwhere(g[1:, :] != bg)\n    assert lower_coords.size > 0, \"expected a lower marker bar\"\n    lower_coords[:, 0] += 1\n\n    marker_colors = {int(g[r, c]) for r, c in lower_coords}\n    marker_cols = {int(c) for _r, c in lower_coords}\n    assert len(marker_colors) == 1, \"expected one lower marker color\"\n    assert len(marker_cols) == 1, \"expected one lower marker column\"\n    marker = marker_colors.pop()\n    line_col = marker_cols.pop()\n    line_start = int(lower_coords[:, 0].min())\n\n    assert np.all(g[1:line_start, :] == bg), \"rows before the marker bar must be background\"\n    assert np.all(g[line_start:, line_col] == marker), \"marker bar must be solid\"\n    assert lower_coords.shape[0] == height - line_start, \"marker bar must be the only lower foreground\"\n    assert line_col == gap_col or abs(line_col - gap_col) == 1\n    if line_col != gap_col:\n        assert top[line_col] == marker\n    assert np.all(top[np.arange(width) != gap_col] != bg), \"only the gap may be background in the palette row\"\n\n    out = np.full_like(g, bg)\n    out[line_start:, line_col] = marker\n\n    for r in range(line_start, height):\n        radius = r - line_start\n        c0 = max(0, gap_col - radius)\n        c1 = min(width - 1, gap_col + radius)\n        for c in range(c0, c1 + 1):\n            if radius == 0 and c == gap_col and line_col != gap_col:\n                continue\n            out[r, c] = marker if c == gap_col else int(top[c])\n        out[r, line_col] = marker\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas, structure, and retries.\n_CANVAS_SIZES = (9, 11, 13)\n_LINE_START_MIN = 2\n_MAX_ATTEMPTS = 300\n# Color roles.\n_BACKGROUND, _MARKER = 5, 8\n_PALETTE_COLORS = (0, 1, 2, 3, 4, 6, 7, 8, 9)\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid bae5c565 input\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py',\n'/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py',\n'/home/lixinyu/snap/new/ARC_code/train/11dc524f.py',\n]\nfor path in files:\n    print(f'===== {Path(path).name} =====')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        i = text.index(name)\n        j = text.find('\\\\ndef ', i + 1)\n        if j == -1:\n            j = len(text)\n        block = text[i:j].strip('\\\\n')\n        lines = block.splitlines()\n        if len(lines) > 140:\n            lines = lines[:140] + ['... [truncated]']\n        print('\\\\n'.join(lines))\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/21897d95.py',\n'/home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py',\n'/home/lixinyu/snap/new/ARC_code/train/5adee1b2.py',\n'/home/lixinyu/snap/new/ARC_code/train/11dc524f.py',\n]\nfor path in files:\n    print(f'===== {Path(path).name} =====')\n    text = Path(path).read_text()\n    for name in ['def main', 'def generate_input']:\n        i = text.index(name)\n        j = text.find('\\\\ndef ', i + 1)\n        if j == -1:\n            j = len(text)\n        block = text[i:j].strip('\\\\n')\n        lines = block.splitlines()\n        if len(lines) > 140:\n            lines = lines[:140] + ['... [truncated]']\n        print('\\\\n'.join(lines))\n        print()\nPY\"","aggregated_output":"===== 21897d95.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.\n\n    Input structure:\n    - The grid is a mosaic of monochrome regions.\n    - Color 1 forms T-shaped control markers on region boundaries.\n    - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.\n    - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.\n\n    Rule:\n    - For a color-1 T marker, the single stem points at the destination region to repaint.\n    - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.\n    - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.\n    - All marker cells are filled with the final color of the source-side region.\n    - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.\n\n    Key insight:\n    - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = _solve_unrotated(g)\n    l9 = _find_l9_orientation(g)\n    if l9 == 'top_right':\n        return np.rot90(out, 1)\n    if l9 == 'top_left':\n        return np.rot90(out, 3)\n    return out\n\n# --------------- generator (l9rot) ---------------\n\n# ── Tunable constants ──────────────────────────────────────────────────\n# Canvas / region sizing\nGRID_SIZE_MAX = 30                          # max rows or cols\nMIN_REGION_CELLS = 6                        # per-spec minimum\nREGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)\nREGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts\nREGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS\n\n# Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)\nMARKER_MIN = 4\nMARKER_MAX = 8\nNORMAL_MAX = 6\nCOLORED_MAX = 2\n\n# Color pool (all ARC colors except 1, which is reserved for T-marker cells)\nCOLOR_POOL = [c for c in range(10) if c != 1]\n\n# L9 rotation marker\nL9_PROBABILITY = 0.5                        # chance of placing a rotation marker\nL9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation\n    'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],\n    'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],\n}\n\n# Generation retry budget\nSEED_ATTEMPTS = 200                         # tries to place n distinct region seeds\nGEN_RETRIES = 300                           # outer generate_input retry budget\n\n_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\n# ── Small geometry helpers ─────────────────────────────────────────────\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n===== 6e4f6532.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock train sprites onto station groups by matching coupler count, then orient via divider-color markers.\n\n    Input structure:\n    - bg; colored stripes (edge + internal) partition grid into rectangular regions.\n    - Color 8 forms train bodies; color 9 marks both isolated stations and train-attached couplers.\n    - Stripe-colored pixels on trains are orientation markers.\n\n    Rule:\n    - Stations = 8-connected 9-clusters not adjacent to any 8. Trains = components containing 8.\n    - Match train to station group where |couplers| == |station size|.\n    - Rotate/flip train so marker pixels face the same-color boundary stripe of the target region.\n    - Translate so couplers align exactly onto station cells; erase original position.\n\n    Key insight: Coupler count selects the docking target; marker color encodes which boundary stripe to face, fixing the unique orientation.\n    \"\"\"\n    inp = grid\n    grid = inp.copy()\n    H, W = grid.shape\n    bg = get_bg(grid)\n\n    # This puzzle's code is long because it reconstructs several \"structures\"\n    # that are implicit in the grid:\n    # - divider stripes (edge + internal) that partition the canvas into regions\n    # - station groups = 9-clusters not adjacent to any 8\n    # - train sprites = components containing 8 (with attached 9 \"couplers\")\n    # Then, for each train:\n    # - match target region by COUPLER COUNT (|couplers| == |station group|)\n    # - choose orientation by divider-color markers (face region boundary stripes)\n    # - translate so couplers land exactly onto the station group cells\n\n    def find_edge_stripes():\n        # Detect thick constant-color border stripes.\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Top edge\n        top_h = 0\n        for r in range(H):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                top_h += 1\n            else:\n                break\n        if top_h:\n            stripe[:top_h, :] = True\n            colors.add(int(grid[0, 0]))\n        # Bottom edge\n        bot_h = 0\n        for r in range(H - 1, -1, -1):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                bot_h += 1\n            else:\n                break\n        if bot_h:\n            stripe[H - bot_h :, :] = True\n            colors.add(int(grid[H - 1, 0]))\n        inner_r0, inner_r1 = top_h, H - bot_h\n        # Left edge (in inner rows)\n        left_w = 0\n        for c in range(W):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                left_w += 1\n            else:\n                break\n        if left_w:\n            stripe[inner_r0:inner_r1, :left_w] = True\n            colors.add(int(grid[inner_r0, 0]))\n        # Right edge\n        right_w = 0\n        for c in range(W - 1, -1, -1):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                right_w += 1\n            else:\n                break\n        if right_w:\n            stripe[inner_r0:inner_r1, W - right_w :] = True\n            colors.add(int(grid[inner_r0, W - 1]))\n        return stripe, colors, (top_h, bot_h, left_w, right_w)\n\n    def find_internal_stripes(edge_info):\n        # Detect internal constant-color stripes in the inner rectangle.\n        top_h, bot_h, left_w, right_w = edge_info\n        r0, r1, c0, c1 = top_h, H - bot_h, left_w, W - right_w\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Vertical internal stripes\n        c = c0\n        while c < c1:\n            col = grid[r0:r1, c]\n            if col.size and (col == col[0]).all() and col[0] != bg:\n                color = int(col[0])\n                c2 = c\n                while c2 + 1 < c1:\n                    col2 = grid[r0:r1, c2 + 1]\n                    if col2.size and (col2 == col2[0]).all() and int(col2[0]) == color:\n                        c2 += 1\n                    else:\n                        break\n                stripe[r0:r1, c : c2 + 1] = True\n                colors.add(color)\n                c = c2 + 1\n            else:\n                c += 1\n        # Horizontal internal stripes\n        r = r0\n        while r < r1:\n            row = grid[r, c0:c1]\n            if row.size and (row == row[0]).all() and row[0] != bg:\n                color = int(row[0])\n                r2 = r\n                while r2 + 1 < r1:\n                    row2 = grid[r2 + 1, c0:c1]\n                    if row2.size and (row2 == row2[0]).all() and int(row2[0]) == color:\n                        r2 += 1\n                    else:\n                        break\n                stripe[r : r2 + 1, c0:c1] = True\n                colors.add(color)\n                r = r2 + 1\n            else:\n                r += 1\n        return stripe, colors\n\n    def station_groups():\n        # Stations are 9 pixels with no adjacent 8 in the 8-neighborhood.\n        # Station groups are 8-connected components of those station pixels.\n        # Station 9s have no adjacent 8 in 8-neighborhood\n        sm = np.zeros((H, W), dtype=bool)\n        for r in range(H):\n            for c in range(W):\n                if grid[r, c] != 9:\n                    continue\n... [truncated]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 6e4f6532 input\")\n\n===== 5adee1b2.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n===== 11dc524f.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\ndef generate_input() -> np.ndarray:\n    for _ in range(RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 11dc524f input\")\n\n","exit_code":0,"status":"completed"}}
