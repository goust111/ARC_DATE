e.py:3:# Name: 折叠矩阵+渐变颜色\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:10:#    cycle over the snake palette, and the traced 1-D stream is then folded into a matrix whose\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:16:#      combo output = fold width 3 in boustrophedon rows:\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:21:#    many columns the folded output must have.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:24:#    count, with at least 4 folded rows. This keeps the repeated cycle obvious and gives several\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:25:#    row/column repetitions, so humans can see the fold width instead of guessing from a single\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:40:#    output is not a column anymore: it is a folded rectangle whose column patterns depend on the\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:45:#    only the folded color matrix. No extra markers or overlays are added, so the visual field\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:55:#    - Assumption: folded width equals the number of distinct snake colors and divides the length.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:58:#      Guaranteed by rejecting samples where top-left traversal yields the same folded matrix.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:108:def _fold_colors(colors: list[int], width: int) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:112:        raise ValueError(\"Color stream cannot be folded into a full matrix\")\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:163:    then fold that color stream into a boustrophedon matrix whose width is the cycle length.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:169:    return _fold_colors(colors, len(palette))\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:217:    correct_out = _fold_colors(correct_colors, width)\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:222:    top_left_out = _fold_colors(top_left_colors, width)\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/28/code.py:296:    expected_out = _fold_colors(colors, color_count)\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:26:    assert len(hits) == 1, \"each motif pixel must lie inside one scaffold cell\"\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:32:    Copy the rare-colored motif into every same-parity cell of the scaffold grid.\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:35:    - The background surrounds one scaffold color that forms full horizontal and vertical separator lines.\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:36:    - A second foreground color appears only as a small motif inside one open scaffold cell.\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:39:    - Split rows and columns into open cells between the full scaffold separator lines.\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:44:    - The scaffold turns the grid into a checkerboard of cells; the seed motif marks which parity class should receive copies.\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:52:    assert len(colors) == 2, \"expected exactly one scaffold color and one motif color\"\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:54:    scaffold_candidates: list[tuple[int, np.ndarray, np.ndarray]] = []\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:60:            scaffold_candidates.append((color, row_lines, col_lines))\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:62:    assert len(scaffold_candidates) == 1, \"expected one color to define full scaffold lines\"\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:63:    scaffold_color, row_lines, col_lines = scaffold_candidates[0]\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:64:    motif_colors = [color for color in colors if int(color) != scaffold_color]\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:65:    assert len(motif_colors) == 1, \"expected one non-scaffold motif color\"\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:70:    assert row_cells and col_cells, \"scaffold must leave open cells\"\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:102:# Canvas/scaffold geometry.\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:121:def _sample_scaffold_layout() -> tuple[int, np.ndarray, list[tuple[int, int]]]:\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:173:    side, separators, cells = _sample_scaffold_layout()\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:174:    scaffold_color, motif_color = map(int, np.random.permutation(FOREGROUND_COLORS)[:FOREGROUND_PAIR_SIZE])\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:176:    out[separators, :] = scaffold_color\n/home/lixinyu/snap/new/ARC1_code/eval/92e50de0.py:177:    out[:, separators] = scaffold_color\n/home/lixinyu/snap/new/ceshi/code_combo/d59b0160/25/code.py:185:    Scaffold color 0 is excluded from ranking on purpose: the combo rule is meant to be\n/home/lixinyu/snap/new/ceshi/code_combo/d59b0160/25/code.py:236:    - Elsewhere: 4-connected components on the bg, each with a black scaffold and 6 colored accent blobs of different sizes.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:3:# Name: 折叠+标记起点+图例方向\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:15:#        step 3: fold the color stream into a matrix whose side K equals the\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:20:#        This combo with horizontal legend -> row-wise snake fold:\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:23:#        Same traced colors with vertical legend -> column-wise snake fold:\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:28:#      before folding, so both the read direction and the fold direction matter.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:31:#      at least 4 chunks. This keeps the output visibly rectangular in both fold\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:44:#      now: output is a folded matrix, and legend orientation chooses row-wise vs\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:48:#      matrix. The combined interpretation is therefore \"legend selects fold axis\",\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:63:#      short-wide or transposed-looking; this makes the fold-axis cue visible.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:76:#      opposite fold axis would accidentally produce the same output. This ensures\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:210:def _fold_colors(colors: list[int], width: int, fold_by_rows: bool) -> np.ndarray:\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:212:        raise ValueError(\"invalid fold dimensions\")\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:215:    if fold_by_rows:\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:243:    fold_by_rows = len({r for r, _ in legend}) == 1\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:251:        return fold_by_rows, [], None\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:256:    return fold_by_rows, snake, marker\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:272:    - trace the snake and fold the resulting color stream into a boustrophedon\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:276:    - horizontal corner legend => fold by rows;\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:277:    - vertical corner legend => fold by columns.\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:282:    fold_by_rows, path_pts, marker = _decode_scene(g, bg)\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:296:    return _fold_colors(colors, width, fold_by_rows)\n/home/lixinyu/snap/new/ceshi/code_combo/7b5033c1/23/code.py:370:def _legend_cel