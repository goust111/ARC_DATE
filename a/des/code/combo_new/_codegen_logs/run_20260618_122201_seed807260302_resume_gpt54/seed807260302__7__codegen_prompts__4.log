w/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixi