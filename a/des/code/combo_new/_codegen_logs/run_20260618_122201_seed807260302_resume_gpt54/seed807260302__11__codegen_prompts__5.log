nMIN_OVERLAP_DENSITY = 0.57\nLAYOUT_ATTEMPTS = 50\nPLACEMENT_ATTEMPTS = 150\nGENERATION_ATTEMPTS = 300\n\n\ndef _choose_ordering(rng):\n","exit_code":0,"status":"completed"}}
