{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom collections import Counter\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed807260302/8/5.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\nseed_counter = Counter()\ntrunc = 0\nblocks = 0\nfor _ in range(200):\n    g = mod.generate_input()\n    for color, r0, c0, r1, c1 in mod._extract_blocks(g):\n        region = g[r0:r1+1, c0:c1+1]\n        n = int((region == mod.SEED_COLOR).sum())\n        seed_counter[n] += 1\n        blocks += 1\n        if n > (min(r1-r0+1, c1-c0+1) + 1) // 2:\n            trunc += 1\nprint('seed_counts', dict(sorted(seed_counter.items())))\nprint('truncated_blocks', trunc)\nprint('total_blocks', blocks)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
