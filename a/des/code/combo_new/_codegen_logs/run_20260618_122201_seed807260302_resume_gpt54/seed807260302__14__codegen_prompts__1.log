{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location\nfrom arc_utils import paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))\n        rct[\"dr\"] = int(dist_to_edge(rct, red_orient, red_edge_idx))\n\n    rects.sort(\n        key=lambda r: (\n            int(r[\"db\"]),\n            int(r[\"dr\"]),\n            along_from_corner(r, blue_orient),\n            along_from_corner(r, red_orient),\n        )\n    )\n\n    # Rotate all rectangles if blue edge is vertical.\n    seq = []\n    for rct in rects:\n        a = rct[\"arr\"]\n        if blue_orient == \"v\":\n            a = np.rot90(a, k=1)  # CCW\n        seq.append(a)\n\n    outW = int(max(int(a.shape[1]) for a in seq))\n    outH = int(sum(int(a.shape[0]) for a in seq))\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    out_r = 0\n    for a in seq:\n        h, w = map(int, a.shape)\n        out_c = int((outW - w) // 2)\n        paste(out, a, int(out_r), int(out_c))\n        out_r += int(h)\n\n    return out\n\n# --------------- generator (attempt 3, Codex) ---------------\n\nBG = 8\nBLUE = 1\nRED = 2\nMARKER = 0\nDOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)\nMINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)\n\n\ndef _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:\n    if blue_orient == \"h\":\n        if corner == \"tl\":\n            return grid\n        if corner == \"tr\":\n            return np.fliplr(grid)\n        if corner == \"bl\":\n            return np.flipud(grid)\n        return np.rot90(grid, 2)\n\n    base = np.rot90(grid, 1)\n    if corner == \"bl\":\n        return base\n    if corner == \"tl\":\n        return np.flipud(base)\n    if corner == \"tr\":\n        return np.rot90(grid, 3)\n    return np.flipud(np.rot90(grid, 3))\n\n\ndef _distribute_band_widths(count: int, used_target: int) -> list[int]:\n    extra_units = (used_target - (4 * count - 2)) // 2\n    order = np.random.permutation(count)\n    units = np.zeros(count, dtype=int)\n    remaining = int(extra_units)\n    for i, idx in enumerate(order):\n        slots_left = count - i - 1\n        lo = max(0, remaining - 3 * slots_left)\n        hi = min(3, remaining)\n        take = int(np.random.randint(lo, hi + 1))\n        units[int(idx)] = take\n        remaining -= take\n    return [2 + 2 * int(u) for u in units]\n\n\ndef _sprinkle_minorities(patch: np.ndarray, dominant: int) -> np.ndarray:\n    area = int(patch.size)\n    if area < 8 or np.random.rand() < 0.6:\n        return patch\n\n    max_minor = min(3, area // 4)\n    if max_minor < 2:\n        return patch\n\n    n_minor = int(np.random.randint(2, max_minor + 1))\n    n_colors = int(np.random.randint(1, min(2, n_minor) + 1))\n    minority_choices = [int(c) for c in MINORITY_COLORS if int(c) != dominant]\n    colors = np.random.choice(minority_choices, size=n_colors, replace=False)\n    cells = np.random.choice(area, size=n_minor, replace=False)\n    flat = patch.reshape(-1)\n    for idx, cell in enumerate(cells):\n        flat[int(cell)] = int(colors[idx % n_colors])\n    return patch\n\n\ndef _build_canonical() -> np.ndarray:\n    long_dim = int(np.random.randint(9, 29))\n    options = []\n    for trailing in (1, 2):\n        max_used = long_dim - 2 - trailing\n        if max_used < 6 or max_used % 2:\n            continue\n        max_count = min(5, (max_used + 2) // 4)\n        pairs = []\n        for a in range(2, max_count + 1):\n            for b in range(2, max_count + 1):\n                if a + b > 9:\n                    continue\n                eligible = []\n                if max_used <= 10 * a - 2:\n                    eligible.append(0)\n                if max_used <= 10 * b - 2:\n                    eligible.append(1)\n                if eligible:\n                    pairs.append((a, b, eligible))\n        if pairs:\n            options.append((max_used, pairs))\n\n    max_used, pairs = options[int(np.random.randint(len(options)))]\n    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]\n    max_band = int(np.random.choice(eligible))\n    max0 = min(max_used, 10 * n0 - 2)\n    max1 = min(max_used, 10 * n1 - 2)\n    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))\n    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))\n    band0 = _distribute_band_widths(n0, used0)\n    band1 = _distribute_band_widths(n1, used1)\n\n    grid = np.full((8, long_dim), BG, dtype=int)\n    grid[0, :] = BLUE\n    grid[:, 0] = RED\n    grid[0, 0] = MARKER\n\n    for r0, widths in ((2, band0), (5, band1)):\n        c = 2\n        for w in widths:\n            color = int(np.random.choice(DOMINANT_COLORS))\n            patch = np.full((2, w), color, dtype=int)\n            patch = _sprinkle_minorities(patch, color)\n            paste(grid, patch, r0, c)\n            c += w + 2\n\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    canonical = _build_canonical()\n    blue_orient = str(np.random.choice([\"h\", \"v\"]))\n    corner = str(np.random.choice([\"tl\", \"tr\", \"bl\", \"br\"]))\n    return _transform(canonical, blue_orient, corner)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, neighbors4, random_sprite\nfrom scipy.ndimage import label as _scipy_label\nimport random\n\n\ndef _find_border6_square_start(legend: np.ndarray) -> tuple[int, int] | None:\n    h, w = legend.shape\n    if h < 5 or w < 5:\n        return None\n    for r0 in range(h - 4):\n        for c0 in range(w - 4):\n            sub = legend[r0 : r0 + 5, c0 : c0 + 5]\n            if np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6):\n                return int(r0), int(c0)\n    return None\n\n\ndef _find_marker_panel_square(g: np.ndarray, sep_c1: int) -> tuple[int, int] | None:\n    \"\"\"\n    Find the 5x5 border-6 position-marker square that belongs to the 8x5 marker panel.\n\n    In some instances the marker panel can appear inside the main canvas as well as in the\n    left legend region. Prefer a candidate that lies in the main canvas (col > sep_c1) if any.\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            # Must contain a position marker inside (non-{0,6}) and a rotation mark below.\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    main_cands = [rc for rc in candidates if rc[1] > sep_c1]\n    return min(main_cands) if main_cands else min(candidates)\n\n\ndef _separator_runs(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return contiguous runs of full-height columns that are all color 6.\"\"\"\n    h, w = g.shape\n    cols6 = [c for c in range(w) if np.all(g[:, c] == 6)]\n    if not cols6:\n        return []\n    cols6.sort()\n    runs: list[tuple[int, int]] = []\n    s = e = cols6[0]\n    for c in cols6[1:]:\n        if c == e + 1:\n            e = c\n        else:\n            runs.append((s, e))\n            s = e = c\n    runs.append((s, e))\n    return runs\n\n\ndef _split_canvas(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int] | None]:\n    \"\"\"\n    Identify a left separator run (between left legend and canvas), and optionally a\n    right separator run (between canvas and a right-side legend panel).\n    \"\"\"\n    h, w = g.shape\n    runs = _separator_runs(g)\n    assert runs, \"must have at least one color-6 separator run\"\n    left = runs[0]\n    # Prefer a right separator run very near the right edge (a right legend panel).\n    right: tuple[int, int] | None = None\n    for s, e in reversed(runs[1:]):\n        if s >= w - 10 and s > left[1] + 1:\n            right = (s, e)\n            break\n    return left, right\n\n\ndef _find_marker_square_with_preferences(\n    g: np.ndarray, left_sep: tuple[int, int], right_sep: tuple[int, int] | None\n) -> tuple[int, int] | None:\n    \"\"\"\n    Find the marker panel's 5x5 border-6 square.\n\n    Preference order:\n      1) left legend region (at/before left separator)\n      2) right legend region (at/after right separator), if present\n      3) anywhere (including inside the output canvas)\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    left_end = left_sep[1]\n    left_cands = [rc for rc in candidates if rc[1] + 2 <= left_end]\n    if left_cands:\n        return min(left_cands)\n    if right_sep is not None:\n        right_start = right_sep[0]\n        right_cands = [rc for rc in candidates if rc[1] + 2 >= right_start]\n        if right_cands:\n            return min(right_cands)\n    return min(candidates)\n\n\ndef _all_marker_panel_squares(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"List all 5x5 border-6 squares that look like the top of an 8x5 marker panel.\"\"\"\n    h, w = g.shape\n    out: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            out.append((int(r0), int(c0)))\n    out.sort()\n    return out\n\n\ndef _extract_unit_sprite(legend: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    # Unit sprite is the top-most 4-connected component of pixels not in {0,6}.\n    mask = (legend != 0) & (legend != 6)\n    pts_all = np.argwhere(mask)\n    if pts_all.size == 0:\n        return None\n    rmin = int(pts_all[:, 0].min())\n    # choose left-most on that row to seed\n    cseed = int(np.argwhere(mask[rmin, :])[0, 0])\n    # BFS from seed to get component\n    h, w = legend.shape\n    vis = np.zeros((h, w), dtype=bool)\n    st = [(rmin, cseed)]\n    vis[rmin, cseed] = True\n    pts: list[tuple[int, int]] = []\n    while st:\n        r, c = st.pop()\n        pts.append((r, c))\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not vis[rr, cc]:\n                vis[rr, cc] = True\n                st.append((rr, cc))\n    r0, c0, r1, c1 = bbox_coords(np.asarray(pts))\n    spr = legend[r0 : r1 + 1, c0 : c1 + 1].copy()\n    # Unit sprite uses two colors; the rendered sprite is the color-swapped version.\n    cols = sorted({int(x) for x in np.unique(spr) if int(x) not in (0, 6)})\n    if len(cols) == 2:\n        a, b = cols\n        spr2 = spr.copy()\n        spr2[spr == a] = -1\n        spr2[spr == b] = a\n        spr2[spr2 == -1] = b\n        spr = spr2\n    return spr, (r0, c0, r1, c1)\n\n\ndef _extract_frame_bbox(legend: np.ndarray, unit_bb: tuple[int, int, int, int], border6_r0: int) -> tuple[int, int, int, int] | None:\n    # Frame pixels live between the unit sprite and the border6 square.\n    r_start = unit_bb[2] + 1\n    r_end = border6_r0 - 1\n    if r_start > r_end:\n        return None\n    sub = legend[r_start : r_end + 1, :]\n    mask = (sub != 0) & (sub != 6)\n    pts = np.argwhere(mask)\n    if pts.size == 0:\n        return None\n    pts[:, 0] += r_start\n    r0 = int(pts[:, 0].min())\n    r1 = int(pts[:, 0].max())\n    c0 = int(pts[:, 1].min())\n    c1 = int(pts[:, 1].max())\n    return (r0, c0, r1, c1)\n\n\ndef _position_indices_from_border_square(legend: np.ndarray, border6_r0: int, border6_c0: int) -> tuple[int, int] | None:\n    sq = legend[border6_r0 : border6_r0 + 5, border6_c0 : border6_c0 + 5]\n    inner = sq[1:4, 1:4]\n    pts = np.argwhere((inner != 0) & (inner != 6))\n    if pts.size == 0:\n        return None\n    # If multiple, take the first (should be unique)\n    r, c = int(pts[0, 0]), int(pts[0, 1])\n    return r, c  # 0..2\n\n\ndef _rotation_from_clockhand(legend: np.ndarray, border6_r0: int, border6_c0: int) -> int:\n    \"\"\"\n    Rotation marker is in the bottom 3x3 at rows (border6_r0+5 .. border6_r0+7) and cols (1..3),\n    drawn with non-{0,6} pixels (typically 7). Use the furthest pixel from the center (1,1)\n    to determine direction:\n      up -> 0, right -> 1, down -> 2, left -> 3.\n    \"\"\"\n    h, w = legend.shape\n    r0 = border6_r0 + 5\n    c0 = border6_c0 + 1\n    assert r0 + 2 < h and c0 + 2 < w, \"rotation marker patch out of bounds\"\n    sub = legend[r0 : r0 + 3, c0 : c0 + 3]\n    pts = np.argwhere((sub != 0) & (sub != 6))\n    assert pts.size > 0, \"no rotation marker pixel found\"\n    center = np.array([1, 1], dtype=int)\n    # pick furthest (Manhattan) from center\n    dists = np.abs(pts - center).sum(axis=1)\n    p = pts[int(dists.argmax())]\n    dr, dc = int(p[0] - center[0]), int(p[1] - center[1])\n    if abs(dr) >= abs(dc):\n        if dr < 0:\n            return 0\n        if dr > 0:\n            return 2\n    else:\n        if dc > 0:\n            return 1\n        if dc < 0:\n            return 3\n    raise AssertionError(\"rotation marker pixel at center, direction ambiguous\")\n\n\ndef _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:\n    \"\"\"\n    anchor_idx in {0,1,2} selects position on a length:\n      0 -> start, 1 -> middle, 2 -> end\n    Returns the top-left coordinate so that the corresponding point of the placed object\n    aligns with that point on the canvas.\n    \"\"\"\n    if anchor_idx <= 0:\n        canvas_anchor = 0\n        obj_anchor = 0\n    elif anchor_idx >= 2:\n        canvas_anchor = max(0, size - 1)\n        obj_anchor = max(0, place_size - 1)\n    else:\n        canvas_anchor = (size - 1) // 2 if size > 1 else 0\n        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0\n    return canvas_anchor - obj_anchor\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n","exit_code":0,"status":"completed"}}
