{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location\nimport random\n\n\ndef _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:\n    b = bbox(mask)\n    if b is None:\n        return None\n    r0, c0, r1, c1 = b\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    if h < 3 or w < 3:\n        return None\n\n    expected = np.zeros_like(mask, dtype=bool)\n    expected[r0 : r1 + 1, c0] = True\n    expected[r0 : r1 + 1, c1] = True\n    expected[r0, c0 : c1 + 1] = True\n    expected[r1, c0 : c1 + 1] = True\n    if not np.array_equal(mask, expected):\n        return None\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef _scaled_index(i: int, src_len: int, dst_len: int) -> int:\n    assert src_len >= 1 and dst_len >= 1, \"axis lengths must be positive\"\n    if src_len == 1:\n        assert dst_len == 1, \"a one-pixel motif axis maps to a one-pixel interior axis\"\n        return 0\n    assert dst_len >= 2, \"multi-pixel motif axis needs a multi-pixel interior axis\"\n    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))\n\n\ndef _fill_enclosed(stroke: np.ndarray) -> np.ndarray:\n    h, w = stroke.shape\n    open_space = ~stroke.astype(bool)\n    padded = np.pad(open_space, 1, constant_values=True)\n    seen = np.zeros_like(padded, dtype=bool)\n    q: deque[tuple[int, int]] = deque()\n    ph, pw = padded.shape\n\n    for r in range(ph):\n        for c in (0, pw - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n    for c in range(pw):\n        for r in (0, ph - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((int(nr), int(nc)))\n\n    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]\n    return stroke.astype(bool) | holes\n\n\ndef _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = sprite.shape\n    dst_h, dst_w = target_shape\n    assert sprite.any(), \"expected a nonempty sprite\"\n\n    stroke = np.zeros((dst_h, dst_w), dtype=int)\n    coords = np.argwhere(sprite)\n    mapped: dict[tuple[int, int], tuple[int, int]] = {}\n    for sr, sc in coords:\n        tr = _scaled_index(int(sr), src_h, dst_h)\n        tc = _scaled_index(int(sc), src_w, dst_w)\n        mapped[(int(sr), int(sc))] = (tr, tc)\n        stroke[tr, tc] = 1\n\n    for sr, sc in coords:\n        sr = int(sr)\n        sc = int(sc)\n        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):\n            if (nr, nc) in mapped:\n                r0, c0 = mapped[(sr, sc)]\n                r1, c1 = mapped[(nr, nc)]\n                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)\n\n    return _fill_enclosed(stroke.astype(bool))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n\n    frame_positions = _frame_positions(size, sprite.shape)\n    if not frame_positions:\n        return None\n    fr0, fc0 = random.choice(frame_positions)\n    frame_bbox = (fr0, fc0, fr0 + size - 1, fc0 + size - 1)\n\n    candidate = _build_candidate_grids(frame_bbox, sprite, sprite_color)\n    if candidate is None:\n        return None\n    inp, out = candidate\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, paste\n\n\ndef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n    h, w = g.shape\n    containers = []\n\n    for bottom in range(1, h):\n        for left in range(w - 2):\n            if int(g[bottom, left]) != wall_color:\n                continue\n            for right in range(left + 2, w):\n                if int(g[bottom, right]) != wall_color:\n                    continue\n                if not np.all(g[bottom, left : right + 1] == wall_color):\n                    continue\n\n                top = bottom\n                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n                    top -= 1\n                if top == bottom:\n                    continue\n\n                interior = g[top:bottom, left + 1 : right]\n                if interior.size == 0 or not np.all(interior == bg):\n                    continue\n                containers.append((top, bottom, left, right))\n\n    return containers\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n\n    return expected, fill_container, u_box, marker_c, distractor_count\n\n\ndef _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n    inp = expected.copy()\n    if fill_container:\n        assert u_box is not None\n        top, bottom, left, right = u_box\n        inp[top:bottom, left + 1 : right] = _GEN_BG\n    else:\n        inp[-1, :] = _GEN_BG\n    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n    return inp\n\n\ndef _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n        return False\n","exit_code":0,"status":"completed"}}
