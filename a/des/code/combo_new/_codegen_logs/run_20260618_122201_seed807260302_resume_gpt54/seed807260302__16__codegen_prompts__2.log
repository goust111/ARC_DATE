{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/41ace6b5.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Normalize vertical two-color bars between paired marker columns around the marker rows.\n\n    Input structure\n    - The background is the dominant color.\n    - A row of red marker pixels sits directly above a row of gray marker pixels\n      in the same alternating columns.\n    - The columns between adjacent markers contain vertical bars made from a\n      contiguous teal run above a contiguous blue run.\n\n    Rule\n    - Keep the marker pixels and all non-bar background cells fixed.\n    - Let h be the maximum teal-run height among the bar columns; paint teal in\n      every bar column for h rows ending at the red marker row.\n    - In each bar column, move its blue run to start at the gray marker row and\n      fill all lower cells in that column with maroon.\n\n    Key insight\n    - The marker rows are a baseline: teal is normalized into a common upper\n      band, while each blue run keeps its own height below the baseline.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H = g.shape[0]\n\n    blue = 1\n    red = 2\n    gray = 5\n    teal = 8\n    maroon = 9\n\n    red_coords = np.argwhere(g == red)\n    gray_coords = np.argwhere(g == gray)\n    assert red_coords.size > 0 and gray_coords.size > 0\n\n    red_rows = np.unique(red_coords[:, 0])\n    gray_rows = np.unique(gray_coords[:, 0])\n    assert len(red_rows) == 1 and len(gray_rows) == 1\n\n    red_row = int(red_rows[0])\n    gray_row = int(gray_rows[0])\n    assert gray_row == red_row + 1\n\n    marker_cols = np.where(g[red_row] == red)[0]\n    gray_cols = np.where(g[gray_row] == gray)[0]\n    assert marker_cols.size >= 2\n    assert np.array_equal(marker_cols, gray_cols)\n    assert np.all(np.diff(marker_cols) == 2)\n\n    bar_cols = [int((left + right) // 2) for left, right in zip(marker_cols, marker_cols[1:])]\n    assert bar_cols\n\n    max_teal_height = 0\n    blue_heights: list[int] = []\n\n    for c in bar_cols:\n        col = g[:, c]\n        non_bg_rows = np.where(col != bg)[0]\n        assert non_bg_rows.size > 0\n\n        first = int(non_bg_rows[0])\n        assert np.array_equal(non_bg_rows, np.arange(first, H))\n        assert np.all(np.isin(col[first:], [blue, teal]))\n\n        segment = col[first:]\n        blue_positions = np.where(segment == blue)[0]\n        teal_positions = np.where(segment == teal)[0]\n        assert blue_positions.size > 0 and teal_positions.size > 0\n        assert np.array_equal(teal_positions, np.arange(teal_positions.size))\n        assert np.array_equal(\n            blue_positions,\n            np.arange(teal_positions.size, teal_positions.size + blue_positions.size),\n        )\n\n        max_teal_height = max(max_teal_height, int(teal_positions.size))\n        blue_heights.append(int(blue_positions.size))\n\n    top_row = red_row - max_teal_height + 1\n    assert top_row >= 0\n\n    out = g.copy()\n    for c, blue_height in zip(bar_cols, blue_heights):\n        assert gray_row + blue_height <= H\n        out[:, c] = bg\n        out[top_row : red_row + 1, c] = teal\n        out[gray_row : gray_row + blue_height, c] = blue\n        out[gray_row + blue_height :, c] = maroon\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors.\nBG, BLUE, RED, GRAY, TEAL, MAROON = 7, 1, 2, 5, 8, 9\n# Canvas and marker layout.\nMIN_MARKERS, MAX_MARKERS_EXCL = 5, 9\nMARKER_STEP, MARKER_ROWS = 2, 2\nMIN_RED_ROW, MAX_RED_ROW = 2, 6\n# Bar height bounds.\nMIN_MAX_TEAL, MAX_MAX_TEAL_EXCL = 2, 5\nMIN_BLUE_HEIGHT, MIN_REQUIRED_BLUE_HEIGHT = 1, 2\nMIN_ROWS_BELOW_GRAY, MIN_INPUT_TEAL_HEIGHT = 2, 2\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _sample_layout():\n","exit_code":0,"status":"completed"}}
