 bg, wall):\n        return None\n\n    # Final oracle: solver must produce a non-trivial transformation.\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(grid, out):\n        return None\n\n    return grid\n\n===== /home/lixinyu/snap/new/ARC_code/train/db7260a4.py =====\n--- _gen_attempt lines 290-298 ---\ndef _gen_attempt() -> np.ndarray | None:\n    expected, fill_container, u_box, marker_c, distractor_count = _gen_design_expected()\n    if not _gen_place_distractors(expected, distractor_count):\n        return None\n\n    inp = _gen_input_from_expected(expected, fill_container, u_box, marker_c)\n    if not _gen_valid_pair(inp, expected, fill_container, u_box, marker_c):\n        return None\n    return inp\n\n===== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py =====\n--- _gen_attempt lines 579-601 ---\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n===== /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py =====\n--- _gen_attempt lines 291-468 ---\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n===== /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py =====\n--- _gen_attempt lines 268-308 ---\ndef _gen_attempt() -> np.ndarray | None:\n    rows, cols = _choose_canvas_shape()\n    n_frames = random.randint(*FRAME_COUNT_RANGE)\n    frame_color, slot_colors = _choose_palette()\n\n    specs = _choose_frame_specs(n_frames, rows, cols)\n    if specs is None:\n        return None\n\n    placed = _place_frames(rows, cols, specs)\n    if placed is None:\n        return None\n\n    out = np.full((rows, cols), BG, dtype=int)\n    line_data: list[tuple[int, int, list[int], list[int]]] = []\n    for r0, c0, heights, widths in placed:\n        patch, row_lines, col_lines = _make_output_patch(heights, widths, frame_color, slot_colors)\n        paste(out, patch, r0, c0)\n        line_data.append((r0, c0, row_lines, col_lines))\n\n    inp = out.copy()\n    providers = _hint_providers(n_frames)\n    for frame_idx, (r0, c0, row_lines, col_lines) in enumerate(line_data):\n        for sr, sc in SLOT_POSITIONS:\n            if providers[(sr, sc)] == frame_idx:\n                continue\n            rr0 = r0 + row_lines[sr] + 1\n            rr1 = r0 + row_lines[sr + 1]\n            cc0 = c0 + col_lines[sc] + 1\n            cc1 = c0 + col_lines[sc + 1]\n            inp[rr0:rr1, cc0:cc1] = BG\n\n    try:\n        if int(get_bg(inp)) != BG:\n            return None\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n===== /home/lixinyu/snap/new/ARC_code/eval/247ef758.py =====\n--- _gen_attempt lines 183-303 ---\ndef _gen_attempt() -> np.ndarray | None:\n    bg = 0\n\n    # Dimensions — frame spans full grid height\n    interior_h = random.randint(8, 13)\n    interior_w = random.randint(8, 13)\n    H = interior_h + 2\n    if not 10 <= H <= 15:\n        return None\n    sprite_area_w = random.randint(3, 5)\n    frame_w = interior_w + 2\n    W = sprite_area_w + 1 + frame_w\n    if not 14 <= W <= 20:\n        return None\n\n    # Key positions\n    div_col = sprite_area_w\n    fc0, fc1 = sprite_area_w + 1, W - 1\n    ir0, ic0 = 1, fc0 + 1\n    ir1, ic1 = H - 2, fc1 - 1\n\n    # Assign distinct colors\n    all_colors = list(range(1, 10))\n    random.shuffle(all_colors)\n    n_movers = random.randint(2, 3)\n    n_distractors = random.choice([0, 0, 1])\n    idx = 0\n    divider_color = all_colors[idx]; idx += 1\n    frame_base = all_colors[idx]; idx += 1\n    mover_colors = all_colors[idx:idx + n_movers]; idx += n_movers\n    distractor_colors = all_colors[idx:idx + n_distractors]; idx += n_distractors\n\n    # Generate mover sprites\n    sprites: list[np.ndarray] = []\n    for mc in mover_colors:\n        s = _make_sprite(mc, 5, sprite_area_w)\n        if s is None:\n            return None\n        sprites.append(s)\n\n    # Pick marker positions per mover (no two movers share a row or col marker)\n    mover_targets: dict[int, tuple[list[int], list[int]]] = {}\n    occupied_rows: set[int] = set()\n    occupied_cols: set[int] = set()\n    for mc, sp in zip(mover_colors, sprites):\n        sh, sw = sp.shape\n        min_row = ir0 + sh // 2\n        max_row = ir1 - (sh - 1 - sh // 2)\n        min_col = ic0 + sw // 2\n        max_col = ic1 - (sw - 1 - sw // 2)\n        if min_row > max_row or min_col > max_col:\n            return None\n        avail_rows = [r for r in range(min_row, max_row + 1) if r not in occupied_rows]\n        row_marks = _pick_spaced(avail_rows, random.randint(1, 2), sh)\n        if not row_marks:\n            return None\n        avail_cols = [c for c in range(min_col, max_col + 1) if c not in occupied_cols]\n        col_marks = _pick_spaced(avail_cols, random.randint(1, 2), sw)\n        if not col_marks:\n            return None\n        mover_targets[mc] = (sorted(row_marks), sorted(col_marks))\n        occupied_rows.update(row_marks)\n        occupied_cols.update(col_marks)\n\n    # Build input grid: bg fill, then divider, frame, sprites\n    inp = np.full((H, W), bg, dtype=int)\n    inp[:, div_col] = divider_color\n\n    # Frame top/bottom edges (mirrored)\n    top_edge = np.full(frame_w, frame_base, dtype=int)\n    for mc, (_, cmarks) in mover_targets.items():\n        for cc in cmarks:\n            top_edge[cc - fc0] = mc\n    inp[0, fc0:fc0 + frame_w] = top_edge\n    inp[H - 1, fc0:fc0 + frame_w] = top_edge\n\n    # Frame left/right edges (mirrored)\n    for r in range(1, H - 1):\n        val = frame_base\n        for mc, (rmarks, _) in mover_targets.items():\n            if r in rmarks:\n                val = mc\n                break\n        inp[r, fc0] = val\n        inp[r, fc1] = val\n\n    # Stack sprites in left strip: movers top-to-bottom, then distractors\n    cur_row = 0\n    all_items: list[tuple[int, np.ndarray, bool]] = [\n        (mc, sp, False) for mc, sp in zip(mover_colors, sprites)\n    ]\n    for dc_color in distractor_colors:\n        ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)\n        if ds is None:\n            return None\n        all_items.append((dc_color, ds, True))\n\n    for mc, sp, _ in all_items:\n        sh, sw = sp.shape\n        if sw > sprite_area_w or cur_row + sh > H:\n            return None\n        c_off = random.randint(0, sprite_area_w - sw)\n        for dr in range(sh):\n            for dc in range(sw):\n                if sp[dr, dc] != bg:\n                    inp[cur_row + dr, c_off + dc] = sp[dr, dc]\n        cur_row += sh\n\n    # Validate: bg must be most common color so solver detects it correctly\n    vals, counts = np.unique(inp, return_counts=True)\n    if int(vals[np.argmax(counts)]) != bg:\n        return None\n\n    # Run solver and verify output differs from input (movers actually moved)\n    try:\n        output = main(inp)\n    except Exception:\n        return None\n    if np.array_equal(inp, output):\n        return None\n    return inp\n\n===== /home/lixinyu/snap/new/ARC_code/train/b25e450b.py =====\n--- _gen_attempt_with_count lines 273-292 ---\ndef _gen_attempt_with_count(n_rects: int) -> np.ndarray | None:\n    \"\"\"Generate a valid input with exactly n_rects black rectangles.\"\"\"\n    counts = _choose_orientation_counts(n_rects)\n    if counts is None:\n        return None\n    n_vert, n_horiz = counts\n\n    canvas = _choose_canvas(n_vert, n_horiz)\n    if canvas is None:\n        return None\n    H, W = canvas\n\n    rects = _build_rects(H, W, n_vert, n_horiz)\n    if rects is None:\n        return None\n\n    grey_frac = random.uniform(GREY_FRAC_MIN, GREY_FRAC_MAX)\n    output = _render_output(H, W, rects, grey_frac)\n    inp = _invert_output_to_input(output, rects, grey_frac)\n    return inp if _is_valid_pair(inp, output) else None\n\n===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py =====\n--- _gen_attempt lines 425-505 ---\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n","exit_code":0,"status":"completed"}}
