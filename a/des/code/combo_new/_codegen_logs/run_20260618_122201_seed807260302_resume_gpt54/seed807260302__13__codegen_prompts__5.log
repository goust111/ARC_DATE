 len(protrusion_values)) % len(LAYOUT_MODES)]\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/18/code.py:538:            grid = _gen_attempt(rng, protrusion_count=target_n, layout_mode=target_mode)\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/18/code.py:541:        target_n = int(rng.choice(protrusion_values))\n/home/lixinyu/snap/new/ceshi/code_combo/7ed72f31/16/code.py:67:#     - Payload cells lie on a narrow ring around the cross, so the local geometry\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:37:#       frame narrower than the widest one, so the D3 change is always observable.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:58:#     - Humans can see two linked effects: narrow frames have fewer possible dot\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:230:    also contains at least one narrower frame.\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:233:    narrower_choices = [w for w in FRAME_WIDTH_CHOICES if w < max_width]\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:234:    widths = [max_width, int(rng.choice(narrower_choices))]\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:251:    At least one widest frame and one narrower frame receive dots so the variable-width\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:258:    narrower = [i for i, width in enumerate(frame_widths) if int(width) < max_width]\n/home/lixinyu/snap/new/ceshi/code_combo/8f215267/6/code.py:262:        int(rng.choice(narrower)),\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:5:\"\"\"Variant of 3dc255db with arrow-indicated ejection direction.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:17:     L-shaped arrow is attached near the tail side. The arrow is 8-connected to\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:20:   - The arrow is placed so the old bbox-based spike heuristic is no longer safe:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:21:     the merged border component's outer bbox includes the arrow, so the cup body\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:22:     must be recovered by identifying and removing that arrow candidate first.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:25:     cup has a small same-color arrow above it. The merged component's top edge is\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:26:     now widened by the arrow, so \"unique top-edge spike\" is no longer reliable.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:27:     The new solver removes the 3-cell arrow candidate, observes the arrow lies\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:34:   - Each cup always has exactly one arrow, and the arrow always uses the cup's\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:36:   - The arrow may lean to either perpendicular side of the ray, so the samples do\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:41:     This is false now because the arrow is merged into the same 8-connected\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:44:   - Original mouth flood is still valid, but only after stripping the arrow.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:49:       4. derive direction from which side the arrow lies on relative to that cup.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:51:     such valid arrow candidate. The generator enforces that.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:55:     same-color arrow offset near the tail side.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:56:   - The arrow is kept off the direct ejection path, so the output line never\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:57:     overwrites the arrow.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:58:   - Placement checks use the combined cup+arrow patch, so arrows do not overlap\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:62:   - Humans can see a cup plus a small same-color arrow near one side. The output\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:65:   - This does not degenerate to the original rule because the arrow is merged\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:70:   - The arrow stays adjacent to its own cup and uses the same border color, so it\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:76:   - No new color mapping is introduced. The arrow reuses the cup border color.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:81:   - Assumption: each processed border component has one removable 3-cell L arrow\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:83:   - Assumption: the arrow lies completely beyond exactly one side of the cup\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:84:     body's bbox. Guaranteed by generator's fixed arrow templates.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:85:   - Assumption: after removing the arrow, the cup body still has one spike on the\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:86:     arrow-indicated side. Guaranteed because the underlying cup body is the\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:152:def _enumerate_arrow_candidates(border_set: set[tuple[int, int]]) -> list[set[tuple[int, int]]]:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:168:def _arrow_side(arrow_cells: set[tuple[int, int]], cup_bbox: tuple[int, int, int, int]) -> str | None:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:169:    ar0, ac0, ar1, ac1 = bbox_coords(np.array(sorted(arrow_cells), dtype=int))\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:201:    - Each cup border component includes a same-color 3-pixel arrow marker.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:203:    - The side on which the arrow sits determines the ejection direction.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:222:            for arrow_cells in _enumerate_arrow_candidates(border_set):\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:223:                cup_set = border_set - arrow_cells\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:228:                tail_dir = _arrow_side(arrow_cells, cup_bbox)\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:403:def _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:411:    \"\"\"Expand the original cup patch with a same-color 3-cell arrow.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:413:    arrow_template = ARROW_OFFSETS[direction][int(rng.integers(0, 2))]\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:414:    arrow_coords = [(spike[0] + dr, spike[1] + dc) for dr, dc in arrow_template]\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:416:    all_coords = border_coords + arrow_coords\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:425:    for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D2/2/code.py:560:    patch, spike, mouth, cup_bbox_local = _attach_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/24/code.py:46:#       - \"Frames are generated compactly and placed without overlap so bbox centers remain legible.\"\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/24/code.py:205:    - For every real frame, compute the Euclidean distance from its reconstructed bbox center to the whole-grid center.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:8:#      cols [10,12,14,16,18] and only 4 colored protrusions on the bar.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:9:#    - Exactly 4 consecutive slot columns match the bar's left->right protrusion colors. The matching\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:12:#    - The bar keeps a grey base, while every protrusion has its own visible non-grey color above the\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:14:#      aligned protrusion is repainted to that protrusion's color, so the original grey cap disappears.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:18:#         fused task: read the bar's 4 protrusion colors, find the unique consecutive 4-column slot block\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:20:#         the slot top down to the cell just above the protrusion with the protrusion color.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:29:#    - Heights stay in [2,4] so every protrusion exposes at least 1 colored cell above the grey base,\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:30:#      making the color-carrying role of the protrusions directly visible.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:33:#    - \"The bar is the second-largest grey component\" fails because protrusions are colored; the solver\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:37:#      protrusion color\". Under this exact combo spec the matched slot color and protrusion color are equal,\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:41:#      reachable segment above each matched protrusion, absorbing the grey cap.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:48:#    - A human sees 5 slot colors but only 4 colored protrusions, so one frame column must be ignored.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:61:#      the protrusion body, turning each matched column into a single uninterrupted color stripe.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:126:    Insert a colored-projection bar into the frame by color-matching it to one of two candidate slot blocks, then turn the matched columns into solid stripes of the protrusion colors.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:130:    - The left side contains 1 separate bar with a grey base and 4 upward protrusions whose visible cells above the base are colored and mutually distinct.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:134:    - Compare the bar's 4 protrusion colors with the frame's 5 slot-column colors and find the unique consecutive 4-column block with the same left-to-right color order; shift the bar horizontally so each protrusion docks under the same-colored slot column in that block.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:135:    - Clear the original slot colors, keep the inserted bar, and repaint every matched slot column from the slot top down to the cell just above its aligned protrusion using that protrusion's color, eliminating the old grey cap. The unmatched end column disappears.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/16/code.py:137:    Key insight: Column position alone is insufficient because the frame offers 5 candidates for only 4 protrusions; the solver must first identify the correct color-matched 4-column block, and that same protrusion-color mapping then determines the final full-column repaint.\n/home/lixinyu/snap/new/ceshi/code_combo/291dc1e1/10/code.py:63:#    In the output the near group stays flat, the middle group becomes tall/narrow,\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/21/code.py:82:#    - Colors remain monochrome per source column and occupy only narrow cavity\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/29/code.py:185:def _narrow_vertical_corridor(\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/29/code.py:432:        if not _narrow_vertical_corridor(grid, jc, top1, jr, child_n, min_open_steps=5):\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/29/code.py:435:        if not _narrow_vertical_corridor(grid, right_root[1], top2, jr, child_n, min_open_steps=6):\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/1/code.py:43:#         2. bbox center = placement anchor\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/1/code.py:124:    Rebuild the destination frame by matching source sprites on body color and aligning on bbox center.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/3/code.py:77:# - an occupied bbox center\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/18/code.py:34:#      target. If a choke narrows below 6, the mover stops at the farthest\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/18/code.py:74:#    - Big mover sizes 5..7 make narrow gates visibly narrower than the mover.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/18/code.py:84:#      large mover footprint interacting with visibly narrow chokepoints.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/18/code.py:308:    narrow_w = random.randint(1, max(1, n - 2))\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/18/code.py:309:    remove = int(n - narrow_w)\n/home/lixinyu/snap/new/ceshi/code/80a900e0/D12/0/code.py:23:#     only checkerboard are stripped away. The returned board may be shorter or narrower.\n/home/lixinyu/snap/new/ceshi/code_combo/88bcf3b4/15/code.py:43:#   - The long-approach change is kept in a narrow range: obstacle md 5-12, mostly produced by\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/25/code.py:36:#      n×n clearance test needed for gradual narrowing.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/25/code.py:39:#      because the taper can create upstream slack before the true narrowing point.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/25/code.py:48:#    - The river remains pixel-connected in blocked cases because the narrow spine still links\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/25/code.py:51:#    - Humans can see the one-sided staircase narrowing near the target.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/25/code.py:53:#      the narrowing; it stops noticeably earlier, roughly halfway along the usable route.\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/10/code.py:25:#       fused: \"The 4-room frame appears first when its bbox center is nearest the board center; its bar is still length 4, only the row order changes.\"\n/home/lixinyu/snap/new/ceshi/code_combo/89565ca0/10/code.py:157:    - For each real frame, measure the Euclidean distance from its reconstructed bbox center to the whole-grid center.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/31/code.py:91:- The occupied non-background area is constrained to 10-20% of the grid, matching the sparse-narrow\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/6/code.py:50:#       or 3 source bars, and 1-tooth bars can even be narrower than before.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/6/code.py:73:#         count narrows candidates to \"1-tooth vs 2-tooth\";\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/27/code.py:36:  otherwise it stops at the farthest reachable n×n placement before the first too-narrow gate\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/27/code.py:59:- Original assumption: a stuck case only comes from river self-narrowing.\n/home/lixinyu/snap/new/ceshi/code_combo/4c3d4a41/14/code.py:165:        raise ValueError(\"bar base is too narrow\")\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/33/code.py:48:   - The only marker is a single protrusion pixel. It is visually salient but does not create\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/33/code.py:58:     colors, so the solver must detect the arrow-marked L component and the dock structurally.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/33/code.py:259:def _find_arrow_l_info(comp: dict) -> dict | None:\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/33/code.py:371:        info = _find_arrow_l_info(comp)\n/home/lixinyu/snap/new/ceshi/code/16b78196/D8/1/code.py:51:    - that cavity spans a strip exactly 1 cell narrower than the previous piece.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:28:#   3. Reflection is read from arrow glyphs inside the matched target quadrant:\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:29:#      right-arrow => LR flip, down-arrow => UD flip. Quadrant position no longer\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:35:#     * connector + only down-arrow -> copy there, but apply UD instead of LR;\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:36:#     * connector + both arrows -> copy there with both flips.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:59:#   arrows are instruction artifacts. They are stripped before motifs are stamped.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:66:#   regions are large enough for anchors, arrow glyphs, and at least one-cell\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:70:# - Active target anchors reserve a top band for arrows and at least one extra row\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:77:#   3. read the arrows in those same quadrants to decide the reflection bits.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:83:# - Colors are function-separated: divider=1, anchors=2, arrows=3, bg=4,\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:97:#   quadrants with both a connector color repeated in TL and at least one arrow.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:330:    Copy the TL motif into connector-matched regions, scaling by anchor size and mirroring by arrow markers.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:335:    - Each active target shares a repeated connector color with a TL-side connector stub, and that same target region also contains one or two green arrow glyphs.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:339:    - Extract the TL motif while ignoring connector colors, then for each active target read its arrows: right-arrow means LR reflection, down-arrow means UD reflection.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:342:    Key insight: The divider only tells you where the four regions are; connector colors decide which anchors participate at all, and arrow glyphs independently decide how each matched copy is reflected.\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:561:def _paint_arrow(grid: np.ndarray, top: int, left: int, shape: frozenset[tuple[int, int]]) -> None:\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:569:        _paint_arrow(grid, q_r0 + 1, q_c0 + 1, RIGHT_ARROW)\n/home/lixinyu/snap/new/ceshi/code_combo/b10624e5/26/code.py:571:        _paint_arrow(grid, q_r0 + 1, q_c0 + 5, DOWN_ARROW)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/25/code.py:90:#   would clutter narrow wire corridors. Collisions happen on already-painted\n/home/lixinyu/snap/new/ceshi/code/88bcf3b4/D3/1/code.py:420:        # Use obstacle centroid direction as an 'away' vector.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/28/code.py:20:#      is the bbox center, not the rare pixel.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/28/code.py:38:#      occupied bbox center cell.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/28/code.py:57:#    - The bbox center cell is occupied.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D14/1/code.py:27:#       use the content centroid projected onto the axis-perpendicular coordinate, compared\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D14/1/code.py:28:#       against the whole mouth-interior centroid on that same coordinate.\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D14/1/code.py:33:#       half of the mouth interior (relative to the mouth centroid) and places all content\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D14/1/code.py:40:#         new solver: erase content, detect content centroid < mouth centroid, draw leftward\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D14/1/code.py:60:#       - content centroid must not land exactly on the mouth centroid along the perpendicular\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/35/code.py:332:    - If the current target is blocked by a too-narrow branch, the mover stops at the reachable placement\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/35/code.py:451:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/35/code.py:452:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/32/code.py:19:  river narrows below n, the mover gets stuck before the chokepoint.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/17/code.py:28:  - Stuck case: a later corridor segment is narrowed below n, so BFS stops at\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/17/code.py:415:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/17/code.py:416:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/13/code.py:26:#          The bbox center is the top-middle B. A destination marker of color B means\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/13/code.py:142:    Rebuild the destination frame by matching ambiguous tri-color sprites through their bbox centers.\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/13/code.py:157:    lookup and alignment must come from the occupied bbox center instead of from either singleton accent.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/15/code.py:309:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/15/code.py:310:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/7/code.py:159:    - A narrow legend strip occupies the left edge. Each 3x3 legend glyph has one trigger color at its center plus a gray shape that specifies that color's ray behavior.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/38/code.py:345:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/38/code.py:346:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/30/code.py:81:#    - The 2-cell decoration cluster lies clearly in one sprite corner; its centroid therefore determines one\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/40/code.py:388:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/40/code.py:389:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code/3dc255db/D7/1/code.py:52:#     - For multi-cup inputs the generator constrains cup centers to a narrow shared row band\n/home/lixinyu/snap/new/ceshi/code_combo/a251c730/14/code.py:144:    - Stamp that sprite so the bbox center, not the singleton accent pixel, lands on\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:17:#    - Combo task: each endpoint is replaced by a 3-cell blue L-arrow. The degree-2 corner is\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:18:#      the tip, and the missing diagonal quadrant is the arrow's forward direction.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:19:#    - Each arrow tip has exactly one orthogonally adjacent marker pixel in a non-blue,\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:20:#      non-magenta color. Two arrows with the same marker color are one pair.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:21:#    - For one pair, the two tips lie on a common 45-degree diagonal and the arrows face each\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:28:#      combo logic: blue arrows with tips at (2,2),(6,6), same red marker color, facing toward\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:40:#    - Original blue-pixel grouping by diagonal is invalid: each arrow contains an incidental\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:43:#      colors attached to arrow tips.\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:50:#      2. every arrow tip has exactly one adjacent non-bg, non-blue, non-magenta marker;\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:51:#      3. every marker color labels exactly two arrows;\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:52:#      4. paired arrows lie on one diagonal and face each other;\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:57:#    - Both arrow bodies, both X branches, markers, triggers, and emitted rays must stay in-bounds\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:68:#      1. blue L-shapes identify arrow tips and directions;\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:69:#      2. repeated marker colors identify which distant arrows pair up;\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:144:def _arrow_cells(tip: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:156:def _parse_arrow_component(comp: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:178:def _find_arrow_sources(grid: np.ndarray) -> list[dict]:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:181:    arrows: list[dict] = []\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:199:            parsed = _parse_arrow_component(comp)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:203:            arrows.append({\"tip\": tip, \"direction\": direction, \"cells\": comp})\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:205:    arrows.sort(key=lambda item: item[\"tip\"])\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:206:    return arrows\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:231:    assert dr != 0 and abs(dr) == abs(dc), \"paired arrow tips must share a diagonal\"\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:238:    raise AssertionError(\"paired arrows must face each other along their tip diagonal\")\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:265:    arrows = _find_arrow_sources(grid)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:267:    for arrow in arrows:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:268:        tip = arrow[\"tip\"]\n/home/lixinyu/snap/new/cesh