_clear_for_ray(ray_cells, occ, arrow_guard, ray_guard, own_arrow):\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:616:            for rr, cc in arrow_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:618:                out[rr, cc] = int(arrow_color)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:619:            _mark_guard(arrow_guard, arrow_cells)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:641:    arrows: list[dict],\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:645:    pre_idx = max(range(len(arrows)), key=lambda i: arrows[i][\"tiles\"])\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:646:    if arrows[pre_idx][\"tiles\"] < _PRE_EXT_IDEAL_TILES:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:647:        candidates = [i for i, meta in enumerate(arrows) if meta[\"tiles\"] >= _PRE_EXT_IDEAL_TILES]\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:652:    for i, meta in enumerate(arrows):\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:666:        raise ValueError(f\"unsupported arrow count: {n}\")\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:691:    arrow_color = int(rng.choice(others))\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:692:    palette = [c for c in others if c != arrow_color]\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:700:    arrow_guard = np.zeros((H, W), dtype=bool)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:703:    arrows: list[dict] = []\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:705:        meta = _place_arrow_and_ray(\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:713:            arrow_guard,\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:716:            arrow_color,\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:720:        arrows.append(meta)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:722:    inp = _build_input_from_output(out, arrows, bg, rng)\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/18/code.py:30:#    - base solver used centroid quantization to assign colors; here quadrant membership is better read\n/home/lixinyu/snap/new/ceshi/code/cbebaa4b/D8/1/code.py:243:    - Color no longer identifies connectors. The signal is geometric: connectors are the short exposed edge tabs, so the puzzle is solved by pairing compatible boundary protrusions rather than by chasing red pixels.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:134:    \"\"\"Return border particles that have exactly one adjacent arrow marker.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:193:    \"\"\"Move magenta edge particles by following explicit arrows through spiral corridors.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:196:    - bg=7, particle=6, arrow=2.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:198:    - Each valid particle has exactly one adjacent arrow pixel; that offset gives the initial direction.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:202:    - Start each edge particle in the arrow-indicated direction.\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:203:    - Move straight through passable cells (`bg`, `particle`, `arrow`).\n/home/lixinyu/snap/new/ceshi/code_combo/9bbf930d/29/code.py:211:      change the tracing rule; only the arrow-selected initial direction changes.\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/25/code.py:29:#    one-cell teeth, concave bites, narrow bridges, and visible staircase seams. The output still\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/25/code.py:45:#      piece centroids remain in distinct 2x2 cells after roughening.\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/25/code.py:54:#    corner-like centroid cell of the assembled square.\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/25/code.py:361:    - The piece silhouettes are highly irregular: tabs, bites, narrow bridges, and staircase-like borders are expected.\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/25/code.py:366:    - After assembly, recolor each entire piece by the legend palette entry selected from the piece centroid's 2x2 cell within the square.\n/home/lixinyu/snap/new/ceshi/code_combo/3dc255db/23/code.py:44:# - The ordering key is geometric: bbox center distance to the whole-grid center. No invisible color\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/26/code.py:49:#    - The original recoloring logic depended only on centroid quadrant. The fused rule also depends\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/27/code.py:438:    - Recolor the assembled pieces by the legend color selected from the piece centroid's quadrant and output the cropped assembly.\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:26:#    - Only two opening sizes are used: 2 -> narrow, 3 -> wide. This is enough to\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:50:#      and often mixes narrow + wide openings in the same grid for contrast.\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:695:    narrow_idx: int | None = None\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:696:    narrow_candidates = [i for i, available in enumerate(available_per_block) if i != wide_idx and 2 in available]\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:697:    if block_count >= 2 and narrow_candidates and rng.random() < 0.8:\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:698:        narrow_idx = narrow_candidates[int(rng.integers(len(narrow_candidates)))]\n/home/lixinyu/snap/new/ceshi/code/e12f9a14/D5/2/code.py:704:        elif i == narrow_idx:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/22/code.py:227:    \"\"\"Squared distance from plus bbox center to grid center, with geometric tie-breaks.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/f560132c/8/code.py:21:#      at its centroid.\n/home/lixinyu/