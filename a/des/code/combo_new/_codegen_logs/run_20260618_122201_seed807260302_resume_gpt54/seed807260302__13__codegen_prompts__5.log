oups.setdefault(markers[0][2], []).append(arrow)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:426:        assert len(group) == 2, \"each marker color must label exactly two arrows\"\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:517:        p_cells = _arrow_cells(p, direction)\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:518:        q_cells = _arrow_cells(q, (-dr, -dc))\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:519:        pair_arrow_cells = p_cells | q_cells\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:520:        if any(not (0 <= r < h and 0 <= c < w) for r, c in pair_arrow_cells):\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:522:        if any(cell in occupied or cell in drawn for cell in pair_arrow_cells):\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:527:        for cell in pair_arrow_cells:\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:558:        if any(cell in occupied or cell in drawn or cell in pair_arrow_cells for cell in ray_cells):\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:563:        pair_blue_cells = blue_occupied | pair_arrow_cells\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:564:        forbidden = occupied | drawn | path_cells | ray_cells | pair_arrow_cells\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:577:            \"arrow_cells\": (p_cells, q_cells),\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:610:        p_cells, q_cells = pair[\"arrow_cells\"]\n/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py:632:        p_cells, q_cells = pair[\"arrow_cells\"]\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/39/code.py:375:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/39/code.py:376:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:61:#    - solver 假设每个箭头中心都带有同家族的单个对角装饰，generator 的 _place_arrow_marker() 保证这一点。\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:66:#    - 生成器额外计算“arrow-only 路由”和“融合规则路由”的底部落点差异；若二者完全一致，则说明蓝色覆盖没有实际生效，\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:176:def _find_arrow_markers(g: np.ndarray) -> dict[tuple[int, int], int]:\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:177:    \"\"\"Return {center: hdir} for decoded arrow-family junction markers.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:203:    arrow_markers: dict[tuple[int, int], int],\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:205:    \"\"\"Return {arrow_center: PASS_MARK|TURN_MARK} for controlled interior crossings.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:209:    for r, c in arrow_markers:\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:243:def _turn_dir_at_arrow(d: tuple[int, int], hdir: int) -> tuple[int, int] | None:\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:268:    arrow_markers: dict[tuple[int, int], int],\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:272:    Follow one wire component using arrow-family defaults, red/blue overrides, and 9-rect pass-through.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:274:    Pure arrow junctions always apply their turn family. At interior crossings, blue keeps the\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:275:    current direction while red executes that same arrow-family turn.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:282:            raise AssertionError(\"wire trace looped under arrow+color routing\")\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:309:        arrow_hdir = arrow_markers.get(cur)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:310:        if arrow_hdir is not None:\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:314:                nd = _turn_dir_at_arrow(d, arrow_hdir)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:351:    Route colored 3x3 tokens through pipe networks whose default turns come from arrow junctions, but whose crossings can overrule those arrows.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:356:    - Some junction centers are colored arrow markers (4/5) with a matching diagonal decoration; some of those same junctions also carry blue/red side markers that control the crossing behavior.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:361:    - At an arrow-only junction, the signal follows the arrow's turn family. At an arrow+color crossing, red executes that turn while blue forces straight-through motion instead.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:365:    - The new challenge is two-layer routing: arrows define the default local turn map, but blue crossings visibly override that default. Correct endpoint pairing therefore depends on learning both the arrow family and the color priority.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:373:    arrow_markers = _find_arrow_markers(g)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:379:    for p in arrow_markers:\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:392:    crossing_controls = _find_crossing_controls(track_mask, g, arrow_markers)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:426:                    end, dd = _trace_wire(comp, ep, (-odr, -odc), h, w, rects_9, arrow_markers, crossing_controls)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:435:                    end, dd = _trace_wire(comp, ep, (-odr, -odc), h, w, rects_9, arrow_markers, crossing_controls)\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:506:def _place_arrow_marker(grid: np.ndarray, r: int, c: int, hdir: int) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:570:    Draw continuous channel columns plus arrow-marked row transfers.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:572:    Each interior crossing gets both an arrow-family center and a red/blue control pair.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:573:    Blue keeps straight; red executes the arrow family's swap turn.\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:595:        if not _place_arrow_marker(grid, xrow, src_col, hdir):\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:596:            raise AssertionError(\"failed to place source arrow marker\")\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:597:        if not _place_arrow_marker(grid, xrow, dst_col, hdir):\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:598:            raise AssertionError(\"failed to place destination arrow marker\")\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:610:            if not _place_arrow_marker(grid, xrow, c, hdir):\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:611:                raise AssertionError(\"failed to place interior arrow marker\")\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:642:    \"\"\"Attempt to place one color-9 rectangle without swallowing arrow/color controls.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:818:    arrow_only_bottom = _bottom_slots(_simulate_rows(n, row_specs, force_all_turn=True))\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:819:    priority_effect = sum(int(a != b) for a, b in zip(actual_bottom, arrow_only_bottom))\n/home/lixinyu/snap/new/ceshi/code_combo/a47bf94d/2/code.py:861:    \"\"\"Helper for diagnostics of the fused arrow+crossing-control behavior.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/2/code.py:32:#       the last gravity-reachable placement above the first too-narrow slice.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/2/code.py:66:#       the last shaft becomes narrower row by row. In blocked examples the mover stops just above\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/2/code.py:67:#       the narrow segment while the red square remains below it.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/2/code.py:77:#       gravity-like descent plus a monotone narrowing that eventually becomes too tight.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/2/code.py:226:      too narrow for the square.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:23:#    - D3/0: the external source object becomes an arrow sprite with one ring tip\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:27:#    Example: an arrow touching the top ring at column c points downward into the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:29:#    entire interior column from top to bottom. If the arrow is two-colored, the\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:31:#    it. A bottom-touching arrow at the same column would paint the same geometry\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:37:#    - there are 2-3 arrows per grid, not just one\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:38:#    - arrows can start from either of two opposite sides of the chosen axis\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:39:#    - monochrome and two-color arrows both appear\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:40:#    - at least one arrow per sample is two-color so direction is behaviorally\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:43:#    either vertical rays (top/bottom arrows) or horizontal rays (left/right\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:44:#    arrows). That avoids row/column crossings that would otherwise create noisy\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:49:#    - useful components no longer have >=2 ring touches; each arrow has exactly 1\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:52:#    - U-pairs are incompatible with \"one arrow -> one through-line\", so they are\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:55:#    has the local arrow-head geometry for that side, then derives the full line\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:60:#    then converts each line into a single external arrow with:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:71:#    plainly an inward-pointing arrow attached to one side of the frame. The\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:82:#    Colors are structural, not id-based. Monochrome arrows produce solid rays.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:83:#    Two-color arrows alternate along the shaft and continue that alternation in\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:90:#    component has one touch plus an arrow head, and the output is full-span\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:96:#    - that ring cell belongs to a valid arrow-head pattern for one side\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:98:#    - useful arrows do not intersect in the cropped output\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:100:#    per sample, dedicated palette colors, and explicit arrow-shape validation in\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:208:def _has_arrow_tip(coords: set[tuple[int, int]], tip: tuple[int, int], side: str) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:298:def _place_arrow_component(\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:327:    Reconstruct full-span interior rays from external arrows around a framed rectangle.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:331:    - Useful external components are inward-pointing arrows. Each arrow has exactly one tip cell\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:336:    - Map each arrow tip to the corresponding interior boundary cell.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:339:    - Monochrome arrows paint solid rays; two-color arrows alternate starting from the tip color.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:342:    - The arrow no longer encodes two endpoints. Its single ring tip fixes the line position, and\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:343:      the side/orientation of the arrow determines which full-span straight ray must be drawn.\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:382:        if side is None or not _has_arrow_tip(coords, tip, side):\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:457:    Every sample contains at least one monochrome arrow and one two-color arrow\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:467:def _arrow_specs(side: str, idx: int, H: int, W: int, r0: int, c0: int, r1: int, c1: int):\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:586:        inner, backbone, head = _arrow_specs(side, idx, H, W, r0, c0, r1, c1)\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/29/code.py:600:        if not _place_arrow_component(grid, comp_mask, backbone, head, colors, bg):\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/16/code.py:226:    Original sliding-square physics on a very sparse narrow river, followed by a tight crop\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/16/code.py:331:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/16/code.py:332:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code/9bbf930d/D5/3/code.py:39:# - The variant is intentionally narrow: corridor geometry, turn shapes, and\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/25/code.py:29:# - The variant is intentionally narrow rather than fully free-form:\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/9/code.py:409:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/9/code.py:410:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/10/code.py:19:#      the farthest reachable placement before a chokepoint narrower than n.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:32:#      combo: detect arrow-shaped mover -> read its tip direction -> read border control\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:36:#    - Only two extra cues are added: one protrusion pixel and one edge control pixel.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:37:#    - n is restricted to 2..4. This keeps the arrow decomposition legible and avoids\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:57:#    - Across examples, humans can see one arrowed object, one plain target square, one\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:58:#      red boundary dot, and outputs that sometimes follow the arrow and sometimes defy it.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:103:def _arrow_square_info(comp: dict) -> dict | None:\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:261:        mover_info = _arrow_square_info(comp)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:404:    narrow_w = random.randint(1, n - 1)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:405:    remove = n - narrow_w\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:793:    arrow_step = control_step if agree else (decoy_step if control_step == main_step else main_step)\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/19/code.py:795:    tip = _choose_tip_cell(grid, mover_r, mover_c, n, STEP_TO_NAME[arrow_step])\n/home/lixinyu/snap/new/ceshi/code_combo/a6f40cea/24/code.py:62:     into the same narrow area.\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/4/code.py:47:  - a later horizontal gate may narrow to height 2, so it still passes\n/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/4/code.py:48:  - the final horizontal gate may narrow 