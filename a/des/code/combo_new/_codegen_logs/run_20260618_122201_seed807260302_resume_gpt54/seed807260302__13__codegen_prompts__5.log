ew/ceshi/code_combo/6e453dd6/16/code.py:378:        patch[:, -1] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:380:        patch[0, :] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:381:        patch[-1, :] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:382:        patch[:, 0] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:384:        patch[:, -1] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:386:            patch[0, :] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:388:            patch[-1, :] = shell_color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:428:def _choose_shell_colors(n: int) -> list[int]:\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:438:    shell_colors: list[int],\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:445:    for (r0, sh), ray_color, shell_color in zip(bands, roles, shell_colors):\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:447:            patch = _distractor_patch(sh, max_sw, shell_color)\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:449:            patch = _emitter_patch(sh, max_sw, shell_color, ray_color)\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:482:    shell_colors = _choose_shell_colors(len(roles))\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/16/code.py:483:    out, sprites = _render_output(h, w, sep, bands, roles, shell_colors)\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/12/code.py:71:#      shells produce rays, open C/L/solid shapes do not.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/12/code.py:282:    \"\"\"Fill a right-facing emitter template with one main vent and an optional mini shell.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/8b9c3697/26/code.py:309:# ── CFG: nested structures ──────────────────────────────────────────\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:19:#    Example: a blue hollow shell at cols 1..4 slides right by 2 so its flush position is 3..6.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:21:#      1. erase the old black shell to background\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:22:#      2. redraw the shell in black at cols 3..6\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:25:#      1. recolor the old blue shell to its partner afterimage color orange\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:26:#      2. redraw the shell in blue at cols 3..6\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:27:#      3. detect holes using only the moved blue shell, then paint blue rays on the right\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:30:#      - ray color is no longer fixed; it inherits the emitting shell's own color\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/9/code.py:208:    Key insight: Two color correspondences must be tracked per component at once: old location becomes the sprite's partner trail color, while the moved shell keeps its original color and that same original color is what the triggering hole projects to the right.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/10/code.py:22:#     - Example: two identical hollow shells occupy different row bands. Sprite A is already\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/10/code.py:26:#       2. Both shells now have holes touching `sep-2`.\n/home/lixinyu/snap/new/ceshi/code_combo/6e453dd6/10/code.py:254:    \"\"\"Build an emitter sprite patch: a closed shell with an interior hole at the right edge.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/8/code.py:490:    shell_mismatch = 0\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/8/code.py:496:        shell_col = max(non_conn.items(), key=lambda kv: kv[1])[0]\n/home/lixinyu/snap/new/ceshi/code_combo/2c181942/8/code.py:500:        if int(shell_col) != int(side_e