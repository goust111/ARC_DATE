   arrow_set = set(arrow_pts)\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:470:                if any(not (0 <= r < H and 0 <= c < W) or (r, c) in occupied for r, c in arrow_pts):\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:476:                if any(cell in occupied or cell in arrow_set for cell in prefix):\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:479:                arrow = {\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:481:                    \"pts\": arrow_pts,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:485:                info = _trace_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:488:                    arrow=arrow,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:490:                    arrow_cells=arrow_cells | arrow_set,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:507:                    \"arrow_pts\": arrow_pts,\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:518:    arrow_cells: set[Coord],\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:523:    for r, c in placement[\"arrow_pts\"]:\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:526:        arrow_cells.add((int(r), int(c)))\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:541:    target_arrows = _rng.choices([2, 3], weights=[4, 1])[0]\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:545:    arrow_colors = palette[:target_arrows]\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:549:    arrow_cells: set[Coord] = set()\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:554:    foundation = _plan_static_arrow(\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:557:        color=int(arrow_colors[0]),\n/home/lixinyu/snap/new/ceshi/code_combo/142ca369/13/code.py:566:    _commit_placement(grid, occupied, arrow_cells, static_walls, prior_ray_cells, foundation)\n/home/lixinyu/snap/new/