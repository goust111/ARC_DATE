{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/71e489b6.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Highlight black defects in blue foreground by surrounding them with orange.\n\n    Input structure:\n    - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.\n\n    Rule:\n    - Thin blue pixels mostly surrounded by black are absorbed into the background.\n    - Small black components (≤3 cells) and leaf pixels of larger black components are \"defects.\"\n    - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.\n\n    Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    hole_col = 0\n    border_col = 7\n\n    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.\n    base = g.copy()\n    for r in range(H):\n        for c in range(W):\n            if int(base[r, c]) != 1:\n                continue\n            nb = 0\n            oob = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if not (0 <= rr < H and 0 <= cc < W):\n                    oob += 1\n                    continue\n                if int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            # only count outside-as-black for corners (two out-of-bounds sides)\n            if oob >= 2:\n                nb += int(oob)\n            if nb >= 3:\n                base[int(r), int(c)] = int(hole_col)\n\n    # STEP 1/2) Collect target black pixels (they must remain black).\n    preserve: set[tuple[int, int]] = set()\n    comps = components_mask(base == int(hole_col), connectivity=4)\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        if len(pts_list) <= 3:\n            preserve.update(pts_list)\n            continue\n        for r, c in pts_list:\n            nb = 0\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):\n                    nb += 1\n            if nb <= 1:\n                preserve.add((int(r), int(c)))\n\n    # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.\n    out = base.copy()\n    for coords in comps:\n        pts_list = [(int(r), int(c)) for r, c in coords]\n        targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]\n        for r, c in targets:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    rr = int(r + dr)\n                    cc = int(c + dc)\n                    if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:\n                        out[rr, cc] = int(border_col)\n\n    # Ensure target black pixels remain black.\n    for r, c in preserve:\n        out[int(r), int(c)] = int(hole_col)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (16, 19)           # canvas height bounds\nGRID_W_RANGE = (16, 19)           # canvas width bounds\nMIN_BLUE_REGION = 30              # minimum blue region size (cells)\nMIN_BLACK_REGION = 20             # minimum black region size (cells)\nPARTITION_STYLES = ['h_stripes', 'rect_inset', 'l_shape']\nSTRIPE_CUTS_RANGE = (1, 3)       # number of horizontal cuts for h_stripes\nCUT_MARGIN = 3                   # min distance from grid edge for cuts\nINSET_MARGIN = 2                 # padding from edge for rect_inset\nINNER_INSET_MIN_GAP = 6          # min dimension for nested inset\nINNER_INSET_PROB = 0.5           # probability of nested inset\nDEFECT_COUNT_RANGE = (2, 9)      # number of defect holes to place\nDEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]\nDEFECT_CLEARANCE = 2             # min Chebyshev distance between defects\nDEFECT_PLACE_TRIES = 50          # retries per defect placement\nLEAF_COUNT_RANGE = (0, 4)        # number of leaf protrusions\nSPUR_COUNT_RANGE = (2, 6)        # number of blue spurs in black regions\nMIN_DEFECTS = 2                  # reject grid if fewer defects placed\nMIN_SPURS = 2                    # reject grid if fewer spurs placed\nMAX_GEN_ATTEMPTS = 300           # outer retry limit\n\n\ndef _nearby(r: int, c: int, dist: int, ref: set) -> bool:\n    \"\"\"Return True if any pixel in `ref` is within Chebyshev distance `dist`.\"\"\"\n    for dr in range(-dist, dist + 1):\n        for dc in range(-dist, dist + 1):\n            if (r + dr, c + dc) in ref:\n                return True\n    return False\n\n\ndef _exclusion_zone(pixels, dist: int) -> set:\n    \"\"\"Return the set of all coords within Chebyshev `dist` of any pixel.\"\"\"\n    zone = set()\n    for r, c in pixels:\n        for dr in range(-dist, dist + 1):\n            for dc in range(-dist, dist + 1):\n                zone.add((r + dr, c + dc))\n    return zone\n\n\ndef _build_partition(H: int, W: int) -> np.ndarray:\n    \"\"\"Create an H x W grid partitioned into blue (1) and black (0) regions.\"\"\"\n    grid = np.zeros((H, W), dtype=int)\n    style = random.choice(PARTITION_STYLES)\n\n    if style == 'h_stripes':\n        n_cuts = random.randint(*STRIPE_CUTS_RANGE)\n        cuts = sorted(random.sample(\n            range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))\n        boundaries = [0] + cuts + [H]\n        first_color = random.randint(0, 1)\n        for i in range(len(boundaries) - 1):\n            grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2\n\n    elif style == 'rect_inset':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        r0 = random.randint(INSET_MARGIN, H // 3)\n        r1 = random.randint(2 * H // 3, H - CUT_MARGIN)\n        c0 = random.randint(INSET_MARGIN, W // 3)\n        c1 = random.randint(2 * W // 3, W - CUT_MARGIN)\n        grid[r0:r1 + 1, c0:c1 + 1] = 1 - bg\n        if (r1 - r0 > INNER_INSET_MIN_GAP and c1 - c0 > INNER_INSET_MIN_GAP\n                and random.random() < INNER_INSET_PROB):\n            ir0 = random.randint(r0 + 2, r0 + (r1 - r0) // 3)\n            ir1 = random.randint(r0 + 2 * (r1 - r0) // 3, r1 - 2)\n            ic0 = random.randint(c0 + 2, c0 + (c1 - c0) // 3)\n            ic1 = random.randint(c0 + 2 * (c1 - c0) // 3, c1 - 2)\n            grid[ir0:ir1 + 1, ic0:ic1 + 1] = bg\n\n    elif style == 'l_shape':\n        bg = random.randint(0, 1)\n        grid[:, :] = bg\n        vc = random.randint(W // 3, 2 * W // 3)\n        if random.random() < 0.5:\n            grid[:, :vc] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[:hc, vc:] = 1 - bg\n        else:\n            grid[:, vc:] = 1 - bg\n            hc = random.randint(H // 3, 2 * H // 3)\n            grid[hc:, :vc] = 1 - bg\n\n    return grid\n\n\ndef _find_interior_blue(grid: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return blue pixels whose 4-neighbors are all blue or out-of-bounds.\"\"\"\n    H, W = grid.shape\n    blue = grid == 1\n    # A blue pixel is interior if no in-bounds 4-neighbor is non-blue.\n    eroded = blue.copy()\n    eroded[:-1, :] &= blue[1:, :]   # neighbor below\n    eroded[1:, :]  &= blue[:-1, :]  # neighbor above\n    eroded[:, :-1] &= blue[:, 1:]   # neighbor right\n    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left\n    rs, cs = np.where(eroded)\n    coords = list(zip(rs.tolist(), cs.tolist()))\n    random.shuffle(coords)\n    return coords\n\n\ndef _place_defects(grid: np.ndarray, interior_blue: list) -> tuple[set, int]:\n    \"\"\"Place 2-9 small black defects in blue-region interiors.\n\n    Returns (defect_pixels, defects_placed). Modifies `interior_blue` in place.\n    \"\"\"\n    H, W = grid.shape\n    n_defects = random.randint(*DEFECT_COUNT_RANGE)\n    defect_pixels: set[tuple[int, int]] = set()\n    interior_set = set(interior_blue)\n    defects_placed = 0\n\n    for _ in range(n_defects):\n        if not interior_blue:\n            break\n        defect_size = random.choices([1, 2, 3], weights=DEFECT_SIZE_WEIGHTS)[0]\n\n        placed = False\n        for _try in range(DEFECT_PLACE_TRIES):\n            if not interior_blue:\n                break\n            seed_r, seed_c = interior_blue[random.randint(0, len(interior_blue) - 1)]\n\n            if _nearby(seed_r, seed_c, DEFECT_CLEARANCE, defect_pixels):\n                continue\n\n            # Grow defect from seed\n            defect = [(seed_r, seed_c)]\n            if defect_size > 1:\n                dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n                random.shuffle(dirs)\n                for dr, dc in dirs:\n","exit_code":0,"status":"completed"}}
