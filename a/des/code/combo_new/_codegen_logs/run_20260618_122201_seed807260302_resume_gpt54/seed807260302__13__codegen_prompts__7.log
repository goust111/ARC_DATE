{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py /home/lixinyu/snap/new/ARC_code/train/d93c6891.py /home/lixinyu/snap/new/ARC_code/train/963c33f8.py /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py /home/lixinyu/snap/new/ARC_code/eval/16b78196.py /home/lixinyu/snap/new/ARC_code/eval/36a08778.py; do echo \"==== $f\"; sed -n '\"'/\"'^def main/,/''^def generate_input/p'\"' \\\"\"'$f\" | sed '\"'\"'$d'\"'; sed -n '/\"'^def generate_input/,/''^[''^[:space:]]/p'\"' \\\"\"'$f\"; done'","aggregated_output":"==== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        rng.shuffle(dirs)\n        placed = False\n        for ddr, ddc in dirs:\n            nr, nc = cur[0] + ddr, cur[1] + ddc\n            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\n                continue\n            # Keep path thin: reject if 8-adjacent to existing path (except cur)\n            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\n                   for nnr, nnc in neighbors8(nr, nc)):\n                continue\n            # Strongly avoid grid border\n            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\n                continue\n            cur = (nr, nc)\n            path.append(cur)\n            path_set.add(cur)\n            grid[nr, nc] = line_col\n            placed = True\n            break\n        if not placed:\n            if rng.random() < BIAS_FLIP_PROB:\n                dr_bias *= -1\n            if rng.random() < BIAS_FLIP_PROB:\n                dc_bias *= -1\n            break\n    return path\n\n\n# ---------------------------------------------------------------------------\n# Frame attachment\n# ---------------------------------------------------------------------------\n\ndef _halo_offsets(fh, fw):\n    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n            if not (0 <= dr < fh and 0 <= dc < fw)]\n\n\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n\n    canvas is modified in place; returns (ring, cavity) or None on failure.\n    \"\"\"\n    h, w = canvas.shape\n    pad = FRAME_PLACEMENT_PAD\n    for _ in range(max_tries):\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n        lp = rng.choice(line_path)\n        fh, fw = ch + 2, cw + 2\n        offsets = _halo_offsets(fh, fw)\n        rng.shuffle(offsets)\n        for dr, dc in offsets:\n            r0 = lp[0] - dr\n            c0 = lp[1] - dc\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n                continue\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n                continue\n            for rr, cc in ring:\n                canvas[rr, cc] = frame_col\n            return ring, cavity\n    return None\n\n\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n    h, w = canvas.shape\n    for _ in range(max_tries):\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        fh, fw = ch + 2, cw + 2\n        r0 = rng.randint(1, h - fh - 1)\n        c0 = rng.randint(1, w - fw - 1)\n        # Check the full bbox + 1-cell margin is empty\n        ok = True\n        for rr in range(r0 - 1, r0 + fh + 1):\n            for cc in range(c0 - 1, c0 + fw + 1):\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n        for rr, cc in ring:\n            canvas[rr, cc] = frame_col\n        return True\n    return None\n\n\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n    h, w = canvas.shape\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\n        r = rng.randint(2, h - 3)\n        c = rng.randint(2, w - 3)\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n            continue\n        canvas[r, c] = line_col\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n        if len(path) < 3:\n            for pr, pc in path:\n                canvas[pr, pc] = -1\n            continue\n        attached = 0\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached > 0:\n            return True\n        for pr, pc in path:\n            canvas[pr, pc] = -1\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Main generator\n# ---------------------------------------------------------------------------\n\ndef _corner_config(corner_kind, h, w, rng):\n    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n    if corner_kind == 'TL':\n        seed = (0, 0)\n        first = rng.choice([(0, 1), (1, 0)])\n    elif corner_kind == 'TR':\n        seed = (0, w - 1)\n        first = rng.choice([(0, w - 2), (1, w - 1)])\n    elif corner_kind == 'BL':\n        seed = (h - 1, 0)\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n    elif corner_kind == 'BR':\n        seed = (h - 1, w - 1)\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n    else:\n        raise ValueError(corner_kind)\n    return seed, first\n\n\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n    seed_order = list(range(num_seeds))\n    rng.shuffle(seed_order)\n    per_seed = [0] * num_seeds\n    remaining = num_attached_target\n    # Guarantee at least 1 per seed\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n        for i in seed_order:\n            if per_seed[i] == 0 and remaining > 0:\n                per_seed[i] += 1\n                remaining -= 1\n    # Distribute remainder randomly\n    while remaining > 0:\n        per_seed[rng.choice(seed_order)] += 1\n        remaining -= 1\n    return per_seed\n\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n==== /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n        lo_b1 = max(min_len, total_gray - max_len)\n        hi_b1 = min(total_gray - min_len, max_len)\n        if lo_b1 > hi_b1:\n            return None\n        b1 = random.randint(lo_b1, hi_b1)\n        return [b1, total_gray - b1]\n    if total_gray > max_len:\n        return None\n    return [total_gray]\n\n\ndef _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n    placed_bars = []\n    for bl in bar_lengths:\n        sides = []\n        if span0 - lo_bound >= bl:\n            sides.append(0)\n        if hi_bound - span1 >= bl:\n            sides.append(1)\n        random.shuffle(sides)\n        placed = False\n        for s in sides:\n            b0 = (span0 - bl) if s == 0 else (span1 + 1)\n            b1 = b0 + bl - 1\n            cells = occupied[fixed, b0:b1+1] if axis == 'h' else occupied[b0:b1+1, fixed]\n            if b0 < lo_bound or b1 > hi_bound or cells.any():\n                continue\n            if axis == 'h':\n                occupied[fixed, b0:b1+1] = True\n                placed_bars.append(('h', fixed, b0, b1))\n            else:\n                occupied[b0:b1+1, fixed] = True\n                placed_bars.append(('v', b0, b1, fixed))\n            placed = True\n            break\n        if not placed:\n            return None\n    return placed_bars\n\n\ndef _plan_bars(orange_rects, touched_list, bpo, content_box, occupied):\n    \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n    cr0, cc0, cr1, cc1 = content_box\n    bars_info = []\n    for idx, oi in enumerate(touched_list):\n        edge, or0, oc0, or1, oc1 = orange_rects[oi]\n        oh, ow = or1 - or0 + 1, oc1 - oc0 + 1\n        n_bars = bpo[idx]\n\n        if edge in HORIZONTAL_EDGES:\n            max_stripes, divisor = oh, ow\n        else:\n            max_stripes, divisor = ow, oh\n\n        stripe_count = random.randint(1, max_stripes)\n        total_gray = stripe_count * divisor\n        bar_lengths = _split_bar_lengths(total_gray, n_bars)\n        if bar_lengths is None:\n            return None\n\n        if edge == 'top':\n            bar_rc = or0\n        elif edge == 'bottom':\n            bar_rc = or1\n        elif edge == 'left':\n            bar_rc = oc0\n        else:\n            bar_rc = oc1\n        if edge in HORIZONTAL_EDGES:\n            placed_bars = _place_bars('h', bar_rc, oc0, oc1, cc0, cc1, bar_lengths, occupied)\n        else:\n            placed_bars = _place_bars('v', bar_rc, or0, or1, cr0, cr1, bar_lengths, occupied)\n        if placed_bars is None:\n            return None\n\n        bars_info.append((oi, placed_bars, edge, stripe_count))\n    return bars_info\n\n\ndef _render_input_grid(grid, orange_rects, bars_info):\n    for _, or0, oc0, or1, oc1 in orange_rects:\n        grid[or0:or1+1, oc0:oc1+1] = Color.ORANGE\n    for _, bars, _, _ in bars_info:\n        for bar in bars:\n            if bar[0] == 'h':\n                grid[bar[1], bar[2]:bar[3]+1] = Color.GRAY\n            else:\n                grid[bar[1]:bar[2]+1, bar[3]] = Color.GRAY\n\n\ndef _expected_output(grid, orange_rects, bars_info):\n    expected = grid.copy()\n    expected[grid == Color.GRAY] = Color.YELLOW\n    for oi, _, contact_side, stripe_count in bars_info:\n        _, or0, oc0, or1, oc1 = orange_rects[oi]\n        if contact_side == 'top':\n            expected[or0:or0+stripe_count, oc0:oc1+1] = Color.GRAY\n        elif contact_side == 'bottom':\n            expected[or1-stripe_count+1:or1+1, oc0:oc1+1] = Color.GRAY\n        elif contact_side == 'left':\n            expected[or0:or1+1, oc0:oc0+stripe_count] = Color.GRAY\n        else:\n            expected[or0:or1+1, oc1-stripe_count+1:oc1+1] = Color.GRAY\n    return expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    canvas = _make_canvas()\n    if canvas is None:\n        return None\n    grid, content_box = canvas\n    occupied = np.zeros(grid.shape, dtype=bool)\n\n    orange_rects = _place_oranges(content_box, occupied)\n    if orange_rects is None:\n        return None\n\n    touched_list = _choose_touched_oranges(len(orange_rects))\n    bpo = _choose_bars_per_orange(touched_list)\n    if bpo is None:\n        return None\n\n    bars_info = _plan_bars(orange_rects, touched_list, bpo, content_box, occupied)\n    if bars_info is None:\n        return None\n\n    _render_input_grid(grid, orange_rects, bars_info)\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(output, _expected_output(grid, orange_rects, bars_info)):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n==== /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n            if expanded:\n                break\n        if not expanded:\n            break\n    return comp if len(comp) == comp_size else None\n\n\ndef _place_obstacle_components(grid: np.ndarray, component_sizes: list[int], forbidden: set[tuple[int, int]],\n                               obstacle_pixels: set[tuple[int, int]]) -> bool:\n    for comp_size in component_sizes:\n        placed = False\n        for _ in range(COMPONENT_PLACEMENT_ATTEMPTS):\n            comp = _grow_component(grid, comp_size, forbidden, obstacle_pixels)\n            if comp is None:\n                continue\n            if any((pr + dr, pc + dc) in obstacle_pixels\n                   for pr, pc in comp for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]):\n                continue\n            for pr, pc in comp:\n                grid[pr, pc] = GEN_OBSTACLE\n                obstacle_pixels.add((pr, pc))\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _scatter_obstacles(grid: np.ndarray, c0: int, stop_positions: list[int],\n                       obstacle_pixels: set[tuple[int, int]]) -> bool:\n    H, _W = grid.shape\n    num_target_components = random.randint(*OBSTACLE_COMPONENT_RANGE)\n    total_target_pixels = random.randint(*OBSTACLE_PIXEL_RANGE)\n    remaining_pixels = max(0, total_target_pixels - len(obstacle_pixels))\n    remaining_components = max(1, num_target_components - len(stop_positions))\n    if remaining_pixels <= 0 or remaining_components <= 0:\n        return True\n\n    component_sizes = _sample_component_sizes(remaining_pixels, remaining_components)\n    if component_sizes is None:\n        return False\n    forbidden = _forbidden_cells(H, c0, stop_positions, obstacle_pixels)\n    return _place_obstacle_components(grid, component_sizes, forbidden, obstacle_pixels)\n\n\ndef _has_clear_stop_drop_zones(grid: np.ndarray, c0: int, stop_positions: list[int]) -> bool:\n    H, _W = grid.shape\n    for j in stop_positions:\n        col = c0 + j\n        first_obs = next((r for r in range(MARKER_SIZE, H) if grid[r, col] == GEN_OBSTACLE), None)\n        if first_obs is None:\n            return False\n        for dr in range(1, DROP_ZONE_HEIGHT + 1):\n            if first_obs - dr < 0 or grid[first_obs - dr, col] != GEN_BG:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid, c0, stop_positions, obstacle_pixels = _init_scene(H, W)\n\n    if not _scatter_obstacles(grid, c0, stop_positions, obstacle_pixels):\n        return None\n    if not _has_clear_stop_drop_zones(grid, c0, stop_positions):\n        return None\n    obs_comps = [c for c in find_components(grid, bg=GEN_BG, connectivity=4, monochromatic=True)\n                 if c['color'] == GEN_OBSTACLE]\n    if not (OBSTACLE_COMPONENT_RANGE[0] <= len(obs_comps) <= OBSTACLE_COMPONENT_RANGE[1]):\n        return None\n\n    # Run solver to verify no assertion failures\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n==== /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n\n    # Union-find to merge adjacent cells by removing internal wall segments\n    parent = list(range(total_cells))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        px, py = find(x), find(y)\n        if px == py:\n            return False\n        parent[px] = py\n        return True\n\n    def cell_id(cr, cc):\n        return cr * (n_vcols - 1) + cc\n\n    # Enumerate internal wall segments (between adjacent cells)\n    internal_segments = []\n    for hi in range(1, n_hrows - 1):\n        r = hrow_positions[hi]\n        for ci in range(n_vcols - 1):\n            c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]\n            internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))\n    for ci in range(1, n_vcols - 1):\n        c = vcol_positions[ci]\n        for hi in range(n_hrows - 1):\n            r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]\n            internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))\n\n    random.shuffle(internal_segments)\n    merged = 0\n    for seg in internal_segments:\n        if merged >= cells_to_merge:\n            break\n        if seg[0] == 'h':\n            _, r, c0, c1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r, c0 + 1:c1] = False\n                merged += 1\n        else:\n            _, c, r0, r1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r0 + 1:r1, c] = False\n                merged += 1\n\n    if merged < cells_to_merge:\n        return None\n    if _count_enclosed_regions(walls) != target_rooms:\n        return None\n    return walls\n\n\ndef _force_overlap(positions, i, j, frames, grid_h, grid_w):\n    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n    fi_h, fi_w = frames[i][2].shape\n    fj_h, fj_w = frames[j][2].shape\n    ri, ci = positions[i]\n    r0_min = max(0, ri - fj_h + 2)\n    r0_max = min(grid_h - fj_h, ri + fi_h - 2)\n    c0_min = max(0, ci - fj_w + 2)\n    c0_max = min(grid_w - fj_w, ci + fi_w - 2)\n    if r0_min > r0_max or c0_min > c0_max:\n        return\n    for _ in range(_OVERLAP_RETRY):\n        rj = random.randint(r0_min, r0_max)\n        cj = random.randint(c0_min, c0_max)\n        # Verify bbox overlap\n        if (max(ri, rj) <= min(ri + fi_h - 1, rj + fj_h - 1) and\n                max(ci, cj) <= min(ci + fi_w - 1, cj + fj_w - 1)):\n            positions[j] = (rj, cj)\n            return\n\n\ndef _render_frames(frames, positions, render_order, grid_h, grid_w):\n    \"\"\"Render frame walls onto grid; return grid and set of visible frame pixel coords.\"\"\"\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    # Paint walls in render order (later overwrites earlier at overlaps)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        # Vectorized: find wall pixel offsets and stamp color\n        rs, cs = np.where(wall_arr)\n        grid[rs + r0, cs + c0] = color\n\n    # Compute visible frame pixels (where grid still shows that frame's color)\n    frame_mask = np.zeros((grid_h, grid_w), dtype=bool)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        rs, cs = np.where(wall_arr)\n        abs_rs, abs_cs = rs + r0, cs + c0\n        visible = grid[abs_rs, abs_cs] == color\n        frame_mask[abs_rs[visible], abs_cs[visible]] = True\n\n    return grid, frame_mask\n\n\ndef _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w):\n    \"\"\"Place noise pixels on non-wall cells and damage some wall cells.\"\"\"\n    total_cells = grid_h * grid_w\n    noise_fraction = random.uniform(*_NOISE_FRACTION_RANGE)\n    noise_count = int(total_cells * noise_fraction)\n\n    # Non-wall positions\n    nonwall_rs, nonwall_cs = np.where(~frame_mask)\n    perm = np.random.permutation(len(nonwall_rs))\n    n_nonwall = min(noise_count, len(perm))\n    sel = perm[:n_nonwall]\n    grid[nonwall_rs[sel], nonwall_cs[sel]] = noise_color\n    placed = n_nonwall\n\n    # Wall damage (up to _WALL_DAMAGE_FRACTION of wall pixels)\n    wall_rs, wall_cs = np.where(frame_mask)\n    n_wall = len(wall_rs)\n    max_damage = min(noise_count - placed, int(_WALL_DAMAGE_FRACTION * n_wall))\n    if max_damage > 0:\n        damage_perm = np.random.permutation(n_wall)[:max_damage]\n        grid[wall_rs[damage_perm], wall_cs[damage_perm]] = noise_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid puzzle grid.\"\"\"\n    frame_count = random.randint(*_FRAME_COUNT_RANGE)\n\n    # --- Room count assignment ---\n    available = list(range(_ROOM_COUNT_RANGE[0], _ROOM_COUNT_RANGE[1] + 1))\n    allow_tie = random.random() < _TIE_PROBABILITY and frame_count >= 3\n    if allow_tie:\n        distinct_needed = frame_count - 1\n        chosen = random.sample(available, min(distinct_needed, len(available)))\n        if len(chosen) < distinct_needed:\n            return None\n        room_counts = chosen + [random.choice(chosen)]\n    else:\n        if frame_count > len(available):\n            return None\n        room_counts = random.sample(available, frame_count)\n    random.shuffle(room_counts)\n\n    # --- Color assignment ---\n    chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)\n    frame_colors = chosen_colors[:frame_count]\n    noise_color = chosen_colors[frame_count]\n\n    # --- Grid/frame size selection ---\n    cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])\n    h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg\n    grid_h = random.randint(h_min, h_max)\n    grid_w = random.randint(w_min, w_max)\n\n    # --- Build frames ---\n    frames = []\n    for color, target_rooms in zip(frame_colors, room_counts):\n        frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n        if frame_data is None:\n            return None\n        fh, fw = frame_data.shape\n        if fh > grid_h - 2 or fw > grid_w - 2:\n            return None\n        frames.append((color, target_rooms, frame_data))\n\n    # --- Place frames (largest first, random position) ---\n    positions = [None] * frame_count\n    for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):\n        fh, fw = frames[idx][2].shape\n        positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))\n\n    # --- Force overlaps for tied pairs ---\n    tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                  if room_counts[i] == room_counts[j]]\n    for i, j in tied_pairs:\n        _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Force some non-tied overlaps ---\n    non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                if room_counts[i] != room_counts[j]]\n    n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)\n    if n_extra > 0 and non_tied:\n        random.shuffle(non_tied)\n        for i, j in non_tied[:min(n_extra, len(non_tied))]:\n            _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Render and add noise ---\n    render_order = list(range(frame_count))\n    random.shuffle(render_order)\n\n    grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)\n    _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)\n\n    # --- Validate via solver oracle ---\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output: rows sorted by (room_count, render_order position)\n    frame_info = sorted(\n        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])\n    max_rooms = max(rc for rc, _, _ in frame_info)\n    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)\n    for r, (rc, _, color) in enumerate(frame_info):\n        expected[r, :rc] = color\n\n    return grid if np.array_equal(output, expected) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n==== /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch() -> np.ndarray:\n    \"\"\"Grey frame with top/bottom/right walls closed and a 2-cell gap in the left wall.\"\"\"\n    patch = np.zeros((FRAME_H, FRAME_W), dtype=int)\n    patch[[0, -1], :] = GREY                       # top and bottom rows\n    patch[:, -1] = GREY                            # right wall\n    patch[:, 0] = GREY                             # left wall (solid...)\n    patch[list(LEFT_WALL_OPEN_ROWS), 0] = BG       # ...with the opening carved out\n    return patch\n\n\ndef _bar_patch(heights: list[int]) -> np.ndarray:\n    \"\"\"Horizontal bar base with 4 upward grey projections at local cols {0,2,4,6}.\"\"\"\n    patch = np.zeros((BAR_H, BAR_W), dtype=int)\n    patch[-1, :] = GREY                            # full base row\n    for local_c, height in zip(BAR_LOCAL_PROJ_COLS, heights):\n        patch[BAR_H - height : BAR_H, local_c] = GREY\n    return patch\n\n\ndef _paint_slot_column(grid: np.ndarray, col: int, length: int, color: int,\n                       count: int, height: int | None) -> None:\n    \"\"\"Paint one slot column.\n\n    Input mode (height=None): top (length-count) cells grey caps, bottom `count` cells the color.\n    Output mode (height given): grey cap then up to (5-height) visible colored cells flush to top.\n    \"\"\"\n    cap = length - count\n    grid[SLOT_TOP_ROW : SLOT_TOP_ROW + cap, col] = GREY\n    if height is None:\n        grid[SLOT_TOP_ROW + cap : SLOT_TOP_ROW + length, col] = color\n        return\n    visible = min(count, BAR_BASE_ABS_ROW - height)  # = min(count, 5 - height)\n    if visible > 0:\n        row_end = BAR_BASE_ABS_ROW - height          # inclusive last colored row\n        grid[row_end - visible + 1 : row_end + 1, col] = color\n\n\ndef _build_grid(heights: list[int], colors: list[int], colored_counts: list[int],\n                bar_c0: int, output_mode: bool) -> np.ndarray:\n    grid = np.zeros((H, W), dtype=int)\n    paste(grid, _frame_patch(), FRAME_R0, FRAME_C0)\n    paste(grid, _bar_patch(heights), BAR_R0, bar_c0)\n    for col, length, color, count, height in zip(SLOT_COLS, SLOT_LENS, colors, colored_counts, heights):\n        _paint_slot_column(grid, col, length, color, count, height if output_mode else None)\n    return grid\n\n\ndef _sample_params(rng: np.random.Generator) -> tuple[list[int], list[int], list[int]]:\n    colors = [int(v) for v in rng.choice(PALETTE, size=len(SLOT_COLS), replace=False)]\n    colored_counts = [int(rng.integers(1, L + 1)) for L in SLOT_LENS]\n    heights = [int(rng.integers(*HEIGHT0_RANGE))]\n    heights.extend(int(rng.integers(*HEIGHT_REST_RANGE)) for _ in range(len(SLOT_COLS) - 1))\n    return heights, colors, colored_counts\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    heights, colors, colored_counts = _sample_params(rng)\n    grid = _build_grid(heights, colors, colored_counts, BAR_INPUT_C0, output_mode=False)\n    expected = _build_grid(heights, colors, colored_counts, BAR_OUTPUT_C0, output_mode=True)\n\n    if get_bg(grid) != BG:\n        return None\n    if sorted(colors_present(grid, exclude=[BG, GREY])) != sorted(colors):\n        return None\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input failed after {MAX_ATTEMPTS} attempts\")\n==== /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n        c_lo = min(pc1, pc2) + n\n        c_hi = max(pc1, pc2)\n        if c_hi <= c_lo:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        c_mid = (c_lo + c_hi) // 2\n        c_start = max(c_lo, c_mid - total_len // 2)\n        for step in range(total_len):\n            c = c_start + step\n            if c < 0 or c >= W:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\n                if 0 <= rr < H and 0 <= c < W:\n                    grid[rr, c] = _BG\n    else:\n        r_lo = min(pr1, pr2) + n\n        r_hi = max(pr1, pr2)\n        if r_hi <= r_lo:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\n        if hold_len < 1:\n            hold_len = 1\n        total_len = 2 * remove + hold_len\n        r_mid = (r_lo + r_hi) // 2\n        r_start = max(r_lo, r_mid - total_len // 2)\n        for step in range(total_len):\n            r = r_start + step\n            if r < 0 or r >= H:\n                continue\n            if step < remove:\n                depth = step + 1\n            elif step >= total_len - remove:\n                depth = total_len - step\n            else:\n                depth = remove\n            for k in range(depth):\n                cc = pc1 + k if side == 0 else pc1 + n - 1 - k\n                if 0 <= r < H and 0 <= cc < W:\n                    grid[r, cc] = _BG\n\n\ndef _river_connected(grid):\n    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    if not mask.any():\n        return False\n    labeled, num = scipy_label(mask.astype(int))\n    return num == 1\n\n\ndef _compute_offsets(G, n, num_coarse):\n    if num_coarse == 1:\n        return [1]\n    first = 1\n    last = G - n - 1\n    if last < first:\n        return None\n    step = (last - first) / (num_coarse - 1)\n    return [int(round(first + i * step)) for i in range(num_coarse)]\n\n\ndef _gen_attempt():\n    reached = random.random() < 0.5\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\n\n    min_size = max(10, 5 * n)\n    if min_size > 20:\n        return None\n    G = random.randint(min_size, 20)\n    H = W = G\n\n    min_spacing = n + 1\n    max_coarse = max(3, (G - 2) // min_spacing)\n    coarse_dim = random.randint(3, min(6, max_coarse))\n    coarse_rows = coarse_cols = coarse_dim\n\n    offsets_r = _compute_offsets(G, n, coarse_rows)\n    offsets_c = _compute_offsets(G, n, coarse_cols)\n    if offsets_r is None or offsets_c is None:\n        return None\n    for i in range(len(offsets_r) - 1):\n        if offsets_r[i + 1] - offsets_r[i] < n:\n            return None\n    for i in range(len(offsets_c) - 1):\n        if offsets_c[i + 1] - offsets_c[i] < n:\n            return None\n\n    edge_cells = set()\n    for c in range(coarse_cols):\n        edge_cells.add((0, c))\n        edge_cells.add((coarse_rows - 1, c))\n    for r in range(1, coarse_rows - 1):\n        edge_cells.add((r, 0))\n        edge_cells.add((r, coarse_cols - 1))\n    edge_cells = list(edge_cells)\n    random.shuffle(edge_cells)\n    start_coarse = edge_cells[0]\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\n\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\n    if walk is None or len(walk) < 4:\n        return None\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\n        return None\n\n    grid = np.full((H, W), _BG, dtype=int)\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\n\n    mask = (grid != _BG)\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\n        return None\n\n    mover_r, mover_c = pixel_pos[0]\n    dest_r, dest_c = pixel_pos[-1]\n\n    # Extend dest to touch grid edge\n    def _extend_to_edge(pr, pc):\n        candidates = []\n        for direction in ['top', 'bottom', 'left', 'right']:\n            if direction == 'top':\n                dist = pr\n                if dist == 0:\n                    candidates.append((0, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\n                    candidates.append((0, pc, dist))\n            elif direction == 'bottom':\n                dist = H - (pr + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\n                    candidates.append((H - n, pc, dist))\n            elif direction == 'left':\n                dist = pc\n                if dist == 0:\n                    candidates.append((pr, 0, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\n                    candidates.append((pr, 0, dist))\n            elif direction == 'right':\n                dist = W - (pc + n)\n                if dist == 0:\n                    candidates.append((pr, pc, 0))\n                    continue\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\n                    candidates.append((pr, W - n, dist))\n        if not candidates:\n            return None\n        candidates.sort(key=lambda x: x[2])\n        return candidates[0][:2]\n\n    result = _extend_to_edge(dest_r, dest_c)\n    if result is None:\n        return None\n    new_dest_r, new_dest_c = result\n    if new_dest_r != dest_r:\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\n    if new_dest_c != dest_c:\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\n    dest_r, dest_c = new_dest_r, new_dest_c\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\n        return None\n\n    # Mover: near edge but not touching\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\n    if touching:\n        if mover_r == 0:\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\n        elif mover_r + n == H:\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\n        elif mover_c == 0:\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\n        elif mover_c + n == W:\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\n        return None\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\n        return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\n\n    # Chokepoints for stuck case\n    if not reached and n >= 2:\n        num_choke = random.randint(1, min(3, len(walk) - 2))\n        min_seg = max(1, len(walk) // 4)\n        available = list(range(min_seg, len(walk) - 1))\n        random.shuffle(available)\n        for seg_idx in available[:num_choke]:\n            pr1, pc1 = pixel_pos[seg_idx]\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\n            direction = 'h' if pr1 == pr2 else 'v'\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\n        if not _river_connected(grid):\n            return None\n\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\n\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\n    h2, w2 = H - n + 1, W - n + 1\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if trav[r:r + n, c:c + n].all():\n                feasible[r, c] = True\n    if not feasible[mover_r, mover_c]:\n        return None\n\n    dist = _bfs_placement(feasible, mover_r, mover_c)\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\n    if reached and not dest_ok:\n        return None\n    if not reached and dest_ok:\n        return None\n\n    if dest_ok:\n        tr, tc = dest_r, dest_c\n    else:\n        best_d = -1\n        tr, tc = mover_r, mover_c\n        for r in range(h2):\n            for c in range(w2):\n                if dist[r, c] > best_d:\n                    best_d = dist[r, c]\n                    tr, tc = r, c\n\n    output = grid.copy()\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\n    output[tr:tr + n, tc:tc + n] = _MOVER\n\n    if not np.array_equal(main(grid), output):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n==== /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n\n    Input structure:\n    - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n    - Several smaller colored sprites scattered around the bar.\n\n    Rule:\n    - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n    - The root defines a strip (column-span or row-span) for its chain.\n    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n    - Multiple chains grow independently from different bar notches.\n\n    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    bg = get_bg(g)\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    comps.sort(key=lambda d: -d[\"area\"])\n    assert comps\n\n    bar = comps[0]\n    pieces_raw = comps[1:]\n\n    out = np.full((H, W), int(bg), dtype=int)\n    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_color = int(bar[\"color\"])\n    bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_occ:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for r, c in bar_occ:\n        out[r, c] = bar_color\n\n    def shape_from_coords(coords: np.ndarray, bbox):\n        r0, c0, r1, c1 = map(int, bbox)\n        h, w = r1 - r0 + 1, c1 - c0 + 1\n        rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n        rel_set = set(rel)\n        return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n\n    pieces = []\n    for p in pieces_raw:\n        # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n        r0, c0 = map(int, p[\"bbox\"][:2])\n        pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n\n    def bar_notches(bar_mask, bar_r0, bar_c0):\n        empty = ~bar_mask\n        h, w = map(int, empty.shape)\n        notches = []\n        for pts in components_mask(empty, connectivity=4):\n            r = pts[:, 0]\n            c = pts[:, 1]\n            top = int((r == 0).sum())\n            bottom = int((r == h - 1).sum())\n            left = int((c == 0).sum())\n            right = int((c == w - 1).sum())\n\n            # Keep only holes that open to the bar bbox boundary.\n            if top + bottom + left + right == 0:\n                continue\n\n            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n\n            # Axis is determined by which bbox side has the widest mouth.\n            side, mouth_n = max(\n                [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n                key=lambda x: x[1],\n            )\n            axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n            notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n        return notches\n\n    notches = bar_notches(bar_mask, bar_r0, bar_c0)\n\n    def pixels(v, top, left):\n        return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n\n    def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n        if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n            return None\n        if strip is not None:\n            axis, A, B = strip\n            if axis == \"cols\":\n                if left != A or v[\"w\"] != B - A + 1:\n                    return None\n            else:\n                if top != A or v[\"h\"] != B - A + 1:\n                    return None\n        pts = pixels(v, top, left)\n        if pts & occ:\n            return None\n        if must_cover is not None and not (must_cover <= pts):\n            return None\n        return pts\n\n    def aligned_positions(axis, A, cover, v):\n        if axis == \"cols\":\n            left = A\n            tops = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if cN == left + lc:\n                        tops.add(rN - lr)\n            for top in tops:\n                yield top, left\n        else:\n            top = A\n            lefts = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if rN == top + lr:\n                        lefts.add(cN - lc)\n            for left in lefts:\n                yield top, left\n\n    def touches(pts, other):\n        for r, c in pts:\n            for dr, dc in DIR4:\n                if (r + dr, c + dc) in other:\n                    return True\n        return False\n\n    def hole_positions(hole, v):\n        pos = set()\n        for rH, cH in hole:\n            for lr, lc in v[\"rel\"]:\n                pos.add((rH - lr, cH - lc))\n        return pos\n\n    # Root candidates: fill the bar hole (no strip constraint yet).\n    root_cands = []\n    for ni, n in enumerate(notches):\n        axis = n[\"axis\"]\n\n        for pi, p in enumerate(pieces):\n            v = p[\"shape\"]\n            for top, left in hole_positions(n[\"hole\"], v):\n                pts = placement_pts(v, top, left, bar_occ, must_cover=n[\"hole\"])\n                if pts is None:\n                    continue\n                if axis == \"cols\":\n                    A, B = int(left), int(left + v[\"w\"] - 1)\n                else:\n                    A, B = int(top), int(top + v[\"h\"] - 1)\n                mv = abs(int(top) - int(p[\"orig\"][0])) + abs(int(left) - int(p[\"orig\"][1]))\n                root_cands.append(\n                    (\n                        (int(mv), -int(n[\"mouth_n\"])),\n                        {\"ni\": ni, \"pi\": pi, \"top\": int(top), \"left\": int(left), \"axis\": axis, \"A\": A, \"B\": B, \"shape\": v},\n                    )\n                )\n\n    root_cands.sort(key=lambda x: x[0])\n    cand_roots = [pair[1] for pair in root_cands[:20]]\n\n    best_out = out.copy()\n    best_key = None\n\n    def search(out_grid, occ_set, chains, remaining):\n        nonlocal best_out, best_key\n        placed_cnt = len(pieces) - len(remaining)\n        key = (placed_cnt, -len(remaining), -len(occ_set))\n        if best_key is None or key > best_key:\n            best_key = key\n            best_out = out_grid.copy()\n        if not remaining:\n            return True\n\n        def gen_extend_moves(chain, remaining_set):\n            axis = chain[\"axis\"]\n            A, B = int(chain[\"A\"]), int(chain[\"B\"])\n            head = chain[\"head\"]\n            head_pts = pixels(head[\"shape\"], head[\"top\"], head[\"left\"])\n            head_top, head_left = int(head[\"top\"]), int(head[\"left\"])\n            head_h, head_w = int(head[\"shape\"][\"h\"]), int(head[\"shape\"][\"w\"])\n\n            cavity = {\n                (r, c)\n                for r in range(head_top, head_top + head_h)\n                for c in range(head_left, head_left + head_w)\n                if out_grid[r, c] == bg\n            }\n            if not cavity:\n                return []\n\n            moves = []\n            for pi in remaining_set:\n                v = pieces[pi][\"shape\"]\n                for top, left in aligned_positions(axis, A, cavity, v):\n                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))\n                    if pts is None:\n                        continue\n                    if not touches(pts, head_pts):\n                        continue\n                    moves.append((pi, top, left, pts, v))\n            return moves\n\n        # Try extending any chain.\n        for ch in chains:\n            moves = gen_extend_moves(ch, remaining)\n            if not moves:\n                continue\n            # small branching factor is enough for this puzzle\n            for pi, top, left, pts, v in moves[:8]:\n                # apply\n                for r, c in pts:\n                    out_grid[r, c] = int(pieces[pi][\"color\"])\n                old_head = ch[\"head\"]\n                ch[\"head\"] = {\"top\": int(top), \"left\": int(left), \"shape\": v}\n                occ2 = set(occ_set) | set(pts)\n                rem2 = set(remaining)\n                rem2.remove(pi)\n                if search(out_grid, occ2, chains, rem2):\n                    return True\n                # undo\n                ch[\"head\"] = old_head\n                for r, c in pts:\n                    out_grid[r, c] = int(bg)\n                # restore bar pixels (roots are always non-overlapping)\n                for r, c in bar_occ:\n                    out_grid[r, c] = bar_color\n        return False\n\n    # Try small root subsets (1..3) from top candidates.\n    from itertools import combinations\n\n    for k in range(1, min(3, len(cand_roots)) + 1):\n        for roots_sel in combinations(range(len(cand_roots)), k):\n            used_p = set()\n            used_n = set()\n            occ0 = set(bar_occ)\n            out0 = np.full((H, W), int(bg), dtype=int)\n            for r, c in bar_occ:\n                out0[r, c] = bar_color\n\n            chains = []\n            ok = True\n            for idx in roots_sel:\n                root = cand_roots[idx]\n                if root[\"pi\"] in used_p or root[\"ni\"] in used_n:\n                    ok = False\n                    break\n                pts = pixels(root[\"shape\"], root[\"top\"], root[\"left\"])\n                if pts & occ0:\n                    ok = False\n                    break\n                used_p.add(root[\"pi\"])\n                used_n.add(root[\"ni\"])\n                for r, c in pts:\n                    out0[r, c] = int(pieces[root[\"pi\"]][\"color\"])\n                occ0 |= pts\n                chains.append({\"axis\": root[\"axis\"], \"A\": root[\"A\"], \"B\": root[\"B\"], \"head\": {\"top\": root[\"top\"], \"left\": root[\"left\"], \"shape\": root[\"shape\"]}})\n\n            if not ok:\n                continue\n            remaining = set(range(len(pieces))) - used_p\n            search(out0, occ0, chains, remaining)\n\n    return best_out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\ndef _connected(cells):\n    \"\"\"Check 4-connectivity of a cell set.\"\"\"\n    if len(cells) <= 1:\n        return True\n    cells_set = set(cells)\n    start = next(iter(cells_set))\n    visited = {start}\n    stack = [start]\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nb = (r + dr, c + dc)\n            if nb in cells_set and nb not in visited:\n                visited.add(nb)\n                stack.append(nb)\n    return len(visited) == len(cells_set)\n\n\ndef _grow_connected(rng, available, target, seeds, must_span_axis=None, span_range=None, retries=3):\n    \"\"\"Grow a 4-connected shape of exactly *target* cells within *available*, starting from *seeds*.\n\n    *must_span_axis* (\"cols\"/\"rows\") + *span_range* (A, B) enforce that the\n    resulting shape spans from A to B along that axis.\n    \"\"\"\n    _D4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    for _ in range(retries):\n        cells = set(seeds)\n        if not cells.issubset(available):\n            return None\n        for __ in range(target * 20):\n            if len(cells) >= target:\n                break\n            frontier = [nb for r, c in cells for dr, dc in _D4\n                        if (nb := (r + dr, c + dc)) in available and nb not in cells]\n            if not frontier:\n                break\n            # Prioritise filling span gaps\n            if must_span_axis and span_range:\n                A, B = span_range\n                if must_span_axis == \"cols\":\n                    cm, cx = min((c for _, c in cells), default=B), max((c for _, c in cells), default=A)\n                    if cm > A:\n                        p = [nb for nb in frontier if nb[1] < cm]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n                    if cx < B:\n                        p = [nb for nb in frontier if nb[1] > cx]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n                else:\n                    cm, cx = min((r for r, _ in cells), default=B), max((r for r, _ in cells), default=A)\n                    if cm > A:\n                        p = [nb for nb in frontier if nb[0] < cm]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n                    if cx < B:\n                        p = [nb for nb in frontier if nb[0] > cx]\n                        if p:\n                            cells.add(rng.choice(p)); continue\n            cells.add(rng.choice(frontier))\n        if len(cells) < target:\n            continue\n        # Trim to target while preserving seeds, span, and connectivity\n        while len(cells) > target:\n            removable = []\n            for rc in cells:\n                if rc in seeds:\n                    continue\n                if must_span_axis and span_range:\n                    A, B = span_range\n                    if must_span_axis == \"cols\":\n                        if rc[1] == A and sum(1 for _, c2 in cells if c2 == A) <= 1:\n                            continue\n                        if rc[1] == B and sum(1 for _, c2 in cells if c2 == B) <= 1:\n                            continue\n                    else:\n                        if rc[0] == A and sum(1 for r2, _ in cells if r2 == A) <= 1:\n                            continue\n                        if rc[0] == B and sum(1 for r2, _ in cells if r2 == B) <= 1:\n                            continue\n                if _connected(cells - {rc}):\n                    removable.append(rc)\n            if not removable:\n                break\n            cells.remove(rng.choice(removable))\n        if len(cells) != target:\n            continue\n        if must_span_axis and span_range:\n            A, B = span_range\n            if must_span_axis == \"cols\":\n                if min(c for _, c in cells) != A or max(c for _, c in cells) != B:\n                    continue\n            else:\n                if min(r for r, _ in cells) != A or max(r for r, _ in cells) != B:\n                    continue\n        if _connected(cells):\n            return cells\n    return None\n\n\ndef _gen_attempt():\n    \"\"\"Build one (input, output) pair; returns (input, output) or None.\"\"\"\n    import random as _random\n    rng = _random.Random()\n    H, W = 30, 30\n    bg = 0\n\n    # ---- bar ----------------------------------------------------------\n    orientation = rng.choice([\"horizontal\", \"vertical\"])\n    bar_color = rng.randint(1, 9)\n    thickness = rng.randint(5, 7)\n\n    if orientation == \"horizontal\":\n        center = int(rng.uniform(0.35, 0.53) * H)\n        bar_r0 = max(0, center - thickness // 2)\n        bar_r1 = bar_r0 + thickness - 1\n        if bar_r1 >= H:\n            bar_r1 = H - 1; bar_r0 = bar_r1 - thickness + 1\n        bar_c0, bar_c1 = 0, W - 1\n        space_before, space_after = bar_r0, H - 1 - bar_r1\n    else:\n        center = int(rng.uniform(0.35, 0.53) * W)\n        bar_c0 = max(0, center - thickness // 2)\n        bar_c1 = bar_c0 + thickness - 1\n        if bar_c1 >= W:\n            bar_c1 = W - 1; bar_c0 = bar_c1 - thickness + 1\n        bar_r0, bar_r1 = 0, H - 1\n        space_before, space_after = bar_c0, W - 1 - bar_c1\n\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_cells = set((r, c) for r in range(bar_r0, bar_r1 + 1)\n                    for c in range(bar_c0, bar_c1 + 1))\n\n    # ---- plan chains --------------------------------------------------\n    num_chains = rng.randint(1, 2)\n    chain_lens = [3] if num_chains == 1 else [rng.randint(2, 3) for _ in range(2)]\n    if num_chains == 2:\n        while not (3 <= sum(chain_lens) <= 6):\n            chain_lens = [rng.randint(2, 3) for _ in range(2)]\n\n    avail_colors = [c for c in range(1, 10) if c != bar_color]\n    rng.shuffle(avail_colors)\n    color_idx = 0\n\n    all_chain_pieces = []\n    notch_holes: list[set] = []\n    occ_set = set(bar_cells)\n\n    for chain_idx in range(num_chains):\n        chain_len = chain_lens[chain_idx]\n        strip_width = rng.randint(4, 5)\n\n        # pick side with enough room\n        if orientation == \"horizontal\":\n            sides = [\"top\", \"bottom\"]; rng.shuffle(sides)\n            side = next((s for s in sides\n                         if (space_before if s == \"top\" else space_after) >= chain_len * 2 + 3), None)\n            if side is None:\n                return None\n            sc0 = rng.randint(1, W - strip_width - 1); sc1 = sc0 + strip_width - 1\n            sA, sB = sc0, sc1\n        else:\n            sides = [\"left\", \"right\"]; rng.shuffle(sides)\n            side = next((s for s in sides\n                         if (space_before if s == \"left\" else space_after) >= chain_len * 2 + 3), None)\n            if side is None:\n                return None\n            sr0 = rng.randint(1, H - strip_width - 1); sr1 = sr0 + strip_width - 1\n            sA, sB = sr0, sr1\n\n        # ---- notch (hole carved in bar) ----\n        notch_depth = rng.randint(1, 2)\n        notch_area = rng.randint(1, min(4, notch_depth * strip_width))\n\n        if orientation == \"horizontal\":\n            nr0 = bar_r0 if side == \"top\" else bar_r1 - notch_depth + 1\n            nr1 = bar_r0 + notch_depth - 1 if side == \"top\" else bar_r1\n            n_avail = {(r, c) for r in range(nr0, nr1 + 1)\n                       for c in range(sc0, sc1 + 1) if (r, c) in bar_cells}\n        else:\n            nc0 = bar_c0 if side == \"left\" else bar_c1 - notch_depth + 1\n            nc1 = bar_c0 + notch_depth - 1 if side == \"left\" else bar_c1\n            n_avail = {(r, c) for r in range(sA, sB + 1)\n                       for c in range(nc0, nc1 + 1) if (r, c) in bar_cells}\n\n        # keep away from existing notch holes\n        all_holes = set().union(*notch_holes) if notch_holes else set()\n        n_avail -= all_holes | {(r + dr, c + dc)\n                                for r, c in all_holes for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}\n        if len(n_avail) < notch_area:\n            return None\n\n        notch = _grow_connected(rng, n_avail, notch_area, {rng.choice(list(n_avail))})\n        if notch is None:\n            return None\n        bar_cells -= notch\n        notch_holes.append(notch)\n\n        # ---- chain pieces ----\n        chain_pieces = []\n        for piece_idx in range(chain_len):\n            if color_idx >= len(avail_colors):\n                return None\n            piece_color = avail_colors[color_idx]; color_idx += 1\n            piece_area = rng.randint(8, 13)\n            chain_dim = rng.randint(2, 3)\n\n            if piece_idx == 0:\n                # ROOT: fill notch + extend outside bar\n                if orientation == \"horizontal\":\n                    if side == \"top\":\n                        pr0, pr1 = max(0, bar_r0 - chain_dim), max(r for r, _ in notch)\n                    else:\n                        pr0, pr1 = min(r for r, _ in notch), min(H - 1, bar_r1 + chain_dim)\n                    pc0, pc1 = sc0, sc1\n                else:\n                    if side == \"left\":\n                        pc0, pc1 = max(0, bar_c0 - chain_dim), max(c for _, c in notch)\n                    else:\n                        pc0, pc1 = min(c for _, c in notch), min(W - 1, bar_c1 + chain_dim)\n                    pr0, pr1 = sA, sB\n\n                bbox_area = (pr1 - pr0 + 1) * (pc1 - pc0 + 1)\n                target = max(max(8, int(bbox_area * 0.54)),\n                             min(piece_area, int(bbox_area * 0.80)))\n                if target > bbox_area or target < 8:\n                    return None\n\n                avail = {(r, c) for r in range(pr0, pr1 + 1) for c in range(pc0, pc1 + 1)\n                         if (r, c) in notch or (r, c) not in occ_set}\n                root = _grow_connected(rng, avail, target, notch,\n                                       must_span_axis=\"cols\" if orientation == \"horizontal\" else \"rows\",\n                                       span_range=(sA, sB), retries=5)\n                if root is None:\n                    return None\n                if not any(not (bar_r0 <= r <= bar_r1 and bar_c0 <= c <= bar_c1) for r, c in root):\n                    return None\n                piece_cells = root\n            else:\n                # CONTINUATION: fill cavity in prev bbox + extend further from bar\n                prev_coords = chain_pieces[-1][\"coords\"]\n                prs = [r for r, _ in prev_coords]; pcs = [c for _, c in prev_coords]\n                prev_r0, prev_r1 = min(prs), max(prs)\n                prev_c0, prev_c1 = min(pcs), max(pcs)\n\n                if orientation == \"horizontal\":\n                    cavity = {(r, c) for r in range(prev_r0, prev_r1 + 1)\n                              for c in range(sc0, sc1 + 1)\n                              if (r, c) not in occ_set and (r, c) not in prev_coords}\n                else:\n                    cavity = {(r, c) for r in range(sA, sB + 1)\n                              for c in range(prev_c0, prev_c1 + 1)\n                              if (r, c) not in occ_set and (r, c) not in prev_coords}\n                if not cavity:\n                    return None\n\n                if orientation == \"horizontal\":\n                    es = (max(0, prev_r0 - chain_dim), prev_r0 - 1) if side == \"top\" \\\n                        else (prev_r1 + 1, min(H - 1, prev_r1 + chain_dim))\n                    ext = {(r, c) for r in range(es[0], es[1] + 1)\n                           for c in range(sc0, sc1 + 1)\n                           if (r, c) not in occ_set} if es[0] <= es[1] else set()\n                else:\n                    es = (max(0, prev_c0 - chain_dim), prev_c0 - 1) if side == \"left\" \\\n                        else (prev_c1 + 1, min(W - 1, prev_c1 + chain_dim))\n                    ext = {(r, c) for r in range(sA, sB + 1)\n                           for c in range(es[0], es[1] + 1)\n                           if (r, c) not in occ_set} if es[0] <= es[1] else set()\n\n                all_avail = cavity | ext\n                target = min(13, max(len(cavity), min(piece_area, len(all_avail))))\n                if len(cavity) > 13 or target < 8:\n                    return None\n\n                # Tail piece must leave zero cavity in its bbox within strip\n                is_tail = (piece_idx == chain_len - 1)\n                if is_tail:\n                    target = min(13, len(all_avail))\n\n                piece_cells = _grow_connected(rng, all_avail, target, cavity,\n                                              must_span_axis=\"cols\" if orientation == \"horizontal\" else \"rows\",\n                                              span_range=(sA, sB), retries=5)\n                if piece_cells is None or not cavity.issubset(piece_cells):\n                    return None\n\n                if is_tail:\n                    prs2 = [r for r, _ in piece_cells]; pcs2 = [c for _, c in piece_cells]\n                    t_r0, t_r1 = min(prs2), max(prs2)\n                    t_c0, t_c1 = min(pcs2), max(pcs2)\n                    if orientation == \"horizontal\":\n                        remaining = {(r, c) for r in range(t_r0, t_r1 + 1) for c in range(sc0, sc1 + 1)\n                                     if (r, c) not in occ_set and (r, c) not in piece_cells}\n                    else:\n                        remaining = {(r, c) for r in range(sA, sB + 1) for c in range(t_c0, t_c1 + 1)\n                                     if (r, c) not in occ_set and (r, c) not in piece_cells}\n                    if remaining:\n                        return None\n\n            if not (8 <= len(piece_cells) <= 13):\n                return None\n            chain_pieces.append({\"color\": piece_color, \"coords\": piece_cells})\n            occ_set |= piece_cells\n\n        if len(chain_pieces) < chain_len:\n            return None\n        all_chain_pieces.extend(chain_pieces)\n\n    if not (3 <= len(all_chain_pieces) <= 6):\n        return None\n\n    # ---- decoy notches (4-7) ------------------------------------------\n    num_decoys = rng.randint(4, 7)\n    decoys = 0\n    for _ in range(500):\n        if decoys >= num_decoys:\n            break\n        depth = rng.randint(1, 2)\n        area = rng.randint(1, min(6, depth * 5))\n        if orientation == \"horizontal\":\n            ds = rng.choice([\"top\", \"bottom\"])\n            dr0 = bar_r0 if ds == \"top\" else bar_r1 - depth + 1\n            dr1 = bar_r0 + depth - 1 if ds == \"top\" else bar_r1\n            dc0 = rng.randint(bar_c0, bar_c1)\n            dc1 = min(bar_c1, dc0 + rng.randint(0, 4))\n        else:\n            ds = rng.choice([\"left\", \"right\"])\n            dc0 = bar_c0 if ds == \"left\" else bar_c1 - depth + 1\n            dc1 = bar_c0 + depth - 1 if ds == \"left\" else bar_c1\n            dr0 = rng.randint(bar_r0, bar_r1)\n            dr1 = min(bar_r1, dr0 + rng.randint(0, 4))\n\n        d_avail = {(r, c) for r in range(dr0, dr1 + 1) for c in range(dc0, dc1 + 1)\n                   if (r, c) in bar_cells}\n        all_h = set().union(*notch_holes) if notch_holes else set()\n        d_avail -= all_h | {(r + dr, c + dc) for r, c in all_h for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}\n        if len(d_avail) < 1:\n            continue\n        area = min(area, len(d_avail))\n        dn = _grow_connected(rng, d_avail, area, {rng.choice(list(d_avail))})\n        if dn is None:\n            continue\n        if not _connected(bar_cells - dn):\n            continue\n        bar_cells -= dn\n        notch_holes.append(dn)\n        decoys += 1\n    if decoys < 4:\n        return None\n\n    # verify no internal holes in bar bbox\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_cells:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for pts in components_mask(~bar_mask, connectivity=4):\n        rr, cc = pts[:, 0], pts[:, 1]\n        if not ((rr == 0).any() or (rr == bar_h - 1).any()\n                or (cc == 0).any() or (cc == bar_w - 1).any()):\n            return None\n\n    # ---- assemble output ----------------------------------------------\n    output = np.full((H, W), bg, dtype=int)\n    for r, c in bar_cells:\n        output[r, c] = bar_color\n    for p in all_chain_pieces:\n        for r, c in p[\"coords\"]:\n            output[r, c] = p[\"color\"]\n\n    # ---- scatter pieces for input -------------------------------------\n    input_grid = np.full((H, W), bg, dtype=int)\n    for r, c in bar_cells:\n        input_grid[r, c] = bar_color\n\n    placed_occ = set(bar_cells)\n    pieces_order = list(all_chain_pieces)\n    rng.shuffle(pieces_order)\n\n    for p in pieces_order:\n        coords = p[\"coords\"]; color = p[\"color\"]\n        rs = [r for r, _ in coords]; cs = [c for _, c in coords]\n        p_r0, p_c0 = min(rs), min(cs)\n        rel = [(r - p_r0, c - p_c0) for r, c in coords]\n        p_h, p_w = max(rs) - p_r0 + 1, max(cs) - p_c0 + 1\n\n        placed = False\n        for _ in range(500):\n            gap = rng.randint(2, 7)\n            if orientation == \"horizontal\":\n                top = (bar_r0 - gap - p_h) if rng.random() < 0.5 else (bar_r1 + gap + 1)\n                left = rng.randint(0, max(0, W - p_w))\n            else:\n                left = (bar_c0 - gap - p_w) if rng.random() < 0.5 else (bar_c1 + gap + 1)\n                top = rng.randint(0, max(0, H - p_h))\n            if top < 0 or top + p_h > H or left < 0 or left + p_w > W:\n                continue\n            pts = {(top + dr, left + dc) for dr, dc in rel}\n            if pts & placed_occ:\n                continue\n            if any((r + dr, c + dc) in placed_occ\n                   for r, c in pts for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]):\n                continue\n            for r, c in pts:\n                input_grid[r, c] = color\n            placed_occ |= pts\n            placed = True\n            break\n        if not placed:\n            return None\n\n    return input_grid, output\n\n\ndef generate_input():\n    \"\"\"Generate a valid input grid for task 16b78196 (max 300 retries).\"\"\"\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is None:\n            continue\n        inp, out = result\n        if np.array_equal(main(inp), out):\n            return inp\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n==== /home/lixinyu/snap/new/ARC_code/eval/36a08778.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.\n\n    Input structure:\n    - bg = most common color; water = rarest non-bg; shelf = other non-bg.\n    - Sources: water clusters touching top row. Shelves: horizontal segments.\n\n    Rule:\n    - Water falls down from sources, painting bg cells as water.\n    - On hitting a shelf, it spreads across the shelf span plus one cell past each end.\n    - From those overflow positions, water resumes falling independently.\n\n    Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(cnt.most_common(1)[0][0])\n    non = [int(c) for c in cnt.keys() if int(c) != int(bg)]\n    assert not (not non)\n    water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))\n    other = [int(c) for c in non if int(c) != int(water)]\n    assert not (not other)\n    shelf = int(other[0])\n\n    out = g.copy()\n\n    # sources: 8-connected components of water that touch the top edge; start from their bottommost row\n    sources: list[tuple[int, int]] = []\n    for coords in components_mask(g == int(water), connectivity=8):\n        if coords.size == 0:\n            continue\n        if not bool((coords[:, 0] == 0).any()):\n            continue\n        rmax = int(coords[:, 0].max())\n        cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})\n        for c in cols:\n            sources.append((int(rmax), int(c)))\n\n    # shelf segments (from original grid g)\n    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]\n    for r in range(H):\n        c = 0\n        while c < W:\n            if int(g[int(r), int(c)]) != int(shelf):\n                c += 1\n                continue\n            c0 = int(c)\n            while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):\n                c += 1\n            shelf_segs[int(r)].append((int(c0), int(c)))\n            c += 1\n\n    def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:\n        for a, b in shelf_segs[int(r)]:\n            if int(a) <= int(c) <= int(b):\n                return (int(a), int(b))\n        return None\n\n    def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:\n        \"\"\"\n        Expand horizontally only through contiguous bg cells on the current row.\n\n        This prevents water from \"jumping\" over blockers that sit on the spread row.\n        \"\"\"\n        left = int(start_col)\n        while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):\n            left -= 1\n\n        right = int(start_col)\n        while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):\n            right += 1\n\n        return (int(left), int(right))\n\n    seen: set[tuple[int, int]] = set()\n    q = deque((int(r), int(c)) for r, c in sources)\n\n    while q:\n        r, c = q.popleft()\n        if (int(r), int(c)) in seen:\n            continue\n        seen.add((int(r), int(c)))\n\n        rr, cc = int(r), int(c)\n        out[rr, cc] = int(water)\n\n        while True:\n            nr = int(rr + 1)\n            if nr >= H:\n                break\n            below = int(g[int(nr), int(cc)])\n\n            if below == int(shelf):\n                seg = find_shelf_seg(nr, cc)\n                if seg is None:\n                    break\n                a, b = seg\n                left_bound = int(max(0, int(a - 1)))\n                right_bound = int(min(int(W - 1), int(b + 1)))\n                left, right = spread_limits(rr, cc, left_bound, right_bound)\n                for x in range(left, right + 1):\n                    if int(g[int(rr), int(x)]) == int(bg):\n                        out[int(rr), int(x)] = int(water)\n                for nc in {left, right}:\n                    if int(nc) != int(cc):\n                        q.append((int(rr), int(nc)))\n                break\n\n            rr = nr\n            out[int(rr), int(cc)] = int(water)\n\n    return out\n\n# --------------- generator (cascade tree top-down construction) ---------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input for the waterfall cascade task.\"\"\"\n    BG, WATER, SHELF = 7, 6, 2\n\n    H = random.randint(8, 30)\n    W = random.randint(5, 30)\n\n    num_sources = random.choice([1, 2]) if W >= 14 else 1\n    if num_sources == 2:\n        src1 = random.randint(0, W - 8)\n        src2 = random.randint(src1 + 7, W - 1)\n        source_cols = [src1, src2]\n    else:\n        source_cols = [random.randint(0, W - 1)]\n\n    # Track cells reserved for shelf\n    shelf_cells: set[tuple[int, int]] = set()\n    # Cells that must remain bg (overflow positions, fall paths, source positions)\n    reserved_bg: set[tuple[int, int]] = set()\n\n    # Reserve source positions\n    for sc in source_cols:\n        reserved_bg.add((0, sc))\n        reserved_bg.add((1, sc))\n\n    all_shelves: list[tuple[int, int, int]] = []  # (row, a, b)\n\n    def try_add_shelf(r: int, a: int, b: int, is_cascade: bool = False) -> bool:\n        \"\"\"Try to add a shelf segment. Check no conflict with existing shelves or reserved bg cells.\"\"\"\n        cells = [(r, c) for c in range(a, b + 1)]\n        for cell in cells:\n            if cell in shelf_cells or cell in reserved_bg:\n                return False\n        for cell in cells:\n            shelf_cells.add(cell)\n        all_shelves.append((r, a, b))\n        return True\n\n    def reserve_overflow_and_fall(spread_row: int, left: int, right: int, incoming_col: int):\n        \"\"\"Reserve overflow positions and their fall paths as must-be-bg.\"\"\"\n        for nc in {left, right}:\n            if nc != incoming_col:\n                # The overflow position itself must be bg\n                reserved_bg.add((spread_row, nc))\n                # Fall path below must be bg until next shelf or grid bottom\n                # We'll just reserve the overflow position for now;\n                # fall path conflicts are handled by checking during shelf placement\n\n    max_depth = random.randint(2, 5)\n    if H < max_depth * 2 + 3:\n        max_depth = max(2, (H - 3) // 2)\n\n    # Build cascade tree top-down\n    # Each stream: (current_row, col, depth)\n    streams: list[tuple[int, int, int]] = [(1, sc, 0) for sc in source_cols]\n    cascade_shelves: list[tuple[int, int, int]] = []\n    processed = set()\n\n    while streams:\n        next_streams = []\n        random.shuffle(streams)\n        for (row, col, depth) in streams:\n            if (row, col) in processed:\n                continue\n            processed.add((row, col))\n\n            if depth >= max_depth or row + 2 >= H:\n                continue\n\n            min_shelf_row = row + 2\n            max_shelf_row = min(H - 1, row + 8)\n            if min_shelf_row > max_shelf_row:\n                continue\n\n            # Try a few times to place a shelf\n            placed = False\n            for _try in range(10):\n                shelf_row = random.randint(min_shelf_row, max_shelf_row)\n                spread_row = shelf_row - 1\n                if spread_row <= row:\n                    continue\n\n                # Check fall path from (row+1, col) to (shelf_row-1, col) is clear\n                blocked = False\n                for r_check in range(row + 1, shelf_row):\n                    if (r_check, col) in shelf_cells:\n                        blocked = True\n                        break\n                if blocked:\n                    continue\n\n                # Generate shelf segment containing col\n                shelf_len = random.randint(2, min(8, W))\n                max_start = col\n                min_start = max(0, col - shelf_len + 1)\n                if min_start > max_start:\n                    continue\n                a = random.randint(min_start, max_start)\n                b = min(a + shelf_len - 1, W - 1)\n\n                # Check shelf cells don't conflict\n                conflict = False\n                for c in range(a, b + 1):\n                    if (shelf_row, c) in shelf_cells or (shelf_row, c) in reserved_bg:\n                        conflict = True\n                        break\n                if conflict:\n                    continue\n\n                # Compute overflow positions\n                left = max(0, a - 1)\n                right = min(W - 1, b + 1)\n\n                # Check overflow positions on spread row are not shelf\n                overflow_ok = True\n                for nc in {left, right}:\n                    if nc != col:\n                        if (spread_row, nc) in shelf_cells:\n                            overflow_ok = False\n                            break\n                if not overflow_ok:\n                    continue\n\n                # Add the shelf\n                if not try_add_shelf(shelf_row, a, b, is_cascade=True):\n                    continue\n\n                cascade_shelves.append((shelf_row, a, b))\n\n                # Reserve overflow positions and fall path cells as bg\n                reserve_overflow_and_fall(spread_row, left, right, col)\n\n                # Reserve the fall path from current position to shelf\n                for r_res in range(row + 1, shelf_row):\n                    reserved_bg.add((r_res, col))\n\n                # Add new streams from overflow\n                for nc in {left, right}:\n                    if nc != col:\n                        next_streams.append((spread_row, nc, depth + 1))\n\n                placed = True\n                break\n\n            # If no shelf placed, stream just falls to bottom (that's ok)\n\n        streams = next_streams\n\n    if len(cascade_shelves) < 3:\n        return None\n\n    # Build the grid\n    grid = np.full((H, W), BG, dtype=int)\n\n    # Place sources\n    for sc in source_cols:\n        grid[0, sc] = WATER\n        grid[1, sc] = WATER\n\n    # Place all shelves\n    for (r, a, b) in all_shelves:\n        for c in range(a, b + 1):\n            grid[r, c] = SHELF\n\n    # Add 0-5 distractor shelves (carefully avoiding reserved_bg and shelf_cells)\n    num_distractors = random.randint(0, 5)\n    for _ in range(num_distractors):\n        for _attempt in range(20):\n            dr = random.randint(1, H - 1)\n            dl = random.randint(1, min(8, W))\n            da = random.randint(0, W - dl)\n            db = da + dl - 1\n            # Check no conflict with shelf_cells or reserved_bg\n            conflict = False\n            for c in range(da, db + 1):\n                if (dr, c) in shelf_cells or (dr, c) in reserved_bg:\n                    conflict = True\n                    break\n            if not conflict:\n                # Also check distractor doesn't intersect any active water fall path\n                # by ensuring it's not on a column where water falls through\n                if try_add_shelf(dr, da, db):\n                    for c in range(da, db + 1):\n                        grid[dr, c] = SHELF\n                    break\n\n    # Verify with solver\n    try:\n        out = main(grid.copy())\n    except Exception:\n        return None\n\n    if np.array_equal(out, grid):\n        return None\n\n    # Verify shelf cells are preserved in output\n    for (r, a, b) in all_shelves:\n        for c in range(a, b + 1):\n            if out[r, c] != SHELF:\n                return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n","exit_code":0,"status":"completed"}}
