{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/f931b4a8.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.\n\n    Input structure:\n    - The grid is an even square split into four equal quadrants.\n    - Black is the background.\n    - The upper-left and upper-right quadrants are control regions.\n    - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.\n\n    Rule:\n    - Output height is the number of non-background pixels in the upper-left quadrant.\n    - Output width is the number of non-background pixels in the upper-right quadrant.\n    - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.\n    - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.\n\n    Key insight:\n    - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h == w and h % 2 == 0 and w % 2 == 0\n\n    bg = int(Color.BLACK)\n    qh, qw = h // 2, w // 2\n    upper_left = g[:qh, :qw]\n    upper_right = g[:qh, qw:]\n    fill_tile = g[qh:, :qw]\n    stencil = g[qh:, qw:]\n\n    out_h = int(np.count_nonzero(upper_left != bg))\n    out_w = int(np.count_nonzero(upper_right != bg))\n    assert out_h > 0 and out_w > 0\n\n    out = np.empty((out_h, out_w), dtype=int)\n    if not np.any(stencil != bg):\n        for r in range(out_h):\n            for c in range(out_w):\n                value = int(fill_tile[r % qh, c % qw])\n                assert value != bg\n                out[r, c] = value\n        return out\n\n    for r in range(out_h):\n        for c in range(out_w):\n            value = int(stencil[r % qh, c % qw])\n            if value == bg:\n                fill_r = r // qh\n                fill_c = c // qw\n                assert fill_r < qh and fill_c < qw\n                value = int(fill_tile[fill_r, fill_c])\n                assert value != bg\n            out[r, c] = value\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom math import ceil\n\n# ── configuration constants ──────────────────────────────────────────\nBLACK = 0\nCOLORS = tuple(range(1, 10))\n\nGRID_SIZES = (4, 8, 16)                # allowed input grid side-lengths N\nSTENCIL_EMPTY_PROB = 0.16               # chance lower-right is all-black\nLL_SOLID_PROB = 0.70                    # chance fill tile is single-color\nLL_MULTI_COLOR_RANGE = (2, 3)           # color count when fill tile is multi-color\nSTENCIL_SINGLE_COLOR_PROB = 0.75        # chance stencil uses one fg color\nSTENCIL_MULTI_COLOR_RANGE = (2, 4)      # color count when stencil is multi-color\nSTENCIL_FG_FRAC = (0.30, 0.75)          # fg fraction range for random stencil mode\nSTENCIL_FRAME_MIN_Q = 4                 # min quadrant size to allow frame stencil\nCONTROL_SINGLE_COLOR_PROB = 0.85        # chance control quadrant uses one color\nCONTROL_RECT_PROB = 0.85                # chance control pixels form an axis-aligned rect\nUL_MAX_COLORS = 3                       # max distinct colors in upper-left control\nUR_MAX_COLORS = 2                       # max distinct colors in upper-right control\nOUTPUT_DIM_MIN = 3                      # minimum output height/width\nOUTPUT_DIM_MAX = 16                     # maximum output height/width\nOUTPUT_AREA_MAX = 256                   # maximum output area\nGEN_MAX_RETRIES = 300                   # retry budget for generate_input\n\n\n# ── palette helpers ──────────────────────────────────────────────────\n\ndef _palette(k: int, pool=COLORS) -> list[int]:\n    \"\"\"Return k distinct colors sampled from pool.\"\"\"\n    pool = list(pool)\n    random.shuffle(pool)\n    return pool[:k]\n\n\ndef _random_color_array(shape: tuple[int, ...], palette: list[int]) -> np.ndarray:\n    \"\"\"Fill an array by drawing each cell independently from palette.\"\"\"\n    return np.array([random.choice(palette) for _ in range(int(np.prod(shape)))],\n                    dtype=int).reshape(shape)\n\n\n# ── coordinate orderings for control quadrant ────────────────────────\n\ndef _ordered_coords(q: int, mode: str) -> list[tuple[int, int]]:\n    \"\"\"Return all (r,c) in a qxq grid in a layout-dependent order.\"\"\"\n    coords = [(r, c) for r in range(q) for c in range(q)]\n    if mode == \"rect\":\n        r0, c0 = random.randint(0, q - 1), random.randint(0, q - 1)\n        return [((r + r0) % q, (c + c0) % q) for r, c in coords]\n    if mode == \"rows\":\n        rows, cols = list(range(q)), list(range(q))\n        random.shuffle(rows)\n        random.shuffle(cols)\n        return [(r, c) for r in rows for c in cols]\n    if mode == \"compact\":\n        ar, ac = random.randrange(q), random.randrange(q)\n        random.shuffle(coords)\n        return sorted(coords, key=lambda rc: (abs(rc[0] - ar) + abs(rc[1] - ac), random.random()))\n    # fallback\n    random.shuffle(coords)\n    return coords\n\n\n# ── quadrant builders ────────────────────────────────────────────────\n\ndef _make_lower_left(q: int, palette: list[int],\n                     required_coords: list[tuple[int, int]] | None = None) -> np.ndarray:\n    \"\"\"Build the fill tile (all non-black) using stripe/solid/diagonal patterns.\"\"\"\n    k = len(palette)\n    tile = np.empty((q, q), dtype=int)\n    mode = \"solid\" if k == 1 else random.choice([\"rows\", \"cols\", \"rows\", \"cols\", \"diagonal\"])\n\n    if mode == \"solid\":\n        tile[:] = palette[0]\n    elif mode == \"rows\":\n        offset = random.randrange(k)\n        for r in range(q):\n            tile[r, :] = palette[(r + offset) % k]\n    elif mode == \"cols\":\n        offset = random.randrange(k)\n        for c in range(q):\n            tile[:, c] = palette[(c + offset) % k]\n    elif mode == \"diagonal\":\n        offset = random.randrange(k)\n        rr, cc = np.mgrid[:q, :q]\n        idx = (rr + cc + offset) % k\n        for i, color in enumerate(palette):\n            tile[idx == i] = color\n\n    # ensure every palette color appears at least once\n    existing = set(map(int, np.unique(tile)))\n    missing = [c for c in palette if c not in existing]\n    if missing:\n        fix_coords = list(required_coords) if required_coords is not None else \\\n            [(r, c) for r in range(q) for c in range(q)]\n        random.shuffle(fix_coords)\n        for color, (r, c) in zip(missing, fix_coords):\n            tile[r, c] = color\n    return tile\n\n\ndef _make_stencil(q: int, palette: list[int]) -> np.ndarray:\n    \"\"\"Build the stencil tile (black = holes filled from fill tile).\"\"\"\n    tile = np.zeros((q, q), dtype=int)\n    modes = [\"checker\", \"row_stripe\", \"col_stripe\", \"random\", \"random\"]\n    if q >= STENCIL_FRAME_MIN_Q:\n        modes.append(\"frame\")\n    mode = random.choice(modes)\n\n    if mode == \"checker\":\n        parity = random.randrange(2)\n        mask = (np.arange(q)[:, None] + np.arange(q)[None, :]) % 2 == parity\n        tile[mask] = _random_color_array((int(mask.sum()),), palette)\n    elif mode == \"frame\":\n        t = random.randint(1, max(1, q // 4))\n        mask = np.ones((q, q), dtype=bool)\n        mask[t:q - t, t:q - t] = False\n        tile[mask] = _random_color_array((int(mask.sum()),), palette)\n    elif mode == \"row_stripe\":\n        parity = random.randrange(2)\n        for r in range(q):\n            if r % 2 == parity:\n                tile[r, :] = _random_color_array((q,), palette)\n    elif mode == \"col_stripe\":\n        parity = random.randrange(2)\n        for c in range(q):\n            if c % 2 == parity:\n                tile[:, c] = _random_color_array((q,), palette)\n    else:  # random scatter\n        area = q * q\n        lo = max(1, int(ceil(STENCIL_FG_FRAC[0] * area)))\n        hi = max(lo, int(STENCIL_FG_FRAC[1] * area))\n        fg_count = random.randint(lo, hi)\n        coords = [(r, c) for r in range(q) for c in range(q)]\n        random.shuffle(coords)\n        for r, c in coords[:fg_count]:\n            tile[r, c] = random.choice(palette)\n    return tile\n\n\ndef _make_control(q: int, count: int, max_colors: int, pool: list[int]) -> np.ndarray:\n    \"\"\"Build a control quadrant with exactly `count` non-black pixels.\"\"\"\n    k = 1 if random.random() < CONTROL_SINGLE_COLOR_PROB else \\\n        random.randint(2, min(max_colors, count, len(pool)))\n    pal = _palette(k, pool)\n    tile = np.full((q, q), BLACK, dtype=int)\n\n    factors = [(h, w) for h in range(1, q + 1) for w in range(1, q + 1) if h * w == count]\n    if factors and random.random() < CONTROL_RECT_PROB:\n        h, w = random.choice(factors)\n        r0 = random.randint(0, q - h)\n        c0 = random.randint(0, q - w)\n        tile[r0:r0 + h, c0:c0 + w] = _random_color_array((h, w), pal)\n    else:\n        mode = random.choice([\"rect\", \"compact\", \"rows\"])\n        coords = _ordered_coords(q, mode)[:count]\n        for r, c in coords:\n            tile[r, c] = random.choice(pal)\n    return tile\n\n\n# ── oracle / assembly ────────────────────────────────────────────────\n\ndef _expected_output(fill_tile: np.ndarray, stencil: np.ndarray,\n                     out_h: int, out_w: int) -> np.ndarray:\n    \"\"\"Reproduce the solver's tiling logic for oracle validation.\"\"\"\n    q = fill_tile.shape[0]\n    rr, cc = np.mgrid[:out_h, :out_w]\n    if not np.any(stencil != BLACK):\n        return fill_tile[rr % q, cc % q]\n    tiled = stencil[rr % q, cc % q]\n    bg_mask = tiled == BLACK\n    tiled[bg_mask] = fill_tile[rr[bg_mask] // q, cc[bg_mask] // q]\n    return tiled\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, neighbors4, random_sprite\nfrom scipy.ndimage import label as _scipy_label\nimport random\n\n\ndef _find_border6_square_start(legend: np.ndarray) -> tuple[int, int] | None:\n    h, w = legend.shape\n    if h < 5 or w < 5:\n        return None\n    for r0 in range(h - 4):\n        for c0 in range(w - 4):\n            sub = legend[r0 : r0 + 5, c0 : c0 + 5]\n            if np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6):\n                return int(r0), int(c0)\n    return None\n\n\ndef _find_marker_panel_square(g: np.ndarray, sep_c1: int) -> tuple[int, int] | None:\n    \"\"\"\n    Find the 5x5 border-6 position-marker square that belongs to the 8x5 marker panel.\n\n    In some instances the marker panel can appear inside the main canvas as well as in the\n    left legend region. Prefer a candidate that lies in the main canvas (col > sep_c1) if any.\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            # Must contain a position marker inside (non-{0,6}) and a rotation mark below.\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    main_cands = [rc for rc in candidates if rc[1] > sep_c1]\n    return min(main_cands) if main_cands else min(candidates)\n\n\ndef _separator_runs(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return contiguous runs of full-height columns that are all color 6.\"\"\"\n    h, w = g.shape\n    cols6 = [c for c in range(w) if np.all(g[:, c] == 6)]\n    if not cols6:\n        return []\n    cols6.sort()\n    runs: list[tuple[int, int]] = []\n    s = e = cols6[0]\n    for c in cols6[1:]:\n        if c == e + 1:\n            e = c\n        else:\n            runs.append((s, e))\n            s = e = c\n    runs.append((s, e))\n    return runs\n\n\ndef _split_canvas(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int] | None]:\n    \"\"\"\n    Identify a left separator run (between left legend and canvas), and optionally a\n    right separator run (between canvas and a right-side legend panel).\n    \"\"\"\n    h, w = g.shape\n    runs = _separator_runs(g)\n    assert runs, \"must have at least one color-6 separator run\"\n    left = runs[0]\n    # Prefer a right separator run very near the right edge (a right legend panel).\n    right: tuple[int, int] | None = None\n    for s, e in reversed(runs[1:]):\n        if s >= w - 10 and s > left[1] + 1:\n            right = (s, e)\n            break\n    return left, right\n\n\ndef _find_marker_square_with_preferences(\n    g: np.ndarray, left_sep: tuple[int, int], right_sep: tuple[int, int] | None\n) -> tuple[int, int] | None:\n    \"\"\"\n    Find the marker panel's 5x5 border-6 square.\n\n    Preference order:\n      1) left legend region (at/before left separator)\n      2) right legend region (at/after right separator), if present\n      3) anywhere (including inside the output canvas)\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    left_end = left_sep[1]\n    left_cands = [rc for rc in candidates if rc[1] + 2 <= left_end]\n    if left_cands:\n        return min(left_cands)\n    if right_sep is not None:\n        right_start = right_sep[0]\n        right_cands = [rc for rc in candidates if rc[1] + 2 >= right_start]\n        if right_cands:\n            return min(right_cands)\n    return min(candidates)\n\n\ndef _all_marker_panel_squares(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"List all 5x5 border-6 squares that look like the top of an 8x5 marker panel.\"\"\"\n    h, w = g.shape\n    out: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            out.append((int(r0), int(c0)))\n    out.sort()\n    return out\n\n\ndef _extract_unit_sprite(legend: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    # Unit sprite is the top-most 4-connected component of pixels not in {0,6}.\n    mask = (legend != 0) & (legend != 6)\n    pts_all = np.argwhere(mask)\n    if pts_all.size == 0:\n        return None\n    rmin = int(pts_all[:, 0].min())\n    # choose left-most on that row to seed\n    cseed = int(np.argwhere(mask[rmin, :])[0, 0])\n    # BFS from seed to get component\n    h, w = legend.shape\n    vis = np.zeros((h, w), dtype=bool)\n    st = [(rmin, cseed)]\n    vis[rmin, cseed] = True\n    pts: list[tuple[int, int]] = []\n    while st:\n        r, c = st.pop()\n        pts.append((r, c))\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not vis[rr, cc]:\n                vis[rr, cc] = True\n                st.append((rr, cc))\n    r0, c0, r1, c1 = bbox_coords(np.asarray(pts))\n    spr = legend[r0 : r1 + 1, c0 : c1 + 1].copy()\n    # Unit sprite uses two colors; the rendered sprite is the color-swapped version.\n    cols = sorted({int(x) for x in np.unique(spr) if int(x) not in (0, 6)})\n    if len(cols) == 2:\n        a, b = cols\n        spr2 = spr.copy()\n        spr2[spr == a] = -1\n        spr2[spr == b] = a\n        spr2[spr2 == -1] = b\n        spr = spr2\n    return spr, (r0, c0, r1, c1)\n\n\ndef _extract_frame_bbox(legend: np.ndarray, unit_bb: tuple[int, int, int, int], border6_r0: int) -> tuple[int, int, int, int] | None:\n    # Frame pixels live between the unit sprite and the border6 square.\n    r_start = unit_bb[2] + 1\n    r_end = border6_r0 - 1\n    if r_start > r_end:\n        return None\n    sub = legend[r_start : r_end + 1, :]\n    mask = (sub != 0) & (sub != 6)\n    pts = np.argwhere(mask)\n    if pts.size == 0:\n        return None\n    pts[:, 0] += r_start\n    r0 = int(pts[:, 0].min())\n    r1 = int(pts[:, 0].max())\n    c0 = int(pts[:, 1].min())\n    c1 = int(pts[:, 1].max())\n    return (r0, c0, r1, c1)\n\n\ndef _position_indices_from_border_square(legend: np.ndarray, border6_r0: int, border6_c0: int) -> tuple[int, int] | None:\n    sq = legend[border6_r0 : border6_r0 + 5, border6_c0 : border6_c0 + 5]\n    inner = sq[1:4, 1:4]\n    pts = np.argwhere((inner != 0) & (inner != 6))\n    if pts.size == 0:\n        return None\n    # If multiple, take the first (should be unique)\n    r, c = int(pts[0, 0]), int(pts[0, 1])\n    return r, c  # 0..2\n\n\ndef _rotation_from_clockhand(legend: np.ndarray, border6_r0: int, border6_c0: int) -> int:\n    \"\"\"\n    Rotation marker is in the bottom 3x3 at rows (border6_r0+5 .. border6_r0+7) and cols (1..3),\n    drawn with non-{0,6} pixels (typically 7). Use the furthest pixel from the center (1,1)\n    to determine direction:\n      up -> 0, right -> 1, down -> 2, left -> 3.\n    \"\"\"\n    h, w = legend.shape\n    r0 = border6_r0 + 5\n    c0 = border6_c0 + 1\n    assert r0 + 2 < h and c0 + 2 < w, \"rotation marker patch out of bounds\"\n    sub = legend[r0 : r0 + 3, c0 : c0 + 3]\n    pts = np.argwhere((sub != 0) & (sub != 6))\n    assert pts.size > 0, \"no rotation marker pixel found\"\n    center = np.array([1, 1], dtype=int)\n    # pick furthest (Manhattan) from center\n    dists = np.abs(pts - center).sum(axis=1)\n    p = pts[int(dists.argmax())]\n    dr, dc = int(p[0] - center[0]), int(p[1] - center[1])\n    if abs(dr) >= abs(dc):\n        if dr < 0:\n            return 0\n        if dr > 0:\n            return 2\n    else:\n        if dc > 0:\n            return 1\n        if dc < 0:\n            return 3\n    raise AssertionError(\"rotation marker pixel at center, direction ambiguous\")\n\n\ndef _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:\n    \"\"\"\n    anchor_idx in {0,1,2} selects position on a length:\n      0 -> start, 1 -> middle, 2 -> end\n    Returns the top-left coordinate so that the corresponding point of the placed object\n    aligns with that point on the canvas.\n    \"\"\"\n    if anchor_idx <= 0:\n        canvas_anchor = 0\n        obj_anchor = 0\n    elif anchor_idx >= 2:\n        canvas_anchor = max(0, size - 1)\n        obj_anchor = max(0, place_size - 1)\n    else:\n        canvas_anchor = (size - 1) // 2 if size > 1 else 0\n        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0\n    return canvas_anchor - obj_anchor\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n","exit_code":0,"status":"completed"}}
