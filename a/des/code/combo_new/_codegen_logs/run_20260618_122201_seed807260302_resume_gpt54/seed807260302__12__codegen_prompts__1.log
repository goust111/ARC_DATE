{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nshapes = {\n'bar2': np.array([[1,1]], dtype=int),\n'bar3': np.array([[1,1,1]], dtype=int),\n'bar4': np.array([[1,1,1,1]], dtype=int),\n'L3': np.array([[1,1],[1,0]], dtype=int),\n'L4': np.array([[1,1,1],[1,0,0]], dtype=int),\n'T4': np.array([[1,1,1],[0,1,0]], dtype=int),\n}\nfor name, a in shapes.items():\n    print(name, a.shape, a.sum())\n    for k in range(4):\n        b = np.rot90(a, k)\n        rows = np.where(b.any(axis=1))[0]\n        cols = np.where(b.any(axis=0))[0]\n        b = b[rows[0]:rows[-1]+1, cols[0]:cols[-1]+1]\n        print(k, b.shape)\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
