{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed807260302/12/1.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nfor trial in range(20):\n    random.seed(trial)\n    np.random.seed(trial)\n    n_pairs = random.choice([2, 3, 3, 4])\n    shape_names = mod._choose_shape_names(n_pairs)\n    palette = random.sample(range(1, 10), 2 * n_pairs)\n    frame_colors = palette[:n_pairs]\n    piece_colors = palette[n_pairs:]\n\n    frame_records = []\n    piece_records = []\n    for idx, shape_name in enumerate(shape_names):\n        side = random.choice(['top', 'bottom', 'left', 'right'])\n        frame_patch, ring_mask = mod._build_frame_patch(frame_colors[idx], shape_name, side)\n        piece_patch, piece_mask = mod._build_piece_patch(piece_colors[idx], shape_name)\n        frame_records.append({'pair_idx': idx, 'patch': frame_patch, 'ring_mask': ring_mask, 'color': frame_colors[idx]})\n        piece_records.append({'pair_idx': idx, 'patch': piece_patch, 'mask': piece_mask, 'color': piece_colors[idx]})\n\n    all_patches = [rec['patch'] for rec in frame_records] + [rec['patch'] for rec in piece_records]\n    max_h = max(int(p.shape[0]) for p in all_patches) + 2 * mod.PLACEMENT_PAD\n    max_w = max(int(p.shape[1]) for p in all_patches) + 2 * mod.PLACEMENT_PAD\n    area_need = sum((int(p.shape[0]) + 2) * (int(p.shape[1]) + 2) for p in all_patches)\n    base = max(max_h, max_w, int(np.ceil(np.sqrt(area_need * 1.45))))\n    base = max(base, 18 if n_pairs <= 2 else 20)\n    print('trial', trial, 'n_pairs', n_pairs, 'shapes', shape_names, 'base', base)\n    if base > 30:\n        print('  base too large')\n        continue\n    grid = np.zeros((random.randint(base, 30), random.randint(base, 30)), dtype=int)\n    reserve = np.zeros_like(grid, dtype=bool)\n    objects = [('frame', i, frame_records[i]['patch']) for i in range(n_pairs)]\n    objects += [('piece', i, piece_records[i]['patch']) for i in range(n_pairs)]\n    objects.sort(key=lambda item: int(item[2].shape[0]) * int(item[2].shape[1]), reverse=True)\n    ok = True\n    for kind, idx, patch in objects:\n        pos = mod._place_patch_random(grid, reserve, patch)\n        if pos is None:\n            print('  placement failed', kind, idx, patch.shape, 'grid', grid.shape)\n            ok = False\n            break\n        if kind == 'frame':\n            frame_records[idx]['origin'] = pos\n        else:\n            piece_records[idx]['origin'] = pos\n    if not ok:\n        continue\n    expected = grid.copy()\n    for rec in piece_records:\n        pr, pc = rec['origin']\n        ph, pw = map(int, rec['patch'].shape)\n        sub = expected[pr : pr + ph, pc : pc + pw]\n        sub[rec['mask']] = int(mod.BG)\n    for rec in frame_records:\n        fr, fc = rec['origin']\n        fh, fw = map(int, rec['patch'].shape)\n        sub = expected[fr : fr + fh, fc : fc + fw]\n        sub[rec['ring_mask']] = int(piece_records[rec['pair_idx']]['color'])\n    try:\n        bg, frames, pieces = mod._extract_scene(grid)\n        assignment, solution_count = mod._match_frames_to_pieces(frames, pieces)\n        print('  scene', len(frames), len(pieces), 'solutions', solution_count)\n        same = np.array_equal(mod.main(grid), expected)\n        print('  main==expected', same)\n        if not same:\n            print('  frame gap keys', [f['gap_key'] for f in frames])\n            print('  piece keys', [p['shape_key'] for p in pieces])\n            break\n    except Exception as e:\n        print('  analysis failed', type(e).__name__, e)\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
