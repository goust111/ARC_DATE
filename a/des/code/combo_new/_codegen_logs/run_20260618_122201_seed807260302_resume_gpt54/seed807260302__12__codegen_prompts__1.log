tions perpendicular to *stem*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:354:    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:362:    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:371:    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:385:    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:431:    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:453:    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:473:    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:514:    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:538:    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:544:    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:556:    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:566:    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:700:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:23:    \"\"\"\n/home/lixinyu/snap