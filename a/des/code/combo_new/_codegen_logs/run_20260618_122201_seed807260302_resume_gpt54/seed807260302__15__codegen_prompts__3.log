{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, math\nimport numpy as np\nfrom collections import defaultdict\n\nBLACK=0\nNEI4=[(-1,0),(1,0),(0,-1),(0,1)]\nNEI8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1)]\n\ndef comps(grid):\n    H,W=grid.shape\n    seen=np.zeros((H,W),bool)\n    out=[]\n    for r in range(H):\n        for c in range(W):\n            color=int(grid[r,c])\n            if color==0 or seen[r,c]:\n                continue\n            q=[(r,c)]\n            seen[r,c]=True\n            cells=[]\n            while q:\n                rr,cc=q.pop()\n                cells.append((rr,cc))\n                for dr,dc in NEI4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and int(grid[nr,nc])==color:\n                        seen[nr,nc]=True\n                        q.append((nr,nc))\n            rows=[r for r,_ in cells]; cols=[c for _,c in cells]\n            r0,r1=min(rows),max(rows); c0,c1=min(cols),max(cols)\n            rel=frozenset((r-r0,c-c0) for r,c in cells)\n            out.append({'color':color,'bbox':(r0,c0,r1,c1),'rel':rel,'shape':(r1-r0+1,c1-c0+1)})\n    out.sort(key=lambda d:(d['bbox'][0],d['bbox'][1]))\n    return out\n\n\ndef rect_dims(a,b):\n    ca=a['rel']; cb=b['rel']\n    h1,w1=a['shape']; h2,w2=b['shape']\n    dims=set()\n    for dr in range(-h2, h1+1):\n        for dc in range(-w2, w1+1):\n            sb={(r+dr,c+dc) for r,c in cb}\n            if ca & sb:\n                continue\n            union=ca|sb\n            rows=[r for r,_ in union]; cols=[c for _,c in union]\n            h=max(rows)-min(rows)+1; w=max(cols)-min(cols)+1\n            if len(union)==h*w:\n                dims.add((h,w))\n    return dims\n\n\ndef main(grid):\n    comps_by_color=defaultdict(list)\n    order=[]\n    for comp in comps(grid):\n        if comp['color'] not in comps_by_color:\n            order.append(comp['color'])\n        comps_by_color[comp['color']].append(comp)\n    rects=[]\n    for color in order:\n        pair=comps_by_color[color]\n        if len(pair)\"'!=2:\n            raise AssertionError\n        dims=rect_dims(pair[0],pair[1])\n        if len(dims)!=1:\n            raise AssertionError(dims)\n        h,w=next(iter(dims))\n        rects.append((h*w,h,w,color))\n    rects.sort(key=lambda t:t[0])\n    out=np.zeros((max(h for _,h,_,_ in rects), sum(w for _,_,w,_ in rects)+len(rects)-1),int)\n    c=0\n    for area,h,w,color in rects:\n        out[-h:,c:c+w]=color\n        c+=w+1\n    return out\n\n\ndef profile(length, low, high):\n    vals=[random.randint(low, high)]\n    for _ in range(1,length):\n        prev=vals[-1]\n        choices=[prev]\n        for step in (-2,-1,1,2):\n            v=prev+step\n            if low<=v<=high:\n                choices.append(v)\n        vals.append(random.choice(choices))\n    if len(set(vals))==1:\n        idx=random.randrange(length)\n        alt=[v for v in range(low,high+1) if v!=vals[idx]]\n        vals[idx]=random.choice(alt)\n    return vals\n\n\ndef split_rect(h,w,color):\n    for _ in range(200):\n        if random.random()<0.5:\n            cut=profile(h,1,w-1)\n            a={(r,c) for r in range(h) for c in range(cut[r])}\n        else:\n            cut=profile(w,1,h-1)\n            a={(r,c) for c in range(w) for r in range(cut[c])}\n        full={(r,c) for r in range(h) for c in range(w)}\n        b=full-a\n        if random.random()<0.5:\n            a,b=b,a\n        def mk(cells):\n            rows=[r for r,_ in cells]; cols=[c for _,c in cells]\n            r0,r1=min(rows),max(rows); c0,c1=min(cols),max(cols)\n            patch=np.zeros((r1-r0+1,c1-c0+1),int)\n            for r,c in cells:\n                patch[r-r0,c-c0]=color\n            return patch\n        p1=mk(a); p2=mk(b)\n        g=np.zeros((max(p1.shape[0],p2.shape[0]), p1.shape[1]+p2.shape[1]+5),int)\n        g[:p1.shape[0],:p1.shape[1]]=p1\n        g[:p2.shape[0],p1.shape[1]+5:p1.shape[1]+5+p2.shape[1]]=p2\n        cc=comps(g)\n        dims=rect_dims(cc[0],cc[1])\n        if dims=={(h,w)}:\n            return p1,p2\n    raise RuntimeError('\"'split failed')\n\n\ndef can_place(blocked, patch, r0,c0):\n    H,W=blocked.shape\n    cells=np.argwhere(patch\"'!=0)\n    for rr,cc in cells:\n        r=r0+int(rr); c=c0+int(cc)\n        if not (0<=r<H and 0<=c<W): return False\n        if blocked[r,c]: return False\n    return True\n\n\ndef place(patches):\n    shapes=[tuple(p.shape) for p in patches]\n    need=sum((h+2)*(w+2) for h,w in shapes)\n    min_h=max(h for h,_ in shapes)+2\n    min_w=max(w for _,w in shapes)+2\n    for _ in range(200):\n        H=random.randint(min_h,30)\n        W=random.randint(min_w,30)\n        if H*W < int(need*1.2):\n            continue\n        blocked=np.zeros((H,W),bool)\n        grid=np.zeros((H,W),int)\n        order=sorted(range(len(patches)), key=lambda i: patches[i].shape[0]*patches[i].shape[1], reverse=True)\n        ok=True\n        for i in order:\n            patch=patches[i]\n            h,w=patch.shape\n            spots=[]\n            for r0 in range(H-h+1):\n                for c0 in range(W-w+1):\n                    if can_place(blocked, patch, r0,c0):\n                        spots.append((r0,c0))\n            if not spots:\n                ok=False; break\n            r0,c0=random.choice(spots)\n            cells=np.argwhere(patch!=0)\n            for rr,cc in cells:\n                grid[r0+rr,c0+cc]=patch[rr,cc]\n                for dr,dc in NEI8:\n                    nr,nc=r0+rr+dr,c0+cc+dc\n                    if 0<=nr<H and 0<=nc<W:\n                        blocked[nr,nc]=True\n        if ok:\n            return grid\n    return None\n\n\ndef gen():\n    for _ in range(500):\n        k=random.randint(2,4)\n        dims=[]\n        areas=set()\n        for __ in range(500):\n            dims=[]; areas=set()\n            for _ in range(k):\n                h=random.randint(3,6)\n                w=random.randint(3,7)\n                area=h*w\n                if area in areas:\n                    break\n                dims.append((h,w)); areas.add(area)\n            else:\n                if sum(w for h,w in dims)+k-1<=30:\n                    break\n        else:\n            continue\n        colors=random.sample(range(1,10),k)\n        rects=[]; patches=[]\n        for (h,w),color in zip(dims,colors):\n            p1,p2=split_rect(h,w,color)\n            patches.extend([p1,p2])\n            rects.append((h*w,h,w,color))\n        grid=place(patches)\n        if grid is None: continue\n        out=main(grid)\n        exp_rects=sorted(rects,key=lambda t:t[0])\n        exp=np.zeros((max(h for _,h,_,_ in exp_rects), sum(w for _,_,w,_ in exp_rects)+k-1),int)\n        c=0\n        for _,h,w,color in exp_rects:\n            exp[-h:,c:c+w]=color\n            c+=w+1\n        if np.array_equal(out,exp):\n            return grid,out\n    raise RuntimeError('\"'gen fail')\n\nfor i in range(50):\n    g,o=gen()\n    assert max(g.shape)<=30 and max(o.shape)<=30\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
