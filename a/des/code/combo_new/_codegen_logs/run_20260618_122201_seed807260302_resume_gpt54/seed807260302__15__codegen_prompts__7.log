{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/4df5b0ae.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, paste, random_free_location, random_sprite\nimport random\n\n\ndef _is_full_grid_frame(component: dict, shape: tuple[int, int]) -> bool:\n    H, W = shape\n    r0, c0, r1, c1 = component[\"bbox\"]\n    if (r0, c0, r1, c1) != (0, 0, H - 1, W - 1):\n        return False\n    perimeter_area = 2 * H + 2 * W - 4\n    return int(component[\"area\"]) == perimeter_area and all(\n        r in (0, H - 1) or c in (0, W - 1) for r, c in component[\"coords\"]\n    )\n\n\ndef _component_sprite(component: dict, bg: int) -> np.ndarray:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)\n    for r, c in component[\"coords\"]:\n        sprite[r - r0, c - c0] = int(component[\"color\"])\n    return sprite\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Pack the colored sprites along the bottom edge from smallest to largest.\n\n    Input structure\n    The grid has a dominant background color and several monochrome 4-connected\n    foreground sprites; a full-grid one-cell frame may surround the scene.\n\n    Rule\n    Remove any full-grid rectangular frame, sort the remaining sprites by pixel\n    area from smallest to largest, and paste their bounding-box sprites left to\n    right with each sprite bottom-aligned.\n\n    Key insight\n    The original locations do not determine the final slots; each sprite's area\n    gives the packing order, while its shape and color are preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n\n    sprites: list[tuple[int, np.ndarray]] = []\n    for component in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        if _is_full_grid_frame(component, g.shape):\n            continue\n        sprites.append((int(component[\"area\"]), _component_sprite(component, bg)))\n\n    assert sprites\n    areas = [area for area, _sprite in sprites]\n    assert len(areas) == len(set(areas))\n\n    out = np.full_like(g, bg)\n    c = 0\n    for _area, sprite in sorted(sprites, key=lambda item: item[0]):\n        h, w = sprite.shape\n        assert h <= H and c + w <= W\n        paste(out, sprite, H - h, c, transparent=bg)\n        c += w\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\nBG = 7\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n\n# Canvas and sprite bounds.\nGRID_HEIGHT, GRID_WIDTH = 10, 10\nSPRITE_MIN_AREA, SPRITE_MAX_AREA = 1, 12\nSPRITE_MAX_HEIGHT, SPRITE_MAX_WIDTH = 6, 4\nMIN_SPRITE_DENSITY = 0.5\n\n# Sprite sampling and validation.\nSPRITE_COUNT_CHOICES = [3, 4]\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = 'not_symmetric'\nSPRITE_RETRY_LIMIT = 20\n\n# Frame, placement, and generation retries.\nFRAME_PROBABILITY = 0.3\nFRAME_BORDER, NO_FRAME_BORDER = 1, 0\nGENERATION_RETRY_LIMIT = 300\n\nVALID_SPRITE_SHAPES = {\n    area: [(h, w) for h in range(1, SPRITE_MAX_HEIGHT + 1)\n           for w in range(1, SPRITE_MAX_WIDTH + 1)\n           if h * w >= area and area / (h * w) >= MIN_SPRITE_DENSITY]\n    for area in range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1)\n}\n\n\ndef _make_sprite(area, color):\n    valid_shapes = list(VALID_SPRITE_SHAPES.get(area, []))\n    if not valid_shapes:\n        return None\n\n    random.shuffle(valid_shapes)\n    for h, w in valid_shapes:\n        bbox_area = h * w\n        if bbox_area == area:\n            return np.full((h, w), color, dtype=int)\n        try:\n            sprite = random_sprite(h, w, density=area / bbox_area,\n                                   color_palette=[color], connectivity=SPRITE_CONNECTIVITY,\n                                   background=BG, symmetry=SPRITE_SYMMETRY)\n            actual_area = int(np.sum(sprite != BG))\n            if actual_area == area and is_contiguous(sprite, background=BG,\n                                                     connectivity=SPRITE_CONNECTIVITY):\n                return sprite\n        except Exception:\n            continue\n    return None\n\n\ndef _sample_sprite_specs():\n    n_sprites = random.choice(SPRITE_COUNT_CHOICES)\n    possible_areas = list(range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1))\n    random.shuffle(possible_areas)\n    areas = sorted(possible_areas[:n_sprites])\n    colors = [random.choice(ALL_COLORS) for _ in range(n_sprites)]\n    return areas, colors\n\n\ndef _make_sprites(areas, colors):\n    \"\"\"Build all sprites, preserving area order; return None if any shape fails.\"\"\"\n    sprites = []\n    for area, color in zip(areas, colors):\n        sprite = None\n        for _ in range(SPRITE_RETRY_LIMIT):\n            sprite = _make_sprite(area, color)\n            if sprite is not None:\n                break\n        if sprite is None:\n            return None\n        sprites.append(sprite)\n    return sprites\n\n\ndef _fits_packed_output(sprites):\n    total_width = sum(sprite.shape[1] for sprite in sprites)\n    max_height = max(sprite.shape[0] for sprite in sprites)\n    return total_width <= GRID_WIDTH and max_height <= GRID_HEIGHT\n\n\ndef _pack_output(sprites):\n    output = np.full((GRID_HEIGHT, GRID_WIDTH), BG, dtype=int)\n    col = 0\n    for sprite in sprites:\n        sprite_height, sprite_width = sprite.shape\n        paste(output, sprite, GRID_HEIGHT - sprite_height, col, transparent=BG)\n        col += sprite_width\n    return output\n\n\ndef _maybe_add_frame(grid, sprites):\n    \"\"\"Mutate grid with an optional perimeter frame; return the active border.\"\"\"\n    use_frame = random.random() < FRAME_PROBABILITY\n    if not use_frame:\n        return NO_FRAME_BORDER\n\n    sprite_colors = set(int(sprite[sprite != BG].flat[0]) for sprite in sprites)\n    frame_candidates = [color for color in ALL_COLORS if color not in sprite_colors]\n    if not frame_candidates:\n        return NO_FRAME_BORDER\n\n    frame_color = random.choice(frame_candidates)\n    grid[0, :] = frame_color\n    grid[-1, :] = frame_color\n    grid[:, 0] = frame_color\n    grid[:, -1] = frame_color\n    return FRAME_BORDER\n\n\ndef _place_sprites(grid, sprites, border):\n    \"\"\"Place sprites in-place; return False if no legal location is found.\"\"\"\n    for sprite in sprites:\n        try:\n            row, col = random_free_location(grid, sprite, transparent=BG, border=border)\n            paste(grid, sprite, row, col, transparent=BG)\n        except ValueError:\n            return False\n    return True\n\n\ndef _passes_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    areas, colors = _sample_sprite_specs()\n    sprites = _make_sprites(areas, colors)\n    if sprites is None or not _fits_packed_output(sprites):\n        return None\n\n    output = _pack_output(sprites)\n    inp = np.full((GRID_HEIGHT, GRID_WIDTH), BG, dtype=int)\n    border = _maybe_add_frame(inp, sprites)\n    if not _place_sprites(inp, sprites, border):\n        return None\n    if _passes_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input():\n    for _ in range(GENERATION_RETRY_LIMIT):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRY_LIMIT} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_w, colors_present, crop_bbox, find_components, get_bg, is_contiguous, paste\nimport itertools\nimport random\n\n\ndef _cells(component):\n    return set(map(tuple, component[\"coords\"]))\n\n\ndef _is_top_bracket(component) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r0 != 0 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r0, c) for c in range(c0, c1 + 1)}\n    expected |= {(r1, c0), (r1, c1)}\n    return _cells(component) == expected\n\n\ndef _is_bottom_bracket(component, height: int) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r1 != height - 1 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r1, c) for c in range(c0, c1 + 1)}\n    expected |= {(r0, c0), (r0, c1)}\n    return _cells(component) == expected\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_half_starts(grid_width, bracket_width, left_side):\n    if left_side:\n        return list(range(0, grid_width // 2 - bracket_width + 1))\n    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n\ndef _gen_bracket_columns(grid_width, bracket_width):\n    \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n    top_left = random.choice(TOP_LEFT_OPTIONS)\n    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n    if not top_starts or not bottom_starts:\n        return None\n    return random.choice(top_starts), random.choice(bottom_starts)\n\ndef _gen_add_bracket(grid, c0, width, top_edge):\n    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n    grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n    grid[arm_row, c0] = BRACKET_COLOR\n    grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n\ndef _gen_sprite_masks(height, width):\n    area = height * width\n    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n    max_cells = min(MOVER_MAX_CELLS, area)\n    masks = []\n    for cell_count in range(min_cells, max_cells + 1):\n        for cells in itertools.combinations(range(area), cell_count):\n            mask = np.zeros((height, width), dtype=bool)\n            mask[np.unravel_index(cells, (height, width))] = True\n            if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n                continue\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n    return masks\n\ndef _gen_mover_sprite(height, width, color, bg):\n    masks = _gen_sprite_masks(height, width)\n    if not masks:\n        return None\n    mask = random.choice(masks)\n    sprite = np.full((height, width), bg, dtype=int)\n    sprite[mask] = color\n    return sprite\n\ndef _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n    \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n    if not np.all(target[sprite_mask] == BG_COLOR):\n        return False\n    paste(grid, sprite, row, col, transparent=BG_COLOR)\n    return True\n\ndef _gen_attempt():\n    height = random.randint(*GRID_SIZE_RANGE)\n    grid_width = random.randint(*GRID_SIZE_RANGE)\n    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n    interior_width = bracket_width - 2\n\n    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n    if bracket_columns is None:\n        return None\n    top_c0, bottom_c0 = bracket_columns\n\n    mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n    mover_color = random.choice(MOVER_COLORS)\n    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n    if sprite is None:\n        return None\n\n    out = np.full((height, grid_width), BG_COLOR, dtype=int)\n    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n\n    dest_r = height - mover_height\n    dest_c = top_c0 + 1\n    sprite_mask = sprite != BG_COLOR\n    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n        return None\n\n    inp = out.copy()\n    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n    target[sprite_mask] = BG_COLOR\n\n    source_c = bottom_c0 + 1\n    max_source_r = height - 2 - mover_height\n    if max_source_r < 1:\n        return None\n    source_r = random.randint(1, max_source_r)\n    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n        return None\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n","exit_code":0,"status":"completed"}}
