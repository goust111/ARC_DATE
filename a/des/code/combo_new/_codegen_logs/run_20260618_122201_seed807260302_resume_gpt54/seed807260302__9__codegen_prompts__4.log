{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/a/des/code/combo_new/seed807260302/9/4.py | sed -n '1,260p'\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\t\n     4\tBG = 0\n     5\tFILL = 5\n     6\tPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)\n     7\tGEN_ATTEMPTS = 300\n     8\tDIRECTIONS = (\"up\", \"down\", \"left\", \"right\")\n     9\t\n    10\tSHAPE_CATALOG = [\n    11\t    np.array([[1, 1]], dtype=bool),\n    12\t    np.array([[1, 1, 1]], dtype=bool),\n    13\t    np.array([[1, 1], [1, 0]], dtype=bool),\n    14\t    np.array([[1, 1], [1, 1]], dtype=bool),\n    15\t    np.array([[1, 1, 1, 1]], dtype=bool),\n    16\t    np.array([[1, 0], [1, 0], [1, 1]], dtype=bool),\n    17\t    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),\n    18\t]\n    19\t\n    20\tOPPOSITE = {\n    21\t    \"up\": \"down\",\n    22\t    \"down\": \"up\",\n    23\t    \"left\": \"right\",\n    24\t    \"right\": \"left\",\n    25\t}\n    26\t\n    27\t\n    28\tdef _corner_majority(grid: np.ndarray) -> int:\n    29\t    corners = np.array([grid[0, 0], grid[0, -1], grid[-1, 0], grid[-1, -1]], dtype=int)\n    30\t    values, counts = np.unique(corners, return_counts=True)\n    31\t    return int(values[np.argmax(counts)])\n    32\t\n    33\t\n    34\tdef _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:\n    35\t    mins = coords.min(axis=0)\n    36\t    maxs = coords.max(axis=0)\n    37\t    return int(mins[0]), int(mins[1]), int(maxs[0]), int(maxs[1])\n    38\t\n    39\t\n    40\tdef _border_mask(h: int, w: int) -> np.ndarray:\n    41\t    mask = np.zeros((h, w), dtype=bool)\n    42\t    mask[0, :] = True\n    43\t    mask[-1, :] = True\n    44\t    mask[:, 0] = True\n    45\t    mask[:, -1] = True\n    46\t    return mask\n    47\t\n    48\t\n    49\tdef _is_connected(mask: np.ndarray) -> bool:\n    50\t    coords = np.argwhere(mask)\n    51\t    if len(coords) == 0:\n    52\t        return False\n    53\t    seen = {tuple(map(int, coords[0]))}\n    54\t    stack = [tuple(map(int, coords[0]))]\n    55\t    h, w = mask.shape\n    56\t    while stack:\n    57\t        r, c = stack.pop()\n    58\t        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    59\t            rr, cc = r + dr, c + dc\n    60\t            if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and (rr, cc) not in seen:\n    61\t                seen.add((rr, cc))\n    62\t                stack.append((rr, cc))\n    63\t    return len(seen) == len(coords)\n    64\t\n    65\t\n    66\tdef _infer_bias_side(seed_mask: np.ndarray) -> str:\n    67\t    coords = np.argwhere(seed_mask)\n    68\t    center_r = (seed_mask.shape[0] - 1) / 2.0\n    69\t    center_c = (seed_mask.shape[1] - 1) / 2.0\n    70\t    centroid_r = float(coords[:, 0].mean())\n    71\t    centroid_c = float(coords[:, 1].mean())\n    72\t    dr = centroid_r - center_r\n    73\t    dc = centroid_c - center_c\n    74\t    if abs(dc) > abs(dr):\n    75\t        return \"left\" if dc < 0 else \"right\"\n    76\t    if abs(dr) > abs(dc):\n    77\t        return \"up\" if dr < 0 else \"down\"\n    78\t\n    79\t    top_gap = int(coords[:, 0].min())\n    80\t    bottom_gap = int(seed_mask.shape[0] - 1 - coords[:, 0].max())\n    81\t    left_gap = int(coords[:, 1].min())\n    82\t    right_gap = int(seed_mask.shape[1] - 1 - coords[:, 1].max())\n    83\t    gaps = {\n    84\t        \"up\": top_gap,\n    85\t        \"down\": bottom_gap,\n    86\t        \"left\": left_gap,\n    87\t        \"right\": right_gap,\n    88\t    }\n    89\t    return min(gaps, key=gaps.get)\n    90\t\n    91\t\n    92\tdef _scaled_shadow(seed_mask: np.ndarray) -> np.ndarray:\n    93\t    coords = np.argwhere(seed_mask)\n    94\t    r0, c0, r1, c1 = _bbox(coords)\n    95\t    cropped = seed_mask[r0 : r1 + 1, c0 : c1 + 1]\n    96\t    scale = int(coords.shape[0])\n    97\t    block = np.ones((scale, scale), dtype=np.uint8)\n    98\t    return np.kron(cropped.astype(np.uint8), block).astype(bool)\n    99\t\n   100\t\n   101\tdef _shadow_start(\n   102\t    bbox: tuple[int, int, int, int], shadow_shape: tuple[int, int], direction: str\n   103\t) -> tuple[int, int]:\n   104\t    r0, c0, r1, c1 = bbox\n   105\t    shadow_h, shadow_w = shadow_shape\n   106\t    mid_r = (r0 + r1) // 2\n   107\t    mid_c = (c0 + c1) // 2\n   108\t    if direction == \"right\":\n   109\t        return mid_r - shadow_h // 2, c1 + 1\n   110\t    if direction == \"left\":\n   111\t        return mid_r - shadow_h // 2, c0 - shadow_w\n   112\t    if direction == \"down\":\n   113\t        return r1 + 1, mid_c - shadow_w // 2\n   114\t    return r0 - shadow_h, mid_c - shadow_w // 2\n   115\t\n   116\t\n   117\tdef _extract_objects(grid: np.ndarray) -> list[dict]:\n   118\t    g = np.asarray(grid, dtype=int)\n   119\t    bg = _corner_majority(g)\n   120\t    objects: list[dict] = []\n   121\t    for color0 in np.unique(g):\n   122\t        color = int(color0)\n   123\t        if color == bg:\n   124\t            continue\n   125\t        coords = np.argwhere(g == color)\n   126\t        if len(coords) < 2:\n   127\t            continue\n   128\t        r0, c0, r1, c1 = _bbox(coords)\n   129\t        if r1 - r0 < 3 or c1 - c0 < 3:\n   130\t            continue\n   131\t        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n   132\t        border = _border_mask(*patch.shape)\n   133\t        if not np.all(patch[border] == color):\n   134\t            continue\n   135\t        interior = patch[1:-1, 1:-1]\n   136\t        if interior.size == 0:\n   137\t            continue\n   138\t        interior_values = set(map(int, np.unique(interior)))\n   139\t        fill_values = interior_values - {color}\n   140\t        if len(fill_values) != 1:\n   141\t            continue\n   142\t        fill = fill_values.pop()\n   143\t        if np.any((interior != color) & (interior != fill)):\n   144\t            continue\n   145\t        seed_mask = interior == color\n   146\t        seed_count = int(seed_mask.sum())\n   147\t        if not 2 <= seed_count <= 4:\n   148\t            continue\n   149\t        if not _is_connected(seed_mask):\n   150\t            continue\n   151\t        objects.append(\n   152\t            {\n   153\t                \"color\": color,\n   154\t                \"fill\": int(fill),\n   155\t                \"bbox\": (r0, c0, r1, c1),\n   156\t                \"seed_mask\": seed_mask,\n   157\t            }\n   158\t        )\n   159\t    objects.sort(key=lambda obj: (obj[\"bbox\"][0], obj[\"bbox\"][1], obj[\"color\"]))\n   160\t    return objects\n   161\t\n   162\t\n   163\tdef _transform(grid: np.ndarray) -> np.ndarray:\n   164\t    g = np.asarray(grid, dtype=int)\n   165\t    h, w = g.shape\n   166\t    bg = _corner_majority(g)\n   167\t    out = g.copy()\n   168\t    for obj in _extract_objects(g):\n   169\t        seed_mask = obj[\"seed_mask\"]\n   170\t        direction = OPPOSITE[_infer_bias_side(seed_mask)]\n   171\t        shadow = _scaled_shadow(seed_mask)\n   172\t        start_r, start_c = _shadow_start(obj[\"bbox\"], shadow.shape, direction)\n   173\t        for rr0, cc0 in np.argwhere(shadow):\n   174\t            rr = int(start_r + rr0)\n   175\t            cc = int(start_c + cc0)\n   176\t            if 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == bg and int(out[rr, cc]) == bg:\n   177\t                out[rr, cc] = int(obj[\"color\"])\n   178\t    return out\n   179\t\n   180\t\n   181\tdef main(grid: np.ndarray) -> np.ndarray:\n   182\t    \"\"\"\n   183\t    Project an enlarged copy of each object's interior seed pattern out of the rectangle on the opposite side.\n   184\t\n   185\t    Input structure:\n   186\t    - The background is black.\n   187\t    - Several separated rectangular objects appear on the grid.\n   188\t    - Each object has a single-color rectangular border, a grey interior fill, and a small same-color seed pattern embedded inside the fill.\n   189\t    - Each seed is a 2-4 pixel 4-connected shape and sits noticeably closer to one interior side than to the others.\n   190\t\n   191\t    Rule:\n   192\t    - For each rectangular object, isolate the interior same-color seed pattern.\n   193\t    - Determine which side of the grey interior the seed is biased toward by comparing the seed's centroid with the rectangle center.\n   194\t    - Project a shadow from the opposite outer side of the rectangle.\n   195\t    - Scale the seed pattern by N in both axes, where N is the number of seed pixels, keep its orientation, and place it outside the rectangle so the shadow side is centered on that border's midpoint.\n   196\t    - Paint the shadow in the object's border color, only onto background cells, and leave the original object unchanged.\n   197\t\n   198\t    Key insight:\n   199\t    - The inner colored pixels are not noise: their shape is copied, their count sets the scale factor, and their off-center placement reverses the shadow direction.\n   200\t    \"\"\"\n   201\t    return _transform(np.asarray(grid, dtype=int))\n   202\t\n   203\t\n   204\tdef _random_shape(rng: np.random.Generator) -> np.ndarray:\n   205\t    mask = SHAPE_CATALOG[int(rng.integers(len(SHAPE_CATALOG)))]\n   206\t    k = int(rng.integers(4))\n   207\t    return np.rot90(mask, k=k).copy()\n   208\t\n   209\t\n   210\tdef _seed_offsets(limit: int, rng: np.random.Generator) -> list[int]:\n   211\t    center = limit // 2\n   212\t    candidates = [center - 1, center, center + 1]\n   213\t    valid = sorted({x for x in candidates if 0 <= x <= limit})\n   214\t    rng.shuffle(valid)\n   215\t    return valid\n   216\t\n   217\t\n   218\tdef _build_seed_mask(\n   219\t    interior_h: int, interior_w: int, shape: np.ndarray, bias: str, rng: np.random.Generator\n   220\t) -> np.ndarray | None:\n   221\t    sh, sw = shape.shape\n   222\t    max_r = interior_h - sh\n   223\t    max_c = interior_w - sw\n   224\t    if max_r < 0 or max_c < 0:\n   225\t        return None\n   226\t\n   227\t    row_choices = _seed_offsets(max_r, rng)\n   228\t    col_choices = _seed_offsets(max_c, rng)\n   229\t\n   230\t    if bias == \"left\":\n   231\t        side_choices = [c for c in range(min(2, max_c + 1)) if max_c - c >= 2]\n   232\t        positions = [(r, c) for c in side_choices for r in row_choices]\n   233\t    elif bias == \"right\":\n   234\t        side_choices = [c for c in range(max(0, max_c - 1), max_c + 1) if c >= 2]\n   235\t        positions = [(r, c) for c in reversed(side_choices) for r in row_choices]\n   236\t    elif bias == \"up\":\n   237\t        side_choices = [r for r in range(min(2, max_r + 1)) if max_r - r >= 2]\n   238\t        positions = [(r, c) for r in side_choices for c in col_choices]\n   239\t    else:\n   240\t        side_choices = [r for r in range(max(0, max_r - 1), max_r + 1) if r >= 2]\n   241\t        positions = [(r, c) for r in reversed(side_choices) for c in col_choices]\n   242\t\n   243\t    rng.shuffle(positions)\n   244\t    for top, left in positions:\n   245\t        seed_mask = np.zeros((interior_h, interior_w), dtype=bool)\n   246\t        seed_mask[top : top + sh, left : left + sw] = shape\n   247\t        if _infer_bias_side(seed_mask) == bias:\n   248\t            return seed_mask\n   249\t    return None\n   250\t\n   251\t\n   252\tdef _make_object_patch(\n   253\t    color: int, bias: str, rng: np.random.Generator\n   254\t) -> tuple[np.ndarray, np.ndarray] | None:\n   255\t    for _ in range(100):\n   256\t        shape = _random_shape(rng)\n   257\t        sh, sw = shape.shape\n   258\t        interior_h = int(rng.integers(max(5, sh + 3), min(9, sh + 6) + 1))\n   259\t        interior_w = int(rng.integers(max(5, sw + 3), min(9, sw + 6) + 1))\n   260\t        seed_mask = _build_seed_mask(interior_h, interior_w, shape, bias, rng)\n","exit_code":0,"status":"completed"}}
