   for r, c in cells:\n   301\t        for dr in (-1, 0, 1):\n   302\t            for dc in (-1, 0, 1):\n   303\t                rr, cc = r + dr, c + dc\n   304\t                if 0 <= rr < h and 0 <= cc < w:\n   305\t                    blocked[rr, cc] = True\n   306\t\n   307\t\n   308\tdef _place_patch(\n   309\t    grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, seed_mask: np.ndarray, rng: np.random.Generator\n   310\t) -> bool:\n   311\t    h, w = grid.shape\n   312\t    ph, pw = patch.shape\n   313\t    row_order = rng.permutation(h - ph + 1)\n   314\t    col_order = rng.permutation(w - pw + 1)\n   315\t    for top in row_order:\n   316\t        for left in col_order:\n   317\t            obj_cells = _actual_cells(int(top), int(left), patch)\n   318\t            shadow_cells = _shadow_cells_for_patch(int(top), int(left), patch, seed_mask)\n   319\t            if not shadow_cells:\n   320\t                continue\n   321\t            if any(not (0 <= r < h and 0 <= c < w) for r, c in shadow_cells):\n   322\t                continue\n   323\t            all_cells = obj_cells | shadow_cells\n   324\t            if _touches_corner(all_cells, h, w):\n   325\t                continue\n   326\t            if any(bool(blocked[r, c]) for r, c in all_cells):\n   327\t                continue\n   328\t            for rr, cc in obj_cells:\n   329\t                grid[rr, cc] = int(patch[rr - int(top), cc - int(left)])\n   330\t            _mark_blocked(blocked, all_cells)\n   331\t            return True\n   332\t    return False\n   333\t\n   334\t\n   335\tdef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n   336\t    count = int(rng.choice([2, 3]))\n   337\t    h_low = 18 if count == 2 else 24\n   338\t    w_low = 18 if count == 2 else 24\n   339\t    h = int(rng.integers(h_low, 31))\n   340\t    w = int(rng.integers(w_low, 31))\n   341\t    grid = np.full((h, w), BG, dtype=int)\n   342\t    blocked = np.zeros((h, w), dtype=bool)\n   343\t\n   344\t    colors = [int(v) for v in rng.choice(PALETTE, size=count, replace=False)]\n   345\t    biases = list(rng.choice(np.array(DIRECTIONS), size=count, replace=False))\n   346\t    rng.shuffle(biases)\n   347\t\n   348\t    for color, bias0 in zip(colors, biases):\n   349\t        bias = str(bias0)\n   350\t        made = _make_object_patch(color, bias, rng)\n   351\t        if made is None:\n   352\t            return None\n   353\t        patch, seed_mask = made\n   354\t        if not _place_patch(grid, blocked, patch, seed_mask, rng):\n   355\t            return None\n   356\t\n   357\t    objects = _extract_objects(grid)\n   358\t    if len(objects) != count:\n   359\t        return None\n   360\t    out = _transform(grid)\n   361\t    if np.array_equal(out, grid):\n   362\t        return None\n   363\t    return grid\n   364\t\n   365\t\n   366\tdef generate_input() -> np.ndarray:\n   367\t    rng = np.random.default_rng()\n   368\t    for _ in range(GEN_ATTEMPTS):\n   369\t        grid = _gen_attempt(rng)\n   370\t        if grid is not None:\n   371\t            return grid\n   372\t    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
