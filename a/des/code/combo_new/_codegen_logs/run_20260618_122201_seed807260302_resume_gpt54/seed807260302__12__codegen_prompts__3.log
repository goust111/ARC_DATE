{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom arc_utils import get_bg, in_bounds, neighbors4, label_mask\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\n            for g2 in (nxt_cands if nxt_cands else [f]):\n                sr, sc = aligned(f, g2)\n                al = 1 if (sr or sc) else 0\n                (r1_, c1_) = center(f)\n                (r2_, c2_) = center(g2)\n                d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n                cand = (int(al), -int(d))\n                if best is None or cand > best:\n                    best = cand\n                    bestf = f\n        cur = bestf\n\n    out = g.copy()\n\n    def draw_bridge(fa: dict, fb: dict, color: int) -> None:\n        (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n        (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n        ia = fa[\"inner_bbox\"]\n        sr, sc = aligned(fa, fb)\n        if sr:\n            rr0, rr1 = int(ia[0]), int(ia[2])\n            if int(c1a) < int(c0b):\n                cc0, cc1 = int(c1a + 1), int(c0b - 1)\n            else:\n                cc0, cc1 = int(c1b + 1), int(c0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n            return\n        if sc:\n            cc0, cc1 = int(ia[1]), int(ia[3])\n            if int(r1a) < int(r0b):\n                rr0, rr1 = int(r1a + 1), int(r0b - 1)\n            else:\n                rr0, rr1 = int(r1b + 1), int(r0a - 1)\n            for r in range(int(rr0), int(rr1) + 1):\n                for c in range(int(cc0), int(cc1) + 1):\n                    if 0 <= r < H and 0 <= c < W:\n                        out[int(r), int(c)] = int(color)\n\n    for i in range(int(len(ctrl)) - 1):\n        a = int(ctrl[i])\n        b = int(ctrl[i + 1])\n        assert int(cur[\"inner\"]) == int(a)\n        assert b in by, f\"control color {b} has no matching frame\"\n        cands = by[b]\n        best = None\n        bestf = None\n        for f in cands:\n            sr, sc = aligned(cur, f)\n            al = 1 if (sr or sc) else 0\n            (r1_, c1_) = center(cur)\n            (r2_, c2_) = center(f)\n            d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))\n            cand = (int(al), -int(d))\n            if best is None or cand > best:\n                best = cand\n                bestf = f\n        nxt = bestf\n        draw_bridge(cur, nxt, int(a))\n        cur = nxt\n\n    return out\n\n\ndef _most_common_nonbg(g: np.ndarray, bg: int) -> int | None:\n    cnt = Counter(map(int, g.flatten()))\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            return int(col)\n    return None\n\ndef _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:\n    g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)\n    g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)\n\ndef _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:\n    (r0a, c0a, r1a, c1a) = map(int, fa[\"bbox\"])\n    (r0b, c0b, r1b, c1b) = map(int, fb[\"bbox\"])\n    ia = fa[\"inner_bbox\"]\n    ib = fb[\"inner_bbox\"]\n    # same-row band\n    if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):\n        rr0, rr1 = int(ia[0]), int(ia[2])\n        if int(c1a) < int(c0b):\n            cc0, cc1 = int(c1a + 1), int(c0b - 1)\n        else:\n            cc0, cc1 = int(c1b + 1), int(c0a - 1)\n        assert int(cc0) <= int(cc1), \"horizontal bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    # same-col band\n    if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):\n        cc0, cc1 = int(ia[1]), int(ia[3])\n        if int(r1a) < int(r0b):\n            rr0, rr1 = int(r1a + 1), int(r0b - 1)\n        else:\n            rr0, rr1 = int(r1b + 1), int(r0a - 1)\n        assert int(rr0) <= int(rr1), \"vertical bridge gap must be non-empty\"\n        return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}\n    return set()\n\n_DIGITS = [int(i) for i in range(10)]\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- colors ---\n    bg = int(np.random.choice(np.array(_DIGITS, dtype=int)))\n    border = int(np.random.choice(np.array([d for d in _DIGITS if int(d) != int(bg)], dtype=int)))\n    inner_palette = [int(d) for d in _DIGITS if int(d) not in (int(bg), int(border))]\n    if len(inner_palette) < 3:\n        return None\n\n    # --- geometry ---\n    t = int(np.random.choice(np.array([1, 1, 2], dtype=int)))\n    inner = int(np.random.randint(1, 4))  # 1..3\n    outer = int(inner + 2 * t)\n    if not (3 <= int(outer) <= 7):\n        return None\n\n    # lattice dims and number of squares (all on the path)\n    R = int(np.random.randint(2, 6))\n    C = int(np.random.randint(2, 6))\n    max_frames = int(R * C)\n    if max_frames < 4:\n        return None\n    n_frames = int(np.random.randint(4, int(min(12, max_frames)) + 1))\n\n    # sample a self-avoiding path of length n_frames starting at (0,0)\n    path: list[tuple[int, int]] | None = None\n    for _path_try in range(400):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\n\ndef _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    return bool(\n        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\n\ndef _gen_axis_options(n_slots, slot_min, slot_max):\n    options = []\n\n    def rec_slots(i, cur):\n        if i == n_slots:\n            rec_seps(0, [], cur)\n            return\n        for size in range(slot_min, slot_max + 1):\n            rec_slots(i + 1, cur + [size])\n\n    def rec_seps(i, cur, slots):\n        if i == n_slots - 1:\n            for before in AXIS_OUTER_OPTIONS:\n                for after in AXIS_OUTER_OPTIONS:\n                    for pad_before in AXIS_PADDING_OPTIONS:\n                        for pad_after in AXIS_PADDING_OPTIONS:\n                            total = (\n                                before\n                                + after\n                                + pad_before\n                                + pad_after\n                                + sum(slots)\n                                + sum(cur)\n                            )\n                            if 13 <= total <= 19:\n                                options.append(\n                                    (\n                                        tuple(slots),\n                                        tuple(cur),\n                                        before,\n                                        after,\n                                        pad_before,\n                                        pad_after,\n                                        total,\n                                )\n                            )\n            return\n        for sep in AXIS_SEPARATOR_OPTIONS:\n            rec_seps(i + 1, cur + [sep], slots)\n\n    rec_slots(0, [])\n    return options\n\n\ndef _gen_positions(axis):\n    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis\n    starts = []\n    pos = outer_before + pad_before\n    for i, size in enumerate(sizes):\n        starts.append(pos)\n        pos += size\n        if i < len(seps):\n            pos += seps[i]\n    return starts\n\n\ndef _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):\n    options = _gen_axis_options(n_slots, slot_min, slot_max)\n    if other_axis is None:\n        return random.choice(options)\n\n    good = []\n    for axis in options:\n        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis\n        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis\n        height = row_axis[-1]\n        width = col_axis[-1]\n        frame_height = height - row_axis[2] - row_axis[3]\n        frame_width = width - col_axis[2] - col_axis[3]\n        slot_area = sum(row_axis[0]) * sum(col_axis[0])\n        outer_bg = height * width - frame_height * frame_width\n        bg_room = outer_bg + slot_area - max_object_loss\n        frame_area = frame_height * frame_width - slot_area\n        if bg_room > frame_area:\n            good.append(axis)\n    return random.choice(good or options)\n\n\ndef _gen_assign_colors(shape, bg, frame):\n    n_slots = shape[0] * shape[1]\n    filled_count = random.randint(1, n_slots - 1)\n    filled = random.sample(range(n_slots), filled_count)\n    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]\n    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))\n    palette = random.sample(colors, n_colors)\n    assignments = palette[:]\n    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))\n    random.shuffle(assignments)\n\n    out = np.full(shape, bg, dtype=int)\n    for idx, color in zip(filled, assignments):\n        out[idx // shape[1], idx % shape[1]] = color\n    return out, filled_count\n\n\ndef _gen_object_shape(slot_h, slot_w):\n    by_area = {}\n    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):\n        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):\n            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))\n    area = random.choice(list(by_area))\n    return random.choice(by_area[area])\n\n\ndef _gen_choose_layout(rows, cols, filled_count):\n    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)\n    loss = MAX_OBJECT_AREA * filled_count\n    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)\n    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)\n\n\ndef _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):\n    height = row_axis[-1]\n    width = col_axis[-1]\n    grid = np.full((height, width), bg, dtype=int)\n    rt, rb = row_axis[2], row_axis[3]\n    cl, cr = col_axis[2], col_axis[3]\n    grid[rt : height - rb, cl : width - cr] = frame\n\n    for r, slot_h in zip(row_starts, row_axis[0]):\n        for c, slot_w in zip(col_starts, col_axis[0]):\n            grid[r : r + slot_h, c : c + slot_w] = bg\n    return grid\n\n\ndef _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):\n    for out_r, slot_r in enumerate(row_starts):\n        slot_h = row_axis[0][out_r]\n        for out_c, slot_c in enumerate(col_starts):\n            color = int(out[out_r, out_c])\n            if color == bg:\n                continue\n            slot_w = col_axis[0][out_c]\n            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)\n            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)\n            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)\n            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color\n\n\ndef _gen_is_valid(grid, out, bg, frame):\n    counts = np.bincount(grid.ravel(), minlength=N_COLORS)\n    if int(np.argmax(counts)) != bg:\n        return False\n    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):\n        return False\n    try:\n        actual = main(grid)\n    except Exception:\n        return False\n    return bool(np.array_equal(actual, out))\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rows = random.randint(*TABLE_ROWS_RANGE)\n    cols = random.randint(*TABLE_COLS_RANGE)\n    bg, frame = random.sample(range(N_COLORS), 2)\n\n    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)\n    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)\n    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)\n    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)\n\n    if _gen_is_valid(grid, out, bg, frame):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n","exit_code":0,"status":"completed"}}
