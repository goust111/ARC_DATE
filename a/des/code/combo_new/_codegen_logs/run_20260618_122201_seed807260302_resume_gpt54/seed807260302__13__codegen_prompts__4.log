ttempts\")\n-----\n===== /home/lixinyu/snap/new/ARC_code/eval/2ba387bc.py =====\n   5: def main(grid: np.ndarray) -> np.ndarray:\n   6:     \"\"\"\n   7:     Sort scattered 4×4 squares into two columns by type: frames left, solids right.\n   8: \n   9:     Input structure:\n  10:     - bg = most common color. Multiple 4×4 objects on bg.\n  11:     - Frames: colored 1px border, bg-filled 2×2 interior.\n  12:     - Solids: entirely filled with one non-bg color.\n  13: \n  14:     Rule:\n  15:     - Classify each 4×4 object as frame or solid by its interior.\n  16:     - Sort each group top-to-bottom by input row.\n  17:     - Stack frames in left column (cols 0–3), solids in right (cols 4–7).\n  18:     - Output is 8 wide; height = 4 × max(#frames, #solids), bg-padded.\n  19: \n  20:     Key insight: Frame vs solid is determined solely by whether the 2×2 interior matches bg.\n  21:     \"\"\"\n  22:     g = np.array(grid, dtype=int)\n  23:     bg = int(get_bg(g))\n  24: \n  25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n  26:     frames: list[tuple[int, int, np.ndarray]] = []\n  27:     solids: list[tuple[int, int, np.ndarray]] = []\n  28: \n  29:     for comp in comps:\n  30:         b = comp[\"bbox\"]\n  31:         if bbox_h(b) != 4 or bbox_w(b) != 4:\n  32:             continue\n  33:         r0, c0, _r1, _c1 = b\n  34:         sub = crop_bbox(g, b)\n  35: \n  36:         border = np.concatenate([sub[0, :], sub[-1, :], sub[1:-1, 0], sub[1:-1, -1]])\n  37:         bcols = set(map(int, border.flatten()))\n  38: \n  39:         if len(bcols) == 1 and bool((sub[1:3, 1:3] == int(bg)).all()):\n  40:             frames.append((int(r0), int(c0), sub))\n  41:         else:\n  42:             solids.append((int(r0), int(c0), sub))\n  43: \n  44:     frames.sort(key=lambda t: (int(t[0]), int(t[1])))\n  45:     solids.sort(key=lambda t: (int(t[0]), int(t[1])))\n  46: \n  47:     outH = 4 * max(int(len(frames)), int(len(