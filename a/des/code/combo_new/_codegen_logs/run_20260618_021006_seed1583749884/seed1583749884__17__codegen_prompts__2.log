{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '41,120p' /home/lixinyu/snap/new/ARC_code/train/9f5f939b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark the missing center of each plus-shaped arrangement of four two-pixel bars with yellow.\n\n    Input structure:\n    - The background is the dominant color.\n    - The single foreground color forms isolated 4-connected objects, each a horizontal or vertical two-pixel bar.\n    - Some bars form an implied plus sign: two horizontal bars and two vertical bars around an empty center, with a one-pixel gap between the center and each bar.\n\n    Rule:\n    - Keep the input unchanged except at implied plus-sign centers.\n    - For every background pixel with foreground bars at offsets 2-3 cells left, right, above, and below, recolor that center yellow.\n    - The one-pixel gaps immediately next to the center in the four cardinal directions must remain background.\n\n    Key insight:\n    - The yellow pixels are not extending a line; they identify the shared missing center where four separated two-pixel bars align as a plus sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = g.shape\n    assert height >= 7 and width >= 7, \"grid must be large enough for the plus motif\"\n\n    bg = get_bg(g)\n    foreground = colors_present(g, exclude={bg})\n    assert len(foreground) == 1, \"expected exactly one foreground color\"\n    fg = int(foreground[0])\n    assert bg != Color.YELLOW and fg != Color.YELLOW, \"yellow is reserved for output markers\"\n    _assert_two_cell_bars(g, bg, fg)\n\n    centers = [\n        (r, c)\n        for r in range(3, height - 3)\n        for c in range(3, width - 3)\n        if _is_cross_center(g, r, c, bg, fg)\n    ]\n    assert centers, \"expected at least one missing plus center\"\n\n    out = g.copy()\n    for r, c in centers:\n        out[r, c] = Color.YELLOW\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color bounds.\nGRID_SIZE_MIN = 8\nGRID_SIZE_MAX_EXCLUSIVE = 21\nBACKGROUND_COLOR = 8\nFOREGROUND_COLOR = 1\n\n# Plus motif placement.\nPLUS_COUNT_MIN = 1\nPLUS_COUNT_MAX_EXCLUSIVE = 5\nCENTER_MARGIN = 3\nCENTER_TRIES = 100\n\n# Distractor bar placement.\nDISTRACTOR_RATIO_MIN = 0.2\nDISTRACTOR_RATIO_MAX = 0.6\nDISTRACTOR_RETRY_MULTIPLIER = 20\nNEW_PLUS_SCAN_RADIUS = 3\n\n# Overall generation retries.\nGENERATION_ATTEMPTS = 300\nNEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _offset_cells(r: int, c: int, offsets: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:\n    return [(r + dr, c + dc) for dr, dc in offsets]\n\n\ndef _all_cells_bg(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:\n    height, width = grid.shape\n    for r, c in cells:\n        if r < 0 or r >= height or c < 0 or c >= width:\n            return False\n        if grid[r, c] != bg:\n            return False\n    return True\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '119,210p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n","exit_code":0,"status":"completed"}}
