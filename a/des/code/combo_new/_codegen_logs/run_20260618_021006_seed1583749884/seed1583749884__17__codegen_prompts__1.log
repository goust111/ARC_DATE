{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '560,760p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"    except Exception:\n        return False\n    # Non-yellow, non-bg cells must be identical.\n    struct_mask = (input_grid != 4) & (input_grid != 0)\n    if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):\n        return False\n    # Yellow count must be preserved.\n    if (solver_out == 4).sum() != (input_grid == 4).sum():\n        return False\n    # All output yellows must lie inside known region interiors.\n    regions_mask = np.zeros((h, w), dtype=bool)\n    for reg in regions:\n        for r, c in reg['interior']:\n            regions_mask[r, c] = True\n    return bool(np.all(regions_mask[solver_out == 4]))\n\n\n# ── Main generator ────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h, w = GRID_H, GRID_W\n    grid = np.zeros((h, w), dtype=int)\n\n    legend_occupied, legends = _place_legends(rng, grid)\n    regions = _grow_regions(rng, legends, legend_occupied)\n    if regions is None:\n        return None\n\n    # Paint walls.\n    for reg in regions:\n        for r, c in reg['walls']:\n            grid[r, c] = reg['color']\n\n    if not _validate_topology(grid, regions):\n        return None\n\n    input_grid = grid.copy()\n    if not _place_yellows(rng, regions, input_grid):\n        return None\n    if not _oracle_check(input_grid, regions):\n        return None\n    return input_grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,420p' /home/lixinyu/snap/new/ARC_code/eval/247ef758.py\"","aggregated_output":"    for r in range(1, H - 1):\n        val = frame_base\n        for mc, (rmarks, _) in mover_targets.items():\n            if r in rmarks:\n                val = mc\n                break\n        inp[r, fc0] = val\n        inp[r, fc1] = val\n\n    # Stack sprites in left strip: movers top-to-bottom, then distractors\n    cur_row = 0\n    all_items: list[tuple[int, np.ndarray, bool]] = [\n        (mc, sp, False) for mc, sp in zip(mover_colors, sprites)\n    ]\n    for dc_color in distractor_colors:\n        ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)\n        if ds is None:\n            return None\n        all_items.append((dc_color, ds, True))\n\n    for mc, sp, _ in all_items:\n        sh, sw = sp.shape\n        if sw > sprite_area_w or cur_row + sh > H:\n            return None\n        c_off = random.randint(0, sprite_area_w - sw)\n        for dr in range(sh):\n            for dc in range(sw):\n                if sp[dr, dc] != bg:\n                    inp[cur_row + dr, c_off + dc] = sp[dr, dc]\n        cur_row += sh\n\n    # Validate: bg must be most common color so solver detects it correctly\n    vals, counts = np.unique(inp, return_counts=True)\n    if int(vals[np.argmax(counts)]) != bg:\n        return None\n\n    # Run solver and verify output differs from input (movers actually moved)\n    try:\n        output = main(inp)\n    except Exception:\n        return None\n    if np.array_equal(inp, output):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/6e4f6532.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import get_bg, paste\nimport random\n\ndef apply_transform(arr: np.ndarray, flip_ud: bool = False, rot_k: int = 0) -> np.ndarray:\n    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n    out = np.flipud(arr) if flip_ud else arr\n    return np.rot90(out, int(rot_k))\n\n\ndef transform_coords(coords, shape, flip_ud: bool = False, rot_k: int = 0):\n    \"\"\"Positional-args helper (kept local; only used by this solver).\"\"\"\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in coords:\n        mask[int(r), int(c)] = True\n    out = apply_transform(mask, flip_ud=flip_ud, rot_k=rot_k)\n    return set(map(tuple, np.argwhere(out)))\n\n\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Dock train sprites onto station groups by matching coupler count, then orient via divider-color markers.\n\n    Input structure:\n    - bg; colored stripes (edge + internal) partition grid into rectangular regions.\n    - Color 8 forms train bodies; color 9 marks both isolated stations and train-attached couplers.\n    - Stripe-colored pixels on trains are orientation markers.\n\n    Rule:\n    - Stations = 8-connected 9-clusters not adjacent to any 8. Trains = components containing 8.\n    - Match train to station group where |couplers| == |station size|.\n    - Rotate/flip train so marker pixels face the same-color boundary stripe of the target region.\n    - Translate so couplers align exactly onto station cells; erase original position.\n\n    Key insight: Coupler count selects the docking target; marker color encodes which boundary stripe to face, fixing the unique orientation.\n    \"\"\"\n    inp = grid\n    grid = inp.copy()\n    H, W = grid.shape\n    bg = get_bg(grid)\n\n    # This puzzle's code is long because it reconstructs several \"structures\"\n    # that are implicit in the grid:\n    # - divider stripes (edge + internal) that partition the canvas into regions\n    # - station groups = 9-clusters not adjacent to any 8\n    # - train sprites = components containing 8 (with attached 9 \"couplers\")\n    # Then, for each train:\n    # - match target region by COUPLER COUNT (|couplers| == |station group|)\n    # - choose orientation by divider-color markers (face region boundary stripes)\n    # - translate so couplers land exactly onto the station group cells\n\n    def find_edge_stripes():\n        # Detect thick constant-color border stripes.\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Top edge\n        top_h = 0\n        for r in range(H):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                top_h += 1\n            else:\n                break\n        if top_h:\n            stripe[:top_h, :] = True\n            colors.add(int(grid[0, 0]))\n        # Bottom edge\n        bot_h = 0\n        for r in range(H - 1, -1, -1):\n            row = grid[r, :]\n            if (row == row[0]).all() and row[0] != bg:\n                bot_h += 1\n            else:\n                break\n        if bot_h:\n            stripe[H - bot_h :, :] = True\n            colors.add(int(grid[H - 1, 0]))\n        inner_r0, inner_r1 = top_h, H - bot_h\n        # Left edge (in inner rows)\n        left_w = 0\n        for c in range(W):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                left_w += 1\n            else:\n                break\n        if left_w:\n            stripe[inner_r0:inner_r1, :left_w] = True\n            colors.add(int(grid[inner_r0, 0]))\n        # Right edge\n        right_w = 0\n        for c in range(W - 1, -1, -1):\n            col = grid[inner_r0:inner_r1, c]\n            if col.size == 0:\n                break\n            if (col == col[0]).all() and col[0] != bg:\n                right_w += 1\n            else:\n                break\n        if right_w:\n            stripe[inner_r0:inner_r1, W - right_w :] = True\n            colors.add(int(grid[inner_r0, W - 1]))\n        return stripe, colors, (top_h, bot_h, left_w, right_w)\n\n    def find_internal_stripes(edge_info):\n        # Detect internal constant-color stripes in the inner rectangle.\n        top_h, bot_h, left_w, right_w = edge_info\n        r0, r1, c0, c1 = top_h, H - bot_h, left_w, W - right_w\n        stripe = np.zeros((H, W), dtype=bool)\n        colors = set()\n        # Vertical internal stripes\n        c = c0\n        while c < c1:\n            col = grid[r0:r1, c]\n            if col.size and (col == col[0]).all() and col[0] != bg:\n                color = int(col[0])\n                c2 = c\n                while c2 + 1 < c1:\n                    col2 = grid[r0:r1, c2 + 1]\n                    if col2.size and (col2 == col2[0]).all() and int(col2[0]) == color:\n                        c2 += 1\n                    else:\n                        break\n                stripe[r0:r1, c : c2 + 1] = True\n                colors.add(color)\n                c = c2 + 1\n            else:\n                c += 1\n        # Horizontal internal stripes\n        r = r0\n        while r < r1:\n            row = grid[r, c0:c1]\n            if row.size and (row == row[0]).all() and row[0] != bg:\n                color = int(row[0])\n                r2 = r\n                while r2 + 1 < r1:\n                    row2 = grid[r2 + 1, c0:c1]\n                    if row2.size and (row2 == row2[0]).all() and int(row2[0]) == color:\n                        r2 += 1\n                    else:\n                        break\n                stripe[r : r2 + 1, c0:c1] = True\n                colors.add(color)\n                r = r2 + 1\n            else:\n                r += 1\n        return stripe, colors\n\n    def station_groups():\n        # Stations are 9 pixels with no adjacent 8 in the 8-neighborhood.\n        # Station groups are 8-connected components of those station pixels.\n        # Station 9s have no adjacent 8 in 8-neighborhood\n        sm = np.zeros((H, W), dtype=bool)\n        for r in range(H):\n            for c in range(W):\n                if grid[r, c] != 9:\n                    continue\n                ok = all(grid[r+dr, c+dc] != 8\n                        for dr in (-1, 0, 1) for dc in (-1, 0, 1)\n                        if (dr != 0 or dc != 0) and 0 <= r+dr < H and 0 <= c+dc < W)\n                if ok:\n                    sm[r, c] = True\n        # 8-connected clustering\n        struct = np.ones((3, 3), dtype=int)\n        lab, n = label(sm, structure=struct)\n        groups = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            groups.append([(int(r), int(c)) for r, c in coords])\n        return groups\n\n    def regions_from_stripes(stripe_mask):\n        # Regions are connected components of all non-stripe cells.\n        non = ~stripe_mask\n        lab, n = label(non)\n        regs = []\n        for k in range(1, n + 1):\n            coords = np.argwhere(lab == k)\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if (r1 - r0 + 1) >= 5 and (c1 - c0 + 1) >= 5:\n                regs.append({\"r0\": int(r0), \"r1\": int(r1), \"c0\": int(c0), \"c1\": int(c1)})\n        return regs\n\n    def boundary_dirs_for_region(reg, stripe_colors):\n        # For a region bbox, infer which stripe color borders each side.\n        # Returns map: stripe_color -> direction (0=up,1=right,2=down,3=left)\n        # Map stripe color -> direction (0=up, 1=right, 2=down, 3=left)\n        dirs = {}\n        r0, r1, c0, c1 = reg[\"r0\"], reg[\"r1\"], reg[\"c0\"], reg[\"c1\"]\n        if r0 - 1 >= 0:\n            mc = Counter(grid[r0 - 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 0\n        if r1 + 1 < H:\n            mc = Counter(grid[r1 + 1, c0:c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 2\n        if c0 - 1 >= 0:\n            mc = Counter(grid[r0:r1 + 1, c0 - 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 3\n        if c1 + 1 < W:\n            mc = Counter(grid[r0:r1 + 1, c1 + 1].tolist()).most_common(1)[0][0]\n            if mc in stripe_colors:\n                dirs[int(mc)] = 1\n        return dirs\n\n    def xform_coords(coords, shape, flip_ud, rot_k):\n        \"\"\"Transform coords, return (list, new_shape).\"\"\"\n        result = transform_coords(coords, shape, flip_ud, rot_k)\n        new_shape = apply_transform(np.zeros(shape), flip_ud, rot_k).shape\n        return list(result), new_shape\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n","exit_code":0,"status":"completed"}}
