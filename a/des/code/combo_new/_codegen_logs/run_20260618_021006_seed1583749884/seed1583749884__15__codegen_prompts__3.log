{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n\ndef _solid_separator_cross(g: np.ndarray, bg: int) -> tuple[int, int]:\n    height, width = g.shape\n    solid_rows = [r for r in range(height) if np.all(g[r, :] == bg)]\n    solid_cols = [c for c in range(width) if np.all(g[:, c] == bg)]\n    assert len(solid_rows) == 1, \"expected exactly one solid background separator row\"\n    assert len(solid_cols) == 1, \"expected exactly one solid background separator column\"\n    return solid_rows[0], solid_cols[0]\n\n\ndef _quadrants(cross_row: int, cross_col: int, height: int, width: int) -> list[tuple[slice, slice]]:\n    top_h = cross_row\n    bottom_h = height - cross_row - 1\n    left_w = cross_col\n    right_w = width - cross_col - 1\n    assert top_h > 0 and left_w > 0, \"separator must leave nonempty corner regions\"\n    assert top_h == bottom_h, \"separator row must split equal-height regions\"\n    assert left_w == right_w, \"separator column must split equal-width regions\"\n\n    return [\n        (slice(0, cross_row), slice(0, cross_col)),\n        (slice(0, cross_row), slice(cross_col + 1, width)),\n        (slice(cross_row + 1, height), slice(0, cross_col)),\n        (slice(cross_row + 1, height), slice(cross_col + 1, width)),\n    ]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/25e02866.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/25e02866.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location\nimport itertools\nimport math\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Merge same-sized filled rectangular objects by overlaying their internal marker pixels.\n\n    Input structure:\n    - A dominant background surrounds two or more separated 4-connected foreground objects.\n    - Every object is a filled rectangle of the same size.\n    - Each rectangle has the same majority base color plus one or more non-base marker pixels.\n\n    Rule:\n    - Create one output rectangle with the shared object size, filled with the shared base color.\n    - For each input rectangle, copy every non-base marker pixel to the same relative location\n      in the output.\n    - Marker overlays must either land on base color or agree in color with an existing marker.\n\n    Key insight:\n    The separated rectangles are layers of the same template; their colored marker pixels\n    combine by local coordinates while the repeated base fill is just the output canvas.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    objects: list[tuple[np.ndarray, int]] = []\n    for coords in components_mask(g != bg, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        patch = crop_bbox(g, (r0, c0, r1, c1))\n        assert np.all(patch != bg)\n\n        counts = Counter(map(int, patch.ravel()))\n        ranked = counts.most_common()\n        assert len(ranked) >= 2\n        assert ranked[0][1] > ranked[1][1]\n        objects.append((patch, int(ranked[0][0])))\n\n    assert len(objects) >= 2\n\n    shapes = {patch.shape for patch, _base in objects}\n    assert len(shapes) == 1\n\n    bases = {base for _patch, base in objects}\n    assert len(bases) == 1\n    base = next(iter(bases))\n\n    h, w = next(iter(shapes))\n    out = np.full((h, w), int(base), dtype=int)\n\n    has_marker = False\n    for patch, _base in objects:\n        marker_mask = patch != int(base)\n        has_marker = has_marker or bool(marker_mask.any())\n        rows, cols = np.where(marker_mask)\n        for r, c in zip(rows, cols):\n            value = int(patch[int(r), int(c)])\n            assert int(out[int(r), int(c)]) in {int(base), value}\n            out[int(r), int(c)] = value\n\n    assert has_marker\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas/object bounds.\nRECT_SIDE_OPTIONS = (4, 5, 6)\nRECT_COUNT_OPTIONS = (2, 3, 4)\nGRID_SIDE_OPTIONS = tuple(range(14, 19))\n\n# Palette and marker construction.\nPALETTE = range(10)\nNON_MARKER_COLOR_COUNT = 2\nMIN_BLOB_SIZE = 1\nMAX_BLOB_SIZE = 4\nINTERIOR_MARGIN = 1\nMIN_MARKER_COVERAGE = 0.25\nMAX_MARKER_COVERAGE = 0.32\nFALLBACK_MARKER_COVERAGE = 0.22\nMARKER_CONNECTIVITY = 4\n\n# Placement and retry controls.\nPLACEMENT_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_PADDING_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _is_connected(cells: tuple[tuple[int, int], ...], side: int) -> bool:\n    mask = np.zeros((side, side), dtype=bool)\n    for r, c in cells:\n        mask[r, c] = True\n    return len(components_mask(mask, connectivity=MARKER_CONNECTIVITY)) == 1\n\n\ndef _blob_candidates(side: int, size: int, taken: set[tuple[int, int]]) -> list[tuple[tuple[int, int], ...]]:\n    interior = [\n        (r, c)\n        for r in range(INTERIOR_MARGIN, side - INTERIOR_MARGIN)\n        for c in range(INTERIOR_MARGIN, side - INTERIOR_MARGIN)\n        if (r, c) not in taken\n    ]\n    return [\n        combo\n        for combo in itertools.combinations(interior, size)\n        if _is_connected(combo, side)\n    ]\n\n\ndef _choose_blob_sizes(count: int, side: int) -> list[int]:\n    area = side * side\n    interior_side = side - 2 * INTERIOR_MARGIN\n    max_total = min(MAX_BLOB_SIZE * count, interior_side * interior_side)\n    low = max(count, math.ceil(MIN_MARKER_COVERAGE * area))\n    high = min(max_total, math.floor(MAX_MARKER_COVERAGE * area))\n    if low > high:\n        low = max(count, min(max_total, round(FALLBACK_MARKER_COVERAGE * area)))\n        high = max_total\n\n    total = random.randint(low, high)\n    sizes = [MIN_BLOB_SIZE] * count\n    remaining = total - count\n    while remaining:\n        choices = [i for i, size in enumerate(sizes) if size < MAX_BLOB_SIZE]\n        i = random.choice(choices)\n        sizes[i] += 1\n        remaining -= 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _make_layers(side: int, base: int, marker_colors: list[int]):\n    output = np.full((side, side), base, dtype=int)\n    sizes = _choose_blob_sizes(len(marker_colors), side)\n    blobs: list[tuple[tuple[int, int], ...] | None] = [None] * len(marker_colors)\n    taken: set[tuple[int, int]] = set()\n\n    order = sorted(range(len(marker_colors)), key=lambda i: (-sizes[i], random.random()))\n    for i in order:\n        candidates = _blob_candidates(side, sizes[i], taken)\n        if not candidates:\n            return None\n        blob = random.choice(candidates)\n        blobs[i] = blob\n        taken.update(blob)\n\n    layers = []\n    for color, blob in zip(marker_colors, blobs):\n        if blob is None:\n            return None\n        layer = np.full((side, side), base, dtype=int)\n        for r, c in blob:\n            layer[r, c] = color\n            output[r, c] = color\n        layers.append(layer)\n    return output, layers, len(taken)\n\n\ndef _grid_size(side: int, count: int, marker_total: int) -> int | None:\n    area = side * side\n    feasible = [\n        s\n        for s in GRID_SIDE_OPTIONS\n        if s * s - count * area > count * area - marker_total\n    ]\n    if not feasible:\n        return None\n    return random.choice(feasible)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    side = random.choice(RECT_SIDE_OPTIONS)\n    count = random.choice(RECT_COUNT_OPTIONS)\n    colors = random.sample(PALETTE, count + NON_MARKER_COLOR_COUNT)\n    bg, base = colors[0], colors[1]\n    marker_colors = colors[2:]\n\n    made = _make_layers(side, base, marker_colors)\n    if made is None:\n        return None\n    expected, layers, marker_total = made\n\n    grid_side = _grid_size(side, count, marker_total)\n    if grid_side is None:\n        return None\n\n    grid = np.full((grid_side, grid_side), bg, dtype=int)\n    random.shuffle(layers)\n    try:\n        for layer in layers:\n            r, c = random_free_location(\n                grid,\n                layer,\n                transparent=bg,\n                border=PLACEMENT_BORDER,\n                padding=PLACEMENT_PADDING,\n                padding_connectivity=PLACEMENT_PADDING_CONNECTIVITY,\n            )\n            paste(grid, layer, r, c)\n        actual = main(grid)\n    except (AssertionError, ValueError):\n        return None\n\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 25e02866 input\")\n","exit_code":0,"status":"completed"}}
