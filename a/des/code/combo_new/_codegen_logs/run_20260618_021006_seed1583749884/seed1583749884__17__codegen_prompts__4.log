t]]) -> tuple[int, int, int, int]:\n    51\t    rows = [r for r, _ in coords]\n    52\t    cols = [c for _, c in coords]\n    53\t    return min(rows), min(cols), max(rows), max(cols)\n    54\t\n    55\t\n    56\tdef _mask_in_bbox(coords: list[tuple[int, int]]) -> np.ndarray:\n    57\t    r0, c0, r1, c1 = _bbox(coords)\n    58\t    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    59\t    for r, c in coords:\n    60\t        mask[r - r0, c - c0] = True\n    61\t    return mask\n    62\t\n    63\t\n    64\tdef _is_connected(mask: np.ndarray) -> bool:\n    65\t    comps = _find_components(mask)\n    66\t    return len(comps) == 1\n    67\t\n    68\t\n    69\tdef _is_tiled_copy(candidate_mask: np.ndarray, primitive_mask: np.ndarray) -> bool:\n    70\t    ph, pw = primitive_mask.shape\n    71\t    ch, cw = candidate_mask.shape\n    72\t    if ch % ph != 0 or cw % pw != 0:\n    73\t        return False\n    74\t    tiled = np.tile(primitive_mask, (ch // ph, cw // pw))\n    75\t    return np.array_equal(candidate_mask, tiled)\n    76\t\n    77\t\n    78\tdef main(grid: np.ndarray) -> np.ndarray:\n    79\t    \"\"\"\n    80\t    Keep only grey objects whose shape is an exact gapless tiling of the red primitive.\n    81\t\n    82\t    Input structure:\n    83\t    - The background is black.\n    84\t    - There is exactly one small red foreground object that serves as the primitive tile.\n    85\t    - There are several separate grey foreground objects elsewhere on the grid.\n    86\t\n    87\t    Rule:\n    88\t    - Extract the red primitive's tight bounding-box mask.\n    89\t    - For each grey object, extract its tight mask and test whether it is exactly the\n    90\t      red mask repeated an integer number of times vertically and horizontally with no gaps.\n    91\t    - If the grey object is such a tiling, recolor it green; otherwise erase it to black.\n    92\t      Keep the red primitive unchanged.\n    93\t\n    94\t    Key insight:\n    95\t    - The red object defines a reusable shape unit; surviving grey objects are precisely\n    96\t      the ones whose masks factor into a rectangular grid of identical primitive copies.\n    97\t    \"\"\"\n    98\t    g = np.asarray(grid, dtype=int)\n    99\t    assert g.ndim == 2, \"expected a 2D grid\"\n   100\t\n   101\t    red_components = _find_components(g == RED)\n   102\t    assert len(red_components) == 1, \"expected exactly one red primitive\"\n   103\t    primitive_mask = _mask_in_bbox(red_components[0])\n   104\t\n   105\t    out = g.copy()\n   106\t    for component in _find_components(g == GRAY):\n   107\t        component_mask = _mask_in_bbox(component)\n   108\t        color = GREEN if _is_tiled_copy(component_mask, primitive_mask) else BLACK\n   109\t        for r, c in component:\n   110\t            out[r, c] = color\n   111\t    return out\n   112\t\n   113\t\n   114\tdef _random_path(start: tuple[int, int], end: tuple[int, int], rng: np.random.Generator) -> list[tuple[int, int]]:\n   115\t    path = [start]\n   116\t    r, c = start\n   117\t    tr, tc = end\n   118\t    while (r, c) != (tr, tc):\n   119\t        options: list[tuple[int, int]] = []\n   120\t        if r < tr:\n   121\t            options.append((r + 1, c))\n   122\t        elif r > tr:\n   123\t            options.append((r - 1, c))\n   124\t        if c < tc:\n   125\t            options.append((r, c + 1))\n   126\t        elif c > tc:\n   127\t            options.append((r, c - 1))\n   128\t        r, c = options[int(rng.integers(len(options)))]\n   129\t        path.append((r, c))\n   130\t    return path\n   131\t\n   132\t\n   133\tdef _frontier(mask: np.ndarray) -> list[tuple[int, int]]:\n   134\t    h, w = mask.shape\n   135\t    cells: list[tuple[int, int]] = []\n   136\t    for r in range(h):\n   137\t        for c in range(w):\n   138\t            if bool(mask[r, c]):\n   139\t                continue\n   140\t            for dr, dc in DIR4:\n   141\t                nr, nc = r + dr, c + dc\n   142\t                if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]):\n   143\t                    cells.append((r, c))\n   144\t                    break\n   145\t    return cells\n   146\t\n   147\t\n   148\tdef _generate_primitive_mask(rng: np.random.Generator) -> np.ndarray | None:\n   149\t    for _ in range(PRIMITIVE_ATTEMPTS):\n   150\t        h = int(rng.choice(PRIMITIVE_HEIGHTS))\n   151\t        w = int(rng.choice(PRIMITIVE_WIDTHS))\n   152\t        join = (int(rng.integers(h)), int(rng.integers(w)))\n   153\t        seam_row = int(rng.integers(h))\n   154\t        seam_col = int(rng.integers(w))\n   155\t\n   156\t        cells = set(_random_path((seam_row, 0), join, rng))\n   157\t        cells.update(_random_path((seam_row, w - 1), join, rng))\n   158\t        cells.update(_random_path((0, seam_col), join, rng))\n   159\t        cells.update(_random_path((h - 1, seam_col), join, rng))\n   160\t\n   161\t        mask = np.zeros((h, w), dtype=bool)\n   162\t        for r, c in cells:\n   163\t            mask[r, c] = True\n   164\t\n   165\t        max_extra = min(h * w - int(mask.sum()), max(1, (h * w) // 2))\n   166\t        extra = int(rng.integers(max_extra + 1))\n   167\t        for _extra in range(extra):\n   168\t            frontier = _frontier(mask)\n   169\t            if not frontier:\n   170\t                break\n   171\t            r, c = frontier[int(rng.integers(len(frontier)))]\n   172\t            mask[r, c] = True\n   173\t\n   174\t        if not _is_connected(mask):\n   175\t            continue\n   176\t        if int(mask.sum()) < 3:\n   177\t            continue\n   178\t        if int(mask.sum()) == h * w and float(rng.random()) < 0.7:\n   179\t            continue\n   180\t        return mask\n   181\t    return None\n   182\t\n   183\t\n   184\tdef _repeat_options(primitive_mask: np.ndarray) -> dict[str, list[tuple[int, int]]]:\n   185\t    ph, pw = primitive_mask.shape\n   186\t    max_r = min(3, MAX_OBJECT_SIDE // ph)\n   187\t    max_c = min(3, MAX_OBJECT_SIDE // pw)\n   188\t    return {\n   189\t        \"horizontal\": [(1, c) for c in range(2, max_c + 1)],\n   190\t        \"vertical\": [(r, 1) for r in range(2, max_r + 1)],\n   191\t        \"both\": [(r, c) for r in range(2, max_r + 1) for c in range(2, max_c + 1)],\n   192\t    }\n   193\t\n   194\t\n   195\tdef _sample_valid_repeats(\n   196\t    primitive_mask: np.ndarray, count: int, rng: np.random.Generator\n   197\t) -> list[tuple[int, int]]:\n   198\t    options = _repeat_options(primitive_mask)\n   199\t    kinds = [kind for kind, values in options.items() if values]\n   200\t    chosen_kinds: list[str] = []\n   201\t    while len(chosen_kinds) < count:\n   202\t        unused = [kind for kind in kinds if kind not in chosen_kinds]\n   203\t        pool = unused if unused else kinds\n   204\t        chosen_kinds.append(pool[int(rng.integers(len(pool)))])\n   205\t\n   206\t    repeats: list[tuple[int, int]] = []\n   207\t    for kind in chosen_kinds:\n   208\t        pool = options[kind]\n   209\t        repeats.append(pool[int(rng.integers(len(pool)))])\n   210\t    rng.shuffle(repeats)\n   211\t    return repeats\n   212\t\n   213\t\n   214\tdef _make_invalid_mask(primitive_mask: np.ndarray, rng: np.random.Generator) -> np.ndarray | None:\n   215\t    all_options = []\n   216\t    for values in _repeat_options(primitive_mask).values():\n   217\t        all_options.extend(values)\n   218\t    if not all_options:\n   219\t        return None\n   220\t\n   221\t    for _ in range(INVALID_ATTEMPTS):\n   222\t        reps = all_options[int(rng.integers(len(all_options)))]\n   223\t        mask = np.tile(primitive_mask, reps).copy()\n   224\t        h, w = mask.shape\n   225\t\n   226\t        addable = _frontier(mask)\n   227\t        removable: list[tuple[int, int]] = []\n   228\t        for r in range(h):\n   229\t            for c in range(w):\n   230\t                if not bool(mask[r, c]):\n   231\t                    continue\n   232\t                trial = mask.copy()\n   233\t                trial[r, c] = False\n   234\t                if trial.any() and _is_connected(trial):\n   235\t                    removable.append((r, c))\n   236\t\n   237\t        moves = []\n   238\t        if addable:\n   239\t            moves.append(\"add\")\n   240\t        if removable:\n   241\t            moves.append(\"remove\")\n   242\t        if not moves:\n   243\t            continue\n   244\t\n   245\t        action = moves[int(rng.integers(len(moves)))]\n   246\t        if action == \"add\":\n   247\t            r, c = addable[int(rng.integers(len(addable)))]\n   248\t            mask[r, c] = True\n   249\t        else:\n   250\t            r, c = removable[int(rng.integers(len(removable)))]\n   251\t            mask[r, c] = False\n   252\t\n   253\t        if _is_connected(mask) and not _is_tiled_copy(mask, primitive_mask):\n   254\t            return mask\n   255\t    return None\n   256\t\n   257\t\n   258\tdef _paint_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> None:\n   259\t    patch = grid[top : top + mask.shape[0], left : left + mask.shape[1]]\n   260\t    patch[mask] = color\n","exit_code":0,"status":"completed"}}
