{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/c7f57c3e.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\nimport random\n\n\ndef _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:\n    \"\"\"Pick a stable anchor bbox inside the sprite array (color-1 pixels; always present).\"\"\"\n    if np.any(arr == 1):\n        ys, xs = np.where(arr == 1)\n        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())\n    assert False, \"sprite array has no color-1 pixels and should always have them\"\n\n\ndef _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:\n    if scale <= 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap every sprite to the opposite prototype while preserving scale and position.\n\n    Input structure:\n    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.\n    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.\n\n    Rule:\n    - Identify the two prototype patterns from the smallest-area sprites.\n    - For each sprite, determine which prototype it matches and its integer scale factor.\n    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).\n\n    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=8)\n    assert len(comps) >= 2, \"grid must contain at least 2 sprite components\"\n\n    # Extract sprite records.\n    sprites = []\n    for pts in comps:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        sprites.append({\"pts\": pts, \"bbox\": (r0, c0, r1, c1), \"arr\": arr})\n\n    # Determine two base prototypes from the smallest bbox area sprites.\n    areas = [int((s[\"bbox\"][2] - s[\"bbox\"][0] + 1) * (s[\"bbox\"][3] - s[\"bbox\"][1] + 1)) for s in sprites]\n    min_area = min(areas)\n    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]\n    uniq: dict[tuple[int, ...], np.ndarray] = {}\n    for s in base:\n        key = tuple(s[\"arr\"].ravel().tolist())\n        if key not in uniq:\n            uniq[key] = s[\"arr\"]\n    assert len(uniq) == 2, \"smallest-area sprites must yield exactly 2 distinct prototype patterns\"\n\n    proto_keys = list(uniq.keys())[:2]\n    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]\n\n    anc0 = _pick_anchor_bbox(protos[0], bg)\n    anc1 = _pick_anchor_bbox(protos[1], bg)\n    a0r0, a0c0, a0r1, a0c1 = anc0\n    base_anc_h = a0r1 - a0r0 + 1\n    base_anc_w = a0c1 - a0c0 + 1\n\n    out = g.copy()\n\n    for s in sprites:\n        r0, c0, r1, c1 = s[\"bbox\"]\n        arr = s[\"arr\"]\n        anc = _pick_anchor_bbox(arr, bg)\n        ar0, ac0, ar1, ac1 = anc\n        inst_anc_h = ar1 - ar0 + 1\n        inst_anc_w = ac1 - ac0 + 1\n        # infer integer scale\n        scale_h = max(1, inst_anc_h // max(1, base_anc_h))\n        scale_w = max(1, inst_anc_w // max(1, base_anc_w))\n        scale = int(max(scale_h, scale_w))\n\n        # score which prototype matches this sprite when aligned by core bbox\n        best_idx = 0\n        best_score = -1\n        for idx, p in enumerate(protos):\n            sp = _scale_nn(p, scale)\n            panc = _pick_anchor_bbox(p, bg)\n            pr0, pc0, pr1, pc1 = panc\n            pr0 *= scale\n            pc0 *= scale\n            # align anchor top-left to instance anchor top-left (global coords)\n            top = (r0 + ar0) - pr0\n            left = (c0 + ac0) - pc0\n\n            # overlap score: count matching non-bg pixels where prototype expects non-bg\n            score = 0\n            ph, pw = sp.shape\n            rr0 = max(0, top)\n            cc0 = max(0, left)\n            rr1 = min(h, top + ph)\n            cc1 = min(w, left + pw)\n            if rr0 >= rr1 or cc0 >= cc1:\n                continue\n            sub_g = g[rr0:rr1, cc0:cc1]\n            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n            m = sub_p != bg\n            if np.any(m):\n                score = int(np.sum(sub_g[m] == sub_p[m]))\n            if score > best_score:\n                best_score = score\n                best_idx = idx\n\n        repl_idx = 1 - best_idx\n\n        # Clear current sprite pixels.\n        for rr, cc in s[\"pts\"]:\n            out[rr, cc] = bg\n\n        # Place replacement.\n        p = protos[repl_idx]\n        sp = _scale_nn(p, scale)\n        panc = _pick_anchor_bbox(p, bg)\n        pr0, pc0, pr1, pc1 = panc\n        pr0 *= scale\n        pc0 *= scale\n        top = (r0 + ar0) - pr0\n        left = (c0 + ac0) - pc0\n\n        ph, pw = sp.shape\n        rr0 = max(0, top)\n        cc0 = max(0, left)\n        rr1 = min(h, top + ph)\n        cc1 = min(w, left + pw)\n        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]\n        m = sub_p != bg\n        out_slice = out[rr0:rr1, cc0:cc1]\n        out_slice[m] = sub_p[m]\n        out[rr0:rr1, cc0:cc1] = out_slice\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: canvas ---\nGRID_SIZE_MIN = 18                  # square grid lower bound\nGRID_SIZE_MAX = 28                  # square grid upper bound\nGRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this\n\n# --- CFG: prototypes ---\nPROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid\nBG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)\nCOLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A\n\n# --- CFG: row-mask weights (anchor role vs variable role) ---\n#   each entry: (mask_type, weight)  where mask_type in {\"center\", \"outer\", \"full\"}\nANCHOR_ROW_WEIGHTS = [(\"center\", 0.45), (\"outer\", 0.35), (\"full\", 0.20)]\nVARIABLE_ROW_WEIGHTS = [(\"center\", 0.68), (\"full\", 0.32)]\nOUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full\n\n# --- CFG: sprite instances ---\nSPRITE_COUNTS = [3, 4]             # number of sprite instances per grid\nBIG_SCALES = [2, 3]                # scale factor for the one large sprite\n\n# --- CFG: placement ---\nPLACEMENT_BORDER = 1               # min distance from grid edge\nPLACEMENT_PADDING = 2              # min gap between sprite bboxes\nPLACEMENT_CONNECTIVITY = 8         # connectivity for padding check\n\n# --- CFG: generation retries ---\nMAX_RETRIES = 300\n\n# --- Row-mask patterns indexed by width ---\n_ROW_MASKS = {\n    \"center\": {3: [0, 1, 0], 4: [0, 1, 1, 0]},\n    \"outer\":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},\n    \"full\":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},\n}\n\n\ndef _row_mask(kind: str, w: int) -> list[int]:\n    \"\"\"Return a row occupancy mask of the given kind and width.\"\"\"\n    return list(_ROW_MASKS[kind][w])\n\n\ndef _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:\n    \"\"\"Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1).\"\"\"\n    rs, cs = np.where(arr == 1)\n    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())\n\n\ndef _scale(arr: np.ndarray, k: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor upscale by integer factor k.\"\"\"\n    if k == 1:\n        return arr.copy()\n    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)\n\n\ndef _make_labels() -> np.ndarray:\n    \"\"\"Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0).\"\"\"\n    h, w = random.choice(PROTO_SHAPES)\n\n    # Assign row counts per role (each role gets at least 1 row)\n    counts = {1: 1, 2: 1, 3: 1}\n    if h > 3:\n        counts[random.choice([1, 2, 3])] += h - 3\n    roles = []\n    for role in random.sample([1, 2, 3], 3):\n        roles.extend([role] * counts[role])\n\n    # Pick row masks via weighted sampling\n    weights_by_role = {\n        1: ANCHOR_ROW_WEIGHTS,\n        2: VARIABLE_ROW_WEIGHTS,\n        3: VARIABLE_ROW_WEIGHTS,\n    }\n    masks = []\n    for role in roles:\n        entries = weights_by_role[role]\n        kinds, wts = zip(*entries)\n        chosen_kind = random.choices(kinds, weights=wts)[0]\n        masks.append(_row_mask(chosen_kind, w))\n\n    # Fix-up: ensure at least one row touches the left/right edge\n    if not any(mask[0] or mask[-1] for mask in masks):\n        i = random.randrange(h)\n        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:\n            masks[i] = _row_mask(\"outer\", w)\n        else:\n            masks[i] = _row_mask(\"full\", w)\n\n    # Fix-up: ensure at least one row has bg holes\n    if all(all(mask) for mask in masks):\n        masks[random.randrange(h)] = _row_mask(\"center\", w)\n\n    # Assemble label grid\n    labels = np.zeros((h, w), dtype=int)\n    for r, (role, mask) in enumerate(zip(roles, masks)):\n        for c, bit in enumerate(mask):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/80214e03.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg, paste\nimport itertools\nimport random\n\n\ndef _visible_colors(line: np.ndarray, bg: int) -> frozenset[int]:\n    return frozenset(int(v) for v in line if int(v) != int(bg))\n\n\ndef _axis_bands(g: np.ndarray, axis: int, bg: int) -> list[tuple[int, int]]:\n    signatures: list[tuple[int, frozenset[int]]] = []\n    for idx in range(g.shape[axis]):\n        line = g[idx, :] if axis == 0 else g[:, idx]\n        colors = _visible_colors(line, bg)\n        if colors:\n            signatures.append((int(idx), colors))\n\n    assert signatures, \"expected foreground rows or columns\"\n\n    bands: list[tuple[int, int]] = []\n    start = prev = signatures[0][0]\n    current = signatures[0][1]\n    for idx, colors in signatures[1:]:\n        assert idx == prev + 1, \"foreground rows and columns must be contiguous\"\n        if colors != current:\n            bands.append((start, prev))\n            start = int(idx)\n            current = colors\n        prev = int(idx)\n    bands.append((start, prev))\n    return bands\n\n\ndef _cell_color(g: np.ndarray, rows: tuple[int, int], cols: tuple[int, int], bg: int) -> int:\n    r0, r1 = rows\n    c0, c1 = cols\n    region = g[r0 : r1 + 1, c0 : c1 + 1]\n    colors = np.unique(region[region != int(bg)])\n    assert colors.size == 1, \"each lattice cell must have one foreground color\"\n    return int(colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the color of each noisy block in a row/column lattice and mirror the coarse grid horizontally.\n\n    Input structure:\n    - A background surrounds a rectangular lattice of monochrome foreground blocks.\n    - Consecutive rows in a lattice band share the same set of visible foreground colors.\n    - Consecutive columns in a lattice band share the same set of visible foreground colors.\n    - Each row-band/column-band intersection has one foreground color, with possible background holes.\n\n    Rule:\n    - Group non-empty rows and columns into consecutive bands by their foreground color sets.\n    - Replace each lattice cell by the single foreground color inside that row/column-band intersection.\n    - Return the resulting coarse color grid with the column order reversed.\n\n    Key insight:\n    - Whole-row and whole-column color sets reveal the hidden lattice even when neighboring cells share a color or contain holes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_bands = _axis_bands(g, axis=0, bg=bg)\n    col_bands = _axis_bands(g, axis=1, bg=bg)\n    assert len(row_bands) >= 2 and len(col_bands) >= 2, \"expected a multi-cell block lattice\"\n\n    out = np.empty((len(row_bands), len(col_bands)), dtype=int)\n    for r_idx, row_band in enumerate(row_bands):\n        for c_idx, col_band in enumerate(reversed(col_bands)):\n            out[r_idx, c_idx] = _cell_color(g, row_band, col_band, bg)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Coarse output colors and dimensions.\nROW_BAND_BOUNDS = (2, 4)\nCOL_BAND_BOUNDS = (2, 3)\nCOLOR_VALUES = range(1, 10)\nMIN_DISTINCT_COLORS = 4\nMAX_DISTINCT_COLORS = 8\nADJACENCY_REPAIR_ATTEMPTS = 30\n\n# Expanded lattice dimensions.\nLATTICE_HEIGHT_BOUNDS = (8, 16)\nLATTICE_WIDTH_BOUNDS = (8, 14)\nBAND_HEIGHT_BOUNDS = (3, 8)\nBAND_WIDTH_BOUNDS = (3, 6)\n\n# Canvas, holes, and retry limits.\nCANVAS_HEIGHT_BOUNDS = (18, 22)\nCANVAS_WIDTH_BOUNDS = (11, 19)\nMIN_BG_PADDING = 1\nBG_COLOR = 0\nHOLE_MIN_DENOMINATOR = 20\nHOLE_MAX_DENOMINATOR = 5\nCOLOR_COUNT_BINS = 10\nGENERATION_ATTEMPTS = 300\n\n\ndef _line_color_set(a: np.ndarray, axis: int, idx: int) -> frozenset[int]:\n    line = a[idx, :] if axis == 0 else a[:, idx]\n    return frozenset(map(int, line))\n\n\ndef _adjacent_sets_ok(a: np.ndarray) -> bool:\n    row_sets = [_line_color_set(a, axis=0, idx=r) for r in range(a.shape[0])]\n    col_sets = [_line_color_set(a, axis=1, idx=c) for c in range(a.shape[1])]\n    return all(row_sets[i] != row_sets[i - 1] for i in range(1, len(row_sets))) and all(\n        col_sets[i] != col_sets[i - 1] for i in range(1, len(col_sets))\n    )\n\n\ndef _nudge_line(a: np.ndarray, axis: int, idx: int, avoid: frozenset[int], palette: list[int]) -> None:\n    if axis == 0:\n        coords = [(idx, c) for c in range(a.shape[1])]\n    else:\n        coords = [(r, idx) for r in range(a.shape[0])]\n\n    counts = {color: int(np.count_nonzero(a == color)) for color in palette}\n    eligible = [(r, c) for r, c in coords if counts[int(a[r, c])] > 1]\n    if not eligible:\n        eligible = coords\n\n    outside = [color for color in palette if color not in avoid]\n    r, c = random.choice(eligible)\n    if outside:\n        a[r, c] = random.choice(outside)\n        return\n\n    line_colors = [int(a[rr, cc]) for rr, cc in coords if int(a[rr, cc]) != int(a[r, c])]\n    if line_colors:\n        a[r, c] = random.choice(line_colors)\n\n\ndef _make_output(rows: int, cols: int) -> np.ndarray | None:\n    n_cells = rows * cols\n    n_colors = random.randint(MIN_DISTINCT_COLORS, min(MAX_DISTINCT_COLORS, n_cells))\n    palette = random.sample(COLOR_VALUES, n_colors)\n\n    counts = {color: 1 for color in palette}\n    for _ in range(n_cells - n_colors):\n        fewest = min(counts.values())\n        choices = [color for color, count in counts.items() if count == fewest]\n        counts[random.choice(choices)] += 1\n\n    vals: list[int] = []\n    for color, count in counts.items():\n        vals.extend([color] * count)\n    random.shuffle(vals)\n    out = np.array(vals, dtype=int).reshape(rows, cols)\n\n    for _ in range(ADJACENCY_REPAIR_ATTEMPTS):\n        if _adjacent_sets_ok(out) and len(set(map(int, out.flat))) == n_colors:\n            return out\n        for r in range(1, rows):\n            if _line_color_set(out, axis=0, idx=r) == _line_color_set(out, axis=0, idx=r - 1):\n                _nudge_line(out, axis=0, idx=r, avoid=_line_color_set(out, axis=0, idx=r - 1), palette=palette)\n        for c in range(1, cols):\n            if _line_color_set(out, axis=1, idx=c) == _line_color_set(out, axis=1, idx=c - 1):\n                _nudge_line(out, axis=1, idx=c, avoid=_line_color_set(out, axis=1, idx=c - 1), palette=palette)\n    return None\n\n\ndef _pick_sizes(n: int, total_lo: int, total_hi: int, part_lo: int, part_hi: int) -> list[int]:\n    lo = max(total_lo, n * part_lo)\n    hi = min(total_hi, n * part_hi)\n    total = random.randint(lo, hi)\n    choices = [p for p in itertools.product(range(part_lo, part_hi + 1), repeat=n) if sum(p) == total]\n    return list(random.choice(choices))\n\n\ndef _hole_mask(height: int, width: int) -> np.ndarray | None:\n    area = height * width\n    n_holes = random.randint((area + HOLE_MIN_DENOMINATOR - 1) // HOLE_MIN_DENOMINATOR, area // HOLE_MAX_DENOMINATOR)\n    mask = np.zeros((height, width), dtype=bool)\n    row_left = [width] * height\n    col_left = [height] * width\n    coords = [(r, c) for r in range(height) for c in range(width)]\n    random.shuffle(coords)\n\n    placed = 0\n    for r, c in coords:\n        if placed == n_holes:\n            return mask\n        if row_left[r] > 1 and col_left[c] > 1:\n            mask[r, c] = True\n            row_left[r] -= 1\n            col_left[c] -= 1\n            placed += 1\n    return mask if placed == n_holes else None\n\n\ndef _zero_is_dominant(grid: np.ndarray) -> bool:\n    counts = np.bincount(grid.ravel(), minlength=COLOR_COUNT_BINS)\n    return int(counts[BG_COLOR]) > int(counts[1:].max()) and get_bg(grid) == BG_COLOR\n\n\ndef _expand_output(out: np.ndarray) -> np.ndarray | None:\n    rows, cols = out.shape\n    heights = _pick_sizes(rows, *LATTICE_HEIGHT_BOUNDS, *BAND_HEIGHT_BOUNDS)\n    widths = _pick_sizes(cols, *LATTICE_WIDTH_BOUNDS, *BAND_WIDTH_BOUNDS)\n    lattice_h = sum(heights)\n    lattice_w = sum(widths)\n\n    min_grid_h = max(CANVAS_HEIGHT_BOUNDS[0], lattice_h + 2 * MIN_BG_PADDING)\n    min_grid_w = max(CANVAS_WIDTH_BOUNDS[0], lattice_w + 2 * MIN_BG_PADDING)\n    if min_grid_h > CANVAS_HEIGHT_BOUNDS[1] or min_grid_w > CANVAS_WIDTH_BOUNDS[1]:\n        return None\n\n    grid_h = random.randint(min_grid_h, CANVAS_HEIGHT_BOUNDS[1])\n    grid_w = random.randint(min_grid_w, CANVAS_WIDTH_BOUNDS[1])\n    top = random.randint(MIN_BG_PADDING, grid_h - lattice_h - MIN_BG_PADDING)\n    left = random.randint(MIN_BG_PADDING, grid_w - lattice_w - MIN_BG_PADDING)\n\n    lattice = np.full((lattice_h, lattice_w), BG_COLOR, dtype=int)\n    input_colors = out[:, ::-1]\n    r0 = 0\n    for r, height in enumerate(heights):\n        c0 = 0\n        for c, width in enumerate(widths):\n            cell = np.full((height, width), int(input_colors[r, c]), dtype=int)\n            holes = _hole_mask(height, width)\n            if holes is None:\n                return None\n            cell[holes] = BG_COLOR\n            paste(lattice, cell, r0, c0)\n            c0 += width\n        r0 += height\n\n    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)\n    paste(grid, lattice, top, left)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n","exit_code":0,"status":"completed"}}
