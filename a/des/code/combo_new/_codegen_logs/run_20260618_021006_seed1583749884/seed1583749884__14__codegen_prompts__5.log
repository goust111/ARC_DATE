{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/446ef5d2.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, STRUCT8, get_bg, in_bounds, neighbors4, paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered rectangular pieces into a rectangle at an L-marker corner.\n\n    Input structure:\n    - bg = most common color. Non-bg rectangular pieces scattered on the grid.\n    - 3-pixel L-marker (2x2 minus one cell) tags the corner; the gap is the corner cell.\n\n    Rule:\n    - rect_col = most common color across all piece pixels; all outer rectangle edges must be rect_col.\n    - Translate pieces (no rotation) to tile the rectangle; touching edges must match, with rect_col as wildcard.\n\n    Key insight: rect_col acts as wildcard during edge matching — only non-rect_col pixels at shared boundaries must agree.\n    \"\"\"\n    inp = grid\n    g = np.array(inp, dtype=int)\n    GH, GW = g.shape\n\n    bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])\n\n    # Find marker: a color appearing exactly 3 times forming an L in a 2x2 bbox.\n    cnt = Counter(map(int, g.flatten()))\n    mark = None\n    missing = None\n    mb = None  # marker bbox\n    for col in sorted([c for c, n in cnt.items() if int(c) != int(bg) and int(n) == 3]):\n        pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]\n        rs = [r for r, _ in pts]\n        cs = [c for _, c in pts]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        if (r1 - r0) == 1 and (c1 - c0) == 1:\n            all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n            miss = list(all4 - set(pts))\n            if len(miss) == 1:\n                mark = int(col)\n                missing = miss[0]\n                mb = (r0, c0, r1, c1)\n                break\n\n    assert not (mark is None or missing is None or mb is None)\n\n    r0, c0, r1, c1 = mb\n    # Rectangle corner is opposite the marker bulk.\n    if missing == (r0, c0):\n        corner = \"BR\"\n    elif missing == (r0, c1):\n        corner = \"BL\"\n    elif missing == (r1, c0):\n        corner = \"TR\"\n    else:\n        corner = \"TL\"\n\n    # Decompose occupied mask (non-bg and non-marker) into rectangles.\n    occ = (g != int(bg)) & (g != int(mark))\n    used = np.zeros_like(occ, dtype=bool)\n    rects = []  # (r, c, h, w, arr)\n    while True:\n        idx = np.argwhere(occ & (~used))\n        if idx.size == 0:\n            break\n        rr, cc = map(int, idx[0])\n        w = 0\n        while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):\n            w += 1\n        h = 0\n        while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):\n            h += 1\n        used[rr : rr + h, cc : cc + w] = True\n        rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))\n\n    total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))\n\n    # The final rectangle's border/background color.\n    allpix = []\n    for _r, _c, _h, _w, a in rects:\n        allpix.extend(map(int, a.flatten()))\n    rect_col = int(Counter(allpix).most_common(1)[0][0])\n\n    mr, mc = map(int, missing)\n\n    # Anchor piece: the rectangle containing the corner cell.\n    anchor_idx = None\n    for i, (rr, cc, h, w, _a) in enumerate(rects):\n        if rr <= mr < rr + h and cc <= mc < cc + w:\n            anchor_idx = i\n            break\n\n    pieces = [a for _r, _c, _h, _w, a in rects]\n    ph = [int(p.shape[0]) for p in pieces]\n    pw = [int(p.shape[1]) for p in pieces]\n\n    # Candidate rectangle dimensions are factor pairs of total_area that fit in the grid\n    # when anchored at (mr, mc) as the specified corner.\n    dims = []\n    for hh in range(1, int(total_area**0.5) + 1):\n        if total_area % hh == 0:\n            dims.append((hh, total_area // hh))\n            if hh * hh != total_area:\n                dims.append((total_area // hh, hh))\n\n    def fits(H, W):\n        if corner == \"TL\":\n            tr, tc = mr, mc\n        elif corner == \"TR\":\n            tr, tc = mr, mc - W + 1\n        elif corner == \"BL\":\n            tr, tc = mr - H + 1, mc\n        else:  # \"BR\"\n            tr, tc = mr - H + 1, mc - W + 1\n        return 0 <= tr and 0 <= tc and (tr + H) <= GH and (tc + W) <= GW\n\n    dims = [(int(H), int(W)) for H, W in dims if fits(int(H), int(W))]\n    dims = sorted(dims, key=lambda t: (-t[0] * t[1], -t[0], -t[1]))\n\n    def compat(v1, v2):\n        v1 = np.array(v1, dtype=int)\n        v2 = np.array(v2, dtype=int)\n        m = (v1 != int(rect_col)) & (v2 != int(rect_col))\n        return bool((v1[m] == v2[m]).all())\n\n    def assemble(H, W):\n        occ2 = np.full((H, W), -1, dtype=int)\n        usedp = [False] * len(pieces)\n\n        def boundary_ok(a, r, c):\n            h, w = a.shape\n            if r == 0 and not np.all(a[0, :] == int(rect_col)):\n                return False\n            if (r + h) == H and not np.all(a[-1, :] == int(rect_col)):\n                return False\n            if c == 0 and not np.all(a[:, 0] == int(rect_col)):\n                return False\n            if (c + w) == W and not np.all(a[:, -1] == int(rect_col)):\n                return False\n            return True\n\n        def neighbor_ok(a, r, c):\n            h, w = a.shape\n            if c > 0:\n                left = occ2[r : r + h, c - 1]\n                m = left != -1\n                if m.any() and (not compat(left[m], a[:, 0][m])):\n                    return False\n            if (c + w) < W:\n                right = occ2[r : r + h, c + w]\n                m = right != -1\n                if m.any() and (not compat(right[m], a[:, -1][m])):\n                    return False\n            if r > 0:\n                up = occ2[r - 1, c : c + w]\n                m = up != -1\n                if m.any() and (not compat(up[m], a[0, :][m])):\n                    return False\n            if (r + h) < H:\n                down = occ2[r + h, c : c + w]\n                m = down != -1\n                if m.any() and (not compat(down[m], a[-1, :][m])):\n                    return False\n            return True\n\n        def can_place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            if (r + h) > H or (c + w) > W:\n                return False\n            if (occ2[r : r + h, c : c + w] != -1).any():\n                return False\n            if not boundary_ok(a, r, c):\n                return False\n            if not neighbor_ok(a, r, c):\n                return False\n            return True\n\n        def place(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = a\n            usedp[i] = True\n\n        def unplace(i, r, c):\n            a = pieces[i]\n            h, w = a.shape\n            occ2[r : r + h, c : c + w] = -1\n            usedp[i] = False\n\n        # Pre-place anchor piece if the corner cell is exactly a corner of that piece.\n        if anchor_idx is not None:\n            rr, cc, h0, w0, _ = rects[anchor_idx]\n            corners = {\n                (rr, cc): \"TL\",\n                (rr, cc + w0 - 1): \"TR\",\n                (rr + h0 - 1, cc): \"BL\",\n                (rr + h0 - 1, cc + w0 - 1): \"BR\",\n            }\n            if (mr, mc) in corners and corners[(mr, mc)] == corner:\n                ah, aw = ph[anchor_idx], pw[anchor_idx]\n                if corner == \"TL\":\n                    ar0, ac0 = 0, 0\n                elif corner == \"TR\":\n                    ar0, ac0 = 0, W - aw\n                elif corner == \"BL\":\n                    ar0, ac0 = H - ah, 0\n                else:  # \"BR\"\n                    ar0, ac0 = H - ah, W - aw\n                if can_place(anchor_idx, ar0, ac0):\n                    place(anchor_idx, ar0, ac0)\n\n        order = sorted(range(len(pieces)), key=lambda i: (-ph[i] * pw[i], -ph[i], -pw[i], i))\n\n        def next_empty():\n            idx = np.argwhere(occ2 == -1)\n            if idx.size == 0:\n                return None\n            return tuple(map(int, idx[0]))\n\n        solved = False\n\n        def bt():\n            nonlocal solved\n            nxt = next_empty()\n            if nxt is None:\n                solved = True\n                return\n            r, c = nxt\n            for i in order:\n                if usedp[i]:\n                    continue\n                if can_place(i, r, c):\n                    place(i, r, c)\n                    bt()\n                    if solved:\n                        return\n                    unplace(i, r, c)\n\n        bt()\n        return occ2 if solved else None\n\n    ass = None\n    used_dim = None\n    for H, W in dims:\n        ass = assemble(H, W)\n        if ass is not None:\n            used_dim = (H, W)\n            break\n\n    assert not (ass is None or used_dim is None)\n\n    H, W = used_dim\n    if corner == \"TL\":\n        top_left = (mr, mc)\n    elif corner == \"TR\":\n        top_left = (mr, mc - W + 1)\n    elif corner == \"BL\":\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _touches_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:\n    h, w = shape\n    return bool(\n        (coords[:, 0] == 0).any()\n        or (coords[:, 0] == h - 1).any()\n        or (coords[:, 1] == 0).any()\n        or (coords[:, 1] == w - 1).any()\n    )\n\n\ndef _neighbor_colors(g: np.ndarray, coords: np.ndarray, color: int) -> set[int]:\n    coord_set = {tuple(map(int, p)) for p in coords}\n    colors = set()\n    for r, c in coord_set:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and (nr, nc) not in coord_set:\n                if int(g[nr, nc]) != color:\n                    colors.add(int(g[nr, nc]))\n    return colors\n\n\ndef _object_components(g: np.ndarray) -> tuple[int, list[np.ndarray], set[int]]:\n    candidates = []\n    for color in set(map(int, g.ravel())):\n        inner_components = [\n            coords\n            for coords in components_mask(g == color, connectivity=4)\n            if len(coords) >= 5 and not _touches_boundary(coords, g.shape)\n        ]\n        if len(inner_components) < 2:\n            continue\n\n        panel_colors = set()\n        for coords in inner_components:\n            neighbors = _neighbor_colors(g, coords, color)\n            if len(neighbors) != 1:\n                break\n            panel_colors.update(neighbors)\n        else:\n            if len(panel_colors) == 2:\n                candidates.append((color, inner_components, panel_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _valid_core_rect(\n    object_cells: set[tuple[int, int]],\n    missing: set[tuple[int, int]],\n    outside: set[tuple[int, int]],\n    rect: tuple[int, int, int, int],\n) -> bool:\n    r0, c0, r1, c1 = rect\n\n    for r, c in missing:\n        distances = [r - r0, r1 - r, c - c0, c1 - c]\n        if distances.count(min(distances)) != 1:\n            return False\n\n    for r, c in outside:\n        side_count = int(r < r0) + int(r > r1) + int(c < c0) + int(c > c1)\n        if side_count != 1:\n            return False\n        if r < r0:\n            inner = (r + 1, c)\n        elif r > r1:\n            inner = (r - 1, c)\n        elif c < c0:\n            inner = (r, c + 1)\n        else:\n            inner = (r, c - 1)\n        if inner not in object_cells:\n            return False\n\n    return True\n\n\ndef _core_rect(coords: np.ndarray) -> tuple[int, int, int, int]:\n    object_cells = {tuple(map(int, p)) for p in coords}\n    r0, c0 = map(int, coords.min(axis=0))\n    r1, c1 = map(int, coords.max(axis=0))\n\n    candidates = []\n    for rr0 in (r0, r0 + 1):\n        for rr1 in (r1, r1 - 1):\n            for cc0 in (c0, c0 + 1):\n                for cc1 in (c1, c1 - 1):\n                    if rr0 > rr1 or cc0 > cc1:\n                        continue\n                    rect_cells = {\n                        (r, c)\n                        for r in range(rr0, rr1 + 1)\n                        for c in range(cc0, cc1 + 1)\n                    }\n                    missing = rect_cells - object_cells\n                    outside = object_cells - rect_cells\n                    rect = (rr0, cc0, rr1, cc1)\n                    if not _valid_core_rect(object_cells, missing, outside, rect):\n                        continue\n                    score = (len(missing) + len(outside), -len(rect_cells))\n                    candidates.append((score, rect))\n\n    assert candidates\n    best_score = min(score for score, _ in candidates)\n    best_rects = [rect for score, rect in candidates if score == best_score]\n    assert len(best_rects) == 1\n    return best_rects[0]\n\n\ndef _nearest_rect_side(r: int, c: int, rect: tuple[int, int, int, int]) -> str:\n    r0, c0, r1, c1 = rect\n    distances = {\n        \"top\": r - r0,\n        \"bottom\": r1 - r,\n        \"left\": c - c0,\n        \"right\": c1 - c,\n    }\n    nearest = [side for side, dist in distances.items() if dist == min(distances.values())]\n    assert len(nearest) == 1\n    return nearest[0]\n\n\ndef _defect_bar_cells(coords: np.ndarray, rect: tuple[int, int, int, int]) -> set[tuple[int, int]]:\n    object_cells = {tuple(map(int, p)) for p in coords}\n    r0, c0, r1, c1 = rect\n    rect_cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}\n    bars = set()\n\n    for r, c in rect_cells - object_cells:\n        side = _nearest_rect_side(r, c, rect)\n        if side == \"top\":\n            bars.update({(r - 1, c), (r, c)})\n        elif side == \"bottom\":\n            bars.update({(r, c), (r + 1, c)})\n        elif side == \"left\":\n            bars.update({(r, c - 1), (r, c)})\n        else:\n            bars.update({(r, c), (r, c + 1)})\n\n    for r, c in object_cells - rect_cells:\n        if r < r0:\n            bars.update({(r, c), (r + 1, c)})\n        elif r > r1:\n            bars.update({(r - 1, c), (r, c)})\n        elif c < c0:\n            bars.update({(r, c), (r, c + 1)})\n        else:\n            assert c > c1\n            bars.update({(r, c - 1), (r, c)})\n\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n","exit_code":0,"status":"completed"}}
