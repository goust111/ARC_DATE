{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n    return None\n\n\ndef _gen_symmetric_motif_patch(max_h, max_w):\n    candidates = []\n    for lines in _GEN_MOTIF_TEMPLATES:\n        patch = _gen_patch_from_lines(lines)\n        for variant in _gen_patch_variants(patch):\n            h, w = variant.shape\n            direction = _gen_patch_direction(variant)\n            if (\n                h <= max_h\n                and w <= max_w\n                and _gen_is_diagonal_symmetric_patch(variant)\n                and direction is not None\n            ):\n                candidates.append((variant, direction))\n    if not candidates:\n        return None\n    patch, direction = random.choice(candidates)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"from collections import Counter, deque\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, paste\nimport random\n\n\ndef _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:\n    h, w = passable.shape\n    dist = np.full((h, w), -1, dtype=int)\n    q: deque[tuple[int, int]] = deque()\n    for r, c in sources:\n        rr = int(r)\n        cc = int(c)\n        assert passable[rr, cc]\n        dist[rr, cc] = 0\n        q.append((rr, cc))\n\n    while q:\n        r, c = q.popleft()\n        nd = int(dist[r, c]) + 1\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr = r + dr\n            nc = c + dc\n            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:\n                dist[nr, nc] = nd\n                q.append((nr, nc))\n    return dist\n\n\ndef _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:\n    h, w = g.shape\n    rooms: list[tuple[int, int, int]] = []\n    for n in sorted(sizes):\n        assert n > 1\n        for r in range(h - n + 1):\n            for c in range(w - n + 1):\n                if np.any(g[r : r + n, c : c + n] == wall):\n                    continue\n\n                side_wall_counts: list[int] = []\n                if r > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))\n                if r + n < h:\n                    side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))\n                if c > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))\n                if c + n < w:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))\n\n                if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):\n                    rooms.append((r, c, n))\n    return rooms\n\n\ndef _component_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int, int]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    components: list[tuple[int, int, int, int, int]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            r0 = r1 = r\n            c0 = c1 = c\n            area = 0\n            while q:\n                rr, cc = q.popleft()\n                area += 1\n                r0 = min(r0, rr)\n                c0 = min(c0, cc)\n                r1 = max(r1, rr)\n                c1 = max(c1, cc)\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr = rr + dr\n                    nc = cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            components.append((r0, c0, r1, c1, area))\n    return components\n\n\ndef _overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:\n    return max(0, min(a1, b1) - max(a0, b0) + 1)\n\n\ndef _middle_fill_bounded_by_side_rooms(\n    bbox: tuple[int, int, int, int],\n    rooms: list[tuple[int, int, int]],\n) -> bool:\n    r0, c0, r1, c1 = bbox\n    left: list[tuple[int, int]] = []\n    right: list[tuple[int, int]] = []\n    above: list[tuple[int, int]] = []\n    below: list[tuple[int, int]] = []\n\n    for r, c, n in rooms:\n        rr1 = r + n - 1\n        cc1 = c + n - 1\n        row_overlap = _overlap_len(r0, r1, r, rr1)\n        col_overlap = _overlap_len(c0, c1, c, cc1)\n        if row_overlap > 0 and 1 <= c0 - cc1 <= 2:\n            left.append((r, rr1))\n        if row_overlap > 0 and 1 <= c - c1 <= 2:\n            right.append((r, rr1))\n        if col_overlap > 0 and 1 <= r0 - rr1 <= 2:\n            above.append((c, cc1))\n        if col_overlap > 0 and 1 <= r - r1 <= 2:\n            below.append((c, cc1))\n\n    def spans_contain(intervals_a: list[tuple[int, int]], intervals_b: list[tuple[int, int]], lo: int, hi: int) -> bool:\n        if not intervals_a or not intervals_b:\n            return False\n        a0 = min(start for start, _end in intervals_a)\n        a1 = max(end for _start, end in intervals_a)\n        b0 = min(start for start, _end in intervals_b)\n        b1 = max(end for _start, end in intervals_b)\n        return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1\n\n    return spans_contain(left, right, r0, r1) or spans_contain(above, below, c0, c1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\nORIENTATIONS = (\"vertical\", \"horizontal\")\n\n# Coarse layout and final route validation thresholds.\nLAYOUT_DISTANCE_MIN = 36\nLAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\nSHORTEST_DISTANCE_MIN = 36\nSHORTEST_DISTANCE_MAX = 72\nTURN_MIN = 8\nTURN_MAX = 21\nON_ROUTE_ROOM_MIN = 6\nON_ROUTE_ROOM_MAX = 14\nOFF_ROUTE_ROOM_MIN = 1\nOFF_ROUTE_ROOM_MAX = 8\n\n# Connector sampling: offset connectors create the observed middle fill region.\nOFFSET_CONNECTOR_PROB = 0.60\nCONNECTOR_CHOICE_TRIES = 300\nCONNECTOR_DELTA_MAX = 12\nCONNECTOR_DELTA_MIN_CAP = 5\n\n","exit_code":0,"status":"completed"}}
