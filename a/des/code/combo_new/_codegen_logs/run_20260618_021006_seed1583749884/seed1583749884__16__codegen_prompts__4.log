{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '68,220p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py && sed -n '600,790p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor grey shapes by matching their hole count to a color legend.\n\n    Input structure:\n    - bg = most common color; grey (5) sprites scattered across the grid.\n    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n      each with a distinct number of enclosed holes.\n\n    Rule:\n    - Each colored legend shape defines a mapping: hole count → color.\n    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n\n    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    grey = 5\n\n    legend = _legend_mapping(g, bg, grey)\n    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n\n    out = g.copy()\n    for pts in components_mask(g == grey, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts)\n        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n        for r, c in pts:\n            sub[r - r0, c - c0] = True\n        hc = _hole_count(sub)\n        newc = int(legend[hc]) if hc in legend else bg\n        for r, c in pts:\n            out[r, c] = newc\n\n    return out\n\n# --------------- generator (holes-first organic blob) ---------------\n\nfrom arc_utils import label_mask\nfrom scipy.ndimage import binary_dilation, generate_binary_structure\n\n# -- palette & grid --\nBG = 0\nDIV = 1\nGREY = 5\nGRID_SIZE = 30\nLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n\n# -- legend panel --\nLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\nMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\nPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\nFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\nL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\nL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n\n# -- sprites --\nTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\nMAX_DISTRACTORS = 7                 # max distractor sprites\nMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\nSPRITE_RETRIES = 30                 # retries per sprite generation attempt\nSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\nSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n# 3+ hole sprites: min = 10+2*h, max = 20+4*h\nCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\nCANVAS_MIN = 5                      # minimum canvas dimension\nCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\nHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\nHOLE_SEED_MIN_RADIUS = 2\nHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\nHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\nSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\nSPRITE_MAX_H = 12                   # max sprite bbox height\nSPRITE_MAX_W = 18                   # max sprite bbox width\nSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n\n# -- generation --\nGEN_RETRIES = 300                   # outer retries for generate_input()\n\n# 8-connectivity structuring element for dilation\n_STRUCT8 = generate_binary_structure(2, 2)\n\n\n# ---------- legend helpers ----------\n\ndef _legend_span(hole_count: int) -> int:\n    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n    return 3 if hole_count == 0 else 2 * hole_count + 1\n\n\ndef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n    span = _legend_span(hole_count)\n    if arrangement == \"horizontal\":\n        patch = np.full((3, span), int(color), dtype=int)\n        if hole_count:\n            patch[1, 1::2] = BG\n    else:\n        patch = np.full((span, 3), int(color), dtype=int)\n        if hole_count:\n            patch[1::2, 1] = BG\n    return patch\n\n\ndef _line_span(legends: list[tuple[int, int]]) -> int:\n    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n\n\ndef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n    count = random.randint(*LEGEND_COUNT_RANGE)\n    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n    if not combos:\n        return _choose_legends(arrangement, max_span + 2)\n    holes = list(random.choice(combos))\n    random.shuffle(holes)\n    colors = random.sample(LEGEND_COLORS, count)\n    return list(zip(holes, colors))\n\n\ndef _place_legend_line(\n    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n) -> None:\n    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n    rr, cc = int(r), int(c)\n    for hole_count, color in legends:\n        patch = _legend_patch(hole_count, color, arrangement)\n        paste(grid, patch, rr, cc)\n        if arrangement == \"horizontal\":\n            cc += patch.shape[1] + 1\n        else:\n            rr += patch.shape[0] + 1\n\n\n# ---------- layout helpers ----------\n\ndef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_h = random.randint(*PANEL_SIZE_RANGE)\n    top = random.choice([True, False])\n    c0 = random.randint(1, GRID_SIZE - 1 - total)\n    if top:\n        div_r = panel_h\n        grid[div_r, :] = DIV\n        blocked[: div_r + 1, :] = 9\n        r0 = random.randint(1, panel_h - 4)\n    else:\n        div_r = GRID_SIZE - 1 - panel_h\n        grid[div_r, :] = DIV\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        try:\n            grid = _gen_attempt()\n        except Exception:\n            grid = None\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate e3721c99 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '32,145p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py && sed -n '199,360p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '32,145p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py && sed -n '199,360p' /home/lixinyu/snap/new/ARC_code/train/18447a8d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each right-side colored shape into the left slot whose template color is its exact complement.\n\n    Input structure:\n    - The grid has two equal-width slots separated by one background column.\n    - Non-background rows form horizontal bands separated by all-background rows.\n    - Each band has a shared template color in the left slot and one colored source shape in the right slot.\n\n    Rule:\n    - For each band, define its destination shape as the cells in the left slot not occupied by the template color.\n    - Normalize every right-side source shape to right-slot coordinates and match it to the unique equal destination shape.\n    - Clear the original right-side source pixels and paint the matched left-slot complement with the source color.\n\n    Key insight:\n    The right-side objects are not placed by row order; each one completes the unique left template whose missing cells have the same shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    assert w % 2 == 1, \"canvas must contain two equal slots plus one separator column\"\n    slot_w = w // 2\n    sep_c = slot_w\n\n    bands = _active_row_spans(g, bg)\n    assert bands, \"grid must contain at least one active band\"\n\n    band_color_sets: list[set[int]] = []\n    for r0, r1 in bands:\n        colors = set(map(int, g[r0 : r1 + 1].ravel())) - {bg}\n        assert colors, \"each active band must contain foreground colors\"\n        band_color_sets.append(colors)\n\n    shared_colors = set.intersection(*band_color_sets)\n    assert len(shared_colors) == 1, \"template color must be the only color shared by all bands\"\n    template_color = next(iter(shared_colors))\n\n    dest_shapes: list[CoordSet] = []\n    sources: list[tuple[int, CoordSet]] = []\n    for band_i, (r0, r1) in enumerate(bands):\n        block = g[r0 : r1 + 1]\n        assert np.all(block[:, sep_c] == bg), \"slot separator column must be background\"\n\n        left = block[:, :slot_w]\n        right = block[:, sep_c + 1 :]\n        assert np.all((left == bg) | (left == template_color)), \"left slot must contain only template and background\"\n\n        template_mask = left == template_color\n        for row in template_mask:\n            cols = np.flatnonzero(row)\n            assert cols.size > 0, \"each template row must contain at least one pixel\"\n            expected = np.arange(int(cols[-1]) + 1)\n            assert np.array_equal(cols, expected), \"template pixels must be a left-anchored row prefix\"\n\n        dest_shapes.append(_coords(~template_mask))\n\n        source_mask = right != bg\n        assert np.any(source_mask), f\"band {band_i} source shape must be non-empty\"\n        source_colors = set(map(int, right[source_mask].ravel()))\n        assert len(source_colors) == 1, \"each right slot must contain exactly one source color\"\n        source_color = next(iter(source_colors))\n        assert source_color != template_color, \"source color must differ from template color\"\n        source_shape = _coords(source_mask)\n        sources.append((source_color, source_shape))\n\n    out = g.copy()\n    for r0, r1 in bands:\n        right = out[r0 : r1 + 1, sep_c + 1 :]\n        right[right != bg] = bg\n\n    used_destinations: set[int] = set()\n    for source_color, source_shape in sources:\n        matches = [i for i, dest_shape in enumerate(dest_shapes) if dest_shape == source_shape]\n        assert len(matches) == 1, \"each source shape must match exactly one left-slot complement\"\n        dest_i = matches[0]\n        assert dest_i not in used_destinations, \"each destination complement must be filled once\"\n        used_destinations.add(dest_i)\n\n        dest_r0, _ = bands[dest_i]\n        for dr, dc in source_shape:\n            rr = dest_r0 + dr\n            assert out[rr, dc] == bg, \"matched complement cells must be empty before painting\"\n            out[rr, dc] = source_color\n\n    assert len(used_destinations) == len(bands), \"all destination complements must be filled\"\n    assert out.shape == (h, w)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG = 7\nTEMPLATE = 8\n\n# Canvas and band geometry.\nSLOT_W = 5\nBAND_H = 3\nBAND_GAP = 1\nOUTER_MARGIN_ROWS = 1\nSEPARATOR_W = 1\nWIDTH = SLOT_W * 2 + SEPARATOR_W\nRIGHT_SLOT_C0 = SLOT_W + SEPARATOR_W\n\n# Sampling ranges and palette.\nMIN_BANDS, MAX_BANDS = 2, 4\nMIN_SUFFIX_LEN, MAX_SUFFIX_LEN = 1, SLOT_W - 1\nSUFFIX_LENGTHS = range(MIN_SUFFIX_LEN, MAX_SUFFIX_LEN + 1)\nSOURCE_COLORS = [1, 2, 3, 4, 5, 6, 9]\nCOMPLEMENTS = [(a, b, c) for a in SUFFIX_LENGTHS for b in SUFFIX_LENGTHS for c in SUFFIX_LENGTHS]\nMAX_ATTEMPTS = 300\n\n\ndef _band_top(i: int) -> int:\n    return OUTER_MARGIN_ROWS + i * (BAND_H + BAND_GAP)\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
