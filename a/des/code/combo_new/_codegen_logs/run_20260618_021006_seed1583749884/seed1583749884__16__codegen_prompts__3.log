{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/54dc2872.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move each marked L-shaped sprite onto the separate pixel matching its marker color.\n\n    Input structure\n    - The background is the dominant color.\n    - Foreground has 4-connected multicolor sprites and isolated one-pixel controls.\n    - Each sprite has one repeated body color in an L shape plus one embedded marker\n      pixel of a different color.\n\n    Rule\n    - If the embedded marker color also appears as a separate isolated control pixel,\n      translate the whole sprite so the body L-bend lands on that control pixel.\n    - Clear each moved sprite from its old position, clear its consumed control pixel,\n      then paste all translated sprites; sprites without a matching control stay put.\n\n    Key insight\n    - The marker color pairs a sprite with its destination control, while the L-bend\n      gives the orientation-independent anchor cell to place on that destination.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n\n    controls_by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)\n    sprites = []\n    for comp in components:\n        coords = comp[\"coords\"]\n        if len(coords) == 1:\n            r, c = map(int, coords[0])\n            controls_by_color[int(g[r, c])].append((r, c))\n        else:\n            sprites.append(comp)\n\n    moves = []\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        counts = Counter(int(g[r, c]) for r, c in coords)\n        marker_colors = [color for color, count in counts.items() if count == 1]\n        body_colors = [color for color, count in counts.items() if count > 1]\n        assert len(counts) == 2, f\"sprite must have two colors, got {counts}\"\n        assert len(marker_colors) == 1, f\"sprite must have one embedded marker, got {counts}\"\n        assert len(body_colors) == 1, f\"sprite must have one body color, got {counts}\"\n\n        body_color = body_colors[0]\n        body_coords = np.array(\n            [(int(r), int(c)) for r, c in coords if int(g[r, c]) == body_color],\n            dtype=int,\n        )\n        anchor = _l_bend(body_coords)\n\n        marker_color = marker_colors[0]\n        marker = next(\n            (int(r), int(c)) for r, c in coords if int(g[r, c]) == marker_color\n        )\n        controls = controls_by_color.get(marker_color, [])\n        if not controls:\n            continue\n        assert len(controls) == 1, f\"marker color {marker_color} must have one control\"\n        target = controls[0]\n        _outer_diagonal_distance(anchor, marker, target)\n\n        dr = target[0] - anchor[0]\n        dc = target[1] - anchor[1]\n\n        translated = []\n        for r, c in coords:\n            nr = int(r) + dr\n            nc = int(c) + dc\n            assert 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1], \"move must stay in bounds\"\n            translated.append((nr, nc, int(g[r, c])))\n        moves.append((coords, target, translated))\n\n    assert moves, \"expected at least one marker-controlled move\"\n\n    out = g.copy()\n    cleared = set()\n    for coords, target, _translated in moves:\n        for r, c in coords:\n            cleared.add((int(r), int(c)))\n        cleared.add(target)\n    for r, c in cleared:\n        out[r, c] = bg\n\n    occupied = set()\n    for _coords, _target, translated in moves:\n        for r, c, _color in translated:\n            assert out[r, c] == bg, \"translated sprite must land on cleared/background cells\"\n            assert (r, c) not in occupied, \"translated sprites must not overlap\"\n            occupied.add((r, c))\n        for r, c, color in translated:\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (attempt 2) ---------------\n\n# Canvas and palette.\nBG_COLOR = 0\nGRID_ROWS = 12\nGRID_COL_CHOICES = [12, 13]\nCOLORS = list(range(1, 10))\n\n# L-sprite geometry.\nLEG_LEN_MIN = 2\nLEG_LEN_MAX = 4\nMIN_BODY_PIXELS = 4\nORIENTATION_COUNT = 4\nLEG_PAIRS = [\n    (v_len, h_len)\n    for v_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)\n    for h_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)\n    if v_len + h_len - 1 >= MIN_BODY_PIXELS\n]\n\n# Sprite/control counts and rates.\nSPRITE_COUNT_MIN = 2\nSPRITE_COUNT_MAX = 4\nMIN_MOVED_SPRITES = 1\nMAX_MOVED_SPRITES = 2\nMAX_STATIONARY_SPRITES = 2\nDISTRACTOR_PROBABILITY = 0.5\n\n# Placement constraints and retry limits.\nPLACEMENT_PADDING = 1\nPLACEMENT_PADDING_CONNECTIVITY = 4\nMIN_DIAGONAL_DISTANCE = 1\nGENERATION_RETRIES = 300\n\n\ndef _make_l_sprite(body_color: int, marker_color: int) -> tuple[np.ndarray, tuple[int, int]]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n        # stamp moved container rectangle (using paste for the bulk placement)\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n        if to_fill:\n            for rr, cc in to_fill:\n                pr = int(rr - r0)\n                pc = int(cc - c0)\n                if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:\n                    patch[pr, pc] = int(FILL)\n        paste(out, patch, int(r0 + tr), int(c0 + tc), clip=True)\n\n        # stamp moved head pixels\n        for r, c in head_pts:\n            rrr = int(r + tr)\n            ccc = int(c + tc)\n            if 0 <= rrr < H and 0 <= ccc < W:\n                out[rrr, ccc] = int(hc)\n\n    return out\n\n# --------------- generator (attempt 2, Claude) ---------------\n\nBG = 6\nBORDER = 0\nGREY = 5\nORANGE = 7\nHEAD_COLOR = 9\n\n# Direction mapping: head_side -> (dr, dc) movement direction\n# head on top -> container moves up; head on bottom -> moves down, etc.\nSIDE_TO_DIR = {0: (-1, 0), 1: (1, 0), 2: (0, -1), 3: (0, 1)}\n\n\ndef _interior_fill_order(inner_h: int, inner_w: int, head_side: int) -> list[tuple[int, int]]:\n","exit_code":0,"status":"completed"}}
