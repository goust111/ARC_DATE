{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/e9fc42f2.py\"","aggregated_output":"from collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location\nimport math\nimport random\n\n\ndef _connector_dir(sprite: np.ndarray, r: int, c: int) -> tuple[int, int]:\n    h, w = sprite.shape\n    dirs: list[tuple[int, int]] = []\n    if r == 0:\n        dirs.append((-1, 0))\n    if r == h - 1:\n        dirs.append((1, 0))\n    if c == 0:\n        dirs.append((0, -1))\n    if c == w - 1:\n        dirs.append((0, 1))\n    assert len(dirs) == 1\n    return dirs[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.\n\n    Input structure\n    The grid has a dominant background color and several 4-connected multicolor foreground\n    objects.  One foreground color is the body color; the less frequent foreground colors are\n    boundary connector markers, and each marker color appears once as a free end or twice as a\n    matched docking pair.\n\n    Rule\n    Crop each foreground object to its bounding box and translate the objects so that the two\n    occurrences of every paired connector color touch on their exposed boundary sides.  Preserve\n    each object's orientation and colors, then return the tight crop around the assembled\n    foreground on the original background color.\n\n    Key insight\n    The colored marker pixels are ports: matching colors specify which objects must touch, and\n    the marker's side of its object determines the direction of the translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    fg = g[g != bg]\n    assert fg.size > 0\n    values, counts = np.unique(fg, return_counts=True)\n    max_count = int(counts.max())\n    body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]\n    assert len(body_candidates) == 1\n    body = body_candidates[0]\n    marker_colors = {int(v) for v in values if int(v) != body}\n    assert marker_colors\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(components) >= 2\n\n    sprites: list[np.ndarray] = []\n    marker_occurrences: dict[int, list[tuple[int, tuple[int, int], tuple[int, int]]]] = defaultdict(list)\n    for idx, comp in enumerate(components):\n        sprite = crop_bbox(g, comp[\"bbox\"])\n        sprites.append(sprite)\n        marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))\n        assert marker_locs.size > 0\n        for rr, cc in marker_locs:\n            r, c = int(rr), int(cc)\n            direction = _connector_dir(sprite, r, c)\n            marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))\n\n    adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]\n    paired_markers = 0\n    for occurrences in marker_occurrences.values():\n        assert len(occurrences) in (1, 2)\n        if len(occurrences) == 1:\n            continue\n        (a_idx, a_pos, a_dir), (b_idx, b_pos, b_dir) = occurrences\n        assert a_idx != b_idx\n        assert b_dir == (-a_dir[0], -a_dir[1])\n        delta = (a_pos[0] + a_dir[0] - b_pos[0], a_pos[1] + a_dir[1] - b_pos[1])\n        adjacency[a_idx].append((b_idx, delta))\n        adjacency[b_idx].append((a_idx, (-delta[0], -delta[1])))\n        paired_markers += 1\n    assert paired_markers == len(sprites) - 1\n\n    placements: dict[int, tuple[int, int]] = {0: (0, 0)}\n    queue = deque([0])\n    while queue:\n        idx = queue.popleft()\n        base_r, base_c = placements[idx]\n        for nbr, (dr, dc) in adjacency[idx]:\n            pos = (base_r + dr, base_c + dc)\n            if nbr in placements:\n                assert placements[nbr] == pos\n            else:\n                placements[nbr] = pos\n                queue.append(nbr)\n    assert len(placements) == len(sprites)\n\n    placed_fg: list[tuple[int, int]] = []\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        for rr, cc in np.argwhere(sprite != bg):\n            placed_fg.append((base_r + int(rr), base_c + int(cc)))\n\n    r0 = min(r for r, _ in placed_fg)\n    c0 = min(c for _, c in placed_fg)\n    r1 = max(r for r, _ in placed_fg)\n    c1 = max(c for _, c in placed_fg)\n    out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)\n\n    for idx, sprite in enumerate(sprites):\n        base_r, base_c = placements[idx]\n        rr, cc = base_r - r0, base_c - c0\n        mask = sprite != bg\n        target = out[rr : rr + sprite.shape[0], cc : cc + sprite.shape[1]]\n        assert target.shape == sprite.shape\n        assert not np.any((target != bg) & mask)\n        paste(out, sprite, rr, cc, transparent=bg)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and marker vocabulary.\n_GEN_BG, _GEN_BODY = 2, 1\n_GEN_MARKERS = [3, 4, 8]\n\n# Port sides and their assembly directions.\n_GEN_SIDES = (\"T\", \"B\", \"L\", \"R\")\n_GEN_DIRS = {\"T\": (-1, 0), \"B\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n_GEN_OPPOSITE = {\"T\": \"B\", \"B\": \"T\", \"L\": \"R\", \"R\": \"L\"}\n\n# Canvas and scattering constraints.\n_GEN_CANVAS_SHAPE = (13, 13)\n_GEN_MAX_OUTPUT_SPAN = 13\n_GEN_SCATTER_PADDING, _GEN_PADDING_CONNECTIVITY = 2, 8\n_GEN_SHADOW_BG = 0\n\n# Sprite count, size, and special-case height controls.\n_GEN_SPRITE_COUNT_CHOICES = [2, 3, 4]\n_GEN_MIN_SPRITES, _GEN_MID_SPRITES, _GEN_MAX_SPRITES = 2, 3, 4\n_GEN_HEIGHT_RANGE, _GEN_COMPACT_HEIGHT_RANGE, _GEN_WIDTH_RANGE = (3, 8), (3, 6), (3, 6)\n_GEN_FOUR_SPRITE_HEIGHT_CHOICES = [3, 4, 5, 5, 6]\n_GEN_THREE_SPRITE_COMPACT_PROB = 0.7\n\n# Sprite fill and port-count constraints.\n_GEN_INTERIOR_MARGIN = 1\n_GEN_MIN_DENSITY, _GEN_MAX_DENSITY = 0.36, 0.89\n_GEN_MAX_PORTS_PER_SPRITE = 3\n\n# Generation retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r, c, h, w):\n    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < h and 0 <= cc < w:\n            yield rr, cc\n\n\ndef _gen_boundary_coord(side, h, w):\n    low = _GEN_INTERIOR_MARGIN\n    if side == \"T\":\n        return 0, random.randint(low, w - 1 - low)\n    if side == \"B\":\n        return h - 1, random.randint(low, w - 1 - low)\n    if side == \"L\":\n        return random.randint(low, h - 1 - low), 0\n    return random.randint(low, h - 1 - low), w - 1\n\n\ndef _gen_inner_neighbor(side, r, c):\n    dr, dc = _GEN_DIRS[side]\n    return r - dr, c - dc\n\n\ndef _gen_add_path(cells, start, end):\n    r, c = start\n    er, ec = end\n    cells.add((r, c))\n    axes = [0, 1]\n    random.shuffle(axes)\n    for axis in axes:\n        while (axis == 0 and r != er) or (axis == 1 and c != ec):\n            if axis == 0:\n                r += 1 if er > r else -1\n            else:\n                c += 1 if ec > c else -1\n            cells.add((r, c))\n\n\ndef _gen_seed_sprite_cells(h, w, ports):\n    port_locs = {}\n    cells = set()\n    port_sides = {side for _, side in ports}\n\n    for color, side in ports:\n        r, c = _gen_boundary_coord(side, h, w)\n        port_locs[color] = (r, c)\n        cells.add((r, c))\n        cells.add(_gen_inner_neighbor(side, r, c))\n\n    for side in _GEN_SIDES:\n        if side in port_sides:\n            continue\n        r, c = _gen_boundary_coord(side, h, w)\n        cells.add((r, c))\n\n    return cells, port_locs\n\n\ndef _gen_connect_sprite_cells(cells, h, w):\n    low = _GEN_INTERIOR_MARGIN\n    center = (random.randint(low, h - 1 - low), random.randint(low, w - 1 - low))\n    cells.add(center)\n    for cell in list(cells):\n        _gen_add_path(cells, cell, center)\n\n\ndef _gen_frontier(cells, h, w):\n    return {\n        nbr\n        for r, c in cells\n        for nbr in _gen_neighbors4(r, c, h, w)\n        if nbr not in cells\n    }\n\n\ndef _gen_grow_sprite_cells(cells, h, w):\n    area = h * w\n    min_fg = max(len(cells), math.ceil(_GEN_MIN_DENSITY * area))\n    max_fg = math.floor(_GEN_MAX_DENSITY * area)\n    if min_fg > max_fg:\n        return False\n\n    target = random.randint(min_fg, max_fg)\n    while len(cells) < target:\n","exit_code":0,"status":"completed"}}
