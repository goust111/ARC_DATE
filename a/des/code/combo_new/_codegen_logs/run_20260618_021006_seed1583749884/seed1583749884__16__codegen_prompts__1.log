{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/aaecdb9a.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, components_mask, get_bg\n\n\nPALETTE_ORDER = (Color.GREY, Color.RED, Color.TEAL, Color.MAROON, Color.PINK)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.\n\n    Input structure\n    The grid has a dominant background color and foreground objects in the task\n    palette: grey, red, teal, maroon, and pink. Objects are monochromatic\n    8-connected components; some palette colors may be absent.\n\n    Rule\n    For each palette color in order grey, red, teal, maroon, pink, count its\n    8-connected objects. Create a background grid with five columns and height\n    equal to the largest count, then fill each column upward from the bottom\n    with its palette color for that count.\n\n    Key insight\n    The output does not preserve object shapes or positions; it is a histogram\n    of per-color 8-connected object counts, using the learned palette order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    palette_set = set(PALETTE_ORDER)\n    assert bg not in palette_set, \"background must not be a histogram color\"\n    assert set(map(int, g.ravel())) <= palette_set | {bg}\n\n    object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]\n    max_count = max(object_counts)\n    assert max_count > 0, \"expected at least one foreground object\"\n\n    out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)\n    for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):\n        if count:\n            out[-count:, c] = color\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nGRID_SHAPE = (10, 10)\nBACKGROUND_COLOR = Color.ORANGE\nN_COLORS = len(PALETTE_ORDER)\n\n# Histogram count sampling.\nNONZERO_COLOR_RANGE = (3, 6)\nMAX_COUNT_RANGE = (2, 7)\nTOTAL_OBJECT_RANGE = (4, 12)\n\n# Blob shape sampling.\nN_BLOB_SHAPES = 6\nLINE_LENGTH_RANGE = (2, 5)\nSMALL_DIM_RANGE = (2, 4)\nGROWN_BLOB_MIN_SIZE = 3\nPLUS_SHAPE_SIZE = 3\n\n# Placement and retry limits.\nSAME_COLOR_MIN_CHEBYSHEV = 2\nBLOB_PLACE_TRIES = 100\nGENERATION_TRIES = 300\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Generate one candidate grid, returning None when placement or validation fails.\"\"\"\n    rng = np.random.default_rng()\n    counts = _sample_counts(rng)\n    if counts is None:\n        return None\n\n    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)\n    if not _place_all_blobs(grid, counts, rng):\n        return None\n    if not _counts_match_grid(grid, counts):\n        return None\n    if not _solver_matches_expected(grid, counts):\n        return None\n    return grid\n\n\ndef _sample_counts(rng) -> list[int] | None:\n    \"\"\"Sample per-color component counts matching the output histogram contract.\"\"\"\n    n_nonzero = int(rng.integers(*NONZERO_COLOR_RANGE))\n    max_count = int(rng.integers(*MAX_COUNT_RANGE))\n\n    counts = [0] * N_COLORS\n    nonzero_indices = list(rng.choice(N_COLORS, size=n_nonzero, replace=False))\n    max_idx = rng.choice(nonzero_indices)\n    counts[max_idx] = max_count\n\n    remaining_budget = TOTAL_OBJECT_RANGE[1] - max_count\n    for idx in [i for i in nonzero_indices if i != max_idx]:\n        upper = min(max_count, remaining_budget)\n        if upper < 1:\n            counts[idx] = 1\n            remaining_budget -= 1\n        else:\n            counts[idx] = int(rng.integers(1, upper + 1))\n            remaining_budget -= counts[idx]\n\n    total = sum(counts)\n    if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:\n        return None\n    return counts\n\n\ndef _place_all_blobs(grid: np.ndarray, counts: list[int], rng) -> bool:\n    \"\"\"Place each color's requested number of same-color-separated blobs.\"\"\"\n    for color_idx, count in enumerate(counts):\n        if count == 0:\n            continue\n        if not _place_color_blobs(grid, PALETTE_ORDER[color_idx], count, rng):\n            return False\n    return True\n\n\ndef _place_color_blobs(grid: np.ndarray, color: int, count: int, rng) -> bool:\n    placed_blobs = []\n    for _ in range(count):\n        coords = _choose_placeable_blob(grid, placed_blobs, rng)\n        if coords is None:\n            return False\n        _paint_coords(grid, coords, color)\n        placed_blobs.append(coords)\n    return True\n\n\ndef _choose_placeable_blob(grid: np.ndarray, placed_blobs: list[set], rng) -> set | None:\n    for _ in range(BLOB_PLACE_TRIES):\n        blob = _random_blob(rng)\n        bh, bw = blob.shape\n        r0 = int(rng.integers(0, GRID_SHAPE[0] - bh + 1))\n        c0 = int(rng.integers(0, GRID_SHAPE[1] - bw + 1))\n        coords = _offset_blob_coords(blob, r0, c0)\n        if _coords_are_free(grid, coords) and _chebyshev_ok(coords, placed_blobs):\n            return coords\n    return None\n\n\ndef _offset_blob_coords(blob: np.ndarray, r0: int, c0: int) -> set:\n    offsets = np.argwhere(blob)\n    return set(map(tuple, offsets + np.array([r0, c0])))\n\n\ndef _coords_are_free(grid: np.ndarray, coords: set) -> bool:\n    return all(grid[r, c] == BACKGROUND_COLOR for r, c in coords)\n\n\ndef _paint_coords(grid: np.ndarray, coords: set, color: int) -> None:\n    rr, cc = np.array(list(coords)).T\n    grid[rr, cc] = color\n\n\ndef _counts_match_grid(grid: np.ndarray, counts: list[int]) -> bool:\n    \"\"\"Recompute 8-connected components to reject accidental same-color merges.\"\"\"\n    for color, expected_count in zip(PALETTE_ORDER, counts):\n        mask = grid == color\n        if expected_count == 0:\n            if mask.any():\n                return False\n        elif len(components_mask(mask, connectivity=8)) != expected_count:\n            return False\n    return True\n\n\ndef _solver_matches_expected(grid: np.ndarray, counts: list[int]) -> bool:\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return np.array_equal(out, _expected_output(counts))\n\n\ndef _expected_output(counts: list[int]) -> np.ndarray:\n    out = np.full((max(counts), N_COLORS), BACKGROUND_COLOR, dtype=int)\n    for c_idx, (color, count) in enumerate(zip(PALETTE_ORDER, counts)):\n        if count:\n            out[-count:, c_idx] = color\n    return out\n\n\ndef _random_blob(rng) -> np.ndarray:\n    \"\"\"Generate a random small 8-connected blob mask.\"\"\"\n    shape_type = rng.integers(0, N_BLOB_SHAPES)\n\n    if shape_type == 0:\n        return np.array([[True]])\n    elif shape_type == 1:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((1, length), dtype=bool)\n    elif shape_type == 2:\n        length = int(rng.integers(*LINE_LENGTH_RANGE))\n        return np.ones((length, 1), dtype=bool)\n    elif shape_type == 3:\n        return _random_grown_blob(rng)\n    elif shape_type == 4:\n        return _plus_blob()\n    else:\n        h = int(rng.integers(*SMALL_DIM_RANGE))\n        w = int(rng.integers(*SMALL_DIM_RANGE))\n        return np.ones((h, w), dtype=bool)\n\n\ndef _random_grown_blob(rng) -> np.ndarray:\n    \"\"\"Grow a small mask by repeatedly adding an 8-neighbor of existing pixels.\"\"\"\n    h = int(rng.integers(*SMALL_DIM_RANGE))\n    w = int(rng.integers(*SMALL_DIM_RANGE))\n    mask = np.zeros((h, w), dtype=bool)\n    mask[0, 0] = True\n    pixels = [(0, 0)]\n    target_size = int(rng.integers(GROWN_BLOB_MIN_SIZE, h * w + 1))\n    for _ in range(target_size - 1):\n        candidates = _growth_candidates(mask, pixels)\n        if not candidates:\n            break\n        pick = list(candidates)[int(rng.integers(0, len(candidates)))]\n        mask[pick[0], pick[1]] = True\n        pixels.append(pick)\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray, pixels: list[tuple[int, int]]) -> set:\n    h, w = mask.shape\n    candidates = set()\n    for r, c in pixels:\n        for dr in range(-1, 2):\n            for dc in range(-1, 2):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                    candidates.add((nr, nc))\n    return candidates\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n","exit_code":0,"status":"completed"}}
