{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo/seed1544388365/10/5.py\"","aggregated_output":"import numpy as np\n\n\ndef _bg_color(grid: np.ndarray) -> int:\n    values, counts = np.unique(grid, return_counts=True)\n    return int(values[np.argmax(counts)])\n\n\ndef _hidden_orientation(grid: np.ndarray, color: int, row: int, col: int) -> str | None:\n    h, w = grid.shape\n    horizontal = 0 < col < w - 1 and int(grid[row, col - 1]) == color and int(grid[row, col + 1]) == color\n    vertical = 0 < row < h - 1 and int(grid[row - 1, col]) == color and int(grid[row + 1, col]) == color\n    assert not (horizontal and vertical), \"a hidden path may not self-cross at one cell\"\n    if horizontal:\n        return \"horizontal\"\n    if vertical:\n        return \"vertical\"\n    return None\n\n\ndef _unique_topological_order(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:\n    followers = {color: set() for color in colors}\n    indegree = {color: 0 for color in colors}\n    for lower, upper in edges:\n        if upper not in followers[lower]:\n            followers[lower].add(upper)\n            indegree[upper] += 1\n\n    order: list[int] = []\n    ready = [color for color in colors if indegree[color] == 0]\n    while ready:\n        assert len(ready) == 1, \"layer order must be uniquely determined\"\n        color = ready.pop()\n        order.append(color)\n        for nxt in followers[color]:\n            indegree[nxt] -= 1\n            if indegree[nxt] == 0:\n                ready.append(nxt)\n\n    assert len(order) == len(colors), \"layer graph must be acyclic\"\n    return order\n\n\ndef _solve_lengths_and_order(grid: np.ndarray) -> tuple[dict[int, int], list[int], int]:\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = _bg_color(g)\n    colors = [int(color) for color in np.unique(g) if int(color) != bg]\n    assert len(colors) >= 2\n\n    visible = {color: int(np.count_nonzero(g == color)) for color in colors}\n    hidden = {color: 0 for color in colors}\n    edges: set[tuple[int, int]] = set()\n\n    for row in range(h):\n        for col in range(w):\n            top = int(g[row, col])\n            if top == bg:\n                continue\n            under_candidates: list[int] = []\n            for color in colors:\n                if color == top:\n                    continue\n                if _hidden_orientation(g, color, row, col) is not None:\n                    under_candidates.append(color)\n            assert len(under_candidates) <= 1, \"each crossing may hide at most one path\"\n            if under_candidates:\n                lower = under_candidates[0]\n                hidden[lower] += 1\n                edges.add((lower, top))\n\n    lengths = {color: visible[color] + hidden[color] for color in colors}\n    for color, length in lengths.items():\n        assert 1 <= length <= w, f\"path color {color} does not fit output width\"\n\n    order = _unique_topological_order(colors, edges)\n    return lengths, order, bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recover hidden crossing pixels, infer the global layer order, then flatten each path.\"\"\"\n    g = np.asarray(grid, dtype=int)\n    lengths, order, bg = _solve_lengths_and_order(g)\n    out = np.full((2 * len(order) - 1, g.shape[1]), bg, dtype=int)\n    for idx, color in enumerate(order):\n        out[2 * idx, : lengths[color]] = color\n    return out\n\n\nGRID_HEIGHT_RANGE = (9, 14)\nGRID_WIDTH_MAX_EXCLUSIVE = 25\nPATH_COUNT_RANGE = (3, 7)\nBENT_VERTICAL_PROB = 0.5\nMAX_GENERATION_ATTEMPTS = 400\nPALETTE = tuple(range(10))\n\n\ndef _horizontal_cells(width: int, row: int) -> set[tuple[int, int]]:\n    return {(row, col) for col in range(width)}\n\n\ndef _vertical_cells(height: int, base_col: int, turn_row: int | None = None, end_col: int | None = None) -> set[tuple[int, int]]:\n    if turn_row is None or end_col is None or end_col == base_col:\n        return {(row, base_col) for row in range(height)}\n\n    step = 1 if end_col > base_col else -1\n    cells = {(row, base_col) for row in range(turn_row + 1)}\n    cells.update((turn_row, col) for col in range(base_col, end_col + step, step))\n    cells.update((row, end_col) for row in range(turn_row, height))\n    return cells\n\n\ndef _render_paths(shape: tuple[int, int], bg: int, paths: list[dict[str, object]]) -> np.ndarray:\n    grid = np.full(shape, bg, dtype=int)\n    for path in paths:\n        color = int(path[\"color\"])\n        for row, col in path[\"cells\"]:\n            grid[row, col] = color\n    return grid\n\n\ndef _expected_output(width: int, bg: int, paths: list[dict[str, object]]) -> np.ndarray:\n    out = np.full((2 * len(paths) - 1, width), bg, dtype=int)\n    for idx, path in enumerate(paths):\n        out[2 * idx, : int(path[\"length\"])] = int(path[\"color\"])\n    return out\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    height = int(rng.integers(*GRID_HEIGHT_RANGE))\n    width_min = max(height + 2, 16)\n    if width_min >= GRID_WIDTH_MAX_EXCLUSIVE:\n        return None\n    width = int(rng.integers(width_min, GRID_WIDTH_MAX_EXCLUSIVE))\n\n    path_count = int(rng.integers(*PATH_COUNT_RANGE))\n    start_with_horizontal = bool(rng.integers(0, 2))\n    orientations = [\n        \"H\" if ((idx % 2 == 0) == start_with_horizontal) else \"V\"\n        for idx in range(path_count)\n    ]\n    horizontal_count = orientations.count(\"H\")\n    vertical_count = orientations.count(\"V\")\n\n    horizontal_rows = list(range(1, height - 1, 2))\n    base_columns = list(range(2, width - 2, 4))\n    turn_rows = list(range(2, height - 1, 2))\n    if len(horizontal_rows) < horizontal_count or len(base_columns) < vertical_count or not turn_rows:\n        return None\n\n    chosen_rows = rng.choice(horizontal_rows, size=horizontal_count, replace=False).tolist()\n    chosen_cols = rng.choice(base_columns, size=vertical_count, replace=False).tolist()\n    rng.shuffle(chosen_rows)\n    rng.shuffle(chosen_cols)\n\n    colors = rng.choice(PALETTE, size=path_count + 1, replace=False).tolist()\n    bg = int(colors[0])\n    path_colors = [int(color) for color in colors[1:]]\n\n    paths: list[dict[str, object]] = []\n    h_idx = 0\n    v_idx = 0\n    for layer_idx, orientation in enumerate(orientations):\n        color = path_colors[layer_idx]\n        if orientation == \"H\":\n            row = int(chosen_rows[h_idx])\n            h_idx += 1\n            cells = _horizontal_cells(width, row)\n            paths.append(\n                {\n                    \"color\": color,\n                    \"cells\": cells,\n                    \"length\": len(cells),\n                }\n            )\n            continue\n\n        base_col = int(chosen_cols[v_idx])\n        v_idx += 1\n        bent = bool(rng.random() < BENT_VERTICAL_PROB)\n        end_col = base_col\n        turn_row = None\n        if bent:\n            shift = int(rng.choice([-1, 1]))\n            if 1 <= base_col + shift <= width - 2:\n                end_col = base_col + shift\n                turn_row = int(rng.choice(turn_rows))\n        cells = _vertical_cells(height, base_col, turn_row, end_col)\n        if len(cells) > width:\n            return None\n        paths.append(\n            {\n                \"color\": color,\n                \"cells\": cells,\n                \"length\": len(cells),\n            }\n        )\n\n    grid = _render_paths((height, width), bg, paths)\n    expected = _expected_output(width, bg, paths)\n    if not np.array_equal(main(grid), expected):\n        return None\n    if len({tuple(cell) for path in paths for cell in path[\"cells\"]}) == 0:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo_new/seed262781723/5/6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/combo_new/seed262781723/5/6.py\"","aggregated_output":"from __future__ import annotations\n\nimport random\n\nimport numpy as np\n\n\nBG = 0\nMARKER = 5\nPATH_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nMAX_GENERATION_ATTEMPTS = 400\n\n\ndef _ray_path_color(\n    grid: np.ndarray,\n    row: int,\n    col: int,\n    dr: int,\n    dc: int,\n    play_width: int,\n) -> int | None:\n    \"\"\"Walk away from a grey crossing until a colored path segment or background appears.\"\"\"\n    h = grid.shape[0]\n    rr = row + dr\n    cc = col + dc\n    while 0 <= rr < h and 0 <= cc < play_width:\n        value = int(grid[rr, cc])\n        if value == BG:\n            return None\n        if value != MARKER:\n            return value\n        rr += dr\n        cc += dc\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repaint grey crossing markers with the highest-priority path color and remove the edge legend column.\n\n    Input structure:\n    - The background is black.\n    - Several differently colored single-pixel orthogonal paths run through the grid; each path is 4-connected and its endpoints lie on the outer border.\n    - Whenever two or more paths share one crossing pixel, that shared pixel is replaced by a special grey marker.\n    - The rightmost column contains a vertical color legend whose colored cells, read top to bottom, encode path priority from highest to lowest.\n\n    Rule:\n    - Read the non-background cells of the rightmost column from top to bottom to obtain the priority order.\n    - Remove the legend column in the output.\n    - For each grey crossing marker, trace outward in the four cardinal directions to find which path colors meet at that pixel.\n    - Recolor the grey crossing with the highest-priority color among those incident paths, while leaving every non-crossing path pixel and every background pixel unchanged.\n\n    Key insight:\n    - The grey cells mark exactly where arbitration is needed, and the winner is not determined geometrically; it is determined by the separate priority legend on the grid edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be two-dimensional\"\n    h, w = g.shape\n    assert h >= 3 and w >= 3, \"grid must have room for content and a legend column\"\n\n    legend = [int(v) for v in g[:, -1] if int(v) not in {BG, MARKER}]\n    assert legend, \"expected at least one legend color in the rightmost column\"\n    assert len(set(legend)) == len(legend), \"legend colors must be unique\"\n    priority = {color: rank for rank, color in enumerate(legend)}\n\n    out = g[:, :-1].copy()\n    play_width = w - 1\n\n    for row, col in np.argwhere(g[:, :-1] == MARKER):\n        row = int(row)\n        col = int(col)\n        incident: set[int] = set()\n        for dr, dc in DIRS4:\n            color = _ray_path_color(g, row, col, dr, dc, play_width)\n            if color is None:\n                continue\n            assert color in priority, f\"path color {color} is missing from the legend\"\n            incident.add(int(color))\n\n        assert incident, f\"grey marker at {(row, col)} has no incident path colors\"\n        out[row, col] = min(incident, key=priority.get)\n\n    return out\n\n\ndef _sample_even_positions(limit: int, low: int, high: int) -> list[int]:\n    return [v for v in range(low, high + 1) if 0 <= v < limit and v % 2 == 0]\n\n\ndef _add_cells(cell_to_colors: dict[tuple[int, int], set[int]], cells: list[tuple[int, int]], color: int) -> None:\n    for cell in cells:\n        cell_to_colors.setdefault(cell, set()).add(int(color))\n\n\ndef _vertical_path_cells(height: int, col: int) -> list[tuple[int, int]]:\n    return [(row, col) for row in range(height)]\n\n\ndef _left_bent_path_cells(height: int, row: int, turn_col: int, target: str) -> list[tuple[int, int]]:\n    assert target in {\"top\", \"bottom\"}\n    cells = {(row, col) for col in range(turn_col + 1)}\n    if target == \"top\":\n        cells.update((rr, turn_col) for rr in range(row + 1))\n    else:\n        cells.update((rr, turn_col) for rr in range(row, height))\n    return sorted(cells)\n\n\ndef _legend_rows(height: int, count: int) -> list[int]:\n    rows = sorted(random.sample(range(height), count))\n    return [int(r) for r in rows]\n\n\ndef _expected_output(\n    grid: np.ndarray,\n    intersections: dict[tuple[int, int], set[int]],\n    priority_order: list[int],\n) -> np.ndarray:\n    priority = {color: rank for rank, color in enumerate(priority_order)}\n    out = grid[:, :-1].copy()\n    for (row, col), colors in intersections.items():\n        out[row, col] = min(colors, key=priority.get)\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    height = random.choice(list(range(12, 25, 2)))\n    core_width = random.randint(11, 22)\n    total_width = core_width + 2  # blank separator + legend\n\n    vertical_candidates = [col for col in range(3, core_width - 2, 2)]\n    turn_candidates = [col for col in range(4, core_width - 1, 2)]\n    if not vertical_candidates or not turn_candidates:\n        return None\n\n    all_path_rows = _sample_even_positions(height, 2, height - 3)\n    top_row_candidates = [row for row in all_path_rows if row < height // 2]\n    bottom_row_candidates = [row for row in all_path_rows if row > height // 2]\n    if not top_row_candidates and not bottom_row_candidates:\n        return None\n\n    n_vertical = random.randint(1, min(4, len(vertical_candidates)))\n    vertical_cols = sorted(random.sample(vertical_candidates, n_vertical))\n    eligible_turns = [col for col in turn_candidates if col > vertical_cols[0]]\n    if not eligible_turns:\n        return None\n\n    max_left = min(3, len(eligible_turns), len(all_path_rows))\n    if max_left == 0:\n        return None\n    n_left = random.randint(1, max_left)\n\n    feasible_top_counts = [\n        n_top\n        for n_top in range(n_left + 1)\n        if n_top <= len(top_row_candidates) and (n_left - n_top) <= len(bottom_row_candidates)\n    ]\n    if not feasible_top_counts:\n        return None\n    n_top = random.choice(feasible_top_counts)\n    n_bottom = n_left - n_top\n\n    top_rows = sorted(random.sample(top_row_candidates, n_top)) if n_top else []\n    bottom_rows = sorted(random.sample(bottom_row_candidates, n_bottom)) if n_bottom else []\n\n    chosen_turns = random.sample(eligible_turns, n_left)\n    top_turns = sorted(chosen_turns[:n_top]) if n_top else []\n    bottom_turns = sorted(chosen_turns[n_top:], reverse=True) if n_bottom else []\n\n    total_paths = n_vertical + n_left\n    colors = random.sample(PATH_COLORS, total_paths)\n    vertical_colors = colors[:n_vertical]\n    left_colors = colors[n_vertical:]\n    priority_order = random.sample(colors, len(colors))\n\n    grid = np.full((height, total_width), BG, dtype=int)\n    cell_to_colors: dict[tuple[int, int], set[int]] = {}\n\n    vertical_paths = list(zip(vertical_cols, vertical_colors, strict=True))\n    for col, color in vertical_paths:\n        _add_cells(cell_to_colors, _vertical_path_cells(height, int(col)), int(color))\n\n    left_specs: list[tuple[int, int, str, int]] = []\n    color_index = 0\n    for row, turn in zip(top_rows, top_turns, strict=True):\n        color = int(left_colors[color_index])\n        color_index += 1\n        left_specs.append((int(row), int(turn), \"top\", color))\n    for row, turn in zip(bottom_rows, bottom_turns, strict=True):\n        color = int(left_colors[color_index])\n        color_index += 1\n        left_specs.append((int(row), int(turn), \"bottom\", color))\n\n    for row, turn_col, target, color in left_specs:\n        _add_cells(cell_to_colors, _left_bent_path_cells(height, row, turn_col, target), color)\n\n    intersections = {\n        cell: colors_here\n        for cell, colors_here in cell_to_colors.items()\n        if len(colors_here) >= 2\n    }\n    if not intersections:\n        return None\n    if any(len(colors_here) != 2 for colors_here in intersections.values()):\n        return None\n\n    for row, turn_col, _target, color in left_specs:\n        crossed = [\n            col\n            for col, vertical_color in vertical_paths\n            if col <= turn_col and intersections.get((row, col)) == {int(color), int(vertical_color)}\n        ]\n        if not crossed:\n            return None\n\n    for (row, col), colors_here in cell_to_colors.items():\n        if len(colors_here) == 1:\n            grid[row, col] = next(iter(colors_here))\n        else:\n            grid[row, col] = MARKER\n\n    legend_col = total_width - 1\n    for row, color in zip(_legend_rows(height, total_paths), priority_order, strict=True):\n        grid[row, legend_col] = int(color)\n\n    expected = _expected_output(grid, intersections, priority_order)\n    try:\n        actual = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
