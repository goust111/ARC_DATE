{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py /home/lixinyu/snap/new/ARC_code/train/d749d46f.py /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py /home/lixinyu/snap/new/ARC_code/train/e3f79277.py /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py /home/lixinyu/snap/new/ARC_code/train/34cfa167.py; do echo \"===== $f : main =====\"; sed -n '\"'/\"'^def main(/,/''^def generate_input(/p'\"' \\\"\"'$f\"; echo; echo \"===== $f : generate_input =====\"; sed -n '\"'/\"'^def generate_input(/,$p'\"' \\\"\"'$f\"; echo; done'","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n\n===== /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py : generate_input =====\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n===== /home/lixinyu/snap/new/ARC_code/train/d749d46f.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\nORIENTATIONS = (\"vertical\", \"horizontal\")\n\n# Coarse layout and final route validation thresholds.\nLAYOUT_DISTANCE_MIN = 36\nLAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\nSHORTEST_DISTANCE_MIN = 36\nSHORTEST_DISTANCE_MAX = 72\nTURN_MIN = 8\nTURN_MAX = 21\nON_ROUTE_ROOM_MIN = 6\nON_ROUTE_ROOM_MAX = 14\nOFF_ROUTE_ROOM_MIN = 1\nOFF_ROUTE_ROOM_MAX = 8\n\n# Connector sampling: offset connectors create the observed middle fill region.\nOFFSET_CONNECTOR_PROB = 0.60\nCONNECTOR_CHOICE_TRIES = 300\nCONNECTOR_DELTA_MAX = 12\nCONNECTOR_DELTA_MIN_CAP = 5\n\n# Endpoint room selection favors far rooms, with a minority near-exit branch.\nNEAR_EXIT_ENDPOINT_PROB = 0.30\nNEAR_EXIT_STEPS = [-1, 0, 1]\n\n# Full-example rejection retries.\nGENERATE_ATTEMPTS = 300\n\n_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n_LAYOUTS = None\n_LAST_META = None\n\n\ndef _block_shape(rows, cols, size):\n    return rows * (size + 1) + 1, cols * (size + 1) + 1\n\n\ndef _room_topleft(room_r, room_c, size):\n    return 1 + room_r * (size + 1), 1 + room_c * (size + 1)\n\n\ndef _layout_distance_estimate(r1, c1, s1, r2, c2, s2, gap):\n    return (r1 + c1 - 2) * (s1 + 1) + (r2 + c2 - 2) * (s2 + 1) + s1 + s2 + gap\n\n\ndef _layout_fits(orientation, bh1, bw1, bh2, bw2, gap):\n    if orientation == \"vertical\":\n        return bh1 + gap + bh2 <= ROW_MAX and max(bw1, bw2) <= COL_MAX\n    return bw1 + gap + bw2 <= COL_MAX and max(bh1, bh2) <= ROW_MAX\n\n\ndef _build_layouts():\n    \"\"\"Enumerate all layout parameter tuples before random sampling.\"\"\"\n    layouts = []\n    for orientation in ORIENTATIONS:\n        for s1 in ROOM_SIZE_RANGE:\n            for s2 in ROOM_SIZE_RANGE:\n                for r1 in ROOM_GRID_RANGE:\n                    for c1 in ROOM_GRID_RANGE:\n                        n1 = r1 * c1\n                        if not BLOCK_ROOM_MIN <= n1 <= BLOCK_ROOM_MAX:\n                            continue\n                        bh1, bw1 = _block_shape(r1, c1, s1)\n                        for r2 in ROOM_GRID_RANGE:\n                            for c2 in ROOM_GRID_RANGE:\n                                n2 = r2 * c2\n                                total_rooms = n1 + n2\n                                valid_block2 = BLOCK_ROOM_MIN <= n2 <= BLOCK_ROOM_MAX\n                                valid_total = TOTAL_ROOM_MIN <= total_rooms <= TOTAL_ROOM_MAX\n                                if not (valid_block2 and valid_total):\n                                    continue\n                                bh2, bw2 = _block_shape(r2, c2, s2)\n                                for gap in GAP_RANGE:\n                                    approx = _layout_distance_estimate(r1, c1, s1, r2, c2, s2, gap)\n                                    if approx < LAYOUT_DISTANCE_MIN:\n                                        continue\n                                    if _layout_fits(orientation, bh1, bw1, bh2, bw2, gap):\n                                        layouts.append((orientation, s1, s2, r1, c1, r2, c2, gap, approx))\n    return layouts\n\n\ndef _layouts():\n    global _LAYOUTS\n    if _LAYOUTS is None:\n        _LAYOUTS = _build_layouts()\n    return _LAYOUTS\n\n\ndef _choose_layout():\n    layouts = _layouts()\n    lo = random.choice(LAYOUT_DISTANCE_FLOORS)\n    candidates = [layout for layout in layouts if layout[-1] >= lo]\n    if not candidates:\n        candidates = layouts\n    return random.choice(candidates)\n\n\ndef _side_positions(count, size):\n    positions = []\n    for index in range(count):\n        for offset in range(size):\n            positions.append((1 + index * (size + 1) + offset, index, offset))\n    return positions\n\n\ndef _connector_delta(span, offset_connector):\n    if not offset_connector:\n        return 0\n    max_delta = min(CONNECTOR_DELTA_MAX, span - 1)\n    min_delta = min(CONNECTOR_DELTA_MIN_CAP, max_delta)\n    if min_delta <= 1:\n        return None\n    return random.choice((-1, 1)) * random.randint(min_delta, max_delta)\n\n\ndef _side_connector_choice(span_lo, span_hi, size1, side_positions1, size2, side_positions2, offset_connector):\n    \"\"\"Pick compatible starts and exit offsets along the shared span.\"\"\"\n    for _ in range(CONNECTOR_CHOICE_TRIES):\n        span = random.randint(span_lo, span_hi)\n        local1, index1, offset1 = random.choice(side_positions1)\n        local2, index2, offset2 = random.choice(side_positions2)\n        delta = _connector_delta(span, offset_connector)\n        if delta is None:\n            continue\n\n        shift = local1 + delta - local2\n        lo = max(0, -shift)\n        hi = min(span - size1, span - size2 - shift)\n        if lo > hi:\n            continue\n        start1 = random.randint(lo, hi)\n        start2 = start1 + shift\n        exit1 = start1 + local1\n        exit2 = start2 + local2\n        common_lo = max(start1 + 1, start2 + 1)\n        common_hi = min(start1 + size1 - 2, start2 + size2 - 2)\n        if min(exit1, exit2) < common_lo or max(exit1, exit2) > common_hi:\n            continue\n        return span, start1, start2, exit1, exit2, index1, offset1, index2, offset2\n    return None\n\n\ndef _make_block(rows, cols, size, exit_side, exit_index=None, exit_offset=None):\n    h, w = _block_shape(rows, cols, size)\n    block = np.full((h, w), BG, dtype=int)\n    block[:: size + 1, :] = WALL\n    block[:, :: size + 1] = WALL\n\n    for i in range(1, rows):\n        wr = i * (size + 1)\n        for j in range(cols):\n            c0 = 1 + j * (size + 1)\n            block[wr, c0 + random.randrange(size)] = BG\n    for j in range(1, cols):\n        wc = j * (size + 1)\n        for i in range(rows):\n            r0 = 1 + i * (size + 1)\n            block[r0 + random.randrange(size), wc] = BG\n\n    if exit_side == \"bottom\":\n        side_index = random.randrange(cols) if exit_index is None else int(exit_index)\n        offset = random.randrange(size) if exit_offset is None else int(exit_offset)\n        room = (rows - 1, side_index)\n        rr = h - 1\n        cc = 1 + room[1] * (size + 1) + offset\n    elif exit_side == \"top\":\n        side_index = random.randrange(cols) if exit_index is None else int(exit_index)\n        offset = random.randrange(size) if exit_offset is None else int(exit_offset)\n        room = (0, side_index)\n        rr = 0\n        cc = 1 + room[1] * (size + 1) + offset\n    elif exit_side == \"right\":\n        side_index = random.randrange(rows) if exit_index is None else int(exit_index)\n        offset = random.randrange(size) if exit_offset is None else int(exit_offset)\n        room = (side_index, cols - 1)\n        rr = 1 + room[0] * (size + 1) + offset\n        cc = w - 1\n    else:\n        side_index = random.randrange(rows) if exit_index is None else int(exit_index)\n        offset = random.randrange(size) if exit_offset is None else int(exit_offset)\n        room = (side_index, 0)\n        rr = 1 + room[0] * (size + 1) + offset\n        cc = 0\n    block[rr, cc] = BG\n    return block, (rr, cc), room\n\n\ndef _choose_endpoint_axis(length, exit_index):\n    if length == 1:\n        return 0\n    if random.random() < NEAR_EXIT_ENDPOINT_PROB:\n        return min(length - 1, max(0, exit_index + random.choice(NEAR_EXIT_STEPS)))\n    far = max(abs(i - exit_index) for i in range(length))\n    return random.choice([i for i in range(length) if abs(i - exit_index) == far])\n\n\ndef _choose_endpoint_room(rows, cols, exit_room, exit_side):\n    er, ec = exit_room\n    if exit_side == \"bottom\":\n        return (0 if rows > 1 else er), _choose_endpoint_axis(cols, ec)\n    if exit_side == \"top\":\n        return (rows - 1 if rows > 1 else er), _choose_endpoint_axis(cols, ec)\n    if exit_side == \"right\":\n        return _choose_endpoint_axis(rows, er), (0 if cols > 1 else ec)\n    return _choose_endpoint_axis(rows, er), (cols - 1 if cols > 1 else ec)\n\n\ndef _room_interiors(rows, cols, size, origin_r, origin_c):\n    rooms = []\n    for rr in range(rows):\n        for cc in range(cols):\n            lr, lc = _room_topleft(rr, cc, size)\n            rooms.append((origin_r + lr, origin_c + lc, size))\n    return rooms\n\n\ndef _paint_endpoint(grid, origin_r, origin_c, room, size, paint):\n    lr, lc = _room_topleft(*room, size)\n    grid[origin_r + lr : origin_r + lr + size, origin_c + lc : origin_c + lc + size] = paint\n\n\ndef _place_vertical(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector):\n    bh1, bw1 = _block_shape(r1, c1, s1)\n    bh2, bw2 = _block_shape(r2, c2, s2)\n    hmin = bh1 + gap + bh2\n    h = random.randint(max(ROW_MIN, hmin), ROW_MAX)\n    choice = _side_connector_choice(\n        max(COL_MIN, bw1, bw2),\n        COL_MAX,\n        bw1,\n        _side_positions(c1, s1),\n        bw2,\n        _side_positions(c2, s2),\n        offset_connector,\n    )\n    if choice is None:\n        return None\n    w, c_1, c_2, exit_col1, exit_col2, index1, offset1, index2, offset2 = choice\n    b1, exit1, exit_room1 = _make_block(r1, c1, s1, \"bottom\", index1, offset1)\n    b2, exit2, exit_room2 = _make_block(r2, c2, s2, \"top\", index2, offset2)\n    top = random.randint(0, h - hmin)\n    r_1 = top\n    r_2 = top + bh1 + gap\n    grid = np.full((h, w), BG, dtype=int)\n    paste(grid, b1, r_1, c_1)\n    paste(grid, b2, r_2, c_2)\n    if exit_col1 == exit_col2:\n        draw_line(grid, r_1 + exit1[0], exit_col1, end_r=r_2 + exit2[0], end_c=exit_col1, color=BG)\n\n    ep1 = _choose_endpoint_room(r1, c1, exit_room1, \"bottom\")\n    ep2 = _choose_endpoint_room(r2, c2, exit_room2, \"top\")\n    rooms = _room_interiors(r1, c1, s1, r_1, c_1) + _room_interiors(r2, c2, s2, r_2, c_2)\n    _paint_endpoint(grid, r_1, c_1, ep1, s1, paint)\n    _paint_endpoint(grid, r_2, c_2, ep2, s2, paint)\n    meta = {\n        \"orientation\": \"vertical\",\n        \"gap\": gap,\n        \"connector_delta\": abs(exit_col2 - exit_col1),\n        \"blocks\": [{\"rows\": r1, \"cols\": c1, \"size\": s1}, {\"rows\": r2, \"cols\": c2, \"size\": s2}],\n    }\n    return grid, rooms, meta\n\n\ndef _place_horizontal(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector):\n    bh1, bw1 = _block_shape(r1, c1, s1)\n    bh2, bw2 = _block_shape(r2, c2, s2)\n    wmin = bw1 + gap + bw2\n    w = random.randint(max(COL_MIN, wmin), COL_MAX)\n    choice = _side_connector_choice(\n        max(ROW_MIN, bh1, bh2),\n        ROW_MAX,\n        bh1,\n        _side_positions(r1, s1),\n        bh2,\n        _side_positions(r2, s2),\n        offset_connector,\n    )\n    if choice is None:\n        return None\n    h, r_1, r_2, exit_row1, exit_row2, index1, offset1, index2, offset2 = choice\n    b1, exit1, exit_room1 = _make_block(r1, c1, s1, \"right\", index1, offset1)\n    b2, exit2, exit_room2 = _make_block(r2, c2, s2, \"left\", index2, offset2)\n    left = random.randint(0, w - wmin)\n    c_1 = left\n    c_2 = left + bw1 + gap\n    grid = np.full((h, w), BG, dtype=int)\n    paste(grid, b1, r_1, c_1)\n    paste(grid, b2, r_2, c_2)\n    if exit_row1 == exit_row2:\n        draw_line(grid, exit_row1, c_1 + exit1[1], end_r=exit_row1, end_c=c_2 + exit2[1], color=BG)\n\n    ep1 = _choose_endpoint_room(r1, c1, exit_room1, \"right\")\n    ep2 = _choose_endpoint_room(r2, c2, exit_room2, \"left\")\n    rooms = _room_interiors(r1, c1, s1, r_1, c_1) + _room_interiors(r2, c2, s2, r_2, c_2)\n    _paint_endpoint(grid, r_1, c_1, ep1, s1, paint)\n    _paint_endpoint(grid, r_2, c_2, ep2, s2, paint)\n    meta = {\n        \"orientation\": \"horizontal\",\n        \"gap\": gap,\n        \"connector_delta\": abs(exit_row2 - exit_row1),\n        \"blocks\": [{\"rows\": r1, \"cols\": c1, \"size\": s1}, {\"rows\": r2, \"cols\": c2, \"size\": s2}],\n    }\n    return grid, rooms, meta\n\n\ndef _place_layout(layout, paint, offset_connector):\n    orientation, s1, s2, r1, c1, r2, c2, gap, _ = layout\n    if orientation == \"vertical\":\n        return _place_vertical(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector)\n    return _place_horizontal(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector)\n\n\ndef _bfs_path_stats(grid, paint):\n    \"\"\"Return one shortest path's distance and turn count between paint components.\"\"\"\n    comps = find_components(grid, bg=BG, colors=[paint], connectivity=4)\n    if len(comps) != 2:\n        return None\n    passable = grid != WALL\n    h, w = grid.shape\n    dist = np.full((h, w), -1, dtype=int)\n    parent = np.full((h, w, 2), -2, dtype=int)\n    q = deque()\n    for r, c in comps[0][\"coords\"]:\n        rr = int(r)\n        cc = int(c)\n        if dist[rr, cc] < 0:\n            dist[rr, cc] = 0\n            parent[rr, cc] = (-1, -1)\n            q.append((rr, cc))\n\n    while q:\n        r, c = q.popleft()\n        for dr, dc in _NEIGHBORS4:\n            nr = r + dr\n            nc = c + dc\n            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:\n                dist[nr, nc] = dist[r, c] + 1\n                parent[nr, nc] = (r, c)\n                q.append((nr, nc))\n\n    targets = [(int(r), int(c)) for r, c in comps[1][\"coords\"] if dist[int(r), int(c)] >= 0]\n    if len(targets) != len(comps[1][\"coords\"]):\n        return None\n    target = min(targets, key=lambda rc: int(dist[rc]))\n    shortest = int(dist[target])\n    path = []\n    cur = target\n    while cur != (-1, -1):\n        path.append(cur)\n        pr, pc = parent[cur]\n        cur = (int(pr), int(pc))\n    path.reverse()\n\n    dirs = []\n    for (r0, c0), (r1, c1) in zip(path, path[1:]):\n        dirs.append((r1 - r0, c1 - c0))\n    turns = sum(1 for a, b in zip(dirs, dirs[1:]) if a != b)\n    return shortest, turns\n\n\ndef _shortest_route_mask(grid, comps):\n    \"\"\"Return the all-shortest-path mask and distance between endpoint components.\"\"\"\n    passable = grid != WALL\n    dist0 = _distances_from(comps[0][\"coords\"], passable)\n    dist1 = _distances_from(comps[1][\"coords\"], passable)\n    target_dists = [int(dist0[int(r), int(c)]) for r, c in comps[1][\"coords\"]]\n    if any(d < 0 for d in target_dists):\n        return None\n    shortest = min(target_dists)\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    if not np.any(route):\n        return None\n    return route, shortest\n\n\ndef _endpoint_room_sizes(comps):\n    sizes = set()\n    for coords in [comps[0][\"coords\"], comps[1][\"coords\"]]:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        sizes.add(max(r1 - r0 + 1, c1 - c0 + 1))\n    return sizes\n\n\ndef _fill_route_rooms(grid, route, comps):\n    fill = route.copy()\n    for r, c, n in _framed_square_rooms(grid, WALL, _endpoint_room_sizes(comps)):\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n    return fill\n\n\ndef _route_room_set(fill, rooms):\n    on_route_rooms = set()\n    for r, c, n in rooms:\n        if np.any(fill[r : r + n, c : c + n]):\n            on_route_rooms.add((r, c, n))\n    return on_route_rooms\n\n\ndef _room_boundary_cells(r, c, n):\n    for cc in range(c, c + n):\n        yield r - 1, cc\n    for cc in range(c, c + n):\n        yield r + n, cc\n    for rr in range(r, r + n):\n        yield rr, c - 1\n    for rr in range(r, r + n):\n        yield rr, c + n\n\n\ndef _seal_off_route_rooms(grid, rooms, on_route_rooms):\n    h, w = grid.shape\n    for r, c, n in rooms:\n        if (r, c, n) in on_route_rooms:\n            continue\n        for rr, cc in _room_boundary_cells(r, c, n):\n            if 0 <= rr < h and 0 <= cc < w and grid[rr, cc] != WALL:\n                grid[rr, cc] = WALL\n\n\ndef _path_stats_valid(shortest, turns):\n    return SHORTEST_DISTANCE_MIN <= shortest <= SHORTEST_DISTANCE_MAX and TURN_MIN <= turns <= TURN_MAX\n\n\ndef _room_counts_valid(on_route, off_route):\n    return ON_ROUTE_ROOM_MIN <= on_route <= ON_ROUTE_ROOM_MAX and OFF_ROUTE_ROOM_MIN <= off_route <= OFF_ROUTE_ROOM_MAX\n\n\ndef _solver_accepts(grid):\n    try:\n        main(grid)\n    except Exception:\n        return False\n    return True\n\n\ndef _gen_attempt():\n    global _LAST_META\n    layout = _choose_layout()\n    paint = random.choice(PAINT_COLORS)\n    placed = _place_layout(layout, paint, random.random() < OFFSET_CONNECTOR_PROB)\n    if placed is None:\n        return None\n\n    grid, rooms, meta = placed\n    comps = find_components(grid, bg=BG, colors=[paint], connectivity=4)\n    if len(comps) != 2:\n        return None\n\n    route_info = _shortest_route_mask(grid, comps)\n    if route_info is None:\n        return None\n    route, shortest = route_info\n    on_route_rooms = _route_room_set(_fill_route_rooms(grid, route, comps), rooms)\n\n    path = _bfs_path_stats(grid, paint)\n    if path is None:\n        return None\n    shortest_p, turns = path\n    if not _path_stats_valid(shortest_p, turns):\n        return None\n\n    on_route = len(on_route_rooms)\n    off_route = len(rooms) - on_route\n    if not _room_counts_valid(on_route, off_route):\n        return None\n\n    _seal_off_route_rooms(grid, rooms, on_route_rooms)\n    if not _solver_accepts(grid):\n        return None\n\n    meta[\"shortest_distance\"] = shortest\n    meta[\"turns_on_single_path\"] = turns\n    meta[\"rooms_on_route\"] = on_route\n    meta[\"rooms_off_route\"] = off_route\n    _LAST_META = meta\n    return grid\n\n\ndef generate_input():\n\n===== /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py : generate_input =====\ndef generate_input():\n    for _ in range(GENERATE_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 3ad05f52 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/e3f79277.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace a corner L with a same-color right-triangle outline in the corresponding corner of an enlarged canvas.\n\n    Input structure:\n    - The input is a square grid with one background color and one foreground color.\n    - The foreground is a one-pixel-thick L inside a square bbox.\n    - The L touches exactly one horizontal grid edge and one vertical grid edge, identifying a corner.\n\n    Rule:\n    - Fill a square output canvas of side 3n-2, where n is the input side length, with the background color.\n    - Double the L leg length to get the triangle side length.\n    - Draw the two perpendicular triangle legs on the same output corner edges and connect their free endpoints with the diagonal.\n\n    Key insight:\n    - The input L encodes the corner, color, and side length of the triangle outline; the missing side is the diagonal between the L's two free endpoints.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    assert height == width, \"expected a square input grid\"\n\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    coords = np.argwhere(mask)\n    assert coords.size > 0, \"expected a foreground L\"\n    r0, c0 = map(int, coords.min(axis=0))\n    r1, c1 = map(int, coords.max(axis=0))\n    leg_len = r1 - r0 + 1\n    assert leg_len == c1 - c0 + 1, \"expected the L bbox to be square\"\n    assert leg_len > 1, \"expected a nontrivial L\"\n\n    touches_top = r0 == 0\n    touches_bottom = r1 == height - 1\n    touches_left = c0 == 0\n    touches_right = c1 == width - 1\n    assert sum((touches_top, touches_bottom)) == 1, \"expected the L to touch one horizontal grid edge\"\n    assert sum((touches_left, touches_right)) == 1, \"expected the L to touch one vertical grid edge\"\n\n    expected = np.zeros_like(mask, dtype=bool)\n    edge_row = r0 if touches_top else r1\n    edge_col = c0 if touches_left else c1\n    expected[edge_row, c0 : c1 + 1] = True\n    expected[r0 : r1 + 1, edge_col] = True\n    assert np.array_equal(mask, expected), \"expected foreground to be exactly a corner L\"\n\n    out_size = 3 * height - 2\n    side = 2 * leg_len\n    out = np.full((out_size, out_size), bg, dtype=int)\n    top = touches_top\n    left = touches_left\n    rr0 = 0 if top else out_size - side\n    cc0 = 0 if left else out_size - side\n    out_edge_row = rr0 if top else rr0 + side - 1\n    out_edge_col = cc0 if left else cc0 + side - 1\n\n    for i in range(side):\n        out[out_edge_row, cc0 + i] = fg\n        out[rr0 + i, out_edge_col] = fg\n        diag_col = side - 1 - i if top == left else i\n        out[rr0 + i, cc0 + diag_col] = fg\n\n    return out\n\n# --------------- generator (o5x) ---------------\nfrom arc_utils import bbox\n\n# Sampling bounds.\nGRID_SIZE_MIN = 4\nGRID_SIZE_MAX = 8\nLEG_LEN_MIN = 2\nCOLOR_VALUES = range(10)\nCOLOR_PAIR_SIZE = 2\nCORNER_ANCHORS = ((True, True), (True, False), (False, True), (False, False))\n\n# Output geometry and validation.\nOUTPUT_SCALE = 3\nOUTPUT_OFFSET = 2\nTRIANGLE_SIDE_SCALE = 2\nMAX_ATTEMPTS = 300\n\n\ndef _gen_expected_output(grid: np.ndarray) -> np.ndarray:\n    bg = get_bg(grid)\n    fg_values = colors_present(grid, exclude={bg})\n    if len(fg_values) != 1:\n        raise ValueError(\"expected exactly one foreground color\")\n    fg = fg_values[0]\n\n    box = bbox(grid == fg)\n    if box is None:\n        raise ValueError(\"expected a foreground L\")\n    r0, c0, r1, c1 = box\n    leg_len = r1 - r0 + 1\n    side = TRIANGLE_SIDE_SCALE * leg_len\n    out_size = OUTPUT_SCALE * grid.shape[0] - OUTPUT_OFFSET\n    out = np.full((out_size, out_size), bg, dtype=int)\n\n    top = r0 == 0\n    left = c0 == 0\n    rr0 = 0 if top else out_size - side\n    cc0 = 0 if left else out_size - side\n    edge_row = rr0 if top else rr0 + side - 1\n    edge_col = cc0 if left else cc0 + side - 1\n\n    idx = np.arange(side)\n    out[edge_row, cc0 + idx] = fg\n    out[rr0 + idx, edge_col] = fg\n    diag_cols = side - 1 - idx if top == left else idx\n    out[rr0 + idx, cc0 + diag_cols] = fg\n    return out\n\n\ndef _draw_corner_l(n: int, bg: int, fg: int, leg_len: int, corner: int) -> np.ndarray:\n    grid = np.full((n, n), bg, dtype=int)\n    top, left = CORNER_ANCHORS[corner]\n    row = 0 if top else n - 1\n    col = 0 if left else n - 1\n    row_cols = slice(0, leg_len) if left else slice(n - leg_len, n)\n    col_rows = slice(0, leg_len) if top else slice(n - leg_len, n)\n    grid[row, row_cols] = fg\n    grid[col_rows, col] = fg\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray:\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    bg, fg = random.sample(COLOR_VALUES, COLOR_PAIR_SIZE)\n    leg_len = random.randint(LEG_LEN_MIN, n - 1)\n    corner = random.randrange(len(CORNER_ANCHORS))\n    return _draw_corner_l(n, bg, fg, leg_len, corner)\n\n\ndef generate_input() -> np.ndarray:\n\n===== /home/lixinyu/snap/new/ARC_code/train/e3f79277.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        candidate = _gen_attempt()\n        expected = _gen_expected_output(candidate)\n        try:\n            actual = main(candidate)\n        except Exception:\n            continue\n        if np.array_equal(actual, expected):\n            return candidate\n    raise RuntimeError(f\"generate_input: failed after {MAX_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n        paste(grid, sprite, sr, sc, transparent=bg)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Run one output-first generation attempt and reject solver mismatches.\"\"\"\n    bg, key_colors, distractor_color = _sample_palette()\n    counts = _sample_counts(len(key_colors))\n    expected = _build_expected(key_colors, counts)\n    legend = _build_legend(expected.shape, key_colors)\n    grid = _new_grid_with_legend(bg, legend)\n    if grid is None:\n        return None\n\n    sprites = _build_sprite_queue(key_colors, counts, distractor_color, bg)\n    try:\n        _place_sprites(grid, sprites, bg)\n    except ValueError:\n        return None\n\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n===== /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58490d8a input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate a repeating striped pattern from a yellow border segment toward the opposite edge, recoloring foreground objects on certain stripes.\n\n    Input structure:\n    - bg = most common color. Foreground blobs of another color scattered in the interior.\n    - A short yellow (4) segment sits on one border edge.\n\n    Rule:\n    - From the yellow segment, march toward the opposite edge in steps of 2 cells, cycling colors Y, Y, G (4, 4, 3). The 1-cell gap between stripes is forced to bg.\n    - Yellow stripes paint only within the segment's span.\n    - Green stripes additionally recolor all non-bg pixels across the entire row/column to green.\n\n    Key insight: Green stripes act as a \"flood\" that recolors existing objects on the full row/column, while yellow stripes are confined to the segment span.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    Y = 4\n    G = 3\n\n    border = np.zeros((H, W), dtype=bool)\n    border[0, :] = True\n    border[-1, :] = True\n    border[:, 0] = True\n    border[:, -1] = True\n\n    smask = (g == int(Y)) & border\n    if not bool(smask.any()):\n        return out\n\n    lab, n = label_mask(smask, connectivity=4)\n    if int(n) <= 0:\n        return out\n\n    best_id = max(range(1, int(n) + 1), key=lambda cid: int((lab == int(cid)).sum()))\n    pts = np.argwhere(lab == int(best_id))\n\n    rs = pts[:, 0]\n    cs = pts[:, 1]\n    r0, r1 = int(rs.min()), int(rs.max())\n    c0, c1 = int(cs.min()), int(cs.max())\n\n    if r0 == r1:\n        orient = \"h\"\n        start_pos = int(r0)\n        cols = sorted(int(c) for c in cs)\n        span = list(range(int(cols[0]), int(cols[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = H\n    elif c0 == c1:\n        orient = \"v\"\n        start_pos = int(c0)\n        rows = sorted(int(r) for r in rs)\n        span = list(range(int(rows[0]), int(rows[-1]) + 1))\n        dir1 = 1 if start_pos == 0 else -1\n        limit = W\n    else:\n        # Unexpected: not a straight edge segment.\n        return out\n\n    cycle = [int(Y), int(Y), int(G)]\n\n    step = 0\n    while True:\n        pos = int(start_pos) + int(dir1) * (2 * int(step))\n        if not (0 <= pos < int(limit)):\n            break\n\n        col = int(cycle[int(step) % 3])\n\n        if orient == \"h\":\n            if col == int(G):\n                out[pos, :] = np.where(out[pos, :] != int(bg), int(G), out[pos, :])\n            for c in span:\n                out[pos, int(c)] = col\n            # Force the 1-cell gap to background within the segment span.\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < H:\n                for c in span:\n                    out[int(gap), int(c)] = int(bg)\n        else:\n            if col == int(G):\n                out[:, pos] = np.where(out[:, pos] != int(bg), int(G), out[:, pos])\n            for r in span:\n                out[int(r), pos] = col\n            gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)\n            if 0 <= gap < W:\n                for r in span:\n                    out[int(r), int(gap)] = int(bg)\n\n        step += 1\n\n    return out\n\n\n# --------------- generator ---------------\nimport random\nfrom arc_utils import random_sprite, random_free_location\n\n\ndef _gen_attempt():\n    rng = random.Random()\n\n    H = rng.randint(25, 30)\n    W = rng.randint(22, 30)\n\n    # Pick bg and fg colors (not yellow=4 or green=3)\n    available = [c for c in range(10) if c not in (3, 4)]\n    bg, fg = rng.sample(available, 2)\n\n    # Pick edge and yellow segment\n    edge = rng.choice(['top', 'bottom', 'left', 'right'])\n    seg_len = rng.randint(3, 8)\n\n    if edge in ('top', 'bottom'):\n        # horizontal segment: columns span, must not touch corners (col 0 or W-1)\n        max_start = W - 1 - seg_len  # last col of span = start + seg_len - 1 <= W-2\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'h'\n        edge_row = 0 if edge == 'top' else H - 1\n    else:\n        # vertical segment: rows span, must not touch corners (row 0 or H-1)\n        max_start = H - 1 - seg_len\n        if max_start < 1:\n            return None\n        seg_start = rng.randint(1, max_start)\n        span = list(range(seg_start, seg_start + seg_len))\n        orient = 'v'\n        edge_col = 0 if edge == 'left' else W - 1\n\n    # Start with bg grid\n    grid = np.full((H, W), bg, dtype=int)\n\n    # Place yellow segment on border\n    if orient == 'h':\n        for c in span:\n            grid[edge_row, c] = 4\n    else:\n        for r in span:\n            grid[r, edge_col] = 4\n\n    # Determine which rows/cols are on the trajectory (both stripe and gap positions)\n    # to avoid placing blobs on the edge row/col itself\n    if orient == 'h':\n        forbidden_rows = {edge_row}\n    else:\n        forbidden_cols = {edge_col}\n\n    # Scatter 5-9 amorphous fg blobs in the interior\n    n_blobs = rng.randint(5, 9)\n    canvas = grid.copy()\n\n    for _ in range(n_blobs):\n        # Random blob size: aim for 5-67 pixels, bbox dims 2-15\n        bh = rng.randint(2, 10)\n        bw = rng.randint(2, 10)\n        density = rng.uniform(0.4, 0.85)\n\n        try:\n            sprite = random_sprite(bh, bw, density=density, symmetry=\"not_symmetric\",\n                                   color_palette=[fg], connectivity=4, background=bg)\n        except (AssertionError, RecursionError):\n            continue\n\n        # Trim bg border rows/cols from sprite\n        mask = (sprite != bg)\n        rows_any = np.any(mask, axis=1)\n        cols_any = np.any(mask, axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        sprite = sprite[r0:r1+1, c0:c1+1]\n\n        sh, sw = sprite.shape\n        pix = int(np.sum(sprite != bg))\n        if pix < 5 or pix > 67:\n            continue\n\n        # Find placement: border=1 to keep away from grid edges, padding=1 for separation\n        try:\n            pr, pc = random_free_location(canvas, sprite, transparent=bg, border=1, padding=1)\n        except ValueError:\n            continue\n\n        # Check forbidden row/col constraints\n        sprite_mask = (sprite != bg)\n        blob_rows = set(int(pr + dr) for dr in range(sh) if sprite_mask[dr].any())\n        blob_cols = set(int(pc + dc) for dc in range(sw) if sprite_mask[:, dc].any())\n\n        if orient == 'h' and blob_rows & forbidden_rows:\n            continue\n        if orient == 'v' and blob_cols & forbidden_cols:\n            continue\n\n        # Paste blob\n        for dr in range(sh):\n            for dc in range(sw):\n                if sprite[dr, dc] != bg:\n                    canvas[pr + dr, pc + dc] = sprite[dr, dc]\n\n    # Count blobs placed\n    fg_mask = (canvas != bg) & (canvas != 4)\n    lab, n_placed = label_mask(fg_mask, connectivity=4)\n    if n_placed < 5:\n        return None\n\n    # Now canvas is our INPUT grid. Build the expected output via solver.\n    inp = canvas.copy()\n    out = main(inp)\n\n    # Verify bg is most common in input\n    if get_bg(inp) != bg:\n        return None\n\n    # Round-trip check\n    if not np.array_equal(main(inp), out):\n        return None\n\n    return inp#.tolist()\n\n\ndef generate_input():\n\n===== /home/lixinyu/snap/new/ARC_code/eval/221dfab4.py : generate_input =====\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n        size = _pick_bbox_size(H, W)\n        if size is None:\n            continue\n        bh, bw = size\n        rmin = random.randint(0, H - bh)\n        cmin = random.randint(0, W - bw)\n        diag = \"TLBR\" if random.random() < TLBR_PROB else \"TRBL\"\n        cells = _l_pair_cells(rmin, cmin, rmin + bh - 1, cmin + bw - 1, diag)\n        if can_place(cells):\n            do_place(cells, color)\n            return True\n    return False\n\n\ndef _build_legend(H, W, bg):\n    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n\n    Returns (grid, legend_rows, legend_mask, legend_c, legend_bot) or None on failure.\n    \"\"\"\n    legend_c = random.randint(*LEGEND_COL_RANGE)\n    legend_bot = random.choice([H - 1, H - 2])\n    n_entries = random.randint(*LEGEND_ENTRY_RANGE)\n    if legend_bot - n_entries + 1 < 0:\n        return None\n\n    pool = [c for c in range(10) if c != bg]\n    if len(pool) < n_entries:\n        return None\n    marker_colors = random.sample(pool, n_entries)\n\n    grid = np.full((H, W), bg, dtype=int)\n    legend_rows: list[tuple[int, int, int]] = []\n    legend_mask = np.zeros((H, W), dtype=bool)\n    for i in range(n_entries):\n        r = legend_bot - i\n        m = marker_colors[i]\n        fill = random.randint(0, 9)\n        legend_rows.append((r, m, fill))\n        grid[r, legend_c] = m\n        legend_mask[r, legend_c] = True\n        if legend_c + 1 < W:\n            grid[r, legend_c + 1] = fill\n            legend_mask[r, legend_c + 1] = True\n\n    return grid, legend_rows, legend_mask, legend_c, legend_bot, marker_colors\n\n\ndef _build_forbidden(H, W, legend_c, legend_bot, legend_rows):\n    \"\"\"Build the forbidden-placement mask that protects legend scan integrity.\n\n    Forbids non-bg placement in rows below legend_bot and in columns <= legend_c\n    above the legend (except legend marker cells themselves).\n    \"\"\"\n    forbidden = np.zeros((H, W), dtype=bool)\n    if legend_bot + 1 < H:\n        forbidden[legend_bot + 1:, :] = True\n    forbidden[:legend_bot + 1, :legend_c + 1] = True\n    for r, _, _ in legend_rows:\n        forbidden[r, legend_c] = False\n    return forbidden\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_H_RANGE)\n    W = random.randint(*GRID_W_RANGE)\n    bg = random.randint(0, 9)\n\n    legend_result = _build_legend(H, W, bg)\n    if legend_result is None:\n        return None\n    grid, legend_rows, legend_mask, legend_c, legend_bot, marker_colors = legend_result\n\n    forbidden = _build_forbidden(H, W, legend_c, legend_bot, legend_rows)\n    occupied = legend_mask.copy()\n\n    # Assign a marker type per legend entry.\n    n_entries = len(legend_rows)\n    types = [\"L\"] * n_entries\n    idx_pool = list(range(n_entries))\n    random.shuffle(idx_pool)\n    if random.random() < NOOP_PROB and len(idx_pool) > 1:\n        types[idx_pool.pop()] = \"noop\"\n    if random.random() < BLOCK_PROB and idx_pool:\n        types[idx_pool.pop()] = \"block\"\n\n    def can_place(cells):\n        for r, c in cells:\n            if not (0 <= r < H and 0 <= c < W):\n                return False\n            if occupied[r, c] or forbidden[r, c]:\n                return False\n        return True\n\n    def do_place(cells, color):\n        for r, c in cells:\n            grid[r, c] = color\n            occupied[r, c] = True\n\n    # Place markers for each legend entry.\n    for i, (_, m, _) in enumerate(legend_rows):\n        t = types[i]\n        if t == \"noop\":\n            continue\n        if t == \"block\":\n            placed = False\n            for _ in range(BLOCK_RETRIES):\n                r0 = random.randint(0, H - 2)\n                c0 = random.randint(0, W - 2)\n                cells = [(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)]\n                if can_place(cells):\n                    do_place(cells, m)\n                    placed = True\n                    break\n            if not placed:\n                return None\n        else:\n            if not _try_place_l_pair(H, W, m, LPAIR_RETRIES, can_place, do_place):\n                return None\n\n    # Optional distractor L-pair in a non-legend color.\n    if random.random() < DISTRACTOR_PROB:\n        avail = [c for c in range(10) if c != bg and c not in marker_colors]\n        if avail:\n            _try_place_l_pair(H, W, random.choice(avail),\n                              DISTRACTOR_RETRIES, can_place, do_place)\n\n    # Ensure bg remains the most common color (so get_bg picks it).\n    counts = Counter(grid.flatten().tolist())\n    if counts.most_common(1)[0][0] != bg:\n        return None\n\n    # Oracle check: solver must run without errors.\n    try:\n        _ = main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\n===== /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt()\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: failed to generate a valid input after %d attempts\" % GEN_RETRIES)\n\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py : main =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n    right1: int,\n    right2: int,\n    below1: int,\n    sr0: int,\n    sc0: int,\n    s: int,\n    nh: int,\n    nv: int,\n) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n    out = np.full((rows, cols), int(bg), dtype=int)\n    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n\n    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n\n    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n    for c in range(first_c, last_c + 1):\n        offset = c - sc1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            color = right1\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            color = right2\n        else:\n            continue\n        _gen_paint_rect(out, sr0, c, sr1, c, color)\n        _gen_paint_rect(out, dr0, c, dr1, c, color)\n    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n\n    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n    left_c, right_c = sc0 - 1, dc1 + 1\n    for r in range(first_r, last_r + 1):\n        out[r, left_c] = below1\n        out[r, right_c] = below1\n        offset = r - sr1\n        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n            _gen_paint_rect(out, r, dc0, r, right_c, below1)\n        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n            _gen_paint_rect(out, r, sc0, r, sc1, right2)\n            _gen_paint_rect(out, r, dc0, r, dc1, right2)\n\n    return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)\n\n\ndef _derive_input(\n    out: np.ndarray,\n    bg: int,\n    sr0: int,\n    sc0: int,\n    sr1: int,\n    sc1: int,\n    dr0: int,\n    dc0: int,\n    dr1: int,\n    dc1: int,\n) -> np.ndarray:\n    keep = np.zeros(out.shape, dtype=bool)\n    keep[sr0 : sr1 + 1, sc0 : sc1 + 1] = True\n    keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True\n    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True\n    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True\n    keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True\n    keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True\n\n    inp = np.full_like(out, int(bg))\n    inp[keep] = out[keep]\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = int(np.random.randint(COLOR_COUNT))\n    palette = [color for color in range(COLOR_COUNT) if color != bg]\n    anchor_color, right1, right2, below1 = map(\n        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)\n    )\n\n    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))\n    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))\n    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD\n    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD\n\n    top, bottom = _choose_margins(struct_h)\n    left, right = _choose_margins(struct_w)\n    rows, cols = struct_h + top + bottom, struct_w + left + right\n    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN\n\n    out, box = _build_output(\n        rows,\n        cols,\n        bg,\n        anchor_color,\n        right1,\n        right2,\n        below1,\n        sr0,\n        sc0,\n        s,\n        nh,\n        nv,\n    )\n    inp = _derive_input(out, bg, *box)\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\n===== /home/lixinyu/snap/new/ARC_code/train/34cfa167.py : generate_input =====\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n","exit_code":0,"status":"completed"}}
