{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"import numpy as np\nfrom collections import deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\nfrom arc_utils import neighbors4\n\n\ndef _components(g: np.ndarray, col: int, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(g == col, connectivity=8 if conn8 else 4)]\n\n\ndef _is_straight_line(comp: list[tuple[int, int]]) -> bool:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(rs)) == 1:\n        row = rs[0]\n        cols = sorted(set(cs))\n        return cols == list(range(min(cols), max(cols) + 1))\n    if len(set(cs)) == 1:\n        col = cs[0]\n        rows = sorted(set(rs))\n        return rows == list(range(min(rows), max(rows) + 1))\n    return False\n\n\ndef _bar_endpoints(comp: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(cs)) == 1:\n        c = cs[0]\n        return (min(rs), c), (max(rs), c)\n    r = rs[0]\n    return (r, min(cs)), (r, max(cs))\n\n\ndef _touches_border(p: tuple[int, int], h: int, w: int) -> bool:\n    r, c = p\n    return r == 0 or c == 0 or r == h - 1 or c == w - 1\n\n\ndef _bfs_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    if goal not in prev:\n        return None\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _bfs_path_with_diag_filter(\n    start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray\n) -> list[tuple[int, int]] | None:\n    # Like _bfs_path but disallows diagonal steps when either orthogonal intermediate cell is also walkable.\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n\n    def can_step(r: int, c: int, nr: int, nc: int) -> bool:\n        dr = nr - r\n        dc = nc - c\n        if dr == 0 or dc == 0:\n            return True\n        # diagonal: skip if either intermediate orth cell is in the walkable set\n        mid1 = (r, c + dc)\n        mid2 = (r + dr, c)\n        if 0 <= mid1[0] < h and 0 <= mid1[1] < w and bool(walkable[mid1]):\n            return False\n        if 0 <= mid2[0] < h and 0 <= mid2[1] < w and bool(walkable[mid2]):\n            return False\n        return True\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            if not can_step(r, c, nr, nc):\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    assert goal in prev, \"BFS-with-diag-filter must reach goal\"\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _greedy_manhattan_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n\n    def md(p):\n        return abs(p[0] - goal[0]) + abs(p[1] - goal[1])\n\n    cur = start\n    path = [cur]\n    seen = {cur}\n    while cur != goal:\n        cur_md = md(cur)\n        best = None  # (md, is_diag, nr, nc)\n        for nr, nc in neighbors8(cur[0], cur[1]):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in seen:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            nmd = md(nxt)\n            if nmd >= cur_md:\n                continue\n            is_diag = 1 if (nr != cur[0] and nc != cur[1]) else 0\n            key = (nmd, is_diag, nr, nc)\n            if best is None or key < best:\n                best = key\n        if best is None:\n            return None\n        _, _, nr, nc = best\n        cur = (nr, nc)\n        path.append(cur)\n        seen.add(cur)\n    return path\n\n\ndef _segment_main_path(seg_pts: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:\n    # Extract the \"main stroke\" of the segment as a simple path.\n    #\n    # Use 4-neigh edges always. Allow diagonal edges only when they represent a true diagonal stroke,\n    # i.e. the diagonal pixels touch only at the corner (no orthogonal intermediate segment pixel),\n    # which prevents diagonal shortcuts across bends.\n    sset = set(seg_pts)\n\n    def neighbors(p: tuple[int, int]):\n        r, c = p\n        for q in neighbors4(r, c):\n            if q in sset:\n                yield q\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            # If either orthogonal intermediate cell is occupied, treat this as a bend shortcut and skip.\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            yield q\n\n    q = deque([start])\n    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}\n    dist: dict[tuple[int, int], int] = {start: 0}\n    while q:\n        cur = q.popleft()\n        for nxt in neighbors(cur):\n            if nxt in prev:\n                continue\n            prev[nxt] = cur\n            dist[nxt] = dist[cur] + 1\n            q.append(nxt)\n\n    far = max(dist.keys(), key=lambda p: (dist[p], p[0], p[1]))\n    path = []\n    cur = far\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _segment_degrees(seg_pts: list[tuple[int, int]]) -> dict[tuple[int, int], int]:\n    sset = set(seg_pts)\n    deg = {p: 0 for p in sset}\n    for r, c in sset:\n        # 4-neigh\n        for q in neighbors4(r, c):\n            if q in sset:\n                deg[(r, c)] += 1\n        # diagonals only if no orth intermediate is present\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            deg[(r, c)] += 1\n    return deg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n","exit_code":0,"status":"completed"}}
