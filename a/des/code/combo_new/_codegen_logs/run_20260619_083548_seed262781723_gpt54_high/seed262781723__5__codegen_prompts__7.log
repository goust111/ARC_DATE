{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/247ef758.py',\n'/home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/train/ac6f9922.py',\n'/home/lixinyu/snap/new/ARC_code/train/df9fd884.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py',\n'/home/lixinyu/snap/new/ARC_code/train/22208ba4.py',\n]\nfor path in files:\n    text = Path(path).read_text()\n    print(f'===== {path} =====')\n    for name in ('def main', 'def generate_input'):\n        idx = text.find(name)\n        if idx == -1:\n            continue\n        end = text.find('\\\\ndef ', idx + 1)\n        if end == -1:\n            end = len(text)\n        print(text[idx:end].rstrip())\n        print()\nPY\"","aggregated_output":"===== /home/lixinyu/snap/new/ARC_code/eval/247ef758.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move colored sprites from the left strip into a framed area at marker-defined targets.\n\n    Input structure:\n    - bg background; rectangular frame on right with colored markers on its edges; sprites in a narrow left strip separated by a constant-color divider column.\n\n    Rule:\n    - For each color, target rows/cols are where both opposite frame edges share that color. Targets are the Cartesian product.\n    - Erase each sprite from the left and stamp it centered at every target. Higher sprites cover lower ones.\n\n    Key insight: One sprite replicates to a grid of row × column marker intersections.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- frame interior: largest bg component not touching boundary ---\n    inner_bbox = largest_enclosed_component_bbox(g == int(bg), connectivity=4)\n    assert not (inner_bbox is None)\n    ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n    fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n\n    # --- divider columns (fixed) on the left side ---\n    divider_mask = np.zeros((H, W), dtype=bool)\n    for c in range(0, max(0, int(fc0))):\n        colv = g[:, int(c)]\n        non = colv[colv != int(bg)]\n        if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n            divider_mask[:, int(c)] = True\n\n    left_cols = (np.arange(W)[None, :] < int(fc0))\n\n    # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n    sprites = []\n    for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n        mask = (g == int(col)) & left_cols & (~divider_mask)\n        if not bool(mask.any()):\n            continue\n        slab, sn = label_mask(mask, connectivity=8)\n        for sid in range(1, int(sn) + 1):\n            pts = np.argwhere(slab == int(sid))\n            r0, c0 = pts.min(axis=0)\n            r1, c1 = pts.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n            m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n            sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n\n    move_colors = {int(s[\"color\"]) for s in sprites}\n\n    # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n    row_marks: dict[int, list[int]] = defaultdict(list)\n    col_marks: dict[int, list[int]] = defaultdict(list)\n    for r in range(int(ir0), int(ir1) + 1):\n        cl = int(g[int(r), int(fc0)])\n        cr = int(g[int(r), int(fc1)])\n        if cl == cr and cl != int(bg) and cl in move_colors:\n            row_marks[int(cl)].append(int(r))\n    for c in range(int(ic0), int(ic1) + 1):\n        ct = int(g[int(fr0), int(c)])\n        cb = int(g[int(fr1), int(c)])\n        if ct == cb and ct != int(bg) and ct in move_colors:\n            col_marks[int(ct)].append(int(c))\n\n    targets: dict[int, list[tuple[int, int]]] = {}\n    for col in set(row_marks.keys()) & set(col_marks.keys()):\n        pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n        targets[int(col)] = sorted(pts)\n\n    out = g.copy()\n    movers = [s for s in sprites if int(s[\"color\"]) in targets]\n\n    # Erase originals of moved sprites.\n    for s in movers:\n        r0, c0 = int(s[\"r0\"]), int(s[\"c0\"])\n        for rr, cc in np.argwhere(s[\"mask\"]):\n            out[int(r0) + int(rr), int(c0) + int(cc)] = int(bg)\n\n    # Bottom-to-top ordering: lower sprites first, upper sprites last (covering).\n    movers.sort(key=lambda s: (-((int(s[\"r0\"]) + int(s[\"r1\"])) / 2.0), int(s[\"c0\"])))\n\n    for s in movers:\n        col = int(s[\"color\"])\n        cr = (int(s[\"r0\"]) + int(s[\"r1\"])) // 2\n        cc = (int(s[\"c0\"]) + int(s[\"c1\"])) // 2\n        pix = [(int(s[\"r0\"]) + int(rr), int(s[\"c0\"]) + int(cc2)) for rr, cc2 in np.argwhere(s[\"mask\"])]\n\n        for tr, tc in targets[int(col)]:\n            dr = int(tr - cr)\n            dc = int(tc - cc)\n            for r, c in pix:\n                rr = int(r + dr)\n                cc3 = int(c + dc)\n                if int(ir0) <= rr <= int(ir1) and int(ic0) <= cc3 <= int(ic1):\n                    out[rr, cc3] = int(col)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# generate_input\n# ---------------------------------------------------------------------------\nimport random\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the outlined object with the outside contour of that outline in the marker color.\n\n    Input structure:\n    - A dominant background surrounds one 8-connected foreground outline.\n    - The outline is the unique largest foreground color.\n    - One or more smaller interior colors are inside the outline; the marker color\n      is the unique smallest non-outline color.\n\n    Rule:\n    - Erase all original foreground pixels to background.\n    - Paint every background pixel that is 4-adjacent to the outline with the\n      marker color.\n    - Keep the grid shape unchanged.\n\n    Key insight: The colored interior marker supplies the paint color, while the\n    largest outline supplies only the contour whose outside edge is traced.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    counts = Counter(map(int, g.flatten()))\n    foreground_colors = [color for color in counts if color != bg]\n    assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n\n    frame_count = max(counts[color] for color in foreground_colors)\n    frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n    assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n\n    marker_candidates = [color for color in foreground_colors if color != frame_color]\n    marker_count = min(counts[color] for color in marker_candidates)\n    marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n\n    out = np.full_like(g, bg)\n    contour: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(g == frame_color):\n        for nr, nc in neighbors4(int(r), int(c)):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n                contour.add((int(nr), int(nc)))\n    assert contour, \"expected outline to touch background contour cells\"\n\n    for r, c in contour:\n        out[r, c] = marker_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_MIN, GRID_MAX = 5, 16\nN_COLORS = 10\n\nSHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\nSHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\nSTART_WIDTH_MIN, START_WIDTH_MAX = 1, 2\nMAX_LOCAL_WIDTH = 5\n\nMARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n\nGEN_ATTEMPTS = 300\n\nEDGE_TOUCH_TOP_BOTTOM = \"TB\"\nCORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\nZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n\ndef generate_input():\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid aa62e3f4 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/ac6f9922.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.\n\n    Input structure\n    - The most common color forms the outer background and all enclosed slot\n      backgrounds.\n    - The enclosed background components form a complete rectangular array of\n      slots, ordered by their positions.\n    - Each slot contains either no other color or exactly one object color.\n\n    Rule\n    - Find all 4-connected components of the most common color that do not touch\n      the input edge.\n    - Sort their bounding boxes into row and column order to define the output\n      table.\n    - For each slot, output its unique non-background color if present; otherwise\n      output the background color.\n\n    Key insight\n    - The large grid is an expanded table: the enclosed background components are\n      the cells, and any colored object drawn inside a cell is that cell's summary\n      value.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    slot_bboxes: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(g == bg, connectivity=4):\n        if _touches_edge(coords, height, width):\n            continue\n        slot_bboxes.append(bbox_coords(coords))\n\n    assert slot_bboxes, \"expected enclosed background slots\"\n    row_starts = sorted({b[0] for b in slot_bboxes})\n    col_starts = sorted({b[1] for b in slot_bboxes})\n    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (\n        \"expected a complete rectangular array of slots\"\n    )\n\n    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}\n    assert len(slot_by_anchor) == len(slot_bboxes), \"slot anchors must be unique\"\n\n    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)\n    for out_r, r0 in enumerate(row_starts):\n        for out_c, c0 in enumerate(col_starts):\n            assert (r0, c0) in slot_by_anchor, \"missing slot in rectangular array\"\n            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]\n            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n            object_colors = np.unique(window[window != bg])\n            assert object_colors.size <= 1, \"each slot must contain at most one object color\"\n            if object_colors.size == 1:\n                out[out_r, out_c] = int(object_colors[0])\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, table, frame, and slot dimensions.\nCANVAS_MIN, CANVAS_MAX = 13, 19\nTABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)\nROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)\nAXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)\n\n# Object and palette sampling limits.\nN_COLORS, MAX_OBJECT_COLORS = 10, 6\nMAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2\nOBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6\n\n# Rejection sampling cap.\nGEN_RETRY_LIMIT = 300\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid ac6f9922 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/df9fd884.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\ndef generate_input():\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/22208ba4.py =====\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.\n\n    Input structure:\n    - The background is the most common color.\n    - Foreground objects are solid monochrome rectangles touching a grid corner.\n    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.\n\n    Rule:\n    - Clear the multiple objects of the repeated color from their original positions.\n    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.\n    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.\n\n    Key insight:\n    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    by_color: dict[int, list[dict]] = defaultdict(list)\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        by_color[int(comp[\"color\"])].append(comp)\n\n    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]\n    assert len(moving_colors) == 1\n    moving_color = int(moving_colors[0])\n    moving_objects = by_color[moving_color]\n\n    out = g.copy()\n    for comp in moving_objects:\n        coords = comp[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    for comp in moving_objects:\n        coords = comp[\"coords\"]\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert int(comp[\"area\"]) == height * width\n\n        touches_top = r0 == 0\n        touches_bottom = r1 == H - 1\n        touches_left = c0 == 0\n        touches_right = c1 == W - 1\n        assert touches_top != touches_bottom\n        assert touches_left != touches_right\n\n        dr = height if touches_top else -height\n        dc = width if touches_left else -width\n        shifted = coords + np.array([dr, dc], dtype=int)\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < H)\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < W)\n            )\n        )\n\n        target = out[shifted[:, 0], shifted[:, 1]]\n        assert bool(np.all((target == bg) | (target == moving_color)))\n        out[shifted[:, 0], shifted[:, 1]] = moving_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Corner and movement model.\nCORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\nDIAGONAL_PAIRS = ({\"TL\", \"BR\"}, {\"TR\", \"BL\"})\nINWARD_STEP_FACTOR = 2\nCOMPACT_CANVAS_FACTOR = 3\n\n# Canvas, object count, and retry bounds.\nGRID_ROW_BOUNDS = (7, 22)\nGRID_COL_BOUNDS = (7, 30)\nSQUARE_SIZE_BOUNDS = (1, 4)\nMOVING_COUNT_BOUNDS = (2, 4)\nGENERATION_RETRIES = 300\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 22208ba4 input\")\n\n","exit_code":0,"status":"completed"}}
