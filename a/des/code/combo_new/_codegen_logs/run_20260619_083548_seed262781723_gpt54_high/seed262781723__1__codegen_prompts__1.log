{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/6165ea8f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    assert coords.size, \"expected a nonempty mask\"\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_mask_key(_tight_mask(rotated)))\n        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _legend_order(g: np.ndarray, bg: int) -> list[int]:\n    labels: list[tuple[int, int]] = []\n    W = g.shape[1]\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):\n        if int(comp[\"area\"]) != 1:\n            continue\n        r, c = map(int, comp[\"coords\"][0])\n        if c == W - 1:\n            labels.append((r, int(comp[\"color\"])))\n\n    labels.sort()\n    assert labels, \"expected a right-edge color legend\"\n    assert [r for r, _color in labels] == list(range(len(labels))), \"legend must start at the top edge\"\n\n    order = [color for _r, color in labels]\n    assert len(order) == len(set(order)), \"legend colors must be unique\"\n    assert set(order) == set(colors_present(g, exclude={bg})), \"legend must list every foreground color\"\n    return order\n\n\ndef _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:\n    comps = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[color],\n        min_area=1,\n    )\n    main = [comp for comp in comps if int(comp[\"area\"]) > 1]\n    label = [\n        comp\n        for comp in comps\n        if int(comp[\"area\"]) == 1 and int(comp[\"coords\"][0][1]) == g.shape[1] - 1\n    ]\n    assert len(main) == 1, \"expected exactly one main object for each legend color\"\n    assert len(label) == 1, \"expected exactly one right-edge singleton label for each legend color\"\n    assert len(comps) == 2, \"each legend color should appear only as one object and one label\"\n\n    r0, c0, r1, c1 = main[0][\"bbox\"]\n    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a color-labeled shape-equivalence table from the objects listed on the right edge.\n\n    Input structure:\n    - The background contains one main 4-connected object for each foreground color.\n    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.\n    - Those singleton pixels define the row and column order of the output table.\n\n    Rule:\n    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.\n    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.\n    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.\n    - Leave diagonal cells and all separators as background.\n\n    Key insight:\n    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    order = _legend_order(g, bg)\n    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}\n\n    n = len(order)\n    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)\n\n    for i, color in enumerate(order):\n        band = 3 + 3 * i\n        out[0:2, band : band + 2] = int(color)\n        out[band : band + 2, 0:2] = int(color)\n\n    for i, row_color in enumerate(order):\n        for j, col_color in enumerate(order):\n            if i == j:\n                continue\n            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY\n            r = 3 + 3 * i\n            c = 3 + 3 * j\n            out[r : r + 2, c : c + 2] = int(cell_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and object bounds.\nGEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)\nGEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4\n# Shape-class sampling.\nGEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80\nGEN_DIHEDRAL_FLIP_PROB = 0.5\n# Output table layout and colors.\nGEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3\nGEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)\n# Input placement and retry limits.\nGEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300\nGEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4\nGEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _gen_tight_mask(mask: np.ndarray) -> np.ndarray:\n    coords = np.argwhere(mask)\n    r0, c0, r1, c1 = bbox_coords(coords)\n    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)\n\n\ndef _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:\n    return tuple(\"\".join(\"1\" if cell else \"0\" for cell in row) for row in mask)\n\n\ndef _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:\n    base = _gen_tight_mask(mask)\n    variants = []\n    for k in range(4):\n        rotated = np.rot90(base, k)\n        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))\n        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))\n    return min(variants)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    bg = ~mask.astype(bool)\n    if not bool(bg.any()):\n        return False\n\n    H, W = bg.shape\n    seen = np.zeros_like(bg, dtype=bool)\n    stack: list[tuple[int, int]] = []\n    for r in range(H):\n        for c in (0, W - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n    for c in range(W):\n        for r in (0, H - 1):\n            if bg[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                stack.append((r, c))\n\n    while stack:\n        r, c = stack.pop()\n        for dr, dc in GEN_NEIGHBORS_4:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                stack.append((nr, nc))\n    return bool((bg & ~seen).any())\n\n\ndef _random_corner_path(h: int, w: int) -> np.ndarray:\n    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n    sr, sc = random.choice(starts)\n    er, ec = h - 1 - sr, w - 1 - sc\n    moves = [(1 if er > sr else -1, 0)] * (h - 1)\n    moves += [(0, 1 if ec > sc else -1)] * (w - 1)\n    random.shuffle(moves)\n\n    mask = np.zeros((h, w), dtype=bool)\n    r, c = sr, sc\n    mask[r, c] = True\n    for dr, dc in moves:\n        r += dr\n        c += dc\n        mask[r, c] = True\n    return mask\n\n\ndef _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:\n    h, w = mask.shape\n    choices = []\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c]:\n                continue\n            touches = sum(\n                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]\n                for dr, dc in GEN_NEIGHBORS_4\n            )\n            if touches != 1:\n                continue\n            trial = mask.copy()\n            trial[r, c] = True\n            if not _has_hole(trial):\n                choices.append((r, c))\n    return choices\n\n\ndef _random_mask() -> np.ndarray | None:\n    area = random.randint(*GEN_OBJECT_AREA_RANGE)\n    pairs = [\n        (h, w)\n        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)\n        if h + w - 1 <= area <= h * w\n        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS\n    ]\n    h, w = random.choice(pairs)\n    mask = _random_corner_path(h, w)\n\n    while int(mask.sum()) < area:\n        choices = _growth_candidates(mask)\n        if not choices:\n            return None\n        r, c = random.choice(choices)\n        mask[r, c] = True\n    return mask\n\n\ndef _class_sizes(n: int) -> list[int]:\n    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])\n    sizes = [1] * k\n    for _ in range(n - k):\n        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]\n        sizes[random.choice(open_slots)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:\n    canonical_masks: list[np.ndarray] = []\n    signatures: set[tuple[str, ...]] = set()\n    for _ in range(class_count):\n        for _ in range(GEN_UNIQUE_MASK_RETRIES):\n            mask = _random_mask()\n            if mask is None:\n                continue\n            sig = _gen_shape_signature(mask)\n            if sig in signatures:\n                continue\n            signatures.add(sig)\n            canonical_masks.append(mask)\n            break\n        else:\n            return None\n    return canonical_masks\n\n\ndef _dihedral(mask: np.ndarray) -> np.ndarray:\n    out = np.rot90(mask, random.randrange(4))\n    if random.random() < GEN_DIHEDRAL_FLIP_PROB:\n        out = np.fliplr(out)\n    return out.astype(bool).copy()\n\n\ndef _build_output(colors: list[int], class_ids: list[int]) -> np.ndarray:\n    n = len(colors)\n    out_size = GEN_TABLE_STEP * n + GEN_TABLE_BLOCK\n    out = np.zeros((out_size, out_size), dtype=int)\n    for i, color in enumerate(colors):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location\nimport math\nimport random\n\n\ndef _factor_pairs(n: int) -> list[tuple[int, int]]:\n    out = []\n    for h in range(1, int(n**0.5) + 1):\n        if n % h == 0:\n            w = n // h\n            out.append((h, w))\n            if h != w:\n                out.append((w, h))\n    return out\n\n\ndef _normalize_coords(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:\n    rs = [r for r, _ in coords]\n    cs = [c for _, c in coords]\n    r0 = min(rs)\n    c0 = min(cs)\n    norm = tuple(sorted((r - r0, c - c0) for r, c in coords))\n    h = max(r for r, _ in norm) + 1\n    w = max(c for _, c in norm) + 1\n    return norm, int(h), int(w)\n\n\ndef _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:\n    norm, h, w = _normalize_coords(coords)\n    rot = [(c, h - 1 - r) for r, c in norm]\n    return _normalize_coords(rot)\n\n\ndef _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:\n    norm, h, w = _normalize_coords(coords)\n    flp = [(r, w - 1 - c) for r, c in norm]\n    return _normalize_coords(flp)\n\n\ndef _dihedral_orientations(\n    coords: tuple[tuple[int, int], ...],\n) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:\n    \"\"\"\n    Unique orientations under rotations + mirror (D4).\n    Returned as (coords, h, w, rot_k, flipped), where the transform is:\n      - if flipped: horizontal flip (mirror left-right)\n      - then rot_k times 90° clockwise rotation\n    coords are normalized to start at (0,0).\n    \"\"\"\n    seen: set[tuple[tuple[int, int], ...]] = set()\n    out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []\n    cur = coords\n    for rot_k in range(4):\n        c, h, w = _normalize_coords(cur)\n        if c not in seen:\n            seen.add(c)\n            out.append((c, h, w, int(rot_k), False))\n        cur = _rot90(cur)[0]\n    cur = _flip_h(coords)[0]\n    for rot_k in range(4):\n        c, h, w = _normalize_coords(cur)\n        if c not in seen:\n            seen.add(c)\n            out.append((c, h, w, int(rot_k), True))\n        cur = _rot90(cur)[0]\n    return out\n\n\ndef _extract_legend_map(g: np.ndarray, pts: np.ndarray, k: int) -> np.ndarray:\n    \"\"\"\n    Inside the legend component's bounding box, find a k×k color map block (may include 0).\n    We pick the k×k window with the maximum number of distinct colors; ties go to top-left.\n    \"\"\"\n    r0, c0, r1, c1 = bbox_coords(pts)\n    sub = g[r0 : r1 + 1, c0 : c1 + 1]\n    hh, ww = sub.shape\n    assert k > 0 and hh >= k and ww >= k, 'legend component must fit k×k map'\n    best = None  # (distinct, -rr, -cc)\n    best_rc = None\n    for rr in range(hh - k + 1):\n        for cc in range(ww - k + 1):\n            window = sub[rr : rr + k, cc : cc + k]\n            distinct = int(len(set(map(int, window.ravel()))))\n            key = (distinct, -rr, -cc)\n            if best is None or key > best:\n                best = key\n                best_rc = (rr, cc)\n    assert best_rc is not None, 'legend component must contain a valid k×k color map window'\n    rr, cc = best_rc\n    return np.asarray(sub[rr : rr + k, cc : cc + k], dtype=int).copy()\n\n\ndef _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:\n    \"\"\"\n    Treat background 'holes' fully enclosed inside the component bbox as part of the piece.\n    Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.\n    \"\"\"\n    r0, c0, r1, c1 = bbox_coords(pts)\n    hh = r1 - r0 + 1\n    ww = c1 - c0 + 1\n    occ = np.zeros((hh, ww), dtype=bool)\n    for r, c in pts:\n        occ[r - r0, c - c0] = True\n\n    bgmask = ~occ\n    vis = np.zeros_like(bgmask, dtype=bool)\n    st: list[tuple[int, int]] = []\n\n    for rr in range(hh):\n        for cc in range(ww):\n            if rr in (0, hh - 1) or cc in (0, ww - 1):\n                if bgmask[rr, cc] and not vis[rr, cc]:\n                    vis[rr, cc] = True\n                    st.append((rr, cc))\n                    while st:\n                        r, c = st.pop()\n                        for r2, c2 in neighbors4(r, c):\n                            if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:\n                                vis[r2, c2] = True\n                                st.append((r2, c2))\n\n    holes = bgmask & ~vis\n    hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]\n    filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))\n    return filled, int(holes.sum())\n\n\ndef _assemble_exact_cover(\n    pieces: list[dict],\n    legend_idx: int,\n    legend_map: np.ndarray,\n    k: int,\n) -> np.ndarray:\n    \"\"\"\n    Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.\n    Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.\n    \"\"\"\n    total = sum(int(p[\"area\"]) for p in pieces)\n    max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)\n    max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)\n\n    dims = _factor_pairs(total)\n    dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]\n    assert len(dims) == 1, 'piece areas and bounds must imply a unique output rectangle'\n\n    for H, W in dims:\n        nbits = H * W\n        all_mask = (1 << nbits) - 1\n\n        # Precompute placements for non-legend pieces (legend is fixed at (0,0), but orientation varies).\n        other_pis = [i for i in range(len(pieces)) if i != legend_idx]\n        placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []\n        for pi in other_pis:\n            opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []\n            for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:\n                for r0 in range(0, H - ph + 1):\n                    for c0 in range(0, W - pw + 1):\n                        m = 0\n                        for dr, dc in coords:\n                            idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))\n                            m |= 1 << idx\n                        opts.append((m, int(r0), int(c0), coords))\n            placements_other.append(opts)\n\n        def solve_with_fixed_legend(\n            legend_coords: tuple[tuple[int, int], ...],\n        ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:\n            legend_mask = 0\n            for dr, dc in legend_coords:\n                idx = int(dr) * int(W) + int(dc)\n                legend_mask |= 1 << idx\n\n            filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []\n            for opts in placements_other:\n                filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])\n\n            remaining = set(range(len(other_pis)))\n            chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {\n                legend_idx: (legend_mask, 0, 0, legend_coords)\n            }\n\n            def search(used: int) -> bool:\n                if not remaining:\n                    return used == all_mask\n                empty = (~used) & all_mask\n                if empty == 0:\n                    return False\n                cell = (empty & -empty).bit_length() - 1\n                # Branch over *any* remaining piece that can cover this cell.\n                # (Picking only one \"best\" piece can miss valid tilings.)\n                candidates = []\n                for k in sorted(remaining):\n                    opts_k = []\n                    for pl in filtered[k]:\n                        m = pl[0]\n                        if (m >> cell) & 1 and (m & used) == 0:\n                            opts_k.append(pl)\n                    if opts_k:\n                        candidates.append((len(opts_k), k, opts_k))\n                if not candidates:\n                    return False\n\n                candidates.sort(key=lambda x: (x[0], x[1]))\n                for _, k, opts_k in candidates:\n                    remaining.remove(k)\n                    pi = other_pis[k]\n                    for pl in opts_k:\n                        chosen[pi] = pl\n                        if search(used | pl[0]):\n                            return True\n                    chosen.pop(pi, None)\n                    remaining.add(k)\n                return False\n\n            if not search(legend_mask):\n                return None\n            return chosen\n\n        # Try each possible legend orientation at (0,0).\n        chosen = None\n        for coords, ph, pw, _, _ in pieces[legend_idx][\"oris\"]:\n            assert ph <= H and pw <= W, 'legend orientation must fit the unique output rectangle'\n            sol = solve_with_fixed_legend(coords)\n            if sol is None:\n                continue\n            chosen = sol\n            break\n        assert chosen is not None, 'exact-cover assembly failed: no valid legend orientation'\n\n        # Determine legend-map cell for each piece by centroid.\n        piece_cell: dict[int, tuple[int, int]] = {}\n        for pi, pl in chosen.items():\n            _, r0, c0, coords = pl\n            # centroid: average over occupied cells\n            rs = [r0 + dr for dr, _ in coords]\n            cs = [c0 + dc for _, dc in coords]\n            cr = float(sum(rs)) / float(len(rs))\n            cc = float(sum(cs)) / float(len(cs))\n            rr = int(cr * float(k) / float(H))\n            cc2 = int(cc * float(k) / float(W))\n            rr = max(0, min(int(k) - 1, rr))\n            cc2 = max(0, min(int(k) - 1, cc2))\n            piece_cell[pi] = (rr, cc2)\n\n        # Build final output.\n        out = np.zeros((H, W), dtype=int)\n        for pi, pl in chosen.items():\n            _, r0, c0, coords = pl\n            rr, cc2 = piece_cell[pi]\n            col = int(legend_map[rr, cc2])\n            for dr, dc in coords:\n                out[r0 + dr, c0 + dc] = col\n        return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n","exit_code":0,"status":"completed"}}
