{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n","exit_code":0,"status":"completed"}}
