{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d6e50e54.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d6e50e54.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move each maroon marker toward the blue rectangle and recolor the rectangle red.\n\n    Input structure\n    A background canvas contains one solid blue rectangular object and several isolated\n    maroon marker pixels. Each marker is horizontally or vertically aligned with the\n    rectangle and lies outside it.\n\n    Rule\n    Start with a background canvas, repaint the blue rectangle red, and move each\n    maroon marker straight toward the rectangle along its row or column. Exactly one\n    marker is strictly closer to the rectangle than all others and enters the\n    rectangle boundary; every other marker lands in the adjacent exterior cell just\n    outside its aligned side.\n\n    Key insight\n    The single entering marker is the unique global nearest marker to the rectangle,\n    not the nearest marker on each of the four sides.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    rectangles = []\n    markers = []\n    for comp in components:\n        h = bbox_h(comp[\"bbox\"])\n        w = bbox_w(comp[\"bbox\"])\n        if comp[\"area\"] == h * w and comp[\"area\"] > 1:\n            rectangles.append(comp)\n        elif comp[\"area\"] == 1:\n            markers.append(comp)\n\n    assert len(rectangles) == 1\n    assert markers\n    rect = rectangles[0]\n    rect_color = int(rect[\"color\"])\n    marker_colors = {int(comp[\"color\"]) for comp in markers}\n    assert marker_colors == {Color.MAROON}\n    marker_color = Color.MAROON\n    assert rect_color == Color.BLUE\n    assert set(map(int, g.flat)) == {bg, rect_color, marker_color}\n\n    r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n    h = bbox_h(rect[\"bbox\"])\n    w = bbox_w(rect[\"bbox\"])\n\n    out = np.full_like(g, bg)\n    out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED\n\n    destinations = []\n    marker_entries: list[tuple[int, tuple[int, int], bool]] = []\n    for comp in markers:\n        r, c = map(int, comp[\"coords\"][0])\n        candidates = []\n        if c0 <= c <= c1 and r < r0:\n            d = r0 - r\n            enters = d < h\n            candidates.append((r0 if enters else r0 - 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if c0 <= c <= c1 and r > r1:\n            d = r - r1\n            enters = d < h\n            candidates.append((r1 if enters else r1 + 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c < c0:\n            d = c0 - c\n            enters = d < w\n            candidates.append((r, c0 if enters else c0 - 1))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c > c1:\n            d = c - c1\n            enters = d < w\n            candidates.append((r, c1 if enters else c1 + 1))\n            marker_entries.append((d, (r, c), enters))\n\n        assert len(candidates) == 1\n        dr, dc = candidates[0]\n        assert in_bounds(g.shape, dr, dc)\n        assert (dr, dc) not in destinations\n        destinations.append((dr, dc))\n\n    min_dist = min(dist for dist, _pos, _enters in marker_entries)\n    nearest = [pos for dist, pos, _enters in marker_entries if dist == min_dist]\n    entering = [pos for _dist, pos, enters in marker_entries if enters]\n    assert len(nearest) == 1, \"the nearest marker to the rectangle must be unique\"\n    assert len(entering) == 1, \"exactly one marker may enter the rectangle\"\n    assert entering[0] == nearest[0], \"the entering marker must be the global nearest\"\n\n    for r, c in destinations:\n        out[r, c] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nRECT_SIDE_MIN, RECT_SIDE_MAX = 3, 5\nGRID_TO_RECT_RATIO_MIN, GRID_TO_RECT_RATIO_MAX = 2, 4\nMARKER_COUNT_MAX = 7\nSIDE_COUNT_MIN, SIDE_COUNT_MAX = 2, 4\nMIN_POSITION_SIDES_WITH_MARGIN, MIN_POSITION_MARGIN = 2, 2\nCLOSE_DIST_MIN, DIST_MAX = 2, 7\nKIND_CLOSE, KIND_FAR = \"close\", \"far\"\nBG_COLOR, RECT_INPUT_COLOR, RECT_OUTPUT_COLOR, MARKER_COLOR = 7, 1, 2, 9\nGEN_RETRIES = 300\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = \"top\", \"bottom\", \"left\", \"right\"\nHORIZONTAL_SIDES = (SIDE_TOP, SIDE_BOTTOM)\n\ndef _gen_d6e50e54_margins(n, r0, c0, side):\n    r1 = r0 + side - 1\n    c1 = c0 + side - 1\n    return {\n        SIDE_TOP: r0,\n        SIDE_BOTTOM: n - r1 - 1,\n        SIDE_LEFT: c0,\n        SIDE_RIGHT: n - c1 - 1,\n    }\n\ndef _gen_d6e50e54_count_allocations(total, caps):\n    if not caps:\n        return [()] if total == 0 else []\n\n    out = []\n    rest_min = len(caps) - 1\n    rest_max = sum(caps[1:])\n    for first in range(1, caps[0] + 1):\n        remaining = total - first\n        if rest_min <= remaining <= rest_max:\n            for tail in _gen_d6e50e54_count_allocations(remaining, caps[1:]):\n                out.append((first,) + tail)\n    return out\n\ndef _gen_d6e50e54_gap_lane_sets(values, count):\n    out = []\n\n    def rec(start, chosen):\n        if len(chosen) == count:\n            out.append(tuple(chosen))\n            return\n        for i in range(start, len(values)):\n            if chosen and values[i] == chosen[-1] + 1:\n                continue\n            rec(i + 1, chosen + [values[i]])\n\n    rec(0, [])\n    return out\n\ndef _gen_d6e50e54_lanes(values, count, single_distance):\n    if single_distance:\n        choices = _gen_d6e50e54_gap_lane_sets(list(values), count)\n        if not choices:\n            return None\n        return list(random.choice(choices))\n    return random.sample(list(values), count)\n\ndef _gen_d6e50e54_valid_options(margin, side_len):\n    options = []\n    close_max = min(side_len - 1, margin, DIST_MAX)\n    for dist in range(CLOSE_DIST_MIN, close_max + 1):\n        options.append((KIND_CLOSE, dist))\n    if margin >= side_len:\n        for dist in range(side_len, min(margin, DIST_MAX) + 1):\n            options.append((KIND_FAR, dist))\n    return options\n\n\ndef _gen_d6e50e54_side_cap(margin, side_len):\n    if len({dist for _kind, dist in _gen_d6e50e54_valid_options(margin, side_len)}) <= 1:\n        return (side_len + 1) // 2\n    return side_len\n\n\ndef _gen_d6e50e54_coords(side_name, lane, kind, dist, r0, c0, r1, c1):\n    if side_name == SIDE_TOP:\n        dest = (r0 if kind == KIND_CLOSE else r0 - 1, lane)\n        src = (r0 - dist, lane)\n    elif side_name == SIDE_BOTTOM:\n        dest = (r1 if kind == KIND_CLOSE else r1 + 1, lane)\n        src = (r1 + dist, lane)\n    elif side_name == SIDE_LEFT:\n        dest = (lane, c0 if kind == KIND_CLOSE else c0 - 1)\n        src = (lane, c0 - dist)\n    else:\n        dest = (lane, c1 if kind == KIND_CLOSE else c1 + 1)\n        src = (lane, c1 + dist)\n    return dest, src\n\n\ndef _gen_d6e50e54_assign(slots, margins, side_len, r0, c0, r1, c1):\n    random.shuffle(slots)\n\n    def rec(i, close_index, used_dest, used_src, assigned):\n        if i == len(slots):\n            return assigned\n\n        side_name, lane = slots[i]\n        margin = margins[side_name]\n        required_kind = KIND_CLOSE if i == close_index else KIND_FAR\n        options = [\n            option\n            for option in _gen_d6e50e54_valid_options(margin, side_len)\n            if option[0] == required_kind\n        ]\n        random.shuffle(options)\n\n        for kind, dist in options:\n            dest, src = _gen_d6e50e54_coords(\n                side_name, lane, kind, dist, r0, c0, r1, c1\n            )\n            if dest in used_dest or src in used_src:\n                continue\n            if any(abs(src[0] - old[0]) + abs(src[1] - old[1]) == 1 for old in used_src):\n                continue\n            result = rec(\n                i + 1,\n                close_index,\n                used_dest | {dest},\n                used_src | {src},\n                assigned + [(dest, src)],\n            )\n            if result is not None:\n                return result\n        return None\n\n    close_indices = list(range(len(slots)))\n    random.shuffle(close_indices)\n    for close_index in close_indices:\n        result = rec(0, close_index, set(), set(), [])\n        if result is not None:\n            return result\n    return None\n\n\ndef _gen_d6e50e54_choose_rect():\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    side_choices = [\n        s\n        for s in range(RECT_SIDE_MIN, RECT_SIDE_MAX + 1)\n        if GRID_TO_RECT_RATIO_MIN <= n / s <= GRID_TO_RECT_RATIO_MAX\n    ]\n    side_len = random.choice(side_choices)\n    positions = []\n    for r0 in range(n - side_len + 1):\n        for c0 in range(n - side_len + 1):\n            margins = _gen_d6e50e54_margins(n, r0, c0, side_len)\n            enough_sides = (\n                sum(m >= MIN_POSITION_MARGIN for m in margins.values())\n                >= MIN_POSITION_SIDES_WITH_MARGIN\n            )\n            if enough_sides and max(margins.values()) >= side_len:\n                positions.append((r0, c0, margins))\n    if not positions:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f41bd9c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f41bd9c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the side-attached foreground object to the opposite wall, shear its lower rows inward, and paint the crossed floor cells.\n\n    Input structure:\n    - The top row is the upper background color and the bottom row is the\n      floor color.\n    - A single non-background, non-floor object touches exactly one vertical\n      grid edge and rests immediately above the first solid floor row.\n\n    Rule:\n    - Clear the source object to the upper background color.\n    - Repaint each object row on the opposite side: the first three relative\n      rows keep the edge alignment, and each lower row shifts one more pixel\n      inward from that side.\n    - On the first floor row, repaint the traversed side-to-object segment\n      maroon, stopping just before the final outer bottom support pixel.\n\n    Key insight:\n    - The side of the source object gives the horizontal direction, while the\n      row index inside the object gives the one-cell-per-row diagonal shear.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be two-dimensional\"\n    height, width = g.shape\n\n    top_colors = np.unique(g[0])\n    bottom_colors = np.unique(g[-1])\n    assert len(top_colors) == 1, \"top row must be a uniform background\"\n    assert len(bottom_colors) == 1, \"bottom row must be a uniform floor\"\n    bg = int(top_colors[0])\n    floor = int(bottom_colors[0])\n    assert bg != floor, \"background and floor colors must differ\"\n\n    colors = set(map(int, np.unique(g)))\n    assert len(colors) == 3, \"expected exactly background, floor, and one object color\"\n    object_colors = colors - {bg, floor}\n    assert len(object_colors) == 1, \"expected one moving object color\"\n    obj = object_colors.pop()\n\n    full_floor_rows = np.where(np.all(g == floor, axis=1))[0]\n    assert len(full_floor_rows) > 0, \"expected a solid floor row\"\n    floor_row = int(full_floor_rows[0])\n    assert 0 < floor_row < height, \"floor row must be inside the grid\"\n    assert np.all(g[floor_row:] == floor), \"floor must be a solid bottom band\"\n\n    obj_coords = np.argwhere(g == obj)\n    assert len(obj_coords) > 0, \"expected a moving object\"\n    r0, c0, r1, c1 = bbox_coords(obj_coords)\n    object_width = c1 - c0 + 1\n    assert r1 == floor_row - 1, \"object must rest directly above the floor\"\n    assert (c0 == 0) ^ (c1 == width - 1), \"object must touch exactly one side edge\"\n    assert np.all(g[:floor_row][g[:floor_row] != obj] == bg), \"upper region must contain only bg and object\"\n\n    moving_right = c0 == 0\n    out = g.copy()\n    out[g == obj] = bg\n\n    for r in range(r0, r1 + 1):\n        rel_r = r - r0\n        rel_cols = np.where(g[r, c0 : c1 + 1] == obj)[0]\n        assert len(rel_cols) > 0, \"every object bbox row must contain object pixels\"\n\n        inward_shift = max(0, rel_r - 2)\n        if moving_right:\n            start_col = width - object_width - inward_shift\n        else:\n            start_col = inward_shift\n        dst_cols = start_col + rel_cols\n        assert int(dst_cols.min()) >= 0 and int(dst_cols.max()) < width, \"moved object must fit in the grid\"\n        out[r, dst_cols] = obj\n\n    bottom_rel_cols = np.where(g[r1, c0 : c1 + 1] == obj)[0]\n    bottom_shift = max(0, r1 - r0 - 2)\n    bottom_start = width - object_width - bottom_shift if moving_right else bottom_shift\n    final_bottom_cols = bottom_start + bottom_rel_cols\n    trail_color = Color.MAROON\n    assert int(trail_color) not in colors, \"trail color must be new\"\n    if moving_right:\n        trail_end = int(final_bottom_cols.max()) - 1\n        assert trail_end >= 0, \"trail must cover at least one floor pixel\"\n        out[floor_row, : trail_end + 1] = int(trail_color)\n    else:\n        trail_start = int(final_bottom_cols.min()) + 1\n        assert trail_start < width, \"trail must cover at least one floor pixel\"\n        out[floor_row, trail_start:] = int(trail_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and band bounds.\nGRID_ROWS = range(16, 19)\nGRID_COLS = (16, 18)\nFLOOR_THICKNESS = range(4, 7)\nEMPTY_ROWS = range(3, 7)\n# Object shape and fit constraints.\nOBJECT_WIDTH = 5\nOBJECT_HEIGHT = (5, 11)\nSOLID_TOP_ROWS = 2\nSHEAR_LOCK_ROWS = 3\nCHECKER_COLS = (0, 2, 4)\n# Colors and retry budget.\nTRAIL_COLOR = int(Color.MAROON)\nAVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]\nMAX_GENERATION_ATTEMPTS = 300\nSIDES = (\"left\", \"right\")\n\nROW_LAYOUTS = [\n    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)\n    for rows in GRID_ROWS\n    for floor_thick in FLOOR_THICKNESS\n    for empty_rows in EMPTY_ROWS\n    if OBJECT_HEIGHT[0] <= rows - floor_thick - empty_rows <= OBJECT_HEIGHT[1]\n]\n\n\ndef _gen_object_mask(height: int) -> np.ndarray:\n    mask = np.zeros((height, OBJECT_WIDTH), dtype=bool)\n    mask[:SOLID_TOP_ROWS, :] = True\n    mask[SOLID_TOP_ROWS:, CHECKER_COLS] = True\n    return mask\n\n\ndef _gen_place_original(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> None:\n    c0 = 0 if side == \"left\" else grid.shape[1] - mask.shape[1]\n    region = grid[top : top + mask.shape[0], c0 : c0 + mask.shape[1]]\n    region[mask] = color\n\n\ndef _gen_place_sheared(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> np.ndarray:\n    width = grid.shape[1]\n    bottom_cols = []\n    for rel_r in range(mask.shape[0]):\n        rel_cols = np.flatnonzero(mask[rel_r])\n        inward_shift = max(0, rel_r - SHEAR_LOCK_ROWS + 1)\n        c0 = width - mask.shape[1] - inward_shift if side == \"right\" else inward_shift\n        dst_cols = c0 + rel_cols\n        grid[top + rel_r, dst_cols] = color\n        bottom_cols = dst_cols\n    return bottom_cols\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    height, floor_thick, empty_rows, obj_h = random.choice(ROW_LAYOUTS)\n    width = random.randint(*GRID_COLS)\n    if OBJECT_WIDTH + max(0, obj_h - SHEAR_LOCK_ROWS) > width:\n        return None\n\n    bg, floor, obj = random.sample(AVAILABLE_COLORS, 3)\n    floor_row = height - floor_thick\n    obj_mask = _gen_object_mask(obj_h)\n    dst_side = random.choice(SIDES)\n    src_side = \"right\" if dst_side == \"left\" else \"left\"\n\n    out = np.full((height, width), bg, dtype=int)\n    out[floor_row:, :] = floor\n    bottom_cols = _gen_place_sheared(out, empty_rows, dst_side, obj, obj_mask)\n    if dst_side == \"right\":\n        out[floor_row, : int(bottom_cols.max())] = TRAIL_COLOR\n    else:\n        out[floor_row, int(bottom_cols.min()) + 1 :] = TRAIL_COLOR\n\n    inp = out.copy()\n    inp[inp == obj] = bg\n    inp[floor_row, inp[floor_row] == TRAIL_COLOR] = floor\n    _gen_place_original(inp, empty_rows, src_side, obj, obj_mask)\n\n    return inp if np.array_equal(main(inp), out) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _marker_side(g: np.ndarray, bg: int) -> tuple[str, int]:\n    sides: list[tuple[str, int]] = []\n    for color in set(map(int, g.ravel())) - {bg}:\n        if np.all(g[0, :] == color):\n            sides.append((\"top\", color))\n        if np.all(g[:, -1] == color):\n            sides.append((\"right\", color))\n        if np.all(g[-1, :] == color):\n            sides.append((\"bottom\", color))\n        if np.all(g[:, 0] == color):\n            sides.append((\"left\", color))\n\n    assert len(sides) == 1, sides\n    return sides[0]\n\n\ndef _symbolic_grid(g: np.ndarray) -> tuple[np.ndarray, str, int]:\n    bg = get_bg(g)\n    side, marker = _marker_side(g, bg)\n    assert marker == 1, marker\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    objects: list[tuple[int, int, int]] = []\n    for component in components:\n        color = component[\"color\"]\n        if color == marker:\n            continue\n\n        b = component[\"bbox\"]\n        assert component[\"area\"] == 8, component\n        assert bbox_h(b) == 3 and bbox_w(b) == 3, component\n\n        r0, c0, r1, c1 = b\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        expected = np.full((3, 3), color, dtype=int)\n        expected[1, 1] = bg\n        assert np.array_equal(patch, expected), patch\n        objects.append((r0, c0, color))\n\n    assert objects\n    rows = sorted({r for r, _c, _color in objects})\n    cols = sorted({c for _r, c, _color in objects})\n    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)\n    row_index = {r: i for i, r in enumerate(rows)}\n    col_index = {c: i for i, c in enumerate(cols)}\n\n    for r, c, color in objects:\n        rr = row_index[r]\n        cc = col_index[c]\n        assert symbolic[rr, cc] == bg\n        symbolic[rr, cc] = color\n\n    if side in (\"top\", \"bottom\"):\n        dominant_cols = range(3, 6) if side == \"top\" else range(0, 3)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in range(symbolic.shape[0])\n            for c in dominant_cols\n            if int(symbolic[r, c]) != bg\n        ]\n    else:\n        dominant_rows = range(0, 3) if side == \"left\" else range(3, 6)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in dominant_rows\n            for c in range(symbolic.shape[1])\n            if int(symbolic[r, c]) != bg\n        ]\n    assert dominant_values and set(dominant_values) == {8}, dominant_values\n\n    return symbolic, side, bg\n\n\ndef _compact(symbolic: np.ndarray, side: str, bg: int) -> np.ndarray:\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n\ndef _gen_hollow_patch(color, bg):\n    patch = np.full((GEN_SYMBOL_PATCH_SIZE, GEN_SYMBOL_PATCH_SIZE), color, dtype=int)\n    patch[GEN_SYMBOL_PATCH_SIZE // 2, GEN_SYMBOL_PATCH_SIZE // 2] = bg\n    return patch\n\n\ndef _gen_expand(symbolic, side, bg):\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n    _gen_place_marker(grid, side)\n\n    row_positions, col_positions = _gen_lattice_positions(side)\n    for r in range(symbolic.shape[0]):\n        for c in range(symbolic.shape[1]):\n            color = int(symbolic[r, c])\n            if color == bg:\n                continue\n            paste(grid, _gen_hollow_patch(color, bg), row_positions[r], col_positions[c])\n    return grid\n\n","exit_code":0,"status":"completed"}}
