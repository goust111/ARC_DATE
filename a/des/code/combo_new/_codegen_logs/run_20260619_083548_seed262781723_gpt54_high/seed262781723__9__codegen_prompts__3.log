{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/825aa9e9.py\"","aggregated_output":"import math\nimport random\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, paste\n\n\ndef _blocked_mask(g: np.ndarray, obstacle: int) -> np.ndarray:\n    obstacle_mask = g == int(obstacle)\n    cushion = np.zeros_like(obstacle_mask, dtype=bool)\n    cushion[:-1, :] = obstacle_mask[1:, :]\n    bottom_edge = np.zeros_like(obstacle_mask, dtype=bool)\n    bottom_edge[-1, :] = True\n    return obstacle_mask | cushion | bottom_edge\n\n\ndef _assert_output_separated(out: np.ndarray, obstacle: int, moving: int) -> None:\n    obstacle_mask = out == int(obstacle)\n    near_obstacle = np.zeros_like(obstacle_mask, dtype=bool)\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n\n            src_r0 = max(0, -dr)\n            src_r1 = out.shape[0] - max(0, dr)\n            src_c0 = max(0, -dc)\n            src_c1 = out.shape[1] - max(0, dc)\n            dst_r0 = max(0, dr)\n            dst_r1 = out.shape[0] - max(0, -dr)\n            dst_c0 = max(0, dc)\n            dst_c1 = out.shape[1] - max(0, -dc)\n            near_obstacle[dst_r0:dst_r1, dst_c0:dst_c1] |= obstacle_mask[\n                src_r0:src_r1, src_c0:src_c1\n            ]\n\n    assert not np.any((out == int(moving)) & near_obstacle), (\n        \"settled moving objects must not be 8-connected to obstacles\"\n    )\n\n\ndef _obstacle_column_heights(g: np.ndarray, obstacle: int) -> list[int]:\n    heights = []\n    obstacle_mask = g == int(obstacle)\n    H, W = map(int, g.shape)\n    for c in range(W):\n        rows = np.flatnonzero(obstacle_mask[:, c])\n        heights.append(0 if len(rows) == 0 else H - int(rows[0]))\n    return heights\n\n\ndef _assert_obstacle_profile(g: np.ndarray, obstacle: int) -> None:\n    heights = _obstacle_column_heights(g, obstacle)\n    occupied = [h for h in heights if h > 0]\n    assert occupied, \"obstacle must occupy at least one bottom-supported column\"\n\n    H, W = map(int, g.shape)\n    obstacle_mask = g == int(obstacle)\n    total = int(obstacle_mask.sum())\n    bottom3 = int(obstacle_mask[max(0, H - 3) :, :].sum())\n\n    assert len(occupied) * 3 >= W, \"obstacle must cover a substantial part of the bottom\"\n    assert sum(occupied) * 4 <= len(occupied) * 13, (\n        \"obstacle columns must be low on average\"\n    )\n    assert bottom3 * 5 >= total * 3, \"obstacle pixels must be mostly near the bottom\"\n\n\ndef _infer_roles(g: np.ndarray) -> tuple[int, int, int]:\n    colors = colors_present(g)\n    assert len(colors) == 3, \"expected background, obstacle, and moving colors\"\n\n    candidates = []\n    for bg in colors:\n        for obstacle in colors:\n            if obstacle == bg or not np.any(g[-1, :] == obstacle):\n                continue\n            for moving in colors:\n                if moving in (bg, obstacle) or np.any(g[-1, :] == moving):\n                    continue\n                blocked = _blocked_mask(g, obstacle)\n                if np.any(blocked & (g == moving)):\n                    continue\n                candidates.append((int(bg), int(obstacle), int(moving)))\n\n    assert len(candidates) == 1, \"roles must be uniquely determined\"\n    return candidates[0]\n\n\ndef _movable_components(out: np.ndarray, bg: int, moving: int, blocked: np.ndarray) -> list[tuple[np.ndarray, np.ndarray]]:\n    moving_mask = out == int(moving)\n    moves = []\n    for comp in find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[moving]):\n        coords = comp[\"coords\"]\n        shifted = coords + np.array([1, 0])\n        if int(shifted[:, 0].max()) >= int(out.shape[0]):\n            continue\n        if np.any(blocked[shifted[:, 0], shifted[:, 1]]):\n            continue\n\n        other_moving = moving_mask.copy()\n        other_moving[coords[:, 0], coords[:, 1]] = False\n        if np.any(other_moving[shifted[:, 0], shifted[:, 1]]):\n            continue\n        moves.append((coords, shifted))\n    return moves\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.\n\n    Input structure:\n    - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.\n    - The obstacle color is the unique non-background role that touches the bottom edge.\n    - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.\n\n    Rule:\n    - Keep the background and obstacle pixels fixed.\n    - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.\n    - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.\n\n    Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, obstacle, moving = _infer_roles(g)\n    _assert_obstacle_profile(g, obstacle)\n    blocked = _blocked_mask(g, obstacle)\n    assert not np.any(blocked & (g == moving)), \"moving pixels must start in free cells\"\n\n    out = g.copy()\n    while True:\n        moves = _movable_components(out, bg, moving, blocked)\n        if not moves:\n            break\n        for coords, _ in moves:\n            out[coords[:, 0], coords[:, 1]] = bg\n        for _, shifted in moves:\n            out[shifted[:, 0], shifted[:, 1]] = moving\n\n    _assert_output_separated(out, obstacle, moving)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nGRID_H_RANGE = (4, 10)\nGRID_W_RANGE = (7, 20)\n\n# Obstacle profile constraints.\nOBSTACLE_COVERAGE_RANGE = (0.08, 0.52)\nPOCKET_COUNT_RANGE = (1, 5)\nDISTINCT_HEIGHT_COUNT_RANGE = (2, 4)\nOBSTACLE_COMPONENT_RANGE = (1, 3)\nBOTTOM_BAND_ROWS = 3\nBOTTOM_COLS_MIN_MULTIPLIER = 3\nCOLUMN_AVG_MAX_NUM = 13\nCOLUMN_AVG_MAX_DEN = 4\nBOTTOM3_MIN_NUM = 3\nBOTTOM3_MIN_DEN = 5\n\n# Bottom-heavy profile sampling.\nPROFILE_RETRIES = 120\nBOTTOM_HEAVY_WEIGHT = 5\nLOW_COLUMN_EXTRA_PROB = 0.35\nLOW_COLUMN_HEIGHT2_PROB = 0.25\nTALL_RUN_COUNT_MAX = 3\nTALL_RUN_WIDTH2_MIN_W = 10\nTALL_RUN_WIDTH2_PROB = 0.25\nMEDIUM_RUN_PROB = 0.45\nMEDIUM_RUN_WIDTH_MAX = 4\nSHORT_OBSTACLE_MAX_H = 4\nMEDIUM_RUN_HEIGHT_MIN = 2\n\n# Sparse post profile sampling.\nWIDTH_PLACEMENT_RETRIES = 80\nSPARSE_POST_MIN_BOTTOM_FRAC = 3\nSPARSE_POST_MAX_BOTTOM_FRAC = 0.45\nSPARSE_POST_RUN_COUNT_MAX = 3\nSPARSE_POST_HEIGHT1_PROB = 0.8\n\n# Moving object sampling and validation.\nPALETTE_SIZE = 10\nOBJECT_COUNT_RANGE = (1, 3)\nOBJECT_AREA_RANGE = (1, 21)\nOBJECT_BBOX_MAX_H = 6\nOBJECT_BBOX_MAX_W = 7\nMIN_LIFT_ROWS = 1\nMAX_LIFT_ROWS = 4\n\n# Whole-input retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _spread_extra(widths, extra):\n    widths = list(widths)\n    for _ in range(int(extra)):\n        widths[random.randrange(len(widths))] += 1\n    return widths\n\n\ndef _blocked_from_heights(heights, H):\n    first = []\n    for h in heights:\n        first.append(H - 1 if h == H else max(0, h - 1))\n    return np.array(first, dtype=int)\n\n\ndef _pocket_count(heights):\n    min_h = min(heights)\n    count = 0\n    in_run = False\n    for h in heights:\n        if h > min_h:\n            if not in_run:\n                count += 1\n                in_run = True\n        else:\n            in_run = False\n    return count\n\n\ndef _placement_runs(heights, H):\n    \"\"\"Return constant-depth pocket runs as (left, right, first_blocked_row).\"\"\"\n    first_blocked = _blocked_from_heights(heights, H)\n    min_h = min(heights)\n    runs = []\n    start = None\n    depth = None\n    for c, h in enumerate(heights + [min_h]):\n        d = int(first_blocked[c]) if c < len(heights) else None\n        ok = c < len(heights) and h > min_h and d >= 2\n        if ok and start is None:\n            start = c\n            depth = d\n        elif ok and d == depth:\n            pass\n        else:\n            if start is not None:\n                runs.append((start, c - 1, int(depth)))\n                start = None\n            if ok:\n                start = c\n                depth = d\n    return runs\n\n\ndef _profile_is_valid(heights, H, W):\n    if heights is None or len(heights) != W:\n        return False\n    min_distinct, max_distinct = DISTINCT_HEIGHT_COUNT_RANGE\n    if not (min_distinct <= len(set(heights)) <= max_distinct):\n        return False\n    min_pockets, max_pockets = POCKET_COUNT_RANGE\n    if not (min_pockets <= _pocket_count(heights) <= max_pockets):\n        return False\n\n    area = sum(H - h for h in heights if h < H)\n    coverage = area / (H * W)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b74ca5d1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b74ca5d1.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import NamedTuple\nfrom numpy.random import default_rng\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg\n\n\nclass Sprite(NamedTuple):\n    body: int\n    marker: int\n    top: int\n    left: int\n    marker_rc: tuple[int, int]\n    mask: np.ndarray\n    body_mask: np.ndarray\n\n\ndef _corners(h: int, w: int) -> list[tuple[int, int]]:\n    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]\n\n\ndef _corner_labels(g: np.ndarray, bg: int) -> tuple[set[int], dict[int, tuple[int, int]]]:\n    labels: set[int] = set()\n    label_corner: dict[int, tuple[int, int]] = {}\n    h, w = g.shape\n    for r, c in _corners(h, w):\n        color = int(g[r, c])\n        if color == bg:\n            continue\n        assert color not in label_corner, \"each marker color must appear in exactly one corner\"\n        labels.add(color)\n        label_corner[color] = (r, c)\n    assert labels, \"expected at least one corner marker\"\n    return labels, label_corner\n\n\ndef _find_sprites(g: np.ndarray, bg: int, labels: set[int]) -> list[Sprite]:\n    h, w = g.shape\n    sprites: list[Sprite] = []\n    body_colors = set(colors_present(g, exclude={bg})) - labels\n    assert body_colors, \"expected non-corner body colors\"\n\n    for body in sorted(body_colors):\n        body_pts = np.argwhere(g == body)\n        assert body_pts.size, \"body color must be present\"\n        r0, c0 = body_pts.min(axis=0)\n        r1, c1 = body_pts.max(axis=0)\n        assert r1 - r0 < 5 and c1 - c0 < 5, \"each body color must fit in one 5x5 window\"\n\n        candidates: list[Sprite] = []\n        top_min = max(0, int(r1) - 4)\n        top_max = min(int(r0), h - 5)\n        left_min = max(0, int(c1) - 4)\n        left_max = min(int(c0), w - 5)\n        for top in range(top_min, top_max + 1):\n            for left in range(left_min, left_max + 1):\n                window = g[top : top + 5, left : left + 5]\n                other_colors = set(colors_present(window, exclude={bg, body}))\n                if len(other_colors) != 1:\n                    continue\n                marker = other_colors.pop()\n                if marker not in labels:\n                    continue\n                if int(np.count_nonzero(window == marker)) != 1:\n                    continue\n                if int(np.count_nonzero(window == body)) != len(body_pts):\n                    continue\n\n                marker_pos = np.argwhere(window == marker)\n                assert len(marker_pos) == 1\n                mr, mc = map(int, marker_pos[0])\n                candidates.append(\n                    Sprite(\n                        body=int(body),\n                        marker=int(marker),\n                        top=int(top),\n                        left=int(left),\n                        marker_rc=(mr, mc),\n                        mask=window != bg,\n                        body_mask=window == body,\n                    )\n                )\n\n        assert len(candidates) == 1, \"each body color must define a unique marked 5x5 sprite\"\n        sprites.append(candidates[0])\n\n    return sprites\n\n\ndef _owner_sets(group: list[Sprite]) -> list[list[set[int]]]:\n    owners = [[set() for _c in range(5)] for _r in range(5)]\n    for i, sprite in enumerate(group):\n        for r, c in np.argwhere(sprite.mask):\n            owners[int(r)][int(c)].add(i)\n    return owners\n\n\ndef _run_reaches_target_edge(\n    owners: list[list[set[int]]], owner: int, r: int, c: int, *, top_corner: bool\n) -> bool:\n    if top_corner:\n        rr = r\n        while rr >= 0 and owner in owners[rr][c]:\n            rr -= 1\n        return rr == -1\n\n    rr = r\n    while rr < 5 and owner in owners[rr][c]:\n        rr += 1\n    return rr == 5\n\n\ndef _corner_composite_mask(group: list[Sprite], *, top_corner: bool) -> np.ndarray:\n    owners = _owner_sets(group)\n    keep = np.array([[bool(owners[r][c]) for c in range(5)] for r in range(5)], dtype=bool)\n\n    # A one-sprite vertical tail hidden behind horizontal neighbors from other sprites\n    # is not part of the visible composite unless that run reaches the target edge.\n    if top_corner:\n        rows = range(1, 4)\n        away_step = 1\n        toward = lambda r: r - 1\n        in_bounds = lambda r: r < 5\n    else:\n        rows = range(3, 0, -1)\n        away_step = -1\n        toward = lambda r: r + 1\n        in_bounds = lambda r: r >= 0\n\n    for r in rows:\n        for c in range(1, 4):\n            if not keep[r, c] or len(owners[r][c]) != 1:\n                continue\n            owner = next(iter(owners[r][c]))\n            if _run_reaches_target_edge(owners, owner, r, c, top_corner=top_corner):\n                continue\n            if owner not in owners[toward(r)][c]:\n                continue\n            if not owners[r][c - 1] or not owners[r][c + 1]:\n                continue\n            if owner in owners[r][c - 1] or owner in owners[r][c + 1]:\n                continue\n\n            rr = r\n            while in_bounds(rr) and keep[rr, c] and owners[rr][c] == {owner}:\n                keep[rr, c] = False\n                rr += away_step\n\n    return keep\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swap each 5x5 sprite with its corner marker color and stamp same-marker composite masks into the matching corner.\n\n    Input structure:\n    - A 30x30 grid has one dominant background color.\n    - Non-background corner pixels are marker labels.\n    - Every other foreground color is the body of one 5x5 sprite containing exactly one pixel of a corner marker color.\n\n    Rule:\n    - For each sprite, recolor body pixels to the sprite marker color and recolor the marker pixel back to its body color.\n    - If a marker lies on the side facing its matching corner and another same-marker sprite has a body pixel at that same local cell, use that visible body color for the marker pixel.\n    - For each corner marker, overlay the masks of all sprites with that marker color into the corner 5x5 block and paint the visible composite with the marker color.\n\n    Key insight:\n    The corner pixels are labels that group 5x5 sprites by their embedded marker color; each labeled corner shows the grouped sprite silhouette.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = int(get_bg(g))\n    labels, label_corner = _corner_labels(g, bg)\n    sprites = _find_sprites(g, bg, labels)\n\n    by_marker: dict[int, list[Sprite]] = defaultdict(list)\n    for sprite in sprites:\n        by_marker[sprite.marker].append(sprite)\n\n    out = g.copy()\n    for sprite in sprites:\n        window = g[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]\n        patch = out[sprite.top : sprite.top + 5, sprite.left : sprite.left + 5]\n        patch[window == sprite.body] = sprite.marker\n\n        mr, mc = sprite.marker_rc\n        replacement = sprite.body\n        _corner_r, corner_c = label_corner[sprite.marker]\n        side_col = 0 if corner_c == 0 else 4\n        if mc == side_col:\n            overlaps = [\n                other.body\n                for other in by_marker[sprite.marker]\n                if other is not sprite and bool(other.body_mask[mr, mc])\n            ]\n            if overlaps:\n                assert len(overlaps) == 1, \"side marker overlap must identify one visible body color\"\n                replacement = overlaps[0]\n        patch[mr, mc] = replacement\n\n    for r, c in _corners(h, w):\n        label = int(g[r, c])\n        if label == bg:\n            continue\n        group = by_marker[label]\n        assert group, \"each corner marker must have at least one matching sprite\"\n        mask = _corner_composite_mask(group, top_corner=(r == 0))\n        rows = slice(0, 5) if r == 0 else slice(h - 5, h)\n        cols = slice(0, 5) if c == 0 else slice(w - 5, w)\n        patch = out[rows, cols]\n        patch[mask] = label\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and sprite geometry.\nGRID_H = 30\nGRID_W = 30\nSPRITE_SIZE = 5\nPLACEMENT_GAP = 1\n\n# Marker and sprite counts.\nNUM_CORNERS_OPTIONS = (2, 3)\nNUM_SPRITES_OPTIONS = (4, 5)\nMIN_GROUP_SPRITES = 1\nMAX_GROUP_SPRITES = 3\n\n# Sprite mask sampling: foreground includes the one marker pixel.\nMIN_BODY_PIXELS = 4\nMAX_BODY_PIXELS = 15\nMIN_FOREGROUND_PIXELS = MIN_BODY_PIXELS + 1\nMAX_FOREGROUND_PIXELS_EXCLUSIVE = MAX_BODY_PIXELS + 2\n\n# Retry budgets.\nDISTRIBUTION_ATTEMPTS = 100\nSPRITE_MASK_ATTEMPTS = 200\nGENERATE_ATTEMPTS = 300\n\nARC_COLORS = list(range(10))\nCORNER_POSITIONS = (\n    (0, 0),\n    (0, GRID_W - 1),\n    (GRID_H - 1, 0),\n    (GRID_H - 1, GRID_W - 1),\n)\nSPRITE_CELLS = [(r, c) for r in range(SPRITE_SIZE) for c in range(SPRITE_SIZE)]\n\n\ndef _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:\n    \"\"\"Generate a single valid input grid for the b74ca5d1 task.\"\"\"\n    all_colors = ARC_COLORS.copy()\n    rng.shuffle(all_colors)\n    bg = all_colors[0]\n\n    num_corners = rng.choice(NUM_CORNERS_OPTIONS)\n    chosen_corner_indices = rng.choice(4, size=num_corners, replace=False)\n","exit_code":0,"status":"completed"}}
