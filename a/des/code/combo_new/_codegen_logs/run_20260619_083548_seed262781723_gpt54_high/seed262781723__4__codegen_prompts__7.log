{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /home/lixinyu/snap/new/ARC_code/train/46c35fc7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _rotate_ring(out: np.ndarray, g: np.ndarray, r0: int, c0: int) -> None:\n    patch = g[r0 : r0 + 3, c0 : c0 + 3]\n\n    out[r0 + 0, c0 + 0] = patch[0, 2]\n    out[r0 + 0, c0 + 1] = patch[1, 0]\n    out[r0 + 0, c0 + 2] = patch[2, 2]\n    out[r0 + 1, c0 + 0] = patch[2, 1]\n    out[r0 + 1, c0 + 2] = patch[0, 1]\n    out[r0 + 2, c0 + 0] = patch[0, 0]\n    out[r0 + 2, c0 + 1] = patch[1, 2]\n    out[r0 + 2, c0 + 2] = patch[2, 0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.\n\n    Rule\n    - For each ring, move corner colors one step around the four corners.\n    - Move side-center colors one step around the four side centers in the opposite direction.\n    - Leave the background center and all other background pixels unchanged.\n\n    Key insight\n    - Corners and side centers form two separate four-cycles on the same 3x3 ring.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    out = g.copy()\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert components\n\n    for comp in components:\n        bbox = comp[\"bbox\"]\n        r0, c0, r1, c1 = map(int, bbox)\n        assert bbox_h(bbox) == 3\n        assert bbox_w(bbox) == 3\n        assert int(comp[\"area\"]) == 8\n        assert g[r0 + 1, c0 + 1] == bg\n\n        ring_coords = {\n            (r0 + dr, c0 + dc)\n            for dr in range(3)\n            for dc in range(3)\n            if (dr, dc) != (1, 1)\n        }\n        component_coords = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n        assert component_coords == ring_coords\n        assert r1 == r0 + 2\n        assert c1 == c0 + 2\n\n        _rotate_ring(out, g, r0, c0)\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color and canvas bounds.\nBG_COLOR = 7\nCOLOR_IDS = tuple(range(10))\nGRID_SIDE_MIN, GRID_SIDE_MAX = 6, 10\nMIN_BACKGROUND_PCT = 67\n\n# Ring geometry, counts, and placement spacing.\nRING_SIZE, RING_AREA, RING_GAP = 3, 8, 1\nRING_COUNT_MIN, RING_COUNT_MAX = 1, 2\nRING_UNIQUE_MIN, RING_UNIQUE_MAX = 2, RING_AREA\nRING_CELLS = (\n    (0, 0),\n    (0, 1),\n    (0, 2),\n    (1, 0),\n    (1, 2),\n    (2, 0),\n    (2, 1),\n    (2, 2),\n)\n\n# Retry budget for rejection through the solver oracle.\nGENERATION_RETRIES = 300\n\n\ndef _bbox_at(r: int, c: int) -> tuple[int, int, int, int]:\n    return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1\n\n\ndef _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return (\n        a[2] + RING_GAP < b[0]\n        or b[2] + RING_GAP < a[0]\n        or a[3] + RING_GAP < b[1]\n        or b[3] + RING_GAP < a[1]\n    )\n\n\ndef _valid_position_sets(rows: int, cols: int, count: int) -> list[tuple[tuple[int, int], ...]]:\n    positions = [(r, c) for r in range(rows - RING_SIZE + 1) for c in range(cols - RING_SIZE + 1)]\n    if count == 1:\n        return [(pos,) for pos in positions]\n\n    pairs = []\n    for i, first in enumerate(positions):\n        box1 = _bbox_at(*first)\n        for second in positions[i + 1 :]:\n            if _separated(box1, _bbox_at(*second)):\n                pairs.append((first, second))\n    return pairs\n\n\ndef _compatible_sizes(count: int) -> list[tuple[int, int]]:\n    sizes = []\n    for rows in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n        for cols in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):\n            area = rows * cols\n            if (area - RING_AREA * count) * 100 < MIN_BACKGROUND_PCT * area:\n                continue\n            if _valid_position_sets(rows, cols, count):\n                sizes.append((rows, cols))\n    return sizes\n\n\n_SIZES = {count: _compatible_sizes(count) for count in range(RING_COUNT_MIN, RING_COUNT_MAX + 1)}\n_POSITION_SETS = {\n    count: {size: _valid_position_sets(*size, count) for size in _SIZES[count]}\n    for count in _SIZES\n}\n\n\ndef _make_ring(bg: int) -> np.ndarray:\n    ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)\n    palette = [color for color in COLOR_IDS if color != bg]\n    unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)\n    chosen = random.sample(palette, unique_count)\n    values = chosen + [random.choice(chosen) for _ in range(RING_AREA - unique_count)]\n    random.shuffle(values)\n    for (dr, dc), color in zip(RING_CELLS, values):\n        ring[dr, dc] = color\n    return ring\n\n\ndef _rotated_output(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> np.ndarray:\n    out = grid.copy()\n    for r0, c0 in positions:\n        _rotate_ring(out, grid, r0, c0)\n    return out\n\n\ndef _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:\n    grid = np.full((rows, cols), bg, dtype=int)\n    for r0, c0 in positions:\n        paste(grid, _make_ring(bg), r0, c0)\n    return grid\n\n\ndef _oracle_accepts(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> bool:\n    expected = _rotated_output(grid, positions)\n    try:\n        actual = main(grid)\n    except AssertionError:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BG_COLOR\n    count = random.randint(RING_COUNT_MIN, RING_COUNT_MAX)\n    rows, cols = random.choice(_SIZES[count])\n    positions = random.choice(_POSITION_SETS[count][(rows, cols)])\n    grid = _render_grid(rows, cols, positions, bg)\n    return grid if _oracle_accepts(grid, positions) else None\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _unique_mode(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    ranked = counts.most_common()\n    assert ranked, \"expected a nonempty set of values\"\n    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    return int(ranked[0][0])\n\n\ndef _separator_lines(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    height, width = map(int, g.shape)\n    candidates = []\n    for color in np.unique(g):\n        color = int(color)\n        rows = [r for r in range(height) if np.all(g[r, :] == color)]\n        cols = [c for c in range(width) if np.all(g[:, c] == color)]\n        if rows and cols:\n            candidates.append((color, rows, cols))\n    assert len(candidates) == 1, \"expected one color to form full separator rows and columns\"\n    return candidates[0]\n\n\ndef _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:\n    spans = []\n    start = 0\n    for sep in separators:\n        assert start < sep, \"separator lines must leave nonempty regions\"\n        spans.append((start, sep - 1))\n        start = sep + 1\n    assert start < length, \"separator lines must leave a final nonempty region\"\n    spans.append((start, length - 1))\n    return spans\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r: int, c: int, size: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < size and 0 <= cc < size:\n            yield rr, cc\n\n\ndef _gen_partition(total: int, parts: int) -> list[int]:\n    sizes = [1] * parts\n    for _ in range(total - parts):\n        sizes[random.randrange(parts)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n    size = int(labels.shape[0])\n    for rr, cc in _gen_neighbors4(r, c, size):\n        if labels[rr, cc] not in (0, label):\n            return False\n    return True\n\n\ndef _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n    pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n    component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))\n    labels = np.zeros((size, size), dtype=int)\n    for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):\n        seed_candidates = [\n            (r, c)\n            for r in range(size)\n            for c in range(size)\n            if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)\n        ]\n        if not seed_candidates:\n            return None\n\n        seed = random.choice(seed_candidates)\n        labels[seed] = label\n        cells = [seed]\n        while len(cells) < component_size:\n            growth = []\n            for r, c in cells:\n                for rr, cc in _gen_neighbors4(r, c, size):\n                    if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):\n                        growth.append((rr, cc))\n            if not growth:\n                return None\n            cell = random.choice(growth)\n            labels[cell] = label\n            cells.append(cell)\n\n    tile = np.full((size, size), bg, dtype=int)\n    tile[labels > 0] = sprite_color\n    tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))\n","exit_code":0,"status":"completed"}}
