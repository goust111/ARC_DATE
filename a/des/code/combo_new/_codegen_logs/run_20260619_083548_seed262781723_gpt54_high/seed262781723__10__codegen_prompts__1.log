 the same pattern resized to its own dimensions.\n 103:     \"\"\"\n 104:     g = np.asarray(grid, dtype=int)\n 105:     assert g.ndim == 2, \"expected a 2D grid\"\n 106:     bg = _boundary_bg(g)\n 107: \n 108:     objects = []\n 109:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n 110:         bbox = tuple(map(int, comp[\"bbox\"]))\n 111:         sub = crop_bbox(g, bbox)\n 112:         assert np.all(sub != bg), \"foreground rectangles must be dense\"\n 113: \n 114:         base_color = _unique_most_common(sub)\n 115:         marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n 116:         objects.append(\n 117:             {\n 118:                 \"bbox\": bbox,\n 119:                 \"sub\": sub,\n 120:                 \"base_color\": int(base_color),\n 121:                 \"marker_colors\": marker_colors,\n 122:             }\n 123:         )\n 124: \n 125:     plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n 126:     assert len(plain) == 1, \"expected exactly one plain rectangle\"\n 127:     target = plain[0]\n 128:     tr0, tc0, tr1, tc1 = target[\"bbox\"]\n 129:     target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n 130: \n 131:     sources = [\n 132:         obj\n 133:         for obj in objects\n 134:         if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n 135:     ]\n 136:     assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n 137: \n 138:     marker_colors = set()\n 139:     for source in sources:\n 140:         marker_colors.update(source[\"marker_colors\"])\n 141:     assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n 142:     marker_color = int(next(iter(marker_colors)))\n 143: \n 144:     masks = []\n 145:     for source in sources:\n 146:         assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n 147:         masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n 148: \n 149:     pattern = masks[0]\n 150:     for mask in masks[1:]:\n 151:         assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n 152: \n 153:     out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n 154:     out[pattern] = marker_color\n 155:     return out\n--------------------------------------------------------------------------------\ngenerate_input lines 450-455\n 450: def generate_input() -> np.ndarray:\n 451:     for _ in range(GENERATION_ATTEMPTS):\n 452:         result = _gen_attempt()\n 453:         if result is not None:\n 454:             return result\n 455:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n====================================================================================================\n/home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\n--------------------------------------------------------------------------------\nmain lines 51-102\n  51: def main(grid: np.ndarray) -> np.ndarray:\n  52:     \"\"\"\n  53:     Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n  54: \n  55:     Input structure:\n  56:     - A teal background contains small colored template masks above a larger rectangular frame.\n  57:     - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n  58:     - The frame interior dimensions are an integer square scale of the matching template bbox.\n  59: \n  60:     Rule:\n  61:     - Crop to the rectangular frame.\n  62:     - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n  63:     - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n  64: \n  65:     Key insight:\n  66:     The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n  67:     \"\"\"\n  68:     g = np.asarray(grid, dtype=int)\n  69:     bg = int(get_bg(g))\n  70:     frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n  71: \n  72:     out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n  73:     interior = out[1:-1, 1:-1]\n  74:     fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n  75:     assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n  76:     fill_color = fill_colors.pop()\n  77: \n  78:     seed = interior == fill_color\n  79:     assert np.any(seed), \"frame must contain seed pixels\"\n  80:     ih, iw = seed.shape\n  81: \n  82:     matches: list[np.ndarray] = []\n  83:     for template in _templates_above_frame(g, bg, r0):\n  84:         th, tw = template.shape\n  85:         if ih % th != 0 or iw % tw != 0:\n  86:             continue\n  87:         scale_h = ih // th\n  88:         scale_w = iw // tw\n  89:         if scale_h != scale_w:\n  90:             continue\n  91: \n  92:         scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n  93:         if np.all(~seed | scaled):\n  94:             matches.append(scaled)\n  95: \n  96:     assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n  97:     completed = matches[0]\n  98:     assert completed.shape == interior.shape\n  99: \n 100:     interior[:, :] = bg\n 101:     interior[completed] = fill_color\n 102:     return out\n--------------------------------------------------------------------------------\ngenerate_input lines 251-256\n 251: def generate_input() -> np.ndarray:\n 252:     for _ in range(GEN_ATTEMPTS):\n 253:         grid = _gen_attempt()\n 254:         if grid is not None:\n 255:             return grid\n 256:     raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n\n====================================================================================================\n/home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py\n--------------------------------------------------------------------------------\nmain lines 17-61\n  17: def main(grid: np.ndarray) -> np.ndarray:\n  18:     \"\"\"\n  19:     Replace the outlined object with the outside contour of that outline in the marker color.\n  20: \n  21:     Input structure:\n  22:     - A dominant background surrounds one 8-connected foreground outline.\n  23:     - The outline is the unique largest foreground color.\n  24:     - One or more smaller interior colors are inside the outline; the marker color\n  25:       is the unique smallest non-outline color.\n  26: \n  27:     Rule:\n  28:     - Erase all original foreground pixels to background.\n  29:     - Paint every background pixel that is 4-adjacent to the outline with the\n  30:       marker color.\n  31:     - Keep the grid shape unchanged.\n  32: \n  33:     Key insight: The colored interior marker supplies the paint color, while the\n  34:     largest outline supplies only the contour whose outside edge is traced.\n  35:     \"\"\"\n  36:     g = np.asarray(grid, dtype=int)\n  37:     bg = int(get_bg(g))\n  38: \n  39:     counts = Counter(map(int, g.flatten()))\n  40:     foreground_colors = [color for color in counts if color != bg]\n  41:     assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n  42: \n  43:     frame_count = max(counts[color] for color in foreground_colors)\n  44:     frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n  45:     assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n  46: \n  47:     marker_candidates = [color for color in foreground_colors if color != frame_color]\n  48:     marker_count = min(counts[color] for color in marker_candidates)\n  49:     marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n  50: \n  51:     out = np.full_like(g, bg)\n  52:     contour: set[tuple[int, int]] = set()\n  53:     for r, c in np.argwhere(g == frame_color):\n  54:         for nr, nc in neighbors4(int(r), int(c)):\n  55:             if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n  56:                 contour.add((int(nr), int(nc)))\n  57:     assert contour, \"expected outline to touch background contour cells\"\n  58: \n  59:     for r, c in contour:\n  60:         out[r, c] = marker_color\n  61:     return out\n--------------------------------------------------------------------------------\ngenerate_input lines 300-305\n 300: def generate_input():\n 301:     for _ in range(GEN_ATTEMPTS):\n 302:         grid = _gen_attempt()\n 303:         if grid is not None:\n 304:             return grid\n 305:     raise RuntimeError(\"failed to generate a valid aa62e3f4 input\")\n","exit_code":0,"status":"completed"}}
