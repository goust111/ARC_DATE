])\n 440:     paste(grid, dest_rect, dst_pos[0], dst_pos[1])\n 441: \n 442:     if not np.array_equal(main(grid), output):\n 443:         return None\n 444:     return grid\n 445: \n 446: \n 447: def generate_input() -> np.ndarray:\n 448:     for _ in range(MAX_GEN_ATTEMPTS):\n 449:         grid = _gen_attempt()\n 450:         if grid is not None:\n 451:             return grid\n 452:     raise RuntimeError(\"failed to generate a251c730 input after %d attempts\" % MAX_GEN_ATTEMPTS)\n\n====================================================================================================\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n_gen_attempt lines 449-549\n 449: def _gen_attempt():\n 450:     rng = random.Random()\n 451:     bg = 0\n 452: \n 453:     # Grid size and palette side\n 454:     H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n 455:     W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n 456:     side = rng.choice(['top', 'bottom', 'left', 'right'])\n 457:     if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n 458:         side = rng.choice(['left', 'right'])\n 459: \n 460:     max_N = H if side in ('left', 'right') else W\n 461:     N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n 462: \n 463:     # Sprite dimension bounds\n 464:     max_sh = min(_SPRITE_H_MAX, H)\n 465:     max_sw = min(_SPRITE_W_MAX, W)\n 466:     if H <= _TINY_H_THRESHOLD:\n 467:         max_sh = 3\n 468: \n 469:     # Sprite counts\n 470:     num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n 471:     total_sprites = num_filled + 1\n 472: \n 473:     # Generate sprite shapes\n 474:     shapes = []\n 475:     for _ in range(total_sprites):\n 476:         sh = rng.randint(3, max_sh)\n 477:         sw = rng.randint(3, max_sw)\n 478:         if sh + sw > _SPRITE_DIM_SUM_CAP:\n 479:             sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n 480:         if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n 481:             mask = _make_diamond()\n 482:         else:\n 483:             mask = _make_hollow_sprite(sh, sw, rng)\n 484:         if mask is None:\n 485:             return None\n 486:         shapes.append(mask)\n 487: \n 488:     # Colors and palette\n 489:     border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n 490:         _choose_colors(rng, N, num_filled)\n 491:     pal = _build_palette(side, border_keys, fill_values)\n 492: \n 493:     grid = np.full((H, W), bg, dtype=int)\n 494:     occ = np.zeros((H, W), dtype=bool)\n 495:     _place_palette(grid, occ, pal, side, rng)\n 496: \n 497:     # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n 498:     infos = []\n 499:     for i, mask in enumerate(shapes):\n 500:         if i < num_filled:\n 501:             c, f = filled_keys[i], mapping[filled_keys[i]]\n 502:         else:\n 503:             c, f = distractor_color, None\n 504:         infos.append((mask, c, f))\n 505: \n 506:     # Place sprites\n 507:     placed = []\n 508:     for mask, color, fill in infos:\n 509:         holes = _get_enclosed_holes(mask)\n 510:         positions = _find_valid_positions(H, W, occ, mask, holes)\n 511:         if not positions:\n 512:             return None\n 513:         r0, c0 = rng.choice(positions)\n 514:         _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n 515:         placed.append((r0, c0, mask, fill))\n 516:         sh, sw = mask.shape\n 517:         occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n 518:             max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n 519: \n 520:     # Derive input from output by clearing filled holes\n 521:     output = grid.copy()\n 522:     inp = grid.copy()\n 523:     for r0, c0, mask, fill in placed:\n 524:         if fill is not None:\n 525:             for hpts in _get_enclosed_holes(mask):\n 526:                 for hr, hc in hpts:\n 527:                     inp[r0 + hr, c0 + hc] = bg\n 528: \n 529:     # Validate bg is dominant on border\n 530:     border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n 531:     vals, cnts = np.unique(border, return_counts=True)\n 532:     if int(vals[cnts.argmax()]) != bg:\n 533:         return None\n 534: \n 535:     # Oracle check\n 536:     try:\n 537:         if np.array_equal(main(inp), output):\n 538:             return inp\n 539:     except Exception:\n 540:         pass\n 541:     return None\n 542: \n 543: \n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
