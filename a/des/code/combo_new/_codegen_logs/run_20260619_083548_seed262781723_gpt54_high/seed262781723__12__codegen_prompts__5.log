{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/7491f3cf.py\"","aggregated_output":"from __future__ import annotations\nimport random\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import get_bg, flood_fill, neighbors8, in_bounds, label_mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.\n\n    Input structure:\n    - Four 5×5 panels in one row, border-separated.\n    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)\n               + one 8-isolated indicator pixel.\n    - Panels 1–2: source patterns. Panel 3: blank (to fill).\n\n    Rule:\n    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.\n    - Inside → non-bg from panel 1; outside → non-bg from panel 2.\n    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.\n\n    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n\n    border = int(g[0, 0])\n    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]\n    t0, t1, t2, _t3 = tiles\n    b = int(Counter(t1.flatten()).most_common(1)[0][0])\n    assert border != b, \"border color must differ from tile background\"\n\n    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])\n    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}\n    assert cue_set, \"no cue pixels found\"\n\n    # --- Indicator = the unique 8-isolated cue pixel ---\n    indicator = None\n    for r, c in cue_set:\n        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):\n            assert indicator is None, \"multiple 8-isolated cue pixels\"\n            indicator = (r, c)\n    assert indicator is not None, \"no 8-isolated cue pixel found\"\n\n    # Indicator must sit at a tile corner or edge midpoint\n    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}\n    assert indicator in valid_pos, f\"indicator {indicator} not at corner/edge-midpoint\"\n\n    wall = cue_set - {indicator}\n\n    # --- Structural assertions (feedback for generate_input agents) ---\n    assert (2, 2) in wall, \"wall must pass through the grid center (2,2)\"\n\n    # Wall must be symmetric about the line from indicator to center (2,2)\n    ir, ic = indicator\n    dr, dc = 2 - ir, 2 - ic\n    if dr == 0:\n        _refl = lambda r, c: (4 - r, c)\n    elif dc == 0:\n        _refl = lambda r, c: (r, 4 - c)\n    elif dr * dc > 0:\n        _refl = lambda r, c: (c, r)\n    else:\n        _refl = lambda r, c: (4 - c, 4 - r)\n    assert wall == {_refl(r, c) for r, c in wall}, \"wall must be symmetric about indicator→center axis\"\n\n    sides_touched = set()\n    for r, c in wall:\n        if r == 0: sides_touched.add(\"top\")\n        if r == 4: sides_touched.add(\"bottom\")\n        if c == 0: sides_touched.add(\"left\")\n        if c == 4: sides_touched.add(\"right\")\n    assert len(sides_touched) >= 2, f\"wall must span edge-to-edge, only touches {sides_touched}\"\n\n    # --- Flood fill inside region ---\n    EMPTY, WALL, INSIDE = 0, 1, 2\n    tmp = np.zeros((5, 5), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = WALL\n    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)\n    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}\n\n    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall\n    assert outside, \"wall must partition the grid — outside region is empty\"\n\n    # Wall 4-connectivity determines boundary blending behavior:\n    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.\n    wall_mask = np.zeros((5, 5), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n\n    # --- Build output tile ---\n    out3 = np.full((5, 5), b, dtype=int)\n    for r in range(5):\n        for c in range(5):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != b:\n                    out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != b:\n                    out3[r, c] = v1\n                elif wall_4conn and v2 != b:\n                    out3[r, c] = v2\n            else:\n                if v2 != b:\n                    out3[r, c] = v2\n\n    out = g.copy()\n    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3\n    return out\n\n# --------------- generator (subagent) ---------------\n\n# ── Tunables ──────────────────────────────────────────────────────────────────\nTILE_SZ = 5                    # each panel is 5x5\nGRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape\nNUM_COLORS = 10                # ARC color palette size\n\nT1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range\nT2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range\nORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling\nPATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call\nGEN_RETRIES = 300              # max retries in generate_input outer loop\nLBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)\n\n# ── Symmetric pattern orbits (D1+D2 symmetry on 5x5) ─────────────────────────\n_ORBITS = [\n    [(0, 0), (4, 4)],\n    [(0, 4), (4, 0)],\n    [(2, 2)],\n    [(1, 1), (3, 3)],\n    [(1, 3), (3, 1)],\n    [(0, 1), (1, 0), (3, 4), (4, 3)],\n    [(0, 2), (2, 0), (2, 4), (4, 2)],\n    [(0, 3), (3, 0), (1, 4), (4, 1)],\n    [(1, 2), (2, 1), (2, 3), (3, 2)],\n]\n\n\ndef _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,\n                              min_px: int, max_px: int) -> np.ndarray | None:\n    \"\"\"Sample a 5x5 grid symmetric under both diagonals, with fg pixel count in\n    [min_px, max_px].  Randomizes orbit order, includes each greedily within\n    the max budget, retries until min is met.\"\"\"\n    for _ in range(PATTERN_RETRIES):\n        order = list(range(len(_ORBITS)))\n        rng.shuffle(order)\n        p = np.full((TILE_SZ, TILE_SZ), bg, dtype=int)\n        count = 0\n        for i in order:\n            orbit = _ORBITS[i]\n            if count + len(orbit) > max_px:\n                continue\n            if rng.random() < ORBIT_INCLUDE_PROB:\n                for r, c in orbit:\n                    p[r, c] = fg\n                count += len(orbit)\n        if min_px <= count <= max_px:\n            return p\n    return None\n\n\n# ── Precomputed (indicator, wall) configurations ─────────────────────────────\n# 8 straight + 12 L-bend combos, all verified to partition the 5x5 grid.\n_STRAIGHT_CONFIGS = [\n    ((0, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((4, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row\n    ((2, 0), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((2, 4), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col\n    ((0, 0), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((4, 4), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag\n    ((0, 4), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n    ((4, 0), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag\n]\n_LBEND_CONFIGS = [\n    ((0, 0), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((0, 0), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((4, 4), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L\n    ((4, 4), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R\n    ((0, 4), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((0, 4), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 0), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R\n    ((4, 0), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L\n    ((4, 2), frozenset({(2,2),(1,1),(0,0),(1,3),(0,4)})),          # NW+NE\n    ((0, 2), frozenset({(2,2),(3,1),(4,0),(3,3),(4,4)})),          # SW+SE\n    ((2, 4), frozenset({(2,2),(1,1),(0,0),(3,1),(4,0)})),          # NW+SW\n    ((2, 0), frozenset({(2,2),(1,3),(0,4),(3,3),(4,4)})),          # NE+SE\n]\n\n\ndef _flood_inside(wall: frozenset, indicator: tuple[int, int]) -> set[tuple[int, int]]:\n    tmp = np.zeros((TILE_SZ, TILE_SZ), dtype=int)\n    for r, c in wall:\n        tmp[r, c] = 1\n    flood_fill(tmp, indicator[0], indicator[1], 2, connectivity=4)\n    return {(int(r), int(c)) for r, c in np.argwhere(tmp == 2)}\n\n\n# ── Main generation loop ─────────────────────────────────────────────────────\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    # 1. Colors: border != tile_bg; cue/t1/t2 mutually distinct and != tile_bg.\n    palette = list(range(NUM_COLORS))\n    tile_bg = rng.choice(palette)\n    other = [c for c in palette if c != tile_bg]\n    cue_color, t1_color, t2_color = rng.sample(other, 3)\n    border = rng.choice(other)\n\n    # 2. Wall + indicator (4:1 straight:L-bend ratio).\n    pool = _LBEND_CONFIGS if rng.random() < LBEND_PROB else _STRAIGHT_CONFIGS\n    indicator, wall = rng.choice(pool)\n    inside = _flood_inside(wall, indicator)\n\n    # 3. Tile-1 / Tile-2 symmetric patterns.\n    t1 = _sample_symmetric_pattern(tile_bg, t1_color, rng,\n                                   min_px=T1_MIN_PX, max_px=T1_MAX_PX)\n    t2 = _sample_symmetric_pattern(tile_bg, t2_color, rng,\n                                   min_px=T2_MIN_PX, max_px=T2_MAX_PX)\n    if t1 is None or t2 is None:\n        return None\n\n    # 4. Tile-0 (cue tile): bg + wall + indicator drawn in cue_color.\n    t0 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r, c in wall:\n        t0[r, c] = cue_color\n    t0[indicator[0], indicator[1]] = cue_color\n\n    # 5. Composite output tile-3.\n    wall_mask = np.zeros((TILE_SZ, TILE_SZ), dtype=bool)\n    for r, c in wall:\n        wall_mask[r, c] = True\n    _, n_comp = label_mask(wall_mask, connectivity=4)\n    wall_4conn = (n_comp == 1)\n    outside = set((r, c) for r in range(TILE_SZ) for c in range(TILE_SZ)) - inside - wall\n    out3 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    for r in range(TILE_SZ):\n        for c in range(TILE_SZ):\n            v1, v2 = int(t1[r, c]), int(t2[r, c])\n            if (r, c) in inside:\n                if v1 != tile_bg: out3[r, c] = v1\n            elif (r, c) in wall:\n                if v1 != tile_bg: out3[r, c] = v1\n                elif wall_4conn and v2 != tile_bg: out3[r, c] = v2\n            else:\n                if v2 != tile_bg: out3[r, c] = v2\n\n    # 6. Assemble 7x25 input grid (tile-3 input is blank).\n    t3_in = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)\n    g = np.full((GRID_ROWS, GRID_COLS), border, dtype=int)\n    for j, tile in enumerate([t0, t1, t2, t3_in]):\n        g[1:6, 1 + 6 * j: 1 + 6 * j + 5] = tile\n\n    # 7. Oracle: solver output must match hand-built composite.\n    expected = g.copy()\n    expected[1:6, 1 + 6 * 3: 1 + 6 * 3 + 5] = out3\n    got = main(g)\n    if not np.array_equal(got, expected):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/58490d8a.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, label_mask, paste, random_free_location\nimport random\nfrom functools import lru_cache\nfrom itertools import combinations\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count colored objects and record tallies inside a legend box.\n\n    Input structure:\n    - A black rectangular legend box with key-color pixels in its leftmost non-black column.\n    - Outside the box, distinct objects of each key color are scattered across the grid.\n\n    Rule:\n    - For each key color, count separate same-colored objects outside the legend box.\n    - Output the legend box repainted: each key row gets one dot per object, spaced every other cell rightward from the key pixel.\n\n    Key insight: The legend is both the color index and the output canvas — object counts become dot sequences on the matching row.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    _bg = int(get_bg(g))\n\n    black = 0\n\n    # STEP 1) Find the legend bbox: largest black CC whose bbox contains some non-black pixels.\n    best = None  # (area, bbox)\n    for coords in components_mask(g == int(black), connectivity=8):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if (sub != int(black)).any():\n            area = int(coords.shape[0])\n            cand = (area, tuple(map(int, b)))\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    assert not (best is None)\n\n    r0, c0, r1, c1 = map(int, best[1])\n    box = crop_bbox(g, (r0, c0, r1, c1))\n    bh, bw = map(int, box.shape)\n\n    # STEP 2) Inside the legend bbox, find the key column:\n    # leftmost column with any non-black pixels (the \"key pixels\").\n    key_col = None\n    for cc in range(bw):\n        if (box[:, int(cc)] != int(black)).any():\n            key_col = int(cc)\n            break\n    if key_col is None:\n        return np.zeros_like(box)\n\n    keys = [(int(rr), int(box[int(rr), int(key_col)])) for rr in range(bh) if int(box[int(rr), int(key_col)]) != int(black)]\n    keys.sort(key=lambda t: int(t[0]))\n\n    outside = np.ones((H, W), dtype=bool)\n    outside[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = False\n    out = np.zeros((bh, bw), dtype=int)\n\n    # STEP 3/4) Count CCs of each key color outside the legend, then draw 1 dot per CC.\n    for rr, col in keys:\n        mask = (g == int(col)) & outside\n        _labc, nc = label_mask(mask, connectivity=8)\n        for i in range(int(nc)):\n            cc = int(key_col + 2 * i)\n            if 0 <= cc < bw:\n                out[int(rr), int(cc)] = int(col)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette and legend color choices.\nCOLOR_POOL = tuple(range(1, 10))\nBLACK = 0\nDISTRACTOR_PROB = 0.5\n\n# Key rows and tally dimensions.\nKEY_COUNT_RANGE = (2, 4)\nTARGET_COUNT_RANGE = (1, 5)\nKEY_ROW_FIRST = 1\nKEY_ROW_STEP = 2\nKEY_COLUMN = 1\nTALLY_COL_STEP = 2\nLEGEND_HEIGHT_TAIL = 1\nLEGEND_WIDTH_TAIL = 1\nLEGEND_SLACK_RANGE = (0, 3)\n\n# Canvas size and legend placement bounds.\nGRID_HEIGHT_RANGE = (20, 25)\nGRID_WIDTH_RANGE = (20, 25)\nLEGEND_EDGE_MARGIN = 2\n\n# Sprite shape and placement constraints.\nSPRITE_AREA_RANGE = (4, 7)\nSPRITE_BBOXES = ((2, 2), (2, 3), (3, 2), (3, 3))\nSPRITE_CONNECTIVITY = 8\nSPRITE_PADDING = 1\nSPRITE_PADDING_CONNECTIVITY = 8\n\n# Retry budget for rejection sampling.\nGENERATION_ATTEMPTS = 300\n\n\ndef _randint(bounds: tuple[int, int]) -> int:\n    \"\"\"Return an inclusive randint from a configured (low, high) pair.\"\"\"\n    return random.randint(bounds[0], bounds[1])\n\n\n@lru_cache(maxsize=None)\ndef _valid_masks(h: int, w: int, area: int) -> tuple[np.ndarray, ...]:\n    \"\"\"Return connected masks that span all four sides of the sprite bbox.\"\"\"\n    masks = []\n    for cells in combinations(range(h * w), area):\n        mask = np.zeros((h, w), dtype=bool)\n        for cell in cells:\n            mask[cell // w, cell % w] = True\n        spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()\n        if not spans_edges:\n            continue\n        _, n = label_mask(mask, connectivity=SPRITE_CONNECTIVITY)\n        if n == 1:\n            masks.append(mask)\n    return tuple(masks)\n\n\ndef _make_sprite(color: int, bg: int) -> np.ndarray:\n    \"\"\"Sample one connected same-color sprite drawn on the background color.\"\"\"\n    area = _randint(SPRITE_AREA_RANGE)\n    dims = []\n    for h, w in SPRITE_BBOXES:\n        if h * w >= area and _valid_masks(h, w, area):\n            dims.append((h, w))\n    h, w = random.choice(dims)\n    mask = random.choice(_valid_masks(h, w, area))\n    sprite = np.full((h, w), int(bg), dtype=int)\n    sprite[mask] = int(color)\n    return sprite\n\n\ndef _sample_palette() -> tuple[int, list[int], int | None]:\n    \"\"\"Choose background, key colors, and optional distractor color.\"\"\"\n    colors = list(COLOR_POOL)\n    bg = random.choice(colors)\n\n    k = _randint(KEY_COUNT_RANGE)\n    remaining = [c for c in colors if c != bg]\n    key_colors = random.sample(remaining, k)\n    remaining = [c for c in remaining if c not in key_colors]\n    distractor_color = random.choice(remaining) if remaining and random.random() < DISTRACTOR_PROB else None\n    return bg, key_colors, distractor_color\n\n\ndef _sample_counts(k: int) -> list[int]:\n    \"\"\"Sample the target outside-component count for each key color.\"\"\"\n    return [_randint(TARGET_COUNT_RANGE) for _ in range(k)]\n\n\ndef _legend_shape(k: int, max_count: int) -> tuple[int, int]:\n    \"\"\"Return legend height and width for the key count and largest tally.\"\"\"\n    bh = KEY_ROW_STEP * k + LEGEND_HEIGHT_TAIL\n    bw = TALLY_COL_STEP * max_count + LEGEND_WIDTH_TAIL + _randint(LEGEND_SLACK_RANGE)\n    return bh, bw\n\n\ndef _key_row(i: int) -> int:\n    \"\"\"Map a zero-based key index to its row inside the legend/output box.\"\"\"\n    return KEY_ROW_FIRST + KEY_ROW_STEP * i\n\n\ndef _build_expected(key_colors: list[int], counts: list[int]) -> np.ndarray:\n    \"\"\"Render the black output tally canvas implied by key colors and counts.\"\"\"\n    max_count = max(counts)\n    bh, bw = _legend_shape(len(key_colors), max_count)\n\n    expected = np.full((bh, bw), BLACK, dtype=int)\n    for i, (color, count) in enumerate(zip(key_colors, counts)):\n        rr = _key_row(i)\n        for j in range(count):\n            expected[rr, KEY_COLUMN + TALLY_COL_STEP * j] = int(color)\n    return expected\n\n\ndef _build_legend(shape: tuple[int, int], key_colors: list[int]) -> np.ndarray:\n    \"\"\"Return a black legend patch with only the key-column pixels filled.\"\"\"\n    legend = np.full(shape, BLACK, dtype=int)\n    for i, color in enumerate(key_colors):\n        legend[_key_row(i), KEY_COLUMN] = int(color)\n    return legend\n\n\ndef _new_grid_with_legend(bg: int, legend: np.ndarray) -> np.ndarray | None:\n    \"\"\"Sample a grid and paste the legend away from all canvas edges.\"\"\"\n    bh, bw = map(int, legend.shape)\n    H = _randint(GRID_HEIGHT_RANGE)\n    W = _randint(GRID_WIDTH_RANGE)\n    min_h = bh + 2 * LEGEND_EDGE_MARGIN\n    min_w = bw + 2 * LEGEND_EDGE_MARGIN\n    if H < min_h or W < min_w:\n        return None\n\n    grid = np.full((H, W), int(bg), dtype=int)\n    r0 = random.randint(LEGEND_EDGE_MARGIN, H - bh - LEGEND_EDGE_MARGIN)\n    c0 = random.randint(LEGEND_EDGE_MARGIN, W - bw - LEGEND_EDGE_MARGIN)\n    paste(grid, legend, r0, c0)\n    return grid\n\n\ndef _build_sprite_queue(\n    key_colors: list[int],\n    counts: list[int],\n    distractor_color: int | None,\n    bg: int,\n) -> list[np.ndarray]:\n    \"\"\"Create canonical key sprites, optional distractor sprite, and shuffle them.\"\"\"\n    sprites = []\n    for color, count in zip(key_colors, counts):\n        sprite = _make_sprite(color, bg)\n        for _ in range(count):\n            sprites.append(sprite.copy())\n    if distractor_color is not None:\n        sprites.append(_make_sprite(distractor_color, bg))\n    random.shuffle(sprites)\n    return sprites\n\n\ndef _place_sprites(grid: np.ndarray, sprites: list[np.ndarray], bg: int) -> None:\n    \"\"\"Paste sprites into random non-touching free locations in queue order.\"\"\"\n    for sprite in sprites:\n        sr, sc = random_free_location(\n            grid,\n            sprite,\n            transparent=bg,\n            padding=SPRITE_PADDING,\n            padding_connectivity=SPRITE_PADDING_CONNECTIVITY,\n        )\n","exit_code":0,"status":"completed"}}
