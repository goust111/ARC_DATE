{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r: int, c: int, size: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < size and 0 <= cc < size:\n            yield rr, cc\n\n\ndef _gen_partition(total: int, parts: int) -> list[int]:\n    sizes = [1] * parts\n    for _ in range(total - parts):\n        sizes[random.randrange(parts)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n    size = int(labels.shape[0])\n    for rr, cc in _gen_neighbors4(r, c, size):\n        if labels[rr, cc] not in (0, label):\n            return False\n    return True\n\n\ndef _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n    pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n    component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))\n    labels = np.zeros((size, size), dtype=int)\n    for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):\n        seed_candidates = [\n            (r, c)\n            for r in range(size)\n            for c in range(size)\n            if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)\n        ]\n        if not seed_candidates:\n            return None\n\n        seed = random.choice(seed_candidates)\n        labels[seed] = label\n        cells = [seed]\n        while len(cells) < component_size:\n            growth = []\n            for r, c in cells:\n                for rr, cc in _gen_neighbors4(r, c, size):\n                    if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):\n                        growth.append((rr, cc))\n            if not growth:\n                return None\n            cell = random.choice(growth)\n            labels[cell] = label\n            cells.append(cell)\n\n    tile = np.full((size, size), bg, dtype=int)\n    tile[labels > 0] = sprite_color\n    tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.fliplr(tile)\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.flipud(tile)\n    return tile.copy()\n\n\ndef _gen_tile_origin(tile_r: int, tile_c: int, tile_size: int) -> tuple[int, int]:\n    return tile_r * (tile_size + SEPARATOR_WIDTH), tile_c * (tile_size + SEPARATOR_WIDTH)\n\n\ndef _gen_base_grid(tile_rows: int, tile_cols: int, tile_size: int, bg: int, separator: int) -> np.ndarray:\n    height = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH\n    width = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH\n    grid = np.full((height, width), bg, dtype=int)\n    grid[tile_size :: tile_size + SEPARATOR_WIDTH, :] = separator\n    grid[:, tile_size :: tile_size + SEPARATOR_WIDTH] = separator\n    return grid\n\n\ndef _gen_paste_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_size: int) -> None:\n    r0, c0 = _gen_tile_origin(pos[0], pos[1], tile_size)\n    paste(grid, tile, r0, c0)\n\n\ndef _gen_render_pair(tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions):\n    expected = _gen_base_grid(tile_rows, tile_cols, tile_size, bg, separator)\n    for pos in [source_pos, *marked_positions]:\n        _gen_paste_tile(expected, pos, sprite_tile, tile_size)\n\n    inp = expected.copy()\n    marker_tile = np.full((tile_size, tile_size), bg, dtype=int)\n    marker_tile[tile_size // 2, tile_size // 2] = separator\n    for pos in marked_positions:\n        _gen_paste_tile(inp, pos, marker_tile, tile_size)\n    return inp, expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    separator, bg, sprite_color = random.sample(COLOR_POOL, PALETTE_SIZE)\n    tile_rows, tile_cols, tile_size = (\n        random.randint(*TILE_ROWS_RANGE),\n        random.randint(*TILE_COLS_RANGE),\n        random.choice(TILE_SIZE_CHOICES),\n    )\n\n    sprite_tile = _gen_sprite_tile(tile_size, bg, sprite_color)\n    if sprite_tile is None:\n        return None\n\n    tile_positions = [(r, c) for r in range(tile_rows) for c in range(tile_cols)]\n    source_pos = random.choice(tile_positions)\n    marker_count = random.randint(*MARKER_COUNT_RANGE)\n    marked_positions = random.sample([pos for pos in tile_positions if pos != source_pos], marker_count)\n    inp, expected = _gen_render_pair(\n        tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions\n    )\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n    inp = _gen_transform(inp, orientation)\n    out = _gen_transform(out, orientation)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\ndef _legend(src: int, tgt: int) -> np.ndarray:\n    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n    return np.array(\n        [[src, src, tgt, tgt],\n         [src, src, src, tgt],\n         [src, src, tgt, tgt]], dtype=int)\n\n\ndef _sprite_mask(n: int) -> np.ndarray:\n    \"\"\"Generate a random NxN binary mask with fill ratio in [SPRITE_FILL_MIN, SPRITE_FILL_MAX].\"\"\"\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\n    target = random.randint(lo, hi)\n\n    # Seed: random walk column + one full row, then random orientation\n    mask = np.zeros((n, n), dtype=bool)\n    c = random.randrange(n)\n    for r in range(n):\n        c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\n        mask[r, c] = True\n    mask[random.randrange(n), :] = True\n\n    if random.random() < 0.5:\n        mask = mask.T.copy()\n    if random.random() < 0.5:\n        mask = np.flipud(mask)\n    if random.random() < 0.5:\n        mask = np.fliplr(mask)\n\n    # Grow to target fill by adding random frontier cells\n    while int(mask.sum()) < target:\n        dilated = np.zeros_like(mask)\n        dilated[1:, :] |= mask[:-1, :]\n        dilated[:-1, :] |= mask[1:, :]\n        dilated[:, 1:] |= mask[:, :-1]\n        dilated[:, :-1] |= mask[:, 1:]\n        frontier = list(zip(*np.where(dilated & ~mask)))\n        r, c = random.choice(frontier)\n        mask[r, c] = True\n    return mask\n\n\ndef _colored_sprite(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    \"\"\"Render a binary mask as a colored sprite on bg.\"\"\"\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = int(color)\n    return out\n\n\ndef _content_extent(n: int, grid_rows: int, grid_cols: int) -> tuple[int, int]:\n    \"\"\"Content area needed for grid_rows x grid_cols of NxN blocks with 1-cell gaps.\"\"\"\n    return (grid_rows * n + grid_rows - 1, grid_cols * n + grid_cols - 1)\n\n\ndef _choose_structure() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Pick (n, rows, cols, empty_count, total) satisfying frame size constraints.\"\"\"\n    total = random.randint(*TOTAL_BLOCKS_RANGE)\n    options = []\n    for n in range(*SPRITE_N_RANGE):\n        for rows in range(*GRID_ROWS_RANGE):\n            for cols in range(*GRID_COLS_RANGE):\n                ch, cw = _content_extent(n, rows, cols)\n                base_fh = ch + 4  # +2 border +2 min margin\n                base_fw = cw + 4\n                slots = rows * cols\n                empty = slots - total\n                if base_fh <= MAX_FRAME_DIM and base_fw <= MAX_FRAME_DIM and 0 <= empty <= MAX_EMPTY_SLOTS:\n                    options.append((n, rows, cols, empty, total))\n    return random.choice(options) if options else None\n\n\ndef _choose_empty_slots(\n    rows: int, cols: int, empty_count: int\n) -> tuple[set[tuple[int, int]], list[tuple[int, int]]]:\n    \"\"\"Choose which grid slots are empty, ensuring every row and column has at least one filled slot.\n\n    Returns (empty_slots, shuffled filled_slots).\n    \"\"\"\n    slots = [(r, c) for r in range(rows) for c in range(cols)]\n    valid = []\n    for combo in itertools.combinations(slots, empty_count):\n        empty = set(combo)\n        filled = [s for s in slots if s not in empty]\n        if len({r for r, _ in filled}) == rows and len({c for _, c in filled}) == cols:\n            valid.append(empty)\n    empty_slots = random.choice(valid)\n    filled_slots = [s for s in slots if s not in empty_slots]\n    random.shuffle(filled_slots)\n    return empty_slots, filled_slots\n\n\ndef _make_bordered_frame(h: int, w: int, bg: int) -> np.ndarray:\n    \"\"\"Create an h x w frame filled with bg and a 1-cell FRAME_COL border.\"\"\"\n    frame = np.full((h, w), bg, dtype=int)\n    frame[0, :] = frame[-1, :] = FRAME_COL\n    frame[:, 0] = frame[:, -1] = FRAME_COL\n    return frame\n\n\ndef _place_patch(\n    grid: np.ndarray, reserve: np.ndarray, patch: np.ndarray, bg: int,\n    *, transparent: bool,\n) -> bool:\n    \"\"\"Find a free location for patch and paste it onto grid/reserve. Returns success.\"\"\"\n    blocker = np.full(patch.shape, FRAME_COL, dtype=int)\n    try:\n        r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\n    except ValueError:\n        return False\n    paste(reserve, blocker, r, c)\n    paste(grid, patch, r, c, transparent=bg if transparent else None)\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    # --- structure ---\n    struct = _choose_structure()\n    if struct is None:\n        return None\n    n, rows, cols, empty_count, _ = struct\n\n    bg = random.choice([c for c in range(10) if c != FRAME_COL])\n    usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\n\n    # --- colors ---\n    k = random.randint(*NUM_COLORS_RANGE)\n    src_cols = random.sample(usable, k)\n    tgt_cols = [random.choice([c for c in usable if c != src]) for src in src_cols]\n    color_to_tgt = dict(zip(src_cols, tgt_cols))\n    masks = {src: _sprite_mask(n) for src in src_cols}\n\n    # --- frame dimensions & margins ---\n    ch, cw = _content_extent(n, rows, cols)\n    min_fh = max(MIN_FRAME_H, ch + 4)\n    min_fw = max(MIN_FRAME_W, cw + 4)\n    frame_h = random.randint(min_fh, min(MAX_FRAME_DIM, max(min_fh, ch + 2 + FRAME_MARGIN_SLACK)))\n    frame_w = random.randint(min_fw, min(MAX_FRAME_DIM, max(min_fw, cw + 2 + FRAME_MARGIN_SLACK)))\n    y_margin = frame_h - 2 - ch\n    x_margin = frame_w - 2 - cw\n    top_margin = random.randint(1, y_margin - 1)\n    left_margin = random.randint(1, x_margin - 1)\n\n    # --- slot assignment ---\n    _, filled_slots = _choose_empty_slots(rows, cols, empty_count)\n    cell_colors = {}\n    for slot, col in zip(filled_slots[:k], src_cols):\n        cell_colors[slot] = col\n    for slot in filled_slots[k:]:\n        cell_colors[slot] = random.choice(src_cols)\n\n    # --- build input & output frames ---\n    input_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    output_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    for (rr, cc), src in cell_colors.items():\n        r0 = 1 + top_margin + rr * (n + 1)\n        c0 = 1 + left_margin + cc * (n + 1)\n        paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)\n        paste(output_frame, _colored_sprite(masks[src], color_to_tgt[src], bg), r0, c0, transparent=bg)\n\n    # --- canvas selection & frame placement ---\n    ext_area = k * (12 + n * n + 10)\n    possible_dims = [\n        (h, w)\n        for h in range(*CANVAS_H_RANGE)\n        for w in range(*CANVAS_W_RANGE)\n        if h >= frame_h and w >= frame_w and h * w - frame_h * frame_w >= ext_area\n    ]\n    if not possible_dims:\n        return None\n    h, w = random.choice(possible_dims)\n    grid = np.full((h, w), bg, dtype=int)\n    reserve = np.full((h, w), bg, dtype=int)\n\n    fr0 = random.choice([0, h - frame_h])\n    fc0 = random.choice([0, w - frame_w])\n    if h - frame_h > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fr0 = random.randrange(0, h - frame_h + 1)\n    if w - frame_w > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fc0 = random.randrange(0, w - frame_w + 1)\n    paste(grid, input_frame, fr0, fc0)\n    paste(reserve, np.full((frame_h, frame_w), FRAME_COL, dtype=int), fr0, fc0)\n\n    # --- place external patches (sprites + legends) ---\n    patches: list[tuple[np.ndarray, bool]] = []\n    for src, tgt in zip(src_cols, tgt_cols):\n        patches.append((_colored_sprite(masks[src], src, bg), True))\n        patches.append((_legend(src, tgt), False))\n    random.shuffle(patches)\n    patches.sort(key=lambda item: item[0].size, reverse=True)\n    for patch, transparent in patches:\n        if not _place_patch(grid, reserve, patch, bg, transparent=transparent):\n            return None\n\n    # --- oracle check ---\n    try:\n        if not np.array_equal(main(grid), output_frame):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n\n    # Union-find to merge adjacent cells by removing internal wall segments\n    parent = list(range(total_cells))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        px, py = find(x), find(y)\n        if px == py:\n            return False\n        parent[px] = py\n        return True\n\n    def cell_id(cr, cc):\n        return cr * (n_vcols - 1) + cc\n\n    # Enumerate internal wall segments (between adjacent cells)\n    internal_segments = []\n    for hi in range(1, n_hrows - 1):\n        r = hrow_positions[hi]\n        for ci in range(n_vcols - 1):\n            c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]\n            internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))\n    for ci in range(1, n_vcols - 1):\n        c = vcol_positions[ci]\n        for hi in range(n_hrows - 1):\n            r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]\n            internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))\n\n    random.shuffle(internal_segments)\n    merged = 0\n    for seg in internal_segments:\n        if merged >= cells_to_merge:\n            break\n        if seg[0] == 'h':\n            _, r, c0, c1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r, c0 + 1:c1] = False\n                merged += 1\n        else:\n            _, c, r0, r1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r0 + 1:r1, c] = False\n                merged += 1\n\n    if merged < cells_to_merge:\n        return None\n    if _count_enclosed_regions(walls) != target_rooms:\n        return None\n    return walls\n\n\ndef _force_overlap(positions, i, j, frames, grid_h, grid_w):\n    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n    fi_h, fi_w = frames[i][2].shape\n    fj_h, fj_w = frames[j][2].shape\n    ri, ci = positions[i]\n    r0_min = max(0, ri - fj_h + 2)\n    r0_max = min(grid_h - fj_h, ri + fi_h - 2)\n    c0_min = max(0, ci - fj_w + 2)\n    c0_max = min(grid_w - fj_w, ci + fi_w - 2)\n    if r0_min > r0_max or c0_min > c0_max:\n        return\n    for _ in range(_OVERLAP_RETRY):\n        rj = random.randint(r0_min, r0_max)\n        cj = random.randint(c0_min, c0_max)\n        # Verify bbox overlap\n        if (max(ri, rj) <= min(ri + fi_h - 1, rj + fj_h - 1) and\n                max(ci, cj) <= min(ci + fi_w - 1, cj + fj_w - 1)):\n            positions[j] = (rj, cj)\n            return\n\n\ndef _render_frames(frames, positions, render_order, grid_h, grid_w):\n    \"\"\"Render frame walls onto grid; return grid and set of visible frame pixel coords.\"\"\"\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    # Paint walls in render order (later overwrites earlier at overlaps)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        # Vectorized: find wall pixel offsets and stamp color\n        rs, cs = np.where(wall_arr)\n        grid[rs + r0, cs + c0] = color\n\n    # Compute visible frame pixels (where grid still shows that frame's color)\n    frame_mask = np.zeros((grid_h, grid_w), dtype=bool)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        rs, cs = np.where(wall_arr)\n        abs_rs, abs_cs = rs + r0, cs + c0\n        visible = grid[abs_rs, abs_cs] == color\n        frame_mask[abs_rs[visible], abs_cs[visible]] = True\n\n    return grid, frame_mask\n\n\ndef _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w):\n    \"\"\"Place noise pixels on non-wall cells and damage some wall cells.\"\"\"\n    total_cells = grid_h * grid_w\n    noise_fraction = random.uniform(*_NOISE_FRACTION_RANGE)\n    noise_count = int(total_cells * noise_fraction)\n\n    # Non-wall positions\n    nonwall_rs, nonwall_cs = np.where(~frame_mask)\n    perm = np.random.permutation(len(nonwall_rs))\n    n_nonwall = min(noise_count, len(perm))\n    sel = perm[:n_nonwall]\n    grid[nonwall_rs[sel], nonwall_cs[sel]] = noise_color\n    placed = n_nonwall\n\n    # Wall damage (up to _WALL_DAMAGE_FRACTION of wall pixels)\n    wall_rs, wall_cs = np.where(frame_mask)\n    n_wall = len(wall_rs)\n    max_damage = min(noise_count - placed, int(_WALL_DAMAGE_FRACTION * n_wall))\n    if max_damage > 0:\n        damage_perm = np.random.permutation(n_wall)[:max_damage]\n        grid[wall_rs[damage_perm], wall_cs[damage_perm]] = noise_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid puzzle grid.\"\"\"\n    frame_count = random.randint(*_FRAME_COUNT_RANGE)\n\n    # --- Room count assignment ---\n    available = list(range(_ROOM_COUNT_RANGE[0], _ROOM_COUNT_RANGE[1] + 1))\n    allow_tie = random.random() < _TIE_PROBABILITY and frame_count >= 3\n    if allow_tie:\n        distinct_needed = frame_count - 1\n        chosen = random.sample(available, min(distinct_needed, len(available)))\n        if len(chosen) < distinct_needed:\n            return None\n        room_counts = chosen + [random.choice(chosen)]\n    else:\n        if frame_count > len(available):\n            return None\n        room_counts = random.sample(available, frame_count)\n    random.shuffle(room_counts)\n\n    # --- Color assignment ---\n    chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)\n    frame_colors = chosen_colors[:frame_count]\n    noise_color = chosen_colors[frame_count]\n\n    # --- Grid/frame size selection ---\n    cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])\n    h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg\n    grid_h = random.randint(h_min, h_max)\n    grid_w = random.randint(w_min, w_max)\n\n    # --- Build frames ---\n    frames = []\n    for color, target_rooms in zip(frame_colors, room_counts):\n        frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n        if frame_data is None:\n            return None\n        fh, fw = frame_data.shape\n        if fh > grid_h - 2 or fw > grid_w - 2:\n            return None\n        frames.append((color, target_rooms, frame_data))\n\n    # --- Place frames (largest first, random position) ---\n    positions = [None] * frame_count\n    for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):\n        fh, fw = frames[idx][2].shape\n        positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))\n\n    # --- Force overlaps for tied pairs ---\n    tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                  if room_counts[i] == room_counts[j]]\n    for i, j in tied_pairs:\n        _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Force some non-tied overlaps ---\n    non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                if room_counts[i] != room_counts[j]]\n    n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)\n    if n_extra > 0 and non_tied:\n        random.shuffle(non_tied)\n        for i, j in non_tied[:min(n_extra, len(non_tied))]:\n            _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Render and add noise ---\n    render_order = list(range(frame_count))\n    random.shuffle(render_order)\n\n    grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)\n    _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)\n\n    # --- Validate via solver oracle ---\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output: rows sorted by (room_count, render_order position)\n    frame_info = sorted(\n        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])\n    max_rooms = max(rc for rc, _, _ in frame_info)\n    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)\n    for r, (rc, _, color) in enumerate(frame_info):\n        expected[r, :rc] = color\n\n    return grid if np.array_equal(output, expected) else None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n        fr0, fc0, fr1, fc1 = frame_bb\n        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]\n        frame_mask0 = (frame != 0) & (frame != 6)\n        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))\n        assert n8 == 1, f\"frame must be 8-connected, got {n8} components\"\n\n        # Rotate layout according to clockhand.\n        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3\n        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)\n\n        # Build composite by tiling the unit sprite into active frame cells.\n        m_unit = (unit_sprite != 0) & (unit_sprite != 6)\n        uh, uw = unit_sprite.shape\n        fh, fw = frame_mask.shape\n        comp = np.zeros((fh * uh, fw * uw), dtype=int)\n        for i in range(fh):\n            for j in range(fw):\n                if not frame_mask[i, j]:\n                    continue\n                rr0 = i * uh\n                cc0 = j * uw\n                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]\n\n        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)\n        if pos is None:\n            continue\n        pr, pc = pos\n\n        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])\n        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])\n\n        ch, cw = comp.shape\n        for r in range(ch):\n            rr = top + r\n            assert 0 <= rr < out.shape[0], \"sprite row out of canvas bounds\"\n            for c in range(cw):\n                cc = left + c\n                assert 0 <= cc < out.shape[1], \"sprite col out of canvas bounds\"\n                if out[rr, cc] == 6:\n                    continue\n                val = int(comp[r, c])\n                if val != 0 and val != 6:\n                    assert not composite_written[rr, cc], \"composites must not overlap\"\n                    composite_written[rr, cc] = True\n                    out[rr, cc] = val\n    return out\n\n# --------------- generator (refine_8conn_fill_overlap) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────\nGRID_H_RANGE = (20, 30)         # output grid height\nGRID_W = 30                     # output grid width (fixed)\nLEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]\nUNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length\nMIN_CANVAS_W = 8                # reject if canvas narrower than this\nFRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)\nFRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)\nFRAME_DENSITY = 0.5             # density for random_sprite frame generation\nBAND_WIDTH_MIN = 4              # minimum band width for canvas background\nMARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)\nUSABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)\nROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets\nGEN_RETRIES = 300               # max attempts in generate_input\n\n\ndef _allocate_colors(num_legends):\n    \"\"\"Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend.\"\"\"\n    pool = list(USABLE_COLORS)\n    random.shuffle(pool)\n\n    unit_color_sets = []\n    used_unit = set()\n    for _ in range(num_legends):\n        if len(pool) < 2:\n            return None\n        c1, c2 = pool.pop(), pool.pop()\n        unit_color_sets.append((c1, c2))\n        used_unit.update([c1, c2])\n\n    bg_cands = [c for c in pool if c not in used_unit]\n    if len(bg_cands) < 2:\n        return None\n    random.shuffle(bg_cands)\n    bg_colors = (bg_cands[0], bg_cands[1])\n\n    frame_colors = []\n    all_set = set(USABLE_COLORS)\n    for uc in unit_color_sets:\n        candidates = list(all_set - set(uc))\n        frame_colors.append(random.choice(candidates))\n\n    return unit_color_sets, bg_colors, frame_colors\n\n\ndef _color_swap(sprite, c1, c2):\n    \"\"\"Return a copy of sprite with the two colors swapped.\"\"\"\n    sa, sb = sorted([c1, c2])\n    out = sprite.copy()\n    out[sprite == sa] = sb\n    out[sprite == sb] = sa\n    return out\n\n\ndef _design_legend(leg, unit_colors, frame_color, marker_r0, grid_h, canvas_w):\n    \"\"\"Fill in sprite, frame, and rotation for one legend dict. Returns False on failure.\"\"\"\n    N = leg[\"N\"]\n    uc1, uc2 = unit_colors\n\n    # Unit sprite: NxN, fully filled, exactly 2 colors\n    sprite = np.full((N, N), uc1, dtype=int)\n    num_c2 = random.randint(1, N * N - 1)\n    for p in random.sample(range(N * N), num_c2):\n        sprite[p // N, p % N] = uc2\n\n    legend_sprite = _color_swap(sprite, uc1, uc2)\n\n    avail = marker_r0 - (N + 1)\n    # Enumerate valid (frame_H, frame_W, rot_k) combos\n    combos = []\n    for fH in range(*FRAME_H_RANGE):\n        if avail < fH + 1:\n            continue\n        for fW in range(*FRAME_W_RANGE):\n            for rk in range(4):\n                rh, rw = (fH, fW) if rk % 2 == 0 else (fW, fH)\n                if rh * N <= grid_h and rw * N <= canvas_w:\n                    combos.append((fH, fW, rk))\n    if not combos:\n        return False\n    frame_H, frame_W, rot_k = random.choice(combos)\n\n    frame_mask = random_sprite(\n        frame_H, frame_W, density=FRAME_DENSITY, connectivity=8,\n        color_palette=[1], symmetry=\"not_symmetric\"\n    ) != 0\n    rot_frame = np.rot90(frame_mask, (-rot_k) % 4)\n\n    leg.update(sprite=sprite, legend_sprite=legend_sprite, frame_mask=frame_mask,\n               frame_H=frame_H, frame_W=frame_W, frame_color=frame_color,\n               rot_k=rot_k, rotated_frame=rot_frame)\n    return True\n\n\ndef _comp_size(leg):\n    \"\"\"Return (height, width) of the composite after rotation.\"\"\"\n    rf = leg[\"rotated_frame\"]\n    N = leg[\"N\"]\n    return rf.shape[0] * N, rf.shape[1] * N\n\n\ndef _assign_anchors(legends, grid_h, canvas_w):\n    \"\"\"Assign anchor positions to legends, avoiding overlap for 2-legend case. Returns False on failure.\"\"\"\n    if len(legends) == 1:\n        pr, pc = random.randint(0, 2), random.randint(0, 2)\n        ch, cw = _comp_size(legends[0])\n        legends[0].update(pr=pr, pc=pc,\n                          comp_top=_anchor_to_top_left(pr, grid_h, ch),\n                          comp_left=_anchor_to_top_left(pc, canvas_w, cw))\n        return True\n\n    a, b = legends[0], legends[1]\n    a_ch, a_cw = _comp_size(a)\n    b_ch, b_cw = _comp_size(b)\n    valid_pairs = []\n    for apr in range(3):\n        for apc in range(3):\n            at = _anchor_to_top_left(apr, grid_h, a_ch)\n            al = _anchor_to_top_left(apc, canvas_w, a_cw)\n            if at < 0 or al < 0 or at + a_ch > grid_h or al + a_cw > canvas_w:\n                continue\n            for bpr in range(3):\n                for bpc in range(3):\n                    bt = _anchor_to_top_left(bpr, grid_h, b_ch)\n                    bl = _anchor_to_top_left(bpc, canvas_w, b_cw)\n                    if bt < 0 or bl < 0 or bt + b_ch > grid_h or bl + b_cw > canvas_w:\n                        continue\n                    # Reject overlapping bounding boxes\n                    if at < bt + b_ch and bt < at + a_ch and al < bl + b_cw and bl < al + a_cw:\n                        continue\n                    valid_pairs.append((apr, apc, at, al, bpr, bpc, bt, bl))\n    if not valid_pairs:\n        return False\n    apr, apc, at, al, bpr, bpc, bt, bl = random.choice(valid_pairs)\n    a.update(pr=apr, pc=apc, comp_top=at, comp_left=al)\n    b.update(pr=bpr, pc=bpc, comp_top=bt, comp_left=bl)\n    return True\n\n\ndef _build_banded_canvas(grid_h, canvas_w, bg1, bg2):\n    \"\"\"Build a canvas with alternating horizontal or vertical color bands.\"\"\"\n    canvas = np.zeros((grid_h, canvas_w), dtype=int)\n    band_dir = random.choice([\"h\", \"v\"])\n    dim = grid_h if band_dir == \"h\" else canvas_w\n    bw = random.randint(BAND_WIDTH_MIN, max(BAND_WIDTH_MIN, dim // 2))\n    band_indices = np.arange(dim) // bw % 2\n    colors = np.array([bg1, bg2])\n    if band_dir == \"h\":\n        canvas[:] = colors[band_indices][:, None]\n    else:\n        canvas[:] = colors[band_indices][None, :]\n    return canvas\n\n\ndef _overlay_composites(canvas, legends):\n    \"\"\"Stamp each legend's tiled composite onto the canvas (non-{0,6} pixels overwrite).\"\"\"\n    output = canvas.copy()\n    for leg in legends:\n        sp, rf = leg[\"sprite\"], leg[\"rotated_frame\"]\n        N = leg[\"N\"]\n        t, l = leg[\"comp_top\"], leg[\"comp_left\"]\n        fh, fw = rf.shape\n\n        # Build full composite by tiling the unit sprite into active frame cells\n        comp = np.zeros((fh * N, fw * N), dtype=int)\n        sprite_mask = (sp != 0) & (sp != 6)\n        for i in range(fh):\n            for j in range(fw):\n                if rf[i, j]:\n                    r0, c0 = i * N, j * N\n                    comp[r0:r0 + N, c0:c0 + N][sprite_mask] = sp[sprite_mask]\n\n        # Overwrite canvas where composite has content and canvas isn't color 6\n        region = output[t:t + fh * N, l:l + fw * N]\n        write_mask = (comp != 0) & (region != 6)\n        region[write_mask] = comp[write_mask]\n    return output\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    grid_h = random.randint(*GRID_H_RANGE)\n    num_legends = random.choices([1, 2], weights=LEGEND_COUNT_WEIGHTS)[0]\n\n    # Per legend: pick N, compute legend_w\n    legends = []\n    for _ in range(num_legends):\n        N = random.randint(*UNIT_SIZE_RANGE)\n        legends.append({\"N\": N, \"legend_w\": N + 2})\n\n    # Layout widths\n    left_lw = legends[0][\"legend_w\"]\n    left_total = left_lw + 1  # legend + 1 separator col\n    right_total = (1 + legends[1][\"legend_w\"]) if num_legends == 2 else 0\n    canvas_w = GRID_W - left_total - right_total\n    if canvas_w < MIN_CANVAS_W:\n        return None\n\n    # Color allocation\n    colors = _allocate_colors(num_legends)\n    if colors is None:\n        return None\n    unit_color_sets, (bg1, bg2), frame_colors = colors\n\n    marker_r0 = grid_h - MARKER_PANEL_HEIGHT\n\n    # Design each legend panel\n    for li in range(num_legends):\n        if not _design_legend(legends[li], unit_color_sets[li], frame_colors[li],\n                              marker_r0, grid_h, canvas_w):\n            return None\n\n    # Assign anchor positions\n    if not _assign_anchors(legends, grid_h, canvas_w):\n        return None\n\n    # Build canvas and overlay composites\n    canvas = _build_banded_canvas(grid_h, canvas_w, bg1, bg2)\n    output = _overlay_composites(canvas, legends)\n\n    # Assemble input grid\n    grid = np.zeros((grid_h, GRID_W), dtype=int)\n    canvas_c0 = left_total\n    grid[:, canvas_c0:canvas_c0 + canvas_w] = canvas\n\n    _place_legend(grid, legends[0], col_start=0, sep_col=left_lw,\n                  marker_r0=marker_r0, is_right=False)\n    if num_legends == 2:\n        r_sep = canvas_c0 + canvas_w\n        _place_legend(grid, legends[1], col_start=r_sep + 1, sep_col=r_sep,\n                      marker_r0=marker_r0, is_right=True)\n\n    # Validate via solver\n    try:\n        if np.array_equal(main(grid), output):\n            return grid\n    except Exception:\n        pass\n    return None\n\n\ndef _place_legend(grid, leg, col_start, sep_col, marker_r0, is_right):\n    \"\"\"Draw one legend panel (separator, marker square, rotation patch, sprite, frame).\"\"\"\n    N = leg[\"N\"]\n    grid[:, sep_col] = 6\n\n    # Marker square column: sprite at col_start+1 must fit within the 5-wide panel\n    mc0 = (col_start + max(0, N - 4)) if not is_right else (sep_col + max(0, N - 3))\n\n    # 5x5 border-6 marker square\n    grid[marker_r0:marker_r0 + 5, mc0:mc0 + 5] = 0\n    grid[marker_r0, mc0:mc0 + 5] = 6\n    grid[marker_r0 + 4, mc0:mc0 + 5] = 6\n    grid[marker_r0:marker_r0 + 5, mc0] = 6\n    grid[marker_r0:marker_r0 + 5, mc0 + 4] = 6\n    grid[marker_r0 + 1 + leg[\"pr\"], mc0 + 1 + leg[\"pc\"]] = 4\n\n    # Rotation patch: 3x5 block with 6-borders on cols 0,4 and 3x3 clock-hand inside\n    rr0 = marker_r0 + 5\n    grid[rr0:rr0 + 3, mc0:mc0 + 5] = 0\n    grid[rr0:rr0 + 3, mc0] = 6\n    grid[rr0:rr0 + 3, mc0 + 4] = 6\n    cx_r, cx_c = rr0 + 1, mc0 + 2\n    dr, dc = ROTATION_DIRS[leg[\"rot_k\"]]\n    grid[cx_r, cx_c] = 7\n    grid[cx_r + dr, cx_c + dc] = 7\n\n    # Unit sprite at row 1\n    sp_col = col_start + 1 - mc0\n    grid[1:1 + N, mc0 + sp_col:mc0 + sp_col + N] = leg[\"legend_sprite\"]\n\n    # Frame mask between unit sprite bottom and marker top\n    fH, fW = leg[\"frame_H\"], leg[\"frame_W\"]\n    avail = marker_r0 - (N + 1)\n    gap = random.randint(1, max(1, avail - fH))\n    fr_start = N + 1 + gap\n    f_col = random.randint(0, max(0, 4 - fW))\n    frame_region = grid[fr_start:fr_start + fH, mc0 + f_col:mc0 + f_col + fW]\n    frame_region[leg[\"frame_mask\"]] = leg[\"frame_color\"]\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\ndef _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:\n    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n        # The contact edge doesn't have to span the full height. It's the N-2 contiguous\n        # cells on the attachment side. For \"left-attach\", the solver checks the RIGHT edge\n        # of the cropped sprite: exactly e contiguous filled cells.\n\n        # Build each row from right to left. Rightmost col is the contact column.\n        # For flipud symmetry, row[i] mirrors row[h-1-i].\n        # Decide top half, mirror to bottom.\n\n        for ri in range(half_h):\n            mirror_ri = h - 1 - ri\n            for ci in range(w):\n                if ci == w - 1:\n                    # Contact column: fill rows that form the contiguous e-block\n                    # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.\n                    # Instead: just decide freely and check later\n                    val = rng.random() < 0.5\n                else:\n                    val = rng.random() < 0.5\n                grid[ri, ci] = val\n                grid[mirror_ri, ci] = val\n\n        # Check: rightmost column has exactly e contiguous filled cells\n        right_col = grid[:, -1]\n        # Find contiguous runs\n        runs = []\n        count = 0\n        for v in right_col:\n            if v:\n                count += 1\n            else:\n                if count > 0:\n                    runs.append(count)\n                count = 0\n        if count > 0:\n            runs.append(count)\n        if len(runs) != 1 or runs[0] != e:\n            continue\n\n        # Trim empty rows/cols\n        rows_any = grid.any(axis=1)\n        cols_any = grid.any(axis=0)\n        if not rows_any.any():\n            continue\n        r0, r1 = np.where(rows_any)[0][[0, -1]]\n        c0, c1 = np.where(cols_any)[0][[0, -1]]\n        grid = grid[r0:r1+1, c0:c1+1]\n\n        if grid.shape[0] < 2 or grid.shape[1] < 2:\n            continue\n\n        # Check flipud symmetry\n        if not np.array_equal(grid, np.flipud(grid)):\n            continue\n\n        # Check 8-connectivity\n        labeled, num = _label(grid, structure=np.ones((3, 3), dtype=int))\n        if num != 1:\n            continue\n\n        # Must NOT be fliplr symmetric (to avoid the other side matching)\n        if np.array_equal(grid, np.fliplr(grid)):\n            continue\n\n        # Pixel count 4-12\n        px = int(grid.sum())\n        if px < 4 or px > 12:\n            continue\n\n        # Now verify exactly 1 valid attachment across all 4 rotations x 4 sides.\n        # The solver, for each side, tries rot90 x 0-3 and checks:\n        #   - correct symmetry (fliplr for top/bot, flipud for left/right)\n        #   - contact edge = e contiguous cells on the correct side\n        # We need exactly 1 such (rotation, side) pair across all possibilities.\n        # Actually, the solver matches by color, so each sprite is only tested against\n        # one side. But we need: for ANY side the solver might try, only 1 rotation works.\n        # Since the solver already picks the first valid rotation, we just need that\n        # for the intended side, exactly 1 rotation of the sprite is valid.\n\n        # Check: for the canonical \"left\" side, how many rotations are valid?\n        valid_for_left = 0\n        for k in range(4):\n            rot = np.rot90(grid, k)\n            # Trim\n            ra = rot.any(axis=1)\n            ca = rot.any(axis=0)\n            rr0, rr1 = np.where(ra)[0][[0, -1]]\n            cc0, cc1 = np.where(ca)[0][[0, -1]]\n            cr = rot[rr0:rr1+1, cc0:cc1+1]\n            # Left side needs flipud + right-edge = e contiguous\n            if not np.array_equal(cr, np.flipud(cr)):\n                continue\n            rc = cr[:, -1]\n            runs2 = []\n            cnt2 = 0\n            for v in rc:\n                if v: cnt2 += 1\n                else:\n                    if cnt2 > 0: runs2.append(cnt2)\n                    cnt2 = 0\n            if cnt2 > 0: runs2.append(cnt2)\n            if len(runs2) == 1 and runs2[0] == e:\n                valid_for_left += 1\n\n        if valid_for_left != 1:\n            continue\n\n        # Success! Now rotate to target side.\n        # grid is in \"left-attach\" frame (contact on right, flipud symmetric).\n        # left -> as-is\n        # right -> fliplr (contact moves to left side)\n        # top -> rot90 CW (contact moves to bottom)\n        # bot -> rot90 CCW (contact moves to top)\n        if side == \"left\":\n            mask = grid.copy()\n        elif side == \"right\":\n            mask = np.fliplr(grid)\n        elif side == \"top\":\n            mask = np.rot90(grid, -1)  # CW: right->bottom\n        else:  # bot\n            mask = np.rot90(grid, 1)   # CCW: right->top\n        return mask\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = random.Random()\n    bg = 8\n    N = 4\n    edge_len = N - 2  # = 2\n\n    H = rng.randint(18, 26)\n    W = rng.randint(20, 26)\n\n    # Choose 4 distinct non-bg colors for hub edges\n    all_colors = [c for c in range(10) if c != bg]\n    rng.shuffle(all_colors)\n    top_col, bot_col, left_col, right_col = all_colors[:4]\n\n    sides = [\"top\", \"bot\", \"left\", \"right\"]\n    side_colors = {\"top\": top_col, \"bot\": bot_col, \"left\": left_col, \"right\": right_col}\n\n    # Choose K sides (2-4) to get sprites\n    K = rng.randint(2, 4)\n    sprite_sides = rng.sample(sides, K)\n\n    # Generate sprite masks for each chosen side\n    sprite_masks = {}\n    for side in sprite_sides:\n        mask = _make_sprite_mask(edge_len, side, rng)\n        if mask is None:\n            return None\n        sprite_masks[side] = mask\n\n    # Compute max sprite extent to ensure enough margin for hub placement\n    max_sprite_h = max(m.shape[0] for m in sprite_masks.values())\n    max_sprite_w = max(m.shape[1] for m in sprite_masks.values())\n    max_extent = max(max_sprite_h, max_sprite_w)\n    margin = max_extent + 2\n\n    # Place hub near center with margin\n    hub_r_min = margin\n    hub_r_max = H - N - margin\n    hub_c_min = margin\n    hub_c_max = W - N - margin\n    if hub_r_min > hub_r_max or hub_c_min > hub_c_max:\n        return None\n\n    hub_r = rng.randint(hub_r_min, hub_r_max)\n    hub_c = rng.randint(hub_c_min, hub_c_max)\n\n    # Build output grid\n    out = np.full((H, W), bg, dtype=int)\n\n    # Place hub\n    # Top edge\n    for ci in range(1, N - 1):\n        out[hub_r, hub_c + ci] = top_col\n    # Bottom edge\n    for ci in range(1, N - 1):\n        out[hub_r + N - 1, hub_c + ci] = bot_col\n    # Left edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c] = left_col\n    # Right edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c + N - 1] = right_col\n\n    # Attach sprites to hub in output\n    attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords\n    for side in sprite_sides:\n        mask = sprite_masks[side]\n        sh, sw = mask.shape\n        color = side_colors[side]\n        arr = np.where(mask, color, bg).astype(int)\n\n        # Compute placement so sprite's contact edge is flush with hub side.\n        # The solver's segs dict defines: for each side, the contact position and span.\n        #   top -> sprite's bot row at hub_r-1, cols hub_c+1..hub_c+N-2\n        #   bot -> sprite's top row at hub_r+N, cols hub_c+1..hub_c+N-2\n        #   left -> sprite's right col at hub_c-1, rows hub_r+1..hub_r+N-2\n        #   right -> sprite's left col at hub_c+N, rows hub_r+1..hub_r+N-2\n        if side == \"top\":\n            # Find first filled col on bottom row of sprite\n            filled = np.where(mask[-1])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r - sh  # bottom row of sprite at row hub_r-1\n        elif side == \"bot\":\n            filled = np.where(mask[0])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r + N  # top row of sprite at row hub_r+N\n        elif side == \"left\":\n            filled = np.where(mask[:, -1])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c - sw  # right col of sprite at col hub_c-1\n        else:  # right\n            filled = np.where(mask[:, 0])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c + N  # left col of sprite at col hub_c+N\n\n        # Check bounds\n        if sr < 0 or sc < 0 or sr + sh > H or sc + sw > W:\n            return None\n\n        # Check no overlap with existing content\n        for r in range(sh):\n            for c in range(sw):\n                if mask[r, c] and out[sr + r, sc + c] != bg:\n                    return None\n\n        paste(out, arr, sr, sc, transparent=bg)\n        attached_sprites[side] = (arr, mask, sr, sc)\n\n    # Verify output is correct by running solver later (via oracle check)\n\n    # Build input: hub + scattered sprites in random rotations + optional distractor\n    inp = np.full((H, W), bg, dtype=int)\n    # Place hub on input\n    inp[hub_r:hub_r+N, hub_c:hub_c+N] = out[hub_r:hub_r+N, hub_c:hub_c+N]\n\n    # Canvas for placement tracking\n    canvas = inp.copy()\n\n    for side in sprite_sides:\n        arr, mask, sr, sc = attached_sprites[side]\n        # Apply a random non-identity rotation\n        # But we need to ensure the solver will find the right rotation\n        # The solver uses 8-connectivity labeling and picks the largest component of matching color\n        # Apply a random rotation (1-3 quarter turns, avoiding identity)\n        k = rng.choice([1, 2, 3])\n        rotated_arr = np.rot90(arr, k)\n        rotated_mask = np.rot90(mask, k)\n\n        # Crop to bounding box of the mask\n        rows_any = rotated_mask.any(axis=1)\n        cols_any = rotated_mask.any(axis=0)\n        r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]\n        c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]\n        cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        patch = np.where(cropped_mask, cropped_arr, bg).astype(int)\n\n        try:\n            pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(canvas, patch, pr, pc, transparent=bg)\n        paste(inp, patch, pr, pc, transparent=bg)\n\n    # Optionally add a distractor (0 or 1)\n    if rng.random() < 0.3:\n        used_colors = set(side_colors.values())\n        distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]\n        if distractor_colors:\n            dcol = rng.choice(distractor_colors)\n            # Make a small distractor sprite\n            dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)\n            if dist_mask is not None:\n                dist_arr = np.where(dist_mask, dcol, bg).astype(int)\n                try:\n                    pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)\n                    paste(canvas, dist_arr, pr, pc, transparent=bg)\n                    paste(inp, dist_arr, pr, pc, transparent=bg)\n                except ValueError:\n                    pass  # skip distractor if no room\n\n    # Oracle check\n    result = main(inp)\n    if not np.array_equal(result, out):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
