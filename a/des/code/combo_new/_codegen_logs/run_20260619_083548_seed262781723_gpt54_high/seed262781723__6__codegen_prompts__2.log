{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '230,620p' /home/lixinyu/snap/a/des/code/combo_new/seed262781723/6/2.py\"","aggregated_output":"    - Treat each component as a rotatable fragment and try all 0/90/180/270 degree orientations.\n    - Place the counter-rotated fragments on one shared canvas so they are pairwise disjoint and form a single connected template.\n    - Tight-crop the completed template, rotate it to its canonical binary-mask orientation, and keep every fragment's original color.\n\n    Key insight:\n    - The objects are not translated cutouts from one layout; they are differently rotated partial masks that must be jointly oriented before they can be overlaid into the full picture.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _get_bg(g)\n    pieces = _find_components(g, bg)\n    assert 3 <= len(pieces) <= 4\n\n    for piece in pieces:\n        piece[\"orient_coords\"] = [_mask_coords(variant) for variant in _rotation_variants(piece[\"mask\"])]\n        assert piece[\"orient_coords\"]\n\n    return _solve_unique_output(pieces, bg)\n\n\nMIN_PIECES = 3\nMAX_PIECES = 4\nMIN_PIECE_AREA = 3\nTEMPLATE_H_RANGE = (4, 7)\nTEMPLATE_W_RANGE = (4, 7)\nTEMPLATE_AREA_MAX = 18\nGRID_SIDE_MIN = 13\nGRID_SIDE_MAX = 22\nPLACEMENT_PADDING = 1\nTEMPLATE_ATTEMPTS = 200\nPARTITION_ATTEMPTS = 200\nGEN_ATTEMPTS = 400\n\n\ndef _cells_to_mask(cells: set[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in cells:\n        mask[r, c] = True\n    return mask\n\n\ndef _is_connected_cells(cells: set[tuple[int, int]]) -> bool:\n    if not cells:\n        return False\n    start = next(iter(cells))\n    queue = deque([start])\n    seen = {start}\n    while queue:\n        r, c = queue.popleft()\n        for nr, nc in _neighbors4(r, c):\n            if (nr, nc) in cells and (nr, nc) not in seen:\n                seen.add((nr, nc))\n                queue.append((nr, nc))\n    return len(seen) == len(cells)\n\n\ndef _has_hole(mask: np.ndarray) -> bool:\n    h, w = map(int, mask.shape)\n    empty = ~mask\n    seen = np.zeros_like(empty, dtype=bool)\n    queue = deque()\n\n    for r in range(h):\n        for c in (0, w - 1):\n            if empty[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                queue.append((r, c))\n    for c in range(w):\n        for r in (0, h - 1):\n            if empty[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                queue.append((r, c))\n\n    while queue:\n        r, c = queue.popleft()\n        for nr, nc in _neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and empty[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                queue.append((nr, nc))\n\n    return bool((empty & ~seen).any())\n\n\ndef _random_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:\n    r, c = start\n    er, ec = end\n    path = [(r, c)]\n    while (r, c) != (er, ec):\n        steps = []\n        if r < er:\n            steps.append((r + 1, c))\n        elif r > er:\n            steps.append((r - 1, c))\n        if c < ec:\n            steps.append((r, c + 1))\n        elif c > ec:\n            steps.append((r, c - 1))\n        r, c = random.choice(steps)\n        path.append((r, c))\n    return path\n\n\ndef _rotation_count(mask: np.ndarray) -> int:\n    return len(_rotation_variants(mask))\n\n\ndef _make_template(piece_count: int) -> np.ndarray | None:\n    for _ in range(TEMPLATE_ATTEMPTS):\n        h = random.randint(*TEMPLATE_H_RANGE)\n        w = random.randint(*TEMPLATE_W_RANGE)\n        min_area = max(MIN_PIECE_AREA * piece_count, 10)\n        max_area = min(TEMPLATE_AREA_MAX, h * w - 1)\n        if min_area > max_area:\n            continue\n\n        top = (0, random.randrange(w))\n        bottom = (h - 1, random.randrange(w))\n        cells = set(_random_path(top, bottom))\n\n        left = (random.randrange(h), 0)\n        cells.update(_random_path(left, random.choice(tuple(cells))))\n\n        right = (random.randrange(h), w - 1)\n        cells.update(_random_path(right, random.choice(tuple(cells))))\n\n        if len(cells) > max_area:\n            continue\n\n        target_area = random.randint(max(min_area, len(cells)), max_area)\n        while len(cells) < target_area:\n            frontier = []\n            for r, c in cells:\n                for nr, nc in _neighbors4(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:\n                        frontier.append((nr, nc))\n            if not frontier:\n                break\n            cells.add(random.choice(frontier))\n\n        if len(cells) != target_area:\n            continue\n\n        mask = _cells_to_mask(cells, (h, w))\n        if _has_hole(mask):\n            continue\n        if _rotation_count(mask) != 4:\n            continue\n        return mask\n\n    return None\n\n\ndef _sample_piece_sizes(total_area: int, piece_count: int) -> list[int]:\n    sizes = [MIN_PIECE_AREA] * piece_count\n    for _ in range(total_area - MIN_PIECE_AREA * piece_count):\n        sizes[random.randrange(piece_count)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _grow_connected_subset(cells: set[tuple[int, int]], size: int) -> set[tuple[int, int]] | None:\n    seed = random.choice(tuple(cells))\n    subset = {seed}\n    frontier = {nbr for nbr in _neighbors4(*seed) if nbr in cells}\n\n    while len(subset) < size and frontier:\n        frontier_list = list(frontier)\n        frontier_list.sort(\n            key=lambda cell: sum(nbr in cells and nbr not in subset for nbr in _neighbors4(*cell)),\n            reverse=True,\n        )\n        pick = random.choice(frontier_list[: min(4, len(frontier_list))])\n        subset.add(pick)\n        frontier.discard(pick)\n        for nbr in _neighbors4(*pick):\n            if nbr in cells and nbr not in subset:\n                frontier.add(nbr)\n\n    return subset if len(subset) == size else None\n\n\ndef _partition_cells(cells: set[tuple[int, int]], sizes: list[int]) -> list[set[tuple[int, int]]] | None:\n    if len(sizes) == 1:\n        return [set(cells)] if len(cells) == sizes[0] and _is_connected_cells(cells) else None\n\n    size = sizes[0]\n    for _ in range(PARTITION_ATTEMPTS):\n        subset = _grow_connected_subset(cells, size)\n        if subset is None:\n            continue\n        remainder = cells - subset\n        if not _is_connected_cells(remainder):\n            continue\n        rest = _partition_cells(remainder, sizes[1:])\n        if rest is not None:\n            return [subset] + rest\n    return None\n\n\ndef _partition_template(mask: np.ndarray, piece_count: int) -> list[np.ndarray] | None:\n    cells = {tuple(map(int, cell)) for cell in np.argwhere(mask)}\n    sizes = sorted(_sample_piece_sizes(len(cells), piece_count))\n\n    for _ in range(PARTITION_ATTEMPTS):\n        regions = _partition_cells(cells, sizes)\n        if regions is None:\n            continue\n\n        masks = []\n        ok = True\n        for region in regions:\n            region_mask = _crop_mask(_cells_to_mask(region, mask.shape))\n            if _rotation_count(region_mask) < 2:\n                ok = False\n                break\n            masks.append(region_mask)\n        if ok:\n            random.shuffle(masks)\n            return masks\n    return None\n\n\ndef _paint_piece_masks(template_mask: np.ndarray, region_masks: list[np.ndarray], colors: list[int]) -> np.ndarray | None:\n    remaining = template_mask.copy()\n    output = np.zeros(template_mask.shape, dtype=int)\n\n    for mask, color in zip(region_masks, colors):\n        placed = False\n        for r0 in range(template_mask.shape[0] - mask.shape[0] + 1):\n            for c0 in range(template_mask.shape[1] - mask.shape[1] + 1):\n                window = remaining[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]\n                if np.array_equal(mask & remaining[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]], mask):\n                    outside = mask & ~template_mask[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]\n                    if outside.any():\n                        continue\n                    output[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color\n                    remaining[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = False\n                    placed = True\n                    break\n            if placed:\n                break\n        if not placed:\n            return None\n\n    return output if not remaining.any() else None\n\n\ndef _region_masks_from_partition(template_mask: np.ndarray, piece_count: int) -> list[np.ndarray] | None:\n    cells = {tuple(map(int, cell)) for cell in np.argwhere(template_mask)}\n    sizes = sorted(_sample_piece_sizes(len(cells), piece_count))\n\n    for _ in range(PARTITION_ATTEMPTS):\n        regions = _partition_cells(cells, sizes)\n        if regions is None:\n            continue\n\n        masks = []\n        for region in regions:\n            region_mask = np.zeros(template_mask.shape, dtype=bool)\n            for r, c in region:\n                region_mask[r, c] = True\n            if not _is_connected_cells(region):\n                break\n            cropped = _crop_mask(region_mask)\n            if _rotation_count(cropped) < 2:\n                break\n            masks.append(region_mask)\n        else:\n            return masks\n    return None\n\n\ndef _build_output(piece_count: int) -> np.ndarray | None:\n    template_mask = _make_template(piece_count)\n    if template_mask is None:\n        return None\n\n    regions = _region_masks_from_partition(template_mask, piece_count)\n    if regions is None:\n        return None\n\n    colors = random.sample(range(1, 10), piece_count)\n    patch = np.zeros(template_mask.shape, dtype=int)\n    for color, region in zip(colors, regions):\n        patch[region] = color\n\n    return _canonicalize_patch(patch, BG)\n\n\ndef _extract_color_fragments(output: np.ndarray) -> list[tuple[int, np.ndarray]]:\n    fragments = []\n    for color in sorted(int(v) for v in np.unique(output) if int(v) != BG):\n        mask = output == color\n        fragments.append((color, _crop_mask(mask)))\n    return fragments\n\n\ndef _choose_rotations(piece_count: int) -> list[int]:\n    return random.sample(range(4), piece_count)\n\n\ndef _place_fragments(fragments: list[tuple[int, np.ndarray]]) -> np.ndarray | None:\n    total_box_area = sum(mask.shape[0] * mask.shape[1] for _, mask in fragments)\n    base = max(GRID_SIDE_MIN, int(np.ceil(np.sqrt(total_box_area))) + 5)\n    h = random.randint(base, min(GRID_SIDE_MAX, base + 4))\n    w = random.randint(base, min(GRID_SIDE_MAX, base + 4))\n    grid = np.zeros((h, w), dtype=int)\n    reserved = np.zeros((h, w), dtype=bool)\n\n    order = list(range(len(fragments)))\n    order.sort(key=lambda idx: fragments[idx][1].shape[0] * fragments[idx][1].shape[1], reverse=True)\n\n    for idx in order:\n        color, mask = fragments[idx]\n        ph, pw = map(int, mask.shape)\n        choices = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]\n        random.shuffle(choices)\n        placed = False\n        for r0, c0 in choices:\n            rr0 = max(0, r0 - PLACEMENT_PADDING)\n            cc0 = max(0, c0 - PLACEMENT_PADDING)\n            rr1 = min(h, r0 + ph + PLACEMENT_PADDING)\n            cc1 = min(w, c0 + pw + PLACEMENT_PADDING)\n            if reserved[rr0:rr1, cc0:cc1].any():\n                continue\n            grid[r0 : r0 + ph, c0 : c0 + pw][mask] = color\n            reserved[r0:r0 + ph, c0:c0 + pw] = True\n            placed = True\n            break\n        if not placed:\n            return None\n\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    piece_count = random.choice([MIN_PIECES, MAX_PIECES])\n    output = _build_output(piece_count)\n    if output is None:\n        return None\n\n    fragments = _extract_color_fragments(output)\n    rotations = _choose_rotations(piece_count)\n    if len(set(rotations)) < 2 or all(rotation == 0 for rotation in rotations):\n        return None\n\n    rotated = []\n    for (color, mask), rotation in zip(fragments, rotations):\n        rotated.append((color, np.rot90(mask, rotation).astype(bool)))\n\n    grid = _place_fragments(rotated)\n    if grid is None:\n        return None\n\n    try:\n        solved = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(solved, output):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid sample\")\n","exit_code":0,"status":"completed"}}
