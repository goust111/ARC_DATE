{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/80a900e0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend diagonal rays outward from outer-border segments adjacent to diamond shapes on a checkerboard.\n\n    Input structure:\n    - Checkerboard bg (two most common colors).\n    - Hollow diamond outlines (8-pixel) in a non-bg color (inner border).\n    - Short diagonal line segments in another non-bg color adjacent to each diamond edge (outer border).\n\n    Rule:\n    - For each outer-border segment, determine the outward direction (perpendicular to the segment, away from the diamond).\n    - From each endpoint of the segment, cast a diagonal ray outward, painting over bg pixels with the segment's color until hitting a non-bg pixel or the grid edge.\n\n    Key insight: Rays emit only from the two endpoints of each outer-border segment, not every pixel, and travel diagonally away from the diamond.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # The checkerboard background uses the two most frequent colors (typically 0 and 1).\n    bg_colors = set(_top_k_colors(g, 2))\n\n    # Find diamond inner borders (size-8 diamond components) in non-background colors.\n    non_bg = set(int(v) for v in np.unique(g)) - bg_colors\n    comps = _components8_by_color(g, non_bg)\n    diamonds: list[tuple[int, list[tuple[int, int]]]] = [(col, pts) for col, pts in comps if _is_diamond8(pts)]\n\n    out = g.copy()\n\n    # Process diamonds in stable order (top-left by bbox).\n    def bbox_key(item):\n        _, pts = item\n        return _bbox(pts)\n\n    for _, dpts in sorted(diamonds, key=bbox_key):\n        dset = set(dpts)\n\n        # Collect all adjacent non-bg (non checkerboard) pixels that are not part of the diamond.\n        adj = []\n        for r, c in dpts:\n            for rr, cc in neighbors8(r, c):\n                if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dset:\n                    v = int(g[rr, cc])\n                    if v not in bg_colors:\n                        adj.append((rr, cc))\n\n        if not adj:\n            continue\n\n        # Build mask for these adjacent pixels and extract their 8-connected components.\n        adj_mask = np.zeros((h, w), dtype=bool)\n        for r, c in adj:\n            adj_mask[r, c] = True\n        outer_comps = _cc8(adj_mask)\n\n        for oc in outer_comps:\n            ocol = int(g[oc[0][0], oc[0][1]])\n            info = _outer_line_info(oc)\n            if info is None:\n                continue\n            slope_key, endpoints = info\n\n            if slope_key == \"rc_diff\":\n                # line direction along (1,1); candidate normals are (-1,1) and (1,-1)\n                normals = [(-1, 1), (1, -1)]\n            else:\n                # line direction along (1,-1); candidate normals are (-1,-1) and (1,1)\n                normals = [(-1, -1), (1, 1)]\n\n            # Choose inward normal by best overlap with diamond when shifting outer by that normal.\n            best_n = None\n            best_score = -1\n            for n in normals:\n                sc = sum(((r + n[0], c + n[1]) in dset) for r, c in oc)\n                if sc > best_score:\n                    best_score = sc\n                    best_n = n\n            if best_n is None or best_score <= 0:\n                continue\n            outward = (-best_n[0], -best_n[1])\n\n            # Endpoints (two extremes along the diagonal line).\n            p0 = endpoints[0]\n            p1 = endpoints[-1]\n            for pr, pc in (p0, p1):\n                rr, cc = pr + outward[0], pc + outward[1]\n                while 0 <= rr < h and 0 <= cc < w:\n                    if int(out[rr, cc]) in bg_colors:\n                        out[rr, cc] = ocol\n                    else:\n                        break\n                    rr += outward[0]\n                    cc += outward[1]\n\n    return out\n\n# --------------- generator (Codex attempt 2) ---------------\n\n# ── Tunable parameters ──────────────────────────────────────\nGRID_H_RANGE = (20, 24)         # canvas height bounds\nGRID_W_RANGE = (14, 30)         # canvas width bounds\nDIAMOND_COUNT_RANGE = (1, 3)    # number of diamonds per grid\nEDGES_PER_DIAMOND = (2, 4)      # outer-segment edges per diamond\nMIN_SEGMENT_LEN = 2             # minimum visible segment pixels (after boundary clip)\nCOLOR_RANGE = range(2, 10)      # non-background color palette\nMAX_GEN_RETRIES = 300           # retry budget for generate_input\n\n# ── Geometry constants ──────────────────────────────────────\n_DIAMOND_COORDS = (\n    (0, 2), (1, 1), (1, 3),\n    (2, 0), (2, 4),\n    (3, 1), (3, 3), (4, 2),\n)\n\n_EDGE_INFO = {\n    \"TR\": {\"segment\": ((-1, 3), (0, 4), (1, 5)), \"outward\": (-1, 1), \"slope\": \"diff\"},\n    \"TL\": {\"segment\": ((-1, 1), (0, 0), (1, -1)), \"outward\": (-1, -1), \"slope\": \"sum\"},\n    \"BL\": {\"segment\": ((3, -1), (4, 0), (5, 1)), \"outward\": (1, -1), \"slope\": \"diff\"},\n    \"BR\": {\"segment\": ((3, 5), (4, 4), (5, 3)), \"outward\": (1, 1), \"slope\": \"sum\"},\n}\n_EDGE_NAMES = tuple(_EDGE_INFO)\n\n\ndef _checkerboard(h: int, w: int) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '/def main(/,/\"'^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/689c358e.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Mark each arrow-like sprite's pointed frame endpoint with its color and the opposite endpoint black.\n\n    Input structure:\n    - The grid has a one-pixel solid rectangular frame around a dominant interior background.\n    - Inside the frame are monochrome six-pixel sprites shaped as asymmetric T arrows.\n    - Each sprite has a length-4 bar and a length-3 crossbar one cell closer to the pointed end.\n\n    Rule:\n    - For each sprite, follow its bar axis from the shorter end to the frame.\n    - Paint that frame endpoint with the sprite color.\n    - Paint the opposite endpoint on the same row or column black.\n    - Leave the interior background, sprites, and all other frame pixels unchanged.\n\n    Key insight:\n    - The direction is encoded by the crossbar's off-center position: the nearer end is the pointing end.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    frame = _solid_frame_color(g)\n    bg = int(get_bg(g[1:-1, 1:-1]))\n    assert bg != frame, \"interior background must differ from the frame\"\n\n    sprite_colors = colors_present(g, exclude={bg, frame})\n    assert sprite_colors, \"expected at least one sprite\"\n    assert Color.BLACK not in set(sprite_colors) | {bg, frame}, \"black is reserved for opposite endpoints\"\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=sprite_colors)\n    assert len(components) == len(sprite_colors), \"expected one 4-connected object per sprite color\"\n\n    assignments: dict[tuple[int, int], int] = {}\n    for component in components:\n        assert int(component[\"area\"]) == 6, \"each sprite must have six pixels\"\n        color = int(component[\"color\"])\n        pointed, opposite = _sprite_endpoints(g, component[\"coords\"])\n\n        for coord, value in ((pointed, color), (opposite, Color.BLACK)):\n            assert int(g[coord]) == frame, \"sprite endpoints must land on frame pixels\"\n            assert coord not in assignments, \"frame endpoint assignments must not overlap\"\n            assignments[coord] = int(value)\n\n    out = g.copy()\n    for (r, c), value in assignments.items():\n        out[r, c] = value\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and fixed colors.\nGRID_SIZE, FRAME_COLOR, BACKGROUND_COLOR = 11, 6, 7\nLAST = GRID_SIZE - 1\n\n# Sprite sampling and shape.\nSPRITE_COUNT, SPRITE_COLORS = 4, [1, 2, 3, 4, 5, 8, 9]\nORIENTATIONS, DIRECTIONS = (\"H\", \"V\"), {\"H\": (\"left\", \"right\"), \"V\": (\"up\", \"down\")}\nBAR_LENGTH, CROSSBAR_LENGTH = 4, 3\nCROSSBAR_MID, NEAR_END_OFFSET, FAR_END_OFFSET = 1, 1, 2\nTRANSPARENT = -1\n\n# Interior placement and retry bounds.\nAXIS_LINES, MAX_GENERATION_ATTEMPTS = range(2, 9), 300\nBAR_START_MIN, BAR_START_MAX = 1, 6\n\ndef _make_sprite(color: int, orientation: str, direction: str) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
