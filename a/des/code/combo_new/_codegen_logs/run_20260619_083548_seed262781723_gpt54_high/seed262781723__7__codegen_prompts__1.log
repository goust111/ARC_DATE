{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the colored runs from the left reference panel into the blank right panel.\n\n    Input structure:\n    - A uniform rectangular frame surrounds the grid.\n    - One full-height divider of the frame color splits a left reference panel\n      from a blank right panel.\n    - Both panels have one background margin column on each side of their active\n      columns; the left active columns contain two-column endpoint slots, possibly\n      connected by same-color horizontal runs.\n\n    Rule:\n    - Keep the original grid and paint only in the right panel's active columns.\n    - A source run exactly matching the left endpoint slot is copied to the left\n      two columns of the right active span.\n    - A source run exactly matching the right endpoint slot is copied to the right\n      two columns of the right active span.\n    - A source run connecting the endpoint slots is stretched across the entire\n      right active span.\n\n    Key insight:\n    The left panel is a compressed legend for the right panel: endpoint markers\n    stay two pixels wide, while connectors between endpoints expand to fill the\n    distance between them.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n\n    frame = int(g[0, 0])\n    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n\n    divider = _single_divider_column(g, frame)\n    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n\n    left_panel = g[1 : H - 1, 1:divider]\n    left_bg = get_bg(left_panel)\n    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n\n    mini_start = 2\n    mini_end = divider - 2\n    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n    left_slot = (mini_start, mini_start + 1)\n    right_slot = (mini_end - 1, mini_end)\n\n    target_start = divider + 2\n    target_end = W - 3\n    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n    right_bg = int(g[1, divider + 1])\n    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n\n    out = g.copy()\n    painted_any = False\n    for r in range(1, H - 1):\n        c = mini_start\n        while c <= mini_end:\n            color = int(g[r, c])\n            if color == left_bg:\n                c += 1\n                continue\n\n            c0 = c\n            while c <= mini_end and int(g[r, c]) == color:\n                c += 1\n            c1 = c - 1\n\n            in_left_slot = (c0, c1) == left_slot\n            in_right_slot = (c0, c1) == right_slot\n            if in_left_slot:\n                d0, d1 = target_start, target_start + 1\n            elif in_right_slot:\n                d0, d1 = target_end - 1, target_end\n            else:\n                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n                d0, d1 = target_start, target_end\n\n            assert np.all(out[r, d0 : d1 + 1] == right_bg), \"expanded runs must not collide\"\n            out[r, d0 : d1 + 1] = color\n            painted_any = True\n\n    assert painted_any, \"expected at least one colored source run\"\n    return out\n\n# --------------- generator (att2) ---------------\n# Color and retry controls.\nLEFT_BG = 1\nCOLOR_IDS = tuple(range(10))\nFRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)\nMAX_RUN_COLORS = 4\nGENERATION_RETRIES = 300\n\n# Canvas, group, and row layout bounds.\nLEFT_ACTIVE_WIDTHS = range(4, 7)\nRIGHT_ACTIVE_WIDTHS = range(11, 14)\nTOTAL_HEIGHTS = (11, 15)\nRIGHT_TO_LEFT_MIN_RATIO = 2\nFIXED_WIDTH_CELLS = 7\nNON_GROUP_ROWS = 4\nGROUP_COUNTS = (3, 5)\nGROUP_HEIGHT_BOUNDS = (1, 2)\nGAP_BOUNDS = (1, 2)\nFIRST_ACTIVE_ROW = 2\n\n# Run pattern geometry.\nRUN_WIDTH = 2\nLEFT_ACTIVE_START = 2\nRIGHT_TARGET_OFFSET = 2\nBASE_PATTERNS = (\"LEFT\", \"RIGHT\", \"FULL\")\nDOUBLE_PATTERN = \"LEFT_RIGHT\"\n\ndef _gen_sequences_with_sum(length: int, lo: int, hi: int, total: int) -> list[tuple[int, ...]]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\ndef _degree1_pixels(points):\n","exit_code":0,"status":"completed"}}
