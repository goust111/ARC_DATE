{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/1ae2feb7.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, paste\nfrom arc_utils import get_bg as _bg_color\n\ndef _find_sep_col(g, bg):\n    h, w = g.shape\n    for c in range(w):\n        col = g[:, c]\n        vals = col[col != bg]\n        if vals.size >= h - 1 and (vals == vals[0]).all():\n            return c, int(vals[0])\n    return None, None\n\ndef _iter_runs_1d(row, c_lo, c_hi, bg):\n    c = c_lo\n    while c < c_hi:\n        if row[c] == bg:\n            c += 1\n            continue\n        col = int(row[c])\n        c0 = c\n        while c < c_hi and row[c] == col:\n            c += 1\n        yield c0, c - 1, col\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extend row bars periodically across the opposite side of a separator column.\n\n    Input structure:\n    - bg = background. A near-solid vertical separator divides the grid into two sides.\n    - One side contains horizontal colored bars; the other side is blank target space.\n    - Bars may be stacked by row and may sit at different distances from the separator.\n\n    Rule:\n    - Identify the separator as the column whose non-bg cells are one color.\n    - Treat the denser side as the bar side and collect each contiguous row run.\n    - Process bars from nearest to farthest from the separator; for each bar, paint its\n      color every bar-length cells into the blank side without overwriting earlier paint.\n\n    Key insight: Each bar's length is the period for its extension, and nearer bars claim target cells first.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = _bg_color(g)\n\n    # Find the vertical separator column: a column whose non-bg cells are all the same color.\n    # (May not span full height; some rows can be bg.)\n    sep_col, _sep_color = _find_sep_col(g, bg)\n    if sep_col is None:\n        return g.copy()\n\n    out = g.copy()\n\n    # Decide which side contains the bars (the other side is the painting target).\n    left_mass = int(np.sum(g[:, :sep_col] != bg)) if sep_col > 0 else 0\n    right_mass = int(np.sum(g[:, sep_col + 1 :] != bg)) if sep_col + 1 < w else 0\n    bars_on_left = left_mass >= right_mass\n\n    bars = []\n    for r in range(h):\n        if bars_on_left:\n            for c0, c1, col in _iter_runs_1d(g[r, :], 0, sep_col, bg=bg):\n                length = c1 - c0 + 1\n                dist = (sep_col - 1) - c1  # 0 if bar touches left of separator\n                bars.append((dist, r, c0, c1, length, col))\n        else:\n            for c0, c1, col in _iter_runs_1d(g[r, :], sep_col + 1, w, bg=bg):\n                length = c1 - c0 + 1\n                dist = c0 - (sep_col + 1)  # 0 if bar touches right of separator\n                bars.append((dist, r, c0, c1, length, col))\n\n    # Process bars from closest to separator outward; do not overwrite.\n    bars.sort(key=lambda t: (t[0], t[1], t[2]))\n    for _, r, _c0, _c1, length, col in bars:\n        step = length\n        if step <= 0:\n            continue\n        if bars_on_left:\n            for cc in range(sep_col + 1, w, step):\n                if int(out[r, cc]) == bg:\n                    out[r, cc] = col\n        else:\n            for cc in range(sep_col - 1, -1, -step):\n                if int(out[r, cc]) == bg:\n                    out[r, cc] = col\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# Canvas size bounds (inclusive ranges).\nH_MIN, H_MAX = 8, 13\nW_MIN, W_MAX = 15, 20\n\n# Bar-side width bounds (clamped so ext_side stays in [EXT_SIDE_MIN, EXT_SIDE_MAX]).\nBAR_SIDE_MIN, BAR_SIDE_MAX = 3, 12\nEXT_SIDE_MIN, EXT_SIDE_MAX = 2, 14\n\n# Palette sizes.\nPALETTE_MIN, PALETTE_MAX = 5, 8\n\n# Active-row counts.\nACTIVE_MIN, ACTIVE_MAX = 2, 5\n\n# Per-row bar structure probabilities.\nP_TWO_BARS = 0.45        # probability a row has 2 adjacent bars instead of 1\nP_SEP_GAP = 0.15         # probability the nearest bar leaves a 1-cell gap to separator\nP_SWAP_COLORS = 0.5      # when 2 bars, probability to swap near/far colors\n\n# Separator gap (a single terminal-row cell omitted from separator column).\nP_SEP_COLUMN_GAP = 0.2\n\n# Retry budget for generation.\nMAX_ATTEMPTS = 300\n\n\ndef _choose_active_rows(rng: np.random.Generator, h: int, count: int) -> list[int]:\n    \"\"\"Pick `count` row indices in [0, h) with pairwise spacing >= 2.\"\"\"\n    base = np.sort(rng.choice(h - count + 1, size=count, replace=False))\n    return list(map(int, base + np.arange(count)))\n\n\ndef _sample_palette(rng: np.random.Generator) -> tuple[int, list[int]]:\n    \"\"\"Pick separator color and a disjoint bar-color palette.\"\"\"\n    sep_color = int(rng.integers(1, 10))\n    bar_pool = [c for c in range(1, 10) if c != sep_color]\n    size = int(rng.integers(PALETTE_MIN, min(PALETTE_MAX, len(bar_pool)) + 1))\n    palette = list(map(int, rng.choice(bar_pool, size=size, replace=False)))\n    return sep_color, palette\n\n\ndef _sample_row_bars(\n    rng: np.random.Generator,\n    palette: list[int],\n    primary: int,\n    bar_side_len: int,\n) -> tuple[list[tuple[int, int]], int]:\n    \"\"\"Return (bars, sep_gap) where bars is a list of (length, color) ordered near->far.\"\"\"\n    sep_gap = 1 if rng.random() < P_SEP_GAP else 0\n    capacity = bar_side_len - sep_gap\n    two_bars = rng.random() < P_TWO_BARS\n\n    if not two_bars:\n        length = int(rng.integers(1, capacity + 1))\n        return [(length, primary)], sep_gap\n\n    near_len = int(rng.integers(1, capacity))\n    far_len = int(rng.integers(1, capacity - near_len + 1))\n    others = [c for c in palette if c != primary]\n    colors = [primary, int(rng.choice(others))]\n    if rng.random() < P_SWAP_COLORS:\n        colors.reverse()\n    return [(near_len, colors[0]), (far_len, colors[1])], sep_gap\n\n\ndef _place_bars(\n    out: np.ndarray,\n    row: int,\n    sep_col: int,\n    bars_on_left: bool,\n    bars: list[tuple[int, int]],\n    sep_gap: int,\n) -> None:\n    \"\"\"Paint bars on the bar side, stacking from nearest-to-separator outward.\"\"\"\n    if bars_on_left:\n        cursor = sep_col - sep_gap\n        for length, color in bars:\n            out[row, cursor - length : cursor] = color\n            cursor -= length\n    else:\n        cursor = sep_col + 1 + sep_gap\n        for length, color in bars:\n            out[row, cursor : cursor + length] = color\n            cursor += length\n\n\ndef _paint_extension(\n    out: np.ndarray,\n    row: int,\n    sep_col: int,\n    bars_on_left: bool,\n    bars: list[tuple[int, int]],\n) -> None:\n    \"\"\"Simulate the periodic extension onto the ext side (nearest-first, no overwrite).\"\"\"\n    w = out.shape[1]\n    for length, color in bars:\n        if bars_on_left:\n            positions = range(sep_col + 1, w, length)\n        else:\n            positions = range(sep_col - 1, -1, -length)\n        for cc in positions:\n            if out[row, cc] == 0:\n                out[row, cc] = color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    h = int(rng.integers(H_MIN, H_MAX + 1))\n    w = int(rng.integers(W_MIN, W_MAX + 1))\n\n    # bar_side_len constrained so ext_side_len = w - 1 - bar_side_len is in [EXT_SIDE_MIN, EXT_SIDE_MAX].\n    lo = max(BAR_SIDE_MIN, w - 1 - EXT_SIDE_MAX)\n    hi = min(BAR_SIDE_MAX, w - 1 - EXT_SIDE_MIN)\n    if lo > hi:\n        return None\n    bar_side_len = int(rng.integers(lo, hi + 1))\n\n    bars_on_left = bool(rng.integers(0, 2) == 0)\n    sep_col = bar_side_len if bars_on_left else (w - 1 - bar_side_len)\n\n    sep_color, palette = _sample_palette(rng)\n\n    max_active = min(ACTIVE_MAX, (h + 1) // 2)\n    active_count = int(rng.integers(ACTIVE_MIN, max_active + 1))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        row_colors = set(map(int, g[r]))\n        if len(row_colors) == 1:\n            color = next(iter(row_colors))\n            if int(color) != int(bg):\n                rows.append((int(r), int(color)))\n    assert len(rows) == 1, \"expected exactly one solid non-background divider row\"\n    return rows[0]\n\n\ndef _unique_widest_row(coords: np.ndarray) -> int:\n    row_counts: list[tuple[int, int]] = []\n    for r in sorted(set(map(int, coords[:, 0]))):\n        row_cols = np.sort(coords[coords[:, 0] == r, 1])\n        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))\n        row_counts.append((int(row_cols.size), int(r)))\n\n    max_count = max(count for count, _r in row_counts)\n    widest = [r for count, r in row_counts if count == max_count]\n    assert max_count > 1, \"multi-column sprites must have a horizontal span\"\n    assert len(widest) == 1, \"expected a unique widest horizontal row\"\n    return int(widest[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/5961cc34.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import colors_present, components_mask, get_bg, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Build a red ray network by activating blue blobs via directional green ports.\n\n    Input structure:\n    - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.\n    - Start marker: yellow pixel atop a short red segment at grid bottom.\n\n    Rule:\n    - Extend a ray upward from start; on hitting a blue blob, recolor it red.\n    - Activated blobs emit thick rays through green ports until boundary or another blob.\n    - Cascade until no new blobs are reached.\n\n    Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- STEP 1) Detect the start \"port\" (red vertical segment with a non-red cap above) ---\n    start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []\n\n    for col in colors_present(g, exclude={bg}):\n        for coords in components_mask(g == int(col), connectivity=8):\n            if coords.size == 0:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n\n            # thin vertical segment, height>=2, touches bottom\n            if c0 != c1 or (r1 - r0 + 1) < 2:\n                continue\n            if r1 != int(H - 1):\n                continue\n            # solid vertical segment\n            if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):\n                continue\n            if int(r0) - 1 < 0:\n                continue\n            cap = int(g[int(r0) - 1, int(c0)])\n            if cap == int(bg) or cap == int(col):\n                continue\n\n            start_candidates.append(\n                (\n                    int(col),\n                    int(cap),\n                    int(c0),\n                    [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],\n                )\n            )\n\n    assert len(start_candidates) == 1\n    red_col, yellow_col, start_col, start_seg = start_candidates[0]\n\n    # --- STEP 2) Identify blob colors ---\n    # Blue = dominant remaining color by pixel count (excluding bg/start colors).\n    counts = Counter(map(int, g.flatten()))\n    other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]\n    assert other_cols\n    max_count = max(cnt for cnt, _col in other_cols)\n    blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]\n    assert len(blue_candidates) == 1\n    blue_col = int(blue_candidates[0])\n\n    # Green = the unique other color that is 4-adjacent to blue.\n    green_candidates: list[int] = []\n    for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):\n        pts = np.argwhere(g == int(col))\n        if pts.size == 0:\n            continue\n        ok = False\n        for r, c in pts:\n            r = int(r)\n            c = int(c)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + dr)\n                cc = int(c + dc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):\n                    ok = True\n                    break\n            if ok:\n                break\n        if ok:\n            green_candidates.append(int(col))\n\n    assert len(green_candidates) == 1\n    green_col = int(green_candidates[0])\n\n    out = np.full_like(g, int(bg))\n\n    # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---\n    blob_id = np.full((H, W), -1, dtype=int)\n    blobs: list[dict] = []\n\n    for coords in components_mask(g == int(blue_col), connectivity=8):\n        pts = [(int(r), int(c)) for r, c in coords]\n        bi = int(len(blobs))\n        for r, c in pts:\n            blob_id[int(r), int(c)] = bi\n        blobs.append({\"pts\": pts, \"ports\": []})\n\n    # --- STEP 4) For each blob, find its ports from adjacent green markers ---\n    for blob in blobs:\n        pts = blob[\"pts\"]\n        seen_dirs: set[tuple[int, int]] = set()\n        for r, c in pts:\n            for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                rr = int(r + ddr)\n                cc = int(c + ddc)\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):\n                    seen_dirs.add((int(ddr), int(ddc)))\n        for ddr, ddc in seen_dirs:\n            port_pixels = [\n                (int(r), int(c))\n                for (r, c) in pts\n                if 0 <= int(r + ddr) < H and 0 <= int(c + ddc) < W and int(g[int(r + ddr), int(c + ddc)]) == int(green_col)\n            ]\n            assert port_pixels\n            blob[\"ports\"].append({\"dir\": (int(ddr), int(ddc)), \"pixels\": port_pixels})\n\n    activated: set[int] = set()\n    queue: list[int] = []\n\n    def activate_blob_at(r: int, c: int) -> None:\n        \"\"\"Recolor a blob to red when first hit by a ray; enqueue it to emit its ports.\"\"\"\n        bi = int(blob_id[int(r), int(c)])\n        assert bi >= 0\n        if bi in activated:\n            return\n        activated.add(int(bi))\n        queue.append(int(bi))\n        for pr, pc in blobs[bi][\"pts\"]:\n            out[int(pr), int(pc)] = int(red_col)\n\n    # --- STEP 5) Draw the start ray upward (thin) and stop at the first blob hit ---\n    for r, c in start_seg:\n        out[int(r), int(c)] = int(red_col)\n    top_r = min(int(r) for r, _c in start_seg)\n    assert int(top_r) > 0 and int(g[int(top_r) - 1, int(start_col)]) == int(yellow_col)\n    out[int(top_r) - 1, int(start_col)] = int(red_col)\n    for r in range(int(top_r) - 1, -1, -1):\n        out[int(r), int(start_col)] = int(red_col)\n        if int(g[int(r), int(start_col)]) == int(blue_col):\n            activate_blob_at(int(r), int(start_col))\n            break\n\n    def extend_thick(port_pixels: list[tuple[int, int]], d: tuple[int, int]) -> None:\n        \"\"\"Extend a ray from each port pixel until boundary or blob hit.\"\"\"\n        ddr, ddc = map(int, d)\n        for pr, pc in port_pixels:\n            r, c = int(pr), int(pc)\n            while True:\n                r += int(ddr)\n                c += int(ddc)\n                if not (0 <= r < H and 0 <= c < W):\n                    break\n                out[int(r), int(c)] = int(red_col)\n                if int(g[int(r), int(c)]) == int(blue_col):\n                    activate_blob_at(int(r), int(c))\n                    break\n\n    # --- STEP 6) Propagate (BFS): activated blob -> emit rays -> activate more blobs ---\n    while queue:\n        bi = int(queue.pop(0))\n        for port in blobs[bi][\"ports\"]:\n            extend_thick(port[\"pixels\"], port[\"dir\"])\n\n    assert len(blobs) - len(activated) <= 1, \"at most 1 distractor blob\"\n\n    return out\n\n# --------------- generator (a2_cascade) ---------------\n\nfrom arc_utils import paint_coords\n\n# --- Colors ---\nBG = 8\nBLUE = 1\nRED = 2\nGREEN = 3\nYELLOW = 4\n\n# --- Directions ---\nUP = (-1, 0)\nDOWN = (1, 0)\nLEFT = (0, -1)\nRIGHT = (0, 1)\nDIRS = (UP, DOWN, LEFT, RIGHT)\nOPP = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}\n\n# --- Diamond/octagon shapes (h, w) ---\nSHAPES = ((3, 4), (4, 4), (5, 4), (5, 6), (6, 6), (8, 8))\n_SHAPE_WIDTHS = {\n    (3, 4): (2, 4, 2),\n    (4, 4): (2, 4, 4, 2),\n    (5, 4): (2, 4, 4, 4, 2),\n    (5, 6): (2, 4, 6, 4, 2),\n    (6, 6): (2, 4, 6, 6, 4, 2),\n    (8, 8): (2, 4, 6, 8, 8, 6, 4, 2),\n}\n\n# --- Canvas bounds ---\nH_MIN, H_MAX = 13, 27\nW_MIN, W_MAX = 15, 27\nSTART_COL_PAD = 2        # min distance from start column to grid edge\n\n# --- Start segment ---\nSTART_H_MIN, START_H_MAX = 2, 3  # red segment height (below yellow cap)\n\n# --- Chain / distractor ---\nCHAIN_LEN_WEIGHTS = [1, 3, 3, 3]  # weights for chain_len in [0, 1, 2, 3]\nMAX_BLOB_COUNT = 4                 # chain + distractors combined\nMAX_DISTRACTORS = 1\n\n# --- Placement ---\nMIN_GAP_FIRST = 4   # along-axis gap between start and first blob\nMIN_GAP_CHAIN = 3   # along-axis gap between successive chain blobs\n\n# --- Retry ---\nGEN_RETRIES = 300\n\n\ndef _shape_mask(h: int, w: int) -> np.ndarray:\n    \"\"\"Build a boolean diamond/octagon mask for the given (h, w) shape.\"\"\"\n    widths = _SHAPE_WIDTHS[(h, w)]\n    mask = np.zeros((h, w), dtype=bool)\n    for r, ww in enumerate(widths):\n        c0 = (w - ww) // 2\n        mask[r, c0 : c0 + ww] = True\n    return mask\n\n\n","exit_code":0,"status":"completed"}}
