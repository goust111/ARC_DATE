{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom collections import Counter\nfrom pathlib import Path\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed262781723/8/1.py')\nmod = SourceFileLoader('dbg_arc_task', str(p)).load_module()\n\nreasons = Counter()\nfor _ in range(200):\n    rng = np.random.default_rng()\n    h = int(rng.integers(*mod.GEN_H_RANGE))\n    w = int(rng.integers(*mod.GEN_W_RANGE))\n    grid = np.full((h, w), mod.GEN_BG, dtype=int)\n    occ = np.zeros((h, w), dtype=bool)\n\n    side = 'left' if bool(rng.integers(2)) else 'bottom'\n    legend_len = int(rng.integers(*mod.GEN_LEGEND_LEN_RANGE))\n    size = int(mod.GEN_SQUARE_SIZES[int(rng.integers(len(mod.GEN_SQUARE_SIZES)))])\n    gap = int(mod.GEN_GAPS[int(rng.integers(len(mod.GEN_GAPS)))])\n    span = legend_len * size + (legend_len - 1) * gap\n    if (side == 'left' and span > h - 2) or (side == 'bottom' and span > w - 2):\n        reasons['legend_too_big'] += 1\n        continue\n\n    color_order = list(rng.choice(np.array(mod.GEN_COLORS, dtype=int), size=legend_len + 1, replace=False))\n    frame_color = int(color_order[0])\n    legend_colors = [int(c) for c in color_order[1:]]\n    mod._place_legend(grid, occ, legend_colors, side, size, gap, rng)\n\n    frame_count = int(rng.integers(*mod.GEN_FRAME_COUNT_RANGE))\n    base_counts = list(range(1, legend_len + 1))\n    rng.shuffle(base_counts)\n    counts = base_counts[: min(frame_count, legend_len)]\n    while len(counts) < frame_count:\n        counts.append(int(rng.integers(1, legend_len + 1)))\n    if len(set(counts)) < 2:\n        counts[-1] = 1 if counts[0] \"'!= 1 else legend_len\n    rng.shuffle(counts)\n\n    frames = []\n    failed = False\n    for count in counts:\n        placed = False\n        for _ in range(mod.GEN_FRAME_RETRIES):\n            ih = int(rng.integers(3, 8))\n            iw = int(rng.integers(3, 8))\n            if (ih * iw + 1) // 2 < count:\n                continue\n            markers = mod._marker_positions(ih, iw, count, rng)\n            if markers is None:\n                reasons['\"'marker_none'] += 1\n                continue\n            oh = ih + 2\n            ow = iw + 2\n            positions = mod._frame_positions(occ, oh, ow)\n            if not positions:\n                reasons['no_positions'] += 1\n                failed = True\n                break\n            r0, c0 = positions[int(rng.integers(len(positions)))]\n            bbox = mod._draw_frame(grid, r0, c0, ih, iw, frame_color, markers)\n            mod._mark_rect(occ, *bbox, pad=1)\n            frames.append((*bbox, count))\n            placed = True\n            break\n        if failed:\n            break\n        if not placed:\n            reasons['frame_not_placed'] += 1\n            failed = True\n            break\n    if failed:\n        continue\n\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[int(cnts.argmax())]) \"'!= mod.GEN_BG:\n        reasons['\"'bg_not_mode'] += 1\n        continue\n\n    expected = grid.copy()\n    for r0, c0, r1, c1, count in frames:\n        expected[r0 + 1 : r1, c0 + 1 : c1] = legend_colors[count - 1]\n\n    try:\n        got = mod.main(grid)\n    except Exception as e:\n        reasons[f'main_exc:{type(e).__name__}:{e}'] += 1\n        continue\n    if not np.array_equal(got, expected):\n        reasons['oracle_mismatch'] += 1\n        continue\n    reasons['success'] += 1\n\nprint(reasons)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
