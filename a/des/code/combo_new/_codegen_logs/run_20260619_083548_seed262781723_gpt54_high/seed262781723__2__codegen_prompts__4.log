nap/new/ARC_code/eval/dbff022c.py:195:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:197:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:232:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:235:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:274:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:275:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:288:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:332:    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:339:    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:346:    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:378:    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:392:    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:408:    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:425:    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:441:    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py:544:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:4:import numpy as np\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:7:import random\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:16:class _DSU:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:255:    \"\"\"Find a 5-cell L-shaped color-9 marker and return its corner position.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:282:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:283:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:301:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:347:    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:354:    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:362:    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:371:    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:385:    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:431:    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:453:    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:473:    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:514:    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:538:    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:544:    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:556:    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:566:    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:700:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:3:import numpy as np\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:6:import random\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:172:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:173:    \"\"\"Predict the next panel in a framed sequence by continuing each scheduled colored interval.\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:187:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:404:    \"\"\"Return full-panel masks by color index, or None if any blob fails.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:435:    \"\"\"Mutate prior panels and output with the preplaced dynamic-color masks.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:457:    \"\"\"Return tiled input only when the solver oracle matches planned output.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2ccd9fef.py:502:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:3:import numpy as np\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:6:import random\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:8:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:9:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:23:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:439:    \"\"\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:454:    \"\"\"Apply rot90(k) then optional horizontal flip.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:462:    \"\"\"Rotate/flip an array built for the left border to target the given side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:475:    \"\"\"Swap two colors in a patch, returning a new array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:484:    \"\"\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:497:    \"\"\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:518:    \"\"\"Build a frame + docked tool pair oriented for the left border.\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:521:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:562:    \"\"\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:582:    \"\"\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:619:    \"\"\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:635:    \"\"\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:657:    \"\"\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:660:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:717:    \"\"\"Pick a random D4 variant of the tool and place it at a free location on the grid.\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:720:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:739:    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py:781:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:3:import numpy as np\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:6:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:20:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:169:import random\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:170:import numpy as np\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:202:    \"\"\"Canonical bytes representation under D4 for a bool mask (tight-cropped).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:213:    \"\"\"Grow a 4-conn slot of given size starting from a random free cell.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:215:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:240:    \"\"\"Dilate a bool mask by 1 cell (8-connectivity).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:254:    \"\"\"Mark coords and their 8-neighbors as forbidden (in-place).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:261:    \"\"\"Generate a layout grid with n_slots 4-connected slots (including n_units unit slots).\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:264:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:313:    \"\"\"Build output and input patches for one slot.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:317:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:347:    \"\"\"Assemble the expected output grid: frame_color background with pieces placed.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:362:    \"\"\"Build the input grid: frame + scattered pieces + distractor noise.\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:364:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/898e7135.py:492:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:3:import numpy as np\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:6:import random\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:9:class _Node:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:208:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:209:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:224:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:313:class _Obj:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:324:    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:342:    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:366:    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:378:    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:387:    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:397:    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:445:    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:472:    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:514:    \"\"\"Recursively build masks and place children within frames.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:544:    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:555:    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:572:    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:588:    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:607:    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:627:    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:665:    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:693:def generate_input():\n","exit_code":0,"status":"completed"}}
