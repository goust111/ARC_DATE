{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"from __future__ import annotations\nimport random\nimport numpy as np\nfrom arc_utils import STRUCT8, bbox_coords, get_bg, label_mask, paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\ndef _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:\n    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n        # The contact edge doesn't have to span the full height. It's the N-2 contiguous\n        # cells on the attachment side. For \"left-attach\", the solver checks the RIGHT edge\n        # of the cropped sprite: exactly e contiguous filled cells.\n\n        # Build each row from right to left. Rightmost col is the contact column.\n        # For flipud symmetry, row[i] mirrors row[h-1-i].\n        # Decide top half, mirror to bottom.\n\n        for ri in range(half_h):\n            mirror_ri = h - 1 - ri\n            for ci in range(w):\n                if ci == w - 1:\n                    # Contact column: fill rows that form the contiguous e-block\n                    # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.\n                    # Instead: just decide freely and check later\n                    val = rng.random() < 0.5\n                else:\n                    val = rng.random() < 0.5\n                grid[ri, ci] = val\n                grid[mirror_ri, ci] = val\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/21897d95.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter, deque\nimport numpy as np\n\nfrom arc_utils import label_mask\nimport random\n\n\nDIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\nUP = (-1, 0)\nDOWN = (1, 0)\nRIGHT = (0, 1)\n\n\nclass _DSU:\n    def __init__(self, n: int):\n        self.parent = list(range(int(n)))\n\n    def find(self, x: int) -> int:\n        x = int(x)\n        while self.parent[x] != x:\n            self.parent[x] = self.parent[self.parent[x]]\n            x = self.parent[x]\n        return int(x)\n\n    def union(self, a: int, b: int) -> None:\n        ra = self.find(a)\n        rb = self.find(b)\n        if ra != rb:\n            self.parent[rb] = ra\n\n\ndef _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])\n\n\ndef _opp(d: tuple[int, int]) -> tuple[int, int]:\n    return (-int(d[0]), -int(d[1]))\n\n\ndef _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:\n    assert len(branches) == 3\n    branch_set = set(branches)\n    for d in branches:\n        if _opp(d) not in branch_set:\n            return d\n    raise AssertionError(\"T marker has no single stem\")\n\n\ndef _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:\n    if len(cells) != 4:\n        return None\n    for r, c in cells:\n        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]\n        if len(branches) != 3:\n            continue\n        stem = _stem_from_branches(branches)\n        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}\n        expected.remove((r - stem[0], c - stem[1]))\n        if cells == expected:\n            bar = [d for d in branches if d != stem]\n            assert len(bar) == 2 and bar[0] == _opp(bar[1])\n            return (int(r), int(c)), stem, bar\n    return None\n\n\ndef _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:\n    comp_id = np.full(g.shape, -1, dtype=int)\n    comp_colors: list[int] = []\n    comp_areas: list[int] = []\n    cid = 0\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if coords.size == 0:\n                continue\n            for rr, cc in coords:\n                comp_id[int(rr), int(cc)] = cid\n            comp_colors.append(int(col))\n            comp_areas.append(int(len(coords)))\n            cid += 1\n    return comp_id, comp_colors, comp_areas\n\n\ndef _solve_unrotated(g: np.ndarray) -> np.ndarray:\n    labels_1, n_1 = label_mask(g == 1, connectivity=4)\n    one_components = {\n        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}\n        for k in range(1, int(n_1) + 1)\n    }\n    one_sizes = {k: len(cells) for k, cells in one_components.items()}\n\n    markers: list[dict] = []\n    used_ones: set[tuple[int, int]] = set()\n    control = np.zeros(g.shape, dtype=bool)\n\n    for cells in one_components.values():\n        parsed = _parse_tetromino(cells)\n        if parsed is None:\n            continue\n        center, stem, bar = parsed\n        markers.append({\"kind\": \"normal\", \"center\": center, \"stem\": stem, \"bar\": bar, \"cells\": cells})\n        used_ones |= cells\n        for r, c in cells:\n            control[r, c] = True\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if int(g[r, c]) == 1:\n                continue\n            branches: list[tuple[int, int]] = []\n            cells: list[tuple[int, int]] = []\n            ok = True\n            for d in DIRS:\n                rr, cc = r + d[0], c + d[1]\n                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:\n                    continue\n                label = int(labels_1[rr, cc])\n                if one_sizes[label] == 1 and (rr, cc) not in used_ones:\n                    branches.append(d)\n                    cells.append((rr, cc))\n                else:\n                    ok = False\n            if ok and len(branches) == 3:\n                stem = _stem_from_branches(branches)\n                bar = [d for d in branches if d != stem]\n                assert len(bar) == 2 and bar[0] == _opp(bar[1])\n                marker_cells = set(cells) | {(int(r), int(c))}\n                markers.append(\n                    {\n                        \"kind\": \"colored\",\n                        \"center\": (int(r), int(c)),\n                        \"stem\": stem,\n                        \"bar\": bar,\n                        \"cells\": marker_cells,\n                        \"target_color\": int(g[r, c]),\n                    }\n                )\n                used_ones |= set(cells)\n                for rr, cc in marker_cells:\n                    control[rr, cc] = True\n\n    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}\n    assert all_one_cells == used_ones, \"all color-1 pixels must belong to a T control marker\"\n\n    for col in sorted(set(map(int, g.ravel())) - {1}):\n        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)\n        for k in range(1, int(n_labels) + 1):\n            coords = np.argwhere(labels == k)\n            if len(coords) > 5:\n                continue\n            r0, c0 = coords.min(axis=0)\n            r1, c1 = coords.max(axis=0)\n            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):\n                continue\n            cells = {tuple(map(int, xy)) for xy in coords}\n            markers.append({\"kind\": \"small\", \"cells\": cells})\n            for rr, cc in cells:\n                control[rr, cc] = True\n\n    comp_id, comp_colors, comp_areas = _label_base_components(g, control)\n    assert comp_colors, \"at least one base region is required\"\n    dsu = _DSU(len(comp_colors))\n\n    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:\n        r, c = center\n        step = int(start)\n        while True:\n            rr = r + direction[0] * step\n            cc = c + direction[1] * step\n            if not _in_bounds(g.shape, rr, cc):\n                return None\n            if comp_id[rr, cc] >= 0:\n                return int(comp_id[rr, cc])\n            step += 1\n\n    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:\n        counts: Counter = Counter()\n        for r, c in cells:\n            for dr, dc in DIRS:\n                rr, cc = r + dr, c + dc\n                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:\n                    counts[int(comp_id[rr, cc])] += 1\n        return counts\n\n    for marker in markers:\n        if marker[\"kind\"] in {\"normal\", \"colored\"}:\n            center = marker[\"center\"]\n            stem = marker[\"stem\"]\n            dest = first_component_from(center, stem, start=2)\n            assert dest is not None, \"T marker must point at a destination region\"\n\n            source_parts: list[int] = []\n            for bar_dir in marker[\"bar\"]:\n                rr = center[0] + stem[0] + bar_dir[0]\n                cc = center[1] + stem[1] + bar_dir[1]\n                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0\n                source_parts.append(int(comp_id[rr, cc]))\n            source = source_parts[0]\n            for part in source_parts[1:]:\n                assert comp_colors[part] == comp_colors[source], \"T source diagonals must share a color\"\n                dsu.union(source, part)\n\n            for comp in adjacent_component_counts(marker[\"cells\"]):\n                if comp_colors[comp] == comp_colors[source]:\n                    dsu.union(source, comp)\n            marker[\"dest_comp\"] = dest\n            marker[\"source_comp\"] = source\n        else:\n            counts = adjacent_component_counts(marker[\"cells\"])\n            assert counts, \"small marker must touch its owner region\"\n            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))\n            for comp in counts:\n                if comp_colors[comp] == comp_colors[owner]:\n                    dsu.union(owner, comp)\n            marker[\"source_comp\"] = owner\n\n    root_color: dict[int, int] = {}\n    for i, col in enumerate(comp_colors):\n        root = dsu.find(i)\n        root_color.setdefault(root, int(col))\n        assert root_color[root] == int(col), \"merged region colors must match\"\n\n    final_color = dict(root_color)\n    for marker in markers:\n        if marker[\"kind\"] not in {\"normal\", \"colored\"}:\n            marker[\"source\"] = dsu.find(marker[\"source_comp\"])\n            continue\n        dest = dsu.find(marker[\"dest_comp\"])\n        source = dsu.find(marker[\"source_comp\"])\n        marker[\"source\"] = source\n        replacement = int(marker[\"target_color\"]) if marker[\"kind\"] == \"colored\" else int(root_color[source])\n        assert final_color[dest] in {root_color[dest], replacement}, \"conflicting T controls for one region\"\n        final_color[dest] = replacement\n\n    out = np.full(g.shape, -1, dtype=int)\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            cid = int(comp_id[r, c])\n            if cid >= 0:\n                out[r, c] = int(final_color[dsu.find(cid)])\n\n    for marker in markers:\n        color = int(final_color[marker[\"source\"]])\n        for r, c in marker[\"cells\"]:\n            out[r, c] = color\n\n    assert bool(np.all(out >= 0)), \"all cells must be assigned\"\n    return out\n\n\ndef _find_l9_orientation(g: np.ndarray) -> str | None:\n    \"\"\"Find a 5-cell L-shaped color-9 marker and return its corner position.\"\"\"\n    mask9 = g == 9\n    if not mask9.any():\n        return None\n    labels, n = label_mask(mask9, connectivity=4)\n    for k in range(1, int(n) + 1):\n","exit_code":0,"status":"completed"}}
