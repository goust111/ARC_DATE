C_code/eval/62593bfd.py:113:    \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:132:    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:153:    \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:169:    \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:176:    \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:189:    \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:197:    \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:206:    \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:224:    \"\"\"Return a mask that is True wherever occupied or any 8-neighbor is occupied.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:238:    \"\"\"Check if mask placed at (r0, c0) overlaps any dilated-occupied cell.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:244:    \"\"\"Paint all components at their output positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:252:    \"\"\"Place components at random non-output rows without 8-neighbor overlap.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:284:    \"\"\"Create duplicate-shape (top) and unique-shape (bottom) component groups.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:321:    \"\"\"Single attempt: build output-first, derive input, validate with oracle.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/62593bfd.py:361:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py:6:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py:22:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py:282:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:27:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:28:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:43:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:106:    \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:183:    \"\"\"Return destination rectangles plus their original source edge.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:274:    \"\"\"Generate a valid input with exactly n_rects black rectangles.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/b25e450b.py:295:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/57edb29d.py:87:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/57edb29d.py:88:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/57edb29d.py:103:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/57edb29d.py:316:    \"\"\"Return band items whose marked rectangles overlap the plain rectangle's rows.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/57edb29d.py:358:    \"\"\"Render band items with one-cell separators and a one-cell border.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/57edb29d.py:450:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:31:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:32:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:51:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:142:    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:202:    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/d749d46f.py:226:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
