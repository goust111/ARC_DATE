{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np, random, traceback\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed262781723/10/5.py')\nmod = SourceFileLoader('new_arc_task_dbg2', str(p)).load_module()\nfor attempt in range(10000):\n    stamp_a = mod._random_stamp()\n    stamp_b = mod._random_stamp()\n    for _ in range(mod.STAMP_RETRIES):\n        if stamp_a.shape \"'!= stamp_b.shape or not np.array_equal(stamp_a, stamp_b):\n            break\n        stamp_b = mod._random_stamp()\n    else:\n        continue\n    if random.random() < 0.5:\n        h_stamp, v_stamp = stamp_a, stamp_b\n    else:\n        h_stamp, v_stamp = stamp_b, stamp_a\n    legend = mod._legend_patch(h_stamp, v_stamp)\n    min_h = max(18, legend.shape[0] + 6)\n    min_w = max(18, legend.shape[1] + 8)\n    if min_h > 30 or min_w > 30:\n        continue\n    grid_h = random.randint(min_h, 30)\n    grid_w = random.randint(min_w, 30)\n    grid = np.full((grid_h, grid_w), mod.BG, dtype=int)\n    occupied = np.zeros((grid_h, grid_w), dtype=bool)\n    corner = random.choice(('\"'tl','tr','bl','br'))\n    lr0, lc0, lh, lw = mod._paste_in_corner(grid, legend, corner)\n    rr0 = max(0, lr0 - 1)\n    cc0 = max(0, lc0 - 1)\n    rr1 = min(grid_h - 1, lr0 + lh)\n    cc1 = min(grid_w - 1, lc0 + lw)\n    occupied[rr0:rr1+1, cc0:cc1+1] = True\n    building_count = random.choice((2,3,4))\n    orientations = ['h','v'] + [random.choice(('h','v')) for _ in range(building_count - 2)]\n    random.shuffle(orientations)\n    colors = random.sample(mod.BUILDING_COLORS, building_count)\n    ok = True\n    for color, orientation in zip(colors, orientations):\n        patch = mod._random_building_patch(color, orientation)\n        if not mod._place_building(grid, occupied, patch):\n            ok = False\n            break\n    if not ok:\n        continue\n    try:\n        mod._decode_legend(grid)\n    except Exception as e:\n        print('attempt', attempt, 'corner', corner, 'shape', grid.shape)\n        print(grid)\n        print('maroon comps', [c['bbox'] for c in mod._components_of_color(grid, mod.MAROON)])\n        print('azure coords', np.argwhere(grid == mod.AZURE).tolist())\n        raise\nprint('no fail')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
