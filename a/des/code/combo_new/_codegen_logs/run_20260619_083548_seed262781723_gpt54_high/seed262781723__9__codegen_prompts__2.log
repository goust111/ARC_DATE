{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/16b78196.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import components_mask, find_components, get_bg\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.\n\n    Input structure:\n    - bg = most common color. Largest monochrome component is a solid \"bar\" with boundary notches (bg holes opening to its bbox edge).\n    - Several smaller colored sprites scattered around the bar.\n\n    Rule:\n    - Each bar notch is filled by a root piece whose shape exactly covers the hole.\n    - The root defines a strip (column-span or row-span) for its chain.\n    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.\n    - Multiple chains grow independently from different bar notches.\n\n    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    bg = get_bg(g)\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    comps.sort(key=lambda d: -d[\"area\"])\n    assert comps\n\n    bar = comps[0]\n    pieces_raw = comps[1:]\n\n    out = np.full((H, W), int(bg), dtype=int)\n    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar[\"bbox\"])\n    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1\n    bar_color = int(bar[\"color\"])\n    bar_occ = set((int(r), int(c)) for r, c in bar[\"coords\"])\n    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)\n    for r, c in bar_occ:\n        bar_mask[r - bar_r0, c - bar_c0] = True\n    for r, c in bar_occ:\n        out[r, c] = bar_color\n\n    def shape_from_coords(coords: np.ndarray, bbox):\n        r0, c0, r1, c1 = map(int, bbox)\n        h, w = r1 - r0 + 1, c1 - c0 + 1\n        rel = [(int(r - r0), int(c - c0)) for r, c in coords]\n        rel_set = set(rel)\n        return {\"rel\": rel, \"rel_set\": rel_set, \"h\": h, \"w\": w}\n\n    pieces = []\n    for p in pieces_raw:\n        # For this puzzle, pieces are used in their original orientation (no rotation / flip).\n        r0, c0 = map(int, p[\"bbox\"][:2])\n        pieces.append({\"color\": int(p[\"color\"]), \"shape\": shape_from_coords(p[\"coords\"], p[\"bbox\"]), \"orig\": (r0, c0)})\n\n    def bar_notches(bar_mask, bar_r0, bar_c0):\n        empty = ~bar_mask\n        h, w = map(int, empty.shape)\n        notches = []\n        for pts in components_mask(empty, connectivity=4):\n            r = pts[:, 0]\n            c = pts[:, 1]\n            top = int((r == 0).sum())\n            bottom = int((r == h - 1).sum())\n            left = int((c == 0).sum())\n            right = int((c == w - 1).sum())\n\n            # Keep only holes that open to the bar bbox boundary.\n            if top + bottom + left + right == 0:\n                continue\n\n            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)\n\n            # Axis is determined by which bbox side has the widest mouth.\n            side, mouth_n = max(\n                [(name, cnt) for name, cnt in [(\"top\", top), (\"bottom\", bottom), (\"left\", left), (\"right\", right)] if cnt > 0],\n                key=lambda x: x[1],\n            )\n            axis = \"cols\" if side in (\"top\", \"bottom\") else \"rows\"\n            notches.append({\"axis\": axis, \"hole\": hole_gl, \"mouth_n\": mouth_n})\n        return notches\n\n    notches = bar_notches(bar_mask, bar_r0, bar_c0)\n\n    def pixels(v, top, left):\n        return set((top + lr, left + lc) for lr, lc in v[\"rel\"])\n\n    def placement_pts(v, top, left, occ, must_cover=None, strip=None):\n        if top < 0 or left < 0 or top + v[\"h\"] > H or left + v[\"w\"] > W:\n            return None\n        if strip is not None:\n            axis, A, B = strip\n            if axis == \"cols\":\n                if left != A or v[\"w\"] != B - A + 1:\n                    return None\n            else:\n                if top != A or v[\"h\"] != B - A + 1:\n                    return None\n        pts = pixels(v, top, left)\n        if pts & occ:\n            return None\n        if must_cover is not None and not (must_cover <= pts):\n            return None\n        return pts\n\n    def aligned_positions(axis, A, cover, v):\n        if axis == \"cols\":\n            left = A\n            tops = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if cN == left + lc:\n                        tops.add(rN - lr)\n            for top in tops:\n                yield top, left\n        else:\n            top = A\n            lefts = set()\n            for rN, cN in cover:\n                for lr, lc in v[\"rel\"]:\n                    if rN == top + lr:\n                        lefts.add(cN - lc)\n            for left in lefts:\n                yield top, left\n\n    def touches(pts, other):\n        for r, c in pts:\n            for dr, dc in DIR4:\n                if (r + dr, c + dc) in other:\n                    return True\n        return False\n\n    def hole_positions(hole, v):\n        pos = set()\n        for rH, cH in hole:\n            for lr, lc in v[\"rel\"]:\n                pos.add((rH - lr, cH - lc))\n        return pos\n\n    # Root candidates: fill the bar hole (no strip constraint yet).\n    root_cands = []\n    for ni, n in enumerate(notches):\n        axis = n[\"axis\"]\n\n        for pi, p in enumerate(pieces):\n            v = p[\"shape\"]\n            for top, left in hole_positions(n[\"hole\"], v):\n                pts = placement_pts(v, top, left, bar_occ, must_cover=n[\"hole\"])\n                if pts is None:\n                    continue\n                if axis == \"cols\":\n                    A, B = int(left), int(left + v[\"w\"] - 1)\n                else:\n                    A, B = int(top), int(top + v[\"h\"] - 1)\n                mv = abs(int(top) - int(p[\"orig\"][0])) + abs(int(left) - int(p[\"orig\"][1]))\n                root_cands.append(\n                    (\n                        (int(mv), -int(n[\"mouth_n\"])),\n                        {\"ni\": ni, \"pi\": pi, \"top\": int(top), \"left\": int(left), \"axis\": axis, \"A\": A, \"B\": B, \"shape\": v},\n                    )\n                )\n\n    root_cands.sort(key=lambda x: x[0])\n    cand_roots = [pair[1] for pair in root_cands[:20]]\n\n    best_out = out.copy()\n    best_key = None\n\n    def search(out_grid, occ_set, chains, remaining):\n        nonlocal best_out, best_key\n        placed_cnt = len(pieces) - len(remaining)\n        key = (placed_cnt, -len(remaining), -len(occ_set))\n        if best_key is None or key > best_key:\n            best_key = key\n            best_out = out_grid.copy()\n        if not remaining:\n            return True\n\n        def gen_extend_moves(chain, remaining_set):\n            axis = chain[\"axis\"]\n            A, B = int(chain[\"A\"]), int(chain[\"B\"])\n            head = chain[\"head\"]\n            head_pts = pixels(head[\"shape\"], head[\"top\"], head[\"left\"])\n            head_top, head_left = int(head[\"top\"]), int(head[\"left\"])\n            head_h, head_w = int(head[\"shape\"][\"h\"]), int(head[\"shape\"][\"w\"])\n\n            cavity = {\n                (r, c)\n                for r in range(head_top, head_top + head_h)\n                for c in range(head_left, head_left + head_w)\n                if out_grid[r, c] == bg\n            }\n            if not cavity:\n                return []\n\n            moves = []\n            for pi in remaining_set:\n                v = pieces[pi][\"shape\"]\n                for top, left in aligned_positions(axis, A, cavity, v):\n                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))\n                    if pts is None:\n                        continue\n                    if not touches(pts, head_pts):\n                        continue\n                    moves.append((pi, top, left, pts, v))\n            return moves\n\n        # Try extending any chain.\n        for ch in chains:\n            moves = gen_extend_moves(ch, remaining)\n            if not moves:\n                continue\n            # small branching factor is enough for this puzzle\n            for pi, top, left, pts, v in moves[:8]:\n                # apply\n                for r, c in pts:\n                    out_grid[r, c] = int(pieces[pi][\"color\"])\n                old_head = ch[\"head\"]\n                ch[\"head\"] = {\"top\": int(top), \"left\": int(left), \"shape\": v}\n                occ2 = set(occ_set) | set(pts)\n                rem2 = set(remaining)\n                rem2.remove(pi)\n                if search(out_grid, occ2, chains, rem2):\n                    return True\n                # undo\n                ch[\"head\"] = old_head\n                for r, c in pts:\n                    out_grid[r, c] = int(bg)\n                # restore bar pixels (roots are always non-overlapping)\n                for r, c in bar_occ:\n                    out_grid[r, c] = bar_color\n        return False\n\n    # Try small root subsets (1..3) from top candidates.\n    from itertools import combinations\n\n    for k in range(1, min(3, len(cand_roots)) + 1):\n        for roots_sel in combinations(range(len(cand_roots)), k):\n","exit_code":0,"status":"completed"}}
