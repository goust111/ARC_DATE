([[1, 1], [0, 1]], dtype=bool),\n0173:     np.array([[1, 0], [1, 1]], dtype=bool),\n0174:     np.array([[0, 1], [1, 1]], dtype=bool),\n0175:     np.array([[1, 1], [1, 1]], dtype=bool),\n0176: ]\n0177: \n0178: def _outside_locations(\n0179:     frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n0180: ) -> list[tuple[int, int]]:\n0181:     fr0, fc0, fr1, fc1 = frame_bbox\n0182:     ph, pw = patch_shape\n0183:     locations: list[tuple[int, int]] = []\n0184:     for r in range(_GRID_SHAPE[0] - ph + 1):\n0185:         for c in range(_GRID_SHAPE[1] - pw + 1):\n0186:             pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n0187:             separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n0188:             if separated:\n0189:                 locations.append((r, c))\n0190:     return locations\n0191: \n0192: def _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n0193:     positions: list[tuple[int, int]] = []\n0194:     for r in range(_GRID_SHAPE[0] - size + 1):\n0195:         for c in range(_GRID_SHAPE[1] - size + 1):\n0196:             frame_bbox = (r, c, r + size - 1, c + size - 1)\n0197:             if _outside_locations(frame_bbox, patch_shape):\n0198:                 positions.append((r, c))\n0199:     return positions\n0200: \n0201: def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n0202:     r1, c1 = r0 + size - 1, c0 + size - 1\n0203:     grid[r0 : r1 + 1, c0] = color\n0204:     grid[r0 : r1 + 1, c1] = color\n0205:     grid[r0, c0 : c1 + 1] = color\n0206:     grid[r1, c0 : c1 + 1] = color\n0207: \n0208: def _sample_sprite(size: int) -> np.ndarray:\n0209:     return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n0210: \n0211: def _sample_case() -> tuple[int, int, np.ndarray]:\n0212:     sprite_color = random.choice(_SPRITE_COLORS)\n0213:     size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n0214:     return sprite_color, size, _sample_sprite(size)\n0215: \n0216: def _build_candidate_grids(\n0217:     frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n0218: ) -> tuple[np.ndarray, np.ndarray] | None:\n0219:     fr0, fc0, fr1, fc1 = frame_bbox\n0220:     stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n0221:     if not np.any(stretched):\n0222:         return None\n0223: \n0224:     out = np.full(_GRID_SHAPE, _BG, dtype=int)\n0225:     _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n0226:     out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n0227: \n0228:     inp = out.copy()\n0229:     inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n0230: \n0231:     locations = _outside_locations(frame_bbox, sprite.shape)\n0232:     if not locations:\n0233:         return None\n0234:     sr, sc = random.choice(locations)\n0235:     patch = np.where(sprite, sprite_color, _BG)\n--- lines 260-265 ---\n0260: def generate_input() -> np.ndarray:\n0261:     for _ in range(_MAX_GENERATION_ATTEMPTS):\n0262:         grid = _gen_attempt()\n0263:         if grid is not None:\n0264:             return grid\n0265:     raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n","exit_code":0,"status":"completed"}}
