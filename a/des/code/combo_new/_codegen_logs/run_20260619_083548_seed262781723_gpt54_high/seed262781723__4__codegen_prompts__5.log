{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed262781723/4/5.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\n\ndir_to_idx = {d:i for i,d in enumerate(mod.DIRS)}\ncounts = {0: 0, 1: 0, 2: 0, '3+': 0}\nfor _ in range(80):\n    g = mod.generate_input()\n    towers, mirrors, _legend_mask, mix = mod._extract_scene(g)\n    h, w = g.shape\n    for tower in towers:\n        ir, ic = tower['indicator']\n        color = tower['color']\n        d = dir_to_idx[tower['dir']]\n        pos = (ir, ic)\n        hits = 0\n        seen = set()\n        while True:\n            state = (pos[0], pos[1], d, color)\n            if state in seen:\n                break\n            seen.add(state)\n            dr, dc = mod.DIRS[d]\n            nr, nc = pos[0] + dr, pos[1] + dc\n            if not (0 <= nr < h and 0 <= nc < w):\n                break\n            if (nr, nc) in mirrors:\n                hits += 1\n                color = mix[tuple(sorted((color, mirrors[(nr, nc)])))]\n                pos = (nr, nc)\n                d = (d + 1) % 4\n                continue\n            if int(g[nr, nc]) \"'!= mod.BG:\n                break\n            pos = (nr, nc)\n        if hits >= 3:\n            counts['\"'3+'] += 1\n        else:\n            counts[hits] += 1\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
