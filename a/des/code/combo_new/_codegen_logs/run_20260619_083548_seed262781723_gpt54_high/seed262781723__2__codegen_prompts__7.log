{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/edb79dae.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp recolored sprites into a framed region using placeholder positions and a color legend.\n\n    Input structure:\n    - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.\n    - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.\n\n    Rule:\n    - Find the frame and its interior placeholders.\n    - For each placeholder color, locate the matching-color sprite outside the frame.\n    - Stamp each sprite at the placeholder's position inside the frame.\n    - Recolor every stamped sprite to the output color defined by the legend.\n\n    Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)\n\n    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]\n    H, W = crop.shape\n    assert H >= 3 and W >= 3, f\"frame too small for interior: {(H, W)}\"\n\n    # Placeholder components inside the frame interior.\n    inner_mask = np.zeros((H, W), dtype=bool)\n    inner_mask[1:-1, 1:-1] = True\n    placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}\n    assert placeholder_colors, \"no placeholder colors found inside frame\"\n\n    placeholders: list[tuple[int, tuple[int, int, int, int]]] = []\n    for col in sorted(placeholder_colors):\n        for pts in components_mask((crop == col) & inner_mask, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            placeholders.append((col, (r0, c0, r1, c1)))\n    # Eval inputs use one placement bbox size per placeholder color.\n    phw: dict[int, tuple[int, int]] = {}\n    for col in placeholder_colors:\n        dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]\n        assert dims, f\"no placeholder component found for color {col}\"\n        unique_dims = sorted(set(dims))\n        assert len(unique_dims) == 1, f\"ambiguous placeholder sizes for color {col}: {unique_dims}\"\n        phw[col] = unique_dims[0]\n\n    # Extract outside-frame components for sprite shapes and for legend color mapping.\n    outside = np.ones(g.shape, dtype=bool)\n    outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False\n\n    # Collect all outside components (with ids) for later pairing.\n    comps = []\n    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]\n    cid = 0\n    for col in colors:\n        for pts in components_mask((g == col) & outside, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            pts_tuples = [(int(r), int(c)) for r, c in pts]\n            comps.append(\n                {\n                    \"id\": cid,\n                    \"col\": int(col),\n                    \"pts\": pts_tuples,\n                    \"bbox\": (r0, c0, r1, c1),\n                    \"area\": len(pts_tuples),\n                }\n            )\n            cid += 1\n\n    def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n        ar0, ac0, ar1, ac1 = a\n        br0, bc0, br1, bc1 = b\n        return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)\n\n    # Legend mapping: detect small two-color glyph regions where two components overlap in bbox\n    # and the union bbox contains only those two colors (no background).\n    color_map: dict[int, int] = {}\n    legend_ids: set[int] = set()\n\n    for i in range(len(comps)):\n        for j in range(i + 1, len(comps)):\n            ci = comps[i]\n            cj = comps[j]\n            if ci[\"col\"] == cj[\"col\"]:\n                continue\n            if not _bbox_overlap(ci[\"bbox\"], cj[\"bbox\"]):\n                continue\n            r0 = min(ci[\"bbox\"][0], cj[\"bbox\"][0])\n            c0 = min(ci[\"bbox\"][1], cj[\"bbox\"][1])\n            r1 = max(ci[\"bbox\"][2], cj[\"bbox\"][2])\n            c1 = max(ci[\"bbox\"][3], cj[\"bbox\"][3])\n            # restrict to compact legend-like regions\n            if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            sub_colors = set(map(int, np.unique(sub))) - {frame_col}\n            if bg in sub_colors:\n                continue\n            if len(sub_colors) != 2:\n                continue\n            cset = set(sub_colors)\n            if ci[\"col\"] not in cset or cj[\"col\"] not in cset:\n                continue\n\n            # Decide source->target.\n            # If exactly one color is used as a placeholder inside the frame, that one is source.\n            if (ci[\"col\"] in placeholder_colors) ^ (cj[\"col\"] in placeholder_colors):\n                src = ci[\"col\"] if ci[\"col\"] in placeholder_colors else cj[\"col\"]\n                tgt = cj[\"col\"] if src == ci[\"col\"] else ci[\"col\"]\n            else:\n                # Otherwise: the larger component in this pair is treated as the source.\n                assert ci[\"area\"] != cj[\"area\"], f\"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}\"\n                if ci[\"area\"] > cj[\"area\"]:\n                    src, tgt = ci[\"col\"], cj[\"col\"]\n                else:\n                    src, tgt = cj[\"col\"], ci[\"col\"]\n\n            assert src in placeholder_colors, f\"legend source color {src} is not a placeholder\"\n            assert src not in color_map, f\"duplicate legend mapping for placeholder color {src}\"\n            color_map[src] = int(tgt)\n            legend_ids.add(ci[\"id\"])\n            legend_ids.add(cj[\"id\"])\n    assert set(color_map) == placeholder_colors, (\n        f\"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}\"\n    )\n\n    # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.\n    sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}\n    for src_col in sorted(placeholder_colors):\n        all_candidates = [c for c in comps if c[\"col\"] == src_col and c[\"id\"] not in legend_ids]\n        assert all_candidates, f\"no non-legend sprite found for color {src_col}\"\n        want_h, want_w = phw[src_col]\n        sized = [\n            c\n            for c in all_candidates\n            if (c[\"bbox\"][2] - c[\"bbox\"][0] + 1) == want_h and (c[\"bbox\"][3] - c[\"bbox\"][1] + 1) == want_w\n        ]\n        assert len(sized) == 1, f\"expected one size-matched sprite for color {src_col}, found {len(sized)}\"\n        base = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        # Some sprites can be split into multiple 4-connected components of the same color.\n        # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.\n        pts_set = set(base[\"pts\"])\n        for c in all_candidates:\n            if c[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = c[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(c[\"pts\"])\n\n        coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))\n        sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)\n\n    # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_coords and src_col in color_map, f\"placeholder color {src_col} missing sprite or color mapping\"\n        tgt_col = int(color_map[src_col])\n        coords, sh, sw = sprite_coords[src_col]\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match sprite for color {src_col}\"\n        )\n        assert pr0 + sh <= H and pc0 + sw <= W, f\"sprite for color {src_col} does not fit at placeholder\"\n        # Align sprite's bbox top-left to placeholder bbox top-left.\n        off_r = pr0\n        off_c = pc0\n        for dr, dc in coords:\n            rr, cc = off_r + dr, off_c + dc\n            out[rr, cc] = tgt_col\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nFRAME_COL = 5                       # frame border color (always gray)\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\n\n\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Inflate a frame's hole-layout and fill each hole with its matching piece.\n\n    Input structure:\n    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n\n    Rule:\n    - Extract connected hole regions inside the frame as slots.\n    - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n    - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n\n    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- find the largest connected component of foreground (multicolor) ---\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n    frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n    fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n\n    # The frame is monochrome; use its dominant color as output background.\n    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n    bgc = int(Counter(frame_cols).most_common(1)[0][0])\n\n    # --- layout = bg holes inside the frame bbox, tight-cropped ---\n    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n    hole = sub == int(bg)\n    hole_box = bbox(hole)\n    assert hole_box is not None, \"frame must enclose at least one bg hole\"\n    lr0, lc0, lr1, lc1 = map(int, hole_box)\n    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n\n    # --- slot components in the layout ---\n    slots = []\n    for coords in components_mask(layout, connectivity=4):\n        rr0, cc0, rr1, cc1 = bbox_coords(coords)\n        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n        h = int(rr1 - rr0 + 1)\n        w = int(cc1 - cc0 + 1)\n        sm = np.zeros((h, w), dtype=bool)\n        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n        slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n    slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n\n    assert slots, \"frame must contain at least one slot\"\n\n    # --- pieces = non-singleton foreground components excluding the frame component ---\n    pieces = []\n    for comp in comps:\n        if comp is frame_comp:\n            continue\n        coords = comp[\"coords\"]\n        if coords.size == 0 or int(coords.shape[0]) <= 1:\n            continue\n        pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n        ph, pw = map(int, patch.shape)\n        pm = np.zeros((ph, pw), dtype=bool)\n        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n        pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n\n    assert pieces, \"at least one non-frame piece must exist\"\n\n    # --- infer k from the smallest solid square piece ---\n    k = None\n    for p in pieces:\n        h, w = map(int, p[\"mask\"].shape)\n        if h == w and int(p[\"mask\"].sum()) == int(h * w):\n            k = int(h) if k is None else min(int(k), int(h))\n    k = int(k or 1)\n\n    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:\n        hh, ww = mask.shape\n        if hh % k != 0 or ww % k != 0:\n            return None\n        out_h, out_w = int(hh // k), int(ww // k)\n        out = np.zeros((out_h, out_w), dtype=bool)\n        for r in range(out_h):\n            for c in range(out_w):\n                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]\n                if bool(block.all()):\n                    out[r, c] = True\n                elif bool(block.any()):\n                    return None\n        return out\n\n    def dihedral_variants(\n        patch: np.ndarray, mask: np.ndarray\n    ) -> list[tuple[np.ndarray, np.ndarray]]:\n        base = []\n        for kk in range(4):\n            p = np.rot90(patch, int(kk))\n            m = np.rot90(mask, int(kk))\n            base.append((p, m))\n            base.append((np.fliplr(p), np.fliplr(m)))\n        uniq = []\n        seen = set()\n        for p, m in base:\n            key = m.tobytes()\n            if key in seen:\n                continue\n            seen.add(key)\n            uniq.append((p, m))\n        return uniq\n\n    # Precompute all usable (piece,variant) candidates with their block masks.\n    candidates = []\n    for pi, p in enumerate(pieces):\n        for vp, vm in dihedral_variants(p[\"patch\"], p[\"mask\"]):\n            um = downsample_blocks(vm)\n            if um is None:\n                continue\n            candidates.append({\"pi\": int(pi), \"area\": int(p[\"area\"]), \"um\": um, \"vp\": vp, \"vm\": vm})\n\n    used_piece: set[int] = set()\n    placements: list[tuple[dict, dict]] = []\n    for s in slots:\n        need_area = int(s[\"area\"]) * int(k) * int(k)\n        found = None\n        for cand in candidates:\n            if int(cand[\"pi\"]) in used_piece:\n                continue\n            if int(cand[\"area\"]) != int(need_area):\n                continue\n            if cand[\"um\"].shape != s[\"mask\"].shape:\n                continue\n            if np.array_equal(cand[\"um\"], s[\"mask\"]):\n                found = cand\n                break\n        assert found is not None, \"every slot must match a piece\"\n        used_piece.add(int(found[\"pi\"]))\n        placements.append((s, found))\n\n    outH = (int(layout.shape[0]) + 2) * int(k)\n    outW = (int(layout.shape[1]) + 2) * int(k)\n    out = np.full((outH, outW), int(bgc), dtype=int)\n\n    for s, cand in placements:\n        top = (int(s[\"r0\"]) + 1) * int(k)\n        left = (int(s[\"c0\"]) + 1) * int(k)\n        paste(out, cand[\"vp\"], int(top), int(left), mask=cand[\"vm\"], overwrite=True)\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for ARC-AGI-2 task 898e7135.\n\nOutput-first strategy:\n  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).\n  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask\n     by k to get the piece sprite (solid k*k blocks).\n  3. Assemble the frame (layout + 1-cell border of frame_color).\n  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel\n     distractor noise in a fresh color.\n\nThe generator validates main(input) == expected_output before returning.\n\"\"\"\n\nimport random\nimport numpy as np\n\nfrom arc_utils import paste, random_free_location\n\n# --- tunables ----------------------------------------------------------------\n\nK_CHOICES = [2, 3]                  # block scale factor\nLAYOUT_H_RANGE = (4, 12)           # inner layout rows\nLAYOUT_W_RANGE = (4, 8)            # inner layout cols\nN_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)\nN_UNITS_MAX = 2                    # max unit-slot count per example\nNON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots\n\nHOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area\nUNIT_SLOT_RETRIES = 20             # attempts per unit slot placement\nNON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement\nGROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call\n\nCANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width\nAREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing\nAREA_BUFFER_CONST = 50             # additive constant for canvas area budget\n\nDISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count\nDISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement\nMIN_DISTRACTORS = 8                # minimum placed distractors to accept\n\nGENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input\n\n\n# --- layout generation -------------------------------------------------------\n\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_MAX_RETRIES):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed '\"'$d'\"'; printf '\\\\n###GEN###\\\\n'; sed -n '/\"'^def generate_input/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\n\n###GEN###\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n","exit_code":0,"status":"completed"}}
