{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py /home/lixinyu/snap/new/ARC_code/train/84551f4c.py; do echo \"FILE: $f\"; awk '\"'BEGIN{p=0} /\"'^def main'\"\\\\(/ {p=1} /\"'^def generate_input'\"\\\\(/ && p==1 {print; exit} p==1 {print}' \\\"\"'$f\"; echo; awk '\"'BEGIN{p=0} /\"'^def generate_input'\"\\\\(/ {p=1} p==1 {print}' \\\"\"'$f\"; echo; done'","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the one blank in each corner region so all four regions have the same color multiset.\n\n    Input structure:\n    - The dominant background color forms one solid separator row and one solid\n      separator column.\n    - The separator cross splits the grid into four equal rectangular corner regions.\n    - Each corner region contains exactly one background-colored blank pixel.\n\n    Rule:\n    - Count the non-background colors in each corner region.\n    - The completed region multiset is defined by the maximum observed count of\n      each color across the four regions.\n    - Replace each region's blank pixel with the single color needed to match that\n      completed multiset.\n\n    Key insight:\n    - The separator color inside a corner region is a missing value marker; comparing\n      the four regions reveals the shared multiset without using numeric color order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    color_counts = Counter(map(int, g.reshape(-1)))\n    assert all(\n        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    ), \"background color must be uniquely dominant\"\n\n    cross_row, cross_col = _solid_separator_cross(g, bg)\n    regions = _quadrants(cross_row, cross_col, height, width)\n    region_shape = g[regions[0]].shape\n    region_area = int(np.prod(region_shape))\n\n    counts_by_region: list[Counter[int]] = []\n    blank_positions: list[tuple[int, int]] = []\n    for row_slice, col_slice in regions:\n        region = g[row_slice, col_slice]\n        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n        blanks = np.argwhere(region == bg)\n        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n\n        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n        local_r, local_c = map(int, blanks[0])\n        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n\n    target_counts: Counter[int] = Counter()\n    for counts in counts_by_region:\n        for color, count in counts.items():\n            target_counts[color] = max(target_counts[color], count)\n    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n\n    out = g.copy()\n    for counts, (row, col) in zip(counts_by_region, blank_positions):\n        missing = target_counts - counts\n        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n        fill_color, fill_count = next(iter(missing.items()))\n        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n        out[row, col] = fill_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n# Canvas/palette bounds.\nGRID_HALF_MIN = 2\nGRID_HALF_MAX = 6\nCOLOR_COUNT = 10\nMIN_TARGET_COLORS = 3\nMAX_NON_BG_COLORS = COLOR_COUNT - 1\n# Layout probabilities and constraints.\nPREFERRED_GRID_HALF = (2, 2)\nPREFERRED_GRID_PROB = 0.65\nQUADRANT_COUNT = 4\nSEPARATOR_WIDTH = 1\nBG_DOMINANCE_MARGIN = 1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n    if parts <= 0 or total < parts or total > parts * max_each:\n        return None\n\n    counts = []\n    remaining = total\n    for i in range(parts):\n        slots_left = parts - i - 1\n        lo = max(1, remaining - slots_left * max_each)\n        hi = min(max_each, remaining - slots_left)\n        counts.append(random.randint(lo, hi))\n        remaining -= counts[-1]\n\n    random.shuffle(counts)\n    return counts\n\n\ndef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n    options = []\n    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n            area = k * m\n            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n            max_colors = min(MAX_NON_BG_COLORS, area)\n            valid_counts = [\n                c\n                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n                if area <= c * max_target_count\n            ]\n            if valid_counts:\n                options.append((k, m, valid_counts, max_target_count))\n    return options\n\n\ndef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n    options = _gen_grid_options()\n    if random.random() < PREFERRED_GRID_PROB:\n        preferred_k, preferred_m = PREFERRED_GRID_HALF\n        for option in options:\n            if option[0] == preferred_k and option[1] == preferred_m:\n                return option\n    return random.choice(options)\n\n\ndef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n    sep = SEPARATOR_WIDTH\n    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n\n\ndef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n    if len(set(missing_colors)) == 1:\n        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n        missing_colors[-1] = random.choice(alternatives)\n    return missing_colors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = random.randrange(COLOR_COUNT)\n    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n    area = k * m\n\n    color_count = random.choice(valid_color_counts)\n    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n    if target_counts is None:\n        return None\n\n    target_values = []\n    for color, count in zip(non_bg_colors, target_counts):\n        target_values.extend([color] * count)\n\n    missing_colors = _gen_missing_colors(non_bg_colors)\n    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n    inp = out.copy()\n\n    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n        values = target_values[:]\n        random.shuffle(values)\n        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n\n        candidates = np.argwhere(quadrant_out == missing_color)\n        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n        quadrant_in = quadrant_out.copy()\n        quadrant_in[blank_r, blank_c] = bg\n\n        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt():\n    sampled = _sample_groups()\n    if sampled is None:\n        return None\n    rows, max_height, groups = sampled\n\n    layout = _sample_layout(max_height, groups)\n    if layout is None:\n        return None\n    bars, width = layout\n\n    inp, expected = _render_pair(rows, width, bars)\n    if not _passes_oracle(inp, expected):\n        return None\n    return inp\n\n\ndef generate_input():\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 84551f4c input\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/d749d46f.py /home/lixinyu/snap/new/ARC_code/train/963c33f8.py; do echo \"FILE: $f\"; awk '\"'BEGIN{p=0} /\"'^def main'\"\\\\(/ {p=1} /\"'^def generate_input'\"\\\\(/ && p==1 {print; exit} p==1 {print}' \\\"\"'$f\"; echo; awk '\"'BEGIN{p=0} /\"'^def generate_input'\"\\\\(/ {p=1} p==1 {print}' \\\"\"'$f\"; echo; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/train/d749d46f.py /home/lixinyu/snap/new/ARC_code/train/963c33f8.py; do echo \"FILE: $f\"; awk '\"'BEGIN{p=0} /\"'^def main'\"\\\\(/ {p=1} /\"'^def generate_input'\"\\\\(/ && p==1 {print; exit} p==1 {print}' \\\"\"'$f\"; echo; awk '\"'BEGIN{p=0} /\"'^def generate_input'\"\\\\(/ {p=1} p==1 {print}' \\\"\"'$f\"; echo; done'","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n            if expanded:\n                break\n        if not expanded:\n            break\n    return comp if len(comp) == comp_size else None\n\n\ndef _place_obstacle_components(grid: np.ndarray, component_sizes: list[int], forbidden: set[tuple[int, int]],\n                               obstacle_pixels: set[tuple[int, int]]) -> bool:\n    for comp_size in component_sizes:\n        placed = False\n        for _ in range(COMPONENT_PLACEMENT_ATTEMPTS):\n            comp = _grow_component(grid, comp_size, forbidden, obstacle_pixels)\n            if comp is None:\n                continue\n            if any((pr + dr, pc + dc) in obstacle_pixels\n                   for pr, pc in comp for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]):\n                continue\n            for pr, pc in comp:\n                grid[pr, pc] = GEN_OBSTACLE\n                obstacle_pixels.add((pr, pc))\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _scatter_obstacles(grid: np.ndarray, c0: int, stop_positions: list[int],\n                       obstacle_pixels: set[tuple[int, int]]) -> bool:\n    H, _W = grid.shape\n    num_target_components = random.randint(*OBSTACLE_COMPONENT_RANGE)\n    total_target_pixels = random.randint(*OBSTACLE_PIXEL_RANGE)\n    remaining_pixels = max(0, total_target_pixels - len(obstacle_pixels))\n    remaining_components = max(1, num_target_components - len(stop_positions))\n    if remaining_pixels <= 0 or remaining_components <= 0:\n        return True\n\n    component_sizes = _sample_component_sizes(remaining_pixels, remaining_components)\n    if component_sizes is None:\n        return False\n    forbidden = _forbidden_cells(H, c0, stop_positions, obstacle_pixels)\n    return _place_obstacle_components(grid, component_sizes, forbidden, obstacle_pixels)\n\n\ndef _has_clear_stop_drop_zones(grid: np.ndarray, c0: int, stop_positions: list[int]) -> bool:\n    H, _W = grid.shape\n    for j in stop_positions:\n        col = c0 + j\n        first_obs = next((r for r in range(MARKER_SIZE, H) if grid[r, col] == GEN_OBSTACLE), None)\n        if first_obs is None:\n            return False\n        for dr in range(1, DROP_ZONE_HEIGHT + 1):\n            if first_obs - dr < 0 or grid[first_obs - dr, col] != GEN_BG:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid, c0, stop_positions, obstacle_pixels = _init_scene(H, W)\n\n    if not _scatter_obstacles(grid, c0, stop_positions, obstacle_pixels):\n        return None\n    if not _has_clear_stop_drop_zones(grid, c0, stop_positions):\n        return None\n    obs_comps = [c for c in find_components(grid, bg=GEN_BG, connectivity=4, monochromatic=True)\n                 if c['color'] == GEN_OBSTACLE]\n    if not (OBSTACLE_COMPONENT_RANGE[0] <= len(obs_comps) <= OBSTACLE_COMPONENT_RANGE[1]):\n        return None\n\n    # Run solver to verify no assertion failures\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/65b59efc.py /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py; do echo \"FILE: $f\"; awk '\"'BEGIN{p=0} /\"'^def main'\"\\\\(/ {p=1} /\"'^def generate_input'\"\\\\(/ && p==1 {print; exit} p==1 {print}' \\\"\"'$f\"; echo; awk '\"'BEGIN{p=0} /\"'^def generate_input'\"\\\\(/ {p=1} p==1 {print}' \\\"\"'$f\"; echo; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'for f in /home/lixinyu/snap/new/ARC_code/eval/65b59efc.py /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py; do echo \"FILE: $f\"; awk '\"'BEGIN{p=0} /\"'^def main'\"\\\\(/ {p=1} /\"'^def generate_input'\"\\\\(/ && p==1 {print; exit} p==1 {print}' \\\"\"'$f\"; echo; awk '\"'BEGIN{p=0} /\"'^def generate_input'\"\\\\(/ {p=1} p==1 {print}' \\\"\"'$f\"; echo; done'","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/eval/65b59efc.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a stamp map: read templates, markers, and palette from a tiled grid, then render stamps.\n\n    Input structure:\n    - Grid divided into K tile columns (each N wide) separated by 1-col dashed separators.\n    - Top band (rows 0..N-1): K template masks, one per tile column.\n    - Middle band (rows N+1..2N): marker pixels whose color picks a template.\n    - Bottom band (rows 2N+2..): K palette swatches giving the output color per template.\n    - Separator rows at rows N and 2N+1 (dashed pattern of sep color).\n\n    Rule:\n    - Each marker's local position (lr, lc) within its tile column determines which N×N output block to stamp.\n    - The marker's color identifies which template to use; the palette recolors the template.\n\n    Key insight: Marker color encodes template index; local position within tile column encodes stamp block.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    counts = Counter(map(int, g.flatten()))\n    bg = int(counts.most_common(1)[0][0])\n    sep = int(max((cnt, col) for col, cnt in counts.items() if col != bg)[1])\n\n    sep_cols = [c for c in range(W) if (g[:, c] == sep).sum() >= H // 2]\n    sep_rows = [r for r in range(H) if (g[r, :] == sep).sum() >= W // 2]\n    assert sep_cols and sep_rows\n\n    N = sep_cols[0]\n    starts = [0] + [c + 1 for c in sep_cols]\n    K = len(starts)\n\n    # Read K templates from the top band\n    tcols = []\n    tmasks = []\n    for st in starts:\n        sub = g[0:N, st:st + N]\n        vals = {int(v) for v in sub.flat} - {bg, sep}\n        assert len(vals) == 1\n        col = vals.pop()\n        tcols.append(col)\n        tmasks.append(sub == col)\n    assert len(set(tcols)) == K\n    tcol_to_j = {col: j for j, col in enumerate(tcols)}\n\n    # Read palette colors from the bottom band\n    pal_r0 = sep_rows[-1] + 1\n    pcols = []\n    for st in starts:\n        sub = g[pal_r0:H, st:st + N]\n        vals = {int(v) for v in sub.flat} - {bg, sep}\n        assert len(vals) == 1\n        pcols.append(vals.pop())\n\n    # Read markers from the middle band and build stamp placements\n    mid_r0 = N + 1\n    out = np.full((N * N, N * N), bg, dtype=int)\n    slot_owner = {}\n\n    for st in starts:\n        tile_color = None\n        for lr in range(N):\n            for lc in range(N):\n                v = int(g[mid_r0 + lr, st + lc])\n                if v == bg or v == sep:\n                    continue\n                assert tile_color is None or v == tile_color, \"tile column must have uniform marker color\"\n                tile_color = v\n                j = tcol_to_j[v]\n                assert (lr, lc) not in slot_owner or slot_owner[(lr, lc)] == j, \"different templates must occupy different slots\"\n                slot_owner[(lr, lc)] = j\n                tile = np.where(tmasks[j], pcols[j], bg)\n                out[lr * N:(lr + 1) * N, lc * N:(lc + 1) * N] = tile\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# -- CFG: colors --\n_BG = 0\n_SEP = 5\n_AVAILABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]  # all non-bg, non-sep\n\n# -- CFG: grid dimensions --\n_N_RANGE = (3, 5)          # tile size\n_K_RANGE = (3, 4)          # number of templates\n_PAL_H_CHOICES = [2, 3, 4]       # palette band height options\n_PAL_H_WEIGHTS = [8, 1, 1]       # probability weights for palette height\n_MAX_ROW_PAD = 2           # max trailing bg row padding\n_MAX_COL_PAD = 7           # max trailing bg col padding\n\n# -- CFG: template generation --\n_DENSITY_RANGE = (0.55, 0.92)    # template pixel density\n_SYMMETRY_OPTIONS = [None, \"horizontal\", \"vertical\", \"mirror\", \"not_symmetric\"]\n_TEMPLATE_CONNECTIVITY = 8\n\n# -- CFG: marker placement --\n_MIN_SLOT_COVERAGE = 0.60  # minimum fraction of NxN slots filled with markers\n\n# -- CFG: palette swatch --\n_SWATCH_DOUBLE_PROB = 0.35  # probability of 2-pixel swatch (vs 1-pixel)\n\n# -- CFG: retry --\n_MAX_RETRIES = 300\n\n\ndef _dash_cell(pos: int, n: int) -> bool:\n    \"\"\"True if position `pos` gets a separator pip in the dashed pattern for tile size `n`.\"\"\"\n    k = pos % (n + 1)\n    return k == n or k % 2 == 0\n\n\ndef _sep_count(length: int, n: int) -> int:\n    \"\"\"Count how many separator pips appear in a span of `length` cells.\"\"\"\n    return sum(1 for x in range(length) if _dash_cell(x, n))\n\n\ndef _raw_col(tile_col: int, local_c: int, n: int) -> int:\n    \"\"\"Map (tile column index, local column) to absolute grid column.\"\"\"\n    return tile_col * (n + 1) + local_c\n\n\ndef _sample_template(n: int, color: int) -> np.ndarray:\n    \"\"\"Generate a random NxN boolean template mask via random_sprite.\"\"\"\n    sprite = random_sprite(\n        n, n,\n        density=random.uniform(*_DENSITY_RANGE),\n        symmetry=random.choice(_SYMMETRY_OPTIONS),\n        color_palette=[color],\n        connectivity=_TEMPLATE_CONNECTIVITY,\n        background=_BG,\n    )\n    return sprite == color\n\n\ndef _build_expected(n: int, templates: list[np.ndarray], pcols: list[int],\n                    placements: list[tuple[int, int, int]]) -> np.ndarray:\n    \"\"\"Render the expected output grid from stamp placements.\"\"\"\n    expected = np.full((n * n, n * n), _BG, dtype=int)\n    for j, rr, cc in placements:\n        tile = np.where(templates[j], pcols[j], _BG)\n        paste(expected, tile, rr * n, cc * n)\n    return expected\n\n\ndef _draw_separators(grid: np.ndarray, n: int, k: int, core_h: int, core_w: int) -> None:\n    \"\"\"Draw dashed horizontal and vertical separator lines in-place.\"\"\"\n    for r in (n, 2 * n + 1):\n        for c in range(core_w):\n            if _dash_cell(c, n):\n                grid[r, c] = _SEP\n    for i in range(k - 1):\n        c = n + i * (n + 1)\n        for r in range(core_h):\n            if _dash_cell(r, n):\n                grid[r, c] = _SEP\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*_N_RANGE)\n    k = random.randint(*_K_RANGE)\n    tcols = random.sample(_AVAILABLE_COLORS, k)\n    pcols = random.sample(_AVAILABLE_COLORS, k)\n\n    # Grid dimensions with optional bg padding\n    pal_h = random.choices(_PAL_H_CHOICES, weights=_PAL_H_WEIGHTS)[0]\n    core_h = 2 * n + 2 + pal_h\n    core_w = k * n + (k - 1)\n    max_rpad = max(0, min(_MAX_ROW_PAD, 2 * _sep_count(core_h, n) + 1 - core_h))\n    max_cpad = max(0, min(_MAX_COL_PAD, 2 * _sep_count(core_w, n) + 1 - core_w))\n    h = core_h + random.randint(0, max_rpad)\n    w = core_w + random.randint(0, max_cpad)\n\n    templates = [_sample_template(n, col) for col in tcols]\n\n    # Assign random slots to templates for marker placement\n    all_slots = [(rr, cc) for rr in range(n) for cc in range(n)]\n    random.shuffle(all_slots)\n    min_marks = int(np.ceil(_MIN_SLOT_COVERAGE * n * n))\n    mark_count = random.randint(min_marks, n * n)\n    used_slots = all_slots[:mark_count]\n    assign_pool = (list(range(k)) * ((mark_count + k - 1) // k))[:mark_count]\n    random.shuffle(assign_pool)\n    placements = [(j, rr, cc) for (rr, cc), j in zip(used_slots, assign_pool)]\n\n    expected = _build_expected(n, templates, pcols, placements)\n\n    # Assemble input grid\n    grid = np.full((h, w), _BG, dtype=int)\n    _draw_separators(grid, n, k, core_h, core_w)\n\n    # Top band: templates\n    for j, mask in enumerate(templates):\n        paste(grid, np.where(mask, tcols[j], _BG), 0, j * (n + 1))\n\n    # Middle band: markers (shuffled tile-column assignment)\n    tile_assign = list(range(k))\n    random.shuffle(tile_assign)\n    for j, rr, cc in placements:\n        grid[n + 1 + rr, _raw_col(tile_assign[j], cc, n)] = tcols[j]\n\n    # Bottom band: palette swatches\n    swatch_r = 2 * n + 2 + pal_h - 1\n    for j, col in enumerate(pcols):\n        start = j * (n + 1)\n        size = 2 if random.random() < _SWATCH_DOUBLE_PROB else 1\n        c0 = start + max(0, (n - size) // 2)\n        grid[swatch_r, c0:c0 + size] = col\n\n    # Oracle check\n    try:\n        if np.array_equal(main(grid), expected):\n            return grid\n    except Exception:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 65b59efc input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Look up query glyphs in a reference table and mark whether they form a line.\n\n    Input structure:\n    - Teal background with two full-width pink separator rows.\n    - Above the first separator is a query row of 5x5 glyph cells.\n    - Between separators is a reference table of the same 5x5 cells; a glyph is\n      identified by both its color and its 3x3 shape.\n\n    Rule:\n    - Green-fill the background inside every table cell whose glyph exactly\n      appears in the query row.\n    - If the matched table cells form one complete row or one complete column,\n      also green-fill the query band and the bottom verdict band.\n    - Otherwise leave the query band unchanged and fill the bottom verdict band red.\n\n    Key insight: The bottom color is not a count; it is the yes/no answer to\n    whether the queried glyphs align as a full row or column in the table.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n    cell_size = 5\n\n    sep_rows = _constant_non_bg_rows(g, bg)\n    assert len(sep_rows) >= 2, \"expected two full-width separator rows\"\n    top_sep = sep_rows[0]\n    bottom_sep = sep_rows[-1]\n\n    table_region = g[top_sep + 1 : bottom_sep, :]\n    table_fg = np.argwhere(table_region != bg)\n    assert table_fg.size, \"reference table must contain glyphs\"\n\n    first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())\n    first_glyph_c = int(table_fg[:, 1].min())\n    row0 = first_glyph_r - 1\n    col0 = first_glyph_c - 1\n\n    row_starts = list(range(row0, bottom_sep, cell_size))\n    row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]\n    col_starts = list(range(col0, w, cell_size))\n    col_starts = [c for c in col_starts if c + cell_size <= w]\n    assert row_starts and col_starts, \"could not infer table cell grid\"\n\n    query_sigs = [\n        sig\n        for c in col_starts\n        if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None\n    ]\n    query_set = set(query_sigs)\n    assert len(query_sigs) == len(query_set), \"query glyphs should be distinct\"\n\n    out = g.copy()\n    selected: list[tuple[int, int]] = []\n    for ri, r in enumerate(row_starts):\n        for ci, c in enumerate(col_starts):\n            if _cell_signature(g, r, c, cell_size, bg) not in query_set:\n                continue\n            selected.append((int(ri), int(ci)))\n            cell = out[r : r + cell_size, c : c + cell_size]\n            cell[cell == bg] = 3\n\n    complete_query = len(query_sigs) == len(col_starts)\n    same_row = len({r for r, _c in selected}) == 1\n    same_col = len({c for _r, c in selected}) == 1\n    success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)\n\n    if success:\n        query_band = out[:top_sep, :]\n        query_band[query_band == bg] = 3\n        out[bottom_sep + 1 :, :] = 3\n    else:\n        out[bottom_sep + 1 :, :] = 2\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# -- Grid layout --\nGRID_H, GRID_W = 30, 22       # fixed canvas size\nTOP_SEP_ROW = 5                # query-band separator row\nBOTTOM_SEP_ROW = 27            # table-bottom separator row\nQUERY_BAND_H = 5               # height of query band (rows 0..4)\nVERDICT_ROW = 28               # verdict band starts here\n\n# -- Colors --\nBG = 8                         # teal background\nGREEN = 3                      # success / match highlight\nRED = 2                        # fail verdict\nSEP = 6                        # separator row color\nGLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors\n\n# -- Table geometry --\nTABLE_DIM = 4                  # 4x4 grid of cells\nCELL = 5                       # each cell is 5x5\nROWS = (7, 12, 17, 22)        # row offsets for 4 table rows\nCOLS = (1, 6, 11, 16)         # col offsets for 4 table columns\n\n# -- Glyph shape --\nFILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph\nSHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count\nMAX_SHAPES_PER_FILL = 5       # cap during random top-up\n\n# -- Color distribution --\nCOLOR_MIN, COLOR_MAX = 1, 3   # each color used 1-3 times across 16 cells\n\n# -- Outcome probabilities --\nP_SUCCESS = 0.4               # chance of success outcome\nP_QUERY_3 = 0.35              # chance of 3-query fail (vs 4-query fail)\nFAIL_MODES = (\"rect\", \"bent_row\", \"bent_col\", \"scatter_rows\", \"scatter_cols\")\n\n# -- Generation --\nMAX_RETRIES = 300\n\n\ndef _has_full_bbox(mask: int) -> bool:\n    \"\"\"True if the 3x3 bitmask spans all four edges (non-empty top/bottom/left/right rows).\"\"\"\n    bits = [(mask >> i) & 1 for i in range(9)]\n    return (\n        any(bits[0:3])\n        and any(bits[6:9])\n        and any(bits[i] for i in (0, 3, 6))\n        and any(bits[i] for i in (2, 5, 8))\n    )\n\n\nPATTERNS_BY_FILL = {\n    k: tuple(m for m in range(1 << 9) if m.bit_count() == k and _has_full_bbox(m))\n    for k in range(FILL_MIN, FILL_MAX + 1)\n}\n\n\ndef _balanced_color_list() -> list[int]:\n    \"\"\"Assign 16 colors (one per cell) so each of the 8 palette colors appears 1-3 times.\"\"\"\n    counts = {c: COLOR_MIN for c in GLYPH_COLORS}\n    extras = TABLE_DIM * TABLE_DIM - len(GLYPH_COLORS) * COLOR_MIN  # 16 - 8 = 8\n    for _ in range(extras):\n        choices = [c for c in GLYPH_COLORS if counts[c] < COLOR_MAX]\n        counts[random.choice(choices)] += 1\n    colors = [c for c, n in counts.items() for _ in range(n)]\n    random.shuffle(colors)\n    return colors\n\n\ndef _balanced_shape_masks() -> list[int]:\n    \"\"\"Pick 16 distinct 3x3 shape masks with a balanced distribution of fill counts.\"\"\"\n    counts = dict(SHAPE_BASE_COUNTS)\n    extras = TABLE_DIM * TABLE_DIM - sum(counts.values())  # 16 - 9 = 7\n    for _ in range(extras):\n        choices = [k for k in range(FILL_MIN, FILL_MAX) if counts[k] < MAX_SHAPES_PER_FILL]\n        counts[random.choice(choices)] += 1\n\n    masks: list[int] = []\n    for k, n in counts.items():\n        masks.extend(random.sample(PATTERNS_BY_FILL[k], n))\n    random.shuffle(masks)\n    return masks\n\n\ndef _glyph(mask: int, color: int) -> np.ndarray:\n    \"\"\"Render a 3x3 bitmask as a CELL x CELL array with 1-pixel border of BG.\"\"\"\n    cell = np.full((CELL, CELL), BG, dtype=int)\n    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)\n    cell[1:4, 1:4][bits] = color\n    return cell\n\n\ndef _line_cells() -> list[tuple[int, int]]:\n    \"\"\"Pick a complete row or column of 4 cells (shuffled order).\"\"\"\n    if random.random() < 0.5:\n        r = random.randrange(TABLE_DIM)\n        cells = [(r, c) for c in range(TABLE_DIM)]\n    else:\n        c = random.randrange(TABLE_DIM)\n        cells = [(r, c) for r in range(TABLE_DIM)]\n    random.shuffle(cells)\n    return cells\n\n\ndef _fail_cells(count: int) -> list[tuple[int, int]]:\n    \"\"\"Pick `count` distinct cells that do NOT all share a single row or column.\"\"\"\n    if count == 3:\n        rs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cs = random.sample(range(TABLE_DIM), random.choice((2, 3)))\n        cells = [(rs[0], cs[0]), (rs[1], cs[1])]\n        pool = [(r, c) for r in rs for c in cs if (r, c) not in cells]\n        cells.append(random.choice(pool))\n    else:\n        mode = random.choice(FAIL_MODES)\n        if mode == \"rect\":\n            rs = random.sample(range(TABLE_DIM), 2)\n            cs = random.sample(range(TABLE_DIM), 2)\n            cells = [(r, c) for r in rs for c in cs]\n        elif mode == \"bent_row\":\n            r = random.randrange(TABLE_DIM)\n            dropped_c = random.randrange(TABLE_DIM)\n            new_r = random.choice([rr for rr in range(TABLE_DIM) if rr != r])\n            cells = [(r, c) for c in range(TABLE_DIM) if c != dropped_c] + [(new_r, dropped_c)]\n        elif mode == \"bent_col\":\n            c = random.randrange(TABLE_DIM)\n            dropped_r = random.randrange(TABLE_DIM)\n            new_c = random.choice([cc for cc in range(TABLE_DIM) if cc != c])\n            cells = [(r, c) for r in range(TABLE_DIM) if r != dropped_r] + [(dropped_r, new_c)]\n        elif mode == \"scatter_rows\":\n            base_c = random.randrange(TABLE_DIM)\n            cols = [base_c] * TABLE_DIM\n            for r in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                cols[r] = random.choice([c for c in range(TABLE_DIM) if c != base_c])\n            cells = [(r, cols[r]) for r in range(TABLE_DIM)]\n        else:\n            base_r = random.randrange(TABLE_DIM)\n            rows = [base_r] * TABLE_DIM\n            for c in random.sample(range(TABLE_DIM), random.choice((1, 2, 3))):\n                rows[c] = random.choice([r for r in range(TABLE_DIM) if r != base_r])\n            cells = [(rows[c], c) for c in range(TABLE_DIM)]\n\n    assert len(cells) == count and len(set(cells)) == count\n    assert len({r for r, _c in cells}) > 1 and len({c for _r, c in cells}) > 1\n    random.shuffle(cells)\n    return cells\n\n\ndef _expected_output(grid: np.ndarray, cells: list[tuple[int, int]], success: bool) -> np.ndarray:\n    \"\"\"Build the expected solver output by green-filling matched cells and verdict band.\"\"\"\n    out = grid.copy()\n    for r_i, c_i in cells:\n        cell = out[ROWS[r_i] : ROWS[r_i] + CELL, COLS[c_i] : COLS[c_i] + CELL]\n        cell[cell == BG] = GREEN\n    if success:\n        query_band = out[:QUERY_BAND_H, :]\n        query_band[query_band == BG] = GREEN\n        out[VERDICT_ROW:, :] = GREEN\n    else:\n        out[VERDICT_ROW:, :] = RED\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to generate one valid input grid; return None on oracle mismatch.\"\"\"\n    grid = np.full((GRID_H, GRID_W), BG, dtype=int)\n    grid[TOP_SEP_ROW, :] = SEP\n    grid[BOTTOM_SEP_ROW, :] = SEP\n\n    masks = _balanced_shape_masks()\n    colors = _balanced_color_list()\n    glyphs: list[np.ndarray] = []\n    for i, (mask, color) in enumerate(zip(masks, colors, strict=True)):\n        glyph = _glyph(mask, color)\n        glyphs.append(glyph)\n        r_i, c_i = divmod(i, TABLE_DIM)\n        paste(grid, glyph, ROWS[r_i], COLS[c_i])\n\n    success = random.random() < P_SUCCESS\n    if success:\n        query_cells = _line_cells()\n    else:\n        count = 3 if random.random() < P_QUERY_3 else 4\n        query_cells = _fail_cells(count)\n\n    for slot, (r_i, c_i) in enumerate(query_cells):\n        paste(grid, glyphs[r_i * TABLE_DIM + c_i], 0, COLS[slot])\n\n    expected = _expected_output(grid, query_cells, success)\n    if not np.array_equal(main(grid), expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid d8e07eb2 input\")\n\n","exit_code":0,"status":"completed"}}
