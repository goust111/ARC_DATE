{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '240,420p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n            if col not in mapping:\n                continue\n            if cnt > best:\n                best = cnt\n                border = col\n        if border is None:\n            continue\n\n        fill = int(mapping[border])\n        for r, c in pts:\n            out[r, c] = fill\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _touches_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:\n    h, w = shape\n    return bool(\n        (coords[:, 0] == 0).any()\n        or (coords[:, 0] == h - 1).any()\n        or (coords[:, 1] == 0).any()\n        or (coords[:, 1] == w - 1).any()\n    )\n\n\ndef _neighbor_colors(g: np.ndarray, coords: np.ndarray, color: int) -> set[int]:\n    coord_set = {tuple(map(int, p)) for p in coords}\n    colors = set()\n    for r, c in coord_set:\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and (nr, nc) not in coord_set:\n                if int(g[nr, nc]) != color:\n                    colors.add(int(g[nr, nc]))\n    return colors\n\n\ndef _object_components(g: np.ndarray) -> tuple[int, list[np.ndarray], set[int]]:\n    candidates = []\n    for color in set(map(int, g.ravel())):\n        inner_components = [\n            coords\n            for coords in components_mask(g == color, connectivity=4)\n            if len(coords) >= 5 and not _touches_boundary(coords, g.shape)\n        ]\n        if len(inner_components) < 2:\n            continue\n\n        panel_colors = set()\n        for coords in inner_components:\n            neighbors = _neighbor_colors(g, coords, color)\n            if len(neighbors) != 1:\n                break\n            panel_colors.update(neighbors)\n        else:\n            if len(panel_colors) == 2:\n                candidates.append((color, inner_components, panel_colors))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef _valid_core_rect(\n    object_cells: set[tuple[int, int]],\n    missing: set[tuple[int, int]],\n    outside: set[tuple[int, int]],\n    rect: tuple[int, int, int, int],\n) -> bool:\n    r0, c0, r1, c1 = rect\n\n    for r, c in missing:\n        distances = [r - r0, r1 - r, c - c0, c1 - c]\n        if distances.count(min(distances)) != 1:\n            return False\n\n    for r, c in outside:\n        side_count = int(r < r0) + int(r > r1) + int(c < c0) + int(c > c1)\n        if side_count != 1:\n            return False\n        if r < r0:\n            inner = (r + 1, c)\n        elif r > r1:\n            inner = (r - 1, c)\n        elif c < c0:\n            inner = (r, c + 1)\n        else:\n            inner = (r, c - 1)\n        if inner not in object_cells:\n            return False\n\n    return True\n\n\ndef _core_rect(coords: np.ndarray) -> tuple[int, int, int, int]:\n    object_cells = {tuple(map(int, p)) for p in coords}\n    r0, c0 = map(int, coords.min(axis=0))\n    r1, c1 = map(int, coords.max(axis=0))\n\n    candidates = []\n    for rr0 in (r0, r0 + 1):\n        for rr1 in (r1, r1 - 1):\n            for cc0 in (c0, c0 + 1):\n                for cc1 in (c1, c1 - 1):\n                    if rr0 > rr1 or cc0 > cc1:\n                        continue\n                    rect_cells = {\n                        (r, c)\n                        for r in range(rr0, rr1 + 1)\n                        for c in range(cc0, cc1 + 1)\n                    }\n                    missing = rect_cells - object_cells\n                    outside = object_cells - rect_cells\n                    rect = (rr0, cc0, rr1, cc1)\n                    if not _valid_core_rect(object_cells, missing, outside, rect):\n                        continue\n                    score = (len(missing) + len(outside), -len(rect_cells))\n                    candidates.append((score, rect))\n\n    assert candidates\n    best_score = min(score for score, _ in candidates)\n    best_rects = [rect for score, rect in candidates if score == best_score]\n    assert len(best_rects) == 1\n    return best_rects[0]\n\n\ndef _nearest_rect_side(r: int, c: int, rect: tuple[int, int, int, int]) -> str:\n    r0, c0, r1, c1 = rect\n    distances = {\n        \"top\": r - r0,\n        \"bottom\": r1 - r,\n        \"left\": c - c0,\n        \"right\": c1 - c,\n    }\n    nearest = [side for side, dist in distances.items() if dist == min(distances.values())]\n    assert len(nearest) == 1\n    return nearest[0]\n\n\ndef _defect_bar_cells(coords: np.ndarray, rect: tuple[int, int, int, int]) -> set[tuple[int, int]]:\n    object_cells = {tuple(map(int, p)) for p in coords}\n    r0, c0, r1, c1 = rect\n    rect_cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}\n    bars = set()\n\n    for r, c in rect_cells - object_cells:\n        side = _nearest_rect_side(r, c, rect)\n        if side == \"top\":\n            bars.update({(r - 1, c), (r, c)})\n        elif side == \"bottom\":\n            bars.update({(r, c), (r + 1, c)})\n        elif side == \"left\":\n            bars.update({(r, c - 1), (r, c)})\n        else:\n            bars.update({(r, c), (r, c + 1)})\n\n    for r, c in object_cells - rect_cells:\n        if r < r0:\n            bars.update({(r, c), (r + 1, c)})\n        elif r > r1:\n            bars.update({(r - 1, c), (r, c)})\n        elif c < c0:\n            bars.update({(r, c), (r, c + 1)})\n        else:\n            assert c > c1\n            bars.update({(r, c - 1), (r, c)})\n\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n","exit_code":0,"status":"completed"}}
