{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg, paste\nimport random\n\n\ndef _marker_side(g: np.ndarray, bg: int) -> tuple[str, int]:\n    sides: list[tuple[str, int]] = []\n    for color in set(map(int, g.ravel())) - {bg}:\n        if np.all(g[0, :] == color):\n            sides.append((\"top\", color))\n        if np.all(g[:, -1] == color):\n            sides.append((\"right\", color))\n        if np.all(g[-1, :] == color):\n            sides.append((\"bottom\", color))\n        if np.all(g[:, 0] == color):\n            sides.append((\"left\", color))\n\n    assert len(sides) == 1, sides\n    return sides[0]\n\n\ndef _symbolic_grid(g: np.ndarray) -> tuple[np.ndarray, str, int]:\n    bg = get_bg(g)\n    side, marker = _marker_side(g, bg)\n    assert marker == 1, marker\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n\n    objects: list[tuple[int, int, int]] = []\n    for component in components:\n        color = component[\"color\"]\n        if color == marker:\n            continue\n\n        b = component[\"bbox\"]\n        assert component[\"area\"] == 8, component\n        assert bbox_h(b) == 3 and bbox_w(b) == 3, component\n\n        r0, c0, r1, c1 = b\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        expected = np.full((3, 3), color, dtype=int)\n        expected[1, 1] = bg\n        assert np.array_equal(patch, expected), patch\n        objects.append((r0, c0, color))\n\n    assert objects\n    rows = sorted({r for r, _c, _color in objects})\n    cols = sorted({c for _r, c, _color in objects})\n    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)\n    row_index = {r: i for i, r in enumerate(rows)}\n    col_index = {c: i for i, c in enumerate(cols)}\n\n    for r, c, color in objects:\n        rr = row_index[r]\n        cc = col_index[c]\n        assert symbolic[rr, cc] == bg\n        symbolic[rr, cc] = color\n\n    if side in (\"top\", \"bottom\"):\n        dominant_cols = range(3, 6) if side == \"top\" else range(0, 3)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in range(symbolic.shape[0])\n            for c in dominant_cols\n            if int(symbolic[r, c]) != bg\n        ]\n    else:\n        dominant_rows = range(0, 3) if side == \"left\" else range(3, 6)\n        dominant_values = [\n            int(symbolic[r, c])\n            for r in dominant_rows\n            for c in range(symbolic.shape[1])\n            if int(symbolic[r, c]) != bg\n        ]\n    assert dominant_values and set(dominant_values) == {8}, dominant_values\n\n    return symbolic, side, bg\n\n\ndef _compact(symbolic: np.ndarray, side: str, bg: int) -> np.ndarray:\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n\ndef _gen_hollow_patch(color, bg):\n    patch = np.full((GEN_SYMBOL_PATCH_SIZE, GEN_SYMBOL_PATCH_SIZE), color, dtype=int)\n    patch[GEN_SYMBOL_PATCH_SIZE // 2, GEN_SYMBOL_PATCH_SIZE // 2] = bg\n    return patch\n\n\ndef _gen_expand(symbolic, side, bg):\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n    _gen_place_marker(grid, side)\n\n    row_positions, col_positions = _gen_lattice_positions(side)\n    for r in range(symbolic.shape[0]):\n        for c in range(symbolic.shape[1]):\n            color = int(symbolic[r, c])\n            if color == bg:\n                continue\n            paste(grid, _gen_hollow_patch(color, bg), row_positions[r], col_positions[c])\n    return grid\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, components_mask\nimport random\n\nBBox = tuple[int, int, int, int]\n\n\ndef _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:\n    r0, c0, r1, c1 = bbox\n    h, w = shape\n    sides = []\n    if r0 == 0:\n        sides.append(\"top\")\n    if r1 == h - 1:\n        sides.append(\"bottom\")\n    if c0 == 0:\n        sides.append(\"left\")\n    if c1 == w - 1:\n        sides.append(\"right\")\n    assert len(sides) == 1, \"each black rectangle must touch exactly one grid edge\"\n    return sides[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n    total: int, n: int, min_size: int, max_size: int, min_gap: int = 0\n) -> list[tuple[int, int]] | None:\n    \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n    if n == 0:\n        return []\n\n    needed = n * min_size + (n - 1) * min_gap\n    if needed > total:\n        return None\n\n    effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))\n    if effective_max < min_size:\n        return None\n\n    widths = [random.randint(min_size, effective_max) for _ in range(n)]\n    total_used = sum(widths) + (n - 1) * min_gap\n    if total_used > total:\n        excess = total_used - total\n        indices = list(range(n))\n        random.shuffle(indices)\n        for i in indices:\n            shrink = min(widths[i] - min_size, excess)\n            widths[i] -= shrink\n            excess -= shrink\n            if excess == 0:\n                break\n        if excess > 0:\n            return None\n\n    remaining = total - sum(widths) - (n - 1) * min_gap\n    extra_gaps = [0] * (n + 1)\n    for _ in range(remaining):\n        extra_gaps[random.randint(0, n)] += 1\n\n    bands = []\n    pos = 0\n    for i in range(n):\n        pos += extra_gaps[i]\n        if i > 0:\n            pos += min_gap\n        bands.append((pos, pos + widths[i] - 1))\n        pos += widths[i]\n    return bands\n\n\ndef _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:\n    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)\n    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)\n    feasible = [(v, n_rects - v) for v in range(n_rects + 1)\n                if v <= max_vert and (n_rects - v) <= max_horiz]\n    if not feasible:\n        return None\n    return random.choice(feasible)\n\n\ndef _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:\n    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H\n    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W\n    if min_h > MAX_H or min_w > MAX_W:\n        return None\n    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)\n\n\ndef _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:\n    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)\n    if raw is None:\n        return None\n    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]\n\n\ndef _rect_span_for_band(band_size: int, travel: int) -> int | None:\n    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)\n    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))\n    if min_len > max_len:\n        return None\n    return random.randint(min_len, max_len)\n\n\ndef _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:\n    \"\"\"Return destination rectangles plus their original source edge.\"\"\"\n    vert_edges = [random.choice([\"top\", \"bottom\"]) for _ in range(n_vert)]\n    horiz_edges = [random.choice([\"left\", \"right\"]) for _ in range(n_horiz)]\n\n    col_bands = _interior_bands(W, n_vert)\n    if col_bands is None:\n        return None\n    row_bands = _interior_bands(H, n_horiz)\n    if row_bands is None:\n        return None\n\n    rects = []\n    for i, (c0, c1) in enumerate(col_bands):\n        rect_w = c1 - c0 + 1\n        rect_h = _rect_span_for_band(rect_w, H)\n        if rect_h is None:\n            return None\n        se = vert_edges[i]\n        if se == \"top\":\n            dr0, dr1 = H - rect_h, H - 1\n        else:\n            dr0, dr1 = 0, rect_h - 1\n        rects.append((dr0, c0, dr1, c1, se))\n\n    for i, (r0, r1) in enumerate(row_bands):\n        rect_h = r1 - r0 + 1\n        rect_w = _rect_span_for_band(rect_h, W)\n        if rect_w is None:\n            return None\n        se = horiz_edges[i]\n        if se == \"left\":\n            dc0, dc1 = W - rect_w, W - 1\n        else:\n            dc0, dc1 = 0, rect_w - 1\n        rects.append((r0, dc0, r1, dc1, se))\n\n    return rects\n\n\ndef _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:\n    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)\n\n\ndef _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:\n    output = _random_background((H, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            output[:, dc0:dc1 + 1] = BG_ORANGE\n        else:\n            output[dr0:dr1 + 1, :] = BG_ORANGE\n\n    for (dr0, dc0, dr1, dc1, _) in rects:\n        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0\n    return output\n\n\ndef _invert_output_to_input(\n    output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float\n) -> np.ndarray:\n    H, W = output.shape\n    inp = output.copy()\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)\n        else:\n            inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1\n        if se == \"top\":\n            inp[0:rh, dc0:dc1 + 1] = 0\n        elif se == \"bottom\":\n            inp[H - rh:H, dc0:dc1 + 1] = 0\n        elif se == \"left\":\n            inp[dr0:dr1 + 1, 0:rw] = 0\n        else:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f41bd9c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the side-attached foreground object to the opposite wall, shear its lower rows inward, and paint the crossed floor cells.\n\n    Input structure:\n    - The top row is the upper background color and the bottom row is the\n      floor color.\n    - A single non-background, non-floor object touches exactly one vertical\n      grid edge and rests immediately above the first solid floor row.\n\n    Rule:\n    - Clear the source object to the upper background color.\n    - Repaint each object row on the opposite side: the first three relative\n      rows keep the edge alignment, and each lower row shifts one more pixel\n      inward from that side.\n    - On the first floor row, repaint the traversed side-to-object segment\n      maroon, stopping just before the final outer bottom support pixel.\n\n    Key insight:\n    - The side of the source object gives the horizontal direction, while the\n      row index inside the object gives the one-cell-per-row diagonal shear.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"grid must be two-dimensional\"\n    height, width = g.shape\n\n    top_colors = np.unique(g[0])\n    bottom_colors = np.unique(g[-1])\n    assert len(top_colors) == 1, \"top row must be a uniform background\"\n    assert len(bottom_colors) == 1, \"bottom row must be a uniform floor\"\n    bg = int(top_colors[0])\n    floor = int(bottom_colors[0])\n    assert bg != floor, \"background and floor colors must differ\"\n\n    colors = set(map(int, np.unique(g)))\n    assert len(colors) == 3, \"expected exactly background, floor, and one object color\"\n    object_colors = colors - {bg, floor}\n    assert len(object_colors) == 1, \"expected one moving object color\"\n    obj = object_colors.pop()\n\n    full_floor_rows = np.where(np.all(g == floor, axis=1))[0]\n    assert len(full_floor_rows) > 0, \"expected a solid floor row\"\n    floor_row = int(full_floor_rows[0])\n    assert 0 < floor_row < height, \"floor row must be inside the grid\"\n    assert np.all(g[floor_row:] == floor), \"floor must be a solid bottom band\"\n\n    obj_coords = np.argwhere(g == obj)\n    assert len(obj_coords) > 0, \"expected a moving object\"\n    r0, c0, r1, c1 = bbox_coords(obj_coords)\n    object_width = c1 - c0 + 1\n    assert r1 == floor_row - 1, \"object must rest directly above the floor\"\n    assert (c0 == 0) ^ (c1 == width - 1), \"object must touch exactly one side edge\"\n    assert np.all(g[:floor_row][g[:floor_row] != obj] == bg), \"upper region must contain only bg and object\"\n\n    moving_right = c0 == 0\n    out = g.copy()\n    out[g == obj] = bg\n\n    for r in range(r0, r1 + 1):\n        rel_r = r - r0\n        rel_cols = np.where(g[r, c0 : c1 + 1] == obj)[0]\n        assert len(rel_cols) > 0, \"every object bbox row must contain object pixels\"\n\n        inward_shift = max(0, rel_r - 2)\n        if moving_right:\n            start_col = width - object_width - inward_shift\n        else:\n            start_col = inward_shift\n        dst_cols = start_col + rel_cols\n        assert int(dst_cols.min()) >= 0 and int(dst_cols.max()) < width, \"moved object must fit in the grid\"\n        out[r, dst_cols] = obj\n\n    bottom_rel_cols = np.where(g[r1, c0 : c1 + 1] == obj)[0]\n    bottom_shift = max(0, r1 - r0 - 2)\n    bottom_start = width - object_width - bottom_shift if moving_right else bottom_shift\n    final_bottom_cols = bottom_start + bottom_rel_cols\n    trail_color = Color.MAROON\n    assert int(trail_color) not in colors, \"trail color must be new\"\n    if moving_right:\n        trail_end = int(final_bottom_cols.max()) - 1\n        assert trail_end >= 0, \"trail must cover at least one floor pixel\"\n        out[floor_row, : trail_end + 1] = int(trail_color)\n    else:\n        trail_start = int(final_bottom_cols.min()) + 1\n        assert trail_start < width, \"trail must cover at least one floor pixel\"\n        out[floor_row, trail_start:] = int(trail_color)\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Canvas and band bounds.\nGRID_ROWS = range(16, 19)\nGRID_COLS = (16, 18)\nFLOOR_THICKNESS = range(4, 7)\nEMPTY_ROWS = range(3, 7)\n# Object shape and fit constraints.\nOBJECT_WIDTH = 5\nOBJECT_HEIGHT = (5, 11)\nSOLID_TOP_ROWS = 2\nSHEAR_LOCK_ROWS = 3\nCHECKER_COLS = (0, 2, 4)\n# Colors and retry budget.\nTRAIL_COLOR = int(Color.MAROON)\nAVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]\nMAX_GENERATION_ATTEMPTS = 300\nSIDES = (\"left\", \"right\")\n\nROW_LAYOUTS = [\n    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)\n    for rows in GRID_ROWS\n    for floor_thick in FLOOR_THICKNESS\n    for empty_rows in EMPTY_ROWS\n    if OBJECT_HEIGHT[0] <= rows - floor_thick - empty_rows <= OBJECT_HEIGHT[1]\n]\n\n\ndef _gen_object_mask(height: int) -> np.ndarray:\n    mask = np.zeros((height, OBJECT_WIDTH), dtype=bool)\n    mask[:SOLID_TOP_ROWS, :] = True\n    mask[SOLID_TOP_ROWS:, CHECKER_COLS] = True\n    return mask\n\n\ndef _gen_place_original(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> None:\n    c0 = 0 if side == \"left\" else grid.shape[1] - mask.shape[1]\n    region = grid[top : top + mask.shape[0], c0 : c0 + mask.shape[1]]\n    region[mask] = color\n\n\ndef _gen_place_sheared(\n    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray\n) -> np.ndarray:\n    width = grid.shape[1]\n    bottom_cols = []\n    for rel_r in range(mask.shape[0]):\n        rel_cols = np.flatnonzero(mask[rel_r])\n        inward_shift = max(0, rel_r - SHEAR_LOCK_ROWS + 1)\n        c0 = width - mask.shape[1] - inward_shift if side == \"right\" else inward_shift\n        dst_cols = c0 + rel_cols\n        grid[top + rel_r, dst_cols] = color\n        bottom_cols = dst_cols\n    return bottom_cols\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    height, floor_thick, empty_rows, obj_h = random.choice(ROW_LAYOUTS)\n    width = random.randint(*GRID_COLS)\n    if OBJECT_WIDTH + max(0, obj_h - SHEAR_LOCK_ROWS) > width:\n        return None\n\n    bg, floor, obj = random.sample(AVAILABLE_COLORS, 3)\n    floor_row = height - floor_thick\n    obj_mask = _gen_object_mask(obj_h)\n    dst_side = random.choice(SIDES)\n    src_side = \"right\" if dst_side == \"left\" else \"left\"\n\n    out = np.full((height, width), bg, dtype=int)\n    out[floor_row:, :] = floor\n    bottom_cols = _gen_place_sheared(out, empty_rows, dst_side, obj, obj_mask)\n    if dst_side == \"right\":\n        out[floor_row, : int(bottom_cols.max())] = TRAIL_COLOR\n    else:\n        out[floor_row, int(bottom_cols.min()) + 1 :] = TRAIL_COLOR\n\n    inp = out.copy()\n    inp[inp == obj] = bg\n    inp[floor_row, inp[floor_row] == TRAIL_COLOR] = floor\n    _gen_place_original(inp, empty_rows, src_side, obj, obj_mask)\n\n    return inp if np.array_equal(main(inp), out) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg, is_contiguous, object_interior\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n\n    Input structure:\n    - The grid has a dominant background color.\n    - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n    - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n\n    Rule:\n    - Keep the input pixels unchanged.\n    - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n    - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n\n    Key insight:\n    - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    out = g.copy()\n    h, w = g.shape\n\n    markers: dict[int, int] = {}\n    marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n            continue\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n        assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n        assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n        source = int(sub[0, 0])\n        halo = int(sub[0, 1])\n        assert source != halo, \"legend source and halo colors must differ\"\n        assert source not in markers, \"each source color must have exactly one legend marker\"\n\n        markers[source] = halo\n        marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n\n    assert markers, \"expected at least one left-edge legend marker\"\n\n    for source, halo in markers.items():\n        objects = []\n        for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n            cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n            if cells <= marker_source_cells[source]:\n                continue\n            objects.append(comp)\n        assert objects, \"each legend source color must label at least one non-marker object\"\n\n        for obj in objects:\n            r0, c0, r1, c1 = obj[\"bbox\"]\n            pr0 = max(0, int(r0) - 1)\n            pc0 = max(0, int(c0) - 1)\n            pr1 = min(h - 1, int(r1) + 1)\n            pc1 = min(w - 1, int(c1) + 1)\n\n            patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n            coords = obj[\"coords\"]\n            patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n            enclosed = object_interior(patch, background=bg)\n            fill_mask = (patch == bg) & ~enclosed\n\n            input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n            assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n            assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n            target[fill_mask] = halo\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and color palette.\nBACKGROUND = 0\nGRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\nAVAILABLE_COLORS = tuple(range(1, 10))\n\n# Legend layout.\nLEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\nLEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n\n# Sprite geometry and acceptance.\nSPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\nSPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\nSPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\nSPRITE_RETRIES = 300\n\n# Object counts and placement.\nINSTANCE_MIN, INSTANCE_MAX = 1, 3\nOBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\nEDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\nPLACEMENT_RETRIES = 200\n\n# Whole-sample retry budget.\nGENERATION_RETRIES = 300\n\n\ndef _make_sprite(color):\n    \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n    target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n    for _ in range(SPRITE_RETRIES):\n        fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n        sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n        for r in range(SPRITE_SIZE):\n            for c in range(SPRITE_MIRROR_COLS):\n                if random.random() < fill_p:\n                    sprite[r, c] = color\n                    sprite[r, SPRITE_SIZE - 1 - c] = color\n        area = int(np.count_nonzero(sprite))\n        if area != target_area:\n            continue\n        if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n            continue\n        if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n                np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n            continue\n        padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n        padded[1:-1, 1:-1] = sprite\n        interior = object_interior(padded, background=BACKGROUND)\n        holes = int(np.sum(interior & (padded == BACKGROUND)))\n        if holes > MAX_INTERIOR_HOLES:\n            continue\n        return sprite\n    return None\n\n\ndef _boxes_overlap(a, b):\n    return a[0] <= b[2] and a[2] >= b[0] and a[1] <= b[3] and a[3] >= b[1]\n\n\ndef _draw_legend(grid, src1, halo1, src2, halo2):\n    lower_top = grid.shape[0] - LEGEND_MARKER_SIZE\n    upper_top = lower_top - LEGEND_VERTICAL_GAP - LEGEND_MARKER_SIZE\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src1\n    grid[upper_top:upper_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo1\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_SOURCE_COL] = src2\n    grid[lower_top:lower_top + LEGEND_MARKER_SIZE, LEGEND_HALO_COL] = halo2\n    return (upper_top, LEGEND_SOURCE_COL, grid.shape[0] - 1, LEGEND_HALO_COL)\n\n\ndef _visible_window(sprite, size, r0, c0):\n    \"\"\"Return the visible grid bbox and matching sprite slice for a possibly clipped sprite.\"\"\"\n    vr0, vc0 = max(0, r0), max(0, c0)\n    vr1 = min(size - 1, r0 + SPRITE_SIZE - 1)\n    vc1 = min(size - 1, c0 + SPRITE_SIZE - 1)\n    visible = sprite[vr0 - r0:vr1 - r0 + 1, vc0 - c0:vc1 - c0 + 1]\n    return (vr0, vc0, vr1, vc1), visible\n\n\ndef _padded_bbox(visible_box, size):\n    vr0, vc0, vr1, vc1 = visible_box\n    return (max(0, vr0 - HALO_PADDING), max(0, vc0 - HALO_PADDING),\n            min(size - 1, vr1 + HALO_PADDING), min(size - 1, vc1 + HALO_PADDING))\n\n\ndef _place_objects(size, tasks, legend_box):\n    \"\"\"Choose non-overlapping object origins; returns placement tuples or None on retry exhaustion.\"\"\"\n    placed = []\n    placements = []\n    for sprite, sc, hc in tasks:\n        for _ in range(PLACEMENT_RETRIES):\n            if random.random() < EDGE_CLIP_PROB:\n                r0 = random.randint(-EDGE_CLIP_MARGIN, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE + EDGE_CLIP_MARGIN)\n            else:\n                r0 = random.randint(0, size - SPRITE_SIZE)\n                c0 = random.randint(OBJECT_MIN_COL, size - SPRITE_SIZE)\n            visible_box, visible = _visible_window(sprite, size, r0, c0)\n            if np.count_nonzero(visible) == 0:\n                continue\n\n            pbox = _padded_bbox(visible_box, size)\n            if (pbox[1] < OBJECT_MIN_COL or _boxes_overlap(pbox, legend_box) or\n                    any(_boxes_overlap(pbox, eb) for eb in placed)):\n                continue\n\n            placed.append(pbox)\n            placements.append((sprite, sc, hc, r0, c0))\n            break\n        else:\n            return None\n    return placements\n\n\ndef _render_output(grid, placements):\n    \"\"\"Render the paired output and return the generated input with halo-fill cells removed.\"\"\"\n    size = grid.shape[0]\n    output = grid.copy()\n    halo_mask = np.zeros((size, size), dtype=bool)\n\n    for sprite, sc, hc, r0, c0 in placements:\n        visible_box, visible = _visible_window(sprite, size, r0, c0)\n        vr0, vc0, vr1, vc1 = visible_box\n        output_region = output[vr0:vr1 + 1, vc0:vc1 + 1]\n        output_region[visible != BACKGROUND] = sc\n\n        pr0, pc0, pr1, pc1 = _padded_bbox(visible_box, size)\n        patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=int)\n        patch_region = patch[vr0 - pr0:vr1 - pr0 + 1, vc0 - pc0:vc1 - pc0 + 1]\n        patch_region[visible != BACKGROUND] = sc\n\n        enclosed = object_interior(patch, background=BACKGROUND)\n        fill = (patch == BACKGROUND) & ~enclosed\n        output_region = output[pr0:pr1 + 1, pc0:pc1 + 1]\n        output_region[fill] = hc\n        halo_region = halo_mask[pr0:pr1 + 1, pc0:pc1 + 1]\n        halo_region[fill] = True\n\n    inp = output.copy()\n    inp[halo_mask] = BACKGROUND\n    return inp, output\n\n\ndef _matches_oracle(inp, output):\n    try:\n        return np.array_equal(main(inp), output)\n    except Exception:\n        return False\n\n\ndef _gen_attempt():\n    sz = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    colors = list(AVAILABLE_COLORS)\n    random.shuffle(colors)\n    src1, halo1, src2, halo2 = colors[:4]\n\n    sprite1 = _make_sprite(src1)\n    sprite2 = _make_sprite(src2)\n    if sprite1 is None or sprite2 is None:\n        return None\n\n    n1 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    n2 = random.randint(INSTANCE_MIN, INSTANCE_MAX)\n    tasks = [(sprite1, src1, halo1)] * n1 + [(sprite2, src2, halo2)] * n2\n    random.shuffle(tasks)\n\n    grid = np.zeros((sz, sz), dtype=int)\n    legend_box = _draw_legend(grid, src1, halo1, src2, halo2)\n\n    placements = _place_objects(sz, tasks, legend_box)\n    if placements is None:\n        return None\n\n    inp, output = _render_output(grid, placements)\n    if _matches_oracle(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
