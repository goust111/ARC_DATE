{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/eval/7b0280bc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the shortest path between two terminal squares in a square-and-track graph.\n\n    Input structure:\n    - bg = most common color.\n    - Two non-bg colors form solid NxN squares (N>=2): one color marks exactly 2 terminals, the other marks stations.\n    - A third non-bg color forms 1-cell-wide track segments connecting pairs of squares (graph edges).\n\n    Rule:\n    - Find the shortest path (fewest edges) between the two terminal squares.\n    - Recolor every station square on that path to green.\n    - Recolor every track segment along that path to grey.\n    - Everything else unchanged.\n\n    Key insight: The grid encodes a graph where squares are nodes and tracks are edges; the task is graph shortest-path, not spatial proximity.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # --- detect solid squares (nodes) and infer the dominant size N ---\n    square_cands = find_solid_squares(g, bg=bg, min_size=2, connectivity=8)\n    assert not (not square_cands)\n\n    size_counts = Counter([int(d[\"size\"]) for d in square_cands])\n    N = int(max(size_counts.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n    nodes_raw = [d for d in square_cands if int(d[\"size\"]) == int(N)]\n\n    nodes: list[dict] = []\n    for i, d in enumerate(nodes_raw):\n        pts = {(int(r), int(c)) for r, c in d[\"coords\"]}\n        nodes.append({\"id\": int(i), \"color\": int(d[\"color\"]), \"pts\": pts})\n\n    nodes_by_color: dict[int, list[int]] = defaultdict(list)\n    for nd in nodes:\n        nodes_by_color[int(nd[\"color\"])].append(int(nd[\"id\"]))\n\n    node_colors = sorted(nodes_by_color.keys())\n    assert not (len(node_colors) < 2)\n\n    terminal_color = None\n    station_color = None\n    for col in node_colors:\n        if len(nodes_by_color[int(col)]) == 2:\n            terminal_color = int(col)\n        else:\n            station_color = int(col)\n    assert not (terminal_color is None or station_color is None)\n    term_ids = list(map(int, nodes_by_color[int(terminal_color)]))\n\n    # Track color is the remaining non-bg color (not a node color).\n    non_bg_colors = colors_present(g, exclude={bg})\n    track_candidates = [c for c in non_bg_colors if int(c) not in (int(terminal_color), int(station_color))]\n    assert not (not track_candidates)\n    track_color = int(max(track_candidates, key=lambda c: int((g == int(c)).sum())))\n\n    # --- build node lookup ---\n    pix2node: dict[tuple[int, int], int] = {}\n    id2pts: dict[int, set[tuple[int, int]]] = {}\n    for nd in nodes:\n        nid = int(nd[\"id\"])\n        pts = set(nd[\"pts\"])\n        id2pts[nid] = pts\n        for p in pts:\n            pix2node[p] = nid\n\n    # --- build edges from track components that touch exactly 2 nodes (8-adjacency) ---\n    track_comps = components_mask(g == int(track_color), connectivity=8)\n    track_comp_pts: dict[int, list[tuple[int, int]]] = {}\n    adj: dict[int, list[tuple[int, int]]] = defaultdict(list)  # node -> [(neighbor, edge_id)]\n\n    for edge_id, coords in enumerate(track_comps, start=1):\n        pts = [(int(r), int(c)) for r, c in coords]\n        if not pts:\n            continue\n        touched: set[int] = set()\n        for r, c in pts:\n            for rr, cc in neighbors8(int(r), int(c)):\n                nid = pix2node.get((int(rr), int(cc)))\n                if nid is not None:\n                    touched.add(int(nid))\n        if len(touched) != 2:\n            continue\n        a, b = sorted(touched)\n        track_comp_pts[int(edge_id)] = pts\n        adj[int(a)].append((int(b), int(edge_id)))\n        adj[int(b)].append((int(a), int(edge_id)))\n\n    # --- shortest path between terminals (BFS by edge count) ---\n    start, goal = int(term_ids[0]), int(term_ids[1])\n    q = deque([start])\n    prev: dict[int, int | None] = {start: None}\n    prev_edge: dict[int, int | None] = {start: None}\n\n    while q:\n        u = int(q.popleft())\n        if u == goal:\n            break\n        for v, eid in adj.get(u, []):\n            if int(v) in prev:\n                continue\n            prev[int(v)] = int(u)\n            prev_edge[int(v)] = int(eid)\n            q.append(int(v))\n\n    assert not (goal not in prev)\n\n    node_path: list[int] = []\n    edge_path: list[int] = []\n    cur = int(goal)\n    while cur is not None:\n        node_path.append(int(cur))\n        e = prev_edge.get(int(cur))\n        if e is not None:\n            edge_path.append(int(e))\n        cur2 = prev.get(int(cur))\n        cur = int(cur2) if cur2 is not None else None\n    node_path.reverse()\n    edge_path.reverse()\n\n    # --- apply recolors in-place ---\n    out = g.copy()\n\n    term_set = set(map(int, term_ids))\n    for nid in node_path:\n        if int(nid) in term_set:\n            continue\n        for r, c in id2pts[int(nid)]:\n            out[int(r), int(c)] = int(Color.GREEN)\n\n    for eid in edge_path:\n        for r, c in track_comp_pts.get(int(eid), []):\n            out[int(r), int(c)] = int(Color.GREY)\n\n    return out\n\n# --------------- generator (Claude attempt 1) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\nNODE_SIZE_CHOICES = [2, 3]               # N for NxN node squares\nNODE_COUNT_RANGE = (7, 10)               # V = total graph nodes (2 terminal + rest station)\nCYCLE_COUNT_CHOICES = [1, 2]             # independent cycles in the graph\nPATH_LEN_CHOICES = [2, 3]               # shortest-path edge count between terminals\nGAP_CHOICES = [2, 3]                     # gap between node square edge and cell boundary\nCELL_GRID_DIMS = (3, 4, 5)              # candidate Kr, Kc values for the cell grid\nGRID_SIZE_RANGE = (15, 30)               # canvas side length S bounds\nCOLOR_POOL = [0, 1, 2, 4, 6, 7, 8, 9]   # eligible colors (excludes green=3, grey=5)\nCELL_PICK_RETRIES = 50                   # retries for _pick_cells connectivity check\nGEN_ATTEMPT_RETRIES = 300                # outer retry limit in generate_input\n\n\ndef _compute_adjacency(picked: set[tuple[int, int]], use_diagonal: bool, allow_skip: bool):\n    \"\"\"\n    Compute valid undirected edges between picked cells on a grid.\n\n    Always includes cardinal distance-1 neighbors.  Optionally includes:\n    - allow_skip: cardinal distance-2 when the intermediate cell is empty.\n    - use_diagonal: diagonal distance-1 when both perpendicular cells are empty.\n    \"\"\"\n    edges = set()\n    for (i, j) in picked:\n        for (di, dj) in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            n = (i + di, j + dj)\n            if n in picked:\n                edges.add(tuple(sorted([(i, j), n])))\n        if allow_skip:\n            for (di, dj) in [(-2, 0), (2, 0), (0, -2), (0, 2)]:\n                mid = (i + di // 2, j + dj // 2)\n                far = (i + di, j + dj)\n                if far in picked and mid not in picked:\n                    edges.add(tuple(sorted([(i, j), far])))\n        if use_diagonal:\n            for (di, dj) in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n                n = (i + di, j + dj)\n                corner1 = (i + di, j); corner2 = (i, j + dj)\n                if n in picked and corner1 not in picked and corner2 not in picked:\n                    edges.add(tuple(sorted([(i, j), n])))\n    return edges\n\n\ndef _pick_cells(Kr: int, Kc: int, V: int, rng: random.Random,\n                use_diagonal: bool, allow_skip: bool):\n    \"\"\"Pick V cells on a Kr x Kc grid ensuring the induced adjacency graph is connected.\"\"\"\n    cells = [(i, j) for i in range(Kr) for j in range(Kc)]\n    if len(cells) < V:\n        return None\n    for _ in range(CELL_PICK_RETRIES):\n        rng.shuffle(cells)\n        picked = set(cells[:V])\n        edges = _compute_adjacency(picked, use_diagonal=use_diagonal, allow_skip=allow_skip)\n        adj = {c: [] for c in picked}\n        for (a, b) in edges:\n            adj[a].append(b); adj[b].append(a)\n        root = next(iter(picked))\n        seen = {root}; stack = [root]\n        while stack:\n            u = stack.pop()\n            for v in adj[u]:\n                if v not in seen:\n                    seen.add(v); stack.append(v)\n        if len(seen) == V:\n            return picked\n    return None\n\n\ndef _bfs_with_counts(src: int, allowed: set, V: int):\n    \"\"\"BFS from src over allowed edges.  Returns (dist, count, adj_list) dicts.\n\n    dist[v] = shortest distance from src; count[v] = number of shortest paths.\n    \"\"\"\n    adj = {i: [] for i in range(V)}\n    for (a, b) in allowed:\n        adj[a].append(b); adj[b].append(a)\n    dist = {src: 0}; cnt = {src: 1}; q = deque([src])\n    while q:\n        u = q.popleft()\n        for v in adj[u]:\n            if v not in dist:\n                dist[v] = dist[u] + 1; cnt[v] = cnt[u]; q.append(v)\n            elif dist[v] == dist[u] + 1:\n                cnt[v] += cnt[u]\n    return dist, cnt, adj\n\n\ndef _build_graph_spatial(picked: set[tuple[int, int]], cell_to_id: dict, rng: random.Random,\n                         path_len: int, n_cycles: int, use_diagonal: bool, allow_skip: bool):\n    \"\"\"\n    Build an edge-subgraph on spatial adjacencies of the picked cells.\n\n    Selects two terminals (remapped to ids 0 and V-1), constructs a spanning tree seeded\n    from the unique shortest path of `path_len` edges, then adds `n_cycles` extra edges\n    that preserve shortest-path uniqueness.  Returns (edges, path_nodes, path_edges,\n    remapped_cell_to_id) or None on failure.\n    \"\"\"\n    V = len(picked)\n    cell_edges = _compute_adjacency(picked, use_diagonal=use_diagonal, allow_skip=allow_skip)\n    full_edges = {tuple(sorted((cell_to_id[a], cell_to_id[b]))) for (a, b) in cell_edges}\n\n    # Pick 2 distinct node ids as terminals\n    ids = list(range(V))\n    rng.shuffle(ids)\n    t0, t1 = ids[0], ids[1]\n\n    dist, cnt, adj = _bfs_with_counts(t0, full_edges, V)\n    if t1 not in dist or dist[t1] != path_len:\n        return None\n\n    # Trace one shortest path t0 -> t1\n    parent = {t0: None}; q = deque([t0]); seen = {t0}\n    while q:\n        u = q.popleft()\n        if u == t1:\n            break\n        for v in adj[u]:\n            if v not in seen:\n                seen.add(v); parent[v] = u; q.append(v)\n    cur = t1; sp_nodes = []\n    while cur is not None:\n        sp_nodes.append(cur); cur = parent[cur]\n    sp_nodes.reverse()\n    sp_edges = {tuple(sorted((sp_nodes[i], sp_nodes[i + 1]))) for i in range(len(sp_nodes) - 1)}\n\n    # Build spanning tree seeded from the shortest path, expanding via BFS\n    tree_edges = set(sp_edges)\n    in_tree = set(sp_nodes)\n    frontier = list(sp_nodes)\n    while in_tree != set(range(V)):\n        next_frontier = []\n        for u in frontier:\n            for v in adj[u]:\n                if v not in in_tree:\n                    tree_edges.add(tuple(sorted((u, v))))\n                    in_tree.add(v)\n                    next_frontier.append(v)\n        if not next_frontier:\n            return None\n        frontier = next_frontier\n\n    # Add n_cycles extra edges that preserve shortest-path uniqueness\n    extra_candidates = list(full_edges - tree_edges)\n    rng.shuffle(extra_candidates)\n    final_edges = set(tree_edges)\n    added = 0\n    for e in extra_candidates:\n        if added >= n_cycles:\n            break\n        cand = final_edges | {e}\n        dist2, cnt2, _ = _bfs_with_counts(t0, cand, V)\n        if dist2.get(t1) == path_len and cnt2.get(t1) == 1:\n            final_edges.add(e); added += 1\n    if added != n_cycles:\n        return None\n\n    # Final verification\n    dist3, cnt3, _ = _bfs_with_counts(t0, final_edges, V)\n    if dist3.get(t1) != path_len or cnt3.get(t1) != 1:\n        return None\n    if len(final_edges) != V - 1 + n_cycles:\n        return None\n\n    # Remap node ids: 0 = t0, V-1 = t1, others fill 1..V-2\n    id_map = {t0: 0, t1: V - 1}\n    for idx, i in enumerate(i for i in range(V) if i != t0 and i != t1):\n        id_map[i] = idx + 1\n    remapped_edges = {tuple(sorted((id_map[a], id_map[b]))) for (a, b) in final_edges}\n    remapped_cell_to_id = {cell: id_map[cell_to_id[cell]] for cell in cell_to_id}\n    new_path_nodes = [id_map[n] for n in sp_nodes]\n    new_path_edges = [tuple(sorted((new_path_nodes[i], new_path_nodes[i + 1])))\n                      for i in range(len(new_path_nodes) - 1)]\n\n    return list(remapped_edges), new_path_nodes, new_path_edges, remapped_cell_to_id\n\n\n# ---------------------------------------------------------------------------\n# Spatial layout: placing squares and routing tracks\n# ---------------------------------------------------------------------------\n\ndef _cell_to_square_pos(cell: tuple[int, int], N: int, cell_size: int, origin: tuple[int, int]):\n    \"\"\"Top-left corner of the NxN square centered in the given cell.\"\"\"\n    i, j = cell\n    or_r, or_c = origin\n    margin = (cell_size - N) // 2\n    return (or_r + i * cell_size + margin, or_c + j * cell_size + margin)\n\n\ndef _dock_tl(sq_r: int, sq_c: int, N: int, Wt: int, si: int, sj: int):\n    \"\"\"Top-left of the Wt x Wt footprint docked to one face of an NxN square.\n\n    The face is determined by the outgoing direction (si, sj).  Staggered offsets\n    prevent two cardinal tracks from becoming 8-adjacent at a shared node corner:\n      up    (si=-1): left-aligned columns\n      down  (si=+1): right-aligned columns\n      left  (sj=-1): bottom-aligned rows\n      right (sj=+1): top-aligned rows\n    \"\"\"\n    if si == -1:\n        return sq_r - Wt, sq_c\n    elif si == 1:\n        return sq_r + N, sq_c + N - Wt\n    elif sj == -1:\n        return sq_r + N - Wt, sq_c - Wt\n    elif sj == 1:\n        return sq_r, sq_c + N\n    return None\n\n\ndef _walk_footprints(sr: int, sc: int, er: int, ec: int):\n    \"\"\"Generate the sequence of footprint top-left positions from (sr,sc) to (er,ec).\n\n    Steps diagonally first, then along the remaining axis.\n    \"\"\"\n    pts = [(sr, sc)]\n    cr, cc = sr, sc\n    while cr != er and cc != ec:\n        cr += 1 if er > cr else -1\n        cc += 1 if ec > cc else -1\n        pts.append((cr, cc))\n    while cr != er:\n        cr += 1 if er > cr else -1\n        pts.append((cr, cc))\n    while cc != ec:\n        cc += 1 if ec > cc else -1\n        pts.append((cr, cc))\n    return pts\n\n\ndef _track_between_cells(cell_a: tuple[int, int], cell_b: tuple[int, int],\n                         pos_a: tuple[int, int], pos_b: tuple[int, int], N: int,\n                         rng: random.Random) -> list[tuple[int, int]]:\n    \"\"\"Route a (N-1)-wide track strip between two node squares.\n\n    Returns list of (r, c) track pixels.  The track walks Wt x Wt footprints from\n    square A's exit dock to square B's entry dock.\n    \"\"\"\n    Wt = N - 1\n    ra, ca = pos_a; rb, cb = pos_b\n    dci, dcj = cell_b[0] - cell_a[0], cell_b[1] - cell_a[1]\n    si = 0 if dci == 0 else (1 if dci > 0 else -1)\n    sj = 0 if dcj == 0 else (1 if dcj > 0 else -1)\n\n    sr, sc = _dock_tl(ra, ca, N, Wt, si, sj)\n    # B's entry dock uses the *opposite* direction with B's stagger convention,\n    # which is equivalent to calling _dock_tl with (-si, -sj) but using B's coordinates.\n    # The per-direction formulas for arrival match departure of the opposite face:\n    er, ec = _dock_tl(rb, cb, N, Wt, -si, -sj)\n\n    pts_tl = _walk_footprints(sr, sc, er, ec)\n\n    # Expand each footprint position into Wt x Wt pixels\n    pixels = set()\n    for r, c in pts_tl:\n        for dr in range(Wt):\n            for dc in range(Wt):\n                pixels.add((r + dr, c + dc))\n    return list(pixels)\n\n\n# ---------------------------------------------------------------------------\n# Orchestrator\n# ---------------------------------------------------------------------------\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.  Returns None on failure.\"\"\"\n    N = rng.choice(NODE_SIZE_CHOICES)\n    V = rng.randint(*NODE_COUNT_RANGE)\n    n_cycles = rng.choice(CYCLE_COUNT_CHOICES)\n    path_len = rng.choice(PATH_LEN_CHOICES)\n\n    gap = rng.choice(GAP_CHOICES)\n    cell_size = N + gap\n\n    # Find valid cell-grid dimensions\n    KrKc_options = []\n    for Kr in CELL_GRID_DIMS:\n        for Kc in CELL_GRID_DIMS:\n            if Kr * Kc < V:\n                continue\n            min_S = max(Kr, Kc) * cell_size + 2\n            if min_S > GRID_SIZE_RANGE[1]:\n                continue\n            KrKc_options.append((Kr, Kc, min_S))\n    if not KrKc_options:\n        return None\n    Kr, Kc, min_S = rng.choice(KrKc_options)\n    S = rng.randint(max(GRID_SIZE_RANGE[0], min_S), GRID_SIZE_RANGE[1])\n\n    # Pick connected cells (cardinal adjacency + skip-2)\n    use_diagonal = False\n    allow_skip = True\n    picked = _pick_cells(Kr, Kc, V, rng, use_diagonal=use_diagonal, allow_skip=allow_skip)\n    if picked is None:\n        return None\n\n    picked_list = list(picked); rng.shuffle(picked_list)\n    cell_to_id = {cell: i for i, cell in enumerate(picked_list)}\n\n    # Build graph\n    gr = _build_graph_spatial(picked, cell_to_id, rng, path_len, n_cycles,\n                              use_diagonal=use_diagonal, allow_skip=allow_skip)\n    if gr is None:\n        return None\n    edges, path_nodes, path_edges, cell_to_id = gr\n    id_to_cell = {v: k for k, v in cell_to_id.items()}\n    V = len(picked)\n\n    # Color assignment: 4 distinct colors from pool -> bg, terminal, station, track\n    pool = list(COLOR_POOL)\n    rng.shuffle(pool)\n    four = pool[:4]\n    bg = rng.choice(four)\n    rest = [c for c in four if c != bg]\n    terminal_color = rng.choice(rest)\n    rest2 = [c for c in rest if c != terminal_color]\n    station_color = rng.choice(rest2)\n    track_color = [c for c in rest2 if c != station_color][0]\n\n    # Place node squares on canvas\n    canvas = np.full((S, S), bg, dtype=int)\n    node_mask = np.zeros((S, S), dtype=bool)\n    slack_r = S - Kr * cell_size - 2\n    slack_c = S - Kc * cell_size - 2\n    origin = (1 + rng.randint(0, max(0, slack_r)), 1 + rng.randint(0, max(0, slack_c)))\n    id_to_pos = {}\n    for i in range(V):\n        cell = id_to_cell[i]\n        pos = _cell_to_square_pos(cell, N, cell_size, origin)\n        id_to_pos[i] = pos\n        color = terminal_color if i in (0, V - 1) else station_color\n        r0, c0 = pos\n        canvas[r0:r0 + N, c0:c0 + N] = color\n        node_mask[r0:r0 + N, c0:c0 + N] = True\n\n    # Route tracks between connected node pairs\n    track_mask = np.zeros((S, S), dtype=bool)\n    edge_track_pixels = {}\n    for (a, b) in edges:\n        pixels = _track_between_cells(id_to_cell[a], id_to_cell[b],\n                                      id_to_pos[a], id_to_pos[b], N, rng)\n        for (r, c) in pixels:\n            if not (0 <= r < S and 0 <= c < S):\n                return None\n            if node_mask[r, c] or track_mask[r, c]:\n                return None\n        for (r, c) in pixels:\n            canvas[r, c] = track_color\n            track_mask[r, c] = True\n        edge_track_pixels[tuple(sorted((a, b)))] = pixels\n\n    # Verify bg is still the most common color\n    if np.argmax(np.bincount(canvas.ravel())) != bg:\n        return None\n\n    # Build expected output and oracle-check against solver\n    expected = canvas.copy()\n    for gnode in path_nodes:\n        if gnode in (0, V - 1):\n            continue\n        r0, c0 = id_to_pos[gnode]\n        expected[r0:r0 + N, c0:c0 + N] = 3\n    for e in path_edges:\n        for (r, c) in edge_track_pixels[tuple(sorted(e))]:\n            expected[r, c] = 5\n\n    try:\n        actual = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main/,/''^def generate_input/p'\"' /home/lixinyu/snap/new/ARC_code/train/f8f52ecc.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect same-colored foreground components with one-cell-wide orthogonal paths around teal wall segments.\n\n    Input structure\n    - The dominant color is the background.\n    - Teal cells are fixed wall segments and are never source connectors.\n    - Other foreground colors appear as one or more 4-connected components; colors with a single component stay unchanged.\n\n    Rule\n    - For each non-background, non-teal color, read its 4-connected components in row-major order.\n    - Connect each consecutive pair by the shortest clear L-shaped path between the two components.\n    - Clear paths may pass only through background or the same color, and they preserve the previous travel axis when both bends are possible.\n\n    Key insight\n    - The output is not a global recolor: each color traces a routed chain through its own components while teal cells and other colors act as blockers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    wall = Color.TEAL\n    assert np.any(g == wall), \"expected teal wall cells\"\n\n    out = g.copy()\n    connected_color_count = 0\n    for color in _source_colors(g, bg, wall):\n        comps = [\n            comp[\"coords\"]\n            for comp in find_components(\n                g,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(comps) < 2:\n            continue\n        if len(comps) == 2 and len(comps[0]) == 1 and len(comps[1]) == 1:\n            a = tuple(map(int, comps[0][0]))\n            b = tuple(map(int, comps[1][0]))\n            if a[0] != b[0] and a[1] != b[1]:\n                h_clear = _clear(_path_cells(a, b, \"h\"), g, bg, color)\n                v_clear = _clear(_path_cells(a, b, \"v\"), g, bg, color)\n                assert not (h_clear and v_clear), \"two diagonal singleton components need a blocking obstacle\"\n\n        connected_color_count += 1\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(comps, comps[1:]):\n            path, previous_axis = _connector_path(comp_a, comp_b, out, bg, color, previous_axis)\n            for r, c in path:\n                assert int(out[r, c]) in (bg, color), \"connector collision with another color\"\n                out[r, c] = color\n\n    assert connected_color_count > 0, \"expected at least one color with multiple components\"\n    return out\n\n# --------------- generator (c) ---------------\n\nBG = Color.BLUE\nWALL = Color.TEAL\n\n# Palette.\nN_COLORS = 10\nALL_COLORS = [c for c in range(N_COLORS) if c not in (BG, WALL)]\n\n# Canvas sizing.\nMIN_ROWS = 8\nMAX_ROWS = 12\nMIN_COLS = 10\nMAX_COLS = 12\nLARGE_GRID_CONNECTABLE_THRESHOLD = 3\nLARGE_GRID_MIN_ROWS = 10\nLARGE_GRID_MIN_COLS = 11\n\n# Foreground object counts and component sizes.\nMIN_CONNECTABLE_COLORS = 1\nMAX_CONNECTABLE_COLORS = 4\nMIN_DISTRACTOR_COLORS = 0\nMAX_DISTRACTOR_COLORS = 4\nMIN_CHAIN_COMPONENTS = 2\nMAX_CHAIN_COMPONENTS = 4\nBLOB_SIZE_CHOICES = [1, 2, 3]\nBLOB_SIZE_WEIGHTS = [6, 3, 1]\n\n# Wall geometry.\nMIN_WALL_SEGMENTS = 1\nMAX_WALL_SEGMENTS = 2\nWALL_ROW_BORDER = 1\nWALL_ROW_GAP = 1\nMIN_WALL_LENGTH = 1\nMAX_WALL_LENGTH = 8\n\n# Validation and retry limits.\nBLOB_PLACEMENT_ATTEMPTS = 80\nDISTRACTOR_PLACEMENT_ATTEMPTS = 50\nGENERATION_ATTEMPTS = 300\nMAX_PATH_CELLS = 25\nMIN_BG_PCT = 79\nMAX_BG_PCT = 90\n\nAXES = (\"h\", \"v\")\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nConnectorOption = tuple[str, list[Coord], Coord, Coord]\n\n\ndef _gen_source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:\n    colors: list[int] = []\n    seen = {int(bg), int(wall)}\n    for raw in g.ravel():\n        color = int(raw)\n        if color not in seen:\n            seen.add(color)\n            colors.append(color)\n    return colors\n\n\ndef _gen_path_has_marker(\n    output: np.ndarray,\n    color: int,\n    path: list[Coord],\n    start: Coord,\n    stop: Coord,\n) -> bool:\n    endpoints = {start, stop}\n    return any((r, c) not in endpoints and int(output[r, c]) == color for r, c in path)\n\n\ndef _gen_path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:\n    r0, c0 = start\n    r1, c1 = stop\n    pts: list[Coord] = []\n\n    if first_axis == \"h\":\n        c_step = 1 if c1 >= c0 else -1\n        for c in range(c0, c1 + c_step, c_step):\n            pts.append((r0, c))\n        r_step = 1 if r1 >= r0 else -1\n        for r in range(r0 + r_step, r1 + r_step, r_step):\n            pts.append((r, c1))\n        return pts\n\n    r_step = 1 if r1 >= r0 else -1\n    for r in range(r0, r1 + r_step, r_step):\n        pts.append((r, c0))\n    c_step = 1 if c1 >= c0 else -1\n    for c in range(c0 + c_step, c1 + c_step, c_step):\n        pts.append((r1, c))\n    return pts\n\n\ndef _gen_last_axis(start: Coord, stop: Coord, first_axis: str) -> str:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n    if first_axis == \"h\":\n        return \"v\" if dr else \"h\"\n    return \"h\" if dc else \"v\"\n\n\ndef _gen_axis_priority(\n    start: Coord, stop: Coord, previous_axis: str | None\n) -> list[str]:\n    dr = abs(start[0] - stop[0])\n    dc = abs(start[1] - stop[1])\n\n    orders: list[str] = []\n    if previous_axis == \"h\" and dc:\n        orders.append(\"h\")\n    if previous_axis == \"v\" and dr:\n        orders.append(\"v\")\n\n    preferred = \"h\" if dc >= dr else \"v\"\n    if preferred not in orders:\n        orders.append(preferred)\n    other = \"v\" if preferred == \"h\" else \"h\"\n    if other not in orders:\n        orders.append(other)\n    return orders\n\n\ndef _gen_path_is_clear(canvas: np.ndarray, bg: int, color: int, path: list[Coord]) -> bool:\n    return all(int(canvas[r, c]) in (bg, color) for r, c in path)\n\n\ndef _gen_sorted_cell_pairs(comp_a, comp_b) -> list[tuple[int, int, int, int, int]]:\n    pairs: list[tuple[int, int, int, int, int]] = []\n    for a_cell in comp_a:\n        ar, ac = int(a_cell[0]), int(a_cell[1])\n        for b_cell in comp_b:\n            br, bc = int(b_cell[0]), int(b_cell[1])\n            pairs.append((abs(ar - br) + abs(ac - bc), ar, ac, br, bc))\n    pairs.sort()\n    return pairs\n\n\ndef _gen_clear_connector_options(\n    canvas: np.ndarray,\n    bg: int,\n    color: int,\n    comp_a,\n    comp_b,\n) -> list[ConnectorOption]:\n    best_dist: int | None = None\n    options: list[ConnectorOption] = []\n    seen_paths: set[tuple[Coord, ...]] = set()\n\n    for a_cell in comp_a:\n        ar, ac = int(a_cell[0]), int(a_cell[1])\n        for b_cell in comp_b:\n            br, bc = int(b_cell[0]), int(b_cell[1])\n            if ar == br and ac == bc:\n                continue\n            dist = abs(ar - br) + abs(ac - bc)\n            for first_axis in AXES:\n                if (first_axis == \"h\" and ac == bc) or (first_axis == \"v\" and ar == br):\n                    continue\n                path = _gen_path_cells((ar, ac), (br, bc), first_axis)\n                if not _gen_path_is_clear(canvas, bg, color, path):\n                    continue\n                if best_dist is None or dist < best_dist:\n                    best_dist = dist\n                    options = []\n                    seen_paths = set()\n                if dist == best_dist:\n                    key = tuple(path)\n                    if key not in seen_paths:\n                        seen_paths.add(key)\n                        options.append((first_axis, path, (ar, ac), (br, bc)))\n    return options\n\n\ndef _gen_ambiguous_component_step(\n    canvas: np.ndarray,\n    bg: int,\n    color: int,\n    comp_a,\n    comp_b,\n    previous_axis: str | None,\n) -> bool:\n    options = _gen_clear_connector_options(canvas, bg, color, comp_a, comp_b)\n    if len(options) <= 1:\n        return False\n\n    if previous_axis is not None:\n        previous_options = [option for option in options if option[0] == previous_axis]\n        if len(previous_options) == 1:\n            return False\n\n    marked_options = [\n        option\n        for option in options\n        if _gen_path_has_marker(canvas, color, option[1], option[2], option[3])\n    ]\n    return len(marked_options) != 1\n\n\ndef _gen_input_has_ambiguous_connector(inp: np.ndarray) -> bool:\n    \"\"\"Replay generator routing and reject inputs where the solver route is not unique.\"\"\"\n    bg = get_bg(inp)\n    canvas = inp.copy()\n    for color in _gen_source_colors(inp, bg, WALL):\n        components = [\n            comp[\"coords\"]\n            for comp in find_components(\n                inp,\n                bg=bg,\n                connectivity=4,\n                monochromatic=True,\n                colors=[color],\n            )\n        ]\n        components.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))\n        if len(components) < 2:\n            continue\n\n        previous_axis: str | None = None\n        for comp_a, comp_b in zip(components, components[1:]):\n            found = False\n            for _d, ar, ac, br, bc in _gen_sorted_cell_pairs(comp_a, comp_b):\n                if ar == br and ac == bc:\n                    continue\n                start = (ar, ac)\n                stop = (br, bc)\n                if _gen_ambiguous_component_step(canvas, bg, color, comp_a, comp_b, previous_axis):\n                    return True\n                for first_axis in _gen_axis_priority(start, stop, previous_axis):\n                    path = _gen_path_cells(start, stop, first_axis)\n                    if _gen_path_is_clear(canvas, bg, color, path):\n                        for pr, pc in path:\n                            canvas[pr, pc] = color\n                        previous_axis = _gen_last_axis(start, stop, first_axis)\n                        found = True\n                        break\n                if found:\n                    break\n            if not found:\n                break\n    return False\n\n\ndef _try_connect_chain(\n    output: np.ndarray, color: int, components: list[list[Coord]]\n) -> list[Coord] | None:\n    \"\"\"Try to connect sorted components with L-paths. Returns new path cells or None.\"\"\"\n    path_cells: list[Coord] = []\n    previous_axis: str | None = None\n    component_cells = {cell for comp in components for cell in comp}\n    used_route_cells: set[Coord] = set()\n\n    for i in range(len(components) - 1):\n        comp_a = np.array(components[i])\n        comp_b = np.array(components[i + 1])\n\n        found = False\n        for _d, ar, ac, br, bc in _gen_sorted_cell_pairs(comp_a, comp_b):\n            if ar == br and ac == bc:\n                continue\n            if _gen_ambiguous_component_step(output, BG, color, comp_a, comp_b, previous_axis):\n                continue\n            for first_axis in _gen_axis_priority((ar, ac), (br, bc), previous_axis):\n                path = _gen_path_cells((ar, ac), (br, bc), first_axis)\n                if any(cell in used_route_cells for cell in path):\n                    continue\n                if any(int(output[pr, pc]) == color and (pr, pc) not in component_cells for pr, pc in path):\n                    continue\n                if _gen_path_is_clear(output, BG, color, path):\n                    for pr, pc in path:\n                        if output[pr, pc] == BG:\n                            output[pr, pc] = color\n                            path_cells.append((pr, pc))\n                    used_route_cells.update(cell for cell in path if cell not in component_cells)\n                    previous_axis = _gen_last_axis((ar, ac), (br, bc), first_axis)\n                    found = True\n                    break\n            if found:\n                break\n        if not found:\n            for pr, pc in path_cells:\n                output[pr, pc] = BG\n            return None\n    return path_cells\n\n\ndef _place_blob(output: np.ndarray, color: int, size: int) -> list[Coord] | None:\n    \"\"\"Place a connected blob of given size on bg cells, not touching same color.\"\"\"\n    H, W = output.shape\n    for _ in range(BLOB_PLACEMENT_ATTEMPTS):\n        r = random.randint(0, H - 1)\n        c = random.randint(0, W - 1)\n        if output[r, c] != BG:\n            continue\n        blob = [(r, c)]\n        for _ in range(size - 1):\n            base = random.choice(blob)\n            for dr, dc in random.sample(CARDINAL_DIRS, len(CARDINAL_DIRS)):\n                nr, nc = base[0] + dr, base[1] + dc\n                if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in blob and output[nr, nc] == BG:\n                    blob.append((nr, nc))\n                    break\n        if len(blob) != size:\n            continue\n        blob_set = set(blob)\n        touches_same = any(\n            0 <= br + dr < H and 0 <= bc + dc < W\n            and (br + dr, bc + dc) not in blob_set\n            and output[br + dr, bc + dc] == color\n            for br, bc in blob for dr, dc in CARDINAL_DIRS\n        )\n        if not touches_same:\n            for br, bc in blob:\n                output[br, bc] = color\n            return blob\n    return None\n\n\ndef _choose_grid_shape(n_connectable: int) -> tuple[int, int]:\n    if n_connectable >= LARGE_GRID_CONNECTABLE_THRESHOLD:\n        return (\n            random.randint(LARGE_GRID_MIN_ROWS, MAX_ROWS),\n            random.randint(LARGE_GRID_MIN_COLS, MAX_COLS),\n        )\n    return random.randint(MIN_ROWS, MAX_ROWS), random.randint(MIN_COLS, MAX_COLS)\n\n\ndef _place_walls(output: np.ndarray) -> None:\n    \"\"\"Place horizontal teal segments with at least one clear row between chosen rows.\"\"\"\n    H, W = output.shape\n    n_walls = random.randint(MIN_WALL_SEGMENTS, MAX_WALL_SEGMENTS)\n    rows_pool = list(range(WALL_ROW_BORDER, H - WALL_ROW_BORDER))\n    random.shuffle(rows_pool)\n    for _ in range(n_walls):\n        if not rows_pool:\n            break\n        row = rows_pool.pop()\n        rows_pool = [r for r in rows_pool if abs(r - row) > WALL_ROW_GAP]\n        length = random.randint(MIN_WALL_LENGTH, min(MAX_WALL_LENGTH, W - 2))\n        c_start = random.randint(0, W - length)\n        output[row, c_start : c_start + length] = WALL\n\n\ndef _choose_palette(n_connectable: int) -> tuple[list[int], list[int]]:\n    n_distractor = random.randint(\n        MIN_DISTRACTOR_COLORS,\n        min(MAX_DISTRACTOR_COLORS, len(ALL_COLORS) - n_connectable),\n    )\n    palette = random.sample(ALL_COLORS, n_connectable + n_distractor)\n    return palette[:n_connectable], palette[n_connectable:]\n\n\ndef _gen_component_sort_key(cells: list[Coord]) -> tuple[int, int]:\n    return min(r for r, _ in cells), min(c for _, c in cells)\n\n\ndef _place_connectable_chains(output: np.ndarray, colors: list[int]) -> list[Coord] | None:\n    \"\"\"Place source components and draw their hidden output paths.\"\"\"\n    all_path_cells: list[Coord] = []\n    for color in colors:\n        n_comps = random.randint(MIN_CHAIN_COMPONENTS, MAX_CHAIN_COMPONENTS)\n        components: list[list[Coord]] = []\n        for _ in range(n_comps):\n            blob_size = random.choices(BLOB_SIZE_CHOICES, weights=BLOB_SIZE_WEIGHTS)[0]\n            blob = _place_blob(output, color, blob_size)\n            if blob is None:\n                return None\n            components.append(blob)\n\n        components.sort(key=_gen_component_sort_key)\n        path_cells = _try_connect_chain(output, color, components)\n        if path_cells is None:\n            return None\n        all_path_cells.extend(path_cells)\n    return all_path_cells\n\n\ndef _place_distractors(output: np.ndarray, colors: list[int]) -> bool:\n    H, W = output.shape\n    for color in colors:\n        for _ in range(DISTRACTOR_PLACEMENT_ATTEMPTS):\n            r = random.randint(0, H - 1)\n            c = random.randint(0, W - 1)\n            if output[r, c] == BG:\n                output[r, c] = color\n                break\n        else:\n            return False\n    return True\n\n\ndef _erase_paths(output: np.ndarray, path_cells: list[Coord]) -> np.ndarray:\n    inp = output.copy()\n    if path_cells:\n        rows, cols = zip(*path_cells)\n        inp[rows, cols] = BG\n    return inp\n\n\ndef _input_bg_pct(inp: np.ndarray) -> float:\n    return float(np.sum(inp == BG) / inp.size * 100)\n\n\ndef _solver_matches_output(inp: np.ndarray, output: np.ndarray) -> bool:\n    try:\n        return bool(np.array_equal(main(inp), output))\n    except Exception:\n        return False\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input grid.\"\"\"\n    n_connectable = random.randint(MIN_CONNECTABLE_COLORS, MAX_CONNECTABLE_COLORS)\n    H, W = _choose_grid_shape(n_connectable)\n    output = np.full((H, W), BG, dtype=int)\n\n    _place_walls(output)\n    connectable_colors, distractor_colors = _choose_palette(n_connectable)\n\n    all_path_cells = _place_connectable_chains(output, connectable_colors)\n    if all_path_cells is None or len(all_path_cells) > MAX_PATH_CELLS:\n        return None\n\n    if not _place_distractors(output, distractor_colors):\n        return None\n\n    inp = _erase_paths(output, all_path_cells)\n    if not (MIN_BG_PCT <= _input_bg_pct(inp) <= MAX_BG_PCT):\n        return None\n    if _gen_input_has_ambiguous_connector(inp):\n        return None\n    if _solver_matches_output(inp, output):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
