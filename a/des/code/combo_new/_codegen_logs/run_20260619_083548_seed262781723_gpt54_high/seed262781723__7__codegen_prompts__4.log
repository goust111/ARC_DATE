e):\n    return {'h' if info['horizontal'] else 'v' for info in module['analyses']}\n\n\ndef has_degree(module, degree):\n    return any(info['count'] == degree for info in module['analyses'])\n\n\ndef choose_modules():\n    adj_kind = random.choice(['pair_h', 'pair_v', 'mixed_pair', 'chain_h', 'chain_v'])\n    modules = [make_module(adj_kind)]\n    seen = set().union(*(module_orientations(m) for m in modules))\n    if 'h' not in seen:\n        modules.append(make_module('isolated_h'))\n    elif 'v' not in seen:\n        modules.append(make_module('isolated_v'))\n    else:\n        modules.append(make_module(random.choice(['isolated_h', 'isolated_v'])))\n\n    total = sum(len(m['objects']) for m in modules)\n    if random.random() < 0.7:\n        options = []\n        if total + 1 <= 6:\n            options += ['isolated_h', 'isolated_v']\n        if total + 2 <= 6:\n            options += ['pair_h', 'pair_v', 'mixed_pair']\n        if total + 3 <= 6:\n            options += ['chain_h', 'chain_v']\n        if options:\n            if not any(has_degree(m, 2) for m in modules):\n                chain_options = [k for k in options if k.startswith('chain')]\n                if chain_options and random.random() < 0.75:\n                    options = chain_options\n            modules.append(make_module(random.choice(options)))\n\n    return modules\n\n\ndef expand(cells, deltas):\n    out = set(cells)\n    for r, c in list(cells):\n        for dr, dc in deltas:\n            out.add((r + dr, c + dc))\n    return out\n\n\ndef place_modules(modules):\n    modules = sorted(modules, key=lambda m: (len(m['output_cells']), m['height'] * m['width']), reverse=True)\n    max_h = max(m['height'] for m in modules)\n    max_w = max(m['width'] for m in modules)\n    min_h = max(max_h + 2, 12)\n    min_w = max(max_w + 2, 12)\n    H = random.randint(min_h, 30)\n    W = random.randint(min_w, 30)\n\n    placed = []\n    input_buffer = set()\n    output_buffer = set()\n    for module in modules:\n        placed_one = False\n        row_choices = list(range(0, H - module['height'] + 1))\n        col_choices = list(range(0, W - module['width'] + 1))\n        for _ in range(PLACEMENT_ATTEMPTS):\n            r0 = random.choice(row_choices)\n            c0 = random.choice(col_choices)\n            in_cells = {(r0 + r, c0 + c) for r, c in module['input_cells']}\n            out_cells = {(r0 + r, c0 + c) for r, c in module['output_cells']}\n            if any(cell in input_buffer for cell in in_cells):\n                continue\n            if any(cell in output_buffer for cell in out_cells):\n                continue\n            placed.append((module, r0, c0))\n            input_buffer |= expand(in_cells, NEI8)\n            output_buffer |= expand(out_cells, NEI8)\n            placed_one = True\n            break\n        if not placed_one:\n            return None\n    grid = np.zeros((H, W), dtype=int)\n    n_objects = sum(len(m['objects']) for m,_,_ in placed)\n    colors = random.sample(range(1, 10), n_objects)\n    idx = 0\n    for module, r0, c0 in placed:\n        for obj in module['objects']:\n            color = colors[idx]\n            idx += 1\n            for r, c in obj:\n                grid[r0 + r, c0 + c] = color\n    return grid\n\n\ndef components(grid):\n    g = np.asarray(grid, dtype=int)\n    h,w = g.shape\n    seen = np.zeros_like(g, dtype=bool)\n    comps=[]\n    for r in range(h):\n        for c in range(w):\n            color = int(g[r,c])\n            if color == BG or seen[r,c]:\n                continue\n            q=[(r,c)]\n            seen[r,c]=True\n            cells=[]\n            while q:\n                rr,cc=q.pop()\n                cells.append((rr,cc))\n                for dr,dc in NEI4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and not seen[nr,nc] and int(g[nr,nc])==color:\n                        seen[nr,nc]=True\n                        q.append((nr,nc))\n            comps.append({'color':color,'coords':tuple(cells)})\n    return comps\n\n\ndef main(grid):\n    g=np.asarray(grid,dtype=int)\n    h,w=g.shape\n    comps=components(g)\n    id_grid=np.full((h,w),-1,dtype=int)\n    infos=[]\n    for idx,comp in enumerate(comps):\n        rows=[r for r,c in comp['coords']]\n        cols=[c for r,c in comp['coords']]\n        r0,c0,r1,c1=min(rows),min(cols),max(rows),max(cols)\n        hh=r1-r0+1; ww=c1-c0+1\n        for r,c in comp['coords']:\n            id_grid[r,c]=idx\n        infos.append({'coords':comp['coords'],'height':hh,'width':ww,'horizontal':ww>=hh})\n    adj=[set() for _ in comps]\n    for idx,info in enumerate(infos):\n        for r,c in info['coords']:\n            for dr,dc in NEI4:\n                nr,nc=r+dr,c+dc\n                if 0<=nr<h and 0<=nc<w:\n                    oid=id_grid[nr,nc]\n                    if oid\"'!=-1 and oid!=idx:\n                        adj[idx].add(int(oid))\n    out=g.copy()\n    for idx,info in enumerate(infos):\n        count=len(adj[idx])\n        dr,dc=(0,info['\"'width']) if info['horizontal'] else (info['height'],0)\n        for k in range(1,count+1):\n            for r,c in info['coords']:\n                nr,nc=r+k*dr,c+k*dc\n                if not (0<=nr<h and 0<=nc<w):\n                    raise RuntimeError('oob')\n                if out[nr,nc] not in (BG, g[r,c]):\n                    raise RuntimeError('overlap')\n                out[nr,nc]=g[r,c]\n    return out\n\n\ndef analyze(grid):\n    comps=components(grid)\n    id_grid=np.full(grid.shape,-1,dtype=int)\n    infos=[]\n    for idx,comp in enumerate(comps):\n        rows=[r for r,c in comp['coords']]\n        cols=[c for r,c in comp['coords']]\n        hh=max(rows)-min(rows)+1; ww=max(cols)-min(cols)+1\n        for r,c in comp['coords']:\n            id_grid[r,c]=idx\n        infos.append((hh,ww,set()))\n    adj=[set() for _ in infos]\n    for idx,comp in enumerate(comps):\n        for r,c in comp['coords']:\n            for dr,dc in NEI4:\n                nr,nc=r+dr,c+dc\n                if 0<=nr<grid.shape[0] and 0<=nc<grid.shape[1]:\n                    oid=id_grid[nr,nc]\n                    if oid\"'!=-1 and oid!=idx:\n                        adj[idx].add(int(oid))\n    return [(infos[i][1]>=infos[i][0], len(adj[i])) for i in range(len(infos))]\n\nsigs=set()\nfor t in range(500):\n    ok=False\n    for _ in range(GEN_ATTEMPTS):\n        mods=choose_modules()\n        grid=place_modules(mods)\n        if grid is None:\n            continue\n        try:\n            out=main(grid)\n        except Exception:\n            continue\n        feats=analyze(grid)\n        if not any(n==0 for _,n in feats):\n            continue\n        if not any(n>0 for _,n in feats):\n            continue\n        if not any(h for h,n in feats):\n            continue\n        if not any((not h) for h,n in feats):\n            continue\n        ok=True\n        sigs.add(grid.tobytes())\n        break\n    if not ok:\n        print('\"'failed at',t)\n        break\nelse:\n    print('all good', len(sigs))\nPY\"","aggregated_output":"all good 500\n","exit_code":0,"status":"completed"}}
