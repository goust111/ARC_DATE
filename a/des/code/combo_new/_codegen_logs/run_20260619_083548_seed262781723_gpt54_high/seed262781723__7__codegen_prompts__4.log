{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\n\nNEI4=((1,0),(-1,0),(0,1),(0,-1))\nNEI8=NEI4+((1,1),(1,-1),(-1,1),(-1,-1))\n\n\ndef parse(lines):\n    coords=[]\n    for r,row in enumerate(lines):\n        for c,ch in enumerate(row):\n            if ch=='#':\n                coords.append((r,c))\n    return tuple(coords)\n\nH_BANK=[parse(x) for x in [\n    ['##'],['###'],['####'],['#.','##'],['.#.','###'],['##.','.##'],['##','##'],['###','##.'],['###','###']\n]]\nV_BANK=[parse(x) for x in [\n    ['#','#'],['#','#','#'],['#','#','#','#'],['#.','##','#.'],['.#','##','.#'],['##','##','#.'],['##','##','##']\n]]\nH_BARS=[parse(x) for x in [['##'],['###'],['####']]]\nV_BARS=[parse(x) for x in [['#','#'],['#','#','#'],['#','#','#','#']]]\n\n\ndef norm(coords):\n    minr=min(r for r,c in coords); minc=min(c for r,c in coords)\n    return tuple(sorted((r-minr,c-minc) for r,c in coords))\n\ndef flip(coords):\n    pts=list(coords)\n    maxr=max(r for r,c in pts); maxc=max(c for r,c in pts)\n    if random.random()<0.5:\n        pts=[(maxr-r,c) for r,c in pts]\n    if random.random()<0.5:\n        pts=[(r,maxc-c) for r,c in pts]\n    return norm(pts)\n\ndef pick(bank):\n    return flip(random.choice(bank))\n\ndef shift(coords,dr,dc):\n    return tuple(sorted((r+dr,c+dc) for r,c in coords))\n\ndef overlap(a,b):\n    return set(a)&set(b)\n\ndef analyze_objects(objs):\n    out=[]\n    for i,coords in enumerate(objs):\n        s=set(coords)\n        rows=[r for r,c in coords]; cols=[c for r,c in coords]\n        h=max(rows)-min(rows)+1; w=max(cols)-min(cols)+1\n        adj=set()\n        for r,c in coords:\n            for dr,dc in NEI4:\n                if (r+dr,c+dc) in s:\n                    pass\n        for j,other in enumerate(objs):\n            if i==j: continue\n            o=set(other)\n            if any((r+dr,c+dc) in o for r,c in coords for dr,dc in NEI4):\n                adj.add(j)\n        out.append((h,w,len(adj)))\n    return out\n\ndef module_output_cells(objs):\n    cells=set()\n    infos=analyze_objects(objs)\n    for coords,(h,w,n) in zip(objs,infos):\n        step=(0,w) if w>=h else (h,0)\n        for k in range(n+1):\n            for r,c in coords:\n                cells.add((r+k*step[0],c+k*step[1]))\n    return cells\n\ndef build_module(objs):\n    allcells=[p for obj in objs for p in obj]\n    minr=min(r for r,c in allcells); minc=min(c for r,c in allcells)\n    objs=[tuple(sorted((r-minr,c-minc) for r,c in obj)) for obj in objs]\n    out=module_output_cells(objs)\n    maxr=max(r for r,c in out); maxc=max(c for r,c in out)\n    return {'objects':objs,'out':out,'shape':(maxr+1,maxc+1), 'analysis':analyze_objects(objs)}\n\ndef make_pair_h():\n    a=pick(H_BARS); b=pick(H_BARS)\n    w1=max(c for r,c in a)+1; w2=max(c for r,c in b)+1\n    c2=random.randint(-(w2-1), w1-1)\n    objs=[shift(a,0,0), shift(b,1,c2)]\n    return build_module(objs)\n\ndef make_chain_h():\n    a=pick(H_BARS); b=pick(H_BARS); c=pick(H_BARS)\n    w1=max(cc for r,cc in a)+1; w2=max(cc for r,cc in b)+1; w3=max(cc for r,cc in c)+1\n    c2=random.randint(-(w2-1), w1-1)\n    c3=c2+random.randint(-(w3-1), w2-1)\n    return build_module([shift(a,0,0), shift(b,1,c2), shift(c,2,c3)])\n\ndef make_pair_v():\n    a=pick(V_BARS); b=pick(V_BARS)\n    h1=max(r for r,c in a)+1; h2=max(r for r,c in b)+1\n    r2=random.randint(-(h2-1), h1-1)\n    return build_module([shift(a,0,0), shift(b,r2,1)])\n\ndef make_chain_v():\n    a=pick(V_BARS); b=pick(V_BARS); c=pick(V_BARS)\n    h1=max(r for r,c in a)+1; h2=max(r for r,c in b)+1; h3=max(r for r,c in c)+1\n    r2=random.randint(-(h2-1), h1-1)\n    r3=r2+random.randint(-(h3-1), h2-1)\n    return build_module([shift(a,0,0), shift(b,r2,1), shift(c,r3,2)])\n\ndef make_mixed_pair():\n    h=pick(H_BANK); v=pick(V_BANK)\n    hh=max(r for r,c in h)+1\n    h_cols=[c for r,c in h if r==hh-1]\n    v_cols=[c for r,c in v if r==0]\n    cH=random.choice(h_cols); cV=random.choice(v_cols)\n    return build_module([shift(h,0,0), shift(v,hh,cH-cV)])\n\nfor name,fn in [('pair_h',make_pair_h),('chain_h',make_chain_h),('pair_v',make_pair_v),('chain_v',make_chain_v),('mixed_pair',make_mixed_pair)]:\n    print('---',name)\n    for _ in range(3):\n        m=fn()\n        print(m['shape'], m['analysis'])\n        # overlap check\n        out_per=[]\n        for idx,obj in enumerate(m['objects']):\n            h,w,n=m['analysis'][idx]\n            step=(0,w) if w>=h else (h,0)\n            cells=set()\n            for k in range(n+1):\n                for r,c in obj:\n                    cells.add((r+k*step[0],c+k*step[1]))\n            out_per.append(cells)\n        ok=True\n        for i in range(len(out_per)):\n            for j in range(i+1,len(out_per)):\n                if out_per[i]&out_per[j]:\n                    ok=False\n        print('disjoint',ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
