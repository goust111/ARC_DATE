{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\nimport numpy as np\n\nBG=0\nGREY=5\nN4=((1,0),(-1,0),(0,1),(0,-1))\n\ndef components(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            pts=[]\n            while q:\n                rr,cc=q.popleft()\n                pts.append((rr,cc))\n                for dr,dc in N4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        q.append((nr,nc))\n            out.append(pts)\n    return out\n\ndef hole_count(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    holes=0\n    for r in range(h):\n        for c in range(w):\n            if mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            touch = r in (0,h-1) or c in (0,w-1)\n            while q:\n                rr,cc=q.popleft()\n                for dr,dc in N4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and not mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        if nr in (0,h-1) or nc in (0,w-1):\n                            touch = True\n                        q.append((nr,nc))\n            if not touch:\n                holes += 1\n    return holes\n\ndef normalize(cells):\n    rs=[r for r,c in cells]\n    cs=[c for r,c in cells]\n    r0=min(rs); c0=min(cs)\n    return sorted((r-r0,c-c0) for r,c in cells)\n\ndef rand_poly(rng,size):\n    cells={(0,0)}\n    while len(cells)<size:\n        r,c=rng.choice(tuple(cells))\n        dr,dc=rng.choice(N4)\n        cells.add((r+dr,c+dc))\n    return normalize(cells)\n\ndef compact_poly(rng,size,trials=20):\n    best=None\n    best_score=None\n    for _ in range(trials):\n        cells=rand_poly(rng,size)\n        h=max(r for r,c in cells)+1\n        w=max(c for r,c in cells)+1\n        score=(h*w, max(h,w), abs(h-w), rng.random())\n        if best_score is None or score<best_score:\n            best=cells; best_score=score\n    return best\n\ndef holey(cells,scale=2):\n    h=max(r for r,c in cells)+1\n    w=max(c for r,c in cells)+1\n    fine=np.zeros((2*h+1,2*w+1),dtype=bool)\n    for r,c in cells:\n        rr=2*r; cc=2*c\n        fine[rr,cc:cc+3]=True\n        fine[rr+2,cc:cc+3]=True\n        fine[rr:rr+3,cc]=True\n        fine[rr:rr+3,cc+2]=True\n    return np.kron(fine,np.ones((scale,scale),dtype=bool))\n\ndef solid(cells,scale=2):\n    h=max(r for r,c in cells)+1\n    w=max(c for r,c in cells)+1\n    arr=np.zeros((h,w),dtype=bool)\n    for r,c in cells:\n        arr[r,c]=True\n    return np.kron(arr,np.ones((scale,scale),dtype=bool))\n\nrng=random.Random(0)\nfor holes in range(1,5):\n    for _ in range(10):\n        cells=compact_poly(rng,holes)\n        m=holey(cells)\n        hc=hole_count(m)\n        if hc\"'!=holes:\n            print('\"'bad',holes,cells,m.shape,hc)\n            print(m.astype(int))\n            raise SystemExit\nprint('holey ok')\nfor _ in range(50):\n    cells=compact_poly(rng,rng.randint(2,6))\n    m=solid(cells,scale=rng.choice([2,3]))\n    hc=hole_count(m)\n    if hc\"'!=0:\n        print('\"'solid bad',cells,m.shape,hc)\n        print(m.astype(int))\n        raise SystemExit\nprint('solid ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
