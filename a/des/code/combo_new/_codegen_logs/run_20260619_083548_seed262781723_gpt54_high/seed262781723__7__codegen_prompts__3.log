hoice(N4)\n        cells.add((r+dr,c+dc))\n    return normalize(cells)\n\ndef compact_poly(rng,size,trials=20):\n    best=None\n    best_score=None\n    for _ in range(trials):\n        cells=rand_poly(rng,size)\n        h=max(r for r,c in cells)+1\n        w=max(c for r,c in cells)+1\n        score=(h*w, max(h,w), abs(h-w), rng.random())\n        if best_score is None or score<best_score:\n            best=cells; best_score=score\n    return best\n\ndef holey(cells,scale=2):\n    h=max(r for r,c in cells)+1\n    w=max(c for r,c in cells)+1\n    fine=np.zeros((2*h+1,2*w+1),dtype=bool)\n    for r,c in cells:\n        rr=2*r; cc=2*c\n        fine[rr,cc:cc+3]=True\n        fine[rr+2,cc:cc+3]=True\n        fine[rr:rr+3,cc]=True\n        fine[rr:rr+3,cc+2]=True\n    return np.kron(fine,np.ones((scale,scale),dtype=bool))\n\ndef solid(cells,scale=2):\n    h=max(r for r,c in cells)+1\n    w=max(c for r,c in cells)+1\n    arr=np.zeros((h,w),dtype=bool)\n    for r,c in cells:\n        arr[r,c]=True\n    return np.kron(arr,np.ones((scale,scale),dtype=bool))\n\nrng=random.Random(0)\nfor holes in range(1,5):\n    for _ in range(10):\n        cells=compact_poly(rng,holes)\n        m=holey(cells)\n        hc=hole_count(m)\n        if hc\"'!=holes:\n            print('\"'bad',holes,cells,m.shape,hc)\n            print(m.astype(int))\n            raise SystemExit\nprint('holey ok')\nfor _ in range(50):\n    cells=compact_poly(rng,rng.randint(2,6))\n    m=solid(cells,scale=rng.choice([2,3]))\n    hc=hole_count(m)\n    if hc\"'!=0:\n        print('\"'solid bad',cells,m.shape,hc)\n        print(m.astype(int))\n        raise SystemExit\nprint('solid ok')\nPY\"","aggregated_output":"holey ok\nsolid ok\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\nimport hashlib\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nN4 = ((1,0),(-1,0),(0,1),(0,-1))\n\n\ndef components(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            pts=[]\n            while q:\n                rr,cc=q.popleft()\n                pts.append((rr,cc))\n                for dr,dc in N4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        q.append((nr,nc))\n            out.append(pts)\n    return out\n\n\ndef hole_count(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    holes=0\n    for r in range(h):\n        for c in range(w):\n            if mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            touch = r in (0,h-1) or c in (0,w-1)\n            while q:\n                rr,cc=q.popleft()\n                for dr,dc in N4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and not mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        if nr in (0,h-1) or nc in (0,w-1):\n                            touch = True\n                        q.append((nr,nc))\n            if not touch:\n                holes += 1\n    return holes\n\n\ndef random_connected_cells(rng,size):\n    cells={(0,0)}\n    while len(cells) < size:\n        r,c = rng.choice(tuple(cells))\n        dr,dc = rng.choice(N4)\n        cells.add((r+dr,c+dc))\n    rs=[r for r,c in cells]\n    cs=[c for r,c in cells]\n    r0=min(rs); c0=min(cs)\n    return sorted((r-r0,c-c0) for r,c in cells)\n\n\ndef compact_polyomino(rng,size,trials=20):\n    best=None\n    best_score=None\n    for _ in range(trials):\n        cells=random_connected_cells(rng,size)\n        h=max(r for r,c in cells)+1\n        w=max(c for r,c in cells)+1\n        score=(h*w, max(h,w), abs(h-w), rng.random())\n        if best_score is None or score < best_score:\n            best=cells\n            best_score=score\n    return best\n\n\ndef random_transform(mask,rng):\n    arr = mask\n    if rng.random() < 0.5:\n        arr = np.flipud(arr)\n    if rng.random() < 0.5:\n        arr = np.fliplr(arr)\n    arr = np.rot90(arr, rng.randrange(4))\n    return arr.copy()\n\n\ndef make_holey_object(rng, holes):\n    cells = compact_polyomino(rng, holes)\n    h=max(r for r,c in cells)+1\n    w=max(c for r,c in cells)+1\n    fine=np.zeros((2*h+1, 2*w+1),dtype=bool)\n    for r,c in cells:\n        rr=2*r; cc=2*c\n        fine[rr, cc:cc+3]=True\n        fine[rr+2, cc:cc+3]=True\n        fine[rr:rr+3, cc]=True\n        fine[rr:rr+3, cc+2]=True\n    mask=np.kron(fine, np.ones((2,2),dtype=bool))\n    mask=random_transform(mask,rng)\n    assert hole_count(mask)==holes\n    return mask\n\n\ndef make_solid_object(rng):\n    for _ in range(20):\n        cells=compact_polyomino(rng, rng.randint(2,6))\n        scale=rng.choice([2,2,3])\n        h=max(r for r,c in cells)+1\n        w=max(c for r,c in cells)+1\n        arr=np.zeros((h,w),dtype=bool)\n        for r,c in cells:\n            arr[r,c]=True\n        mask=np.kron(arr, np.ones((scale,scale),dtype=bool))\n        mask=random_transform(mask,rng)\n        if hole_count(mask)==0:\n            return mask\n    raise RuntimeError\n\n\ndef place_objects(rng, body_h, body_w, objs):\n    body=np.zeros((body_h, body_w), dtype=int)\n    reserved=np.zeros_like(body, dtype=bool)\n    order=sorted(range(len(objs)), key=lambda i: objs[i].shape[0]*objs[i].shape[1], reverse=True)\n    for idx in order:\n        mask=objs[idx]\n        h,w=mask.shape\n        if h+2 > body_h or w+2 > body_w:\n            return None\n        positions=[(r,c) for r in range(1, body_h-h) for c in range(1, body_w-w)]\n        rng.shuffle(positions)\n        placed=False\n        for r,c in positions:\n            rr0=max(0,r-1); rr1=min(body_h,r+h+1)\n            cc0=max(0,c-1); cc1=min(body_w,c+w+1)\n            if reserved[rr0:rr1, cc0:cc1].any():\n                continue\n            body[r:r+h, c:c+w][mask]=GREY\n            reserved[rr0:rr1, cc0:cc1]=True\n            placed=True\n            break\n        if not placed:\n            return None\n    return body\n\n\ndef parse_legend(grid):\n    row=grid[0]\n    assert np.array_equal(grid[0],grid[1])\n    colors=[]\n    c=0\n    while c < grid.shape[1]:\n        if row[c]==BG:\n            c+=1\n            continue\n        color=int(row[c])\n        start=c\n        while c < grid.shape[1] and int(row[c]) == color:\n            c+=1\n        end=c\n        assert end-start==2\n        assert np.all(grid[1,start:end]==color)\n        colors.append(color)\n    return colors\n\n\ndef main(grid):\n    g=np.asarray(grid,dtype=int)\n    sep=2\n    body=g[sep+1:].copy()\n    colors=parse_legend(g)\n    for pts in components(body==GREY):\n        rs=[r for r,c in pts]; cs=[c for r,c in pts]\n        r0=min(rs); r1=max(rs); c0=min(cs); c1=max(cs)\n        mask=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)\n        for r,c in pts:\n            mask[r-r0,c-c0]=True\n        hc=hole_count(mask)\n        fill = GREY if hc==0 or hc>len(colors) else colors[hc-1]\n        for r,c in pts:\n            body[r,c]=fill\n    return body\n\n\ndef gen_attempt(rng):\n    k=rng.randint(1,4)\n    colors=rng.sample(PALETTE, k)\n    counts=[0]+list(range(1,k+1))\n    if rng.random() < 0.8:\n        counts.append(0)\n    if rng.random() < 0.35:\n        counts.append(rng.randint(1,k))\n    rng.shuffle(counts)\n    objs=[]\n    for hc in counts:\n        objs.append(make_solid_object(rng) if hc==0 else make_holey_object(rng,hc))\n    legend_span=3*k-1\n    need_area=sum((o.shape[0]+2)*(o.shape[1]+2) for o in objs)\n    max_h=max(o.shape[0] for o in objs)\n    max_w=max(o.shape[1] for o in objs)\n    for _ in range(60):\n        body_h=rng.randint(max(max_h+2,10), 27)\n        body_w=rng.randint(max(max_w+2, legend_span, 12), 30)\n        if body_h * body_w < int(need_area * 1.15):\n            continue\n        body=place_objects(rng, body_h, body_w, objs)\n        if body is None:\n            continue\n        grid=np.zeros((body_h+3, body_w), dtype=int)\n        start=rng.randint(0, body_w-legend_span)\n        for i,color in enumerate(colors):\n            c=start+3*i\n            grid[0:2, c:c+2]=color\n        grid[3:]=body\n        return grid\n    return None\n\n\ndef generate_input():\n    rng=random.Random()\n    for _ in range(300):\n        g=gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError\n\nsigs=set()\nfor i in range(100):\n    g=generate_input()\n    out=main(g)\n    assert g.ndim==2 and max(g.shape)<=30, g.shape\n    assert out.ndim==2 and max(out.shape)<=30, out.shape\n    assert len(parse_legend(g))>=1\n    assert out.shape[0]==g.shape[0]-3\n    # verify colors follow hole counts\n    body=g[3:]\n    out2=out\n    comps=components(body==GREY)\n    seen=0\n    zero=0\n    pos=0\n    for pts in comps:\n        rs=[r for r,c in pts]; cs=[c for r,c in pts]\n        r0=min(rs); r1=max(rs); c0=min(cs); c1=max(cs)\n        mask=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)\n        for r,c in pts:\n            mask[r-r0,c-c0]=True\n        hc=hole_count(mask)\n        color=out2[pts[0][0], pts[0][1]]\n        if hc==0:\n            assert color==GREY\n            zero += 1\n        else:\n            assert color==parse_legend(g)[hc-1]\n            pos += 1\n        seen += 1\n    assert zero >= 1 and pos >= 1\n    sigs.add(hashlib.md5(g.tobytes()+str(g.shape).encode()).hexdigest())\nprint('variants',len(sigs))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\nimport hashlib\nimport numpy as np\n\nBG = 0\nGREY = 5\nPALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\nN4 = ((1,0),(-1,0),(0,1),(0,-1))\n\n\ndef components(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    out=[]\n    for r in range(h):\n        for c in range(w):\n            if not mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            pts=[]\n            while q:\n                rr,cc=q.popleft()\n                pts.append((rr,cc))\n                for dr,dc in N4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        q.append((nr,nc))\n            out.append(pts)\n    return out\n\n\ndef hole_count(mask):\n    h,w=mask.shape\n    seen=np.zeros_like(mask,dtype=bool)\n    holes=0\n    for r in range(h):\n        for c in range(w):\n            if mask[r,c] or seen[r,c]:\n                continue\n            q=deque([(r,c)])\n            seen[r,c]=True\n            touch = r in (0,h-1) or c in (0,w-1)\n            while q:\n                rr,cc=q.popleft()\n                for dr,dc in N4:\n                    nr,nc=rr+dr,cc+dc\n                    if 0<=nr<h and 0<=nc<w and not mask[nr,nc] and not seen[nr,nc]:\n                        seen[nr,nc]=True\n                        if nr in (0,h-1) or nc in (0,w-1):\n                            touch = True\n                        q.append((nr,nc))\n            if not touch:\n                holes += 1\n    return holes\n\n\ndef random_connected_cells(rng,size):\n    cells={(0,0)}\n    while len(cells) < size:\n        r,c = rng.choice(tuple(cells))\n        dr,dc = rng.choice(N4)\n        cells.add((r+dr,c+dc))\n    rs=[r for r,c in cells]\n    cs=[c for r,c in cells]\n    r0=min(rs); c0=min(cs)\n    return sorted((r-r0,c-c0) for r,c in cells)\n\n\ndef compact_polyomino(rng,size,trials=20):\n    best=None\n    best_score=None\n    for _ in range(trials):\n        cells=random_connected_cells(rng,size)\n        h=max(r for r,c in cells)+1\n        w=max(c for r,c in cells)+1\n        score=(h*w, max(h,w), abs(h-w), rng.random())\n        if best_score is None or score < best_score:\n            best=cells\n            best_score=score\n    return best\n\n\ndef random_transform(mask,rng):\n    arr = mask\n    if rng.random() < 0.5:\n        arr = np.flipud(arr)\n    if rng.random() < 0.5:\n        arr = np.fliplr(arr)\n    arr = np.rot90(arr, rng.randrange(4))\n    return arr.copy()\n\n\ndef make_holey_object(rng, holes):\n    cells = compact_polyomino(rng, holes)\n    h=max(r for r,c in cells)+1\n    w=max(c for r,c in cells)+1\n    fine=np.zeros((2*h+1, 2*w+1),dtype=bool)\n    for r,c in cells:\n        rr=2*r; cc=2*c\n        fine[rr, cc:cc+3]=True\n        fine[rr+2, cc:cc+3]=True\n        fine[rr:rr+3, cc]=True\n        fine[rr:rr+3, cc+2]=True\n    mask=np.kron(fine, np.ones((2,2),dtype=bool))\n    mask=random_transform(mask,rng)\n    assert hole_count(mask)==holes\n    return mask\n\n\ndef make_solid_object(rng):\n    for _ in range(20):\n        cells=compact_polyomino(rng, rng.randint(2,6))\n        scale=rng.choice([2,2,3])\n        h=max(r for r,c in cells)+1\n        w=max(c for r,c in cells)+1\n        arr=np.zeros((h,w),dtype=bool)\n        for r,c in cells:\n            arr[r,c]=True\n        mask=np.kron(arr, np.ones((scale,scale),dtype=bool))\n        mask=random_transform(mask,rng)\n        if hole_count(mask)==0:\n            return mask\n    raise RuntimeError\n\n\ndef place_objects(rng, body_h, body_w, objs):\n    body=np.zeros((body_h, body_w), dtype=int)\n    reserved=np.zeros_like(body, dtype=bool)\n    order=sorted(range(len(objs)), key=lambda i: objs[i].shape[0]*objs[i].shape[1], reverse=True)\n    for idx in order:\n        mask=objs[idx]\n        h,w=mask.shape\n        if h+2 > body_h or w+2 > body_w:\n            return None\n        positions=[(r,c) for r in range(1, body_h-h) for c in range(1, body_w-w)]\n        rng.shuffle(positions)\n        placed=False\n        for r,c in positions:\n            rr0=max(0,r-1); rr1=min(body_h,r+h+1)\n            cc0=max(0,c-1); cc1=min(body_w,c+w+1)\n            if reserved[rr0:rr1, cc0:cc1].any():\n                continue\n            body[r:r+h, c:c+w][mask]=GREY\n            reserved[rr0:rr1, cc0:cc1]=True\n            placed=True\n            break\n        if not placed:\n            return None\n    return body\n\n\ndef parse_legend(grid):\n    row=grid[0]\n    assert np.array_equal(grid[0],grid[1])\n    colors=[]\n    c=0\n    while c < grid.shape[1]:\n        if row[c]==BG:\n            c+=1\n            continue\n        color=int(row[c])\n        start=c\n        while c < grid.shape[1] and int(row[c]) == color:\n            c+=1\n        end=c\n        assert end-start==2\n        assert np.all(grid[1,start:end]==color)\n        colors.append(color)\n    return colors\n\n\ndef main(grid):\n    g=np.asarray(grid,dtype=int)\n    sep=2\n    body=g[sep+1:].copy()\n    colors=parse_legend(g)\n    for pts in components(body==GREY):\n        rs=[r for r,c in pts]; cs=[c for r,c in pts]\n        r0=min(rs); r1=max(rs); c0=min(cs); c1=max(cs)\n        mask=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)\n        for r,c in pts:\n            mask[r-r0,c-c0]=True\n        hc=hole_count(mask)\n        fill = GREY if hc==0 or hc>len(colors) else colors[hc-1]\n        for r,c in pts:\n            body[r,c]=fill\n    return body\n\n\ndef gen_attempt(rng):\n    k=rng.randint(1,4)\n    colors=rng.sample(PALETTE, k)\n    counts=[0]+list(range(1,k+1))\n    if rng.random() < 0.8:\n        counts.append(0)\n    if rng.random() < 0.35:\n        counts.append(rng.randint(1,k))\n    rng.shuffle(counts)\n    objs=[]\n    for hc in counts:\n        objs.append(make_solid_object(rng) if hc==0 else make_holey_object(rng,hc))\n    legend_span=3*k-1\n    need_area=sum((o.shape[0]+2)*(o.shape[1]+2) for o in objs)\n    max_h=max(o.shape[0] for o in objs)\n    max_w=max(o.shape[1] for o in objs)\n    for _ in range(60):\n        body_h=rng.randint(max(max_h+2,10), 27)\n        body_w=rng.randint(max(max_w+2, legend_span, 12), 30)\n        if body_h * body_w < int(need_area * 1.15):\n            continue\n        body=place_objects(rng, body_h, body_w, objs)\n        if body is None:\n            continue\n        grid=np.zeros((body_h+3, body_w), dtype=int)\n        start=rng.randint(0, body_w-legend_span)\n        for i,color in enumerate(colors):\n            c=start+3*i\n            grid[0:2, c:c+2]=color\n        grid[3:]=body\n        return grid\n    return None\n\n\ndef generate_input():\n    rng=random.Random()\n    for _ in range(300):\n        g=gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError\n\nsigs=set()\nfor i in range(100):\n    g=generate_input()\n    out=main(g)\n    assert g.ndim==2 and max(g.shape)<=30, g.shape\n    assert out.ndim==2 and max(out.shape)<=30, out.shape\n    assert len(parse_legend(g))>=1\n    assert out.shape[0]==g.shape[0]-3\n    # verify colors follow hole counts\n    body=g[3:]\n    out2=out\n    comps=components(body==GREY)\n    seen=0\n    zero=0\n    pos=0\n    for pts in comps:\n        rs=[r for r,c in pts]; cs=[c for r,c in pts]\n        r0=min(rs); r1=max(rs); c0=min(cs); c1=max(cs)\n        mask=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)\n        for r,c in pts:\n            mask[r-r0,c-c0]=True\n        hc=hole_count(mask)\n        color=out2[pts[0][0], pts[0][1]]\n        if hc==0:\n            assert color==GREY\n            zero += 1\n        else:\n            assert color==parse_legend(g)[hc-1]\n            pos += 1\n        seen += 1\n    assert zero >= 1 and pos >= 1\n    sigs.add(hashlib.md5(g.tobytes()+str(g.shape).encode()).hexdigest())\nprint('variants',len(sigs))\nPY\"","aggregated_output":"variants 100\n","exit_code":0,"status":"completed"}}
