{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/1a244afd.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/1a244afd.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, coords_where, get_bg, in_bounds\nimport random\n\nCoord = tuple[int, int]\n\n\ndef _coords(mask: np.ndarray) -> list[Coord]:\n    return [(int(r), int(c)) for r, c in coords_where(mask)]\n\n\ndef _unique_row_col_pairs(sources: list[Coord], pivots: list[Coord]) -> list[tuple[Coord, Coord]]:\n    assert len(sources) == len(pivots) > 0, \"expected equal nonzero source and pivot counts\"\n    candidates = {\n        s: [p for p in pivots if p[0] == s[0] or p[1] == s[1]]\n        for s in sources\n    }\n    assert all(candidates[s] for s in sources), \"each source must align with a pivot\"\n\n    ordered_sources = sorted(sources, key=lambda s: (len(candidates[s]), s[0], s[1]))\n    solutions: list[dict[Coord, Coord]] = []\n\n    def search(i: int, used: set[Coord], pairs: dict[Coord, Coord]) -> None:\n        if len(solutions) > 1:\n            return\n        if i == len(ordered_sources):\n            solutions.append(pairs.copy())\n            return\n\n        s = ordered_sources[i]\n        for p in candidates[s]:\n            if p in used:\n                continue\n            used.add(p)\n            pairs[s] = p\n            search(i + 1, used, pairs)\n            del pairs[s]\n            used.remove(p)\n\n    search(0, set(), {})\n    assert len(solutions) == 1, \"expected a unique one-to-one row/column matching\"\n    return [(s, solutions[0][s]) for s in sources]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each magenta source pixel 90 degrees counterclockwise around its matched blue pivot, recoloring the new pixel orange.\n\n    Input structure:\n    - The background is the dominant color.\n    - The only foreground colors are blue pivot pixels and magenta source pixels.\n    - Each magenta source can be paired one-to-one with a blue pivot in the same\n      row or column.\n\n    Rule:\n    - Remove all magenta source pixels.\n    - For each matched source/pivot pair, preserve the source distance from the\n      pivot but rotate its offset 90 degrees counterclockwise.\n    - Paint the rotated in-bounds target orange; if the target is outside the\n      grid, the source simply disappears.\n\n    Key insight:\n    The blue pixels are rotation centers, and row/column alignment gives a\n    unique global matching from each magenta source to its pivot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    assert set(colors_present(g)) == {bg, Color.BLUE, Color.PINK}, \"unexpected color set\"\n\n    sources = _coords(g == Color.PINK)\n    pivots = _coords(g == Color.BLUE)\n    pairs = _unique_row_col_pairs(sources, pivots)\n\n    out = g.copy()\n    out[g == Color.PINK] = bg\n\n    for (sr, sc), (pr, pc) in pairs:\n        dr = sr - pr\n        dc = sc - pc\n        tr = pr - dc\n        tc = pc + dr\n        if in_bounds(g.shape, tr, tc):\n            assert out[tr, tc] == bg, \"rotated targets must land on background\"\n            out[tr, tc] = Color.ORANGE\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nTriple = tuple[Coord, Coord, Coord | None, bool]\n\n# Canvas, colors, and retry budget.\nGRID_SIZE_RANGE = (8, 16)\nBACKGROUND_COLOR = Color.TEAL\nGENERATION_RETRIES = 300\n\n# Pair counts and geometric offsets.\nPAIR_COUNT_RANGE = (3, 7)\nSOURCE_DISTANCE_RANGE = (1, 4)\nSOURCE_OFFSETS = tuple(\n    offset for d in range(SOURCE_DISTANCE_RANGE[0], SOURCE_DISTANCE_RANGE[1] + 1) for offset in ((0, -d), (0, d), (-d, 0), (d, 0))\n)\n\n# Layout mix.\nMAX_OOB_TARGETS = 2\nSAME_ROW_PROBABILITY = 0.3\nMIN_SAME_ROW_PAIRS = 1\n\n\ndef _matching_count(sources: list[Coord], pivots: list[Coord]) -> int:\n    candidates = {\n        s: [p for p in pivots if p[0] == s[0] or p[1] == s[1]]\n        for s in sources\n    }\n    if any(not ps for ps in candidates.values()):\n        return 0\n\n    ordered = sorted(sources, key=lambda s: (len(candidates[s]), s[0], s[1]))\n    count = 0\n\n    def search(i: int, used: set[Coord]) -> None:\n        nonlocal count\n        if count > 1:\n            return\n        if i == len(ordered):\n            count += 1\n            return\n        for pivot in candidates[ordered[i]]:\n            if pivot in used:\n                continue\n            used.add(pivot)\n            search(i + 1, used)\n            used.remove(pivot)\n\n    search(0, set())\n    return count\n\n\ndef _all_triples(n: int, want_oob: bool, want_same_row: bool) -> list[Triple]:\n    triples: list[Triple] = []\n    for pr in range(n):\n        for pc in range(n):\n            for dr, dc in SOURCE_OFFSETS:\n                same_row = dr == 0\n                if same_row != want_same_row:\n                    continue\n                sr, sc = pr + dr, pc + dc\n                if not in_bounds((n, n), sr, sc):\n                    continue\n                tr, tc = pr - dc, pc + dr\n                target: Coord | None = (tr, tc) if in_bounds((n, n), tr, tc) else None\n                if (target is None) != want_oob:\n                    continue\n                triples.append(((pr, pc), (sr, sc), target, same_row))\n    random.shuffle(triples)\n    return triples\n\n\ndef _compatible(\n    triple: Triple,\n    pivots: list[Coord],\n    sources: list[Coord],\n    targets: set[Coord],\n) -> bool:\n    pivot, source, target, _ = triple\n    input_cells = set(pivots) | set(sources)\n    if pivot in input_cells or source in input_cells or pivot == source:\n        return False\n\n    for old_source in sources:\n        if old_source[0] == pivot[0] or old_source[1] == pivot[1]:\n            return False\n    for old_pivot in pivots:\n        if source[0] == old_pivot[0] or source[1] == old_pivot[1]:\n            return False\n\n    if target is not None and (target in targets or target in input_cells or target in (pivot, source)):\n        return False\n    return True\n\n\ndef _sample_requirements(k: int) -> list[tuple[bool, bool]]:\n    \"\"\"Return shuffled per-pair requirements: (target_is_oob, source_same_row).\"\"\"\n    oob_goal = random.randint(0, min(MAX_OOB_TARGETS, k - 1))\n    same_row_count = sum(1 for _ in range(k) if random.random() < SAME_ROW_PROBABILITY)\n    same_row_count = max(MIN_SAME_ROW_PAIRS, min(k - 1, same_row_count))\n    oob_flags = [True] * oob_goal + [False] * (k - oob_goal)\n    same_row_flags = [True] * same_row_count + [False] * (k - same_row_count)\n    random.shuffle(oob_flags)\n    random.shuffle(same_row_flags)\n    return list(zip(oob_flags, same_row_flags))\n\n\ndef _place_pairs(\n    n: int,\n    requirements: list[tuple[bool, bool]],\n) -> tuple[list[Coord], list[Coord], set[Coord]] | None:\n    \"\"\"Build non-ambiguous pivot/source/target sets that satisfy requirements.\"\"\"\n    pivots: list[Coord] = []\n    sources: list[Coord] = []\n    targets: set[Coord] = set()\n    triples_by_req: dict[tuple[bool, bool], list[Triple]] = {}\n\n    for want_oob, want_same_row in requirements:\n        key = (want_oob, want_same_row)\n        if key not in triples_by_req:\n            triples_by_req[key] = _all_triples(n, want_oob, want_same_row)\n        choices = [\n            triple\n            for triple in triples_by_req[key]\n            if _compatible(triple, pivots, sources, targets)\n        ]\n        if not choices:\n            return None\n        pivot, source, target, _ = random.choice(choices)\n        pivots.append(pivot)\n        sources.append(source)\n        if target is not None:\n            targets.add(target)\n\n    if _matching_count(sources, pivots) != 1:\n        return None\n    return pivots, sources, targets\n\n\ndef _build_grids(n: int, pivots: list[Coord], sources: list[Coord], targets: set[Coord]):\n    \"\"\"Render the input grid and expected output grid for a valid layout.\"\"\"\n    inp = np.full((n, n), BACKGROUND_COLOR, dtype=int)\n    out = np.full((n, n), BACKGROUND_COLOR, dtype=int)\n    for r, c in pivots:\n        inp[r, c] = Color.BLUE\n        out[r, c] = Color.BLUE\n    for r, c in sources:\n        inp[r, c] = Color.PINK\n    for r, c in targets:\n        out[r, c] = Color.ORANGE\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])\n    k = random.randint(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1])\n    placed = _place_pairs(n, _sample_requirements(k))\n    if placed is None:\n        return None\n    inp, expected = _build_grids(n, *placed)\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport itertools\nimport random\n\n\nMARKER_COLOR = 1\nBODY_COLOR = 2\n\n\ndef _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    bars = []\n    baseline = None\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert c0 == c1\n        coords = comp[\"coords\"]\n        height = r1 - r0 + 1\n        assert comp[\"area\"] == height\n        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}\n        if baseline is None:\n            baseline = r1\n        else:\n            assert r1 == baseline\n        bars.append(\n            {\n                \"color\": int(comp[\"color\"]),\n                \"col\": int(c0),\n                \"bottom\": int(r1),\n                \"height\": int(height),\n                \"coords\": coords,\n            }\n        )\n\n    assert bars\n    return sorted(bars, key=lambda b: b[\"col\"])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\ndef _chain_red_distributions(n_blue, n_red):\n    \"\"\"Return all red-count allocations across blue-started chains.\"\"\"\n    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]\n\n\ndef _bounded_tuples(values, n, max_sum):\n    \"\"\"Return ordered n-tuples from values whose sum fits the width budget.\"\"\"\n    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]\n\n\ndef _sample_groups():\n    \"\"\"Sample row count and bar groups before physical layout.\"\"\"\n    rows = random.randint(MIN_ROWS, MAX_ROWS)\n    max_height = min(MAX_BAR_HEIGHT, rows)\n    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)\n    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)\n    red_total = random.randint(MIN_RED_BARS, max_red)\n    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)\n    max_unchained = min(MAX_UNCHAINED_RED, red_total)\n    n_unchained = random.randint(min_unchained, max_unchained)\n\n    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)\n    if not distributions:\n        return None\n\n    groups = [\n        {\"kind\": \"chain\", \"colors\": [MARKER_COLOR] + [BODY_COLOR] * n_red}\n        for n_red in random.choice(distributions)\n    ]\n    groups.extend({\"kind\": \"unchained\", \"colors\": [BODY_COLOR]} for _ in range(n_unchained))\n    random.shuffle(groups)\n    if groups[0][\"kind\"] == \"unchained\":\n        for i, group in enumerate(groups):\n            if group[\"kind\"] == \"chain\":\n                groups[0], groups[i] = groups[i], groups[0]\n                break\n    return rows, max_height, groups\n\n\ndef _sample_layout(max_height, groups):\n    \"\"\"Sample gaps, heights, margins, and positioned bar columns.\"\"\"\n    n_bars = sum(len(group[\"colors\"]) for group in groups)\n    right_margin = random.randint(0, MAX_RIGHT_MARGIN)\n\n    gap_count = len(groups) - 1\n    if gap_count:\n        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars\n        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)\n        if not gap_options:\n            return None\n        gaps = list(random.choice(gap_options))\n    else:\n        gaps = []\n\n    height_options = _bounded_tuples(\n        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),\n        n_bars,\n        MAX_WIDTH - right_margin - sum(gaps),\n    )\n    if not height_options:\n        return None\n    heights = list(random.choice(height_options))\n\n    idx = 0\n    for group in groups:\n        count = len(group[\"colors\"])\n        group[\"heights\"] = heights[idx : idx + count]\n        idx += count\n\n    span = sum(heights) + sum(gaps)\n    min_left = max(0, MIN_WIDTH - right_margin - span)\n    max_left = MAX_WIDTH - right_margin - span\n    if min_left > max_left:\n        return None\n    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):\n        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))\n    else:\n        left_margin = min_left\n\n    width = left_margin + span + right_margin\n    if not (MIN_WIDTH <= width <= MAX_WIDTH):\n        return None\n\n    bars = []\n    col = left_margin\n    gap_i = 0\n    for group_i, group in enumerate(groups):\n        chained = group[\"kind\"] == \"chain\"\n        for color, height in zip(group[\"colors\"], group[\"heights\"]):\n            bars.append(\n                {\n                    \"color\": color,\n                    \"height\": height,\n                    \"col\": col,\n                    \"chained\": chained,\n                }\n            )\n            col += height\n        if group_i + 1 < len(groups):\n            col += gaps[gap_i]\n            gap_i += 1\n\n    if col + right_margin != width:\n        return None\n    return bars, width\n\n\ndef _render_pair(rows, width, bars):\n    \"\"\"Render the sampled input grid and its expected transformed output.\"\"\"\n    baseline = rows - 1\n    inp = np.zeros((rows, width), dtype=int)\n    out = np.zeros_like(inp)\n    for bar in bars:\n        color, height, col = bar[\"color\"], bar[\"height\"], bar[\"col\"]\n        vertical = slice(baseline - height + 1, baseline + 1)\n        inp[vertical, col] = color\n        if bar[\"chained\"]:\n            out[baseline, col : col + height] = color\n        else:\n            out[vertical, col] = color\n    return inp, out\n\n\ndef _passes_oracle(inp, expected):\n    \"\"\"Return whether the solver accepts and matches the rendered output.\"\"\"\n    try:\n        actual = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(actual, expected)\n\n\ndef _gen_attempt():\n    sampled = _sample_groups()\n    if sampled is None:\n        return None\n    rows, max_height, groups = sampled\n\n    layout = _sample_layout(max_height, groups)\n    if layout is None:\n        return None\n    bars, width = layout\n\n    inp, expected = _render_pair(rows, width, bars)\n    if not _passes_oracle(inp, expected):\n        return None\n    return inp\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n    return None\n\n\ndef _gen_symmetric_motif_patch(max_h, max_w):\n    candidates = []\n    for lines in _GEN_MOTIF_TEMPLATES:\n        patch = _gen_patch_from_lines(lines)\n        for variant in _gen_patch_variants(patch):\n            h, w = variant.shape\n            direction = _gen_patch_direction(variant)\n            if (\n                h <= max_h\n                and w <= max_w\n                and _gen_is_diagonal_symmetric_patch(variant)\n                and direction is not None\n            ):\n                candidates.append((variant, direction))\n    if not candidates:\n        return None\n    patch, direction = random.choice(candidates)\n","exit_code":0,"status":"completed"}}
