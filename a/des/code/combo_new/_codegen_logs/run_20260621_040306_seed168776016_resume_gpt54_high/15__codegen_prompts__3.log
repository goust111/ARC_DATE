{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/2e65ae53.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _dominant_foreground_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g[g != int(bg)], return_counts=True)\n    assert vals.size > 0, \"expected foreground pixels\"\n    max_count = int(counts.max())\n    winners = vals[counts == max_count]\n    assert winners.size == 1, \"expected one largest foreground color for lattice frames\"\n    return int(winners[0])\n\n\ndef _parse_frames(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[list[int], list[int]]]:\n    frames: list[tuple[list[int], list[int]]] = []\n    components = find_components(\n        g,\n        bg=int(bg),\n        colors=[int(frame_color)],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert components, \"expected at least one lattice frame\"\n\n    for comp in components:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        sub = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(frame_color)\n\n        row_idx = [r for r in range(sub.shape[0]) if bool(sub[r, :].all())]\n        col_idx = [c for c in range(sub.shape[1]) if bool(sub[:, c].all())]\n        assert len(row_idx) >= 2 and len(col_idx) >= 2, \"frame must divide slots\"\n        assert row_idx[0] == 0 and row_idx[-1] == sub.shape[0] - 1\n        assert col_idx[0] == 0 and col_idx[-1] == sub.shape[1] - 1\n        assert all(a + 1 < b for a, b in zip(row_idx, row_idx[1:]))\n        assert all(a + 1 < b for a, b in zip(col_idx, col_idx[1:]))\n\n        expected = np.zeros_like(sub, dtype=bool)\n        expected[row_idx, :] = True\n        expected[:, col_idx] = True\n        assert np.array_equal(sub, expected), \"frame must be a complete rectangular lattice\"\n\n        rows = [int(r0) + r for r in row_idx]\n        cols = [int(c0) + c for c in col_idx]\n        frames.append((rows, cols))\n\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    for rows, cols in frames:\n        assert len(rows) - 1 == slot_rows\n        assert len(cols) - 1 == slot_cols\n    return frames\n\n\ndef _infer_slot_colors(\n    g: np.ndarray,\n    bg: int,\n    frame_color: int,\n    frames: list[tuple[list[int], list[int]]],\n) -> dict[tuple[int, int], int]:\n    slot_rows = len(frames[0][0]) - 1\n    slot_cols = len(frames[0][1]) - 1\n    colors: dict[tuple[int, int], int] = {}\n\n    for rows, cols in frames:\n        for sr in range(slot_rows):\n            for sc in range(slot_cols):\n                region = g[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]]\n                marker = region[(region != int(bg)) & (region != int(frame_color))]\n                if marker.size == 0:\n                    continue\n                vals = np.unique(marker)\n                assert vals.size == 1, \"each colored slot must contain one color\"\n                color = int(vals[0])\n                key = (sr, sc)\n                assert key not in colors or colors[key] == color\n                colors[key] = color\n\n    expected = {(sr, sc) for sr in range(slot_rows) for sc in range(slot_cols)}\n    assert set(colors) == expected, \"colored slots must identify every logical slot\"\n    return colors\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill every lattice slot from the color assigned to that slot position by the other lattices.\n\n    Input structure:\n    - The background is the dominant color.\n    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.\n    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.\n\n    Rule:\n    - Infer a color for each logical slot position from the colored slots across all lattice frames.\n    - Repaint every slot interior in every lattice with the inferred color for its row/column position.\n    - Keep the frame lines and all background outside frames unchanged.\n\n    Key insight:\n    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color = _dominant_foreground_color(g, bg)\n    frames = _parse_frames(g, bg, frame_color)\n    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)\n\n    out = g.copy()\n    for rows, cols in frames:\n        for sr in range(len(rows) - 1):\n            for sc in range(len(cols) - 1):\n                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[\n                    (sr, sc)\n                ]\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Grid and palette choices.\nBG = 0\nGRID_SIZE_RANGE = (22, 28)\nNEAR_SQUARE_PROB = 0.65\nNEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]\nFOREGROUND_COLORS = range(1, 10)\nPALETTE_SIZE = 5\n\n# Lattice geometry.\nSLOT_SIZE_RANGE = (1, 8)\nFRAME_HEIGHT_RANGE = (5, 18)\nFRAME_WIDTH_RANGE = (5, 14)\nLATTICE_LINE_COUNT = 3\nSLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]\n\n# Frame count and area allocation.\nFRAME_COUNT_RANGE = (4, 6)\nMIN_FRAME_AREA = 25\nAREA_BUDGET_RANGE = (0.55, 0.88)\nAREA_WEIGHT_SCALE = 35.0\n\n# Placement and retry limits.\nEDGE_BORDER = 1\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nMAX_GENERATION_ATTEMPTS = 300\n\nFrameSpec = tuple[tuple[int, int], tuple[int, int]]\nPlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]\nSlotColors = dict[tuple[int, int], int]\n\n\ndef _line_indices(lengths: tuple[int, int]) -> list[int]:\n    return [0, int(lengths[0]) + 1, int(lengths[0]) + int(lengths[1]) + 2]\n\n\ndef _slot_options() -> dict[tuple[int, int], list[FrameSpec]]:\n    options: dict[tuple[int, int], list[FrameSpec]] = {}\n    slot_min, slot_max = SLOT_SIZE_RANGE\n    height_min, height_max = FRAME_HEIGHT_RANGE\n    width_min, width_max = FRAME_WIDTH_RANGE\n    for h0 in range(slot_min, slot_max + 1):\n        for h1 in range(slot_min, slot_max + 1):\n            height = h0 + h1 + LATTICE_LINE_COUNT\n            if not height_min <= height <= height_max:\n                continue\n            for w0 in range(slot_min, slot_max + 1):\n                for w1 in range(slot_min, slot_max + 1):\n                    width = w0 + w1 + LATTICE_LINE_COUNT\n                    if not width_min <= width <= width_max:\n                        continue\n                    options.setdefault((height, width), []).append(((h0, h1), (w0, w1)))\n    return options\n\n\n_SIZE_OPTIONS = _slot_options()\n\n\ndef _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:\n    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]\n    random.shuffle(keys)\n\n    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)\n    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))\n    chosen_sizes: list[tuple[int, int]] = []\n    remaining = budget\n\n    for i in range(n_frames):\n        slots_left = n_frames - i - 1\n        candidates = [\n            size\n            for size in keys\n            if size not in chosen_sizes\n            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA\n        ]\n        if not candidates:\n            return None\n        weights = []\n        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))\n        for height, width in candidates:\n            area = height * width\n            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))\n        size = random.choices(candidates, weights=weights, k=1)[0]\n        chosen_sizes.append(size)\n        remaining -= size[0] * size[1]\n\n    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]\n    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)\n    return specs\n\n\ndef _choose_canvas_shape() -> tuple[int, int]:\n    grid_min, grid_max = GRID_SIZE_RANGE\n    rows = random.randint(grid_min, grid_max)\n    cols = random.randint(grid_min, grid_max)\n    if random.random() < NEAR_SQUARE_PROB:\n        delta = random.choice(NEAR_SQUARE_DELTAS)\n        cols = min(grid_max, max(grid_min, rows + delta))\n    return rows, cols\n\n\ndef _choose_palette() -> tuple[int, SlotColors]:\n    colors = random.sample(FOREGROUND_COLORS, PALETTE_SIZE)\n    frame_color = colors[0]\n    color_values = colors[1:]\n    random.shuffle(color_values)\n    slot_colors = {pos: color_values[i] for i, pos in enumerate(SLOT_POSITIONS)}\n    return frame_color, slot_colors\n\n\ndef _make_output_patch(heights: tuple[int, int], widths: tuple[int, int], frame_color: int, slot_colors: SlotColors) -> tuple[np.ndarray, list[int], list[int]]:\n    row_lines = _line_indices(heights)\n    col_lines = _line_indices(widths)\n    patch = np.zeros((row_lines[-1] + 1, col_lines[-1] + 1), dtype=int)\n    patch[row_lines, :] = int(frame_color)\n    patch[:, col_lines] = int(frame_color)\n\n    for sr, sc in SLOT_POSITIONS:\n        patch[row_lines[sr] + 1 : row_lines[sr + 1], col_lines[sc] + 1 : col_lines[sc + 1]] = slot_colors[(sr, sc)]\n    return patch, row_lines, col_lines\n\n\ndef _hint_providers(n_frames: int) -> dict[tuple[int, int], int]:\n    providers = [random.randrange(n_frames) for _ in SLOT_POSITIONS]\n    if len(set(providers)) == 1:\n        providers[random.randrange(len(providers))] = random.choice(\n            [idx for idx in range(n_frames) if idx != providers[0]]\n        )\n    return {pos: providers[i] for i, pos in enumerate(SLOT_POSITIONS)}\n\n\ndef _place_frames(rows: int, cols: int, specs: list[FrameSpec]) -> list[PlacedFrame] | None:\n    occ = np.zeros((rows, cols), dtype=int)\n    placed: list[PlacedFrame] = []\n    for heights, widths in specs:\n        height = sum(heights) + LATTICE_LINE_COUNT\n        width = sum(widths) + LATTICE_LINE_COUNT\n        block = np.ones((height, width), dtype=int)\n        try:\n            r0, c0 = random_free_location(occ, block, transparent=BG, border=EDGE_BORDER, padding=PLACEMENT_PADDING, padding_connectivity=PLACEMENT_CONNECTIVITY)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n","exit_code":0,"status":"completed"}}
