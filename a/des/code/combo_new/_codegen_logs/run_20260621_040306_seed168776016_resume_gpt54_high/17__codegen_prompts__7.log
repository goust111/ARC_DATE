{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport random, numpy as np\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed168776016/17/7.py')\nmod = SourceFileLoader('arc7_dbg', str(p)).load_module()\ncounts = {'patch':0,'canvas':0,'bg':0,'main_exc':0,'mismatch':0,'ok':0}\nfor _ in range(200):\n    pair_count = random.randint(1, 4)\n    colors = random.sample(mod.FRAGMENT_COLORS, pair_count)\n    sides = [random.choice(mod.SIDES) for _ in range(pair_count)]\n    try:\n        patches = [mod._build_pair_patch(color, side) for color, side in zip(colors, sides)]\n    except Exception as e:\n        counts['patch'] += 1\n        continue\n    max_h = max(p[0].shape[0] for p in patches)\n    max_w = max(p[0].shape[1] for p in patches)\n    total_area = sum((p[0].shape[0] + 2) * (p[0].shape[1] + 2) for p in patches)\n    min_side = max(12, int(np.ceil(np.sqrt(total_area))))\n    min_canvas_h = max(max_h + 2, min_side)\n    min_canvas_w = max(max_w + 2, min_side)\n    if min_canvas_h > 30 or min_canvas_w > 30:\n        counts['canvas'] += 1\n        continue\n    canvas_h = random.randint(min_canvas_h, 30)\n    canvas_w = random.randint(min_canvas_w, 30)\n    placed = mod._place_patches(patches, canvas_h, canvas_w)\n    if placed is None:\n        counts['canvas'] += 1\n        continue\n    inp, expected = placed\n    if mod._most_common(inp) \"'!= mod.BG:\n        counts['\"'bg'] += 1\n        continue\n    try:\n        actual = mod.main(inp)\n    except Exception as e:\n        counts['main_exc'] += 1\n        continue\n    if not np.array_equal(actual, expected):\n        counts['mismatch'] += 1\n        continue\n    counts['ok'] += 1\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
