{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"sed -n '1,130p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && sed -n '582,680p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py && sed -n '1,140p' /home/lixinyu/snap/new/ARC_code/train/97c75046.py && sed -n '251,340p' /home/lixinyu/snap/new/ARC_code/train/97c75046.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg, in_bounds, neighbors4\nimport random\n\n\nCoord = tuple[int, int]\n\n\ndef _unique_marker_color(g: np.ndarray, bg: int) -> int:\n    vals, counts = np.unique(g, return_counts=True)\n    markers = [int(v) for v, n in zip(vals, counts) if int(n) == 1 and int(v) != bg]\n    assert len(markers) == 1, \"expected exactly one non-background marker pixel\"\n    return markers[0]\n\n\ndef _obstacle_color(g: np.ndarray, bg: int, marker: int) -> int:\n    colors = {int(v) for v in np.unique(g)}\n    obstacles = colors - {int(bg), int(marker)}\n    assert len(obstacles) == 1, \"expected one obstacle color besides bg and marker\"\n    return obstacles.pop()\n\n\ndef _adjacent_to_color(g: np.ndarray, pos: Coord, color: int) -> bool:\n    return any(\n        in_bounds(g.shape, rr, cc) and int(g[rr, cc]) == int(color)\n        for rr, cc in neighbors4(*pos)\n    )\n\n\ndef _sightline_to_obstacle(\n    g: np.ndarray, start: Coord, obstacle: int, bg: int\n) -> tuple[Coord, Coord]:\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    hits: list[tuple[Coord, Coord]] = []\n    sr, sc = start\n\n    for dr, dc in dirs:\n        r, c = sr + dr, sc + dc\n        previous_bg: Coord | None = None\n        while in_bounds(g.shape, r, c):\n            color = int(g[r, c])\n            if color == obstacle:\n                assert previous_bg is not None, \"marker should not touch obstacle directly\"\n                hits.append(((dr, dc), previous_bg))\n                break\n            assert color == bg, \"sightline should cross only background before obstacle\"\n            previous_bg = (r, c)\n            r += dr\n            c += dc\n\n    assert len(hits) == 1, \"expected one cardinal sightline from marker to obstacle\"\n    return hits[0]\n\n\ndef _walk_contour(g: np.ndarray, start: Coord, direction: Coord, obstacle: int, bg: int) -> Coord:\n    dr, dc = direction\n    if dr:\n        turns = [(dr, -1), (dr, 1)]\n    else:\n        turns = [(-1, dc), (1, dc)]\n\n    paths: list[tuple[int, Coord]] = []\n    for tr, tc in turns:\n        r, c = start\n        length = 0\n        while True:\n            nr, nc = r + tr, c + tc\n            if not in_bounds(g.shape, nr, nc):\n                break\n            if int(g[nr, nc]) != bg:\n                break\n            if not _adjacent_to_color(g, (nr, nc), obstacle):\n                break\n            r, c = nr, nc\n            length += 1\n        paths.append((length, (r, c)))\n\n    max_len = max(length for length, _ in paths)\n    endpoints = {pos for length, pos in paths if length == max_len}\n    assert len(endpoints) == 1, \"contour walk should have one structural endpoint\"\n    return endpoints.pop()\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the single marker to the endpoint reached by sliding along the obstacle contour.\n\n    Input structure:\n    - A dominant background color fills the canvas.\n    - One single-pixel marker sits away from a connected obstacle region of the\n      remaining color.\n    - The marker has exactly one horizontal or vertical sightline to the obstacle.\n\n    Rule:\n    - Find the last background pixel before the obstacle along that sightline.\n    - From that pixel, try the two diagonal turns that continue around the\n      obstacle boundary.\n    - Move the marker to the endpoint of the turn that remains 4-adjacent to the\n      obstacle for the longest distance.\n\n    Key insight:\n    The marker is not placed by distance to the obstacle; it first points to the\n    obstacle, then follows the visible outside contour until that contour segment ends.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    marker = _unique_marker_color(g, bg)\n    obstacle = _obstacle_color(g, bg, marker)\n\n    marker_coords = np.argwhere(g == marker)\n    assert marker_coords.shape == (1, 2), \"expected exactly one marker pixel\"\n    marker_pos = tuple(map(int, marker_coords[0]))\n\n    direction, contour_start = _sightline_to_obstacle(g, marker_pos, obstacle, bg)\n    assert _adjacent_to_color(g, contour_start, obstacle), \"contour must start next to obstacle\"\n    dest = _walk_contour(g, contour_start, direction, obstacle, bg)\n    assert int(g[dest]) == bg, \"destination should be background\"\n\n    out = g.copy()\n    out[marker_pos] = bg\n    out[dest] = marker\n    return out\n\n# --------------- generator (att2) ---------------\n\nBG_COLOR = 7\nGEN_RETRIES = 300\n\n# Obstacle shape bounds.\nOBSTACLE_HEIGHT_RANGE = (4, 8)\nOBSTACLE_WIDTH_RANGE = (3, 8)\nOBSTACLE_AREA_RANGE = (6, 33)\nMAX_BOUNDARY_LEFT = 7\nBOUNDARY_STEP_PROB = 0.55\n\n# Marker sightline and contour-walk bounds.\nWALK_LEN_RANGE = (1, 4)\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input for 97c75046\")\n","exit_code":0,"status":"completed"}}
