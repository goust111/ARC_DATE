c1 == W - 1\n  57:         assert touches_top != touches_bottom\n  58:         assert touches_left != touches_right\n  59: \n  60:         dr = height if touches_top else -height\n  61:         dc = width if touches_left else -width\n  62:         shifted = coords + np.array([dr, dc], dtype=int)\n  63:         assert bool(\n  64:             np.all(\n  65:                 (0 <= shifted[:, 0])\n  66:                 & (shifted[:, 0] < H)\n  67:                 & (0 <= shifted[:, 1])\n  68:                 & (shifted[:, 1] < W)\n  69:             )\n  70:         )\n  71: \n  72:         target = out[shifted[:, 0], shifted[:, 1]]\n  73:         assert bool(np.all((target == bg) | (target == moving_color)))\n  74:         out[shifted[:, 0], shifted[:, 1]] = moving_color\n  75: \n  76:     return out\n  77: \n  78: # --------------- generator (o5x) ---------------\n  79: \n  80: # Corner and movement model.\n  81: CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n  82: DIAGONAL_PAIRS = ({\"TL\", \"BR\"}, {\"TR\", \"BL\"})\n  83: INWARD_STEP_FACTOR = 2\n  84: COMPACT_CANVAS_FACTOR = 3\n  85: \n  86: # Canvas, object count, and retry bounds.\n  87: GRID_ROW_BOUNDS = (7, 22)\n  88: GRID_COL_BOUNDS = (7, 30)\n  89: SQUARE_SIZE_BOUNDS = (1, 4)\n  90: MOVING_COUNT_BOUNDS = (2, 4)\n  91: GENERATION_RETRIES = 300\n  92: \n  93: # Color palette.\n  94: COLOR_VALUES = tuple(range(10))\n  95: \n  96: def _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n  97:     row = 0 if corner[0] == \"T\" else H - s\n  98:     col = 0 if corner[1] == \"L\" else W - s\n  99:     return row, col\n 100: \n 101: \n 102: def _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n 103:     row = s if corner[0] == \"T\" else H - INWARD_STEP_FACTOR * s\n 104:     col = s if corner[1] == \"L\" else W - INWARD_STEP_FACTOR * s\n 105:     return row, col\n 106: \n 107: \n 108: def _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:\n 109:     sizes = []\n 110:     min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n 111:     min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n 112:     for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):\n 113:         for W in range(min_w, GRID_COL_BOUNDS[1] + 1):\n 114:             bg_area = H * W - len(CORNERS) * s * s\n 115:             if bg_area <= moving_count * s * s:\n 116:                 continue\n 117:             compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n 118:             if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:\n 119:                 continue\n 120:             sizes.append((H, W))\n 121:     return sizes\n 122: \n 123: \n 124: def _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:\n 125:     if moving_count == len(CORNERS):\n 126:         return set(CORNERS)\n 127:     compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n 128:     if moving_count == MOVING_COUNT_BOUNDS[0] and compact:\n 129:         return set(random.choice(DIAGONAL_PAIRS))\n 130:     return set(random.sample(CORNERS, moving_count))\n 131: \n--- lines 202-207 ---\n 202: def generate_input() -> np.ndarray:\n 203:     for _ in range(GENERATION_RETRIES):\n 204:         grid = _gen_attempt()\n 205:         if grid is not None:\n 206:             return grid\n 207:     raise RuntimeError(\"failed to generate valid 22208ba4 input\")\n===== /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py =====\n--- lines 17-137 ---\n  17: def main(grid: np.ndarray) -> np.ndarray:\n  18:     \"\"\"\n  19:     Replace the outlined object with the outside contour of that outline in the marker color.\n  20: \n  21:     Input structure:\n  22:     - A dominant background surrounds one 8-connected foreground outline.\n  23:     - The outline is the unique largest foreground color.\n  24:     - One or more smaller interior colors are inside the outline; the marker color\n  25:       is the unique smallest non-outline color.\n  26: \n  27:     Rule:\n  28:     - Erase all original foreground pixels to background.\n  29:     - Paint every background pixel that is 4-adjacent to the outline with the\n  30:       marker color.\n  31:     - Keep the grid shape unchanged.\n  32: \n  33:     Key insight: The colored interior marker supplies the paint color, while the\n  34:     largest outline supplies only the contour whose outside edge is traced.\n  35:     \"\"\"\n  36:     g = np.asarray(grid, dtype=int)\n  37:     bg = int(get_bg(g))\n  38: \n  39:     counts = Counter(map(int, g.flatten()))\n  40:     foreground_colors = [color for color in counts if color != bg]\n  41:     assert len(foreground_colors) >= 2, \"expected an outline color and a marker color\"\n  42: \n  43:     frame_count = max(counts[color] for color in foreground_colors)\n  44:     frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)\n  45:     assert len(components_mask(g == frame_color, connectivity=8)) == 1, \"outline must be 8-connected\"\n  46: \n  47:     marker_candidates = [color for color in foreground_colors if color != frame_color]\n  48:     marker_count = min(counts[color] for color in marker_candidates)\n  49:     marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)\n  50: \n  51:     out = np.full_like(g, bg)\n  52:     contour: set[tuple[int, int]] = set()\n  53:     for r, c in np.argwhere(g == frame_color):\n  54:         for nr, nc in neighbors4(int(r), int(c)):\n  55:             if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n  56:                 contour.add((int(nr), int(nc)))\n  57:     assert contour, \"expected outline to touch background contour cells\"\n  58: \n  59:     for r, c in contour:\n  60:         out[r, c] = marker_color\n  61:     return out\n  62: \n  63: # --------------- generator (att2) ---------------\n  64: \n  65: GRID_MIN, GRID_MAX = 5, 16\n  66: N_COLORS = 10\n  67: \n  68: SHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\n  69: SHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\n  70: START_WIDTH_MIN, START_WIDTH_MAX = 1, 2\n  71: MAX_LOCAL_WIDTH = 5\n  72: \n  73: MARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n  74: \n  75: GEN_ATTEMPTS = 300\n  76: \n  77: EDGE_TOUCH_TOP_BOTTOM = \"TB\"\n  78: CORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\n  79: ZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n  80: \n  81: \n  82: def _gen_grow_parts(total, n):\n  83:     n_twos = total - n\n  84:     parts = [2] * n_twos + [1] * (n - n_twos)\n  85:     random.shuffle(parts)\n  86:     return parts\n  87: \n  88: def _gen_drop_parts(total, n):\n  89:     if n == 0:\n  90:         return []\n  91:     n_twos = random.randint(max(0, total - n), min(total // 2, n))\n  92:     n_ones = total - 2 * n_twos\n  93:     parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n  94:     random.shuffle(parts)\n  95:     return parts\n  96: \n  97: def _gen_widths(height, max_width):\n  98:     start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n  99:     diff = max_width - start\n 100:     grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n 101:     widths = [start]\n 102:     for inc in _gen_grow_parts(diff, grow_steps):\n 103:         widths.append(widths[-1] + inc)\n 104: \n 105:     remaining = height - len(widths)\n 106:     min_end = max(1, max_width - 2 * remaining)\n 107:     end_width = random.randint(min_end, max_width)\n 108:     for dec in _gen_drop_parts(max_width - end_width, remaining):\n 109:         widths.append(widths[-1] - dec)\n 110:     return widths\n 111: \n 112: def _gen_intervals(widths):\n 113:     left, right = 0, widths[0] - 1\n 114:     intervals = [(left, right)]\n 115:     for prev_width, width in zip(widths, widths[1:]):\n 116:         delta = width - prev_width\n 117:         if delta == 2:\n 118:             left -= 1\n 119:             right += 1\n 120:         elif delta == 1:\n 121:             if random.choice([False, True]):\n 122:                 left -= 1\n 123:             else:\n 124:                 right += 1\n 125:         elif delta == 0:\n 126:             shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n 127:             left += shift\n 128:             right += shift\n 129:         elif delta == -1:\n 130:             if random.choice([False, True]):\n 131:                 left += 1\n 132:             else:\n 133:                 right -= 1\n 134:         elif delta == -2:\n 135:             left += 1\n 136:             right -= 1\n 137:         intervals.append((left, right))\n--- lines 300-305 ---\n 300: def generate_input():\n 301:     for _ in range(GEN_ATTEMPTS):\n 302:         grid = _gen_attempt()\n 303:         if grid is not None:\n 304:             return grid\n 305:     raise RuntimeError(\"failed to generate a valid aa62e3f4 input\")\n","exit_code":0,"status":"completed"}}
