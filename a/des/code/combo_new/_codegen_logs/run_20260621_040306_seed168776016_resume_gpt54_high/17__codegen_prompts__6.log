{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/f0100645.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg, paste\nimport random\n\n\ndef _component_order(coords: np.ndarray, direction: int) -> tuple[int, int, int, int]:\n    rows = coords[:, 0]\n    cols = coords[:, 1]\n    if direction == -1:\n        return (int(cols.min()), int(rows.min()), int(cols.max()), int(rows.max()))\n    assert direction == 1, \"horizontal slide direction must be left or right\"\n    return (-int(cols.max()), int(rows.min()), -int(cols.min()), int(rows.max()))\n\n\ndef _settled_components(g: np.ndarray, color: int, side_col: int, direction: int) -> list[np.ndarray]:\n    h, w = g.shape\n    movable = (g == color)\n    movable[:, side_col] = False\n\n    comps = components_mask(movable, connectivity=8)\n    assert comps, \"expected at least one object away from the matching wall\"\n    comps.sort(key=lambda coords: _component_order(coords, direction))\n\n    settled = np.zeros((h, w), dtype=bool)\n    settled[:, side_col] = True\n    out_coords = []\n\n    for coords in comps:\n        shift = 0\n        while True:\n            candidate = coords + np.array([0, shift + direction])\n            cols = candidate[:, 1]\n            if int(cols.min()) < 0 or int(cols.max()) >= w:\n                break\n            if np.any(settled[candidate[:, 0], candidate[:, 1]]):\n                break\n            shift += direction\n\n        placed = coords + np.array([0, shift])\n        assert not np.any(settled[placed[:, 0], placed[:, 1]]), \"settled objects may touch but not overlap\"\n        settled[placed[:, 0], placed[:, 1]] = True\n        out_coords.append(placed)\n\n    return out_coords\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.\n\n    Input structure\n    - The background is the dominant color.\n    - The only foreground colors are two non-background colors.\n    - One foreground color fills the left column and the other fills the right column.\n    - Extra 8-connected objects of each wall color appear away from that color's wall.\n\n    Rule\n    - Clear the extra objects from their original positions.\n    - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.\n    - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.\n    - Keep the two vertical wall columns fixed.\n\n    Key insight\n    - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and min(g.shape) >= 2, \"expected a non-empty 2D grid with two side columns\"\n\n    bg = get_bg(g)\n    w = g.shape[1]\n    left_color = int(g[0, 0])\n    right_color = int(g[0, w - 1])\n\n    assert left_color != right_color, \"left and right walls must have different colors\"\n    assert bg not in {left_color, right_color}, \"walls must be foreground colors\"\n    assert np.all(g[:, 0] == left_color), \"left wall must fill the full left column\"\n    assert np.all(g[:, w - 1] == right_color), \"right wall must fill the full right column\"\n    assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, \"expected exactly background plus two wall colors\"\n\n    out = np.full_like(g, int(bg))\n    out[:, 0] = left_color\n    out[:, w - 1] = right_color\n\n    placements: list[tuple[int, np.ndarray]] = []\n    for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):\n        for coords in _settled_components(g, color, side_col, direction):\n            placements.append((color, coords))\n\n    occupied = (out != bg)\n    for color, coords in placements:\n        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), \"different colors must not settle on the same pixel\"\n        out[coords[:, 0], coords[:, 1]] = color\n        occupied[coords[:, 0], coords[:, 1]] = True\n\n    assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), \"left color count must be preserved\"\n    assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), \"right color count must be preserved\"\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (9, 10)\nGRID_WIDTH_BOUNDS = (9, 10)\nBACKGROUND_COLOR = 7\nWALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n# Object counts and pixel budgets.\nCOMPONENT_COUNT_BOUNDS = (2, 3)\nINNER_FOREGROUND_BOUNDS = (15, 23)\nSPRITE_PIXEL_BOUNDS = (1, 7)\n# Sprite geometry limits.\nSPRITE_HEIGHT_BOUNDS = (1, 5)\nSPRITE_WIDTH_BOUNDS = (1, 3)\nMIN_SPRITE_DENSITY = 0.56\n# Input scatter and retry limits.\nSCATTER_OFFSET_BOUNDS = (1, 5)\nGENERATION_ATTEMPTS = 300\n\nPlacement = tuple[int, np.ndarray, int, int, bool]\n\n\ndef _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:\n    values = []\n    remaining = int(total)\n    for i in range(int(parts)):\n        slots = int(parts) - i - 1\n        low = max(int(lo), remaining - int(hi) * slots)\n        high = min(int(hi), remaining - int(lo) * slots)\n        value = random.randint(low, high)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _gen_sprite_mask(size: int) -> np.ndarray:\n    size = int(size)\n    dims = [\n        (h, w)\n        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)\n        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)\n        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY\n    ]\n    h, w = random.choice(dims)\n\n    coords: set[tuple[int, int]] = set()\n    length = max(h, w)\n    if length == 1:\n        coords.add((0, 0))\n    else:\n        for i in range(length):\n            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)\n            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)\n            coords.add((int(r), int(c)))\n\n    while len(coords) < size:\n        frontier = []\n        for r, c in coords:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:\n                        frontier.append((nr, nc))\n        coords.add(random.choice(frontier))\n\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in coords:\n        mask[r, c] = True\n    if random.choice([False, True]):\n        mask = np.flipud(mask)\n    if random.choice([False, True]):\n        mask = np.fliplr(mask)\n    return mask.copy()\n\n\ndef _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:\n    return np.argwhere(mask) + np.array([int(r0), int(c0)])\n\n\ndef _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:\n    grid = np.full(shape, int(bg), dtype=int)\n    grid[:, 0] = int(left_color)\n    grid[:, shape[1] - 1] = int(right_color)\n    return grid\n\n\ndef _gen_place_output_side(\n    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int\n) -> list[Placement]:\n    h, w = out.shape\n    placements = []\n    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):\n        mh, mw = mask.shape\n        c0 = 1 if left_side else w - 1 - mw\n        rows = list(range(0, h - mh + 1))\n        random.shuffle(rows)\n        for r0 in rows:\n            coords = _gen_mask_coords(mask, r0, c0)\n            if np.any(out[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(out, patch, r0, c0, transparent=bg)\n            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))\n            break\n        else:\n            return []\n    return placements\n\n\ndef _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:\n    for other in existing:\n        dr = np.abs(coords[:, None, 0] - other[None, :, 0])\n        dc = np.abs(coords[:, None, 1] - other[None, :, 1])\n        if bool(np.any((dr <= 1) & (dc <= 1))):\n            return True\n    return False\n\n\ndef _gen_scatter_input(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]\n) -> np.ndarray | None:\n    h, w = shape\n    inp = _gen_base_grid((h, w), bg, left_color, right_color)\n    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}\n\n    shuffled = list(placements)\n    random.shuffle(shuffled)\n    for color, mask, r0, c_out, left_side in shuffled:\n        mh, mw = mask.shape\n        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)\n        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))\n        random.shuffle(offsets)\n        for offset in offsets:\n            c_in = c_out + offset if left_side else c_out - offset\n            coords = _gen_mask_coords(mask, r0, c_in)\n            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):\n                continue\n            if _gen_touches_existing(coords, by_color[int(color)]):\n                continue\n            patch = np.where(mask, int(color), int(bg))\n            paste(inp, patch, r0, c_in, transparent=bg)\n            by_color[int(color)].append(coords)\n            break\n        else:\n            return None\n    return inp\n\n\ndef _gen_output_layout(\n    shape: tuple[int, int], bg: int, left_color: int, right_color: int,\n    left_masks: list[np.ndarray], right_masks: list[np.ndarray],\n) -> tuple[np.ndarray, list[Placement]] | None:\n    out = _gen_base_grid(shape, bg, left_color, right_color)\n    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)\n    if len(left_placements) != len(left_masks):\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e734a0e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\nimport random\nfrom arc_utils import paste\n\n\ndef _unique_mode(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    ranked = counts.most_common()\n    assert ranked, \"expected a nonempty set of values\"\n    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    return int(ranked[0][0])\n\n\ndef _separator_lines(g: np.ndarray) -> tuple[int, list[int], list[int]]:\n    height, width = map(int, g.shape)\n    candidates = []\n    for color in np.unique(g):\n        color = int(color)\n        rows = [r for r in range(height) if np.all(g[r, :] == color)]\n        cols = [c for c in range(width) if np.all(g[:, c] == color)]\n        if rows and cols:\n            candidates.append((color, rows, cols))\n    assert len(candidates) == 1, \"expected one color to form full separator rows and columns\"\n    return candidates[0]\n\n\ndef _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:\n    spans = []\n    start = 0\n    for sep in separators:\n        assert start < sep, \"separator lines must leave nonempty regions\"\n        spans.append((start, sep - 1))\n        start = sep + 1\n    assert start < length, \"separator lines must leave a final nonempty region\"\n    spans.append((start, length - 1))\n    return spans\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\n    Input structure\n    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n    - One tile contains the only non-background, non-separator colored sprite.\n    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\n    Rule\n    - Keep the separator lines and the source sprite tile unchanged.\n    - Replace each marked target tile with an exact copy of the source tile.\n    - Unmarked background-only tiles remain unchanged.\n\n    Key insight\n    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n\n    separator, sep_rows, sep_cols = _separator_lines(g)\n    row_spans = _spans(g.shape[0], sep_rows)\n    col_spans = _spans(g.shape[1], sep_cols)\n\n    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n    assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n    tile_h = tile_heights.pop()\n    tile_w = tile_widths.pop()\n\n    bg = _unique_mode(g[g != separator])\n    assert bg != separator, \"background and separator colors must differ\"\n    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n    assert len(sprite_colors) == 1, \"expected one sprite color\"\n    sprite_color = sprite_colors[0]\n\n    source_tiles = []\n    marked_origins = []\n    for r0, r1 in row_spans:\n        for c0, c1 in col_spans:\n            tile = g[r0 : r1 + 1, c0 : c1 + 1]\n            assert tile.shape == (tile_h, tile_w)\n            has_sprite = np.any(tile == sprite_color)\n            has_marker = np.any(tile == separator)\n            if has_sprite:\n                assert not has_marker, \"source tile should contain only sprite and background\"\n                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n                source_tiles.append(tile.copy())\n            elif has_marker:\n                assert set(map(int, np.unique(tile))).issubset({bg, separator})\n                marked_origins.append((r0, c0))\n            else:\n                assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n\n    assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n    source_tile = source_tiles[0]\n\n    out = g.copy()\n    for r0, c0 in marked_origins:\n        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Palette: separator, background, and sprite are distinct.\nCOLOR_POOL = range(10)\nPALETTE_SIZE = 3\n# Tile grid dimensions and odd square tile sizes.\nTILE_ROWS_RANGE = (3, 4)\nTILE_COLS_RANGE = (3, 4)\nTILE_SIZE_CHOICES = [3, 5]\nSEPARATOR_WIDTH = 1\n# Sprite density and 4-connected component count by tile size.\nSPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\nSPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\nORIENTATION_COUNT = 4\nFLIP_PROBABILITY = 0.5\n# Marker tiles and retry budget.\nMARKER_COUNT_RANGE = (3, 5)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_neighbors4(r: int, c: int, size: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        rr, cc = r + dr, c + dc\n        if 0 <= rr < size and 0 <= cc < size:\n            yield rr, cc\n\n\ndef _gen_partition(total: int, parts: int) -> list[int]:\n    sizes = [1] * parts\n    for _ in range(total - parts):\n        sizes[random.randrange(parts)] += 1\n    random.shuffle(sizes)\n    return sizes\n\n\ndef _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:\n    size = int(labels.shape[0])\n    for rr, cc in _gen_neighbors4(r, c, size):\n        if labels[rr, cc] not in (0, label):\n            return False\n    return True\n\n\ndef _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:\n    pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])\n    component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))\n    labels = np.zeros((size, size), dtype=int)\n    for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):\n        seed_candidates = [\n            (r, c)\n            for r in range(size)\n            for c in range(size)\n            if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)\n        ]\n        if not seed_candidates:\n            return None\n\n        seed = random.choice(seed_candidates)\n        labels[seed] = label\n        cells = [seed]\n        while len(cells) < component_size:\n            growth = []\n            for r, c in cells:\n                for rr, cc in _gen_neighbors4(r, c, size):\n                    if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):\n                        growth.append((rr, cc))\n            if not growth:\n                return None\n            cell = random.choice(growth)\n            labels[cell] = label\n            cells.append(cell)\n\n    tile = np.full((size, size), bg, dtype=int)\n    tile[labels > 0] = sprite_color\n    tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.fliplr(tile)\n    if random.random() < FLIP_PROBABILITY:\n        tile = np.flipud(tile)\n    return tile.copy()\n\n\ndef _gen_tile_origin(tile_r: int, tile_c: int, tile_size: int) -> tuple[int, int]:\n    return tile_r * (tile_size + SEPARATOR_WIDTH), tile_c * (tile_size + SEPARATOR_WIDTH)\n\n\ndef _gen_base_grid(tile_rows: int, tile_cols: int, tile_size: int, bg: int, separator: int) -> np.ndarray:\n    height = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH\n    width = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH\n    grid = np.full((height, width), bg, dtype=int)\n    grid[tile_size :: tile_size + SEPARATOR_WIDTH, :] = separator\n    grid[:, tile_size :: tile_size + SEPARATOR_WIDTH] = separator\n    return grid\n\n\ndef _gen_paste_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_size: int) -> None:\n    r0, c0 = _gen_tile_origin(pos[0], pos[1], tile_size)\n    paste(grid, tile, r0, c0)\n\n\ndef _gen_render_pair(tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions):\n    expected = _gen_base_grid(tile_rows, tile_cols, tile_size, bg, separator)\n    for pos in [source_pos, *marked_positions]:\n        _gen_paste_tile(expected, pos, sprite_tile, tile_size)\n\n    inp = expected.copy()\n    marker_tile = np.full((tile_size, tile_size), bg, dtype=int)\n    marker_tile[tile_size // 2, tile_size // 2] = separator\n    for pos in marked_positions:\n        _gen_paste_tile(inp, pos, marker_tile, tile_size)\n    return inp, expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    separator, bg, sprite_color = random.sample(COLOR_POOL, PALETTE_SIZE)\n    tile_rows, tile_cols, tile_size = (\n        random.randint(*TILE_ROWS_RANGE),\n        random.randint(*TILE_COLS_RANGE),\n        random.choice(TILE_SIZE_CHOICES),\n    )\n\n    sprite_tile = _gen_sprite_tile(tile_size, bg, sprite_color)\n    if sprite_tile is None:\n        return None\n\n    tile_positions = [(r, c) for r in range(tile_rows) for c in range(tile_cols)]\n    source_pos = random.choice(tile_positions)\n    marker_count = random.randint(*MARKER_COUNT_RANGE)\n    marked_positions = random.sample([pos for pos in tile_positions if pos != source_pos], marker_count)\n    inp, expected = _gen_render_pair(\n        tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions\n    )\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid e734a0e8 input\")\n","exit_code":0,"status":"completed"}}
