hbor cells inside the shape canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:367:    \"\"\"Return True if any patch cell has a non-bg 8-neighbor on canvas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:394:    \"\"\"Return True when a cell and its in-bounds 8-neighborhood are bg.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:509:    \"\"\"Choose grid size/background and return matching output/input canvases.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:519:    \"\"\"Place distinct isolated border anchors into both canvases.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:535:    \"\"\"Expand anchor colors to the sprite count, allowing repeated markers.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:545:    \"\"\"Build sprites in their solved locations and return their align metadata.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:564:    \"\"\"Move solved sprites onto the input canvas along the inverse axis.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:576:    \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/581f7754.py:582:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:59:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:60:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:63:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:69:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:76:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:79:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:491:    \"\"\"Render the primary path columns and return the grid plus long-contour mask.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:502:    \"\"\"Add short distractors, then pad long contours to the sampled pixel target.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:518:    \"\"\"Place channel bars first, then scatter isolated obstacle clusters.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:527:    \"\"\"Build the output-first pair and carry validation metadata.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/753ea09b.py:564:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:38:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:39:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:42:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:48:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:53:    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:54:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/412b6263.py:161:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:255:    \"\"\"Find a 5-cell L-shaped color-9 marker and return its corner position.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:282:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:283:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:286:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:292:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:299:    Key insight:\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:301:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:347:    \"\"\"Return the two bar directions perpendicular to *stem*.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:354:    \"\"\"Return the 4 cells of a T marker: center + stem tip + 2 bar cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:362:    \"\"\"Return the 3 branch cells (stem tip + 2 bar), excluding the center.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:371:    \"\"\"Return cells adjacent to any T cell but not part of the T itself.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:385:    \"\"\"Grow n_regions from random seeds via randomized BFS; returns region-id array or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:431:    \"\"\"Return all directed (src, dst) pairs between adjacent regions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:453:    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:473:    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:514:    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:538:    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:544:    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:556:    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:566:    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:700:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:55:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:56:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:59:    Input structure:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:66:    Rule:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:72:    Key insight:\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:75:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/99caaf76.py:305:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2601afb7.py:29:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/2601afb7.py:30:    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n/home/lixinyu/snap/new/ARC_code/train/2601afb7.py:45:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/2601afb7.py:107:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py:71:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py:72:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py:87:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/ad3b40cf.py:327:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:28:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:29:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:32:    Input structure:\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:38:    Rule:\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:45:    Key insight: The bottom color is not a count; it is the yes/no answer to\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:47:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:145:    \"\"\"True if the 3x3 bitmask spans all four edges (non-empty top/bottom/left/right rows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:162:    \"\"\"Assign 16 colors (one per cell) so each of the 8 palette colors appears 1-3 times.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:174:    \"\"\"Pick 16 distinct 3x3 shape masks with a balanced distribution of fill counts.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:189:    \"\"\"Render a 3x3 bitmask as a CELL x CELL array with 1-pixel border of BG.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:197:    \"\"\"Pick a complete row or column of 4 cells (shuffled order).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:209:    \"\"\"Pick `count` distinct cells that do NOT all share a single row or column.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:252:    \"\"\"Build the expected solver output by green-filling matched cells and verdict band.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:267:    \"\"\"Try to generate one valid input grid; return None on oracle mismatch.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/d8e07eb2.py:297:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
