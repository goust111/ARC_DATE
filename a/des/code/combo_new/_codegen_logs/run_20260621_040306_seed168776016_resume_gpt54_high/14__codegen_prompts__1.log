{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/3dc255db.py',\n'/home/lixinyu/snap/new/ARC_code/train/99caaf76.py',\n'/home/lixinyu/snap/new/ARC_code/train/985ae207.py',\n'/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py',\n]\nfor path in files:\n    lines = Path(path).read_text().splitlines()\n    print(f'FILE {path}')\n    for fn, limit in [('def main', 90), ('def generate_input', 120)]:\n        idx = next(i for i,l in enumerate(lines) if l.startswith(fn))\n        print(f'--- {fn} @ {idx+1}')\n        for line in lines[idx:idx+limit]:\n            print(line)\n        print('--- END')\nPY\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/eval/3dc255db.py\n--- def main @ 36\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Eject content pixels from cup-shaped frames outward along each cup's tail direction.\n\n    Input structure:\n    - bg = background. Hollow cup/Y/funnel frames, each a unique border color.\n    - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.\n    - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.\n\n    Rule:\n    - For each cup, identify its tail spike and tail direction.\n    - Erase all content pixels from the mouth interior.\n    - Draw a straight line of content-colored pixels from the spike outward in the tail direction,\n      one pixel per erased content pixel; cells beyond the grid edge are dropped.\n\n    Key insight: The tail spike is the unique convergent point whose outward direction is opposite\n    the mouth opening where the content lives.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    out = g.copy()\n\n    DIR4 = {\"U\": (-1, 0), \"D\": (1, 0), \"L\": (0, -1), \"R\": (0, 1)}\n    OPPOSITE = {\"U\": \"D\", \"D\": \"U\", \"L\": \"R\", \"R\": \"L\"}\n\n    for border_col in colors_present(g, exclude={bg}):\n        for border_coords in components_mask(g == int(border_col), connectivity=8):\n            if border_coords.size == 0 or int(border_coords.shape[0]) < 5:\n                continue\n\n            r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))\n            bbox = (r0, c0, r1, c1)\n            border_set = {(int(r), int(c)) for r, c in border_coords}\n            corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}\n\n            # Candidate tail spikes: single border cell on a bbox edge, not at a corner.\n            edges = (\n                (\"U\", [p for p in border_set if p[0] == r0]),\n                (\"D\", [p for p in border_set if p[0] == r1]),\n                (\"L\", [p for p in border_set if p[1] == c0]),\n                (\"R\", [p for p in border_set if p[1] == c1]),\n            )\n            candidates = [\n                (d, cells[0]) for d, cells in edges\n                if len(cells) == 1 and cells[0] not in corners\n            ]\n            if not candidates:\n                continue\n\n            # Each candidate: flood from opposite bbox side; keep candidates whose flood\n            # reaches content (non-bg, non-border) cells.\n            passing = []\n            for d, spike in candidates:\n                mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])\n                cnt = Counter()\n                for r, c in mouth:\n                    v = int(g[r, c])\n                    if v != bg and v != int(border_col):\n                        cnt[v] += 1\n                if not cnt:\n                    continue\n                content_col = int(cnt.most_common(1)[0][0])\n                content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]\n                passing.append((d, spike, content_col, content_cells))\n\n            # Only act on cups with an unambiguous tail.\n            if len(passing) != 1:\n                continue\n            tail_dir, spike, content_col, content_cells = passing[0]\n\n            # Erase content, then eject outward.\n            for r, c in content_cells:\n                out[r, c] = bg\n\n            dr, dc = DIR4[tail_dir]\n            sr, sc = spike\n            for t in range(1, len(content_cells) + 1):\n                rr = sr + dr * t\n                cc = sc + dc * t\n                if not (0 <= rr < H and 0 <= cc < W):\n                    break\n                out[rr, cc] = content_col\n\n    return out\n\n# --------------- generator (claude opus) ---------------\n\n# ==== Generator configuration ====\n# Canvas size bounds (inclusive)\n--- END\n--- def generate_input @ 457\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    # Pick intended num_cups once so retries don't skew toward 1-cup (the easiest case).\n    num_cups = int(rng.choice(NUM_CUPS_CHOICES))\n    for _ in range(GEN_RETRIES_PRIMARY):\n        result = _gen_attempt(rng, num_cups=num_cups)\n        if result is not None:\n            return result\n    # Fall back to any num_cups on exhaustion.\n    for _ in range(GEN_RETRIES_FALLBACK):\n        result = _gen_attempt(rng)\n        if result is not None:\n            return result\n    raise RuntimeError(f\"generate_input: failed after {GEN_RETRIES_PRIMARY + GEN_RETRIES_FALLBACK} attempts\")\n--- END\nFILE /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\n--- def main @ 55\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Colors.\n_GEN_BG = 8\n_GEN_MARKER = 1\n_GEN_CENTER = 4\n_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n\n# Object layout.\n_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n_GEN_MARKER_COORDS = {\n    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n}\n_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n\n--- END\n--- def generate_input @ 305\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 99caaf76 input\")\n--- END\nFILE /home/lixinyu/snap/new/ARC_code/train/985ae207.py\n--- def main @ 81\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.\n    - For every control color, there is exactly one separate solid rectangular object of that color.\n\n    Rule\n    - Match each sprite to the unique solid rectangle whose color equals the sprite center.\n    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.\n    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.\n\n    Key insight\n    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 3\n\n    bg = int(get_bg(g))\n    sprites = _find_sprites(g, bg)\n    assert sprites, \"expected at least one 3x3 control-center sprite\"\n\n    out = g.copy()\n    for sprite_bbox, patch, center in sprites:\n        targets = _solid_rectangles(g, bg, center)\n        assert len(targets) == 1, \"each control color must have one solid rectangular target\"\n        target_bbox = targets[0][\"bbox\"]\n        assert not _intersects(sprite_bbox, target_bbox), \"sprite and target must start separate\"\n\n        dr, dc = _direction_to_target(sprite_bbox, target_bbox)\n        r, c = sprite_bbox[0], sprite_bbox[1]\n\n        while True:\n            current_bbox = (r, c, r + 2, c + 2)\n            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w\n            paste(out, patch, r, c)\n\n            if _intersects(current_bbox, target_bbox):\n                break\n\n            r += dr * 3\n            c += dc * 3\n\n    return out\n\n# --------------- generator (att1) ---------------\n# Canvas and colors.\nBG_COLOR, COLOR_COUNT = 8, 10\nGRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25\n\n# Rectangles.\nRECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4\nRECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14\nRECT_MARGIN, RECT_SPACING_PAD = 1, 5\nRECT_PLACEMENT_ATTEMPTS = 50\n\n# Sprites and paths.\nSPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5\nSPRITE_GAPS = [1, 4, 7, 10]\nDIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n# Retry limits.\nGENERATION_ATTEMPTS = 300\n\n\ndef _intersects_check(a, b):\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _has_bg_border(grid, sr, sc, bg):\n    H, W = grid.shape\n    for r in range(sr, sr + SPRITE_SIZE):\n        for c in range(sc, sc + SPRITE_SIZE):\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    if not (sr <= nr < sr + SPRITE_SIZE and sc <= nc < sc + SPRITE_SIZE):\n                        if grid[nr, nc] != bg:\n                            return False\n    return True\n\n\ndef _sample_palette(bg):\n    all_colors = [c for c in range(COLOR_COUNT) if c != bg]\n    random.shuffle(all_colors)\n    num_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n--- END\n--- def generate_input @ 362\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n--- END\nFILE /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\n--- def main @ 101\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n--- END\n--- def generate_input @ 604\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        try:\n            g = _gen_attempt(rng)\n        except Exception:\n            continue\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exceeded retries\")\n--- END\n","exit_code":0,"status":"completed"}}
