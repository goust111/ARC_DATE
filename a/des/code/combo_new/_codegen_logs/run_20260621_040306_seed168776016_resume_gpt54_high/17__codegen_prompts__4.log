{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/e376de54.py | sed '\"'$d'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/e376de54.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align parallel colored line segments so they all share the same start and end positions as a reference line.\n\n    Input structure:\n    - bg = most common color.\n    - Several parallel line segments (diagonal, horizontal, or vertical), each a different color, running in the same direction but starting/ending at different positions.\n\n    Rule:\n    - Detect the dominant direction shared by all segments.\n    - Pick the median segment (by perpendicular offset) as the reference.\n    - Shift every segment along the shared direction so its start aligns with the reference's start, then trim or extend it to match the reference's length.\n    - Grid size stays the same; isolated single pixels are untouched.\n\n    Key insight: The reference is the median line, not the longest; all segments are snapped to its extent regardless of their original length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    d = _pick_main_dir(g, bg)\n    dr, dc = d\n    delta_t = dr * dr + dc * dc\n\n    segments = []\n\n    colors = [int(c) for c in np.unique(g) if int(c) != bg]\n    for col in colors:\n        mask = g == col\n        for r in range(h):\n            for c in range(w):\n                if not mask[r, c]:\n                    continue\n                pr, pc = r - dr, c - dc\n                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:\n                    continue  # not a segment start\n                cells = []\n                rr, cc = r, c\n                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:\n                    cells.append((rr, cc))\n                    rr += dr\n                    cc += dc\n                if len(cells) < 2:\n                    continue\n                start = cells[0]\n                end = cells[-1]\n                segments.append(\n                    {\n                        \"color\": col,\n                        \"cells\": cells,\n                        \"start\": start,\n                        \"end\": end,\n                        \"t_start\": _dot(start, d),\n                        \"t_end\": _dot(end, d),\n                        \"s\": _perp_dot(start, d),\n                        \"len\": len(cells),\n                    }\n                )\n\n    assert segments, \"at least one multi-cell segment must exist\"\n\n    # Pick the reference segment as the one whose line coordinate (perpendicular dot) is the median.\n    s_vals = sorted(s[\"s\"] for s in segments)\n    if delta_t == 2:  # diagonal direction\n        for i in range(len(s_vals) - 1):\n            assert s_vals[i + 1] - s_vals[i] >= 4\n    assert len(s_vals) % 2 == 1, \"segment count must have a single median\"\n    assert len(s_vals) == len(set(s_vals)), \"segment line coordinates must be unique\"\n    s_ref = s_vals[len(s_vals) // 2]\n    ref_cands = [s for s in segments if s[\"s\"] == s_ref]\n    assert len(ref_cands) == 1, \"median reference segment must be unique\"\n    ref = ref_cands[0]\n    ref_t0, ref_t1 = ref[\"t_start\"], ref[\"t_end\"]\n    assert ref_t1 >= ref_t0, \"traced segment coordinates must increase\"\n    assert (ref_t1 - ref_t0) % delta_t == 0, \"reference segment length must align with delta_t\"\n    target_len = (ref_t1 - ref_t0) // delta_t + 1\n\n    out = g.copy()\n\n    # Clear only the original segment pixels (leave isolated pixels unchanged).\n    for s in segments:\n        for r, c in s[\"cells\"]:\n            out[r, c] = bg\n\n    for s in segments:\n        col = s[\"color\"]\n        start = s[\"start\"]\n        # Shift the segment along the main direction so its start aligns to ref_t0,\n        # then draw exactly target_len cells.\n        dt = ref_t0 - s[\"t_start\"]\n        assert dt % delta_t == 0, \"segment shift must be aligned to delta_t\"\n        k = dt // delta_t\n        r0 = start[0] + k * dr\n        c0 = start[1] + k * dc\n        rr, cc = r0, c0\n        for _ in range(target_len):\n            assert 0 <= rr < h and 0 <= cc < w, \"shifted segment must stay in bounds\"\n            out[rr, cc] = col\n            rr += dr\n            cc += dc\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Canvas ---\n_H, _W = 16, 16\n_BG = 7\n\n# --- Directions and colors ---\n_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]\n_COLORS = [1, 2, 3, 5, 6, 8, 9]\n\n# --- Segment counts and reference length ---\n_SEGMENT_COUNTS = [3, 5]           # must be odd for unique median\n_REF_LEN_RANGE = (3, 8)            # inclusive bounds for reference segment length\n_MAX_SEG_LEN = 12                  # upper bound for any individual segment\n\n# --- Perpendicular gap constraints ---\n_PERP_GAP_ORTHO = [2, 3, 4, 5, 6]  # allowed gaps for orthogonal directions\n_PERP_GAP_DIAG = [4, 6]             # allowed gaps for diagonal directions (spec: >= 4)\n\n# --- Color assignment ---\n_MAX_DISTINCT_COLORS = 3            # upper bound on distinct non-bg colors per puzzle\n_SAME_LEN_AVOID_PROB = 0.75         # probability of avoiding ref_len for remaining segments\n\n# --- Search / retry ---\n_T_SCAN_RANGE = (-30, 31)           # range(lo, hi) for feasible t0 search\n_GEN_RETRIES = 300                  # max attempts before raising\n\n\n","exit_code":0,"status":"completed"}}
