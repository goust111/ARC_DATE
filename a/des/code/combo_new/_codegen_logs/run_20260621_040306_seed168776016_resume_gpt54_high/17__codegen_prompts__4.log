{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/17829a00.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each colored object vertically until it touches the matching top or bottom border bar.\n\n    Input structure:\n    - The background is the dominant color.\n    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.\n    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.\n\n    Rule:\n    - Top-bar-colored objects move upward so their bbox top is row 1.\n    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.\n    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.\n\n    Key insight:\n    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h >= 3 and w >= 1\n\n    bg = int(get_bg(g))\n    top_color = int(g[0, 0])\n    bottom_color = int(g[h - 1, 0])\n\n    assert top_color != bg\n    assert bottom_color != bg\n    assert top_color != bottom_color\n    assert bool(np.all(g[0, :] == top_color))\n    assert bool(np.all(g[h - 1, :] == bottom_color))\n    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}\n\n    for c in range(w):\n        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]\n        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]\n        if top_rows and bot_rows:\n            assert max(top_rows) < min(bot_rows), \"top-color objects must be above bottom-color objects in every column\"\n\n    out = np.full_like(g, bg)\n    out[0, :] = top_color\n    out[h - 1, :] = bottom_color\n\n    for color, target_side in ((top_color, \"top\"), (bottom_color, \"bottom\")):\n        components = find_components(\n            g,\n            bg=bg,\n            connectivity=8,\n            monochromatic=True,\n            colors=[color],\n            return_format=\"dict\",\n        )\n        for comp in components:\n            if _is_full_width_border(comp, h, w):\n                continue\n\n            coords = np.asarray(comp[\"coords\"], dtype=int)\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            assert 0 < r0 <= r1 < h - 1\n\n            if target_side == \"top\":\n                dr = 1 - r0\n                assert dr <= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n            else:\n                dr = (h - 2) - r1\n                assert dr >= 0\n                paint = coords + np.array([dr, 0], dtype=int)\n                if dr > 0 and r0 + dr <= r1:\n                    assert c0 == c1\n                    rows = np.arange(r0, r1 + dr + 1, dtype=int)\n                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])\n\n            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))\n            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))\n            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))\n            out[paint[:, 0], paint[:, 1]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import binary_dilation\n\n# -- Grid constants --\nBG = 7\nH = 16\nW = 16\n\n# -- Sprite geometry --\nSPRITE_AREA_MIN = 1\nSPRITE_AREA_MAX = 6\nSPRITE_H_MAX = 4       # bbox height upper bound (exclusive in range)\nSPRITE_W_MAX = 5       # bbox width upper bound (exclusive in range)\nSPRITE_DENSITY_MIN = 0.33  # min fill ratio inside bbox\n\n# -- Object counts per side --\nOBJ_COUNT_MIN = 3      # per color\nOBJ_COUNT_MAX = 5      # per color (inclusive)\nOBJ_TOTAL_MAX = 9      # top_count + bottom_count\n\n# -- Swept segment (single-column overlap case) --\nSWEPT_PROB = 0.15       # probability of including one swept-segment object\nSWEPT_H_MIN = 2        # min input height for swept column\nSWEPT_H_MAX = 4        # max input height (inclusive)\nSWEPT_TOTAL_MAX = 5    # input_h + offset ceiling\n\n# -- Input derivation --\nSLIDE_OFFSET_MAX = 10  # exclusive upper bound for slide offsets (range(1, N))\n\n# -- Retry budgets --\nPLACE_RETRIES = 60     # sprite placement attempts per object\nGEN_RETRIES = 300      # outer generation attempts\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/84551f4c.py | sed '\"'$d'\"'\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.\n    Input structure\n    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.\n    - Blue bars are markers; red bars are body bars that may be chained after a marker.\n    Rule\n    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.\n    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.\n    - Red bars that are not reached from a blue marker remain unchanged.\n    Key insight\n    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g))) - {bg}\n    assert colors <= {MARKER_COLOR, BODY_COLOR}\n    assert MARKER_COLOR in colors\n\n    bars = _vertical_bars(g, bg)\n    by_col = {bar[\"col\"]: bar for bar in bars}\n    assert len(by_col) == len(bars)\n\n    baselines = {bar[\"bottom\"] for bar in bars}\n    assert len(baselines) == 1\n    baseline = baselines.pop()\n    out = g.copy()\n    for bar in bars:\n        if bar[\"color\"] != MARKER_COLOR:\n            continue\n\n        group = [bar]\n        current = bar\n        while True:\n            next_col = current[\"col\"] + current[\"height\"]\n            next_bar = by_col.get(next_col)\n            if next_bar is None:\n                break\n            if next_bar[\"color\"] != BODY_COLOR:\n                break\n            group.append(next_bar)\n            current = next_bar\n\n        for item in group:\n            rows = item[\"coords\"][:, 0]\n            cols = item[\"coords\"][:, 1]\n            out[rows, cols] = bg\n\n        for item in group:\n            col = item[\"col\"]\n            height = item[\"height\"]\n            assert col + height <= g.shape[1]\n            out[baseline, col : col + height] = item[\"color\"]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nMIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30\n\n# Bar and chain structure.\nMIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3\nMIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9\nMIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2\n\n# Layout padding and retry budget.\nGAP_VALUES = (1, 2, 3)\nMAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300\n\n\n","exit_code":0,"status":"completed"}}
