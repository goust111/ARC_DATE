{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask\nimport random\n\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n\ndef _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:\n    \"\"\"\n    Legend is a top region with a background color (typically 5) and 4 vertical bars.\n    Each bar's horizontal position inside its cell encodes turn direction:\n      - bar on left  -> 'L' (turn counterclockwise)\n      - bar on right -> 'R' (turn clockwise)\n    \"\"\"\n    legend = grid[:legend_h, :]\n    assert legend.size, \"legend must be non-empty\"\n    _vals, _cnts = np.unique(legend, return_counts=True); bg = int(_vals[_cnts.argmax()])\n\n    # Separator columns are solid bg throughout the legend.\n    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]\n    assert len(sep_cols) >= 2, \"legend separator columns must exist\"\n\n    turn: dict[int, str] = {}\n    for a, b in zip(sep_cols, sep_cols[1:], strict=False):\n        if b - a <= 2:\n            continue\n        interior = legend[1 : legend_h - 1, a + 1 : b]\n        colors = set(map(int, np.unique(interior)))\n        colors.discard(bg)\n        colors.discard(0)\n        assert len(colors) == 1, \"each legend cell must encode exactly one color\"\n        col = int(next(iter(colors)))\n        xs = np.where(interior == col)[1]\n        x = int(xs[0])  # relative to interior\n        # Decide left/right by proximity to borders (interior is typically 4 cells wide).\n        turn[col] = \"L\" if x <= (interior.shape[1] - 1) // 2 else \"R\"\n    assert len(turn) == 4, \"legend must encode four turn colors\"\n    return turn\n\n\ndef _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:\n    \"\"\"Return (r0,c0,size) for a solid square teal component.\"\"\"\n    candidates: list[tuple[int, int, int]] = []\n    for cells in components_mask(g == teal, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(cells)\n        hh = r1 - r0 + 1\n        ww = c1 - c0 + 1\n        if hh != ww:\n            continue\n        size = hh\n        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:\n            continue\n        candidates.append((int(r0), int(c0), int(size)))\n    assert len(candidates) == 1, \"main grid must contain exactly one solid teal square\"\n    return candidates[0]\n\n\ndef _rot_ccw(d: int) -> int:\n    return (d - 1) % 4\n\n\ndef _rot_cw(d: int) -> int:\n    return (d + 1) % 4\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Emit four teal beams from a square, turning at colored obstacles per a legend.\n\n    Input structure:\n    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n\n    Rule:\n    - Remove the legend from the output.\n    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    - Each beam paints teal over bg cells as it moves.\n    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    - Beams stop at grid edges.\n\n    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n\n    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    legend_bg = 5\n    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    assert rows_with_legend.size, \"legend rows must be present\"\n    legend_h = int(rows_with_legend.max() + 1)\n    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n\n    legend_turn = _parse_legend(g, legend_h)\n\n    base = g[legend_h:, :].copy()\n    assert base.size, \"main grid must remain after legend crop\"\n\n    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    teal = 8\n    src = _find_teal_square(base, teal=teal)\n    sr, sc, sz = src\n\n    out = base.copy()\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n\n    def paint_block(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = teal\n        out[r : r + sz, c : c + sz] = blk\n\n    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n        blk = out[nr : nr + sz, nc : nc + sz]\n        cols = set(map(int, np.unique(blk)))\n        cols.discard(bg)\n        cols.discard(teal)\n        if not cols:\n            return None\n        assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n        return int(next(iter(cols)))\n\n    # Four beams, each is a moving copy of the teal square.\n    for d0 in range(4):\n        r, c, d = sr, sc, d0\n        seen: set[tuple[int, int, int]] = set()\n        while True:\n            state = (r, c, d)\n            assert state not in seen, \"beam path must not cycle\"\n            seen.add(state)\n\n            dr, dc = _DIRS[d]\n            nr, nc = r + dr, c + dc\n            if not in_bounds(nr, nc):\n                break\n\n            oc = obstacle_color_at_next(nr, nc)\n            if oc is None:\n                r, c = nr, nc\n                paint_block(r, c)\n                continue\n\n            assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n            turn = legend_turn[oc]\n            d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\n_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n_N, _E, _S, _W = range(4)\n\n# Color palettes\nLEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend\nBG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background\nLEGEND_BG = 5                                  # legend background color\nTEAL = 8                                       # beam / square color\n\n# Canvas dimensions\nGRID_H_RANGE = (19, 24)                        # main-grid height (rows)\nGRID_W = 24                                    # main-grid width (fixed)\nLEGEND_H = 6                                   # legend height (rows)\nLEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells\n\n# Teal square\nTEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3\nSQUARE_EDGE_GAP = 5                            # min gap from square to grid edges\n\n# Obstacles\nOBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3\nOBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds\nOBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present\nOBS_BOTH_GAP = 2                               # gap subtracted when both sides present\n\n# Span selection\nSPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz\nSPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz\nSPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)\n\n# Retry budget\nMAX_RETRIES = 300\n\n\ndef _rot(d: int, turn: str) -> int:\n    \"\"\"Rotate direction d by turn ('L' = CCW, 'R' = CW).\"\"\"\n    return (d - 1) % 4 if turn == \"L\" else (d + 1) % 4\n\n\n# ── Obstacle span selection ───────────────────────────────────────────\n\ndef _choose_span(\n    axis_len: int,\n    required: list[tuple[int, int]],\n    excluded: list[tuple[int, int]],\n    min_len: int,\n    max_len: int,\n) -> tuple[int, int] | None:\n    \"\"\"Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*.\"\"\"\n    req0 = min(a for a, _ in required)\n    req1 = max(b for _, b in required)\n    lo = max(min_len, req1 - req0 + 1)\n    hi = min(max_len, axis_len)\n    choices: list[tuple[int, int, int]] = []\n    for length in range(lo, hi + 1):\n        start0 = max(0, req1 - length + 1)\n        start1 = min(req0, axis_len - length)\n        for start in range(start0, start1 + 1):\n            end = start + length - 1\n            if all(end < a or start > b for a, b in excluded):\n                choices.append((length, start, end))\n    if not choices:\n        return None\n\n    # Bias mildly toward compact side bars while still covering long-span cases.\n    lengths = sorted({length for length, _, _ in choices})\n    if random.random() < SPAN_COMPACT_PROB:\n        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]\n        pool = [(start, end) for length, start, end in choices if length <= cutoff]\n    else:\n        pool = [(start, end) for _, start, end in choices]\n    return random.choice(pool)\n\n\n# ── Beam simulation (oracle) ──────────────────────────────────────────\n\ndef _simulate_paths(\n    base: np.ndarray, turns: dict[int, str], bg: int\n) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:\n    \"\"\"Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists.\"\"\"\n    vals, counts = np.unique(base, return_counts=True)\n    assert int(vals[counts.argmax()]) == bg\n\n    teal_locs = np.argwhere(base == TEAL)\n    assert teal_locs.size\n    sr, sc = teal_locs.min(axis=0)\n    r1, c1 = teal_locs.max(axis=0)\n    sz = int(r1 - sr + 1)\n    assert sz == int(c1 - sc + 1)\n\n    out = base.copy()\n    H, W = out.shape\n    hits: list[list[tuple[int, int, int, int]]] = []\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W\n\n    def paint(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = TEAL\n\n    def obstacle_at(r: int, c: int) -> int | None:\n        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))\n        colors.discard(bg)\n        colors.discard(TEAL)\n        if not colors:\n            return None\n        assert len(colors) == 1\n","exit_code":0,"status":"completed"}}
