{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, in_bounds\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _runs(line: np.ndarray) -> list[tuple[int, int]]:\n    runs: list[tuple[int, int]] = []\n    start: int | None = None\n    for i, v in enumerate(line):\n        if bool(v) and start is None:\n            start = i\n        if start is not None and (not bool(v) or i == len(line) - 1):\n            end = i - 1 if not bool(v) else i\n            runs.append((start, end))\n            start = None\n    return runs\n\n\ndef _body_thickness(mask: np.ndarray) -> int:\n    lengths: list[int] = []\n    for r in range(mask.shape[0]):\n        lengths.extend(e - s + 1 for s, e in _runs(mask[r]) if e - s + 1 >= 2)\n    for c in range(mask.shape[1]):\n        lengths.extend(e - s + 1 for s, e in _runs(mask[:, c]) if e - s + 1 >= 2)\n\n    assert lengths, \"foreground object must contain runs wider than one pixel\"\n    counts = Counter(lengths)\n    max_count = max(counts.values())\n    return min(length for length, count in counts.items() if count == max_count)\n\n\ndef _fg_neighbors4(mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:\n    return [\n        (dr, dc)\n        for dr, dc in DIRS4\n        if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc])\n    ]\n\n\ndef _n8(mask: np.ndarray, r: int, c: int) -> int:\n    count = 0\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n            if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc]):\n                count += 1\n    return count\n\n\ndef _ray_len(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> int:\n    length = 0\n    rr, cc = r, c\n    while in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n        length += 1\n        rr += dr\n        cc += dc\n    return length\n\n\ndef _opposite_edge(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[int, int]:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        assert rows.size, \"tab column must contain foreground\"\n        return int(rows.max() if dr > 0 else rows.min()), c\n\n    cols = np.flatnonzero(mask[r])\n    assert cols.size, \"tab row must contain foreground\"\n    return r, int(cols.max() if dc > 0 else cols.min())\n\n\ndef _outside_opposite_edge(\n    mask: np.ndarray, r: int, c: int, dr: int, dc: int\n) -> tuple[int, int] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        assert rows.size, \"notch column must contain foreground\"\n        rr = int(rows.max() + 1 if dr > 0 else rows.min() - 1)\n        return (rr, c) if in_bounds(mask.shape, rr, c) else None\n\n    cols = np.flatnonzero(mask[r])\n    assert cols.size, \"notch row must contain foreground\"\n    cc = int(cols.max() + 1 if dc > 0 else cols.min() - 1)\n    return (r, cc) if in_bounds(mask.shape, r, cc) else None\n\n\ndef _tab_sources(mask: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int], tuple[int, int]]]:\n    thickness = _body_thickness(mask)\n    long_ray_threshold = 2 * thickness - 1\n    tabs: list[tuple[tuple[int, int], tuple[int, int], tuple[int, int]]] = []\n\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n\n            neighbors = _fg_neighbors4(mask, r, c)\n            if len(neighbors) != 1:\n                continue\n\n            dr, dc = neighbors[0]\n            length = _ray_len(mask, r, c, dr, dc)\n            has_side_support = _n8(mask, r, c) >= 3\n            crosses_long_body = length > long_ray_threshold\n            if length >= 3 and (has_side_support or crosses_long_body):\n                target = _opposite_edge(mask, r, c, dr, dc)\n                assert target != (r, c), \"tab must project to the opposite side\"\n                tabs.append(((r, c), (dr, dc), target))\n\n    return tabs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Complete each boundary tab or notch by adding the complementary feature on the opposite side of the foreground object.\n\n    Input structure\n    - The grid has exactly two colors: a dominant background and one foreground object.\n    - The foreground object is a thick rectilinear shape with one-pixel tabs and notches on its boundary.\n\n    Rule\n    - A foreground tab is a one-neighbor boundary pixel; project through its full row or column span and remove the opposite edge pixel to make a matching notch.\n    - A background notch is a one-pixel cut with three foreground 4-neighbors; project across the full row or column span and add a tab just outside the opposite edge.\n    - Notches immediately beside a tab source are not independent sources, because that gap belongs to the tab's local boundary shape.\n\n    Key insight\n    - The changed pixels are not color-specific noise; they are paired jigsaw-like boundary features on opposite sides of the same thick row or column cross-section.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g)\n    assert len(colors) == 2, \"task expects exactly one foreground color and one background\"\n    fg_colors = [color for color in colors if color != bg]\n    assert len(fg_colors) == 1, \"task expects a single foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    out = g.copy()\n\n    tabs = _tab_sources(mask)\n    tab_cells = {cell for cell, _direction, _target in tabs}\n    changes = 0\n\n    for _cell, _direction, target in tabs:\n        if out[target] != bg:\n            out[target] = bg\n            changes += 1\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in DIRS4:\n                rr, cc = r + dr, c + dc\n                if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            target = _outside_opposite_edge(mask, r, c, dr, dc)\n            if target is not None and not bool(mask[target]):\n                if out[target] != fg:\n                    out[target] = fg\n                    changes += 1\n\n    assert changes > 0, \"at least one complementary boundary feature must be produced\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 8\n_GEN_FG = 1\n_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Canvas and placement bounds.\n_GEN_ROWS_RANGE = (13, 16)\n_GEN_COLS_RANGE = (15, 17)\n_GEN_MARGIN = 1\n\n# Clean L-shape arm bounds.\n_GEN_H_THICK_RANGE = (3, 5)\n_GEN_V_WIDTH_RANGE = (3, 6)\n_GEN_V_EXTRA_RANGE = (4, 10)\n_GEN_H_WIDTH_RANGE = (11, 14)\n_GEN_MAX_BODY_HEIGHT = 14\n_GEN_MIN_MODE_GAP = 2\n_GEN_MISSING_CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n\n# Boundary source feature counts.\n_GEN_PAIR_COUNT_RANGE = (1, 3)\n_GEN_MAX_TABS = 4\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= r < shape[0] and 0 <= c < shape[1]\n\n\ndef _gen_has_tangent_support(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> bool:\n    if dr:\n        sides = ((r, c - 1), (r, c + 1))\n    else:\n        sides = ((r - 1, c), (r + 1, c))\n    return all(_gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]) for rr, cc in sides)\n\n\ndef _gen_line_edges(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[tuple[int, int], tuple[int, int]] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        if rows.size == 0:\n            return None\n        near_r = int(rows.min() if dr > 0 else rows.max())\n        far_r = int(rows.max() if dr > 0 else rows.min())\n        return (near_r, c), (far_r, c)\n\n    cols = np.flatnonzero(mask[r])\n    if cols.size == 0:\n        return None\n    near_c = int(cols.min() if dc > 0 else cols.max())\n    far_c = int(cols.max() if dc > 0 else cols.min())\n    return (r, near_c), (r, far_c)\n\n\ndef _gen_feature_slots(mask: np.ndarray) -> list[dict]:\n    slots: list[dict] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n            for dr, dc in _GEN_DIRS4:\n                outside_r, outside_c = r - dr, c - dc\n                if not _gen_in_bounds(mask.shape, outside_r, outside_c):\n                    continue\n                if bool(mask[outside_r, outside_c]):\n                    continue\n\n                edges = _gen_line_edges(mask, r, c, dr, dc)\n                if edges is None or edges[0] != (r, c):\n                    continue\n                near, far = edges\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/20fb2937.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location\nimport random\n\n\ndef _solid_separator_row(g: np.ndarray, bg: int) -> int:\n    rows = [\n        r\n        for r in range(g.shape[0])\n        if np.all(g[r] == int(g[r, 0])) and int(g[r, 0]) != int(bg)\n    ]\n    assert len(rows) == 1, \"expected one solid non-background separator row\"\n    return int(rows[0])\n\n\ndef _legend_mapping(g: np.ndarray, sep: int, bg: int) -> tuple[dict[int, int], int]:\n    top = g[:sep]\n    comps = find_components(top, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    sprites = []\n    markers = []\n    for comp in comps:\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        area = int(comp[\"area\"])\n        if area == 1:\n            markers.append(comp)\n        else:\n            assert h == w and area == h * w, \"legend sprites must be filled squares\"\n            sprites.append(comp)\n\n    assert len(sprites) == len(markers) and len(sprites) > 0, \"legend must pair each sprite with one marker\"\n\n    sizes = {int(s[\"bbox\"][2] - s[\"bbox\"][0] + 1) for s in sprites}\n    assert len(sizes) == 1, \"all legend sprites must have the same size\"\n    size = sizes.pop()\n    assert size % 2 == 1, \"legend sprite size must have a center pixel\"\n\n    marker_rows = {int(m[\"coords\"][0][0]) for m in markers}\n    assert len(marker_rows) == 1, \"legend markers must lie on one row\"\n    marker_colors = [int(m[\"color\"]) for m in markers]\n    assert len(set(marker_colors)) == len(marker_colors), \"legend marker colors must be unique\"\n\n    sprites.sort(key=lambda s: (int(s[\"bbox\"][1] + s[\"bbox\"][3]), int(s[\"bbox\"][0])))\n    markers.sort(key=lambda m: (int(m[\"coords\"][0][1]), int(m[\"coords\"][0][0])))\n\n    mapping: dict[int, int] = {}\n    for sprite, marker in zip(sprites, markers):\n        _sr0, sc0, _sr1, sc1 = sprite[\"bbox\"]\n        mr, mc = map(int, marker[\"coords\"][0])\n        assert mc == (int(sc0) + int(sc1)) // 2, \"marker must align with its sprite center column\"\n        assert mr > int(sprite[\"bbox\"][2]), \"marker must sit below its sprite\"\n        mapping[int(marker[\"color\"])] = int(sprite[\"color\"])\n\n    return mapping, int(size)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace each marker below the separator with the mapped top legend square centered on that marker.\n\n    Input structure:\n    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.\n    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.\n    - The lower field contains only background and marker colors from the legend.\n\n    Rule:\n    - Pair legend markers to legend sprites by left-to-right position.\n    - Discard the legend and separator; keep the grid width and the rows below the separator.\n    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.\n\n    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    sep = _solid_separator_row(g, bg)\n    mapping, size = _legend_mapping(g, sep, bg)\n\n    lower = g[sep + 1 :]\n    out = np.full_like(lower, bg)\n    radius = size // 2\n\n    for r, c in np.argwhere(lower != bg):\n        key = int(lower[r, c])\n        assert key in mapping, \"lower field marker must appear in the legend\"\n        r0 = int(r) - radius\n        c0 = int(c) - radius\n        r1 = r0 + size\n        c1 = c0 + size\n        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], \"expanded square must fit in output\"\n        assert np.all(out[r0:r1, c0:c1] == bg), \"expanded squares must not overlap\"\n        out[r0:r1, c0:c1] = mapping[key]\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6\nFIELD_SHAPE = (13, 11)\nFIELD_WIDTH = FIELD_SHAPE[1]\nSQUARE_SIZE = 3\nSQUARE_RADIUS = SQUARE_SIZE // 2\nLEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4\n\n# Palette and object counts.\nPALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nNUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]\n\nEMPTY, MAX_GENERATION_ATTEMPTS = 0, 300\n\n\ndef _color_pairs() -> tuple[list[int], list[int]]:\n    \"\"\"Return disjoint sprite and marker palettes in legend order.\"\"\"\n    picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)\n    return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]\n\n\ndef _place_centers(n: int) -> list[tuple[int, int]] | None:\n    \"\"\"Place non-overlapping 3x3 squares and return their centers.\"\"\"\n    occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)\n    patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)\n    centers: list[tuple[int, int]] = []\n    for _ in range(n):\n        try:\n            r0, c0 = random_free_location(occ, patch, transparent=EMPTY)\n        except ValueError:\n            return None\n        paste(occ, patch, r0, c0)\n        centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))\n    return centers\n\n\ndef _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:\n    \"\"\"Connect square indices whose rendered 3x3 blocks share an edge.\"\"\"\n    neighbors = [set() for _ in centers]\n    for i, (r1, c1) in enumerate(centers):\n        for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):\n            dr = abs(r1 - r2)\n            dc = abs(c1 - c2)\n            if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):\n                neighbors[i].add(j)\n                neighbors[j].add(i)\n    return neighbors\n\n\ndef _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:\n    \"\"\"Assign all color ids while preventing same-color touching squares.\"\"\"\n    neighbors = _touch_graph(centers)\n    order = list(range(len(centers)))\n    random.shuffle(order)\n    order.sort(key=lambda i: len(neighbors[i]), reverse=True)\n    ids: list[int | None] = [None] * len(centers)\n    required = set(range(NUM_COLOR_PAIRS))\n\n    def backtrack(pos: int, used: set[int]) -> bool:\n        if pos == len(order):\n            return used == required\n        if len(required - used) > len(order) - pos:\n            return False\n        i = order[pos]\n        choices = list(range(NUM_COLOR_PAIRS))\n        random.shuffle(choices)\n        for color_id in choices:\n            if any(ids[j] == color_id for j in neighbors[i]):\n                continue\n            ids[i] = color_id\n            if backtrack(pos + 1, used | {color_id}):\n                return True\n            ids[i] = None\n        return False\n\n    if not backtrack(0, set()):\n        return None\n    return [int(x) for x in ids]\n\n\ndef _build_grids(\n    centers: list[tuple[int, int]],\n    square_ids: list[int],\n    sprite_colors: list[int],\n    marker_colors: list[int],\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an assembled input grid and the matching oracle output.\"\"\"\n    out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)\n    for (r, c), idx in zip(centers, square_ids):\n        patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)\n        paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)\n        lower[r, c] = marker_colors[idx]\n\n    legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)\n    for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):\n        c0 = i * LEGEND_COLUMN_STRIDE\n        legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite\n        legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker\n\n    sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)\n    return np.vstack([legend, sep, lower]), out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_colors, marker_colors = _color_pairs()\n    n_squares = random.choice(SQUARE_COUNT_CHOICES)\n    centers = _place_centers(n_squares)\n    if centers is None:\n        return None\n    square_ids = _assign_square_ids(centers)\n    if square_ids is None:\n        return None\n\n    inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 20fb2937 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/902510d5.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:\n    H, W = shape\n    if corner == \"TL\":\n        return int(r), int(c)\n    if corner == \"TR\":\n        return int(r), int(W - 1 - c)\n    if corner == \"BL\":\n        return int(H - 1 - r), int(c)\n    assert corner == \"BR\"\n    return int(H - 1 - r), int(W - 1 - c)\n\n\ndef _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:\n    H, W = out.shape\n    assert side > 0, \"triangle side length must be positive\"\n    for r in range(H):\n        for c in range(W):\n            a, b = _corner_distances((H, W), corner, r, c)\n            if a + b < side:\n                out[r, c] = int(color)\n\n\ndef _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:\n    r0 = min(r for r, _ in coords)\n    r1 = max(r for r, _ in coords)\n    c0 = min(c for _, c in coords)\n    c1 = max(c for _, c in coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    if height != width:\n        return None\n    n = height\n    local = {(r - r0, c - c0) for r, c in coords}\n    main_ok = all((c, r) in local for r, c in local)\n    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)\n    if main_ok:\n        if (0, 0) in local and (n - 1, n - 1) not in local:\n            return \"TL\"\n        if (n - 1, n - 1) in local and (0, 0) not in local:\n            return \"BR\"\n    if anti_ok:\n        if (0, n - 1) in local and (n - 1, 0) not in local:\n            return \"TR\"\n        if (n - 1, 0) in local and (0, n - 1) not in local:\n            return \"BL\"\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.\n\n    Input structure\n    - The background is the dominant color.\n    - Exactly one grid corner contains a foreground control pixel; it gives the\n      corner from which the triangle is painted.\n    - There is one unique largest 8-connected monochrome foreground object, the\n      motif that remains in the output; all other foreground pixels are controls.\n    - Every foreground component outside that motif is a singleton control pixel.\n    - The fill color is the unique control color that appears in at least two\n      non-corner control pixels.\n\n    Rule\n    - Start from a blank background canvas and redraw only the largest motif.\n    - Count the non-corner control pixels; that count is the triangle side.\n    - Paint the fill color on the right-triangle region where those two distances\n      from the marked corner's edges sum to less than the side length.\n\n    Key insight\n    - The scattered singleton controls are counted into a compact triangular\n      stack at the marked corner; only the largest motif is not part of the count.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    corners = {\n        \"TL\": (0, 0),\n        \"TR\": (0, W - 1),\n        \"BL\": (H - 1, 0),\n        \"BR\": (H - 1, W - 1),\n    }\n    marked_corners = [\n        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)\n    ]\n    assert len(marked_corners) == 1, \"expected exactly one foreground corner marker\"\n    corner, (corner_r, corner_c) = marked_corners[0]\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert comps, \"expected at least one foreground component\"\n    max_area = max(int(comp[\"area\"]) for comp in comps)\n    motif_candidates = [comp for comp in comps if int(comp[\"area\"]) == max_area]\n    assert len(motif_candidates) == 1, \"expected a unique largest motif\"\n    motif = motif_candidates[0]\n    motif_color = int(motif[\"color\"])\n    motif_coords = {tuple(map(int, coord)) for coord in motif[\"coords\"]}\n    motif_direction = _diagonal_direction(motif_coords)\n    assert motif_direction is not None, \"motif must be square and diagonal-symmetric\"\n    assert motif_direction == corner, \"corner marker must match motif diagonal direction\"\n\n    control_coords = [\n        (int(r), int(c))\n        for r, c in np.argwhere(g != bg)\n        if (int(r), int(c)) not in motif_coords\n    ]\n    assert (corner_r, corner_c) in control_coords, \"corner marker must be a control pixel\"\n    assert len(control_coords) > 1, \"expected non-corner control pixels\"\n\n    control_components = [comp for comp in comps if comp is not motif]\n    assert all(int(comp[\"area\"]) == 1 for comp in control_components), \"controls must be singleton components\"\n\n    control_counts = Counter(\n        int(g[r, c])\n        for r, c in control_coords\n        if (int(r), int(c)) != (corner_r, corner_c)\n    )\n    fill_candidates = [\n        int(color) for color, count in control_counts.items() if int(count) >= 2\n    ]\n    assert len(fill_candidates) == 1, \"expected one repeated non-corner fill color\"\n    fill_color = fill_candidates[0]\n    side = len(control_coords) - 1\n\n    out = np.full_like(g, bg)\n    for r, c in motif_coords:\n        out[r, c] = motif_color\n    _paint_corner_triangle(out, corner, int(side), fill_color)\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_ATTEMPTS = 300\n\n# Canvas and triangle bounds.\n_GEN_ROW_BOUNDS = (6, 15)\n_GEN_COL_BOUNDS = (9, 14)\n_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)\n\n# Color and control-pixel sampling.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_MARKER_AVOID_FILL_PROB = 0.8\n_GEN_FILL_COUNT_BOUNDS = (2, 3)\n\n# Sparse square motifs observed in the task examples.\n_GEN_MOTIF_TEMPLATES = [\n    (\"..#.\", \".#..\", \"#.#.\", \"...#\"),\n    (\".#...\", \"..#..\", \"..##.\", \".#..#\", \"#....\"),\n    (\n        \"...###...\",\n        \"..#......\",\n        \".##......\",\n        \"#..#.....\",\n        \"#...#....\",\n        \"#....#...\",\n        \"......#..\",\n        \".......#.\",\n        \"........#\",\n    ),\n    (\"#...\", \".#.#\", \"..#.\", \".#..\"),\n    (\"...#\", \"#.#.\", \"##..\", \".##.\"),\n]\n\n\ndef _gen_triangle_mask(shape, corner, side):\n    H, W = shape\n    rr, cc = np.indices((H, W))\n    if corner == \"TL\":\n        return rr + cc < side\n    if corner == \"TR\":\n        return rr + (W - 1 - cc) < side\n    if corner == \"BL\":\n        return (H - 1 - rr) + cc < side\n    return (H - 1 - rr) + (W - 1 - cc) < side\n\n\ndef _gen_dilate8(mask):\n    out = mask.copy()\n    out[1:, :] |= mask[:-1, :]\n    out[:-1, :] |= mask[1:, :]\n    out[:, 1:] |= mask[:, :-1]\n    out[:, :-1] |= mask[:, 1:]\n    out[1:, 1:] |= mask[:-1, :-1]\n    out[1:, :-1] |= mask[:-1, 1:]\n    out[:-1, 1:] |= mask[1:, :-1]\n    out[:-1, :-1] |= mask[1:, 1:]\n    return out\n\n\ndef _gen_patch_from_lines(lines):\n    return np.array([[ch == \"#\" for ch in row] for row in lines], dtype=bool)\n\n\ndef _gen_patch_variants(patch):\n    variants = []\n    seen = set()\n    for k in range(4):\n        rotated = np.rot90(patch, k)\n        for variant in (rotated, np.fliplr(rotated)):\n            key = tuple(map(tuple, variant.astype(int)))\n            if key not in seen:\n                seen.add(key)\n                variants.append(variant.copy())\n    return variants\n\n\ndef _gen_reflect_anti_diagonal(patch):\n    return np.flipud(np.fliplr(patch.T))\n\n\ndef _gen_is_diagonal_symmetric_patch(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return False\n    main_ok = np.array_equal(patch, patch.T)\n    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n\n\ndef _gen_patch_direction(patch):\n    if patch.shape[0] != patch.shape[1]:\n        return None\n    n = patch.shape[0]\n    main_ok = np.array_equal(patch, patch.T)\n    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))\n    if main_ok:\n        if patch[0, 0] and not patch[n - 1, n - 1]:\n            return \"TL\"\n        if patch[n - 1, n - 1] and not patch[0, 0]:\n            return \"BR\"\n    if anti_ok:\n        if patch[0, n - 1] and not patch[n - 1, 0]:\n            return \"TR\"\n        if patch[n - 1, 0] and not patch[0, n - 1]:\n            return \"BL\"\n    return None\n\n\ndef _gen_symmetric_motif_patch(max_h, max_w):\n    candidates = []\n    for lines in _GEN_MOTIF_TEMPLATES:\n        patch = _gen_patch_from_lines(lines)\n        for variant in _gen_patch_variants(patch):\n            h, w = variant.shape\n            direction = _gen_patch_direction(variant)\n            if (\n                h <= max_h\n                and w <= max_w\n                and _gen_is_diagonal_symmetric_patch(variant)\n                and direction is not None\n            ):\n                candidates.append((variant, direction))\n    if not candidates:\n        return None\n    patch, direction = random.choice(candidates)\n","exit_code":0,"status":"completed"}}
