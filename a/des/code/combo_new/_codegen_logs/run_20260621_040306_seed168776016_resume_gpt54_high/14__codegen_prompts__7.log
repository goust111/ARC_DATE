{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(|\"'^def generate_input'\"\\\\(/{show=1} show{print} /\"'^def /&& NR>1 && !/''^def main'\"\\\\(|\"'^def generate_input'\"\\\\(/ && show{show=0}' /home/lixinyu/snap/new/ARC_code/train/edcc2ff0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Keep only the lower-panel colors named by the top markers and expand each marker into an object-count bar.\n\n    Input structure\n    A black instruction strip sits above a non-black rectangular scene panel.  The strip contains one-cell markers\n    in the first column, and each marker color is a candidate object color in the lower panel.  The lower panel has\n    a unique dominant background color and scattered 4-connected foreground objects.\n\n    Rule\n    In the lower panel, preserve objects whose colors appear as top markers and recolor every other foreground\n    object to the panel background.  In the instruction strip, replace each marker by a horizontal run from column 0\n    whose length is the number of 4-connected lower-panel objects of that marker color; erase markers with count 0.\n\n    Key insight\n    The top strip is a color filter plus a compact count summary: marker colors select which lower-panel objects\n    survive, and their bars report the number of surviving objects by color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    panel_start = _lower_panel_start(g)\n    top = g[:panel_start]\n    bottom = g[panel_start:]\n\n    markers = _markers(top)\n    marker_colors = {color for _row, color in markers}\n    panel_bg = _unique_mode(bottom)\n    assert panel_bg not in marker_colors, \"marker colors must be foreground colors in the lower panel\"\n\n    out = np.zeros_like(g)\n    cleaned = bottom.copy()\n    for color in set(map(int, np.unique(bottom))) - marker_colors - {panel_bg}:\n        cleaned[cleaned == color] = panel_bg\n    out[panel_start:] = cleaned\n\n    width = g.shape[1]\n    for row, color in markers:\n        count = len(components_mask(bottom == color, connectivity=4))\n        assert count <= width, \"object count must fit as a horizontal marker bar\"\n        out[row, :count] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and instruction-strip geometry.\n_GEN_HEIGHT = 20\n_GEN_WIDTH = 10\n_GEN_TOP_H = 7\n_GEN_PANEL_H = 13\n_GEN_MARKER_ROWS = (1, 3, 5)\n\n# Palette and object-count ranges.\n_GEN_COLORS = tuple(range(1, 10))\n_GEN_ACTIVE_MARKER_COUNTS = (2, 3)\n_GEN_TOTAL_OBJECTS_RANGE = (6, 11)\n_GEN_OBJECTS_PER_MARKER_RANGE = (1, 5)\n_GEN_DISTRACTOR_COUNT_RANGE = (1, 3)\n_GEN_DISTRACTOR_COLOR_RANGE = (1, 2)\n\n# Blob area and shape sampling.\n_GEN_BLOB_AREAS = (2, 3, 4)\n_GEN_FG_AREA_RANGE = (20, 26)\n_GEN_AREA_SHAPES = {\n    2: ((1, 2), (2, 1)),\n    3: ((1, 3), (3, 1)),\n    4: ((1, 4), (4, 1), (2, 2)),\n}\n\n# Placement and retry limits.\n_GEN_PLACEMENT_BORDER = 1\n_GEN_PLACEMENT_PADDING = 1\n_GEN_PLACEMENT_CONNECTIVITY = 4\n_GEN_RETRY_LIMIT = 300\n\n\ndef _gen_count_split(total, parts):\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid edcc2ff0 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(|\"'^def generate_input'\"\\\\(/{show=1} show{print} /\"'^def /&& NR>1 && !/''^def main'\"\\\\(|\"'^def generate_input'\"\\\\(/ && show{show=0}' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\ndef generate_input():\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 5b37cb25 input\")\n","exit_code":0,"status":"completed"}}
