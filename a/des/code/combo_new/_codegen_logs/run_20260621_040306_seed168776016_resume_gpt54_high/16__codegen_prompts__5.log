{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\n\np = Path('/home/lixinyu/snap/a/des/code/combo_new/seed168776016/16/5.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\n\nstats = Counter()\nfor _ in range(200):\n    g = mod.generate_input()\n    h, w = g.shape\n    seeds = []\n    border = []\n    for c in range(w):\n        border.append((0, c))\n    for r in range(1, h):\n        border.append((r, w - 1))\n    for c in range(w - 2, -1, -1):\n        border.append((h - 1, c))\n    for r in range(h - 2, 0, -1):\n        border.append((r, 0))\n    for r, c in border:\n        v = int(g[r, c])\n        if v not in (mod.BG, mod.MARKER):\n            side, n = mod._seed_side_and_count(g, r, c)\n            seeds.append((side, r, c, n))\n            if side in ('top', 'bottom'):\n                d = min(c, w - 1 - c)\n            else:\n                d = min(r, h - 1 - r)\n            stats['touch' if n >= d else 'no_touch'] += 1\n    by_side = {'top': [], 'right': [], 'bottom': [], 'left': []}\n    for side, r, c, n in seeds:\n        if side in ('top', 'bottom'):\n            by_side[side].append((c, n))\n        else:\n            by_side[side].append((r, n))\n    overlap = False\n    for side, vals in by_side.items():\n        vals.sort()\n        for i in range(len(vals)):\n            for j in range(i + 1, len(vals)):\n                p1, n1 = vals[i]\n                p2, n2 = vals[j]\n                if p1 + n1 >= p2 - n2:\n                    overlap = True\n        if vals:\n            stats[f'side_{side}'] += 1\n    stats['grid_overlap' if overlap else 'grid_no_overlap'] += 1\nprint(dict(stats))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
