{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, numpy as np\n\ndef comps(mask):\n    pts=[(r,c) for r in range(3) for c in range(3) if mask[r,c]]\n    if not pts: return []\n    seen={pts[0]}; st=[pts[0]]\n    while st:\n        r,c=st.pop()\n        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<3 and 0<=nc<3 and mask[nr,nc] and (nr,nc) not in seen:\n                seen.add((nr,nc)); st.append((nr,nc))\n    return seen\n\ndef full_bbox(mask):\n    rs,cs=np.where(mask)\n    return rs.min()==0 and rs.max()==2 and cs.min()==0 and cs.max()==2\n\ndef norm(mask):\n    rs,cs=np.where(mask)\n    sub=mask[rs.min():rs.max()+1, cs.min():cs.max()+1]\n    return sub\n\ndef key_rot(mask):\n    ks=[]\n    for k in range(4):\n        m=np.rot90(mask,k)\n        rs,cs=np.where(m)\n        sub=m[rs.min():rs.max()+1, cs.min():cs.max()+1]\n        ks.append(sub.tobytes()+bytes(sub.shape))\n    return min(ks)\n\ndef horiz_sym_any_orientation(mask):\n    for k in range(4):\n        m=np.rot90(mask,k)\n        if np.array_equal(m, np.fliplr(m)):\n            return True\n    return False\n\ndef rot90_sym(mask):\n    for k in range(4):\n        m=np.rot90(mask,k)\n        if np.array_equal(m, np.rot90(m,-1)):\n            return True\n    return False\n\nclasses={}\nfor bits in range(1,1<<9):\n    mask=np.array([(bits>>i)&1 for i in range(9)],dtype=bool).reshape(3,3)\n    pts=np.argwhere(mask)\n    if len(pts)<3 or len(pts)>6: continue\n    if len(comps(mask))\"'!=len(pts): continue\n    if not full_bbox(mask): continue\n    k=key_rot(mask)\n    classes.setdefault(k,mask)\n\nprint('\"'classes',len(classes))\nfor i,mask in enumerate(classes.values()):\n    hs=horiz_sym_any_orientation(mask)\n    rs=rot90_sym(mask)\n    print('class',i,'cells',mask.sum(),'horiz_sym_any_rot',hs,'rot90sym',rs)\n    for row in mask.astype(int):\n        print(''.join(map(str,row)))\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
