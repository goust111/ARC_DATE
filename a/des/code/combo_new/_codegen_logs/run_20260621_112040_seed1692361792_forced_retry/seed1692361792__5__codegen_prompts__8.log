{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/e39e9282.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, find_components, get_bg\nimport itertools\nimport random\n\n\ndef _squares(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int]]:\n    out: list[tuple[int, int, int, int, int]] = []\n    for comp in find_components(\n        g,\n        bg=bg,\n        colors=[Color.GREY, Color.PINK],\n        connectivity=4,\n    ):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 9\n        assert r1 - r0 == 2 and c1 - c0 == 2\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)\n        out.append((r0, c0, r1, c1, color))\n    assert out\n    return out\n\n\ndef _touch_side(\n    r: int, c: int, square: tuple[int, int, int, int, int]\n) -> str | None:\n    r0, c0, r1, c1, _color = square\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _target_for_marker(\n    r: int, c: int, side: str, square: tuple[int, int, int, int, int]\n) -> tuple[int, int]:\n    r0, c0, r1, c1, color = square\n    if color == Color.PINK:\n        if side in {\"left\", \"right\"}:\n            return r, (c0 + c1) // 2\n        return (r0 + r1) // 2, c\n\n    assert color == Color.GREY\n    if side == \"left\":\n        return r, c0\n    if side == \"right\":\n        return r, c1\n    if side == \"above\":\n        return r0, c\n    assert side == \"below\"\n    return r1, c\n\n\ndef _pink_targets_for_markers(\n    markers: list[tuple[int, int, str]],\n    square: tuple[int, int, int, int, int],\n) -> set[tuple[int, int]]:\n    _r0, _c0, _r1, _c1, color = square\n    assert color == Color.PINK\n    return {_target_for_marker(r, c, side, square) for r, c, side in markers}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n\n    Input structure\n    The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\n    Rule\n    Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\n    Key insight\n    The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = set(map(int, np.unique(g)))\n    assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}\n    assert Color.MAROON in colors\n\n    squares = _squares(g, bg)\n    out = g.copy()\n    out[g == Color.GREY] = bg\n\n    paint: set[tuple[int, int]] = set()\n    remove_sources: list[tuple[int, int]] = []\n    pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}\n    for r, c in np.argwhere(g == Color.MAROON):\n        hits = []\n        for idx, square in enumerate(squares):\n            side = _touch_side(int(r), int(c), square)\n            if side is not None:\n                hits.append((side, idx, square))\n        assert len(hits) == 1\n\n        side, idx, square = hits[0]\n        if square[4] == Color.PINK:\n            pink_markers_by_square.setdefault(idx, []).append((int(r), int(c), side))\n            remove_sources.append((int(r), int(c)))\n        else:\n            target = _target_for_marker(int(r), int(c), side, square)\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for idx, markers in pink_markers_by_square.items():\n        square = squares[idx]\n        for target in _pink_targets_for_markers(markers, square):\n            tr, tc = target\n            assert g[tr, tc] == square[4]\n            paint.add(target)\n\n    for r, c in remove_sources:\n        out[r, c] = bg\n    for r, c in paint:\n        out[r, c] = Color.MAROON\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import paste\n\n\n# Colors.\n_GEN_BG = 8\n_GEN_GREY = 5\n_GEN_PINK = 6\n_GEN_MAROON = 9\n\n# Canvas and square geometry.\n_GEN_CANVAS_MIN = 9\n_GEN_CANVAS_MAX = 15\n_GEN_CANVAS_MAX_DELTA = 2\n_GEN_SQUARE_SIZE = 3\n_GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1\n_GEN_SQUARE_GAP = 1\n\n# Square count bounds.\n_GEN_TOTAL_SQUARE_MIN = 1\n_GEN_TOTAL_SQUARE_MAX = 7\n_GEN_GREY_SQUARE_MAX = 3\n_GEN_PINK_SQUARE_MAX = 4\n\n# Marker side and count bounds.\n_GEN_SIDES = (\"left\", \"right\", \"above\", \"below\")\n_GEN_MARKER_SIDE_MIN = 1\n_GEN_MARKER_SIDE_MAX = 3\n_GEN_MARKER_PER_SIDE_MAX = 3\n_GEN_MARKER_TOTAL_MAX = 5\n\n# Rejection sampling budget.\n_GEN_MAX_ATTEMPTS = 300\n_GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}\n\n_GenSquare = tuple[int, int, int]\n_GenMarker = tuple[int, int, str]\n\n\ndef _gen_square_gap_ok(r0: int, c0: int, squares: list[_GenSquare]) -> bool:\n    last = _GEN_SQUARE_LAST\n    gap = _GEN_SQUARE_GAP\n    r1, c1 = r0 + last, c0 + last\n    for sr0, sc0, _color in squares:\n        sr1, sc1 = sr0 + last, sc0 + last\n        if not (\n            r1 < sr0 - gap\n            or sr1 < r0 - gap\n            or c1 < sc0 - gap\n            or sc1 < c0 - gap\n        ):\n            return False\n    return True\n\n\ndef _gen_place_square(grid: np.ndarray, r0: int, c0: int, color: int) -> None:\n    paste(grid, _GEN_SQUARE_PATCHES[int(color)], r0, c0)\n\n\ndef _gen_side_for_cell(r: int, c: int, square: _GenSquare) -> str | None:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    if r0 <= r <= r1:\n        if c == c0 - 1:\n            return \"left\"\n        if c == c1 + 1:\n            return \"right\"\n    if c0 <= c <= c1:\n        if r == r0 - 1:\n            return \"above\"\n        if r == r1 + 1:\n            return \"below\"\n    return None\n\n\ndef _gen_inside_square(r: int, c: int, square: _GenSquare) -> bool:\n    r0, c0, _color = square\n    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST\n    return r0 <= r <= r1 and c0 <= c <= c1\n\n\ndef _gen_valid_marker_slot(r: int, c: int, squares: list[_GenSquare]) -> bool:\n    if any(_gen_inside_square(r, c, square) for square in squares):\n        return False\n    hits = sum(\n        _gen_side_for_cell(r, c, square) is not None for square in squares\n    )\n    return hits == 1\n\n\ndef _gen_side_slots(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> dict[str, list[tuple[int, int]]]:\n    r0, c0, _color = square\n    edge = _GEN_SQUARE_SIZE\n    raw = {\n        \"left\": [(r, c0 - 1) for r in range(r0, r0 + edge)] if c0 > 0 else [],\n        \"right\": [(r, c0 + edge) for r in range(r0, r0 + edge)] if c0 + edge < W else [],\n        \"above\": [(r0 - 1, c) for c in range(c0, c0 + edge)] if r0 > 0 else [],\n        \"below\": [(r0 + edge, c) for c in range(c0, c0 + edge)] if r0 + edge < H else [],\n    }\n    return {\n        side: [\n            (r, c)\n            for r, c in slots\n            if _gen_valid_marker_slot(r, c, squares)\n        ]\n        for side, slots in raw.items()\n    }\n\n\ndef _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:\n    counts: list[int] = []\n    remaining = int(total)\n    for i, cap in enumerate(caps):\n        rest = caps[i + 1 :]\n        lo = max(1, remaining - sum(rest))\n        hi = min(int(cap), remaining - len(rest))\n        if lo > hi:\n            return None\n        count = random.randint(lo, hi)\n        counts.append(count)\n        remaining -= count\n    return counts if remaining == 0 else None\n\n\ndef _gen_choose_square_markers(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> list[_GenMarker] | None:\n    slots_by_side = _gen_side_slots(H, W, square, squares)\n    options = [\n        (side, slots_by_side[side])\n        for side in _GEN_SIDES\n        if slots_by_side[side]\n    ]\n    if not options:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e376de54.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\n\n_DIR_CANDIDATES = [(0, 1), (1, 0), (1, 1), (1, -1)]  # horiz, vert, diag \\, diag /\n\n\ndef _pick_main_dir(g: np.ndarray, bg: int) -> tuple[int, int]:\n    counts = []\n    h, w = g.shape\n    for dr, dc in _DIR_CANDIDATES:\n        cnt = 0\n        for r in range(h):\n            for c in range(w):\n                v = int(g[r, c])\n                if v == bg:\n                    continue\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == v:\n                    cnt += 1\n        counts.append(((dr, dc), cnt))\n\n    best_cnt = max(cnt for _, cnt in counts)\n    assert best_cnt > 0, \"main direction must be detectable\"\n    best_dirs = [d for d, cnt in counts if cnt == best_cnt]\n    assert len(best_dirs) == 1, \"main direction must be unique\"\n    return best_dirs[0]\n\n\ndef _dot(p: tuple[int, int], d: tuple[int, int]) -> int:\n    return p[0] * d[0] + p[1] * d[1]\n\n\ndef _perp_dot(p: tuple[int, int], d: tuple[int, int]) -> int:\n    # perp to (dr,dc) can be (dc,-dr); dot(p, perp) = r*dc - c*dr\n    return p[0] * d[1] - p[1] * d[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align parallel colored line segments so they all share the same start and end positions as a reference line.\n\n    Input structure:\n    - bg = most common color.\n    - Several parallel line segments (diagonal, horizontal, or vertical), each a different color, running in the same direction but starting/ending at different positions.\n\n    Rule:\n    - Detect the dominant direction shared by all segments.\n    - Pick the median segment (by perpendicular offset) as the reference.\n    - Shift every segment along the shared direction so its start aligns with the reference's start, then trim or extend it to match the reference's length.\n    - Grid size stays the same; isolated single pixels are untouched.\n\n    Key insight: The reference is the median line, not the longest; all segments are snapped to its extent regardless of their original length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    d = _pick_main_dir(g, bg)\n    dr, dc = d\n    delta_t = dr * dr + dc * dc\n\n    segments = []\n\n    colors = [int(c) for c in np.unique(g) if int(c) != bg]\n    for col in colors:\n        mask = g == col\n        for r in range(h):\n            for c in range(w):\n                if not mask[r, c]:\n                    continue\n                pr, pc = r - dr, c - dc\n                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:\n                    continue  # not a segment start\n                cells = []\n                rr, cc = r, c\n                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:\n                    cells.append((rr, cc))\n                    rr += dr\n                    cc += dc\n                if len(cells) < 2:\n                    continue\n                start = cells[0]\n                end = cells[-1]\n                segments.append(\n                    {\n                        \"color\": col,\n                        \"cells\": cells,\n                        \"start\": start,\n                        \"end\": end,\n                        \"t_start\": _dot(start, d),\n                        \"t_end\": _dot(end, d),\n                        \"s\": _perp_dot(start, d),\n                        \"len\": len(cells),\n                    }\n                )\n\n    assert segments, \"at least one multi-cell segment must exist\"\n\n    # Pick the reference segment as the one whose line coordinate (perpendicular dot) is the median.\n    s_vals = sorted(s[\"s\"] for s in segments)\n    if delta_t == 2:  # diagonal direction\n        for i in range(len(s_vals) - 1):\n            assert s_vals[i + 1] - s_vals[i] >= 4\n    assert len(s_vals) % 2 == 1, \"segment count must have a single median\"\n    assert len(s_vals) == len(set(s_vals)), \"segment line coordinates must be unique\"\n    s_ref = s_vals[len(s_vals) // 2]\n    ref_cands = [s for s in segments if s[\"s\"] == s_ref]\n    assert len(ref_cands) == 1, \"median reference segment must be unique\"\n    ref = ref_cands[0]\n    ref_t0, ref_t1 = ref[\"t_start\"], ref[\"t_end\"]\n    assert ref_t1 >= ref_t0, \"traced segment coordinates must increase\"\n    assert (ref_t1 - ref_t0) % delta_t == 0, \"reference segment length must align with delta_t\"\n    target_len = (ref_t1 - ref_t0) // delta_t + 1\n\n    out = g.copy()\n\n    # Clear only the original segment pixels (leave isolated pixels unchanged).\n    for s in segments:\n        for r, c in s[\"cells\"]:\n            out[r, c] = bg\n\n    for s in segments:\n        col = s[\"color\"]\n        start = s[\"start\"]\n        # Shift the segment along the main direction so its start aligns to ref_t0,\n        # then draw exactly target_len cells.\n        dt = ref_t0 - s[\"t_start\"]\n        assert dt % delta_t == 0, \"segment shift must be aligned to delta_t\"\n        k = dt // delta_t\n        r0 = start[0] + k * dr\n        c0 = start[1] + k * dc\n        rr, cc = r0, c0\n        for _ in range(target_len):\n            assert 0 <= rr < h and 0 <= cc < w, \"shifted segment must stay in bounds\"\n            out[rr, cc] = col\n            rr += dr\n            cc += dc\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Canvas ---\n_H, _W = 16, 16\n_BG = 7\n\n# --- Directions and colors ---\n_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]\n_COLORS = [1, 2, 3, 5, 6, 8, 9]\n\n# --- Segment counts and reference length ---\n_SEGMENT_COUNTS = [3, 5]           # must be odd for unique median\n_REF_LEN_RANGE = (3, 8)            # inclusive bounds for reference segment length\n_MAX_SEG_LEN = 12                  # upper bound for any individual segment\n\n# --- Perpendicular gap constraints ---\n_PERP_GAP_ORTHO = [2, 3, 4, 5, 6]  # allowed gaps for orthogonal directions\n_PERP_GAP_DIAG = [4, 6]             # allowed gaps for diagonal directions (spec: >= 4)\n\n# --- Color assignment ---\n_MAX_DISTINCT_COLORS = 3            # upper bound on distinct non-bg colors per puzzle\n_SAME_LEN_AVOID_PROB = 0.75         # probability of avoiding ref_len for remaining segments\n\n# --- Search / retry ---\n_T_SCAN_RANGE = (-30, 31)           # range(lo, hi) for feasible t0 search\n_GEN_RETRIES = 300                  # max attempts before raising\n\n\ndef _step(d):\n    \"\"\"Dot product of direction with itself (1 for ortho, 2 for diag).\"\"\"\n    dr, dc = d\n    return dr * dr + dc * dc\n\n\ndef _cell_from_ts(d, t, s):\n    \"\"\"Convert (t, s) coordinates back to (row, col) for direction d. Returns None if out of bounds.\"\"\"\n    if d == (0, 1):\n        r, c = s, t\n    elif d == (1, 0):\n        r, c = t, -s\n    elif d == (1, 1):\n        if (t + s) % 2 or (t - s) % 2:\n            return None\n        r, c = (t + s) // 2, (t - s) // 2\n    else:\n        if (t - s) % 2 or (-s - t) % 2:\n            return None\n        r, c = (t - s) // 2, (-s - t) // 2\n    if 0 <= r < _H and 0 <= c < _W:\n        return r, c\n    return None\n\n\ndef _segment_cells(d, t0, s, length):\n    \"\"\"Return list of (r, c) for a segment starting at t0 with given perpendicular offset s, or None if any cell is OOB.\"\"\"\n    delta = _step(d)\n    cells = []\n    for k in range(length):\n        cell = _cell_from_ts(d, t0 + k * delta, s)\n        if cell is None:\n            return None\n        cells.append(cell)\n    return cells\n\n\ndef _max_len_from(d, t0, s):\n    \"\"\"Max segment length extending forward from t0 at perpendicular offset s.\"\"\"\n    delta = _step(d)\n    length = 0\n    while _cell_from_ts(d, t0 + length * delta, s) is not None:\n        length += 1\n    return length\n\n\ndef _max_len_to(d, t1, s):\n    \"\"\"Max segment length extending backward from t1 at perpendicular offset s.\"\"\"\n    delta = _step(d)\n    length = 0\n    while _cell_from_ts(d, t1 - length * delta, s) is not None:\n        length += 1\n    return length\n\n\ndef _s_limits(d):\n    \"\"\"Valid range (lo, hi) inclusive for perpendicular offset s given direction d.\"\"\"\n    if d == (0, 1):\n        return 0, 15\n    if d == (1, 0):\n        return -15, 0\n    if d == (1, 1):\n        return -15, 15\n    return -30, 0\n\n\ndef _gap_patterns(d, n):\n    \"\"\"Enumerate all valid perpendicular gap sequences of length n-1, ensuring irregular spacing.\"\"\"\n    allowed = _PERP_GAP_DIAG if d in [(1, 1), (1, -1)] else _PERP_GAP_ORTHO\n    lo, hi = _s_limits(d)\n    max_span = hi - lo\n    patterns = [[]]\n    for _ in range(n - 1):\n        patterns = [p + [g] for p in patterns for g in allowed]\n    return [\n        p\n        for p in patterns\n        if sum(p) <= max_span and (n == 3 and p[0] != p[1] or n == 5 and len(set(p)) > 1)\n    ]\n\n\ndef _choose_offsets(d, n):\n    \"\"\"Pick n distinct perpendicular offsets with irregular gaps.\"\"\"\n    lo, hi = _s_limits(d)\n    gaps = random.choice(_gap_patterns(d, n))\n    s0 = random.randint(lo, hi - sum(gaps))\n    s_vals = [s0]\n    for gap in gaps:\n        s_vals.append(s_vals[-1] + gap)\n    return tuple(s_vals)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/b10624e5.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste\nimport random\n\n\ndef _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:\n    \"\"\"\n    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).\n    \"\"\"\n    h, w = g.shape\n    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]\n    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]\n    matches = []\n    for r, vr in full_rows:\n        for c, vc in full_cols:\n            if vr == vc:\n                matches.append((int(r), int(c)))\n    assert len(matches) == 1, \"grid must have exactly one matching full-row/full-col divider\"\n    return matches[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.\n\n    Input structure:\n    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.\n    - Each quadrant contains a red (2) square anchor block of varying size.\n    - The top-left quadrant also has a colored motif attached to its red anchor.\n\n    Rule:\n    - Use the top-left quadrant's motif as the source pattern.\n    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.\n    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).\n    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.\n\n    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    out = g.copy()\n\n    bg = get_bg(g)\n    mid_r, mid_c = _find_dividers(g, bg)\n\n    # Find red anchor blocks (color 2) in each quadrant.\n    red = components_mask(g == 2, connectivity=4)\n    assert red, \"grid must contain red (color 2) anchor blocks\"\n\n    # Quadrant key: (top/bottom, left/right)\n    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}\n    # value: (r0,c0,size)\n    for pts in red:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        rr = (r0 + r1) // 2\n        cc = (c0 + c1) // 2\n        qb = 0 if rr < mid_r else 1\n        qr = 0 if cc < mid_c else 1\n        size = max(r1 - r0 + 1, c1 - c0 + 1)\n        key = (qb, qr)\n        assert key not in anchors, \"each quadrant must contain exactly one red anchor block\"\n        anchors[key] = (int(r0), int(c0), int(size))\n\n    assert (0, 0) in anchors, \"top-left quadrant must contain a red anchor block\"\n    sr0, sc0, sL = anchors[(0, 0)]\n    assert sL > 0, \"top-left red anchor must have positive size\"\n\n    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)\n    # in the TL quadrant that contains the TL red anchor.\n    tl = g[0:mid_r, 0:mid_c]\n    comps = components_mask(tl != bg, connectivity=4)\n    patch_bb = None\n    for pts in comps:\n        # component contains any red pixel?\n        if any(tl[r, c] == 2 for r, c in pts):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            patch_bb = (int(r0), int(c0), int(r1), int(c1))\n            break\n    assert patch_bb is not None, \"top-left quadrant must contain a non-bg component with a red pixel\"\n\n    pr0, pc0, pr1, pc1 = patch_bb\n    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()\n\n    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n        src_h, src_w = img.shape\n        if new_h <= 0 or new_w <= 0:\n            return img.copy()\n        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)\n        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)\n        rr = np.clip(rr, 0, src_h - 1)\n        cc = np.clip(cc, 0, src_w - 1)\n        return img[rr[:, None], cc[None, :]]\n\n    # For each quadrant anchor, paste a scaled/reflected version of the patch.\n    for (qb, qr), (tr0, tc0, tL) in anchors.items():\n        if (qb, qr) == (0, 0):\n            continue\n        patch_t = patch\n        if qr == 1:\n            patch_t = np.fliplr(patch_t)\n        if qb == 1:\n            patch_t = np.flipud(patch_t)\n\n        ratio = float(tL) / float(sL)\n        new_h = int(round(patch_t.shape[0] * ratio))\n        new_w = int(round(patch_t.shape[1] * ratio))\n        new_h = max(1, new_h)\n        new_w = max(1, new_w)\n        patch_s = resize_nn(patch_t, new_h, new_w)\n        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])\n        assert np.array_equal(roundtrip, patch_t), \"scaling must preserve all motif information\"\n\n        # Align scaled red bbox in patch_s to the target red bbox.\n        rr_red, cc_red = np.where(patch_s == 2)\n        assert rr_red.size > 0, \"scaled source patch must contain red anchor pixels\"\n        ar0, ac0 = int(rr_red.min()), int(cc_red.min())\n        place_r0 = tr0 - ar0\n        place_c0 = tc0 - ac0\n\n        rr_p, cc_p = np.where(patch_s != bg)\n        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):\n            val = int(patch_s[rr0, cc0])\n            rr_t = place_r0 + rr0\n            cc_t = place_c0 + cc0\n            if not (0 <= rr_t < h and 0 <= cc_t < w):\n                continue\n            if rr_t == mid_r or cc_t == mid_c:\n                continue\n            if out[rr_t, cc_t] == 2:\n                continue\n            out[rr_t, cc_t] = val\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Grid constants ---\nBG = 4                  # background color\nDIV = 1                 # divider color\nRED = 2                 # anchor color\nGRID_SIZE = 27          # full grid dimension\nMID = 13                # divider row/col index\nQUADS = {               # (row_lo, row_hi, col_lo, col_hi) inclusive per quadrant\n    (0, 0): (0, 12, 0, 12),\n    (0, 1): (0, 12, 14, 26),\n    (1, 0): (14, 26, 0, 12),\n    (1, 1): (14, 26, 14, 26),\n}\n\n# --- Source motif parameters ---\nSOURCE_ANCHOR_SIZE = 2                  # TL anchor is always 2x2\nBLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]  # logical block sizes for block method\nBLOCK_PROB = 0.5                        # prob of block method when not forced\nFILL_RATIO_MIN = 0.5                    # minimum motif fill ratio\nFILL_RATIO_MAX = 0.8                    # maximum motif fill ratio\nFREEFORM_H_RANGE = (3, 6)              # freeform motif height range\nFREEFORM_W_RANGE = (3, 6)              # freeform motif width range\nMOTIF_COLORS_MIN = 3                    # min distinct non-bg colors (including red)\nMOTIF_COLORS_MAX = 5                    # max distinct non-bg colors\nCOLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors\n\n# --- Target anchor parameters ---\nTARGET_SIZE_RANGE = (1, 4)              # anchor size range for non-TL quadrants\n\n# --- Generation retry limit ---\nMAX_RETRIES = 300\n\n\ndef _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor resize supporting fractional scale ratios.\"\"\"\n    src_h, src_w = img.shape\n    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)\n    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)\n    return img[rr[:, None], cc[None, :]]\n\n\ndef _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:\n    \"\"\"Reflect and scale the source patch for a given quadrant and target anchor size.\"\"\"\n    p = patch\n    if qr:\n        p = np.fliplr(p)\n    if qb:\n        p = np.flipud(p)\n    ratio = target_size / SOURCE_ANCHOR_SIZE\n    h = max(1, int(round(p.shape[0] * ratio)))\n    w = max(1, int(round(p.shape[1] * ratio)))\n    return _resize_nn(p, h, w)\n\n\ndef _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:\n    \"\"\"Grow a 4-connected region from seeds until it has n_fill cells.\"\"\"\n    filled = set(seeds)\n    frontier = set()\n    for r, c in seeds:\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n                frontier.add((nr, nc))\n    while len(filled) < n_fill and frontier:\n        cell = random.choice(list(frontier))\n        filled.add(cell)\n        frontier.discard(cell)\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = cell[0] + dr, cell[1] + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n                frontier.add((nr, nc))\n    return filled\n\n\ndef _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],\n                   h: int, w: int) -> np.ndarray | None:\n    \"\"\"Assign random colors to filled cells; returns None if coverage is incomplete.\"\"\"\n    rows = {r for r, _ in filled}\n    cols = {c for _, c in filled}\n    if rows != set(range(h)) or cols != set(range(w)):\n        return None\n    non_red = [p for p in filled if p not in red_cells]\n    random.shuffle(non_red)\n    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)\n    if max_colors < MOTIF_COLORS_MIN:\n        return None\n    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)\n    pool = COLOR_POOL[:]\n    random.shuffle(pool)\n    extras = pool[: n_colors - 1]\n    grid = np.full((h, w), BG, dtype=int)\n    for r, c in red_cells:\n        grid[r, c] = RED\n    for i, (r, c) in enumerate(non_red):\n        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)\n    return grid\n\n\ndef _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:\n    \"\"\"Build the TL motif patch. Block method upscales a logical grid by SOURCE_ANCHOR_SIZE;\n    freeform method grows directly at pixel resolution with a 2x2 red anchor.\"\"\"\n    S = SOURCE_ANCHOR_SIZE\n    use_block = needs_block or random.random() < BLOCK_PROB\n    if use_block:\n        lh, lw = random.choice(BLOCK_DIMS)\n        n_cells = lh * lw\n        min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))\n        max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))\n        ar, ac = random.randrange(lh), random.randrange(lw)\n        filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))\n        logical = _assign_colors(filled, {(ar, ac)}, lh, lw)\n        if logical is None:\n            return None\n        patch = np.repeat(np.repeat(logical, S, axis=0), S, axis=1)\n        return patch, ar * S, ac * S\n    else:\n        h = random.randint(*FREEFORM_H_RANGE)\n        w = random.randint(*FREEFORM_W_RANGE)\n        ar, ac = random.randint(0, h - S), random.randint(0, w - S)\n        red_cells = {(ar + dr, ac + dc) for dr in range(S) for dc in range(S)}\n        min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))\n        max_fill = int(np.floor(FILL_RATIO_MAX * h * w))\n        if max_fill < min_fill:\n            return None\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/84ba50d3.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:\n    rows: list[tuple[int, int]] = []\n    for r in range(g.shape[0]):\n        row_colors = set(map(int, g[r]))\n        if len(row_colors) == 1:\n            color = next(iter(row_colors))\n            if int(color) != int(bg):\n                rows.append((int(r), int(color)))\n    assert len(rows) == 1, \"expected exactly one solid non-background divider row\"\n    return rows[0]\n\n\ndef _unique_widest_row(coords: np.ndarray) -> int:\n    row_counts: list[tuple[int, int]] = []\n    for r in sorted(set(map(int, coords[:, 0]))):\n        row_cols = np.sort(coords[coords[:, 0] == r, 1])\n        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))\n        row_counts.append((int(row_cols.size), int(r)))\n\n    max_count = max(count for count, _r in row_counts)\n    widest = [r for count, r in row_counts if count == max_count]\n    assert max_count > 1, \"multi-column sprites must have a horizontal span\"\n    assert len(widest) == 1, \"expected a unique widest horizontal row\"\n    return int(widest[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.\n\n    Input structure:\n    - The background is the dominant color.\n    - One non-background color forms a single full-width horizontal divider row.\n    - The other non-background color forms 4-connected sprites above the divider.\n\n    Rule:\n    - Clear the original sprite pixels.\n    - A one-column sprite falls to the bottom of its column and deletes the divider\n      pixel it crossed.\n    - Any wider sprite falls until its unique widest horizontal row is immediately\n      above the divider row; if the moved sprite overlaps the divider, it covers it.\n\n    Key insight:\n    The red row is not a generic floor: only one-column sprites pass through to the\n    bottom, while wider sprites are registered by their widest horizontal segment.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n    line_r, line_color = _divider_row(g, bg)\n\n    non_bg_colors = set(map(int, g.ravel())) - {bg}\n    sprite_colors = non_bg_colors - {line_color}\n    assert len(sprite_colors) == 1, \"expected exactly one sprite color\"\n    sprite_color = next(iter(sprite_colors))\n\n    sprites = find_components(\n        g,\n        bg=bg,\n        colors=[sprite_color],\n        connectivity=4,\n        monochromatic=True,\n    )\n    assert sprites, \"expected at least one sprite\"\n\n    out = g.copy()\n    out[g == sprite_color] = bg\n    occupied = np.zeros((H, W), dtype=bool)\n\n    for sprite in sprites:\n        coords = sprite[\"coords\"]\n        _r0, c0, r1, c1 = map(int, sprite[\"bbox\"])\n        assert r1 < line_r, \"all sprites must begin above the divider\"\n\n        if c0 == c1:\n            shift = H - 1 - r1\n            assert shift >= 0\n            assert int(out[line_r, c0]) == line_color\n            out[line_r, c0] = bg\n        else:\n            widest_r = _unique_widest_row(coords)\n            shift = line_r - 1 - widest_r\n            assert shift >= 0\n\n        moved = coords.copy()\n        moved[:, 0] += shift\n        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))\n        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))\n\n        for rr, cc in moved:\n            r = int(rr)\n            c = int(cc)\n            assert not occupied[r, c], \"moved sprites must not overlap\"\n            occupied[r, c] = True\n            out[r, c] = sprite_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas, palette, and divider bounds.\nMIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18\nLARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3\nADJACENT_ROW_OFFSET = 1\n\n# Sprite counts, spacing, and retry limits.\nMIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5\nMAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3\nGAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1\nGENERATION_RETRIES = 300\n\n# Sprite geometry.\nMIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5\nSINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3\nWIDE_MULTI_PROB = 0.5\n\n\ndef _composition(total: int, parts: int) -> list[int]:\n    shares = [0] * parts\n    for _ in range(total):\n        shares[random.randrange(parts)] += 1\n    return shares\n\n\ndef _min_layout_width(n_single: int, n_multi: int) -> int:\n    n = n_single + n_multi\n    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)\n\n\ndef _count_pairs(width: int) -> list[tuple[int, int]]:\n    pairs: list[tuple[int, int]] = []\n    for n_single in range(MAX_SINGLE_SPRITES + 1):\n        for n_multi in range(MAX_MULTI_SPRITES + 1):\n            n = n_single + n_multi\n            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:\n                pairs.append((n_single, n_multi))\n    return pairs\n\n\ndef _place_intervals(widths: list[int], grid_width: int) -> list[int]:\n    n = len(widths)\n    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)\n    extra = grid_width - base\n    assert extra >= 0\n    gaps = _composition(extra, n + 1)\n\n    starts: list[int] = []\n    c = gaps[0]\n    for i, width in enumerate(widths):\n        starts.append(c)\n        c += width\n        if i < n - 1:\n            c += GAP_COLUMNS + gaps[i + 1]\n    return starts\n\n\ndef _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:\n    coords = {(top + r, left + spine_col) for r in range(height)}\n    coords.update((top + bar_row, left + c) for c in range(width))\n    return np.array(sorted(coords), dtype=int)\n\n\ndef _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:\n    descriptors: list[dict[str, int | str]] = []\n    for _ in range(n_single):\n        descriptors.append(\n            {\"kind\": \"single\", \"width\": SINGLE_WIDTH, \"height\": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}\n        )\n\n    extra_width = grid_width - _min_layout_width(n_single, n_multi)\n    for _ in range(n_multi):\n        width = MIN_MULTI_WIDTH\n        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:\n            width = MAX_MULTI_WIDTH\n            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH\n        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)\n        descriptors.append(\n            {\n                \"kind\": \"multi\",\n                \"width\": width,\n                \"height\": height,\n                \"bar_row\": random.randint(0, height - ADJACENT_ROW_OFFSET),\n                \"spine_col\": random.randrange(width),\n            }\n        )\n\n    random.shuffle(descriptors)\n    return descriptors\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)\n    W = H\n    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)\n    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))\n    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]\n    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]\n\n    pairs = _count_pairs(W)\n    if not pairs:\n        return None\n    n_single, n_multi = random.choice(pairs)\n\n    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)\n    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)\n    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):\n        return None\n\n    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)\n    starts = _place_intervals([int(d[\"width\"]) for d in descriptors], W)\n\n    inp = np.full((H, W), bg, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    inp[divider_r, :] = divider_color\n    out[divider_r, :] = divider_color\n\n    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET\n    for desc, left in zip(descriptors, starts):\n        height = int(desc[\"height\"])\n        width = int(desc[\"width\"])\n        if desc[\"kind\"] == \"single\":\n            col = left\n            out[divider_r, col] = bg\n            out[H - height : H, col] = sprite_color\n\n            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)\n            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color\n            continue\n\n        bar_row = int(desc[\"bar_row\"])\n        spine_col = int(desc[\"spine_col\"])\n        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row\n        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)\n        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):\n            return None\n        out[landed[:, 0], landed[:, 1]] = sprite_color\n\n        landed_bottom = int(landed[:, 0].max())\n        min_shift = landed_bottom - input_max_bottom\n        max_shift = landed_top\n        if min_shift > max_shift:\n            return None\n        shift = random.randint(min_shift, max_shift)\n        original = landed.copy()\n        original[:, 0] -= shift\n        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):\n            return None\n        inp[original[:, 0], original[:, 1]] = sprite_color\n\n    bg_count = int(np.count_nonzero(inp == bg))\n    if bg_count <= int(np.count_nonzero(inp == divider_color)):\n        return None\n","exit_code":0,"status":"completed"}}
