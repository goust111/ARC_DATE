{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import defaultdict\n\nBLACK=0\nGREY=5\nPRIORITY={\\\"down\\\":0,\\\"right\\\":1,\\\"left\\\":2,\\\"up\\\":3}\nDIR_DELTA={\\\"up\\\":(-1,0),\\\"down\\\":(1,0),\\\"left\\\":(0,-1),\\\"right\\\":(0,1)}\n\ndef incoming(cell,nr,nc):\n    r,c=cell\n    ans=[]\n    if r>0: ans.append(((r-1,c),\\\"down\\\"))\n    if r+1<nr: ans.append(((r+1,c),\\\"up\\\"))\n    if c>0: ans.append(((r,c-1),\\\"right\\\"))\n    if c+1<nc: ans.append(((r,c+1),\\\"left\\\"))\n    return ans\n\ndef outgoing(cell,nr,nc):\n    r,c=cell\n    ds=[]\n    if r>0: ds.append(\\\"up\\\")\n    if r+1<nr: ds.append(\\\"down\\\")\n    if c>0: ds.append(\\\"left\\\")\n    if c+1<nc: ds.append(\\\"right\\\")\n    return ds\n\ndef step(cell,d,nr,nc):\n    r,c=cell\n    dr,dc=DIR_DELTA[d]\n    r+=dr; c+=dc\n    if 0<=r<nr and 0<=c<nc:\n        return (r,c)\n    return None\n\ndef plan_once():\n    nr=random.randint(3,4)\n    nc=random.randint(3,4)\n    cells=[(r,c) for r in range(nr) for c in range(nc)]\n    arrows={}\n    reserved_empty=set()\n\n    comp_target=random.choice([cell for cell in cells if len(incoming(cell,nr,nc))>=2])\n    reserved_empty.add(comp_target)\n    claimants=random.sample(incoming(comp_target,nr,nc), random.randint(2, min(4, len(incoming(comp_target,nr,nc)))))\n    for src,d in claimants:\n        arrows[src]=d\n\n    used=set(arrows)|reserved_empty\n    blocked_options=[]\n    for cell in cells:\n        if cell in used:\n            continue\n        ins=[pair for pair in incoming(cell,nr,nc) if pair[0] not in used]\n        if ins and outgoing(cell,nr,nc):\n            blocked_options.append((cell,ins))\n    if not blocked_options:\n        return None\n    blocked_target, ins = random.choice(blocked_options)\n    arrows[blocked_target]=random.choice(outgoing(blocked_target,nr,nc))\n    used.add(blocked_target)\n    ins=[pair for pair in incoming(blocked_target,nr,nc) if pair[0] not in used]\n    if not ins:\n        return None\n    src,d=random.choice(ins)\n    arrows[src]=d\n    used.add(src)\n\n    free_options=[]\n    for cell in cells:\n        if cell in used:\n            continue\n        ins=[pair for pair in incoming(cell,nr,nc) if pair[0] not in used]\n        if ins:\n            free_options.append((cell,ins))\n    if not free_options:\n        return None\n    free_target, ins = random.choice(free_options)\n    reserved_empty.add(free_target)\n    used.add(free_target)\n    src,d=random.choice(ins)\n    arrows[src]=d\n    used.add(src)\n\n    remaining=[cell for cell in cells if cell not in used]\n    random.shuffle(remaining)\n    extra_budget=min(2, len(remaining))\n    extra_count=random.randint(0, extra_budget)\n    extras=0\n    for cell in remaining:\n        if extras>=extra_count:\n            break\n        if random.random()<0.65 and outgoing(cell,nr,nc):\n            arrows[cell]=random.choice(outgoing(cell,nr,nc))\n            extras+=1\n\n    claims=defaultdict(list)\n    for src,d in arrows.items():\n        tgt=step(src,d,nr,nc)\n        if tgt is not None:\n            claims[tgt].append((11, PRIORITY[d], src, d))\n    single=[]\n    comp=[]\n    blocked=0\n    for tgt,vals in claims.items():\n        if tgt in arrows:\n            blocked += len(vals)\n        else:\n            if len(vals)==1:\n                single.append((tgt,vals))\n            if len(vals)>=2:\n                comp.append((tgt,vals))\n    if not single or not comp or blocked==0:\n        return None\n    return nr,nc,arrows,single,comp,blocked\n\nok=0\nfor _ in range(2000):\n    res=plan_once()\n    if res is not None:\n        ok+=1\nprint('valid', ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
