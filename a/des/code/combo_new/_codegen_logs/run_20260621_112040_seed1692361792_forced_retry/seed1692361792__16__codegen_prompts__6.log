{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2faf500b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, in_bounds\nimport random\n\n\ndef _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:\n    fg = colors_present(g, exclude={bg})\n    assert len(fg) == 2, \"expected exactly two foreground colors\"\n\n    counts = {color: int(np.count_nonzero(g == color)) for color in fg}\n    marker_count = min(counts.values())\n    body_count = max(counts.values())\n    markers = [color for color, count in counts.items() if count == marker_count]\n    bodies = [color for color, count in counts.items() if count == body_count]\n    assert marker_count < body_count, \"fracture marker color must be the minority foreground color\"\n    assert len(markers) == 1 and len(bodies) == 1, \"foreground roles must be unique\"\n    return markers[0], bodies[0]\n\n\ndef _set_body(out: np.ndarray, r: int, c: int, color: int) -> None:\n    assert in_bounds(out.shape, r, c), \"shifted object pixel must stay in bounds\"\n    assert int(out[r, c]) != int(color), \"shifted object pixels must not collide\"\n    out[r, c] = int(color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Remove each fracture marker line and push the surrounding object pixels one cell away from it.\n\n    Input structure\n    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.\n    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.\n\n    Rule\n    - Erase all marker pixels.\n    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.\n    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.\n\n    Key insight\n    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    bg = get_bg(g)\n    marker, body = _role_colors(g, bg)\n    out = np.full_like(g, bg)\n\n    objects = find_components(\n        g,\n        bg=bg,\n        connectivity=8,\n        monochromatic=False,\n        colors=[marker, body],\n    )\n    assert objects, \"expected at least one fractured object\"\n\n    for obj in objects:\n        coords = obj[\"coords\"]\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert height != width, \"fractured object bbox must determine an orientation\"\n\n        vals = g[coords[:, 0], coords[:, 1]]\n        assert bool(np.any(vals == marker)), \"each object must contain marker pixels\"\n        assert bool(np.any(vals == body)), \"each object must contain body pixels\"\n\n        marker_coords = coords[vals == marker]\n        if width > height:\n            marker_by_row: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_row.setdefault(int(r), []).append(int(c))\n            assert set(marker_by_row) == set(range(r0, r1 + 1)), \"wide object needs one marker in each row\"\n            assert all(len(cols) == 1 for cols in marker_by_row.values()), \"wide object marker row must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_c = marker_by_row[rr][0]\n                assert cc != marker_c, \"body pixel cannot occupy the marker column\"\n                shifted_c = cc - 1 if cc < marker_c else cc + 1\n                _set_body(out, rr, shifted_c, body)\n        else:\n            marker_by_col: dict[int, list[int]] = {}\n            for r, c in marker_coords:\n                marker_by_col.setdefault(int(c), []).append(int(r))\n            assert set(marker_by_col) == set(range(c0, c1 + 1)), \"tall object needs one marker in each column\"\n            assert all(len(rows) == 1 for rows in marker_by_col.values()), \"tall object marker column must be unique\"\n\n            for r, c in coords[vals == body]:\n                rr = int(r)\n                cc = int(c)\n                marker_r = marker_by_col[cc][0]\n                assert rr != marker_r, \"body pixel cannot occupy the marker row\"\n                shifted_r = rr - 1 if rr < marker_r else rr + 1\n                _set_body(out, shifted_r, cc, body)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, palette, and retry budget.\nBACKGROUND_COLOR = 0\nFOREGROUND_COLORS = tuple(range(1, 10))\nMAX_GRID_SIZE = 19\nMIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)\nGENERATION_RETRIES = 300\n\n# Object counts, dimensions, and orientations.\nMIN_OBJECT_COUNT = 1\nMAX_OBJECT_COUNT = 7\nSHORT_SIDE_SIZES = (2, 3, 4, 5, 6)\nLONG_SIDE_FACTOR = 2\nWIDE = \"wide\"\nTALL = \"tall\"\nORIENTATIONS = [WIDE, TALL]\n\n# Dense layouts try smaller rectangles first while preserving random tie order.\nDENSE_COUNT_THRESHOLD = 6\nDENSE_PREFERRED_MAX_SHORT_SIDE = 3\nPACKED_COUNT_THRESHOLD = 4\nPACKED_PREFERRED_MAX_SHORT_SIDE = 4\n\n# Placement and retry constraints.\nSHIFT_PADDING = 1\nMIN_CHEB_GAP = 2\n\nBBox = tuple[int, int, int, int]\nLocation = tuple[int, int]\nObjectSpec = tuple[int, int, int, str]\n\n\ndef _interval_sep(a0: int, a1: int, b0: int, b1: int) -> int:\n    if a1 < b0:\n        return b0 - a1\n    if b1 < a0:\n        return a0 - b1\n    return 0\n\n\ndef _cheb_gap_at_least_2(a: BBox, b: BBox) -> bool:\n    dr = _interval_sep(a[0], a[2], b[0], b[2])\n    dc = _interval_sep(a[1], a[3], b[1], b[3])\n    return max(dr, dc) >= MIN_CHEB_GAP\n\n\ndef _overlap(a: BBox, b: BBox) -> bool:\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _expanded_bbox(r: int, c: int, h: int, w: int) -> BBox:\n    if w > h:\n        return r, c - SHIFT_PADDING, r + h - 1, c + w - 1 + SHIFT_PADDING\n    return r - SHIFT_PADDING, c, r + h - 1 + SHIFT_PADDING, c + w - 1\n\n\ndef _object_dims(short_side: int, orient: str) -> tuple[int, int]:\n    if orient == WIDE:\n        return short_side, LONG_SIDE_FACTOR * short_side\n    return LONG_SIDE_FACTOR * short_side, short_side\n\n\ndef _locations(n: int, h: int, w: int, originals: list[BBox], expanded: list[BBox]) -> list[Location]:\n    if w > h:\n        row_range = range(0, n - h + 1)\n        col_range = range(SHIFT_PADDING, n - w - SHIFT_PADDING + 1)\n    else:\n        row_range = range(SHIFT_PADDING, n - h - SHIFT_PADDING + 1)\n        col_range = range(0, n - w + 1)\n\n    locs: list[Location] = []\n    for r in row_range:\n        for c in col_range:\n            orig = (r, c, r + h - 1, c + w - 1)\n            exp = _expanded_bbox(r, c, h, w)\n            if any(not _cheb_gap_at_least_2(orig, old) for old in originals):\n                continue\n            if any(_overlap(exp, old) for old in expanded):\n                continue\n            locs.append((r, c))\n    random.shuffle(locs)\n    return locs\n\n\ndef _draw_object(grid: np.ndarray, expected: np.ndarray, r: int, c: int, s: int, orient: str, body: int, marker: int) -> None:\n    h, w = _object_dims(s, orient)\n    grid[r : r + h, c : c + w] = body\n    bits = [0, 1] + [random.randrange(2) for _ in range(s - 2)]\n    random.shuffle(bits)\n\n    if orient == WIDE:\n        rows = r + np.arange(s)\n        marker_cols = c + s - 1 + np.asarray(bits)\n        grid[rows, marker_cols] = marker\n        for row, marker_c in zip(rows, marker_cols):\n            expected[row, c - SHIFT_PADDING : marker_c - SHIFT_PADDING] = body\n            expected[row, marker_c + SHIFT_PADDING + 1 : c + w + SHIFT_PADDING] = body\n    else:\n        cols = c + np.arange(s)\n        marker_rows = r + s - 1 + np.asarray(bits)\n        grid[marker_rows, cols] = marker\n        for col, marker_r in zip(cols, marker_rows):\n            expected[r - SHIFT_PADDING : marker_r - SHIFT_PADDING, col] = body\n            expected[marker_r + SHIFT_PADDING + 1 : r + h + SHIFT_PADDING, col] = body\n\n\ndef _size_order(count: int) -> list[int]:\n    sizes = list(SHORT_SIDE_SIZES)\n    random.shuffle(sizes)\n    if count >= DENSE_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > DENSE_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    if count >= PACKED_COUNT_THRESHOLD:\n        return sorted(sizes, key=lambda s: (s > PACKED_PREFERRED_MAX_SHORT_SIDE, random.random()))\n    return sizes\n\n\ndef _place_objects(n: int, count: int) -> list[ObjectSpec] | None:\n    \"\"\"Pick non-overlapping object specs; return None if this attempt cannot fit them.\"\"\"\n    originals: list[BBox] = []\n    expanded: list[BBox] = []\n    placed: list[ObjectSpec] = []\n\n    for _ in range(count):\n        choices: list[tuple[int, str, list[Location]]] = []\n        for s in _size_order(count):\n            for orient in random.sample(ORIENTATIONS, 2):\n                h, w = _object_dims(s, orient)\n                locs = _locations(n, h, w, originals, expanded)\n                if locs:\n                    choices.append((s, orient, locs))\n        if not choices:\n            return None\n\n        s, orient, locs = random.choice(choices)\n        r, c = random.choice(locs)\n        h, w = _object_dims(s, orient)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/b71a7747.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/b71a7747.py\"","aggregated_output":"import itertools\n\nimport numpy as np\n\nfrom arc_utils import colors_present\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Extract the hidden two-color image by compacting the rows and columns of its complete mask.\n\n    Input structure\n    The grid contains one pair of colors whose pixels occupy every cell in the\n    cross product of their active rows and active columns; all other colors form\n    the surrounding filler or separators.\n    Rule\n    Find that unique color pair, keep exactly the rows and columns touched by\n    the pair, and return the induced subgrid.\n    Key insight\n    The target image is not chosen by color id; it is the only two-color mask\n    whose occupied pixels form a full rectangular row/column product after\n    deleting unused rows and columns.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    candidates = []\n    for pair in itertools.combinations(colors_present(g), 2):\n        mask = np.isin(g, pair)\n        rows = mask.any(axis=1)\n        cols = mask.any(axis=0)\n        rh = int(rows.sum())\n        cw = int(cols.sum())\n        if 0 < rh < h and 0 < cw < w and int(mask.sum()) == rh * cw:\n            out = g[np.ix_(rows, cols)]\n            if set(map(int, out.ravel())) == set(pair):\n                candidates.append(out)\n\n    assert len(candidates) == 1\n    return candidates[0].copy()\n\n# --------------- generator (att2) ---------------\n# Canvas and block layout bounds.\nN_BLOCK_OPTIONS = (3, 4)\nBLOCK_SIZE_RANGE = range(3, 6)\nSEPARATOR_WIDTH_RANGE = range(1, 4)\nPADDING_MIN = 2\nPADDING_MAX_EXCLUSIVE = 6\nINPUT_SIDE_MIN = 19\nINPUT_SIDE_MAX = 28\n\n# Hidden foreground shape density and pattern mix.\nFG_DENSITY_MIN = 0.14\nFG_DENSITY_MAX = 0.22\nRECT_LOOP_PROB = 0.25\nBRANCH_TRANSPOSE_PROB = 0.5\nMIN_BRANCH_ROW_GAP = 1\n\n# Color and retry settings.\nCOLOR_COUNT_OPTIONS = (4, 5)\nCOLOR_POOL = range(10)\nGENERATION_RETRIES = 300\n\nLAYOUT_CHOICES = [\n    (n_blocks, block_size, sep, pad0, pad1, side)\n    for n_blocks in N_BLOCK_OPTIONS\n    for block_size in BLOCK_SIZE_RANGE\n    for sep in SEPARATOR_WIDTH_RANGE\n    for pad0 in range(max(PADDING_MIN, sep), PADDING_MAX_EXCLUSIVE)\n    for pad1 in range(max(PADDING_MIN, sep), PADDING_MAX_EXCLUSIVE)\n    for side in [n_blocks * block_size + (n_blocks - 1) * sep + pad0 + pad1]\n    if INPUT_SIDE_MIN <= side <= INPUT_SIDE_MAX\n]\n\ndef _gen_density_bounds(size):\n    return int(np.ceil(FG_DENSITY_MIN * size * size)), int(np.floor(FG_DENSITY_MAX * size * size))\n\n\ndef _gen_between(a, b):\n    lo, hi = sorted((a, b))\n    return range(lo, hi + 1)\n\n\ndef _gen_rect_loop_mask(size, block_size):\n    lo, hi = _gen_density_bounds(size)\n    choices = []\n    for r0 in range(block_size):\n        for r1 in range(size - block_size, size):\n            for c0 in range(block_size):\n                for c1 in range(size - block_size, size):\n                    if r1 <= r0 or c1 <= c0:\n                        continue\n                    count = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4\n                    if lo <= count <= hi:\n                        choices.append((r0, r1, c0, c1))\n    if not choices:\n        return None\n\n    r0, r1, c0, c1 = random.choice(choices)\n    mask = np.zeros((size, size), dtype=bool)\n    mask[r0, c0 : c1 + 1] = True\n    mask[r1, c0 : c1 + 1] = True\n    mask[r0 : r1 + 1, c0] = True\n    mask[r0 : r1 + 1, c1] = True\n    return mask\n\n\ndef _gen_spaced_branch_rows(r0, r1, main_r):\n    rows = [r for r in range(r0, r1 + 1) if abs(r - main_r) > MIN_BRANCH_ROW_GAP]\n    random.shuffle(rows)\n    picked = []\n    for r in rows:\n        if all(abs(r - old) > MIN_BRANCH_ROW_GAP for old in picked):\n            picked.append(r)\n    return picked\n\n\ndef _gen_branch_mask(size, block_size):\n    left = random.randrange(block_size)\n    right = random.randrange(size - block_size, size)\n    r0 = random.randrange(block_size)\n    r1 = random.randrange(size - block_size, size)\n    trunk_c = random.randrange(left, right + 1)\n    main_r = random.randrange(r0, r1 + 1)\n\n    base = (r1 - r0 + 1) + (right - left)\n    density_min, max_count = _gen_density_bounds(size)\n    min_count = max(density_min, base)\n\n    picked = _gen_spaced_branch_rows(r0, r1, main_r)\n    caps = [max(trunk_c, size - 1 - trunk_c) for _ in picked]\n    capacity = base + sum(caps)\n    if min_count > min(max_count, capacity):\n        return None\n    target = random.randint(min_count, min(max_count, capacity))\n\n    mask = np.zeros((size, size), dtype=bool)\n    mask[r0 : r1 + 1, trunk_c] = True\n    mask[main_r, left : right + 1] = True\n\n    remaining = target - base\n    for i, (r, cap) in enumerate(zip(picked, caps)):\n        if remaining <= 0:\n            break\n        future = sum(caps[i + 1 :])\n        lo = max(0, remaining - future)\n        hi = min(cap, remaining)\n        take = random.randint(lo, hi)\n        if take == 0:\n            continue\n        dirs = []\n        if trunk_c >= take:\n            dirs.append(-1)\n        if size - 1 - trunk_c >= take:\n            dirs.append(1)\n        step = random.choice(dirs)\n        end = trunk_c + step * take\n        mask[r, _gen_between(trunk_c, end)] = True\n        remaining -= take\n\n    if remaining != 0:\n        return None\n    if random.random() < BRANCH_TRANSPOSE_PROB:\n        mask = mask.T\n    return mask\n\n\ndef _gen_output(size, block_size, bg, fg):\n    mask = None\n    if random.random() < RECT_LOOP_PROB:\n        mask = _gen_rect_loop_mask(size, block_size)\n    if mask is None:\n        mask = _gen_branch_mask(size, block_size)\n    if mask is None:\n        return None\n\n    out = np.full((size, size), bg, dtype=int)\n    out[mask] = fg\n    return out\n\n\ndef _gen_internal_separator_mask(active_rows, active_cols):\n    filler = ~(active_rows[:, None] & active_cols[None, :])\n    row_ids = np.flatnonzero(active_rows)\n    col_ids = np.flatnonzero(active_cols)\n    internal_rows = (~active_rows).copy()\n    internal_cols = (~active_cols).copy()\n    internal_rows[: row_ids[0]] = False\n    internal_rows[row_ids[-1] + 1 :] = False\n    internal_cols[: col_ids[0]] = False\n    internal_cols[col_ids[-1] + 1 :] = False\n\n    gridline = (internal_rows[:, None] | internal_cols[None, :]) & filler\n    return filler, gridline\n\n\ndef _gen_fill_filler(inp, active_rows, active_cols, filler_colors):\n    filler, gridline = _gen_internal_separator_mask(active_rows, active_cols)\n    inp[filler] = filler_colors[0]\n    inp[gridline] = filler_colors[1]\n\n    for color in filler_colors[2:]:\n        for r in range(inp.shape[0]):\n            cols = np.flatnonzero(filler[r])\n            inp[r, random.choice(cols)] = color\n        for c in range(inp.shape[1]):\n            rows = np.flatnonzero(filler[:, c])\n            inp[random.choice(rows), c] = color\n\n\ndef _gen_active_indexes(n_blocks, block_size, sep, pad0, side):\n    active = np.zeros(side, dtype=bool)\n    indexes = []\n    for i in range(n_blocks):\n        start = pad0 + i * (block_size + sep)\n        indexes.extend(range(start, start + block_size))\n    active[indexes] = True\n    return active, indexes\n\n\ndef _gen_palette():\n    color_count = random.choice(COLOR_COUNT_OPTIONS)\n    colors = random.sample(COLOR_POOL, color_count)\n    return colors[:2], colors[2:]\n\n\ndef _gen_attempt():\n    n_blocks, block_size, sep, pad0, _pad1, side = random.choice(LAYOUT_CHOICES)\n    out_size = n_blocks * block_size\n\n    (bg, fg), filler_colors = _gen_palette()\n\n    out = _gen_output(out_size, block_size, bg, fg)\n    if out is None:\n        return None\n\n    inp = np.empty((side, side), dtype=int)\n    active_rows, row_map = _gen_active_indexes(n_blocks, block_size, sep, pad0, side)\n    active_cols, col_map = _gen_active_indexes(n_blocks, block_size, sep, pad0, side)\n\n","exit_code":0,"status":"completed"}}
