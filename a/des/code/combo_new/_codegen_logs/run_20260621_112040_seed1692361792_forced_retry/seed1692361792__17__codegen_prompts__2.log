 \n  67:     # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n  68:     sprites = []\n  69:     for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n  70:         mask = (g == int(col)) & left_cols & (~divider_mask)\n  71:         if not bool(mask.any()):\n  72:             continue\n  73:         slab, sn = label_mask(mask, connectivity=8)\n  74:         for sid in range(1, int(sn) + 1):\n  75:             pts = np.argwhere(slab == int(sid))\n  76:             r0, c0 = pts.min(axis=0)\n  77:             r1, c1 = pts.max(axis=0)\n  78:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n  79:             m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n  80:             sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n  81: \n  82:     move_colors = {int(s[\"color\"]) for s in sprites}\n  83: \n  84:     # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n  85:     row_marks: dict[int, list[int]] = defaultdict(list)\n  86:     col_marks: dict[int, list[int]] = defaultdict(list)\n  87:     for r in range(int(ir0), int(ir1) + 1):\n  88:         cl = int(g[int(r), int(fc0)])\n  89:         cr = int(g[int(r), int(fc1)])\n  90:         if cl == cr and cl != int(bg) and cl in move_colors:\n  91:             row_marks[int(cl)].append(int(r))\n  92:     for c in range(int(ic0), int(ic1) + 1):\n  93:         ct = int(g[int(fr0), int(c)])\n  94:         cb = int(g[int(fr1), int(c)])\n  95:         if ct == cb and ct != int(bg) and ct in move_colors:\n  96:             col_marks[int(ct)].append(int(c))\n  97: \n  98:     targets: dict[int, list[tuple[int, int]]] = {}\n  99:     for col in set(row_marks.keys()) & set(col_marks.keys()):\n 100:         pts = {(int(r), int(c)) for r in row_marks[int(col)] for c in col_marks[int(col)]}\n 101:         targets[int(col)] = sorted(pts)\n 102: \n 103:     out = g.