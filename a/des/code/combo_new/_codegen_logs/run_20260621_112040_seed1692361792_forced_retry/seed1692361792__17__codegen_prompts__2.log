{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '335,540p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py && printf '\\\\n=====\\\\n' && sed -n '180,311p' /home/lixinyu/snap/new/ARC_code/eval/247ef758.py && printf '\\\\n=====\\\\n' && sed -n '170,310p' /home/lixinyu/snap/new/ARC_code/train/99caaf76.py && printf '\\\\n=====\\\\n' && sed -n '300,464p' /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py && printf '\\\\n=====\\\\n' && sed -n '330,497p' /home/lixinyu/snap/new/ARC_code/eval/898e7135.py\"","aggregated_output":"            for v in rc:\n                if v: cnt2 += 1\n                else:\n                    if cnt2 > 0: runs2.append(cnt2)\n                    cnt2 = 0\n            if cnt2 > 0: runs2.append(cnt2)\n            if len(runs2) == 1 and runs2[0] == e:\n                valid_for_left += 1\n\n        if valid_for_left != 1:\n            continue\n\n        # Success! Now rotate to target side.\n        # grid is in \"left-attach\" frame (contact on right, flipud symmetric).\n        # left -> as-is\n        # right -> fliplr (contact moves to left side)\n        # top -> rot90 CW (contact moves to bottom)\n        # bot -> rot90 CCW (contact moves to top)\n        if side == \"left\":\n            mask = grid.copy()\n        elif side == \"right\":\n            mask = np.fliplr(grid)\n        elif side == \"top\":\n            mask = np.rot90(grid, -1)  # CW: right->bottom\n        else:  # bot\n            mask = np.rot90(grid, 1)   # CCW: right->top\n        return mask\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = random.Random()\n    bg = 8\n    N = 4\n    edge_len = N - 2  # = 2\n\n    H = rng.randint(18, 26)\n    W = rng.randint(20, 26)\n\n    # Choose 4 distinct non-bg colors for hub edges\n    all_colors = [c for c in range(10) if c != bg]\n    rng.shuffle(all_colors)\n    top_col, bot_col, left_col, right_col = all_colors[:4]\n\n    sides = [\"top\", \"bot\", \"left\", \"right\"]\n    side_colors = {\"top\": top_col, \"bot\": bot_col, \"left\": left_col, \"right\": right_col}\n\n    # Choose K sides (2-4) to get sprites\n    K = rng.randint(2, 4)\n    sprite_sides = rng.sample(sides, K)\n\n    # Generate sprite masks for each chosen side\n    sprite_masks = {}\n    for side in sprite_sides:\n        mask = _make_sprite_mask(edge_len, side, rng)\n        if mask is None:\n            return None\n        sprite_masks[side] = mask\n\n    # Compute max sprite extent to ensure enough margin for hub placement\n    max_sprite_h = max(m.shape[0] for m in sprite_masks.values())\n    max_sprite_w = max(m.shape[1] for m in sprite_masks.values())\n    max_extent = max(max_sprite_h, max_sprite_w)\n    margin = max_extent + 2\n\n    # Place hub near center with margin\n    hub_r_min = margin\n    hub_r_max = H - N - margin\n    hub_c_min = margin\n    hub_c_max = W - N - margin\n    if hub_r_min > hub_r_max or hub_c_min > hub_c_max:\n        return None\n\n    hub_r = rng.randint(hub_r_min, hub_r_max)\n    hub_c = rng.randint(hub_c_min, hub_c_max)\n\n    # Build output grid\n    out = np.full((H, W), bg, dtype=int)\n\n    # Place hub\n    # Top edge\n    for ci in range(1, N - 1):\n        out[hub_r, hub_c + ci] = top_col\n    # Bottom edge\n    for ci in range(1, N - 1):\n        out[hub_r + N - 1, hub_c + ci] = bot_col\n    # Left edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c] = left_col\n    # Right edge\n    for ri in range(1, N - 1):\n        out[hub_r + ri, hub_c + N - 1] = right_col\n\n    # Attach sprites to hub in output\n    attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords\n    for side in sprite_sides:\n        mask = sprite_masks[side]\n        sh, sw = mask.shape\n        color = side_colors[side]\n        arr = np.where(mask, color, bg).astype(int)\n\n        # Compute placement so sprite's contact edge is flush with hub side.\n        # The solver's segs dict defines: for each side, the contact position and span.\n        #   top -> sprite's bot row at hub_r-1, cols hub_c+1..hub_c+N-2\n        #   bot -> sprite's top row at hub_r+N, cols hub_c+1..hub_c+N-2\n        #   left -> sprite's right col at hub_c-1, rows hub_r+1..hub_r+N-2\n        #   right -> sprite's left col at hub_c+N, rows hub_r+1..hub_r+N-2\n        if side == \"top\":\n            # Find first filled col on bottom row of sprite\n            filled = np.where(mask[-1])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r - sh  # bottom row of sprite at row hub_r-1\n        elif side == \"bot\":\n            filled = np.where(mask[0])[0]\n            sc = hub_c + 1 - int(filled[0])\n            sr = hub_r + N  # top row of sprite at row hub_r+N\n        elif side == \"left\":\n            filled = np.where(mask[:, -1])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c - sw  # right col of sprite at col hub_c-1\n        else:  # right\n            filled = np.where(mask[:, 0])[0]\n            sr = hub_r + 1 - int(filled[0])\n            sc = hub_c + N  # left col of sprite at col hub_c+N\n\n        # Check bounds\n        if sr < 0 or sc < 0 or sr + sh > H or sc + sw > W:\n            return None\n\n        # Check no overlap with existing content\n        for r in range(sh):\n            for c in range(sw):\n                if mask[r, c] and out[sr + r, sc + c] != bg:\n                    return None\n\n        paste(out, arr, sr, sc, transparent=bg)\n        attached_sprites[side] = (arr, mask, sr, sc)\n\n    # Verify output is correct by running solver later (via oracle check)\n\n    # Build input: hub + scattered sprites in random rotations + optional distractor\n    inp = np.full((H, W), bg, dtype=int)\n    # Place hub on input\n    inp[hub_r:hub_r+N, hub_c:hub_c+N] = out[hub_r:hub_r+N, hub_c:hub_c+N]\n\n    # Canvas for placement tracking\n    canvas = inp.copy()\n\n    for side in sprite_sides:\n        arr, mask, sr, sc = attached_sprites[side]\n        # Apply a random non-identity rotation\n        # But we need to ensure the solver will find the right rotation\n        # The solver uses 8-connectivity labeling and picks the largest component of matching color\n        # Apply a random rotation (1-3 quarter turns, avoiding identity)\n        k = rng.choice([1, 2, 3])\n        rotated_arr = np.rot90(arr, k)\n        rotated_mask = np.rot90(mask, k)\n\n        # Crop to bounding box of the mask\n        rows_any = rotated_mask.any(axis=1)\n        cols_any = rotated_mask.any(axis=0)\n        r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]\n        c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]\n        cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]\n        patch = np.where(cropped_mask, cropped_arr, bg).astype(int)\n\n        try:\n            pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(canvas, patch, pr, pc, transparent=bg)\n        paste(inp, patch, pr, pc, transparent=bg)\n\n    # Optionally add a distractor (0 or 1)\n    if rng.random() < 0.3:\n        used_colors = set(side_colors.values())\n        distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]\n        if distractor_colors:\n            dcol = rng.choice(distractor_colors)\n            # Make a small distractor sprite\n            dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)\n            if dist_mask is not None:\n                dist_arr = np.where(dist_mask, dcol, bg).astype(int)\n                try:\n                    pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)\n                    paste(canvas, dist_arr, pr, pc, transparent=bg)\n                    paste(inp, dist_arr, pr, pc, transparent=bg)\n                except ValueError:\n                    pass  # skip distractor if no room\n\n    # Oracle check\n    result = main(inp)\n    if not np.array_equal(result, out):\n        return None\n\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n=====\n    return sprite\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = 0\n\n    # Dimensions — frame spans full grid height\n    interior_h = random.randint(8, 13)\n    interior_w = random.randint(8, 13)\n    H = interior_h + 2\n    if not 10 <= H <= 15:\n        return None\n    sprite_area_w = random.randint(3, 5)\n    frame_w = interior_w + 2\n    W = sprite_area_w + 1 + frame_w\n    if not 14 <= W <= 20:\n        return None\n\n    # Key positions\n    div_col = sprite_area_w\n    fc0, fc1 = sprite_area_w + 1, W - 1\n    ir0, ic0 = 1, fc0 + 1\n    ir1, ic1 = H - 2, fc1 - 1\n\n    # Assign distinct colors\n    all_colors = list(range(1, 10))\n    random.shuffle(all_colors)\n    n_movers = random.randint(2, 3)\n    n_distractors = random.choice([0, 0, 1])\n    idx = 0\n    divider_color = all_colors[idx]; idx += 1\n    frame_base = all_colors[idx]; idx += 1\n    mover_colors = all_colors[idx:idx + n_movers]; idx += n_movers\n    distractor_colors = all_colors[idx:idx + n_distractors]; idx += n_distractors\n\n    # Generate mover sprites\n    sprites: list[np.ndarray] = []\n    for mc in mover_colors:\n        s = _make_sprite(mc, 5, sprite_area_w)\n        if s is None:\n            return None\n        sprites.append(s)\n\n    # Pick marker positions per mover (no two movers share a row or col marker)\n    mover_targets: dict[int, tuple[list[int], list[int]]] = {}\n    occupied_rows: set[int] = set()\n    occupied_cols: set[int] = set()\n    for mc, sp in zip(mover_colors, sprites):\n        sh, sw = sp.shape\n        min_row = ir0 + sh // 2\n        max_row = ir1 - (sh - 1 - sh // 2)\n        min_col = ic0 + sw // 2\n        max_col = ic1 - (sw - 1 - sw // 2)\n        if min_row > max_row or min_col > max_col:\n            return None\n        avail_rows = [r for r in range(min_row, max_row + 1) if r not in occupied_rows]\n        row_marks = _pick_spaced(avail_rows, random.randint(1, 2), sh)\n        if not row_marks:\n            return None\n        avail_cols = [c for c in range(min_col, max_col + 1) if c not in occupied_cols]\n        col_marks = _pick_spaced(avail_cols, random.randint(1, 2), sw)\n        if not col_marks:\n            return None\n        mover_targets[mc] = (sorted(row_marks), sorted(col_marks))\n        occupied_rows.update(row_marks)\n        occupied_cols.update(col_marks)\n\n    # Build input grid: bg fill, then divider, frame, sprites\n    inp = np.full((H, W), bg, dtype=int)\n    inp[:, div_col] = divider_color\n\n    # Frame top/bottom edges (mirrored)\n    top_edge = np.full(frame_w, frame_base, dtype=int)\n    for mc, (_, cmarks) in mover_targets.items():\n        for cc in cmarks:\n            top_edge[cc - fc0] = mc\n    inp[0, fc0:fc0 + frame_w] = top_edge\n    inp[H - 1, fc0:fc0 + frame_w] = top_edge\n\n    # Frame left/right edges (mirrored)\n    for r in range(1, H - 1):\n        val = frame_base\n        for mc, (rmarks, _) in mover_targets.items():\n            if r in rmarks:\n                val = mc\n                break\n        inp[r, fc0] = val\n        inp[r, fc1] = val\n\n    # Stack sprites in left strip: movers top-to-bottom, then distractors\n    cur_row = 0\n    all_items: list[tuple[int, np.ndarray, bool]] = [\n        (mc, sp, False) for mc, sp in zip(mover_colors, sprites)\n    ]\n    for dc_color in distractor_colors:\n        ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)\n        if ds is None:\n            return None\n        all_items.append((dc_color, ds, True))\n\n    for mc, sp, _ in all_items:\n        sh, sw = sp.shape\n        if sw > sprite_area_w or cur_row + sh > H:\n            return None\n        c_off = random.randint(0, sprite_area_w - sw)\n        for dr in range(sh):\n            for dc in range(sw):\n                if sp[dr, dc] != bg:\n                    inp[cur_row + dr, c_off + dc] = sp[dr, dc]\n        cur_row += sh\n\n    # Validate: bg must be most common color so solver detects it correctly\n    vals, counts = np.unique(inp, return_counts=True)\n    if int(vals[np.argmax(counts)]) != bg:\n        return None\n\n    # Run solver and verify output differs from input (movers actually moved)\n    try:\n        output = main(inp)\n    except Exception:\n        return None\n    if np.array_equal(inp, output):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"generate_input: failed after 300 attempts\")\n\n=====\n    return block\n\n\ndef _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:\n    marker = _gen_marker_block(side)\n    if side == \"left\":\n        return np.concatenate([marker, cross], axis=1)\n    if side == \"right\":\n        return np.concatenate([cross, marker], axis=1)\n    if side == \"top\":\n        return np.concatenate([marker, cross], axis=0)\n    return np.concatenate([cross, marker], axis=0)\n\n\ndef _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:\n    out = patch.copy()\n    if side == \"left\":\n        out[:, 3:] = np.rot90(out[:, 3:], 2)\n    elif side == \"right\":\n        out[:, :3] = np.rot90(out[:, :3], 2)\n    elif side == \"top\":\n        out[3:, :] = np.rot90(out[3:, :], 2)\n    else:\n        out[:3, :] = np.rot90(out[:3, :], 2)\n    return out\n\n\ndef _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:\n    h, w = patch.shape\n    H, W = canvas.shape\n    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:\n        return False\n    for dr, dc in np.argwhere(patch != _GEN_BG):\n        r = int(r0 + dr)\n        c = int(c0 + dc)\n        r1 = max(0, r - padding)\n        r2 = min(H, r + padding + 1)\n        c1 = max(0, c - padding)\n        c2 = min(W, c + padding + 1)\n        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):\n            return False\n    return True\n\n\ndef _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"right\":\n        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"top\":\n        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]\n    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]\n\n\ndef _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]\n    if side == \"right\":\n        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]\n    if side == \"top\":\n        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]\n    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]\n\n\ndef _gen_canvas_shape(n_obj: int) -> tuple[int, int]:\n    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]\n    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)\n\n\ndef _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:\n    H, W = expected.shape\n    objects = []\n\n    for _ in range(n_obj):\n        sides = _GEN_SIDES[:]\n        random.shuffle(sides)\n        placed = False\n        for side in sides:\n            cross = _gen_cross_block()\n            patch = _gen_composite(side, cross)\n            positions = _gen_output_positions(side, H, W)\n            random.shuffle(positions)\n            for r0, c0 in positions:\n                if _gen_can_place(expected, patch, r0, c0, padding=_GEN_PADDING):\n                    paste(expected, patch, int(r0), int(c0), transparent=_GEN_BG)\n                    objects.append((side, patch, r0, c0))\n                    placed = True\n                    break\n            if placed:\n                break\n        if not placed:\n            return None\n    return objects\n\n\ndef _gen_place_input_objects(shape: tuple[int, int], objects: list[tuple[str, np.ndarray, int, int]]) -> np.ndarray | None:\n    H, W = shape\n    inp = np.full(shape, _GEN_BG, dtype=int)\n    random.shuffle(objects)\n    for side, out_patch, target_r, target_c in objects:\n        in_patch = _gen_input_from_output(side, out_patch)\n        positions = _gen_input_positions(side, H, W, target_r, target_c)\n        random.shuffle(positions)\n        placed = False\n        for r0, c0 in positions:\n            if _gen_can_place(inp, in_patch, r0, c0, padding=_GEN_PADDING):\n                paste(inp, in_patch, int(r0), int(c0), transparent=_GEN_BG)\n                placed = True\n                break\n        if not placed:\n            return None\n    return inp\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n_obj = random.randint(*_GEN_OBJECT_COUNT_RANGE)\n    H, W = _gen_canvas_shape(n_obj)\n\n    expected = np.full((H, W), _GEN_BG, dtype=int)\n    objects = _gen_place_output_objects(expected, n_obj)\n    if objects is None:\n        return None\n\n    inp = _gen_place_input_objects((H, W), objects)\n    if inp is None:\n        return None\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 99caaf76 input\")\n\n=====\n    Returns (2N,2N) array with values TL/TR/BL/BR, or None if any\n    quadrant region is empty or not 8-connected.\n    \"\"\"\n    S = 2 * N\n    own = np.zeros((S, S), dtype=int)\n    own[:N, :N] = TL\n    own[:N, N:] = TR\n    own[N:, :N] = BL\n    own[N:, N:] = BR\n\n    # H-tabs: single-column strips crossing the horizontal boundary (row N)\n    for kind, col, up_owner, down_owner in [\n        ('H_left',  p,         BL, TL),\n        ('H_right', S - 1 - p, BR, TR),\n    ]:\n        spec = tab_specs.get(kind)\n        if spec is None:\n            continue\n        depth, direction = spec\n        if direction == 'up':\n            own[N - depth:N, col] = up_owner\n        else:\n            own[N:N + depth, col] = down_owner\n\n    # V-tabs: single-row strips crossing the vertical boundary (col N)\n    for kind, row, left_owner, right_owner in [\n        ('V_top', p,         TR, TL),\n        ('V_bot', S - 1 - p, BR, BL),\n    ]:\n        spec = tab_specs.get(kind)\n        if spec is None:\n            continue\n        depth, direction = spec\n        if direction == 'left':\n            own[row, N - depth:N] = left_owner\n        else:\n            own[row, N:N + depth] = right_owner\n\n    # Verify all four quadrant regions are non-empty and 8-connected\n    for q in (TL, TR, BL, BR):\n        mask = (own == q).astype(int)\n        if mask.sum() == 0:\n            return None\n        if not is_contiguous(mask, background=0, connectivity=8):\n            return None\n    return own\n\n\ndef _extract_piece(own: np.ndarray, q: int, color: int,\n                   marker_pos: tuple[int, int] | None = None) -> list[tuple[int, int, int]]:\n    \"\"\"Extract cells for quadrant *q* in local (0-based) coordinates.\n\n    All cells get *color*, except *marker_pos* which gets MARKER_COLOR.\n    \"\"\"\n    rows, cols = np.where(own == q)\n    min_r, min_c = rows.min(), cols.min()\n    cells = [(int(r) - min_r, int(c) - min_c, color) for r, c in zip(rows, cols)]\n    if marker_pos is not None:\n        mr, mc = marker_pos[0] - min_r, marker_pos[1] - min_c\n        cells = [(r, c, MARKER_COLOR if (r, c) == (mr, mc) else col)\n                 for r, c, col in cells]\n    return cells\n\n\ndef _cells_to_patch(cells) -> np.ndarray:\n    \"\"\"Render cell list into a tight numpy patch (bg=0).\"\"\"\n    h = max(r for r, _, _ in cells) + 1\n    w = max(c for _, c, _ in cells) + 1\n    patch = np.zeros((h, w), dtype=int)\n    for r, c, col in cells:\n        patch[r, c] = col\n    return patch\n\n\ndef _random_tab_specs(N: int) -> dict:\n    \"\"\"Sample random tab specs for all four boundaries.\n\n    At N=2, one tab is randomly dropped (spec says only 3 may be present).\n    \"\"\"\n    specs = {}\n    for tn in TAB_NAMES:\n        depth = random.randint(1, N - 1)\n        if tn.startswith('H'):\n            direction = random.choice(['up', 'down'])\n        else:\n            direction = random.choice(['left', 'right'])\n        specs[tn] = (depth, direction)\n\n    if N == 2:\n        specs[random.choice(TAB_NAMES)] = None\n    return specs\n\n\ndef _scatter_patches(patches: list[np.ndarray]) -> np.ndarray | None:\n    \"\"\"Place patches on a canvas in random order with padding.\n\n    Returns the canvas, or None if any patch doesn't fit.\n    \"\"\"\n    canvas = np.zeros((CANVAS_H, CANVAS_W), dtype=int)\n    order = list(range(len(patches)))\n    random.shuffle(order)\n    for i in order:\n        patch = patches[i]\n        try:\n            r0, c0 = random_free_location(\n                canvas, patch, transparent=0,\n                padding=PLACEMENT_PADDING, padding_connectivity=8)\n        except ValueError:\n            return None\n        region = canvas[r0:r0 + patch.shape[0], c0:c0 + patch.shape[1]]\n        mask = patch != 0\n        region[mask] = patch[mask]\n    return canvas\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    N = random.randint(N_MIN, N_MAX)\n    p = random.randint(1, N - 1)\n\n    # Build quadrant ownership grid\n    own = _build_ownership(N, p, _random_tab_specs(N))\n    if own is None:\n        return None\n\n    # Assign colors\n    pool = COLOR_POOL.copy()\n    random.shuffle(pool)\n    quad_colors = {TL: ANCHOR_COLOR, TR: pool[0], BL: pool[1], BR: pool[2]}\n\n    # Build expected output (solver target)\n    S = 2 * N\n    output = np.zeros((S, S), dtype=int)\n    for q, c in quad_colors.items():\n        output[own == q] = c\n    output[0, 0] = MARKER_COLOR\n\n    # Extract pieces: anchor gets marker at (0,0)\n    anchor_cells = _extract_piece(own, TL, ANCHOR_COLOR, marker_pos=(0, 0))\n    other_cells = [_extract_piece(own, q, quad_colors[q]) for q in (TR, BL, BR)]\n\n    # Rotate: anchor to random orientation, each other piece randomly\n    all_cells = [_rotate_cells(anchor_cells, random.randint(0, 3))] + \\\n                [_rotate_cells(c, random.randint(0, 3)) for c in other_cells]\n\n    # Scatter on canvas\n    canvas = _scatter_patches([_cells_to_patch(c) for c in all_cells])\n    if canvas is None:\n        return None\n\n    # Oracle: verify solver reproduces the expected output\n    try:\n        out = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(out, output):\n        return None\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        g = _gen_attempt()\n        if g is not None:\n            return g\n    raise RuntimeError('generate_input: exhausted attempts')\n\n=====\n        in_mask = np.rot90(out_mask, rot)\n        in_patch = np.rot90(out_patch, rot)\n        if random.random() < 0.5:\n            in_mask = np.fliplr(in_mask)\n            in_patch = np.fliplr(in_patch)\n    else:\n        in_mask, in_patch = out_mask, out_patch\n\n    return {\"color\": color, \"slot\": slot,\n            \"out_patch\": out_patch, \"out_mask\": out_mask,\n            \"in_patch\": in_patch, \"in_mask\": in_mask}\n\n\n# --- output assembly ---------------------------------------------------------\n\ndef _build_expected_output(pieces: list[dict], layout_h: int, layout_w: int,\n                           k: int, frame_color: int) -> np.ndarray:\n    \"\"\"Assemble the expected output grid: frame_color background with pieces placed.\"\"\"\n    out = np.full(((layout_h + 2) * k, (layout_w + 2) * k), frame_color, dtype=int)\n    for p in pieces:\n        coords = p[\"slot\"][\"coords\"]\n        top = (int(coords[:, 0].min()) + 1) * k\n        left = (int(coords[:, 1].min()) + 1) * k\n        paste(out, p[\"out_patch\"], top, left, mask=p[\"out_mask\"], overwrite=True)\n    return out\n\n\n# --- input canvas assembly ---------------------------------------------------\n\ndef _build_input_canvas(pieces: list[dict], layout_mask: np.ndarray,\n                        layout_h: int, layout_w: int, k: int,\n                        frame_color: int, distractor_color: int) -> np.ndarray | None:\n    \"\"\"Build the input grid: frame + scattered pieces + distractor noise.\n    Returns canvas or None if placement fails.\n    \"\"\"\n    frame_h, frame_w = layout_h + 2, layout_w + 2\n    total_piece_area = sum(int(p[\"in_mask\"].sum()) for p in pieces)\n    needed_cells = frame_h * frame_w + AREA_BUFFER_MULT * total_piece_area + AREA_BUFFER_CONST\n\n    # Canvas dimensions: start random within spec range, grow if area insufficient\n    min_h = max(CANVAS_DIM_RANGE[0], frame_h + 2)\n    min_w = max(CANVAS_DIM_RANGE[0], frame_w + 2)\n    canvas_h = random.randint(min_h, CANVAS_DIM_RANGE[1])\n    canvas_w = random.randint(min_w, CANVAS_DIM_RANGE[1])\n    while canvas_h * canvas_w < needed_cells and (canvas_h < CANVAS_DIM_RANGE[1] or canvas_w < CANVAS_DIM_RANGE[1]):\n        if canvas_h <= canvas_w and canvas_h < CANVAS_DIM_RANGE[1]:\n            canvas_h += 1\n        elif canvas_w < CANVAS_DIM_RANGE[1]:\n            canvas_w += 1\n        else:\n            break\n    if canvas_h * canvas_w < needed_cells:\n        return None\n\n    canvas = np.zeros((canvas_h, canvas_w), dtype=int)\n\n    # Build and place the frame (1-cell border of frame_color around the layout)\n    frame_img = np.full((frame_h, frame_w), frame_color, dtype=int)\n    frame_img[1:-1, 1:-1] = np.where(layout_mask, 0, frame_color)\n    fr_max, fc_max = canvas_h - frame_h - 1, canvas_w - frame_w - 1\n    if fr_max < 1 or fc_max < 1:\n        return None\n    paste(canvas, frame_img, random.randint(1, fr_max), random.randint(1, fc_max))\n\n    # Place pieces outside the frame, largest-first for better packing\n    for p in sorted(pieces, key=lambda p: -int(p[\"in_mask\"].sum())):\n        try:\n            pr, pc = random_free_location(\n                canvas, p[\"in_patch\"],\n                transparent=0, border=0, padding=1, padding_connectivity=8,\n            )\n        except ValueError:\n            return None\n        paste(canvas, p[\"in_patch\"], pr, pc, mask=p[\"in_mask\"], overwrite=True)\n\n    # Scatter distractor singletons (isolated single pixels in a dedicated color)\n    n_distractors = random.randint(*DISTRACTOR_RANGE)\n    placed = 0\n    for _ in range(n_distractors * DISTRACTOR_RETRY_MULT):\n        if placed >= n_distractors:\n            break\n        rr, cc = random.randint(0, canvas_h - 1), random.randint(0, canvas_w - 1)\n        if canvas[rr, cc] != 0:\n            continue\n        r_lo, r_hi = max(0, rr - 1), min(canvas_h, rr + 2)\n        c_lo, c_hi = max(0, cc - 1), min(canvas_w, cc + 2)\n        if np.any(canvas[r_lo:r_hi, c_lo:c_hi] != 0):\n            continue\n        canvas[rr, cc] = distractor_color\n        placed += 1\n    if placed < MIN_DISTRACTORS:\n        return None\n\n    # bg=0 must remain the most common color for solver's get_bg\n    vals, counts = np.unique(canvas, return_counts=True)\n    if int(vals[np.argmax(counts)]) != 0:\n        return None\n\n    return canvas\n\n\n# --- main generator attempt --------------------------------------------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    k = random.choice(K_CHOICES)\n    layout_h = random.randint(*LAYOUT_H_RANGE)\n    layout_w = random.randint(*LAYOUT_W_RANGE)\n    n_slots = random.randint(*N_SLOTS_RANGE)\n    n_units = random.randint(1, min(N_UNITS_MAX, n_slots - 1))\n\n    # Allocate colors: frame, distractor, then per-piece\n    palette = list(range(1, 10))\n    random.shuffle(palette)\n    frame_color = palette.pop()\n    distractor_color = palette.pop()\n    needed_piece_colors = (n_slots - n_units) + 1  # +1 shared unit color\n    if len(palette) < needed_piece_colors:\n        return None\n    non_unit_colors = palette[:n_slots - n_units]\n    unit_color = palette[n_slots - n_units]\n\n    # Build layout\n    slots = _gen_layout(layout_h, layout_w, n_slots, n_units)\n    if slots is None:\n        return None\n    unit_slots = slots[:n_units]\n    non_unit_slots = slots[n_units:]\n\n    # Validate that holes touch all 4 borders (so solver's tight-crop matches our layout)\n    layout_mask = np.zeros((layout_h, layout_w), dtype=bool)\n    for s in slots:\n        layout_mask[s[\"coords\"][:, 0], s[\"coords\"][:, 1]] = True\n    if not (layout_mask[0].any() and layout_mask[-1].any()\n            and layout_mask[:, 0].any() and layout_mask[:, -1].any()):\n        return None\n\n    # Build pieces\n    pieces = [_make_piece(s, non_unit_colors[i], k, apply_dihedral=True)\n              for i, s in enumerate(non_unit_slots)]\n    pieces += [_make_piece(s, unit_color, k, apply_dihedral=False)\n               for s in unit_slots]\n\n    # Build expected output\n    expected_out = _build_expected_output(pieces, layout_h, layout_w, k, frame_color)\n\n    # Build input canvas\n    canvas = _build_input_canvas(pieces, layout_mask, layout_h, layout_w, k,\n                                 frame_color, distractor_color)\n    if canvas is None:\n        return None\n\n    # Oracle check\n    try:\n        produced = main(canvas)\n    except Exception:\n        return None\n    if not np.array_equal(produced, expected_out):\n        return None\n\n    return canvas\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_MAX_RETRIES):\n        res = _gen_attempt()\n        if res is not None:\n            return res\n    raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n","exit_code":0,"status":"completed"}}
