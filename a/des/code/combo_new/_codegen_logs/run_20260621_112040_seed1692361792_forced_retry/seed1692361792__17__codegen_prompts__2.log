             return grid\n 310:     raise RuntimeError(\"failed to generate a valid 99caaf76 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py =====\n--- main lines 252-278 ---\n 252: def main(grid: np.ndarray) -> np.ndarray:\n 253:     \"\"\"\n 254:     Assemble colored rectangular sprites into a single tiled rectangle, anchored by a marker pixel.\n 255: \n 256:     Input structure:\n 257:     - bg = most common color. Several solid-colored rectangular sprites scattered on the grid.\n 258:     - One sprite has a unique single-pixel marker (different color) at one corner — this is the anchor.\n 259: \n 260:     Rule:\n 261:     - Identify the anchor sprite (contains the marker pixel) and the remaining pieces.\n 262:     - Rotate the anchor so the marker pixel lands at position (0,0) of the output.\n 263:     - Pack all remaining pieces (allowing 90° rotations) to tile a complete rectangle with no gaps.\n 264: \n 265:     Key insight: The lone marker pixel picks the anchor and fixes the output orientation — it must sit at the top-left corner.\n 266:     \"\"\"\n 267:     g = np.asarray(grid, dtype=int)\n 268:     pieces, bg = _extract_pieces(g)\n 269:     assert pieces, \"grid has no non-background colors — input must contain colored pieces to assemble\"\n 270: \n 271:     area = sum(len(p[\"cells\"]) for p in pieces)\n 272:     for H, W in _dims(area):\n 273:         solved = _solve_packing(pieces, H, W)\n 274:         if solved is None:\n 275:             continue\n 276:         return solved.astype(int)\n 277: \n 278:     assert False, \"packing failed for all candidate dimensions — input pieces must tile a valid rectangle\"\n--- generate_input lines 459-464 ---\n 459: def generate_input() -> np.ndarray:\n 460:     for _ in range(MAX_ATTEMPTS):\n 461:         g = _gen_attempt()\n 462:         if g is not None:\n 463:             return g\n 464:     raise RuntimeError('generate_input: exhausted attempts')\n\n===== /home/lixinyu/snap/new/ARC_code/train/57edb29d.py =====\n--- main lines 87-155 ---\n  87: def main(grid: np.ndarray) -> np.ndarray:\n  88:     \"\"\"\n  89:     Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n  90: \n  91:     Input structure:\n  92:     - The boundary color is the background/separator.\n  93:     - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n  94:     - Other rectangles contain their base color plus marker pixels.\n  95: \n  96:     Rule:\n  97:     - Crop the only plain rectangle; this crop is the output canvas.\n  98:     - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n  99:     - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n 100: \n 101:     Key insight:\n 102:     - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n 103:     \"\"\"\n 104:     g = np.asarray(grid, dtype=int)\n 105:     assert g.ndim == 2, \"expected a 2D grid\"\n 106:     bg = _boundary_bg(g)\n 107: \n 108:     objects = []\n 109:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n 110:         bbox = tuple(map(int, comp[\"bbox\"]))\n 111:         sub = crop_bbox(g, bbox)\n 112:         assert np.all(sub != bg), \"foreground rectangles must be dense\"\n 113: \n 114:         base_color = _unique_most_common(sub)\n 115:         marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n 116:         objects.append(\n 117:             {\n 118:                 \"bbox\": bbox,\n 119:                 \"sub\": sub,\n 120:                 \"base_color\": int(base_color),\n 121:                 \"marker_colors\": marker_colors,\n 122:             }\n 123:         )\n 124: \n 125:     plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n 126:     assert len(plain) == 1, \"expected exactly one plain rectangle\"\n 127:     target = plain[0]\n 128:     tr0, tc0, tr1, tc1 = target[\"bbox\"]\n 129:     target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n 130: \n 131:     sources = [\n 132:         obj\n 133:         for obj in objects\n 134:         if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n 135:     ]\n 136:     assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n 137: \n 138:     marker_colors = set()\n 139:     for source in sources:\n 140:         marker_colors.update(source[\"marker_colors\"])\n 141:     assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n 142:     marker_color = int(next(iter(marker_colors)))\n 143: \n 144:     masks = []\n 145:     for source in sources:\n 146:         assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n 147:         masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n 148: \n 149:     pattern = masks[0]\n 150:     for mask in masks[1:]:\n 151:         assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n 152: \n 153:     out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n 154:     out[pattern] = marker_color\n 155:     return out\n--- generate_input lines 450-455 ---\n 450: def generate_input() -> np.ndarray:\n 451:     for _ in range(GENERATION_ATTEMPTS):\n 452:         result = _gen_attempt()\n 453:         if result is not None:\n 454:             return result\n 455:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/898e7135.py =====\n--- main lines 6-152 ---\n   6: def main(grid: np.ndarray) -> np.ndarray:\n   7:     \"\"\"\n   8:     Inflate a frame's hole-layout and fill each hole with its matching piece.\n   9: \n  10:     Input structure:\n  11:     - bg = most common color. Largest component is a monochrome frame enclosing bg holes.\n  12:     - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.\n  13: \n  14:     Rule:\n  15:     - Extract connected hole regions inside the frame as slots.\n  16:     - Match each piece to a slot by comparing block-level shapes under rotation/flip.\n  17:     - Output the layout scaled by k, with pieces placed in slots; frame color as background.\n  18: \n  19:     Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.\n  20:     \"\"\"\n  21:     g = np.array(grid, dtype=int)\n  22:     bg = int(get_bg(g))\n  23: \n  24:     # --- find the largest connected component of foreground (multicolor) ---\n  25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n  26:     assert not (not comps)\n  27:     frame_comp = max(comps, key=lambda d: int(d[\"area\"]))\n  28:     fr0, fc0, fr1, fc1 = map(int, frame_comp[\"bbox\"])\n  29: \n  30:     # The frame is monochrome; use its dominant color as output background.\n  31:     frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp[\"coords\"]]\n  32:     bgc = int(Counter(frame_cols).most_common(1)[0][0])\n  33: \n  34:     # --- layout = bg holes inside the frame bbox, tight-cropped ---\n  35:     sub = crop_bbox(g, (fr0, fc0, fr1, fc1))\n  36:     hole = sub == int(bg)\n  37:     hole_box = bbox(hole)\n  38:     assert hole_box is not None, \"frame must enclose at least one bg hole\"\n  39:     lr0, lc0, lr1, lc1 = map(int, hole_box)\n  40:     layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]\n  41: \n  42:     # --- slot components in the layout ---\n  43:     slots = []\n  44:     for coords in components_mask(layout, connectivity=4):\n  45:         rr0, cc0, rr1, cc1 = bbox_coords(coords)\n  46:         rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))\n  47:         h = int(rr1 - rr0 + 1)\n  48:         w = int(cc1 - cc0 + 1)\n  49:         sm = np.zeros((h, w), dtype=bool)\n  50:         sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True\n  51:         slots.append({\"area\": int(sm.sum()), \"r0\": int(rr0), \"c0\": int(cc0), \"mask\": sm})\n  52:     slots.sort(key=lambda s: (-int(s[\"area\"]), int(s[\"r0\"]), int(s[\"c0\"])))\n  53: \n  54:     assert slots, \"frame must contain at least one slot\"\n  55: \n  56:     # --- pieces = non-singleton foreground components excluding the frame component ---\n  57:     pieces = []\n  58:     for comp in comps:\n  59:         if comp is frame_comp:\n  60:             continue\n  61:         coords = comp[\"coords\"]\n  62:         if coords.size == 0 or int(coords.shape[0]) <= 1:\n  63:             continue\n  64:         pr0, pc0, pr1, pc1 = map(int, comp[\"bbox\"])\n  65:         patch = crop_bbox(g, (pr0, pc0, pr1, pc1))\n  66:         ph, pw = map(int, patch.shape)\n  67:         pm = np.zeros((ph, pw), dtype=bool)\n  68:         pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True\n  69:         pieces.append({\"area\": int(pm.sum()), \"mask\": pm, \"patch\": patch})\n  70: \n  71:     assert pieces, \"at least one non-frame piece must exist\"\n  72: \n  73:     # --- infer k from the smallest solid square piece ---\n  74:     k = None\n  75:     for p in pieces:\n  76:         h, w = map(int, p[\"mask\"].shape)\n... [76 more lines omitted]\n--- generate_input lines 492-497 ---\n 492: def generate_input() -> np.ndarray:\n 493:     for _ in range(GENERATE_MAX_RETRIES):\n 494:         res = _gen_attempt()\n 495:         if res is not None:\n 496:             return res\n 497:     raise RuntimeError(\"generate_input: failed to generate after %d attempts\" % GENERATE_MAX_RETRIES)\n\n","exit_code":0,"status":"completed"}}
