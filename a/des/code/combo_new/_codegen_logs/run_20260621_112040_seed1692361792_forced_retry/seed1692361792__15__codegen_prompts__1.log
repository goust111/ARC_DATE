{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components, get_bg, paste\nimport random\n\n\n_CROSS_MASK = np.array(\n    [\n        [False, True, False],\n        [True, True, True],\n        [False, True, False],\n    ],\n    dtype=bool,\n)\n\n\ndef _marker_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(int(v) for v in g[g != int(bg)])\n    assert counts, \"expected foreground pixels\"\n    max_count = max(counts.values())\n    candidates = [color for color, count in counts.items() if count == max_count]\n    assert len(candidates) == 1, \"expected a unique repeated marker color\"\n    marker = int(candidates[0])\n    assert counts[marker] % 4 == 0, \"marker pixels should form 4-pixel sprites\"\n    return marker\n\n\ndef _block_kind(block: np.ndarray, bg: int, marker: int) -> str:\n    assert block.shape == (3, 3), \"expected 3x3 half-block\"\n    marker_mask = block == int(marker)\n    other_mask = (block != int(bg)) & ~marker_mask\n\n    if int(marker_mask.sum()) == 4 and not bool(other_mask.any()):\n        return \"marker\"\n\n    if not bool(marker_mask.any()) and int(other_mask.sum()) == 5:\n        assert np.array_equal(other_mask, _CROSS_MASK), \"expected a 5-pixel cross\"\n        return \"cross\"\n\n    raise AssertionError(\"expected either a marker block or a colored cross block\")\n\n\ndef _paste_checked(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:\n    h, w = patch.shape\n    target = out[int(r0) : int(r0) + h, int(c0) : int(c0) + w]\n    assert target.shape == patch.shape, \"target patch must fit in the grid\"\n    assert not bool(np.any((target != int(bg)) & (patch != int(bg)))), \"moved objects must not overlap\"\n    paste(out, patch, int(r0), int(c0), transparent=int(bg))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\n    Input structure:\n    - The background is the dominant color.\n    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n      sprite attached to a 5-pixel non-marker colored cross.\n    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n      one side of the cross.\n\n    Rule:\n    - Move the whole object straight away from its marker side until the object\n      bbox touches the corresponding grid edge.\n    - Keep the marker sprite unchanged within the object.\n    - Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\n    Key insight:\n    The marker sprite is a directional tail; the cross is the leading payload,\n    and only that payload turns around during the slide to the edge.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = get_bg(g)\n    marker = _marker_color(g, bg)\n\n    out = np.full_like(g, int(bg))\n    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)\n    assert objects, \"expected at least one composite object\"\n\n    for obj in objects:\n        assert int(obj[\"area\"]) == 9, \"each composite should contain 9 foreground pixels\"\n        r0, c0, _r1, _c1 = obj[\"bbox\"]\n        patch = crop_bbox(g, obj[\"bbox\"])\n        h, w = patch.shape\n        moved = patch.copy()\n\n        if (h, w) == (3, 6):\n            left = patch[:, :3]\n            right = patch[:, 3:]\n            left_kind = _block_kind(left, bg, marker)\n            right_kind = _block_kind(right, bg, marker)\n            assert {left_kind, right_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if left_kind == \"marker\":\n                moved[:, 3:] = np.rot90(right, 2)\n                target_r, target_c = int(r0), W - w\n            else:\n                moved[:, :3] = np.rot90(left, 2)\n                target_r, target_c = int(r0), 0\n\n        elif (h, w) == (6, 3):\n            top = patch[:3, :]\n            bottom = patch[3:, :]\n            top_kind = _block_kind(top, bg, marker)\n            bottom_kind = _block_kind(bottom, bg, marker)\n            assert {top_kind, bottom_kind} == {\"marker\", \"cross\"}, \"expected one marker and one cross\"\n\n            if top_kind == \"marker\":\n                moved[3:, :] = np.rot90(bottom, 2)\n                target_r, target_c = H - h, int(c0)\n            else:\n                moved[:3, :] = np.rot90(top, 2)\n                target_r, target_c = 0, int(c0)\n\n        else:\n            raise AssertionError(\"each composite bbox should be 3x6 or 6x3\")\n\n        _paste_checked(out, moved, target_r, target_c, bg)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Colors.\n_GEN_BG = 8\n_GEN_MARKER = 1\n_GEN_CENTER = 4\n_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]\n\n# Object layout.\n_GEN_SIDES = [\"left\", \"right\", \"top\", \"bottom\"]\n_GEN_MARKER_COORDS = {\n    \"left\": [(0, 0), (1, 1), (1, 2), (2, 0)],\n    \"right\": [(0, 2), (1, 0), (1, 1), (2, 2)],\n    \"top\": [(0, 0), (0, 2), (1, 1), (2, 1)],\n    \"bottom\": [(0, 1), (1, 1), (2, 0), (2, 2)],\n}\n_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]\n\n# Canvas and placement bounds.\n_GEN_OBJECT_COUNT_RANGE = (1, 4)\n_GEN_MAX_SIDE = 18\n_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}\n_GEN_PADDING = 1\n_GEN_EDGE_GAP = 2\n_GEN_HORIZONTAL_SIZE = (3, 6)\n_GEN_VERTICAL_SIZE = (6, 3)\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_marker_block(side: str) -> np.ndarray:\n    block = np.full((3, 3), _GEN_BG, dtype=int)\n    for r, c in _GEN_MARKER_COORDS[side]:\n        block[r, c] = _GEN_MARKER\n    return block\n\n\ndef _gen_cross_block() -> np.ndarray:\n    block = np.full((3, 3), _GEN_BG, dtype=int)\n    block[1, 1] = _GEN_CENTER\n    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):\n        block[r, c] = color\n    return block\n\n\ndef _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:\n    marker = _gen_marker_block(side)\n    if side == \"left\":\n        return np.concatenate([marker, cross], axis=1)\n    if side == \"right\":\n        return np.concatenate([cross, marker], axis=1)\n    if side == \"top\":\n        return np.concatenate([marker, cross], axis=0)\n    return np.concatenate([cross, marker], axis=0)\n\n\ndef _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:\n    out = patch.copy()\n    if side == \"left\":\n        out[:, 3:] = np.rot90(out[:, 3:], 2)\n    elif side == \"right\":\n        out[:, :3] = np.rot90(out[:, :3], 2)\n    elif side == \"top\":\n        out[3:, :] = np.rot90(out[3:, :], 2)\n    else:\n        out[:3, :] = np.rot90(out[:3, :], 2)\n    return out\n\n\ndef _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:\n    h, w = patch.shape\n    H, W = canvas.shape\n    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:\n        return False\n    for dr, dc in np.argwhere(patch != _GEN_BG):\n        r = int(r0 + dr)\n        c = int(c0 + dc)\n        r1 = max(0, r - padding)\n        r2 = min(H, r + padding + 1)\n        c1 = max(0, c - padding)\n        c2 = min(W, c + padding + 1)\n        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):\n            return False\n    return True\n\n\ndef _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"right\":\n        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]\n    if side == \"top\":\n        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]\n    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]\n\n\ndef _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:\n    if side == \"left\":\n        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]\n    if side == \"right\":\n        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]\n    if side == \"top\":\n        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]\n    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]\n\n\ndef _gen_canvas_shape(n_obj: int) -> tuple[int, int]:\n    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]\n    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)\n\n\ndef _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:\n    H, W = expected.shape\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/5b37cb25.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, in_bounds, paste, random_free_location\nimport random\nfrom itertools import product\n\n\n_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n\n\ndef _uniform_side(side: np.ndarray) -> int:\n    vals = np.unique(side)\n    assert len(vals) == 1, \"expected each frame side to be one solid color\"\n    return int(vals[0])\n\n\ndef _interior_colors(interior: np.ndarray) -> tuple[int, int]:\n    vals, counts = np.unique(interior, return_counts=True)\n    max_count = counts.max()\n    assert int(np.sum(counts == max_count)) == 1, \"expected a unique dominant interior background\"\n    bg = int(vals[int(np.argmax(counts))])\n    obj_colors = [int(v) for v in vals if int(v) != bg]\n    assert len(obj_colors) == 1, \"expected one interior foreground object color\"\n    return bg, obj_colors[0]\n\n\ndef _direction_for_notch(g: np.ndarray, r: int, c: int, obj: int) -> list[str]:\n    dirs = []\n    shape = g.shape\n    for name, (dr, dc) in _DIRECTIONS.items():\n        pr, pc = -dc, dr\n        support = (\n            (r - 2 * dr, c - 2 * dc),\n            (r - dr + pr, c - dc + pc),\n            (r - dr - pr, c - dc - pc),\n            (r + 2 * pr, c + 2 * pc),\n            (r - 2 * pr, c - 2 * pc),\n        )\n        open_side = (\n            (r + 2 * dr, c + 2 * dc),\n            (r + dr + pr, c + dc + pc),\n            (r + dr - pr, c + dc - pc),\n        )\n        if not all(in_bounds(shape, rr, cc) and int(g[rr, cc]) == obj for rr, cc in support):\n            continue\n        if not all((not in_bounds(shape, rr, cc)) or int(g[rr, cc]) != obj for rr, cc in open_side):\n            continue\n        dirs.append(name)\n    return dirs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Fill each plus-shaped background notch with the color of the frame side it opens toward.\n\n    Input structure\n    - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.\n    - The frame interior contains a dominant background color and one foreground object color.\n    - Some object boundaries contain five-pixel plus-shaped background notches.\n\n    Rule\n    - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.\n    - Recolor the five pixels of that plus with the color of the facing frame side.\n    - Leave all other pixels unchanged.\n\n    Key insight\n    The frame side colors are direction labels for the open notches in the foreground object.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    h, w = g.shape\n    assert h >= 5 and w >= 5, \"expected room for a frame and plus notches\"\n\n    side_color = {\n        \"top\": _uniform_side(g[0, 1:-1]),\n        \"bottom\": _uniform_side(g[-1, 1:-1]),\n        \"left\": _uniform_side(g[1:-1, 0]),\n        \"right\": _uniform_side(g[1:-1, -1]),\n    }\n    bg, obj = _interior_colors(g[1:-1, 1:-1])\n\n    out = g.copy()\n    painted: set[tuple[int, int]] = set()\n    notch_count = 0\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)\n            if not all(int(g[rr, cc]) == bg for rr, cc in cross):\n                continue\n\n            dirs = _direction_for_notch(g, r, c, obj)\n            assert len(dirs) <= 1, \"expected each plus notch to open in at most one direction\"\n            if not dirs:\n                continue\n\n            notch_count += 1\n            color = side_color[dirs[0]]\n            for cell in cross:\n                assert cell not in painted, \"expected non-overlapping plus notches\"\n                painted.add(cell)\n                out[cell] = color\n\n    assert notch_count > 0, \"expected at least one plus notch\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette.\n_GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0\n_GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6\n\n# Object size and total filled-area budget.\n_OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4\n_OBJECT_DIM_MIN, _OBJECT_DIM_MAX = 5, 20\n_OBJECT_AREA_MIN, _OBJECT_AREA_MAX = 30, 180\n_TOTAL_OBJECT_AREA_MAX, _MIN_REMAINING_OBJECT_AREA = 360, 30\n\n# Placement gap against frame and other objects.\n_PLACEMENT_BORDER, _PLACEMENT_PADDING, _PLACEMENT_PADDING_CONNECTIVITY = 2, 2, 8\n\n# Notch geometry and counts.\n_GEN_CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))\n_GEN_DIRECTIONS = {\n    \"top\": (-1, 0),\n    \"bottom\": (1, 0),\n    \"left\": (0, -1),\n    \"right\": (0, 1),\n}\n_EDGES = tuple(_GEN_DIRECTIONS)\n_NOTCH_EDGE_MARGIN, _MAX_TOTAL_NOTCHES = 2, 8\n_NOTCHES_PER_OBJECT = (1, 2, 3)\n\n# Rejection-sampling retry cap.\n_GEN_RETRY_LIMIT = 300\n_DIM_PAIRS = [(h, w) for h in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1)\n              for w in range(_OBJECT_DIM_MIN, _OBJECT_DIM_MAX + 1) if _OBJECT_AREA_MIN <= h * w <= _OBJECT_AREA_MAX]\n\n\ndef _notch_cells(r, c, direction):\n    dr, dc = _GEN_DIRECTIONS[direction]\n    pr, pc = -dc, dr\n    cross = tuple((r + rr, c + cc) for rr, cc in _GEN_CROSS)\n    support = (\n        (r - 2 * dr, c - 2 * dc),\n        (r - dr + pr, c - dc + pc),\n        (r - dr - pr, c - dc - pc),\n        (r + 2 * pr, c + 2 * pc),\n        (r - 2 * pr, c - 2 * pc),\n    )\n    open_side = (\n        (r + 2 * dr, c + 2 * dc),\n        (r + dr + pr, c + dc + pc),\n        (r + dr - pr, c + dc - pc),\n    )\n    return {\"direction\": direction, \"cross\": cross, \"support\": support, \"open_side\": open_side}\n\n\ndef _candidate_notches(r0, c0, h, w, edge):\n    if edge in (\"top\", \"bottom\"):\n        row = r0 if edge == \"top\" else r0 + h - 1\n        centers = [(row, c) for c in range(c0 + _NOTCH_EDGE_MARGIN, c0 + w - _NOTCH_EDGE_MARGIN)]\n    else:\n        col = c0 if edge == \"left\" else c0 + w - 1\n        centers = [(r, col) for r in range(r0 + _NOTCH_EDGE_MARGIN, r0 + h - _NOTCH_EDGE_MARGIN)]\n    return [_notch_cells(r, c, edge) for r, c in centers]\n\n\ndef _choose_notches(r0, c0, h, w, count):\n    edges = random.sample(_EDGES, count)\n    random.shuffle(edges)\n    choices = {edge: _candidate_notches(r0, c0, h, w, edge) for edge in edges}\n\n    def search(i, chosen, carved, protected):\n        if i == len(edges):\n            return chosen\n        options = choices[edges[i]][:]\n        random.shuffle(options)\n        for notch in options:\n            cross = set(notch[\"cross\"])\n            support = set(notch[\"support\"])\n            if cross & carved or cross & protected or support & carved:\n                continue\n            result = search(i + 1, chosen + [notch], carved | cross, protected | support)\n            if result is not None:\n                return result\n        return None\n\n    return search(0, [], set(), set())\n\n\ndef _notch_counts(n_objects):\n    total = random.randint(n_objects, min(_MAX_TOTAL_NOTCHES, max(_NOTCHES_PER_OBJECT) * n_objects))\n    plans = [p for p in product(_NOTCHES_PER_OBJECT, repeat=n_objects) if sum(p) == total]\n    plan = list(random.choice(plans))\n    random.shuffle(plan)\n    return plan\n\n\ndef _place_rectangles(out, obj, n_objects, counts):\n    \"\"\"Place object rectangles and return (r,c,h,w,notch_count) records, or None.\"\"\"\n    placement = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)\n    rects = []\n    total_area = 0\n    for i in range(n_objects):\n        remaining = n_objects - i - 1\n        area_cap = _TOTAL_OBJECT_AREA_MAX - _MIN_REMAINING_OBJECT_AREA * remaining\n        valid = [p for p in _DIM_PAIRS if total_area + p[0] * p[1] <= area_cap]\n        if not valid:\n            return None\n        h, w = random.choice(valid)\n        patch = np.ones((h, w), dtype=int)\n        try:\n            r, c = random_free_location(\n                placement, patch, transparent=0, border=_PLACEMENT_BORDER, padding=_PLACEMENT_PADDING,\n                padding_connectivity=_PLACEMENT_PADDING_CONNECTIVITY,\n            )\n        except ValueError:\n            return None\n        paste(placement, patch, r, c, transparent=0)\n        paste(out, np.full((h, w), obj, dtype=int), r, c)\n        rects.append((r, c, h, w, counts[i]))\n        total_area += h * w\n    return rects\n\n\ndef _apply_notches(out, notches, side_color, bg):\n    \"\"\"Paint output notches and return the matching carved input grid.\"\"\"\n    for notch in notches:\n        color = side_color[notch[\"direction\"]]\n        for rr, cc in notch[\"cross\"]:\n            out[rr, cc] = color\n\n    inp = out.copy()\n    for notch in notches:\n        for rr, cc in notch[\"cross\"]:\n","exit_code":0,"status":"completed"}}
