{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nACTIONS=['L','R','S','U']\nDIRS={'U':(-1,0),'R':(0,1),'D':(1,0),'L':(0,-1)}\nORDER=['U','R','D','L']\n\ndef turn(d,a):\n    i=ORDER.index(d)\n    return {'S':ORDER[i],'L':ORDER[(i-1)%4],'R':ORDER[(i+1)%4],'U':ORDER[(i+2)%4]}[a]\n\ndef v2d(v):\n    for k,val in DIRS.items():\n        if val==v: return k\n\ndef build():\n    top_arm=random.randint(2,5); bottom_arm=random.randint(2,5); left_arm=random.randint(2,5); right_arm=random.randint(2,5)\n    upper=random.randint(3,6); lower=random.randint(3,6); left_half=random.randint(3,6); right_half=random.randint(3,6)\n    H=top_arm+upper+lower+bottom_arm+1; W=left_arm+left_half+right_half+right_arm+1\n    rt=top_arm; rm=top_arm+upper; rb=top_arm+upper+lower; cl=left_arm; cm=left_arm+left_half; cr=left_arm+left_half+right_half\n    occ=set()\n    for r in range(H): occ.add((r,cm))\n    for c in range(W): occ.add((rm,c))\n    for c in range(cl,cr+1): occ.add((rt,c)); occ.add((rb,c))\n    for r in range(rt,rb+1): occ.add((r,cl)); occ.add((r,cr))\n    inter={'N':(rt,cm),'E':(rm,cr),'S':(rb,cm),'W':(rm,cl),'C':(rm,cm)}\n    ends={'T':(0,cm),'R':(rm,W-1),'B':(H-1,cm),'L':(rm,0)}\n    outer=['L','R','S','L']\n    random.shuffle(outer)\n    amap={k:v for k,v in zip(['N','E','S','W'],outer)}\n    amap['C']='U'\n    return occ,inter,ends,amap\n\ndef valid(data):\n    occ,inter,ends,amap=data\n    trav=occ|set(ends.values())\n    inter_by_pos={v:k for k,v in inter.items()}\n    def neigh(cell):\n        r,c=cell\n        out=[]\n        for dr,dc in DIRS.values():\n            if (r+dr,c+dc) in trav: out.append((r+dr,c+dc))\n        return out\n    seen_actions=set(); same=False\n    for start in ends.values():\n        prev=start; cur=neigh(start)[0]; states={(prev,cur)}\n        while True:\n            if cur in ends.values():\n                if cur==start:\n                    same=True\n                break\n            if cur in inter_by_pos:\n                act=amap[inter_by_pos[cur]]; seen_actions.add(act)\n                d=v2d((cur[0]-prev[0],cur[1]-prev[1]))\n                nd=turn(d,act); dr,dc=DIRS[nd]\n                nxt=(cur[0]+dr,cur[1]+dc)\n            else:\n                nxt=[x for x in neigh(cur) if x\"'!=prev][0]\n            prev,cur=cur,nxt\n            if (prev,cur) in states: return False, seen_actions, True\n            states.add((prev,cur))\n    return True, seen_actions, same\n\ncount=0\nsame_count=0\nfor _ in range(5000):\n    ok,acts,same=valid(build())\n    if ok:\n        count+=1\n        same_count+=same\nprint('\"'valid',count,'same',same_count)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
