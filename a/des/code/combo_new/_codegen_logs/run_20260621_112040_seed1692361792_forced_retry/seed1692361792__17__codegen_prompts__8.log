       break\n            if cur in inter_by_pos:\n                act=amap[inter_by_pos[cur]]; seen_actions.add(act)\n                d=v2d((cur[0]-prev[0],cur[1]-prev[1]))\n                nd=turn(d,act); dr,dc=DIRS[nd]\n                nxt=(cur[0]+dr,cur[1]+dc)\n            else:\n                nxt=[x for x in neigh(cur) if x\"'!=prev][0]\n            prev,cur=cur,nxt\n            if (prev,cur) in states: return False, seen_actions, True\n            states.add((prev,cur))\n    return True, seen_actions, same\n\ncount=0\nsame_count=0\nfor _ in range(5000):\n    ok,acts,same=valid(build())\n    if ok:\n        count+=1\n        same_count+=same\nprint('\"'valid',count,'same',same_count)\nPY\"","aggregated_output":"valid 5000 same 5000\n","exit_code":0,"status":"completed"}}
