llow_same=True):\n    trav=occ|set(endpoints.values())\n    def neigh(cell):\n        r,c=cell\n        out=[]\n        for dr,dc in DIRS.values():\n            nr,nc=r+dr,c+dc\n            if (nr,nc) in trav: out.append((nr,nc))\n        return out\n    visited_actions=set()\n    counts=Counter()\n    for name,start in endpoints.items():\n        ns=neigh(start)\n        if len(ns)\"'!=1: return False, '\"'bad endpoint degree', None\n        prev=start; cur=ns[0]\n        state_seen={(prev,cur)}\n        while True:\n            if cur in endpoints.values():\n                if not allow_same and cur==start:\n                    return False, 'same endpoint', None\n                break\n            counts[cur]+=1\n            nbs=neigh(cur)\n            if len(nbs)<2:\n                return False, 'dead grey', None\n            if cur in intersections.values():\n                k=[k for k,v in intersections.items() if v==cur][0]\n                act=action_map[k]\n                visited_actions.add(act)\n                d=vec_to_dir(cur[0]-prev[0], cur[1]-prev[1])\n                nd=turn(d,act)\n                dr,dc=DIRS[nd]\n                nxt=(cur[0]+dr, cur[1]+dc)\n                if nxt not in trav:\n                    return False, 'bad turn', (name,k,act,prev,cur,nxt)\n            else:\n                nxts=[p for p in nbs if p\"'!=prev]\n                if len(nxts)!=1:\n                    return False, '\"'ambiguous non-intersection', (cur,nbs,prev)\n                nxt=nxts[0]\n            prev,cur=cur,nxt\n            if (prev,cur) in state_seen:\n                return False, 'loop', (name,prev,cur)\n            state_seen.add((prev,cur))\n        \n    return True, counts, visited_actions\n\nok=0\nfor i in range(2000):\n    data=build()\n    good, info, more=valid(*data, allow_same=True)\n    if good:\n        overlap=max(info.values(), default=0)\n        if overlap>=2 and more==set(ACTIONS):\n            ok+=1\nprint('valid samples', ok)\nPY\"","aggregated_output":"valid samples 2000\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import Counter\nBG=0; COR=5; SIG=4\nACTIONS=['L','R','S','U']\nDIRS={'U':(-1,0),'R':(0,1),'D':(1,0),'L':(0,-1)}\nDIR_ORDER=['U','R','D','L']\n\ndef turn(d, act):\n    i=DIR_ORDER.index(d)\n    return {'S':DIR_ORDER[i],'L':DIR_ORDER[(i-1)%4],'R':DIR_ORDER[(i+1)%4],'U':DIR_ORDER[(i+2)%4]}[act]\n\ndef vec_to_dir(v):\n    for k,val in DIRS.items():\n        if val==v: return k\n    raise\n\ndef build():\n    top_arm=random.randint(2,5); bottom_arm=random.randint(2,5); left_arm=random.randint(2,5); right_arm=random.randint(2,5)\n    upper=random.randint(3,6); lower=random.randint(3,6); left_half=random.randint(3,6); right_half=random.randint(3,6)\n    H=top_arm+upper+lower+bottom_arm+1; W=left_arm+left_half+right_half+right_arm+1\n    rt=top_arm; rm=top_arm+upper; rb=top_arm+upper+lower; cl=left_arm; cm=left_arm+left_half; cr=left_arm+left_half+right_half\n    occ=set()\n    for c in range(cl,cr+1): occ|={(rt,c),(rm,c),(rb,c)}\n    for r in range(rt,rb+1): occ|={(r,cl),(r,cm),(r,cr)}\n    for r in range(0,rt+1): occ.add((r,cm))\n    for r in range(rb,H): occ.add((r,cm))\n    for c in range(0,cl+1): occ.add((rm,c))\n    for c in range(cr,W): occ.add((rm,c))\n    inter={'N':(rt,cm),'E':(rm,cr),'S':(rb,cm),'W':(rm,cl),'C':(rm,cm)}\n    ends={'T':(0,cm),'R':(rm,W-1),'B':(H-1,cm),'L':(rm,0)}\n    acts=ACTIONS+[random.choice(ACTIONS)]\n    random.shuffle(acts)\n    amap=dict(zip(inter,acts))\n    return occ,inter,ends,amap\n\ndef valid(data, allow_same=False):\n    occ,inter,ends,amap=data\n    trav=occ|set(ends.values())\n    inter_by_pos={v:k for k,v in inter.items()}\n    def neigh(cell):\n        r,c=cell\n        out=[]\n        for dr,dc in DIRS.values():\n            if (r+dr,c+dc) in trav: out.append((r+dr,c+dc))\n        return out\n    seen_actions=set(); counts=Counter(); targets=[]\n    for name,start in ends.items():\n        ns=neigh(start)\n        prev,start_neighbor=start,ns[0]\n        cur=start_neighbor\n        states={(prev,cur)}\n        while True:\n            if cur in ends.values():\n                if not allow_same and cur==start:\n                    return False,None,None\n                targets.append(cur)\n                break\n            if cur in occ: counts[cur]+=1\n            nbs=neigh(cur)\n            if cur in inter_by_pos:\n                act=amap[inter_by_pos[cur]]\n                seen_actions.add(act)\n                d=vec_to_dir((cur[0]-prev[0],cur[1]-prev[1]))\n                nd=turn(d,act)\n                dr,dc=DIRS[nd]\n                nxt=(cur[0]+dr,cur[1]+dc)\n                if nxt not in trav: return False,None,None\n            else:\n                nxts=[x for x in nbs if x\"'!=prev]\n                if len(nxts)!=1: return False,None,None\n                nxt=nxts[0]\n            prev,cur=cur,nxt\n            if (prev,cur) in states: return False,None,None\n            states.add((prev,cur))\n    return True,seen_actions,max(counts.values(),default=0)\n\nn=0\nfor i in range(5000):\n    ok,acts,over=valid(build(),allow_same=False)\n    if ok and acts==set(ACTIONS) and over>=2:\n        n+=1\nprint(n)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
