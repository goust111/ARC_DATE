:\n        ns=neigh(start)\n        prev,start_neighbor=start,ns[0]\n        cur=start_neighbor\n        states={(prev,cur)}\n        while True:\n            if cur in ends.values():\n                if not allow_same and cur==start:\n                    return False,None,None\n                targets.append(cur)\n                break\n            if cur in occ: counts[cur]+=1\n            nbs=neigh(cur)\n            if cur in inter_by_pos:\n                act=amap[inter_by_pos[cur]]\n                seen_actions.add(act)\n                d=vec_to_dir((cur[0]-prev[0],cur[1]-prev[1]))\n                nd=turn(d,act)\n                dr,dc=DIRS[nd]\n                nxt=(cur[0]+dr,cur[1]+dc)\n                if nxt not in trav: return False,None,None\n            else:\n                nxts=[x for x in nbs if x\"'!=prev]\n                if len(nxts)!=1: return False,None,None\n                nxt=nxts[0]\n            prev,cur=cur,nxt\n            if (prev,cur) in states: return False,None,None\n            states.add((prev,cur))\n    return True,seen_actions,max(counts.values(),default=0)\n\nn=0\nfor i in range(5000):\n    ok,acts,over=valid(build(),allow_same=False)\n    if ok and acts==set(ACTIONS) and over>=2:\n        n+=1\nprint(n)\nPY'","aggregated_output":"0\n","exit_code":0,"status":"completed"}}
